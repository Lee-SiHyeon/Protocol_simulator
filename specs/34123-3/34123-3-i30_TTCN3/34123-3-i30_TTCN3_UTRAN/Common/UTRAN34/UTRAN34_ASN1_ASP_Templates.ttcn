  template (value) U_CMAC_CONFIG_REQ cas_CMAC_MACi_Setup_REQ_FDD(integer p_NodeB_Id,
                                                                 template (value) SS_ActivationTime  p_SS_ActivationTime,
                                                                 template (omit) LCH_MappingList    p_LCH_MappingList,
                                                                 template (omit) E_DCHMACdFlows     p_E_DCHMACdFlows,
                                                                 boolean p_ConnectedToMAC_is := true) :=
  { /* @status    APPROVED (UTRAN) */
    configMACi_FDD := {
      nodeB_Id := p_NodeB_Id,
      configMessage := {
        setup := {
          mAC_i_r9 := {
            activationTime := p_SS_ActivationTime,
            lCH_Mappinglist := p_LCH_MappingList,
            e_DCHMacdFlows := p_E_DCHMACdFlows,
            connectedToMAC_is := p_ConnectedToMAC_is,
            ss_DRX_MAC_Info := omit,
            tSN_FieldExtension := omit
          }
        }
      }
