module UTRAN34_LoopBack_Templates {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_24008TypeDefs all;
  import from NAS_34109TypeDefs all;
  import from UTRAN_TypeDefs all;

  const   UE_TestLoopMode     tsc_UE_TestLoopMode1 := '00'O;  /* mode 1 with DCCH dummy transmission disabled
                                                                 @status    APPROVED (UTRAN) */

  template (value) LB_Setup_IE_Type cs_LB_SetupRB_IE(integer p_LB_Size, integer p_RB_Identity) :=
  { /* @status    APPROVED (UTRAN) */
    uplinkPdcpSduSize := int2bit(p_LB_Size, 16),
    reserved := '000'B,
    rbIdentity := int2bit(p_RB_Identity, 5)
  };

  template (value) UE_TestLoopMode1_LB_Setup_Type cs_UE_TestLoopMode1_LB_Setup_Common(template (value) LB_Setup_IE_List_Type p_LB_Setup_List) :=
  { /* @status    APPROVED (UTRAN) */
    iel := int2oct(3 * lengthof(p_LB_Setup_List), 1),
    lbSetupList := p_LB_Setup_List
  };

  template (value) UE_TestLoopMode1_LB_Setup_Type cs_UE_TestLoopMode1_LB_Setup(integer p_Size1,
                                                                               integer p_RB1) :=
  /* @status    APPROVED (UTRAN) */
    cs_UE_TestLoopMode1_LB_Setup_Common( {cs_LB_SetupRB_IE(p_Size1, p_RB1)} );

  template (value) UE_TestLoopMode1_LB_Setup_Type cs_UE_TestLoopMode1_LB_Setup2(integer p_Size1,
                                                                                integer p_RB1,
                                                                                integer p_Size2,
                                                                                integer p_RB2) :=
  /* @status    APPROVED (UTRAN) */
    cs_UE_TestLoopMode1_LB_Setup_Common( { cs_LB_SetupRB_IE(p_Size1, p_RB1), cs_LB_SetupRB_IE(p_Size2, p_RB2) } );

  template (value) RRCDataReqType cs_U_ActRB_TestMode(template (value) ACTIVATERBTESTMODE p_ActRBTestMode):=
  { /* @status    APPROVED (UTRAN) */
    activateRBTestMode := p_ActRBTestMode
  };

  template (value) RRCDataReqType cs_U_DeactRB_TestMode(template (value) DEACTIVATERBTESTMODE p_DeactRBTestMode):=
  { /* @status    APPROVED (UTRAN) */
    deactivateRBTestMode := p_DeactRBTestMode
  };

  template (value) RRCDataReqType cs_U_OpenUE_TestLoop(template (value) OPENUETESTLOOP p_OpenUE_TestLoop):=
  { /* @status    APPROVED (UTRAN) */
    openUeTestLoop := p_OpenUE_TestLoop
  };

  template (value) RRCDataReqType cs_U_CloseUE_TestLoop(template (value) CLOSEUETESTLOOP p_CloseUE_TestLoop):=
  { /* @status    APPROVED (UTRAN) */
    closeUeTestLoop := p_CloseUE_TestLoop
  };

  template (present) RRCDataIndType cr_U_ActRB_TestModeCmpl(template (value) ACTIVATERBTESTMODECOMPLETE p_ActRBTestModeCmpl):=
  { /* @status    APPROVED (UTRAN) */
    activateRBTestModeComplete := p_ActRBTestModeCmpl
  };

  template (present) RRCDataIndType cr_U_DeactRB_TestModeCmpl(template (value) DEACTIVATERBTESTMODECOMPLETE p_DeactRBTestModeCmpl):=
  { /* @status    APPROVED (UTRAN) */
    deactivateRBTestModeComplete := p_DeactRBTestModeCmpl
  };

  template (present) RRCDataIndType cr_U_OpenUE_TestLoopCmpl(template OPENUETESTLOOPCOMPLETE p_OpenUE_TestLoopCmpl):=
  { /* @status    APPROVED (UTRAN) */
    openUeTestLoopComplete := p_OpenUE_TestLoopCmpl
  };

  template (present) RRCDataIndType cr_U_CloseUE_TestLoopCmpl(template CLOSEUETESTLOOPCOMPLETE p_CloseUE_TestLoopCmpl):=
  { /* @status    APPROVED (UTRAN) */
    closeUeTestLoopComplete := p_CloseUE_TestLoopCmpl
  };

  template (value) CLOSEUETESTLOOP cs_CloseUE_TestLoop(UE_TestLoopMode_Type                       p_UE_TestLoopMode,
                                                       template (value) UE_TestLoopMode1_LB_Setup_Type   p_UE_TestLoopMode1LB_Setup):=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator   := '0000'B,
    protocolDiscriminator := '1111'B,
    messageType := '01000000'B,
    ueTestLoopMode := p_UE_TestLoopMode,
    ueTestLoopMode1_LB_Setup := p_UE_TestLoopMode1LB_Setup,
    ueTestLoopMode3_LB_Setup := omit
  };

  template (present) CLOSEUETESTLOOPCOMPLETE cr_CloseUE_TestLoopCompl :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator   := '0000'B,
    protocolDiscriminator := '1111'B,
    messageType := '01000001'B
  };

  template (value) OPENUETESTLOOP cs_OpenUE_TestLoop :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator := '0000'B,
    protocolDiscriminator := '1111'B,
    messageType := '01000010'B
  };

  template (present) OPENUETESTLOOPCOMPLETE cr_OpenUE_TestLoopCmpl :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator := '0000'B,
    protocolDiscriminator := '1111'B,
    messageType := '01000011'B
  };

  template (value) ACTIVATERBTESTMODE cs_ActivateRB_TestMode :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator           := '0000'B,
    tCProtocolDiscriminator := '1111'B,
    msgType                 := '01000100'B
  };

  template (present) ACTIVATERBTESTMODECOMPLETE cr_ActivateRB_TestModeCmpl :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator           := '0000'B,
    tCProtocolDiscriminator := '1111'B,
    msgType                 := '01000101'B
  };

  template (value) DEACTIVATERBTESTMODE cs_DeactivateRB_TestMode :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator := '0000'B,
    tCProtocolDiscriminator := '1111'B,
    msgType :='01000110'B
  };

  template (present) DEACTIVATERBTESTMODECOMPLETE cr_DeactivateRB_TestModeCmpl :=
  { /* @status    APPROVED (UTRAN) */
    skipIndicator := '0000'B,
    tCProtocolDiscriminator := '1111'B,
    msgType :='01000111'B
  };

}
