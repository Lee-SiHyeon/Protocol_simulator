   * @desc      get timing info (SNF offset, Tcell, TcOffset) from the cell info as stored for the given cell
   * @param     p_NR_CellId
   * @return    CellTimingInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetCellTimingInfo(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return CellTimingInfo_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.CellTimingInfo;
  }

  /* @desc      to set the value of CellTimingInfo
   * @param     p_NR_CellId
   * @param     p_CellTimingInfo
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_Set_CellTimingInfo(NR_CellId_Type      p_NR_CellId,
                                            CellTimingInfo_Type p_CellTimingInfo) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.CellTimingInfo := p_CellTimingInfo;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Return the number of slot per subframe according to the SCS of the cell
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSlotsNumberPerSubframe(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    return f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
  }

  /*
   * @desc      Return the number of slot per subframe according to the SCS of the cell
   * @param     p_SCS
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(SubcarrierSpacing p_SCS) return integer
  {
    var integer v_NumberSlotsPerSubframe := 1;

    select (p_SCS) { //Acc to 38.211 Table 4.3.2-1
      case(kHz15)  { v_NumberSlotsPerSubframe := 1; }
      case(kHz30)  { v_NumberSlotsPerSubframe := 2; }
      case(kHz60)  { v_NumberSlotsPerSubframe := 4; }
      case(kHz120) { v_NumberSlotsPerSubframe := 8; }
      case(kHz240) { v_NumberSlotsPerSubframe := 16; }
      case else    { FatalError(__FILE__, __LINE__, "Invalid SubcarrierSpacing"); }
    }
    return v_NumberSlotsPerSubframe;
  }

