  function f_TC_7_1_1_4_2_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // UL-SCH Transport Block Size selection / DCI format 0_0 / Transform precoding disabled
    f_TC_7_1_1_4_x_x_ENDC_EUTRA();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.4.2.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_4_2_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // 7.1.1.4.2.3  UL-SCH transport block size selection / DCI format 0_1 / RA type 0/RA Type 1 / Transform precoding disabled
    f_TC_7_1_1_4_x_x_ENDC_EUTRA(pc_ra_Type0_PUSCH and (not pc_dynamicSwitchRA_Type0_1_PUSCH) );//@sic R5-202610 sic@
  }

