module MTC_Component_IMS_UTRAN {

  import from CommonDefs all;
  import from IMS_Component all;
  import from IPCAN_UTRAN all;
  import from MTC_Base all;
  import from MTC_Component_IMS_Common all;
  import from UTRAN_Component all;
  import from UTRAN_IRAT_Component all;
  import from UpperTesterSystemCmds all;

  type component SYSTEM_IMS extends UTRAN_SYSTEM, SYSTEM_IMS_BASE {}; /* @status    APPROVED (IMS) */

  /*
   * @desc      Create parallel test components and connect all MTC ports to the system ports
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @param     p_UseDNS            (default value: false)
   * @param     p_UseXCAP           (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_CreateMapAndConnectPTCs_UTRAN(SYSTEM_IMS p_System,
                                                   IMS_PTC p_IMS1,
                                                   IMS_PTC p_IMS2,
                                                   boolean p_UseDNS := false,
                                                   boolean p_UseXCAP := false) runs on MTC_IMS
  { /* @sic R5s160090: f_MTC_BASE_Map removed from this function as already being called in f_MTC_IMS_InitAndConnect_IP_IMS sic@ */

    var UTRAN_IRAT_PTC v_UTRAN;

    f_MTC_IMS_InitAndConnect_IP_IMS(p_System, p_IMS1, p_IMS2, p_UseDNS, p_UseXCAP);

    v_UTRAN := UTRAN_IRAT_PTC.create("UTRAN") alive;                             // @sic R5s201263 sic@  @sic R5s210270 sic@

    f_UTRAN_PTC_Map(p_System, v_UTRAN);

    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_UTRAN], v_UTRAN:UT);
    connect(v_UTRAN:IP, vc_Components.IP:UTRAN_CTRL);
    if (p_IMS1 != null) { connect(vc_Components.IMS1:IPCAN, v_UTRAN:IMS[tsc_Index_IMS1]); }
    if (p_IMS2 != null) { connect(vc_Components.IMS2:IPCAN, v_UTRAN:IMS[tsc_Index_IMS2]); }

    f_UT_InitialPowerOffUE(Ut);

    v_UTRAN.start(f_UTRAN_IPCAN_MainLoop());
  }

}
