module IMS_MessageBody_Templates {

  import from IMS_SDP_Messages all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from NoTargetNamespace_24229_AlternativeService_xsd  language "XSD" all;
  import from urn_ietf_params_xml_ns_reginfo language "XSD" all;

  template (value) MIME_Message cs_MIME_Message(charstring p_Boundary,
                                                template (value) MIME_Part_List p_MIME_Part_List) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    boundary := p_Boundary,
    mimePartList := p_MIME_Part_List
  };

  template (value) MIME_ContentDisposition cs_MimeContentDisposition(charstring p_DispositionType) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */
    fieldName := MIME_CONTENT_DISPOSITION_E,
    dispositionType := p_DispositionType,
    dispositionParams := omit
  };

  template (present) MIME_ContentDisposition cr_MimeContentDisposition(template (present) charstring p_DispositionType,
                                                                       template SemicolonParam_List p_DispositionParams := *) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */
    fieldName := MIME_CONTENT_DISPOSITION_E,
    dispositionType := p_DispositionType,
    dispositionParams := p_DispositionParams
  };

  template (value) MIME_Part_Header cs_MIME_Part_Header(charstring p_TypeAndSubtype,
                                                        template (omit) MIME_ContentDisposition p_ContentDisposition := omit,
                                                        template (omit) MIME_ContentId p_ContentId := omit) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    contentType := cs_MimeContentType(p_TypeAndSubtype),
    contentDisposition := p_ContentDisposition,
    contentId := p_ContentId
  };

  template (present) MIME_Part_Header cr_MIME_Part_Header(template (present) MIME_ContentType p_ContentType := ?,
                                                          template MIME_ContentDisposition p_ContentDisposition := *,
                                                          template MIME_ContentId p_ContentId := *) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    contentType := p_ContentType,
    contentDisposition := p_ContentDisposition,
    contentId := p_ContentId
  };

  template (value) MIME_Part cs_MIME_Part_SDP(charstring p_SDP_MessageEncoded) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    header := cs_MIME_Part_Header(c_sdpApplication),
    body := {
      sdpMessageBody := p_SDP_MessageEncoded
    }
  };

  template (present) MIME_Part cr_MIME_Part_SDP(template (present) MIME_ContentType p_ContentType := ?) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    header := cr_MIME_Part_Header(p_ContentType),
    body := {
      sdpMessageBody := ?
    }
  };

  template (value) MIME_Part cs_MIME_Part_XML(charstring p_TypeAndSubtype,
                                              template (omit) MIME_ContentDisposition p_ContentDisposition := omit,
                                              template (omit) MIME_ContentId p_ContentId := omit,
                                              charstring p_EncodedXML) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    header := cs_MIME_Part_Header(p_TypeAndSubtype, p_ContentDisposition, p_ContentId),
    body := {
      xmlBody := p_EncodedXML
    }
  };

  template (present) MIME_Part cr_MIME_Part_XML(template (present) MIME_ContentType p_ContentType := ?,
                                                template MIME_ContentDisposition p_ContentDisposition := *,
                                                template MIME_ContentId p_ContentId := *) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    header := cr_MIME_Part_Header(p_ContentType, p_ContentDisposition, p_ContentId),
    body := {
      xmlBody := ?
    }
  };

  template (present) MIME_Part cr_MIME_Part_CommonBinary(template (present) MIME_ContentType p_ContentType := ?,
                                                         template MIME_ContentDisposition p_ContentDisposition := *,
                                                         template MIME_ContentId p_ContentId := *) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    header := cr_MIME_Part_Header(p_ContentType, p_ContentDisposition, p_ContentId),
    body := {
      commonBinary := ?
    }
  };

  template (present) MIME_Message cr_MIME_Message(template (present) MIME_Part_List p_MIME_Part_List) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    boundary := ?,
    mimePartList := p_MIME_Part_List
  };

  template (value) MIME_ContentType cs_MimeContentType(charstring p_TypeAndSubtype) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    fieldName := MIME_CONTENT_TYPE_E,
    typeAndSubtype := p_TypeAndSubtype,
    typeParams := omit
  };

  template (present) MIME_ContentType cr_MimeContentType(template charstring p_TypeAndSubtype) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    fieldName := MIME_CONTENT_TYPE_E,
    typeAndSubtype := p_TypeAndSubtype,
    typeParams := *
  };

  template (value) MIME_ContentId cs_MimeContentId(charstring p_MsgId) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    fieldName := MIME_CONTENT_ID_E,
    msgId := p_MsgId
  };

  template (present) MIME_ContentId cr_MimeContentId(template charstring p_MsgId := pattern "<*>") :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    fieldName := MIME_CONTENT_ID_E,
    msgId := p_MsgId
  };

  /*
   * @desc      returm addr-spec of MIME Content-ID
   * @param     p_ContentId
   * @return    charstring
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_MIME_ContentId_GetAddrSpec(MIME_ContentId p_ContentId) return charstring
  {
    return regexp(p_ContentId.msgId, "<(*)>", 0);     // RFC 2045 clause 7: id := "Content-ID" ":" msg-id; RFC 822: msg-id = "<" addr-spec ">"
  }

  template (value) MessageBody cs_MessageBody_SDP(template (value) SDP_Message p_SDP) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    sdpMessageBody := f_IMS_SDP_Message_Encode(p_SDP)
  };

  template (value) MessageBody cs_MessageBody_MIME(template (value) MIME_Message p_MIME) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC) */
    mimeMessageBody := p_MIME
  };

  template (value) MessageBody cs_MessageBody_RegInfo(template (value) Reginfo p_RegInfo) :=
  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */
  /* @sic R5w230106, R5s230374: Reginfo instead of Reginfo_Type sic@ */
    cs_MessageBody_XML_Bitstring(encvalue(p_RegInfo)); /* @sic R5s130195 BASELINE MOVING 2013 sic@ */

  template (value) MessageBody cs_MessageBody_SMS(template (value) octetstring p_SMS) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    smsMessage := p_SMS
  };

  template (present) MessageBody cr_MessageBody_SDP :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    sdpMessageBody := ?
  };

  template (present) MessageBody cr_MessageBody_MIME(template (present) MIME_Message p_MIME := ?) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    mimeMessageBody:= p_MIME
  };

  template (present) MessageBody cr_MessageBody_SMS(template (present) octetstring p_SMS := ?) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    smsMessage := p_SMS
  };

  template (value) MessageBody cs_MessageBody_SipFrag(charstring p_SipFrag) :=
  { /* @status    APPROVED (IMS) */
    commonText := p_SipFrag          // @sic R5w200103/R5-201585: sipfrag replaced by commonText at IWD 20wk38 sic@
  };

  template (value) MessageBody cs_MessageBody_XML(charstring p_XmlBody) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    xmlBody := p_XmlBody
  };

  template (value) MessageBody cs_MessageBody_XML_Bitstring(bitstring p_Body) := cs_MessageBody_XML(oct2char(bit2oct(p_Body))); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */

  template (value) MessageBody cs_MessageBody_XML_Ims_3gpp(template (value) Ims_3gpp p_Ims3gpp) := cs_MessageBody_XML_Bitstring(encvalue(p_Ims3gpp));  /* @status    APPROVED (IMS, IMS_IRAT)
                                                                                                                                                          @sic R5w230106, R5s230374: Ims_3gpp instead of Ims_3gpp_Type sic@ */

  /*
   * @desc      to be used e.g. for INVITE when message body depends on condition A8
   *            (UE uses Geolocation header to provide its geographical location for emergency session setup,
   *            has obtained its location and is setting up an emergency session)
   * @param     p_MimeWithXML
   * @param     p_MimeWithBinaryData  (default value: false)
   * @return    template (present) MessageBody
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SIP_MessageBodyWithSDP_RX(boolean p_MimeWithXML,
                                       boolean p_MimeWithBinaryData := false) return template (present) MessageBody
  { /* to be used e.g. for INVITE when message body depends on condition A8 (UE uses Geolocation header to provide its geographical location for emergency session setup,
       has obtained its location and is setting up an emergency session) */
    /* @sic R5s230480: p_MimeWithXML and p_MimeWithBinaryData instead of p_UseMIME sic@ */
    var template (present) MessageBody v_MessageBody;
    var template (present) MIME_Part_List v_MIME_Part_List;
    var integer i;

    if (p_MimeWithXML or p_MimeWithBinaryData) {
      v_MIME_Part_List[0] := cr_MIME_Part_SDP;
      i := 1;
      if (p_MimeWithXML) {
        v_MIME_Part_List[i] := cr_MIME_Part_XML;
        i := i + 1;
      }
      if (p_MimeWithBinaryData) {
        v_MIME_Part_List[i] := cr_MIME_Part_CommonBinary;
        i := i + 1;
      }
      v_MessageBody := cr_MessageBody_MIME(cr_MIME_Message(v_MIME_Part_List));
    } else {
      v_MessageBody := cr_MessageBody_SDP;
    }
    return v_MessageBody;
  }

  /*
   * @desc      get particular message out of MIME body
   * @param     p_MIME_Message
   * @param     p_ContentType
   * @return    template (omit) MIME_Part
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SIP_MIME_MessageBody_FindBody(MIME_Message p_MIME_Message,
                                           charstring p_ContentType) return template (omit) MIME_Part
  {
    var integer i;
    var template (omit) MIME_Part v_MIME_Part := omit;
    var MIME_Part_List v_MimePartList := p_MIME_Message.mimePartList;

    for (i := 0; i < lengthof(v_MimePartList); i := i + 1) {
      if (match(v_MimePartList[i].header.contentType, cr_MimeContentType(p_ContentType))) {
        v_MIME_Part := v_MimePartList[i];
        break;          /* @sic R5s230256 change 2.3 sic@ */
      }
    }
    return v_MIME_Part;
  }

  /*
   * @desc      Add body part to body part list
   * @param     p_MIME_Part_List
   * @param     p_MIME_Part
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC)
   */
  function fl_MIME_Part_List_Add(template (value) MIME_Part_List p_MIME_Part_List,
                                 template (value) MIME_Part p_MIME_Part) return template (value) MIME_Part_List
  {
    var template (value) MIME_Part_List v_MIME_Part_List := p_MIME_Part_List;
    var integer i := lengthof(p_MIME_Part_List);

    v_MIME_Part_List[i] := p_MIME_Part;
    return v_MIME_Part_List;
  }

  /*
   * @desc      Add SDP message to body part list
   * @param     p_MIME_Part_List    (default value: {})
   * @param     p_SDP_Message
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC)
   */
  function f_MIME_Part_List_AddSDP(template (value) MIME_Part_List p_MIME_Part_List := {},
                                   template (value) SDP_Message p_SDP_Message) return template (value) MIME_Part_List
  {
    var charstring v_EncodedMessage := f_IMS_SDP_Message_Encode(p_SDP_Message);
    var template (value) MIME_Part v_MIME_Part := cs_MIME_Part_SDP(v_EncodedMessage);
    return fl_MIME_Part_List_Add(p_MIME_Part_List, v_MIME_Part);
  }

  /*
   * @desc      Add XML message to body part list
   * @param     p_MIME_Part_List    (default value: {})
   * @param     p_TypeAndSubtype
   * @param     p_ContentDisposition (default value: omit)
   * @param     p_ContentId         (default value: omit)
   * @param     p_EncodedMessage
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (IMS, LTE_A_PRO, MCX, NR5GC)
   */
  function f_MIME_Part_List_AddXML(template (value) MIME_Part_List p_MIME_Part_List := {},
                                   charstring p_TypeAndSubtype,
                                   template (omit) MIME_ContentDisposition p_ContentDisposition := omit,
                                   template (omit) MIME_ContentId p_ContentId := omit,
                                   XmlBody p_EncodedMessage) return template (value) MIME_Part_List
  {
    var template (value) MIME_Part v_MIME_Part := cs_MIME_Part_XML(p_TypeAndSubtype, p_ContentDisposition, p_ContentId, p_EncodedMessage);
    return fl_MIME_Part_List_Add(p_MIME_Part_List, v_MIME_Part);
  }

}
