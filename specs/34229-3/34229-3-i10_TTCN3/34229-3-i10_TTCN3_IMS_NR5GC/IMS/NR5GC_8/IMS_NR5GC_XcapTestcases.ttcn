   */
  function f_TC_8_17_NR5GC_IMS1() runs on IMS_XCAP_PTC
  { // Barring of All Incoming Calls / 5GS

    var SS_Type v_SupplementaryService := SS_BAIC;
    var boolean v_CheckDeactivatedRules := true;

    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED);
    f_XCAP_Preamble(gbaPreferred);

    // @siclog "Step 1 - 9" siclog@
    f_XCAP_SupplementaryService_CommonTestBody(v_SupplementaryService, -, v_CheckDeactivatedRules);

    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

