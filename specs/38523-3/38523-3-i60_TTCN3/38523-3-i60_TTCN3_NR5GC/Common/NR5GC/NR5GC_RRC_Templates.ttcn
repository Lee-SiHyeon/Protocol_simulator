module NR5GC_RRC_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_RRC_Templates all;

  const I_RNTI_Value         tsc_NR_I_RNTI_Value1 := '1000010011110011000110000100110100000001'B; /* As per 38.508-1 Table 4.6.3-64: I-RNTI-Value: SS arbitrarily selects a value between '0001'H and 'FF FFFF FFFF'H.
                                                                                                     @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  const ShortI_RNTI_Value    tsc_NR_ShortI_RNTI_Value1 := '111110100001110000000001'B;            /* As per 38.508-1 Table 4.6.3-170: ShortI-RNTI-Value: SS arbitrarily selects a value between '0001'H and 'FF FFFF'H.
                                                                                                     @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */

  const PagingCycle          tsc_NR_RAN_PagingCycle_Def :=  rf32;                                 /* As per 38.508-1 Table 4.6.1-16: RRCRelease with condition NR_RRC_INACTIVE
                                                                                                     @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) SDAP_Config cs_SDAP_Config(PDU_SessionID p_PDUSessionId := tsc_NR_PDU_SessionID_Def,
                                              boolean p_DefaultDRB := true,
                                              IntegerList_Type p_QoSFlowList := {1}) :=
  { //As per 38.508-1 Table 4.6.3-161: SDAP-Config
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    pdu_Session                := p_PDUSessionId,
    sdap_HeaderDL              := absent,
    sdap_HeaderUL              := present_,
    defaultDRB                 := p_DefaultDRB,
    mappedQoS_FlowsToAdd       := p_QoSFlowList,
    mappedQoS_FlowsToRelease   := omit
  };

  template (value) PLMN_RAN_AreaCell cs_PLMN_RAN_AreaCell(CellIdentity p_CellIdentity,
                                                         template (omit) PLMN_Identity p_PLMN_Identity := omit) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    plmn_Identity   := p_PLMN_Identity,
    ran_AreaCells   := {p_CellIdentity}
  };

  template (value) RAN_NotificationAreaInfo cs_RAN_NotificationAreaInfo_1Cell(CellIdentity p_CellIdentity,
                                                                             template (omit) PLMN_Identity p_PLMN_Identity := omit) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    cellList             := {cs_PLMN_RAN_AreaCell(p_CellIdentity, p_PLMN_Identity)}
  };

  template (value) RAN_NotificationAreaInfo cs_RAN_NotificationAreaInfo_CellList(PLMN_Identity p_PLMN_Identity1,
                                                                                 CellIdentity p_CellIdentity1,
                                                                                 PLMN_Identity p_PLMN_Identity2,
                                                                                 CellIdentity p_CellIdentity2) :=
  { /* @status    APPROVED (NR5GC) */
    cellList := {
      {
        plmn_Identity := p_PLMN_Identity1,
        ran_AreaCells := { p_CellIdentity1 }
      },
      {
        plmn_Identity := p_PLMN_Identity2,
        ran_AreaCells := { p_CellIdentity2 }
      }
    }
  };

  template (value) SuspendConfig cs_SuspendConfigDef (template (value) RAN_NotificationAreaInfo p_RAN_NotificationAreaInfo,
                                                      template (value) PagingCycle p_Ran_PagingCycle := tsc_NR_RAN_PagingCycle_Def,
                                                      template (omit)  PeriodicRNAU_TimerValue p_T380 := omit,
                                                      template (omit)  ExtendedPagingCycle_r17 p_Ran_ExtendedPagingCycle_r17 := omit,
                                                      template (omit) SuspendConfig.sdt_Config_r17  p_SDT_Config := omit,
                                                      template (omit) SuspendConfig.ran_ExtendedPagingCycleConfig_r18  p_RAN_ExtendedPagingCycleConfig_r18 := omit,
                                                      template (omit) SuspendConfig.srs_PosRRC_InactiveEnhanced_r18 p_SrsPosInactiveEnh := omit
                                                      ) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    fullI_RNTI                  := tsc_NR_I_RNTI_Value1,
    shortI_RNTI                 := tsc_NR_ShortI_RNTI_Value1,
    ran_PagingCycle             := p_Ran_PagingCycle,
    ran_NotificationAreaInfo    := p_RAN_NotificationAreaInfo,
    t380                        := p_T380,
    nextHopChainingCount        := tsc_NR_38508_NextHopChainingCount,
    sl_UEIdentityRemote_r17     := omit,                /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    sdt_Config_r17              := p_SDT_Config,        /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    srs_PosRRC_Inactive_r17     := omit,                /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    ran_ExtendedPagingCycle_r17 := p_Ran_ExtendedPagingCycle_r17,         /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    ncd_SSB_RedCapInitialBWP_SDT_r17 := omit,           /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
    resumeIndication_r18             := omit,           /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    srs_PosRRC_InactiveEnhanced_r18  := p_SrsPosInactiveEnh,  /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    ran_ExtendedPagingCycleConfig_r18:= p_RAN_ExtendedPagingCycleConfig_r18,           /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    multicastConfigInactive_r18      := omit            /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) SuspendConfig cs_38508_SuspendConfig ( template (value) RAN_NotificationAreaInfo p_RAN_NotificationAreaInfo,
                                                          template (omit) SuspendConfig.sdt_Config_r17  p_SDT_Config := omit,
                                                          template (omit) SuspendConfig.ran_ExtendedPagingCycleConfig_r18  p_RAN_ExtendedPagingCycleConfig_r18 := omit,
                                                          template (omit) SuspendConfig.srs_PosRRC_InactiveEnhanced_r18 p_SrsPosInactiveEnh := omit,
                                                          template (omit)  PeriodicRNAU_TimerValue p_T380 := omit
                                                        ) :=
  //As per 38.508-1 Table 4.6.1-4B: RRCRelease with condition NR_RRC_INACTIVE
  /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 R5s250346 sic@ */
  cs_SuspendConfigDef( p_RAN_NotificationAreaInfo, tsc_NR_RAN_PagingCycle_Def, p_T380, -, p_SDT_Config, p_RAN_ExtendedPagingCycleConfig_r18, p_SrsPosInactiveEnh);

  template (value) RRCRelease_IEs.deprioritisationReq cs_NR_DeprioritisationReq(RRCRelease_IEs.deprioritisationReq.deprioritisationType        p_DeprioritisationType,
                                                                              RRCRelease_IEs.deprioritisationReq.deprioritisationTimer       p_DeprioritisationTimer):=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    deprioritisationType := p_DeprioritisationType,
    deprioritisationTimer := p_DeprioritisationTimer
  };

  template (value) DL_DCCH_Message cs_38508_RRCResume(RRC_TransactionIdentifier p_RRC_TI := tsc_NR_RRC_TI_Def,
                                                     template (omit) octetstring p_CellGroupConfig := omit,
                                                     template (omit) RadioBearerConfig p_RadioBearerConfig := omit,
                                                     template (omit) MeasConfig p_MeasConfig := omit,
                                                     template (omit) RRCResume_v1560_IEs p_RRCResume_v1560_IEs := omit
                                                     ):=
  {  // 38.508-1 Table 4.6.1-17: RRCResume
     /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
     //@sic R5s191051 change 6 R5-201646: added p_RadioBearerConfig sic@
     //@sic R5-204441: added p_MeasConfig sic@
    message_ := {
      c1 := {
        rrcResume := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            rrcResume := {
              radioBearerConfig           := p_RadioBearerConfig,
              masterCellGroup             := p_CellGroupConfig,
              measConfig                  := p_MeasConfig,
              fullConfig                  := omit,
              lateNonCriticalExtension    := omit,
              nonCriticalExtension        := p_RRCResume_v1560_IEs
            }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_38508_RRCSecurityModeCommand(template (value) RRC_TransactionIdentifier p_RRC_TI,
                                                                  template (value) SecurityAlgorithmConfig p_SecurityAlgorithmConfig):=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        securityModeCommand := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            securityModeCommand := {
              securityConfigSMC := {
                securityAlgorithmConfig := p_SecurityAlgorithmConfig
              },
              lateNonCriticalExtension := omit,
              nonCriticalExtension := omit
            }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_38508_RRCReestablishment_Def(RRC_TransactionIdentifier p_RRC_TI := tsc_NR_RRC_TI_Def,
                                                                   NextHopChainingCount p_NextHopChainingCount := tsc_NR_38508_NextHopChainingCount
                                                                   ) :=
  { /* @status    APPROVED (NR5GC) */
    //As per 38.508-1 Table 4.6.1-10: RRCReestablishment
    message_ := {
        c1 := {
            rrcReestablishment := {
                rrc_TransactionIdentifier := p_RRC_TI,
                criticalExtensions  := {
                    rrcReestablishment := {
                        nextHopChainingCount := p_NextHopChainingCount,
                        lateNonCriticalExtension  := omit,
                        nonCriticalExtension := omit
                    }
                }
            }
        }
    }
  };

  template (value) DL_DCCH_Message cs_38508_CounterCheck(template (value) RRC_TransactionIdentifier p_RRC_TI,
                                                        template (value) DRB_CountMSB_InfoList p_CountList):=
  { //As per 38.508-1 Table 4.6.1-1: CounterCheck
    /* @status    APPROVED (NR5GC) */
    message_ := {
      c1 := {
        counterCheck := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            counterCheck := {
              drb_CountMSB_InfoList := p_CountList,
              lateNonCriticalExtension := omit,
              nonCriticalExtension := omit
            }
          }
        }
      }
    }
  };

  template (value) DRB_CountMSB_Info cs_38508_DRB_CountMSB_Info(DRB_Identity p_DRB_Id,
                                                          integer p_CountMSB_UL,
                                                          integer p_CountMSB_DL) :=
  { /* @status    APPROVED (NR5GC) */
    drb_Identity := p_DRB_Id,
    countMSB_Uplink := p_CountMSB_UL,
    countMSB_Downlink := p_CountMSB_DL
  }

  template (present) UL_DCCH_Message cr_38508_RRCSecurityModeComplete(template (present) RRC_TransactionIdentifier p_RRC_TI):=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        securityModeComplete := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            securityModeComplete := {
              lateNonCriticalExtension := *,
              nonCriticalExtension := *
            }
          }
        }
      }
    }
  };

  template (present) UL_DCCH_Message cr_38508_UECapabilityInformationAny(template (present) RRC_TransactionIdentifier p_RRC_TI):=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        ueCapabilityInformation := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            ueCapabilityInformation := {
              ue_CapabilityRAT_ContainerList := ?,
              lateNonCriticalExtension := *,
              nonCriticalExtension := *
            }
          }
        }
      }
    }
  };

  template (present) UL_DCCH_Message cr_38508_RRCReestablishmentComplete(RRC_TransactionIdentifier p_RRC_TI := tsc_NR_RRC_TI_Def,
                                                                        template RRCReestablishmentComplete_v1610_IEs p_RRCReestablishmentComplete_v1610_IEs := *   ) :=
  { //As per 38.508-1 Table 4.6.1-11: RRCReestablishmentComplete
    /* @status    APPROVED (NR5GC) */
    //@sic R5s220372 sic@
    message_ := {
        c1 := {
            rrcReestablishmentComplete := {
                rrc_TransactionIdentifier := p_RRC_TI,
                criticalExtensions  := {
                    rrcReestablishmentComplete := {
                        lateNonCriticalExtension := *,
                        nonCriticalExtension := p_RRCReestablishmentComplete_v1610_IEs
                    }
                }
            }
        }
    }
  };

  template (present) UL_DCCH_Message cr_38508_CounterCheckResponse(RRC_TransactionIdentifier p_RRC_TI,
                                                                   template DRB_CountInfoList p_DRB_CountInfoList) :=
  { /* @status    APPROVED (NR5GC) */
    /* CounterCheckResponse acc. to 38508-1 Table 4.6.1-2 */
    message_ := {
      c1 := {
        counterCheckResponse  := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            counterCheckResponse  := {
              drb_CountInfoList := p_DRB_CountInfoList,
              lateNonCriticalExtension := omit,
              nonCriticalExtension := omit
            }
          }
        }
      }
    }
  };

  template (present) DRB_CountInfo cr_DRB_CountInfo(DRB_Identity p_DRB_Id,
                                                    template (present) integer p_CountUL := ?,
                                                    template (present) integer p_CountDL := ?) :=
  { /* @status    APPROVED (NR5GC) */
    drb_Identity := p_DRB_Id,
    count_Uplink := p_CountUL,
    count_Downlink := p_CountDL
  }

  template (present) FailureInformation_v1610_IEs cr_FailureInformation_v1610 (template (omit) FailureInfoDAPS_r16 p_FailureInfoDAPS) :=
  { /* @status    APPROVED (NR5GC) */
    failureInfoDAPS_r16 := p_FailureInfoDAPS,
    nonCriticalExtension := *
  };

  template (present) UL_DCCH_Message cr_38508_UEAssistanceInformation(template ReleasePreference_r16 p_ReleasePreferenceConfig_r16 := *,
                                                                      template UEAssistanceInformation_v1700_IEs p_UEAssistanceInformation_v1700_IEs := *,
                                                                      template IDC_Assistance_r16 p_IDC_Assistance_r16 := *
                                                                     ) :=
  { /* @status    APPROVED (NR5GC) */
    /* @sic R5-251277 added p_IDC_Assistance_r16 sic@ */
    message_ := {
      c1 := {
        ueAssistanceInformation := {
          criticalExtensions := {
            ueAssistanceInformation:= {
              delayBudgetReport := *,
              lateNonCriticalExtension := *,
              nonCriticalExtension := {
                overheatingAssistance:= *,
                nonCriticalExtension := {
                  idc_Assistance_r16                := p_IDC_Assistance_r16,
                  drx_Preference_r16                := *,
                  maxBW_Preference_r16              := *,
                  maxCC_Preference_r16              := *,
                  maxMIMO_LayerPreference_r16       := *,
                  minSchedulingOffsetPreference_r16 := *,
                  releasePreference_r16             := p_ReleasePreferenceConfig_r16,
                  sl_UE_AssistanceInformationNR_r16 := *,
                  referenceTimeInfoPreference_r16   := *,
                  nonCriticalExtension              := p_UEAssistanceInformation_v1700_IEs
                }
              }
            }
          }
        }
      }
    }
  };

  template (present) UEAssistanceInformation_v1700_IEs cr_UEAssistanceInformation_v1700_IEs ( template boolean p_RRM_MeasRelaxationFulfilment_r17 := *,
                                                                                             template UEAssistanceInformation_v1700_IEs.nonSDT_DataIndication_r17 p_NonSDT_DataIndication_r17 := *
                                                                                       ) :=
  { /* @status    APPROVED (NR5GC) */
    ul_GapFR2_Preference_r17              := *,
    musim_Assistance_r17                  := *,
    overheatingAssistance_r17             := *,
    maxBW_PreferenceFR2_2_r17             := *,
    maxMIMO_LayerPreferenceFR2_2_r17      := *,
    minSchedulingOffsetPreferenceExt_r17  := *,
    rlm_MeasRelaxationState_r17           := *,
    bfd_MeasRelaxationState_r17           := *,
    nonSDT_DataIndication_r17             := p_NonSDT_DataIndication_r17,
    scg_DeactivationPreference_r17        := *,  /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
    uplinkData_r17                        := *,
    rrm_MeasRelaxationFulfilment_r17      := p_RRM_MeasRelaxationFulfilment_r17,
    propagationDelayDifference_r17        := *,
    nonCriticalExtension                  := *
  };

  template (present) UL_CCCH_Message cr_38508_RRCReestablishmentRequest ( template(present) ReestabUE_Identity p_ReestabUE_Identity,
                                                                         template(present) ReestablishmentCause p_ReestablishmentCause ) :=
  { //As per 38.508-1 Table 4.6.1-12: RRCReestablishmentRequest
    /* @status    APPROVED (NR5GC) */
    message_ := {
        c1 := {
            rrcReestablishmentRequest := {
                rrcReestablishmentRequest := {
                    ue_Identity             := p_ReestabUE_Identity,
                    reestablishmentCause := p_ReestablishmentCause,
                    spare := ?
                }
            }
        }
    }
  };

  template (present) ReestabUE_Identity cr_NR_ReestabUE_Identity( RNTI_Value p_RNTI_Value,
                                                                 PhysCellId p_PhysCellId,
                                                                 ShortMAC_I p_ShortMAC_I
                                                               ) :=
  { /* @status    APPROVED (NR5GC) */
    c_RNTI      := p_RNTI_Value,
    physCellId  := p_PhysCellId,
    shortMAC_I  := p_ShortMAC_I
  };

  template (present) UL_CCCH_Message cr_38508_RRCSystemInfoRequest(template bitstring p_Requested_SI_List := ?) :=
  { /* @status    APPROVED (NR5GC) */
    // As per 38.508-1 Table 4.6.1-24: RRCSystemInfoRequest
     /* @sic R5s201387  BASELINE MOVING 2020 sic@ */
   message_ := {
    c1 := {
        rrcSystemInfoRequest := {
          criticalExtensions := {
            rrcSystemInfoRequest  := {
                 requested_SI_List :=  p_Requested_SI_List,
                 spare             :=  ?
            }
          }
        }
    }
   }
  };

  template (value) SliceCellListNR_r17 cs_SliceListNR_r17_sliceExcludedCellListNR_1Entry (PhysCellId p_PhysCellId,
                                                                                         template (omit) PCI_RangeElement.pci_Range.range p_Range := omit) :=
  { /* @status    APPROVED (NR5GC) */
    {
      start_ := p_PhysCellId,
      range  := p_Range
    }
  };

  template (value) SliceInfo_r17 cs_SliceInfo_r17_1Entry( NSAG_ID_r17 p_NSAG_ID_r17,
                                                         template (omit) CellReselectionPriority p_NSAG_CellReselectionPriority_r17 := omit) :=
  { /* @status    APPROVED (NR5GC) */
      nsag_IdentityInfo_r17 := {
          nsag_ID_r17                        := p_NSAG_ID_r17,
          trackingAreaCode_r17               := omit
          },
      nsag_CellReselectionPriority_r17     := p_NSAG_CellReselectionPriority_r17,
      nsag_CellReselectionSubPriority_r17  := omit,
      sliceCellListNR_r17                  := omit
  };

  template (value) SliceInfo_r17 cs_SliceInfo_r17_1Entry_sliceExcludedCellListNR( NSAG_ID_r17 p_NSAG_ID_r17,
                                                                                 template (omit) CellReselectionPriority p_NSAG_CellReselectionPriority_r17 := omit,
                                                                                         template (omit) SliceCellListNR_r17 p_SliceListNR_r17 := omit) :=
  { /* @status    APPROVED (NR5GC) */
      nsag_IdentityInfo_r17 := {
          nsag_ID_r17                        := p_NSAG_ID_r17,
          trackingAreaCode_r17               := omit
          },
      nsag_CellReselectionPriority_r17     := p_NSAG_CellReselectionPriority_r17,
      nsag_CellReselectionSubPriority_r17  := omit,
      sliceCellListNR_r17                  := {
          sliceExcludedCellListNR_r17 := p_SliceListNR_r17
      }
  };

  template (value) SliceInfoList_r17 cs_SliceInfoList_r17_2Entries_2ndExcluded( NSAG_ID_r17 p_NSAG_ID_r17_1,
                                                                   template (omit) CellReselectionPriority p_NSAG_CellReselectionPriority_r17_1 := omit,
                                                                   NSAG_ID_r17 p_NSAG_ID_r17_2,
                                                                   template (omit) CellReselectionPriority p_NSAG_CellReselectionPriority_r17_2 := omit,
                                                                   template (omit) SliceCellListNR_r17 p_SliceListNR_r17 := omit) :=
  { /* @status    APPROVED (NR5GC) */
      cs_SliceInfo_r17_1Entry(p_NSAG_ID_r17_1, p_NSAG_CellReselectionPriority_r17_1),
      cs_SliceInfo_r17_1Entry_sliceExcludedCellListNR(p_NSAG_ID_r17_2, p_NSAG_CellReselectionPriority_r17_2, p_SliceListNR_r17)
  };

  template (value) UAC_BarringPerCatList cs_UAC_BarringPerCatList_1Entry(integer p_AccessCategory,
                                                                         UAC_BarringInfoSetIndex p_UAC_BarringInfoSetIndex) :=
  { /* @status    APPROVED (NR5GC) */
    {
      accessCategory := p_AccessCategory,
      uac_barringInfoSetIndex := p_UAC_BarringInfoSetIndex
    }
  };

  template (value) UAC_BarringInfoSetList cs_UAC_BarringInfoSetList_1Entry(UAC_BarringInfoSet.uac_BarringFactor p_Uac_BarringFactor,
                                                                           UAC_BarringInfoSet.uac_BarringTime p_Uac_BarringTime,
                                                                           UAC_BarringInfoSet.uac_BarringForAccessIdentity p_Uac_BarringForAccessIdentity) :=
  { /* @status    APPROVED (NR5GC) */
    {
      uac_BarringFactor := p_Uac_BarringFactor,
      uac_BarringTime := p_Uac_BarringTime,
      uac_BarringForAccessIdentity := p_Uac_BarringForAccessIdentity
    }
  };

  template (value) SIB1.uac_BarringInfo cs_SIB1_UacBarringInfo(template (omit) UAC_BarringPerCatList p_UAC_BarringPerCatList := omit,
                                                               template (omit) UAC_BarringPerPLMN_List p_UAC_BarringPerPLMN_List := omit,
                                                               template (value)UAC_BarringInfoSetList p_UAC_BarringInfoSetList ) :=
  { /* @status    APPROVED (NR5GC) */
    uac_BarringForCommon := p_UAC_BarringPerCatList,
    uac_BarringPerPLMN_List := p_UAC_BarringPerPLMN_List,
    uac_BarringInfoSetList := p_UAC_BarringInfoSetList,
    uac_AccessCategory1_SelectionAssistanceInfo := omit
  };

}
