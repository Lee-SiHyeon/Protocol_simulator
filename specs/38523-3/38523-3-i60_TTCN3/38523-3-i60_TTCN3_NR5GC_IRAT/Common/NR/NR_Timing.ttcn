module NR_Timing {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_EnquireTiming(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId),
    Request := {
      EnquireTiming := true
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_EnquireTiming(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      EnquireTiming := true
    }
  };

  /*
   * @desc      Set slot number in SubFrameTiming
   * @param     p_SubFrameTiming
   * @param     p_SlotNumber
   * @param     p_SCS
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SubFrameTiming_SetSlot(SubFrameTiming_Type p_SubFrameTiming,
                                       UInt_Type p_SlotNumber,
                                       SubcarrierSpacing p_SCS) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_SubFrameTiming := p_SubFrameTiming;
    var SlotOffset_Type v_SlotOffset;
    var UInt_Type v_MaxValue;

    select (p_SCS) { //Acc to 38.211 Table 4.3.2-1
      case(kHz15) {
        v_SlotOffset.Numerology0 := true;
        v_MaxValue := 0;
      }
      case(kHz30) {
        v_SlotOffset.Numerology1 := p_SlotNumber;
        v_MaxValue := 1;
      }
      case(kHz60) {
        v_SlotOffset.Numerology2 := p_SlotNumber;
        v_MaxValue := 3;
      }
      case(kHz120) {
        v_SlotOffset.Numerology3 := p_SlotNumber;
        v_MaxValue := 7;
      }
      case(kHz240) {
        v_SlotOffset.Numerology4 := p_SlotNumber;
        v_MaxValue := 15;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid SubcarrierSpacing");
      }
    }
    if (p_SlotNumber > v_MaxValue) {
      FatalError (__FILE__, __LINE__, "invalid slot number for given SubcarrierSpacing");
    }
    v_SubFrameTiming.Slot.SlotOffset := v_SlotOffset;
    return v_SubFrameTiming;
  }

  /*
   * @desc      Get slot number from SubFrameTiming
   * @param     p_SubFrameTiming
   * @return    UInt_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SubFrameTiming_GetSlotNumber(SubFrameTiming_Type p_SubFrameTiming) return UInt_Type
  {
    var UInt_Type v_SlotNumber;
    select union (p_SubFrameTiming.Slot.SlotOffset) {
      case (Numerology1) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology1; }
      case (Numerology2) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology2; }
      case (Numerology3) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology3; }
      case (Numerology4) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology4; }
      case else          { v_SlotNumber := 0; }
    }
    return v_SlotNumber;
  }

  /*
   * @desc      calculate timer tolerance acc. to TS 38.508-1 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_TimerTolerance(NR_CellId_Type p_NR_CellId,
                                ProtocolTimer_Type p_ProtocolTimer,
                                float p_Timer) return float
  { /* NOTE: even though currently not being used, p_NR_CellId and p_ProtocolTimer are kept for future use */
    var float v_Tolerance := p_Timer * 0.1;

    return v_Tolerance;
  }

  /*
   * @desc      to calculate lower bound of timer tolerance acc. to TS 38.508-1 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_SetTimerToleranceMin(NR_CellId_Type p_NR_CellId,
                                     ProtocolTimer_Type p_ProtocolTimer,
                                     float p_Timer) return float
  {
    var float v_Tolerance := fl_NR_TimerTolerance(p_NR_CellId, p_ProtocolTimer, p_Timer);
    if (p_Timer < v_Tolerance) {
      return 0.0;
    }
    return p_Timer - v_Tolerance;
  }

  /*
   * @desc      calculate upper bound of timer tolerance acc. to 36.508 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SetTimerToleranceMax(NR_CellId_Type p_NR_CellId,
                                     ProtocolTimer_Type p_ProtocolTimer,
                                     float p_Timer) return float
  {
    var float v_Tolerance := fl_NR_TimerTolerance(p_NR_CellId, p_ProtocolTimer, p_Timer);
    return p_Timer + v_Tolerance;
  }

  /*
   * @desc      Return the current SFN and subframe
   * @param     p_NR_CellId
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetCurrentTiming(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var NR_SYSTEM_CTRL_CNF v_ReceivedCnf;
    var SubFrameTiming_Type v_Timing;

    SYS.send(cas_NR_EnquireTiming(p_NR_CellId));
    SYS.receive(car_NR_EnquireTiming(p_NR_CellId)) -> value v_ReceivedCnf;
    v_Timing := v_ReceivedCnf.Common.TimingInfo.SubFrame;

    return v_Timing;
  }

  type record NR_SchedulingParameters_Type {    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    UInt_Type ValidSubframeIndex,
    UInt_Type SubframePeriodicity,
    UInt_Type ValidSlotNumber,
    UInt_Type SlotOffsetPdcchPxsch
  };

  /*
   * @desc      Initialise parameters for scheduling of DL assignments
   * @return    NR_SchedulingParameters_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SchedulingParameters_DL() return NR_SchedulingParameters_Type
  {
    var NR_SchedulingParameters_Type v_SchedulingParameters := {
      ValidSubframeIndex := 2,                    /* => with half-frame periodicity subframes 2 and 7 are valid for DL transmissions */
      SubframePeriodicity := 5,                   /* half-frame */
      ValidSlotNumber := 0,                       /* first slot in a subframe */
      SlotOffsetPdcchPxsch := 0                   /* slot offset K0 according to 38.214 clause 5.1.2.1 */
    }
    return v_SchedulingParameters;
  }

  /*
   * @desc      Returns Gap Configuration of the NR Cell
   * @param     p_NR_CellId
   * @return    template (omit) GapConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_GetGapConfig(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) GapConfig
  {
    var NR_MeasGapCtrl_Type v_MeasGapCtrl := f_NR_CellInfo_GetMeasGapCtrl(p_NR_CellId);
    var MeasGapConfig v_MeasGapConfig;
    var template (omit) GapConfig v_GapConfigUE := omit;
    var template (omit) GapConfig v_GapConfigFR1 := omit;
    var template (omit) GapConfig v_GapConfigFR2 := omit;


    if (ischosen(v_MeasGapCtrl.Config.R15)) {
      v_MeasGapConfig := v_MeasGapCtrl.Config.R15;
      if (ischosen(v_MeasGapConfig.gapUE.setup)) {
        v_GapConfigUE := v_MeasGapConfig.gapUE.setup;
      }
      if (ischosen(v_MeasGapConfig.gapFR1.setup)) {
        v_GapConfigFR1 := v_MeasGapConfig.gapFR1.setup;
      }
      if (ischosen(v_MeasGapConfig.gapFR2.setup)) {
        v_GapConfigFR2 := v_MeasGapConfig.gapFR2.setup;
      }
      if (isvalue(v_GapConfigUE)) {
        if (isvalue(v_GapConfigFR1) or isvalue(v_GapConfigFR2)) {
          FatalError(__FILE__, __LINE__, "not supported");
        }
        return v_GapConfigUE;
      } else if (isvalue(v_GapConfigFR1)) {
        if (isvalue(v_GapConfigFR2)) {
          FatalError(__FILE__, __LINE__, "not supported");
        }
        return v_GapConfigFR1;
      } else {
        return v_GapConfigFR2;
      }
    }
    return omit;
  }

  /*
   * @desc      skip measurement gaps to avoid sending of messages during measurement gaps
   * @param     p_SubFrameTiming
   * @param     p_GapConfig
   * @param     p_SchedulingParameters
   * @param     p_SlotsPerSubframe
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SkipMeasGap(SubFrameTiming_Type p_SubFrameTiming,
                               GapConfig p_GapConfig,
                               NR_SchedulingParameters_Type p_SchedulingParameters,
                               UInt_Type p_SlotsPerSubframe) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_SubFrameTiming := p_SubFrameTiming;
    var integer v_GapOffsetInSlots := p_GapConfig.gapOffset * p_SlotsPerSubframe;
    var integer v_GapLengthInSlots;
    var UInt_Type v_GapSfnPeriod;
    var integer v_SfnBase;
    var integer v_GapStart;
    var integer v_GapEnd;
    var integer v_SFN;
    var integer v_Subframes;
    var integer v_TimingInSlots;
    var integer v_GapTimingAdvanceInSlots;
    var integer i := 0;
    
    select (p_GapConfig.mgrp) {
      case (ms20)  { v_GapSfnPeriod := 2; }
      case (ms40)  { v_GapSfnPeriod := 4; }
      case (ms80)  { v_GapSfnPeriod := 8; }
      case (ms160) { v_GapSfnPeriod := 16; }
      case else { FatalError(__FILE__, __LINE__, ""); }
    }
    
    select (p_GapConfig.mgl) {
      case (ms1dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 3) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms3)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 3); }
      case (ms3dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 7) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms4)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 4); }
      case (ms5dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 11) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms6)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 6); }
      case else { FatalError(__FILE__, __LINE__, ""); }
    }
    
    select (p_GapConfig.mgta) {
      case (ms0)      { v_GapTimingAdvanceInSlots := 0; }
      case (ms0dot25) { v_GapTimingAdvanceInSlots := (p_SlotsPerSubframe + 3) / 4; }   /* => e.g. for SCS=15kHz a whole slot is affected by the measurement gap timing advance */
      case (ms0dot5)  { v_GapTimingAdvanceInSlots := (p_SlotsPerSubframe + 1) / 2; }   /* (see above) */
      case else { FatalError(__FILE__, __LINE__, ""); }
    }

    v_SFN := v_SubFrameTiming.SFN.Number;
    v_TimingInSlots := (((v_SFN * 10) + v_SubFrameTiming.Subframe.Number) * p_SlotsPerSubframe) + f_NR_SubFrameTiming_GetSlotNumber(v_SubFrameTiming);
    v_SfnBase := (v_SFN / v_GapSfnPeriod) * v_GapSfnPeriod;   // SFN rounded down to the next multiple of v_GapSfnPeriod

    if (v_GapOffsetInSlots + v_GapLengthInSlots > v_GapSfnPeriod * 10 * p_SlotsPerSubframe) { /* i.e. gap starts at the end of a period and ends at the beginning of the period */
      v_SfnBase := v_SfnBase - 1;
    }
    v_GapStart := (v_SfnBase * 10 * p_SlotsPerSubframe) + v_GapOffsetInSlots;
    v_GapEnd := v_GapStart + v_GapLengthInSlots;
    v_GapStart := v_GapStart - v_GapTimingAdvanceInSlots;

    while ((v_GapStart <= v_TimingInSlots) and (v_TimingInSlots < v_GapEnd)) {
      if (i > 10) {    /* to avoid endless loop */
        FatalError(__FILE__, __LINE__, "No scheduling possible");
      }
      v_TimingInSlots := v_TimingInSlots + (p_SchedulingParameters.SubframePeriodicity * p_SlotsPerSubframe);
      i := i + 1;
    }
    if (i > 0) { /* => v_TimingInSlots has been changed */
      v_Subframes := v_TimingInSlots / p_SlotsPerSubframe;
      v_SFN := v_Subframes / 10;
      v_SubFrameTiming.Subframe.Number := v_Subframes mod 10;  /* @sic R5s200276 "mod" instead of "/" sic@ */
      v_SubFrameTiming.SFN.Number := v_SFN mod 1024;
      v_SubFrameTiming.HSFN.Number := (v_SubFrameTiming.HSFN.Number + (v_SFN / 1024)) mod 1024;
    }
    return v_SubFrameTiming;
  }

  /*
   * @desc      Get timing for the next PDCCH assignment of a PDSCH/PDUSCH transmission scheduled at the next valid occasion p_SubframOffsetMin subframes after start of the frame given by p_HSFN and p_SFN
   * @param     p_NR_CellId
   * @param     p_HSFN
   * @param     p_SFN
   * @param     p_SubframOffsetMin
   * @param     p_SchedulingParameters
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_NextPdcchOcassion(NR_CellId_Type p_NR_CellId,
                                   HyperSystemFrameNumberInfo_Type p_HSFN,
                                   SystemFrameNumberInfo_Type p_SFN,
                                   UInt_Type p_SubframOffsetMin,
                                   NR_SchedulingParameters_Type p_SchedulingParameters) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var template (omit) GapConfig v_GapConfig := fl_NR_GetGapConfig(p_NR_CellId);
    var UInt_Type v_Period := p_SchedulingParameters.SubframePeriodicity;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var UInt_Type v_AdditionalOffset := (v_Period + p_SchedulingParameters.ValidSubframeIndex - (p_SubframOffsetMin mod v_Period)) mod v_Period;   /* additional subframe offset to next valid subframe */
    var UInt_Type v_SubframOffset := p_SubframOffsetMin + v_AdditionalOffset;
    var UInt_Type v_SlotOffset := (v_SubframOffset * v_SlotsPerSubframe) + p_SchedulingParameters.ValidSlotNumber - p_SchedulingParameters.SlotOffsetPdcchPxsch;
    var SubFrameTiming_Type v_Timing := valueof(cs_SubFrameTiming(p_SFN.Number, 0, p_HSFN.Number));
    
    v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, v_SlotOffset / v_SlotsPerSubframe);
    v_Timing := f_NR_SubFrameTiming_SetSlot(v_Timing, v_SlotOffset mod v_SlotsPerSubframe, v_SCS);
    
    if (isvalue(v_GapConfig)) {
      f_NR_SkipMeasGap(v_Timing, valueof(v_GapConfig), p_SchedulingParameters, v_SlotsPerSubframe);
    }

    return v_Timing;
  }

  /*
   * @desc      get the next send occasion for UL grant or DCI of DL transmission
   * @param     p_NR_CellId
   * @param     p_TimingInfo
   * @param     p_MilliSeconds
   * @param     p_SchedulingParameters
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_GetNextSendOccasion(NR_CellId_Type p_NR_CellId,
                                     template (value) TimingInfo_Type p_TimingInfo,
                                     UInt_Type p_MilliSeconds,
                                     NR_SchedulingParameters_Type p_SchedulingParameters) runs on NR_BASE_PTC return SubFrameTiming_Type
  { /* @sic R5s200022: new parameter p_TimingInfo sic@ */
    var SubFrameTiming_Type v_Timing;

    if (p_MilliSeconds < 100) {
      FatalError(__FILE__, __LINE__, "next send occasion shall be at least 100ms in advance");
    }
    if (f_TimingInfo_IsNow(p_TimingInfo)) { /* @sic R5s200022 sic@ */
      v_Timing := f_NR_GetCurrentTiming(p_NR_CellId);
    } else {
      v_Timing := valueof(p_TimingInfo.SubFrame);
    }
    return f_NR_NextPdcchOcassion(p_NR_CellId, v_Timing.HSFN, v_Timing.SFN, v_Timing.Subframe.Number + p_MilliSeconds, p_SchedulingParameters);
  }

  /*
   * @desc      get the next send occasion for DCI of DL transmission: the corresponding DL transmission will be K0 slots later (but in the same slot for K0=0)
   * @param     p_NR_CellId
   * @param     p_MilliSeconds      (default value: 100)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetNextSendOccasion_DL(NR_CellId_Type p_NR_CellId,
                                       UInt_Type p_MilliSeconds := 100,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC return SubFrameTiming_Type
  { /* @sic R5s200022: new parameter p_TimingInfo sic@ */
    var NR_SchedulingParameters_Type v_SchedulingParameters := f_NR_SchedulingParameters_DL();
    return fl_NR_GetNextSendOccasion(p_NR_CellId, p_TimingInfo, p_MilliSeconds, v_SchedulingParameters);
  }

  /*
   * @desc      Calculate timing info based on timing info of the given cell and the SFN offset, Tcell and TcOffset of the given cells
   * @param     p_NR_CellId1
   * @param     p_TimingInfo1
   * @param     p_NR_CellId2
   * @return    template (value) TimingInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_TimingOtherCell(NR_CellId_Type p_NR_CellId1,
                                template (value) TimingInfo_Type p_TimingInfo1,
                                NR_CellId_Type p_NR_CellId2) runs on NR_BASE_PTC return template (value) TimingInfo_Type
  {
    var CellTimingInfo_Type v_CellTimingInfo1 := f_NR_CellInfo_GetCellTimingInfo(p_NR_CellId1);
    var CellTimingInfo_Type v_CellTimingInfo2 := f_NR_CellInfo_GetCellTimingInfo(p_NR_CellId2);
    var SubcarrierSpacing v_SCS_Cell1 := f_NR_CellInfo_GetSCS(p_NR_CellId1);
    var SubcarrierSpacing v_SCS_Cell2 := f_NR_CellInfo_GetSCS(p_NR_CellId2);
    var template (omit) SlotTimingInfo_Type v_SlotTimingInfo := omit;//@sic R5s210079 sic@
    
    if (v_SCS_Cell1 != v_SCS_Cell2) { //@sic R5s210079 sic@
        select (v_SCS_Cell2){
            case (kHz15) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology0;}
            case (kHz30) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology1(0);}
            case (kHz60) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology2(0);}
            case (kHz120){v_SlotTimingInfo := cs_SlotTimingInfo_Numerology3(0);}
            case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSpacing");}
        }
    }
    return f_CellTimingInfo_TimingOtherCell(v_CellTimingInfo1, p_TimingInfo1, v_CellTimingInfo2, v_SlotTimingInfo);
  }

}
