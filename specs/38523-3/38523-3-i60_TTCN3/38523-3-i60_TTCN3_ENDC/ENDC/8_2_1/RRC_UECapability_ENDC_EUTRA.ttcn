  template (value) DL_DCCH_Message cs_508_UeCapabilityEnquiry_MRDC_r15_SegAllowed_r16_enabled(RRC_TransactionIdentifier p_RRC_TI,
                                                                                              template (value) UE_CapabilityRequest p_UE_CapabilityRequest,
                                                                                              template (omit) octetstring p_MRDC := omit) :=
    /* According to 36.508 cl. 4.6.1 Table 4.6.1-22 with rrc_SegAllowed_r16 enabled*/
    /* @status    APPROVED (ENDC, NR5GC_IRAT) */
     cs_508_UeCapabilityEnquiry(p_RRC_TI,
                                p_UE_CapabilityRequest,
                                p_MRDC,
                                -, -, enabled);

  template (value) DL_DCCH_Message cs_508_UeCapabilityEnquiry_MRDC_r15IEs_true_SegAllowed_r16_enabled(RRC_TransactionIdentifier p_RRC_TI) :=
     /* @status    APPROVED (ENDC) */
     /* Derivation path of 36.508 cl. 4.6.1 Table 4.6.1-22 acc. to Table 8.2.1.1.1.3.3-1 */
     cs_508_UeCapabilityEnquiry(p_RRC_TI,
                                -,
                                -, true_, true_, enabled);

  template UE_EUTRA_Capability_v1550_IEs cr_UE_EUTRA_Capability_v1550_IEs (template UE_EUTRA_Capability_v1630_IEs p_UE_EUTRA_Capability_v1630_IEs := *) := // @sic R5s201387 BASELINE MOVING 2020; R5s221178 BASELINE MOVING 2022 sic@
  { /* @status    APPROVED (ENDC) */
    neighCellSI_AcquisitionParameters_v1550 := *,
    phyLayerParameters_v1550 := ?,
    mac_Parameters_v1550 := ?,
    fdd_Add_UE_EUTRA_Capabilities_v1550 := ?,
    tdd_Add_UE_EUTRA_Capabilities_v1550 := ?,
