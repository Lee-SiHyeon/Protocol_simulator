module IMS_NR5GC_CallControlTestcases {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions5G all;
  import from IMS_CC_CustomizedAlertingTonesCommon all;
  import from IMS_CC_Parameters all;
  import from IMS_CC_SessionTimerCommon all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_IPCAN_Coordination all;
  import from IMS_MessageBody_Templates all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_Video all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_MessagesVideo all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from IMS_XML_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      return Contact URL sent by the SS in the 183 Session Progress
   * @param     p_CallInfo
   * @return    SipUrl
   * @status    APPROVED (IMS)
   */
  function fl_IMS_CC_MO_CallInfo_GetContactUrlSS(IMS_CC_MO_CallInfo_Type p_CallInfo) return SipUrl
  {
    return f_Contact_GetSipUrl(p_CallInfo.MessageHeader183.contact);
  }

  /*
   * @desc      Steps 2-7 of generic procedure specified in Table 4.9.15.2.2-1 of TS 38.508-1
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_IMS_MOCallSetup_CheckInviteWithPreconditions() runs on IMS_PTC return boolean
  {
    var template (present) SDP_attribute_list v_MediaAttributesWithPreconditions := superset(all from cr_SDP_PreconditionAttributes(?, ?, ?, ?));
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var SDP_Message v_SdpOffer;

    IMS_Server.check(receive(car_IMS_Invite_Request) -> value v_IMS_DATA_REQ);
    v_SdpOffer := f_IMS_SDP_Message_Decode(v_IMS_DATA_REQ.Request.Invite.messageBody.sdpMessageBody);
    
    return match(v_SdpOffer.media_list[0].attributes, v_MediaAttributesWithPreconditions);
  }

  /*
   * @desc      add video to DL SDP message, if video has been contained in the initial SDP offer sent by the UE
   * @param     p_InitialSdpOffer
   * @param     p_SdpMessageAudioOnly
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NoSdpInINVITE_SdpAddVideoIfNeeded_TX(SDP_Message p_InitialSdpOffer,
                                                                  template (value) SDP_Message p_SdpMessageAudioOnly) return template (value) SDP_Message
  {
    var SDP_media_desc v_SDP_Media_Video;
    var template (value) SDP_Message v_SdpMessage := p_SdpMessageAudioOnly;

    if (isvalue(p_InitialSdpOffer.media_list[1])) {  // @sic R5-217998: if SDP offer contains video sic@
      v_SDP_Media_Video := p_InitialSdpOffer.media_list[1];
      v_SDP_Media_Video.media_field.ports.port_number := 0;
      v_SdpMessage.media_list[1] := v_SDP_Media_Video;
    }
    return v_SdpMessage;
  }

  /*
   * @desc      add video to UL SDP message template, if video has been contained in the initial SDP offer sent by the UE
   * @param     p_InitialSdpOffer
   * @param     p_SdpMessageAudioOnly
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NoSdpInINVITE_SdpAddVideoIfNeeded_RX(SDP_Message p_InitialSdpOffer,
                                                                  template (present) SDP_Message p_SdpMessageAudioOnly) return template (present) SDP_Message
  {
    var template (present) SDP_Message v_SdpMessage := p_SdpMessageAudioOnly;

    if (isvalue(p_InitialSdpOffer.media_list[1])) {
      v_SdpMessage.media_list[1] := cr_SDP_Media_Desc_Common(cr_SDP_Media_Video(-, 0, ?), -, *, *, *);
    }
    return v_SdpMessage;
  }

  /*
   * @desc      steps 1 - 6 of test cases 7.10 and 7.25
   * @param     p_PreconditionsRequired
   * @param     p_EvsConfiguration  (default value: EVS_A2)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NoSdpInINVITE_Step1_6(boolean p_PreconditionsRequired,
                                                   SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration := EVS_A2) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* NOTE: the returned InviteRequestWithSdp contains the SDP offer sent by the UE in the 183 Session Progress */
    /* @sic R5-231495: A.4.1 -> A.4.1a sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var template (present) SDP_attribute_list v_PreconditionAttributesOffer := {};
    var template (present) SDP_Message v_SdpOfferAudioOnly;
    var template (present) SDP_Message v_SdpOfferAudioVideo;
    var template (present) SDP_Message v_SdpOffer;
    var template (value) MessageHeader v_MessageHeader_Prack;
    var template (omit)  SDP_attribute_list v_PreconditionAttributesAnswer := omit;
    var template (value) SDP_Message v_SdpAnswer;
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList;
    var SDP_media_desc v_MediaDescAudio;
    var boolean v_CheckForbiddenCodecParameters := true;
    var InternetProtocol_Type v_Protocol;
    var SipUrl v_ContactUrl;

    if (p_PreconditionsRequired) {
      v_PreconditionAttributesOffer := cr_SDP_PreconditionAttributesWithConf(c_none, c_none, c_mandatory, c_optional);  /* @sic R5s210462 change 2 -> R5-212770 has been withdrawn at TSGR5#91 => des:qos kept optional for remote sic@
                                                                                                                           @sic R5-223349: WithConf sic@ */
      v_PreconditionAttributesAnswer := cs_SDP_PreconditionAttributes(c_none, c_none, c_mandatory, c_mandatory);        /* @sic R5-223349: No Conf sic@ @sic R5s220877: c_none, c_none instead of c_sendrecv, c_sendrecv sic@ */
    }

    // Step 2:                  INVITE
    v_AudioCodecList := {};                     // => no SDP
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(p_PreconditionsRequired, v_AudioCodecList);

    // Step 3 - 4:              100 Trying, 183 Session Progress
    v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR;
    v_SdpOfferAudioOnly := f_IMS_BuildSDP_InitialOfferAudioWithPreconditions_RX(v_AudioCodecList, v_PreconditionAttributesOffer);     /* @sic R5s210462 change 2 sic@ */
    v_SdpOfferAudioVideo := v_SdpOfferAudioOnly;
    v_SdpOfferAudioVideo.media_list[1] := cr_SDP_Media_Desc(cr_SDP_Media_Video(-, -, ?), ?, ?, ?);                      // @sic R5-217998: SDP offer may contain video sic@ @sic R5s220110: cr_SDP_Media_Video(-, ?) sic@
    v_SdpOffer := (v_SdpOfferAudioOnly, v_SdpOfferAudioVideo);

    v_ResponseWithSdp := f_IMS_MTCallSetup_Receive100Trying_Receive183SessionProgress(v_InviteRequestWithSdp.Invite, v_SdpOffer, v_InviteRequestWithSdp.RoutingInfo.Protocol, p_PreconditionsRequired);   /* @sic R5s210393: p_PreconditionsRequired sic@ */
    v_MediaDescAudio := v_ResponseWithSdp.SdpMessage.media_list[0];
    f_IMS_SDP_CheckMediaDescr_AudioCodecs(v_MediaDescAudio, v_AudioCodecList, v_CheckForbiddenCodecParameters);
    f_IMS_SDP_CheckMediaDescr_EVS_Configuration(v_MediaDescAudio, p_EvsConfiguration);                                  /* @sic R5-231495: p_EvsConfiguration sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // Step 5:                  PRACK
    v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_ResponseWithSdp.SdpMessage, p_PreconditionsRequired, EVS_16000, p_EvsConfiguration, 65, v_PreconditionAttributesAnswer);      /* @sic R5-231495: p_EvsConfiguration sic@ */
    v_SdpAnswer := f_IMS_MTCallSetup_NoSdpInINVITE_SdpAddVideoIfNeeded_TX(v_ResponseWithSdp.SdpMessage, v_SdpAnswer);   // @sic R5-217998: if SDP offer contains video sic@
    v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_MessageHeader_Prack := f_IMS_PrackRequest_MessageHeaderTX(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader, cs_ContentTypeSDP);
    if (p_PreconditionsRequired) {
      v_MessageHeader_Prack.require := cs_Require(tsc_OptionTagList_precondition);                                      /* @sic R5-214226 sic@ */
    }
    IMS_Client.send(cas_IMS_Prack_Request(cs_IMS_RoutingInfo(v_Protocol), cs_PRACK_Request(v_ContactUrl, v_MessageHeader_Prack, cs_MessageBody_SDP(v_SdpAnswer))));

    // Step 6:                  200 OK
    a_IMS_ReceiveResponse200OK(v_MessageHeader_Prack, v_Protocol);

    // Establish Dedicated EPS bearer
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall, p_PreconditionsRequired);  /* trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
                                                                                                 @sic R5s210423: p_PreconditionsRequired sic@ */

    v_InviteRequestWithSdp.SdpOffer := v_ResponseWithSdp.SdpMessage;
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a Step 1 - 10: MT call esteblishment with preconditions
   * @param     p_SessionExpires    (default value: omit)
   * @param     p_Allow             (default value: omit)
   * @param     p_OptionTagsForSupported (default value: tsc_OptionTagList_Invite_C11)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10(template (omit) SessionExpires p_SessionExpires := omit,
                                                   template (omit) Allow p_Allow := omit,
                                                   OptionTag_List p_OptionTagsForSupported := tsc_OptionTagList_Invite_C11) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-231489: use of f_IMS_MTCallSetup_BuildInviteRequestWithSpecificSdp, f_IMS_MTCallSetup_NR5GC_A_5_1x_Step2_7 sic@ */
    /* @sic R5-231494, R5-231496, R5-231497: step 1 - 10 only sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    // step 1 - 7:              INVITE, 100 Trying, 183 Session Progress, PRACK, 200 OK, UPDATE, 200 OK
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_7(-, p_SessionExpires, p_Allow, p_OptionTagsForSupported);

    // Step 8 - 10:             180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithPreconditions);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a Step 1 - 10A: MT call esteblishment with preconditions up to MMI accepting the call
   * @param     p_SessionExpires    (default value: omit)
   * @param     p_Allow             (default value: omit)
   * @param     p_OptionTagsForSupported (default value: tsc_OptionTagList_Invite_C11)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A(template (omit) SessionExpires p_SessionExpires := omit,
                                                    template (omit) Allow p_Allow := omit,
                                                    OptionTag_List p_OptionTagsForSupported := tsc_OptionTagList_Invite_C11) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-231498: A.5.1a instead of A.5.1 sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    // step 1 - 10
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10(p_SessionExpires, p_Allow, p_OptionTagsForSupported);  /* @sic R5s230345: f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10 instead of f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A sic@ */

    // Step 10A
    f_UT_AnswerCall(MMI);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a: MT call establishment (Default Configuration)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_1a() runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A();

    f_IMS_MTCallSetup_Receive200OK_SendACK(v_InviteRequestWithSdp);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      MO release of video
   * @param     p_PrevSdpMessage
   * @param     p_CallIdentification
   * @status    APPROVED (IMS)
   */
  function f_IMS_VideoCall_NR5GC_ReleaseVideoMO(SDP_Message p_PrevSdpMessage,
                                                charstring p_CallIdentification) runs on IMS_PTC
  {
    var boolean v_PreconditionsRequired := f_SDP_MediaDescr_CheckWithPreconditions(p_PrevSdpMessage.media_list[0]);  /* NOTE: it is assumed that audio/video either both use precondition or both don't use precondition */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var SipUrl v_ContactUrl;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) SDP_Message v_SdpAnswer;
    var template (value) MessageBody v_MessageBody;
    var template (value) MessageHeader v_MessageHeader200OK;
    var template (present) MessageHeader v_MessageHeaderACK;
    
    f_UT_IMS_RemoveVideoMedia(MMI, p_CallIdentification);

    // Receive INVITE
    v_InviteRequestWithSdp := f_IMS_VideoCall_ReleaseVideoMO_Invite(p_PrevSdpMessage, EVS_16000, H265_90000, v_PreconditionsRequired);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine100, f_IMS_InviteResponse_100_MessageHeaderTX(v_InviteRequest))));
    
    // Send 100 Trying
    f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_ReleaseVideo);

    // Send 200 OK
    v_SdpAnswer := f_IMS_BuildSDP_CommonResponseToOfferTX(v_InviteRequestWithSdp.SdpOffer);
    v_MessageBody := cs_MessageBody_SDP(v_SdpAnswer);
    v_MessageHeader200OK := f_IMS_OtherResponse_200_MessageHeaderTX(v_InviteRequest.msgHeader, cs_ContentTypeSDP, -, -, v_PreconditionsRequired);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine200, v_MessageHeader200OK, v_MessageBody)));

    // Receive ACK
    v_ContactUrl := v_InviteRequest.requestLine.requestUri;
    v_MessageHeaderACK := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequest, c_statusLine200);
    f_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_ContactUrl, v_MessageHeaderACK)));
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);    // Wait for trigger from IPCAN to ensure that radio resources have been released
  }

  /*
   * @desc      MT release of video
   * @param     p_LatestSdpMessageFromSS
   * @param     p_PreconditionRequiredForSDP (default value: true)
   * @status    APPROVED (IMS)
   */
  function f_IMS_VideoCall_NR5GC_ReleaseVideoMT(template (value) SDP_Message p_LatestSdpMessageFromSS,
                                                boolean p_PreconditionRequiredForSDP := true) runs on IMS_PTC
  { /* @sic R5s220336: p_PreconditionRequiredForSDP sic@ */
    var SipUrl v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);   // The UE's Contact URI
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) SDP_Message v_SdpOffer := p_LatestSdpMessageFromSS;
    var template (value) MessageHeader v_MessageHeaderINVITE;
    var template (present) MessageHeader v_MessageHeader200OK;

    // Send INVITE
    v_SdpOffer.origin.session_version := f_IMS_PTC_ImsInfo_DialogIncrAndGetSessVersionTX();
    v_SdpOffer.media_list[1].media_field.ports.port_number := 0;
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_Video_SendInvite(RemoveVideo, v_SdpOffer, v_ContactUrlUE);

    // Receive 100 Trying (optional) and 200 OK
    v_MessageHeaderINVITE := v_InviteRequestWithSdp.Invite.msgHeader;
    v_MessageHeader200OK := f_IMS_OtherResponse_200_MessageHeaderRX(v_MessageHeaderINVITE, cr_ContentTypeSDP, p_PreconditionRequiredForSDP);
    f_IMS_ReceiveResponse_OptionalTrying(v_InviteRequestWithSdp.Invite.msgHeader,
                                         v_InviteRequestWithSdp.RoutingInfo.Protocol,
                                         cr_Response(c_statusLine200, v_MessageHeader200OK, cr_MessageBody_SDP));

    f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_ReleaseVideo);
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    // Send ACK
    f_IMS_InviteMT_SendACK(v_InviteRequestWithSdp);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.1.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_1_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / 503 Service Unavailable / 5GS
    var template (present) SipUrl v_CalleeUri := f_IMS_INVITE_CalleeUriRX();    // as used per default in the INVITE and in this test case for the ACK as the UE has not gotten any callee's contact URI
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var template (value) MessageHeader v_MessageHeader503;
    var template (present) MessageHeader v_MessageHeaderACK;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var integer v_RetryAfter := 20;   // @sic R5-210882: 60s -> 20s sic@
    var float v_RetryAfterMin := f_IMS_SetTimerToleranceMin(int2float(v_RetryAfter));
    var boolean v_InviteWithPreconditions;
    
    timer t_Timer;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2 - 7" siclog@
    v_InviteWithPreconditions := fl_IMS_MOCallSetup_CheckInviteWithPreconditions();

    if (v_InviteWithPreconditions) {  // @sic R5-213521 sic@
      // @siclog "Step 8a" siclog@              INVITE
      v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(v_CalleeUri);               // @sic R5-225925, R5-236507: A_4_1 -> A_4_1a sic@
    } else {
      // @siclog "Step 8b" siclog@              INVITE
      v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1(v_CalleeUri);               // @sic R5-236507: A_4_2 -> A_4_2a sic@
    }
    v_InviteRequest := v_InviteRequestWithSdp.Invite;

    // @siclog "Step 9" siclog@                 503 Service Unavailable
    v_MessageHeader503 := f_IMS_CommonResponse_503_MessageHeaderTX(v_InviteRequest.msgHeader, cs_RetryAfter(v_RetryAfter));
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine503, v_MessageHeader503)));
    
    // @siclog "Step 10" siclog@                ACK
    v_MessageHeaderACK := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequest, c_statusLine503);
    f_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_CalleeUri, v_MessageHeaderACK)));
    
    f_IMS_PTC_ImsInfo_DialogRelease();

    // @siclog "Step 11 - 13" siclog@           Check: Does the UE (not) transmit INVITE request message
    f_Delay(v_RetryAfterMin);
    
    t_Timer.start(30.0);
    alt {                     // @sic R5-216210 sic@
      [] IMS_Server.check(receive(car_IMS_Invite_Request)) {
        t_Timer.stop;
        if (v_InviteWithPreconditions) {  // @sic R5-213521 sic@
          // @siclog "Step 14a1" siclog@            INVITE
          v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(v_CalleeUri);        // @sic R5-225925, R5-236507: A_4_1 -> A_4_1a sic@
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14a1");
          // @siclog "Step 14a2-14a15" siclog@      Steps 2 to 12 of A.4.1a
          f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_12(v_InviteRequestWithSdp);                    // @sic R5-225925, R5-236507: A_4_1 -> A_4_1a sic@
        } else {
          // @siclog "Step 14b1" siclog@            INVITE
          v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1(v_CalleeUri);        // @sic R5-236507: A_4_2 -> A_4_2a sic@
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14b1");
          // @siclog "Step 14b2-14b13" siclog@      Steps 2 to 8 of subclause A.4.2a
          f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_8(v_InviteRequestWithSdp);                     // @sic R5-236507: A_4_2 -> A_4_2a sic@
        }
      }
      [] t_Timer.timeout {
        f_IMS_CC_AbortCall();         // @sic R5s230086 sic@
      }
    }

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.2.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_2_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / 504 Server Time-out / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) MessageHeader v_MessageHeader504;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (present) MessageHeader v_MessageHeaderACK;
    var boolean v_InviteWithPreconditions;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2 - 7" siclog@             Steps 2-7 of generic procedure specified in Table 4.9.15.2.2-1 of TS 38.508-1
    
    v_InviteWithPreconditions := fl_IMS_MOCallSetup_CheckInviteWithPreconditions();     // @sic R5-225443 sic@

    if (v_InviteWithPreconditions) {
      // @siclog "Step 8a" siclog@              INVITE
      v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();                 // @sic R5-225926, R5-236508: A_4_1 -> A_4_1a sic@
    }
    else {
      // @siclog "Step 8b" siclog@              INVITE
      v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1();                 // @sic R5-236508: A_4_2 -> A_4_2a sic@
    }

    // @siclog "Step 9" siclog@                 504 Server Time-out
    v_MessageHeader504 := f_IMS_CommonResponse_504_MessageHeaderTX(v_InviteRequestWithSdp.Invite.msgHeader);
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine504, v_MessageHeader504, cs_MessageBody_XML_Ims_3gpp(cs_Ims_3gpp_Restoration))));

    // @siclog "Step 9A" siclog@                ACK
    v_MessageHeaderACK := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequestWithSdp.Invite, c_statusLine504);
    f_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_InviteRequestWithSdp.Invite.requestLine.requestUri, v_MessageHeaderACK)));

    f_IMS_GlobalRelease(keepUnprotected);               // release security context but keep unprotected context (TCP) @sic R5s220609 - Additional changes: keepUnprotected instead of oldestProtectedContextOnly sic@
    f_IMS_CC_AbortCall();                               // abort call establishment procedure at the IPCAN PTC

    // @siclog "Step 10 - 17" siclog@
    f_IMS_Registration();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);   // @sic R5s210100: IPCAN_MO_IMS_Signalling instead of IPCAN_MO_SpeechCall sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.4a.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_7_4a_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call with preconditions at both originating UE and terminating UE / Default Configuration / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var SipUrl v_ContactUrlUE;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 6" siclog@             100 Trying, 183 Session Progress, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_5(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);     // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1

    // @siclog "Step 7 - 8" siclog@             UPDATE, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 9 - 11" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 12 - 13" siclog@           200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");


    // @siclog "Step 14 - 15" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);                                // @sic R5-223458: Call release within the test body but without delay sic@

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.5.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_5_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call without preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1();           // @sic R5-236896: A_4_2 -> A_4_2a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 6" siclog@             100 Trying, 183 Session Progress, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_5(v_InviteRequestWithSdp);             // @sic R5-236896: A_4_2 -> A_4_2a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);             // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1

    // @siclog "Step 7 - 7B" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6(v_InviteRequestWithSdp, tsc_OptionTagList_100rel);     // @sic R5-241655: 100rel sic@

    // @siclog "Step 8 - 9" siclog@             200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.6a.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_6a_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call with preconditions at both originating UE and terminating UE / Default Configuration / 5GS
    /* @sic R5-230323: re-implementation using A.5.1a (R5-231489) sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var SipUrl v_ContactUrlUE;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(tsc_SDP_WithPreconditions);

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(v_InviteRequestWithSdp, tsc_SDP_WithPreconditions);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // Establish Dedicated EPS bearer
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall);  /* trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer*/

    // @siclog "Step 6 - 7" siclog@             UPDATE, 200 OK
    f_IMS_MTCallSetup_NR5GC_A_5_1a_Step6_7(v_InviteRequestWithSdp, v_ResponseWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 8 - 10" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithPreconditions);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 10A - 12" siclog@          MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 13 - 14" siclog@           BYE, 200 OK
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.7.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_7_7_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call without preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(tsc_SDP_WithoutPreconditions);                        /* @sic R5-235324: A.5.2a (EVS_A2) instead of A.5.2 (EVS_B0_A1) sic@ */

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(v_InviteRequestWithSdp, tsc_SDP_WithoutPreconditions);   /* @sic R5-235324: A.5.2a (EVS_A2) instead of A.5.2 (EVS_B0_A1) sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // Establish Dedicated EPS bearer
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall, tsc_SDP_WithoutPreconditions);                       /* trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
                                                                                                                           @sic R5s210423: tsc_SDP_WithoutPreconditions sic@ */
    // @siclog "Step 6 - 8" siclog@             180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithoutPreconditions);        /* @sic R5s210423: tsc_SDP_WithoutPreconditions sic@
                                                                                                                                   @sic R5-235324: in A.5.2a 100rel is mandatory sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    // @siclog "Step 8A - 10" siclog@           MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.8.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_7_8_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call without preconditions at originating UE and with preconditions at terminating UE / 5GS
