    generalParametersMRDC        := f_NR_Derive_GeneralParametersMRDC(),
    fdd_Add_UE_MRDC_Capabilities := f_NR_Derive_MeasAndMobParametersMRDC_XDD_Diff() ifpresent,
    tdd_Add_UE_MRDC_Capabilities := f_NR_Derive_MeasAndMobParametersMRDC_XDD_Diff() ifpresent,
    fr1_Add_UE_MRDC_Capabilities := *,
    fr2_Add_UE_MRDC_Capabilities := *,
    featureSetCombinations       := *,
    pdcp_ParametersMRDC_v1530    := {
      pdcp_DuplicationSplitSRB := f_NR_Derive_pdcp_DuplicationSplitSRB_ParametersMRDC_v1530(),
      pdcp_DuplicationSplitDRB := f_NR_Derive_pdcp_DuplicationSplitDRB_ParametersMRDC_v1530()
    } ifpresent,
    lateNonCriticalExtension     := *,
    nonCriticalExtension         := p_UE_MRDC_Capability_v1560_IEs /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
  };

  template UE_MRDC_Capability_v1560 cr_UE_MRDC_Capability_v1560_IEs (template UE_MRDC_Capability_v1610 p_UE_MRDC_Capability_v1610_IEs := *) := /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
  {  /* @status    APPROVED (ENDC) */
