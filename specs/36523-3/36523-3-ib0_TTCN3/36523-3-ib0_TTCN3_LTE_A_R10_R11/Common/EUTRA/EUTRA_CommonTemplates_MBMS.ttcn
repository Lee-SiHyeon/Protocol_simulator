module EUTRA_CommonTemplates_MBMS {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_ASP_DrbDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_AspCommon_Templates all;
  import from EUTRA_AuxiliaryFunctions all;
  import from EUTRA_CellInfo_MBMS all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_Measurement_Templates all;
  import from EUTRA_NB_ASP_L2DataDefs all;
  import from EUTRA_NB_CommonRLC all;
  import from EUTRA_NB_RRC_Templates all;
  import from EUTRA_PdcchConfig all;

  type MBMSInterestIndication_r11_IEs.mbms_Priority_r11  Mbms_Priority_r11_Type;  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) SYSTEM_CTRL_REQ cas_MBMS_Config_REQ(EUTRA_CellId_Type  p_CellId,
                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                       template (omit) MBSFN_SubframeConfigList p_Mbsfn_SubframeConfigList := omit,
                                                       template (omit) MbsfnAreaList_Type  p_MbsfnAreaList := omit) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, p_TimingInfo),
    Request := {
      MbmsConfig  := cs_MBMS_Config(p_Mbsfn_SubframeConfigList, p_MbsfnAreaList)
    }
  };

  template (value) MBMS_Config_Type cs_MBMS_Config(template (omit) MBSFN_SubframeConfigList p_Mbsfn_SubframeConfigList := omit,
                                                   template (omit) MbsfnAreaList_Type  p_MbsfnAreaList := omit) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Mbsfn_SubframeConfigList :=   p_Mbsfn_SubframeConfigList,
    MbsfnAreaList            :=   p_MbsfnAreaList,
    ScptmConfig              :=   omit
  };

  template (value) MbsfnArea_Type cs_MbsfnArea_Def(template (omit) MBSFN_AreaInfo_r9  p_Mbsfn_AreaInfo := omit,
                                                   template (omit) MCCH_Data_Type  p_McchData := omit,
                                                   template (omit) MBSFNAreaConfiguration_r9   p_MbsfnAreaConfiguration := omit,
                                                   template (omit) MRB_List_Type   p_MRB_List := omit) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Mbsfn_AreaInfo := p_Mbsfn_AreaInfo,
    McchData := p_McchData,
    MbsfnAreaConfiguration := p_MbsfnAreaConfiguration,
    MRB_List := p_MRB_List
  };

  template (value) MCCH_Data_Type cs_MCCH_Data(template (omit) MBSFN_AreaId_r12 p_Mbsfn_AreaId,
                                               template (omit) MCCH_MessageList_Type p_MCCH_MessageList) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Mbsfn_AreaId := p_Mbsfn_AreaId,   /* Used only for modification of MCCH info.
                                       * Omitted if Mbsfn_AreaInfo is present and mandatory present otherwise */
    MsgList := p_MCCH_MessageList
  };

  template (value) SYSTEM_CTRL_REQ cas_MCCH_ChangeNotification_REQ(EUTRA_CellId_Type  p_CellId,
                                                                   template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                   template (value) NotificationIndicator_r9_Type p_NotificationIndicator,
                                                                   template (omit)  SubframeOffsetList_Type p_SubframeOffsetList := omit) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, p_TimingInfo),
    Request := {
      PDCCH_MCCH_ChangeNotification  := cs_PDCCH_MCCH_ChangeNotification_Def(p_NotificationIndicator, p_SubframeOffsetList)
    }
  };

  template (present) SYSTEM_CTRL_CNF car_MBMS_Config_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    //@sic R5s140139 sic@
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      MbmsConfig := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_MCCH_ChangeNotification_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    //@sic R5s140139 sic@
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      PDCCH_MCCH_ChangeNotification := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_MSI_Config_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    //@sic R5s140139 sic@
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      MSI_Config := true
    }
  };

  template (value) MCCH_Message cs_MCCH_MBSFNAreaConfiguration_Msg(template (value) MBSFNAreaConfiguration_r9 p_MBSFNAreaConfiguration_r9) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    message_ := {
      c1 := {
        mbsfnAreaConfiguration_r9 := p_MBSFNAreaConfiguration_r9
      }
    }
  };

  template (value) PMCH_Info_r9 cs_PMCH_Info(template (value) PMCH_Config_r9 p_PMCH_Config,
                                             template (value) MBMS_SessionInfo_r9 p_MBMS_SessionInfo) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    pmch_Config_r9 := p_PMCH_Config,
    mbms_SessionInfoList_r9 := { p_MBMS_SessionInfo }
  };

  template (value) PMCH_InfoList_r9 cs_PMCH_InfoList_1Entry(template (value) PMCH_Info_r9 p_PMCH_Info) := { p_PMCH_Info }; /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) MBSFNAreaConfiguration_r9 cs_MBSFNAreaConfiguration(template (value) MBSFN_SubframeConfig p_MBSFN_SubframeConfig,
                                                                       MBSFNAreaConfiguration_r9.commonSF_AllocPeriod_r9 p_CommonSF_AllocPeriod,
                                                                       template (value) PMCH_InfoList_r9 p_PMCH_InfoList) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    commonSF_Alloc_r9 := { p_MBSFN_SubframeConfig },
    commonSF_AllocPeriod_r9 := p_CommonSF_AllocPeriod,
    pmch_InfoList_r9 := p_PMCH_InfoList,
    nonCriticalExtension := omit
  };

  template (value) MBSFNAreaConfiguration_r9 cs_MBSFNAreaConfiguration_NoPmchInfoList(template (value) MBSFN_SubframeConfig p_MBSFN_SubframeConfig) :=
  /* Acc to 36.523-1 Table 17.3.1.3.3-1a : MBSFNAreaConfiguration
     @status    APPROVED (LTE_A_R10_R11) */
    cs_MBSFNAreaConfiguration(p_MBSFN_SubframeConfig, rf32, {});

  template (value) MBSFNAreaConfiguration_r9 cs_508_MBSFNAreaConfiguration_Def(template (value) MBSFN_SubframeConfig p_MBSFN_SubframeConfig,
                                                                               template (value) TMGI_r9 p_TMGI:= cs_TMGI_Def) :=
  // Acc to 35.508 Table 4.6.1-4A: MBSFNAreaConfiguration
  /* @status    APPROVED (LTE_A_R10_R11) */
    cs_MBSFNAreaConfiguration(p_MBSFN_SubframeConfig, rf8, cs_PMCH_InfoList_1Entry(cs_PMCH_Info(cs_PMCH_Config_Def, cs_MBMS_SessionInfo(p_TMGI))));

  template (value) PMCH_Config_r9 cs_PMCH_Config(integer p_SF_AllocEnd,
                                                 integer p_DataMCS,
                                                 PMCH_Config_r9.mch_SchedulingPeriod_r9 p_SchedulingPeriod) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    sf_AllocEnd_r9 := p_SF_AllocEnd,
    dataMCS_r9 := p_DataMCS,
    mch_SchedulingPeriod_r9 := p_SchedulingPeriod
  };

  template (value) PMCH_Config_r9  cs_PMCH_Config_Def := cs_PMCH_Config(1, 0, rf8); /* Acc to 36.508 Table 4.6.1-4A: MBSFNAreaConfiguration
                                                                                       @status    APPROVED (LTE_A_R10_R11) */

  template (value) MBMS_SessionInfo_r9 cs_MBMS_SessionInfo(template (value) TMGI_r9 p_TMGI := cs_TMGI_Def) :=
  { // Acc to 36.508 Table 4.6.1-4A: MBSFNAreaConfiguration
    /* @status    APPROVED (LTE_A_R10_R11) */
    tmgi_r9 := p_TMGI,
    sessionId_r9 := omit,
    logicalChannelIdentity_r9 := 1
  };

  template (value) PDCCH_MCCH_ChangeNotification_Type cs_PDCCH_MCCH_ChangeNotification_Def(template (value) NotificationIndicator_r9_Type p_NotificationIndicator,
                                                                                           template (omit)  SubframeOffsetList_Type p_SubframeOffsetList := omit) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    NotificationIndicator_r9   := p_NotificationIndicator,
    SubframeOffsetList  := p_SubframeOffsetList
  };

  template (value)  PmchLogicalChannel_Type  cs_PmchLogicalChannel_Def(Pmch_InfoIndex_Type p_Pmch_InfoIndex := tsc_PMCH_InfoIndex_Def,
                                                                       LogicalChannelIdentity_r9_Type p_LogicalChannelIdentity_r9 := tsc_MRB1_LCHId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Pmch_InfoIndex             := p_Pmch_InfoIndex,
    LogicalChannelIdentity     := p_LogicalChannelIdentity_r9
  };

  template (value)  MTCH_ConfigInfo_Type cs_MTCH_ConfigInfo_Def :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Rlc  := {
      Rb := {
        UM_OnlyDL := {
          Tx := {
            R8 := {
              sn_FieldLength := size5
            }
          }
        }
      },
      TestMode := omit
    },
    Mac := {
      None := true
    }
  };

  template (value)  MRB_Type cs_MRB_Type_Def(Pmch_InfoIndex_Type p_Pmch_InfoIndex := tsc_PMCH_InfoIndex_Def,
                                             LogicalChannelIdentity_r9_Type p_LogicalChannelIdentity_r9 := tsc_MRB1_LCHId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    PmchLogicalChannel   := cs_PmchLogicalChannel_Def(p_Pmch_InfoIndex,p_LogicalChannelIdentity_r9),
    Config := { AddOrReconfigure := cs_MTCH_ConfigInfo_Def}
  };

  template (value) MRB_Identity_Type cs_MRB_Identity_Def(MBSFN_AreaId_r12 p_Mbsfn_AreaId := tsc_Mbsfn_AreaId_Def,
                                                         Pmch_InfoIndex_Type p_Pmch_InfoIndex := tsc_PMCH_InfoIndex_Def,
                                                         LogicalChannelIdentity_r9_Type p_LogicalChannelIdentity_r9 := tsc_MRB1_LCHId) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Mbsfn_AreaId := p_Mbsfn_AreaId,
    PmchLogicalChannel :=cs_PmchLogicalChannel_Def(p_Pmch_InfoIndex,p_LogicalChannelIdentity_r9)
  };

  template (value) ReqAspCommonPart_Type cs_ReqAspCommonPart_MRB(EUTRA_CellId_Type p_CellId,
                                                                 template (value) MRB_Identity_Type p_MRB_Id,
                                                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                 boolean p_CnfFlag := tsc_NoCnfReq) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    CellId := p_CellId,
    RoutingInfo := {
      RadioBearerId := {Mrb := p_MRB_Id}
    },
    TimingInfo := p_TimingInfo,
    ControlInfo := {
      CnfFlag := p_CnfFlag,
      FollowOnFlag := false
    },
    RlcBearerRouting := omit  /* @sic R5w180111: CA_Info -> RlcBearerRouting sic@ */
  };

  template (value) MRB_COMMON_REQ  cs_MRB_COMMON_REQ_Def(EUTRA_CellId_Type p_CellId,
                                                         template (value) MRB_Identity_Type p_MRB_Id,
                                                         template (value) TimingInfo_Type p_TimingInfo,
                                                         template (value) DRB_DataPerSubframeList_DL_Type p_DRB_DataPerSubframeList,
                                                         boolean p_CnfFlag := tsc_NoCnfReq) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Common   :=  cs_ReqAspCommonPart_MRB(p_CellId, p_MRB_Id, p_TimingInfo, p_CnfFlag),
    U_Plane  := {
      SubframeDataList := p_DRB_DataPerSubframeList
    }
  };

  template (value) DRB_DataPerSubframe_DL_Type cs_DRB_DataPerSubframe_Def(integer  p_SFOffset,
                                                                          template (value) RLC_SDU_Type  p_RLC_SDU) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    SubframeOffset  := p_SFOffset,
    HarqProcess     := { Automatic := true},
    PduSduList      := {RlcSdu   := { p_RLC_SDU}}               /* SS configuration: RLC UM mode with no PDCP, for example MRB */
  };

  template (value) MCCH_Message cs_MCCH_MBMSCountingRequest_Msg(template (value) MBMSCountingRequest_r10 p_MBMSCountingRequest) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    message_ := {
      later := {
        c2 := {
          mbmsCountingRequest_r10 := p_MBMSCountingRequest
        }
      }
    }
  };

  template (value) MBMSCountingRequest_r10 cs_508_MBMSCountingRequest_Def (integer p_ServiceId :=0) :=
  { /* 36.508 Table 4.6.1-4AA */
    /* @status    APPROVED (LTE_A_R10_R11) */
    countingRequestList_r10 := {
      {
        tmgi_r10   := {
          plmn_Id_r9 := {
            plmn_Index_r9  := 1
            },
          serviceId_r9 := int2oct(p_ServiceId,3)
        }
      }
    },
    lateNonCriticalExtension    := omit,
    nonCriticalExtension        := omit
  };

  template (present) UL_DCCH_Message cr_508_MBMSCountingResponse_Def(integer p_Service_Id :=0) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    message_ := {
      c1 := {
        mbmsCountingResponse_r10  := {
          criticalExtensions := {
            c1 := {
              countingResponse_r10 := {
                mbsfn_AreaIndex_r10 := omit,
                countingResponseList_r10:= {
                  {
                    countingResponseService_r10 := p_Service_Id
                  }
                },
                lateNonCriticalExtension  :=  omit,
                nonCriticalExtension      :=  omit
              }
            }
          }
        }
      }
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_MSI_Config_REQ(EUTRA_CellId_Type p_CellId,
                                                      template (value) TimingInfo_Type p_TimingInfo,
                                                      template (value) MSI_Config_Type p_MSI_Config) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, p_TimingInfo),
    Request := {
      MSI_Config := p_MSI_Config
    }
  };

  template (value) MSI_Config_Type cs_MSI_NoneConfig :=
  { /* no MSI MCE included */
    /* @status    APPROVED (LTE_A_R10_R11) */
    None := true
  };

  template (value) MSI_Config_Type cs_MSI_AutoConfig(template (value) MSI_MCE_Type p_MSI_MCE) :=
  { /* MSI MCE included */
    /* @status    APPROVED (LTE_A_R10_R11) */
    Auto := p_MSI_MCE
  };

  template (value) MSI_Type cs_MSI_Config(integer  p_LchID,
                                          integer  p_StopMTCH) :=
  { /* 36.321 clause 6.1.3.7 */
    /* @status    APPROVED (LTE_A_R10_R11) */
    LchID    := p_LchID,         /* MRB Logical Channel ID */
    StopMTCH := p_StopMTCH       /* Stop MTCH */
  };

  template (value) MSI_MCE_Type cs_MSI_MCE_1(integer  p_LchID,
                                             integer  p_StopMTCH) :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    cs_MSI_Config(p_LchID, p_StopMTCH)
  };

  template (value) PdcchCandidateList_Type cs_PdcchCandidateList_FDD_eMBMS_5MHz :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    {
      RNTI := tsc_C_RNTI_Def,     // 4097 ('1001'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 0
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 1
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 2
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 3
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 4
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 5
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 6
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 7
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 8
        cs_CCE_StartIndex_DL_UL(8, 10)        // subframe 9
      }
    },
    {
      RNTI := tsc_C_RNTI_Def2,    // 4148 ('1034'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 0
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 1
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 2
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 3
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 4
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 5
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 6
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 7
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 8
        cs_CCE_StartIndex_DL_UL(8, 10)        // subframe 9
      }
    },
    {
      RNTI := tsc_C_RNTI_Def3,    // 4369 ('1111'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 0
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 1
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 2
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 3
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 4
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 5
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 6
        cs_CCE_StartIndex_DL_UL(8, 10),       // subframe 7
        cs_CCE_StartIndex_DL_UL(10, 8),       // subframe 8
        cs_CCE_StartIndex_DL_UL(8, 10)        // subframe 9
      }
    }
  };

  template (value) PdcchCandidateList_Type cs_PdcchCandidateList_TDD_eMBMS_5MHz :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    {
      RNTI := tsc_C_RNTI_Def,     // 4097 ('1001'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(4, 0),       // subframe 0
        cs_CCE_StartIndex_DL_UL(0, 4),       // subframe 1
        cs_CCE_StartIndex_DL_UL(0, 0),       // subframe 2
        cs_CCE_StartIndex_DL_UL(0, 0),       // subframe 3
        cs_CCE_StartIndex_DL_UL(8, 0),       // subframe 4
        cs_CCE_StartIndex_DL_UL(4, 0),       // subframe 5
        cs_CCE_StartIndex_DL_UL(0, 8),       // subframe 6
        cs_CCE_StartIndex_DL_UL(0, 0),       // subframe 7
        cs_CCE_StartIndex_DL_UL(0, 0),       // subframe 8
        cs_CCE_StartIndex_DL_UL(4, 0)        // subframe 9
      }
    },
    {
      RNTI := tsc_C_RNTI_Def2,    // 4148 ('1034'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(4, 0),        // subframe 0
        cs_CCE_StartIndex_DL_UL(0, 0),        // subframe 1
        cs_CCE_StartIndex_DL_UL(0, 0),        // subframe 2
        cs_CCE_StartIndex_DL_UL(0, 0),        // subframe 3
        cs_CCE_StartIndex_DL_UL(4, 8),        // subframe 4
        cs_CCE_StartIndex_DL_UL(4, 0),        // subframe 5
