  import from UTRAN_Component all;
  import from UTRAN_RRC_SysInfo_Templates all;
  import from UTRAN_RRC_Templates all;

  template (value) FrequencyBandsIndicatorFDD  cs_FrequencyBandsIndicatorFDD1(RadioFrequencyBandFDD p_RadioFrequencyBandFDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    frequencyBandsIndicator1 := p_RadioFrequencyBandFDD
  };

  template (value) FrequencyBandsIndicatorFDD  cs_FrequencyBandsIndicatorFDD2(RadioFrequencyBandFDD2 p_RadioFrequencyBandFDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    frequencyBandsIndicator2 := p_RadioFrequencyBandFDD
  };

  template (value) FrequencyBandsIndicatorFDD  cs_FrequencyBandsIndicatorFDD3(RadioFrequencyBandFDD3 p_RadioFrequencyBandFDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    frequencyBandsIndicator3 := p_RadioFrequencyBandFDD
  };

  template (value) SysInfoType5_va80ext_IEs  cs_SysInfoType5_va80ext (template (value) FrequencyBandsIndicatorFDD p_FrequencyBandsIndicatorFDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    multipleFrequencyBandIndicatorListFDD := { p_FrequencyBandsIndicatorFDD }
  };

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band1 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(fdd2100));      /* @status    APPROVED (LTE_IRAT) */

