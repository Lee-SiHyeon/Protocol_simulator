module MAC_R16_R17_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from MAC_Common_NR5GC all;
  import from MAC_R16_R17_TC_Common_NR all;
  import from MAC_TC_Common_NR all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_L2_Common all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.16
   * @status    APPROVED (NR5GC)
   */
   function f_TC_7_1_1_1_16_NR5GC() runs on NR5GC_PTC
  {
    /* Random access procedure / RedCap UE identification / Msg3-based / CCCH1 */
    f_NR5GC_Init(NR_1);                                                 // Init Cell parameters
        
    f_NR_CellConfig_Def(nr_Cell1);                                      // Create and configure NR cell 1
    f_NR5GC_Preamble(nr_Cell1, STATE_INACTIVE_2A);
    //@sic R5s230640 sic@
    f_NR_CellInfo_SetMAC_CellGroupConfigL2(nr_Cell1);
    f_NR_TestBody_Set(true);
    f_TC_7_1_1_1_16_NR_TestBody();
    f_NR_TestBody_Set(false);
    
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.17
   * @status    APPROVED (NR5GC)
   */
   function f_TC_7_1_1_1_17_NR5GC() runs on NR5GC_PTC
  {
    /* Random access procedure / RedCap UE identification */
    var template (value) NR_UplinkBWP_Type v_NR_UplinkBWP ; //Initial BWP
    var template (value) RACH_ConfigCommon v_RACH_ConfigCommon;
    var template (value) RACH_ConfigCommon v_RACH_ConfigCommon_Back;
    var template (omit) BWP_UplinkCommon.pucch_ConfigCommon v_Pucch_ConfigCommon_Back := omit;
    var  NR_PhysicalParameters_Type v_NR_PhysicalParameters ; //@sic R5s240366 sic@
   
    f_NR5GC_Init(NR_1);                                                 // Init Cell parameters
   //@sic R5s230656 sic@
    f_NR_CellInfo_SetSIB1_FeaturePriority(nr_Cell1, cs_FeaturePriorities_RedCap);
  
    
    f_NR_CellConfig_Def(nr_Cell1);                                      // Create and configure NR cell 1
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);
    f_NR_CellInfo_SetMAC_CellGroupConfigL2(nr_Cell1);
    f_NR_TestBody_Set(true);
    v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP (nr_Cell1, tsc_NR_BWP_Id); //Initial BWP
    v_Pucch_ConfigCommon_Back:= f_NR_CellInfo_GetSIB1_PUCCHConfigCommon( nr_Cell1);
    v_RACH_ConfigCommon := v_NR_UplinkBWP.Common.R15.rach_ConfigCommon.setup ;
    v_RACH_ConfigCommon_Back:= v_RACH_ConfigCommon;
   
    //@siclog "Step 1" siclog@
    //PUCCH_ConfigCommon & FeaturePriorities configured in preamble
   //@sic R5-231529 sic@
   v_RACH_ConfigCommon.featureCombinationPreamblesList_r17 := {cs_FeatureCombinationPreambles(8, cs_FeatureCombination_RedCap, 4)};
   f_NR_CellInfo_SetSIB1_InitialUplinkBWP_Rach_ConfigCommon(nr_Cell1,cs_Rach_ConfigCommon_Config_Setup(v_RACH_ConfigCommon) );
   //@sic R5s240366 sic@
   v_NR_UplinkBWP.Common.R15.rach_ConfigCommon.setup := v_RACH_ConfigCommon; //Updated RACH Config Common
   f_NR_CellInfo_SetUplinkBWP(nr_Cell1, v_NR_UplinkBWP, tsc_NR_BWP_Id);
   v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
   f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_CellConfigPhysicalLayerUplink(nr_Cell1, -, cs_NR_CellConfigPhysicalLayerUplink_Def(-,-,cs_NR_UplinkBWPs(v_NR_PhysicalParameters.UL_BWPs))));

   //@siclog "Step 2-10" siclog@
   f_TC_7_1_1_1_17_NR_TestBody(8,3);
    //@siclog "Step 11" siclog@
    //The SS transmits RRCRelease
    f_NR_RRCRelease(nr_Cell1);
     //@siclog "Step  12" siclog@
   f_NR_CellInfo_SetSIB1_PUCCHConfigCommon(nr_Cell1, v_Pucch_ConfigCommon_Back);
   f_NR_CellInfo_SetSIB1_InitialUplinkBWP_Rach_ConfigCommon(nr_Cell1,cs_Rach_ConfigCommon_Config_Setup(v_RACH_ConfigCommon_Back) );
   v_RACH_ConfigCommon.featureCombinationPreamblesList_r17 := {cs_FeatureCombinationPreambles(12, cs_FeatureCombination_RedCap, 4)};
   f_NR_ConfigRedCapUL_BWP(nr_Cell1,cs_PUCCH_ConfigCommon_ResourceCommonRedCap ,v_RACH_ConfigCommon );
     //@siclog "Step 13-21" siclog@
    f_TC_7_1_1_1_17_NR_TestBody(12,3);
    
    f_NR_TestBody_Set(false);
    
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  };

}
