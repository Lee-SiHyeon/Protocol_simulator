  /*
   * @desc      get timing info (SNF offset, Tcell) from the cell info as stored for the given cell
   * @param     p_CellId
   * @return    CellTimingInfo_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
