module WLAN_CellInfo {

  import from CommonDefs all;
  import from WLAN_ASP_TypeDefs all;
  import from WLAN_Parameters all;

  const WLAN_BeaconRSSI_Type tsc_MaxReferenceBeaconRSSI := 168;    //@sic R5s220679 sic@    //@sic R5s221338 sic@                    /* @status    APPROVED (IMS) */

  type record WLAN_CellInfo_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    WLAN_CellId_Type                    CellId,
    ReferenceCellBeaconRSSI_Type        ReferencePower,              // Cell power configuration
    WLAN_AP_Parameters_Type             WLAN_AP_Parameters
  };

  type record length (tsc_WLAN_MaxNumberOfCells) of WLAN_CellInfo_Type WLAN_CellInfoArray_Type; /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */

  type record ReferenceCellBeaconRSSI_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    WLAN_InitialCellPower_Type          InitialBeaconRSSI,
    WLAN_Attenuation_Type               Attenuation
  };

  type record WLAN_CellPower_Type {         /* Type definition for f_WLAN_SetCellPowerList
                                               @status    APPROVED (IMS) */
    WLAN_CellId_Type CellId,
    WLAN_BeaconRSSI_Type BeaconRSSI
  };

  type record length(1..tsc_WLAN_MaxNumberOfCells) of WLAN_CellPower_Type WLAN_CellPowerList_Type;  /* used together with f_WLAN_SetCellPowerList
                                                                                                       @status    APPROVED (IMS) */

  type WLAN_CellInfo_Type.WLAN_AP_Parameters.WLAN_Identifiers.SSID WLAN_SSID_Type;                  /* @status    APPROVED (IMS) */

  type record WLAN_SimulatedAP_Type
  {  /* @status    APPROVED (IMS) */
      WLAN_CellId_Type  CellId,
      WLAN_SSID_Type    SSID,
      WLAN_BeaconRSSI_Type BeaconRSSI
  }

   type record length(1..tsc_WLAN_MaxNumberOfCells) of WLAN_SimulatedAP_Type WLAN_APList_Type;  /* @status    APPROVED (IMS) */

   template (value) WLAN_SimulatedAP_Type cs_WLAN_SimulatedAP (WLAN_CellId_Type p_CellId := wlan_Cell27,
                                                               WLAN_SSID_Type p_SSID := tsc_WLAN_SSID_AP1,                 //Default value as per Table 4.4.8-1 in 36.508
                                                               WLAN_BeaconRSSI_Type p_BeaconRSSI := tsc_MaxReferenceBeaconRSSI)  //Default value as per Table 4.4.8-1 in 36.508
   := { /* @status    APPROVED (IMS) */
       CellId := p_CellId,
       SSID := p_SSID,
       BeaconRSSI :=p_BeaconRSSI
   }

   template (value) WLAN_APList_Type cs_WLAN_SimulatedAPList_Def := {cs_WLAN_SimulatedAP()};        /* @status    APPROVED (IMS) */

   template (value) WLAN_CellPower_Type cs_WLAN_PowerCell(WLAN_CellId_Type p_CellId,
                                                         WLAN_BeaconRSSI_Type p_BeaconRSSI) :=
  { /* @status    APPROVED (IMS) */
    CellId := p_CellId,
    BeaconRSSI := p_BeaconRSSI
  };

  /*
   * @desc      Return the index corresponding to p_CellId
   * @param     p_CellId
   * @return    integer
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_GetIndex(WLAN_CellId_Type p_CellId) return integer
  {
    var integer v_Index := 0;
    
    select (p_CellId) {
      case (wlan_Cell27) {
        v_Index := 0;
      }
      case (wlan_Cell27b) { //@sic R5w200302 sic@
        v_Index := 2;
      }
      case else  {
        FatalError (__FILE__, __LINE__, "Invalid CellId");
      }
    }
    return v_Index;
  }

  /*
   * @desc      Function to get the Channel number acc. to 36.508 4.3.1.6
   * @param     p_Band
   * @return    WLAN_ChannelNumber_Type
   * @status    APPROVED (IMS)
   */
  function fl_GetWLANChannelNumber(WLAN_Band_Type p_Band) return WLAN_ChannelNumber_Type
  {
    var WLAN_ChannelNumber_Type v_ChannelNumber;

    select(p_Band){
      case (Band2_4Ghz) {
        v_ChannelNumber := 6;
      }
      case (Band5Ghz) {
        v_ChannelNumber := 56;
      }
      case(Band3_6Ghz){
        FatalError (__FILE__, __LINE__, "Frequencies not yet defined for 3.6 GHz band");
      }
      case else  {
        FatalError (__FILE__, __LINE__, "Invalid Frequency");
      }
    }
    return v_ChannelNumber;
  }

  template (value) WLAN_CellInfo_Type cs_WLAN_CellInfoDef(WLAN_CellId_Type p_CellId,
                                                          WLAN_Band_Type p_Band,
                                                          WLAN_ChannelNumber_Type p_ChannelNumber,
                                                          WLAN_SSID_Type p_SSID := tsc_WLAN_SSID_AP1,  //@sic R5w200302 sic@
                                                          WLAN_BeaconRSSI_Type p_BeaconRRSI := tsc_MaxReferenceBeaconRSSI //@sic R5w200302 sic@
  ) :=
  { /* @status    APPROVED (IMS) */
    CellId := p_CellId,
    ReferencePower := {
      InitialBeaconRSSI := {
        BeaconRSSI := p_BeaconRRSI,
        Attenuation := {Off := true}
      },
      Attenuation := {Off := true}
    },
    WLAN_AP_Parameters := {
      WLAN_Band            := p_Band,
      ChannelNumber        := p_ChannelNumber,
      ChannelBandwidth     := bw20,
      WLAN_Identifiers     := {
        SSID := p_SSID,
        BSSID := omit,
        HESSID := omit
      },
      WLAN_Revision        :=  Rev_2012,
      WLAN_Hotspot_Version :=  Rev_2
    }
  };

  /*
   * @desc      Generic function for WLAN Cell Info Configuration
   * @param     p_SimulatedAP       (default value: cs_WLAN_SimulatedAP)
   * @return    WLAN_CellInfo_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_Init(template (value) WLAN_SimulatedAP_Type p_SimulatedAP := cs_WLAN_SimulatedAP) return WLAN_CellInfo_Type
  {// @sic R5w200302 sic@
    var WLAN_Band_Type v_Band := px_WLANBand;
    var WLAN_ChannelNumber_Type v_ChannelNumber := fl_GetWLANChannelNumber(v_Band);
    var template (value) WLAN_CellInfo_Type v_CellInfo := cs_WLAN_CellInfoDef(valueof(p_SimulatedAP.CellId), v_Band, v_ChannelNumber, valueof(p_SimulatedAP.SSID), valueof(p_SimulatedAP.BeaconRSSI)); //@sic R5-192359 sic@
    
    return valueof(v_CellInfo);
  }

  /*
   * @desc      Function to intialise WLAN Cell Info Array
   * @param     p_SimulatedAPs      (default value: cs_WLAN_SimulatedAPList_Def)
   * @return    WLAN_CellInfoArray_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellArray_Init(template (value) WLAN_APList_Type p_SimulatedAPs := cs_WLAN_SimulatedAPList_Def) return WLAN_CellInfoArray_Type
  { // @sic R5w200302 @sic extended function to initialise more WLAN APs
    
    var integer v_Index;
    var WLAN_CellInfoArray_Type v_WLAN_Cells;
    var integer v_CellIdCounter := 0;
    
      
    while (v_CellIdCounter < lengthof(p_SimulatedAPs))
    {
      v_Index := f_WLAN_CellInfo_GetIndex(valueof(p_SimulatedAPs[v_CellIdCounter].CellId));
      v_WLAN_Cells[v_Index] := f_WLAN_CellInfo_Init(p_SimulatedAPs[v_CellIdCounter]);
      v_CellIdCounter := v_CellIdCounter + 1;
    }
    
    return v_WLAN_Cells;
  }

}
