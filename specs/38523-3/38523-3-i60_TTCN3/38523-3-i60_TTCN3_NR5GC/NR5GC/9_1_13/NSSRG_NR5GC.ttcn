module NSSRG_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;

  template (present) NG_GMM_Cap cdr_NG_GMM_Cap_NSSRG modifies cr_NG_GMM_CapAny :=
  { /* @status    APPROVED (NR5GC) */
    nssrg       := '1'B
  };

  template (value) NSSRG_Value cs_NSSRG_1entry(template (value) S_NSSAI_LV p_SNSSAI,
                                         O1_Type p_NssrgValue_1) :=
  { /* @status    APPROVED (NR5GC) */
    // 24.501 cl. 9.11.3.82
    iel         := '03'O,//@sic R5s230696 sic@
    sNSSAI      := p_SNSSAI,
    nssrgValues := {p_NssrgValue_1}
  };

  template (value) NSSRG_Value cs_NSSRG_2entry(template (value) S_NSSAI_LV p_SNSSAI,
                                               O1_Type p_NssrgValue_1,
                                               O1_Type p_NssrgValue_2) :=
  { /* @status    APPROVED (NR5GC) */
    // 24.501 cl. 9.11.3.82
    iel         := '04'O,//@sic R5s230696 sic@
    sNSSAI      := p_SNSSAI,
    nssrgValues := {p_NssrgValue_1,p_NssrgValue_2}
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.13.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_13_1_NR5GC() runs on NR5GC_PTC
  {
    //NSSRG / Initial registration
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_1, NG_AllCellsOnSamePLMN);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);
    
    f_NR_TestBody_Set(true);
    fl_TC_9_1_13_1_Body();
    f_NR_TestBody_Set(false);
       
    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_13_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_13_1_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), {bit2oct(v_TAC)});
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), v_GutiParams);
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;

    var template (value) NSSAI v_AllowedNSSAI:= cs_NSSAI_Def('15'O,{cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '03'O, omit)});
    var template (value) NSSAI v_ConfiguredNSSAI := cs_NSSAI_Def('31'O,{cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '03'O, omit)});
    var template (value) NSSAI v_RequestedNSSAI:=  cs_NSSAI_Def('2F'O,{cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '03'O, omit)}); //@sic R5s230696 sic@

    var template (value) NSSRG_Info v_NSSRG_Info :={  //@sic R5s230696 sic@
      iei := '70'O,
      iel := '000E'O,
      valueList := {
      cs_NSSRG_1entry(cs_S_NSSAI('01'O, '01'O, omit), '01'O),
      cs_NSSRG_2entry(cs_S_NSSAI('01'O, '02'O, omit), '02'O, '03'O), //cs_NSSRG_2entries corrected to cs_NSSRG_2entry.
      cs_NSSRG_2entry(cs_S_NSSAI('01'O, '03'O, omit), '02'O, '04'O)//cs_NSSRG_3entries corrected to cs_NSSRG_2entry.
      }};

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();
    
    //@siclog "Steps 2-4" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    
    //@siclog "Step 5" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including NSSRG bit?
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,-,-,-,-,cdr_NG_GMM_Cap_NSSRG)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    }

    //@siclog "Step 6-14" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                TESTMode_OFF);
    
    //@siclog "Step 15" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Configured NSSAI with NSSRG information included.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI, -, v_ConfiguredNSSAI,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   v_NSSRG_Info);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    
    //@siclog "Step 16-21a1" siclog@
    // Steps 15 to 20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1
    f_NR5GC_RRC_Idle_Steps15_20 (v_NGC_NASCellA, TESTMode_OFF);
    
    //@siclog "Step 22" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.1-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellA, STATE_IDLE_1A);

    //@siclog "Step 23" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Steps 24-26" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);

    //@siclog "Step 27" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message with requested NSSAI which are associated with common NSSRG value?
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,-,-,-,-,-,-,v_RequestedNSSAI)) {
     f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 27");

    //@siclog "Step 28-43a1" siclog@
    //Steps 5-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed on NGC Cell A.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity);
 
    }
   }  //End of fl_TC_9_1_13_1_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.13.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_13_2_NR5GC() runs on NR5GC_PTC
  {
    //NSSRG / Initial registration
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_1, NG_AllCellsOnSamePLMN);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);
    
    f_NR_TestBody_Set(true);
    fl_TC_9_1_13_2_Body();
    f_NR_TestBody_Set(false);
       
    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_13_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_13_2_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), {bit2oct(v_TAC)});
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), v_GutiParams);
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NSSAI v_AllowedNSSAI;
    var template (value) NSSAI v_ConfiguredNSSAI;
    var template (value) NSSRG_Info v_NSSRG_Info;
    var template (value) NSSAI v_RequestedNSSAI;

    v_AllowedNSSAI:= cs_NSSAI_Def('15'O,{cs_S_NSSAI('01'O, '02'O, omit)});
    v_ConfiguredNSSAI := cs_NSSAI_Def('31'O,{cs_S_NSSAI('01'O, '02'O, omit)});

    v_NSSRG_Info :={
      iei := '70'O,
      iel := '000E'O, //@sic R5s240127 sic@
      valueList := {
      cs_NSSRG_1entry(cs_S_NSSAI('01'O, '01'O, omit), '01'O),
      cs_NSSRG_2entry(cs_S_NSSAI('01'O, '02'O, omit), '02'O, '03'O), //cs_NSSRG_2entries corrected to cs_NSSRG_2entry.
      cs_NSSRG_2entry(cs_S_NSSAI('01'O, '03'O, omit), '02'O, '04'O)//cs_NSSRG_3entries corrected to cs_NSSRG_2entry.
      }};

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();
    
    //@siclog "Steps 2-3" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    
    //@siclog "Step 4" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including NSSRG bit?
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,-,-,-,-,cdr_NG_GMM_Cap_NSSRG)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    }

    //@siclog "Step 5-13" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                TESTMode_OFF);
    
    //@siclog "Step 14" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Configured NSSAI with NSSRG information included.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI, -, v_ConfiguredNSSAI,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   v_NSSRG_Info);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 15-19a1" siclog@
    // Steps 15 to 19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1
    f_NR5GC_RRC_Idle_Steps15_20 (v_NGC_NASCellA, TESTMode_OFF, noRrcConnectionRelease);
    
    //@siclog "Step 20" siclog@
    v_AllowedNSSAI:= {
      iei := '15'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '04'O, omit), cs_S_NSSAI('01'O, '05'O, omit)}
      }};

    v_NSSRG_Info :={
      iei := '70'O,
      iel := '0006'O, //@sic R5s240127 sic@
      valueList := {
      cs_NSSRG_1entry(cs_S_NSSAI('01'O, '04'O, omit), '01'O)
      }};

    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB2, -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_NG_CONFIGURATION_UPDATE_COMMAND(cs_ConfigUpdateInd('1'B, '1'B), -, -, v_AllowedNSSAI,-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, v_NSSRG_Info))));

    // @siclog "Step 21" siclog@
    //Check: Does UE transmit CONFIGURATION UPDATE COMPLETE?
    SRB.receive (car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                                      cr_NG_CONFIGURATION_UPDATE_COMPLETE)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21");

    //@siclog "Step 22" siclog@
    //Switch off procedure in RRC_CONNECTED specified in TS 38.508-1 subclause 4.9.6.3 is performed.
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellA, STATE_CONNECTED_3A);

    //@siclog "Step 23" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Steps 24-25" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    
    //@siclog "Step 26" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message?
    v_RequestedNSSAI := cs_NSSAI_Def('2F'O,{cs_S_NSSAI('01'O, '04'O, omit)});
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, v_RequestedNSSAI)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 26");
    }

    //@siclog "Step 27-41a1" siclog@
    //Steps 5-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed on NGC Cell A.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity);

  } //End of fl_TC_9_1_13_2_Body

}
