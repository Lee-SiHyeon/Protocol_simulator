  template (value) EUTRAN_Descr cs_EUTRAN_Descr(B16_Type p_Earfcn,
                                                B1_Type p_BwMask,
                                                template (omit) B3_Type p_MeasBW,
                                                B1_Type p_NaMask,
                                                template (omit) PCIDGroup p_NotAllowed,
