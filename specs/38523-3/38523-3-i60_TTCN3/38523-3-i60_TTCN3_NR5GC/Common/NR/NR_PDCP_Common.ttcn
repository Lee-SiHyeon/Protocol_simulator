module NR_PDCP_Common {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from L2_Common4G5G all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_L2_Common all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_Templates all;

  const B3_Type tsc_NR_PDU_Type_StatusRep := '000'B;      /* @status    APPROVED (ENDC, NR5GC) */

  type record NR_PDCP_SS_State_Type {              /* @status    APPROVED (ENDC, NR5GC)  * PDCP state variables, see 38.323 cl. 7.1 */
    NR_PDCP_SN_Size_Type       PDCP_SN_Size,       /* UL PDCP SDU size */
    integer                    TX_NEXT,            /* This state variable indicates the COUNT value of the next PDCP SDU */
    integer                    RX_NEXT,            /* This state variable indicates the COUNT value of the next PDCP SDU expected to be received */
    integer                    Maximum_PDCP_SN,    /* This state variable indicates  maximum value of the COUNT */
    DRB_Identity               DRB_Id,             /* Data Radio Bearer*/
    B128_Key_Type              KUPenc             /* This state variable indicates ciphering key for the user plane */
 };

  template (value) PDCP_Config cs_38508_NR_PDCP_Config(template (omit) NR_PDCP_DRB_Type p_DRB := omit,
                                                       template (omit) NR_MoreThanOneRLC_Type p_MoreThanOneRLC := omit,
                                                       template (omit) NR_PDCP_T_Reordering_Type p_T_Reordering := omit,
                                                       template (omit) NR_PDCP_CipheringDisabled_Type p_CipheringDisabled := omit):=
   /* @status    APPROVED (ENDC, NR5GC) */
   //As per 38.508-1 Table 4.6.3-99: PDCP-Config
   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
   cs_PDCP_Config_Def(p_DRB, p_MoreThanOneRLC, p_T_Reordering, p_CipheringDisabled);

  template (value) PDCP_Config cs_NR_PDCP_Config_UlPath(NR_PDCP_DiscardTimer_Type p_DiscardTimer,
                                                        NR_PDCP_SN_UL_Type p_SN_UL,
                                                        NR_PDCP_SN_DL_Type p_SN_DL,
                                                        CellGroupId p_CellGroup := tsc_NR_CellGroupId_SCG,
                                                        UL_DataSplitThreshold p_UlDataSplitThreshold := infinity_,
                                                        template (omit) NR_PDCP_CipheringDisabled_Type p_CipheringDisabled := omit, //@sic R5s200701 sic@
                                                        boolean p_Pdcp_Duplication := false,
                                                        DRB_Identity p_DRB_default := tsc_NR_DRB2) := //@sic R5s210888 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_38508_NR_PDCP_Config (cs_38508_PDCP_Config_DRB(p_DiscardTimer, p_SN_UL, p_SN_DL),
                             cs_NR_PDCP_MoreThanOneRLC(cs_NR_PDCP_PrimaryPath(p_CellGroup, f_NR_LogicalChannelId_DRB(p_DRB_default)), p_UlDataSplitThreshold, p_Pdcp_Duplication),
                             -,
                             p_CipheringDisabled);

  template (present) NR_PDCP_PDU_Type cr_NR_PDCP_STATUS_REPORT (integer p_PDCP_FMC, template octetstring p_Bitmap:= omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    CtrlPduStatus := {
      D_C                := tsc_NR_PDCP_D_C_Ctrl,
      PDU_Type           := tsc_NR_PDU_Type_StatusRep,
      Reserved           := tsc_B4_Reserved,
      FirstMissingCount  := int2bit(p_PDCP_FMC, 32),
      Bitmap             := p_Bitmap
    }
  };

 template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_NotAcK :=
  { /* @status    APPROVED (ENDC, NR5GC) */
   Info:={
         NotACK_NextRLC_PDU := Start
    }
  };

  template (value) NR_PDCP_PDU_Type cs_NR_PDCP_STATUS_REPORT (integer p_PDCP_FMC) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    CtrlPduStatus := {
      D_C                := tsc_NR_PDCP_D_C_Ctrl,
      PDU_Type           := tsc_NR_PDU_Type_StatusRep,
      Reserved           := tsc_B4_Reserved,
      FirstMissingCount  := int2bit(p_PDCP_FMC, 32),
      Bitmap             := omit
    }
  };

}
