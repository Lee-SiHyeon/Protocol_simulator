                                                                          p_CellList[v_Index_Cell8].cellInfo_Specific_FDD.priScrmCode);

    v_CellList[v_Index_Cell7].sysInfo.SIB11 := cs_SIB11_5Intra_3Inter_FDD(7,
                                                                          p_CellList[v_Index_Cell7].cellInfo_Specific_FDD.priScrmCode,
