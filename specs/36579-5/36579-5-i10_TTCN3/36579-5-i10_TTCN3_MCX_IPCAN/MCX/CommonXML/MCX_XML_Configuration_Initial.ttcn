module MCX_XML_Configuration_Initial {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from XSD all;
  import from urn_3gpp_mcptt_mcpttUEinitConfig_1_0 language "XSD" all;  

  type urn_3gpp_mcptt_mcpttUEinitConfig_1_0.Mcptt_UE_initial_configuration MCPTT_UE_InitialConfiguration_Type;                  /* @status    APPROVED (MCX) */

  type urn_3gpp_mcptt_mcpttUEinitConfig_1_0.On_networkType                 MCPTT_UE_InitialConfiguration_OnNetwork_Type;        /* @status    APPROVED (MCX) */

  type urn_3gpp_mcptt_mcpttUEinitConfig_1_0.Off_networkType                MCPTT_UE_InitialConfiguration_OffNetwork_Type;       /* @status    APPROVED (MCX) */

  type urn_3gpp_mcptt_mcpttUEinitConfig_1_0.ServiceType                    MCPTT_UE_InitialConfiguration_Service_Type;          /* @status    APPROVED (MCX) */

  template (value) MCPTT_UE_InitialConfiguration_Service_Type cs_MCPTT_UE_InitialConfiguration_Service(charstring p_AccessPointName := px_MCX_APN) :=
  { /* @status    APPROVED (MCX) */
    mCPTT_to_con_ref := p_AccessPointName,
    mC_common_core_to_con_ref := p_AccessPointName,
    mC_ID_to_con_ref := p_AccessPointName,
    anyExt := omit,
    elem_list := {}
  };

  template (value) MCPTT_UE_InitialConfiguration_OnNetwork_Type cs_MCPTT_UE_InitialConfiguration_OnNetwork(charstring p_PLMN) :=
  { /* @status    APPROVED (MCX) */
    index := omit,
    attr := omit,
    timers := {
      t100 := 2,
      t101 := 2,
      t103 := 5,
      t104 := 2,
      t132 := 3,
      anyExt := omit,
      elem_list := {}
    },
    hPLMN := {                          // @sic R5s201409 BASELINE MOVING 2020 hPLM -> hPLMN sic@
      pLMN := p_PLMN,
      service := cs_MCPTT_UE_InitialConfiguration_Service,
      vPLMN_list := {},                 // @sic R5s201409: BASELINE MOVING 2020 vPLM -> vPLMN sic@  @sic R5-217985: no VPLMN sic@
      anyExt := omit,                   // @sic R5s221241: BASELINE MOVING 2022 09: new field sic@
      elem_list := {}                   // @sic R5s221241: BASELINE MOVING 2022 09: new field sic@
    },
    app_Server_Info := {
      idms_auth_endpoint  := f_MCX_AbsoluteServerURI(-, px_MCX_IdMS_auth_IPAddress,  px_MCX_IdMS_auth_Port,  tsc_MCX_IdMS_auth_UriPath),   // @sic R5-200385 sic@
      idms_token_endpoint := f_MCX_AbsoluteServerURI(-, px_MCX_IdMS_token_IPAddress, px_MCX_IdMS_token_Port, tsc_MCX_IdMS_token_UriPath),  // @sic R5-200385 sic@
      http_proxy := f_MCX_AbsoluteServerURI(-, px_MCX_HTTP_Proxy_IPAddress, px_MCX_HTTP_Proxy_Port),
      gms := tsc_MCX_GMS_Hostname,      // @sic R5-200385 sic@
      cms := tsc_MCX_CMS_Hostname,      // @sic R5-200385 sic@
      kms := tsc_MCX_KMS_Hostname,      // @sic R5-200385 sic@
      tls_tunnel_auth_method := {
        mutual_authentication := false,
        x509 := omit,
        key := omit,
        anyExt := omit,
        elem_list := {}
      },
      anyExt := omit,
      elem_list := {}
    },
    gMS_URI := tsc_MCX_GMSURI,
    group_creation_XUI := px_MCX_GroupCreationXUI,
    gMS_XCAP_root_URI := tsc_MCX_GMSXCAPRootURI,
    cMS_XCAP_root_URI := tsc_MCX_CMSXCAPRootURI,
    integrity_protection_enabled := tsc_MCX_XML_IntegrityProtection,
    confidentiality_protection_enabled := tsc_MCX_XML_ConfidentialityProtection,
    anyExt := omit,
    elem_list := {}
  };

  template (value) MCPTT_UE_InitialConfiguration_OffNetwork_Type cs_MCPTT_UE_InitialConfiguration_OffNetwork :=
  { /* @status    APPROVED (MCX) */
    index := omit,
    attr := omit,
    timers := {
      tFG1 := 150,
      tFG2 := 2000,
      tFG3 := 40,
      tFG4 := 20,
      tFG5 := 2,
      tFG11 := 3000,
      tFG12 := 3000,
      tFG13 := 1,
      tFG14 := 1,
      tFP1 := 2000,
      tFP2 := 50,
      tFP3 := 2000,
      tFP4 := 5000,
      tFP5 := 30,
      tFP6 := 3000,
      tFP7 := 6,
      tFB1 := 300,
      tFB2 := 10,
      tFB3 := 20,
      t201 := 1000,
      t203 := 5,
      t204 := 5,
      t205 := 1,
      t230 := 10,
      t233 := 10,
      tFE1 := 30,
      tFE2 := 10,
      anyExt := omit,
      elem_list := {}
    },
    counters := {
      cFP1 := 3,
      cFP3 := 5,
      cFP4 := 2,
      cFP6 := 2,
      cFG11 := 2,
      cFG12 := 2,
      c201 := 3,
      c204 := 2,
      c205 := 4,
      anyExt := omit,
      elem_list := {}
    },
    anyExt := omit,
    elem_list := {}
  };

  template (value) MCPTT_UE_InitialConfiguration_Type cs_MCPTT_UE_InitialConfiguration(template (value) MCPTT_UE_InitialConfiguration_OnNetwork_Type p_InitialConfiguration_OnNetwork) :=
  { /* Table 5.5.8.1-1
       @status    APPROVED (MCX) */
    instance_ID_URN := omit,
    xUI_URI := omit,
    domain := px_MCX_DomainName_Organization_A,   // @sic R5-200385 sic@
    attr := omit,
    choice_list := {
      { on_network := p_InitialConfiguration_OnNetwork },
      { off_network := cs_MCPTT_UE_InitialConfiguration_OffNetwork }
    }
  };

  template (value) Service_DetailsType cs_Service_Details(XSD.AnyURI p_ServerURI) :=
  { /* @status    APPROVED (MCX) */
    iPv6_Required := false,
    server_URI := p_ServerURI,
    anyExt := omit
  };

  /*
   * @desc      Build up and encode initial configuration document according to 36.579-1 Table 5.5.8.1-1
   * @param     p_PLMN              (default value: tsc_MCX_PLMN)
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_Encode_UEInitialConfiguration(charstring p_PLMN := tsc_MCX_PLMN) return bitstring
  {
    var template (value) MCPTT_UE_InitialConfiguration_OnNetwork_Type v_InitialConfiguration_OnNetwork := cs_MCPTT_UE_InitialConfiguration_OnNetwork(p_PLMN);
    var template (value) MCPTT_Service_Details v_MCPTT_Service_Details := cs_Service_Details(tsc_MCPTT_PublicServiceId_A);
    var template (value) MCVideo_Service_Details v_MCVideo_Service_Details := cs_Service_Details(tsc_MCVideo_PublicServiceId_A);
    var template (value) MCData_Service_Details v_MCData_Service_Details := cs_Service_Details(tsc_MCData_PublicServiceId_A);
    var template (value) urn_3gpp_mcptt_mcpttUEinitConfig_1_0.Mcptt_UE_initial_configuration v_UEInitialConfiguration;

    v_InitialConfiguration_OnNetwork.anyExt.elem_list := {  // @sic R5-220478 sic@
      f_Bit2XsdString(encvalue(v_MCPTT_Service_Details)),
      f_Bit2XsdString(encvalue(v_MCVideo_Service_Details)),
      f_Bit2XsdString(encvalue(v_MCData_Service_Details))
    };
    v_UEInitialConfiguration := cs_MCPTT_UE_InitialConfiguration(v_InitialConfiguration_OnNetwork);

    return encvalue(v_UEInitialConfiguration);
  }

}
