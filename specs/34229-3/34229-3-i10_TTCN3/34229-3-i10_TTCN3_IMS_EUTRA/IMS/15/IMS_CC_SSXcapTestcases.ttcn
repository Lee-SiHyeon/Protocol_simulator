  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED);
    f_IMS_XCAP_OIP();
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);   /* @sic R5s141051 change 10 sic@ */
  }

