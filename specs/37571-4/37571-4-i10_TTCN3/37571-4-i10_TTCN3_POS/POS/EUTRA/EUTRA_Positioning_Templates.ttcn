module EUTRA_Positioning_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from CommonDefs all;
  import from EPS_NAS_Constants all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;

  const bitstring tsc_LCS_MessageContainer := '00000010'B; /* @status    APPROVED (POS) */

  const bitstring tsc_LPP_MessageContainer := '00000001'B; /* @status    APPROVED (POS) */

  template (value) NAS_DL_Message_Type cs_EUTRA_RESETUEPOSITIONINGSTOREDINFORMATION(B8_Type p_UePosTech) :=
  { /* 24.301 cl. 8.2.31 */
    /* @status    APPROVED (POS) */
    rESETUEPOSITIONINGSTOREDINFORMATION := {
      skipIndicator := '0000'B,                // "0000" skip indicator BITSTRING [4]
      protocolDiscriminator := '1111'B,        // M, "1111" Protocol discriminator for test procedure messages BITSTRING [4]
      msgType := '10001000'B,                  // M, "10001000" message type BITSTRING [8]
      uePositioningTech := p_UePosTech         // M
    }
  };

  template (value) NAS_DL_Message_Type cs_DL_GENERIC_NAS_TRANSPORT(GenericMessageContainerType p_MessageContainerType,
                                                                   template (value) GenericMessageContainer p_MessageContainer,
                                                                   template (omit) AdditionalInformation p_AddInfo) :=
  { /* 24.301 cl. 8.2.31 */
    /* @status    APPROVED (POS) */
    dl_GENERIC_NAS_TRANSPORT := {
      securityHeaderType          := tsc_SHT_NoSecurityProtection,
      protocolDiscriminator       := tsc_PD_EMM,   //@sic R5s130145 sic@
      messageType                 := tsc_MT_DL_GenericNASTransport,
      genericMessageContainerType := p_MessageContainerType,
      genericMessageContainer     := p_MessageContainer,
      additionalInformation       := p_AddInfo
    }
  };

  template (value) GenericMessageContainer cs_GenericMsgContainer (octetstring p_GenericMsgContainerValue):=
  { /* @status    APPROVED (POS) */
    /* 24.301 cl. 9.9.3.43 M LV-E 3-n @sic R5s110176 Baseline Moving sic@ */
    iei  := omit,  // Set to omit because in the type definition for DL_GENERIC_NAS_TRANSPORT is defined as LV
    iel  := int2oct (lengthof (p_GenericMsgContainerValue), 2),    //Type6Length_Type = octetstring of length 2
    genericMsgContainerValue := p_GenericMsgContainerValue         // octetstring
  };

  template (present) NAS_UL_Message_Type cr_UL_GENERIC_NAS_TRANSPORT(GenericMessageContainerType p_MessageContainerType,
                                                                     template (omit) AdditionalInformation p_AddInfo) :=
  { /* 24.301 cl. 8.2.32 */
    /* @status    APPROVED (POS) */
    ul_GENERIC_NAS_TRANSPORT := {
      securityHeaderType          := tsc_SHT_NoSecurityProtection,
      protocolDiscriminator       := tsc_PD_EMM, //@sic R5s130145 sic@
      messageType                 := tsc_MT_UL_GenericNASTransport,
      genericMessageContainerType := p_MessageContainerType,
      genericMessageContainer     := {
        iei := omit, //@sic R5s130145 sic@
        iel := ?,
        genericMsgContainerValue :=?
      },
      additionalInformation       := p_AddInfo
    }
  };

  template (present) Invoke cr_InvokeLCS_MOLR_EUTRA_Any :=
  { /* @status    APPROVED (POS) */
    invokeID := ?,
    linkedID := *,
    operationCode :=  {
      local := 115  // for lcs-MOLR
    },
    parameter := {
      lcs_MOLR := {
        molr_Type := ?,
        locationMethod := omit,
        lcs_QoS := *,
        lcsClientExternalID := *,
        mlc_Number := *,
        gpsAssistanceData := omit,
        supportedGADShapes := *,
        lcsServiceTypeID := *,
        ageOfLocationInfo := *,
        locationType := *,
        pseudonymIndicator := *,
        h_gmlc_address := omit,
        locationEstimate := omit,
        velocityEstimate := omit,
        referenceNumber := omit,
        periodicLDRInfo := omit,
        locationUpdateRequest := omit,
        sequenceNumber := omit,
        terminationCause := omit,
        mo_lrShortCircuit := omit,
        ganssAssistanceData := omit,
        multiplePositioningProtocolPDUs := *,
        locationInfo := *, // @sic R5s170598 Baseline Moving sic@
        scheduledLocTime := * // @sic R5s221182 Baseline Moving sic@
      }
    }
  };

  template (present) Invoke cdr_InvokeLocationEstimateEUTRA modifies cr_InvokeLCS_MOLR_EUTRA_Any :=
  { /* @status    APPROVED (POS) */
    parameter := {
      lcs_MOLR := {
        molr_Type := locationEstimate
      }
    }
  };

}
