module MTC_Component_IMS_NR5GC {

  import from CommonDefs all;
  import from IMS_CC_Component all;
  import from IMS_Component all;
  import from IPCAN_NR5GC all;
  import from MTC_Base all;
  import from MTC_Component_IMS_Common all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NasEmu5G_Component_NRNG all;
  import from NasEmu5G_Component_NR_BASE all;
  import from NasEmu5G_Main_NRNG all;
  import from UpperTesterSystemCmds all;

  type component SYSTEM_IMS extends NR_BASE_SYSTEM, NASEMU_NR_SYSTEM, SYSTEM_IMS_BASE {};    /* @status    APPROVED (IMS) */

  /*
   * @desc      Create parallel test components and connect all MTC ports to the system ports
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @param     p_UseDNS            (default value: false)
   * @param     p_UseXCAP           (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_CreateMapAndConnectPTCs_NR5GC(SYSTEM_IMS p_System,
                                                   IMS_PTC p_IMS1,
                                                   IMS_PTC p_IMS2,
                                                   boolean p_UseDNS := false,
                                                   boolean p_UseXCAP := false) runs on MTC_IMS
  {
    var NR5GC_PTC v_NR5GC;
    var NASEMU_NRNG_PTC v_NASEMU_PTC;

    f_MTC_IMS_InitAndConnect_IP_IMS(p_System, p_IMS1, p_IMS2, p_UseDNS, p_UseXCAP);

    v_NR5GC := NR5GC_PTC.create("NR5GC") alive;                             // @sic R5s201263, R5s210297 sic@  @sic R5s210270 sic@
    f_NR_BASE_PTC_Map(p_System, v_NR5GC);                                   // map NR5GC system ports
    v_NASEMU_PTC := f_NasEmu5G_CreateConnectAndMap_NRNG(p_System, v_NR5GC); // create NasEmu, map system ports and connect with NR5GC PTC
    v_NASEMU_PTC.start(f_NASEMU_MainLoop_NRNG());                           // start NASEMU
    
    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_NR], v_NR5GC:UT);
    connect(v_NR5GC:IP, vc_Components.IP:NR_CTRL);
    if (p_IMS1 != null) { connect(vc_Components.IMS1:IPCAN, v_NR5GC:IMS[tsc_Index_IMS1]); }
    if (p_IMS2 != null) { connect(vc_Components.IMS2:IPCAN, v_NR5GC:IMS[tsc_Index_IMS2]); }

    f_UT_InitialPowerOffUE(Ut);

    v_NR5GC.start(f_NR5GC_IPCAN_MainLoop());
  }

  /*
   * @desc      Extension for XCAP test cases
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_XCAP_CreateMapAndConnectPTCs_NR5GC(SYSTEM_IMS p_System,
                                                        IMS_XCAP_PTC p_IMS1,
                                                        IMS_XCAP_PTC p_IMS2) runs on MTC_IMS
  {
    var boolean v_UseXCAP := true;
    var boolean v_UseDNS := true;
    f_MTC_IMS_CreateMapAndConnectPTCs_NR5GC(p_System, p_IMS1, p_IMS2, v_UseDNS, v_UseXCAP);
    f_MTC_IMS_CreateMapConnectAndStartHTTP(p_System, p_IMS1);
  }

}
