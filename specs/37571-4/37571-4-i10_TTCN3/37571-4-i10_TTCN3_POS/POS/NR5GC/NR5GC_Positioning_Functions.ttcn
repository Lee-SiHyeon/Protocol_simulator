      if ((ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].supportedDL_PRS_ProcessingSamples_RRC_CONNECTED_r17) == pc_supportedDL_PRS_ProcessingSamples_RRC_CONNECTED)) { //@sic R5-235341, R5s230755 sic@
        v_Found_SupportedDL_PRS_ProcessingSamples_RRC_CONNECTED := true;
      }
      if ((ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].prs_ProcessingWindowType1A_r17)) == pc_prs_ProcessingWindowType1A) { //@sic R5-235341, R5s230755 sic@
        v_Found_Prs_ProcessingWindowType1A := true;
      }
      if ((ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].prs_ProcessingWindowType1B_r17)) == pc_prs_ProcessingWindowType1B) { //@sic R5-235341, R5s230755 sic@
        v_Found_Prs_ProcessingWindowType1B := true;
      }
      if ((ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].prs_ProcessingWindowType2_r17)) == pc_prs_ProcessingWindowType2) { //@sic R5-235341, R5s230755 sic@
        v_Found_Prs_ProcessingWindowType2 := true;
      }
      if (ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].prs_ProcessingCapabilityOutsideMGinPPW_r17)) {
