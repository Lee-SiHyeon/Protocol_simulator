module ECall_IRAT_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRCSteps all;
  import from IMS_PTC_CoordMsg all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Assign the parameterised eCallOverIMS_Support_r14 value in SIB1 of the cell
   * @param     p_CellId
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetSysInfo_EcallOverIMS(EUTRA_CellId_Type p_CellId)runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.eCallOverIMS_Support_r14:= true_;
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_1_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { /* eCall Only mode / T3444 / eCall inactivity procedure after an eCall over IMS / 5GS to EPS */

    f_EUTRA38_IRAT_Init(c31);  // E-UTRA Cell 1 as defined in TS 36.508 [7] Table 4.4.2-2. System information combination 31 as defined in TS 36.508 [7], sub-clause 4.4.3.1.1.

    // Create cell and send out system information
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    f_EUTRA_TestBody_Set(true);

    fl_TC_11_5_1_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    // take down the cell now
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  } //End of f_TC_11_5_1_NR5GC_EUTRA()

  /*
   * @desc      test body of TC_11_5_1_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_5_1_NR5GC_EUTRA_TestBody()runs on EUTRA_Multi5GS_PTC
  {
 
    // @siclog "Step 1" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Non-suitable "off" cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Cell Power"));

    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Cell Power");
    // @siclog "Step 51" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Serving cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Cell Power"));

    // @siclog "Step 52" siclog@
    // Check: Does the UE perform on the E-UTRA Cell 1 the TAU procedure for Inter-system change from N1 mode to S1 mode as described in TS 38.508-1 [4], Table 4.9.7.2.2-1?
    f_EUTRA38_TrackingAreaUpdateFromN1(eutra_Cell1, tsc_RRC_TI_Def, omit);// @sic R5-225362 sic@

    // @siclog "Step 53" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Non-suitable "off" cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);// @sic R5-225362 sic@
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Cell Power"));

    // @siclog "Step 54" siclog@
    // Check: Does the UE perform on the NR Cell 1 the Test procedure for UE Tracking area updating for Inter-system change from S1 mode to N1 mode as described in TS 38.508-1 [4], Table 4.9.9.2.2-1?
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell1,true);// @sic R5-225362 sic@

  } // End of fl_TC_11_5_1_NR5GC_EUTRA_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_2_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { /* eCall Only mode / T3445 / eCall inactivity procedure after a call to URI for test service / 5GS to EPS */

    f_EUTRA38_IRAT_Init(c31);  // E-UTRA Cell 1 as defined in TS 36.508 [7] Table 4.4.2-2. System information combination 31 as defined in TS 36.508 [7], sub-clause 4.4.3.1.1.

    // Create cell and send out system information
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    f_EUTRA_TestBody_Set(true);

    fl_TC_11_5_2_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    // take down the cell now
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  } //End of f_TC_11_5_2_NR5GC_EUTRA()

  /*
   * @desc      test body of TC_11_5_2_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_5_2_NR5GC_EUTRA_TestBody()runs on EUTRA_Multi5GS_PTC
  {

    // @siclog "Step 1" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Non-suitable "off" cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Cell Power"));

    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Cell Power");
    // @siclog "Step 59" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Serving cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);

    // @siclog "Step 60" siclog@
    // Check: Does the UE perform on the E-UTRA Cell 1 the TAU procedure for Inter-system change from N1 mode to S1 mode as described in TS 38.508-1 [4], Table 4.9.7.2.2-1?
    f_EUTRA38_TrackingAreaUpdateFromN1(eutra_Cell1, tsc_RRC_TI_Def, omit);// @sic R5s250392 sic@

    // @siclog "Step 61" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Non-suitable "off" cell".
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);// @sic R5s250392 sic@
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Cell Power"));

    // @siclog "Step 62" siclog@
    // Check: Does the UE perform on the NR Cell 1 the Test procedure for UE Tracking area updating for Inter-system change from S1 mode to N1 mode as described in TS 38.508-1 [4], Table 4.9.9.2.2-1?
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell1, true);// @sic R5s250392 sic@

  } // End of fl_TC_11_5_2_NR5GC_EUTRA_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_3_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //eCall Only mode / 5GS supports IMS voice over PS session / 5GS does not support emergency service / eCall over EPS / eCall failure if EPS and CS domain are not available
    //@sic R5s250075 sic@
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS);  // E-UTRA Cell 1 as defined in TS 36.508 [7] Table 4.4.2-2. System information combination 31 as defined in TS 36.508 [7], sub-clause 4.4.3.1.1. // @sic R5s240629 sic@
    f_EUTRA_CellInfo_SetSysInfo_EmergencySupport(eutra_Cell1,true_);
    f_EUTRA_CellInfo_SetSysInfo_EcallOverIMS(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    //The eCall capable UE is equipped with eCall only enabled USIM configured as per TS 38.508-1 [4] Table 6.4.1-24. // @sic R5s240629 sic@
    f_UT_USIM_Insert(UT, "configuration 24 specified in table 6.4.1-24 TS 38.508-1");

    f_EUTRA_TestBody_Set(true);

    fl_TC_11_5_3_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    // take down the cell now
    // take down the cell now
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  } //End of f_TC_11_5_3_NR5GC_EUTRA()

  /*
   * @desc      test body of TC_11_5_3_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_5_3_NR5GC_EUTRA_TestBody()runs on EUTRA_5GS_PTC
  {
    //var NAS_MSG_Indication_Type v_NAS_Ind;
    //@siclog "Step 1" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Suitable cell".
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR,"Change Power Level");
    f_EUTRA38_SetCellPower(eutra_Cell1, -91, -96);//@sic R5-235303 sic@

    // @siclog "Step 2" siclog@
    // The UE is Switched ON
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1); // @sic R5s240629 sic@

    // @siclog "Step 3" siclog@
    // Wait for 60s for the UE to enter 5GMM-DEREGISTERED.eCALL-INACTIVE state.
    f_Delay(60.0); // @sic R5s240629 sic@

    // @siclog "Step 4" siclog@
    //An automatic eCall is initiated. (Note 1)
    f_UT_InitiateECall(UT, AUTOMATIC); // @sic R5s240629 sic@

    // @siclog "Step 5" siclog@
    //Check: Does the UE sends an ATTACH REQUEST message with a PDN CONNECTIVITY REQUEST message to request PDN connectivity to the default PDN. EPS attach type = "combined EPS/IMSI attach"?
    //@siclog "Step 6-24" siclog@
    //Steps 7 to 25 of Generic Test Procedure for eCall over IMS establishment in EUTRA: eCall Only Support specified in clause 4.5A.27 of TS 36.508 [6] take place.
    f_EUTRA_508_IMSeCallOnly_Steps3_25(eutra_Cell1);  // @sic R5s240629 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");  // @sic R5s240629 sic@

    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2], "IMS Call Release Msgs Sent");  // @sic R5s240629 sic@

    // @siclog "Step 25" siclog@
    //Release eCall over IMS using the generic procedure described in TS 34.229-1 [35] subclause C.33
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1,
                                         '7'H); // Emergency default bearer hardcoded to 6 and dedicated bearer 7
    // @siclog "Step 26" siclog@
    //The SS releases the RRC connection.
    //Now release the rrcConnection as the IMS PTC would be releasing the eCall
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);
    //@siclog "Step 27" siclog@
    //The UE is Switched Off.
    f_EUTRA_UE_Detach_SwitchOffUe(eutra_Cell1, RRC_IDLE);
    //@siclog "Step 28" siclog@
    //The SS configures:- E-UTRA Cell 1 " Non-suitable "Off" cell"
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Change Power Level")); // @sic R5s240629 sic@
  } // End of fl_TC_11_5_3_NR5GC_EUTRA_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_4_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { /* eCall Only mode / 5GS supports IMS voice over PS session / 5GS supports emergency service / eCall over IMS is supported on 5GS / RACH failure in NR cell / eCall over EPS */
    //@sic R5s250225 sic@
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS);  // E-UTRA Cell 1 as defined in TS 36.508 [7] Table 4.4.2-2. System information combination 31 as defined in TS 36.508 [7], sub-clause 4.4.3.1.1.

    // Create cell and send out system information
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_TestBody_Set(true);

    fl_TC_11_5_4_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    // take down the cell now

    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
    f_EUTRA_Postamble(eutra_Cell1, E1_IDLE);  // @sic R5s250225 sic@
  } //End of f_TC_11_5_4_NR5GC_EUTRA()

  /*
   * @desc      test body of TC_11_5_4_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_5_4_NR5GC_EUTRA_TestBody()runs on EUTRA_5GS_PTC
  {
    // @siclog "Step 6" siclog@
    // The SS configures:
    // - E-UTRA Cell 1 as "Suitable cell".
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR,"Change Power Level");
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_SuitableCellRS_EPRE, tsc_SuitableCellRS_EPRE_FR2); //@sic  R5-241629 sic@
    f_EUTRA_ResetIPandIMS(eutra_Cell1); // @sic R5s250289: "reset" causes the IMS default handler to use the IPCAN port of EUTRA sic@

    //@siclog "Step 7 - 26" siclog@
    //Check: Does the UE sends an ATTACH REQUEST message with a PDN CONNECTIVITY REQUEST message to request PDN connectivity to the default PDN. EPS attach type = "combined EPS/IMSI attach"?
    //Steps 7 to 25 of Generic Test Procedure for eCall over IMS establishment in EUTRA: eCall Only Support specified in TS 36.508 subclause 4.5A.27 take place.
    f_EUTRA_508_IMSeCallOnly_Steps3_25(eutra_Cell1);  // @sic R5s250225 sic@
    f_EUTRA_PreliminaryPass (__FILE__, __LINE__, "Step 7");

    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2], "IMS Call Release Msgs Sent");  // @sic R5s250225 sic@
    // @siclog "Step 27" siclog@
    //Now release the rrcConnection as the IMS PTC would be releasing the eCall
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1,
                                         '7'H); // Emergency default bearer hardcoded to 6 and dedicated bearer 7
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);
  } // End of fl_TC_11_5_4_NR5GC_EUTRA_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.12.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_12_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { /* eCall Only mode / 5GS supports IMS voice over PS session / 5GS supports emergency service / eCall over IMS is not supported on 5GS / eCall over EPS */
    
    //@sic R5s250075 sic@
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS);  // E-UTRA Cell 1 as defined in TS 36.508 [7] Table 4.4.2-2. System information combination 31 as defined in TS 36.508 [7], sub-clause 4.4.3.1.1.
    //@sic R5s240599 sic@
    // Create cell and send out system information
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //The eCall capable UE is equipped with eCall only enabled USIM configured as per TS 38.508-1 [4] Table 6.4.1-24.
    f_UT_USIM_Insert(UT, "configuration 24 specified in table 6.4.1-24 TS 38.508-1");  //@sic R5s240599 sic@


    f_EUTRA_TestBody_Set(true);

    fl_TC_11_5_12_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    // Tell the NR to release the resources
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
    //Postamble on Eutra Cell
    f_EUTRA_Postamble (eutra_Cell1, E1_IDLE); //@sic R5s250251 sic@
  } //End of f_TC_11_5_12_NR5GC_EUTRA()

  /*
   * @desc      test body of TC_11_5_12_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_5_12_NR5GC_EUTRA_TestBody()runs on EUTRA_5GS_PTC
  { // @sic R5s240599 sic@
    var AbsoluteCellPower_Type v_AbsoluteCellPowerLevel_FR1 := -93;
    var AbsoluteCellPower_Type v_AbsoluteCellPowerLevel_FR2 := tsc_ServingCellRS_EPRE_FR2;

    // First switch cell back on // First switch cell back on
    f_EUTRA38_SetCellPower(eutra_Cell1, v_AbsoluteCellPowerLevel_FR1, v_AbsoluteCellPowerLevel_FR2);
      
    // @siclog "Step 1" siclog@
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1);

    // @siclog "Step 2" siclog@
    // Wait for 60s for the UE to enter 5GMM-DEREGISTERED.eCALL-INACTIVE state
    f_Delay(60.0);

    // @siclog "Step 3" siclog@
    // Note 1: The request to originate an automatic eCall may be performed by MMI or AT command.
    f_UT_InitiateECall(UT, AUTOMATIC);


    // @siclog "Steps 4 - 23" siclog@
    f_EUTRA_508_IMSeCallOnly_Steps3_25(eutra_Cell1);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    //IMS call has been established, wait for trigger from IMS PTC to release rrc connection
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2], "IMS Call Release Msgs Sent");

    // @siclog "Step 25" siclog@
    //Now release the rrcConnection as the IMS PTC would be releasing the eCall
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1,
                                         '7'H); // Emergency default bearer hardcoded to 6 and dedicated bearer 7
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);
  } // End of fl_TC_11_5_12_NR5GC_EUTRA_TestBody()

}
