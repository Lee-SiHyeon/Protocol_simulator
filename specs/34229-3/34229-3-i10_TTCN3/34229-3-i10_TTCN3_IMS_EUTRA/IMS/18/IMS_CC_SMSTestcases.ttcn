module IMS_CC_SMSTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_18 all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause 18.1
   * @status    APPROVED (IMS)
   */
  function f_TC_18_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);     /* @sic R5s140469: test case applicable for GIBA as well sic@ */
    f_IMS_MobileOriginatingSMS();                                /* @sic R5-183107: Addition of IMS test cases J.18.1 and J.18.2 sic@ */
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 18.2
   * @status    APPROVED (IMS)
   */
  function f_TC_18_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED, IMS_Security);
    f_IMS_MobileTerminatingSMS();                               /* @sic R5-183107: Addition of IMS test cases J.18.1 and J.18.2 sic@ */
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

}
