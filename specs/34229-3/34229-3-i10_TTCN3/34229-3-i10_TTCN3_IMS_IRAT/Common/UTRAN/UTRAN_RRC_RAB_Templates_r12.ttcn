  template (value) UL_CommonTransChInfo_r12 cs_UL_CommTrChInfoDCH_PS_64k_FDD_r12 := cs_UL_CommTrChInfoDCCH_Common_FDD_r12(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx_r12(cs_PowerOffsetInfoHigher64k)); /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */

