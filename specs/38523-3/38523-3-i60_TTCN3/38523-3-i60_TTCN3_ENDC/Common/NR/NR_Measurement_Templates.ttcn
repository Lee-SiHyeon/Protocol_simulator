  /*
   * @desc      Function to generate measurement  quantity results configuration depending on the pc_ss_SINR_Meas
   * @return    template (present) MeasQuantityResults
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
    function f_NR_Get_MeasQuantityResults() return template (present) MeasQuantityResults
    {
        if(pc_ss_SINR_Meas)
        {
            return cr_NR_MeasQuantityResults_Any;
        }
        else
        {
            return cr_NR_MeasQuantityResults_RsrpRsrq;
        }
    }

}
