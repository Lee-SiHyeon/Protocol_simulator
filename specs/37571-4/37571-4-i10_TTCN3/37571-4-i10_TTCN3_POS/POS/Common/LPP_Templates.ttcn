  template (value) GNSS_NavModelSatelliteElement cs_GNSS_NavModelSatelliteElement_Gps(integer p_SatelliteID,
                                                                                      GNSS_NavModelSatelliteElement p_GNSS_NavModelSatelliteElement) :=
  { /* @status    APPROVED (POS) */
    svID := cs_SV_ID(p_SatelliteID),
    svHealth := p_GNSS_NavModelSatelliteElement.svHealth,
    iod := p_GNSS_NavModelSatelliteElement.iod,
    gnss_ClockModel := {
      nav_ClockModel := cs_NAV_ClockModel(p_GNSS_NavModelSatelliteElement.gnss_ClockModel.nav_ClockModel)
    },
    gnss_OrbitModel := {
