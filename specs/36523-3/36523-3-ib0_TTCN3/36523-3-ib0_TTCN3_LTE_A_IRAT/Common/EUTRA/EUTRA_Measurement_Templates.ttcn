  template (value) MeasObjectToAddMod_v9e0 cs_MeasObjectToAddMod_v9e0(template (value) ARFCN_ValueEUTRA_v9e0 p_ARFCN_ValueEUTRA_v9e0) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    measObjectEUTRA_v9e0 := {
      carrierFreq_v9e0 := p_ARFCN_ValueEUTRA_v9e0
    }
  };

  template (value) MeasObjectToAddMod_v9e0 cs_MeasObjectToAddMod_v9e0_Omit :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    measObjectEUTRA_v9e0 := omit
  };

  /*
   * @desc      This function return the EARFCN-v9e0 value to be used in MeasConfig
   * @param     p_ARFCN_ValueEUTRA1_r9
   * @param     p_ARFCN_ValueEUTRA2_r9
   * @return    template (omit) MeasObjectToAddModList_v9e0
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_ReturnMeasObjectToAddModList_2Entries_v9e0(template (omit) ARFCN_ValueEUTRA_r9 p_ARFCN_ValueEUTRA1_r9,
                                                        template (omit) ARFCN_ValueEUTRA_r9 p_ARFCN_ValueEUTRA2_r9) return template (omit) MeasObjectToAddModList_v9e0
  { //@sic R5-171150 sic@
    var template (omit) MeasObjectToAddModList_v9e0 v_MeasObjectToAddModList_v9e0 := omit;
    
    if (isvalue(f_EUTRA_ARFCN_Value_v9e0(p_ARFCN_ValueEUTRA1_r9)) or isvalue(f_EUTRA_ARFCN_Value_v9e0(p_ARFCN_ValueEUTRA2_r9))) { //i.e. at least one Bands > 64
      v_MeasObjectToAddModList_v9e0 := {fl_ReturnSingleMeasObjectToAddMod_OtherRATorBelowBand64(p_ARFCN_ValueEUTRA1_r9),
                                        fl_ReturnSingleMeasObjectToAddMod_OtherRATorBelowBand64(p_ARFCN_ValueEUTRA2_r9)};
    }
    return v_MeasObjectToAddModList_v9e0;
  }

  /*
   * @desc      Return the MeasObjectToAddMod-v9e0 as empty or with the ARFCN-v9e0 value if band>64
   * @param     p_ARFCN_ValueEUTRA_r9
   * @return    template (value) MeasObjectToAddMod_v9e0
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function fl_ReturnSingleMeasObjectToAddMod_OtherRATorBelowBand64(template (omit) ARFCN_ValueEUTRA_r9 p_ARFCN_ValueEUTRA_r9) return template (value) MeasObjectToAddMod_v9e0
  {
    var template (value) MeasObjectToAddMod_v9e0 v_ReturnListEntry := cs_MeasObjectToAddMod_v9e0_Omit;  //@sic R5s211525 sic@
    if (isvalue (p_ARFCN_ValueEUTRA_r9)) {
      if (isvalue(f_EUTRA_ARFCN_Value_v9e0(p_ARFCN_ValueEUTRA_r9))) {
        v_ReturnListEntry := cs_MeasObjectToAddMod_v9e0(valueof(p_ARFCN_ValueEUTRA_r9));
      }
    }
    return v_ReturnListEntry;
  }

}
