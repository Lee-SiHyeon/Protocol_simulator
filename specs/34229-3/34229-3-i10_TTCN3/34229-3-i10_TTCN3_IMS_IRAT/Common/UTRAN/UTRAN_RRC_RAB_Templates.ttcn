          }
        }
      }
    }
  };

  template (value) DL_HSPDSCH_Information_r8 cs_DL_HSPDSCH_Information_FDD ( template (value) HS_SCCH_Info_r7              p_HS_SCCH_Info,
                                                                             template (value) Measurement_Feedback_Info_r7 p_Measurement_Feedback_Info ) :=
