module RRC_Others_NR5GC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_NR_CoordMsg all;
  import from NR5GC_IRAT_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.5.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_5_5_1_NR5GC() runs on NR5GC_PTC
  { //Redirection to NR / From E-UTRA / Success
  
    f_NR5GC_IRAT_Init(NR_6); // System information combination NR-6, acc. to TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell

    f_EUTRA_NR_SendSysinfoCoOrd(EUTRA, f_NR5GC_IRAT_ListOfFrequencies());  // sends Freq. Info to the other RAT
   
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_IRAT_PreambleNR_EUTRA (nr_Cell1); // EUTRA cell on (NR cell off) and UE completed registration on EUTRA
    f_NR_SetCellPower (nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-202644, R5-237355 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_1_5_5_1_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
    // Tell EUTRA test is finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_5_5_1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_5_5_1_TestBody() runs on NR5GC_PTC
  {
    //@sic R5s200981 sic@
    
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Step 0"); //@sic R5-237355 sic@
    // @siclog "Step 0" siclog@
    f_NR_SetCellPower (nr_Cell1, -91, -91); //@sic R5-237355 sic@
    
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger("Step 1")); //@sic R5-237355 sic@
    // @siclog "Step 1" siclog@
    // Takes place in EUTRA PTC
    // @sic R5s201060 sic@
    
    //@siclog "Step 2" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.9 indicate that the UE has performed mobility registration updating when it camps on NR Cell 1?
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
  }

}
