  }

  /*
   * @desc      returns default media attributes for audio (rtpmap, fmtp, ptime, maxptime)
   * @param     p_Fmt
   * @param     p_AudioCodec        (default value: AMR_16000)
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AMR_AudioDef(charstring p_Fmt,
                                              IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000) return template (omit) SDP_attribute_list
  {
    var template (omit) SDP_attribute_list v_MediaAttributes := omit;
    
    select (p_AudioCodec) { // @sic R5s170327 sic@
      case (AMR_8000) {
        v_MediaAttributes := f_SDP_MediaAttributes_AudioDef(p_Fmt);   /* @sic R5-144693: new function f_SDP_MediaAttributes_AudioDef sic@ */
      }
      case (AMR_16000) {
        v_MediaAttributes := f_SDP_MediaAttributes_AMR_WB_AudioDef(p_Fmt);
      }
      case else {
        FatalError(__FILE__, __LINE__, "");
      }
    }
    return v_MediaAttributes;
  }

  /*
   * @desc      return media attributes for given list of codecs
   * @param     p_AudioCodecList
   * @param     p_SDP_AdditionalMediaAttributes (default value: cr_SDP_MediaAttributes_ptime_maxptime)
   * @return    template (present) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributesAudioCodecListRX(IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                                 template (present) SDP_attribute_list p_SDP_AdditionalMediaAttributes := cr_SDP_MediaAttributes_ptime_maxptime) return template (present) SDP_attribute_list
  { /* @sic R5-172930/R5-172931: new fucntion sic@ */
    var template (present) SDP_attribute_list v_MediaAttributes := {};
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodecInfo;
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters;
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var integer i;
    
    for (i:=0; i<lengthof(p_AudioCodecList); i:=i+1) {
      v_AudioCodec := p_AudioCodecList[i];
      v_RtpmapCodecInfo := f_SDP_AttributeRtpmapAudioRX(v_AudioCodec);
      v_FmtpParameters := f_SDP_FmtpDefaultParametersAudioCodecRX(v_AudioCodec);
      v_MediaAttributes := f_SDP_Attributes_Add_RX(v_MediaAttributes, cr_SDP_Attribute_rtpmap(-, v_RtpmapCodecInfo));
      v_MediaAttributes := f_SDP_Attributes_Add_RX(v_MediaAttributes, cr_SDP_Attribute_fmtp(-, v_FmtpParameters));
    }
    v_MediaAttributes := f_SDP_Attributes_Concat_RX(v_MediaAttributes, p_SDP_AdditionalMediaAttributes);
    return v_MediaAttributes;
  }

