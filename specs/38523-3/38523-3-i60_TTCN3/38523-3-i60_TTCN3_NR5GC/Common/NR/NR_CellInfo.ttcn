  /*
   * @desc      return the SI index including SIB4
   * @param     p_NR_SysinfoCombination
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB4_SI_Index (NR_SysinfoCombination_Type p_NR_SysinfoCombination) return integer
  { //@sic R5-223399, R5-243555 sic@
    var integer v_SIB4_SI_Index;
    select (p_NR_SysinfoCombination) {
        case (NR_4, NR_7, NR_14, NR_17, NR_23, NR_24, NR_30, NR_32, NR_35)    {   v_SIB4_SI_Index := 1; }
        case (NR_5)                 {   v_SIB4_SI_Index := 2; }
        case (NR_18)                {   v_SIB4_SI_Index := 0; }
        case else { FatalError(__FILE__, __LINE__, "Invalid System Combination"); }
    }
    return v_SIB4_SI_Index;
  }

  /*
   * @desc      Set RLF_TimersAndConstants from NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_RLF_TimersAndConstants
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetRLF_TimersAndConstants(NR_CellId_Type p_NR_CellId,
                                                    template (value) RLF_TimersAndConstants p_RLF_TimersAndConstants ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.RLF_TimersAndConstants := valueof(p_RLF_TimersAndConstants);
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set freqPriorityListSlicing-r17 value stored in SIB16 in the cell array
   * @param     p_NR_CellId
   * @param     p_FreqPriorityListSlicing_r17
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB16_FreqPriorityListSlicing_r17 (NR_CellId_Type p_NR_CellId,
                                                               template (value) FreqPriorityListSlicing_r17  p_FreqPriorityListSlicing_r17) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    select (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination) {
      case (NR_30) {
        //@sic R5s240053 sic@
        v_NR_CellInfo.Sysinfo.BcchInfo.SIs[2].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib16_v1700.freqPriorityListSlicing_r17 := valueof(p_FreqPriorityListSlicing_r17);
        f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
      }
    }
  }

  /*
   * @desc    Function returning true if teh sysinfo combination contains SIB19
   * @param     p_NR_SysinfoCombination
   * @return    boolean
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_IsSib19InSysinfoCombination(NR_SysinfoCombination_Type p_NR_SysinfoCombination) return boolean
  {
    var boolean v_IsSIB19 := false;

    select (p_NR_SysinfoCombination) {
      case (NR_29, NR_32, NR_35, NR_40) { v_IsSIB19 := true; }  /*@sic R5-253084, R5-261598 sic@*/
      case else { v_IsSIB19 := false; }
    }
    return v_IsSIB19;
  }

  /*
   * @desc      Set SIB19 in the cell
   * @param     p_NR_CellId
   * @param     p_Sib19
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_CellInfo_SetSIB19(NR_CellId_Type p_NR_CellId,
                                  template (value) SIB19_r17 p_Sib19) runs on NR_BASE_PTC
  {/*@sic R5s250100 Ch.1 sic@*/
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SIB19_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);
    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB19_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700 := valueof(p_Sib19);
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  };

  /*
   * @desc      return the SI index including SIB19
   * @param     p_NR_SysinfoCombination
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB19_SI_Index (NR_SysinfoCombination_Type p_NR_SysinfoCombination) return integer
  {
    var integer v_SIB19_SI_Index;
    select (p_NR_SysinfoCombination) {
        //case (NR_28)    {   v_SIB19_SI_Index := 0; }  @sic R5-253084 sic@
        case (NR_29)    {   v_SIB19_SI_Index := 1; }
        case (NR_32, NR_35, NR_40)    {   v_SIB19_SI_Index := 2; } //@sic R5-261589 sic@
        case else { FatalError(__FILE__, __LINE__, "Invalid System Combination"); }
    }
    return v_SIB19_SI_Index;
  }

  /*
   * @desc      Get SIB19 in the cell
   * @param     p_NR_CellId
   * @return    SIB19_r17
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CellInfo_GetSIB19(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SIB19_r17
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);
    var SIB19_r17 v_SIB19;

    if (f_NR5GC_IsSib19InSysinfoCombination(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination)) {
        v_SIB19 := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700;
    } else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
    }

    return v_SIB19;
  };

    /*
   * @desc      Set value of ntn_UlSyncValidityDuration_r17 in SIB19
   * @param     p_NR_CellId
   * @param     p_NTN_UlSyncValidityDuration_r17
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB19_NTN_UlSyncValidityDuration(NR_CellId_Type p_NR_CellId,
                                                             template (value) NTN_Config_r17.ntn_UlSyncValidityDuration_r17 p_NTN_UlSyncValidityDuration_r17) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.ntn_Config_r17.ntn_UlSyncValidityDuration_r17:= valueof(p_NTN_UlSyncValidityDuration_r17);
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

   /*
   * @desc      Set value of ta-Report-r17 in SIB19
   * @param     p_NR_CellId
   * @param     p_TA_Report         (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB19_NTN_ta_Report_r17(NR_CellId_Type p_NR_CellId,
                                                    template (omit) NTN_Config_r17.ta_Report_r17 p_TA_Report := omit) runs on NR_BASE_PTC
  {
    var template (value) SIB19_r17 v_SIB19 := f_NR_CellInfo_GetSIB19(p_NR_CellId);
    if (isvalue(p_TA_Report)) {
      v_SIB19.ntn_Config_r17.ta_Report_r17 := p_TA_Report;
    } else {
      v_SIB19.ntn_Config_r17.ta_Report_r17 := omit;
    }
    f_NR5GC_CellInfo_SetSIB19(p_NR_CellId, v_SIB19);
  }

  /*
   * @desc      Set t_Service_r17 value stored in SIB19 in the indicated cell
   * @param     p_NR_CellId
   * @param     p_T_Service_r17
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_CellInfo_SetSIB19_t_Service_r17(NR_CellId_Type p_NR_CellId,
                                                   template (value) SIB19_r17.t_Service_r17 p_T_Service_r17) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.t_Service_r17 := valueof(p_T_Service_r17);
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

   /*
   * @desc      Set value of referenceLocation-r17 and distanceThresh-r17 in SIB19
   * @param     p_NR_CellId
   * @param     p_ReferenceLocation_r17 (default value: omit)
   * @param     p_DistanceThresh_r17 (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(NR_CellId_Type p_NR_CellId,
                                                                    template (omit) SIB19_r17.referenceLocation_r17 p_ReferenceLocation_r17 := omit,
                                                                    template (omit) SIB19_r17.distanceThresh_r17 p_DistanceThresh_r17 := omit
                                                                    ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);

    if(isvalue(p_ReferenceLocation_r17)){
      v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.referenceLocation_r17:= valueof(p_ReferenceLocation_r17);
    } else {
      v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.referenceLocation_r17:= omit;
    }
    if(isvalue(p_DistanceThresh_r17)){
      v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.distanceThresh_r17:= valueof(p_DistanceThresh_r17);
    } else {
      v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.distanceThresh_r17 := omit;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);

  }

  /*
   * @desc      Set value of ntn-Config-r17..epochTime-r17 in SIB19
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetSIB19_NTN_ephochTime_setTo0(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  { //@sic R5-255092 R5s250232 sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SI_Index := f_NR_GetSIB19_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700.ntn_Config_r17.epochTime_r17 := valueof(cs_EpochTime_r17_set0) ;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      get info of cell with given index (p_NR_CellId)
   * @param     p_NR_CellId
   * @return    NR_CellInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_Get(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_CellInfo_Type
  {
    var integer v_Index := f_NR_CellInfo_GetIndex(p_NR_CellId);
    if (not(isbound(vc_NR_Global.CellArray[v_Index]))) { //@sic R5s190109 sic@
        FatalError(__FILE__, __LINE__, "cellArray not initialised for that Cell")
    }
    return vc_NR_Global.CellArray[v_Index];
  }

  /*
   * @desc      Return the index corresponding to p_NR_CellId
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetIndex(NR_CellId_Type p_NR_CellId) return integer
  {
    var integer v_Index := 0;

    select (p_NR_CellId) {
      case (nr_Cell1) { v_Index := 0; }
      case (nr_Cell2) { v_Index := 1; }
      case (nr_Cell3) { v_Index := 2; }
      case (nr_Cell4) { v_Index := 3; }
      case (nr_Cell6) { v_Index := 4;  }
      case (nr_Cell10) { v_Index := 5;  }
      case (nr_Cell11) { v_Index := 6;  }
      case (nr_Cell12) { v_Index := 7;  }
      case (nr_Cell13) { v_Index := 8;  }
      case (nr_Cell14) { v_Index := 9;  }
      case (nr_Cell23) { v_Index := 10;  }
      case (nr_Cell28) { v_Index := 11;  }
      case (nr_Cell29) { v_Index := 12;  }
      case (nr_Cell30) { v_Index := 13;  }
      case (nr_Cell31) { v_Index := 14;  }
      case else  {
        FatalError(__FILE__, __LINE__, "Invalid NR CellId");
      }
    }
    return v_Index;
  }

  type record SNPN_SubscriberData {  /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    PLMN_Identity  Plmn,
    integer        Nid
  };

  type record of SNPN_SubscriberData    SNPN_SubscriberDataList;  /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      get PLMN and NID info for all cells
   *            To be used in the UT function f_UT_ProvideSubscriberDataList
   * @return    SNPN_SubscriberDataList
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetNIDsForAllCells() runs on NR_BASE_PTC return SNPN_SubscriberDataList
  {
    var integer v_Index;
    var SNPN_SubscriberDataList v_SNPN_DataList := {}; // @sic R5s221231 sic@
    var integer v_ListIndex := 0;
    var PLMN_Identity v_ASN_PLMN;

    for (v_Index :=0; v_Index < lengthof (vc_NR_Global.CellArray); v_Index := v_Index +1) {  // @sic R5s221231 sic@
      if (ispresent(vc_NR_Global.CellArray[v_Index].NAS_Parameters.PLMN_Identity)) {  // @sic R5s221231 sic@
        v_ASN_PLMN := vc_NR_Global.CellArray[v_Index].NAS_Parameters.PLMN_Identity;
        // NID is 0 for all cells
        v_SNPN_DataList[v_ListIndex] := {v_ASN_PLMN, 0};
        v_ListIndex := v_ListIndex + 1;
      }
    }
    return v_SNPN_DataList;
  }

  /*
   * @desc      Return the SSB SubcarrierSpacing corresponding to p_NR_CellId
   * @param     p_NR_CellId
   * @return    SubcarrierSpacing
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSSB_SCS(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SubcarrierSpacing
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.SSB_SubcarrierSpacing;
  }

  /*
   * @desc      Return the CARRIER SubcarrierSpacing corresponding to p_NR_CellId
   * @param     p_NR_CellId
   * @return    SubcarrierSpacing
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSCS(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SubcarrierSpacing
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList[0].subcarrierSpacing
  }

  /*
   * @desc      Return the FrequencyInfoDL of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    FrequencyInfoDL
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetFrequencyInfoDL(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return FrequencyInfoDL
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.FrequencyInfoDL;
  }

  /*
   * @desc      Return the FrequencyInfoUL of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    FrequencyInfoUL
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetFrequencyInfoUL(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return FrequencyInfoUL
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.FrequencyInfoUL;
  }

  /*
   * @desc      Return the DL carrierBandwidth in PRBs of the SCS-carrier p_Index of the cell
   * @param     p_NR_CellId
   * @param     p_Index             (default value: 0)
   * @return    SCS_SpecificCarrier.carrierBandwidth
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetCarrierBandwidth_DL(NR_CellId_Type p_NR_CellId,
                                                integer p_Index := 0) runs on NR_BASE_PTC return SCS_SpecificCarrier.carrierBandwidth
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList[p_Index].carrierBandwidth;
  }

  /*
   * @desc      Return the band of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    FreqBandIndicatorNR
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetBandIndicator(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return FreqBandIndicatorNR
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var FreqBandIndicatorNR v_FreqBandIndicatorNR;

    if (isvalue(v_NR_CellInfo.FrequencyBand.FrequencyInfoDL)){ //DL defined in the cell
      v_FreqBandIndicatorNR := v_NR_CellInfo.FrequencyBand.FrequencyInfoDL.frequencyBandList[0];
    } else {//UL cell only
      v_FreqBandIndicatorNR := v_NR_CellInfo.FrequencyBand.FrequencyInfoUL.frequencyBandList[0];
    }
    return v_FreqBandIndicatorNR;
  }

  /*
   * @desc      Return the MFBI band of the cell p_NR_CellId when it is set otherwise return omit
   * @param     p_NR_CellId
   * @return    template (omit) FreqBandIndicatorNR
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetMFBI_Band(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) FreqBandIndicatorNR
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var template (omit) FreqBandIndicatorNR v_MFBI_FreqBandIndicatorNR := omit;

    if (isvalue(v_NR_CellInfo.FrequencyBand.MFBI_Band)){
        v_MFBI_FreqBandIndicatorNR := v_NR_CellInfo.FrequencyBand.MFBI_Band;
    }
    return v_MFBI_FreqBandIndicatorNR;
  }

  /*
   * @desc      Return the absoluteFrequencySSB of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    ARFCN_ValueNR
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetFrequencySSB(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return ARFCN_ValueNR
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.FrequencyInfoDL.absoluteFrequencySSB;
  }

  /*
   * @desc      Return the Coreset#0 index of the of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    ControlResourceSetZero
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetCoreset0_Index(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return ControlResourceSetZero
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.Coreset0_Index;
  }

  /*
   * @desc      Return NR frequency & band info of the cell
   * @param     p_NR_CellId
   * @return    NR_FrequencyBand_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_GetFrequencyBand(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC  return NR_FrequencyBand_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand;
  }

  /*
   * @desc      Return the ChannelBandwidth (in MHz) corresponding to p_NR_CellId
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetChannelBandwidth(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.FrequencyBand.ChannelBandwidth;
  }

  /*
   * @desc      Return true if the Channel Bandwidth of p_NR_CellId is 3MHz
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetIsBandwidth3MHz(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {
    if (f_NR_CellInfo_GetChannelBandwidth(p_NR_CellId) == 3) {
      return true;
    } else {
      return false;
    }
  }

  /*
   * @desc      Return true if the UL Frequency is defined for the cell otherwise return false
   *            Note: needed for specific CA band combinations where the UL frequency is not specified (e.g. CA_n66B) and also for SDL
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_IsUL_FrequencyAvailable(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);

    if (ispresent(v_NR_CellInfo.FrequencyBand.FrequencyInfoUL) and not f_NR_IsBandSDL(v_FreqBandIndicatorNR)) {
        return true;
    } else {
        return false;
    }
  }

  /*
   * @desc      Return the FDD/TDD duplex mode of the cell p_NR_CellId
   * @param     p_NR_CellId
   * @return    NR_DuplexMode_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetDuplexMode(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_DuplexMode_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.DuplexMode;
  }

  /*
   * @desc      Return true if the cell is FDD HD-FDD mode
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetHalfDuplexFDD(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var boolean v_IsHD_UE := false;

    if (ischosen(v_NR_CellInfo.DuplexMode.FDD)) {
        if (v_NR_CellInfo.DuplexMode.FDD.HalfDuplexFDD == true) {v_IsHD_UE := true;}
    }
    return v_IsHD_UE;
  }

  /*
   * @desc      Return the TDD_UL_DL_ConfigCommon of the cell
   * @param     p_NR_CellId
   * @return    template (omit) TDD_UL_DL_ConfigCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetTDD_UL_DL_ConfigCommon(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) TDD_UL_DL_ConfigCommon
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var template (omit) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon := omit;

    if (not f_NR_CellInfo_GetIsFDD(p_NR_CellId)) { //TDD
      if (ischosen(v_NR_CellInfo.DuplexMode.TDD.Config)) {
        v_TDD_UL_DL_ConfigCommon := v_NR_CellInfo.DuplexMode.TDD.Config.Common.R15;
      }
    }
    return v_TDD_UL_DL_ConfigCommon;
  }

  /*
   * @desc      Return the band & duplex mode type FDD/TDD_FR1/TDD_FR2 of the cell
   * @param     p_NR_CellId
   * @return    DuplexBand_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetDuplexBand(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return DuplexBand_Type
  {
    var DuplexBand_Type v_DuplexBand := fdd;
    var NR_DuplexMode_Type v_NR_DuplexMode := f_NR_CellInfo_GetDuplexMode(p_NR_CellId);
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);

    if (ischosen(v_NR_DuplexMode.TDD)) {
      if (f_NR_IsBandFR1(v_FreqBandIndicatorNR)) {
        v_DuplexBand := tdd_FR1;
      } else {
        v_DuplexBand := tdd_FR2;
      }
    }
    return v_DuplexBand;
  }

  /*
   * @desc      Return true if the band of the cell is FDD return false otherwise
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetIsFDD(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);
    return f_NR_IsBandFDD(v_FreqBandIndicatorNR);
  }

  /*
   * @desc      Return true if the band of the cell is a shared spectrum band
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetIsSharedSpectrum(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  { //@sic R5-240531, R5w240005 sic@
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);
    return f_NR_IsBandSharedSpectrum(v_FreqBandIndicatorNR);
  }

  /*
   * @desc      Return true if the band of the cell is FR1 return false otherwise
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetIsFR1(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);
    return f_NR_IsBandFR1(v_FreqBandIndicatorNR);
  }

  /*
   * @desc      return the C-RNTI stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    RNTI_Value_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetRNTI(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return RNTI_Value_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.RNTI.RNTI;
  }

  /*
   * @desc      Return RACH_ConfigDedicated as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    template (omit) RACH_ConfigDedicated
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */

  function f_NR_CellInfo_GetRACH_ConfigDedicated (NR_CellId_Type p_NR_CellId ) runs on NR_BASE_PTC return template (omit) RACH_ConfigDedicated
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    return v_PhysicalParameters.RACH_ConfigDedicated;
  }

  /*
   * @desc      Set RACH_ConfigDedicated in NR_CellInfo of the cell
   * @param     p_NR_CellId
   * @param     p_RACH_ConfigDedicated
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
   function f_NR_CellInfo_SetRACH_ConfigDedicated(NR_CellId_Type p_NR_CellId,
                                                 template (value) RACH_ConfigDedicated p_RACH_ConfigDedicated
                                                 ) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.PhysicalParameters.RACH_ConfigDedicated := p_RACH_ConfigDedicated;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc  Initialise and Return RACH-ConfigDedicated as specified in TS 38.508-1 Table 4.6.3-129: RACH-ConfigDedicated and set it in the CellArray
   * @param     p_NR_CellId
   * @param     p_Ra_PreambleIndex  (default value: 8)
   * @return    template (value) RACH_ConfigDedicated
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetRACHConfigDedicated_Def(NR_CellId_Type p_NR_CellId,
                                           integer p_Ra_PreambleIndex := 8) runs on NR_BASE_PTC return template (value) RACH_ConfigDedicated
  {
    var template (value) RACH_ConfigDedicated v_RACH_ConfigDedicated;
    var template (value) RACH_ConfigGeneric v_RACH_ConfigGeneric := f_NR_CellInfo_GetRACH_ConfigGeneric(p_NR_CellId, tsc_NR_BWP_Id);
    var integer v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);

    v_RACH_ConfigDedicated := cs_38508_RACH_ConfigDedicated(v_RACH_ConfigGeneric,p_Ra_PreambleIndex,v_SSB_Index);
    f_NR_CellInfo_SetRACH_ConfigDedicated(p_NR_CellId, v_RACH_ConfigDedicated);
    return v_RACH_ConfigDedicated;
  }

  /*
   * @desc      Return UL_BWP with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_BWP_Id
   * @return    NR_UplinkBWP_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetUplinkBWP(NR_CellId_Type p_NR_CellId,
                                      BWP_Id p_BWP_Id) runs on NR_BASE_PTC return NR_UplinkBWP_Type
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    return f_NR_RetrieveUplinkBWP(v_PhysicalParameters.UL_BWPs, p_BWP_Id);
  }

  /*
   * @desc      Return UL_BWP List as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    NR_UplinkBWP_List_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetUplinkBWP_List(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_UplinkBWP_List_Type
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    return v_PhysicalParameters.UL_BWPs;
  }

  /*
   * @desc      Return RACH_ConfigGeneric store in the UL BWP in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_BWP_Id
   * @return    RACH_ConfigGeneric
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetRACH_ConfigGeneric(NR_CellId_Type p_NR_CellId,
                                               BWP_Id p_BWP_Id) runs on NR_BASE_PTC return RACH_ConfigGeneric
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_RetrieveUplinkBWP(v_PhysicalParameters.UL_BWPs, p_BWP_Id);

    return v_NR_UplinkBWP.Common.R15.rach_ConfigCommon.setup.rach_ConfigGeneric;
  }

  /*
   * @desc      return locationAndBandwidth of the Uplink BWP (default is the Initial BWP)
   * @param     p_NR_CellId
   * @param     p_BWP_Id            (default value: tsc_NR_BWP_Id)
   * @return    BWP.locationAndBandwidth
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetUplinkBWP_LocationAndBandwidth(NR_CellId_Type p_NR_CellId,
                                                           BWP_Id p_BWP_Id := tsc_NR_BWP_Id
                                                          ) runs on NR_BASE_PTC return BWP.locationAndBandwidth
  { //@sic R5-243537 sic@
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_RetrieveUplinkBWP(v_PhysicalParameters.UL_BWPs, p_BWP_Id);

    return v_NR_UplinkBWP.Common.R15.genericParameters.locationAndBandwidth;
  }

  /*
   * @desc      return DL_BWP with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_BWP_Id
   * @return    NR_DownlinkBWP_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetDownlinkBWP(NR_CellId_Type p_NR_CellId,
                                        BWP_Id p_BWP_Id) runs on NR_BASE_PTC return NR_DownlinkBWP_Type
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    return f_NR_RetrieveDownlinkBWP(v_PhysicalParameters.DL_BWPs, p_BWP_Id);
  }

  /*
   * @desc      Set DL_BWP with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_DownlinkBWP
   * @param     p_BWP_Id
   * @status    APPROVED (ENDC, NR5GC)
   */

   function f_NR_CellInfo_SetDownlinkBWP(NR_CellId_Type p_NR_CellId,
                                        template (value) NR_DownlinkBWP_Type p_DownlinkBWP,
                                        BWP_Id p_BWP_Id) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer i := fl_NR_RetrieveDownlinkBWP_Index(v_NR_CellInfo.PhysicalParameters.DL_BWPs, p_BWP_Id);

    v_NR_CellInfo.PhysicalParameters.DL_BWPs[i] := p_DownlinkBWP;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set DL_BWPList as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_DownlinkBWP_List
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_CellInfo_SetDownlinkBWP_List(NR_CellId_Type p_NR_CellId,
                                        template (value) NR_DownlinkBWP_List_Type p_DownlinkBWP_List) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.PhysicalParameters.DL_BWPs := p_DownlinkBWP_List;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set RadioLinkMonitoringConfig with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_RadioLinkMonitoringConfig
   * @status    APPROVED (ENDC, NR5GC)
   */

  function f_NR_CellInfo_SetRadioLinkMonitoringConfig ( NR_CellId_Type p_NR_CellId,
                                                        template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type p_RadioLinkMonitoringConfig) runs on NR_BASE_PTC
  { //@sic R5s190244 sic@
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.PhysicalParameters.RadioLinkMonitoringConfig := p_RadioLinkMonitoringConfig;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      get RadioLinkMonitoringConfig with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetRadioLinkMonitoringConfig ( NR_CellId_Type p_NR_CellId
                                                        ) runs on NR_BASE_PTC return template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type
  { //@sic R5s190244 sic@
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.PhysicalParameters.RadioLinkMonitoringConfig;
  }

  /*
   * @desc      return PhysCellId stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    PhysCellId
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetPhysicalCellId(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return PhysCellId
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.CellIds.PhysicalCellId;
  }

  /*
   * @desc      Return SSB_BurstConfig stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    ServingCellConfigCommon.ssb_PositionsInBurst
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSSB_BurstConfig(NR_CellId_Type p_NR_CellId)runs on NR_BASE_PTC return ServingCellConfigCommon.ssb_PositionsInBurst
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.PhysicalParameters.SSB_BurstConfig.PositionsInBurst;
  }

  /*
   * @desc      Return SSB_Index of the cell stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    SSB_Index
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSSB_Index(NR_CellId_Type p_NR_CellId)runs on NR_BASE_PTC return SSB_Index
  {
    var ServingCellConfigCommon.ssb_PositionsInBurst v_SSB_PositionsInBurst := f_NR_CellInfo_GetSSB_BurstConfig(p_NR_CellId);
    return f_NR_ConvertPositionsInBurst_ToSSB_Index(v_SSB_PositionsInBurst);
  }

  /*
   * @desc      Return SSB_Index of the cell stored in NR_CellInfo
   * @param     p_PositionsInBurst
   * @return    SSB_Index
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_ConvertPositionsInBurst_ToSSB_Index (NR_SSB_PositionsInBurst_Type p_PositionsInBurst) return SSB_Index
  {
    var bitstring v_SSB_IndexBitstring;
    var integer i;
    var SSB_Index v_SSB_Index;

    select union (p_PositionsInBurst) {
        case(shortBitmap) { v_SSB_IndexBitstring := p_PositionsInBurst.shortBitmap }
        case(mediumBitmap) { v_SSB_IndexBitstring := p_PositionsInBurst.mediumBitmap }
        case(longBitmap) { v_SSB_IndexBitstring := p_PositionsInBurst.longBitmap }
        case else {  FatalError(__FILE__, __LINE__, "Wrong PositionInBurst") }
    }
    //Convert SSB-index from bitstring to integer
    for (i:=0; i<lengthof(v_SSB_IndexBitstring); i:=i+1) {
        if (v_SSB_IndexBitstring[i] == '1'B) {
            v_SSB_Index := i;
            break
        }
    }
    return v_SSB_Index;
  }

  /*
   * @desc      return DL_BWP_List  as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @return    NR_DownlinkBWP_List_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_GetDownlinkBWP_List(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_DownlinkBWP_List_Type
  {
    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    return v_PhysicalParameters.DL_BWPs ;
  }

  /*
   * @desc      return index of SearchSpaceConfig in DownlinkBWP's SearchSpaceArray matching p_SearchSpaceId
   * @param     p_NR_DownlinkBWP
   * @param     p_SearchSpaceId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DownlinkBWP_GetSearchSpace_Index(template (value) NR_DownlinkBWP_Type p_NR_DownlinkBWP,
                                                 SearchSpaceId p_SearchSpaceId) return integer
  {
    var integer v_Index;
    var integer i;

    for (i:=0; i<lengthof(p_NR_DownlinkBWP.Pdcch.SearchSpaceArray); i:= i+1) {
      if (match(p_SearchSpaceId, p_NR_DownlinkBWP.Pdcch.SearchSpaceArray[i].SearchSpaceConfigAtUE.R15.searchSpaceId)) {
        v_Index := i;
      }
    }
    return v_Index;
  }

  /*
   * @desc      return UE searchSpace with SearchSpaceId=p_SearchSpaceId stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_SearchSpaceId
   * @param     p_BWP_Id
   * @return    NR_BWP_SearchSpaceConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSearchSpaceConfigAtSS(NR_CellId_Type p_NR_CellId,
                                                  SearchSpaceId p_SearchSpaceId,
                                                  BWP_Id p_BWP_Id)
    runs on NR_BASE_PTC return NR_BWP_SearchSpaceConfig_Type
  {
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, p_BWP_Id);
    var integer i := f_NR_DownlinkBWP_GetSearchSpace_Index(v_NR_DownlinkBWP, p_SearchSpaceId);
    return v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[i];
  }

  /*
   * @desc      return UE searchSpace with SearchSpaceId=p_SearchSpaceId stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_SearchSpaceId
   * @param     p_BWP_Id
   * @return    SearchSpace
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSearchSpaceConfigAtUE(NR_CellId_Type p_NR_CellId,
                                                  SearchSpaceId p_SearchSpaceId,
                                                  BWP_Id p_BWP_Id)
    runs on NR_BASE_PTC return SearchSpace
  {
    var NR_BWP_SearchSpaceConfig_Type v_SearchSpaceConfig := f_NR_CellInfo_GetSearchSpaceConfigAtSS(p_NR_CellId, p_SearchSpaceId,p_BWP_Id);
    return v_SearchSpaceConfig.SearchSpaceConfigAtUE.R15;
  }

  /*
   * @desc      Return CORESET with controlResourceSetId=ControlResourceSetId stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_ControlResourceSetId
   * @param     p_BWP_Id
   * @return    ControlResourceSet
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetControlResourceSet(NR_CellId_Type p_NR_CellId,
                                               ControlResourceSetId p_ControlResourceSetId,
                                               BWP_Id p_BWP_Id)
    runs on NR_BASE_PTC  return ControlResourceSet
  {
    var ControlResourceSet v_ControlResourceSet;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, p_BWP_Id);
    var integer i;

    for (i:=0; i<lengthof(v_NR_DownlinkBWP.Pdcch.CoresetArray); i:= i+1) {
      if (v_NR_DownlinkBWP.Pdcch.CoresetArray[i].R15.controlResourceSetId == p_ControlResourceSetId) {
        v_ControlResourceSet := v_NR_DownlinkBWP.Pdcch.CoresetArray[i].R15;
        break;
      }
    }
    return v_ControlResourceSet;
  }

  /*
   * @desc      get timing info (SNF offset, Tcell, TcOffset) from the cell info as stored for the given cell
   * @param     p_NR_CellId
   * @return    CellTimingInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetCellTimingInfo(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return CellTimingInfo_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.CellTimingInfo;
  }

  /* @desc      to set the value of CellTimingInfo
   * @param     p_NR_CellId
   * @param     p_CellTimingInfo
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_Set_CellTimingInfo(NR_CellId_Type      p_NR_CellId,
                                            CellTimingInfo_Type p_CellTimingInfo) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.CellTimingInfo := p_CellTimingInfo;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Return the number of slot per subframe according to the SCS of the cell
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSlotsNumberPerSubframe(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    return f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
  }

  /*
   * @desc      Return the number of slot per subframe according to the SCS of the cell
   * @param     p_SCS
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(SubcarrierSpacing p_SCS) return integer
  {
    var integer v_NumberSlotsPerSubframe := 1;

    select (p_SCS) { //Acc to 38.211 Table 4.3.2-1
      case(kHz15)  { v_NumberSlotsPerSubframe := 1; }
      case(kHz30)  { v_NumberSlotsPerSubframe := 2; }
      case(kHz60)  { v_NumberSlotsPerSubframe := 4; }
      case(kHz120) { v_NumberSlotsPerSubframe := 8; }
      case(kHz240) { v_NumberSlotsPerSubframe := 16; }
      case else    { FatalError(__FILE__, __LINE__, "Invalid SubcarrierSpacing"); }
    }
    return v_NumberSlotsPerSubframe;
  }

