module RRC_Measurement_NR5GC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from NR5GC_IRAT_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Functions all;
  import from NR_Measurement_Templates all;
  import from NR_NoiseGenerator all;
  import from NR_RRC_Templates all;

  template (value) EventTriggerConfigInterRAT cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA_Rsrq(RSRQ_Range p_B2_Threshold2,
                                                                                                    RSRQ_RangeEUTRA p_ThresholdEUTRA,
                                                                                                    Hysteresis p_Hysteresis,
                                                                                                    EventTriggerConfigInterRAT.reportAmount p_ReportAmount,
                                                                                                    boolean p_Rsrq,
                                                                                                    boolean p_Sinr,
                                                                                                    ReportInterval p_ReportInterval := ms120) := //@sic R5s201111 sic@
  { /* @status    APPROVED (NR5GC_IRAT) */
    //@sic R5-197213 sic@
    eventId := {
      eventB2 := {
        b2_Threshold1 := {
            rsrq := p_B2_Threshold2
        },
        b2_Threshold2EUTRA := {
            rsrq := p_ThresholdEUTRA
        },
        reportOnLeave := false,
        hysteresis := p_Hysteresis,
        timeToTrigger := ms0
      }
    },
    rsType := ssb,
    reportInterval := p_ReportInterval,
    reportAmount := p_ReportAmount,
    reportQuantity := {
      rsrp := true,
      rsrq := p_Rsrq,
      sinr := p_Sinr
    },
    maxReportCells := 8,
    reportQuantityUTRA_FDD_r16 := omit,  /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    includeCommonLocationInfo_r16 := omit,  /* @sic R5s211526 BASELINE MOVING 2021 sic@ */
    includeBT_Meas_r16 := omit,      /* @sic R5s211526 BASELINE MOVING 2021 sic@ */
    includeWLAN_Meas_r16 := omit,    /* @sic R5s211526 BASELINE MOVING 2021 sic@ */
    includeSensor_Meas_r16 := omit,  /* @sic R5s211526 BASELINE MOVING 2021 sic@ */
    reportQuantityRelay_r17:= omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    cellIndividualOffsetList_r18 := omit /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  }; /* @sic R5s221179 sic@ */

  template (value) EventTriggerConfigInterRAT cds_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA_Sinr(RSRP_Range p_B2_Threshold2,
                                                                                                     RSRP_RangeEUTRA p_ThresholdEUTRA,
                                                                                                     Hysteresis p_Hysteresis,
                                                                                                     EventTriggerConfigInterRAT.reportAmount p_ReportAmount,
                                                                                                     boolean p_Rsrq,
                                                                                                     boolean p_Sinr
  ) modifies cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    //@sic R5-197213 sic@
    eventId := {
      eventB2 := {
        b2_Threshold1 := {
            sinr := p_B2_Threshold2
        },
        b2_Threshold2EUTRA := {
            sinr := p_ThresholdEUTRA
        },
        reportOnLeave := false,
        hysteresis := p_Hysteresis,
        timeToTrigger := ms0 //@sic R5-218355 sic@
      }
    }
  }; /* @sic R5s221179 sic@ */

  template (value) ReportCGI_EUTRA cs_NR_ReportConfigInterRAT_CGI(EUTRA_PhysCellId p_EUTRA_CellId) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    cellForWhichToReportCGI := p_EUTRA_CellId,
    useAutonomousGaps_r16 := omit                   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
  };

  template (value) ReportConfigToAddMod cs_NR_ReportConfig_reportConfigInterRAT_CGI(ReportConfigId p_ReportConfigId,
                                                                                    template (value) ReportCGI_EUTRA p_ReportCGI_EUTRA) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    reportConfigId := p_ReportConfigId,
    reportConfig := {
      reportConfigInterRAT := {
        reportType := {
          reportCGI := p_ReportCGI_EUTRA
        }
      }
    }
  };

  template (present) CGI_InfoEUTRA cr_NR_MeasResultEUTRA_CGI_InfoEUTRA(template (present) CellAccessRelatedInfo_EUTRA_EPC p_CellAccessRelatedInfo_EUTRA_EPC,
                                                                       template (present) CellAccessRelatedInfo_EUTRA_5GC p_CellAccessRelatedInfo_EUTRA_5GC,
                                                                       template (present) FreqBandIndicatorEUTRA p_FreqBandIndicatorEUTRA,
                                                                       template (omit) MultiBandInfoListEUTRA p_MultiBandInfoListEUTRA := omit
                                                                       ) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    cgi_info_EPC :=
    {
       cgi_info_EPC_legacy := p_CellAccessRelatedInfo_EUTRA_EPC,
       cgi_info_EPC_list := omit
    },
    cgi_info_5GC := {p_CellAccessRelatedInfo_EUTRA_5GC} ifpresent, //@sic R5s200713 sic@
    freqBandIndicator := p_FreqBandIndicatorEUTRA,
    multiBandInfoList := p_MultiBandInfoListEUTRA,
    freqBandIndicatorPriority := omit
  };

  template (present) CellAccessRelatedInfo_EUTRA_EPC cr_CellAccessRelatedInfo_EUTRA_EPC(PLMN_IdentityList_EUTRA_EPC p_PLMN_IdentityList_EUTRA_EPC,
                                                                                        B16_Type p_TrackingAreaCode_Eutra_Epc,
                                                                                        B28_Type p_CellIdentity_Eutra_Epc
                                                                                        ) :=
                                                                                        
  { /* @status    APPROVED (NR5GC_IRAT) */
    plmn_IdentityList_eutra_epc := p_PLMN_IdentityList_EUTRA_EPC,
    trackingAreaCode_eutra_epc := p_TrackingAreaCode_Eutra_Epc,
    cellIdentity_eutra_epc := p_CellIdentity_Eutra_Epc
  };

  template (present) MeasQuantityResultsEUTRA cr_NR_MeasQuantityResultsEUTRA_None :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    rsrp := omit,
    rsrq := omit,
    sinr := omit
  };

/*
   * @desc      Function to generate measurement config with NR and EUTRA Measurement objects
   * @param     p_MeasIdToAddModList (default value: cs_NR_MeasIdToAddModList_1Entry)
   * @param     p_MeasGapConfig     (default value: omit)
   * @param     p_QuantityConfig    (default value: cs_38508_QuantityConfig)
   * @return    template (value) MeasConfig
   * @status    APPROVED (NR5GC_IRAT)
   */
    function f_NR_GenerateMeasurementConfigNR_EUTRA_CGI (template (omit) MeasIdToAddModList p_MeasIdToAddModList := cs_NR_MeasIdToAddModList_1Entry,
                                                         template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                                         template (omit) QuantityConfig p_QuantityConfig := cs_38508_QuantityConfig
                                                        ) return template (value) MeasConfig
    {
        return cs_NR_MeasConfig_Partial(omit,
                                       omit,
                                       p_MeasIdToAddModList,
                                       p_MeasGapConfig,
                                       p_QuantityConfig);
    };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.2.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_1_NR5GC() runs on NR5GC_PTC
  { // Measurement configuration control and reporting / Inter-RAT measurements / Event B1 / Measurement of E-UTRA cells
  
    f_NR5GC_IRAT_Init(NR_6); //@sic R5s191107 sic@
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -85); //Maximum power level for FR2 not applicable

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_2_1_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble")); //@sic R5s191107 sic@
      
  }// End of f_TC_8_1_3_2_1_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.3.2.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_1_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0_T1;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1 := -85;
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var RSRP_RangeEUTRA v_B1_ThresholdEUTRA;
    var Hysteresis v_Hysteresis := 0; //@sic R-218335 sic@
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r1;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (value) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
         
      
    //Power levels of NR cell 1: Table 8.1.3.2.1.3.2-1
    /*         |    FR1
     * ---------------------
     *   T0    |    -85
     * ---------------------
     *   T1    |    -85
     *
     */
    
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0_T1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    
    f_NR_SetCellPowerList(v_CellPowerList_AtT0_T1);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT measurement and reporting for event B1
    //The UE transmits an RRCReconfigrationComplete message
    
    v_B1_ThresholdEUTRA := 61; //@sic R5-198920, R5-195345 sic@
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_eventB1_EUTRA(v_B1_ThresholdEUTRA, v_Hysteresis, v_ReportAmount))};
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
      
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA); //@sic R5s191107 sic@
      
    //f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Steps  3" siclog@
    //Check: Does the UE transmit a MeasurementReport message within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);

    //@siclog "Step  4" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1" in Table 8.1.3.2.1.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger); //@sic R5s200543 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); //@sic R5s200543 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT0_T1);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message to report event B1 with the measured RSRP value for NR Cell 1?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, -, -, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)})); //@sic R5-204437, R5-201213, R5s200181, R5-211389 sic@

      
  }//End of f_TC_8_1_3_2_1_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.2.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_2_NR5GC() runs on NR5GC_PTC
  { // Measurement configuration control and reporting / Inter-RAT measurements / Event B2 / Measurement of E-UTRA cells
  
    f_NR5GC_IRAT_Init(NR_6); //@sic R5s191140 sic@
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -78, -78); //@sic R5-204382, R5-201477 sic@ //Maximum power level for FR2 not applicable

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_2_2_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    // Now tell EUTRA Postamble finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble")); //@sic R5s191140 sic@

      
  }// End of f_TC_8_1_3_2_2_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.3.2.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_2_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1 := -78; //@sic R5-204382, R5-201477 sic@
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1 := -90; //@sic R5s201614, R5-204382, R5-201477 sic@
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var Hysteresis v_Hysteresis := 3; //@sic R5s220690, R5-218355 sic@
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r1;
    var RSRP_Range v_B2_Threshold1 := 73; //@sic R5-201477, R5-195346 sic@
    var RSRP_RangeEUTRA v_B2_Threshold2EUTRA := 58; //@sic R5-198920, R5-195346 sic@
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (value) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
         
      
    //Power levels of NR cell 1: Table 8.1.3.2.2.3.2-1
    /*         |    FR1
     * ---------------------
     *   T0    |    -75
     * ---------------------
     *   T1    |    -85
     * ---------------------
     */
      
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    v_CellPowerList_AtT1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT measurement and reporting for event B2
    //The UE transmits an RRCReconfigrationComplete message
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA(v_B2_Threshold1, v_B2_Threshold2EUTRA, v_Hysteresis, v_ReportAmount, true, false))}; //@sic R5-203359 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};

    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA); //@sic R5s191140 sic@
    //f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Steps  3" siclog@
    //Check: Does the UE transmit a MeasurementReport message within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);

    //@siclog "Step  4" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1" in Table 8.1.3.2.1.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger); //@sic R5s200543 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); //@sic R5s200543 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message to report event B2 with the measured RSRP value for NR Cell 1?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, -, -, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)})); //@sic R5-204437, R5s191140, R5-211389 sic@

  }//End of f_TC_8_1_3_2_2_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.2.3
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_3_NR5GC() runs on NR5GC_PTC
  { // Measurement configuration control and reporting / Inter-RAT measurements / Event B2 / Measurement of E-UTRA cells / RSRQ based measurements
  
    f_NR5GC_IRAT_Init(NR_6);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -88, -88); //Maximum power level for FR2 not applicable
    

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_2_3_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    // Now tell EUTRA Postamble finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
      
  }// End of f_TC_8_1_3_2_3_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.3.2.3
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_3_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1 := -88;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1 := -88; //@sic R5s200725 sic@
    var integer v_Noc := -94;
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var Hysteresis v_Hysteresis := 0;
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r2; //@sic R5s200725 sic@
    var RSRQ_Range v_B2_Threshold1 := 79; //@sic R5s200725 sic@
    var RSRQ_RangeEUTRA v_B2_Threshold2EUTRA := 23; //@sic R5s200725 sic@
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (value) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
         
      
    //Power levels of NR cell 1: Table 8.1.3.2.3.3.2-1
    /*         |    FR1
     * ---------------------
     *   T0    |    -88
     * ---------------------
     *   T1    |    -94
     *
     */
      
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    v_CellPowerList_AtT1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
      
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    // Activate Noise Generator for NR Cell1
    f_NR_ConfigureAndActivateVNG_MultipleCells({cs_CellNoiseLevel(nr_Cell1, v_Noc)});
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message on NR Cell1 including MeasConfig to setup inter-RAT measurement and reporting for event B2
    //The UE transmits an RRCReconfigrationComplete message
    
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA_Rsrq(v_B2_Threshold1, v_B2_Threshold2EUTRA, v_Hysteresis, v_ReportAmount, true, false, ms120))}; //@sic R5s221179, R5-218335, R5-203359, R5s201111 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
      
    //v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, true, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_FR1(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA);
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_NR_GapConfig(0, ms6, ms40, ms0)), cs_38508_QuantityConfig_EUTRA);

    //v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);
      
    //f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Steps  3" siclog@
    //Check: Does the UE transmit a MeasurementReport message on NR Cell 1 within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);

    //@siclog "Step  4" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1" in Table 8.1.3.2.3.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger); //@sic R5s200543 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); //@sic R5s200543 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message on Cell 1 to report event B2 with the measured RSRP and RSRQ values for E-UTRA Cell 1?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, 2, 12.0, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)})); //@sic R5s220030, R5-204437, R5s201111, R5s200725, R5-201097, R5-211389 sic@
    
    // Deactivate Noise Generator for NR Cell1
    f_NR_DeactivateVNG_MultipleCells(f_NR_GetCellIdListWithActiveVNG({cs_CellNoiseLevel(nr_Cell1, v_Noc)}));
     
  }//End of f_TC_8_1_3_2_3_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.2.4
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_4_NR5GC() runs on NR5GC_PTC
  { // Measurement configuration control and reporting / Inter-RAT measurements / Event B2 / Measurement of E-UTRA cells / SINR based measurements
  
    f_NR5GC_IRAT_Init(NR_7);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -79, -79); //@sic R5-198921 sic@  //Maximum power level for FR2 not applicable
    

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_2_4_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    // Now tell EUTRA Postamble finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
      
  }// End of f_TC_8_1_3_2_4_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.3.2.4
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_2_4_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1 := -79; //@sic R5-198921 sic@
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1 := -91;
    var integer v_Noc := -94; //@sic R5s200727 sic@
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var Hysteresis v_Hysteresis := 4;
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r1; //@sic R5s200727 sic@
    var RSRP_Range v_B2_Threshold1 := 64; //@sic R5s200727 sic@
    var RSRP_RangeEUTRA v_B2_Threshold2EUTRA := 46;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (value) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
         
      
    //Power levels of NR cell 1: Table 8.1.3.2.4.3.2-1
    /*         |    FR1
     * ---------------------
     *   T0    |    -79
     * ---------------------
     *   T1    |    -91
     *
     */
      
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    v_CellPowerList_AtT1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
      
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    // Activate Noise Generator for NR Cell1
    f_NR_ConfigureAndActivateVNG_MultipleCells({cs_CellNoiseLevel(nr_Cell1, v_Noc)});
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message including MeasConfig Config to setup EUTRA measurement and reporting for inter-RAT event B2
    //The UE transmits an RRCReconfigrationComplete message
    
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cds_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA_Sinr(v_B2_Threshold1, v_B2_Threshold2EUTRA, v_Hysteresis, v_ReportAmount, true, true))}; /* @sic R5s221179 sic@ */
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};

    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, true, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA);
      
    //f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Steps  3" siclog@
    //Check: Does the UE transmit a MeasurementReport message with event B2 for EUTRA Cell 1 within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);

    //@siclog "Step  4" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1" in Table 8.1.3.2.4.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger); //@sic R5s200543 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); //@sic R5s200543 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message with event B2 for EUTRA Cell 1 within the next 10s?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    f_NR_CheckReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, 10.0, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq_Sinr)}), cr_NR_MeasQuantityResults_Any); //@sic R5s201018 sic@
    
    // Deactivate Noise Generator for NR Cell1
    f_NR_DeactivateVNG_MultipleCells(f_NR_GetCellIdListWithActiveVNG({cs_CellNoiseLevel(nr_Cell1, v_Noc)}));
     
  }//End of f_TC_8_1_3_2_4_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.3.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_3_2_NR5GC() runs on NR5GC_PTC
  { // Measurement configuration control and reporting / CGI reporting of E-UTRA cell
  
    f_NR5GC_IRAT_Init(NR_6);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -85); //Maximum power level for FR2 not applicable
    

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_3_2_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    // Now tell EUTRA Postamble finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));

      
  }// End of f_TC_8_1_3_3_2_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.3.3.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_3_3_2_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1 := -85;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1 := -85;
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var Hysteresis v_Hysteresis := 3; //@sic R5s220691, R5-218335, R5s200713 sic@
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r1;
    var RSRP_Range v_B2_Threshold1 := 77;
    var RSRP_RangeEUTRA v_B2_Threshold2EUTRA := 56;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var EUTRA_NR_CoOrd_GUTI_Type v_CoOrd_Guti;
    var PLMN_Identity v_PLMN_Identity;
    var B16_Type v_TrackingAreaCode_Eutra_Epc;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (value) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) RRCReconfiguration_v1530_IEs v_RRCReconfiguration_v1530;
    var template (present) CGI_InfoEUTRA v_NR_MeasResultEUTRA_CGI_InfoEUTRA;
    var template (value) CellAccessRelatedInfo_EUTRA_EPC v_CellAccessRelatedInfo_EUTRA_EPC;
    var template (value) FreqBandIndicatorEUTRA v_FreqBandIndicatorEUTRA;
         
      
    //Power levels of NR cell 1: Table 8.1.3.3.2.3.2-1
    /*         |    FR1
     * ---------------------
     *   T0    |    -85
     * ---------------------
     *   T1    |    -85
     * ---------------------
     */
      
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    v_CellPowerList_AtT1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)}; //FR2 not applicable
    
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT measurement and reporting for event B2
    //The UE transmits an RRCReconfigrationComplete message
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA(v_B2_Threshold1, v_B2_Threshold2EUTRA, v_Hysteresis, v_ReportAmount, true, false)), cs_NR_ReportConfig_reportConfigInterRAT_CGI(tsc_NR_IdReportConfigId2, cs_NR_ReportConfigInterRAT_CGI(v_EUTRA_CellId))}; //@sic R5-203359 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};

    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA);
    
    //v_MAC_CellGroupConfig := cs_NR_MAC_CellGroupConfig(cs_NR_DRX_Config_Setup(cs_38508_DRX_Config_FR1));
    
    v_CellGroupConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_MCG, -, -,
                                                  -,-,
                                                  cs_NR_SpCellConfigDef(tsc_NR_CellGroupId_MCG,
                                                                        -,
                                                                        -,
                                                                        cs_NR_ServingCellConfigMeas(tsc_NR_MeasId1)) ); //@sic R5s200713 sic@
    
    v_RRCReconfiguration_v1530 := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_CellGroupConfig)));
    
    f_NR_SendRRCReconfiguration(nr_Cell1,-,-,v_RRCReconfiguration_v1530,-, v_MeasConfig); //@sic R5s200713 sic@
    
    //@siclog "Steps  3" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1" in Table 8.1.3.3.2.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger); //@sic R5s200543 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); //@sic R5s200543 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    /*
    //Check: Does the UE transmit a MeasurementReport message within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);
    */
    
    //@siclog "Step  4" siclog@
    //Check: Does the UE transmit a MeasurementReport message to report event B2 with the measured RSRP value for NR Cell 1?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, -, -, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)})); //@sic R5-204437, R5s191140, R5-211389 sic@

    //@siclog "Steps 5-6" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig including reportCGI for E-UTRA Cell 1 and sufficient idle periods for UE to acquire the relevant system information from E-UTRA Cell 1
    //The UE transmits an RRCReconfigrationComplete message
    
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf2};

    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA_CGI(v_MeasIdConfigList, -, cs_38508_QuantityConfig_EUTRA);
    f_NR_SendRRCReconfiguration_MeasNR_CellGroupConfig_DRX(nr_Cell1, v_MeasConfig, omit, cs_38508_MAC_CellGroupConfig_DRX); //@sic R5s200346, R5-201139 sic@
    
    //f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
    //f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-198871 sic@
    
    //Get and retrieve Information from EUTRA
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);

    v_CoOrd_Guti := f_EUTRA_NR_WaitForCoOrd_GutiParams (EUTRA);
    v_PLMN_Identity := f_NR_O3ToAsn_PlmnId(v_CoOrd_Guti.PLMN);
    
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_TrackingAreaCode_Eutra_Epc := v_CoOrd_SysInfo.Eutra[0].TAC;
    v_FreqBandIndicatorEUTRA := v_CoOrd_SysInfo.Eutra[0].freqBandIndicator;
    v_CellAccessRelatedInfo_EUTRA_EPC := cr_CellAccessRelatedInfo_EUTRA_EPC({v_PLMN_Identity}, v_TrackingAreaCode_Eutra_Epc, v_CoOrd_SysInfo.Eutra[0].CellId);
    v_NR_MeasResultEUTRA_CGI_InfoEUTRA := cr_NR_MeasResultEUTRA_CGI_InfoEUTRA(v_CellAccessRelatedInfo_EUTRA_EPC,?,v_FreqBandIndicatorEUTRA,omit);
    
    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit a MeasurementReport message with CGI of E-UTRA Cell 1 within 1 sec?
    f_NR_CheckReceiveMeasurementReports(nr_Cell1, v_PhysCellId, tsc_NR_MeasId1, 1.0, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_None, v_NR_MeasResultEUTRA_CGI_InfoEUTRA)})); //@sic R5s210602, R5s210044 sic@
  
  }//End of f_TC_8_1_3_3_2_TestBody()

}
