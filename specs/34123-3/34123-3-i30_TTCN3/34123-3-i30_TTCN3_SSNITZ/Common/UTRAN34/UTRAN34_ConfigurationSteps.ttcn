module UTRAN34_ConfigurationSteps {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_ASN1_ASP_Templates all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_Templates all;

  /*
   * @desc      To configure AICH and PRACH physical channels and connect RACH onto PRACH, then map one logical channel (CCCH) to RACH
   *            R99 function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RACH_CCCH_Cfg_r99(UTRAN_CellId_Type p_CellId)runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type_FDD v_CellInfoFDD;
    
    v_CellInfoFDD := f_UTRAN_CellInfo_GetFDDSpecific(p_CellId);
    f_UTRAN_CPHY_RL_Setup(cas_AichInfo(p_CellId,                // AICH
                                       tsc_AICH1,
                                       cs_AICH_Info,
                                       v_CellInfoFDD.powerAICH));
    
    f_UTRAN_CPHY_RL_Setup(cas_PRACH_Info_FDD(p_CellId,          // PRACH
                                             tsc_PRACH1,
                                             tsc_PRACH1_Signatures,
                                             tsc_PRACH1_ScrC,
                                             f_UTRAN_CellInfo_GetPuncturingLimit(p_CellId),
                                             f_UTRAN_CellInfo_GetSF_PRACH(p_CellId),
                                             tsc_SubChNum));
    
    f_UTRAN_CPHY_TrCH_Config(cas_RACH_InfoActNow_FDDr99(p_CellId, tsc_PRACH1));   // connectRACH  to PRACH
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(p_CellId,                            // mapping CCCH to RACH.
                                             tsc_PRACH1,
                                             cs_UE_Info,
                                             cs_TrChInfoRACH1_FDDr99,
                                             cs_TrLogMappingRACH2));
  };

  /*
   * @desc      To configure AICH and PRACH physical channels and connect RACH onto PRACH, then map one logical channel (CCCH) to RACH
   *            All releases are handled
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RACH_CCCH_Cfg(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    if (v_FDD_TDD_Mode==UTRAN_FDD) {
      select (v_FddTddMessageClass) {
        case (FDDr5,FDDr99) {
          f_UTRAN34_SS_RACH_CCCH_Cfg_r99(p_CellId);
        }
        case else {
          f_UTRAN_SS_RACH_CCCH_Cfg(p_CellId);
        }
      }
    } else {
      // UTRAN TDD
      f_UTRAN_SS_RACH_CCCH_Cfg(p_CellId);
    }
  };

  /*
   * @desc      To configure MIMO
   *            P-CCPCH, P-SCH, S-SCH and P-CPICH physical channels. To map BCH to P-PCCPCH, then to map logical channel BCCH to transport channel BCH.
   *            To configure P-CCPCH physical channels and map BCH to P-PCCPCH, then to map logical channel BCCH to transport channel BCH.
   * @param     p_CellId
   * @param     p_HSPA_Parameters
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_BCH_SCH_2CPICH_Cfg(UTRAN_CellId_Type p_CellId,
                                            UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type_FDD v_CellInfoFDD;

    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      v_CellInfoFDD := f_UTRAN_CellInfo_GetFDDSpecific(p_CellId);
      f_UTRAN_CPHY_RL_Setup(cas_PCPICH_Info_FDD(p_CellId, v_CellInfoFDD.powerpCPICH, antenna2sCPICH, -, false));    // p-CPICH with MIMO
      f_UTRAN_CPHY_RL_Setup(cas_SCPICH_Info_MIMO(p_CellId, v_CellInfoFDD.powerpCPICH, p_HSPA_Parameters.s_CPICH_ChCode));    // s-CPICH
      f_UTRAN_CPHY_RL_Setup(cas_PSCH_Info_FDD(p_CellId, v_CellInfoFDD.powerpSCH));      // p-SCH
      f_UTRAN_CPHY_RL_Setup(cas_SSCH_Info_FDD(p_CellId, v_CellInfoFDD.powersSCH));      // s-SCH
      f_UTRAN_CPHY_RL_Setup(cas_PCCPCH_Info_FDD(p_CellId, f_UTRAN_CellInfo_GetpCCPCH_Power_FDD(p_CellId)));    // p-CCPCH
      
      f_UTRAN_CPHY_TrCH_Config(cas_BCH_InfoActNow_FDD(p_CellId));   // BCH connected to p-CCPCH
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(p_CellId,            // mapping BCCH to BCH. C-RNTI and U-RNTI are not needed on P-CCPCH
                                               tsc_P_CCPCH,
                                               cs_UE_Info,
                                               cs_TrChInfoBCH1_FDD,
                                               cs_TrLogMappingBCH1));
    }
    else { // MIMO not used in TDD
    }
  }

  /*
   * @desc      To configure physical channel DPCH1and connect DCH5 to the physical channel,then map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs.
   *            The transport channel DCH5 carries only dedicated control channels.
   *            MAC-d  is configured with cellId -1 (utran_CellDedicated).
   *            R99 function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg_r99(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    
    f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDDr99(p_CellId,
                                                       tsc_DL_DPCH1,
                                                       cs_DL_DPCH_SRB_StandAloneDPCH_FDDr99(tsc_DL_DPCH1_2ndScrC),
                                                       cs_ActivateNow));
    f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_DL_Info_FDD(p_CellId,tsc_DL_DPCH1));
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                             tsc_DL_DPCH1,
                                             cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                             cs_TrChInfoDL_13_6_StandAlone_FDD,
                                             cs_TrLogMappingDL_4DCCH));
    f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDDr99(p_CellId,
                                                       tsc_UL_DPCH1,
                                                       cs_UL_DPCH_13_6_StandAlone_FDDr99(v_UL_ScramCodeFDD),
                                                       cs_ActivateNow));
    
    f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_UL_InfoActNow_FDD(p_CellId, tsc_UL_DPCH1));
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                             tsc_UL_DPCH1,
                                             cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                             cs_TrChInfoUL_13_6_StandAlone_FDD,
                                             cs_TrLogMappingUL_4DCCH));
  }

  /*
   * @desc      Configure physical channel DPCH1 and connect DCH5 to the physical channel. Map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg_r4(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_TDDr4(p_CellId,
                                                      tsc_DL_DPCH1,
                                                      cs_DL_DPCH_SRB_StandAlone_TDDr4,
                                                      cs_ActivateNow));
    f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_DL_InfoActNow_TDD(p_CellId,tsc_DL_DPCH1));  // @sic R5s120750 sic@
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                             tsc_DL_DPCH1,
                                             cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                             cs_TrChInfoDL_3_4_StandAlone_TDD,   // @sic R5s120750 sic@
                                             cs_TrLogMappingDL_4DCCH_TDD));
    f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_TDDr4(p_CellId,
                                                      tsc_UL_DPCH1,
                                                      cs_UL_DPCH_3_4_StandAlone_TDDr4,
                                                      cs_ActivateNow));
    
    f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_UL_InfoActNow_TDD(p_CellId, tsc_UL_DPCH1)); // @sic r5s120750 sic@
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                             tsc_UL_DPCH1,
                                             cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                             cs_TrChInfoUL_3_4_StandAlone_TDD, // @sic r5s120750 sic@
                                             cs_TrLogMappingUL_4DCCH_TDD));
  }

  /*
   * @desc      To configure physical channel DPCH1and connect DCH5 to the physical channel,then map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs.
   *            The transport channel DCH5 carries only dedicated control channels.
   *            MAC-d  is configured with cellId -1 (utran_CellDedicated).
   *            Rel-5 function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg_r5(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDDr5(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_SRB_StandAloneDPCH_FDDr5(tsc_DL_DPCH1_2ndScrC),
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_DL_Info_FDD(p_CellId,tsc_DL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingDL_4DCCH));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDDr5(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_13_6_StandAlone_FDDr5(v_UL_ScramCodeFDD),
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_UL_InfoActNow_FDD(p_CellId, tsc_UL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingUL_4DCCH));
    }
    else {//UTRAN_TDD
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_TDDr5(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_SRB_StandAlone_TDDr5,
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_DL_InfoActNow_TDD(p_CellId,tsc_DL_DPCH1));  // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_3_4_StandAlone_TDD,   // @sic r5s120750 sic@
                                               cs_TrLogMappingDL_4DCCH_TDD));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_TDDr5(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_3_4_StandAlone_TDDr5,
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_UL_InfoActNow_TDD(p_CellId, tsc_UL_DPCH1)); // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_3_4_StandAlone_TDD, // @sic r5s120750 sic@
                                               cs_TrLogMappingUL_4DCCH_TDD));
    }
  }

  /*
   * @desc      To configure physical channel DPCH1and connect DCH5 to the physical channel,then map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs.
   *            The transport channel DCH5 carries only dedicated control channels.
   *            MAC-d  is configured with cellId -1 (utran_CellDedicated).
   *            Rel-6 function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg_r6(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDDr6(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_SRB_StandAloneDPCH_FDDr6(tsc_DL_DPCH1_2ndScrC),
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_DL_Info_FDD(p_CellId,tsc_DL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingDL_4DCCH));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDDr6(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_13_6_StandAlone_FDDr6(v_UL_ScramCodeFDD),
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_UL_InfoActNow_FDD(p_CellId, tsc_UL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingUL_4DCCH));
    }
    else {//UTRAN_TDD
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_TDDr6(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_SRB_StandAlone_TDDr6,
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_DL_InfoActNow_TDD(p_CellId,tsc_DL_DPCH1));  // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_3_4_StandAlone_TDD,   // @sic r5s120750 sic@
                                               cs_TrLogMappingDL_4DCCH_TDD));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_TDDr6(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_3_4_StandAlone_TDDr6,
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_UL_InfoActNow_TDD(p_CellId, tsc_UL_DPCH1)); // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_3_4_StandAlone_TDD, // @sic r5s120750 sic@
                                               cs_TrLogMappingUL_4DCCH_TDD));
    }
  };

  /*
   * @desc      To configure physical channel DPCH1and connect DCH5 to the physical channel,then map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs.
   *            The transport channel DCH5 carries only dedicated control channels.
   *            MAC-d  is configured with cellId -1 (utran_CellDedicated).
   *            Rel-7 function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg_r7(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDDr7(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_SRB_StandAloneDPCH_FDDr7(tsc_DL_DPCH1_2ndScrC),
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_DL_Info_FDD(p_CellId,tsc_DL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingDL_4DCCH));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDDr7(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_13_6_StandAlone_FDDr7(v_UL_ScramCodeFDD),
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_10_UL_InfoActNow_FDD(p_CellId, tsc_UL_DPCH1));
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_13_6_StandAlone_FDD,
                                               cs_TrLogMappingUL_4DCCH));
    }
    else {//UTRAN_TDD
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_TDDr7(p_CellId,
                                                        tsc_DL_DPCH1,
                                                        cs_DL_DPCH_Info_TDDr7,
                                                        cs_ActivateNow));
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_DL_InfoActNow_TDD(p_CellId,tsc_DL_DPCH1));  // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_DL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoDL_3_4_StandAlone_TDD,   // @sic r5s120750 sic@
                                               cs_TrLogMappingDL_4DCCH_TDD));
      f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_TDDr7(p_CellId,
                                                        tsc_UL_DPCH1,
                                                        cs_UL_DPCH_3_4_StandAlone_TDD,
                                                        cs_ActivateNow));
      
      f_UTRAN_CPHY_TrCH_Config(cas_DCH_148_TTI_40_UL_InfoActNow_TDD(p_CellId, tsc_UL_DPCH1)); // @sic r5s120750 sic@
      
      f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                               tsc_UL_DPCH1,
                                               cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                               cs_TrChInfoUL_3_4_StandAlone_TDD, // @sic r5s120750 sic@
                                               cs_TrLogMappingUL_4DCCH_TDD));
    }
  }

  /*
   * @desc      To configure physical channel DPCH1and connect DCH5 to the physical channel,then map DCCH1-4 on to the DCH5 transport channel.
   *            Used for setting up stand-alone UL:13.6 DL:13.6 kbps SRBs.
   *            The transport channel DCH5 carries only dedicated control channels.
   *            MAC-d  is configured with cellId -1 (utran_CellDedicated).
   *            All releases function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_1DCH_DCCH_Cfg(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      select (v_FddTddMessageClass) {
        case (FDDr99) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r99(p_CellId);
        }
        case (FDDr5) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r5(p_CellId);
        }
        case (FDDr6) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r6(p_CellId);
        }
        case (FDDr7) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r7(p_CellId);
        }
        case (FDDr8, FDDr9) {
          f_UTRAN_SS_1DCH_DCCH_Cfg(p_CellId);
        }
        case (FDDr10) {
          f_UTRAN_SS_1DCH_DCCH_Cfg_r10(p_CellId);
        }
        case (FDDr11, FDDr12, FDDr14, FDDr16) {/* @sic R5s150330 BASELINE MOVING 2015 - R5-176156 sic@ */
          f_UTRAN_SS_1DCH_DCCH_Cfg_r11(p_CellId);
        }
        case else {
          // Rel-13 and later
          FatalError(__FILE__, __LINE__, "Not a valid FDD release");
        }
      }
    }
    else { //UTRA TDD
      select (v_FddTddMessageClass) {
        case (TDDr4) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r4(p_CellId);
        }
        case (TDDr5) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r5(p_CellId);
        }
        case (TDDr7) {
          f_UTRAN34_SS_1DCH_DCCH_Cfg_r7(p_CellId);
        }
        case (TDDr9, TDDr10, TDDr11, TDDr12, TDDr14) {/* @sic R5s150330 BASELINE MOVING 2015 - R5-176156 sic@ */
          f_UTRAN_SS_1DCH_DCCH_Cfg(p_CellId);
        }
        case else {
          // Rel-13 and later
        }
      }
    }
  }

  /*
   * @desc      To setup radio bearers :
   *            RB0 (the downlink is UM + CCCH + FACH + sCCPCH1 and uplink is TM + CCCH + RACH + PRACH).
   *            The configuration is  adapted from 34.108  cl. 6.10.2.4.3 and 6.10.2.4.4
   *            R99 function
   * @param     p_CellId
   * @param     p_PayloadSize
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB0_Cfg_r99(UTRAN_CellId_Type p_CellId,
                                    template (omit) integer p_PayloadSize) runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_DL := cs_RB_LogCH_Mapping(omit, tsc_DL_CCCH5);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_UL := cs_RB_LogCH_Mapping(tsc_UL_CCCH5, omit);
    
    f_UTRAN_CRLC_Config(cas_RB_UM_DL_Info_FDD(p_CellId,   // configure radio bearers (downlink): RB0 (UM + CCCH + FACH)
                                              tsc_RB0,
                                              v_RB_LogCH_Mapping_DL));
    f_UTRAN_CRLC_Config(cas_RB_TM_UL_Info_FDDr99(p_CellId,  // cofigure radio bearers (uplink): RB0 (TM + CCCH + RACH)
                                                 tsc_RB0,
                                                 p_PayloadSize,
                                                 v_RB_LogCH_Mapping_UL));
  }

  /*
   * @desc      Setup radio bearer RB0 (the downlink is UM + CCCH + FACH + sCCPCH1 and uplink is TM + CCCH + RACH + PRACH).
   *            The configuration is  adapted from 34.108  cl. 6.10.2.4.3 and 6.10.2.4.4
   * @param     p_CellId
   * @param     p_PayloadSize
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB0_Cfg_r4(UTRAN_CellId_Type p_CellId,
                                   template (omit) integer p_PayloadSize) runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_DL := cs_RB_LogCH_Mapping(omit, tsc_DL_CCCH5);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_UL := cs_RB_LogCH_Mapping(tsc_UL_CCCH5, omit);
    
    f_UTRAN_CRLC_Config(cas_RB_UM_DL_Info_TDD(p_CellId,   // configure radio bearers (downlink): RB0 (UM + CCCH + FACH)
                                              tsc_RB0,
                                              v_RB_LogCH_Mapping_DL));
    f_UTRAN_CRLC_Config(cas_RB_TM_UL_Info_TDDr4(p_CellId,  // cofigure radio bearers (uplink): RB0 (TM + CCCH + RACH)
                                                tsc_RB0,
                                                p_PayloadSize,
                                                v_RB_LogCH_Mapping_UL));
  }

  /*
   * @desc      To setup radio bearers :
   *            RB0 (the downlink is UM + CCCH + FACH + sCCPCH1 and uplink is TM + CCCH + RACH + PRACH).
   *            The configuration is  adapted from 34.108  cl. 6.10.2.4.3 and 6.10.2.4.4
   *            All releases function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB0_Cfg(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    if (v_FDD_TDD_Mode==UTRAN_FDD) {
      // UTRAN FDD
      select (v_FddTddMessageClass) {
        case (FDDr99, FDDr5) {
          f_UTRAN34_SS_RB0_Cfg_r99 (p_CellId, 166);
        }
        case (FDDr6,FDDr7) {
          f_UTRAN34_SS_RB0_Cfg_r99 (p_CellId, 238);
        }
        case else {
          f_UTRAN_SS_RB0_Cfg (p_CellId);
        }
      }
    } else {
      select (v_FddTddMessageClass) {
        case (TDDr4, TDDr5) {
          f_UTRAN34_SS_RB0_Cfg_r4 (p_CellId, 166);
        }
        case (TDDr7) {
          f_UTRAN34_SS_RB0_Cfg_r4 (p_CellId, 238);
        }
        case else {
          f_UTRAN_SS_RB0_Cfg (p_CellId);
        }
      }
    }
  }

  /*
   * @desc      To setup radio bearers :  RB1, RB2, RB3, RB4. default values from 34.123-1
   *            CRLC is configured with cellId -1 (utran_CellDedicated)
   *            R99 function
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB1_ToRB4_Cfg_r99() runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB1 := cs_RB_LogCH_Mapping(tsc_UL_DCCH1, tsc_DL_DCCH1);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB2 := cs_RB_LogCH_Mapping(tsc_UL_DCCH2, tsc_DL_DCCH2);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB3 := cs_RB_LogCH_Mapping(tsc_UL_DCCH3, tsc_DL_DCCH3);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB4 := cs_RB_LogCH_Mapping(tsc_UL_DCCH4, tsc_DL_DCCH4);
    
    f_UTRAN_CRLC_Config(cas_RB_UM_Info_FDDr99(utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH)
                                              tsc_RB1,
                                              v_RB_LogCH_Mapping_RB1));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,   // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                  tsc_RB2,
                                                  v_RB_LogCH_Mapping_RB2,
                                                  128));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,  // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                  tsc_RB3,
                                                  v_RB_LogCH_Mapping_RB3,
                                                  128));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,  // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                  tsc_RB4,
                                                  v_RB_LogCH_Mapping_RB4,
                                                  128));
  }

  /*
   * @desc      To setup radio bearers :  RB1, RB2, RB3, RB4
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB1_ToRB4_Cfg_r4() runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB1 := cs_RB_LogCH_Mapping(tsc_UL_DCCH1, tsc_DL_DCCH1);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB2 := cs_RB_LogCH_Mapping(tsc_UL_DCCH2, tsc_DL_DCCH2);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB3 := cs_RB_LogCH_Mapping(tsc_UL_DCCH3, tsc_DL_DCCH3);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB4 := cs_RB_LogCH_Mapping(tsc_UL_DCCH4, tsc_DL_DCCH4);
    
    f_UTRAN_CRLC_Config(cas_RB_UM_Info_TDDr4(utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH)
                                             tsc_RB1,
                                             v_RB_LogCH_Mapping_RB1));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,   // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                 tsc_RB2,
                                                 v_RB_LogCH_Mapping_RB2,
                                                 128));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,  // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                 tsc_RB3,
                                                 v_RB_LogCH_Mapping_RB3,
                                                 128));
    
    f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,  // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                 tsc_RB4,
                                                 v_RB_LogCH_Mapping_RB4,
                                                 128));
  }

  /*
   * @desc      To setup radio bearers :  RB1, RB2, RB3, RB4. default values from 34.123-1
   *            CRLC is configured with cellId -1 (utran_CellDedicated)
   *            Rel-5 function
   * @param     p_FDD_TDD
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB1_ToRB4_Cfg_r5(UTRAN_FDD_TDD_Type p_FDD_TDD) runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB1 := cs_RB_LogCH_Mapping(tsc_UL_DCCH1, tsc_DL_DCCH1);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB2 := cs_RB_LogCH_Mapping(tsc_UL_DCCH2, tsc_DL_DCCH2);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB3 := cs_RB_LogCH_Mapping(tsc_UL_DCCH3, tsc_DL_DCCH3);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB4 := cs_RB_LogCH_Mapping(tsc_UL_DCCH4, tsc_DL_DCCH4);
    
    if (p_FDD_TDD == UTRAN_FDD) {
        f_UTRAN_CRLC_Config(cads_RB_UM_Info_FDDr5 (utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH)
                                                   tsc_RB1,
                                                   v_RB_LogCH_Mapping_RB1));
        
        f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,   // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                      tsc_RB2,
                                                      v_RB_LogCH_Mapping_RB2,
                                                      128));
        
        f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,  // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                      tsc_RB3,
                                                      v_RB_LogCH_Mapping_RB3,
                                                      128));
        
        f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_FDDr99(utran_CellDedicated,  // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                      tsc_RB4,
                                                      v_RB_LogCH_Mapping_RB4,
                                                      128));
    }
    else {//UTRA TDD
      f_UTRAN_CRLC_Config(cads_RB_UM_Info_TDDr5 (utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH)
                                                 tsc_RB1,
                                                 v_RB_LogCH_Mapping_RB1));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,   // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                   tsc_RB2,
                                                   v_RB_LogCH_Mapping_RB2,
                                                   128));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,  // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                   tsc_RB3,
                                                   v_RB_LogCH_Mapping_RB3,
                                                   128));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_TDDr4(utran_CellDedicated,  // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                   tsc_RB4,
                                                   v_RB_LogCH_Mapping_RB4,
                                                   128));
    }
  }

  /*
   * @desc      To setup radio bearers :  RB1, RB2, RB3, RB4. default values from 34.123-1
   *            CRLC is configured with cellId -1 (utran_CellDedicated)
   *            Rel-7 function
   * @param     p_FDD_TDD
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB1_ToRB4_Cfg_r7(UTRAN_FDD_TDD_Type p_FDD_TDD) runs on UTRAN_PTC
  {
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB1 := cs_RB_LogCH_Mapping(tsc_UL_DCCH1, tsc_DL_DCCH1);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB2 := cs_RB_LogCH_Mapping(tsc_UL_DCCH2, tsc_DL_DCCH2);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB3 := cs_RB_LogCH_Mapping(tsc_UL_DCCH3, tsc_DL_DCCH3);
    var template (value) RB_LogCH_Mapping v_RB_LogCH_Mapping_RB4 := cs_RB_LogCH_Mapping(tsc_UL_DCCH4, tsc_DL_DCCH4);
    
    if (p_FDD_TDD == UTRAN_FDD) {
      f_UTRAN_CRLC_Config(cads_RB_UM_Info_FDDr5(utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH)
                                                tsc_RB1,
                                                v_RB_LogCH_Mapping_RB1));
        
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_FDDr7(utran_CellDedicated,   // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB2,
                                                         v_RB_LogCH_Mapping_RB2,
                                                         cs_OctetModeRLC_Size144));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_FDDr7(utran_CellDedicated,  // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB3,
                                                         v_RB_LogCH_Mapping_RB3,
                                                         cs_OctetModeRLC_Size144));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_FDDr7(utran_CellDedicated,  // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB4,
                                                         v_RB_LogCH_Mapping_RB4,
                                                         cs_OctetModeRLC_Size144));
    }
    else {//UTRA TDD
      f_UTRAN_CRLC_Config(cads_RB_UM_Info_TDDr5(utran_CellDedicated, // configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH) @sic R5s120405 sic@
                                                tsc_RB1,
                                                v_RB_LogCH_Mapping_RB1));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_TDDr7(utran_CellDedicated, // configure radio bearers: RB2 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB2,
                                                         v_RB_LogCH_Mapping_RB2,
                                                         cs_OctetModeRLC_Size144));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_TDDr7(utran_CellDedicated,   // configure radio bearers: RB3 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB3,
                                                         v_RB_LogCH_Mapping_RB3,
                                                         cs_OctetModeRLC_Size144));
      
      f_UTRAN_CRLC_Config(cas_RB_AM_Info_SRB_Fixed_TDDr7(utran_CellDedicated,   // configure radio bearers: RB4 (AM + DCCH) and (AM + DCCH)
                                                         tsc_RB4,
                                                         v_RB_LogCH_Mapping_RB4,
                                                         cs_OctetModeRLC_Size144));//UTRAN_TDD
    }
  }

  /*
   * @desc      To setup radio bearers :  RB1, RB2, RB3, RB4. default values from 34.123-1
   *            CRLC is configured with cellId -1 (utran_CellDedicated)
   *            All releases function
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_RB1_ToRB4_Cfg(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    if (v_FDD_TDD_Mode==UTRAN_FDD) {
      select (v_FddTddMessageClass) {
        case (FDDr99) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r99();
        }
        case (FDDr5, FDDr6) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r5(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case (FDDr7) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r7(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case (FDDr8, FDDr9, FDDr10, FDDr11, FDDr12, FDDr14, FDDr16) { /* @sic R5s150330 BASELINE MOVING 2015 - R5-176156 sic@ */
          f_UTRAN_SS_RB1_ToRB4_Cfg(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case else {
          FatalError(__FILE__, __LINE__, "Not a valid FDD release");
        }
      }
    }
    else {//UTRA TDD
      select (v_FddTddMessageClass) {
        case (TDDr4) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r4();
        }
        case (TDDr5) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r5(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case (TDDr7) {
          f_UTRAN34_SS_RB1_ToRB4_Cfg_r7(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case (TDDr9, TDDr10, TDDr11, TDDr12, TDDr14) { /* @sic R5s150330 BASELINE MOVING 2015 - R5-176156 sic@ */
          f_UTRAN_SS_RB1_ToRB4_Cfg(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
        case else {
          f_UTRAN_SS_RB1_ToRB4_Cfg(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
        }
      }
    }
  }

  /*
   * @desc      To restart CRLC for the next RRC connection
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_RestartCRLC_ForNextConnection(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    
    select (v_CellConfig) {
      case (cell_DCH_StandAloneSRB) {
        f_UTRAN34_CRLC_RelReconfSRB(p_CellId);
        f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_StandAloneSRB_NoConn);
      }
      case (cell_FACH, cell_FACH_PS) {  //@sic R5s170071 sic@
        f_UTRAN34_CRLC_RelReconfSRB(p_CellId);
        f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_FACH_NoConn);
      }
      case (cell_DCH_Speech,
            cell_DCH_64kPS_RAB_SRB,
            cell_DCH_64kPS_AM_RAB, //@sic R5s140400 sic@
            cell_Four_DTCH_PS_CS,
            cell_DCH_2AM_PS,       //@sic R5s140387 sic@
            cell_DCH_3AM_PS) {    //@sic R5s150283 sic@
        f_UTRAN34_SS_ReconfRAB_ToSRB(p_CellId);
        f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_StandAloneSRB_NoConn);
      }
      case (cell_DCH_E_HS,
            cell_E_HS,
            cell_DCH_HS_DSCH) {
        f_UTRAN34_SS_ReconfRAB_ToSRB(p_CellId);
        f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_StandAloneSRB_NoConn);
      }
      case else {
        FatalError(__FILE__, __LINE__, "invalid configuration");
      }
    }
  }

  /*
   * @desc      To release RLC counter sequence number for SRB 1 to 4, by  first releasing them and  then setting them up again.
   *            This step is used only in conjonction with the RRC Connestion Release step.
   *            The configuration for SRBs 1 to 4 is the same as the one used for cell_DCH and cell_FACH.
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_CRLC_RelReconfSRB(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB1, f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB2, f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB3, f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB4, f_UTRAN_CellInfo_GetFDD_TDD(p_CellId));
    f_UTRAN34_SS_RB1_ToRB4_Cfg(p_CellId);
  }

  /*
   * @desc      The first UTRAN cell created  is configured with Tcell value 0.
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function fl_UTRAN34_CheckFirstCellCreated(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_CellIdList_Type v_CellIdList := {utran34_Cell1, utran34_Cell2, utran34_Cell3, utran34_Cell4, utran34_Cell5, utran34_Cell6, utran34_Cell7, utran34_Cell8};
    var integer v_Cnt := f_UTRAN_NoOfConfiguredCells_Common(v_CellIdList);
    
    if (v_Cnt == 0) {
      //The first cell configured shall use Tcell=0
      f_UTRAN_CellInfo_SetTCell(p_CellId, 0);
    }
  }

  /*
   * @desc      To setup the cell parameter in CPHY, if the cell 'p_CellId' is the first one to be created, then CPHY shall be initialised using CHY_INIT_REquest ASP.
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_CellCfg(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type_FDD v_CellInfoFDD;
    
    if (f_UTRAN_NoOfConfiguredCells() == 0) {        // first cell to be created
      U_CPHY.send(cas_InitReqDef);
      U_CPHY.receive(car_IniCnf);
    }
    fl_UTRAN34_CheckFirstCellCreated (p_CellId);  //@sic R5-142973 sic@
    v_CellInfoFDD := f_UTRAN_CellInfo_GetFDDSpecific(p_CellId);
    
    U_CPHY.send(cas_CellCfgReq_FDD(p_CellId,
                                   f_UTRAN34_CellInfo_GetTcell (p_CellId),
                                   f_UTRAN_CellInfo_GetFrequencyInfo(p_CellId),
                                   v_CellInfoFDD.priScrmCode,
                                   tsc_AttenuationCellOFF,  // start with the cell switched off
                                   f_UTRAN_CellInfo_GetSFNOffset(p_CellId),
                                   f_UTRAN_CellInfo_GetCellTxPower(p_CellId),
                                   v_CellInfoFDD.operationBand));
    U_CPHY.receive(car_CellCfgCnf(p_CellId));
  }

  /*
   * @desc      To reconfigure the RAB to SRBs
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_ReconfRAB_ToSRB(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    f_UTRAN_SS_RelDPCH(p_CellId);
    f_UTRAN34_SS_1DCH_DCCH_Cfg(p_CellId);
    f_UTRAN34_SS_RB1_ToRB4_Cfg(p_CellId);
  }

  /*
   * @desc      This test Step sets up a cell with stand-alone UL:3.4 DL:3.4 kbps SRBs for DCCH which consists of the following:
   *            For a first cell:
   *             physical channels: p-SCH, s-SCH, p-CPICH,  p-CCPCH, s-CCPCH, PRACH and DPCH;
   *             transport channesl: BCH, FACH, PCH, RACH, DCH;
   *             logical channels: BCCH, CCCH, PCCH, DCCH; and
   *             signalling radio bearer RB0 on FACH and RACH; signalling bearer RB1, RB2, RB3, RB4  on DCH.
   *
   *            For cells other than the first cell
   *             physical channels: p-SCH, s-SCH, p-CPICH,  p-CCPCH, s-CCPCH, PRACH (no DPCH)
   *             transport channesl: BCH, FACH, PCH, RACH (no DCH)
   *             logical channels: BCCH, CCCH, PCCH (no DCCH)
   *             signalling radio bearer RB0 on FACH and RACH (not RB1 RB2 RB3 RB4 on DCH)
   *
   *            Cell configuration supporting UL:3.4 DL:3.4 kbps stand-alone signalling RB.
   *            CRLC is configured with cellId -1 (utran_CellDedicated)
   *            CMAC for DCCH (MAC-d)  is configured with cellId -1 (utran_CellDedicated).
   * @param     p_CellId
   * @param     p_HSPA_Parameters   (default value: cs_HSPA_Parameters_Def)
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SS_CreateCellDCH(UTRAN_CellId_Type p_CellId,
                                      template (value) UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters := cs_HSPA_Parameters_Def)
    runs on UTRAN_PTC
  {
    var UTRAN34_HSPA_Parameters_Type v_HSPA_Parameters := valueof(p_HSPA_Parameters);

    f_UTRAN34_SS_CellCfg(p_CellId);
    if (v_HSPA_Parameters.mimo) {
      f_UTRAN34_SS_BCH_SCH_2CPICH_Cfg(p_CellId, v_HSPA_Parameters);
    } else {
      f_UTRAN_SS_BCH_SCH_CPICH_Cfg(p_CellId);
    }
    f_UTRAN_SS_PCH_FACH_CCCH_Cfg(p_CellId);
    f_UTRAN34_SS_RACH_CCCH_Cfg(p_CellId);
    if (f_UTRAN_NoOfConfiguredCells() == 0) {        // first cell to be created
      // Configure DPCH
      f_UTRAN34_SS_1DCH_DCCH_Cfg(p_CellId);
      f_UTRAN_SS_RB_BCCH_BCH_Cfg(p_CellId);
      f_UTRAN_SS_RB_PCCH_Cfg(p_CellId);
      f_UTRAN34_SS_RB0_Cfg(p_CellId);
      f_UTRAN34_SS_RB1_ToRB4_Cfg(p_CellId);
      f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_StandAloneSRB_NoConn);
    } else {                                     // further cell to be created
      f_UTRAN_SS_RB_BCCH_BCH_Cfg(p_CellId);
      f_UTRAN_SS_RB_PCCH_Cfg(p_CellId);
      f_UTRAN34_SS_RB0_Cfg(p_CellId);
      f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_NoDPCH);
    }
  }

  /*
   * @desc      To Activate ciphering for DL in the SS
   * @param     p_CellId
   * @param     p_CipherActTime
   * @return    template (value) RB_ActivationTimeInfoList
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_ActivateCiphering_DL_SS(UTRAN_CellId_Type p_CellId,
                                             ActivationTime    p_CipherActTime) runs on UTRAN_PTC
    return template (value) RB_ActivationTimeInfoList
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    var template (value) RB_ActivationTimeInfoList v_RB_ActivationTimeInfoList;
    var RLC_SequenceNumber  v_RLC_SN_RB1;
    var RLC_SequenceNumber  v_RLC_SN_RB2;
    var RLC_SequenceNumber  v_RLC_SN_RB3;
    var RLC_SequenceNumber  v_RLC_SN_RB4;
    var RLC_SequenceNumber  v_RLC_SN_RAB;
    
    v_RLC_SN_RB1  := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB1);
    v_RLC_SN_RB2  := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB2);
    v_RLC_SN_RB3  := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB3);
    v_RLC_SN_RB4  := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB4);
    
    f_UTRAN_CRLC_Suspend(tsc_RB1, v_RLC_SN_RB1);
    f_UTRAN_CRLC_Suspend(tsc_RB3, v_RLC_SN_RB3);
    f_UTRAN_CRLC_Suspend(tsc_RB4, v_RLC_SN_RB4);
    
    f_UTRAN_CRLC_CipheringActivate(cas_CRLC_DL_CipherActReq_FDD_r99(utran_CellDedicated,
                                                                    v_SecurityInfo.recentSecureDomain,
                                                                    tsc_RB1,
                                                                    v_SecurityInfo.dL_CipherMode_r99,
                                                                    v_RLC_SN_RB1,
                                                                    notInc));
    f_UTRAN_CRLC_CipheringActivate(cas_CRLC_DL_CipherActReq_FDD_r99(utran_CellDedicated,
                                                                    v_SecurityInfo.recentSecureDomain,
                                                                    tsc_RB2,
                                                                    v_SecurityInfo.dL_CipherMode_r99,
                                                                    v_RLC_SN_RB2 + 2,
                                                                    notInc));
    f_UTRAN_CRLC_CipheringActivate(cas_CRLC_DL_CipherActReq_FDD_r99(utran_CellDedicated,
                                                                    v_SecurityInfo.recentSecureDomain,
                                                                    tsc_RB3,
                                                                    v_SecurityInfo.dL_CipherMode_r99,
                                                                    v_RLC_SN_RB3,
                                                                    notInc));
    f_UTRAN_CRLC_CipheringActivate(cas_CRLC_DL_CipherActReq_FDD_r99(utran_CellDedicated,
                                                                    v_SecurityInfo.recentSecureDomain,
                                                                    tsc_RB4,
                                                                    v_SecurityInfo.dL_CipherMode_r99,
                                                                    v_RLC_SN_RB4,
                                                                    notInc));
    
    v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoListSRBs(v_RLC_SN_RB1,
                                                             v_RLC_SN_RB2 + 2,
                                                             v_RLC_SN_RB3,
                                                             v_RLC_SN_RB4);
    if (v_SecurityInfo.recentSecureDomain == ps_domain) {
      select (v_CellConfig) {
        case (cell_DCH_64kPS_RAB_SRB) {
          v_RLC_SN_RAB := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB20);
          v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoListSRBs_20(v_RLC_SN_RB1,
                                                                      v_RLC_SN_RB2 + 2,
                                                                      v_RLC_SN_RB3,
                                                                      v_RLC_SN_RB4,
                                                                      v_RLC_SN_RAB);
          f_UTRAN_CRLC_DL_CipherCfgRB(p_CellId, v_SecurityInfo.recentSecureDomain, v_SecurityInfo.dL_CipherMode, v_CellConfig, true);
        }
        case (cell_DCH_64kPS_AM_RAB) { //@sic R5s140400 sic@
          v_RLC_SN_RAB := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB22);
          v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoListSRBs_20(v_RLC_SN_RB1,
                                                                      v_RLC_SN_RB2 + 2,
                                                                      v_RLC_SN_RB3,
                                                                      v_RLC_SN_RB4,
                                                                      v_RLC_SN_RAB);
          f_UTRAN_CRLC_DL_CipherCfgRB(p_CellId, v_SecurityInfo.recentSecureDomain, v_SecurityInfo.dL_CipherMode, v_CellConfig, true);
        }
        case (cell_DCH_E_HS, cell_E_HS) {
          v_RLC_SN_RAB := f_UTRAN_CRLC_SequenceNumber_GetCount_C_LSB_DL(tsc_RB25);
          v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoListSRBs_25(v_RLC_SN_RB1,
                                                                      v_RLC_SN_RB2 + 2,
                                                                      v_RLC_SN_RB3,
                                                                      v_RLC_SN_RB4,
                                                                      v_RLC_SN_RAB);
          f_UTRAN_CRLC_DL_CipherCfgRB(p_CellId, v_SecurityInfo.recentSecureDomain, v_SecurityInfo.dL_CipherMode, v_CellConfig, true);
        }
      }
    }
    f_UTRAN_CMAC_CipherCfg(p_CellId, p_CipherActTime, v_SecurityInfo.dL_CipherMode, incPerCFN_Cycle);
    return (v_RB_ActivationTimeInfoList);
  }

}
