  const DDI                         tsc_E_DCH_DDI_5 := 5;                        /* @status    APPROVED (LTE_IRAT, UTRAN) */

  const B8_Type                     tsc_RAB_DefPS_HS := '00000101'B;             /* Default RAB Id for HS AM DTCH for PS domain
                                                                                    @status    APPROVED (LTE_IRAT, UTRAN) */

