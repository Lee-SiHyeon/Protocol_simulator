module NR_CellInfoInit_ENDC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from CommonDefs all;
  import from ENDC_CommonFrequencyFunctions all;
  import from NR_FrequencyCommon all;
  import from NR_FrequencyHighestBandwidth all;
  import from NR_FrequencyInitIntraBandC_ENDC all;
  import from NR_FrequencyInitIntraBandNC_ENDC all;
  import from NR_FrequencyInit_SA all;
  import from NR_HighestFrequencyInitIntraBandC_ENDC all;
  import from NR_HighestFrequencyInitIntraBandNC_ENDC all;
  import from TestcaseProperties all;

  /*
   * @desc      Common function to retrieve NRf1 to NRf4 on NR Primary/Secondary ENDC band
   * @param     p_ENDC_BandCombination
   * @return    template (value) NR_Frequencyf1tof4_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_ENDC_NR_Init_Frequency(ENDC_BandCombination_Type p_ENDC_BandCombination) return template (value) NR_Frequencyf1tof4_Type
  { //@sic R5-190669 sic@
    var template (value) NR_Frequencyf1tof4_Type v_NR_Frequencyf1Tof4 := cs_NR_Frequencyf1tof4_Dummy;
    var FreqBandIndicatorNR v_NR_Band := f_ENDC_GetNR_Band(p_ENDC_BandCombination);
    var ENDC_CombinationType_Type v_ENDC_CombinationType := f_ENDC_GetCombinationType(p_ENDC_BandCombination); //@sic R5-187752 adding IntraBand combination sic@
    
    v_NR_Frequencyf1Tof4 := f_NR_GetFrequencyENDC_f1Tof4(v_NR_Band, v_ENDC_CombinationType);
    return v_NR_Frequencyf1Tof4;
  }

  /*
   * @desc      Common function to retrieve NRf1 to NRf4 on given band for ENDC band
   * @param     p_FreqBandIndicatorNR
   * @param     p_ENDC_Combination
   * @return    template (value) NR_Frequencyf1tof4_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_NR_GetFrequencyENDC_f1Tof4(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                        ENDC_CombinationType_Type p_ENDC_Combination) return template (value) NR_Frequencyf1tof4_Type
  { //@sic R5-190669 added p_ENDC_Combination for ENDC intraband combination sic@
    var template (value) NR_Frequencyf1tof4_Type  v_NR_Frequencyf1tof4;
    
    select (p_ENDC_Combination) {
      case(InterBand){
        if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) {
          v_NR_Frequencyf1tof4 := f_NR_GetFrequencySA_f1tof4(p_FreqBandIndicatorNR);
        } else {
          v_NR_Frequencyf1tof4 := f_NR_GetHighestBandwidthFrequency(p_FreqBandIndicatorNR);
        }
      }
      case(IntraBandContiguous){
        if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) { //@sic R5s191095 sic@
            v_NR_Frequencyf1tof4 := f_NR_GetFrequencyIntraBandC_f1tof4(p_FreqBandIndicatorNR);
        } else {
          v_NR_Frequencyf1tof4 := f_NR_GetHighestFrequencyIntraBandC_f1tof4(p_FreqBandIndicatorNR);
        }
      }
      case(IntraBandNonContiguous){
        if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) { //@sic R5-199015 sic@
            v_NR_Frequencyf1tof4 := f_NR_GetFrequencyIntraBandNC_f1tof4(p_FreqBandIndicatorNR);
        } else {
          v_NR_Frequencyf1tof4 := f_NR_GetHighestFrequencyIntraBandNC_f1tof4(p_FreqBandIndicatorNR);
        }
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid ENDC band combination type");
      }
    }
    return v_NR_Frequencyf1tof4
  }

}
