module SDAP_TypeDefs {
  import from CommonDefs all;

  group SDAP_Configuration {
  
  type enumerated SDAP_Header_Type {
    Present,
    Absent
  };
   
  type record of integer QFI_List_Type;

  type record SdapConfig_Type {
    integer  Pdu_SessionId,
    SDAP_Header_Type            Sdap_HeaderDL   optional,       /* mandatory for initial configuration; omit means "keep as it is"
                                                                   when set to 'Present', unless specifically triggered otherwise, the SS shall set the RDI and RQI fields to 0 */
    SDAP_Header_Type            Sdap_HeaderUL   optional,       /* mandatory for initial configuration; omit means "keep as it is" */
    QFI_List_Type               MappedQoS_Flows optional        /* mandatory for initial configuration; omit means "keep as it is" */
  };

  type record SdapTransparentMode_Type {
    SDAP_Header_Type    Sdap_HeaderUL                           /* Indicates to the SS if the UE has been configured to include SDAP UL header */
  };
  
  type union SdapConfigInfo_Type {
    SdapConfig_Type             SdapConfig,                     /* SDAP configuration parameters for the DRB */
    SdapTransparentMode_Type    TransparentMode                 /* SDAP configuration for transparent (test) mode, used for SDAP tests:
                                                                 * SS does not add any SDAP headers in DL and does not remove any SDAP headers in UL */
  };

  type union SDAP_Configuration_Type {
    Null_Type                   None,
    SdapConfigInfo_Type         Config
  };
  
  } // End group SDAP_Configuration

  //----------------------------------------------------------------------------

  group SDAP_DrbDefs {

  type octetstring SDAP_SDU_Type;
  type record of SDAP_SDU_Type SDAP_SDUList_Type;

  type record SDAP_DL_PduHeader_Type {               /* TS 37.324 Figure 6.2.2.2-1 */
    B1_Type             RDI,                         /* TS 37.324 Figure 6.3.7: The RDI bit indicates whether QoS flow to DRB mapping rule should be updated
                                                      * 1 bit: '0'B   No action
                                                      *        '1'B   To store QoS flow to DRB mapping rule */
    B1_Type             RQI,                         /* TS 37.324 clause 6.3.6: The RQI bit indicates whether NAS should be informed of the updated of SDF to QoS flow mapping rules
                                                      * 1 bit: '0'B   No action
                                                      *        '1'B   To inform NAS that RQI bit is set to 1 */
    B6_Type             QFI                          /* TS 37.324 clause 6.3.4: The QFI field indicates the ID of the QoS flow to which the SDAP SDU belongs */
  };
  
  type record SDAP_UL_PduHeader_Type {               /* TS 37.324 Figure 6.2.2.3-1 or 6.2.3-1*/
    B1_Type             DC,                          /* TS 37.324 clause 6.3.3: The D/C bit indicates whether the SDAP PDU is an SDAP Data PDU or an SDAP Control PDU
                                                      * 1 bit: '0'B   Control PDU
                                                      *        '1'B   Data PDU */
    B1_Type             R,                           /* TS 37.324 clause 6.3.5: Reserved. In this version of the specification reserved bits shall be set to 0. Reserved bits shall be ignored by the receiver */
    B6_Type             QFI                          /* QFI (UL) or PQFI (SL)
                                                        TS 37.324 clause 6.3.4: The QFI field indicates the ID of the QoS flow to which the SDAP SDU belongs, or
                                                        TS 37.324 clause 6.3.8: The PQFI field indicates the ID of the PC5 QoS flow to which the SDAP PDU belongs */
  };
  
  type record SDAP_PDU_DL_Type {                     /* TS 37.324 clause 6.2.2 Data PDU */
    SDAP_DL_PduHeader_Type      Header  optional,    /* present for DL Data PDU with SDAP header (clause 6.2.2.2), omitted for Data PDU without SDAP header (clause 6.2.2.1) */
    SDAP_SDU_Type               Data
  };
  
  type record SDAP_PDU_UL_Type {                     /* TS 37.324 clause 6.2.2 Data PDU or clause 6.2.3 End-Marker Control PDU */
    SDAP_UL_PduHeader_Type      Header  optional,    /* present for: UL Data PDU in default DRB or UL Data PDU with SDAP header in a non-default DRB (clause 6.2.2.3) or End-Marker Control PDU (clause 6.2.3); omitted for UL Data PDU without SDAP header in a non-default DRB (clause 6.2.2.1) */
    SDAP_SDU_Type               Data    optional     /* present for UL Data PDU (clause 6.2.2.1 or 6.2.2.3), omitted for End-Marker Control PDU (clause 6.2.3) */
  };
  
  type union SDAP_PDU_Type {                         /* TS 37.324 clause 6.2.2 Data PDU or 6.2.3 End-Marker Control PDU */
    SDAP_PDU_DL_Type            DL,                  /* Data PDU in DL */
    SDAP_PDU_UL_Type            UL                   /* Data PDU in UL or End-Marker Control PDU */
  };

  type record of SDAP_PDU_Type SDAP_PDUList_Type;

  } with { encode "DRB Types"}  // End group SDAP_DrbDefs
}
