module EUTRA_AspCommon_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_CommonDefs all;

  template (value) RadioBearerId_Type cs_RadioBearerId_DRB(DRB_Identity p_DRB) := { Drb := p_DRB };        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) RadioBearerId_Type cs_RadioBearerId_SRB(SRB_Identity_Type p_SRB) := { Srb := p_SRB };   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (present) CnfAspCommonPart_Type cr_CnfAspCommonPart_CellCfg(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    CellId := p_CellId,
    RoutingInfo := { None := true },
    TimingInfo := ?,
    Result := { Success := true }
  };

  template (value) ReqAspCommonPart_Type cs_ReqAspCommonPart_CellCfg(EUTRA_CellId_Type p_CellId,
                                                                     template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                     template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s110634 additional changes: f_CnfFlag_Set sic@ */
    CellId := p_CellId,
    RoutingInfo := { None := true },
    TimingInfo := p_TimingInfo,
    ControlInfo := {
      CnfFlag      := f_CnfFlag_Set(p_TimingInfo, p_CnfFlag),
      FollowOnFlag := false
    },
    RlcBearerRouting := omit  /* @sic R5w180111: CA_Info -> RlcBearerRouting sic@ */
  };

  template (value) ReqAspCommonPart_Type cs_ReqAspCommonPart_RB(EUTRA_CellId_Type p_CellId,
                                                                template (value) RadioBearerId_Type p_RB_Id,
                                                                template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                template (omit) RlcBearerRouting_Type p_RlcRouting := omit) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    CellId := p_CellId,
    RoutingInfo := {
      RadioBearerId := p_RB_Id
    },
    TimingInfo := p_TimingInfo,
    ControlInfo := {
      CnfFlag := tsc_NoCnfReq,
      FollowOnFlag := false
    },
    RlcBearerRouting := p_RlcRouting  /* @sic R5w180111: CA_Info -> RlcBearerRouting sic@ */
  };

  template (present) RoutingInfo_Type cr_RoutingInfo_None :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    None := true
  };

  template (present) RoutingInfo_Type cr_RoutingInfo_RadioBearerId(template (present) RadioBearerId_Type p_RadioBearerId) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    RadioBearerId := p_RadioBearerId
  };

  template (present) IndAspCommonPart_Type cr_IndAspCommonPart_Common(template (present) EUTRA_CellId_Type p_CellId,
                                                                      template (present) RoutingInfo_Type p_RoutingInfo,
                                                                      template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                      template RlcBearerRouting_Type p_RlcRouting := *) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    CellId      :=  p_CellId,
    RoutingInfo := p_RoutingInfo,
    TimingInfo  := p_TimingInfo,
    Status      := { Ok := true },
    RlcBearerRouting := p_RlcRouting  /* @sic R5w180111: CA_Info -> RlcBearerRouting sic@ */
  };

  template (present) IndAspCommonPart_Type cr_IndAspCommonPart_SysInd(template (present) EUTRA_CellId_Type p_CellId,
                                                                      template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any) :=
  /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    cr_IndAspCommonPart_Common (p_CellId, cr_RoutingInfo_None, p_TimingInfo);

  template (present) IndAspCommonPart_Type cr_IndAspCommonPart_RB(template (present) EUTRA_CellId_Type p_CellId,
                                                                  template (present) RadioBearerId_Type p_RbId,
                                                                  template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                  template RlcBearerRouting_Type p_RlcRouting := *) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    cr_IndAspCommonPart_Common (p_CellId, cr_RoutingInfo_RadioBearerId(p_RbId), p_TimingInfo, p_RlcRouting);

  template (present) SYSTEM_CTRL_CNF car_CellConfig_Power_CNF :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cr_CnfAspCommonPart_CellCfg(eutra_Cell_NonSpecific),
    Confirm := {
      CellAttenuationList := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_CellConfig_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      Cell := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_EnquireTiming(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      EnquireTiming := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_SYSTEM_CTRL_L1MACInd_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      L1MacIndCtrl := true
    }
  };

  template (present) SYSTEM_CTRL_CNF car_SYSTEM_CTRL_UE_Cat_Info_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      UE_Cat_Info := true
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_EnquireTiming(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId),
    Request := {
      EnquireTiming := true
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_ReleaseCell_REQ(EUTRA_CellId_Type p_CellId,
                                                       template (value) TimingInfo_Type p_TimingInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cs_ReqAspCommonPart_CellCfg( p_CellId, p_TimingInfo, tsc_NoCnfReq), // Don't request a confirmation
    Request := {
      Cell := {
        Release := true
      }
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_RachPreambleIndConfig_REQ(EUTRA_CellId_Type p_CellId,
                                                                 IndicationAndControlMode_Type p_RachPreambleMode) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, cs_TimingInfo_Now, tsc_NoCnfReq),
    Request := {
      L1MacIndCtrl := cs_EnableRachPreamble_Req(p_RachPreambleMode)
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_HarqErrorIndication_REQ(EUTRA_CellId_Type p_CellId,
                                                               IndicationAndControlMode_Type p_Mode := enable) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, cs_TimingInfo_Now),
    Request := {
      L1MacIndCtrl := cs_HarqErrorInd_Req(p_Mode)
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_PdcpHandoverInit_REQ(EUTRA_CellId_Type p_SourceCellId,
                                                            EUTRA_CellId_Type p_TargetCellId,
                                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) :=
  {  /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11) */
    /* @sic R5-133623: p_TimingInfo sic@ */
    Common := cs_ReqAspCommonPart_CellCfg(p_TargetCellId, p_TimingInfo),
    Request := {
      PdcpHandoverControl := {
        HandoverInit := {
          SourceCellId := p_SourceCellId
        }
      }
    }
  };

  template (value) SYSTEM_CTRL_REQ cas_PdcpHandoverComplete_REQ(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, cs_TimingInfo_Now, tsc_NoCnfReq),   // note: there shall be no CNF to avoid race conditions in case of UL data pending
    Request := {
      PdcpHandoverControl := {
        HandoverComplete := true
      }
    }
  };

  template (present) SYSTEM_CTRL_CNF car_PdcpHandoverControl_CNF(EUTRA_CellId_Type p_CellId) :=
  {  /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      PdcpHandoverControl := true
    }
  };

  template (present) SYSTEM_IND car_SYSTEM_IND_Any :=
  { /* @status    APPROVED (LTE, LTE_A_PRO) */
    Common        := cr_IndAspCommonPart_SysInd(?, cr_TimingInfo_Any),
    Indication    := ?
  };

  template (present) RachPreamble_Type cr_RachPreamble(template (present) PrachPreambleIndex_Type p_PrachPreambleIndex,
                                                       template integer p_RepetitionsPerPreambleAttempt := *) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */
    RAPID        := p_PrachPreambleIndex,
    PRTPower     := ?,
    RepetitionsPerPreambleAttempt := p_RepetitionsPerPreambleAttempt //@sic R5w170004 sic@
  };

  template (present) SYSTEM_IND car_PRACH_Preamble_IND(EUTRA_CellId_Type p_CellId,
                                                       template (present) TimingInfo_Type p_TimingInfo,
                                                       template (present) RachPreamble_Type p_RachPreamble := cr_RachPreamble(tsc_EUTRA_PrachPreambleIndex_Dedicated_Def)) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */
    Common := cr_IndAspCommonPart_SysInd (p_CellId, p_TimingInfo),
    Indication := {
      RachPreamble := p_RachPreamble
    }
  };

  template (present) SYSTEM_IND car_PRACH_Preamble_IND_Any(EUTRA_CellId_Type p_CellId,
                                                           template (present) TimingInfo_Type p_TimingInfo) :=
    /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11) */
    car_PRACH_Preamble_IND(p_CellId, p_TimingInfo, cr_RachPreamble(?));

  template (value) L1Mac_IndicationControl_Type cs_EnableRachPreamble_Req(IndicationAndControlMode_Type p_RachPreambleMode) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */
    RachPreamble  := p_RachPreambleMode, /* To enable/disable reporting of PRACH preamble received. */
    SchedReq  := omit,
    BSR       := omit,
    UL_HARQ   := omit,
    C_RNTI    := omit,
    PHR       := omit,
    HarqError := omit,
    PeriodicRI := omit,
    EPHR := omit,
    PeriodicCQI := omit,
    SRS := omit,
    DC_PHR := omit
  };

  template (value) L1Mac_IndicationControl_Type cs_HarqErrorInd_Req(IndicationAndControlMode_Type p_Mode) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    RachPreamble  := omit,
    SchedReq  := omit,
    BSR       := omit,
    UL_HARQ   := omit,
    C_RNTI    := omit,
    PHR       := omit,
    HarqError := p_Mode,
    PeriodicRI := omit,
    EPHR := omit,
    PeriodicCQI := omit,
    SRS := omit,
    DC_PHR := omit
  };

  template (value) TDD_Config_Type cs_TDD_Config_r8(template (value) TDD_Config p_TDD_Config,
                                                    template (omit) TDD_Config_v1130 p_TDD_Config_v1130 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R8andLater := {
      R8 := p_TDD_Config,
      tdd_Config_v1130 := p_TDD_Config_v1130
    }
  };

  template (value) PHICH_Config_Type cs_PHICH_Config_r8(template (value) PHICH_Config p_PHICH_Config) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R8 := p_PHICH_Config
  };

  template (value) PRACH_Config_Type cs_PRACH_Config_r8(template (value) PRACH_Config p_PRACH_Config,
                                                        template (omit) PRACH_Config_v1310 p_PRACH_Config_v1310 := omit,
                                                        template (omit) PRACH_Config_v1430  p_PRACH_Config_v1430 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    // @sic R5-167569: use R8andLater branch R5-176985 sic@
    R8andLater := {
        prach_Config := p_PRACH_Config,
        prach_Config_v1310 := p_PRACH_Config_v1310,
        prach_Config_v1430 := p_PRACH_Config_v1430
        }
  };

  template (value) PUCCH_ConfigCommon_Type cs_PUCCH_ConfigCommon_r8(template (value) PUCCH_ConfigCommon p_PUCCH_ConfigCommon,
                                                                    template (omit) PUCCH_ConfigCommon_v1310 p_PUCCH_ConfigCommon_v1310
                                                                    ) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R8andLater := {
        pucch_ConfigCommon := p_PUCCH_ConfigCommon,
        pucch_ConfigCommon_v1310 := p_PUCCH_ConfigCommon_v1310
    }
  };

  template (value) PUCCH_ConfigDedicated_Type cs_PUCCH_ConfigDedicated_r8(template (value) PUCCH_ConfigDedicated p_PUCCH_ConfigDedicated,
                                                                          template (omit)  PUCCH_ConfigDedicated_v1020 p_PUCCH_ConfigDedicated_v1020 := omit,
                                                                          template (omit)  PUCCH_ConfigDedicated_v1130 p_PUCCH_ConfigDedicated_v1130 := omit,
                                                                          template (omit)  PUCCH_ConfigDedicated_v1250 p_PUCCH_ConfigDedicated_v1250 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R8andLater := {
      pucch_ConfigDedicated := p_PUCCH_ConfigDedicated,
      pucch_ConfigDedicated_v1020 := p_PUCCH_ConfigDedicated_v1020,
      pucch_ConfigDedicated_v1130 := p_PUCCH_ConfigDedicated_v1130,
      pucch_ConfigDedicated_v1250 := p_PUCCH_ConfigDedicated_v1250     /* @sic BASELINE MOVING 2015 sic@ */
    }
  };

  template (value) PUCCH_ConfigDedicated_Type cs_PUCCH_ConfigDedicated_r13(template (value) PUCCH_ConfigDedicated_r13 p_PUCCH_ConfigDedicated_r13) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R13andLater := {
      pucch_ConfigDedicated_r13 := p_PUCCH_ConfigDedicated_r13
    }
  };

  template (value) PUSCH_ConfigCommon_Type cs_PUSCH_ConfigCommon_r8(template (value) PUSCH_ConfigCommon p_PUSCH_ConfigCommon,
                                                                    template (omit) PUSCH_ConfigCommon_v1310 p_PUSCH_ConfigCommon_v1310 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
