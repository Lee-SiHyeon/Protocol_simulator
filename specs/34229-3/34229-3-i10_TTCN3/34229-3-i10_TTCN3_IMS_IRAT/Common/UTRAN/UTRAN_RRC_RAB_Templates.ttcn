  template (value) DL_AddReconfTransChInformation_r7 cs_DL_AddReconfTransChInfoExplicit(TransportChannelIdentity p_TransportChannelId,
                                                                                        template (value) DedicatedTransChTFS p_DedicatedTransChTFS,
