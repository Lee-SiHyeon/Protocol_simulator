module MCX_36579_SelectionExpressions {

  import from MCX_Parameters all;

  type enumerated MCX_36579_Condition_Type {                    /* @status    APPROVED (MCX) */
    MCX_C01,
    MCX_C02,
    MCX_C03,
    MCX_C04,
    MCX_C05,
    MCX_C06,
    MCX_CD01,
    MCX_CD02,
    MCX_CD03,
    MCX_CD04,
    MCX_CV01,
    MCX_CV02
  };

  /*
   * @desc      Set the applicability conditions according to 36.579-4 Table 4-1: Applicability of tests Conditions
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MCX_SelectionExpr(MCX_36579_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;

    select (p_Condition) {
      case (MCX_C01) {
        v_ApplCond := pc_MCPTTClient;
      }
      case (MCX_C02) {
        v_ApplCond := pc_MCPTTClient and pc_MCPTT_OnDemanSeRemotePrivCall;
      }
      case (MCX_C03) {
        v_ApplCond := pc_MCPTTClient and pc_MCPTT_PreEstablishedSeRemotePrivCall;
      }
      case (MCX_C04) {
        v_ApplCond := pc_MCPTTClient and pc_MCPTT_OnDemanSeFirstToAnswerCall;
      }
      case (MCX_C05) {
        v_ApplCond := pc_MCPTTClient and pc_MCPTT_PreEstablishedSeFirstToAnswerCall;
      }
      case (MCX_C06) {
        v_ApplCond := pc_MCPTTClient and pc_MCX_AmbientListeningCall;
      }
      case (MCX_CD01) {
        v_ApplCond := pc_MCDataClient;
      }
      case (MCX_CD02) {
        v_ApplCond := pc_MCDataClient and pc_MCData_FD and not pc_MCData_MSFDiscoverySignalling;
      }
      case (MCX_CD03) {
        v_ApplCond := pc_MCDataClient and pc_MCData_SDS;
      }
      case (MCX_CD04) {
        v_ApplCond := pc_MCDataClient and pc_MCData_FD;
      }
      case (MCX_CV01) {
        v_ApplCond := pc_MCVideoClient;
      }
      case (MCX_CV02) {
        v_ApplCond := pc_MCVideoClient and pc_MCX_Rejoin;
      }
      case else {
        v_ApplCond := false;
      }
    }
    return v_ApplCond;
  }

}
