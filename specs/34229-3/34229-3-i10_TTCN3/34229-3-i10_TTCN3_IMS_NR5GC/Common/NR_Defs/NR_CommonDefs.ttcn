  /*
   * @desc      Converts a PLMN ID from ASN.1 to NAS representation.
   * @param     p_PlmnId    .. PLMN ID as defined in NR RRC ASN.1.
   * @return    NAS_PlmnId  .. NAS representation of the PLMN ID (O3_Type)
   */
  function f_NR_Asn2Nas_PlmnId(template (value) PLMN_Identity p_PlmnId) return NAS_PlmnId
  { // This is a copy of the EUTRA function (f_Asn2Nas_PlmnId), but this version will use the NR ASN

    var PLMN_Identity v_PlmnId := valueof(p_PlmnId);
    var hexstring v_MCC := '000'H; // initialised with 3 digits which will be overwritten
    var hexstring v_MNC := 'FFF'H; // initialised with 3 'F'H => if lengthof(v_PlmnId.mnc) < 3 the remaining digits are 'F'H
    var MCC_MNC_Digit v_Digit;
    var integer I;

    for (I := 0; (I < lengthof(v_PlmnId.mcc)) and(I < lengthof(v_MCC)); I := I + 1) {
      v_Digit := v_PlmnId.mcc[I];
      v_MCC[I] := int2hex(v_Digit, 1);
    }

    for (I := 0; (I < lengthof(v_PlmnId.mnc)) and (I < lengthof(v_MNC)); I := I + 1) {
      v_Digit := v_PlmnId.mnc[I];
      v_MNC[I] := int2hex(v_Digit, 1);
    }

    // build PLMN ID representation as used in NAS
    // TAI/TAI list/MobileIdentity[GUTI]/...
    return hex2oct(v_MCC[1] & v_MCC[0] &
                   v_MNC[2] & v_MCC[2] &
                   v_MNC[1] & v_MNC[0]);
  }

  /*
   * @desc      to convert ASN.1 AccessStratumRelease type to integer
   * @param     p_AccessStratumRelease
   * @return    template (omit) integer
   */
  function f_NR_ConvertAccessStratumReleaseToInteger(AccessStratumRelease p_AccessStratumRelease) return template (omit) integer
  {
    var template (omit) integer v_UE_Release := omit;
    select (p_AccessStratumRelease) {
      case (rel15) {v_UE_Release := 15;}
      case (rel16) {v_UE_Release := 16;} // @sic R5s201387 BASELINE MOVING 2020 sic@
      case (rel17) {v_UE_Release := 17;} /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    }
    return v_UE_Release;
  }

  /*
   * @desc      To check the NR release reported by UE against the tc release
   * @param     p_ReleaseIndicator_UE
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CheckReleaseIndicator(AccessStratumRelease p_ReleaseIndicator_UE)
 {
    var integer v_RelMin;
    var integer v_Rel;
    var template (omit) integer v_UE_Release := f_NR_ConvertAccessStratumReleaseToInteger(p_ReleaseIndicator_UE);

     if (isvalue(v_UE_Release)) {
      v_Rel := valueof(v_UE_Release);

       //select (p_ReleaseIndicator_UE) {
       select (f_GetTestcaseAttrib_NR_Release (testcasename())) {
         case ("") { // no attribute is assigned for Rel-15
           v_RelMin := 15;  // >= rel15
         }
         case ("rel_16"){
           v_RelMin := 16;  // >= rel16 - @sic R5s201387 BASELINE MOVING 2020 sic@
         }
         case ("rel_17"){
           v_RelMin := 17;  // >= rel17 - @sic R5s221179 BASELINE MOVING 2022 sic@
         }
         case ("rel_18"){
           v_RelMin := 18;  // >= rel18 - @sic R5s240531 BASELINE MOVING 2024 sic@
         }
         case else {
           FatalError(__FILE__, __LINE__, "");
         }
       }

      if (v_Rel < v_RelMin) {
        f_SetVerdictInconc (__FILE__, __LINE__, "Wrong Access Stratum release indicator");
      }
    }
  }
}
