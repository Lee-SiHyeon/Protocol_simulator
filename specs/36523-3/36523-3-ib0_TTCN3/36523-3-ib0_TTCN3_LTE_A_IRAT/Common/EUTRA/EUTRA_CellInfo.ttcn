  /*
   * @desc      Set the RAT mode of the cell UE is camping in.
   * @param     p_CellId
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_Update_RANType(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  { //@sic R5s150293 sic@
    var EUTRA_FDD_TDD_Mode_Type v_FDD_TDD;

    v_FDD_TDD := f_EUTRA_CellInfo_GetFDD_TDD(p_CellId);

    vc_EUTRA_Global.MobileInfo.FDD_TDD_Info := v_FDD_TDD;
  }

