module MCPTT_GroupCall_MCX_IMS {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_Component all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;
  import from MCPTT_MediaControl_Procedures all;
  import from MCPTT_MediaControl_Templates all;
  import from MCPTT_SIP_CallControl all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_MIME_Functions all;
  import from MCX_Parameters all;
  import from MCX_PreestablishedSession all;
  import from MCX_SDP_MCPTT_MCVideo all;
  import from MCX_SIP_CallControl_Common all;
  import from MCX_SIP_CallControl_MCPTT_MCVideo all;
  import from MCX_SIP_Common all;
  import from MCX_SIP_Registration all;
  import from MCX_XML_mcpttLocationInfo all;
  import from MCX_XML_mcptt_info all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.1.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_1_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Automatic Commencement Mode / End-to-end communication security / Floor Control / Upgrade to Emergency Group Call / Cancel Emergency State / Upgrade to Imminent Peril Group Call / Cancel Imminent Peril State / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var O2_Type v_RejectCause;
    var charstring v_Reason;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call with automatic commencement mode and implicit floor request");
    
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, -, -, withImplictGrantRequest, implicitRequestGranted);    // 36.579-1 table 5.3A.1.3-1 NOTE1 b.i
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    // @siclog "Step 3 - 6" Void siclog@
    
    // @siclog "Step 7" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 7");
    
    // @siclog "Step 8" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 9" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    // @siclog "Step 10a1 - 11" Void siclog@
    
    // @siclog "Step 12" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
    // @siclog "Step 13"
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    
    // @siclog "Step 14 - 16" Void siclog@
    
    // @siclog "Step 17 The SS overrides the MCPTT Client and grants the floor to a higher priority MCPTT Client" siclog@
    
    // @siclog "Step 18" siclog@
    f_MCPTT_FloorControl_SendFloorRevoke(NORMAL_CALL);
    
    // @siclog "Step 18A" Void siclog@
    
    // @siclog "Step 19" siclog@
    f_MCPTT_FloorReleaseTaken(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");
    
    // @siclog "Table 6.1.1.1.3.2-2: Parallel Behaviour" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the permission to send RTP media is being revoked?", "Table 6.1.1.1.3.2-2: Parallel Behaviour");   /* @sic R5-213660 sic@ */
    
    // @siclog "Step 20" Void siclog@
    
    // @siclog "Step 21" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
    // @siclog "Step 22" siclog@
    v_RejectCause :='00FF'O;
    v_Reason := "other reason";
    f_MCPTT_FloorRequestDenied(NORMAL_CALL, v_RejectCause, v_Reason);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");
    
    // @siclog "Step 23 - 24" Void siclog@
    
    if (pc_MCPTT_FloorRequestQueueing) {
      // @siclog "Step 25a1" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
      
      // @siclog "Step 25a2" siclog@
      f_MCPTT_FloorRequestQueued(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25a2");
      
      // @siclog "Step 25a3" siclog@  Does the MCPTT Client provide floor request queued response notification to the MCPTT user?
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor request queued response notification to the user?", "Step 25a3");
      
      // @siclog "Step 25a4" siclog@
      f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request the floor queue position");
      
      // @siclog "Step 25a5" siclog@
      f_MCPTT_FloorQueuePosRequest(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25a5");
      
      // @siclog "Step 25a6" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor queue position information to the user?", "Step 25a6");
      
      // @siclog "Step 25a7" siclog@
      f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) cancel the floor request
      
      // @siclog "Step 25a8" siclog@
      f_MCPTT_FloorReleaseTaken(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25a8");
      
      // @siclog "Step 25a9" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
      
      // @siclog "Step 25a10" siclog@
      f_MCPTT_FloorRequestQueued(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25a10");
      
      // @siclog "Step 25a11" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor request queued response notification to the user?", "Step 25a11");
      
      // @siclog "Step 25a12" siclog@
      f_MCPTT_FloorControl_SendFloorGranted(NORMAL_CALL);
      
      // @siclog "Step 25a13" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 25a13");

    } else {

      // @siclog "Step 25b1" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
      
      // @siclog "Step 25b2" siclog@
      f_MCPTT_FloorRequestGranted(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25b2");
    }

    // @siclog "Step 26 - 40" Void siclog@
    
    // @siclog "Step 41" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
      
    // @siclog "Step 42" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 42");
    
    // @siclog "Step 43 - 44" Void siclog@
    
    // @siclog "Step 45" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 45");
    
    // @siclog "Step 46" Void siclog@
    
    // @siclog "Step 47" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call with automatic commencement mode and implicit floor request");

    // @siclog "Step 48" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, -, -, withImplictGrantRequest, implicitRequestGranted);    // 36.579-1 table 5.3A.1.3-1 NOTE1 b.i
    
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 48");
    
    // @siclog "Step 49 - 52" Void siclog@
    
    // @siclog "Step 53" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 53");
    
    // @siclog "Step 54" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor

    // @siclog "Step 55" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 55");

    // @siclog "Step 56 - 58" Void siclog@
    
    // @siclog "Step 59" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request upgrade of the call to an emergency group call with implicit floor request");
    
    // @siclog "Step 60" siclog@
    f_MCPTT_SessionModificationCO_Upgrade(GROUP_CALL, EMERGENCY_CALL);
    
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 60");
    
    // @siclog "Step 61 - 61C" Void siclog@

    // @siclog "Step 61D" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 61D");

    // @siclog "Step 62" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 63" siclog@
    f_MCPTT_FloorReleaseIdle(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 63");
    
    // @siclog "Step 64 - 65" Void siclog@

    // @siclog "Step 66" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 67" siclog@
    f_MCPTT_FloorRequestGranted(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 67");

    // @siclog "Step 68 - 70" Void siclog@

    // @siclog "Step 71" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 72" siclog@
    f_MCPTT_FloorReleaseIdle(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 72");
    
    // @siclog "Step 73 - 74" Void siclog@

    // @siclog "Step 75" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request downgrade of the call to a normal group call");

    // @siclog "Step 76" siclog@
    f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCPTT, GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 76");
    
    // @siclog "Step 77" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 77A" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 77A");

    // @siclog "Step 77B - 77D" Void siclog@

    // @siclog "Step 78" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 79" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 79");

    // @siclog "Step 80 - 81" Void siclog@

    // @siclog "Step 82" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request upgrade of the call to an imminent peril group call with implicit floor request");
    
    // @siclog "Step 83" siclog@
    f_MCPTT_SessionModificationCO_Upgrade(GROUP_CALL, IMMPERIL_CALL);
    
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 83");
    
    // @siclog "Step 84 - 84C" Void siclog@

    // @siclog "Step 84D" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 84D");

    // @siclog "Step 85" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
   
    // @siclog "Step 86" siclog@
    f_MCPTT_FloorReleaseIdle(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 86");
   
    // @siclog "Step 87 - 88" Void siclog@

    // @siclog "Step 89" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 90" siclog@
    f_MCPTT_FloorRequestGranted(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 90");
    
    // @siclog "Step 91 - 93" Void siclog@

    // @siclog "Step 94" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
   
    // @siclog "Step 95" siclog@
    f_MCPTT_FloorReleaseIdle(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 95");
    
    // @siclog "Step 96 - 97" Void siclog@

    // @siclog "Step 98" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request downgrade of the imminent peril call to a normal group call");

    // @siclog "Step 99" siclog@
    f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCPTT, GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 99");
    
    // @siclog "Step 100" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 100A" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 100A");

    // @siclog "Step 100B - 100D" Void siclog@

    // @siclog "Step 101" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 102" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 102");

    // @siclog "Step 103 - 104" Void siclog@

    // @siclog "Step 105 - 106" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 106");

    // End of test body
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.2.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_2_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Automatic Commencement Mode / Floor Control / Upgrade to Emergency Group Call / Cancel Emergency State / Upgrade to Imminent Peril Group Call / Cancel Imminent Peril State / Client Terminated (CT)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var O2_Type v_RejectCause;
    var charstring v_Reason;
    
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCPTT, GROUP_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
    
    // @siclog "Step 2 - 9" Void siclog@
    
    // @siclog "Step 10" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 11" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 12 - 14" Void siclog@
    
    // @siclog "Step 15 The SS overrides the MCPTT Client and grants the floor to a higher priority MCPTT Client" siclog@
    
    // @siclog "Step 16" siclog@
    f_MCPTT_FloorControl_SendFloorRevoke(NORMAL_CALL);

    // @siclog "Step 17" siclog@
    f_MCPTT_FloorReleaseTaken(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 17");
  
    // @siclog "Table 6.1.1.2.3.2-2: Parallel Behaviour" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the permission to send RTP media is being revoked?", "Table 6.1.1.2.3.2-2: Parallel Behaviour");   /* @sic R5-213661 sic@ */
    
    // @siclog "Step 18" Void siclog@
    
    // @siclog "Step 19" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
 
    // @siclog "Step 20" siclog@
    v_RejectCause :='00FF'O;
    v_Reason := "other reason";
    f_MCPTT_FloorRequestDenied(NORMAL_CALL, v_RejectCause, v_Reason);    // The SS sends a Floor Deny message with no acknowledgement required and Cause Code #255
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    
    // @siclog "Step 21 - 22" Void siclog@
    
    if (pc_MCPTT_FloorRequestQueueing) {
      // @siclog "Step 23a1" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
      // @siclog "Step 23a2" siclog@
      f_MCPTT_FloorRequestQueued(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23a2");
      
      // @siclog "Step 23a3" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor request queued response notification to the user?", "Step 23a3");
      
      // @siclog "Step 23a4" siclog@
      f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request the floor queue position");
      
      // @siclog "Step 23a5" siclog@
      f_MCPTT_FloorQueuePosRequest(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23a5");
      
      // @siclog "Step 23a6" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 23a6");
      
      // @siclog "Step 23a7" siclog@
      f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) cancel the floor request
      
      // @siclog "Step 23a8" siclog@
      f_MCPTT_FloorReleaseTaken(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23a8");
    
      // @siclog "Step 23a9" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
      
      // @siclog "Step 23a10" siclog@
      f_MCPTT_FloorRequestQueued(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23a10");
      
      // @siclog "Step 23a11" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor request queued response notification to the user?", "Step 23a11");
    
      // @siclog "Step 23a12" siclog@
      f_MCPTT_FloorControl_SendFloorGranted(NORMAL_CALL);
      
      // @siclog "Step 23a13" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 23a13");
    
    } else {
      // @siclog "Step 23b1" siclog@
      f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
      // @siclog "Step 23b2" siclog@
      f_MCPTT_FloorRequestGranted(NORMAL_CALL);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23b2");
    }

    // @siclog "Step 24 - 38" Void siclog@
  
    // @siclog "Step 39" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 40" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 40");
    
    // @siclog "Step 41 - 42" Void siclog@
  
    // @siclog "Step 43 - 44" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 44");

    // @siclog "Step 45" Void siclog@
    
    // @siclog "Step 46" siclog@
    f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCPTT, GROUP_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 46");

    // @siclog "Step 47 - 51" Void siclog@

    // @siclog "Step 52" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL);
    
    // @siclog "Step 53" siclog@
    f_MCPTT_SessionModificationCT(UPGRADE, -, GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 53");

    // @siclog "Step 54A" Void siclog@

    // @siclog "Step 54B" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(EMERGENCY_CALL);

    // @siclog "Step 55" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(EMERGENCY_CALL);
    
    // @siclog "Step 56" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
    // @siclog "Step 57" siclog@
    f_MCPTT_FloorRequestGranted(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 57");
    
    // @siclog "Step 58 - 60" Void siclog@

    // @siclog "Step 61" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 62" siclog@
    f_MCPTT_FloorReleaseIdle(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 62");
    
    // @siclog "Step 63 - 64" Void siclog@

    // @siclog "Step 65" siclog@
    f_MCPTT_SessionModificationCT(DOWNGRADE, -, GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 65");

    // @siclog "Step 65A - 66A" Void siclog@

    // @siclog "Step 67" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL);

    // @siclog "Step 68" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 69" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 70" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 70");
    
    // @siclog "Step 71 - 73" Void siclog@

    // @siclog "Step 74" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor

    // @siclog "Step 75" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 75");

    // @siclog "Step 76 - 77" Void siclog@

    // @siclog "Step 78" siclog@
    f_MCPTT_SessionModificationCT(UPGRADE, -, GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 78");

    // @siclog "Step 78A - 79A" Void siclog@

    // @siclog "Step 80" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(IMMPERIL_CALL);

    // @siclog "Step 81" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor
    
    // @siclog "Step 82" siclog@
    f_MCPTT_FloorRequestGranted(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 82");

    // @siclog "Step 83 - 85" Void siclog@

    // @siclog "Step 86" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 87" siclog@
    f_MCPTT_FloorReleaseIdle(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 87");
    
    // @siclog "Step 88 - 89" Void siclog@

    // @siclog "Step 90" siclog@
    f_MCPTT_SessionModificationCT(DOWNGRADE, -, GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 90");

    // @siclog "Step 90A - 91A" Void siclog@
    
    // @siclog "Step 92" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL);
    
    // @siclog "Step 93" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 94" siclog@
    f_UT_MCX_PTTOn(MMI);              // Make the UE (MCPTT client) request the floor

    // @siclog "Step 95" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 95");

    // @siclog "Step 96 - 98" Void siclog@

    // @siclog "Step 99" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor

    // @siclog "Step 100" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 100");

    // @siclog "Step 101 - 102" Void siclog@

    // @siclog "Step 103" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 103");
 
    // @siclog "Step 104" Void siclog@

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.3.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_3_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Manual Commencement Mode / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call with manual commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, -, MANUAL, withImplictGrantRequest);   // 36.579-1 table 5.3A.1.3-1 NOTE1 b.ii
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 6" Void siclog@

    // @siclog "Step 6A" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 6A");
    
    // @siclog "Step 6B" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 6C" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6C");
    
    // @siclog "Step 7 - 8" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.4.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_4_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Manual Commencement Mode / Client Terminated (CT)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Invite;
    var template (present) MessageHeader v_MessageHeader480;
    var SipUrl v_RequestUrl_Ack;
    var template (value) MessageHeader v_MessageHeader_Ack;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_Manual(MCPTT, -, GROUP_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
     
    // @siclog "Step 2 - 7" Void siclog@
    
    // @siclog "Step 8 - 9" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    // @siclog "Step 10 - 13" siclog@
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMT_Manual_SendINVITE_Receive18xResponse(MCPTT, -, GROUP_CALL, -, MANUAL);
    v_MessageHeader_Invite := v_InviteRequestWithSdp.Invite.msgHeader;

    // @siclog "Step 14" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) decline the call");

    // @siclog "Step 15" siclog@  - Temporarily Unavailable  480
    v_MessageHeader480 := f_IMS_InviteResponse_4XX_MessageHeaderRX(v_MessageHeader_Invite);
    v_MessageHeader480.warning := cr_Warning(399, "110 user declined the call invitation");  /* warn-code and text according to 24.379 Table 4.4.2-2: Warning texts defined for the Warning header field
                                                                                                @sic R5-240562 -> 24.379 clause 4.4.1, RFC 3261: Warning code = 399; warn-text =/  DQUOTE mcptt-warn-code SP mcptt-warn-text DQUOTE sic@  */
    f_IMS_ReceiveResponse(v_MessageHeader_Invite, v_InviteRequestWithSdp.RoutingInfo.Protocol, cr_Response(c_statusLine480, v_MessageHeader480));
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    // @siclog "Step 16" siclog@
    v_RequestUrl_Ack := v_InviteRequestWithSdp.Invite.requestLine.requestUri;                                   /* @sic R5-223954 change 3: ACK with condition NON-2XX sic@ */
    v_MessageHeader_Ack := f_IMS_AckRequest_MessageHeaderTX(v_InviteRequestWithSdp.Invite, c_statusLine480);    /* @sic R5-223954 change 3: ACK with condition NON-2XX sic@ */
    IMS_Client.send(cas_IMS_Ack_Request(v_InviteRequestWithSdp.RoutingInfo, cs_ACK_Request(v_RequestUrl_Ack, v_MessageHeader_Ack)));

    // After Step 16: SS releases the E-UTRA connection.
    f_MCX_IPCAN_ReleaseConnection();
     
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.5.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_5_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Group Call using pre-established session / Client originated Pre-established Session Release with associated MCPTT session / Client Originated (CO)
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX;
    var template (present) MCPTT_Info_Type v_McpttInfo;
    var MCX_CallType_Type v_CallType := GROUP_CALL;
                                          
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCPTT);        /* 36.579-1 clause 5.3.3 */
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_PreestablishedSession_InitiateCallUsingPreestablishedSession("Make the UE (MCPTT client) request the establishment of a group call using the pre-established session with automatic commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, PRE_ESTABLISHED, v_CallType, SDP_OFFER, withImplictGrantRequest);    /* Table 6.1.1.5.3.3-3B: 36.579-1 Table 5.5.3.3.1-1 conditions IMPLICIT_GRANT_REQUESTED */
    v_McpttInfo := f_MCX_CallControl_MCPTTInfo_RX(v_CallType, INVITE_REFER);                                    /* Table 6.1.1.5.3.3-2: 36.579-1 Table 5.5.3.2.2-1, condition GROUP-CALL, INVITE-REFER */
    f_MCPTT_PreestablishedSession_CallSetupMO(MCPTT, v_CallType, -, -, -, v_McpttInfo, -, v_SdpInfoRX);         /* 36.579-1 Table 5.3A.3.3-1 with no IMPLICIT_FLOOR_GRANTED in the SDP answer */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 2A" siclog@
    f_MCPTT_FloorControl_SendFloorGranted(NORMAL_CALL);    // @sic R5-217778: f_MCPTT_FloorControl_SendFloorGranted instead of f_MCPTT_FloorControl_SendFloorTaken sic@

    // @siclog "Step 3 - 6" Void siclog@

    // @siclog "Step 7 - 8" siclog@
    f_MCPTT_MCVideo_PreestablishedSession_CallReleaseMO(MCPTT);           /* 36.579-1 table 5.3A.4.3-1 */

    f_IMS_TestBody_Set(false);
    
    f_MCX_PreestablishedSession_ReleaseMT();
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.6.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_6_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Group Call using pre-established session / Automatic Commencement Mode / Server originated Pre-established Session Release with associated MCPTT session / Client Terminated (CT)
    var MCX_CallType_Type v_CallType := GROUP_CALL;
    
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCPTT);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_PreestablishedSession_CallSetupMT(v_CallType, tsc_MCPTT_PreestablishedSessionControl_AnswerState_Unconfirmed);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2" Void siclog@

    // @siclog "Step 3" siclog@
    f_MCPTT_PreestablishedSession_CallReleaseMT(v_CallType);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    f_IMS_TestBody_Set(false);
    
    f_MCX_PreestablishedSession_ReleaseMT();
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.8.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_8_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Broadcast Group Call / Client Originated (CO)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a broadcast group call with implicit floor request");

    // @siclog "Step 2" siclog@
    f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, BROADCAST, -, withImplictGrantRequest, implicitRequestRejected);   // 36.579-1 table 5.3A.1.3-1 NOTE1 b.iii
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
  
    // @siclog "Step 6 - 7" siclog@
    f_MCX_CallReleaseMT();
    
    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.9.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_9_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Broadcast Group Call / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_Manual(MCPTT, -, GROUP_CALL, BROADCAST);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2 - 7" Void siclog@

    // @siclog "Step 8" siclog@
    f_MCX_CallReleaseMT();
 
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.10.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_10_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Broadcast Group Call with Temporary Group / Client Originated (CO)
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX;
    var charstring v_TemporaryGroupID := px_MCPTT_Group_T_ID;
    var charstring v_ConstituentGroupId := px_MCPTT_Group_A_ID;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    f_MCX_IMS_TemporaryGroupNotification(MCPTT, CREATE, v_TemporaryGroupID, v_ConstituentGroupId);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a broadcast group call for temporary group T with implicit floor request");

    // @siclog "Step 2" siclog@
    v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, ON_DEMAND, GROUP_CALL, SDP_OFFER, withImplictGrantRequest);
    v_XmlBodies := f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(MCPTT, GROUP_CALL, BROADCAST);
    v_XmlBodies.McpttInfo.mcptt_Params.mcptt_request_uri := cr_MCPTT_Content_URI(v_TemporaryGroupID);           // according to Table 6.1.1.10.3.3-2
    v_XmlBodies.McpttInfo.mcptt_Params.associated_group_id := v_ConstituentGroupId;                             // according to Table 6.1.1.10.3.3-2 @sic R5-217779 sic@
    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_InviteMO_ReceiveINVITE(MCPTT, GROUP_CALL, BROADCAST, -, v_SdpInfoRX, v_XmlBodies);
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    f_MCX_InviteMO_Send100Trying(v_InviteRequestWithSdp);
    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(MCPTT, -, v_InviteRequestWithSdp, implicitRequestRejected);          // 36.579-1 Table 5.3A.1.3-1 option b.iii

    // @siclog "Step 3 - 5" Void siclog@
    
    // @siclog "Step 5A - 5B" Void siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, -, ACK_REQUIRED);

    // @siclog "Step 6" siclog@
    f_MCX_CallReleaseMT();
    
    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.11.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_11_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Emergency Group Call / Client Originated (CO)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a emergency group call with implicit floor request");

    // @siclog "Step 2" siclog@
    f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, EMERGENCY_CALL, -, withImplictGrantRequest, implicitRequestGranted);   // 36.579-1 table 5.3A.1.3-1 NOTE1 b.i
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 5" Void siclog@

    // @siclog "Step 5A" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the call has been established?", "Step 5A");
    
    // @siclog "Step 6" siclog@
    f_MCX_CallReleaseMT();
    
    // @siclog "Step 7" Void siclog@

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.12.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_12_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Emergency Group Call / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_Manual(MCPTT, -, GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 1A - 7A" Void siclog@

    // @siclog "Step 7B" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the emergency group call has been established?", "Step 7B");

    // @siclog "Step 8" siclog@
    f_MCX_CallReleaseMT();
 
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.13.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_13_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-arranged Imminent Peril Group Call / Client Originated (CO)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a imminent peril group call with implicit floor request");

    // @siclog "Step 2" siclog@
    f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, IMMPERIL_CALL, -, withImplictGrantRequest, implicitRequestGranted);  // 36.579-1 table 5.3A.1.3-1 NOTE1 b.i
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 5" Void siclog@

    // @siclog "Step 5A" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the call has been established and the floor has been granted to the user?", "Step 5A");
    
    // @siclog "Step 6" siclog@
    f_MCX_CallReleaseMT();
    
    // @siclog "Step 7" Void siclog@

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.14.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_14_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Pre-Arranged Imminent Peril Group Call / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_Manual(MCPTT, -, GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2 - 7A" Void siclog@
    
    // @siclog "Step 7B" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the imminent peril group call has been established?", "Step 7B");
    
    // @siclog "Step 8" siclog@
    f_MCX_CallReleaseMT();
 
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.16.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_16_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Emergency Alert / Client Terminated (CT)
    var template (value) MessageHeader v_MessageHeader;
    var template (value) MCPTT_Info_Type v_McpttInfo;
    var template (value) MCPTT_LocationInfo_Type v_LocationInfo;
    var integer v_Longitude := f_MCX_LocationInfo_Degrees2Longitude(px_MCX_CoordinateLongitude_Client_B);
    var integer v_Latitude  := f_MCX_LocationInfo_Degrees2Latitude(px_MCX_CoordinateLatitude_Client_B);
    var boolean v_ACCEPT_CONTACT_WITH_MEDIA_FEATURE_TAG := true;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SignallingOnly);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCX_IPCAN_StartSignalling(IPCAN_MT_IMS_Signalling);

    v_McpttInfo := f_MCX_CallControl_MCPTTInfo_TX();                                                            /* Table 6.1.1.16.3.3-1B: MCPTT-Info in SIP MESSAGE @sic R5-242353: no GROUP_CALL => no session-type sic@ */
    v_McpttInfo.mcptt_Params.mcptt_calling_group_id := f_MCPTT_Content_URI(px_MCPTT_Group_A_ID);                /* Table 6.1.1.16.3.3-1B: @sic R5-242353 sic@ */
    v_McpttInfo.mcptt_Params.alert_ind := cs_MCPTT_Content_True;                                                /* Table 6.1.1.16.3.3-1B: MCPTT-Info */
    v_McpttInfo.mcptt_Params.mc_org := px_MCX_DomainName_Organization_A;                                        /* Table 6.1.1.16.3.3-1B: @sic R5-242353 sic@ */

    v_LocationInfo := cs_MCPTT_LocationInfo_Report(v_Longitude, v_Latitude);                                    /* Table 6.1.1.16.3.3-1A: Location-Info in SIP MESSAGE */

    v_MessageHeader := f_MCX_MessageRequest_MessageHeaderTX(MCPTT, v_ACCEPT_CONTACT_WITH_MEDIA_FEATURE_TAG);    /* @sic R5-242353: condition ACCEPT-CONTACT-WITH-MEDIA-FEATURE-TAG sic@ */
    f_MCPTT_SendMESSAGEwithMIME_Receive200OK(v_MessageHeader, v_McpttInfo, -, -, v_LocationInfo);
    f_MCX_IPCAN_ReleaseConnection();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2" Void siclog@

    if (pc_MCX_DisplayInfoEmergencyAlert) {     // @sic R5-231942: pc_MCX_DisplayInfoEmergencyAlert sic@
      // @siclog "Step 3a1" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user of the emergency alert?", "Step 3a1");
    }

    // @siclog "Step 4" siclog@
    f_MCX_IPCAN_StartSignalling(IPCAN_MT_IMS_Signalling);
    v_McpttInfo.mcptt_Params.alert_ind := cs_MCPTT_Content_False;                                               /* Table 6.1.1.16.3.3-3A: MCPTT-Info in SIP MESSAGE */
    v_McpttInfo.mcptt_Params.mc_org := omit;                                                                    /* Table 6.1.1.16.3.3-3A @sic R5-242353 sic@ */
    f_MCPTT_SendMESSAGEwithMIME_Receive200OK(v_MessageHeader, v_McpttInfo);
    f_MCX_IPCAN_ReleaseConnection();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // @siclog "Step 5" Void siclog@

    if (pc_MCX_DisplayInfoEmergencyAlert) {     // @sic R5-231942: pc_MCX_DisplayInfoEmergencyAlert sic@
      // @siclog "Step 6a1" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user of the emergency alert cancellation?", "Step 6a1");
    }

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.17.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_17_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Broadcast Group Call using pre-established session / Client originated Pre-established Session Release with associated MCPTT session / Client Originated (CO)
    var template (present) MCPTT_Info_Type v_McpttInfo;
    var MCX_CallType_Type v_CallType := GROUP_CALL;
                                          
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCPTT);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_PreestablishedSession_InitiateCallUsingPreestablishedSession("Make the UE (MCPTT client) request the establishment of a broadcast group call using the pre-established session with automatic commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_McpttInfo := f_MCX_CallControl_MCPTTInfo_RX(v_CallType, INVITE_REFER, BROADCAST);                                         /* Table 6.1.1.17.3.3-2: 36.579-1 Table 5.5.3.2.2-1, condition BROADCAST-GROUP-CALL, INVITE-REFER */
    f_MCPTT_PreestablishedSession_CallSetupMO(MCPTT, v_CallType, -, -, -, v_McpttInfo);                                         /* 36.579-1 Table 5.3A.3.3-1 without SDP offer/answer */
 
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 5" Void siclog@

    // @siclog "Step 6 - 7" siclog@
    f_MCPTT_MCVideo_PreestablishedSession_CallReleaseMO(MCPTT);           /* 36.579-1 table 5.3A.4.3-1 */

    f_IMS_TestBody_Set(false);
    
    f_MCX_PreestablishedSession_ReleaseMT();
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.18.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_18_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Broadcast Group Call using pre-established session / Automatic Commencement Mode / Server originated Pre-established Session Release with associated MCPTT session / Client Terminated (CT)
    var MCX_CallType_Type v_CallType := GROUP_CALL;
                                          
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
