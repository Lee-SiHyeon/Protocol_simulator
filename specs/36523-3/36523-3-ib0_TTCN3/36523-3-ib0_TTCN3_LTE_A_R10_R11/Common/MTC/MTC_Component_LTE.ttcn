module MTC_Component_LTE {

  import from EUTRA_Component all;
  import from IP_PTC_Component all;
  import from MTC_Base all;
  import from NasEmu_Component_EUTRA all;

  type record MTC_LTE_Components_Type {             /* @status    APPROVED (IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */
    /* NOTE: there is no reference for IMS since ne IMS behaviour will happen when all RAT PTC are gone */
    EUTRA_PTC  Eutra
  };

  type component MTC_LTE extends MTC_BASE {     /* @status    APPROVED (IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */
    var MTC_LTE_Components_Type vc_Components;
  };

  type component SYSTEM_LTE extends MTC_BASE_SYSTEM, EUTRA_SYSTEM, NASEMU_EUTRA_SYSTEM, IP_SYSTEM {};     /* @status    APPROVED (IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */

}
