module EUTRA_OTDOA_NR_CoordMsg {

  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;

  type union E_OTDOA_NR_Coordination_MSG {        /* @status    APPROVED (POS) */
    E_OTDOA_NR_CoOrd_OtdoaInfo_Type    OtdoaInfo,  // EUTRA_OTDOA -> NR5GC
    Null_Type                          TriggerEvent
  };

  type record  E_OTDOA_NR_CoOrd_OtdoaInfo_Type {    /* @status    APPROVED (POS) */
    ECGI      Ecgi_RefCell,
    ECGI      Ecgi_Cell2,
    ECGI      Ecgi_Cell4,
    PRS_Info  PrsInfo
  };

  type port E_OTDOA_NR_CO_ORD_PORT message {    /* @status    APPROVED (POS) */
    out E_OTDOA_NR_Coordination_MSG;
    in  E_OTDOA_NR_Coordination_MSG;
  };

  group Templates {

  template (present) E_OTDOA_NR_Coordination_MSG cmr_E_OTDOA_NR_OtdoaInfo :=
  { /* @status    APPROVED (POS) */
    OtdoaInfo := {
      Ecgi_RefCell := ?,
      Ecgi_Cell2 := ?,
      Ecgi_Cell4 := ?,
      PrsInfo := ?
    }
  };

  template (present) E_OTDOA_NR_Coordination_MSG cmr_E_OTDOA_NR_Trigger :=
  { /* @status    APPROVED (POS) */
    TriggerEvent := true
  };

  template (value) E_OTDOA_NR_Coordination_MSG cms_E_OTDOA_NR_OtdoaInfo(ECGI     p_EcgiRefCell,
                                                                        ECGI     p_EcgiCell2,
                                                                        ECGI     p_EcgiCell4,
                                                                        PRS_Info p_PrsInfo) :=
  { /* @status    APPROVED (POS) */
    OtdoaInfo := {
      Ecgi_RefCell := p_EcgiRefCell,
      Ecgi_Cell2 := p_EcgiCell2,
      Ecgi_Cell4 := p_EcgiCell4,
      PrsInfo := p_PrsInfo
    }
  };

  template (value) E_OTDOA_NR_Coordination_MSG cms_E_OTDOA_NR_Trigger :=
  { /* @status    APPROVED (POS) */
    TriggerEvent := true
  };

  } // end of group Templates

  /*
   * @desc      to immediately detect programming errors (shall normally not happen)
   * @param     p_Port
   * @status    APPROVED (POS)
   */
  altstep a_E_OTDOA_NR_Default(E_OTDOA_NR_CO_ORD_PORT p_Port)
  {
    [] p_Port.receive {
      FatalError(__FILE__, __LINE__, "unexpected coordination message");
    }
  }

  /*
   * @desc      send message to the other PTC
   * @param     p_Port
   * @param     p_Msg
   * @status    APPROVED (POS)
   */
  function f_E_OTDOA_NR_SendCoOrd(E_OTDOA_NR_CO_ORD_PORT p_Port,
                                  template (value) E_OTDOA_NR_Coordination_MSG p_Msg)
  {
    p_Port.send(p_Msg);
  }

  /*
   * @desc      Wait for a coordination meessage from other PTC at the given port
   * @param     p_Port
   * @return    E_OTDOA_NR_CoOrd_OtdoaInfo_Type
   * @status    APPROVED (POS)
   */
  function f_E_OTDOA_NR_WaitForCoOrd_OtdoaInfo(E_OTDOA_NR_CO_ORD_PORT p_Port) return E_OTDOA_NR_CoOrd_OtdoaInfo_Type
  {
    var E_OTDOA_NR_Coordination_MSG v_ReceivedMsg;
    var E_OTDOA_NR_CoOrd_OtdoaInfo_Type v_OtdoaInfoRx;

    alt {
      [] p_Port.receive(cmr_E_OTDOA_NR_OtdoaInfo) -> value v_ReceivedMsg {
        v_OtdoaInfoRx := v_ReceivedMsg.OtdoaInfo;
      }
      [] a_E_OTDOA_NR_Default(p_Port) {}
    }
    return v_OtdoaInfoRx;
  }

  /*
   * @desc      Wait for a coordination meessage from other PTC at the given port
   * @param     p_Port
   * @status    APPROVED (POS)
   */
  function f_E_OTDOA_NR_WaitForCoOrd_Trigger(E_OTDOA_NR_CO_ORD_PORT p_Port)
  {
    alt {
      [] p_Port.receive(cmr_E_OTDOA_NR_Trigger) {}
      [] a_E_OTDOA_NR_Default(p_Port) {}
    }
  }

}
