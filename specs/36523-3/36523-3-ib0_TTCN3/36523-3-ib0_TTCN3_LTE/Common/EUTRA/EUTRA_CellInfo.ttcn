  /*
   * @desc      Set LocalEmergencyNumberList in the MobileInfo variable
   * @param     p_EmergencyNumberList
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_MobileInfo_SetLocalEmergencyNumberList(EmergencyNumList p_EmergencyNumberList) runs on EUTRA_PTC
  {
    vc_EUTRA_Global.MobileInfo.LocalEmergencyNumberList := p_EmergencyNumberList;
  }

  /*
   * @desc      Set PDN Type as assigned to the UE
   * @param     p_PdnIndex
   * @param     p_PdnType           (default value: '000'B)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_MobileInfo_SetAssignedPdnType(PDN_Index_Type p_PdnIndex,
                                                 B3_Type p_PdnType := '000'B) runs on EUTRA_PTC
  {
    var integer v_Index := f_PDN_PdnIndex2Integer(p_PdnIndex);
    vc_EUTRA_Global.MobileInfo.PdnInfo.AssignedPdnType[v_Index] := p_PdnType;
  }

  /*
   * @desc      Set PDN type to be used during initial registration
   * @param     p_PdnTypeToBeUsed
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_MobileInfo_SetPdnTypeToBeUsed(PDN_TypeToBeUsed_Type p_PdnTypeToBeUsed) runs on EUTRA_PTC
  {
    vc_EUTRA_Global.MobileInfo.PdnInfo.PdnTypeToBeUsed := p_PdnTypeToBeUsed;
  }

  /*
   * @desc      store NetworkFeatureSupport IE
   * @param     p_NetworkFeatureSupport
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_MobileInfo_SetNetworkFeatureSupport(template (omit) EPS_NetworkFeatureSupport p_NetworkFeatureSupport) runs on EUTRA_PTC
  {
    if (isvalue(p_NetworkFeatureSupport)) {
      vc_EUTRA_Global.MobileInfo.PdnInfo.NetworkFeatureSupport := valueof(p_NetworkFeatureSupport);
    } else {
      vc_EUTRA_Global.MobileInfo.PdnInfo.NetworkFeatureSupport := omit;
    }
  }

  /*
   * @desc      Set the EPS BearerContext in the MobileInfo variable
   * @param     p_BearerId
   * @param     p_PduSessionInfo    (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_MobileInfo_SetEPS_BearerContext(EPS_BearerIdentity p_BearerId,
                                                   template (omit) EUTRA_NR_PduSessionInfo_Type p_PduSessionInfo := omit) runs on EUTRA_PTC
  { /* @sic R5-199103: EpsBearerContextList instead of PdnIds sic@ */
    var template (value) EPS_BearerContext_Type v_EPS_BearerContext;  /* variable introduced to avoid need of "isvalue" checking for p_PduSessionInfo */
    var integer i := 0;

    if (isvalue(vc_EUTRA_Global.MobileInfo.PdnInfo.EpsBearerContextList)) {
      for (i := 0; i < lengthof(vc_EUTRA_Global.MobileInfo.PdnInfo.EpsBearerContextList); i := i + 1) {
        if (vc_EUTRA_Global.MobileInfo.PdnInfo.EpsBearerContextList[i].EPS_BearerId == p_BearerId) {
          break;
        }
      }
    }
    v_EPS_BearerContext.EPS_BearerId := p_BearerId;
    v_EPS_BearerContext.PduSessionInfo := p_PduSessionInfo;

    vc_EUTRA_Global.MobileInfo.PdnInfo.EpsBearerContextList[i] := valueof(v_EPS_BearerContext);
  }

  /*
   * @desc      Get UE  E-UTRA category
   * @return    charstring
   * @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12)
   */
  function f_EUTRA_MobileInfo_GetUECapability_UECategoryExtn() runs on EUTRA_PTC return charstring
  { /* @sic R5-142669,  R5-142681, R5-142690 R5-167569: handle CAT M1 return charstring sic@ */
    var charstring v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.ue_Category);

    //@sic R5s170303 int2char -> int2str sic@
    //ue-Category-v1020
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1020)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1020);
    }
    //ue-Category-v1170
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1170)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1170);
    }
    //ue-Category-v11a0 @sic R5-151413 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v11a0)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v11a0);
    }
    //ue-CategoryDL-r12 including cat0 @sic R5-151413 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_r12)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_r12);
    }
    // ue-CategoryDL-v1260 @sic R5-155970, R5s160342 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1260)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1260);
    }
    // ue-CategoryDL-v1310 @sic R5-167569 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1310)) {
      if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1310 == m1) {
        v_UE_Cat := "m1";
      } else { v_UE_Cat := "17";} // @sic R5-182907 sic@
    }
    // @sic R5-181144 sic@ ue-CategoryDL-v1330 UE DL CAT 18 and 19
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1330)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1330);
    }
  // @sic R5-182907 R5-182909 sic@ ue-CategoryDL-v1350 UE DL CAT onebis
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1350)) {
      if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1350 == oneBis){
          v_UE_Cat := "oneBis";
      }
    }
    // @sic R5-181144 sic@ ue-CategoryDL-v1450 UE DL CAT 20
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1450)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1450);
    }
    // @sic R5-185006 sic@ ue-CategoryDL-v1460 UE DL CAT 21
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1460)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1460);
    }
    return v_UE_Cat;
  }

  /*
   * @desc      Get UE  E-UTRA UL category
   * @return    charstring
   * @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12)
   */
  function f_EUTRA_MobileInfo_GetUECapability_UECategory_UL() runs on EUTRA_PTC return charstring
  { /* @sic R5-167569: handle CAT M1 return charstring sic@ */
    var charstring v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.ue_Category);
    //@sic R5s170303 int2char -> int2str sic@
    //ue-Category-v1020
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1020)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1020);
    }
    //ue-Category-v1170
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1170)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v1170);
    }
    //ue-Category-v11a0 @sic R5-151413 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v11a0)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_Category_v11a0);
    }
    //ue_CategoryUL_r12  @sic R5-155970 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_r12)) {
      v_UE_Cat := int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_r12);
    }
    //ue_CategoryUL_r13  @sic R5-167569 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1310)) {
      if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1310==m1) {
        v_UE_Cat := "m1";
      } else {v_UE_Cat :="14"; }
    }
  //ue_CategoryUL_v1340  Cat 15 @sic R5-182907 R5-182909 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1340)) {
      v_UE_Cat :=int2str(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1340)
       }
  //ue_CategoryUL_v1430  Cat 16-20 @sic R5-182907 R5-182909 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430)) {
      if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430 == n16) { v_UE_Cat := "16";}
      else if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430 == n17) { v_UE_Cat := "17";}
      else if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430 == n18) { v_UE_Cat := "18";}
      else if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430 == n19) { v_UE_Cat := "19";}
      else if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430 == n20) { v_UE_Cat := "20";}
        }
   //ue_CategoryUL_v1430b  Cat 21 @sic R5-182907 R5-182909 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1430b)) {v_UE_Cat := "21";}

    //ue_CategoryUL_v1350  @sic R5-182907 R5-182909 sic@
    if (isvalue(vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1350)) {
      if (vc_EUTRA_Global.MobileInfo.EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryUL_v1350 == oneBis) {
        v_UE_Cat := "oneBis";
      }
    }
    return v_UE_Cat;
  }

  /*
   * @desc      Get UE E-UTRA release
   * @return    AccessStratumRelease
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_EUTRA_MobileInfo_GetUECapability_AccessStratumRelease() runs on EUTRA_PTC return AccessStratumRelease
  {
    return vc_EUTRA_Global.MobileInfo.EUTRA_Capability.accessStratumRelease;
  }

