  //----------------------------------------------------------------------------
  testcase TC_11_3_1() runs on MTC_LTE system SYSTEM_LTE {
    // @purpose
    //   eCall Only mode / T3444 / eCall inactivity procedure after an eCall over IMS
    var EUTRA_PTC        v_EUTRA      := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(48600);
  
    v_EUTRA := EUTRA_PTC.create("EUTRA") alive;
    v_IMS1 := IMS_PTC.create("IMS1") alive;
    v_IMS2 := IMS_PTC.create("IMS2") alive;
  
    f_MTC_ConnectPTCs_LTE(system, v_EUTRA, v_IMS1, v_IMS2);
  
    v_EUTRA.start(f_TC_11_3_1_EUTRA());
    v_IMS1.start(f_TC_11_3_1_IMS1());
    v_IMS2.start(f_TC_11_3_1_IMS2());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_LTE(t_GuardTimer);
  }
