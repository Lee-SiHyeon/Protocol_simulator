  /*
   * @desc      Set the global record about TBF status to indicate DL TBF in progress
   *            and start 1.5 second timer (enough for IA in paging block to go out)
   * @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT)
   */
  function f_GERAN_DLTBFStatus_Set() runs on GERAN_PTC
  {
    vc_GERAN_Global.TBF.tbfStatus := DLTBF;
    tc_TBF.start (vc_GERAN_Global.TBF.t_DLTBFInprogress);
  }

  /*
   * @desc      Reset the TBF status as the timer has now timed out
   * @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT)
   */
  function f_GERAN_TBFStatus_Reset() runs on GERAN_PTC
  {
    vc_GERAN_Global.TBF.tbfStatus := NoTBF;
  }

