module NR_SecurityFunctions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_SecurityFunctions all;
  import from NAS_AuthenticationCommon all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_Parameters all;

  type record NR_SecurityParams_Type {          /* parameters related/used to/by NR authentication and security
                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    KDF_Type                KDF,
    B3_Type                 KSIamf,             // 3 bit KSIasme used when Authentication is performed by MME.
    B256_Type               Ks,                 // = Ck || IK
    B256_Type               KAMF,
    B256_Type               KGNB,
    B256_Type               NH,
    NextHopChainingCount    NCC,
    SK_Counter_Type         SK_Counter,
    B256_Type               S_KGNB,
    B32_Type                NonceMME,
    B32_Type                NonceUE,
    // AS Security structures
    NR_AS_IntegrityInfo_Type   AS_Integrity,
    NR_AS_CipheringInfo_Type   AS_Ciphering,
    // AS Security structures for SCG in NR-DC
    NR_AS_IntegrityInfo_Type   AS_Integrity_S,
    NR_AS_CipheringInfo_Type   AS_Ciphering_S
    
    // Note the Keys in the above AS Integrity/Ciphering are the truncated 128 bit keys
    // More fields to be added here
  };

  template (value) NR_AS_IntegrityInfo_Type cs_NR_AS_IntegrityInfo(IntegrityProtAlgorithm  p_Algo,
                                                                   B128_Key_Type p_RRC_Key,
                                                                   template (omit) B128_Key_Type p_UP_Key := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Algorithm         := p_Algo,      /* IntegrityProtAlgorithm_Type being defined in RRC ASN.1 */
    KRRCint           := p_RRC_Key,
    KUPint            := p_UP_Key,
    ActTimeList       := omit         /* => all SRBs shall be configured immediately */
  };

  template (value) NR_AS_CipheringInfo_Type cs_NR_AS_CipheringInfo(CipheringAlgorithm p_Algo,
                                                                   B128_Key_Type p_KeyRRC,
                                                                   B128_Key_Type p_KeyUP,
                                                                   template (value) NR_SecurityActTimeList_Type p_ActList) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Algorithm   := p_Algo,
    KRRCenc     := p_KeyRRC,
    KUPenc      := p_KeyUP,
    ActTimeList := p_ActList
  };

  template (value) NR_SecurityActTime_Type cs_NR_CipherAct_Null(NR_RadioBearerId_Type p_RBID) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RadioBearerId         := p_RBID,
    UL                    := { None := true },
    DL                    := { None := true }
  };

  template (value) NR_SecurityParams_Type cs_NR_SecurityParamsInit (IntegrityProtAlgorithm  p_RRC_IntegrityProtAlgorithm,
                                                                    CipheringAlgorithm      p_RRC_CipheringAlgorithm) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    KDF                := tsc_KDF_HMAC_SHA_256,
    KSIamf             := '111'B,        //un initialised
    Ks                 := tsc_AuthUndefinedB256,
    KAMF               := tsc_AuthUndefinedB256,
    KGNB               := tsc_AuthUndefinedB256,
    NH                 := tsc_AuthUndefinedB256,
    NCC                := 0, // Initial value
    SK_Counter         := 0, // Initial value
    S_KGNB             := tsc_AuthUndefinedB256,
    NonceMME           := tsc_AuthUndefinedB32,
    NonceUE            := tsc_AuthUndefinedB32,
    // AS Security structures
    AS_Integrity       :=  cs_NR_AS_IntegrityInfo (p_RRC_IntegrityProtAlgorithm, tsc_AuthUndefinedB128),
    AS_Ciphering       :=  cs_NR_AS_CipheringInfo(p_RRC_CipheringAlgorithm,
                                                  tsc_AuthUndefinedB128,
                                                  tsc_AuthUndefinedB128,
                                                  { cs_NR_CipherAct_Null(tsc_NR_RbId_SRB1),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB2),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB3) } ),
    // AS Security structures for SCG in NR-DC
    AS_Integrity_S       :=  cs_NR_AS_IntegrityInfo (p_RRC_IntegrityProtAlgorithm, tsc_AuthUndefinedB128),
    AS_Ciphering_S       :=  cs_NR_AS_CipheringInfo(p_RRC_CipheringAlgorithm,
                                                  tsc_AuthUndefinedB128,
                                                  tsc_AuthUndefinedB128,
                                                  { cs_NR_CipherAct_Null(tsc_NR_RbId_SRB1),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB2),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB3) } )
  };

  /*
   * @desc      to be called during initialisation of the NR PTC
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Security_Init() return NR_SecurityParams_Type
  {
    return valueof(cs_NR_SecurityParamsInit(px_NR_IntegrityProtAlgorithm, px_NR_CipheringAlgorithm));
  }

  /*
   * @desc      Function to be used for AS Key derivation for S-KgNB data encryption.
   * @param     p_Auth_Params
   * @param     p_ENDC              (default value: true)
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_InitAS_KeyChaining_SKgNB(NR_SecurityParams_Type p_Auth_Params, boolean p_ENDC := true) return NR_SecurityParams_Type
  { // removed f_EUTRA_NR_Authentication_S69 as same definition as A.8
    var NR_SecurityParams_Type v_Auth_Params := p_Auth_Params;
    
    // Derives KRRCenc key
    v_Auth_Params.AS_Ciphering_S.KRRCenc := f_NG_Authentication_A8(tsc_RRC_Enc_Alg,
                                                                   f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                   v_Auth_Params.S_KGNB,
                                                                   v_Auth_Params.KDF);
    // Derives KRRCenc key
    v_Auth_Params.AS_Ciphering_S.KUPenc := f_NG_Authentication_A8(tsc_UP_Enc_Alg,
                                                                  f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                  v_Auth_Params.S_KGNB,
                                                                  v_Auth_Params.KDF);
    // Derives KRRCint key
    v_Auth_Params.AS_Integrity_S.KRRCint := f_NG_Authentication_A8(tsc_RRC_Int_Alg,
                                                                   f_NR_ConvertIntAlg2Bitstring(v_Auth_Params.AS_Integrity.Algorithm),
                                                                   v_Auth_Params.S_KGNB,
                                                                   v_Auth_Params.KDF);
    if (not p_ENDC) { // Derives KUPint key. When true, do not calculate KUPint @sic R5-204475 sic@
      v_Auth_Params.AS_Integrity_S.KUPint := f_NG_Authentication_A8(tsc_N_UP_Int_Alg,
                                                                    f_NR_ConvertIntAlg2Bitstring(v_Auth_Params.AS_Integrity.Algorithm),
                                                                    v_Auth_Params.S_KGNB,
                                                                    v_Auth_Params.KDF);
    }
    return v_Auth_Params;
  }

  /*
   * @desc      Function to be used for AS Key derivation for KeNB data encryption on Nr side (for MN terminated DRBs).
   * @param     p_Auth_Params
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (ENDC)
   */
  function f_NR_InitAS_KeyChaining_KeNB(NR_SecurityParams_Type p_Auth_Params) return NR_SecurityParams_Type
  { // changed to update _S(CG) keys for NE-DC @sic R5w220012 sic@
    var NR_SecurityParams_Type v_Auth_Params := p_Auth_Params;
    // Derives KRRCenc key
    v_Auth_Params.AS_Ciphering_S.KRRCenc := f_EUTRA_NB_Authentication_S15(tsc_RRC_Enc_Alg,
                                                                        substr(f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),1,3),
                                                                        v_Auth_Params.S_KGNB,  //Containing KeNB
                                                                        v_Auth_Params.KDF);
    // Derives KRRCint key
    v_Auth_Params.AS_Integrity_S.KRRCint := f_EUTRA_NB_Authentication_S15(tsc_RRC_Int_Alg,
                                                                        substr(f_NR_ConvertIntAlg2Bitstring(v_Auth_Params.AS_Integrity.Algorithm),1,3),
                                                                        v_Auth_Params.S_KGNB,  //Containing KeNB
                                                                        v_Auth_Params.KDF);
    // Derives KRRCenc key
    v_Auth_Params.AS_Ciphering_S.KUPenc := f_EUTRA_NB_Authentication_S15(tsc_UP_Enc_Alg,
                                                                       substr(f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),1,3),
                                                                       v_Auth_Params.S_KGNB,  //Containing KeNB
                                                                       v_Auth_Params.KDF);
    return v_Auth_Params;
  }

  /*
   * @desc      Converts ASN.1 CipheringAlgorithm to bit string representation
   * @param     p_Alg
   * @return    B4_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertCiphAlg2Bitstring(CipheringAlgorithm p_Alg) return B4_Type
  {
    var B4_Type v_B4 := '1111'B;
    select (p_Alg) {
      case (nea0) {
        v_B4 := '0000'B;
      }
      case (nea1) {
        v_B4 := '0001'B;
      }
      case (nea2) {
        v_B4 := '0010'B;
      }
      case (nea3) {
        v_B4 := '0011'B;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Ciphering algorithm Selected");
      }
    }
    return v_B4;
  }

  /*
   * @desc      Converts ASN.1 IntegrityProtAlgorithm to bit string representation
   * @param     p_Alg
   * @return    B4_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertIntAlg2Bitstring(IntegrityProtAlgorithm p_Alg) return B4_Type
  {
    var B4_Type v_B4 := '1111'B;
    select (p_Alg) {
      case (nia1) {
        v_B4 := '0001'B;
      }
      case (nia2) {
        v_B4 := '0010'B;
      }
      case (nia3) {
        v_B4 := '0011'B;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Integrity algorithm Selected");
      }
    }
    return v_B4;
  }

}
