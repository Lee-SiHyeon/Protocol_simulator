module NR_PDCP_Templates {

  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from NR_PDCP_TypeDefs all;
  import from NR_Parameters all;
  import from TestcaseProperties all;

  template (value) NR_PDCP_DRB_Config_Parameters_Type cs_NR_PDCP_DRB_Config_Parameters(boolean p_IntegrityProtectionEnabled:= false):=
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_PDCP_DRB_Config_ParametersDef(f_NR_38508_SetPDCP_SN_Size(), f_NR_38508_SetPDCP_SN_Size(), p_IntegrityProtectionEnabled);

  template (value) NR_PDCP_DRB_Config_Parameters_Type cs_NR_PDCP_DRB_Config_ParametersDef(NR_PDCP_SN_Size_Type  p_SN_SizeUL,
                                                                                         NR_PDCP_SN_Size_Type  p_SN_SizeDL,
                                                                                         boolean p_IntegrityProtectionEnabled:= false) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SN_SizeUL := p_SN_SizeUL,
    SN_SizeDL := p_SN_SizeDL,
    HeaderCompression := { None  := true },
    IntegrityProtectionEnabled := p_IntegrityProtectionEnabled,
    OutOfOrderDelivery := true    //@sic R5w230213 sic@
  };

  /*
   * @desc      Configures the SN Size depending on settings and test case run
   * @return    NR_PDCP_SN_Size_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_38508_SetPDCP_SN_Size() return NR_PDCP_SN_Size_Type
  {
    if ( f_GetTestcaseAttrib_ENDC(testcasename()) or not(pc_supportOfRedCap_r17)) {   return PDCP_SNLength18;
    } else {  return PDCP_SNLength12;  }
  };

  template (value) NR_PDCP_RbConfig_Type cs_NR_PDCP_RbConfig_ParamsDRB(template (value) NR_PDCP_DRB_Config_Parameters_Type p_Params := cs_NR_PDCP_DRB_Config_Parameters) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Params := {
      Rb := {
        Drb := p_Params
      },
      DuplicateDiscarding := omit  //@sic R5w220109 sic@
    }
  };

  template (value) NR_PDCP_RbConfig_Type cs_NR_PDCP_RbConfig_ParamsSRB (template (omit) boolean p_ConfigureDuplicateDiscarding := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Params := {
      Rb := {
        Srb := true
      },
      DuplicateDiscarding := p_ConfigureDuplicateDiscarding  //@sic R5w220109 R5s220730 sic@
    }
  };

  template (value) NR_PDCP_Configuration_Type cs_NR_PDCP_Configuration_None :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    None := true
  };

  template (value) NR_PDCP_Configuration_Type cs_NR_PDCP_Configuration_RBTerminating(template (omit) NR_PDCP_RbConfig_Type p_RbConfig,
                                                                                     template (omit) RlcBearerRouting_Type p_LinkToOtherCellGroup := crs_RlcBearerRouting_None) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RBTerminating := {
      RbConfig := p_RbConfig,
      LinkToOtherCellGroup := p_LinkToOtherCellGroup
    }
  };

}
