module MAC_PowerSaving_TC_Common_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_BWP all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonFunctions_CA all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_DCI_Configuration all;
  import from NR_L2_Common all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

    template (value) DCP_Config_r16 cs_DCP_Config_r16_Def (template (omit) DCP_Config_r16.ps_WakeUp_r16  p_WakeUp:=  omit,
                                                           template (omit) DCP_Config_r16.ps_TransmitPeriodicL1_RSRP_r16 p_TransmitPeriodicL1_RSRP := omit,
                                                           template (omit) DCP_Config_r16.ps_TransmitOtherPeriodicCSI_r16 p_TransmitOtherPeriodicCSI := omit) :=
    { /* @status    APPROVED (ENDC, NR5GC) */
       ps_RNTI_r16 := tsc_C_RNTI_Value1,
       ps_Offset_r16 := 120,
       sizeDCI_2_6_r16 := 6,
       ps_PositionDCI_2_6_r16 := 0,
       ps_WakeUp_r16 := p_WakeUp,
       ps_TransmitPeriodicL1_RSRP_r16  := p_TransmitPeriodicL1_RSRP,
       ps_TransmitOtherPeriodicCSI_r16 := p_TransmitOtherPeriodicCSI
    }

    template (value) SearchSpaceExt_r16 cs_SearchSpaceExt_r16_Dci_Format2_6 :=
    { /* @status    APPROVED (ENDC, NR5GC) */
        controlResourceSetId_r16 := 1,
        searchSpaceType_r16 :=
        {
            common_r16 :=
            {
                dci_Format2_4_r16 := omit,
                dci_Format2_5_r16 := omit,
                dci_Format2_6_r16 := {} //No parameters
            }
        },
        searchSpaceGroupIdList_r16 := omit, //@sic R5-222362 sic@
        freqMonitorLocations_r16 := omit    //@sic R5-222362 sic@
    }

    template (value) NR_DciFormat_2_6_Type cs_NR_DciFormat_2_6_Type (template (value) NR_DciFormat_2_6_Block_List_Type p_NR_DciFormat_2_6_Block_List):=
    { /* @status    APPROVED (ENDC, NR5GC) */
        BlockList := p_NR_DciFormat_2_6_Block_List
    }

    template (value) NR_DciFormat_2_6_Block_Type cs_NR_DciFormat_2_6_Block_Type (B1_Type p_WakeUP := '0'B,
                                                                                 template (value) NR_DciCommon_SCellDormancyIndication_Type p_SCellDormacyIndication := cs_NR_DciFormat_X_1_SCellDormancyIndication_None):=
    { /* @status    APPROVED (ENDC, NR5GC) */
        WakeupIndication := p_WakeUP,
        SCellDormancyIndication := p_SCellDormacyIndication //@sic R5w240308 sic@
    }

   template (value) NR_DciCommon_SCellDormancyIndication_Type cs_NR_DciFormat_2_6_SCellDormancyIndication_Value (bitstring p_BitValue) := { Value := p_BitValue }; /* @status    APPROVED (NR5GC)
                                                                                                                                                                      @sic R5w240308 sic@ */

    template (value) NR_SYSTEM_CTRL_REQ cads_NR_DciTrigger_WakeUP_REQ(NR_CellId_Type  p_NR_CellId,
                                                                      template (value) TimingInfo_Type p_TimingInfo,
                                                                      template (value) NR_DciFormat_2_6_Block_List_Type p_NR_DciFormat_2_6_Block_List,
                                                                      template (value) NR_AssignedBWPs_Type p_NR_AssignedBWPs_Type := cs_NR_AssignedBWPs_InitialBWP)
    modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, tsc_NoCnfReq),
    Request := {
      DciTrigger := {
        AssignedBWPs := p_NR_AssignedBWPs_Type,
        SearchSpaceType := cssType3,
        DciFormat := {
          DciFormat_2_6 := cs_NR_DciFormat_2_6_Type(p_NR_DciFormat_2_6_Block_List)
        }
      }
    }
  };

  template (value) NR_DciFormat_2_6_Block_List_Type cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast (B1_Type p_WakeUP1 := '0'B,
                                                                                                       B1_Type p_WakeUP6 := '0'B) :=
    { /* @status    APPROVED (ENDC, NR5GC) */
        cs_NR_DciFormat_2_6_Block_Type(p_WakeUP1),
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type(p_WakeUP6)
    }

    template (value) NR_DciFormat_2_6_Block_List_Type cs_NR_DciFormat_2_6_Block_List_5Items ( B1_Type p_WakeUP := '1'B,
                                                                                            bitstring p_SCellDormacyIndicationBitValue := '0'B

                                                                                           ) :=
    { /* @status    APPROVED (NR5GC) */
        cs_NR_DciFormat_2_6_Block_Type(p_WakeUP, cs_NR_DciFormat_2_6_SCellDormancyIndication_Value(p_SCellDormacyIndicationBitValue)),
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type,
        cs_NR_DciFormat_2_6_Block_Type
    }

    template (value) DormantBWP_Config_r16 cs_NR_DormantBWP_Config_r16_Setup_OutsideActiveTime(template (omit) BWP_Id p_BWP_Id,
                                                                                               template (value) OutsideActiveTimeConfig_r16 p_OutsideActiveTimeConfig := cs_OutsideActiveTimeConfig_r16 ) :=
    { /* @status    APPROVED (NR5GC) */
        dormantBWP_Id_r16 := p_BWP_Id,
        withinActiveTimeConfig_r16 := omit,
        outsideActiveTimeConfig_r16 :=
        {
            setup := p_OutsideActiveTimeConfig
        }
    }

  template (value) OutsideActiveTimeConfig_r16 cs_OutsideActiveTimeConfig_r16 (template (omit) BWP_Id p_BWP_Id := 0,
                                                                               template (omit) DormancyGroupID_r16 p_DormancyGroupID := 0)
      := { /* @status    APPROVED (NR5GC) */
      firstOutsideActiveTimeBWP_Id_r16 := p_BWP_Id,
      dormancyGroupOutsideActiveTime_r16 := p_DormancyGroupID
    }

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_CSS_DCI_2_6( template (value) SearchSpace p_SearchSpace) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    TypeAndPriorityList :={ tsc_NR_SearchSpaceTypeAndPriority_CssType3},
    AggregationLevel := AggregationLevel4,
    SearchSpaceConfigAtUE := {
      R15 := p_SearchSpace,
      R16 := cs_SearchSpaceExt_r16_Dci_Format2_6,
      R17 := omit,
      R18 := omit
    }
  };

  /*
   * @desc      Get timing of a wake up signal
   * @param     p_NextOccasion      (by reference)
   * @param     p_NR_CellId
   * @param     p_LongDRXCycle
   * @param     p_DrxStartOffset
   * @param     p_CycleAhead        (default value: 0)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetWakeUpSignalTiming(out SubFrameTiming_Type p_NextOccasion,
                                      NR_CellId_Type p_NR_CellId,
                                      UInt_Type p_LongDRXCycle,
                                      UInt_Type p_DrxStartOffset,
                                      integer p_CycleAhead := 0) runs on NR_BASE_PTC return SubFrameTiming_Type
  {//@sic R5s230001 sic@

      var SubFrameTiming_Type v_WakeUpTiming;
      var SubFrameTiming_Type v_DrxActiveTiming;
      var PhysicalCellGroupConfig v_PhysicalCellGroupConfig;
      var float v_PS_Offset_ms;
      var NR_SchedulingParameters_Type v_SchedulingParameters := f_NR_SchedulingParameters_DL();

      v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(p_NR_CellId);
      v_PS_Offset_ms := int2float(v_PhysicalCellGroupConfig.dcp_Config_r16.setup.ps_Offset_r16) * 0.125;

      v_DrxActiveTiming := f_NR_GetNextSendOccasion_7_1_1_5_X(p_NR_CellId, p_LongDRXCycle, p_DrxStartOffset, -, p_CycleAhead);
      v_WakeUpTiming := f_SubFrameTiming_SubstractMilliSeconds(v_DrxActiveTiming, v_PS_Offset_ms); //@sic R5s230309 Ch.6 R5s230508 Ch3 sic@

      p_NextOccasion := f_NR_NextPdcchOcassion(p_NR_CellId, v_DrxActiveTiming.HSFN, v_DrxActiveTiming.SFN, v_DrxActiveTiming.Subframe.Number, v_SchedulingParameters);

      return v_WakeUpTiming;
  }

   /*
   * @desc      Get MAC PDUList to be sent
   * @param     p_SN
   * @param     p_DRBId
   * @return    template (value) NR_MAC_PDUList_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetMAC_PDUListDL(integer p_SN,
                                 DRB_Identity p_DRBId ) return template (value) NR_MAC_PDUList_Type
  {
      var NR_MAC_SDU_Type v_EncodedRlcPdu;
      var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
      var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
      var B6_Type v_LCID_SCG_Bearer := int2bit(p_DRBId +3, 6);
      var template (value) NR_PDCP_PDU_Type v_PDCP_PDU;

      v_PDCP_PDU := f_NR_ReturnDefaultPDCP_PDU(p_SN, crs_NR_PDCP_SDU_36B);
      v_EncodedRlcPdu := f_NR_RLC_AMD_FullPDU_Encvalue(p_SN, tsc_NR_P_NoPoll, f_NR_PDCP_PDU_Encvalue(v_PDCP_PDU));
      v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(v_LCID_SCG_Bearer, v_EncodedRlcPdu) };
      v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };

      return v_MAC_PDUListDL;
  }

  /*
   * @desc      Returns default DRX Config setup based on 38.508-1 Table 4.6.3-56 for a given cell
   * @param     p_NR_CellId
   * @return    template (value) MAC_CellGroupConfig.drx_Config
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetDefaultDRXConfigSetup(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) MAC_CellGroupConfig.drx_Config
  {

    var template (value) MAC_CellGroupConfig.drx_Config  v_DRX_Config;

    if(f_NR_CellInfo_GetIsFR1(p_NR_CellId))
    {
        v_DRX_Config := cs_NR_DRX_Config_Setup (cs_38508_DRX_Config_FR1);

    }
    else
    {
        v_DRX_Config := cs_NR_DRX_Config_Setup (cs_38508_DRX_Config_FR2);

    }

    return v_DRX_Config

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.3
   * @param     p_CellGroupId
   * @return    template (value) CellGroupConfig
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_12_3_NR_GetCellGroupConfigForStep1(CellGroupId p_CellGroupId) runs on NR_BASE_PTC return template (value) CellGroupConfig
  {//@sic R5s230309 sic@
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    var template (value) PhysicalCellGroupConfig v_PhysicalCellGroupConfig;
    var template (value) ControlResourceSet v_ControlResourceSet;
    var template (value) SpCellConfig v_SpCellConfig;
    var template (value) NR_DownlinkBWP_Type v_DownlinkBWP ;
    var template (value) SearchSpace v_SearchSpace;
    var integer v_SearchSpaceIndex_DCI_2_6;
    var template (value) ServingCellConfig v_ServingCellConfig;


    //Table 7.1.1.12.3.3.3-2
    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(nr_Cell1);
    v_MAC_CellGroupConfig.drx_Config := f_NR_GetDefaultDRXConfigSetup(nr_Cell1); //@sic R5s230309 sic@

    f_NR_CellInfo_SetMAC_CellGroupConfig(nr_Cell1, v_MAC_CellGroupConfig);

    v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(nr_Cell1);
    v_PhysicalCellGroupConfig.dcp_Config_r16.setup := cs_DCP_Config_r16_Def;
    f_NR_CellInfo_SetPhysicalCellGroupConfig(nr_Cell1, v_PhysicalCellGroupConfig); //@sic R5s230001 Ch1.1 sic@
    f_NR_SS_ServingCellConfig(nr_Cell1, -, cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfig(omit, omit, omit, v_PhysicalCellGroupConfig))); //@sic R5s230001 Ch1.2, R5s230309 Ch 4.1 sic@

    //Table 7.1.1.12.3.3.3-4
    v_ServingCellConfig := f_NR_GetServingCellConfig(nr_Cell1);    //@sic R5s230309 Ch 4.2 sic@
    v_SpCellConfig := f_NR_GetSpCellConfigDef(nr_Cell1, v_ServingCellConfig); //@sic R5s230309 Ch 4.2 sic@
    v_ControlResourceSet := f_NR_CellInfo_GetControlResourceSet(nr_Cell1, tsc_NR_ControlResourceSetId, tsc_NR_BWP_Id);
    v_ControlResourceSet.controlResourceSetId := 1;
    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.controlResourceSetToAddModList := {v_ControlResourceSet}

    v_SearchSpace := f_NR_CellInfo_GetSearchSpaceConfigAtUE(nr_Cell1, tsc_NR_SearchSpaceId_CSS, tsc_NR_BWP_Id);  //@sic R5s230309 sic@
    v_SearchSpace.searchSpaceId := tsc_NR_SearchSpaceId_DCI_2_6;  //@sic R5s230309 sic@
    v_SearchSpace.controlResourceSetId := 1;
    v_SearchSpace.searchSpaceType := cs_NR_SearchSpace_SearchSpaceType_CSS_AllOmit;
    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.searchSpacesToAddModList[0] := v_SearchSpace;     //@sic R5s230001 Ch1.3, R5-231902 sic@
    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.searchSpacesToAddModListExt_r16 [0] := cs_SearchSpaceExt_r16_Dci_Format2_6; //@sic R5s230309, R5-233317 sic@
    v_SpCellConfig.spCellConfigDedicated.tag_Id := 0; //@sic R5s230309 sic@

    v_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(nr_Cell1, tsc_NR_BWP_Id);
    v_SearchSpaceIndex_DCI_2_6 := lengthof(v_DownlinkBWP.Pdcch.SearchSpaceArray);  //@sic 230309 sic@
    v_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_DCI_2_6] := cs_NR_BWP_SearchSpaceConfig_CSS_DCI_2_6(v_SearchSpace); //@sic R5s230309 sic@
    f_NR_CellInfo_SetDownlinkBWP(nr_Cell1, v_DownlinkBWP, tsc_NR_BWP_Id);  //@sic R5s230001 Ch.1.3 sic@
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DL_BWP_ConfigCommon_REQ(nr_Cell1, -,{v_DownlinkBWP})); //@sic R5s230309 Ch.1.5 sic@


    v_CellGroupConfig := cs_38508_CellGroupConfig (p_CellGroupId,
                                                   -,
                                                   -,
                                                   v_MAC_CellGroupConfig,
                                                   v_PhysicalCellGroupConfig,
                                                   v_SpCellConfig);

    return v_CellGroupConfig;

  } // End f_TC_7_1_1_12_3_NR_GetCellGroupConfigForStep1

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.3
   * @param     p_LongDRXCycle
   * @param     p_DrxStartOffset
   * @param     p_DRBId
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_12_3_NR_Steps3_6(UInt_Type p_LongDRXCycle,
                                       UInt_Type p_DrxStartOffset,
                                       DRB_Identity p_DRBId) runs on NR_BASE_PTC
  {//DRX adaptation / UE wakeup indication

     var SubFrameTiming_Type v_WakeUpTiming;
     var SubFrameTiming_Type v_NextOccasion;
     var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
     var  integer v_Duration;

     timer t_Watchdog;

    f_NR_ULGrantConfiguration_Start(nr_Cell1,-, -, -, cs_NR_UplinkTimeAlignment_Stop); //@sic R5s230001 Ch2.1 sic@

    // suppress number of DL retransmissions:
    f_NR_SS_CellConfig_DciDlInfo_NoRetransmission(nr_Cell1);
    // to configure SS to report reception of HARQ ACK or NACK
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable));

    //@siclog Step 3 siclog@
    //Wait 1280ms to ensure UE is out DRX active time
    f_Delay(1.28);

    //@siclog Steps 3A siclog@
    //The SS transmits DCI 2-6 on the PDCCH within the PS-offset time before the start of next long DRX drx-onDurationTimer and the DCI 2-6 indicates not to start the next Drx-onDurationTimer.
    v_WakeUpTiming := f_NR_GetWakeUpSignalTiming (v_NextOccasion, nr_Cell1, p_LongDRXCycle, p_DrxStartOffset);
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DciTrigger_WakeUP_REQ(nr_Cell1, cs_TimingInfo_NR(v_WakeUpTiming), cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast)); //off @sic R5s230001 Ch2.3 sic@

     v_Duration := f_SubFrameTiming_Duration(f_NR_GetCurrentTiming(nr_Cell1), v_NextOccasion); //@sic R5s230001 Ch2.2 sic@
    //@siclog Steps 3B siclog@
    //In a PDCCH occasion the SS indicates the transmission of a DL MAC PDU on the PDCCH.
    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(0, p_DRBId);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_NextOccasion), v_MAC_PDUListDL)); //@sic R5s230001 Ch2.3 sic@

    t_Watchdog.start(0.001 * int2float(v_Duration) + 1.0);  //@sic R5s230001 Ch2.2 sic@
    alt
    {
       [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, ack))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3B");
            t_Watchdog.stop;
        }
       [] t_Watchdog.timeout
        {}
    }


    //@siclog Steps 4 siclog@
    //The SS transmits DCI 2-6 on the PDCCH within the PS-offset time before the start of next long DRX drx-onDurationTimer and the DCI 2-6 indicates to start the next Drx-onDurationTimer.
    v_WakeUpTiming := f_NR_GetWakeUpSignalTiming (v_NextOccasion, nr_Cell1, p_LongDRXCycle, p_DrxStartOffset); //@sic R5s230001 Ch2.3 sic@
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DciTrigger_WakeUP_REQ(nr_Cell1, cs_TimingInfo_NR(v_WakeUpTiming),cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast('1'B)));

    //@siclog Steps 5 siclog@
    // In the first PDCCH occasion when the Drx-onDurationTimer is running, the SS indicates the transmission of a DL MAC PDU on the PDCCH.
    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(1, p_DRBId);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_NextOccasion), v_MAC_PDUListDL)); //@sic R5s230001 Ch2.3 sic@

    //@siclog Steps 6 siclog@
    //Check: Does the UE transmit a HARQ ACK for  the DL MAC PDU in Step 5?
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, ack));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable)); //@sic R5s230001 Ch2.4 sic@

  } // End f_TC_7_1_1_12_3_NR_Steps3_6

  /*
   * @desc      Steps 9 to 11 in TS 38.523-1 clause 7.1.1.12.3
   * @param     p_LongDRXCycle
   * @param     p_DrxStartOffset
   * @param     p_DRBId
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_12_3_NR_Steps9_11(UInt_Type p_LongDRXCycle,
                                      UInt_Type p_DrxStartOffset,
                                      DRB_Identity p_DRBId) runs on NR_BASE_PTC
  {//DRX adaptation / UE wakeup indication

     var SubFrameTiming_Type v_Timing;
     var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
     var NR_SchedulingParameters_Type v_SchedulingParameters := f_NR_SchedulingParameters_DL(); //@sic R5s230001 sic@

    //@siclog Step 9 siclog@
    //Wait 1280ms to ensure UE is out DRX active time
    f_Delay(1.28);  //@sic R5-233467 sic@

    //to configure SS to report reception of HARQ ACK or NACK
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable));  //@sic R5s230001, R5s240658 sic@

    //@siclog Steps 10 siclog@
    //In the first PDCCH occasion when the Drx-onDurationTimer is running, the SS indicates the transmission of a DL MAC PDU on the PDCCH.
    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(2, p_DRBId);
    v_Timing := f_NR_GetNextSendOccasion_7_1_1_5_X(nr_Cell1, p_LongDRXCycle, p_DrxStartOffset);
    v_Timing := f_NR_NextPdcchOcassion(nr_Cell1, v_Timing.HSFN, v_Timing.SFN, v_Timing.Subframe.Number, v_SchedulingParameters); //@sic R5s230001 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_Timing), v_MAC_PDUListDL));

    //@siclog Steps 11 siclog@
    //Check: Does the UE transmit a HARQ ACK for  the DL MAC PDU in Step 10?
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, ack));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable)); //@sic R5s230001 sic@

  } // End f_TC_7_1_1_12_3_NR_Steps9_11

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.3 steps 14-19
   * @param     p_LongDRXCycle
   * @param     p_DrxStartOffset
   * @param     p_DRBId
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_12_3_NR_Steps14_19(UInt_Type p_LongDRXCycle,
                                      UInt_Type p_DrxStartOffset,
                                      DRB_Identity p_DRBId) runs on NR_BASE_PTC
  {//DRX adaptation / UE wakeup indication

     var SubFrameTiming_Type v_WakeUpTiming;
     var SubFrameTiming_Type v_Timing;
     var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
     var integer v_SlotsInSubframe;
     var integer v_DRC_onDurationTimer;
     var PhysicalCellGroupConfig v_PhysicalCellGroupConfig;
     var float v_PS_Offset_ms;

     timer t_Watchdog := 5.0;

    //@siclog Step 14 siclog@
    //Wait 400ms to ensure UE is out DRX active time.
    f_Delay(0.4);  //@sic R5s230309, R5-233467 sic@

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable)); //@sic R5s230001, R5s250196 sic@


    //@siclog Step 15 siclog@
    //The SS transmits DCI 2-6 on the PDCCH within the PS-offset time before the start of next long DRX drx-onDurationTimer and the DCI 2-6 indicates to start the next Drx-onDurationTimer.
    v_Timing := f_NR_GetNextSendOccasion_7_1_1_5_X (nr_Cell1, p_LongDRXCycle, p_DrxStartOffset, -, 13); //@sic R5s230001 sic@
    v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(nr_Cell1);
    v_PS_Offset_ms := int2float(v_PhysicalCellGroupConfig.dcp_Config_r16.setup.ps_Offset_r16)*0.125;
    v_WakeUpTiming := f_SubFrameTiming_SubstractMilliSeconds(v_Timing, v_PS_Offset_ms);//@sic R5s230001, R5s230309 Ch.6, R5s230508 Ch3 sic@
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DciTrigger_WakeUP_REQ(nr_Cell1, cs_TimingInfo_NR(v_WakeUpTiming),cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast('1'B)));

    //@siclog Step 16 siclog@
    //In the last PDCCH occasion when the Drx-onDurationTimer is running, the SS indicates the transmission of an invalid DL MAC PDU on the PDCCH.
    f_NR_SS_L1_TestModeConfig(nr_Cell1, cas_NR_L1_TestMode_DL_SCH_CRC_REQ(nr_Cell1, Erroneous));

    // Last PDCCH occasion while On Duration Timer is running.
    v_SlotsInSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(nr_Cell1) ;

    v_DRC_onDurationTimer := 10;  //Table 7.1.1.12.3.3.3-6
    v_Timing := f_NR_SubFrameTiming_AddSlots(v_Timing, (v_DRC_onDurationTimer * v_SlotsInSubframe) - 1);
    // - the last slot during onDurationTimer
    v_Timing := f_NR_LastDL_Slot(nr_Cell1,v_Timing);

    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(3, p_DRBId);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_Timing), v_MAC_PDUListDL, cs_NR_HarqProcessAssignment));

    //@siclog "Step 17A" siclog@
    //The SS transmits DCI 2-6 on the PDCCH within the PS-offset time before the start of next long DRX drx-onDurationTimer and the DCI 2-6 indicates not to start the next Drx-onDurationTimer.
    v_WakeUpTiming := f_SubFrameTiming_AddMilliSeconds(v_WakeUpTiming, p_LongDRXCycle * 2); //@sic R5s230001 sic@
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DciTrigger_WakeUP_REQ(nr_Cell1, cs_TimingInfo_NR(v_WakeUpTiming),cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast));

    //@siclog "Step 18" siclog@
    //In the PDCCH occasion when the next Drx-onDurationTimer is running, the SS indicates the transmission of a DL MAC PDU on the PDCCH.
    v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing ,p_LongDRXCycle*2); //@sic R5s230001, R5s230308 sic@
    f_NR_SS_L1_TestModeConfig(nr_Cell1, cas_NR_L1_TestMode_DL_SCH_CRC_REQ(nr_Cell1, Normal,cs_TimingInfo_NR(v_WakeUpTiming))); //@sic R5s230001 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_Timing), v_MAC_PDUListDL, cs_NR_HarqProcessAssignment));

    t_Watchdog.start;
    //@siclog "Step 17" siclog@
    // The UE transmit a HARQ NACK for the DL MAC PDU in Step 16.
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, nack));

    //@siclog "Step 19" siclog@
    //Check: Does the UE transmit a HARQ ACK for  the DL MAC PDU in Step 18?

    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, ack));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");
    t_Watchdog.stop;
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable));  //@sic R5s230001 sic@

  } // End f_TC_7_1_1_12_3_NR_Steps14_19

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.3 steps 22-24
   * @param     p_LongDRXCycle
   * @param     p_DrxStartOffset
   * @param     p_DRBId
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_12_3_NR_Steps22_24(UInt_Type p_LongDRXCycle,
                                      UInt_Type p_DrxStartOffset,
                                      DRB_Identity p_DRBId
                                      ) runs on NR_BASE_PTC
  {//DRX adaptation / UE wakeup indication

     var SubFrameTiming_Type v_WakeUpTiming;
     var SubFrameTiming_Type v_NextOccasion;
     var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;

    //@siclog Step 22 siclog@
    //Wait 10ms to ensure UE is out DRX active time.
    f_Delay(0.01);

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable));  //@sic R5s230001, R5s230309 Ch5 sic@

    //@siclog Step 22A siclog@
    //The SS transmits DCI 2-6 on the PDCCH within the PS-offset time before the start of next long DRX drx-onDurationTimer and the DCI 2-6 indicates not to start the next Drx-onDurationTimer.
    v_WakeUpTiming := f_NR_GetWakeUpSignalTiming (v_NextOccasion, nr_Cell1, p_LongDRXCycle, p_DrxStartOffset, 3); //@sic R5s230001 sic@
    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DciTrigger_WakeUP_REQ(nr_Cell1, cs_TimingInfo_NR(v_WakeUpTiming),cs_NR_DciFormat_2_6_Block_List_6Items_FirstOrLast));

    //@siclog Step 23 siclog@
    //In the first PDCCH occasion when the Drx-onDurationTimer is running, the SS indicates the transmission of a DL MAC PDU on the PDCCH.
    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(4, p_DRBId);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_DRBId, cs_TimingInfo_NR(v_NextOccasion), v_MAC_PDUListDL)); //@sic R5s230001 sic@

    //@siclog Step 24 siclog@
    //Check: Does the UE transmit a HARQ ACK for  the DL MAC PDU in Step 23?
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(nr_Cell1, ack));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 24");

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable)); //@sic R5s230001 sic@

  } // End f_TC_7_1_1_12_3_NR_Steps20_24

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.4
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_SCellIndex
   * @return    template
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_1_12_4_NR_GetCellGroupConfigForStep1(NR_CellId_Type    p_PCell,
                                                         NR_CellId_Type    p_SCell,
                                                         SCellIndex        p_SCellIndex)
    runs on NR_BASE_PTC return template (value) CellGroupConfig
  {//DRX adaptation / SCell dormancy indication
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) SCellConfig v_SCellConfig;
    var template (omit) ServingCellConfigCommon v_ServingCellConfigCommon;
    var template (value) BWP_DownlinkDedicated v_BWP_DownlinkDedicated;
    var template (value) BWP_Downlink  v_BWP_Downlink;
    var template (value) PhysicalCellGroupConfig v_PhysicalCellGroupConfig;
    var template (value) SpCellConfig v_SpCellConfig;
    var template (value) ControlResourceSet v_ControlResourceSet;
    var template (value) ServingCellConfig v_SCellConfigDedicated;
    var template (value) DormantBWP_Config_r16 v_DormantBWP_Config;
    var SearchSpace v_SearchSpaceUSS;
    var template (omit) PDCCH_Config.controlResourceSetToAddModList v_ControlResourceSetToAddModList;
    var template (omit) BWP_DownlinkDedicated.pdcch_Config v_PDCCH_Config;

    var template (value) NR_DownlinkBWP_Type v_DownlinkBWP ;
    var template (omit) ServingCellConfig v_ServingCellConfig;
    var template (value) PDSCH_TimeDomainResourceAllocationList v_PDSCH_TimeDomainResourceAllocationList;
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var template (value) PDSCH_Config v_PDSCH_Config;
    var SSB_Index v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_SCell);
    var template(value) SearchSpace v_SearchSpace;
    var template (value) DMRS_DownlinkConfig v_DMRS_DownlinkConfig;
    var template (omit) BWP_DownlinkDedicated.pdsch_Config v_BWP_DownlinkDedicated_PDSCH_Config;
    var integer v_SearchSpaceIndex_DCI_2_6;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig := cs_NR_MAC_CellGroupConfig;


    //Table 7.1.1.12.4.1.3.3-2
    v_CellGroupConfig := f_NR_GetSCGConfig_SCellAdd(p_SCell, p_SCellIndex);  /*@sic R5s250070 sic@*/

    //configure DRX
    if(f_NR_CellInfo_GetIsFR1(p_PCell))
    {
       v_MAC_CellGroupConfig.drx_Config := cs_NR_DRX_Config_Setup (cs_38508_DRX_Config_FR1);

    }
    else
    {
        v_MAC_CellGroupConfig.drx_Config := cs_NR_DRX_Config_Setup (cs_38508_DRX_Config_FR2);

    }
    f_NR_CellInfo_SetMAC_CellGroupConfig(p_PCell, v_MAC_CellGroupConfig);
    v_CellGroupConfig.mac_CellGroupConfig := v_MAC_CellGroupConfig;

    //configure DCP
    v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(p_PCell);
    v_PhysicalCellGroupConfig.dcp_Config_r16.setup := cs_DCP_Config_r16_Def;
    f_NR_CellInfo_SetPhysicalCellGroupConfig(nr_Cell1, v_PhysicalCellGroupConfig);
    f_NR_SS_ServingCellConfig(p_PCell, -, cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfig(omit, omit, omit, v_PhysicalCellGroupConfig)));  //@sic R5s240686 Ch.2.1 sic@
    v_CellGroupConfig.physicalCellGroupConfig := v_PhysicalCellGroupConfig;

    v_ServingCellConfig := f_NR_GetServingCellConfig(p_PCell); //@sic R5s240686 Ch.2.2 sic@
    v_SpCellConfig := f_NR_GetSpCellConfigDef(p_PCell, v_ServingCellConfig); //@sic R5s240686 Ch.2.2 sic@

    v_ControlResourceSet := f_NR_CellInfo_GetControlResourceSet(p_PCell, tsc_NR_ControlResourceSetId, tsc_NR_BWP_Id);
    v_ControlResourceSet.controlResourceSetId := tsc_NR_ControlResourceSetId;
    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.controlResourceSetToAddModList := {v_ControlResourceSet};

    v_SearchSpace := f_NR_CellInfo_GetSearchSpaceConfigAtUE(p_PCell, tsc_NR_ControlResourceSetId, tsc_NR_BWP_Id); //@sic R5s240686 Ch.2.2sic@
    v_SearchSpace.searchSpaceId := tsc_NR_SearchSpaceId_DCI_2_6;
    v_SearchSpace.controlResourceSetId := 1;
    v_SearchSpace.searchSpaceType := cs_NR_SearchSpace_SearchSpaceType_CSS_AllOmit;
    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.searchSpacesToAddModList[0] := v_SearchSpace; //@sic R5s240686 Ch2.2 sic@

    v_SpCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch_Config.setup.searchSpacesToAddModListExt_r16 := {cs_SearchSpaceExt_r16_Dci_Format2_6};
    v_SpCellConfig.spCellConfigDedicated.tag_Id := 0;
    v_CellGroupConfig.spCellConfig := v_SpCellConfig;

     //Configure initial DL-BWP in SS  @sic R5s240686 Ch2.3 sic@
    v_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_PCell, tsc_NR_BWP_Id);  //@sic R5s240686 Ch2.3 sic@
    v_SearchSpaceIndex_DCI_2_6 := lengthof(v_DownlinkBWP.Pdcch.SearchSpaceArray);    /*@sic R5s250070 sic@*/
    v_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_DCI_2_6]:= cs_NR_BWP_SearchSpaceConfig_CSS_DCI_2_6(v_SearchSpace); /*@sic R5s250070 sic@*/
    f_NR_CellInfo_SetDownlinkBWP(p_PCell, v_DownlinkBWP, tsc_NR_BWP_Id);   //@sic R5s240686  Ch2.3sic@

    //configure ServingCellConfigCommon as per Table 7.1.1.12.4.1.3.3-4
    v_ServingCellConfigCommon  := f_NR_GetServingCellConfigCommon_CA(p_SCell);

    //configure BPW to add as per Table 7.1.1.12.4.1.3.3-6
    // common BWP
    v_BWP_DownlinkCommon := f_NR_GetSIB1_InitialDownlinkBWP(p_SCell);  //@sic R5s240686 Ch.2 Add sic@
    v_BWP_DownlinkCommon.pdcch_ConfigCommon := omit;  //@sic R5s240686 Ch2.add, inline with R5-235285 sic@

    //dedicated BWP
    v_SearchSpaceUSS := f_NR_CellInfo_GetSearchSpaceConfigAtUE(p_SCell, tsc_NR_SearchSpaceId_USS, tsc_NR_BWP_Id);
    v_ControlResourceSetToAddModList := f_NR_GetPDCCH_ConfigControlResourceSet(p_SCell);
    v_PDCCH_Config := {setup := cs_38508_PDCCH_Config (v_SearchSpaceUSS, -, v_ControlResourceSetToAddModList)};


    if(f_NR_CellInfo_GetIsFR1(p_PCell)) {//@sic R5s240686 Ch2.3 sic@
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR1;
      v_PDSCH_TimeDomainResourceAllocationList := cs_38508_PDSCH_TimeDomainResourceAllocationList_FR1;
    } else {
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR2;
      v_PDSCH_TimeDomainResourceAllocationList := cs_38508_PDSCH_TimeDomainResourceAllocationList_FR2;
    }

    v_PDSCH_Config := cs_38508_PDSCH_Config(v_DMRS_DownlinkConfig, -, v_SSB_Index);
    v_PDSCH_Config.pdsch_TimeDomainAllocationList.setup := v_PDSCH_TimeDomainResourceAllocationList; //@sic R5s240686 Ch2.3 sic@
    v_BWP_DownlinkDedicated_PDSCH_Config := {setup := v_PDSCH_Config}; //@sic R5s240686 Ch 2.3 alt sic@
    v_BWP_DownlinkDedicated := cs_BWP_DownlinkDedicated_Def(v_PDCCH_Config, v_BWP_DownlinkDedicated_PDSCH_Config); //@sic R5-235285, R5s240686 Ch2.3 sic@

    //resulting BWP
    v_BWP_Downlink :=  cs_38508_BWP_Downlink (tsc_NR_BWP_Id1, v_BWP_DownlinkCommon, v_BWP_DownlinkDedicated);  //@sic R5s240686 Ch.2 Add sic@

    f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_DL_BWP_ConfigCommon_REQ(nr_Cell1, -,{v_DownlinkBWP})); //@sic R5s240686 Ch.2.3 alt sic@

    //configure serving cell as per Table 7.1.1.12.4.1.3.3-5
    v_SCellConfigDedicated :=  f_NR_GetServingCellConfig(p_SCell);
    v_SCellConfigDedicated.uplinkConfig := omit;      //@sic R5-235285 sic@
    v_SCellConfigDedicated.initialDownlinkBWP.radioLinkMonitoringConfig := omit; //@sic R5-235285 sic@
    v_SCellConfigDedicated.downlinkBWP_ToAddModList := {v_BWP_Downlink};
    v_DormantBWP_Config := cs_NR_DormantBWP_Config_r16_Setup_OutsideActiveTime(tsc_NR_BWP_Id1);
    v_SCellConfigDedicated.dormantBWP_Config_r16.setup := v_DormantBWP_Config;
    //v_SCellConfigDedicated.pdsch_ServingCellConfig.setup := {pucch_Cell := 1}; //@sic R5-225297, R5-235285 sic@
    if (ispresent (v_SCellConfigDedicated)) //compiler warning may be ignored due to check
    {
      v_SCellConfig :=   cs_SCellConfig_Def(v_ServingCellConfigCommon,v_SCellConfigDedicated, tsc_NR_SCellIndex_1);
      v_CellGroupConfig.sCellToAddModList := {v_SCellConfig};
    }

    return v_CellGroupConfig

  } //f_TC_7_1_1_12_4_NR_GetCellGroupConfigForStep1

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.4
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_DRBId
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_1_12_4_NR_Steps3_9(NR_CellId_Type    p_PCell,
                                       NR_CellId_Type    p_SCell,
                                       DRB_Identity      p_DRBId
                                      ) runs on NR_BASE_PTC
  {//DRX adaptation / SCell dormancy indication
    var UInt_Type v_LongDRXCycle;
    var UInt_Type v_DrxStartOffset;
    var SubFrameTiming_Type v_WakeUpTiming;
    var SubFrameTiming_Type v_SendTiming;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;

    timer t_Watchdog := 5.0;


    //@siclog Step 3 siclog@
    //The SS transmits a SCell Activation MAC-CE to activate SCell (NR Cell 3).
    f_SS_CellConfig_ActivateSCell_CA(p_PCell);

    f_Delay(0.1); //@sic R5s240686 Ch 5.3, R5s250123 sic@

    // suppress number of DL retransmissions:
    f_NR_SS_CellConfig_DciDlInfo_NoRetransmission(p_PCell);

    // to configure SS to report reception of HARQ ACK or NACK
    f_NR_SS_SystemIndCtrlConfig(p_PCell, cds_NR_SystemIndCtrl_UL_HARQ(enable));

    v_LongDRXCycle := 10240;  //@sic R5s240686 Ch 5.5 sic@
    v_DrxStartOffset := 0;
    v_WakeUpTiming := f_NR_GetWakeUpSignalTiming (v_SendTiming, p_PCell, v_LongDRXCycle, v_DrxStartOffset);

    //@siclog Step 4 siclog@
    //The SS transmits DCI 2-6 within ps-Offset time before the start of next long DRX drx-onDurationTimer on NR Cell 1. (Note 3)
    //The Wake-up indication is value 1 and the SCell dormancy indication is value 0 in the DCI 2-6
    f_NR_SS_CommonCellConfig(p_PCell, cads_NR_DciTrigger_WakeUP_REQ(p_PCell, cs_TimingInfo_NR(v_WakeUpTiming),cs_NR_DciFormat_2_6_Block_List_5Items('1'B, '0'B)));

    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(0, p_DRBId);

    //@siclog Steps 5 siclog@
    //The SS indicates a new transmission on PDCCH of SCell and transmits a MAC PDU on the initial BWP (BWP#0) when the Drx-onDurationTimer is running.
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(p_PCell, p_DRBId, cs_TimingInfo_NR(v_SendTiming), v_MAC_PDUListDL, -, -, crs_MacBearerRouting(p_SCell))); //@sic R5s250091 sic@

    //@siclog Step 6 siclog@
    //Check: Does the UE transmit a HARQ ACK on the PCell for the DL MAC PDU in Step 5 within 5 seconds
    t_Watchdog.start;
    alt
    {
       [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(p_PCell, ack))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
            t_Watchdog.stop;
        }
       [] t_Watchdog.timeout
        {} // do nothing
    }

    v_WakeUpTiming := f_NR_GetWakeUpSignalTiming (v_SendTiming, p_PCell, v_LongDRXCycle, v_DrxStartOffset);

    //@siclog Step 7 siclog@
    //The SS transmits DCI 2-6 within the ps-offset time before the start of next long DRX drx-onDurationTimer on NR Cell 1. (Note 4)
    //Note 4:   The Wake-up indication is value 1 and the SCell dormancy indication is value 1 in the DCI 2-6
    f_NR_SS_CommonCellConfig(p_PCell, cads_NR_DciTrigger_WakeUP_REQ(p_PCell, cs_TimingInfo_NR(v_WakeUpTiming), cs_NR_DciFormat_2_6_Block_List_5Items('1'B, '1'B)));

    //@siclog Steps 8 siclog@
    //The SS indicates a new transmission on PDCCH of SCell and transmits a MAC PDU on the active BWP (BWP#0) when the Drx-onDurationTimer is running.
    v_MAC_PDUListDL := f_NR_GetMAC_PDUListDL(1, p_DRBId);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(p_PCell, p_DRBId, cs_TimingInfo_NR(v_SendTiming), v_MAC_PDUListDL, -, -, crs_MacBearerRouting(p_SCell))); //@sic R5s250091 sic@

    //@siclog Steps 9 siclog@
    //Check: Does the UE transmit a HARQ ACK on the PCell NR Cell 1 for the DL MAC PDU in Step 8?
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND(p_PCell, ack));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable));

  }//f_TC_7_1_1_12_4_NR_Steps3_9

}
