  template (value) NR_DciCommon_TimeDomainResourceAssignment_Type cs_NR_DciCommon_TimeDomainResourceAssignment(bitstring p_Index) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Index := p_Index
  };

  /*
   * @desc      return TimeDomainResourceAssignment as used in DCI
   * @param     p_TimeDomainAllocationListSize
   * @param     p_IndexValue
   * @return    template (value) NR_DciCommon_TimeDomainResourceAssignment_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_DciCommon_TimeDomainResourceAssignment(integer p_TimeDomainAllocationListSize,
                                                        integer p_IndexValue) return template (value) NR_DciCommon_TimeDomainResourceAssignment_Type
  {
    var bitstring v_IndexBitstring := ''B;
    var integer v_IndexSize := f_CeilLog2(p_TimeDomainAllocationListSize);

    if (v_IndexSize > 0) {
      if (p_IndexValue > bit2int(substr('11111111'B, 0, v_IndexSize))) {
        FatalError(__FILE__, __LINE__, "invalid index");
      }
      v_IndexBitstring := int2bit(p_IndexValue, v_IndexSize);
    }
    return cs_NR_DciCommon_TimeDomainResourceAssignment(v_IndexBitstring);
  }

