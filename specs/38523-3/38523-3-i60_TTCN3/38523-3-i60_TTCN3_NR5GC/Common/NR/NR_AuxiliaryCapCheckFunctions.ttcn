 /*
   * @desc      longSN-RedCap-r17 must be supported if applicable for (e)RedCap UEs
   * @return    template LongSN_RedCap_r17
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_longSN_RedCap_r17() return template LongSN_RedCap_r17
  { // @sic R5-227588 R5s230552 R5-256674 sic@
    if ((f_NR_SupportOfRedCap()) and pc_longSN) {
      return supported;
    } else {
      return omit;
    }
  }

