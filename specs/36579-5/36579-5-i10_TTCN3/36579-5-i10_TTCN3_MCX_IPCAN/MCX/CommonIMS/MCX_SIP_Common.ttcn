  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_RegistrationCommon all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_Component all;
  import from MCX_MIME_Functions all;
  import from MCX_Parameters all;
  import from MCX_XML_affiliationCommand all;
  import from MCX_XML_mcdataLocationInfo all;
  import from MCX_XML_mcdata_info all;
  import from MCX_XML_mcpttLocationInfo all;
  import from MCX_XML_mcptt_info all;
  import from MCX_XML_mcvideoLocationInfo all;
  import from MCX_XML_mcvideo_info all;
  import from MCX_XML_resource_lists all;

  template (value) GenericParam crs_GenericParam_require := cs_GenericParam_Common("require");                          /* @status    APPROVED (MCX) */

  template (value) GenericParam crs_GenericParam_explicit := cs_GenericParam_Common("explicit");                        /* @status    APPROVED (MCX) */

  template (value) AnswerMode cs_AnswerMode(charstring p_Modevalue) :=
  { /* @status    APPROVED (MCX) */
    fieldName := ANSWER_MODE_E,
    answerMode_Value := p_Modevalue,
    answerModeParams := omit
  };

  template (value) AnswerMode cs_AnswerMode_Manual := cs_AnswerMode("Manual");          /* @status    APPROVED (MCX) */

  template (value) AnswerMode cs_AnswerMode_Auto := cs_AnswerMode("Auto");              /* @status    APPROVED (MCX) */

  template (present) AnswerMode cr_AnswerMode(template charstring p_Mode) :=
  { /* @status    APPROVED (MCX) */
    fieldName := ANSWER_MODE_E,
    answerMode_Value := p_Mode,
    answerModeParams := *
  };

  template (present) AnswerMode cr_AnswerMode_Manual := cr_AnswerMode("Manual");        /* @status    APPROVED (MCX) */

  template (present) AnswerMode cr_AnswerMode_Auto := cr_AnswerMode("Auto");            /* @status    APPROVED (MCX) */

  template (value) PrivAnswerMode cs_PrivAnswerMode(charstring p_Modevalue) :=
  { /* @status    APPROVED (MCX) */
    fieldName := PRIV_ANSWER_MODE_E,
    answerMode_Value := p_Modevalue,
    answerModeParams := { crs_GenericParam_require }
  };

  template (value) PrivAnswerMode cs_PrivAnswerMode_Manual := cs_PrivAnswerMode("Manual");      /* @status    APPROVED (MCX) */

  template (value) PrivAnswerMode cs_PrivAnswerMode_Auto := cs_PrivAnswerMode("Auto");          /* @status    APPROVED (MCX) */

  template (present) PrivAnswerMode cr_PrivAnswerMode_Auto := cs_PrivAnswerMode_Auto;   /* ... as long as there are no optional parameters
                                                                                           @status    APPROVED (MCX) */

  template (present) R_Value cr_R_Value(charstring p_Namespace,
                                        charstring p_Priority) :=
  { /* @status    APPROVED (MCX) */
    namespace := p_Namespace,
    rPriority := p_Priority
  };

  template (present) ResourcePriority cr_ResourcePriority_Common(template (present) ResourcePriority_List p_ResourcePriorityList) :=
  { /* @status    APPROVED (MCX) */
    fieldName := RESOURCE_PRIORITY_E,
    resourcePriorityList := p_ResourcePriorityList
  };

  template (present) ResourcePriority cr_ResourcePriority(template (present) R_Value p_R_Value) := cr_ResourcePriority_Common( { p_R_Value } );                 /* @status    APPROVED (MCX) */

  /*
   * @desc      Build up AcRcValue_List template for receiving from the client
   * @param     p_ParamList
   * @return    template (present) AcRcValue_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_AcceptContact_AcValues_Common_RX(template (present) GenericParamList_Type p_ParamList) return template (present) AcRcValue_List
  {
    var template (present) AcRcValue_List v_AcValues;
    var integer i;

    for (i := 0; i < lengthof(p_ParamList); i := i + 1) {
      v_AcValues[i] := cr_AcRcValue( { p_ParamList[i], crs_GenericParam_require, crs_GenericParam_explicit } );
    }
    return v_AcValues;
  }

  /*
   * @desc      Build up AcRcValue_List template for receiving from the client
   * @param     p_ServiceType
   * @return    template (present) AcRcValue_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_AcceptContact_AcValues_RX(MCX_ServiceType_Type p_ServiceType) return template (present) AcRcValue_List
  { /* @sic R5-217986: p_EstabModType removed sic@ */
    var template (present) GenericParamList_Type v_GenericParamList;
    
    v_GenericParamList[0] := crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType);              // e.g. "+g.3gpp.mcptt"
    v_GenericParamList[1] := crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType);         // e.g. "+g.3gpp.icsi-ref=" & f_URL_Encoding("urn:urn-7:3gpp-service.ims.icsi.mcptt")

    return f_MCX_AcceptContact_AcValues_Common_RX(v_GenericParamList);
  }

  /*
   * @desc      Build up AcRcValue_List to be sent to the client
   * @param     p_ParamList
   * @return    template (value) AcRcValue_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_AcceptContact_AcValues_Common_TX(template (value) GenericParamList_Type p_ParamList) return template (value) AcRcValue_List
  {
    var template (value) AcRcValue_List v_AcValues;
    var integer i;

    for (i := 0; i < lengthof(p_ParamList); i := i + 1) {
      v_AcValues[i] := cs_AcRcValue( { p_ParamList[i], crs_GenericParam_require, crs_GenericParam_explicit } );
    }
    return v_AcValues;
  }

  template (value) PAnswerState cs_PAnswerState(charstring p_AnswerType) :=
  { /* @status    APPROVED (MCX) */
    fieldName := P_ANSWER_STATE_E,
    answerType := p_AnswerType,
    genericParams := omit
  };

  template (present) PAnswerState cr_PAnswerState(charstring p_AnswerType) :=
  { /* @status    APPROVED (MCX) */
    fieldName := P_ANSWER_STATE_E,
    answerType := p_AnswerType,
    genericParams := *
  };

  template (value) PPreferredService cs_PPreferredService(charstring p_ServiceId) :=
  { /* @status    APPROVED (MCX) */
    fieldName := P_PREFERRED_SERVICE_E,
    serviceId := p_ServiceId
  };

  template (present) Warning cr_Warning(integer p_WarnCode,
                                        charstring p_WarnText) :=
  { /* 36.579-1 Table 5.5.2.19.4-1: SIP 480 (Temporarily unavailable) */
    /* @status    APPROVED (MCX) */
    fieldName := WARNING_E,
    warningValue := {
      {
        warnCode := p_WarnCode,
        warnAgent := ?,
        warnText := p_WarnText
      }
    }
  };

  /*
   * @desc      return default Public user id to be expected from the client
   * @return    template (present) SipUrl
   * @status    APPROVED (MCX)
   */
  function f_MCX_DefaultPublicUserIdRX() runs on IMS_PTC return template (present) SipUrl
  { /* @sic R5-212302: p_Port removed sic@ */
    var charstring v_PublicUserIdDefault := f_IMS_PTC_ImsInfo_GetUriString(defaultId);
    var template (present) SipUrl v_SipUrl := f_SIP_BuildSipUri_RX(v_PublicUserIdDefault);
    
    return v_SipUrl;
  }

  /*
   * @desc      Wrapper function to store the SS's Contact URI (session id in case of call establishment)
   * @param     p_ContactUriStr
   * @param     p_Port              (default value: omit)
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCX_IMS_PTC_ImsInfo_SetContactUrlSS(charstring p_ContactUriStr,
                                                 template (omit) integer p_Port := omit,
                                                 template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  {
    var template (value) SipUrl v_ContactSipUrl := f_SIP_BuildSipUri_TX(p_ContactUriStr, p_Port);
    f_IMS_PTC_ImsInfo_SetContactUrlSS(valueof(v_ContactSipUrl), p_DialogIndex);
  }

  /*
   * @desc      Feature caps according to 24.379 D.3:
   *            indicates that the MCPTT server is capable of receiving a SIP BYE from an MCPTT client to release an ambient-listening call
   * @return    template (value) FeatureCaps
   * @status    APPROVED (MCX)
   */
  function f_MCX_FeatureCaps_MCPTT_AmbientListeningCallRelease() return template (value) FeatureCaps
  { // NOTE: used in f_MCPTT_MCVideo_PreestablishedSession_CallSetupMO_ReceiveREFER_Send200OK => needs to be MCX Common
    var template (value) SemicolonParam_List v_FeatureParamList := {
      cs_GenericParam("g.3gpp.mcptt.ambient-listening-call-release")
    };
    return cs_FeatureCaps(v_FeatureParamList);
  }

  /*
   * @desc      Feature caps according to 24.281 D.3:
   *            indicates that the MCVideo server is capable of receiving a SIP BYE from an MCVideo client to release an ambient-viewing call
   * @return    template (value) FeatureCaps
   * @status    APPROVED (MCX)
   */
  function f_MCX_FeatureCaps_MCVideo_AmbientViewingCallRelease() return template (value) FeatureCaps
  { // NOTE: see f_MCX_FeatureCaps_MCPTT_AmbientListeningCallRelease
    var template (value) SemicolonParam_List v_FeatureParamList := {
      cs_GenericParam("g.3gpp.mcptt.ambient-viewing-call-release")
    };
    return cs_FeatureCaps(v_FeatureParamList);
  }

  /*
   * @desc      return feature param for given service
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function fl_MCX_FeatureTag_g_3gpp_mcs(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_FeatureTag;

    select (p_ServiceType) {
      case (MCPTT)        { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcptt; }
      case (MCVideo)      { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcvideo; }
      case (MCData)       { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcdata; }
      case (MCDataSDS)    { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcdata_sds; }
      case (MCDataFD)     { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcdata_fd; }
      case (MCDataIPCONN) { v_FeatureTag := tsc_MCX_FeatureTag_g_3gpp_mcdata_ipconn; }
      case else           { FatalError(__FILE__, __LINE__, "Invalid service type"); }
    }
    return v_FeatureTag;
  }

  template (value) GenericParam crs_MCX_FeatureTag_g_3gpp_mcs(MCX_ServiceType_Type p_ServiceType) := cs_GenericParam_Common(fl_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType));   /* @status    APPROVED (MCX) */

  /*
   * @desc      return feature param for given service
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_FeatureTag_3gpp_service_ims_icsi_mcs(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_FeatureTag;

    select (p_ServiceType) {
      case (MCPTT)        { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcptt; }
      case (MCVideo)      { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcvideo; }
      case (MCData)       { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcdata; }
      case (MCDataSDS)    { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcdata_sds; }
      case (MCDataFD)     { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcdata_fd; }
      case (MCDataIPCONN) { v_FeatureTag := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcdata_ipconn; }
      case else           { FatalError(__FILE__, __LINE__, "Invalid service type"); }
    }
    return v_FeatureTag;
  }

  template (value) GenericParam crs_MCX_FeatureParam_3gpp_icsi_ref(MCX_ServiceType_Type p_ServiceType) := crs_FeatureParam_3gpp_icsi_ref(f_URL_Encoding(f_MCX_FeatureTag_3gpp_service_ims_icsi_mcs(p_ServiceType))); /* @status    APPROVED (MCX) */

  /*
   * @desc      return CharStringList with feature-tags for the given service
   * @param     p_ServiceType
   * @return    CharStringList_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ServiceSpecificContactFeatureTags(MCX_ServiceType_Type p_ServiceType) return CharStringList_Type
  {
    var CharStringList_Type v_FeatureTags;
    select (p_ServiceType) {
      case (MCPTT)                       { v_FeatureTags := { "audio" }; }
      case (MCVideo)                     { v_FeatureTags := { "audio", "video" }; }
      case (MCData, MCDataSDS, MCDataFD) { v_FeatureTags := { "text" }; }
      case (MCDataIPCONN)                { v_FeatureTags := { }; }    // @sic R5-246417: no "text" feature tag for IPCONN sic@
      case else                          { FatalError(__FILE__, __LINE__, "Invalid service type"); }
    }
    return v_FeatureTags;
  }

  /*
   * @desc      return SemicolonParam_List with feature-tags for the given service
   * @param     p_ServiceType
   * @param     p_FurtherFeatureTags (default value: {})
   * @return    template (value) SemicolonParam_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_ServiceSpecificContactFeatureTagsTX(MCX_ServiceType_Type p_ServiceType,
                                                     CharStringList_Type p_FurtherFeatureTags := {}) return template (value) SemicolonParam_List
  {
    var CharStringList_Type v_FeatureTags := fl_MCX_ServiceSpecificContactFeatureTags(p_ServiceType);
    var template (value) SemicolonParam_List v_ContactParams;
    var integer i;

    v_FeatureTags := v_FeatureTags & p_FurtherFeatureTags;

    for (i := 0; i < lengthof(v_FeatureTags); i := i + 1) {
      v_ContactParams[i] := cs_GenericParam(v_FeatureTags[i]);
    }
    return v_ContactParams;
  }

  /*
   * @desc      return MIME type for mcptt-info, mcvideo-info, mcdata-info depending on p_ServiceType
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MimeType_mcs_info(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_MimeType;

    select (p_ServiceType) {
      case (MCPTT) {
        v_MimeType := tsc_MimeType_McpttInfo;
      }
      case (MCVideo) {
        v_MimeType := tsc_MimeType_McvideoInfo;
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_MimeType := tsc_MimeType_McdataInfo;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    return v_MimeType;
  }

  /*
   * @desc      return Contact feature parameters depending on the service type
   * @param     p_ServiceType
   * @param     p_FurtherFeatureTags (default value: {})
   * @return    template (value) SemicolonParam_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_SIP_ContactParams_TX(MCX_ServiceType_Type p_ServiceType,
                                      CharStringList_Type p_FurtherFeatureTags := {}) return template (value) SemicolonParam_List
  {
    var template (value) SemicolonParam_List v_ContactParams := {
      crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType),                     // e.g. "+g.3gpp.mcptt"
      crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType)                 // e.g. "+g.3gpp.icsi-ref=" & f_URL_Encoding("urn:urn-7:3gpp-service.ims.icsi.mcptt")
    };
    return v_ContactParams & f_MCX_ServiceSpecificContactFeatureTagsTX(p_ServiceType, p_FurtherFeatureTags);
  }

  /*
   * @desc      Add feature tags to parameter list
   * @param     p_ContactParams
   * @param     p_FeatureTags
   * @return    template (present) SemicolonParam_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_SIP_ContactParams_AddFeatureTags_RX(template (present) SemicolonParam_List p_ContactParams,
                                                     CharStringList_Type p_FeatureTags) return template (present) SemicolonParam_List
  {
    var template (present) SemicolonParam_List v_ContactParams := p_ContactParams;
    var integer i;

    for (i := 0; i < lengthof(p_FeatureTags); i := i + 1) {
      v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, cr_GenericParam_NoValue(p_FeatureTags[i]));
    }
    return v_ContactParams;
  }

  /*
   * @desc      return Contact feature parameters depending on the service type
   * @param     p_ServiceType
   * @return    template (present) SemicolonParam_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_SIP_Register_ContactParams_RX(MCX_ServiceType_Type p_ServiceType) return template (present) SemicolonParam_List
  {
    var CharStringList_Type v_FeatureTags := fl_MCX_ServiceSpecificContactFeatureTags(p_ServiceType); // list of e.g. {"audio", "video"}
    var template (present) SemicolonParam_List v_ContactParams;

    select (p_ServiceType) {
      case (MCPTT, MCVideo) {
        v_ContactParams[0] := crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType);
        v_ContactParams[1] := crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType);
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_ContactParams[0] := crs_MCX_FeatureParam_3gpp_icsi_ref(MCData);
        if (pc_MCData_SDS) {
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureParam_3gpp_icsi_ref(MCDataSDS));
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureTag_g_3gpp_mcs(MCDataSDS));
        }
        if (pc_MCData_FD) {
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureParam_3gpp_icsi_ref(MCDataFD));
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureTag_g_3gpp_mcs(MCDataFD));
        }
        if (pc_MCData_IPCONN) {    // @sic R5-246417: support of IPCONN in SIP Registration sic@
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureParam_3gpp_icsi_ref(MCDataIPCONN));
          v_ContactParams := f_SemicolonParam_List_Add_RX(v_ContactParams, crs_MCX_FeatureTag_g_3gpp_mcs(MCDataIPCONN));
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    v_ContactParams := f_MCX_SIP_ContactParams_AddFeatureTags_RX(v_ContactParams, v_FeatureTags);

    return v_ContactParams;
  }

  /*
   * @desc      return Contact feature parameters for call control messages depending on the service type
   * @param     p_ServiceType
   * @param     p_EstabModType       (default value: CALL_ESTAB_MOD)
   * @param     p_FurtherFeatureTags (default value: {})
   * @return    template (present) SemicolonParam_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_SIP_CallControl_ContactParams_RX(MCX_ServiceType_Type p_ServiceType,
                                                  MCX_SIP_EstabMod_Type p_EstabModType := CALL_ESTAB_MOD,
                                                  CharStringList_Type p_FurtherFeatureTags := {}) return template (present) SemicolonParam_List
  {
    var CharStringList_Type v_FeatureTags := fl_MCX_ServiceSpecificContactFeatureTags(p_ServiceType); // list of e.g. {"audio", "video"}
    var template (present) SemicolonParam_List v_ContactParams;

    v_ContactParams[0] := crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType);         // e.g. "+g.3gpp.mcptt"
    if (p_EstabModType == CALL_ESTAB_MOD) {
      v_ContactParams[1] := crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType);  // e.g. "+g.3gpp.icsi-ref=" & f_URL_Encoding("urn:urn-7:3gpp-service.ims.icsi.mcptt")
    }

    v_FeatureTags := v_FeatureTags & p_FurtherFeatureTags;
    v_ContactParams := f_MCX_SIP_ContactParams_AddFeatureTags_RX(v_ContactParams, v_FeatureTags);

    return v_ContactParams;
  }

  /*
   * @desc      return route set for subscribe dialogs as returned in the Record-Route header of 200 OK messages for the initial SUBSCRIBE creating the dialog
   * @return    template (value) RouteBody_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_RouteSet_Subscription_TX() runs on IMS_PTC return template (value) RouteBody_List
  {
    var charstring v_RouteHost := f_IMS_PTC_Pcscf_Get();
    var template (value) RouteBody_List v_RouteBodyList := { cs_RouteBody(cs_SipUri_HostPort_lr(v_RouteHost)) };
    return v_RouteBodyList;
  }

  /*
   * @desc      Common message header for 200 OK to be sent to the client
   * @param     p_MessageHeader_Request
   * @param     p_Contact           (default value: omit)
   * @param     p_ContentType       (default value: omit)
   * @param     p_ToTag             (default value: omit)
   * @return    template (value) MessageHeader
   * @status    APPROVED (MCX)
   */
  function f_MCX_CommonResponse_200_MessageHeaderTX(MessageHeader p_MessageHeader_Request,
                                                    template (omit) Contact p_Contact := omit,
                                                    template (omit) ContentType p_ContentType := omit,
                                                    template (omit) charstring p_ToTag := omit)
    runs on IMS_PTC return template (value) MessageHeader
  {
    var template (value) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderTX(p_MessageHeader_Request, p_ToTag);   /* p_ToTag: for SUBSCRIBE to allow different ToTags for different dialogs created by subscription to event packages */
    var charstring v_Method := valueof(p_MessageHeader_Request.cSeq.method);
    var template (value) SipUrl v_AssociatedSipUrl;
    var template (value) NameAddrParam_List v_NameAddrParamList;
    var OptionTag_List v_OptionTagList;
    var charstring v_EntityTag;
    var template (value) RouteBody_List v_RouteBodyList;

    select (v_Method) {
      case ("REGISTER") {
        v_AssociatedSipUrl := f_IMS_PTC_ImsInfo_GetSipUriTX(defaultId);
        v_NameAddrParamList := { cs_NameAddrParam(v_AssociatedSipUrl) };
        v_MessageHeader_Response.pAssociatedURI := cs_PAssociatedURI(v_NameAddrParamList);
        v_MessageHeader_Response.serviceRoute   := cs_ServiceRouteDef(tsc_IMS_Scscf);
      }
      case ("INVITE", "UPDATE") {
        v_RouteBodyList := f_IMS_RouteSet_MO_Call_TX();
        v_OptionTagList := tsc_OptionTagList_norefersub & { "tdialog", "explicitsub", "nosub" };
        v_MessageHeader_Response.recordRoute    := cs_RecordRoute(v_RouteBodyList);
        v_MessageHeader_Response.require        := cs_Require_timer;
        v_MessageHeader_Response.sessionExpires := cs_SessionExpires(3600, "uac");
        v_MessageHeader_Response.supported      := cs_Supported(v_OptionTagList);
      }
      case ("SUBSCRIBE", "PUBLISH") {
        if (v_Method == "SUBSCRIBE") {
          v_RouteBodyList := f_MCX_RouteSet_Subscription_TX();
          v_MessageHeader_Response.recordRoute := cs_RecordRoute(v_RouteBodyList);
        } else {
          v_EntityTag := "dx200xyz-" & int2str(p_MessageHeader_Request.cSeq.seqNumber);
          v_MessageHeader_Response.sipETag := cs_SIP_ETag(v_EntityTag);
        }
        v_MessageHeader_Response.expires       := cs_Expires(p_MessageHeader_Request.expires.deltaSec);
      }
      case ("REFER") {
        v_MessageHeader_Response.referSub      := cs_ReferSub(false);
      }
    }
    v_MessageHeader_Response.contact           := p_Contact;
    v_MessageHeader_Response.contentType       := p_ContentType;
    return v_MessageHeader_Response;
  }

  /*
   * @desc      Common message header for 200 OK to be expected from the client
   * @param     p_MessageHeader_Request
   * @param     p_ContentType       (default value: omit)
   * @return    template (present) MessageHeader
   * @status    APPROVED (MCX)
   */
  function f_MCX_CommonResponse_200_MessageHeaderRX(template (value) MessageHeader p_MessageHeader_Request,
                                                    template ContentType p_ContentType := omit) return template (present) MessageHeader
  {
    var template (present) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderRX(p_MessageHeader_Request);

    v_MessageHeader_Response.contentType := p_ContentType;

    return v_MessageHeader_Response;
  }

  /*
   * @desc      36.579-1 Table 5.5.2.7.1-1: SIP MESSAGE from the UE
   * @param     p_ServiceType
   * @param     p_RequestUrl
   * @param     p_ContentType        (default value: cr_ContentTypeMIME)
   * @return    template (present) MessageHeader
   * @status    APPROVED (MCX)
   */
  function f_MCX_MessageRequest_MessageHeaderRX(MCX_ServiceType_Type p_ServiceType,
                                                template (present) SipUrl p_RequestUrl,
                                                template (present) ContentType p_ContentType := cr_ContentTypeMIME) runs on IMS_PTC return template (present) MessageHeader
  {
    var template (present) MessageHeader v_MessageHeader_Message := cr_MessageHeader_Dummy;
    var IMS_ProtectedPorts_Type v_Protected := f_IMS_PTC_Security_GetProtectedPorts();
    var template DisplayName v_DisplayName := *;
    var template (present) charstring v_Pcscf := ?;                                                             /* P-CSCF address is checked later on (f_MCX_MESSAGE_ReceiveRequest -> f_IMS_MessageHeader_Request_CheckRoute) */
    var template (present) SipUrl v_SipUrlFrom := f_MCX_DefaultPublicUserIdRX();
    var template (present) RouteBody_List v_RouteBodyList := cr_RouteBodyList_InitialReq(v_Protected.Port_ps, v_Pcscf, tsc_IMS_Scscf);
    var template (present) GenericParamList_Type v_FeatureParamList;
    var template (present) AcRcValue_List v_AcceptContactValues;
    
    v_FeatureParamList[0] := crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType);
    select (p_ServiceType) {
      case (MCDataSDS, MCDataFD) {
        v_FeatureParamList[1] := crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType);
      }
    }
    v_AcceptContactValues := f_MCX_AcceptContact_AcValues_Common_RX(v_FeatureParamList);

    v_MessageHeader_Message.via                := f_IMS_SipRequest_ViaRX();
    v_MessageHeader_Message.fromField          := cr_From(v_DisplayName, v_SipUrlFrom);
    v_MessageHeader_Message.toField            := cr_ToDef(p_RequestUrl);                                       /* same as request URI */
    v_MessageHeader_Message.callId             := cr_CallId(?);
    v_MessageHeader_Message.cSeq               := cr_CseqDef(?, "MESSAGE");
    v_MessageHeader_Message.maxForwards        := cr_MaxForwardsDef;
    v_MessageHeader_Message.pAccessNetworkInfo := cr_PAccessNetworkInfo(f_IMS_PTC_GetRanType());
    v_MessageHeader_Message.route              := cr_Route(v_RouteBodyList);                                    /* additional checks in f_MCX_MESSAGE_ReceiveRequest: f_IMS_MessageHeader_Request_CheckRoute */
    v_MessageHeader_Message.pPreferredService  := cr_PPreferredService(f_MCX_FeatureTag_3gpp_service_ims_icsi_mcs(p_ServiceType)); /* NOTE: acc. RFC 6050 the service is not percent-encoded */
    v_MessageHeader_Message.pPreferredID       := cr_PPreferredID( { v_MessageHeader_Message.fromField.addressField } ) ifpresent;   /* @sic R5-216671 sic@ */
    v_MessageHeader_Message.acceptContact      := cr_AcceptContact_Common(v_AcceptContactValues);               // @sic R5-212301 sic@
    v_MessageHeader_Message.contentType        := p_ContentType;

    return v_MessageHeader_Message;
  }

  /*
   * @desc      36.579-1 Table 5.5.2.7.2-1: SIP MESSAGE from the SS
   * @param     p_ServiceType
   * @param     p_ACCEPT_CONTACT_WITH_MEDIA_FEATURE_TAG (default value: false)
   * @return    template (value) MessageHeader
   * @status    APPROVED (MCX)
   */
  function f_MCX_MessageRequest_MessageHeaderTX(MCX_ServiceType_Type p_ServiceType,
                                                boolean p_ACCEPT_CONTACT_WITH_MEDIA_FEATURE_TAG := false) runs on IMS_PTC return template (value) MessageHeader
  {
    var template (value) MessageHeader v_MessageHeader_Message := cs_MessageHeader_Dummy;
    var charstring v_PublicServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
    var template (value) SipUrl v_ToURI := f_IMS_PTC_ImsInfo_GetSipUriTX(defaultId);                // default public user id (same as Request URI)
    var template (value) SipUrl v_FromURI := f_SIP_BuildSipUri_TX(v_PublicServiceId);               // PSI of the MCX server
    var charstring v_ServerHostname := f_SIP_SipUrl_GetDomainName(v_FromURI);
    var charstring v_FromTag := f_IMS_GenerateTag("MESSAGE", "From");
    var charstring v_CallIdString := f_IMS_PTC_GenerateCallId("MESSAGE");
    var charstring v_NW_AddrStr := f_IMS_PTC_NW_Address_GetAddrStr();                               // P-CSCF address of the SS
    var CharStringList_Type v_ViaAddressList := {v_NW_AddrStr, tsc_IMS_Scscf, v_ServerHostname};
    var template (value) GenericParamList_Type v_AcceptContactParams;

    v_AcceptContactParams[0] := crs_MCX_FeatureParam_3gpp_icsi_ref(p_ServiceType);
    
    if (p_ACCEPT_CONTACT_WITH_MEDIA_FEATURE_TAG) { // @sic R5-216671 sic@
      v_AcceptContactParams[1] := crs_MCX_FeatureTag_g_3gpp_mcs(p_ServiceType);
    }

    v_MessageHeader_Message.via               := f_IMS_NotifyRequest_ViaTX(v_ViaAddressList);
    v_MessageHeader_Message.fromField         := cs_From(v_FromURI, v_FromTag);
    v_MessageHeader_Message.toField           := cs_ToDef(v_ToURI);                                 // To-header with no tag
    v_MessageHeader_Message.callId            := cs_CallId(v_CallIdString);
    v_MessageHeader_Message.cSeq              := cs_CseqDef(4711, "MESSAGE");
    v_MessageHeader_Message.maxForwards       := cs_MaxForwardsDef(67);
    v_MessageHeader_Message.acceptContact     := cs_AcceptContact_Common(f_MCX_AcceptContact_AcValues_Common_TX(v_AcceptContactParams));    // @sic R5-216671 sic@
    v_MessageHeader_Message.contentType       := cs_ContentTypeMIME(tsc_MCX_MIME_Boundary);

    return v_MessageHeader_Message;
  }

  type record MCX_MessageRequestWithXmlBodies_Type {            /* @status    APPROVED (MCX) */
    MESSAGE_Request Message,
    MCX_MIME_XmlBodies_Type XmlBodies
  };

  template (value) MCX_MessageRequestWithXmlBodies_Type cs_MCX_MessageRequestWithXmlBodies(MESSAGE_Request p_Message,
                                                                                           MCX_MIME_XmlBodies_Type p_XmlBodies) :=
  { /* @status    APPROVED (MCX) */
    Message := p_Message,
    XmlBodies := p_XmlBodies
  };

  /*
   * @desc      Common service independent function to receive a SIP MESSAGE with any kind of MessageBody and send the response
   * @param     p_RequestUrl
   * @param     p_MessageHeaderMESSAGE
   * @param     p_StatusLineResponse   (default value: c_statusLine200)
   * @param     p_MessageBody       (default value: cr_MessageBody_MIME)
   * @return    MESSAGE_Request
   * @status    APPROVED (MCX)
   */
  function f_MCX_ReceiveMESSAGE_Send20xResponse(template (present) SipUrl p_RequestUrl,
                                                template (present) MessageHeader p_MessageHeaderMESSAGE,
                                                StatusLine p_StatusLineResponse := c_statusLine200,
                                                template (present) MessageBody p_MessageBody := cr_MessageBody_MIME) runs on IMS_PTC return MESSAGE_Request
  {
    var template (value) MessageHeader v_MessageHeader_Response;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MessageHeader v_MessageHeader_Request;

    v_IMS_DATA_REQ := f_IMS_ReceiveRequest(car_IMS_Message_Request(cr_MESSAGE_Request(p_RequestUrl, p_MessageHeaderMESSAGE, p_MessageBody)));
    v_MessageHeader_Request := v_IMS_DATA_REQ.Request.Message.msgHeader;

    f_IMS_MessageHeader_Request_CheckRoute(v_MessageHeader_Request);
    
    select (p_StatusLineResponse.statusCode) {
      case (200) { v_MessageHeader_Response := f_MCX_CommonResponse_200_MessageHeaderTX(v_MessageHeader_Request); }
      case (202) { v_MessageHeader_Response := f_IMS_Accepted_202_MessageHeaderTX(v_MessageHeader_Request); }
    }
    IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo), cs_Response(p_StatusLineResponse, v_MessageHeader_Response)));

    return v_IMS_DATA_REQ.Request.Message;
  }

  /*
   * @desc      Common service independent function to receive a SIP MESSAGE and send the response
   * @param     p_ServiceType
   * @param     p_PublicServiceId
   * @param     p_StatusLineResponse
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McpttInfoExt      (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McvideoInfoExt    (default value: omit)
   * @param     p_McdataInfo        (default value: omit)
   * @param     p_McdataInfoExt     (default value: omit)
   * @param     p_AffiliationCmd    (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @param     p_McvideoLocationInfo (default value: omit)
   * @param     p_McdataLocationInfo (default value: omit)
   * @return    MCX_MessageRequestWithXmlBodies_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ReceiveMESSAGE_Send20xResponse_MIME(MCX_ServiceType_Type p_ServiceType,
                                                     charstring p_PublicServiceId,
                                                     StatusLine p_StatusLineResponse,
                                                     template MCPTT_Info_Type p_McpttInfo := omit,
                                                     template McpttInfoExt_ElementList_Type p_McpttInfoExt := omit,
                                                     template MCVideo_Info_Type p_McvideoInfo := omit,
                                                     template McvideoInfoExt_ElementList_Type p_McvideoInfoExt := omit,
                                                     template MCData_Info_Type p_McdataInfo := omit,
                                                     template McdataInfoExt_ElementList_Type p_McdataInfoExt := omit,
                                                     template MCX_Affiliation_CommandList_Type p_AffiliationCmd := omit,
                                                     template ResourceLists_Type p_ResourceLists := omit,
                                                     template MCPTT_LocationInfo_Type p_McpttLocationInfo := omit,
                                                     template MCVideo_LocationInfo_Type p_McvideoLocationInfo := omit,
                                                     template MCData_LocationInfo_Type p_McdataLocationInfo := omit) runs on MCX_IMS_PTC return MCX_MessageRequestWithXmlBodies_Type
  {
    var template (present) SipUrl v_RequestUrl := f_SIP_BuildSipUri_RX(p_PublicServiceId);
    var template (present) MessageHeader v_MessageHeaderMESSAGE := f_MCX_MessageRequest_MessageHeaderRX(p_ServiceType, v_RequestUrl);
    var MESSAGE_Request v_MESSAGE_Request := f_MCX_ReceiveMESSAGE_Send20xResponse(v_RequestUrl, v_MessageHeaderMESSAGE, p_StatusLineResponse);
    var MIME_Message v_MIME_Message := v_MESSAGE_Request.messageBody.mimeMessageBody;
    var MCX_MIME_XmlBodies_Type v_XmlBodies;
    
    v_XmlBodies := f_MCX_MIME_DecodeAndMatchXML(v_MIME_Message, p_ServiceType, -, p_McpttInfo, p_McpttInfoExt, p_McvideoInfo, p_McvideoInfoExt, p_McdataInfo, p_McdataInfoExt, p_McpttLocationInfo, p_McvideoLocationInfo, p_McdataLocationInfo, p_ResourceLists, -, -, p_AffiliationCmd);

    return valueof(cs_MCX_MessageRequestWithXmlBodies(v_MESSAGE_Request, v_XmlBodies));
  }

  /*
   * @desc      Send MESSSAGE, receive 200 OK
   * @param     p_RequestUrl        (default value: omit)
   * @param     p_MessageHeaderMESSAGE
   * @param     p_MessageBody
   * @status    APPROVED (MCX)
   */
  function f_MCX_SendMESSAGE_Receive200OK(template (omit) SipUrl p_RequestUrl := omit,
                                          template (value) MessageHeader p_MessageHeaderMESSAGE,
                                          template (value) MessageBody p_MessageBody) runs on IMS_PTC
  {
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    var template (value) SipUrl v_RequestUrl;
    var template (present) MessageHeader v_ResponseHeader;
    
    if (isvalue(p_RequestUrl)) {
      v_RequestUrl := valueof(p_RequestUrl);
    } else {
      v_RequestUrl := f_IMS_PTC_ImsInfo_GetSipUriTX(defaultId);
    }

    // Send MESSAGE request
    IMS_Client.send(cas_IMS_Message_Request(cs_IMS_RoutingInfo(v_Protocol), cs_MESSAGE_Request(v_RequestUrl, p_MessageHeaderMESSAGE, p_MessageBody)));
    
    // UE responds with 200 OK
    v_ResponseHeader := f_MCX_CommonResponse_200_MessageHeaderRX(p_MessageHeaderMESSAGE);        // As the request does not have a To-tag, f_MCX_CommonResponse_200_MessageHeaderRX automatically sets the To-tag to any value => nothing needs to be done here
    f_IMS_ReceiveResponse(p_MessageHeaderMESSAGE, v_Protocol, cr_Response(c_statusLine200, v_ResponseHeader));
  }

  /*
   * @desc      Send MESSSAGE, receive 200 OK
   * @param     p_ServiceType
   * @param     p_MessageHeader
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McdataInfo        (default value: omit)
   * @param     p_AffiliationCommand (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @param     p_McvideoLocationInfo (default value: omit)
   * @param     p_McdataLocationInfo (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCX_SendMESSAGEwithMIME_Receive200OK(MCX_ServiceType_Type p_ServiceType,
                                                  template (value) MessageHeader p_MessageHeader,
                                                  template (omit) MCPTT_Info_Type p_McpttInfo := omit,
                                                  template (omit) MCVideo_Info_Type p_McvideoInfo := omit,
                                                  template (omit) MCData_Info_Type p_McdataInfo := omit,
                                                  template (omit) MCX_Affiliation_CommandList_Type p_AffiliationCommand := omit,
                                                  template (omit) ResourceLists_Type p_ResourceLists := omit,
                                                  template (omit) MCPTT_LocationInfo_Type p_McpttLocationInfo := omit,
                                                  template (omit) MCVideo_LocationInfo_Type p_McvideoLocationInfo := omit,
                                                  template (omit) MCData_LocationInfo_Type p_McdataLocationInfo := omit) runs on MCX_IMS_PTC
  {
    var template (value) MessageBody v_MessageBodyMIME := f_MCX_MIME_MessageBodyTX(p_ServiceType, -, -, p_McpttInfo, p_McvideoInfo, p_McdataInfo, p_McpttLocationInfo, p_McvideoLocationInfo, p_McdataLocationInfo, p_ResourceLists, p_AffiliationCommand);
    f_MCX_SendMESSAGE_Receive200OK(-, p_MessageHeader, v_MessageBodyMIME);
  }

  /*
   * @desc      Wrapper function
   * @param     p_MessageHeader
   * @param     p_McpttInfo
   * @param     p_AffiliationCommand (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_SendMESSAGEwithMIME_Receive200OK(template (value) MessageHeader p_MessageHeader,
                                                    template (value) MCPTT_Info_Type p_McpttInfo,
                                                    template (omit) MCX_Affiliation_CommandList_Type p_AffiliationCommand := omit,
                                                    template (omit) ResourceLists_Type p_ResourceLists := omit,
                                                    template (omit) MCPTT_LocationInfo_Type p_McpttLocationInfo := omit) runs on MCX_IMS_PTC
  {
    f_MCX_SendMESSAGEwithMIME_Receive200OK(MCPTT, p_MessageHeader, p_McpttInfo, -, -, p_AffiliationCommand, p_ResourceLists, p_McpttLocationInfo);
  }

}
