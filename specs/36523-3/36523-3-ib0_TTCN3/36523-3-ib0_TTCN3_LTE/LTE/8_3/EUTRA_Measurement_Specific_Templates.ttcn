    cs_508_RRCConnectionReconfiguration_ConditionMEAS(p_RRC_TI,
                                                      cs_MeasConfig(omit,
                                                                    cs_MeasObjectToAddModList_2Entries(tsc_IdMeasObject_f1,
                                                                                                       cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq_1), p_MeasurementBandwidth_1), //@sic R5-171996 sic@
                                                                                                       tsc_IdMeasObject_f2,
                                                                                                       cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq_2), p_MeasurementBandwidth_2)), //@sic R5-171996 sic@
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfig_A3,
                                                                                                       cs_ReportConfig_reportConfigEUTRA_eventA3(0, //@sic R5-101032r2: Changed a3_Offset from 20 to 0 sic@
                                                                                                                                                 false,
                                                                                                                                                 0,
                                                                                                                                                 ms0,
                                                                                                                                                 rsrp,
                                                                                                                                                 sameAsTriggerQuantity,
                                                                                                                                                 1,
                                                                                                                                                 ms1024,
                                                                                                                                                 r1)), /* @sic R5-095507: Changed from r1 to infinity_ sic@
                                                                                                                                                          @sic R5-105011: Changed from infinity_ to r1 sic@ */
                                                                    omit,
                                                                    cs_MeasIdToAddModList_2Entries(1, tsc_IdMeasObject_f1, tsc_IdReportConfig_A3,
                                                                                                   2, tsc_IdMeasObject_f2, tsc_IdReportConfig_A3),
                                                                    -, //@sic R5s140184, R5-134645 sic@
                                                                    p_MeasGapConfig, //@sic R5s180474 sic@
                                                                    omit,
                                                                    omit,
                                                                    omit,
                                                                    f_ReturnMeasObjectToAddModList_2Entries_v9e0(p_EUTRA_DL_CarrierFreq_1, p_EUTRA_DL_CarrierFreq_2))); //@sic R5-171996 sic@

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_1_3a_Step1(RRC_TransactionIdentifier p_RRC_TI,
