module NR_CommonFunctions_CA {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};

 template (value) SCellConfig cs_SCellConfig_Def(template (omit) ServingCellConfigCommon p_ServingCellConfigCommon,
                                                template (value) ServingCellConfig p_ServingCellConfig,
                                                SCellIndex p_SCellIndex,
                                                template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                                ) :=
 {  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-224929: added p_SCellActivate sic@
    sCellIndex              := p_SCellIndex,
    sCellConfigCommon       := p_ServingCellConfigCommon,
    sCellConfigDedicated    := p_ServingCellConfig,
    smtc                    := omit,
    sCellState_r16          := p_SCellState,   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    secondaryDRX_GroupConfig_r16     := omit,  /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    preConfGapStatus_r17             := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    goodServingCellEvaluationBFD_r17 := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    sCellSIB20_r17                   := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    plmn_IdentityInfoList_r17        := omit,  /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
    npn_IdentityInfoList_r17         := omit   /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
 };

}
