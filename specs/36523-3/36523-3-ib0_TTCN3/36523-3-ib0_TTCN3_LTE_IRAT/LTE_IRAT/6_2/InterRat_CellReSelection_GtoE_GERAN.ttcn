  template (value) GRLCCntrlMsgReqType cs_PacketMeasOrderLTE(template (value) GlobalTFI p_TFI,
                                                             template (value) NC_MeasParams p_NCMeas,
                                                             B1_Type p_NCFreqMask,
                                                             template (omit) NC_FreqList p_NCFreq,
