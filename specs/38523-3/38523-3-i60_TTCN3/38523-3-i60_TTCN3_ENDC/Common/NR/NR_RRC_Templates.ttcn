  const SCellIndex tsc_NR_SCellIndex_2 := 2;  /* @status    APPROVED (ENDC, NR5GC) */

  const SCellIndex tsc_NR_SCellIndex_3 := 3;  /* @status    APPROVED (ENDC) */

  const ServCellIndex tsc_NR_PCellIndex := 0; /* @status    APPROVED (ENDC, NR5GC) */

  const integer tsc_NR_SlotOffsetK2 := 4;                                       /* @sic R5-190723: K2=4 for PUSCH scheduled by PDCCH sic@
                                                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SSB_Index tsc_NR_SSB_Index0 := 0;        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SSB_Index tsc_NR_SSB_Index1 := 1;        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_NR_ENDC_Msg3Grant_Def := 48;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
                                                     Scheduling of Random Access Msg3, handover or EN-DC - Acc to 38.523-3 Table 7.1.2.3.3-1: Default grants @sic R5-201150 sic@  */

  template (value) RSRP_Range cs_38508_RSRP_Range := 0;                         /* Acc to 38.508-1 Table 4.6.3-152: RSRP-Range
                                                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      LogicalChannelId according to 38.508-1 Table 4.6.3-67
   * @param     p_DRBId
   * @return    LogicalChannelIdentity
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_LogicalChannelId_DRB(DRB_Identity p_DRBId) return LogicalChannelIdentity
  { /* @sic R5-190360 R5-244314 sic@ */
    if (f_GetTestcaseAttrib_SRB4_Configured(testcasename())) {return p_DRBId + 4;}
    else {    return p_DRBId + 3;}
  }

  /*
   * @desc      LogicalChannelId according to 38.331 clause 9.2.1 and 38.508-1 Table 4.6.3-67
   * @param     p_SRBId
   * @return    LogicalChannelIdentity
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_LogicalChannelId_SRB(SRB_Identity p_SRBId) return LogicalChannelIdentity
  { /* @sic R5-190360 sic@ */
    var LogicalChannelIdentity v_LogicalChannelId := p_SRBId;
    return v_LogicalChannelId;
  }

  /*
   * @desc      Logical Channel Priority according to 38.331 clause 9.2.1 and 38.508-1 Table 4.6.3-66
   * @param     p_SRBId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_LogicalChannelPriority_SRB(SRB_Identity p_SRBId) return integer
  { /* @sic R5-192742 sic@ */
    var integer v_LogicalChannelPriority := 1;
    if (p_SRBId == tsc_SRB2 or p_SRBId == tsc_SRB4) {
      v_LogicalChannelPriority := 3;
    }
    return v_LogicalChannelPriority;
  }

  /*
   * @desc      ServCellIndex according to 38.508-1 Table 4.6.3-166
   * @param     p_ENDC_SpecificCell (default value: false)
   * @return    ServCellIndex
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ServCellIndex(boolean p_ENDC_SpecificCell := false) return ServCellIndex
  { // @sic R5s221133 sic@
    var ServCellIndex v_ServCellIndex := 0;
    if (f_GetTestcaseAttrib_ENDC(testcasename())or p_ENDC_SpecificCell) {  // @sic R5-192274 R5s220981 sic@
      v_ServCellIndex := 1;
    }
    return v_ServCellIndex;
  }

  template (value) DL_CCCH_Message  cs_38508_RRCSetup(RRC_TransactionIdentifier p_RRC_TransactionIdentifier,
                                                      template (value) RadioBearerConfig p_RadioBearerConfig,
                                                      template (value) CellGroupConfig p_CellGroupConfig) :=
  { // as per 38.508-1 Table 4.6.1-4F: RRCSetup
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        rrcSetup := {
          rrc_TransactionIdentifier   := p_RRC_TransactionIdentifier,
          criticalExtensions  := {
            rrcSetup    := {
              radioBearerConfig           := p_RadioBearerConfig,
              masterCellGroup             := bit2oct(encvalue(p_CellGroupConfig)),
              lateNonCriticalExtension    := omit,
              nonCriticalExtension        := omit
            }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_38508_RRCReconfiguration(template (value) RRC_TransactionIdentifier p_RRC_TI,
                                                               template (omit) RadioBearerConfig p_RadioBearerConfig := omit,
                                                               template (omit) octetstring p_SecondaryCellGroup := omit,
                                                               template (omit) MeasConfig p_MeasConfig := omit,
                                                               template (omit) RRCReconfiguration_v1530_IEs p_RRCReconfiguration_v1530 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        rrcReconfiguration := cs_38508_RRCReconfigurationIE(p_RRC_TI, p_RadioBearerConfig, p_SecondaryCellGroup, p_MeasConfig, p_RRCReconfiguration_v1530)
      }
    }
  };

  template (value) RRCReconfiguration cs_38508_RRCReconfigurationIE(template (value) RRC_TransactionIdentifier p_RRC_TI,
                                                                    template (omit) RadioBearerConfig p_RadioBearerConfig,
                                                                    template (omit) octetstring p_SecondaryCellGroup,
                                                                    template (omit) MeasConfig p_MeasConfig := omit,
                                                                    template (omit) RRCReconfiguration_v1530_IEs p_RRCReconfiguration_v1530 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    rrc_TransactionIdentifier := p_RRC_TI,
    criticalExtensions := {
      rrcReconfiguration := {
        radioBearerConfig := p_RadioBearerConfig,
        secondaryCellGroup := p_SecondaryCellGroup,
        measConfig := p_MeasConfig,
        lateNonCriticalExtension := omit,
        nonCriticalExtension := p_RRCReconfiguration_v1530
      }
    }
  };

  template (present) UL_DCCH_Message cr_38508_RRCReconfigurationComplete(template RRCReconfigurationComplete_v1530_IEs p_RRCReconfigurationComplete_v1530 := *) :=
  { // Acc to 38.508-1 Table 4.6.1-4: RRCReconfigurationComplete
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        rrcReconfigurationComplete := cr_38508_RRCReconfigurationCompleteIE(p_RRCReconfigurationComplete_v1530)
      }
    }
  };

  template (present) RRCReconfigurationComplete cr_38508_RRCReconfigurationCompleteIE (template RRCReconfigurationComplete_v1530_IEs p_RRCReconfigurationComplete_v1530 := * ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    rrc_TransactionIdentifier := ?,
    criticalExtensions := {
      rrcReconfigurationComplete := {
        lateNonCriticalExtension := *,
        nonCriticalExtension := p_RRCReconfigurationComplete_v1530
      }
    }
  };

  template (value) RRCReconfiguration_v1700_IEs cs_RRCReconfiguration_v1700_IEs_NonCritcExt(template (omit) OtherConfig_v1700 p_OtherConfig := omit,
                                                                                      template (omit) RRCReconfiguration_v1700_IEs.ue_TxTEG_RequestUL_TDOA_Config_r17 p_Ue_TxTEG_RequestUL_TDOA_Config:= omit,
                                                                                      template (omit) RRCReconfiguration_v1700_IEs.musim_GapConfig_r17 p_MUSIM_GapConfig_r17 := omit,
                                                                                      template (omit) RRCReconfiguration_v1800_IEs p_RRCReconfiguration_v1800_IEs := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    otherConfig_v1700              := p_OtherConfig,
    sl_L2RelayUE_Config_r17        := omit,
    sl_L2RemoteUE_Config_r17       := omit,
    dedicatedPagingDelivery_r17    := omit,
    needForGapNCSG_ConfigNR_r17    := omit,
    needForGapNCSG_ConfigEUTRA_r17 := omit,
    musim_GapConfig_r17            := p_MUSIM_GapConfig_r17,
    ul_GapFR2_Config_r17           := omit,
    scg_State_r17                  := omit,
    appLayerMeasConfig_r17         := omit,
    ue_TxTEG_RequestUL_TDOA_Config_r17 := p_Ue_TxTEG_RequestUL_TDOA_Config,
    nonCriticalExtension           := p_RRCReconfiguration_v1800_IEs
  }

  template (value) RRCReconfiguration_v1530_IEs cs_NR_RRCReconfiguration_v1530_IEs(template (omit) octetstring p_CellGroupConfig,
                                                                                   template (omit) MasterKeyUpdate p_MasterKeyUpdate := omit,
                                                                                   template (omit) octetstring p_SIB1 := omit,
                                                                                   template (omit) octetstring p_SysInfo := omit,
                                                                                   template (omit) OtherConfig p_OtherConfig := omit,
                                                                                   template (omit) RRCReconfiguration_v1540_IEs p_RRCReconfiguration_v1540_IEs := omit,
                                                                                   template (omit) RRCReconfiguration_v1530_IEs.fullConfig p_FullConfig := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    masterCellGroup                         := p_CellGroupConfig,
    fullConfig                              := p_FullConfig,
    dedicatedNAS_MessageList                := omit, // All NAS Msgs set as Piggybacked Msgs
    masterKeyUpdate                         := p_MasterKeyUpdate,
    dedicatedSIB1_Delivery                  := p_SIB1,
    dedicatedSystemInformationDelivery      := p_SysInfo,
    otherConfig                             := p_OtherConfig,
    nonCriticalExtension                    := p_RRCReconfiguration_v1540_IEs
  };

  template (value) RRCReconfiguration_v1540_IEs cs_RRCReconfiguration_v1540_IEs (template (omit) OtherConfig_v1540 p_OtherConfig_v1540 := omit,
                                                                                template (omit) RRCReconfiguration_v1560_IEs p_RRCReconfiguration_v1560_IEs := omit
