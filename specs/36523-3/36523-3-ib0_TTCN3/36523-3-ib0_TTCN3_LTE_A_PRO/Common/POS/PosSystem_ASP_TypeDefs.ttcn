module PosSystem_ASP_TypeDefs {
  
  import from CommonDefs all;
  
  type enumerated PositioningSystemType {gps, modernizedGPS, glonass, galileo, qzss, otdoa, ecid, bds, mbs, wlan, bluetooth, sensor};
  
  const integer tsc_MaxPosSystems := 12;
  type record length (1..tsc_MaxPosSystems) of PositioningSystemType PositioningSystemList_Type ;
  type record Altitude_Type {
      integer       Height          //Height above a sea level in meters
    }

  
  //----------------------------------------------------------------------------
  group PosSystem_Load_Scenario {       /* Load scenarios follow 3GPP TS 37.571-5 [5] */
  
  type integer ScenarioNumber_Type;

  type union PositioningScenario_Type {
    ScenarioNumber_Type LTE_Positioning,       // Reference to 3GPP TS 37.571-5 [5]
    ScenarioNumber_Type AGNSS,                 // Reference to 3GPP TS 37.571-5 [5]
    ScenarioNumber_Type V2X,                   // V2X  Reference to 3GPP TS 36.508 [7] clause 4.11
    ScenarioNumber_Type NR_Positioning,        // Reference to 3GPP TS 37.571-5 [5]
    ScenarioNumber_Type Aerial,                // Reference to 3GPP TS 36.508 [7] clause 4.12
    ScenarioNumber_Type NR_Sidelink            // Reference to 3GPP TS 38.508-1 [30] clause 4.11
  };

  } // end group PosSystem_Load_Scenario

  group PosSystem_Retrieve_Data {

  group SatSystem_Retrieve_UTRAN_Data {
  
  type record UTRAN_GPS_AssistanceDataRequest_Type {
    bitstring   AssistanceDataReqGPS                            // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GPS-AdditionalAssistanceDataRequest
  };
  
  type record UTRAN_GANSS_AssistanceDataRequest_Type {
    bitstring   AssistanceDataReqGANSS  optional,               // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GANSS-AdditionalAssistanceDataRequest
    bitstring   AssistanceDataReqGANSSv860ext   optional,        // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GANSS-AdditionalAssistanceDataRequest-v860ext
    bitstring   AssistanceDataReqGANSSvc50ext   optional        // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GANSS-AdditionalAssistanceDataRequest-vc50ext
  };
  
  type union UTRAN_AssistanceDataRequest_Type {
    UTRAN_GPS_AssistanceDataRequest_Type        GPS,
    UTRAN_GANSS_AssistanceDataRequest_Type      GANSS
  };
  
  type record length(1..tsc_MaxPosSystems) of UTRAN_AssistanceDataRequest_Type UTRAN_AssistanceDataRequestList_Type;
  
  type record UTRAN_GPS_AssistanceData_Type {                   // The returned Almanac information is split into two fields:
                                                                // Almanac for satellites 1 to 16 in AssistanceDataGPSr7 together with other information;
                                                                // Almanac for satellites 17 to 31: in 'almanacSat17To31'
    bitstring   AssistanceDataGPSr7   optional,                 // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GPS-AssistanceData-r7
    bitstring   AssistanceDataGPSr12  optional,                 // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GPS-AssistanceData-r12
    bitstring   AlmanacSatInfoList17To31        optional        // bitstring containing 3GPP TS 25.331 [12] type AlmanacSatInfoList
  };
  
  type record UTRAN_GANSS_AssistanceData_Type {
    bitstring   AssistanceDataGANSS_r8   optional,              // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GANSS-AssistanceData-r8
    bitstring   AssistanceDataGANSS_r12   optional              // bitstring containing 3GPP TS 25.331 [12] type UE-Positioning-GANSS-AssistanceData-r12
  };
  
  
  type union UTRAN_AssistanceData_Type {
    UTRAN_GPS_AssistanceData_Type       GPS,
    UTRAN_GANSS_AssistanceData_Type     GANSS
  };
  
  type record length(1..tsc_MaxPosSystems) of UTRAN_AssistanceData_Type UTRAN_AssistanceDataList_Type;
  
  } // end group SatSystem_Retrieve_UTRAN_Data
  
  group PosSystem_Retrieve_LPP_Data {
  // When data is to be requested for more than one positioning system, they will be included into one single template. This template will include a list with one element for each positioning system.
  // See template "cs_RequestAssistData_UEB_GpsAndGlonass" as an example.
  type union LPP_AssistanceDataRequest_Type {
    bitstring  LPP_AssistanceData           // bitstring containing 3GPP TS 37.355 [10] type RequestAssistanceData-r9-IEs
  };
  
  type union LPP_AssistanceDataProvide_Type {
    bitstring  LPP_AssistanceData           // bitstring containing 3GPP TS 37.355 [10] type ProvideAssistanceData-r9-IEs
  };
  
  type record length(1..tsc_MaxPosSystems) of LPP_AssistanceDataRequest_Type LPP_AssistanceDataRequestList_Type;
  type record length(1..tsc_MaxPosSystems) of LPP_AssistanceDataProvide_Type LPP_AssistanceDataList_Type;
  
  } // end group PosSystem_Retrieve_LPP_Data
  
  group PosSystem_Retrieve_Data_Common {
  type union AssistanceDataRetrieveRequest_Type {
    LPP_AssistanceDataRequestList_Type      LPP,          // LTE/NR positioning
    UTRAN_AssistanceDataRequestList_Type    UTRA_GNSS     // Retrieve A-GNSS data list in the order of positioning system provided in PositioningSystemList
  };
  
  type union AssistanceDataRetrieveResponse_Type {
    LPP_AssistanceDataList_Type             LPP,          // LTE/NR positioning
    UTRAN_AssistanceDataList_Type           UTRA_AGNSS    // Retrieve A-GNSS data list in the order of positioning system provided in PositioningSystemList
  };
  } // End of PosSystem_Retrieve_Data_Common
  
  } // end group PosSystem_Retrieve_Data

  group PosSystem_PowerControl {
  type union PowerControl_Type {       //V2X. The GNSS simulator is switched on/off without stopping the UTC time sequence
    Null_Type PowerOn,                 //By default the power is on in the GNSS simulator
    Null_Type PowerOff
  };
  } // end group PosSystem_PowerControl
  
  group PosSystem_GnssUtcTime {
  type record GnssUtcTime_Type {
    Struct_tm_Type       Struct_tm,     // Local GNSS time
    integer              TimezoneInfo   // Difference (in seconds) between the UTC time (GMT) and the local time
  };
  } // end group PosSystem_GnssUtcTime

  
  // ----------------------------------------------------------------------------
  
  group System_Interface {                                      /* Common ASP definitions */
  
  type union PosSystemCrtlRequest_Type {
    Null_Type                           Start,
    Null_Type                           Stop,
    PositioningScenario_Type            LoadScenario,
    AssistanceDataRetrieveRequest_Type  RetrieveData,
    Null_Type                           TriggerMove,         //V2X. Start moving to the next area/zone in the scenario
    PowerControl_Type                   TriggerPowerOnOff,   //V2X. Switch on/off the transmitter without stopping UTC time sequence
    Altitude_Type                       SetAltitude,         //Aerial Set the height above the sea level to the provided value
    Altitude_Type                       TriggerAerialMove,   //Aerial Start moving towards target height
    Null_Type                           RetrieveGnssUtcTime  //Get current UTC time of the GNSS scenario. This can only be used once a GNSS scenario has been loaded and started
  };
  
  type union PosSystemCrtlConfirm_Type {                    //In general, to be sent after the configuration has been done
    Null_Type                           Start,
    Null_Type                           Stop,
    Null_Type                           LoadScenario,
    AssistanceDataRetrieveResponse_Type RetrieveData,
    Null_Type                           TriggerMove,          //V2X
    Null_Type                           TriggerPowerOnOff,    //V2X
    Null_Type                           SetAltitude,          //Aerial
    Null_Type                           TriggerAerialMove,    //Aerial
    GnssUtcTime_Type                    RetrieveGnssUtcTime
  };
  
  type record POS_SYSTEM_CTRL_REQ {
    PositioningSystemList_Type  PositioningSystemList,          /* The list of positioning systems to be configured; there is only one system of one type in the list e.g. gps, galileo etc. */
    boolean                     CnfFlag,                        /* true => SS shall send CNF */
    PosSystemCrtlRequest_Type   Request
  };
  
  type record POS_SYSTEM_CTRL_CNF {
    PositioningSystemList_Type        PositioningSystemList,
    PosSystemCrtlConfirm_Type         Confirm
  };
 
  type port POS_MTC_SYSTEM_PORT message {                       /* Positioning: port at the MTC to be mapped to the system */
    out POS_SYSTEM_CTRL_REQ;
    in  POS_SYSTEM_CTRL_CNF;
  };

  type port POS_MTC_PTC_PORT message {                          /* Positioning: port at the MTC to hand over information from the positioning system to the PTC(s) */
    out POS_SYSTEM_CTRL_CNF;
    in  POS_SYSTEM_CTRL_REQ;
  };

  type port POS_PTC_MTC_PORT message {                          /* Positioning: port at the PTC(s) to send commands to the positioning system via the MTC */
    out POS_SYSTEM_CTRL_REQ;
    in  POS_SYSTEM_CTRL_CNF;
  };
  
  } // end group System_Interface

  //============================================================================


  template (present) POS_SYSTEM_CTRL_CNF car_POS_SYSTEM_CTRL_CNF_Any := ?;
  template (present) POS_SYSTEM_CTRL_REQ car_POS_SYSTEM_CTRL_REQ_Any := ?;
  
}

