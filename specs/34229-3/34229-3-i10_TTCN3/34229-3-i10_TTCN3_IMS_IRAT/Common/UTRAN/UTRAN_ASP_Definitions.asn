--
-- CPHY-Out-of-Sync-IND
--   To report that the physical channel synchronization (in FDD mode, sync with uplink DPCCH) was lost as detected by the SS receiver.
--
--**************************************************************

CPHY-Out-of-Sync-IND ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo
}

--**************************************************************
