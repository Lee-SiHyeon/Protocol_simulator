  function f_TC_7_1_7_1_9_EUTRA() runs on EUTRA_PTC
  { /* DL-SCH transport block size selection / DCI format 1B / RA type 2 / Localised VRB / 256QAM */
    f_EUTRA_7_1_7_1_x_256QAM(dci_1B, ra_2_Localised);
