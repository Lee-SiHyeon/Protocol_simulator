module HTTP_CommonTemplates {

  import from HTTP_ASP_TypeDefs all;
  import from IP_ASP_TypeDefs all;

  template (value) HTTP_DATA_ASP cs_HTTP_REQUEST(template (value) IP_Connection_Type p_HttpRoutingInfo,
                                                 template (value) HttpRequest_Type p_HttpRequest) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    routingInfo := p_HttpRoutingInfo,
    http := {
      request := p_HttpRequest
    }
  };

  template (value) HTTP_DATA_ASP cs_HTTP_RESPONSE(template (value) IP_Connection_Type p_HttpRoutingInfo,
                                                  template (value) HttpResponse_Type p_HttpResponse) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    routingInfo := p_HttpRoutingInfo,
    http := {
      response := p_HttpResponse
    }
  };

}
