module LCS_Objects_Templates {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 

  template (present) Invoke cr_InvokeLCS_MOLR_Any :=
  { /* @status    APPROVED (POS) */
    invokeID := ?,
    linkedID := *,
    operationCode :=  {
      local := 115  // for lcs-MOLR
    },
    parameter := {
      lcs_MOLR := {
        molr_Type := ?,
        locationMethod := *,
        lcs_QoS := *,
        lcsClientExternalID := *,
        mlc_Number := *,
        gpsAssistanceData := *,
        supportedGADShapes := *,
        lcsServiceTypeID := *,
        ageOfLocationInfo := *,
        locationType := *,
        pseudonymIndicator := *,
        h_gmlc_address := *,
        locationEstimate := *,
        velocityEstimate := *,
        referenceNumber := *,
        periodicLDRInfo := *,
        locationUpdateRequest := *,
        sequenceNumber := *,
        terminationCause := *,
        mo_lrShortCircuit := *,
        ganssAssistanceData := *,
        multiplePositioningProtocolPDUs := *,
        locationInfo := *, // @sic R5s170598 Baseline Moving sic@
        scheduledLocTime := * // @sic R5s221182 Baseline Moving sic@
      }
    }
  };

  template (present) Invoke cdr_InvokeLocEstimate modifies cr_InvokeLCS_MOLR_Any :=
  { /* @status    APPROVED (POS) */
    parameter := {
      lcs_MOLR := {
        molr_Type := locationEstimate
      }
    }
  };

  template (value) Invoke cs_InvokeLocNotification(InvokeIdType p_InvokeId,
                                                   NotificationToMSUser p_NotificationType,
                                                   ISDN_AddressString p_ExternalAddress,
                                                   NameString p_Name) :=
  { /* @status    APPROVED (POS) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := 116  // for lcsNotification
    },
    parameter := {
      lcsNotification := {
        notificationType := p_NotificationType,
        locationType := {
           locationEstimateType := currentLocation,
           deferredLocationEventType := omit
        },
        lcsClientExternalID := {
          externalAddress := p_ExternalAddress,
          extensionContainer := omit
        },
        lcsClientName := {
          dataCodingScheme := '0F'O, // The USSD-DataCodingScheme shall indicate use of the
                                     // default alphabet through the following encoding
                                     // bit 7 6 5 4 3 2 1 0
                                     //     0 0 0 0 1 1 1 1
          nameString := p_Name,
          lcs_FormatIndicator := omit
        },
        lcsRequestorID := omit,
        lcsCodeword := omit,
        lcsServiceTypeID := omit,
        deferredLocationExt := omit, //  @sic R5s170598 Baseline Moving sic@
        rangingSlExt := omit         //  @sic R5s240534 Baseline Moving sic@
      }
    }
  };

  template (value) ReturnResult cs_ResultLocEstimate(InvokeIdType p_InvokeID,
                                                     template (omit) Ext_GeographicalInformation p_GeoInfo := omit) :=
  { /* @status    APPROVED (POS) */
    invokeID := p_InvokeID,
    result := {
      operationCode := {
        local := 115 // for lcs-MOLR
      },
      parameter := {
        lcsMOLRRes := {
          locationEstimate := p_GeoInfo,
          decipheringKeys   := omit,
          add_LocationEstimate  := omit,
          velocityEstimate      := omit,
          referenceNumber       := omit,
          h_gmlc_address        := omit,
          mo_lrShortCircuit     := omit,
          reportingPLMNList     := omit,
          timestampOfLocationEstimate := omit // @sic R5s221182 Baseline Moving sic@
        }
      }
    }
  };

  template (present) ReturnResult cr_ResultLocNotification(InvokeIdType p_InvokeID,
                                                           VerificationResponse p_Response) :=
  { /* @status    APPROVED (POS) */
    invokeID := p_InvokeID,
    result := {
      operationCode := {
        local := 116 // for lcs-Notification
      },
      parameter := {
        lcsNotifficationRes := {
          verificationResponse := p_Response,
          locationPrivacyIndication := omit,   // @sic R5s201386 Baseline Moving sic@
          validTimePeriod   := omit            // @sic R5s201386 Baseline Moving sic@
        }
      }
    }
  };

  template (value) ReturnError cs_ErrorMOLR(InvokeIdType p_InvokeId,
                                            template (value) Lcs_MOLR_ErrPara p_MOLRError) :=
  { /* @status    APPROVED (POS) */
    invokeID := p_InvokeId,
    errorCode := {
      local:= 115  // for lcs-MOLR
    },
    parameter := {
      lcs_MOLR_ResErrPara := p_MOLRError
    }
  };

  template (value) Lcs_MOLR_ErrPara cs_PositionMethodFailure :=
  { /* @status    APPROVED (POS) */
    positionMethodFailure := {
      positionMethodFailure_Diagnostic := omit,
      extensionContainer := omit
    }
  };

}
