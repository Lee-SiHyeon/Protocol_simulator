  /*
   * @desc      Set RedCap_ConfigCommonSIB_r17 value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @param     p_CellBarredRedCap1Rx
   * @param     p_CellBarredRedCap2Rx
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_RedCap_ConfigCommonSIB_r17 (NR_CellId_Type p_NR_CellId,
                                                             CellBarredRedCap1Rx_r17_Type p_CellBarredRedCap1Rx,
                                                             CellBarredRedCap2Rx_r17_Type p_CellBarredRedCap2Rx) runs on NR_BASE_PTC
  { //@sic R5s230290 Ch. 2 sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var template (value) RedCap_ConfigCommonSIB_r17 v_RedCap_ConfigCommonSIB_r17 := cs_RedCap_ConfigCommonSIB_Omit;

    // FR1 barred - FR1, Not Barred
    if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCap_ConfigCommon_r17)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCap_ConfigCommon_r17.cellBarredRedCap_r17.cellBarredRedCap1Rx_r17 := p_CellBarredRedCap1Rx;
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCap_ConfigCommon_r17.cellBarredRedCap_r17.cellBarredRedCap2Rx_r17 := p_CellBarredRedCap2Rx;
    } else {
        v_RedCap_ConfigCommonSIB_r17.cellBarredRedCap_r17.cellBarredRedCap1Rx_r17 := p_CellBarredRedCap1Rx;
        v_RedCap_ConfigCommonSIB_r17.cellBarredRedCap_r17.cellBarredRedCap2Rx_r17 := p_CellBarredRedCap2Rx;
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCap_ConfigCommon_r17 := valueof(v_RedCap_ConfigCommonSIB_r17); // contents of template validates use of valueof here
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  };

