  template (present) SDP_fmt_list cr_SDP_FmtList_AtLeastOne(template (present) charstring p_Fmt) := { p_Fmt, * };            /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SDP_media_field cr_SDP_Media(template (present) charstring p_Media,
                                                  template (present) integer p_LocalPort := ?,
                                                  template (present) charstring p_Transport := c_rtpAvp,
                                                  template (present) SDP_fmt_list p_FmtList := ?) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    media := p_Media,
    ports := {
      port_number := p_LocalPort,
      num_of_ports := omit
    },
    transport := p_Transport,
    fmts := p_FmtList
  };

  template (present) SDP_media_field cr_SDP_Media_Audio(template (present) charstring p_Fmt := cr_SDP_AnyMediaFormatDescr,
                                                        template (present) integer p_LocalPort := ?,
                                                        template (present) charstring p_Transport := c_rtpAvp) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    cr_SDP_Media(c_audio, p_LocalPort, p_Transport, cr_SDP_FmtList_AtLeastOne(p_Fmt));

  template (present) SDP_media_field cr_SDP_Media_Video(template (present) charstring p_Fmt := cr_SDP_AnyMediaFormatDescr,
                                                        template (present) integer p_LocalPort := ?,
                                                        template (present) charstring p_Transport := c_rtpAvpf) :=
  /* @status    APPROVED (IMS, LTE, LTE_A_R12, MCX, NR5GC) */
  /* @sic R5s141221 change 2.3: p_Transport sic@ */
  /* @sic R5s141329 change 1 and R5s141336 change 1: c_rtpAvpf as default value for p_Transport sic@ */
    cr_SDP_Media(c_video, p_LocalPort, p_Transport, cr_SDP_FmtList_AtLeastOne(p_Fmt));

  /*
   * @desc      return true when the media field has port number 0
   * @param     p_SDP_Media_Field
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_SDP_Media_Field_IsForMediaRelease(template (present) SDP_media_field p_SDP_Media_Field) return boolean
  {
    var integer v_PortNumber;

    if (isvalue(p_SDP_Media_Field.ports.port_number)) {
      v_PortNumber := valueof(p_SDP_Media_Field.ports.port_number);
      if (v_PortNumber == 0) {  // => release of the media stream
        return true;
      }
    }
    return false;
  }

  template (value) SDP_Origin cs_SDP_Origin(charstring p_Username := "-",
                                            charstring p_SessionId,
                                            charstring p_SessionVersion,
                                            template (value) charstring p_AddrType,
                                            template (value) charstring p_IPAddr) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5-150707: new parameter p_SessionId sic@ */
    user_name := p_Username,
    session_id := p_SessionId,
    session_version := p_SessionVersion,
    net_type := c_in,
    addr_type := p_AddrType,
    addr := p_IPAddr
  };

  template (present) SDP_Origin cr_SDP_Origin(template (present) charstring p_Username := ?,
                                              template (present) charstring p_AddrType := ?,
                                              template (present) charstring p_IPAddr := ?) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    user_name := p_Username,
    session_id := ?,
    session_version := ?,
    net_type := c_in,
    addr_type := p_AddrType,
    addr := p_IPAddr
  };

  template (value) SDP_time cs_SDP_Time(charstring p_Start,
                                        charstring p_Stop) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    time_field := {
      start_time := p_Start,
      stop_time := p_Stop
    },
    time_repeat := omit
  };

  template (value) SDP_time cs_SDP_Time_0_0 := cs_SDP_Time("0", "0"); /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SDP_time cr_SDP_Time(template (present) charstring p_Start,
                                          template (present) charstring p_Stop) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    time_field := {
      start_time := p_Start,
      stop_time := p_Stop
    },
    time_repeat := omit
  };

  template (present) SDP_time cr_SDP_Time_0_0 := cr_SDP_Time("0", "0");                /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SDP_time cr_SDP_Time_Any := cr_SDP_Time(?, ?);                    /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (value) SDP_media_desc cs_SDP_Media_Desc_Common(template (value) SDP_media_field p_SDP_Media_Field,
                                                           template (omit) charstring p_MediaTitle := omit,
                                                           template (omit) SDP_connection_list  p_SDP_Connection_List := omit,
                                                           template (omit) SDP_bandwidth_list p_SDP_Bandwidth_List := omit,
                                                           template (omit) SDP_attribute_list p_SDP_Attribute_List := omit) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    media_field := p_SDP_Media_Field,
    information := p_MediaTitle,
    connections := p_SDP_Connection_List,
    bandwidth := p_SDP_Bandwidth_List,
    key := omit,
    attributes := p_SDP_Attribute_List
  };

  template (value) SDP_media_desc cs_SDP_Media_Desc(template (value) SDP_media_field p_SDP_Media_Field,
                                                    template (omit) SDP_bandwidth_list p_SDP_Bandwidth_List := omit,
                                                    template (omit) SDP_attribute_list p_SDP_Attribute_List := omit,
                                                    template (omit) SDP_connection_list  p_SDP_Connection_List := omit) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cs_SDP_Media_Desc_Common(p_SDP_Media_Field, -, p_SDP_Connection_List, p_SDP_Bandwidth_List, p_SDP_Attribute_List);

  template (present) SDP_media_desc cr_SDP_Media_Desc_Common(template (present) SDP_media_field p_SDP_Media_Field,
                                                             template charstring p_MediaTitle := omit,
                                                             template SDP_connection_list p_ConnectionList := omit,
                                                             template SDP_bandwidth_list p_SDP_Bandwidth_List := omit,
                                                             template SDP_attribute_list p_SDP_Attribute_List := omit) :=
  {  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    media_field := p_SDP_Media_Field,
    information := p_MediaTitle,
    connections := p_ConnectionList,
    bandwidth := p_SDP_Bandwidth_List,
    key := omit,
    attributes := p_SDP_Attribute_List
  };

  template (present) SDP_media_desc cr_SDP_Media_Desc(template (present) SDP_media_field p_SDP_Media_Field,
                                                      template SDP_connection  p_SDP_Connection,
                                                      template SDP_bandwidth_list p_SDP_Bandwidth_List,
                                                      template SDP_attribute_list p_SDP_Attribute_List) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cr_SDP_Media_Desc_Common(p_SDP_Media_Field, -, { p_SDP_Connection, * } ifpresent, p_SDP_Bandwidth_List, p_SDP_Attribute_List);

  template (value) SDP_Message cs_SDP_Message_Common(template (value) SDP_Origin p_SDP_Origin,
                                                     charstring p_Sessionname := tsc_SDP_NoSessionname,
                                                     template (omit) SDP_connection p_SDP_Connection := omit,
                                                     template (omit) SDP_bandwidth_list p_Bandwidth,
                                                     template (value) SDP_time p_Time := cs_SDP_Time_0_0,
                                                     template (omit) SDP_media_desc_list p_SDP_Media_Desc_List := omit) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5s130510 change 4 - additional change sic@ */
    /* @sic R5-144700: default value removed for p_Bandwidth sic@ */
    /* @sic R5-150386: there is no reason anymore to provide a parameter for session_name anymore sic@ */
    protocol_version := 0,                                              // v-line
    origin := p_SDP_Origin,                                             // o-line
    session_name := p_Sessionname,                                      // s-line
    information := omit,
    uri := omit,
    emails := omit,
    phone_numbers := omit,
    connection := p_SDP_Connection,                                     // c-line
    bandwidth :=  p_Bandwidth,                                          // b-line
    times := { p_Time },                                                // t-line
    timezone_adjustments := omit,
    key := omit,
    attributes := omit,
    media_list := p_SDP_Media_Desc_List
  };

  template (present) SDP_Message cr_SDP_Message_Common(template (present) charstring p_Username := ?,
                                                       template (present) charstring p_AddrType := ?,
                                                       template (present) charstring p_IPAddrOrigin := ?,
                                                       template (present) charstring p_IPAddrConnection := ?,
                                                       template           SDP_bandwidth_list p_Bandwidth := cr_SDP_Bandwidth_List_AS,
                                                       template (present) SDP_time p_Time := cr_SDP_Time_0_0,
                                                       template SDP_media_desc_list p_SDP_Media_Desc_List := *) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5-150386: there is no reason anymore to provide a parameter for session_name anymore sic@ */
    protocol_version := 0,                                                       // v-line
    origin := cr_SDP_Origin(p_Username, p_AddrType, p_IPAddrOrigin),             // o-line
    session_name := ?,                                                           // s-line
    information := omit,
    uri := omit,
    emails := omit,
    phone_numbers := omit,
    connection := cr_SDP_Connection(p_AddrType, p_IPAddrConnection) ifpresent,   // c-line
    bandwidth :=  p_Bandwidth,                                                   // b-line
    times := { p_Time },                                                         // t-line
    timezone_adjustments := omit,
    key := omit,
    attributes := omit,
    media_list := p_SDP_Media_Desc_List
  };

}
