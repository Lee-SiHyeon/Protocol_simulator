    octetstring                 data  length (1..2026)  optional  // @sic R5w190307 sic@
  };

  type record SOR_DataType0WithAddInfo {
    O1_Type                     lenOfPLMNList optional,
    PLMN_AccessTechList         plmnAccessList          optional,
    B4_Type                     spare,
    B1_Type                     sssli,
    B1_Type                     sssi,
    B1_Type                     sscmi,
    B1_Type                     si,
    SOR_CMCI                    sorCMCI                 optional,
    SOR_SNPN_SI                 sorSNPN_SI              optional,
    SOR_SNPN_SI_LS              sorSNPN_SI_LS           optional
  };
  
  type record of PLMN_AccessTech    PLMN_AccessTechList;  /* 24.501 cl. 9.11.3.51 */
