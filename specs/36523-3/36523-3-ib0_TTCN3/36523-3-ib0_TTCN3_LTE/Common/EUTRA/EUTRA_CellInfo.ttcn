  }

  /*
   * @desc      Get PDN Type as assigned to the UE
   * @param     p_PdnIndex          (default value: PDN_1)
   * @return    B3_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_EUTRA_MobileInfo_GetAssignedPdnType(PDN_Index_Type p_PdnIndex := PDN_1) runs on EUTRA_PTC return B3_Type
  {
    var integer v_Index := f_PDN_PdnIndex2Integer(p_PdnIndex);
    return vc_EUTRA_Global.MobileInfo.PdnInfo.AssignedPdnType[v_Index];
  }

