  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of srb3 along with fdd-Add-UE-MRDC-Capabilities, tdd-Add-UE-MRDC-Capabilities for Rel-15 UEs. Note 3
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC)
   */
  function fl_Check_srb3(UE_MRDC_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 sic@
    var boolean v_GeneralParsMRDC_srb3 := false;
    var boolean v_FDD_Add_MRDC_srb3 := false;
    var boolean v_TDD_Add_MRDC_srb3 := false;
    var UE_MRDC_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var GeneralParametersMRDC_XDD_Diff v_GeneralParametersMRDC_XDD_Diff_srb3;
    var GeneralParametersMRDC_XDD_Diff v_FDD_Add_UE_MRDC_Cap_srb3;
    var GeneralParametersMRDC_XDD_Diff v_TDD_Add_UE_MRDC_Cap_srb3;
                  
    if (ispresent(v_ReceivedCapabilityMsg.generalParametersMRDC)) {
      v_GeneralParametersMRDC_XDD_Diff_srb3 := v_ReceivedCapabilityMsg.generalParametersMRDC;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_MRDC_Capabilities.generalParametersMRDC_XDD_Diff)) {
      v_FDD_Add_UE_MRDC_Cap_srb3 := v_ReceivedCapabilityMsg.fdd_Add_UE_MRDC_Capabilities.generalParametersMRDC_XDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_MRDC_Capabilities.generalParametersMRDC_XDD_Diff)) {
      v_TDD_Add_UE_MRDC_Cap_srb3 := v_ReceivedCapabilityMsg.tdd_Add_UE_MRDC_Capabilities.generalParametersMRDC_XDD_Diff;
    }
    
    if(pc_srb3) {
      // check indication of generalParametersMRDC_XDD_Diff
      if (ispresent(v_GeneralParametersMRDC_XDD_Diff_srb3.srb3)){
          v_GeneralParsMRDC_srb3 := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_MRDC_Cap_srb3.srb3)){
          v_FDD_Add_MRDC_srb3 := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_MRDC_Cap_srb3.srb3)){
          v_TDD_Add_MRDC_srb3 := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_GeneralParsMRDC_srb3, v_FDD_Add_MRDC_srb3, v_TDD_Add_MRDC_srb3)))  //@sic R5s240548 sic@
      {
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_srb3 to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_DualModeCheck()) and ((not v_GeneralParsMRDC_srb3) or v_FDD_Add_MRDC_srb3 or v_TDD_Add_MRDC_srb3)) { //@sic R5s200160 sic@
         f_SetVerdict(fail, __FILE__, __LINE__, "Reporting of generalParametersMRDC is inconsistent with pc_srb3 on Single Mode");  //Fail case Single Mode
      }
      else if (f_NR_DualModeCheck() and ((v_FDD_Add_MRDC_srb3 and v_TDD_Add_MRDC_srb3) or (v_GeneralParsMRDC_srb3 and (v_FDD_Add_MRDC_srb3 or v_TDD_Add_MRDC_srb3)))) {
         f_SetVerdict(fail, __FILE__, __LINE__, "Reporting of fdd/tdd-Add-UE-MRDC-Capabilities IEs is inconsistent with Dual Mode");  // Fail case Dual mode
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (((ispresent(v_GeneralParametersMRDC_XDD_Diff_srb3.srb3))) or
          ((ispresent(v_FDD_Add_UE_MRDC_Cap_srb3.srb3))) or
          ((ispresent(v_TDD_Add_UE_MRDC_Cap_srb3.srb3)))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_srb3 to false is inconsistent with reported capabilities for Rel-15 and above UE");
      }
    }
  }

