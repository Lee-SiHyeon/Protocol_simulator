      ul_MAC_HeaderType := omit,
      modeSpecific := {
        fdd := {
          tti := f_Get_EDCH_TTI_Value()
        }
      },
      harq_Info := rvtable,
      addReconf_MAC_d_FlowList := { //condition A14 for Radio Bearer Setup in TS 34.108
        cs_E_DCH_AddReconf_MAC_d_Flow_DCCH_r7_FDD,
        cs_E_DCH_AddReconf_MAC_d_Flow_DTCH_r7
      }
    }
  };

