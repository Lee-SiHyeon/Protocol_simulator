  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.21s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_21s_NR5GC() runs on NR5GC_POS_PTC
  {//LPP Abort - DL-TDOA, Rel-16 onwards

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cells
    f_POS_NR_CellConfig_DlPrs(nr_Cell1);
    f_POS_NR_CellConfig_DlPrs(nr_Cell2);
    f_POS_NR_CellConfig_DlPrs(nr_Cell3); // This cell is only used in the UEB case (if supported by the UE)

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower(nr_Cell2, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);
    f_NR_SetCellPower(nr_Cell3, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);

    // Table 9.3.1.2.3.1-1: Configuration of measurement gaps for DL-TDOA
    f_NR_ConfigMeasGap_OTDOA();

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_2_DlTdoa_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_1_2_21s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.DlTdoa
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_DlTdoa_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;
    var template (value) NR_DL_TDOA_ProvideAssistanceData_r16 v_DlTdoaProvideAssistanceData;
    var ReferencePoint_r16 v_RefPoint := valueof(cs_RefPoint); // 37.571-2, Table 8.4.1.7-1
    var RelativeLocation_r16 v_TrpLocation_Cell2 := valueof(cs_RelativeLocation); // 37.571-2, Table 8.4.1.7-1
    var RelativeLocation_r16 v_TrpLocation_Cell3 := valueof(cs_RelativeLocation); // 37.571-2, Table 8.4.1.7-1

    timer t_Wait;

    //@siclog "Step 00" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(21));

    //@siclog "Steps 0, 0a, 0b" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    if (not pc_UEB_DL_TDOA and not pc_UEA_DL_TDOA) { //@sic R5s240146 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in Location Method PICS");
    }

    //The procedure is executed for each method (UEB and/or UEA) supported
    if (pc_UEB_DL_TDOA) {
      //@siclog "Step 0c" siclog@
      //SS sends LPP PROVIDE ASSISTANCE DATA
      v_DlTdoaProvideAssistanceData := cs_DlTdoaProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(3),
                                                                      {cs_NrSelectedDlPrsPerFreq(0),
                                                                       cs_NrSelectedDlPrsPerFreq(1)},
                                                                      cs_NrPositionCalculationAssist({cs_NrTrpLocationInfoPerFreqLayer(v_RefPoint,
                                                                                                                                       {cs_TrpLocInfoElement(0),
                                                                                                                                        cs_TrpLocInfoElement(1, v_TrpLocation_Cell2)}),
                                                                                                      cs_NrTrpLocationInfoPerFreqLayer(omit,
                                                                                                                                      {cs_TrpLocInfoElement(2, v_TrpLocation_Cell3)})}));
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                            locationServer,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,-,
                                                                            v_DlTdoaProvideAssistanceData));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationEstimateRequired, // UEB
                                                                              10,
                                                                              omit,
                                                                              omit,
                                                                              -,-,-,-,-,-,-,-,-,
                                                                              cs_DlTDOARequestLocationInfoDef));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
      //SS sends LPP ABORT
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 3" siclog@
      //The SS waits for 10 seconds to ensure the UE does not send a LPP message of type Provide Location Information
      //with the same transaction ID as in step 1.
      v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                         *, *, *, *, *,
                                         cr_RoutingInfoNR(tsc_POS_RoutingId),
                                         *, *, *, *, *); //@sic R5s240531 Baseline Moving sic@
      t_Wait.start(10.0);
      alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                           tsc_NR_RbId_SRB2,
                                           cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                         v_GMMMsg))) -> value v_ReceivedAsp
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_DlTdoa_UEB(0));
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
          t_Wait.stop;
        }

      [] t_Wait.timeout
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
        }
      }
    }
    if (pc_UEA_DL_TDOA) {
      //@siclog "Step 0c" siclog@
      //SS sends LPP PROVIDE ASSISTANCE DATA
      v_DlTdoaProvideAssistanceData := cs_DlTdoaProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(2),
                                                                      {cs_NrSelectedDlPrsPerFreq(0)},
                                                                      omit);
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                            locationServer,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,-,
                                                                            v_DlTdoaProvideAssistanceData));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationMeasurementsRequired, // UEA
                                                                              10,
                                                                              omit,
                                                                              omit,
                                                                              -,-,-,-,-,-,-,-,-,
                                                                              cs_DlTDOARequestLocationInfoDef));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
      //SS sends LPP ABORT
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 3" siclog@
      //The SS waits for 10 seconds to ensure the UE does not send a LPP message of type Provide Location Information
      //with the same transaction ID as in step 1.
      v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                         *, *, *, *, *,
                                         cr_RoutingInfoNR(tsc_POS_RoutingId),
                                         *, *, *, *, *); //@sic R5s240531 Baseline Moving sic@
      t_Wait.start(10.0);
      alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                         tsc_NR_RbId_SRB2,
                                         cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                       v_GMMMsg))) -> value v_ReceivedAsp
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_UEA(0));
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
          t_Wait.stop;
        }

      [] t_Wait.timeout
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
        }
      }
    }
  } // end of function f_TC_9_3_1_2_DlTdoa_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.1
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_1_NR5GC() runs on NR5GC_PTC
  {//LPP Duplicated Message

    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_2_1_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_2_1_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.1
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_1_NR5GC_TestBody() runs on NR_BASE_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var octetstring v_EncodedLppMessage;
    var octetstring v_Octetstring;
    var LPP_Message v_LppMessage;
    timer t_Wait;

    //@siclog "Step 1" siclog@
    //SS sends LPP REQUEST CAPABILITIES
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestCapabilities_SeqNumber(tsc_POS_TransactionNumber, 0));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 2" siclog@
    //SS sends again the same LPP REQUEST CAPABILITIES
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //Receive LPP PROVIDE CAPABILITIES
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideCapabilities(tsc_POS_TransactionNumber));

    //@siclog "Step 3a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 3
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);

    //@siclog "Step 4" siclog@
    //Wait for 10 seconds and check no other LPP Provide Capabilities is received
    t_Wait.start(10.0);
    alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                           tsc_NR_RbId_SRB2,//seguir aqui
                                           cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                         cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                                                                *, *, *, *, *,
                                                                                cr_RoutingInfoNR(tsc_POS_RoutingId), //@sic R5s201393 sic@
                                                                                *, *, *, *, *)))) -> value v_ReceivedAsp //@sic R5s201387, R5s240531 Baseline Moving sic@
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideCapabilities (tsc_POS_TransactionNumber));

          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4");
          t_Wait.stop;
        }
      [] t_Wait.timeout
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.1 Step 4");
        }
    }

  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.2
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_2_NR5GC() runs on NR5GC_PTC
  {//LPP Acknowledgment

    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_2_2_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_2_2_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.2
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_2_NR5GC_TestBody() runs on NR_BASE_PTC
  {
    var octetstring v_EncodedLppMessage;
    var octetstring v_Octetstring;
    var LPP_Message v_LppMessage;

    //@siclog "Step 1" siclog@
    //SS sends LPP REQUEST CAPABILITIES
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestCapabilities_AckReq(tsc_POS_TransactionNumber, 0));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 2" siclog@
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_LppMessage_Decode(v_Octetstring);

    //Option 1: Receive LPP PROVIDE CAPABILITIES including ACK
    if (match (v_LppMessage, cr_LppProvideCapabilities_AckIndicator (tsc_POS_TransactionNumber, 0))) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.2 Step 2, Option 1");
    }
    //Option 2: Receive ACK
    if (match (v_LppMessage, cr_LppAcknowledgement (0))) {
      //Receive LPP PROVIDE CAPABILITIES
      v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
      v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideCapabilities (tsc_POS_TransactionNumber));
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.2 Step 2, Option 2");
    }

    //@siclog "Step 3" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 3
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.3
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_3_NR5GC() runs on NR5GC_PTC
  {//LPP Retransmission

    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_2_3_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_2_3_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.2.3
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_2_3_NR5GC_TestBody() runs on NR_BASE_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var octetstring v_EncodedLppMessage;
    var octetstring v_Octetstring;
    var LPP_Message v_LppMessage;
    var integer v_SeqNum;
    timer t_Wait;

    //@siclog "Step 1" siclog@
    //SS sends LPP REQUEST CAPABILITIES
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestCapabilities(tsc_POS_TransactionNumber));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 2" siclog@
    //Receive LPP PROVIDE CAPABILITIES
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideCapabilities_AckReq(tsc_POS_TransactionNumber, ?));
    v_SeqNum := v_LppMessage.sequenceNumber;

    //@siclog "Steps 3 and 4" siclog@
    //UE retransmits LPP PROVIDE CAPABILITIES
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideCapabilities_AckReq (tsc_POS_TransactionNumber, v_SeqNum));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.3 Step 4");

    t_Wait.start(10.0);
    alt {
     [] t_Wait.timeout
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.3 Step 10");
        }
     [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, //@siclog "Steps 6" siclog@
                                          tsc_NR_RbId_SRB2,
                                          cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                        cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                                                               *, *, *, *, *,
                                                                               cr_RoutingInfoNR(tsc_POS_RoutingId), //@sic R5s201393 sic@
                                                                               *, *, *, *, *)))) -> value v_ReceivedAsp //@sic R5s201387, R5s240531 Baseline Moving sic@

        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideCapabilities_AckReq (tsc_POS_TransactionNumber, v_SeqNum));

          t_Wait.start(10.0);
          alt {
             [] t_Wait.timeout
                {
                  f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.3 Step 10");
                }
             [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, //@siclog "Steps 8" siclog@
                                                  tsc_NR_RbId_SRB2,
                                                  cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                                cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                                                                       *, *, *, *, *,
                                                                                       cr_RoutingInfoNR(tsc_POS_RoutingId), //@sic R5s201393 sic@
                                                                                       *, *, *, *, *)))) -> value v_ReceivedAsp //@sic R5s201387, R5s240531 Baseline Moving sic@
                {
                  v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
                  v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideCapabilities_AckReq (tsc_POS_TransactionNumber, v_SeqNum));
                  t_Wait.start(10.0);
                  t_Wait.timeout;
                  f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.2.3 Step 10");
                }
          }
        }
    }
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.1.15s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_1_15s_NR5GC() runs on NR5GC_POS_PTC
  {//E-SMLC Initiated Assistance Data Delivery followed by Location Information Transfer: UE-Based - GNSS
    var PositioningSystemList_Type v_GNSSList := f_POS_GetListOfSupportedGNSS();

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_POS_StartPositioningSimulatorNR (v_GNSSList, 15); // Scenario for Subtest 15 according to 37.571-5, 6.1.2

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_4_1_GNSS_NR5GC_TestBody(v_GNSSList);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    f_POS_StopPositioningSimulatorNR (v_GNSSList);
  } //end of f_TC_9_3_4_1_15s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.1.GNSS
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_1_GNSS_NR5GC_TestBody (PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;

    //@siclog "Step 1" siclog@
    //Clear stored GNSS assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_AgnssUEPosTech);

    //@siclog "Steps 1a, 1b, 1c" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    // Retrieve data from Satellite simulator
    v_ProvideAssistData := f_POS_RetrieveNR_DataGNSS(p_PosSystemListId);

    //@siclog "Step 2" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    f_POS_NR_SendLppProvideAssistanceData_GNSS(true, // UE-Based case
                                               tsc_POS_TransactionNumber,
                                               tsc_POS_RoutingId,
                                               v_ProvideAssistData,
                                               omit);

    //@siclog "Step 3" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationEstimateRequired,
                                                                            tsc_ResponseTimeDef,
                                                                            cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId),
                                                                                                        false),
                                                                            omit,
                                                                            omit));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 4" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideLocationInformation_Agnss_UEB(tsc_POS_TransactionNumber));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.1 Step 4");

    //@siclog "Step 4a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 4
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_1_GNSS_NR5GC_TestBody

