module NR_CellCfg_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_Component_Base all;
  import from NR_DCI_Configuration all;
  import from NR_L2_Common all;
  import from NR_RRC_Templates all;
  import from NR_ResourceAllocation all;

  const NR_TimingAdvanceIndex_Type tsc_NR_TA_Def := 31;               /* by default all timing advance in a typical simulation environment is zero
                                                                         @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_TimingAdvance_Period_Type tsc_NR_TA_Period_Def := 600;     /* corresponding to Default of TimeAlignmentTimer = ms750
                                                                         @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_TempC_RNTI_Type cs_NR_TempC_RNTI_Explicit(RNTI_Value_Type p_TempC_RNTI_Value) := { Explicit := p_TempC_RNTI_Value };        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DrxCtrl_Type cs_NR_DrxCtrl_None  :=   {  None := true };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_CellConfig_REQ(NR_CellId_Type    p_NR_CellId,
                                                            NR_CellInfo_Type  p_NR_CellInfo,
                                                            template (value) TimingInfo_Type p_TimingInfo,
                                                            template (omit) NR_CellConfigPhysicalLayerDownlink_Type p_NR_CellConfigPhysicalLayerDownlink := omit,
                                                            template (omit) NR_CellConfigPhysicalLayerUplink_Type p_NR_CellConfigPhysicalLayerUplink := omit,
                                                            template (omit) NR_BcchToPdschConfig_Type p_NR_BcchToPdschConfig := omit,
                                                            template (omit) NR_PcchConfig_Type p_NR_PcchConfig := omit,
                                                            template (omit) NR_RachProcedureConfig_Type p_NR_RachProcedure := omit,
                                                            template (omit) NR_CellCA_Capability_Type p_CA_CellCapability := None,
                                                            boolean p_IsSharedSpectrum := false) := //SharedSpectrum
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5s200038: set default value of p_CA_CellCapability to None sic@
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := {
            CA_Capability := p_CA_CellCapability
          },
          CellConfigCommon := {
            C_RNTI:= p_NR_CellInfo.RNTI.RNTI,
            CellTimingInfo := p_NR_CellInfo.CellTimingInfo,
            InitialCellPower := p_NR_CellInfo.ReferencePower
          },
          PhysicalLayer := {
            Common := {
              PhysicalCellId := p_NR_CellInfo.CellIds.PhysicalCellId,
              DuplexMode := p_NR_CellInfo.DuplexMode
            },
            Downlink := p_NR_CellConfigPhysicalLayerDownlink,
            Uplink := p_NR_CellConfigPhysicalLayerUplink
          },
          BcchConfig := {
            Pbch := true,
            Pdsch := p_NR_BcchToPdschConfig, //no SIB1/SIs for EN-DC
            BcchInfo := {
              MIB := p_NR_CellInfo.Sysinfo.BcchInfo.MIB,
              SIB1 := p_NR_CellInfo.Sysinfo.BcchInfo.SIB1,
              SIs := p_NR_CellInfo.Sysinfo.BcchInfo.SIs,
              SegmentedSIs := p_NR_CellInfo.Sysinfo.BcchInfo.SegmentedSIs,
              PosSIs := p_NR_CellInfo.Sysinfo.BcchInfo.PosSIs,           //@sic R5w220107 sic@
              NCD_MIBs := omit    //@sic R5w230309 sic@
            }
          },
          PcchConfig := p_NR_PcchConfig,
          RachProcedureConfig := p_NR_RachProcedure,
          DcchDtchConfig := {
            DL := {
              SearchSpaceAndDci := f_NR_SearchSpaceDlDciAssignment_USS(p_NR_CellInfo.PhysicalParameters, p_IsSharedSpectrum),  //@sic R5s190895 sic@, SharedSpectrum
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            UL := {
              SearchSpaceAndDci := f_NR_SearchSpaceUlDciAssignment(p_NR_CellInfo.PhysicalParameters, p_IsSharedSpectrum),     //@sic R5s190895 sic@, SharedSpectrum
              PUCCH_Synch := { None := true},
              GrantConfig := { None := true},         //@sic R5s190412 sic@
              CoresetPoolIndex := omit                //@sic R5w240003 sic@
            },
            DrxCtrl := cs_NR_DrxCtrl_None,           //@sic R5-197222 sic@
            MeasGapCtrl := cs_NR_MeasGapCtrl_None,   //@sic R5-197222 sic@
            DL2 := omit,                             //@sic R5w240003 sic@
            UL2 := omit                              //@sic R5w240003 sic@
          },
          ServingCellConfig := p_NR_CellInfo.ServingCellConfig,
          SidelinkScheduled := omit,                  //@sic R5w230215 sic@
          NtnConfig := omit                           //@sic R5w240105r1 sic@
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_CellConfigNoUL_REQ(NR_CellId_Type    p_NR_CellId,
                                                                 NR_CellInfo_Type  p_NR_CellInfo,
                                                                 template (value) TimingInfo_Type p_TimingInfo,
                                                                 template (omit) NR_CellConfigPhysicalLayerDownlink_Type p_NR_CellConfigPhysicalLayerDownlink := omit,
                                                                 template (omit) NR_CellConfigPhysicalLayerUplink_Type p_NR_CellConfigPhysicalLayerUplink := omit,
                                                                 template (omit) NR_BcchToPdschConfig_Type p_NR_BcchToPdschConfig := omit,
                                                                 template (omit) NR_PcchConfig_Type p_NR_PcchConfig := omit,
                                                                 template (omit) NR_RachProcedureConfig_Type p_NR_RachProcedure := omit,
                                                                 template (omit) NR_CellCA_Capability_Type p_CA_CellCapability := None,
                                                                 boolean p_IsSharedSpectrum := false) //SharedSpectrum, because added to the root template
    modifies cas_NR_CellConfig_REQ :=
      { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5s200038: set default value of p_CA_CellCapability to None sic@
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo),
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Uplink := omit
          },
          DcchDtchConfig := {
            UL := omit
          }
        }
      }
    }
  };

  template(value) NR_SYSTEM_CTRL_REQ cas_NR_CellConfigAllOmit_REQ(NR_CellId_Type  p_NR_CellId,
                                                                   template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) :=
  { // Base template for derived cell configuration templates
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := omit,
          CellConfigCommon     := omit,
          PhysicalLayer        := omit,
          BcchConfig           := omit,
          PcchConfig           := omit,
          RachProcedureConfig  := omit,
          DcchDtchConfig       := omit,
          ServingCellConfig    := omit,
          SidelinkScheduled    := omit,              //@sic R5w230215 sic@
          NtnConfig            := omit               //@sic R5w240105r1 sic@
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_ServingCellConfig_REQ(NR_CellId_Type  p_NR_CellId,
                                                                    template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                    template (value) NR_ServingCellConfig_Type p_NR_ServingCellConfig,
                                                                    template (omit) NR_SS_StaticCellResourceConfig_Type p_NR_SS_StaticCellResourceConfig_Type := omit,
                                                                    template (omit) boolean p_CnfFlag := omit,
                                                                    boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                                                    ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-206369: added p_CnfFlag and p_FollowOnFlag sic@
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag, p_FollowOnFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := p_NR_SS_StaticCellResourceConfig_Type,
          ServingCellConfig := p_NR_ServingCellConfig
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_RachProcedureConfig_REQ(NR_CellId_Type  p_NR_CellId,
                                                                      template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                      template (value) NR_RachProcedureConfig_Type p_RachProcedureConfig,
                                                                      template (omit) boolean p_CnfFlag := omit,
                                                                      boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                                                    ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag, p_FollowOnFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          RachProcedureConfig := p_RachProcedureConfig
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_PDSCH_Config_REQ(NR_CellId_Type  p_NR_CellId,
                                                               template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                               template (value) NR_PDSCH_CellLevelConfig_Type p_PdschCellLevelConfig
                                                               ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Common := omit,
            Downlink := {
              FrequencyInfoDL := omit,
              SSPbchBlock := omit,
              PdschCellLevelConfig := p_PdschCellLevelConfig,
              BWPs := omit,
              CsiConfig := omit
            },
            Uplink := omit
          }
        }
      }
    }
  };

  template (value) NR_PDSCH_CellLevelConfig_Type cs_NR_PDSCH_CellLevelConfigDef(template (value) PDSCH_ServingCellConfig p_ServingCellConfig) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    DMRS_TypeA_Position := omit,
    RateMatchPattern    := omit,
    ServingCellConfig   := { R15 := p_ServingCellConfig}
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_SearchSpaceDlDciAssignment_REQ(NR_CellId_Type    p_NR_CellId,
                                                                            template (value) TimingInfo_Type p_TimingInfo,
                                                                            template (omit) NR_SearchSpaceDlDciAssignment_Type p_NR_SearchSpaceDlDciAssignment,
                                                                            template (omit) boolean p_CnfFlag := omit,
                                                                            boolean p_FollowOnFlag := tsc_NoFollowOnFlag) :=
  { //@sic R5-206369: added p_FollowOnFlag sic@
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag, p_FollowOnFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := omit,
          CellConfigCommon := omit,
          PhysicalLayer := omit,
          BcchConfig :=omit,
          PcchConfig := omit,
          RachProcedureConfig := omit,
          DcchDtchConfig := {
            DL :={
                SearchSpaceAndDci := p_NR_SearchSpaceDlDciAssignment,
                CoresetPoolIndex := omit  //@sic R5w240003 sic@
          },
          UL :=omit,
          DrxCtrl := omit,
          MeasGapCtrl := omit,
          DL2         := omit,          //@sic R5w240003 sic@
          UL2         := omit           //@sic R5w240003 sic@
        },
          ServingCellConfig := omit,
          SidelinkScheduled := omit,                  //@sic R5w230215 sic@
          NtnConfig := omit                           //@sic R5w240105r1 sic@
        }
      }
    }
  };

  template (value) NR_ServingCellConfig_Type cs_NR_ServingCellConfig_SpCell(template (value) NR_SpCellConfig_Type p_NR_SpCellConfig) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SpCell := p_NR_SpCellConfig
  };

  template (value) NR_SpCellConfig_Type cs_NR_SS_SpCellConfig(template (omit) NR_ServingCellIndex_Type    p_NR_ServingCellIndex,
                                                              template (omit) CellGroupId                 p_CellGroupId,
                                                              template (omit) MAC_CellGroupConfig         p_MAC_CellGroupConfig,
                                                              template (omit) PhysicalCellGroupConfig     p_PhysicalCellGroupConfig,
                                                              template (omit) NR_MC_DCI_SetOfCells_Type   p_NR_MC_DCI_SetOfCells := omit,
                                                              template (omit) NR_CellId_Type p_ReferenceCell := omit
                                                               ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ServingCellIndex := p_NR_ServingCellIndex,
    CellGroupConfig := {
      CellGroupId := p_CellGroupId,
      SCellList   := {},
      MAC_CellGroupConfig := fl_NR_Set_SpCellConfigMAC_CellGroupConfig(p_MAC_CellGroupConfig),               //@sic R5s201518 sic@
      PhysicalCellGroupConfig := f_NR_Set_SpCellConfigPhysicalCellGroupConfig(p_PhysicalCellGroupConfig),   //@sic R5s201518 sic@
      ReferenceCell := p_ReferenceCell  //@sic R5w240308 sic@
    },
    MC_DCI_SetOfCells := p_NR_MC_DCI_SetOfCells //@sic R5w240308 sic@
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_ReleaseCell_REQ(NR_CellId_Type p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, tsc_NoCnfReq),
    Request := {
      Cell := {
        Release := true
      }
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_CellConfig_CNF(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      Cell := true
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_MacCommandTrigger_CNF(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      MacCommandTrigger := true
    }
  };

  template (value) NR_SSB_EPREs_Type cs_NR_SSB_EPREs_Def :=
  { // Acc to 38.508-1 Table 6.2.1.2-1: Power allocation for OFDM symbols and reference signals for signaling test cases
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    PbchToDmrs   := 0,
    PssToSss     := 0,
    SssToSsbBeam := 0,
    DmrsToSss    := 0
  };

  template (value) NR_CellConfigPhysicalLayerDownlink_Type cs_NR_CellConfigPhysicalLayerDownlink(NR_CellInfo_Type  p_NR_CellInfo) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FrequencyInfoDL := {
      R15 := p_NR_CellInfo.FrequencyBand.FrequencyInfoDL
    },
    SSPbchBlock := {
      SubCarrierSpacing := p_NR_CellInfo.FrequencyBand.SSB_SubcarrierSpacing,
      SubcarrierOffset := p_NR_CellInfo.FrequencyBand.Ssb_SubcarrierOffset,
      Periodicity := ms20,
      HalfFrameOffset := 0, /* @sic R5w190121, R5-195241 sic@ */
      BurstConfig := p_NR_CellInfo.PhysicalParameters.SSB_BurstConfig,
      RelativeTxPower := cs_NR_SSB_EPREs_Def
    },
    PdschCellLevelConfig := {
      DMRS_TypeA_Position := p_NR_CellInfo.Sysinfo.BcchInfo.MIB.message_.mib.dmrs_TypeA_Position,
      RateMatchPattern := {
        PatternList := omit,      // As per 38.508-1 Table 4.6.3-168: corresponds to ServingCellConfigCommon.rateMatchPatternToAddModList/rateMatchPatternToReleaseList;
        PatternListLteCrs := omit // As per 38.508-1 Table 4.6.3-168: ServingCellConfigCommon -  corresponds to ServingCellConfigCommon.lte-CRS-ToMatchAround
      },
      ServingCellConfig := {
        R15 := cs_38508_PDSCH_ServingCellConfig
      }
    },
    BWPs := {
      ActiveBWP := tsc_NR_BWP_Id,
      BwpArray := p_NR_CellInfo.PhysicalParameters.DL_BWPs,
      InitialBWP_RedCap := omit,
      BWP_SwitchIndicator := omit  //@sic R5w240304r1 sic@
    },
    CsiConfig := {
      None := true
    }
  };

  template (value) NR_CellConfigPhysicalLayerUplink_Type cs_NR_CellConfigPhysicalLayerUplink(NR_CellInfo_Type  p_NR_CellInfo) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Uplink := {
      Config := {
        FrequencyInfoUL := {
          R15 := p_NR_CellInfo.FrequencyBand.FrequencyInfoUL
        },
        BWPs := {
          ActiveBWP := { SameIdAsDL := true},
          BwpArray := p_NR_CellInfo.PhysicalParameters.UL_BWPs,
          InitialBWP_RedCap := omit,
          BWP_SwitchIndicator := omit  //@sic R5w240304r1 sic@
        },
        RACH_ConfigDedicated := f_ConvertRACH_ConfigDedicated(p_NR_CellInfo.PhysicalParameters.RACH_ConfigDedicated),  //@sic R5s190114 sic@
        SI_RequestConfig := omit
      }
    },
    SupplementaryUplink := omit,
    TimingAdvance :=  {
      InitialValue := 0 //As per 38.523-3 cl 7.1.5.2
    },
    PUSCH_ServingCellConfig := {
      R15 := cs_38508_PUSCH_ServingCellConfig
    },
    PUSCH_ServingCellConfigSUL := omit
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_CellConfig_Power_REQ(template (value) NR_CellAttenuationList_Type p_CellAttenuationList,
                                                                  template (value) TimingInfo_Type p_TimingInfo,
                                                                  NR_CellId_Type p_NR_CellId := nr_Cell_NonSpecific,
                                                                  template (omit) boolean p_CnfFlag := omit) :=
  { /* ASPs to modify cell power */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag),
    Request := {
      CellAttenuationList := p_CellAttenuationList
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_CellConfig_Power_CNF :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(nr_Cell_NonSpecific),
    Confirm := {
      CellAttenuationList := true
    }
  };

   template (value) NR_SYSTEM_CTRL_REQ cads_NR_RachProcedure_DcchDtchToCSS_Config_REQ(NR_CellId_Type  p_NR_CellId,
                                                                                      template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                                      template (omit) boolean p_CnfFlag := tsc_NoCnfReq,
                                                                                      template (omit) NR_RachProcedureConfig_Type p_RachProcedureConfig := omit,
                                                                                      template (omit) NR_SearchSpaceDlDciAssignment_Type p_NR_SearchSpaceDlDciAssignment := omit,
                                                                                      template (omit) NR_SearchSpaceUlDciAssignment_Type p_NR_SearchSpaceUlDciAssignment := omit
                                                                                      ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          RachProcedureConfig := p_RachProcedureConfig,//CSS +C-RNTI based
          DcchDtchConfig := {
            DL := {
                SearchSpaceAndDci := p_NR_SearchSpaceDlDciAssignment,
                CoresetPoolIndex := omit  //@sic R5w240003 sic@
                },
            UL := {
                SearchSpaceAndDci := p_NR_SearchSpaceUlDciAssignment,
                PUCCH_Synch := omit,
                GrantConfig := omit,
                CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            DrxCtrl := omit,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          }
        }
     }
    }
  };

  template (value) NR_UplinkTimeAlignment_AutoSynch_Type cs_NR_UplinkTimeAlignment_AutoSynch(NR_TimingAdvance_Period_Type p_TimingAdvance_Period := tsc_NR_TA_Period_Def) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    TimingAdvance  := tsc_NR_TA_Def,
    TA_Period      := p_TimingAdvance_Period               /* time period after which TA MAC control elements need to be automatically transmitted */
  };

  template (value) NR_UplinkTimeAlignment_Synch_Type cs_NR_UplinkTimeAlignment_Start(NR_TimingAdvance_Period_Type p_TimingAdvance_Period := tsc_NR_TA_Period_Def) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Auto  := cs_NR_UplinkTimeAlignment_AutoSynch(p_TimingAdvance_Period)
  };

  template (value) NR_UplinkTimeAlignment_Synch_Type cs_NR_UplinkTimeAlignment_Stop := { None  := true };       /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_ULGrantAllocation_REQ(NR_CellId_Type p_NR_CellId,
                                                                    template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                    template (omit)  NR_DciUlInfo_Type p_DciUlInfo := omit,
                                                                    template (omit)  NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch := omit,
                                                                    template (omit)  UL_GrantConfig_Type p_UL_GrantConfig := omit,
                                                                    template (omit)  NR_ServingCellConfig_Type p_NR_ServingCellConfig := omit,
                                                                    template (omit) boolean p_CnfFlag := omit
                                                                    ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s210263 added omit IEs DL, DrxCtrl and MeasGapCtrl sic@
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag),  //@sic R5s200161 sic@
    Request := {
      Cell := {
        AddOrReconfigure := {
          DcchDtchConfig := {
            DL := omit,
            UL := {
              SearchSpaceAndDci := {
                AssignedBWPs := omit,     // @sic R5s210378 sic@
                SearchSpaceType := omit,  // @sic R5s210378 sic@
                DciInfo := p_DciUlInfo
              },
              PUCCH_Synch := p_PUCCH_Synch,
              GrantConfig := p_UL_GrantConfig,
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            DrxCtrl     := omit,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          },
          ServingCellConfig := p_NR_ServingCellConfig
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_UplinkTimeAlignment_REQ(NR_CellId_Type p_NR_CellId,
                                                                     template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                     template (value) NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch) :=
   /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
   cads_NR_ULGrantAllocation_REQ(p_NR_CellId, p_TimingInfo, -, p_PUCCH_Synch);

  template (value) NR_RAR_SubPdu_Type cs_NR_RAR_SubPdu_RapIdAndPayload(template (value) RAR_RapIdCtrl_Type p_RapIdCtrl := cs_RapIdCtrl_Auto,
                                                                       template (value) NR_RACH_TimingAdvance_Type p_RACH_TimingAdvance,
                                                                       template (value) NR_RAR_UplinkGrant_Type p_UplinkGrant,
                                                                       template (value) NR_TempC_RNTI_Type p_TempC_RNTI) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RapIdAndPayload := {
      RapId := p_RapIdCtrl,
      Payload := {
        TimingAdvance := p_RACH_TimingAdvance,
        UplinkGrant := p_UplinkGrant,
        TempC_RNTI := p_TempC_RNTI
      }
    }
  };

  template (value) NR_RAR_MacPdu_Type cs_NR_RAR_MacPdu(template (value) NR_RAR_SubPduList_Type p_SubPduList,
                                                       boolean p_CrcError := false) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SubPduList := p_SubPduList,
    CrcError := p_CrcError
  };

  template (value) NR_RandomAccessResponseConfig_Type cs_NR_RandomAccessResponseConfig(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                       template (value) NR_RAR_SubPdu_Type p_SubPdu) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType1_Msg2(p_PhysicalParameters),
    MacPdu := cs_NR_RAR_MacPdu( {p_SubPdu} )
  };

  template (value) NR_ContentionResolutionCtrl_Type cs_NR_ContentionResolutionCtrl_None :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    None := true
  };

  template (value) NR_ContentionResolutionCtrl_Type cs_NR_ContentionResolutionCtrl_Msg4Based(template (value) NR_RachProcedureMsg4_Type p_RachProcedureMsg4) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Msg4_Based := p_RachProcedureMsg4
  };

  template (value) NR_ContentionResolutionCtrl_Type cs_NR_ContentionResolutionCtrl_CrntiBased(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                              template (value) NR_ResourceAllocation_Type p_ResourceAllocation,
                                                                                              integer p_FirstRbIndex := 0,
                                                                                              template (value) NR_AssignedBWPs_Type p_AssignedBWPs := cs_NR_AssignedBWPs_ActiveBWP,
                                                                                              template (value) NR_DciFormat_0_X_SpecificInfo_Type p_DciFormatAndParams := cs_NR_DciFormat_0_1_Params
                                                                                              ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s210885: added p_DciFormatAndParams sic@
    CRNTI_Based := cs_NR_SearchSpaceUlDciAssignment(p_PhysicalParameters, p_DciFormatAndParams, p_ResourceAllocation.Imcs, cs_NR_FreqDomainSchedulExplicit(p_FirstRbIndex, valueof(p_ResourceAllocation.Lrbs)), p_AssignedBWPs)
  };

  template (value) NR_RachProcedureMsg4RrcMsg_Type cs_NR_RachProcedureMsg4WithCcchMsg(octetstring p_RrcCcchMsg) := {RrcCcchMsg := p_RrcCcchMsg};   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RachProcedureMsg4RrcMsg_Type cs_NR_RachProcedureMsg4WithNoRrcMsg := {None := true};                                          /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_ContentionResolutionId_Type cs_NR_ContentionResolutionId_Unchanged := {XorMask := int2bit(0, 48)};                           /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RachProcedureMsg4_Type cs_NR_RachProcedureMsg4(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                     template (value) NR_ContentionResolutionId_Type p_ContentionResolutionId := cs_NR_ContentionResolutionId_Unchanged,
                                                                     template (value) NR_RachProcedureMsg4RrcMsg_Type p_RachProcedureMsg4,
                                                                     boolean p_CrcError := false,
                                                                     boolean p_IsSharedSpectrum := false) := //SharedSpectrum
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType1_Msg4(p_PhysicalParameters, p_IsSharedSpectrum),
    ContentionResolutionId := p_ContentionResolutionId,
    RrcPdu := p_RachProcedureMsg4,
    CrcError := p_CrcError
  };

  template (value) NR_RachProcedure_Type cs_NR_RachProcedure(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                             template (value) NR_ContentionResolutionCtrl_Type p_ContentionResolutionCtrl,
                                                             template (value) NR_TempC_RNTI_Type p_TempC_RNTI := tsc_NR_TempC_RNTI_SameAsC_RNTI,
                                                             integer p_TBS := 256,
                                                             boolean p_IsSharedSpectrum := false) :=  // SharedSpectrum condition
  { /* @sic R5s190024: p_TempC_RNTI sic@ */
    /* @sic R5-198994: p_TBS sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    MsgB := omit,           //@sic R5w230110 sic@
    RandomAccessResponse := cs_NR_RandomAccessResponseConfig(p_PhysicalParameters, cs_NR_RAR_SubPdu_RapIdAndPayload(-,
                                                                                                                    tsc_NR_RACH_TA_Def,    /* !!!! NR: to be retrieved from the cell's PhysicalParameters
                                                                                                                                              !!!! (i.e. NR_RACH_TimingAdvance_Type to be added to NR_PhysicalParameters_Type and
                                                                                                                                              !!!! initialised during cell initialisation) !!!! */
                                                                                                                    f_NR_RAR_UplinkGrant(p_PhysicalParameters.UL_BWPs[0],p_TBS, p_IsSharedSpectrum), // SharedSpectrum condition
                                                                                                                    p_TempC_RNTI)),
    Msg3Retansmission := omit,          //@sic R5w240004 sic@
    ContentionResolution := p_ContentionResolutionCtrl
  };

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_CFRA(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  { /* contention free random access procedure:
       - the UE gets triggered for CFRA by PDCCH order or RRC signalling e.g. for ENDC when SpCellConfig contains ReconfigurationWithSync with RACH-ConfigDedicated including CFRA parameters
       - as there is no contention resolution the RACH procedure ends with Msg2 (Random access response) */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RachProcedureList := {
      cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_None)
    }
  };

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_CBRA_CrntiBased(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                         template (value) NR_ResourceAllocation_Type p_NR_ResourceAllocation := cs_NR_ResourceAllocationMin,
                                                                                         RNTI_Value_Type p_TempC_RNTI_Value := tsc_C_RNTI_Value2,
                                                                                         integer p_Msg3_TBS := 256,
                                                                                         template (value) NR_AssignedBWPs_Type p_AssignedBWPs := cs_NR_AssignedBWPs_ActiveBWP,
                                                                                         template (value) NR_DciFormat_0_X_SpecificInfo_Type p_DciFormatAndParams := cs_NR_DciFormat_0_1_Params,
                                                                                         boolean p_IsSharedSpectrum := false) := // SharedSpectrum condition
  { /* contention based random access procedure with C-RNTI based contention resolution:
       - the UE sends Msg3 containing its C-RNTI but there is no RRC messages
       - Msg4 is an UL grant, there is no MAC PDU */
    /* @sic R5s190024: p_TempC_RNTI_Value sic@ */
    /* @sic R5-190787: p_NR_ResourceAllocation instead of p_TBS as minimum grant may be greater than 24 bits sic@ */
    /* @sic R5-198994: p_Msg3_TBS sic@ */
    //@sic R5s210885: added p_DciFormatAndParams sic@
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RachProcedureList := {
      cs_NR_RachProcedure(p_PhysicalParameters,
                          cs_NR_ContentionResolutionCtrl_CrntiBased(p_PhysicalParameters, p_NR_ResourceAllocation, -, p_AssignedBWPs, p_DciFormatAndParams),
                          cs_NR_TempC_RNTI_Explicit(p_TempC_RNTI_Value),
                          p_Msg3_TBS,
                          p_IsSharedSpectrum) // SharedSpectrum condition
    }
  };

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_CBRA_Msg4Based(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                        template (value) NR_RachProcedureMsg4RrcMsg_Type p_RachProcedureMsg4,
                                                                                        integer p_Msg3_TBS := 256,
                                                                                        boolean p_IsSharedSpectrum := false) := // SharedSpectrum condition
  { /* contention based random access procedure with contention resolution based on contention resolution id contained in Msg4:
       - the UE sends Msg3 containing an RRC request which is used as contention resolution id
       - Msg4 contains the contention resolution id and may contain the RRC response to Msg3
       - in case of "early contention resolution" Msg4 does not contain the RRC response which is sent in a separate DL transmission */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RachProcedureList := {
      cs_NR_RachProcedure(p_PhysicalParameters,
                          cs_NR_ContentionResolutionCtrl_Msg4Based(cs_NR_RachProcedureMsg4(p_PhysicalParameters, -, p_RachProcedureMsg4, -, p_IsSharedSpectrum)),  // SharedSpectrum condition - DCI
                          -,
                          p_Msg3_TBS,
                          p_IsSharedSpectrum) // SharedSpectrum condition - UL grant
    }
  };

  template (value) NR_AllOtherSiSchedul_Type cs_NR_SiSchedulList_Def(SI_SchedulingInfo.si_WindowLength p_SiWindowLength,           /* as in Sib1 */
                                                                     template (omit) NR_OtherSiSchedulList_Type p_SiSchedulList := omit,
                                                                     template (omit) NR_OtherSiSchedulList_Type p_SegmentedSiSchedulList := omit,
                                                                     template (omit) PosSiSchedulInfo_Type  p_PosSiSchedulInfo := omit
                                                                     ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s210361 sic@
    WindowLength := p_SiWindowLength,
    SiList := p_SiSchedulList,
    SegmentedSiList := p_SegmentedSiSchedulList,
    PosSiSchedulInfo := p_PosSiSchedulInfo    //@sic R5w220107 sic@
  };

  template (value) NR_MeasGapCtrl_Type cs_NR_MeasGapCtrl_None :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    None := true
  };

  template (value) NR_MeasGapCtrl_Type cs_NR_MeasGapCtrl_Config (template (value) MeasGapConfig p_MeasGapConfig) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      Config :=
      {
          R15 := p_MeasGapConfig
      }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_MeasGapCtrl_REQ(NR_CellId_Type    p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo,
                                                             template (omit) NR_MeasGapCtrl_Type p_MeasGapCtrl,
                                                             template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := omit,
          CellConfigCommon := omit,
          PhysicalLayer := omit,
          BcchConfig :=omit,
          PcchConfig := omit,
          RachProcedureConfig := omit,
          DcchDtchConfig := {
            DL :=omit,
            UL :=omit,
            DrxCtrl := omit,
            MeasGapCtrl := p_MeasGapCtrl,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          },
          ServingCellConfig := omit,
          SidelinkScheduled := omit,                  //@sic R5w230215 sic@
          NtnConfig := omit                           //@sic R5w240105r1 sic@
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_DrxCtrl_REQ(NR_CellId_Type    p_NR_CellId,
                                                         template (value) TimingInfo_Type p_TimingInfo,
                                                         template (omit) NR_DrxCtrl_Type p_DrxCtrl,
                                                         template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, p_TimingInfo, p_CnfFlag),
    Request := {
      Cell := {
        AddOrReconfigure := {
          StaticResourceConfig := omit,
          CellConfigCommon := omit,
          PhysicalLayer := omit,
          BcchConfig :=omit,
          PcchConfig := omit,
          RachProcedureConfig := omit,
          DcchDtchConfig := {
            DL :=omit,
            UL :=omit,
            DrxCtrl := p_DrxCtrl,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          },
          ServingCellConfig := omit,
          SidelinkScheduled := omit,                  //@sic R5w230215 sic@
          NtnConfig := omit                           //@sic R5w240105r1 sic@
        }
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_DeltaValuesTrigger_REQ(template (value) Band_SsbInfo_Type p_Band_SsbInfoPrimary,
                                                                    template (value) Band_SsbInfo_Type p_Band_SsbInfoSecondary ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(nr_Cell_NonSpecific, -, -, -, true),
    Request := {
        DeltaValues := {
            DeltaPrimary := p_Band_SsbInfoPrimary,
            DeltaSecondary := p_Band_SsbInfoSecondary
        }
    }
  };

  template (value) Band_SsbInfo_Type cs_Band_SsbInfo(FreqBandIndicatorNR           p_DeltaBand,
                                                    template (omit) NR_ASN1_ARFCN_ValueNR_Type  p_Ssb_NRf1 := omit,
                                                    template (omit) NR_ASN1_ARFCN_ValueNR_Type  p_Ssb_NRf2 := omit,
                                                    template (omit) NR_ASN1_ARFCN_ValueNR_Type  p_Ssb_NRf3 := omit,
                                                    template (omit) NR_ASN1_ARFCN_ValueNR_Type  p_Ssb_NRf4 := omit
                                                   ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    DeltaBand := p_DeltaBand,
    Ssb_NRf1 := p_Ssb_NRf1,
    Ssb_NRf2 := p_Ssb_NRf2,
    Ssb_NRf3 := p_Ssb_NRf3,
    Ssb_NRf4 := p_Ssb_NRf4
  };

  template (value) NR_ASN1_ARFCN_ValueNR_Type cs_NR_ASN1_ARFCN_ValueNR ( ARFCN_ValueNR p_ARFCN_ValueNR ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    R15 := p_ARFCN_ValueNR
  };

  template(present) NR_SYSTEM_CTRL_CNF car_NR_DeltaValuesTrigger_CNF :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(nr_Cell_NonSpecific),
    Confirm := {
        DeltaValues := ?
    }
  };

  /*
   * @desc      Function to convert the template of type NR_ASN1_RACH_ConfigDedicated_Type from the content of RACH_ConfigDedicated
   * @param     p_RACH_ConfigDedicated
   * @return    template (omit) NR_ASN1_RACH_ConfigDedicated_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_ConvertRACH_ConfigDedicated(template (omit) RACH_ConfigDedicated p_RACH_ConfigDedicated) return template (omit) NR_ASN1_RACH_ConfigDedicated_Type
  {
    var template (omit) NR_ASN1_RACH_ConfigDedicated_Type v_NR_ASN1_RACH_ConfigDedicated := omit;
    if (ispresent(p_RACH_ConfigDedicated)) {
      v_NR_ASN1_RACH_ConfigDedicated := {
        R15 := p_RACH_ConfigDedicated
      };
    }
    return v_NR_ASN1_RACH_ConfigDedicated;
  }

  /*
   * @desc      Set NR_ASN1_MAC_CellGroupConfig_Type with the given parameters MAC_CellGroupConfig
   * @param     p_MAC_CellGroupConfig
   * @return    template (omit) NR_ASN1_MAC_CellGroupConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_Set_SpCellConfigMAC_CellGroupConfig(template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig) return template (omit) NR_ASN1_MAC_CellGroupConfig_Type
  { //@sic R5s201518 sic@
    var template (omit) NR_ASN1_MAC_CellGroupConfig_Type v_MAC_CellGroupConfig := omit;

    if (isvalue (p_MAC_CellGroupConfig)) {
        v_MAC_CellGroupConfig := { R15 := p_MAC_CellGroupConfig};
    }
    return v_MAC_CellGroupConfig;
  }

  /*
   * @desc      Set NR_ASN1_PhysicalCellGroupConfig_Type with the given parameters PhysicalCellGroupConfig
   * @param     p_PhysicalCellGroupConfig
   * @return    template (omit) NR_ASN1_PhysicalCellGroupConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Set_SpCellConfigPhysicalCellGroupConfig(template (omit) PhysicalCellGroupConfig    p_PhysicalCellGroupConfig) return template (omit) NR_ASN1_PhysicalCellGroupConfig_Type
  { //@sic R5s201518 sic@
    var template (omit) NR_ASN1_PhysicalCellGroupConfig_Type v_PhysicalCellGroupConfig := omit;

    if (isvalue (p_PhysicalCellGroupConfig)) {
        v_PhysicalCellGroupConfig := { R15 := p_PhysicalCellGroupConfig};
    }
    return v_PhysicalCellGroupConfig;
  }

}
