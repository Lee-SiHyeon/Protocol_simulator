  //----------------------------------------------------------------------------
  testcase TC_10_1_1_1_NR5GC() runs on MTC_NR5GC system SYSTEM_NR5GC {
    // @purpose
    //   PDU session authentication and authorization / During the UE-requested PDU session procedure
    var NR5GC_PTC        v_NR5GC      := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_NR5GC := NR5GC_PTC.create("NR5GC") alive;
  
    f_MTC_ConnectPTCs_NR5GC(system, v_NR5GC, v_IMS1, v_IMS2);
  
    v_NR5GC.start(f_TC_10_1_1_1_NR5GC());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_NR5GC(t_GuardTimer);
  }
