module NEDC_CommonFrequencyFunctions {

  import from Common4G5G all;
  import from CommonDefs all;

  function f_NEDC_GetEUTRA_Band ( NEDC_BandCombination_Type p_NEDC_BandCombination_Type ) return integer
  {
  //@sic R5-221872 sic@
    var integer v_FreqBandIndicator;
    select ( p_NEDC_BandCombination_Type ){
      case ( DC_n28A_3A ){ v_FreqBandIndicator := 3 ;}
      case ( DC_n28A_39A ){ v_FreqBandIndicator := 39 ;}
      case else { FatalError (__FILE__, __LINE__, "Invalid band combination") }
    }
    return v_FreqBandIndicator;
  }

}
