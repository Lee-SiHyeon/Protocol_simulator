  template (value) DownlinkConfigCommonSIB cs_38508_DownlinkConfigCommonSIB(template (value) FrequencyInfoDL_SIB p_FrequencyInfoDL_SIB,
                                                                            template (value) BWP_DownlinkCommon p_BWP_DownlinkCommon,
                                                                            template (value) BCCH_Config p_BCCH_Config,
