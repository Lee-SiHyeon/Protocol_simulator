module UTRAN34_4C_ConfigurationSteps {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_4C_ASN1_ASP_Templates all;
  import from UTRAN34_ASN1_ASP_Templates all;
  import from UTRAN34_ASN1_ASP_Templates_r10 all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_Parameters all;
  import from UTRAN34_RAB_Functions all;
  import from UTRAN34_RAB_Templates_r10 all;
  import from UTRAN34_RRC_CommonTemplates_r10 all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_ASN1_ASP_RAB_Templates all;
  import from UTRAN_ASN1_ASP_RAB_Templates_r10 all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_ASN1_ASP_Templates_r10 all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_RAB_Functions all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_RAB_Templates_r10 all;
  import from UTRAN_RRC_RAB_Templates_r9 all;
  import from UTRAN_RRC_Templates all;
  import from UTRAN_RRC_Templates_r10 all;

  /*
   * @desc      Common step to configure RB25 in Flexible mode
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_Tw
   * @param     p_Rw
   * @status    APPROVED (UTRAN)
   */
  function f_SS_RB25_AM_Flexible_Cfg(UTRAN_CellId_Type p_CellId,
                                     template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                     template (value) TransmissionWindowSize p_Tw,
                                     template (value) ReceivingWindowSize p_Rw) runs on UTRAN_PTC
  {
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CRLC_Config(cas_RB25_AM_InfoFlexible_FDD(-, p_ActTime, -, cds_DL_AM_RLC_Flexible_r7(p_Rw), cds_UL_AM_RLC_Flexible(p_Tw)));
    }
    else {
      // TDD no 4C configuration
      FatalError (__FILE__, __LINE__, "TDD invalid cell configuration");
    }
  }

  /*
   * @desc      Configure the cell as a secondary DC cell
   * @param     p_CellId
   * @param     p_HSPA_Parameters   (default value: cs_HSPA_Parameters_Def)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_CreateSecondaryCell(UTRAN_CellId_Type p_CellId,
                                         template (value) UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters := cs_HSPA_Parameters_Def) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type_FDD v_CellInfoFDD := f_UTRAN_CellInfo_GetFDDSpecific(p_CellId);
    var UTRAN34_HSPA_Parameters_Type v_HSPA_Parameters := valueof(p_HSPA_Parameters);

    f_UTRAN_SS_CellCfg(p_CellId);
    // Setup pCPICH for FDD
    if (v_HSPA_Parameters.mimo) {
      // MIMO configured
      f_UTRAN_CPHY_RL_Setup(cas_PCPICH_Info_FDD(p_CellId, v_CellInfoFDD.powerpCPICH, antenna2sCPICH, true, false));
      f_UTRAN_CPHY_RL_Setup(cas_SCPICH_Info_MIMO(p_CellId, v_CellInfoFDD.powerpCPICH, v_HSPA_Parameters.s_CPICH_ChCode));    // s-CPICH
    } else {
      f_UTRAN_CPHY_RL_Setup(cas_PCPICH_Info_FDD(p_CellId, v_CellInfoFDD.powerpCPICH, -, true, false));    // p-CPICH including the Dc flag
    }
    f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_SecondaryDualCell_NoConn );
  }

  /*
   * @desc      Reconfigure SRBs from DL-DPCH to HS-PDSCH: release DL-DPCH and setup F-DPCH
   * @param     p_CellId
   * @param     p_HSPA_Parameters
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_DL_DPCH_ModifySRB_to_HS_DSCH_r10(UTRAN_CellId_Type p_CellId,
                                                 UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                 template (value) SS_ActivationTime p_ActTime := cs_ActivateNow) runs on UTRAN_PTC
  {
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated,
                                              tsc_DL_DPCH1,
                                              p_ActTime));
      
      f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellId,
                                                       tsc_DL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       p_ActTime));
      
      f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellId,
                                                tsc_DL_DPCH1,
                                                p_ActTime));
      
      //Setup F-DPCH (needed)
      f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDD_r10(p_CellId,
                                                          tsc_F_DPCH,
                                                          cs_DL_DPCHInfo_r10_Extension_FDD(cs_F_DPCH_Info_FDD_r10(p_HSPA_Parameters.dl_FDPCH_Code)),
                                                          p_ActTime));
    }
    else if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_TDD) {
      f_UTRAN_CMAC_Config(cas_MAC_TDD_Release(utran_CellDedicated,
                                              tsc_DL_DPCH1,
                                              p_ActTime));
      
      f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_TDD(p_CellId,
                                                       tsc_DL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       p_ActTime));
      
      f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_TDD(p_CellId,
                                                tsc_DL_DPCH1,
                                                p_ActTime));
      // No F-DPCH/DL-DPCH
    }
    else {
      FatalError(__FILE__, __LINE__, "Cell is neither FDD nor TDD");
    }
  }

  /*
   * @desc      Configure HS-PDSCH in serving + all secondary cells
   * @param     p_CellList
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_HSPA_Parameters
   * @param     p_Configuration_3C4C
   * @param     p_AddReconfReordQueueList
   * @status    APPROVED (UTRAN)
   */
  function f_SS_HS_DSCH_Config_4C(UTRAN_CellIdList_Type p_CellList,
                                  template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                  UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                  UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                  template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 p_AddReconfReordQueueList) runs on UTRAN_PTC
  {
    var integer i;
    var template (omit) HSDSCH_physical_layer_category_ext4   v_HSDSCH_physical_layer_category_ext4 := omit;
    var template (omit) HSDSCH_physical_layer_category_ext5   v_HSDSCH_physical_layer_category_ext5 := omit;
    var template (value) CmacConfigReq_r10OrLaterExtensionType v_CmacServingSecondaryCells;
    var template (value) DL_HSPDSCH_Information_r9 v_DL_HSPDSCH_Information;
    var template (value) EHS_DSCH_Flows_r9 v_EHS_DSCH_Flows := cs_HS_DSCHMacdFlows_r9(cs_HARQ_Info_FDD, p_AddReconfReordQueueList, p_HSPA_Parameters.mimo);


    // Set the category extension
    select (p_Configuration_3C4C) {
      case (C3_SingleBand, C3_SingleBand_Mimo, C3_DualBand, C3_DualBand_Mimo) {
        // Set the category extension
        v_HSDSCH_physical_layer_category_ext4 := pc_HSDSCH_UE_Category_Extension4_FDD;
        //Set serving and secondary cell list
        v_CmacServingSecondaryCells := cs_ServingSecondaryCells_3C(p_CellList[0], p_CellList[1], p_CellList[2]);
      }
      case (C4_DualBand, C4_DualBand_Mimo) {
        // Set the category extension
        v_HSDSCH_physical_layer_category_ext5 := pc_HSDSCH_UE_Category_Extension5_FDD;
        //Set serving and secondary cell list
        v_CmacServingSecondaryCells := cs_ServingSecondaryCells_4C (p_CellList[0], p_CellList[1], p_CellList[2], p_CellList[3]);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid 3C/4C configuration");
      }
    }
    
    // Setup CPHY-RL CPHY-TrCH  for HS-PDSCH in all cells
    for (i:=0; i<lengthof(p_CellList); i:=i+1) {
      v_DL_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD (p_HSPA_Parameters.hSPA_InfoPerCell[i].hS_SCCH_Info,  // value different for 64QAM
                                                                    cs_Measurement_Feedback_Info,
                                                                    f_UTRAN_ConvertBoolTo64QAM(p_HSPA_Parameters.hSPA_InfoPerCell[i].dl_64QAM), // dl 64QAM
                                                                    p_HSPA_Parameters.hSPA_InfoPerCell[i].hS_DSCH_TBSizeTable); // OctetAligned
      f_UTRAN_CPHY_RL_Setup(cas_RL_SetupInfo_FDD(p_CellList[i],
                                                 tsc_HSPDSCH,
                                                 cs_HS_PDSCHInfoExtension_FDD_r10OrLater(cs_DL_HS_DSCH_FDD_r10(omit,
                                                                                                               omit, // category when MAC-ehs is configured
                                                                                                               omit, // category when DC-HSDPA is configured
                                                                                                               omit, // category when DC-HSDPA+MIMO is configured
                                                                                                               v_HSDSCH_physical_layer_category_ext4, // 2 secondary cell
                                                                                                               v_HSDSCH_physical_layer_category_ext5,  // 3 secondary cell
                                                                                                               v_DL_HSPDSCH_Information,
                                                                                                               p_HSPA_Parameters.mimo_Parameters_r9)),  //MIMO
                                                 p_ActTime));
      
      // Setup CPHY-TrCH in all cells
      f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellList[i],
                                                   tsc_HSPDSCH,
                                                   cs_TrChConfigTypeNonDCH,
                                                   cs_CphyTrchConfigReq_Common_FDD_r9(p_ActTime,
                                                                                      omit, // CphyUlConnectedTrCHList_Type
                                                                                      omit, // UlTfcs
                                                                                      omit, // DlconnectedTrCHList  dlconnectedTrCHList
                                                                                      omit, // DL TFCS
                                                                                      omit, // HS_DSCHMACdFlows
                                                                                      omit, // E_DCHMACdFlows
                                                                                      v_EHS_DSCH_Flows)));
    }
    
    // To configure MAC_eHS in Explicit TFRC config mode
    // MAC configure on cellDedicated
    f_UTRAN_CMAC_MACHs_Config(utran_CellDedicated,
                              cas_CMAC_MAChs_TFRC_ExplicitConfigReq_r10(utran_CellDedicated,
                                                                        p_HSPA_Parameters.TFRCconfigure_ExtList[0], //@sic R5-145142 sic@: TFRCconfigure_r10 renamed and changed to a list
                                                                        p_ActTime,
                                                                        p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_DSCH_TBSizeTable)); //@sic R5s140782 sic@
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD_r10(utran_CellDedicated,
                                                 tsc_HSPDSCH,
                                                 cs_UE_Info,
                                                 cs_TrCHInfo_Common_FDD_r9(omit, // UlconnectedTrCHList
                                                                           omit, // UlTfcs
                                                                           omit, // DlconnectedTrCHList,
                                                                           omit, // DlTfcs,
                                                                           omit, // HsDSCHMacdFlows := omit,
                                                                           v_EHS_DSCH_Flows),
                                                 cs_TrLogMappingDL_MAC_eHS_DC,  //Queue id =0 @sic R5s140782 sic@
                                                 v_CmacServingSecondaryCells));
  }

  /*
   * @desc      Modification of SRBs from UL-DPCH to E-DCH (13.6 -> E-DCH)
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_Configuration_3C4C
   * @status    APPROVED (UTRAN)
   */
  function f_SS_UL_DPCH_ModifySRB_to_E_DCH_r10(UTRAN_CellId_Type                   p_CellId,
                                               template (value) SS_ActivationTime  p_ActTime := cs_ActivateNow,
                                               UTRAN34_3C4C_Configuration_Type     p_Configuration_3C4C) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramblingCode;
    var template (value) HS_DPCCHInfo_r10 v_HS_DPCCH := cs_HS_DPCCHInfo_r10_3C;
    var template (value) DPCHInfo_r10OrLaterExtensionType_FDD v_UL_DPCHInfo;
    
    if ((p_Configuration_3C4C==C4_DualBand) or (p_Configuration_3C4C==C4_DualBand_Mimo)) {
      v_HS_DPCCH.thirdSecondaryServing_HS_DSCH_Cell := activated;
    }
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
      v_UL_DPCHInfo := cs_UL_DPCHInfo_r10_Extension_FDD(cs_UL_DPCH_OnlyHS_PDSCH_FDD(v_UL_ScramblingCode), v_HS_DPCCH);
      
      f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_UL_DPCH1, p_ActTime));
      f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellId, tsc_UL_DPCH1, cs_TrChConfigTypeDCH_NoSHO, p_ActTime));
      f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_FDD(p_CellId, tsc_UL_DPCH1, cs_DPCHInfo_Extension_FDD(v_UL_DPCHInfo), p_ActTime, false));
    }
    else {// TDD no 4C configuration
      FatalError (__FILE__, __LINE__, "TDD invalid cell configuration");
    }
  }

  /*
   * @desc      Modification of SRBs on UL-DPCH (13.6 -> 3.4)
   *            for configurations with HSDPA and SRBs mapped to UL DPCH
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_HSPA_Parameters
   * @status    APPROVED (UTRAN)
   */
  function f_SS_UL_DPCH_ModifySRB_13_6_To_3_4(UTRAN_CellId_Type p_CellId,
                                              template (value) SS_ActivationTime p_ActTime,
                                              template (value) UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    
    f_UTRAN_CPHY_RL_Modify(cas_108_DL_DPCH_ModifyInfo_r10(p_CellId,
                                                          tsc_UL_DPCH1,
                                                          cs_UL_DPCHInfo_r10_Extension_FDD(cs_UL_DPCH_InfoACK_NACK_FDD(tsc_UL_DPDCH_SF_SRB,
                                                                                                                       pl1,
                                                                                                                       v_UL_ScramCodeFDD,
                                                                                                                       p_HSPA_Parameters.deltaACK,
                                                                                                                       p_HSPA_Parameters.deltaNACK,
                                                                                                                       p_HSPA_Parameters.ack_NACK_repetition_factor)),
                                                          p_ActTime,
                                                          false));
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_UL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 cs_CphyTrchConfigReq_UL_TrCh_FDD(p_ActTime,
                                                                                  {cs_CphyUlConnectedTrCH_FDD_DCH(tsc_UL_DCH5, cs_DCH_148_TFS_FDD)},
                                                                                  cs_TFCS_Cmpl0_1_Rx)));
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1,
                                                  cs_UE_Info,
                                                  cs_TrCHInfo_UL_TrCh_FDD({cs_UlConnectedTrCH(tsc_UL_DCH5, cs_DCH_148_TFS_FDD)},
                                                                          cs_TFCS_Cmpl0_1_Rx),
                                                  cs_TrLogMappingUL_4DCCH,
                                                  p_ActTime));
  }

  /*
   * @desc      Modification of SRBs on UL-DPCH (13.6 -> 3.4) and addition of RAB on UL-DPCH
   *            for configurations with RAB and SRBs mapped to UL DPCH (same as UL configuration for cell_DCH_64kps_RAB).
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_HSPA_Parameters
   * @param     p_HS_DPCCHInfo      (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_UL_DPCH_ModifyRAB_SRB_13_6_To_3_4(UTRAN_CellId_Type  p_CellId,
                                                  template (value) SS_ActivationTime  p_ActTime,
                                                  template (value) UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                  template (omit)  HS_DPCCHInfo_r10 p_HS_DPCCHInfo := omit) runs on UTRAN_PTC //@sic R5s140782 sic@
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
    
    f_UTRAN_CPHY_RL_Modify(cas_108_DL_DPCH_ModifyInfo_r10(p_CellId,
                                                          tsc_UL_DPCH1,
                                                          cs_UL_DPCHInfo_r10_Extension_FDD(cs_UL_DPCH_InfoACK_NACK_FDD(tsc_UL_DPDCH_SF_64k_PS,
                                                                                                                       pl0_96,
                                                                                                                       v_UL_ScramCodeFDD,
                                                                                                                       p_HSPA_Parameters.deltaACK,
                                                                                                                       p_HSPA_Parameters.deltaNACK,
                                                                                                                       p_HSPA_Parameters.ack_NACK_repetition_factor),
                                                                                           p_HS_DPCCHInfo),//@sic R5s140782 sic@
                                                          p_ActTime,
                                                          false));
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_UL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 cs_CphyTrchConfigReq_UL_TrCh_FDD(p_ActTime,
                                                                                  cs_DCH_336_148_UL_Info_FDD,
                                                                                  cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx)));
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1,
                                                  cs_UE_Info,
                                                  cs_TrCHInfo_UL_TrCh_FDD(cs_TrChInfoTrCHListUL_336_148_FDD,
                                                                          cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                                                  cs_TrLogMappingUL_4DCCH_1DTCH(tsc_RB25),
                                                  p_ActTime));
  }

  /*
   * @desc      to modify physical channel DPCH1 and connect DCH5  to the physical channel,
   *            then map DCCH1-4 on to the DCH5 transport channel
   * @param     p_CellId
   * @param     p_SS_ActTime
   * @param     p_SecondaryScramblingCode
   * @status    APPROVED (UTRAN)
   */
  function f_SS_DCH_ModifyToSRB136_FDD_r10(UTRAN_CellId_Type                p_CellId,
                                           template (value) SS_ActivationTime      p_SS_ActTime,
                                           template (omit) SecondaryScramblingCode  p_SecondaryScramblingCode) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellId);
    var template (value) DL_DPCHInfo_r10_FDD v_DL_DPCHInfo_r10_FDD := cs_DL_DPCH_FDD_r10(cs_DL_CommonInfoDCH_SRB_FDD_r10(tsc_DL_DPCH1_SFP_SRB,
                                                                                                                        fixed,
                                                                                                                        false,
                                                                                                                        cs_DL_DPCH_CfnHandling_Maintain_r6, omit), //@sic R5s140782 sic@
                                                                                        tsc_DL_DPCH1_ChC_SRB,
                                                                                        p_SecondaryScramblingCode);
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_FDD(p_CellId,
                                                      tsc_DL_DPCH1,
                                                      cs_DPCHInfo_Extension_FDD(cs_DL_DPCHInfo_r10_Extension_FDD(v_DL_DPCHInfo_r10_FDD,
                                                                                                                 omit)), // HS_DPCCHInfo_r10
                                                      
                                                      p_SS_ActTime));
    f_UTRAN_CPHY_TrCH_Config (cas_TrChCfgInfo_FDD(p_CellId,
                                                  tsc_DL_DPCH1,
                                                  cs_TrChConfigTypeDCH_NoSHO,
                                                  cs_CphyTrchConfigReq_DL_TrCh_FDD(p_SS_ActTime,
                                                                                   {cs_CphyDlConnectedTrCH_FDD_DCH(tsc_DL_DCH5, cs_DCH_148_TTI_10_TFS_FDD)},//@sic R5s140782 sic@
                                                                                   cs_TFCS_Cmpl0_1_Tx_FDD(cs_PowerOffsetInfoBelow64k))));
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1, //@sic R5s140782 sic@
                                                  cs_UE_Info,
                                                  cs_TrChInfoDL_13_6_StandAlone_FDD,
                                                  cs_TrLogMappingDL_4DCCH,
                                                  p_SS_ActTime));
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_FDD(p_CellId,
                                                      tsc_UL_DPCH1,
                                                      cs_DPCHInfo_UL_FDD (cs_UL_DPCH_13_6_StandAlone_FDD(v_UL_ScramCodeFDD), omit),
                                                      p_SS_ActTime));
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_DL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 cs_CphyTrchConfigReq_UL_TrCh_FDD(p_SS_ActTime,
                                                                                  {cs_CphyUlConnectedTrCH_FDD_DCH(tsc_UL_DCH5, cs_DCH_148_TTI_10_TFS_FDD)},
                                                                                  cs_TFCS_Cmpl0_1_Rx)));
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1,
                                                  cs_UE_Info,
                                                  cs_TrChInfoUL_13_6_StandAlone_FDD,
                                                  cs_TrLogMappingUL_4DCCH,
                                                  p_SS_ActTime));
  }

  /*
   * @desc      To configure 3C/4C in the cells acc to configurations A33/A34/A35/A36 in 34.108
   *            and 3C/4C RAB test cases acc to cell_DCH_HS_DSCH
   *            Configure SRBs on DCH/E-DCH
   *            Shall be called when RRC CONNECTIOn SETUP is configured with A1 (SRBs mapped on DCH/DCH)
   * @param     p_CellList
   * @param     p_Configuration_3C4C
   * @param     p_HSPA_Parameters
   * @param     p_RB_PrimaryCellConfiguration (default value: cell_E_HS)
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_LoopbackRLC_PDU   (default value: false)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_Configure_4C(UTRAN_CellIdList_Type p_CellList,
                                  UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                  UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                  RB_ConfigType p_RB_PrimaryCellConfiguration := cell_E_HS,
                                  template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                  boolean p_LoopbackRLC_PDU := false) runs on UTRAN_PTC
  {
    var template (value) DPCHInfo_r10OrLaterExtensionType_FDD v_DL_DPCHInfo;
    var template (value) TFCS v_TFCS;
    var template (value) CphyTrchConfigReq v_CphyTrchConfigReq;
    var template (value) TrCHInfo v_DL_TrCHInfo;
    var template (value) TrCH_LogCHMappingList1 v_DL_TrLogMapping;
    var template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 v_AddReconfReordQueueList;

    // DOWNLINK
    select (p_RB_PrimaryCellConfiguration) {
      case (cell_DCH_E_HS, cell_DCH_dlSRB_E_HS, cell_DCH_HS_DSCH) {
        // DL SRBs mapped on DL-DPCH
        // Modification of SRBs (DL DPCH 13.6 -> 3.4 on DL-DPCH)
        v_DL_DPCHInfo := cs_DL_DPCHInfo_r10_Extension_FDD(cs_DL_DPCH_FDD_r10(cs_DL_CommonInformationRB_SetUp_FDD_r10(tsc_DL_DPCH1_SFP_SRB_3_4k, fixed, false), //@sic R5s140782 sic@
                                                                             p_HSPA_Parameters.dl_DPCH_SFC,
                                                                             omit)); // SecondaryScramblingCode
        v_TFCS := cs_TFCS_Cmpl0_1_Tx_FDD(cs_PowerOffsetInfoBelow64k);
        v_CphyTrchConfigReq := cs_CphyTrchConfigReq_DL_TrCh_FDD(p_ActTime, cs_DCH_148_DL_FDD, v_TFCS);
        v_DL_TrCHInfo := cs_TrCHInfo_DL_TrCh_FDD(cs_TrChInfoTrCHListDL_34_StandAlone_FDD, v_TFCS);
        v_DL_TrLogMapping := cs_TrLogMappingDL_4DCCH;
        f_SS_ConfigPS_DL_DPCH1_FDD(p_CellList[0],
                                   cs_DPCHInfo_Extension_FDD(v_DL_DPCHInfo),
                                   v_CphyTrchConfigReq,
                                   v_DL_TrCHInfo,
                                   v_DL_TrLogMapping,
                                   p_ActTime);
        // Setup HS-PDSCH in serving cell + secondary cells
        v_AddReconfReordQueueList := cs_SS_MAC_ehs_AddReconfReordQueue_1Q(tsc_MACehs_Queue0_DTCH, 0);
      }
      case (cell_E_HS) {
        // DL SRBs mapped on HS-DSCH
        // Release DL-DPCH and configure F-DPCH
        f_SS_DL_DPCH_ModifySRB_to_HS_DSCH_r10(p_CellList[0],
                                              p_HSPA_Parameters,
                                              p_ActTime);
        // Setup HS-PDSCH in serving cell + secondary cells
        v_AddReconfReordQueueList := cs_SS_MAC_ehs_AddReconfReordQueue_2Q (tsc_MACehs_Queue0_DTCH, 0, tsc_MACehs_Queue1_DCCH, 0);
      }
      case else {
        FatalError(__FILE__, __LINE__, "SS Configuration not handled");
      }
    }
    f_SS_HS_DSCH_Config_4C(p_CellList, p_ActTime, p_HSPA_Parameters, p_Configuration_3C4C, v_AddReconfReordQueueList);
    
    // UPLINK
    select (p_RB_PrimaryCellConfiguration) {
      case (cell_DCH_E_HS) {
        // UL SRBs mapped on UL-DPCH
        // Modify UL-DPCH to 3.4 kbps on UL-DPCH
        f_SS_UL_DPCH_ModifySRB_13_6_To_3_4(p_CellList[0],
                                           p_ActTime,
                                           p_HSPA_Parameters);
        //Configure E-DCH and MACi/is
        f_SS_E_DCH_ConfigCommonMACi(p_CellList[0], p_ActTime, cs_E_DCHMACdFlows_FDD_DTCH, cs_LCH_MappingList_DTCH);
      }
      case (cell_E_HS, cell_DCH_dlSRB_E_HS) {
        // UL SRBs mapped on E-DCH
        // Modification of SRBs at SS (13.6 -> E-DCH)
        f_SS_UL_DPCH_ModifySRB_to_E_DCH_r10(p_CellList[0], p_ActTime, p_Configuration_3C4C);
        //Configure E-DCH and MACi/is
        f_SS_E_DCH_ConfigCommonMACi(p_CellList[0], p_ActTime, cs_E_DCHMACdFlows_FDD_Def, cs_LCH_MappingList_DCCH_DTCH);
      }
      case (cell_DCH_HS_DSCH) {
        // UL SRBs and RAB mapped on UL-DPCH
        // Modify UL-DPCH to 3.4 kbps on UL-DPCH, add RAB
        f_SS_UL_DPCH_ModifyRAB_SRB_13_6_To_3_4(p_CellList[0],
                                               p_ActTime,
                                               p_HSPA_Parameters,
                                               cs_HS_DPCCHInfo_r10_3C); //@sic R5s140782 sic@
      }
      case else {
        FatalError(__FILE__, __LINE__, "SS Configuration not handled");
      }
    }
    
    // Setup RAB 25 entity
    f_SS_RB25_AM_Flexible_Cfg(p_CellList[0], p_ActTime, p_HSPA_Parameters.transmissionWindowSize, p_HSPA_Parameters.receivingWindowSize);
    
    // Configure PDCP when there is no loopback of RLC PDU
    if (not(p_LoopbackRLC_PDU)) {
      f_SS_RB_ConfigurePDCP(p_CellList[0], tsc_RB25);
    }
    
    // Set SS configuration
    f_UTRAN_CellInfo_SetConfigType(p_CellList[0], p_RB_PrimaryCellConfiguration);
    select (p_RB_PrimaryCellConfiguration) {
      case (cell_DCH_dlSRB_E_HS, cell_DCH_E_HS, cell_DCH_HS_DSCH) {
        f_UTRAN_CellInfo_SetConfigType(p_CellList[1], cell_SecondaryDualCell_RAB);
        f_UTRAN_CellInfo_SetConfigType(p_CellList[2], cell_SecondaryDualCell_RAB);
        if ((p_Configuration_3C4C == C4_DualBand) or (p_Configuration_3C4C== C4_DualBand_Mimo)) {
          f_UTRAN_CellInfo_SetConfigType(p_CellList[3], cell_SecondaryDualCell_RAB);
        }
      }
      case (cell_E_HS) {
        f_UTRAN_CellInfo_SetConfigType(p_CellList[1], cell_SecondaryDualCell_SRB);
        f_UTRAN_CellInfo_SetConfigType(p_CellList[2], cell_SecondaryDualCell_SRB);
        if ((p_Configuration_3C4C == C4_DualBand) or (p_Configuration_3C4C== C4_DualBand_Mimo)) {
          f_UTRAN_CellInfo_SetConfigType(p_CellList[3], cell_SecondaryDualCell_SRB);
        }
      }
      case else {FatalError(__FILE__, __LINE__, "SS Configuration not handled");}
    }
  }

}
