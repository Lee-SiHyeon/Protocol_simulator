module SOR_CMCI_NR5GC_IMS {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_NR5GC_Functions all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.3.2.2.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_3_2_2_NR5GC_IMS1()runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_DATA_REQ v_IMS_DATA_REQ_ByRef; //@sic R5-251356 sic@
    var boolean v_ReceivedByeOrReceivedDereg := false; //@sic R5-251356 sic@
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo; //@sic R5-251356 sic@
    var template (present) MessageHeader v_MessageHeader_Bye;  //@sic R5s250116 sic@

    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    //@siclog "Steps 30a1 - 30a4" siclog@
    //FFS : Prose CR needed
    v_InviteRequestWithSdp := f_IMS_NR5GC_MOSpeechCall();
    v_MessageHeader_Bye := f_IMS_ByeRequest_MessageHeaderRX(v_InviteRequestWithSdp.Invite, NORMAL_CALL, -, false); //@sic R5s250116 sic@

    //@siclog "Step 38Db1 - 38Db2" siclog@
    //Before the UE De-registers on NR PTC, it will release the voice call abd perform IMS deregistration
    alt { //@sic R5-251356 sic@
        [not v_ReceivedByeOrReceivedDereg] a_IMS_ReceiveBye(v_IMS_DATA_REQ_ByRef, -, f_SIP_BuildSipUri_RX(px_IMS_CalleeContactUri),v_MessageHeader_Bye)
          {
            v_RoutingInfo := f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ_ByRef.RoutingInfo);
            IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo, cs_Response(c_statusLine200, f_IMS_OtherResponse_200_MessageHeaderTX(v_IMS_DATA_REQ_ByRef.Request.Bye.msgHeader))));
            IPCAN.send(cms_IMS_IPCAN_Trigger("200OK sent"));
            repeat;
          }
        [] IPCAN.receive(cmr_IMS_IPCAN_Trigger ("Received Deregistration"))
        {
            v_ReceivedByeOrReceivedDereg := true;
        }
     }

    f_IMS_GlobalRelease(); //Since the UE has De-registered, the IMS needs to be reset

    //FFS : Prose CR needed
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
     
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.3.2.6.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_3_2_6_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndRelease();
   }

}
