module MCX_XML_mcpttPresInfoFA {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttPresInfoFA_1_0 language "XSD" all;   

  type urn_3gpp_ns_mcpttPresInfoFA_1_0.FunctionalAlias MCPTT_FunctionalAlias_Type;              /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttPresInfoFA_1_0.StatusType      MCPTT_FunctionalAlias_Status_Type;       /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttPresInfoFA_1_0.P_id_fa         MCPTT_P_id_fa_Type;                      /* @status    APPROVED (MCX) */

  template (present) MCPTT_FunctionalAlias_Type cr_MCPTT_FunctionalAlias(XSD.AnyURI p_FunctionalAliasID := px_MCPTT_ID_FA_A) :=
  { /* FunctionalAlias according to 36.579-1 Table 5.5.3.5.1-1
       (see NOTEs for cs_MCPTT_FunctionalAlias)
       @status    APPROVED (MCX) */
    expires := omit,
    functionalAliasID := p_FunctionalAliasID,
    status := omit,
    user := omit,
    attr := omit,
    elem_list := {}
  };

  template (value) MCPTT_FunctionalAlias_Type cs_MCPTT_FunctionalAlias(XSD.AnyURI p_FunctionalAliasID := px_MCPTT_ID_FA_A,
                                                                       MCPTT_FunctionalAlias_Status_Type p_Status := activated) :=
  { /* FunctionalAlias according to 36.579-1 Table 5.5.3.5.2-1
       NOTEs:
       According to 24.379 clause 9A in general there can be per-user functional alias information or per-functional alias status information,
       but the exchange of information between the the client and the MCPTT server serving the MCPTT user is per-user
       => the entries in the PIDF document are the functional aliases assigned to the user and the user attribute is not present
       @status    APPROVED (MCX) */
    expires := omit,
    functionalAliasID := p_FunctionalAliasID,
    status := p_Status,
    user := omit,
    attr := omit,
    elem_list := {}
  };

  /*
   * @desc      encode MCPTT FunctionalAlias
   * @param     p_FunctionalAlias
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_FunctionalAlias_Encode(template (value) urn_3gpp_ns_mcpttPresInfoFA_1_0.FunctionalAlias p_FunctionalAlias) return XSD.String
  {
    var bitstring v_EncodedFunctionalAlias := encvalue(p_FunctionalAlias);
    return f_Bit2XmlBody(v_EncodedFunctionalAlias);
  }

  /*
   * @desc      Encrypt and encode MCPTT FunctionalAlias
   * @param     p_FunctionalAlias
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_FunctionalAlias_EncryptEncode(template (value) MCPTT_FunctionalAlias_Type p_FunctionalAlias,
                                                 charstring p_MCServiceID,
                                                 template (omit) MCX_SecurityKey_Type p_CSK) return XSD.String
  {
    var template (value) MCPTT_FunctionalAlias_Type v_FunctionalAlias := p_FunctionalAlias;

    v_FunctionalAlias.functionalAliasID := f_MCX_XML_EncryptOptionalAttributeUri(v_FunctionalAlias.functionalAliasID, p_MCServiceID, p_CSK);

    return fl_MCPTT_FunctionalAlias_Encode(v_FunctionalAlias);
  }

  /*
   * @desc      Encode MCPTT P-Id
   * @param     p_P_id_fa
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_FunctionalAlias_P_id_fa_Encode(template (value) urn_3gpp_ns_mcpttPresInfoFA_1_0.P_id_fa p_P_id_fa) return XSD.String
  {
    var bitstring v_EncodedP_id_fa := encvalue(p_P_id_fa);
    return f_Bit2XsdString(v_EncodedP_id_fa);
  }

  /*
   * @desc      Decrypt FunctionalAlias
   * @param     p_FunctionalAlias
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    template (value) MCPTT_FunctionalAlias_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_FunctionalAlias_Decrypt(MCPTT_FunctionalAlias_Type p_FunctionalAlias,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK) return template (value) MCPTT_FunctionalAlias_Type
  {
    var template (value) MCPTT_FunctionalAlias_Type v_FunctionalAlias := p_FunctionalAlias;

    v_FunctionalAlias.functionalAliasID := f_MCX_XML_DecryptOptionalAttributeUri(v_FunctionalAlias.functionalAliasID, p_MCServiceID, p_CSK);

    return v_FunctionalAlias;
  }

}
