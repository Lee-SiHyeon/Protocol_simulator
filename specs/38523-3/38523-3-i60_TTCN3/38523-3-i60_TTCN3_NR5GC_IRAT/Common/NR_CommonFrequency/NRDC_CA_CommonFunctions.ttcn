module NRDC_CA_CommonFunctions {

  import from Common4G5G all;
  import from CommonDefs all;

  function f_NR_GetNRDC_CA_PrimaryBand ( NR_DC_CA_BandCombination_Type p_NRDC_CA_BandCombination ) return integer
  {
    var integer v_PrimaryBandIndicatorNR ;
    select (p_NRDC_CA_BandCombination) {
      case( DC_n1A_n258G ) { v_PrimaryBandIndicatorNR := 1 ;} //@sic {R5-206307, R5-221873, R5-223650} sic@
      case( DC_n77A_n261G ) { v_PrimaryBandIndicatorNR := 77 ;}
      case( DC_n78A_n257G ) { v_PrimaryBandIndicatorNR := 78 ;}
      case( DC_n78A_n258G ) { v_PrimaryBandIndicatorNR := 78 ;}
      case( DC_n79A_n257G ) { v_PrimaryBandIndicatorNR := 79 ;}
      case else { FatalError (__FILE__, __LINE__, "Invalid NR CA band combination")}
    }
    return v_PrimaryBandIndicatorNR;
  }

}
