module Unstructured_SS {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"}; 
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_RRC_CommonFunctions all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  type record of charstring USSD_List;   /* @status    APPROVED (SSNITZ) */

  const USSD_List tsc_USSD_1591 := {     /* @status    APPROVED (SSNITZ) */
    "*60#",
    "*201*35#",
    "*70*635*562#",
    "#60#",
    "#201*35#",
    "#70*635*562#",
    "*#60#",
    "*#201*35#",
    "*#70*635*562#",
    "**60#",
    "**201*35#",
    "**70*635*562#",
    "##60#",
    "##201*35#",
    "##70*635*562#",
    "7",
    "36"}; //@sic R5-153199 sic@

  const integer tsc_ErrorCode_SystemFailure := 34;          /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_DataMissing := 35;            /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_UnknownAlphabet := 71;        /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_UnexpectedDataValue := 36;    /* @status    APPROVED (SSNITZ) */

  const GeneralProblem tsc_GeneralProblem_UnrecognizedComponent := 0;    /* @status    APPROVED (SSNITZ) */

  const GeneralProblem tsc_GeneralProblem_MistypedComponent := 1;        /* @status    APPROVED (SSNITZ) */

  const GeneralProblem tsc_GeneralProblem_BadlyStructuredComponent := 2; /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_Reject_GeneralProblem(InvokeIdType p_InvokeId,
                                                   GeneralProblem p_GeneralProblem) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := {
      derivable := p_InvokeId
    },
    problem := {
      generalProblem := p_GeneralProblem
    }
  };

  template (value) Reject cs_RejectInvokeProblem_UnrecognizedOperation(InvokeIdType p_InvokeId) := cs_Reject_InvokeProblem(p_InvokeId, tsc_InvokeProblem_UnrecognizedOperation);          /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_RejectInvokeProblem_MistypedParameter(InvokeIdType p_InvokeId) := cs_Reject_InvokeProblem(p_InvokeId, tsc_InvokeProblem_MistypedParameter);                  /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_RejectGeneralProblem_UnrecognizedComponent(InvokeIdType p_InvokeId) := cs_Reject_GeneralProblem(p_InvokeId, tsc_GeneralProblem_UnrecognizedComponent);       /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_RejectGeneralProblem_MistypedComponent(InvokeIdType p_InvokeId) := cs_Reject_GeneralProblem(p_InvokeId, tsc_GeneralProblem_MistypedComponent);               /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_RejectGeneralProblem_BadlyStructuredComponent(InvokeIdType p_InvokeId) := cs_Reject_GeneralProblem(p_InvokeId, tsc_GeneralProblem_BadlyStructuredComponent); /* @status    APPROVED (SSNITZ) */

  template (value) Components cs_ComponentList_15_9_2(InvokeIdType p_InvokeId) :=
  { /* @status    APPROVED (SSNITZ) */
    // @sic R5s150605 sic@
    cs_ReturnError (cs_ReturnErrorCode(p_InvokeId, tsc_ErrorCode_SystemFailure)),
    cs_ReturnError (cs_ReturnErrorCode(p_InvokeId, tsc_ErrorCode_DataMissing)),
    cs_ReturnError (cs_ReturnErrorCode(p_InvokeId, tsc_ErrorCode_UnknownAlphabet)),
    cs_ReturnError (cs_ReturnErrorCode(p_InvokeId, tsc_ErrorCode_UnexpectedDataValue)),
    cs_ReturnReject (cs_RejectGeneralProblem_UnrecognizedComponent(p_InvokeId)),
    cs_ReturnReject (cs_RejectGeneralProblem_MistypedComponent(p_InvokeId)),
    cs_ReturnReject (cs_RejectGeneralProblem_BadlyStructuredComponent(p_InvokeId)),
    cs_ReturnReject (cs_RejectInvokeProblem_MistypedParameter(p_InvokeId)),
    cs_ReturnReject (cs_Reject_InitiatingRelease(p_InvokeId)),
    cs_ReturnReject (cs_RejectInvokeProblem_MistypedParameter(p_InvokeId))
  };

  template (present) ReturnResult cr_ReturnResultProcessUnstructuredSS_Data (InvokeIdType p_InvokeId,
                                                                 SS_UserData p_SS_UserData) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
    operationCode :=  {
      local := tsc_OperationCode_ProcessUnstructuredSS_Data
    },
    parameter := {
      processUnstructuredSS_Data := p_SS_UserData
    }}
  };

  template (present) SETUPul cdr_SetupMO_CalledNumber(octetstring p_Number)
    modifies cr_SetupMO_Common :=
  { /* @status    APPROVED (SSNITZ) */
    cdpn := cr_CDPN(p_Number)
  };

  template (present) RRCDataIndType cr_U_SetupMOCall_CalledNumber(octetstring p_Number) :=
  { /* @status    APPROVED (SSNITZ) */
    setupul := cdr_SetupMO_CalledNumber(p_Number)
  };

  template (value) USSD_Arg cs_USSD_Arg (template (value) USSD_DataCodingScheme p_USSD_DataCodingScheme,
                                         template (value) USSD_String p_USSD_String,
                                         template (omit) AlertingPattern p_AlertingPattern := omit,
                                         template (omit) ISDN_AddressString p_ISDN_AddressString := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    ussd_DataCodingScheme   := p_USSD_DataCodingScheme,
    ussd_String             := p_USSD_String,
    alertingPattern         := p_AlertingPattern,
    msisdn                  := p_ISDN_AddressString
  };

  template (present) USSD_Res cr_USSD_Res(template (present) USSD_DataCodingScheme p_USSD_DataCodingScheme,
                                          template (present) USSD_String p_USSD_String) :=
  { /* @status    APPROVED (SSNITZ) */
    ussd_DataCodingScheme   := p_USSD_DataCodingScheme,
    ussd_String             := p_USSD_String
  };

  template (value) Invoke cs_UnstructuredSS_RequestDef(InvokeIdType p_InvokeId := tsc_InvokeId,
                                                       template (value) USSD_Arg p_USSD_Arg) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_UnstructuredSS_Request
    },
    parameter := {
      unstructuredSS_Request := p_USSD_Arg
    }
  };

  template (value) Invoke cs_UnstructuredSS_NotifyDef (InvokeIdType p_InvokeId := tsc_InvokeId,
                                                       template (value) USSD_Arg p_USSD_Arg) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_UnstructuredSS_Notify
    },
    parameter := {
      unstructuredSS_Notify := p_USSD_Arg
    }
  };

  template (present) ReturnResult cr_ReturnResult_Empty(template (present) InvokeIdType p_InvokeId) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := omit
  };

  template (present) Component cr_ReturnError(template (present) ReturnError p_ReturnError) :=
  { /* @status    APPROVED (SSNITZ) */
    returnError := p_ReturnError
  };

  template (present) ReturnResult cr_ReturnResult_UnstructuredSS_RequestDef(template (present) InvokeIdType p_InvokeId := ?,
                                                                            template (present) USSD_Res p_USSD_Res) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_UnstructuredSS_Request
      },
      parameter := {
        unstructuredSS_Request := p_USSD_Res
      }
    }
  };

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_1_UTRAN() runs on UTRAN_PTC
  { /* ProcessUnstructuredSS-request/accepted */
    
    var octetstring v_EncodedComponents;
    var octetstring v_Octetstring;
    var InvokeIdType v_InvokeId := 0;
    var Components v_Components;
    var TI v_TI_S;
    var TI v_TI;
    var RRC_DATA_IND v_RRC_DataInd;
    var integer i;
    var integer v_Numloop := 16; // results in 0-16, 17 loops
    var template (present) USSD_Arg v_USSD_Arg;
    var template (value) USSD_Res v_USSD_Res;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    for (i:=0; i <= v_Numloop; i:=i+1) {
      
      // @siclog "Step 1" siclog@
      //UE is triggered to initiate the unstructured SS data operation
      f_UT_SupplementaryService_SendUSSD( UT, tsc_USSD_1591[i]);
      f_UTRAN34_RRC_ConnEst(utran34_Cell1, originatingHighPrioritySignalling); // @sic R5-145082 sic@
      
      // @siclog "Step 2" siclog@
      // Receive CM Service Request
      U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CMServReq_SSDef(?)));
      // @siclog "Step 3 - 4" siclog@
      f_UTRAN_MM_Authentication();
      
      // @siclog "Step 5 " siclog@
      f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
      
      
      // @siclog "Step 6" siclog@
      //Register with unstructured SS
      // Receive REGISTER message
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                            cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
      
      v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
      v_Components := f_SS_ComponentsDecode(v_Octetstring);
      v_USSD_Arg := cr_USSD_Arg('0F'O, f_CharPacking_IA5toGsm7Bit(tsc_USSD_1591[i], USSD_Packing));
      if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Request(?, v_USSD_Arg))))) {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
      }
      
      // Get invokeID sent by the UE, to be used in SS response
      v_InvokeId := v_Components[0].invoke.invokeID;
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
      
      // @siclog "Step 7" siclog@
      // Send RELEASE COMPLETE message
      v_USSD_Res := cs_USSD_Res('0F'O,f_CharPacking_IA5toGsm7Bit(tsc_USSD_1591[v_Numloop-i], USSD_Packing));
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultProcessUnstructuredSS_Request(v_InvokeId, v_USSD_Res))));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
      
      // @siclog "Step 8" siclog@
      // The SS releases the RRC connection
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      //@siclog "Step 9" siclog@
      //It is checked that the ussd string is displayed by the UE using appropriate user action.
      if (f_UT_ChkResponseDisplayed(UT, tsc_USSD_1591[v_Numloop-i])) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 9");
      }
      //@siclog "Step 10" siclog@
      //Void
      
      //@siclog "Step 11- 22" siclog@
      v_TI:= f_UTRAN34_GoToState6_9_MO(utran34_Cell1);
      // @siclog "Step 23" siclog@
      //UE is triggered to initiate the unstructured SS data operation
      f_UT_SupplementaryService_SendUSSD( UT, tsc_USSD_1591[i]);
      
      // @siclog "Step 24" siclog@
      // Receive CM Service Request
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_CMServReq_SSDef(?)));
      // @siclog "Step 25" siclog@
      //  Send CM Service Accept
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_CM_ServAcc)); // @sic R5s150603 sic@
      // @siclog "Step 26" siclog@
      //Register with unstructured SS
      // Receive REGISTER message
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                            cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
      
      v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
      v_Components := f_SS_ComponentsDecode(v_Octetstring);
      v_USSD_Arg := cr_USSD_Arg('0F'O, f_CharPacking_IA5toGsm7Bit(tsc_USSD_1591[i], USSD_Packing));
      if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Request(?, v_USSD_Arg))))) {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
      }
      
      // Get invokeID sent by the UE, to be used in SS response
      v_InvokeId := v_Components[0].invoke.invokeID;
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
      
      // @siclog "Step 27" siclog@
      // Send RELEASE COMPLETE message
      v_USSD_Res := cs_USSD_Res('0F'O, f_CharPacking_IA5toGsm7Bit(tsc_USSD_1591[v_Numloop-i], USSD_Packing));
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultProcessUnstructuredSS_Request(v_InvokeId, v_USSD_Res))));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
      
      // @siclog "Step 28 void" siclog@
      //@siclog "Step 29" siclog@
      //It is checked that the ussd string is displayed by the UE using appropriate user action.
      
      if (f_UT_ChkResponseDisplayed(UT, tsc_USSD_1591[v_Numloop-i])) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 29 "& tsc_USSD_1591[v_Numloop-i]); // @sic R5s160835 sic@
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 29" & tsc_USSD_1591[v_Numloop-i]); // @sic R5s160835 sic@
      }
      
      //@siclog "step 30-32 siclog@
      //Send Disconnect, receive Release, send Release complete
      f_UTRAN_CC_Disconnect(cs_TI_MO(v_TI.tiVal));  // @sic R5s150603, R5s160835 sic@
      // @siclog "Step 33" siclog@
      // The SS releases the RRC connection
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    } // End of loop
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_2_UTRAN() runs on UTRAN_PTC
  { /* ProcessUnstructuredSS-request/cross phase compatibility and error handling */
    
    var octetstring v_EncodedComponents;
    var octetstring v_Octetstring;
    var InvokeIdType v_InvokeId := 0;
    var Components v_Components;
    var template (value) Components v_ComponentsTemplate;
    var template (value) Component v_Component;
    var TI v_TI_S;
    var TI v_TI;
    var RRC_DATA_IND v_RRC_DataInd;
    var integer k;
    var integer v_Numloop := 9; // results in 0-9, 10 loops
    var charstring v_USSD_String := "*70*635*562#";
    var template (present) USSD_Arg v_USSD_Arg;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    //UE is triggered to initiate the unstructured SS data operation
    f_UT_SupplementaryService_SendUSSD(UT, v_USSD_String);

    // @siclog "Step 2" siclog@
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, originatingHighPrioritySignalling); //@sic R5-145083 sic@
    
    // @siclog "Step 3" siclog@
    // Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SSDef(?)));
    // @siclog "Step 3A - 3B" siclog@
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 4 " siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    // @siclog "Step 5" siclog@
    //Register with unstructured SS
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    v_USSD_Arg := cr_USSD_Arg('0F'O, f_CharPacking_IA5toGsm7Bit(v_USSD_String, USSD_Packing));
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Request(?, v_USSD_Arg))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
    
    // @siclog "Step 6" siclog@
    // Send RELEASE COMPLETE message
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_RejectInvokeProblem_UnrecognizedOperation(v_InvokeId))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // @siclog "Step 7" siclog@
    // The SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // @siclog "Step 8" siclog@
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, originatingHighPrioritySignalling); //@sic R5-145083 sic@
    
    // @siclog "Step 9" siclog@
    // Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SSDef(?)));
    // @siclog "Step 10 " siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, false, cs_domain);
    // @siclog "Step 11" siclog@
    //Register with unstructured SS
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          omit))) -> value v_RRC_DataInd; // @sic R5s150605 sic@
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Data(?, v_USSD_String))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
    
    // @siclog "Step 12" siclog@
    // Send RELEASE COMPLETE message
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cr_ReturnResultProcessUnstructuredSS_Data(v_InvokeId, v_USSD_String))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // @siclog "Step 13" siclog@
    // The SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    //@siclog "Step 14" siclog@
    //It is checked that the ussd string is displayed by the UE using appropriate user action.
    if (f_UT_ChkResponseDisplayed(UT, v_USSD_String)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
    }
    
    // @siclog "Step 15" siclog@
    //UE is triggered to initiate the unstructured SS data operation
    f_UT_SupplementaryService_SendUSSD(UT, v_USSD_String);
    
    // @siclog "Step 16" siclog@
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, originatingHighPrioritySignalling); //@sic R5-145083 sic@
    
    // @siclog "Step 17" siclog@
    // Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SSDef(?)));
    // @siclog "Step 18 " siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, false, cs_domain);
    // @siclog "Step 19" siclog@
    //Register with unstructured SS
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    v_USSD_Arg := cr_USSD_Arg('0F'O, f_CharPacking_IA5toGsm7Bit(v_USSD_String, USSD_Packing));
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Request(?, v_USSD_Arg))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
    
    // @siclog "Step 20" siclog@
    // Send RELEASE COMPLETE message
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete(v_TI_S, tsc_PD_SS, cs_SS_Cau('0011101'B)))); // facility rejected
    
    // @siclog "Step 21" siclog@
    // The SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // @siclog "Step 22" siclog@
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, originatingHighPrioritySignalling); //@sic R5-145083 sic@
    
    // @siclog "Step 23" siclog@
    // Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SSDef(?)));
    // @siclog "Step 24 " siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, false, cs_domain);
    // @siclog "Step 25" siclog@
    //Register with unstructured SS
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          omit))) -> value v_RRC_DataInd;  // @sic R5s150605 sic@
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Data(?, v_USSD_String))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
    
    // @siclog "Step 26" siclog@
    // Send RELEASE COMPLETE message
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cr_ReturnResultProcessUnstructuredSS_Data(v_InvokeId, v_USSD_String))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // @siclog "Step 27" siclog@
    // The SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    //@siclog "Step 28" siclog@
    //It is checked that the ussd string is displayed by the UE using appropriate user action.
    if (f_UT_ChkResponseDisplayed(UT, v_USSD_String)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 28");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 28");
    }
    
    //@siclog "Step 29" siclog@
    for (k:=0; k <= v_Numloop; k:=k+1) {
      
      //@siclog "Step 30" siclog@
      v_TI:= f_UTRAN34_GoToState6_9_MO(utran34_Cell1);
      
      // @siclog "Step 31" siclog@
      //UE is triggered to initiate the unstructured SS data operation
      f_UT_SupplementaryService_SendUSSD(UT, v_USSD_String);
      
      // @siclog "Step 32" siclog@
      // Receive CM Service Request
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_CMServReq_SSDef(?)));

      // @siclog "Step 33" siclog@
      //@sic R5s150780 sic@
      //  Started Integrity Protection
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_CM_ServAcc)); // @sic R5s170329 sic@


      // @siclog "Step 34" siclog@
      //Register with unstructured SS
      // Receive REGISTER message
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                            cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
      
      v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
      v_Components := f_SS_ComponentsDecode(v_Octetstring);
      v_USSD_Arg := cr_USSD_Arg('0F'O, f_CharPacking_IA5toGsm7Bit(v_USSD_String, USSD_Packing));
      if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_ProcessUnstructuredSS_Request(?, v_USSD_Arg))))) {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
      }
      
      // Get invokeID sent by the UE, to be used in SS response
      v_InvokeId := v_Components[0].invoke.invokeID;
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
      
      // @siclog "Step 35" siclog@
      // Send RELEASE COMPLETE message
      v_ComponentsTemplate := cs_ComponentList_15_9_2 (v_InvokeId); // get next one in list @sic R5s150605 sic@
      v_Component := v_ComponentsTemplate [k]; // get next one in list @sic R5s150605 sic@
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components (v_Component));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents))));
      
      //@siclog "step 36-38 siclog@
      //Send Disconnect, receive Release, send Release complete
      f_UTRAN_CC_Disconnect(cs_TI_MO(v_TI.tiVal));  // @sic R5s150605, R5s160835 sic@
      // @siclog "Step 39" siclog@
      // The SS releases the RRC connection
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Loop Num: "& int2str(v_Numloop)); // @sic R5s160835 sic@
    } // End of loop
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.3
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_3_UTRAN() runs on UTRAN_PTC
  { /* UnstructuredSS-Notify/accepted  */
    
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S := cs_TI_MT;
    var TI v_Ti_R;
    var template (value) TI v_Ti_S_Call := cs_TI_MT('001'B);
    var octetstring v_EncodedComponents;
    var Components v_FacilityReturnResult;
    var charstring v_MessageSent := "Test15.9.3";
    var template (value) USSD_Arg v_USSD_Arg;
    var template (value) TI v_Ti_S2 := v_Ti_S;
    v_Ti_S2.tiVal := int2bit(bit2int(valueof(v_Ti_S.tiVal)) + 1, 3);
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Mobile terminated establishment of Radio Resource Connection
    // See 3GPP TS34.108. The IE "Paging cause" in the PAGING TYPE 1 message is set to "Terminating Low Priority Signalling".
    // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Terminating Low Priority Signalling"
    f_UTRAN_PageCS(utran34_Cell1, terminatingLowPrioritySignalling, oct2bit(px_TMSI_Def));
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, terminatingLowPrioritySignalling);
    
    // @siclog "Step 2" siclog@
    // Receive PAGING RESPONSE
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, ?)));
    // @siclog "Steps 3-4" siclog@
    // Authentication Request/Response
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 5" siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain); // @sic R5s150607 sic@
    //The SS starts integrity protection
    
    // @siclog "Step 6" siclog@
    // Send Register: Initiation of the transaction concerning the USSD notification operation
    v_USSD_Arg :=  cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_NotifyDef( tsc_InvokeId,  // @sic R5s150607 sic@
                                                                                                              v_USSD_Arg))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));  // @sic R5s150607 sic@
    
    // Set TI value for response to be sent from the UE from Register
    v_Ti_R := f_NAS_TI_InitAndSetFlag(v_Ti_S, '1'B); // @sic R5s150607 sic@
    
     // @sic R5s150607 sic@
    // Wait for the NAS message first as the UT port is not in the default behaviour, so this will not cause a failure if we check it later
    // @siclog "Step 8" siclog@
    // Receive FACILITY: the UE shall send a FACILITY message with an empty return result
    U_Dc.receive (car_UplinkDirectTransfer (utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_Facility (v_Ti_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    // @siclog "Step 7 Void" siclog@
        
    v_FacilityReturnResult := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityReturnResult, cr_Components(cr_ReturnResult(cr_ReturnResult_Empty(tsc_InvokeId))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8: the UE shall send a FACILITY message with an empty return result");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    }
    // @siclog "Step 8a" siclog@
    //@sic R5-153704 sic@
    // The UE shall display the USSD string sent from the network
    if (f_UT_ChkResponseDisplayed(UT, v_MessageSent)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8a");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8a");
    }
    // @siclog "Step 9" siclog@
    // Send SETUP: Incoming call
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_SetupMTCall_SS(cs_BcapSpeechMT, v_Ti_S_Call, -, cs_Signal('00000111'B))));
    
    // @siclog "Step 10" siclog@
    // Receive CALL CONFIRMED
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CallConfirmed(?)));
    
    // @siclog "Step 11" siclog@
    // Receive ALERTING message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Alerting(?)));
  
    // @siclog "Step 11A" siclog@
    f_UT_AnswerCall (UT); // @sic R5-153966 sic@
                                          
    
    //@siclog "Step 11a" siclog@
    //@sic R5-153966 sic@
    f_UT_AnswerCall(UT);

    // @siclog "Step 12" siclog@
    // Receive CONNECT
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Connect(?)));
    
    // @siclog "Step 13" siclog@
    // Send CONNECT Ack
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ConnectAck(v_Ti_S_Call)));
    
    // @siclog "Step 14" siclog@
    // RELEASE COMPLETE: This message releases the transaction concerning the USSD operation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                            tsc_RB3,
                            cs_U_ReleaseComplete (v_Ti_S, tsc_PD_SS)));  // @sic R5s150607 sic@
                            
    // @siclog "Step 15" siclog@
    // Send Register: Initiation of a USS request operation during a call
    v_USSD_Arg := cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_NotifyDef( tsc_InvokeId, // @sic R5s150607 sic@
                                                                                                              v_USSD_Arg))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S2, cs_FacilityIE_tlv(v_EncodedComponents))));  // @sic R5s150607 sic@

    // Set TI value for response to be sent from the UE
    v_Ti_R := f_NAS_TI_InitAndSetFlag(v_Ti_S2, '1'B); // @sic R5s150607 sic@
    
     // @sic R5s150607 sic@
    // Wait for the NAS message first as the UT port is not in the default behaviour, so this will not cause a failure if we check it later
    // @siclog "Step 17" siclog@
    // Receive FACILITY with an empty return result
    U_Dc.receive (car_UplinkDirectTransfer (utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_Facility (v_Ti_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityReturnResult := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    // @siclog "Step 16 Void" siclog@
    
    
    if (not match(v_FacilityReturnResult, cr_Components(cr_ReturnResult(cr_ReturnResult_Empty(tsc_InvokeId))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 17: the UE shall send a FACILITY message with an empty return result");
    } else  {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 17");
    }
    // @siclog "Step 17a" siclog@
    //@sic R5-153704 sic@
    // The UE has to display the USSD string received from the SS
    if (f_UT_ChkResponseDisplayed(UT, v_MessageSent)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 17a");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 17a");
    }
    // @siclog "Step 18" siclog@
    // RELEASE COMPLETE: It releases the transaction identifier of the USSD operation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                            tsc_RB3,
                            cs_U_ReleaseComplete (v_Ti_S2, tsc_PD_SS)));

    // @siclog "Step 19-21" siclog@
    f_UTRAN_CC_Disconnect(v_Ti_S_Call); // @sic R5s150607 sic@
    
    // @siclog "Step 22" siclog@
    // SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble(utran34_Cell1, U1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.4
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_4_UTRAN() runs on UTRAN_PTC
  { /* UnstructuredSS-Notify/rejected on user busy  */
    
    const InvokeIdType tsc_InvokeId_2 := 111;
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S := cs_TI_MT;
    var template (value) TI v_Ti_S2 := cs_TI_MT('001'B);
    var TI v_Ti_R;
    var TI v_Ti_R2;
    var octetstring v_EncodedComponents;
    var Components v_FacilityReturnResult;
    var Components v_Components;
    var charstring v_MessageSent := "Test15.9.4";
    var template (value) USSD_Arg v_USSD_Arg;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Mobile identity = TMSI-1; Paging order is for CS services; Paging cause = "terminatingLowPrioritySignalling"
    f_UTRAN_PageCS(utran34_Cell1, terminatingLowPrioritySignalling, oct2bit(px_TMSI_Def));
    
    // @siclog "Step 2" siclog@
    // SS checks that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Terminating Low Priority Signalling".
    f_UTRAN34_RRC_ConnEst (utran34_Cell1, terminatingLowPrioritySignalling);
    
    // @siclog "Step 3" siclog@
    // Receive PAGING RESPONSE: service type = "paging response"
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cs_MobileIdTMSI(omit, px_TMSI_Def))));
    
    // @siclog "Steps 3A - 3B" siclog@
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 4" siclog@
    //The SS starts integrity protection
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain); // @sic R5s150609 sic@

    // @siclog "Step 5" siclog@
    // Send Register: Initiation of the transaction concerning the USSD notification operation
    v_USSD_Arg := cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_NotifyDef(tsc_InvokeId, // @sic R5s150609 sic@
                                                                                                              v_USSD_Arg))));

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents)))); // @sic R5s150609 sic@
    
    // Set TI value for response to be sent from the UE
    v_Ti_R := f_NAS_TI_InitAndSetFlag(v_Ti_S, '1'B); // @sic R5s150609 sic@
    
    // @sic R5s150609 sic@
    // Wait for NAS message first as UT port not in default behaviour, so this can wait
    // @siclog "Step 7" siclog@
    // Receive FACILITY: Signalling message sent by the UE as the response
    U_Dc.receive (car_UplinkDirectTransfer (utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_Facility (v_Ti_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    // @siclog "Step 7a" siclog@
    // Checks that the ussd-string sent by the SS is correctly displayed by the UE
    if (f_UT_ChkResponseDisplayed(UT, v_MessageSent)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7a");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7a");
    }
    
    v_FacilityReturnResult := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityReturnResult, cr_Components(cr_ReturnResult(cr_ReturnResult_Empty(tsc_InvokeId))))) {  // @sic R5s150609 sic@
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7: Components do not match to template");
    }
    
    // @siclog "Step 8" siclog@
    // Send Register: Initiation of an USS request operation during a call
    v_USSD_Arg := cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_NotifyDef(tsc_InvokeId_2, v_USSD_Arg))));
    
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S2, cs_FacilityIE_tlv(v_EncodedComponents)))); // @sic R5s150609 sic@
    // Set TI value for response
    v_Ti_R2 := f_NAS_TI_InitAndSetFlag(v_Ti_S2, '1'B); // @sic R5s150609 sic@
    
    // @siclog "Step 9" siclog@
    // RELEASE COMPLETE: Return error set to "USSD busy". Transaction initiated in step 7 by the network is rejected by the UE.
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_R2, cr_FacilityIE_tlv))) -> value v_RRC_DataInd;
    v_Components := f_SS_ComponentsDecode(v_RRC_DataInd.msg.releaseComplete.facility.components); // @sic R5s140989, R5s150609 sic@
    // Cause #72 check - "USSD busy"
    if (not match(v_Components, cr_Components(cr_ReturnError(cr_ReturnErrorCode(tsc_InvokeId_2, tsc_ErrorCode_USSD_Busy))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 9: Components do not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    }
    
    // @siclog "Step 10" siclog@
    //RELEASE COMPLETE: normal release of transaction initiated in step 5
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseComplete (v_Ti_S)));
    
    // @siclog "Step 11" siclog@
    // SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble(utran34_Cell1, U1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.5
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_5_UTRAN() runs on UTRAN_PTC
  { /* UnstructuredSS-Request/accepted  */
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S := cs_TI_MT;
    var template (value) TI v_Ti_S_Call := cs_TI_MT('001'B);
    var TI v_Ti_R;
    var octetstring v_EncodedComponents;
    var Components v_FacilityReturnResult;
    var charstring v_MessageSent := "Test15.9.5";
    var template (value) USSD_Arg v_USSD_Arg;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Mobile identity = TMSI-1; Paging order is for CS services; Paging cause = "terminatingLowPrioritySignalling"
    f_UTRAN_PageCS(utran34_Cell1, terminatingLowPrioritySignalling, oct2bit(px_TMSI_Def));
    
    // @siclog "Step 2" siclog@
    // SS checks that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Terminating Low Priority Signalling".
    f_UTRAN34_RRC_ConnEst (utran34_Cell1, terminatingLowPrioritySignalling);
    
    // @siclog "Step 3" siclog@
    // Receive PAGING RESPONSE: service type = "paging response"
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cs_MobileIdTMSI(omit, px_TMSI_Def))));
    
    // @siclog "Steps 3A - 3B" siclog@
    f_UTRAN_MM_Authentication();

    // @siclog "Step 4" siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain); //@sic R5s160637 sic@
    //The SS starts integrity protection
    
    // @siclog "Step 5" siclog@
    // Send Register: Initiation of the transaction concerning the USSD notification operation
    v_USSD_Arg := cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_RequestDef(-,
                                                                                                               v_USSD_Arg))));
    
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));  // @sic R5s150607 sic@
    
    // Set TI value for response to be sent from the UE
    v_Ti_R := f_NAS_TI_InitAndSetFlag(v_Ti_S, '1'B);//@sic R5s160637 sic@
    
    // @siclog "Step 6" siclog@
    // The UE has to display the USSD string received from the SS
    // Trigger UE to answer using appropriate MMI/AT commands
    if (f_UT_ChkResponseDisplayed(UT, v_MessageSent)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
    
    f_UT_SupplementaryService_SendUSSD (UT, v_MessageSent, NO_CNF_REQUIRED);
    
    // @siclog "Step 7" siclog@
    // Receive FACILITY: Signalling message sent by the UE as the response
    U_Dc.receive (car_UplinkDirectTransfer(utran_CellDedicated,
                                           tsc_RB3,
                                           cr_U_Facility (v_Ti_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityReturnResult := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    
    if (not match(v_FacilityReturnResult, cr_Components(cr_ReturnResult(cr_ReturnResult_UnstructuredSS_RequestDef(tsc_InvokeId,
                                                                                                                  cr_USSD_Res('0F'O,
                                                                                                                              f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing))))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7: Components do not match to template");
    }
    else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    }
    
    // @siclog "Step 8" siclog@
    // Send SETUP: Incoming call
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_SetupMTCall_SS(cs_BcapSpeechMT, v_Ti_S_Call, -, cs_Signal('00000111'B))));
    
    // @siclog "Step 9" siclog@
    // Receive CALL CONFIRMED
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CallConfirmed(?)));
 
    // @siclog "Step 10" siclog@
    // Receive ALERTING message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Alerting(?)));
   //@sic R5s160637 sic@
   f_UT_AnswerCall (UT);
    
   // @siclog "Step 11" siclog@
    // Receive CONNECT
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Connect(?)));
    // @siclog "Step 12" siclog@
    // Send CONNECT Ack
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ConnectAck(v_Ti_S_Call)));
    
    // @siclog "Step 13" siclog@
    //Send RELEASE COMPLETE: This message releases the transaction concerning the USSD operation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete (v_Ti_S, tsc_PD_SS)));
    
    // @siclog "Step 14" siclog@
    // Send Register: Initiation of a USS request operation during a call
    v_USSD_Arg := cs_USSD_Arg ('0F'O, f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing));
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_UnstructuredSS_RequestDef(-,
                                                                                                               v_USSD_Arg))));
    
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));  // @sic R5s150607 sic@

    // @siclog "Step 15" siclog@
    // Check that the MS displays the USSD string received from the SS
    // Trigger UE to answer using appropriate MMI/AT commands
    if (f_UT_ChkResponseDisplayed(UT, v_MessageSent)) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 15");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 15");
    }
    f_UT_SupplementaryService_SendUSSD (UT, v_MessageSent, NO_CNF_REQUIRED);
    
    // @siclog "Step 16" siclog@
    // Receive FACILITY: Return Result
    U_Dc.receive (car_UplinkDirectTransfer(utran_CellDedicated,
                                           tsc_RB3,
                                           cr_U_Facility (v_Ti_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityReturnResult := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    
    if (not match(v_FacilityReturnResult, cr_Components(cr_ReturnResult(cr_ReturnResult_UnstructuredSS_RequestDef(tsc_InvokeId,
                                                                                                                  cr_USSD_Res('0F'O,
                                                                                                                              f_CharPacking_IA5toGsm7Bit(v_MessageSent, USSD_Packing))))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 16: Components do not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    }
    
    // @siclog "Step 17" siclog@
    // Send RELEASE COMPLETE: It releases the transaction identifier of the USSD operation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete (v_Ti_S, tsc_PD_SS)));
    
    // @siclog "Step 18-20" siclog@
    // Disconnect - Release - Release Complete
    f_UTRAN_CC_Disconnect(v_Ti_S_Call);//@sic R5s160637 sic@
    
    // @siclog "Step 21" siclog@
    // SS releases the RRC connection
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble(utran34_Cell1, U1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.9.6
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_9_6_UTRAN() runs on UTRAN_PTC
  { /* MMI input for USSD */
    var TI v_TI_S;
    var RRC_DATA_IND v_RRC_DataInd;
    var integer k;
    var charstring v_CallingNumber;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    // The UE has a valid TMSI (=TMSI1) and CKSN (=CKSN1). It is "idle updated" on cell A.
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    //The following sequence is executed for execution counter k = 1 to 10
    for (k:=10; k<20; k:=k+1){
      
      // @siclog "Step 1" siclog@
      // The MS is made to initiate call establishment for phone number 1X (where X = k-1)
      v_CallingNumber := int2str(k); // @sic R5s141097 sic@
      f_UT_RequestCSCall(UT, v_CallingNumber);
      
      // @siclog "Step 2" siclog@
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating Conversational Call"
      f_UTRAN34_RRC_ConnEst (utran34_Cell1, originatingConversationalCall);
      
      // @siclog "Step 3" siclog@
      //CM SERVICE REQUEST with - "Mobile originating call establishment"
      U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CMServReq_SS_MO(?))); // @sic R5s150599 sic@
      // @siclog "Steps 4-5" siclog@
      // Authentication Request/Response
      f_UTRAN_MM_Authentication();
      
      // @siclog "Step 6" siclog@
      f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain); // @sic R5s141097 sic@
      //The SS starts integrity protection
      
      // @siclog "Step 7" siclog@
      // Receive SETUP with Called number set to '1X'
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_SetupMOCall_CalledNumber(f_CharPacking_IA5toBCD(v_CallingNumber)))) -> value v_RRC_DataInd;
      
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7: Called number set to: " & v_CallingNumber & "; Iteration: " & int2str(k-9));
        
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.setupul.ti, '1'B);
      
      // @siclog "Step 8" siclog@
      // Send RELEASE COMPLETE
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseComplete (v_TI_S, tsc_PD_SS)));
      
      // @siclog "Step 9" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 10" siclog@
      // Wait for 10 seconds and repeat steps 1 to 10
      f_Delay(10.0);
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble(utran34_Cell1, U1_IDLE);
  }//end of f_TC_15_9_6_UTRAN

}
