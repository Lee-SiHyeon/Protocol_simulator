  };

  template (present) STOPDTMF cr_StopDTMF(template (present) TI p_TI):=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '??110001'B
  };

  template (present) STARTDTMF cr_StartDTMF(template (present) TI p_TI,
                                            template (present) KeypadFacility p_KPF):=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '??110101'B,
    kpf             := p_KPF
  };

  template (value) STOPDTMFACKNOWLEDGE cs_StopDTMFAck(template (value) TI p_TI):=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '00110010'B
  };

  template (value) STARTDTMFACKNOWLEDGE cs_StartDTMFAck(template (value) TI p_TI,
                                                        KeypadFacility p_KPF) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '00110110'B,
    kpf             := p_KPF
  };

}
