module EUTRA38_SecurityFunctions {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_SecurityFunctions all;
  import from NAS_AuthenticationCommon all;

  type record EUTRA38_SecurityParamsExtd_Type {       /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    SK_Counter_Type                 SK_Counter,
    B256_Type                       S_KGNB
  };

  template (value) EUTRA38_SecurityParamsExtd_Type cs_AuthParamsExtd_Init :=
  { /* @desc      to Store all parameters related/used to Security */
    /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    SK_Counter         := 0, // Initial value
    S_KGNB             := tsc_AuthUndefinedB256
  };

}
