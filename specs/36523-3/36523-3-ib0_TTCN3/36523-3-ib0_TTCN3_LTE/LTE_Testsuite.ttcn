  //----------------------------------------------------------------------------
  testcase TC_10_2_1() runs on MTC_LTE system SYSTEM_LTE {
    // @purpose
    //   Dedicated EPS bearer context activation / Success
    var EUTRA_PTC        v_EUTRA      := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(360);
  
    v_EUTRA := EUTRA_PTC.create("EUTRA") alive;
  
    f_MTC_ConnectPTCs_LTE(system, v_EUTRA, v_IMS1, v_IMS2);
  
    v_EUTRA.start(f_TC_10_2_1_EUTRA());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_LTE(t_GuardTimer);
  }
