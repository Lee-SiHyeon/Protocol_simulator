  template (value) MAC_MainConfig_Type cs_MAC_MainConfig_Explicit_TTIBundling(template (omit) boolean p_E_HARQ_Pattern_r12 := omit) :=
  { /* @status    APPROVED (LTE, LTE_A_R12) */
