                                                  template (present) B3_Type p_Unit := ?,
                                                  template (present) B5_Type p_Value := ?) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    iei  := p_IEI,
    iel  := '01'O,                   // length
