module MCPTT_MediaControl_Templates {

  import from CommonDefs all;
  import from MCPTT_MediaControl_TypeDefs all;
  import from MCX_CommonDefs all;
  import from MCX_MediaControl_Common all;
  import from MCX_Parameters all;
  import from RTCP_APP_Common all;

  const O4_Type tsc_MCPTT_MediaControl_MCPT := '4d435054'O;                                     /* Floor control                       @status    APPROVED (MCX) */

  const O4_Type tsc_MCPTT_MediaControl_MCPC := '4d435043'O;                                     /* Pre-established session control     @status    APPROVED (MCX) */

  const O2_Type tsc_MCPTT_PreestablishedSessionControl_AnswerState_Confirmed := '0001'O;        /* @status    APPROVED (MCX) */

  const O2_Type tsc_MCPTT_PreestablishedSessionControl_AnswerState_Unconfirmed := '0000'O;      /* @status    APPROVED (MCX) */

  template (present) FloorControl_CommonHdr cr_FloorControl_CommonHdr(template (present) B5_Type p_Subtype,
                                                                      template (present) RTP_SSRC p_SSRC) :=
  /* @status    APPROVED (MCX) */
    cr_RTCP_APP_CommonHdr(p_Subtype, p_SSRC, tsc_MCPTT_MediaControl_MCPT);

  template (value) FloorControl_CommonHdr cs_FloorControl_CommonHdr(B5_Type p_Subtype,
                                                                    RTP_SSRC p_SSRC) :=
  /* @status    APPROVED (MCX) */
    cs_RTCP_APP_CommonHdr(p_Subtype, p_SSRC, tsc_MCPTT_MediaControl_MCPT);

  /*
   * @desc      return floor indicator for given PriorityCallType (TX)
   * @param     p_PriorityCallType
   * @return    B16_Type
   * @status    APPROVED (MCX)
   */
  function f_FloorControl_FloorIndicatorValueTX(MCX_PriorityCallType_Type p_PriorityCallType) return B16_Type
  {
    var B16_Type v_FloorInd;
    select (p_PriorityCallType) {
      case (NORMAL_CALL)     { v_FloorInd := '1000010000000000'B; }
      case (BROADCAST)       { v_FloorInd := '0100010000000000'B; }
      case (EMERGENCY_CALL)  { v_FloorInd := '0001010000000000'B; }
      case (IMMPERIL_CALL)   { v_FloorInd := '0000110000000000'B; }
    }
    return v_FloorInd;
  }

  /*
   * @desc      return floor indicator for given PriorityCallType (RX)
   * @param     p_PriorityCallType
   * @return    template (present) B16_Type
   * @status    APPROVED (MCX)
   */
  function f_FloorControl_FloorIndicatorValueRX(MCX_PriorityCallType_Type p_PriorityCallType) return template (present) B16_Type
  {
    var B16_Type v_FloorInd := f_FloorControl_FloorIndicatorValueTX(p_PriorityCallType);
    var B1_Type v_QueuingBit := f_ConvertBoolToBit(pc_MCPTT_FloorRequestQueueing);   // @sic R5-217967 sic@
    
    return f_BitstringTemplate_SetBit(v_FloorInd, 5, v_QueuingBit);  // NOTE: ES 201 873-1 clause 15.6.1 does not allow index notation
  }

  template (present) FloorControl_FloorIndicator cr_FloorControl_FloorIndicator(template (present) B16_Type p_FloorInd := '??????0000000000'B) :=
  { /* @status    APPROVED (MCX) */
    id := '0D'O, // 24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_FloorInd
  };

  template (value) FloorControl_FloorIndicator cs_FloorControl_FloorIndicator(B16_Type p_FloorInd) :=
  { /* @status    APPROVED (MCX) */
    id := '0D'O, // 24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_FloorInd
  };

  template (value) FloorControl_Source cs_FloorControl_Source(O2_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '0A'O, // 24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_Val
  };

  template (present) FloorControl_MsgType cr_FloorControl_MsgType(O1_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '0C'O, // 24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_Val,
    spare := '00'O
  };

  template (value) FloorControl_MsgType cs_FloorControl_MsgType(O1_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '0C'O, // 24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_Val,
    spare := '00'O
  };

  template (value) FloorControl_MsgSeqNum cs_FloorControl_MsgSeqNum(integer p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '08'O, //  24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := int2oct(p_Val, 2)
  };

  template (value) FloorControl_Duration cs_FloorControl_Duration(O2_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '01'O, //  24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_Val
  };

  template (value) FloorControl_SSRC cs_FloorControl_SSRC(O4_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '0E'O,
    lgth := '06'O,
    val := p_Val,
    spare := '0000'O
  };

  template (value) FloorControl_RejectCause cs_FloorControl_RejectCause(integer p_Length,
                                                                        O2_Type p_Val,
                                                                        octetstring p_Phrase) :=
  { /* @status    APPROVED (MCX) */
    id := '02'O, //  24.380  Table 8.2.3.1-2
    lgth := int2oct(p_Length, 1),
    val := p_Val,
    rejectPhrase := p_Phrase,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up RejectCause
   * @param     p_Val
   * @param     p_Phrase
   * @return    template (value) FloorControl_RejectCause
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_RejectCause(O2_Type p_Val,
                                       charstring p_Phrase) return template (value) FloorControl_RejectCause
  {
    var integer v_Length := lengthof(p_Phrase) + 2;
    var octetstring v_String := char2oct(p_Phrase);
    return cs_FloorControl_RejectCause(v_Length, p_Val, v_String);
  }

  template (value) FloorControl_GrantedPartysId cs_FloorControl_GrantedPartysId(integer p_Length,
                                                                                octetstring p_ServiceId) :=
  { /* @status    APPROVED (MCX) */
    id := '04'O, //  24.380  Table 8.2.3.1-2
    lgth := int2oct(p_Length, 1),
    val := p_ServiceId,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up GrantedPartysId
   * @param     p_ServiceId
   * @return    template (value) FloorControl_GrantedPartysId
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_GrantedPartysId(charstring p_ServiceId) return template (value) FloorControl_GrantedPartysId
  {
    var integer v_Length := lengthof(p_ServiceId);
    var octetstring v_String := char2oct(p_ServiceId);
    return cs_FloorControl_GrantedPartysId(v_Length, v_String);
  }

  template (value) FloorControl_PermissionToRequest cs_FloorControl_PermissionToRequest(O2_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '05'O, //  24.380  Table 8.2.3.1-2
    lgth := '02'O,
    val := p_Val
  };

  template (value) FloorControl_UserID cs_FloorControl_UserID(integer p_Length,
                                                              octetstring p_UserID) :=
  { /* @status    APPROVED (MCX) */
    id := '06'O, //  24.380  Table 8.2.3.1-2
    lgth := int2oct(p_Length, 1),
    val := p_UserID,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up UserID
   * @param     p_UserID
   * @return    template (value) FloorControl_UserID
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_UserID(charstring p_UserID) return template (value) FloorControl_UserID
  {
    var integer v_Length := lengthof(p_UserID);
    var octetstring v_String := char2oct(p_UserID);
    return cs_FloorControl_UserID(v_Length, v_String);
  }

  template (value) FloorControl_QueueInfo cs_FloorControl_QueueInfo(O1_Type p_PositionInfo,
                                                                    O1_Type p_PrioInfo) :=
  { /* @status    APPROVED (MCX) */
    id := '03'O,
    lgth := '02'O,
    positionInfo := p_PositionInfo,
    prioInfo := p_PrioInfo
  };

  template (present) FloorControl_Location cr_FloorControl_Location(template (present) FloorControl_LocationValue p_LocationValue := ?) :=
  { /* @status    APPROVED (MCX) */
    id := '13'O,
    lgth := ?,
    val := p_LocationValue,
    padding := ?
  };

  template (value) FloorControl_LocationValue crs_FloorControl_LocationValue_NotProvided :=
  { /* @status    APPROVED (MCX) */
    locType := '00'O,     // location not provided
    locVal := ''O
  };

  template (value) FloorControl_Location cs_FloorControl_Location_Def(integer p_Length := 1,  // one octet only
                                                                      template (value) FloorControl_LocationValue p_LocationValue := crs_FloorControl_LocationValue_NotProvided) :=
  { /* @status    APPROVED (MCX) */
    id := '13'O,
    lgth := int2oct(p_Length, 1),
    val := p_LocationValue,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up receive template for Location field depending on the client's release
   * @param     p_ClientRelease     (default value: 14)
   * @return    template FloorControl_Location
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_LocationRX(integer p_ClientRelease := 14) return template FloorControl_Location
  {
    var template FloorControl_Location v_Location := cr_FloorControl_Location;
    if (p_ClientRelease < 15) {
      v_Location := v_Location ifpresent;
    }
    return v_Location;
  }

  template (value) FloorControl_ListOfLocations cs_FloorControl_ListOfLocations(integer p_Length,
                                                                                integer p_NoOfLocations,
                                                                                template (value) FloorControl_LocationValueList p_LocationValueList) :=
  { /* @status    APPROVED (MCX) */
    id := '14'O,
    lgth := int2oct(p_Length, 1),
    noOfLocations := int2oct(p_NoOfLocations, 1),
    list := p_LocationValueList,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      24.380 Table 8.2.3.22-1: List of Locations
   * @param     p_NoOfLocations     (default value: 2)
   * @return    template (value) FloorControl_ListOfLocations
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_ListOfLocationsTX(integer p_NoOfLocations := 2) return template (value) FloorControl_ListOfLocations
  {
    var template (value) FloorControl_LocationValueList v_LocationValueList;
    var integer v_Length := 1;   // one octet for noOfLocations
    var integer i;

    for (i := 0; i < p_NoOfLocations; i := i + 1) {
      v_LocationValueList[i] := crs_FloorControl_LocationValue_NotProvided;
      v_Length := v_Length + 1;
    }
    return cs_FloorControl_ListOfLocations(v_Length, p_NoOfLocations, v_LocationValueList);
  }

  template (value) FloorControl_GenericId cs_FloorControl_GenericId(integer p_Length,
                                                                    octetstring p_Value) :=
  { /* @status    APPROVED (MCX) */
    lgth := int2oct(p_Length, 1),
    val := p_Value
  };

  template (value) FloorControl_ListOfGrantedUsers cs_FloorControl_ListOfGrantedUsers(integer p_Length,
                                                                                      integer p_NoOfUsers,
                                                                                      template (value) FloorControl_GenericIdList p_GenericIdList) :=
  { /* @status    APPROVED (MCX) */
    id := '0F'O,
    lgth := int2oct(p_Length, 1),
    noOfUsers := int2oct(p_NoOfUsers, 1),
    list := p_GenericIdList,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      24.380 Table 8.2.3.17-1: List of User IDs
   * @param     p_GrantedUsers
   * @return    template (value) FloorControl_ListOfGrantedUsers
   * @status    APPROVED (MCX)
   */
  function fl_FloorControl_ListOfGrantedUsersTX(CharStringList_Type p_GrantedUsers) return template (value) FloorControl_ListOfGrantedUsers
  {
    var template (value) FloorControl_GenericIdList v_GenericIdList;
    var integer v_NoOfUsers := lengthof(p_GrantedUsers);
    var integer v_Length := 1;   // one octet for noOfUsers
    var integer v_UserIdLength;
    var integer i;

    for (i := 0; i < v_NoOfUsers; i := i + 1) {
      v_UserIdLength := lengthof(p_GrantedUsers[i]);
      v_GenericIdList[i] := cs_FloorControl_GenericId(v_UserIdLength, char2oct(p_GrantedUsers[i]));
      v_Length := v_Length + v_UserIdLength + 1;
    }
    return cs_FloorControl_ListOfGrantedUsers(v_Length, v_NoOfUsers, v_GenericIdList);
  }

  template (value) FloorControl_ListOfSSRCs cs_FloorControl_ListOfSSRCs(RTP_SSRC_List p_SSRC_List) :=
  { /* @status    APPROVED (MCX) */
    id := '10'O,
    lgth := int2oct(lengthof(p_SSRC_List) * 4, 1),
    noOfSSRCs := int2oct(lengthof(p_SSRC_List), 1),    // @sic R5s221241: BASELINE MOVING 2022 09 - new field sic@
    spare := '00'O,
    list := p_SSRC_List
  };

  template (present) FloorControlMsg_Type cr_FloorCtrlMsg_Request(template (present) RTP_SSRC p_RTCP_SSRC_UE,
                                                                  template (present) B16_Type p_FloorInd) :=
  { // 36.579-1 Table 5.5.6.2-1
    /* @status    APPROVED (MCX) */
    requestMessage := {
      commonHdr := cr_FloorControl_CommonHdr('00000'B, p_RTCP_SSRC_UE),         // Request subtype 24.380 clause 8.2.2.1
      prio := *,
      userId := omit,
      trackInfo := omit,
      floorIndicator := cr_FloorControl_FloorIndicator(p_FloorInd),
      functionalAlias := omit,                                          // Rel-15
      location := fl_FloorControl_LocationRX()                          // Rel-15
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Granted(RTP_SSRC p_RTCP_SSRC_SS,
                                                                RTP_SSRC p_MediaSSRC_UE,
                                                                B16_Type p_FloorInd,
                                                                MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) :=
  { // 36.579-1 Table 5.5.6.3-1
    /* @status    APPROVED (MCX) */
    grantedMessage := {
      commonHdr := cs_FloorControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00001'B, p_AckRequest), p_RTCP_SSRC_SS),        // Granted subtype 24.380 clause 8.2.2.1
      duration := cs_FloorControl_Duration('0080'O),
      ssrcGrantedParticipant := cs_FloorControl_SSRC(p_MediaSSRC_UE),
      prio := omit,
      userId := omit,
      queueSize := omit,
      ssrcQueuedParticipant := omit,
      queuedUserId := omit,
      queueInfo := omit,
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator(p_FloorInd)
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Deny(RTP_SSRC p_RTCP_SSRC_SS,
                                                             B16_Type p_FloorInd,
                                                             O2_Type p_RejectCause,
                                                             charstring p_Reason,
                                                             MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) :=
  { // 36.579-1, Table 5.5.6.4-1
