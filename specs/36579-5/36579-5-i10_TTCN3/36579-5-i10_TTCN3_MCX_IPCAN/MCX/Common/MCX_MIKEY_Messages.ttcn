module MCX_MIKEY_Messages {

  import from Base64Encoding all;
  import from CommonDefs all;
  import from IMS_Component all;
  import from MCDataMessage_Common all;
  import from MCDataMessage_TypeDefs all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_Component all;
  import from MCX_SecurityFunctions all;
  import from MCX_SecurityParameters all;
  import from MIKEY_MCX_Extension_TypeDefs all;
  import from MIKEY_TypeDefs all;

  const integer tsc_MIKEY_PayloadType_Timestamp      := 5;  /* RFC 3830 clause 6.1    @status    APPROVED (MCX)*/

  const integer tsc_MIKEY_PayloadType_SecurityPolicy := 10; /* RFC 3830 clause 6.1    @status    APPROVED (MCX)*/

  const integer tsc_MIKEY_PayloadType_RAND           := 11; /* RFC 3830 clause 6.1    @status    APPROVED (MCX)*/

  const integer tsc_MIKEY_PayloadType_Extension      := 21; /* RFC 3830 clause 6.1    @status    APPROVED (MCX)*/

  const integer tsc_MIKEY_PayloadType_IDR            := 14; /* RFC 6043 clause 6.1    @status    APPROVED (MCX)*/

  const integer tsc_MIKEY_PayloadType_SAKKE          := 26; /* RFC 6509 clause 4.1    @status    APPROVED (MCX)*/

  const O1_Type tsc_MIKEY_IDR_Role_IDRi    := '01'O;         /* @status    APPROVED (MCX) */

  const O1_Type tsc_MIKEY_IDR_Role_IDRr    := '02'O;         /* @status    APPROVED (MCX) */

  const O1_Type tsc_MIKEY_IDR_Role_IDRkmsi := '06'O;         /* @status    APPROVED (MCX) */

  const O1_Type tsc_MIKEY_IDR_Role_IDRkmsr := '07'O;         /* @status    APPROVED (MCX) */

  template (value) MIKEY_CommonHeader cs_MIKEY_SAKKE_CommonHeader_EmptyMap(B32_Type p_CsbId) :=
  { /* 36.579-1 Table 5.5.9.1-2, Table 5.5.9.1-3 */
    /* @status    APPROVED (MCX) */
    version := '01'O,
    dataType := '1A'O,                   /* SAKKE acc. RFC 6509 clause 4.1 */
    nextPayload := '00'O,                /* to be replaced before sending */
    v := '0'B,                           /* acc. to 36.579-1 Table 5.5.9.1-X; see RFC 6509 clause 2.2.1: "The V bit in the HDR payload MUST be set to '0'" */
    prfFunc := '0000001'B,               /* acc. to 36.579-1 Table 5.5.9.1-X: PRF-HMAC-SHA-256 Pseudo-Random Function as acc. to 33.180 and RFC 6043  */
    csbId := p_CsbId,
    numberCS := '00'O,                   /* no crypto session => default security policies (33.180 E.1.2) */
    csIdMap := '01'O,                    /* empty map (33.180 E.1.2) */
    csIdMapInfo := {
      EmptyMap := true
    }
  };

  template (present) B28_Type cr_B28_Any := '????????????????????????????'B;                                                    /* @status    APPROVED (MCX) */

  template (present) B32_Type cr_MIKEY_SAKKE_CSB_ID(template (present) B4_Type p_KeyPurpose) := p_KeyPurpose & cr_B28_Any;      /* @status    APPROVED (MCX) */

  template (present) MIKEY_CommonHeader cr_MIKEY_SAKKE_CommonHeader_EmptyMap(template (present) B32_Type p_CsbId) :=
  { /* 36.579-1 clause 5.5.9.1 */
    /* @status    APPROVED (MCX) */
    version := '01'O,
    dataType := '1A'O,                   /* SAKKE acc. RFC 6509 clause 4.1 */
    nextPayload := ?,
    v := '0'B,                           /* acc. to 36.579-1 Table 5.5.9.1-X; see RFC 6509 clause 2.2.1: "The V bit in the HDR payload MUST be set to '0'" */
    prfFunc := '0000001'B,               /* acc. to 36.579-1 Table 5.5.9.1-X: PRF-HMAC-SHA-256 Pseudo-Random Function as acc. to 33.180 E.1.2 and RFC 6043  */
    csbId := p_CsbId,
    numberCS := '00'O,                   /* no crypto session => default security policies (33.180 E.1.2) */
    csIdMap := '01'O,                    /* empty map (33.180 E.1.2) */
    csIdMapInfo := {
      EmptyMap := true
    }
  };

  template (present) MIKEY_CommonHeader cdr_MIKEY_SAKKE_CommonHeader_GenericMap(template (present) B32_Type p_CsbId,
                                                                                template (present) MIKEY_GenericIdMapType p_GenericIdMapType)
    modifies cr_MIKEY_SAKKE_CommonHeader_EmptyMap :=
  { /* 36.579-1 clause 5.5.9.1 */
    /* @status    APPROVED (MCX) */
    numberCS := '01'O,
    csIdMap := '02'O,                    /* acc. to 36.579-1 Table 5.5.9.1-X; 33.179: "CS-ID map type shall be GENERIC-ID as defined in IETF RFC 6043" */
    csIdMapInfo := {
      GENERIC := p_GenericIdMapType
    }
  };

  template (present) MIKEY_GenericIdMapType cr_MIKEY_GenericIdMapType(template (present) O1_Type p_CsId,
                                                                      template (present) O1_Type p_SecurityPolicyId := ?) :=
  { /* @status    APPROVED (MCX) */
    csId := p_CsId,
    protType := '00'O,                   /* SRTP  */
    s := '?'B,                           /* S flag to indicate whether the ROC and SEQ fields are provided ('1') or if they are omitted ('0') */
    nP := '0000001'B,                    /* number of security policies provided for the crypto session */
    ps := { p_SecurityPolicyId },        /* policy_no that corresponds to the policy_no of a SP payload */
    sessionDataLen := ?,
    sessionData := ?,
    spiLen :=  ?,
    spi := ?
  };

  template (value) MIKEY_GenericPayload cs_MIKEY_GenericPayload(template (value) MIKEY_PayloadContent p_PayloadContent) :=
  { /* @status    APPROVED (MCX) */
    nextPayload := '00'O,
    content := p_PayloadContent
  };

  template (present) MIKEY_GenericPayload cr_MIKEY_GenericPayload(template (present) MIKEY_PayloadContent p_PayloadContent) :=
  { /* @status    APPROVED (MCX) */
    nextPayload := ?,
    content := p_PayloadContent
  };

  template (value) MIKEY_PayloadContent cs_MIKEY_Timestamp_Payload(integer p_TimestampSeconds) :=
  { /* @status    APPROVED (MCX) */
    Timestamp := {
      tsType := '00'O,                                           /* NTP-UTC (0): 64-bits according to 33.180 E.1.2  */
      tsValue := int2oct(p_TimestampSeconds, 4) & '00000000'O    /* 64 bit UTC (Coordinated Universal Time, Greenwich Mean Time; according to RFC 5905 clause 6
                                                                    the upper 32 bit containing the seconds, the lower 32 bit the picoseconds set to 0 */
    }
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_Timestamp_Payload :=
  { /* @status    APPROVED (MCX) */
    Timestamp := {
      tsType := '00'O,                               /* NTP-UTC (0): 64-bits according to 33.180 E.1.2  */
      tsValue := ?
    }
  };

  template (value) MIKEY_PayloadContent cs_MIKEY_RAND_Payload(octetstring p_RAND) :=
  { /* @status    APPROVED (MCX) */
    RAND := {
      randLen := int2oct(lengthof(p_RAND), 1),
      randValue := p_RAND
    }
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_RAND_Payload :=
  { /* @status    APPROVED (MCX) */
    RAND := {
      randLen := '10'O,
      randValue := ?
    }
  };

  template (value) MIKEY_PayloadContent cs_MIKEY_IDR_URI_Payload(O1_Type p_Role,
                                                                 charstring p_URI) :=
  { /* @status    APPROVED (MCX) */
    IDR := {
      idRole := p_Role,
      idType := '01'O,    /* URI */
      idLen := int2oct(lengthof(p_URI), 2),
      idData := char2oct(p_URI)
    }
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_IDR_URI_Payload_AnyUri(O1_Type p_Role,
                                                                          template (present) octetstring p_URI := ?) :=
  { /* @status    APPROVED (MCX) */
    IDR := {
      idRole := p_Role,
      idType := '01'O,    /* URI */
      idLen := ?,
      idData := p_URI
    }
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_IDR_URI_Payload(O1_Type p_Role,
                                                                   charstring p_URI) :=
  /* @status    APPROVED (MCX) */
    cr_MIKEY_IDR_URI_Payload_AnyUri(p_Role, char2oct(p_URI));

  template (present) MIKEY_PolicyParam cr_MIKEY_PolicyParam(integer p_Type,
                                                            integer p_Value) :=
  { /* @status    APPROVED (MCX) */
    policyType := int2oct(p_Type, 1),
    len := '01'O,  /* value assumed to be one byte only */
    val := int2oct(p_Value, 1)
  };

  template (present) MIKEY_PolicyParams cr_MIKEY_PolicyParams_CSK :=
  { /* @status    APPROVED (MCX) */
    cr_MIKEY_PolicyParam(0,  6),        /* Encryption Algorithm: AES-GCM */
    cr_MIKEY_PolicyParam(1, 16),        /* Session encryption key length: 16 octets */
    cr_MIKEY_PolicyParam(4, 12),        /* Session salt key length: 12 octets */
    cr_MIKEY_PolicyParam(5,  0),        /* SRTP PRF: AES-CM */
    cr_MIKEY_PolicyParam(6,  0),        /* Key derivation rate: No session key refresh */
    cr_MIKEY_PolicyParam(20, 16)        /* AEAD authentication tag length: 16 octets */
  };

  template (present) MIKEY_PolicyParams cr_MIKEY_PolicyParams_PrivateCall :=
  { /* @status    APPROVED (MCX) */
    cr_MIKEY_PolicyParam(0,  6),        /* Encryption Algorithm: AES-GCM */
    cr_MIKEY_PolicyParam(1, 16),        /* Session encryption key length: 16 octets */
    cr_MIKEY_PolicyParam(4, 12),        /* Session salt key length: 12 octets */
    cr_MIKEY_PolicyParam(5,  0),        /* SRTP PRF: AES-CM */
    cr_MIKEY_PolicyParam(6,  0),        /* Key derivation rate: No session key refresh */
    cr_MIKEY_PolicyParam(20, 16)        /* AEAD authentication tag length: 16 octets */
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_SecurityPolicy_SRTP_Payload(template (present) O1_Type p_PolicyNo := ?,
                                                                               template (present) MIKEY_PolicyParams p_PolicyParams := ?) :=
  { /* @status    APPROVED (MCX) */
    SecurityPolicy := {
      policyNo := p_PolicyNo,
      protType := '00'O,     /* SRTP */
      policyParamLen := ?,
      policyParams := p_PolicyParams
    }
  };

  template (value) MIKEY_PayloadContent cs_MIKEY_GeneralExtension_3GPP_Payload(octetstring p_Data) :=
  { /* @status    APPROVED (MCX) */
    Extension := {
      extType := '07'O,        /* '3GPP key parameters' according to 33.180 (rel-16) E.6.1 */
      extLen := int2oct(lengthof(p_Data), 2),
      extData := p_Data
    }
  };

  template (value) MIKEY_PayloadContent cs_MIKEY_SAKKE_Payload(octetstring p_SakkeData) :=
  { /* @status    APPROVED (MCX) */
    SAKKE := {
      sakkeParms := '01'O,          /* Parameter Set 1 as in RFC 6509 Appendix A */
      idScheme := '02'O,            /* '3GPP MCX hashed UID' according to 33.180 (rel-16) E.1.2 */
      sakkeLen := int2oct(lengthof(p_SakkeData), 2),
      sakkeData := p_SakkeData
    }
  };

  template (present) MIKEY_PayloadContent cr_MIKEY_SAKKE_Payload(template (present) octetstring p_SakkeData := ?) :=
  { /* @status    APPROVED (MCX) */
    SAKKE := {
      sakkeParms := '01'O,          /* Parameter Set 1 as in RFC 6509 Appendix A */
      idScheme := '02'O,            /* '3GPP MCX hashed UID' according to 33.180 (rel-16) E.1.2 */
      sakkeLen := ?,
      sakkeData := p_SakkeData
    }
  };

  template (value) MIKEY_Signature_Payload cs_MIKEY_Signature_ECCSI :=
  { /* @status    APPROVED (MCX) */
    sType := '0010'B,            /* ECCSI */
    sLen := int2bit(tsc_SAKKE_ECCSI_SignatureLength, 12),
    s := ''O                     /* signature to be added after it has been calculated over the entire MIKEY message, except the MAC/Signature field, i.e. including the Signature payload's type and length field (RFC 3830 clause 5.2) */
  };

  template (present) MIKEY_Signature_Payload cr_MIKEY_Signature_ECCSI :=
  { /* @status    APPROVED (MCX) */
    sType := '0010'B,            /* ECCSI */
    sLen := ?,
    s := ?
  };

  template (value) MCX_KeyParametersPayload_Type cs_MCX_KeyParametersPayload(charstring p_GroupID) :=
  { /* 33.180 E.6 and Table 5.5.9.1-3: General Extension Payload */
    /* @status    APPROVED (MCX) */
    keyType := '00'O,                /* GMK */
    status := '00000001'O,           /* not revoked */
    activationTime := '0000000000'O, /* 0 => activation time is the timestamp of the received MIKEY I_MESSAGE */
    expiryTime := '0000000000'O,     /* 0 => the key shall not expire */
    text := {                        /* no text */
      iel := int2oct(0, 2),
      str := ''O
    },
    groupIds := {
      iel := int2oct(lengthof(p_GroupID) + 3, 2),
      noOfGroupIds := '01'O,
      groupId := {
        iei := '7B'O,
        iel := int2oct(lengthof(p_GroupID), 2),
        id := char2oct(p_GroupID)
      }
    },
    reserved := omit
  };

  /*
   * @desc      return ProtectedPayloadMessage without content according to 36.579-1 Table 5.5.9.1-3: MCData Protected Payload message as defined in 33.180 Clause 8.5.4
   * @param     p_CSB_Id
   * @return    template (value) MCData_ProtectedPayloadMessage
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ProtectedKeyParametersPayloadWithoutContentTX(B32_Type p_CSB_Id) return template (value) MCData_ProtectedPayloadMessage
  {
    var MCData_MessageType v_MessageType := oct2bit('43'O);     /* R5w210207 Assumption 2.1-1a: message type of DATA PAYLOAD ('000011'B) according to 24.282 Table 15.2.2-1
                                                                   @sic R5-216686: MCData Protected Payload message contained in the General Extension Payload is not authenticated => '43'O instead of 'C3'O sic@ */
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var O4_Type v_PayloadId := '00000000'O;                     // 36.579-1 Table 5.5.9.1-3
    var O1_Type v_PayloadSequenceNumber := '00'O;               // 36.579-1 Table 5.5.9.1-3
    var O16_Type v_IV := 'AAAAAAAAAAAAAAAA5555555555555555'O;   // 36.579-1 Table 5.5.9.1-3

    return cs_MCX_ProtectedPayloadMessage(v_MessageType,
                                          v_TimestampSeconds,
                                          v_PayloadId,
                                          v_PayloadSequenceNumber,
                                          v_IV,
                                          p_CSB_Id);
  }

  template (value) MIKEY_Message cs_MIKEY_Message(template (value) MIKEY_CommonHeader p_CommonHeader,
                                                  template (value) MIKEY_PayloadList p_PayloadList) :=
  { /* p_Signature := omit as signature needs to be generated without signature payload */
    /* @status    APPROVED (MCX) */
    commonHdr := p_CommonHeader,
    payloads := p_PayloadList,
    sign := cs_MIKEY_Signature_ECCSI
  };

  template (present) MIKEY_Message cr_MIKEY_Message(template (present) MIKEY_CommonHeader p_CommonHeader,
                                                    template (present) MIKEY_PayloadList p_PayloadList,
                                                    template (present) MIKEY_Signature_Payload p_Signature) :=
  { /* @status    APPROVED (MCX) */
    commonHdr := p_CommonHeader,
    payloads := p_PayloadList,
    sign := p_Signature
  };

  /*
   * @desc      Find Payload in MIKEY message
   * @param     p_Message
   * @param     p_PayloadContent
   * @return    template (omit) MIKEY_GenericPayload
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_Message_FindPayload(MIKEY_Message p_Message,
                                        template (present) MIKEY_PayloadContent p_PayloadContent) return template (omit) MIKEY_GenericPayload
  {
    var integer i;
    var MIKEY_GenericPayload v_GenericPayload;

    for (i := 0; i < lengthof(p_Message.payloads); i := i + 1) {
      v_GenericPayload := p_Message.payloads[i];
      if (match(v_GenericPayload, cr_MIKEY_GenericPayload(p_PayloadContent))) {
        return v_GenericPayload;
      }
    }
    return omit;
  }

  /*
   * @desc      Get Payload from MIKEY message
   * @param     p_Message
   * @param     p_PayloadContent
   * @return    MIKEY_GenericPayload
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_Message_GetPayload(MIKEY_Message p_Message,
                                       template (present) MIKEY_PayloadContent p_PayloadContent) return MIKEY_GenericPayload
  {
    var template (omit) MIKEY_GenericPayload v_GenericPayload := fl_MIKEY_Message_FindPayload(p_Message, p_PayloadContent);
    if (not isvalue(v_GenericPayload)) {
      FatalError(__FILE__, __LINE__, "payload not found");
    }
    return valueof(v_GenericPayload);
  }

  /*
   * @desc      Get SAKKE data from MIKEY message
   * @param     p_Message
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_Message_GetSAKKEData(MIKEY_Message p_Message) return octetstring
  {
    var MIKEY_GenericPayload v_GenericPayload := fl_MIKEY_Message_GetPayload(p_Message, cr_MIKEY_SAKKE_Payload);
    return v_GenericPayload.content.SAKKE.sakkeData;
  }

  /*
   * @desc      Get RAND data from MIKEY message
   * @param     p_Message
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_Message_GetRAND(MIKEY_Message p_Message) return octetstring
  {
    var MIKEY_GenericPayload v_GenericPayload := fl_MIKEY_Message_GetPayload(p_Message, cr_MIKEY_RAND_Payload);
    return v_GenericPayload.content.RAND.randValue;
  }

  /*
   * @desc      Get IDR from MIKEY message
   * @param     p_Message
   * @param     p_Role
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_Message_GetIDRIdentity(MIKEY_Message p_Message,
                                          O1_Type p_Role) return charstring
  {
    var template (present) octetstring v_URI := ?;
    var MIKEY_GenericPayload v_GenericPayload := fl_MIKEY_Message_GetPayload(p_Message, cr_MIKEY_IDR_URI_Payload_AnyUri(p_Role, v_URI));
    return oct2char(v_GenericPayload.content.IDR.idData);
  }

  /*
   * @desc      return payload type for given content
   * @param     p_PayloadContent
   * @return    O1_Type
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_Message_PayloadType(MIKEY_PayloadContent p_PayloadContent) return O1_Type
  {
    var integer v_PayloadType;

    select union (p_PayloadContent) {
      /* next payload values according to RFC 3830 clause 6.1: */
      case (Timestamp)         { v_PayloadType := tsc_MIKEY_PayloadType_Timestamp; }
      case (SecurityPolicy)    { v_PayloadType := tsc_MIKEY_PayloadType_SecurityPolicy; }
      case (RAND)              { v_PayloadType := tsc_MIKEY_PayloadType_RAND; }
      case (Extension)         { v_PayloadType := tsc_MIKEY_PayloadType_Extension; }
      /* next payload values according to RFC 6043 clause 6.1: */
      case (IDR)               { v_PayloadType := tsc_MIKEY_PayloadType_IDR; }
      /* next payload values according to RFC 6509 clause 4.1: */
      case (SAKKE)             { v_PayloadType := tsc_MIKEY_PayloadType_SAKKE; }
      case else { FatalError(__FILE__, __LINE__, ""); }
    }
    return int2oct(v_PayloadType, 1);
  }

  /*
   * @desc      Function setting the 'NextPayloadFields' in the MIKEY message to be sent to the client
   * @param     p_Message
   * @return    template (value) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_Message_SetNextPayloadFields(template (value) MIKEY_Message p_Message) return template (value) MIKEY_Message
  {
    var template (value) MIKEY_Message v_Message := p_Message;
    var MIKEY_PayloadList v_PayloadList := valueof(v_Message.payloads);
    var O1_Type v_PayloadTypeSIGN := '04'O;
    var integer N := lengthof(v_PayloadList);
    var integer i;
    
    if (N == 0) {
      v_Message.commonHdr.nextPayload := v_PayloadTypeSIGN;
    }
    else {
      v_Message.commonHdr.nextPayload := fl_MIKEY_Message_PayloadType(v_PayloadList[0].content);
      for (i := 0; i < N - 1; i := i + 1) {
        v_Message.payloads[i].nextPayload := fl_MIKEY_Message_PayloadType(v_PayloadList[i+1].content);
      }
      v_Message.payloads[i].nextPayload := v_PayloadTypeSIGN;
    }
    return v_Message;
  }

  /*
   * @desc      create signature according to RFC 3830 clause 5.2 using algorithms according to RFC 6507 clause 5.2.1
   *            The signature is needed for GMK distribution, MT private call establishment and CSK download
   *            The p_UID is the UID of the initiator i.e. it corresponds to the IDRi of MIKEY message
   * @param     p_SecurityParameters
   * @param     p_MIKEY_Message
   * @param     p_UID
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_Signature_Create(MCX_SecurityParameters_Type p_SecurityParameters,
                                          template (value) MIKEY_Message p_MIKEY_Message,
                                          octetstring p_UID) return octetstring
  {
    var octetstring v_Message := bit2oct(encvalue(p_MIKEY_Message));
    var integer v_EphemeralValue_v := hex2int('13579'H);     /* random (ephemeral) non-zero v for generation of the (SSK, PVT) pair according to RFC 6507 clause 5.1.1; arbitrarily selected */
    var integer v_EphemeralValue_j := hex2int('89ABC'H);     /* random (ephemeral) non-zero j for signing according to RFC 6507 clause 5.2.1; arbitrarily selected */
    var ECCSI_SskPvtPair_Type v_SskPvtPair;                  /* the (SSK, PVT) pair needs to be generated for the respective initiator i.e. it is different from the one stored in p_SecurityParameters whic is assigned to the client */
    var octetstring v_Signature;

    v_SskPvtPair := f_ECCSI_GenerateSskPvtPair(p_UID,
                                               p_SecurityParameters.ECCSI.KSAK,
                                               p_SecurityParameters.ECCSI.KPAK,
                                               v_EphemeralValue_v);

    v_Signature := f_ECCSI_SignMessage(v_Message,
                                       p_SecurityParameters.ECCSI.KPAK,
                                       p_UID,
                                       v_SskPvtPair.SSK,
                                       v_SskPvtPair.PVT,
                                       v_EphemeralValue_j);
    return v_Signature;
  }

  /*
   * @desc      local common function to create DL MIKEY message
   *            further payloads may contain Security Policy Payload and/or General Extension Payload
   * @param     p_SecurityParameters
   * @param     p_TimestampSeconds
   * @param     p_CommonHeader
   * @param     p_Key
   * @param     p_RAND
   * @param     p_InitiatorURI
   * @param     p_ResponderURI
   * @param     p_InitiatorKMSURI
   * @param     p_ResponderKMSURI
   * @param     p_FurtherPayloads  (default value: {})
   * @return    template (value) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_SAKKE_MessageTX_Common(MCX_SecurityParameters_Type p_SecurityParameters,
                                           integer p_TimestampSeconds,
                                           template (value) MIKEY_CommonHeader p_CommonHeader,
                                           O16_Type p_Key,
                                           octetstring p_RAND,
                                           charstring p_InitiatorURI,
                                           charstring p_ResponderURI,
                                           charstring p_InitiatorKMSURI,
                                           charstring p_ResponderKMSURI,
                                           template (value) MIKEY_PayloadList p_FurtherPayloads := {}) return template (value) MIKEY_Message
  {
    var template (value) MIKEY_PayloadList v_PayloadList;
    var template (value) MIKEY_Message v_MIKEY_Message;
    var octetstring v_ReceiverUID := f_MCX_SecurityParameters_GetUID(p_SecurityParameters, p_ResponderURI);   /* The key is encrypted to the UID associated to the receiving MCX entity (33.180 clause 5.2.2) */
    var octetstring v_InitiatorUID := f_MCX_SecurityParameters_GetUID(p_SecurityParameters, p_InitiatorURI);  /* The UID used to sign the data is derived from the initiating entity's URI (33.180 clause 5.2.2) */
    var octetstring v_SakkeData := fx_SAKKE_EncapsulateKey(p_Key, p_SecurityParameters.SAKKE.PublicKey, v_ReceiverUID);

    v_PayloadList := {
      cs_MIKEY_GenericPayload(cs_MIKEY_Timestamp_Payload(p_TimestampSeconds)),
      cs_MIKEY_GenericPayload(cs_MIKEY_RAND_Payload(p_RAND)),
      cs_MIKEY_GenericPayload(cs_MIKEY_IDR_URI_Payload('01'O, p_InitiatorURI)),    /* Initiator (IDRi) */
      cs_MIKEY_GenericPayload(cs_MIKEY_IDR_URI_Payload('02'O, p_ResponderURI)),    /* Responder (IDRr) */
      cs_MIKEY_GenericPayload(cs_MIKEY_IDR_URI_Payload('06'O, p_InitiatorKMSURI)), /* Initiator's KMS (IDRkmsi) */
      cs_MIKEY_GenericPayload(cs_MIKEY_IDR_URI_Payload('07'O, p_ResponderKMSURI)), /* Responder's KMS (IDRkmsr) */
      cs_MIKEY_GenericPayload(cs_MIKEY_SAKKE_Payload(v_SakkeData))
    };

    v_PayloadList := v_PayloadList & p_FurtherPayloads;     // add e.g. general extension payload */

    v_MIKEY_Message := cs_MIKEY_Message(p_CommonHeader, v_PayloadList);
    v_MIKEY_Message := fl_MIKEY_Message_SetNextPayloadFields(v_MIKEY_Message);
    v_MIKEY_Message.sign.s := f_MIKEY_SAKKE_Signature_Create(p_SecurityParameters, v_MIKEY_Message, v_InitiatorUID);

    return v_MIKEY_Message;
  }

  /*
   * @desc      Table 5.5.9.1-2: MIKEY-SAKKE I_MESSAGE (Private call)
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @return    template (value) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageTX_PrivateCall(MCX_ServiceType_Type p_ServiceType,
                                               MCX_SecurityParameters_Type p_SecurityParameters) return template (value) MIKEY_Message
  {
    var MCX_SecurityKey_Type v_PCK := f_MCX_SecurityParameters_GetExistingKey(p_SecurityParameters, PCK);
    var template (value) MIKEY_CommonHeader v_CommonHeader := cs_MIKEY_SAKKE_CommonHeader_EmptyMap(v_PCK.Id);
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var charstring v_MCServiceId_User_A := f_MCX_MCService_ID_User_A(p_ServiceType);
    var charstring v_MCServiceId_User_B := f_MCX_MCService_ID_User_B(p_ServiceType);

    return fl_MIKEY_SAKKE_MessageTX_Common(p_SecurityParameters,
                                           v_TimestampSeconds,
                                           v_CommonHeader,
                                           v_PCK.Value,
                                           v_PCK.RAND,
                                           v_MCServiceId_User_B,               /* IDRi */
                                           v_MCServiceId_User_A,               /* IDRr */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmi */
                                           tsc_MCX_KMS_Hostname);              /* IDRksmr */
  }

  /*
   * @desc      Table 5.5.9.1-3: MIKEY-SAKKE I_MESSAGE (GMK distribution)
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @param     p_GroupID
   * @return    template (value) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageTX_GMK(MCX_ServiceType_Type p_ServiceType,
                                       MCX_SecurityParameters_Type p_SecurityParameters,
                                       charstring p_GroupID) return template (value) MIKEY_Message
  {
    var charstring v_MCServiceId := f_MCX_MCService_ID_User_A(p_ServiceType);

    // Calculate GUK-ID:
    var MCX_SecurityKey_Type v_GMK := f_MCX_SecurityParameters_GetExistingKey(p_SecurityParameters, GMK);
    var bitstring v_Key := oct2bit(v_GMK.Value);
    var charstring v_ReceivingEntityURI := v_MCServiceId;                                        /* 33.180 clause 5.2.3: "receiving entity's MCX URI" */
    var B32_Type v_GUK_ID := f_MCX_CalculateGUKID(v_ReceivingEntityURI, v_GMK);
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();

    // Header payload:
    var template (value) MIKEY_CommonHeader v_CommonHeader := cs_MIKEY_SAKKE_CommonHeader_EmptyMap(v_GUK_ID);

    // General extension payload:
    var octetstring v_PayloadData := bit2oct(encvalue(cs_MCX_KeyParametersPayload(p_GroupID)));
    var template (value) MCData_ProtectedPayloadMessage v_ProtectedPayloadWithoutContent := fl_MCX_ProtectedKeyParametersPayloadWithoutContentTX(v_GUK_ID);
    var octetstring v_ProtectedPayloadData := f_MCData_ProtectedPayloadMessage_EncryptAndEncode(v_ProtectedPayloadWithoutContent, v_Key, v_PayloadData);  // @sic R5w210207: protected payload carrying key parameters sic@
    var template (value) MIKEY_PayloadList v_FurtherPayloads := {
      cs_MIKEY_GenericPayload(cs_MIKEY_GeneralExtension_3GPP_Payload(v_ProtectedPayloadData))
    };

    return fl_MIKEY_SAKKE_MessageTX_Common(p_SecurityParameters,
                                           v_TimestampSeconds,
                                           v_CommonHeader,
                                           v_GMK.Value,
                                           v_GMK.RAND,
                                           tsc_MCX_GMS_Hostname,               /* IDRi; NOTE: The example in 33.180 clause 5.7.1 suggests the IDRi to be a SIP URI; nevertheless this should not matter */
                                           v_MCServiceId,                      /* IDRr */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmi */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmr */
                                           v_FurtherPayloads);
  }

  /*
   * @desc      Table 5.5.9.1-1A: MIKEY-SAKKE I_MESSAGE (CSK distribution)
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @return    template (value) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageTX_CSK(MCX_ServiceType_Type p_ServiceType,
                                       MCX_SecurityParameters_Type p_SecurityParameters) return template (value) MIKEY_Message
  {
    var MCX_SecurityKey_Type v_CSK := f_MCX_SecurityParameters_GetExistingKey(p_SecurityParameters, CSK);
    var template (value) MIKEY_CommonHeader v_CommonHeader := cs_MIKEY_SAKKE_CommonHeader_EmptyMap(v_CSK.Id);
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var charstring v_PublicServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
    var charstring v_MCServiceId_User_A := f_MCX_MCService_ID_User_A(p_ServiceType);

    return fl_MIKEY_SAKKE_MessageTX_Common(p_SecurityParameters,
                                           v_TimestampSeconds,
                                           v_CommonHeader,
                                           v_CSK.Value,
                                           v_CSK.RAND,
                                           v_PublicServiceId,                  /* IDRi */
                                           v_MCServiceId_User_A,               /* IDRr */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmi */
                                           tsc_MCX_KMS_Hostname);              /* IDRksmr */
  }

  /*
   * @desc      Common function to build up template to receive MIKEY message from the client
   * @param     p_ServiceType
   * @param     p_CsbId
   * @param     p_CsId
   * @param     p_InitiatorURI
   * @param     p_ResponderURI
   * @param     p_InitiatorKMSURI
   * @param     p_ResponderKMSURI
   * @param     p_FurtherPayloads   (default value: {})
   * @return    template (present) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function fl_MIKEY_SAKKE_MessageRX_Common(MCX_ServiceType_Type p_ServiceType,
                                           template (present) B32_Type p_CsbId,
                                           template (present) O1_Type p_CsId,
                                           charstring p_InitiatorURI,
                                           charstring p_ResponderURI,
                                           charstring p_InitiatorKMSURI,
                                           charstring p_ResponderKMSURI,
                                           template (present) MIKEY_PayloadList p_FurtherPayloads := {}) return template (present) MIKEY_Message
  {
    var template (present) MIKEY_CommonHeader v_CommonHeader;
    var template (present) MIKEY_PayloadList v_PayloadList;

    select (p_ServiceType) {
      case (MCPTT, MCVideo) {
        v_CommonHeader := (cr_MIKEY_SAKKE_CommonHeader_EmptyMap(p_CsbId),                                        // either header payload with empty map (=> defualt policy) ...
                           cdr_MIKEY_SAKKE_CommonHeader_GenericMap(p_CsbId, cr_MIKEY_GenericIdMapType(p_CsId))); // ... or with GENERIC map (=> explicit policy in GenericIdMap and SP payload (to be checked in f_MIKEY_SAKKE_MessageCheckSecurityPolicies)
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_CommonHeader := cr_MIKEY_SAKKE_CommonHeader_EmptyMap(p_CsbId);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    v_PayloadList := {
      cr_MIKEY_GenericPayload(cr_MIKEY_Timestamp_Payload),
      cr_MIKEY_GenericPayload(cr_MIKEY_RAND_Payload),
      cr_MIKEY_GenericPayload(cr_MIKEY_IDR_URI_Payload(tsc_MIKEY_IDR_Role_IDRi,    p_InitiatorURI)),    /* Initiator (IDRi) */
      cr_MIKEY_GenericPayload(cr_MIKEY_IDR_URI_Payload(tsc_MIKEY_IDR_Role_IDRr,    p_ResponderURI)),    /* Responder (IDRr) */
      cr_MIKEY_GenericPayload(cr_MIKEY_IDR_URI_Payload(tsc_MIKEY_IDR_Role_IDRkmsi, p_InitiatorKMSURI)), /* Initiator's KMS (IDRkmsi) */
      cr_MIKEY_GenericPayload(cr_MIKEY_IDR_URI_Payload(tsc_MIKEY_IDR_Role_IDRkmsr, p_ResponderKMSURI)), /* Responder's KMS (IDRkmsr) */
      cr_MIKEY_GenericPayload(cr_MIKEY_SAKKE_Payload)
      /* SP payload is checked in f_MIKEY_SAKKE_MessageCheckSecurityPolicies */
    };

    v_PayloadList := v_PayloadList & p_FurtherPayloads;
    v_PayloadList := superset(all from v_PayloadList);

    return cr_MIKEY_Message(v_CommonHeader, v_PayloadList, cr_MIKEY_Signature_ECCSI);
  }

  /*
   * @desc      Table 5.5.9.1-1: MIKEY-SAKKE I_MESSAGE (CSK distribution)
   * @param     p_ServiceType
   * @param     p_IDRr
   * @return    template (present) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageRX_CSK(MCX_ServiceType_Type p_ServiceType,
                                       charstring p_IDRr) return template (present) MIKEY_Message
  {
    var template (present) B32_Type v_CSK_Id := cr_MIKEY_SAKKE_CSB_ID(tsc_MCX_KeyId_PurposeCSK);
    var template (present) O1_Type v_CsId;
    var charstring v_IDRi := f_MCX_MCService_ID_User_A(p_ServiceType);

    select (p_ServiceType) {
      case (MCPTT) {
        v_CsId := '06'O;      // Table 5.5.9.1-1; 33.180 Table E.1.3-1: CS-ID assignment
      }
      case (MCVideo) {
        v_CsId := '08'O;      // Table 5.5.9.1-1; 33.180 Table E.1.3-1: CS-ID assignment
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_CsId := ?;          // there is nothing specified for MCData (yet)
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }

    return fl_MIKEY_SAKKE_MessageRX_Common(p_ServiceType,
                                           v_CSK_Id,
                                           v_CsId,
                                           v_IDRi,                             /* IDRi */
                                           p_IDRr,                             /* IDRr */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmi */
                                           tsc_MCX_KMS_Hostname);              /* IDRksmr */
  }

  /*
   * @desc      Table 5.5.9.1-2A: MIKEY-SAKKE I_MESSAGE (Private call)
   * @param     p_ServiceType
   * @param     p_CsId              (default value: ?)
   * @return    template (present) MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageRX_PrivateCall(MCX_ServiceType_Type p_ServiceType,
                                               template (present) O1_Type p_CsId := ?) return template (present) MIKEY_Message
  {
    var template (present) B32_Type v_PCK_Id := cr_MIKEY_SAKKE_CSB_ID(tsc_MCX_KeyId_PurposePCK);
    var charstring v_MCServiceId_User_A := f_MCX_MCService_ID_User_A(p_ServiceType);
    var charstring v_MCServiceId_User_B := f_MCX_MCService_ID_User_B(p_ServiceType);

    return fl_MIKEY_SAKKE_MessageRX_Common(p_ServiceType,
                                           v_PCK_Id,
                                           p_CsId,
                                           v_MCServiceId_User_A,               /* IDRi */
                                           v_MCServiceId_User_B,               /* IDRr */
                                           tsc_MCX_KMS_Hostname,               /* IDRksmi */
                                           tsc_MCX_KMS_Hostname);              /* IDRksmr */
  }

  /*
   * @desc      validate signature according to RFC 3830 clause 5.3 using algorithms according to RFC 6507 clause 5.2.2
   * @param     p_SecurityParameters
   * @param     p_MIKEY_Message
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_Signature_Validate(MCX_SecurityParameters_Type p_SecurityParameters,
                                            MIKEY_Message p_MIKEY_Message) return boolean
  {
    var MIKEY_Message v_MIKEY_Message := p_MIKEY_Message;
    var charstring v_IDRiURI := f_MIKEY_Message_GetIDRIdentity(v_MIKEY_Message, tsc_MIKEY_IDR_Role_IDRi);   // Initiator's URI
    var octetstring v_UID := f_MCX_SecurityParameters_GetUID(p_SecurityParameters, v_IDRiURI);
    var octetstring v_Signature := p_MIKEY_Message.sign.s;
    var octetstring v_Message;

    v_MIKEY_Message.sign.s := ''O;                      /* RFC 3830 clause 5.2: "Calculate the MAC/signature over the entire MIKEY message, except the MAC/Signature field, and add the MAC/signature in the field"
                                                           According to clause 6.5 the MAC/Signature field is the field of the Signature payload.
                                                           => generation of the signature includes the Signature payload's type and length field */
                                                           
    v_Message := bit2oct(encvalue(v_MIKEY_Message));

    return fx_ECCSI_VerifySignature(v_Message,
                                    v_Signature,
                                    p_SecurityParameters.ECCSI.KPAK,
                                    v_UID);
  }

  /*
   * @desc      Check consistency of Security Policies
   * @param     p_Message
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_SAKKE_MessageCheckSecurityPolicies(MIKEY_Message p_Message) return boolean
  {
    var integer v_NoOfCryptoSessions := oct2int(p_Message.commonHdr.numberCS);
    var B4_Type v_KeyIdPurpose := substr(p_Message.commonHdr.csbId, 0, 4);
    var O1_Type v_SecurityPolicyId;
    var template (omit) MIKEY_GenericPayload v_SecurityPolicy;
    var template (present) MIKEY_PolicyParams v_PolicyParams := ?;
    var boolean v_Result := true;

    if (v_NoOfCryptoSessions > 0) {
      v_SecurityPolicyId := p_Message.commonHdr.csIdMapInfo.GENERIC.ps[0];

      select (v_KeyIdPurpose) {
        case (tsc_MCX_KeyId_PurposePCK) { v_PolicyParams := cr_MIKEY_PolicyParams_PrivateCall; }
        case (tsc_MCX_KeyId_PurposeCSK) { v_PolicyParams := cr_MIKEY_PolicyParams_CSK; }
      }
      v_SecurityPolicy := fl_MIKEY_Message_FindPayload(p_Message, cr_MIKEY_SecurityPolicy_SRTP_Payload(v_SecurityPolicyId, v_PolicyParams));
      v_Result := isvalue(v_SecurityPolicy);
    }
    return v_Result;
  }

  /*
   * @desc      Decode MIKEY message
   * @param     p_EncodedMikeyMsg
   * @return    MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MIKEY_Message_Decode(charstring p_EncodedMikeyMsg) return MIKEY_Message
  {
    var bitstring v_Bitstring;
    var MIKEY_Message v_MIKEY_Message;

    v_Bitstring := f_Base64Decode(p_EncodedMikeyMsg);     // according to RFC 3830 clause 10.1 "Encoding Considerations : binary, base64 encoded"
    if (decvalue(v_Bitstring, v_MIKEY_Message) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MIKEY_Message");
    }
    return v_MIKEY_Message;
  }

  /*
   * @desc      Decode and match MIKEY message
   * @param     p_MikeyMsg
   * @param     p_MIKEY_Message
   * @param     p_KeyParametersPayload (default value: *)
   * @return    MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIKEY_DecodeMatchAndCheckMikeyMessage(charstring p_MikeyMsg,
                                                       template (present) MIKEY_Message p_MIKEY_Message,
                                                       template MCX_KeyParametersPayload_Type p_KeyParametersPayload := *) runs on MCX_IMS_PTC return MIKEY_Message
  { // NOTE: MIKEY_Message is assumed to be mandatory present in the MIME message
    var MCX_SecurityParameters_Type v_SecurityParameters := f_MCX_IMS_PTC_SecurityParameters_Get();
    var MIKEY_Message v_MIKEY_Message := f_MIKEY_Message_Decode(p_MikeyMsg);
    var MCX_KeyParametersPayload_Type v_KeyParametersPayload;
    var bitstring v_Bitstring;
    var integer i;

    if (not match(v_MIKEY_Message, p_MIKEY_Message)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid MIKEY_Message in MIME body");
    }

    for (i := 0; i < lengthof(v_MIKEY_Message.payloads); i := i + 1) {
      if (ischosen(v_MIKEY_Message.payloads[i].content.Extension)) {
        v_Bitstring := oct2bit(v_MIKEY_Message.payloads[i].content.Extension.extData);
        if (decvalue(v_Bitstring, v_KeyParametersPayload) != 0) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Can not decode key parameters");
        }
        if (not match(v_KeyParametersPayload, p_KeyParametersPayload)) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid key parameters");
        }
      }
    }
    if (not f_MIKEY_SAKKE_Signature_Validate(v_SecurityParameters, v_MIKEY_Message)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Cannot validate signature");
    }
    if (not f_MIKEY_SAKKE_MessageCheckSecurityPolicies(v_MIKEY_Message)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid security policy");
    }

    return v_MIKEY_Message;
  }

  /*
   * @desc      Extract Key from MIKEY message
   * @param     p_MIKEY_Message
   * @return    MCX_SecurityKey_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIKEY_Message_ExtractKey(MIKEY_Message p_MIKEY_Message) runs on MCX_IMS_PTC return MCX_SecurityKey_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := f_MCX_IMS_PTC_SecurityParameters_Get();
    var B32_Type v_CSB_Id := p_MIKEY_Message.commonHdr.csbId;
    var charstring v_IDRrURI := f_MIKEY_Message_GetIDRIdentity(p_MIKEY_Message, tsc_MIKEY_IDR_Role_IDRr);
    var octetstring v_SakkeData := f_MIKEY_Message_GetSAKKEData(p_MIKEY_Message);
    var template (omit) MCX_SecurityKey_Type v_Key := f_MCX_SecurityParameters_ExtractKeyFromSakkeData(v_SecurityParameters, v_IDRrURI, v_CSB_Id, v_SakkeData);
    if (not isvalue(v_Key)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Key is not validated");
    } else {
      v_Key.RAND := f_MIKEY_Message_GetRAND(p_MIKEY_Message);
    }
    return valueof(v_Key);
  }

  /*
   * @desc      Encode MIKEY message
   * @param     p_ServiceType
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_EncodedMikeyMessage(MCX_ServiceType_Type p_ServiceType) runs on MCX_IMS_PTC return bitstring
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := f_MCX_IMS_PTC_SecurityParameters_Get();
    var template (value) MIKEY_Message v_MIKEY_Message := f_MIKEY_SAKKE_MessageTX_PrivateCall(p_ServiceType, v_SecurityParameters);
    return encvalue(v_MIKEY_Message);
  }

}
