  template (value) RACH_ConfigCommon_Type cs_RACH_ConfigCommon_r8(template (value) RACH_ConfigCommon p_RACH_ConfigCommon) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    R8andLater := {
      rach_ConfigCommon := p_RACH_ConfigCommon,
      rach_ConfigCommon_v1250 := omit
