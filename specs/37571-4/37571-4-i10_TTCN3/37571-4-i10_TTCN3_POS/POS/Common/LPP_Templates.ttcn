    sensor_ProvideCapabilities_r13 := p_Sensor_ProvideCapabilities, /* @sic R5s160713 BASELINE MOVING 2016 sic@ */
    tbs_ProvideCapabilities_r13 := p_TBS_ProvideCapabilities, /* @sic R5s160713 BASELINE MOVING 2016 sic@ */
    wlan_ProvideCapabilities_r13:= p_WLAN_ProvideCapabilities, /* @sic R5s160713 BASELINE MOVING 2016 sic@ */
    bt_ProvideCapabilities_r13:= p_BT_ProvideCapabilities, /* @sic R5s160713 BASELINE MOVING 2016 sic@ */
    nr_ECID_ProvideCapabilities_r16 := *, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
    nr_Multi_RTT_ProvideCapabilities_r16 := *, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
