module NR_ASP_Templates_RB_Config {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_PDCP_Templates all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_Templates all;
  import from SDAP_TypeDefs all;
  import from TestcaseProperties all;

  const integer tsc_NR_SRB0_LogicalChannelPriority := 1;            /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_NR_SRB1_LogicalChannelPriority := 1;            /* Acc to 38.331 cl 9.2.1    @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_NR_SRB2_LogicalChannelPriority := 3;            /* Acc to 38.331 cl 9.2.1    @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_NR_SRB3_LogicalChannelPriority := 1;            /* Acc to 38.331 cl 9.2.1    @status    APPROVED (ENDC, NR5GC) */

  const NR_LogicalChannelId_Type tsc_NR_SRB1_LogicalChannelId := 1; /* Acc to 38.331 cl 9.2.1    @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_LogicalChannelId_Type tsc_NR_SRB2_LogicalChannelId := 2; /* Acc to 38.331 cl 9.2.1    @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_None := { None := true };   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_NotACK_NextRLC_PDU := { Info :=  cs_NR_RLC_NotACK_NextRlcPdu}; /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_TestModeInfo_Type cs_NR_RLC_NotACK_NextRlcPdu := { NotACK_NextRLC_PDU := Start }; /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_AckProhibit(NR_RLC_ACK_Prohibit_Type p_NR_RLC_ACK_Prohibit_Type) := { Info :=  cs_NR_RLC_AckProhibit(p_NR_RLC_ACK_Prohibit_Type)};  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_TestModeInfo_Type cs_NR_RLC_AckProhibit(NR_RLC_ACK_Prohibit_Type p_NR_RLC_ACK_Prohibit_Type) := { AckProhibit := p_NR_RLC_ACK_Prohibit_Type };  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_MAC_TestModeConfig_Type cs_NR_MAC_TestModeConfig_None := { None := true };   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_MAC_TestModeConfig_Type cs_NR_MAC_TestModeConfig(template (value) NR_MAC_TestModeInfo_Type p_TestModeInfo) := { Info := p_TestModeInfo }; /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_MAC_Configuration_Type cs_NR_SS_MAC_Configuration(template (omit) NR_MAC_TestModeConfig_Type p_TestModeConfig := cs_NR_MAC_TestModeConfig_None,
                                                                        integer p_Priority := 1) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    LogicalChannel := {
      Priority := p_Priority,
      PrioritizedBitRate := infinity_
    },
    TestMode := p_TestModeConfig
  };

  template (value) NR_RLC_Configuration_Type cs_NR_SS_RLC_Configuration_AM(template (omit) UL_AM_RLC p_ParametersTX,
                                                                           template (omit) DL_AM_RLC p_ParametersRX,
                                                                           template (omit) NR_RLC_TestModeConfig_Type p_TestModeConfig := cs_NR_RLC_TestModeConfig_None) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Rb := {
      AM := {
        Tx := {
          R15 := p_ParametersTX
        },
        Rx := {
          R15 := p_ParametersRX
        }
      }
    },
    TestMode := p_TestModeConfig
  };

  template (value) NR_RLC_Configuration_Type cs_NR_SS_RLC_Configuration_UM(template (omit) UL_UM_RLC p_ParametersTX,
                                                                           template (omit) DL_UM_RLC p_ParametersRX,
                                                                           template (omit) NR_RLC_TestModeConfig_Type p_TestModeConfig := cs_NR_RLC_TestModeConfig_None) :=
  {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT) */
    Rb := {
      UM := {
        Tx := {
          R15 := p_ParametersTX
        },
        Rx := {
          R15 := p_ParametersRX
        }
      }
    },
    TestMode := p_TestModeConfig
  };

  template (value) NR_RLC_Configuration_Type cs_NR_RLC_Configuration_TestMode(template (value) NR_RLC_TestModeConfig_Type p_TestModeConfig) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Rb := {
      TM := true
    },
    TestMode := p_TestModeConfig
  };

  template (value) NR_RlcBearerConfig_Type cs_NR_RlcBearerConfig_Common(template (value) NR_RLC_Configuration_Type p_RLC_Configuration,
                                                                        template (omit) NR_LogicalChannelId_Type p_LogicalChannelId,
                                                                        template (omit) NR_MAC_Configuration_Type p_MAC_Configuration := cs_NR_SS_MAC_Configuration) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Config := {
      Rlc := p_RLC_Configuration,
      LogicalChannelId := p_LogicalChannelId,
      Mac := p_MAC_Configuration,
      DiscardULData := omit
    }
  };

  template (value) NR_RlcBearerConfig_Type cs_NR_RlcBearerConfig_AM(boolean p_IsFR1,
                                                                    template (omit) NR_RLC_TestModeConfig_Type p_TestModeConfig := omit,
                                                                    template (omit) NR_LogicalChannelId_Type p_LogicalChannelId) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  //@sic R5s190109 change 8: added p_LogicalChannelId sic@
    cs_NR_RlcBearerConfig_Common(cs_NR_SS_RLC_Configuration_AM(f_NR_UL_AM_RLC(p_IsFR1), f_NR_DL_AM_RLC(p_IsFR1), p_TestModeConfig), p_LogicalChannelId);

  template (value) NR_RlcBearerConfig_Type cs_NR_RlcBearerConfig_UM(boolean p_IsFR1,
                                                                    template (omit) NR_RLC_TestModeConfig_Type p_TestModeConfig := omit,
                                                                    NR_LogicalChannelId_Type p_LogicalChannelId) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT) */
  //@sic R5s190109 change 8: added p_LogicalChannelId sic@
    cs_NR_RlcBearerConfig_Common(cs_NR_SS_RLC_Configuration_UM(f_NR_UL_UM_RLC(), f_NR_DL_UM_RLC(p_IsFR1), p_TestModeConfig), p_LogicalChannelId);

  template (value) SDAP_Configuration_Type cs_SDAP_Configuration(template (omit) integer          p_Pdu_SessionId := tsc_NR_PDU_SessionID_Def,
                                                                 template (omit) SDAP_Header_Type p_Sdap_HeaderDL := Absent,
                                                                 template (omit) SDAP_Header_Type p_Sdap_HeaderUL := Present,
                                                                 template (omit) QFI_List_Type    p_MappedQoS_FlowsToAdd := omit) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Config := {
      SdapConfig := {
        Pdu_SessionId := p_Pdu_SessionId,
        Sdap_HeaderDL := p_Sdap_HeaderDL,
        Sdap_HeaderUL := p_Sdap_HeaderUL,
        MappedQoS_Flows := p_MappedQoS_FlowsToAdd
      }
    }
  };

  template (value) SDAP_Configuration_Type cs_SDAP_Configuration_None := { None := true };   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_CommonRadioBearerConfig_REQ(NR_CellId_Type p_NR_CellId,
                                                                         template (value) TimingInfo_Type p_TimingInfo,
                                                                         template (value) NR_RadioBearerList_Type p_RadioBearerList,
                                                                         template (omit) boolean p_CnfFlag := omit,
                                                                         boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                                                         ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-206369: added p_FollowOnFlag sic@
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo, p_CnfFlag, p_FollowOnFlag),
    Request := {
      RadioBearerList := p_RadioBearerList
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_CommonRadioBearerConfig_CNF(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      RadioBearerList := true
    }
  };

  template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_Config(template (value) NR_RadioBearerId_Type p_RB,
                                                                   template (omit)  NR_PDCP_Configuration_Type p_PDCP_Configuration := omit,
                                                                   template (omit)  NR_RlcBearerConfig_Type p_RlcBearerConfig := omit,
                                                                   template (omit)  SDAP_Configuration_Type p_Sdap := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Id := p_RB,
    Config := {
      AddOrReconfigure := {
        Sdap := p_Sdap,
        Pdcp := p_PDCP_Configuration,
        RlcBearer := p_RlcBearerConfig
      }
    }
  };

  /*
   * @desc      Returns SDAP Configuration
   * @return    template (omit) SDAP_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
   function fl_SDAP_Configuration_TestMode() return template (omit) SDAP_Configuration_Type
  {
    var template (omit) SDAP_Configuration_Type v_SDAP_Configuration := omit;
    if (not f_GetTestcaseAttrib_ENDC(testcasename())) {
      v_SDAP_Configuration := cs_SDAP_Configuration_None;
    }
    return v_SDAP_Configuration;
  }

  template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_AM(SN_FieldLengthAM p_FieldLengthAM := size18) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Info := {
      TransparentMode := {
        Amd := p_FieldLengthAM
      }
    }
  };

  template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_UM(SN_FieldLengthUM p_SN_FieldLengthUM := size12) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Info := {
      TransparentMode := {
        Umd := p_SN_FieldLengthUM
      }
    }
  };

  template (value) NR_RadioBearer_Type cs_NR_SS_DRB_Config(DRB_Identity p_DrbId,
                                                           template (omit)  NR_PDCP_Configuration_Type p_PDCP_Configuration := omit,
                                                           template (omit)  NR_RlcBearerConfig_Type p_RlcBearerConfig := omit,
                                                           template (omit)  SDAP_Configuration_Type p_Sdap := omit) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SS_RadioBearer_Config(cs_NR_RadioBearerId_DRB(p_DrbId), p_PDCP_Configuration, p_RlcBearerConfig, p_Sdap);

  template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_RlcBearer_TestMode(DRB_Identity p_DrbId,
                                                                              template (value) NR_RLC_TestModeConfig_Type p_RLC_TestModeConfig,
                                                                              template (omit) NR_MAC_TestModeConfig_Type p_MAC_TestModeConfig := cs_NR_MAC_TestModeConfig_None) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_NR_SS_DRB_Config(p_DrbId,
                        cs_NR_PDCP_Configuration_None,
                        cs_NR_RlcBearerConfig_Common(cs_NR_RLC_Configuration_TestMode(p_RLC_TestModeConfig), f_NR_LogicalChannelId_DRB(p_DrbId), cs_NR_SS_MAC_Configuration(p_MAC_TestModeConfig)),
                        fl_SDAP_Configuration_TestMode());

  template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_Release(template (value) NR_RadioBearerId_Type p_Id) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Id := p_Id,
    Config := {
      Release := true
    }
  };

  template (value) NR_RadioBearer_Type cs_NR_SS_DRB_Release(DRB_Identity p_DrbId) := cs_NR_SS_RadioBearer_Release(cs_NR_RadioBearerId_DRB(p_DrbId));   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RlcBearerConfig_Type cs_NR_RlcBearerConfig_SRB0 :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Config := {
      Rlc := {
        Rb := { TM := true},
        TestMode := cs_NR_RLC_TestModeConfig_None
      },
      LogicalChannelId := omit,     // @sic R5w190011r1: omit sic@
      Mac := cs_NR_SS_MAC_Configuration(-, tsc_NR_SRB0_LogicalChannelPriority),
      DiscardULData := omit
    }
  };

template (value) NR_RlcBearerConfig_Type cs_NR_RlcBearerConfig_SRB1SRB2SRB3(NR_LogicalChannelId_Type p_LogicalChannelId,
                                                                            integer p_LogicalChannelPriority,
                                                                            template (omit) NR_RLC_TestModeConfig_Type p_TestModeConfig := cs_NR_RLC_TestModeConfig_None,    //@sic R5s210283 Ch. 2 sic@
                                                                            T_PollRetransmit p_T_PollRetransmit := ms45
                                                                            ) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  //@sic R5s250100 R5-253086: added p_T_PollRetransmit sic@
    cs_NR_RlcBearerConfig_Common(cs_NR_SS_RLC_Configuration_AM(cs_38508_UL_RLC_SRB(p_T_PollRetransmit), cs_38508_DL_RLC_SRB, p_TestModeConfig),
                                 p_LogicalChannelId,
                                 cs_NR_SS_MAC_Configuration(-, p_LogicalChannelPriority));

  template (value) NR_RadioBearer_Type cs_NR_SS_SRB0_Config :=
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB0,
                                cs_NR_PDCP_Configuration_None,
                                cs_NR_RlcBearerConfig_SRB0,
                                cs_SDAP_Configuration_None);

  template (value) NR_RadioBearer_Type cs_NR_SS_SRB1_Config(T_PollRetransmit p_T_PollRetransmit := ms45) :=
    //Acc to 38.331 cl 9.2.1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s250100 R5-253086: added p_T_PollRetransmit sic@
    cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB1,
                                cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsSRB),
                                cs_NR_RlcBearerConfig_SRB1SRB2SRB3(tsc_NR_SRB1_LogicalChannelId, tsc_NR_SRB1_LogicalChannelPriority, -, p_T_PollRetransmit),
                                cs_SDAP_Configuration_None);

  template (value) NR_RadioBearer_Type cs_NR_SS_SRB2_Config(T_PollRetransmit p_T_PollRetransmit := ms45) :=
    //Acc to 38.331 cl 9.2.1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s250100 R5-253086: added p_T_PollRetransmit sic@
    cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB2,
                                cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsSRB),
                                cs_NR_RlcBearerConfig_SRB1SRB2SRB3(tsc_NR_SRB2_LogicalChannelId, tsc_NR_SRB2_LogicalChannelPriority, -, p_T_PollRetransmit),
                                cs_SDAP_Configuration_None);

  template (value) NR_RadioBearer_Type cs_NR_SS_SRB3_Config(template (omit)  SDAP_Configuration_Type p_Sdap := omit) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s211168: added p_Sdap sic@
    cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB3,
                                cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsSRB),
                                cs_NR_RlcBearerConfig_SRB1SRB2SRB3(f_NR_LogicalChannelId_SRB(tsc_SRB3), tsc_NR_SRB3_LogicalChannelPriority),
                                p_Sdap
                                );

  template (value) NR_RadioBearer_Type cs_NR_SS_ReConfig_NotACK_NextRLC_PDU_DRB( template (value) NR_RadioBearerId_Type p_RB,
                                                                                 boolean p_IsFR1) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_NR_SS_RadioBearer_Config(p_RB,
                                omit,
                                cs_NR_RlcBearerConfig_Common(cs_NR_SS_RLC_Configuration_AM(f_NR_UL_AM_RLC(p_IsFR1), f_NR_DL_AM_RLC(p_IsFR1), cs_NR_RLC_TestModeConfig_NotACK_NextRLC_PDU),
                                                             omit,
                                                             omit),
                                omit);

  template (value) NR_RadioBearer_Type cs_NR_SS_SRB_ReConfig_AckProhibit ( template (value) NR_RadioBearerId_Type p_RB,
                                                                           NR_RLC_ACK_Prohibit_Type p_NR_RLC_ACK_Prohibit_Type
                                                                           ):=
    /* @status    APPROVED (NR5GC) */
    cs_NR_SS_RadioBearer_Config(p_RB,
                                omit,
                                cs_NR_RlcBearerConfig_Common(cs_NR_SS_RLC_Configuration_AM(cs_38508_UL_RLC_SRB, cs_38508_DL_RLC_SRB, cs_NR_RLC_TestModeConfig_AckProhibit(p_NR_RLC_ACK_Prohibit_Type)),
                                                             omit,
                                                             omit
                                                             ),
                                omit);

  template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_AM_Test(DRB_Identity p_DrbId,
                                                                    SN_FieldLengthAM p_FieldLengthAM := size18) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_NR_SS_RadioBearer_RlcBearer_TestMode(p_DrbId, cs_NR_RLC_TestModeConfig_AM(p_FieldLengthAM));

  template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_UM_Test(DRB_Identity p_DrbId,
                                                                    SN_FieldLengthUM p_SN_FieldLengthUM := size12) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_NR_SS_RadioBearer_RlcBearer_TestMode(p_DrbId, cs_NR_RLC_TestModeConfig_UM(p_SN_FieldLengthUM));

}
