  template (value) NPRACH_Parameters_NB_r13 cs_NPRACH_Parameters_Default(NPRACH_Parameters_NB_r13.nprach_Periodicity_r13 p_Periodicity := ms80,
                                                                         NPRACH_Parameters_NB_r13.nprach_StartTime_r13 p_StartTime := ms32,
                                                                         NPRACH_Parameters_NB_r13.nprach_SubcarrierOffset_r13 p_SubcarrierOffset := n12,
