   */
  function f_EUTRA_MobileInfo_GetPdnTypeToBeUsed() runs on EUTRA_PTC return PDN_TypeToBeUsed_Type
  {
    return vc_EUTRA_Global.MobileInfo.PdnInfo.PdnTypeToBeUsed;
  }

