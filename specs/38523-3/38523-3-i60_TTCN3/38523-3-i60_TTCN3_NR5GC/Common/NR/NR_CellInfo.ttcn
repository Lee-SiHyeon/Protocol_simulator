  /*
   * @desc      Set SIB3 in the cell
   * @param     p_NR_CellId
   * @param     p_Sib3
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_CellInfo_SetSIB3(NR_CellId_Type p_NR_CellId,
                                    template (value) SIB3 p_Sib3) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    select (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination) {
      case (NR_3, NR_5) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIs[1].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib3 := valueof(p_Sib3);  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
        f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
      }
    }
  }

