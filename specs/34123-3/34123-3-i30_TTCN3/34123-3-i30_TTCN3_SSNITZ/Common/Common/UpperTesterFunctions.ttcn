  template (value) Ut_Parameter_Type cs_Ut_Parameter_NITZ_TimeZone(charstring p_Value) := cs_Ut_Parameter_Common("TimeZone: ", p_Value);                        /* @status    APPROVED (LTE, NR5GC, SSNITZ) */

