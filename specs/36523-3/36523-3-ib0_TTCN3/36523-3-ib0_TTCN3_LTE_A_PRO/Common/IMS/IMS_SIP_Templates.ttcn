  template (present) Addr_Union cr_Addr_Union_NameAddr(template (present) SipUrl p_SipUrl,
                                                       template DisplayName p_DisplayName := *) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    nameAddr := cr_NameAddr(p_DisplayName, p_SipUrl)
  };

  template (present) Addr_Union cr_Addr_Union_AddrSpecUnion(template (present) SipUrl p_SipUrl) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    addrSpecUnion := p_SipUrl
  };

  /*
   * @desc      return 'Addr_Union' to be used in receive templates
   * @param     p_SipUrl
   * @param     p_DisplayName       (default value: *)
   * @return    template (present) Addr_Union
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_Addr_Union_RX(template (present) SipUrl p_SipUrl,
                           template DisplayName p_DisplayName := *) return template (present) Addr_Union
  {
    var template (present) Addr_Union v_Addr_Union;

    if (ispresent(p_DisplayName)) {
      v_Addr_Union := cr_Addr_Union_NameAddr(p_SipUrl, p_DisplayName);
    } else {
      v_Addr_Union := (cr_Addr_Union_NameAddr(p_SipUrl, p_DisplayName), cr_Addr_Union_AddrSpecUnion(p_SipUrl));
    }
    return v_Addr_Union;
  }

  /*
   * @desc      get SipUrl from 'Addr_Union' union
   * @param     p_Addr_Union
   * @return    SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_Addr_Union_GetSipUrl(template (omit) Addr_Union p_Addr_Union) return SipUrl
  {
    var SipUrl v_SipUrl;

    if (ischosen(p_Addr_Union.addrSpecUnion)) {
      v_SipUrl := valueof(p_Addr_Union.addrSpecUnion);
    } else {
      v_SipUrl := valueof(p_Addr_Union.nameAddr.addrSpec);
    }
    return v_SipUrl;
  }

  template (present) Authorization cr_Authorization(template (present) CommaParam_List p_DigestResponse) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    fieldName := AUTHORIZATION_E,
    body := {
      {
        digestResponse := p_DigestResponse
      }
    }
  };

  /*
   * @desc      returns receive template of Authorization header
   * @param     p_UserName
   * @param     p_Realm
   * @param     p_Uri
   * @param     p_Nonce             (default value: cr_GenValue_None)
   * @param     p_Response          (default value: cr_GenValue_None)
   * @param     p_FurtherMandatoryParameters (default value: {})
   * @return    template (present)  Authorization
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_AuthorizationCommon(charstring p_UserName,
                                 charstring p_Realm,
                                 template (present) charstring p_Uri,
                                 template GenValue p_Nonce := cr_GenValue_None,
                                 template GenValue p_Response := cr_GenValue_None,
                                 template (present) CommaParam_List p_FurtherMandatoryParameters := {}) return template (present)  Authorization
  {
    var integer i;
    var template (present) CommaParam_List v_DigestResponse := {
      cr_GenericParam("username", p_UserName),
      cr_GenericParam("realm", p_Realm),
      cr_GenericParam_Common("nonce", p_Nonce),
      cr_GenericParam("uri", p_Uri),
      cr_GenericParam_Common("response", p_Response)
    };
    for (i := 0; i < lengthof(p_FurtherMandatoryParameters); i := i + 1) {
      v_DigestResponse := f_CommaParam_List_Add_RX(v_DigestResponse, p_FurtherMandatoryParameters[i]);
    }
    return cr_Authorization(superset(all from v_DigestResponse));
  }

  /*
   * @desc      returns receive template of Authorization header in subsequent REGISTER message
   * @param     p_UserName
   * @param     p_Realm
   * @param     p_Nonce
   * @param     p_Uri
   * @param     p_Algorithm
   * @param     p_Nc                (default value: "00000001")
   * @param     p_Opaque            (default value: tsc_IMS_Opaque)
   * @return    template (present) Authorization
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_AuthorizationSubsequent(charstring p_UserName,
                                     charstring p_Realm,
                                     charstring p_Nonce,
                                     template (present) charstring p_Uri,
                                     charstring p_Algorithm,
                                     template (present) charstring p_Nc := "00000001",
                                     template charstring p_Opaque := tsc_IMS_Opaque) return template (present) Authorization
  {
    var charstring v_Qop := "auth";
    var template (present) charstring v_Cnonce := ?;
    var template (present) charstring v_Response := pattern "?+";
    var template (present) CommaParam_List v_FurtherMandatoryParameters := {
      cr_GenericParam("qop",      v_Qop),
      cr_GenericParam("cnonce",   v_Cnonce),
      cr_GenericParam("nc",       p_Nc),
      cr_GenericParam("algorithm", p_Algorithm)
    };
    if (ispresent(p_Opaque)) {
      v_FurtherMandatoryParameters := f_CommaParam_List_Add_RX(v_FurtherMandatoryParameters, cr_GenericParam("opaque", p_Opaque)); // compiler warning may be ignored due to check
    }
    return f_AuthorizationCommon(p_UserName, p_Realm, p_Uri, cr_GenValue(p_Nonce), cr_GenValue(v_Response), v_FurtherMandatoryParameters);
  }

