    denyMessage := {
      commonHdr := cs_FloorControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00011'B, p_AckRequest), p_RTCP_SSRC_SS),        // Deny subtype 24.380 clause 8.2.2.1
      rejectCause := fl_FloorControl_RejectCause(p_RejectCause, p_Reason),
      userId := omit,
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator(p_FloorInd)
    }
  };

  template (present) FloorControlMsg_Type cr_FloorCtrlMsg_Release(template (present) RTP_SSRC p_RTCP_SSRC_UE,
                                                                  template (present) B16_Type p_FloorInd) :=
  { // 36.579-1 clause 5.5.6.5
    /* @status    APPROVED (MCX) */
    releaseMessage := {
      commonHdr := cr_FloorControl_CommonHdr('?0100'B, p_RTCP_SSRC_UE),         // Release subtype 24.380 clause 8.2.2.1
      userId := omit,
      trackInfo := omit,
      floorIndicator := cr_FloorControl_FloorIndicator(p_FloorInd)
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Idle(RTP_SSRC p_RTCP_SSRC_SS,
                                                             integer p_MsgSeqNum,
                                                             B16_Type p_FloorInd,
                                                             MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) :=
  { // 36.579-1 Table 5.5.6.6-1
    /* @status    APPROVED (MCX) */
    idleMessage := {
      commonHdr := cs_FloorControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00101'B, p_AckRequest), p_RTCP_SSRC_SS),        // Idle subtype 24.380 clause 8.2.2.1
      msgSeqNum := cs_FloorControl_MsgSeqNum(p_MsgSeqNum),
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator(p_FloorInd)
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Taken(RTP_SSRC p_RTCP_SSRC_SS,
                                                              integer p_MsgSeqNum,
                                                              B16_Type p_FloorInd,
                                                              O2_Type p_PermissionToRequest,
                                                              MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) :=
  { // 36.579-1 Table 5.5.6.7-1
    /* @status    APPROVED (MCX) */
    takenMessage := {
      commonHdr := cs_FloorControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00010'B, p_AckRequest), p_RTCP_SSRC_SS),        // Taken subtype 24.380 clause 8.2.2.1
      grantedPartysId := fl_FloorControl_GrantedPartysId(px_MCPTT_ID_User_B),
      permissionToRequest := cs_FloorControl_PermissionToRequest(p_PermissionToRequest),
      userId := omit,
      msgSeqNum := cs_FloorControl_MsgSeqNum(p_MsgSeqNum),
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator(p_FloorInd),
      ssrcGrantedParticipant := cs_FloorControl_SSRC(tsc_MCX_MediaSSRC_ClientB),   // Audio SSRC of a remote client (Client B)
      functionalAlias := omit,                  // Rel-15
      grantedUsers := omit,                     // Rel-15
      ssrcsGrantedParticipants := omit,         // Rel-15
      functionalAliases := omit,                // Rel-15
      location := cs_FloorControl_Location_Def, // Rel-15
      locations := omit                         // Rel-15
    }
  };

  template (value) FloorControlMsg_Type cds_FloorCtrlMsg_Taken_MultiTalker(RTP_SSRC p_RTCP_SSRC_SS,
                                                                           integer p_MsgSeqNum,
                                                                           B16_Type p_FloorInd,
                                                                           O2_Type p_PermissionToRequest,
                                                                           MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED)
    modifies cs_FloorCtrlMsg_Taken :=
  { // 36.579-1 Table 5.5.6.7-1
    /* @status    APPROVED (MCX) */
    takenMessage := {
      grantedPartysId := omit,
      ssrcGrantedParticipant := omit,
      grantedUsers := fl_FloorControl_ListOfGrantedUsersTX( { px_MCPTT_ID_User_A, px_MCPTT_ID_User_B } ),
      ssrcsGrantedParticipants := cs_FloorControl_ListOfSSRCs( { tsc_MCX_MediaSSRC_ClientA, tsc_MCX_MediaSSRC_ClientB } ),
      location := omit,
      locations := fl_FloorControl_ListOfLocationsTX()
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Revoke(RTP_SSRC p_RTCP_SSRC_SS,
                                                               O2_Type p_RejectCause,
