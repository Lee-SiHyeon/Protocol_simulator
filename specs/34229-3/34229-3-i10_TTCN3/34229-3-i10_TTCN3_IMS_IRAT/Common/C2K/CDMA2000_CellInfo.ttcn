module CDMA2000_CellInfo {

  import from CDMA2000_ASP_TypeDefs all;

  type record CDMA2000_CommonCellInfo_Type {            /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    CDMA2000_CellParameters_Type     CommonCellParams
  };

  type record CDMA2000_ReferenceCellPower_Type {        /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    CDMA2000_AbsoluteCellPower_Type  CellPower,
    CDMA2000_Attenuation_Type        CellAttenuation
  };

  type record CDMA2000_CellInfo_Type {                  /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    CDMA2000_CommonCellInfo_Type     CommonCellInfo,
    CDMA2000_ReferenceCellPower_Type ReferenceCellPower,
    ModeSpecificCellParams_Type      ModeSpecificParams
  };

  type record length (tsc_CDMA2000_MaxNumberOfCells) of CDMA2000_CellInfo_Type CDMA2000_CellArray_Type;    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

}
