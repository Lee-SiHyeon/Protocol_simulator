                   eutra_5GC_HO_ToNR_FDD_FR2_r15    := *,
                   eutra_5GC_HO_ToNR_TDD_FR2_r15    := *,
                   eutra_EPC_HO_ToNR_FDD_FR1_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
