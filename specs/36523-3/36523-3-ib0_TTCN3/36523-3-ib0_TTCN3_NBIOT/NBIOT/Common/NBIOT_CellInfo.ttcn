  {//@sic R5s240168 add comments sic@
    var template (value) NBIOT_CellInfo_Type v_CellInfo := f_NBIOT_CellInfo_Get(p_CellId);
    var integer v_Index := f_NBIOT_CellInfo_Get_SI_Index(valueof(v_CellInfo.Sysinfo.Combination), 22);
    v_CellInfo.Sysinfo.BCCH_Info.SIs[v_Index].message_.c1.systemInformation_r13.criticalExtensions.systemInformation_r13.sib_TypeAndInfo_r13[0].sib22_v1430 := p_SIB22;
