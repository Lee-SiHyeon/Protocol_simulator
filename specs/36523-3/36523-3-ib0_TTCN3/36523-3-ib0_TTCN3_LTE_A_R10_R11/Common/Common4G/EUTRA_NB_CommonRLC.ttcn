  template (value) RLC_SDU_Type   cs_MBMS_Packet4   := f_GetN_OctetsFromPRBS(30,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet5   := f_GetN_OctetsFromPRBS(40,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet6   := f_GetN_OctetsFromPRBS(50,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet7   := f_GetN_OctetsFromPRBS(60,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet8   := f_GetN_OctetsFromPRBS(70,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet9   := f_GetN_OctetsFromPRBS(80,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet10  := f_GetN_OctetsFromPRBS(90,tsc_MBMS_PacSize);    /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet11   := f_GetN_OctetsFromPRBS(100,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

