  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band3 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(fdd1800));      /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band4 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(bandIV));       /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band5 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(bandV));        /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band6 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(bandVI));       /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band7 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD1(bandVII));      /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band8 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandVIII));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band9 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandIX));       /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band10 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandX));       /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band11 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXI));      /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band12 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXII));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band13 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXIII));    /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band14 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXIV));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band15 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXV));      /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band16 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXVI));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band17 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXVII));    /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band18 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXVIII));   /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band19 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXIX));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band20 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXX));      /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band21 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXXI));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band22 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD2(bandXXII));    /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band25 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD3(bandXXV));     /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band26 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD3(bandXXVI));    /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5_va80ext_IEs cs_SysInfoType5ext_MFBI_Band32 := cs_SysInfoType5_va80ext (cs_FrequencyBandsIndicatorFDD3(bandXXXII));   /* @status    APPROVED (LTE_IRAT) */

  template (value) SysInfoType5.v4b0NonCriticalExtensions cs_SIB5_v4b0NonCriticalExtensions_MFBI(template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI) :=
  { /* @status    APPROVED (LTE_IRAT) */
    sysInfoType5_v4b0ext := omit,
    v590NonCriticalExtensions := {
      sysInfoType5_v590ext := omit,
      v650NonCriticalExtensions := {
        sysInfoType5_v650ext := omit,
        v680NonCriticalExtensions := {
          sysInfoType5_v680ext := omit,
          v690NonCriticalExtensions := {
            sysInfoType5_v690ext := cs_SysInfoType5_v690ext_IEs_AddRACH_TF,
            v770NonCriticalExtensions := {
              sysInfoType5_v770ext := {
                modeSpecificInfo := omit,
                sccpch_SystemInformationList := omit,
                sccpch_SystemInformation_MBMS := omit,
                tDD_MBSFNInformation := omit
              },
              v860NonCriticalExtensions := {
                sysInfoType5_v860ext := {
                  dummy := omit,
                  modeSpecificInfo := {
                    fdd  := {
                      hs_dsch_DrxCellfach_info := omit
                    }
                  }
                },
                v890NonCriticalExtensions := {
                  sysInfoType5_v890ext := {
                    secondFrequencyInfo := omit,
                    commonEDCHSystemInfo := omit
                  },
                  v8b0NonCriticalExtensions := {
                    sysInfoType5_v8b0ext := {
                      tresetUsageIndicator := omit,
                      upPCHpositionInfo := omit
                    },
                    v8d0NonCriticalExtensions := {
                      sysInfoType5_v8d0ext := {
                        commonEDCHSystemInfoFDD := omit
                      },
                      va40NonCriticalExtensions := {
                        sysInfoType5_va40ext := {
                          frequencyBandsIndicatorSupport := omit,
                          frequencyBandIndicator3 := omit
                        },
                        va80NonCriticalExtensions := {
                          sysInfoType5_va80ext := p_SysInfoType5_MFBI,
                          vb50NonCriticalExtensions := omit
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

  template (value) SysInfoType5.v4b0NonCriticalExtensions cds_SIB5_v4b0NonCriticalExtensions_MFBI_v4b0ext(template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI,
                                                                                                          RadioFrequencyBandFDD p_RadioFrequencyBandFDD)
   modifies cs_SIB5_v4b0NonCriticalExtensions_MFBI :=
  { /* @status    APPROVED (LTE_IRAT) */
    sysInfoType5_v4b0ext := {
        pNBSCH_Allocation_r4 := omit,
        openLoopPowerControl_IPDL_TDD := omit,
        prach_SystemInformationList_LCR_r4 := omit,
        tdd128SpecificInfo := omit,
        frequencyBandIndicator := p_RadioFrequencyBandFDD
    }
  };

  template (value) SysInfoType5.v4b0NonCriticalExtensions cds_SIB5_v4b0NonCriticalExtensions_MFBI_v650ext(template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI,
                                                                                                          RadioFrequencyBandFDD2 p_RadioFrequencyBandFDD2)
   modifies cs_SIB5_v4b0NonCriticalExtensions_MFBI :=
  { /* @status    APPROVED (LTE_IRAT) */
    sysInfoType5_v4b0ext := {
        pNBSCH_Allocation_r4 := omit,
        openLoopPowerControl_IPDL_TDD := omit,
        prach_SystemInformationList_LCR_r4 := omit,
        tdd128SpecificInfo := omit,
        frequencyBandIndicator := extension_indicator
    },
    v590NonCriticalExtensions := {
      v650NonCriticalExtensions := {
        sysInfoType5_v650ext := {
          frequencyBandIndicator2 := p_RadioFrequencyBandFDD2
        }
      }
    }
  };

  template (value) SysInfoType5.v4b0NonCriticalExtensions cds_SIB5_v4b0NonCriticalExtensions_MFBI_va40ext(template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI,
                                                                                                          RadioFrequencyBandFDD3 p_RadioFrequencyBandFDD3)
   modifies cs_SIB5_v4b0NonCriticalExtensions_MFBI :=
  { /* @status    APPROVED (LTE_IRAT) */
    sysInfoType5_v4b0ext := {
        pNBSCH_Allocation_r4 := omit,
        openLoopPowerControl_IPDL_TDD := omit,
        prach_SystemInformationList_LCR_r4 := omit,
        tdd128SpecificInfo := omit,
        frequencyBandIndicator := extension_indicator
    },
    v590NonCriticalExtensions := {
      v650NonCriticalExtensions := {
        sysInfoType5_v650ext := {
          frequencyBandIndicator2 := extension_indicator
        },
        v680NonCriticalExtensions := {
          v690NonCriticalExtensions := {
            v770NonCriticalExtensions := {
              v860NonCriticalExtensions := {
                v890NonCriticalExtensions := {
                  v8b0NonCriticalExtensions := {
                    v8d0NonCriticalExtensions := {
                      va40NonCriticalExtensions := {
                        sysInfoType5_va40ext := {
                          frequencyBandIndicator3 := p_RadioFrequencyBandFDD3
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

  template (value) SysInfoType5 cds_SIB5_MFBI(PICH_PowerOffset p_PowerPICH,
                                              AICH_PowerOffset p_PowerAICH,
                                              template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI)
    modifies cs_SIB5_Def :=
  { /* @status    APPROVED (LTE_IRAT) */
    v4b0NonCriticalExtensions := cs_SIB5_v4b0NonCriticalExtensions_MFBI(p_SysInfoType5_MFBI)
  };

  template (value) SysInfoType5 cds_SIB5_v4b0ext_MFBI(PICH_PowerOffset p_PowerPICH,
                                                      AICH_PowerOffset p_PowerAICH,
                                                      RadioFrequencyBandFDD p_RadioFrequencyBandFDD,
                                                      template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI)
    modifies cs_SIB5_Def :=
  { /* @status    APPROVED (LTE_IRAT) */
    v4b0NonCriticalExtensions := cds_SIB5_v4b0NonCriticalExtensions_MFBI_v4b0ext(p_SysInfoType5_MFBI, p_RadioFrequencyBandFDD)
  };

  template (value) SysInfoType5 cds_SIB5_v650ext_MFBI(PICH_PowerOffset p_PowerPICH,
                                                     AICH_PowerOffset p_PowerAICH,
                                                     RadioFrequencyBandFDD2 p_RadioFrequencyBandFDD2,
                                                     template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI)
    modifies cs_SIB5_Def :=
  { /* @status    APPROVED (LTE_IRAT) */
    v4b0NonCriticalExtensions := cds_SIB5_v4b0NonCriticalExtensions_MFBI_v650ext(p_SysInfoType5_MFBI, p_RadioFrequencyBandFDD2)
  };

  template (value) SysInfoType5 cds_SIB5_va40ext_MFBI(PICH_PowerOffset p_PowerPICH,
                                                      AICH_PowerOffset p_PowerAICH,
                                                      RadioFrequencyBandFDD3 p_RadioFrequencyBandFDD3,
                                                      template (value) SysInfoType5_va80ext_IEs p_SysInfoType5_MFBI)
    modifies cs_SIB5_Def :=
  { /* @status    APPROVED (LTE_IRAT) */
    v4b0NonCriticalExtensions := cds_SIB5_v4b0NonCriticalExtensions_MFBI_va40ext(p_SysInfoType5_MFBI, p_RadioFrequencyBandFDD3)
  };

  /*
   * @desc      Return SIB5 band extension for MFBI TC
   * @param     p_MFBI_Band
   * @return    template (value) SysInfoType5_va80ext_IEs
   * @status    APPROVED (LTE_IRAT)
   */
  function  fl_GetMFBI_SIB5_Extension(integer p_MFBI_Band) return template (value) SysInfoType5_va80ext_IEs
  {
    var template (value) SysInfoType5_va80ext_IEs v_SIB5_MFBI_Ext;
 
    select (p_MFBI_Band) {
        case (1) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band1 }
        case (2) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band2 }
        case (3) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band3 }
        case (4) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band4 }
        case (5) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band5 }
        case (6) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band6 }
        case (7) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band7 }
        case (8) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band8 }
        case (9) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band9 }
        case (10) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band10 }
        case (11) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band11 }
        case (12) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band12 }
        case (13) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band13 }
        case (14) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band14 }
        case (15) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band15 }
        case (16) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band16 }
        case (17) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band17 }
        case (18) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band18 }
        case (19) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band19 }
        case (20) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band20 }
        case (21) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band21 }
        case (22) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band22 }
        case (25) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band25 }
        case (26) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band26 }
        case (32) { v_SIB5_MFBI_Ext := cs_SysInfoType5ext_MFBI_Band32 } //@sic R5-151965 sic@
        case else { FatalError(__FILE__, __LINE__, "invalid MFBI frequency band");}
    }
    return v_SIB5_MFBI_Ext;
  }

  /*
   * @desc      Initialise SIB5/SIBbis with MFBI band extension
   * @param     p_Band
   * @param     p_MFBI_Band
   * @param     p_PowerPICH
   * @param     p_PowerAICH
   * @return    SysInfoType5
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UTRAN_InitializeSIB5_SIB5Bis_MFBI(integer p_Band,
                                               integer p_MFBI_Band,
                                               PICH_PowerOffset p_PowerPICH,
                                               AICH_PowerOffset p_PowerAICH) return SysInfoType5
  {
    var template (value) SysInfoType5 v_SIB5;
    var template (value) SysInfoType5_va80ext_IEs v_SIB5_MFBI_Ext := fl_GetMFBI_SIB5_Extension (p_MFBI_Band);
    select  (p_Band) {
      case (1, 2, 3){
        v_SIB5 := cds_SIB5_MFBI(p_PowerPICH, p_PowerAICH, v_SIB5_MFBI_Ext);
      } case (4) {
        v_SIB5 := cds_SIB5_v4b0ext_MFBI(p_PowerPICH, p_PowerAICH, bandIV, v_SIB5_MFBI_Ext);
      } case (5) {
        v_SIB5 := cds_SIB5_v4b0ext_MFBI(p_PowerPICH, p_PowerAICH, bandV, v_SIB5_MFBI_Ext);
      } case (6) {
        v_SIB5 := cds_SIB5_v4b0ext_MFBI(p_PowerPICH, p_PowerAICH, bandVI, v_SIB5_MFBI_Ext);
      } case (7) {
        v_SIB5 := cds_SIB5_v4b0ext_MFBI(p_PowerPICH, p_PowerAICH, bandVII, v_SIB5_MFBI_Ext);
      } case (8) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandVIII, v_SIB5_MFBI_Ext);
      } case (9) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandIX, v_SIB5_MFBI_Ext);
      } case (10) {
        v_SIB5 :=  cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandX, v_SIB5_MFBI_Ext);
      } case (11) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXI, v_SIB5_MFBI_Ext);
      } case (12) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXII, v_SIB5_MFBI_Ext);
      } case (13) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXIII, v_SIB5_MFBI_Ext);
      } case (14) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXIV, v_SIB5_MFBI_Ext);
      } case (15) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXV, v_SIB5_MFBI_Ext);
      } case (16) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXVI, v_SIB5_MFBI_Ext);
      } case (17) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXVII, v_SIB5_MFBI_Ext);
      } case (18) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXVIII, v_SIB5_MFBI_Ext);
      } case (19) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXIX, v_SIB5_MFBI_Ext);
      } case (20) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXX, v_SIB5_MFBI_Ext);
      } case (21) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXXI, v_SIB5_MFBI_Ext);
      } case (22) {
        v_SIB5 := cds_SIB5_v650ext_MFBI(p_PowerPICH, p_PowerAICH, bandXXII, v_SIB5_MFBI_Ext);
      } case (25) {
        v_SIB5 := cds_SIB5_va40ext_MFBI(p_PowerPICH, p_PowerAICH, bandXXV, v_SIB5_MFBI_Ext);
      } case (26) {
        v_SIB5 := cds_SIB5_va40ext_MFBI(p_PowerPICH, p_PowerAICH, bandXXVI, v_SIB5_MFBI_Ext);
      } case (32) { //@sic R5-151965 sic@
        v_SIB5 := cds_SIB5_va40ext_MFBI(p_PowerPICH, p_PowerAICH, bandXXXII, v_SIB5_MFBI_Ext);
      }
      case else  {
        FatalError(__FILE__, __LINE__, "invalid frequency band");
      }
    }
    return valueof(v_SIB5);
  }

  /*
   * @desc      Modify UTRAN FDD Cell Info when MFBI is applied
   * @param     p_CellId
   * @param     p_Band
   * @param     p_MFBI_Band
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UTRAN_CellInfo_ModifyForMFBI( UTRAN_CellId_Type p_CellId,
                                           integer p_Band,
                                           integer p_MFBI_Band ) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_CellId);
    
    v_CellInfo.cellInfo_Specific_FDD.operationBand := f_UTRAN_FrequencyBandFDD(p_Band, true);
    v_CellInfo.cellInfo_Specific_FDD.band := p_Band;

    //Initialise UTRAN frequencies depending on band settings - Acc to 34.108 cl 5.1.3 @sic R5-170398 R5s170096 sic@
    if ((p_Band == 3 and p_MFBI_Band == 9 ) ) {  //MFBI Test frequencies for operation Band III overlapping with Band IX
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7 ) {       // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(1512));
            }
            case ( utran_Cell8 ) { // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(1437));
            }
            case ( utran_Cell9 ) { // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(1362));
            }
        }
     } else if ((p_Band == 5 and p_MFBI_Band == 19 ) ) { //MFBI Test frequencies for operation Band V overlapping with Band XIX
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7) { // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(4437));
            }
            case (utran_Cell8 ){ // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(4412));
            }
            case ( utran_Cell9 ){  // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(4387));
            }
        }
     } else if ((p_Band == 10 and p_MFBI_Band == 4 ) )  { //MFBI Test frequencies for operation Band X overlapping with Band IV
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7){ // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(3312));
            }
            case (utran_Cell8 ) { // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(3250));
            }
            case(utran_Cell9 ){ // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(3113));
            }
        }
     } else if ((p_Band == 25 and p_MFBI_Band == 2 ) )  { //MFBI Test frequencies for operation Band XXV overlapping with Band II
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7) { // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5387));
            }
            case (utran_Cell8) { // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5250));
            }
            case (utran_Cell9) { // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5113));
            }
        }
     } else if ((p_Band == 26 and p_MFBI_Band == 5 ) ) { //MFBI Test frequencies for operation Band XXVI overlapping with Band V
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7) { // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5912));
            }
            case (utran_Cell8) { // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5855));
            }
            case (utran_Cell9 ) { // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5813));
            }
        }
     } else if ((p_Band == 26 and p_MFBI_Band == 19 ) )  { //MFBI Test frequencies for operation Band XXVI overlapping with Band XIX
        select (p_CellId) {
            case (utran_Cell5, utran_Cell7) { // High Frequency ID
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5893));
            }
            case(utran_Cell8) { // Mid
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5868));
            }
            case(utran_Cell9 ){ // Low
                v_CellInfo.frequencyInfo := valueof(cs_FreqInfo_FDD(5843));
            }
        }
     } else {
       FatalError(__FILE__, __LINE__, "Invalid MFBI frequency band combination ");
     }

    if (p_Band == 6) {
      // ts_InitJapanMCC_Band6: For each Band 6 cell, set the MCC to the Japan MCC value.
      v_CellInfo.plmnId.mcc := f_UTRAN_ConvertMCC_Nas2Asn(px_eJapanMCC_Band6);
    } else {
      v_CellInfo.plmnId := valueof(cs_UTRAN_HPLMN_Def);  //Default value
    }
    
    // Set Frequency Band Indicator in SIB5
    v_CellInfo.sysInfo.SIB5 := f_UTRAN_InitializeSIB5_SIB5Bis_MFBI(p_Band,
                                                                   p_MFBI_Band,
                                                                   v_CellInfo.powerPICH,
                                                                   v_CellInfo.cellInfo_Specific_FDD.powerAICH);
    // SIB5 or SIB5bis
    select (p_Band) {
      case (4, 9, 10) {
        v_CellInfo.sysInfo.MIB.sibSb_ReferenceList[5].sibSb_Type := {sysInfoType5bis := 1};
        v_CellInfo.sysInfo.SIB5_Type := systemInformationBlockType5bis;
      }
      case else {
        v_CellInfo.sysInfo.SIB5_Type := systemInformationBlockType5;
      }
    }
    f_UTRAN_CellInfo_Set(p_CellId, v_CellInfo);
  }

}
