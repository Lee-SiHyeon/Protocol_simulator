    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.son_Parameters_r16)) {  // UE_NR_Capability_v1610.son_Parameters_r16
