  import from UTRAN_RRC_Templates_r9 all;

  /*
   * @desc      To convert HsScchInfo_ChCodeInfo_Type to specific DL_SecondaryHsScchCodeInfo_Type type
   * @param     p_ChCodeInfo
   * @return    DL_SecondaryHsScchCodeInfo_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_ConvertHsScchChCodeToSecondaryHsScchChCode_r10(HsScchInfo_ChCodeInfo_Type p_ChCodeInfo) return DL_SecondaryHsScchCodeInfo_Type
  {
    var DL_SecondaryHsScchCodeInfo_Type v_DL_SecondaryCodeInfo;
    var integer i;

    for (i:=0; i<lengthof(p_ChCodeInfo); i:= i+1) {
      v_DL_SecondaryCodeInfo[i]:= p_ChCodeInfo[i];
    }
    return v_DL_SecondaryCodeInfo;
  }

  template (value) UL_AddReconfTransChInformation_r8 cs_UL_AddReconfTransChInfoE_DCH_MACiis_FDD :=
  { /* @status    APPROVED (UTRAN) */
    e_dch := {
      ul_MAC_HeaderType := mac_iis,
      modeSpecific := {
        fdd := {
          tti := f_Get_EDCH_TTI_Value()
        }
      },
      harq_Info := rvtable,
      addReconf_MAC_d_FlowList := { //condition A36 for Radio Bearer Setup in TS 34.108
        cs_E_DCH_AddReconf_MAC_d_Flow_DCCH_r7_FDD(168), //value for MACi
        cs_E_DCH_AddReconf_MAC_d_Flow_DTCH_r7
      }
    }
  };

  template (value) DL_InformationPerRL_List_r8 cs_DL_InfoPerRL_HSU_r8_FDD(PrimaryScramblingCode   p_ScrmbCode,
                                                                          template (value) DL_InformationPerRL_DpchInfo_r8 p_DL_DpchInfo) :=
  { /* @status    APPROVED (UTRAN) */
    {
      modeSpecificInfo := {
        fdd := {
          primaryCPICH_Info := {
            primaryScramblingCode := p_ScrmbCode
          },
          servingHSDSCH_RL_indicator := true,
          servingEDCH_RL_indicator := true
        }
      },
      dl_dpchInfo := p_DL_DpchInfo,
      e_AGCH_Information := cs_E_AGCH_Info_FDD_r8, // AGCH
      modeSpecificInfo2 := {
        fdd := {
          e_HICH_Info := {  // HICH
            e_HICH_Information := cs_E_HICH_Info
          },
          e_RGCH_Info := {  // RGCH
            e_RGCH_Information := cs_E_RGCH_Info
          }
        }
      },
      cell_id := omit
    }
  };

  template (value) DL_InformationPerRL_List_r8 cs_DL_InfoPerRL_HSUwithDPCH_r8_FDD(PrimaryScramblingCode   p_ScrmbCode,
                                                                                  SF512_AndCodeNumber     p_SpreadingFactorDPCH,
                                                                                  SecondaryScramblingCode p_SecScramblingCodeDPCH) :=
  /* @status    APPROVED (UTRAN) */
    cs_DL_InfoPerRL_HSU_r8_FDD(p_ScrmbCode, cs_DL_InformationPerRL_DpchInfo_r8(cs_DL_DPCH_InfoPerRL_SRB_FDD(p_SpreadingFactorDPCH, p_SecScramblingCodeDPCH)));

  template (value) DL_InformationPerRL_List_r8 cs_DL_InfoPerRL_HSUwithFDPCH_r8_FDD(PrimaryScramblingCode p_ScrmbCode,
                                                                                   template (omit) FDPCH_SlotFormat p_FDPCH_SlotFormat,
                                                                                   integer p_FDPCH_Code) :=
  /* @status    APPROVED (UTRAN) */
    cs_DL_InfoPerRL_HSU_r8_FDD(p_ScrmbCode, cs_DL_InformationPerRL_FdpchInfo_r8(cs_DL_DPCH_InfoPerRL_FDPCH_FDD(p_FDPCH_SlotFormat, p_FDPCH_Code)));

  template (value) DL_InformationPerRL_DpchInfo_r8 cs_DL_InformationPerRL_DpchInfo_r8(template (value) DL_DPCH_InfoPerRL_r7 p_DL_DPCH_InfoPerRL_r7) :=
  { /* @status    APPROVED (UTRAN) */
    dl_DPCH_InfoPerRL := p_DL_DPCH_InfoPerRL_r7
  };

  template (value) DL_InformationPerRL_DpchInfo_r8 cs_DL_InformationPerRL_FdpchInfo_r8(template (value) DL_FDPCH_InfoPerRL_r7 p_DL_FDPCH_InfoPerRL_r7) :=
  { /* @status    APPROVED (UTRAN) */
    dl_FDPCH_InfoPerRL := p_DL_FDPCH_InfoPerRL_r7
  };

  template (value) DL_AddReconfTransChInfoList_r9 cs_DL_AddReconfTransChInfoList_1DCH_HS_PS_HSDPA_MACehs_r9(template (value) HARQ_Info_r7 p_HARQ_Info) :=
  { /* @status    APPROVED (UTRAN) */
    cs_DL_AddReconfTransChInfo_r9(tsc_DL_DCH5, tsc_UL_DCH5),
    cs_DL_AddReconfTransChHSDSCHInfo_HSDPA_r9 (cs_HSDSCH_Info_MACehs_r9 (p_HARQ_Info, cs_AddOrReconfMAC_ehs_ReordQ_r9 (cs_MAC_ehs_AddReconfReordQ_r9(0, mw64)))) // @sic R5s140782 sic@
  };

  template (value) AddOrReconfMAC_ehs_ReordQ_r9 cs_AddOrReconfMAC_ehs_Reord2Q_r9(MAC_ehs_QueueId p_QID1,
                                                                                 MAC_ehs_QueueId p_QID2) :=
  { /* @status    APPROVED (UTRAN) */
    mac_ehs_AddReconfQueue_List := {
      cs_MAC_ehs_AddReconfReordQ_r9(p_QID1),
      cs_MAC_ehs_AddReconfReordQ_r9(p_QID2)
    }
  };

  template (value) Measurement_Feedback_Info_r7 cs_Measurement_Feedback_Info_4CHSDPA(Feedback_cycle_r7 p_Fc) :=
  { /* @status    APPROVED (UTRAN) */
    modeSpecificInfo := {
      fdd := {
        measurementPowerOffset := 16, // Actual measurement power offset value = IE value * 0.5
        feedback_cycle := p_Fc,       // Feedback cycle
        cqi_RepetitionFactor := 1,    // According to 34.108 cl. 9.1.1 RADIO BEARER SETUP
        deltaCQI := 4
      }
    }
  };

  template (value) DL_SecondaryCellInfoFDD_r10 cs_DL_SecondaryCellInfoDef_r10(H_RNTI p_NewH_RNTI,
                                                                              HSPA_InfoPerCell_Type p_HSPA_InfoPerCell,
                                                                              PrimaryScramblingCode p_PrimScramblingCode,
                                                                              UARFCN p_UARFCN,
                                                                              template (omit) SecondaryCellMIMOparametersFDD_r10 p_SecCellMimoParam := omit) :=
  { /* @status    APPROVED (UTRAN) */
    configurationInfo := {
      newConfiguration := {
        new_H_RNTI := p_NewH_RNTI,
        dl_64QAM_Configured := f_UTRAN_ConvertBoolToSecondaryCell64QAM (p_HSPA_InfoPerCell.dl_64QAM),
        hs_DSCH_TBSizeTable := p_HSPA_InfoPerCell.hS_DSCH_TBSizeTable,
        primaryCPICH_Info := {
          primaryScramblingCode := p_PrimScramblingCode
        },
        dl_ScramblingCode := omit,
        hS_SCCHChannelisationCodeInfo := f_UTRAN_ConvertHsScchChCodeToSecondaryHsScchChCode_r10(p_HSPA_InfoPerCell.hS_SCCH_Info.modeSpecificInfo.fdd.hS_SCCHChannelisationCodeInfo),
        measurementPowerOffset := 12, // 6 dB (Actual measurement power offset value = IE value * 0.5)
        uarfcn_DL := p_UARFCN,
        differentTxModeFromServingHS_DSCHCell := omit
      }
    },
    secondaryCellMIMOparameters := p_SecCellMimoParam
  };

  template (value) AdditionalDLSecCellInfoListFDD cs_AdditionalDLSecCellInfoListFDD_3C(HSPA_InfoPerCellList_Type p_HSPA_InfoPerCell,
                                                                                       H_RNTI p_NewH_RNTI,
                                                                                       PrimaryScramblingCode p_SecondSecondaryPrimScramblingCode,
                                                                                       UARFCN p_SecondSecondaryUarfcn,
                                                                                       template (omit) SecondaryCellMIMOparametersFDD_r10 p_SecCellMimoParam := omit) :=
  { /* @status    APPROVED (UTRAN) */
    cs_AdditionalDLSecCellInfoFDD (p_HSPA_InfoPerCell[2], p_NewH_RNTI, p_SecondSecondaryPrimScramblingCode, p_SecondSecondaryUarfcn, p_SecCellMimoParam),
    cs_AdditionalDLSecCellInfoFDD_Omit
  };

  template (value) AdditionalDLSecCellInfoListFDD cs_AdditionalDLSecCellInfoListFDD_4C(HSPA_InfoPerCellList_Type p_HSPA_InfoPerCell,
                                                                                       H_RNTI p_NewH_RNTI,
                                                                                       PrimaryScramblingCode p_SecondSecondaryPrimScramblingCode,
                                                                                       PrimaryScramblingCode p_ThirdSecondaryPrimScramblingCode,
                                                                                       UARFCN p_SecondSecondaryUarfcn,
                                                                                       UARFCN p_ThirdSecondaryUarfcn,
                                                                                       template (omit) SecondaryCellMIMOparametersFDD_r10 p_SecCellMimoParam := omit) :=
  { /* @status    APPROVED (UTRAN) */
    cs_AdditionalDLSecCellInfoFDD (p_HSPA_InfoPerCell[2], p_NewH_RNTI, p_SecondSecondaryPrimScramblingCode, p_SecondSecondaryUarfcn, p_SecCellMimoParam),
    cs_AdditionalDLSecCellInfoFDD (p_HSPA_InfoPerCell[3], p_NewH_RNTI, p_ThirdSecondaryPrimScramblingCode, p_ThirdSecondaryUarfcn, p_SecCellMimoParam)
  };

  template (value) AdditionalDLSecCellInfoFDD cs_AdditionalDLSecCellInfoFDD(HSPA_InfoPerCell_Type p_HSPA_InfoPerCell,
                                                                            H_RNTI p_NewH_RNTI,
                                                                            PrimaryScramblingCode p_SecondaryPrimScramblingCode,
                                                                            UARFCN p_SecondaryUarfcn,
                                                                            template (omit) SecondaryCellMIMOparametersFDD_r10 p_SecCellMimoParam := omit) :=
  { /* @status    APPROVED (UTRAN) */
    dl_SecondaryCellInfoFDD := cs_DL_SecondaryCellInfoDef_r10 (p_NewH_RNTI, p_HSPA_InfoPerCell, p_SecondaryPrimScramblingCode, p_SecondaryUarfcn, p_SecCellMimoParam)
  };

  template (value) AdditionalDLSecCellInfoFDD cs_AdditionalDLSecCellInfoFDD_Omit :=
  { /* @status    APPROVED (UTRAN) */
    dl_SecondaryCellInfoFDD := omit
  };

  template (value) SecondaryCellMIMOparametersFDD_r10 cs_SecondaryCellMIMOParametersNewDef :=
  { /* @status    APPROVED (UTRAN) */
    newConfiguration := {
      mimoN_M_Ratio := mnm1_1,
      mimoPilotConfiguration := {
        secondCPICH_Pattern := {
          diversityPattern := {
            channelisationCode := 29,//34.108, Table 5.5.1.3.3
            s_cpich_PowerOffset_Mimo := 0
          }
        }
      },
      precodingWeightSetRestriction := true_
    }
  };

  template (value) RAB_InformationSetup_r8 cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_4CHSDPA :=
  /* @status    APPROVED (UTRAN) */
    cs_RAB_Info_PS_Common(tsc_RAB_DefPS_HS, tsc_RB25, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_4CHSDPA, {cs_RB_MappingOptionPS_RAB1_EDCH_HSDSCH_MACehs});

  template (value) RAB_InformationSetup_r8 cs_RAB_InfoSetup_RB25_HS_AM_DTCH_PS_NoPDCP_4CHSDPA(template (value) RLC_Info_r7  p_RLC_Info):=
  /* @status    APPROVED (UTRAN) */
    cs_RAB_Info_PS_Common(tsc_RAB_DefPS_HS, tsc_RB25, omit, p_RLC_Info, {cs_RB_MappingOptionPS_RAB1_DCH_HSDSCH_MACehs});

  template (value) RLC_Info_r7 cs_RLC_InfoAM_4CHSDPA := cs_RLC_InfoAM_Common(cds_UL_AM_RLC_Flexible, cds_DL_AM_RLC_Flexible_r7, true_);   /* @status    APPROVED (UTRAN) */

  template (value) RB_MappingOption_r8 cs_RB_MappingOptionPS_RAB1_DCH_HSDSCH_MACehs :=
  { /* @status    APPROVED (UTRAN) */
    ul_LogicalChannelMappings := cs_UL_LogicalChannelMappings_r8_DCH(tsc_UL_DCH1, tsc_MAC_LogicalChannelPrio8),
    dl_LogicalChannelMappingList := {
      cs_DL_LogicalChannelMappingHSDSCH_MACehs_r7(tsc_MACehs_Queue0_DTCH)
    }
  };

  template (value) RB_InformationAffectedList_r8 cs_RB_InformationAffectedListSRBs_EDCH_HSDSCH_r8 :=
  { /* @status    APPROVED (UTRAN) */
    {
      rb_Identity := tsc_RB1,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_HSDSCHehs_r8(tsc_UL_DCCH1, tsc_E_DCH_DDI_1, 1, tsc_DL_DCCH1)
      }
    },
    {
      rb_Identity := tsc_RB2,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_HSDSCHehs_r8(tsc_UL_DCCH2, tsc_E_DCH_DDI_2, 2, tsc_DL_DCCH2)
      }
    },
    {
      rb_Identity := tsc_RB3,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_HSDSCHehs_r8(tsc_UL_DCCH3, tsc_E_DCH_DDI_3, 3, tsc_DL_DCCH3)
      }
    },
    {
      rb_Identity := tsc_RB4,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_HSDSCHehs_r8(tsc_UL_DCCH4, tsc_E_DCH_DDI_4, 4, tsc_DL_DCCH4)
      }
    }
  };

  template (value) RB_MappingOption_r8 cs_RB_MappingOptionSRB_EDCH_HSDSCHehs_r8(LogicalChannelIdentity     p_LogicalChannelIdUL,
                                                                                DDI                        p_DDI,
                                                                                MAC_LogicalChannelPriority p_LogicalChannelPriority,
                                                                                LogicalChannelIdentity     p_LogicalChannelIdDL) :=
  { /* @status    APPROVED (UTRAN) */
    ul_LogicalChannelMappings := cs_UL_LogicalChannelMappings_E_DCH_fixedSize_r8(p_LogicalChannelIdUL, 1, p_DDI, -, false, p_LogicalChannelPriority),
    dl_LogicalChannelMappingList := {
      cs_DL_LogicalChannelMappingHSDSCH_MACehs_r7(tsc_MACehs_Queue1_DCCH, p_LogicalChannelIdDL)
    }
  };

  template (value) DL_DCCH_Message cs_RadioBearerRelease_r10(IntegrityCheckInfo p_Integrityinfo,
                                                             template (value) RadioBearerRelease_r10_IEs p_RadioBearerRelease) :=
  { /* @status    APPROVED (UTRAN) */
    integrityCheckInfo := p_Integrityinfo,
    message_ := {
      radioBearerRelease := {
        later_than_r3 := {
          rrc_TransactionIdentifier := tsc_RRC_TI,
          criticalExtensions := {
            criticalExtensions := {
              criticalExtensions := {
                criticalExtensions := {
                  criticalExtensions := {
                    criticalExtensions := {
                      criticalExtensions := {
                        r10 := {
                          radioBearerRelease_r10 := p_RadioBearerRelease,
                          radioBearerRelease_r10_add_ext := omit,
                          v9c0NonCriticalExtensions := omit
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_RB_Release_HSDSH_ToDCH_r10_FDD(IntegrityCheckInfo      p_Integrityinfo,
                                                                     ActivationTime          p_ActivationTime,
                                                                     RB_Identity             p_RB_Id,
                                                                     UL_ScramblingCode       p_UL_ScramblingCode,
                                                                     PrimaryScramblingCode   p_PrimScramblingCode,
                                                                     SecondaryScramblingCode  p_SecondaryScramblingCode) := //@sic R5s140782 sic@
  /* ASN.1 PDU Constraint. 4C case - release from configuration Cell_DCH_HS_DSCH to A1*/
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerRelease_r10(p_Integrityinfo, cds_RadioBearerRelease_HSDSH_ToDCH_r10_FDD(p_ActivationTime,
                                                                                          p_RB_Id,
                                                                                          p_UL_ScramblingCode,
                                                                                          p_PrimScramblingCode,
                                                                                          p_SecondaryScramblingCode)); //@sic R5s140782 sic@

  template (value) RadioBearerRelease_r10_IEs  cds_RadioBearerRelease_HSDSH_ToDCH_r10_FDD(ActivationTime p_ActivationTime,
                                                                                          RB_Identity p_RB_Id,
                                                                                          UL_ScramblingCode p_UL_ScramblingCode,
                                                                                          PrimaryScramblingCode     p_PrimScramblingCode,
                                                                                          SecondaryScramblingCode  p_SecondaryScramblingCode) //@sic R5s140782 sic@: To be set to tsc_DL_DPCH1_2ndScrC for RAB test cases; To be set to tsc_DL_DPCH_ScrC_3 for other test cases
         modifies cs_RadioBearerRelease_r10_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    activationTime := p_ActivationTime,
    rrc_StateIndicator := cell_DCH,
    rb_InformationReleaseList := {p_RB_Id},
    ul_CommonTransChInfo :=  cs_UL_CommTrChInfoDCCH_13_6k_r4_FDD,
    ul_deletedTransChInfoList := {cs_UL_TransportChannelIdDCH_r6(tsc_UL_DCH1)},
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCCH_13_6k_r8,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoSameAsUL_r4_FDD,
    dl_DeletedTransChInfoList := {cs_DL_TransportChannelIdentityHSDSCH_MACehs_r7(tsc_MACehs_Queue0_DTCH)},
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCCH_SRB_r9,
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info:=  cs_UL_DPCH_13_6_StandAlone_FDD (p_UL_ScramblingCode),
    dl_CommonInformation := cs_DL_CommonInfoDCH_SRB_FDD_r10(tsc_DL_DPCH1_SFP_SRB, fixed, false, cs_DL_DPCH_CfnHandling_Maintain_r6, omit), //@sic R5s140782 sic@
    dl_InformationPerRL_List := cs_DL_InformationPerRL_r8_FDD(p_PrimScramblingCode, tsc_DL_DPCH1_ChC_SRB, p_SecondaryScramblingCode) //@sic R5s140782 sic@
  };

  template (value) RadioBearerRelease_r10_IEs cs_RadioBearerRelease_r10_IEs_Omit :=
  { /* Default template from 34.108 cl. 9
       @status    APPROVED (UTRAN)  */
    integrityProtectionModeInfo := omit,
    cipheringModeInfo:= omit,
    activationTime:= omit,
    new_U_RNTI  := omit,
    new_C_RNTI  := omit,
    new_DSCH_RNTI:= omit,
    new_H_RNTI:= omit,
    newPrimary_E_RNTI := omit,
    newSecondary_E_RNTI := omit,
    rrc_StateIndicator:= cell_DCH,
    ueMobilityStateIndicator:= omit,
    utran_DRX_CycleLengthCoeff  := omit,
    cn_InformationInfo:= omit,
    signallingConnectionRelIndication:= omit,
    ura_Identity    := omit,
    supportForChangeOfUE_Capability := omit,
    rab_InformationReconfigList:= omit,
    rb_InformationReleaseList   := {tsc_RB20},
    rb_InformationReconfigList  := omit,
    rb_InformationAffectedList  := omit,
    dl_CounterSynchronisationInfo   := omit,
    ul_CommonTransChInfo:= omit,
    ul_deletedTransChInfoList:= omit,
    ul_AddReconfTransChInfoList := omit,
    dl_CommonTransChInfo:= omit,
    dl_DeletedTransChInfoList   := omit,
    dl_AddReconfTransChInfoList := omit,
    frequencyInfo   := omit,
    multi_frequencyInfo := omit,
    dtx_drx_TimingInfo  := omit,
    dtx_drx_Info    := omit,
    hs_scch_LessInfo    := omit,
    mimoParameters  := omit,
    maxAllowedUL_TX_Power:= omit,
    ul_DPCH_Info    := omit,
    ul_EDCH_Information := omit,
    ul_SecondaryCellInfoFDD := omit,
    ul_MulticarrierEDCHInfo_TDD128  := omit,
    dl_HSPDSCH_Information  := omit,
    dl_CommonInformation    := omit,
    dl_InformationPerRL_List:= omit,
    dl_SecondaryCellInfoFDD := omit,
    additionalDLSecCellInfoListFDD  := omit,
    controlChannelDRXInfo_TDD128:= omit,
    sps_Information_TDD128  := omit,
    mu_MIMO_Info_TDD128 := omit,
    mbms_PL_ServiceRestrictInfo := omit,
    mbms_RB_ListReleasedToChangeTransferMode:= omit,
    cellDCHMeasOccasionInfo_TDD128  := omit
  };

  template (value) DL_DCCH_Message cs_108_RB_SetUpA25a_3C_r10_FDD(IntegrityCheckInfo  p_Integrityinfo,
                                                                  ActivationTime  p_ActTime,
                                                                  template (value) RLC_Info_r7  p_RLC_Info,
                                                                  UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                  UL_ScramblingCode   p_UL_ScramblingCode,
                                                                  PrimaryScramblingCode p_PrimScramblingCodeServing,
                                                                  PrimaryScramblingCode p_PrimScramblingCodeFirstSecondary,
                                                                  PrimaryScramblingCode p_PrimScramblingCodeSecondSecondary,
                                                                  UARFCN p_FirstSecondaryUarfcn,
                                                                  UARFCN p_SecondSecondaryUarfcn) :=
  // ASN.1 PDU Constraint. Defined in TS 34.108 clause 9, 3C case
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A25a_3C_FDD(p_ActTime,
                                                                                      tsc_H_RNTI,
                                                                                      p_RLC_Info,
                                                                                      p_HSPA_Parameters,
                                                                                      p_UL_ScramblingCode,
                                                                                      p_PrimScramblingCodeServing,
                                                                                      p_PrimScramblingCodeFirstSecondary,
                                                                                      p_PrimScramblingCodeSecondSecondary,
                                                                                      p_FirstSecondaryUarfcn,
                                                                                      p_SecondSecondaryUarfcn));

  template (value) DL_DCCH_Message cs_108_RB_SetUpA36_A37_3C_r10_FDD(IntegrityCheckInfo        p_Integrityinfo,
                                                                     ActivationTime            p_ActTime,
                                                                     UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                     UL_ScramblingCode         p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeServing,
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeFirstSecondary,
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeSecondSecondary,
                                                                     UARFCN                    p_FirstSecondaryUarfcn,
                                                                     UARFCN                    p_SecondSecondaryUarfcn,
                                                                     template (omit) FDPCH_SlotFormat   p_FDPCH_SlotFormat := omit) :=
  // ASN.1 PDU Constraint. Defined in TS 34.108 clause 9, 3C case
  // A36 and A37 are the same except for the different modulation. These diferenced are handle by correct setting of p_HSPA_Parameters
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A36_A37_FDD(p_ActTime,
                                                                                      tsc_H_RNTI,
                                                                                      tsc_E_RNTI,
                                                                                      p_HSPA_Parameters,
                                                                                      p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                                      p_PrimScramblingCodeServing,
                                                                                      p_PrimScramblingCodeFirstSecondary,
                                                                                      p_FirstSecondaryUarfcn,
                                                                                      cs_AdditionalDLSecCellInfoListFDD_3C(p_HSPA_Parameters.hSPA_InfoPerCell,
                                                                                                                           tsc_H_RNTI,
                                                                                                                           p_PrimScramblingCodeSecondSecondary,
                                                                                                                           p_SecondSecondaryUarfcn),
                                                                                      p_FDPCH_SlotFormat));

  template (value) DL_DCCH_Message cs_108_RB_SetUpA33_A34_3C_r10_FDD(IntegrityCheckInfo        p_Integrityinfo,
                                                                     ActivationTime            p_ActTime,
                                                                     UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                     UL_ScramblingCode         p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeServing,
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeFirstSecondary,
                                                                     PrimaryScramblingCode     p_PrimScramblingCodeSecondSecondary,
                                                                     UARFCN                    p_FirstSecondaryUarfcn,
                                                                     UARFCN                    p_SecondSecondaryUarfcn,
                                                                     template (omit) integer   p_FDPCH_SlotFormat := omit) :=
  // ASN.1 PDU Constraint. Defined in TS 34.108 clause 9, 3C case
  // A33 and A34 are the same except for the different modulation. These diferenced are handle by correct setting of p_HSPA_Parameters
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A33_A34_FDD(p_ActTime,
                                                                                      tsc_H_RNTI,
                                                                                      tsc_E_RNTI,
                                                                                      p_HSPA_Parameters,
                                                                                      p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                                      p_PrimScramblingCodeServing,
                                                                                      p_PrimScramblingCodeFirstSecondary,
                                                                                      p_FirstSecondaryUarfcn,
                                                                                      cs_AdditionalDLSecCellInfoListFDD_3C(p_HSPA_Parameters.hSPA_InfoPerCell,
                                                                                                                           tsc_H_RNTI,
                                                                                                                           p_PrimScramblingCodeSecondSecondary,
                                                                                                                           p_SecondSecondaryUarfcn,
                                                                                                                           cs_SecondaryCellMIMOParametersNewDef),
                                                                                      p_FDPCH_SlotFormat));

   template (value) DL_DCCH_Message cs_108_RB_SetUpA35_3C_r10_FDD(IntegrityCheckInfo  p_Integrityinfo,
                                                                 ActivationTime  p_ActTime,
                                                                 UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                 UL_ScramblingCode     p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                 PrimaryScramblingCode p_PrimScramblingCodeServing,
                                                                 PrimaryScramblingCode p_PrimScramblingCodeFirstSecondary,
                                                                 PrimaryScramblingCode p_PrimScramblingCodeSecondSecondary,
                                                                 UARFCN p_FirstSecondaryUarfcn,
                                                                 UARFCN p_SecondSecondaryUarfcn) :=
   // ASN.1 PDU Constraint. Defined in TS 34.108 clause 9, 3C case
   /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A35_FDD(p_ActTime,
                                                                                  tsc_H_RNTI,
                                                                                  tsc_E_RNTI,
                                                                                  p_HSPA_Parameters,
                                                                                  p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                                  p_PrimScramblingCodeServing,
                                                                                  p_PrimScramblingCodeFirstSecondary,
                                                                                  p_FirstSecondaryUarfcn,
                                                                                  cs_AdditionalDLSecCellInfoListFDD_3C(p_HSPA_Parameters.hSPA_InfoPerCell,
                                                                                                                       tsc_H_RNTI,
                                                                                                                       p_PrimScramblingCodeSecondSecondary,
                                                                                                                       p_SecondSecondaryUarfcn)));

  template (value) DL_DCCH_Message cs_108_RB_SetUpA35_4C_r10_FDD(IntegrityCheckInfo  p_Integrityinfo,
                                                                 ActivationTime  p_ActTime,
                                                                 UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                 UL_ScramblingCode     p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                 PrimaryScramblingCode p_PrimScramblingCodeServing,
                                                                 PrimaryScramblingCode p_PrimScramblingCodeFirstSecondary,
                                                                 PrimaryScramblingCode p_PrimScramblingCodeSecondSecondary,
                                                                 PrimaryScramblingCode p_PrimScramblingCodeThirdSecondary,
                                                                 UARFCN p_FirstSecondaryUarfcn,
                                                                 UARFCN p_SecondSecondaryUarfcn,
                                                                 UARFCN p_ThirdSecondaryUarfcn) :=
  // ASN.1 PDU Constraint. Defined in TS 34.108 clause 9, 4C case
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A35_FDD(p_ActTime,
                                                                                  tsc_H_RNTI,
                                                                                  tsc_E_RNTI,
                                                                                  p_HSPA_Parameters,
                                                                                  p_UL_ScramblingCode, //@sic R5-145758 sic@
                                                                                  p_PrimScramblingCodeServing,
                                                                                  p_PrimScramblingCodeFirstSecondary,
                                                                                  p_FirstSecondaryUarfcn,
                                                                                  cs_AdditionalDLSecCellInfoListFDD_4C(p_HSPA_Parameters.hSPA_InfoPerCell,
                                                                                                                       tsc_H_RNTI,
                                                                                                                       p_PrimScramblingCodeSecondSecondary,
                                                                                                                       p_PrimScramblingCodeThirdSecondary,
                                                                                                                       p_SecondSecondaryUarfcn,
                                                                                                                       p_ThirdSecondaryUarfcn)));

  template (value) RadioBearerSetup_r10_IEs cds_RadioBearerSetup_r10_IEs_A25a_3C_FDD(ActivationTime  p_ActTime,
                                                                                     H_RNTI   p_NewH_RNTI,
                                                                                     template (value) RLC_Info_r7  p_RLC_Info,
                                                                                     UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                                     UL_ScramblingCode   p_UL_ScramblingCode,
                                                                                     PrimaryScramblingCode p_PrimScramblingCodeServing,
                                                                                     PrimaryScramblingCode p_PrimScramblingCodeFirstSecondary,
                                                                                     PrimaryScramblingCode p_PrimScramblingCodeSecondSecondary,
                                                                                     UARFCN p_FirstSecondaryUarfcn,
                                                                                     UARFCN p_SecondSecondaryUarfcn)
    modifies cs_RadioBearerSetup_r10_IEs_Omit :=
  {  // Message based on A25a but addapted to 3C-HSDPA
    /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetup_RB25_HS_AM_DTCH_PS_NoPDCP_4CHSDPA (p_RLC_Info)
    },
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_PS_64k,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD (cs_TFCS_Cmpl0_1_Rx),
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoList_1DCH_HS_PS_HSDPA_MACehs_r9(cs_HARQ_Info_FDD),//ok
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,//ok
    ul_DPCH_Info := cs_UL_DPCH_InfoACK_NACK_FDD(tsc_UL_DPDCH_SF_64k_PS,
                                                pl0_96,
                                                p_UL_ScramblingCode,
                                                p_HSPA_Parameters.deltaACK, //@sic R5s140782 sic@
                                                p_HSPA_Parameters.deltaNACK, //@sic R5s140782 sic@
                                                p_HSPA_Parameters.ack_NACK_repetition_factor),
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD(p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_SCCH_Info, // 64QAM dependent(see initilization of HSPA_Parameters
                                                               cs_Measurement_Feedback_Info_4CHSDPA(fc8),
                                                               f_UTRAN_ConvertBoolTo64QAM (p_HSPA_Parameters.hSPA_InfoPerCell[0].dl_64QAM), //64QAM dependent
                                                               p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_DSCH_TBSizeTable),
    dl_CommonInformation := cs_DL_CommonInfo_FDD_r10(cs_DL_DPCH_CfnHandling_Maintain_r6(omit), tsc_DL_DPCH1_SFP_SRB_3_4k, fixed, false),
    dl_InformationPerRL_List := cds_DL_InformationPerRL_HSDPA_r8_FDD(p_PrimScramblingCodeServing,
                                                                     p_HSPA_Parameters.dl_DPCH_SFC, //64QAM dependent
                                                                     omit),
    dl_SecondaryCellInfoFDD := cs_DL_SecondaryCellInfoDef_r10(p_NewH_RNTI,
                                                              p_HSPA_Parameters.hSPA_InfoPerCell[1],
                                                              p_PrimScramblingCodeFirstSecondary,
                                                              p_FirstSecondaryUarfcn),
    additionalDLSecCellInfoListFDD := cs_AdditionalDLSecCellInfoListFDD_3C(p_HSPA_Parameters.hSPA_InfoPerCell,
                                                                           p_NewH_RNTI,
                                                                           p_PrimScramblingCodeSecondSecondary,
                                                                           p_SecondSecondaryUarfcn)  // RAB test cases are only 3C
  };

  template (value) RadioBearerSetup_r10_IEs cds_RadioBearerSetup_r10_IEs_A36_A37_FDD(ActivationTime         p_ActTime,
                                                                                     H_RNTI                 p_NewH_RNTI,
                                                                                     E_RNTI                 p_NewE_RNTI,
                                                                                     UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                                     UL_ScramblingCode      p_UL_ScramblingCode,  //@sic R5-145758 sic@
                                                                                     PrimaryScramblingCode  p_PrimScramblingCode,
                                                                                     PrimaryScramblingCode  p_PrimScramblingCodeFirstSecondary,
                                                                                     UARFCN                 p_FirstSecondaryUarfcn,
                                                                                     template (value) AdditionalDLSecCellInfoListFDD p_AdditionalDLSecCellInfoListFDD,
                                                                                     template (omit) FDPCH_SlotFormat p_FDPCH_SlotFormat)
    modifies cs_RadioBearerSetup_r10_IEs_Omit :=
  {  // 34.108, IEs for Radio Bearer Setup A36 and A37
     /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    newPrimary_E_RNTI := p_NewE_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_4CHSDPA
    },
    rb_InformationAffectedList := cs_RB_InformationAffectedListSRBs_EDCH_HSDSCH_r8,
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_deletedTransChInfoList :=  { cs_UL_TransportChannelIdDCH_r6(tsc_UL_DCH5) },
    ul_AddReconfTransChInfoList := {cs_UL_AddReconfTransChInfoE_DCH_MACiis_FDD}, //E-DCH for DCCH and one DTCH
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD (cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
    dl_DeletedTransChInfoList := { cs_DL_TransportChannelIdentityDCH_r7(tsc_DL_DCH5) },
    dl_AddReconfTransChInfoList := {cs_DL_AddReconfTransChHSDSCHInfo_HSDPA_r9(cs_HSDSCH_Info_MACehs_r9 (cs_HARQ_Info_FDD, cs_AddOrReconfMAC_ehs_Reord2Q_r9 (tsc_MAC_ehs_Q0, tsc_MAC_ehs_Q1)))},
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_OnlyHS_PDSCH_FDD (p_UL_ScramblingCode), //@sic R5-145758 sic@
    ul_EDCH_Information := cs_UL_EDCH_Information_r9_FDD,
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD (p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_SCCH_Info,
                                                                cs_Measurement_Feedback_Info_4CHSDPA(fc8)),
    dl_CommonInformation := cs_DL_CommonInformationF_DPCH_FDD_r10, //@sic R5-145758 sic@
    dl_InformationPerRL_List := cs_DL_InfoPerRL_HSUwithFDPCH_r8_FDD (p_PrimScramblingCode, p_FDPCH_SlotFormat, p_HSPA_Parameters.dl_FDPCH_Code),
    dl_SecondaryCellInfoFDD := cs_DL_SecondaryCellInfoDef_r10 (p_NewH_RNTI,
                                                               p_HSPA_Parameters.hSPA_InfoPerCell[1],
                                                               p_PrimScramblingCodeFirstSecondary,
                                                               p_FirstSecondaryUarfcn),
    additionalDLSecCellInfoListFDD := p_AdditionalDLSecCellInfoListFDD
  };

  template (value) RadioBearerSetup_r10_IEs cds_RadioBearerSetup_r10_IEs_A33_A34_FDD(ActivationTime         p_ActTime,
                                                                                     H_RNTI                 p_NewH_RNTI,
                                                                                     E_RNTI                 p_NewE_RNTI,
                                                                                     UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                                     UL_ScramblingCode      p_UL_ScramblingCode,  //@sic R5-145758 sic@
                                                                                     PrimaryScramblingCode  p_PrimScramblingCode,
                                                                                     PrimaryScramblingCode  p_PrimScramblingCodeFirstSecondary,
                                                                                     UARFCN                 p_FirstSecondaryUarfcn,
                                                                                     template (value) AdditionalDLSecCellInfoListFDD p_AdditionalDLSecCellInfoListFDD,
                                                                                     template (omit) integer p_FDPCH_SlotFormat)
    modifies cs_RadioBearerSetup_r10_IEs_Omit :=
  {  // 34.108, IEs for Radio Bearer Setup A33 and A34
     /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    newPrimary_E_RNTI := p_NewE_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_4CHSDPA
    },
    rb_InformationAffectedList := cs_RB_InformationAffectedListSRBs_EDCH_HSDSCH_r8,
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_deletedTransChInfoList :=  { cs_UL_TransportChannelIdDCH_r6(tsc_UL_DCH5) },
    ul_AddReconfTransChInfoList := {cs_UL_AddReconfTransChInfoE_DCH_MACiis_FDD},//E-DCH for DCCH and one DTCH
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD (cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
    dl_DeletedTransChInfoList := { cs_DL_TransportChannelIdentityDCH_r7(tsc_DL_DCH5) },
    dl_AddReconfTransChInfoList := {cs_DL_AddReconfTransChHSDSCHInfo_HSDPA_r9(cs_HSDSCH_Info_MACehs_r9 (cs_HARQ_Info_FDD, cs_AddOrReconfMAC_ehs_Reord2Q_r9 (tsc_MAC_ehs_Q0, tsc_MAC_ehs_Q1)))},
    mimoParameters := p_HSPA_Parameters.mimo_Parameters_r9,
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_OnlyHS_PDSCH_FDD (p_UL_ScramblingCode), //@sic R5-145758 sic@
    ul_EDCH_Information := cs_UL_EDCH_Information_r9_FDD,
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD(p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_SCCH_Info,
                                                               cs_Measurement_Feedback_Info_4CHSDPA(fc8)),
    dl_CommonInformation := cs_DL_CommonInformationF_DPCH_FDD_r10, //@sic R5-145758 sic@
    dl_InformationPerRL_List := cs_DL_InfoPerRL_HSUwithFDPCH_r8_FDD (p_PrimScramblingCode, p_FDPCH_SlotFormat, p_HSPA_Parameters.dl_FDPCH_Code),
    dl_SecondaryCellInfoFDD := cs_DL_SecondaryCellInfoDef_r10(p_NewH_RNTI,
                                                              p_HSPA_Parameters.hSPA_InfoPerCell[1],
                                                              p_PrimScramblingCodeFirstSecondary,
                                                              p_FirstSecondaryUarfcn,
                                                              cs_SecondaryCellMIMOParametersNewDef),
    additionalDLSecCellInfoListFDD := p_AdditionalDLSecCellInfoListFDD
  };

  template (value) RadioBearerSetup_r10_IEs cds_RadioBearerSetup_r10_IEs_A35_FDD(ActivationTime  p_ActTime,
                                                                                 H_RNTI   p_NewH_RNTI,
                                                                                 E_RNTI   p_NewE_RNTI,
                                                                                 UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                                                                 UL_ScramblingCode      p_UL_ScramblingCode,  //@sic R5-145758 sic@
                                                                                 PrimaryScramblingCode p_PrimScramblingCodeServing,
                                                                                 PrimaryScramblingCode p_PrimScramblingCodeFirstSecondary,
                                                                                 UARFCN                 p_FirstSecondaryUarfcn,
                                                                                 template (value) AdditionalDLSecCellInfoListFDD p_AdditionalDLSecCellInfoListFDD)
    modifies cs_RadioBearerSetup_r10_IEs_Omit :=
  {  // 34.108, IEs for Radio Bearer Setup A35, 3C case
     /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    newPrimary_E_RNTI := p_NewE_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_4CHSDPA
    },
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_SRBs_EDCH, //1 E-DCH added, 1 DCH reconfigured
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_Rx),
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoList_1DCH_HS_PS_HSDPA_MACehs_r9(cs_HARQ_Info_FDD),
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_Info_FDD (sf256, pl1, p_UL_ScramblingCode), //@sic R5-145758 sic@
    ul_EDCH_Information := cs_UL_EDCH_Information_r9_FDD,
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD(p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_SCCH_Info,
                                                               cs_Measurement_Feedback_Info_4CHSDPA(fc8)),
    dl_CommonInformation := cs_DL_CommonInfo_FDD_r10(cs_DL_DPCH_CfnHandling_Maintain_r6(omit), tsc_DL_DPCH1_SFP_SRB_3_4k, fixed, false),//@sic R5-145758 sic@
    dl_InformationPerRL_List := cs_DL_InfoPerRL_HSUwithDPCH_r8_FDD(p_PrimScramblingCodeServing,
                                                                   p_HSPA_Parameters.dl_DPCH_SFC, //64QAM dependent
                                                                   tsc_DL_DPCH1_2ndScrC),
    
    dl_SecondaryCellInfoFDD := cs_DL_SecondaryCellInfoDef_r10(p_NewH_RNTI,
                                                              p_HSPA_Parameters.hSPA_InfoPerCell[1],
                                                              p_PrimScramblingCodeFirstSecondary,
                                                              p_FirstSecondaryUarfcn),
    
    additionalDLSecCellInfoListFDD := p_AdditionalDLSecCellInfoListFDD
  };

}
