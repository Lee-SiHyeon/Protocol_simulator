module IMS_XML_Templates {

  import from CommonDefs all;
  import from urn_ietf_params_xml_ns_gruuinfo language "XSD" all;
  import from urn_ietf_params_xml_ns_reginfo language "XSD" all;

  type Contact.state                    RegInfo_Contact_State_Type;             /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Contact.event                    RegInfo_Contact_Event_Type;             /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Contact.unknown_param_list       RegInfo_Contact_UnknownParams_Type;     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Contact.unknown_param_list[-]    RegInfo_Contact_UnknownParam_Type;      /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Contact.elem_list                RegInfo_Contact_ElemList_Type;          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Reginfo.registration_list        RegInfo_RegistrationList_Type;          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Registration                     RegInfo_Registration_Type;              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Reginfo                          Reginfo_Type;                           /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
                                                                                   @sic R5s130474, R5s230374: encoding rule sic@ @sic R5w230106: encoding rule removed sic@ */

  type Reginfo_Type.state               Reginfo_State_Type;                     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type Registration.state               RegInfo_Registration_State_Type;        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type PubGruu                          PubGruu_Type;                           /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type TempGruu                         TempGruu_Type;                          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  template (value) Pub_gruu cs_XML_PubGruu(template (value) charstring p_PubGruuUri) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    uri := p_PubGruuUri
  };

  template (value) Temp_gruu cs_XML_TempGruu(template (value) charstring p_TempGruuUri,
                                             integer p_Cseq) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    first_cseq := p_Cseq,
    uri := p_TempGruuUri
  };

  /*
   * @desc      return GruuExtension
   * @param     p_PubGruu           (default value: omit)
   * @param     p_TempGruu          (default value: omit)
   * @return    RegInfo_Contact_ElemList_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_RegInfo_GruuExtension(template (omit) PubGruu p_PubGruu := omit,
                                    template (omit) TempGruu p_TempGruu := omit) return RegInfo_Contact_ElemList_Type
  { /* @sic R5w230106, R5s230374: PubGruu, TempGruu instead of PubGruu_Type, TempGruu_Type sic@ */

    var RegInfo_Contact_ElemList_Type v_ElemList := {};

    if (isvalue(p_PubGruu) and isvalue(p_TempGruu)) {
      v_ElemList[0] := f_Bit2XsdString(encvalue(p_PubGruu));
      v_ElemList[1] := f_Bit2XsdString(encvalue(p_TempGruu));
    }
    else if (isvalue(p_PubGruu) xor isvalue(p_TempGruu)) {
      FatalError(__FILE__, __LINE__, "");
    }
    return v_ElemList;
  }

  template (value) RegInfo_Contact_UnknownParam_Type cs_XML_UEInstance(charstring p_UEInstanceId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5-153760 - Support of GRUU: base is the content, name is "+sip.instance" sic@ */
    name := "+sip.instance",
    base := p_UEInstanceId  /* @sic R5-153760: f_HTML_Encoding; R5s160454: f_HTML_Encoding removed as percent-encoding is matter of the XML codec sic@ */
  };

  template (value) Registration cs_XML_RegistrationInfo(template (value) Contact p_Contact,
                                                        charstring p_Aor,
                                                        charstring p_Id,
                                                        RegInfo_Registration_State_Type p_State) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    aor := p_Aor,
    id := p_Id,
    state := p_State,
    contact_list := {
      p_Contact
    },
    elem_list := {}
  };

  template (value) Contact cs_XML_RegistrationContact(charstring p_ContactUri,
                                                      charstring p_Id,
                                                      RegInfo_Contact_State_Type p_State,
                                                      RegInfo_Contact_Event_Type p_Event,
                                                      template (omit)  charstring p_CallId := omit,
                                                      template (omit)  integer p_Cseq := omit,
                                                      template (omit)  integer p_Expires := omit,
                                                      template (value) RegInfo_Contact_UnknownParams_Type p_UnknownParams := {},
                                                      template (omit)  Pub_gruu p_PubGruu := omit,
                                                      template (omit)  Temp_gruu p_TempGruu := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    callid := p_CallId,
    cseq := p_Cseq,
    duration_registered := omit,
    event := p_Event,
    expires := p_Expires,
    id := p_Id,
    q := omit,
    retry_after := omit,
    state := p_State,
    uri := p_ContactUri,
    display_name := omit,
    unknown_param_list := p_UnknownParams,
    elem_list := fl_RegInfo_GruuExtension(p_PubGruu, p_TempGruu)
  };

  template (value) Reginfo cs_XML_Reginfo(Reginfo_State_Type p_State,
                                          integer p_Version,
                                          template (value) RegInfo_RegistrationList_Type p_Registrations) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    state := p_State,
    version := p_Version,
    registration_list := p_Registrations,
    elem_list := {}
  };

  /*
   * @desc      return RegInfo
   * @param     p_State             (default value: full)
   * @param     p_Version           (default value: 0)
   * @param     p_Registrations
   * @return    template (value) Reginfo
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_XML_RegInfo(Reginfo_State_Type p_State := full,
                         integer p_Version := 0,
                         template (value) RegInfo_RegistrationList_Type p_Registrations) return template (value) Reginfo
  {
    var template (value) Reginfo v_Reginfo := cs_XML_Reginfo(p_State, p_Version, p_Registrations);
    return v_Reginfo;
  }

}
