module IMS_CatM1_EmergencyCallTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_19 all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;

 /*
  * @desc      REFERENCE TS 34.229-1 clause J.19.1
  * @status    APPROVED (IMS)
  */
  function f_TC_J_19_1_IMS1() runs on IMS_PTC
  {
    var boolean v_GeolocationUsage := pc_IMS_Geolocation;

    f_IMS_CC_Preamble(IPCAN_EmergencyCall, IMS_REGISTERED);
    
    f_IMS_EmergencyCallWithEmergencyRegistration_IMS1(v_GeolocationUsage);

    f_IMS_CC_Postamble(IPCAN_EmergencyCall_NormalService);
  }

 /*
  * @desc      REFERENCE TS 34.229-1 clause J.19.1
  * @status    APPROVED (IMS)
  */
  function f_TC_J_19_1_IMS2() runs on IMS_PTC
  {
    var boolean v_GeolocationUsage := pc_IMS_Geolocation;

    f_IMS_EmergencyCallWithEmergencyRegistration_IMS2(v_GeolocationUsage);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.19.2
   * @status    APPROVED (IMS)
   */
  function f_TC_J_19_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_EmergencyCall, IMS_REGISTERED);
    
    f_IMS_EmergencyCallWithEmergencyRegistration_IMS1();

    f_IMS_CC_Postamble(IPCAN_EmergencyCall_NormalService);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.19.2
   * @status    APPROVED (IMS)
   */
  function f_TC_J_19_2_IMS2() runs on IMS_PTC
  {
    f_IMS_EmergencyCallWithEmergencyRegistration_IMS2();
  }

}
