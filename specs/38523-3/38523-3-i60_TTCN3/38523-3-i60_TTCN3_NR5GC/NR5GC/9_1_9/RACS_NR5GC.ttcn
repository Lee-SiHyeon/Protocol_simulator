module RACS_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_1_NR5GC() runs on NR5GC_PTC
  {
    //RACS / Network assigned UE radio capability ID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    f_NR5GC_Init_NAS(NR_2);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);

    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);       // @sic R5s211170 sic@
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))   {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    // Registration Accepted
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O)     // @sic R5-217901 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF);
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_1_Body();
    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellB, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_9_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_1_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();   // @sic R5s230450 sic@

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit REGISTRATION REQUEST message including the UE radio capability ID 1?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, cdr_NG_GMM_Cap_RACS, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cs_UERadioCapId('67'O, '01000000000010'O)  // @sic R5-217901 sic@
                                            )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    //@siclog "Steps 3-11" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 12" siclog@
    //SS transmits a REGISTRATION ACCEPT message with a new UE radio capability ID 2.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000020'O)   // @sic R5-217901 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Steps 13-18" siclog@
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF);

    //@siclog "Step 19" siclog@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 20" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_RACS, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cs_UERadioCapId('67'O, '01000000000020'O)  // @sic R5-217901 sic@
                                            )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    f_NR5GC_MobilityRegistration_Steps4_6 (v_NGC_NASCellB, v_GMM_MobilityInfo);
    } //End of fl_TC_9_1_9_1_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_2_NR5GC() runs on NR5GC_PTC
  {
    //RACS / UE configuration update / UE radio capability ID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    f_NR5GC_Init_NAS(NR_2);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);

    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);         // @sic R5s211355 sic@
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))  {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000050'O)   // @sic R5-217901 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF, rrcConnectionRelease);
    f_NR5GC_RRC_ConnectedState3N_Def(v_NGC_NASCellA);

    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_2_Body();
    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellB, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_9_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_2_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;

    //@siclog "Step 1" siclog@
    //The SS transmits CONFIGURATION UPDATE COMMAND including a new UE Radio Capability ID
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB2, -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_NG_CONFIGURATION_UPDATE_COMMAND(cs_ConfigUpdateInd('0'B, '1'B), -, -, -, -, -, -, -, -, -,
                                                                       -, -, -, -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000070'O)))));  // @sic R5-217901 sic@

    // @siclog "Step 2" siclog@
    SRB.receive (car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                                      cr_NG_CONFIGURATION_UPDATE_COMPLETE)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 3" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    // @siclog "Step 4" siclog@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableCellSSS_EPRE_FR1, tsc_NR_NonSuitableCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    // @siclog "Step 5" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_RACS, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cs_UERadioCapId('67'O, '01000000000070'O)))  // @sic R5-217901 sic@
    {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    f_NR5GC_MobilityRegistration_Steps4_6 (v_NGC_NASCellB, v_GMM_MobilityInfo);
    } //End of fl_TC_9_1_9_2_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_3_NR5GC() runs on NR5GC_PTC
  {
    //RACS / PLMN change within registration area / From NW assigned to Manufacturer assigned UE Radio Capability ID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NAS_PlmnId v_PLMN;// @sic R5s220983 sic@
    var TrackingAreaCode v_TAC;// @sic R5s220983 sic@
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;

    f_NR5GC_Init_NAS(NR_2);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);
    f_NR_CellConfig_Def(v_NGC_NASCellE);

    v_PLMN:= f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));// @sic R5s220983 sic@
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);// @sic R5s220983 sic@

    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))   {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    // Registration Accepted
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA),
                                                   cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)}));
    v_MsgToSend.registration_Accept.ueRadioCapabilityId := omit;
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF);

    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_3_Body();
    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellE, STATE_CONNECTED_3A_T3540, tsc_NR_RbId_SRB1);
  }

  /*
   * @desc      test body of TC_9_1_9_3
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_3_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;

    //@siclog "Step 1" siclog@
    //The SS configures:- NGC Cell B as the "Serving cell". - NGC Cell A, and NGC Cell E as a "Non-suitable 'Off' cell".
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit REGISTRATION REQUEST message including manufactured-assigned UE Radio Capability ID??
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_RACS, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cr_UERadioCapId_Manu('67'O)
                                            )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    //@siclog "Steps 3" siclog@
    //SS transmits a REGISTRATION ACCEPT message with a Network assigned UE radio capability ID and with PLMN ID of NGC Cell E included in the Equivalent PLMNs IE.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellB),
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellB)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellB))}),
                                                   cs_PLMN_List_1PLMN(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellE))),
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O));
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellB,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 4" siclog@
    //The UE transmits a REGISTRATION COMPLETE message.
    //Receive Registration Complete , No SRB2 so must be on SRB1
    f_NR5GC_Registration_Complete(v_NGC_NASCellB);
    //@siclog "Steps 5" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellB);

    //@siclog "Step 6" siclog@
    //The SS configures:- NGC Cell E as the "Serving cell".- NGC Cell A, and NGC Cell B as a "Non-suitable 'Off' cell".
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit REGISTRATION REQUEST message including manufactured-assigned UE Radio Capability ID?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_RACS, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cr_UERadioCapId_Manu('67'O)
                                            )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    //@siclog "Step 8" siclog@
    //SS transmits a REGISTRATION ACCEPT message with a Network assigned UE radio capability ID.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellE),
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellE)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellE))}),
                                                   -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O));
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 9" siclog@
    //The UE transmits a REGISTRATION COMPLETE message.
    //Receive Registration Complete , No SRB2 so must be on SRB1
    f_NR5GC_Registration_Complete(v_NGC_NASCellE);
    } //End of fl_TC_9_1_9_3_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_4_NR5GC() runs on NR5GC_PTC
  {
    //RACS / USIM change / Handling of URCID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    f_NR5GC_Init_NAS(NR_1);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    // Insert default sim card
    f_UT_USIM_Insert(UT, "Default USIM"); // @sic R5s240562 sic@
    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))  {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});
    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O)
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF, rrcConnectionRelease);
    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_4_Body();
    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_9_4
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_4_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var hexstring v_PLMN15 := '00111'H;
    var hexstring v_NewIMSIPLMN := substr(px_IMSI_Diff, 0, 5);

    //@siclog "Step 1" siclog@
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellA, STATE_IDLE_1A);

    //@siclog "Step 2" siclog@
    //The UE is brought back to operation with USIM configuration rr as defined in TS 38.508-1 [4] Table 6.4.1-rr.
    f_UT_USIM_Insert(UT, "USIM configuration 25 specified in table 6.4.1-25 TS 38.508-1");         // @sic R5-223252 sic@

    f_NR5GC_SwitchOnAndResetIMS();   // @sic R5s230338 sic@

    // this new USIM has a different IMSI @sic R5s230215 sic@
    if (not match (v_NewIMSIPLMN, v_PLMN15)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "New USIM must have PLMN Id 15");
    }
    f_NR5GC_MobileInfo_SetDefaultIMSI(px_IMSI_Diff);

    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message without including UE radio capability ID?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, omit)
                                            ) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    //@siclog "Steps 4-19a1" siclog@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity); // @sic R5s230215 sic@

    } //End of fl_TC_9_1_9_4_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_5_NR5GC() runs on NR5GC_PTC
  {
    //RACS / Handling of delete indication for NW assigned UE radio capability ID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    f_NR5GC_Init_NAS(NR_2);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);

    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))  {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    //@sic R5s220203 sic@
    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O)    // @sic R5-217901 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF, rrcConnectionRelease);
    f_NR5GC_RRC_ConnectedState3N_Def(v_NGC_NASCellA);

    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_5_Body();
    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellB, STATE_IDLE_1A);    //@sic R5-216279 sic@
  }

  /*
   * @desc      test body of TC_9_1_9_5
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_5_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var NR_SRB_COMMON_IND v_ReceivedAsp;

    //@siclog "Step 1" siclog@
    //The SS transmits CONFIGURATION UPDATE COMMAND including UE radio capability ID deletion indication.
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB2, -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_NG_CONFIGURATION_UPDATE_COMMAND(cs_ConfigUpdateInd('1'B, '1'B), -, -, -, -, -, -, -, -, -,
                                                                       -, -, -, -, -, -, -, -, -, -, cs_UERadioCapIdDeletion('A'H))))); // @sic R5s240220 R5s240555 sic@

    // @siclog "Step 2" siclog@
    SRB.receive (car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                                      cr_NG_CONFIGURATION_UPDATE_COMPLETE)));
    //@siclog "Step 3" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 4" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message and does not include any Network-assigned UE radi capability ID?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility  // @sic R5-217901 sic@
    )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }else if (ispresent(v_ReceivedMsg.Pdu.Msg.registration_Request.ueRadioCapabilityId))       //@sic R5-221538 sic@
    {
      if (match (v_ReceivedMsg.Pdu.Msg.registration_Request.ueRadioCapabilityId, cs_UERadioCapId('67'O, '01000000000010'O))) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step4: Network-assigned UE radio capability ID included");}
    }
    else {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    //@siclog "Step 5" siclog@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000020'O)    // @sic R5-217901 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 6" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellA);

    //@siclog "Step 7" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 8" siclog@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    // @sic R5-221538 sic@
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 9" siclog@
    //The UE initiates a Registration procedure for mobility registration update by transmitting a REGISTRATION REQUEST message on NGC Cell B and includes the UE radio capability ID assigned at step 5.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, cs_UERadioCapId('67'O, '01000000000020'O)  // @sic R5-217901 sic@
                                            )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Step 10" siclog@
    //The SS transmits REGISTRATION ACCEPT message including UE radio capability ID deletion indication.
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellB);                         //@sic R5s211655 sic@
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});     //@sic R5s211655 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, -, cs_UERadioCapIdDeletion ('E'H)
                                                   );
    v_MsgToSend.registration_Accept.ueRadioCapabilityId := omit;   // @sic R5-232332 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellB, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 11" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellB);

    //@siclog "Step 12" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message and does not include any Network-assigned UE radio capability ID?
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellB, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;    //@sic R5s211655 sic@
    v_ReceivedMsg := v_ReceivedAsp.Signalling.Nas[0];
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)){
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    } else if (ispresent(v_ReceivedMsg.Pdu.Msg.registration_Request.ueRadioCapabilityId))       //@sic R5-221538 sic@
    {
      if (match (v_ReceivedMsg.Pdu.Msg.registration_Request.ueRadioCapabilityId, cs_UERadioCapId('67'O, '01000000000020'O))) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step12: Network-assigned UE radio capability ID included");}
    }
    else {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    }

    //@siclog "Step 13" siclog@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList
                                                   );
    v_MsgToSend.registration_Accept.ueRadioCapabilityId := omit;   // @sic R5s221333 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellB, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));   //@sic R5s211655 sic@

    //@siclog "Step 14" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellB, tsc_NR_RbId_SRB1);    //@sic R5s211655 sic@

    //@siclog "Step 15" siclog@
    f_NR_RRCRelease(v_NGC_NASCellB); //@sic R5-216279 sic@

    } //End of fl_TC_9_1_9_5_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.9.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_9_6_NR5GC() runs on NR5GC_PTC
  {
    //RACS / Change in radio capability / NW assigned URCID
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    f_NR5GC_Init_NAS(NR_1);

    // Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    v_GMM_MobilityInfo := f_NR5GC_Preamble_Steps1_13 (v_NGC_NASCellA);
    if (not match (v_GMM_MobilityInfo.GMMCap, cdr_NG_GMM_Cap_RACS))   {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    // Registration Accepted
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000010'O)     // @sic R5-227574 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF, rrcConnectionRelease);

    f_NR_TestBody_Set(true);
    fl_TC_9_1_9_6_Body();
    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_CONNECTED_3A, tsc_NR_RbId_SRB1);    // @sic R5s221251 sic@
  }

  /*
   * @desc      test body of TC_9_1_9_6
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_9_6_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var TrackingAreaCode v_TAC;
    var template (value) NG_TrackingAreaIdList v_TAIList;

    //@siclog "Step 1" siclog@
    //Cause the UE to change the radio capability configuration.
    f_UT_ChangeRAC_Id(UT);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit REGISTRATION REQUEST message including 'NG-RAN-RCU'? bit and the UE radio capability ID#1 (assigned during preamble)?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, -, -, -,
                                            -, -, -, -, -, -, -, -, -, -,
                                            -, -, -, -, -, cr_NG_Update ('1'B))    // @sic R5-227574 sic@
                                            ) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    //@siclog "Step 3" siclog@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_UERadioCapId('67'O, '01000000000020'O)     // @sic R5-227574 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Steps 4" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellA);
    } //End of fl_TC_9_1_9_6_Body

}
