  template (value) NR_MAC_CE_SubPDU_DL_Type cs_NR_MAC_CE_SubPDU_DL(template (value) NR_MAC_PDU_SubHeader_Type p_SubHeader,
                                                                   template (omit) NR_MAC_ControlElementDL_Type p_ControlElement := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
