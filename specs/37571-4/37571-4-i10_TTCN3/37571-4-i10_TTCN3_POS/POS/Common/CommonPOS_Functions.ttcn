                                                                     cs_NavigationModel_Galileo(p_RetrievedGenericAssistData[i].gnss_NavigationModel),
                                                                     cs_GNSS_AcquisitionAssistance(cs_GNSS_SignalID(fl_DetermineGalileo_SignalID_GNSS_AcquAssist()), // Galileo E1 or E5A
                                                                                                   fl_Build_cs_GNSS_AcquisitionAssistList(tsc_IntList_3_5_13_15_21_27, //@sic R5-215711 sic@
                                                                                                                                          p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.gnss_AcquisitionAssistList),
                                                                                                   p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.confidence_r10),
                                                                     cs_GNSS_Almanac_Galileo(p_RetrievedGenericAssistData[i].gnss_Almanac));
      //Now remove those elements not needed depending on the case
      if (not (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS)) { //Only present if GPS is also supported
        v_GenericAssistDataElement.gnss_TimeModels := omit;
      }
      if (p_UEB) { // UE-Based case
        v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        v_GenericAssistDataElement.gnss_Almanac := omit;
      }
      else { //UE-Assisted case
        if (pc_GNSS_AA) { // UE supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_NavigationModel := omit;
          v_GenericAssistDataElement.gnss_Almanac := omit;
        }
        else { // UE does not supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        }
      }
    }
    return v_GenericAssistDataElement;
  }

  /*
   * @desc      Selects template to provide GNSS-GenericAssistDataElement for A-BDS
   * @param     p_RetrievedGenericAssistData
   * @param     p_UEB
   * @return    template (value) GNSS_GenericAssistDataElement
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplate_GenericAssistDataElement_BDS(GNSS_GenericAssistData p_RetrievedGenericAssistData,
                                                             boolean p_UEB) return template (value) GNSS_GenericAssistDataElement
  {
    var template (value) GNSS_GenericAssistDataElement v_GenericAssistDataElement;
    var integer i := f_POS_FindIndexForGNSSMethod(p_RetrievedGenericAssistData, cs_GNSS_ID_Bds); //Indicates the position of the BDS data in the retrieved data
    var IntegerList_Type v_SV_IDs := tsc_IntList_38_40_42_43_59_60;
    var template (value) GNSS_NavigationModel v_GNSS_NavigationModel := cs_NavigationModel_Bds(p_RetrievedGenericAssistData[i].gnss_NavigationModel);

    if (i == -1) {//BDS element was not found in the list
      FatalError (__FILE__, __LINE__, "Invalid CellId"); // This function is only called if PICS indicate BDS support. If BDS assistance data is not there, it is a FatalError
    }
    else {
     if (pc_BDS2_Only){ //@sic R5-247329 sic@
        v_SV_IDs := tsc_IntList_1_2_6_7_11_12;
        v_GNSS_NavigationModel := cs_NavigationModel_Bds_Bds2(p_RetrievedGenericAssistData[i].gnss_NavigationModel);
      }
      //Include all possible elements in the template
      // @sic R5-240554 sic@
      v_GenericAssistDataElement := cs_GNSS_GenericAssistDataElement(cs_GNSS_ID_Bds,
                                                                     cs_GNSS_TimeModelList(tsc_GNSS_TO_ID_GPS, p_RetrievedGenericAssistData[i].gnss_TimeModels[0]),
                                                                     v_GNSS_NavigationModel, //@sic R5-247329 sic@
                                                                     cs_GNSS_AcquisitionAssistance(cs_GNSS_SignalID(fl_DetermineBDS_SignalID_GNSS_AcquAssist()), // Beidou B1I or B1C
                                                                                                   fl_Build_cs_GNSS_AcquisitionAssistList(v_SV_IDs, //@sic R5-215711, R5-247329 sic@
                                                                                                                                          p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.gnss_AcquisitionAssistList),
                                                                                                   p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.confidence_r10),
                                                                     cs_GNSS_Almanac_Bds(p_RetrievedGenericAssistData[i].gnss_Almanac),
                                                                     -,
                                                                     fl_Build_cs_GNSS_AuxiliaryInformation(v_SV_IDs,  //@sic R5-241577, R5s240301, R5-247329 sic@
                                                                                                           p_RetrievedGenericAssistData[i].gnss_AuxiliaryInformation));
      //Now remove those elements not needed depending on the case
      if (not (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS)) { //Only present if GPS is also supported
        v_GenericAssistDataElement.gnss_TimeModels := omit;
      }
      //@sic R5-206424 sic@
      if (not pc_BDS_B1C or pc_BDS_B2a or pc_BDS_B3I) { // UE does not supports multiple BDS signals -> Do not include Auxiliary Information (37.571-2, Table 5.4.1.1-1) @sic R5-230336 sic@
        v_GenericAssistDataElement.gnss_AuxiliaryInformation := omit;
      }
      if (p_UEB) { // UE-Based case
        v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        v_GenericAssistDataElement.gnss_Almanac := omit;
      }
      else { //UE-Assisted case
        if (pc_GNSS_AA) { // UE supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_NavigationModel := omit;
          v_GenericAssistDataElement.gnss_Almanac := omit;
        }
        else { // UE does not supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        }
      }
    }
    return v_GenericAssistDataElement;
  }

   /*
   * @desc      Indicates the position of the element identified by p_GNSS_ID inside the retrieved generic assistance data list.
   *            A return value of -1 indicates that the element was not found in the list.
   * @param     p_RetrievedGenericAssistData
   * @param     p_GNSS_ID
   * @return    integer
   * @status    APPROVED (POS)
   */
  function f_POS_FindIndexForGNSSMethod(GNSS_GenericAssistData p_RetrievedGenericAssistData,
                                        template (value) GNSS_ID p_GNSS_ID) return integer
  {
    var integer i:=0;
    var boolean v_Found := false;
    var integer l := lengthof(p_RetrievedGenericAssistData); //Number of elements in the list

    do {
      if (match (p_RetrievedGenericAssistData[i].gnss_ID, p_GNSS_ID)) {
        v_Found := true;
      }
      else {
        i:=i+1;
      }
    } while (not v_Found and i<l); // check for the length of the list

    if (not v_Found) {
      i:= -1;
    }

    return i;
  }

   /*
   * @desc      Indicates the position of the element identified by p_GNSS_ID inside the generic assistance data request list.
   *            A return value of -1 indicates that the element was not found in the list.
   * @param     p_GenericAssistDataReq
   * @param     p_GNSS_ID
   * @return    integer
   * @status    APPROVED (POS)
   */
  function f_POS_FindIndexForGNSSMethodReq(GNSS_GenericAssistDataReq p_GenericAssistDataReq,
                                           template (value) GNSS_ID p_GNSS_ID) return integer
  {
    var integer j:=0;
    var boolean v_Found := false;
    var integer l:= lengthof (p_GenericAssistDataReq); //Number of elements in the list

    do {
      if (match (p_GenericAssistDataReq[j].gnss_ID, p_GNSS_ID)) {
        v_Found := true;
      }
      else {
        j:=j+1;
      }
    } while (not v_Found and j<l); // check for the length of the list

    if (not v_Found) {
      j:= -1;
    }

    return j;
  }

  /*
   * @desc      Convers type GNNS_ID into a charstring. Used in logging functions.
   * @param     p_GnssId
   * @return    charstring
   * @status    APPROVED (POS)
   */
  function f_POS_GnssId2charstring(GNSS_ID p_GnssId) return charstring
  {
    var charstring v_GnssIdString;

    select (p_GnssId.gnss_id) {
      case (gps) {
        v_GnssIdString := "gps";
      }
      case (sbas) {
        v_GnssIdString := "sbas";
      }
      case (qzss) {
        v_GnssIdString := "qzss";
      }
      case (galileo) {
        v_GnssIdString := "galileo";
      }
      case (glonass) {
        v_GnssIdString := "glonass";
      }
      case (bds) {
        v_GnssIdString := "bds";
      }
      case else {
        FatalError(__FILE__, __LINE__, "invalid value");
      }
    }
    return v_GnssIdString;
  }

  /*
   * @desc      To check GNSS Positioning modes supported
   * @param     p_PositioningModes
   * @param     p_CheckingFTA       (default value: false)
   * @return    boolean
   * @status    APPROVED (POS)
   */
  function f_POS_CheckAgnssPositioningModes(PositioningModes p_PositioningModes,
                                            boolean p_CheckingFTA := false) return boolean
  { //@sic R5s170432 sic@
    var boolean v_PosModesUeBased := false;
    var boolean v_PosModesUeAssisted := false;

    select (lengthof(p_PositioningModes.posModes)) {
      case (1) {
        v_PosModesUeBased := false;
        v_PosModesUeAssisted := false;
      }
      case (2) {
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := false;
      }
      case else {
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 2);
      }
    }

    if (not p_CheckingFTA) {
      return ((pc_UEB_AGNSS == v_PosModesUeBased) and      //Check ue-based
              (pc_UEA_AGNSS == v_PosModesUeAssisted));     //Check ue-assisted
    }
    else { //Checking FTA
      return ((pc_GNSS_FTA_UEB == v_PosModesUeBased) and   //Check FTA ue-based
              (pc_GNSS_FTA_UEA == v_PosModesUeAssisted));  //Check FTA ue-assisted
    }
  }

  /*
   * @desc      Assisting function for f_CheckUE_SupportedEUTRA_Bands_ChunkOtdoa.
   *            Compares consecutive bits from band capabilities with the corresponding pics values.
   * @param     p_OtdoaProvideCapabilities
   * @param     p_DerivedChunk
   * @param     p_Offset
   * @param     p_Length
   * @status    APPROVED (POS)
   */
  function  f_CheckUE_SupportedEUTRA_Bands_ChunkOtdoa(OTDOA_ProvideCapabilities p_OtdoaProvideCapabilities,
                                                      bitstring p_DerivedChunk,
                                                      integer p_Offset,
                                                      integer p_Length)
  {
    var OTDOA_ProvideCapabilities v_ReceivedCapabilityMsg := p_OtdoaProvideCapabilities;
    var bitstring v_DerivedChunk := p_DerivedChunk;
    var integer v_OffsetPICS := p_Offset;
    var integer v_LengthPICS := p_Length;
    var integer i;
    var integer j;
    var integer v_BandEUTRA;
    var integer v_BitStringIndex;
    var bitstring v_SuppEutraBandsReported := int2bit(0, 64); // 1... maxbands
    var integer v_MaxBandsReported := lengthof(v_ReceivedCapabilityMsg.supportedBandListEUTRA); // @sic R5s150589 sic@

    // It is no longer checked that number of supported EUTRA bands match the set PICS parameters (pc_eBanda_Supp)
    // There may be more bands reported than there are PICS defined for bands

    // Check that any value B such that pc_eBandB_Supp is TRUE and different from all eutra-Band[k] where k = 1 to a - 1
    // Go through the received supportedBandListEUTRA and match against the supported bands according to the PICS
    //@sic R5s150589 sic@
    for (i := 0; i < v_LengthPICS; i := i + 1) {
      //It is assumed that UE reports the bands in any order => compare against the complete list
      if (v_DerivedChunk [i] == '1'B) { // PICS for band i in chunk + 1 is set
        for (j := 0; j < v_MaxBandsReported; j := j + 1) { // check against all reported bands
          v_BandEUTRA := v_ReceivedCapabilityMsg.supportedBandListEUTRA[j].bandEUTRA;
          v_BitStringIndex := v_BandEUTRA - 1;
          if ( (i + v_OffsetPICS) == v_BitStringIndex) {
            if (v_SuppEutraBandsReported[v_BitStringIndex] == '1'B) {
              f_SetVerdict(fail, __FILE__, __LINE__, "support of EUTRA band No. " & int2str(v_BandEUTRA) &  " is reported more than once"); // error: duplicate found @sic R5s240460 add. change sic@
            } else {
              v_SuppEutraBandsReported[v_BitStringIndex] := '1'B;
            };
          }
          else {// do nothing
          }
        }
      //@sic R5s170733 sic@
      }
      else { // PICS is not set => non support
        for (j := 0; j < v_MaxBandsReported; j := j + 1) { // check against all reported bands
          v_BandEUTRA := v_ReceivedCapabilityMsg.supportedBandListEUTRA[j].bandEUTRA;
          v_BitStringIndex := v_BandEUTRA - 1;
          if ( (i + v_OffsetPICS) == v_BitStringIndex) {
            f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported capability for EUTRA band No. " & int2str(v_BandEUTRA)); // PICS mismatch @sic R5s240460 add. change sic@
          }
          else { // do nothing
          }
        }
      }
      // NOTE:  number of bands reported by the UE and number of bands acc. to PICS setting may not be equal. None of the bands is reported twice by the UE.
    }
  }

  /*
   * @desc      Function to convert the PICS parameters pc_eBand65_Supp to pc_eBand256_Supp from single booleans to a bitstring.
   *            The leftmost bit represent eBand65 support ('1'B if supported according to PICS pc_eBand65_Supp
   *            and '0'B if not supported according to PICS pc_eBand65_Supp).
   * @return    bitstring
   * @status    APPROVED (POS)
   */
  function f_DeriveSuppEutraBandsFromPics_v9a0() return bitstring
  {  //@sic R5s170733 sic@
    var bitstring v_Bitstring := f_ConvertBoolToBit(pc_eBand65_Supp) &
                                 f_ConvertBoolToBit(pc_eBand66_Supp) &
                                 f_ConvertBoolToBit(pc_eBand67_Supp) & //@sic R5-236579 sic@
                                 f_ConvertBoolToBit(pc_eBand68_Supp) &
                                 f_ConvertBoolToBit(pc_eBand69_Supp) & //@sic R5-176304 sic@
                                 f_ConvertBoolToBit(pc_eBand70_Supp) &
                                 f_ConvertBoolToBit(pc_eBand71_Supp) &
                                 f_ConvertBoolToBit(pc_eBand72_Supp) &
                                 f_ConvertBoolToBit(pc_eBand73_Supp) &
                                 f_ConvertBoolToBit(pc_eBand74_Supp) &
                                 f_ConvertBoolToBit(pc_eBand85_Supp) &
                                 f_ConvertBoolToBit(pc_eBand87_Supp) &
                                 f_ConvertBoolToBit(pc_eBand88_Supp) &
                                 f_ConvertBoolToBit(pc_eBand103_Supp) &
                                 f_ConvertBoolToBit(pc_eBand255_Supp) &
                                 f_ConvertBoolToBit(pc_eBand256_Supp);
    return v_Bitstring;
  }

  /*
   * @desc      Returns the GNSS ID Bitmap for the supported GNSS methods
   * @param     p_GNSS_List
   * @return    bitstring
   * @status    APPROVED (POS)
   */
  function f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(PositioningSystemList_Type p_GNSS_List) return bitstring
  {
  //@sic R5-172963 sic@
    var integer i;
    var bitstring v_GnssId :='000000'B;

    for (i:=0; i<lengthof(p_GNSS_List); i:=i+1) {
      if (p_GNSS_List[i] == gps or p_GNSS_List[i] == modernizedGPS) { //@sic R5s201460 sic@
        v_GnssId [0] := '1'B;
      }
      else if (p_GNSS_List[i] == galileo) {
        v_GnssId [3] := '1'B;
      }
      else if (p_GNSS_List[i] == glonass) {
        v_GnssId [4] := '1'B;
      }
      else if (p_GNSS_List[i] == bds) {
        v_GnssId [5] := '1'B;
      }
      else {
        FatalError (__FILE__, __LINE__, "Unknown GNSS method");
      }
    }
    return v_GnssId;
  }

  /*
   * @desc      Selects the corresponding position technology to clear depending on subtest
   * @param     p_Subtest
   * @return    bitstring
   * @status    APPROVED (POS)
   */
   function f_SetClearTech (integer p_Subtest) return bitstring
   { // @sic R5-246428: added Rel-18 subtests sic@
    var bitstring v_UEPosTech := ''B;

    select (p_Subtest) {
      case (11, 17){ //WLAN
        v_UEPosTech := tsc_WlanUEPosTech;
      }
      case (12, 16, 23){ //MBS
        v_UEPosTech := tsc_MbsUEPosTech;
      }
      case (13){ //Bluetooth
        v_UEPosTech := tsc_BluetoothUEPosTech;
      }
      case (14, 18, 24){ //Sensor
        v_UEPosTech := tsc_SensorUEPosTech;
      }
      case (15, 25) { // A-GNSS
        v_UEPosTech := tsc_AgnssUEPosTech;
      }
      case (19, 26, 30) { // Multi-RTT
        v_UEPosTech := tsc_MultiRttUEPosTech;
      }
      case (20, 27, 31) { // DL-AoD
        v_UEPosTech := tsc_DlAodUEPosTech;
      }
      case (21, 28, 32) { // DL-TDOA
        v_UEPosTech := tsc_DlTdoaUEPosTech;
      }
      case else{
        FatalError (__FILE__, __LINE__, "Invalid Subtest");
      }
    }
    return v_UEPosTech;
   }

  /*
   * @desc      Function to determine if the UE supports Multi-frequency AGNSS from PICS values
   * @return    boolean
   * @status    APPROVED (POS)
   */
  function f_MultiFreqAGNSS() return boolean
  {//@sic R5-197164 sic@
    var boolean v_MultiFreqAGNSS := false;

    if (pc_A_GPS_L2C or pc_A_GPS_L5 or pc_QZSS_QZS_L1C or pc_QZSS_QZS_L2C or pc_QZSS_QZS_L5 or pc_GLONASS_G2 or pc_GLONASS_G3 or pc_GALILEO_E5a or pc_GALILEO_E5b or pc_GALILEO_E6 or pc_GALILEO_E5aE5b or pc_BDS_B1C or pc_BDS_B2a or pc_BDS_B3I) { //@sic R5-206424, R5-230336 sic@
      v_MultiFreqAGNSS := true;
    }
    return v_MultiFreqAGNSS;
  }

  /*
   * @desc      To build the data to be sent to the UE based on what the UE requested in p_RequestAssitData.
   * @param     p_UEB
   * @param     p_RequestAssistData
   * @param     p_ProvideAssistData
   * @return    template (value) A_GNSS_ProvideAssistanceData
   * @status    APPROVED (POS)
   */
  function f_POS_AgnssProvideAssistanceData_UEReq (boolean p_UEB,
                                                   RequestAssistanceData_r9_IEs p_RequestAssistData,
                                                   ProvideAssistanceData_r9_IEs p_ProvideAssistData) return template (value) A_GNSS_ProvideAssistanceData
  { /* @sic R5s130627 sic@ */
    var template (value) A_GNSS_ProvideAssistanceData v_GNSS_ProvideAssistData;

    //Initialize with default data
    v_GNSS_ProvideAssistData := cs_AgnssProvideAssistData(f_POS_SelectTemplateProv_ReferenceTime(p_ProvideAssistData),
                                                          f_POS_SelectTemplateProv_ReferenceLocation(p_ProvideAssistData, p_UEB),
                                                          f_POS_SelectTemplateProv_IonosphericModel(p_ProvideAssistData, p_UEB),
                                                          f_POS_SelectTemplateProv_GenericAssistData(p_ProvideAssistData, p_UEB));

    //Remove those IE not requested by the UE
    //Common IEs
    if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_CommonAssistDataReq.gnss_ReferenceTimeReq)) {
      v_GNSS_ProvideAssistData.gnss_CommonAssistData.gnss_ReferenceTime:= omit;
    }
    if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_CommonAssistDataReq.gnss_ReferenceLocationReq)) {
      v_GNSS_ProvideAssistData.gnss_CommonAssistData.gnss_ReferenceLocation := omit;
    }
    if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_CommonAssistDataReq.gnss_IonosphericModelReq)) {
      v_GNSS_ProvideAssistData.gnss_CommonAssistData.gnss_IonosphericModel:= omit;
    }

    //Generic IEs: Check each possible GNSS method element
    v_GNSS_ProvideAssistData := f_POS_CheckWhatGenericAssistDataWasRequested(cs_GNSS_ID_Gps,
                                                                             p_RequestAssistData,
                                                                             v_GNSS_ProvideAssistData);
    v_GNSS_ProvideAssistData := f_POS_CheckWhatGenericAssistDataWasRequested(cs_GNSS_ID_Glonass,
                                                                             p_RequestAssistData,
                                                                             v_GNSS_ProvideAssistData);
    v_GNSS_ProvideAssistData := f_POS_CheckWhatGenericAssistDataWasRequested(cs_GNSS_ID_Galileo,
                                                                             p_RequestAssistData,
                                                                             v_GNSS_ProvideAssistData);
    v_GNSS_ProvideAssistData := f_POS_CheckWhatGenericAssistDataWasRequested(cs_GNSS_ID_Bds,
                                                                             p_RequestAssistData,
                                                                             v_GNSS_ProvideAssistData);
    return v_GNSS_ProvideAssistData;
  }

  /*
   * @desc      Check what the UE requested for the assistance data element indicated by p_GNSS_ID and removes those IEs not requested.
   * @param     p_GNSS_ID
   * @param     p_RequestAssistData
   * @param     p_ProvideAssistData
   * @return    template (value) A_GNSS_ProvideAssistanceData
   * @status    APPROVED (POS)
   */
  function f_POS_CheckWhatGenericAssistDataWasRequested(template (value) GNSS_ID p_GNSS_ID,
                                                        RequestAssistanceData_r9_IEs p_RequestAssistData,
                                                        template (value) A_GNSS_ProvideAssistanceData p_ProvideAssistData) return template (value) A_GNSS_ProvideAssistanceData
  {
    var integer i;
    var integer j;
    var template (value) A_GNSS_ProvideAssistanceData v_GNSS_ProvideAssistData := p_ProvideAssistData;

    i := f_POS_FindIndexForGNSSMethod(valueof(p_ProvideAssistData.gnss_GenericAssistData), p_GNSS_ID); //generic data to be provided for p_GNSS_ID is at index i
    j := f_POS_FindIndexForGNSSMethodReq(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq, p_GNSS_ID); //generic data requested by the UE for p_GNSS_ID is at index j
    if ((i != -1) and (j != -1)) { //index are valid
      if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_TimeModelsReq)) {
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_TimeModels := omit;
      }   //@sic R5s150439 sic@
      if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_NavigationModelReq)) {
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_NavigationModel:= omit;
      }   //@sic R5s150439 sic@
      if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_AcquisitionAssistanceReq)) {
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_AcquisitionAssistance:= omit;
      } //@sic R5s150439 sic@
      if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_AlmanacReq)) {
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_Almanac:= omit;
      } //@sic R5s150439 sic@
      if (not ispresent(p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_UTCModelReq)) {
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_UTC_Model := omit;
      }   //@sic R5s150439 sic@
      if (not ispresent (p_RequestAssistData.a_gnss_RequestAssistanceData.gnss_GenericAssistDataReq[j].gnss_AuxiliaryInformationReq)){
        v_GNSS_ProvideAssistData.gnss_GenericAssistData[i].gnss_AuxiliaryInformation := omit;
      } //@sic R5s150439 sic@
    }
    return v_GNSS_ProvideAssistData;
  }

}
