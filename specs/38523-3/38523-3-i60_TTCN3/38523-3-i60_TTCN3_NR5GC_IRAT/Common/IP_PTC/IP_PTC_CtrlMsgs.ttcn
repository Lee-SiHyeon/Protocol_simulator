module IP_PTC_CtrlMsgs {

  import from CommonDefs all;
  import from CommonIP all;
  import from IP_ASP_TypeDefs all;
  import from IP_PTC_Templates all;

  type record IP_StartPDN_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId,
    IP_DrbInfo_Type     DrbInfo
  };

  type union IP_StopPDN_Type {          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Null_Type           All,
    PDN_Index_Type      PdnId
  };

  type record IP_StartWLAN_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    WLAN_AddressInfo_Type AddressInfo,
    IP_DrbInfo_Type     DrbInfo,
    boolean             ExplicitDnsHandling     /* if set, DNS handling shall be not done implicitly by the IP_PTC but explicitly in the test case
                                                   @sic R5-169075 (test case 20.1) sic@ */
  };

  type record IP_StopWLAN_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
  };

  type record IP_ChangeDrbInfo_Type {   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId,
    IP_DrbInfo_Type     DrbInfo
  };

  type record IP_SendRouterAdvertisement_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId
  };

  type union IP_ExplicitRouting_Type {          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_RoutingInfo_Type Add,
    IP_Connection_Type  Remove
  };

  type octetstring IP_DnsQuery_Type;            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type octetstring IP_DnsResponse_Type;         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type union IP_ConfigReq_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_StartPDN_Type                    StartPDN,
    IP_StopPDN_Type                     StopPDN,                /* @sic R5s131000: Null_Type replaced by IP_Stop_Type sic@ */
    IP_StartWLAN_Type                   StartWLAN,
    IP_StopWLAN_Type                    StopWLAN,
    Null_Type                           GeranCnf,               /* e.g. to confirm GeranTrigger */
    IP_ChangeDrbInfo_Type               ChangeDrbInfo,          /* @sic R5s150648 Change 5.1 sic@ */
    AnyCellId_Type                      ChangeCell,             /* @sic R5s150648 Change 5.1 sic@ @sic R5s210603: AnyCellId_Type instead of EUTRA_CellId_Type sic@ */
    IP_SendRouterAdvertisement_Type     SendRouterAdvertisement,
    IP_ExplicitRouting_Type             ExplicitRouting,        /* @sic R5s130681 change 3: handling of RTP data; R5s160131: Start/Stop sic@ */
    Null_Type                           ChangeToRawmode,        /* @sic R5s150074 - Additional change sic@ */
    Null_Type                           RestoreRoutingTable,    /* @sic R5s200044 change 4 sic@ */
    IP_DnsResponse_Type                 DnsResponse             /* @sic R5-169075 (test case 20.1) sic@ */
  };

  type union IP_Indication_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN)
                                           @sic R5-133612: trigger to GERAN sic@ */
    Null_Type                   Cnf,
    IP_DrbInfo_Type             GeranTrigger,
    IP_DnsQuery_Type            DnsQuery                  /* @sic R5-169075 (test case 20.1) sic@ */
  };

  type port IP_RAT_CTRL_PORT message {         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    out IP_ConfigReq_Type;
    in  IP_Indication_Type;
  };

  type port IP_PTC_CTRL_PORT message {         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    in  IP_ConfigReq_Type;
    out IP_Indication_Type;
  };

  template (value) IP_ConfigReq_Type cs_IP_StartPdnReq(PDN_Index_Type p_PdnId,
                                                       template (value) IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    StartPDN := {
      PdnId := p_PdnId,
      DrbInfo := p_DrbInfo
    }
  };

  template (value) IP_ConfigReq_Type cs_IP_ChangeToRawmode := {ChangeToRawmode := true};         /* @status    APPROVED (ENDC, IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */

  template (value) IP_ConfigReq_Type cs_IP_RestoreRoutingTable := {RestoreRoutingTable := true}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */

  template (value) IP_StopPDN_Type cs_IP_StopAllPDNs := {All := true};                           /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_StopPDN_Type cs_IP_StopPDN(PDN_Index_Type p_PdnId) := {PdnId := p_PdnId};  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */

  template (value) IP_ConfigReq_Type cs_IP_StopPdnReq(template (value) IP_StopPDN_Type p_IP_StopPDN) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    /* @sic R5s131000: new parameter p_IP_Stop sic@ */
    StopPDN := p_IP_StopPDN
  };

  template (value) IP_ConfigReq_Type cs_IP_ChangeEutraCellReq(EUTRA_CellId_Type p_EutraCellId) :=
  { /* @sic R5-125676: new parameter p_DrbId sic@ */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    ChangeCell := {           /* @sic R5s210603 sic@ */
      Eutra := p_EutraCellId  /* @sic R5s150648 Change 5.2 sic@ */
    }
  };

  template (value) IP_ConfigReq_Type cs_IP_ChangeNrCellReq(NR_CellId_Type p_NrCellId) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    ChangeCell := {
      Nr := p_NrCellId
    }
  };

  template (value) IP_ConfigReq_Type cs_IP_ChangeDrbInfoReq(PDN_Index_Type p_PdnId,
                                                            template (value) IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    ChangeDrbInfo := {
      PdnId := p_PdnId,
      DrbInfo := p_DrbInfo
    }
  };

  template (value) IP_ConfigReq_Type cs_IP_ConfigureDiscardDataLoopbackDataReq(InternetProtocol_Type p_Protocol,
                                                                               PortNumber_Type  p_MediaPort,
                                                                               template (omit) IP_AddrInfo_Type p_IpAddrRemoteUE,
                                                                               template (value) IP_DrbInfo_Type p_DrbInfo,
                                                                               IP_DataMode_Type p_DataMode) :=
  { /* NOTE: p_IpAddrRemoteUE the IP address of the simulated remote UE (i.e. a 'local' (SS) address in terms of the routing table) */
    /* @sic R5-153746: p_DataMode (discard, loopbackRTP, loopbackRTCP) sic@ */
    /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    ExplicitRouting := {
      Add := {  /* @sic R5s160131 sic@ */
        IpInfo := cs_IP_ConnectionId(p_Protocol, cs_IP_Socket(p_IpAddrRemoteUE, p_MediaPort)),
        DRB := p_DrbInfo,
        DataMode := p_DataMode  // @sic R5-150356, R5w150008; R5-153746 sic@
      }
    }
  };

  template (value) IP_ConfigReq_Type cs_IP_StopDiscardDataLoopbackDataReq(InternetProtocol_Type p_Protocol,
                                                                          PortNumber_Type  p_MediaPort,
                                                                          template (omit) IP_AddrInfo_Type p_IpAddrRemoteUE) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    ExplicitRouting := {
      Remove := cs_IP_ConnectionId(p_Protocol, cs_IP_Socket(p_IpAddrRemoteUE, p_MediaPort))
    }
  };

  template (present) IP_Indication_Type cr_IP_CommonCnf := {Cnf := true}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_DnsQuery(IP_DnsQuery_Type p_DnsQuery) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    DnsQuery := p_DnsQuery
  };

  template (present) IP_ConfigReq_Type cr_IP_DnsResponse := {DnsResponse := ?}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_ConfigReq_Type cr_IP_CtrlAnyReq := ?;   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_CommonCnf := {Cnf := true};   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_GeranTrigger(template (value) IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    GeranTrigger := p_DrbInfo
  };

  template (value) IP_DrbInfo_Type cs_DrbInfo_NR(NR_CellId_Type p_NR_CellId,
                                                 template (value) QosFlow_Identification_Type p_QosFlow) :=
  { /* @status    APPROVED (IMS, MCX, NR5GC, NR5GC_IRAT, POS) */
    Nr5GC := {
      CellId := p_NR_CellId,
      QosFlow := p_QosFlow
    }
  };

  template (value) IP_DrbInfo_Type cs_DrbInfo_EUTRA(EUTRA_CellId_Type p_CellId,
                                                    IP_DrbId_Type p_DrbId) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5w110204: change of IP_EUTRA_DrbInfo_Type sic@ */
    Eutra := {
      CellId := p_CellId,
      DrbId := p_DrbId
    }
  };

  /*
   * @desc      generic function to configure IP
   * @param     p_Port
   * @param     p_IP_ConfigReq
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function fl_IP_Config(IP_RAT_CTRL_PORT p_Port,
                        template (value) IP_ConfigReq_Type p_IP_ConfigReq)
  {
    p_Port.send(p_IP_ConfigReq);
    p_Port.receive(cr_IP_CommonCnf);
  }

  /*
   * @desc      RAT independent function to start DHCP and ICMPv6 server for given PDN
   * @param     p_Port
   * @param     p_PdnIndex         .. index of the PDN
   * @param     p_DrbInfo          .. DRB on which user plane signalling happens for this PDN
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_Handling_StartPDN(IP_RAT_CTRL_PORT p_Port,
                                  PDN_Index_Type p_PdnIndex,
                                  template (value) IP_DrbInfo_Type p_DrbInfo)
  { /* @sic R5-113734 change 8: replacing former f_DHCPv4_Start, f_ICMPv6_Start sic@ */
    fl_IP_Config(p_Port, cs_IP_StartPdnReq(p_PdnIndex, p_DrbInfo));
  }

  /*
   * @desc      RAT independent function to stop all DHCP and ICMPv6 servers
   * @param     p_Port
   * @param     p_IP_Stop          (default value: cs_IP_StopAllPDNs)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_Handling_StopPDN(IP_RAT_CTRL_PORT p_Port,
                                 template (value) IP_StopPDN_Type p_IP_Stop := cs_IP_StopAllPDNs)
  { /* @sic R5-113734 change 8: replacing former f_DHCPv4_Stop, f_ICMPv6_Stop sic@ */
    /* @sic R5s131000: new parameter p_IP_Stop sic@ */
    fl_IP_Config(p_Port, cs_IP_StopPdnReq(p_IP_Stop));
  }

  /*
   * @desc      to remove all entries in the routing table
   *            NOTE: this has no impact on any existing sockets
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IP_Routing_ChangeToRawmode(IP_RAT_CTRL_PORT p_Port)
  {
    fl_IP_Config(p_Port, cs_IP_ChangeToRawmode);
  }

  /*
   * @desc      to restore the routing table after being in raw mode
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IP_Routing_RestoreRoutingTable(IP_RAT_CTRL_PORT p_Port)
  {
    fl_IP_Config(p_Port, cs_IP_RestoreRoutingTable);
  }

  /*
   * @desc      Function to change the EUTRA cell for all entries of the routing table
   * @param     p_Port
   * @param     p_EutraCellId      .. new cell
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_IP_ChangeEutraCell(IP_RAT_CTRL_PORT p_Port,
                                EUTRA_CellId_Type p_EutraCellId)
  { /* @sic R5-125676: new parameter p_DrbId sic@ */
    /* @sic R5s150648 Change 5.3: p_DrbId removed sic@ */
    fl_IP_Config(p_Port, cs_IP_ChangeEutraCellReq(p_EutraCellId));
  }

  /*
   * @desc      change cell Nr for given PDN
   * @param     p_Port
   * @param     p_NrCellId
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_IP_ChangeNrCell(IP_RAT_CTRL_PORT p_Port,
                             NR_CellId_Type p_NrCellId)
  {
    fl_IP_Config(p_Port, cs_IP_ChangeNrCellReq(p_NrCellId));
  }

  /*
   * @desc      change DRB mapping for given PDN
   * @param     p_Port
   * @param     p_DrbInfo
   * @param     p_PdnIndex          (default value: PDN_1)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IP_ChangeDrbMapping(IP_RAT_CTRL_PORT p_Port,
                                 template (value) IP_DrbInfo_Type p_DrbInfo,
                                 PDN_Index_Type p_PdnIndex := PDN_1)
  {
    fl_IP_Config(p_Port, cs_IP_ChangeDrbInfoReq(p_PdnIndex, p_DrbInfo));
  }

  /*
   * @desc      EUTRA: change DRB mapping for given PDN
   * @param     p_Port
   * @param     p_EutraCellId
   * @param     p_DrbId
   * @param     p_PdnIndex          (default value: PDN_1)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_IP_ChangeDrbMappingEUTRA(IP_RAT_CTRL_PORT p_Port,
                                      EUTRA_CellId_Type p_EutraCellId,
                                      IP_DrbId_Type p_DrbId,
                                      PDN_Index_Type p_PdnIndex := PDN_1)
  { /* @sic R5s150648 Change 5.3 sic@ */
    f_IP_ChangeDrbMapping(p_Port, cs_DrbInfo_EUTRA(p_EutraCellId, p_DrbId), p_PdnIndex);
  }

  /*
   * @desc      NR: change DRB mapping for given PDN
   * @param     p_Port
   * @param     p_NR_CellId
   * @param     p_QosFlow
   * @param     p_PdnIndex
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IP_ChangeDrbMappingNR(IP_RAT_CTRL_PORT p_Port,
                                   NR_CellId_Type p_NR_CellId,
                                   template (value) QosFlow_Identification_Type p_QosFlow,
                                   PDN_Index_Type p_PdnIndex)
  {
    f_IP_ChangeDrbMapping(p_Port, cs_DrbInfo_NR(p_NR_CellId, p_QosFlow), p_PdnIndex);
  }

  /*
   * @desc      start loopback of RTP/RTCP packets
   * @param     p_Port
   * @param     p_MediaPort
   * @param     p_IpAddrRemoteUE
   * @param     p_DrbInfo
   * @param     p_DataMode
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IP_ConfigureDiscardDataLoopbackData(IP_RAT_CTRL_PORT p_Port,
                                                 PortNumber_Type  p_MediaPort,
                                                 template (omit) IP_AddrInfo_Type p_IpAddrRemoteUE,
                                                 template (value) IP_DrbInfo_Type p_DrbInfo,
                                                 IP_DataMode_Type p_DataMode)
  { /* @sic R5-153746: p_DataMode (discard, loopbackRTP, loopbackRTCP) sic@ */
    /* @sic R5s160131: p_DrbInfo, use of fl_IP_Config sic@ */
    fl_IP_Config(p_Port, cs_IP_ConfigureDiscardDataLoopbackDataReq(udp, p_MediaPort, p_IpAddrRemoteUE, p_DrbInfo, p_DataMode));
  }

  /*
   * @desc      stop loopback of RTP/RTCP packets
   * @param     p_Port
   * @param     p_MediaPort
   * @param     p_IpAddrRemoteUE
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IP_StopDiscardDataLoopbackData(IP_RAT_CTRL_PORT p_Port,
                                            PortNumber_Type  p_MediaPort,
                                            template (omit) IP_AddrInfo_Type p_IpAddrRemoteUE)
  {
    fl_IP_Config(p_Port, cs_IP_StopDiscardDataLoopbackDataReq(udp, p_MediaPort, p_IpAddrRemoteUE));
  }

  /*
   * @desc      Activate or deactivate RTP/RTCP loopback:
   *            activate   - p_DrbInfo is present
   *            deactivate - p_DrbInfo is omit
   * @param     p_Port
   * @param     p_PdnIndex
   * @param     p_MediaPortRTP
   * @param     p_DrbInfo
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IP_RtpRtcpLoopback(IP_RAT_CTRL_PORT p_Port,
                                PDN_Index_Type p_PdnIndex,
                                PortNumber_Type  p_MediaPortRTP,
                                template (omit) IP_DrbInfo_Type p_DrbInfo)
  {
    var PortNumber_Type v_MediaPortRTCP := p_MediaPortRTP + 1;
    var PDN_AddressInfo_Type v_PDN_AddressInfo := f_PDN_AddressInfo_Get(p_PdnIndex);
    var template (value) IP_AddrInfo_Type v_IPv4Addr := cs_IPv4Addr(v_PDN_AddressInfo.Remote_IPAddressIPv4);
    var template (value) IP_AddrInfo_Type v_IPv6Addr := cs_IPv6Addr(v_PDN_AddressInfo.Remote_IPAddressIPv6); // @sic R5s150865: cs_IPv4Addr -> cs_IPv6Addr sic@
    var template (value) IP_DrbInfo_Type v_DrbInfo;
  
    if (isvalue(p_DrbInfo)) {
      v_DrbInfo := valueof(p_DrbInfo);
      f_IP_ConfigureDiscardDataLoopbackData(p_Port, p_MediaPortRTP,  v_IPv4Addr, v_DrbInfo, loopbackRTP);
      f_IP_ConfigureDiscardDataLoopbackData(p_Port, v_MediaPortRTCP, v_IPv4Addr, v_DrbInfo, loopbackRTCP);
      f_IP_ConfigureDiscardDataLoopbackData(p_Port, p_MediaPortRTP,  v_IPv6Addr, v_DrbInfo, loopbackRTP);
      f_IP_ConfigureDiscardDataLoopbackData(p_Port, v_MediaPortRTCP, v_IPv6Addr, v_DrbInfo, loopbackRTCP);
    } else { /* @sic R5s160131 sic@ */
      f_IP_StopDiscardDataLoopbackData(p_Port, p_MediaPortRTP,  v_IPv4Addr);
      f_IP_StopDiscardDataLoopbackData(p_Port, v_MediaPortRTCP, v_IPv4Addr);
      f_IP_StopDiscardDataLoopbackData(p_Port, p_MediaPortRTP,  v_IPv6Addr);
      f_IP_StopDiscardDataLoopbackData(p_Port, v_MediaPortRTCP, v_IPv6Addr);
    }
  }

}
