  template (value) MeasObjectNR cds_38508_MeasObjectNR_SSB(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                                           ARFCN_ValueNR p_FrequencySSB,
                                                           SubcarrierSpacing p_SubcarrierSpacingSSB,
                                                           template (value) SSB_MTC p_SSB_MTC,
                                                           template (omit) RSRP_Range  p_AbsThreshSSB,
                                                           template (omit) integer p_NrofSS_BlocksToAverage := 2)
    modifies cs_NR_MeasObjectNR_Base :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    ssbFrequency := p_FrequencySSB,
    ssbSubcarrierSpacing := p_SubcarrierSpacingSSB,
    smtc1 := p_SSB_MTC,
    referenceSignalConfig := cs_38508_ReferenceSignalConfig(p_FreqBandIndicatorNR, p_SubcarrierSpacingSSB),    //@sic R5-199020, R5-201148, R5-206305 sic@
    absThreshSS_BlocksConsolidation := cs_38508_ThresholdNR(p_AbsThreshSSB),
    nrofSS_BlocksToAverage:= p_NrofSS_BlocksToAverage
  };

  template (value) SSB_ConfigMobility cs_SSB_ConfigMobility (FreqBandIndicatorNR p_FreqBandIndicatorNR, SubcarrierSpacing    p_SCS) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
      ssb_ToMeasure :=
        {
            setup := f_NR_GetSSB_ToMeasure(p_FreqBandIndicatorNR, p_SCS) //@sic R5-206305 sic@
        },
      deriveSSB_IndexFromCell := f_RetrieveDeriveSSB_IndexFromCellFromBand(p_FreqBandIndicatorNR),
      ss_RSSI_Measurement := omit,
      ssb_PositionQCL_Common_r16            := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      ssb_PositionQCL_CellsToAddModList_r16 := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      ssb_PositionQCL_CellsToRemoveList_r16 := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      deriveSSB_IndexFromCellInter_r17      := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      ssb_PositionQCL_Common_r17            := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      ssb_PositionQCL_Cells_r17             := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      cca_CellsToAddModList_r17             := omit,    /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
      cca_CellsToRemoveList_r17             := omit,    /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
      ssb_ToMeasureAltitudeBasedList_r18    := omit     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

