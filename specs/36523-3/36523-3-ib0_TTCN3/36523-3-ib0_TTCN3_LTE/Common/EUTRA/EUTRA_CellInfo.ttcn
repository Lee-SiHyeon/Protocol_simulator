   */
  function f_EUTRA_MobileInfo_GetUECapability() runs on EUTRA_PTC return UE_EUTRA_Capability
  {
    return vc_EUTRA_Global.MobileInfo.EUTRA_Capability;
  }

  /*
   * @desc      Get UE LocalEmergencyNumberList in the MobileInfo variable
   * @return    EmergencyNumList
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
