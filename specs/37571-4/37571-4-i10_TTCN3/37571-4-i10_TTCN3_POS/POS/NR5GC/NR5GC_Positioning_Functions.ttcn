  /*
   * @desc      To check the BDS signals reported by the UE
   * @param     p_GNSS_SgnMeasList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckSignalsBds(GNSS_SgnMeasList p_GNSS_SgnMeasList) runs on NR_BASE_PTC
  {// @sic R5s210633 sic@
   var integer i;
   var boolean v_BDS_B1I_Reported := false;
   var boolean v_BDS_B1C_Reported := false;
   var boolean v_BDS_B2a_Reported := false; // @sic R5-241577 sic@
   var boolean v_BDS_B3I_Reported := false; // @sic R5-241577 sic@

   for (i:=0; i<lengthof(p_GNSS_SgnMeasList); i:=i+1) {
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(0))) {
       v_BDS_B1I_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(7, 9))) { // @sic R5-241577 sic@
       v_BDS_B1C_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(7, 12))) { // @sic R5-241577 sic@
       v_BDS_B2a_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(3))) { // @sic R5-241577 sic@
       v_BDS_B3I_Reported := true;
     }
   }
   if (not ((v_BDS_B1I_Reported == pc_BDS_B1I) and (v_BDS_B1C_Reported == pc_BDS_B1C) and (v_BDS_B2a_Reported == pc_BDS_B2a) and (v_BDS_B3I_Reported == pc_BDS_B3I))) // @sic R5-241577 sic@
   {
       f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "BDS signals not reported correctly");
   }
  }

    /*
   * @desc      Function to check NR ECID capabilities provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-6
   * @param     p_NrEcidProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_Ecid (NR_ECID_ProvideCapabilities_r16 p_NrEcidProvideCapabilities) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    var integer i;
    var bitstring v_Bitstring := f_ConvertBoolToBit(pc_NR_ECID_SSRsrp) &
                                 f_ConvertBoolToBit(pc_NR_ECID_SSRsrq) &
                                 f_ConvertBoolToBit(pc_NR_ECID_CSIRsrp) &
                                 f_ConvertBoolToBit(pc_NR_ECID_CSIRsrq);

    for (i := 0; i < lengthof(p_NrEcidProvideCapabilities.nr_ECID_MeasSupported_r16)-1; i := i + 1) { // @sic R5s220031 sic@
      //Only the first four bits of nr_ECID_MeasSupported_r16 are compared with v_Bitstring
      if(i == lengthof(v_Bitstring)){ //@sic R5s230028 sic@
        break;
      }

      if (not (v_Bitstring[i] == p_NrEcidProvideCapabilities.nr_ECID_MeasSupported_r16[i])) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR ECID measurements");
      }
    }
    if (pc_NR_ECID_periodicalReporting != ispresent(p_NrEcidProvideCapabilities.periodicalReporting_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR ECID periodicalReporting");
    }
    if (pc_NR_ECID_triggeredReporting != ispresent(p_NrEcidProvideCapabilities.triggeredReporting_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR ECID triggeredReporting");
    }
  }

  /*
   * @desc      Function to check NR Multi RTT capabilities provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-5
   * @param     p_NrMultiRttProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_MultiRTT (NR_Multi_RTT_ProvideCapabilities_r16 p_NrMultiRttProvideCapabilities) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    f_POS_NR_CheckCapabilities_NR_DL_PRS_Resources (p_NrMultiRttProvideCapabilities.nr_Multi_RTT_PRS_Capability_r16);
    f_POS_NR_CheckCapabilities_NR_Multi_RTT_Measurements (p_NrMultiRttProvideCapabilities.nr_Multi_RTT_MeasurementCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_QCL_Processing (p_NrMultiRttProvideCapabilities.nr_DL_PRS_QCL_ProcessingCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_Processing (p_NrMultiRttProvideCapabilities.nr_DL_PRS_ProcessingCapability_r16);
    f_POS_NR_CheckCapabilities_NR_UL_SRS (p_NrMultiRttProvideCapabilities.nr_UL_SRS_Capability_r16);

    if (pc_Multi_RTT_additionalPathsReport != ispresent(p_NrMultiRttProvideCapabilities.additionalPathsReport_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR Multi RTT additionalPathsReport");
    }
    if (pc_Multi_RTT_periodicalReporting != ispresent(p_NrMultiRttProvideCapabilities.periodicalReporting_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR Multi RTT periodicalReporting");
    }
    if (pc_mg_ActivationRequest_Multi_RTT != ispresent(p_NrMultiRttProvideCapabilities.mg_ActivationRequest_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR Multi RTT mg_ActivationRequest");
    }
    if (pc_posMeasGapSupport_Multi_RTT != ispresent(p_NrMultiRttProvideCapabilities.posMeasGapSupport_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR Multi RTT posMeasGapSupport");
    }
  }

  /*
   * @desc      Function to check NR DL AoD capabilities provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-5
   * @param     p_NrDlAoDProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_DL_AoD (NR_DL_AoD_ProvideCapabilities_r16  p_NrDlAoDProvideCapabilities) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    f_POS_NR_CheckCapabilities_PositioningModes (p_NrDlAoDProvideCapabilities.nr_DL_AoD_Mode_r16, pc_UEB_DL_AoD, pc_UEA_DL_AoD);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_Resources (p_NrDlAoDProvideCapabilities.nr_DL_AoD_PRS_Capability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_AoD_Measurements (p_NrDlAoDProvideCapabilities.nr_DL_AoD_MeasurementCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_QCL_Processing (p_NrDlAoDProvideCapabilities.nr_DL_PRS_QCL_ProcessingCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_Processing (p_NrDlAoDProvideCapabilities.nr_DL_PRS_ProcessingCapability_r16);

    if (isvalue(p_NrDlAoDProvideCapabilities.periodicalReporting_r16)) {
      if (not(f_POS_NR_CheckCapabilities_PeriodicalReporting(p_NrDlAoDProvideCapabilities.periodicalReporting_r16,
                                                             pc_DL_AoD_periodicalReporting_standalone,
                                                             pc_DL_AoD_periodicalReporting_UEB,
                                                             pc_DL_AoD_periodicalReporting_UEA))) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL AoD periodical reporting");
      }
    }
    if (pc_mg_ActivationRequest_DL_AoD != ispresent(p_NrDlAoDProvideCapabilities.mg_ActivationRequest_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL-AoD mg_ActivationRequest");
    }
    if (pc_posMeasGapSupport_DL_AoD != ispresent(p_NrDlAoDProvideCapabilities.posMeasGapSupport_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL-AoD posMeasGapSupport");
    }
  }

  /*
   * @desc      Function to check NR DL TDOA capabilities provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-5
   * @param     p_NrDlTdoaProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_DL_TDOA (NR_DL_TDOA_ProvideCapabilities_r16  p_NrDlTdoaProvideCapabilities) runs on NR_BASE_PTC
