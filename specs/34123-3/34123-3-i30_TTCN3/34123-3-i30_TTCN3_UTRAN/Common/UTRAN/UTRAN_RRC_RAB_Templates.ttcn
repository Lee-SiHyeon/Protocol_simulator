  const DDI                         tsc_E_DCH_DDI_2 := 2;                        /* @status    APPROVED (LTE_IRAT, UTRAN) */

  const DDI                         tsc_E_DCH_DDI_3 := 3;                        /* @status    APPROVED (LTE_IRAT, UTRAN) */

