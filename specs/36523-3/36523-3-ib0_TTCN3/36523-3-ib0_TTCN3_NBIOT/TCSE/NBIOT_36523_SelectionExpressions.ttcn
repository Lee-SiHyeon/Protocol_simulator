module NBIOT_36523_SelectionExpressions {

  import from CommonDefs all;
  import from EUTRA_NB_Parameters all;
  import from EUTRA_Parameters all;
  import from NBIOT_Parameters all;
  import from Parameters all;

  type enumerated NBIOT_36523_Condition_Type {  /* @status    APPROVED (NBIOT) */
    C266,
    C266a,
    C271,
    C272,
    C273,
    C275,
    C277,
    C288,
    C290,
    C291,
    C293,
    C322,
    C323,
    C339,
    C342,
    C347,
    C348,
    C349_C403,
    C350,
    C351,
    C377,
    C390,
    C391,
    C392,
    C396,
    C400,
    C402,
    C412,
    C413,
    C423,
    C424,
    C427,
    C428,
    C429,
    C431,
    C433,
    C435,
    C436,
    C437,
    C438,
    C439,
    C440,
    C441,
    C442,
    C443,
    C444,
    C445,
    C448
  };

  /*
   * @desc      Set the applicability conditions according to 36.523-2 Table 4-1a: Applicability of tests Conditions
   *            Function specific to NBIOT  TCSE
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_SelectionExpr(NBIOT_36523_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;
    var boolean v_FrequencyBandIsFDD := f_NBIOT_FrequencyBandIsFDD(px_ePrimaryFrequencyBand);

    select (p_Condition) {
      case (C266) {
        v_ApplCond := pc_NB_FDD or pc_NB_TDD;
      }
      case (C266a) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_PLMN_Manual_Mode_Exception;
      }
      case (C271) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_User_Plane_CIoT_Optimisation;
      }
      case (C272) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_ZUC;
      }
      case (C273) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_edrx;
      }
      case (C275) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_LAP and pc_LAP_override;
      }
      case (C277) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_Multiple_PDN and pc_LAP and pc_LAP_override;
      }
      case (C288) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_MultiCarrier;
      }
      case (C290) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and (pc_WB_User_Plane_CIoT_Optimisation or pc_S1_U_DataTransfer);
      }
      case (C291) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and (pc_WB_User_Plane_CIoT_Optimisation or pc_S1_U_DataTransfer) and pc_ZUC;
      }
      case (C293) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_IP_PDN and pc_ESM_MO_Bearer_Modification;
      }
      case (C322) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_RRC_re_establishment_CP_CIoT;
      }
      case (C323) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_NB_FDD or pc_NB_TDD);
      }
      case (C339) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_TwoHARQ_Processes and pc_ue_Category_NB2;
      }
      case (C342) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_APN_RateControl and pc_Additional_APN_RateControl;
      }
      case (C347) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_ue_Category_NB2;
      }
      case (C348) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_MultiCarrier_NPRACH;
      }
      case (C349_C403) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_NB_FDD and pc_NB_MultiCarrier_Paging;
        } else {
          v_ApplCond := pc_NB_TDD and pc_NB_MultiCarrier_Paging_TDD;
        }
      }
      case (C350) {
        v_ApplCond := pc_NB_FDD and pc_SCPTM_IDLE;
      }
      case (C351) {
        v_ApplCond := pc_NB_FDD and pc_SCPTM and (pc_FeatrGrp_3_F or pc_FeatrGrp_3_T) and (pc_FeatrGrp_7_F or pc_FeatrGrp_7_T);
      }
      case (C377) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_RLC_UM and (pc_WB_User_Plane_CIoT_Optimisation or pc_S1_U_DataTransfer);
      }
      case (C390) {
        v_ApplCond := pc_NB_FDD and pc_wakeUpSignal;
      }
      case (C391) {
        v_ApplCond := pc_NB_FDD and pc_edrx and pc_wakeUpSignal;
      }
      case (C392) {
        v_ApplCond := pc_NB_FDD and pc_SR_WithoutHARQ_ACK;
      }
      case (C396) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_User_Plane_CIoT_Optimisation and (pc_ROHC_profile0x0002 or pc_ROHC_profile0x0003 or pc_ROHC_profile0x0004 or pc_ROHC_profile0x0006 or pc_ROHC_profile0x0102 or pc_ROHC_profile0x0103 or pc_ROHC_profile0x0104);
      }
      case (C400) {
        v_ApplCond := pc_NB_FDD and pc_NB_mixedOperationMode;
      }
      case (C402) {
        v_ApplCond := pc_NB_FDD and pc_NB_nprach_Format2;
      }
      case (C412) {
        v_ApplCond := pc_NB_ntn_Connectivity_EPC;
      }
      case (C413) {
        v_ApplCond := pc_NB_ntn_Connectivity_EPC and pc_NB_ntn_TA_Report and pc_NB_ntn_OffsetTimingEnh;
      }
      case (C423) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_ePSM;
      }
      case (C424) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_ePSM and pc_edrx;
      }
      case (C427) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_operator_controlled_signal_threshold_per_access_technology;
      }
      case (C428) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_operator_controlled_signal_threshold_per_access_technology and pc_PLMN_EF_LRPLMNSI_Automatic_Mode_Exception;
      }
      case (C429) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_NB_TwoHARQ_Processes;
      }
      case (C431) {
        v_ApplCond := pc_NB_ntn_Connectivity_EPC and (pc_cellReselectionMeasurements_locationBased_fixedCell or pc_cellReselectionMeasurements_locationBased_earthMovingCell);
      }
      case (C433) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and (pc_IPv4 or pc_IPv6);
      }
      case (C435) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_NB_TwoHARQ_Processes and (pc_NB_ntn_DL_HARQ_disable_RRC_singleTB or pc_NB_ntn_UL_HARQ_MODE_B_singleTB);
      }
      case (C436) {
        v_ApplCond := pc_NB_FDD and pc_NB_ntn_Connectivity_EPC and pc_NB_Control_Plane_CIoT_Optimisation_EDT;
      }
      case (C437) {
        v_ApplCond := pc_NB_FDD and pc_NB_ntn_Connectivity_EPC and pc_NB_User_Plane_CIoT_Optimisation_EDT;
      }
      case (C438) {
        v_ApplCond := pc_NB_ntn_Connectivity_EPC and pc_NB_Report_Coarse_Location_Information_NAS;
      }
      case (C439) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_NB_ntn_triggered_GNSS_position_fix;
      }
      case (C440) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_Control_Plane_data_backoff;
      }
      case (C441) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_NB_ntn_DiscontinuousCoverage;
      }
      case (C442) {
        v_ApplCond := (pc_NB_FDD or pc_NB_TDD) and pc_NB_earlyContentionResolution_r14;
      }
      case (C443) {
        v_ApplCond := pc_NB_FDD and pc_NB_ntn_Connectivity_EPC and pc_NB_Control_Plane_CIoT_Optimisation_PUR;
      }
      case (C444) {
        v_ApplCond := pc_NB_FDD and pc_NB_ntn_Connectivity_EPC and pc_NB_User_Plane_CIoT_Optimisation_PUR;
      }
      case (C445) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_NB_ntn_autonomous_GNSS_position_fix and pc_NB_ntn_Uplink_Tx_Extension;
      }
      case (C448) {
        v_ApplCond := (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC) and pc_UnavailabilityInfo_DiscontinuousCoverage;
      }
      case else {
        v_ApplCond := false;
      }
    }
    return v_ApplCond;
  }

}
