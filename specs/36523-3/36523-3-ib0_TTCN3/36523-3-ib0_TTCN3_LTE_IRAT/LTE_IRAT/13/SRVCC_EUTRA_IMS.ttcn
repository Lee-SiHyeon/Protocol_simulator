module SRVCC_EUTRA_IMS {

  import from IMS_CommonSRVCC all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Registration all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.1
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_1_IMS1()runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(noReInvite);
    f_IMS_IPCAN_WaitForTrigger(OtherIPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN(); // @sic R5-142919 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.2
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_2_IMS1() runs on IMS_PTC
  {
    var boolean v_DeregisteredEarly := false;
    v_DeregisteredEarly := f_IMS_Generic_Sequence_SRVCC(reInviteC24, 10.0);    /* @sic R5s140161 change 5, R5s140259, R5s140331 sic@ */
    if (not v_DeregisteredEarly) { // @sic R5-154047 sic@
      v_DeregisteredEarly:= f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN(); // @sic R5-142919, R5s140573 sic@
    } else {
      f_IMS_IPCAN_WaitForTrigger(OtherIPCAN);  // Already done deregistration, so trigger sent during UTRAN postamble needs to be swallowed here
    }
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.3
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_3_IMS1()runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(noReInvite);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.4
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_4_IMS1() runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(reInviteC31, 3.0);  // @sic R5-174016 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration(); // @sic R5-142919 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.5
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_5_IMS1() runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(reInviteC31, 3.0); // @sic R5-175225 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN); // @sic R5s140582 sic@
    f_IMS_IpcanReleaseWithOptionalDeregistration(); // @sic R5-142919, R5s140582 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.6
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_6_IMS1() runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(reInviteC31);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 33"); // @sic R5-140769 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration(); // @sic R5-142919 sic@
    
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.3.41
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_3_41_IMS1() runs on IMS_PTC
  {
    f_IMS_Generic_Sequence_SRVCC(reInviteC31);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 32");
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

}
