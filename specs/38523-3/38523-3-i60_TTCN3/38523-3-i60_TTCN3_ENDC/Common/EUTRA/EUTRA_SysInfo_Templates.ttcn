  };

  template (value) BcchInfo_Type cs_BCCHInfo_C1(template (value) BCCH_BCH_Message    p_MIB,
                                                template (value) BCCH_DL_SCH_Message p_SIB1,
                                                template (omit) SI_List_Type        p_SI_List,
                                                template (omit)  SegmentedSI_List_Type p_SegmentedSI_List := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5-112161: new optional parameter for segmented SIs sic@ */
    MIB  := p_MIB,
    SIB1 := p_SIB1,
    SIs  := p_SI_List,
    SegmentedSIs := p_SegmentedSI_List
  };

  /*
   * @desc      Return the extension v1130, set category0Allowed-r12 to true if UE is category 0.
   *            Acc to 36.508 Table 4.4.3.2-3 UECAT0=this condition applies when UE under test is a UE of Category 0.
   * @param     p_Category0Allowed  (default value: true_)
   * @return    template (omit) SystemInformationBlockType1_v1130_IEs
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_SetSystemInformationBlockType1_Cat0_ECallOverIMS(template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_) return template (omit) SystemInformationBlockType1_v1130_IEs
  { //@sic R5-151975 R5-176132: renamed f_EUTRA_SetSystemInformationBlockType1_Cat0Allowed -> f_EUTRA_SetSystemInformationBlockType1_Cat0_ECallOverIMS sic@
    var template (omit) SystemInformationBlockType1_v1130_IEs v_SystemInformationBlockType1_v1130 := omit;
    
    if (pc_ue_CategoryDL_0 and f_GetTestcaseAttrib_ECallOverIMS(testcasename())) {  //UECAT0 and ECallOverIMS  @sic R5-176132 sic@
        v_SystemInformationBlockType1_v1130 := cs_SystemInformationBlockType1_v1130_Cat0Allowed(p_Category0Allowed);
        v_SystemInformationBlockType1_v1130.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1310(omit, cs_SystemInformationBlockType1_v1320_EcallOverIMS);
      } else if (pc_ue_CategoryDL_0) { //UECAT0 only
        v_SystemInformationBlockType1_v1130 := cs_SystemInformationBlockType1_v1130_Cat0Allowed(p_Category0Allowed)
      } else if (f_GetTestcaseAttrib_ECallOverIMS(testcasename())) {  //ECallOverIMS only
        v_SystemInformationBlockType1_v1130 := cs_SystemInformationBlockType1_v1130_Cat0Allowed(omit);
        v_SystemInformationBlockType1_v1130.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1310(omit, cs_SystemInformationBlockType1_v1320_EcallOverIMS);
    }
    return v_SystemInformationBlockType1_v1130;
  };

  /*
   * @desc      Return the FreqBandIndicator as set in SIB1 freqBandIndicator, i.e. set to 64/maxFBI when Band>64
   * @param     p_Band
   * @return    FreqBandIndicator
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicator(integer p_Band) return FreqBandIndicator
  { //@sic R5-16892 sic@
    var FreqBandIndicator v_FreqBandIndicator;
   
    if (p_Band >= maxFBI) {
      v_FreqBandIndicator := maxFBI;
    } else {
      v_FreqBandIndicator := p_Band;
    }
    return v_FreqBandIndicator;
  }

  /*
   * @desc      Return the FreqBandIndicator extension as set in SIB1 SystemInformationBlockType1-v9e0-IEs
   *            -> freqBandIndicator-v9e0, i.e. set to p_Band when Band>64 else it is omitted
   * @param     p_Band
   * @return    template (omit) octetstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(integer p_Band) return template (omit) octetstring
  { //@sic R5-16892 sic@
    var template (omit) SystemInformationBlockType1_v8h0_IEs v_SystemInformationBlockType1_v8h0_IEs := omit;
    var template (omit) octetstring v_SIB1_v8h0_IEs_Octetstring := omit; //@sic R5s160814 sic@
    
    if (p_Band >= maxFBI) {
      v_SystemInformationBlockType1_v8h0_IEs := cs_SystemInformationBlockType1_v8h0_IEs( omit, cs_SystemInformationBlockType1_v9e0(p_Band));
      v_SIB1_v8h0_IEs_Octetstring := bit2oct(f_OctetAlignedBitString(encvalue(v_SystemInformationBlockType1_v8h0_IEs)));  //@sic R5s160814 sic@
    }

    return v_SIB1_v8h0_IEs_Octetstring;
  }

  /*
   * @desc      Return the SIB5 EARFCN interfrequencyList extension in octetstring
   * @param     p_InterFreqCarrierFreqInfo_v9e0_List
   * @return    template (omit) octetstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_ReturnSystemInformationBlockType5_v8h0(template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type p_InterFreqCarrierFreqInfo_v9e0_List)
    return template (omit) octetstring
  {
    var template (omit) SystemInformationBlockType5_v8h0_IEs v_SystemInformationBlockType5_v8h0 := omit;
    var template (omit) octetstring v_SIB5_v8h0_IEs_Octetstring := omit;  //@sic R5s160814 sic@
    
    if (ispresent(p_InterFreqCarrierFreqInfo_v9e0_List)) {
      v_SystemInformationBlockType5_v8h0 := cs_SystemInformationBlockType5_v8h0_Freq(p_InterFreqCarrierFreqInfo_v9e0_List);
      v_SIB5_v8h0_IEs_Octetstring := bit2oct(f_OctetAlignedBitString(encvalue(v_SystemInformationBlockType5_v8h0)));  //@sic R5s160814 sic@
    }
    return v_SIB5_v8h0_IEs_Octetstring;
  }

  /*
   * @desc      Return PLMN_InfoList_r15 as per 36.508 Table 4.4.3.3-1: SystemInformationBlockType2
   *            The IE is set for 5G test cases
   * @return    template (omit) PLMN_InfoList_r15
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_EUTRA_GetPlmnInfoList() return template (omit) PLMN_InfoList_r15
  {
    /* @sic R5-198995 sic@ */
    var template (omit) PLMN_InfoList_r15 v_PLMN_InfoList := omit;
    
    if (fl_NR_TestcaseIs5GTestcase()) {
        v_PLMN_InfoList := cs_PLMN_InfoList_Def;
    }
    return v_PLMN_InfoList;
  }

  /*
   * @desc      Return true if the test case is a 5G test case (i.e. either it is an ENDC test case ot its name ends with NR5GC) else returns false
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_NR_TestcaseIs5GTestcase() return boolean
  {
    var charstring v_TestcaseName := testcasename();
    var template charstring v_TestcasePattern5G := pattern "*_NR5GC";
    
    if (match(v_TestcaseName, v_TestcasePattern5G) or f_GetTestcaseAttrib_ENDC(v_TestcaseName)){
        return true;
    } else {
        return false;
    }
  }

}
