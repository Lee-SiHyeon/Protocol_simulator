  /*
   * @desc      Check result of an SMS AT command
   * @param     p_ResultString
   * @param     p_ExpectedStartString
   * @status    APPROVED (NR5GC)
   */
  function fl_NG_SMS_CheckResultString(charstring p_ResultString,
                                    charstring p_ExpectedStartString) runs on NR_BASE_PTC
  {
    if (not f_CheckStringStartWith(p_ResultString, p_ExpectedStartString)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "The AT CMD results in an error.");
    }
  }

  /*
   * @desc      To verify if MAC PDU contains Timing Advance Report MAC CE. Optionally disables further TA reporting.
   * @param     p_NR_CellId
   * @param     p_IsPresent_MAC_TA_CE
   * @param     p_TestStep
   * @param     p_UL_CCCH_Msg       (default value: omit)
   * @param     p_UL_DCCH_Msg       (default value: omit)
   * @param     p_Disable_MAC_TA_Report (default value: true)
   * @return    template
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CheckMacPduAndTimingAdvanceReport(NR_CellId_Type p_NR_CellId,
                                                  boolean p_IsPresent_MAC_TA_CE,
                                                  charstring p_TestStep,
                                                  template UL_CCCH_Message p_UL_CCCH_Msg := omit,
                                                  template UL_DCCH_Message p_UL_DCCH_Msg := omit,
                                                  boolean p_Disable_MAC_TA_Report := true
                                                  ) runs on NR_BASE_PTC return template (omit) NG_NAS_MSG_Indication_Type
 {
     var NR_SRB_COMMON_IND v_SRB_COMMON_IND;
     var NR_SYSTEM_IND v_Received_NR_SysInd;
     var template (omit) NG_NAS_MSG_Indication_Type v_DedicatedNAS_Message := omit;
     
     timer t_WaitTime := 0.1;  //@sic R5250260 sic@ a general delay to check if TA Report MAC CE is received
     
     if(ispresent(p_UL_CCCH_Msg))
     {
        if(p_IsPresent_MAC_TA_CE)
        {
            interleave
            {
                [] SRB.receive (car_NR_SRB0_RrcPdu_IND(p_NR_CellId, p_UL_CCCH_Msg)) -> value v_SRB_COMMON_IND {} // compiler warning may be ignored due to check
                [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?)) -> value v_Received_NR_SysInd {}
            }
            
            if(v_SRB_COMMON_IND.Common.TimingInfo == v_Received_NR_SysInd.Common.TimingInfo)
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, p_TestStep);
                if(p_Disable_MAC_TA_Report){
                    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(disable));
                }
            }
            else
            {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_TestStep);
            }
        }
        else
        {// No TA MAC CE is expected
            alt
            {
                [] SRB.receive (car_NR_SRB0_RrcPdu_IND(p_NR_CellId, p_UL_CCCH_Msg)) // compiler warning may be ignored due to check
                {
                    t_WaitTime.start;
                    alt
                    {
                        [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId,  cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?))
                        {
                            t_WaitTime.stop;
                            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__,  p_TestStep &", no TA Report MAC CE is expected");
                        }
                        [] t_WaitTime.timeout {
                            if(p_Disable_MAC_TA_Report){
                                f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(disable));
                            }
                        }
                    }
                }
                [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?))
                {
                    f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_TestStep &", no TA Report MAC CE is expected");
                }
            }
        }
     }
     else if(ispresent(p_UL_DCCH_Msg))
     {
         if(p_IsPresent_MAC_TA_CE)
         {
             interleave
            {
                [] SRB.receive (car_NR_SRB1_RrcNasPdu_IND(p_NR_CellId, p_UL_DCCH_Msg,?)) -> value v_SRB_COMMON_IND {} // compiler warning may be ignored due to check
                [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?)) -> value v_Received_NR_SysInd {}
            }
            
            if(v_SRB_COMMON_IND.Common.TimingInfo == v_Received_NR_SysInd.Common.TimingInfo)
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, p_TestStep);
            }
            if(p_Disable_MAC_TA_Report){
                f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(disable));
            }
            v_DedicatedNAS_Message :=  v_SRB_COMMON_IND.Signalling.Nas[0];
         }
         else
         {//No TimingAdvance MAC CE is expected
             alt
            {
                [] SRB.receive (car_NR_SRB1_RrcNasPdu_IND(p_NR_CellId, p_UL_DCCH_Msg,?)) // compiler warning may be ignored due to check
                {
                    t_WaitTime.start;
                    alt
                    {
                        [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?))
                        {
                            t_WaitTime.stop;
                            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__,  p_TestStep &", no TA Report MAC CE is expected");
                        }
                        [] t_WaitTime.timeout {
                            if(p_Disable_MAC_TA_Report){
                                f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(disable));
                            }
                        };
                    }
                    v_DedicatedNAS_Message :=  v_SRB_COMMON_IND.Signalling.Nas[0];
                }
                [] SYSIND.receive(car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_MAC(cr_NR_MAC_TimingAdvanceReport_CE),?))
                {
                    f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_TestStep &", no TA Report MAC CE is expected");
                    
                }
             }
         }
     }
     else
     {
         FatalError(__FILE__, __LINE__, "Missing UL message configuration");
     }
     return v_DedicatedNAS_Message
 };

}
