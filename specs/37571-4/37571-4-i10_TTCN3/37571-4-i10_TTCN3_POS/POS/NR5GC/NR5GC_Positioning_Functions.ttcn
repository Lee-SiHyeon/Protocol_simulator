   */
  function f_POS_NR_CheckCapabilities_Srs_PosResourceConfigCA_BandList (NR_UL_SRS_Capability_r16.srs_PosResourceConfigCA_BandList_r16 p_NrUlSrsPosResourceConfigCABandList) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    var integer v_Index;
    var boolean v_Found_MaxNumberSRS_PosResourceSetsPerBWP := false;
    var boolean v_Found_MaxNumberSRS_PosResourcesPerBWP := false;
    var boolean v_Found_MaxNumberPeriodicSRS_PosResourcesPerBWP := false;
    var boolean v_Found_MaxNumberAP_SRS_PosResourcesPerBWP := false;
    var boolean v_Found_MaxNumberSP_SRS_PosResourcesPerBWP := false;

    for (v_Index := 0; v_Index < lengthof(p_NrUlSrsPosResourceConfigCABandList); v_Index:=v_Index+1) {
      fl_CheckNRBandCapability(p_NrUlSrsPosResourceConfigCABandList[v_Index].freqBandIndicatorNR_r16); // checks freqBandIndicatorNR-r16 against capability PICS

      if (pc_maxNumberSRS_PosResourceSetsPerBWP == p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberSRS_PosResourceSetsPerBWP_r16) {
        v_Found_MaxNumberSRS_PosResourceSetsPerBWP := true;
      }
      if (pc_maxNumberSRS_PosResourcesPerBWP == p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberSRS_PosResourcesPerBWP_r16) {
        v_Found_MaxNumberSRS_PosResourcesPerBWP := true;
      }
      if (pc_maxNumberPeriodicSRS_PosResourcesPerBWP == p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberPeriodicSRS_PosResourcesPerBWP_r16) {
        v_Found_MaxNumberPeriodicSRS_PosResourcesPerBWP := true;
      }
      if (ispresent(p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberAP_SRS_PosResourcesPerBWP_r16) and
          (pc_maxNumberAP_SRS_PosResourcesPerBWP == p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberAP_SRS_PosResourcesPerBWP_r16))  {
        v_Found_MaxNumberAP_SRS_PosResourcesPerBWP := true;
      }
      if (ispresent(p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberSP_SRS_PosResourcesPerBWP_r16) and
          (pc_maxNumberSP_SRS_PosResourcesPerBWP == p_NrUlSrsPosResourceConfigCABandList[v_Index].maxNumberSP_SRS_PosResourcesPerBWP_r16))  {
        v_Found_MaxNumberSP_SRS_PosResourcesPerBWP := true;
      }
    }
    if (not (v_Found_MaxNumberSRS_PosResourceSetsPerBWP and v_Found_MaxNumberSRS_PosResourcesPerBWP and v_Found_MaxNumberPeriodicSRS_PosResourcesPerBWP and
             v_Found_MaxNumberAP_SRS_PosResourcesPerBWP and v_Found_MaxNumberSP_SRS_PosResourcesPerBWP)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for srs-PosResourceConfigCA-BandList-r16");
    }
  }

  /*
   * @desc      Function to check NR DL AoD measurements provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-12
   * @param     p_NrDlAodMeasurementCapability
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_DL_AoD_Measurements (NR_DL_AoD_MeasurementCapability_r16 p_NrDlAodMeasurementCapability) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    if (pc_maxDL_PRS_RSRP_MeasurementFR1 != p_NrDlAodMeasurementCapability.maxDL_PRS_RSRP_MeasurementFR1_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL AoD maxDL-PRS-RSRP-MeasurementFR1-r16");
    }
    if (pc_maxDL_PRS_RSRP_MeasurementFR2 != p_NrDlAodMeasurementCapability.maxDL_PRS_RSRP_MeasurementFR2_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL AoD maxDL-PRS-RSRP-MeasurementFR2-r16");
    }
    f_POS_NR_CheckCapabilities_Dl_AoD_MeasCapabilityBandList (p_NrDlAodMeasurementCapability.dl_AoD_MeasCapabilityBandList_r16);
  }

  /*
   * @desc      Function to check NR Dl_AoD_MeasCapabilityBandList provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-12
   * @param     p_NrDlAoDMeasCapabilityBandList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_Dl_AoD_MeasCapabilityBandList (NR_DL_AoD_MeasurementCapability_r16.dl_AoD_MeasCapabilityBandList_r16 p_NrDlAoDMeasCapabilityBandList) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    var integer v_Index;
    var boolean v_Found_Simul_NR_DL_AoD_DL_TDOA := false;
    var boolean v_Found_Simul_NR_DL_AoD_Multi_RTT := false;

    for (v_Index := 0; v_Index < lengthof(p_NrDlAoDMeasCapabilityBandList); v_Index:=v_Index+1) {
      fl_CheckNRBandCapability(p_NrDlAoDMeasCapabilityBandList[v_Index].freqBandIndicatorNR_r16); // checks freqBandIndicatorNR-r16 against capability PICS

      if (pc_simul_NR_DL_AoD_DL_TDOA == (ispresent(p_NrDlAoDMeasCapabilityBandList[v_Index].simul_NR_DL_AoD_DL_TDOA_r16)))  {
          v_Found_Simul_NR_DL_AoD_DL_TDOA := true;
      }
      if (pc_simul_NR_DL_AoD_Multi_RTT == (ispresent(p_NrDlAoDMeasCapabilityBandList[v_Index].simul_NR_DL_AoD_Multi_RTT_r16)))  {
          v_Found_Simul_NR_DL_AoD_Multi_RTT := true;
      }
    }
    if (not (v_Found_Simul_NR_DL_AoD_DL_TDOA and v_Found_Simul_NR_DL_AoD_Multi_RTT)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for dl-AoD-MeasCapabilityBandList-r16");
    }
  }

  /*
   * @desc      Function to check NR DL TDOA measurements provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-13
   * @param     p_NrDlTdoaMeasurementCapability
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_DL_TDOA_Measurements (NR_DL_TDOA_MeasurementCapability_r16 p_NrDlTdoaMeasurementCapability) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    if (pc_dl_RSTD_MeasurementPerPairOfTRP_FR1 != p_NrDlTdoaMeasurementCapability.dl_RSTD_MeasurementPerPairOfTRP_FR1_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA dl-RSTD-MeasurementPerPairOfTRP-FR1-r16");
    }
    if (pc_dl_RSTD_MeasurementPerPairOfTRP_FR2 != p_NrDlTdoaMeasurementCapability.dl_RSTD_MeasurementPerPairOfTRP_FR2_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA dl-RSTD-MeasurementPerPairOfTRP-FR2-r16");
    }
    if (pc_DL_PRS_RSRP_MeasFR1 != ispresent(p_NrDlTdoaMeasurementCapability.supportOfDL_PRS_RSRP_MeasFR1_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA supportOfDL-PRS-RSRP-MeasFR1-r16");
    }
    if (pc_DL_PRS_RSRP_MeasFR2 != ispresent(p_NrDlTdoaMeasurementCapability.supportOfDL_PRS_RSRP_MeasFR2_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA supportOfDL-PRS-RSRP-MeasFR2-r16");
    }
  }

  /*
   * @desc      Function to check NR-UE-TEG-Capability provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-14
   * @param     p_NR_UE_TEG_Capability
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_UL_TEG(NR_UE_TEG_Capability_r17 p_NR_UE_TEG_Capability) runs on NR_BASE_PTC
  { // @sic R5-235341 sic@
    var integer v_Index;
    var boolean v_Found_Nr_UE_RxTEG_ID_MaxSupport := false;
    var boolean v_Found_Nr_UE_TxTEG_ID_MaxSupport := false;
    var boolean v_Found_Nr_UE_RxTxTEG_ID_MaxSupport := false;
    var boolean v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGs := false;
    var boolean v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGsSimul := false;

    if (ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17)) {
      for (v_Index := 0; v_Index < lengthof(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17); v_Index:=v_Index+1) {
        if ((ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_RxTEG_ID_MaxSupport_r17)) and
           (p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_RxTEG_ID_MaxSupport_r17 == pc_nr_UE_RxTEG_ID_MaxSupport)) {
         v_Found_Nr_UE_RxTEG_ID_MaxSupport := true;
        }
        if ((ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_TxTEG_ID_MaxSupport_r17)) and
           (p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_TxTEG_ID_MaxSupport_r17 == pc_nr_UE_TxTEG_ID_MaxSupport)) {
         v_Found_Nr_UE_TxTEG_ID_MaxSupport := true;
        }
        if ((ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_RxTxTEG_ID_MaxSupport_r17)) and
           (p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].nr_UE_RxTxTEG_ID_MaxSupport_r17 == pc_nr_UE_RxTxTEG_ID_MaxSupport)) {
         v_Found_Nr_UE_RxTxTEG_ID_MaxSupport := true;
        }
        if ((ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].measureSameDL_PRS_ResourceWithDifferentRxTEGs_r17)) and
           (p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].measureSameDL_PRS_ResourceWithDifferentRxTEGs_r17 == pc_measureSameDL_PRS_ResourceWithDifferentRxTEGs)) {
         v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGs := true;
        }
        if ((ispresent(p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].measureSameDL_PRS_ResourceWithDifferentRxTEGsSimul_r17)) and
           (p_NR_UE_TEG_Capability.nr_UE_TEG_ID_CapabilityBandList_r17[v_Index].measureSameDL_PRS_ResourceWithDifferentRxTEGsSimul_r17 == pc_measureSameDL_PRS_ResourceWithDifferentRxTEGsSimul)) {
         v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGsSimul := true;
        }
      }
      if (not (v_Found_Nr_UE_RxTEG_ID_MaxSupport and v_Found_Nr_UE_TxTEG_ID_MaxSupport and v_Found_Nr_UE_RxTxTEG_ID_MaxSupport and
             v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGs and v_Found_MeasureSameDL_PRS_ResourceWithDifferentRxTEGsSimul)) {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR-UE-TEG");
      }
    }
  }

  /*
   * @desc      To check Positioning modes supported
   * @param     p_PositioningModes
   * @param     p_UeBasedPics
   * @param     p_UeAssistedPics
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_PositioningModes(PositioningModes p_PositioningModes,
                                                       boolean p_UeBasedPics,
                                                       boolean p_UeAssistedPics) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    // Removed returned booleand and added if at the end of the function to compare PICS and capabilities
    var boolean v_PosModesUeBased := false;
    var boolean v_PosModesUeAssisted := false;

    select (lengthof(p_PositioningModes.posModes)) {
      case (1) {
        v_PosModesUeBased := false;
        v_PosModesUeAssisted := false;
      }
      case (2) {
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := false;
      }
      case else {
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 2);
      }
    }
    if (not((p_UeBasedPics == v_PosModesUeBased) and (p_UeAssistedPics == v_PosModesUeAssisted))) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for Positioning Modes");
    }
  }

  /*
   * @desc      To check periodical reporting per supported Positioning modes
   * @param     p_PositioningModes
   * @param     p_StandalonePics
   * @param     p_UeBasedPics
   * @param     p_UeAssistedPics
   * @return    boolean
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_PeriodicalReporting(PositioningModes p_PositioningModes,
                                                          boolean p_StandalonePics,
                                                          boolean p_UeBasedPics,
                                                          boolean p_UeAssistedPics) return boolean
  { //@sic POS Rel-16 R5-213638 sic@
    var boolean v_PosModesStandalone := false;
    var boolean v_PosModesUeBased := false;
    var boolean v_PosModesUeAssisted := false;

    select (lengthof(p_PositioningModes.posModes)) {
      case (1) {
        v_PosModesStandalone := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 0);
        v_PosModesUeBased := false;
        v_PosModesUeAssisted := false;
      }
      case (2) {
        v_PosModesStandalone := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 0);
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := false;
      }
      case else {
        v_PosModesStandalone := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 0);
        v_PosModesUeBased := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 1);
        v_PosModesUeAssisted := f_Bitstring_BitIsSet(p_PositioningModes.posModes, 2);
      }
    }

    return ((p_StandalonePics == v_PosModesStandalone) and //Check standalone
            (p_UeBasedPics == v_PosModesUeBased) and      //Check ue-based
            (p_UeAssistedPics == v_PosModesUeAssisted));  //Check ue-assisted
  }

   /*
   * @desc      Configuration of measurement gaps for OTDOA acc. to TS 37.571-2, Table 9.3.4.2.3.1-1
   * @status    APPROVED (POS)
   */
  function f_NR_ConfigMeasGap_OTDOA () runs on NR_BASE_PTC
  {
    var template (omit) MeasConfig v_MeasConfig;
    var ARFCN_ValueNR v_SSB_Freq := f_NR_CellInfo_GetFrequencySSB(nr_Cell1); // @sic R5-227527 sic@
    var SubcarrierSpacing v_SubCarrierSpacing := f_NR_CellInfo_GetSSB_SCS(nr_Cell1); // @sic R5-227527 sic@

    v_MeasConfig := cs_NR_MeasConfig_MeasGap(v_SSB_Freq, v_SubCarrierSpacing, cds_MeasGapConfig_UE(cs_NR_GapConfig_OTDOA)); // @sic R5-227527 sic@
    f_NR_SendRRCReconfiguration(nr_Cell1,-,-,-,-, v_MeasConfig);
  }

  /*
   * @desc      Function to configured DL-PRS in SS
   * @param     p_CellId
   * @param     p_NR_SYSTEM_CTRL_POSEXT_REQ
   * @status    APPROVED (POS)
   */
   function f_POS_NR_SS_DlPrsCellConfig(NR_CellId_Type p_CellId,
                                       template (value) NR_SYSTEM_CTRL_POSEXT_REQ p_NR_SYSTEM_CTRL_POSEXT_REQ) runs on NR5GC_POS_PTC
  {
    SYS_POSEXT.send(p_NR_SYSTEM_CTRL_POSEXT_REQ);
    if (valueof(p_NR_SYSTEM_CTRL_POSEXT_REQ.Common.ControlInfo.CnfFlag) == true) {
      SYS_POSEXT.receive ( car_NR_CellConfig_PosExt_CNF (p_CellId) );
    }
  }

  /*
   * @desc      Create and configure cell for DL-PRS
   * @param     p_CellId
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CellConfig_DlPrs(NR_CellId_Type p_CellId) runs on NR5GC_POS_PTC
  {
    var template (value) NR_DL_PRS_Info_r16 v_DlPrsInfo;

    select (p_CellId) { //@sic R5s221043 sic@
      case (nr_Cell1) {
        v_DlPrsInfo := cs_NR_DL_PRS_Info_Def(f_POS_NR_Set_DlPrsPeriodicityAndOffset_11ms(p_CellId), 0, 0); //@sic R5s230101 sic@
      }
      case (nr_Cell2) {
        v_DlPrsInfo := cs_NR_DL_PRS_Info_Def(f_POS_NR_Set_DlPrsPeriodicityAndOffset_11ms(p_CellId), 1, 1); //@sic R5s230101 sic@
      }
      case (nr_Cell3) {
        v_DlPrsInfo := cs_NR_DL_PRS_Info_Def(f_POS_NR_Set_DlPrsPeriodicityAndOffset_11ms(p_CellId), 2, 0); //@sic R5s230101 sic@
      }
      case else { FatalError(__FILE__, __LINE__, "Invalid NR CellId"); }
    }

    f_NR_CellConfig_Def(p_CellId);

    //Configure DL-PRS
    f_POS_NR_SS_DlPrsCellConfig(p_CellId, cas_NR_CellConfig_DlPrs_REQ(p_CellId,
                                                                      cs_DlPrsFreqLayerConfig,
                                                                      cs_DlPrsTRPConfig(v_DlPrsInfo)));
  }

  /*
   * @desc      Configuration of UL-SRS for Multi-RTT acc. to TS 37.571-2, Table 9.3.1.2.3.1-2, Table 9.3.3.1B.3.1-2, Table 9.3.4.2.3.1-2 or Table 9.3.4.4.3.1-2
   * @param     p_NR_CellId
   * @param     p_MeasConfig        (default value: omit)
   * @status    APPROVED (POS)
   */
  function f_NR_ConfigUlSrsMultiRTT (NR_CellId_Type p_NR_CellId,
                                     template (omit) MeasConfig p_MeasConfig := omit) runs on NR_BASE_PTC
  { //@sic R5-233395, R5-246429:added parameter p_MeasConfig sic@
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) SpCellConfig v_SpCellConfig := f_NR_GetSpCellConfigDef(p_NR_CellId);
    var template (omit) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var template (value) SRS_PeriodicityAndOffset_r16 v_SRS_PeriodicityAndOffset;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var boolean v_IsFDD := f_NR_CellInfo_GetIsFDD(p_NR_CellId);
    var NR_CellInfo_Type v_NR_CellInfo;
    var template (value) NR_SYSTEM_CTRL_REQ v_NR_SYSTEM_CTRL_REQ;

    if(f_NR_CellInfo_GetIsFR1(p_NR_CellId))
    {
      if ((pc_halfDuplexFDD_TypeA_RedCap_r17 or not(v_IsFDD)) and (v_SCS == kHz15)) {
        v_SRS_PeriodicityAndOffset := {sl160 := 23};
      }
      else if (not(v_IsFDD) and (v_SCS == kHz30)) {
        v_SRS_PeriodicityAndOffset := {sl160 := 27};
      }
      else {
        v_SRS_PeriodicityAndOffset := {sl160 := 20};
      }
    }
    else
    {
      v_SRS_PeriodicityAndOffset := {sl1280 := 163};
    }
    v_SpCellConfig.spCellConfigDedicated := cs_NR_ServingCellConfigDef(-,-,-, cs_NR_UplinkConfigSrs(cs_SRS_Config_Pos(v_SRS_PeriodicityAndOffset)));
    v_CellGroupConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_MCG,
                                                  -,-,-,-,
                                                  v_SpCellConfig);
    v_V1530Ext := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_CellGroupConfig)));

    f_NR_SendRRCReconfiguration(nr_Cell1, -,-, v_V1530Ext, -, p_MeasConfig);

    //Store UL-SRS in cell info
    f_NR_CellInfo_SetUL_SRS(p_NR_CellId, cs_SRS_Config_Pos(v_SRS_PeriodicityAndOffset), 0);

    //Configure SS with SL-SRS
    v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    //@sic R5s230513 sic@
    v_NR_SYSTEM_CTRL_REQ := cads_NR_UplinkBWP_ConfigCommon_REQ(p_NR_CellId,
                                                               cs_TimingInfo_Now,
                                                               {cs_NR_SRS_Config(v_NR_CellInfo)});

    f_NR_SS_CommonCellConfig(p_NR_CellId,
                             v_NR_SYSTEM_CTRL_REQ);

  }

  /*
   * @desc      Conver type SubcarrierSpacing to type NR_DL_PRS_PositioningFrequencyLayer_r16.dl_PRS_SubcarrierSpacing_r16
   * @param     p_NR_SCS
   * @return    NR_DL_PRS_PositioningFrequencyLayer_r16.dl_PRS_SubcarrierSpacing_r16
   * @status    APPROVED (POS)
   */
  function f_POS_NR_Convert_NrScsToLppScs(SubcarrierSpacing p_NR_SCS)
    return NR_DL_PRS_PositioningFrequencyLayer_r16.dl_PRS_SubcarrierSpacing_r16
  {
    var NR_DL_PRS_PositioningFrequencyLayer_r16.dl_PRS_SubcarrierSpacing_r16 v_LppScs;
    select (p_NR_SCS) {
      case(kHz15) {
        v_LppScs := kHz15;
      }
      case(kHz30) {
        v_LppScs := kHz30;
      }
      case(kHz60) {
        v_LppScs := kHz60;
      }
      case(kHz120) {
        v_LppScs := kHz120;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Wrong SCS");
      }
    }
    return v_LppScs;
  }

  /*
   * @desc      Conver type SubcarrierSpacing to type NR_SSB_Config_r16.ssb_SubcarrierSpacing_r16
   * @param     p_NR_SCS
   * @return    NR_SSB_Config_r16.ssb_SubcarrierSpacing_r16
   * @status    APPROVED (POS)
   */
  function f_POS_NR_Convert_NrScsToLppSsbScs(SubcarrierSpacing p_NR_SCS)
    return NR_SSB_Config_r16.ssb_SubcarrierSpacing_r16
  {
    var NR_SSB_Config_r16.ssb_SubcarrierSpacing_r16 v_LppSsbScs;
    select (p_NR_SCS) {
      case(kHz15) {
        v_LppSsbScs := kHz15;
      }
      case(kHz30) {
        v_LppSsbScs := kHz30;
      }
      case(kHz60) {
        v_LppSsbScs := kHz60;
      }
      case(kHz120) {
        v_LppSsbScs := kHz120;
      }
      case(kHz240) {
        v_LppSsbScs := kHz240;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Wrong SSB SCS");
      }
    }
    return v_LppSsbScs;
  }

  /*
   * @desc      Set content of NR-DL-PRS-PositioningFrequencyLayer according to 37.571-2, Table 8.4.1.6-1
   * @param     p_CellId
   * @param     p_ResourceBW        (default value: 1)
   * @return    template
   * @status    APPROVED (POS)
   */
  function f_POS_NR_Set_DlPrsPositioningFreqLayer(NR_CellId_Type p_CellId,
                                                  integer p_ResourceBW := 1) runs on NR_BASE_PTC
     return template (value) NR_DL_PRS_PositioningFrequencyLayer_r16
  {//@sic R5-246430: added parameter p_ResourceBW sic@
    var template (value) NR_DL_PRS_PositioningFrequencyLayer_r16 v_DlPrsPositioningFreqLayer;

    v_DlPrsPositioningFreqLayer := cs_DlPrsPositioningFreqLayer_Def(f_POS_NR_Convert_NrScsToLppScs(f_NR_CellInfo_GetSCS(p_CellId)),
                                                                    f_NR_CellInfo_GetOffsetToCarrier(p_CellId),
                                                                    f_NR_CellInfo_GetAbsoluteFrequencyPointA(p_CellId),
                                                                    p_ResourceBW); //@sic R5-246430 sic@

    return v_DlPrsPositioningFreqLayer;
  }

  /*
   * @desc      Set content of NR_DL_PRS_AssistanceDataPerTRP according to 37.571-2, Table 8.4.1.6-1
   * @param     p_CellId
   * @param     p_ExpRSTD_Uncert
   * @param     p_DlPrsResourceId   (default value: 0)
   * @return    template
   * @status    APPROVED (POS)
   */
  function f_POS_NR_Set_DlPrsAssistanceDataPerTRP(NR_CellId_Type p_CellId,
                                                  integer p_ExpRSTD_Uncert,
                                                  integer p_DlPrsResourceId :=0) runs on NR_BASE_PTC return template (value) NR_DL_PRS_AssistanceDataPerTRP_r16
  {
    var template (value) NR_DL_PRS_AssistanceDataPerTRP_r16 v_DlPrs_AssistanceDataPerTRP;
    var NCGI_r15 v_CellGlobalId := f_POS_Get_CellGlobalId(p_CellId);
    var ARFCN_ValueNR v_FrequencySSB := f_NR_CellInfo_GetFrequencySSB(p_CellId);
    var NR_DL_PRS_Periodicity_and_ResourceSetSlotOffset_r16 v_PeriodicityAndOffset := f_POS_NR_Set_DlPrsPeriodicityAndOffset_11ms(p_CellId);
    var PhysCellId v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(p_CellId); //@sic R5s240144 sic@

    select(p_CellId){
      case (nr_Cell1) {
        v_DlPrs_AssistanceDataPerTRP := cs_DlPrsAssistanceDataPerTRP(0, v_PhysCellId, v_CellGlobalId, v_FrequencySSB, cs_NR_DL_PRS_Info_Def(v_PeriodicityAndOffset, 0, 0, p_DlPrsResourceId), p_ExpRSTD_Uncert); //@sic R5s221043, R5s230101, R5s240144 sic@
      }
      case (nr_Cell2) {
        v_DlPrs_AssistanceDataPerTRP := cs_DlPrsAssistanceDataPerTRP(1, v_PhysCellId, v_CellGlobalId, v_FrequencySSB, cs_NR_DL_PRS_Info_Def(v_PeriodicityAndOffset, 1, 1, p_DlPrsResourceId), p_ExpRSTD_Uncert); //@sic R5s221043, R5s230101, R5s240144 sic@
      }
      case (nr_Cell3) {
        v_DlPrs_AssistanceDataPerTRP := cs_DlPrsAssistanceDataPerTRP(2, v_PhysCellId, v_CellGlobalId, v_FrequencySSB, cs_NR_DL_PRS_Info_Def(v_PeriodicityAndOffset, 2, 0, p_DlPrsResourceId), p_ExpRSTD_Uncert); //@sic R5s221043, R5s230101, R5s240144 sic@
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid Cell ID");
      }
    }
    return v_DlPrs_AssistanceDataPerTRP;
  }

  /*
   * @desc      Set DlPrsPeriodicityAndOffset to value 11 for the corresponding SCS
   * @param     p_CellId
   * @return    NR_DL_PRS_Periodicity_and_ResourceSetSlotOffset_r16
   * @status    APPROVED (POS)
   */
  function f_POS_NR_Set_DlPrsPeriodicityAndOffset_11ms(NR_CellId_Type p_CellId) runs on NR_BASE_PTC return NR_DL_PRS_Periodicity_and_ResourceSetSlotOffset_r16
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_CellId);
    var NR_DL_PRS_Periodicity_and_ResourceSetSlotOffset_r16 v_PeriodicityAndOffset;
    select(v_SCS)
    {//@sic R5s220672 sic@
      case (kHz15) {
        v_PeriodicityAndOffset := {scs15_r16 := {n160_r16 := 11}};
      }
      case (kHz30){
        v_PeriodicityAndOffset := {scs30_r16 := {n160_r16 := 11}};
      }
      case (kHz60){
        v_PeriodicityAndOffset := {scs60_r16 := {n160_r16 := 11}};
      }
      case (kHz120){
        v_PeriodicityAndOffset := {scs120_r16 := {n160_r16 := 11}};
      }
      case else {
        FatalError (__FILE__, __LINE__, "SCS not valid");
      }
    }
    return v_PeriodicityAndOffset;
  }

  /*
   * @desc      This is the opposite function to f_NR_Asn2NAS_PlmnId, but putting Mcc and Mnc as in NCGI-r15 type
   *            See 24.008, 10.5.1.13
   *            v_NP[0]    v_NP[1]    v_NP[2]    v_NP[3]    v_NP[4]    v_NP[5]
   *            v_MCC[1] & v_MCC[0] & v_MNC[2] & v_MCC[2] & v_MNC[1] & v_MNC[0])
   * @param     p_NAS_PlmnId
   * @return    NCGI_r15
   * @status    APPROVED (POS)
   */
  function f_POS_NAS_PlmnId2NcgiMccMnc (NAS_PlmnId p_NAS_PlmnId) return NCGI_r15
  {
    var hexstring v_NP := oct2hex (p_NAS_PlmnId);
    var hexstring v_MNC := (v_NP[5] & v_NP[4] & v_NP[2]);
    var hexstring v_MCC := (v_NP[1] & v_NP[0] & v_NP[3]);
    var NCGI_r15 v_Ncgi;
    var integer I;

    for (I := 0; I < lengthof(v_MCC); I := I + 1) {
      v_Ncgi.mcc_r15[I] := hex2int (v_MCC[I]);
    }

    for (I := 0; I < lengthof(v_MCC); I := I + 1) {
      if (v_MNC[I]!='F'H) {
        v_Ncgi.mnc_r15[I] := hex2int (v_MNC[I]);
      }
    }

    return v_Ncgi;
  }

  /*
   * @desc      Get CellGlobalId from CellInfo
   * @param     p_CellId
   * @return    NCGI_r15
   * @status    APPROVED (POS)
   */
  function f_POS_Get_CellGlobalId (NR_CellId_Type p_CellId) runs on NR_BASE_PTC return NCGI_r15
  {
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var NCGI_r15 v_Ncgi := f_POS_NAS_PlmnId2NcgiMccMnc (v_PLMN);

    v_Ncgi.nr_cellidentity_r15 := f_NR_CellInfo_GetCellIdentity(p_CellId);

    return v_Ncgi;
  }

  /*
   * @desc      Set content of NR-DL-PRS-AssistanceData according to 37.571-2, Table 8.4.1.6-1
   * @param     p_NumberOfTrps
   * @param     p_ExpRSTD_Uncert    (default value: 4)
   * @param     p_ResourceBW        (default value: 1)
   * @return    template
   * @status    APPROVED (POS)
   */
  function f_POS_Set_DlPrsAssistanceData(integer p_NumberOfTrps,
                                         integer p_ExpRSTD_Uncert := 4,
                                         integer p_ResourceBW := 1) runs on NR_BASE_PTC
    return template (value) NR_DL_PRS_AssistanceData_r16
  {  // @sic R5-246430: added parameter p_ResourceBW sic@
    var template (value) NR_DL_PRS_AssistanceData_r16 v_DlPrsAssistData;

    select(p_NumberOfTrps) {
      case (1) {
        v_DlPrsAssistData := cs_DlPrsAssistanceData(cs_DlPrsAssistanceDataList_OneFreqLayer(cs_DlPrsAssistanceDataPerFreq(f_POS_NR_Set_DlPrsPositioningFreqLayer(nr_Cell1, p_ResourceBW), // @sic R5-246430 sic@
                                                                                                                          {f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell1, p_ExpRSTD_Uncert)})));
      }
      case (2) {
        v_DlPrsAssistData := cs_DlPrsAssistanceData(cs_DlPrsAssistanceDataList_OneFreqLayer(cs_DlPrsAssistanceDataPerFreq(f_POS_NR_Set_DlPrsPositioningFreqLayer(nr_Cell1, p_ResourceBW), // @sic R5-246430 sic@
                                                                                                                          {f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell1, p_ExpRSTD_Uncert),
                                                                                                                           f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell2, p_ExpRSTD_Uncert)})));
      }
      case (3) {
        v_DlPrsAssistData := cs_DlPrsAssistanceData(cs_DlPrsAssistanceDataList_TwoFreqLayer(cs_DlPrsAssistanceDataPerFreq(f_POS_NR_Set_DlPrsPositioningFreqLayer(nr_Cell1, p_ResourceBW), // @sic R5-246430 sic@
                                                                                                                          {f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell1, p_ExpRSTD_Uncert),
                                                                                                                           f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell2, p_ExpRSTD_Uncert)}),
                                                                                            cs_DlPrsAssistanceDataPerFreq(f_POS_NR_Set_DlPrsPositioningFreqLayer(nr_Cell3, p_ResourceBW), // @sic R5-246430 sic@
                                                                                                                          {f_POS_NR_Set_DlPrsAssistanceDataPerTRP(nr_Cell3, p_ExpRSTD_Uncert)})),
                                                    cs_NrSsbConfigOneEntry(cs_NrSsbConfig(3,
                                                                                          f_NR_CellInfo_GetFrequencySSB(nr_Cell3),
                                                                                          f_POS_NR_Convert_NrScsToLppSsbScs(f_NR_CellInfo_GetSSB_SCS(nr_Cell3)))));
      }
    }
    return v_DlPrsAssistData;
  }

}
