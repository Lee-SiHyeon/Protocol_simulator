module UTRAN34_Data_Templates {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_24008TypeDefs all;
  import from UTRAN_TypeDefs all;

  template (value) RLC_AM_TestDataReq cs_RLC_AM_DataReq(UTRAN_CellId_Type p_CellId,
                                                        SS_RB_Identity p_RB_Id,
                                                        template (value) TrD_PDU p_Data):=
  { /* @status    APPROVED (UTRAN) */
    cellId := f_UtranCellId2Int(p_CellId),
    rB_Id  := p_RB_Id,
    data   := p_Data
  };

  template (present) RLC_AM_TestDataInd cr_RLC_AM_DataInd(UTRAN_CellId_Type p_CellId,
                                                          SS_RB_Identity p_RB_Id,
                                                          template (present) TrD_PDU p_Data):=
  { /* @status    APPROVED (UTRAN) */
    cellId := f_UtranCellId2Int(p_CellId),
    rB_Id  := p_RB_Id,
    data   := p_Data    ifpresent
  };

  template (value) U_RLC_AM_REQ cas_RLC_AM_TestData_Req(template (value) RLC_AM_TestDataReq p_TestData) :=
  { /* @status    APPROVED (UTRAN) */
    testData    := p_TestData
  };

  template (present) U_RLC_AM_IND car_RLC_AM_TestData_Ind(template RLC_AM_TestDataInd p_TestData) :=
  { /* @status    APPROVED (UTRAN) */
    testData    := p_TestData
  };

  template (value) TrD_PDU cs_TrD_Data(bitstring p_Data) :=
  { /* @status    APPROVED (UTRAN) */
    data := p_Data
  };

  template (present) TrD_PDU cr_TrD_Data(template bitstring p_Data) :=
  { /* @status    APPROVED (UTRAN) */
    data := p_Data
  };

}
