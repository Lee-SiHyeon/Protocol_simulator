  const bitstring tsc_GLONASSPositioningMethod := '0000010000000000'B;                    /* @status    APPROVED (POS) Bit 5=1 for GLONASS. See 25.331, 10.3.7.111 @sic R5s150706: MSB 0 sic@*/

  const bitstring tsc_GPSAndModernizedGPSPositioningMethod := '1001000000000000'B;        /* @status    APPROVED (POS) Bit 0 and 3=1 for GPS and Modernized GPS @sic R5s150706: MSB 0 sic@*/

  const bitstring tsc_GPSAndGLONASSPositioningMethod := '1001010000000000'B;              /* @status    APPROVED (POS) Bit 0 and 3 and 5=1 for GPS and GLONASS. See 25.331, 10.3.7.111 @sic R5s150706: MSB 0 sic@, @sic R5-155101 sic@ */

  const bitstring tsc_GalileoPositioningMethod := '0100000000000000'B;                    /* @status    APPROVED (POS) Bit 1=1 for Galileo. See 25.331, 10.3.7.111 @sic R5s150706: MSB 0 sic@*/

  const bitstring tsc_BDSPositioningMethod := '0000001000000000'B;                        /* @status    APPROVED (POS) Bit 6=1 for BDS. See 25.331, 10.3.7.111 */

  const bitstring tsc_GPSAndBDSPositioningMethod := '1001001000000000'B;                  /* @status    APPROVED (POS) Bit 0 and 3 and 6=1 for GPS and BDS. See 25.331, 10.3.7.111 @sic R5-155101 sic@ */

  const bitstring tsc_GPSAndGalileoPositioningMethod := '1101000000000000'B;              /* @status    APPROVED (POS) Bit 0 and 1 and 3=1 for GPS and Galileo. See 25.331, 10.3.7.111 @sic R5-165993 sic@ */

  const integer tsc_GLONASS_Id := 3;                                                      /* @status    APPROVED (POS) GANSS ID for GLONASS */

  const integer tsc_ModernizedGPS_Id := 1;                                                /* @status    APPROVED (POS) GANSS ID for Modernized GPS */

  const integer tsc_BDS_Id := 4;                                                          /* @status    APPROVED (POS) GANSS ID for BDS */

