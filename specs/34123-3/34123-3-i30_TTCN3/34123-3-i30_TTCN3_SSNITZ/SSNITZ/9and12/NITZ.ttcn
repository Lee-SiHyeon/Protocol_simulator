module NITZ {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_AuxiliaryDefsAndFunctions all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_Parameters all;
  import from UTRAN34_RRC_CommonFunctions all;
  import from UTRANGERAN_CommonFunctions all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  template (value) GMM_INFORMATION cs_GmmInformation(template (omit) NetworkName p_FullNtwName := omit,
                                                     template (omit) NetworkName p_ShortNtwName := omit,
                                                     template (omit) TimeZone p_LocalTimeZone := omit,
                                                     template (omit) TimeZoneAndTime p_UniversalTimeAndLocalTimeZone := omit,
                                                     template (omit) LSA_Id p_LSA_Id := omit,
                                                     template (omit) DaylightSavingTime p_NtwDaylightSavingTime := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    skipIndicator            := '0000'B,
    gMMProtocolDiscriminator := tsc_GMM_PD,
    msgType                  := '00100001'B,  // Table 10.4/3GPP TS 24.008
    fullNtwName              := p_FullNtwName,
    shortNtwName             := p_ShortNtwName,
    localTimeZone            := p_LocalTimeZone,
    universalTimeAndLocalTimeZone := p_UniversalTimeAndLocalTimeZone,
    lSA_Id                   := p_LSA_Id,
    ntwDaylightSavingTime    := p_NtwDaylightSavingTime
  };

  template (value) MM_INFORMATION cs_MmInformation(template (omit) NetworkName p_FullNtwName := omit,
                                                   template (omit) NetworkName p_ShortNtwName := omit,
                                                   template (omit) TimeZone p_LocalTimeZone := omit,
                                                   template (omit) TimeZoneAndTime p_UniversalTimeAndLocalTimeZone := omit,
                                                   template (omit) LSA_Id p_LSA_Id := omit,
                                                   template (omit) DaylightSavingTime p_NtwDaylightSavingTime := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    skipIndicator            := '0000'B,
    mMProtocolDiscriminator  := '0101'B, // MM protocol discriminator
    msgType                  := '00110010'B,  // Table 10.2/3GPP TS 24.008
    fullNtwName              := p_FullNtwName,
    shortNtwName             := p_ShortNtwName,
    localTimeZone            := p_LocalTimeZone,
    universalTimeAndLocalTimeZone := p_UniversalTimeAndLocalTimeZone,
    lSA_Id                   := p_LSA_Id,
    ntwDaylightSavingTime    := p_NtwDaylightSavingTime
  };

  template (value) RRCDataReqType  cs_U_GmmInformation(template (omit) NetworkName p_FullNtwName := omit,
                                                       template (omit) NetworkName p_ShortNtwName := omit,
                                                       template (omit) TimeZone p_LocalTimeZone := omit,
                                                       template (omit) TimeZoneAndTime p_UniversalTimeAndLocalTimeZone := omit,
                                                       template (omit) LSA_Id p_LSA_Id := omit,
                                                       template (omit) DaylightSavingTime p_NtwDaylightSavingTime := omit):=
  { /* @status    APPROVED (SSNITZ) */
    gmmInformation := cs_GmmInformation(p_FullNtwName, p_ShortNtwName, p_LocalTimeZone, p_UniversalTimeAndLocalTimeZone, p_LSA_Id, p_NtwDaylightSavingTime)
  };

  template (value) RRCDataReqType  cs_U_MmInformation(template (omit) NetworkName p_FullNtwName := omit,
                                                      template (omit) NetworkName p_ShortNtwName := omit,
                                                      template (omit) TimeZone p_LocalTimeZone := omit,
                                                      template (omit) TimeZoneAndTime p_UniversalTimeAndLocalTimeZone := omit,
                                                      template (omit) LSA_Id p_LSA_Id := omit,
                                                      template (omit) DaylightSavingTime p_NtwDaylightSavingTime := omit):=
  { /* @status    APPROVED (SSNITZ) */
    mmInformation := cs_MmInformation(p_FullNtwName, p_ShortNtwName, p_LocalTimeZone, p_UniversalTimeAndLocalTimeZone, p_LSA_Id, p_NtwDaylightSavingTime)
  };

  template (value) TimeZoneAndTime cs_UniversalTime(O1_Type p_CurrentYear,
                                                    O1_Type p_TimeZone) :=
  /* @status    APPROVED (SSNITZ) */
    cs_TimeZoneAndTime(p_CurrentYear, '21'O, '13'O, '60'O, '52'O, '00'O, p_TimeZone); // @sic R5s250029 sic@

  /*
   * @desc      To perform location updating procedure plus attach procedure in case of PS support to provide the UE with MM information
   * @param     p_U_MmInformation
   * @status    APPROVED (SSNITZ)
   */
  function f_UTRAN34_NITZ_LocationUpdate(template (value) RRCDataReqType  p_U_MmInformation) runs on UTRAN_PTC
  {  //@sic R5s150611 change 2 sic@
    
    var template (value) RRCDataReqType  v_U_MmInformation := p_U_MmInformation;
    
    //If PS mode: a GMM attach procedure should be performed
    //Receive Location Updating Request message
    //Send ATTACH ACCEPT
    //Receive ATTACH COMPLETE
    //The SS starts integrity protection.
    //Send SECURITY MODE COMMAND and receive SECURITY MODE COMPLETE
    //MM information (p_U_MmInformation) sent to the UE
    //Send Location Updating Accept message
    //The SS releases the RRC connection
    f_UTRAN34_RRC_ConnEst(utran34_CellA, registration);
    if (pc_PS == true) {
      f_UTRAN34_GMMOnly_Attach_WithoutRRCConnection(utran34_CellA, -, -, v_U_MmInformation, -, -, -, -, -, -, NONE);
    } else {
      f_UTRAN34_LocationUpdate(utran34_CellA, true, NONE, -, -, -, v_U_MmInformation); // @sic R5s150830 sic@
      f_UTRAN34_RRC_ConnRel(utran34_CellA, cell_Dch);
    }
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 9.4.10
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_9_4_10_UTRAN()runs on UTRAN_PTC
  { /* NITZ / MM / Time zone, Time and DST Handling */

    //Initialise UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    //Initial Conditions:
    // One cell operating in network operation mode II.
    f_UTRAN_CellInfo_SetNMO (utran34_CellA, tsc_NMO_II);
    
    // Cell1 started switched on with default power level
    f_UTRAN34_SS_CreateCellDCH(utran34_CellA);
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_CellA);
    
    f_UTRAN34_Preamble(utran34_CellA);  //@sic R5s150611 add. change sic@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE); //@sic R5s150895 sic@
    
    // Initial condition: The UE is switched off with a valid USIM inserted
    f_UTRAN_TestBody_Set(true);
    
    fl_TC_9_4_10_Body();
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell
    f_UTRAN_ReleaseCell (utran34_CellA, f_UTRAN_CellInfo_GetConfigType(utran34_CellA));
  }

  /*
   * @desc      test body of TC_9_4_10
   * @status    APPROVED (SSNITZ)
   */
  function fl_TC_9_4_10_Body() runs on UTRAN_PTC
  {
    var charstring v_AT_CTZE_Response; // CTZE response received upon CTZR
    var integer v_CurrentYear := f_NITZ_GetCurrentYear();
    var O1_Type v_CurrentYearOct := f_NITZ_CurrentYear2Oct(v_CurrentYear);
    var charstring v_CurrentYearStr := f_NITZ_CurrentYear2Str(v_CurrentYear);
    var charstring v_CurrentYearStrExt := "20" & v_CurrentYearStr;
    var charstring v_Quote := oct2char ('22'O);
    var charstring v_Expression_CTZR := "*"&v_Quote&"(*)"&v_Quote&",([0-9])*"&v_Quote&"(*)"&v_Quote&"*"; // used for LTZ, DST and Time checking @sic R5s180211 sic@
    var template (value) RRCDataReqType  v_U_MmInformation;
    
    f_UT_AT_SubscribeTimeZoneReporting(UT); // Enable time zone reporting

    // Checking principle:
    // LTZ not sent  => LTZ not checked
    // DST not in use  => DST not checked
    // Minute and seconds not checked
    
    //@siclog "Step 1" siclog@
    //The UE is powered up or switched on and initiates an attach
    f_UT_SwitchOnUE (UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "06", "??", "??", "+0", "?"); //@sic R5s150611 add change, R5-222018 sic@
    //@siclog "Steps 2-9" siclog@
    // Universal Time IE is included: "< Current Year >/ 12/31 06:25:00! for UT, !0 hour! for Timezone, Local Time Zone IE included: "0 hour" for Timezone, No DST IE included
    v_U_MmInformation := cs_U_MmInformation(-, -, cs_TimeZone ('00'O), cs_UniversalTime (v_CurrentYearOct, '00'O), -, -);
    f_UTRAN34_NITZ_LocationUpdate (v_U_MmInformation);
    
    //@siclog "Step 10" siclog@
    //Operator Action: The use of the supported Fields is checked:
    //Universal Time: Year: < Current Year >, Month:  December, Day: 31st, Hour: 6 Hours, Minute: 25 Minutes (not so relevant), Timezone: GMT+0
    //Local Time Zone: Timezone: GMT+0
    //DST: Daylight Saving Time not in use (i.e. winter time)
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected  @sic R5s150611 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,06:[0-9]#(2):[0-9]#(2)", // TZ GMT+1, dst (1 char) ignored, check date and hour, ignore mins, secs, @sic R5-222018 sic@
                         "Test Case 9.4.10, Step 10",
                         v_Expression_CTZR,
                         2);
    }
    if (pc_LocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "\+00", // LTZ=GMT+0
                         "Test Case 9.4.10, Step 10",
                         v_Expression_CTZR);
    }
    
    //@siclog "Steps 11-12" siclog@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE, NotSpecified);
    
    //@siclog "Step 13" siclog@
    f_UT_SwitchOnUE(UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "07", "??", "??", "+1", "1"); //@sic R5s150611 add change, R5-222018 sic@
    //@siclog "Step 14-21" siclog@
    v_U_MmInformation := cs_U_MmInformation(-, -, -, cs_UniversalTime(v_CurrentYearOct, '40'O), -, cs_DaylightSavingTime_tlv('01'B));
    f_UTRAN34_NITZ_LocationUpdate (v_U_MmInformation);
    
    //@siclog "Step 22" siclog@
    //Operator Action: The use of the supported Fields is checked:
    //Universal Time: Year: < Current Year >, Month:  December, Day: 31st, Hour: 7 Hours, Minute: 25 Minutes (not so relevant), Timezone: GMT+1
    //Local Time Zone: not sent
    //DST: Daylight Saving Time in use (i.e. summer time)
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected  @sic R5s150611 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,07:[0-9]#(2):[0-9]#(2)", // TZ GMT+1, dst (1 char) ignored, check date and hour, ignore mins, secs, @sic R5-222018 sic@
                         "Test Case 9.4.10, Step 22",
                         v_Expression_CTZR,
                         2);
    }
    if (pc_DaylightSavingTime) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "1", // DST=in use
                         "Test Case 9.4.10, Step 22",
                         v_Expression_CTZR,
                         1);
    }

    //@siclog "Steps 23-24" siclog@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE, NotSpecified);
    
    //@siclog "Step 25" siclog@
    f_UT_SwitchOnUE (UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "02", "??", "??", "-4", "1"); //@sic R5s150611 add change, R5-222018 sic@
    //@siclog "Steps 26-33" siclog@
    v_U_MmInformation := cs_U_MmInformation(-, -, -, cs_UniversalTime(v_CurrentYearOct, '69'O), -, cs_DaylightSavingTime_tlv('01'B));
    f_UTRAN34_NITZ_LocationUpdate(v_U_MmInformation);
    
    //@siclog "Step 34" siclog@
    //Operator Action: The use of the supported Fields is checked:
    //Universal Time: Year: < Current Year >, Month:  December, Day: 31st, Hour: 2 Hours, Minute: 25 Minutes (not so relevant), Timezone: GMT-4
    //Local Time Zone: not sent
    //DST: Daylight Saving Time in use (i.e. summer time)
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected  @sic R5s150611 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,02:[0-9]#(2):[0-9]#(2)", // TZ GMT-4, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222018 sic@
                         "Test Case 9.4.10, Step 34",
                         v_Expression_CTZR,
                         2);
    }
    if (pc_DaylightSavingTime) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "1", // DST=in use
                         "Test Case 9.4.10, Step 34",
                         v_Expression_CTZR,
                         1);
    }

    //@siclog "Steps 35-36" siclog@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE, NotSpecified);
    
    //@siclog "Step 37" siclog@
    f_UT_SwitchOnUE (UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "23", "??", "??", "-7", "1"); //@sic R5s150611 add change, R5-222018 sic@
    //@siclog "Step 38-45" siclog@
    v_U_MmInformation := cs_U_MmInformation(-, -, -, cs_UniversalTime (v_CurrentYearOct, '8A'O), -, cs_DaylightSavingTime_tlv ('01'B));
    f_UTRAN34_NITZ_LocationUpdate (v_U_MmInformation);
    
    //@siclog "Step 46" siclog@
    //Operator Action: The use of the supported Fields is checked:
    //Universal Time: Year: < Current Year >, Month:  December, Day: 30th, Hour: 23 Hours, Minute: 25 Minutes (not so relevant), Timezone: GMT-7
    //Local Time Zone: not sent
    //DST: Daylight Saving Time in use (i.e. summer time)
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150611 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/30,23:[0-9]#(2):[0-9]#(2)", // TZ GMT-7, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222018, R5-251259 sic@
                         "Test Case 9.4.10, Step 46",
                         v_Expression_CTZR,
                         2);
    }
    if (pc_DaylightSavingTime) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "1", // DST=in use
                         "Test Case 9.4.10, Step 46",
                         v_Expression_CTZR,
                         1);
    }

    //@siclog "Steps 47-48" siclog@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE, NotSpecified);
    
    //@siclog "Step 49" siclog@
    f_UT_SwitchOnUE (UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "23", "??", "??", "-7", "?"); //@sic R5s150611 add change, R5-222018 sic@
    //@siclog "Step 50-57" siclog@
    v_U_MmInformation := cs_U_MmInformation(-, -, -, cs_UniversalTime (v_CurrentYearOct, '8A'O), -, -);
    f_UTRAN34_NITZ_LocationUpdate (v_U_MmInformation);
    
    //@siclog "Step 58" siclog@
    //Operator Action: The use of the supported Fields is checked:
    //Universal Time: Year: < Current Year >, Month:  December, Day: 30th, Hour: 23 Hours, Minute: 25 Minutes (not so relevant), Timezone: GMT-7
    //Local Time Zone: not sent
    //DST: Daylight Saving Time not in use (i.e. winter time)
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150611 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/30,23:[0-9]#(2):[0-9]#(2)", // TZ GMT-7, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222018, R5-251259 sic@
                         "Test Case 9.4.10, Step 58",
                         v_Expression_CTZR,
                         2);
    }

    //@siclog "Steps 59-60" siclog@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE, NotSpecified);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 12.2.1.13
   * @status    APPROVED (SSNITZ)
   * @desc  REFERENCE TS 34.123-1 clause 12.2.1.13
   * @status
   */
  function f_TC_12_2_1_13_UTRAN() runs on UTRAN_PTC
  { /* NITZ / GMM/ Time zone, Time and DST Handling */
    
    //Initialise UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    //Initial Conditions:
    /* Two cells operating in network operation mode I. */
    f_UTRAN_CellInfo_SetNMO (utran34_CellA, tsc_NMO_I);
    f_UTRAN_CellInfo_SetNMO (utran34_CellB, tsc_NMO_I);
    f_UTRAN_CellInfo_SetRAC(utran34_CellA, '01'O);      //RAI-1  @sic R5s150613 change 1 sic@
    f_UTRAN_CellInfo_SetRAC(utran34_CellB, '04'O);      //RAI-4
    
    // Create CellA and send sys infos
    f_UTRAN34_SS_CreateCellDCH(utran34_CellA);
    f_UTRAN34_SendDefSysInfo(utran34_CellA);
    
    // Create CellB and send sys infos
    f_UTRAN34_SS_CreateCellDCH(utran34_CellB);
    f_UTRAN34_SendDefSysInfo(utran34_CellB);
    
    f_UTRAN34_Preamble(utran34_CellA);  //@sic R5s150613 add. change sic@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE); //@sic R5s150895 sic@
    
    // Initial condition: The UE is switched off with a valid USIM inserted
    f_UTRAN_TestBody_Set(true);
    
    fl_TC_12_2_1_13_Body ();
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell
    f_UTRAN34_Postamble(utran34_CellA, U1_IDLE);
  }

  /*
   * @desc      test body of TC_12_2_1_13
   * @status    APPROVED (SSNITZ)
   */
  function fl_TC_12_2_1_13_Body() runs on UTRAN_PTC
  {
    var charstring v_AT_CTZE_Response;
    var integer v_CurrentYear := f_NITZ_GetCurrentYear();
    var O1_Type v_CurrentYearOct := f_NITZ_CurrentYear2Oct(v_CurrentYear);
    var charstring v_CurrentYearStr := f_NITZ_CurrentYear2Str(v_CurrentYear);
    var charstring v_CurrentYearStrExt := "20" & v_CurrentYearStr;
    var template (value) RRCDataReqType  v_U_GmmInformation;
    var octetstring v_PLMN_A := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(utran34_CellA));
    var octetstring v_PLMN_B:= f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(utran34_CellB));
    var octetstring v_LAC_A := f_UTRAN_CellInfo_GetLAC(utran34_CellA);
    var octetstring v_LAC_B := f_UTRAN_CellInfo_GetLAC(utran34_CellB);
    var octetstring v_RAC_A := f_UTRAN_CellInfo_GetRAC(utran34_CellA);
    var octetstring v_RAC_B := f_UTRAN_CellInfo_GetRAC(utran34_CellB);
    var template (present) RoutingAreaId v_RAI_A := cr_RAI (omit, cr_LAI(omit, v_PLMN_A, v_LAC_A), v_RAC_A);
    var template (present) RoutingAreaId v_RAI_B := cr_RAI (omit, cr_LAI(omit, v_PLMN_B, v_LAC_B), v_RAC_B);
    var charstring v_Quote := oct2char ('22'O);
    var charstring v_Expression_CTZR := "*"&v_Quote&"(*)"&v_Quote&",([0-9])*"&v_Quote&"(*)"&v_Quote&"*"; // used for LTZ, DST and Time checking @sic R5s180211 sic@
    
    f_UT_AT_SubscribeTimeZoneReporting(UT); // Enable time zone reporting
    
    // Checking principle:
    // LTZ not sent  => LTZ not checked
    // DST not in use  => DST not checked
    // Minute and seconds not checked
    
    //@siclog "Step 1" siclog@
    //Set the cell type of cell A to the "Serving cell".
    //Set the cell type of cell B to the "Non Suitable neighbour cell".
    //The UE is powered up or switched on and initiates an attach (see PICS).
    f_UTRAN_SetCellPower(utran34_CellB, tsc_AttenuationNonSuitableCell); //@sic R5s150613 change 2.1 sic@
    f_UT_SwitchOnUE(UT, false);
    

    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "05", "??", "??", "+1", "?"); //@sic R5s150613 add change, R5-222019 sic@
    //@siclog "Step 2" siclog@
    //@siclog "Step 3" siclog@
    //@siclog "Step 4" siclog@
    /*
      ATTACH ACCEPT Attach result = Attach type in step 2
      Mobile identity = P-TMSI-2
      P-TMSI-2 signature
      Routing area identity = RAI-1
    */
    //@siclog "Step 5" siclog@
    //@siclog "Step 6" siclog@
    v_U_GmmInformation := cs_U_GmmInformation(-, -, -, cs_TimeZoneAndTime(v_CurrentYearOct, '21'O, '13'O, '40'O, '51'O, '00'O, '40'O)); //@sic R5s150613 change 2.2, R5-222019 sic@
    //@siclog "Step 7" siclog@
    f_UTRAN34_GMMOnly_Attach (utran34_CellA, -, -, -, v_U_GmmInformation, px_PTMSI_2, px_PTMSI_Sig2);
    
    
    //@siclog "Step 8" siclog@
    /* Operator Action :
       The use of the supported Fields is checked:
       Universal Time:
       Year: < Current Year >
       Month:  December
       Day: 31st
       Hour: 5 Hours
       Minute: 15 Minutes
       Timezone: GMT+1
       Local Time Zone:
       Not sent
       DST:
       Daylight Saving Time not in use (i.e. winter time)
    */
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150613 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,05:[0-9]#(2):[0-9]#(2)", // TZ GMT-4, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222019 sic@
                         "Test Case 12.2.1.13, Step 8",
                         v_Expression_CTZR,
                         2);
    }

    // the following steps 9-16 resp. 17-24 are performed only if pc_LocalTimeZone is supported
    if (pc_LocalTimeZone) {
      //@siclog "Step 9" siclog@
      f_UTRAN_SetCellPower(utran34_CellA, tsc_AttenuationSuitableNeighbourCell);
      f_UTRAN_SetCellPower(utran34_CellB, tsc_AttenuationServingCell);
    
      f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "06", "??", "??", "+2", "1"); //@sic R5s150613 add change, R5-222019 sic@
      //@siclog "Step 10" siclog@
      /* Old P-TMSI signature=P-TMSI-2 signature
         Old Routing area identity = RAI-1
      */
      //@siclog "Step 11" siclog@
      //The SS starts integrity protection
      //@siclog "Step 12" siclog@
      /*
        Mobile identity = P-TMSI-1
        P-TMSI-1 signature
        Routing area identity = RAI-4
      */
      //@siclog "Step 13" siclog@
      //@siclog "Step 14" siclog@
      v_U_GmmInformation := cs_U_GmmInformation(-, -, -,
                                                cs_TimeZoneAndTime(v_CurrentYearOct, '21'O, '13'O, '40'O, '51'O, '00'O, '80'O),
                                                -,
                                                cs_DaylightSavingTime_tlv('01'B)); //@sic R5s150613 change 2.2, R5-222019, R5-250451 sic@
      //@siclog "Step 15" siclog@
      f_UTRAN_PrepareCellRRC_ConnEst(utran34_CellB, utran34_CellA);
      f_UTRAN34_GMM_RAU (utran34_CellB, -, v_U_GmmInformation, v_RAI_A, px_PTMSI_Def, px_PTMSI_Sig2, px_PTMSI_SigDef);
    
      //@siclog "Step 16" siclog@
      /* Operator Action :
         Operator Action :
         The use of the supported Fields is checked:
         Universal Time
         Year: < Current Year >
         Month:  December
         Day: 31st
         Hour: 6 Hours
         Minutes: 15 Minutes
         Timezone: GMT+2
         Local Time Zone
         Timezone: GMT+2 (DST included)
         DST:
         Daylight Saving Time in use (i.e. "summer time")
      */
      v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150613 add change sic@
      if (pc_UniversalAndLocalTimeZone) {
        f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,06:[0-9]#(2):[0-9]#(2)", // TZ GMT+2, dst (1 char), date and hour, ignore mins, seconds, @sic R5-222019 sic@
                         "Test Case 12.2.1.13, Step 16",
                         v_Expression_CTZR,
                         2);
      }
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "\+08", // LTZ=GMT+2
                         "Test Case 12.2.1.13, Step 16",
                         v_Expression_CTZR);
      if (pc_DaylightSavingTime) {
        f_AT_ResponseCheck(v_AT_CTZE_Response,
                           "1", // DST=in use
                           "Test Case 12.2.1.13, Step 16",
                           v_Expression_CTZR,
                           1);
      }

      //@siclog "Step 17" siclog@
      f_UTRAN_SetCellPower(utran34_CellB, tsc_AttenuationSuitableNeighbourCell);
      f_UTRAN_SetCellPower(utran34_CellA, tsc_AttenuationServingCell);
    
      f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "06", "??", "??", "+2", "?"); //@sic R5s150613 add change sic@ @sic R5s230675 sic@
      //@siclog "Step 18" siclog@
      //@siclog "Step 19" siclog@
      //The SS starts integrity protection
      //@siclog "Step 20" siclog@
      /*
        Mobile identity = P-TMSI-2
        P-TMSI-2 signature
        Routing area identity = RAI-1
      */
      //@siclog "Step 21" siclog@
      //@siclog "Step 22" siclog@
      v_U_GmmInformation := cs_U_GmmInformation(-, -, -,
                                                cs_TimeZoneAndTime(v_CurrentYearOct, '21'O, '13'O, '40'O, '51'O, '00'O, '80'O),
                                                -, -); //@sic R5s150613 change 2.2, R5-222019, R5-250451 sic@
      //@siclog "Step 23" siclog@
      f_UTRAN_PrepareCellRRC_ConnEst(utran34_CellA, utran34_CellB);
      f_UTRAN34_GMM_RAU (utran34_CellA, -, v_U_GmmInformation, v_RAI_B, px_PTMSI_2, px_PTMSI_SigDef, px_PTMSI_Sig2);
    
      //@siclog "Step 24" siclog@
      /* Operator Action :
         The use of the supported Fields is checked:
          Universal Time:
          Year: < Current Year >
          Month: December
          Day: 31st
          Hour: 6 Hours
          Minutes: 15 Minutes
          Timezone: GMT+2
          Local Time Zone:
          Timezone: GMT+2
          DST:
          Daylight Saving Time not in use (i.e. winter time)
      */
      v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150613 add change sic@
      if (pc_UniversalAndLocalTimeZone) {
        f_AT_ResponseCheck(v_AT_CTZE_Response, // @sic R5s230675 sic@
                         v_CurrentYearStrExt & "/12/31,06:[0-9]#(2):[0-9]#(2)", // TZ GMT+2, dst (1 char), date and the hour, ignore mins, seconds
                         "Test Case 12.2.1.13, Step 24",
                         v_Expression_CTZR,
                         2);
      }
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         "\+08", // LTZ=GMT+2
                         "Test Case 12.2.1.13, Step 24",
                         v_Expression_CTZR);
    } // if (pc_LocalTimeZone)
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 12.2.1.14
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_12_2_1_14_UTRAN() runs on UTRAN_PTC
  { /* NITZ / GMM/ NITZ Parameters Storage and Deletion */
    
    //Initialise UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    //Initial Conditions:
    // One cell operating in network operation mode I.
    f_UTRAN_CellInfo_SetNMO (utran34_CellA, tsc_NMO_I);  //@sic R5s150615 add. change sic@
    
    // Cell1 started switched on with default power level
    f_UTRAN34_SS_CreateCellDCH(utran34_CellA);
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_CellA);
    
    f_UTRAN34_Preamble(utran34_CellA);  //@sic R5s150615 add. change sic@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE); //@sic R5s150895 sic@
    
    // Initial condition: The UE is switched off with a valid USIM inserted
    f_UTRAN_TestBody_Set(true);
    
    fl_TC_12_2_1_14_Body ();
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell
    f_UTRAN34_Postamble(utran34_CellA, U1_IDLE);
  }

  /*
   * @desc      test body of TC_12_2_1_14
   * @status    APPROVED (SSNITZ)
   */
  function fl_TC_12_2_1_14_Body() runs on UTRAN_PTC
  {
    var charstring v_AT_Response;
    var template (value) RRCDataReqType  v_U_GmmInformation;
    
    //@siclog "Step 1" siclog@
    //The UE is powered up or switched on and initiates an attach (see PICS).
    f_UT_SwitchOnUE(UT, false);
    
    //@siclog "Step 2-5" siclog@
    //@siclog "Step 6" siclog@
    v_U_GmmInformation := cs_U_GmmInformation(cs_NetworkName ('43'O, "NITZDeletionPLMN"),
                                              cs_NetworkName ('45'O, "NITZPLMN"));
    f_UTRAN34_GMMOnly_Attach (utran34_CellA, -, -, -, v_U_GmmInformation, px_PTMSI_2, px_PTMSI_Sig2);
    
    //@siclog "Step 7" siclog@
    // Operator Action : Verify that the names are stored and handled correctly according to Specific PICS Statements:
    // "NITZDeletionPLMN" for Full name, "NITZPLMN" for Short name
    if (pc_FullNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, LONG_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZDeletionPLMN", "Test Case 12.2.1.14, Step 7 (long name)");
    }
    if (pc_ShortNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, SHORT_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZPLMN", "Test Case 12.2.1.14, Step 7 (short name)");
    }
    
    //@siclog "Step 8-10" siclog@
    f_UTRAN34_SwitchPower_Off ( utran34_CellA, U1_IDLE, GPRS_Attached );
    
    //@siclog "Step 11" siclog@
    f_UT_SwitchOnUE(UT, false);
    
    //@siclog "Step 12-15" siclog
    f_UTRAN34_GMMOnly_Attach (utran34_CellA, -, -, -, -, -, -, false); // no PTMSI !!
    
    //@siclog "Step 16" siclog@
    // Operator Action : Verify that the names are stored and handled correctly according to Specific PICS Statements:
    // "NITZDeletionPLMN" for Full name, , "NITZPLMN" for Short name
    if (pc_FullNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, LONG_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZDeletionPLMN", "Test Case 12.2.1.14, Step 16 (long name)");
    }
    if (pc_ShortNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, SHORT_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZPLMN", "Test Case 12.2.1.14, Step 16 (short name)");
    }
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 12.2.1.15
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_12_2_1_15_UTRAN() runs on UTRAN_PTC
  { /* NITZ / GMM/ / MM and GMM Signaling */
    
    //Initialise UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    //Initial Conditions:
    /* Two cells operating in network operation mode I. */
    f_UTRAN_CellInfo_SetNMO (utran34_CellA, tsc_NMO_I);
    f_UTRAN_CellInfo_SetNMO (utran34_CellB, tsc_NMO_I);
    f_UTRAN_CellInfo_SetRAC(utran34_CellA, '01'O); //RAI-1 @sic R5s150617 change 1 sic@
    f_UTRAN_CellInfo_SetRAC(utran34_CellB, '04'O); //RAI-4 @sic R5s150617 change 1 sic@
    
    // Create CellA and send sys infos
    f_UTRAN34_SS_CreateCellDCH(utran34_CellA);
    f_UTRAN34_SendDefSysInfo(utran34_CellA);
    
    // Create CellB and send sys infos
    f_UTRAN34_SS_CreateCellDCH(utran34_CellB);
    f_UTRAN34_SendDefSysInfo(utran34_CellB);
    
    f_UTRAN34_Preamble(utran34_CellA); //@sic R5s150617 add. change sic@
    f_UTRAN34_SwitchPower_Off(utran34_CellA, U1_IDLE); //@sic R5s150895 sic@
    
    // Initial condition: The UE is switched off with a valid USIM inserted
    f_UTRAN_TestBody_Set(true);
    
    fl_TC_12_2_1_15_Body ();
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell
    f_UTRAN34_Postamble(utran34_CellB, U1_IDLE); //@sic R5s150617 change 1 sic@
  }

  /*
   * @desc      test body of TC_12_2_1_15
   * @status    APPROVED (SSNITZ)
   */
  function fl_TC_12_2_1_15_Body () runs on UTRAN_PTC
  {
    var charstring v_AT_Response;
    var charstring v_AT_CTZE_Response;
    var integer v_CurrentYear := f_NITZ_GetCurrentYear();
    var O1_Type v_CurrentYearOct := f_NITZ_CurrentYear2Oct(v_CurrentYear);
    var charstring v_CurrentYearStr := f_NITZ_CurrentYear2Str(v_CurrentYear);
    var charstring v_CurrentYearStrExt := "20" & v_CurrentYearStr;
    var template (value) RRCDataReqType  v_U_GmmInformation;
    var charstring v_Quote := oct2char ('22'O);
    var charstring v_Expression_CTZR := "*"&v_Quote&"(*)"&v_Quote&",([0-9])*"&v_Quote&"(*)"&v_Quote&"*"; // used for LTZ, DST and Time checking @sic R5s180211 sic@
    
    f_UT_AT_SubscribeTimeZoneReporting(UT); // Enable time zone reporting
    
    //@siclog "Step 1" siclog@
    //Set the cell type of cell A to the "Serving cell".
    //Set the cell type of cell B to the "Non Suitable neighbour cell".
    //The following messages are sent and shall be received on cell A.
    //The UE is powered up or switched on and initiates an attach (see PICS).
    
    f_UTRAN_SetCellPower(utran34_CellB, tsc_AttenuationNonSuitableCell); //@sic R5s150617 change 2 sic@
    f_UT_SwitchOnUE(UT, false);
    
    f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "05", "??", "??", "+1", "?"); //@sic R5s150617 add change, R5-222019 sic@
    //@siclog "Step 2" siclog@
    //@siclog "Step 3" siclog@
    // Steps missing in the prose but required, see 34.108 clause 7.2.2 Registration
    //@siclog "Step 4" siclog@
    /*
      ATTACH ACCEPT Attach result = Attach type in step 2
      Mobile identity = P-TMSI-2
      P-TMSI-2 signature
      Routing area identity = RAI-1
    */
    //@siclog "Step 5" siclog@
    //@siclog "Step 6" siclog@
    /*
      Full Name for Network, Short Name for Network and Universal Time IE are included :
      "NITZ GMM PLMN" for Full Name
      "GMM PLMN" for Short Name
      "< Current Year >/12/31 05:15:00" for Local Time
      "+ 1 hour" for Timezone
      No DST or Local Time Zone IE included
    */
    v_U_GmmInformation := cs_U_GmmInformation(cs_NetworkName ('43'O, "NITZ GMM PLMN"),
                                              cs_NetworkName ('45'O, "GMM PLMN"),
                                              -,
                                              cs_TimeZoneAndTime(v_CurrentYearOct, '21'O, '13'O, '40'O, '51'O, '00'O, '40'O)); //@sic R5s150617 change 2, R5-222019 sic@

    //@siclog "Step 7" siclog@
    f_UTRAN34_GMMOnly_Attach (utran34_CellA, -, -, -, v_U_GmmInformation, px_PTMSI_2, px_PTMSI_Sig2);
    
    //@siclog "Step 8" siclog@
    // Operator Action: Verify that the names and time are stored and handled correctly according to specific PICS Statements:
    //"NITZ GMM PLMN" for Full name, "GMM PLMN" for Short name
    //The use of the supported Fields is checked:
    //Universal Time:
    //Year: < Current Year >
    //Month:  December
    //Day: 31st
    //Hour: 5 Hours
    //Minute: 15 Minutes
    //Timezone: GMT+1
    //Local Time Zone: Not Sent
    //DST: Daylight Saving Time not in use (i.e. "winter time")
    //Check the MMI first
    v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150617 add change sic@
    if (pc_UniversalAndLocalTimeZone) {
      f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,05:[0-9]#(2):[0-9]#(2)", // TZ GMT-4, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222019 sic@
                         "Test Case 12.2.1.15, Step 8",
                         v_Expression_CTZR,
                         2);
    }
    if (pc_FullNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, LONG_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZ GMM PLMN", "Test Case 12.2.1.15, Step 8 (long name)");
    }
    if (pc_ShortNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, SHORT_NAME);
      f_AT_ResponseCheck (v_AT_Response, "GMM PLMN", "Test Case 12.2.1.15, Step 8 (short name)");
    }
   
    if (pc_CS) {
      //@siclog "Step 9" siclog@
      f_UTRAN_PageCS(utran34_CellA, terminatingConversationalCall, oct2bit(px_TMSI_Def));
      f_UTRAN34_RRC_ConnEst(utran34_CellA, terminatingConversationalCall);
      
      //@siclog "Step 10" siclog@
      U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_PagRsp(?, ?)));
      //@siclog "Steps 11-2" siclog@
      f_UTRAN_MM_Authentication();
      
      //@siclog "Step 13" siclog@
      f_UTRAN34_RRC_Security(utran34_CellA, true, cs_domain);
      
      f_UT_AT_TriggerTimezoneReport (UT, "current year", "12", "31", "06", "??", "??", "+2", "1"); //@sic R5s150617 add change, R5-222019 sic@
      //@siclog "Step 14" siclog@
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_MmInformation(cs_NetworkName ('43'O, "NITZ MM PLMN"),
                                                  cs_NetworkName ('45'O, "MM PLMN"),
                                                  cs_TimeZone('80'O),
                                                  -, -,
                                                  cs_DaylightSavingTime_tlv('01'B))));
      
      //@siclog "Step 15" siclog@
      f_UTRAN34_RRC_ConnRel(utran34_CellA, cell_Dch);
      
      //@siclog "Step 16" siclog@
      // Operator Action : Verify that the names and time are stored and handled correctly according to Specific PICS Statements:
      // "NITZ MM PLMN" for Full name, "MM PLMN" for Short name
      //  The use of the supported Fields is checked:
      // Universal Time:
      // Year: < Current Year >
      // Month:  December
      // Day: 31st
      // Hour: 6 Hours
      // Minute: 15 Minutes
      // Timezone: GMT+2
      // Local Time Zone:
      // Timezone: GMT+2 (including DST)
      // DST: Daylight Saving Time in use (i.e. "summer time")
      v_AT_CTZE_Response := f_UT_AT_CheckTimezoneReport (UT); // CTZE response expected @sic R5s150617 add change sic@
      if (pc_UniversalAndLocalTimeZone) {
        f_AT_ResponseCheck(v_AT_CTZE_Response,
                         v_CurrentYearStrExt & "/12/31,06:[0-9]#(2):[0-9]#(2)", // TZ GMT+2, dst (1 char), date and the hour, ignore mins, seconds, @sic R5-222019 sic@
                         "Test Case 12.2.1.15, Step 16",
                         v_Expression_CTZR,
                         2);
      }
      if (pc_LocalTimeZone) {
        f_AT_ResponseCheck(v_AT_CTZE_Response,
                           "\+08", // LTZ=GMT+2
                           "Test Case 12.2.1.15, Step 16",
                           v_Expression_CTZR);
      }  //@sic R5s150896 sic@
      if (pc_DaylightSavingTime) {
        f_AT_ResponseCheck(v_AT_CTZE_Response,
                           "1", // DST=in use
                           "Test Case 12.2.1.15, Step 16",
                           v_Expression_CTZR,
                           1);
      }
      if (pc_FullNameNetwork) {
        v_AT_Response := f_UT_ChkOperatorName (UT, LONG_NAME);
        f_AT_ResponseCheck (v_AT_Response, "NITZ MM PLMN", "Test Case 12.2.1.15, Step 16 (long name)");
      }
      if (pc_ShortNameNetwork) {
        v_AT_Response := f_UT_ChkOperatorName (UT, SHORT_NAME);
        f_AT_ResponseCheck (v_AT_Response, "MM PLMN", "Test Case 12.2.1.15, Step 16 (short name)");
      }
    }// if (pc_CS) - Steps 9 to 16
    
    //@siclog "Step 17" siclog@
    f_UTRAN_SetCellPower(utran34_CellA, tsc_AttenuationSuitableNeighbourCell);
    f_UTRAN_SetCellPower(utran34_CellB, tsc_AttenuationServingCell);
            
    //@siclog "Step 18" siclog@
    //@siclog "Step 19" siclog@
    //The SS starts integrity protection
    //@siclog "Step 20" siclog@
    /*
      Mobile identity = P-TMSI-1
      P-TMSI-1 signature
      Routing area identity = RAI-4
    */
    //@siclog "Step 21" siclog@
    //@siclog "Step 22" siclog@
    v_U_GmmInformation := cs_U_GmmInformation(cs_NetworkName ('43'O, "NITZ GMM PLMN"),
                                              cs_NetworkName ('45'O, "GMM PLMN"));
    //@siclog "Step 23" siclog@
    f_UTRAN_PrepareCellRRC_ConnEst(utran34_CellB, utran34_CellA); //@sic R5s150896 sic@
    f_UTRAN34_GMM_RAU (utran34_CellB, -, v_U_GmmInformation, cr_RAI(omit, ?, ?), px_PTMSI_Def, px_PTMSI_Sig2, px_PTMSI_SigDef);
    
    //@siclog "Step 24" siclog@
    // Operator Action : Verify that the names are stored and handled correctly according to Specific PICS Statements:
    // "NITZ GMM PLMN" for Full name, , "GMM PLMN" for Short name
    if (pc_FullNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, LONG_NAME);
      f_AT_ResponseCheck (v_AT_Response, "NITZ GMM PLMN", "Test Case 12.2.1.15, Step 24 (long name)");
    }
    if (pc_ShortNameNetwork) {
      v_AT_Response := f_UT_ChkOperatorName (UT, SHORT_NAME);
      f_AT_ResponseCheck (v_AT_Response, "GMM PLMN", "Test Case 12.2.1.15, Step 24 (short name)");
    }
  } //@sic R5s150896 sic@

}
