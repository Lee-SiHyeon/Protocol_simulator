  template (value) DRX_Config cs_DRX_Config_7_1_6_X(template (value) LongDrxCycleAndOffset_Type p_LongDrxCycleAndOffset,
                                                    template (omit) ShortDRX_Type p_ShortDRX := omit) :=
  { /* @status    APPROVED (LTE, LTE_A_PRO) */
    setup := {
      onDurationTimer := psf20,
      drx_InactivityTimer := psf6,
      drx_RetransmissionTimer := psf6,
      longDRX_CycleStartOffset := p_LongDrxCycleAndOffset,
      shortDRX := p_ShortDRX
