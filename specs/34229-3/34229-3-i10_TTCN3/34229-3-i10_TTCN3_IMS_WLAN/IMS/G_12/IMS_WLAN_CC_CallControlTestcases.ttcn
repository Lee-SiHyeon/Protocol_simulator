module IMS_WLAN_CC_CallControlTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_12 all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.12.1
   * @status    APPROVED (IMS)
   */
  function f_TC_G_12_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_MO_VoiceVideoCall_C21aC25a(IPCAN_MO_SpeechCall);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.12.2
   * @status    APPROVED (IMS)
   */
   
  function f_TC_G_12_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MT_VoiceCall_C11a();
   
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.12.3
   * @status    APPROVED (IMS)
   */
  function f_TC_G_12_3_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MO_VoiceVideoCall_C21aC25a(IPCAN_MO_VideoCall);
    
    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
    
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.12.4
   * @status    APPROVED (IMS)
   */
  function f_TC_G_12_4_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MT_VideoCall_C26a();

    f_IMS_CC_Postamble(IPCAN_MT_VideoCall);
  }

}
