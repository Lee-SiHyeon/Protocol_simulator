  template (value) RRCReconfiguration_v1560_IEs cs_RRCReconfiguration_v1560_IEs (template (omit) SK_Counter p_SK_Counter := omit,
                                                                                template (omit) RRCReconfiguration_v1560_IEs.mrdc_SecondaryCellGroupConfig p_Mrdc_SecondaryCellGroupConfig:= omit,
                                                                                template (omit) octetstring p_RadioBearerConfig2 := omit,
                                                                                template (omit) RRCReconfiguration_v1610_IEs p_RRCReconfiguration_v1610_IEs := omit) :=
