    pktMeasOrder := {
      msgType := '000011'B,
      pAGE_MODE := int2bit(tsc_NormalPaging, 2),
      globalTFImask := '0'B, // @sic R5s140301 sic@
      gLOBAL_TFI := p_TFI,
      mask2 := omit,
      tLLI := omit,
      pMOIndex := '000'B,
      pMOCount := '000'B,
      ncMask := '1'B,
      nCMeasParams := p_NCMeas,
      ncFreqMask := p_NCFreqMask,
      nCFreqList := p_NCFreq,
      spareBit := '0'B,
      r98Mask := '1'B,
      lsaMask := '0'B,
      lSAParams := omit,
      r99Mask := '1'B,
      enhMask := '0'B,
      eNHMeasParams := omit,
      r4Mask := '1'B,
      cCNActive := '0'B,  // This is not defined in the prose
      ccnMask := '0'B,
      cCNSupportDescr := omit,
      r5Mask := '1'B,
      grntiXMask := '0'B,
      gRNTIExtension := omit,
      iuMask := '0'B,
      iuModeNeighCellParams := omit,
      ncIuMask := '0'B,
      nCIuModeCapCellList := omit,
      gprs3GAddMeasParam2Mask := '0'B,
      rptThresMask := omit,
      fddReportThreshold := omit,
      r6Mask := '1'B,
      cCN3GActive := '0'B, // This is defined in the prose
