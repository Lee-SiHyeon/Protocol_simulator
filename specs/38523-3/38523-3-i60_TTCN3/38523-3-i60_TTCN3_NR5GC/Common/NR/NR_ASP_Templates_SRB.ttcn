module NR_ASP_Templates_SRB {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NG_NAS_MsgContainers all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_CommonDefs all;

  template (value) NR_RRC_MSG_Request_Type cs_NR_RRC_MSG_Request_DCCH(template (value) DL_DCCH_Message p_RrcPdu) := {Dcch := p_RrcPdu};   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SRB_COMMON_REQ cas_NR_RrcNasPduList_REQ(NR_CellId_Type p_NR_CellId,
                                                              NR_RadioBearerId_Type p_SRB_Id,
                                                              template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                              template (omit) NR_RRC_MSG_Request_Type p_RrcMsg := omit,
                                                              template (omit) NG_NAS_MSG_RequestList_Type p_NasMsgList := omit,
                                                              boolean p_FollowOnFlag := false,
                                                              template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit,
                                                              template (value) RlcBearerRouting_Type p_RlcBearerRouting
                                                              ) :=
  { // RRC message + (optionally) one or more piggybacked NAS messages
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-213516 sic@
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, cs_NR_RoutingInfo_RbId(p_SRB_Id), p_RlcBearerRouting, p_TimingInfo, tsc_NoCnfReq, p_FollowOnFlag, p_MacBearerRoutingCA),  /* @sic R5w190114: RlcBearerRouting, R5s190703 sic@ */
    Signalling := {
      Rrc := p_RrcMsg,
      Nas := p_NasMsgList
    }
  };

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB_RrcPdu_REQ(NR_CellId_Type p_NR_CellId,
                                                           NR_RadioBearerId_Type p_SRB_Id,
                                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                           template (value) DL_DCCH_Message p_RrcPdu,
                                                           template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                                           ) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  // @sic R5-213516 sic@
    cas_NR_RrcNasPduList_REQ(p_NR_CellId, p_SRB_Id, p_TimingInfo, cs_NR_RRC_MSG_Request_DCCH(p_RrcPdu), -, -, p_MacBearerRoutingCA, cs_RlcBearerRouting_NR(p_NR_CellId));

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB1_RrcPdu_REQ_FollowOnFlag(NR_CellId_Type p_NR_CellId,
                                                                         template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                         template (value) DL_DCCH_Message p_RrcPdu) :=
    /* @status    APPROVED (NR5GC) */
    cas_NR_RrcNasPduList_REQ(p_NR_CellId, tsc_NR_RbId_SRB1, p_TimingInfo, cs_NR_RRC_MSG_Request_DCCH(p_RrcPdu), -, true, omit, cs_RlcBearerRouting_NR(p_NR_CellId));

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB1_RrcPdu_REQ(NR_CellId_Type p_NR_CellId,
                                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                            template (value) DL_DCCH_Message p_RrcPdu,
                                                            template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, tsc_NR_RbId_SRB1, p_TimingInfo, p_RrcPdu, p_MacBearerRoutingCA);

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB3_RrcPdu_REQ(NR_CellId_Type p_NR_CellId,
                                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                            template (value) DL_DCCH_Message p_RrcPdu,
                                                            template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                                            ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    // @sic R5-213516 sic@
    cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, tsc_NR_RbId_SRB3, p_TimingInfo, p_RrcPdu, p_MacBearerRoutingCA);

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB_NasPdu_REQ(NR_CellId_Type p_NR_CellId,
                                                           NR_RadioBearerId_Type p_SRB_Id := tsc_NR_RbId_SRB2,
                                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                           template (value) NG_NAS_MSG_Request_Type p_NasPdu) :=
  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    cas_NR_RrcNasPduList_REQ(p_NR_CellId, p_SRB_Id, p_TimingInfo, -, {p_NasPdu}, -, -, cs_RlcBearerRouting_NR(p_NR_CellId));

  template (value) NR_SRB_COMMON_REQ cas_NR_SRB0_RrcPdu_REQ(NR_CellId_Type p_NR_CellId,
                                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                            template (value) DL_CCCH_Message p_RrcPdu) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, cs_NR_RoutingInfo_RbId(tsc_NR_RbId_SRB0), cs_RlcBearerRouting_NR(p_NR_CellId), p_TimingInfo, tsc_NoCnfReq),  /* @sic R5w190114: RlcBearerRouting, R5s200676 sic@ */
    Signalling := {
      Rrc := {
        Ccch := p_RrcPdu
      },
      Nas := omit
    }
  };

  template (present) NR_RRC_MSG_Indication_Type cr_NR_RRC_MSG_Indication_DCCH(template (present) UL_DCCH_Message p_RrcPdu) := {Dcch := p_RrcPdu}; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (present) NR_SRB_COMMON_IND car_NR_SRB_Common_IND(NR_CellId_Type p_NR_CellId,
                                                             template (present) NR_RadioBearerId_Type p_SRB_Id,
                                                             template NR_RRC_MSG_Indication_Type p_RrcMsg := omit,
                                                             template NG_NAS_MSG_IndicationList_Type p_NasMsgList := omit,
                                                             template (omit) NR_RoutingInfoSUL_Type p_RoutingInfoSUL := omit,
                                                             template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit,
                                                             template(present) RlcBearerRouting_Type p_RlcBearerRouting
                                                             ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-213516 sic@
    Common := cr_NR_IndAspCommonPart(p_NR_CellId, cr_NR_RoutingInfo_RbId(p_SRB_Id), p_RlcBearerRouting, -, p_RoutingInfoSUL, p_MacBearerRoutingCA),
    Signalling := {
      Rrc := p_RrcMsg,
      Nas := p_NasMsgList
    }
  };

  template (present) NR_SRB_COMMON_IND car_NR_SRB_RrcPdu_IND(NR_CellId_Type p_NR_CellId,
                                                             NR_RadioBearerId_Type p_SRB_Id,
                                                             template (present) UL_DCCH_Message p_RrcPdu,
                                                             template (omit) NR_RoutingInfoSUL_Type p_RoutingInfoSUL := omit,
                                                             template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  // @sic R5-213516 sic@
    car_NR_SRB_Common_IND(p_NR_CellId, p_SRB_Id, cr_NR_RRC_MSG_Indication_DCCH(p_RrcPdu), -, p_RoutingInfoSUL, p_MacBearerRoutingCA, cr_RlcBearerRouting_NR(p_NR_CellId));

  template (present) NR_SRB_COMMON_IND car_NR_SRB1_RrcPdu_IND(NR_CellId_Type p_NR_CellId,
                                                              template (present) UL_DCCH_Message p_RrcPdu,
                                                              template (omit) NR_RoutingInfoSUL_Type p_RoutingInfoSUL := omit,
                                                              template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  // @sic R5-213516 sic@
    car_NR_SRB_RrcPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB1, p_RrcPdu, p_RoutingInfoSUL, p_MacBearerRoutingCA);

  template (present) NR_SRB_COMMON_IND car_NR_SRB_RrcPduSplit_IND(NR_CellId_Type p_NR_CellId,
                                                                  template (present) NR_RadioBearerId_Type p_SRB_Id := tsc_NR_RbId_SRB1,
                                                                  template (present) UL_DCCH_Message p_RrcPdu,
                                                                  template(present) RlcBearerRouting_Type p_RlcBearerRouting
                                                                   ) :=
   //Template to be used in NR-DC SRB split with the p_RlcBearerRouting parameter
   /* @status    APPROVED (NR5GC) */
    car_NR_SRB_Common_IND( p_NR_CellId, p_SRB_Id, cr_NR_RRC_MSG_Indication_DCCH(p_RrcPdu), -, -, -, p_RlcBearerRouting);

  template (present) NR_SRB_COMMON_IND car_NR_SRB3_RrcPdu_IND(NR_CellId_Type p_NR_CellId,
                                                              template (present) UL_DCCH_Message p_RrcPdu,
                                                              template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
    /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-213516 sic@
    car_NR_SRB_RrcPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB3, p_RrcPdu, -, p_MacBearerRoutingCA);

  template (present) NR_SRB_COMMON_IND car_NR_SRB_NasPdu_IND(NR_CellId_Type p_NR_CellId,
                                                             template (present) NR_RadioBearerId_Type p_SRB_Id,
                                                             template (present) NG_NAS_MSG_Indication_Type p_NasPdu,
                                                             template (omit) NR_RoutingInfoSUL_Type p_RoutingInfoSUL := omit) :=
  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    car_NR_SRB_Common_IND(p_NR_CellId, p_SRB_Id, -, {p_NasPdu}, p_RoutingInfoSUL, - , cr_RlcBearerRouting_NR(p_NR_CellId));

  template (present) NR_SRB_COMMON_IND car_NR_SRB1_RrcNasPdu_IND(NR_CellId_Type p_NR_CellId,
                                                                 template (present) UL_DCCH_Message p_RrcPdu,
                                                                 template (present) NG_NAS_MSG_Indication_Type p_NasPdu,
                                                                 template (omit) NR_RoutingInfoSUL_Type p_RoutingInfoSUL := omit) :=
  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    car_NR_SRB_Common_IND(p_NR_CellId, tsc_NR_RbId_SRB1, cr_NR_RRC_MSG_Indication_DCCH(p_RrcPdu), {p_NasPdu}, p_RoutingInfoSUL, -, cr_RlcBearerRouting_NR(p_NR_CellId));

  template (present) NR_SRB_COMMON_IND car_NR_SRB0_RrcPdu_IND(template (present) NR_CellId_Type p_NR_CellId,
                                                              template (present) UL_CCCH_Message p_RrcPdu,
                                                              template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-213516 sic@
    Common := cr_NR_IndAspCommonPart(p_NR_CellId, cr_NR_RoutingInfo_RbId(tsc_NR_RbId_SRB0), cr_RlcBearerRouting_NR(p_NR_CellId), -, -, p_MacBearerRoutingCA),
    Signalling := {
      Rrc := {
        Ccch := p_RrcPdu
      },
      Nas := omit
    }
  };

  template (present) NR_SRB_COMMON_IND car_NR_SRB0_RrcPdu_IND_AnyCell(template (present) UL_CCCH_Message p_RrcPdu) := car_NR_SRB0_RrcPdu_IND(?, p_RrcPdu);  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  template (present) NR_SRB_COMMON_IND car_NR_SRB_IND_Any :=
  { /* @status    APPROVED (NR5GC) */
    Common := cr_NR_IndAspCommonPart(?, ?, ?),
    Signalling := ?
  };

  template (present) NR_SRB_COMMON_IND car_NR_SRB0_RrcPdu_IND1(template (present) NR_CellId_Type p_NR_CellId,
                                                              template (present) UL_CCCH1_Message p_RrcPdu) :=
  { /* @status    APPROVED (NR5GC) */
    Common := cr_NR_IndAspCommonPart(p_NR_CellId, cr_NR_RoutingInfo_RbId(tsc_NR_RbId_SRB0), cr_RlcBearerRouting_NR(p_NR_CellId)),
    Signalling := {
      Rrc := {
        Ccch1 := p_RrcPdu
      },
      Nas := omit
    }
  };

}
