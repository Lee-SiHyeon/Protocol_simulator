module UTRAN34_MDT_SpecificTemplates {

  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from CommonDefs all;
  import from UTRAN_ANR_MDT_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_Templates all;

  type LoggedMeasReport.loggedMeasAvailable      LoggedMeasReport_LoggedMeasAvailable_Type;    /* @status    APPROVED (UTRAN) */

  type LoggedMeasurementsConfigurationInfo.loggingDuration      LoggedMeasurementsConfigurationInfo_LoggingDuration_Type;                            /* @status    APPROVED (UTRAN) */

  type LoggedMeasurementsConfigurationInfo.loggingInterval      LoggedMeasurementsConfigurationInfo_LoggingInterval_Type;                            /* @status    APPROVED (UTRAN) */

  type LoggedMeasurementsConfigurationInfo.areaConfiguration    LoggedMeasurementsConfigurationInfo_AreaConfiguration_Type;                          /* @status    APPROVED (UTRAN) */

  template(present) LoggedMeasReport cr_LoggedMeasReport(B48_Type p_AbsoluteTimeInfo,
                                                           PLMN_Identity p_PLMN_Identity,
                                                           O3_Type p_TraceId,
                                                           template(present) TraceRecordingSession p_TraceRecordingSession,
                                                           template(present) TCE_Id p_Tce_Id,
                                                           template LoggedMeasInfoList p_LoggedMeasInfoList,
                                                           template LoggedMeasReport_LoggedMeasAvailable_Type p_LoggedMeasAvailable := *) :=
  { /* @status    APPROVED (UTRAN) */
    absoluteTimeInfo := p_AbsoluteTimeInfo,
    traceReference := {                        //@sic R5-131421, R5-131422, R5-131423, R5-131766, R5-131426 sic@
      plmn_Identity   := p_PLMN_Identity,
      traceId         := p_TraceId
    },
    traceRecordingSession := p_TraceRecordingSession,
    tce_Id                := p_Tce_Id,
    loggedMeasInfoList    := p_LoggedMeasInfoList,
    loggedMeasAvailable   := p_LoggedMeasAvailable
  };

  template(present) UL_DCCH_Message cr_UEInformationResponse_LoggedMeasReportDef(B48_Type p_AbsoluteTimeInfo,
                                                                                  PLMN_Identity p_PLMN_Identity,
                                                                                  template LoggedMeasInfoList p_LoggedMeasInfoList,
                                                                                  template UEInformationResponse_vb50NonCriticalExtensions_Type p_LoggedMeasInfoList_vb50ext := *) :=  //@sic R5s160378 sic@
  /* @status    APPROVED (UTRAN) */
    cr_UEInformationResponse(?,
                             tsc_RRC_TI,
                             cr_LoggedMeasReport(p_AbsoluteTimeInfo, p_PLMN_Identity, '0000EF'O, cs_TraceRecordingSession('001A'O), cs_TCE_Id('05'O), p_LoggedMeasInfoList),
                             omit,
                             p_LoggedMeasInfoList_vb50ext);

  template (value) TraceRecordingSession cs_TraceRecordingSession(O2_Type p_TraceRecordingSession) :=
  { /* @status    APPROVED (UTRAN) */
    traceRecordingSession := p_TraceRecordingSession
  };

  template (value) TCE_Id cs_TCE_Id(O1_Type p_TCE_Id) :=
  { /* @status    APPROVED (UTRAN) */
    tce_Id := p_TCE_Id
  };

  template(present) LoggedMeasInfoList cr_LogMeasInfoList_FDD(template LoggedMeasInfoList_FDD p_LoggedMeasInfoList) :=
  { /* @status    APPROVED (UTRAN) */
    modeSpecificInfo := {
      fdd :={
        loggedMeasInfoList := p_LoggedMeasInfoList
      }
    }
  };

  template(present) LoggedMeasInfoList cr_LogMeasInfoList_TDD128(template LoggedMeasInfoList_TDD128 p_LoggedMeasInfoList) :=
  { /* @status    APPROVED (UTRAN) */
    modeSpecificInfo := {
      tdd := {
        loggedMeasInfoList := p_LoggedMeasInfoList
      }
    }
  };

  template(present) LoggedMeasInfo_TDD128 cr_LogMeasInfo_TDD128(template integer p_Timestamp := ?,
                                                                 template LoggedMeasServingCellMeas_TDD128               p_LoggedMeasServingCellMeas,
                                                                 template LoggedMeasIntrafreqNeighbourMeasList_TDD128    p_LoggedMeasIntrafreqNeighbourList := omit,
                                                                 template LoggedMeasInterfreqList_TDD128                 p_LoggedMeasInterfreqList := omit,
                                                                 template LoggedMeasInterRATNeighbourMeas                p_LoggedMeasInterRATNeighbourMeas := omit,
                                                                 template LoggedMeasLocationInfo                         p_LoggedMeasLocationInfo := omit) :=
  { /* @status    APPROVED (UTRAN) */
    relativeTimeStamp                       := p_Timestamp,
    loggedMeasServingCellMeas               := p_LoggedMeasServingCellMeas,
    loggedMeasIntrafreqNeighbourList        := p_LoggedMeasIntrafreqNeighbourList,
    loggedMeasInterfreqList                 := p_LoggedMeasInterfreqList,
    loggedMeasInterRATNeighbourMeas         := p_LoggedMeasInterRATNeighbourMeas,
    loggedMeasLocationInfo                  := p_LoggedMeasLocationInfo
  };

  template(present) LoggedMeasInfo_FDD cr_LogMeasInfo_FDD(template integer p_Timestamp := ?,
                                                           template LoggedMeasServingCellMeas_FDD          p_LoggedMeasServingCellMeas,
                                                           template LoggedMeasIntrafreqNeighbourList_FDD   p_LoggedMeasIntrafreqNeighbourList := omit,
                                                           template LoggedMeasInterfreqList_FDD            p_LoggedMeasInterfreqList := omit,
                                                           template LoggedMeasInterRATNeighbourMeas        p_LoggedMeasInterRATNeighbourMeas := omit,
                                                           template LoggedMeasLocationInfo                 p_LoggedMeasLocationInfo := omit) :=
  { /* @status    APPROVED (UTRAN) */
    relativeTimeStamp                       := p_Timestamp,
    loggedMeasServingCellMeas               := p_LoggedMeasServingCellMeas,
    loggedMeasIntrafreqNeighbourList        := p_LoggedMeasIntrafreqNeighbourList,
    loggedMeasInterfreqList                 := p_LoggedMeasInterfreqList,
    loggedMeasInterRATNeighbourMeas         := p_LoggedMeasInterRATNeighbourMeas,
    loggedMeasLocationInfo                  := p_LoggedMeasLocationInfo
  };

  template(present) LoggedMeasServingCellMeas_FDD cr_LoggedMeasServingCellMeas_FDD(template CellIdentity p_CellIdentity,
                                                                                    template CPICH_RSCP  p_CPICH_RSCP := (0..91),
                                                                                    template CPICH_Ec_N0 p_CPICH_Ec_N0 :=(0..49)) :=
  { /* @status    APPROVED (UTRAN) */
    cellIdentity    := p_CellIdentity,
    cpich_RSCP      := p_CPICH_RSCP,
    cpich_Ec_N0     := p_CPICH_Ec_N0
  };

  template(present) LoggedMeasServingCellMeas_TDD128 cr_LoggedMeasServingCellMeas_TDD128(template CellIdentity p_CellIdentity,
                                                                                          template PrimaryCCPCH_RSCP    p_PrimaryCCPCH_RSCP := (0..91)) :=
  { /* @status    APPROVED (UTRAN) */
    cellIdentity            := p_CellIdentity,
    primaryCCPCH_RSCP       := p_PrimaryCCPCH_RSCP
  };

  template(present) LoggedMeasIntrafreqNeighbourList_FDD cr_LoggedMeasNeighbourInfoList_FDD(template PrimaryCPICH_Info p_PrimaryCPICH_Info,
                                                                                             template CPICH_RSCP   p_CPICH_RSCP := (0..91),
                                                                                             template CPICH_Ec_N0 p_CPICH_Ec_N0 := (0..49)) :=
  { /* @status    APPROVED (UTRAN) */
    {
      primaryCPICH_Info   := p_PrimaryCPICH_Info,
      cpich_RSCP          := p_CPICH_RSCP,
      cpich_Ec_N0         := p_CPICH_Ec_N0
    }
  };

  template(present) LoggedMeasIntrafreqNeighbourMeasList_TDD128 cr_LoggedMeasNeighbourMeasList_TDD128(CellParametersID p_CellParametersID,
                                                                                                       template PrimaryCCPCH_RSCP p_PrimaryCCPCH_RSCP := (0..91)) :=
  { /* @status    APPROVED (UTRAN) */
    {
      cellParametersID    := p_CellParametersID,
      primaryCCPCH_RSCP   := p_PrimaryCCPCH_RSCP
    }
  };

  template(present) PrimaryCPICH_Info cr_PrimaryCPICH_Info(PrimaryScramblingCode p_ScrmbCode) :=
  { /* @status    APPROVED (UTRAN) */
    primaryScramblingCode := p_ScrmbCode
  };

 template (value) DL_DCCH_Message cs_LoggingMeasurementConfiguration(IntegrityCheckInfo p_IntegrityCheckInfo,
                                                                      RRC_TransactionIdentifier p_RRC_TI,
                                                                      PLMN_Identity p_PLMN_Identity,
                                                                      O3_Type p_TraceId,
                                                                      template (value) TraceRecordingSession p_TraceRecordingSession,
                                                                      template (value) TCE_Id p_Tce_Id,
                                                                      B48_Type p_AbsoluteTimeInfo,
                                                                      template (omit) LoggedMeasurementsConfigurationInfo_AreaConfiguration_Type p_AreaConfiguration := omit,
                                                                      LoggedMeasurementsConfigurationInfo_LoggingDuration_Type p_LoggingDuration := min10,
                                                                      LoggedMeasurementsConfigurationInfo_LoggingInterval_Type p_LoggingInterval := li256) :=     //@sic R5-131422, R5-131423, R5-131766, R5-131426 sic@//
  { /* @status    APPROVED (LTE_A_IRAT, UTRAN) */
    integrityCheckInfo := p_IntegrityCheckInfo,
    message_ := {
      loggingMeasurementConfiguration := {
        rrc_TransactionIdentifier := p_RRC_TI,
        criticalExtensions := {
          r10 := {
            loggingMeasurementConfiguration_r10_IEs := {
              loggedMeasurementsConfigurationInfo := {        //@sic R5-131421, R5-131422, R5-131423, R5-131766, R5-131426 sic@
                absoluteTimeInfo := p_AbsoluteTimeInfo,
                loggingDuration     := p_LoggingDuration,
                loggingInterval     := p_LoggingInterval,
                traceReference      := {
                  plmn_Identity   := p_PLMN_Identity,
                  traceId         := p_TraceId
                },
                traceRecordingSession := p_TraceRecordingSession,
                tce_Id                := p_Tce_Id,
                areaConfiguration     := p_AreaConfiguration
              },
              loggedANRConfigurationInfo := omit
            },
            loggingMeasurementConfiguration_r10_add_ext := omit,
            nonCriticalExtensions         := omit
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_LoggingMeasurementConfigurationDef(IntegrityCheckInfo p_IntegrityCheckInfo,
                                                                         PLMN_Identity p_PLMN_Identity,
                                                                         B48_Type p_AbsoluteTimeInfo,
                                                                         template (omit) LoggedMeasurementsConfigurationInfo_AreaConfiguration_Type p_AreaConfiguration := omit) :=
  /* @status    APPROVED (UTRAN) */
    cs_LoggingMeasurementConfiguration(p_IntegrityCheckInfo, tsc_RRC_TI, p_PLMN_Identity, '0000EF'O, cs_TraceRecordingSession('001A'O), cs_TCE_Id('05'O), p_AbsoluteTimeInfo, p_AreaConfiguration);

  template(present) FrequencyInfo cr_FreqInfo_ULDL_FDD(UARFCN p_UarfcnDL) :=
  { /* @status    APPROVED (UTRAN) */
    modeSpecificInfo := {
      fdd := {
        uarfcn_UL := *,  //@sic R5s160729 sic@
        uarfcn_DL := p_UarfcnDL
      }
    }
  };

  template(present) LoggedMeasInterfreqInfo_FDD cr_LoggedMeasInterfreqInfo_FDD(UARFCN p_UARFCN_DL,
                                                                                template(present) PrimaryCPICH_Info p_PrimaryCPICH_Info,
                                                                                template(present) CPICH_RSCP p_CPICH_RSCP := ?,
                                                                                template(present) CPICH_Ec_N0 p_CPICH_Ec_N0 := ?) :=
  { /* @status    APPROVED (UTRAN) */
    frequencyInfo := cr_FreqInfo_ULDL_FDD(p_UARFCN_DL),  //@sic R5s160729 sic@
    loggedMeasInterfreqNeighbourList := {
      {
        primaryCPICH_Info   := p_PrimaryCPICH_Info,
        cpich_RSCP          := p_CPICH_RSCP,
        cpich_Ec_N0         := p_CPICH_Ec_N0
      }
    }
  };

  template(present) LoggedMeasInterfreqInfo_TDD128  cr_LoggedMeasInterfreqInfo_TDD128(UARFCN p_UarfcnNt,
                                                                                       CellParametersID p_CellParametersID,
                                                                                       template(present) PrimaryCCPCH_RSCP p_PrimaryCCPCH_RSCP := ?) :=
  { /* @status    APPROVED (UTRAN) */
    frequencyInfo := cs_FreqInfo_TDD(p_UarfcnNt),
    loggedMeasInterfreqNeighbourList := {
      {
        cellParametersID    := p_CellParametersID,
        primaryCCPCH_RSCP   := p_PrimaryCCPCH_RSCP
      }
    }
  };

}
