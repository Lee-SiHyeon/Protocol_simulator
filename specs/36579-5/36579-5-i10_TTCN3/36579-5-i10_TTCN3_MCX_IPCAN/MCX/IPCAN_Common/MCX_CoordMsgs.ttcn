module MCX_CoordMsgs {

  import from CommonDefs all;
  import from MCX_SecurityParameters all;

  type enumerated MCX_TriggerEvent_Type { ANY, CMS, GMS };      /* @status    APPROVED (MCX) */

  type record MCData_FileDistributionInfo_Type {      /* @status    APPROVED (MCX) */
    charstring TestFile,
    octetstring FileContent optional
  };

  type union MCX_Coordination_MSG {     /* @status    APPROVED (MCX) */
    MCX_TriggerEvent_Type       TriggerEvent,
    MCX_SecurityParameters_Type SecurityParameters,
    IP_DrbInfo_Type             DrbInfo,
    MCData_FileDistributionInfo_Type FileDistributionInfo
  };

  type port MCX_CO_ORD_PORT message {   /* @status    APPROVED (MCX) */
    out MCX_Coordination_MSG;
    in  MCX_Coordination_MSG;
  };

  template (value) MCX_Coordination_MSG cms_MCX_Trigger(MCX_TriggerEvent_Type p_TriggerEvent := ANY) :=
  { /* @status    APPROVED (MCX) */
    TriggerEvent := p_TriggerEvent
  };

  template (present) MCX_Coordination_MSG cmr_MCX_Trigger(template (present) MCX_TriggerEvent_Type p_TriggerEvent := ?) :=
  { /* @status    APPROVED (MCX) */
    TriggerEvent := p_TriggerEvent
  };

  template (value) MCX_Coordination_MSG cms_MCX_SecurityParameters(MCX_SecurityParameters_Type p_SecurityParameters) :=
  { /* @status    APPROVED (MCX) */
    SecurityParameters := p_SecurityParameters
  };

  template (present) MCX_Coordination_MSG cmr_MCX_SecurityParameters :=
  { /* @status    APPROVED (MCX) */
    SecurityParameters := ?
  };

  template (value) MCX_Coordination_MSG cms_MCX_DrbInfo(IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (MCX) */
    DrbInfo := p_DrbInfo
  };

  template (present) MCX_Coordination_MSG cmr_MCX_DrbInfo :=
  { /* @status    APPROVED (MCX) */
    DrbInfo := ?
  };

  /*
   * @desc      Wait for coordination message from other PTC over sync port
   * @param     p_Port
   * @param     p_Msg
   * @param     p_CoordMsgByRef     (by reference)
   * @status    APPROVED (MCX)
   */
  altstep a_MCX_WaitForCoOrdMsg(MCX_CO_ORD_PORT p_Port,
                                template  MCX_Coordination_MSG p_Msg,
                                out MCX_Coordination_MSG p_CoordMsgByRef)
  {
    var MCX_Coordination_MSG v_CoordMsg;
    [] p_Port.receive(p_Msg) -> value v_CoordMsg {
      p_CoordMsgByRef := v_CoordMsg;
    }
  }

  /*
   * @desc      Wrapper function
   * @param     p_Port
   * @param     p_Msg               (default value: cmr_MCX_Trigger)
   * @return    MCX_Coordination_MSG
   * @status    APPROVED (MCX)
   */
  function f_MCX_WaitForCoOrdMsg(MCX_CO_ORD_PORT p_Port,
                                 template  MCX_Coordination_MSG p_Msg := cmr_MCX_Trigger) return MCX_Coordination_MSG
  {
    var MCX_Coordination_MSG v_CoordMsgByRef;
    a_MCX_WaitForCoOrdMsg(p_Port, p_Msg, v_CoordMsgByRef);
    return v_CoordMsgByRef;
  }

  /*
   * @desc      Wait for trigger from other PTC over sync port
   * @param     p_Port
   * @status    APPROVED (MCX)
   */
  function f_MCX_WaitForTrigger(MCX_CO_ORD_PORT p_Port)
  {
    f_MCX_WaitForCoOrdMsg(p_Port);
  }

  /*
   * @desc      Send coordination message to other PTC over sync port
   * @param     p_Port
   * @param     p_Msg
   * @status    APPROVED (MCX)
   */
  function f_MCX_SendCoOrdMsg(MCX_CO_ORD_PORT p_Port,
                              template (value) MCX_Coordination_MSG p_Msg)
  {
    p_Port.send(p_Msg);
  }

  /*
   * @desc      Send trigger to other PTC over sync port
   * @param     p_Port
   * @param     p_TriggerEvent      (default value: ANY)
   * @status    APPROVED (MCX)
   */
  function f_MCX_SendTrigger(MCX_CO_ORD_PORT p_Port,
                             MCX_TriggerEvent_Type p_TriggerEvent := ANY)
  {
    f_MCX_SendCoOrdMsg(p_Port, cms_MCX_Trigger(p_TriggerEvent))
  }

}
