module UTRAN34_4C_ASN1_ASP_Templates {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_RRC_CommonTemplates_r10 all;
  import from UTRAN_ASN1_ASP_RAB_Templates all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_RAB_Templates all;

  template (value) HS_DPCCHInfo_r10 cs_HS_DPCCHInfo_r10_3C :=
  { /* @status    APPROVED (UTRAN) */
    cqi_RepetitionFactor := 1,
    ackNackRepetitionFactor := 1,
    mimoStatus := false,
    firstSecondaryServing_HS_DSCH_Cell := activated,
    secondSecondaryServing_HS_DSCH_Cell := activated,
    thirdSecondaryServing_HS_DSCH_Cell := deactivated
  };

  template (value) DL_DPCHInfo_r10_FDD cs_F_DPCH_Info_FDD_r10(integer p_F_DPCH_ChannelisationCode) :=
  { /* @status    APPROVED (UTRAN) */
    dl_CommonInformation := cs_DL_CommonInformationF_DPCH_FDD_r10,
    dl_Dpch_InfoPerRL := {
      dl_FDPCH_InfoPerRL := cs_DL_DPCH_InfoPerRL_FDPCH_FDD(-, p_F_DPCH_ChannelisationCode)
    },
    rl_Information := cs_RL_InfoDef_FDD
  };

  template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 cs_SS_MAC_ehs_AddReconfReordQueue_2Q(MAC_ehs_QueueId p_QID1,
                                                                                              integer  p_QueuePriority1,
                                                                                              MAC_ehs_QueueId p_QID2,
                                                                                              integer  p_QueuePriority2) :=
  { /* @status    APPROVED (UTRAN) */
    cs_SS_MAC_ehs_AddReconfReordQ_r9(p_QID1, p_QueuePriority1),
    cs_SS_MAC_ehs_AddReconfReordQ_r9(p_QID2, p_QueuePriority2)
  };

  template (value) CmacConfigReq_r10OrLaterExtensionType cs_ServingSecondaryCells_3C(UTRAN_CellId_Type  p_CellId,
                                                                                     UTRAN_CellId_Type  p_FirstSecCellId,
                                                                                     UTRAN_CellId_Type  p_SecondSecCellId )  :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt :=  {
      servingSecondaryCells  := {
        servingCellId := f_UtranCellId2Int(p_CellId),
        secondaryCellActivationList := {
          cs_SecondaryCellActivated(p_FirstSecCellId),
          cs_SecondaryCellActivated(p_SecondSecCellId)
        }
      }
    }
  };

  template (value) CmacConfigReq_r10OrLaterExtensionType cs_ServingSecondaryCells_4C(UTRAN_CellId_Type  p_CellId,
                                                                                     UTRAN_CellId_Type  p_FirstSecCellId,
                                                                                     UTRAN_CellId_Type  p_SecondSecCellId,
                                                                                     UTRAN_CellId_Type  p_ThirdSecCellId)  :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt := {
      servingSecondaryCells := {
        servingCellId := f_UtranCellId2Int(p_CellId),
        secondaryCellActivationList := {
          cs_SecondaryCellActivated(p_FirstSecCellId),
          cs_SecondaryCellActivated(p_SecondSecCellId),
          cs_SecondaryCellActivated(p_ThirdSecCellId)
        }
      }
    }
  };

  template (value) SecondaryCellActivation_Type cs_SecondaryCellActivated (UTRAN_CellId_Type  p_CellId) :=
  { /* @status    APPROVED (UTRAN) */
    secondaryCellId    := f_UtranCellId2Int(p_CellId),
    secondaryServingStatus := activated
  };

  template (value) TFRCconfigure_r10OrLaterExtensionType cs_TFRCconfigure4C_Explicit(template (value) TFRC_Explicit_Type p_Serving_TFRC,
                                                                                     template (value) TFRC_Explicit_Type p_FirstSecondary_TFRC,
                                                                                     template (value) TFRC_Explicit_Type p_SecondSecondary_TFRC,
                                                                                     template (omit) TFRC_Explicit_Type p_ThirdSecondary_TFRC) :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt := {
      explicitlyConfigured_4C := {
        serving_TFRC            := p_Serving_TFRC,
        firstSecondary_TFRC     := p_FirstSecondary_TFRC,
        secondSecondary_TFRC    := p_SecondSecondary_TFRC,
        thirdSecondary_TFRC     := p_ThirdSecondary_TFRC
      }
    }
  };

  template (value) U_CRLC_CONFIG_REQ cas_RB25_AM_InfoFlexible_FDD(UTRAN_CellId_Type p_CellId := utran_CellDedicated,
                                                                  template (value)  SS_ActivationTime p_ActTime,
                                                                  integer           p_RB_Id := tsc_RB25,
                                                                  template (value)  DL_AM_RLC_Mode_r7 p_DL_AM_RLC_Mode,
                                                                  template (value)  UL_AM_RLC_Mode  p_UL_AM_RLC_Mode,
                                                                  template (value)  RB_LogCH_Mapping p_LogChMapping := cs_RB25_LogChMapping) :=
  /* @status    APPROVED (UTRAN) */
    cas_RB_AM_Info_Common_FDD(p_CellId, p_RB_Id, p_DL_AM_RLC_Mode, cs_SS_DL_RLC_Mode_RB25_Flexible(p_UL_AM_RLC_Mode), p_LogChMapping, true_, p_ActTime);

}
