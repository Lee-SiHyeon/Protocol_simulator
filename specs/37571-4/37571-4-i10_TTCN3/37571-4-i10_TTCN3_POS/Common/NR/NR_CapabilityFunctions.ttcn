  /*
   * @desc      Function that returns whether a given value is found on supportedBandList array of frequencies
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC, POS)
   */
  function fl_NR_FindEntries_FreqBandIndicatorNR(FreqBandIndicatorNR p_BandNR) return boolean
  {
    var boolean v_Found := false;
    var integer i:=0;

      while (i < lengthof(tsc_SupportedBandListNR) and (v_Found == false)) {
         if (tsc_SupportedBandListNR[i] == p_BandNR){
           v_Found := true;
           break;
         }
         else {
           i:=i+1;
         }
      }

    return v_Found;
  };

  /*
   * @desc      Function checking whether the band is defined as its corresponding HD-FDD NR Bands PICS
   * @param     p_Band
   * @status    APPROVED (ENDC, NR5GC, POS)
   */
    function fl_CheckNRBandCapability(integer p_Band)
    {
      if (fl_NR_FindEntries_FreqBandIndicatorNR(p_Band)) {
         //UE reported a known FreqBandIndicatorNR, now check whether it is set on PICS pc_nrBandX_Supp accordingly
          if (not f_NR_ContentOf_pc_nrBandX(p_Band)) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "pc_nrBand" & int2str(p_Band) & "_Supp not set accordingly"); // @sic R5s200277 sic@
          }
      } // end of checks for IE bandNR
    
    }

  /*
   * @desc      To decode the NR UE-CapabilityRAT-Container
   * @param     p_Octetstring
   * @return    UE_NR_Capability
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DecodeNrCapMsg(octetstring p_Octetstring) return UE_NR_Capability
  {
    var UE_NR_Capability v_Ue_Nr_Capability;
    var bitstring v_Bitstring := oct2bit(p_Octetstring);
    var integer v_Result := decvalue(v_Bitstring, v_Ue_Nr_Capability);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "UE NR Capability cannot be decoded");
    }
    return v_Ue_Nr_Capability;
  }

  /*
   * @desc      To decode the NR UE-CapabilityRAT-Container to UE-MRDC-Capability
   * @param     p_Octetstring
   * @return    UE_MRDC_Capability
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DecodeNrCapMsg_MRDC(octetstring p_Octetstring) return UE_MRDC_Capability
  {
    var UE_MRDC_Capability v_UE_MRDC_Capability;
    var bitstring v_Bitstring := oct2bit(p_Octetstring);
    var integer v_Result := decvalue(v_Bitstring, v_UE_MRDC_Capability);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "UE NR Capability cannot be decoded");
    }
    return v_UE_MRDC_Capability;
  }

}
