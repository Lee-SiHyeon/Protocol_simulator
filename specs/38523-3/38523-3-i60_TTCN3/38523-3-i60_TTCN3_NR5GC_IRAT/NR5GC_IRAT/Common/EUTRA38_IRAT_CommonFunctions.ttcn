  /*
   * @desc      Assign SIB24 in all EUTRA cell
   * @param     p_SIB24
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_CellInfo_SetSIB24_FreqListAllCells ( template (value) SystemInformationBlockType24_r15 p_SIB24 ) runs on EUTRA_PTC
  {
    //Acc to 38.508-1 cl 6.3.1.3
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell1, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell2, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell3, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell4, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell6, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell10, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell11, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell12, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell13, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell14, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell23, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell28, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell29, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell30, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_Cell31, p_SIB24);
  }

  /*
   * @desc      Assign SIB24 in all EUTRA cell
   * @param     p_SIB24
   * @param     p_CellsOnSamePLMN
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_CellInfo_SetSIB24_FreqListAllNASCells ( template (value) SystemInformationBlockType24_r15 p_SIB24,
                                                          EUTRA_NAS_NumOfPLMN_Type p_CellsOnSamePLMN  ) runs on EUTRA_PTC
  {
    f_EUTRA_CellInfo_SetSIB24(eutra_CellA, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_CellB, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_CellC, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_CellD, p_SIB24);
    f_EUTRA_CellInfo_SetSIB24(eutra_CellM, p_SIB24);
    
    if (p_CellsOnSamePLMN == LTE_CellsOnDifferentPLMN) {
      f_EUTRA_CellInfo_SetSIB24(eutra_CellE, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellG, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellH, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellI, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellJ, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellK, p_SIB24);
      f_EUTRA_CellInfo_SetSIB24(eutra_CellL, p_SIB24);
    }
  }

  /*
   * @desc      INIT function for NR5GC I-RAT test cases
   * @param     p_SysinfoCombination
   * @param     p_HandleULDataUM    (default value: omit)
   * @param     p_UseBigGrants      (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
   function f_EUTRA38_IRAT_Init( Combination_Type p_SysinfoCombination,
                                template (omit) EUTRA_HandleUlDataUM_Type p_HandleULDataUM := omit,
                                template (omit) EUTRA_UseBigGrants_Type p_UseBigGrants := omit) runs on EUTRA_Multi5GS_PTC
  {
    f_EUTRA38_NR_Config_Set (NR_SA);
    if (f_EUTRA38_NR_IsFR1(px_NR_PrimaryBand)){
        f_EUTRA38_NR_IsFR1_Set(true);
    } else {
        f_EUTRA38_NR_IsFR1_Set(false);
    }
    // Set test environment depending on NR bands under test
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    // test case using 1 NR bands
    f_EUTRA38_NR_InitTestEnvironmnent(px_NR_PrimaryBand, omit);
    f_EUTRA38_Security_Init();
    f_EUTRA38_MobileInfo_Init(); // @sic R5s201354 sic@
    f_EUTRA38_SetNetworkSupport(NOT_SUPPORTED); // Set this as default @sic R5-221406 sic@
    
    //By default px_ePrimaryFrequencyBand/px_SecondaryFrequencyBand are used for frequency initialisation
    //E-UTRA frequencies initialised as per 36.508 - see 38.5508-1 cl 6.2.3.3
    f_EUTRA_Init(p_SysinfoCombination, p_HandleULDataUM, p_UseBigGrants);
    
    f_EUTRA38_IRAT_InitSysinfo(p_SysinfoCombination);
  }

  /*
   * @desc      INIT function for NR5GC NAS I-RAT test cases
   *            Note: to be used in NR5GC I-RAT test cases using eutra_CellA/B/C/D...
   * @param     p_CellsOnSamePLMN
   * @param     p_SysinfoCombination
   * @param     p_CellSpecialFreq   (default value: LTE_NAS_NormalFreq)
   * @param     p_HandleULDataUM    (default value: omit)
   * @param     p_UseBigGrants      (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_IRAT_NAS_Init( EUTRA_NAS_NumOfPLMN_Type p_CellsOnSamePLMN,
                                    Combination_Type p_SysinfoCombination,
                                    EUTRA_NAS_CellSpecialFreq p_CellSpecialFreq := LTE_NAS_NormalFreq,
                                    template (omit) EUTRA_HandleUlDataUM_Type p_HandleULDataUM := omit,
                                    template (omit) EUTRA_UseBigGrants_Type p_UseBigGrants := omit) runs on EUTRA_Multi5GS_PTC
  {
    f_EUTRA38_NR_Config_Set (NR_SA);
    if (f_EUTRA38_NR_IsFR1(px_NR_PrimaryBand)){
        f_EUTRA38_NR_IsFR1_Set(true);
    } else {
        f_EUTRA38_NR_IsFR1_Set(false);
    }
    // Set test environment depending on NR bands under test
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    // test case using 1 NR bands
    f_EUTRA38_NR_InitTestEnvironmnent(px_NR_PrimaryBand, omit);

    f_EUTRA38_Security_Init();
    f_EUTRA38_MobileInfo_Init(); // @sic R5-204399 sic@
    f_EUTRA38_SetNetworkSupport(NOT_SUPPORTED); // Set this as default @sic R5s220482 sic@

    f_EUTRA_NAS_Init( p_CellsOnSamePLMN,
                      p_SysinfoCombination,
                      p_CellSpecialFreq,
                      p_HandleULDataUM,
                      p_UseBigGrants);
    
    fl_EUTRA38_NAS_IRAT_InitSysinfo(p_CellsOnSamePLMN, p_SysinfoCombination); // @sic R5s200732 sic@
  }

  /*
   * @desc      Re-initialise Sysinfo for I-RAT combinations
   * @param     p_SysinfoCombination
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_IRAT_InitSysinfo(Combination_Type p_SysinfoCombination) runs on EUTRA_5GS_PTC
  {
    var EUTRA_NR_CoOrd_SysInfo_Type v_SysInfoNR;
    var template (value) EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_SysInfoListToSend := fl_EUTRA38_IRAT_InitListOfFrequencies();
    var template (value) SystemInformationBlockType24_r15 v_SIB24;

    // Get NR frequency info from NR PTC and send E-UTRA frequencies
    v_SysInfoNR := f_EUTRA_NR_SysinfoCoOrd(NR, v_EUTRA_SysInfoListToSend);
    
    select (p_SysinfoCombination) {
      case (c31) {     // NR-EUTRA SIB24
       // Coordinate with NR PTC: send EUTRA frequencies and return NR frequencies
        v_SIB24 := f_EUTRA38_IRAT_InitSIB24(v_SysInfoNR);
        f_EUTRA38_CellInfo_SetSIB24_FreqListAllCells( v_SIB24 );
      }
      case else {}  // Other combinations: no change needed
    }
  };

  /*
   * @desc      Re-initialise Sysinfo for I-RAT combinations
   * @param     p_CellsOnSamePLMN
   * @param     p_SysinfoCombination
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_EUTRA38_NAS_IRAT_InitSysinfo(EUTRA_NAS_NumOfPLMN_Type p_CellsOnSamePLMN,
                                           Combination_Type p_SysinfoCombination) runs on EUTRA_5GS_PTC
  {
    var EUTRA_NR_CoOrd_SysInfo_Type v_SysInfoNR;
    var template (value) EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_SysInfoListToSend := fl_EUTRA38_IRAT_InitListOfFrequencies();
    var template (value) SystemInformationBlockType24_r15 v_SIB24;

    // Get NR frequency info from NR PTC and send E-UTRA frequencies
    v_SysInfoNR := f_EUTRA_NR_SysinfoCoOrd(NR, v_EUTRA_SysInfoListToSend);
    
    select (p_SysinfoCombination) {
      case (c31) {     // NR-EUTRA SIB24
       // Coordinate with NR PTC: send EUTRA frequencies and return NR frequencies
        v_SIB24 := f_EUTRA38_IRAT_InitSIB24(v_SysInfoNR);
        f_EUTRA38_CellInfo_SetSIB24_FreqListAllNASCells( v_SIB24, p_CellsOnSamePLMN ); // @sic R5s200732 sic@
      }
      case else {}  // Other combinations: no change needed
    }
  };

  /*
   * @desc      Re-populate the list of frequencies f1-f4 on Sysinfo
   * @return    template (value) EUTRA_NR_CoOrd_SysInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_EUTRA38_IRAT_InitListOfFrequencies () runs on EUTRA_PTC return template (value) EUTRA_NR_CoOrd_SysInfo_Type
  { //@sic R5s240231 sic@
    var template (value) CoOrd_EUTRASysInfo_List_Type v_CoOrd_EUTRASysInfo_List;
    var Frequency_fList_Type v_Frequency := f_EUTRA_InitFrequency_f1Tof4(f_EUTRA_CellInfo_GetBand(eutra_Cell1),
                                                                         f_EUTRA_CellInfo_GetDL_ChBandwidth(eutra_Cell1),
                                                                         f_EUTRA_CellInfo_GetUL_ChBandwidth(eutra_Cell1));
    var integer v_DL_Bandwidth := f_ConvertDL_BandwidthToInteger(f_EUTRA_CellInfo_GetDL_ChBandwidth(eutra_Cell1));
    
    v_CoOrd_EUTRASysInfo_List[0] := cs_CoOrdEUTRASysInfo(v_Frequency.f1.dl_CarrierFreq_r9, v_DL_Bandwidth);       // f1
    
    if (v_Frequency.f2.dl_CarrierFreq_r9 != tsc_DummyFrequency) {                                                 // f2 defined for the band
      v_CoOrd_EUTRASysInfo_List[1] := cs_CoOrdEUTRASysInfo(v_Frequency.f2.dl_CarrierFreq_r9, v_DL_Bandwidth);     // f2
      
      if (v_Frequency.f3.dl_CarrierFreq_r9 != tsc_DummyFrequency) {                                               // f3 defined for the band
        v_CoOrd_EUTRASysInfo_List[2] := cs_CoOrdEUTRASysInfo(v_Frequency.f3.dl_CarrierFreq_r9, v_DL_Bandwidth);   // f3
        
        if (v_Frequency.f4.dl_CarrierFreq_r9 != tsc_DummyFrequency) {                                             // f4 defined for the band
          v_CoOrd_EUTRASysInfo_List[3] := cs_CoOrdEUTRASysInfo(v_Frequency.f4.dl_CarrierFreq_r9, v_DL_Bandwidth); // f4
        }
      }
    }
    return cs_EUTRA_NR_CoOrdSysInfo_Eutra(v_CoOrd_EUTRASysInfo_List)
  }

  /*
   * @desc      Return the defined frequencies f1 depending on the band
   *            Acc to 38.508-1 cl 6.3.1.3
   * @param     p_EUTRA_CellList
   * @return    template (value) EUTRA_NR_CoOrd_SysInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_IRAT_ListOfFrequencies(EUTRA_CellIdList_Type p_EUTRA_CellList) runs on EUTRA_PTC return template (value) EUTRA_NR_CoOrd_SysInfo_Type
  {
    var template (value) CoOrd_EUTRASysInfo_List_Type v_CoOrd_EUTRASysInfo_List;
    var integer i;
    
    for (i:=0; i<lengthof(p_EUTRA_CellList); i:=i+1){
        v_CoOrd_EUTRASysInfo_List[i] := f_EUTRA_CoOrdSysInfo(p_EUTRA_CellList[i]);
    }
    return cs_EUTRA_NR_CoOrdSysInfo_Eutra(v_CoOrd_EUTRASysInfo_List);
  }

  /*
   * @desc      Initialise SIB24 with the list of NR frequencies received from Nr PTC
   * @param     p_NR_SysInfoOtherRAT
   * @return    template (value) SystemInformationBlockType24_r15
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_IRAT_InitSIB24 (EUTRA_NR_CoOrd_SysInfo_Type p_NR_SysInfoOtherRAT) return template (value) SystemInformationBlockType24_r15
  {
    var template (value) SystemInformationBlockType24_r15 v_SIB24;
    var template (value) CarrierFreqListNR_r15 v_CarrierFreqListNR;
    var template (value) MTC_SSB_NR_r15 v_MTC_SSB_NR_r15;
    var CarrierFreqNR_r15.subcarrierSpacingSSB_r15 v_SCS;
    var P_MaxNR_r15 v_P_MaxNR;
    var template (omit) CarrierFreqListNR_v1810 v_CarrierFreqListNR_v1810 := omit;
    var boolean v_IncludeCarrierFreqListNR_v1810 := false; //By default NR bands are not 3MHz bandwidth @sic R5-254995 sic@
    
    var integer i;

    for (i:=0; i < lengthof(p_NR_SysInfoOtherRAT.NR); i:=i+1 ){
      //If one NR bandwidth is 3MHz then include CarrierFreqListNR_v1810 for each entry (same number of entries as carrierFreqListNR-r15 )
       // @sic R5-254995 sic@
      if (p_NR_SysInfoOtherRAT.NR[i].Bandwidth == 3) { v_IncludeCarrierFreqListNR_v1810 := true; }
    }
    for (i:=0; i < lengthof(p_NR_SysInfoOtherRAT.NR); i:=i+1 ){
        if (p_NR_SysInfoOtherRAT.NR[i].IsFR1) { //FR1
            v_MTC_SSB_NR_r15 := cs_MTC_SSB_NR_FR1;
            v_P_MaxNR := 23;
        } else { //FR2
            v_MTC_SSB_NR_r15 := cs_MTC_SSB_NR_FR2;
            v_P_MaxNR := 26;
        }
        v_SCS := f_NR_ConvertIntToSCS_CarrierFreqNR(p_NR_SysInfoOtherRAT.NR[i].SCS);
        if (v_IncludeCarrierFreqListNR_v1810) {
          // @sic R5-254995 sic@
          v_CarrierFreqListNR[i] := cs_508_CarrierFreqNR_Def( 250,
                                                              v_MTC_SSB_NR_r15,
                                                              v_SCS,
                                                              v_P_MaxNR,
                                                              {200}
                                                              );
          v_CarrierFreqListNR_v1810[i] := cs_508_CarrierFreqNR_v1810( p_NR_SysInfoOtherRAT.NR[i].Arfcn,
                                                              {p_NR_SysInfoOtherRAT.NR[i].Band}
                                                              );
          
        } else {
          v_CarrierFreqListNR[i] := cs_508_CarrierFreqNR_Def( p_NR_SysInfoOtherRAT.NR[i].Arfcn,
                                                              v_MTC_SSB_NR_r15,
                                                              v_SCS,
                                                              v_P_MaxNR,
                                                              {p_NR_SysInfoOtherRAT.NR[i].Band}
                                                              );
        }
    }
    v_SIB24 := cs_508_SystemInformationBlockType24_Def(v_CarrierFreqListNR, v_CarrierFreqListNR_v1810);
    return v_SIB24;
  }

  /*
   * @desc      Function used for converting a EUTRA_AllowedMeasBandwidth input value to an integer value.
   *            The function is used in NR test cases when the EUTRA type v_DL_PrimaryBandwidth needs
   *            to be converted in to the NR type EUTRA_AllowedMeasBandwidth.
   * @param     p_AllowedMeasBandwidth
   * @return    integer
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_IRAT_ConvertEUTRA_AllowedMeasBandwidthToInteger(AllowedMeasBandwidth p_AllowedMeasBandwidth) return integer
  {
    var integer v_MeasurementBandwidth;   // defined in NR_RRC_ASN1_Definitions
    
    select  (p_AllowedMeasBandwidth) {
      case (mbw6) {                                          //1.4MHz
        v_MeasurementBandwidth := 6;
      }
      case (mbw15) {                                         //3MHz
        v_MeasurementBandwidth := 15;
      }
      case (mbw25) {                                         //5MHz
        v_MeasurementBandwidth := 25;
      }
      case (mbw50) {                                         //10MHz
        v_MeasurementBandwidth := 50;
      }
      case (mbw75) {                                         //15MHz
        v_MeasurementBandwidth := 75;
      }
      case (mbw100) {                                        //20MHz
        v_MeasurementBandwidth := 100;
      }
      case else {
        FatalError(__FILE__,__LINE__, "invalid value for AllowedMeasBandwidth");
      }
    }
    return v_MeasurementBandwidth;
  }

}
