  //----------------------------------------------------------------------------
  testcase TC_11_1_1_3() runs on MTC_UTRAN system SYSTEM_UTRAN {
    // @purpose
    //   Dual priority / T3396 override
    var UTRAN_IRAT_PTC   v_UTRAN      := null;
    var GERAN_PTC        v_GERAN      := null;
    var EUTRA_PTC        v_EUTRA      := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_UTRAN := UTRAN_IRAT_PTC.create("UTRAN") alive;
  
    f_MTC_ConnectPTCs_UTRAN(system, v_UTRAN, v_GERAN, v_EUTRA);
  
    v_UTRAN.start(f_TC_11_1_1_3_UTRAN());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_UTRAN(t_GuardTimer);
  }
