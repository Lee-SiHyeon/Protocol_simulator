module MCX_HTTP_CommonFunctions {

  import from Base64Encoding all;
  import from CommonDefs all;
  import from CommonIP all;
  import from HTTP_ASP_TypeDefs all;
  import from HTTP_CommonFunctions all;
  import from HTTP_CommonTemplates all;
  import from IMS_CommonTemplates all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from IP_PTC_Templates all;
  import from LibSip_SIPTypesAndValues all;
  import from MCX_CommonDefs all;
  import from MCX_CoordMsgs all;
  import from MCX_HTTP_Component all;
  import from MCX_JSON_Objects all;
  import from MCX_OpenIdConnect all;
  import from MCX_Parameters all;
  import from MCX_SecurityFunctions all;
  import from MCX_SecurityParameters all;
  import from MCX_XML_Configuration_Initial all;
  import from MCX_XML_Configuration_MCData all;
  import from MCX_XML_Configuration_MCPTT all;
  import from MCX_XML_Configuration_MCVideo all;
  import from MCX_XML_GroupConfiguration_Common all;
  import from MCX_XML_GroupConfiguration_MCData all;
  import from MCX_XML_GroupConfiguration_MCPTT all;
  import from MCX_XML_GroupConfiguration_MCVideo all;
  import from MCX_XML_mcsecKMSInterface all;
  import from UpperTesterFunctions all;

  const charstring tsc_MCX_OpenIdConnect_Code := "SplxlOBeZQQYbYS6WxSbIA";      /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCX_HtlmForm_UsernamePassword :=
  { /* @status    APPROVED (MCX) */
    "<!DOCTYPE html>",
    "<html>",
    "  <body>",
    "    <form action=""" & tsc_MCX_IdMS_userauth_UriPath & """ method=""post"">",
    "      Username: <input type=""text"" name=""user""><br>",
    "      Password: <input type=""password"" name=""password""><button type=""submit"">",
    "      <button type=""submit"">Login</button>",
    "    </form>",
    "  </body>",
    "</html>"
  };

  template (value) HttpStatusLine_Type cs_HttpStatusLine_302 := cs_HttpStatusLine(302, "Found");                        /* @status    APPROVED (MCX) */

  template (present) HttpCacheControl_Type cr_HttpCacheControl(charstring p_CacheDirective := "no-cache") :=
  { /* @status    APPROVED (MCX) */
    cacheDirective := p_CacheDirective
  };

  template (value) HttpCacheControl_Type cs_HttpCacheControl(charstring p_CacheDirective := "no-store") :=
  { /* @status    APPROVED (MCX) */
    cacheDirective := p_CacheDirective
  };

  template (value) HttpPragma_Type cs_HttpPragma(charstring p_PragmaDirective := "no-cache") :=
  { /* @status    APPROVED (MCX) */
    pragmaDirective := p_PragmaDirective
  };

  template (present) Credentials cr_MCX_HTTP_Credentials(charstring p_AuthScheme,
                                                         charstring p_CredentialString) :=
  { /* @status    APPROVED (MCX) */
    otherResponse := {
      authScheme := p_AuthScheme,
      authParams := {
        cr_GenericParam_Common(p_CredentialString, omit)
      }
    }
  };

  template (present) Authorization cr_MCX_HTTP_Authorization(template (present) Credentials p_Credentials) :=
  { /* @status    APPROVED (MCX) */
    fieldName := AUTHORIZATION_E,
    body := {
      p_Credentials
    }
  };

  template (present) Authorization cr_MCX_HTTP_Authorization_Bearer(charstring p_Token) :=
  /* @status    APPROVED (MCX) */
    cr_MCX_HTTP_Authorization(cr_MCX_HTTP_Credentials("Bearer", p_Token));

  template (value) HttpLocation_Type cs_Location(charstring p_Uri) :=
  { /* @status    APPROVED (MCX) */
    uri := p_Uri
  };

  template (present) ContentType cr_ContentTypeUrlEncoded := cr_ContentType("application/x-www-form-urlencoded");               /* @status    APPROVED (MCX) */

  template (value) HttpMessageBody cs_HttpMessageBody_Binary(template (value) octetstring p_Binary) := { binary := p_Binary };  /* @status    APPROVED (MCX) */

  template (present) HttpRequest_Type cr_MCX_HttpRequest(template (present) charstring p_Method,
                                                         template (present) charstring p_RequestUri := ?,
                                                         template Authorization p_Authorization := *,
                                                         template Host p_Host := *,
                                                         template ContentType p_ContentType := *,
                                                         template HttpMessageBody p_MessageBody := *) :=
  { /* @status    APPROVED (MCX) */
    requestLine := cr_HttpRequestLine(p_Method, p_RequestUri),
    userAgent := *,
    authorization := p_Authorization,
    host := p_Host,
    contentType := p_ContentType,
    cacheControl := cr_HttpCacheControl ifpresent,      /* @sic R5-245753, R5s240511 change 7: ifpresent sic@ */
    x3GPPIntendedIdentity := *,
    accept := *,                                        // @sic R5w240307 sic@
    messageBody := p_MessageBody
  };

  template (present) HttpRequest_Type cr_MCX_HttpRequest_GET(template (present) charstring p_RequestUri,
                                                             template Authorization p_Authorization := omit,
                                                             template ContentType p_ContentType := omit,
                                                             template HttpMessageBody p_MessageBody := omit) :=
  /* 36.579-1 Table 5.5.4.2-1 */
  /* @status    APPROVED (MCX) */
    cr_MCX_HttpRequest("GET", p_RequestUri, p_Authorization, -, p_ContentType, p_MessageBody);

  template (present) HttpRequest_Type cr_MCX_HttpRequest_POST(template (present) charstring p_RequestUri,
                                                              template Authorization p_Authorization := omit,
                                                              template Host p_Host := *,
                                                              template ContentType p_ContentType,
                                                              template HttpMessageBody p_MessageBody := cr_HttpMessageBody_Text) :=
  /* @status    APPROVED (MCX) */
    cr_MCX_HttpRequest("POST", p_RequestUri, p_Authorization, p_Host, p_ContentType, p_MessageBody);

  template (value) HttpResponse_Type cs_MCX_HttpResponse(template (value) HttpStatusLine_Type p_HttpStatusLine,
                                                         template (omit)  SIP_ETag p_ETag := omit,
                                                         template (omit)  HttpLocation_Type p_Location := omit,
                                                         template (omit)  HttpCacheControl_Type p_CacheControl := omit,
                                                         template (omit)  HttpPragma_Type p_Pragma := omit,
                                                         template (omit)  ContentType p_ContentType := omit,
                                                         template (omit)  ContentLength p_ContentLength := omit,
                                                         template (omit)  HttpMessageBody p_MessageBody := omit) :=
  { /* @status    APPROVED (MCX) */
    statusLine := p_HttpStatusLine,
    date := omit,
    eTag := p_ETag,
    server := omit,
    wwwauthenticate := omit,
    authenticationInfo := omit,
    contentType := p_ContentType,
    location := p_Location,
    contentLength := p_ContentLength,
    expires := omit,
    cacheControl := p_CacheControl,
    pragma := p_Pragma,
    messageBody := p_MessageBody
  };

  template (value) HttpResponse_Type cs_MCX_HttpResponse_200(template (omit) SIP_ETag p_ETag,
                                                             template (omit)  ContentType p_ContentType := omit,
                                                             template (omit)  ContentLength p_ContentLength := omit,
                                                             template (omit)  HttpMessageBody p_MessageBody := omit) :=
    /* @status    APPROVED (MCX) */
    cs_MCX_HttpResponse(cs_HttpStatusLine_200, p_ETag, -, cs_HttpCacheControl, cs_HttpPragma, p_ContentType, p_ContentLength, p_MessageBody);

  /*
   * @desc      To build receive template for request URI with scheme being either http or https
   * @param     p_Path
   * @return    template (present) charstring
   * @status    APPROVED (MCX)
   */
  function fl_MCX_HTTP_HttpHttpsRequestUriTemplate(charstring p_Path) return template (present) charstring
  {
    return ("http://" & p_Path, "https://" & p_Path); /* @sic R5-242398: "http" or "https" sic@ */
  }

  /*
   * @desc      Receive HTTP request
   * @param     p_HttpRoutingInfo   (default value: ?)
   * @param     p_HttpRequest
   * @param     p_HTTP_DATA_ASP_ByRef (by reference)
   * @status    APPROVED (MCX)
   */
  altstep a_MCX_HTTP_ReceiveRequest(template (present) IP_Connection_Type p_HttpRoutingInfo := ?,
                                    template (present) HttpRequest_Type p_HttpRequest,
                                    out HTTP_DATA_ASP p_HTTP_DATA_ASP_ByRef) runs on MCX_HTTP_PTC
  {
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    [] HTTPDATA.receive(cr_HTTP_REQUEST(p_HttpRoutingInfo, p_HttpRequest)) -> value v_HTTP_DATA_ASP {
      p_HTTP_DATA_ASP_ByRef := v_HTTP_DATA_ASP;
    }
  }

  /*
   * @desc      Wrapper function
   * @param     p_HttpRoutingInfo   (default value: ?)
   * @param     p_HttpRequest
   * @return    HTTP_DATA_ASP
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_ReceiveRequest(template (present) IP_Connection_Type p_HttpRoutingInfo := ?,
                                     template (present) HttpRequest_Type p_HttpRequest) runs on MCX_HTTP_PTC return HTTP_DATA_ASP
  {
    var HTTP_DATA_ASP v_HTTP_DATA_ASP_ByRef;
    a_MCX_HTTP_ReceiveRequest(p_HttpRoutingInfo, p_HttpRequest, v_HTTP_DATA_ASP_ByRef);
    return v_HTTP_DATA_ASP_ByRef;
  }

  /*
   * @desc      Send HTTP 200 OK
   * @param     p_HttpRoutingInfo
   * @param     p_ContentType       (default value: omit)
   * @param     charstring          (default value: omit)
   * @param     p_BinaryBody        (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_Send200OK(IP_Connection_Type p_HttpRoutingInfo,
                                template (omit) ContentType p_ContentType := omit,
                                template (omit) universal charstring p_TextBody := omit,
                                template (omit) octetstring p_BinaryBody := omit) runs on MCX_HTTP_PTC
  {
    var template (omit) HttpMessageBody v_MessageBody := omit;
    var template (omit) ContentLength v_ContentLength := omit;
    var template (omit) SIP_ETag v_ETag := omit;
    var EntityTag v_EntityTag;
    var integer v_ETagCnt;
    var charstring v_TextBody;
    var octetstring v_BinaryBody;
    var charstring v_MimeType;

    if (isvalue(p_ContentType.mTypeSubtype)) {          // @sic R5-230295 sic@
      v_MimeType := valueof(p_ContentType.mTypeSubtype);
      select (v_MimeType) {
        case (tsc_MimeType_McpttUEInitConfig,           // UEINITIALCONFIG
              tsc_MimeType_McpttUEConfig,               // UECONFIG
              tsc_MimeType_McvideoUEConfig,             // UECONFIG
              tsc_MimeType_McdataUEConfig,              // UECONFIG
              tsc_MimeType_McpttUserProfile,            // UEUSERPROF
              tsc_MimeType_McvideoUserProfile,          // UEUSERPROF
              tsc_MimeType_McdataUserProfile,           // UEUSERPROF
              tsc_MimeType_McpttServConfig,             // UESERVCONFIG
              tsc_MimeType_McvideoServConfig,           // UESERVCONFIG
              tsc_MimeType_McdataServConfig,            // UESERVCONFIG
              tsc_MimeType_PocGroups,                   // GROUPCONFIG
              tsc_MimeType_GMOP) {                      // TEMPGROUP
          v_ETagCnt := f_MCX_HTTP_IncrAndGetETagCnt();
          v_EntityTag := "ABCDXYZ" & int2str(v_ETagCnt);
          v_ETag := cs_SIP_ETag(v_EntityTag);
        }
      }
    }

    if (isvalue(p_TextBody)) {
      v_TextBody := f_UniCharstring2Charstring(valueof(p_TextBody));
      v_MessageBody := cs_HttpMessageBody_Text(v_TextBody);
    } else if (isvalue(p_BinaryBody)) {
      v_BinaryBody := valueof(p_BinaryBody);
      v_MessageBody := cs_HttpMessageBody_Binary(v_BinaryBody);
    }
    v_ContentLength := f_HttpContentLength(v_MessageBody);
    f_HTTP_SendResponse(HTTPDATA, p_HttpRoutingInfo, cs_MCX_HttpResponse_200(v_ETag, p_ContentType, v_ContentLength, v_MessageBody));
  }

  /*
   * @desc      Check signed KMS request sent by the client when the clients supports signed KMS requests
   * @param     p_SecurityParameters
   * @param     p_HttpRequest
   * @param     p_MCServiceID
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_CheckSignedKmsRequest(MCX_SecurityParameters_Type p_SecurityParameters,
                                            HttpRequest_Type p_HttpRequest,
                                            charstring p_MCServiceID) runs on MCX_HTTP_PTC
  {
    var MCX_SecurityKey_Type v_InK := f_MCX_SecurityParameters_GetExistingKey(p_SecurityParameters, InK);
    var charstring v_ClientReqUrl := p_HttpRequest.requestLine.uri;

    if (pc_MCX_KMS_RequestSecurity) {                           // @sic R5-210208 sic@
      if (not isvalue(p_HttpRequest.contentType)) {
        f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Missing content type");
      }
      if (not isvalue(p_HttpRequest.messageBody.text)) {
        f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Missing message body");
      }
      if (not f_MCX_SignedKmsRequest_DecodeAndCheck(p_HttpRequest.messageBody.text, p_MCServiceID, v_ClientReqUrl, v_InK)) {
        f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid SignedKmsRequest");
      }
    }
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 step 1a1 - 1a2: optional UE initial configuration
   * @param     p_RequestUri        (default value: px_MCX_InitialConfigServer_UriPath)
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_InitialUEConfiguration(charstring p_RequestUri := px_MCX_InitialConfigServer_UriPath) runs on MCX_HTTP_PTC
  {
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var IP_Connection_Type v_HttpRoutingInfo;
    var charstring v_HttpBody;

    alt {
      // Table 5.3.2.3.1-1 step 1a1: HTTP GET - 36.579-1 Table 5.5.4.2-1 with condition UEINITIALCONFIG
      [] HTTPDATA.receive(cr_HTTP_REQUEST(?, cr_MCX_HttpRequest_GET(p_RequestUri))) -> value v_HTTP_DATA_ASP
        {
          v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;
          v_HttpBody := f_Bit2Char(f_MCX_Encode_UEInitialConfiguration());
          // Table 5.3.2.3.1-1 step 1a2: HTTP 200 (OK) - Table 5.5.4.6-1 with condition UEINITIALCONFIG
          f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType(tsc_MimeType_McpttUEInitConfig), v_HttpBody);
        }
      [] HTTPDATA.check(receive(cr_HTTP_REQUEST(?, cr_MCX_HttpRequest(("GET", "POST")))))    // check whether there is any other GET/POST request ...
        {
          // ... continue with next steps when the UE does not request for initial configuration
        }
    }
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 - step 3 - 4:
   *            UE -> IDMS      HTTP GET/POST   /idms/auth      Authentication Request containing response_type="code", client_id, scope, redirect_uri, state, acr_values, code_challenge, code_challenge_method
   *                                                            scope values according to 33.180 Table B.4.2.2-1 for MCPTT and/or MCData and/or MCVideo
   *            UE <- IDMS      200 OK                          HTML form for Authentication providing the URI to which the user/password shall be sent (/idms/userauth -> Table 5.3.2.3.2-5)
   * @param     p_ServiceType
   * @return    MCX_OpenIdConnect_ParameterList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Step3_4(MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC return MCX_OpenIdConnect_ParameterList_Type
  {
    var template (present) HttpRequest_Type v_HttpRequestGet := cr_MCX_HttpRequest_GET(?, -, cr_ContentTypeUrlEncoded ifpresent);  /* @sic R5-245753, R5s240511 change 8: ifpresent sic@ */
    var template (present) HttpRequest_Type v_HttpRequestPost := cr_MCX_HttpRequest_POST(tsc_MCX_IdMS_auth_UriPath, -, -, cr_ContentTypeUrlEncoded);
    var template (present) MCX_OpenIdConnect_ParameterList_Type v_OpenIdConnectAuthenticationRequest := cr_MCX_OpenIdConnect_AuthenticationRequest(p_ServiceType,
                                                                                                                                                   px_MCX_OAuth_RedirectURI_A,
                                                                                                                                                   px_MCX_OAuth_ClientId_A);
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var MCX_OpenIdConnect_ParameterList_Type v_OpenIdConnectRequest;

    // step 3: HTTP GET/POST
    v_HTTP_DATA_ASP := f_MCX_HTTP_ReceiveRequest(-, (v_HttpRequestGet, v_HttpRequestPost));
    v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;

    select (v_HTTP_DATA_ASP.http.request.requestLine.method) {
      case ("GET") {   // 36.579-1 Table 5.5.4.2-1 with condition AUTH; URI with query parameters
        v_OpenIdConnectRequest := f_MCX_OpenID_DecodeAndCheckURI(v_HTTP_DATA_ASP.http.request.requestLine.uri, tsc_MCX_IdMS_auth_UriPath, v_OpenIdConnectAuthenticationRequest);
      }
      case ("POST") {  // 36.579-1 Table 5.5.4.3-1 with condition AUTH
        v_OpenIdConnectRequest := f_MCX_OpenID_DecodeAndCheckMessageBody(v_HTTP_DATA_ASP.http.request.messageBody.text, v_OpenIdConnectAuthenticationRequest);
      }
    }
    // step 4: HTTP 200 (OK)
    f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType("text/html"), f_StringJoin(tsc_MCX_HtlmForm_UsernamePassword, "\n"));
 
    return v_OpenIdConnectRequest;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 - step 5 - 7:
   *            MMI: username/password
   *            UE -> IDMS      HTTP POST       /idms/userauth  Message-body with user/password
   *            UE <- IDMS      302                             Location field with redirect URI (provided in Authentication Request) and query parameters (Authentication Response: code, state -> 33.180 B.4.2.3)
   * @param     p_AuthenticationRequest
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Step5_7(MCX_OpenIdConnect_ParameterList_Type p_AuthenticationRequest) runs on MCX_HTTP_PTC
  {
    var template (value) MCX_OpenIdConnect_ParameterList_Type v_OpenIdConnectAuthenticationResponse;
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var charstring v_State;
    var charstring v_Code := tsc_MCX_OpenIdConnect_Code;
    var charstring v_URI;
    var template (present) MCX_OpenIdConnect_ParameterList_Type v_UserCredentials := {
      cr_MCX_OpenIdConnect_NameValueParameter("user",     px_MCX_User_A_username),
      cr_MCX_OpenIdConnect_NameValueParameter("password", px_MCX_User_A_password)
    };

    // step 5: Make the UE user provide user credentials: username and password
    f_UT_MCX_UserAction (MMI, "Provide the UE (MCX client) with user credentials: username and password (" & px_MCX_User_A_username & ", " & px_MCX_User_A_password & ")");

    // step 6: HTTP POST - 36.579-1 Table 5.5.4.3-1 with condition USERAUTH
    v_HTTP_DATA_ASP := f_MCX_HTTP_ReceiveRequest(-, cr_MCX_HttpRequest_POST(tsc_MCX_IdMS_userauth_UriPath, -, -, cr_ContentTypeUrlEncoded));
    v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;
    f_MCX_OpenID_DecodeAndCheckMessageBody(v_HTTP_DATA_ASP.http.request.messageBody.text, v_UserCredentials);

    // step 7: HTTP 302 - 36.579-1 Table 5.5.4.8-1 with condition AUTH
    v_State := f_MCX_OpenID_GetParameter(p_AuthenticationRequest, "state");
    v_OpenIdConnectAuthenticationResponse := cs_MCX_OpenIdConnect_AuthenticationResponse(v_State, v_Code);
    v_URI := f_MCX_OpenID_EncodeURI(px_MCX_OAuth_RedirectURI_A, v_OpenIdConnectAuthenticationResponse);
    f_HTTP_SendResponse(HTTPDATA, v_HttpRoutingInfo, cs_MCX_HttpResponse(cs_HttpStatusLine_302, -, cs_Location(v_URI)));
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 - step 9 - 10:
   *            UE -> IDMS      HTTP POST       /idms/token     Access token request: grant_type="authorization_code", code as in Authentication Response, client_id, redirect_uri, code_verifier
   *            UE <- IDMS      200 OK                          Access token response: access_token, token_type="bearer", expires_in, Id_token (optional), Refresh_token (optional)
   *                                                            Access token contains MC service IDs for the services the client is authorised to access (mcptt_id, mcdata_id, mcvideo_id)
   * @param     p_AuthenticationRequest
   * @param     p_ServiceType
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Step9_10(MCX_OpenIdConnect_ParameterList_Type p_AuthenticationRequest,
                                                  MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := f_MCX_SecurityParameters_Init(tsc_MCX_KMS_Hostname);   /* tsc_MCX_KMS_Hostname is used as KMS Identifier for Generation of MIKEY-SAKKE UID according to 33.180 F.2.1.1 */
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var MCX_OpenIdConnect_ParameterList_Type v_OpenIdConnectRequest;
    var charstring v_CodeChallenge;
    var charstring v_CodeVerifier;
    var charstring v_HttpBody;
    var MCX_Tokens_Type v_Tokens;
    var CharStringList_Type v_ScopeList;
    var MCX_OpenIdConnect_ValueList_Type v_ScopeValueList := f_MCX_OpenIdConnect_ScopeList(p_ServiceType);
    var integer v_StrLen;
    var integer i;

    // step 9: HTTP POST - 36.579-1 Table 5.5.4.3-1 with condition TOKEN
    v_HTTP_DATA_ASP := f_MCX_HTTP_ReceiveRequest(-, cr_MCX_HttpRequest_POST(tsc_MCX_IdMS_token_UriPath, -, -, cr_ContentTypeUrlEncoded));
    v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;
    
    v_OpenIdConnectRequest := f_MCX_OpenID_DecodeAndCheckMessageBody(v_HTTP_DATA_ASP.http.request.messageBody.text,
                                                                     cr_MCX_OpenIdConnect_TokenRequest(tsc_MCX_OpenIdConnect_Code, px_MCX_OAuth_ClientId_A, px_MCX_OAuth_RedirectURI_A));
    v_CodeChallenge := f_MCX_OpenID_GetParameter(p_AuthenticationRequest, "code_challenge");
    v_CodeVerifier := f_MCX_OpenID_GetParameter(v_OpenIdConnectRequest, "code_verifier");

    v_StrLen := lengthof(v_CodeVerifier);
    if ((v_StrLen < 43) or (v_StrLen > 128)) {                                                      /* RFC 7636: code_verifier: high-entropy cryptographic random STRING with a minimum length of 43 characters and a maximum length of 128 characters */
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "code_verifier with invalid length");
    }

    if (v_CodeChallenge != f_Base64urlEncode(oct2bit(fx_SHA_2(SHA_256, char2oct(v_CodeVerifier))))) {
      // According to 33.179 Table B.3.1.1-1 the code_challenge is "The base64url-encoded SHA-256 challenge derived from the code verifier that is sent in the authorization request"
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "code_challenge does not match base64url-encoded SHA-256 hallenge derived from the code verifier");
    }

    // step 10: HTTP 200 (OK) - Table 5.5.4.6-1 with condition TOKEN
    for (i := 0; i < lengthof(v_ScopeValueList); i := i + 1) { v_ScopeList[i] := v_ScopeValueList[i] };   // convert set-of to record-of
    v_Tokens := f_MCX_JSON_CreateTokens(p_ServiceType, px_MCX_OAuth_ClientId_A, tsc_MCX_IdMS_token_UriPath, v_ScopeList, px_MCX_TokenRsaPrivateKey);
    v_HttpBody := f_JSON_EncodeObject(cs_MCX_OpenIdConnect_TokenResponse(v_Tokens.AccessToken, v_Tokens.RefreshToken, v_Tokens.IdToken));
    f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType("application/json", {cs_GenericParam("charset", "UTF-8")}), v_HttpBody);

    v_SecurityParameters := f_MCX_SecurityParameters_SetTokens(v_SecurityParameters, v_Tokens);

    return v_SecurityParameters;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 - step 11 - 12
   *            UE -> KMS       HTTP POST       /keymanagement/identity/v1/init         KMS Initialize request (33.180 D.2.3) containing Access Token in Authorization header field
   *            UE <- KMS       200 OK                                                  SignedKmsResponse with KmsInit response containing KmsCertificate (33.180 D.3.2) with KMS Public Authentication and Confidentiality Keys (KPAK, Z_T);
   *                                                                                    -> 33.180 clause 5.3.5
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Step11_12(MCX_ServiceType_Type p_ServiceType,
                                                   MCX_SecurityParameters_Type p_SecurityParameters) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var charstring v_MCServiceID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    var charstring v_AccessToken := p_SecurityParameters.Tokens.AccessToken;
    var template (present) charstring v_ExpectedRequestUri := fl_MCX_HTTP_HttpHttpsRequestUriTemplate(tsc_MCX_KMS_Init_ReqUri_HostnamePath);   /* @sic R5-242398, R5s240424: "http" or "https" sic@ */
    var universal charstring v_HttpBody;
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var charstring v_RequestUri;

    // step 11: HTTP POST - 36.579-1 Table 5.5.4.3-1 with condition KMSINIT
    v_HTTP_DATA_ASP := f_MCX_HTTP_ReceiveRequest(-, cr_MCX_HttpRequest_POST(v_ExpectedRequestUri,      /* @sic R5-224970: tsc_MCX_KMS_ClientReqUrl_init instead of tsc_MCX_KMS_init_UriPath sic@
                                                                                                          @sic R5-242398: v_ExpectedRequestUri sic@ */
                                                                            cr_MCX_HTTP_Authorization_Bearer(v_AccessToken),
                                                                            -,
                                                                            cr_ContentType(c_xmlApplication) ifpresent,
                                                                            cr_HttpMessageBody_Text ifpresent));
    f_MCX_HTTP_CheckSignedKmsRequest(p_SecurityParameters, v_HTTP_DATA_ASP.http.request, v_MCServiceID);
    v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;

    // step 12: HTTP 200 (OK) - Table 5.5.4.6-1 with condition KMSINIT
    v_RequestUri := v_HTTP_DATA_ASP.http.request.requestLine.uri;
    v_HttpBody := f_MCX_XML_SignedKmsInitResponse(p_SecurityParameters, v_RequestUri, v_MCServiceID);
    f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType(c_xmlApplication), v_HttpBody);

    return v_SecurityParameters;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1 - step 13 - 14
   *            UE -> KMS       HTTP POST       /keymanagement/identity/v1/keyprov      KMS KeyProvision request (33.180 D.2.4) containing Access Token in Authorization header field
   *            UE <- KMS       200 OK                                                  SignedKmsResponse with Kms response containing KmsKeySet with signing key for each UID (SSK and PVT) and decryption key for each UID (RSK);
   *                                                                                    -> 33.180 clause 5.3.6
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Step13_14(MCX_ServiceType_Type p_ServiceType,
                                                   MCX_SecurityParameters_Type p_SecurityParameters)
    runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var charstring v_MCServiceID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    var charstring v_AccessToken := p_SecurityParameters.Tokens.AccessToken;
    var template (present) charstring v_ExpectedRequestUri := fl_MCX_HTTP_HttpHttpsRequestUriTemplate(tsc_MCX_KMS_KeyProv_ReqUri_HostnamePath);   /* @sic R5-242398, R5s240424: "http" or "https" sic@
                                                                                                                                                     !!!! PROSE ISSUE - According to 33.180 D.2.4:
                                                                                                                                                     !!!! "Optionally, the Request-URI of the POST request may contain a specific user or group URI ..." */
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var universal charstring v_HttpBody;
    var octetstring v_UID;
    var charstring v_RequestUri;
    
    // step 13: HTTP POST - 36.579-1 Table 5.5.4.3-1 with condition KMSKEY
    v_HTTP_DATA_ASP := f_MCX_HTTP_ReceiveRequest(-, cr_MCX_HttpRequest_POST(v_ExpectedRequestUri,      /* @sic R5-224970: tsc_MCX_KMS_ClientReqUrl instead of tsc_MCX_KMS_keyprov_UriPath sic@
                                                                                                          @sic R5-242398: v_ExpectedRequestUri sic@ */
                                                                            cr_MCX_HTTP_Authorization_Bearer(v_AccessToken),
                                                                            -,
                                                                            cr_ContentType(c_xmlApplication) ifpresent,
                                                                            cr_HttpMessageBody_Text ifpresent));
    f_MCX_HTTP_CheckSignedKmsRequest(p_SecurityParameters, v_HTTP_DATA_ASP.http.request, v_MCServiceID);
    v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;
    
    // step 14: HTTP 200 (OK) - Table 5.5.4.6-1 with condition KMSKEY
    v_RequestUri := v_HTTP_DATA_ASP.http.request.requestLine.uri;
    v_UID := f_MCX_SecurityParameters_GetUID(v_SecurityParameters, v_MCServiceID);
    v_SecurityParameters := f_MCX_SecurityParameters_SetClientRSK(v_SecurityParameters, v_UID);
    v_SecurityParameters := f_MCX_SecurityParameters_SetSskPvtPair(v_SecurityParameters, v_UID);
    v_HttpBody := f_MCX_XML_SignedKmsKeyProvResponse(v_SecurityParameters, v_RequestUri, v_MCServiceID, v_UID);                // 36.579-1, Table 5.5.4.10.8-1
    
    f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType(c_xmlApplication), v_HttpBody);

    return v_SecurityParameters;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1: MCPTT user authentication Step 3 - 10
   * @param     p_ServiceType
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Part1(MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters;
    var MCX_OpenIdConnect_ParameterList_Type v_OpenIdAuthenticationRequest;
    
    // Step 1a1 - 1a2: Optional initial UE configuration
    f_MCX_HTTP_UserAuthentication_InitialUEConfiguration();                        /* @sic R5-201220 sic@ */
    
    // Step 3 - 4
    v_OpenIdAuthenticationRequest := f_MCX_HTTP_UserAuthentication_Step3_4(p_ServiceType);
    
    // Step 5 - 7
    f_MCX_HTTP_UserAuthentication_Step5_7(v_OpenIdAuthenticationRequest);
    
    // Step 8: UE establishes TLS tunnel if needed
    
    // Step 9 - 10
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Step9_10(v_OpenIdAuthenticationRequest, p_ServiceType);
    
    return v_SecurityParameters;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1: MCPTT user authentication Step 11-14
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication_Part2(MCX_ServiceType_Type p_ServiceType,
                                               MCX_SecurityParameters_Type p_SecurityParameters) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    
    // Step 11 - 12
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Step11_12(p_ServiceType, v_SecurityParameters);
    
    // Step 13 - 14
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Step13_14(p_ServiceType, v_SecurityParameters);
    
    return v_SecurityParameters;
  }

  /*
   * @desc      36.579-1 Table 5.3.2.3.1-1: MCX user authentication
   * @param     p_ServiceType
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_UserAuthentication(MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters;
    
    // Step 1 - 10
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Part1(p_ServiceType);
    
    // Step 11 - 14
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Part2(p_ServiceType, v_SecurityParameters);
    
    return v_SecurityParameters;
  }

  /*
   * @desc      Common altestep to receive and respond HTTP GET requests from the client
   * @param     p_SecurityParameters
   * @param     p_RequestUri
   * @param     p_TypeSubtype
   * @param     p_EncodedConfiguration
   * @status    APPROVED (MCX)
   */
  altstep a_MCX_HTTP_UEConfigurationCommon(MCX_SecurityParameters_Type p_SecurityParameters,
                                           charstring p_RequestUri,
                                           charstring p_TypeSubtype,
                                           bitstring p_EncodedConfiguration) runs on MCX_HTTP_PTC
  {
    var charstring v_AccessToken := p_SecurityParameters.Tokens.AccessToken;
    var IP_Connection_Type v_HttpRoutingInfo;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP_ByRef;
    var HTTP_DATA_ASP v_HTTP_DATA_ASP;
    var charstring v_HttpBody;
  
    [] a_MCX_HTTP_ReceiveRequest(-, cr_MCX_HttpRequest_GET(p_RequestUri, cr_MCX_HTTP_Authorization_Bearer(v_AccessToken)), v_HTTP_DATA_ASP_ByRef) {

      v_HTTP_DATA_ASP := v_HTTP_DATA_ASP_ByRef;
      v_HttpRoutingInfo := v_HTTP_DATA_ASP.routingInfo;
      v_HttpBody := f_Bit2Char(p_EncodedConfiguration);
      f_MCX_HTTP_Send200OK(v_HttpRoutingInfo, cs_ContentType(p_TypeSubtype), v_HttpBody);
    }
  }

  /*
   * @desc      Table 5.3.2.6.1-1 step 5 - 10, Table 5.3.2.7.1-1 step 5 - 6
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_ConfigurationGroupManagementSubscription(MCX_ServiceType_Type p_ServiceType,
                                                               MCX_SecurityParameters_Type p_SecurityParameters) runs on MCX_HTTP_PTC
  {
    var MCX_Coordination_MSG v_Dummy;
    var boolean v_AllowCMS := false;
    var boolean v_AllowGMS := false;
    var boolean v_UE_Config_Done := false;
    var boolean v_User_Profile_Done := false;
    var boolean v_Service_Config_Done := false;
    var boolean v_Group_Config_Done := false;
    var charstring v_MCSUEID := f_SIP_InstanceId();
    var charstring v_UE_Config_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, http_get, UECONFIG, -, v_MCSUEID);
    var charstring v_User_Profile_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, http_get, UEUSERPROF);
    var charstring v_Service_Config_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, http_get, UESERVCONFIG);
    var charstring v_Group_Config_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, http_get, GROUPCONFIG);
    var charstring v_MimeTypeUEConfiguration;
    var charstring v_MimeTypeUserProfile;
    var charstring v_MimeTypeServConfiguration;
    var bitstring v_EncodedUEConfiguration;
    var bitstring v_EncodedUserProfile;
    var bitstring v_EncodedServiceConfiguration;
    var bitstring v_EncodedGroupConfiguration;
    var template (value) MCX_PocListService_Group_Type v_GroupConfiguration;
    
    select (p_ServiceType) {
      case (MCPTT) {
        v_MimeTypeUEConfiguration := tsc_MimeType_McpttUEConfig;
        v_MimeTypeUserProfile := tsc_MimeType_McpttUserProfile;
        v_MimeTypeServConfiguration := tsc_MimeType_McpttServConfig;
        v_EncodedUEConfiguration := f_MCPTT_UEConfiguration_Encode(cs_MCPTT_UEConfiguration);
        v_EncodedUserProfile := f_MCPTT_UserProfile_Encode(cs_MCPTT_UserProfile(-, f_MCPTT_UserProfile_Extension()));
        v_EncodedServiceConfiguration := f_MCPTT_ServiceConfiguration_Encode(cs_MCPTT_ServiceConfiguration);
        v_GroupConfiguration := f_MCPTT_GroupConfiguration();
      }
      case (MCVideo) {
        v_MimeTypeUEConfiguration := tsc_MimeType_McvideoUEConfig;
        v_MimeTypeUserProfile := tsc_MimeType_McvideoUserProfile;
        v_MimeTypeServConfiguration := tsc_MimeType_McvideoServConfig;
        v_EncodedUEConfiguration := f_MCVideo_UEConfiguration_Encode(cs_MCVideo_UEConfiguration);
        v_EncodedUserProfile := f_MCVideo_UserProfile_Encode(cs_MCVideo_UserProfile);
        v_EncodedServiceConfiguration := f_MCVideo_ServiceConfiguration_Encode(cs_MCVideo_ServiceConfiguration);
        v_GroupConfiguration := f_MCVideo_GroupConfiguration();
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_MimeTypeUEConfiguration := tsc_MimeType_McdataUEConfig;
        v_MimeTypeUserProfile := tsc_MimeType_McdataUserProfile;
        v_MimeTypeServConfiguration := tsc_MimeType_McdataServConfig;
        v_EncodedUEConfiguration := f_MCData_UEConfiguration_Encode(cs_MCData_UEConfiguration);
        v_EncodedUserProfile := f_MCData_UserProfile_Encode(f_MCData_UserProfile());
        v_EncodedServiceConfiguration := f_MCData_ServiceConfiguration_Encode(f_MCData_ServiceConfiguration());
        v_GroupConfiguration := f_MCData_GroupConfiguration();
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    v_EncodedGroupConfiguration := f_MCX_GroupConfiguration_Encode(v_GroupConfiguration);
    

    while (not (v_UE_Config_Done and v_User_Profile_Done and v_Service_Config_Done and v_Group_Config_Done)) {
      alt {
        [] a_MCX_WaitForCoOrdMsg(IMS, cmr_MCX_Trigger(CMS), v_Dummy) {  // Trigger that IMS PTC is ready to send NOTIFY
          f_MCX_SendTrigger(IMS, CMS);                                  // confirmation to tell IMS PTC to send NOTIFY
          v_AllowCMS := true;
        }
        [] a_MCX_WaitForCoOrdMsg(IMS, cmr_MCX_Trigger(GMS), v_Dummy) {  // Trigger that IMS PTC is ready to send NOTIFY
          f_MCX_SendTrigger(IMS, GMS);                                  // confirmation to tell IMS PTC to send NOTIFY
          v_AllowGMS := true;
        }
        // Table 5.3.2.6.1-1 step 5 - 6
        [v_AllowCMS] a_MCX_HTTP_UEConfigurationCommon(p_SecurityParameters, v_UE_Config_URI, v_MimeTypeUEConfiguration, v_EncodedUEConfiguration) {
          v_UE_Config_Done := true;
        }
        // Table 5.3.2.6.1-1 step 7 - 8
        [v_AllowCMS] a_MCX_HTTP_UEConfigurationCommon(p_SecurityParameters, v_User_Profile_URI, v_MimeTypeUserProfile, v_EncodedUserProfile) {
          v_User_Profile_Done := true;
        }
        // Table 5.3.2.6.1-1 step 9 - 10
        [v_AllowCMS] a_MCX_HTTP_UEConfigurationCommon(p_SecurityParameters, v_Service_Config_URI, v_MimeTypeServConfiguration, v_EncodedServiceConfiguration) {
          v_Service_Config_Done := true;
        }
        // Table 5.3.2.7.1-1 step 5 - 6
        [v_AllowGMS] a_MCX_HTTP_UEConfigurationCommon(p_SecurityParameters, v_Group_Config_URI, tsc_MimeType_PocGroups, v_EncodedGroupConfiguration) {
          v_Group_Config_Done := true;
        }
      }
    }
  }

  /*
   * @desc      Table 5.3.22.3-1 step 3 - 4
   * @param     p_ServiceType
   * @param     p_SecurityParameters
   * @param     p_GroupConfiguration
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_DownloadGroupDocument(MCX_ServiceType_Type p_ServiceType,
                                            MCX_SecurityParameters_Type p_SecurityParameters,
                                            template (value) MCX_PocListService_Group_Type p_GroupConfiguration) runs on MCX_HTTP_PTC
  {
    var charstring v_Group_Config_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, http_get, GROUPCONFIG);
    var bitstring v_EncodedGroupConfiguration := f_MCX_GroupConfiguration_Encode(p_GroupConfiguration);

    f_MCX_WaitForTrigger(IMS);
    a_MCX_HTTP_UEConfigurationCommon(p_SecurityParameters, v_Group_Config_URI, tsc_MimeType_PocGroups, v_EncodedGroupConfiguration);
    f_MCX_SendTrigger(IMS);
  }

  template (value) TLSConfig_Type cs_TLSConfig_Certificate(charstring p_Certificate,
                                                            TLS_CIPHER_Type p_CipherSuite := px_MCX_TLS_CipherSuite) :=
  { /* @status    APPROVED (MCX) */
    certificateInfo := {
      certificate := p_Certificate,
      cipherSuite := p_CipherSuite
    }
  };

  /*
   * @desc      Create HttpServerInfo for configuration of a HTTP server
   * @param     p_IpAddress
   * @param     p_Portnumber
   * @param     p_DrbInfo
   * @param     p_TLSConfig         (default value: omit)
   * @return    template (value) HttpServerInfo_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_HttpServerInfo(charstring p_IpAddress,
                                 integer p_Portnumber,
                                 template (value) IP_DrbInfo_Type p_DrbInfo,
                                 template (omit) TLSConfig_Type p_TLSConfig := omit) return template (value) HttpServerInfo_Type
  {
    var template (value) IP_AddrInfo_Type v_IP_AddrInfo;
    
    if (f_IpAddressIsIPv4(p_IpAddress)) {
      v_IP_AddrInfo := cs_IPv4Addr(p_IpAddress);
    } else if (f_IpAddressIsIPv6(p_IpAddress)) {
      v_IP_AddrInfo := cs_IPv6Addr(p_IpAddress);
    } else {
      FatalError(__FILE__, __LINE__, "invalid IP Address");
    }
    return cs_HttpServerInfo(v_IP_AddrInfo, p_Portnumber, p_DrbInfo, p_TLSConfig);
  }

  /*
   * @desc      Start HTTP servers: Initial configuration, IdMS auth, IdMS token, HTTP Proxy
   * @param     p_DrbInfo
   * @status    APPROVED (MCX)
   */
  function f_MCX_StartHttpServers(template (value) IP_DrbInfo_Type p_DrbInfo) runs on MCX_HTTP_PTC
  {
    var template (value) HttpServerList_Type v_HttpServerList := {
      fl_MCX_HttpServerInfo(px_MCX_InitialConfigServer_IPAddress, px_MCX_InitialConfigServer_Port, p_DrbInfo),
      fl_MCX_HttpServerInfo(px_MCX_IdMS_auth_IPAddress,           px_MCX_IdMS_auth_Port,           p_DrbInfo, cs_TLSConfig_Certificate(px_MCX_IdMS_auth_Certificate)),
      fl_MCX_HttpServerInfo(px_MCX_IdMS_token_IPAddress,          px_MCX_IdMS_token_Port,          p_DrbInfo, cs_TLSConfig_Certificate(px_MCX_IdMS_token_Certificate)),
      fl_MCX_HttpServerInfo(px_MCX_HTTP_Proxy_IPAddress,          px_MCX_HTTP_Proxy_Port,          p_DrbInfo, cs_TLSConfig_Certificate(px_MCX_HTTP_Proxy_Certificate))
    };
    f_HTTP_Configure(HTTPCTRL, v_HttpServerList);
  }

  /*
   * @desc      UE Authentication and Authorization (36.579-1 clause 5.3.2)
   * @param     p_ServiceType
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_AuthenticationAuthorizationUEConfiguration(MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters;
  
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication(p_ServiceType);                     /* HTTP signalling to bring UE into MCPTT_UE_AUTHENTICATED state -
                                                                                                 36.579-1 Table 5.3.2.3.1-1 MCPTT user authentication  Step 1 - 14 */
    f_MCX_SendCoOrdMsg(IMS, cms_MCX_SecurityParameters(v_SecurityParameters));                /* inform IMS PTC that Step 1 - 14 are done and hand over the SecurityParameters */
    f_MCX_HTTP_ConfigurationGroupManagementSubscription(p_ServiceType, v_SecurityParameters); /* Table 5.3.2.6.1-1: Step 5 - 10 (Configuration management) and
                                                                                                 Table 5.3.2.7.1-1: Step 5 - 6 (Group management) */
    f_MCX_SendTrigger(IMS);

    return v_SecurityParameters;
  }

  /*
   * @desc      Common preamble for MCPTT test cases
   * @param     p_ServiceType
   * @param     p_InitState         (default value: REGISTERED_AUTHORIZED)
   * @status    APPROVED (MCX)
   */
  function f_MCX_Preamble_HTTP(MCX_ServiceType_Type p_ServiceType,
                               MCX_InitState_Type p_InitState := REGISTERED_AUTHORIZED) runs on MCX_HTTP_PTC
  {
    var MCX_Coordination_MSG v_MCX_Coordination_MSG;
    
    f_MCX_HTTP_Init();                                                                          /* Init MCX_HTTP_PTC */

    v_MCX_Coordination_MSG := f_MCX_WaitForCoOrdMsg(IMS, cmr_MCX_DrbInfo);                      /* Get DrbInfo from IMS */

    f_MCX_StartHttpServers(v_MCX_Coordination_MSG.DrbInfo);                                     /* Start HTTP servers */
    
    f_MCX_SendTrigger(IMS);                                                                     /* send trigger to tell IMS that the HTTP servers are started (before UE is switched on or the MCX App is started) */
    
    if (p_InitState != REGISTERED_ONLY) {
      f_MCX_HTTP_AuthenticationAuthorizationUEConfiguration(p_ServiceType);
    }
  }

  /*
   * @desc      Common postamble for HTTP
   * @status    APPROVED (MCX)
   */
  function f_MCX_Postamble_HTTP() runs on MCX_HTTP_PTC
  {
    f_MCX_WaitForTrigger(IMS);
  }

  /*
   * @desc      Default handler for test cases which do not need specific handling of HTTP
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_DefaultHandler() runs on MCX_HTTP_PTC
  {
    var charstring v_TestcaseName := testcasename();
    var charstring v_ServiceTypeString := regexp(v_TestcaseName, "TC_*_(MC*)", 0);
    var MCX_ServiceType_Type v_ServiceType;

    select (v_ServiceTypeString) {
      case ("MCPTT")   { v_ServiceType := MCPTT; }
      case ("MCVideo") { v_ServiceType := MCVideo; }
      case ("MCData")  { v_ServiceType := MCData; }
      case else        { FatalError(__FILE__, __LINE__, "invalid test case name"); }
    }

    f_MCX_Preamble_HTTP(v_ServiceType);
    f_MCX_Postamble_HTTP();
  }

}
