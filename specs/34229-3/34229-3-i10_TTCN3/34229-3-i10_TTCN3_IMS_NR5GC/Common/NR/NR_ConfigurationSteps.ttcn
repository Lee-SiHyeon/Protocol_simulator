module NR_ConfigurationSteps {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_DCI_Configuration all;
  import from NR_NTN_Configuration all;
  import from NR_Parameters all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;
  import from TestcaseProperties all;

  type record NR_CellPower_Type {                               /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    NR_CellId_Type CellId,
    NR_AbsoluteCellPower_Type NewPowerLevel_Conducted,
    NR_AbsoluteCellPower_Type NewPowerLevel_OTA
  };

  type record of NR_CellPower_Type NR_CellPowerList_Type;       /* used together with f_NR_SetCellPowerList
                                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_RedundancyVersion_Type tsc_NR_RedundancyVersionSIB1 := 0; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_CellPower_Type cs_NR_CellPower(NR_CellId_Type p_NR_CellId,
                                                     NR_AbsoluteCellPower_Type p_NewPowerLevel_Conducted,
                                                     NR_AbsoluteCellPower_Type p_NewPowerLevel_OTA) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    CellId := p_NR_CellId,
    NewPowerLevel_Conducted := p_NewPowerLevel_Conducted,
    NewPowerLevel_OTA := p_NewPowerLevel_OTA
  };

  template (value) NR_BcchToPdschConfig_Type cs_NR_BcchToPdschConfigDef(template (value) NR_Sib1Schedul_Type p_NR_Sib1Schedul,
                                                                        template (omit) NR_AllOtherSiSchedul_Type p_NR_AllOtherSiSchedul := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Sib1Schedul := p_NR_Sib1Schedul,
    SiSchedul   := p_NR_AllOtherSiSchedul
  };

  template (value) NR_Sib1Schedul_Type cs_NR_Sib1Schedul(NR_PhysicalParameters_Type p_NR_PhysicalParameters,
                                                         integer p_SIB1_Offset) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-233776: added p_SIB1_Offset sic@
    SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType0(p_NR_PhysicalParameters, tsc_NR_RedundancyVersionSIB1),
    Periodicity := 20,                                               /* @sic R5w190120 sic@ */
    SlotOffsetList := { p_SIB1_Offset }                              /* @sic R5w190120 sic@ */
  };

  /*
   * @desc      To PER encode and DL CCCH ASN.1 type message
   * @param     p_CCCH_Message
   * @return    octetstring
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RRC_DL_CCCH_Encvalue(template (value) DL_CCCH_Message p_CCCH_Message) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_CCCH_Message);
    var octetstring v_Octetstring := bit2oct(f_OctetAlignedBitString(v_Bitstring));
    return v_Octetstring;
  }

  /*
   * @desc      Initialise BcchToPdschConfig depending on the sysinfo combination of the cell
   *            p_BroadcastAllSI = TRUE implies All SI are broadcasted even if their status is set to notBroadcasting
   * @param     p_NR_CellId
   * @param     p_BroadcastAllSI    (default value: false)
   * @return    template (omit) NR_BcchToPdschConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitialiseBcchToPdschConfig(NR_CellId_Type p_NR_CellId,
                                            boolean p_BroadcastAllSI := false
                                           ) runs on NR_BASE_PTC return template (omit) NR_BcchToPdschConfig_Type
  {
    var template (omit) NR_BcchToPdschConfig_Type v_NR_BcchToPdschConfig := omit;
    var  NR_CellSysInfo_Type v_NR_CellSysInfo := f_NR_CellInfo_GetSysinfo(p_NR_CellId);
    var template (value) NR_Sib1Schedul_Type v_NR_Sib1Schedul;
    var template (omit) NR_AllOtherSiSchedul_Type v_NR_AllOtherSiSchedul := omit;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var integer v_SIB1_SlotOffset := f_NR_GetSIB1_SlotOffset(p_NR_CellId);   //@sic R5-237429 sic@

    if (v_NR_CellSysInfo.NR_SysinfoCombination != MibOnly){ //At least SIB1 is broadcasted
      v_NR_Sib1Schedul := cs_NR_Sib1Schedul(v_NR_PhysicalParameters, v_SIB1_SlotOffset);   /* @sic R5w190120 sic@ */
      v_NR_AllOtherSiSchedul := fl_NR_InitialiseSiScheduling(p_NR_CellId, p_BroadcastAllSI);
      v_NR_BcchToPdschConfig := cs_NR_BcchToPdschConfigDef(v_NR_Sib1Schedul, v_NR_AllOtherSiSchedul);
    }
    return v_NR_BcchToPdschConfig;
  }

  /*
   * @desc      Initialise SI scheduling configuration type from SI scheduling included in SIB1
   *            p_BroadcastAllSI = TRUE implies All SI are broadcasted even if their status is set to notBroadcasting
   * @param     p_NR_CellId
   * @param     p_BroadcastAllSI    (default value: false)
   * @return    template (omit) NR_AllOtherSiSchedul_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitialiseSiScheduling(NR_CellId_Type p_NR_CellId,
                                        boolean p_BroadcastAllSI := false) runs on NR_BASE_PTC return template (omit) NR_AllOtherSiSchedul_Type
  {
    var template (omit) NR_AllOtherSiSchedul_Type v_AllOtherSiSchedul := omit;
    var  NR_CellSysInfo_Type v_NR_CellSysInfo := f_NR_CellInfo_GetSysinfo(p_NR_CellId);
    var SI_SchedulingInfo.si_WindowLength v_SiWindowLength;
    var integer v_NoOfSIs;
    var integer v_BroadcastIndex;
    var integer i;
    var template (omit) NR_OtherSiSchedulList_Type v_SiSchedulList := omit;  //@sic R5s210361 sic@
    var template (omit) NR_OtherSiSchedulList_Type v_SegmentedSiSchedulList := omit;
    var template (omit) PosSiSchedulInfo_Type v_PosSiSchedulInfo := omit;
    var SI_SchedulingInfo v_SI_SchedulingInfo;
    var template (omit) SI_SchedulingInfo_v1700 v_SI_SchedulingInfo_v1700;     //@sic R5-233379 sic@
    var integer v_NoOfSIsSegmented;
    var NR_RedundancyVersion_Type v_RV := 0;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var integer v_SegmentedSiPosistionInSIB1;
    var integer v_LengthofSchedulingInfoList;     //@sic R5-233379 sic@
    var integer j :=0;                            //@sic R5-233379 sic@
    var boolean v_SI_Brodacasted:= true;          //@sic R5-233379 sic@
    var integer v_SI_SlotOffset := f_NR_GetSI_SlotOffset(p_NR_CellId);

    select (v_NR_CellSysInfo.NR_SysinfoCombination) {
      case (MibOnly, NR_1) {} //do nothing - no SI
      case else {             //Include SI and/or Segmented SI
        v_SI_SchedulingInfo := f_NR_GetSIB1_SiSchedulingInfo(p_NR_CellId);
        v_SiWindowLength := v_SI_SchedulingInfo.si_WindowLength;
        v_BroadcastIndex := 0;
        v_SI_SchedulingInfo_v1700 := f_NR_GetSIB1_SiSchedulingInfo_v1700(p_NR_CellId);

        if (isvalue(v_NR_CellSysInfo.BcchInfo.SIs)) {           // SI included in the NR sysinfo combination @sic R5s210361 sic@
            v_NoOfSIs := lengthof(v_NR_CellSysInfo.BcchInfo.SIs);
            v_LengthofSchedulingInfoList := lengthof(v_SI_SchedulingInfo.schedulingInfoList);

            for (i := 0; i < v_NoOfSIs; i:=i+1) {
                if ( i < v_LengthofSchedulingInfoList) { //@sic R5-233379 sic@
                    if (v_SI_SchedulingInfo.schedulingInfoList[i].si_BroadcastStatus== broadcasting) {
                        v_SI_Brodacasted := true;
                    } else {
                        v_SI_Brodacasted := false;
                    }
                } else { //SI added in the SI-SchedulingInfo-v1700
                    for (j:=0; j<lengthof(v_SI_SchedulingInfo_v1700.schedulingInfoList2_r17); j:=j+1) {
                        if (valueof(v_SI_SchedulingInfo_v1700.schedulingInfoList2_r17[j].si_WindowPosition_r17) == i+1 ) {
                            //@sic R5s240053 sic@
                            //Check against i+1 because si_WindowPosition_r17 defined from 1 (si-WindowPosition-r17 INTEGER (1..256)) and j defined from 0
                            v_SiSchedulList[v_BroadcastIndex].Periodicity := fl_ConvertSiPeriodicity(valueof(v_SI_SchedulingInfo_v1700.schedulingInfoList2_r17[j].si_Periodicity_r17));
                            if (valueof(v_SI_SchedulingInfo_v1700.schedulingInfoList2_r17[j].si_BroadcastStatus_r17) == broadcasting) {
                                v_SI_Brodacasted := true;
                            } else {
                                v_SI_Brodacasted := false;
                            }
                        }
                    }
                }
                if (v_SI_Brodacasted or p_BroadcastAllSI) {  //@sic R5-201006 sic@
                    if ( i < v_LengthofSchedulingInfoList) { //@sic R5s240053 sic@
                        v_SiSchedulList[v_BroadcastIndex].Periodicity := v_SI_SchedulingInfo.schedulingInfoList[i].si_Periodicity;  //@sic R5s230496 sic@
                    }
                    //@sic R5-237429 sic@
                    v_SiSchedulList[v_BroadcastIndex].Window[0].SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType0A(v_NR_PhysicalParameters, v_RV); //Only one repetition within the SI-window
                    v_SiSchedulList[v_BroadcastIndex].Window[0].SlotOffset := v_SI_SlotOffset;
                    v_BroadcastIndex := v_BroadcastIndex + 1; //@sic R5-201006 sic@
                }
              }
        }
        if(isvalue(v_NR_CellSysInfo.BcchInfo.SegmentedSIs)){ //@sic R5s190425 sic@
            v_NoOfSIsSegmented := lengthof(v_NR_CellSysInfo.BcchInfo.SegmentedSIs);
            for (i := 0; i < v_NoOfSIsSegmented; i:=i+1) {
                v_SegmentedSiPosistionInSIB1 := i + v_BroadcastIndex;
                v_SegmentedSiSchedulList[i].Periodicity :=  v_SI_SchedulingInfo.schedulingInfoList[v_SegmentedSiPosistionInSIB1].si_Periodicity;
                //@sic R5-237429 sic@
                v_SegmentedSiSchedulList[i].Window[0].SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType0A(v_NR_PhysicalParameters, v_RV);
                v_SegmentedSiSchedulList[i].Window[0].SlotOffset := v_SI_SlotOffset;
            }
        }
        if(isvalue(v_NR_CellSysInfo.BcchInfo.PosSIs)){ //@sic R5-222377 sic@
            // p_BroadcastAllSI not handled inside the function fl_InitSS_PosSI_Scheduling as it is not needed so far: in all PosSI test case all posSIs are broadcasted
            v_PosSiSchedulInfo := fl_InitSS_PosSI_Scheduling(p_NR_CellId);
        }
        v_AllOtherSiSchedul := cs_NR_SiSchedulList_Def(v_SiWindowLength, v_SiSchedulList, v_SegmentedSiSchedulList, v_PosSiSchedulInfo);
      }
    }
    return v_AllOtherSiSchedul;
  }

  /*
   * @desc      Convert si-Periodicity-r17 to si-periodicity type in SI-Scheduling
   * @param     p_SiPeriodicity
   * @return    NR_SiPeriodicity_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_ConvertSiPeriodicity (NR_SiPeriodicity_r17_Type p_SiPeriodicity) return NR_SiPeriodicity_Type
  {
    var NR_SiPeriodicity_Type v_SiPeriodicity;
    select (p_SiPeriodicity) {
        case (rf8) { v_SiPeriodicity := rf8;}
        case (rf16) { v_SiPeriodicity := rf16;}
        case (rf32) { v_SiPeriodicity := rf32;}
        case (rf64) { v_SiPeriodicity := rf64;}
        case (rf128) { v_SiPeriodicity := rf128;}
        case (rf256) { v_SiPeriodicity := rf256;}
        case (rf512) { v_SiPeriodicity := rf512;}
        case else { FatalError(__FILE__, __LINE__, "Invalid Si-Periodicity Value"); }
    }
    return v_SiPeriodicity;
  }

  /*
   * @desc      Initialise posSI scheduling configuration type from SI scheduling included in SIB1
   *            p_BroadcastAllSI not handled inside the function fl_InitSS_PosSI_Scheduling as it is not needed so far: in all PosSI test case all posSIs are broadcasted
   * @param     p_NR_CellId
   * @return    template (value) PosSiSchedulInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_InitSS_PosSI_Scheduling(NR_CellId_Type p_NR_CellId
                                      ) runs on NR_BASE_PTC return template (value) PosSiSchedulInfo_Type
  { //@sic R5-222377 sic@
    var template (value) PosSiSchedulInfo_Type v_PosSiSchedulInfo;
    var PosSI_SchedulingInfo_r16 v_SIB1_PosSI_SchedulingInfo;
    var  NR_CellSysInfo_Type v_NR_CellSysInfo := f_NR_CellInfo_GetSysinfo(p_NR_CellId);
    var integer i := 0;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var NR_RedundancyVersion_Type v_RV := 0;
    var integer v_SI_SlotOffset := f_NR_GetSI_SlotOffset(p_NR_CellId); //SI offset acc to 38.523-3 Table 7.3.3.2-1A

    v_SIB1_PosSI_SchedulingInfo := f_NR_GetSIB1_PosSiSchedulingInfo(p_NR_CellId);
    if (not(isvalue(v_SIB1_PosSI_SchedulingInfo.posSchedulingInfoList_r16[0].offsetToSI_Used_r16 ))) {
        //Use the SI window scheduling for posSIB as for SI
        //Acc to 38.331 the same value is used for all SI i.e. same scheduling in the window for all PosSI
        v_PosSiSchedulInfo.OffsetToSI_Used := false;
        for (i := 0; i < lengthof(v_NR_CellSysInfo.BcchInfo.PosSIs); i:=i+1) {
            v_PosSiSchedulInfo.PosSiList[i].PosSI_Periodicity := v_SIB1_PosSI_SchedulingInfo.posSchedulingInfoList_r16[i].posSI_Periodicity_r16;
        }
    } else {
        //offsetToSI_Used_r16 true @sic R5-223933 sic@
        v_PosSiSchedulInfo.OffsetToSI_Used := true;
        for (i := 0; i < lengthof(v_NR_CellSysInfo.BcchInfo.PosSIs); i:=i+1) {
            v_PosSiSchedulInfo.PosSiList[i].PosSI_Periodicity := v_SIB1_PosSI_SchedulingInfo.posSchedulingInfoList_r16[i].posSI_Periodicity_r16;

        }
    }
    for (i := 0; i < lengthof(v_NR_CellSysInfo.BcchInfo.PosSIs); i:=i+1) {
        v_PosSiSchedulInfo.PosSiList[i].PosSI_Periodicity := v_SIB1_PosSI_SchedulingInfo.posSchedulingInfoList_r16[i].posSI_Periodicity_r16;
        v_PosSiSchedulInfo.PosSiList[i].Window[0].SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType0A(v_NR_PhysicalParameters, v_RV);
        v_PosSiSchedulInfo.PosSiList[i].Window[0].SlotOffset := v_SI_SlotOffset;
    }

    return v_PosSiSchedulInfo;
  }

  /*
   * @desc      Return SIB1 Slot offset acc to TS 38.523-3 cl 7.3.3.2
   *            SIB1 is broadcasted in slot#1 in frames with even SFN in cells configured with SSB#0 and in slot#2 in frames with even SFN in cells configured with SSB#1
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB1_SlotOffset(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var integer v_SIB1_SlotOffset;
    var integer v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);
    select (v_SSB_Index) {
        case(0) { v_SIB1_SlotOffset := 1; }
        case(1) { v_SIB1_SlotOffset := 2; }
        case else { FatalError(__FILE__, __LINE__, "Wrong SSB index") }
    }
    return v_SIB1_SlotOffset;
  }

  /*
   * @desc      Return SI Slot offset acc to TS 38.523-3 Table 7.3.3.2-1A
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSI_SlotOffset(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var integer v_SI_SlotOffset;
    var integer v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);
    select (v_SSB_Index) {
        case(0) { v_SI_SlotOffset := 5; }
        case(1) { v_SI_SlotOffset := 6; }
        case else { FatalError(__FILE__, __LINE__, "Wrong SSB index") }
    }
    return v_SI_SlotOffset;
  }

  /*
   * @desc      function to retrieve PCCH configuration
   * @param     p_NR_CellId
   * @return    template (omit) NR_PcchConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitialisePcchConfig(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) NR_PcchConfig_Type
  {
    var template (omit) NR_PcchConfig_Type v_PcchConfig := omit;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters;

    if (not f_GetTestcaseAttrib_ENDC(testcasename())) {
      v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
      v_PcchConfig.SearchSpaceAndDci := cs_NR_SearchSpaceDlDciAssignment_CSSType2(v_NR_PhysicalParameters);
    }
    return v_PcchConfig;
  }

  /*
   * @desc      return true when for the current test case DL CCCH messages shall not be sent with the preconfigured RACH procedure but shall be sent autonomously from TTCN
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_EarlyContentionResolution() return boolean
  {
    var charstring v_TestcaseName := testcasename();
    return f_GetTestcaseAttrib_EarlyContentionResolution(v_TestcaseName);
  }

  /*
   * @desc      Get Default ServingCellConfig according to 38.508-1 Table 4.6.3-19 to be sent in RRC Reconfiguration message
   * @param     p_NR_CellId
   * @return    template (value) ServingCellConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetServingCellConfig (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) ServingCellConfig
  { //@sic R5-202561 R5s230533 sic@
    var template (value) ServingCellConfig v_ServingCellConfig;
    var template (value) BWP_DownlinkDedicated v_BWP_DownlinkDedicated;
    var template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type v_RadioLinkMonitoringConfig := f_NR_CellInfo_GetRadioLinkMonitoringConfig(p_NR_CellId); //@sic R5s190244 sic@
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, tsc_NR_BWP_Id);
    var SearchSpace v_SearchSpaceUSS := f_NR_CellInfo_GetSearchSpaceConfigAtUE(p_NR_CellId, tsc_NR_SearchSpaceId_USS, tsc_NR_BWP_Id);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_NR_CellId, tsc_NR_BWP_Id);
    var template (omit) PDCCH_Config.controlResourceSetToAddModList v_ControlResourceSetToAddModList := f_NR_GetPDCCH_ConfigControlResourceSet(p_NR_CellId);
    var template (omit) ServingCellConfig.channelAccessConfig_r16 v_ChannelAccessConfig := omit;    // SharedSpectrum @sic R5-242772 sic@

    // SharedSpectrum @sic R5-242772 sic@
    if (f_NR_CellInfo_GetIsSharedSpectrum(p_NR_CellId)) {
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_ChannelAccessConfig := cs_ChannelAccessConfig(omit); // semiStatic case
      }
      else if (pc_ul_DynamicChAccess_r16){ //@sic R5-244792 sic@
        v_ChannelAccessConfig := cs_ChannelAccessConfig(-85); // dynamic case
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
    }

    v_BWP_DownlinkDedicated := cs_38508_BWP_DownlinkDedicated(cs_38508_PDCCH_Config (v_SearchSpaceUSS, -, v_ControlResourceSetToAddModList),
                                                              v_NR_DownlinkBWP.Pdsch.ConfigDedicated.R15,
                                                              -,
                                                              v_RadioLinkMonitoringConfig); //@sic R5s190244 sic@
    v_ServingCellConfig := cs_38508_ServingCellConfig(v_BWP_DownlinkDedicated,
                                                      0,
                                                      cs_38508_UplinkConfig(v_NR_UplinkBWP.Dedicated.R15,
                                                                            cs_38508_PUSCH_ServingCellConfig),
                                                      cs_38508_PDCCH_ServingCellConfig,
                                                      cs_38508_PDSCH_ServingCellConfig,
                                                      v_ChannelAccessConfig); // SharedSpectrum @sic R5-242772 sic@
    return v_ServingCellConfig;
  }

  /*
   * @desc      Get Default SCGConfig according to 38.508-1 Table 4.6.3-19 to be sent in RRCReconfiguration message
   * @param     p_NR_CellId
   * @param     p_ServingCellConfig (default value: omit)
   * @param     p_ENDC_SpecificCell (default value: false)
   * @return    template (value) SpCellConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSpCellConfigDef(NR_CellId_Type p_NR_CellId,
                                   template (omit) ServingCellConfig p_ServingCellConfig := omit,
                                   boolean  p_ENDC_SpecificCell := false
                                   ) runs on NR_BASE_PTC return template (value) SpCellConfig
  { //@sic R5-202561 R5-201320 sic@
    var template (omit) ServingCellConfig v_ServingCellConfig;
    var template (omit) ServCellIndex v_ServCellIndex;
    var template (omit) ReconfigurationWithSync v_ReconfigurationWithSync;
    var template (value) ServingCellConfigCommon v_ServingCellConfigCommon := f_NR_GetServingCellConfigCommon(p_NR_CellId);
    var template (value) RLF_TimersAndConstants v_RLF_TimersAndConstants := f_NR_CellInfo_GetRLF_TimersAndConstants(p_NR_CellId);

    if (f_GetTestcaseAttrib_ENDC(testcasename()) or p_ENDC_SpecificCell ) {
      v_ServCellIndex := f_NR_ServCellIndex(p_ENDC_SpecificCell);   // @sic R5-192274 R5s220981 sic@
      v_ReconfigurationWithSync := cs_38508_ReconfigurationWithSync(v_ServingCellConfigCommon, f_NR_CellInfo_GetRNTI(p_NR_CellId));
      //spCellConfigDedicated included for EN-DC
      v_ServingCellConfig := f_NR_GetServingCellConfig(p_NR_CellId);
    } else {
      v_ServCellIndex := omit;
      v_ReconfigurationWithSync := omit;
      //spCellConfigDedicated included for condition SRB1 => value to be used in RRCSetup function
      v_ServingCellConfig := p_ServingCellConfig;
    }
    return cs_38508_SpCellConfig(v_ServCellIndex, v_ReconfigurationWithSync, v_ServingCellConfig, v_RLF_TimersAndConstants);
  }

 /*
  * @desc      Get Default controlResourceSetToAddModList according to 38.508-1 Table 4.6.3-95: PDCCH-Config
   * @param     p_NR_CellId
   * @return    template (omit) PDCCH_Config.controlResourceSetToAddModList
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetPDCCH_ConfigControlResourceSet(NR_CellId_Type p_NR_CellId)  runs on NR_BASE_PTC return template (omit) PDCCH_Config.controlResourceSetToAddModList
  {
    var template (omit) PDCCH_Config.controlResourceSetToAddModList v_ControlResourceSetToAddModList;
    var template (value) ControlResourceSet v_ControlResourceSet;

    if (f_GetTestcaseAttrib_ENDC(testcasename())) {
        v_ControlResourceSetToAddModList := omit;
    } else {
        v_ControlResourceSet := f_NR_CellInfo_GetControlResourceSet(p_NR_CellId, tsc_NR_ControlResourceSetId, tsc_NR_BWP_Id);
        v_ControlResourceSetToAddModList := {v_ControlResourceSet};
    }
    return v_ControlResourceSetToAddModList;
  }

    /*
   * @desc      Get Default ServingCellConfigCommon according to 38.508-1 Table 4.6.3-19 to be sent in RRC Reconfiguration message
   * @param     p_NR_CellId
   * @return    template (value) ServingCellConfigCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_GetServingCellConfigCommon (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) ServingCellConfigCommon
  {
    var template (value) ServingCellConfigCommon v_ServingCellConfigCommon;
    var PhysCellId v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(p_NR_CellId);
    var FrequencyInfoDL v_FrequencyInfoDL := f_NR_CellInfo_GetFrequencyInfoDL(p_NR_CellId);
    var FrequencyInfoUL v_FrequencyInfoUL := f_NR_CellInfo_GetFrequencyInfoUL(p_NR_CellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_NR_CellId, tsc_NR_BWP_Id);
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, tsc_NR_BWP_Id);
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon:= f_NR_RetrieveBWP_DownlinkCommon(v_NR_DownlinkBWP, f_NR_CellInfo_GetCoreset0_Index(p_NR_CellId));
    var ServingCellConfigCommon.ssb_PositionsInBurst v_Ssb_PositionsInBurst := f_NR_CellInfo_GetSSB_BurstConfig(p_NR_CellId);
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var template (omit) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon := f_NR_CellInfo_GetTDD_UL_DL_ConfigCommon(p_NR_CellId);
    var template (omit) ServingCellConfigCommon.channelAccessMode_r16 v_ChannelAccessMode_r16 := omit;
    var template (omit) SSB_PositionQCL_Relation_r16 v_SSB_PositionQCL_Relation := omit;

    //@sic R5-240531, R5w240005 sic@ - SharedSpectrum condition
    if (f_NR_CellInfo_GetIsSharedSpectrum(p_NR_CellId)) {
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_SemiStatic; // @sic R5-242772 sic@
      }
      else if (pc_ul_DynamicChAccess_r16){
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_Dynamic;  // @sic R5-242772 sic@
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
      v_SSB_PositionQCL_Relation := n1;  //Table 4.6.3-186A: SSB-PositionQCL-Relation
    }
    v_ServingCellConfigCommon := cs_38508_ServingCellConfigCommon(v_PhysCellId,
                                                                  cs_38508_DownlinkConfigCommon(v_FrequencyInfoDL,v_BWP_DownlinkCommon),
                                                                  cs_38508_UplinkConfigCommon(v_FrequencyInfoUL, v_NR_UplinkBWP.Common.R15),
                                                                  v_Ssb_PositionsInBurst,
                                                                  v_SubcarrierSpacing,
                                                                  v_TDD_UL_DL_ConfigCommon,
                                                                  v_ChannelAccessMode_r16,
                                                                  v_SSB_PositionQCL_Relation );
    return v_ServingCellConfigCommon;
  }

  /*
   * @desc      function to build up the RRC setup depending on the cell configuration
   *            Default RRCsetup contents as per 38.508-1 Table 4.6.1-4F: RRCSetup
   * @param     p_NR_CellId
   * @param     p_RRC_TI            (default value: tsc_NR_RRC_TI_Def)
   * @param     p_SpCellConfig      (default value: omit)
   * @return    template (value) DL_CCCH_Message
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_38508_RRCSetup(NR_CellId_Type p_NR_CellId,
                               RRC_TransactionIdentifier p_RRC_TI := tsc_NR_RRC_TI_Def,
                               template (omit) SpCellConfig p_SpCellConfig := omit
                               ) runs on NR_BASE_PTC return template (value) DL_CCCH_Message
  {
    var template (value) SRB_ToAddModList v_SRB_ToAddModList := {cs_NR_SRB_ToAddMod(tsc_SRB1)};
    var template (value) RadioBearerConfig v_RadioBearerConfig := cs_38508_RadioBearerConfigDef(v_SRB_ToAddModList); //RadioBearerConfig with condition SRB1 @sic R5-191384 sic@
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_NR_CellId);
    var template (value) PhysicalCellGroupConfig v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(p_NR_CellId);
    var template (value) SpCellConfig v_SpCellConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) ServingCellConfig v_ServingCellConfig;   //@sic R5-202461 sic@

    if (isvalue(p_SpCellConfig)) {
        v_SpCellConfig := p_SpCellConfig; //compiler warning may be ignored due to isvalue check
    } else {
        v_ServingCellConfig := f_NR_GetServingCellConfig(p_NR_CellId);
        v_SpCellConfig := f_NR_GetSpCellConfigDef(p_NR_CellId, v_ServingCellConfig);
    }
    v_CellGroupConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_MCG, //@sic R5-190261 sic@
                                                  {cs_38508_RLC_BearerConfig_SRB(tsc_SRB1)}, //@sic R5-190360 sic@
                                                  -,
                                                  v_MAC_CellGroupConfig,
                                                  v_PhysicalCellGroupConfig,
                                                  v_SpCellConfig);
    return cs_38508_RRCSetup(p_RRC_TI, v_RadioBearerConfig, v_CellGroupConfig);
  }

  /*
   * @desc      function to return RACH configuration depending on the cell
   * @param     p_NR_CellId
   * @param     p_NRDC_SCG_Cell     (default value: false)
   * @param     p_IsSharedSpectrum  (default value: false)
   * @return    template NR_RachProcedureConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitialiseRachProcedure(NR_CellId_Type p_NR_CellId,
                                        boolean p_NRDC_SCG_Cell := false,
                                        boolean p_IsSharedSpectrum := false
                                        ) runs on NR_BASE_PTC return template (value) NR_RachProcedureConfig_Type
  { //@sic R5s211248: added p_NRDC_SCG_Cell sic@
    var template (value) NR_RachProcedureConfig_Type v_NR_RachProcedure;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    var template (value) DL_CCCH_Message v_RrcSetup;
    var template (value) NR_RachProcedureMsg4RrcMsg_Type v_RachProcedureMsg4RrcMsg;
    var octetstring v_EncodedRrcSetup;

    if (f_GetTestcaseAttrib_ENDC(testcasename()) or p_NRDC_SCG_Cell) {  //ENDC test case or NRDC PSCell -> C-RNTI based CBRA procedure
        if( not (f_GetTestcaseAttrib_ShortDCI(testcasename()))) {  //@sic R5s210885 sic@
            // As per 38.523-3 Table 7.1.2.3.3-1: Default grants @sic R5-198994 sic@
            v_NR_RachProcedure := cs_NR_RachProcedureConfig_CBRA_CrntiBased(v_NR_PhysicalParameters, -,-, tsc_NR_ENDC_Msg3Grant_Def, -, cs_NR_DciFormat_0_1_Params(-,-, f_NR_InitialiseDciFormat_0_1_ChAccess_CPextCAPC(p_IsSharedSpectrum)), p_IsSharedSpectrum);  /* @sic R5-187672, R5-187748: CBRA instead of CFRA, added parameter for SharedSpectrum condition sic@ */
        } else {
            //For shortDCI test cases - UL USS uses DCI 0_0
            //@sic R5s210885 sic@
            v_NR_RachProcedure := cs_NR_RachProcedureConfig_CBRA_CrntiBased(v_NR_PhysicalParameters,-,-,tsc_NR_ENDC_Msg3Grant_Def, -, cs_NR_DciFormat_0_0_Params(f_NR_InitialiseDciFormat_X_0_ChAccess_CPext(p_IsSharedSpectrum)), p_IsSharedSpectrum); // added parameter for SharedSpectrum condition
        }
    } else {  //NRSA test cases -> Contention Based with RRCSetupRequest in Msg3
      if (not f_NR_EarlyContentionResolution()) {
        v_RrcSetup := f_NR_38508_RRCSetup(p_NR_CellId);
        v_EncodedRrcSetup := f_NR_RRC_DL_CCCH_Encvalue(v_RrcSetup);
        v_RachProcedureMsg4RrcMsg := cs_NR_RachProcedureMsg4WithCcchMsg(v_EncodedRrcSetup);
      } else {
        v_RachProcedureMsg4RrcMsg := cs_NR_RachProcedureMsg4WithNoRrcMsg;
      }
      v_NR_RachProcedure := cs_NR_RachProcedureConfig_CBRA_Msg4Based(v_NR_PhysicalParameters, v_RachProcedureMsg4RrcMsg, -, p_IsSharedSpectrum); // added parameter for SharedSpectrum condition
    }
    return v_NR_RachProcedure;
  }

  /*
   * @desc      Create NR cell and send out system information
   * @param     p_NR_CellId
   * @param     p_CA_CellCapability (default value: None)
   * @param     p_NRDC_SCG_Cell     (default value: false)
   * @param     p_ENDC_SpecificCell (default value: false)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellConfig_Def(NR_CellId_Type p_NR_CellId,
                               template (omit) NR_CellCA_Capability_Type p_CA_CellCapability := None,
                               boolean p_NRDC_SCG_Cell := false,
                               boolean p_ENDC_SpecificCell := false   //Set to true ONLY for a cell to be configured as ENDC in an NR5GC test environment
                               ) runs on NR_BASE_PTC
  {
    // @sic R5s200038: set default value of p_CA_CellCapability to None sic@
    // @sic R5s210891: added p_NRDC_SCG_Cell sic@
    // @sic R5s220853: added p_ENDC_SpecificCell sic@
    // @sic R5w230105r1: modified code to init NTN parameters sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var template (omit) NR_CellConfigPhysicalLayerDownlink_Type v_NR_CellConfigPhysicalLayerDownlink := cs_NR_CellConfigPhysicalLayerDownlink(v_NR_CellInfo);
    var template (omit) NR_CellConfigPhysicalLayerUplink_Type v_NR_CellConfigPhysicalLayerUplink := omit;
    var template (omit) NR_BcchToPdschConfig_Type v_NR_BcchToPdschConfig := f_NR_InitialiseBcchToPdschConfig(p_NR_CellId);
    var template (omit) NR_PcchConfig_Type v_NR_PcchConfig := f_NR_InitialisePcchConfig(p_NR_CellId);
    var template (omit) NR_RachProcedureConfig_Type v_NR_RachProcedure;
    var template (value) NR_SYSTEM_CTRL_REQ v_NR_CellConfigReq;
    var NTN_Satellite_Type v_NTN_Scenario := f_NR_MobileInfo_GetNTNSatelliteType();
    var boolean v_IsSharedSpectrum := false; // SharedSpectrum

    // SharedSpectrum condition
    if (f_NR_CellInfo_GetIsSharedSpectrum(p_NR_CellId)) {
      v_IsSharedSpectrum := true;
    }

    // Function to start UL grant allocation and PUCCH synchronisation
      if (not(f_NR_IsUL_FrequencyAvailable(p_NR_CellId))) {  //SDL or SCell with no UL @sic R5-226041 sic@
        v_NR_CellConfigPhysicalLayerUplink := omit;
        v_NR_RachProcedure := omit
    } else {
        v_NR_CellConfigPhysicalLayerUplink := cs_NR_CellConfigPhysicalLayerUplink(v_NR_CellInfo);
        v_NR_RachProcedure := f_NR_InitialiseRachProcedure(p_NR_CellId, p_NRDC_SCG_Cell, v_IsSharedSpectrum); // SharedSpectrum
    }
    if (not(f_NR_IsUL_FrequencyAvailable(p_NR_CellId))) {  //SDL or Scell with no UL @sic R5-226041 sic@
       v_NR_CellConfigReq := cads_NR_CellConfigNoUL_REQ(p_NR_CellId,
                                                        v_NR_CellInfo,
                                                        cs_TimingInfo_Now,
                                                        v_NR_CellConfigPhysicalLayerDownlink,
                                                        v_NR_CellConfigPhysicalLayerUplink,
                                                        v_NR_BcchToPdschConfig,
                                                        v_NR_PcchConfig,
                                                        v_NR_RachProcedure,
                                                        p_CA_CellCapability);
    } else {
        v_NR_CellConfigReq := cas_NR_CellConfig_REQ(p_NR_CellId,
                                                    v_NR_CellInfo,
                                                    cs_TimingInfo_Now,
                                                    v_NR_CellConfigPhysicalLayerDownlink,
                                                    v_NR_CellConfigPhysicalLayerUplink,
                                                    v_NR_BcchToPdschConfig,
                                                    v_NR_PcchConfig,
                                                    v_NR_RachProcedure,
                                                    p_CA_CellCapability,
                                                    v_IsSharedSpectrum);// SharedSpectrum
    }
    if(v_NTN_Scenario == ntn_GSO)
    {
        v_NR_CellConfigReq.Request.Cell.AddOrReconfigure.PhysicalLayer.Uplink.TimingAdvance.NtnTA := cs_NR_NTN_TimingAdvanceConfig_GSO_Array[v_NR_CellInfo.Sysinfo.NtnInfo.NtnCellType -1];
        v_NR_CellConfigReq.Request.Cell.AddOrReconfigure.NtnConfig := cs_NTN_Config_GSO; //default values acc 38.508-1 Table 4.6.3-84C
    }
    else if (v_NTN_Scenario == ntn_NGSO)
    {//@sic R5w240203 sic@
        v_NR_CellConfigReq.Request.Cell.AddOrReconfigure.PhysicalLayer.Uplink.TimingAdvance.NtnTA := cs_NR_NTN_TimingAdvanceConfig_NGSO_Array[v_NR_CellInfo.Sysinfo.NtnInfo.NtnCellType-1];
        v_NR_CellConfigReq.Request.Cell.AddOrReconfigure.NtnConfig := cs_NR_NTN_ConfigList_NGSO[v_NR_CellInfo.Sysinfo.NtnInfo.NtnCellType-1];
    }

    f_NR_SS_CommonCellConfig(p_NR_CellId, v_NR_CellConfigReq);

    if (not f_GetTestcaseAttrib_ENDC(testcasename()) and not(p_ENDC_SpecificCell)) {  //No SRBs configured in EN-DC cells @sic R5s199033 Added CA configuration R5s220853 R5s221087 sic@
      if (match(None, p_CA_CellCapability) or match(SpCell, p_CA_CellCapability)) {  // no CA or CA but SPCell
        if (not p_NRDC_SCG_Cell) {   //@sic R5s210891 sic@
            f_NR_SS_ConfigureSRBs(p_NR_CellId);
        } else { // for NR-DC configure SRB0
            f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, {cs_NR_SS_SRB0_Config});
        }
      }
    }
  }

  /*
   * @desc      Function to configure SRBs in SS
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_ConfigureSRBs(NR_CellId_Type p_NR_CellId,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
    var template (value) NR_RadioBearerList_Type v_SrbList := {
      cs_NR_SS_SRB0_Config,
      cs_NR_SS_SRB1_Config,
      cs_NR_SS_SRB2_Config
    };
    f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_SrbList, p_TimingInfo);
  }

  /*
   * @desc      Function to configure SS: map DcchDtch on CSS with DCI format 1_0
   *            e.g. to send RRCResume
   * @param     p_NR_CellId
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_SS_ReconfigSStoCSS_DCI1_0(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  { //@sic R5s240461 sic@
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);

    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_RachProcedure_DcchDtchToCSS_Config_REQ(p_NR_CellId, cs_TimingInfo_Now, tsc_CnfReq,
                                                                                               -,
                                                                                               cs_NR_SearchSpaceDlDciAssignment_CSSType1(v_NR_PhysicalParameters)
                                                                                               ));
  }

  /*
   * @desc      Function to configure SS: map DcchDtch on USS with DCI format 1_1
   * @param     p_NR_CellId
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_SS_ReconfigSStoUSS_DCI1_1(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  { //@sic R5s240461 sic@
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);

    f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_SearchSpaceDlDciAssignment_REQ(p_NR_CellId, cs_TimingInfo_Now, f_NR_SearchSpaceDlDciAssignment_USS(v_NR_PhysicalParameters), tsc_NoCnfReq, tsc_FollowOnFlag));
  }

  /*
   * @desc      Function used to send an ASP to SS
   * @param     p_NR_CellId
   * @param     p_NR_SYSTEM_CTRL_REQ
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_CommonCellConfig(NR_CellId_Type p_NR_CellId,
                                    template (value) NR_SYSTEM_CTRL_REQ p_NR_SYSTEM_CTRL_REQ) runs on NR_BASE_PTC
  {
    var boolean v_CnfFlag := valueof(p_NR_SYSTEM_CTRL_REQ.Common.ControlInfo.CnfFlag);

    SYS.send(p_NR_SYSTEM_CTRL_REQ);
    if (v_CnfFlag) {
      //@sic R5s201322 sic@
      select union (valueof(p_NR_SYSTEM_CTRL_REQ.Request)) {
        case(Cell) {
            SYS.receive(car_NR_CellConfig_CNF(p_NR_CellId));
        }
        case(MacCommandTrigger){
            SYS.receive(car_NR_MacCommandTrigger_CNF(p_NR_CellId));
        }
      }
    }
  }

  /*
   * @desc      Common function to release all cells
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ReleaseAllCells() runs on NR_BASE_PTC
  {
    var NR_CellId_Type v_NR_CellId := nr_Cell_NonSpecific;
    SYS.send(cas_NR_ReleaseCell_REQ(v_NR_CellId, cs_TimingInfo_Now));
    // No confirmation required
  }

  /*
   * @desc      Radio Bearer configuration
   * @param     p_NR_CellId
   * @param     p_RadioBearerList
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_CommonRadioBearerConfig(NR_CellId_Type p_NR_CellId,
                                           template (value) NR_RadioBearerList_Type p_RadioBearerList,
                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                           template (omit) boolean p_CnfFlag := omit,
                                           boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                           ) runs on NR_BASE_PTC
  { //@sic R5-206369: added p_FollowOnFlag sic@
    var template (value) NR_SYSTEM_CTRL_REQ v_NR_SYSTEM_CTRL_REQ := cas_NR_CommonRadioBearerConfig_REQ(p_NR_CellId, p_TimingInfo, p_RadioBearerList, p_CnfFlag, p_FollowOnFlag);
    var boolean v_CnfFlag := valueof(v_NR_SYSTEM_CTRL_REQ.Common.ControlInfo.CnfFlag);

    SYS.send(v_NR_SYSTEM_CTRL_REQ);
    if (v_CnfFlag == tsc_CnfReq) {
      SYS.receive(car_NR_CommonRadioBearerConfig_CNF(p_NR_CellId));
    }
  }

  /*
   * @desc      Release SRB[0..2] and all given DRBs
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_DrbList
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_SRBs_DRBs_Release(NR_CellId_Type  p_NR_CellId,
                                     template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                     IntegerList_Type p_DrbList,
                                     template (omit) boolean p_CnfFlag := omit,
                                     boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                     ) runs on NR_BASE_PTC
  {
    var template (value) NR_RadioBearerList_Type v_SrbDrbList := {
      cs_NR_SS_RadioBearer_Release(tsc_NR_RbId_SRB1),
      cs_NR_SS_RadioBearer_Release(tsc_NR_RbId_SRB2)
    };
    var integer i := lengthof(v_SrbDrbList);
    var integer k;

    for (k:=0; k < lengthof(p_DrbList); k:= k+1) {
      v_SrbDrbList[i+k] := cs_NR_SS_DRB_Release(p_DrbList[k]);
    }
    f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_SrbDrbList, p_TimingInfo, p_CnfFlag, p_FollowOnFlag);
  }

  /*
   * @desc      Configure SRB[1..2] and given DRBs
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_DrbConfigList
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_SRBs_DRBs_Config(NR_CellId_Type  p_NR_CellId,
                                    template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                    template (omit) NR_RadioBearerList_Type p_DrbConfigList,
                                    template (omit) boolean p_CnfFlag := omit,
                                    boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                    ) runs on NR_BASE_PTC
  { //@sic R5s220176: added p_FollowOnFlag sic@
    var template (value) NR_RadioBearerList_Type v_DrbConfigList;
    var template (value) NR_RadioBearerList_Type v_SrbDrbList := {
      cs_NR_SS_SRB1_Config,
      cs_NR_SS_SRB2_Config
    };
    var integer i := lengthof(v_SrbDrbList);
    var integer k;

    if (ispresent(p_DrbConfigList)) {
      v_DrbConfigList := valueof(p_DrbConfigList);
      for (k:=0; k < lengthof(v_DrbConfigList); k:= k+1) {
        v_SrbDrbList[i+k] := v_DrbConfigList[k];
      }
    }
    f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_SrbDrbList, p_TimingInfo, p_CnfFlag, p_FollowOnFlag);
  }

  /*
   * @desc      calculate new attenuation for a cell based on the previous attenuation and the given absolute cell power;
   *            the attenuation is written back to the global TTCN-3 NR_CellInfo but no configuration is performed at SS
   * @param     p_NR_CellId
   * @param     p_NewPowerLevel   absolute (negative) value as specified in the test prose
   * @return    NR_Attenuation_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_ChangeCellAttenuation(NR_CellId_Type p_NR_CellId,
                                       NR_AbsoluteCellPower_Type p_NewPowerLevel) runs on NR_BASE_PTC return NR_Attenuation_Type
  {
    var NR_ReferenceCellPower_Type v_CurrentCellPower := f_NR_CellInfo_GetCellPower(p_NR_CellId);
    var NR_AbsoluteCellPower_Type v_CurrentRefPowerLevel := v_CurrentCellPower.MaxReferencePower;
    var NR_Attenuation_Type v_Attenuation;
    var integer v_AttenuationValue;

    if (p_NewPowerLevel == tsc_NR_NonSuitableOffCellSSS_EPRE) {
      v_Attenuation.Off := true;
    } else {
      v_AttenuationValue := v_CurrentRefPowerLevel - p_NewPowerLevel;  // v_CurrentRefPowerLevel and p_NewPowerLevel both are negative values

      if (v_AttenuationValue < 0) {  // i.e. |p_NewPowerLevel| < |v_CurrentRefPowerLevel|
        FatalError (__FILE__, __LINE__, "Initial reference power has invalid value");
      } else {
        v_Attenuation.Value := v_AttenuationValue;
      }
    }

    v_CurrentCellPower.Attenuation := v_Attenuation;
    f_NR_CellInfo_SetCellPower(p_NR_CellId, v_CurrentCellPower);

    return v_Attenuation;
  }

  /*
   * @desc      to configure power of several cells in one go
   *            p_NR_CellId shall refer to specific cell when p_TimingInfo is not cs_TimingInfo_Now
   * @param     p_CellPowerList
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_NR_CellId            (default value: nr_Cell_NonSpecific)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SetCellPowerList(template (value) NR_CellPowerList_Type p_CellPowerList,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                 NR_CellId_Type p_NR_CellId := nr_Cell_NonSpecific) runs on NR_BASE_PTC
  {
    var integer i;
    var boolean v_CnfFlag;
    var NR_CellPower_Type v_CellPower;
    var template (value) NR_CellAttenuationList_Type v_CellAttenuationList;
    var NR_TestEnvironment_Type v_NR_TestEnvironment := f_NR_MobileInfo_GetTestEnvironment(); // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@

    v_CnfFlag := f_TimingInfo_IsNow(p_TimingInfo);

    if (v_CnfFlag and (p_NR_CellId != nr_Cell_NonSpecific)) {
      FatalError(__FILE__, __LINE__, "p_NR_CellId shall be nr_Cell_NonSpecific when p_TimingInfo is cs_TimingInfo_Now");
    }
    if (not v_CnfFlag and (p_NR_CellId == nr_Cell_NonSpecific)) {
      FatalError(__FILE__, __LINE__, "p_NR_CellId shall refer to cell related to given p_TimingInfo");
    }

    for (i:=0; i<lengthof(p_CellPowerList); i:=i+1) {
      v_CellPower := valueof(p_CellPowerList[i]);   // valueof cannot be avoided here
      v_CellAttenuationList[i].CellId := v_CellPower.CellId;
      if (v_NR_TestEnvironment == Conducted) {
        v_CellAttenuationList[i].Attenuation := fl_NR_ChangeCellAttenuation(v_CellPower.CellId, v_CellPower.NewPowerLevel_Conducted);
      } else {
        v_CellAttenuationList[i].Attenuation := fl_NR_ChangeCellAttenuation(v_CellPower.CellId, v_CellPower.NewPowerLevel_OTA);
      }

      if (v_CnfFlag) {
        v_CellAttenuationList[i].TimingInfo := omit;
      } else {
        v_CellAttenuationList[i].TimingInfo := f_NR_TimingOtherCell(p_NR_CellId, p_TimingInfo, v_CellPower.CellId);
      }
    }
    SYS.send(cas_NR_CellConfig_Power_REQ(v_CellAttenuationList, p_TimingInfo, p_NR_CellId));
    if (v_CnfFlag) {
      SYS.receive(car_NR_CellConfig_Power_CNF);
    }
  }

  /*
   * @desc      Sets the cell power attenuation and stores the value in the NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_NewPowerLevel_FR1
   * @param     p_NewPowerLevel_FR2
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SetCellPower(NR_CellId_Type p_NR_CellId,
                             NR_AbsoluteCellPower_Type p_NewPowerLevel_FR1,
                             NR_AbsoluteCellPower_Type p_NewPowerLevel_FR2,
                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList:= { cs_NR_CellPower(p_NR_CellId, p_NewPowerLevel_FR1, p_NewPowerLevel_FR2) };
    var NR_CellId_Type v_ReferenceCellId;

    if (f_TimingInfo_IsNow(p_TimingInfo)) {
      v_ReferenceCellId := nr_Cell_NonSpecific;
    } else {
      v_ReferenceCellId := p_NR_CellId;
    }
    f_NR_SetCellPowerList(v_CellPowerList, p_TimingInfo, v_ReferenceCellId);
  }

  /*
   * @desc      Basic function used in various types of explicit UL grant configuration
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_DciUlInfo         (default value: omit)
   * @param     p_PUCCH_Synch       (default value: omit)
   * @param     p_UL_GrantConfig    (default value: omit)
   * @param     p_CnfFlag           (default value: omit)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ULGrantConfiguration_Common(NR_CellId_Type   p_NR_CellId,
                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                            template (omit)  NR_DciUlInfo_Type p_DciUlInfo := omit,
                                            template (omit)  NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch := omit,
                                            template (omit)  UL_GrantConfig_Type p_UL_GrantConfig := omit,
                                            template (omit)  boolean p_CnfFlag := omit
                                            ) runs on NR_BASE_PTC
  { //@sic R5s200161 : added p_CnfFlag sic@
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_ULGrantAllocation_REQ(p_NR_CellId, p_TimingInfo, p_DciUlInfo, p_PUCCH_Synch, p_UL_GrantConfig, -, p_CnfFlag));
  }

  /*
   * @desc      Start UL grant in the cell
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ImcsValue         (default value: tsc_NR_DefaultGrant_Imcs)
   * @param     p_FreqDomainSchedul (default value: cs_NR_FreqDomainSchedulExplicitUL_Def)
   * @param     p_PUCCH_Synch       (default value: cs_NR_UplinkTimeAlignment_Start)
   * @param     p_UL_GrantConfig    (default value: cs_UL_GrantConfig_OnSR)
   * @param     p_HarqProcessConfig (default value: omit)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_TimeDomainResourceAssignment (default value: omit)
   * @param     p_ResourceAllocationType (default value: omit)
   * @param     p_NR_DciFormat_0_X_SpecificInfo (default value: omit)
   * @param     p_UL_SUL_Indicator  (default value: omit)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ULGrantConfiguration_Start(NR_CellId_Type  p_NR_CellId,
                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                           template (value) NR_ImcsValue_Type p_ImcsValue := tsc_NR_DefaultGrant_Imcs,
                                           template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul := cs_NR_FreqDomainSchedulExplicitUL_Def,
                                           template (omit) NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch := cs_NR_UplinkTimeAlignment_Start,
                                           template (omit) UL_GrantConfig_Type p_UL_GrantConfig := cs_UL_GrantConfig_OnSR,
                                           template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit,
                                           template (omit) boolean p_CnfFlag := omit,//@sic R5200634 sic@
                                           template (omit) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment := omit,
                                           template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := omit, //@sic 711313 sic@
                                           template (omit) NR_DciFormat_0_X_SpecificInfo_Type p_NR_DciFormat_0_X_SpecificInfo := omit,
                                           template (omit) NR_DciCommon_UL_SUL_Indicator_Type p_UL_SUL_Indicator := omit
                                           ) runs on NR_BASE_PTC
  { // @sic R5s200161: added p_CnfFlag sic@
    // @sic R5s201036: added p_ResourceAllocationType sic@
    // @sic R5-245503: added p_UL_SUL_Indicator sic@
    var template (value) NR_DciUlInfo_Type v_DciUlInfo := cds_NR_DciUlInfo_ModifyGrant(p_FreqDomainSchedul, p_TimeDomainResourceAssignment, p_ImcsValue, p_HarqProcessConfig, p_ResourceAllocationType,p_NR_DciFormat_0_X_SpecificInfo, p_UL_SUL_Indicator);//@sic R5200634 sic@

    f_NR_ULGrantConfiguration_Common(p_NR_CellId, p_TimingInfo, v_DciUlInfo, p_PUCCH_Synch, p_UL_GrantConfig, p_CnfFlag);
  }

  /*
   * @desc      Stop UL grants
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_PUCCH_Synch       (default value: cs_NR_UplinkTimeAlignment_Stop)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ULGrantConfiguration_Stop(NR_CellId_Type   p_NR_CellId,
                                          template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                          template (omit)  NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch := cs_NR_UplinkTimeAlignment_Stop) runs on NR_BASE_PTC
  {
    f_NR_ULGrantConfiguration_Common(p_NR_CellId, p_TimingInfo, -, p_PUCCH_Synch, cs_UL_GrantConfig_Stop);
  }

  /*
   * @desc      Wrapper to configure Serving Cell
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ServingCellConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_ServingCellConfig(NR_CellId_Type p_NR_CellId,
                                     template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                     template (value) NR_ServingCellConfig_Type p_ServingCellConfig) runs on NR_BASE_PTC
  {
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_ServingCellConfig_REQ(p_NR_CellId, p_TimingInfo, p_ServingCellConfig));
  }

  /*
   * @desc      Configure RACH procedure at the SS
   * @param     p_NR_CellId
   * @param     p_RachProcedureConfig
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_RachProcedureConfig(NR_CellId_Type p_NR_CellId,
                                       template (value) NR_RachProcedureConfig_Type p_RachProcedureConfig,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                       template (omit) boolean p_CnfFlag := omit,
                                       boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                       ) runs on NR_BASE_PTC
  {
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_RachProcedureConfig_REQ(p_NR_CellId, p_TimingInfo, p_RachProcedureConfig, p_CnfFlag, p_FollowOnFlag));
  }

  /*
   * @desc      Configure the default RACH procedure as at cell creation or with CFRA if stored in the cell Array
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_RachProcedureConfig_Def(NR_CellId_Type p_NR_CellId,
                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                           template (omit) boolean p_CnfFlag := omit,
                                           boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                           ) runs on NR_BASE_PTC
  {
    var template (value) NR_RachProcedureConfig_Type v_RachProcedureConfig := f_NR_InitialiseRachProcedure(p_NR_CellId); //Default CBRA configuration
    var template (omit) RACH_ConfigDedicated v_RACH_ConfigDedicated := f_NR_CellInfo_GetRACH_ConfigDedicated (p_NR_CellId);
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);

    if (isvalue(v_RACH_ConfigDedicated)) { //CFRA
       v_RachProcedureConfig := cs_NR_RachProcedureConfig_CFRA(v_NR_PhysicalParameters);
    }
    f_NR_SS_RachProcedureConfig(p_NR_CellId, v_RachProcedureConfig, p_TimingInfo, p_CnfFlag, p_FollowOnFlag);
  }

  /*
   * @desc      Configuration of measurement gaps for the given cell
   * @param     p_NR_CellId
   * @param     p_NewMeasGapCtrl
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_MeasGapCtrlConfig(NR_CellId_Type p_NR_CellId,
                                     template (omit) NR_MeasGapCtrl_Type p_NewMeasGapCtrl,
                                     template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                     template (omit) boolean p_CnfFlag := omit) runs on NR_BASE_PTC
  { /* Reconfiguration of measurement gaps:
       when measurement gaps are already configured SS will only be re-configured when the measurement gap configuration really changes;
       in this case since RRCReconfiguration is scheduled in general
       the RRCReconfiguration follows the requirements for the old configuration and then 5ms later SS changes to the new configuration
       (i.e. for sending the RLC STATUS PDU to acknowledge the RRCReconfigurationComplete SS shall already consider the new configuration)
     */
    var NR_MeasGapCtrl_Type v_OldMeasGapCtrl := f_NR_CellInfo_GetMeasGapCtrl(p_NR_CellId);

   if (match(v_OldMeasGapCtrl, p_NewMeasGapCtrl)) {
    return;
   }
    f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_MeasGapCtrl_REQ(p_NR_CellId, p_TimingInfo, p_NewMeasGapCtrl, p_CnfFlag));
    f_NR_CellInfo_SetMeasGapCtrl(p_NR_CellId, valueof(p_NewMeasGapCtrl));
  }

  /*
   * @desc      Configuration of DRX for the given cell
   * @param     p_NR_CellId
   * @param     p_DrxCtrl
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_DrxCtrlConfig(NR_CellId_Type p_NR_CellId,
                                 template (omit) NR_DrxCtrl_Type p_DrxCtrl,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                 template (omit) boolean p_CnfFlag := omit) runs on NR_BASE_PTC
  {
    var NR_DrxCtrl_Type v_OldDrxCtrl := f_NR_CellInfo_GetDrxCtrl(p_NR_CellId);

    if (match(v_OldDrxCtrl, p_DrxCtrl)) {
     return;
    }
    f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_DrxCtrl_REQ(p_NR_CellId, p_TimingInfo, p_DrxCtrl, p_CnfFlag));
  }

}
