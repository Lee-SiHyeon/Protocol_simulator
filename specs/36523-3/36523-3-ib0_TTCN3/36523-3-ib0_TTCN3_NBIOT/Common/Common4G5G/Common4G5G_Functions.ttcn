module Common4G5G_Functions {


  /*
   * @desc      returns Ceil(p_Dividend / p_Divisor)
   * @param     p_Dividend
   * @param     p_Divisor
   * @return    integer
   * @status    APPROVED (ENDC, NBIOT, NR5GC)
   */
  function f_RoundedUpDivision(integer p_Dividend,
                               integer p_Divisor) return integer
  {
    return ((p_Dividend - 1) / p_Divisor) + 1;
  }

}
