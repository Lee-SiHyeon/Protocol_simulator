                                                                                 template (omit) MeasGapConfig p_MeasGapConfig := omit) := //@sic R5-176688, R5s170807 sic@
  /* @status    APPROVED (LTE) */
    cs_508_RRCConnectionReconfiguration_ConditionMEAS(p_RRC_TI,
                                                      cs_MeasConfig(omit,
                                                                    cs_MeasObjectToAddModList_1Entry(tsc_IdMeasObject_f1,
                                                                                                     cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq), p_MeasurementBandwidth)), //@sic R5-171996 sic@
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_2Entries(1,
                                                                                                         cs_ReportConfig_reportConfigEUTRA_eventA3(-20, false, 0, ms0, rsrp, sameAsTriggerQuantity, 1, ms1024, r1), //@sic R5s100187 Change 2: Set the a3-Offset for both events to 0 sic@
