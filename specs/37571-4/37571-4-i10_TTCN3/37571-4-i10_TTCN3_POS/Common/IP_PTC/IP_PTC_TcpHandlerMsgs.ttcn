module IP_PTC_TcpHandlerMsgs {

  import from CommonDefs all;
  import from IP_ASP_TypeDefs all;

  type record TcpHandler_StartServer_Type {                     /* to start a TCP server by the IP PTC which always confirms the start
                                                                   @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type Socket,
    InternetApplication_Type Application,
    TLSConfig_Type TLSConfig optional,
    IP_DrbInfo_Type DrbInfo
  };

  type record  TcpHandler_StopServer_Type {                     /* to stop a TCP server at the IP PTC; there is no confirmation
                                                                   @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type Socket
  };

  type record TcpHandler_ConnectReq_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type LocalSocket,
    IP_Socket_Type RemoteSocket,
    InternetApplication_Type Application,
    IP_DrbInfo_Type DrbInfo
  };

  type record TcpHandler_CloseReq_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Connection_Type Connection
  };

  type record TcpHandler_Data_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Connection_Type Connection,
    octetstring Data
  };

  type record IP_PTC_TcpHandler_Request_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    boolean CnfFlag,
    union {
      TcpHandler_StartServer_Type    StartServer,
      TcpHandler_StopServer_Type     StopServer,
      TcpHandler_ConnectReq_Type     ConnectReq,
      TcpHandler_CloseReq_Type       CloseReq,
      TcpHandler_Data_Type           DataReq
    } Request
  };

  type union IP_PTC_TcpHandler_RespOrInd_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Null_Type Cnf,
    IP_Connection_Type ConnectCnf,
    IP_Connection_Type ConnectInd,
    IP_Connection_Type CloseInd,
    TcpHandler_Data_Type DataInd
  };

  template (present) IP_PTC_TcpHandler_Request_Type cr_IP_PTC_TcpHandler_Request :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    CnfFlag := ?,
    Request := ?
  };

  template (value) IP_PTC_TcpHandler_RespOrInd_Type cs_IP_PTC_TcpHandler_Cnf :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Cnf := true
  };

  template (value) IP_PTC_TcpHandler_RespOrInd_Type cs_IP_PTC_TcpHandler_DataInd(IP_Connection_Type p_IP_Connection,
                                                                                 octetstring p_Data) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    DataInd := {
      Connection := p_IP_Connection,
      Data := p_Data
    }
  };

  template (value) IP_PTC_TcpHandler_RespOrInd_Type cs_IP_PTC_TcpHandler_ConnectInd(IP_Connection_Type p_IP_Connection) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    ConnectInd := p_IP_Connection
  };

  template (value) IP_PTC_TcpHandler_RespOrInd_Type cs_IP_PTC_TcpHandler_CloseInd(IP_Connection_Type p_IP_Connection) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    CloseInd := p_IP_Connection
  };

  type port IP_TCP_HANDLER_PORT message
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    in  IP_PTC_TcpHandler_Request_Type;
    out IP_PTC_TcpHandler_RespOrInd_Type;
  };

}
