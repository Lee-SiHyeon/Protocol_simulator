  template (value) PhysicalConfigDedicated cds_PhysicalConfigDedicated_DSR_Transmax(SR_PUCCH_ResourceIndex_Type p_SR_PUCCH_ResourceIndex,
                                                                                    SR_ConfigIndex_Type p_SR_ConfigIndex ,
