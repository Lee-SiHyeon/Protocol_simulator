          rrc_TransactionIdentifier := tsc_RRC_TI,
          criticalExtensions := {
            criticalExtensions := {
              criticalExtensions := {
                criticalExtensions := {
                  criticalExtensions := {
                    r8 := {
                      radioBearerSetup_r8 := p_RadioBearerSetup,
                      radioBearerSetup_r8_add_ext := omit,
                      v7d0NonCriticalExtensions := omit
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

