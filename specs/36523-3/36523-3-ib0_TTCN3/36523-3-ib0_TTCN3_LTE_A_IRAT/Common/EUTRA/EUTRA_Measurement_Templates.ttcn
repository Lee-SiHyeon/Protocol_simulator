  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */
    measResultListEUTRA := {
      {
        physCellId := p_PhysCellId,
        cgi_Info   := p_Cgi_Info,
        measResult := cr_MeasResultEUTRA(p_RsrpResult, p_RsrqResult, p_AdditionalSI_Info_r9, p_PrimaryPLMN_Suitable_r12)   /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      }
    }
  };

