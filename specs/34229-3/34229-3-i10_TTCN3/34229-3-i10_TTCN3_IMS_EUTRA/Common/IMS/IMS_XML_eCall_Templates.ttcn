module IMS_XML_eCall_Templates {

  import from CommonDefs all;
  import from XSD all;
  import from urn_ietf_params_xml_ns_EmergencyCallData_control language "XSD" all;

  type AckType.sequence_list[-].actionResult_list     EmergencyCallData_Ack_ActionResultList_Type;       /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */

  type EmergencyCallData_Ack_ActionResultList_Type[-] EmergencyCallData_Ack_ActionResult_Type;           /* @status    APPROVED (IMS, LTE_A_PRO) */

  type RequestType.choice_list EmergencyCallData_Request_ChoiceList_Type;                                /* @status    APPROVED (IMS, LTE_A_PRO) */

  type EmergencyCallData_Request_ChoiceList_Type[-] EmergencyCallData_Request_Choice_Type;               /* @status    APPROVED (IMS, LTE_A_PRO) */

  const XSD.Token tsc_EmergencyCallData_DataType_eCallMSD := "eCall.MSD";                                /* @status    APPROVED (IMS, LTE_A_PRO) */

  const XSD.Token tsc_EmergencyCallData_DataType_invalidMSD := "eCall.invalidMSD";                       /* @status    APPROVED (IMS, LTE_A_PRO) */

  /*
   * @desc      encode EmergencyCallData_Control XML document
   * @param     p_EmergencyCallData_Control
   * @return    charstring
   * @status    APPROVED (IMS, LTE_A_PRO, NR5GC)
   */
  function f_IMS_ECall_EmergencyCallData_Control_Encode(template (value) EmergencyCallData_Control p_EmergencyCallData_Control) return charstring
  {
    return oct2char(bit2oct(encvalue(p_EmergencyCallData_Control)));
  }

  /*
   * @desc      decode and match EmergencyCallData_Control XML document
   * @param     p_XmlBody
   * @param     p_EmergencyCallData_Control
   * @return    boolean
   * @status    APPROVED (IMS, LTE_A_PRO, NR5GC)
   */
  function f_IMS_ECall_EmergencyCallData_Control_DecodeAndMatch(charstring p_XmlBody,
                                                                template EmergencyCallData_Control p_EmergencyCallData_Control) return boolean
  {
    var bitstring v_Bitstring := f_Char2Bit(p_XmlBody);
    var EmergencyCallData_Control v_EmergencyCallData_Control;
    var boolean v_Result := false;

    if (decvalue(v_Bitstring, v_EmergencyCallData_Control) == 0) {
      v_Result := match(v_EmergencyCallData_Control, p_EmergencyCallData_Control);
    }
    return v_Result;
  }

  template (present) EmergencyCallData_Ack_ActionResult_Type cr_EmergencyCallData_Ack_ActionResult(template (present) charstring p_Reason,
                                                                                                   boolean p_Success) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO) */
    action_ := "send-data",     // @sic R5s210853: "send-data" instead of "send_data" sic@
    details := omit,
    reason := p_Reason,
    success := p_Success,
    attr := omit
  };

  template (value) EmergencyCallData_Ack_ActionResultList_Type cs_EmergencyCallData_Ack_ActionResultList_0 := {}; /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */

  template (present) EmergencyCallData_Ack_ActionResultList_Type cr_EmergencyCallData_Ack_ActionResultList_1(template (present) EmergencyCallData_Ack_ActionResult_Type p_ActionResult) := { p_ActionResult };  /* @status    APPROVED (IMS, LTE_A_PRO) */

  template (present) AckType cr_AckType(charstring p_Ref,
                                        template (present) EmergencyCallData_Ack_ActionResultList_Type p_ActionResultList) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO) */
    received := omit,   // @sic R5s210853: omit sic@
    ref := p_Ref,
    attr := omit,
    sequence_list := {
      {
        actionResult_list := p_ActionResultList,
        elem_list := {}
      }
    }
  };

  template (value) AckType cs_AckType(boolean p_AckRvd,
                                      charstring p_Ref,
                                      template (value) EmergencyCallData_Ack_ActionResultList_Type p_ActionResultList) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */
    received := p_AckRvd,
    ref := p_Ref,
    attr := omit,
    sequence_list := {
      {
        actionResult_list := p_ActionResultList,
        elem_list := {}
      }
    }
  };

  template (value) EmergencyCallData_Request_Choice_Type cs_EmergencyCallData_Request_Choice_TextList_0 :=
  { /* @status    APPROVED (IMS, LTE_A_PRO) */
    text_list := {}
  };

  template (value) EmergencyCallData_Control cs_EmergencyCallData_Control_Request(XSD.Token p_Action := "send-data",     // @sic R5s210849: "send-data" instead of "send_data" sic@
                                                                                  XSD.Token p_DataType := tsc_EmergencyCallData_DataType_eCallMSD) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO) */
    attr := omit,
    choice := {
      request := {
        action_ := p_Action,
        datatype := p_DataType,
        element_id := omit,
        int_id := omit,
        persistence := omit,
        requested_state := omit,
        supported_values := omit,
        attr := omit,
        choice_list := {
          cs_EmergencyCallData_Request_Choice_TextList_0
        }
      }
    }
  };

  template (value) EmergencyCallData_Control cs_EmergencyCallData_Control_Ack(boolean p_AckRvd,
                                                                              charstring p_Ref) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO, NR5GC) */
    attr := omit,
    choice := {
      ack := cs_AckType(p_AckRvd, p_Ref, cs_EmergencyCallData_Ack_ActionResultList_0)
    }
  };

  template (present) EmergencyCallData_Control cr_EmergencyCallData_Control_Ack(charstring p_Ref,
                                                                                template (present) charstring p_Reason := ?,
                                                                                boolean p_Success := false) :=
  { /* @status    APPROVED (IMS, LTE_A_PRO) */
    attr := omit,
    choice := {
      ack := cr_AckType(p_Ref, cr_EmergencyCallData_Ack_ActionResultList_1(cr_EmergencyCallData_Ack_ActionResult(p_Reason, p_Success)))
    }
  };

}
