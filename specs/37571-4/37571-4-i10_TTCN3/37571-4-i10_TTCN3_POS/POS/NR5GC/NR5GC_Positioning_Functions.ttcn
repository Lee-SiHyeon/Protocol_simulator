          (p_NrDlPrsProcessingCapabilityBandList[v_Index].maxNumOfDL_PRS_ResProcessedPerSlot_r16.scs60_r16 == pc_maxNumOfDL_PRS_ResProcessedPerSlot_SCS60)) {
