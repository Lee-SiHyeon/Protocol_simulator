module MCX_XML_Signature {

  import from Base64Encoding all;
  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_SecurityFunctions all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from http_www_w3_org_2000_09_xmldsig language "XSD" all;
  import from urn_3gpp_ns_mcpttSignedDoc_1_0 language "XSD" all;

  type Signatures.elem_list SignatureList_Type;                 /* @status    APPROVED (MCX) */

  type Signature Signature_Type;                                /* @status    APPROVED (MCX) */

  const charstring tsc_XML_Signature_CanonicalizationAlgorithm_C14N := "http://www.w3.org/TR/2001/REC-xml-c14n-20010315";       /* @status    APPROVED (MCX) */

  const charstring tsc_XML_Signature_SignatureAlgorithm_HMAC_SHA256 := "http://www.w3.org/2001/04/xmldsig-more#hmac-sha256";    /* @status    APPROVED (MCX) */

  const charstring tsc_XML_Signature_DigestAlgorithm_SHA256 := "http://www.w3.org/2001/04/xmlenc#sha256";                       /* @status    APPROVED (MCX) */

  template (value) Signatures cs_MCX_XML_Signatures(Signatures.elem_list p_SignatureList) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    elem_list := p_SignatureList,
    anyExt := omit
  };

  template (value) Signature cs_MCX_XML_Signature(template (omit) charstring p_SignatureId := omit,
                                                  charstring p_ReferenceURI,
                                                  charstring p_SigningKeyName) :=
  { // Table 5.5.13.1-2
    /* @status    APPROVED (MCX) */
    id := p_SignatureId,
    signedInfo := {
      id := omit,
      canonicalizationMethod := {
        embed_values := {},
        algorithm := tsc_XML_Signature_CanonicalizationAlgorithm_C14N,
        elem_list := {}
      },
      signatureMethod := {
        embed_values := {},
        algorithm := tsc_XML_Signature_SignatureAlgorithm_HMAC_SHA256,
        hMACOutputLength := omit,
        elem_list := {}
      },
      reference_list := {
        {
          id := omit,
          type_ := omit,
          uRI := p_ReferenceURI,
          transforms := omit,
          digestMethod := {
            embed_values := {},
            algorithm := tsc_XML_Signature_DigestAlgorithm_SHA256,
            elem_list := {}
          },
          digestValue := ''O      // to be generated by the SS (-> fx_MCX_XML_AddEnvelopedSignature)
        }
      }
    },
    signatureValue := {
      id := omit,
      base := ''O                 // base64 encoded hash of the signature - to be generated by the SS (-> fx_MCX_XML_AddEnvelopedSignature)
    },
    keyInfo := cs_XMLDSIG_KeyInfo_KeyName(p_SigningKeyName),
    object_list := {}
  };

  template (present) Signature cr_MCX_XML_Signature(template (present) XSD.AnyURI p_ReferenceURI,
                                                    template (present) XSD.AnyURI p_CanonicalizationAlgorithm := ?,
                                                    template (present) charstring p_SigningKeyName := ?,
                                                    template (present) DigestValueType p_DigestValue := ?,
                                                    template (present) SignatureValueType.base p_SignatureValue := ?) :=
  { // Table 5.5.13.1-1
    /* @status    APPROVED (MCX) */
    id := *,
    signedInfo := {
      id := *,
      canonicalizationMethod := {
        embed_values := {},                                     // @sic R5s230776: workaround removed sic@
        algorithm := p_CanonicalizationAlgorithm,               // should be "http://www.w3.org/TR/2001/REC-xml-c14n-20010315" in general
        elem_list := {}
      },
      signatureMethod := {
        embed_values := {},                                     // @sic R5s230776: workaround removed sic@
        algorithm := tsc_XML_Signature_SignatureAlgorithm_HMAC_SHA256,
        hMACOutputLength := *,
        elem_list := {}
      },
      reference_list := {
        {
          id := *,
          type_ := *,
          uRI := p_ReferenceURI,
          transforms := *,
          digestMethod := {
            embed_values := {},                                 // @sic R5s230776: workaround removed sic@
            algorithm := tsc_XML_Signature_DigestAlgorithm_SHA256,
            elem_list := {}
          },
          digestValue := p_DigestValue
        }
      }
    },
    signatureValue := {
      id := *,
      base := p_SignatureValue
    },
    keyInfo := cr_XMLDSIG_KeyInfo_KeyName(p_SigningKeyName),
    object_list := {}
  };

  /*
   * @desc      Encode single XML signature
   * @param     p_Signature
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCX_Signature_Encode(template (value) Signature p_Signature) return XSD.String
  {
    var bitstring v_EncodedSignature := encvalue(p_Signature);
    return f_Bit2XsdString(v_EncodedSignature);
  }

  /*
   * @desc      Encode list of XML signatures
   * @param     p_SignatureList
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_Signatures_Encode(SignatureList_Type p_SignatureList) return XmlBody_Type
  {
    var template (value) Signatures v_Signatures := cs_MCX_XML_Signatures(p_SignatureList);
    var bitstring v_EncodedSignatures := encvalue(v_Signatures);

    return f_Bit2XmlBody(v_EncodedSignatures);
  }

  /*
   * @desc      Decode single Signature
   * @param     p_Signature
   * @return    Signature_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_Signature_Decode(XSD.String p_Signature) return Signature_Type
  {
    var bitstring v_Bitstring := f_XsdString2Bit(p_Signature);
    var Signature v_Signature;

    if (decvalue(v_Bitstring, v_Signature) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode Signature");
    }
    return v_Signature;
  }

  /*
   * @desc      Decode Signatures
   * @param     p_Signatures
   * @return    Signatures
   * @status    APPROVED (MCX)
   */
  function f_MCX_Signatures_Decode(XmlBody_Type p_Signatures) return Signatures
  {
    var bitstring v_Bitstring := f_XmlBody2Bit(p_Signatures);
    var Signatures v_Signatures;

    if (decvalue(v_Bitstring, v_Signatures) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode Signatures");
    }
    return v_Signatures;
  }

  /*
   * @desc      return signature for given reference URI or empty string, if no such signature found
   * @param     p_XmlBodySignature
   * @param     p_ReferenceURI
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCX_Signatures_FindSignature(XmlBody_Type p_XmlBodySignature,
                                          charstring p_ReferenceURI) return XSD.String
  {
    var Signatures v_Signatures := f_MCX_Signatures_Decode(p_XmlBodySignature);
    var SignatureList_Type v_SignatureList := v_Signatures.elem_list;
    var Signature_Type v_Signature;
    var integer i;
  
    for (i := 0; i < lengthof(v_SignatureList); i := i + 1) {
      v_Signature := f_MCX_Signature_Decode(v_SignatureList[i]);
      if (match(v_Signature, cr_MCX_XML_Signature(p_ReferenceURI))) {
        return v_SignatureList[i];
        /* if the above does not work (what should not be the case):
           return fl_MCX_Signatures_GetSignature(p_XmlBodySignature, i + 1);
        */
      }
    }
    return "";
  }

  /*
   * @desc      Create detached signature with signing key derived from given XPK (being the CSK in general)
   * @param     p_ServiceType
   * @param     p_XmlDocument
   * @param     p_XmldsigDocument
   * @param     p_XPK
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCX_XML_CreateSignature(MCX_ServiceType_Type p_ServiceType,
                                     XmlBody_Type p_XmlDocument,
                                     XSD.String p_XmldsigDocument,
                                     MCX_SecurityKey_Type p_XPK) return XSD.String
  {
    var charstring v_MCServiceID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var bitstring v_SigningKey := f_MCX_XML_GenerateProtectionKey(p_XPK, tsc_MCX_FC_Integrity, v_MCServiceID);   // key derivation according to 33.180 annex F.1.4
    var XSD.String v_EncodedSignature := fx_MCX_XML_CreateDetachedSignature(p_XmlDocument, p_XmldsigDocument, v_SigningKey);

    return v_EncodedSignature;
  }

  /*
   * @desc      Check detached signature
   * @param     p_ServiceType
   * @param     p_XmlDocument
   * @param     p_ReferenceURI
   * @param     p_XmldsigDocument
   * @param     p_XPK
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MCX_XML_CheckDetachedSignature(MCX_ServiceType_Type p_ServiceType,
                                            XmlBody_Type p_XmlDocument,
                                            charstring p_ReferenceURI,
                                            XSD.String p_XmldsigDocument,
                                            MCX_SecurityKey_Type p_XPK) return boolean
  {
    var XSD.String v_XmldsigDocument := p_XmldsigDocument;
    var Signature_Type v_ReceivedSignature := f_MCX_Signature_Decode(p_XmldsigDocument);
    var charstring v_KeyName := f_Base64Encode(p_XPK.Id);
    var Signature_Type v_GeneratedSignature;
    var template (present) Signature v_ExpectedSinature;

    // Clear Digest and Signature values in XmldsigDocument
    v_XmldsigDocument := fx_XML_SetElementContent(v_XmldsigDocument, f_XPATH_ExpressionForAnyNamespaces("//Signature/SignedInfo/Reference[1]/DigestValue"), "");
    v_XmldsigDocument := fx_XML_SetElementContent(v_XmldsigDocument, f_XPATH_ExpressionForAnyNamespaces("//Signature/SignatureValue"), "");
  
    // Re-compute the Signature
    v_XmldsigDocument := f_MCX_XML_CreateSignature(p_ServiceType, p_XmlDocument, v_XmldsigDocument, p_XPK);
    v_GeneratedSignature := f_MCX_Signature_Decode(v_XmldsigDocument);

    v_ExpectedSinature := cr_MCX_XML_Signature(p_ReferenceURI,
                                               -,
                                               v_KeyName,
                                               v_GeneratedSignature.signedInfo.reference_list[0].digestValue,
                                               v_GeneratedSignature.signatureValue.base);

    return match(v_ReceivedSignature, v_ExpectedSinature);
  }

}
