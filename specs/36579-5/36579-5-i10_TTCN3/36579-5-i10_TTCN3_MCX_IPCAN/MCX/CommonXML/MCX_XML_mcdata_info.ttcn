module MCX_XML_mcdata_info {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcdataInfo_1_0 language "XSD" all;

  type urn_3gpp_ns_mcdataInfo_1_0.Mcdatainfo_Type MCData_Info_Type;             /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCData_Info_EncryptedElements := {              /* @status    APPROVED (MCX) */
    /* 24.282 D.1.3: <mcdatainfo><mcdata-Params> elements which may be encrypted */
    "mcdata-access-token",
    "mcdata-request-uri",
    "mcdata-controller-psi",
    "mcdata-calling-user-id",
    "mcdata-called-party-id",
    "mcdata-calling-group-id",
    "alert-ind",
    "originated-by",
    "mcdata-client-id",
    "anyExt/functional-alias-URI",
    "anyExt/called-functional-alias-URI"
  };

  type union McdataInfoExt_Element_Type {                                       /* @status    APPROVED (MCX) */
    XSD.Boolean                  EmergencyAlertAreaInd,
    XSD.Boolean                  GroupGeoAreaInd,
    XSD.Boolean                  PreestablishedSessionInd,
    XSD.Boolean                  CallToFunctionalAliasInd,
    McdataCommunicationStateType McdataCommunicationState,
    XSD.Boolean                  EmergencyInd,
    XSD.Boolean                  AlertIndRcvd,
    XSD.String                   McOrg,
    ContentType                  FunctionalAliasURI,
    XSD.NonNegativeInteger       UserRequestedPriority,
    ContentType                  MultipleDevicesInd,
    XSD.Boolean                  ImminentperilInd,
    XSD.Boolean                  EmergencyIndRcvd,
    XSD.Boolean                  BindingInd,
    XSD.AnyURI                   BindingFaUri,
    XSD.AnyURI                   UnbindingFaUri,
    ContentType                  CalledFunctionalAliasURI,
    XSD.Boolean                  StoreAllPrivateCommsInMsgstore,
    XSD.Boolean                  StoreAllGroupCommsInMsgstore,
    StorageCtrlType              StoreSpecificPrivateCommsInMsgstore,
    StorageCtrlType              StoreSpecificGroupCommsInMsgstore
  };

  type record of McdataInfoExt_Element_Type McdataInfoExt_ElementList_Type;     /* @status    APPROVED (MCX) */

  /*
   * @desc      decode extension of mcdata-info
   * @param     p_McdataInfoExt
   * @return    McdataInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_McdataInfoExt_Decode(template (omit) AnyExtType p_McdataInfoExt) runs on IMS_PTC return McdataInfoExt_ElementList_Type
  {
    // variables for decoding
    var Emergency_alert_area_ind v_Emergency_alert_area_ind;
    var Group_geo_area_ind v_Group_geo_area_ind;
    var Pre_established_session_ind v_Pre_established_session_ind;
    var Call_to_functional_alias_ind v_Call_to_functional_alias_ind;
    var Mcdata_communication_state v_Mcdata_communication_state;
    var Emergency_ind v_Emergency_ind;
    var Alert_ind_rcvd v_Alert_ind_rcvd;
    var Mc_org v_Mc_org;
    var Functional_alias_URI v_Functional_alias_URI;
    var User_requested_priority v_User_requested_priority;
    var Multiple_devices_ind v_Multiple_devices_ind;
    var Imminentperil_ind v_Imminentperil_ind;
    var Emergency_ind_rcvd v_Emergency_ind_rcvd;
    var Binding_ind v_Binding_ind;
    var Binding_fa_uri v_Binding_fa_uri;
    var Unbinding_fa_uri v_Unbinding_fa_uri;
    var Called_functional_alias_URI v_Called_functional_alias_URI;
    var Store_all_private_comms_in_msgstore v_Store_all_private_comms_in_msgstore;
    var Store_all_group_comms_in_msgstore v_Store_all_group_comms_in_msgstore;
    var Store_specific_private_comms_in_msgstore v_Store_specific_private_comms_in_msgstore;
    var Store_specific_group_comms_in_msgstore v_Store_specific_group_comms_in_msgstore;

    // other variables
    var AnyExtType v_McdataInfoExt;
    var McdataInfoExt_ElementList_Type v_McdataInfoExtElementList := {};
    var McdataInfoExt_Element_Type v_Element;
    var bitstring v_Bitstring;
    var integer i;

    if (isvalue(p_McdataInfoExt)) {
      v_McdataInfoExt := valueof(p_McdataInfoExt);
      for (i := 0; i < lengthof(v_McdataInfoExt.elem_list); i := i + 1) {
        v_Bitstring := f_Unichar2Bit(v_McdataInfoExt.elem_list[i]);
        
        if (decvalue(v_Bitstring, v_Emergency_alert_area_ind) == 0) {
          v_Element.EmergencyAlertAreaInd := v_Emergency_alert_area_ind;
        }
        else if (decvalue(v_Bitstring, v_Group_geo_area_ind) == 0) {
          v_Element.GroupGeoAreaInd := v_Group_geo_area_ind;
        }
        else if (decvalue(v_Bitstring, v_Pre_established_session_ind) == 0) {
          v_Element.PreestablishedSessionInd := v_Pre_established_session_ind;
        }
        else if (decvalue(v_Bitstring, v_Call_to_functional_alias_ind) == 0) {
          v_Element.CallToFunctionalAliasInd := v_Call_to_functional_alias_ind;
        }
        else if (decvalue(v_Bitstring, v_Mcdata_communication_state) == 0) {
          v_Element.McdataCommunicationState := v_Mcdata_communication_state;
        }
        else if (decvalue(v_Bitstring, v_Emergency_ind) == 0) {
          v_Element.EmergencyInd := v_Emergency_ind;
        }
        else if (decvalue(v_Bitstring, v_Alert_ind_rcvd) == 0) {
          v_Element.AlertIndRcvd := v_Alert_ind_rcvd;
        }
        else if (decvalue(v_Bitstring, v_Mc_org) == 0) {
          v_Element.McOrg := v_Mc_org;
        }
        else if (decvalue(v_Bitstring, v_Functional_alias_URI) == 0) {
          v_Element.FunctionalAliasURI := v_Functional_alias_URI;
        }
        else if (decvalue(v_Bitstring, v_User_requested_priority) == 0) {
          v_Element.UserRequestedPriority := v_User_requested_priority;
        }
        else if (decvalue(v_Bitstring, v_Multiple_devices_ind) == 0) {
          v_Element.MultipleDevicesInd := v_Multiple_devices_ind;
        }
        else if (decvalue(v_Bitstring, v_Imminentperil_ind) == 0) {
          v_Element.ImminentperilInd := v_Imminentperil_ind;
        }
        else if (decvalue(v_Bitstring, v_Emergency_ind_rcvd) == 0) {
          v_Element.EmergencyIndRcvd := v_Emergency_ind_rcvd;
        }
        else if (decvalue(v_Bitstring, v_Binding_ind) == 0) {
          v_Element.BindingInd := v_Binding_ind;
        }
        else if (decvalue(v_Bitstring, v_Binding_fa_uri) == 0) {
          v_Element.BindingFaUri := v_Binding_fa_uri;
        }
        else if (decvalue(v_Bitstring, v_Unbinding_fa_uri) == 0) {
          v_Element.UnbindingFaUri := v_Unbinding_fa_uri;
        }
        else if (decvalue(v_Bitstring, v_Called_functional_alias_URI) == 0) {
          v_Element.CalledFunctionalAliasURI := v_Called_functional_alias_URI;
        }
        else if (decvalue(v_Bitstring, v_Store_all_private_comms_in_msgstore) == 0) {
          v_Element.StoreAllPrivateCommsInMsgstore := v_Store_all_private_comms_in_msgstore;
        }
        else if (decvalue(v_Bitstring, v_Store_all_group_comms_in_msgstore) == 0) {
          v_Element.StoreAllGroupCommsInMsgstore := v_Store_all_group_comms_in_msgstore;
        }
        else if (decvalue(v_Bitstring, v_Store_specific_private_comms_in_msgstore) == 0) {
          v_Element.StoreSpecificPrivateCommsInMsgstore := v_Store_specific_private_comms_in_msgstore;
        }
        else if (decvalue(v_Bitstring, v_Store_specific_group_comms_in_msgstore) == 0) {
          v_Element.StoreSpecificGroupCommsInMsgstore := v_Store_specific_group_comms_in_msgstore;
        }
        else {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcdatainfo.mcdata-Params.anyExt: element[" & int2str(i) & "] cannot be decoded");
        }
        v_McdataInfoExtElementList := v_McdataInfoExtElementList & { v_Element };
      }
    }
    return v_McdataInfoExtElementList;
  }

  /*
   * @desc      decode and match extension of mcdata-info
   * @param     p_McdataInfo
   * @param     p_McdataInfoExtElementList
   * @return    McdataInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_McdataInfoExt_DecodeAndMatch(MCData_Info_Type p_McdataInfo,
                                              template McdataInfoExt_ElementList_Type p_McdataInfoExtElementList) runs on IMS_PTC return McdataInfoExt_ElementList_Type
  {
    var McdataInfoExt_ElementList_Type v_McdataInfoExtElementList := fl_MCX_McdataInfoExt_Decode(p_McdataInfo.mcdata_Params.anyExt);   // even in case of anyExt==omit fl_MCX_McvideoInfoExt_Decode returns an (empty) list
    var template (present) McdataInfoExt_ElementList_Type v_ExpectedElementList := {};

    if (ispresent(p_McdataInfoExtElementList)) {
      v_ExpectedElementList := { permutation(all from p_McdataInfoExtElementList) };
    }
    if (not match(v_McdataInfoExtElementList, v_ExpectedElementList)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcdatainfo.mcdata-Params.anyExt does not match");
    }
    return v_McdataInfoExtElementList;
  }

  template (value) urn_3gpp_ns_mcdataInfo_1_0.ContentType.choice cs_MCData_Info_Content_Choice_String(XSD.String p_String) := { mcdataString := p_String };             /* @status    APPROVED (MCX) */

  template (value) urn_3gpp_ns_mcdataInfo_1_0.ContentType.choice cs_MCData_Info_Content_Choice_URI(XSD.AnyURI p_URI) := { mcdataURI := p_URI };                         /* @status    APPROVED (MCX) */

  /*
   * @desc      Wrapper funnction to set ProtectionType depending on tsc_MCX_XML_ConfidentialityProtection
   * @return    ProtectionType
   * @status    APPROVED (MCX)
   */
  function fl_MCData_Info_ProtectionTypeTX() return ProtectionType
  {
    var ProtectionType v_ProtectionType := normal;
    if (tsc_MCX_XML_ConfidentialityProtection) {
      v_ProtectionType := encrypted;
    }
    return v_ProtectionType;
  }

  template (value) ContentType cs_MCData_Content(template (value) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := fl_MCData_Info_ProtectionTypeTX(),
    attr := omit,
    choice := p_Choice
  };

  template (value) ContentType cs_MCData_Content_URI(XSD.AnyURI p_URI) := cs_MCData_Content(cs_MCData_Info_Content_Choice_URI(p_URI));                                  /* @status    APPROVED (MCX) */

  /*
   * @desc      return ContentType element with URI
   * @param     p_URI
   * @return    template (omit) ContentType
   * @status    APPROVED (MCX)
   */
  function fl_MCData_Content_URI(template (omit) XSD.AnyURI p_URI) return template (omit) ContentType
  {
    if (isvalue(p_URI)) {
      return cs_MCData_Content_URI(valueof(p_URI));
    }
    return omit;
  }

  /*
   * @desc      return ContentType element with string
   * @param     p_String
   * @return    template (omit) ContentType
   * @status    APPROVED (MCX)
   */
  function fl_MCData_Content_String(template (omit) XSD.String p_String) return template (omit) ContentType
  {
    if (isvalue(p_String)) {
      return cs_MCData_Content(cs_MCData_Info_Content_Choice_String(valueof(p_String)));
    }
    return omit;
  }

  template (value) MCData_Info_Type cs_MCData_Info_Base(template (omit) charstring p_RequestType := omit,
                                                        template (omit) charstring p_RequestURI := px_MCData_ID_User_A,
                                                        template (omit) charstring p_CallingUserId := px_MCData_ID_User_B,
                                                        template (omit) charstring p_CallingGroupId := omit,
                                                        template (omit) charstring p_ClientId := omit,
                                                        template (omit) charstring p_ControllerPSI := omit) :=
  { /* MCData info according to 36.579-1 Table 5.5.3.2.2-3 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcdata_Params := {
      attr := omit,
      mcdata_access_token      := omit,
      request_type             := p_RequestType,
      mcdata_request_uri       := fl_MCData_Content_URI(p_RequestURI),
      mcdata_calling_user_id   := fl_MCData_Content_URI(p_CallingUserId),
      mcdata_called_party_id   := omit,
      mcdata_calling_group_id  := fl_MCData_Content_URI(p_CallingGroupId),
      alert_ind                := omit,
      originated_by            := omit,
      mcdata_client_id         := fl_MCData_Content_String(p_ClientId),
      mcdata_controller_psi    := fl_MCData_Content_URI(p_ControllerPSI),
      gw_mcdata_usage          := omit,                         // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list                := {},
      anyExt                   := omit
    },
    elem_list := {},
    anyExt := omit
  };

  template (value) MCData_Info_Type cs_MCData_Info_group(charstring p_RequestType,
                                                         template (omit) charstring p_RequestURI := px_MCData_ID_User_A,
                                                         template (omit) charstring p_CallingUserId := px_MCData_ID_User_B,
                                                         template (omit) charstring p_CallingGroupId := px_MCData_Group_A_ID,
                                                         template (omit) charstring p_ClientId := px_MCX_Client_B_ID) :=
  /* @status    APPROVED (MCX) */
    cs_MCData_Info_Base(p_RequestType, p_RequestURI, p_CallingUserId, p_CallingGroupId, p_ClientId);

  template (present) ContentType.choice cr_MCData_Info_Content_Choice_String(template (present) XSD.String p_String) := { mcdataString := p_String };                               /* @status    APPROVED (MCX) */

  template (present) ContentType.choice cr_MCData_Info_Content_Choice_URI(template (present) XSD.AnyURI p_URI) := { mcdataURI := p_URI };                                           /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCData_Content(template urn_3gpp_ns_mcdataInfo_1_0.ProtectionType p_Protection := *,
                                                   template (present) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := p_Protection,
    attr := omit,
    choice := p_Choice
  };

  template (present) ContentType cr_MCData_Content_String(template (present) XSD.String p_String) := cr_MCData_Content(-, cr_MCData_Info_Content_Choice_String(p_String));          /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCData_Content_URI(template (present) XSD.AnyURI p_URI) := cr_MCData_Content(-, cr_MCData_Info_Content_Choice_URI(p_URI));                      /* @status    APPROVED (MCX) */

  template (present) MCData_Info_Type cr_MCData_Info_Base(template charstring p_RequestType := omit,
                                                          template ContentType p_RequestURI := omit,
                                                          template ContentType p_CallingGroupId := omit,
                                                          template ContentType p_ClientId := omit) :=
  { /* MCData info according to 36.579-1 Table 5.5.3.2.1-3 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcdata_Params := {
      attr := omit,
      mcdata_access_token      := omit,
      request_type             := p_RequestType,
      mcdata_request_uri       := p_RequestURI,
      mcdata_calling_user_id   := omit,
      mcdata_called_party_id   := omit,
      mcdata_calling_group_id  := p_CallingGroupId,
      alert_ind                := omit,
      originated_by            := omit,
      mcdata_client_id         := p_ClientId,
      mcdata_controller_psi    := omit,
      gw_mcdata_usage          := omit,                         // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list                := {},
      anyExt                   := *
    },
    elem_list := {},
    anyExt := *
  };

  template (present) MCData_Info_Type cr_MCData_Info_1to1(charstring p_RequestType) := cr_MCData_Info_Base(p_RequestType);      /* @status    APPROVED (MCX) */

  template (present) MCData_Info_Type cr_MCData_Info_group(charstring p_RequestType,
                                                           charstring p_RequestURI := px_MCData_Group_A_ID,
                                                           charstring p_ClientId) :=
  /* @status    APPROVED (MCX) */
    cr_MCData_Info_Base(p_RequestType, cr_MCData_Content_URI(p_RequestURI), -, cr_MCData_Content_String(p_ClientId));

  /*
   * @desc      Encode Mcdatainfo
   * @param     p_Mcdatainfo
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCDataInfo_Encode(template (value) Mcdatainfo p_Mcdatainfo) return XmlBody_Type
  {
    var bitstring v_EncodedMcdatainfo := encvalue(p_Mcdatainfo);
    return f_Bit2XmlBody(v_EncodedMcdatainfo);
  }

  /*
   * @desc      Encode and encrypt Mcdatainfo
   * @param     p_MCData_Info
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCDataInfo_EncodeEncrypt(template (value) Mcdatainfo_Type p_MCData_Info,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_MCX_MCDataInfo_Encode(p_MCData_Info);
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    for (i := 0; i < lengthof(tsc_MCData_Info_EncryptedElements); i := i + 1) {
      v_XmlPath := "//mcdatainfo/mcdata-Params/" & tsc_MCData_Info_EncryptedElements[i];
      f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  /*
   * @desc      Decode MCData Info
   * @param     charstring
   * @return    Mcdatainfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCDataInfo_Decode(universal charstring p_XmlDocument) return Mcdatainfo_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XmlDocument);
    var Mcdatainfo v_Mcdatainfo;

    if (decvalue(v_Bitstring, v_Mcdatainfo) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCData-Info");
    }
    return v_Mcdatainfo;
  }

  /*
   * @desc      Decrypt and decode MCData Info
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    Mcdatainfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCDataInfo_DecryptDecode(XmlBody_Type p_XmlDocument,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return Mcdatainfo_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var charstring v_ElementName;
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      for (i := 0; i < lengthof(tsc_MCData_Info_EncryptedElements); i := i + 1) {
        v_ElementName := tsc_MCData_Info_EncryptedElements[i];
        v_XmlPath := "//mcdatainfo/mcdata-Params/" & v_ElementName;
        v_DecryptResult := f_XML_Document_DecryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, valueof(p_CSK));  // v_XmlDocument: inout parameter
        if (v_DecryptResult == NOT_ENCRYPTED) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, v_ElementName & " is not encrypted");
        }
      }
      fx_XML_Log(__FILE__, __LINE__, UPLINK, v_XmlDocument);
    }

    return f_MCX_MCDataInfo_Decode(v_XmlDocument);
  }

}
