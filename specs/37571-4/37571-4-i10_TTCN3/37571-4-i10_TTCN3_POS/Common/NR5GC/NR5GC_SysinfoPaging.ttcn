module NR5GC_SysinfoPaging {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NG_NAS_Common all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_RRC_Templates all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  const float tsc_NR_DelayForCellSelection := 1.0;                          /* delay to allow the UE to perform cell selection e.g. before paging or change of power level
                                                                               @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_NR_SfnDelay := 13;                                      /* tsc_NR_SfnDelay: Delay for calculation of the next paging frame.
                                                                             * Value set to 10+3 to give a minimum of 100ms (Ref: 36-523-3 cl. 7.3) to allow SS to configure the PAGING
                                                                             * and also to calculate for possible delay in SS & TTCN (30ms).
                                                                             * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_CellConfig_Paging_REQ_Common(NR_CellId_Type                       p_NR_CellId,
                                                                          template (value) SubFrameTiming_Type p_PagingOcassion,
                                                                          template (value) PCCH_Message        p_PCCH_Message,
                                                                          template (omit)  NR_SlotOffsetList_Type p_SlotOffsetList := omit) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := {
      CellId := p_NR_CellId,
      RoutingInfo := { None := true },
      RlcBearerRouting := crs_RlcBearerRouting_None,
      MacBearerRouting := omit,
      TimingInfo := {
        SubFrame := p_PagingOcassion
      },
      ControlInfo := {
        CnfFlag := false,
        FollowOnFlag := false
      }
    },
    Request := {
      Paging := {
        Paging := p_PCCH_Message,
        SlotOffsetList := p_SlotOffsetList
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_CellConfig_Paging_REQ(NR_CellId_Type p_NR_CellId,
                                                                   template (value) SubFrameTiming_Type p_PagingOcassion,
                                                                   template (value) PagingRecordList    p_PagingRecordList,
                                                                   template (omit) Paging_v1700_IEs p_Paging_v1700 := omit) :=
  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    cas_NR_CellConfig_Paging_REQ_Common(p_NR_CellId, p_PagingOcassion, cs_NR_RRC_Paging(p_PagingRecordList,p_Paging_v1700), omit);

  template (value) PCCH_Message cs_NR_RRC_Paging(template (omit) PagingRecordList p_PagingRecordList,
                                                 template (omit) Paging_v1700_IEs p_Paging_v1700 := omit) :=
  { // As per 38.508-1 Table 4.6.1-2B: Paging
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        paging := {
          pagingRecordList := p_PagingRecordList,
          lateNonCriticalExtension := omit,
          nonCriticalExtension := p_Paging_v1700
        }
      }
    }
  };

  template (value) PagingUE_Identity cs_PagingUE_Identity_5G_S_TMSI(NG_5G_S_TMSI p_NG_5G_S_TMSI) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    ng_5G_S_TMSI := p_NG_5G_S_TMSI
  };

  template (value) PagingUE_Identity cs_PagingUE_Identity_FullI_RNTI(I_RNTI_Value p_I_RNTI_r15) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    fullI_RNTI := p_I_RNTI_r15
  };

  template (value) PagingRecord cs_PagingRecord (template (value) PagingUE_Identity p_PagingUE_Identity) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    // As per 38.508-1 Table 4.6.1-2B: Paging
    ue_Identity := p_PagingUE_Identity,
    accessType := omit
  };

  template (value) PagingRecordList cs_PagingRecordList_OneRecord (template (value) PagingUE_Identity p_PagingUE_Identity) :=
  {  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_PagingRecord(p_PagingUE_Identity)
  };

  /*
   * @desc      Wrapper function to page UE with default parameters - Acc to 38.523-3 cl 7.3.4.2
   *            in RRC_IDLE page with GUTI and paging parameters of the cell when UE is in RRC_IDLE
   *            in RRC_INACTIVE page with default RAN paging cycle and fullI_RNTI
   * @param     p_NR_CellId
   * @param     p_UE_State
   * @param     p_MO_Index          (default value: 0)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Paging_Def(NR_CellId_Type     p_NR_CellId,
                           NR_RRC_STATE_Type  p_UE_State,
                           integer p_MO_Index := 0) runs on NR5GC_PTC
  {
    var NG_NAS_GutiParameters_Type v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(p_NR_CellId);
    var NG_5G_S_TMSI v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);
    var PCCH_Config v_PcchConfig := f_NR_GetSIB1_PcchConfig(p_NR_CellId);
    var PagingCycle v_PagingCycle;
    var template (value) PagingRecordList v_PagingRecordList;

    select(p_UE_State){
      case(RRC_IDLE){
        v_PagingCycle := v_PcchConfig.defaultPagingCycle;
        v_PagingRecordList := cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI));
      }
      case(RRC_INACTIVE) { //@sic R5-191364 sic@
        v_PagingCycle := tsc_NR_RAN_PagingCycle_Def;
        v_PagingRecordList := cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_FullI_RNTI(tsc_NR_I_RNTI_Value1));
      }
      case else {FatalError(__FILE__, __LINE__, "No paging in other states");}
    }
    f_NR_Paging(p_NR_CellId,
                v_PagingRecordList,
                v_PagingCycle,-, //@sic R5s240421 sic@
                p_MO_Index);
   }

  /*
   * @desc      Convert GUTI parameters to NG_5G_S_TMSI acc tu 23.003 cl 2.10.1
   * @param     p_GutiParameters
   * @return    NG_5G_S_TMSI
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Get5G_S_TMSI_FromGuti(NG_NAS_GutiParameters_Type p_GutiParameters) return NG_5G_S_TMSI
  {
    // Acc tu 23.003 cl 2.10.1 :
    // For paging purposes, the mobile is paged with the 5G-S-TMSI.
    // The 5G-S-TMSI shall be constructed from the AMF Set ID, the AMF Pointer and the 5G-TMSI.
    var NG_5G_S_TMSI v_NG_5G_S_TMSI := p_GutiParameters.AMF_SetId & p_GutiParameters.AMF_Pointer & p_GutiParameters.NG_TMSI;
    return v_NG_5G_S_TMSI;
  }

  /*
   * @desc      Trigger SS to send paging request to UE
   * @param     p_NR_CellId
   * @param     p_PagingRecordList
   * @param     p_PagingCycle
   * @param     p_SlotOffsetPaging  (default value: omit)
   * @param     p_Index             (default value: 0)
   * @param     p_Paging_v1700      (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Paging(NR_CellId_Type p_NR_CellId,
                       template (value) PagingRecordList p_PagingRecordList,
                       PagingCycle p_PagingCycle,
                       template (omit) integer p_SlotOffsetPaging := omit,
                       integer p_Index := 0,
                       template (omit) Paging_v1700_IEs p_Paging_v1700 := omit) runs on NR5GC_PTC
  { //@sic R5-231530: added p_SlotOffsetPaging sic@
    var SubFrameTiming_Type  v_CurrentTiming;
    var PCCH_Config v_PcchConfig := f_NR_GetSIB1_PcchConfig(p_NR_CellId);
    var B32_Type v_NG_TMSI := f_NR5GC_CellInfo_GetNG_TMSI(p_NR_CellId);
    var integer v_SlotsNumberPerSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(p_NR_CellId);
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var SubFrameTiming_Type v_PagingOccasion;
    var integer v_SlotOffsetPaging := f_NR_GetSlotOffsetForPaging(p_NR_CellId);

    if (isvalue(p_SlotOffsetPaging)) { v_SlotOffsetPaging := valueof(p_SlotOffsetPaging); }

    f_Delay(tsc_NR_DelayForCellSelection);

    //Get current SFN and subframe
    v_CurrentTiming := f_NR_GetCurrentTiming(p_NR_CellId);

    //Calculate next Paging Occasion
    v_PagingOccasion := f_NR_Calculate_PF_PO(v_CurrentTiming,  //@sic R5s190291 sic@
                                             p_PagingCycle,
                                             v_PcchConfig,
                                             v_NG_TMSI,
                                             v_SlotsNumberPerSubframe,
                                             v_SCS,
                                             v_SlotOffsetPaging,-,-,//@sic R5s240421 sic@
                                             p_Index);
    SYS.send(cas_NR_CellConfig_Paging_REQ(p_NR_CellId, v_PagingOccasion, p_PagingRecordList, p_Paging_v1700));
  }

  /*
   * @desc      Calculate the Paging occasion - Note: Only RRC_IDLE/INACTIVE states are handled
   * @param     p_CurrentTiming
   * @param     p_T
   * @param     p_PCCH_Config
   * @param     p_NG_TMSI
   * @param     p_SlotsNumberPerSubframe
   * @param     p_SCS
   * @param     p_SlotOffset
   * @param     p_UE_ID_Mod_Value   (default value: 1024)
   * @param     p_EDRX_Value        (default value: omit)
   * @param     p_Index             (default value: 0)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_Calculate_PF_PO (SubFrameTiming_Type    p_CurrentTiming,
                                 PagingCycle             p_T,
                                 PCCH_Config             p_PCCH_Config,
                                 B32_Type                p_NG_TMSI,
                                 integer                 p_SlotsNumberPerSubframe,
                                 SubcarrierSpacing       p_SCS,
                                 integer                 p_SlotOffset,
                                 integer                 p_UE_ID_Mod_Value := 1024,
                                 template (omit) float   p_EDRX_Value := omit,
                                 integer p_Index := 0) return SubFrameTiming_Type
  {
    //@sic R5s190291 change 1: change first parameter p_Sfn -> p_CurrentTiming (type SubFrameTiming_Type) R5s240061 R5s230896 sic@
    var integer v_UE_ID := bit2int(p_NG_TMSI) mod p_UE_ID_Mod_Value;                         // 5G-S-TMSI mod 1024 or 4096
    var integer v_PF_Offset := fl_NR_ConvertPF_Offset(p_PCCH_Config.nAndPagingFrameOffset);
    var integer v_NextSfn := p_CurrentTiming.SFN.Number + tsc_NR_SfnDelay; //Absolute value - no mod 1024
    var integer v_SfnPlusOffsetModT;
    var integer v_FirstPagingFrame;
    var integer v_T := fl_NR_ConvertPagingCycle(p_T);
    var integer v_N;     // N: number of total paging frames in T @sic R5s190150 change 4 sic@
    //var integer v_Ns := fl_NR_ConvertNs(p_PCCH_Config.ns);  //number of paging occasions for a PF => 1 / (2 if PEI)
    //var v_I_s; //* Calculate i_s = floor (UE_ID/N) mod Ns
    var SubFrameTiming_Type v_PagingOccasion;

    var float v_Tmin;

    if (isvalue(p_EDRX_Value)) {
      v_Tmin := valueof(p_EDRX_Value);  //v_Tmin set in the call of the function - T = min{TeDRX,RAN, TeDRX,CN} - check with ispresent allows this line
      v_T := float2int(v_Tmin * 100.00);
    }

    // p_Index = 0 fits with first monitoring occasion. TS 38.304, clause 7.1: The PDCCH monitoring occasions for paging which do not overlap with UL symbols ".." are sequentially numbered from zero starting from the first PDCCH monitoring occasion for paging in the PF.
    v_N := fl_NR_GetN(p_PCCH_Config.nAndPagingFrameOffset, v_T);

    //Calculate the first paging Frame
    //SFN for the PF is determined by: (SFN + PF_offset) mod T = (T div N)*(UE_ID mod N)
    //Absolute value - no mod 1024 @sic R5-211417 sic@
    v_SfnPlusOffsetModT := (v_T / v_N) * (v_UE_ID mod v_N);
    if ((v_NextSfn mod v_T) < v_SfnPlusOffsetModT) {
      v_FirstPagingFrame := ((v_NextSfn - v_NextSfn mod v_T) + v_SfnPlusOffsetModT) - v_PF_Offset + p_Index;
    } else {
      v_FirstPagingFrame := (v_NextSfn - v_NextSfn mod v_T) + v_SfnPlusOffsetModT + v_T - v_PF_Offset + p_Index;
    }

    //PDCCH monitoring occasions according to paging-SearchSpace and firstPDCCH-MonitoringOccasionOfPO
    //PDCCH monitoring occasions according to the default association: PDCCH monitoring occasions for paging are same as for RMSI as defined in Section 13 in TS 38.213
    // Ns = 1, there is only one PO which starts in the PF.
    // PEI -> Ns = 2, PO is either in the first half frame (i_s = 0) or the second half frame (i_s = 1) of the PF.
    //v_I_s := (v_UE_ID mod v_N) mod v_Ns;
    v_PagingOccasion.HSFN.Number := (p_CurrentTiming.HSFN.Number + (v_FirstPagingFrame)/1024 ) mod 1024;  //@sic R5-211417 sic@
    v_PagingOccasion.SFN.Number := v_FirstPagingFrame mod 1024;                                           //@sic R5-211417 sic@
    v_PagingOccasion.Subframe.Number := p_SlotOffset / p_SlotsNumberPerSubframe;
    v_PagingOccasion.Symbol := valueof(cs_SymbolTimingInfo_FirstSlot); //@sic R5s221246 sic@
    v_PagingOccasion := f_NR_SubFrameTiming_SetSlot(v_PagingOccasion,
                                                    p_SlotOffset mod p_SlotsNumberPerSubframe,
                                                    p_SCS);
    return v_PagingOccasion;
  }

  /*
   * @desc     Get N in integer
   * @param     p_NAndPagingFrameOffset
   * @param     p_T
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_GetN ( PCCH_Config.nAndPagingFrameOffset p_NAndPagingFrameOffset,
                         integer p_T) return integer
  {
    var integer v_NthT := fl_NR_ConvertN(p_NAndPagingFrameOffset);
    var integer v_N := p_T / v_NthT;
    return v_N;
  }

  /*
   * @desc     Convert paging cycle in integer
   * @param     p_T
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_ConvertPagingCycle(PagingCycle p_T) return integer
  {
    var integer v_T;
    select (p_T) {
      case(rf32)  { v_T := 32; }
      case(rf64)  { v_T := 64; }
      case(rf128) { v_T := 128; }
      case(rf256) { v_T := 256; }
    }
    return v_T;
  }

  /*
   * @desc     Convert N in integer
   * @param     p_NAndPagingFrameOffset
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_ConvertN(PCCH_Config.nAndPagingFrameOffset p_NAndPagingFrameOffset) return integer
  {
    var integer v_N;
    select union (p_NAndPagingFrameOffset){
      case(oneT)          { v_N := 1; }
      case(halfT)         { v_N := 2; }
      case(quarterT)      { v_N := 4; }
      case(oneEighthT)    { v_N := 8; }
      case(oneSixteenthT) { v_N := 16; }
    }
    return v_N;
  }

  /*
   * @desc     Convert PF_Offset cycle in integer
   * @param     p_NAndPagingFrameOffset
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_ConvertPF_Offset(PCCH_Config.nAndPagingFrameOffset p_NAndPagingFrameOffset) return integer
  {
    var integer v_PF_Offset;
    select union (p_NAndPagingFrameOffset){
      case(oneT)          { v_PF_Offset := 0; }
      case(halfT)         { v_PF_Offset := p_NAndPagingFrameOffset.halfT; }
      case(quarterT)      { v_PF_Offset := p_NAndPagingFrameOffset.quarterT; }
      case(oneEighthT)    { v_PF_Offset := p_NAndPagingFrameOffset.oneEighthT; }
      case(oneSixteenthT) { v_PF_Offset := p_NAndPagingFrameOffset.oneSixteenthT; }
    }

    return v_PF_Offset;
  }

  /*
   * @desc      To get the slot used for paging Acc to 38.523-3 cl 7.3.4
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_GetSlotOffsetForPaging (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
   {
     var integer v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);
     var integer v_SlotOffsetPaging;

     select (v_SSB_Index) { // set the SlotOffset acc. to 38.523-3 cl 7.3.4 //@sic R5-201150 sic@
        case(tsc_NR_SSB_Index1) {v_SlotOffsetPaging:= 2;}
        case(tsc_NR_SSB_Index0) {v_SlotOffsetPaging:= 1;} //@sic R5s200512 R5-202677 sic@
        case else {FatalError(__FILE__, __LINE__, "SSB Index value not handled");}
     }
     return v_SlotOffsetPaging
   }

}
