module MIKEY_MCX_Extension_TypeDefs {

  import from CommonDefs all;
  
  type record MCX_KeyParametersPayload_Text_Type {              // 33.180 Table E.6.1-1, clause E.6.5
    O2_Type iel,
    octetstring str
  };

  type record MCX_KeyParametersPayload_GroupID_Type {           // 33.180 clause E.6.3, 24.282 clause 15.2.14
    O1_Type iei,                                                // '7B'O according to 24.282 Table 15.1.7.1-1
    O2_Type iel,
    octetstring id
  };

  type record MCX_KeyParametersPayload_GroupIDs_Type {          // 33.180 Table E.6.1-1, clause E.6.3, Table E.6.3-1
    O2_Type iel,
    O1_Type noOfGroupIds,
    MCX_KeyParametersPayload_GroupID_Type groupId optional
  };

  type record MCX_KeyParametersPayload_Reserved_Type {          // 33.180 Table E.6.1-1, clause E.6.6
    O1_Type iei,
    O2_Type iel,
    octetstring data
  };
  
  type record MCX_KeyParametersPayload_Type {                   // 33.180 Table E.6.1-1: Key Parameters Payload content
    O1_Type keyType,
    O4_Type status,
    O5_Type activationTime,
    O5_Type expiryTime,
    MCX_KeyParametersPayload_Text_Type text,
    MCX_KeyParametersPayload_GroupIDs_Type groupIds optional,
    MCX_KeyParametersPayload_Reserved_Type reserved optional
  };

} with { encode "Key Parameter Payload Types"}
