    B1_Type                     dataType
  };
  
  type record SOR_HeaderType0 {
    B3_Type                     spare,                  /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     ap,                     // Sep22 @sic R5s221179 Baseline Moving sic@
    B1_Type                     ack,                    // Jun24 @sic R5s240531 Baseline Moving sic@
    B1_Type                     listType,               /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     listInd,                /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     dataType
  };
  
  type record SORTransparentContainer {                             /* 24.501 cl. 9.11.3.51 */
    IEI8_Type                   iei             optional, // @sic R5s200739 sic@
