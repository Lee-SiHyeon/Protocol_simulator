    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(tsc_SDP_WithoutPreconditions);                        /* @sic R5-235093: A.5.2a (EVS_A2) instead of A.5.2 (EVS_B0_A1) sic@ */

    // @siclog "Step 10 - 18" siclog@
    f_IMS_MTCallSetup_NR5GC_A_5_2a_Step2_10(v_InviteRequestWithSdp);                                                    /* @sic R5-235093: A.5.2a instead of A.5.2 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 17");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_SpeechCall);
  }

