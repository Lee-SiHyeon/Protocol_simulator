module EUTRA_LPP_Templates {

  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from EUTRA_AspCommon_Templates all;
  import from EUTRA_CellCfg_Templates all;
  import from EUTRA_POS_ASP_TypeDefs all;

  template (value) SYSTEM_CTRL_POSEXT_REQ cas_CellConfig_OTDOA_REQ(EUTRA_CellId_Type p_CellId,
                                                                   template (value) PRS_Info p_PRSInfo) :=
  { //See 37.571-2, 5.4.1.2
    /* @status    APPROVED (POS) */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, cs_TimingInfo_Now), //For configuration of antenna port 6 TimingInfo is now
    Request := {
      Cell := {
        AddOrReconfigure := {
          Basic := {
            PhysicalLayerConfigDL := {
              AntennaPort6 := {
                Port := cs_AntennaPort_Configure(6),
                PRS := p_PRSInfo,
                RelativeTxPower := 0  //Acc. 36.508, Table 6.2.1.2-1  @sic R5-234192 sic@
              }
            }
          }
        }
      }
    }
  };

  template (present) SYSTEM_CTRL_POSEXT_CNF car_CellConfig_PosExt_CNF(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (POS) */
    Common := cr_CnfAspCommonPart_CellCfg(p_CellId),
    Confirm := {
      Cell := true
    }
  };

}
