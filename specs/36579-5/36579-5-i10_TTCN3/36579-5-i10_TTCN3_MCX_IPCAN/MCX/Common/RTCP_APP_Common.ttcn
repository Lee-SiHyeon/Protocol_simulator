module RTCP_APP_Common {

  import from CommonDefs all;

  // RFC 3550
  type O4_Type RTP_SSRC;
  type record of RTP_SSRC RTP_SSRC_List;
  
  // RFC 3550 clause 6.7. 24.380 clause 8.1.2, 24.581 clause 9.1.2
  type record RTCP_APP_CommonHdr {
    B2_Type v,
    B1_Type p,
    B5_Type subtype,
    O1_Type ptt_app,
    O2_Type lgth,
    RTP_SSRC ssrc,
    O4_Type name
  };

  //----------------------------------------------------------------------------

  template (present) RTCP_APP_CommonHdr cr_RTCP_APP_CommonHdr(template (present) B5_Type p_Subtype,
                                                              template (present) RTP_SSRC p_SSRC,
                                                              O4_Type p_Name) :=
  { /* @status    APPROVED (MCX) */
    v := '10'B,                 // 24.380 clause 8.1.2
    p := '0'B,
    subtype := p_Subtype,
    ptt_app := 'CC'O,           // 204 - 24.380 clause 8.1.2
    lgth := ?,
    ssrc := p_SSRC,
    name := p_Name
  };

  template (value) RTCP_APP_CommonHdr cs_RTCP_APP_CommonHdr(B5_Type p_Subtype,
                                                            RTP_SSRC p_SSRC,
                                                            O4_Type p_Name) :=
  { /* @status    APPROVED (MCX) */
    v := '10'B,                 // 24.380 clause 8.1.2
    p := '0'B,
    subtype := p_Subtype,
    ptt_app := 'CC'O,           // 204 - 24.380 clause 8.1.2
    lgth := '0000'O,            // Value to be set by the encoder
    ssrc := p_SSRC,
    name := p_Name
  };

}
