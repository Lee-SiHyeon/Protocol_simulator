module PosSystem_CommonEUTRA {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from CommonDefs all;
  import from EUTRA_POS_Component all;
  import from PosSystem_ASP_TypeDefs all;
  import from PosSystem_Control all;

  /*
   * @desc      common function to retrieve Assistance Data from the SS;
   *            bitstrings are encoded/decoded to the corresponding EUTRA specific types
   * @param     p_PosSystemListId
   * @param     p_RequestAssistanceData
   * @return    ProvideAssistanceData_r9_IEs
   * @status    APPROVED (POS)
   */
  function f_POS_EUTRA_RetrieveData (PositioningSystemList_Type p_PosSystemListId,
                                     template RequestAssistanceData_r9_IEs p_RequestAssistanceData) runs on EUTRA_POS_PTC return ProvideAssistanceData_r9_IEs
  {
    var bitstring v_RequestAssistanceData_BitStr;
    var AssistanceDataRetrieveResponse_Type v_AssistanceDataRetrieveResponse;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistanceData;
    var integer v_DecResult;
    
    v_RequestAssistanceData_BitStr := encvalue(p_RequestAssistanceData);

    // Retrieve Assistance Data
    v_AssistanceDataRetrieveResponse := f_SatSystem_RetrieveData(POSSYS,
                                                                 p_PosSystemListId,
                                                                 cs_AssistanceDataRetrieveRequestLPP ({cs_LPP_AssistanceDataRequest(v_RequestAssistanceData_BitStr)}));
    
    if (isvalue(v_AssistanceDataRetrieveResponse.LPP[0].LPP_AssistanceData)) {
      v_DecResult := decvalue(v_AssistanceDataRetrieveResponse.LPP[0].LPP_AssistanceData, v_ProvideAssistanceData);
      if (v_DecResult != 0) {
        FatalError(__FILE__, __LINE__, "cannot decode LPP_AssistanceData");
      }
    }
    return v_ProvideAssistanceData;
  }

}
