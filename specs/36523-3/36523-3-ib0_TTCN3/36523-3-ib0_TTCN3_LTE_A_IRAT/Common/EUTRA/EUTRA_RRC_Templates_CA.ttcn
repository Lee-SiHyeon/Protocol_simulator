    p_Max_r10 := omit,
    uplinkPowerControlCommonSCell_r10 := cs_UplinkPowerControlCommonSCell,
    soundingRS_UL_ConfigCommon_r10 := p_SoundingRS_UL_ConfigCommon,
    ul_CyclicPrefixLength_r10 := len1,
    prach_ConfigSCell_r10 := omit,
    pusch_ConfigCommon_r10 := cs_508_PUSCH_ConfigCommon_Default(p_PuschHoppingOffset)
  };

  template (value) RadioResourceConfigCommonSCell_r10 cs_508_RadioResourceConfigCommonSCell_r10_DEFAULT(SCell_DL_Bandwidth_Type p_SCell_DL_Bandwidth,
                                                                                                        P_b_Type p_P_b,
                                                                                                        template (omit) CommonSCell_UL_Configuration_Type p_SCell_UL_Configuration := omit,
                                                                                                        template (omit) TDD_Config p_TDD_Config := omit,
