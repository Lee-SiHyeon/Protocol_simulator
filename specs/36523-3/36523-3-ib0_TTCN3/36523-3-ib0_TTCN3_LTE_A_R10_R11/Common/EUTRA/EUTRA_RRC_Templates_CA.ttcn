    soundingRS_FlexibleTiming_r14       := omit,       /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    mbsfn_SubframeConfigList_v1430      := omit,       /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
