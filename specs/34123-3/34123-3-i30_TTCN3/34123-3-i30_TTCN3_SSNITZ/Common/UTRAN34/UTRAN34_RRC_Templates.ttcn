  template (value) HSPA_InfoPerCell_Type cs_HSPA_InfoPerCell_Def :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    // 64 QAM
    dl_64QAM := false,
    hS_SCCH_Info := cs_HS_SCCH_Info_r9_FDD,
    // OCTETALIGNED
    octetAlignedConfigured := false,
    hS_DSCH_TBSizeTable:= omit
  };

  template (value) UTRAN34_HSPA_Parameters_Type cs_HSPA_Parameters_Def :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    hSPA_InfoPerCell := {cs_HSPA_InfoPerCell_Def, cs_HSPA_InfoPerCell_Def, cs_HSPA_InfoPerCell_Def, cs_HSPA_InfoPerCell_Def},
    // RLC parameters
    transmissionWindowSize := tw256,
    receivingWindowSize := rw768,
    // MIMO parameters
    mimo := false,
    mimo_Parameters_r9 := omit,
    // Channelisation codes
    dl_DPCH_SFC := tsc_Sfc256_C12,
    dl_FDPCH_Code := 12,
    s_CPICH_ChCode := omit,
    TFRCconfigure_ExtList := omit, //@sic R5-145142 sic@: Field renamed and changed into a list
    deltaACK := 3,
    deltaNACK := 3,
    ack_NACK_repetition_factor := 1,
    hARQ_Info_r7 := cs_HARQ_Info_FDD
  };

  template (value) UL_DPCH_PowerControlInfo cs_UL_DPCH_PowerControlInfo_FDDr99 :=
