module MCX_XML_xcap_diff {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttGKTP_1_0 language "XSD" all;
  import from urn_ietf_params_xml_ns_xcap_diff language "XSD" all;

  type Xcap_diff MCX_XcapDiff_Type;                                                   /* alias to avoid import of urn_ietf_params_xml_ns_xcap_diff in modules using this module
                                                                                         @status    APPROVED (MCX) */

  type Xcap_diff.sequence.sequence_list[-] MCX_XcapDiff_SequenceListEntry_Type;       /* @status    APPROVED (MCX) */

  type SingleTypeGKTPsType MCX_SingleTypeGKTPs_Type;                                  /* @status    APPROVED (MCX) */

  template (value) DocumentType cs_XCAP_DIFF_Document(XSD.AnyURI p_Sel,
                                                      template (omit) XSD.String p_NewETag,
                                                      template (omit) XSD.String p_PrevETag,
                                                      template (omit) DocumentType.choice p_PatchingInstructions := omit) :=
  { /* @status    APPROVED (MCX) */
    new_etag := p_NewETag,
    previous_etag  := p_PrevETag,
    sel := p_Sel,
    attr := omit,
    choice := p_PatchingInstructions
  };

  template (value) MCX_XcapDiff_SequenceListEntry_Type cs_XCAP_DIFF_SingleDocument(template (value) DocumentType p_Document) :=
  { /* @status    APPROVED (MCX) */
    choice := {
      document := p_Document
    }
  };

  template (value) ElementType cs_XCAP_DIFF_Element(XSD.AnyURI p_Sel,
                                                    XSD.String p_Content) :=
  { /* @status    APPROVED (MCX) */
    embed_values := {},
    exists := omit,
    sel := p_Sel,
    attr := omit,
    elem := p_Content
  };

  template (value) MCX_XcapDiff_SequenceListEntry_Type cs_XCAP_DIFF_SingleElement(template (value) ElementType p_Element) :=
  { /* @status    APPROVED (MCX) */
    choice := {
      element := p_Element
    }
  };

  template (value) Xcap_diff cs_XCAP_DIFF_Message(XSD.AnyURI p_XcapRoot,
                                                  template (value) Xcap_diff.sequence.sequence_list p_SequenceList) :=
  { /* @status    APPROVED (MCX) */
    xcap_root := p_XcapRoot,
    attr := omit,
    sequence := {
      sequence_list := p_SequenceList,
      elem_list := {}
    }
  };

  template (value) GKTPs cs_GKTPs(template (omit) SingleTypeGKTPsType p_GMK_GKTPs) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    gMK_GKTPs := p_GMK_GKTPs,
    mKFC_GKTPs := omit,
    anyExt := omit,
    elem_list := {}
  };

  template (value) SingleTypeGKTPsType cs_SingleTypeGKTPs(template (value) SingleTypeGKTPsType.gKTP_list p_GKTP_list,
                                                          template (value) SingleTypeGKTPsType.on_network_regrouped_GKTPs_list p_RegroupedGKTPsList := {}) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    gKTP_list := p_GKTP_list,
    on_network_regrouped_GKTPs_list := p_RegroupedGKTPsList,
    anyExt := omit,
    elem_list := {}
  };

  template (value) GKTPType cs_SingleGKTP(XSD.String p_Id,
                                          bitstring p_EncodedMikeyMsg) :=
  { /* @status    APPROVED (MCX) */
    activationtime := omit,                                     /* @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@ */
    id := p_Id,
    attr := omit,
    base := bit2oct(p_EncodedMikeyMsg)
  };

  template (value) On_network_regrouped_GKTPsType cs_On_network_regrouped_GKTPs(charstring p_GroupID,
                                                                                bitstring p_EncodedMikeyMsg) :=
  { /* Contains GMK for temporary group */
    /* @status    APPROVED (MCX) */
    temporary_MCPTT_group_ID := p_GroupID,
    attr := omit,
    gKTP_list := { cs_SingleGKTP("GKTP id for temporary group", p_EncodedMikeyMsg) },
    anyExt := omit,
    elem_list := {}
  };

  /*
   * @desc      return xcap-diff entry for single document
   * @param     p_Sel
   * @param     p_ETagPrefix
   * @param     p_NewETagIndex      (default value: 1)
   * @return    template (value) MCX_XcapDiff_SequenceListEntry_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_XcapDiff_SingleDocument(charstring p_Sel,
                                          XSD.String p_ETagPrefix,
                                          integer p_NewETagIndex := 1) return template (value) MCX_XcapDiff_SequenceListEntry_Type
  {
    var integer v_PrevETagIndex;
    var XSD.String v_NewETag;
    var XSD.String v_PrevETag;
  
    if (p_NewETagIndex == 1) {          // => initial notification
      v_PrevETagIndex := p_NewETagIndex;
    } else {                            // => notification for change of the document
      v_PrevETagIndex := p_NewETagIndex - 1;
    }
    v_NewETag := p_ETagPrefix & int2str(p_NewETagIndex);
    v_PrevETag := p_ETagPrefix & int2str(v_PrevETagIndex);

    return cs_XCAP_DIFF_SingleDocument(cs_XCAP_DIFF_Document(p_Sel, v_NewETag, v_PrevETag));
  }

  /*
   * @desc      return xcap-diff entry for service configuration document
   * @param     p_ServiceType
   * @param     p_NewETagIndex      (default value: 1)
   * @return    template (value) MCX_XcapDiff_SequenceListEntry_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_ServiceConfig(MCX_ServiceType_Type p_ServiceType,
                                        integer p_NewETagIndex := 1) return template (value) MCX_XcapDiff_SequenceListEntry_Type
  {
    var charstring v_Sel := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, xcap_diff, UESERVCONFIG);
    var XSD.String v_ETagPrefix := "g8tyah7-service-config-";           // arbitrarily selected

    return fl_MCX_XcapDiff_SingleDocument(v_Sel, v_ETagPrefix, p_NewETagIndex);
  }

  /*
   * @desc      return xcap-diff entry for user profile document
   * @param     p_ServiceType
   * @param     p_NewETagIndex      (default value: 1)
   * @return    template (value) MCX_XcapDiff_SequenceListEntry_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_UserProfile(MCX_ServiceType_Type p_ServiceType,
                                      integer p_NewETagIndex := 1) return template (value) MCX_XcapDiff_SequenceListEntry_Type
  {
    var charstring v_Sel := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, xcap_diff, UEUSERPROF);
    var XSD.String v_ETagPrefix := "g8tyah7-user-profile-";             // arbitrarily selected

    return fl_MCX_XcapDiff_SingleDocument(v_Sel, v_ETagPrefix, p_NewETagIndex);
  }

  /*
   * @desc      return xcap-diff entry for UE configuration document
   * @param     p_ServiceType
   * @param     p_MCSUEID
   * @param     p_NewETagIndex      (default value: 1)
   * @return    template (value) MCX_XcapDiff_SequenceListEntry_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_UEConfig(MCX_ServiceType_Type p_ServiceType,
                                   charstring p_MCSUEID,
                                   integer p_NewETagIndex := 1) return template (value) MCX_XcapDiff_SequenceListEntry_Type
  {
    var charstring v_Sel := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, xcap_diff, UECONFIG, -, p_MCSUEID);
    var XSD.String v_ETagPrefix := "g8tyah7-ue-config-";                // arbitrarily selected

    return fl_MCX_XcapDiff_SingleDocument(v_Sel, v_ETagPrefix, p_NewETagIndex);
  }

  /*
   * @desc      xcap-diff document according to 36.579-1 Table 5.5.3.12-1
   * @param     p_ServiceType
   * @param     p_MCSUEID
   * @return    template (value) Xcap_diff
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_CONFIG(MCX_ServiceType_Type p_ServiceType,
                                 charstring p_MCSUEID) return template (value) Xcap_diff
  {
    var template (value) Xcap_diff.sequence.sequence_list v_ElementList := {
      f_MCX_XcapDiff_ServiceConfig(p_ServiceType),
      f_MCX_XcapDiff_UserProfile(p_ServiceType),
      f_MCX_XcapDiff_UEConfig(p_ServiceType, p_MCSUEID)
    };
    return cs_XCAP_DIFF_Message(tsc_MCX_CMSXCAPRootURI, v_ElementList);
  }

  /*
   * @desc      xcap-diff document according to 36.579-1 Table 5.5.3.12-2 condition GROUPCONFIG
   * @param     p_ServiceType
   * @param     p_GroupId
   * @param     p_NewETagIndex      (default value: 1)
   * @return    template (value) Xcap_diff
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_GROUPCONFIG(MCX_ServiceType_Type p_ServiceType,
                                      charstring p_GroupId,
                                      integer p_NewETagIndex := 1) return template (value) Xcap_diff
  {
    var template (value) Xcap_diff.sequence.sequence_list v_ElementList;
    var charstring v_Sel := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, xcap_diff, GROUPCONFIG, p_GroupId);
    var XSD.String v_ETagPrefix := "g8tyah7-group-config-";                   // arbitrarily selected

    v_ElementList := {
      fl_MCX_XcapDiff_SingleDocument(v_Sel, v_ETagPrefix, p_NewETagIndex)
    };
    return cs_XCAP_DIFF_Message(tsc_MCX_GMSXCAPRootURI, v_ElementList);
  }

  /*
   * @desc      xcap-diff document according to 36.579-1 Table 5.5.3.12-2 condition GROUPKEY
   * @param     p_ServiceType
   * @param     p_GroupId
   * @param     p_EncodedMikeyMsg
   * @param     p_RegroupedGKTPsList (default value: {})
   * @return    template (value) Xcap_diff
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_GROUPKEY(MCX_ServiceType_Type p_ServiceType,
                                   charstring p_GroupId,
                                   bitstring p_EncodedMikeyMsg,
                                   template (value) SingleTypeGKTPsType.on_network_regrouped_GKTPs_list p_RegroupedGKTPsList := {}) return template (value) Xcap_diff
  {
    var template (value) Xcap_diff.sequence.sequence_list v_ElementList;
    var charstring v_Sel := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, xcap_diff, GROUPKEY, p_GroupId);
    var charstring v_GKTP_id := "36.579-1 Table 5.5.9.1-3 condition " & p_GroupId;
    var template (value) SingleTypeGKTPsType.gKTP_list v_GKTP_list := { cs_SingleGKTP(v_GKTP_id, p_EncodedMikeyMsg) };
    var template (value) GKTPs v_GKTPs := cs_GKTPs(cs_SingleTypeGKTPs(v_GKTP_list, p_RegroupedGKTPsList));
    var universal charstring v_EncodedGKTPs := f_Bit2Unichar(encvalue(v_GKTPs));

    v_ElementList := {
      cs_XCAP_DIFF_SingleElement(cs_XCAP_DIFF_Element(v_Sel, v_EncodedGKTPs))
    };
    return cs_XCAP_DIFF_Message(tsc_MCX_GMSXCAPRootURI, v_ElementList);
  }

  /*
   * @desc      Encode and encrypt XCAP-diff document
   * @param     p_Xcap_diff
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_XcapDiff_EncodeEncrypt(template (value) Xcap_diff p_Xcap_diff,
                                        charstring p_MCServiceID,
                                        template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_Bit2Unichar(encvalue(p_Xcap_diff));

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    f_XML_Document_EncryptElementContent(v_XmlDocument, "//xcap-diff", p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

}
