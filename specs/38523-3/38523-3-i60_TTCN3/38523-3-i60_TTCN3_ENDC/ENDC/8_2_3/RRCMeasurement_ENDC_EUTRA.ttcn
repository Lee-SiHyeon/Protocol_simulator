                                                                                        FilterCoefficient p_FilterCoefficientRSRP,
                                                                                        FilterCoefficient p_FilterCoefficientRSRQ,
                                                                                        FilterCoefficient p_FilterCoefficientSINR,
                                                                                        template (omit) ReportQuantityNR_r15 p_ReportQuantityCellNR_r15 := omit) := //@sic R5-190621, R5-185070 sic@
    /* @status    APPROVED (ENDC) */
    cs_RRCConnectionReconfiguration_Common(p_RRC_TI,
                                           cs_MeasConfig(omit,
                                                         cs_MeasObjectToAddModList_1Entry(tsc_IdMeasObject_NR_f1,
                                                                                          cs_MeasObject_measObjectNR(p_NR_ARFCN_f1, p_SCS, p_FreqBandIndicatorNR_r15)), //@sic R5-194875 sic@
                                                         omit,
                                                         cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfig_B1_NR,
                                                                                            cs_508_ReportConfigInterRAT_Periodical_NR(p_ReportAmount, p_ReportQuantityCellNR_r15)),
                                                         omit,
                                                         cs_MeasIdToAddModList_1Entry(1, tsc_IdMeasObject_NR_f1, tsc_IdReportConfig_B1_NR),
                                                         cs_QuantityConfig_NR(cs_QuantityConfig_NRList(p_FilterCoefficientRSRP, p_FilterCoefficientRSRQ, p_FilterCoefficientSINR)), //@sic R5-185070 sic@
                                                         cs_508_ENDC_MeasGapConfig_GP2)); //@sic R5s190593 sic@

