  /*
   * @desc      Return AM UL default parameters as per 38.508-1
   * @param     p_IsFR1
   * @return    template (value) UL_AM_RLC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_UL_AM_RLC(boolean p_IsFR1) return template (value) UL_AM_RLC
  {
    var T_PollRetransmit v_T_PollRetransmit;

    if (p_IsFR1) {
      v_T_PollRetransmit := ms80;
    } else {
      v_T_PollRetransmit := ms30;
    }
    return cs_38508_UL_AM_RLC(v_T_PollRetransmit);
  }

  /*
   * @desc      Return AM DL default parameters as per 38.508-1
   * @param     p_IsFR1
   * @return    template (value) DL_AM_RLC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DL_AM_RLC(boolean p_IsFR1) return template (value) DL_AM_RLC
  {
    var T_Reassembly v_T_Reassembly;

    if (p_IsFR1) {
      v_T_Reassembly := ms80;
    } else {
      v_T_Reassembly := ms30;
    }
    return cs_38508_DL_AM_RLC(v_T_Reassembly);
  }

  template (value) RLC_Config cs_38508_RLC_Config_UM_DRB(template (value) UL_UM_RLC p_UL_UM_RLC,
                                                         template (value) DL_UM_RLC p_DL_UM_RLC) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT) */
    // Acc to 38.508-1 Table 4.6.3-149: RLC-Config
    um_Bi_Directional  := {
      ul_UM_RLC  := p_UL_UM_RLC,
      dl_UM_RLC  := p_DL_UM_RLC
    }
  };

  template (value) UL_UM_RLC cs_38508_UL_UM_RLC(template (omit) SN_FieldLengthUM p_Len) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT) */
    sn_FieldLength  := p_Len
  };

  template (value) DL_UM_RLC cs_38508_DL_UM_RLC(template (omit) SN_FieldLengthUM p_Len,
                                                T_Reassembly p_T_Reassembly) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT) */
    sn_FieldLength   := p_Len,
    t_Reassembly     := p_T_Reassembly
  };

  /*
   * @desc      Return UM DL default parameters as per 38.508-1
   * @param     p_IsFR1
   * @return    template (value) DL_UM_RLC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_DL_UM_RLC(boolean p_IsFR1) return template (value) DL_UM_RLC
  {
    var T_Reassembly v_T_Reassembly := f_NR_DL_UM_T_Reassembly(p_IsFR1);
    var SN_FieldLengthUM v_Len;

    if (pc_um_WithLongSN) {
      v_Len := size12;
    } else if (pc_um_WithShortSN and not pc_um_WithLongSN) {
      v_Len := size6;
    } else {
      FatalError(__FILE__, __LINE__, "At least one UM PICS must be specified");
    }
    return cs_38508_DL_UM_RLC(v_Len, v_T_Reassembly);
  }

  /*
   * @desc      Return UM DL T Reassembly default value as per 38.508-1
   * @param     p_IsFR1
   * @return    T_Reassembly
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_DL_UM_T_Reassembly(boolean p_IsFR1) return T_Reassembly
  {
    var T_Reassembly v_T_Reassembly;

    if (p_IsFR1) { //@sic R5-187675 sic@
      v_T_Reassembly := ms80;
    } else {
      v_T_Reassembly := ms30;
    }
    return v_T_Reassembly;
  }

  /*
   * @desc      Return UM UL default parameters as per 38.50-1
   * @return    template (value) UL_UM_RLC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_UL_UM_RLC() return template (value) UL_UM_RLC
  {
    var SN_FieldLengthUM v_Len;

    if (pc_um_WithLongSN) {
      v_Len := size12;
    } else if (pc_um_WithShortSN and not pc_um_WithLongSN) {
      v_Len := size6;
    } else {
      FatalError(__FILE__, __LINE__, "At least one UM PICS must be specified");
    }
    return cs_38508_UL_UM_RLC(v_Len);
  }

