module V2X_CommonFunctions {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;

  type  SL_CommResourcePoolV2X_r14.sizeSubchannel_r14   SL_SizeSubchannel_r14_Type; /* @status    APPROVED (LTE_A_PRO) */

  type  SL_CommResourcePoolV2X_r14.numSubchannel_r14    SL_NumSubchannel_r14_Type;  /* @status    APPROVED (LTE_A_PRO) */

  const B20_Type tsc_V2X_BITMAP_6 := '11111111111111111111'B;          /* @status    APPROVED (LTE_A_PRO) */

  const B24_Type tsc_ServiceDestination_Layer2Id := '000000000000000010101010'B; /* Acc to 36.508 DestinationLayer2ID @sic R5-181216 sic@
                                                                                    @status    APPROVED (LTE_A_PRO) */

  template (value) SL_CommResourcePoolV2X_r14 cs_SL_CommResourcePoolV2X(B20_Type p_Bitmap,
                                                                       SL_SizeSubchannel_r14_Type p_SizeSubchannel,
                                                                       template (omit) SL_TxParameters_r12 p_SL_TxParameters := omit,
                                                                       SL_NumSubchannel_r14_Type p_NumSubchannel := n10,
                                                                       template (omit) SL_P2X_ResourceSelectionConfig_r14 p_P2X_Config := omit,
                                                                       template (omit) integer p_ZoneId := omit,
                                                                       template (omit) SL_CBR_PPPP_TxConfigList_r14 p_CBR_PSSCH_TxConfigList := omit,
                                                                       template (omit) integer p_ThreshS_RSSI_CBR := omit,
                                                                       template (omit) SL_V2X_TxPoolReportIdentity_r14 p_PoolReportId := omit
                                                                       ) :=
  { //Acc 36.508 Table 4.6.3-20C: SL-CommResourcePoolV2X-r14-DEFAULT
    /* @status    APPROVED (LTE_A_PRO) */
    sl_OffsetIndicator_r14 := omit,
    sl_Subframe_r14 := {
        bs20_r14 := p_Bitmap
    },
    adjacencyPSCCH_PSSCH_r14 := true,
    sizeSubchannel_r14 := p_SizeSubchannel,
    numSubchannel_r14 := p_NumSubchannel,
    startRB_Subchannel_r14 := 0,
    startRB_PSCCH_Pool_r14 := omit,
    rxParametersNCell_r14 := omit,
    dataTxParameters_r14 := p_SL_TxParameters,
    zoneID_r14 := p_ZoneId,
    threshS_RSSI_CBR_r14 := p_ThreshS_RSSI_CBR,
    poolReportId_r14 := p_PoolReportId,
    cbr_pssch_TxConfigList_r14 := p_CBR_PSSCH_TxConfigList,
    resourceSelectionConfigP2X_r14 := p_P2X_Config,
    syncAllowed_r14 := omit,
    restrictResourceReservationPeriod_r14 := omit,
    sl_MinT2ValueList_r15 := omit,                     /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    cbr_pssch_TxConfigList_v1530 := omit,              /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    sl_A2X_Service_r18 := omit                         /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
   };

  /*
   * @desc      Return SL sizeSubchannel depending on the bandwidth as per 36.508 Table 4.6.3-20C: SL-CommResourcePoolV2X-r14-DEFAULT
   *            Used in Sysinfo and SS-UE configuration
   * @param     p_Bandwidth
   * @return    SL_SizeSubchannel_r14_Type
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_V2X_ReturnSL_SizeSubchannel (integer p_Bandwidth) return SL_SizeSubchannel_r14_Type
  {
    var SL_SizeSubchannel_r14_Type v_SizeSubchannel;
    select (p_Bandwidth) {
      case (50) {// ChBandwidth = 10
        v_SizeSubchannel := n5;
      }
      case (100) {// ChBandwidth = 20
        v_SizeSubchannel := n10;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid Bandwidth");
      }
    }
    return v_SizeSubchannel;
   }

  /*
   * @desc      Return The SCI1 Frequency Resource Location as per 36.523-3 clause 7.29.2
   * @param     p_Bandwidth
   * @return    bitstring
   * @status    APPROVED (LTE_A_PRO)
   */
   function f_V2X_SetSCI_FrequencyResourceLocation(integer p_Bandwidth) return bitstring
   {
    var bitstring v_SCI_RIV := '0'B;
     
    select (p_Bandwidth) {//Set SCI According to 36.523-3 clause 7.29.2
        case(50) {v_SCI_RIV := '11110'B;}  //BW10 (RIV=30) @sic R5s180530 sic@
        case(100) {v_SCI_RIV := '1010'B;}  //BW20 (RIV=10)
        case else { FatalError (__FILE__, __LINE__, "invalid value for ChannelBandwidth");}
    }
    return v_SCI_RIV;
     
   }

}
