  //----------------------------------------------------------------------------
  testcase TC_13_4_3_10() runs on MTC_LTE_A_IRAT system SYSTEM_LTE_A_IRAT {
    // @purpose
    //   Inter-system mobility / E-UTRA voice to UTRA CS voice / aSRVCC / MT call
    var EUTRA_PTC        v_EUTRA      := null;
    var UTRAN_IRAT_PTC   v_UTRAN      := null;
    var GERAN_PTC        v_GERAN      := null;
    var CDMA2000_PTC     v_CDMA2000   := null;
    var WLAN_PTC         v_WLAN       := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(360);
  
    v_EUTRA := EUTRA_PTC.create("EUTRA") alive;
    v_UTRAN := UTRAN_IRAT_PTC.create("UTRAN") alive;
    v_IMS1 := IMS_PTC.create("IMS1") alive;
  
    f_MTC_ConnectPTCs_LTE_A_IRAT(system, v_EUTRA, v_UTRAN, v_GERAN, v_CDMA2000, v_WLAN, v_IMS1, v_IMS2);
  
    v_EUTRA.start(f_TC_13_4_3_10_EUTRA());
    v_UTRAN.start(f_TC_13_4_3_10_UTRAN());
    v_IMS1.start(f_TC_13_4_3_10_IMS1());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_LTE_A_IRAT(t_GuardTimer);
  }
