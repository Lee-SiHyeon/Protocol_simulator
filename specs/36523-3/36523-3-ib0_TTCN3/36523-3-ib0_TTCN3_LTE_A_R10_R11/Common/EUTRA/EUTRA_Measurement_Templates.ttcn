  template (present) UL_DCCH_Message cr_MeasurementReport_Common(template (present) integer p_MeasId,
                                                                 template (present) RSRP_Range p_RsrpResult,
                                                                 template (present) RSRQ_Range p_RsrqResult,
                                                                 template MeasResults.measResultNeighCells p_MeasResultNeighCells,
                                                                 template MeasResultForECID_r9 p_MeasResultForECID_r9 := omit,
                                                                 template LocationInfo_r10 p_LocationInfo_r10 := omit,
                                                                 template MeasResultServFreqList_r10 p_MeasResultServFreqList_r10 := omit,
                                                                 template MeasId_v1250 p_MeasId_v1250 := *,
                                                                 template RSRQ_Range_v1250 p_RSRQ_Range_v1250 := *,
                                                                 template MeasResultCSI_RS_List_r12 p_MeasResultCSI_RS_List_r12 := *,
                                                                 template MeasResultForRSSI_r13 p_MeasResultForRSSI_r13 := *,
                                                                 template UL_PDCP_DelayResultList_r13 p_UL_PDCP_DelayResultList := *,
                                                                 template  MeasResults.logMeasResultListWLAN_r15 p_LogMeasResultListWlan_r15 := *,
                                                                 template MeasResults.heightUE_r15 p_LogMeasResultList_heightUE_r15 := *) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    message_ := {
      c1 := {
        measurementReport := {
          criticalExtensions := {
            c1 := {
              measurementReport_r8 := {
                measResults := {
                  measId := p_MeasId,
                  measResultPCell := {
                    rsrpResult := p_RsrpResult,
                    rsrqResult := p_RsrqResult
                  },
                  measResultNeighCells := p_MeasResultNeighCells ifpresent,
                  measResultForECID_r9 := p_MeasResultForECID_r9,                          /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
                  locationInfo_r10 := p_LocationInfo_r10,                                  /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
                  measResultServFreqList_r10 := p_MeasResultServFreqList_r10 ifpresent,    /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
                  measId_v1250 := p_MeasId_v1250,                                          /* @sic BASELINE MOVING 2015 sic@ */
                  measResultPCell_v1250 := p_RSRQ_Range_v1250,                             /* @sic BASELINE MOVING 2015 sic@ */
                  measResultCSI_RS_List_r12 := p_MeasResultCSI_RS_List_r12,                /* @sic BASELINE MOVING 2015 sic@ */
                  measResultForRSSI_r13 := p_MeasResultForRSSI_r13,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultServFreqListExt_r13 := *,    /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultSSTD_r13 := *,               /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultPCell_v1310 := *,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  ul_PDCP_DelayResultList_r13 := p_UL_PDCP_DelayResultList,      /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultListWLAN_r13 := *,           /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultPCell_v1360 := *,            /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultListCBR_r14 := *,            /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultListWLAN_r14 := *,           /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultServFreqListNR_r15 := *,     /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
                  measResultCellListSFTD_r15 := *,       /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
                  logMeasResultListBT_r15 := *,          /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  logMeasResultListWLAN_r15 := p_LogMeasResultListWlan_r15,        /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  measResultSensing_r15 := *,            /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  heightUE_r15 := p_LogMeasResultList_heightUE_r15,                     /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  ul_PDCP_DelayValueResultList_r16 := *, /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
                  measResultForRSSI_NR_r16 := *,         /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
                  uncomBarPreMeasResult_r17:= *,         /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
                  coarseLocationInfo_r17   := *          /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
                },
                nonCriticalExtension := *                //according to 36.508 4.6.1 table 4.6.1-5
              }
            }
          }
        }
      }
    }
  };

  template (present) UL_DCCH_Message cr_MeasurementReport(template (present) integer p_MeasId,
                                                          template (present) RSRP_Range p_RsrpResult,
                                                          template (present) RSRQ_Range p_RsrqResult,
                                                          template MeasResults.measResultNeighCells p_MeasResultNeighCells,
                                                          template MeasResultForECID_r9 p_MeasResultForECID_r9 := omit,
                                                          template LocationInfo_r10 p_LocationInfo_r10 := omit,
                                                          template MeasResultServFreqList_r10 p_MeasResultServFreqList_r10 := omit) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    cr_MeasurementReport_Common(p_MeasId,
                                p_RsrpResult,
                                p_RsrqResult,
                                p_MeasResultNeighCells,
                                p_MeasResultForECID_r9,
                                p_LocationInfo_r10,
                                p_MeasResultServFreqList_r10);

  template (present) UL_DCCH_Message cr_MeasurementReport_CheckAny := cr_MeasurementReport(?, ?, ?, *); /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

