  const float tsc_IMS_WaitForTcpClose := 3.0;              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      To convert the enumerated p_DialogIndex to the corresponding event type
   * @param     p_DialogIndex
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SIP_SUBSCRIBE_DialogIndex2EventType(IMS_PTC_DialogIndex_Type p_DialogIndex) return charstring
  {
    var charstring v_EventType;

    select (p_DialogIndex) {
      case (confEventDialog)    { v_EventType := "conference"; }
      case (regEventDialog)     { v_EventType := "reg"; }
      case (msgSummaryDialog)   { v_EventType := "message-summary"; }
      case (presenceDialog1,
            presenceDialog2)    { v_EventType := "presence"; }
      case (xcapDiffDialogCMS,
            xcapDiffDialogGMS1,
            xcapDiffDialogGMS2,
            xcapDiffDialogGMS3,
            xcapDiffDialogGMS4) { v_EventType := "xcap-diff"; }
      case (pocSettingsDialog)  { v_EventType := "poc-settings"; }
      case else                 { FatalError(__FILE__, __LINE__, "invalid dialog"); }
    }
    return v_EventType;
  }

  /*
   * @desc      build up receive template for (case-insensitve) token
   * @param     p_Charstring
   * @return    template (present) charstring
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_TokenPattern(charstring p_Charstring) return template (present) charstring
  { /* @sic R5-140901: temporary solution - handle most common variants of the (case insensitive) token sic@ */
    var charstring v_CharstringPattern := p_Charstring;
    var charstring v_UpperCasePattern := f_StringToUpper(p_Charstring);
    var charstring v_LowerCasePattern := f_StringToLower(p_Charstring);
    
    if (lengthof(v_CharstringPattern) > 0) {
      v_CharstringPattern[0] := f_StringToUpper(v_CharstringPattern[0]);
    }
    return (pattern v_UpperCasePattern, pattern v_LowerCasePattern, pattern v_CharstringPattern);
  }

  /*
   * @desc      generic function to build a tag
   * @param     p_Method
   * @param     p_FromOrTo          (default value: "To")
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_GenerateTag(charstring p_Method,
                             charstring p_FromOrTo := "To") return charstring
  { /* p_Method  ..  e.g. "INVITE" */
    /* @sic R5-131897, R5-132063 - new generic function sic@ */
    return "abc-" & p_Method & "-" & p_FromOrTo & "tag";
  }

  /*
   * @desc      returns p_Char if it is not a reserved character or the encoded value
   * @param     p_Char
   * @param     p_EncodingType
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_URL_Encoding_SingleChar(Char1_Type p_Char,
                                      URL_Encoding_Type p_EncodingType) return charstring
  { /* @sic R5-225265, R5-225266: p_EncodingType; old implementations based on RFC 2396 may not url-encode the "*" sic@ */
    var Char1List_Type v_ReservedCharsWithoutAsterisk := {":", "/", "?", "#", "[", "]", "@", "!", "$", "&", "'", "(", ")", "+", ",", ";", "="}; // "reserved" characters according to RFC 3986 clause 2.2
    var Char1List_Type v_ToBeEncodedChars := v_ReservedCharsWithoutAsterisk & { "%" };          // according to RFC 3986 clause 2.4 the "%" needs to be encoded too
    var charstring v_EncodedChar;
    var integer i;

    if (p_EncodingType == urlEncodingRFC3986) {                                                 // @sic R5-225265, R5-225266 sic@
      v_ToBeEncodedChars := v_ToBeEncodedChars & { "*" };                                       // => reserved characters according to RFC 3986 clause 2.2 + "%"
    }

    for (i:=0; i < lengthof(v_ToBeEncodedChars); i:=i+1) {
      if (v_ToBeEncodedChars[i] == p_Char) {
        v_EncodedChar := "%" & oct2str(char2oct(p_Char));
        return v_EncodedChar;
      }
    }
    return p_Char;
  }

  /*
   * @desc      apply URL-encoded (or "percent-encoded") URL:
   *            reserved characters acc. to RFC 3986 are replaced by their percent-code
   * @param     p_Url
   * @param     p_EncodingType      (default value: urlEncodingRFC3986)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_URL_Encoding(charstring p_Url,
                          URL_Encoding_Type p_EncodingType := urlEncodingRFC3986) return charstring
  { /* @sic R5-225265, R5-225266: p_EncodingType; old implementations based on RFC 2396 may not url-encode the "*" sic@ */
    var charstring v_EncodedUrl := "";
    var integer i;

    for (i:=0; i < lengthof(p_Url); i:=i+1) {
      v_EncodedUrl := v_EncodedUrl & fl_URL_Encoding_SingleChar(p_Url[i], p_EncodingType);
    }
    return v_EncodedUrl;
  }

  /*
   * @desc      returns true in case of emergency call
   * @param     p_CallType
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_CallIsEmergency(IMS_CallType_Type p_CallType) return boolean
  {
    var boolean v_IsEmergency;
    select (p_CallType) {
      case (REGULAR_EMERGENCY, ASSERTED_EMERGENCY) { v_IsEmergency := true; }
      case else                                    { v_IsEmergency := false; }
    }
    return v_IsEmergency;
  }

}
