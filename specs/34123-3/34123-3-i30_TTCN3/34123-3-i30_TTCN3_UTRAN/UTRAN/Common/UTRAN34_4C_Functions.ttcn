module UTRAN34_4C_Functions {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_4C_ConfigurationSteps all;
  import from UTRAN34_4C_Templates all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_Parameters all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_RAB_Functions all;
  import from UTRAN_RRC_CommonTemplates all;

  /* @desc      Return F-DPCH slot format
   * @return    template (omit) FDPCH_SlotFormat
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SetFdpchSlotFormat() return template (omit) FDPCH_SlotFormat
  {
    var template (omit) FDPCH_SlotFormat v_FdpchSlotFormat:= omit;

    if (pc_EnhancedF_DPCH) {
      v_FdpchSlotFormat := 3;
    }
    return v_FdpchSlotFormat;
  }

  /* @desc      To setup a PS RADIO BEARER and to reconfigure the SS accordingly.
   *            See TS 34.108 cl. 4.8.3 for more details what bearers are configured.
   * @param     p_CellList
   * @param     p_Configuration_3C4C
   * @param     p_HSPA_Parameters
   * @param     p_RB_PrimaryCellConfiguration (default value: cell_E_HS)
   * @param     p_LoopbackRLC_PDU   (default value: false)
   * @param     p_RLC_Info          (default value: cs_RLC_InfoAM_Def)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RB_SetUp_4C(UTRAN_CellIdList_Type p_CellList,
                                 UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                 UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                 RB_ConfigType p_RB_PrimaryCellConfiguration := cell_E_HS,
                                 boolean   p_LoopbackRLC_PDU := false,
                                 template (value) RLC_Info_r7 p_RLC_Info := cs_RLC_InfoAM_Def) // This parameter is only used for RAB test cases
    runs on UTRAN_PTC
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var UTRAN_CFN_Info_Type v_CfnInfo := f_CalculateActTime(p_CellList[0]);
    var template (value) SS_ActivationTime v_SS_ActivationTime := cs_ActivateCFN(v_CfnInfo.actTime);
    
    // Send RB_Set Up for FDD
    f_UTRAN_RB_SetUp_Send(f_Get_cs_108_RB_SetUp_4C(p_CellList,
                                                   p_Configuration_3C4C,
                                                   p_HSPA_Parameters,
                                                   p_RB_PrimaryCellConfiguration,
                                                   v_CfnInfo,
                                                   p_RLC_Info));
    
    //Configure SS for 4C (A33, A34, A35, A36, A37 or A25a (for RAB test case)
    f_UTRAN34_Configure_4C(p_CellList,
                           p_Configuration_3C4C,
                           p_HSPA_Parameters,
                           p_RB_PrimaryCellConfiguration,
                           v_SS_ActivationTime,
                           p_LoopbackRLC_PDU);
    
    f_UTRAN_RRC_ReceiveRB_SetupCmpl_PS_RAB(p_CellList[0], p_RB_PrimaryCellConfiguration);
    
    f_UTRAN_SS_CipheringAM_RAB_UL_DL(p_CellList[0], ps_domain, p_RB_PrimaryCellConfiguration, v_SecurityInfo.authKeys.AuthPS.CK);
  }

  /*
   * @desc      Returns the RADIO BEARER SETUP for A36
   * @param     p_CellList
   * @param     p_Configuration_3C4C
   * @param     p_HSPA_Parameters
   * @param     p_RB_PrimaryCellConfiguration
   * @param     p_CfnInfo
   * @param     p_RLC_Info
   * @return    template (value) DL_DCCH_Message
   * @status    APPROVED (UTRAN)
   */
  function f_Get_cs_108_RB_SetUp_4C(UTRAN_CellIdList_Type p_CellList,
                                    UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                    UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters,
                                    RB_ConfigType  p_RB_PrimaryCellConfiguration,
                                    UTRAN_CFN_Info_Type   p_CfnInfo,
                                    template (value) RLC_Info_r7  p_RLC_Info)
    runs on UTRAN_PTC return template (value) DL_DCCH_Message
  {
    var template (value) DL_DCCH_Message v_RadioBearerSetup;
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
        
    select (p_RB_PrimaryCellConfiguration) {
      case (cell_DCH_HS_DSCH) {
        v_RadioBearerSetup := cs_108_RB_SetUpA25a_3C_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                             p_CfnInfo.actTime,
                                                             p_RLC_Info,
                                                             p_HSPA_Parameters,
                                                             f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellList[0]),
                                                             f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]),
                                                             f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[1]),
                                                             f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[2]),
                                                             f_UTRAN_CellInfo_GetUARFCN(p_CellList[1]),
                                                             f_UTRAN_CellInfo_GetUARFCN(p_CellList[2]));
          }
      case (cell_E_HS) {
        if ((p_Configuration_3C4C == C3_SingleBand) or (p_Configuration_3C4C == C3_DualBand)) {
          v_RadioBearerSetup := cs_108_RB_SetUpA36_A37_3C_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                  p_CfnInfo.actTime,
                                                                  p_HSPA_Parameters,
                                                                  f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellList[0]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[1]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[2]),
                                                                  f_UTRAN_CellInfo_GetUARFCN(p_CellList[1]),
                                                                  f_UTRAN_CellInfo_GetUARFCN(p_CellList[2]),
                                                                  f_UTRAN34_SetFdpchSlotFormat());
            }
        else if ((p_Configuration_3C4C == C3_SingleBand_Mimo) or (p_Configuration_3C4C == C3_DualBand_Mimo)) {
          v_RadioBearerSetup := cs_108_RB_SetUpA33_A34_3C_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                  p_CfnInfo.actTime,
                                                                  p_HSPA_Parameters,
                                                                  f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellList[0]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[1]),
                                                                  f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[2]),
                                                                  f_UTRAN_CellInfo_GetUARFCN(p_CellList[1]),
                                                                  f_UTRAN_CellInfo_GetUARFCN(p_CellList[2]),
                                                                  f_UTRAN34_SetFdpchSlotFormat());
            }
      }
      case (cell_DCH_E_HS) {
        if ((p_Configuration_3C4C == C3_SingleBand) or (p_Configuration_3C4C == C3_DualBand)) {
          v_RadioBearerSetup := cs_108_RB_SetUpA35_3C_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                              p_CfnInfo.actTime,
                                                              p_HSPA_Parameters,
                                                              f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellList[0]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[1]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[2]),
                                                              f_UTRAN_CellInfo_GetUARFCN(p_CellList[1]),
                                                              f_UTRAN_CellInfo_GetUARFCN(p_CellList[2]))
        }
        else if (p_Configuration_3C4C == C4_DualBand) {
          v_RadioBearerSetup := cs_108_RB_SetUpA35_4C_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                              p_CfnInfo.actTime,
                                                              p_HSPA_Parameters,
                                                              f_UTRAN_CellInfo_GetULScrmCode_FDD (p_CellList[0]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[1]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[2]),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[3]),
                                                              f_UTRAN_CellInfo_GetUARFCN(p_CellList[1]),
                                                              f_UTRAN_CellInfo_GetUARFCN(p_CellList[2]),
                                                              f_UTRAN_CellInfo_GetUARFCN(p_CellList[3]))
            }
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid 3C/4C configuration");
      }
    }
    return v_RadioBearerSetup;
  }

}
