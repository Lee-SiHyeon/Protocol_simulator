module MCX_ClientConfiguration_MCX_HTTP {

  import from MCX_CommonDefs all;
  import from MCX_CoordMsgs all;
  import from MCX_HTTP_CommonFunctions all;
  import from MCX_HTTP_Component all;
  import from MCX_SecurityParameters all;

  /*
   * @desc      Common test procedure for test case 5.1 (MCPTT, MCVideo, MCData)
   * @param     p_ServiceType
   * @status    APPROVED (MCX)
   */
  function f_MCX_5_1_HTTP(MCX_ServiceType_Type p_ServiceType) runs on MCX_HTTP_PTC
  { // Configuration / Authentication / User Authorisation / UE Configuration / User Profile / Key Generation
   
    var MCX_SecurityParameters_Type v_SecurityParameters;

    f_MCX_Preamble_HTTP(p_ServiceType, REGISTERED_ONLY);
    
    f_MCX_HTTP_TestBody_Set(true);
    
    // @siclog "Step 3 - 12" siclog@
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Part1(p_ServiceType);
    f_MCX_HTTP_PreliminaryPass(__FILE__, __LINE__, "Step 3-12");                // TP 1
    
    // @siclog "Step 13 - 16" siclog@
    v_SecurityParameters := f_MCX_HTTP_UserAuthentication_Part2(p_ServiceType, v_SecurityParameters);
    f_MCX_HTTP_PreliminaryPass(__FILE__, __LINE__, "Step 13-16");               // TP 2
    
    f_MCX_SendCoOrdMsg(IMS, cms_MCX_SecurityParameters(v_SecurityParameters));
    
    // @siclog "Step 18 - 19 in parallel siclog@
    f_MCX_HTTP_ConfigurationGroupManagementSubscription(p_ServiceType, v_SecurityParameters);   /* 36.579-1 Table 5.3.2.6.1-1: Step 5 - 10 (Configuration management) and
                                                                                                   36.579-1 Table 5.3.2.7.1-1: Step 5 - 6  (Group management) */
    f_MCX_HTTP_PreliminaryPass(__FILE__, __LINE__, "Step 18, 19");              // TP 4, 5

    f_MCX_SendTrigger(IMS);
    f_MCX_WaitForTrigger(IMS);      // IMS part is completed
    
    f_MCX_HTTP_TestBody_Set(false);

    f_MCX_Postamble_HTTP();
  }

}
