module MCX_XML_simple_filter {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from urn_ietf_params_xml_ns_simple_filter language "XSD" all;

  type Filter_set MCX_SimpleFilter_Type;                      /* @status    APPROVED (MCX) */

  /*
   * @desc      Decode SimpleFilter
   * @param     p_XmlDocument
   * @return    MCX_SimpleFilter_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SimpleFilter_Decode(XmlBody_Type p_XmlDocument) return MCX_SimpleFilter_Type
  {
    var bitstring v_Bitstring := f_XmlBody2Bit(p_XmlDocument);
    var Filter_set v_Filter_set;

    if (decvalue(v_Bitstring, v_Filter_set) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode SimpleFilter");
    }
    return v_Filter_set;
  }

}
