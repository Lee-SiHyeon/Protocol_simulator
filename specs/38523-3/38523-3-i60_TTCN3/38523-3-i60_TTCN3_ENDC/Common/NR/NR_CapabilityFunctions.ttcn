  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of multipleConfiguredGrants along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 12 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_multipleConfiguredGrants(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-225384 R5-244234 sic@
    var boolean v_Mac_ParametersXDD_Diff_multipleConfiguredGrants  := false;
    var boolean v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants := false;
    var boolean v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MAC_ParametersXDD_Diff v_MultipleConfiguredGrants_Common;
    var MAC_ParametersXDD_Diff v_FDD_Add_UE_NR_Cap;
    var MAC_ParametersXDD_Diff v_TDD_Add_UE_NR_Cap;

    if (ispresent(v_ReceivedCapabilityMsg.mac_Parameters.mac_ParametersXDD_Diff)) {
      v_MultipleConfiguredGrants_Common := v_ReceivedCapabilityMsg.mac_Parameters.mac_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff;
    }

    if (pc_multipleConfiguredGrants) {
      // check indication of mac-ParametersXDD-Diff
      if (ispresent(v_MultipleConfiguredGrants_Common.multipleConfiguredGrants)) {
          v_Mac_ParametersXDD_Diff_multipleConfiguredGrants := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap.multipleConfiguredGrants)) {
          v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap.multipleConfiguredGrants)) {
          v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_Mac_ParametersXDD_Diff_multipleConfiguredGrants, v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants, v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for multipleConfiguredGrants but pc_multipleConfiguredGrants is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_multipleConfiguredGrants to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_DualModeCheck()) and ((not v_Mac_ParametersXDD_Diff_multipleConfiguredGrants) or (v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants or v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants))) {
         f_SetVerdict(fail, __FILE__, __LINE__, "Reporting of FDD/TDD UE-NR-Capabilities IEs are inconsistent with pc_multipleConfiguredGrants on Single Mode"); // Fail case on Dual mode
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_Mac_ParametersXDD_Diff_multipleConfiguredGrants)
          {
             if (v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants and v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants) // fail case: both FDD and TDD capabilities are reported and IE mac_ParametersXDD_Diff.multipleConfiguredGrants is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_multipleConfiguredGrants or v_TDD_Add_UE_NR_Cap_multipleConfiguredGrants)  // fail cases: if mac_Parameters.mac_ParametersXDD_Diff.multipleConfiguredGrants is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_MultipleConfiguredGrants_Common.multipleConfiguredGrants) or ispresent(v_FDD_Add_UE_NR_Cap.multipleConfiguredGrants) or ispresent(v_TDD_Add_UE_NR_Cap.multipleConfiguredGrants)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_multipleConfiguredGrants to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of sftd_MeasNR_Neigh along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 13 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_sftd_MeasNR_Neigh(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5-225384 R5-197070 R5s191050 R5-206430 R5s210949 R5-232202 sic@
    var boolean v_MeasAndMobParamXDD_Diff_sftd_MeasNR_Neigh := false;
    var boolean v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD := false;
    var boolean v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersXDD_Diff v_Sftd_MeasNR_Neigh_Common;
    var MeasAndMobParametersXDD_Diff v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh;
    var MeasAndMobParametersXDD_Diff v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff)) {
      v_Sftd_MeasNR_Neigh_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }

    if (pc_SFTD_MeasNR_Neigh_FDD and not(pc_SFTD_MeasNR_Neigh_TDD)) {
       if ((not (ispresent(v_Sftd_MeasNR_Neigh_Common.sftd_MeasNR_Neigh) or ispresent(v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh))) and ispresent(v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh)){
          f_SetVerdict(inconc, __FILE__, __LINE__, "reporting of TDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_sftd_MeasNR_Neigh_TDD");
       }
    }
    if (pc_SFTD_MeasNR_Neigh_TDD and not(pc_SFTD_MeasNR_Neigh_FDD)) {
       if ((not (ispresent(v_Sftd_MeasNR_Neigh_Common.sftd_MeasNR_Neigh) or ispresent(v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh))) and ispresent(v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh)){
          f_SetVerdict(inconc, __FILE__, __LINE__, "reporting of FDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_sftd_MeasNR_Neigh_FDD");
       }
    }

    if (pc_SFTD_MeasNR_Neigh_FDD or pc_SFTD_MeasNR_Neigh_TDD) { //Case Feature is marked as supported by PICS, being sftd-MeasNR-Neigh optional
      // check indication of MeasAndMobParametersXDD_Diff_Common
      if (ispresent(v_Sftd_MeasNR_Neigh_Common.sftd_MeasNR_Neigh)) {
          v_MeasAndMobParamXDD_Diff_sftd_MeasNR_Neigh := true;
        }

      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh)) {
          v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD := true;
        }

      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh)) {
          v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD := true;
        }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamXDD_Diff_sftd_MeasNR_Neigh, v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD, v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for sftd_MeasNR_Neigh but pc_sftd_MeasNR_Neigh_FDD and/or pc_sftd_MeasNR_Neigh_TDD is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_SFTD_MeasNR_Neigh_FDD or pc_SFTD_MeasNR_Neigh_TDD to true is inconsistent with reported capabilities");
      }

      // Error cases if the feature is set
      if ((not f_NR_DualModeCheck()) and ((not v_MeasAndMobParamXDD_Diff_sftd_MeasNR_Neigh) or (v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD or v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD))) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_sftd_MeasNR_Neigh_FDD/pc_sftd_MeasNR_Neigh_TDD on Single Mode");
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_MeasAndMobParamXDD_Diff_sftd_MeasNR_Neigh)
          {
             if (v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD and v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD) // fail case: both FDD and TDD capabilities are reported and IE on sftd_MeasNR_Neigh_Common is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs is inconsistent");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD or v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh_XDD)  // fail cases: if IE measAndMobParameters.measAndMobParametersXDD_Diff.sftd_MeasNR_Neigh is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_Sftd_MeasNR_Neigh_Common.sftd_MeasNR_Neigh) or
          ispresent(v_FDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh) or
          ispresent(v_TDD_Add_UE_NR_Cap_sftd_MeasNR_Neigh.sftd_MeasNR_Neigh)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_sftd_MeasNR_Neigh_FDD/pc_sftd_MeasNR_Neigh_TDD to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of handoverInterF along with fr1-Add-UE-NR-Capabilities, fr2-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 14 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_handoverInterF_FRX_Diff(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5s190471 R5-197070 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamFRX_Diff_handoverInterF := false;
    var boolean v_FR1_Add_handoverInterF := false;
    var boolean v_FR2_Add_Cap_handoverInterF := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersFRX_Diff v_MeasAndMobParamFRX_handoverInterF_Common;
    var MeasAndMobParametersFRX_Diff v_FR1_Add_UE_NR_Cap_handoverInterF;
    var MeasAndMobParametersFRX_Diff v_FR2_Add_UE_NR_Cap_handoverInterF;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff)) {
      v_MeasAndMobParamFRX_handoverInterF_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR1_Add_UE_NR_Cap_handoverInterF := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR2_Add_UE_NR_Cap_handoverInterF := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }

    if(pc_handoverInterF) {
      // check indication of MeasAndMobParametersFRX_Diff_Common
      if (ispresent(v_MeasAndMobParamFRX_handoverInterF_Common.handoverInterF)) {
          v_MeasAndMobParamFRX_Diff_handoverInterF := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
          v_FR1_Add_handoverInterF := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
          v_FR2_Add_Cap_handoverInterF := true;
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_MeasAndMobParamFRX_Diff_handoverInterF) or v_FR1_Add_handoverInterF or v_FR2_Add_Cap_handoverInterF)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_handoverInterF on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_MeasAndMobParamFRX_Diff_handoverInterF)
          {
             if (v_FR1_Add_handoverInterF and v_FR2_Add_Cap_handoverInterF) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
             if ((not v_FR1_Add_handoverInterF) and (not v_FR2_Add_Cap_handoverInterF)) // inconclusive case: UE does not report any IE for handoverInterF but pc_handoverInterF is set
             {
                f_SetVerdict(inconc, __FILE__, __LINE__, "pc_handoverInterF is set but handoverInterF IEs are not reported by the UE");
             }
          }
          else
          if  (v_FR1_Add_handoverInterF or v_FR2_Add_Cap_handoverInterF)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_handoverInterF_Common.handoverInterF) or
              ispresent(v_FR1_Add_UE_NR_Cap_handoverInterF.handoverInterF) or
              ispresent(v_FR2_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_handoverInterF to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of handoverInterF along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 15 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_handoverInterF_XDD_Diff(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5-225384 R5-197070 R5s191050 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamXDD_Diff_handoverInterF := false;
    var boolean v_FDD_Add_UE_NR_Cap_handoverInterF_XDD := false;
    var boolean v_TDD_Add_UE_NR_Cap_handoverInterF_XDD := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersXDD_Diff v_HandoverInterF_Common;
    var MeasAndMobParametersXDD_Diff v_FDD_Add_UE_NR_Cap_handoverInterF;
    var MeasAndMobParametersXDD_Diff v_TDD_Add_UE_NR_Cap_handoverInterF;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff)) {
      v_HandoverInterF_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap_handoverInterF := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap_handoverInterF := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }

    if (pc_handoverInterF) {
      // check indication of MeasAndMobParametersXDD_Diff_Common
      if (ispresent(v_HandoverInterF_Common.handoverInterF)) {
          v_MeasAndMobParamXDD_Diff_handoverInterF := true;
        }

      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
          v_FDD_Add_UE_NR_Cap_handoverInterF_XDD := true;
        }

      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
          v_TDD_Add_UE_NR_Cap_handoverInterF_XDD := true;
        }

      // Error cases if the feature is set
      if ((not f_NR_DualModeCheck()) and (not v_MeasAndMobParamXDD_Diff_handoverInterF) or v_FDD_Add_UE_NR_Cap_handoverInterF_XDD or v_TDD_Add_UE_NR_Cap_handoverInterF_XDD) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_handoverInterF on Single Mode");
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_MeasAndMobParamXDD_Diff_handoverInterF)
          {
             if (v_FDD_Add_UE_NR_Cap_handoverInterF_XDD and v_TDD_Add_UE_NR_Cap_handoverInterF_XDD) // fail case: both FDD and TDD capabilities are reported and IE on HandoverInterF_Common is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs is inconsistent");
             }
             if ((not v_FDD_Add_UE_NR_Cap_handoverInterF_XDD) and (not v_TDD_Add_UE_NR_Cap_handoverInterF_XDD)) // inconclusive case: UE does not report any IE for handoverInterF but pc_handoverInterF is set
             {
                f_SetVerdict(inconc, __FILE__, __LINE__, "pc_handoverInterF is set but handoverInterF IEs are not reported by the UE");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_handoverInterF_XDD or v_TDD_Add_UE_NR_Cap_handoverInterF_XDD)  // fail cases: if IE measAndMobParameters.measAndMobParametersXDD_Diff.handoverInterF is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_HandoverInterF_Common.handoverInterF) or
          ispresent(v_FDD_Add_UE_NR_Cap_handoverInterF.handoverInterF) or
          ispresent(v_TDD_Add_UE_NR_Cap_handoverInterF.handoverInterF)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_handoverInterF to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of voiceOverNR along with fr1-Add-UE-NR-Capabilities, fr2-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 16 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_voiceOverNR(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-223496 sic@
    var boolean v_IMS_ParametersFRX_Diff_voiceOverNR := false;
    var boolean v_FR1_Add_voiceOverNR := false;
    var boolean v_FR2_Add_Cap_voiceOverNR := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var IMS_ParametersFRX_Diff v_MeasAndMobParamFRX_voiceOverNR_Common;
    var UE_NR_CapabilityAddFRX_Mode_v1540.ims_ParametersFRX_Diff v_FR1_Add_UE_NR_Cap_voiceOverNR;
    var UE_NR_CapabilityAddFRX_Mode_v1540.ims_ParametersFRX_Diff v_FR2_Add_UE_NR_Cap_voiceOverNR;

    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.ims_Parameters.ims_ParametersFRX_Diff)) {
      v_MeasAndMobParamFRX_voiceOverNR_Common := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.ims_Parameters.ims_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.fr1_Add_UE_NR_Capabilities_v1540.ims_ParametersFRX_Diff)) {
      v_FR1_Add_UE_NR_Cap_voiceOverNR := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.fr1_Add_UE_NR_Capabilities_v1540.ims_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.fr2_Add_UE_NR_Capabilities_v1540.ims_ParametersFRX_Diff)) {
      v_FR2_Add_UE_NR_Cap_voiceOverNR := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.fr2_Add_UE_NR_Capabilities_v1540.ims_ParametersFRX_Diff;
    }

    if(pc_voiceOverNR) {
      // check indication of MeasAndMobParametersFRX_Diff_Common
      if (ispresent(v_MeasAndMobParamFRX_voiceOverNR_Common.voiceOverNR)) {
          v_IMS_ParametersFRX_Diff_voiceOverNR := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_voiceOverNR.voiceOverNR)) {
          v_FR1_Add_voiceOverNR := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_voiceOverNR.voiceOverNR)) {
          v_FR2_Add_Cap_voiceOverNR := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_IMS_ParametersFRX_Diff_voiceOverNR, v_FR1_Add_voiceOverNR, v_FR2_Add_Cap_voiceOverNR)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for voiceOverNR but pc_voiceOverNR is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_voiceOverNR to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_IMS_ParametersFRX_Diff_voiceOverNR) or v_FR1_Add_voiceOverNR or v_FR2_Add_Cap_voiceOverNR)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_voiceOverNR on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_IMS_ParametersFRX_Diff_voiceOverNR)
          {
             if (v_FR1_Add_voiceOverNR and v_FR2_Add_Cap_voiceOverNR) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FR1_Add_voiceOverNR or v_FR2_Add_Cap_voiceOverNR)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_voiceOverNR_Common.voiceOverNR) or
              ispresent(v_FR1_Add_UE_NR_Cap_voiceOverNR.voiceOverNR) or
              ispresent(v_FR2_Add_UE_NR_Cap_voiceOverNR.voiceOverNR)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_voiceOverNR to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of dl-SchedulingOffset-PDSCH-TypeA along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 (and on) UEs.
                Note 17 on Table UE-NR-Capability phy-Parameters/phy-ParametersXDD-Diff
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_dl_SchedulingOffset_PDSCH_TypeA_XDD_Diff(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-227571 R5-227572 R5-227573 R5s230333 sic@
    var boolean v_Phy_ParametersXDD_Diff_dl_SchedulingOffset_PDSCH_TypeA := false;
    var boolean v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD := false;
    var boolean v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var Phy_ParametersXDD_Diff v_DL_SchedulingOffset_PDSCH_TypeA_Common;
    var Phy_ParametersXDD_Diff v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA;
    var Phy_ParametersXDD_Diff v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA;

    if (ispresent(v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersXDD_Diff)) {
      v_DL_SchedulingOffset_PDSCH_TypeA_Common := v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.phy_ParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.phy_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.phy_ParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.phy_ParametersXDD_Diff;
    }

    if (pc_dl_SchedulingOffset_PDSCH_TypeA) {
      // check indication of DL_SchedulingOffset_PDSCH_TypeA_Common
      if (ispresent(v_DL_SchedulingOffset_PDSCH_TypeA_Common.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_Phy_ParametersXDD_Diff_dl_SchedulingOffset_PDSCH_TypeA := true;
        }

      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD := true;
        }

      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD := true;
        }

      // Error cases if the feature is set
      if ((not f_NR_DualModeCheck()) and ((not v_Phy_ParametersXDD_Diff_dl_SchedulingOffset_PDSCH_TypeA) or v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD or v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD)) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_dl_SchedulingOffset_PDSCH_TypeA on Single Mode");
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_Phy_ParametersXDD_Diff_dl_SchedulingOffset_PDSCH_TypeA)
          {
             if (v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD and v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD) // fail case: both FDD and TDD capabilities are reported and IE on HandoverInterF_Common is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting both FDD/TDD_Add_UE_NR_Capabilities IEs is inconsistent");
             }
             if ((not v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD) and (not v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD)) // inconclusive case: UE does not report any IE for dl_SchedulingOffset_PDSCH_TypeA but pc_dl_SchedulingOffset_PDSCH_TypeA is set
             {
                f_SetVerdict(inconc, __FILE__, __LINE__, "pc_dl_SchedulingOffset_PDSCH_TypeA is set but dl_SchedulingOffset_PDSCH_TypeA IEs are not reported by the UE");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD or v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA_XDD)  // fail cases: if IE phy_Parameters.phy_ParametersXDD_Diff.dl_SchedulingOffset_PDSCH_TypeA is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_DL_SchedulingOffset_PDSCH_TypeA_Common.dl_SchedulingOffset_PDSCH_TypeA) or
          ispresent(v_FDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA) or
          ispresent(v_TDD_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_dl_SchedulingOffset_PDSCH_TypeA to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of dl-SchedulingOffset-PDSCH-TypeA along with fr1-Add-UE-NR-Capabilities and fr2-Add-UE-NR-Capabilities for Rel-15 (and on) UEs.
                Note 18 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_dl_SchedulingOffset_PDSCH_TypeA_FRX_Diff(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-227571 R5-227572 R5-227573 R5s230120 R5-231410 sic@
    var boolean v_Phy_ParametersFRX_Diff_dl_SchedulingOffset_PDSCH_TypeA := false;
    var boolean v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA := false;
    var boolean v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var Phy_ParametersFRX_Diff v_Phy_ParametersFRX_dl_SchedulingOffset_PDSCH_TypeA_Common;
    var Phy_ParametersFRX_Diff v_FR1_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA;
    var Phy_ParametersFRX_Diff v_FR2_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA;

    if (ispresent(v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersFRX_Diff)) { //case common IE phy_ParametersFRX_Diff
      v_Phy_ParametersFRX_dl_SchedulingOffset_PDSCH_TypeA_Common := v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff)) { //case fr1
      v_FR1_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff)) { //case fr2
      v_FR2_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff;
    }

    if(pc_dl_SchedulingOffset_PDSCH_TypeA) {
      // check indication of Phy_ParametersFRX_dl_SchedulingOffset_PDSCH_TypeA_Common
      if (ispresent(v_Phy_ParametersFRX_dl_SchedulingOffset_PDSCH_TypeA_Common.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_Phy_ParametersFRX_Diff_dl_SchedulingOffset_PDSCH_TypeA := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
          v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA := true;
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_Phy_ParametersFRX_Diff_dl_SchedulingOffset_PDSCH_TypeA) or v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA or v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_dl_SchedulingOffset_PDSCH_TypeA on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //UE in FR1&FR2 case
      {
          if (not v_Phy_ParametersFRX_Diff_dl_SchedulingOffset_PDSCH_TypeA)
          {
             if (v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA and v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA) // fail case: both FR1 and FR2 capabilities are reported and no IE in phy_Parameters.phy_ParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
             if ((not v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA) and (not v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA)) // inconclusive case: UE does not report any IE for dl_SchedulingOffset_PDSCH_TypeA but pc_dl_SchedulingOffset_PDSCH_TypeA is set
             {
                f_SetVerdict(inconc, __FILE__, __LINE__, "pc_dl_SchedulingOffset_PDSCH_TypeA is set but dl_SchedulingOffset_PDSCH_TypeA IEs are not reported by the UE");
             }
          }
          else
              if  (v_FR1_Add_dl_SchedulingOffset_PDSCH_TypeA or v_FR2_Add_dl_SchedulingOffset_PDSCH_TypeA)  // fail cases: if IE in phy_Parameters.phy_ParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
              {
                 f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
              }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_Phy_ParametersFRX_dl_SchedulingOffset_PDSCH_TypeA_Common.dl_SchedulingOffset_PDSCH_TypeA) or
              ispresent(v_FR1_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA) or
              ispresent(v_FR2_Add_UE_NR_Cap_dl_SchedulingOffset_PDSCH_TypeA.dl_SchedulingOffset_PDSCH_TypeA)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_dl_SchedulingOffset_PDSCH_TypeA to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of idleInactiveNR_MeasReport_r16 along with fr1-Add-UE-NR-Capabilities, fr2-Add-UE-NR-Capabilities for Rel-16 UEs.
                Note 22 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_idleInactiveNR_MeasReport_FRX_Diff(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-232202 sic@
    var boolean v_MeasAndMobParamFRX_Diff_idleInactiveNR_MeasReport := false;
    var boolean v_FR1_Add_idleInactiveNR_MeasReport := false;
    var boolean v_FR2_Add_Cap_idleInactiveNR_MeasReport := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersFRX_Diff v_MeasAndMobParamFRX_idleInactiveNR_MeasReport_Common;
    var MeasAndMobParametersFRX_Diff v_FR1_Add_UE_NR_Cap_idleInactiveNR_MeasReport;
    var MeasAndMobParametersFRX_Diff v_FR2_Add_UE_NR_Cap_idleInactiveNR_MeasReport;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff)) {
      v_MeasAndMobParamFRX_idleInactiveNR_MeasReport_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR1_Add_UE_NR_Cap_idleInactiveNR_MeasReport := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR2_Add_UE_NR_Cap_idleInactiveNR_MeasReport := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }

    if(pc_idleInactiveNR_MeasReport) {
      // check indication of MeasAndMobParametersFRX_Diff_Common
      if (ispresent(v_MeasAndMobParamFRX_idleInactiveNR_MeasReport_Common.idleInactiveNR_MeasReport_r16)) {
          v_MeasAndMobParamFRX_Diff_idleInactiveNR_MeasReport := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_idleInactiveNR_MeasReport.idleInactiveNR_MeasReport_r16)) {
          v_FR1_Add_idleInactiveNR_MeasReport := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_idleInactiveNR_MeasReport.idleInactiveNR_MeasReport_r16)) {
          v_FR2_Add_Cap_idleInactiveNR_MeasReport := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamFRX_Diff_idleInactiveNR_MeasReport, v_FR1_Add_idleInactiveNR_MeasReport, v_FR2_Add_Cap_idleInactiveNR_MeasReport)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for idleInactiveNR_MeasReport but pc_idleInactiveNR_MeasReport is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_idleInactiveNR_MeasReport to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_MeasAndMobParamFRX_Diff_idleInactiveNR_MeasReport) or v_FR1_Add_idleInactiveNR_MeasReport or v_FR2_Add_Cap_idleInactiveNR_MeasReport)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_idleInactiveNR_MeasReport on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_MeasAndMobParamFRX_Diff_idleInactiveNR_MeasReport)
          {
             if (v_FR1_Add_idleInactiveNR_MeasReport and v_FR2_Add_Cap_idleInactiveNR_MeasReport) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FR1_Add_idleInactiveNR_MeasReport or v_FR2_Add_Cap_idleInactiveNR_MeasReport)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_idleInactiveNR_MeasReport_Common.idleInactiveNR_MeasReport_r16) or
              ispresent(v_FR1_Add_UE_NR_Cap_idleInactiveNR_MeasReport.idleInactiveNR_MeasReport_r16) or
              ispresent(v_FR2_Add_UE_NR_Cap_idleInactiveNR_MeasReport.idleInactiveNR_MeasReport_r16)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_idleInactiveNR_MeasReport to false is inconsistent with reported capabilities for a Rel-15 and above UE"); //@sic R5s240570 sic@
          }
    }
  }

  /*
   * @desc      Function to check NRCapabilityMsg.UE-NR-Capability-1540.nonCriticalExtension.nonCriticalExtension IEs. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_NR_Capability_1540 (UE_NR_Capability p_NRCapability)
  { //@sic R5s230110 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;

    v_Received_NRCapabilityMsg := p_NRCapability;

    if (isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension )) {
        f_CompareCapability_vs_PICS(pc_as_ReflectiveQoS, isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.sdap_Parameters.as_ReflectiveQoS ),"sdap-Parameters.as-ReflectiveQoS");
    } // nonCriticalExtension is OPTIONAL
    else {
       if (pc_as_ReflectiveQoS) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "Setting of UE-NR-Capability-1540 PICS is inconsistent with UE reported capabilities");
       }
    }
 }; //end of fl_Check_NR_Capability_1540

  /*
   * @desc      Function to check PICS within PDCP_Parameters matching with ifpresent in Rel-15.
   *            PICS shall not be set if it is in a group not signalled by the UE. If there is a mismatch, an inconclusive verdict is raised.
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_OptionalPICS_PDCP_Parameters_NR_r15 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg := p_NRCapability;

      if ((not isvalue(v_Received_NRCapabilityMsg.pdcp_Parameters.outOfOrderDelivery)) and pc_outOfOrderDelivery) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability pdcp_Parameters.outOfOrderDelivery but pc_outOfOrderDelivery is set");
      }

      if ((not isvalue(v_Received_NRCapabilityMsg.pdcp_Parameters.shortSN)) and pc_shortSN) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability pdcp_Parameters.shortSN but pc_shortSN is set");
      }

      if ((not isvalue(v_Received_NRCapabilityMsg.pdcp_Parameters.pdcp_DuplicationSRB)) and pc_pdcp_DuplicationSplitSRB) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability pdcp_Parameters.pdcp_DuplicationSRB but pc_pdcp_DuplicationSplitSRB is set");
      }

      if ((not isvalue(v_Received_NRCapabilityMsg.pdcp_Parameters.pdcp_DuplicationMCG_OrSCG_DRB)) and  pc_pdcp_DuplicationMCG_OrSCG_DRB) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability pdcp_Parameters.pdcp_DuplicationMCG_OrSCG_DRB but pc_pdcp_DuplicationMCG_OrSCG_DRB is set");
      }
  }

