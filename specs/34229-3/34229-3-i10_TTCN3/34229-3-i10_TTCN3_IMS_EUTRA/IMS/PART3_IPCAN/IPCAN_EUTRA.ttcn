module IPCAN_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EPS_NAS_Constants all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EPS_NAS_TypeDefs all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_RRC_Templates all;
  import from EUTRA_Paging all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_UE_Location all;
  import from IMS_PTC_CoordMsg all;
  import from NAS_CommonTemplates all;
  import from Parameters all;
  import from TestcaseProperties all;

  const EUTRA_CellId_Type tsc_IMS_EUTRA_CellId := eutra_Cell1;   /* @status    APPROVED (IMS) */

  const EUTRA_CellId_Type tsc_IMS_EUTRA_CellId_VPLMN := eutra_Cell12;  /* @status    APPROVED (IMS) */

  /*
   * @desc      Initialise IPCAN
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_Init(IMS_IPCAN_CO_ORD_PORT p_Port,
                              EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  { /* @sic R5-131807, R5-131132 and R5-131135 - new configuration for XCAP; additional change: parameter of IMS_TestConfiguration_Type instead of IMS_TestProcedure_Type sic@
       @sic R5s150338: no pre-configuration of DRBs, p_TestConfiguration removed sic@ */

    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellConfig_Def(p_CellId);                  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */

    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IPCAN_IMS_Response(IPCAN_INIT));
  }

  /*
   * @desc      provide LOCATION INFRMATION to UE
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_LocationInformation(IMS_IPCAN_CO_ORD_PORT p_Port,
                                             EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    f_EUTRA_ProvideUE_LocationInformation(p_CellId, RRC_IDLE);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);
  }

  /*
   * @desc      UE Registration acc. to 36.508 cl. 4.5.2;
   *            RRC connection is not released
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_IdleUpdated(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  { /* @sic R5-144021: low priority test cases are removed (most of 6.X and 7.X); 6.3 and 7.1 are UTRAN specific => no special PCO handling needed during EUTRA registration sic@ */
    /* @sic R5-144797: support of multiple PDN connectivity during registration sic@
       @sic R5-160947 sic@*/

    var NAS_MSG_Indication_Type v_NAS_Ind;
    
    // step 1-4
    v_NAS_Ind := f_EUTRA_InitialRegistration_Step1_4(p_CellId, PREAMBLE, NORMAL);

    // step 5-15
    f_EUTRA_InitialRegistration_Step5_15(p_CellId, STATE2_IDLEUPDATE, NORMAL, v_NAS_Ind);
    // step 16-17
    f_EUTRA_InitialRegistration_Step16_16c1(p_CellId, noDelay); /* @sic R5s130133 change 8, R5s141274 sic@ */
  }

  /*
   * @desc      Initial registration
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_InitialRegistration(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  { /* @sic R5-145787: new parameter p_IsXCAP sic@ */
    /* @sic R5s150412: new parameter p_IsEmergencyCallConfiguration sic@ */
    var boolean v_ResetIMS := false;

    f_EUTRA_SetCellPower(p_CellId, tsc_ServingCellRS_EPRE);

    // Switch on UE
    f_EUTRA_SwitchOnUEandStartIP(p_CellId, -, -, v_ResetIMS);

    f_EUTRA_IPCAN_IdleUpdated(p_CellId);
  }

 /*
   * @desc      Converged IP Comunication establishment step 16 acc. to 36.508 cl. 4.5A.28;
   * @param     p_CellId
   * @param     p_WaitForUserplaneSignalling (default value: waitForIMS)
   * @param     p_InitialRegistrationPDN (default value: firstPDN)
   * @param     p_AttachComplete    (default value: omit)
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_InitialRegistration_Step16(EUTRA_CellId_Type p_CellId,
                                                   DelayForUserPlaneSignalling_Type p_WaitForUserplaneSignalling := waitForIMS,
                                                   EUTRA_InitialRegistrationPDN_Type p_InitialRegistrationPDN := firstPDN,
                                                   template (omit) NAS_MSG_Indication_Type p_AttachComplete := omit) runs on EUTRA_PTC
  {
    var EPS_BearerIdentity v_EpsBearerId := f_EUTRA_InitialRegistrationEpsBearerId(p_InitialRegistrationPDN);
    var DelayForUserPlaneSignalling_Type v_WaitForUserplaneSignalling := p_WaitForUserplaneSignalling;
   
   f_EUTRA_NAS_AttachComplete(p_CellId, v_EpsBearerId, v_WaitForUserplaneSignalling, p_AttachComplete);
  }

   /*
   * @desc    Converged IP Comunication establishment acc. to 36.508 cl. 4.5A.28;
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_Dual_IMSRegistration(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    var boolean v_ResetIMS := false;
    var NAS_MSG_Indication_Type v_NAS_Ind;
    
    f_EUTRA_SetCellPower(p_CellId, tsc_ServingCellRS_EPRE);
    // Switch on UE
    f_EUTRA_SwitchOnUEandStartIP(p_CellId, -, -, v_ResetIMS);
    // @siclog "Step 1-4" siclog@
    v_NAS_Ind := f_EUTRA_InitialRegistration_Step1_4(p_CellId, PREAMBLE, NORMAL);
    // @siclog "Step 5-15" siclog@
    f_EUTRA_InitialRegistration_Step5_15(p_CellId, STATE2_IDLEUPDATE, NORMAL, v_NAS_Ind);
    // @siclog "Step 16-17" siclog@
    f_EUTRA_InitialRegistration_Step16(p_CellId, noDelay);
     // @siclog "Step 17-20" siclog@
    f_EUTRA_InitialRegistration_ConnectToAdditionalPDN(p_CellId);
  }

  /*
   * @desc      wrapper for f_EUTRA_ServiceRequestAndActivate_SRB2_DRB
   * @param     p_CellId
   * @param     p_EstablishmentCause
   * @status    APPROVED (IMS)
   */
  function fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(EUTRA_CellId_Type p_CellId,
                                                             template (present) EstablishmentCause p_EstablishmentCause) runs on EUTRA_PTC
  {
    f_EUTRA_ServiceRequestAndActivate_SRB2_DRB(p_CellId, -, -, -, -, -, -, -, -, -, p_EstablishmentCause);
  }

  /*
   * @desc      Generic Test Procedure for IMS MO Speech call establishment in E-UTRA (TS 36.508 cl. 4.5A.6);
   *            as the call setup is initiated by the UE there is no trigger needed to start IMS signalling,
   *            but a trigger is expected from the IMS PTC after IPS PTC has sent out "100 Trying" and "183 Session Progress" (steps 3 and 4 of C.21)
   * @param     p_Port
   * @param     p_CellId
   * @return    TriggerResult_Type
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MO_SpeechCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                       EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return TriggerResult_Type

  {
    var TriggerResult_Type v_Result := NORMAL;

    /* Table 4.5A.6.3-1 Step 2-8 */
    fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(p_CellId, cr_EstablishmentCause_MoData);
    v_Result := f_IMS_IPCAN_WaitForTriggerOrAbort(p_Port);  // wait until IMS PTC has sent "100 Trying" and "183 Session Progress" (steps 3 and 4 of C.21)
    if (v_Result == NORMAL) {                               // => procedure shall not be aborted
      f_EUTRA_ActivateDedicatedEpsBearer_Speech(p_CellId);  /* @sic R5s141221 - Further changes by MCC160 sic@ */
    }
    return v_Result;
  }

  /*
   * @desc      Generic Test Procedure for IMS Emergency call establishment in E-UTRA (TS 36.508 cl. 4.5A.4)
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @param     p_ConnectionEstablished
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_EmergencyCall(EUTRA_CellId_Type p_CellId,
                                       EPS_BearerIdentity p_EpsBearerId,
                                       boolean p_ConnectionEstablished) runs on EUTRA_PTC
  { /* @sic R5s140490 change 7 MCC160 implementation: p_ConnectionEstablished sic@ */
    var boolean v_StartIPfor2ndPDN := false;   /* @sic R5s150412 sic@ */

    if (p_ConnectionEstablished) {
      f_EUTRA_508_EstablishIMSEmergencyCall_Steps9_15(p_CellId, p_EpsBearerId, v_StartIPfor2ndPDN);       /* @sic R5s140490 change 7 MCC160 implementation sic@
                                                                                                             @sic R5s150412: v_StartIPfor2ndPDN sic@ */
    } else {
      f_EUTRA_508_EstablishIMSEmergencyCall_Steps2_15(p_CellId, -, p_EpsBearerId, v_StartIPfor2ndPDN);    /* without triggering the IMS Emg Call !
                                                                                                             @sic R5s150412: v_StartIPfor2ndPDN sic@
                                                                                                             @sic R5s150692 add. change 6 sic@ */
    }
  }

  /*
   * @desc      Generic Test Procedure for IMS MO Video call establishment in E-UTRA (TS 36.508 cl. 4.5A.8);
   *            as the call setup is initiated by the UE there is no trigger needed to start IMS signalling,
   *            but a trigger is expected from the IMS PTC after IPS PTC has sent out "100 Trying" and "183 Session Progress" (steps 3 and 4 of C.25)
   * @param     p_Port
   * @param     p_CellId
   * @return    TriggerResult_Type
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MO_VideoCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                      EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return TriggerResult_Type
    
  {
    var TriggerResult_Type v_Result := NORMAL;

    /* Table 4.5A.8.3-1 Step 2-8 */
    fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(p_CellId, cr_EstablishmentCause_MoData);
    v_Result := f_IMS_IPCAN_WaitForTriggerOrAbort(p_Port);  // wait until IMS PTC has sent "100 Trying" and "183 Session Progress" (steps 3 and 4 of C.21)
    if (v_Result == NORMAL) {                               // => procedure shall not be aborted
      f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(p_CellId);
    }
    return v_Result;
  }

  /*
   * @desc      Generic Test Procedure for IMS MT Speech call establishment in E-UTRA (TS 36.508 cl. 4.5A.7)
   * @param     p_Port
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @return    TriggerResult_Type
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MT_SpeechCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                       EUTRA_CellId_Type p_CellId,
                                       EPS_BearerIdentity p_EpsBearerId) runs on EUTRA_PTC return TriggerResult_Type
  {
    var GutiParameters_Type v_GutiParameters := f_EUTRA_CellInfo_GetGuti(p_CellId);
    var TriggerResult_Type v_Result := NORMAL;

    /* Table 4.5A.7.3-1 Step 1 */
    f_EUTRA_UE_Page(p_CellId, cs_NasPaging_OneRecord(cs_PagingUE_Identity_S_TMSI(v_GutiParameters.MME_Code, v_GutiParameters.M_TMSI)));
    
    /* Table 4.5A.7.3-1 Step 2-8 */
    fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(p_CellId, cr_EstablishmentCause_mt_Access);
    
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);                       // trigger IMS PTC to proceed steps 1-4 of C.11
    v_Result := f_IMS_IPCAN_WaitForTriggerOrAbort(p_Port);  // wait until IMS PTC has got "100 Trying" and "183 Session Progress" from the UE (steps 3 and 4 of C.11)
    if (v_Result == NORMAL) {                               // => procedure shall not be aborted
      f_EUTRA_ActivateDedicatedEpsBearer_Speech(p_CellId, -, p_EpsBearerId);  /* @sic R5s141221 - Further changes by MCC10 sic@ */
      f_IMS_IPCAN_SendCoOrdMsg(p_Port);                     // trigger IMS PTC to continue with step 5 of C.11 (sending of PRACK)
    }
    return v_Result;
  }

  /*
   * @desc      Generic Test Procedure for IMS MT Speech call establishment in E-UTRA (TS 36.508 cl. 4.5A.9)
   * @param     p_Port
   * @param     p_CellId
   * @return    TriggerResult_Type
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MT_VideoCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                      EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return TriggerResult_Type
  {
    var GutiParameters_Type v_GutiParameters := f_EUTRA_CellInfo_GetGuti(p_CellId);
    var TriggerResult_Type v_Result := NORMAL;

    /* Table 4.5A.9.3-1 Step 1 */
    f_EUTRA_UE_Page(p_CellId, cs_NasPaging_OneRecord(cs_PagingUE_Identity_S_TMSI(v_GutiParameters.MME_Code, v_GutiParameters.M_TMSI)));

    /* Table 4.5A.9.3-1 Step 2-8 */
    fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(p_CellId, cr_EstablishmentCause_mt_Access);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);                       // trigger IMS PTC to proceed steps 1-4 of C.26
    v_Result := f_IMS_IPCAN_WaitForTriggerOrAbort(p_Port);  // wait until IMS PTC has got sent "100 Trying" and "183 Session Progress" from the UE (steps 3 and 4 of C.26)
    if (v_Result == NORMAL) {                               // => procedure shall not be aborted
      f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(p_CellId);
      f_IMS_IPCAN_SendCoOrdMsg(p_Port);                     // trigger IMS PTC to continue with step 5 of C.26 (sending of PRACK)
    }
    return v_Result;
  }

  /*
   * @desc      Add video to exsiting speech call
   * @param     p_Port
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_AddVideo(IMS_IPCAN_CO_ORD_PORT p_Port,
                                  EUTRA_CellId_Type p_CellId,
                                  EPS_BearerIdentity p_EpsBearerId) runs on EUTRA_PTC
  {
    f_EUTRA_ActivateDedicatedEpsBearer_AddVideo(p_CellId, tsc_EpsDefaultBearerId, p_EpsBearerId);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);
  }

  /*
   * @desc      release video from multimedia call (but keep speech)
   * @param     p_Port
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_ReleaseVideo(IMS_IPCAN_CO_ORD_PORT p_Port,
                                      EUTRA_CellId_Type p_CellId,
                                      EPS_BearerIdentity p_EpsBearerId) runs on EUTRA_PTC
  {
    f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, p_EpsBearerId);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);
  }

    /*
   * @desc      deactivate EPS bearer
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_DeactivateEPSBearer(EUTRA_CellId_Type p_CellId,
                                             EPS_BearerIdentity p_EpsBearerId) runs on EUTRA_PTC
  { /* NOTE:
       For a normal speech call the dedicated bearer needs to be released (tsc_EpsDedicatedBearerId, tsc_DRB2);
       the default bearer needs to be kept as the UE is still attached to the network.
       For emergency call the default bearer shall be released (2nd default bearer in case of normal service, 1st in case of limited service)
       => for normal service - as long as there is only signalling on PDN1 - we also release EPS bearer '6'H and DRB2 */
    /* @sic R5-144797: common changes, use of f_EUTRA_DeactivateEPS_BearerContext sic@ */
    f_EUTRA_DeactivateEPS_BearerContext(p_CellId, p_EpsBearerId);
  }

  /*
   * @desc      MO RRC connection establishement (TS 36.508 cl. 4.5.3.3 steps 3-9)
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MO_IMS_Signalling(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    fl_EUTRA_IPCAN_ServiceRequestAndActivate_SRB2_DRB(p_CellId, cr_EstablishmentCause_MoData); // @sic R5s130133 change 3 sic@
  }

  /*
   * @desc      MT RRC connection establishement (TS 36.508 cl. 4.5.3.3 steps 1-9)
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MT_IMS_Signalling(IMS_IPCAN_CO_ORD_PORT p_Port,
                                           EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    f_EUTRA_RbEst_Def(p_CellId);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);       // trigger IMS PTC to do IMS signalling after RRC connection establishment
  }

  /*
   * @desc      connection establishement of RRC connection for 2nd PDN for XCAP signalling (TS 36.508 cl. 4.5A.14)
   * @param     p_CellId
   * @param     p_EpsBearerId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_XCAP_Signalling(EUTRA_CellId_Type p_CellId,
                                         EPS_BearerIdentity p_EpsBearerId) runs on EUTRA_PTC
  { /* @sic R5s141051 change 5: parameter p_EpsBearerId sic@ */

    var B3_Type v_PDN_RequestType := '001'B;    /* initial request */
    var DRB_Identity v_DrbForXCAP := f_EUTRA_NB_EpsBearerAssociatedDRB(p_EpsBearerId);

    if (pc_XCAP_only_APN) {                     /* @sic R5-145787 sic@ */
      f_EUTRA_ActivateAdditionalPDNOnDef(p_CellId, p_EpsBearerId, RRC_IDLE, mo_Data, v_PDN_RequestType, cr_AccessPointName_Any);
    }
    else if (pc_XCAP_over_Internet_APN) {       /* @sic R5-145787 sic@ */
      f_EUTRA_ServiceRequestAndActivate_SRB2_DRB(p_CellId, -, -, -, -, -, -, -, -, -, -, -, -, v_DrbForXCAP);
    }
    else {
      FatalError(__FILE__, __LINE__, "either pc_XCAP_only_APN or pc_XCAP_over_Internet_APN has to be set to true");
    }
  }

  /*
   * @desc      start IPCAN procedure
   * @param     p_Port
   * @param     p_CellId
   * @param     p_ProcedureType
   * @param     p_NextAvailableEpsBearerId
   * @param     p_ConnectionEstablished
   * @return    TriggerResult_Type
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_StartProcedure(IMS_IPCAN_CO_ORD_PORT p_Port,
                                        EUTRA_CellId_Type p_CellId,
                                        IMS_TestProcedure_Type p_ProcedureType,
                                        integer p_NextAvailableEpsBearerId,
                                        boolean p_ConnectionEstablished) runs on EUTRA_PTC return TriggerResult_Type
  { /* @sic R5s130681: DISCARD_UM_DATA sic@ */
    /* @sic R5s140490 change 7 MCC160 implementation: p_ConnectionEstablished sic@ */
    /* @sic R5s150412: new parameter p_IsEmergencyCallConfiguration, R5s150900 p_IsEmergencyCallConfiguration removed again sic@ */
    var TriggerResult_Type v_Result := NORMAL;
    var EPS_BearerIdentity v_EpsBearerId := int2hex(p_NextAvailableEpsBearerId, 1);

    select (p_ProcedureType) {
      case (IPCAN_InitialRegistration) {                                      // initial registration
        if (f_GetTestcaseAttrib_Eutra_DualIMSRegistration(testcasename())) {  // @sic R5-176254 sic@
          f_EUTRA_IPCAN_Dual_IMSRegistration(p_CellId);
        } else {
          f_EUTRA_IPCAN_InitialRegistration(p_CellId);
        }
      }
      case (IPCAN_EmergencyCall_NormalService,                                  // emergency call, normal service, uses 112 as default emg number
            IPCAN_EmergencyCall_OptionalPDNRelease) {                               // @sic R5-177122: same as IPCAN_EmergencyCall_NormalService for StartProcedure sic@
        f_EUTRA_IPCAN_EmergencyCall(p_CellId, v_EpsBearerId, p_ConnectionEstablished);
      }
      case (IPCAN_EmergencyCall_LimitedService) {                               // emergency call, limited service
      }
      case (IPCAN_MO_SpeechCall) {                                              // MO speech call
        v_Result := f_EUTRA_IPCAN_MO_SpeechCall(p_Port, p_CellId);
      }
      case (IPCAN_MT_SpeechCall) {                                              // MT speech call
        v_Result := f_EUTRA_IPCAN_MT_SpeechCall(p_Port, p_CellId, v_EpsBearerId);
      }
      case (IPCAN_MO_VideoCall) {                                               // MO video call
        v_Result := f_EUTRA_IPCAN_MO_VideoCall(p_Port, p_CellId);
      }
      case (IPCAN_MT_VideoCall) {                                               // MT video call
        v_Result := f_EUTRA_IPCAN_MT_VideoCall(p_Port, p_CellId);
      }
      case (IPCAN_MO_AddVideo, IPCAN_MT_AddVideo) {                             // add video to existing speech call
        f_EUTRA_IPCAN_AddVideo(p_Port, p_CellId, tsc_EpsDedicatedBearerId2);
      }
      case (IPCAN_ReleaseVideo) {                                               // Release video but keep speech call
        f_EUTRA_IPCAN_ReleaseVideo(p_Port, p_CellId, tsc_EpsDedicatedBearerId2);
      }
      case (IPCAN_MO_IMS_Signalling) {                                          // MO IMS signalling
        f_EUTRA_IPCAN_MO_IMS_Signalling(p_CellId);
      }
      case (IPCAN_MT_IMS_Signalling) {                                          // MT IMS signalling
        f_EUTRA_IPCAN_MT_IMS_Signalling(p_Port, p_CellId);                      /* @sic R5s130183 change 2 sic@ */
      }
      case (IPCAN_XCAP_Signalling) {                                            // XCAP signalling
        v_EpsBearerId := tsc_EpsDefaultBearerId2ndPDN;
        f_EUTRA_IPCAN_XCAP_Signalling(p_CellId, v_EpsBearerId);                 /* @sic R5s141051 change 6: v_EpsBearerId sic@ */
      }
    }
    return v_Result;
  }

  /*
   * @desc      Release connection(s) at the end of a procedure
   * @param     p_Port
   * @param     p_CellId
   * @param     p_TestConfiguration
   * @param     p_ProcedureType
   * @param     p_DedicatedBearersEstablished
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_ConnectionRelease(IMS_IPCAN_CO_ORD_PORT p_Port,
                                           EUTRA_CellId_Type p_CellId,
                                           IMS_TestConfiguration_Type p_TestConfiguration,
                                           IMS_TestProcedure_Type p_ProcedureType,
                                           boolean p_DedicatedBearersEstablished) runs on EUTRA_PTC
  { /* @sic R5-145787: new parameter p_IsXCAP sic@ */
    /* NOTE: p_IsXCAP is indepedent from p_ProcedureType */
    /* @sic R5s150338: v_DrbConfigList removed sic@ */
    /* @sic R5s150900: p_IsEmergencyCallConfiguration sic@ */
    /* @sic R5s160247: p_IsXCAP and p_IsEmergencyCallConfiguration replaced by p_TestConfiguration sic@ */

    var EPS_BearerIdentity v_EpsBearerId;
    var boolean v_IsXCAP := (p_TestConfiguration == IPCAN_XCAP);    /* @sic R5-145787: we need to know when it is an XCAP case sic@ */
    var boolean v_Keep2ndPDN := v_IsXCAP and pc_XCAP_over_Internet_APN;
    var boolean v_ReleaseInternetPDN := false;

    select (p_ProcedureType) {
      case (IPCAN_InitialRegistration) {
        v_ReleaseInternetPDN := true;
      }
      case (IPCAN_MO_IMS_Signalling, IPCAN_MT_IMS_Signalling) {
        // just release RRC connection
      }
      case (IPCAN_EmergencyCall_NormalService) {
        f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId2);  /* @sic R5-172067: explicit release of dedicated EPS bearer sic@ */
        f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDefaultBearerId2);    /* For emergency call the default bearer shall be released
                                                                                    (2nd default bearer in case of normal service, 1st in case of limited service) */
      }
      case (IPCAN_EmergencyCall_OptionalPDNRelease) {                                /* @sic R5-177122 sic@ */
        // TS 34.229-1 Annex C.32a Steps 6-7
        // @sic R5-187683 sic@ - f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId2);
        f_EUTRA_DeactivateEPS_BearerContext_Optional_DiscReq(p_CellId, tsc_EpsDefaultBearerId2);  /* release of default bearer according to 4.5A.15A */
      }
      case (IPCAN_EmergencyCall_LimitedService) {
        // to be implemented
      }
      case (IPCAN_MO_SpeechCall, IPCAN_MT_SpeechCall) {
        if (p_DedicatedBearersEstablished) {       // NOTE: in test cases for unsuccessful behaviour the EPS bearer may not be implemented
          if (p_TestConfiguration == IPCAN_SpeechAndEmergencyCall) {              /* @sic R5s160247 sic@ */
            f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId3);
          }
          f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId);
        }
      }
      case (IPCAN_MO_VideoCall, IPCAN_MT_VideoCall) {
        // release dedicated bearers
        f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId);
        f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, tsc_EpsDedicatedBearerId2);
      }
      case (IPCAN_XCAP_Signalling) {                                    /* @sic R5s141051 change 7: release the 2ndPDN sic@ */
        if (not pc_XCAP_over_Internet_APN) {                            /* @sic R5s160834 sic@ */
          v_EpsBearerId := tsc_EpsDefaultBearerId2ndPDN;                /* @sic R5-145787 sic@ */
          f_EUTRA_IPCAN_DeactivateEPSBearer(p_CellId, v_EpsBearerId);   /* For XCAP TCs, 2nd PDN needs to be released */
        } else {
          v_ReleaseInternetPDN := true;                                 /* @sic R5s190722 - MCC160 Implementation sic@ */
        }
      }
    }

    f_EUTRA_RRC_ConnectionRelease(p_CellId);  /* release RRC connection; @sic R5s140092 change 13: v_DrbConfigList sic@  @sic R5s150338: no v_DrbReleaseList anymore sic@ */

    if (v_ReleaseInternetPDN) {
      if (f_GetTestcaseAttrib_Eutra_DualIMSRegistration(testcasename())) {// @sic R5-176254 sic@
        f_EUTRA_InitialRegistration_ReleaseInternetPDN(p_CellId, tsc_EpsDefaultBearerId2);
      } else if (tsc_EUTRA_Registration_MultiplePDN and not v_Keep2ndPDN) { // @sic R5-145787 sic@
        f_EUTRA_InitialRegistration_ReleaseInternetPDN(p_CellId);  // @sic R5-160947 sic@
      }
    }

    if (p_ProcedureType==IPCAN_InitialRegistration) {
      select (p_TestConfiguration) { /* @sic R5s150900, R5s160247 sic@ */
        case (IPCAN_EmergencyCall) {
          f_EUTRA_StartIPfor2ndPDN(p_CellId, PDN_2, tsc_DRB2);
        }
        case (IPCAN_SpeechAndEmergencyCall) {
          f_EUTRA_StartIPfor2ndPDN(p_CellId, PDN_2, tsc_DRB3);
        }
      }
    }
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);
  }

  /*
   * @desc      postamble for IPCAN
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_Release(IMS_IPCAN_CO_ORD_PORT p_Port,
                                 EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    f_EUTRA_Postamble(p_CellId, E1_IDLE);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);
  }

  /*
   * @desc      Main loop to handle commands from the IMS PTC:
   *            - IPCAN_INIT
   *            - IPCAN_STARTPROCEDURE  (procedure)
   *            - IPCAN_ENDPROCEDURE    (procedure)
   *            - IPCAN_RELEASE
   * @status    APPROVED (IMS)
   */
  function f_EUTRA_IPCAN_MainLoop() runs on EUTRA_PTC
  {
    var EUTRA_CellId_Type v_CellId := tsc_IMS_EUTRA_CellId;
    var IMS_IPCAN_Coordination_MSG v_IMS_IPCAN_Coordination_MSG;
    var IMS_IPCAN_Command_Type v_Command;
    var integer v_PdnIndex;
    var boolean v_DedicatedBearersEstablished := false;  // will be set to true e.g. after successful call establishment (note: there are test cases with unsuccessful call establishment)
    var boolean v_ConnectionEstablished := false;        /* @sic R5s140490 change 7 MCC160 implementation sic@ */
    var boolean v_Done := false;
    var integer v_NextAvailableEpsBearerId := hex2int(tsc_EpsDedicatedBearerId);  // the next EPS bearer available is to be used as default for IMS Normal Emg Call
    var IMS_TestConfiguration_Type v_TestConfiguration;

    while (not v_Done) {
      alt {
        [] IMS[tsc_Index_IMS1].receive(cmr_IMS_IPCAN_Command) -> value v_IMS_IPCAN_Coordination_MSG {
          v_PdnIndex := tsc_Index_IMS1;
        }
        [] IMS[tsc_Index_IMS2].receive(cmr_IMS_IPCAN_Command) -> value v_IMS_IPCAN_Coordination_MSG {
          v_PdnIndex := tsc_Index_IMS2;
        }
      }
      v_Command := v_IMS_IPCAN_Coordination_MSG.IMS_IPCAN_Command;
      select (v_Command.Name) {
        case (IPCAN_INIT) {
          if (isvalue(v_Command.TestProcedure)) { // @sic R5s220611 sic@
            if (v_Command.TestProcedure == IPCAN_UseVPLMN) {
              v_CellId := tsc_IMS_EUTRA_CellId_VPLMN;
            }
          }
          f_EUTRA_IPCAN_Init(IMS[v_PdnIndex], v_CellId);
          v_TestConfiguration := v_Command.TestConfiguration;  /* @sic R5s160247 sic@ */
        }
        case (IPCAN_PROVIDELOCATIONINFORMATION) {              /* @sic R5-162025 - Cleanup of 34.229-3 Annex H sic@ */
          f_EUTRA_IPCAN_LocationInformation(IMS[v_PdnIndex], v_CellId);
        }
        case (IPCAN_STARTPROCEDURE) {
          if (f_EUTRA_IPCAN_StartProcedure(IMS[v_PdnIndex],
                                           v_CellId,
                                           v_Command.TestProcedure,
                                           v_NextAvailableEpsBearerId,
                                           v_ConnectionEstablished) == NORMAL) {
            v_DedicatedBearersEstablished := true;
            select (v_Command.TestProcedure) {                       /* @sic R5s140490 change 9 MCC160 implementation: v_NextAvailableEpsBearerId to be incremented only when procedure has not been aborted sic@ */
              case (IPCAN_MO_SpeechCall, IPCAN_MT_SpeechCall, IPCAN_EmergencyCall_LimitedService) {
                v_NextAvailableEpsBearerId := v_NextAvailableEpsBearerId + 1;
              }
              case (IPCAN_MO_VideoCall, IPCAN_MT_VideoCall, IPCAN_EmergencyCall_NormalService, IPCAN_EmergencyCall_OptionalPDNRelease) {  // @sic R5s160283 sic@ @sic R5-177122: IPCAN_EmergencyCall_OptionalPDNRelease sic@
                v_NextAvailableEpsBearerId := v_NextAvailableEpsBearerId + 2;
              }
              case else {
                // no new bearer added
              }
            }
          }
          v_ConnectionEstablished := true;      /* @sic R5s140490 change 7 MCC160 implementation sic@ */
        }
        case (IPCAN_ENDPROCEDURE) {
          f_EUTRA_IPCAN_ConnectionRelease(IMS[v_PdnIndex], v_CellId, v_TestConfiguration, v_Command.TestProcedure, v_DedicatedBearersEstablished); /* @sic R5s150900: v_IsEmergencyCallConfiguration sic@
                                                                                                                                                      @sic R5s160247: v_TestConfiguration sic@ */
          /* => RRC connection is released */
          v_DedicatedBearersEstablished := false;
          v_ConnectionEstablished := false;     /* @sic R5s140490 change 7 MCC160 implementation sic@ */
        }
        case (IPCAN_RELEASE) {
          f_EUTRA_IPCAN_Release(IMS[v_PdnIndex], v_CellId);
          v_Done := true;
        }
        case (IPCAN_QUERY) {  /* @sic R5s130133 additional changes: handling of queries from the IMS PTC sic@ */
          IMS[v_PdnIndex].send(cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));
        }
        case else {
          FatalError(__FILE__, __LINE__, "invalid command");
        }
      }
    }
  }

}
