module IpcanModel_IPCAN_Component {

  import from CommonDefs all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from MCX_IPCAN_ASP_TypeDefs all;
  import from UpperTesterPtcToMtcDefs all;

  type record IpcanModel_IPCAN_Global_Type {                    /* @status    APPROVED (MCX) */
    IPCAN_RAN_Type      RanType         optional
  };

  type component IpcanModel_IPCAN_PTC {                         /* @status    APPROVED (MCX) */

    var IpcanModel_IPCAN_Global_Type vc_Global;

    port UT_PTC_MTC_PORT           UT;
    port IP_RAT_CTRL_PORT          IP;
    port IMS_IPCAN_CO_ORD_PORT     IMS[tsc_NoOfIMSPDNs];
    port MCX_IPCAN_SYSTEM_PORT     IPCANSYS;
  };

  type component IpcanModel_SYSTEM {                            /* @status    APPROVED (MCX) */
    port MCX_IPCAN_SYSTEM_PORT     S_IPCANSYS;
  };

  template (value) IpcanModel_IPCAN_Global_Type cs_IpcanModel_IPCAN_Global_Init := { RanType := omit };                 /* @status    APPROVED (MCX) */

  /*
   * @desc      Initialise IPCAN PTC
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_Init() runs on IpcanModel_IPCAN_PTC
  {
    vc_Global := valueof(cs_IpcanModel_IPCAN_Global_Init);
  }

  /*
   * @desc      Set RAN type as retrieved from the system simulator
   * @param     p_RanType
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_SetRanType(IPCAN_RAN_Type p_RanType) runs on IpcanModel_IPCAN_PTC
  {
    vc_Global.RanType := p_RanType;
  }

  /*
   * @desc      Get RAN type
   * @return    template (omit) IPCAN_RAN_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_GetRanType() runs on IpcanModel_IPCAN_PTC return template (omit) IPCAN_RAN_Type
  {
    return vc_Global.RanType;
  }

}
