module RRC_CarrierAggregation_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA38_Handover all;
  import from EUTRA38_SecurityFunctions all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_LoopBack all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_NR_Parameters all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Intra-band Contiguous CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Intra-band non-Contiguous CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Inter-band CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.4.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_4_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Intra-band Contiguous CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.5.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_5_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Intra-band non-Contiguous CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.6.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_6_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Inter-band CA
    f_TC_8_2_4_1_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.x
   *            x=1..6
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_x_EUTRA_Common() runs on EUTRA_5GS_PTC {
    // SCG Change / Reconfiguration with sync / Split DRB / EN-DC
    f_EUTRA38_Init_CA(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE into RRC Connected
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC), Bearers (MCG(s) and SCG) established according to TS 38.508-1 [4].
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, PING_Or_TESTModeB_ON, MCG_SCG, RRC_CONNECTED);  //@sic R5s201471 R5-205577 sic@
    if (not pc_IP_Ping) {       //@sic R5s201471 R5-205577 sic@
      f_EUTRA_CloseUE_TestLoopModeB (eutra_Cell1, '00'O); // with no delay
    }
    f_EUTRA_TestBody_Set(true);

    fl_TC_8_2_4_1_1_x_ENDC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);

    if (not pc_IP_Ping) {       //@sic R5s201471 R5-205577 sic@
      f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    }
    f_EUTRA38_ENDC_Postamble (eutra_Cell1, E2_CONNECTED);  //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_2_4_1_1_x_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_4_1_1_x_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    
    // @siclog "Steps 1-2" siclog@
    // The SS transmits a RRCConnectionReconfiguration message including NR RRCReconfiguration message to configure the NR SCell
    // Check: Does the UE transmit a RRCConnectionReconfigurationComplete message containing RRCReconfigurationComplete message?
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);   //@sic R5s200462 change 1 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    // @siclog "Steps 3-4" siclog@
    //The SS transmits a RRCConnectionReconfiguration message including NR RRCReconfiguration message to modify the startingBitOfFormat2-3 of the NR SCell
    //Check: Does the UE transmit a RRCConnectionReconfigurationComplete message containing NR RRCReconfigurationComplete message?
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);   //@sic R5s200462 change 1 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // @siclog "Steps 5-6" siclog@
    //The SS transmits a RRCConnectionReconfiguration message including NR RRCReconfiguration message to release the NR SCell
    //Check: Does the UE release SCell and sends a RRCConnectionReconfigurationComplete message containing NR RRCReconfigurationComplete message?
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);   //@sic R5s200462 change 1 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 6");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Intra-band Contiguous CA
    f_TC_8_2_4_2_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Intra-band non-Contiguous CA
    f_TC_8_2_4_2_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Inter-band CA
    f_TC_8_2_4_2_1_x_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.x
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_x_EUTRA_Common() runs on EUTRA_5GS_PTC {
    // SCG Change / Reconfiguration with sync / Split DRB / EN-DC
    f_EUTRA38_Init_CA(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE into RRC Connected
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) according to TS 38.508-1 [4].
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, PING_Or_TESTModeB_ON, MCG_Only, RRC_CONNECTED);  //@sic R5s220809 R5-225406 sic@

    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_4_2_1_x_ENDC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);

    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_2_4_2_1_x_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_4_2_1_x_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    var EUTRA38_SecurityParamsExtd_Type v_Security_Params;
    
    // @siclog "Step 1" siclog@
    //The SS changes Cell parameters according to the row "T0" in table 8.2.4.2.1.1.3.2-1.
    // Send trigger to NR to change power level of NR Cell1
    f_EUTRA38_SetCellPower(eutra_Cell1, -85, -96);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));  //@sic R5s220809 sic@
    
    //@siclog "Steps 2 - 3" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to configure NR Cell 1 as the NR PSCell and sCellToAddModList with an sCellIndex set to NR Cell 3 as the configured SCell.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message?
    // Initiate SgNB Keys @sic R5s200647 sic@
    v_Security_Params := f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(NR);
    f_EUTRA38_Security_Set(v_Security_Params);
    f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, MCG_SCG, v_Security_Params.SK_Counter);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    if (not pc_IP_Ping)  {   //@sic R5s220809 R5-225406 sic@
      f_EUTRA_CloseUE_TestLoopModeB(eutra_Cell1,'00'O);
    }
    
    //@siclog "Step 4" siclog@
    //The SS changes NR Cell 2 and NR Cell 12 parameters according to the row "T1" in table 8.2.4.2.1.1.3.2-1.
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));  //@sic R5s220809 sic@
        
    //@siclog "Steps 5 - 6" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to perform both NR Cell 1 and NR Cell 3 changed to the configured target NR Cell 2 and NR Cell 12.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message configuring the new PSCell and SCell and configure lower layers to consider the SCell to be in deactivated state?
    v_Security_Params := f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(NR); //@sic R5s230131 change 2.4 sic@
    f_EUTRA38_RRC_PSCellChange_InterCell (eutra_Cell1, omit);         //@sic R5s230131 change 2.4 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    //@siclog "Steps 7 - 8" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to change the current PSCell (NR Cell 2) to NR Cell 12 equaling to one of the current UE SCell configuration.
    v_Security_Params := f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(NR); //@sic R5s230131 change 2.4 sic@
    f_EUTRA38_RRC_PSCellChange_InterCell (eutra_Cell1, omit);         //@sic R5s230131 change 2.4 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    //@siclog "Steps 9a1 - 9a2" siclog@
    if (not pc_IP_Ping) {       //@sic R5s220809 R5-225406 sic@
      f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    }
    
  }

}
