    //@sic R5-254995 sic@
      carrierFreq_r18                    := p_ARFCN_ValueNR,
      multiBandInfoList_r18            := p_MultiFrequencyBandListNR_r15,
      multiBandInfoListAerial_r18      := omit,
      ns_PmaxListNR_Aerial_r18         := omit,
