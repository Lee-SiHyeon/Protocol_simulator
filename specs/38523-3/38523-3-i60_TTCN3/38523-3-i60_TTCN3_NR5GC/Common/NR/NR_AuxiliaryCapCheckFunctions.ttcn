  /*
   * @desc      Function to check UE_NR_Capability_v1610.SidelinkParameters_r16.sidelinkParametersNR_r16 IEs. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_sidelinkParameters_r16 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var SidelinkParametersNR_r16 v_SidelinkParametersNR_r16;

    var boolean v_Found_sl_TransmissionMode2_r16 := false;
    var boolean v_Found_sl_TransmissionMode1_r16 := false;
    var boolean v_Found_drx_OnSidelink_r17 := false;
    var integer v_Index := 0;

    v_Received_NRCapabilityMsg := p_NRCapability;
    if (isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.sidelinkParameters_r16.sidelinkParametersNR_r16)) {

        if (not pc_nrSL) {
              f_SetVerdict(inconc,__FILE__, __LINE__, "Setting of pc_nrSL is inconsistent with capabilities reported by UE for sidelinkParameters_r16");
        }

        v_SidelinkParametersNR_r16 := v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.sidelinkParameters_r16.sidelinkParametersNR_r16;

          if (ispresent(v_SidelinkParametersNR_r16.mac_ParametersSidelink_r16.mac_ParametersSidelinkCommon_r16.drx_OnSidelink_r17)) { // @sic R5-261140 sic@
           // TS38.306 cl. 4.2.16.1.4
             v_Found_drx_OnSidelink_r17 := true;
             f_CompareCapability_vs_PICS(pc_drx_OnSidelink_r17, v_Found_drx_OnSidelink_r17,"drx-OnSidelink-r17");
          }
              
          while (v_Index < lengthof(v_SidelinkParametersNR_r16.supportedBandListSidelink_r16)) {
              if (isvalue(v_SidelinkParametersNR_r16.supportedBandListSidelink_r16[v_Index].sl_TransmissionMode2_r16)) {
                 v_Found_sl_TransmissionMode2_r16 := true;
                 if (not (f_Derive_sl_TransmissionMode2_r16(v_SidelinkParametersNR_r16.supportedBandListSidelink_r16[v_Index].sl_TransmissionMode2_r16))){
                     f_SetVerdict(fail,__FILE__, __LINE__, "UE reported wrong contents within sl_TransmissionMode2_r16.harq_TxProcessModeTwoSidelink_r16");
                 }
              }
              if (isvalue(v_SidelinkParametersNR_r16.supportedBandListSidelink_r16[v_Index].sl_TransmissionMode1_r16)) { //@sic R5-227571 sic@
                 v_Found_sl_TransmissionMode1_r16 := true;
                 if (not (f_Derive_sl_TransmissionMode1_r16(v_SidelinkParametersNR_r16.supportedBandListSidelink_r16[v_Index].sl_TransmissionMode1_r16))){
                     f_SetVerdict(fail,__FILE__, __LINE__, "UE reported wrong contents within sl_TransmissionMode1_r16.harq_TxProcessModeOneSidelink_r16");
                 }
              }
              v_Index:=v_Index+1;
          }

          f_CompareCapability_vs_PICS(pc_NR_sl_TransmissionMode2_r16, v_Found_sl_TransmissionMode2_r16,"sl-TransmissionMode2-r16");
          f_CompareCapability_vs_PICS(pc_NR_sl_TransmissionMode1_r16, v_Found_sl_TransmissionMode1_r16,"sl-TransmissionMode1-r16");
    } // sidelinkParameters_r16 is OPTIONAL
    else {
       if (pc_NR_sl_TransmissionMode2_r16) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "Setting of pc_NR_sl_TransmissionMode2_r16 is inconsistent with UE reported capabilities");
       }
       if (pc_NR_sl_TransmissionMode1_r16) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "Setting of pc_NR_sl_TransmissionMode1_r16 is inconsistent with UE reported capabilities");
       }
    }
 }; //end of fl_Check_sidelinkParameters_r16

  /*
   * @desc      Check PICS related to (e)RedCap. If there is a mismatch, a verdict is raised, i.e. when a PICS is set being inconsistent with UE's (e)RedCap support or UE signals a field wrongly
                This check is done from Rel-17
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_SupportOfRedCap_IEs (UE_NR_Capability p_NRCapability)
  { /* @sic R5-227571 sic@ */
    var UE_NR_Capability v_Received_NRCapabilityMsg;

    //Capabilities Not in (e)RedCap
    var boolean v_UE_NR_Cap_pdcp_DuplicationSRB := false;
    var boolean v_UE_NR_Cap_pdcp_DuplicationMCG_OrSCG_DRB := false;
    var boolean v_UE_NR_Cap_v1530_eutra_ParametersCommon_ne_DC := false;
    var boolean v_UE_NR_Cap_v1530_eutra_ParametersCommon_nr_HO_ToEN_DC_r16 := false;

    //Capabilities in (e)RedCap
    var boolean v_UE_NR_Cap_pdcp_longSN_RedCap_r17 := false;
    var boolean v_UE_NR_Cap_MeasAndMobParametersCommon_rrm_RelaxationRRC_ConnectedRedCap_r17 := false;
    var boolean v_UE_NR_Cap_rlc_Parameters_am_WithLongSN_RedCap_r17 := false;
    var boolean v_UE_NR_Cap_v1700_redCapParameters_r17_supportOf16DRB_RedCap_r17 := false;

    var boolean v_UE_NR_Cap_v1700_redCapParameters_r17_supportOfRedCap_r17 := false;
    var boolean v_UE_NR_Cap_v1800_eRedCapParameters_supportOfERedCap_r18 := false;

    var boolean v_UE_NR_supportOfRedCap := false;  //Support of (e)RedCap

    v_Received_NRCapabilityMsg := p_NRCapability;
    // UE = Rel-17
    if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel17,rel18))) {
        if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCapParameters_r17)) {
            if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCapParameters_r17.supportOfRedCap_r17))
            {  // Check RedCap on Rel-17
               v_UE_NR_Cap_v1700_redCapParameters_r17_supportOfRedCap_r17 := true;
            }
        }
    }
    // UE >= Rel-18
    if (match (v_Received_NRCapabilityMsg.accessStratumRelease, rel18)) {
        if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.eRedCapParameters_r18)) {
            if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.eRedCapParameters_r18.supportOfERedCap_r18))
            {  // Check (e)RedCap on Rel-18
               v_UE_NR_Cap_v1800_eRedCapParameters_supportOfERedCap_r18 := true;
            }
        }
    }

    if (v_UE_NR_Cap_v1700_redCapParameters_r17_supportOfRedCap_r17 and v_UE_NR_Cap_v1800_eRedCapParameters_supportOfERedCap_r18) {
        f_SetVerdict(fail,__FILE__, __LINE__, "An eRedCap UE shall signal supportOfERedCap_r18 as supported but shall not indicate support of supportOfRedCap-r17.");
    }

    if (pc_supportOfRedCap_r17 and pc_supportOfERedCap_r18) { // supportOfERedCap_r18 is mutually exclusive with supportOfRedCap_r17
       f_SetVerdict(inconc,__FILE__, __LINE__, "An eRedCap UE shall set pc_supportOfERedCap_r18 to supported but shall not indicate support of pc_supportOfRedCap_r17");
    }

    v_UE_NR_supportOfRedCap := v_UE_NR_Cap_v1700_redCapParameters_r17_supportOfRedCap_r17 or v_UE_NR_Cap_v1800_eRedCapParameters_supportOfERedCap_r18;


    if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.redCapParameters_r17.supportOf16DRB_RedCap_r17))
    { // TS38.306 cl. 4.2.21.2
        v_UE_NR_Cap_v1700_redCapParameters_r17_supportOf16DRB_RedCap_r17 := true;
        f_CompareCapability_vs_PICS(pc_supportOf16DRB_RedCap_r17, v_UE_NR_Cap_v1700_redCapParameters_r17_supportOf16DRB_RedCap_r17,"supportOf16DRB-RedCap-r17");
        
        if (v_UE_NR_Cap_v1700_redCapParameters_r17_supportOf16DRB_RedCap_r17 and not (v_UE_NR_supportOfRedCap)){
           f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.21.2 supportOf16DRB_RedCap_r17 is only applicable for (e)RedCap UEs.");
        }
    }

    // TS38.306 cl. 4.2.21.3
    if (ispresent(v_Received_NRCapabilityMsg.pdcp_Parameters.longSN_RedCap_r17)) {
        v_UE_NR_Cap_pdcp_longSN_RedCap_r17 := true;
        if ((not v_UE_NR_supportOfRedCap) and v_UE_NR_Cap_pdcp_longSN_RedCap_r17){
            f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.21.3 am_WithLongSN_RedCap_r17 is only applicable for (e)RedCap UEs.");
        }
        f_CompareCapability_vs_PICS(pc_longSN, v_UE_NR_Cap_pdcp_longSN_RedCap_r17,"longSN");
    }
    // TS38.306 cl. 4.2.21.4
    if (ispresent(v_Received_NRCapabilityMsg.rlc_Parameters.am_WithLongSN_RedCap_r17))
    {
        v_UE_NR_Cap_rlc_Parameters_am_WithLongSN_RedCap_r17 := true;
        if ((not v_UE_NR_supportOfRedCap) and v_UE_NR_Cap_rlc_Parameters_am_WithLongSN_RedCap_r17){
            f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.21.4 am_WithLongSN_RedCap_r17 is only applicable for (e)RedCap UEs.");
        }
        f_CompareCapability_vs_PICS(pc_am_WithLongSN, v_UE_NR_Cap_rlc_Parameters_am_WithLongSN_RedCap_r17,"am-WithLongSN");
    }
    // TS38.306 cl. 4.2.21.5
    if (ispresent(v_Received_NRCapabilityMsg.measAndMobParameters.measAndMobParametersCommon.rrm_RelaxationRRC_ConnectedRedCap_r17))
    {
        v_UE_NR_Cap_MeasAndMobParametersCommon_rrm_RelaxationRRC_ConnectedRedCap_r17 := true;
        if ((not v_UE_NR_supportOfRedCap) and v_UE_NR_Cap_MeasAndMobParametersCommon_rrm_RelaxationRRC_ConnectedRedCap_r17){
            f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.21.5 am_WithLongSN_RedCap_r17 is only applicable for (e)RedCap UEs.");
        }
        f_CompareCapability_vs_PICS(pc_rrm_RelaxationRRC_ConnectedRedCap_r17, v_UE_NR_Cap_MeasAndMobParametersCommon_rrm_RelaxationRRC_ConnectedRedCap_r17,"rrm-RelaxationRRC-ConnectedRedCap-r17");
    }

    // Check of IEs not compatible with (e)RedCap UEs
    if (ispresent(v_Received_NRCapabilityMsg.pdcp_Parameters.pdcp_DuplicationSRB)) {
        v_UE_NR_Cap_pdcp_DuplicationSRB := true;
    }
    if (ispresent(v_Received_NRCapabilityMsg.pdcp_Parameters.pdcp_DuplicationMCG_OrSCG_DRB)) {
        v_UE_NR_Cap_pdcp_DuplicationMCG_OrSCG_DRB := true;
    }
    if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters) and (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters.eutra))) {
           if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters.eutra.eutra_ParametersCommon) and (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters.eutra.eutra_ParametersCommon.ne_DC)))
           {
               v_UE_NR_Cap_v1530_eutra_ParametersCommon_ne_DC := true;
           }
           if (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters.eutra.eutra_ParametersCommon) and (ispresent(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters.eutra.eutra_ParametersCommon.nr_HO_ToEN_DC_r16)))
           {
               v_UE_NR_Cap_v1530_eutra_ParametersCommon_nr_HO_ToEN_DC_r16 := true;
           }
    }
    if (v_UE_NR_supportOfRedCap) { // UE is (e)RedCap
        if (v_UE_NR_Cap_pdcp_DuplicationSRB or v_UE_NR_Cap_pdcp_DuplicationMCG_OrSCG_DRB or v_UE_NR_Cap_v1530_eutra_ParametersCommon_ne_DC or v_UE_NR_Cap_v1530_eutra_ParametersCommon_nr_HO_ToEN_DC_r16){
           f_SetVerdict(fail,__FILE__, __LINE__, "UE signals capabilities that shall not be present being (e)RedCap");
        }

        if (pc_pdcp_DuplicationSplitSRB or pc_pdcp_DuplicationMCG_OrSCG_DRB or pc_interRAT_NR_ToENDC) {
               f_SetVerdict(inconc,__FILE__, __LINE__, "Wrong setting of pc_pdcp_DuplicationSplitSRB or pc_pdcp_DuplicationMCG_OrSCG_DRB or pc_interRAT_NR_ToENDC in a (e)RedCap UE.");
        }
    }
  } // end of fl_SupportOfRedCap_IEs

  /*
   * @desc      Function to check pei-SubgroupingSupportBandList-r17 depending on pc_pei_SubgroupingSupportBandList_r17. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_PEI_SubgroupingSupportBandList_r17 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var UE_RadioPagingInfo_r17 v_UE_RadioPagingInfo_r17;
    var boolean v_Found_pei_SubgroupingSupportBandList_r17 := false;

    v_Received_NRCapabilityMsg := p_NRCapability;
    if (isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_RadioPagingInfo_r17)) {

        v_UE_RadioPagingInfo_r17 := v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_RadioPagingInfo_r17;

        if (isvalue(v_UE_RadioPagingInfo_r17.pei_SubgroupingSupportBandList_r17) and lengthof(v_UE_RadioPagingInfo_r17.pei_SubgroupingSupportBandList_r17) > 0) {
               v_Found_pei_SubgroupingSupportBandList_r17 := true;
        }

        f_CompareCapability_vs_PICS(pc_pei_SubgroupingSupportBandList_r17, v_Found_pei_SubgroupingSupportBandList_r17,"pei-SubgroupingSupportBandList-r17");
    } // ue-RadioPagingInfo-r17 is OPTIONAL
    else {
       if (pc_pei_SubgroupingSupportBandList_r17) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "Setting of pc_pei_SubgroupingSupportBandList_r17 is inconsistent with UE reported capabilities");
       }
    }
 }; //end of f_PEI_SubgroupingSupportBandList_r17

  /*
   * @desc      Function to check dependencies between features mentioned in TS 38.306 are not overlooked in r16. If there is a mismatch, a verdict is raised.
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_FeaturesDependencies_r16 (UE_NR_Capability p_NRCapability,
                                       NR_Configuration_Type p_Configuration_Type)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    v_Received_NRCapabilityMsg := p_NRCapability;

    if (p_Configuration_Type == NR_SA) { //@sic R5-225384 sic@
      fl_Check_sidelinkParameters_r16(v_Received_NRCapabilityMsg);  // Only in Test Case 8.1.5.1.1.NR5GC
    }
 }; //end of f_FeaturesDependencies_r16

  /*
   * @desc      Function to check dependencies between features mentioned in TS 38.306 are not overlooked in r17. If there is a mismatch, a verdict is raised.
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_FeaturesDependencies_r17 (UE_NR_Capability p_NRCapability,
                                       NR_Configuration_Type p_Configuration_Type)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var boolean v_Found_nonTerrestrialNetwork_r17 := false;
    var boolean v_Found_harq_FeedbackDisabled_r17 := false;
    var boolean v_Found_uplink_Harq_ModeB_r17 := false;

    v_Received_NRCapabilityMsg := p_NRCapability;
    v_Found_nonTerrestrialNetwork_r17 := isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonTerrestrialNetwork_r17);
    v_Found_harq_FeedbackDisabled_r17 := isvalue(v_Received_NRCapabilityMsg.mac_Parameters.mac_ParametersCommon.harq_FeedbackDisabled_r17);
    v_Found_uplink_Harq_ModeB_r17 := isvalue(v_Received_NRCapabilityMsg.mac_Parameters.mac_ParametersCommon.uplink_Harq_ModeB_r17);

      if (v_Found_harq_FeedbackDisabled_r17 and not(v_Found_nonTerrestrialNetwork_r17)) {
          f_SetVerdict(fail,__FILE__, __LINE__, "A UE supporting harq-FeedbackDisabled-r17 shall also indicate the support of nonTerrestrialNetwork-r17");
      }

      if (v_Found_uplink_Harq_ModeB_r17 and not(v_Found_nonTerrestrialNetwork_r17)) {
          f_SetVerdict(fail,__FILE__, __LINE__, "A UE supporting uplink-Harq-ModeB-r17 shall also indicate the support of nonTerrestrialNetwork-r17");
      }

      f_CompareCapability_vs_PICS(pc_extendedDRX_CycleInactive_r17, pc_NR_eDRX,"extendedDRX-CycleInactive-r17 with extended DRX in RRC_IDLE");

      f_PEI_SubgroupingSupportBandList_r17(v_Received_NRCapabilityMsg);

      if (p_Configuration_Type == NR_SA) { //@sic R5-225384 sic@
        fl_SupportOfRedCap_IEs(v_Received_NRCapabilityMsg);  // Only in Test Case 8.1.5.1.1.NR5GC
      }
 }; //end of f_FeaturesDependencies_r17

  /*
   * @desc      Function to check dependencies between features mentioned in TS 38.306 are not overlooked in r18. If there is a mismatch, a verdict is raised.
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_FeaturesDependencies_r18 ()
  {
      f_CompareCapability_vs_PICS(pc_extendedDRX_CycleInactive_r18, pc_NR_eDRX,"extendedDRX_CycleInactive_r18 with extended DRX in RRC_IDLE");
  }; //end of f_FeaturesDependencies_r18

  /*
   * @desc      NRDC-Parameters.measAndMobParametersNRDC.MeasAndMobParametersMRDC.MeasAndMobParametersMRDC-Common.independentGapConfig must be supported if pc_independentGapConfig_NRDC is supported
   * @return    template NRDC_Parameters
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Derive_NRDC_Parameters() return template NRDC_Parameters
  { // @sic R5-255779 sic@
    var template (present) NRDC_Parameters v_NRDC_Parameters := cr_NRDC_Parameters;
    return v_NRDC_Parameters ifpresent;
  };

  template (present) NRDC_Parameters cr_NRDC_Parameters :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    // @sic R5-255779 sic@
    measAndMobParametersNRDC      := cr_NR_NRDC_MeasAndMobParametersMRDC ifpresent,
    generalParametersNRDC         := *,
    fdd_Add_UE_NRDC_Capabilities  := *,
    tdd_Add_UE_NRDC_Capabilities  := *,
    fr1_Add_UE_NRDC_Capabilities  := *,
    fr2_Add_UE_NRDC_Capabilities  := *,
    dummy2                        := *,
    dummy                         := *
  };

  /*
   * @desc      UE-MRDC-Capability.measAndMobParametersMRDC.MeasAndMobParametersMRDC-Common.independentGapConfig must be supported if pc_independentGapConfig_NRDC
   * @return    template MeasAndMobParametersNRDC_MRDC_independentGapConfig_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Derive_MeasAndMobParametersMRDC_independentGapConfig_NRDC() return template MeasAndMobParametersNRDC_MRDC_independentGapConfig_Type
  { // @sic R5-255779 sic@
    if (pc_independentGapConfig_NRDC) {
      return supported;
    } else {
      return omit;
    }
  }

  template (present) MeasAndMobParametersMRDC cr_NR_NRDC_MeasAndMobParametersMRDC :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    // @sic R5-255779 sic@
    measAndMobParametersMRDC_Common := {
      independentGapConfig  := f_NR_Derive_MeasAndMobParametersMRDC_independentGapConfig_NRDC()
    } ifpresent,
    measAndMobParametersMRDC_XDD_Diff := {
      sftd_MeasPSCell := *,
      sftd_MeasNR_Cell := *
    } ifpresent,
    measAndMobParametersMRDC_FRX_Diff := {
      simultaneousRxDataSSB_DiffNumerology := *
    } ifpresent
  };

}
