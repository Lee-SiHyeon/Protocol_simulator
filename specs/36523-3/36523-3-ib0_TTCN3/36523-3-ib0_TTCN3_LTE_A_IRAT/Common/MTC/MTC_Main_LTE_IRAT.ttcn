module MTC_Main_LTE_IRAT {

  import from CDMA2000_Component all;
  import from CommonDefs all;
  import from EUTRA_Component all;
  import from GERAN_Component all;
  import from IMS_Component all;
  import from IMS_DefaultHandler all;
  import from IP_PTC_Component all;
  import from IP_PTC_Main all;
  import from MTC_Base all;
  import from MTC_Component_LTE_IRAT all;
  import from NasEmu_Component_EUTRA all;
  import from NasEmu_Main_EUTRA all;
  import from UTRAN_Component all;
  import from UTRAN_IRAT_Component all;

  /*
   * @desc      Connect all PTCs
   * @param     p_System
   * @param     p_Eutra
   * @param     p_Utran
   * @param     p_Geran
   * @param     p_Cdma2000
   * @param     p_ImsPdn1
   * @param     p_ImsPdn2
   * @param     p_RatCombination    (default value: omit)
   * @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT)
   */
  function f_MTC_ConnectPTCs_LTE_IRAT_Common(SYSTEM_LTE_IRAT p_System,
                                             EUTRA_PTC p_Eutra,
                                             UTRAN_IRAT_PTC p_Utran,
                                             GERAN_PTC p_Geran,
                                             CDMA2000_PTC p_Cdma2000,
                                             IMS_PTC p_ImsPdn1,
                                             IMS_PTC p_ImsPdn2,
                                             template (omit) RATComb_Tested_Type p_RatCombination := omit) runs on MTC_LTE_IRAT
  { /* @sic R5-163201: v_ImsPdn1 replaced vc_ImsPdn1 to cope with WLAN in f_MTC_ConnectPTCs_LTE_A_IRAT sic@ */
    
    var NASEMU_EUTRA_PTC v_NASEMU_PTC;
    var boolean v_C2KTunnellingFlag := (p_Cdma2000 != null);

    vc_Components.Eutra := p_Eutra;
    vc_Components.Utran := p_Utran;
    vc_Components.Geran := p_Geran;
    vc_Components.Cdma2000 := p_Cdma2000;

    // ***** MTC *****
    f_MTC_BASE_Map(p_System);

    // ***** EUTRA PTC *****
    if (p_Eutra != null) {  /* @sic R5-169075 (test case 20.1): test cases 20.X have WLAN and IMS PTC only, i.e. p_Eutra==null sic@ */
      f_EUTRA_PTC_Map(p_System, p_Eutra, v_C2KTunnellingFlag);                // map EUTRA system ports
      v_NASEMU_PTC := f_NasEmu_CreateConnectAndMap_EUTRA(p_System, p_Eutra);  // create NasEmu, map system ports and connect with EUTRA PTC
      v_NASEMU_PTC.start(f_NASEMU_MainLoop_EUTRA());                          // start NASEMU
    }
    // ***** Create, map, connect and start IP PTC *****
    vc_IP_PTC := f_IP_PTC_CreateAndMap(p_System);
    if (p_Eutra != null)     {connect(p_Eutra:IP, vc_IP_PTC:EUTRA_CTRL);}    /* @sic R5-125676 sic@ */
    if (p_Utran != null)     {connect(p_Utran:IP, vc_IP_PTC:UTRAN_CTRL);}    /* @sic R5-125676 sic@ */
    if (p_Geran != null)     {connect(p_Geran:IP, vc_IP_PTC:GERAN_CTRL);}    /* @sic R5-133612 sic@ */
    vc_IP_PTC.start(f_IP_PTC_MainLoop());

    // ***** Create, connect and start IMS PTC *****
    // IMS for PDN1: if PTC is not created yet the default IMS PTC will be used
    if (p_ImsPdn1 == null) { vc_ImsPdn1 := f_IMS_PTC_Create(); }         // => default IMS handling for PDN1
    else                   { vc_ImsPdn1 := p_ImsPdn1; }

    connect(vc_ImsPdn1:IMS_CTRL,      vc_IP_PTC:IMS_CTRL[tsc_Index_IMS1]);
    connect(vc_ImsPdn1:IMS_Server,    vc_IP_PTC:IMS_Server[tsc_Index_IMS1]);
    connect(vc_ImsPdn1:IMS_Client,    vc_IP_PTC:IMS_Client[tsc_Index_IMS1]);
    
    connect(vc_ImsPdn1:MMI, mtc:PTC_Ut[tsc_MTC_PortIndex_IMS1]);   /* @sic R5-134070: generic handling of UT commands for IMS PTC as well as for the other PTCs sic@ */
    if (p_Eutra != null) {connect(vc_ImsPdn1:IPCAN, p_Eutra:IMS[tsc_Index_IMS1]);}
    
    if (p_ImsPdn1 == null) {         /* => we have no test case specific IMS implementation */
      vc_ImsPdn1.start(f_IMS_DefaultHandler());
    }

    // IMS for PDN (emergency call)
    if (p_ImsPdn2 != null) {                             // test case specific IMS handling for PDN2
      connect(p_ImsPdn2:IMS_CTRL,      vc_IP_PTC:IMS_CTRL[tsc_Index_IMS2]);
      connect(p_ImsPdn2:IMS_Server,    vc_IP_PTC:IMS_Server[tsc_Index_IMS2]);
      connect(p_ImsPdn2:IMS_Client,    vc_IP_PTC:IMS_Client[tsc_Index_IMS2]);
      
      connect(p_ImsPdn2:MMI, mtc:PTC_Ut[tsc_MTC_PortIndex_IMS2]);       /* @sic R5-134070: generic handling of UT commands for IMS PTC as well as for the other PTCs sic@
                                                                           @sic R5s130987 sic@ */
      connect(p_ImsPdn2:OtherPDN,      vc_ImsPdn1:OtherPDN);            /* @sic R5-251340..2: needed IMS eCall IRAT test cases sic@ */

      if (p_Eutra != null) {connect(p_ImsPdn2:IPCAN, p_Eutra:IMS[tsc_Index_IMS2]);}
    }
    
    // ***** UTRAN PTC *****
    if ((p_Utran != null) and ((not isvalue(p_RatCombination) or (valueof(p_RatCombination) == EUTRA_UTRA)))) { // if p_RatCombination == EUTRA_GERAN the UTRAN PTC is used as dummy only to get sys info
      connect(vc_ImsPdn1:OtherIPCAN,  p_Utran:IMS[tsc_Index_IMS1]);     /* @sic R5-142919: sic@
                                                                           when we have test case specific IMS behaviour and there is a UTRAN PTC => we need coordination of IMS and UTRAN
                                                                           @sic R5s150057 change 1: sic@
                                                                           to allow IMS de-registration on UTRAN at the end of test cases UTRAN shall always be connected to the IMS PTC
                                                                           @sic R5s211626: OtherIPCAN only connected for EUTRA_UTRA sic@ */
      f_UTRAN_PTC_Map(p_System, p_Utran);
    }

    // ***** GERAN PTC *****
    if ((p_Geran != null) and ((not isvalue(p_RatCombination) or (valueof(p_RatCombination) == EUTRA_GERAN)))) { // if p_RatCombination == EUTRA_GERAN the UTRAN PTC is used as dummy only to get sys info
      connect(vc_ImsPdn1:OtherIPCAN,  p_Geran:IMS[tsc_Index_IMS1]);     /* @sic R5-152083: sic@
                                                                           when we have test case specific IMS behaviour and there is a GERAN PTC => we need coordination of IMS and GERAN
                                                                           @sic R5s211626: OtherIPCAN only connected for EUTRA_GERAN sic@ */
      f_GERAN_PTC_Map(p_System, p_Geran);
    }

    // ***** CDMA2000 PTC *****
    if (p_Cdma2000 != null) {
      f_CDMA2000_PTC_Map(p_System, p_Cdma2000);
    }
    
    // ***** Connect PTCs to MTC *****
    if (p_Eutra != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_EUTRA],    p_Eutra:UT);}
    if (p_Utran != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_UTRAN],    p_Utran:UT);}
    if (p_Geran != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_GERAN],    p_Geran:UT);}
    if (p_Cdma2000 != null)  {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_CDMA2000], p_Cdma2000:UT);}

    // ***** Connect EUTRA PTC to other PTCs *****
    if (p_Eutra != null) {   /* @sic R5-169075 (test case 20.1) sic@ */
      if (p_Utran != null)     {connect(p_Eutra:UTRAN,    p_Utran:EUTRA);}
      if (p_Geran != null)     {connect(p_Eutra:GERAN,    p_Geran:EUTRA);}
      if (p_Cdma2000 != null)  {connect(p_Eutra:CDMA2000, p_Cdma2000:EUTRA);}
    }
    // ***** Connect UTRAN PTC to GERAN PTC *****
    if ((p_Geran != null) and (p_Utran != null))     {connect(p_Utran:GERAN, p_Geran:UTRAN);}
  }

}
