    keyToUse  := p_KeyToUse
  };

  template (value) CellGroupConfig cs_NR_CellGroupConfigDef(CellGroupId p_CellGroupId,
                                                            template (omit) NR_RLC_BearerToAddModList_Type p_RLC_Bearer_Config,
