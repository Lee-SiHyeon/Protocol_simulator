                    sn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17  := f_NR_MRDCCommon_sn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17(),
                    sn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17  := f_NR_MRDCCommon_sn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17()
