  /* @desc  Calculate Q_RxLevMin from the intial DB value and the delta value
   *        q-RxLevMin = ROUND((dB_value+Delta(NRfs))/2)
   * @param     p_Q_RxLevMinInitial_DB
   * @param     p_DeltaNRFs
   * @return    Q_RxLevMin
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CalculateQ_RxLevMin ( float p_Q_RxLevMinInitial_DB,
                                      integer p_DeltaNRFs
                                      ) return Q_RxLevMin
  {
    var Q_RxLevMin v_Q_RxLevMin;
    v_Q_RxLevMin := f_Round((p_Q_RxLevMinInitial_DB + int2float(p_DeltaNRFs))/2.0); //q-RxLevMin = ROUND((dB_value+Delta(NRfs))/2)
    return v_Q_RxLevMin;
  }

