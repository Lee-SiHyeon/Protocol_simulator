  template (value) Ut_System_Cmd_Type cs_MMI_SET_MUSIM_UAI(template (value) Ut_ParameterList_Type p_ParamList) :=  cs_MMI_Cmd("SET_MUSIM_UAI", p_ParamList); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_MMI_CONFIGURE_SENSE(template (value) Ut_ParameterList_Type p_ParamList) :=  cs_MMI_Cmd("SENSE", p_ParamList); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_MMI_C2MODIFY_SESSION(template (value) Ut_ParameterList_Type p_ParamList) :=  cs_MMI_Cmd("C2MODIFY_SESSION", p_ParamList); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_MMI_NGSO(template (value) Ut_ParameterList_Type p_ParamList) :=  cs_MMI_Cmd("SATELLITE_TRAJECTORY_PREDICTION", p_ParamList);  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_AT_UAS_UUAA (charstring p_Params) := cs_AT_Cmd("AT+CUUAAPT=" & p_Params & "<CR>"); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_AT_UAS_C2 (charstring p_Params) := cs_AT_Cmd("AT+CC2APT=" & p_Params & "<CR>");    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_AT_SPS (charstring p_Params) := cs_AT_Cmd("AT+CSPSAIR=" & p_Params & "<CR>");  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Ut_System_Cmd_Type cs_MMI_SEND_UL_TRAFFIC_INFO(template (value) Ut_ParameterList_Type p_ParamList) :=  cs_MMI_Cmd("SEND_UL_TRAFFIC_INFO", p_ParamList);  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

  /*
   * @desc      cause the UE to be switched off at the beginning of a teat case
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_InitialPowerOffUE(MTC_System_Ut p_Port)
  { /* @sic R5-113037: Introduction of positioning test cases - system port handed over as parameter to get function independent from component definitions sic@ */
    p_Port.send(cas_UT_SYSTEM_REQ(cs_MMI_POWER_OFF, CNF_REQUIRED));
    p_Port.receive(car_UT_COMMON_CNF);
  }

}
