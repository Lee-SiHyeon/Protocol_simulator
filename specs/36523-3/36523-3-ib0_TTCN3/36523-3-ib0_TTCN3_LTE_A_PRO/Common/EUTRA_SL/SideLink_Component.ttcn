module SideLink_Component {

  import from CommonDefs all;
  import from SideLinkUE_ASP_TypeDefs all;
  import from SideLink_CoordMsg all;

  type record SideLink_PTC_Ctrl_Type { /* @status    APPROVED (LTE_A_PRO) */
    default             Default,
    boolean             TestBody
  };

  type record SideLink_Global_Type { /* @status    APPROVED (LTE_A_PRO) */
    SideLink_PTC_Ctrl_Type Ctrl
  };

  type component SideLink_PTC { /* @status    APPROVED (LTE_A_PRO) */
    
    var SideLink_Global_Type       vc_SideLink_Global;
    
    // system ports
    port SL_DATA_PORT   DATA;
    port SL_SYSTEM_PORT SYS;
    port SL_SYSIND_PORT SYSIND;
    
    // coordination ports to EUTRA
    port SIDELINK_CO_ORD_PORT      EUTRA;
  };

  type component SIDELINK_SYSTEM { /* @status    APPROVED (LTE_A_PRO) */
    port SL_DATA_PORT   SL_DATA;
    port SL_SYSTEM_PORT SL_SYS;
    port SL_SYSIND_PORT SL_SYSIND;
  };

  /*
   * @desc      Map SideLink system ports
   * @param     p_System
   * @param     p_SideLink
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_PTC_Map(SIDELINK_SYSTEM p_System,
                              SideLink_PTC p_SideLink)
  {
    map(p_SideLink:SYS,    p_System:SL_SYS);
    map(p_SideLink:SYSIND, p_System:SL_SYSIND);
    map(p_SideLink:DATA,   p_System:SL_DATA);
  }

  /*
   * @desc      to deal with entry and exit of the test body in Sidelink test cases
   * @param     p_TestBodyFlag
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_TestBody_Set(boolean p_TestBodyFlag) runs on SideLink_PTC
  {
    vc_SideLink_Global.Ctrl.TestBody := p_TestBodyFlag;
  }

  /*
   * @desc      check whether test body is active
   * @return    boolean
   * @status    APPROVED (LTE_A_PRO)
   */
  function fl_SideLink_TestBody_Check() runs on SideLink_PTC return boolean
  {
    return vc_SideLink_Global.Ctrl.TestBody;
  }

  /*
   * @desc      set correct verdict: FAIL is assigned only when being in the test body else inconclusive
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_SetVerdictFailOrInconc(charstring p_FileName,
                                             LineNo_Type p_LineNo,
                                             charstring p_Msg) runs on SideLink_PTC
  {
    if (fl_SideLink_TestBody_Check()) {
      f_SetVerdict(fail, p_FileName, p_LineNo, p_Msg);
    } else {
      f_SetVerdict(inconc, p_FileName, p_LineNo, p_Msg);
    }
    self.kill; // => test case will terminate immediately
  }

  /*
   * @desc      set correct verdict: prelininary PASS is only be assigned when being in the test body
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_PreliminaryPass(charstring p_FileName,
                                      LineNo_Type p_LineNo,
                                      charstring p_Msg) runs on SideLink_PTC
  {
    if (fl_SideLink_TestBody_Check()) {
      f_SetVerdict(pass, p_FileName, p_LineNo, p_Msg);
    }
  }

}
