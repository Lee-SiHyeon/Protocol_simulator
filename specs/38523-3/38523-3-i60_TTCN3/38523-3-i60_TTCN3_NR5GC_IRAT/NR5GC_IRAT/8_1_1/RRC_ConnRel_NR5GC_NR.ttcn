module RRC_ConnRel_NR5GC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from NG_NAS_Common all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_IRAT_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_2_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Redirection from NR to EUTRA
  
    f_NR5GC_IRAT_Init(NR_6); // @sic R5-198910 sic@

    f_NR_CellInfo_InitMaxReferencePower (nr_Cell1, -85, -82);
    
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_IRAT_PreambleEUTRA_NR (nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower (nr_Cell1, -85, -82);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_2_TestBody();

    f_NR_TestBody_Set(false);

    // UE now on EUTRA
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_1_3_2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_2_TestBody() runs on NR5GC_PTC
  {
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);
    f_NR_SetCellPower (nr_Cell1, -85, -82);

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCRelease message (IE redirectedCarrierInfo including EUTRA cell).
    v_RedirectedCarrierInfo := cs_NR_RedirectedCarrierInfoToEUTRA(v_CoOrd_SysInfo.Eutra[0].Arfcn);

    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, v_RedirectedCarrierInfo )));

    //@siclog "Step 2" siclog@
    // Send both authentication and NR sysinfo paramters to EUTRA
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Power Level");
    f_NR_SetCellPower (nr_Cell1, -110, -139);  // @sic R5-213463 sic@ sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Postamble");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.4
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_4_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Success / With priority information / T320 expiry / E-UTRA
  
    var EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_SysInfoList;

    f_NR5GC_IRAT_Init(NR_6);

    // Get EUTRA frequency info
    v_EUTRA_SysInfoList := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);
    // Set specific SIB 5
    f_NR5GC_CellInfo_SetSIB5(nr_Cell1, cs_38508_SIB5_Def({cds_CarrierFreqEUTRA_cellResel_thrX(v_EUTRA_SysInfoList.Eutra[0].Arfcn,
                                                                                                 2,    // 4 dB
                                                                                                 1,    // 2 dB
                                                                                                 5),
                                                          cds_CarrierFreqEUTRA_cellResel_thrX(v_EUTRA_SysInfoList.Eutra[1].Arfcn,
                                                                                                 2,    // 4 dB
                                                                                                 1,    // 2 dB
                                                                                                 3)}));
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_IRAT_PreambleEUTRA_NR (nr_Cell1, STATE_CONNECTED_3A, TEST_LOOPModeB_ON); // @sic R5-206332 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_4_TestBody(v_EUTRA_SysInfoList);

    f_NR_TestBody_Set(false);

    // UE now on EUTRA
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_1_3_4
   * @param     p_CoOrd_SysInfo
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_4_TestBody(EUTRA_NR_CoOrd_SysInfo_Type p_CoOrd_SysInfo) runs on NR5GC_PTC
  {
    var template (value) CellReselectionPriorities v_CellReselectionPriorities;
    var PDUSessionInfoList_Type v_PDUSessionInfoList;

    //@siclog "Step 1" siclog@
    f_NR_SetCellPower (nr_Cell1, -88, -88);

    // @sic R5s201465 sic@
    
    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message containing the IE freqPriorityListEUTRA
    v_CellReselectionPriorities:= cs_CellReselectionPriorities({cs_FreqPriorityEUTRA_NRDef(p_CoOrd_SysInfo.Eutra[0].Arfcn, 3),
                                                                cs_FreqPriorityEUTRA_NRDef(p_CoOrd_SysInfo.Eutra[1].Arfcn, 5)},
                                                                {cs_FreqPriorityNR(f_NR_CellInfo_GetFrequencySSB(nr_Cell1), 4)},
                                                                omit);

    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, -, v_CellReselectionPriorities))); // @sic R5-202623, R5s210167 sic@
    f_NR_RRCRelease_Local(nr_Cell1, f_NR_GetNextSendOccasion_DL(nr_Cell1)); // @sic R5s210167 sic@

    //@siclog "Step 3" siclog@
    // NR power level doesn't change
    // Send both authentication and NR sysinfo paramters to EUTRA
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);
    
    //@siclog "Step 5" siclog@
    // NR power level doesn't change
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Step 4");
    f_NR5GC_IRAT_S1ToN1_IdleMode (nr_Cell1, noRrcConnectionRelease, false); // @sic R5-202623 sic@

    //@siclog "Step 5AA - 5AB" siclog@
    f_NR_RRCReconfigExistingDRBs(nr_Cell1, omit); // @sic R5-202623 sic@

    // @siclog "Step 5A" siclog@
    v_PDUSessionInfoList := f_NR5GC_MobileInfo_GetSessionInfoList();
    f_NR5GC_LoopbackIPdataOnDefaultBearer(nr_Cell1, v_PDUSessionInfoList[0], "Step 5C"); // @sic R5-206332 sic@

    //@siclog "Step 6" siclog@
    //The SS transmits an RRCRelease message containing the IE freqPriorityListEUTRA and T320
    v_CellReselectionPriorities:= cs_CellReselectionPriorities({cs_FreqPriorityEUTRA_NRDef(p_CoOrd_SysInfo.Eutra[0].Arfcn, 3)},
                                                               {cs_FreqPriorityNR(f_NR_CellInfo_GetFrequencySSB(nr_Cell1), 4)}, // @sic R5-202623 sic@
                                                                min5);

    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, -, v_CellReselectionPriorities))); // @sic R5-202623, R5s210167 sic@
    f_NR_RRCRelease_Local(nr_Cell1, f_NR_GetNextSendOccasion_DL(nr_Cell1)); // @sic R5s210167 sic@

    //@siclog "Step 7" siclog@
    // NR power level doesn't change
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Step 7"));
    
    //@siclog "Step 8" siclog@
    if (not f_NR_CheckNoRRCSetupReq(nr_Cell1, f_NR_SetTimerToleranceMin (nr_Cell1, rrcTimer, 300.0))) { // @sic R5-202623 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
    }
    //@siclog "Step 9" siclog@
    // Send both authentication and NR sysinfo paramters to EUTRA
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);

    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Postamble");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.7a
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_7a_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Success / Deprioritisation / NR / T325 expiry
    var boolean v_IsFR1 := false;
    var EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_SysInfoList;

    f_NR5GC_IRAT_Init(NR_7);

    //@sic R5-233358 sic@
    // Send SysInfo from NR Cell 1 to EUTRA
    f_EUTRA_NR_SendSysinfoCoOrd(EUTRA, f_NR5GC_IRAT_ListOfFrequencies());  // sends Freq. Info to the other RAT

    // Get EUTRA frequency info
    v_EUTRA_SysInfoList := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);

    v_IsFR1 := f_NR_CellInfo_GetIsFR1( nr_Cell1 );
    if ( not v_IsFR1) // FR2
    {
     // Set specific SIB 5
     f_NR5GC_CellInfo_SetSIB5(nr_Cell1, cs_38508_SIB5_Def({cds_CarrierFreqEUTRA_cellResel_thrX(v_EUTRA_SysInfoList.Eutra[0].Arfcn,
                                                                                               0,    // 0 dB
                                                                                               0,    // 0 dB
                                                                                               1)},
                                                               7));
    }

    //Update SIB1 according to specific message contents
    f_NR_CellInfo_SetTAC (nr_Cell3, int2bit(3,24));



    //Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower (nr_Cell1, -85, -82);  // @sic R5-234558 sic@
    f_NR_CellInfo_InitMaxReferencePower (nr_Cell3, -79, tsc_NR_ServingCellSSS_EPRE_FR2);  // @sic R5-234558 sic@
    
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);

    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_7a_TestBody();

    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell3, STATE_IDLE_1A); // @sic R5s211680 sic@
    
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_1_3_7a
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_7a_TestBody() runs on NR5GC_PTC
  {
    var template (value) RRCRelease_IEs.deprioritisationReq v_DeprioritisationReq;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var float v_T325 := f_NR_SetTimerToleranceMin(nr_Cell1, rrcTimer, 300.0);
    var integer v_T325_InMillisec := float2int(v_T325 * 1000.0);
    var template NG_TrackingAreaId v_TAI := f_LastVisited_TAI (nr_Cell1); // @sic R5s211680 sic@
    var SubFrameTiming_Type v_TimingAtT; // @sic R5s211680 sic@
    var integer v_ReleaseMilliSecondsDelay := 300; //tsc_NR_DelayBeforeIntraCellHO @sic R5s211680 sic@

    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, -85, -82),  // @sic R5-234558 sic@
      cs_NR_CellPower(nr_Cell3, -79, -91)   // @sic R5-234558 sic@
    };

    //@siclog "Step 1" siclog@
    //The SS adjusts the SS/PBCH EPRE levels according to row "T1" in table 8.1.1.3.7a.3.2-1/2
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message on NR Cell 1 including IE deprioritisationReq.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_OctetData(int2oct(v_T325_InMillisec, 4), "T325"));
    v_TimingAtT := f_NR_GetNextSendOccasion_DL(nr_Cell1, v_ReleaseMilliSecondsDelay); //Timing of sending RRCRelease is after delay with 300ms // @sic R5s211680 sic@
    v_DeprioritisationReq := cs_NR_DeprioritisationReq(nr, min5);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def, -, -, -, v_DeprioritisationReq), cs_TimingInfo_NR(v_TimingAtT)); // @sic R5s211680 sic@

    //@siclog "Step 4" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.7.2.2-1 is performed and the UE is camped on E-UTRAN Cell 1?
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);

    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Timeout");

    //@siclog "Step 6" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.9.2.2-1 indicate that the UE is camped on NR Cell 3?
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell3, -, -, -, v_TAI); // @sic R5s211680 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.10
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_10_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Redirection from NR to EUTRA / MPS Priority Indication
  
    f_NR5GC_IRAT_Init(NR_6);

    f_NR_CellInfo_InitMaxReferencePower (nr_Cell1, -85, -82);
    
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower (nr_Cell1, -85, -82);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Preamble"));

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_10_TestBody();

    f_NR_TestBody_Set(false);

    // UE now on EUTRA
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_1_3_10
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_10_TestBody() runs on NR5GC_PTC
  {
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);

    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message (IE mpsPriorityIndication-r16 and redirectionInformation including ARFCN-ValueEUTRA of EUTRA cell 1).
    v_RedirectedCarrierInfo := cs_NR_RedirectedCarrierInfoToEUTRA(v_CoOrd_SysInfo.Eutra[0].Arfcn);
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, v_RedirectedCarrierInfo, -, -, cs_RRCConnectionRelease_All_IEs_v1540(-, cs_RRCRelease_v1610_IEs(cs_RRCRelease_v1650_IEs(true_))) )));

    //@siclog "Step 4" siclog@
    // Send both authentication and NR sysinfo parameters to EUTRA
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);

    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Power Level"); // @sic R5s240646 sic@
    f_NR_SetCellPower (nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Postamble");
  }

}
