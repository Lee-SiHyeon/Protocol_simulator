  template (value) FrequencyInfoDL_SIB  cs_38508_FrequencyInfoDL_SIB(template (value) NR_MultiBandInfo p_NR_MultiBandInfo,
                                                                     integer p_OffsetToPointA,
                                                                     FrequencyInfoDL_SIB.scs_SpecificCarrierList p_SCS_SpecificCarrier)  :=
  { // As per 38.508-1 Table 4.6.3-43A: FrequencyInfoDL-SIB
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    frequencyBandList       := {p_NR_MultiBandInfo},
