module Mobility_Registration_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EPS_NAS_Constants all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA38_NR5GC_InitialRegistration all;
  import from EUTRA_CellInfo all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_NASSteps all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRC_Templates all;
  import from NAS_AuxiliaryDefsAndFunctions all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NAS_Templates all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.3.1.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_9_3_1_1_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //Mobility Registration Update / Single-registration mode with N26 / 5GMM-IDLE / 5GC to EPC
    
    f_EUTRA38_IRAT_NAS_Init(LTE_AllCellsOnSamePLMN, c31);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_CellA);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_CellA);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_9_3_1_1_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_CellA, E2_T3440); // @sic R5-211405 sic@
    // take down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_9_3_1_1_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_9_3_1_1_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    // @siclog "Step 1" siclog@
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);
    
    // @siclog "Step 2" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_CellA, tsc_RRC_TI_Def, -, -, noRrcConnectionRelease);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2");

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.3.1.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_9_3_1_2_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //Mobility Registration Update / Single-registration mode with N26 / 5GMM-IDLE / EPC to 5GC
    
    var NAS_MSG_Indication_Type v_NAS_Ind;

    f_EUTRA38_IRAT_NAS_Init(LTE_AllCellsOnSamePLMN, c31);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_CellA);
    
    // Wait for UE to register on NR
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Preamble");
    
    // First switch cell on
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);
    
    // Switch on UE
    f_EUTRA_SwitchOnAndResetIMS();
    
    // Steps 1 - 4
    v_NAS_Ind := f_EUTRA_InitialRegistration_Step1_4(eutra_CellA, PREAMBLE, NORMAL);
    if (not match (v_NAS_Ind.Pdu.Msg, cdr_ATTACH_REQUEST_WithIMSIAndnoTAI(f_GetEAttachType(NORMAL), f_GetAdditionalUpdateType(NORMAL), f_Imsi2MobileIdentity(px_IMSI_Def)))) { // @sic R5-205142 sic@
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Attach Request not correct");
    }
    
    // Now continue with the rest of the procedure
    f_EUTRA38_MultiPDN_InitialRegistration_Step5_18b1 (eutra_CellA, TESTMode_OFF, v_NAS_Ind);

    // Ok now registered on both RATs
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Preamble"));
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_9_3_1_2_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    // take down the cell now
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_9_3_1_2_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_9_3_1_2_NR5GC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    // @siclog "Step 1" siclog@
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    
    // @siclog "Step 2" siclog@
    f_EUTRA38_Send_AuthParametersToNR();
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_CellA);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.3.1.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_9_3_1_3_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //Mobility and periodic Registration Update / Rejected / Single-registration mode with N26 / 5GMM-IDLE / Handling of EPC relevant parameters
    
    f_EUTRA38_IRAT_NAS_Init(LTE_AllCellsOnSamePLMN, c31);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_CellA);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_CellA);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_9_3_1_3_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_CellA, E1_IDLE);
    // take down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_9_3_1_3_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_9_3_1_3_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var NAS_MSG_Indication_Type v_NAS_Ind;
    
    f_EUTRA_MobileInfo_SetNetworkFeatureSupport (cs_EPS_NwkFtSup_NR);
    f_EUTRA_MobileInfo_SetAssignedPdnType(PDN_1, f_GetPdnType());
    
    // @siclog "Step 5" siclog@
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Test Body");
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_SuitableCellRS_EPRE, tsc_SuitableCellRS_EPRE_FR2); //@sic  R5-241629 sic@
    
    v_NAS_Ind := f_EUTRA_RRC_ConnEst_DefWithNas(eutra_CellA,
                                                tsc_RRC_TI_Def,
                                                cr_EstablishmentCause_Any,
                                                cr_NAS_IndicationWithPiggybacking(tsc_SHT_NoSecurityProtection,
                                                                                  cdr_ATTACH_REQUEST_ImsiNoOldGUTI(f_GetEAttachType(NORMAL),
                                                                                  f_GetAdditionalUpdateType(NORMAL)),
                                                                                  cr_508_PDN_CONNECTIVITY_REQUEST(tsc_PdnRequest_InitialAttach, f_GetPdnType())));

    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    // @sic R5s194877 do extra checks now on Attach Req message sic@
    if (not ispresent (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueAddSecurityCap)){
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueAddSecurityCap should be present for ENDC");
    }
    if (not match (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueNetworkCapability, cdr_NR5GC_UENetworkCap(omit))){
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueNetworkCapability does not indicate support for NR");
    }
    
    f_EUTRA38_MultiPDN_InitialRegistration_Step5_18b1 (eutra_CellA, TESTMode_OFF, v_NAS_Ind); // @sic R5-204399 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.3.1.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_9_3_1_4_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //NSAC / interworking with EPC
    
    f_EUTRA38_IRAT_NAS_Init(LTE_AllCellsOnSamePLMN, c31);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_CellA);
    
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Preamble");
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_9_3_1_4_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_CellA, E1_IDLE);   // @sic R5-237428 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));  // @sic R5-237428 sic@
    
  }

  /*
   * @desc      test body of TC_9_3_1_4_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_9_3_1_4_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var charstring v_AT_Response;
    var NAS_PlmnId v_PLMN := f_Asn2Nas_PlmnId(f_EUTRA_CellInfo_GetGutiPLMN(eutra_CellA));
   
    // @siclog "Step 16" siclog@
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA38_SetCellPower(eutra_CellA, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);
    
    // @siclog "Step 17" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_CellA, tsc_RRC_TI_Def, omit);     // @sic R5s240165 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 17");

    // @siclog "Step 18-19 Void" siclog@
    // @sic R5-237428 sic@

    //@siclog "Step 20" siclog@
    // Check: Is S-NSSAI=1 in the Rejected NSSAI list PLMN using AT/MMI command +C5GNSSAIRDP
    // @sic R5-237428 sic@
    v_AT_Response := f_UT_ReadXtdRejectedNSSAI(UT, f_ConvertPLMNtoString(v_PLMN)); // @sic R5s240296 sic@
    if (f_MatchXtdRejectedNSSAI_WithATCommand({cs_XtdRejectedS_NSSAI('0001'B, '0011'B, '01'O, omit, omit, omit)},
                                          v_AT_Response)) { // @sic R5-260881 sic@
      f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    } else {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
    }
    if (not f_MatchXtdRejectedNSSAI_WithATCommand({cs_XtdRejectedS_NSSAI('0001'B, '0000'B, '02'O, omit, omit, omit)},
                                          v_AT_Response)) { // @sic R5-260881 sic@
      f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    } else {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
    }
       
    // @siclog "Step 23-33 void" siclog@
    // @sic R5-237428, R5-260881 sic@
  }

}
