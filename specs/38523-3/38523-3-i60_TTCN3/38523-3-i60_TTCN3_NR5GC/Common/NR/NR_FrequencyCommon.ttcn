module NR_FrequencyCommon {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_NR_Parameters all;
  import from TestcaseProperties all;

  const AdditionalSpectrumEmission tsc_AdditionalSpectrumEmission := 0; /* As per 38.508-1 Table 4.6.3-1: AdditionalSpectrumEmission
                                                                           @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const P_Max tsc_P_Max23 := 23;                                        /* Acc to 38.508-1 Table 4.6.3-89: P-Max 23
                                                                           @sic R5-211855 sic@
                                                                           @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const P_Max tsc_P_Max20 := 20;                                        /* Acc to 38.508-1 Table 4.6.3-89: P-Max 20
                                                                           @sic R5-211855 sic@
                                                                           @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  type record NR_Frequencyf1tof4_Type
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-203056 sic@
    NR_SS_FrequencyInfoDL_Type    FrequencyInfoDL_f1 optional,
    NR_SS_FrequencyInfoUL_Type    FrequencyInfoUL_f1 optional,
    NR_SS_FrequencyInfoDL_Type    FrequencyInfoDL_f2 optional,
    NR_SS_FrequencyInfoUL_Type    FrequencyInfoUL_f2 optional,
    NR_SS_FrequencyInfoDL_Type    FrequencyInfoDL_f3 optional,
    NR_SS_FrequencyInfoUL_Type    FrequencyInfoUL_f3 optional,
    NR_SS_FrequencyInfoDL_Type    FrequencyInfoDL_f4 optional,
    NR_SS_FrequencyInfoUL_Type    FrequencyInfoUL_f4 optional
  };

  type  record NR_SS_FrequencyInfoDL_Type
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FrequencyInfoDL         FrequencyInfoDL,
    integer                 DL_ChannelBandwith,
    SubcarrierSpacing       SSB_SubcarrierSpacing optional,
    integer                 Ssb_SubcarrierOffset optional,
    ControlResourceSetZero  Coreset0_Index optional,
    integer                 OffsetToPointA optional,
    integer                 OffsetCarrierCORESET0 optional, //@sic R5-200678 R5-202578 sic@
    integer                 Coreset0_OffsetRBs optional   //@sic R5-201020 sic@
  };

  type  record NR_SS_FrequencyInfoUL_Type    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  {
    FrequencyInfoUL         FrequencyInfoUL,
    integer                 UL_ChannelBandwith
  };

  type enumerated NR_CA_Tested_Type { CA_IntraBandContiguous, CA_InterBand, CA_IntraBandNonContiguous };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_Frequencyf1tof4_Type cs_NR_Frequencyf1tof4_Dummy :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FrequencyInfoDL_f1 := omit,
    FrequencyInfoUL_f1 := omit,
    FrequencyInfoDL_f2 := omit,
    FrequencyInfoUL_f2 := omit,
    FrequencyInfoDL_f3 := omit,
    FrequencyInfoUL_f3 := omit,
    FrequencyInfoDL_f4 := omit,
    FrequencyInfoUL_f4 := omit
  };

  template (value) NR_SS_FrequencyInfoDL_Type cs_SS_FrequencyInfoDL(template (value) FrequencyInfoDL p_FrequencyInfoDL,
                                                                    integer p_DL_ChannelBandwith,
                                                                    SubcarrierSpacing p_SSB_SubcarrierSpacing,
                                                                    template (omit) integer p_Kssb := omit,
                                                                    template (omit) ControlResourceSetZero p_Coreset0_Index := omit,
                                                                    template (omit) integer p_OffsetToPointA := omit,
                                                                    template (omit) integer p_OffsetCarrierCORESET0 := omit,
                                                                    template (omit) integer p_Coreset0_OffsetRBs := omit
                                                                    ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-202578 sic@
    FrequencyInfoDL  :=   p_FrequencyInfoDL,
    DL_ChannelBandwith := p_DL_ChannelBandwith,
    SSB_SubcarrierSpacing := p_SSB_SubcarrierSpacing,
    Ssb_SubcarrierOffset := p_Kssb,
    Coreset0_Index := p_Coreset0_Index,
    OffsetToPointA := p_OffsetToPointA,
    OffsetCarrierCORESET0 := p_OffsetCarrierCORESET0,
    Coreset0_OffsetRBs := p_Coreset0_OffsetRBs
  };

  template (value) FrequencyInfoDL cs_FrequencyInfoDL(ARFCN_ValueNR                        p_SSB_ARFCN,
                                                      FreqBandIndicatorNR                  p_FreqBandIndicatorNR,
                                                      ARFCN_ValueNR                        p_PointA,
                                                      SCS_SpecificCarrier.offsetToCarrier  p_OffsetToCarrier,
                                                      SubcarrierSpacing                    p_SubcarrierSpacing,
                                                      SCS_SpecificCarrier.carrierBandwidth p_CarrierBandwidth):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    absoluteFrequencySSB := p_SSB_ARFCN,
    frequencyBandList := {
      p_FreqBandIndicatorNR
    },
    absoluteFrequencyPointA := p_PointA,
    scs_SpecificCarrierList := {
      cs_SCS_SpecificCarrier(p_OffsetToCarrier, p_SubcarrierSpacing, p_CarrierBandwidth)
    },
    referenceCell_r18 := omit    /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) SCS_SpecificCarrier cs_SCS_SpecificCarrier(SCS_SpecificCarrier.offsetToCarrier  p_OffsetToCarrier,
                                                              SubcarrierSpacing                    p_SubcarrierSpacing,
                                                              SCS_SpecificCarrier.carrierBandwidth p_CarrierBandwidth) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    offsetToCarrier     := p_OffsetToCarrier,
    subcarrierSpacing   := p_SubcarrierSpacing,
    carrierBandwidth    := p_CarrierBandwidth,
    txDirectCurrentLocation := omit          // @sic BASELINE MOVING OCT 2018 R5s201387 BASELINE MOVING 2020 sic@
  };

  template (value) NR_SS_FrequencyInfoUL_Type cs_SS_FrequencyInfoUL(template (value) FrequencyInfoUL p_FrequencyInfoUL,
                                                                    integer p_UL_ChannelBandwith
                                                                    ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FrequencyInfoUL  :=   p_FrequencyInfoUL,
    UL_ChannelBandwith := p_UL_ChannelBandwith
  };

  template (value) FrequencyInfoUL cs_FrequencyInfoUL(template (omit) MultiFrequencyBandListNR p_MultiFrequencyBandListNR := omit,
                                                      template (omit) ARFCN_ValueNR        p_PointA := omit,
                                                      SCS_SpecificCarrier.offsetToCarrier  p_OffsetToCarrier,
                                                      SubcarrierSpacing                    p_SubcarrierSpacing,
                                                      SCS_SpecificCarrier.carrierBandwidth p_CarrierBandwidth,
                                                      template (omit) P_Max                p_Max):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-194804 R5-255209 sic@
    frequencyBandList := p_MultiFrequencyBandListNR,
    absoluteFrequencyPointA := p_PointA,
    scs_SpecificCarrierList :=  {cs_SCS_SpecificCarrier ( p_OffsetToCarrier, p_SubcarrierSpacing, p_CarrierBandwidth )},
    additionalSpectrumEmission := tsc_AdditionalSpectrumEmission,
    p_Max := p_Max,
    frequencyShift7p5khz := omit,
    additionalSpectrumEmission_v1760     := omit,  /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    additionalSpectrumEmissionAerial_r18 := omit   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  /*
   * @desc      return P-Max as per 38.508-1 Table 4.6.3-89: P-Max
   * @param     p_IsBandFR1
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitP_Max(boolean p_IsBandFR1) return template (omit) P_Max
  { //@sic R5-190784 R5-211855: removed parameter p_IsBandFR1 sic@
    //@sic R5-255209: added p_IsBandFR1 - Return parameter set as template(omit) sic@
    var template (omit) P_Max v_P_Max := tsc_P_Max23;
    
    if (f_GetTestcaseAttrib_ENDC(testcasename()) and not(pc_dynamicPowerSharingENDC) and p_IsBandFR1) {
        v_P_Max := tsc_P_Max20;
    } else {
      if (not(p_IsBandFR1)) { //FR2
        v_P_Max := omit;
      }
    }
    return v_P_Max;
  }

}
