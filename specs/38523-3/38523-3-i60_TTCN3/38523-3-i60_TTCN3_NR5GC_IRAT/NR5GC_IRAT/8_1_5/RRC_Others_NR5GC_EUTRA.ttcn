module RRC_Others_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.5.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_5_5_1_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  { //Redirection to NR / From E-UTRA / Success
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    
    f_EUTRA38_IRAT_Init(c31);

    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(NR);   // NR Cell 1 information Rx.
 
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    //Preamble: finishes with EUTRA cell on (NR cell off) and co-ord msg sent to say UE has completed registration on EUTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Preamble");               // Wait for UE to register on NR first
    f_EUTRA38_NR5GC_Preamble (eutra_Cell1, TESTMode_OFF, RRC_CONNECTED); // Go on to EUTRA RRC_CONNECTED while NR is already off
    f_EUTRA38_SetCellPower(eutra_Cell1, -85, -85); //@sic R5-202644 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Preamble"));    // inform NR side about registration on both sides
          
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_5_5_1_NR5GC_EUTRA_TestBody (v_CoOrd_SysInfo);
    f_EUTRA_TestBody_Set(false);
    
    // take down the cell now, UE finished postamble on NR side
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_5_5_1_NR5GC_EUTRA
   * @param     p_CoOrd_SysInfo
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_5_5_1_NR5GC_EUTRA_TestBody(EUTRA_NR_CoOrd_SysInfo_Type p_CoOrd_SysInfo) runs on EUTRA_5GS_PTC
  {
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo := cs_RedirectionInfo_NR(p_CoOrd_SysInfo.NR[0].Arfcn,
                                                                                                f_NR_ConvertIntToSCS_CarrierInfoNR(p_CoOrd_SysInfo.NR[0].SCS)); //SubcarrierSpacingSSB
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR);
    
    // @siclog "Step 0" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, -85, -96); //@sic R5-237355 sic@
    
    // Change power level in NR PTC
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Step 0"));  //@sic R5-237355 sic@
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Step 1"); //@sic R5-237355 sic@
    
    // @siclog "Step 1" siclog@
    //The SS transmits an RRCConnectionRelease message indicating redirection to NR Cell 1.
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell1, cs_RRCConnectionRelease(tsc_RRC_TI_Def, other, v_RedirectedCarrierInfo), cs_TimingInfo_Now);
    
    // @sic R5s201060 sic@
   
   //@siclog "Step 2" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.9 indicate that the UE has performed mobility registration updating when it camps on NR Cell 1?
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell1);
  }

}
