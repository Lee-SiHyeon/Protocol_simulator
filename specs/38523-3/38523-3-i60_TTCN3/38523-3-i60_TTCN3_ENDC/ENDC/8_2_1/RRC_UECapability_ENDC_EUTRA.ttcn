               } ifpresent,
               irat_ParametersNR_v1540  := {
                   eutra_5GC_HO_ToNR_FDD_FR1_r15    := *,
                   eutra_5GC_HO_ToNR_TDD_FR1_r15    := *,
                   eutra_5GC_HO_ToNR_FDD_FR2_r15    := *,
                   eutra_5GC_HO_ToNR_TDD_FR2_r15    := *,
                   eutra_EPC_HO_ToNR_FDD_FR1_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
                   eutra_EPC_HO_ToNR_TDD_FR1_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
                   eutra_EPC_HO_ToNR_FDD_FR2_r15    := *,
                   eutra_EPC_HO_ToNR_TDD_FR2_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
                   ims_VoiceOverNR_FR1_r15 := *,
                   ims_VoiceOverNR_FR2_r15 := *,
                   sa_NR_r15 := *,
                   supportedBandListNR_SA_r15 := *  // @sic R5s230380 sic@
               } ifpresent
             } ifpresent,
             tdd_Add_UE_EUTRA_Capabilities_v1540 := {
               eutra_5GC_Parameters_r15 := {
                   eutra_5GC_r15    := *,
                   eutra_EPC_HO_EUTRA_5GC_r15 := *,
                   ho_EUTRA_5GC_FDD_TDD_r15 := *,
                   ho_InterfreqEUTRA_5GC_r15 := *,
                   ims_VoiceOverMCG_BearerEUTRA_5GC_r15 := *,
                   inactiveState_r15 := *,
                   reflectiveQoS_r15 := *
               } ifpresent,
               irat_ParametersNR_v1540  := {
                   eutra_5GC_HO_ToNR_FDD_FR1_r15    := *,
                   eutra_5GC_HO_ToNR_TDD_FR1_r15    := *,
                   eutra_5GC_HO_ToNR_FDD_FR2_r15    := *,
                   eutra_5GC_HO_ToNR_TDD_FR2_r15    := *,
                   eutra_EPC_HO_ToNR_FDD_FR1_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
                   eutra_EPC_HO_ToNR_TDD_FR1_r15    := *,// checked in fl_Check_IRAT_ParametersNR_v1540
                   eutra_EPC_HO_ToNR_FDD_FR2_r15    := *,
