module RRC_SON_RACH_Optimisation_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_MDT_Specific_Templates all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;

    template (present) PerRAAttemptInfo_r16 cr_PerRAInfoList_r16_contentionDetected_true :=
    /* @status    APPROVED (NR5GC) */
    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      cr_PerRAInfoList_r16_Def (true, ?);

    template (present) PerRAAttemptInfo_r16 cr_PerRAInfoList_r16_contentionDetected_false :=
    /* @status    APPROVED (NR5GC) */
    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      cr_PerRAInfoList_r16_Def (false, ?);

    template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_81641(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                template (value) NR_RachProcedureMsg4RrcMsg_Type p_RachProcedureMsg4)  :=   //@sic R5s220873 sic@
    { /* @status    APPROVED (NR5GC) */
    RachProcedureList := {
      cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_Msg4Based(cs_NR_RachProcedureMsg4(p_PhysicalParameters, cs_NR_ContentionResolutionId_Unmatch, p_RachProcedureMsg4))),
      cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_Msg4Based(cs_NR_RachProcedureMsg4(p_PhysicalParameters, cs_NR_ContentionResolutionId_Unchanged, p_RachProcedureMsg4)))
      }
    };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.4.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_4_1_NR5GC() runs on NR5GC_PTC
  { // SON / RACH logging and reporting

    // System information combination NR-1 as defined in TS 38.508-1 clause 4.4.3.1.2 is used in NR Cells.
    f_NR5GC_Init(NR_1);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // Preamble: The UE is in state 3N-A on NR Cell 1 according to TS 38.508-1, clause 4.4A.2 Table 4.4A.2-3
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);

    f_TC_8_1_6_4_1_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } // end of f_TC_8_1_6_4_1_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.4.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_4_1_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters ;
    var template (value) NR_RachProcedureConfig_Type v_NR_RachProcedure;
    var RA_ReportList_r16 v_NR_RA_Report_r16;  //@sic R5s220873 sic@
    var PerRAAttemptInfoList_r16 v_PerRAAttemptInfoList;
    var PLMN_Identity v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);
    var CellIdentity v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var TrackingAreaCode v_TAC_Cell1 := f_NR_CellInfo_GetTAC (nr_Cell1);
    var template (value) DL_CCCH_Message v_RRCSetup;
    var template (value) NR_RachProcedureMsg4RrcMsg_Type v_RachProcedureMsg4RrcMsg;
    var octetstring v_EncodedMsg4;
    var integer v_FieldCnt;
    var integer i;

    // @siclog "Step 1" siclog@
    // The SS transmits a UEInformationRequest message on NR Cell 1.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_NR_UEInformationRequest_RA));
    // @siclog "Step 2" siclog@
    // @sic R5-252796 sic@
    // UE transmits a UEInformationResponse message.
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                        cr_38508_UEInformationResponse(tsc_NR_RRC_TI_Def)));
    // @siclog "Step 3" siclog@
    // SS transmits an RRCRelease message to release the RRC connection.
    f_NR_RRCRelease(nr_Cell1);
    // @sic R5-252796 sic@
    // @siclog "Step 3A-3H" siclog@
    // Steps 1 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 [4] table 4.5.4.2-3 on NR Cell 1.
    f_NR5GC_RRC_ConnectedState3N_Def(nr_Cell1);
    // @siclog "Step 3I" siclog@
    // The SS transmits a UEInformationRequest message.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_NR_UEInformationRequest_RA));
    // @siclog "Step 3J" siclog@
    // Check: Does the UE transmit a UEInformationResponse message with RA-Report?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                        cr_38508_UEInformationResponse(tsc_NR_RRC_TI_Def,-,-,-,-,?))) -> value v_ReceivedAsp;
    // @sic R5s220873 sic@
    v_NR_RA_Report_r16 := v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.ra_ReportList_r16;
    if (match(v_NR_RA_Report_r16[0],
              cr_NR_RA_Report_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1, v_TAC_Cell1),
              cr_RA_InformationCommon_r16(?))))
    {
        v_PerRAAttemptInfoList := v_NR_RA_Report_r16[0].ra_InformationCommon_r16.perRAInfoList_r16[0].perRASSBInfoList_r16.perRAAttemptInfoList_r16;
        v_FieldCnt := lengthof(v_PerRAAttemptInfoList);
        for (i:=0; i<v_FieldCnt; i:=i+1){
            if (match(v_PerRAAttemptInfoList[i],cr_PerRAInfoList_r16_contentionDetected_false))
            {
             // go through the loop
             
            }
            else
            {
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2: condition not fulfilled with the RA-Report including contentionDetected set to false");
              break;
            }
        }
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2:UE transmits UEInformationResponse message with RA-Report including contentionDetected set to false");
    }
    else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2: condition not fulfilled with the received RA-Report contents");
    }
    // @siclog "Step 3K" siclog@
    // SS transmits an RRCRelease message to release the RRC connection.
    f_NR_RRCRelease(nr_Cell1);
    // @siclog "Step 4" siclog@
    // SS waits for 5s.
    f_Delay(5.0);
    // @siclog "Step 5" siclog@
    // SS is configured to transmit MAC control element with non-matched UE Contention Resolution Identity for first RACH procedure and responds with matched UE Contention Resolution from second RACH procedure.
    v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
    // @sic R5s220873 sic@
    v_RRCSetup := f_NR_38508_RRCSetup(nr_Cell1);
    v_EncodedMsg4 := f_NR_RRC_DL_CCCH_Encvalue(v_RRCSetup);
    v_RachProcedureMsg4RrcMsg := cs_NR_RachProcedureMsg4WithCcchMsg(v_EncodedMsg4);
    v_NR_RachProcedure := cs_NR_RachProcedureConfig_81641(v_NR_PhysicalParameters,v_RachProcedureMsg4RrcMsg);
    f_NR_SS_RachProcedureConfig(nr_Cell1, v_NR_RachProcedure);
    // @siclog "Step 6" siclog@
    // SS sends a Paging message to the UE on the appropriate paging block, and including the UE identity in one entry of the IE pagingRecordList.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    // @siclog "Step 7-13" siclog@
    // Steps 2-8 of generic test procedure in TS 38.508-1 Table 4.5.4.2-3 are performed on NR Cell 1.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);// @sic R5s220873 sic@
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(nr_Cell1);
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    // @siclog "Step 14" siclog@
    // The SS transmits a UEInformationRequest message on NR Cell 1.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -, cs_NR_UEInformationRequest_RA));
    // @siclog "Step 15" siclog@
    // Check: Check: Does the UE transmit a UEInformationResponse message with RA-Report?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                        cr_38508_UEInformationResponse(tsc_NR_RRC_TI_Def,-,-,-,-,?))) -> value v_ReceivedAsp;
    // @sic R5s220873 sic@
    v_NR_RA_Report_r16 := v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.ra_ReportList_r16;
    if (match(v_NR_RA_Report_r16[0],
        cr_NR_RA_Report_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1, v_TAC_Cell1),
        cr_RA_InformationCommon_r16(?))))
    {
        v_PerRAAttemptInfoList := v_NR_RA_Report_r16[0].ra_InformationCommon_r16.perRAInfoList_r16[0].perRASSBInfoList_r16.perRAAttemptInfoList_r16;
        v_FieldCnt := lengthof(v_PerRAAttemptInfoList);
        for (i:=0; i<v_FieldCnt; i:=i+1){
            if (match(v_PerRAAttemptInfoList[i],cr_PerRAInfoList_r16_contentionDetected_true))
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15:UE transmits UEInformationResponse message with RA-Report including contentionDetected set to true ");
                break;
            }
            else
            {
                if(i==v_FieldCnt-1){
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2: condition not fulfilled with the RA-Report including contentionDetected set to true");
                }
            }
        }
    }
    else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 15: condition not fulfilled with the received RA-Report contents");
    }
 }//end of f_TC_8_1_6_4_1_NR5GC_TestBody

}
