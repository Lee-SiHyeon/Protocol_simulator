  /*
   * @desc      Function to check PICS within optional groups of fields matching with ifpresent in Rel-15.
   *            PICS shall not be set if it is in a group not signalled by the UE. If there is a mismatch, an inconclusive verdict is raised.
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_PICSinOptionalGroups_NR_r15 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg := p_NRCapability;

   fl_Check_RootPICSinOptionalGroups_NR_r15(v_Received_NRCapabilityMsg);

    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension)) {  // UE_NR_Capability_v1530
        if (pc_inactiveState) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_NR_Capability_v1530, no PICS shall be set in a branch when parent is not present");
        }
    }
    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.interRAT_Parameters)) {  // UE_NR_Capability_v1530.interRAT_Parameters
        if (pc_RS_SINR_MeasEUTRA or pc_interRAT_NR_ToENDC) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_NR_Capability_v1530.interRAT_Parameters, no PICS shall be set in a branch when parent is not present");
        }
    }
    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {  // UE_NR_Capability_v1560
        if (pc_reducedCP_Latency) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_NR_Capability_v1560, no PICS shall be set in a branch when parent is not present");
        }
    }
  }; //end of fl_Check_PICSinOptionalGroups_NR_r15

  /*
