module NR_RRC_BWP_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_CommonDefs all;
  import from NR_RRC_Templates all;
  import from TestcaseProperties all;

  const SearchSpaceId tsc_NR_SearchSpaceId_Zero := 0;                 /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const  B45_Type tsc_Coreset1_FrequencyDomain  := '111100000000000000000000000000000000000000000'B;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const  B45_Type tsc_Coreset1_FrequencyDomain_CBW3  := '110000000000000000000000000000000000000000000'B;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_Coreset_Duration := 2;               /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) BWP_DownlinkDedicated.pdcch_Config cs_PDCCH_ConfigSetup(template (value) PDCCH_Config p_PDCCH_Config) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PDCCH_Config
  };

  template (value) BWP_DownlinkDedicated.pdsch_Config cs_PDSCH_ConfigSetup(template (value) PDSCH_Config p_PDSCH_Config) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PDSCH_Config
  };

  template (value) BWP_UplinkDedicated.pucch_Config cs_PUCCH_ConfigSetup(template (value) PUCCH_Config p_PUCCH_Config) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PUCCH_Config
  };

  template (value) BWP_UplinkDedicated.pusch_Config cs_PUSCH_ConfigSetup(template (value) PUSCH_Config p_PUSCH_Config) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PUSCH_Config
  };

  template (value) BWP cs_38508_BWP(SubcarrierSpacing p_SubcarrierSpacing,
                                    BWP.locationAndBandwidth p_LocationAndBandwidth) :=
  { // As per 38.508-1 Table 4.6.3-8: BWP
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    locationAndBandwidth  := p_LocationAndBandwidth,
    subcarrierSpacing     := p_SubcarrierSpacing,
    cyclicPrefix          := omit
  };

  template (value) BWP_DownlinkCommon cs_38508_BWP_DownlinkCommon(template (value) BWP p_BWP,
                                                                  template (value) PDCCH_ConfigCommon p_PDCCH_ConfigCommon,
                                                                  template (value) PDSCH_ConfigCommon p_PDSCH_ConfigCommon) :=
  { //As per 38.508-1 Table 4.6.3-10: BWP-DownlinkCommon
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    genericParameters    := p_BWP,
    pdcch_ConfigCommon   := {
      setup := p_PDCCH_ConfigCommon
    },
    pdsch_ConfigCommon   := {
      setup := p_PDSCH_ConfigCommon
    }
  };

  template (value) BWP_DownlinkDedicated cs_BWP_DownlinkDedicated_Def(template (omit) BWP_DownlinkDedicated.pdcch_Config p_PDCCH_Config := omit,
                                                                      template (omit) NR_BWP_DownlinkDedicated_PDSCH_Config_Type p_PDSCH_Config := omit,
                                                                      template (omit) NR_BWP_DownlinkDedicated_SPS_Config_Type p_SPS_Config := omit,
                                                                      template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type p_RadioLinkMonitoringConfig := omit,
                                                                      template (omit) DL_PPW_PreConfigToAddModList_r17 p_DlPPW_PreCongigList := omit,
                                                                      template (omit) BWP_DownlinkDedicated.sl_PDCCH_Config_r16 p_SL_PDCCH_Config_r16 := omit
                                                                      ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    pdcch_Config                        := p_PDCCH_Config,
    pdsch_Config                        := p_PDSCH_Config,
    sps_Config                          := p_SPS_Config,
    radioLinkMonitoringConfig           := p_RadioLinkMonitoringConfig,
    sps_ConfigToAddModList_r16          := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    sps_ConfigToReleaseList_r16         := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    sps_ConfigDeactivationStateList_r16 := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    beamFailureRecoverySCellConfig_r16  := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    sl_PDCCH_Config_r16                 := p_SL_PDCCH_Config_r16,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    sl_V2X_PDCCH_Config_r16             := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    preConfGapStatus_r17                := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    beamFailureRecoverySpCellConfig_r17 := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    harq_FeedbackEnablingforSPSactive_r17 := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    cfr_ConfigMulticast_r17             := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    dl_PPW_PreConfigToAddModList_r17    := p_DlPPW_PreCongigList,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    dl_PPW_PreConfigToReleaseList_r17   := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    nonCellDefiningSSB_r17              := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    servingCellMO_r17                   := omit,    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    tci_InDCI_r18                       := omit     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) BWP_DownlinkDedicated cs_38508_BWP_DownlinkDedicated(template (value) PDCCH_Config p_PDCCH_Config,
                                                                        template (value) PDSCH_Config p_PDSCH_Config,
                                                                        template (omit) NR_BWP_DownlinkDedicated_SPS_Config_Type p_SPS_Config := omit,
                                                                        template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type p_RadioLinkMonitoringConfig := omit) :=
  // As per 38.508-1 Table 4.6.3-11: BWP-DownlinkDedicated
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
  cs_BWP_DownlinkDedicated_Def(cs_PDCCH_ConfigSetup(p_PDCCH_Config), cs_PDSCH_ConfigSetup(p_PDSCH_Config), p_SPS_Config, p_RadioLinkMonitoringConfig);

  template (value) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type cs_38508_RadioLinkMonitoringConfigDef(SSB_Index p_SSB_Index) :=
  { // As per 38.508-1 Table 4.6.3-133: RadioLinkMonitoringConfig
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s190244 sic@
    setup := {
       failureDetectionResourcesToAddModList    := {cs_38508_RadioLinkMonitoringRSDef(p_SSB_Index)},
       failureDetectionResourcesToReleaseList   := omit,
       beamFailureInstanceMaxCount              := omit,
       beamFailureDetectionTimer                := omit,
       beamFailure_r17                          := omit   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 R5s230533 BASELINE UPGRADE 2023 sic@ */
    }
  };

  template (value) RadioLinkMonitoringRS cs_38508_RadioLinkMonitoringRSDef(SSB_Index p_SSB_Index) :=
  { // As per 38.508-1 Table 4.6.3-133: RadioLinkMonitoringConfig
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s190244 sic@
    radioLinkMonitoringRS_Id   := 0,
    purpose                    := rlf,
    detectionResource:= {
        ssb_Index := p_SSB_Index  //@sic R5-201148 sic@
    }
  };

  template (value) BWP_UplinkCommon cs_BWP_UplinkCommon_Def(template (value) BWP p_BWP,
                                                            template (omit) BWP_UplinkCommon.rach_ConfigCommon p_RACH_ConfigCommon := omit,
                                                            template (omit) BWP_UplinkCommon.pusch_ConfigCommon p_Pusch_ConfigCommon := omit,
                                                            template (omit) BWP_UplinkCommon.pucch_ConfigCommon p_Pucch_ConfigCommon := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    genericParameters := p_BWP,
    rach_ConfigCommon := p_RACH_ConfigCommon,
    pusch_ConfigCommon := p_Pusch_ConfigCommon,
    pucch_ConfigCommon := p_Pucch_ConfigCommon,
    rach_ConfigCommonIAB_r16     := omit,   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    useInterlacePUCCH_PUSCH_r16  := omit,   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    msgA_ConfigCommon_r16        := omit,   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    enableRA_PrioritizationForSlicing_r17   := omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    additionalRACH_ConfigList_r17           := omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    rsrp_ThresholdMsg3_r17                  := omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    numberOfMsg3_RepetitionsList_r17        := omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    mcs_Msg3_Repetitions_r17                := omit,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    additionalRACH_perPCI_ToAddModList_r18  := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    additionalRACH_perPCI_ToReleaseList_r18 := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    rsrp_ThresholdMsg1_RepetitionNum2_r18   := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    rsrp_ThresholdMsg1_RepetitionNum4_r18   := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    rsrp_ThresholdMsg1_RepetitionNum8_r18   := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    preambleTransMax_Msg1_Repetition_r18    := omit    /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) BWP_UplinkCommon cs_38508_BWP_UplinkCommon(template (value) BWP p_BWP,
                                                              template (value) RACH_ConfigCommon p_RACH_ConfigCommon,
                                                              template (value) PUSCH_ConfigCommon p_PUSCH_ConfigCommon,
                                                              template (value) PUCCH_ConfigCommon p_PUCCH_ConfigCommon) :=
  //Acc to 38.508-1 Table 4.6.3-14: BWP-UplinkCommon
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  cs_BWP_UplinkCommon_Def(p_BWP, cs_Rach_ConfigCommon_Config_Setup(p_RACH_ConfigCommon), cs_Pusch_ConfigCommon_Setup(p_PUSCH_ConfigCommon), cs_Pucch_ConfigCommon_Setup(p_PUCCH_ConfigCommon));

  template (value) BWP_UplinkCommon.rach_ConfigCommon cs_Rach_ConfigCommon_Config_Setup (template (value) RACH_ConfigCommon p_RACH_ConfigCommon) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_RACH_ConfigCommon
  };

  template (value) BWP_UplinkCommon.pucch_ConfigCommon cs_Pucch_ConfigCommon_Setup (template (value) PUCCH_ConfigCommon p_PUCCH_ConfigCommon) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PUCCH_ConfigCommon
  };

  template (value) BWP_UplinkCommon.pusch_ConfigCommon cs_Pusch_ConfigCommon_Setup (template (value) PUSCH_ConfigCommon p_PUSCH_ConfigCommon):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    setup := p_PUSCH_ConfigCommon
  };

  template (value) BWP_UplinkDedicated cs_BWP_UplinkDedicated_Def( template (omit) BWP_UplinkDedicated.pucch_Config p_Pucch_Config := omit,
                                                                   template (omit) BWP_UplinkDedicated.pusch_Config p_Pusch_Config := omit,
                                                                   template (omit) BWP_UplinkDedicated.srs_Config p_SRS_Config := omit,
                                                                   template (omit) BWP_UplinkDedicated.lbt_FailureRecoveryConfig_r16 p_LBT_FailureRecoveryConfig_r16 := omit
                                                                   ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // all omit
    pucch_Config := p_Pucch_Config,
    pusch_Config := p_Pusch_Config,
    configuredGrantConfig   := omit,
    srs_Config                     := p_SRS_Config,
    beamFailureRecoveryConfig      := omit,
    sl_PUCCH_Config_r16            := omit,
    cp_ExtensionC2_r16             := omit,
    cp_ExtensionC3_r16             := omit,
    useInterlacePUCCH_PUSCH_r16    := omit,
    pucch_ConfigurationList_r16    := omit,
    lbt_FailureRecoveryConfig_r16  := p_LBT_FailureRecoveryConfig_r16,
    configuredGrantConfigToAddModList_r16     := omit,
    configuredGrantConfigToReleaseList_r16    := omit,
    configuredGrantConfigType2DeactivationStateList_r16 := omit,
    ul_TCI_StateList_r17                  := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    ul_powerControl_r17                   := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    pucch_ConfigurationListMulticast1_r17 := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    pucch_ConfigurationListMulticast2_r17 := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    pucch_ConfigMulticast1_r17            := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    pucch_ConfigMulticast2_r17            := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    pathlossReferenceRSToAddModList_r17   := omit,      /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
    pathlossReferenceRSToReleaseList_r17  := omit       /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
  };

  template (value) BWP_UplinkDedicated cs_38508_BWP_UplinkDedicated(template (value) PUCCH_Config p_PUCCH_Config,
                                                                    template (value) PUSCH_Config p_PUSCH_Config,
                                                                    template (omit) BWP_UplinkDedicated.srs_Config p_SRS_Config,
                                                                    template (omit) BWP_UplinkDedicated.lbt_FailureRecoveryConfig_r16 p_LBT_FailureRecoveryConfig_r16 := omit
                                                                    ) :=
   // Acc to 38.508-1 Table 4.6.3-15: BWP-UplinkDedicated
   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
   cs_BWP_UplinkDedicated_Def(cs_PUCCH_ConfigSetup(p_PUCCH_Config), cs_PUSCH_ConfigSetup(p_PUSCH_Config), p_SRS_Config, p_LBT_FailureRecoveryConfig_r16);

  template (value) BWP_UplinkDedicated.srs_Config cs_NR_Srs_Config_Setup(template (value) SRS_Config p_SRS_Config) :=  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  {
    setup := p_SRS_Config
  };

  template (value) BWP_UplinkDedicated.lbt_FailureRecoveryConfig_r16 cs_38508_LBT_FailureRecoveryConfigSetup :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Acc to 38.508-1 Table 4.6.3-64A: LBT-FailureRecoveryConfig
    setup := {
      lbt_FailureInstanceMaxCount_r16 := n4,
      lbt_FailureDetectionTimer_r16 := ms80
    }
  };

  template (value) PUCCH_Config.ul_AccessConfigListDCI_1_1_r16 cs_38508_Ul_AccessConfigListDCI_1_1 :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Acc to ul_AccessConfigListDCI_1_1_r16 in 38.508-1 Table 4.6.3-112
    setup := {7}
  };

  template (value) PUSCH_Config.ul_AccessConfigListDCI_0_1_r16 cs_38508_Ul_AccessConfigListDCI_0_1 :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Acc to ul-AccessConfigListDCI-0-1-r16  in 38.508-1 Table 4.6.3-118
    setup := {28}
  };

  template (value) NR_SearchSpace_SearchSpaceType_Type cs_NR_SearchSpace_SearchSpaceType_CSS :=
  { // Acc to 38.508-1 Table 4.6.3-162: SearchSpace
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    common := {
      dci_Format0_0_AndFormat1_0 := {},   /* format 1_0 has no further parameters */
      dci_Format2_0 := omit,
      dci_Format2_1 := omit,
      dci_Format2_2 := omit,
      dci_Format2_3 := omit
    }
  };

  template (value) NR_SearchSpace_SearchSpaceType_Type cs_NR_SearchSpace_SearchSpaceType_USS(NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats p_DciFormats) :=
  { // Acc to 38.508-1 Table 4.6.3-162: SearchSpace
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ue_Specific := {
      dci_Formats := p_DciFormats,
      dci_Formats_MT_r16  := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      dci_FormatsSL_r16   := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      dci_FormatsExt_r16  := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      dci_FormatsNCR_r18  := omit,       /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      dci_FormatsSL_PRS_r18 := omit      /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    }
  };

  template (value) SearchSpace.monitoringSlotPeriodicityAndOffset cs_MonitoringSlotPeriodicityAndOffset_CSS_USS :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    sl1 := NULL                                               /* => PDCCH assignment in every slot */
  };

  template (value) SearchSpace.monitoringSlotPeriodicityAndOffset cs_MonitoringSlotPeriodicityAndOffset_CSS_USS_HDUE :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // Acc to 38.58-1 Table 4.6.3-162: SearchSpace with condition CSS OR USS) AND HD_FDD
    sl5 := 0
  };

  template (value) SearchSpace.monitoringSlotPeriodicityAndOffset cs_MonitoringSlotPeriodicityAndOffset_SISS :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    sl10 := 5
  };

  template (value) SearchSpace cs_38508_SearchSpace(SearchSpaceId p_SearchSpaceId,
                                                    template (omit) ControlResourceSetId p_ControlResourceSetId,
                                                    template (omit) NR_SearchSpace_SearchSpaceType_Type p_SearchSpaceType,
                                                    template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                    template (value) SearchSpace.monitoringSlotPeriodicityAndOffset p_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS,
                                                    template (omit)  SearchSpace.duration p_Duration := omit) :=
  { // Acc to 38.508-1 Table 4.6.3-162: SearchSpace
    // @sic R5-191187: added p_SlotPeriodicityAndOffset and  p_Duration sic@
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    searchSpaceId := p_SearchSpaceId,
    controlResourceSetId := p_ControlResourceSetId,
    monitoringSlotPeriodicityAndOffset := p_SlotPeriodicityAndOffset,
    duration := p_Duration,
    monitoringSymbolsWithinSlot := '10000000000000'B,           /* => PDCCH assignments at the beginning of each slot */
    nrofCandidates := p_NrofCandidates,
    searchSpaceType := p_SearchSpaceType
  };

  template (value) NR_SearchSpace_NrofCandidates_Type cs_38508_NrofCandidates_Def :=
  {
    //As per 38.508-1 Table 4.6.3-162: SearchSpace @sic R5-190782 sic@
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    aggregationLevel1 := n0,
    aggregationLevel2 := n4,                    //@sic R5-192364, R5-194087 sic@
    aggregationLevel4 := n2,
    aggregationLevel8 := n1,
    aggregationLevel16 := n0
  };

  template (value) NR_SearchSpace_NrofCandidates_Type cs_38508_NrofCandidates_CBW3 :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //As per 38.508-1 Table 4.6.3-162: SearchSpace with condition FR1 and BW3
    //@sic R5-250401 sic@
    aggregationLevel1 := n0,
    aggregationLevel2 := n2,
    aggregationLevel4 := n1,
    aggregationLevel8 := n0,
    aggregationLevel16 := n0
  };

  template (value) NR_SearchSpace_NrofCandidates_Type cds_38508_NrofCandidates_FR2
  modifies cs_38508_NrofCandidates_Def :=
   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  { //As per 38.508-1 Table 4.6.3-162: SearchSpace with condition FR2  @sic R5s200898 RP-201138 sic@
    aggregationLevel2 := n3
  };

  template (value) ControlResourceSet.cce_REG_MappingType cs_NR_ControlResourceSet_NonInterleavedMapping :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    nonInterleaved := NULL
  };

  template (value) ControlResourceSet.cce_REG_MappingType cs_NR_ControlResourceSet_InterleavedMapping(integer p_ShiftIndex) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    interleaved := {
      reg_BundleSize := n6,        /* L = 6 according to 38.211 clause 7.3.2.2 */
      interleaverSize := n2,       /* R = 6 according to 38.211 clause 7.3.2.2 */
      shiftIndex := p_ShiftIndex
    }
  };

  template (value) ControlResourceSet cs_38508_ControlResourceSet(ControlResourceSetId p_ControlResourceSetId := tsc_NR_ControlResourceSetId,
                                                                  template (value) ControlResourceSet.cce_REG_MappingType p_MappingType := cs_NR_ControlResourceSet_NonInterleavedMapping,
                                                                  B45_Type p_FrequencyDomainResources,
                                                                  integer p_Duration := tsc_Coreset_Duration
                                                                  ) :=
  { //As per 38.508-1 Table 4.6.3-28: ControlResourceSet
    /* @sic R5-190786: p_MappingType to cope with interleaved mapping needed for CORESET#0 R5-200678: added p_FrequencyDomainResources R5-250401: deleted default to p_FrequencyDomainResources sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    controlResourceSetId      := p_ControlResourceSetId,  //As per 38.508-1 Table 4.6.3-18: ControlResourceSetId
    frequencyDomainResources  := p_FrequencyDomainResources,
    duration                  := p_Duration,
    cce_REG_MappingType       := p_MappingType,
    precoderGranularity       := sameAsREG_bundle,
    tci_StatesPDCCH_ToAddList := omit,
    tci_StatesPDCCH_ToReleaseList := omit,
    tci_PresentInDCI          := omit,
    pdcch_DMRS_ScramblingID   := omit,
    rb_Offset_r16             := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    tci_PresentDCI_1_2_r16    := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    coresetPoolIndex_r16      := omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    controlResourceSetId_v1610:= omit,       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    followUnifiedTCI_State_r17 := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 R5s230533 BASELINE UPGRADE 2023  sic@ */
    applyIndicatedTCI_State_r18:= omit       /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  /*
   * @desc      return the DCI applicable for the TC
   * @return    NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetUSS_DCI_Format() return NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats
  { //@sic R5s190895 sic@
    if (f_GetTestcaseAttrib_ShortDCI(testcasename())) {
        return formats0_0_And_1_0;
    } else {
        return formats0_1_And_1_1;  //Default value
    }
  }

}
