      v_Acknowledgement := cs_Acknowledgement (false, v_LppMessage.sequenceNumber)
    }
    // Get default assistance data
    v_DlAoDProvideAssistanceData := cs_DlAoDProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(1),
                                                                  {cs_NrSelectedDlPrsPerFreq(0)},
                                                                  omit);
    //Now remove elements not requested by the UE
    if (v_LppMessage.lpp_MessageBody.c1.requestAssistanceData.criticalExtensions.c1.requestAssistanceData_r9.nr_DL_AoD_RequestAssistanceData_r16.nr_AdType_r16[0] == '0'B){ //nr-DL-PRS-AssistanceData not requested
      v_DlAoDProvideAssistanceData.nr_DL_PRS_AssistanceData_r16 := omit;
    }

    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                          targetDevice,
                                                                          omit,
                                                                          omit,
                                                                          v_Acknowledgement,
                                                                          -,-,-,-,
                                                                          v_DlAoDProvideAssistanceData));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 5" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideLocationInformation_DlAoD(tsc_POS_TransactionNumber));

    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.3 Step 5");

    //@siclog "Step 5a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 5
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_4_DlAoD_NR5GC_TestBody

  /*
