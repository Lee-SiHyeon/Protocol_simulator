  template (present) AcceptContact cr_AcceptContact(template (present) GenericParam p_GenericParam := cr_GenericParam_Any) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
