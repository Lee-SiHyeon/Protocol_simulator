module UpperTesterFunctions {

  import from CommonDefs all;
  import from IMS_CommonParameters all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UpperTesterCommon all;
  import from UpperTesterPtcToMtcDefs all;

  type enumerated ECall_Type {TEST, RECONFIGURATION, MANUAL, AUTOMATIC}; /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_PRO, NR5GC, NR5GC_IRAT) */

  type enumerated SatellitePrediction {DISABLE, ENABLE};      /* @status    APPROVED (NBIOT, NR5GC, NR5GC_IRAT, POS) */

  type enumerated UT_PDU_Request_Type {Normal, Emergency, MA}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_ManualPLMN_None := -1;                      /* @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT) */

  const integer tsc_ManualPLMN_EUTRA := 7;                      /* @status    APPROVED (NR5GC_IRAT) */

  template (value) UT_COMMON_CMD cas_UT_Req(template (value) Ut_Common_Req_Type p_Cmd,
                                            template (value) Ut_CnfReq_Type p_Cnf,
                                            template (omit)  Ut_ParameterList_Type p_Parameters := omit) :=
  {   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    Cmd := p_Cmd,
    CnfReq := p_Cnf,
    ParameterList := p_Parameters
  };

  template (value) Ut_Parameter_Type cs_Ut_Parameter_Cid(charstring p_Value) :=
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("Cid", p_Value);

  template (value) Ut_Parameter_Type cs_Ut_Parameter_PLMN(charstring p_Value) :=
    /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    cs_Ut_Parameter_Common("PLMN", p_Value);

  template (value) Ut_ParameterList_Type cs_CheckPlmn(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC_IRAT) */
    cs_Ut_Parameter_PLMN(p_Value)
  };

  template (value) Ut_ParameterList_Type cs_ManualPlmn(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT) */
    /* @sic R5-106675 sic@ */
    cs_Ut_Parameter_PLMN(p_Value)
  };

  template (value) Ut_ParameterList_Type cs_SNPN_Info(charstring p_PLMN,
                                                      charstring p_Nid) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    cs_Ut_Parameter_PLMN(p_PLMN),
    cs_Ut_Parameter_Common("N_ID", p_Nid)
  };

  template (value) Ut_ParameterList_Type cs_SNPN_InfoWithAccessId(charstring p_PLMN,
                                                      charstring p_Nid,
                                                      charstring p_AccessId) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */
    cs_Ut_Parameter_PLMN(p_PLMN),
    cs_Ut_Parameter_Common("N_ID", p_Nid),
    cs_Ut_Parameter_Common("ACCESS_ID", p_AccessId)
  };

  template (value) Ut_ParameterList_Type cs_InsertUsim(template (value) charstring p_Value) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, UTRAN) */
    cs_Ut_Parameter_Common("USIM", p_Value)
  };

  template (value) Ut_ParameterList_Type cs_PDP_Cid(charstring p_Cid) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Cid(p_Cid)
  };

  template (value) Ut_ParameterList_Type cs_RequestPDP(charstring p_PDPParams) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("RequestPDP", p_PDPParams)
  };

  template (value) Ut_ParameterList_Type cs_CallIdNumber(charstring p_CallId) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT, SSNITZ) */
    cs_Ut_Parameter_Common("Call Id", p_CallId)
  };

  template (value) Ut_Parameter_Type cs_Ut_Parameter_Uri(charstring p_Value)          := cs_Ut_Parameter_Common("Uri", p_Value);              /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  /*
   * @desc      local function to send command and get confirmation
   * @param     p_Port
   * @param     p_Cmd
   * @param     p_DontWaitForCnf    (default value: false)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_UT_ApplyCommand(UT_PTC_MTC_PORT p_Port,
                              template (value) UT_COMMON_CMD p_Cmd,
                              boolean p_DontWaitForCnf := false) // @sic R5-140347 sic@
  {
    p_Port.send(p_Cmd);
    if (f_UT_CommandRequiresCnf(p_Cmd.CnfReq) and not p_DontWaitForCnf) { // @sic R5s110275 sic@
      p_Port.receive(car_UT_COMMON_CNF);
    }
  }

  /*
   * @desc      To send the command to the MTC, wait for a response and return the result string
   * @param     p_Port
   * @param     p_Cmd
   * @return    UT_COMMON_CNF
   * @status    APPROVED (IMS, LTE, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_UT_ApplyCommandRetCnf(UT_PTC_MTC_PORT p_Port,
                                    template (value) UT_COMMON_CMD p_Cmd) return UT_COMMON_CNF
  {
    p_Port.send(p_Cmd);
    return fl_UT_RetCnf (p_Port); // @sic R5-140347 sic@
  }

  /*
   * @desc      To wait for a response and return the CNF
   * @param     p_Port
   * @return    UT_COMMON_CNF
   * @status    APPROVED (IMS, LTE, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_UT_RetCnf(UT_PTC_MTC_PORT p_Port) return UT_COMMON_CNF
  {
    var UT_COMMON_CNF v_Cnf;
    
    p_Port.receive(car_UT_COMMON_CNF) -> value v_Cnf;
    return v_Cnf;
  }

  /*
   * @desc      To ask the configure the UE position as defined in 36.508
   * @param     p_Port
   * @param     p_SpecRef           (default value: "36.508 clause 4.13")
   * @param     p_Cnf               (default value: CNF_REQUIRED)
   * @status    APPROVED (NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_ConfigureNTNPosition(UT_PTC_MTC_PORT p_Port,
                                     charstring p_SpecRef := "36.508 clause 4.13",
                                     template (value) Ut_CnfReq_Type p_Cnf := CNF_REQUIRED) // @sic R5s240281 sic@
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(CONFIGURE_NTN_UE_POSITION, p_Cnf, {cs_Ut_Parameter_Common("SpecReference", p_SpecRef)}));
  }

  /*
   * @desc      Objective: To make the operator insert the USIM card
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @param     p_USIM_ID
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, UTRAN)
   */
  function f_UT_USIM_Insert(UT_PTC_MTC_PORT p_Port,
                            template (omit) charstring p_USIM_ID)
  {
    if (isvalue(p_USIM_ID)) {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(INSERT_USIM, CNF_REQUIRED, cs_InsertUsim(valueof(p_USIM_ID))));
    } else {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(INSERT_USIM, CNF_REQUIRED));
    }
  }

  /*
   * @desc      Objective: To power off the UE
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_PowerOffUE(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(POWER_OFF, CNF_REQUIRED));
  }

  /*
   * @desc      switch on the UE
   * @param     p_Port
   * @param     p_USIM_Rmvd         (default value: false)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_SwitchOnUE(UT_PTC_MTC_PORT p_Port,
                           boolean p_USIM_Rmvd := false,
                           Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var Ut_Common_Req_Type v_Request;

    if (pc_SwitchOnOff) {        // switch on the UE
      v_Request := SWITCH_ON;
    } else if (p_USIM_Rmvd and pc_USIM_Removal) {       // USIM needs to be removed @sic R5s120597r1 sic@
      v_Request := INSERT_USIM;
    } else {                            // power on the UE
      v_Request := POWER_ON;
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(v_Request, p_CnfRequired));
  }

  /*
   * @desc      switch off the UE
   * @param     p_Port
   * @param     p_USIM_Rmvd
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @param     p_DontWaitForCnf    (default value: false)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_SwitchOffUE(UT_PTC_MTC_PORT p_Port,
                            boolean p_USIM_Rmvd,
                            Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED,
                            boolean p_DontWaitForCnf := false)
  {
    if (pc_SwitchOnOff) {        // switch off the UE
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(SWITCH_OFF, p_CnfRequired), p_DontWaitForCnf);  //  @sic R5s110395, R5s220417 sic@
    } else if (p_USIM_Rmvd and pc_USIM_Removal) {  // UE doesn't support switch off, but does support SIM removal, so remove it;  @sic R5-104083 sic@ @sic R5s120597r1 sic@
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(REMOVE_USIM, CNF_REQUIRED));
    } else {                            // power off the UE - last resort
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(POWER_OFF, CNF_REQUIRED));
    }
  } // f_UT_SwitchOffUE

  /*
   * @desc      To ask the operator to dial an IMS call
   * @param     p_Port
   * @param     p_NumToDial         (default value: px_IMS_CalleeUri)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_RequestIMSCall(UT_PTC_MTC_PORT p_Port,
                               charstring p_NumToDial := px_IMS_CalleeUri, // @sic R5s220215 sic@
                               Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var boolean v_DontWaitForCnf := true;
    var charstring v_NumToDial := p_NumToDial;
    
    // @sic R5s220215 sic@
    if (regexp (p_NumToDial, "([0-9]+)", 0) != "") { // If string is a number, have to convert this into a URI @sic R5s220509 sic@
      v_NumToDial := "tel:" & v_NumToDial;
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_IMS_VOICE_CALL, p_CnfRequired, {cs_Ut_Parameter_Uri(v_NumToDial)}), v_DontWaitForCnf); // @sic R5-134290, R5-145723, R5s160855 sic@
  }

  /*
   * @desc      To ask the operator to dial an IMS call
   * @param     p_Port
   * @param     p_NumToDial         (default value: px_EmergencyCallNumber)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_RequestIMSEmergencyCall(UT_PTC_MTC_PORT p_Port,
                                        charstring p_NumToDial := px_EmergencyCallNumber,
                                        Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED) // set to LOCAL_CNF_REQUIRED if followed by e.g. a timer
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_IMS_VOICE_CALL, p_CnfRequired, {cs_Ut_Parameter_Uri(p_NumToDial)})); // @sic R5-134290, R5s230789  sic@
  }

  /*
   * @desc      Objective: To make the operator check the indicated PLMN
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @param     p_PLMN_ID
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC_IRAT)
   */
  function f_UT_PLMN_Check(UT_PTC_MTC_PORT p_Port,
                           charstring p_PLMN_ID)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(CHECK_PLMN, CNF_REQUIRED, cs_CheckPlmn(p_PLMN_ID)));
  }

  /*
   * @desc      To set manual PLMN selection and select PLMNN (i.e. both of the above in 1 function)
   * @param     p_Port
   * @param     p_PLMN_ID
   * @param     p_Cell_AccessTechnology (default value: tsc_ManualPLMN_None)
   * @param     p_Ut_CnfReq_Type    (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_ManualPLMN_Select(UT_PTC_MTC_PORT p_Port,
                                  NAS_PlmnId p_PLMN_ID,
                                  integer p_Cell_AccessTechnology := tsc_ManualPLMN_None, // @sic R5-106675 sic@ - only set this if the prose says e.g. 'select PLMN9 (UTRAN)'; options are _GERAN, _NR or _EUTRA
                                  Ut_CnfReq_Type p_Ut_CnfReq_Type := NO_CNF_REQUIRED) // @sic R5s110633 sic@
  { /* Objective: To manually select the specified PLMN
     *            TTCN waits until operation is confirmed before continuing */
    /* @sic R5-106675 sic@ */
    var charstring v_AT := """" & f_ConvertPLMNtoString(p_PLMN_ID) & """"; // @sic R5s160365 sic@

    if (p_Cell_AccessTechnology != tsc_ManualPLMN_None) {
      v_AT := v_AT & "," & int2str(p_Cell_AccessTechnology);
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PLMN_MANUAL, p_Ut_CnfReq_Type, cs_ManualPlmn(v_AT))); // @sic R5s110633 sic@
  }

  /*
   * @desc      To convert the PLMN in NAS format into that required by the AT command
   * @param     p_PLMN_ID
   * @return    charstring
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_ConvertPLMNtoString(NAS_PlmnId p_PLMN_ID) return charstring
  { /* @sic R5-106675, R5s160365 sic@ */
    var hexstring v_PLMN_Hex := oct2hex(p_PLMN_ID); // Now re-order it for the AT command
    var hexstring v_PLMN_ForAT := v_PLMN_Hex[1] & v_PLMN_Hex[0] & v_PLMN_Hex[3] & v_PLMN_Hex[5] & v_PLMN_Hex[4];
    
    if (v_PLMN_Hex[2] != 'F'H) { // @sic R5s120576 sic@
      v_PLMN_ForAT := v_PLMN_ForAT & v_PLMN_Hex[2];
    }
    return hex2str(v_PLMN_ForAT); // @sic R5s160365 sic@
  }

  /*
   * @desc      To request automatic PLMN selection before a cell has been powered up
   * @param     p_Port
   * @status    APPROVED (LTE, LTE_A_PRO, NBIOT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_AutomaticPLMN_Select_WithSwitchOnOff(UT_PTC_MTC_PORT p_Port)
  { /* Objective: To change the UE into automatic mode then switch it off again*/
     f_UT_SwitchOnUE(p_Port, false, CNF_REQUIRED);
     f_UT_AutomaticPLMN_Select (p_Port);
     f_UT_SwitchOffUE(p_Port, false, CNF_REQUIRED);
  }

  /*
   * @desc      To request automatic PLMN selection
   * @param     p_Port
   * @status    APPROVED (LTE, LTE_A_PRO, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_AutomaticPLMN_Select(UT_PTC_MTC_PORT p_Port)
  { /* Objective: To change the UE into automatic mode */
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PLMN_AUTOMATIC, LOCAL_CNF_REQUIRED)); // @sic R5-106675, R5s180214 sic@
  }

  /*
   * @desc      To ensure a list of subsriber data is provided
   * @param     p_Port
   * @param     p_PLMN_ID
   * @param     p_N_ID
   * @param     p_AccessIdentity    (default value: omit)
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_ProvideSubscriberDataList(UT_PTC_MTC_PORT p_Port,
                                          NAS_PlmnId p_PLMN_ID,
                                          integer p_N_ID,
                                          template (omit) charstring p_AccessIdentity := omit)
  { /* Objective: To change the UE into automatic mode */
    if (isvalue(p_AccessIdentity)) {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(SNPN_SUBSCRIBER_DATA, CNF_REQUIRED, cs_SNPN_InfoWithAccessId(f_ConvertPLMNtoString(p_PLMN_ID), int2str(p_N_ID), valueof(p_AccessIdentity))));  // @sic R5-227452 sic@
    } else {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(SNPN_SUBSCRIBER_DATA, CNF_REQUIRED, cs_SNPN_Info(f_ConvertPLMNtoString(p_PLMN_ID), int2str(p_N_ID))));
    }
  }

  /*
   * @desc      To build the start of the request for an additional PDN - to be associated with given bearer (p_BearerId)
   * @param     p_APN               (default value: "")
   * @param     p_EmergencyOrMABearer   (default value: Normal)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_BuildPDNRequest(charstring p_APN := "", // @sic R5s100466 sic@
                              UT_PDU_Request_Type p_EmergencyOrMABearer := Normal)  // @sic R5-120403 sic@
    return charstring
  {
    var charstring v_Cmd := "";
    var charstring v_CommasToReqType := ",,,,,";
    
    if (p_APN != "") {
      v_Cmd := """" & p_APN & """"; // @sic R5s100466, R5s100538 sic@
    }
    select (p_EmergencyOrMABearer) { // @sic R5-120403, R5-255822 sic@
      case (Emergency) {
        v_Cmd := v_Cmd & v_CommasToReqType & "1";
      }
      case (MA) {
        v_Cmd := v_Cmd & v_CommasToReqType & "5";
      }    }
    return v_Cmd;
  }

  /*
   * @desc      To request a PDU session, for a given PDU Session Id
   * @param     p_Port
   * @param     p_SessionId
   * @param     p_DNN               (default value: "")
   * @param     p_EmergencyOrMABearer   (default value: Normal)
   * @param     p_SSCMode           (default value: 1)
   * @param     p_S_NSSAI_ForATCmd  (default value: "")
   * @param     p_Access3GPP        (default value: true)
   * @param     p_RQos              (default value: omit)
   * @param     p_MH6               (default value: omit)
   * @param     p_AlwaysOn          (default value: omit)
   * @param     p_NSLPI             (default value: -1)
   * @param     p_SpecialType       (default value: "")
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_RequestPDUSession(UT_PTC_MTC_PORT p_Port,
                        integer p_SessionId,
                        charstring p_DNN := "", // @sic R5s100466 sic@
                        UT_PDU_Request_Type p_EmergencyOrMABearer := Normal,  // @sic R5-120403 sic@
                        integer p_SSCMode := 1,
                        charstring p_S_NSSAI_ForATCmd := "",
                        boolean p_Access3GPP := true,
                        template (omit) boolean p_RQos := omit,
                        template (omit) boolean p_MH6 := omit,
                        template (omit) boolean p_AlwaysOn := omit,
                        integer p_NSLPI := -1,
                        charstring p_SpecialType := "",  // @sic R5s240004 sic@ - specify if different to IP type
                        Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED) // set to LOCAL_CNF_REQUIRED if followed by e.g. a timer
  {
    var charstring v_Cmd := fl_BuildPDNRequest(p_DNN, p_EmergencyOrMABearer);
    var charstring v_CommasToReqType := ",,,,,";
    var charstring v_CommasToNSLPI := ",,,";
    var charstring v_CommasToSSC := ",,,,,,";
    
    if (p_EmergencyOrMABearer == Normal) { // add commas to Request Type
      v_Cmd := v_Cmd & v_CommasToReqType;
    }
    // Then add commas to NSLPI
    v_Cmd := v_Cmd & v_CommasToNSLPI;
    if (p_NSLPI >= 0) {
      v_Cmd := v_Cmd & int2str(p_NSLPI);
    }
    // Then add commas to SSC
    v_Cmd := v_Cmd & v_CommasToSSC;
    v_Cmd := v_Cmd & int2str(p_SSCMode-1) & ",";
    v_Cmd := v_Cmd & """" & p_S_NSSAI_ForATCmd & """,";  //@sic R5s200501, R5s200963 sic@
    
    if (p_Access3GPP) {
      v_Cmd := v_Cmd & "0";
    } else {
      v_Cmd := v_Cmd & "1";
    }
    
    if (isvalue(p_RQos)) {
      if(valueof(p_RQos)) {
        v_Cmd := v_Cmd & ",1";
      } else {
        v_Cmd := v_Cmd & ",0";
      }
    }
    if (isvalue(p_MH6)) {
      if (not isvalue(p_RQos)) { // if previous field not included, need to add another comma
        v_Cmd := v_Cmd & ",";
      }
      if(valueof(p_MH6)) {
        v_Cmd := v_Cmd & ",1";
      } else {
        v_Cmd := v_Cmd & ",0";
      }
    }
    if (isvalue(p_AlwaysOn)) {
      if (not isvalue(p_RQos)) { // if previous field not included, need to add another comma
        v_Cmd := v_Cmd & ",";
      }
      if (not isvalue(p_MH6)) { // if previous field not included, need to add another comma
        v_Cmd := v_Cmd & ",";
      }
      if(valueof(p_AlwaysOn)) {
        v_Cmd := v_Cmd & ",1";
      } else {
        v_Cmd := v_Cmd & ",0";
      }
    }
    // Add comma if field is there or not
    v_Cmd := v_Cmd & ",";
    
    fl_RequestPDPContext(p_Port, p_SessionId, v_Cmd, p_SpecialType);  // @sic R5-227473 sic@
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ACTIVATE_BEARER,  p_CnfRequired, cs_PDP_Cid(int2str(p_SessionId)))); // @sic R5s230789 sic@
  }

  /*
   * @desc      Used by LTE, UTRAN and GERAN to send the DCONT AT command
   * @param     p_Port
   * @param     p_BearerId
   * @param     p_RestOfCmd
   * @param     p_SpecialType       (default value: "")
   *             .. - specify if different to IP type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_RequestPDPContext(UT_PTC_MTC_PORT p_Port,
                                integer p_BearerId,
                                charstring p_RestOfCmd,
                                charstring p_SpecialType := "")
  { // @sic R5s100466 change 5 sic@
    var charstring v_Cmd := "";
    var charstring v_Type := """IP""";
    
    if (p_SpecialType != "") {  // @sic R5-227473 sic@
      v_Type := p_SpecialType;
    } else {
      if (pc_IPv6 and (not pc_IPv4)) {
        v_Type := """IPV6""";
      }
      if (pc_IPv6 and pc_IPv4) {
        v_Type := """IPV4V6""";
      }
    }
    v_Cmd := v_Cmd & int2str(p_BearerId);
    v_Cmd := v_Cmd & "," & v_Type;
    
    if (p_RestOfCmd != "") { // @sic R5s120002 sic@
      v_Cmd := v_Cmd & "," & p_RestOfCmd; // @sic R5s100520 sic@
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_PDPCONTEXT, CNF_REQUIRED, cs_RequestPDP(v_Cmd))); // @sic R5s110570 sic@
  }

  /*
   * @desc      To detach
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_InitiateDetach(UT_PTC_MTC_PORT p_Port)  // @sic R5-113807 sic@
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(DETACH, NO_CNF_REQUIRED));
  }

  /*
   * @desc      To answer a call
   * @param     p_Port
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT, SSNITZ)
   */
  function f_UT_AnswerCall(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ANSWER_CALL, NO_CNF_REQUIRED));
  }

  /*
   * @desc      To hang up an IMS call
   * @param     p_Port
   * @param     p_CallId            (default value: 1)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_UT_HangupIMSCall(UT_PTC_MTC_PORT p_Port,
                              integer p_CallId := 1,
                              Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(RELEASE_IMS_CALL, p_CnfRequired, cs_CallIdNumber(int2str (p_CallId)))); // @sic R5s210628 sic@
  }

  /*
   * @desc      To request the operator to provide location information to the UE
   * @param     p_Port
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11, NR5GC, NR5GC_IRAT)
   */
  function f_UT_MMI_ProvideLocationInfoToUE(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(LOCATION_INFO, CNF_REQUIRED));
  }

  /*
   * @desc      Send AT to initiate an eCall
   * @param     p_Port
   * @param     p_CallType
   * @param     p_MinSetOfData      (default value: omit)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_PRO, NR5GC, NR5GC_IRAT)
   */
  function f_UT_InitiateECall(UT_PTC_MTC_PORT p_Port,
                              ECall_Type p_CallType,
                              template (omit) bitstring p_MinSetOfData := omit,
                              Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var charstring v_Cmd := int2str(enum2int(p_CallType));
    var bitstring v_MSD;
    
    if (isvalue(p_MinSetOfData)) {
      v_MSD := valueof(p_MinSetOfData);
      v_Cmd := v_Cmd & "1," & int2str(lengthof(v_MSD)) & "," & bit2str(v_MSD);
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ECALL, p_CnfRequired, {cs_Ut_Parameter_Common ("ECall", v_Cmd)}));  // @sic R5s230789 sic@
  }

  type enumerated READ_NSSAI_PARAM_Type {DefaultConfigured_Only, Default_Rejected, Default_Rejected_Configured, Default_Rejected_Configured_Allowed};  /* @status    APPROVED (NR5GC, NR5GC_IRAT) */

   /*
   * @desc      To read NSSAI dynamic parameters
   * @param     p_Port
   * @param     p_TypeToRead
   * @param     p_PLMN_ID           (default value: omit)
   * @return    charstring
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_UT_ReadNSSAI_DynamicParams(UT_PTC_MTC_PORT p_Port,
                                      READ_NSSAI_PARAM_Type p_TypeToRead,
                                      template (omit) charstring p_PLMN_ID := omit) return charstring
  {
    var UT_COMMON_CNF v_Cnf;
    var charstring v_ReadType := int2str(enum2int(p_TypeToRead));
    if (isvalue(p_PLMN_ID)) {
      v_ReadType := v_ReadType & ",""" & valueof(p_PLMN_ID) & """"; // @sic R5s200903 sic@
    }
    
    v_Cnf := fl_UT_ApplyCommandRetCnf(p_Port, cas_UT_Req(READ_NSSAI_PARAMS, CNF_REQUIRED, {cs_Ut_Parameter_Common ("NSSAIType", v_ReadType)}));
    
    return v_Cnf.ResultString; // @sic R5s200573 sic@
  }

   /*
   * @desc      To read NSSAI dynamic parameters and return the Extended Rejected NSSAI
   * @param     p_Port
   * @param     p_PLMN_ID           (default value: omit)
   * @param     p_Access3GPP        (default value: true)
   * @return    charstring
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_UT_ReadXtdRejectedNSSAI(UT_PTC_MTC_PORT p_Port,
                                 template (omit) charstring p_PLMN_ID := omit,
                                 boolean p_Access3GPP := true) return charstring
  {
    var charstring v_ResultString := f_UT_ReadNSSAI_DynamicParams(p_Port, Default_Rejected, p_PLMN_ID);
    var CharStringList_Type v_ListOfLines := f_StringSplitLines(v_ResultString, "<CR><LF>");  // a list charstrings separated by CR LF @sic R5s210431 sic@
    var charstring v_Params := regexp(v_ListOfLines[0], "\+C5GNSSAIRDP: (*)", 0); // @sic R5s210431 sic@
    var CharStringList_Type v_CharStringList := f_StringSplit(v_Params, {","});  // a list of 2, 4, 6, 8 or 10 elements: each = length & value string
    var charstring v_Rejected := "";
    var integer i;
    
    if (p_Access3GPP) {
      i := 7;
    } else {
      i := 9;
    }
    
    if (isvalue(v_CharStringList[i])) { // @sic R5s210134 sic@
      v_Rejected := regexp(v_CharStringList[i], """(*)""", 0); // @sic R5s210362 sic@
    }
    return v_Rejected;
  }

  /*
   * @desc      To ask the operator to ensure preconditions are NOT configured
   * @param     p_Port
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_UT_PreconditionsNotConfigured(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PRECONDITIONS, CNF_REQUIRED, omit));
  }

  /*
   * @desc      To configure UUAA parameters, used for UAS
   * @param     p_Port
   * @param     p_UAV_Id
   * @param     p_USS_IPaddr
   * @param     p_AuthorizationPayload
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_UAS_UUAA_Params(UT_PTC_MTC_PORT p_Port,
                                   octetstring p_UAV_Id,
                                   octetstring p_USS_IPaddr,
                                   octetstring p_AuthorizationPayload)
  {
    var charstring v_Cmd := "0," & oct2str(p_UAV_Id) & "," & oct2str(p_USS_IPaddr) & "," & oct2str(p_AuthorizationPayload);
    
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(UAS_UUAA, CNF_REQUIRED, {cs_Ut_Parameter_Common("UUAA", v_Cmd)}));
  };

  /*
   * @desc      To configure SATELLITE_TRAJECTORY_PREDICTION for NGSO
   * @param     p_Port
   * @param     p_Enable            (default value: DISABLE)
   * @status    APPROVED (NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_DisableNGSO_SatellitePrediction(UT_PTC_MTC_PORT p_Port,
                                   SatellitePrediction p_Enable := DISABLE)  // @sic R5-253187 sic@
  {
    var charstring v_String := "DISABLE";
    
    if (p_Enable == ENABLE) {
      v_String := "ENABLE";
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(SATELLITE_TRAJECTORY_PREDICTION, CNF_REQUIRED, {cs_Ut_Parameter_Common("Prediction", v_String)})); // @sic R5-253187 sic@
  };

}
