    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_PS_64k_Only,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_To119_Rx),
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k_Only_r13,
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_Info_FDD_r11 (tsc_UL_DPDCH_SF_64k_PS, pl0_76, p_UL_ScramblingCode),
    dl_CommonInformation := cs_DL_CommonInformationRB_SetUp_FDD_r12 (tsc_DL_DPCH1_SFP_64k_PS_r12, flexible),
    dl_InformationPerRL_List := cs_DL_InformationPerRL_FDD_r13 (p_PrimScramblingCode, tsc_DL_DPCH1_ChC_64k_PS, tsc_DL_DPCH1_2ndScrC)
  };

  template (value) RadioBearerSetup_r13_IEs cds_RadioBearerSetup_r13_IEs_PSandConvSpeech_PSexists_TDD(ActivationTime p_Activetime,
                                                                                                      bitstring p_RAB_Id,
                                                                                                      CellParametersID p_CellParametersID)
    modifies cs_RadioBearerSetup_r13_IEs_Omit :=
  { /* @status    APPROVED (IMS_IRAT, LTE_IRAT) */
    activationTime              := p_Activetime,
    rrc_StateIndicator          := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupDCH_PS_64k_DCH4_r11 (p_RAB_Id, cs_RLC_InfoAM_Def_r11)
    },
    ul_CommonTransChInfo        := cs_UL_CommTrChInfo_TM3_AM1_0To119_TDD_r12,
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_PS_64k_Only,
    dl_CommonTransChInfo        := cs_DL_CommonTransChInfoDCH_TDD(cs_TFCS_Cmpl0_To119_Rx),
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k_Only_r13,
    maxAllowedUL_TX_Power       := tsc_MaxAllowPwr,
    ul_DPCH_Info                := cs_UL_DPCH_PS_and_ConvSpeech_TDD_r11,
    dl_CommonInformation        := cs_DL_CommonInfo_r12_TDD,
    dl_InformationPerRL_List    := cs_DL_InformationPerRL_TDD_r13 (p_CellParametersID, cs_DL_DPCH_InfoPerRL_64k_PS_TDD_r12)
  };

  template (value) DL_DCCH_Message cs_108_RB_SetUpPSandConvSpeech_PSexists_FDD_r13(IntegrityCheckInfo p_Integrityinfo,
                                                                                   ActivationTime p_Activetime,
                                                                                   bitstring p_RAB_Id,
                                                                                   PrimaryScramblingCode p_PrimScramblingCode,
                                                                                   UL_ScramblingCode p_UL_ScramblingCode) :=
  /* @status    APPROVED (IMS_IRAT, LTE_IRAT) */
    cs_RadioBearerSetup_r13(p_Integrityinfo, cds_RadioBearerSetup_r13_IEs_PSandConvSpeech_PSexists_FDD(p_Activetime, p_RAB_Id, p_PrimScramblingCode, p_UL_ScramblingCode));

  template (value) DL_DCCH_Message cs_108_RB_SetUpPSandConvSpeech_PSexists_TDD_r13(IntegrityCheckInfo    p_Integrityinfo,
                                                                                   ActivationTime        p_Activetime,
                                                                                   bitstring             p_RAB_Id,
                                                                                   CellParametersID      p_CellParametersID) :=
  /* @status    APPROVED (IMS_IRAT, LTE_IRAT) */
    cs_RadioBearerSetup_r13(p_Integrityinfo, cds_RadioBearerSetup_r13_IEs_PSandConvSpeech_PSexists_TDD(p_Activetime, p_RAB_Id, p_CellParametersID));

  /*
   * @desc      Function that determines the number of HARQ processes according to 34.108 cl. 6.10.2.4.5 Parameter Set - Rel-13
   * @return    HarqNrOfProcesses_r13_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN)
   */
  function f_GetNrOfHarqProcesses_FDD_r13() return HarqNrOfProcesses_r13_Type
  {
    var HarqNrOfProcesses_r13_Type v_NumberOfProcesses;
    
    select (pc_HSDSCH_UE_Category_FDD) {
      case (1, 2) {
        v_NumberOfProcesses := n2;
      }
      case (3, 4, 11) {
        v_NumberOfProcesses := n3;
      }
      case else {
        v_NumberOfProcesses := n6;
      }
    }
    return v_NumberOfProcesses;
  };

  /*
   * @desc      Function that determines the number of HARQ processes according to 34.108 cl. 6.11.5.4.6 Parameter Set - Rel-13
   * @return    HarqNrOfProcesses_r13_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN)
   */
  function f_GetNrOfHarqProcesses_TDD_r13() return HarqNrOfProcesses_r13_Type
  {
    var HarqNrOfProcesses_r13_Type v_NumberOfProcesses;
    
    select (pc_HSDSCH_UE_Category_TDD) {
      case (2, 5, 8, 11, 14) {
        v_NumberOfProcesses := n6;
      }
      case (3, 6, 9, 12, 15) {
        v_NumberOfProcesses := n8;
      }
      case else {
        v_NumberOfProcesses := n4;
      }
    }
    return v_NumberOfProcesses;
  };

}
