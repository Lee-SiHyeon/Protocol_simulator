module UTRAN34_NISPC_Templates {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from UTRAN34_RAB_Templates all;
  import from UTRAN34_RAB_Templates_r10 all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_ASN1_ASP_RAB_Templates all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_Templates all;
  import from UTRAN_TypeDefs all;

  const   B3_Type     tsc_TFT_OperationAdd := '011'B;     /* @status    APPROVED (UTRAN)    Add packet filters to existing TFT */

  const   B3_Type     tsc_TFT_OperationRemove := '101'B;  /* @status    APPROVED (UTRAN)    Remove packet filters from existing TFT */

  const   float       tsc_T3380max := 33.0;    /* @status    APPROVED (UTRAN) */

  const   float       tsc_T3386max := 8.8;     /* +10% tolerance  @status    APPROVED (UTRAN) */

  const   float       tsc_T3395max := 8.8;     /* +10% tolerance  @status    APPROVED (UTRAN) */

  const   UE_TestLoopMode     tsc_UE_TestLoopMode4 := '03'O;   /* @status    APPROVED (UTRAN) */

  template (value) LLC_SAPI cs_LLC_SAPI_UMTS_GSM := cs_LLC_SAPI(-, '0011'B);  /* @status    APPROVED (UTRAN) */

  template (present) DetachType cr_DetachTypeReAttNotRequiredGPRS := cr_DetachType('0'B,'001'B);  /* Normal detach, re-attach is not required
                                                                                                     @status    APPROVED (UTRAN) */

  template (present) LinkedTI_lv cr_LinkedTI(TI p_TI) :=
  { /* @status    APPROVED (UTRAN) */
    iel         := '01'O,
    tIFlag      := p_TI.tiFlag,
    tIValue     := p_TI.tiVal,
    spare       := '0000'B,
    ext         := omit,
    tIValuel    := omit
  };

  template (value) RRCDataReqType cs_U_SecPDPCOntextActReq(template (value) REQUESTSECONDARYPDPCONTEXTACTIVATIONdl p_SecPDPContReq):=
  { /* @status    APPROVED (UTRAN) */
    requestSecondaryPDPContextActivationdl := p_SecPDPContReq
  };

  template (value) RRCDataReqType cs_U_SecPDPCOntextActAcpt(template (value) ACTIVATESECONDARYPDPCONTEXTACCEPTdl p_ActSecPDPContAcc):=
  { /* @status    APPROVED (UTRAN) */
    activateSecondaryPDPContextAcceptdl := p_ActSecPDPContAcc
  };

  template (value) RRCDataReqType cs_U_ModPDPContReq(template (value) MODIFYPDPCONTEXTREQUEST_dl p_ModPDPContReq):=
  { /* @status    APPROVED (UTRAN) */
    modifyPDPContextRequest := p_ModPDPContReq
  };

  template (present) RRCDataIndType cr_U_ActSecPDPContReq(template (present) ACTIVATESECONDARYPDPCONTEXTREQUESTul p_ActSecPDPContReq):=
  { /* @status    APPROVED (UTRAN) */
    activateSecondaryPDPContextRequestul := p_ActSecPDPContReq
  };

  template (present) RRCDataIndType cr_U_ModPDPContAcpt (template (present) MODIFYPDPCONTEXTACCEPT_ul p_ModPDPContAcpt) :=
  { /* @status    APPROVED (UTRAN) */
    modifyPDPContextAccept := p_ModPDPContAcpt
  };

  template (present) RRCDataIndType cr_U_SM_Status (template (present) SMSTATUS p_SM_Status):=
  { /* @status    APPROVED (UTRAN) */
    smStatus := p_SM_Status
  };

  template (value) REQUESTSECONDARYPDPCONTEXTACTIVATIONdl cs_ReqSecPDP_ContextActivation_MT(TI p_TI,
                                                                                            template (value) QualityOfService   p_QoS,
                                                                                            template (value) LinkedTI_lv        p_LinkedTI,
                                                                                            template (value) TrafficFlowTemplate p_TFT):=
  { /* @status    APPROVED (UTRAN) */
    ti                          := p_TI,
    sM_ProtocolDiscriminator    := tsc_SMPD,
    msgType                     := '01011011'B, //@sic R5s140387 sic@
    requiredQoS                 := p_QoS,
    linkedTI                    := p_LinkedTI,
    tft                         := p_TFT,
    protocolConfOpts            := omit,
    wlanOffloadInd              := omit,  // @sic R5s150329 Baseline Moving sic@
    nbifomContainer             := omit, // @sic R5s160712 Baseline Moving sic@
    extdProtocolConfigOptions   := omit,  // @sic R5s170598 Baseline Moving sic@
    extd_EPS_QOS                := omit // @sic  R5s180552 Baseline Moving 2018 Phase 2 sic@
  };

  template (value) MODIFYPDPCONTEXTREQUEST_dl cs_ModifyPDP_ContextReq(template (value) TI                  p_TI,
                                                                      template (value) LLC_SAPI            p_LLC_SAPI,
                                                                      template (value) QualityOfService    p_QualityOfService,
                                                                      template (omit)  TrafficFlowTemplate p_TFT) :=
  { /* @descr Modify PDP Context for an UE supporting UMTS only n->ze; TS 24.008, cl 9.5.9 */
    /* @status    APPROVED (UTRAN) */
    ti  := p_TI,
    sM_ProtocolDiscriminator := tsc_SMPD,
    msgType := '01001000'B,
    spare := '0000'B,
    radioPriority := cs_RadioPriorityHigh (omit), //@sic R5s140387 sic@
    requestedLLC_SAPI := p_LLC_SAPI,
    newQoS := p_QualityOfService,
    pDP_Addr := omit,
    pKT_FlowIdentifier := omit,
    protocolConfOpts := cs_ProtocolConfigOptions_OneOption(cs_ProtocolContainer('0005'O, '02'O)), //@sic R5s150279 sic@
    tft := p_TFT,
    wlanOffloadInd              := omit,  // @sic R5s150329 Baseline Moving sic@
    nbifomContainer             := omit, // @sic R5s160712 Baseline Moving sic@
    extdProtocolConfigOptions   := omit,  // @sic R5s170598 Baseline Moving sic@
    extd_EPS_QOS                := omit   // @sic  R5s180552 Baseline Moving 2018 Phase 2 sic@
  };

  template (present) MODIFYPDPCONTEXTACCEPT_ul cr_ModifyPDP_ContextAcpt(template (present) TI p_TI) :=
  { /* @descr Modify PDP Context Accept, ue->n, TS 24.008, cl. 9.5.11 */
    /* @status    APPROVED (UTRAN) */
    ti := p_TI,
    sM_ProtocolDiscriminator := tsc_SMPD,
    msgType := '01001001'B,
    protocolConfOpts := cr_ProtocolConfigOptionsAny ifpresent,
    nbifomContainer  := cr_NBIFOMContainerAny ifpresent, // @sic R5s160712 Baseline Moving sic@
    extdProtocolConfigOptions   := cr_ExtdPCOAny ifpresent  // @sic R5s170598 Baseline Moving, R5w170303 sic@
  };

  template (present) ACTIVATESECONDARYPDPCONTEXTREQUESTul cr_ActSecPDP_ContextRequest(template (present) TI p_TI_R,
                                                                                      template (present) QualityOfService   p_QoS,
                                                                                      template (present) LinkedTI_lv        p_LinkedTI):=
  { /* @status    APPROVED (UTRAN) */
    ti                          := p_TI_R,
    sM_ProtocolDiscriminator    := tsc_SMPD,
    msgType                     := '01001101'B,
    requestedNSAPI              := cr_NSAPI,
    requestedLLC_SAPI           := cr_LLC_SAPI,
    requestedQoS                := p_QoS,
    linkedTI                    := p_LinkedTI,
    tft                         := cr_Tft(?, ?) ifpresent,
    protocolConfOpts            := cr_ProtocolConfigOptionsAny ifpresent,
    deviceProperties            := cr_DeviceProperties ('C'H) ifpresent,
    nbifomContainer             := cr_NBIFOMContainerAny ifpresent, // @sic R5s160712 Baseline Moving sic@
    extdProtocolConfigOptions   := cr_ExtdPCOAny ifpresent,  // @sic R5s170598 Baseline Moving, R5w170303 sic@
    extd_EPS_QOS                := cr_Extd_EPS_QOS_Any ifpresent // O TLV 12 IEI=5C @sic  R5s180552 Baseline Moving 2018 Phase 2 sic@
  };

  template (value) ACTIVATESECONDARYPDPCONTEXTACCEPTdl cs_ActSecPDP_ContextAcp_MT(TI p_TI,
                                                                                 template (value) LLC_SAPI p_LLC_SAPI,
                                                                                 template (value) B3_Type p_DlyClass,
                                                                                 template (value) B3_Type p_TrafficClass):=
  { /* descr Activate Secondary PDP Context Accept n->ue; TS24.008, cl 9.5.5
     * @status    APPROVED (UTRAN) */
    ti := p_TI,
    sM_ProtocolDiscriminator := tsc_SMPD,
    msgType := '01001110'B,
    negotiatedLLC_SAPI  := p_LLC_SAPI,
    negotiatedQoS   := cs_QoS_InteractiveOrBackgroundMT(p_DlyClass, p_TrafficClass),
    spare := '0000'B,
    radioPriority := cs_RadioPriorityHigh('0'H),
    pktFlowIdentifier := omit,
    protocolConfOpts := omit,
    wlanOffloadInd  := omit,  // @sic R5s150329 Baseline Moving sic@
    nbifomContainer := omit, // @sic R5s160712 Baseline Moving sic@
    extdProtocolConfigOptions   := omit,  // @sic R5s170598 Baseline Moving sic@
    extd_EPS_QOS    := omit // @sic  R5s180552 Baseline Moving 2018 Phase 2 sic@
  };

  template (present) SMSTATUS cr_SM_StatusMO(template (value) SM_Cause p_SM_Cause):=
  { /* @status    APPROVED (UTRAN) */
    ti := cr_TI_Any,
    sM_ProtocolDiscriminator := tsc_SMPD,
    msgType := '01010101'B,
    sM_Cause := p_SM_Cause
  };

  template (value) CphyTrchConfigReq cs_DCH_336_148_DL_Info_NISPC(template (value) SS_ActivationTime p_SS_ActTime) :=
  /* @descr For DCH1 (TS 34.108, cl 6.10.2.4.26):
   * TTI = 20 ms; 5 transport formats: TB size always=336 bits; Transport Blocks = 0,1,2,3,4; coding = turbo; CRCSize = 16; RateMatching = 130
   * For DCH5 (TS 34.108, cl 6.10.2.4.1.26):
   * TTI = 40 ms; 2 transport formats: TransportBlock = 1, TB size =148 bits; TransportBlock = 0, TB size = 148;
   * coding = convolutional; coding rate = 1/3; RateMatching = 155 */
  /* @status    APPROVED (UTRAN) */
    cs_CphyTrchConfigReq_DL_TrCh_FDD(p_SS_ActTime,
                                     cs_DCH_336_148_DL_Info_FDD,
                                     cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfoHigher64k));

  template (value) U_CPHY_CONFIG_REQ cas_108_CPHY_RL_ModifyReq_FDD(template (value) CPHY_RL_Modify_FDD_REQ p_CphyRlModifyReq_FDD):=
  { /* @status    APPROVED (UTRAN) */
    rlModify_FDD := p_CphyRlModifyReq_FDD
  };

  template (value) U_CPHY_CONFIG_REQ cas_108_CPHY_RL_ModifyReq_TDD (template (value) CPHY_RL_Modify_TDD_REQ p_CphyRlModifyReq_TDD):=
  { /* @status    APPROVED (UTRAN) */
    rlModify_TDD := p_CphyRlModifyReq_TDD
  };

  template (value) CPHY_RL_Modify_FDD_REQ cas_CPHY_RL_Modify_FDD_REQ(UTRAN_CellId_Type p_CellId,
                                                                     integer p_PhyChId,
                                                                     ActivationTime p_ActivationTime,
                                                                     template (omit) UL_DPCH_Info_r7 p_UL_DPCHinfo := omit,
                                                                     template (omit) DL_DPCHInfo_r7_FDD p_DL_DPCHinfo := omit,
                                                                     template (omit) boolean p_Follow := omit) :=
  { /* @status    APPROVED (UTRAN) */
    cellId := f_UtranCellId2Int(p_CellId),
    routingInfo := {
      physicalChannelIdentity := p_PhyChId
    },
    ratType := fdd,
    modifyMessage := {
      activationTime := {
        activationCFN := p_ActivationTime
      },
      physicalChannelInfo := {
        dPCHInfo_r5 :={
          r7 := {
            ul_DPCHInfo := p_UL_DPCHinfo,
            ul_DPCH_TimingOffset := omit,
            dl_DPCHInfo := p_DL_DPCHinfo,
            hs_DPCCHInd := omit,
            ss_UL_DPCCH_DRX_Info := omit,
            ss_DRX_Info := omit
          }
        }
      },
      trchConfigToFollow := p_Follow,
      relAspTypeExtension := omit
    }
  };

  template (value) CPHY_RL_Modify_FDD_REQ cas_108_UL_DPCH_ModifyInfo_r7_FDD(UTRAN_CellId_Type p_CellId,
                                                                            integer p_PhyChId,
                                                                            template (value) UL_DPCH_Info_r7 p_UL_DPCHinfo,
                                                                            ActivationTime p_ActivationTime) :=
  /* @status    APPROVED (UTRAN) */
    cas_CPHY_RL_Modify_FDD_REQ(p_CellId, p_PhyChId, p_ActivationTime, p_UL_DPCHinfo);

  template (value) CPHY_RL_Modify_FDD_REQ cas_108_DL_DPCH_ModifyInfo_r7_FDD(UTRAN_CellId_Type p_CellId,
                                                                            integer p_PhyChId,
                                                                            template (value) DL_DPCHInfo_r7_FDD p_DL_DPCHinfo,
                                                                            ActivationTime p_ActivationTime,
                                                                            boolean p_Follow := true) :=
  /* @status    APPROVED (UTRAN) */
    cas_CPHY_RL_Modify_FDD_REQ(p_CellId, p_PhyChId, p_ActivationTime, -, p_DL_DPCHinfo, p_Follow);

  template (value) CPHY_RL_Modify_TDD_REQ cas_CPHY_RL_Modify_TDD_REQ(UTRAN_CellId_Type p_CellId,
                                                                     integer p_PhyChId,
                                                                     ActivationTime p_ActivationTime,
                                                                     template (omit) UL_DPCH_Info_r7 p_UL_DPCHinfo := omit,
                                                                     template (omit) DL_DPCHInfo_r7_TDD p_DL_DPCHinfo := omit,
                                                                     template (omit) boolean p_Follow := omit) :=
  { /* @status    APPROVED (UTRAN) */
    cellId := f_UtranCellId2Int(p_CellId),
    secondaryFrequency := omit,
    routingInfo := {
      physicalChannelIdentity := p_PhyChId
    },
    ratType := tdd128,
    modifyMessage := {
      activationTime := {
        activationCFN := p_ActivationTime
      },
      physicalChannelInfo := {
        dPCHInfo_r5 :={
          r7 := {
            ul_DPCHInfo := p_UL_DPCHinfo,
            dl_DPCHInfo := p_DL_DPCHinfo,
            hs_DPCCHInd := omit,
            ss_UL_DPCCH_DRX_Info := omit,
            ss_DRX_Info := omit
          }
        }
      },
      trchConfigToFollow := p_Follow,
      relAspTypeExtension := omit
    }
  };

  template (value) CPHY_RL_Modify_TDD_REQ cas_108_UL_DPCH_ModifyInfo_r7_TDD(UTRAN_CellId_Type p_CellId,
                                                                        integer                             p_PhyChId,
                                                                        template (value) UL_DPCH_Info_r7    p_UL_DPCHinfo,
                                                                        ActivationTime                      p_ActivationTime) :=
  /* @status    APPROVED (UTRAN) */
    cas_CPHY_RL_Modify_TDD_REQ(p_CellId, p_PhyChId, p_ActivationTime, p_UL_DPCHinfo);

  template (value) CPHY_RL_Modify_TDD_REQ cas_108_DL_DPCH_ModifyInfo_r7_TDD(UTRAN_CellId_Type p_CellId,
                                                                            integer                             p_PhyChId,
                                                                            template (value) DL_DPCHInfo_r7_TDD p_DL_DPCHinfo,
                                                                            ActivationTime                      p_ActivationTime,
                                                                            boolean                             p_Follow := true) :=
  /* @status    APPROVED (UTRAN) */
    cas_CPHY_RL_Modify_TDD_REQ(p_CellId, p_PhyChId, p_ActivationTime, -, p_DL_DPCHinfo, p_Follow);

  template (value) RadioBearerSetup_r7_IEs cds_RB_SetUp64k_2AM_PS_IEs_FDD_r7(ActivationTime p_ActivationTime,
                                                                             bitstring p_RAB_Id,
                                                                             UL_ScramblingCode p_UL_ScramblingCode,
                                                                             PrimaryScramblingCode p_PrimScramblingCode)
    modifies cs_RadioBearerSetup_r7_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    activationTime := p_ActivationTime,
    specificationMode := {
      complete := {
        rab_InformationSetupList := {
          cs_RAB_Info_PS_Common_r7(p_RAB_Id, useT315, tsc_RB22, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_Def, cs_RB_MappingInfo_PS_r7(tsc_UL_DCH1, tsc_DL_DCH1, tsc_UL_DTCH2, tsc_UL_DTCH2, tsc_UL_DTCH2, tsc_UL_DTCH2)) //@sic R5s140558 sic@
        },
        rb_InformationAffectedList := cs_RB_InfoAffectedList_RB20_r7,
        ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
        ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListAM1_r7(cs_DCH_340_TFS_20_TC_UE),
        dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
        dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k
      }
    },
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_Info_FDDr7(tsc_UL_DPDCH_SF_64k_PS, pl0_92, p_UL_ScramblingCode),
    dl_InformationPerRL_List := cs_DL_InformationPerRL_r7_FDD(p_PrimScramblingCode, tsc_DL_DPCH1_ChC_64k_PS, tsc_DL_DPCH1_2ndScrC)
  };

  template (value) RadioBearerSetup_r7_IEs cds_RB_SetUp64k_3AM_PS_IEs_FDD_r7(ActivationTime p_ActivationTime,
                                                                             bitstring p_RAB_Id,
                                                                             UL_ScramblingCode p_UL_ScramblingCode,
                                                                             PrimaryScramblingCode p_PrimScramblingCode)
    modifies cs_RadioBearerSetup_r7_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    //@sic R5s150283 sic@
    activationTime := p_ActivationTime,
    specificationMode := {
      complete := {
        rab_InformationSetupList := {
          cs_RAB_Info_PS_Common_r7(p_RAB_Id, useT315, tsc_RB24, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_Def, cs_RB_MappingInfo_PS_r7(tsc_UL_DCH1, tsc_DL_DCH1, tsc_UL_DTCH3, tsc_UL_DTCH3, tsc_UL_DTCH3, tsc_UL_DTCH3))
        },
        rb_InformationAffectedList := cs_RB_InfoAffectedList_RB20_RB22_r7,
        ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
        ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListAM1_r7(cs_DCH_340_TFS_20_TC_UE),
        dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
        dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k
      }
    },
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_Info_FDDr7(tsc_UL_DPDCH_SF_64k_PS, pl0_92, p_UL_ScramblingCode),
    dl_CommonInformation := cs_DL_CommonInformationRB_SetUp_FDD_r7(tsc_DL_DPCH1_SFP_64k_PS),
    dl_InformationPerRL_List := cs_DL_InformationPerRL_r7_FDD(p_PrimScramblingCode, tsc_DL_DPCH1_ChC_64k_PS, tsc_DL_DPCH1_2ndScrC)
  };

  template (value) DL_DCCH_Message cs_RB_SetUp64k_2AM_PS_FDD_r7(IntegrityCheckInfo      p_IntegrityCheckInfo,
                                                                ActivationTime          p_ActivationTime,
                                                                bitstring               p_RAB_Id,
                                                                UL_ScramblingCode       p_UL_ScramblingCode,
                                                                PrimaryScramblingCode   p_PrimScramblingCode) :=
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r7(p_IntegrityCheckInfo,
                           cds_RB_SetUp64k_2AM_PS_IEs_FDD_r7(p_ActivationTime, p_RAB_Id, p_UL_ScramblingCode, p_PrimScramblingCode));

  template (value) DL_DCCH_Message cs_RB_SetUp64k_3AM_PS_FDD_r7(IntegrityCheckInfo      p_IntegrityCheckInfo,
                                                                ActivationTime          p_ActivationTime,
                                                                bitstring               p_RAB_Id,
                                                                UL_ScramblingCode       p_UL_ScramblingCode,
                                                                PrimaryScramblingCode   p_PrimScramblingCode) :=
  /* @status    APPROVED (UTRAN) */
  // @sic R5s150283 sic@
    cs_RadioBearerSetup_r7(p_IntegrityCheckInfo,
                           cds_RB_SetUp64k_3AM_PS_IEs_FDD_r7(p_ActivationTime, p_RAB_Id, p_UL_ScramblingCode, p_PrimScramblingCode));

  template (value) RadioBearerSetup_r7_IEs cds_RB_SetUp64k_2AM_PS_IEs_TDD_r7(ActivationTime p_ActivationTime,
                                                                             bitstring p_RAB_Id,
                                                                             CellParametersID p_CellParametersID)
    modifies cs_RadioBearerSetup_r7_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    activationTime := p_ActivationTime,
    specificationMode := {
      complete := {
        rab_InformationSetupList := {
          cs_RAB_Info_PS_Common_r7(p_RAB_Id, useT315, tsc_RB22, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_Def, cs_RB_MappingInfo_PS_r7(tsc_UL_DCH1, tsc_DL_DCH1, tsc_UL_DTCH2, tsc_UL_DTCH2, tsc_UL_DTCH2, tsc_UL_DTCH2)) //@sic R5s140558 sic@
        },
        rb_InformationAffectedList := cs_RB_InfoAffectedList_RB20_r7,
        ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_TDD,
        ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListAM1_r7(cs_DCH_340_TFS_20_TC_UE),
        dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_TDD(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
        dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k
      }
    },
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_64k_PS_TDD,
    dl_CommonInformation := cs_DL_CommonInfo_r7_TDD,
    dl_InformationPerRL_List := cs_DL_InformationPerRL_r7_TDD (p_CellParametersID, cs_DL_DPCH_InfoPerRL_r7_64k_PS_TDD)
  };

  template (value) RadioBearerSetup_r7_IEs cds_RB_SetUp64k_3AM_PS_IEs_TDD_r7(ActivationTime p_ActivationTime,
                                                                             bitstring p_RAB_Id,
                                                                             CellParametersID p_CellParametersID)
    modifies cs_RadioBearerSetup_r7_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    //@sic R5s150283 sic@
    activationTime := p_ActivationTime,
    specificationMode := {
      complete := {
        rab_InformationSetupList := {
          cs_RAB_Info_PS_Common_r7(p_RAB_Id, useT315, tsc_RB24, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_Def, cs_RB_MappingInfo_PS_r7(tsc_UL_DCH1, tsc_DL_DCH1, tsc_UL_DTCH3, tsc_UL_DTCH3, tsc_UL_DTCH3, tsc_UL_DTCH3)) //@sic R5s140558 sic@
        },
        rb_InformationAffectedList := cs_RB_InfoAffectedList_RB20_RB22_r7,
