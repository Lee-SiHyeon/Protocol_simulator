        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.pucch_ConfigCommon := valueof(p_Pucch_ConfigCommon);
      } else {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.pucch_ConfigCommon := omit;
      }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
   }

  /*
