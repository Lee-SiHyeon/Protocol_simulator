module NR_SecurityFunctions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_SecurityFunctions all;
  import from NAS_AuthenticationCommon all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_Parameters all;
  import from TestcaseProperties all;

  type record NR_SecurityParams_Type {          /* parameters related/used to/by NR authentication and security
                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    KDF_Type                KDF,
    B3_Type                 KSIamf,             // 3 bit KSIasme used when Authentication is performed by MME.
    B256_Type               Ks,                 // = Ck || IK
    B256_Type               KAMF,
    B256_Type               KGNB,
    B256_Type               NH,
    NextHopChainingCount    NCC,
    SK_Counter_Type         SK_Counter,
    B256_Type               S_KGNB,
    B32_Type                NonceMME,
    B32_Type                NonceUE,
    // AS Security structures
    NR_AS_IntegrityInfo_Type   AS_Integrity,
    NR_AS_CipheringInfo_Type   AS_Ciphering,
    // AS Security structures for SCG in NR-DC
    NR_AS_IntegrityInfo_Type   AS_Integrity_S,
    NR_AS_CipheringInfo_Type   AS_Ciphering_S
    
    // Note the Keys in the above AS Integrity/Ciphering are the truncated 128 bit keys
    // More fields to be added here
  };

  const O1_Type tsc_Access3GPP_Type := '01'O;           /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_AS_IntegrityInfo_Type cs_NR_AS_IntegrityInfo(IntegrityProtAlgorithm  p_Algo,
                                                                   B128_Key_Type p_RRC_Key,
                                                                   template (omit) B128_Key_Type p_UP_Key := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Algorithm         := p_Algo,      /* IntegrityProtAlgorithm_Type being defined in RRC ASN.1 */
    KRRCint           := p_RRC_Key,
    KUPint            := p_UP_Key,
    ActTimeList       := omit         /* => all SRBs shall be configured immediately */
  };

  template (value) NR_AS_CipheringInfo_Type cs_NR_AS_CipheringInfo(CipheringAlgorithm p_Algo,
                                                                   B128_Key_Type p_KeyRRC,
                                                                   B128_Key_Type p_KeyUP,
                                                                   template (value) NR_SecurityActTimeList_Type p_ActList) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Algorithm   := p_Algo,
    KRRCenc     := p_KeyRRC,
    KUPenc      := p_KeyUP,
    ActTimeList := p_ActList
  };

  template (value) NR_SecurityActTime_Type cs_NR_CipherAct_Null(NR_RadioBearerId_Type p_RBID) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RadioBearerId         := p_RBID,
    UL                    := { None := true },
    DL                    := { None := true }
  };

  template (value) NR_SecurityParams_Type cs_NR_SecurityParamsInit (IntegrityProtAlgorithm  p_RRC_IntegrityProtAlgorithm,
                                                                    CipheringAlgorithm      p_RRC_CipheringAlgorithm) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    KDF                := tsc_KDF_HMAC_SHA_256,
    KSIamf             := '111'B,        //un initialised
    Ks                 := tsc_AuthUndefinedB256,
    KAMF               := tsc_AuthUndefinedB256,
    KGNB               := tsc_AuthUndefinedB256,
    NH                 := tsc_AuthUndefinedB256,
    NCC                := 0, // Initial value
    SK_Counter         := 0, // Initial value
    S_KGNB             := tsc_AuthUndefinedB256,
    NonceMME           := tsc_AuthUndefinedB32,
    NonceUE            := tsc_AuthUndefinedB32,
    // AS Security structures
    AS_Integrity       :=  cs_NR_AS_IntegrityInfo (p_RRC_IntegrityProtAlgorithm, tsc_AuthUndefinedB128),
    AS_Ciphering       :=  cs_NR_AS_CipheringInfo(p_RRC_CipheringAlgorithm,
                                                  tsc_AuthUndefinedB128,
                                                  tsc_AuthUndefinedB128,
                                                  { cs_NR_CipherAct_Null(tsc_NR_RbId_SRB1),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB2),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB3) } ),
    // AS Security structures for SCG in NR-DC
    AS_Integrity_S       :=  cs_NR_AS_IntegrityInfo (p_RRC_IntegrityProtAlgorithm, tsc_AuthUndefinedB128),
    AS_Ciphering_S       :=  cs_NR_AS_CipheringInfo(p_RRC_CipheringAlgorithm,
                                                  tsc_AuthUndefinedB128,
                                                  tsc_AuthUndefinedB128,
                                                  { cs_NR_CipherAct_Null(tsc_NR_RbId_SRB1),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB2),
                                                      cs_NR_CipherAct_Null(tsc_NR_RbId_SRB3) } )
  };

  /*
   * @desc      to be called during initialisation of the NR PTC
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Security_Init() return NR_SecurityParams_Type
  {
    return valueof(cs_NR_SecurityParamsInit(px_NR_IntegrityProtAlgorithm, px_NR_CipheringAlgorithm));
  }

  /*
   * @desc      Function to be used for AS Key deriviation before AS SMC in NR [p_IsSMC_Procedure := true]
   *            or
   *            Re-keying of Kenb[derivation of a new KgNB from a new KAMF (i.e., after an AKA has taken place)]
   *            i.e.to be called after sending RRCConnection reconfiguration for handover or
   *            RRC Connection Re-establishment when keySetChangeIndicator received in the securityConfiguration is set to TRUE [p_IsSMC_Procedure := false]
   *            The parameter p_UL_NAS_Count shall be the NAS count of
   *            if [AUTN procedure is executed]
   *            then: The UL NAS Count of NAS SMC Complete, of the NAS SMC procedure executed after AUTN Proc.
   *            else
   *            then: The UL NAS count of the NAS UL message[which shall be security protected] received which triggered the RRC Connection establishment
   *            i.e. Registration Req[ in special cases], Service Req etc.
   * @param     p_Auth_Params
   * @param     p_UL_NAS_Count
   * @param     p_IsSMC_Procedure   (default value: true)
   * @param     p_TargetPhysicalCellIdentity (default value: omit)
   * @param     p_ARFCN_DL          (default value: omit)
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Authentication_InitAS(NR_SecurityParams_Type p_Auth_Params,
                                      O4_Type p_UL_NAS_Count,
                                      boolean p_IsSMC_Procedure := true,
                                      template (omit) PhysCellId p_TargetPhysicalCellIdentity := omit,
                                      template (omit) ARFCN_ValueNR  p_ARFCN_DL := omit)
  return NR_SecurityParams_Type
  {
    var NR_SecurityParams_Type v_Auth_Params := p_Auth_Params;
    // Derive KgNB
    v_Auth_Params.KGNB := f_NR_Authentication_A9(v_Auth_Params.KDF, v_Auth_Params.KAMF, p_UL_NAS_Count);
    
    //Derive NH corresponding to NCC =1;
    v_Auth_Params.NH := f_NR_Authentication_A10(v_Auth_Params.KDF, v_Auth_Params.KAMF, v_Auth_Params.KGNB);
    if (p_IsSMC_Procedure == false) {
      if (not (isvalue(p_TargetPhysicalCellIdentity) and isvalue(p_ARFCN_DL))) {
        FatalError(__FILE__, __LINE__, "New key is to be used at RRC Connection Re-establishment or Reconfiguration but no Physical Cell ID and/or ARFCN value is provided");
      }
      else { // Refresh of KeNB; horizontal key derivation
        v_Auth_Params.KGNB := f_NR_Authentication_A11(v_Auth_Params.KDF,
                                                      v_Auth_Params.KGNB,
                                                      v_Auth_Params.NH,
                                                      valueof(p_TargetPhysicalCellIdentity),
                                                      valueof(p_ARFCN_DL));
      }
    }
    // NCC is set to default/initial value of 0
    v_Auth_Params.NCC := 0;
    
    // Derive KRRC enc key
    v_Auth_Params.AS_Ciphering.KRRCenc := f_NG_Authentication_A8(tsc_RRC_Enc_Alg,
                                                                 f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                 v_Auth_Params.KGNB,
                                                                 v_Auth_Params.KDF);
    // Derive KRRC int key
    v_Auth_Params.AS_Integrity.KRRCint := f_NG_Authentication_A8(tsc_RRC_Int_Alg,
                                                                 fl_NR_AS_IntegrityInfo_GetIntAlg(v_Auth_Params.AS_Integrity), // @sic R5s210518 sic@
                                                                 v_Auth_Params.KGNB,
                                                                 v_Auth_Params.KDF);
    // Derive UP enc key;
    v_Auth_Params.AS_Ciphering.KUPenc := f_NG_Authentication_A8(tsc_UP_Enc_Alg,
                                                                f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                v_Auth_Params.KGNB,
                                                                v_Auth_Params.KDF);
    // Derive UP int key;
    v_Auth_Params.AS_Integrity.KUPint := f_NG_Authentication_A8(tsc_N_UP_Int_Alg,
                                                                fl_NR_AS_IntegrityInfo_GetIntAlg(v_Auth_Params.AS_Integrity), // @sic R5s210518 sic@
                                                                v_Auth_Params.KGNB,
                                                                v_Auth_Params.KDF);
    return v_Auth_Params;
  }

  /*
   * @desc      Function to be used for AS Key derivation before AS SMC in NR.
   *            for Chaining and Re-keying of an existing KgNB when no fresh Authentication has taken place.
   *
   *            the parameter p_NCC will decide if it is chaining [p_NCC != NCC associated with Kgnb],
   *            or if Re-keying [p_NCC == NCC associated with Kgnb] .
   *            This function needs to be called after sending RRCConnection reconfiguration for handover or
   *            RRC Connection Re-establishment when keySetChangeIndicator received in the securityConfiguration is not set to TRUE
   *            The structure for NR_SecurityParams_Type passed as parameter shall have all AS keys set.
   *            Execution of this function will re-initialise following parameters
   *            NH, KNG-RAN* == KGNB, KRRCenc, KRRCint, KUPint & KUPenc
   * @param     p_TargetPhysicalCellIdentity
   * @param     p_ARFCN_DL
   * @param     p_Auth_Params
   * @param     p_NCC
   * @return    NR_SecurityParams_Type
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitAS_KeyChaining_KeyRefresh(PhysCellId p_TargetPhysicalCellIdentity,
                                                 ARFCN_ValueNR p_ARFCN_DL,
                                                 NR_SecurityParams_Type p_Auth_Params,
                                                 NextHopChainingCount p_NCC) return NR_SecurityParams_Type
  {
    var NR_SecurityParams_Type v_Auth_Params := p_Auth_Params;
    // initialise to  received as parameter
    if (v_Auth_Params.NCC == p_NCC) {  // Refresh of KgNB; Horizontal key derivation
      v_Auth_Params.KGNB := f_NR_Authentication_A11(v_Auth_Params.KDF,
                                                    v_Auth_Params.KGNB,
                                                    v_Auth_Params.NH,
                                                    p_TargetPhysicalCellIdentity,
                                                    p_ARFCN_DL);
    }
    else {  //Chaining of KgNB; Vertical Key derivation
      while (v_Auth_Params.NCC != p_NCC)  {
        if (v_Auth_Params.NCC != 0) { // NH for NCC =1 is already derived in initial AS Key derivation
          v_Auth_Params.NH := f_NR_Authentication_A10(v_Auth_Params.KDF,
                                                      v_Auth_Params.KAMF,
                                                      v_Auth_Params.NH);
          // Derive NH and store in v_Auth_Params.KGNB
        }
        v_Auth_Params.NCC := (v_Auth_Params.NCC + 1) mod 4;
      }
      v_Auth_Params.KGNB := f_NR_Authentication_A11(v_Auth_Params.KDF,
                                                    v_Auth_Params.KGNB,
                                                    v_Auth_Params.NH,
                                                    p_TargetPhysicalCellIdentity,
                                                    p_ARFCN_DL,
                                                    true);
      //Derive KGNB* which will be KGNB from NH stored in v_Auth_Params.KGNB
    }
    // Derive KRRC enc key
    v_Auth_Params.AS_Ciphering.KRRCenc := f_NG_Authentication_A8(tsc_RRC_Enc_Alg,
                                                                 f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                 v_Auth_Params.KGNB,
                                                                 v_Auth_Params.KDF);
    // Derive KRRC int key
    v_Auth_Params.AS_Integrity.KRRCint := f_NG_Authentication_A8(tsc_RRC_Int_Alg,
                                                                 fl_NR_AS_IntegrityInfo_GetIntAlg(v_Auth_Params.AS_Integrity), // @sic R5s210518 sic@
                                                                 v_Auth_Params.KGNB,
                                                                 v_Auth_Params.KDF);
    // Derive UP enc key;
    v_Auth_Params.AS_Ciphering.KUPenc := f_NG_Authentication_A8(tsc_UP_Enc_Alg,
                                                                f_NR_ConvertCiphAlg2Bitstring(v_Auth_Params.AS_Ciphering.Algorithm),
                                                                v_Auth_Params.KGNB,
                                                                v_Auth_Params.KDF);
    // Derive UP int key;
    v_Auth_Params.AS_Integrity.KUPint := f_NG_Authentication_A8(tsc_N_UP_Int_Alg,
                                                                fl_NR_AS_IntegrityInfo_GetIntAlg(v_Auth_Params.AS_Integrity), // @sic R5s210518 sic@
                                                                v_Auth_Params.KGNB,
                                                                v_Auth_Params.KDF);
    return v_Auth_Params;
  };

  /*
   * @desc      KgNB derivation function used at 5GCM-IDLE to 5GCM CONNECTED transition,
   *            5GCM-IDLE mode mobility, transition away from GMM-DEREGISTERED to GMM-REGISTERED/5GCM-CONNECTED
   *            and key change on the-fly
   *            As per annex A.9 of 33.501
   * @param     p_KDF
   * @param     p_KAMF
   * @param     p_UL_NAS_Count
   * @param     p_AccessType        (default value: tsc_Access3GPP_Type)
   * @return    B256_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Authentication_A9(KDF_Type p_KDF,
                                  B256_Type p_KAMF,
                                  O4_Type p_UL_NAS_Count,
                                  O1_Type p_AccessType := tsc_Access3GPP_Type) return B256_Type
  {
    const octetstring const_S6E_FC :='6E'O;
    var octetstring v_S;
    // Generation of String
    v_S := const_S6E_FC;
    //FC = 0x6E
    v_S :=   ( v_S & p_UL_NAS_Count);
    //P0 = Uplink NAS COUNT
    v_S :=  ( v_S & '0004'O );
    //L0 = length of uplink NAS COUNT (i.e. 0x00 0x04)
    v_S :=   ( v_S & p_AccessType);
    //P1 = Access Type Identifier
    v_S :=  ( v_S & '0001'O );
    //L1 = length of Access Type Identifier (i.e. 0x00 0x01)
    return fx_KeyDerivationFunction ( p_KDF, p_KAMF, v_S );
  }

  /*
   * @desc      NH* derivation function
   *            As per annex A.10 of 33.501
   *            The SYNC-input parameter shall be the newly derived KgNB for the initial NH derivation,
   *            and the previous NH for all subsequent derivations
   * @param     p_KDF
   * @param     p_KAMF
   * @param     p_Synch
   * @return    B256_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Authentication_A10(KDF_Type p_KDF,
                                   B256_Type p_KAMF,
                                   B256_Type p_Synch) return B256_Type
  {
    const octetstring const_S6F_FC :='6F'O;
    var octetstring v_S;
    // Generation of String
    v_S := const_S6F_FC;
    //  FC = 0x6F
    v_S :=   ( v_S & bit2oct ( p_Synch ) );
    // P0 = SYNC-input
    v_S :=   ( v_S & '0020'O );
    //L0 = length of SYNC-input (i.e. 0x00 0x20)

    return fx_KeyDerivationFunction ( p_KDF, p_KAMF, v_S );
  }

  /*
   * @desc      KNG-RAN* derivation function
   *            As per annex A.11 of 33.501
   *            shall derive new key from either current KgNB (horizontal derivation for 1st instance of HO)
   *            or from NH (vertical derivation) for subsequent HO and NCC > 1
   * @param     p_KDF
   * @param     p_KGNB
   * @param     p_NH
   * @param     p_PhyCellId
   * @param     p_ARFCN_DL
   * @param     p_FromNH            (default value: false)
   * @return    B256_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Authentication_A11(KDF_Type p_KDF,
                                   B256_Type p_KGNB,
                                   B256_Type p_NH,
                                   PhysCellId p_PhyCellId,
                                   ARFCN_ValueNR p_ARFCN_DL,
                                   boolean p_FromNH := false) return B256_Type
  {
    const octetstring const_S70_FC :='70'O;
    var octetstring v_S;
    var B256_Type v_SourceKey;

    // Generation of String
    v_S := const_S70_FC;
    //  FC = 0x70
    v_S :=   ( v_S & int2oct ( p_PhyCellId , 2 ) );
    //P0 = PCI (target physical cell id)
    v_S :=   ( v_S & '0002'O );
    //L0 = length of PCI (i.e. 0x00 0x02)
    v_S :=   ( v_S & int2oct ( p_ARFCN_DL , 3 ) );
    // P1 = ARFCN-DL
    v_S :=   ( v_S & '0003'O );
    // L1 = length of ARFCN-DL

    if (p_FromNH) { // Kgnb* derived from Fresh Derived NH
      v_SourceKey := p_NH;
    } else { // Kgnb* derived from Kgnb
      v_SourceKey := p_KGNB;
    }
    
    return fx_KeyDerivationFunction ( p_KDF, v_SourceKey, v_S );
  }

  /*
   * @desc      Converts ASN.1 CipheringAlgorithm to bit string representation
   * @param     p_Alg
   * @return    B4_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertCiphAlg2Bitstring(CipheringAlgorithm p_Alg) return B4_Type
  {
    var B4_Type v_B4 := '1111'B;
    select (p_Alg) {
      case (nea0) {
        v_B4 := '0000'B;
      }
      case (nea1) {
        v_B4 := '0001'B;
      }
      case (nea2) {
        v_B4 := '0010'B;
      }
      case (nea3) {
        v_B4 := '0011'B;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Ciphering algorithm Selected");
      }
    }
    return v_B4;
  }

  /*
   * @desc      Converts ASN.1 IntegrityProtAlgorithm to bit string representation
   * @param     p_Alg
   * @return    B4_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertIntAlg2Bitstring(IntegrityProtAlgorithm p_Alg) return B4_Type
  {
    var B4_Type v_B4 := '1111'B;
    select (p_Alg) {
      case (nia1) {
        v_B4 := '0001'B;
      }
      case (nia2) {
        v_B4 := '0010'B;
      }
      case (nia3) {
        v_B4 := '0011'B;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Integrity algorithm Selected");
      }
    }
    return v_B4;
  }

  /*
   * @desc      Converts ASN.1 IntegrityProtAlgorithm_Type to bit string representation
   *            considering the test case attribute "NullIntegrityAlgorithmAllowed"
   * @param     p_AS_Integrity
   * @return    B4_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_AS_IntegrityInfo_GetIntAlg(NR_AS_IntegrityInfo_Type p_AS_Integrity) return B4_Type
  {
    var B4_Type v_IntAlg;

    if ((f_GetTestcaseAttrib_NullIntegrityAlgorithmAllowed(testcasename())) and (p_AS_Integrity.Algorithm == nia0 )) {
        v_IntAlg := '0000'B;
    } else {
      v_IntAlg := f_NR_ConvertIntAlg2Bitstring(p_AS_Integrity.Algorithm);
    }
    return v_IntAlg;
  }

}
