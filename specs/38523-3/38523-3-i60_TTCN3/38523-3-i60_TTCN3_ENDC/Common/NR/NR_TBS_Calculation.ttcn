module NR_TBS_Calculation {

  import from Common4G5G_Functions all;
  import from CommonDefs all;

  /*
   * @desc      return greater of the two given values
   * @param     p_Value1
   * @param     p_Value2
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_MaxInt(integer p_Value1,
                    integer p_Value2) return integer
  {
    var integer v_MaxValue;
    if (p_Value1 > p_Value2) {
      v_MaxValue := p_Value1;
    } else {
      v_MaxValue := p_Value2;
    }
    return v_MaxValue;
  }

  /*
   * @desc      return smaller of the two given values
   * @param     p_Value1
   * @param     p_Value2
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_MinInt(integer p_Value1,
                    integer p_Value2) return integer
  {
    var integer v_MinValue;
    if (p_Value1 < p_Value2) {
      v_MinValue := p_Value1;
    } else {
      v_MinValue := p_Value2;
    }
    return v_MinValue;
  }

  const charstring tsc_NR_MCS_Table_5_1_3_1__1            := "5.1.3.1-1";       /* for PDSCH when Table 5.1.3.1-2 is not applicable;
                                                                                   for PUSCH when DCI format 0_0 AND transform precoding = disabled   @status    APPROVED (ENDC, NR5GC) */

  const charstring tsc_NR_MCS_Table_5_1_3_1__2            := "5.1.3.1-2";       /* for PDSCH scheduled with C-RNTI when DCI format 1_1 AND PDSCH-Config.mcs-Table = qam256;
                                                                                   for PUSCH scheduled with C-RNTI when DCI format 0_1 AND (PUSCH-Config.mcs-Table = qam256 OR PUSCH-Config.mcs-TableTransformPrecoder = qam256  @status    APPROVED (ENDC, NR5GC) */

  const charstring tsc_NR_MCS_Table_6_1_4_1__1            := "6.1.4.1-1 (tp-pi2BPSK=disabled)";     /* for PUSCH when DCI format 0_0 AND transform precoding = enabled AND tp-pi2BPSK = disabled  @status    APPROVED (ENDC, NR5GC) */

  const charstring tsc_NR_MCS_Table_6_1_4_1__1_tp_pi2BPSK := "6.1.4.1-1 (tp-pi2BPSK=enabled)";      /* for PUSCH when DCI format 0_0 AND transform precoding = enabled AND tp-pi2BPSK = enabled   @status    APPROVED (ENDC, NR5GC) */

  type record NR_MCS_TableEntry_Type { /* @status    APPROVED (ENDC, NR5GC) */
    integer Qm,
    float CodeRate_x_1024
  };

  type record of NR_MCS_TableEntry_Type NR_MCS_Table_Type; /* @status    APPROVED (ENDC, NR5GC) */

  type record NR_TBS_CalculationParameters_Type {  /* @status    APPROVED (ENDC, NR5GC) */
    charstring          PxSCH,
    charstring          MappingType,
    NR_MCS_Table_Type   MCS_Table,
    integer             MaxNoOfDmrsAddPos,
    integer             NoOfCdmGroups,
    integer             NoOfLayers,
    integer             XOverhead,
    float               ScalingFactor
  };

  template (value) NR_TBS_CalculationParameters_Type cs_NR_TBS_CalculationParameters(charstring p_PxSCH,
                                                                                     charstring p_MappingType,
                                                                                     charstring p_MCS_TableNumber,
                                                                                     integer    p_MaxNoOfDmrsAddPos,
                                                                                     integer    p_NoOfCdmGroups,
                                                                                     integer    p_NoOfLayers := 1,
                                                                                     integer    p_XOverhead := 0,
                                                                                     float      p_ScalingFactor := 1.0) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    PxSCH             := p_PxSCH,
    MappingType       := p_MappingType,
    MCS_Table         := fl_NR_MCS_Table(p_MCS_TableNumber),
    MaxNoOfDmrsAddPos := p_MaxNoOfDmrsAddPos,
    NoOfCdmGroups     := p_NoOfCdmGroups,
    NoOfLayers        := p_NoOfLayers,
    XOverhead         := p_XOverhead,
    ScalingFactor     := p_ScalingFactor
  };

  /*
   * @desc      return MCS table
   * @param     p_TableNumber
   * @return    NR_MCS_Table_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_MCS_Table(charstring p_TableNumber) return NR_MCS_Table_Type
  {
    var NR_MCS_Table_Type v_MCS_Table;
    var integer v_Q := 2;

    select (p_TableNumber) {
      case (tsc_NR_MCS_Table_5_1_3_1__1) {
        v_MCS_Table := {
          {2, 120.0},   // Imcs = 0
          {2, 157.0},   // Imcs = 1
          {2, 193.0},   // Imcs = 2
          {2, 251.0},   // Imcs = 3
          {2, 308.0},   // Imcs = 4
          {2, 379.0},   // Imcs = 5
          {2, 449.0},   // Imcs = 6
          {2, 526.0},   // Imcs = 7
          {2, 602.0},   // Imcs = 8
          {2, 679.0},   // Imcs = 9
          {4, 340.0},   // Imcs = 10
          {4, 378.0},   // Imcs = 11
          {4, 434.0},   // Imcs = 12
          {4, 490.0},   // Imcs = 13
          {4, 553.0},   // Imcs = 14
          {4, 616.0},   // Imcs = 15
          {4, 658.0},   // Imcs = 16
          {6, 438.0},   // Imcs = 17
          {6, 466.0},   // Imcs = 18
          {6, 517.0},   // Imcs = 19
          {6, 567.0},   // Imcs = 20
          {6, 616.0},   // Imcs = 21
          {6, 666.0},   // Imcs = 22
          {6, 719.0},   // Imcs = 23
          {6, 772.0},   // Imcs = 24
          {6, 822.0},   // Imcs = 25
          {6, 873.0},   // Imcs = 26
          {6, 910.0},   // Imcs = 27
          {6, 948.0}    // Imcs = 28
        };
      }
      case (tsc_NR_MCS_Table_5_1_3_1__2) {
        v_MCS_Table := {
          {2, 120.0},   // Imcs = 0
          {2, 193.0},   // Imcs = 1
          {2, 308.0},   // Imcs = 2
          {2, 449.0},   // Imcs = 3
          {2, 602.0},   // Imcs = 4
          {4, 378.0},   // Imcs = 5
          {4, 434.0},   // Imcs = 6
          {4, 490.0},   // Imcs = 7
          {4, 553.0},   // Imcs = 8
          {4, 616.0},   // Imcs = 9
          {4, 658.0},   // Imcs = 10
          {6, 466.0},   // Imcs = 11
          {6, 517.0},   // Imcs = 12
          {6, 567.0},   // Imcs = 13
          {6, 616.0},   // Imcs = 14
          {6, 666.0},   // Imcs = 15
          {6, 719.0},   // Imcs = 16
          {6, 772.0},   // Imcs = 17
          {6, 822.0},   // Imcs = 18
          {6, 873.0},   // Imcs = 19
          {8, 682.5},   // Imcs = 20
          {8, 711.0},   // Imcs = 21
          {8, 754.0},   // Imcs = 22
          {8, 797.0},   // Imcs = 23
          {8, 841.0},   // Imcs = 24
          {8, 885.0},   // Imcs = 25
          {8, 916.5},   // Imcs = 26
          {8, 948.0}    // Imcs = 27
        };
      }
      case (tsc_NR_MCS_Table_6_1_4_1__1, tsc_NR_MCS_Table_6_1_4_1__1_tp_pi2BPSK) {
        if (p_TableNumber == tsc_NR_MCS_Table_6_1_4_1__1_tp_pi2BPSK) {
          v_Q := 1;
        }
        v_MCS_Table := {
          {v_Q, (120.0/int2float(v_Q))}, // Imcs = 0
          {v_Q, (314.0/int2float(v_Q))}, // Imcs = 1
          {2, 193.0},     // Imcs = 2
          {2, 251.0},     // Imcs = 3
          {2, 308.0},     // Imcs = 4
          {2, 379.0},     // Imcs = 5
          {2, 449.0},     // Imcs = 6
          {2, 526.0},     // Imcs = 7
          {2, 602.0},     // Imcs = 8
          {2, 679.0},     // Imcs = 9
          {4, 340.0},     // Imcs = 10
          {4, 378.0},     // Imcs = 11
          {4, 434.0},     // Imcs = 12
          {4, 490.0},     // Imcs = 13
          {4, 553.0},     // Imcs = 14
          {4, 616.0},     // Imcs = 15
          {4, 658.0},     // Imcs = 16
          {6, 466.0},     // Imcs = 17
          {6, 517.0},     // Imcs = 18
          {6, 567.0},     // Imcs = 19
          {6, 616.0},     // Imcs = 20
          {6, 666.0},     // Imcs = 21
          {6, 719.0},     // Imcs = 22
          {6, 772.0},     // Imcs = 23
          {6, 822.0},     // Imcs = 24
          {6, 873.0},     // Imcs = 25
          {6, 910.0},     // Imcs = 26
          {6, 948.0}      // Imcs = 27
        };
      }
      case else {
        FatalError(__FILE__, __LINE__, "unknown MCS table")
      }
    }
    return v_MCS_Table;
  }

  /*
   * @desc      return the number of REs per PRB which can be used for PDSCH/PUSCH transmission according to step 1 in 38.214 clause 5.1.3.2
   * @param     p_Parameters
   * @param     p_NoOfSymbols
   * @param     p_StartSymbol       (default value: 0)
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_TBS_Calculation_NoOfREsPerPrb_Step1(NR_TBS_CalculationParameters_Type p_Parameters,
                                                     integer p_NoOfSymbols, //@sic R5s240582 sic@
                                                     integer p_StartSymbol:=0) return integer
  {
    var integer v_ActualNumberOfSymbolsWithDMRS;
    var integer v_TotalNumberOfREs;
    var integer v_NumberOfREsWithoutData;

    select (p_Parameters.MappingType) {
      case ("TypeA") {
        // Actual number of symbols with DMRS for mapping type A according to TS 38.211 Table 6.4.1.1.3-3 and Table 7.4.1.1.2-3
        if ((p_NoOfSymbols < 8) or (p_Parameters.MaxNoOfDmrsAddPos == 0)) {
          if(p_StartSymbol+p_NoOfSymbols >8)   //@sic R5s240582 sic@
            {
            v_ActualNumberOfSymbolsWithDMRS := 2;
            }
            else
            {
             v_ActualNumberOfSymbolsWithDMRS := 1;
            }
        } else if ((p_NoOfSymbols < 10) or (p_Parameters.MaxNoOfDmrsAddPos == 1)) {
          v_ActualNumberOfSymbolsWithDMRS := 2;
        } else if ((p_NoOfSymbols < 12) or (p_Parameters.MaxNoOfDmrsAddPos == 2)) {
          v_ActualNumberOfSymbolsWithDMRS := 3;
        } else {
          v_ActualNumberOfSymbolsWithDMRS := 4;
        }
      }
      case ("TypeB") {
        select (p_Parameters.PxSCH) {
          case ("PUSCH") {
            // Actual number of symbols with DMRS for mapping type B according to TS 38.211 Table 6.4.1.1.3-3
            if ((p_NoOfSymbols < 5) or (p_Parameters.MaxNoOfDmrsAddPos == 0)) {
              v_ActualNumberOfSymbolsWithDMRS := 1;
            } else if ((p_NoOfSymbols < 8) or (p_Parameters.MaxNoOfDmrsAddPos == 1)) {
              v_ActualNumberOfSymbolsWithDMRS := 2;
            } else if ((p_NoOfSymbols < 10) or (p_Parameters.MaxNoOfDmrsAddPos == 2)) {
              v_ActualNumberOfSymbolsWithDMRS := 3;
            } else {
              v_ActualNumberOfSymbolsWithDMRS := 4;
            }
          }
          case ("PDSCH") {
            // Actual number of symbols with DMRS for mapping type B according to TS 38.211 Table 6.4.1.1.3-3
            if ((p_NoOfSymbols < 6) or (p_Parameters.MaxNoOfDmrsAddPos == 0)) {
              v_ActualNumberOfSymbolsWithDMRS := 1;
            } else if (p_Parameters.MaxNoOfDmrsAddPos == 1) {
              v_ActualNumberOfSymbolsWithDMRS := 2;
            } else {
              FatalError(__FILE__, __LINE__, "PDSCH mapping type B: invalid configuration");
            }
          }
        }
      }
    }
    // Total number of REs in an RB with given duration:
    v_TotalNumberOfREs := p_NoOfSymbols * 12;
    // number of REs which are not used for PDSCH
    v_NumberOfREsWithoutData := v_ActualNumberOfSymbolsWithDMRS * p_Parameters.NoOfCdmGroups * 6;
    // return number of REs which are used for PDSCH
    return v_TotalNumberOfREs - v_NumberOfREsWithoutData - p_Parameters.XOverhead;
  }

  /*
   * @desc      Return the first TBS from TS 38.214 Table 5.1.3.2-1 with TBS >= Ninfo'
   * @param     p_Ninfo
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_TBS_Calculation_Step3(float p_Ninfo) return integer
  {
    var IntegerList_Type v_TbsTable := { 24,   32,   40,   48,   56,   64,   72,   80,   88,   96,   104,  112,  120,  128,  136,  144,
                                         152,  160,  168,  176,  184,  192,  208,  224,  240,  256,  272,  288,  304,  320,  336,  352,
                                         368,  384,  408,  432,  456,  480,  504,  528,  552,  576,  608,  640,  672,  704,  736,  768,
                                         808,  848,  888,  928,  984,  1032, 1064, 1128, 1160, 1192, 1224, 1256, 1288, 1320, 1352, 1416,
                                         1480, 1544, 1608, 1672, 1736, 1800, 1864, 1928, 2024, 2088, 2152, 2216, 2280, 2408, 2472, 2536,
                                         2600, 2664, 2728, 2792, 2856, 2976, 3104, 3240, 3368, 3496, 3624, 3752, 3824 };
    var integer v_TBS := 0;
    var integer v_Ninfo_;
    var integer v_Pow_2_n;
    var integer v_N;
    var integer i;
    
    // Calculate "quantized intermediate number of information bits" Ninfo' acc. to step 3 of TS 38.214 clause 5.1.3.2:
    v_N := f_MaxInt(3, f_FloorLog2(float2int(p_Ninfo)) - 6);      // NOTE: floor(log2(x)) is the same for x being float or being rounded down to integer
    v_Pow_2_n := f_Power(2, v_N);
    v_Ninfo_ := f_MaxInt(24, v_Pow_2_n * (float2int(p_Ninfo / int2float(v_Pow_2_n))));     // NOTE: float2int is equivalent to floor
    
    // get closest TBS that is not less than Ninfo':
    for (i := 0; i < lengthof(v_TbsTable); i := i + 1) {
      v_TBS := v_TbsTable[i];
      if (v_TBS >= v_Ninfo_) {
        break;
      }
    }
    return v_TBS;
  }

  /*
   * @desc      Return TBS according to step 4 of TS 38.214 clause 5.1.3.2
   * @param     p_Ninfo
   * @param     p_CodeRate
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_TBS_Calculation_Step4(float p_Ninfo,
                                       float p_CodeRate) return integer
  {
    var integer v_Ninfo_;
    var integer v_Pow_2_n;
    var integer v_N;
    var integer v_C;

    // Calculate "quantized intermediate number of information bits" Ninfo' acc. to step 3 of TS 38.214 clause 5.1.3.2
    v_N := f_FloorLog2(float2int(p_Ninfo) - 24) - 5;      // NOTE: floor(log2(x)) is the same for x being float or being rounded down to integer
    v_Pow_2_n := f_Power(2, v_N);
    v_Ninfo_ := f_MaxInt(3840, v_Pow_2_n * f_Round((p_Ninfo - 24.0) / int2float(v_Pow_2_n)));
    
    if (p_CodeRate <= 0.25) {
      v_C := f_RoundedUpDivision(v_Ninfo_ + 24, 3816);
    } else {
      if (v_Ninfo_ > 8424) {
        v_C := f_RoundedUpDivision(v_Ninfo_ + 24, 8424);
      } else {
        v_C := 1;
      }
    }
    return (8 * v_C * f_RoundedUpDivision(v_Ninfo_ + 24, 8 * v_C)) - 24;
  }

  /*
   * @desc      TBS determination according TS 38.214 clause 5.1.3.2
   *            return calculated TBS or 0 when there is no valid TBS
   * @param     p_CalculationParameters
   * @param     p_NoOfSymbols
   * @param     p_NoOfRBs
   * @param     p_Imcs
   * @param     p_IsDownlink        (default value: false)
   * @param     p_StartSymbol       (default value: 0)
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_TBS_Calculation(template (value) NR_TBS_CalculationParameters_Type p_CalculationParameters,
                                integer p_NoOfSymbols,
                                integer p_NoOfRBs,
                                integer p_Imcs,
                                boolean p_IsDownlink := false, //@sic R5s240582 sic@
                                integer p_StartSymbol:=0) return integer
  {
    var NR_TBS_CalculationParameters_Type v_Parameters := valueof(p_CalculationParameters);
    var NR_MCS_TableEntry_Type v_MCS_TableEntry := v_Parameters.MCS_Table[p_Imcs];
    var float v_CodeRate := v_MCS_TableEntry.CodeRate_x_1024 / 1024.0;
    var integer v_Qm := v_MCS_TableEntry.Qm;
    var integer v_NoOfREsPerPrb;
    var integer v_NoOfREs;
    var float v_Nmax;
    var float v_Ninfo;
    var integer v_TBS;
    var float v_EffectiveCodeRate;
    var integer v_CRCSize;
    var integer v_Kcb;//@sic R5s240582 sic@
    // Step 1:
    v_NoOfREsPerPrb := fl_NR_TBS_Calculation_NoOfREsPerPrb_Step1(v_Parameters, p_NoOfSymbols,p_StartSymbol);
    v_NoOfREs := f_MinInt(156, v_NoOfREsPerPrb) * p_NoOfRBs;     /* NOTE:
                                                                    for p_NoOfSymbols=14, p_Parameters.NoOfCdmGroups=1 and p_Parameters.MaxNoOfDmrsAddPos=0 we get v_NoOfREsPerPrb = 162,
                                                                    for p_NoOfSymbols=14, p_Parameters.NoOfCdmGroups=1 and p_Parameters.MaxNoOfDmrsAddPos=1 we get v_NoOfREsPerPrb = 156
                                                                    => f_MinInt(156, v_NoOfREsPerPrb) results in 156 for both configurations and the TBS' are the same */
    
    //log("v_NoOfREsPerPrb = " & int2str(v_NoOfREsPerPrb));
    //log("v_NoOfREs = " & int2str(v_NoOfREs));
    
    // Step 2:
    v_Nmax := v_Parameters.ScalingFactor * int2float(v_NoOfREs) * int2float(v_Qm) * int2float(v_Parameters.NoOfLayers);
    v_Ninfo := v_Nmax * v_CodeRate;
    //log("v_Ninfo = " & int2str(float2int(v_Ninfo)) & "." & int2str(float2int(v_Ninfo * 1000.0) mod 1000));
    
    if (v_Ninfo < 24.0) {
      /* special case: TBS=24 is the smallest TBS => any Ninfo < 24 would result in TBS=24 according to the calculation in 38.214
         => criteria needs to be specified in the prose (either e.g. to skip Ninfo < 24.0 or to skip all {NoOfRBs, Imcs} where there is a greater Imcs value for the same NoOfRBs */
      return 0;    // !!!! exact criteria needs to be defined and documented !!!!
    }
    
    if (v_Ninfo <= 3824.0) {
      // Step 3:
      v_TBS := fl_NR_TBS_Calculation_Step3(v_Ninfo);
    }   else if  (v_Ninfo < 3825.0) { //@sic R5-202607, R5-202608 sic@
    //There is ambiguity of TBS calculation when 3824.0 < Ninfo < 3825.0 in clause 5.1.3.2 of TS 38.214
      v_TBS := 0;
    } else{
      // Step 4:
      v_TBS := fl_NR_TBS_Calculation_Step4(v_Ninfo, v_CodeRate);
    }

    if (p_IsDownlink) { /* @sic R5s190826 change 5: check effective code rate for DL sic@ */
    //@sic R5s240582 sic@
      if ((v_CodeRate<=0.25)or(v_TBS <= 292)or((v_TBS <= 3824)and(v_CodeRate<=0.67))){
    v_Kcb:=3840;
      } else {
    v_Kcb:=8448;
      }
     if (v_TBS <= 3824){
        v_CRCSize := 16;
      } else {
        v_CRCSize := 24;
      }
      v_EffectiveCodeRate := int2float((v_TBS+(v_TBS/(v_Kcb-24))*24+v_CRCSize))/ v_Nmax;//@sic R5s240582 sic@
      if (v_EffectiveCodeRate > 0.95) {             /* @sic R5s190826 change 5: effective code rate shall be <= 0.95  according to 38.214 clause 5.1.3.4 sic@ */
        v_TBS := 0;
      }
    }

/*     if ((v_Ninfo > 3824.0) and (v_Ninfo < 3825.0)) {   // @sic R5-200241: Discussion of ambiguity of Ninfo in TBS calculation sic@  */
/*       log("v_Ninfo=" & f_Float2Str(v_Ninfo) & ": TBS=" & int2str(v_TBS) & " NoOfRBs=" & int2str(p_NoOfRBs) & " Imcs=" & int2str(p_Imcs)); */
/*     } */
    return v_TBS;
  }

}
