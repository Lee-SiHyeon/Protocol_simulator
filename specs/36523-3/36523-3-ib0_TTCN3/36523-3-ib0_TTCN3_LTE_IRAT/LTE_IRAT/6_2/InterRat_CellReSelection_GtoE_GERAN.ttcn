      reporting700_810 := cs_Rel7_ReportingDef700810,
      r8Mask := '1'B,
      indMask := '1'B, // @sic R5s150815 sic@
      baInd3G := '0'B, // @sic R5s150815 sic@
      pmoInd := '0'B, // @sic R5s150815 sic@
      priorEutranMask := '1'B,
      servingCellMask := '0'B,
