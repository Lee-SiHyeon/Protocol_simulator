    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_4_4_21s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.DlTdoa
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_4_DlTdoa_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var template (value) NR_DL_TDOA_ProvideAssistanceData_r16 v_DlTdoaProvideAssistanceData;
    var template (omit) Acknowledgement v_Acknowledgement := omit;

    //@siclog "Step 1" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(21));

    //@siclog "Steps 1b, 1c, 1d" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 2" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationMeasurementsRequired,
                                                                            tsc_ResponseTimeDef,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,-,-,-,-,
                                                                            cs_DlTDOARequestLocationInfoDef(true))); // nr-AssistanceAvailability-r16 := true
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //Receive LPP Request Assistance Data
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppReqAssistanceDataDlTdoa_Ack);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.4 Step 3");

    //@siclog "Step 4" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    if (isvalue(v_LppMessage.acknowledgement)) {//UE requested ack
      v_Acknowledgement := cs_Acknowledgement (false, v_LppMessage.sequenceNumber)
    }
    // Get default assistance data
    v_DlTdoaProvideAssistanceData := cs_DlTdoaProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(2),
                                                                    {cs_NrSelectedDlPrsPerFreq(0)},
                                                                    omit);
    //Now remove elements not requested by the UE
    if (v_LppMessage.lpp_MessageBody.c1.requestAssistanceData.criticalExtensions.c1.requestAssistanceData_r9.nr_DL_TDOA_RequestAssistanceData_r16.nr_AdType_r16[0] == '0'B){ //nr-DL-PRS-AssistanceData not requested
      v_DlTdoaProvideAssistanceData.nr_DL_PRS_AssistanceData_r16 := omit;
    }

    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                          targetDevice,
                                                                          omit,
                                                                          omit,
                                                                          v_Acknowledgement,
                                                                          -,-,-,-,-,
                                                                          v_DlTdoaProvideAssistanceData));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 5" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideLocationInformation_DlTdoa(tsc_POS_TransactionNumber));

    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.3 Step 5");

    //@siclog "Step 5a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 5
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_4_DlTdoa_NR5GC_TestBody

}
