                                                           template (omit) DRX_Config p_DRX_Config := omit,
                                                           TimeAlignmentTimer p_TimeAlignmentTimer := sf750,
                                                           template (omit) PHR_Config_Type p_PHR_Config := cs_508_PHR_Config_Setup,
                                                           template (omit) SR_ProhibitTimer_r9_Type p_SR_ProhibitTimer_r9 := omit,
                                                           template (omit) MAC_MainConfig_v1020_Type p_MAC_MainConfig_v1020 := omit,
                                                           template (omit) boolean p_E_HARQ_Pattern_r12 := omit, //@sic R5-160956 sic@
                                                           template (omit) DualConnectivityPHR_Type p_DualConnectivityPHR := omit, //@sic R5-165871 sic@
                                                           template (omit) EDRX_CycleStartOffset_r13_Type p_EDRX_CycleStartOffset := omit, //@sic R5s167188 sic@
                                                           template (omit) DRX_Config_r13_Type p_DRX_Config_r13 := omit,
                                                           template (omit) MAC_MainConfig_SkipUplinkTx_Type p_SkipUplinkTx := omit) :=
