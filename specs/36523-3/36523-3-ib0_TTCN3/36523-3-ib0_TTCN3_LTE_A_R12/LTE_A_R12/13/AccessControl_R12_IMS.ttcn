module AccessControl_R12_IMS {

  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_Video all;
  import from IMS_SMS_Messages all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1a_IMS1() runs on IMS_PTC
  { // MTSI MO speech Call / SSAC in Connected mode  / 0% access probability for MTSI MO speech call
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Response183;
    timer t_WaitInvite:= 10.0;   // @sic R5-162789 sic@
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    // @siclog "Step 9" siclog@
    // Check: Does the UE transmit an INVITE message within 10 s?
    t_WaitInvite.start; // @sic R5-162789 sic@

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();

    t_WaitInvite.stop; // @sic R5-162789 sic@
    
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO speech call Table 4.5A.6.3-1 Step 12-14
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);   // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1c
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1c_IMS1() runs on IMS_PTC
  { // MTSI MO speech call / SSAC / 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Response183;
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @siclog "Step 9 - 21" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();
    
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);  /* @sic R5w140112 sic@ */
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO call Table 4.5A.6.3-1 Step 12-15
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);       // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1d
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1d_IMS1() runs on IMS_PTC
  { // MTSI MO speech Call / SSAC in Connected mode / 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Response183;
    timer t_WaitInvite := f_IMS_SetTimerToleranceMax(10.0);
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    // @siclog "Step 9" siclog@
    // Check: Does the UE transmit an INVITE message within 10 s?
    t_WaitInvite.start;
    alt{
      [] IMS_Server.check(receive(?)) {
           // if anything is received, assume it's an INVITE - this will be checked properly in f_IMS_MOCallSetup_AnnexC21_Step2_A4
           t_WaitInvite.stop;
      }
      [] t_WaitInvite.timeout {
           f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, " Step 9");
      }
    }

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();

    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO speech call Table 4.5A.6.3-1 Step 12-14
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);   // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);

    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    // Tell EUTRA test body is over
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2a_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call / SSAC in Connected mode / 0% access probability for MTSI MO speech call
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    timer t_WaitInvite:= 10.0;   // @sic R5-162789 sic@
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN); // @sic R5s160367 sic@

    // @siclog "Step 9" siclog@
    // Check: Does the UE transmit an INVITE message within 10 s?
    t_WaitInvite.start;

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);

    t_WaitInvite.stop;
    
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearers
    
    f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2c
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2c_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call / SSAC / 0% access probability for MTSI MO video call / AC-Barring per PLMN
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    // @siclog "Step 9" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearers
    
    f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2d
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2d_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call / SSAC in Connected mode/ 0% access probability for MTSI MO video call / AC-Barring per PLMN
    f_TC_13_5_2a_IMS1();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.3a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_3a_IMS2() runs on IMS_PTC
  { // MTSI MO speech Call / SSAC in Connected mode  / 0% access probability for MTSI MO speech call
    var INVITE_Request v_InviteRequest;
    
    f_IMS_PTC_Init(PDN_2);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    // @siclog "Step 14 - 17" siclog@
    f_IMS_EmergencyRegistration();
    
    // Steps 18-20 - Are executed concurrently on the SS / IPCanEmu
    
    // @siclog "Step 21 - 25" siclog@
    v_InviteRequest := f_IMS_EmergencyCallSetup();
    
    // @siclog "Step 26 - 27" siclog@
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.3b
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_3b_IMS2() runs on IMS_PTC
  { // Emergency Call / Success / SSAC/ 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    var INVITE_Request v_InviteRequest;
    
    f_IMS_PTC_Init(PDN_2);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    // @siclog "Step 1" siclog@
    // Check: does the test result in generic test procedure in TS 36.508 subclause 4.5A.4.3 indicate that the UE establishes an IMS emergency call?
    f_IMS_EmergencyRegistration();
    v_InviteRequest := f_IMS_EmergencyCallSetup();

    // @siclog "Steps 2 -6" siclog@
    // Steps 1 to 5 of the generic procedure for IMS speech call release (TS 34.229-1 C.32).
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
    f_IMS_TestBody_Set(false);
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.3c
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_3c_IMS2() runs on IMS_PTC
  { // Emergency Call / Success / SSAC in connected mode / 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    f_TC_13_5_3a_IMS2();
  }

