module RRC_Others_R12 {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;

  template (present) UECapabilityInformation_r8_IEs cr_EutraCapInfo_r12 :=
  { /* UECapabilityInformation (36.331 cl. 6.2.2) */
    /* @status    APPROVED (LTE_A_R12) */
    ue_CapabilityRAT_ContainerList := {
      cr_UE_CapabilityRAT_Container(eutra)
    },
    nonCriticalExtension := {
      lateNonCriticalExtension := *,
      nonCriticalExtension := {
        ue_RadioPagingInfo_r12 := {
            ue_Category_v1250 := 0,
            ue_CategoryDL_v1310 := *,                //@sic R5s160711 BASELINE MOVING 2016 sic@
            ce_ModeA_r13 := *,                       //@sic R5s160711 BASELINE MOVING 2016 sic@
            ce_ModeB_r13 := *,                       //@sic R5s160711 BASELINE MOVING 2016 sic@
            wakeUpSignal_r15 := *,                   /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
            wakeUpSignal_TDD_r15 := *,               /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
            wakeUpSignalMinGap_eDRX_r15 := *,        /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
            wakeUpSignalMinGap_eDRX_TDD_r15 := *,    /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
            ue_CategoryDL_v1610 := *,                /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
            groupWakeUpSignal_r16 := *,              /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
            groupWakeUpSignalTDD_r16 := *,           /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
            groupWakeUpSignalAlternation_r16 := *,   /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
            groupWakeUpSignalAlternationTDD_r16 := *,/* @sic R5s201386 BASELINE MOVING 2020 sic@ */
            inactiveStatePO_Determination_r17 := *   /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
        },
        nonCriticalExtension := *
      }
    }
  };

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.5.4.4
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_8_5_4_4_EUTRA() runs on EUTRA_PTC
  { //UE Capability Transfer/ Success/ UE Cat 0/ UE Paging Info
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    
    f_EUTRA_Init(c1);
    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to ensure USIM is updated
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def(eutra_Cell1);

    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS transmits a UECapabilityEnquiry message
    SRB.send(cas_SRB1_RrcPdu_REQ(eutra_Cell1, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry(v_RRC_TI)));
    
    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit a UECapabilityInformation message with IE UE-RadioPagingInfo  including ue-Category?
    SRB.receive(car_SRB1_RrcPdu_IND(eutra_Cell1, cr_508_UeCapabilityInformation(v_RRC_TI, cr_EutraCapInfo_r12)));

    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.5.4.4 Step 2");
   
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

}
