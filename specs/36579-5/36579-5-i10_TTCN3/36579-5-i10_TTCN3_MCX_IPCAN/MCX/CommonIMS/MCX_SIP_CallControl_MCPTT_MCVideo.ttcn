module MCX_SIP_CallControl_MCPTT_MCVideo {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_SDP_Messages all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_MIME_Functions all;
  import from MCX_PreestablishedSession all;
  import from MCX_SDP_MCPTT_MCVideo all;
  import from MCX_SIP_CallControl_Common all;
  import from MCX_SIP_Common all;
  import from MCX_SRTP_Configuration all;
  import from MCX_XML_mcpttLocationInfo all;
  import from MCX_XML_mcptt_info all;
  import from MCX_XML_mcvideoLocationInfo all;
  import from MCX_XML_mcvideo_info all;
  import from MCX_XML_resource_lists all;
  import from UpperTesterFunctions all;
  import from XSD all;

  type record MCX_InviteRequestWithSdpAndXml_Type {                             /* @status    APPROVED (MCX) */
    IMS_InviteRequestWithSdp_Type InviteRequestWithSdp,
    MCX_MIME_XmlBodies_Type       XmlBodies
  };

  /*
   * @desc      build-up MCX_InviteRequestWithSdpAndXml_Type
   * @param     p_IMS_DATA_REQ
   * @param     p_SdpOffer
   * @param     p_XmlBodies
   * @return    MCX_InviteRequestWithSdpAndXml_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_InviteRequestWithSdpAndXmlMO(IMS_DATA_REQ p_IMS_DATA_REQ,
                                               SDP_Message p_SdpOffer,
                                               MCX_MIME_XmlBodies_Type p_XmlBodies) return MCX_InviteRequestWithSdpAndXml_Type
  {
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;

    v_InviteRequestWithSdpAndXml.InviteRequestWithSdp := f_IMS_InviteRequestWithSdpMO(p_IMS_DATA_REQ, p_SdpOffer);
    v_InviteRequestWithSdpAndXml.XmlBodies := p_XmlBodies;

    return v_InviteRequestWithSdpAndXml;
  }

  /*
   * @desc      Configure SRTP for a call at the system simulator
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_TestProcedure
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetup_ConfigSRTP(MCX_ServiceType_Type p_ServiceType,
                                                MCX_CallType_Type p_CallType,
                                                IMS_TestProcedure_Type p_TestProcedure) runs on MCX_IMS_PTC
  {
    var template (omit) MCX_CS_ID_Type v_CS_Id_RTP := omit;   // will remain omit e.g. if p_CallType==ANY (preestablished session)

    select (p_ServiceType) {
      case (MCPTT) {
        select (p_CallType) {
          case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
            v_CS_Id_RTP := GMK_MCPTT;
          }
          case (PRIVATE_CALL) {
            select (p_TestProcedure) {
              case (IPCAN_MT_SpeechCall) { v_CS_Id_RTP := PCK_MCPTT_Receiver; }  // @sic R5s210398 - Additional change: PCK_MCPTT_Receiver instead of PCK_MCPTT_Initiator sic@
              case (IPCAN_MO_SpeechCall) { v_CS_Id_RTP := PCK_MCPTT_Initiator; }
              case else { FatalError(__FILE__, __LINE__, ""); }
            }
          }
          case (FIRST_TO_ANSWER) {
            select (p_TestProcedure) {
              case (IPCAN_MT_SpeechCall) { v_CS_Id_RTP := PCK_MCPTT_Initiator; }
              case (IPCAN_MO_SpeechCall) { v_CS_Id_RTP := PCK_MCPTT_Receiver; }
              case else { FatalError(__FILE__, __LINE__, ""); }
            }
          }
        }
      }
      case (MCVideo) {
        select (p_CallType) {
          case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
            v_CS_Id_RTP := GMK_MCVideo;
          }
          case (PRIVATE_CALL) {
            select (p_TestProcedure) {
              case (IPCAN_MT_VideoCall) { v_CS_Id_RTP := PCK_MCVideo_Receiver; }
              case (IPCAN_MO_VideoCall) { v_CS_Id_RTP := PCK_MCVideo_Initiator; }
              case else { FatalError(__FILE__, __LINE__, ""); }
            }
          }
          case (FIRST_TO_ANSWER) {
            select (p_TestProcedure) {
              case (IPCAN_MT_VideoCall) { v_CS_Id_RTP := PCK_MCVideo_Initiator; }
              case (IPCAN_MO_VideoCall) { v_CS_Id_RTP := PCK_MCVideo_Receiver; }
              case else { FatalError(__FILE__, __LINE__, ""); }
            }
          }
        }
      }
    }
    f_MCX_ConfigSRTP(p_ServiceType, v_CS_Id_RTP);   // shall not be done before PCK is stored
  }

  /*
   * @desc      Wrapper function
   * @param     p_ServiceType
   * @param     p_CallType
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_ConfigSRTP(MCX_ServiceType_Type p_ServiceType,
                                                  MCX_CallType_Type p_CallType) runs on MCX_IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure;
    select (p_ServiceType) {
      case (MCPTT)   { v_TestProcedure := IPCAN_MO_SpeechCall; }
      case (MCVideo) { v_TestProcedure := IPCAN_MO_VideoCall; }
    }
    f_MCPTT_MCVideo_CallSetup_ConfigSRTP(p_ServiceType, p_CallType, v_TestProcedure);
  }

  /*
   * @desc      Get SDP message from MessageBody, decode it and match it
   * @param     p_MessageBody
   * @param     p_SdpTemplate
   * @return    template (omit) SDP_Message
   * @status    APPROVED (MCX)
   */
  function f_MCX_SIP_MessageBody_DecodeMatchAndCheckSDP(MessageBody p_MessageBody,
                                                        template SDP_Message p_SdpTemplate) runs on IMS_PTC return template (omit) SDP_Message
  {
    var template (omit) SDP_Message v_SdpMessage := omit;

    select union (p_MessageBody) {
      case (sdpMessageBody) {
        v_SdpMessage := f_IMS_SIP_DecodeMatchAndCheckSDP(p_MessageBody.sdpMessageBody, p_SdpTemplate);          /* => FAIL if p_SdpTemplate=omit */
      }
      case (mimeMessageBody) {
        v_SdpMessage := f_MCX_MIME_DecodeMatchAndCheckSDP(p_MessageBody.mimeMessageBody, p_SdpTemplate);        /* => FAIL if v_SdpTemplate=omit */
      }
    }
    return v_SdpMessage;
  }

  /*
   * @desc      Decode, match and check SDP message
   * @param     p_ServiceType
   * @param     p_MessageBody
   * @param     p_SdpInfoRX
   * @return    template (omit) SDP_Message
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_DecodeMatchAndCheckSDP(MCX_ServiceType_Type p_ServiceType,
                                                  MessageBody p_MessageBody,
                                                  template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX) runs on MCX_IMS_PTC return template (omit) SDP_Message
  { /* p_SdpInfoRX  ..  omit if there shall be no SDP message */
    var template SDP_Message v_SdpTemplate := omit;
    var template (omit) SDP_Message v_SdpMessage;

    if (ispresent(p_SdpInfoRX)) {
      v_SdpTemplate := p_SdpInfoRX.SdpTemplate;
    }
    v_SdpMessage := f_MCX_SIP_MessageBody_DecodeMatchAndCheckSDP(p_MessageBody, v_SdpTemplate);                 /* => FAIL if v_SdpTemplate=omit and when there is an SDP in the message body */
    f_MCX_CheckSDP(p_ServiceType, v_SdpMessage, p_SdpInfoRX);
    
    return v_SdpMessage;
  }

  /*
   * @desc      Table 5.5.2.16.2.1-1: SIP 180 (Ringing) from the UE
   *            Table 5.5.2.16.3.1-1: SIP 183 (Session Progress) from the UE
   * @param     p_InviteRequest
   * @param     p_ServiceType
   * @param     p_StatusLine
   * @param     p_RequireReliable   (default value: false)
   * @return    template (present) IMS_Response_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_180_183_ResponseRX(INVITE_Request p_InviteRequest,
                                                          MCX_ServiceType_Type p_ServiceType,
                                                          StatusLine p_StatusLine,
                                                          boolean p_RequireReliable := false) runs on IMS_PTC return template (present) IMS_Response_Type
  {
    var MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (present) SemicolonParam_List v_MandatoryContactParams := f_MCX_SIP_CallControl_ContactParams_RX(p_ServiceType);    // @sic R5-220465: isfocus removed sic@
    var template (present) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderRX(v_MessageHeader_Invite);
    var integer v_Port_us := f_IMS_PTC_GetPort_us();

    if (p_RequireReliable) {   // NOTE: rSeq checked in a_IMS_ReceiveResponse
      v_MessageHeader_Response.require    := cr_Require(tsc_OptionTagList_100rel);
    }
    v_MessageHeader_Response.recordRoute  := f_IMS_RecordRoute_AsInInvite_RX(v_MessageHeader_Invite.recordRoute);
    v_MessageHeader_Response.contact      := cr_Contact(f_Contact_SipUri_HostPortRX(?, v_Port_us), v_MandatoryContactParams);    /* host address needs to be checked after receiving (-> a_IMS_ReceiveResponse) */
    v_MessageHeader_Response.supported    := cr_Supported(tsc_OptionTagList_norefersub);

    select (p_StatusLine.statusCode) {
      case (183) {
        v_MessageHeader_Response.pAnswerState := cr_PAnswerState("unconfirmed") ifpresent;
      }
    }
    return cr_Response(p_StatusLine, v_MessageHeader_Response);
  }

  /*
   * @desc      Send INVITE for MT Call setup or MT re-INVITE
   * @param     p_ServiceType
   * @param     p_CallType          (default value: ANY)
   * @param     p_CommencementMode  (default value: NONE)
   * @param     p_Replaces          (default value: omit)
   * @param     p_FeatureCaps       (default value: omit)
   * @param     p_SDP_Message       (default value: omit)
   * @param     p_XmlBodies         (default value: cs_MCX_MIME_XmlBodies_AllOmit)
   * @param     p_IsReInvite        (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteMT_SendINVITE(MCX_ServiceType_Type p_ServiceType,
                                               MCX_CallType_Type p_CallType := ANY,
                                               MCX_CommencementMode_Type p_CommencementMode := NONE,
                                               template (omit) Replaces p_Replaces := omit,
                                               template (omit) FeatureCaps p_FeatureCaps := omit,
                                               template (omit) SDP_Message p_SDP_Message := omit,
                                               template (value) MCX_MIME_XmlBodies_Type p_XmlBodies := cs_MCX_MIME_XmlBodies_AllOmit,
                                               boolean p_IsReInvite := false)
    runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  { // @sic R5w220111, R5-223945: global variable ContactUrlSS => p_Contact removed sic@
    var charstring v_SessionId := f_MCX_SessionId(p_ServiceType);
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) INVITE_Request v_InviteRequest;
    var template (value) MessageHeader v_MessageHeader_Invite;
    var template (omit) MessageBody v_MessageBody := omit;
    var template (omit) ContentType v_ContentType := omit;
    var IMS_TestProcedure_Type v_TestProcedure;
    var SipUrl v_RequestUrl;

    select (p_ServiceType) {
      case (MCPTT)   { v_TestProcedure := IPCAN_MT_SpeechCall; }                /* @sic R5s220559: IPCAN_MT_SpeechCall instead of IPCAN_MO_SpeechCall sic@ */
      case (MCVideo) { v_TestProcedure := IPCAN_MT_VideoCall; }
    }

    f_MCPTT_MCVideo_CallSetup_ConfigSRTP(p_ServiceType, p_CallType, v_TestProcedure);   /* @sic R5s211469: SRTP config independent from p_IsReInvite sic@  */

    if (not p_IsReInvite) {
      f_MCX_IMS_PTC_ImsInfo_SetContactUrlSS(v_SessionId, tsc_IMS_CallerPort);   /* @sic R5w220111, R5-223945: global variable ContactUrlSS sic@ */
      v_RequestUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE();                      /* SIP URI of the UE's contact address as provided in the Contact-header of the REGISTER message */
      f_MCX_IPCAN_StartSignalling(v_TestProcedure);
    } else {
      v_RequestUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);                /* SIP URI of the UE's contact address as provided in the Contact-header within any response or request within the dialog */
    }

    if (isvalue(p_XmlBodies.McpttInfo) or
        isvalue(p_XmlBodies.McvideoInfo) or
        isvalue(p_XmlBodies.McdataInfo) or
        isvalue(p_XmlBodies.McpttLocationInfo) or
        isvalue(p_XmlBodies.McvideoLocationInfo) or
        isvalue(p_XmlBodies.McdataLocationInfo)) {
      v_MessageBody := f_MCX_MIME_MessageBodyTX(p_ServiceType, -, p_SDP_Message, p_XmlBodies.McpttInfo, p_XmlBodies.McvideoInfo, p_XmlBodies.McdataInfo, p_XmlBodies.McpttLocationInfo, p_XmlBodies.McvideoLocationInfo, p_XmlBodies.McdataLocationInfo);
      v_ContentType := cs_ContentTypeMIME(tsc_MCX_MIME_Boundary);
    } else if (isvalue(p_SDP_Message)) {
      v_MessageBody := cs_MessageBody_SDP(valueof(p_SDP_Message));
      v_ContentType := cs_ContentTypeSDP;
    }

    v_MessageHeader_Invite := f_MCX_InviteRequest_MessageHeaderTX(p_ServiceType, p_CommencementMode, v_ContentType, p_IsReInvite);
    v_MessageHeader_Invite.replaces := p_Replaces;
    v_MessageHeader_Invite.featureCaps := p_FeatureCaps;
    v_InviteRequest := cs_INVITE_Request(v_RequestUrl, v_MessageHeader_Invite, v_MessageBody);
    v_InviteRequestWithSdp := f_IMS_InviteRequestWithSdpMT(v_InviteRequest, p_SDP_Message);
    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequest));

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      MCPTT/MCVideo specific wrapper function to receive 200 OK for INVITE or UPDATE
   * @param     p_ServiceType
   * @param     p_CallType          (default value: ANY)
   * @param     p_MessageHeaderRequest
   * @param     p_InternetProtocol
   * @param     p_AllowTrying       (default value: false)
   * @param     p_EstabModType      (default value: CALL_ESTAB_MOD)
   * @param     p_SdpInfoRX         (default value: omit)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteUpdateMT_Receive200OK(MCX_ServiceType_Type p_ServiceType,
                                                       MCX_CallType_Type p_CallType := ANY,
                                                       template (value) MessageHeader p_MessageHeaderRequest,
                                                       InternetProtocol_Type p_InternetProtocol,
                                                       boolean p_AllowTrying := false,
                                                       MCX_SIP_EstabMod_Type p_EstabModType := CALL_ESTAB_MOD,
                                                       template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX := omit,
                                                       template MCPTT_Info_Type p_McpttInfo := omit,
                                                       template MCVideo_Info_Type p_McvideoInfo := omit) runs on MCX_IMS_PTC
  {
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var template SDP_Message v_SdpTemplate := omit;

    if (ispresent(p_SdpInfoRX)) {
      v_SdpTemplate := p_SdpInfoRX.SdpTemplate;
    }

    // receive 200 OK
    v_ResponseWithSdp := f_MCX_InviteUpdateMT_Receive200OK(p_ServiceType, p_CallType, p_MessageHeaderRequest, p_InternetProtocol, p_AllowTrying, p_EstabModType, v_SdpTemplate, p_McpttInfo, p_McvideoInfo);
    f_MCX_CheckSDP(p_ServiceType, v_ResponseWithSdp.SdpMessage, p_SdpInfoRX);
  }

  /*
   * @desc      Receive 200 OK, send ACK
   * @param     p_ServiceType
   * @param     p_CallType          (default value: ANY)
   * @param     p_InviteRequestWithSdp
   * @param     p_AllowTrying       (default value: true)
   * @param     p_EstabModType      (default value: CALL_ESTAB_MOD)
   * @param     p_SdpInfoRX         (default value: omit)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteMT_Receive200OK_SendACK(MCX_ServiceType_Type p_ServiceType,
                                                         MCX_CallType_Type p_CallType := ANY,
                                                         IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                         boolean p_AllowTrying := true,
                                                         MCX_SIP_EstabMod_Type p_EstabModType := CALL_ESTAB_MOD,
                                                         template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX := omit,
                                                         template MCPTT_Info_Type p_McpttInfo := omit,
                                                         template MCVideo_Info_Type p_McvideoInfo := omit) runs on MCX_IMS_PTC
  { /* p_AllowTrying is needed to distinguish call establishment (or re-INVITE) with trying only from call establishment with SIP 180/183 response */
    /* @sic R5-210214: P-Answer-State in Table 5.5.2.17.1.1-1 for GROUP-CALL => p_CallType := ANY sic@ */

    // receive 200 OK
    f_MCPTT_MCVideo_InviteUpdateMT_Receive200OK(p_ServiceType, p_CallType, p_InviteRequestWithSdp.Invite.msgHeader, p_InviteRequestWithSdp.RoutingInfo.Protocol, p_AllowTrying, p_EstabModType, p_SdpInfoRX, p_McpttInfo, p_McvideoInfo);

    // send ACK
    f_IMS_InviteMT_SendACK(p_InviteRequestWithSdp);
  }

  /*
   * @desc      Initialise XML bodies to be sent to the client in an MT INVITE
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @return    template (value) MCX_MIME_XmlBodies_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteMT_XmlBodies_Init(MCX_ServiceType_Type p_ServiceType,
                                                   MCX_CallType_Type p_CallType,
                                                   MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL) return template (value) MCX_MIME_XmlBodies_Type
  {
    var template (value) MCX_MIME_XmlBodies_Type v_XmlBodies := cs_MCX_MIME_XmlBodies_AllOmit;

    select (p_ServiceType) {
      case (MCPTT)   { v_XmlBodies.McpttInfo := f_MCX_CallControl_MCPTTInfo_TX(p_CallType, p_PriorityCallType); }
      case (MCVideo) { v_XmlBodies.McvideoInfo := f_MCX_CallControl_MCVideoInfo_TX(p_CallType, p_PriorityCallType); }
    }
    
    return v_XmlBodies;
  }

  /*
   * @desc      Send INVITE for MT call setup
   * @param     p_ServiceType
   * @param     p_SessionType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: AUTOMATIC)
   * @param     p_MediaControlCondition (default value: withoutImplictGrantRequest)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_PrivateCallWithoutEndToEndSecurity (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_SendINVITE(MCX_ServiceType_Type p_ServiceType,
                                                  MCX_SessionType_Type p_SessionType,
                                                  MCX_CallType_Type p_CallType,
                                                  MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                  MCX_CommencementMode_Type p_CommencementMode := AUTOMATIC,   // "Auto" per default in Table 5.5.2.5.2-1
                                                  MCX_MediaControlCondition_Type p_MediaControlCondition := withoutImplictGrantRequest,
                                                  boolean p_IsReInvite := false,
                                                  boolean p_PrivateCallWithoutEndToEndSecurity := false)
    runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var template (value) MCX_MIME_XmlBodies_Type v_XmlBodies := f_MCPTT_MCVideo_InviteMT_XmlBodies_Init(p_ServiceType, p_CallType, p_PriorityCallType);
    var template (value) SDP_Message v_SDP_Message := f_MCX_SdpOffer_TX(p_ServiceType, p_SessionType, p_CallType, -, -, p_MediaControlCondition, -, p_PrivateCallWithoutEndToEndSecurity);

    return f_MCPTT_MCVideo_InviteMT_SendINVITE(p_ServiceType, p_CallType, p_CommencementMode, -, -, v_SDP_Message, v_XmlBodies, p_IsReInvite);
  }

  /*
   * @desc      MT Call: send PRACK, receive 200 OK
   * @param     p_InviteRequest
   * @param     p_MessageHeader_PrevReliableResponse
   * @return    template (omit) IMS_Response_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_MCVideo_CallSetupMT_SendPRACK_ReceiveOK(template (value) INVITE_Request p_InviteRequest,
                                                            MessageHeader p_MessageHeader_PrevReliableResponse) runs on IMS_PTC return template (omit) IMS_Response_Type
  {
    var template (value) MessageHeader v_MessageHeader_Prack := f_IMS_PrackRequest_MessageHeaderTX(p_InviteRequest, p_MessageHeader_PrevReliableResponse);
    var template (present) MessageHeader v_MessageHeader_200OK := f_MCX_CommonResponse_200_MessageHeaderRX(v_MessageHeader_Prack);

    return f_IMS_MTCallSetup_SendPRACK_ReceiveOK_Common(p_InviteRequest, v_MessageHeader_Prack, v_MessageHeader_200OK);
  }

  /*
   * @desc      MT Call: receive 180 Ringing or 183 Session Progress
   * @param     p_ServiceType
   * @param     p_InviteRequestWithSdp
   * @param     p_StatusLineResponse
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_Receive18xResponse(MCX_ServiceType_Type p_ServiceType,
                                                          IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                          StatusLine p_StatusLineResponse) runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest := p_InviteRequestWithSdp.Invite;
    var InternetProtocol_Type v_InternetProtocol := p_InviteRequestWithSdp.RoutingInfo.Protocol;
    var template (present) IMS_Response_Type v_Response := f_MCPTT_MCVideo_CallSetupMT_180_183_ResponseRX(v_InviteRequest, p_ServiceType, p_StatusLineResponse);
    var template (omit) IMS_DATA_RSP v_IMS_DATA_RSP;
    var MessageHeader v_MessageHeader;
    
    timer t_Timer := 5.0;

    if (p_StatusLineResponse.statusCode == 183) {     // 183 Session Progress is optional
      t_Timer.start;
    }
    v_IMS_DATA_RSP := f_IMS_ReceiveResponse_OptionalTrying_Timeout(t_Timer, v_InviteRequest.msgHeader, v_InternetProtocol, v_Response);
    t_Timer.stop;
    
    if (isvalue(v_IMS_DATA_RSP)) {
      v_MessageHeader := valueof(v_IMS_DATA_RSP.Response.msgHeader);

      f_IMS_Dialog_CompleteCreationForMTCall(v_MessageHeader);

      if (f_MessageHeader_CheckRequire(v_MessageHeader, c_tag100rel)) {
        fl_MCPTT_MCVideo_CallSetupMT_SendPRACK_ReceiveOK(v_InviteRequest, v_MessageHeader);
      }
    }
  }

  /*
   * @desc      Common function to receive 200 OK for call setup or session modification
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_InviteRequestWithSdp
   * @param     p_AllowTrying       (default value: false)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK(MCX_ServiceType_Type p_ServiceType,
                                                          MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                          MCX_CallType_Type p_CallType,
                                                          MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                          IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                          boolean p_AllowTrying := false) runs on MCX_IMS_PTC
  {
    var template MCPTT_Info_Type v_McpttInfo := omit;
    var template MCVideo_Info_Type v_McvideoInfo := omit;
    var MCX_MediaControlCondition_Type v_MediaControlCondition;
    var template MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX := omit;
    var template (omit) boolean v_EndToEndSecurity := omit;

    select (p_ServiceType) {    /* According to the default message content in 36.579-1 Table 5.5.2.17.1.1-1 the 200 OK from the UE shall have mcptt/mcvideo-info for condition INVITE-RSP, which is in line with 24.379 Table H.2.1 */
      case (MCPTT)   { v_McpttInfo := f_MCX_CallControl_MCPTTInfo_RX(p_CallType, INVITE_RSP, p_PriorityCallType); }          // @sic R5-213654: INVITE_RSP sic@
      case (MCVideo) { v_McvideoInfo := f_MCX_CallControl_MCVideoInfo_RX(p_CallType, INVITE_RSP, p_PriorityCallType); }
    }

    if (isvalue(p_InviteRequestWithSdp.SdpOffer)) {
      if (isvalue(f_MCX_SDP_GetMediaDescription_MediaControl(p_InviteRequestWithSdp.SdpOffer))) {
        v_MediaControlCondition := withoutImplictGrantRequest;
      } else {
        select (p_ServiceType) {
          case (MCPTT)   { v_MediaControlCondition := withoutFloorControl; }
          case (MCVideo) { v_MediaControlCondition := withoutTransmissionControl; }
        }
      }
      if (p_CallType == FIRST_TO_ANSWER) {
        v_EndToEndSecurity := true;
      }
      v_SdpInfoRX := f_MCX_SdpInfo_RX(p_ServiceType, p_SessionType, p_CallType, SDP_ANSWER, v_MediaControlCondition, -, -, v_EndToEndSecurity);
    }
    // receive 200 OK
    f_MCPTT_MCVideo_InviteUpdateMT_Receive200OK(p_ServiceType, p_CallType, p_InviteRequestWithSdp.Invite.msgHeader, p_InviteRequestWithSdp.RoutingInfo.Protocol, p_AllowTrying, -, v_SdpInfoRX, v_McpttInfo, v_McvideoInfo);
  }

  /*
   * @desc      Common function to receive 200 OK, send ACK for call setup or session modification
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_InviteRequestWithSdp
   * @param     p_AllowTrying       (default value: false)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK_SendACK(MCX_ServiceType_Type p_ServiceType,
                                                                  MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                                  MCX_CallType_Type p_CallType,
                                                                  MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                  IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                                  boolean p_AllowTrying := false) runs on MCX_IMS_PTC
  {
    // receive 200 OK
    f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, p_InviteRequestWithSdp, p_AllowTrying);

    // send ACK
    f_IMS_InviteMT_SendACK(p_InviteRequestWithSdp);
  }

  /*
   * @desc      36.579-1 Table 5.3.4.3-1: MCX CT session establishment without provisional responses other than 100 Trying
   *            Applicable for MCPTT/MCVideo CT group call establishment, automatic commencement and MCPTT/MCVideo CT private call establishment, automatic commencement
   *            In general the function cannot be used for re-INVITE, as different message bodies may be needed
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: AUTOMATIC)
   * @param     p_MediaControlCondition (default value: withoutImplictGrantRequest)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCX_ServiceType_Type p_ServiceType,
                                                     MCX_CallType_Type p_CallType,
                                                     MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                     MCX_CommencementMode_Type p_CommencementMode := AUTOMATIC,
                                                     MCX_MediaControlCondition_Type p_MediaControlCondition := withoutImplictGrantRequest)
    runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var boolean v_AllowTrying := true;

    // Step 1a1, 2: send INVITE
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMT_SendINVITE(p_ServiceType, ON_DEMAND, p_CallType, p_PriorityCallType, p_CommencementMode, p_MediaControlCondition);

    // Step 3a1 - 5: receive 100 Trying (optional), 200 OK, send ACK
    f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK_SendACK(p_ServiceType, ON_DEMAND, p_CallType, p_PriorityCallType, v_InviteRequestWithSdp, v_AllowTrying);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "200 OK");

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      36.579-1 Table 5.3.5.3-1: MCX CT group call establishment, manual commencement
   *            36.579-1 Table 5.3.6.3-1: MCX CT private call establishment, manual commencement
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: MANUAL)
   * @param     p_MediaControlCondition (default value: withoutImplictGrantRequest)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_PrivateCallWithoutEndToEndSecurity (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_Manual_SendINVITE_Receive18xResponse(MCX_ServiceType_Type p_ServiceType,
                                                                            MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                                            MCX_CallType_Type p_CallType,
                                                                            MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                            MCX_CommencementMode_Type p_CommencementMode := MANUAL,
                                                                            MCX_MediaControlCondition_Type p_MediaControlCondition := withoutImplictGrantRequest,
                                                                            boolean p_IsReInvite := false,
                                                                            boolean p_PrivateCallWithoutEndToEndSecurity := false) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var StatusLine v_StatusLine;

    // Step 1a1/1b1, 2: RRC connection setup, send INVITE
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMT_SendINVITE(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, p_CommencementMode, p_MediaControlCondition, p_IsReInvite, p_PrivateCallWithoutEndToEndSecurity);

    select (p_CallType) {
      case (GROUP_CALL)                     { v_StatusLine := c_statusLine183; }
      case (PRIVATE_CALL, FIRST_TO_ANSWER)  { v_StatusLine := c_statusLine180; }
      case else                             { FatalError(__FILE__, __LINE__, ""); }
    }

    // Table 5.3.5.3-1: Step 3a1 - 5c1: receive 100 Trying (optional), 183 Session Progress (optional) or
    // Table 5.3.6.3-1: Step 3a1 - 4b3: receive 100 Trying (optional), 180 Ringing (mandatory)
    f_MCPTT_MCVideo_CallSetupMT_Receive18xResponse(p_ServiceType, v_InviteRequestWithSdp, v_StatusLine);
    if (v_StatusLine.statusCode == 180) {
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "180 Ringing");
    }

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      MT Call - manual commencement mode: Answer call, receive 200 OK, send ACK
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_Manual_CheckAnswerCall_Receive200OK_SendACK(MCX_ServiceType_Type p_ServiceType,
                                                                                   MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                                                   MCX_CallType_Type p_CallType,
                                                                                   MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                                   IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on MCX_IMS_PTC
  {
    // Table 5.3.5.3-1: Step 5A or
    // Table 5.3.6.3-1: Step 4A
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCX client) notify the user of the incoming call?", "");

    // Table 5.3.5.3-1: Step 6 or
    // Table 5.3.6.3-1: Step 5
    f_UT_AnswerCall(MMI);

    // Table 5.3.5.3-1: Step 7 - 8 or
    // Table 5.3.6.3-1: Step 6 - 7
    f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK_SendACK(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, p_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "200 OK");
  }

  /*
   * @desc      36.579-1 Table 5.3.5.3-1: MCX CT group call establishment, manual commencement
   *            36.579-1 Table 5.3.6.3-1: MCX CT private call establishment, manual commencement
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: MANUAL)
   * @param     p_MediaControlCondition (default value: withoutImplictGrantRequest)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_PrivateCallWithoutEndToEndSecurity (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMT_Manual(MCX_ServiceType_Type p_ServiceType,
                                              MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                              MCX_CallType_Type p_CallType,
                                              MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                              MCX_CommencementMode_Type p_CommencementMode := MANUAL,
                                              MCX_MediaControlCondition_Type p_MediaControlCondition := withoutImplictGrantRequest,
                                              boolean p_IsReInvite := false,
                                              boolean p_PrivateCallWithoutEndToEndSecurity := false) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    // Step 1a1/1b1 - 6/5: RRC connection setup, send INVITE, receive 100 Trying (optional), 183 Session Progress (optional) or 180 Ringing (mandatory
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMT_Manual_SendINVITE_Receive18xResponse(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, p_CommencementMode, p_MediaControlCondition, p_IsReInvite, p_PrivateCallWithoutEndToEndSecurity);

    // Table 5.3.5.3-1: Step 5A - 8 or
    // Table 5.3.6.3-1: Step 4A - 7
    f_MCPTT_MCVideo_CallSetupMT_Manual_CheckAnswerCall_Receive200OK_SendACK(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, v_InviteRequestWithSdp);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      36.579-1 Table 5.3.4.3-1: MCX CT session modification without provisional responses other than 100 Trying
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_SdpOffer          (default value: omit)
   * @param     p_XmlBodies         (default value: cs_MCX_MIME_XmlBodies_AllOmit)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_ReInviteMT(MCX_ServiceType_Type p_ServiceType,
                                      MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                      MCX_CallType_Type p_CallType,
                                      MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                      template (omit) SDP_Message p_SdpOffer := omit,
                                      template (value) MCX_MIME_XmlBodies_Type p_XmlBodies := cs_MCX_MIME_XmlBodies_AllOmit)
    runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var boolean v_AllowTrying := true;

    // Step 2: send INVITE
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_InviteMT_SendINVITE(p_ServiceType, p_CallType, -, -, -, p_SdpOffer, p_XmlBodies, tsc_MCX_ReInvite);

    // Step 3a1 - 5: receive 100 Trying (optional), 200 OK, send ACK
    f_MCPTT_MCVideo_CallSetupModifyMT_Receive200OK_SendACK(p_ServiceType, p_SessionType, p_CallType, p_PriorityCallType, v_InviteRequestWithSdp, v_AllowTrying);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "200 OK");

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Initialise the XML bodies for an MO Call
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @return    template (present) MCX_MIME_XmlBodies_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(MCX_ServiceType_Type p_ServiceType,
                                                   MCX_CallType_Type p_CallType,
                                                   MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL) runs on MCX_IMS_PTC return template (present) MCX_MIME_XmlBodies_Type
  {
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies := cs_MCX_MIME_XmlBodies_AllOmit;
    var charstring v_MCServiceId_UserB := f_MCX_MCService_ID_User_B(p_ServiceType);
    var charstring v_MCServiceId_UserC := f_MCX_MCService_ID_User_C(p_ServiceType);

    select (p_ServiceType) {
      case (MCPTT)   { v_XmlBodies.McpttInfo := f_MCX_CallControl_MCPTTInfo_RX(p_CallType, INVITE_REFER, p_PriorityCallType); }
      case (MCVideo) { v_XmlBodies.McvideoInfo := f_MCX_CallControl_MCVideoInfo_RX(p_CallType, INVITE_REFER, p_PriorityCallType); }
    }

    select (p_CallType) {
      case (PRIVATE_CALL) {
        v_XmlBodies.ResourceLists := cr_MCX_ResourceLists_ANYCALL(v_MCServiceId_UserB);                         /* according to 36.579-1 Table 5.5.2.5.1-1 */
      }
      case (FIRST_TO_ANSWER) {
        v_XmlBodies.ResourceLists := cr_MCX_ResourceLists(cr_MCX_ResourceLists_SequenceList_FIRST_TO_ANSWER(v_MCServiceId_UserB, v_MCServiceId_UserC));
      }
    }
    select (p_PriorityCallType) {
      case (EMERGENCY_CALL) {
        select (p_ServiceType) {
          case (MCPTT)   { v_XmlBodies.McpttLocationInfo := cr_MCPTT_LocationInfo_Report ifpresent; }           /* according to 36.579-1 Table 5.5.2.5.1-1, further check in f_MCPTT_MCVideo_InviteMO_ReceiveINVITE */
          case (MCVideo) { v_XmlBodies.McvideoLocationInfo := cr_MCVideo_LocationInfo_Report ifpresent; }       /* according to 36.579-1 Table 5.5.2.5.1-1, further check in f_MCPTT_MCVideo_InviteMO_ReceiveINVITE */
        }
      }
    }
    return v_XmlBodies;
  }

  /*
   * @desc      generic function to receive INVITE in case of call establishment or re-INVITE
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: AUTOMATIC)
   * @param     p_SdpInfoRX
   * @param     p_XmlBodies
   * @param     p_IsReInvite        (default value: false)
   * @return    MCX_InviteRequestWithSdpAndXml_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_InviteMO_ReceiveINVITE(MCX_ServiceType_Type p_ServiceType,
                                                  MCX_CallType_Type p_CallType,
                                                  MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                  MCX_CommencementMode_Type p_CommencementMode := AUTOMATIC,
                                                  template (present) MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX,
                                                  template (present) MCX_MIME_XmlBodies_Type p_XmlBodies,
                                                  boolean p_IsReInvite := false)
    runs on MCX_IMS_PTC return MCX_InviteRequestWithSdpAndXml_Type
  {
    var charstring v_SessionId;
    var charstring v_PublicServiceId;
    var template (present) SipUrl v_RequestUri;
    var template (present) MessageHeader v_MessageHeader_Invite;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MessageBody v_MessageBody;
    var MIME_Message v_MIME_Message;
    var SDP_Message v_SDP_Message;
    var MCX_MIME_XmlBodies_Type v_XmlBodies;
    var boolean v_AlertInd;
    var boolean v_LocationInfoIsPresent;

    if (not p_IsReInvite) {                                     /* @sic R5w220111, R5-223945: SessionId different from PSI sic@ */
      v_SessionId := f_MCX_SessionId(p_ServiceType);
      if (p_CallType == GROUP_REJOIN) {                         /* @sic R5-241595: GROUP_REJOIN (MCVideo test case 6.1.1.14) sic@ */
        v_RequestUri := f_SIP_BuildSipUri_RX(v_SessionId);
      } else {
        v_PublicServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
        v_RequestUri := f_SIP_BuildSipUri_RX(v_PublicServiceId);
      }
      f_MCX_IMS_PTC_ImsInfo_SetContactUrlSS(v_SessionId);       /* @sic R5w220111, R5-223945: global variable ContactUrlSS sic@ */
    } else {
      v_RequestUri := f_IMS_PTC_ImsInfo_GetContactUrlSS();
    }
    v_MessageHeader_Invite := f_MCX_InviteRequest_MessageHeaderRX(p_ServiceType, -, p_PriorityCallType, p_CommencementMode, v_RequestUri, p_IsReInvite);
    v_IMS_DATA_REQ := valueof(f_MCX_InviteMO_ReceiveRequest_Optional(v_RequestUri, v_MessageHeader_Invite, cr_MessageBody_MIME, -, p_IsReInvite));
    v_MessageBody := v_IMS_DATA_REQ.Request.Invite.messageBody;
    v_MIME_Message := v_MessageBody.mimeMessageBody;
    v_SDP_Message := valueof(f_MCPTT_MCVideo_DecodeMatchAndCheckSDP(p_ServiceType, v_MessageBody, p_SdpInfoRX));

    f_MCPTT_MCVideo_CallSetupMO_ConfigSRTP(p_ServiceType, p_CallType);  /* @sic R5s211469: SRTP config independent from p_IsReInvite sic@ */

    if (not p_IsReInvite) {
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);                          /* trigger IPCAN to continue with activation of dedicated EPS bearer */
    }
    v_XmlBodies := f_MCX_MIME_DecodeAndMatchXML(v_MIME_Message,
                                                p_ServiceType,
                                                -,
                                                p_XmlBodies.McpttInfo,
                                                p_XmlBodies.McpttInfoExt,
                                                p_XmlBodies.McvideoInfo,
                                                p_XmlBodies.McvideoInfoExt,
                                                -,
                                                -,
                                                p_XmlBodies.McpttLocationInfo,
                                                p_XmlBodies.McvideoLocationInfo,
                                                -,
                                                p_XmlBodies.ResourceLists);
    if (p_PriorityCallType == EMERGENCY_CALL) {     // the UE may set alert-ind:=true in which case it shall include location info
      select (p_ServiceType) {
        case (MCPTT) {
          v_AlertInd := isvalue(v_XmlBodies.McpttInfo.mcptt_Params.alert_ind) and match(v_XmlBodies.McpttInfo.mcptt_Params.alert_ind, cr_MCPTT_Content_True);
          v_LocationInfoIsPresent := isvalue(v_XmlBodies.McpttLocationInfo);
        }
        case (MCVideo) {
          v_AlertInd := isvalue(v_XmlBodies.McvideoInfo.mcvideo_Params.alert_ind) and match(v_XmlBodies.McvideoInfo.mcvideo_Params.alert_ind, cr_MCVideo_Content_True);
          v_LocationInfoIsPresent := isvalue(v_XmlBodies.McvideoLocationInfo);
        }
      }
      if (v_AlertInd and not v_LocationInfoIsPresent) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "alert-ind==true in mcptt/mcvideo-info but mcptt/mcvideo-location-info is not present");
      } else if (not v_AlertInd and v_LocationInfoIsPresent) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "alert-ind==false in mcptt/mcvideo-info but mcptt/mcvideo-location-info is present");
      }
    }

    return fl_MCX_InviteRequestWithSdpAndXmlMO(v_IMS_DATA_REQ, v_SDP_Message, v_XmlBodies);
  }

  /*
   * @desc      Initiate MO Call
   * @param     p_ServiceType
   * @param     p_MMI_String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_InitiateCall(MCX_ServiceType_Type p_ServiceType,
                                                    charstring p_MMI_String) runs on IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure;

    select (p_ServiceType) {
      case (MCPTT)      { v_TestProcedure := IPCAN_MO_SpeechCall; }
      case (MCVideo)    { v_TestProcedure := IPCAN_MO_VideoCall; }
    }
    f_MCX_IPCAN_StartSignalling(v_TestProcedure);
    f_UT_MCX_UserAction(MMI, p_MMI_String);
  }

  /*
   * @desc      receive INVITE and send 100 Trying at the beginning of the MO call establishment
   *            NOTE: in general this function cannot be used for re-INVITE procedure, as for re-INVITE different message bodies are needed
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: AUTOMATIC)
   * @param     p_MediaControlCondition (default value: withoutImplictGrantRequest)
   * @param     p_FunctionalAliasURI    (default value: omit)
   * @return    MCX_InviteRequestWithSdpAndXml_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_ReceiveINVITE_Send100Trying(MCX_ServiceType_Type p_ServiceType,
                                                                   MCX_CallType_Type p_CallType,
                                                                   MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                   MCX_CommencementMode_Type p_CommencementMode := AUTOMATIC,
                                                                   MCX_MediaControlCondition_Type p_MediaControlCondition := withoutImplictGrantRequest,
                                                                   template (omit) XSD.AnyURI p_FunctionalAliasURI := omit) runs on MCX_IMS_PTC return MCX_InviteRequestWithSdpAndXml_Type
  {
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX := f_MCX_SdpInfo_RX(p_ServiceType, ON_DEMAND, p_CallType, SDP_OFFER, p_MediaControlCondition);
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies := f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(p_ServiceType, p_CallType, p_PriorityCallType);
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;

    if (isvalue(p_FunctionalAliasURI)) {
      select (p_ServiceType) {
        case (MCPTT)   { v_XmlBodies.McpttInfoExt := { cr_McpttInfoExt_FunctionalAliasURI(valueof(p_FunctionalAliasURI)) }; }
        case (MCVideo) { FatalError(__FILE__, __LINE__, "Functional alias not supoorted for MCVideo"); }
      }
    }
    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_InviteMO_ReceiveINVITE(p_ServiceType, p_CallType, p_PriorityCallType, p_CommencementMode, v_SdpInfoRX, v_XmlBodies);
    f_MCX_InviteMO_Send100Trying(v_InviteRequestWithSdpAndXml.InviteRequestWithSdp);
    
    return v_InviteRequestWithSdpAndXml;
  }

  /*
   * @desc      Send 180 Ringing (or 183 session progress in case of first-to-answer call) MO call establishment during call
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_InviteRequestWithSdp
   * @param     p_StatusLine
   * @param     p_PrackRequired     (default value: false)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_Send18xResponse(MCX_ServiceType_Type p_ServiceType,
                                                       MCX_CallType_Type p_CallType,
                                                       IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                       StatusLine p_StatusLine,
                                                       boolean p_PrackRequired := false) runs on IMS_PTC
  {
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(p_InviteRequestWithSdp.RoutingInfo);
    var INVITE_Request v_InviteRequest := p_InviteRequestWithSdp.Invite;
    var template (value) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderTX(v_InviteRequest.msgHeader);
    var template (value) RouteBody_List v_RouteBodyList := f_IMS_RouteSet_MO_Call_TX();
    var charstring v_AssertedServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
    var integer v_RSeqNum := tsc_IMS_RSeqNumFor183;

    if (p_CallType != FIRST_TO_ANSWER) {
      v_MessageHeader_Response.contact        := f_MCX_CallSetup_ContactSS(p_ServiceType);
    }
    v_MessageHeader_Response.recordRoute      := cs_RecordRoute(v_RouteBodyList);

    select (p_StatusLine.statusCode) {
      case (183) {
        v_MessageHeader_Response.supported    := cs_Supported(tsc_OptionTagList_norefersub);
        v_MessageHeader_Response.pAnswerState := cs_PAnswerState("unconfirmed");
        v_MessageHeader_Response.pAssertedID  := cs_PAssertedId(f_SIP_BuildSipUri_TX(v_AssertedServiceId));     // @sic R5s220869 Change 7: f_SIP_BuildSipUri_TX instead of f_SIP_BuildSipUri_lr_TX sic@
      }
      case (180) {
        v_RSeqNum := v_RSeqNum + 1;                             /* if there has been a 183 response before => RSeqNum needs to be incremented;
                                                                   else: no 183 response before => abritrary value */
        v_MessageHeader_Response.supported    := cs_Supported(tsc_OptionTagList_norefersub);
      }
    }
  
    if (p_PrackRequired) {
      v_MessageHeader_Response.require        := cs_Require(tsc_OptionTagList_100rel);
      v_MessageHeader_Response.rSeq           := cs_RSeq(tsc_IMS_RSeqNumFor183);
    }
    
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(p_StatusLine, v_MessageHeader_Response)));

    if (p_PrackRequired) {
      FatalError(__FILE__, __LINE__, "not implemented yet");
    }
  }

  /*
   * @desc      send 200 OK and wait for ACK at the end of the MO call establishment
   *            NOTE: in general this function cannot be used for re-INVITE procedure, as for re-INVITE different message bodies are needed
   * @param     p_ServiceType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_InviteRequestWithSdp
   * @param     p_MediaControlCondition (default value: implicitRequestNoted)
   * @param     p_EncodedMikeyMsg   (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(MCX_ServiceType_Type p_ServiceType,
                                                            MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                            IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                            MCX_MediaControlConditionSdpAnswer_Type p_MediaControlCondition := implicitRequestNoted,
                                                            template (omit) bitstring p_EncodedMikeyMsg := omit) runs on IMS_PTC
  { // @sic R5w220111, R5-223945: global variable ContactUrlSS => p_SessionId removed sic@
    var INVITE_Request v_InviteRequest := p_InviteRequestWithSdp.Invite;
    var SDP_Message v_SDP_Offer := p_InviteRequestWithSdp.SdpOffer;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(p_InviteRequestWithSdp.RoutingInfo);
    var template (value) SDP_Message v_SDP_Answer := f_MCX_SdpAnswer_TX(p_ServiceType, p_SessionType, v_SDP_Offer, p_MediaControlCondition, p_EncodedMikeyMsg);

    f_MCX_InviteMO_Send200OK(p_ServiceType, v_InviteRequest.msgHeader, v_RoutingInfo_DL, v_SDP_Answer);
    f_MCX_InviteMO_ReceiveACK(v_InviteRequest);
  }

  /*
   * @desc      36.579-1 Table 5.3A.1.3-1: MCPTT CO session establishment/modification without provisional responses other than 100 Trying
   *            36.579-1 Table 5.3B.1.3-1: MCVideo CO session establishment/modification without provisional responses other than 100 Trying
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType
   * @param     p_CommencementMode
   * @param     p_MediaControlConditionSdpOffer
   * @param     p_MediaControlConditionSdpAnswer
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_100TryingOnly(MCX_ServiceType_Type p_ServiceType,
                                                     MCX_CallType_Type p_CallType,
                                                     MCX_PriorityCallType_Type p_PriorityCallType,
                                                     MCX_CommencementMode_Type p_CommencementMode,
                                                     MCX_MediaControlCondition_Type p_MediaControlConditionSdpOffer,
                                                     MCX_MediaControlConditionSdpAnswer_Type p_MediaControlConditionSdpAnswer) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_CallSetupMO_ReceiveINVITE_Send100Trying(p_ServiceType, p_CallType, p_PriorityCallType, p_CommencementMode, p_MediaControlConditionSdpOffer);
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "INVITE");

    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(p_ServiceType, ON_DEMAND, v_InviteRequestWithSdp, p_MediaControlConditionSdpAnswer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "ACK");

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      MO re-invite
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_MediaControlConditionSdpOffer (default value: withoutImplictGrantRequest)
   * @param     p_MediaControlConditionSdpAnswer (default value: implicitRequestNoted)
   * @param     p_XmlBodies
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_ReInviteMO(MCX_ServiceType_Type p_ServiceType,
                                      MCX_CallType_Type p_CallType,
                                      MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                      MCX_MediaControlCondition_Type p_MediaControlConditionSdpOffer := withoutImplictGrantRequest,
                                      MCX_MediaControlConditionSdpAnswer_Type p_MediaControlConditionSdpAnswer := implicitRequestNoted,
                                      template (present) MCX_MIME_XmlBodies_Type p_XmlBodies)
    runs on MCX_IMS_PTC
  {
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX := f_MCX_SdpInfo_RX(p_ServiceType, ON_DEMAND, p_CallType, SDP_OFFER, p_MediaControlConditionSdpOffer);
    var MCX_CommencementMode_Type v_CommencementMode := NONE;     /* @sic R5s211359 - additional change: There shall be no Answer-Mode in a re-INVITE sic@ */

    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_InviteMO_ReceiveINVITE(p_ServiceType, p_CallType, p_PriorityCallType, v_CommencementMode, v_SdpInfoRX, p_XmlBodies, tsc_MCX_ReInvite);
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "re-INVITE");

    f_MCX_InviteMO_Send100Trying(v_InviteRequestWithSdp);
    
    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(p_ServiceType, ON_DEMAND, v_InviteRequestWithSdp, p_MediaControlConditionSdpAnswer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "ACK");
  }

  /*
   * @desc      36.579-1 clause 5.3A.6 and 5.3B.11: CO session modification without implicit Floor Control
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallTypeToBeDowngraded
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCX_ServiceType_Type p_ServiceType,
                                                           MCX_CallType_Type p_CallType,
                                                           MCX_PriorityCallType_Type p_PriorityCallTypeToBeDowngraded) runs on MCX_IMS_PTC
  {
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies := f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(p_ServiceType, p_CallType, NORMAL_CALL);

    select (p_PriorityCallTypeToBeDowngraded) {
      case (EMERGENCY_CALL) {
        select (p_ServiceType) {
          case (MCPTT)   { v_XmlBodies.McpttInfo.mcptt_Params.emergency_ind := cr_MCPTT_Content_Boolean(false); }
          case (MCVideo) { v_XmlBodies.McvideoInfo.mcvideo_Params.emergency_ind := cr_MCVideo_Content_Boolean(false); }
        }
      }
      case (IMMPERIL_CALL) {
        select (p_ServiceType) {
          case (MCPTT)   { v_XmlBodies.McpttInfo.mcptt_Params.imminentperil_ind := cr_MCPTT_Content_Boolean(false); }
          case (MCVideo) { v_XmlBodies.McvideoInfo.mcvideo_Params.imminentperil_ind := cr_MCVideo_Content_Boolean(false); }
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "");
      }
    }

    f_MCPTT_MCVideo_ReInviteMO(p_ServiceType, p_CallType, -, -, -, v_XmlBodies);
  }

  /*
   * @desc      36.579-1 Table 5.3.35.3-1: MCX CO private call establishment with manual commencement
   * @param     p_ServiceType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_CallSetupMO_PrivateManual(MCX_ServiceType_Type p_ServiceType,
                                                     MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MCX_CallType_Type v_CallType := PRIVATE_CALL;

    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_CallSetupMO_ReceiveINVITE_Send100Trying(p_ServiceType, v_CallType, p_PriorityCallType, MANUAL, withoutFloorControl);
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "INVITE");

    f_MCPTT_MCVideo_CallSetupMO_Send18xResponse(MCPTT, v_CallType, v_InviteRequestWithSdp, c_statusLine180);

    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(p_ServiceType, ON_DEMAND, v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "ACK");

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      36.579-1 clause 5.3.3
   * @param     p_ServiceType
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @param     p_SdpInfoRX
   * @param     p_IsReInvite        (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_PreestablishedSession_Establishment(MCX_ServiceType_Type p_ServiceType,
                                                               charstring p_SessionId := tsc_MCX_SessionID_B,
                                                               template (present) MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX,
                                                               boolean p_IsReInvite := false) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var charstring v_PublicServiceId;
    var template (present) SipUrl v_RequestUri;
    var template (present) MessageHeader v_MessageHeader_Invite;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var SDP_Message v_SDP_Message;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    if (not p_IsReInvite) {                                     /* @sic R5w220111, R5-223945: SessionId different from PSI sic@ */
      v_PublicServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
      v_RequestUri := f_SIP_BuildSipUri_RX(v_PublicServiceId);
      f_MCX_IMS_PTC_ImsInfo_SetContactUrlSS(p_SessionId);       /* @sic R5w220111, R5-223945: global variable ContactUrlSS sic@ */
    } else {
      v_RequestUri := f_IMS_PTC_ImsInfo_GetContactUrlSS();
    }
    v_MessageHeader_Invite := f_MCX_InviteRequest_MessageHeaderRX(p_ServiceType, PRE_EST_SESSION_ESTAB_MOD, -, -, v_RequestUri, p_IsReInvite);
    v_IMS_DATA_REQ := valueof(f_MCX_InviteMO_ReceiveRequest_Optional(v_RequestUri, v_MessageHeader_Invite, cr_MessageBody_SDP, -, p_IsReInvite));
    v_SDP_Message := valueof(f_MCPTT_MCVideo_DecodeMatchAndCheckSDP(p_ServiceType, v_IMS_DATA_REQ.Request.Invite.messageBody, p_SdpInfoRX));
    v_InviteRequestWithSdp := f_IMS_InviteRequestWithSdpMO(v_IMS_DATA_REQ, v_SDP_Message);

    if (not p_IsReInvite) {
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    }

    f_MCX_InviteMO_Send100Trying(v_InviteRequestWithSdp);

    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(p_ServiceType, PRE_ESTABLISHED, v_InviteRequestWithSdp);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Wrapper function with MMI commnd before preestablished session establishment and RRC connection release afterwards
   * @param     p_ServiceType
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCX_ServiceType_Type p_ServiceType,
                                                                       charstring p_SessionId := tsc_MCX_SessionID_B) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var MCX_MediaControlCondition_Type v_MediaControlCondition := withoutImplictGrantRequest;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX := f_MCX_SdpInfo_RX(p_ServiceType, PRE_ESTABLISHED, -, SDP_OFFER, v_MediaControlCondition);
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    select (p_ServiceType) {
      case (MCPTT) {
        f_MCPTT_MCVideo_CallSetupMO_InitiateCall(p_ServiceType, "Make the UE (MCPTT client) initiate establishment of a pre-established session without implicit floor request");
      }
      case (MCVideo) {
        f_MCPTT_MCVideo_CallSetupMO_InitiateCall(p_ServiceType, "Make the UE (MCVideo client) initiate establishment of a pre-established session without implicit transmission request");
      }
    }
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_PreestablishedSession_Establishment(p_ServiceType, p_SessionId, v_SdpInfoRX);
  
    f_MCX_IPCAN_ReleaseConnection(IPCAN_MO_IMS_Signalling);   // IPCAN_MO_IMS_Signalling: only the RRC connection gets released but the EPS bearers are kept

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      36.579-1 clause 5.3A.3 Step 2
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @param     p_CommencementMode  (default value: NONE)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McpttInfoExt      (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McvideoInfoExt    (default value: omit)
   * @param     p_SdpInfoRX         (default value: omit)
   * @return    MCX_ReferRequestWithSdpAndXml_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_PreestablishedSession_CallSetupMO_ReceiveREFER(MCX_ServiceType_Type p_ServiceType,
                                                                          MCX_CallType_Type p_CallType,
                                                                          MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                          charstring p_SessionId := tsc_MCX_SessionID_B,
                                                                          MCX_CommencementMode_Type p_CommencementMode := NONE,
                                                                          template MCPTT_Info_Type p_McpttInfo := omit,
                                                                          template McpttInfoExt_ElementList_Type p_McpttInfoExt := omit,
                                                                          template MCVideo_Info_Type p_McvideoInfo := omit,
                                                                          template McvideoInfoExt_ElementList_Type p_McvideoInfoExt := omit,
                                                                          template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX := omit) runs on MCX_IMS_PTC  return MCX_ReferRequestWithSdpAndXml_Type
  {
    var template (present) ResourceLists_Type v_ResourceLists := cr_MCX_ResourceLists_ANYCALL(?);
    var template  MCPTT_LocationInfo_Type v_McpttLocationInfo := omit;
    var template  MCVideo_LocationInfo_Type v_McvideoLocationInfo := omit;
    var template (present) SipUrl v_RequestUri := f_SIP_BuildSipUri_RX(p_SessionId);
    var template (present) SipUrl v_ReferToUrl := cr_SipUrl_Common("cid", cr_UriComponents_Other(?));
    var template (present) MessageHeader v_MessageHeaderSipUrl := f_MCX_ReferRequest_SipUrlHeadersRX(p_ServiceType, p_CallType, p_CommencementMode);
    var template (present) XSD.AnyURI v_ServiceId_UserB := f_MCX_PreestablishedSession_ResourceListsURI_RX(f_MCX_MCService_ID_User_B(p_ServiceType));
    var template (present) XSD.AnyURI v_ServiceId_UserC := f_MCX_PreestablishedSession_ResourceListsURI_RX(f_MCX_MCService_ID_User_C(p_ServiceType));
    var template (present) XSD.AnyURI v_GroupId_GroupA := f_MCX_PreestablishedSession_ResourceListsURI_RX(f_MCX_MCService_GroupID_Group_A(p_ServiceType));
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MessageHeader v_MessageHeader_Refer;
    var MIME_Message v_MIME_Message;
    var MCX_MIME_XmlBodies_Type v_XmlBodiesREFER;
    var MCX_MIME_XmlBodies_Type v_XmlBodiesURI;
    var ResourceLists_ListSequence_Type v_ResourceListsEntries;
    var SipUrl v_ResourceListsUri;
    var MessageBody v_MessageBody;
    var template (omit) SDP_Message v_SdpOffer;
    var boolean v_ImplicitGrantRequest := false;
    var integer i;

    select (p_CallType) {
      case (FIRST_TO_ANSWER) {
        v_ResourceLists := cr_MCX_ResourceLists(cr_MCX_ResourceLists_SequenceList_FIRST_TO_ANSWER(v_ServiceId_UserB, v_ServiceId_UserC));
      }
      case (PRIVATE_CALL) {
        v_ResourceLists := cr_MCX_ResourceLists_ANYCALL(v_ServiceId_UserB);
      }
      case (GROUP_CALL, CHAT_GROUP_CALL) {
        v_ResourceLists := cr_MCX_ResourceLists_ANYCALL(v_GroupId_GroupA);
      }
    }

    if (ispresent(p_SdpInfoRX) and (valueof(p_SdpInfoRX.CheckInfo.MediaControlCondition) == withImplictGrantRequest)) {
      /* NOTE: According to 36.579-1 the SDP during establishment of the pre-established session does not have an implicit floor request
         => it is sufficient to consider the SDP during call establishment, if any */
      v_ImplicitGrantRequest := true;
    }

    if ((p_CallType != PRIVATE_CALL) and v_ImplicitGrantRequest and tsc_MCX_Allow_location_info_when_talking) {
      // NOTE: "NOT PRIVATE-CALL" is missing in 36.579-1 Table 5.5.2.12-2, but as long as there is no pre-established session private call test case with floor control this does not harm
      select (p_ServiceType) {
        case (MCPTT)   { v_McpttLocationInfo := cr_MCPTT_LocationInfo_Report; }
        case (MCVideo) { v_McvideoLocationInfo := cr_MCVideo_LocationInfo_Report; }
      }
    }

    // Receive REFER
    v_IMS_DATA_REQ := f_MCX_PreestablishedSession_ReceiveREFER(p_ServiceType, p_PriorityCallType, v_RequestUri, v_ReferToUrl, cr_MessageBody_MIME);
    v_MessageHeader_Refer := v_IMS_DATA_REQ.Request.Refer.msgHeader;
    v_MIME_Message := v_IMS_DATA_REQ.Request.Refer.messageBody.mimeMessageBody;

    // Check MIME body
    v_XmlBodiesREFER := f_MCX_MIME_DecodeAndMatchXML(v_MIME_Message, p_ServiceType, -, -, -, -, -, -, -, -, -, -, v_ResourceLists);
    f_MCX_PreestablishedSession_ReferCheckContentId(v_MessageHeader_Refer.referTo.nameAddr.addrSpec.components.other, v_MIME_Message);

    // Decode and check SIP URI headers
    v_ResourceListsEntries := v_XmlBodiesREFER.ResourceLists.sequence_list[0].list.sequence_list;
    for (i := 0; i < lengthof(v_ResourceListsEntries); i := i + 1) {  /* More than one entry for first-to-answer call; otherwise only one entry */
      v_ResourceListsUri := f_SIP_ParseURI(f_UniCharstring2Charstring(v_ResourceListsEntries[i].choice.entry.uri));
      v_MessageBody := f_MCX_ReferResourceListsEntryURI_DecodeAndMatchHeaders(v_ResourceListsUri.headers, v_MessageHeaderSipUrl);
      v_MIME_Message := v_MessageBody.mimeMessageBody;

      // Check SDP offer
      v_SdpOffer := f_MCPTT_MCVideo_DecodeMatchAndCheckSDP(p_ServiceType, v_MessageBody, p_SdpInfoRX);

      // Check XML messages
      v_XmlBodiesURI := f_MCX_MIME_DecodeAndMatchXML(v_MIME_Message, p_ServiceType, -, p_McpttInfo, p_McpttInfoExt, p_McvideoInfo, p_McvideoInfoExt, -, -, v_McpttLocationInfo, v_McvideoLocationInfo);
    }

    return f_MCX_ReferRequestWithSdpAndXml(v_IMS_DATA_REQ, v_SdpOffer, v_XmlBodiesURI);         /* NOTE: in case of first-to-answer call all URIs shall have the same URI headers
                                                                                                   => the URI headers of all URIs shall be checked but only one set (the last one) is stored in MCX_ReferRequestWithSdpAndXml_Type */
  }

  /*
   * @desc      36.579-1 clause 5.3A.3 Step 2 - 3
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @param     p_CommencementMode  (default value: NONE)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McpttInfoExt      (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McvideoInfoExt    (default value: omit)
   * @param     p_SdpInfoRX         (default value: omit)
   * @return    MCX_ReferRequestWithSdpAndXml_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_PreestablishedSession_CallSetupMO_ReceiveREFER_Send200OK(MCX_ServiceType_Type p_ServiceType,
                                                                                    MCX_CallType_Type p_CallType,
                                                                                    MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                                                    charstring p_SessionId := tsc_MCX_SessionID_B,
                                                                                    MCX_CommencementMode_Type p_CommencementMode := NONE,
                                                                                    template MCPTT_Info_Type p_McpttInfo := omit,
                                                                                    template McpttInfoExt_ElementList_Type p_McpttInfoExt := omit,
                                                                                    template MCVideo_Info_Type p_McvideoInfo := omit,
                                                                                    template McvideoInfoExt_ElementList_Type p_McvideoInfoExt := omit,
                                                                                    template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX := omit) runs on MCX_IMS_PTC return MCX_ReferRequestWithSdpAndXml_Type
  { /* @sic R5-240570, R5-240571, R5-240572, R5-240574, R5-240577, R5-240579, R5-240580, R5-240581: no SDP answer in SIP 200 OK sic@ */
    var MCX_ReferRequestWithSdpAndXml_Type v_ReferRequestWithSdpAndXml;
    var template (value) MessageHeader v_MessageHeader_200OK;

    // Step 2: Receive REFER
    v_ReferRequestWithSdpAndXml := f_MCPTT_MCVideo_PreestablishedSession_CallSetupMO_ReceiveREFER(p_ServiceType,
                                                                                                  p_CallType,
                                                                                                  p_PriorityCallType,
                                                                                                  p_SessionId,
                                                                                                  p_CommencementMode,
                                                                                                  p_McpttInfo,
                                                                                                  p_McpttInfoExt,
                                                                                                  p_McvideoInfo,
                                                                                                  p_McvideoInfoExt,
                                                                                                  p_SdpInfoRX);
    
    f_MCPTT_MCVideo_CallSetupMO_ConfigSRTP(p_ServiceType, p_CallType);

    // Step 3: Send 200 OK
    v_MessageHeader_200OK := f_MCX_CommonResponse_200_MessageHeaderTX(v_ReferRequestWithSdpAndXml.Refer.msgHeader);
    select (p_CommencementMode) {
      case (AMBIENT_LISTENING_REMOTE) {                         /* as the test case expects the BYE procedure to happen, according to 24.379 clause 11.1.6.2.2.3 the feature tag needs to be sent to the UE
                                                                   @sic R5-222401: Table 6.2.18.3.3-4B sic@ */
        v_MessageHeader_200OK.featureCaps := f_MCX_FeatureCaps_MCPTT_AmbientListeningCallRelease();
      }
      case (AMBIENT_VIEWING_REMOTE) {
        v_MessageHeader_200OK.featureCaps := f_MCX_FeatureCaps_MCVideo_AmbientViewingCallRelease();
      }
    }
    IMS_Server.send(cas_IMS_DATA_RSP(v_ReferRequestWithSdpAndXml.RoutingInfo, cs_Response(c_statusLine200, v_MessageHeader_200OK)));

    return v_ReferRequestWithSdpAndXml;
  }

  /*
   * @desc      36.579-1 clause 5.3A.4: Generic Test Procedure for MCX CO call release keeping the pre-established session
   * @param     p_ServiceType
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_MCVideo_PreestablishedSession_CallReleaseMO(MCX_ServiceType_Type p_ServiceType,
                                                               charstring p_SessionId := tsc_MCX_SessionID_B) runs on IMS_PTC
  {
    var charstring v_ServiceName := f_MCX_ServiceName(p_ServiceType);

    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) release the call keeping the pre-established session");   /* @sic R5-240567: common MMI sic@ */

    f_MCX_PreestablishedSession_CallReleaseMO_ReceiveREFER_Send200OK(p_ServiceType, p_SessionId);
    f_MCX_IPCAN_ReleaseConnection(IPCAN_MO_IMS_Signalling);   // IPCAN_MO_IMS_Signalling: only the RRC connection gets released but the EPS bearers are kept
  }

}
