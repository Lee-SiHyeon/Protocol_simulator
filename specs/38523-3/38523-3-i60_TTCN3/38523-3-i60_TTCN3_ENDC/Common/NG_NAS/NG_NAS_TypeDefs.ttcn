    AUN3_SecurityKey                    aun3SecKey               optional       /* cl. 9.11.3.107 O TLV 36-n IEI=55 Jun24 @sic R5s240531 Baseline Moving sic@ */
  };

  type record NG_AUTHENTICATION_FAILURE {                          /* 24.501 cl. 8.2.4
                                                                   Significance:  dual
                                                                   Direction:     UE to network */
