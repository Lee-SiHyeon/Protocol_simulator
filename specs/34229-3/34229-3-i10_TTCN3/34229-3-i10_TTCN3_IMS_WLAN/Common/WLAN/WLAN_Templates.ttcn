module WLAN_Templates {

  import from CommonDefs all;
  import from IP_ASP_TypeDefs all;
  import from Parameters all;
  import from WLAN_ASP_TypeDefs all;

  template (value) WLAN_AP_AddressInfo_Type cs_WLAN_AP_AddressInfo(charstring p_UE_IPAddressIPv4,
                                                                   charstring p_UE_IPAddressIPv6,
                                                                   charstring p_DNS_ServerAddressIPv4,
                                                                   charstring p_DNS_ServerAddressIPv6) :=
  { /* @status    APPROVED (IMS) */
    UE_IPAddressIPv4 := p_UE_IPAddressIPv4,
    UE_IPAddressIPv6 := p_UE_IPAddressIPv6,
    DNS_ServerAddressIPv4 := p_DNS_ServerAddressIPv4,
    DNS_ServerAddressIPv6 := p_DNS_ServerAddressIPv6
  };

  template (value) WLAN_EAP_AKA_Cntrl_Type cs_WLAN_EAP_AKA :=
  { /* configurable parameters  for EAP AKA */
    /* @status    APPROVED (IMS) */
    IMSI    := px_IMSI_Def,
    RAND    := px_eAuthRAND,
    AuthK   := px_AuthK
  };

  template (value) WLAN_RoutingInfo_Type cs_WLAN_RoutingInfo :=
  { /* @status    APPROVED (IMS) */
    None := true
  };

  template (value) WLAN_TimingInfo_Type cs_WLAN_TimingInfoNow :=
  { /* @status    APPROVED (IMS) */
    Now := true
  };

  template (value) WLAN_ReqAspControlInfo_Type cs_WLAN_ControlInfoCnf(boolean p_CnfFlag := true):=
  { /* @status    APPROVED (IMS) */
    CnfFlag := p_CnfFlag,
    FollowOnFlag := false
  };

  template (value) WLAN_AP_SystemCommand_Type cs_WLAN_AP_AssociateCmd :=
  { /* @status    APPROVED (IMS) */
    AssociateWLANAP := true
  };

  template (value) WLAN_ReqAspCommonPart_Type cs_WLAN_CommonReq(WLAN_CellId_Type p_CellId,
                                                                template (value) WLAN_TimingInfo_Type  p_TimingInfo := cs_WLAN_TimingInfoNow,
                                                                template (value) WLAN_RoutingInfo_Type p_RoutingInfo := cs_WLAN_RoutingInfo,
                                                                template (value) WLAN_ReqAspControlInfo_Type p_ControlInfoReq := cs_WLAN_ControlInfoCnf):=
  { /* @status    APPROVED (IMS) */
    CellId := p_CellId,
    RoutingInfo := p_RoutingInfo,
    TimingInfo  := p_TimingInfo,
    ControlInfo := p_ControlInfoReq
  };

  template (value) WLAN_AP_SYSTEM_CMD cas_WLAN_SYSTEM_CMD(WLAN_CellId_Type p_CellId,
                                                          template (value) WLAN_AP_SystemCommand_Type p_CommandReq,
                                                          template (value) WLAN_TimingInfo_Type  p_TimingInfo := cs_WLAN_TimingInfoNow):=
  { /* @status    APPROVED (IMS) */
    Common :=  cs_WLAN_CommonReq(p_CellId, p_TimingInfo),
    Command := p_CommandReq
  };

  template (value) WLAN_AP_SYSTEM_CTRL_REQ cas_WLAN_CellConfig_REQ(WLAN_CellId_Type p_CellId,
                                                                   template (value) WLAN_AP_AddressInfo_Type p_AddressInfo,
                                                                   template (value) WLAN_AP_Parameters_Type p_AP_Params,
                                                                   template (value) WLAN_InitialCellPower_Type p_InitialCellPower,
                                                                   template (value) WLAN_TimingInfo_Type  p_TimingInfo := cs_WLAN_TimingInfoNow) :=
  { /* @status    APPROVED (IMS) */
    Common := cs_WLAN_CommonReq(p_CellId, p_TimingInfo),
    Request := {
      Cell := {
        AddOrReconfigure := {
          AP_AddressInfo := p_AddressInfo,
          WLAN_AP_Parameters := p_AP_Params,
          InitialCellPower := p_InitialCellPower
        }
      }
    }
  };

  template (value) WLAN_AP_SYSTEM_CTRL_REQ cas_WLAN_CellRelease_REQ(WLAN_CellId_Type p_CellId,
                                                                    template (value) WLAN_TimingInfo_Type  p_TimingInfo := cs_WLAN_TimingInfoNow) :=
  { /* @status    APPROVED (IMS) */
    Common := cs_WLAN_CommonReq(p_CellId, p_TimingInfo),
    Request := {
      Cell := {
        Release := true
      }
    }
  };

  template (value) WLAN_AP_SYSTEM_CTRL_REQ cas_WLAN_CellAtenuationList_REQ(template (value) WLAN_CellAttenuationList_Type p_CellAtenuationList,
                                                                           template (value) WLAN_TimingInfo_Type  p_TimingInfo := cs_WLAN_TimingInfoNow):=
  { /* @status    APPROVED (IMS) */
    Common := cs_WLAN_CommonReq(wlan_Cell_NonSpecific, p_TimingInfo),
    Request := {
      CellAttenuationList := p_CellAtenuationList
    }
  };

  template (present) WLAN_AP_SystemConfirm_Type cr_WLAN_CellCnf :=
  { /* @status    APPROVED (IMS) */
    Cell := true
  };

  template (present) WLAN_AP_SystemConfirm_Type cr_WLAN_CellAttenuationCnf :=
  { /* @status    APPROVED (IMS) */
    CellAttenuationList := true
  };

  template (present) WLAN_ConfirmationResult_Type cr_WLAN_Success_Cnf :=
  { /* @status    APPROVED (IMS) */
    Success := true
  };

  template (present) WLAN_CnfAspCommonPart_Type cr_WLAN_CommonCnf(template (present) WLAN_CellId_Type p_CellId) :=
  { /* @status    APPROVED (IMS) */
    CellId := p_CellId,
    RoutingInfo := ?,
    TimingInfo  := ?,
    Result      := cr_WLAN_Success_Cnf
  };

  template (present) WLAN_AP_SYSTEM_CTRL_CNF car_WLAN_SYSTEM_CTRL_CNF(template (present) WLAN_CellId_Type p_CellId,
                                                                      template (present) WLAN_AP_SystemConfirm_Type p_SystemCnf):=
  { /* @status    APPROVED (IMS) */
    Common  := cr_WLAN_CommonCnf(p_CellId),
    Confirm := p_SystemCnf
  };

  template (present) WLAN_AP_SystemIndication_Type cr_WLAN_AP_AssociationCmplInd :=
  { /* @status    APPROVED (IMS) */
    AssociateWLANAP_Ind := true
  };

  template (present) WLAN_AP_SystemIndication_Type cr_WLAN_ErrorInd :=
  { /* @status    APPROVED (IMS) */
    Error := ?
  };

  template (present) WLAN_IndAspCommonPart_Type cr_WLAN_CommonInd(template (present) WLAN_CellId_Type p_CellId,
                                                                  template (present) WLAN_TimingInfo_Type  p_TimingInfo := ?) :=
  { /* @status    APPROVED (IMS) */
    CellId := p_CellId,
    RoutingInfo := ?,
    TimingInfo  := p_TimingInfo,
    Status := { Ok := true }
  };

  template (present) WLAN_AP_SYSTEM_IND car_WLAN_SYSTEM_IND(WLAN_CellId_Type p_CellId,
                                                            template (present) WLAN_AP_SystemIndication_Type p_SystemInd,
                                                            template (present) WLAN_TimingInfo_Type p_TimingInfo := ?) :=
  { /* @status    APPROVED (IMS) */
    Common := cr_WLAN_CommonInd(p_CellId, p_TimingInfo),
    Indication := p_SystemInd
  };

  template (value) WLAN_PDN_AddressInfo_Type cs_WLAN_PDN_IMS_AddressInfo(charstring p_UE_IPAddressIPv4,
                                                                     charstring p_UE_IPAddressIPv6,
                                                                     charstring p_PCSCF_ServerAddressIPv4,
                                                                     charstring p_PCSCF_ServerAddressIPv6) :=
  { /* @status    APPROVED (IMS) */
    UE_IPAddressIPv4 := p_UE_IPAddressIPv4,
    UE_IPAddressIPv6 := p_UE_IPAddressIPv6,
    PCSCF_IPAddressIPv4 := p_PCSCF_ServerAddressIPv4,
    PCSCF_IPAddressIPv6 := p_PCSCF_ServerAddressIPv6,
    DNS_ServerAddressIPv4 := omit,
    DNS_ServerAddressIPv6 := omit
  };

  template (value) WLAN_PDN_AddressInfo_Type cs_WLAN_PDN_nonIMS_AddressInfo(charstring p_UE_IPAddressIPv4,
                                                                            charstring p_UE_IPAddressIPv6,
                                                                            charstring p_DNS_ServerAddressIPv4,
                                                                            charstring p_DNS_ServerAddressIPv6) :=
  { /* @status    APPROVED (IMS) */
    UE_IPAddressIPv4 := p_UE_IPAddressIPv4,
    UE_IPAddressIPv6 := p_UE_IPAddressIPv6,
    PCSCF_IPAddressIPv4 := omit,
    PCSCF_IPAddressIPv6 := omit,
    DNS_ServerAddressIPv4 := p_DNS_ServerAddressIPv4,
    DNS_ServerAddressIPv6 := p_DNS_ServerAddressIPv6

  };

  template (value) IPsec_ePDG_Cntrl_Type cs_IPSec_SA(IPsec_IntegrityAlgorithm_Type p_Integrity,
                                                     IPsec_CipheringAlgorithm_Type p_Ciphering) :=
  { /* @status    APPROVED (IMS) */
    IntegrityAlgorithm := p_Integrity,
    CipheringAlgorithm  := p_Ciphering
  };

  template (value) WLAN_ePDG_RoutingInfo_Type cs_EPDG_RoutingInfo (template (value) PDN_Index_Type  p_PdnId):=
  { /* @status    APPROVED (IMS) */
    PdnId := p_PdnId
  };

  template (value) WLAN_ePDG_ReqAspCommonPart_Type cs_WLAN_ePDG_CommonReq (template (value) PDN_Index_Type  p_PdnId):=
  { /* @status    APPROVED (IMS) */
    RoutingInfo := cs_EPDG_RoutingInfo(p_PdnId),
    ControlInfo := cs_WLAN_ControlInfoCnf
  };

  template (value) WLAN_ePDG_ReqAspCommonPart_Type cs_WLAN_ePDG_NoneCommonReq:=
  { /* @status    APPROVED (IMS) */
    RoutingInfo := { None := true },
    ControlInfo := cs_WLAN_ControlInfoCnf
  };

  template (value)  WLAN_ePDG_PDN_ConfigInfo_Type cs_WLAN_ePDG_PDN_ConfigInfo(template (value) PDN_Index_Type  p_PdnId,
                                                                              template (value) WLAN_PDN_AddressInfo_Type p_PDN_AddressInfo,
                                                                              template (value)  IPsec_ePDG_Cntrl_Type p_IPsec_ePDG_Cntrl) :=
  { /* @status    APPROVED (IMS) */
    PdnId             := p_PdnId,
    PDN_AddressInfo   := p_PDN_AddressInfo,
    IPsec_SA          := p_IPsec_ePDG_Cntrl,
    EAP_AKA_Cntrl     := cs_WLAN_EAP_AKA
  };

  template (value) WLAN_ePDG_SYSTEM_CTRL_REQ cas_EPDG_Config_REQ( charstring p_EPDG_IPAddressIPv4,
                                                                 charstring p_EPDG_IPAddressIPv6,
                                                                 template (value) WLAN_ePDG_PDN_ConfigInfoList_Type p_IpSecTunelList) :=
  { /* @status    APPROVED (IMS) */
    Common :=  cs_WLAN_ePDG_NoneCommonReq,
    Request := {
      ePDG := {
        AddOrReconfigure := {
        ePDG_IPAddressIPv4 := p_EPDG_IPAddressIPv4,
        ePDG_IPAddressIPv6 := p_EPDG_IPAddressIPv6,
        IPsecTunnelList    := p_IpSecTunelList

        }
      }
    }
  };

  template (value) WLAN_ePDG_SYSTEM_CTRL_REQ cas_EPDG_Release_REQ(template (value) PDN_Index_Type  p_PdnId) :=
  { /* @status    APPROVED (IMS) */
    Common := cs_WLAN_ePDG_CommonReq(p_PdnId),
    Request := {
      ePDG := {
        Release:= true
      }
    }
  };

  template (present) WLAN_ePDG_SYSTEM_CTRL_CNF car_EPDG_SYSTEM_CTRL_CNF(template (present) WLAN_ePDG_RoutingInfo_Type p_RoutingInfo):=
  { /* @status    APPROVED (IMS) */
    Common := {
      RoutingInfo := p_RoutingInfo,
      Result      := cr_WLAN_Success_Cnf
    }, /* according to definition of WLAN_ePDG_SYSTEM_CTRL_CNF:  */
    Confirm := {ePDG := true}
  };

  template (present) WLAN_ePDG_SystemIndication_Type cr_WLAN_IPsecTunnelDiscInd :=
  { /* @status    APPROVED (IMS) */
    IPsecTunnelDiscInd := {
      IPSecTunnelRelCmpl := true
    }
  };

  template (present) WLAN_ePDG_SystemIndication_Type cr_WLAN_IPsecTunnelEstabInd_IKE_SA_INIT :=
  { /* @status    APPROVED (IMS) */
    IPsecTunnelEstabInd := {
      IKE_SA_INIT_Ind := true
    }
  };

  template (present) WLAN_ePDG_SystemIndication_Type cr_WLAN_IPsecTunnelEstabInd_EAP_AKA_Cmpl(EAP_AKA_Cmpl_Status_Type p_EAP_AKA_Result := success,
                                                                                              template integer p_XresLength := ?) :=
  { /* @status    APPROVED (IMS) */
    /* @sic R5w160212 sic@ */
    IPsecTunnelEstabInd := {
      EAP_AKA_Cmpl := {
        EAP_AKA_Status := p_EAP_AKA_Result,
        XRES_Length := p_XresLength
      }
    }
  };

  template (present) WLAN_ePDG_SystemIndication_Type cr_WLAN_IPsecTunnelEstabInd_IKE_AUTH_REQ(template charstring p_AccessPointName) :=
  { /* @status    APPROVED (IMS) */
    IPsecTunnelEstabInd:={
      IKE_AUTH_Req := {
        AccessPointName := p_AccessPointName
      }
    }
  };

  template (present) WLAN_ePDG_SystemIndication_Type cr_WLAN_IPsecTunnelEstabInd_Cmpl :=
  { /* @status    APPROVED (IMS) */
    IPsecTunnelEstabInd := {
      IPSecTunnelEstabCmpl := true
    }
  };

  template (present) WLAN_ePDG_RoutingInfo_Type cr_EPDG_RoutingInfo (template (present) PDN_Index_Type  p_PdnId):=
  { /* @status    APPROVED (IMS) */
    PdnId := p_PdnId
  };

  template (present) WLAN_ePDG_IndAspCommonPart_Type cr_WLAN_ePDG_CommonInd(template (present) PDN_Index_Type  p_PdnId) :=
  { /* @status    APPROVED (IMS) */
    RoutingInfo := cr_EPDG_RoutingInfo(p_PdnId),
    Status      := { Ok := true}
  };

  template (present) WLAN_ePDG_SYSTEM_IND car_EPDG_SYSTEM_IND(template (present) PDN_Index_Type  p_PdnId,
                                                              template (present) WLAN_ePDG_SystemIndication_Type p_SystemInd) :=
  { /* @status    APPROVED (IMS) */
    Common:= cr_WLAN_ePDG_CommonInd(p_PdnId),   /* according to definition of WLAN_ePDG_SYSTEM_IND */
    Indication := p_SystemInd
  };

}
