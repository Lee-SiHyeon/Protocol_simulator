module IMS_ECall_RRC_Handover_IMS {

  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Registration all;
  import from IMS_eCall_Functions all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.2.4.28
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_8_2_4_28_IMS1() runs on IMS_PTC
  {
    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration();
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.2.4.28
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_8_2_4_28_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrl;

    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyRegistration();      // @sic R5s240105 sic@
    f_ECall_CallSetup_AnnexC47(MANUAL);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);    // @sic R5s240105 sic@
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);  // @sic R5s240105 sic@
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrl);  // @sic R5-250334 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

}
