  /*
   * @desc      Function that returns the Tx Power Level
   * @param     p_CellId
   * @return    CellTxPowerLevel
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UTRAN_CellInfo_GetCellTxPower(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC return CellTxPowerLevel
  {
