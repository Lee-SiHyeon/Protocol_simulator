  /*
   * @desc      Return the value of SIB1_Category0Allowed, set category0Allowed-r12 to true if UE is category 0.
   *            Acc to 36.508 Table 4.4.3.2-3A: SystemInformationBlockType1-BR-r13 UECAT0=this condition applies when UE under test is a UE of Category 0
   * @param     p_Category0Allowed  (default value: true_)
   * @return    template (omit) SIB1_Category0Allowed_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_SetSIB1_Category0Allowed(template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_) return template (omit) SIB1_Category0Allowed_Type
  {
    var template (omit) SIB1_Category0Allowed_Type v_SIB1_Category0Allowed := omit;
    
    if (pc_ue_CategoryDL_0) {  //UECAT0
      v_SIB1_Category0Allowed := p_Category0Allowed;
    }
    return v_SIB1_Category0Allowed;
  }

  /*
   * @desc      Return q-RxLevMin acc to 36.508 Table 4.4.3.2-3A
   * @return    Q_RxLevMin
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_SetQ_RxLevMin_SIB1_BR() return Q_RxLevMin
  { //@sic R5-171994 sic@
    var Q_RxLevMin v_Q_RxLevMin := -53;
    if (f_GetTestcaseAttrib_EnhancedCoverageQRxLevMin(testcasename())) {
      v_Q_RxLevMin := -27;
    }
    return v_Q_RxLevMin;
  }

