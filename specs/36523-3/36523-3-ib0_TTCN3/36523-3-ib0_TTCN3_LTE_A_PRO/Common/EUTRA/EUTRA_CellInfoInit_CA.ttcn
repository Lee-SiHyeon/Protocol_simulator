module EUTRA_CellInfoInit_CA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from CommonIratDefs all;
  import from EUTRA_AuxiliaryFunctions all;
  import from EUTRA_BandDependentParam all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoFrequencyRF all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_Component all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_Parameters all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SysInfo_Templates all;
  import from Parameters all;

  type enumerated CA_Tested_Type { CA_IntraBand, CA_InterBand, CA_IntraBandNonContiguous };   /* @sic R5-141113 R5-145717 sic@ @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */

  type record Frequency_fList_CAIntraBand_Type {
    /* This structure is used to contain the different frequencies f1, f2, f3 */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    //@sic R5s150438 sic@
    //@sic R5-165892 Band extension sic@
    CellCarrierFreqEUTRA_Type      f1,
    Dl_Bandwidth_Type     f1_DL_ChBandwidth,
    Ul_Bandwidth_Type     f1_UL_ChBandwidth,
    CellCarrierFreqEUTRA_Type      f2,
    Dl_Bandwidth_Type     f2_DL_ChBandwidth,
    Ul_Bandwidth_Type     f2_UL_ChBandwidth,
    CellCarrierFreqEUTRA_Type      f3,
    Dl_Bandwidth_Type     f3_DL_ChBandwidth,
    Ul_Bandwidth_Type     f3_UL_ChBandwidth
  };

  type record Frequency_fList_CAInterBand_Type {
    /* This structure is used to contain the different frequencies f1, f2, f5, f6 */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    //@sic R5s150438 sic@
    //@sic R5-165892 Band extension sic@
    CellCarrierFreqEUTRA_Type      f1,
    Dl_Bandwidth_Type     f1_DL_ChBandwidth,
    Ul_Bandwidth_Type     f1_UL_ChBandwidth,
    CellCarrierFreqEUTRA_Type      f2,
    Dl_Bandwidth_Type     f2_DL_ChBandwidth,
    Ul_Bandwidth_Type     f2_UL_ChBandwidth,
    CellCarrierFreqEUTRA_Type      f5,
    Dl_Bandwidth_Type     f5_DL_ChBandwidth,
    Ul_Bandwidth_Type     f5_UL_ChBandwidth,
    CellCarrierFreqEUTRA_Type      f6,
    Dl_Bandwidth_Type     f6_DL_ChBandwidth,
    Ul_Bandwidth_Type     f6_UL_ChBandwidth
  };

  template (value) Frequency_fList_CAInterBand_Type cs_FrequencyCAInterBand_Dummy:=
  { /* To initialise f1,f2,f3,f4 with dummy frequency values  */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
     //@sic R5s150438 sic@
    f1 := cs_DummyCarrierFreqEUTRA,
    f1_DL_ChBandwidth := n50,
    f1_UL_ChBandwidth := n50,
    f2 := cs_DummyCarrierFreqEUTRA,
    f2_DL_ChBandwidth := n50,
    f2_UL_ChBandwidth := n50,
    f5 := cs_DummyCarrierFreqEUTRA,
    f5_DL_ChBandwidth := n50,
    f5_UL_ChBandwidth := n50,
    f6 := cs_DummyCarrierFreqEUTRA,
    f6_DL_ChBandwidth := n50,
    f6_UL_ChBandwidth := n50
  };

    template (value) Frequency_fList_CAIntraBand_Type cs_FrequencyCAIntraBand_Dummy:=
  { /* To initialise f1,f2,f3 dummy frequency values  */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    //@sic R5s150438 sic@
    f1 := cs_DummyCarrierFreqEUTRA,
    f1_DL_ChBandwidth := n100,
    f1_UL_ChBandwidth := n100,
    f2 := cs_DummyCarrierFreqEUTRA,
    f2_DL_ChBandwidth := n100,
    f2_UL_ChBandwidth := n100,
    f3 := cs_DummyCarrierFreqEUTRA,
    f3_DL_ChBandwidth := n100,
    f3_UL_ChBandwidth := n100
  };

   /*
   * @desc      Initialise for CA intra band field CarrierFreq_r9 depending on the band
   * @param     p_Freq
   * @param     p_CA_FrequencyBand
   * @return    template (value) Frequency_fList_CAIntraBand_Type
   * @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12)
   */
  function fl_AssignIntraBandCarrierFreq_r9(template (value) Frequency_fList_CAIntraBand_Type p_Freq,
                                            CA_BandCombination_Type p_CA_FrequencyBand)
    return template (value) Frequency_fList_CAIntraBand_Type
  {
    var template (value) Frequency_fList_CAIntraBand_Type v_Freq := p_Freq;
    var integer v_Band := f_EUTRA_GetCA_PrimaryBand(p_CA_FrequencyBand);
    
    //Assign EARFCN_r9 Handle band extension @sic R5-165892 sic@
    if (v_Band < 64) {
      v_Freq.f1.dl_CarrierFreq_r9 := p_Freq.f1.dl_CarrierFreq;
      v_Freq.f1.ul_CarrierFreq_r9 := p_Freq.f1.ul_CarrierFreq;
      v_Freq.f2.dl_CarrierFreq_r9 := p_Freq.f2.dl_CarrierFreq;
      v_Freq.f2.ul_CarrierFreq_r9 := p_Freq.f2.ul_CarrierFreq;
      v_Freq.f3.dl_CarrierFreq_r9 := p_Freq.f3.dl_CarrierFreq;
      v_Freq.f3.ul_CarrierFreq_r9 := p_Freq.f3.ul_CarrierFreq;
    } else {
      if (isvalue(p_Freq.f1.dl_CarrierFreq_v9e0)) {
        v_Freq.f1.dl_CarrierFreq_r9 := valueof(p_Freq.f1.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f1.ul_CarrierFreq_v9e0)) {
        v_Freq.f1.ul_CarrierFreq_r9 := valueof(p_Freq.f1.ul_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f2.dl_CarrierFreq_v9e0)) {
        v_Freq.f2.dl_CarrierFreq_r9 := valueof(p_Freq.f2.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f2.ul_CarrierFreq_v9e0)) {
        v_Freq.f2.ul_CarrierFreq_r9 := valueof(p_Freq.f2.ul_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f3.dl_CarrierFreq_v9e0)) {
        v_Freq.f3.dl_CarrierFreq_r9 := valueof(p_Freq.f3.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f3.ul_CarrierFreq_v9e0)) {
        v_Freq.f3.ul_CarrierFreq_r9 := valueof(p_Freq.f3.ul_CarrierFreq_v9e0);
      }
    }
    return v_Freq;
  }

  /*
   * @desc      Initialise for CA inter band field CarrierFreq_r9 depending on the band
   * @param     p_Freq
   * @param     p_CA_FrequencyBand
   * @return    template (value) Frequency_fList_CAInterBand_Type
   * @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12)
   */
  function fl_AssignInterBandCarrierFreq_r9(template (value) Frequency_fList_CAInterBand_Type p_Freq,
                                            CA_BandCombination_Type p_CA_FrequencyBand)
    return template (value) Frequency_fList_CAInterBand_Type
  {
    var template (value) Frequency_fList_CAInterBand_Type v_Freq := p_Freq;
    var integer v_PrimaryBand := f_EUTRA_GetCA_PrimaryBand(p_CA_FrequencyBand);
    var integer v_SecondaryBand := f_EUTRA_GetCA_SecondaryBand(p_CA_FrequencyBand);
    
    //Assign EARFCN_r9 Handle band extension
    if (v_PrimaryBand < 64) {
      v_Freq.f1.dl_CarrierFreq_r9 := p_Freq.f1.dl_CarrierFreq;
      v_Freq.f1.ul_CarrierFreq_r9 := p_Freq.f1.ul_CarrierFreq;
      v_Freq.f2.dl_CarrierFreq_r9 := p_Freq.f2.dl_CarrierFreq;
      v_Freq.f2.ul_CarrierFreq_r9 := p_Freq.f2.ul_CarrierFreq;
    } else {
      if (isvalue(p_Freq.f1.dl_CarrierFreq_v9e0)) {
        v_Freq.f1.dl_CarrierFreq_r9 := valueof(p_Freq.f1.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f1.ul_CarrierFreq_v9e0)) {
        v_Freq.f1.ul_CarrierFreq_r9 := p_Freq.f1.ul_CarrierFreq_v9e0;
      }
      if (isvalue(p_Freq.f2.dl_CarrierFreq_v9e0)) {
        v_Freq.f2.dl_CarrierFreq_r9 := valueof(p_Freq.f2.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f2.ul_CarrierFreq_v9e0)) {
        v_Freq.f2.ul_CarrierFreq_r9 := p_Freq.f2.ul_CarrierFreq_v9e0;
      }
    }
    if (v_SecondaryBand < 64) {
      v_Freq.f5.dl_CarrierFreq_r9 := p_Freq.f5.dl_CarrierFreq;
      v_Freq.f5.ul_CarrierFreq_r9 := p_Freq.f5.ul_CarrierFreq;
      v_Freq.f6.dl_CarrierFreq_r9 := p_Freq.f6.dl_CarrierFreq;
      v_Freq.f6.ul_CarrierFreq_r9 := p_Freq.f6.ul_CarrierFreq;
    } else {
      if (isvalue(p_Freq.f5.dl_CarrierFreq_v9e0)) {
        v_Freq.f5.dl_CarrierFreq_r9 := valueof(p_Freq.f5.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f5.ul_CarrierFreq_v9e0)) {
        v_Freq.f5.ul_CarrierFreq_r9 := valueof(p_Freq.f5.ul_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f6.dl_CarrierFreq_v9e0)) {
        v_Freq.f6.dl_CarrierFreq_r9 := valueof(p_Freq.f6.dl_CarrierFreq_v9e0);
      }
      if (isvalue(p_Freq.f6.ul_CarrierFreq_v9e0)) {
        v_Freq.f6.ul_CarrierFreq_r9 := valueof(p_Freq.f6.ul_CarrierFreq_v9e0);
      }
    }
    return v_Freq;
  }

  /*
   * @desc      Initialise SIB5 CA and DC inter band
   * @param     p_SysinfoCombination
   * @param     p_FreqInterCA
   * @param     p_PrimaryBand
   * @param     p_SecondaryBand
   * @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12)
   */
  function f_InitSIB5_InterCA_DC(Combination_Type p_SysinfoCombination,
                                 Frequency_fList_CAInterBand_Type p_FreqInterCA,
                                 integer p_PrimaryBand,
                                 integer p_SecondaryBand) runs on EUTRA_PTC
  { //@sic R5-171110 band>64 sic@
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierList;
    var template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit; //@sic R5-169034 sic@
    
    if (p_SysinfoCombination == c3 or p_SysinfoCombination == c9) {
      // Frequencies list for cells on f1: f2, f5, f6 @sic R5-150432 sic@
      if (p_FreqInterCA.f2.dl_CarrierFreq != tsc_DummyFrequency) {
        if (p_FreqInterCA.f6.dl_CarrierFreq != tsc_DummyFrequency) {
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f2.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f2_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f6.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f6_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64 and p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else if (p_PrimaryBand > 64){
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(omit)};
          } else if (p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        } else { //f6 dummy
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f2.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f2_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64 and p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0) };
          } else if (p_PrimaryBand > 64){
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(omit) };
          } else if (p_SecondaryBand > 64){
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0) };
          }  else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        }
      } else {  //f2 dummy
        if (p_FreqInterCA.f6.dl_CarrierFreq != tsc_DummyFrequency) {
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f6.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f6_DL_ChBandwidth))
          };
          if (p_SecondaryBand > 64 ) {
            v_InterFreqCarrierList_v9e0 := {
              cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0),
              cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0)
            };
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        } else { //f2 and f6 dummy
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth))
          };
          if (p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := {
              cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0)
            };
          }
        }
      }
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell1,  cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell2,  cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell4,  cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell11, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      
      // Frequencies list for cells on f2: f1, f5, f6 @sic R5-150432 sic@
      if (p_FreqInterCA.f6.dl_CarrierFreq != tsc_DummyFrequency) {
        v_InterFreqCarrierList := {
          cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f6.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f6_DL_ChBandwidth))
        };
        if (p_PrimaryBand > 64 and p_SecondaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
        } else if (p_PrimaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(omit) };
        } else if (p_SecondaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
        } else {
          v_InterFreqCarrierList_v9e0 := omit;
        }
      } else { //f6 dummy
        v_InterFreqCarrierList := {
          cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth))
        };
        if (p_PrimaryBand > 64 and p_SecondaryBand > 64)  {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0) };
        } else if (p_PrimaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(omit) };
        } else if (p_SecondaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0) };
        } else {
          v_InterFreqCarrierList_v9e0 := omit;
        }
      }
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell3, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      
      // Frequencies list for cells on f5: f1, f2, f6 @sic R5-150432 sic@
      if (p_FreqInterCA.f2.dl_CarrierFreq != tsc_DummyFrequency) {
        if (p_FreqInterCA.f6.dl_CarrierFreq != tsc_DummyFrequency) {
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f2.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f2_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f6.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f6_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64 and p_SecondaryBand > 64)  {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else if (p_PrimaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(omit) };
          } else if (p_SecondaryBand > 64)  {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        } else {  //f6 dummy
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
                cs_InterFreqCarrierFreq(p_FreqInterCA.f2.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f2_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0)};
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        }
      } else { //f2 dummy
        if (p_FreqInterCA.f6.dl_CarrierFreq != tsc_DummyFrequency) {
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
            cs_InterFreqCarrierFreq(p_FreqInterCA.f6.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f6_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64 and p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else if (p_PrimaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                             cs_InterFreqCarrierFreq_v9e0(omit) };
          } else if (p_SecondaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                             cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f6.dl_CarrierFreq_v9e0) };
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        } else {  //f6 and f2dummy
          v_InterFreqCarrierList := {
            cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth))
          };
          if (p_PrimaryBand > 64) {
            v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0)};
          } else {
            v_InterFreqCarrierList_v9e0 := omit;
          }
        }
      }
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell10, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell30, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell31, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      
      // Frequencies list for cells on f6: f1, f2, f5 @sic R5-150432 sic@
      if (p_FreqInterCA.f2.dl_CarrierFreq != tsc_DummyFrequency) {
        v_InterFreqCarrierList := {
          cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f2.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f2_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth))
        };
        if (p_PrimaryBand > 64 and p_SecondaryBand > 64)  {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0)};
        } else if (p_PrimaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f2.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(omit)};
        } else if ( p_SecondaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0)};
        } else { v_InterFreqCarrierList_v9e0 := omit; }
      } else { // f2 dummy
        v_InterFreqCarrierList := {
          cs_InterFreqCarrierFreq(p_FreqInterCA.f1.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f1_DL_ChBandwidth)),
          cs_InterFreqCarrierFreq(p_FreqInterCA.f5.dl_CarrierFreq, f_EUTRA_GetBandDependentAllowedMeasBandwidth( p_FreqInterCA.f5_DL_ChBandwidth))
        };
        if (p_PrimaryBand > 64 and p_SecondaryBand > 64)  {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0)};
        } else if (p_PrimaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f1.dl_CarrierFreq_v9e0),
                                           cs_InterFreqCarrierFreq_v9e0(omit)};
        } else if (p_SecondaryBand > 64) {
          v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(omit),
                                           cs_InterFreqCarrierFreq_v9e0(p_FreqInterCA.f5.dl_CarrierFreq_v9e0)};
        } else {
          v_InterFreqCarrierList_v9e0 := omit;
        }
      }
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell28, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
      f_EUTRA_CellInfo_SetSIB5(eutra_Cell29, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));
    }
  }

