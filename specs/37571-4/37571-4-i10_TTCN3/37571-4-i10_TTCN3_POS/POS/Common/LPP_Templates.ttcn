  /*
   * @desc      Sets value for IE gps-TOW-Assist for all Satellites
   * @param     p_SatelliteIdList
   * @param     p_ProvidedAssist
   * @return    template (value) GPS_TOW_Assist
   * @status    APPROVED (POS)
   */
  function fl_Build_cs_GPS_TOW_Assist(IntegerList_Type p_SatelliteIdList,
                                      GPS_TOW_Assist p_ProvidedAssist) return template (value) GPS_TOW_Assist
  {
    var template (value) GPS_TOW_Assist v_GPS_TOW_Assist;
    var integer i;
    for (i := 0; i < 6; i:= i + 1) {
      v_GPS_TOW_Assist[i] := cs_GPS_TOW_AssistElement(p_SatelliteIdList[i], p_ProvidedAssist[i]);
    }
    return v_GPS_TOW_Assist;
  }

