module MCX_HTTP_Component {

  import from CommonDefs all;
  import from HTTP_ASP_TypeDefs all;
  import from MCX_CoordMsgs all;
  import from UpperTesterPtcToMtcDefs all;

  type record HTTP_Global_Type {        /* @status    APPROVED (MCX) */
    boolean  TestBody,
    integer  ETagCnt,                   /* @sic R5-230295 sic@ */
    default  Default
  };

  type component MCX_HTTP_PTC {         /* @status    APPROVED (MCX) */
    var HTTP_Global_Type vc_HTTP_Global;
    
    port UT_PTC_MTC_PORT MMI;
    port MCX_CO_ORD_PORT IMS;           // coordination port to MCPTT IMS PTC

    port HTTP_CTRL_PORT HTTPCTRL;
    port HTTP_DATA_PORT HTTPDATA;
  };

  /*
   * @desc      Set/reset test body flag
   * @param     p_TestBodyFlag
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_TestBody_Set(boolean p_TestBodyFlag) runs on MCX_HTTP_PTC
  {
    vc_HTTP_Global.TestBody := p_TestBodyFlag;
  }

  /*
   * @desc      Check whether test body is active
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function fl_MCX_HTTP_TestBody_Check() runs on MCX_HTTP_PTC return boolean
  {
    return vc_HTTP_Global.TestBody;
  }

  /*
   * @desc      Set Fail/Inconc vedict
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_SetVerdictFailOrInconc(charstring p_FileName,
                                             LineNo_Type p_LineNo,
                                             charstring p_Msg) runs on MCX_HTTP_PTC
  {
    if (fl_MCX_HTTP_TestBody_Check()) {
      f_SetVerdict(fail, p_FileName, p_LineNo, p_Msg);
    } else {
      f_SetVerdict(inconc, p_FileName, p_LineNo, p_Msg);
    }
    self.kill; // => test case will terminate immediately
  }

  /*
   * @desc      Set PASS verdict
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_PreliminaryPass(charstring p_FileName,
                                      LineNo_Type p_LineNo,
                                      charstring p_Msg) runs on MCX_HTTP_PTC
  {
    if (fl_MCX_HTTP_TestBody_Check()) {
      f_SetVerdict(pass, p_FileName, p_LineNo, p_Msg);
    }
  }

  /*
   * @desc      to ensure that each ETag has a different value
   * @return    integer
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_IncrAndGetETagCnt() runs on MCX_HTTP_PTC return integer
  {
    vc_HTTP_Global.ETagCnt := vc_HTTP_Global.ETagCnt + 1;
    return vc_HTTP_Global.ETagCnt;
  }

  /*
   * @desc      Default behaviour
   * @status    APPROVED (MCX)
   */
  altstep a_MCX_HTTP_DefaultBehaviour() runs on MCX_HTTP_PTC
  {
    [] any port.receive {
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected message");
    }
    [] any timer.timeout {
      all timer.stop;
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected timeout");
    }
  }

  /*
   * @desc      Initialise HTTP PTC
   * @status    APPROVED (MCX)
   */
  function f_MCX_HTTP_Init() runs on MCX_HTTP_PTC
  {
    vc_HTTP_Global.TestBody := false;
    vc_HTTP_Global.ETagCnt := 0;
    vc_HTTP_Global.Default := activate(a_MCX_HTTP_DefaultBehaviour());
  }

}
