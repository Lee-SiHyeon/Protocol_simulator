module EUTRA38_Frequencies {

  import from Common4G5G all;
  import from CommonDefs all;
  import from ENDC_CommonFrequencyFunctions all;
  import from EUTRA38_FrequencyInitIntraBandC_ENDC all;
  import from EUTRA38_FrequencyInitIntraBandNC_ENDC all;
  import from EUTRA38_HighestFrequencyInitIntraBandC_ENDC all;
  import from EUTRA38_HighestFrequencyInitIntraBandNC_ENDC all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoFrequency all;
  import from EUTRA_Component all;
  import from TestcaseProperties all;

  /*
   * @desc      Initialise EUTRA frequency as per 38.508-1 cl 6.2.3
   * @param     p_ENDC_BandCombination
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_InitFrequencies(ENDC_BandCombination_Type p_ENDC_BandCombination) runs on EUTRA_PTC
  {
    var ENDC_CombinationType_Type v_ENDC_CombinationType := f_ENDC_GetCombinationType (p_ENDC_BandCombination );
    var integer v_EUTRA_Band := f_ENDC_GetEUTRA_Band(p_ENDC_BandCombination);
    var template (value)Frequency_fList_Type v_FreqList;
     
    select (v_ENDC_CombinationType) {
      case (InterBand) {} //No change needed frequencies initialised by default as in 36.508 cl 6.2.3
      case (IntraBandContiguous) {
        if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) {
            v_FreqList := f_EUTRA38_InitFrequenciesIntraBandC(v_EUTRA_Band);
        } else {
            v_FreqList := f_EUTRA38_InitHighestFrequenciesIntraBandC(v_EUTRA_Band);
        }
        f_EUTRA38_UpdateFrequenciesInCellArray(valueof(v_FreqList));
      }
      case (IntraBandNonContiguous) {
        //@sic R5-199015 sic@
        if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) {
            v_FreqList := f_EUTRA38_InitFrequenciesIntraBandNC(v_EUTRA_Band);
        } else {
            v_FreqList := f_EUTRA38_InitHighestFrequenciesIntraBandNC(v_EUTRA_Band);
        }
        f_EUTRA38_UpdateFrequenciesInCellArray(valueof(v_FreqList));
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid ENDC band combination type");
      }
    }
  }

  /*
   * @desc      Update EUTRA frequency in the cellArray as per 38.508-1 cl 6.2.3
   * @param     p_FreqList
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_UpdateFrequenciesInCellArray(Frequency_fList_Type p_FreqList) runs on EUTRA_PTC
  {
    //Note: it is assumed that cells have previously been configured with the correct band and bandwidth - only the frequencies needs to be modified
    // Modify Frequency per cell. See 36.508 Table Table 4.4.2-1
    // Cell 1, Cell 2, Cell 4, Cell 11 => f1
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell1,  p_FreqList.f1);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell2,  p_FreqList.f1);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell4,  p_FreqList.f1);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell11, p_FreqList.f1);
    //Cell 3, Cell 12, Cell 23 => f2
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell3,  p_FreqList.f2);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell12, p_FreqList.f2);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell23, p_FreqList.f2);
    //Cell 6, Cell 13 => f3
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell3,  p_FreqList.f3);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell12, p_FreqList.f3);
  }

}
