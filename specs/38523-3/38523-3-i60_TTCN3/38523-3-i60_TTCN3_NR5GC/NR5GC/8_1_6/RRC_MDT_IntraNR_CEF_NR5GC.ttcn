module RRC_MDT_IntraNR_CEF_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_Handover all;
  import from NR5GC_MDT_Specific_Templates all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR5GC_UE_Location all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Functions all;
  import from NR_Measurement_Templates all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  template MeasResultList2NR_r16 cr_MeasResultNeighCellListNR_1Entry (template ARFCN_ValueNR p_SsbFrequency_r16,
                                                                      template ARFCN_ValueNR p_RefFreqCSI_RS_r16,
                                                                      template (present) MeasResultListNR p_MeasResultList_r16)  :=
  { /* @status    APPROVED (NR5GC) */
    {
    ssbFrequency_r16        := p_SsbFrequency_r16,
    refFreqCSI_RS_r16       := p_RefFreqCSI_RS_r16,
    measResultList_r16      := p_MeasResultList_r16
     }
   };

  template (present) MeasResultListNR cr_MeasResultListNR_1Entry(PhysCellId p_PhysCellId) :=
    //@sic R5-217924, R5s220007 sic@
    /* @status    APPROVED (NR5GC) */
    {cr_NR_MeasResultNR(p_PhysCellId, cr_MeasResultNR_MeasResult_AnyRSRP, *)};

  template (present) RRCReconfigurationComplete_v1610_IEs cr_RRCReconfigurationComplete_v1610_CEF :=
  { /* @status    APPROVED (NR5GC) */
    ue_MeasurementsAvailable_r16 := cr_UE_MeasurementsAvailable_r16_CEF,
    needForGapsInfoNR_r16 := omit,
    nonCriticalExtension := *
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_1_NR5GC() runs on NR5GC_PTC
  { //Connection Establishment Failure / Logging and reporting / T300 expiry
  
    f_NR5GC_Init(NR_1);
   
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_6_1_4_1_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_1_6_1_4_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_6_1_4_1_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var CellIdentity v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var PLMN_Identity v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    
    //@siclog "Step 2" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 3" siclog@
    //The SS waits for 2sec to ensure that the UE detects T300 expiry.
    f_Delay(2.0);
    
    //@siclog "Step 4" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    
    //@siclog "Step 5" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 6" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def(nr_Cell1);
    
    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit an RRCSetupComplete message including connEstFailInfoAvailable IE set it to true? UE initiates the session management procedure by including the SERVICE REQUEST message.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, -, -, -,
                                                                    cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-, -, -, true_))));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    //@siclog "Steps 8-11" siclog@
    //Steps 5 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    
    //@siclog "Step 12" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                    -,
                                    cs_38508_UEInformationRequest)); // @sic R5-225389 sic@
    
    //@siclog "Step 13" siclog@
    //Check: Does the UE send a UEInformationResponse message with connEstFailReport?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                           -, -, -,
                                                                           cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1)),
                                                                                                    omit))));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_2_NR5GC() runs on NR5GC_PTC
  { //Connection Establishment Failure / Logging and reporting / RRC Resume
  
    f_NR5GC_Init(NR_1); // @sic R5-217920, R5s211598 sic@
   
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble(nr_Cell1, STATE_INACTIVE_2A, -, NotFollowedByResume);  //@sic R5s250008 R5-217920, R5s211598 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_1_6_1_4_2_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A_T3540, tsc_NR_RbId_SRB1); // @sic R5-217920, R5s211598, R5s240238 sic@
  }

  /*
   * @desc      test body of TC_8_1_6_1_4_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_6_1_4_2_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var CellIdentity v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var PLMN_Identity v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);
    var integer v_WaitTime := 1;//T319 is ms1000 by default // @sic R5-217920, R5s211598 sic@
    var float v_T319Min := f_NR_SetTimerToleranceMin(nr_Cell1, rrcTimer, int2float(v_WaitTime)); // @sic R5-217920, R5s211598 sic@
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message on NR Cell 1.
    f_NR_Paging_Def(nr_Cell1, RRC_INACTIVE);
    
    //@siclog "Step 2" siclog@
    //The UE transmits an RRCResumeRequest message.
    f_NR_RRC_ResumeRequest_Def(nr_Cell1);
    
    //@siclog "Step 3" siclog@
    //@sic R5-217920, R5s211598 sic@
    //The SS waits for 1sec to ensure that the UE detects T319 expiry.
    f_Delay(v_T319Min);
      
    //@siclog "Step 3A" siclog@
    //@sic R5-217920, R5s211598 sic@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 3B" siclog@
    //@sic R5-217920, R5s211598 sic@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def(nr_Cell1);
    
    //@siclog "Step 3C" siclog@
    //@sic R5-217920, R5s211598 sic@
    //Check: Does the UE transmit an RRCSetupComplete message including connEstFailInfoAvailable IE set it to true? UE initiates the mobility registration procedure by including the REGISTRATION REQUEST message.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, -, -, -,
                                                                    cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-, -, -, true_))));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3C");

    //@siclog "Steps 3D - 3E" siclog@
    //@sic R5-217920, R5s211598 sic@
    //Steps4-5 defined in TS 38.508-1 [4] Table 4.9.5.2.2-1, indicate that the UE has performed mobility registration on NR cell 1 started in NR RRC_IDLE?
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell1, v_GMM_MobilityInfo, -, -, noRrcConnectionRelease);

    //@siclog "Steps 4 - 5" siclog@
    //@sic R5s211598, R5-221573 sic@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell1, v_ReceivedMsg.SecurityProtection.NasCount); // Use NasCount returned from Registration Req

    //@siclog "Steps 6 - 12" siclog@
    //@sic R5-217920, R5s211598, R5-221573 sic@
    //Void

    //@siclog "Step 13" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, // @sic R5-217920, R5s211598 sic@
                                    -,
                                    cs_38508_UEInformationRequest)); // @sic R5-225389 sic@
    
    //@siclog "Step 14" siclog@
    //Check: Does the UE send a UEInformationResponse message with connEstFailReport?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, // @sic R5-217920, R5s211598 sic@
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                           -, -, -,
                                                                           cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1)),
                                                                                                    omit))));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.3
   * @status    APPROVED (NR5GC)
   */
     function f_TC_8_1_6_1_4_3_NR5GC() runs on NR5GC_PTC
  { //Connection Establishment Failure / Logging and reporting / Reporting at intra-NR handover
    f_NR5GC_Init(NR_4); //System information combination NR-4 as defined in TS 38.508-1 clause 4.4.3.1.2.
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -85);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell3, -73, -73);
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);//The UE is in state 1N-A as defined in TS 38.508-1, subclause 4.4A, on cell 1

    f_NR_TestBody_Set(true);

    f_TC_8_1_6_1_4_3_NR5GC_TestBody();

    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell3, STATE_CONNECTED_3A);// @sic R5s211721 sic@
  }// End of f_TC_8_1_6_1_4_3_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_3_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (present) UL_DCCH_Message v_RRCConnReconfigComplete;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
         
    f_NR_SetCellPower (nr_Cell1, -85, -91);//@sic R5-234797 sic@
    f_NR_SetCellPower (nr_Cell3, -97, -100);//@sic R5-234797 sic@
    //@siclog "Step 1" siclog@
    //void//@sic R5-216312 sic@
    //@siclog "Step 2" siclog@
   //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    //@siclog "Step 3" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    //@siclog "Step 4" siclog@
    //The SS waits for 2sec to ensure that the UE detectsT300 expiry.//@sic R5-216312 sic@
    f_Delay(2.0);
    
    //@siclog "Step 5" siclog@
    //Void//@sic R5-216312 sic@
    
    //@siclog "Step 6" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    //@siclog "Step 7-8" siclog@
    //Steps 2 to 3 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_RRCSetup_Def(nr_Cell1);
    //@siclog "Step 9" siclog@
    //The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message..
   v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                         cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def,-,-,-,
                                                                   cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-,-,-,true_,-))));
    //@siclog "Step 10-13" siclog@
    //Steps 5 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    //@siclog "Step 14" siclog@
    //The SS transmits an RRCReconfiguration message to configure measurement.
    //@siclog "Step 15" siclog@
    //UE transmit an RRCReconfigurationComplete message to confirm the measurement configuration.
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell3), cs_MeasObjectId2(nr_Cell1)};
    v_ReportConfigList := {cs_NR_ReportConfigEventA3(tsc_NR_IdReportConfigId1, 2, r1, -, -, cs_NR_MeasReportQuantity_Rsrp)};
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, -, cds_MeasGapConfig_UE(f_NR_GetGapConfig_InterFreqOdd(nr_Cell1, nr_Cell3))); //@sic R5-199013 sic@
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1, v_MeasConfig, -, tsc_NR_MeasObjectId2);
    //@siclog "Step 16" siclog@
    //The SS changes cell 1 and cell 3 parameters according to the row "T1"in table 8.1.6.1.4.3.3.2-1
    f_NR_SetCellPower (nr_Cell3, -78, -82);// @sic R5s211721 R5-234797 sic@
    //@siclog "Step 17" siclog@
    //The UE transmits a MeasurementReport message.
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellIdNeighbour := f_NR_CellInfo_GetPhysicalCellId(nr_Cell3);
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellIdServing, tsc_NR_MeasId1, -, -, cr_NR_MeasResults_MeasResultNeighCells_NR({cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour, cr_NR_MeasQuantityResults_Rsrp)}));
    //@siclog "Step 18" siclog@
    //The SS transmits an RRCReconfiguration message to order the UE to perform handover to Cell 3.
    //@siclog "Step 19" siclog@
    //Check: Dose the UE transmit an RRCReconfigurationComplete message containing connEstFailInfoAvailable on Cell 3?
    v_RRCConnReconfigComplete:=cr_38508_RRCReconfigurationComplete(cr_RRCReconfigurationComplete_v1530(-,cr_RRCReconfigurationComplete_v1560(-, cr_RRCReconfigurationComplete_v1610_CEF)));
    f_NR5GC_508RRC_IntraNR_HO_InterCell(nr_Cell1,nr_Cell3,-,false,-,-,-,-,-,v_RRCConnReconfigComplete);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");
    //@siclog "Step 20" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq.// @sic R5-223994 sic@
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell3,
                                    -,
                                    cs_38508_UEInformationRequest(tsc_NR_RRC_TI_Def, -, -, true_)));
    
    //@siclog "Step 21" siclog@
    //Check: Does the UE send a UEInformationResponse message with connEstFailReport?// @sic R5-223994 sic@
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell3,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                           -, -, -,
                                                                           cr_ConnEstFailReport_r16(?,*))));

  }//End of f_TC_8_1_6_1_4_3_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_4_NR5GC() runs on NR5GC_PTC
  { //Connection Establishment Failure / Logging and reporting / Reporting at RRC connection re-establishment
  
    f_NR5GC_Init(NR_2);

    //Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -80, -80);  // @sic R5-220613 sic@
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell2, -80, -80);  // @sic R5-220613 sic@
   
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_6_1_4_4_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell2, STATE_CONNECTED_3A); // @sic R5-215681, R5s210873 sic@
  }

  /*
   * @desc      test body of TC_8_1_6_1_4_4
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_6_1_4_4_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template RRCReestablishmentComplete_v1610_IEs v_RRCReestablishmentComplete_v1610_IEs;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),  // @sic R5-220613 sic@
      cs_NR_CellPower(nr_Cell2, -80, -82)   // @sic R5-220613 R5-234797 sic@
    };

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    
    //@siclog "Step 2" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 3" siclog@
    //The SS waits for 2sec to ensure that the UE detects T300 expiry.
    f_Delay(2.0);
    
    //@siclog "Steps 4-6" siclog@
    //Steps 1 to 3 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_RRCSetup_Def(nr_Cell1);
    
    //@siclog "Step 7" siclog@
    //The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, -, -, -,
                                                                    cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-, -, -, true_))));  // @sic R5-225389 sic@
    
    //@siclog "Steps 8-11" siclog@
    //Steps 5 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    
    //@siclog "Step 12" siclog@
    //The SS changes Cell 1 and Cell 2 parameters according to the row "T1"in table 8.1.6.1.4.4.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 13" siclog@
    //The UE transmits an RRCReestablishmentRequest message on Cell 2.
    f_NR5GC_RRCReestablishment_Steps0To2(nr_Cell1, nr_Cell2, otherFailure);  //@sic R5-221467 sic@

    //@siclog "Steps 14-15" siclog@
    //The SS transmits an RRCReestablishment message on Cell 2.
    //Check: Does the UE send an RRCReestablishmentComplete message with connEstFailInfoAvailable on Cell 2?
    v_RRCReestablishmentComplete_v1610_IEs := {
        ue_MeasurementsAvailable_r16 := cr_UE_MeasurementsAvailable_r16(-, -, -, true_, true_), // @sic R5-215681 sic@
        nonCriticalExtension := *
    };
    f_NR5GC_RRCReestablishment_Steps3To7(nr_Cell2, -, -, v_RRCReestablishmentComplete_v1610_IEs); // @sic R5s211281 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    //@siclog "Steps 16-17" siclog@
    //@sic R5-215681, R5s210873 sic@
    //The SS transmits an RRCReconfiguration message to establish SRB2 and DRB.
    //The UE transmits an RRCReconfigurationtComplete message.
    f_NR5GC_RRCReestablishment_Steps8To13(nr_Cell1, nr_Cell2);

    //@siclog "Step 18" siclog@
    //@sic R5s240029, R5-223995 sic@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq and rlf-Report.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell2,
                                    -,
                                    cs_38508_UEInformationRequest(tsc_NR_RRC_TI_Def, -, -, true_, -, true_)));

    //@siclog "Step 19" siclog@
    //@sic R5s240029, R5-223995 sic@
    //The UE send a UEInformationResponse message with connEstFailReport and rlf-Report.
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell2,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                           -, -, -, ?, -, ?)));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_5_NR5GC() runs on NR5GC_PTC
  { /* Connection Establishment Failure / Logging and reporting / Location Information   */
    
    var template (present) UL_DCCH_Message v_UEInformationResponse;

    f_NR5GC_Init(NR_1);
        
    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    //Preamble
    //The UE is in state 1N-A as defined in TS 38.508-1 [4], subclause 4.4A.
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A);
    /*The UE's positioning engine (e.g. standalone GNSS receiver) should be provided with any necessary stimulus to allow it to provide the position.
     *This shall be done by use of the test function Update UE Location Information defined in TS 38.509 [6], if supported by the UE according to pc_UpdateUE_LocationInformation.
     *Otherwise, or in addition any other suitable method may also be used.*/
    f_NR_ProvideUE_LocationInformation(nr_Cell1, RRC_IDLE);

    f_NR_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS is configured to not transmit Msg2 in 2-step RACH procedure
    //Void @sic R5-216313 sic@

    //@siclog "Step 2" siclog@
    //The SS transmits a Paging message
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 3" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);

    //@siclog "Step 4" siclog@
    //The SS waits for 2sec (T300 expiry) and ignores further received Random Access Preamble.
    f_Delay(2.0);
    

    //@siclog "Step 5" siclog@
    //The SS is configured to normal that it would transmit Msg2 in 2-step RACH procedure.
    //Void @sic R5-216313 sic@

    //@siclog "Steps 6-13" siclog@
    //Steps 1 to 3 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3
    //The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message.
    //Steps 5 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3.
    f_NR5GC_RRC_ConnectedState3N_SON_MDT(nr_Cell1, connEstFailInfoAvailable);  // @sic R5s211593 sic@

    //@siclog "Step 14" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq
    SRB.send(cas_NR_SRB_RrcPdu_REQ(nr_Cell1,
                                  tsc_NR_RbId_SRB1, //@sic R5s211593 sic@
                                  -, //cs_TimingInfo_Now
                                  cs_38508_UEInformationRequest)); //@sic R5-225389 sic@

    //@siclog "Step 15" siclog@
    //Check: Does the UE send a UEInformationResponse message with connEstFailReport with the IE commonLocationInfo-r16 is present?
    v_UEInformationResponse := cr_UEInformationResponse_r16_CEF(cr_ConnEstFailReport_r16(?,omit,omit,cr_NR_LocationInfo_Base(?)));    //@sic R5-217923, R5-235427 sic@
    SRB.receive(car_NR_SRB_RrcPdu_IND(nr_Cell1, tsc_NR_RbId_SRB1, v_UEInformationResponse)); //@sic R5s211593 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test " & testcasename() & " Step 15");

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);    //@sic R5s211593 sic@
      
  }// End of f_TC_8_1_6_1_4_5_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_6_NR5GC() runs on NR5GC_PTC
  {
    f_NR5GC_Init(NR_2); //System information combination NR-2 as defined in TS 38.508-1 [4] clause 4.4.3.1.2
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -82); //@sic R5-236618 sic@
   
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);//The UE is in state 1N-A as defined in TS 38.508-1, subclause 4.4A, on cell 1
    f_NR_SetCellPower (nr_Cell1, -85, -82); // update for T0 acc. to Table 8.1.6.1.4.6.3.2-1 @sic R5-236618 sic@

    f_NR_TestBody_Set(true);

    f_TC_8_1_6_1_4_6_NR5GC_TestBody();

    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);

  } // End of f_TC_8_1_6_1_4_6_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_6_NR5GC_TestBody() runs on NR5GC_PTC
  {
   var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
   var CellIdentity v_CellIdentity_Cell1;
   var PLMN_Identity v_PLMN_Identity_Cell1;
   var PhysCellId v_PhysCellId_Cell2;//@sic R5-217924 sic@
   var template MeasResultList2NR_r16 v_MeasResult2NR_r16;

    v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    v_PhysCellId_Cell2 := f_NR_CellInfo_GetPhysicalCellId(nr_Cell2);//@sic R5-217924 sic@
    v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);

   //@siclog "Step 1" siclog@
   //The SS changes NR Cell 1 and NR Cell 2 parameter according to the row "T1" in Table 8.1.6.1.4.6.3.2-1/2. is degraded.
    f_NR_SetCellPower (nr_Cell2, -91, -91); // @sic R5-236618 sic@
  
   //@siclog "Step 2" siclog@
   //The SS waits for 40s to ensure that the UE detects intra-frequency cell.
    f_Delay(40.0);

   //@siclog "Step 4" siclog@
   //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
   //@siclog "Step 5" siclog@
   //The SS transmits a Paging message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);

   //@siclog "Step 6" siclog@
   //The SS waits for 2sec (T300 expiry) and ignores further received Random Access Preamble.
    f_Delay(2.0);
   
   //@siclog "Step 8-10" siclog@
   //Steps 1 to 3 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_RRCSetup_Def(nr_Cell1);

   //@siclog "Step 11" siclog@
   //The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message on NR Cell 1.
   v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                         cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def,-,-,-,
                                                                   cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-,-,-,true_,-))));
   //@siclog "Step 12-15" siclog@
   //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
   f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

   //@siclog "Step 16" siclog@
   //The SS sends a UEInformationRequest message to get connEstFailReportReq on NR Cell 1.
   SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                   -,
                                   cs_38508_UEInformationRequest)); //@sic R5-225389 sic@
   
   v_MeasResult2NR_r16 := cr_MeasResultNeighCellListNR_1Entry(*,*,cr_MeasResultListNR_1Entry(v_PhysCellId_Cell2));//@sic R5-217924 sic@
   //@siclog "Step 17" siclog@
   //Check: Does the UE send a UEInformationResponse message with connEstFailReport on NR Cell 1?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1)),
                                                                    v_MeasResult2NR_r16))));
   
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 17");

 }//end of f_TC_8_1_6_1_4_6_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.7
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_7_NR5GC() runs on NR5GC_PTC
  {
  
    f_NR5GC_Init(NR_4); //System information combination NR-4 as defined in TS 38.508-1 clause 4.4.3.1.2.
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -82); //@sic R5-236618 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);//The UE is in state 1N-A as defined in TS 38.508-1, subclause 4.4A, on cell 1
    // @sic R5s230172 sic@
    f_NR_SetCellPower(nr_Cell1, -85, -82); //@sic R5-236618 sic@

    f_NR_TestBody_Set(true);

    f_TC_8_1_6_1_4_7_NR5GC_TestBody();

    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } // End of f_TC_8_1_6_1_4_7_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.7
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_7_NR5GC_TestBody() runs on NR5GC_PTC
  {
   var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
   var PLMN_Identity v_PLMN_Identity_Cell1;
   var CellIdentity v_CellIdentity_Cell1;
   var PhysCellId v_PhysCellId_Cell3;//@sic R5-217925 sic@
   var template MeasResultList2NR_r16 v_MeasResult2NR_r16;
   var template ARFCN_ValueNR v_SsbFrequency_r16;//@sic R5-221570 sic@

   v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
   v_PhysCellId_Cell3 := f_NR_CellInfo_GetPhysicalCellId(nr_Cell3);//@sic R5-217925 sic@
   v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);

   //@siclog "Step 1" siclog@
   //The SS changes NR Cell 1 and NR Cell 3 parameter according to the row "T1" in Table 8.1.6.1.4.7.3.2-1/2. is degraded.
    f_NR_SetCellPower (nr_Cell3, -91, -91);
  
   //@siclog "Step 2" siclog@
   //The SS waits for 40s to ensure that the UE detects intra-frequency cell.
    f_Delay(40.0);

   //@siclog "Step 4" siclog@
   //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

   //@siclog "Step 5" siclog@
   //The SS transmits a Paging message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);

   //@siclog "Step 6" siclog@
   //The SS waits for 2sec (T300 expiry) and ignores further received Random Access Preamble.
    f_Delay(2.0);
   
   //@siclog "Step 8-10" siclog@
   //Steps 1 to 3 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_RRCSetup_Def(nr_Cell1);

   //@siclog "Step 11" siclog@
   //The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message on NR Cell 1.
   v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                         cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def,-,-,-,
                                                                   cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-,-,-,true_,-))));
   //@siclog "Step 12-15" siclog@
   //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
   f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

   //@siclog "Step 16" siclog@
   //The SS sends a UEInformationRequest message to get connEstFailReportReq on NR Cell 1.
   SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                   -,
                                   cs_38508_UEInformationRequest)); //@sic R5-225389 sic@

   v_SsbFrequency_r16 := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);//@sic R5s220490 sic@
   v_MeasResult2NR_r16 := cr_MeasResultNeighCellListNR_1Entry(v_SsbFrequency_r16,*,cr_MeasResultListNR_1Entry(v_PhysCellId_Cell3));//@sic R5-217925 R5-221570sic@
  
   //@siclog "Step 17" siclog@
   //Check: Does the UE send a UEInformationResponse message with connEstFailReport on NR Cell 1?
   SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1)),
                                                                    v_MeasResult2NR_r16))));
   
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 17");

 }//end of f_TC_8_1_6_1_4_7_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.1.4.8
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_6_1_4_8_NR5GC() runs on NR5GC_PTC
  { /* Connection Establishment Failure / Logging and reporting / RACH failure report   */
    
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (present) UL_DCCH_Message v_UEInformationResponse;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters ;
    var template (value) NR_RachProcedureConfig_Type v_NR_RachProcedure ;
    var template (present) ConnEstFailReport_r16 v_ConnEstFailReport;
    var CellIdentity v_CellIdentity;
    var PLMN_Identity v_PLMN_Identity;
     
    var NR_SRB_COMMON_IND v_ReceivedUEInfoResp;
    var PerRAInfoList_r16 v_PerRAInfoList;
    var PerRAAttemptInfoList_r16 v_PerRAAttemptInfoList;
    var integer v_FieldCnt;
    var integer i;
    
    
    f_NR5GC_Init(NR_1);
        
    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    //Preamble
    //The UE is in state 1N-A on Cell 1 as defined in TS 38.508-1 [4], subclause 4.4A
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A);
    
    f_NR_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //SS is configured to not transmit MAC control element and ignore subsequent RACH attemptswith non-matched UE Contention Resolution Identity.
    v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
    
    v_NR_RachProcedure := {
        RachProcedureList := {    //@sic R5s220866, R5-224180 sic@
          cs_NR_RachProcedure(v_NR_PhysicalParameters, cs_NR_ContentionResolutionCtrl_None),
          cs_NR_RachProcedure_NoResponse
        }
    };

    f_NR_SS_RachProcedureConfig(nr_Cell1, v_NR_RachProcedure);
     
    //@siclog "Step 1A" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    
    //@siclog "Step 1B" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 1C" siclog@
    //The SS waits for 2sec to ensure that the UE detects T300 expiry.
    f_Delay(2.0);
      
    //@siclog "Step 1D" siclog@
    //SS is configured to transmit MAC control element with matched UE Contention Resolution Identity
    f_NR_SS_RachProcedureConfig_Def(nr_Cell1);
      
    //@siclog "Step 2" siclog@
    //SS sends a Paging message to the UE on the appropriate paging block, and including the UE identity in one entry of the IE pagingRecordList.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 3-9" siclog@
    //Steps 2-8 of generic test procedure in TS 38.508-1 Table 4.5.4.2-3 are performed on NR Cell 1.
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(nr_Cell1);
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //@siclog "Step 10" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq
    SRB.send(cas_NR_SRB_RrcPdu_REQ(nr_Cell1,
                                  tsc_NR_RbId_SRB1,
                                  -, //cs_TimingInfo_Now
                                  cs_38508_UEInformationRequest));  //@sic R5-225389 sic@

    //@siclog "Step 11" siclog@
    //Check: Does the UE send a UEInformationResponse message with connEstFailReport including the perRAInfoListra-ReportList-r16  on NR Cell1?
    v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    v_PLMN_Identity := f_NR_CellInfo_GetPLMN (nr_Cell1);
    v_ConnEstFailReport :=  cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity, v_CellIdentity)), omit);
    v_UEInformationResponse := cr_UEInformationResponse_r16_CEF(v_ConnEstFailReport);
    v_UEInformationResponse.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.connEstFailReport_r16.perRAInfoList_r16 := {cr_PerRAInfo_r16_SSB(?,-,(1..200))} //@sic R5s220866 sic@

    SRB.receive(car_NR_SRB_RrcPdu_IND(nr_Cell1, tsc_NR_RbId_SRB1, v_UEInformationResponse)) -> value v_ReceivedUEInfoResp;    //@sic R5s220866 sic@
    
    v_PerRAInfoList := v_ReceivedUEInfoResp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.connEstFailReport_r16.perRAInfoList_r16;
    v_PerRAAttemptInfoList := v_PerRAInfoList[0].perRASSBInfoList_r16.perRAAttemptInfoList_r16;
    v_FieldCnt := lengthof(v_PerRAAttemptInfoList);
    
    for (i:=0; i<v_FieldCnt; i:=i+1){ //@sic R5s220866 sic@
        if (match(v_PerRAAttemptInfoList[i],cr_PerRAAttemptInfo_r16))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Test " & testcasename() & " Step 11 contentionDetected set to true");
            break;
        }
        else
        {
            if(i==v_FieldCnt-1){f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 11 contentionDetected not set to true");}
        }
    }
    
    f_NR_TestBody_Set(false);
    
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
      
  }// End of f_TC_8_1_6_1_4_8_NR5GC()

}
