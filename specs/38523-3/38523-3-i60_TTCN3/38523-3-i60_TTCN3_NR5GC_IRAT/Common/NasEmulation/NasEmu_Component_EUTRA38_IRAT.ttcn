module NasEmu_Component_EUTRA38_IRAT {

  import from EUTRA_Component all;
  import from NasEmu_Common4G5G all;
  import from NasEmu_Component_EUTRA all;

  type component NASEMU_EUTRA38_IRAT_PTC extends NASEMU_EUTRA_PTC {
    /* @status    APPROVED (NR5GC_IRAT) */
    port NASEMU4G_CO_ORD_PORT NG;
  };

  /*
   * @desc      Create NASEMU, connect it with EUTRA38_IRAT_PTC and map the system ports
   * @param     p_System
   * @param     p_Eutra
   * @return    NASEMU_EUTRA38_IRAT_PTC
   * @status    APPROVED (NR5GC_IRAT)
   */
   function f_NasEmu_CreateConnectAndMap_EUTRA38(NASEMU_EUTRA_SYSTEM p_System, EUTRA_PTC p_Eutra)  return NASEMU_EUTRA38_IRAT_PTC
  {
    var NASEMU_EUTRA38_IRAT_PTC v_NASEMU_EUTRA_PTC := null;
    
    if (p_Eutra != null) {
      
      // create NAS emulation:
      v_NASEMU_EUTRA_PTC := NASEMU_EUTRA38_IRAT_PTC.create("NASEMU_EUTRA38_IRAT") alive;  // @sic R5s210270 sic@
      
      // connect NAS emulation:
      connect(p_Eutra:NASCTRL,  v_NASEMU_EUTRA_PTC:CTRL);
      connect(p_Eutra:SRB,      v_NASEMU_EUTRA_PTC:TC_SRB);
      
      // map NASEMU system ports:
      map(v_NASEMU_EUTRA_PTC:SYS_SRB, p_System:E_SRB);
    }
    return v_NASEMU_EUTRA_PTC;
  }

}
