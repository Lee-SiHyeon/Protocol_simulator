module UTRAN_TestcaseApplicability {

  import from Parameters all;
  import from UTRAN34_Parameters all;
  import from UTRAN_34123_SelectionExpressions all;

  /*
   * @desc      Set the execution to TRUE or FALSE according to 34.123-3 Annex I
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_ExecutionGuideline(charstring p_TestCase) return boolean
  { // @sic R5-151131 sic@
    var boolean v_ExecutionGuideline := true;
    
    //Band 32 is only applied as secondary band
    if ((px_FDD_OperationBand == 32 )) {
      v_ExecutionGuideline := false;
    } else if (px_SecondaryBand == 32) {
      //FDD Band XXXII is only applicable as a downlink only secondary band in dual band test cases
      select (p_TestCase) {
        case ("TC_8_2_1_45_3",
              "TC_8_2_1_46_3",
              "TC_8_2_2_85_2",
              "TC_8_2_2_86_3",
              "TC_8_2_2_87_3",
              "TC_8_2_2_88_3") {
          v_ExecutionGuideline := true;
        }
        case else {
          v_ExecutionGuideline := false;
        }
      }
    }
    return v_ExecutionGuideline;
  }

  /*
   * @desc      Applicability for UTRAN test cases
   * @param     p_Condition
   * @param     p_TestcaseName
   * @return    boolean
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_TestcaseApplicability(UTRAN_34123_Condition_Type p_Condition,
                                         charstring p_TestcaseName) return boolean
  {
    var boolean v_Applicability := true;

    v_Applicability := v_Applicability and f_UTRAN_ExecutionGuideline(p_TestcaseName);
    v_Applicability := v_Applicability and f_UTRAN_SelectionExpr(p_Condition);

    return v_Applicability;
  }

}
