module CommonPOS_Functions {

  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from OMA_LPPE language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from CommonPOS_Templates all;
  import from EUTRA_NB_Parameters all;
  import from LPP_Templates all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTypeDefs all;
  import from POS_Parameters all;
  import from PosSystem_ASP_TypeDefs all;

  const octetstring tsc_POS_RoutingId := '01234567'O;           /* Selected by the network, use arbitrary value;
                                                                   @status    APPROVED (POS) */

  const InvokeIdType tsc_POS_InvokeId := 100;                   /* Invoke ID to be used in messages sent by the System Simulator. This value has been chosen randomly;
                                                                   @status    APPROVED (POS) */

  const TransactionNumber tsc_POS_TransactionNumber := 0;       /* Any value between 0 and 255;
                                                                   @status    APPROVED (POS) */

   /*
   * @desc      Encodes parater of type REGISTER into an octetstring
   * @param     p_RegisterMT
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_EncodeRegister(template (value) REGISTER p_RegisterMT) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_RegisterMT);
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      Encodes parater of type FACILITY into an octetstring
   * @param     p_Facility
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_EncodeFacility(template (value) FACILITY p_Facility) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_Facility);
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      Encodes parater of type RELEASECOMPLETE into an octetstring
   * @param     p_ReleaseCompleteMT
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_EncodeReleaseComplete(template (value) RELEASECOMPLETE p_ReleaseCompleteMT) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_ReleaseCompleteMT);
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      encode LPP message
   * @param     p_LppMessage
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_EncodeLppMessage(template (value) LPP_Message p_LppMessage) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_LppMessage);
    v_Bitstring := f_OctetAlignedBitString(v_Bitstring); //@sic R5s130145 sic@
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      encode OMS LPPE message
   * @param     p_OmaLppeMessage
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_EncodeOmaLppeMessage(template (value) OMA_LPPe_MessageExtension p_OmaLppeMessage) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_OmaLppeMessage);
    v_Bitstring := f_OctetAlignedBitString(v_Bitstring);
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      Decodes an octetstring into type RELEASECOMPLETE
   * @param     p_EncodedReleaseComplete
   * @return    RELEASECOMPLETE
   * @status    APPROVED (POS)
   */
  function f_POS_ReleaseComplete_Decode(octetstring p_EncodedReleaseComplete) return RELEASECOMPLETE
  {
    var RELEASECOMPLETE v_ReceivedReleaseComplete;
    var bitstring v_EncodedReleaseComplete := oct2bit(p_EncodedReleaseComplete);
    var integer v_DecodeResult := decvalue(v_EncodedReleaseComplete, v_ReceivedReleaseComplete);

    if (v_DecodeResult != 0) {
      FatalError(__FILE__, __LINE__, "RELEASE COMPLETE cannot be decoded");
    }
    return v_ReceivedReleaseComplete;
  }

  /*
   * @desc      Decodes an octetstring into type REGISTER
   * @param     p_EncodedRegister
   * @return    REGISTER
   * @status    APPROVED (POS)
   */
  function f_POS_Register_Decode(octetstring p_EncodedRegister) return REGISTER
  {
    var REGISTER v_ReceivedRegister;
    var bitstring v_EncodedRegister := oct2bit(p_EncodedRegister);
    var integer v_DecodeResult := decvalue(v_EncodedRegister, v_ReceivedRegister);

    if (v_DecodeResult != 0) {
      FatalError(__FILE__, __LINE__, "REGISTER cannot be decoded");
    }
    return v_ReceivedRegister;
  }

  /*
   * @desc      Decode LPP message
   * @param     p_EncodedLppMessage
   * @return    LPP_Message
   * @status    APPROVED (POS)
   */
  function f_POS_LppMessage_Decode(octetstring p_EncodedLppMessage) return LPP_Message
  {
    var LPP_Message v_ReceivedLppMessage;
    var bitstring v_EncodedLppMessage := oct2bit(p_EncodedLppMessage);
    var integer v_DecodeResult := decvalue(v_EncodedLppMessage, v_ReceivedLppMessage);

    if (v_DecodeResult != 0) {
      FatalError(__FILE__, __LINE__, "LPP_Message cannot be decoded");
    }
    return v_ReceivedLppMessage;
  }

  /*
   * @desc      Decode OMA LPPE message
   * @param     p_EncodedOmaLppeMessage
   * @return    OMA_LPPe_MessageExtension
   * @status    APPROVED (POS)
   */
  function f_POS_OmaLppeMessage_Decode(octetstring p_EncodedOmaLppeMessage) return OMA_LPPe_MessageExtension
  {
    var OMA_LPPe_MessageExtension v_ReceivedOmaLppeMessage;
    var bitstring v_EncodedOmaLppeMessage := oct2bit(p_EncodedOmaLppeMessage);
    var integer v_DecodeResult := decvalue(v_EncodedOmaLppeMessage, v_ReceivedOmaLppeMessage);

    if (v_DecodeResult != 0) {
      FatalError(__FILE__, __LINE__, "OMA_LPPe_MessageExtension cannot be decoded");
    }
    return v_ReceivedOmaLppeMessage;
  }

  /*
   * @desc      Selects template to request GNSS-ReferenceTime depending on supported GNSSs
   * @return    template (value) GNSS_ReferenceTimeReq
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateReq_ReferenceTime () return template (value) GNSS_ReferenceTimeReq
  {
    var template (value) GNSS_ReferenceTimeReq v_ReferenceTimeReq;

    if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS){ //GPS supported by the UE
      v_ReferenceTimeReq := cs_GNSS_ReferenceTimeReq({cs_GNSS_ID_Gps}, true, false);
    }
    else if (pc_A_GLONASS and not pc_A_Galileo and not pc_A_BDS) { //GLONASS is the only GNSS supported by the UE
      v_ReferenceTimeReq := cs_GNSS_ReferenceTimeReq({cs_GNSS_ID_Glonass}, false, true);
    }
    else if (pc_A_Galileo and not pc_A_GLONASS and not pc_A_BDS) { //Galileo is the only GNSS supported by the UE
      v_ReferenceTimeReq := cs_GNSS_ReferenceTimeReq({cs_GNSS_ID_Galileo}, false, false);
    }
    else if (pc_A_BDS and not pc_A_GLONASS and not pc_A_Galileo) { //BDS is the only GNSS supported by the UE
      v_ReferenceTimeReq := cs_GNSS_ReferenceTimeReq({cs_GNSS_ID_Bds}, false, false);
    }
    else {
      FatalError (__FILE__, __LINE__, "GNSS method combination not supported by the code");
    }

    return v_ReferenceTimeReq;
  }

  /*
   * @desc      Selects template to request GNSS-IonosphericModel depending on supported GNSSs
   * @return    template (value) GNSS_IonosphericModelReq
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateReq_IonosphModel() return template (value) GNSS_IonosphericModelReq
  {
    var template (value) GNSS_IonosphericModelReq v_IonosphericModelReq;

    if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS or pc_A_GLONASS or pc_BDS_B1I or pc_BDS_B3I){ //@sic R5-241577 sic@
      v_IonosphericModelReq := cs_GNSS_IonosphericModelReq('00'B, omit); // Request klobuchar Model
      if (pc_A_Galileo) {
        v_IonosphericModelReq := cs_GNSS_IonosphericModelReq('00'B, NULL); // Request klobuchar and neQuick Models
      }
      if (pc_BDS_B1C or pc_BDS_B2a) { //@sic R5-211340, R5s210416, R5-241577 sic@
        v_IonosphericModelReq.klobucharModel2Req_r16 := NULL; // Add request for klobucharModel2
      }
    }
    else if (pc_A_Galileo) {
      v_IonosphericModelReq := cs_GNSS_IonosphericModelReq(omit, NULL); // Request neQuick Model
    }
    else {
      FatalError (__FILE__, __LINE__, "No GNSS method supported");
    }

    return v_IonosphericModelReq;
  }

  /*
   * @desc      Selects template to request GNSS-GenericAssistData depending on supported GNSSs
   * @return    template (value) GNSS_GenericAssistDataReq
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateReq_GenericAssistData() return template (value) GNSS_GenericAssistDataReq
  {
    var template (value) GNSS_GenericAssistDataReq v_GenericAssistDataReq;
    var boolean v_GpsAdded := false;
    var boolean v_GlonassAdded := false;
    var boolean v_GalileoAdded := false;
    var boolean v_BdsAdded := false;
    var boolean v_ListEmpty := true;

    // As GNSS_GenericAssistDataReq type definition does not allow an empty list, first we initialise with one element and then we add the rest.
    // Initialise with one element and mark it as added
    if ((pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) and v_ListEmpty){
      v_GenericAssistDataReq := {cs_GenericAssistDataReqElement_GPS(fl_DetermineGPS_SignalID_GNSS_AcquAssist())};
      v_GpsAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_GLONASS and v_ListEmpty) {
      v_GenericAssistDataReq := {cs_GenericAssistDataReqElement_GLONASS};
      v_GlonassAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_Galileo and v_ListEmpty) {
      v_GenericAssistDataReq := {cs_GenericAssistDataReqElement_Galileo};
      v_GalileoAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_BDS and v_ListEmpty) {
      v_GenericAssistDataReq := {cs_GenericAssistDataReqElement_BDS};
      v_BdsAdded := true;
      v_ListEmpty := false;
    }

    //At this point, the list will have only one element. Now we add the rest of GNSS supported.
    if ((pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) and not v_GpsAdded){
      v_GenericAssistDataReq[lengthof(v_GenericAssistDataReq)] := cs_GenericAssistDataReqElement_GPS(fl_DetermineGPS_SignalID_GNSS_AcquAssist());
    }
    if (pc_A_GLONASS and not v_GlonassAdded) {
      v_GenericAssistDataReq[lengthof(v_GenericAssistDataReq)] := cs_GenericAssistDataReqElement_GLONASS;
    }
    if (pc_A_Galileo and not v_GalileoAdded) {
      v_GenericAssistDataReq[lengthof(v_GenericAssistDataReq)] := cs_GenericAssistDataReqElement_Galileo;
    }
    if (pc_A_BDS and not v_BdsAdded) {
      v_GenericAssistDataReq[lengthof(v_GenericAssistDataReq)] := cs_GenericAssistDataReqElement_BDS;
    }

    return v_GenericAssistDataReq;
  }

  /*
   * @desc      Auxiliary function to determine the value of GPS Signal ID for GNSS AcquisitionAssistance based on PICS
   * @return    integer
   * @status    APPROVED (POS)
   */
  function fl_DetermineGPS_SignalID_GNSS_AcquAssist() return integer
  { //@sic R5-186628 sic@
    var integer v_SignalID := 0; //Default value: GPS L1 C/A supported, GPS L5 supported or not

    if (not pc_A_GPS_L1C_A) { //@sic R5s201460 sic@
      if (pc_A_GPS_L5) {
        v_SignalID := 3; //GPS L5
      }
      else {
        FatalError (__FILE__, __LINE__, "No Acquisition Assistance support for GPS L1 C/A or GPS L5");
      }
    }
    return v_SignalID;
  }

  /*
   * @desc      Auxiliary function to determine the value of Galileo Signal ID for GNSS AcquisitionAssistance based on PICS
   * @return    integer
   * @status    APPROVED (POS)
   */
  function fl_DetermineGalileo_SignalID_GNSS_AcquAssist() return integer
  { //@sic R5-186628 sic@
    var integer v_SignalID := 0; //Default value: Galileo E1 supported, Galileo E5A supported or not

    if (not pc_GNSS_AcquAssist_Galileo_E1) {
      if (pc_GNSS_AcquAssist_Galileo_E5A) {
        v_SignalID := 1; //Galileo E5A
      }
      else {
        FatalError (__FILE__, __LINE__, "No Acquisition Assistance support for Galileo E1 or Galileo E5A");
      }
    }
    return v_SignalID;
  }

  /*
   * @desc      Auxiliary function to determine the value of BDS Signal ID for GNSS AcquisitionAssistance based on PICS
   * @return    integer
   * @status    APPROVED (POS)
   */
  function fl_DetermineBDS_SignalID_GNSS_AcquAssist() return integer
  { //@sic R5-211340 sic@
    var integer v_SignalID := 0; //Default value: BDS B1I supported, BDS B1C supported or not

    if (not pc_GNSS_AcquAssist_BDS_B1I) {
      if (pc_GNSS_AcquAssist_BDS_B1C) {
        v_SignalID := 9;
      }
      else if (pc_GNSS_AcquAssist_BDS_B2a) { // @sic R5-241577 sic@
        v_SignalID := 12;
      }
      else if (pc_GNSS_AcquAssist_BDS_B3I) { // @sic R5-241577 sic@
        v_SignalID := 3;
      }
      else {
        FatalError (__FILE__, __LINE__, "No Acquisition Assistance support for BDS B1I or BDS B1C or BDS B2a or BDS B3I");
      }
    }
    return v_SignalID;
  }

  /*
   * @desc      Selects template to provide GNSS-ReferenceTime depending on supported GNSSs
   * @param     p_ProvideAssistData
   * @return    template (value) GNSS_ReferenceTime
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateProv_ReferenceTime(ProvideAssistanceData_r9_IEs p_ProvideAssistData) return template (value) GNSS_ReferenceTime
  {
    var GNSS_ReferenceTime v_RetrievedReferenceTime := p_ProvideAssistData.a_gnss_ProvideAssistanceData.gnss_CommonAssistData.gnss_ReferenceTime;
    var template (value) GNSS_ReferenceTime v_ReferenceTime;

    if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS){ //GPS supported by the UE
      v_ReferenceTime := cs_GNSS_ReferenceTime_Gps(v_RetrievedReferenceTime, {3, 4, 6, 17, 19, 28}); //@sic R5-215711, R5s220032, R5-240554 sic@ (Indexes correspond to PRNs)
    }
    else if (pc_A_GLONASS and not pc_A_Galileo and not pc_A_BDS) { //GLONASS is the only GNSS supported by the UE
      v_ReferenceTime := cs_GNSS_ReferenceTime_Glonass(v_RetrievedReferenceTime);
    }
    else if (pc_A_Galileo and not pc_A_GLONASS and not pc_A_BDS) { //Galileo is the only GNSS supported by the UE
      v_ReferenceTime := cs_GNSS_ReferenceTime_Galileo(v_RetrievedReferenceTime);
    }
    else if (pc_A_BDS and not pc_A_GLONASS and not pc_A_Galileo) { //BDS is the only GNSS supported by the UE
      v_ReferenceTime := cs_GNSS_ReferenceTime_Bds(v_RetrievedReferenceTime);
    }
    else {
      FatalError (__FILE__, __LINE__, "GNSS method combination not supported by the code");
    }

    return v_ReferenceTime;
  }

  /*
   * @desc      Selects template to provide GNSS-ReferenceLocation depending on supported GNSSs
   * @param     p_ProvideAssistData
   * @param     p_UEB
   * @return    template (omit) GNSS_ReferenceLocation
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateProv_ReferenceLocation(ProvideAssistanceData_r9_IEs p_ProvideAssistData,
                                                      boolean p_UEB) return template (omit) GNSS_ReferenceLocation
  {
    var GNSS_ReferenceLocation v_RetrievedReferenceLocation := p_ProvideAssistData.a_gnss_ProvideAssistanceData.gnss_CommonAssistData.gnss_ReferenceLocation;
    var template (omit) GNSS_ReferenceLocation v_ReferenceLocation;

    v_ReferenceLocation := cs_GNSS_ReferenceLocation(v_RetrievedReferenceLocation);
    if (not p_UEB and pc_GNSS_AA) { //UE-Assisted and Acquisition Assistance supported
      v_ReferenceLocation := omit;
    }
    return v_ReferenceLocation;
  }

  /*
   * @desc      Selects template to provide GNSS_IonosphericModel depending on supported GNSSs
   * @param     p_ProvideAssistData
   * @param     p_UEB
   * @return    template (omit) GNSS_IonosphericModel
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplateProv_IonosphericModel(ProvideAssistanceData_r9_IEs p_ProvideAssistData,
                                                     boolean p_UEB) return template (omit) GNSS_IonosphericModel
  {
    var GNSS_IonosphericModel v_RetrievedIonosphericModel := p_ProvideAssistData.a_gnss_ProvideAssistanceData.gnss_CommonAssistData.gnss_IonosphericModel;
    var template (omit) GNSS_IonosphericModel v_IonosphericModel;

    if (p_UEB) {
      if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS or pc_A_GLONASS or pc_BDS_B1I or pc_BDS_B3I){ //@sic R5-241577 sic@
        v_IonosphericModel := cs_GNSS_IonosphericModel(v_RetrievedIonosphericModel.klobucharModel, omit);
        if (pc_A_Galileo) {
          v_IonosphericModel := cs_GNSS_IonosphericModel(v_RetrievedIonosphericModel.klobucharModel, v_RetrievedIonosphericModel.neQuickModel);
        }
      }
      else if (pc_A_Galileo) {
        v_IonosphericModel := cs_GNSS_IonosphericModel(omit, v_RetrievedIonosphericModel.neQuickModel);
      }
      else {
        FatalError (__FILE__, __LINE__, "No GNSS method supported");
      }
      if (pc_BDS_B1C or pc_BDS_B2a) { //@sic R5-211340, R5-241577 sic@
        v_IonosphericModel.klobucharModel2_r16 := v_RetrievedIonosphericModel.klobucharModel2_r16;
      }
    }
    else { // UE-Assisted
      v_IonosphericModel := omit;
    }
    return v_IonosphericModel;
  }

  /*
   * @desc      Selects template to provide GNSS_GenericAssistData depending on supported GNSSs
   * @param     p_ProvideAssistData
   * @param     p_UEB
   * @return    template (value) GNSS_GenericAssistData
   * @status    APPROVED (POS)
   */
  function  f_POS_SelectTemplateProv_GenericAssistData(ProvideAssistanceData_r9_IEs p_ProvideAssistData,
                                                       boolean p_UEB) return template (value) GNSS_GenericAssistData
  {
    var GNSS_GenericAssistData v_RetrievedGenericAssistData := p_ProvideAssistData.a_gnss_ProvideAssistanceData.gnss_GenericAssistData;
    var template (value) GNSS_GenericAssistData v_GenericAssistData;
    var boolean v_GpsAdded := false;
    var boolean v_GlonassAdded := false;
    var boolean v_GalileoAdded := false;
    var boolean v_BdsAdded := false;
    var boolean v_ListEmpty := true;

    // As GNSS_GenericAssistData type definition does not allow an empty list, first we initialise with one element and then we add the rest.
    // Initialise with one element and mark it as added
    if ((pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) and v_ListEmpty){
      v_GenericAssistData := {f_POS_SelectTemplate_GenericAssistDataElement_GPS(v_RetrievedGenericAssistData, p_UEB)};
      v_GpsAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_GLONASS and v_ListEmpty) {
      v_GenericAssistData := {f_POS_SelectTemplate_GenericAssistDataElement_GLONASS(v_RetrievedGenericAssistData, p_UEB)};
      v_GlonassAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_Galileo and v_ListEmpty) {
      v_GenericAssistData := {f_POS_SelectTemplate_GenericAssistDataElement_Galileo(v_RetrievedGenericAssistData, p_UEB)};
      v_GalileoAdded := true;
      v_ListEmpty := false;
    }
    else if (pc_A_BDS and v_ListEmpty) {
      v_GenericAssistData := {f_POS_SelectTemplate_GenericAssistDataElement_BDS(v_RetrievedGenericAssistData, p_UEB)};
      v_BdsAdded := true;
      v_ListEmpty := false;
    }

    //At this point, the list will have only one element. Now we add the rest of GNSS supported.
    if ((pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) and not v_GpsAdded){
      v_GenericAssistData[lengthof(v_GenericAssistData)] := f_POS_SelectTemplate_GenericAssistDataElement_GPS(v_RetrievedGenericAssistData, p_UEB);
    }
    if (pc_A_GLONASS and not v_GlonassAdded) {
      v_GenericAssistData[lengthof(v_GenericAssistData)] := f_POS_SelectTemplate_GenericAssistDataElement_GLONASS(v_RetrievedGenericAssistData, p_UEB);
    }
    if (pc_A_Galileo and not v_GalileoAdded) {
      v_GenericAssistData[lengthof(v_GenericAssistData)] := f_POS_SelectTemplate_GenericAssistDataElement_Galileo(v_RetrievedGenericAssistData, p_UEB);
    }
    if (pc_A_BDS and not v_BdsAdded)  {
      v_GenericAssistData[lengthof(v_GenericAssistData)] := f_POS_SelectTemplate_GenericAssistDataElement_BDS(v_RetrievedGenericAssistData, p_UEB);
    }

    return v_GenericAssistData;
  }

  /*
   * @desc      Selects template to provide GNSS-GenericAssistDataElement for A-GPS
   * @param     p_RetrievedGenericAssistData
   * @param     p_UEB
   * @return    template (value) GNSS_GenericAssistDataElement
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplate_GenericAssistDataElement_GPS(GNSS_GenericAssistData p_RetrievedGenericAssistData,
                                                             boolean p_UEB) return template (value) GNSS_GenericAssistDataElement
  {
    var template (value) GNSS_GenericAssistDataElement v_GenericAssistDataElement;
    var integer i := f_POS_FindIndexForGNSSMethod(p_RetrievedGenericAssistData, cs_GNSS_ID_Gps); //Indicates the position of the GPS data in the retrieved data

    if (i == -1) {//GPS element was not found in the list
      FatalError (__FILE__, __LINE__, "Invalid CellId"); // This function is only called if PICS indicate GPS support. If GPS assistance data is not there, it is a FatalError
    }
    else {
      //Include all possible elements in the template
      // @sic R5-240554 sic@
      v_GenericAssistDataElement := cs_GNSS_GenericAssistDataElement(cs_GNSS_ID_Gps,
                                                                     -,
                                                                     cs_NavigationModel_Gps(p_RetrievedGenericAssistData[i].gnss_NavigationModel), // @sic R5s230595 sic@
                                                                     cs_GNSS_AcquisitionAssistance(cs_GNSS_SignalID(fl_DetermineGPS_SignalID_GNSS_AcquAssist()), // GPS L1 C/A or GPS L5 @sic R5-186628 sic@
                                                                                                   fl_Build_cs_GNSS_AcquisitionAssistList(tsc_IntList_3_4_6_17_19_28, // @sic R5-215711 sic@
                                                                                                                                          p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.gnss_AcquisitionAssistList),
                                                                                                   p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.confidence_r10),
                                                                     cs_GNSS_Almanac_GPS(p_RetrievedGenericAssistData[i].gnss_Almanac),
                                                                     cs_GNSS_UTC_Model_1(p_RetrievedGenericAssistData[i].gnss_UTC_Model),
                                                                     fl_Build_cs_GNSS_AuxiliaryInformation(tsc_IntList_3_4_6_17_19_28, // @sic R5-215711 sic@
                                                                                                           p_RetrievedGenericAssistData[i].gnss_AuxiliaryInformation));
      //Now remove those elements not needed depending on the case
      if (not pc_A_GLONASS) {// UTC-Model provided only if GLONASS and at least one other GNSS supported by the UE.
        v_GenericAssistDataElement.gnss_UTC_Model := omit;
      }
      if (not pc_A_GPS_L1C_A_MGPS) { // UE does not supports multiple GPS signals -> Do not include Auxiliary Information (37.571-2, Table 5.4.1.1-1)
        v_GenericAssistDataElement.gnss_AuxiliaryInformation := omit;
      }
      if (p_UEB) { // UE-Based case
        v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        v_GenericAssistDataElement.gnss_Almanac := omit;
      }
      else { //UE-Assisted case
        if (pc_GNSS_AA) { // UE supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_NavigationModel := omit;
          v_GenericAssistDataElement.gnss_Almanac := omit;
        }
        else { // UE does not supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        }
      }
    }
    return v_GenericAssistDataElement;
  }

  /*
   * @desc      Selects template to provide GNSS-GenericAssistDataElement for A-GLONASS
   * @param     p_RetrievedGenericAssistData
   * @param     p_UEB
   * @return    template (value) GNSS_GenericAssistDataElement
   * @status    APPROVED (POS)
   */
  function f_POS_SelectTemplate_GenericAssistDataElement_GLONASS(GNSS_GenericAssistData p_RetrievedGenericAssistData,
                                                             boolean p_UEB) return template (value) GNSS_GenericAssistDataElement
  {
    var template (value) GNSS_GenericAssistDataElement v_GenericAssistDataElement;
    var integer i := f_POS_FindIndexForGNSSMethod(p_RetrievedGenericAssistData, cs_GNSS_ID_Glonass); //Indicates the position of the GLONASS data in the retrieved data

    if (i == -1) {//GLONASS element was not found in the list
      FatalError (__FILE__, __LINE__, "Invalid CellId"); // This function is only called if GLONASS indicate GPS support. If GLONASS assistance data is not there, it is a FatalError
    }
    else {
      //Include all possible elements in the template
      // @sic R5-240554 sic@
      v_GenericAssistDataElement := cs_GNSS_GenericAssistDataElement(cs_GNSS_ID_Glonass,
                                                                     cs_GNSS_TimeModelList(tsc_GNSS_TO_ID_GPS, p_RetrievedGenericAssistData[i].gnss_TimeModels[0]),
                                                                     cs_NavigationModel_Glonass(p_RetrievedGenericAssistData[i].gnss_NavigationModel),
                                                                     cs_GNSS_AcquisitionAssistance(cs_GNSS_SignalID(0), // GLONASS G1
                                                                                                   fl_Build_cs_GNSS_AcquisitionAssistList(tsc_IntList_3_4_5_10_18_19, //@sic R5-215711 sic@
                                                                                                                                          p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.gnss_AcquisitionAssistList),
                                                                                                   p_RetrievedGenericAssistData[i].gnss_AcquisitionAssistance.confidence_r10),
                                                                     cs_GNSS_Almanac_GLONASS(p_RetrievedGenericAssistData[i].gnss_Almanac),
                                                                     cs_GNSS_UTC_Model_1(p_RetrievedGenericAssistData[i].gnss_UTC_Model),
                                                                     fl_Build_cs_GNSS_AuxiliaryInformation(tsc_IntList_3_4_5_10_18_19,  //@sic R5-215711 sic@
                                                                                                           p_RetrievedGenericAssistData[i].gnss_AuxiliaryInformation));
      //Now remove those elements not needed depending on the case
      if (not (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS)) { //if GPS is not supported
        v_GenericAssistDataElement.gnss_TimeModels := omit; //Only present if GPS is also supported
        v_GenericAssistDataElement.gnss_UTC_Model := omit; // UTC-Model provided only if GLONASS and at least one other GNSS supported by the UE.
      }
      if (p_UEB) { // UE-Based case
        v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        v_GenericAssistDataElement.gnss_Almanac := omit;
      }
      else { //UE-Assisted case
        if (pc_GNSS_AA) { // UE supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_TimeModels := omit;
          v_GenericAssistDataElement.gnss_NavigationModel := omit;
          v_GenericAssistDataElement.gnss_Almanac := omit;
        }
        else { // UE does not supports GNSS Acquisition Assistance
          v_GenericAssistDataElement.gnss_AcquisitionAssistance := omit;
        }
      }
    }
    return v_GenericAssistDataElement;
  }

  /*
   * @desc      Selects template to provide GNSS-GenericAssistDataElement for A-Galileo
   * @param     p_RetrievedGenericAssistData
   * @param     p_UEB
   * @return    template (value) GNSS_GenericAssistDataElement
