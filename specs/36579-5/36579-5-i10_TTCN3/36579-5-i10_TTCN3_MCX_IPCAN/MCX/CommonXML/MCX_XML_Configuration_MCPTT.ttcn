  template (value) urn_3gpp_mcptt_user_profile_1_0.PointCoordinateType cs_MCPTT_UserProfile_PointCoordinate(float p_LatitudeDegrees,
                                                                                                            float p_LongitudeDegrees) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    longitude := f_MCX_LocationInfo_Degrees2Latitude(p_LatitudeDegrees),
    latitude := f_MCX_LocationInfo_Degrees2Longitude(p_LongitudeDegrees),
    anyExt := omit,
    elem_list := {}
  };

  template (value) urn_3gpp_mcptt_user_profile_1_0.EllipsoidArcType cs_MCPTT_UserProfile_EllipsoidArc(float p_LatitudeDegrees,
                                                                                                      float p_LongitudeDegrees) :=
  { /* @status    APPROVED (MCX) */
    /* default values according to 36.579-1 Table 5.5.8.3-1 */
    attr := omit,
    center := cs_MCPTT_UserProfile_PointCoordinate(p_LatitudeDegrees, p_LongitudeDegrees),
    radius := 10,              // 50 meters;   according to 23.032 clause 6.6 the radius is encoded as N (16 bit binary) with 5*N <= r < 5*(N+1)
    offsetAngle := 0,          // 0 degrees;   according to 23.032 clause 6.7 the offset angle (ao) is encoded as N (0..179) with 2*N <= ai < 2*(N+1)
    includedAngle := 179,      // 360 degrees; according to 23.032 clause 6.7 the included angle (ai) is encoded as N (0..179) with 2*N < ai <= 2*(N+1)
    elem_list := {},
    anyExt := omit
  };

  template (value) urn_3gpp_mcptt_user_profile_1_0.GeographicalAreaType cs_MCPTT_UserProfile_GeographicalArea(float p_LatitudeDegrees,
                                                                                                              float p_LongitudeDegrees) :=
