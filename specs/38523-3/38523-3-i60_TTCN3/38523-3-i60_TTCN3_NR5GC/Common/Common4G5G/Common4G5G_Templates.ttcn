module Common4G5G_Templates {

  import from Common4G5G_LoopBack all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EPS_NAS_TypeDefs all;
  import from NAS_CommonTypeDefs all;

  type float PTWLengthParameters[16]; /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, POS) */

  const integer tsc_Gnss_TOD_msec := 1800000;   /* Set to the  value: 0h30min00s000ms - Should be enough to cover the tset case duration
                                                   @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11, NR5GC, NR5GC_IRAT) */

  const MessageType tsc_MsgType_Update_UE_LocationInformation := oct2bit ('8B'O); /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11, NR5GC, NR5GC_IRAT) */

  const PTWLengthParameters tsc_PTWLengthParameters := { 1.28, 2.56, 3.84, 5.12, 6.4, 7.68, 8.96, 10.24, 11.52, 12.8, 14.08, 15.36, 16.64, 17.92, 19.20, 20.48 }; /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, POS) */

  template (value) ULGrant_Period_Type cs_ULGrant_OneTime := { OnlyOnce := true };       /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, NR5GC) */

  template (value) ULGrant_Period_Type cs_ULGrant_Period_Duration(integer p_Period) :=
  { /* @desc      Configured UL Grant transmission periodic */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    Duration := p_Period     /* duration of the grant period (TTI=1ms) */
  };

  template (value) TransmissionRepetition_Type cs_TransmissionRepetition_Continuous :=
  { /* Default UL Auto PUCCH Synch to be continous */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    Continuous := true
  };

  template (value) TransmissionRepetition_Type cs_TransmissionRepetitionCyclic(integer p_Cycles) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    NumOfCycles := p_Cycles
  };

  template (value) TransmissionRepetition_Type cs_TransmissionCycleOneTime := cs_TransmissionRepetitionCyclic(1); /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, NR5GC) */

  template (value) UL_GrantConfig_Type cs_UL_GrantConfig_OnSR :=
  { /* Default UL Grant transmission on reception of every SI reception */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    OnSR_Reception := true
  };

  template (value) UL_GrantConfig_Type cs_UL_GrantConfig_Stop :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    None  := true
  };

  template (value) UL_GrantConfig_Type cs_UL_GrantConfig_OneTime  :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, NR5GC) */
    Periodic := {
      Period          := cs_ULGrant_OneTime,
      NoOfRepetitions := cs_TransmissionCycleOneTime
    }
  };

  template (value) UL_GrantConfig_Type cs_UL_GrantConfig_ContPeriodic(integer p_Period)  :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, NR5GC) */
    Periodic := {
      Period          := cs_ULGrant_Period_Duration(p_Period),
      NoOfRepetitions := cs_TransmissionRepetition_Continuous
    }
  };

  template (value) UL_GrantConfig_Type cs_UL_GrantConfig_NoOfGrants (integer p_Period,
                                                                     integer p_Number) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, NR5GC) */
    Periodic := {
      Period          := cs_ULGrant_Period_Duration(p_Period),
      NoOfRepetitions := cs_TransmissionRepetitionCyclic(p_Number)
    }
  };

  template (value) RAR_RapIdCtrl_Type cs_RapIdCtrl_Auto :=
  { /* @status    APPROVED (ENDC, IMS, LTE, LTE_A_PRO, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    Automatic := true   /* SS shall automatically use same RAPID as received from the UE */
  };

  template (value) RAR_RapIdCtrl_Type cs_RapIdCtrl_UnMatched :=
  { /* @status    APPROVED (ENDC, LTE, NBIOT, NR5GC) */
    Unmatched := true   /* SS shall use RAPID being different from preamble sent by the UE;
                           SS shall calculate this RAPID acc. to RAPID := (RAPID + 3) mod 64 */
  };

  template (value) TimingInfo_Type cs_TimingInfo_Now := {Now := true};   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */

  template (value) SubFrameTiming_Type cs_SubFrameTiming(SystemFrameNumber_Type p_SFN,
                                                         SubFrameNumber_Type p_SubFrameNumber,
                                                         SystemFrameNumber_Type p_HyperSFN) :=
  { /* @status    APPROVED (ENDC, IMS, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5s110154 sic@ */
    SFN := { Number := p_SFN },
    Subframe := { Number := p_SubFrameNumber },
    HSFN := { Number := p_HyperSFN },         /* @sic R5w160204r1 sic@ */
    Slot := cs_SlotTimingInfo_FirstSlot,      /* @sic R5w180111: Slot sic@ */
    Symbol := cs_SymbolTimingInfo_FirstSlot   /* @sic R5w220211 sic@ */
  };

  template (value) TimingInfo_Type cs_TimingInfo_NR(SubFrameTiming_Type p_TimingInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    SubFrame := {
      SFN := p_TimingInfo.SFN,
      Subframe := p_TimingInfo.Subframe,
      HSFN := p_TimingInfo.HSFN,
      Slot := p_TimingInfo.Slot,
      Symbol := p_TimingInfo.Symbol    /* @sic R5w220211 sic@ */
    }
  };

 template (value) TimingInfo_Type cs_TimingInfo_SubFrame(SubFrameNumber_Type p_Subframe) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, NR5GC) */
    SubFrame := {
      SFN := { Any := true },
      Subframe := { Number := p_Subframe },
      HSFN := { Any := true  },                       /* @sic R5w160204r1 sic@ */
      Slot := cs_SlotTimingInfo_FirstSlot,            /* @sic R5w180111: Slot sic@ */
      Symbol := cs_SymbolTimingInfo_FirstSlot   /* @sic R5w220211 sic@ */
    }
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_FirstSlot :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    FirstSlot := true
  };

  template (value) SymbolTimingInfo_Type cs_SymbolTimingInfo_FirstSlot :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    FirstSymbol := true
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_Numerology0  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SlotOffset := { Numerology0 := true }
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_Numerology1 (integer p_SlotOffset)  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SlotOffset := { Numerology1 := p_SlotOffset }
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_Numerology2 (integer p_SlotOffset)  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SlotOffset := { Numerology2 := p_SlotOffset }
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_Numerology3 (integer p_SlotOffset)  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SlotOffset := { Numerology3 := p_SlotOffset }
  };

  template (value) SlotTimingInfo_Type cs_SlotTimingInfo_Numerology4 (integer p_SlotOffset)  :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SlotOffset := { Numerology4 := p_SlotOffset }
  };

  template (present) TimingInfo_Type cr_TimingInfo(template (present) SystemFrameNumber_Type p_SFN,
                                                   template (present) SubFrameNumber_Type p_Subframe,
                                                   template (present) SystemFrameNumber_Type p_HSFN := ?,
                                                   template (present) SlotTimingInfo_Type p_Slot := ?,
                                                   template (present) SymbolTimingInfo_Type p_Symbol := ?) :=
  {/* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, NR5GC) */
    SubFrame := {
      SFN := { Number := p_SFN },
      Subframe := { Number := p_Subframe },
      HSFN := { Number := p_HSFN },   /* @sic R5w160204r1 sic@ */
      Slot := p_Slot,                 /* @sic R5w180111: Slot sic@ @sic R5s180411 sic@ */
      Symbol := p_Symbol              /* @sic R5w220211 sic@ */
    }
  };

  template (present) TimingInfo_Type cr_TimingInfo_Any :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    SubFrame := {
      SFN := ? ,
      Subframe := ?,
      HSFN := ?,   /* @sic R5w160204r1 sic@ */
      Slot := ?,   /* @sic R5w180111: Slot sic@ */
      Symbol := ?  /* @sic R5w220211 sic@ */
    }
  };

  template (value) UPDATE_UE_LOCATION_INFORMATION cs_Update_UE_Location_Information (EllipsoidPointWithAltitude_Type p_EllipsoidPointWithAltitude,
                                                                                     HorizontalVelocity_Type p_HorizontalVelocity,
                                                                                     Gnss_TOD_msec_Type p_Gnss_TOD_msec) :=
  {  /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11, NR5GC, NR5GC_IRAT) */
      skipIndicator := tsc_Gen_SkipIndicator,
      protocolDiscriminator := tsc_LB_ProtocolDiscriminator,
      messageType := tsc_MsgType_Update_UE_LocationInformation,
      ellipsoidPointWithAltitude := p_EllipsoidPointWithAltitude,
      horizontalVelocity := p_HorizontalVelocity,
      gnss_TOD_msec := p_Gnss_TOD_msec
  }

  /*
   * @desc      auxiliary function to check whether timing info is "now"
   * @param     p_TimingInfo
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_TimingInfo_IsNow(template (value) TimingInfo_Type p_TimingInfo) return boolean
  {
    return match(valueof(p_TimingInfo), cs_TimingInfo_Now);
  }

  template (value) RlcBearerRouting_Type crs_RlcBearerRouting_None := { None := true };                                                     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) RlcBearerRouting_Type crs_RlcBearerRouting_Eutra(template (value) EUTRA_CellId_Type p_CellId) := { EUTRA := p_CellId };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) RlcBearerRouting_Type cs_RlcBearerRouting_NR(template (value) NR_CellId_Type p_NR_CellId) := { NR := p_NR_CellId };            /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) * @sic R5w190114: split of crs_RlcBearerRouting_NR sic@ */

  template (present) RlcBearerRouting_Type cr_RlcBearerRouting_NR(template (present) NR_CellId_Type p_NR_CellId) := { NR := p_NR_CellId };        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) * @sic R5w190114: split of crs_RlcBearerRouting_NR sic@ */

  template (value) IndicationStatus_Type cs_IndicationStatus_NoError :=
  { /* @status    APPROVED (ENDC, IMS, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    Ok := true
  };

  template (value) IndicationStatus_Type cs_IndicationStatus_NasIntegrityError :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Error := {
      Integrity := {
        Nas := true,
        Pdcp := false
      },
      System := 0
    }
  };

  /*
   * @desc      auxiliary function to set CNF flag for configuration ASPs
   * @param     p_TimingInfo
   * @param     p_CnfFlag           (default value: omit)
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_CnfFlag_Set(template (value) TimingInfo_Type p_TimingInfo,
                         template (omit) boolean p_CnfFlag := omit) return boolean
  {
    var boolean v_CnfFlag;
    
    if (isvalue(p_CnfFlag)) {
      v_CnfFlag := valueof(p_CnfFlag);
    } else {
      v_CnfFlag := f_TimingInfo_IsNow(p_TimingInfo);
    }
    return v_CnfFlag;
  }

}
