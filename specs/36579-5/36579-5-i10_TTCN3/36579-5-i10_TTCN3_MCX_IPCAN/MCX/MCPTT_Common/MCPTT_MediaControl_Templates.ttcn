  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_Ack(RTP_SSRC p_RTCP_SSRC_SS,
                                                            O1_Type p_MsgType) :=
  { // 36.579-1 Table 5.5.6.11-1
    /* @status    APPROVED (MCX) */
    ackMessage := {
      commonHdr := cs_FloorControl_CommonHdr('01010'B, p_RTCP_SSRC_SS),         // ACK subtype 24.380 clause 8.2.2.1
      source := cs_FloorControl_Source('0002'O),
      msgType := cs_FloorControl_MsgType(p_MsgType),
      trackInfo := omit,
      location := omit                          // @sic R5s221241: BASELINE MOVING 2022 09 sic@
    }
  };

  template (present) FloorControlMsg_Type cr_FloorCtrlMsg_Ack(template (present) RTP_SSRC p_RTCP_SSRC_UE,
                                                              O1_Type p_MsgType) :=
  { // 36.579-1 Table 5.5.6.11-1
    /* @status    APPROVED (MCX) */
    ackMessage := {
      commonHdr := cr_FloorControl_CommonHdr('01010'B, p_RTCP_SSRC_UE),                 // ACK subtype 24.380 clause 8.2.2.1
      source := cs_FloorControl_Source('0000'O),
      msgType := cr_FloorControl_MsgType(p_MsgType),
      trackInfo := omit,
      location := cr_FloorControl_Location(crs_FloorControl_LocationValue_NotProvided) ifpresent        // @sic R5s221241: BASELINE MOVING 2022 09 sic@
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_ReleaseMultiTalker(RTP_SSRC p_RTCP_SSRC_SS) :=
  { // 36.579-1 Table 5.5.6.12-1
    /* @status    APPROVED (MCX) */
    releaseMultiTalkerMessage := {
      commonHdr := cs_FloorControl_CommonHdr('01111'B, p_RTCP_SSRC_SS),         // Floor Release Multi Talker subtype 24.380 clause 8.2.2.1
      userId := fl_FloorControl_UserID(px_MCPTT_ID_User_B),
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator('1000010010000000'B)      // Normal call, queueing, multi-talker
    }
  };

  template (present) PreestablishedSessionControl_CommonHdr cr_PreestablishedSessionControl_CommonHdr(template (present) B5_Type p_Subtype,
                                                                                                      template (present) RTP_SSRC p_SSRC) :=
  /* @status    APPROVED (MCX) */
    cr_RTCP_APP_CommonHdr(p_Subtype, p_SSRC, tsc_MCPTT_MediaControl_MCPC);

  template (value) PreestablishedSessionControl_CommonHdr cs_PreestablishedSessionControl_CommonHdr(B5_Type p_Subtype,
                                                                                                    RTP_SSRC p_SSRC) :=
  /* @status    APPROVED (MCX) */
    cs_RTCP_APP_CommonHdr(p_Subtype, p_SSRC, tsc_MCPTT_MediaControl_MCPC);

  template (value) PreestablishedSessionControl_MediaStreams cs_PreestablishedSessionControl_MediaStreams(integer p_MediaStreamVal := 1,
                                                                                                          integer p_ControlStreamVal := 2) :=
  { /* @status    APPROVED (MCX) */
    id := '00'O,
    lgth := '02'O,
    mediaStreamVal := int2oct(p_MediaStreamVal, 1),
    controlStreamVal := int2oct(p_ControlStreamVal, 1)
  };

  template (value) PreestablishedSessionControl_SessionIdentity cs_PreestablishedSessionControl_SessionIdentity(integer p_Length,
                                                                                                                O1_Type p_SessionType,
                                                                                                                octetstring p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '01'O,
    lgth := int2oct(p_Length, 1),
    sessionType := p_SessionType,
    val := p_Val,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      24.380 clause 8.3.3.3
   * @param     p_CallType
   * @param     p_SessionIdentity
   * @return    template (value) PreestablishedSessionControl_SessionIdentity
   * @status    APPROVED (MCX)
   */
  function f_PreestablishedSessionControl_SessionIdentity(MCX_CallType_Type p_CallType,
                                                          charstring p_SessionIdentity) return template (value) PreestablishedSessionControl_SessionIdentity
  {
    var integer v_Length := lengthof(p_SessionIdentity) + 1;
    var octetstring v_String := char2oct(p_SessionIdentity);
    var B8_Type v_SessionType;

    select (p_CallType) {
      case (PRIVATE_CALL, FIRST_TO_ANSWER) {
        v_SessionType := '00000001'B;  // private
      }
      case (GROUP_CALL) {
        v_SessionType := '00000011'B;  // prearanged
      }
      case (CHAT_GROUP_CALL) {
        v_SessionType := '00000100'B;  // chat
      }
      case else {
        v_SessionType := '00000000'B;
        FatalError(__FILE__, __LINE__, "");
      }
    }
    return cs_PreestablishedSessionControl_SessionIdentity(v_Length, bit2oct(v_SessionType), v_String);
  }

  template (value) PreestablishedSessionControl_GroupIdentity cs_PreestablishedSessionControl_GroupIdentity(integer p_Length,
                                                                                                            octetstring p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '03'O,
    lgth := int2oct(p_Length, 1),
    val := p_Val,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up cs_PreestablishedSessionControl_GroupIdentity
   * @param     p_GroupIdentity
   * @return    template (value) PreestablishedSessionControl_GroupIdentity
   * @status    APPROVED (MCX)
   */
  function f_PreestablishedSessionControl_GroupIdentity(charstring p_GroupIdentity) return template (value) PreestablishedSessionControl_GroupIdentity
  {
    var integer v_Length := lengthof(p_GroupIdentity);
    var octetstring v_String := char2oct(p_GroupIdentity);
    return cs_PreestablishedSessionControl_GroupIdentity(v_Length, v_String);
  }

  template (value) PreestablishedSessionControl_AnswerState cs_PreestablishedSessionControl_AnswerState(O2_Type p_Val := '0001'O) :=
  { /* @status    APPROVED (MCX) */
    id := '04'O,
    lgth := '02'O,
    val := p_Val
  };

  template (value) PreestablishedSessionControl_InvitingUserIdentity cs_PreestablishedSessionControl_InvitingUserIdentity(integer p_Length,
                                                                                                                          octetstring p_Val) :=
  { /* @status    APPROVED (MCX) */
    id := '05'O,
    lgth := int2oct(p_Length, 1),
    val := p_Val,
    padding := f_MCX_MediaControlField_Padding(p_Length)
  };

  /*
   * @desc      Build up cs_PreestablishedSessionControl_InvitingUserIdentity
   * @param     p_InvitingUserIdentity
   * @return    template (value) PreestablishedSessionControl_InvitingUserIdentity
   * @status    APPROVED (MCX)
   */
  function f_PreestablishedSessionControl_InvitingUserIdentity(charstring p_InvitingUserIdentity) return template (value) PreestablishedSessionControl_InvitingUserIdentity
  {
    var integer v_Length := lengthof(p_InvitingUserIdentity);
    var octetstring v_String := char2oct(p_InvitingUserIdentity);
    return cs_PreestablishedSessionControl_InvitingUserIdentity(v_Length, v_String);
  }

  template (present) PreestablishedSessionControl_ReasonCode cr_PreestablishedSessionControl_ReasonCode(O2_Type p_Val := '0000'O) :=
  { /* @status    APPROVED (MCX) */
    id := '06'O,
    lgth := '02'O,
    val := p_Val
  };

  template (value) PreestablishedSessionControlMsg_Type cs_PreestablishedSessionControl_Connect(RTP_SSRC p_RTCP_SSRC_SS,
                                                                                                template (value) PreestablishedSessionControl_SessionIdentity p_SessionIdentity,
                                                                                                template (omit)  PreestablishedSessionControl_GroupIdentity p_GroupIdentity,
                                                                                                template (value) PreestablishedSessionControl_MediaStreams p_MediaStreams,
                                                                                                template (value) PreestablishedSessionControl_AnswerState p_AnswerState,
                                                                                                template (value) PreestablishedSessionControl_InvitingUserIdentity p_InvitingUserIdentity,
                                                                                                MCX_MediaControl_AckRequest_Type p_AckRequest) :=
  { // 36.579-1 Table 5.5.6.12-1
    // The SSRC field shall carry the SSRC of the participating MCPTT function TS 24.380 8.3.4
    /* @status    APPROVED (MCX) */
    connectMessage := {
      commonHdr := cs_PreestablishedSessionControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00000'B, p_AckRequest), p_RTCP_SSRC_SS),
      sessionIdentity := p_SessionIdentity,
      groupIdentity := p_GroupIdentity,
      mediaStreams := p_MediaStreams,
      warningText := omit,
      answerState := p_AnswerState,
      invitingUserIdentity := p_InvitingUserIdentity,
      invitedUserIdentity := omit,                // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      pckIMessage := omit
    }
  };

  template (value) PreestablishedSessionControlMsg_Type cs_PreestablishedSessionControl_Disconnect(RTP_SSRC p_RTCP_SSRC_SS,
                                                                                                   template (value) PreestablishedSessionControl_SessionIdentity p_SessionIdentity,
                                                                                                   MCX_MediaControl_AckRequest_Type p_AckRequest) :=
  { // 36.579-1 Table 5.5.6.13-1
    // The SSRC field shall carry the SSRC of the participating MCPTT function TS 24.380 8.3.5
    /* @status    APPROVED (MCX) */
    disconnectMessage := {
      commonHdr := cs_PreestablishedSessionControl_CommonHdr(f_MCX_MediaControlSubtype_TX('00001'B, p_AckRequest), p_RTCP_SSRC_SS),
      sessionIdentity := p_SessionIdentity,
      reasonCause := omit                         // @sic R5s221241: BASELINE MOVING 2022 09 - new field sic@
    }
  };

  template (present) PreestablishedSessionControlMsg_Type cr_PreestablishedSessionControl_Acknowledge(template (present) RTP_SSRC p_RTCP_SSRC_UE) :=
  { // 36.579-1 Table 5.5.6.14-1
    // The SSRC field shall carry the SSRC of the floor participant TS 24.380 8.3.6
    /* @status    APPROVED (MCX) */
    acknowledgeMessage := {
      commonHdr := cr_PreestablishedSessionControl_CommonHdr('00010'B, p_RTCP_SSRC_UE),
      reasonCode := cr_PreestablishedSessionControl_ReasonCode
    }
  };

}
