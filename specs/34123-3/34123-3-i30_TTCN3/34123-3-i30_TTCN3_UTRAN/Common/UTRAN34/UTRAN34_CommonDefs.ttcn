module UTRAN34_CommonDefs {

  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};

  type enumerated UTRAN34_3C4C_Configuration_Type { /* @status    APPROVED (UTRAN) */
    C3_SingleBand,
    C3_SingleBand_Mimo,
    C3_DualBand,
    C3_DualBand_Mimo,
    C4_DualBand,
    C4_DualBand_Mimo
  };

  type record length(1..4) of HSPA_InfoPerCell_Type HSPA_InfoPerCellList_Type;   /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  type record length(1..2) of TFRCconfigure_r10OrLaterExtensionType TFRCconfigure_ExtList_Type;      /* @sic R5-145142 sic@
                                                                                                        @status    APPROVED (IMS, SSNITZ, UTRAN) */

  type record HSPA_InfoPerCell_Type {   /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    // 64 QAM
    boolean dl_64QAM,
    HS_SCCH_Info_r9 hS_SCCH_Info,
    // OCTETALIGNED
    boolean octetAlignedConfigured,
    HS_DSCH_TBSizeTable hS_DSCH_TBSizeTable  optional
  };

  type record UTRAN34_HSPA_Parameters_Type {      /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    // HSPA parameters specific per cell
    HSPA_InfoPerCellList_Type hSPA_InfoPerCell,
    // RLC parameters
    TransmissionWindowSize transmissionWindowSize,
    ReceivingWindowSize receivingWindowSize,
    // MIMO parameters
    boolean mimo,
    MIMO_Parameters_r9 mimo_Parameters_r9 optional,
    // Channelisation codes
    SF512_AndCodeNumber dl_DPCH_SFC,
    integer dl_FDPCH_Code,
    ChannelisationCode256 s_CPICH_ChCode optional,
    // TFRC configuration
    TFRCconfigure_ExtList_Type TFRCconfigure_ExtList optional, //@sic R5-145142 sic@: Renaming and changing to a list to accomodate TFRCs for different NodeBs (Multiflow inter-NodeB)
    DeltaACK     deltaACK,
        DeltaNACK    deltaNACK,
    ACK_NACK_repetitionFactor  ack_NACK_repetition_factor,
    HARQ_Info_r7 hARQ_Info_r7
  };

  type PagingRecord.utran_Identity.cn_OriginatedPage_connectedMode_UE CN_OriginatedPage_connectedMode_UE_Type; /* @status    APPROVED (UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell1 := '0000000000000000000000000001'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell2 := '0000000000000000000000000010'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell3 := '0000000000000000000000000011'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell5 := '0000000000000000000000000101'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell6 := '0000000000000000000000000110'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell7 := '0000000000000000000000000111'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_CellIdCell8 := '0000000000000000000000001000'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell1 := '0000000000000001'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell2 := '0000000000000010'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell3 := '0000000000000011'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell4 := '0000000000000100'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell5 := '0000000000000101'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell6 := '0000000000000110'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell7 := '0000000000000111'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const bitstring       tsc_UTRAN34_URA_IdCell8 := '0000000000001000'B;  /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset1 := 0;           /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset2 := 0;           /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset3 := 0;           /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset4 := 3000;        /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset5 := 3000;        /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset6 := 678;         /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset7 := 1356;        /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_UTRAN34_SFN_Offset8 := 2034;        /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_S_CPICH := 3;                       /* Physical channel identity for secondary CPICH channel
                                                                   @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const integer         tsc_S_CPICH_ScrC := 0;                  /* secondary scrambling code for S-CPICH (used in MIMO configurations)
                                                                   @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const ChannelisationCode256 tsc_S_CPICH_ChC := 13;            /* Channelization code for tsc_S_CPICH
                                                                   @status    APPROVED (UTRAN) */

  const ChannelisationCode256 tsc_S_CPICH_ChC29 := 29;          /* Channelization code for tsc_S_CPICH
                                                                   @status    APPROVED (UTRAN) */

  const SF512_AndCodeNumber      tsc_Sfc256_C12 := { sf256 := 12 };   /* @status    APPROVED (IMS, SSNITZ, UTRAN) */

  const SF512_AndCodeNumber      tsc_Sfc256_C11 := { sf256 := 11 };   /* @status    APPROVED (UTRAN) */

  const SF512_AndCodeNumber      tsc_Sfc256_C13 := { sf256 := 13 };   /* @status    APPROVED (UTRAN) */

  const integer tsc_MACehs_Queue0_DTCH := 0;                    /* @status    APPROVED (UTRAN) */

  const integer tsc_MACehs_Queue1_DCCH := 1;                    /* @status    APPROVED (UTRAN) */

  const   SecondaryScramblingCode tsc_DL_DPCH_ScrC_3 := 3;      /* Secondary scrambling code for DL PDCH
                                                                   @status    APPROVED (UTRAN) */

  const integer tsc_AttOff := 0;                                /* Attach flag value Off
                                                                   @status    APPROVED (UTRAN) */

  const octetstring tsc_LAC_2 := '0002'O;                       /* @status    APPROVED (UTRAN) */

  const octetstring tsc_PTMSI_2 := 'C2345679'O;                 /* @status    APPROVED (UTRAN) */

  const octetstring tsc_PTMSISig_2 := 'AB1235'O;                /* @status    APPROVED (UTRAN) */

  const octetstring tsc_PTMSISig_3 := '030401'O;                /* @status    APPROVED (UTRAN) */

  const HS_SCCH_Codes            tsc_HS_SCCH_ChC4 := 4;                          /* Channelization code for HS-SCCH when 64QAM is configured and no E-DCH is configured
                                                                                    @status    APPROVED (UTRAN) */

  const HS_SCCH_Codes            tsc_HS_SCCH_ChC5 := 6;                          /* Channelization code for HS-SCCH when 64QAM is configured and no E-DCH is configured
                                                                                    @status    APPROVED (UTRAN) */

  const HS_SCCH_Codes            tsc_HS_SCCH_ChC6 := 6;                          /* Channelization code for HS-SCCH when 64QAM is configured
                                                                                    @status    APPROVED (UTRAN) */

  const MAC_ehs_QueueId          tsc_MAC_ehs_Q0 := 0;                            /* MAC-ehs QUEUE ID 0
                                                                                    @status    APPROVED (UTRAN) */

  const MAC_ehs_QueueId          tsc_MAC_ehs_Q1 := 1;                            /* MAC-ehs QUEUE ID 1
                                                                                    @status    APPROVED (UTRAN) */

  const MAC_LogicalChannelPriority tsc_MAC_LogicalChannelPrio5 := 5;             /* @status    APPROVED (UTRAN) */

  const integer tsc_AccessClassX := 3;                          /* An arbitrary access class x (0-15)
                                                                   @status    APPROVED (UTRAN) */

  const integer         tsc_T3212 := 360000;                    /* 6 min/1 deci hours/360000 msec [same as TTCN-2]
                                                                   @status    APPROVED (UTRAN) */

  const octetstring     tsc_T3212_1 := '01'O;                   /* 6 min/1 deci hours
                                                                   @status    APPROVED (UTRAN) */

  const octetstring     tsc_T3212_5 := '05'O;                   /* 30 min/5 deci hours(30mins)
                                                                   @status    APPROVED (UTRAN) */

  const float tsc_DelayTransmitFACH := 0.1;                     /* Waiting time before (re) configuration, FACH->DCH in seconds
                                                                   @status    APPROVED (UTRAN) */

}
