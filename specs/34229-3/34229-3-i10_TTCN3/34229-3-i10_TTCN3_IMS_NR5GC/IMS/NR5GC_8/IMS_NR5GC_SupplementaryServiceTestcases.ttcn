  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.3.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_3_NR5GC_IMS1() runs on IMS_PTC
  { // Originating Identification Restriction / Signalling / 5GS

    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Invite;
    var boolean v_OriginatingIdentificationRestriction := true;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 7" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, -, normalCallOIR);
    
    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(-, v_OriginatingIdentificationRestriction);  // @sic R5-225935: A_4_1 -> A_4_1a sic@
    v_MessageHeader_Invite := v_InviteRequestWithSdp.Invite.msgHeader;
    f_IMS_MessageHeader_CheckFromAnonymous(v_MessageHeader_Invite);
    f_IMS_MessageHeader_CheckPrivacy(v_MessageHeader_Invite, idOrHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    // @siclog "Step 9 - 19" siclog@
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_12(v_InviteRequestWithSdp);                                            // @sic R5-225935: A_4_1 -> A_4_1a sic@

    // @siclog "Step 20 - 22" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.6.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_6_NR5GC_IMS1() runs on IMS_PTC
  { // Terminating Identification Restriction / Signalling / 5GS

    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var MessageHeader v_MessageHeader_Response;
    var SipUrl v_ContactUrl;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_UT_MMI_ActivateIMS_TIR(MMI);
    
    // @siclog "Step 1 - 8" siclog@
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);
    
    // @siclog "Step 9" siclog@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(tsc_SDP_WithPreconditions);                           /* @sic R5-233373: A_5_1a (EVS_A2) sic@ */

    // @siclog "Step 10 - 11" siclog@
    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(v_InviteRequestWithSdp, tsc_SDP_WithPreconditions);      /* @sic R5-233373: A_5_1a (EVS_A2) sic@ */
    v_MessageHeader_Response := v_ResponseWithSdp.Response.msgHeader;
    f_IMS_MessageHeader_CheckPrivacy(v_MessageHeader_Response);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 12 - 13" siclog@
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_MessageHeader_Response);
    
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall);

    // @siclog "Step 14 - 15" siclog@
    f_IMS_MTCallSetup_NR5GC_A_5_1a_Step6_7(v_InviteRequestWithSdp, v_ResponseWithSdp);
    
    // @siclog "Step 16 - 18" siclog@
    v_MessageHeader_Response := f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, -, tsc_SDP_WithPreconditions);
    f_IMS_MessageHeader_CheckPrivacy(v_MessageHeader_Response);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");

    // @siclog "Step 19" siclog@
    f_UT_AnswerCall(MMI);

    // @siclog "Step 20 - 21" siclog@
    v_ResponseWithSdp := f_IMS_MTCallSetup_Receive200OK_SendACK(v_InviteRequestWithSdp);
    v_MessageHeader_Response := v_ResponseWithSdp.Response.msgHeader;
    f_IMS_MessageHeader_CheckPrivacy(v_MessageHeader_Response);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    f_IMS_TestBody_Set(false);

    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrl);
    
    f_UT_MMI_DeactivateIMS_TIR(MMI);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.8.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_8_NR5GC_IMS1() runs on IMS_PTC
  { // Communication Forwarding Unconditional / Signalling / 5GS

    var template (value) SipUrl v_TargetedTo := f_SIP_BuildSipUri_TX("sip:user@company.com");
    var template (value) HistoryInfo v_HistoryInfo := cs_HistoryInfo(v_TargetedTo);
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var template (value) MessageHeader v_MessageHeader18X;
    var template (value) SDP_Message v_SDP_Message;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 7" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();                           // @sic R5-225936: A_4_1 -> A_4_1a sic@
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    // @siclog "Step 9" siclog@
    f_IMS_MOCallSetup_Send100Trying(v_InviteRequestWithSdp);

    // @siclog "Step 10" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine181, f_IMS_InviteResponse_181_MessageHeaderTX(v_InviteRequestWithSdp.Invite, v_TargetedTo))));

    // @siclog "Step 11" siclog@
    v_MessageHeader18X := f_IMS_InviteResponse_183_MessageHeaderTX(v_InviteRequestWithSdp.Invite);
    v_SDP_Message := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2, 65);   // @sic R5-225936: EVS_A2 sic@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine183, v_MessageHeader18X, cs_MessageBody_SDP(v_SDP_Message))));

    // @siclog "Step 12 - 13" siclog@
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_MessageHeader18X);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);     // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1

    // @siclog "Step 14 - 15" siclog@
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);                             // @sic R5-225936: A_4_1 -> A_4_1a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    // @siclog "Step 16 - 18" siclog@
    v_MessageHeader18X := f_IMS_InviteResponse_180_MessageHeaderTX(v_InviteRequestWithSdp.Invite, -, -, tsc_OptionTagList_100rel);
    v_MessageHeader18X.historyInfo := v_HistoryInfo;
    f_IMS_MOCallSetup_Send18X_Reliable(v_InviteRequestWithSdp, c_statusLine180, v_MessageHeader18X);

    // @siclog "Step 19 - 20" siclog@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp, -, -, v_HistoryInfo);

    // @siclog "Step 21 - 22" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      34.229-5 A.15.1a
   * @param     p_CalleeUri         (default value: px_IMS_CalleeUri)
   * @param     p_CalleeContactUri  (default value: px_IMS_CalleeContactUri)
   * @param     p_RadioBearersEstablished (default value: false)
   * @return    IMS_CC_MO_CallInfo_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MOCallSetup_NR5GC_A_15_1a(charstring p_CalleeUri := px_IMS_CalleeUri,
                                           charstring p_CalleeContactUri := px_IMS_CalleeContactUri,
                                           boolean p_RadioBearersEstablished := false) runs on IMS_PTC return IMS_CC_MO_CallInfo_Type
  { /* @sic R5-231490: p_EvsConfigurationFor5G sic@ */
    /* @sic R5-233372: p_EvsConfigurationFor5G removed as A.15.1 is not used anymore sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (present) SipUrl v_CalleeSipUrl := f_SIP_BuildSipUri_RX(p_CalleeUri);
    var template (value) SDP_Message v_InitialSdpAnswer;
    var template (present) SDP_Message v_UpdatedSdpOffer;

    // step 1                           INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall, v_CalleeSipUrl, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2);

    // step 2 - 7
    v_InitialSdpAnswer := f_IMS_BuildSDP_InitialAnswerAudioVideo_TX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer, EVS_16000, H265_90000, EVS_A2);
    v_UpdatedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudioVideo_RX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer, EVS_16000, H265_90000);
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step2_7(IPCAN_MO_VideoCall, v_InviteRequestWithSdp, p_CalleeContactUri, -, v_InitialSdpAnswer, v_UpdatedSdpOffer, -, p_RadioBearersEstablished);

    // step 8 - 12                      180 Ringing, PRACK, 200 OK for PRACK, 200 OK for INVITE, ACK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step8_12(v_InviteRequestWithSdp, p_CalleeContactUri);

    return v_CallInfo;
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 8.26.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_26_NR5GC_IMS1() runs on IMS_PTC
  { // MO Voice Call Hold without announcement / 5GS
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var INVITE_Request v_InviteRequest;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a();             /* @sic R5-231502: f_IMS_MOCallSetup_NR5GC_A_4_1a instead of f_IMS_MOCallSetup_NR5GC_A_4_1 sic@ */
    v_InviteRequest := v_CallInfo.InviteRequestWithSdp.Invite;

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_UT_CallHold(MMI);

    // @siclog "Step 2 - 5" siclog@
    f_IMS_MOCallHoldResume(HOLD, v_InviteRequest, v_CallInfo.MessageHeader183, v_CallInfo.LatestSdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    // @siclog "Step 6" siclog@
    f_UT_CallResume(MMI);

    // @siclog "Step 7 - 10" siclog@
    f_IMS_MOCallHoldResume(RESUME, v_InviteRequest, v_CallInfo.MessageHeader183, v_CallInfo.LatestSdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 9 - 10" siclog@
    f_IMS_CallReleaseMO(v_InviteRequest);
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

