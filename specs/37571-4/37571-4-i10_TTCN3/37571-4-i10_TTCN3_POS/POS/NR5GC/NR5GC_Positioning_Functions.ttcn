    f_POS_NR_CheckCapabilities_NR_DL_TDOA_Measurements (p_NrDlTdoaProvideCapabilities.nr_DL_TDOA_MeasurementCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_QCL_Processing (p_NrDlTdoaProvideCapabilities.nr_DL_PRS_QCL_ProcessingCapability_r16);
    f_POS_NR_CheckCapabilities_NR_DL_PRS_Processing (p_NrDlTdoaProvideCapabilities.nr_DL_PRS_ProcessingCapability_r16);

    if (pc_DL_TDOA_additionalPathsReport != ispresent(p_NrDlTdoaProvideCapabilities.additionalPathsReport_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA additionalPathsReport");
    }
    if (isvalue(p_NrDlTdoaProvideCapabilities.periodicalReporting_r16)) {
      if (not(f_POS_NR_CheckCapabilities_PeriodicalReporting(p_NrDlTdoaProvideCapabilities.periodicalReporting_r16,
                                                     pc_DL_TDOA_periodicalReporting_standalone,
                                                     pc_DL_TDOA_periodicalReporting_UEB,
                                                     pc_DL_TDOA_periodicalReporting_UEA))) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL TDOA periodical reporting");
      }
    }
    if (pc_mg_ActivationRequest_DL_TDOA != ispresent(p_NrDlTdoaProvideCapabilities.mg_ActivationRequest_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL-TDOA mg_ActivationRequest");
    }
    if (pc_posMeasGapSupport_DL_TDOA != ispresent(p_NrDlTdoaProvideCapabilities.posMeasGapSupport_r17)) { // @sic R5-235341 sic@
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL-TDOA posMeasGapSupport");
    }
  }

  /*
   * @desc      Function to check NR DL PRS resources capabilities provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-7
   * @param     p_NrDlPrsProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_DL_PRS_Resources (NR_DL_PRS_ResourcesCapability_r16  p_NrDlPrsProvideCapabilities) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    if (pc_maxNrOfDL_PRS_ResourceSetPerTrpPerFrequencyLayer != p_NrDlPrsProvideCapabilities.maxNrOfDL_PRS_ResourceSetPerTrpPerFrequencyLayer_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL PRS maxNrOfDL-PRS-ResourceSetPerTrpPerFrequencyLayer-r16");
    }
    if (pc_maxNrOfTRP_AcrossFreqs != p_NrDlPrsProvideCapabilities.maxNrOfTRP_AcrossFreqs_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL PRS maxNrOfTRP-AcrossFreqs-r16");
    }
    if (pc_maxNrOfPosLayer != p_NrDlPrsProvideCapabilities.maxNrOfPosLayer_r16) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL PRS maxNrOfPosLayer-r16");
    }
    f_POS_NR_CheckCapabilities_Dl_PRS_ResourcesCapabilityBandList (p_NrDlPrsProvideCapabilities.dl_PRS_ResourcesCapabilityBandList_r16);
    f_POS_NR_CheckCapabilities_Dl_PRS_ResourcesBandCombinationList (p_NrDlPrsProvideCapabilities.dl_PRS_ResourcesBandCombinationList_r16);
  }

  /*
   * @desc      Function to check NR DL-PRS-ResourcesCapabilityBandList provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-7
   * @param     p_NrDlPrsResourcesCapabilityBandList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_Dl_PRS_ResourcesCapabilityBandList (NR_DL_PRS_ResourcesCapability_r16.dl_PRS_ResourcesCapabilityBandList_r16 p_NrDlPrsResourcesCapabilityBandList) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    var integer v_Index;
    var boolean v_Found_MaxNrOfDL_PRS_ResourcesPerResourceSet := false;
    var boolean v_Found_MaxNrOfDL_PRS_ResourcesPerPositioningFrequencylayer := false;

    for (v_Index := 0; v_Index < lengthof(p_NrDlPrsResourcesCapabilityBandList); v_Index:=v_Index+1) {
      fl_CheckNRBandCapability(p_NrDlPrsResourcesCapabilityBandList[v_Index].freqBandIndicatorNR_r16); // checks freqBandIndicatorNR-r16 against capability PICS

      if (p_NrDlPrsResourcesCapabilityBandList[v_Index].maxNrOfDL_PRS_ResourcesPerResourceSet_r16 == pc_maxNrOfDL_PRS_ResourcesPerResourceSet) {
        v_Found_MaxNrOfDL_PRS_ResourcesPerResourceSet := true;
      }
      if (p_NrDlPrsResourcesCapabilityBandList[v_Index].maxNrOfDL_PRS_ResourcesPerPositioningFrequencylayer_r16 == pc_maxNrOfDL_PRS_ResourcesPerPositioningFrequencylayer) {
        v_Found_MaxNrOfDL_PRS_ResourcesPerPositioningFrequencylayer := true;
      }
    }
    if (not (v_Found_MaxNrOfDL_PRS_ResourcesPerResourceSet and v_Found_MaxNrOfDL_PRS_ResourcesPerPositioningFrequencylayer)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for Dl_PRS_ResourcesCapabilityBandList");
    }
  }

  /*
   * @desc      Function to check NR DL-PRS-ResourcesBandCombinationList provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-7
   * @param     p_NrDlPrsResourcesBandCombinationList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_Dl_PRS_ResourcesBandCombinationList (NR_DL_PRS_ResourcesCapability_r16.dl_PRS_ResourcesBandCombinationList_r16 p_NrDlPrsResourcesBandCombinationList) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    var integer v_Index;
    var boolean v_Found_MaxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_Fr1_Only := false;
    var boolean v_Found_MaxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_Fr2_Only := false;
    var boolean v_Found_MaxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_Fr1_FR2Mix := false;

    for (v_Index := 0; v_Index < lengthof(p_NrDlPrsResourcesBandCombinationList); v_Index:=v_Index+1) {
      if (ischosen(p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr1_Only_r16) and
          (p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr1_Only_r16 == pc_maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_fr1_Only)) {
        v_Found_MaxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_Fr1_Only := true;
      }
      if (ischosen(p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr2_Only_r16) and
          (p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr2_Only_r16 == pc_maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_fr2_Only)) {
