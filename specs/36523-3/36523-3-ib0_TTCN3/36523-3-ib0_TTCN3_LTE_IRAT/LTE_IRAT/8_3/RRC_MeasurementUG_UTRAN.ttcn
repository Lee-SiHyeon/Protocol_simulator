    f_UTRAN_ReleaseCell(utran_Cell7, f_UTRAN_CellInfo_GetConfigType (utran_Cell7));
    
  } //end of testcase 8.3.2.11

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.3.3.2
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_8_3_3_2_UTRAN() runs on UTRAN_IRAT_PTC
  { // Measurement configuration control and reporting / SON / ANR: CGI reporting of UTRAN cell
    var integer v_T0_CPICH_Cell5 := tsc_AttenuationCellOFF;
    var integer v_T0_PCCPCH_Cell5 := tsc_AttenuationCellOFF;

    var integer v_T1_CPICH_Cell5 := -75;
    var integer v_T1_PCCPCH_Cell5 := -78;
    
    var PLMN_Identity v_PLMN3; //@sic R5s110598 sic@
    var PLMN_IdentityWithOptionalMCC_r6 v_PLMN2; //@sic R5s110598 sic@
            
    v_PLMN3 := {mcc := {0,0,1}, mnc := {0,3}};//@sic R5s110598 sic@ //PLMN3 according to 36.523-1 Table 8.3.3.2.3.3-1B
    v_PLMN2 := {mcc := {0,0,1}, mnc := {0,2}};//@sic R5s110598 sic@ //PLMN2 according to 36.523-1 Table 8.3.3.2.3.3-1B

    
    //Initialise test case
    f_UTRAN_Init(EUTRA_UTRAN);
    
    f_UTRAN_CellInfo_SetPLMNIdentity (utran_Cell5, v_PLMN3); //@sic R5s110598 sic@
               
    f_UTRAN_CellInfo_SetMultiplePLMNIdentities (utran_Cell5, v_PLMN3, {v_PLMN2}); //@sic R5s120770 sic@
     
    f_UTRAN_Send_IR_SysInfoToEUTRA(utran_Cell5);
        
    //Create UTRAN cell and broadcast System Infomation
    f_UTRAN_SS_CreateCellFACH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
        
    //Trigger: Set cell power: T0
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
        
    f_UTRAN_TestBody_Set(true);

     
    //------------------------------------------------
    //Start TestBody
    
    //Trigger: The SS changes Cell 5 power level according to the row "T1" in table 8.3.3.2.3.2-1.
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    //@siclog "Step 3" siclog@
    f_UTRAN_SetCellPower(utran_Cell5, v_T1_CPICH_Cell5, v_T1_PCCPCH_Cell5);
    
    //Wait for the end of the test
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    
    //End TestBody
    //------------------------------------------------
    
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_ReleaseCell(utran_Cell5, f_UTRAN_CellInfo_GetConfigType (utran_Cell5)); // @sic R5s110176 sic@
    
  } //end of testcase 8.3.3.2

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.3.4.4
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_8_3_4_4_UTRAN() runs on UTRAN_IRAT_PTC
  { //Inter-RAT SI acquisition / RRC_CONNECTED / UMTS member CSG cell
    var integer v_CPICH_Minus60;
    var integer v_PCCPCH_Minus62;
    var integer v_CPICH_Minus64; //@sic R5-260152 sic@
    var integer v_PCCPCH_Minus64; //@sic R5-260152 sic@
    var B28_Type v_CellIdentity := f_UTRAN_GetCellIndentity(utran_Cell5);
    var CSG_Identity v_CSG_Identity_Cell5 :='000000000000000000000000010'B;
    
    var octetstring v_PLMN;

    v_CPICH_Minus60 := -60;
    v_PCCPCH_Minus62 := -62;
    v_CPICH_Minus64 := -64; //@sic R5-260152 sic@
    v_PCCPCH_Minus64 := -64; //@sic R5-260152 sic@

    // Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    
    v_PLMN := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(utran_Cell5));
    
    f_UTRAN_Send_IR_SysInfoToEUTRA(utran_Cell5);
    
    //Update MIB and SIB3 of cell 5
    f_UTRAN_SysInfo_SetMIB_SetSIB5bisType (utran_Cell5, cds_MIB_Csg(cs_UTRAN_HPLMN_Def)); //@sic R5s150943 sic@
    f_UTRAN_SysInfo_SetSIB3 (utran_Cell5,
                             cds_SIB3_Csg (v_CellIdentity, v_CSG_Identity_Cell5, cs_CSG_PSCSplitInfo(13, psc5)));
    
    // Create and configure Cell 5
    f_UTRAN_SS_CreateCellFACH (utran_Cell5);
    // Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    
    //Insert a USIM containing default values expect service n86 (TS 31.102) is "available", but the Allowed CSG List shall be empty
    f_UT_USIM_Insert (UT, "USIM with service n86 available");
    // Empty UE Allowed CSG list in USIM
    f_UTRAN_EmptyACSGL(utran_Cell5, {v_CSG_Identity_Cell5}); //@sic R5s151002 sic@
    // Broadcast correct CSG id
    f_UTRAN_SysInfo_SetSIB3_CSG_Identity (utran_Cell5, v_CSG_Identity_Cell5);
    f_UTRAN_SysInfoModifySIB3(utran_Cell5, f_UTRAN_SysInfo_GetSIB3(utran_Cell5));
    
    // Add the CSG ID of Cell 5 in USIM
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_CPICH_Minus60, v_PCCPCH_Minus62);
    
    f_UT_SwitchOnUE(UT, false);
    
    f_UT_ManualPLMN_CSG(UT ,v_PLMN, v_CSG_Identity_Cell5, "UTRAN"); //@sic R5s160009 sic@
    
    f_UTRAN_IdleUpdated (utran_Cell5); //@sic R5-121802 sic@
    f_UTRAN_SwitchPower_Off (utran_Cell5, U1_IDLE, NotSpecified);
    f_UTRAN_SetCellPower(utran_Cell5, tsc_AttenuationCellOFF);
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UTRAN_TestBody_Set (true);
    
    // The SS re-adjusts the cell-specific reference signal levels according to row "T1" in table 8.3.4.4.3.2-1.
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    // @siclog "Step 3" siclog@
    f_UTRAN_SetCellPower(utran_Cell5, v_CPICH_Minus64, v_PCCPCH_Minus64); //@sic R5-260152 sic@
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    //Wait for the end of the test
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    
    //End TestBody
    //------------------------------------------------
    
    f_UTRAN_TestBody_Set(false);
    
    //Clear USIM (empty UE Allowed CSG list in USIM) and release cell
    f_UTRAN_Remove_CSG_From_ACSGL(utran_Cell5, v_CSG_Identity_Cell5); //@sic R5s151002 sic@
    
    f_UTRAN_ReleaseCell(utran_Cell5, f_UTRAN_CellInfo_GetConfigType (utran_Cell5));
    
  } // end of f_TC_8_3_4_4_UTRAN

}
