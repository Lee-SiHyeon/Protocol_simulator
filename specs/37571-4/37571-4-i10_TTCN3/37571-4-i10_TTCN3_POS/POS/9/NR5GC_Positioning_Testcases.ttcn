   */
  function f_TC_9_3_4_2_MultiRTT_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var template (value) NR_Multi_RTT_ProvideAssistanceData_r16  v_MultiRTTProvideAssistanceData;

    //@siclog "Step 1" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(19));

    //@siclog "Steps 1b, 1c, 1d" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 2" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    v_MultiRTTProvideAssistanceData := cs_MultiRTTProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(1),
                                                                        {cs_NrSelectedDlPrsPerFreq(0)});
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                          locationServer,
                                                                          omit,
                                                                          omit,
                                                                          -,-,-,-,
                                                                          v_MultiRTTProvideAssistanceData));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationMeasurementsRequired,
                                                                            tsc_ResponseTimeDef,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,-,-,
                                                                            cs_MultiRTTRequestLocationInfoDef));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 4" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, (cr_LppProvideLocationInformation_NoError_MultiRTTOnly(tsc_POS_TransactionNumber), cr_LppProvideLocationInformation_UEA_MultiRTTOnly (tsc_POS_TransactionNumber)));  //@sic R5-243569 sic@
    if (isvalue (v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.nr_Multi_RTT_ProvideLocationInformation_r16)) {
      if (match (v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.nr_Multi_RTT_ProvideLocationInformation_r16, cr_NR_Multi_RTT_ProvideLocationInformation)) {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.2 Step 4");
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Wrong Multi-RTT Location Information");
          }
        }
        else {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Multi-RTT Location Information not present");
        }

    //@siclog "Step 4a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 4
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_2_MultiRTT_NR5GC_TestBody

