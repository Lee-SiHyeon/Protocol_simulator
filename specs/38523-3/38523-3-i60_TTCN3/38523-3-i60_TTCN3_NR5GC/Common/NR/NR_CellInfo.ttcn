    var integer v_SIB4_SI_Index := f_NR_GetSIB4_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList[p_Index].q_RxLevMin := p_Q_RxLevMin;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

