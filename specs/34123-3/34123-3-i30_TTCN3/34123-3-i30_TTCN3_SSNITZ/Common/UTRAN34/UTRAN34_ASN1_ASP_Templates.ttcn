  template (value) U_CPHY_CONFIG_REQ cas_SCPICH_Info_MIMO(UTRAN_CellId_Type p_CellId,
                                                          DL_TxPower_PCPICH p_TxPower,
                                                          ChannelisationCode256 p_S_CPICH_ChC) :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    rlSetup_FDD :=
    {
      cellId := f_UtranCellId2Int(p_CellId),
      routingInfo := {
        physicalChannelIdentity := tsc_S_CPICH
      },
      ratType := fdd,
      setupMessage := {
        physicalChannelInfo := {
          secondaryCPICHInfo := {
            scramblingCode := tsc_S_CPICH_ScrC,
            dl_ChannelizationCode := {sf256 := p_S_CPICH_ChC},
            dl_TxPower := p_TxPower,
            mimoAntenna := antenna2sCPICH
          }
        },
        activationTime := cs_ActivateNow,
        trchConfigToFollow := false,    // DEFAULT TRUE
        relAspTypeExtension := omit
      }
    }
  };

