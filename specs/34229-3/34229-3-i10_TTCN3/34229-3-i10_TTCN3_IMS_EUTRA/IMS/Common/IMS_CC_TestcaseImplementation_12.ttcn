module IMS_CC_TestcaseImplementation_12 {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions4G all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_SIP_Templates all;
  import from IMS_XML_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      Common Test body of test case 12.2
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MO_Call_503_ServiceUnavailable(IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC
  {
    var template (present) MessageHeader v_MessageHeader_Ack;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var template (present) SipUrl v_RequestSipUrl := f_SIP_BuildSipUri_RX(px_IMS_CalleeUri);
    var integer v_RetryAfter := 60;   // seconds
    var float v_RetryAfterMin := f_IMS_SetTimerToleranceMin(int2float(v_RetryAfter));
    var float v_RetryAfterMax := f_IMS_SetTimerToleranceMax(int2float(v_RetryAfter));
    
    f_IMS_TestBody_Set(true);
    
    // Step 1 - Make the UE attempt an IMS speech call
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // Step 2. Receive INVITE Request
    // @siclog "Step 2 - 3" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(-, p_AudioCodecList);
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    // Step 4. SS sends 503 Service Unavailable.
    // @siclog "Step 4" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine503, f_IMS_CommonResponse_503_MessageHeaderTX(v_InviteRequest.msgHeader, cs_RetryAfter(v_RetryAfter)))));
    
    // Step 5. Receive ACK
    // @siclog "Step 5" siclog@
    v_MessageHeader_Ack := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequest, c_statusLine503);
    f_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_RequestSipUrl, v_MessageHeader_Ack)));
    
    f_IMS_PTC_ImsInfo_DialogRelease();     /* @sic R5s180278 sic@ */

    // @siclog "Step 6" siclog@
    f_Delay(v_RetryAfterMin);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step6");
    
    // Step 7. Receive INVITE
    // @siclog "Step 7" siclog@
    f_IMS_MOCallSetup_ReceiveINVITE_Optional((v_RetryAfterMax - v_RetryAfterMin), -, -, p_AudioCodecList);     /* @sic R5s180197 sic@ */

    f_IMS_CC_AbortCall();    // to abort call establishment procedure

    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Common Test body of test case 12.2a
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MO_Call_504_ServerTimeout(IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC
  {
    var template (present) MessageHeader v_MessageHeader_Ack;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var INVITE_Request v_InviteRequest;
    var template (present) SipUrl v_RequestSipUrl := f_SIP_BuildSipUri_RX(px_IMS_CalleeUri);
    
    f_IMS_TestBody_Set(true);
    
    // Step 1 - Make the UE attempt an IMS speech call
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // Step 2. Receive INVITE Request
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(-, p_AudioCodecList);
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    // Step 3. SS sends 504 Server Time-out.
    // @siclog "Step 3" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine504,
                                                                   f_IMS_CommonResponse_504_MessageHeaderTX(v_InviteRequest.msgHeader),
                                                                   cs_MessageBody_XML_Ims_3gpp(cs_Ims_3gpp_Restoration))));
    // Step 4. Receive ACK
    // @siclog "Step 4" siclog@
    v_MessageHeader_Ack := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequest, c_statusLine504);
    f_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_RequestSipUrl, v_MessageHeader_Ack)));
    
    f_IMS_GlobalRelease(keepUnprotected); // @sic R5s170468 - additional change sic@ @sic R5s220609 - Additional changes: keepUnprotected instead of oldestProtectedContextOnly sic@

    f_IMS_CC_AbortCall();    // to abort call establishment procedure  @sic R5s180561: order of f_IMS_GlobalRelease and f_IMS_CC_AbortCall swapped sic@
    
    // Steps 5 to 12. UE performs initial registration Annex C.2
    // @siclog "Step 5 - 12" siclog@
    f_IMS_Registration();
    
    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Common Test body of test case 12.12
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @param     p_AudioCodecToBeSelected (default value: AMR_16000)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MO_VoiceCall_C21(IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR,
                                  IMS_SDP_AudioCodec_Type p_AudioCodecToBeSelected := AMR_16000) runs on IMS_PTC
  {
    f_IMS_TestBody_Set(true);
    
    f_IMS_MOCallSetup_AnnexC21_MOCallRelease(p_AudioCodecList, p_AudioCodecToBeSelected);   /* @sic R5-174649: f_IMS_MOCallSetup_AnnexC21_MOCallRelease sic@ */

    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Common Test body of test case 12.13
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MT_VoiceCall_C11(IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC
  {
    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);
    f_IMS_MTCallSetup_AnnexC11_MTCallRelease(p_AudioCodecList);    /* @sic R5-173535: f_IMS_MTCallSetup_AnnexC11 sic@ */

    f_IMS_TestBody_Set(false);
  }

}
