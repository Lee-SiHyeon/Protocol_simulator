  /*
   * @desc      Return the Frequency hopping parameters stored in SIB2 of EUTRA_CellInfo
   * @param     p_CellId
   * @return    template (omit) FreqHoppingParameters_r13
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
   function f_EUTRA_CellInfo_GetFreqHoppingParameters_r13(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return template (omit) FreqHoppingParameters_r13
  {
    var EUTRA_CellSysInfo_Type v_EUTRA_CellSysInfo_Type := f_EUTRA_CellInfo_GetSYSINFO(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId);       //@sic R5s170918 sic@
    var template (omit) FreqHoppingParameters_r13  v_FreqHoppingParameters_r13:= omit;
    if (v_SysinfoType == sysinfoAndBR) {     //@sic R5s170918 sic@
        v_FreqHoppingParameters_r13 :=  v_EUTRA_CellSysInfo_Type.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.radioResourceConfigCommon.freqHoppingParameters_r13;
    }
    return v_FreqHoppingParameters_r13;
  }

  /*
   * @desc      Return the PRACH Config_v1310 field from SIB2 - for CE mode/CatM1
   * @param     p_CellId
   * @return    template (omit) PRACH_Config_v1310
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_GetPRACH_Config_v1310(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return template (omit) PRACH_Config_v1310
  {
    var EUTRA_CellSysInfo_Type v_EUTRA_CellSysInfo := f_EUTRA_CellInfo_GetSYSINFO(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId);
    var template (omit) PRACH_Config_v1310 v_PRACH_Config_v1310 := omit;

    if (v_SysinfoType == sysinfoAndBR) {
      v_PRACH_Config_v1310 := cs_PRACH_Config_v1310_Def(v_EUTRA_CellSysInfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.radioResourceConfigCommon.prach_ConfigCommon_v1310);
    }
    return v_PRACH_Config_v1310;
  }

