  template (value) Ut_System_Cmd_Type cs_AT_LOCATION_SUBSCRIBE(Ut_ParameterList_Type p_ParamList) :=                  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_AT_Cmd("AT+CMTLR=" & p_ParamList[0].Value & "<CR>");

  template (value) Ut_System_Cmd_Type cs_AT_LOCATION_ANSWER (Ut_ParameterList_Type p_ParamList) :=                    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
