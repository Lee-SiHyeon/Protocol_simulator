module MCX_CommonIPCAN {


  type enumerated MCX_Registration_PDN_Type { imsPDN, internetPDN, mcxPDN, noPDN };     /* Type definition for PIXITs px_MCX_InitialRegistration_TypeOfPDN1, px_MCX_InitialRegistration_TypeOfPDN2, px_MCX_InitialRegistration_TypeOfPDN3;
                                                                                           (see 36.579-1 clause 5.4.1A)
                                                                                           NOTE: 'ims', 'internet', 'mcx' and 'none' cannot be used as 'none' is a keyword; 'IMS', 'INTERNET', 'MCX' and 'NONE' cannot be used as 'IMS' is a port name of various PTCs
                                                                                           @status    APPROVED (MCX) */

  type integer MCX_IPCAN_EpsBearerId_Type (5..13);                                      /* EPS bearer id: the associated DRB Id shall always be EpsBearerId - 4
                                                                                           @status    APPROVED (MCX) */

}
