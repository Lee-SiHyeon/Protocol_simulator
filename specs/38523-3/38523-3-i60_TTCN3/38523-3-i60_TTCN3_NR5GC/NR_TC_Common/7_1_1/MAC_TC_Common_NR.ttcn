    ControlElement  := p_ControlElement  /* omit if MAC CE has fixed size of zero bits */
  };

  template (value) NR_MAC_ControlElementDL_Type cs_NR_MAC_TimingAdvance_CE (B2_Type     p_TAG_ID := '00'B,                                         /* TAG Identity of the addressed TAG */
                                                                            B6_Type     p_TimingAdvanceCommand := '000000'B) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    TimingAdvance :={
      TAG_ID                := p_TAG_ID,
      TimingAdvanceCommand  := p_TimingAdvanceCommand
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_DownlinkBWP_ConfigCommon_REQ(NR_CellId_Type  p_NR_CellId,
                                                                         template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                         template (value) NR_DownlinkBWP_List_Type p_NR_DownlinkBWP_List) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s210263 R5s221197 added omit IEs sic@
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
             Common := omit,
             Downlink := {
                  FrequencyInfoDL       := omit,
                  SSPbchBlock           := omit,
                  PdschCellLevelConfig  := omit,
                  BWPs := {
                      ActiveBWP := tsc_NR_BWP_Id,
                      BwpArray := p_NR_DownlinkBWP_List,
                      InitialBWP_RedCap := omit,  //@sic R5s230289 sic@
                      BWP_SwitchIndicator := omit  //@sic R5w240304r1 sic@
                  },
                  CsiConfig             := omit
             },
             Uplink := omit
          }
        }
      }
    }
  };

