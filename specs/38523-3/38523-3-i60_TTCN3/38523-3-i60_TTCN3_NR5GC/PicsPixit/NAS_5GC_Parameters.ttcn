module NAS_5GC_Parameters {

  import from CommonDefs all;
  import from NG_NAS_TypeDefs all;

  modulepar integer                     pc_noOf_PDUsNewConnection;                      // @desc  Number of UE-requested PDU session establishments after REGISTRATION in a new signaling connection

  modulepar integer                     pc_noOf_PDUsSameConnection;                     // @desc  Number of UE requested PDU session establishments after REGISTRATION during the same signaling connection

  modulepar NAS_5GC_AKA_Type            px_NAS_5GC_AuthenticationType := AKA_5G;        // @desc  NAS 5GC Authentication type

  modulepar B4_Type                     px_NAS_5GC_CipheringAlgorithm := '0010'B;       // @desc  NAS 5GC Ciphering Algorithm

  modulepar B4_Type                     px_NAS_5GC_IntegrityAlgorithm := '0010'B;       // @desc  NAS 5GC Integrity Algorithm

  modulepar integer                     px_NAS_5GC_XRES_Length      := 16;              // @desc  NAS 5GC XRES length, in octets, used in Authentication

  modulepar boolean                     pc_5GC_ATSSS                := false;           // @desc  Support of ATSSS and MA PDU session

  modulepar boolean                     pc_5GC_MUSIM                := false;           // @desc  Support one or more Multi-SIM features include N1 NAS signalling connection release/Paging indication for voice services/Reject paging request/Paging restriction/IMSI offset and so on.

  modulepar boolean                     pc_5GC_MUSIM_NCR            := false;           // @desc  Support of Multi-SIM N1 NAS signalling connection release

  modulepar boolean                     pc_5GC_MUSIM_RPR            := false;           // @desc  Support of Multi-SIM Reject paging request

  modulepar boolean                     pc_5GC_RACS                 := false;           // @desc  Support of RACS

  modulepar boolean                     pc_5GC_RACS_Manufacturer_URCID := false;        // @desc  UE support of Manufacturer assigned radio capability ID

  modulepar boolean                     pc_Additional_PDU_establishment := false;       // @desc  ExpectedNoOfPDUSessionsAtRegistration + 1

  modulepar boolean                     pc_SNPN_EmergencyService    := false;           // @desc  Support of emergency services in NR connected to 5GCN in SNPN Access mode

  modulepar boolean                     pc_SNPN_PLMN                := false;           // @desc  Support of PLMN access in SNPN Access mode

  modulepar boolean                     pc_UserInitiated_SNPN_Reselection := false;     // @desc  Support of autonomous search function to detect CAG cells on serving and non-serving frequencies

  modulepar boolean                     pc_accessing_SNPN_usingCH   := false;           // @desc  Support of accessing SNPN using credentials from a Credentials Holder

  modulepar boolean                     pc_musimLeaveConnected_r17  := false;           // @desc  Supports providing MUSIM assistance information with indication of leaving RRC_CONNECTED state

  modulepar boolean                     pc_musim_CapabilityRestriction_r18 := false;    // @desc  Support providing MUSIM assistance information with temporary capability restriction and capability restriction indication as specified in TS 38.331

  modulepar boolean                     pc_musim_GapPreference_r17  := false;           // @desc  Supports providing MUSIM assistance information with MUSIM gap preference and related MUSIM gap configuration

  modulepar boolean                     pc_musim_UAI_report_r18     := false;           // @desc  Transmit R18 MUSIM related UEAssistanceInformation message once the UE is allowed to do so after triggered by RRCReconfiquration

  modulepar boolean                     pc_onboarding_SNPN          := false;           // @desc  Support of Onboarding Stand-alone Non-Public Network

  modulepar boolean                     pc_sms_over_NAS             := false;           // @desc  Support of SMS over NAS

