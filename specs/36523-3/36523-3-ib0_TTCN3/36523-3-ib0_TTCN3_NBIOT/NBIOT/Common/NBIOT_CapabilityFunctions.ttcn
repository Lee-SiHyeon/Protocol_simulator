module NBIOT_CapabilityFunctions {

  import from NBIOT_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NB_Parameters all;
  import from NBIOT_CellInfo all;
  import from NBIOT_Component all;
  import from NBIOT_Parameters all;
  import from NBIOT_RRC_Templates all;

  /*
   * @desc      check the reported UE MultipleDRB vs. UE MultipleDRB PICS item.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_r13
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckMultipleDRB(UE_Capability_NB_r13 p_UE_Capability_NB_r13)
  {
    if ((isvalue(p_UE_Capability_NB_r13.multipleDRB_r13)) xor pc_NB_MultiDRB ) {
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multipleDRB"); // PICS mismatch
    }
  }

  /*
   * @desc      check the reported UE PhyLayerParameters vs. UE PhyLayerParameters PICS items.
   *            Inconsistency leads to verdict FAIL
   * @param     p_PhyLayerParameters_NB_r13
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckPhyLayerParameters(PhyLayerParameters_NB_r13 p_PhyLayerParameters_NB_r13)
  {
    if( (isvalue(p_PhyLayerParameters_NB_r13.multiTone_r13)) xor pc_NB_MultiTone ) {
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported MultiTone"); // PICS mismatch
    }
    if( (isvalue(p_PhyLayerParameters_NB_r13.multiCarrier_r13)) xor pc_NB_MultiCarrier ) {
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported MultiCarrier"); // PICS mismatch
    }
  }

  /*
   * @desc      Check that any value B such that pc_eBandB_Supp is TRUE and different from all eutra-Band[k] where k = 1 to a - 1
   *            Go through the received supportedBandList and match against the supported bands according to the PICS
   *            Check only the bands for which there are PICS; do not check other bands which may or may not be reported
   * @param     p_SupportedBandList
   * @param     p_NBIOT_SupportedBandList (default value: tsc_NBIOT_SupportedBandList)
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckSupportedBands(SupportedBandList_NB_r13 p_SupportedBandList,
                                        NBIOT_SupportedBandList_Type p_NBIOT_SupportedBandList := tsc_NBIOT_SupportedBandList)
  {
    var integer i;
    var integer v_Band;
    var boolean v_Band_pc;
    // re-written  @sic R5s230589 sic@
    
    for (i:= 0; i < lengthof(p_NBIOT_SupportedBandList); i:= i+1) { //@sic R5s240092 sic@
      v_Band := p_NBIOT_SupportedBandList[i].Band;
      v_Band_pc := p_NBIOT_SupportedBandList[i].SupportedByUE;
      if (v_Band_pc != f_NBIOT_CheckFreqBandIndicator(v_Band, p_SupportedBandList)) {
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported capability for EUTRA band No. " & int2str(v_Band)); // PICS mismatch @sic R5s240460 add. change sic@
      }
    }
  }

  /*
   * @desc      check the reported UE MultipleDRB vs. UE MultiCarrierPaging PICS item.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_RadioPagingInfo_NB_r13
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckMultiCarrierPaging(UE_RadioPagingInfo_NB_r13 p_UE_RadioPagingInfo_NB_r13)
  {
    if ((isvalue(p_UE_RadioPagingInfo_NB_r13.multiCarrierPaging_r14)) xor pc_NB_MultiCarrier_Paging ) { // @sic R5-182640 sic@
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiCarrierPaging"); // PICS mismatch
    }
  }

  /*
   * @desc      check the reported UE Category vs. UE Category PICS item for NB2.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_Ext_r14
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckCategoryNB2(UE_Capability_NB_Ext_r14_IEs p_UE_Capability_NB_Ext_r14)
  {
    if ((isvalue(p_UE_Capability_NB_Ext_r14.ue_Category_NB_r14)) xor pc_ue_Category_NB2 ) {
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported UE Category for Rel14"); // PICS mismatch
    }
  }

  /*
   * @desc      check the reported UE Rai Support vs. UE Rai Support PICS item.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_Ext_r14
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckRaiSupport(UE_Capability_NB_Ext_r14_IEs p_UE_Capability_NB_Ext_r14)
  {
    if (isvalue(p_UE_Capability_NB_Ext_r14.mac_Parameters_r14)){
      if ((isvalue(p_UE_Capability_NB_Ext_r14.mac_Parameters_r14.rai_Support_r14)) xor pc_NB_Rai_Support ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported Rai_Support"); // PICS mismatch
      }
    }
    else{
      if (pc_NB_Rai_Support){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE mac_Parameters_r14 including Rai_Support"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      check the reported UE phyLayerParameters_v1430 vs. UE phyLayerParameters_v1430 PICS item.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_Ext_r14
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckPhyLayerParameters_v1430(UE_Capability_NB_Ext_r14_IEs p_UE_Capability_NB_Ext_r14)
  {
    if (isvalue(p_UE_Capability_NB_Ext_r14.phyLayerParameters_v1430)){
      if ((isvalue(p_UE_Capability_NB_Ext_r14.phyLayerParameters_v1430.multiCarrier_NPRACH_r14)) xor pc_NB_MultiCarrier_NPRACH ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiCarrier_NPRACH"); // PICS mismatch
      }
      if ((isvalue(p_UE_Capability_NB_Ext_r14.phyLayerParameters_v1430.twoHARQ_Processes_r14)) xor pc_NB_TwoHARQ_Processes ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported twoHARQ_Processes"); // PICS mismatch
      }
    }
    else{
      if (pc_NB_MultiCarrier_NPRACH){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParameters_v1430 including multiCarrier_NPRACH"); // PICS mismatch
      }
      if (pc_NB_TwoHARQ_Processes){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParameters_v1430 including twoHARQ_Processes"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      check the reported UE phyLayerParameters_v1440 vs. UE phyLayerParameters_v1440 PICS item.
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_Ext_r14
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckphyLayerParameters_v1440(UE_Capability_NB_Ext_r14_IEs p_UE_Capability_NB_Ext_r14)
  {
    if (isvalue(p_UE_Capability_NB_Ext_r14.nonCriticalExtension)){
      if (isvalue(p_UE_Capability_NB_Ext_r14.nonCriticalExtension.phyLayerParameters_v1440)){
        if ((isvalue(p_UE_Capability_NB_Ext_r14.nonCriticalExtension.phyLayerParameters_v1440.interferenceRandomisation_r14)) xor pc_NB_InterferenceRandomisation ){
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported interferenceRandomisation"); // PICS mismatch
        }
      }
      else{
        if (pc_NB_InterferenceRandomisation){
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParameters_v1430 including interferenceRandomisation"); // PICS mismatch
        }
      }
    }
    else{
      if (pc_NB_InterferenceRandomisation){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported UE_Capability_NB_v1440_IEs including interferenceRandomisation"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      To decode the ue-Capability-ContainerExt-r14 CONTAINING UE-Capability-NB-Ext-r14-IEs
   * @param     p_Octetstring
   * @return    UE_Capability_NB_Ext_r14_IEs
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_DecodeCapExt_r14(octetstring p_Octetstring) return UE_Capability_NB_Ext_r14_IEs
  {
    var UE_Capability_NB_Ext_r14_IEs v_UE_Capability_NB_Ext_r14;
    var bitstring v_Bitstring := oct2bit(p_Octetstring);
    var integer v_Result := decvalue(v_Bitstring, v_UE_Capability_NB_Ext_r14);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "UE Capability Ext for Rel-14 cannot be decoded");
    }
    return v_UE_Capability_NB_Ext_r14;
  }

  /*
   * @desc      To check all r14 capabilities
   * @param     p_UECapabilityInformation_r13
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_MatchCapMsgs_r14(UECapabilityInformation_NB_r13_IEs p_UECapabilityInformation_r13)
  {
    var UE_Capability_NB_Ext_r14_IEs v_UE_Capability_NB_Ext_r14;

    fl_NBIOT_CheckMultiCarrierPaging(p_UECapabilityInformation_r13.ue_RadioPagingInfo_r13);

    if (not isvalue(p_UECapabilityInformation_r13.nonCriticalExtension)) {
      f_SetVerdictInconc (__FILE__, __LINE__, "UECapabilityInformation-NB-Ext-r14 is not present for Rel-14 NB-IoT UE");
    }
    else {
      v_UE_Capability_NB_Ext_r14 := fl_NBIOT_DecodeCapExt_r14(p_UECapabilityInformation_r13.nonCriticalExtension.ue_Capability_ContainerExt_r14);
      fl_NBIOT_CheckCategoryNB2(v_UE_Capability_NB_Ext_r14);
      fl_NBIOT_CheckRaiSupport(v_UE_Capability_NB_Ext_r14);
      fl_NBIOT_CheckPhyLayerParameters_v1430(v_UE_Capability_NB_Ext_r14);
      fl_NBIOT_CheckphyLayerParameters_v1440(v_UE_Capability_NB_Ext_r14);
    }
  }

  /*
   * @desc      To check the UE Radio Paging Info
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_RadioPagingInfo_NB_r13
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckUERadioPagingInfo_r15IEs(UE_RadioPagingInfo_NB_r13 p_UE_RadioPagingInfo_NB_r13)
  {
    if(pc_NB_FDD){
      if ((isvalue(p_UE_RadioPagingInfo_NB_r13.mixedOperationMode_r15)) xor pc_NB_mixedOperationMode ) {
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported mixedOperationMode-r15"); // PICS mismatch
      }
      if ((isvalue(p_UE_RadioPagingInfo_NB_r13.wakeUpSignal_r15)) xor pc_wakeUpSignal ) {
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported wakeUpSignal-r15"); // PICS mismatch
      }
    }
    if(pc_NB_TDD){
      if ((isvalue(p_UE_RadioPagingInfo_NB_r13.multiCarrierPagingTDD_r15)) xor pc_NB_MultiCarrier_Paging_TDD ) {
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiCarrierPagingTDD-r15"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      To check the rel 15 RLC parameters
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_v1530_IEs
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckRlc_Parameters_r15(UE_Capability_NB_v1530_IEs p_UE_Capability_NB_v1530_IEs)
  {
    if ((isvalue(p_UE_Capability_NB_v1530_IEs.rlc_Parameters_r15.rlc_UM_r15)) xor pc_NB_RLC_UM ) {
      f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported rlc-UM-r15"); // PICS mismatch
    }
  }

  /*
   * @desc      To check the rel 15 physical layer parameters
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_v1530_IEs
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckPhyLayerParameters_v1530(UE_Capability_NB_v1530_IEs p_UE_Capability_NB_v1530_IEs)
  {
    if (isvalue(p_UE_Capability_NB_v1530_IEs.phyLayerParameters_v1530)){
      if(pc_NB_FDD){
        if ((isvalue(p_UE_Capability_NB_v1530_IEs.phyLayerParameters_v1530.mixedOperationMode_r15)) xor pc_NB_mixedOperationMode ) {
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported mixedOperationMode-r15"); // PICS mismatch
        }
        if ((isvalue(p_UE_Capability_NB_v1530_IEs.phyLayerParameters_v1530.sr_WithHARQ_ACK_r15)) xor pc_SR_WithHARQ_ACK ) {
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported sr-WithHARQ-ACK-r15"); // PICS mismatch
        }
        if ((isvalue(p_UE_Capability_NB_v1530_IEs.phyLayerParameters_v1530.sr_WithoutHARQ_ACK_r15)) xor pc_SR_WithoutHARQ_ACK ) {
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported sr-WithoutHARQ-ACK-r15"); // PICS mismatch
        }
        if ((isvalue(p_UE_Capability_NB_v1530_IEs.phyLayerParameters_v1530.nprach_Format2_r15)) xor pc_NB_nprach_Format2 ) {
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported nprach-Format2-r15"); // PICS mismatch
        }
      }
    }
    else{
      if (pc_NB_FDD and (pc_NB_mixedOperationMode or pc_SR_WithHARQ_ACK or pc_SR_WithoutHARQ_ACK or pc_NB_nprach_Format2)){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParameters_v1530 including mixedOperationMode_r15 or sr_WithHARQ_ACK_r15 or sr_WithoutHARQ_ACK_r15 or nprach_Format2_r15"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      To check the rel 13 TDD physical layer parameters
   *            Inconsistency leads to verdict FAIL
   * @param     p_TDD_UE_Capability_NB_r15
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckPhyLayerParametersRel13_r15(TDD_UE_Capability_NB_r15 p_TDD_UE_Capability_NB_r15)
  {
    if (isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel13_r15)){
      if ((isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel13_r15.multiTone_r13)) xor pc_NB_MultiTone ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiTone-r13"); // PICS mismatch
      }
      if ((isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel13_r15.multiCarrier_r13)) xor pc_NB_MultiCarrier ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiCarrier-r13"); // PICS mismatch
      }
    }
    else{
      if (pc_NB_MultiTone or pc_NB_MultiCarrier){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParametersRel13_r15 including multiTone-r13 or multiCarrier-r13"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      To check the rel 15 TDD physical layer parameters
   *            Inconsistency leads to verdict FAIL
   * @param     p_TDD_UE_Capability_NB_r15
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckPhyLayerParametersRel14_r15(TDD_UE_Capability_NB_r15 p_TDD_UE_Capability_NB_r15)
  {
    if (isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel14_r15)){
      if ((isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel14_r15.multiCarrier_NPRACH_r14)) xor pc_NB_MultiCarrier_NPRACH ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported multiCarrier-NPRACH-r14"); // PICS mismatch
      }
      if ((isvalue(p_TDD_UE_Capability_NB_r15.phyLayerParametersRel14_r15.twoHARQ_Processes_r14)) xor pc_NB_TwoHARQ_Processes ){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported twoHARQ-Processes-r14"); // PICS mismatch
      }
    }
    else{
      if (pc_NB_MultiCarrier_NPRACH or pc_NB_TwoHARQ_Processes){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE phyLayerParametersRel13_r15 including multiTone-r13 or multiCarrier-r13"); // PICS mismatch
      }
    }
  }

  /*
   * @desc      To check the rel 15 TDD capability
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_v1530_IEs
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckTdd_UE_Capability_r15(UE_Capability_NB_v1530_IEs p_UE_Capability_NB_v1530_IEs)
  {
    var TDD_UE_Capability_NB_r15 v_TDD_UE_Capability_NB_r15;

    if(pc_NB_TDD){
      if (isvalue(p_UE_Capability_NB_v1530_IEs.tdd_UE_Capability_r15)){
        v_TDD_UE_Capability_NB_r15 := p_UE_Capability_NB_v1530_IEs.tdd_UE_Capability_r15;

        if ((isvalue(v_TDD_UE_Capability_NB_r15.ue_Category_NB_r15)) xor pc_ue_Category_NB2 ) {
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported ue-Category-NB-r15"); // PICS mismatch
        }

        fl_NBIOT_CheckPhyLayerParametersRel13_r15(v_TDD_UE_Capability_NB_r15);
        fl_NBIOT_CheckPhyLayerParametersRel14_r15(v_TDD_UE_Capability_NB_r15);
      }
      else{
        if (pc_ue_Category_NB2 or pc_NB_MultiTone or pc_NB_MultiCarrier or pc_NB_MultiCarrier_NPRACH or pc_NB_TwoHARQ_Processes){
          f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE tdd_UE_Capability_r15"); // PICS mismatch
        }
      }
    }
  }

  /*
   * @desc      To check r15 capabilities
   * @param     p_UECapabilityInformation_r13
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_MatchCapMsgs_r15(UECapabilityInformation_NB_r13_IEs p_UECapabilityInformation_r13)
  {
    var UE_Capability_NB_Ext_r14_IEs v_UE_Capability_NB_Ext_r14;
    var UE_Capability_NB_v1530_IEs v_UE_Capability_NB_v1530_IEs;

    // to check some Rel 14 UE capabilities
    f_NBIOT_MatchCapMsgs_r14(p_UECapabilityInformation_r13);

    // to check some Rel 15 UE capabilities
    fl_NBIOT_CheckUERadioPagingInfo_r15IEs(p_UECapabilityInformation_r13.ue_RadioPagingInfo_r13);

    if (not isvalue(p_UECapabilityInformation_r13.nonCriticalExtension)) {
      f_SetVerdictInconc (__FILE__, __LINE__, "UECapabilityInformation-NB-Ext-r14 is not present for Rel-15 NB-IoT UE");
    }
    else {
      v_UE_Capability_NB_Ext_r14 := fl_NBIOT_DecodeCapExt_r14(p_UECapabilityInformation_r13.nonCriticalExtension.ue_Capability_ContainerExt_r14);

      if (not isvalue(v_UE_Capability_NB_Ext_r14.nonCriticalExtension)) {
        f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v1440-IEs is not present for Rel-15 NB-IoT UE");
      }
      else{
        if (not isvalue(v_UE_Capability_NB_Ext_r14.nonCriticalExtension.nonCriticalExtension)) {
          f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v14x0-IEs is not present for Rel-15 NB-IoT UE");
        }
        else{
          if (not isvalue(v_UE_Capability_NB_Ext_r14.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {
            f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v1530-IEs is not present for Rel-15 NB-IoT UE");
          }
          else{
            v_UE_Capability_NB_v1530_IEs := v_UE_Capability_NB_Ext_r14.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
            fl_NBIOT_CheckRlc_Parameters_r15(v_UE_Capability_NB_v1530_IEs);
            fl_NBIOT_CheckPhyLayerParameters_v1530(v_UE_Capability_NB_v1530_IEs);
            fl_NBIOT_CheckTdd_UE_Capability_r15(v_UE_Capability_NB_v1530_IEs);
          }
        }
      }
    }
  }

  /*
   * @desc      To check r17 capabilities
   * @param     p_UECapabilityInformation_r13
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_MatchCapMsgs_r17(UECapabilityInformation_NB_r13_IEs p_UECapabilityInformation_r13) runs on NBIOT_PTC
  {
    var UE_Capability_NB_Ext_r14_IEs v_UE_Capability_NB_Ext_r14;
    var UE_Capability_NB_v15x0_IEs v_UE_Capability_NB_v15x0_IEs;
    var UE_Capability_NB_v1700_IEs v_UE_Capability_NB_v1700_IEs;
    

    //check usual Rel 15 UE capabilities
    f_NBIOT_MatchCapMsgs_r15(p_UECapabilityInformation_r13);

    v_UE_Capability_NB_Ext_r14 := fl_NBIOT_DecodeCapExt_r14(p_UECapabilityInformation_r13.nonCriticalExtension.ue_Capability_ContainerExt_r14);
    v_UE_Capability_NB_v15x0_IEs := v_UE_Capability_NB_Ext_r14.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
    
    if (not isvalue(v_UE_Capability_NB_v15x0_IEs.nonCriticalExtension)) {
      f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v1610-IEs is not present for Rel-17 NTN NB-IoT UE");
    }
    else {
      if (not isvalue(v_UE_Capability_NB_v15x0_IEs.nonCriticalExtension.nonCriticalExtension)) {
        f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v16x0-IEs is not present for Rel-17 NTN NB-IoT UE");
      }
      else{
        if (not isvalue(v_UE_Capability_NB_v15x0_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {
          f_SetVerdictInconc (__FILE__, __LINE__, "UE-Capability-NB-v1700-IEs is not present for Rel-17 NTN NB-IoT UE");
        }
        else{
            v_UE_Capability_NB_v1700_IEs := v_UE_Capability_NB_v15x0_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
            //check NTN-Parameters-NB-r17
            if(f_NBIOT_MobileInfo_GetNTNSatelliteType() != ntn_None){
                fl_NBIOT_CheckNtn_Parameters_NB_r17(v_UE_Capability_NB_v1700_IEs);
            }
        }
      }
    }
  }

  /*
   * @desc      To check r18 capabilities
   * @param     p_UECapabilityInformation_r13
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_MatchCapMsgs_r18(UECapabilityInformation_NB_r13_IEs p_UECapabilityInformation_r13) runs on NBIOT_PTC
  {//@sic R5s240444 BASELINE MOVING 2024 sic@
    f_NBIOT_MatchCapMsgs_r17(p_UECapabilityInformation_r13);
  }

  /*
   * @desc      To check the rel 17 parameters
   *            Inconsistency leads to verdict FAIL
   * @param     p_UE_Capability_NB_v1700_IEs
   * @status    APPROVED (NBIOT)
   */
  function fl_NBIOT_CheckNtn_Parameters_NB_r17( UE_Capability_NB_v1700_IEs p_UE_Capability_NB_v1700_IEs)
  { //@sic R5-255779 sic@
    if (isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17)){
      if(pc_NB_FDD){
        f_CompareCapability_vs_PICS((pc_NB_ntn_Connectivity_EPC),isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_Connectivity_EPC_r17), "ntn-Connectivity-EPC-r17"); //@sic R5-240159 sic@
        f_CompareCapability_vs_PICS(pc_NB_ntn_TA_Report,isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_TA_Report_r17), "ntn-TA-Report-r17");
        f_CompareCapability_vs_PICS(pc_NB_ntn_PUR_TimerEnhancement,isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_PUR_TimerDelay_r17), "ntn-PUR-TimerDelay-r17");
        f_CompareCapability_vs_PICS(pc_NB_ntn_OffsetTimingEnh,isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_OffsetTimingEnh_r17), "ntn-OffsetTimingEnh-r17");
        f_CompareCapability_vs_PICS(pc_NB_ntn_OffsetTimingEnh,isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_OffsetTimingEnh_r17), "ntn-OffsetTimingEnh-r17");
        f_CompareCapability_vs_PICS(pc_ntn_SegmentedPrecompensationGaps,isvalue(p_UE_Capability_NB_v1700_IEs.nonCriticalExtension.nonCriticalExtension.ntn_Parameters_v1720.ntn_SegmentedPrecompensationGaps_r17), "ntn-SegmentedPrecompensationGaps-r17"); //@sic R5-240159 sic@
        if (isvalue(p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_ScenarioSupport_r17)){
            f_CompareCapability_vs_PICS(pc_NB_ntn_GSO_ScenarioSupport, (p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_ScenarioSupport_r17== gso)," GSO ntn-ScenarioSupport-r17");
            f_CompareCapability_vs_PICS(pc_NB_ntn_NGSO_ScenarioSupport, (p_UE_Capability_NB_v1700_IEs.ntn_Parameters_r17.ntn_ScenarioSupport_r17== ngso)," NGSO ntn-ScenarioSupport-r17");
        }
        else{
            if (not(pc_NB_ntn_GSO_ScenarioSupport and pc_NB_ntn_NGSO_ScenarioSupport)) {
              f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported ntn-ScenarioSupport-r17"); // PICS mismatch
            }
        }
      }
    }
    else{
      if (pc_NB_FDD and (pc_NB_ntn_Connectivity_EPC or pc_NB_ntn_only_Connectivity_EPC or pc_NB_ntn_TA_Report or pc_NB_ntn_PUR_TimerEnhancement or pc_NB_ntn_OffsetTimingEnh or pc_NB_ntn_GSO_ScenarioSupport or pc_NB_ntn_NGSO_ScenarioSupport)){
        f_SetVerdict(fail, __FILE__, __LINE__, "PICS does not match reported IE ntn-Parameters-r170 including ntn-Connectivity-EPC-r17 or ntn-TA-Report-r17 or ntn-PUR-TimerDelay-r17 or ntn-OffsetTimingEnh-r17 or ntn-ScenarioSupport-r17"); // PICS mismatch
      }
    }
  }

}
