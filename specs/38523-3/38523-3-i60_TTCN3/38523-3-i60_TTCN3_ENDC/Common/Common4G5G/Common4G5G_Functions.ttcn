module Common4G5G_Functions {

  import from CommonDefs all;
  import from EUTRA_NR_Parameters all;

  /*
   * @desc      returns Ceil(p_Dividend / p_Divisor)
   * @param     p_Dividend
   * @param     p_Divisor
   * @return    integer
   * @status    APPROVED (ENDC, NBIOT, NR5GC)
   */
  function f_RoundedUpDivision(integer p_Dividend,
                               integer p_Divisor) return integer
  {
    return ((p_Dividend - 1) / p_Divisor) + 1;
  }

  /*
   * @desc      Function to derive supported gaps from Pics (used in test case 8.2.3.11.1)
   * @return    B9_Type
   * @status    APPROVED (ENDC)
   */
  function f_ENDC_DeriveSupportedGapsFromPics() return B9_Type // @sic R5s240506, R5s230787 sic@
  {
    var B9_Type v_SupportedGapPatterns   := f_ConvertBoolToBit(pc_gp11_en_dc) &
                                            f_ConvertBoolToBit(pc_gp10_en_dc) &
                                            f_ConvertBoolToBit(pc_gp9_en_dc) &
                                            f_ConvertBoolToBit(pc_gp8_en_dc) &
                                            f_ConvertBoolToBit(pc_gp7_en_dc) &
                                            f_ConvertBoolToBit(pc_gp6_en_dc) &
                                            f_ConvertBoolToBit(pc_gp5_en_dc) &
                                            f_ConvertBoolToBit(pc_gp4_en_dc) &
                                            f_ConvertBoolToBit(pc_gp2_gp3_en_dc); // @sic R5s240506, R5s230787 sic@

    return v_SupportedGapPatterns;
  }; // @sic R5s240506, R5s230787 sic@

}
