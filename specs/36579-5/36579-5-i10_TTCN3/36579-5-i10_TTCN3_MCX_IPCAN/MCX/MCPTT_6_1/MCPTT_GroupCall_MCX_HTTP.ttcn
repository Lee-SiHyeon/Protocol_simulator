module MCPTT_GroupCall_MCX_HTTP {

  import from MCX_HTTP_CommonFunctions all;
  import from MCX_HTTP_Component all;
  import from MCX_SecurityParameters all;
  import from MCX_XML_GroupConfiguration_Common all;
  import from MCX_XML_GroupConfiguration_MCPTT all;

  /*
   * @status    APPROVED (MCX)
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.10.MCPTT
   */
  function f_TC_6_1_1_10_MCPTT_MCX_HTTP() runs on MCX_HTTP_PTC
  { // On-network / Broadcast Group Call with Temporary Group / Client Originated (CO)
    var MCX_SecurityParameters_Type v_SecurityParameters;
    var template (value) MCX_PocListService_Group_Type v_ConstituentGroupA_Configuration := f_MCPTT_GroupConfiguration_Regrouped();

    f_MCX_Preamble_HTTP(MCPTT, REGISTERED_ONLY);

    v_SecurityParameters := f_MCX_HTTP_AuthenticationAuthorizationUEConfiguration(MCPTT);

    f_MCX_HTTP_DownloadGroupDocument(MCPTT, v_SecurityParameters, v_ConstituentGroupA_Configuration);

    f_MCX_Postamble_HTTP();
  }

}
