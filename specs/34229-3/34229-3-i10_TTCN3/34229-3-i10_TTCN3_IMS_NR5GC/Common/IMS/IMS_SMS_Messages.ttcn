module IMS_SMS_Messages {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_Parameters all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_Common all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_SIPTypesAndValues all;
  import from Parameters all;
  import from SMS_Templates all;
  import from SMS_TypeDefs all;
  import from UpperTesterFunctions all;

  template (present) RP_DATA_ul_Type cr_SMS_RP_DATA_ul_SUBMIT_IMS :=
    /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    /* @sic R5-133632 change 7: px_SMS_SMSC_InternationalNumber sic@ */
    cr_RP_DATA_ul_SUBMIT(cr_RP_UserData_SUBMIT(cr_SMS_SUBMIT), f_CharPacking_IA5toBCD(px_SMS_SMSC_InternationalNumber)); // @sic R5s141400 sic@

  template (value) InReplyTo cs_InReplyTo(CallidString p_CallidString) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    fieldName := IN_REPLY_TO_E,
    callids := {p_CallidString}
  };

  template (present) InReplyTo cr_InReplyTo(CallidString p_CallidString) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    fieldName := IN_REPLY_TO_E,
    callids := {p_CallidString, *}
  };

  template (value) SemicolonParam_List cs_AcRcParamsSMS :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    cs_GenericParam("+g.3gpp.smsip"),
    cs_GenericParam("require"),
    cs_GenericParam("explicit")
  };

  template (value) RP_DATA_dl_Type cs_RP_DATA_dl_STATUS_REPORT(TP_MessageReference_Type p_MessageRef,
                                                               TP_Address_Type p_RecipientAddress,
                                                               template (omit) TP_ServiceCentreTimeStamp_Type p_SCTP) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    spare5 := '00000'B,
    rP_MessageTypeIndicator := tsc_MT_RP_DATA_dl,
    rP_MessageReference := '00'O,
    rP_OriginatorAddress := cs_RP_OriginatorAddress_dl,
    rP_DestinationAddress := cs_RP_DestinationAddress_dl,
    rP_UserData := cs_RP_UserData_STATUS_REPORT (p_MessageRef, p_RecipientAddress, p_SCTP)
  };

  template (value) RP_UserData cs_RP_UserData_STATUS_REPORT(TP_MessageReference_Type p_MessageRef, /* @sic R5s230533 sic@ */
                                                           TP_Address_Type p_RecipientAddress,
                                                           template (omit) TP_ServiceCentreTimeStamp_Type p_SCTP) :=
  { /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    // @sic R5s120530 change 2.9 sic@
    spare := omit,
    iei := omit,
    iel := int2oct(lengthof(p_RecipientAddress.digits) + 21, 1),
    tP_PDU := {
      SMS_STATUS_REPORT := cs_SMS_STATUS_REPORT(p_MessageRef, p_RecipientAddress, p_SCTP)
    }
  };

  template (value) SMS_STATUS_REPORT_Type cs_SMS_STATUS_REPORT(TP_MessageReference_Type p_MessageRef,
                                                               TP_Address_Type p_RA,
                                                               template (omit) TP_ServiceCentreTimeStamp_Type p_SCTP):=
  { // TS 34.229-1 clause A.7.5
    /* @status    APPROVED (IMS, LTE_A_R12, NR5GC) */
    spare1 := '0'B,
    tP_UserDataHeaderIndicator := '0'B,
    tP_StatusReportQualifier := '0'B,
    spare2 := '00'B,
    tP_MoreMessagesToSend := '0'B,
    tP_MessageTypeIndicator := tsc_MT_SMS_STATUS_REPORT,
    tP_MessageReference := p_MessageRef,
    tP_RecipientAddress := p_RA,
    tP_ServiceCentreTimeStamp := p_SCTP,
    tP_DischargeTime := f_BCD_TimestampWithTimezone(), // @sic R5s201325 sic@
    tP_Status := {
      reserved := '0'B,
      status := '0000000'B
    },
    tP_ParameterIndicator := cs_TP_ParameterIndicator, // @sic R5s210112, R5s211245 sic@
    tP_ProtocolIdentifier := cs_TP_ProtocolIdentifier,
    tP_DataCodingScheme_Type := omit,
    tP_UserDataLength := omit,
    tP_UserData := omit
  };

  template (value) RP_Cause cs_RP_Cause (B7_Type p_CauseValue) :=
  { /* @status    APPROVED (IMS) */
    spare := omit,
    iei := omit,
    iel := '01'O,
    extBit := '0'B,
    causeValue := p_CauseValue,
    diagnostic := omit
  };

  template (value) RP_ERROR_Type cs_RP_ERROR(O1_Type p_MsgRef,
                                             template (value) RP_Cause p_RP_Cause) :=
  { /* @status    APPROVED (IMS) */
    spare5 := '00000'B,
    rP_MessageTypeIndicator := tsc_MT_RP_ERROR_dl,  // @sic R5s201331 sic@
    rP_MessageReference := p_MsgRef,
    rP_Cause := p_RP_Cause,
    rP_UserData := omit
  };

  group UDH_relatedTemplates {

  template (value) TP_UDH_IE_Type cs_TP_UDH_IE (O1_Type p_TP_UDH_IEI,
                                                O1_Type p_TP_UDH_IEL,
                                                template (value) TP_UDH_Type p_TP_UDH) :=
  { /* @status    APPROVED (IMS) */
    tP_UDH_IEI := p_TP_UDH_IEI,
    tP_UDH_IEL := p_TP_UDH_IEL,
    tP_UDH := p_TP_UDH
  }

  template (present) TP_UDH_IE_Type cr_TP_UDH_IE (O1_Type p_TP_UDH_IEI,
                                                  O1_Type p_TP_UDH_IEL,
                                                  template (present) TP_UDH_Type p_TP_UDH) :=
  { /* @status    APPROVED (IMS) */
    tP_UDH_IEI := p_TP_UDH_IEI,
    tP_UDH_IEL := p_TP_UDH_IEL,
    tP_UDH := p_TP_UDH
  }

  template (value) TP_UDH_Type cs_TP_UDH_ConcSMS (O1_Type p_TP_UserDataHeaderMsgRef,
                                                  O1_Type p_TP_UserDataHeaderNumSMS,
                                                  O1_Type p_TP_UserDataHeaderSN_SMS) :=
  { /* @status    APPROVED (IMS) */
    tP_UDH_ConcSMS := {
      tP_UserDataHeaderMsgRef := p_TP_UserDataHeaderMsgRef,
      tP_UserDataHeaderNumSMS := p_TP_UserDataHeaderNumSMS,
      tP_UserDataHeaderSN_SMS := p_TP_UserDataHeaderSN_SMS
    }
  }

  template (present) TP_UDH_Type cr_TP_UDH_ConcSMS (template (present) O1_Type p_TP_UserDataHeaderMsgRef,
                                                    O1_Type p_TP_UserDataHeaderNumSMS,
                                                    template (value) O1_Type p_TP_UserDataHeaderSN_SMS) :=
  { /* @status    APPROVED (IMS) */
    tP_UDH_ConcSMS := {
      tP_UserDataHeaderMsgRef := p_TP_UserDataHeaderMsgRef,
      tP_UserDataHeaderNumSMS := p_TP_UserDataHeaderNumSMS,
      tP_UserDataHeaderSN_SMS := p_TP_UserDataHeaderSN_SMS
    }
  }

  template (value) TP_UserDataHeader_Type cs_TP_UserDataHeader_ConcSMS (O1_Type p_TP_UserDataHeaderMsgRef,
                                                                        O1_Type p_TP_UserDataHeaderSN_SMS,
                                                                        octetstring p_TP_UserData) := {
   /* @status    APPROVED (IMS) */
    // User Data Header Type for Concatenated SMS
    tP_UserDataHeaderLength := int2oct(5,1),  // length = 5
    tP_UDH_IE_Record := {cs_TP_UDH_IE (int2oct(0,1), // IEI = 0
                                       int2oct(3,1), // length = 3
                                       cs_TP_UDH_ConcSMS (p_TP_UserDataHeaderMsgRef,
                                                          int2oct(3,1), // number of segments = 3
                                                          p_TP_UserDataHeaderSN_SMS))
                        },
    tP_UserData := p_TP_UserData
  };

  template (present) TP_UserDataHeader_Type cr_TP_UserDataHeader_ConcSMS (template (present) O1_Type p_TP_UserDataHeaderMsgRef,
                                                                          template (value) O1_Type p_TP_UserDataHeaderSN_SMS,
                                                                          template (value) octetstring p_TP_UserData) := {
    /* @status    APPROVED (IMS) */
    // User Data Header Type for Concatenated SMS
    tP_UserDataHeaderLength := int2oct(5,1),  // length = 5
    tP_UDH_IE_Record := {cr_TP_UDH_IE (int2oct(0,1), // IEI = 0
                                       int2oct(3,1), // length = 3
                                       cr_TP_UDH_ConcSMS (p_TP_UserDataHeaderMsgRef,
                                                          int2oct(3,1), // number of segments = 3
                                                          p_TP_UserDataHeaderSN_SMS))
                        },
    tP_UserData := p_TP_UserData
  };

  template (value) SMS_DELIVER_Type cs_SMS_DELIVER_ConcSMS (octetstring p_Digits,
                                                            O1_Type p_MsgRef,
                                                            O1_Type p_SN_SMS) :=
  { /* @status    APPROVED (IMS) */
    tP_ReplyPath := '0'B,
    tP_UserDataHeaderIndicator := '1'B, // concatenated SMS
    tP_StatusReportIndication := '0'B,
    spare2 := '00'B,
    tP_MoreMessagesToSend := '1'B, // @sic R5s201329 sic@
    tP_MessageTypeIndicator := tsc_MT_SMS_DELIVER,
    tP_OriginatingAddress := cs_TP_Address (p_Digits),
    tP_ProtocolIdentifier := cs_TP_ProtocolIdentifier,
    tP_DataCodingScheme_Type := cs_TP_DataCodingScheme,
    tP_ServiceCentreTimeStamp := f_BCD_TimestampWithTimezone(),
    tP_UserDataLength := int2oct(160,1), // as the user data are septets the overall length is provided in septets
    tP_UserData := f_TP_UserDataWithHeader_Encode(cs_TP_UserDataHeader_ConcSMS (p_MsgRef, p_SN_SMS, f_CharPacking_IA5toGsm7Bit(tsc_FoxShort, SMS_Packing, 1))) // @sic R5s201446, R5s210441 sic@
  };

  template (value) RP_DATA_dl_Type cs_RP_DATA_dl_DELIVER_ConcSMS (octetstring p_Digits,
                                                                  O1_Type p_MsgRef,
                                                                  O1_Type p_SN_SMS) :=
  { /* @status    APPROVED (IMS) */
    spare5 := '00000'B,
    rP_MessageTypeIndicator := tsc_MT_RP_DATA_dl,
    rP_MessageReference := int2oct(0, 1),
    rP_OriginatorAddress := cs_RP_OriginatorAddress_dl,
    rP_DestinationAddress := cs_RP_DestinationAddress_dl,
    rP_UserData := cs_RP_UserData_DELIVER_ConcSMS(p_Digits, p_MsgRef, p_SN_SMS)
  };

  template (value) RP_UserData cs_RP_UserData_DELIVER_ConcSMS (octetstring p_Digits, /* @sic R5s230533 sic@ */
                                                               O1_Type p_MsgRef,
                                                               O1_Type p_SN_SMS) :=
  { /* @status    APPROVED (IMS) */
    spare := omit,
    iei := omit,
    iel := int2oct ((153 + lengthof (p_Digits)), 1), // 134 octets of user data + 6 octets UD header + RP overhead: 13 octets + lengthof digits
    tP_PDU := {SMS_DELIVER := cs_SMS_DELIVER_ConcSMS (p_Digits, p_MsgRef, p_SN_SMS)}
  };

  } // end of group UDH_relatedTemplates

  group SMS_AT_relatedFunctions {

  /*
   * @desc      Check result of an SMS AT command
   * @param     p_ResultString
   * @param     p_ExpectedStartString
   * @status    APPROVED (IMS)
   */
  function fl_IMS_SMS_CheckResultString(charstring p_ResultString,
                                        charstring p_ExpectedStartString) runs on IMS_PTC
  {
    if (not f_CheckStringStartWith(p_ResultString, p_ExpectedStartString)) {
      f_IMS_SetVerdictFailOrInconc (__FILE__, __LINE__, "The AT CMD results in an error.");
    }
  }

  /*
   * @desc      Transmission of AT Command CSMS
   * @param     p_MsgService
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CSMS(charstring p_MsgService) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_SelectMessageService(MMI, p_MsgService);
    fl_IMS_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CSMS:");
  }

  /*
   * @desc      Transmission of AT Command CPMS
   * @param     p_Mem1
   * @param     p_Mem2
   * @param     p_Mem3
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CPMS(charstring p_Mem1,
                             charstring p_Mem2,
                             charstring p_Mem3) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_SetPreferredMessageStorage(MMI, p_Mem1, p_Mem2, p_Mem3);
    fl_IMS_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CPMS:");
  }

  /*
   * @desc      Transmission of AT Command CMGF
   * @param     p_Mode
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CMGF(charstring p_Mode) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_SetMessageFormat(MMI, p_Mode);
    fl_IMS_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Transmission of AT Command CSCS
   * @param     p_Chset
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CSCS(charstring p_Chset) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_SelectCharacterSet(MMI, p_Chset);
    fl_IMS_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Transmission of AT Command CMGD to clear all buffers
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CMGD_ALL() runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_DeleteMessageFromStorage_DELFLAG(MMI, 1, 4);
    fl_IMS_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Transmission of AT Command CSCA
   * @param     p_Sca
   * @param     p_Tosca
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CSCA(charstring p_Sca,
                             integer p_Tosca) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_ServiceCentreAddress(MMI, p_Sca, p_Tosca);
    fl_IMS_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Transmission of AT Command CMGW (Text Mode)
   * @param     p_Da
   * @param     p_Toda
   * @param     p_Text
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CMGW_Text(charstring p_Da,
                                  integer p_Toda,
                                  charstring p_Text) runs on IMS_PTC
  { // @sic R5s110064 sic@
    var charstring v_ResultStr := f_UT_WriteMessageToMemoryText(MMI, p_Da, int2str(p_Toda), p_Text);
    fl_IMS_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CMGW:");
  }

  /*
   * @desc      Transmission of AT Command CMGW (PDU Mode)
   * @param     p_Len
   * @param     p_Text
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CMGW_PDU(integer p_Len,
                                 charstring p_Text) runs on IMS_PTC
  {
  var charstring v_ResultStr := f_UT_WriteMessageToMemoryPDU(MMI, int2str(p_Len), p_Text);
    fl_IMS_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CMGW:");
  }

  /*
   * @desc      Transmission of AT Command CMSS
   * @param     p_Index
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CMSS(integer p_Index) runs on IMS_PTC
  { // @sic R5s110091 sic@
    f_UT_SendStoredOneMessage(MMI, p_Index);
  }

  /*
   * @desc      Transmission of AT Command CSMP
   * @param     p_Fo
   * @param     p_Vp
   * @param     p_Pid
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_CSMP(integer p_Fo,
                             integer p_Vp,
                             integer p_Pid) runs on IMS_PTC
  {
    var charstring v_ResultStr := f_UT_SetTextModeParameters(MMI, p_Fo, p_Vp, p_Pid);
    fl_IMS_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Configure the SMS as per PIXIT using the appropriate AT commands
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_Config() runs on IMS_PTC
  {
    var charstring v_InternationalNumber := """" & px_SMS_SMSC_InternationalNumber & """"; // @sic R5s210432 sic@
    // Set message service as indicated in the PIXIT.
    f_IMS_SMS_AT_CSMS(px_SMS_Service);
    // Set Preferrred memory to preferred memories as indicated in the PIXIT.
    f_IMS_SMS_AT_CPMS(px_SMS_PrefMem1, px_SMS_PrefMem2, px_SMS_PrefMem3);
    // Set message format to value given as PIXIT parameter
    f_IMS_SMS_AT_CMGF(px_SMS_MsgFrmt);  // @sic R5s110751 sic@
    // Set Character Set "GSM"
    f_IMS_SMS_AT_CSCS("""GSM""");
    // Set the UE to delete all messages from Preferred message store
    f_IMS_SMS_AT_CMGD_ALL();
    // Set service center address
    f_IMS_SMS_AT_CSCA(v_InternationalNumber, 129); // @sic R5s210281, R5s210432 sic@
  }

  /*
   * @desc      Write an MO SMS to the UE's memory as per PIXIT using the appropriate AT commands
   * @param     p_CSMP
   * @param     p_PDU_len
   * @param     p_SMS_text
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_Write_MO_SMS (integer p_CSMP,
                                      integer p_PDU_len,
                                      charstring p_SMS_text) runs on IMS_PTC
  {
    if (px_SMS_MsgFrmt=="1") { // @sic R5s110751 sic@
      // Set text mode parameters to trigger status report. Default value for SUMIT is 17
      // bit 7(RP) 6(UDHI) 5(SRR) 4 3(VPF) 2(RD) 1 0(MIT)
      //     0     0       1      1 0      0     0 1     => p_CSMP = 49
      // bit 7(RP) 6(UDHI) 5(SRR) 4 3(VPF) 2(RD) 1 0(MIT)
      //     0     1       1      1 0      0     0 1     => p_CSMP = 113
      f_IMS_SMS_AT_CSMP(p_CSMP, 167, 0);  // @sic R5s100773 sic@  // 167 default for SUBMIT
      // Write message to memory storage
      f_IMS_SMS_AT_CMGW_Text("""1111111111""", 129, p_SMS_text); // 129 default for toda
      }
    else { // PDU mode
      // Write message to memory storage
      // 13 octets + number of octets maing up p_SMS_text
      f_IMS_SMS_AT_CMGW_PDU(p_PDU_len, p_SMS_text);
    }
  }

  /*
   * @desc      Trigger the UE to issue an MO SMS as per PIXIT using the appropriate AT commands
   * @param     p_CSMP
   * @param     p_PDU_len
   * @param     p_SMS_text
   * @status    APPROVED (IMS)
   */
  function f_IMS_SMS_AT_Trigger_MO_SMS (integer p_CSMP,
                                        integer p_PDU_len,
                                        charstring p_SMS_text) runs on IMS_PTC
  {
    // Write message to storage. Takes next index automatically.
    f_IMS_SMS_AT_Write_MO_SMS(p_CSMP, p_PDU_len, p_SMS_text);
    // Send message from storageSMS_AT_relatedFunctionsSMS_AT_relatedFunctions.
    f_IMS_SMS_AT_CMSS(px_SMS_IndexOffset);
  }

  } // end of group SMS_AT_relatedFunctions

  /*
   * @desc      encode SMS-RP-DATA
   * @param     p_RP_PDU
   * @return    octetstring
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_SMS_PDU_EncodeRPDATA(template (value) RP_DATA_dl_Type p_RP_PDU) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_RP_PDU);
    var octetstring v_Octetstring := bit2oct(v_Bitstring);
    return v_Octetstring;
  }

  /*
   * @desc      decode received RP Date PDU and match against expected PDU
   * @param     p_EncodedSMS_Message
   * @param     p_ExpectedRP_DATA_ul
   * @return    RP_DATA_ul_Type
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_SMS_PDU_DecodeAndMatchRPDATA(octetstring p_EncodedSMS_Message,
                                          template (present) RP_DATA_ul_Type p_ExpectedRP_DATA_ul) runs on IMS_PTC return RP_DATA_ul_Type
  {
    var bitstring v_Bitstring := oct2bit(p_EncodedSMS_Message);
    var RP_DATA_ul_Type v_RP_DATA_ul;
    
    if (decvalue(v_Bitstring, v_RP_DATA_ul) != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "cannot decode RP_DATA_ul_Type");
    }
    if (not match(v_RP_DATA_ul, p_ExpectedRP_DATA_ul)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "RP_DATA_ul does not match");
    }
    return v_RP_DATA_ul;
  }

  /*
   * @desc      encode RP ACK
   * @param     p_RP_PDU
   * @return    octetstring
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_SMS_PDU_EncodeRPACK(template (value) RP_ACK_Type p_RP_PDU) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_RP_PDU);
    var octetstring v_Octetstring := bit2oct(v_Bitstring);
    return v_Octetstring;
  };

  /*
   * @desc      encode RP_ERROR
   * @param     p_RP_PDU
   * @return    octetstring
   * @status    APPROVED (IMS)
   */
  function f_SMS_PDU_EncodeRP_ERROR(template (value) RP_ERROR_Type p_RP_PDU) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_RP_PDU);
    var octetstring v_Octetstring := bit2oct(v_Bitstring);
    return v_Octetstring;
  };

  /*
   * @desc      decode and match SMS RP-ACK
   * @param     p_EncodedSMS_Message
   * @param     p_ExpectedRP_ACK
   * @return    RP_ACK_Type
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_SMS_PDU_DecodeAndMatchRPACK(octetstring p_EncodedSMS_Message,
                                         template (present) RP_ACK_Type p_ExpectedRP_ACK) runs on IMS_PTC return RP_ACK_Type
  {
    var bitstring v_Bitstring := oct2bit(p_EncodedSMS_Message);
    var RP_ACK_Type v_RP_ACK;

    if (decvalue(v_Bitstring, v_RP_ACK) != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "cannot decode RP_ACK_Type");
    }

    if (not match(v_RP_ACK, p_ExpectedRP_ACK)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "RP_ACK does not match");
    }
    return v_RP_ACK;
  };

  /*
   * @desc      encode TP_UserDataHeader
   * @param     p_TP_UserDataWithHeader
   * @return    octetstring
   * @status    APPROVED (IMS)
   */
  function f_TP_UserDataWithHeader_Encode (template (value) TP_UserDataHeader_Type p_TP_UserDataWithHeader) return octetstring
  {
    var octetstring v_TP_UserDataWithHeader;
    v_TP_UserDataWithHeader := bit2oct(encvalue(p_TP_UserDataWithHeader));
    return v_TP_UserDataWithHeader;
  }

  /*
   * @desc      decode received TP_UserDataHeader and match against expected TP_UserDataHeader
   * @param     p_Encoded_TP_UserDataWithHeader
   * @param     p_Expected_TP_UserDataWithHeader
   * @return    TP_UserDataHeader_Type
   * @status    APPROVED (IMS)
   */
  function f_TP_UserDataWithHeader_DecodeAndMatch(octetstring p_Encoded_TP_UserDataWithHeader,
                                                  template (present) TP_UserDataHeader_Type p_Expected_TP_UserDataWithHeader) runs on IMS_PTC return TP_UserDataHeader_Type
  {
    var bitstring v_Bitstring := oct2bit(p_Encoded_TP_UserDataWithHeader);
    var TP_UserDataHeader_Type v_TP_UserDataWithHeader;
    
    if (decvalue(v_Bitstring, v_TP_UserDataWithHeader) != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "cannot decode TP_UserDataWithHeader_Type");
    }
    if (not match(v_TP_UserDataWithHeader, p_Expected_TP_UserDataWithHeader)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "TP_UserDataWithHeader does not match");
    }
    return v_TP_UserDataWithHeader;
  }

  /*
   * @desc      common MESSAGE for A.7.1, A.7.4, A.7.5
   * @param     p_Protocol
   * @param     p_CSeqValue
   * @param     p_RequestDispositionDirective
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderTX_Common(InternetProtocol_Type p_Protocol,
                                                       integer p_CSeqValue,
                                                       Directive p_RequestDispositionDirective)
    runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-131269: new function to be used for A.7.1, A.7.4, A.7.5; R5-133705 sic@ */
    /* @sic R5s150086 - p_SessionIdSupported: pc_IMS_SessionIdSupported per default sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
   
    var charstring v_P_CSCF_Address := f_IMS_PTC_Pcscf_Get();
    var template (value) SipUrl v_IP_SM_GW_SipUrl := cs_SipUri_UserHostPort("SMSGateway", v_P_CSCF_Address);
    var template (value) SipUrl v_SipUrlTo := f_IMS_PTC_ImsInfo_GetSipUriTX(defaultId);
    var charstring v_ProtocolString := f_IMS_ConvertTransportProtocolToString(p_Protocol);
    var integer v_Port_ps := f_IMS_PTC_GetPort_ps();
    var template (value) MessageHeader v_MessageHeader_Message := cs_MessageHeader_Dummy;
    var charstring v_CallIdString := f_IMS_PTC_GenerateCallId("MESSAGE");            /* @sic R5-131269: unique call id different from Call-Id received in the original MO SMS sic@ */
    var template (value) ViaBody_List v_ViaBodyList := { cs_ViaBody(v_ProtocolString, cs_HostPort(v_P_CSCF_Address, v_Port_ps), f_ViaParamsTX(f_IMS_PTC_ImsInfo_GetNextBranch())) };

    v_MessageHeader_Message.via             := cs_Via(v_ViaBodyList);
    v_MessageHeader_Message.fromField       := cs_From(v_IP_SM_GW_SipUrl, f_IMS_GenerateTag("MESSAGE", "From"));
    v_MessageHeader_Message.toField         := cs_ToDef(v_SipUrlTo);
    v_MessageHeader_Message.callId          := cs_CallId(v_CallIdString);
    v_MessageHeader_Message.cSeq            := cs_CseqDef(p_CSeqValue, "MESSAGE");
    v_MessageHeader_Message.maxForwards     := cs_MaxForwardsDef;
    v_MessageHeader_Message.requestDisposition := cs_RequestDisposition({p_RequestDispositionDirective});
    v_MessageHeader_Message.contentType     := cs_ContentType("application/vnd.3gpp.sms");
    v_MessageHeader_Message.pCalledPartyID  := cs_PCalledPartyId(v_SipUrlTo);      /* @sic R5-131269, R5s130370 change 8: same value as in the To header sic@ */

    return v_MessageHeader_Message;
  }

  /*
   * @desc      MESSAGE acc. to TS 34.229 A.7.1
   * @param     p_Protocol
   * @param     p_CSeqValue         (default value: tsc_MESSAGE_CSeqValue)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS)
   */
  function f_IMS_MessageRequest_MessageHeaderTX_MT_SMS(InternetProtocol_Type p_Protocol,
                                                       integer p_CSeqValue := tsc_MESSAGE_CSeqValue) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-131269  R5-133705 sic@ */
    var template (value) MessageHeader v_MessageHeader_Message;
    
    v_MessageHeader_Message := f_IMS_MessageRequest_MessageHeaderTX_Common(p_Protocol, p_CSeqValue, "no-fork");
    v_MessageHeader_Message.pAssertedID     := cs_PAssertedId(f_Addr_Union_GetSipUrl(v_MessageHeader_Message.fromField.addressField));   // same as in From header
    v_MessageHeader_Message.acceptContact   := cs_AcceptContact(cs_AcRcParamsSMS);

    return v_MessageHeader_Message;
  }

  /*
   * @desc      MESSAGE acc. to TS 34.229 A.7.4
   * @param     p_Protocol
   * @param     p_SipUrl_PAssertedId
   * @param     p_CallIdMO
   * @param     p_CSeqValue         (default value: tsc_MESSAGE_CSeqValue)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderTX_SubmissionReport(InternetProtocol_Type p_Protocol,
                                                                 template (value) SipUrl p_SipUrl_PAssertedId,
                                                                 CallidString p_CallIdMO,
                                                                 integer p_CSeqValue := tsc_MESSAGE_CSeqValue) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-131269  R5-133705 sic@ */
    /* @sic R5-152094: parameter p_SipUrl_PAssertedId sic@ */
    var template (value) MessageHeader v_MessageHeader_Message;

    v_MessageHeader_Message := f_IMS_MessageRequest_MessageHeaderTX_Common(p_Protocol, p_CSeqValue, "fork");
    v_MessageHeader_Message.pAssertedID     := cs_PAssertedId(p_SipUrl_PAssertedId);
    v_MessageHeader_Message.inReplyTo       := cs_InReplyTo(p_CallIdMO);         /* @sic R5-131269: The value of the Call-Id received in the original MO SMS sic@ */

    return v_MessageHeader_Message;
  }

  /*
   * @desc      MESSAGE acc. to TS 34.229 A.7.5
   * @param     p_Protocol
   * @param     p_SipUrl_PAssertedId
   * @param     p_CSeqValue
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderTX_StatusReport(InternetProtocol_Type p_Protocol,
                                                             template (value) SipUrl p_SipUrl_PAssertedId,
                                                             integer p_CSeqValue) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-131269  R5-133705 sic@ */
    /* @sic R5-152094: parameter p_SipUrl_PAssertedId sic@ */
    var template (value) MessageHeader v_MessageHeader_Message;
    
    v_MessageHeader_Message := f_IMS_MessageRequest_MessageHeaderTX_Common(p_Protocol, p_CSeqValue, "no-fork");
    v_MessageHeader_Message.pAssertedID     := cs_PAssertedId(p_SipUrl_PAssertedId);
    v_MessageHeader_Message.acceptContact   := cs_AcceptContact(cs_AcRcParamsSMS);

    return v_MessageHeader_Message;
  }

  /*
   * @desc      common MESSAGE for A.7.2, A.7.3, A.7.6
   * @param     p_SipUrl_To
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderRX_Common(template (present) SipUrl p_SipUrl_To) runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130370 change 3 - additional parameter p_SipUrl_To; R5-133705 sic@ */
    /* @sic R5s150086 - p_SessionIdSupported: pc_IMS_SessionIdSupported per default sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    
    var template (present) MessageHeader v_MessageHeader_Message := cr_MessageHeader_Dummy;
    var integer v_Port_us := f_IMS_PTC_GetPort_us();
    // @sic R5s120530 changes 2.3, 2.5, 2.6 sic@
    v_MessageHeader_Message.via             := cr_ViaDef(-, cr_HostPort(?, v_Port_us));
    v_MessageHeader_Message.fromField       := cr_FromWithTag(?);
    v_MessageHeader_Message.toField         := cr_ToDef(p_SipUrl_To);    /* @sic R5s130370 change 3 sic@ */
    v_MessageHeader_Message.callId          := cr_CallId(?);             /* to be checked when message has been received */
    v_MessageHeader_Message.cSeq            := cr_CseqDef(?, "MESSAGE");
    v_MessageHeader_Message.maxForwards     := cr_MaxForwardsDef;
    v_MessageHeader_Message.contentType     := cr_ContentType("application/vnd.3gpp.sms");

    return v_MessageHeader_Message;
  }

  /*
   * @desc      MESSAGE for MO SMS (see TS 34.229, A.7.3)
   * @param     p_SipUrl_To           (default value: ?)
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderRX_MO_SMS(template (present) SipUrl p_SipUrl_To := ?) runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130370 change 3 - additional parameter p_SipUrl_To; R5-133705 sic@ */
    var template (present) MessageHeader v_MessageHeader_Message;
    var integer v_Port_ps := f_IMS_PTC_GetPort_ps();
    var charstring v_Pcscf := f_IMS_PTC_Pcscf_Get();

    v_MessageHeader_Message := f_IMS_MessageRequest_MessageHeaderRX_Common(p_SipUrl_To);

    if (f_IMS_PTC_SecurityScheme_IsImsSecurity()) {        // @sic R5s240677: f_IMS_PTC_SecurityScheme_IsImsSecurity instead of f_IMS_PTC_SecurityScheme_IsGiba sic@
      v_MessageHeader_Message.pAccessNetworkInfo := cr_PAccessNetworkInfo(f_IMS_PTC_GetRanType());
    }
    v_MessageHeader_Message.route := cr_Route(cr_RouteBodyList_InitialReq(v_Port_ps, v_Pcscf));

    return v_MessageHeader_Message;
  }

  /*
   * @desc      MESSAGE for SMS Delivery Report acc. to TS 34.229, A.7.6 or A.7.2
   * @param     p_SipUrl_To
   * @param     p_CallidString
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_MessageHeaderRX_DeliveryReport(template (present) SipUrl p_SipUrl_To,
                                                               CallidString p_CallidString) runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130370 change 3 - additional parameter p_SipUrl_To; R5-133705: "InReplyTo" sic@ */
    var template (present) MessageHeader v_MessageHeader_Message;
    
    v_MessageHeader_Message := f_IMS_MessageRequest_MessageHeaderRX_Common(p_SipUrl_To);
    if (f_IMS_PTC_UE_ReleaseGreaterOrEqual(11)) {  /* @sic R5s130739 MCC160 implementation; R5s150630: f_IMS_PTC_UE_ReleaseGreaterOrEqual sic@ */
      v_MessageHeader_Message.inReplyTo := cr_InReplyTo(p_CallidString);
    }

    return v_MessageHeader_Message;
  }

  /*
   * @desc      check whether call-id has been used previously
   * @param     p_MessageHeader
   * @param     p_PrevCallIds
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageHeader_CheckCallId(MessageHeader p_MessageHeader,
                                           CharStringList_Type p_PrevCallIds) runs on IMS_PTC
  {
    var integer i;

    for (i:=0; i < lengthof(p_PrevCallIds); i:=i+1) {
      if (match(p_MessageHeader.callId.callid, p_PrevCallIds[i])) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid 'CallId': has already been used in previous request)");
      }
    }
  }

  /*
   * @desc      To receive and check MESSAGE request
   * @param     p_SipUrlRequestLine
   * @param     p_MessageHeader
   * @param     p_PrevCallIdList    (default value: {})
   * @return    IMS_DATA_REQ
   * @status    APPROVED (IMS, LTE_A_R12, NR5GC)
   */
  function f_IMS_MessageRequest_Receive(template (present) SipUrl p_SipUrlRequestLine,
                                        template (present) MessageHeader p_MessageHeader,
                                        CharStringList_Type p_PrevCallIdList := {}) runs on IMS_PTC return IMS_DATA_REQ
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MessageHeader v_MessageHeader;
    var InternetProtocol_Type v_Protocol;

    v_IMS_DATA_REQ := f_IMS_ReceiveRequest(car_IMS_Message_Request(cr_MESSAGE_Request(p_SipUrlRequestLine, p_MessageHeader, cr_MessageBody_SMS(?))));
    v_MessageHeader := v_IMS_DATA_REQ.Request.Message.msgHeader;
    v_Protocol := v_IMS_DATA_REQ.RoutingInfo.Protocol;
    f_IMS_MessageHeader_Request_CheckVia(v_MessageHeader, v_Protocol);           // check whether via contains "SIP URI with IP address or FQDN" (see @sic R5s120727 sic@)
    f_IMS_MessageHeader_CheckCallId(v_MessageHeader, p_PrevCallIdList);  // @sic R5-133705: check that Call-ID is different from the Call-ID values used in preceding requests of this test case sic@

    return v_IMS_DATA_REQ;
  }

}
