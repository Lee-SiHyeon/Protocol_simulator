module NR_ASP_Templates_BWP {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;

  const ControlResourceSetId tsc_NR_ControlResourceSetId_Zero := 0;   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const B45_Type tsc_Coreset0_FrequencyDomain := '111100000000000000000000000000000000000000000'B;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const B45_Type tsc_Coreset0_FrequencyDomain_SharedSpectrum := '111111110000000000000000000000000000000000000'B; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
                                                                                                                     @sic R5-240531, R5w240005 sic@ */

  const integer tsc_Coreset0_Duration_SharedSpectrum := 1; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
                                                              @sic R5-240531, R5w240005 sic@ */

  template (value) NR_PDCCH_EPREs_Type cs_NR_PDCCH_EPREs_Def :=
  { //Acc to 38.508-1 Table 6.2.1.2-1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    PdcchToCell := 0,
    PdcchToDmrs := 0
  };

  template (value)  NR_PDSCH_EPREs_Type cs_NR_PDSCH_EPREs_Def :=
  { //Acc to 38.508-1 Table 6.2.1.2-1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    PdschToCell := -3,  /* @sic R5-194790 sic@
                           Table 6.2.1.2-1/2:
                           EPRE ratio of PDSCH DMRS to EPRE_CellRef:  0dB
                           EPRE ratio of PDSCH to PDSCH DMRS:        -3dB
                           => EPRE ratio of PDSCH to EPRE_CellRef:   -3dB */
    PdschToDmrs := -3,  /* @sic R5-194790 sic@
                           EPRE ratio of PDSCH to PDSCH DMRS:        -3dB (see PdschToCell) */
    PdschToPtrs := -3   /* @sic R5-194790 sic@
                           Table 6.2.1.2-1/2:
                           EPRE ratio of PTRS to PDSCH:               3dB
                           => EPRE ratio of PDSCH to PTRS:           -3dB */
  };

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_CssType0      := { cssType0,      0 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_CssType0A     := { cssType0A,     1 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_CssType1      := { cssType1,      2 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_CssType2      := { cssType2,      3 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_CssType3      := { cssType3,      4 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_UssDL         := { ussDL,         5 };    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_SearchSpaceTypeAndPriority_Type tsc_NR_SearchSpaceTypeAndPriority_UssUL         := { ussUL,         9 };    /* (periodic) UL grants shall have lowest priority
                                                                                                                          @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_SearchSpaceTypeAndPriorityList_Type cs_NR_SearchSpaceTypeAndPriorityList_SearchSpaceZero :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5s190291 change 2 sic@
    tsc_NR_SearchSpaceTypeAndPriority_CssType0,
    tsc_NR_SearchSpaceTypeAndPriority_CssType2
  };

  template (value) NR_SearchSpaceTypeAndPriorityList_Type cs_NR_SearchSpaceTypeAndPriorityList_CSS :=
  { // All common search space types can be mapped to one common search space even for ENDC (for which only Type1 will be used)
    // @sic R5-191187 R5s190291 change 2 sic@
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    tsc_NR_SearchSpaceTypeAndPriority_CssType1,
    tsc_NR_SearchSpaceTypeAndPriority_CssType3
  };

  template (value) NR_SearchSpaceTypeAndPriorityList_Type cs_NR_SearchSpaceTypeAndPriorityList_USS :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    tsc_NR_SearchSpaceTypeAndPriority_UssDL,
    tsc_NR_SearchSpaceTypeAndPriority_UssUL
  };

  template (value) NR_SearchSpaceTypeAndPriorityList_Type cs_NR_SearchSpaceTypeAndPriorityList_SISS :=
  { // All search space types for SISS
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    tsc_NR_SearchSpaceTypeAndPriority_CssType0A
  };

  /*
   * @desc      returns monitoringSymbolsWithinSlot corresponding to O=0, M=1 according to Tables 13-11 and 13-12 of 38.213
   * @param     p_SubcarrierSpacing
   * @return    SearchSpace.monitoringSlotPeriodicityAndOffset
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_SearchSpaceZeroAtSS_MonitoringSlotPeriodicityAndOffset(SubcarrierSpacing p_SubcarrierSpacing) return SearchSpace.monitoringSlotPeriodicityAndOffset
  { /* returns monitoringSymbolsWithinSlot corresponding to O=0, M=1 and i=1 in calculation of n0 of 38.213 clause 13 (i=1 );
       38.213 clause 13 specifies positions for even and odd frame numbers => periodicity is assumed to be 2 frames */
    var SearchSpace.monitoringSlotPeriodicityAndOffset v_MonitoringSlotPeriodicityAndOffset;
    var integer v_Offset := tsc_NR_SearchSpaceZero_SSB1_SlotIndexN0;
    select (p_SubcarrierSpacing) { /* 38.213 clause 13 specifies positions for even and odd frame numbers => periodicity is assumed to be 2 frames */
      case (kHz15)  { v_MonitoringSlotPeriodicityAndOffset := {sl20 := v_Offset}; }
      case (kHz30)  { v_MonitoringSlotPeriodicityAndOffset := {sl40 := v_Offset}; }
      case (kHz60)  { v_MonitoringSlotPeriodicityAndOffset := {sl80 := v_Offset}; }
      case (kHz120) { v_MonitoringSlotPeriodicityAndOffset := {sl160 := v_Offset}; }
    }
    return v_MonitoringSlotPeriodicityAndOffset;
  }

  template (value) ControlResourceSet cs_NR_ControlResourceSetZeroAtSS(integer p_ShiftIndex,
                                                                       B45_Type p_Coreset0_FrequencyDomain := tsc_Coreset0_FrequencyDomain,
                                                                       integer p_Duration := tsc_Coreset_Duration) :=
  /* CORESET#0 configuration according to 38.211 clause 7.3.2.2 */
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_38508_ControlResourceSet(tsc_NR_ControlResourceSetId_Zero, cs_NR_ControlResourceSet_InterleavedMapping(p_ShiftIndex), p_Coreset0_FrequencyDomain, p_Duration);

  template (value) SearchSpace cs_NR_SearchSpaceZeroAtSS(SubcarrierSpacing p_SubcarrierSpacing) :=
  { /* search space configuration corresponding to search space #0 as according to 38.213 clause 10 and 13 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    searchSpaceId := tsc_NR_SearchSpaceId_Zero,
    controlResourceSetId := tsc_NR_ControlResourceSetId_Zero,
    monitoringSlotPeriodicityAndOffset := fl_NR_SearchSpaceZeroAtSS_MonitoringSlotPeriodicityAndOffset(p_SubcarrierSpacing),
    duration := 2,                                              /* two consecutive slots according to 38.213 clause 13 */
    monitoringSymbolsWithinSlot := '10000000000000'B,           /* => PDCCH assignments at the beginning of each slot */
    nrofCandidates := {                                         /* according to 38.213 table 10.1-1; may not be needed by the SS */
      aggregationLevel1 := n0,
      aggregationLevel2 := n0,
      aggregationLevel4 := n4,
      aggregationLevel8 := n2,
      aggregationLevel16 := n1
    },
    searchSpaceType := cs_NR_SearchSpace_SearchSpaceType_CSS
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero(SubcarrierSpacing p_SubcarrierSpacing) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    TypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_SearchSpaceZero,
    AggregationLevel := AggregationLevel4,                      // according to 38.523-3 clause 7.1.2.1.2
    SearchSpaceConfigAtUE := {
      R15 := cs_NR_SearchSpaceZeroAtSS(p_SubcarrierSpacing),
      R16 := omit,    //@sic R5w230011 sic@
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_CSS(template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                                                 SearchSpaceId p_SearchSpaceId := tsc_NR_SearchSpaceId_CSS,
                                                                                 ControlResourceSetId p_ControlResourceSetId := tsc_NR_ControlResourceSetId_Zero,
                                                                                 template (value) SearchSpace.monitoringSlotPeriodicityAndOffset p_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS,
                                                                                 template (omit)  SearchSpace.duration p_Duration := omit
                                                                                 ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-202677 R5-202561 sic@
    TypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_CSS,
    AggregationLevel := AggregationLevel4,                      // according to 38.523-3 clause 7.1.2.1.2
    SearchSpaceConfigAtUE := {
      R15 := cs_38508_SearchSpace(p_SearchSpaceId, p_ControlResourceSetId, cs_NR_SearchSpace_SearchSpaceType_CSS, p_NrofCandidates, p_SlotPeriodicityAndOffset, p_Duration),
      R16 := omit,    //@sic R5w230011 sic@
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_USS(template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                                                 SearchSpaceId p_SearchSpaceId := tsc_NR_SearchSpaceId_USS,
                                                                                 ControlResourceSetId p_ControlResourceSetId := tsc_NR_ControlResourceSetId,
                                                                                 template (value) SearchSpace.monitoringSlotPeriodicityAndOffset p_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS,
                                                                                 template (omit)  SearchSpace.duration p_Duration := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    TypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_USS,
    AggregationLevel := AggregationLevel2,                      // according to 38.523-3 clause 7.1.2.1.2 @sic R5-237429 sic@
    SearchSpaceConfigAtUE := {
      R15 := cs_38508_SearchSpace(p_SearchSpaceId, p_ControlResourceSetId, cs_NR_SearchSpace_SearchSpaceType_USS(f_NR_GetUSS_DCI_Format()), p_NrofCandidates, p_SlotPeriodicityAndOffset, p_Duration),   /* @sic R5-196751: formats0_0_And_1_0 replaced by formats0_1_And_1_1 R5s190892 R5s190895 sic@ */
      R16 := omit,    //@sic R5w230011 sic@
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_SISS(template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                                                  SearchSpaceId p_SearchSpaceId := tsc_NR_SearchSpaceId_SISS,
                                                                                  ControlResourceSetId p_ControlResourceSetId := tsc_NR_ControlResourceSetId_Zero) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-191187 R5-202677 R5-202561 sic@
    TypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_SISS,
    AggregationLevel := AggregationLevel4,                      // according to 38.523-3 clause 7.1.2.1.2
    SearchSpaceConfigAtUE := {
      R15 := cs_38508_SearchSpace(p_SearchSpaceId, p_ControlResourceSetId, cs_NR_SearchSpace_SearchSpaceType_CSS, p_NrofCandidates, cs_MonitoringSlotPeriodicityAndOffset_SISS, 2),
      R16 := omit,    //@sic R5w230011 sic@
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_CSS_DCI_2_7( template (value) SearchSpace p_SearchSpace) :=
  { /* @status    APPROVED (NR5GC) */
    TypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_SearchSpaceZero,
    AggregationLevel := AggregationLevel4,
    SearchSpaceConfigAtUE := {
      R15 := p_SearchSpace,
      R16 := omit,
      R17 := cs_38508_SearchSpaceExt_v1700,
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_ASN1_ControlResourceSet_Type cs_NR_ASN1_ControlResourceSet(template (value) ControlResourceSet p_ControlResourceSet) :=
  { /* @sic R5-190786, RP-182523: CORESET#0 according to 38.211 clause 7.3.2.2 sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    R15 := p_ControlResourceSet
  };

  template (value) NR_UplinkBWP_Type cs_NR_UplinkBWP_Initial(SubcarrierSpacing               p_SubcarrierSpacing,
                                                             BWP.locationAndBandwidth        p_LocationAndBandwidth,
                                                             NR_Prach_RootSequenceIndex_Type p_Prach_RootSequenceIndex,
                                                             RACH_ConfigCommon.ssb_perRACH_OccasionAndCB_PreamblesPerSSB p_Ssb_perRACH_OccasionAndCB_PreamblesPerSSB,
                                                             template (value) RACH_ConfigGeneric p_RACH_ConfigGeneric,
                                                             template (value) PUSCH_TimeDomainResourceAllocationList p_PUSCH_TimeDomainResourceAllocationList,
                                                             template (value) PUSCH_Config   p_PUSCH_Config,
                                                             template (omit) BWP_UplinkDedicated.srs_Config  p_SRS_Config,
                                                             SSB_Index p_SSB_Index,
                                                             PRB_Id p_PRB_SecondHopPRBId,
                                                             template (omit) PUCCH_Config.dl_DataToUL_ACK p_DL_DataToUL_ACK,
                                                             template (omit) BWP_UplinkDedicated.lbt_FailureRecoveryConfig_r16 p_LBT_FailureRecoveryConfig_r16 := omit,
                                                             template (omit) PUCCH_Config.ul_AccessConfigListDCI_1_1_r16 p_Ul_AccessConfigListDCI_1_1, //@sic R5-245544 sic@
                                                             NTN_Satellite_Type p_SatelliteType := ntn_None
                                                             ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-202820: added p_PRB_SecondHopPRBId R5-214381: added p_DL_DataToUL_ACK R5s250100 R5-253086: added p_SatelliteType sic@
    Id := tsc_NR_BWP_Id,
    Common := {
      R15 := cs_38508_BWP_UplinkCommon(cs_38508_BWP (p_SubcarrierSpacing, p_LocationAndBandwidth),
                                       cs_38508_RACH_ConfigCommon(p_Prach_RootSequenceIndex,
                                                                  p_SubcarrierSpacing,
                                                                  p_Ssb_perRACH_OccasionAndCB_PreamblesPerSSB,
                                                                  p_RACH_ConfigGeneric),
                                       cs_38508_PUSCH_ConfigCommon(p_PUSCH_TimeDomainResourceAllocationList),
                                       cs_38508_PUCCH_ConfigCommon)
    },
    Dedicated := {
      R15 := cs_38508_BWP_UplinkDedicated(cs_38508_PUCCH_Config(p_SubcarrierSpacing, 0, p_PRB_SecondHopPRBId, p_SSB_Index, p_DL_DataToUL_ACK, p_Ul_AccessConfigListDCI_1_1, p_SatelliteType),//@sic R5-245544 sic@
                                          p_PUSCH_Config,
                                          p_SRS_Config,    /* @sic R5s190852 change 1: p_SRS_Config sic@ */
                                          p_LBT_FailureRecoveryConfig_r16)
    }
  };

  template (value) NR_DownlinkBWP_List_Type cs_NR_DownlinkBWP_List_Def(SubcarrierSpacing p_SubcarrierSpacing,
                                                                       PhysCellId p_PhysCellId,
                                                                       BWP.locationAndBandwidth p_LocationAndBandwidth,
                                                                       template (value) DMRS_DownlinkConfig p_DMRS_DownlinkConfig,
                                                                       template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                                       template (value) PDSCH_TimeDomainResourceAllocationList p_PDSCH_TimeDomainResourceAllocationList,
                                                                       template (omit) PDSCH_Config.mcs_Table p_Mcs_Table := omit,
                                                                       integer p_Coreset0_OffsetRBs,
                                                                       SSB_Index p_SSB_Index,
                                                                       template (value) SearchSpace.monitoringSlotPeriodicityAndOffset p_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS,
                                                                       template (omit)  SearchSpace.duration p_Duration := omit,
                                                                       B45_Type p_Coreset0_FrequencyDomain := tsc_Coreset0_FrequencyDomain,
                                                                       integer p_CoresetDuration := tsc_Coreset_Duration,
                                                                       template (omit) integer p_Coreset0_PuncturingSize,
                                                                       B45_Type p_Coreset1_FrequencyDomain
                                                                       ) :=
  { // @sic R5-190670: p_Mcs_Table:=omit per default sic@
    /* @sic R5-190786: p_PhysCellId sic@ */
    /* @sic R5w250011: added p_Coreset0_PuncturingSize */
    /* @sic R5-250401: added p_Coreset1_FrequencyDomain sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_38508_DownlinkBWP_Initial(p_SubcarrierSpacing, p_PhysCellId, p_LocationAndBandwidth, p_DMRS_DownlinkConfig, p_NrofCandidates, p_PDSCH_TimeDomainResourceAllocationList, p_Mcs_Table, p_Coreset0_OffsetRBs, p_SSB_Index, p_SlotPeriodicityAndOffset, p_Duration, p_Coreset0_FrequencyDomain, p_CoresetDuration, p_Coreset0_PuncturingSize, p_Coreset1_FrequencyDomain)
  };

  template (value) NR_DownlinkBWP_Type cs_38508_DownlinkBWP_Initial(SubcarrierSpacing p_SubcarrierSpacing,
                                                                    PhysCellId p_PhysCellId,
                                                                    BWP.locationAndBandwidth p_LocationAndBandwidth,
                                                                    template (value) DMRS_DownlinkConfig p_DMRS_DownlinkConfig,
                                                                    template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates,
                                                                    template (value) PDSCH_TimeDomainResourceAllocationList p_PDSCH_TimeDomainResourceAllocationList,
                                                                    template (omit) PDSCH_Config.mcs_Table p_Mcs_Table := omit,
                                                                    template (omit) integer p_Coreset0_OffsetRBs,
                                                                    SSB_Index p_SSB_Index,
                                                                    template (value) SearchSpace.monitoringSlotPeriodicityAndOffset p_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS,
                                                                    template (omit)  SearchSpace.duration p_Duration := omit,
                                                                    B45_Type p_Coreset0_FrequencyDomain := tsc_Coreset0_FrequencyDomain,
                                                                    integer p_CoresetDuration := tsc_Coreset_Duration,
                                                                    template (omit) integer p_Coreset0_PuncturingSize,
                                                                    B45_Type p_Coreset1_FrequencyDomain
                                                                    ) :=
  { // Acc to 38.508-1 Table 4.6.3-9: BWP-Downlink
    // @sic R5-190670: p_Mcs_Table:=omit per default sic@
    /* @sic R5-190786: p_PhysCellId sic@ */
    /* @sic R5w250011: added p_Coreset0_PuncturingSize */
    /* @sic R5-250401: added p_Coreset1_FrequencyDomain sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Id := tsc_NR_BWP_Id,   // Initial BWP
    BWP := {
      R15 := cs_38508_BWP (p_SubcarrierSpacing, p_LocationAndBandwidth)
    },
    Pdcch := {
      SearchSpaceArray := {
        cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero(p_SubcarrierSpacing),
        cs_NR_BWP_SearchSpaceConfig_CSS(p_NrofCandidates, -, -, p_SlotPeriodicityAndOffset, p_Duration),
        cs_NR_BWP_SearchSpaceConfig_USS(p_NrofCandidates, -, -, p_SlotPeriodicityAndOffset, p_Duration),
        cs_NR_BWP_SearchSpaceConfig_SISS(p_NrofCandidates)                             // @sic R5-191187 sic@
      },
      CoresetArray := {
        cs_NR_ASN1_ControlResourceSet(cs_NR_ControlResourceSetZeroAtSS(p_PhysCellId, p_Coreset0_FrequencyDomain, p_CoresetDuration)), // CORESET#0 according to 38.211 clause 7.3.2.2 with shift index being the physical layer cell id @sic R5-190786, RP-182523 sic@ */
        cs_NR_ASN1_ControlResourceSet(cs_38508_ControlResourceSet(-, -, p_Coreset1_FrequencyDomain))             // default CORESET as according to 38.508-1 Table 4.6.3-17
      },
      RelativeTxPower  := cs_NR_PDCCH_EPREs_Def,
      Coreset0_OffsetRBs := p_Coreset0_OffsetRBs, //@sic R5-201020 sic@
      Coreset0_PuncturingSize := p_Coreset0_PuncturingSize  //@sic R5w250011 sic@
    },
    Pdsch := {
      ConfigCommon := {
        R15 := cs_38508_PDSCH_ConfigCommon(p_PDSCH_TimeDomainResourceAllocationList)
      },
      ConfigDedicated := {
        R15 := cs_38508_PDSCH_Config(p_DMRS_DownlinkConfig, p_Mcs_Table, p_SSB_Index)
      },
      RelativeTxPower := cs_NR_PDSCH_EPREs_Def
    },
    Sps       := omit,
    SL_Pdcch  := omit,         //@sic R5w230215 sic@
    NCD_SSPbchBlock := omit    //@sic R5w230309 sic@
  };

}
