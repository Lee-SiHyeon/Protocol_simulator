  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.4.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_2_3_4_ENDC_NR() runs on ENDC_NR_PTC
  { // AM RLC / 18-bit SN / Correct use of sequence numbering
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (omit)  NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) DRB_ToAddModList  v_DRB_ToAddModList;
    var UL_t_PollRetransmit_Type v_T_PollRetransmit;
    var DL_t_Reassembly_Type v_T_Reassembly;
    
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0); // @sic R5s190254 ch. 1.1 sic@
    
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB2); // SNsize 18
    v_DRB_ToAddModList[0] := cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config); // default is 18 bits from 38.508
    // Establishing AM RLC  parameters
    v_T_PollRetransmit := ms4000; //@sic R5-202613 sic@
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2,
                                                     -,
