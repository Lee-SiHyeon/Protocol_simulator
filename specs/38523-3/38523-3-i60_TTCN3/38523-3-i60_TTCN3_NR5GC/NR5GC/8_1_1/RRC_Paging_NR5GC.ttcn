module RRC_Paging_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_Parameters all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;

  template (value) PagingRecordList cs_PagingRecordList_ThreeRecords(template (value) PagingUE_Identity p_PagingUE_Identity_1,
                                                                     template (value) PagingUE_Identity p_PagingUE_Identity_2,
                                                                     template (value) PagingUE_Identity p_PagingUE_Identity_3):=
  { /* @status    APPROVED (NR5GC) */
    cs_PagingRecord(p_PagingUE_Identity_1),
    cs_PagingRecord(p_PagingUE_Identity_2),
    cs_PagingRecord(p_PagingUE_Identity_3)
  };

  template (present) InitialUE_Identity cr_InitialUE_Identity_NG_5G_S_TMSI_Part1(InitialUE_Identity.ng_5G_S_TMSI_Part1 p_NG_5G_S_TMSI_Part1) :=
  { /* @status    APPROVED (NR5GC) */
    ng_5G_S_TMSI_Part1 := p_NG_5G_S_TMSI_Part1
  };

  template RRCSetupComplete_IEs.ng_5G_S_TMSI_Value cr_NG_5G_S_TMSI_Value_NG_5G_S_TMSI_Part2(B9_Type p_NG_5G_S_TMSI_Part2) :=
  { /* @status    APPROVED (NR5GC) */
    ng_5G_S_TMSI_Part2 := p_NG_5G_S_TMSI_Part2
  };

  /*
   * @desc      test body of TC_8_1_1_1_1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_1_1_NR5GC() runs on NR5GC_PTC
  { //RRC / Paging for connection / Multiple paging records

    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_1_1_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_1_1_1_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_1_1_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_GutiParameters_Type v_GutiParameters;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_5G_S_TMSI v_NG_5G_S_TMSI;
    var NG_5G_S_TMSI v_NG_5G_S_TMSI_diff;
    var I_RNTI_Value v_FullI_RNTI;
    var I_RNTI_Value v_FullI_RNTI_diff;
    var PCCH_Config v_PcchConfig;
    var float v_Wait10s := 10.0;
    timer t_Wait := 10.0;

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message including only unmatched identities (incorrect ng-5G-S-TMSI).
    v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(nr_Cell1);
    v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);
    v_NG_5G_S_TMSI_diff := f_CreateNewS_TMSING_5G_S_TMSI(v_NG_5G_S_TMSI);
    v_PcchConfig := f_NR_GetSIB1_PcchConfig(nr_Cell1);
    f_NR_Paging(nr_Cell1,
                cs_PagingRecordList_ThreeRecords(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff),
                                                 cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff),
                                                 cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff)),
                v_PcchConfig.defaultPagingCycle);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message within 10s?
    f_NR_CheckNoRRCSetupReq(nr_Cell1, v_Wait10s, -, "Step 2: UE sent an RRCSetupRequest on NR Cell 1 within 10s"); //@sic R5s201387 sic@

    //@siclog "Step 3" siclog@
    //The SS transmits a Paging message including two unmatched identities (incorrect ng-5G-S-TMSI) and a matched identity (correct ng-5G-S-TMSI).
    f_NR_Paging(nr_Cell1,
                cs_PagingRecordList_ThreeRecords(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff),
                                                 cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff),
                                                 cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)),
                v_PcchConfig.defaultPagingCycle);

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    //@siclog "Step 5" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 6" siclog@
    //The UE transmit an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
    //@siclog "Step 7-10" siclog@
    //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //EXCEPTION: Steps 11a1-11a7 describe behaviour that depends on UE configuration; the "lower case letter" identifies a step sequence that takes place if inactiveState is configured
    //@sic R5-213112 sic@
    if(pc_inactiveState){

        //@siclog "Step 11a1" siclog@
        //The SS transmits an RRCRelease message including suspendConfig.
        f_NR_RRC_InactiveDef(nr_Cell1);

        //@siclog "Step 11a2" siclog@
        //The SS transmits a Paging message including only unmatched identities (incorrect i-RNTI).
        v_FullI_RNTI := tsc_NR_I_RNTI_Value1;
        v_FullI_RNTI_diff := '0000000000000000000000000000000000000001'B;
        f_NR_Paging(nr_Cell1,
                    cs_PagingRecordList_ThreeRecords(cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff),
                                                     cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff),
                                                     cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff)),
                    v_PcchConfig.defaultPagingCycle);

        //@siclog "Step 11a3" siclog@
        //Check: Does the UE transmit an RRCResumeRequest message within 10s?
        t_Wait.start;
        alt {
          [] t_Wait.timeout
            {
               f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11a3");
            }
          [] SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1)))
            {
               t_Wait.stop;
               f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 11a3");
            }
        }

        //@siclog "Step 11a4" siclog@
        //The SS transmits a Paging message including two unmatched identities (incorrect i-RNTI) and a matched identity (correct i-RNTI).
        f_NR_Paging(nr_Cell1,
                    cs_PagingRecordList_ThreeRecords(cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff),
                                                     cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff),
                                                     cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI)),
                    v_PcchConfig.defaultPagingCycle);

        //@siclog "Step 11a5" siclog@
        //Check: Does the UE transmit an RRCResumeRequest message?
        SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1, mt_Access)));

        //@siclog "Step 11a6" siclog@
        //The SS transmits an RRCResume message.
        //@sic R5s190505 change 1 sic@
        f_NR_SendRRCResume_Def(nr_Cell1);

        //@siclog "Step 11a7" siclog@
        //The UE transmits an RRCResumeComplete message.
        SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_RRCResumeComplete));
        f_NR_SS_ReconfigSStoUSS_DCI1_1(nr_Cell1);  //@sic R5s240461 sic@
        // Reconfigure RACH procedure as for initial access.  @sic R5s240440 sic@
        f_NR_SS_RachProcedureConfig_Def(nr_Cell1);
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_1_2_NR5GC() runs on NR5GC_PTC
  { // RRC / Paging for connection / Shared network environment

    f_NR5GC_Init(NR_1);

    //Update SIB1 according to specific message contents
    //@sic R5s190642 Change 4.1 sic@
    f_NR_CellInfo_SetPLMN(nr_Cell1, tsc_NR_HPLMN_001_02, 0, 1);
    f_NR_CellInfo_SetPLMN(nr_Cell1, tsc_NR_HPLMN_Def);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_1_2_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_8_1_1_1_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_1_2_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NG_5G_S_TMSI v_NG_5G_S_TMSI;
    var InitialUE_Identity.ng_5G_S_TMSI_Part1 v_NG_5G_S_TMSI_Part1;
    var B9_Type v_NG_5G_S_TMSI_Part2;
    var template (present) NG_MobileIdentity v_S_TMSI;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) SuspendConfig v_SuspendConfig;
    var CellIdentity v_CellIdentity;

    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters(nr_Cell1);
    v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParams);
    v_NG_5G_S_TMSI_Part1 := substr(v_NG_5G_S_TMSI, 9, 39);
    v_NG_5G_S_TMSI_Part2 := substr(v_NG_5G_S_TMSI, 0, 9);
    v_S_TMSI := f_NG_S_TMSI2MobileIdentity(omit, v_GutiParams);

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message including a matched ng-5G-S-TMSI.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message with ue-Identity set to ng-5G-S-TMSI-Part1?
    f_NR_RRC_SetupRequest_Def(nr_Cell1, mt_Access, cr_InitialUE_Identity_NG_5G_S_TMSI_Part1(v_NG_5G_S_TMSI_Part1));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    //@siclog "Step 3" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def(nr_Cell1);

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCSetupComplete message including ng-5G-S-TMSI-Part2 and a SERVICE REQUEST message
    //and an IE selectedPLMN-Identity corresponding to the PLMN on which the UE has been registered to confirm the successful completion of the connection establishment?
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, (1, 2), -, cr_NG_5G_S_TMSI_Value_NG_5G_S_TMSI_Part2(v_NG_5G_S_TMSI_Part2)),
                                               tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), v_S_TMSI)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }else{
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    }

    //@siclog "Steps 5 - 8" siclog@
    //Steps 5 to 8 of the generic radio bearer establishment procedure (TS 38.508-1 [4] Table 4.5.4.2-3) are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //EXCEPTION: Steps 9a1-9b1 describe behaviour that depends on UE configuration; the "lower case letter" identifies a step sequence that takes place if inactiveState is configured
    //@sic R5-213112 sic@
    if(pc_inactiveState){

        //@siclog "Step 9a1" siclog@
        //The SS transmits an RRCRelease message with suspendConfig to suspend RRC connection and move to RRC_INACTIVE state.
        v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
        v_SuspendConfig := cs_SuspendConfigDef(cs_RAN_NotificationAreaInfo_CellList(tsc_NR_HPLMN_Def, v_CellIdentity, tsc_NR_HPLMN_001_02, v_CellIdentity), rf256);  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
        f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,v_SuspendConfig)); // @sic R5s240531 sic@

        //@siclog "Step 9a2" siclog@
        //Wait 5s and the SS transmits a Paging message including a matched ng-5G-S-TMSI.
        f_Delay(5.0);
        f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

        //@siclog "Step 9a3" siclog@
        //Check: Does the UE transmit an RRCSetupRequest message on the cell specified in the test case?
        f_NR_RRC_SetupRequest_Def(nr_Cell1, mt_Access, cr_InitialUE_Identity_NG_5G_S_TMSI_Part1(v_NG_5G_S_TMSI_Part1));
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9a3");

        //@siclog "Steps 9a4 - 9a10" siclog@
        //Steps 3-9 of Generic procedure for checking UE is in state 5GC RRC_IDLE on a certain cell as specified in Table 4.9.4.2.2-1 of TS 38.508-1 [4] are performed.
        f_NR_RRCSetup_Def (nr_Cell1);
        v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                                   cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                                   tsc_SHT_IntegrityProtected);
        if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), v_S_TMSI)) {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
        }

        f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

        f_NR_RRCRelease(nr_Cell1);

    }else{
        //@siclog "Steps 9b1" siclog@
        //The SS transmits an RRCRelease message
        f_NR_RRCRelease(nr_Cell1);
    }
  }

}
