      { imminentPerilCall := cs_MCPTT_UserProfile_ImminentPerilCall},
      { emergencyAlert := cs_MCPTT_UserProfile_EmergencyAlert(cs_MCPTT_UserProfile_Entry(useCurrentlySelectedGroup, "0", px_MCPTT_Group_A_ID, px_MCPTT_Group_A_Name))},
      { priority := 10 }
    }
  };

  template (value) MCPTT_UserProfile_Common_Type cs_MCPTT_UserProfile_Common :=
  { /* @status    APPROVED (MCX) */
    index := "0",                                                                                 // MCPTTUserProfileIndex
    attr := omit,
    choice_list := {
      { mCPTTUserID := cs_MCPTT_UserProfile_Entry(-, "0", px_MCPTT_ID_User_A) },                  // MCPTTUserID
      { userAlias := cs_MCPTT_UserProfile_UserAlias(px_MCPTT_User_A_Alias) },                     // UserAlias
      { participantType := px_MCX_User_A_ParticipantType },                                       // ParticipantType
      { missionCriticalOrganization := px_MCX_DomainName_Organization_A },                        // Organization   @sic R5-200385 sic@
      { privateCall := cs_MCPTT_UserProfile_PrivateCall },                                        // PrivateCall
      { mCPTT_group_call := cs_MCPTT_UserProfile_MCPTTGroupCall }                                 // GroupCall
    }
