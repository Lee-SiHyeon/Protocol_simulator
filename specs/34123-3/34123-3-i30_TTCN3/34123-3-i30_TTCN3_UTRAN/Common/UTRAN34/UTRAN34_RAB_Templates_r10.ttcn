module UTRAN34_RAB_Templates_r10 {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_RRC_CommonTemplates_r10 all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CapabilityFunctions_IRAT all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_RAB_Templates_r10 all;
  import from UTRAN_RRC_RAB_Templates_r9 all;
  import from UTRAN_RRC_Templates all;

  template (value) DL_LogicalChannelMapping_r7 cs_DL_LogicalChannelMappingHSDSCH_MACehs_r7(MAC_ehs_QueueId p_MAC_ehs_QueueId,
                                                                                           LogicalChannelIdentity p_LogicalChannelIdDL := 7) :=
  { /* @status    APPROVED (UTRAN) */
    dl_TransportChannelType :=  {
      hsdsch := {
        mac_ehs := p_MAC_ehs_QueueId
      }
    },
    logicalChannelIdentity := p_LogicalChannelIdDL
  };

  template (value) DL_DCCH_Message cs_108_RB_SetUpA17d_r10_FDD(IntegrityCheckInfo  p_Integrityinfo,
                                                               ActivationTime  p_ActTime,
                                                               UL_ScramblingCode   p_UL_ScramblingCode,
                                                               PrimaryScramblingCode p_PrimScramblingCode) :=
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r10(p_Integrityinfo, cds_RadioBearerSetup_r10_IEs_A17d_FDD(p_ActTime,
                                                                                   tsc_H_RNTI,
                                                                                   tsc_E_RNTI,
                                                                                   p_UL_ScramblingCode,
                                                                                   p_PrimScramblingCode));

  template (value) RadioBearerSetup_r10_IEs cds_RadioBearerSetup_r10_IEs_A17d_FDD(ActivationTime  p_ActTime,
                                                                                  H_RNTI  p_NewH_RNTI,
                                                                                  E_RNTI  p_E_RNTI,
                                                                                  UL_ScramblingCode   p_UL_ScramblingCode,
                                                                                  PrimaryScramblingCode p_PrimScramblingCode)
    modifies cs_RadioBearerSetup_r10_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    newPrimary_E_RNTI := p_E_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_MACehs
    },
    rb_InformationAffectedList := cs_RB_InformationAffectedListSRBs_EDCH_DCH_r8,
    ul_deletedTransChInfoList := { cs_UL_TransportChannelIdDCH_r6(tsc_UL_DCH5) },
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListE_DCH_FDD,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD (cs_TFCS_Cmpl0_1_Rx),
    dl_AddReconfTransChInfoList := {
      cs_DL_AddReconfTransChInfoExplicit_r9(tsc_DL_DCH5, cs_DCH_148_TFS_UE_UL),
      cs_DL_AddReconfTransChHSDSCHInfo_HSDPA_r9 (cs_HSDSCH_Info_MACehs_r9 (cs_HARQ_Info_FDD, cs_AddOrReconfMAC_ehs_ReordQ_r9 (cs_MAC_ehs_AddReconfReordQ_r9(0))))
    },
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_OnlyHS_PDSCH_FDD (p_UL_ScramblingCode),
    ul_EDCH_Information := cs_UL_EDCH_Information_r9_FDD,
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_r9_FDD(cs_HS_SCCH_Info_r9_FDD,
                                                               cs_Measurement_Feedback_Info),
    dl_CommonInformation := cs_DL_CommonInformationRB_SetUp_FDD_r10 (tsc_DL_DPCH1_SFP_SRB_3_4k,
                                                                     fixed,
                                                                     false),
    dl_InformationPerRL_List := cds_DL_InformationPerRL_HSDPA_r8_FDD(p_PrimScramblingCode,
                                                                     tsc_Sfc256_C13,
                                                                     omit)
  };

  template (value) RAB_InformationSetup_r8 cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_MACehs :=
    /* @status    APPROVED (UTRAN) */
    cs_RAB_Info_PS_Common(tsc_RAB_DefPS_HS, tsc_RB25, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_HSU, {cs_RB_MappingOptionPS_RAB1_EDCH_HSDSCH_MACehs});

  template (value) UL_LogicalChannelMappings_r8 cs_UL_LogicalChannelMappings_E_DCH_flexibleSize_r8(LogicalChannelIdentity  p_LogicalChannelIdUL := tsc_UL_DTCH1,
                                                                                                   E_DCH_MAC_d_FlowIdentity p_E_DCH_MAC_d_FlowIdentity := tsc_E_DCH_MAC_d_FlowId_DTCH1,
                                                                                                   boolean p_IncludeInSchedulingInfo := true,
                                                                                                   MAC_LogicalChannelPriority p_LogicalChannelPriority := 8) :=
  { /* @status    APPROVED (UTRAN) */
    oneLogicalChannel := {
      ul_TrCH_Type := {
        e_dch := {
          logicalChannelIdentity := p_LogicalChannelIdUL,
          e_DCH_MAC_d_FlowIdentity := p_E_DCH_MAC_d_FlowIdentity,
          rlc_PDU_Size := {
            flexibleSize := {
              lengthIndicatorSize := size15,
              // the actual values are (IE value * 8) + 16
              minRLC_PDU_Size := 0, //16
              largestRLC_PDU_Size := 302 //2432
            }
          },
          includeInSchedulingInfo := p_IncludeInSchedulingInfo
        }
      },
      mac_LogicalChannelPriority := p_LogicalChannelPriority
    }
  };

  template (value) RB_MappingOption_r8 cs_RB_MappingOptionPS_RAB1_EDCH_HSDSCH_MACehs :=
  { /* @status    APPROVED (UTRAN) */
    ul_LogicalChannelMappings := cs_UL_LogicalChannelMappings_E_DCH_flexibleSize_r8,
    dl_LogicalChannelMappingList := {
      cs_DL_LogicalChannelMappingHSDSCH_MACehs_r7(tsc_MACehs_Queue1_DCCH)
    }
  };

  template (value) RB_InformationAffectedList_r8 cs_RB_InformationAffectedListSRBs_EDCH_DCH_r8 :=
  { /* @status    APPROVED (UTRAN) */
    {
      rb_Identity := tsc_RB1,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_DCH_r8(tsc_UL_DCCH1, tsc_E_DCH_DDI_1, 1, tsc_DL_DCCH1)
      }
    },
    {
      rb_Identity := tsc_RB2,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_DCH_r8(tsc_UL_DCCH2, tsc_E_DCH_DDI_2, 2, tsc_DL_DCCH2)
      }
    },
    {
      rb_Identity := tsc_RB3,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_DCH_r8(tsc_UL_DCCH3, tsc_E_DCH_DDI_3, 3, tsc_DL_DCCH3)
      }
    },
    {
      rb_Identity := tsc_RB4,
      rb_MappingInfo := {
        cs_RB_MappingOptionSRB_EDCH_DCH_r8(tsc_UL_DCCH4, tsc_E_DCH_DDI_4, 4, tsc_DL_DCCH4)
      }
    }
  };

  template (value) RB_MappingOption_r8 cs_RB_MappingOptionSRB_EDCH_DCH_r8(LogicalChannelIdentity p_LogicalChannelId_UL,
                                                                          DDI p_DDI,
                                                                          MAC_LogicalChannelPriority p_MAC_LogicalChannelPriority,
                                                                          LogicalChannelIdentity p_LogicalChannelId_DL) :=
  { /* @status    APPROVED (UTRAN) */
    ul_LogicalChannelMappings := cs_UL_LogicalChannelMappings_E_DCH_fixedSize_r8(p_LogicalChannelId_UL, tsc_E_DCH_MAC_d_FlowId_DCCH, p_DDI, -, false, p_MAC_LogicalChannelPriority),
    dl_LogicalChannelMappingList := cs_DL_LogicalChannelMappingList_r7_DCH(tsc_DL_DCH5, p_LogicalChannelId_DL)
  };

  template (value) UL_TransportChannelIdentity_r6 cs_UL_TransportChannelIdDCH_r6(TransportChannelIdentity p_TrChId) :=
  { /* @status    APPROVED (UTRAN) */
    dch_usch := {
      ul_TransportChannelType := dch,
      ul_TransportChannelIdentity := p_TrChId
    }
  };

  template (value) HSDSCH_Info_r9 cs_HSDSCH_Info_MACehs_r9(template (value) HARQ_Info_r7 p_HARQ_Info,
                                                           template (value) AddOrReconfMAC_ehs_ReordQ_r9 p_AddOrReconfMAC_ehs_ReordQ) :=
  { /* @status    APPROVED (UTRAN) */
    harqInfo := p_HARQ_Info,
    dl_MAC_HeaderType := {
      mac_ehs := p_AddOrReconfMAC_ehs_ReordQ
    }
  };

  template (value) AddOrReconfMAC_ehs_ReordQ_r9 cs_AddOrReconfMAC_ehs_ReordQ_r9(template (value) MAC_ehs_AddReconfReordQ_r9 p_MAC_ehs_AddReconfReordQ) :=
  { /* @status    APPROVED (UTRAN) */
    mac_ehs_AddReconfQueue_List := {
      p_MAC_ehs_AddReconfReordQ
    }
  };

  template (value) UL_EDCH_Information_r9 cs_UL_EDCH_Information_r9_FDD :=
  { /* @status    APPROVED (UTRAN) */
    mac_es_e_resetIndicator := true_,
    modeSpecificInfo := {
      fdd := {
        e_DPCCH_Info := cs_E_DPCCH_Info,
        e_DPDCH_Info := cs_E_DPDCH_Info,
        schedulingTransmConfiguration := cs_E_DPDCH_SchedulingTransmConfiguration_NoGrant,
        ul_16QAM_Settings := omit
      }
    }
  };

  template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 cs_SS_MAC_ehs_AddReconfReordQueue_1Q(MAC_ehs_QueueId p_QID,
                                                                                              integer  p_QueuePriority) :=
  { /* @status    APPROVED (UTRAN) */
    cs_SS_MAC_ehs_AddReconfReordQ_r9(p_QID, p_QueuePriority)
  };

  template (value) U_CMAC_CONFIG_REQ cas_CMAC_CfgInfo_FDD_r10(UTRAN_CellId_Type         p_CellId,
                                                              integer                   p_PhyChId,
                                                              template (value) UE_Info  p_UEInfo,
                                                              template (value) TrCHInfo p_TrCHInfo,
                                                              template (value) TrCH_LogCHMappingList1 p_TrCH_LogCHMapping,
                                                              template (omit) CmacConfigReq_r10OrLaterExtensionType p_CmacConfigReq_r10OrLater := omit) :=
  /* @status    APPROVED (UTRAN) */
    cas_CMAC_CfgInfo_FDD(p_CellId, p_PhyChId, p_UEInfo, p_TrCHInfo, p_TrCH_LogCHMapping, true, p_CmacConfigReq_r10OrLater);

}
