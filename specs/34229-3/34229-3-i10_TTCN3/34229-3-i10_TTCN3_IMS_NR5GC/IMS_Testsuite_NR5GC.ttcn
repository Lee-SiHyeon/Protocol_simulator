  //----------------------------------------------------------------------------
  testcase TC_10_10_NR5GC() runs on MTC_IMS system SYSTEM_IMS {
    // @purpose
    //   Emergency call without emergency registration / Failure of registration / Rejected by 403(Forbidden)
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_IMS1 := IMS_PTC.create("IMS1") alive;
    v_IMS2 := IMS_PTC.create("IMS2") alive;
  
    f_MTC_IMS_CreateMapAndConnectPTCs_NR5GC(system, v_IMS1, v_IMS2);
  
    v_IMS1.start(f_TC_10_10_NR5GC_IMS1());
    v_IMS2.start(f_TC_10_10_NR5GC_IMS2());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_IMS(t_GuardTimer);
  }
