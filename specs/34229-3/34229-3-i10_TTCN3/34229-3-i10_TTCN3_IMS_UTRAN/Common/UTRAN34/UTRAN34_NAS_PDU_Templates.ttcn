module UTRAN34_NAS_PDU_Templates {

  import from NAS_24008Templates_AccessCap all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from UTRAN_TypeDefs all;

  template (present) RRCDataIndType cr_U34_AttachReq(template (present) AttachType p_AttachType,
                                                     template (present) MobileIdentity p_MobId := cr_MobileIdAny,
                                                     template (present) RoutingAreaId p_RAI := cr_RAI,
                                                     template (present) KeySeq p_KeySeq := ?,
                                                     template (present) MS_RadioAccessCap_LV p_MS_RadioAccessCap := cr_MS_RadioAccessCapLV_r99_Any) :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN)  */
    attachRequest := cr_AttachReq_Common(p_AttachType,
                                         p_MobId,
                                         p_RAI,
                                         p_KeySeq,
                                         p_MS_RadioAccessCap,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         -,
                                         cdr_MS_NetworkCapLV_r99_Any)
  };

  template (present) MS_NetworkCap cdr_MS_NetworkCapLV_r99_Any modifies cr_MS_NetworkCap_Any :=
  { /* 24.301 cl. 9.9.3.18 -> 24.008 cl. 10.5.5.12;
       @status    APPROVED (IMS, SSNITZ, UTRAN) */
    iei  := omit,                                   /* present in case of TV; omit in case of V */
    lcsVACap  := *,
    psHOtoUTRAN_IuModeCap  := *,
    psHOtoEUTRAN_S1ModeCap  := *,
    emmCombinedCap  := *,       // @sic R5s110176 Baseline Moving sic@
    isrSupport  := *,
    srvccToGERAN_UTRANCap  := *,
    epcCap  := *
  };

  template (present) MS_RadioAccessCap_LV cr_MS_RadioAccessCapLV_r99_Any :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    iel  := ?,
    valuePart := cr_MS_RadioAccessCapV_r99_Any  // @sic R5s110176 Baseline Moving sic@
  };

  template (present) MS_RadioAccessCap_V cr_MS_RadioAccessCapV_r99_Any :=
  { /* The 1st instance must be single access type, but after that everything is optional */
    /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    listofValues := (
      {cr_MSRadioAccessCapListSingle_r99, *}, {cr_MSRadioAccessCapListSingle_r99, cr_MSRadioAccessCapListSingle_r99, *},
      {cr_MSRadioAccessCapListSingle_r99, cr_MSRadioAccessCapListSingle_r99, cr_MSRadioAccessCapList_r99_Any, *},
      {cr_MSRadioAccessCapListSingle_r99, cr_MSRadioAccessCapList_r99_Any, *}),
    sparebits := *
  };

  template (present) MS_RadioAccessCapList cr_MSRadioAccessCapList_r99_Any := cr_MSRadioAccessCapList(cr_MSRadioAccessCapAny (cr_SingleAccessCap_r99));     /* @sic R5s150329 Baseline Moving sic@ @status    APPROVED (IMS, SSNITZ, UTRAN)    */

  template (present) MS_RadioAccessCapList cr_MSRadioAccessCapListSingle_r99 := cr_MSRadioAccessCapList(cr_MSRadioAccessCapSingle (cr_SingleAccessCap_r99));   /* @sic R5s150329 Baseline Moving sic@ @status    APPROVED (IMS, SSNITZ, UTRAN)     */

}
