      if ((ispresent(p_NrDlPrsProcessingCapabilityBandList[v_Index].maxNumOfDL_PRS_ResProcessedPerSlot_r16.scs120_r16)) and
          (p_NrDlPrsProcessingCapabilityBandList[v_Index].maxNumOfDL_PRS_ResProcessedPerSlot_r16.scs120_r16 == pc_maxNumOfDL_PRS_ResProcessedPerSlot_SCS120)) {
