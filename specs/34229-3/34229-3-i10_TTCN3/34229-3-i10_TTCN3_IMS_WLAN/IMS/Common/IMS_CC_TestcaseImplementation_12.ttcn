module IMS_CC_TestcaseImplementation_12 {

  import from CommonDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions4G all;
  import from IMS_CommonDefs all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_MessagesVideo all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      Common Test body of test case G.12.1
   * @param     p_TestProcedure
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MO_VoiceVideoCall_C21aC25a(IMS_TestProcedure_Type p_TestProcedure,
                                            IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(p_TestProcedure);
    
    // @siclog "Step 2 - 8" siclog@
    v_InviteRequest := f_IMS_MOCallSetup_AnnexC21aC25a(p_TestProcedure, p_AudioCodecList);
    
    f_IMS_CallReleaseMO(v_InviteRequest);
    
    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Wrap function for the inner steps on test cases G.12.4, G.12.2
   * @param     p_SdpOffer
   * @param     p_SdpAnswer
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_AnnexC11aC26a_MTCallRelease(template (value) SDP_Message p_SdpOffer,
                                                         template (present) SDP_Message p_SdpAnswer) runs on IMS_PTC
  {
    var IMS_CC_MT_SpeechCallInfo_Type v_SpeechCallInfo;

    // @siclog "Step 1-11 (WLAN)" siclog@
    v_SpeechCallInfo := f_IMS_MTCallSetup_AnnexC11aC26a(p_SdpOffer, p_SdpAnswer);

    f_Delay(3.0);      // !!!! Not in the prose !!!!

    // @siclog "Step 11-12 (WLAN)" siclog@
    f_IMS_CallReleaseMT(v_SpeechCallInfo.ContactUrl);
  }

  /*
   * @desc      Common Test body of test case G.12.2
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MT_VoiceCall_C11a(IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC
  {
    var template (value) SDP_Message v_SdpOffer := f_IMS_BuildSDP_InitialOfferAudio_TX(p_AudioCodecList);
    var IMS_SDP_AudioCodec_Type v_AudioCodecToBeSelected := p_AudioCodecList[0];
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_FinalAnswerAudio_RX(v_AudioCodecToBeSelected);

    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);
    f_IMS_MTCallSetup_AnnexC11aC26a_MTCallRelease(v_SdpOffer, v_SdpAnswer);

    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Common Test body of test case G.12.4
   * @status    APPROVED (IMS)
   */
  function f_IMS_MT_VideoCall_C26a() runs on IMS_PTC
  {
    var template (value) SDP_Message v_SdpOffer := f_IMS_BuildSDP_InitialOfferAudioVideo_TX();     /* @sic R5-213524, R5-213538, R5-213539, R5-213541: f_IMS_BuildSDP_MTCallAudioVideo_TX replaced by f_IMS_BuildSDP_InitialOfferAudioVideo_TX sic@ */
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_MTCallAudioVideo_RX(SetupVideoCall);
   
    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_VideoCall);
    f_IMS_MTCallSetup_AnnexC11aC26a_MTCallRelease(v_SdpOffer, v_SdpAnswer);

    f_IMS_TestBody_Set(false);
  }

}
