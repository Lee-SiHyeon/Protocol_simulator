module RRC_PEI_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_SecuritySteps all;
  import from NR_SysInfo_Templates all;

 template (value) RRCRelease_v1710_IEs cs_RRCRelease_v1710_IEs (template (omit) RRCRelease_v1710_IEs.noLastCellUpdate_r17 p_NoLastCellUpdate_r17 := omit) :=
  { /* @status    APPROVED (NR5GC) */
    noLastCellUpdate_r17  := p_NoLastCellUpdate_r17,
    nonCriticalExtension  := omit
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.1a.1
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_1_1_1a_1_NR5GC() runs on NR5GC_PTC
   { //Paging Early Indication with Subgrouping / RRC_IDLE / lastUsedCellOnly not configured / Subgroup ID selection

    f_NR5GC_Init(NR_2);

    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -88, -82);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell2, -82, -82);

    f_NR_CellInfo_SetSIB1_PEI(nr_Cell1);
    f_NR_CellInfo_SetSIB1_PEI(nr_Cell2, cs_SubgroupConfig_r17(2,1));

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_1a_1_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell2, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_1_1_1a_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_1a_1_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_NAS_GutiParameters_Type v_GutiParameters;
    var float v_Wait10s := 10.0;
    var NG_5G_S_TMSI v_NG_5G_S_TMSI;
    var NG_5G_S_TMSI v_NG_5G_S_TMSI_diff;
    var PCCH_Config v_PcchConfig;

    //@siclog "Step 1" siclog@
    //@sic R5-254145 sic@
    //The SS transmits the Paging message including an un-matched identity (incorrect ng-5G-S-TMSI) on the associated PO only.
    v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(nr_Cell1);
    v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);
    v_NG_5G_S_TMSI_diff := f_CreateNewS_TMSING_5G_S_TMSI(v_NG_5G_S_TMSI);
    v_PcchConfig := f_NR_GetSIB1_PcchConfig(nr_Cell1);
    f_NR_Paging(nr_Cell1,
                cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI_diff)),
                v_PcchConfig.defaultPagingCycle);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message within 10s?
    f_NR_CheckNoRRCSetupReq(nr_Cell1, v_Wait10s);

    //@siclog "Step 3" siclog@
    //The SS transmits a PEI and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell1, -,'11'B, 22 );

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    //@siclog "Step 5" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 6" siclog@
    //The UE transmit an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
    //@siclog "Step 7-10" siclog@
    //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //@siclog "Step 11" siclog@
    //The SS transmits an RRCRelease message.
    f_NR_RRCRelease(nr_Cell1);

    //@siclog "Step 12" siclog@
    //The SS adjusts the cell power levels according to row "T1" in table 8.1.1.1a.1.3.2-1/2.
    f_NR_SetCellPower (nr_Cell1, -88, -91);
    f_NR_SetCellPower (nr_Cell2, -82, -82);

    //@siclog "Step 13" siclog@
    //Wait for 34s for FR1 or 130s for FR2 so the UE can camp on NR Cell 2. (Note 1).  //@sic R5-256198 sic@
     if (f_NR_CellInfo_GetIsFR1(nr_Cell12))
    {
      f_Delay(34.0);
    }
    else
    {
      f_Delay(130.0);
    }


    //@siclog "Step 14" siclog@
    //The SS transmits a PEI and the Paging message including a matched identity on the associated PO only on NR Cell 1.
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell1, -,'11'B, 22 );

    //@siclog "Step 15" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message within 10s?
    f_NR_CheckNoRRCSetupReq (nr_Cell1, 10.0);

    //@siclog "Step 16" siclog@
    //The SS transmits a PEI and the Paging message including a matched identity on the associated PO only..
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell2, -,'11'B, 22 );

    //@siclog "Step 17" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell2, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 17");

    //@siclog "Step 18" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell2);

    //@siclog "Step 19" siclog@
    //The UE transmit an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell2,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);

    //@siclog "Step 20-23" siclog@
    //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell2, v_ReceivedMsg);
    }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.1a.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_1a_2_NR5GC() runs on NR5GC_PTC
  { //Paging Early Indication with Subgrouping / RRC_INACTIVE / lastUsedCellOnly configured

    f_NR5GC_Init(NR_2);

    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -88, -82);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell2, -82, -82);


    f_NR_CellInfo_SetSIB1_PEI(nr_Cell1);
    f_NR_CellInfo_SetSIB1_PEI(nr_Cell2, -, true_);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);

    f_NR5GC_Preamble(nr_Cell1, STATE_INACTIVE_2A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_1a_2_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell2, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_1_1_1a_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_1a_2_TestBody() runs on NR5GC_PTC
  { //@sic R5s250221 sic@
    var I_RNTI_Value v_FullI_RNTI_diff; //@sic R5-254147 sic@
    var PCCH_Config v_PcchConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;//@sic R5s250463 R5-256210 sic@
    var template (value) PDSCH_Config v_PDSCH_Config;//@sic R5s250463 R5-256210 sic@
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP_Cell2;//@sic R5s250463 R5-256210 sic@
    var template (omit) NR_BWP_DownlinkDedicated_PDSCH_Config_Type v_BWP_DownlinkDedicated_PDSCH_Config;//@sic R5s250463 R5-256210 sic@
    var integer v_SSB_IndexCell2;//@sic R5s250463 R5-256210 sic@
    var template (value) PUSCH_Config v_PUSCH_Config;//@sic RR5s250463 5-256210 sic@
    var template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type v_RadioLinkMonitoringConfig := f_NR_CellInfo_GetRadioLinkMonitoringConfig(nr_Cell2);//@sic R5s250463 R5-256210 sic@
    var CellIdentity v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var template (value) RRCRelease_v1610_IEs v_RRCRelease_v1610_IEs;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell2);
    var RNTI_Value_Type v_RNTI_Value_Type := f_NR_CellInfo_GetRNTI(nr_Cell2);
    timer t_Wait := 10.0;

    //@siclog "Step 1" siclog@
    //The SS transmits a PEI and the Paging message including an un-matched identity (incorrect ng-5G-S-TMSI) on the associated PO only.
    v_PcchConfig := f_NR_GetSIB1_PcchConfig(nr_Cell1);
    v_FullI_RNTI_diff := '0000000000000000000000000000000000000001'B;  //@sic R5-254147 sic@
    f_NR_Paging(nr_Cell1,
                cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_FullI_RNTI(v_FullI_RNTI_diff)),  //@sic R5-254147 sic@
                v_PcchConfig.defaultPagingCycle);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message by setting resumeIdentity to the stored shortI-RNTI value?
    t_Wait.start;
    alt {
      [] t_Wait.timeout
        {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
        }
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1)))
        {
           t_Wait.stop;
           f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
        }
        }

    //@siclog "Step 3" siclog@
    //The SS transmits a PEI and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell1, -,'11'B, 22, true);// @sic R5s250370 sic@

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message by setting resumeIdentity to the stored shortI-RNTI value?
    f_NR_RRC_ResumeRequest_Def(nr_Cell1, tsc_NR_ShortI_RNTI_Value1, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    //@siclog "Step 5" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell1);

    //@siclog "Step 6" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell1);

    //@siclog "Step 7" siclog@
    //The SS transmits an RRCRelease message including both fullI-RNTI and shortI-RNTI in suspendConfig.
    f_NR_RRC_InactiveDef(nr_Cell1, ResumeNoSecurity, -, -, -, -, -, -, nr_Cell2);  // @sic R5s250008 sic@

    //@siclog "Step 8" siclog@
    //The SS adjusts the cell power levels according to row "T1" in table 8.1.1.1a.2.3.2-1/2..
    f_NR_SetCellPower (nr_Cell1, -88, -91);
    f_NR_SetCellPower (nr_Cell2, -82, -82);
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell2);  // @sic R5s250008 sic@
    
    //@siclog "Step 9" siclog@
    //The UE transmits an RRCResumeRequest message.
    f_NR_RRC_ResumeRequest_Def(nr_Cell2, -, rna_Update);

    //@siclog "Step 10" siclog@ //@sic R5s250463 R5-256210 sic@
    //The SS transmits an RRCResume message.
    v_SSB_IndexCell2 := f_NR_CellInfo_GetSSB_Index(nr_Cell2);

    v_NR_DownlinkBWP_Cell2 := f_NR_CellInfo_GetDownlinkBWP(nr_Cell2, tsc_NR_BWP_Id);
    v_PDSCH_Config := v_NR_DownlinkBWP_Cell2.Pdsch.ConfigDedicated.R15;
    v_PDSCH_Config.tci_StatesToAddModList[0] := cs_38508_TCI_State(v_SSB_IndexCell2);
    v_PDSCH_Config.prb_BundlingType := cs_NR_Prb_OmitBundleSize;
    v_BWP_DownlinkDedicated_PDSCH_Config := {setup := v_PDSCH_Config};

    v_RadioLinkMonitoringConfig := cs_38508_RadioLinkMonitoringConfigDef(f_NR_CellInfo_GetSSB_Index(nr_Cell2));
    f_NR_CellInfo_SetRadioLinkMonitoringConfig(nr_Cell2, v_RadioLinkMonitoringConfig);

    v_CellGroupConfig := f_NR_GetSCGConfigResume(nr_Cell2);
    v_CellGroupConfig.spCellConfig.spCellConfigDedicated.initialDownlinkBWP := cs_BWP_DownlinkDedicated_Def(-, v_BWP_DownlinkDedicated_PDSCH_Config, -, v_RadioLinkMonitoringConfig); //@sic R5s241495 sic@
    
    v_PUSCH_Config := cs_38508_PUSCH_Config_FR1(cs_38508_DMRS_UplinkConfig(pos1), v_SSB_IndexCell2);
    v_CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.initialUplinkBWP.pusch_Config := {setup := v_PUSCH_Config};
    f_NR_SendRRCResume_Def(nr_Cell2, -, -, v_CellGroupConfig);

    //@siclog "Step 11" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell2);

    //@siclog "Step 12" siclog@
    //The SS transmits an RRCRelease message including both fullI-RNTI and shortI-RNTI in suspendConfig.
    f_NR_RRC_InactiveDef(nr_Cell2);

    //@siclog "Step 13" siclog@
    //The SS transmits a PEI and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell2, -,'11'B, 22, true); // @sic R5s250370 sic@

    //@siclog "Step 14" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message by setting resumeIdentity to the stored shortI-RNTI value?
    f_NR_RRC_ResumeRequest_Def(nr_Cell2, tsc_NR_ShortI_RNTI_Value1, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    //@siclog "Step 15" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell2);

    //@siclog "Step 16" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell2);

    //@siclog "Step 17" siclog@
    //The SS transmits an RRCRelease message including both fullI-RNTI and shortI-RNTI in suspendConfig. The RRCRelease message also includes the noLastCellUpdate-r17 set to True.
    v_RRCRelease_v1610_IEs := cs_RRCRelease_v1610_IEs(cs_RRCRelease_v1650_IEs(omit, cs_RRCRelease_v1710_IEs(true_)));
    v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell2);

    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell2, cs_TimingInfo_Now, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def,cs_38508_SuspendConfig(cs_RAN_NotificationAreaInfo_1Cell (v_CellIdentity, omit)),
     -,-,-,cs_RRCConnectionRelease_All_IEs_v1540(-, v_RRCRelease_v1610_IEs))));

    //@siclog "Steps 18-19" siclog@ //@sic R5-256210 sic@
    //Void

    f_NR_SS_RachProcedureConfig(nr_Cell2, cs_NR_RachProcedureConfig_RRCResume(v_NR_PhysicalParameters, v_RNTI_Value_Type, tsc_NR_Msg4GrantHO_Def));
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell2, tsc_NR_38508_NextHopChainingCount);

    //@siclog "Step 20" siclog@
    //The SS transmits a PEI with the bit corresponding for the subgroup the UE belongs to indicated as 0 and a Paging message including a matched identity (correct fullI-RNTI). //@sic R5-256210 sic@
    f_NR_Paging_Trigger_DCI_2_7(nr_Cell2, -,'10'B, 22, -, true); // @sic R5s250463 R5-256210 R5s260010 sic@


    //@siclog "Step 21" siclog@
    //The UE transmits an RRCResumeRequest message.
    f_NR_RRC_ResumeRequest_Def(nr_Cell2);

    //@siclog "Step 22" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell2);

    //@siclog "Step 23" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell2);

    }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.1a.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_1a_3_NR5GC() runs on NR5GC_PTC
  { //Paging Early Indication without Subgrouping / RRC_IDLE

    f_NR5GC_Init(NR_1);

    //SIB1 will not include subgroupsNumForUEID-r17 as indicated in Table 8.1.1.1a.3.3.3-3
    f_NR_CellInfo_SetSIB1_PEI_Config_r17(nr_Cell1, cs_SubgroupConfig_r17(-, omit)); // @sic R5s240280 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_1a_3_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_1_1_1a_3
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_1a_3_TestBody() runs on NR5GC_PTC
  { /* @sic  R5s240109 R5s240280 sic@ */
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;

    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    //@siclog "Step 3" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 4" siclog@
    //The UE transmit an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
    //@siclog "Step 5-8" siclog@
    //Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    }

}
