  /*
   * @desc      Get the default RadioBearer config to be sent in the Reconfiguration message for ENDC on DRB2
   * @param     p_NR_CellId
   * @return    template (value) NR_RadioBearer_Type
   * @status    APPROVED (ENDC)
   */
  function f_NR_GetRadioBearerConfig_FullAM_DRB2(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) NR_RadioBearer_Type
  {
    return f_NR_GetRadioBearerConfig_FullAM(p_NR_CellId, tsc_NR_DRB2);
  }

  /*
   * @desc      Get the default RadioBearer config to be sent in the Reconfiguration message for ENDC on DRB2 Split
   * @param     p_NR_CellId
   * @param     p_CellIdEUTRA
   * @return    template (value) NR_RadioBearer_Type
   * @status    APPROVED (ENDC)
   */
  function f_NR_GetRadioBearerConfig_FullAM_DRB2_Split(NR_CellId_Type p_NR_CellId,
                                                       EUTRA_CellId_Type p_CellIdEUTRA) runs on NR_BASE_PTC return template (value) NR_RadioBearer_Type
  {
    return f_NR_GetRadioBearerConfig_FullAM(p_NR_CellId, tsc_NR_DRB2, crs_RlcBearerRouting_Eutra(p_CellIdEUTRA));
  }

  /*
   * @desc      Transfer of capability info to/from EUTRA PTC during Preamble on EUTRA
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */
  function f_NR_ENDC_UECapabilityTransfer(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {
    var template (value) FreqBandList v_MRDC_FreqList;
    var octetstring v_OctetData;
    var bitstring v_ENDCCapability;
    var bitstring v_NRCapability;
    var UE_NR_Capability v_NR_Cap;
    var UE_MRDC_Capability v_MRDC_Cap;
    var integer v_Result;
    var integer v_EUTRABandInd;
    var integer v_NRBandInd;
    var integer v_NR_SecondaryBand;
    var BandCombinationList v_BandCombinationList;
    var FreqBandList v_FreqBandList;
    var integer i;
    var integer j;
    var boolean v_MatchedNRBand := false;
    var boolean v_MatchedNRBandMRDC := false;
    var NR_CA_BandCombination_Type v_NR_CA_BandCombination;
    var boolean v_CA_InterBand := false;
    var boolean v_MatchedPrimaryBand := false;
    var boolean v_MatchedSecondaryBand := false;
    
    if (p_NR_CellId == nr_Cell_NonSpecific) { // For UPIP tests only on EUTRA
      v_NRBandInd := f_ENDC_GetNR_Band(px_ENDC_BandCombination);
    } else {
      v_NRBandInd := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);
    }
    
    // Have to receive EUTRA band first
    v_OctetData := f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "EUTRA Band");
    v_EUTRABandInd := oct2int(v_OctetData);
    
    //Set NR bands as per 38.508-1 Table 4.6.4-21: FreqBandList
    v_MRDC_FreqList := cs_NR_MRDC_FreqList(v_EUTRABandInd, v_NRBandInd);  // @sic R5204397 sic@
    if (f_GetTestcaseAttrib_NR_CA(testcasename())) {    //@sic R5s200624 R5-202575 sic@
       v_NR_CA_BandCombination := f_ENDCCA_GetNR_CABand ( px_ENDC_CA_BandCombination );
       if (f_NR_GetCA_CombinationType(v_NR_CA_BandCombination) == CA_InterBand) {
          //For CA interBand includes 2 entries as per 38.508-1 Table 4.6.4-21: FreqBandList
          v_CA_InterBand := true;       // @sic R5-204397 sic@
          v_NR_SecondaryBand := f_NR_GetCA_SecondaryBand(v_NR_CA_BandCombination);
          v_MRDC_FreqList := cs_NR_MRDC_FreqList_2NR(v_EUTRABandInd, v_NRBandInd, v_NR_SecondaryBand);
       }
    }
    
    // Then send all bands under test back to EUTRA
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (bit2oct(encvalue(v_MRDC_FreqList)), "MRDC_Freq"));
    // Finally receive both NR and MRDC capabilities
    v_NRCapability := oct2bit(f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "NRCap"));
    v_ENDCCapability := oct2bit(f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "ENDCCap"));
    
    // Check NR Capability
    v_Result := decvalue(v_NRCapability, v_NR_Cap);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "Decoding error");
    }
    f_NR_MobileInfo_NRCap_Set (v_NR_Cap);
    
    f_NR_CheckReleaseIndicator (v_NR_Cap.accessStratumRelease);
    for (i := 0; i < lengthof(v_NR_Cap.rf_Parameters.supportedBandListNR); i := i+1) { // @sic R5-190783 sic@
      if (match(v_NR_Cap.rf_Parameters.supportedBandListNR[i].bandNR, v_NRBandInd)) { // @sic R5s190400 sic@
        v_MatchedNRBand := true;
        break;
      }
    }
    if ( not v_MatchedNRBand) { // @sic R5s190400 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must match value sent");
    }
    
    v_FreqBandList := v_NR_Cap.rf_Parameters.appliedFreqBandListFilter;
    if (ischosen(v_FreqBandList[0].bandInformationEUTRA)) {
      if (not match (v_FreqBandList[0].bandInformationEUTRA.bandEUTRA, v_EUTRABandInd)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must match value sent");
      }
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must be sent first");
    }
    if (ischosen(v_FreqBandList[1].bandInformationNR)) {
      if (not match (v_FreqBandList[1].bandInformationNR.bandNR, v_NRBandInd)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must match value sent");
      }
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must be sent second");
    }
    // @sic R5s201453 sic@
    // Check MRDC Capability
    v_Result := decvalue(v_ENDCCapability, v_MRDC_Cap);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "Decoding error");
    }
    f_NR_MobileInfo_MRDCCap_Set(v_MRDC_Cap);
    v_BandCombinationList := v_MRDC_Cap.rf_ParametersMRDC.supportedBandCombinationList;
    if (ischosen(v_BandCombinationList[0].bandList[0].eutra)) {
      if (not match(v_BandCombinationList[0].bandList[0].eutra.bandEUTRA, v_EUTRABandInd)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must match value sent");
      }
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must be sent first");
    }
    if (not v_CA_InterBand) {   // @sic R5s201453 sic@
        for (i := 0; i < lengthof(v_BandCombinationList[0].bandList); i := i+1) { // @sic R5s191058 sic@
            if (ischosen(v_BandCombinationList[0].bandList[i].nr)) {
                if (match(v_BandCombinationList[0].bandList[i].nr.bandNR, v_NRBandInd)) {
                    v_MatchedNRBandMRDC := true;
                    break;
                }
            }
        }
    } else { //Check EN-DC BandCombination with InterBand CA  @sic R5s201453 sic@
        for (i := 0; i < lengthof(v_BandCombinationList); i := i+1) {
            v_MatchedPrimaryBand := false;
            v_MatchedSecondaryBand := false;
            for (j := 0; j < lengthof(v_BandCombinationList[i].bandList); j := j+1) {
                if (ischosen(v_BandCombinationList[i].bandList[j].nr)) {
                    if (match(v_BandCombinationList[i].bandList[j].nr.bandNR, v_NRBandInd)) {  //primary band matched
                        v_MatchedPrimaryBand := true;
                    }
                    if (match(v_BandCombinationList[i].bandList[j].nr.bandNR, v_NR_SecondaryBand)) {//sescondary band matched
                        v_MatchedSecondaryBand := true;
                    }
                    if (v_MatchedPrimaryBand and v_MatchedSecondaryBand) {
                        v_MatchedNRBandMRDC := true;
                        break;
                    }
                }
            }
        }
    }
    if (not v_MatchedNRBandMRDC) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must be sent in the bandList together with the LTE band");
    }
    v_FreqBandList := v_MRDC_Cap.rf_ParametersMRDC.appliedFreqBandListFilter;
    if (ischosen(v_FreqBandList[0].bandInformationEUTRA)) {
      if (not match (v_FreqBandList[0].bandInformationEUTRA.bandEUTRA, v_EUTRABandInd)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must match value sent");
      }
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Eutra Freq Band Ind must be sent first");
    }
    if (ischosen(v_FreqBandList[1].bandInformationNR)) {
      if (not match (v_FreqBandList[1].bandInformationNR.bandNR, v_NRBandInd)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must match value sent");
      }
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must be sent second");
    }
  }

  /*
   * @desc      To get the keys from EUTRA and enable NR security
   * @param     p_NR_CellId
   * @param     p_Port
   * @status    APPROVED (ENDC)
   */
  function f_ENDC_GetKeysActivateSecurity_KeNB(NR_CellId_Type p_NR_CellId,
                                               EUTRA_NR_CO_ORD_PORT p_Port) runs on NR_BASE_PTC
  {
    var EUTRA_NR_CoOrd_Security_Type v_SecurityRx;
    var NR_SecurityParams_Type v_SecurityParams;
    
    v_SecurityParams := f_NR_Security_Get ();
    // get security from EUTRA
    v_SecurityRx := f_EUTRA_NR_WaitForCoOrd_Security (p_Port);
    v_SecurityParams.SK_Counter := v_SecurityRx.SK_Counter;
    v_SecurityParams.S_KGNB := v_SecurityRx.Key;  //contains KeNB
    
    // get latest security keys
    v_SecurityParams := f_NR_InitAS_KeyChaining_KeNB (v_SecurityParams);
    // Make sure all keys are updated @sic R5w220012 sic@
    v_SecurityParams.AS_Ciphering := v_SecurityParams.AS_Ciphering_S;
    v_SecurityParams.AS_Integrity := v_SecurityParams.AS_Integrity_S;
    f_NR_Security_Set(v_SecurityParams);
    
    // Configure PDCP security
    v_SecurityParams.AS_Ciphering.ActTimeList := f_NR_RRC_CipherActTime_GetCurrent(p_NR_CellId, false); // @sic R5s210277 sic@
    f_NR_SS_RRC_EnableIntProt_CiphULandDL(p_NR_CellId,
                                          v_SecurityParams.AS_Integrity,  // @sic R5s220548 sic@
                                          v_SecurityParams.AS_Ciphering); // @sic R5s220548 sic@
                                          
  }

  /*
   * @desc      Transfer of data to/from EUTRA PTC during Preamble on EUTRA and
   *            configuration of MCG_Only/MCG_SCG/MCG_Split
   * @param     p_NR_CellId
   * @param     p_BearerType
   * @param     p_EUTRACellId       (default value: eutra_Cell_NonSpecific)
   * @param     p_SecondaryConfig   (default value: NONE)
   * @status    APPROVED (ENDC)
   */
  function f_NR_ENDC_PreambleOnEUTRA(NR_CellId_Type p_NR_CellId,
                                     ENDC_Bearer_Type p_BearerType,
                                     EUTRA_CellId_Type p_EUTRACellId := eutra_Cell_NonSpecific,
                                     ENDC_SRB_DRB_Configuration_Type p_SecondaryConfig := NONE) runs on ENDC_NR_PTC
  {
    var octetstring v_OctetData;
    var integer v_MCG_Id;
    var NR_SecurityParams_Type v_SecurityParams;
    var template (value) NR_RadioBearerList_Type v_RadioBearerList;
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (omit) RadioBearerConfig v_RadioBearerConfig2 := omit; // @sic R5s190112 sic@
    var template (value) DRB_ToAddModList v_DRB_ToAddModList;
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    var template (value) SRB_ToAddModList v_SRB_ToAddModList_SRB3 := {
      cs_NR_SRB_ToAddMod(tsc_SRB3)
    };
    
    f_NR_ENDC_UECapabilityTransfer (p_NR_CellId);
    
    //Start UL grant in NR cell
    f_NR_ULGrantConfiguration_Start(p_NR_CellId);
    
    // EUTRA preamble now in progress, so can turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    select (p_BearerType) {
      case (MCG_SCG){
        // Configure DRB2
        f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, {f_NR_GetRadioBearerConfig_FullAM_DRB2(p_NR_CellId)});
        select (p_SecondaryConfig) { // Prose currently only specifies secondary config with MCG_SCG
          case (NR_PDCP_MCG) {
            // get the DRB id for MCG
            v_OctetData := f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "DRB ID");
            v_MCG_Id := oct2int(v_OctetData);
            v_DRB_ToAddModList := {
              cs_38508_DRB_ToAddMod(v_MCG_Id, cs_38508_PDCP_Config),
              cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config)
            };
            // then configure it
            v_RadioBearerList := { cs_NR_SS_DRB_Config(v_MCG_Id, cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsDRB, crs_RlcBearerRouting_Eutra(p_EUTRACellId)), cs_NR_RlcBearerConfig_None) };
            f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_RadioBearerList);
            // Configure NR PDCP on NR
            v_RadioBearerConfig := cs_38508_RadioBearerConfigDef(-,
                                                                 v_DRB_ToAddModList,
                                                                 -,
                                                                 cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig(f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), secondary));
            v_SCGConfig := f_NR_GetSCGConfigDef(p_NR_CellId);
          }
          case (SRB3) {
            v_DRB_ToAddModList := {
              cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config)
            };
            v_RadioBearerConfig := cs_38508_RadioBearerConfigDef(v_SRB_ToAddModList_SRB3,
                                                                 v_DRB_ToAddModList,
                                                                 -,
                                                                 cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig(f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), secondary));
            v_SCGConfig := f_NR_GetSCGConfigDef(p_NR_CellId);
            // add another entry for RLC of SRB3
            v_SCGConfig.rlc_BearerToAddModList[1]:= cs_38508_RLC_BearerConfig_SRB(tsc_SRB3);
            // Configure SRB3 in SS
            v_RadioBearerList := { cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB3, cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsSRB)) };
            f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_RadioBearerList);
            // Activate security for this bearer  @sic R5s190414 sic@
            v_SecurityParams := f_NR_Security_Get ();
            v_SecurityParams.AS_Ciphering.ActTimeList := f_NR_RRC_CipherActTime_GetCurrent(p_NR_CellId, false); // @sic R5s210277 sic@
            f_NR_SS_RRC_EnableIntProt_CiphULandDL(p_NR_CellId,
                                                  v_SecurityParams.AS_Integrity,
                                                  v_SecurityParams.AS_Ciphering);
          }
          case (NONE) {
            v_RadioBearerConfig := cs_NR_RadioBearer(2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()); // @sic R5s190188 sic@
            v_SCGConfig := f_NR_GetSCGConfigDef(p_NR_CellId);
          }
        }
        f_NR_SendRRCReconfigurationContentsToEUTRA(v_RadioBearerConfig, v_SCGConfig, omit, v_RadioBearerConfig2, false, reconfigurationWithSync_CheckRACH); //@sic R5s190541, R5s200158 sic@
        // Get Security info from EUTRA, calculate latest keys and configure SS
        f_ENDC_GetKeysActivateSecurity(p_NR_CellId, EUTRA); // @sic R5s190414, R5s190909, R5s200045, R5s200158 sic@
        // (Wait for and) handle coordination message: @sic R5s200158 sic@
        EUTRA.receive(cmr_EUTRA_NR_OctetData( "Complete")) -> value v_ReceivedMsg;
        f_NR_CheckReceived_RRCReconfigurationComplete(v_ReceivedMsg);
      }
      case (MCG_Split){
        f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, {f_NR_GetRadioBearerConfig_FullAM_DRB2_Split(p_NR_CellId, p_EUTRACellId)});
        v_RadioBearerConfig := cs_NR_SplitBearer(tsc_NR_DRB2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()); // @sic R5s190188 sic@
        v_SCGConfig := f_NR_GetSCGConfigDef(p_NR_CellId);
        f_NR_SendRRCReconfigurationContentsToEUTRA (v_RadioBearerConfig, v_SCGConfig, -, -, false, reconfigurationWithSync_CheckRACH);  //@sic R5s190541, R5s200158 sic@
        // Get Security info from EUTRA, calculate latest keys and configure SS
        f_ENDC_GetKeysActivateSecurity(p_NR_CellId, EUTRA); // @sic R5s190414, R5s190909, R5s200045, R5s200158 sic@
        // (Wait for and) handle coordination message: @sic R5s200158 sic@
        EUTRA.receive(cmr_EUTRA_NR_OctetData( "Complete")) -> value v_ReceivedMsg;
        f_NR_CheckReceived_RRCReconfigurationComplete(v_ReceivedMsg);
      }
      case else {// do nothing @sic R5s200647 sic@
      }
    }
  }

  /*
   * @desc      To be used to configure DRB(n,m) AM, UM bearers (mainly for L2 tests)
   *            (also allows SRBs to be configured)
   *            PLEASE NOTE: If ANY of the RRC contents is specified, then the SS MUST BE specified too
   * @param     p_NR_CellId
   * @param     p_NoOfNR_AMBearersN
   * @param     p_NoOfNR_UMBearersM
   * @param     p_SS_Drb_ConfigList (default value: omit)
   * @param     p_RLC_BearerConfigList (default value: omit)
   * @param     p_SRB_ToAddModList  (default value: omit)
   * @param     p_DRB_ToAddModList  (default value: omit)
   * @param     p_SecurityConfig    (default value: omit)
   * @param     p_MAC_CellGroupConfig (default value: omit)
   * @param     p_NrofHARQ_ProcessesForPDSCH (default value: omit)
   * @status    APPROVED (ENDC)
   */
  function f_NR_ENDC_ConfigAM_UM(NR_CellId_Type p_NR_CellId,
                                 integer p_NoOfNR_AMBearersN,
                                 integer p_NoOfNR_UMBearersM,
                                 template (omit) NR_RadioBearerList_Type p_SS_Drb_ConfigList := omit,
                                 template (omit) NR_RLC_BearerToAddModList_Type p_RLC_BearerConfigList := omit,
                                 template (omit) SRB_ToAddModList p_SRB_ToAddModList := omit,
                                 template (omit) DRB_ToAddModList p_DRB_ToAddModList := omit,
                                 template (omit) SecurityConfig p_SecurityConfig := omit,
                                 template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig := omit,
                                 template (omit) PDSCH_ServingCellConfig.nrofHARQ_ProcessesForPDSCH  p_NrofHARQ_ProcessesForPDSCH := omit
                                 ) runs on NR_BASE_PTC
  {
    // @sic R5s200647 sic@
    // @sic R5-203533: added p_NrofHARQ_ProcessesForPDSCH sic@
    f_NR_ENDC_ReConfigAM_UM(p_NR_CellId,
                            p_NoOfNR_AMBearersN,
                            p_NoOfNR_UMBearersM,
                            p_SS_Drb_ConfigList,
                            p_RLC_BearerConfigList,
                            p_SRB_ToAddModList,
                            p_DRB_ToAddModList,
                            p_SecurityConfig,
                            p_MAC_CellGroupConfig,
                            -,
                            p_NrofHARQ_ProcessesForPDSCH);
  }

  /*
   * @desc      Send SysInfo parameters (Frequency and Physical Cell Id) to EUTRA PTC
   * @param     p_CellList
   * @status    APPROVED (ENDC)
   */
  function f_NR_SendCoOrdSysInfoToEUTRA (NR_CellIdList_Type p_CellList) runs on ENDC_NR_PTC
  {
    var integer i;
    var template (value) CoOrd_NRSysInfo_List_Type v_NRSysInfoList;
    var template (value) CoOrd_NRSysInfo_Type v_CoOrd_SysInfoNR;
    
    for (i:=0; i<lengthof(p_CellList); i:=i+1) {
      v_CoOrd_SysInfoNR := cs_CoOrd_SysInfoNR(f_NR_CellInfo_GetFrequencySSB (p_CellList[i]),
                                              f_NR_CellInfo_GetPhysicalCellId (p_CellList[i]),
                                              f_NR_ConvertSCSToInt(f_NR_CellInfo_GetSSB_SCS (p_CellList[i])),
                                              f_NR_CellInfo_GetIsFDD(p_CellList[i]),
                                              f_NR_CellInfo_GetIsFR1(p_CellList[i]),
                                              f_NR_CellInfo_GetBandIndicator(p_CellList[i]),
                                              f_NR_CellInfo_GetChannelBandwidth(p_CellList[i])  //@sic R5-254995 sic@
                                              );
      v_NRSysInfoList[i] := v_CoOrd_SysInfoNR;
    }
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_SysInfoNR(v_NRSysInfoList));
  }

  /*
   * @desc      Send Delta values to EUTRA PTC
   * @status    APPROVED (ENDC)
   */
  function f_NR_SendCoOrdDeltaValuesToEUTRA () runs on ENDC_NR_PTC
  {
    var UE_NR_DeltaValues_Type v_DeltaValues := f_NR_MobileInfo_GetDeltaValues();
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_DeltaValuesNR(v_DeltaValues));
  }

  /*
   * @desc      Receive the contents of ULInformationTransferMRDC from EUTRA
   * @return    UL_DCCH_MessageType
   * @status    APPROVED (ENDC)
   */
  function f_NR_ReceiveUlDcchMessageFromEUTRA() runs on ENDC_NR_PTC return UL_DCCH_MessageType
  {
    //@sic R5-203405 sic@
    var octetstring v_OctetData;
    var integer v_Result;
    var bitstring v_ULInfoMRDC;
    var UL_DCCH_Message v_UlDcchMessage;
    
    v_OctetData := f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "ULInfoTransferMRDC");
    v_ULInfoMRDC := oct2bit(v_OctetData);
    v_Result := decvalue(v_ULInfoMRDC, v_UlDcchMessage);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "Decoding error");
    }
    return v_UlDcchMessage.message_;
  }

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_NR_CellId
   * @param     p_PdnIndex
   * @param     p_BearerType
   * @param     p_DRBId
   * @param     p_RlcRoutingDL
   * @param     p_RlcRoutingUL      (default value: omit)
   * @param     p_StepNo            (default value: "")
   * @param     p_SequenceNumber    (default value: 1)
   * @param     p_MacBearerRoutingCA_DL (default value: omit)
   * @param     p_MacBearerRoutingCA_UL (default value: omit)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC)
   */
  function f_NR_CheckDataPath(NR_CellId_Type p_NR_CellId,
                              PDN_Index_Type p_PdnIndex,
                              DataPathCheck_BearerType_Type p_BearerType,
                              DRB_Identity p_DRBId,
                              template (value) RlcBearerRouting_Type p_RlcRoutingDL,
                              template (omit) RlcBearerRouting_Type p_RlcRoutingUL := omit,
                              charstring p_StepNo := "",
                              integer p_SequenceNumber := 1,
                              template (omit)  MacBearerRouting_Type p_MacBearerRoutingCA_DL := omit,
                              template (omit)  MacBearerRouting_Type p_MacBearerRoutingCA_UL := omit,
                              template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now
                              ) runs on NR_BASE_PTC
  { /* implementation as according to @sic R5s190117 R5s190161 sic@ */
    /* @sic R5-193981, R5-193983: p_PdnIndex, p_BearerType sic@ */
    /* Rs190936: split into 2 functions */
    /* @sic R5-203666: added p_UL_Cell for ENDC CA test cases sic@ */
    /* @sic R5-213516: added p_MacBearerRoutingCA_DL and p_MacBearerRoutingCA_UL deleted p_UL_Cell sic@ */
    /* @sic R5-250087: added p_TimingInfo sic@ */
    var octetstring v_SduTX := f_LoopbackModeBorPing_GetDataTX(p_PdnIndex, p_BearerType, p_SequenceNumber);
    var NR_PDCP_SDUList_Type v_PDCP_Data := { v_SduTX };
    var template (value) NR_DRB_COMMON_REQ v_DRB_DL;
    var template (present) NR_DRB_COMMON_IND v_DRB_UL;
    var template (value) RlcBearerRouting_Type v_RlcRoutingUL;
   
    if (isvalue(p_RlcRoutingUL)) {
      v_RlcRoutingUL := valueof(p_RlcRoutingUL);
    } else {
      v_RlcRoutingUL := p_RlcRoutingDL;
    }
   
    v_DRB_DL := cas_NR_DRB_COMMON_REQ_PDCP_SDUList_DC(p_NR_CellId, p_DRBId, p_RlcRoutingDL, p_TimingInfo, v_PDCP_Data, p_MacBearerRoutingCA_DL);
    v_DRB_UL := car_NR_DRB_COMMON_IND_PDCP_SDUList_DC(p_NR_CellId, p_DRBId, v_RlcRoutingUL, -, -, p_MacBearerRoutingCA_UL);

    f_NR_CheckDataPathCommon(v_SduTX, v_DRB_DL, v_DRB_UL, p_StepNo);
  }

  /*
   * @desc      Send MeasConfig and SCGConfig to EUTRA PTC to encode into RRC Configuration Reconfiguration message
   *            and check Reconfiguration Complete sent back
   * @param     p_MeasConfig
   * @param     p_MeasObjectId_SCell (default value: omit)
   * @param     p_MeasObjectId_SpCell (default value: tsc_NR_MeasObjectId1)
   * @status    APPROVED (ENDC)
   */
  function f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(template (omit) MeasConfig p_MeasConfig,
                                                           template (omit) MeasObjectId p_MeasObjectId_SCell := omit,
                                                           template (value) MeasObjectId p_MeasObjectId_SpCell := tsc_NR_MeasObjectId1
                                                           ) runs on NR_BASE_PTC
  {
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (omit) SCellConfig v_SCellConfig := omit;
      
    v_CellGroupConfig := cs_NR_CellGroupConfigMeas(tsc_NR_CellGroupId_SCG,  //@sic R5s200612 sic@
                                                   cs_NR_SpCellConfigDef(tsc_NR_CellGroupId_SCG,
                                                                       -,
                                                                       -,
                                                                       cs_NR_ServingCellConfigMeas(p_MeasObjectId_SpCell)));
      
    if(isvalue(p_MeasObjectId_SCell))
    {//@sic R5-202653 sic@
        v_SCellConfig := cs_SCellConfig_Def(omit,cs_NR_ServingCellConfigMeas(p_MeasObjectId_SCell), tsc_NR_SCellIndex_2);  //warning can be ignored due to isvalue check
        v_CellGroupConfig.sCellToAddModList := {v_SCellConfig};
    }

    f_NR_SendRRCReconfigurationContentsToEUTRA(omit, v_CellGroupConfig, p_MeasConfig);  //@sic R5-198871, R5-202651, R5s200612 sic@
  }

  /*
   * @desc      Function to change cell power after receiving a trigger from EUTRA
   * @param     p_CellPowerList
   * @param     p_Command           (default value: "ChangePower")
   * @status    APPROVED (ENDC)
   */
   function f_NR_WaitForEUTRATrigger_And_ChangePower  (template (value) NR_CellPowerList_Type p_CellPowerList,
                                                charstring p_Command := "ChangePower") runs on  ENDC_NR_PTC
   {
    //Wait for coordination trigger and change the power
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, p_Command);
    f_NR_SetCellPowerList(p_CellPowerList);
   };

  /*
   * @desc      Function to change cell power, receive measurement reports from EUTRA
   * @param     p_CellPowerList
   * @param     p_Expected_MeasResults
   * @param     p_TestStep          (default value: "")
   * @param     p_NumReportsToReceive (default value: 1)
   * @status    APPROVED (ENDC)
   */
   function f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(template (value) NR_CellPowerList_Type p_CellPowerList,
                                                template (present) MeasResults p_Expected_MeasResults,
                                                charstring p_TestStep := "",
                                                integer p_NumReportsToReceive := 1) runs on  ENDC_NR_PTC
   {
    var integer v_CounterReceivedReports := 0;

    //Wait for coordination trigger and change the power
    f_NR_WaitForEUTRATrigger_And_ChangePower(p_CellPowerList);
    
    //Receive expected amount of correct measurement reports
    while (v_CounterReceivedReports < p_NumReportsToReceive)
    {
      f_NR_ReceiveFromEUTRA_AndCheckMeasReport(p_TestStep, p_Expected_MeasResults); //@sic R5-198931 sic@ function optimisation
      v_CounterReceivedReports := v_CounterReceivedReports +1;
    }
   };

   /*
   * @desc      Function to receive measurement reports from EUTRA and validate them
   * @param     p_TestStepString
   * @param     p_ExpectedMeasResults
   * @status    APPROVED (ENDC)
   */
  function f_NR_ReceiveFromEUTRA_AndCheckMeasReport(charstring p_TestStepString,
                                           template (present) MeasResults p_ExpectedMeasResults) runs on  ENDC_NR_PTC
  {
    var UL_DCCH_MessageType v_MeasurementReport := f_NR_ReceiveUlDcchMessageFromEUTRA(); //@sic R5-203405 sic@
    var MeasResults v_ReceivedMeasResults := v_MeasurementReport.c1.measurementReport.criticalExtensions.measurementReport.measResults;

    if (match(v_ReceivedMeasResults, p_ExpectedMeasResults)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, p_TestStepString);
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_TestStepString & " - wrong meas results");
    }
  }

}
