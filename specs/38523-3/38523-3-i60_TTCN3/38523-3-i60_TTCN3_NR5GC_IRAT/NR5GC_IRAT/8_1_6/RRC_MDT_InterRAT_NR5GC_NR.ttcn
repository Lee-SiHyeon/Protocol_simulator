module RRC_MDT_InterRAT_NR5GC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_NR_Parameters all;
  import from IP_PTC_CtrlMsgs all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_IRAT_CommonFunctions all;
  import from NR5GC_MDT_Specific_Templates all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR5GC_UE_Location all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Functions all;
  import from NR_Measurement_Templates all;
  import from NR_RRC_Templates all;
  import from NR_SecuritySteps all;

  template (present) MeasResult2EUTRA_r16 cr_MeasResult2EUTRA_r16 ( ARFCN_ValueEUTRA                         p_NR_ARFCN,
                                                                   template (present) MeasResultListEUTRA   p_MeasResultList_r16
                                                                    ) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    carrierFreq_r16                 :=   p_NR_ARFCN,
    measResultList_r16              :=   p_MeasResultList_r16
  };

  template (present) NR_RLF_Report_measResultNeighCells cr_NR_RLF_Report_measResultNeighCells_Eutra_r16 (template(present) MeasResultList2EUTRA_r16 p_MeasResultListEUTRA_r16)  :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    measResultListNR_r16 := omit,
    measResultListEUTRA_r16 := p_MeasResultListEUTRA_r16
  };

  template (present) MeasResultList2EUTRA_r16 cr_MeasResultNeighCellListEUTRA_1Entry (ARFCN_ValueEUTRA p_CarrierFreq_r16,
                                                                           PhysCellId p_PhysCellId,
                                                                           template(present) MeasQuantityResultsEUTRA p_MeasResult)  :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    {
    carrierFreq_r16        := p_CarrierFreq_r16,
    measResultList_r16     := {
        {
            eutra_PhysCellId := p_PhysCellId,
            measResult := p_MeasResult,
            cgi_Info   := omit
        }
      }
     }
   };

  template (value) PeriodicalReportConfigInterRAT cs_NR_ReportConfigInterRAT_Trigger_periodical_EUTRA(integer p_MaxReportCells,
                                                                                                      PeriodicalReportConfigInterRAT.includeCommonLocationInfo_r16 p_IncludeCommonLocationInfo_r16) :=
    /* @status    APPROVED (NR5GC_IRAT) */
    /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    cs_NR_ReportConfigInterRAT_Trigger_Periodical_Def(p_MaxReportCells, omit, p_IncludeCommonLocationInfo_r16);

  /*
   * @desc      Returns MeasQuantityResultsEUTRA depending on setting of pc_ss_SINR_Meas
   * @return    template (present) MeasQuantityResultsEUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
   function f_EUTRA_Get_MeasQuantityResults() return template (present) MeasQuantityResultsEUTRA
    {
        if(pc_ss_SINR_Meas)
        {
            return cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq_Sinr;
        }
        else
        {
            return cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq;
        }
    };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_1_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT MDT / Immediate MDT / Periodic Reporting of E-UTRAN / Location Information
  
    f_NR5GC_IRAT_Init(NR_6);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -78, -82); //@sic R5-216497 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    
    //The UE's positioning engine (e.g. standalone GNSS receiver) should be provided with any necessary stimulus to allow it to provide the position.
    //This shall be done by use of the test function Update UE Location Information defined in TS 38.509 [6], if supported by the UE according to pc_UpdateUE_LocationInformation.
    //Otherwise, or in addition any other suitable method may also be used
    f_NR_ProvideUE_LocationInformation(nr_Cell1, RRC_CONNECTED);
    
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    f_TC_8_1_6_2_1_TestBody();
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
      
  }// End of f_TC_8_1_6_2_1_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.6.2.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_1_TestBody() runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0_T1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T1_FR1 := -78;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T1_FR2 := -82; //@sic R5-220050, R5-216497 sic@
    var PhysCellId v_PhysCellId;
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_MeasurementBandwidth_int;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var integer v_MaxReportCells := 1;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (omit) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (present) MeasResults.measResultNeighCells v_MeasResultNeighCells;
    var template (present) MeasResults v_MeasResults;
    var template (value) OtherConfig_v1610 v_OtherConfig_v1610; //@sic R5-231197 sic@
         
      
    //Power levels of NR cell 1: Table 8.1.6.2.1.3.2-1, Table 8.1.6.2.1.3.2-2
    /*         |    FR1     |    FR2
     * -------------------------------
     *   T0    |    -78     |    -82
     * -------------------------------
     *   T1    |    -78     |    -82
     *
     */
    
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth_int := v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth;
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_MeasurementBandwidth_int);

    v_CellPowerList_AtT0_T1 := {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_T1_FR1, v_CellPower_T0_T1_FR2)}; //@sic R5-216497 sic@
    
    f_NR_SetCellPowerList(v_CellPowerList_AtT0_T1);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT measurement and reporting for E-UTRA cell with includeLocationInfo
    //The UE transmits an RRCReconfigrationComplete message
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT_Periodical(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_periodical_EUTRA(v_MaxReportCells, true_))}; //@sic R5s211526 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
      
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA);
      
    //f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); // @sic R5-224131, R5s220792 sic@
    
    //@siclog "Step  3" siclog@
    //The SS changes E-UTRA Cell 1 parameters according to row "T1" in Table 8.1.6.2.1.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    
    v_OtherConfig_v1610 := cs_OtherConfig_v1610; //@sic R5-231197 sic@
    v_OtherConfig_v1610.obtainCommonLocation_r16 := true_; //@sic R5-231197 sic@
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1, v_MeasConfig,-,-,-,-,-,-,v_OtherConfig_v1610); //@sic R5-231197, R5-224131, R5s220792 sic@
   
    //@siclog "Steps  4" siclog@
    // Wait and ignore MeasurementReport messages for 8 s to allow for trhe switching of cells and UE Measuremnet.
    f_NR_IgnorePeriodicalMeasurmentReport(8.0);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message on NR Cell 1 to perform periodical reporting for E-UTRA Cell 1 with locationInfo?
    v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_MeasResultNeighCells := cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)}); //@sic R5-216497 sic@
    v_MeasResults := cdr_38508_MeasResults_LocationInfo(-, v_PhysCellId, v_MeasResultNeighCells, -, -, ?, *, ?, *, *, ?); //@sic R5-235427, R5s230455, R5-224131, R5s220792 sic@
    f_NR_ReceivePeriodicalMeasurementReports(nr_Cell1, 30.0, 10, cr_NR_MeasurementReport(v_MeasResults));
    
    v_MeasConfig := cs_NR_MeasConfigRemove(cs_MeasObjectToRemoveList_2Entry(tsc_NR_MeasObjectId1, tsc_NR_MeasObjectId2), {tsc_NR_MeasId1}); //@sic R5-224131, R5s220792 sic@
    //@siclog "Step 6" siclog@
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig); //@sic R5-224131, R5s220792 sic@
   
    //@siclog "Step 7" siclog@
    // Wait and ignore MeasurementReport messages for 5 s to allow change of power levels for NR Cell 1.
    f_NR_IgnorePeriodicalMeasurmentReport(8.0);   //@sic R5-224131, R5s220792 sic@

    
  }//End of f_TC_8_1_6_2_1_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.2
   * @status    APPROVED (NR5GC_IRAT)
   */
 function f_TC_8_1_6_2_2_NR5GC() runs on NR5GC_PTC
  { //Inter-RAT MDT / Logged MDT / E-UTRA Inter-RAT measurement, logging and reporting
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var CarrierFreqListEUTRA v_CarrierFreqListEUTRA;

    f_NR5GC_IRAT_Init(NR_6); // System information combination NR-6, acc. to TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell

    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);

    //Table 8.1.6.2.2.3.3-1: SIB2 of NR Cell 1
    f_NR_CellInfo_SetSIB2_ThreshServingLowP(nr_Cell1, 10);

    //Table 8.1.6.2.2.3.3-2: SIB5 of NR Cell 1
    v_CarrierFreqListEUTRA := f_NR5GC_CellInfo_GetSIB5_CarrierFreqListEUTRA(nr_Cell1); //@sic R5s230326, R5-232333 sic@
    f_NR5GC_CellInfo_SetSIB5_CarrierFreqListEUTRA(nr_Cell1, {v_CarrierFreqListEUTRA[0]}); //@sic R5s230326, R5-232333 sic@
    f_NR5GC_CellInfo_SetSIB5_CellReselectionPriority(nr_Cell1, 0, 5);
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 10); //@sic R5-232393 sic@
        f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 20); //@sic R5-232393 sic@
    }
    else
    {
        f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 25); //@sic R5-232393 sic@
        f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 30); //@sic R5-232393 sic@
    }
    f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 10);
    f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 20);
    f_NR5GC_CellInfo_SetSIB5_TReselectionEUTRA(nr_Cell1, 7);

    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -78, -82);//@sic R5-216498 sic@
 
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower (nr_Cell1, -78, -82); //@sic R5-216498 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_1_6_2_2_TestBody(v_CoOrd_SysInfo);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    // Tell EUTRA test is finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_6_2_2
   * @param     p_CoOrd_SysInfo
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_2_TestBody(EUTRA_NR_CoOrd_SysInfo_Type p_CoOrd_SysInfo) runs on NR5GC_PTC
  {
    var PLMN_Identity v_PlmnID_NRCell1 := f_NR_CellInfo_GetPLMN(nr_Cell1);
    var AbsoluteTimeInfo_r16 v_AbsoluteTimeInfo_r16 := f_MDT_GetAbsolute_TimeStamp();
    var CellIdentity v_CellIdentity_NRCell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var TrackingAreaCode v_TAC_NRCell1 := f_NR_CellInfo_GetTAC (nr_Cell1);
    var template (present) MeasQuantityResults v_MeasQuantityResults;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var LogMeasInfo_r16 v_LogMeasInfo_r16;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var integer v_FieldCnt;
    //@sic R5s230326, R5-232333 sic@
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (nr_Cell1);
    var template (present) NG_MobileIdentity v_S_TMSI := f_NG_S_TMSI2MobileIdentity(omit, v_GutiParams);
    var boolean k := false;
    var integer i:= 0;

    //@siclog "Step 1" siclog@
    //SS transmits a LoggedMeasurementConfiguration message with reportType set to periodical on NR Cell 1.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, -,
                                    cs_38508_LoggedMeasurementConfiguration(v_PlmnID_NRCell1,
                                                                            v_AbsoluteTimeInfo_r16,
                                                                            cs_LoggedMeasurementConfiguration_reportType_Periodical(ms2560))));

    //@siclog "Step 2" siclog@
    //The SS transmits a RRCRelease message to release the RRC connection.
    f_NR_RRCRelease(nr_Cell1);
    
    //@siclog "Step 3" siclog@
    //The SS changes cell power levels according to the row "T1" in table 8.1.6.2.2.3.2-1/2.
    f_NR_SetCellPower (nr_Cell1, -78, -82); //@sic R5-221556 sic@
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    //@siclog "Step 4" siclog@
    //Wait 35 seconds for UE to detect E-UTRA Cell and perform the logging at regular time intervals.
    f_Delay(35.0); //@sic R5s230326, R5-232333 sic@

    //@siclog "Step 5" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 6-8" siclog@
    //The UE transmits an RRCRequest message.
    //The SS transmit an RRCSetup message.
    //Check: Does UE transmit an RRCSetupComplete message with logMeasAvailable set as true?
    //@sic R5-225387, R5s230326, R5-232333sic@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas(nr_Cell1,tsc_NR_RRC_TI_Def,?,-,-,-,-,
                                                 cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16_LOG)); // receive RRC Connection Setup Complete as per Table 8.1.6.2.2.3.3-4
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get(), tsc_NasKsi_NativeSecurityContext), v_S_TMSI, '0010'B)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }

    //@siclog "Step 9 - 11" siclog@
    //Steps 6 to 8 of the generic procedure in TS 38.508[4] Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //@siclog "Step 12" siclog@
    //The SS send a UEInformationRequest message to get logMeasReport.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                    -,
                                    cs_NR_UEInformationRequest_LOG));
    //@siclog "Step 13" siclog@
    //Check: Does the UE send an UEInformationResponse message including logMeasReport with E-UTRAN Cell1?
    v_MeasQuantityResults := f_NR_Get_MeasQuantityResults();
    SRB.receive(car_NR_SRB_RrcPdu_IND(nr_Cell1,tsc_NR_RbId_SRB2,
                                       cr_38508_UEInformationResponse(tsc_NR_RRC_TI_Def, -,-,
                                                                      cr_LogMeasReport_r16(v_AbsoluteTimeInfo_r16,
                                                                                           cr_TraceReference_r16(v_PlmnID_NRCell1),
                                                                                           '001A'O,
                                                                                           '05'O,
                                                                                           ?,
                                                                                           omit,omit,omit
                                                                                           )))) -> value v_ReceivedAsp;
    v_FieldCnt := lengthof(v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.logMeasReport_r16.logMeasInfoList_r16);
    
    for (i := 0; i<v_FieldCnt ; i:= i + 1)
    {
        v_LogMeasInfo_r16 := v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.logMeasReport_r16.logMeasInfoList_r16[i];
        v_EUTRA_CellId := bit2int (p_CoOrd_SysInfo.Eutra[0].CellId);
        if (match(v_LogMeasInfo_r16, cr_LogMeasInfo_r16_Def( -, -,
                                                            cr_CGI_Info_Logging_r16(v_PlmnID_NRCell1, v_CellIdentity_NRCell1, v_TAC_NRCell1),
                                                            cr_MeasResultServCell_r16(v_MeasQuantityResults),
                                                            omit,
                                                            {cr_MeasResult2EUTRA_r16(p_CoOrd_SysInfo.Eutra[0].Arfcn,{cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId,v_MeasQuantityResults)})}
                                                            )))
        {
            k := true;
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");
            break;
        }
    }

    if (k == false)
    {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueInformationResponse-r16 Message Failed");

    }

  }//End of f_TC_8_1_6_2_2_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.3
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_3_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT MDT / Radio Link Failure / Reporting at E-UTRA Inter-RAT handover
    f_NR5GC_IRAT_Init(NR_6); // System information combination NR-6, acc. to TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);//The UE is in state 3N-A as defined in TS 38.508-1 [4], subclause 4.4A on NR Cell 1
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

    f_NR_TestBody_Set(true);
    fl_TC_8_1_6_2_3_TestBody();
    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    // take down the EUTRA cell
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }// End of f_TC_8_1_6_2_3_NR5GC()

  /*
   * @desc      test body of TC_8_1_6_2_3
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_3_TestBody() runs on NR5GC_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, -90, tsc_NR_NonSuitableOffCellSSS_EPRE)};//@sic R5-216499 R5-220052 sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1 := {cs_NR_CellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)};
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2 := {cs_NR_CellPower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1,tsc_NR_NonSuitableOffCellSSS_EPRE)};//@sic R5-216499 R5-220052 sic@
    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;
    var Hysteresis v_Hysteresis := 0; //@sic R5-218335 sic@
    var EventTriggerConfigInterRAT.reportAmount v_ReportAmount := r1;
    var RSRP_Range v_B2_Threshold1 := 73;
    var RSRP_RangeEUTRA v_B2_Threshold2EUTRA := 58;
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var RLF_Report_r16 v_Nr_Rlf_Report_r16;
    var default v_MyDefaultVar := null;
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList_NR;
    var template (omit) MeasObjectParamsList_Type_EUTRA v_MeasuredObjectList_EUTRA;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (present) NR_RLF_Report_measResultNeighCells v_MeasResultNeighCells_r16;
    var EUTRA_NR_CoOrd_Security_Type v_SecurityRx;// @sic R5s220831 sic@
    var PhysCellId v_PhysCellId_Cell1 := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    var ARFCN_ValueNR v_SSB_Freq_Cell1 := f_NR_CellInfo_GetFrequencySSB(nr_Cell1);
    var template (present) UL_DCCH_Message v_RRCConnReconfigComplete;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var integer i;
    var IntegerList_Type v_DrbIdList := f_NR_GetActiveDRBs(nr_Cell1);// @sic R5s220831 sic@
    var RNTI_Value_Type v_C_RNTI_beforeRLF;// @sic R5s220831 sic@
    var PLMN_Identity v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);// @sic R5s220831 sic@
    var CellIdentity v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);// @sic R5s220831 sic@
    var TrackingAreaCode v_TAC_Cell1 := f_NR_CellInfo_GetTAC (nr_Cell1);// @sic R5s220831 sic@
    var template (present) MeasQuantityResultsEUTRA v_MeasQuantityResultsEUTRA;

         
    //Power levels of NR cell 1: Table 8.1.6.2.3.3.2-1, 8.1.6.2.3.3.2-2
    /*         |    FR1     |    FR2
     * -------------------------------
     *   T0    |    -90     |   Not suitable----//@sic R5-216499 R5-220052 R5-232393 sic@
     * -------------------------------
     *   T1    |    off     |    off
     * -------------------------------
     *   T2    |    -88     |    Not suitable   //@sic R5-216499 R5-220052 R5-232393 sic@.
     * -------------------------------
     */
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo (EUTRA);
    
    v_ARFCN_ValueEUTRA := v_CoOrd_SysInfo.Eutra[0].Arfcn;
    v_EUTRA_CellId := bit2int (v_CoOrd_SysInfo.Eutra[0].CellId);
    v_MeasurementBandwidth := f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(v_CoOrd_SysInfo.Eutra[0].DL_Bandwidth);
    v_C_RNTI_beforeRLF := f_NR_CellInfo_GetRNTI(nr_Cell1);// @sic R5s220831 sic@

    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    //@siclog "Step 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT measurement and reporting for event B2
    //The UE transmits an RRCReconfigrationComplete message
    v_MeasuredObjectList_NR := {cs_MeasObjectId1(nr_Cell1)};
    v_MeasuredObjectList_EUTRA := {cs_MeasObjectId2_EUTRA(v_EUTRA_CellId, v_ARFCN_ValueEUTRA)};
    v_ReportConfigList := {cs_NR_ReportConfig_reportConfigInterRAT(tsc_NR_IdReportConfigId1, cs_NR_ReportConfigInterRAT_Trigger_eventB2_EUTRA(v_B2_Threshold1, v_B2_Threshold2EUTRA, v_Hysteresis, v_ReportAmount, true, false))};
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR_EUTRA(v_ARFCN_ValueEUTRA, v_MeasurementBandwidth, -, v_MeasuredObjectList_NR, v_MeasuredObjectList_EUTRA, v_ReportConfigList, v_MeasIdConfigList, cds_MeasGapConfig_UE(cs_38508_GapConfig), cs_38508_QuantityConfig_EUTRA);
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1,v_MeasConfig);

    //@siclog "Step 3" siclog@
    //The UE transmits a MeasurementReport message on NR Cell 1.
    f_NR_ReceiveMeasurementReports(nr_Cell1, v_PhysCellId_Cell1, tsc_NR_MeasId1, -, -, cr_NR_MeasResults_MeasResultNeighCells_EUTRA({cr_NR_MeasResultEUTRA_CellResults(v_EUTRA_CellId, cr_NR_MeasQuantityResultsEUTRA_Rsrp_Rsrq)}));

    //@siclog "Step 4" siclog@
    //The SS changes NR Cell1 and E-UTRA Cell 1 parameters according to the row "T1" in table 8.1.6.2.3.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 5" siclog@
    //Generic test procedure in TS 38.508-1 Table 4.9.7.2.2-1 is performed on E-UTRA Cell 1.
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Power Level");
    f_NR_SS_SRBs_DRBs_Release(nr_Cell1, -, v_DrbIdList);// @sic R5s220831 sic@
    f_NR_SS_SRBs_DRBs_Config(nr_Cell1, -, omit);// @sic R5s220831 sic@

    //@siclog "Step 6" siclog@
    //The SS changes NR Cell 1 parameter according to the row "T2" in Table 8.1.6.2.3.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);

    //@siclog "Step 7" siclog@
    //The SS transmits a MobilityFromEUTRACommand message on E-UTRA Cell 1.
    v_SecurityRx := f_EUTRA_NR_WaitForCoOrd_Security (EUTRA);// @sic R5s220831 sic@
    f_NR5GC_MappedContextFromS1_InitNAS (v_SecurityRx, true);

    // this also sends octetstring to EUTRA and waits for the Complete message
    //@siclog "Step 8" siclog@
    //Check: Does the UE transmit a RRCReconfigurationComplete message containing rlf-InfoAvailable on NR Cell 1?
    v_PduSessionInfoList := f_EUTRA_NR_WaitForCoOrd_PduSessionInfoList(EUTRA);
    v_RRCConnReconfigComplete:=cr_38508_RRCReconfigurationComplete(cr_RRCReconfigurationComplete_v1530(-,cr_RRCReconfigurationComplete_v1560(-,cr_RRCReconfigurationComplete_v1610_RLF)));
    f_NR5GC_508RRC_InterRAT_HO_ToNR(nr_Cell1, v_PduSessionInfoList, v_SecurityRx,-,-,v_RRCConnReconfigComplete, tsc_NoCnfReq);// @sic R5s221238 sic@

    //@siclog "Step 9" siclog@
    //The UE transmits a ULInformationTransfer message and a REGISTRATION REQUEST message indicating "mobility registration updating"? is sent to update the registration of the actual tracking area.
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected))) -> value v_ReceivedAsp;
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedAsp.Signalling.Nas[0].Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Step 10-11" siclog@
    //SS sends an DLInformationTransfer message and a REGISTRATION ACCEPT message containing a 5G-GUTI.
    //The UE transmits an ULInformationTransfer message and a REGISTRATION COMPLETE message.
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(v_GMM_MobilityInfo);
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell1, v_GMM_MobilityInfo, -, -, noRrcConnectionRelease, -, tsc_NR_RbId_SRB2);
    // Clear store of msgs received in parallel
    f_NR5GC_MsgInDefault_ResetStoreOfNASMessageReq(); // @sic R5s220174 sic@
    // Then activate store for any new msgs received - this works for Modification Reqs too
    v_MyDefaultVar := activate(a_NR5GC_AdditionalPDUSessionEstablishmentReq(nr_Cell1));
    // make sure all the PDNs configured on EUTRA are changed in routing table
    for (i := 0; i < lengthof (v_PduSessionInfoList); i := i + 1) {
      f_IP_ChangeDrbMappingNR(IP, nr_Cell1, cs_IP_QosFlowId(v_PduSessionInfoList[i].PDU_SessionId, v_PduSessionInfoList[i].QFI), v_PduSessionInfoList[i].PdnIndex);
    }

    //@siclog "Step 12" siclog@
    //Void.// @sic R5s220831 R5-225386 sic@
    deactivate(v_MyDefaultVar);

    //@siclog "Step 13" siclog@
    //The SS transmits a UEInformationRequest message.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                    -,
                                    cs_38508_UEInformationRequest(tsc_NR_RRC_TI_Def, -, -, -, -, true_)));

    //@siclog "Step 14" siclog@
    //Check: Does the UE transmit a UEInformationResponse message on NR Cell 1?
    v_MeasQuantityResultsEUTRA := f_EUTRA_Get_MeasQuantityResults();
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                       cr_38508_UEInformationResponse(tsc_NR_RRC_TI_Def,-,-,-,-,-,?))) -> value v_ReceivedAsp;
    v_Nr_Rlf_Report_r16 := v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.rlf_Report_r16;
    v_MeasResultNeighCells_r16:=cr_NR_RLF_Report_measResultNeighCells_Eutra_r16(cr_MeasResultNeighCellListEUTRA_1Entry(v_ARFCN_ValueEUTRA,v_EUTRA_CellId,// @sic R5s220831 sic@
                                                                                                                       v_MeasQuantityResultsEUTRA));
    // @sic R5s220831 R5-225386 sic@
    if (match(v_Nr_Rlf_Report_r16, cr_NR_Rlf_Report_Common(v_C_RNTI_beforeRLF, -, //SSB omit incorrect
                                                    ?, ?,
                                                    v_MeasResultNeighCells_r16, omit,
                                                    cr_NR_RLF_Report_failedPCellId_cellGlobalId_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1, v_TAC_Cell1)),
                                                    *, *, omit, // @sic R5s221166 sic@
                                                    -, ?,
                                                    rlf,
                                                    t310_Expiry,
                                                    -, omit)))
                                                    {
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    } else if (match(v_Nr_Rlf_Report_r16, cr_NR_Rlf_Report_Common(v_C_RNTI_beforeRLF, -, //SSB omit incorrect
                                                    ?, ?,
                                                    v_MeasResultNeighCells_r16, omit,
                                                    cr_NR_RLF_Report_failedPCellId_PciArfcn_r16(v_PhysCellId_Cell1, v_SSB_Freq_Cell1),
                                                    *, *, omit,// @sic R5s221166 sic@
                                                    -, ?,
                                                    rlf,
                                                    t310_Expiry,
                                                    -, omit)))
                                                    {
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    }
    else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
    }

  }//End of f_TC_8_1_6_2_3_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.4
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_4_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT MDT / Connection Establishment Failure / Logging and reporting / Reporting of E-UTRA Inter-RAT handover
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var CarrierFreqListEUTRA  v_CarrierFreqListEUTRA;

    f_NR5GC_IRAT_Init(NR_6);

    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);

    //Set Table 8.1.6.2.4.3.3-1: SIB2 of NR Cell 1
    f_NR_CellInfo_SetSIB2_ThreshServingLowP(nr_Cell1, 10);

    //Table 8.1.6.2.4.3.3-2: SIB5 of NR Cell 1
    v_CarrierFreqListEUTRA := f_NR5GC_CellInfo_GetSIB5_CarrierFreqListEUTRA(nr_Cell1);
    f_NR5GC_CellInfo_SetSIB5_CarrierFreqListEUTRA(nr_Cell1, {v_CarrierFreqListEUTRA[0]});      // @sic R5s230090 sic@

   v_CarrierFreqListEUTRA := f_NR5GC_CellInfo_GetSIB5_CarrierFreqListEUTRA(nr_Cell1); //@sic R5s230326, R5-232333 sic@
    f_NR5GC_CellInfo_SetSIB5_CarrierFreqListEUTRA(nr_Cell1, {v_CarrierFreqListEUTRA[0]}); //@sic R5s230326, R5-232333 sic@
    f_NR5GC_CellInfo_SetSIB5_CellReselectionPriority(nr_Cell1, 0, 5);

    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 10); // @sic R5-232393 sic@
        f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 20); // @sic R5-232393 sic@
    }
    else
    {
        f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 25); // @sic R5-232393 sic@
        f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 30); // @sic R5-232393 sic@
    }
    f_NR5GC_CellInfo_SetSIB5_ThreshXHigh(nr_Cell1, 0, 10);
    f_NR5GC_CellInfo_SetSIB5_ThreshXLow(nr_Cell1, 0, 20);
    f_NR5GC_CellInfo_SetSIB5_TReselectionEUTRA(nr_Cell1, 7);

    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -78, -82); // @sic R5-232393 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A);
    f_NR_SetCellPower (nr_Cell1, -78, -82); // @sic R5-232393 sic@

    f_NR_TestBody_Set(true);
    f_TC_8_1_6_2_4_TestBody(v_CoOrd_SysInfo); // @sic R5s221162 sic@
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
 
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
      
  }// End of f_TC_8_1_6_2_4_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.6.2.4
   * @param     p_CoOrd_SysInfo
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_4_TestBody(EUTRA_NR_CoOrd_SysInfo_Type p_CoOrd_SysInfo) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var CellIdentity v_CellIdentity_Cell1 := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var PLMN_Identity v_PLMN_Identity_Cell1 := f_NR_CellInfo_GetPLMN (nr_Cell1);

    var ARFCN_ValueEUTRA v_ARFCN_ValueEUTRA;
    var EUTRA_PhysCellId v_EUTRA_CellId;

    var template (present) MeasQuantityResultsEUTRA v_MeasQuantityResultsEUTRA;

    v_ARFCN_ValueEUTRA := p_CoOrd_SysInfo.Eutra[0].Arfcn;   //@sic R5s221162 sic@
    v_EUTRA_CellId := bit2int (p_CoOrd_SysInfo.Eutra[0].CellId);    //@sic R5s221162 sic@

    //@siclog "Steps 1" siclog@
    //The SS changes NR Cell 1 and E-UTRA Cell 1 parameter according to the row "T1" in Table 8.1.6.2.4.3.2-1/2.
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Power Level"));
      
    //@siclog "Steps 2" siclog@
    //The SS waits for [30s] to ensure that the UE detects E-UTRA cell.
    f_Delay(34.0);  //@sic R5-254886 sic@

    //@siclog "Step 3" siclog@
    //The SS transmits a Paging message.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    
    //@siclog "Step 4" siclog@
    //The UE transmits an RRCSetupRequest message.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    
    //@siclog "Step 5" siclog@
    //The SS waits for 2sec (T300 expiry) and ignores further received Random Access Preamble.
    f_Delay(2.0);
    
    //@siclog "Step 6-8" siclog@
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_RRCSetup_Def(nr_Cell1);
    
    //@siclog "Step 9" siclog@
    //Check: Does the UE transmit an RRCSetupComplete message including connEstFailInfoAvailable IE set it to true?
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, -, -, -,
                                                                    cr_RRCSetupComplete_v1610_IEs(*,*,cr_UE_MeasurementsAvailable_r16(-, -, -, true_, -))));//@sic R5-225387 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    //@siclog "Steps 10-13" siclog@
    //Steps 5 to 8 of the generic radio bearer establishment procedure in TS 38.508-1 table 4.5.4.2-3 on NR Cell 1.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);


    //@siclog "Step 14" siclog@
    //The SS sends a UEInformationRequest message to get connEstFailReportReq.
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
                                    -,
                                    cs_38508_UEInformationRequest(tsc_NR_RRC_TI_Def, -, -, true_)));

    //@siclog "Step 15" siclog@
    //Check: Check: Does the UE send a UEInformationResponse message with connEstFailReport containing the measurement result for E-UTRA Cell 1?
    v_MeasQuantityResultsEUTRA := f_EUTRA_Get_MeasQuantityResults();
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1,
                                       cr_UEInformationResponse_r16_Common(tsc_NR_RRC_TI_Def,
                                                                           -, -, -,
                                                                           cr_ConnEstFailReport_r16(cr_MeasResultFailedCell_r16(cr_CGI_Info_Logging_r16(v_PLMN_Identity_Cell1, v_CellIdentity_Cell1)),
                                                                                                    omit,cr_MeasResultNeighCellListEUTRA_1Entry(v_ARFCN_ValueEUTRA,v_EUTRA_CellId,
                                                                                                                                                v_MeasQuantityResultsEUTRA)))));    // @sic R5s220801 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15");
  }// End of f_TC_8_1_6_2_4__TestBody()

}
