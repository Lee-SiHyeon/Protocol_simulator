  template (value) AntennaInfoDedicated_r10 cs_AntennaInfoDedicated_r10 :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    transmissionMode_r10 := tm1,                  /* Transmission modes defined in TS 36.213; tm1: Single-antenna port */
    codebookSubsetRestriction_r10  := omit,       /* omit for tm1 */
    ue_TransmitAntennaSelection := {
      release  := NULL
    }
  };

  template (value) SoundingRS_UL_ConfigDedicated cs_508_SoundingRsUl_ConfigDedicated_Rel :=
  { /* 36.331 default as per clause 9.2.4*/
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
