  modulepar charstring                  px_MCPTT_Group_A_ID         := "mcptt-group-A@mcptt-op.gov";

  modulepar charstring                  px_MCPTT_Group_A_Name       := "mcptt-group-A-name";

  modulepar charstring                  px_MCPTT_Group_A_preferred_VCodec := "AMR-WB";  // @desc  Preferred voice codec for the group (a RTP payload). MCPTT clients shall support the AMR-WB codec.

  modulepar charstring                  px_MCPTT_Group_B_ID         := "mcptt-group-B@mcptt-op.gov";

  modulepar charstring                  px_MCPTT_Group_T_ID         := "mcptt-group-T@mcptt-op.gov";

  modulepar charstring                  px_MCPTT_ID_FA_A            := "mcptt-FA-A-id@ mcptt-op.gov";

