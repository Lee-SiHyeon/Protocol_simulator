  /*
   * @desc      Set the applicability conditions according to 36.523-2 Table 4-1a: Applicability of tests Conditions
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_LTE_SelectionExpr(LTE_36523_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;
    var boolean v_FrequencyBandIsFDD := f_EUTRA_FrequencyBandIsFDD(px_ePrimaryFrequencyBand);

    select (p_Condition) {
      case (R) {
        v_ApplCond := true;
      }
      case (C01) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UTRA and not pc_ue_CategoryDL_M1;
      }
      case (C01a) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_FDD and (pc_UTRA_FeatrGrp_3 or pc_UTRA_FeatrGrp_4) and not pc_ue_CategoryDL_M1;
      }
      case (C01b) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_FDD and pc_UTRA_FeatrGrp_4 and not pc_ue_CategoryDL_M1;
      }
      case (C01c) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UTRA and not pc_ue_CategoryDL_M1 and not pc_protection_against_improperReselection_to_GERAN_UTRAN;
      }
      case (C02) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_Combined_Attach;
      }
      case (C02a) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_Combined_Attach and not pc_ue_CategoryDL_M1;
      }
      case (C03) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_USIM_Removal;
      }
      case (C04) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_Attach;
      }
      case (C05) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_GERAN and not pc_ue_CategoryDL_M1;
      }
      case (C05a) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_GERAN and not pc_ue_CategoryDL_M1 and not pc_protection_against_improperReselection_to_GERAN_UTRAN;
      }
      case (C06) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_HRPD and not pc_ue_CategoryDL_M1;
      }
      case (C07) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_1xRTT and not pc_ue_CategoryDL_M1;
      }
      case (C08F_C08T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_5_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_5_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C08aF_C08aT) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_5_F and pc_CEmodeA;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_5_T and pc_CEmodeA;
        }
      }
      case (C08bF_C08bT) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_5_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_5_T;
        }
      }
      case (C09F_C09T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := (pc_eFDD and pc_FeatrGrp_25_F) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA);
        } else {
          v_ApplCond := (pc_eTDD and pc_FeatrGrp_25_T) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA);
        }
      }
      case (C10F_C10T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_25_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_25_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C11F_C11T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := (pc_eFDD and pc_FeatrGrp_16_F and pc_FeatrGrp_25_F) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA);
        } else {
          v_ApplCond := (pc_eTDD and pc_FeatrGrp_16_T and pc_FeatrGrp_25_T) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA);
        }
      }
      case (C12) {
        v_ApplCond := ((pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1) or ((pc_eFDD or pc_eTDD) and pc_CEmodeA and pc_IntraFreqA3_CE_ModeA and pc_IntraFreqHO_CE_ModeA);
      }
      case (C13F_C13T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_UTRA and pc_FeatrGrp_16_F and pc_FeatrGrp_22_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_UTRA and pc_FeatrGrp_16_T and pc_FeatrGrp_22_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C14F_C14T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_5_F and pc_FeatrGrp_17_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_5_T and pc_FeatrGrp_17_T;
        }
      }
      case (C15F_C15T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_3_F and pc_FeatrGrp_7_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_3_T and pc_FeatrGrp_7_T;
        }
      }
      case (C16F_C16T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_7_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_7_T;
        }
      }
      case (C16aF_C16aT) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_7_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_7_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C17F_C17T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_UTRA and pc_GERAN and pc_FeatrGrp_22_F and pc_FeatrGrp_23_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_UTRA and pc_GERAN and pc_FeatrGrp_22_T and pc_FeatrGrp_23_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C18) {
        v_ApplCond := (pc_eFDD or pc_eTDD) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA);
      }
      case (C19F_C19T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_6_F and pc_FeatrGrp_7_F and not (pc_ue_CategoryDL_0 or pc_ue_Category_1 or pc_ue_CategoryDL_M1);
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_6_T and pc_FeatrGrp_7_T and not (pc_ue_CategoryDL_0 or pc_ue_Category_1 or pc_ue_CategoryDL_M1);
        }
      }
      case (C19aF_C19aT) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_6_F and pc_FeatrGrp_7_F and (pc_ue_CategoryDL_0 or pc_ue_Category_1 or pc_ue_CategoryDL_M1);
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_6_T and pc_FeatrGrp_7_T and (pc_ue_CategoryDL_0 or pc_ue_Category_1 or pc_ue_CategoryDL_M1);
        }
      }
      case (C20F_C20T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_GERAN and pc_FeatrGrp_16_F and pc_FeatrGrp_23_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_GERAN and pc_FeatrGrp_16_T and pc_FeatrGrp_23_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C21F_C21T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_13_F and pc_FeatrGrp_25_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_13_T and pc_FeatrGrp_25_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C21aF_C21aT) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_13_F and pc_FeatrGrp_25_F and (not pc_ue_CategoryDL_M1 or (pc_ue_CategoryDL_M1 and pc_CE_Measurements));
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_13_T and pc_FeatrGrp_25_T and (not pc_ue_CategoryDL_M1 or (pc_ue_CategoryDL_M1 and pc_CE_Measurements));
        }
      }
      case (C22) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_SMS_SGs_MT and pc_Combined_Attach and not (pc_Use_SMS_over_IP);
      }
      case (C23) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_SMS_SGs_MO and pc_Combined_Attach and not (pc_Use_SMS_over_IP);
      }
      case (C24F_C24T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_HRPD and pc_FeatrGrp_16_F and pc_FeatrGrp_26_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_HRPD and pc_FeatrGrp_16_T and pc_FeatrGrp_26_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C25F_C25T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_1xRTT and pc_FeatrGrp_16_F and pc_FeatrGrp_24_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_1xRTT and pc_FeatrGrp_16_T and pc_FeatrGrp_24_T and not pc_ue_CategoryDL_M1;
        }
      }
      case (C26) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_CS_Fallback and not pc_ue_CategoryDL_M1;
      }
      case (C27) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_UTRA or pc_GERAN) and pc_ISR and not pc_ue_CategoryDL_M1;
      }
      case (C28F_C28T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := (pc_eFDD and pc_FeatrGrp_13_F and pc_FeatrGrp_25_F) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA and pc_IntraFreqHO_CE_ModeA and pc_FeatrGrp_25_F);
        } else {
          v_ApplCond := (pc_eTDD and pc_FeatrGrp_13_T and pc_FeatrGrp_25_T) or (pc_CEmodeA and pc_IntraFreqA3_CE_ModeA and pc_IntraFreqHO_CE_ModeA and pc_FeatrGrp_25_T);
        }
      }
      case (C29F_C29T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_7_F and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_7_T and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        }
      }
      case (C30F_C30T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_20_F and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_20_T and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        }
      }
      case (C31F_C31T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_7_F and pc_FeatrGrp_20_F and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_7_T and pc_FeatrGrp_20_T and (pc_ue_Category_2 or pc_ue_Category_3 or pc_ue_Category_4 or pc_ue_Category_5) and not pc_ue_CategoryDL_M1;
        }
      }
      case (C32F_C32T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_7_F and pc_FeatrGrp_20_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_7_T and pc_FeatrGrp_20_T;
        }
      }
      case (C33F_C33T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_FeatrGrp_20_F;
        } else {
          v_ApplCond := pc_eTDD and pc_FeatrGrp_20_T;
        }
      }
      case (C36F_C36T) {
        if (v_FrequencyBandIsFDD) {
          v_ApplCond := pc_eFDD and pc_UTRA and pc_FeatrGrp_8_F and pc_FeatrGrp_22_F and not pc_ue_CategoryDL_M1;
        } else {
          v_ApplCond := pc_eTDD and pc_UTRA and pc_FeatrGrp_8_T and pc_FeatrGrp_22_T and not pc_ue_CategoryDL_M1;
        }
