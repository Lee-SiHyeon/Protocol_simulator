  /*
   * @desc      To decode the EUTRA UL DCCH message containing EUTRA capabilities
   * @param     p_Octetstring
   * @return    UL_DCCH_Message
   * @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11)
   */
  function f_EUTRA_DecodeULDcchMsg(octetstring p_Octetstring) return UL_DCCH_Message
  {
    var UL_DCCH_Message v_UL_Dcch_Msg;
    var bitstring v_Bitstring := oct2bit(p_Octetstring);
    var integer v_Result := decvalue(v_Bitstring, v_UL_Dcch_Msg);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "UE EUTRA Capability cannot be decoded");
    }
    return v_UL_Dcch_Msg;  // @sic R5s230454 sic@
  }

}
