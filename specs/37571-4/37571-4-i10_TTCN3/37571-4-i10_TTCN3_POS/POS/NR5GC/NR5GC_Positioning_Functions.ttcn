      if (p_NrDlPrsProcessingCapabilityBandList[v_Index].durationOfPRS_Processing_r16.durationOfPRS_ProcessingSymbols_r16 == pc_durationOfPRS_ProcessingSymbols) { // R5w220203
        v_Found_DurationOfPRS_ProcessingSymbols := true;
