  /*
   * @desc      To receive the RB Setup complete message for PS RAB and perform associated Security configuration in SS
   * @param     p_CellId
   * @param     p_RbType
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RRC_ReceiveRB_SetupCmpl_PS_RAB(UTRAN_CellId_Type p_CellId,
                                                    RB_ConfigType p_RbType) runs on UTRAN_PTC
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var boolean v_CipheringNotStarted := not ((v_SecurityInfo.ps_cipheringStarted == true) and
                                              (v_SecurityInfo.recentSecureDomain == ps_domain));
    var template (omit) KeyCiphering v_KC := omit;
    var U_RLC_AM_IND v_U_RLC_AM_IND;
    
    alt {
      [v_CipheringNotStarted] U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,
                                                            tsc_RB2,
                                                            cr_108_RB_SetUpCmpl(tsc_RRC_TI, omit)))    // no START value sent by the UE
        {}  // No start value, no RB UL cipher
      [] U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,
                                       tsc_RB2,
                                       cr_108_RB_SetUpCmpl(tsc_RRC_TI)))
        -> value v_U_RLC_AM_IND
        {  //A new start value is provided
          v_SecurityInfo.start_PS := v_U_RLC_AM_IND.data.aM_message.uL_DCCH_Message.message_.radioBearerSetupComplete.start_Value;
          f_UTRAN_Security_Set(v_SecurityInfo);
        }
    }
    if (v_CipheringNotStarted) {
      v_KC := v_SecurityInfo.authKeys.AuthPS.CK;
    }
    
    f_UTRAN34_SS_CipheringAM_RAB_UL_DL(p_CellId, v_SecurityInfo.recentSecureDomain, p_RbType, v_KC);
  }

  /*
   * @desc      Function to configure security in SS for the newly established
   *            Radio Bearer, before receiving the Radio Bearer Setup Complete message from UE
   * @param     p_CellId
   * @param     p_Cn_DomainIdentity
   * @param     p_RbType
   * @param     p_KC
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SS_CipheringAM_RAB_UL_DL(UTRAN_CellId_Type p_CellId,
                                              CN_DomainIdentity p_Cn_DomainIdentity,
                                              RB_ConfigType p_RbType,
                                              template (omit) KeyCiphering p_KC) runs on UTRAN_PTC
  {
    var RLC_SequenceNumber v_RLC_SNs := 0;
    var template (value) RB_ActivationTimeInfoList v_RB_ActivationTimeInfoList;
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    
    select (p_RbType) {
      case (cell_FACH_PS,
            cell_FACH_HS,
            cell_DCH_64kPS_RAB_SRB,
            cell_DCH_64kPS_AM_RAB,  //@sic R5s140400 sic@
            cell_DCH_HS_DSCH,
            cell_DCH_E_HS,
            cell_E_HS,
            cell_DCH_dlSRB_E_HS,
            cell_FACH_UL_PS, //@sic R5-150125 sic@
            cell_FACH_UL_FallBack) { //@sic R5-150125 sic@
        f_UTRAN_SS_CipheringAM_RAB_UL_DL(p_CellId,
                                         p_Cn_DomainIdentity,
                                         p_RbType,
                                         p_KC);
      }
      case (cell_DCH_2AM_PS) {
        // Start ciphering in RB22 - RB20 already started
        //@sic R5s150015 sic@
        v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoList22(v_RLC_SNs);
        f_UTRAN_CRLC_SecurityMode_Config(v_SecurityInfo.recentSecureDomain,
                                         v_SecurityInfo.start_PS,
                                         p_KC);
        
        f_UTRAN34_CRLC_DL_CipherCfgRB(p_CellId,
                                      p_Cn_DomainIdentity,
                                      v_SecurityInfo.dL_CipherMode,
                                      p_RbType,
                                      false);  //Do not suspend RLC since RB is established only
        
        f_UTRAN_ActivateCiphering_RLC_UL(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId), ps_domain, v_RB_ActivationTimeInfoList);
      }
      case (cell_DCH_3AM_PS) { //@sic R5s150283 sic@
        v_RB_ActivationTimeInfoList := cs_RB_ActTimeInfoList24(v_RLC_SNs);
        f_UTRAN_CRLC_SecurityMode_Config(v_SecurityInfo.recentSecureDomain,
                                         v_SecurityInfo.start_PS,
                                         p_KC);
        
        f_UTRAN34_CRLC_DL_CipherCfgRB(p_CellId,
                                      p_Cn_DomainIdentity,
                                      v_SecurityInfo.dL_CipherMode,
                                      p_RbType,
                                      false);  //Do not suspend RLC since RB is established only
        
        f_UTRAN_ActivateCiphering_RLC_UL(f_UTRAN_CellInfo_GetFDD_TDD(p_CellId), ps_domain, v_RB_ActivationTimeInfoList);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Configuaration not supported");
      }
    }
  }

  /*
   * @desc      Configure ciphering for RLC layer for configured AM/UM RABs
   *            From Benchmark-function ts_CRLC_DL_CipherCfgRB & ts_CRLC_DL_CipherCfgRB_HS
   * @param     p_CellId
   * @param     p_Cn_DomainIdentity
   * @param     p_CipherMode
   * @param     p_RbType
   * @param     p_Suspend
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_CRLC_DL_CipherCfgRB(UTRAN_CellId_Type p_CellId,
                                         CN_DomainIdentity p_Cn_DomainIdentity,
                                         CipheringModeCommand_r7 p_CipherMode,
                                         RB_ConfigType p_RbType,
                                         boolean p_Suspend) runs on UTRAN_PTC
  {
    if (p_Cn_DomainIdentity == ps_domain) {
      select (p_RbType) {
        case (cell_DCH_64kPS_RAB_SRB,
              cell_DCH_64kPS_AM_RAB,
              cell_FACH_PS,
              cell_FACH_HS,
              cell_DCH_HS_DSCH,
              cell_DCH_E_HS,
              cell_E_HS,
              cell_FACH_UL_PS, //@sic R5-150125 sic@
              cell_FACH_UL_FallBack) //@sic R5-150125 sic@
          { //@sic R5s140400 sic@
          f_UTRAN_CRLC_DL_CipherCfgRB(p_CellId,
                                      p_Cn_DomainIdentity,
                                      p_CipherMode,
                                      p_RbType,
                                      p_Suspend);
        }
        case (cell_DCH_2AM_PS){
          // Start ciphering in RB22 - RB20 already started @sic R5s150246 sic@
          f_UTRAN_CRLC_DL_CipherCfgOneRB(p_CellId,
                                         p_Cn_DomainIdentity,
                                         p_CipherMode,
                                         tsc_RB22,
                                         p_Suspend);
        }
        case (cell_DCH_3AM_PS){
          // Start ciphering RB24 - RB20 and 22 already ciphered @sic R5s150283 sic@
          f_UTRAN_CRLC_DL_CipherCfgOneRB (p_CellId,
                                           p_Cn_DomainIdentity,
                                           p_CipherMode,
                                           tsc_RB24,
                                           p_Suspend);
        }
        case else {
          FatalError(__FILE__, __LINE__,"Configuration not supported");
        }
      }
    } else {
      FatalError(__FILE__, __LINE__,"CS branch not yet implemented");
    }
  }

  /*
   * @desc      This function will receive PDP Context Activation and send PDP Context to the UE.
   *            It will take care of extablishing the RAB as per the received NSAPI
   *            UTRAN34: set precedence class acc to 34.123-3 cl 8.10
   *            UTRAN34: handle QoS UL/DL rate extensions
   * @param     p_QualityOfService
   * @param     p_TI_S
   * @param     p_PktDataProtoAddr
   * @param     p_ProtocolConfigOptions (default value: omit)
   * @param     p_PacketFlowIdentifier (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SendActivatePDP_Accept(template (value) QualityOfService p_QualityOfService,
                                            TI p_TI_S,
                                            template (omit) PktDataProtoAddr p_PktDataProtoAddr,
                                            template (omit) ProtocolConfigOptions p_ProtocolConfigOptions := omit, //@sic R5s140387 sic@
                                            template (omit) PacketFlowIdentifier p_PacketFlowIdentifier := omit) //@sic R5s140387 sic@
    runs on UTRAN_PTC
  {
    var template (value) LLC_SAPI v_LLC_SAPI := cs_LLC_SAPI_UMTS;
    var template (value) QualityOfService v_QualityOfService := p_QualityOfService;
    
    if (pc_GERAN) {
      //UE support GERAN => send with LLC SAPI set as 3
      v_LLC_SAPI := cs_LLC_SAPI_03;
    }
    if (ispresent(p_QualityOfService.maxBitRateDL_Ext) and ispresent(p_QualityOfService.maxBitRateUL_Ext)) {
      v_QualityOfService := cds_QoS_InteractiveOrBackgroundMT_HS_UplinkExt(p_QualityOfService.delayClass,
                                                                           p_QualityOfService.trafficClass,
                                                                           p_QualityOfService.peakThroughput,
                                                                           p_QualityOfService.maxSduSize,
                                                                           p_QualityOfService.maxBitRateUL,
                                                                           p_QualityOfService.maxBitRateDL,
                                                                           p_QualityOfService.maxBitRateDL_Ext,
                                                                           p_QualityOfService.maxBitRateUL_Ext);
    } else if (ispresent(p_QualityOfService.maxBitRateDL_Ext)) {
      v_QualityOfService := cds_QoS_InteractiveOrBackgroundMT_HS(p_QualityOfService.delayClass,
                                                                 p_QualityOfService.trafficClass,
                                                                 p_QualityOfService.peakThroughput,
                                                                 p_QualityOfService.maxSduSize,
                                                                 p_QualityOfService.maxBitRateUL,
                                                                 p_QualityOfService.maxBitRateDL,
                                                                 p_QualityOfService.maxBitRateDL_Ext);
    }
    v_QualityOfService.precedenceClass := '011'B; //Acc to 34.123-3 cl 8.10
    
    U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ActivatePDPContextAccept(cs_ActPDP_ContextAcpMT_Common(p_TI_S,
                                                                                         v_LLC_SAPI,
                                                                                         v_QualityOfService,
                                                                                         cs_RadioPriorityHigh(omit),
                                                                                         p_PktDataProtoAddr,
                                                                                         p_ProtocolConfigOptions,
                                                                                         p_PacketFlowIdentifier))));
  }

  /* @desc      To setup a PS RADIO BEARER and to reconfigure the SS accordingly.
   *            See TS 36.508 cl. 4.8.3 for more details what bearers are configured.
   *            UTRAN34: handle Rel-7 for cell_DCH_64kPS_RAB_SRB (NISPC tc) + all releases
   * @param     p_CellId
   * @param     p_RbType
   * @param     p_WaitForSetupCmpl  (default value: true)
   * @param     p_LoopbackRLC_PDU   (default value: false)
   * @param     p_RAB_Id            (default value: tsc_RAB_DefPS)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RB_SetUp_PS_RAB(UTRAN_CellId_Type p_CellId,
                                     RB_ConfigType     p_RbType,
                                     boolean           p_WaitForSetupCmpl := true,
                                     boolean           p_LoopbackRLC_PDU := false,
                                     bitstring         p_RAB_Id := tsc_RAB_DefPS)
    runs on UTRAN_PTC
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var UTRAN_CFN_Info_Type v_CfnInfo := f_CalculateActTime(p_CellId);
    var template (value) SS_ActivationTime v_SS_ActivationTime := cs_ActivateCFN(v_CfnInfo.actTime);
    var IntegrityCheckInfo v_Integrityinfo := v_SecurityInfo.dl_IntegrityCheckInfo;
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    var boolean v_CnfReq := true;
   
    select (p_RbType) {
      case (cell_DCH_64kPS_RAB_SRB) {
        select (v_FddTddMessageClass) {
          case(FDDr7) {
            // Send RB_Set Up for DCH 64k PS for FDD in Rel-7
            f_UTRAN_RB_SetUp_Send(cs_108_RB_SetUp64k_PS_FDDr7(v_Integrityinfo,
                                                              v_CfnInfo.actTime,
                                                              p_RAB_Id,
                                                              f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId),
                                                              f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellId)));
            //Configure 64k PS RAB at SS in Rel-7
            f_SS_Config_64kPS_RAB_r7(p_CellId, v_SS_ActivationTime, p_LoopbackRLC_PDU);
          }
          case (TDDr7) {
            f_UTRAN_RB_SetUp_Send(cs_108_RB_SetUp64k_PS_TDDr7(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                              v_CfnInfo.actTime,
                                                              p_RAB_Id,
                                                              f_UTRAN_CellInfo_GetCellParametersID_TDD(p_CellId)));
            //Configure 64k PS RAB at SS in Rel-7
            f_SS_Config_64kPS_RAB_r7(p_CellId, v_SS_ActivationTime, p_LoopbackRLC_PDU);
          }
          case else {
            f_UTRAN_RB_SetUp_PS_RAB(p_CellId, p_RbType, p_WaitForSetupCmpl, p_LoopbackRLC_PDU);
            //  v_IsRel7 := false;  /* @sic R5s150678 sic@ */
            return; // @sic R5s160060 sic@
          }
        }
      }
      case (cell_DCH_dlSRB_E_HS) { // @sic R5s160060 sic@
        // Only rel-10 is handled used (for 4C tc)
        // Send RB_Set Up for A17d for FDD
        f_UTRAN_RB_SetUp_Send(f_Get_cs_108_RB_SetUp_A17d(p_CellId, v_Integrityinfo, v_CfnInfo));
        
        //Configure A17d at SS
        f_SS_Config_A1_To_A17d(p_CellId, v_SS_ActivationTime, p_LoopbackRLC_PDU);
      }
      case (cell_DCH_E_HS) { //@sic R5-145760 sic@
        // Send RB_Set Up for A17f for FDD
        // ONLY rel-11 branch is implemented (used in MF TC)
        f_UTRAN_RB_SetUp_Send(f_Get_cs_108_RB_SetUp_A17f(p_CellId, v_Integrityinfo, v_CfnInfo));
        
        //Configure A17f at SS - ONLY rel-11 branch is implemented
        f_SS_Config_A1_To_A17f_r11(p_CellId, v_SS_ActivationTime, p_LoopbackRLC_PDU);
      }
      case (cell_FACH_HS) { // Rel-11 only (used in MF and feFACH TC)
        // Send RB_Set Up for A6 for FDD with RB25
        f_UTRAN_RB_SetUp_Send(f_Get_cs_108_RB_SetUpFACH_RB25(v_Integrityinfo),
                              not v_CnfReq);
        // Reconfigure SS from Cell_FACH to Cell_FACH_HS
        f_SS_Config_FACH_To_FACH_HS (p_CellId, p_LoopbackRLC_PDU);
      }
      case (cell_DCH_2AM_PS) { // @sic R5-151991 sic@
        f_UTRAN_RB_SetUp_Send(f_Get_cs_108_RB_SetUp64k_2AM_PS(p_CellId,
                                                              v_Integrityinfo,
                                                              v_CfnInfo.actTime,
                                                              p_RAB_Id));
        //Modify physical channel
        f_UTRAN34_SS_2DCH_Config_2nd64kPS(p_CellId, v_CfnInfo.actTime);
        // Configure RLC RB22
        f_UTRAN_SS_RB22_AM_PS_Cfg(p_CellId,
                                  cs_OctetModeRLC_Size336,
                                  tsc_UL_DTCH2, tsc_DL_DTCH2);
        f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_2AM_PS);
      }
      case else {
        f_UTRAN_RB_SetUp_PS_RAB(p_CellId, p_RbType, p_WaitForSetupCmpl, p_LoopbackRLC_PDU);
        return; // @sic R5s160060 sic@
      }
    }
    if (p_WaitForSetupCmpl) {
      f_UTRAN_RRC_ReceiveRB_SetupCmpl_PS_RAB(p_CellId, p_RbType);
    }
    else {      // @sic R5s120139 sic@
      f_UTRAN_SS_CipheringAM_RAB_WithEstimatedStartValue(p_CellId, p_RbType, v_SecurityInfo);
    }
  }

  /*
   * @desc      If no activation time is specified "now" will be used. This is to be used for HOs to UTRAN.
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_LoopbackRLC_PDU   (default value: false)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_64kPS_RAB_r7(UTRAN_CellId_Type p_CellId,
                                    template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                    boolean p_LoopbackRLC_PDU := false) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramblingCode;
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      // Configure SS for cell_DCH_64kPS_RAB_SRB configuration
      v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
      f_SS_Config_64kPS_FDD_r7(p_CellId,
                               cs_CphyTrchConfigReq_UL_TrCh_FDD(p_ActTime,
                                                                cs_DCH_336_148_UL_Info_FDD,
                                                                cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                               cs_CphyTrchConfigReq_DL_TrCh_FDD(p_ActTime,
                                                               cs_DCH_336_148_DL_Info_FDD,
                                                                cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfoHigher64k)),
                               cs_TrCHInfo_UL_TrCh_FDD(cs_TrChInfoTrCHListUL_336_148_FDD,
                                                       cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                               cs_TrCHInfo_DL_TrCh_FDD(cs_TrChInfoTrCHListDL_336_148_FDD,
                                                       cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfoHigher64k)),
                               cs_TrLogMappingUL_4DCCH_1DTCH(tsc_RB20),
                               cs_TrLogMappingDL_4DCCH_1DTCH_PS,
                               cs_DL_DPCH_FDDr7(cs_DL_CommonInformationRB_SetUp_FDD_r7(tsc_DL_DPCH1_SFP_64k_PS, flexible),
                                                tsc_DL_DPCH1_ChC_64k_PS,
                                                -,
                                                tsc_DL_TxPower_DPCH_64k),
                               cs_UL_DPCH_Info_FDDr7(tsc_UL_DPDCH_SF_64k_PS,
                                                     pl0_96,
                                                     v_UL_ScramblingCode), p_ActTime);
    } else {
      // Configure SS for cell_DCH_64kPS_RAB_SRB configuration
      f_SS_Config_64kPS_TDD_r7(p_CellId,
                               cs_CphyTrchConfigReq_UL_TrCh_TDD(p_ActTime,
                                                                cs_DCH_336_148_UL_Info_TDD,
                                                                cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                               cs_CphyTrchConfigReq_DL_TrCh_TDD(p_ActTime,
                                                                cs_DCH_336_148_DL_Info_TDD,
                                                                cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfo_TDD)),
                               cs_TrCHInfo_UL_TrCh_TDD(cs_TrChInfoTrCHListUL_336_148_TDD,
                                                       cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                               cs_TrCHInfo_DL_TrCh_TDD(cs_TrChInfoTrCHListDL_336_148_TDD,
                                                       cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfo_TDD)),
                               cs_TrLogMappingUL_4DCCH_1DTCH_TDD(tsc_RB20),
                               cs_TrLogMappingDL_4DCCH_1DTCH_PS_TDD,
                               cs_DL_DPCH_64k_PS_TDDr7,
                               cs_UL_DPCH_64k_PS_TDD,
                               p_ActTime);
    }
    // Setup radio bearer B20.
    //* Default values from 34.108  cl. 6.10.2.4.4 and 6.10.2.4.3.3
    f_UTRAN_SS_RB20_AM_PS_Cfg(p_CellId, cs_OctetModeRLC_Size336);
    
    // Configure PDCP when there is no loopback of RLC PDU
    if (not(p_LoopbackRLC_PDU)) {
      f_SS_RB_ConfigurePDCP(p_CellId, tsc_RB20);
    }
    f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_64kPS_RAB_SRB);
  }

   /*
   * @desc      To set up physical channel DPCH1 and connect DCH1and DCH5 to the physical channel.
   *            Then map DCCH1-4 on to the DCH5 transport channel and map DTCH1 to the DCH1 transport channel.
   * @param     p_CellId
   * @param     p_UL_TrChConfig
   * @param     p_DL_TrChConfig
   * @param     p_UL_TrCHInfo
   * @param     p_DL_TrCHInfo
   * @param     p_UL_TrLogMapping
   * @param     p_DL_TrLogMapping
   * @param     p_DL_DPCHInfo
   * @param     p_UL_DPCH_Info
   * @param     p_ActivationTime
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_64kPS_FDD_r7(UTRAN_CellId_Type                       p_CellId,
                                    template (value) CphyTrchConfigReq      p_UL_TrChConfig,
                                    template (value) CphyTrchConfigReq      p_DL_TrChConfig,
                                    template (value) TrCHInfo               p_UL_TrCHInfo,
                                    template (value) TrCHInfo               p_DL_TrCHInfo,
                                    template (value) TrCH_LogCHMappingList1 p_UL_TrLogMapping,
                                    template (value) TrCH_LogCHMappingList1 p_DL_TrLogMapping,
                                    template (value) DL_DPCHInfo_r7_FDD     p_DL_DPCHInfo,
                                    template (value) UL_DPCH_Info_r7        p_UL_DPCH_Info,
                                    template (value) SS_ActivationTime      p_ActivationTime) runs on UTRAN_PTC
  {
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_FDD(p_CellId,
                                                      tsc_DL_DPCH1,
                                                      cs_DPCHInfo_DL_FDDr7(p_DL_DPCHInfo),
                                                      p_ActivationTime));
    
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_DL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 p_DL_TrChConfig));
    
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_DL_DPCH1,
                                                  cs_UE_Info,
                                                  p_DL_TrCHInfo,
                                                  p_DL_TrLogMapping,
                                                  p_ActivationTime));
    
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_FDD(p_CellId,
                                                      tsc_UL_DPCH1,
                                                      cs_DPCHInfo_UL_FDD(p_UL_DPCH_Info),
                                                      p_ActivationTime));
    
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_UL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 p_UL_TrChConfig));
    
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1,
                                                  cs_UE_Info,
                                                  p_UL_TrCHInfo,
                                                  p_UL_TrLogMapping,
                                                  p_ActivationTime));
  }

  /*
   * @desc      To set up physical channel DPCH1 and connect DCH1and DCH5 to the physical channel.
   *            Then map DCCH1-4 on to the DCH5 transport channel and map DTCH1 to the DCH1 transport channel.
   * @param     p_CellId
   * @param     p_UL_TrChConfig
   * @param     p_DL_TrChConfig
   * @param     p_UL_TrCHInfo
   * @param     p_DL_TrCHInfo
   * @param     p_UL_TrLogMapping
   * @param     p_DL_TrLogMapping
   * @param     p_DL_DPCHInfo
   * @param     p_UL_DPCH_Info
   * @param     p_ActivationTime
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_64kPS_TDD_r7(UTRAN_CellId_Type                       p_CellId,
                                    template (value) CphyTrchConfigReq_TDD      p_UL_TrChConfig,
                                    template (value) CphyTrchConfigReq_TDD      p_DL_TrChConfig,
                                    template (value) TrCHInfo_TDD               p_UL_TrCHInfo,
                                    template (value) TrCHInfo_TDD               p_DL_TrCHInfo,
                                    template (value) TrCH_LogCHMappingList1_TDD p_UL_TrLogMapping,
                                    template (value) TrCH_LogCHMappingList1_TDD p_DL_TrLogMapping,
                                    template (value) DL_DPCHInfo_r7_TDD     p_DL_DPCHInfo,
                                    template (value) UL_DPCH_Info_r7        p_UL_DPCH_Info,
                                    template (value) SS_ActivationTime      p_ActivationTime) runs on UTRAN_PTC
  {
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_TDD(p_CellId,
                                                      tsc_DL_DPCH1,
                                                      cs_DPCHInfo_DL_TDDr7(p_DL_DPCHInfo),
                                                      p_ActivationTime));
    
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_TDD(p_CellId,
                                                 tsc_DL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 p_DL_TrChConfig));
    
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(utran_CellDedicated,
                                                  tsc_DL_DPCH1,
                                                  cs_UE_Info,
                                                  p_DL_TrCHInfo,
                                                  p_DL_TrLogMapping,
                                                  p_ActivationTime));
    
    f_UTRAN_CPHY_RL_Modify(cas_RL_Modify_DPCHInfo_TDD(p_CellId,
                                                      tsc_UL_DPCH1,
                                                      cs_DPCHInfo_UL_TDD(p_UL_DPCH_Info),
                                                      p_ActivationTime));
    
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_TDD(p_CellId,
                                                 tsc_UL_DPCH1,
                                                 cs_TrChConfigTypeDCH_NoSHO,
                                                 p_UL_TrChConfig));
    
    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(utran_CellDedicated,
                                                  tsc_UL_DPCH1,
                                                  cs_UE_Info,
                                                  p_UL_TrCHInfo,
                                                  p_UL_TrLogMapping,
                                                  p_ActivationTime));
  }

  /*
   * @desc      returns the RADIO BEARER SETUP for A17d depending on the message class - Only rel-10 is handled (used in 4C TC)
   * @param     p_CellId
   * @param     p_Integrityinfo
   * @param     p_CfnInfo
   * @return    template (value) DL_DCCH_Message
   * @status    APPROVED (UTRAN)
   */
  function f_Get_cs_108_RB_SetUp_A17d(UTRAN_CellId_Type  p_CellId,
                                      IntegrityCheckInfo p_Integrityinfo,
                                      UTRAN_CFN_Info_Type p_CfnInfo)
    runs on UTRAN_PTC return template (value) DL_DCCH_Message
  {
    var template (value) DL_DCCH_Message v_RadioBearerSetup;
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    select (v_FddTddMessageClass) {
      case (FDDr10) {  // Only rel-10 is handled (used in 4C TC)
        v_RadioBearerSetup := cs_108_RB_SetUpA17d_r10_FDD(p_Integrityinfo,
                                                          p_CfnInfo.actTime,
                                                          f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId),
                                                          f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellId));
      }
      case else {
        FatalError(__FILE__, __LINE__, "Not a valid message class");
      }
    }
    return v_RadioBearerSetup;
  }

  /*
   * @desc      returns the RADIO BEARER SETUP for A17f depending on the message class
   *            ONLY rel-11 branch is implemented (used in MF TC)
   * @param     p_CellId
   * @param     p_Integrityinfo
   * @param     p_CfnInfo
   * @return    template (value) DL_DCCH_Message
   * @status    APPROVED (UTRAN)
   */
  function f_Get_cs_108_RB_SetUp_A17f(UTRAN_CellId_Type  p_CellId,
                                      IntegrityCheckInfo p_Integrityinfo,
                                      UTRAN_CFN_Info_Type p_CfnInfo)
    runs on UTRAN_PTC return template (value) DL_DCCH_Message
  {
    var template (value) DL_DCCH_Message v_RadioBearerSetup;
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
   
    select (v_FddTddMessageClass) {
      case (FDDr11) {  // ONLY rel-11 branch is implemented (used in MF TC)
         v_RadioBearerSetup := cs_108_RB_SetUpA17f_r11_FDD(p_Integrityinfo,
                                                           p_CfnInfo.actTime,
                                                           f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId),
                                                           f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellId),
                                                           f_UTRAN_CellInfo_GetFrequencyInfo(p_CellId));
      }
      case else {
        FatalError(__FILE__, __LINE__, "Not a valid message class");
      }
    }
    return v_RadioBearerSetup;
  }

  /*
   * @desc      returns the RADIO BEARER SETUP for A6 with RB25
   *            Only FDD rel-11 is handled
   * @param     p_Integrityinfo
   * @return    template (value) DL_DCCH_Message
   * @status    APPROVED (UTRAN)
   */
  function f_Get_cs_108_RB_SetUpFACH_RB25(IntegrityCheckInfo p_Integrityinfo) runs on UTRAN_PTC return template (value) DL_DCCH_Message
  {
    var template (value) DL_DCCH_Message v_RadioBearerSetup;
    var C_RNTI v_New_CRNTI := '1010101010101010'B;
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    select (v_FddTddMessageClass) {
      case (FDDr11) {  // Rel-11 only (used in MF and feFACH TC)
        v_RadioBearerSetup := cs_108_RB_SetUpFACH_RB25_FDD_r11(p_Integrityinfo, v_New_CRNTI, tsc_RAB_DefPS);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Not a valid message class");
      }
    }
    return v_RadioBearerSetup;
  }

  /*
   * @desc      Setup radio bearers :  RB25. default values from 34.108  cl. 6.10.2.4.4 and 6.10.2.4.3.3. For cell_FACH_HS configuration.
   *            Release from Rel-11
   * @param     p_CellId
   * @param     p_RLC_Size
   * @param     p_LogChUL           (default value: tsc_UL_DTCH1)
   * @param     p_LogChDL           (default value: tsc_DL_DTCH1)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SS_RB25_FACH_AM_PS_Cfg(UTRAN_CellId_Type p_CellId,
                                            template (value) OctetModeRLC_SizeInfoType1 p_RLC_Size,
                                            template (value) LogicalChannelIdentity p_LogChUL := tsc_UL_DTCH1,
                                            template (value) LogicalChannelIdentity p_LogChDL := tsc_DL_DTCH1) runs on UTRAN_PTC
  {
    f_UTRAN_SS_InteractiveBackground_AM_PS_Cfg(p_CellId, tsc_RB25, p_RLC_Size, p_LogChUL, p_LogChDL);
  }

  /*
   * @desc      Reconfigure SS from cell_FACH to cell_FACH_HS on rel-11 FDD
   *            Only rel-11 FDD is handled
   * @param     p_CellId
   * @param     p_LoopbackRLC_PDU
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_FACH_To_FACH_HS(UTRAN_CellId_Type  p_CellId,
                                       boolean p_LoopbackRLC_PDU) runs on UTRAN_PTC
  {
    var C_RNTI v_New_CRNTI := f_UTRAN_CellInfo_GetC_RNTI(p_CellId);
    // Rel-11 only (used in MF and feFACH TC)
    //Release RB20
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB20, UTRAN_FDD);
    //Reconfigure MAC with C-RNTI (C-RNTI is necessary when DCCH/DTCH mapped on PRACH) and for S-CCPCH and RACH to provide RB25 in the logChMapping info
    //Reconfigure RLC size to allow C-RNTI in MAC header
    //Configure radio bearers: RB1 (UM + DCCH) and (UM + DCCH); Payload size=136 (default)
    f_UTRAN_CRLC_Config(cas_RB_UM_ReconfigInfo_FDD(utran_CellDedicated,    // @sic R5s110278, R5s110315 sic@
                                                   tsc_RB1,
                                                   cs_RB_LogCH_Mapping(tsc_UL_DCCH1, tsc_DL_DCCH1)));

    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                  tsc_S_CCPCH1,
                                                  cs_UE_Info(omit, v_New_CRNTI),    // C-RNTI is needed when DCCH/DTCH are mapped on S-CCPCH
                                                  cs_TrChInfoPCH_FACH_PS_FDD,
                                                  cds_TrLogMappingPCH_FACH_PS_HS_FDD));

    f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                  tsc_PRACH1,
                                                  cs_UE_Info(omit, v_New_CRNTI),
                                                  cs_TrChInfoRACH1_FDD,
                                                  cds_TrLogMappingRACH_DTCH_HS));

    //Configure RB25
    f_UTRAN34_SS_RB25_FACH_AM_PS_Cfg(p_CellId, cs_OctetModeRLC_Size336);

    // Configure PDCP when there is no loopback of RLC PDU
    if (not(p_LoopbackRLC_PDU)) { f_SS_RB_ConfigurePDCP(p_CellId, tsc_RB25);  }
               
    f_UTRAN_CellInfo_SetConfigType (p_CellId, cell_FACH_HS);
  }

  /*
   * @desc      Reconfigure SS from A1 to A17d (cell_DCH_dlSRB_E_HS) - Only rel-10 is handled (used in 4C TC)
   *            Only rel-10 is handled
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_LoopbackRLC_PDU
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_A1_To_A17d(UTRAN_CellId_Type  p_CellId,
                                  template (value) SS_ActivationTime p_ActTime,
                                  boolean p_LoopbackRLC_PDU) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
    var template (value) DPCHInfo_r10OrLaterExtensionType_FDD v_DL_DPCHInfo := cs_DL_DPCHInfo_r10_Extension_FDD(cs_DL_DPCH_FDD_r10(cs_DL_CommonInformationRB_SetUp_FDD_r10(tsc_DL_DPCH1_SFP_64k_PS, flexible),
                                                                                                                                   tsc_Sfc256_C0, // code for 16qam
                                                                                                                                   omit)); // SecondaryScramblingCode
    var template (value) TFCS v_TFCS := cs_TFCS_Cmpl0_1_Tx_FDD(cs_PowerOffsetInfoBelow64k);
    var template (value) CphyTrchConfigReq v_CphyTrchConfigReq := cs_CphyTrchConfigReq_DL_TrCh_FDD(p_ActTime, cs_DCH_148_DL_FDD, v_TFCS);
    var template (value) TrCHInfo v_DL_TrCHInfo := cs_TrCHInfo_DL_TrCh_FDD(cs_TrChInfoTrCHListDL_34_StandAlone_FDD, v_TFCS);
    var template (value) TrCH_LogCHMappingList1 v_DL_TrLogMapping := cs_TrLogMappingDL_4DCCH;
    var template (value) DPCHInfo_r10OrLaterExtensionType_FDD v_UL_DPCHInfo := cs_UL_DPCHInfo_r10_Extension_FDD(cs_UL_DPCH_OnlyHS_PDSCH_FDD(v_UL_ScramblingCode),
                                                                                                                cs_HS_DPCCHInfo_r10);
    //DL: SRBs 13.6 -> 3.4
    f_SS_ConfigPS_DL_DPCH1_FDD(p_CellId,
                               cs_DPCHInfo_Extension_FDD(v_DL_DPCHInfo),
                               v_CphyTrchConfigReq,
                               v_DL_TrCHInfo,
                               v_DL_TrLogMapping,
                               p_ActTime);
    //DL: Setup HS-PDSCH
    f_SS_HS_DSCH_ConfigCommon_r10(p_CellId,
                                  p_ActTime,
                                  cs_SS_MAC_ehs_AddReconfReordQueue_1Q(tsc_MACehs_Queue0_DTCH, 0));
    
    // UL SRBs mapped on E-DCH
    // Modification of SRBs at SS (13.6 -> E-DCH)
    
    f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated,
                                            tsc_UL_DPCH1,
                                            p_ActTime));
    
    f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellId,
                                                     tsc_UL_DPCH1,
                                                     cs_TrChConfigTypeDCH_NoSHO,
                                                     p_ActTime));
    
    f_UTRAN_CPHY_RL_Modify(cas_108_DL_DPCH_ModifyInfo_r10(p_CellId,
                                                          tsc_UL_DPCH1,
                                                          v_UL_DPCHInfo,
                                                          p_ActTime,
                                                          false));
    
    //Configure E-DCH and MACi/is
    f_SS_E_DCH_ConfigCommonMACi(p_CellId, p_ActTime, cs_E_DCHMACdFlows_FDD_Def, cs_LCH_MappingList_DCCH_DTCH);
    
    // Setup RAB 25 entity
    f_SS_RB25_AM_HSPA_Cfg(p_CellId);
    
    // Configure PDCP when there is no loopback of RLC PDU
    if (not(p_LoopbackRLC_PDU)) {
      f_SS_RB_ConfigurePDCP(p_CellId, tsc_RB25);
    }
    
    f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_dlSRB_E_HS);
  }

  /*
   * @desc      To configure SS to HS-DPA related RL, transport and MAC
   *            DL: [max bit rate depending on UE category] / PS RAB
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_AddReconfReordQueueList
   * @status    APPROVED (UTRAN)
   */
  function f_SS_HS_DSCH_ConfigCommon_r10(UTRAN_CellId_Type  p_CellId,
                                         template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                         template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 p_AddReconfReordQueueList) runs on UTRAN_PTC
  {
    var template (value) EHS_DSCH_Flows_r9  v_EHS_DSCH_Flows_r9 := cs_HS_DSCHMacdFlows_r9(cs_HARQ_Info_FDD, p_AddReconfReordQueueList);

    // Setup CPHY-RL CPHY-TrCH  for HS-PDSCH
    f_UTRAN_CPHY_RL_Setup(cas_RL_SetupInfo_FDD(p_CellId,
                                               tsc_HSPDSCH,
                                               cs_HS_PDSCHInfoExtension_FDD_r10OrLater(cs_DL_HS_DSCH_FDD_r10(omit,
                                                                                                             pc_HSDSCH_UE_Category_FDD, // category when MAC-ehs is configured @sic R5w140207 sic@
                                                                                                             omit, // category when DC-HSDPA is configured
                                                                                                             omit, // category when DC-HSDPA+MIMO is configured
                                                                                                             omit, // 2 secondary cell
                                                                                                             omit,  // 3 secondary cell
                                                                                                             cs_DL_HSPDSCH_Information_r9_FDD(cs_HS_SCCH_Info_r9_FDD, //Default code 128:7
                                                                                                                                              cs_Measurement_Feedback_Info))),
                                               p_ActTime));
    
    // Setup CPHY-TrCH in all cells
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_HSPDSCH,
                                                 cs_TrChConfigTypeNonDCH,
                                                 cs_CphyTrchConfigReq_Common_FDD_r9(p_ActTime,
                                                                                    omit, // CphyUlConnectedTrCHList_Type
                                                                                    omit, // UlTfcs
                                                                                    omit, // DlconnectedTrCHList  dlconnectedTrCHList
                                                                                    omit, // DL TFCS
                                                                                    omit, // HS_DSCHMACdFlows
                                                                                    omit, // E_DCHMACdFlows
                                                                                    v_EHS_DSCH_Flows_r9)));
    
    // To configure MAC_eHS in Explicit TFRC config mode
    // MAC configure on cellDedicated
    f_UTRAN_CMAC_MACHs_Config(utran_CellDedicated,
                              cas_CMAC_MAChs_TFRC_ExplicitConfigReq_16QAM(utran_CellDedicated, p_ActTime));
    
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD_r10(utran_CellDedicated,
                                                 tsc_HSPDSCH,
                                                 cs_UE_Info,
                                                 cs_TrCHInfo_Common_FDD_r9(omit, // UlconnectedTrCHList
                                                                           omit, // UlTfcs
                                                                           omit, // DlconnectedTrCHList,
                                                                           omit, // DlTfcs,
                                                                           omit, // HsDSCHMacdFlows := omit,
                                                                           v_EHS_DSCH_Flows_r9),
                                                 cs_TrLogMappingDL_MAC_eHS));  //Queue id =0
  }

  /*
   * @desc      Function to configure SS to HSUPA related RL, Transport and MACi
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_E_DCHMACdFlows
   * @param     p_LCH_MappingList
   * @param     p_ConfigureRGCH     (default value: false)
   * @param     p_IsServingCell     (default value: true)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_E_DCH_ConfigCommonMACi(UTRAN_CellId_Type                  p_CellId,
                                       template (value) SS_ActivationTime p_ActTime,
                                       template (value) E_DCHMACdFlows    p_E_DCHMACdFlows,
                                       template (value) LCH_MappingList   p_LCH_MappingList,
                                       boolean p_ConfigureRGCH := false,
                                       boolean p_IsServingCell := true) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramblingCode;
    var integer v_NodeB := f_UTRAN_CellInfo_GetNodeB_Id(p_CellId);
    var template (value) RL_Setup_FDD_PhysicalChannelInfo_Type v_PhysicalChannelInfo;
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
      // Configuration of E-AGCH
      f_UTRAN_CPHY_RL_Setup(cas_E_AGCH_SetupInfo_FDD(p_CellId,
                                                     tsc_E_AGCH,
                                                     p_ActTime));
      // Configuration of E-HICH
      select (v_FddTddMessageClass) {
        case (FDDr8,FDDr9, FDDr10) {
          v_PhysicalChannelInfo := cs_SS_E_HICH_Info_FDD;
        }
        case else { //Release above Rel-11
          v_PhysicalChannelInfo := cs_SS_E_HICH_Info_FDD(omit, -, cs_SS_E_HICH_r11);
        }
      }
      f_UTRAN_CPHY_RL_Setup(cas_E_HICH_SetupInfo_FDD(p_CellId,
                                                     tsc_E_HICH,
                                                     p_ActTime,
                                                     v_PhysicalChannelInfo));

      // Configuration of E-RGCH
      if (p_ConfigureRGCH) {
        f_UTRAN_CPHY_RL_Setup(cas_E_RGCH_SetupInfo_FDD(p_CellId,
                                                       tsc_E_RGCH,
                                                       p_ActTime));
      }
      // Configuration of E-DPCH
      f_UTRAN_CPHY_RL_Setup(cas_E_DPCH_SetupInfo_FDD(p_CellId,
                                                     tsc_E_DPCH,
                                                     p_ActTime,
                                                     cs_SS_E_DPCH_Info_FDD_r9(v_UL_ScramblingCode)));  // Use E-DCH category
      // Configuration of Transport channels
      f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                   tsc_E_DPCH,
                                                   cs_TrChConfigTypeNonDCH,
                                                   cs_CphyTrchConfigReq_Common_FDD(p_ActTime, omit, omit, omit, omit, omit, p_E_DCHMACdFlows)));
      // Configuration of MAC
      f_UTRAN_CMAC_MACi_NodeB_CellMapping_Config(p_CellId,
                                                 v_NodeB);
      // Configuration of MACi
      f_UTRAN_CMACi_Config(cas_CMAC_MACi_Setup_REQ_FDD(v_NodeB,
                                                       p_ActTime,
                                                       p_LCH_MappingList,
                                                       p_E_DCHMACdFlows));
      // Configuration of MACis (only for serving cells; for HO cells, this configuration is done later to avoid the SS receiving data from two different cells at the same time
      if (p_IsServingCell) {
        f_UTRAN_CMACis_Config(utran_CellDedicated, cas_CMAC_MACis_Setup_r9_REQ(utran_CellDedicated, p_ActTime, p_LCH_MappingList));
      }
    }
    else {
      // TDD no 4C configuration
      FatalError(__FILE__, __LINE__, "TDD invalid cell configuration");
    }
  }

  /*
   * @desc      Configures NodeB Cell Mapping (CMAC-MACi-NodeB-CellMapping-REQ)
   * @param     p_CellId
   * @param     p_NodeB_Id
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_CMAC_MACi_NodeB_CellMapping_Config(UTRAN_CellId_Type p_CellId,
                                                      integer p_NodeB_Id) runs on UTRAN_PTC
  {
    U_CMAC.send(cas_MACi_NodeB_CellMapping_1Cell(p_CellId, p_NodeB_Id));
    U_CMAC.receive(car_CMAC_MACi_NodeB_CellMapping_CNF(p_NodeB_Id));
  }

    /*
   * @desc      Reconfigure SS from A1 to A17f (cell_DCH_E_HS) on rel-11
   *             ONLY rel-11 branch is implemented (used in MF TC)
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_LoopbackRLC_PDU
   * @status    APPROVED (UTRAN)
   */
  function f_SS_Config_A1_To_A17f_r11(UTRAN_CellId_Type  p_CellId,
                                      template (value) SS_ActivationTime p_ActTime,
                                      boolean p_LoopbackRLC_PDU) runs on UTRAN_PTC
  {
    var template (value) DL_CommonInformation_r11 v_DL_CommonInformation := cs_DL_CommonInformationRB_SetUp_FDD_r11(tsc_DL_DPCH1_SFP_64k_PS, flexible);
    var template (value) DPCHInfo_r5OrLater_FDD v_DL_DPCHInfo := cs_DPCHInfo_Extension_FDD(cs_DL_DPCHInfo_r11_Extension_FDD(cs_DL_DPCH_FDD_r11(v_DL_CommonInformation,
                                                                                                                                               tsc_Sfc256_C0, // code for 16qam
                                                                                                                                               omit))); // SecondaryScramblingCode
    var template (value) TFCS v_TFCS := cs_TFCS_Cmpl0_1_Tx_FDD(cs_PowerOffsetInfoBelow64k);
    var template (value) CphyTrchConfigReq v_DL_TrChConfig := cs_CphyTrchConfigReq_DL_TrCh_FDD(p_ActTime, cs_DCH_148_DL_FDD, v_TFCS);
    var template (value) TrCHInfo v_DL_TrCHInfo := cs_TrCHInfo_DL_TrCh_FDD(cs_TrChInfoTrCHListDL_34_StandAlone_FDD, v_TFCS);
    var template (value) TrCH_LogCHMappingList1 v_DL_TrLogMapping := cs_TrLogMappingDL_4DCCH;
    
    //DL: SRBs 13.6 -> 3.4
    f_SS_ConfigPS_DL_DPCH1_FDD(p_CellId, v_DL_DPCHInfo, v_DL_TrChConfig, v_DL_TrCHInfo, v_DL_TrLogMapping, p_ActTime);
    
    //DL: Setup HS-PDSCH - 64QAM configured
    f_SS_HS_DSCH_ConfigCommon_r11(p_CellId, p_ActTime, cs_SS_MAC_ehs_AddReconfReordQueue_1Q_r11(tsc_MACehs_Queue0_DTCH, 0));
    
    // UL SRBs 13.6 -> 3.4
    f_SS_UL_DPCH_ModifySRB_13_6_To_3_4_r11(p_CellId, p_ActTime, 3, 3, 1);

    //Configure E-DCH and MACi/is
    f_SS_E_DCH_ConfigCommonMACi(p_CellId, p_ActTime, cs_E_DCHMACdFlows_FDD_DTCH, cs_LCH_MappingList_DTCH);
    
    // Setup RAB 25 entity
    f_SS_RB25_AM_Flexible_Cfg_r11(p_CellId, p_ActTime, tw256, rw768, pw99, tsp80);
    
    // Configure PDCP when there is no loopback of RLC PDU
    if (not(p_LoopbackRLC_PDU)) {
      f_SS_RB_ConfigurePDCP(p_CellId, tsc_RB25);
    }
    
    f_UTRAN_CellInfo_SetConfigType(p_CellId, cell_DCH_E_HS);
  }

  /*
   * @desc      To configure SS to HS-DPA related RL, transport and MAC
   *            DL: [max bit rate depending on UE category] / PS RAB
   *            64QAM configured
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_AddReconfReordQueueList_r11
   * @status    APPROVED (UTRAN)
   */
  function f_SS_HS_DSCH_ConfigCommon_r11(UTRAN_CellId_Type  p_CellId,
                                         template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                         template (value) SS_MAC_ehs_AddReconfReordQueueList_r11 p_AddReconfReordQueueList_r11) runs on UTRAN_PTC
  {
    var template (value) TrCHInfo_r10OrLaterExtensionType v_TrChInfo := cs_HS_DSCHMacdFlows_r11(cs_HARQ_Info_FDD_r11, p_AddReconfReordQueueList_r11);
      
    // Setup CPHY-RL CPHY-TrCH  for HS-PDSCH
    f_UTRAN_CPHY_RL_Setup(cas_RL_SetupInfo_FDD(p_CellId,
                                               tsc_HSPDSCH,
                                               cs_HS_PDSCHInfoExtension_FDD_r10OrLater(cs_HSPDSCH_Information_FDD_r11(pc_HSDSCH_UE_Category_FDD, // category when MAC-ehs is configured @sic R5w140207 sic@
                                                                                                                      cs_DL_HSPDSCH_Information_FDD_r11(cs_HS_SCCH_Info_r9_FDD, //Default code 128:7
                                                                                                                                                        cs_Measurement_Feedback_Info_r11))),
                                               p_ActTime));
      
    // Setup CPHY-TrCH in all cells
    f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                 tsc_HSPDSCH,
                                                 cs_TrChConfigTypeNonDCH,
                                                 cs_CphyTrchConfigReq_Common_FDD_r11(p_ActTime, v_TrChInfo)));

    // To configure MAC_eHS in Explicit TFRC config mode
    // MAC configure on cellDedicated
    f_UTRAN_CMAC_MACHs_Config(utran_CellDedicated,
                              cas_CMAC_MAChs_TFRC_ExplicitConfigReq_64QAM(utran_CellDedicated, p_ActTime));
                              
    f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD_r10(utran_CellDedicated,
                                                 tsc_HSPDSCH,
                                                 cs_UE_Info,
                                                 cs_TrCHInfoExtension(v_TrChInfo),
                                                 cs_TrLogMappingDL_MAC_eHS));  //Queue id =0
  }

    /*
   * @desc      Modification of SRBs on UL-DPCH (13.6 -> 3.4)
   *            for configurations with HSDPA and SRBs mapped to UL DPCH
   * @param     p_CellId
   * @param     p_ActTime
   * @param     p_DeltaACK          (default value: omit)
   * @param     p_DeltaNACK         (default value: omit)
   * @param     p_ACK_NACK_RepetitionFactor (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_UL_DPCH_ModifySRB_13_6_To_3_4_r11(UTRAN_CellId_Type p_CellId,
                                                  template (value) SS_ActivationTime p_ActTime,
                                                  template (omit) DeltaACK_r11 p_DeltaACK := omit,
                                                  template (omit) DeltaNACK_r11 p_DeltaNACK := omit,
                                                  template (omit) ACK_NACK_repetitionFactor p_ACK_NACK_RepetitionFactor := omit) runs on UTRAN_PTC
  {
    var UL_ScramblingCode v_UL_ScramCodeFDD := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
    var template (value) UL_DPCH_PowerControlInfo_r11 v_UL_DPCH_PowerControlInfo_r11 := cs_UL_DPCH_PowerControlInfo_FDD_r11(p_DeltaACK, p_DeltaNACK, p_ACK_NACK_RepetitionFactor);
    var template (value) CphyUlConnectedTrCHList_Type v_CphyUlConnectedTrCHList := { cs_CphyUlConnectedTrCH_FDD_DCH(tsc_UL_DCH5, cs_DCH_148_TFS_FDD) };
    var template (value) UlConnectedTrCHList_Type v_UlconnectedTrCHList := { cs_UlConnectedTrCH(tsc_UL_DCH5, cs_DCH_148_TFS_FDD) };
    
    var template (value) DPCHInfo_r5OrLater_FDD v_UL_DPCHInfo := cs_DPCHInfo_Extension_FDD(cs_UL_DPCHInfo_r11_Extension_FDD(cs_UL_DPCH_Info_FDD_r11(tsc_UL_DPDCH_SF_SRB,
                                                                                                                                                    pl1,
                                                                                                                                                    v_UL_ScramCodeFDD,
                                                                                                                                                    v_UL_DPCH_PowerControlInfo_r11),
                                                                                                                            cs_HS_DPCCHInfo_r10));
    var template (value) CphyTrchConfigReq v_UL_TrChConfig := cs_CphyTrchConfigReq_UL_TrCh_FDD(p_ActTime, v_CphyUlConnectedTrCHList, cs_TFCS_Cmpl0_1_Rx);
    var template (value) TrCHInfo v_UL_TrCHInfo := cs_TrCHInfo_UL_TrCh_FDD(v_UlconnectedTrCHList, cs_TFCS_Cmpl0_1_Rx);
    var template (value) TrCH_LogCHMappingList1 v_UL_TrLogMapping := cs_TrLogMappingUL_4DCCH;
    
    f_SS_ConfigPS_UL_DPCH1_FDD(p_CellId, v_UL_DPCHInfo, v_UL_TrChConfig, v_UL_TrCHInfo, v_UL_TrLogMapping, p_ActTime);
  }

  /*
   * @desc      Common step to configure RB25 in Flexible mode
   * @param     p_CellId
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_Tw
   * @param     p_Rw
   * @param     p_PollWindow        (default value: pw50)
   * @param     p_TimerStatusProhibit (default value: tsp100)
   * @status    APPROVED (UTRAN)
   */
  function f_SS_RB25_AM_Flexible_Cfg_r11(UTRAN_CellId_Type p_CellId,
                                         template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                         template (value) TransmissionWindowSize p_Tw,
                                         template (value) ReceivingWindowSize p_Rw,
                                         template (value) PollWindow p_PollWindow := pw50,
                                         template (value) TimerStatusProhibit p_TimerStatusProhibit := tsp100) runs on UTRAN_PTC
  {
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_FDD) {
      f_UTRAN_CRLC_Config(cas_CRLC_SetupExtension_FDD(utran_CellDedicated,
                                                      tsc_RB25,
                                                      cds_RB_AM_Info_HE_FDD_r11(cds_DL_AM_RLC_Flexible_r11(p_Rw, p_TimerStatusProhibit),
                                                                                cs_SS_DL_RLC_AM_Mode(omit, cds_UL_AM_RLC_Flexible(p_Tw, p_PollWindow))),
                                                      cs_RB25_LogChMapping,
                                                      p_ActTime));
    }
    else {
      // TDD no MF configuration
      FatalError (__FILE__, __LINE__, "TDD invalid cell configuration");
    }
  }

  /*
   * @desc      returns the RADIO BEARER SETUP for 64k PS for 2AM bearers, depending on the message class
   *            currently only gets r12
   * @param     p_CellId
   * @param     p_Integrityinfo
   * @param     p_Activationtime
   * @param     p_RAB_Id
   * @return    template (value) DL_DCCH_Message
   * @status    APPROVED (UTRAN)
   */
  function f_Get_cs_108_RB_SetUp64k_2AM_PS(UTRAN_CellId_Type  p_CellId,
                                           IntegrityCheckInfo p_Integrityinfo,
                                           ActivationTime     p_Activationtime,
                                           bitstring          p_RAB_Id)
    runs on UTRAN_PTC return template (value) DL_DCCH_Message
  {
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var template (value) DL_DCCH_Message v_RadioBearerSetup;
    var UL_ScramblingCode v_UL_ScramblingCode;
    var PrimaryScramblingCode v_PrimaryScramblingCode;
    var CellParametersID v_CellParametersID;
    
    select (v_FDD_TDD_Mode) {
      case (UTRAN_FDD) {
        v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
        v_PrimaryScramblingCode := f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellId);
        
        select (v_FddTddMessageClass) {
          case (FDDr12) {
            v_RadioBearerSetup := cs_RB_SetUp64k_2AM_PS_FDD_r12(p_Integrityinfo, p_Activationtime, p_RAB_Id, v_UL_ScramblingCode, v_PrimaryScramblingCode);
          }
          case (FDDr14) { //@sic R5-176156 sic@
            v_RadioBearerSetup := cs_RB_SetUp64k_2AM_PS_FDD_r13(p_Integrityinfo, p_Activationtime, p_RAB_Id, v_UL_ScramblingCode, v_PrimaryScramblingCode);
          }
          case (FDDr16) {
            //FDDr16 should use r15 branch but so far no test case is using this message - RadioBearerSetup-r15-IEs
            FatalError(__FILE__, __LINE__, "FDDr15 release not supported for RadioBearerSetup");
          }
          case else {
            FatalError(__FILE__, __LINE__, "FDD release not supported");
          }
        }
      }
      case (UTRAN_TDD) {
        v_CellParametersID := f_UTRAN_CellInfo_GetCellParametersID_TDD(p_CellId);
        
        select (v_FddTddMessageClass) {
          case (TDDr12) {
            v_RadioBearerSetup := cs_RB_SetUp64k_2AM_PS_TDD_r12(p_Integrityinfo, p_Activationtime, p_RAB_Id, v_CellParametersID);
          }
          case (TDDr14) { //@sic R5-176156 sic@
            v_RadioBearerSetup := cs_RB_SetUp64k_2AM_PS_TDD_r13(p_Integrityinfo, p_Activationtime, p_RAB_Id, v_CellParametersID);
          }
          case else {
            FatalError(__FILE__, __LINE__, "TDD release not supported");
          }
        }
      }
    }
    return v_RadioBearerSetup;
  }

  /*
   * @desc      Add a 2nd 64kPS RAB
   * @param     p_CellId
   * @param     p_ActTime
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SS_2DCH_Config_2nd64kPS(UTRAN_CellId_Type p_CellId,
                                           ActivationTime p_ActTime) runs on UTRAN_PTC
  {
    var template (value) SS_ActivationTime v_SS_ActivationTime := cs_ActivateCFN(p_ActTime);
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_FddTddMessageClass := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    var UL_ScramblingCode v_UL_ScramblingCode;
    var template (value) CphyTrchConfigReq      v_UL_TrChConfig_FDD;
    var template (value) CphyTrchConfigReq      v_DL_TrChConfig_FDD;
    var template (value) TrCHInfo               v_UL_TrCHInfo_FDD;
    var template (value) TrCHInfo               v_DL_TrCHInfo_FDD;
    var template (value) TrCH_LogCHMappingList1 v_UL_TrLogMapping_FDD;
    var template (value) TrCH_LogCHMappingList1 v_DL_TrLogMapping_FDD;
    var template (value) CphyTrchConfigReq_TDD  v_UL_TrChConfig_TDD;
    var template (value) CphyTrchConfigReq_TDD  v_DL_TrChConfig_TDD;
    var template (value) TrCHInfo_TDD           v_UL_TrCHInfo_TDD;
    var template (value) TrCHInfo_TDD           v_DL_TrCHInfo_TDD;
    var template (value) TrCH_LogCHMappingList1_TDD v_UL_TrLogMapping_TDD;
    var template (value) TrCH_LogCHMappingList1_TDD v_DL_TrLogMapping_TDD;
    var template (value) DPCHInfo_r5OrLater_FDD v_DL_DPCHInfo_FDD;
    var template (value) DPCHInfo_r5OrLater_FDD v_UL_DPCHInfo_FDD;
    var template (value) DPCHInfo_r5OrLater_TDD v_DL_DPCHInfo_TDD;
    var template (value) DPCHInfo_r5OrLater_TDD v_UL_DPCHInfo_TDD;
    
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      
      v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
      v_DL_TrChConfig_FDD := cs_CphyTrchConfigReq_DL_TrCh_FDD(v_SS_ActivationTime,
                                                              cs_DCH_340_148_DL_Info_FDD,
                                                              cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfoHigher64k));
      v_DL_TrCHInfo_FDD := cs_TrCHInfo_DL_TrCh_FDD(cs_TrChInfoTrCHListDL_340_148_FDD,
                                                   cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfoHigher64k));
      v_UL_TrLogMapping_FDD := cs_TrLogMappingUL_2_Multiplex_PS;
      v_DL_TrLogMapping_FDD := cs_TrLogMappingDL_2_Multiplex_PS;

      select (v_FddTddMessageClass) {
        case (FDDr12) {
          // Configure SS for cell_DCH_64kPS_RAB_SRB configuration
          v_UL_DPCHInfo_FDD := cs_DPCHInfo_Extension_FDD(cs_UL_DPCHInfo_r12_Extension_FDD(cs_UL_DPCH_Info_FDD_r11(tsc_UL_DPDCH_SF_64k_PS,
                                                                                                                  pl0_92,
                                                                                                                  v_UL_ScramblingCode)));
          v_DL_DPCHInfo_FDD := cs_DPCHInfo_Extension_FDD(cs_DL_DPCHInfo_r12_Extension_FDD(cs_DL_DPCH_FDD_r12(cs_DL_CommonInformationRB_SetUp_FDD_r12(tsc_DL_DPCH1_SFP_64k_PS_r12, flexible),
                                                                                                             cs_DL_DPCH_InfoPerRL_SRB_FDD_r12(tsc_DL_DPCH1_ChC_64k_PS),
                                                                                                             tsc_DL_TxPower_DPCH_64k)));
          v_UL_TrChConfig_FDD := cs_CphyTrchConfigReq_Common_FDD(v_SS_ActivationTime,
                                                                 cs_DCH_340_148_UL_Info_FDD,
                                                                 -, -, -, -, -, -, -, -,
                                                                 cs_TrCHInfo_UL_TFCS_r12(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx_r12));
          v_UL_TrCHInfo_FDD := cs_TrCHInfoExtension_ULTFCS_r12(cs_TrChInfoTrCHListUL_340_148_FDD,
                                                               cs_TrCHInfo_UL_TFCS_r12(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx_r12));
        }
        case (FDDr14, FDDr16) { // @sic R5-176156 sic@
          // Configure SS for cell_DCH_64kPS_RAB_SRB configuration
          v_UL_DPCHInfo_FDD := cs_DPCHInfo_Extension_FDD(cs_UL_DPCHInfo_r12_Extension_FDD(cs_UL_DPCH_Info_FDD_r11(tsc_UL_DPDCH_SF_64k_PS,
                                                                                                                  pl0_92,
                                                                                                                  v_UL_ScramblingCode)));
          v_DL_DPCHInfo_FDD := cs_DPCHInfo_Extension_FDD(cs_DL_DPCHInfo_r13_Extension_FDD(cs_DL_DPCH_FDD_r13(cs_DL_CommonInformationRB_SetUp_FDD_r12(tsc_DL_DPCH1_SFP_64k_PS_r12, flexible),
                                                                                                             cs_DL_DPCH_InfoPerRL_SRB_FDD_r12(tsc_DL_DPCH1_ChC_64k_PS),
                                                                                                             tsc_DL_TxPower_DPCH_64k)));
          v_UL_TrChConfig_FDD := cs_CphyTrchConfigReq_Common_FDD(v_SS_ActivationTime,
                                                                 cs_DCH_340_148_UL_Info_FDD,
                                                                 -, -, -, -, -, -, -, -,
                                                                 cs_TrCHInfo_UL_TFCS_r12(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx_r12));
          v_UL_TrCHInfo_FDD := cs_TrCHInfoExtension_ULTFCS_r12(cs_TrChInfoTrCHListUL_340_148_FDD,
                                                               cs_TrCHInfo_UL_TFCS_r12(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx_r12));
        }
        case else {
          FatalError(__FILE__, __LINE__, "FDD release not supported");
        }
      }
      f_SS_ConfigPS_DL_DPCH1_FDD(p_CellId, v_DL_DPCHInfo_FDD, v_DL_TrChConfig_FDD, v_DL_TrCHInfo_FDD, v_DL_TrLogMapping_FDD, v_SS_ActivationTime);
      f_SS_ConfigPS_UL_DPCH1_FDD(p_CellId, v_UL_DPCHInfo_FDD, v_UL_TrChConfig_FDD, v_UL_TrCHInfo_FDD, v_UL_TrLogMapping_FDD, v_SS_ActivationTime);
    
    } else if (v_FDD_TDD_Mode == UTRAN_TDD) {
      // Step 1: Configure a dedicated channel in the UTRAN TDD configuration according to 34.108 cl. 6.11.5.4.1.26
      
      v_UL_TrChConfig_TDD := cs_CphyTrchConfigReq_UL_TrCh_TDD(v_SS_ActivationTime,
                                                              cs_DCH_340_148_UL_Info_TDD,
                                                              cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx);
      v_DL_TrChConfig_TDD := cs_CphyTrchConfigReq_DL_TrCh_TDD(v_SS_ActivationTime,
                                                              cs_DCH_340_148_DL_Info_TDD,
                                                              cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfo_TDD));
      v_UL_TrCHInfo_TDD := cs_TrCHInfo_UL_TrCh_TDD(cs_TrChInfoTrCHListUL_340_148_TDD,
                                                   cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx);
      v_DL_TrCHInfo_TDD := cs_TrCHInfo_DL_TrCh_TDD(cs_TrChInfoTrCHListDL_340_148_TDD,
                                                   cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Tx(cs_PowerOffsetInfo_TDD));
      v_UL_TrLogMapping_TDD := cs_TrLogMappingUL_2_Multiplex_PS_TDD;
      v_DL_TrLogMapping_TDD := cs_TrLogMappingDL_2_Multiplex_PS_TDD;
      
      select (v_FddTddMessageClass) {
        case (TDDr12){
          v_UL_DPCHInfo_TDD := cs_DPCHInfo_Extension_TDD(cs_UL_DPCHInfo_r12_Extension_TDD(cs_UL_DPCH_64k_PS_TDD_r11));
          v_DL_DPCHInfo_TDD := cs_DPCHInfo_Extension_TDD(cs_DL_DPCHInfo_r12_Extension_TDD(cs_DL_DPCH_TDD_r12(cs_DL_DPCH_InfoPerRL_64k_PS_TDD_r12), omit));
        }
        case (TDDr14){
          v_UL_DPCHInfo_TDD := cs_DPCHInfo_Extension_TDD(cs_UL_DPCHInfo_r12_Extension_TDD(cs_UL_DPCH_64k_PS_TDD_r11));
          v_DL_DPCHInfo_TDD := cs_DPCHInfo_Extension_TDD(cs_DL_DPCHInfo_r13_Extension_TDD(cs_DL_DPCH_TDD_r13(cs_DL_DPCH_InfoPerRL_64k_PS_TDD_r12), omit));
        }
        case else {
          FatalError(__FILE__, __LINE__, "TDD release not supported");
        }
      }
      f_SS_ConfigPS_DL_DPCH1_TDD(p_CellId, v_DL_DPCHInfo_TDD, v_DL_TrChConfig_TDD, v_DL_TrCHInfo_TDD, v_DL_TrLogMapping_TDD, v_SS_ActivationTime);
      f_SS_ConfigPS_UL_DPCH1_TDD(p_CellId, v_UL_DPCHInfo_TDD, v_UL_TrChConfig_TDD, v_UL_TrCHInfo_TDD, v_UL_TrLogMapping_TDD, v_SS_ActivationTime);
    }
  }

  /*
   * @desc      Setup radio bearers :  RB22. default values from 34.108  cl. 6.10.2.4.4 and 6.10.2.4.3.3
   * @param     p_CellId
   * @param     p_RLC_Size
   * @param     p_LogChUL           (default value: tsc_UL_DTCH1)
   * @param     p_LogChDL           (default value: tsc_DL_DTCH1)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_SS_RB22_AM_PS_Cfg(UTRAN_CellId_Type p_CellId,
                                     template (value) OctetModeRLC_SizeInfoType1 p_RLC_Size,
                                     template (value) LogicalChannelIdentity p_LogChUL := tsc_UL_DTCH1,
                                     template (value) LogicalChannelIdentity p_LogChDL := tsc_DL_DTCH1) runs on UTRAN_PTC
  { // @sic R5-151992 Extended for r12 sic@
    f_UTRAN_SS_InteractiveBackground_AM_PS_Cfg(p_CellId, tsc_RB22, p_RLC_Size, p_LogChUL, p_LogChDL);
  }

  /*
   * @desc      Function to reconfigure SS from cell_FACH_PS -> cell_DCH_64kPS_RAB_SRB. Other configurations are not supported yet
   *            Similar to ts_SS_reConfFACH_ToDCH in TTCN-2
   * @param     p_CellId
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ReconfigureFACH_ToDCH(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType (p_CellId);
    var UTRAN_FDD_TDD_Type v_FDD_TDD := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UL_ScramblingCode v_UL_ScramblingCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
    
    select (v_CellConfig) {
      case(cell_FACH_PS) {
        f_UTRAN_CRLC_Rel(p_CellId, tsc_RB_BCCH_FACH, v_FDD_TDD);
        if (v_FDD_TDD == UTRAN_FDD) {
          //map PCCH to PCH + map CCCH to FACH
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info,
                                                        cs_TrChInfoPCH_FACH_PS_FDD,
                                                        cs_TrLogMappingPCH_FACH_CellDCH));
          //map CCCH to RACH
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info,
                                                        cs_TrChInfoRACH1_FDD,
                                                        cs_TrLogMappingRACH2));
          //config DPCH DL
          f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_FDD(p_CellId,
                                                          tsc_DL_DPCH1,
                                                          cs_DL_DPCH_FDD(cs_DL_CommonInfoDCH_SRB_FDD(tsc_DL_DPCH1_SFP_64k_PS, //@sic R5s160863 sic@
                                                                                                flexible,
                                                                                                true),
                                                                         tsc_DL_DPCH1_ChC_64k_PS,
                                                                         tsc_DL_DPCH1_2ndScrC,
                                                                         tsc_DL_TxPower_DPCH_64k)));
          
          f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                       tsc_DL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       cs_CphyTrchConfigReq_DL_DCH_336_148_FDD));
          
          f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                                   tsc_DL_DPCH1,
                                                   cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                                   cs_TrChInfoDL_336_148_FDD,
                                                   cs_TrLogMappingDL_4DCCH_1DTCH_PS));
          //config DPCH UL
          f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDD(p_CellId,
                                                          tsc_UL_DPCH1,
                                                          cs_UL_DPCH_Info_FDD(tsc_UL_DPDCH_SF_64k_PS,
                                                                              pl0_96,
                                                                              v_UL_ScramblingCode)));
          
          f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_FDD(p_CellId,
                                                       tsc_UL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       cs_CphyTrchConfigReq_UL_DCH_336_148_FDD));
          
          f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_FDD(utran_CellDedicated,
                                                   tsc_UL_DPCH1,
                                                   cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                                   cs_TrChInfoUL_336_148_FDD,
                                                   cs_TrLogMappingUL_4DCCH_1DTCH(tsc_RB20)));
          
        } else { //TDD
          //map PCCH to PCH + map CCCH to FACH
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(p_CellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info,
                                                        cs_TrChInfoPCH_FACH_PS_TDD,
                                                        cs_TrLogMappingPCH_FACH_CellDCH_TDD));
          //map CCCH to RACH
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(p_CellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info,
                                                        cs_TrChInfoRACH1_TDD,
                                                        cs_TrLogMappingRACH2_TDD));
          //config DPCH DL
          f_UTRAN_CPHY_RL_Setup(cas_DL_DPCH_SetupInfo_TDD(p_CellId,
                                                          tsc_DL_DPCH1,
                                                          cs_DL_DPCH_64k_PS_TDD));
  
          
          f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_TDD(p_CellId,
                                                       tsc_DL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       cs_CphyTrchConfigReq_DL_DCH_336_148_TDD));
          
          f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                                   tsc_DL_DPCH1,
                                                   cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                                   cs_TrChInfoDL_336_148_TDD,
                                                   cs_TrLogMappingDL_4DCCH_1DTCH_PS_TDD));
          //config DPCH UL
          f_UTRAN_CPHY_RL_Setup(cas_UL_DPCH_SetupInfo_FDD(p_CellId,
                                                          tsc_UL_DPCH1,
                                                          cs_UL_DPCH_Info_1TS_TDD(1,
                                                                                  omit,
                                                                                  tfci_bits_16,
                                                                                  pl0_56,
                                                                                  1,
                                                                                  tsc_UL_DPCH1_ChC_64k_PS)));
          
          f_UTRAN_CPHY_TrCH_Config(cas_TrChCfgInfo_TDD(p_CellId,
                                                       tsc_UL_DPCH1,
                                                       cs_TrChConfigTypeDCH_NoSHO,
                                                       cs_CphyTrchConfigReq_UL_DCH_336_148_TDD));
          
          f_UTRAN_CMAC_Config(cas_CMAC_CfgInfo_TDD(utran_CellDedicated,
                                                   tsc_UL_DPCH1,
                                                   cs_UE_Info,                      // C-RNTI and U-RNTI are not needed on DPCH
                                                   cs_TrChInfoUL_336_148_TDD,
                                                   cs_TrLogMappingUL_4DCCH_1DTCH_TDD(tsc_RB20)));
          
        }
        f_UTRAN_CellInfo_SetConfigType (p_CellId, cell_DCH_64kPS_RAB_SRB);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Configuration not supported");
      }
    }
  }

  /*
   * @desc      Function to reconfigure old cell from cell_DCH_64kPS_RAB_SRB -> cell_FACH_NoDedicated, and new cell from cell_NoDPCH -> cell_FACH_PS.
   *            Other configurations are not supported yet
   *            Similar to ts_SS_reConfDCH_ToFACH in TTCN-2
   * @param     p_OldCellId
   * @param     p_NewCellId
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_HO_ReconfDCH_ToFACH(UTRAN_CellId_Type p_OldCellId,
                                         UTRAN_CellId_Type p_NewCellId) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_OldCellId);
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_OldCellId);
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_NewCellId);
    
    select (v_CellConfig) {
      case (cell_DCH_64kPS_RAB_SRB) {
        if (v_FDD_TDD_Mode == UTRAN_FDD) {
          //UL
          f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_UL_DPCH1));
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_OldCellId, tsc_UL_DPCH1, cs_TrChConfigTypeDCH_NoSHO));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_OldCellId, tsc_UL_DPCH1));
          
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_NewCellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info (omit, v_CellInfo.cRNTI),
                                                        cs_TrChInfoRACH1_FDDr99,
                                                        cs_TrLogMappingRACH_DTCH));
          //DL
          f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_DL_DPCH1));
          
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_OldCellId, tsc_DL_DPCH1, cs_TrChConfigTypeDCH_NoSHO));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_OldCellId, tsc_DL_DPCH1));
          
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_NewCellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info (v_CellInfo.uRNTI, v_CellInfo.cRNTI),
                                                        cs_TrChInfoPCH_FACH_PS_FDD,
                                                        cs_TrLogMappingPCH_FACH_PS_FDD));
        }
        else { // TDD
          //UL
          f_UTRAN_CMAC_Config(cas_MAC_TDD_Release(utran_CellDedicated, tsc_UL_DPCH1));
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_TDD(p_OldCellId, tsc_UL_DPCH1, cs_TrChConfigTypeDCH_NoSHO));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_TDD(p_OldCellId, tsc_UL_DPCH1));
          
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(p_NewCellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info (omit, v_CellInfo.cRNTI),
                                                        cs_TrChInfoRACH1_TDD,
                                                        cs_TrLogMappingRACH_DTCH_TDD));
          //DL
          f_UTRAN_CMAC_Config(cas_MAC_TDD_Release(utran_CellDedicated, tsc_DL_DPCH1));
          
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_TDD(p_OldCellId, tsc_DL_DPCH1, cs_TrChConfigTypeDCH_NoSHO));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_TDD(p_OldCellId, tsc_DL_DPCH1));
          
          f_UTRAN_CMAC_Config (cas_CMAC_ReconfigInfo_TDD(p_NewCellId,
                                                         tsc_S_CCPCH1,
                                                         cs_UE_Info (v_CellInfo.uRNTI, v_CellInfo.cRNTI),
                                                         cs_TrChInfoPCH_FACH_PS_TDD,
                                                         cs_TrLogMappingPCH_FACH_PS_TDD));
        }
        f_UTRAN_SS_RB_BCCH_FACH_Cfg(p_NewCellId);
        //f_UTRAN_SS_RB20_AM_PS_Cfg (p_NewCellId, cs_OctetModeRLC_Size336);  @sic R5s160729, R5s160726 sic@
        //f_SS_RB_ConfigurePDCP(p_NewCellId, tsc_RB20); @sic R5s160729, R5s160726 sic@
        
        f_UTRAN_CellInfo_SetConfigType(p_NewCellId, cell_FACH_PS);
        f_UTRAN_CellInfo_SetConfigType(p_OldCellId, cell_FACH_NoDedicated);
          
        //Reconfigure SS with the new C-RNTI
        f_UTRAN_SS_New_CRNTI(p_NewCellId, v_CellInfo.cRNTI);        //@sic R5s160729, R5s160726 sic@
        
      }
      // No other configuration needed up to now
      case else {
        FatalError (__FILE__, __LINE__, "Configuration not handled");
      }
    }
  }

  /*
   * @desc      Function to reconfigure SS from cell_DCH_64kPS_RAB_SRB -> cell_FACH_PS. Other configurations are not supported yet
   *            Similar to ts_SS_reConfDCH_ToFACH in TTCN-2
   * @param     p_CellId
   * @param     p_NewC_RNTI         (default value: omit)
   * @param     p_SS_ActivationTime (default value: cs_ActivateNow)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ReconfigureDCH_ToFACH(UTRAN_CellId_Type p_CellId,
                                           template (omit) C_RNTI p_NewC_RNTI := omit,
                                           template (value) SS_ActivationTime p_SS_ActivationTime := cs_ActivateNow) runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    
    select (v_CellConfig) {
      case(cell_DCH_64kPS_RAB_SRB){
        if (v_FDD_TDD == UTRAN_FDD) {
          //Remove UL DPCH
          f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_UL_DPCH1, p_SS_ActivationTime));    //@sic R5s170071 sic@
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellId, tsc_UL_DPCH1, cs_TrChConfigTypeDCH_NoSHO, p_SS_ActivationTime));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellId, tsc_UL_DPCH1, p_SS_ActivationTime));
          //Reconfig MAC
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info(f_UTRAN_CellInfo_GetU_RNTI(p_CellId), p_NewC_RNTI),
                                                        cs_TrChInfoRACH1_FDD,
                                                        cs_TrLogMappingRACH_DTCH,
                                                        p_SS_ActivationTime));
          //Remove DL DPCH
          f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_DL_DPCH1, p_SS_ActivationTime));    //@sic R5s170071 sic@
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellId, tsc_DL_DPCH1, cs_TrChConfigTypeDCH_NoSHO, p_SS_ActivationTime));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellId, tsc_DL_DPCH1,  p_SS_ActivationTime));
          //Reconfig MAC
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info(f_UTRAN_CellInfo_GetU_RNTI(p_CellId), p_NewC_RNTI),
                                                        cs_TrChInfoPCH_FACH_PS_FDD,
                                                        cs_TrLogMappingPCH_FACH_PS_FDD,
                                                        p_SS_ActivationTime));
        }
        else {
          //Remove UL DPCH
          f_UTRAN_CMAC_Config(cas_MAC_TDD_Release(utran_CellDedicated, tsc_UL_DPCH1, p_SS_ActivationTime));    //@sic R5s170071 sic@
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_TDD(p_CellId, tsc_UL_DPCH1, cs_TrChConfigTypeDCH_NoSHO, p_SS_ActivationTime));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_TDD(p_CellId, tsc_UL_DPCH1, p_SS_ActivationTime));
          //Reconfig MAC
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(p_CellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info(f_UTRAN_CellInfo_GetU_RNTI(p_CellId), p_NewC_RNTI),
                                                        cs_TrChInfoRACH1_TDD,
                                                        cs_TrLogMappingRACH_DTCH_TDD,
                                                        p_SS_ActivationTime));
          //Remove DL DPCH
          f_UTRAN_CMAC_Config(cas_MAC_TDD_Release(utran_CellDedicated, tsc_DL_DPCH1, p_SS_ActivationTime));    //@sic R5s170071 sic@
          f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_TDD(p_CellId, tsc_DL_DPCH1, cs_TrChConfigTypeDCH_NoSHO, p_SS_ActivationTime));
          f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_TDD(p_CellId, tsc_DL_DPCH1, p_SS_ActivationTime));
          //Reconfig MAC
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_TDD(p_CellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info(f_UTRAN_CellInfo_GetU_RNTI(p_CellId), p_NewC_RNTI),
                                                        cs_TrChInfoPCH_FACH_PS_TDD,
                                                        cs_TrLogMappingPCH_FACH_PS_TDD,
                                                        p_SS_ActivationTime));
          
        }
        
        
        f_UTRAN_SS_RB_BCCH_FACH_Cfg(p_CellId);
        f_UTRAN_CellInfo_SetConfigType (p_CellId, cell_FACH_PS);
        
      } case else {
        FatalError(__FILE__, __LINE__, "Configuration not supported");
      }
    }
  }

  /*
   * @desc      To prepare for the hand over in cell_FACH test cases
   *            Reconfigures p_NewCellId from cell_FACH_NoDedicated to cell_FACH_PS
                Reconfigures p_OldCellId from cell_FACH_PS to cell_FACH_NoDedicated
   * @param     p_OldCellId
   * @param     p_NewCellId
   * @param     p_SS_ActivationTime (default value: cs_ActivateNow)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_HO_ReconfFACH_ToFACH(UTRAN_CellId_Type p_OldCellId,
                                          UTRAN_CellId_Type p_NewCellId,
                                          template (value) SS_ActivationTime p_SS_ActivationTime := cs_ActivateNow)
    runs on UTRAN_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_OldCellId);
    
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      f_UTRAN_CRLC_Rel(p_OldCellId, tsc_RB_BCCH_FACH, UTRAN_FDD); //@sic R5s160943 sic@
      
      //map PCCH on PCH and CCCH to FACH
      f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_OldCellId,
                                                    tsc_S_CCPCH1,
                                                    cs_UE_Info,
                                                    cs_TrChInfoPCH_FACH_PS_FDD,
                                                    cs_TrLogMappingPCH_FACH_CellDCH,
                                                    p_SS_ActivationTime));
      //map CCCH to RACH
      f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_OldCellId,
                                                    tsc_PRACH1,
                                                    cs_UE_Info,
                                                    cs_TrChInfoRACH1_FDD,
                                                    cs_TrLogMappingRACH2,
                                                    p_SS_ActivationTime));
      
      //map PCCH to PCH; and BCCH, CCCH, DCCH and DTCH to FACH
      f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_NewCellId,
                                                    tsc_S_CCPCH1,
                                                    cs_UE_Info (f_UTRAN_CellInfo_GetU_RNTI(p_NewCellId), f_UTRAN_CellInfo_GetC_RNTI(p_NewCellId)),
                                                    cs_TrChInfoPCH_FACH_PS_FDD,
                                                    cs_TrLogMappingPCH_FACH_PS_FDD,
                                                    p_SS_ActivationTime));
      //map CCCH, DCCH1, DCCH2, DCCH3, DCCH4 to RACH
      f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_NewCellId,
                                                    tsc_PRACH1,
                                                    cs_UE_Info (omit, f_UTRAN_CellInfo_GetC_RNTI(p_NewCellId)),
                                                    cs_TrChInfoRACH1_FDD,
                                                    cs_TrLogMappingRACH_DTCH,
                                                    p_SS_ActivationTime));
      
      if (f_UTRAN_CellInfo_GetConfigType(p_NewCellId)==cell_FACH_NoDedicated) {
        f_UTRAN_SS_RB_BCCH_FACH_Cfg(p_NewCellId);
      }
      f_UTRAN_CellInfo_SetConfigType (p_NewCellId, cell_FACH_PS);
      f_UTRAN_CellInfo_SetConfigType (p_OldCellId, cell_FACH_NoDedicated);  //@sic R5s170071 sic@
    }
    else{
      FatalError (__FILE__, __LINE__, "Configuration not handled");
    }
  }

  /*
   * @desc      Reconfigures MAC when a new U_RNTI or C_RNTI is assigned to UE. Similar to ts_CMAC_New_RNTI_Reconf in TTCN-2
   * @param     p_CellId
   * @param     p_U_RNTI            can be omit if only a new C-RNTI is assigned
   * @param     p_C_RNTI            (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_CMAC_New_RNTI_Reconf(UTRAN_CellId_Type p_CellId,
                                          template (omit) U_RNTI p_U_RNTI,
                                          template (omit) C_RNTI p_C_RNTI := omit) runs on UTRAN_PTC
  { //@sic R5s160431 sic@
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
      
    if (ispresent(p_C_RNTI)) { //Configure SS to use C-RNTI, and U-RNTI(if present)
      f_UTRAN_CRLC_Config(cas_RB_UM_ReconfigInfo_FDD(utran_CellDedicated,    // Payload size 136 (default)
                                                     tsc_RB1,
                                                     cs_RB_LogCH_Mapping(tsc_UL_DCCH1,
                                                                         tsc_DL_DCCH1)));
      select(v_CellConfig){
        case(cell_FACH, cell_FACH_PS, cell_FACH_NoConn, cell_FACH_NoDedicated) { //@sic R5s170071 sic@
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_PRACH1,
                                                        cs_UE_Info(omit, p_C_RNTI),
                                                        cs_TrChInfoRACH1_FDD,
                                                        cs_TrLogMappingRACH_DTCH));
          f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                        tsc_S_CCPCH1,
                                                        cs_UE_Info(p_U_RNTI, p_C_RNTI),
                                                        cs_TrChInfoPCH_FACH_PS_FDD,
                                                        cs_TrLogMappingPCH_FACH_PS_FDD));
        }
        case else{
          FatalError(__FILE__, __LINE__, "Configuration not handled");
        }
      }
    }
    else { // Configure SS to use U-RNTI, C-RNTI got deleted by UE
      f_UTRAN_CRLC_Config(cas_RB_UM_ReconfigInfo_FDD(utran_CellDedicated,    // Payload size 120
                                                     tsc_RB1,
                                                     cs_RB_LogCH_Mapping(tsc_UL_DCCH1,
                                                                         tsc_DL_DCCH1),
                                                     120));
      f_UTRAN_CMAC_Config(cas_CMAC_ReconfigInfo_FDD(p_CellId,
                                                    tsc_S_CCPCH1,
                                                    cs_UE_Info(p_U_RNTI, omit),
                                                    cs_TrChInfoPCH_FACH_PS_FDD,
                                                    cs_TrLogMappingPCH_FACH_PS_FDD));
    }
  }

}
