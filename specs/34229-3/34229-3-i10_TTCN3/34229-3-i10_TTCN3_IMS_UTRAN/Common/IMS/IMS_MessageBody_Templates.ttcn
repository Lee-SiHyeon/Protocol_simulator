module IMS_MessageBody_Templates {

  import from LibSip_MessageBodyTypes all;
  import from urn_ietf_params_xml_ns_reginfo language "XSD" all;

  template (value) MessageBody cs_MessageBody_RegInfo(template (value) Reginfo p_RegInfo) :=
  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */
  /* @sic R5w230106, R5s230374: Reginfo instead of Reginfo_Type sic@ */
    cs_MessageBody_XML_Bitstring(encvalue(p_RegInfo)); /* @sic R5s130195 BASELINE MOVING 2013 sic@ */

  template (value) MessageBody cs_MessageBody_XML(charstring p_XmlBody) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    xmlBody := p_XmlBody
  };

  template (value) MessageBody cs_MessageBody_XML_Bitstring(bitstring p_Body) := cs_MessageBody_XML(oct2char(bit2oct(p_Body))); /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS) */

}
