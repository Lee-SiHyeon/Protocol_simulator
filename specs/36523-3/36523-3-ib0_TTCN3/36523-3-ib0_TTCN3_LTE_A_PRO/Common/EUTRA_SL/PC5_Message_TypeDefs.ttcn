module PC5_Message_TypeDefs {

  import from CommonDefs all;

  type record PC5_DISCOVERY { /* @status    APPROVED (LTE_A_PRO) */
    /* 24.334 cl 11.2.5 */
    /* Encoding: Tabular notated */
    DiscoveryMessage_Type       MessageType,                /* 24.334 cl 12.2.2.10  M   8 */
    ProSeApplicationCode_Type   ProSeApplicationCode,       /* 24.334 cl 12.2.2.6   M   184 */
    MIC_Type                    MIC,                        /* 24.334 cl 12.2.2.11  M   32 */
    UTC_BasedCounterLSB_Type    UTC_BasedCounterLSB         /* 24.334 cl 12.2.2.22  M   8 */
  };

  type record DiscoveryMessage_Type { /* @status    APPROVED (LTE_A_PRO) */
    /* 24.334 cl 12.2.2.10 */
    B2_Type     DiscoveryType,
    B4_Type     ContentType, /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    B2_Type     DiscoveryModel
  };

  type record UTC_BasedCounterLSB_Type { /* 24.334 cl 12.2.2.22 */
    /* @status    APPROVED (LTE_A_PRO) */
    B4_Type     LSBsUTC_BasedCounterB5To8, /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    B4_Type     LSBsUTC_BasedCounterB0to4  /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
  };

  type B184_Type ProSeApplicationCode_Type;  /* 24.334 cl 12.2.2.6
                                               @status    APPROVED (LTE_A_PRO) */

  type B32_Type  MIC_Type;                   /* 24.334 cl 12.2.2.11
                                               @status    APPROVED (LTE_A_PRO) */

}
