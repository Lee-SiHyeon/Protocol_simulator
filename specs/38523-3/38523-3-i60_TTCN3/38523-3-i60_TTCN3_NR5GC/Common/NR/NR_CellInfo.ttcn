  /*
   * @desc      Sets a value for AllowedIdle_r17 in SIB1 content
   * @param     p_NR_CellId
   * @param     p_EDRX_AllowedIdle_r17 (default value: omit)
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(NR_CellId_Type p_NR_CellId,
                                                    template (omit) SIB1_v1700_IEs.eDRX_AllowedIdle_r17 p_EDRX_AllowedIdle_r17 := omit
                                                    ) runs on NR_BASE_PTC
    {  // @sic R5s230900 sic@
      var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

     if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
         if (not (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension))) {
             f_NR_CellInfo_SetSIB1_v1700_IEs(p_NR_CellId,cs_SIB1_v1700_IEs_Def);
         } // First check to fill up missing contents up to v1710
         //@sic R5s240458 sic@
         v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId); //Get the new stored SIB1 content
         if (isvalue(p_EDRX_AllowedIdle_r17)) {
             v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.eDRX_AllowedIdle_r17 := valueof(p_EDRX_AllowedIdle_r17);
         } else {
             v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.eDRX_AllowedIdle_r17 := omit;
         }
     }
     f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
    }

