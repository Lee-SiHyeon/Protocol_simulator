  template (value) NR_RAR_Msg3FrequencyResourceAllocation_Type cs_NR_RAR_RIV_Length14(integer p_RIV) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Length14 := int2bit(p_RIV, 14)
  };

  template (value) NR_RAR_Msg3FrequencyResourceAllocation_Type cs_NR_RAR_RIV_Length12(integer p_RIV) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
   // To be used for SharedSpectrum condition
    Length12 := int2bit(p_RIV, 12)
  };

  template (value) NR_RAR_UplinkGrant_Type cs_NR_RAR_UplinkGrant(template (value) NR_RAR_Msg3FrequencyResourceAllocation_Type p_RIV_Length, // SharedSpectrum
                                                                 integer p_TimeResourceAllocationIndex,
                                                                 integer p_McsIndex,
                                                                 template (omit) B2_Type p_ChAccess_CPext := omit) := // SharedSpectrum
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    HoppingFlag := '0'B,
    Msg3FrequencyResourceAllocation := p_RIV_Length,
    Msg3TimeResourceAllocation := int2bit(p_TimeResourceAllocationIndex, 4),
    MCS := int2bit(p_McsIndex, 4),
    TPC_Command := int2bit(3, 3),        // 38.213 Table 8.2-2: TPC_Command=3 => Value=0
    CQI_Req := '0'B,
    ChAccess_CPext := p_ChAccess_CPext  //@sic R5w240005, R5w24202r1 sic@
  };

  /*
   * @desc      return UL grant as used for random access response
   * @param     p_UplinkBWP
   * @param     p_TBS               (default value: 256)
   * @param     p_IsSharedSpectrum  (default value: false)
   * @return    template NR_RAR_UplinkGrant_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RAR_UplinkGrant(NR_UplinkBWP_Type p_UplinkBWP,
                                integer p_TBS := 256,
                                boolean p_IsSharedSpectrum := false) // SharedSpectrum condition
    return template (value) NR_RAR_UplinkGrant_Type
  { /* p_TBS=256 according to 38.523-3 clause 7.1.2.3.1.2.1 */
    var integer v_TimeResourceAllocationIndex := 1;  /* 2nd entry of pusch-TimeDomainAllocationList in pusch-ConfigCommon (if any) or 2nd entry of 38.214 Table 6.1.2.1.1-1
                                                        @sic R5-190723 sic@ */
    var BWP_UplinkCommon v_BWP_UplinkCommon := p_UplinkBWP.Common.R15;
    var integer v_BwpSize := f_NR_RIV_GetLength(v_BWP_UplinkCommon.genericParameters.locationAndBandwidth);
    var NR_ResourceAllocation_Type v_ResourceAllocation;
    var integer v_RBstart := 0;
    var integer v_RIV;
    var template (value) NR_RAR_UplinkGrant_Type v_NR_RAR_UplinkGrant; // SharedSpectrum condition

    v_ResourceAllocation := f_NR_ResourceAllocation_UplinkGrant(p_TBS, p_UplinkBWP, v_TimeResourceAllocationIndex, formats0_0_And_1_0);   // RAR UL grant is always as for DCI format 0_0
    v_RIV := f_NR_RIV_Calculate(v_BwpSize, v_ResourceAllocation.Lrbs, v_RBstart);
    
    if(p_IsSharedSpectrum) { // SharedSpectrum condition
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_NR_RAR_UplinkGrant := cs_NR_RAR_UplinkGrant(cs_NR_RAR_RIV_Length12(v_RIV), v_TimeResourceAllocationIndex, v_ResourceAllocation.Imcs, int2bit(2,2)); // ChAccess_CPext:=2 for semiStatic
      }
      else if (pc_ul_DynamicChAccess_r16) {
        v_NR_RAR_UplinkGrant := cs_NR_RAR_UplinkGrant(cs_NR_RAR_RIV_Length12(v_RIV), v_TimeResourceAllocationIndex, v_ResourceAllocation.Imcs, int2bit(3,2)); // ChAccess_CPext:=3 for dynamic, @sic R5-244791 sic@
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
    }
    else { // licensed spectrum (normal case)
      v_NR_RAR_UplinkGrant := cs_NR_RAR_UplinkGrant(cs_NR_RAR_RIV_Length14(v_RIV), v_TimeResourceAllocationIndex, v_ResourceAllocation.Imcs);
    }
    
    return v_NR_RAR_UplinkGrant;
  }

}
