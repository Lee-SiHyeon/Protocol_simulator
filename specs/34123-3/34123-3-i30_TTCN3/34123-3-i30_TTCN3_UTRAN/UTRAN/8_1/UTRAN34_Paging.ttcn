module UTRAN34_Paging {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN_CellInfo all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_RAB_Functions all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 34.123-1 clause 8.1.1.20
   * @status    APPROVED (UTRAN)
   */
  function f_TC_8_1_1_20_UTRAN() runs on UTRAN_PTC
  {
    var SysInfoType21 v_SIB21;
    
    //Initialise UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    // CellA started switched on with default power level
    f_UTRAN34_SS_CreateCellDCH(utran34_CellA);
    
    //Start CellA with configured SIB21 to be modified afer the preamble
    f_UTRAN34_ChangeSysinfoConfiguration(utran34_CellA, configuration9);
    v_SIB21 := f_UTRAN34_SysInfo_GetSIB21(utran34_CellA);
    v_SIB21.eab_Parameters.eab_ParametersForAll.commonEAB_Parameters.eab_AccessClassBarredList := {notBarred, notBarred, notBarred, notBarred, notBarred, notBarred, notBarred, notBarred, notBarred, notBarred};
    f_UTRAN34_SysInfo_SetSIB21(utran34_CellA, v_SIB21);
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_CellA);
    
    // Insert correct USIM containing values acc. to clause 8.1.1.20
    f_UT_USIM_Insert(UT, "34.123-1 clause 8.1.1.20. USIM must be configured for Access Class " & int2char(tsc_AccessClassX));

    //The UE has a valid P-TMSI-1 and RAI-1. MS is Idle Updated on cell A
    f_UTRAN34_Preamble(utran34_CellA, delayTolerantAccess); //@sic R5s170022, R5-171399 sic@
     
    f_UTRAN_TestBody_Set(true);
    
    fl_TC_8_1_1_20_Body();
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell
    f_UTRAN_ReleaseCell(utran34_CellA, f_UTRAN_CellInfo_GetConfigType (utran34_CellA) );
  }

  /*
   * @desc      test body of TC_8_1_1_20
   * @status    APPROVED (UTRAN)
   */
  function fl_TC_8_1_1_20_Body() runs on UTRAN_PTC
  {
    var SysInfoType21 v_SIB21;
    var float v_WaitToReceiveSysInfo := 10.0; //@sic R5s170022, R5-171399 sic@
    var template (value) QualityOfService v_QualityOfService := f_UTRAN_InitialiseQoS(utran34_CellA, cell_DCH_64kPS_RAB_SRB);//@sic R5s170022, R5-171399 sic@
    
    //@siclog "Step 1" siclog@
    //SS set class x barred in EAB information. The SS transmits system information, with IE "EAB Parameters For All" in SIB21.
    //And access class x is barred in IE "common EAB information".
    v_SIB21 := f_UTRAN34_SysInfo_GetSIB21(utran34_CellA);
    v_SIB21.eab_Parameters.eab_ParametersForAll.commonEAB_Parameters.eab_AccessClassBarredList[tsc_AccessClassX] := barred;
    f_UTRAN34_SysInfo_SetSIB21 ( utran34_CellA, v_SIB21);
    f_UTRAN34_SysInfoModifySIB21(utran34_CellA, true); //@sic R5s170022, R5s170902 sic@
     
    //@siclog "Step 1a" siclog@
    //Wait 10 Seconds to ensure UE has read the modified EAB information in SIB21  @sic R5s170022, R5-171399 sic@
    f_Delay(v_WaitToReceiveSysInfo);
      
    //@siclog "Step 1b" siclog@
    //The UE attempts to initiates an Active PDP Context request, by MMI or by AT command. @sic R5s170022, R5-171399 sic@
    f_UT_ActivatePDPContextUG(UT, 1, f_ConvertQoS_ForATCommand(v_QualityOfService)); // @sic R5-192186 sic@
      
    //@siclog "Step 1c" siclog@
    //The SS verifies that the UE does not attempt to access the network (SS wait 30seconds) @sic R5s170022, R5-171399 sic@
    f_UTRAN34_RRC_RandAccFail(30.0);
      
    //@siclog "Steps 2-6" siclog@
    f_UTRAN34_CheckPaging_PS_Service(utran34_CellA, px_PTMSI_Def);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.1.20, Step 3");
  }

}
