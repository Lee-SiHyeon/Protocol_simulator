  template (value) SoundingRS_UL_ConfigDedicated_Type cs_SoundingRS_UL_ConfigDedicated_r8(template (omit) SoundingRS_UL_ConfigDedicated p_SoundingRS_UL_ConfigDedicated,  // @sic R5s160843 sic@
                                                                                          template (omit)  SoundingRS_UL_ConfigDedicated_v1020 p_SoundingRS_UL_ConfigDedicated_v1020 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
