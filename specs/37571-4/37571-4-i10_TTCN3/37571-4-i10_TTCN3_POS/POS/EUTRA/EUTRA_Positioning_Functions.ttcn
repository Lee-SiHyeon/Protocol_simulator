  /*
   * @desc      To check the BDS signals reported by the UE
   * @param     p_GNSS_SgnMeasList
   * @status    APPROVED (POS)
   */
  function f_POS_CheckSignalsBds(GNSS_SgnMeasList p_GNSS_SgnMeasList) runs on EUTRA_PTC
  {// @sic R5s210633 sic@
   var integer i;
   var boolean v_BDS_B1I_Reported := false;
   var boolean v_BDS_B1C_Reported := false;
   var boolean v_BDS_B2a_Reported := false; //@sic R5-230336 sic@
   var boolean v_BDS_B3I_Reported := false; //@sic R5-230336 sic@
   
   for (i:=0; i<lengthof(p_GNSS_SgnMeasList); i:=i+1) {
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(0))) {
       v_BDS_B1I_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(7, (9,10,11)))) {
       v_BDS_B1C_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(7, (12,13,14)))) { //@sic R5-230336 sic@
       v_BDS_B2a_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(3))) { //@sic R5-230336 sic@
       v_BDS_B3I_Reported := true;
     }
   }
   if (not ((v_BDS_B1I_Reported == pc_BDS_B1I) and (v_BDS_B1C_Reported == pc_BDS_B1C) and (v_BDS_B2a_Reported == pc_BDS_B2a) and (v_BDS_B3I_Reported == pc_BDS_B3I))) //@sic R5-230336 sic@
   {
       f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "BDS signals not reported correctly");
   }
  }

}
