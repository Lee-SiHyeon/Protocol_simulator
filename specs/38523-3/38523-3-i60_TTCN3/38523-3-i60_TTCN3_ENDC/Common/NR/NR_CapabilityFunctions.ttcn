  /*
   * @desc      Function to check PICS within MAC_ParametersCommon matching with ifpresent in Rel-16.
   *            PICS shall not be set if it is in a group not signalled by the UE. If there is a mismatch, an inconclusive verdict is raised.
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_OptionalPICS_MAC_ParametersCommon_NR_r16 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg := p_NRCapability;

      if ((not isvalue(v_Received_NRCapabilityMsg.mac_Parameters.mac_ParametersCommon.lch_PriorityBasedPrioritization_r16)) and pc_lch_PriorityBasedPrioritization_r16) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability mac_Parameters.mac_ParametersCommon.lch_PriorityBasedPrioritization_r16 but pc_lch_PriorityBasedPrioritization_r16 is set");
      }

      if ((not isvalue(v_Received_NRCapabilityMsg.mac_Parameters.mac_ParametersCommon.lch_ToGrantPriorityRestriction_r16)) and pc_lch_ToGrantPriorityRestriction_r16) {
          f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling Capability mac_Parameters.mac_ParametersCommon.lch_ToGrantPriorityRestriction_r16 but pc_lch_ToGrantPriorityRestriction_r16 is set");
