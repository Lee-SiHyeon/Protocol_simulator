module MCX_XML_resource_lists {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_ietf_params_xml_ns_resource_lists language "XSD" all;

  type Resource_lists ResourceLists_Type;                                       /* @status    APPROVED (MCX) */

  type ListType.sequence_list ResourceLists_ListSequence_Type;                  /* @status    APPROVED (MCX) */

  type ListType.sequence_list[-] ResourceLists_ListSequenceElement_Type;        /* @status    APPROVED (MCX) */

  template (present) ResourceLists_ListSequenceElement_Type cr_MCX_ResourceLists_List_Sequence_Entry(template (present) XSD.AnyURI p_URI) :=
  { /* @status    APPROVED (MCX) */
    choice := {
      entry := {
        uri := p_URI,
        attr := *,          /* @sic R5s240511 change 15 + R5-245670: * instead of omit sic@ */
        display_name := omit,
        elem_list := {}
      }
    }
  };

  template (present) ListType.sequence_list cr_MCX_ResourceLists_SequenceList_ANYCALL(template (present) XSD.AnyURI p_URI) :=
  { /* @status    APPROVED (MCX) */
    cr_MCX_ResourceLists_List_Sequence_Entry(p_URI)
  };

  template (present) Resource_lists.sequence_list[-] cr_MCX_ResourceLists_Sequence(template (present) ListType.sequence_list p_ResourceLists_SequenceList,
                                                                                   template (present) ListType.elem_list p_Extensions) :=
  { /* @status    APPROVED (MCX) */
    list := {
      name := omit,  // @sic R5-206448 sic@
      attr := omit,
      display_name := omit,
      sequence_list := p_ResourceLists_SequenceList,
      elem_list := p_Extensions
    }
  };

  template (present) ResourceLists_Type cr_MCX_ResourceLists(template (present) ListType.sequence_list p_ResourceLists_SequenceList := {},
                                                             template (present) ListType.elem_list p_Extensions := {}) :=
  { /* 36.579-1 Table 5.5.3.3.1-1: Resource-lists from the UE */
    /* @status    APPROVED (MCX) */
    sequence_list := {
      cr_MCX_ResourceLists_Sequence(p_ResourceLists_SequenceList, p_Extensions)
    }
  };

  template (present) ListType.sequence_list cr_MCX_ResourceLists_SequenceList_FIRST_TO_ANSWER(template (present) XSD.AnyURI p_URI1,
                                                                                              template (present) XSD.AnyURI p_URI2) :=
  { /* @status    APPROVED (MCX) */
    permutation(cr_MCX_ResourceLists_List_Sequence_Entry(p_URI1), cr_MCX_ResourceLists_List_Sequence_Entry(p_URI2))
  };

  template (present) ResourceLists_Type cr_MCX_ResourceLists_ANYCALL(template (present) XSD.AnyURI p_URI) := cr_MCX_ResourceLists(cr_MCX_ResourceLists_SequenceList_ANYCALL(p_URI));    /* @status    APPROVED (MCX) */

  /*
   * @desc      Return Resource-lists from the UE according to 36.579-1 tables 5.5.3.3.1A-1
   * @param     p_ServiceType
   * @param     p_MCSUEID
   * @return    template (present) ResourceLists_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_SequenceList_CONFIG(MCX_ServiceType_Type p_ServiceType,
                                                   charstring p_MCSUEID) return template (present) ResourceLists_Type
  {
    var charstring v_UEConfigURI1     := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, UECONFIG, -, p_MCSUEID);
    var charstring v_UEConfigURI2     := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, UECONFIG);
    var charstring v_UserProfileURI   := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, UEUSERPROF);
    var charstring v_ServiceConfigURI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, UESERVCONFIG);
    var template (present) ListType.sequence_list v_SequenceList;

    v_SequenceList := {
      permutation(cr_MCX_ResourceLists_List_Sequence_Entry((v_UEConfigURI1, v_UEConfigURI2)),   // !!!! PROSE/CORE-SPEC ISSUE: with or without MCSUEID ??? !!!!
                  cr_MCX_ResourceLists_List_Sequence_Entry(v_UserProfileURI),
                  cr_MCX_ResourceLists_List_Sequence_Entry(v_ServiceConfigURI))
    };
    
    return cr_MCX_ResourceLists(v_SequenceList);
  }

  /*
   * @desc      Return Resource-lists entry for Group Coniguration
   * @param     p_ServiceType
   * @return    template (present) ResourceLists_ListSequenceElement_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_List_Sequence_GroupDoc(MCX_ServiceType_Type p_ServiceType) return template (present) ResourceLists_ListSequenceElement_Type
  {
    var charstring v_GroupConfigURI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, GROUPCONFIG);
    return cr_MCX_ResourceLists_List_Sequence_Entry(v_GroupConfigURI);
  }

  /*
   * @desc      Return Resource-lists entry for GKTP
   * @param     p_ServiceType
   * @return    template (present) ResourceLists_ListSequenceElement_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_List_Sequence_GKTP(MCX_ServiceType_Type p_ServiceType) return template (present) ResourceLists_ListSequenceElement_Type
  {
    var charstring v_GKTP_URI := f_MCX_InitialConfiguration_BuildURI(p_ServiceType, resource_lists, GROUPKEY);
    return cr_MCX_ResourceLists_List_Sequence_Entry(v_GKTP_URI);
  }

  /*
   * @desc      Return Resource-lists sequence from the UE according to 36.579-1 tables 5.5.3.3.1-[1..3]
   * @param     p_ServiceType
   * @return    template (present) ListType.sequence_list
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_SequenceList_GroupDocGKTP(MCX_ServiceType_Type p_ServiceType) return template (present) ListType.sequence_list
  {
    var template (present) ResourceLists_ListSequenceElement_Type v_SequenceListEntryGroupDoc := f_MCX_ResourceLists_List_Sequence_GroupDoc(p_ServiceType);
    var template (present) ResourceLists_ListSequenceElement_Type v_SequenceListEntryGKTP     := f_MCX_ResourceLists_List_Sequence_GKTP(p_ServiceType);
    var template (present) ListType.sequence_list v_SequenceList := { permutation(v_SequenceListEntryGroupDoc, v_SequenceListEntryGKTP) };

    return v_SequenceList;
  }

  /*
   * @desc      Return Resource-lists sequence from the UE according to 36.579-1 tables 5.5.3.3.1-[1..3]
   * @param     p_ServiceType
   * @return    template (present) ListType.sequence_list
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_SequenceList_GroupDocOnly(MCX_ServiceType_Type p_ServiceType) return template (present) ListType.sequence_list
  {
    var template (present) ResourceLists_ListSequenceElement_Type v_SequenceListEntryGroupDoc := f_MCX_ResourceLists_List_Sequence_GroupDoc(p_ServiceType);
    var template (present) ListType.sequence_list v_SequenceList := { permutation(v_SequenceListEntryGroupDoc) };

    return v_SequenceList;
  }

  /*
   * @desc      Return Resource-lists sequence from the UE according to 36.579-1 tables 5.5.3.3.1-[1..3]
   * @param     p_ServiceType
   * @return    template (present) ListType.sequence_list
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_SequenceList_GKTP_Only(MCX_ServiceType_Type p_ServiceType) return template (present) ListType.sequence_list
  {
    var template (present) ResourceLists_ListSequenceElement_Type v_SequenceListEntryGKTP := f_MCX_ResourceLists_List_Sequence_GKTP(p_ServiceType);
    var template (present) ListType.sequence_list v_SequenceList := { permutation(v_SequenceListEntryGKTP) };

    return v_SequenceList;
  }

  /*
   * @desc      Encode and ecrypt Resource-lists
   * @param     p_ResourceLists
   * @param     p_MCServiceID
   * @param     p_CSK               (default value: omit)
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_EncodeEncrypt(template (value) Resource_lists p_ResourceLists,
                                             charstring p_MCServiceID ,
                                             template (omit) MCX_SecurityKey_Type p_CSK := omit) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_Bit2Unichar(encvalue(p_ResourceLists));

    if (isvalue(p_CSK)) {   // logging needed only in case of encryption
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
      f_XML_Document_EncryptElementContent(v_XmlDocument, "//resource-lists", p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  /*
   * @desc      Decode Resource-lists
   * @param     charstring
   * @return    ResourceLists_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ResourceLists_Decode(universal charstring p_XsdString) return ResourceLists_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XsdString);
    var Resource_lists v_ResourceLists;

    if (decvalue(v_Bitstring, v_ResourceLists) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode Resource-Lists");
    }
    return v_ResourceLists;
  }

  /*
   * @desc      Element content decryption for Resource-lists
   * @param     charstring          (by reference)
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ResourceLists_DecryptElementContent(inout universal charstring p_XmlDocument,
                                                      charstring p_MCServiceID,
                                                      MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return boolean
  { /* function returns true when either resource-lists or all list elements are (content) encrypted;
       it returns false when neither resource-lists or any list elements are (content) encrypted;
       it raises fail/inconc if some but not all  list elements are (content) encrypted */
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var integer v_NoOfListElements := 0;
    var integer v_NoOfEncryptedListElements := 0;
    var charstring v_XmlPath;
    var integer k;

    v_XmlPath := "//resource-lists";
    v_DecryptResult := f_XML_Document_DecryptElementContent(p_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);

    if (v_DecryptResult == NOT_ENCRYPTED) {
      for (k := 1; v_DecryptResult != NOT_FOUND; k := k + 1) {
        v_XmlPath := "//resource-lists/list[" & int2str(k) & "]";
        v_DecryptResult := f_XML_Document_DecryptElementContent(p_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);
        if (v_DecryptResult != NOT_FOUND) {
          v_NoOfListElements := v_NoOfListElements + 1;
          if (v_DecryptResult == OK) {
            v_NoOfEncryptedListElements := v_NoOfEncryptedListElements + 1;
          }
        }
      }
      if (v_NoOfEncryptedListElements != v_NoOfListElements) {
        if (v_NoOfEncryptedListElements > 0) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Not all list elements are encrypted");
        } else {
          return false;
        }
      }
    }
    return true;
  }

  /*
   * @desc      URI attribute decryption for Resource-lists
   * @param     p_ResourceLists
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    ResourceLists_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ResourceLists_DecryptURIs(ResourceLists_Type p_ResourceLists,
                                            charstring p_MCServiceID,
                                            MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return ResourceLists_Type
  { // NOTE: functions expects all attribute URIs in all list to be encrypted i.e. if there is only one URI not being encrypted it results in a fail/inconc
    var ResourceLists_Type v_ResourceLists := p_ResourceLists;
    var ListType v_List;
    var universal charstring v_URI;
    var integer k;
    var integer i;

    for (k := 0; k < lengthof(v_ResourceLists.sequence_list); k := k + 1) {
      v_List := v_ResourceLists.sequence_list[k].list;
      for (i := 0; i < lengthof(v_List.sequence_list); i := i + 1) {
        if (ischosen(v_List.sequence_list[i].choice.entry)) {
          v_URI := f_MCX_XML_DecryptAttributeUri(v_List.sequence_list[i].choice.entry.uri, p_MCServiceID, p_CSK);
          if (v_URI != "") {
            v_ResourceLists.sequence_list[k].list.sequence_list[i].choice.entry.uri := v_URI;
          } else {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "URI is not encrypted");
          }
        }
      }
    }
    return v_ResourceLists;
  }

  /*
   * @desc      Decrypt and decode Resource-Lists
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    ResourceLists_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ResourceLists_DecryptDecode(XmlBody_Type p_XmlDocument,
                                             charstring p_MCServiceID,
                                             template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return ResourceLists_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var ResourceLists_Type v_ResourceLists;
    var MCX_SecurityKey_Type v_CSK;
    var boolean v_UriEncryption := false;   // will be set if encryption is expected but there is no element content encryption

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      v_CSK := valueof(p_CSK);
      v_UriEncryption := not fl_MCX_ResourceLists_DecryptElementContent(v_XmlDocument, p_MCServiceID, v_CSK);  // v_XmlDocument: inout parameter
    }
    v_ResourceLists := fl_MCX_ResourceLists_Decode(v_XmlDocument);
    if (v_UriEncryption) {                                          // encryption is expected but there is no element content encryption
      v_ResourceLists := fl_MCX_ResourceLists_DecryptURIs(v_ResourceLists, p_MCServiceID, v_CSK);
    }
    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, UPLINK, f_MCX_ResourceLists_EncodeEncrypt(v_ResourceLists, p_MCServiceID));
    }
    return v_ResourceLists;
  }

}
