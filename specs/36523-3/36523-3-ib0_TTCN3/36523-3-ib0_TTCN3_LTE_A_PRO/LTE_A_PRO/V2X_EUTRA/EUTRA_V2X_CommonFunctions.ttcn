module EUTRA_V2X_CommonFunctions {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_CellInfoFrequency all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_Parameters all;
  import from EUTRA_Parameters all;
  import from EUTRA_SL_Component all;
  import from EUTRA_V2X_Component all;
  import from PosSystem_ASP_TypeDefs all;
  import from PosSystem_Control all;
  import from SideLink_CoordMsg all;

  template (value) PositioningScenario_Type cs_SatelliteScenario_V2X(ScenarioNumber_Type p_ScenarioNumber) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    V2X := p_ScenarioNumber
  };

  /*
   * @desc      Function used to get V2X Frequency f1/f2/f3/f4 based on the Frequency band and channel bandwidth as per 36.508 Table 6.2.3.5-1.
   * @param     p_Band
   * @param     p_UL_ChBandwidth
   * @return    Frequency_fList_Type
   * @status    APPROVED (LTE_A_PRO)
   */
 function f_EUTRA_InitFrequencyV2X_Communication(integer  p_Band,
                                                 Ul_Bandwidth_Type  p_UL_ChBandwidth
                                                 ) return Frequency_fList_Type
  {
    var template (value) Frequency_fList_Type v_Freq := cs_FrequencyInitDummy;

    // As per 36.508 Table 6.2.3.5-1 and Table 4.3.1.2.15-1
    select (p_Band){
      case (47) {   // Band 47
        select (p_UL_ChBandwidth){
          case (n50){  // ChBandwidth = 10
            v_Freq.f1.ul_CarrierFreq_r9 := 54890; //Mid  -> f5
            v_Freq.f2.ul_CarrierFreq_r9 := 55190; //High -> f6
            v_Freq.f3.ul_CarrierFreq_r9 := 54590; //low  -> f7
            }
          case (n100){  // ChBandwidth = 20
            v_Freq.f1.ul_CarrierFreq_r9 := 54890; //Mid  -> f5
            v_Freq.f2.ul_CarrierFreq_r9 := 55140; //High -> f6
            v_Freq.f3.ul_CarrierFreq_r9 := 54640; //low  -> f7
            }
          case else{
            FatalError (__FILE__, __LINE__, "invalid ChannelBandwidth");
            }
        }
      }
      case else{
        FatalError (__FILE__, __LINE__, "Invalid E-UTRA V2X Communication Band");
      }
    }
    return valueof(v_Freq);

    }

  /*
   * @desc      Send out of coverage info to the V2X Sidelink PTC - only for FDD = TDD subframe configuration 1
   * @param     p_DL_Bandwidth      (default value: px_eSecondaryBandChannelBandwidth)
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_V2X_SendOutOfConverageInfo(Dl_Bandwidth_Type p_DL_Bandwidth := px_eSecondaryBandChannelBandwidth) runs on EUTRA_SL_PTC
  {
    var Ul_Bandwidth_Type  v_UL_ChBandwidth := f_ConvertDL_BandwidthToUL(p_DL_Bandwidth);
    var Frequency_fList_Type v_Freq := f_EUTRA_InitFrequencyV2X_Communication(px_eSecondaryFrequencyBand, v_UL_ChBandwidth);
    var EUTRA_FDD_TDD_Mode_Type v_EUTRA_FDD_TDD_Mode := TDD;

    if (f_EUTRA_FrequencyBandIsFDD(px_eSecondaryFrequencyBand)){
        v_EUTRA_FDD_TDD_Mode := FDD;
    }
    f_SideLink_SendCoordMsg(SIDELINK, cms_SideLink_OutOfCoverageInfo(v_Freq.f1.ul_CarrierFreq_r9, v_UL_ChBandwidth, v_EUTRA_FDD_TDD_Mode));
  }

  /*
   * @desc      Objective: To load the required pre-defined V2X GNSS test scenario
   *            and start generating GNSS signals in the positioning simulator
   * @param     p_PosSystemListId
   * @param     p_Scenario
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_V2X_StartPositioningSimulatorEUTRA(PositioningSystemList_Type p_PosSystemListId, integer p_Scenario) runs on EUTRA_V2X_PTC
  {
    f_PosSystem_LoadScenario(POSSYS, p_PosSystemListId, cs_SatelliteScenario_V2X(p_Scenario));
    f_PosSystem_Start(POSSYS, p_PosSystemListId);
  }

  /*
   * @desc      Objective: To stop generating GNSS signals in the positioning simulator
   * @param     p_PosSystemListId
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_V2X_StopPositioningSimulatorEUTRA(PositioningSystemList_Type p_PosSystemListId) runs on EUTRA_V2X_PTC
  {
    f_PosSystem_Stop(POSSYS, p_PosSystemListId);
  }

  /*
   * @desc      Objective: To trigger the GNSS simulator to start moving to the next area/zone in the scenario
   * @param     p_PosSystemListId
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_V2X_TriggerMovePositioningSimulatorEUTRA(PositioningSystemList_Type p_PosSystemListId) runs on EUTRA_V2X_PTC
  {
    f_PosSystem_TriggerMove(POSSYS, p_PosSystemListId);
  }

}
