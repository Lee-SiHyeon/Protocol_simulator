module WLAN_Component {

  import from CommonDefs all;
  import from CommonIratDefs all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from UpperTesterPtcToMtcDefs all;
  import from WLAN_ASP_TypeDefs all;
  import from WLAN_CellInfo all;

  type enumerated WLAN_Default_Enum_Type {StandardDefault}; /* @status    APPROVED (IMS) */

  type record WLAN_Ctrl_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    default                     Default,
    boolean                     TestBody
  };

  type record WLAN_Global_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    WLAN_Ctrl_Type              Ctrl,
    WLAN_CellInfoArray_Type     CellArray,
    integer                    XRES_Length optional
  };

  type component WLAN_PTC { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    var  WLAN_Global_Type          vc_WLAN_Global;

    port UT_PTC_MTC_PORT           UT;
      
    port IRAT_CO_ORD_PORT          NR;  //@sic R5w220023 sic@
    port IRAT_CO_ORD_PORT          EUTRA;
    port IRAT_CO_ORD_PORT          UTRAN;
    port IP_RAT_CTRL_PORT          IP;   /* @sic R5w160107 sic@ */
    
    port IMS_IPCAN_CO_ORD_PORT     IMS[tsc_NoOfIMSPDNs];   /* @sic R5-163201 sic@ @sic R5s201177: tsc_NoOfIMSPDNs instead of tsc_NoOfPDNs sic@ */
    
    port WLAN_AP_SYSTEM_PORT       SYS;
    port WLAN_AP_SYSCMD_IND_PORT   SYS_CMDIND;
    
    port WLAN_ePDG_SYSTEM_PORT     SYS_EPDG;
    port WLAN_ePDG_SYSCMD_IND_PORT SYS_EPDG_CMDIND;
  };

  type component WLAN_SYSTEM { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    port WLAN_AP_SYSTEM_PORT          W_SYS;
    port WLAN_AP_SYSCMD_IND_PORT      W_SYS_CMDIND;
    
    port WLAN_ePDG_SYSTEM_PORT        W_SYS_EPDG;
    port WLAN_ePDG_SYSCMD_IND_PORT    W_SYS_EPDG_CMDIND;
  };

  /*
   * @desc      Map WLAN's system ports
   * @param     p_System
   * @param     p_WLAN
   * @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT)
   */
  function f_WLAN_PTC_Map(WLAN_SYSTEM p_System,
                          WLAN_PTC p_WLAN)
  {
    //AP
    map(p_WLAN:SYS,        p_System:W_SYS);
    map(p_WLAN:SYS_CMDIND, p_System:W_SYS_CMDIND);
    
    //EPDG
    map(p_WLAN:SYS_EPDG,        p_System:W_SYS_EPDG);
    map(p_WLAN:SYS_EPDG_CMDIND,    p_System:W_SYS_EPDG_CMDIND);
    
  }

  /*
   * @desc      standard default behaviour
   * @status    APPROVED (IMS)
   */
  altstep a_WLAN_StandardDefault() runs on WLAN_PTC
  {
    [] SYS_CMDIND.receive{
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected receive event at SYS_CMDIND port");
    }
    [] SYS.receive {
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected receive event at SYS port");
    }
    [] SYS_EPDG_CMDIND.receive{
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected receive event at SYS_EPDG port");
    }
    [] SYS_EPDG.receive {
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected receive event at SYS port");
    }
    [] any timer.timeout {
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected timeout");
    }
  }

  /*
   * @desc      to activate the standard default behaviour
   * @param     p_Default
   * @status    APPROVED (IMS)
   */
  function f_WLAN_ActivateDefault(WLAN_Default_Enum_Type p_Default) runs on WLAN_PTC
  {
    deactivate(vc_WLAN_Global.Ctrl.Default);
    
    select (p_Default) {
      case (StandardDefault) {
        vc_WLAN_Global.Ctrl.Default := activate(a_WLAN_StandardDefault());
      }
      case else {
        FatalError (__FILE__, __LINE__, "unknown default behaviour");
      }
    }
  }

  /*
   * @desc      check whether test body is active
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_WLAN_TestBody_Check() runs on WLAN_PTC return boolean
  {
    return vc_WLAN_Global.Ctrl.TestBody;
  }

  /*
   * @desc      set correct verdict: FAIL is assigned only when being in the test body else inconclusive
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (IMS)
   */
  function f_WLAN_SetVerdictFailOrInconc(charstring p_FileName,
                                         LineNo_Type p_LineNo,
                                         charstring p_Msg) runs on WLAN_PTC
  {
    if (fl_WLAN_TestBody_Check()) {
      f_SetVerdict(fail, p_FileName, p_LineNo, p_Msg);
    } else {
      f_SetVerdict(inconc, p_FileName, p_LineNo, p_Msg);
    }
    self.kill;  // => testcase will terminate immediately
  }

  /*
   * @desc      set correct verdict: prelininary PASS is only be assigned when being in the test body
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (IMS)
   */
  function f_WLAN_PreliminaryPass(charstring p_FileName,
                                  LineNo_Type p_LineNo,
                                  charstring p_Msg) runs on WLAN_PTC
  {
    if (fl_WLAN_TestBody_Check()) {
      f_SetVerdict(pass, p_FileName, p_LineNo, p_Msg);
    }
  }

  /*
   * @desc      initialisation of the WLAN PTC
   * @param     p_ConfiguredPTCs
   * @param     p_SimulatedAPs      (default value: cs_WLAN_SimulatedAPList_Def)
   * @status    APPROVED (IMS)
   */
  function f_WLAN_Init(IRAT_ConfiguredPTCs_Type p_ConfiguredPTCs, template (value) WLAN_APList_Type p_SimulatedAPs := cs_WLAN_SimulatedAPList_Def) runs on WLAN_PTC
  {// @sic R5w200302 sic@ extended function to suppoort WLAN multi AP environment
    vc_WLAN_Global.Ctrl.Default := null;
    vc_WLAN_Global.Ctrl.TestBody := false;
    vc_WLAN_Global.CellArray := f_WLAN_CellArray_Init(p_SimulatedAPs);
    
    // Now initialize sys info, together with EUTRA inter RAT parameters, for all cells
    select (p_ConfiguredPTCs) {
      case (EUTRA_WLAN) {
        f_IRAT_InitialCoOrd(EUTRA, cs_CoOrd_WLANSysInfo(tsc_WLAN_SSID_AP1));
      }
      case (UTRAN_WLAN) {
        f_IRAT_InitialCoOrd(UTRAN, cs_CoOrd_WLANSysInfo(tsc_WLAN_SSID_AP1));
      }
      case (NR5GC_WLAN) {
        f_IRAT_InitialCoOrd(NR, cs_CoOrd_WLANSysInfo(tsc_WLAN_SSID_AP1));  //@sic R5w220023 sic@
      }
      case (WLAN_Only) {
        // nothing to be done
      }
      case else {
        FatalError (__FILE__, __LINE__, "wrong PTC configuration specified in test case");
      }
    }
    f_WLAN_ActivateDefault(StandardDefault);
  }

  /*
   * @desc      get info of cell with given index (p_CellId)
   * @param     p_CellId
   * @return    WLAN_CellInfo_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_Get(WLAN_CellId_Type p_CellId) runs on WLAN_PTC return WLAN_CellInfo_Type
  {
    var integer v_Index := f_WLAN_CellInfo_GetIndex(p_CellId);
    return vc_WLAN_Global.CellArray[v_Index];
  }

  /*
   * @desc      set cell info for given cell
   * @param     p_CellId
   * @param     p_CellInfo
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_Set(WLAN_CellId_Type p_CellId,
                               WLAN_CellInfo_Type p_CellInfo) runs on WLAN_PTC
  {
    var integer v_Index := f_WLAN_CellInfo_GetIndex(p_CellId);
    vc_WLAN_Global.CellArray[v_Index] := p_CellInfo;
  }

  /*
   * @desc      to get Cell Power BeaconRRSSI of WLAN Cell
   * @param     p_CellId
   * @return    WLAN_InitialCellPower_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_GetCellPower(WLAN_CellId_Type p_CellId) runs on WLAN_PTC return WLAN_InitialCellPower_Type
  {
    var WLAN_CellInfo_Type v_CellInfo := f_WLAN_CellInfo_Get(p_CellId);
    return v_CellInfo.ReferencePower.InitialBeaconRSSI;
  }

  /*
   * @desc      Assign the parameterised Attenuation in the WLAN_CellInfo_Type
   * @param     p_CellId
   * @param     p_ReferenceCellPower
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_SetCellPower(WLAN_CellId_Type p_CellId,
                                        WLAN_BeaconRSSI_Type  p_ReferenceCellPower) runs on WLAN_PTC
  {
    var WLAN_CellInfo_Type v_CellInfo := f_WLAN_CellInfo_Get(p_CellId);
    
    v_CellInfo.ReferencePower.InitialBeaconRSSI.BeaconRSSI  := p_ReferenceCellPower;
    f_WLAN_CellInfo_Set (p_CellId, v_CellInfo);
  }

  /*
   * @desc      to get AP Parameters of WLAN Cell
   * @param     p_CellId
   * @return    WLAN_AP_Parameters_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_GetAP_Parameters(WLAN_CellId_Type p_CellId) runs on WLAN_PTC return WLAN_AP_Parameters_Type
  {
    var WLAN_CellInfo_Type v_CellInfo := f_WLAN_CellInfo_Get(p_CellId);
    return v_CellInfo.WLAN_AP_Parameters;
  }

  /*
   * @desc      to get XRES length for WLAN
   * @return    integer
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_GetXRES_Length() runs on WLAN_PTC return integer
  {
    return vc_WLAN_Global.XRES_Length;
  }

  /*
   * @desc      to store XRES length for WLAN
   * @param     p_XRES_Length
   * @status    APPROVED (IMS)
   */
  function f_WLAN_CellInfo_SetXRES_Length(integer p_XRES_Length) runs on WLAN_PTC
  {
    vc_WLAN_Global.XRES_Length := p_XRES_Length;
  }

}
