  /*
   * @desc      Return SSB_MTC stored in SIB2 or in cell array
   * @param     p_NR_CellId
   * @return    SSB_MTC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSSB_MTC(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SSB_MTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var SSB_MTC v_SSB_MTC;

    if ((v_NR_CellInfo.Sysinfo.NR_SysinfoCombination !=  MibOnly) and (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != NR_1)){
      v_SSB_MTC := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib2.intraFreqCellReselectionInfo.smtc;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
    } else {
      v_SSB_MTC := v_NR_CellInfo.PhysicalParameters.SSB_MTC;
    }
    return v_SSB_MTC;
  }

  /*
   * @desc      Return si-SchedulingInfo value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @return    SI_SchedulingInfo
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB1_SiSchedulingInfo(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SI_SchedulingInfo
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (not isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.si_SchedulingInfo)) {
      FatalError(__FILE__, __LINE__, "SIB1 not found");
    }
    return v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.si_SchedulingInfo;
  }

  /*
   * @desc      Return si-SchedulingInfo-v1700 value stored in SIB1 in the cell array. Return omit if the field is not included.
   * @param     p_NR_CellId
   * @return    template (omit) SI_SchedulingInfo_v1700
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB1_SiSchedulingInfo_v1700(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) SI_SchedulingInfo_v1700
  { //@sic R5-235415 sic@
    var template (omit) SI_SchedulingInfo_v1700 v_SI_SchedulingInfo_v1700 := omit;
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1700)) {
      v_SI_SchedulingInfo_v1700 := v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1700;
    }
    return v_SI_SchedulingInfo_v1700;
  }

  /*
   * @desc      Return posSI-SchedulingInfo-r16 value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @return    PosSI_SchedulingInfo_r16
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB1_PosSiSchedulingInfo(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return PosSI_SchedulingInfo_r16
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (not isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.posSI_SchedulingInfo_r16)) {
      FatalError(__FILE__, __LINE__, "SIB1 not found");
    }
    return v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.posSI_SchedulingInfo_r16;
  }

