  template (value) MCPTT_UEConfiguration_Type cs_MCPTT_UEConfiguration :=
  { /* 36.579-1 Table 5.5.8.2-1: MCPTT UE Configuration Defaults
       @status    APPROVED (MCX) */
    instance_ID_URN := omit,
    xUI_URI := omit,
    domain := px_MCX_DomainName_Organization_A,   // @sic R5-200385 sic@
    attr := omit,
    choice_list := {},
    common := {
      index := omit,
      attr := omit,
      private_call := {
        max_Simul_Call_N10 := 2
      },
      mCPTT_Group_Call := {
        max_Simul_Call_N4 := 3,
        max_Simul_Trans_N5 := 5,
        prioritized_MCPTT_Group := {
          mCPTT_Group_Priority_list := {
            cs_MCPTT_Group_Priority(px_MCPTT_Group_A_ID, 7)
          }
        }
      },
      anyExt := omit,
      elem_list := {}
    },
    on_network := {
      index := omit,
      attr := omit,
      iPv6Preferred := false,
      relay_Service := true,
      relayed_MCPTT_Group_list := {
        cs_Relayed_MCPTT_Group(px_MCPTT_Group_A_ID, "123456")
      },
      anyExt := omit,
      elem_list := {}
    },
    anyExt := omit,
    elem_list := {}
  };

  /*
   * @desc      Encode MCPTT UE configuration document
   * @param     p_MCPTT_UEConfiguration
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_UEConfiguration_Encode(template (value) urn_3gpp_mcptt_mcpttUEConfig_1_0.Mcptt_UE_configuration p_MCPTT_UEConfiguration) return bitstring
  {
    return encvalue(p_MCPTT_UEConfiguration);
  }

