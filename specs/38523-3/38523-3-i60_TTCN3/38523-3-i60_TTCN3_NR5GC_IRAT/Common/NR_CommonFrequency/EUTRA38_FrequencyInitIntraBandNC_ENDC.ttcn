module EUTRA38_FrequencyInitIntraBandNC_ENDC {

  import from CommonDefs all;
  import from EUTRA_CellInfoFrequency all;

  function f_EUTRA38_InitFrequenciesIntraBandNC ( integer p_EUTRA_Band ) return template (value) Frequency_fList_Type
  {
    var template (value) Frequency_fList_Type v_FrequencyList := cs_FrequencyInitDummy;
    select(p_EUTRA_Band) {
      case( 2 ) {
        //@sic R5-241580 R5-241705 sic@
        v_FrequencyList.f1.dl_CarrierFreq := 1100 ;
        v_FrequencyList.f1.ul_CarrierFreq := 19100 ;
      }
      case( 41 ) {
        //@sic R5-197982 R5s200122 R5-201021 sic@
        v_FrequencyList.f1.dl_CarrierFreq := 41490 ;
        v_FrequencyList.f1.ul_CarrierFreq := 41490 ;
      }
      case( 66 ) {
        //@sic R5-241580 R5-241705 sic@
        v_FrequencyList.f1.dl_CarrierFreq_v9e0 := 67036 ;
        v_FrequencyList.f1.ul_CarrierFreq_v9e0 := 132572 ;
        v_FrequencyList.f1.dl_CarrierFreq := tsc_EUTRA_MaxEARFCN;
        v_FrequencyList.f1.ul_CarrierFreq := tsc_EUTRA_MaxEARFCN;
      }
    }
    // Assign UL EARFCN to omit for TDD mode
    if (not(f_EUTRA_FrequencyBandIsFDD(p_EUTRA_Band))) {
      // TDD mode UL EARFCN = DL EARFCN
      v_FrequencyList.f1.ul_CarrierFreq := omit;
      v_FrequencyList.f2.ul_CarrierFreq := omit;
      v_FrequencyList.f3.ul_CarrierFreq := omit;
      v_FrequencyList.f1.ul_CarrierFreq_v9e0 := omit;
      v_FrequencyList.f2.ul_CarrierFreq_v9e0 := omit;
      v_FrequencyList.f3.ul_CarrierFreq_v9e0 := omit;
    }
  v_FrequencyList := f_SetCarrierFreq_r9 (v_FrequencyList, p_EUTRA_Band);
  return v_FrequencyList;
 }

}
