module Idle_SNPNOnly_Selection_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.5.1.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_5_1_1_NR5GC() runs on NR5GC_PTC
  {// SNPN Selection in Manual Mode
    f_NR5GC_Init(NR_12);

    // Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell4, -78, -82); // @sic R5-233323 sic@

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);
    f_NR_CellConfig_Def(nr_Cell4);

    f_UT_SwitchOnUE(UT);
    f_UT_ProvideSubscriberDataList(UT, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell2)), 2);
    f_UT_ProvideSubscriberDataList(UT, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell4)), 4);
    f_UT_ClearRegisteredSNPN_Select(UT);
    f_UT_ManualSNPN_Select(UT,
                           f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell2)),
                           2,
                           CNF_REQUIRED);
    f_UT_SwitchOffUE(UT, false);

    // Preamble: Ensure that the UE has cleared the Registered SNPN and the UE is in state Switched OFF (state 0-A)
    f_NR5GC_Preamble(nr_Cell2, STATE_OFF_0A);

    f_NR_TestBody_Set(true);

    f_TC_6_5_1_1_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell4, STATE_IDLE_1A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.5.1.1
   * @status    APPROVED (NR5GC)
   */
   function f_TC_6_5_1_1_NR5GC_TestBody() runs on NR5GC_PTC
   { // @sic R5-221533,R5-233323 sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT3;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT4;
    var float v_Wait60s := 60.0;

    v_CellPowerList_AtT1:={
    cs_NR_CellPower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2),
    cs_NR_CellPower(nr_Cell2, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
    cs_NR_CellPower(nr_Cell4, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };

    v_CellPowerList_AtT2:={
    cs_NR_CellPower(nr_Cell2, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };

    v_CellPowerList_AtT3:={
    cs_NR_CellPower(nr_Cell4, -78, tsc_NR_ServingCellSSS_EPRE_FR2)
    };

    v_CellPowerList_AtT4:={
    cs_NR_CellPower(nr_Cell2, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };

    // @siclog "Step 1" siclog@
    // SS adjusts cell levels according to row T1 of table 6.5.1.1.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    // @siclog "Step 2" siclog@
    // The UE is Switched ON
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 3" siclog@
    // Manual selection of SNPN identified by NR Cell 1 is performed
    f_UT_ManualSNPN_Select(UT,
                           f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell1)),
                           1,
                           CNF_REQUIRED);

    // @siclog "Step 4" siclog@
    // Check: Does the UE transmit an RRCSetupRequest on NR Cell 1 within the next 60 s
    f_NR_CheckNoRRCSetupReq(nr_Cell1, v_Wait60s, -, "Step4: UE sent an RRCSetupRequest on NR Cell 1 within 60 s");

    // @siclog "Step 5" siclog@
    // SS adjusts cell levels according to row T2 of table 6.5.1.1.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);

    // @siclog "Step 6" siclog@
    // Manual selection of SNPN identified by NR Cell 2 is performed
    f_UT_ManualSNPN_Select(UT,
                           f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell2)),
                           2,
                           CNF_REQUIRED);

    // @siclog "Step 7" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 2
    f_NR_RRC_SetupRequest_Def(nr_Cell2);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.5.1.1 Step 7");

    // @siclog "Step 8 - 25a1" siclog@
    // Steps 3-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed on NR Cell 2
    f_NR5GC_RRC_Idle_Steps3_20(nr_Cell2, TESTMode_OFF, -, Initial_NoSecurity);

    // @siclog "Step 26" siclog@
    // SS adjusts cell levels according to row T3 of table 6.5.1.1.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT3);

    // @siclog "Step 27" siclog@
    // Check: Does the UE transmit an RRCSetupRequest on NR Cell 4 within the next 60 s
    f_NR_CheckNoRRCSetupReq(nr_Cell4, v_Wait60s, -, "Step27: UE sent an RRCSetupRequest on NR Cell 4 within 60 s");

    // @siclog "Step 28" siclog@
    // SS adjusts cell levels according to row T4 of table 6.5.1.1.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT4);

    // @siclog "Step 29" siclog@
    // The user sets the UE in Automatic SNPN/Network selection mode
    f_UT_AutomaticSNPN_Select(UT);

    // @siclog "Step 30" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 4
    f_NR_RRC_SetupRequest_Def(nr_Cell4);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.5.1.1 Step 30");

    // @siclog "Step 31 - 48a1" siclog@
    // Steps 3-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed on NR Cell 4
    f_NR5GC_RRC_Idle_Steps3_20(nr_Cell4, TESTMode_OFF, -, Initial_NoSecurity);
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.5.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_5_1_2_NR5GC() runs on NR5GC_PTC
  {// SNPN Selection in Automatic Mode
    f_NR5GC_Init(NR_12);

    f_NR_CellInfo_SetSIB1_SNPN_Id(nr_Cell1, 2, 1); // @sic R5s250324, R5-254152 sic@

    // Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell3, -78, -82); // @sic R5-233323 sic@

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);
    f_NR_CellConfig_Def(nr_Cell3);

    f_UT_SwitchOnUE(UT);
    f_UT_ProvideSubscriberDataList(UT, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell1)), 1);
    f_UT_ProvideSubscriberDataList(UT, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell3)), 3);
    f_UT_ClearRegisteredSNPN_Select(UT);
    f_UT_AutomaticSNPN_Select(UT);
    f_UT_SwitchOffUE(UT, false);

    // Preamble: Ensure that the UE has cleared the Registered SNPN and the UE is in state Switched OFF (state 0-A)
    f_NR5GC_Preamble(nr_Cell1, STATE_OFF_0A);

    f_NR_TestBody_Set(true);

    f_TC_6_5_1_2_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.5.1.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_6_5_1_2_NR5GC_TestBody() runs on NR5GC_PTC
   {  // @sic R5-225303,R5-233323,R5s250484 sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT3;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (nr_Cell1);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var float v_Wait60s := 60.0;
    var integer v_AssignmentMode := 2;

    v_CellPowerList_AtT1:={
    cs_NR_CellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
    cs_NR_CellPower(nr_Cell2, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2),
    cs_NR_CellPower(nr_Cell3, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };

    v_CellPowerList_AtT2:={
    cs_NR_CellPower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };

    v_CellPowerList_AtT3:={
    cs_NR_CellPower(nr_Cell2, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
    cs_NR_CellPower(nr_Cell3, -78, tsc_NR_ServingCellSSS_EPRE_FR2)
    };

    // @siclog "Step 1" siclog@
    // SS adjusts cell levels according to row T1 of table 6.5.1.2.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    // @siclog "Step 2" siclog@
    // The UE is Switched ON
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 3" siclog@
    // Check: Does the UE transmit an RRCSetupRequest on NR Cell 2 within the next 60 s
    f_NR_CheckNoRRCSetupReq(nr_Cell2, v_Wait60s, -, "Step3: UE sent an RRCSetupRequest on NR Cell 2 within 60 s");

    // @siclog "Step 4" siclog@
    // SS adjusts cell levels according to row T2 of table 6.5.1.2.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);

    // @siclog "Step 5" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.5.1.2 Step 5");

    // @siclog "Step 6 - 23a1" siclog@
    // Steps 3-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed on NR Cell 1
    f_NR_RRCSetup_Def(nr_Cell1);
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_20(v_GMM_MobilityInfo, nr_Cell1, v_ReceivedMsg, TESTMode_OFF, noRrcConnectionRelease, Initial_NoSecurity,-,-,-,-,v_AssignmentMode);

    // @siclog "Step 24" siclog@
    // The UE is switched off by executing generic procedure in Table 4.9.6.3-1 in TS 38.508-1
    f_NR_UE_DeRegisterOnSwitchOff(nr_Cell1, STATE_CONNECTED_3A);

    // @siclog "Step 25" siclog@
    // SS adjusts cell levels according to row T3 of table 6.5.1.2.3.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT3);

    // @siclog "Step 26" siclog@
    // The UE is Switched ON
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 27" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.5.1.2 Step 27");

    // @siclog "Step 28 - 34" siclog@
    // Steps 3-9 of Table 4.5.2.2-2 in TS 38.508-1 are performed on NR Cell 1
    f_NR_RRCSetup_Def (nr_Cell1);
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_9_AKA(v_GMM_MobilityInfo, nr_Cell1, v_ReceivedMsg, v_PLMN, Initial_NoSecurity, -, v_AssignmentMode);

    // @siclog "Step 35" siclog@
    // The SS transmits a REGISTRATION REJECT with cause #75 (Permanently not authorized for this SNPN)
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, '01001011'B)))));

    // @siclog "Step 36" siclog@
    // The SS releases the RRC connection
    f_NR_RRCRelease(nr_Cell1);

    // @siclog "Step 37" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 3
    f_NR_RRC_SetupRequest_Def(nr_Cell3);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.5.1.2 Step 37");

    // @siclog "Step 38 - 55a1" siclog@
    // Steps 3-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed on NR Cell 3
    f_NR5GC_RRC_Idle_Steps3_20(nr_Cell3, TESTMode_OFF, -, Initial_NoSecurity);

    // @siclog "Step 56" siclog@
    // The generic test procedure in TS 38.508-1 Table 4.9.6.1-1 of Switch off procedure in RRC_IDLE are performed
    f_NR_UE_DeRegisterOnSwitchOff(nr_Cell3, STATE_IDLE_1A);

    // @siclog "Step 57" siclog@
    // The SS configures:
    // - NR Cell 1 as the "Serving cell"
    // - NR Cell 3 as a "Non-Suitable "off" cell "
    f_NR_SetCellPower(nr_Cell3, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 58" siclog@
    // The UE is brought back to operation or the USIM is inserted. The UE is powered on or switched on
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 59" siclog@
    // The UE is made to perform manual SNPN search and select SNPN identified by NR Cell 1
    f_UT_ManualSNPN_Select(UT,
                           f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(nr_Cell1)),
                           1,
                           CNF_REQUIRED);

    // @siclog "Step 60 - 78a1" siclog@
    // Steps 2 to 20a1 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2 are performed on NR Cell 1
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas(nr_Cell1, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg(v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_20(v_GMM_MobilityInfo, nr_Cell1, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity,-,-,-,-,v_AssignmentMode);

    // @siclog "Step 79" siclog@
    // The user sets the UE in Automatic SNPN/Network selection mode
    f_UT_AutomaticSNPN_Select(UT);
   }

}
