module IMS_SDP_Messages {

  import from CommonDefs all;
  import from CommonIP all;
  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_SDP_Templates all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;

  type enumerated SDP_Message_Check_Type {asPreviousSDP, newSDP, sameOriginAsPreviousSDP};      /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  const boolean tsc_SDP_WithPreconditions := true;                                              /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  /*
   * @desc      Wrapper function to encode SDP message
   * @param     p_SDP_Message
   * @return    charstring
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
   
  function f_IMS_SDP_Message_Encode(template (value) SDP_Message p_SDP_Message) return charstring
  {
    var bitstring v_BitStr := encvalue(p_SDP_Message);
    return oct2char(bit2oct(v_BitStr));
  }

  /*
   * @desc      Wrapper function to decode SDP message and to assign fail verdict in case of syntactically wrong SDP message
   * @param     p_SdpBody
   * @return    SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_Message_Decode(SdpBody p_SdpBody) runs on IMS_PTC return SDP_Message
  {
    var SDP_Message v_SDP_Message;
    var bitstring v_BitStr := oct2bit(char2oct(p_SdpBody));
    var integer v_Result := decvalue(v_BitStr, v_SDP_Message);

    if (v_Result != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid SDP message");
    }
    return v_SDP_Message;
  }

  /*
   * @desc      check that 'Connections' is included either at the top level or in the media description(s) or in both
   * @param     p_SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_CheckConnections(SDP_Message p_SDP_Message) runs on IMS_PTC
  {
    var boolean v_ConnectionFound := false;
    var integer i;

    if (ispresent(p_SDP_Message.connection)) {
      v_ConnectionFound := true;
    }

    if (not v_ConnectionFound) {
      // no connection specified in session description => there shall be at least one connection per media description
      v_ConnectionFound := true;
      for (i := 0; i < lengthof(p_SDP_Message.media_list); i := i + 1) {
        if (not ispresent(p_SDP_Message.media_list[i].connections)) {                   // @sic R5s130586 change 12 sic@
          if ((p_SDP_Message.media_list[i].media_field.ports.port_number != 0)) {       /* @sic R5-221481, R5-221482, R5-247609: c=line of removed video stream shall not be checked sic@
                                                                                           @sic R5-260280: at release of the video stream, if there is no c= line in the session description there shall be a c= line in the media description for audio sic@*/
            v_ConnectionFound := false;
            break;
          }
        }
      }
    }

    if (not v_ConnectionFound) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "'Connections found neither in session description nor in media description");
    }
  }

  /*
   * @desc      Wrapper function to decode and match SDP message
   * @param     p_SdpBody
   * @param     p_SDP_Message_Template
   * @param     p_SdpCheck          (default value: newSDP)
   * @param     p_CheckContent      (default value: true)
   * @return    SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SIP_DecodeMatchAndCheckSDP(template (omit) SdpBody p_SdpBody,
                                            template SDP_Message p_SDP_Message_Template,
                                            SDP_Message_Check_Type p_SdpCheck := newSDP,
                                            boolean p_CheckContent := true) runs on IMS_PTC return SDP_Message
  { /* @sic R5-150702: generic check of origin sic@ */
    /* @sic R5-162931: p_CheckConnections replaced by p_CheckContent sic@ */
    var SDP_Message v_SDP_Message;
    var template (omit) SDP_Message v_PrevSdpMessage;
    var integer v_PrevSessionVersion;
    var template SDP_Origin v_ExpectedOrigin := *;
    
    if (not ispresent(p_SdpBody)) {                             /* there is no SDP message */
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Missing sdpMessageBody");
    }
    else {                                                      /* => MessageBody is present and contains an SDP message */
      v_SDP_Message := f_IMS_SDP_Message_Decode(valueof(p_SdpBody));
      if (not match(v_SDP_Message, p_SDP_Message_Template)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "received sdpMessageBody does not match");
      }

      /* @sic R5-150702: sic@ */
      v_PrevSdpMessage := f_IMS_PTC_ImsInfo_DialogGetPrevSdpMessageRX();
      select (p_SdpCheck) {          /* @sic R5-150702 sic@ */
        case (asPreviousSDP) {       /* current SDP shall be identically as previous SDP (i.e. even the session version has to be the same) */
          if (not match(v_SDP_Message, v_PrevSdpMessage)) {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "received SDP message is different than previous one");
          }
        }
        case (newSDP) {
          if (p_CheckContent) {      /* @sic R5-162931: p_CheckConnections replaced by p_CheckContent sic@ */
            f_IMS_SDP_CheckConnections(v_SDP_Message);
            if (ispresent(v_PrevSdpMessage)) {
              if (not match(v_SDP_Message, v_PrevSdpMessage)) { /* @sic R5s150497: SDP may be the same as previous SDP sic@
                                                                   NOTE: whether or not it shall be allowed to have the same SDP depends on the given template */
                v_PrevSessionVersion := str2int(valueof(v_PrevSdpMessage.origin.session_version));
                v_ExpectedOrigin := v_PrevSdpMessage.origin;
                v_ExpectedOrigin.session_version := int2str(v_PrevSessionVersion + 1);
                
                if (not match(v_SDP_Message.origin, v_ExpectedOrigin)) { /* @sic R5-143201, R5-151684 sic@ */
                  f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "session version not incremented or o-line changed");
                }
              }
            }
          }
          f_IMS_PTC_ImsInfo_DialogSetPrevSdpMessageRX(v_SDP_Message);
        }
        case (sameOriginAsPreviousSDP) {   /* @sic R5-192318 sic@ */
          if (not match(v_SDP_Message.origin, v_PrevSdpMessage.origin)) {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "received SDP message has different origin than previous one");
          }
        }
      }
    }
    return v_SDP_Message;
  }

  /*
   * @desc      wrapper function to decode and match optional SDP message
   * @param     p_MessageBody
   * @param     p_SDP_Message_Template
   * @return    template (omit) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SIP_SdpMessageBody_DecodeMatchAndCheckSDP_Ifpresent(template (omit) MessageBody p_MessageBody,
                                                                     template SDP_Message p_SDP_Message_Template) runs on IMS_PTC return template (omit) SDP_Message
  {
    var template (omit) SdpBody v_SdpBody := omit;
    var SDP_Message v_SDP_Message;
    
    if (ischosen(p_MessageBody.sdpMessageBody)) {           /* there is an SDP message */
      v_SdpBody := p_MessageBody.sdpMessageBody;
    }
    if (not ispresent(v_SdpBody) and not ispresent(p_SDP_Message_Template)) {     /* NOTE:
                                                                                     not ispresent(p_SDP_Message_Template) does not mean that p_SDP_Message_Template is omit
                                                                                     but p_SDP_Message_Template can be e.g. "cr_SomeSDP ifpresent"
                                                                                     nevertheless when we have "not ispresent(p_SDP_Message_Template)" the SDP message may be omitted */
      return omit;
    } else {
      v_SDP_Message := f_IMS_SIP_DecodeMatchAndCheckSDP(v_SdpBody, p_SDP_Message_Template);
      return v_SDP_Message;
    }
  }

  /*
   * @desc      wrapper function to decode and match SDP message
   * @param     p_MessageBody
   * @param     p_SDP_Message_Template
   * @return    SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SIP_SdpMessageBody_DecodeMatchAndCheckSDP(template (omit) MessageBody p_MessageBody,
                                                           template (present) SDP_Message p_SDP_Message_Template) runs on IMS_PTC return SDP_Message
  {
    var template (omit) SDP_Message v_SDP_Message := f_IMS_SIP_SdpMessageBody_DecodeMatchAndCheckSDP_Ifpresent(p_MessageBody, p_SDP_Message_Template);
    return valueof(v_SDP_Message);
  }

  /*
   * @desc      build SDP message to be sent as response to an offer e.g. at the end of C.21 or C.8
   *            the function does
   *            "IP address on "c=" lines and transport port on "m=" lines changed to indicate to which IP address and port the UE should send the media"
   *            "o-line as in preceding SDP sent by SS, but with sess-version being incremented"
   * @param     p_SDP_Message_PrevOffer
   * @param     p_SessionVersion    (default value: omit)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_CommonResponseToOfferTX(template (value) SDP_Message p_SDP_Message_PrevOffer,
                                                  template (omit) charstring p_SessionVersion := omit) runs on IMS_PTC return template (value) SDP_Message
  {
    var integer i;
    var charstring v_AddrType := f_IMS_PTC_NW_Address_GetTypeStr();
    var charstring v_IPAddrOrigin := f_IMS_PTC_RemoteAddress_GetAddrStr();
    var IntegerList_Type v_IMS_MediaPortList := {tsc_IMS_MediaPort_M1, tsc_IMS_MediaPort_M2, tsc_IMS_MediaPort_M3};
    var template (value) SDP_Message v_SDP_Message := p_SDP_Message_PrevOffer;
    var template (value) SDP_media_desc_list v_Media_Desc_List := valueof(p_SDP_Message_PrevOffer.media_list);  // "valueof" as media_list is optional
    var template (value) SDP_connection v_SDP_Connection := cs_SDP_Connection(v_AddrType, v_IPAddrOrigin);
    var template (value) SDP_media_desc v_SDP_Media_Desc;
    var charstring v_SessionVersion;
    var charstring v_SessionId := f_IMS_PTC_ImsInfo_DialogGetSessIdTX();   /* @sic R5-150707 sic@ */

    if (ispresent(p_SessionVersion)) {
      v_SessionVersion := valueof(p_SessionVersion);
    } else {
      v_SessionVersion := f_IMS_PTC_ImsInfo_DialogIncrAndGetSessVersionTX();
    }

    v_SDP_Message.origin := cs_SDP_Origin(-, v_SessionId, v_SessionVersion, v_AddrType, v_IPAddrOrigin); // @sic R5s141244: "o=" line sic@
    v_SDP_Message.connection := v_SDP_Connection;                                                        // IP address on "c=" line

    for (i:=0; i < lengthof(v_Media_Desc_List); i:=i+1) {
      v_SDP_Media_Desc := v_Media_Desc_List[i];
      if (not match(0, v_SDP_Media_Desc.media_field.ports.port_number)) {                                // @sic R5-183097: if the UE has sent the SDP offer with port=0, the port has to be 0 in the answer too sic@
        v_SDP_Media_Desc.media_field.ports.port_number := v_IMS_MediaPortList[i];
      }
      v_SDP_Media_Desc.connections := { v_SDP_Connection };                                              // IP address on "c=" line
      v_Media_Desc_List[i] := v_SDP_Media_Desc;
    }
    v_SDP_Message.media_list := v_Media_Desc_List;
    return v_SDP_Message;
  }

  /*
   * @desc      exchange attribute in all media streams of the given media list
   * @param     p_Media_Desc_List
   * @param     p_AttributeToBeChanged
   * @param     p_NewAttribute
   * @param     p_AddIfNotPresent    (default value: false)
   * @return    template (omit) SDP_media_desc_list
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaList_ExchangeAttribute(template (omit) SDP_media_desc_list p_Media_Desc_List,
                                                 template (present) SDP_attribute p_AttributeToBeChanged,
                                                 template (value) SDP_attribute p_NewAttribute,
                                                 boolean p_AddIfNotPresent := false) return template (omit) SDP_media_desc_list
  { /* @sic R5s180229: p_AddIfNotPresent sic@ */
    var template (omit) SDP_media_desc_list v_Media_Desc_List := p_Media_Desc_List;
    var integer i;
    
    if (ispresent(p_Media_Desc_List)) {
      for (i:=0; i < lengthof(v_Media_Desc_List); i:=i+1) {
        if (f_SDP_AttributeList_CheckAttribute(v_Media_Desc_List[i].attributes, p_AttributeToBeChanged)) { /* @sic R5s180229 sic@ */
          v_Media_Desc_List[i].attributes := f_SDP_ExchangeAttribute(v_Media_Desc_List[i].attributes, p_AttributeToBeChanged, p_NewAttribute);
        }
        else if (p_AddIfNotPresent) { /* @sic R5s180229 sic@ */
          v_Media_Desc_List[i].attributes := f_SDP_Attributes_Add_TX(v_Media_Desc_List[i].attributes, p_NewAttribute);
        }
      }
    }
    return v_Media_Desc_List;
  }

  /*
   * @desc      Copy Attributes for ECN Capability from the SDP offer sent by the UE
   * @param     p_SDP_MediaDescription_Offer
   * @param     p_SDP_Attribute_List
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaAttributes_CopyEcnCapabilityAttributesTX(SDP_media_desc p_SDP_MediaDescription_Offer,
                                                                   template (omit) SDP_attribute_list p_SDP_Attribute_List) return template (omit) SDP_attribute_list
  {
    var template (omit) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List;
    var template (value) SDP_attribute_list v_AdditionalOptionalAttributes;
    var template (omit) SDP_attribute v_Attribute;
    var integer i;
    
    // a=ecn-capable-rtp: leap; ect=0 [C.21 step 4 Note 3]
    // a=rtcp-fb:* nack ecn [C.21 step 4 Note 3]
    // a=rtcp-xr:ecn-sum [C.21 step 4 Note 3]
    v_AdditionalOptionalAttributes := {    /* @sic R5s140359 - Additional Changes sic@ */
      cs_SDP_Attribute_ecn_capable_rtp("leap", "ect=0"),
      cs_SDP_Attribute_rtcp_fb("*", "nack ecn"),
      cs_SDP_Attribute_rtcp_xr("ecn-sum")
    };
    for (i := 0; i < lengthof(v_AdditionalOptionalAttributes); i := i + 1) {
      v_Attribute := f_SDP_AttributeList_GetAttribute(p_SDP_MediaDescription_Offer.attributes, v_AdditionalOptionalAttributes[i]);    // f_SDP_AttributeList_GetAttribute returns omit if attribute is not contained in the offer
      v_SDP_Attribute_List := f_SDP_Attributes_Add_TX(v_SDP_Attribute_List, v_Attribute);                                             // => nothing gets added to list if v_Attribute==omit
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      add Attributes for media security mechanism if the use of end-to-access-edge security is supported by UE
   * @param     p_SDP_Attribute_List
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaAttributes_AddMediaSecurityAttributesTX(template (omit) SDP_attribute_list p_SDP_Attribute_List) return template (omit) SDP_attribute_list
  {
    var template (omit) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List;

    if (pc_IMS_E2ae) {
      v_SDP_Attribute_List := f_SDP_Attributes_Add_TX(v_SDP_Attribute_List, cs_SDP_Attribute_3ge2ae("requested"));
      v_SDP_Attribute_List := f_SDP_Attributes_Add_TX(v_SDP_Attribute_List, cs_SDP_Attribute_crypto("1", "AES_CM_128_HMAC_SHA1_80", "inline:PS1uQCVeeCFCanVmcjkpPywjNWhcYD0mXXtxaVBR|2^20|1:4"));
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      add Attributes for media security mechanism if the use of end-to-access-edge security is supported by UE
   * @param     p_SDP_Attribute_List
   * @return    template (present) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaAttributes_AddMediaSecurityAttributesRX(template (present) SDP_attribute_list p_SDP_Attribute_List) return template (present) SDP_attribute_list
  {
    var template (present) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List;

    if (pc_IMS_E2ae) {
      v_SDP_Attribute_List := f_SDP_Attributes_Add_RX(v_SDP_Attribute_List, cr_SDP_Attribute_3ge2ae);
      v_SDP_Attribute_List := f_SDP_Attributes_Add_RX(v_SDP_Attribute_List, cr_SDP_Attribute_crypto_sha1_80);
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      generic function to build up SDP message
   * @param     p_TimeDescription           (default value: cr_SDP_Time_0_0)
   * @param     p_SDP_Media_Field
   * @param     p_SDP_MediaAttributes       (default value: {})
   * @param     p_PreconditionAttributes    (default value: {})
   * @param     p_Media_Desc_BandwidthList  (default value: *)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_RX_AnyBW(template (present) SDP_time p_TimeDescription := cr_SDP_Time_0_0,
                                   template (present) SDP_media_field p_SDP_Media_Field,
                                   template (present) SDP_attribute_list p_SDP_MediaAttributes := {},
                                   template (present) SDP_attribute_list p_PreconditionAttributes := {},
                                   template SDP_bandwidth_list p_Media_Desc_BandwidthList := *) runs on IMS_PTC return template (present) SDP_Message
  { /* @sic R5s150704, R5s150751 - additional changes: new parameters p_MediaBW_AS, p_MediaBW_RS, p_MediaBW_RR sic@ */
    var charstring v_AddrType := f_IMS_PTC_NW_Address_GetTypeStr();
    var template (present) charstring v_IPAddrOrigin := ?;
    var template (present) charstring v_IPAddrConnection := ?;
    var template (present) SDP_attribute_list v_MandatoryAttributes := f_SDP_Attributes_Concat_RX(p_SDP_MediaAttributes, p_PreconditionAttributes);
    var template SDP_attribute_list v_SDP_Attribute_List;
    var template (present) SDP_media_desc v_SDP_Media_Desc;
    var template (present) SDP_media_desc_list v_SDP_Media_Desc_List;

    v_SDP_Attribute_List := f_SDP_Attributes_Superset(v_MandatoryAttributes); // @sic R5s220396: f_SDP_Attributes_Superset sic@

    v_SDP_Media_Desc := cr_SDP_Media_Desc(p_SDP_Media_Field,
                                          cr_SDP_Connection(v_AddrType, v_IPAddrConnection),
                                          p_Media_Desc_BandwidthList,
                                          v_SDP_Attribute_List);
    v_SDP_Media_Desc_List := { v_SDP_Media_Desc };
    
    return cr_SDP_Message_Common(-, v_AddrType, v_IPAddrOrigin, v_IPAddrConnection, -, p_TimeDescription, v_SDP_Media_Desc_List);
  }

  /*
   * @desc      generic function to build up SDP message
   * @param     p_TimeDescription           (default value: cr_SDP_Time_0_0)
   * @param     p_SDP_Media_Field
   * @param     p_SDP_MediaAttributes       (default value: {})
   * @param     p_PreconditionAttributes    (default value: {})
   * @param     p_MediaBW_AS        (default value: ?)
   * @param     p_MediaBW_RS        (default value: ?)
   * @param     p_MediaBW_RR        (default value: ?)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_RX(template (present) SDP_time p_TimeDescription := cr_SDP_Time_0_0,
                             template (present) SDP_media_field p_SDP_Media_Field,
                             template (present) SDP_attribute_list p_SDP_MediaAttributes := {},
                             template (present) SDP_attribute_list p_PreconditionAttributes := {},
                             template (present) integer p_MediaBW_AS := ?,
                             template (present) integer p_MediaBW_RS := ?,
                             template (present) integer p_MediaBW_RR := ?) runs on IMS_PTC return template (present) SDP_Message
  { /* @sic R5s150704, R5s150751 - additional changes: new parameters p_MediaBW_AS, p_MediaBW_RS, p_MediaBW_RR sic@ */
    var template SDP_bandwidth_list v_Media_Desc_BandwidthList := cr_SDP_Bandwidth_List_Media(p_MediaBW_AS, p_MediaBW_RS, p_MediaBW_RR);
    var template (present) SDP_Message v_SDP_Message;
    
    if (f_SDP_SDP_Media_Field_IsForMediaRelease(p_SDP_Media_Field)) {           /* @sic R5s150704, R5s150751 - additional changes; sic@
                                                                                   @sic R5-247609: use of f_SDP_SDP_Media_Field_IsForMediaRelease instead of f_SDP_SDP_Media_Desc_BandwidthListRX sic@ */
      v_Media_Desc_BandwidthList := *;
    }
    v_SDP_Message := f_IMS_BuildSDP_RX_AnyBW(p_TimeDescription, p_SDP_Media_Field, p_SDP_MediaAttributes, p_PreconditionAttributes, v_Media_Desc_BandwidthList);    /* @sic R5s190727 change 2.1: MCX split sic@ */

    return v_SDP_Message;
  }

  /*
   * @desc      generic function to build up SDP message
   * @param     p_Media
   * @param     p_MediaBandwidth_List
   * @param     p_SDP_MediaAttributes
   * @param     p_PreconditionAttributes (default value: omit)
   * @param     p_SessionBandwidthAS (default value: omit)
   * @param     p_ConnectionInSessionDesc (default value: true)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_TX(template (value) SDP_media_field p_Media,
                             template (omit) SDP_bandwidth_list p_MediaBandwidth_List,
                             template (omit) SDP_attribute_list p_SDP_MediaAttributes,
                             template (omit) SDP_attribute_list p_PreconditionAttributes := omit,
                             template (omit) integer p_SessionBandwidthAS := omit,
                             boolean p_ConnectionInSessionDesc := true) runs on IMS_PTC return template (value) SDP_Message
  {
    var charstring v_SessionId := f_IMS_PTC_ImsInfo_DialogGetSessIdTX();   /* @sic R5-150707 sic@ */
    var charstring v_SessionVersion := f_IMS_PTC_ImsInfo_DialogIncrAndGetSessVersionTX();
    var template (omit) SDP_attribute_list v_SDP_Attribute_List := f_SDP_Attributes_Concat_TX(p_SDP_MediaAttributes, p_PreconditionAttributes);
    var charstring v_AddrType := f_IMS_PTC_NW_Address_GetTypeStr();
    var charstring v_IPAddrConnection := f_IMS_PTC_RemoteAddress_GetAddrStr();
    var charstring v_IPAddrOrigin := v_IPAddrConnection;
    var template (omit) SDP_connection v_SDP_Connection := cs_SDP_Connection(v_AddrType, v_IPAddrConnection);
    var template (omit) SDP_connection v_SDP_ConnectionInSession := omit;
    var template (omit) SDP_connection_list v_SDP_ConnectionListInMedia := omit;
    var template (omit) SDP_bandwidth_list v_SessionBandwidthList := omit;
    var template (value) SDP_media_desc_list v_SDP_Media_Desc_List;
    var integer v_SessionBandwidthAS;
    var template (value) SDP_Message v_SDP_Message;

    if (isvalue(p_SessionBandwidthAS)) {
      v_SessionBandwidthList := cs_SDP_Bandwidth_List_AS(valueof(p_SessionBandwidthAS));
    } else if (isvalue(p_MediaBandwidth_List)) {  /* @sic R5s150704, R5s150751 - Additional changes: p_MediaBandwidth_List may be omit sic@ */
      v_SessionBandwidthAS := f_SDP_BandwidthList_GetBandwidth(valueof(p_MediaBandwidth_List), "AS");
      v_SessionBandwidthList := cs_SDP_Bandwidth_List_AS(v_SessionBandwidthAS);
    }
    
    if (p_ConnectionInSessionDesc) {
      v_SDP_ConnectionInSession := v_SDP_Connection;
    } else {
      v_SDP_ConnectionListInMedia := { v_SDP_Connection };
    }
    v_SDP_Media_Desc_List := { cs_SDP_Media_Desc(p_Media, p_MediaBandwidth_List,  v_SDP_Attribute_List, v_SDP_ConnectionListInMedia) };

    v_SDP_Message := cs_SDP_Message_Common(cs_SDP_Origin(-, v_SessionId, v_SessionVersion, v_AddrType, v_IPAddrOrigin), /* Session description - o=line */
                                           -,                                                                           /* Session name - s=line */
                                           v_SDP_ConnectionInSession,                                                   /* Session description - c=line */
                                           v_SessionBandwidthList,                                                      /* Session description - b=line */
                                           -,                                                                           /* Time description    - t=line */
                                           v_SDP_Media_Desc_List);                                                      /* Media description */
    
    f_IMS_PTC_ImsInfo_DialogSetPrevSdpMessageTX(v_SDP_Message);                                                         /* @sic R5-225427, R5-225258 sic@ */

    return v_SDP_Message;
  }

  /*
   * @desc      Build SDP record to be sent to the UE at step 1 according to 34.229-1 Annex C.11 or Annex C.45
   * @param     p_AudioCodecList
   * @param     p_EvsConfiguration (default value: NO_EVS)
   * @param     p_PreconditionsRequired (default value: true)
   * @param     p_RemoteResourcesReservedAlready (default value: false)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_InitialOfferAudio_TX(IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                               SDP_EVS_Configuration_MTCallSetup_Type p_EvsConfiguration := NO_EVS,
                                               boolean p_PreconditionsRequired := true,
                                               boolean p_RemoteResourcesReservedAlready := false)
    runs on IMS_PTC
    return template (value) SDP_Message
  { /* @sic R5s141244: use of f_IMS_BuildSDP_TX sic@ */
    /* @sic R5-153610: "sendrecv" media attribute removed from SDP message for C.11 step 7 sic@ */
    /* @sic R5-153798: p_SDP_Message183 replacing p_SDP_Attribute_curr_qos_remote and p_Step; p_IsC45 sic@ */
    /* @sic R5-153798, R5s150841: split of f_IMS_BuildSDP_AnnexC11_Step1or7, parameter p_AdditionalAudioCodecs for C.45 sic@ */
    /* @sic R5-169060: allow no preconditions sic@ */
    /* @sic R5-173535: p_AudioCodecList instead of p_AdditionalAudioCodecs sic@ */
    /* @sic R5-191731: p_RemoteResourcesReservedAlready sic@ */
    /* @sic R5-231489: p_EvsConfiguration sic@ */
    /* @sic R5-243985: NO_EVS instead of EVS_A2 as default for p_EvsConfiguration sic@ */
    var template (value) IMS_SDP_MediaDescriptionRtpList_Type v_MediaDescriptionRtpList;
    var template (value) SDP_bandwidth_list v_MediaBandwidth_List;
    var template (omit) SDP_attribute_list v_PreconditionAttributes;
    var boolean v_IsWLAN := f_IMS_PTC_RanTypeIsWLAN();  /* @sic R5-171477 sic@ */

    if (p_AudioCodecList[0] != EVS_16000) {                               /* @sic R5-173535: check of first element rather than any list of additional codecs sic@ */
      v_MediaBandwidth_List := cs_SDP_Bandwidth_List_Media(37, 0, 2000);  /* media bandwidth acc. to C.11 @sic R5-130751; R5-134270: RR=2500; R5-144700: AS=37; R5-172126: RR=2000 sic@ */

    } else {
      v_MediaBandwidth_List := cs_SDP_Bandwidth_List_Media(65, 0, 2000);  /* media bandwidth acc. to C.45 INVITE (Step 1) */
    }

    v_MediaDescriptionRtpList := f_SDP_MediaDescriptionInitialOfferAudioTX(p_AudioCodecList, p_EvsConfiguration); /* @sic R5-172930 sic@ @sic R5-165942 sic@ */

    if ((p_RemoteResourcesReservedAlready and p_PreconditionsRequired) or /* @sic R5-191731: test case 12.13a sic@ */
        (v_IsWLAN and p_PreconditionsRequired)) {                         /* @sic R5-171477 - WLAN Annex C.11a sic@ */
      v_PreconditionAttributes := cs_SDP_PreconditionAttributes(c_sendrecv, c_none, c_mandatory, c_optional);  /* @sic R5s180162 sic@ @sic R5-153798: usage of cs_SDP_PreconditionAttributes sic@ */
    } else if (p_PreconditionsRequired) {                                 /* Annex C.11, C.11b, C.45 */
      v_PreconditionAttributes := cs_SDP_PreconditionAttributes(c_none, c_none, c_mandatory, c_optional);     /* @sic R5-153798: usage of cs_SDP_PreconditionAttributes sic@ */
    } else {                                                              /* Annex C.11b, 34.229-5 A.5.2 */
      v_PreconditionAttributes := omit;
    }

    return f_IMS_BuildSDP_TX(cs_SDP_Media_MultiAudio(v_MediaDescriptionRtpList.FmtList), v_MediaBandwidth_List, v_MediaDescriptionRtpList.AttributeList, v_PreconditionAttributes);  /* @sic R5s210680: v_MediaDescriptionRtpList.AttributeList sic@ */
  }

  /*
   * @desc      Build SDP record to be sent to the UE at step 7 according to 34.229-1 Annex C.11 or C.45
   * @param     p_SDP_Message183
   * @param     p_AudioCodec        (default value: AMR_16000)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_UpdatedOfferAudio_TX(SDP_Message p_SDP_Message183,
                                               IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000)
    runs on IMS_PTC
    return template (value) SDP_Message
  { /* @sic R5s141244: use of f_IMS_BuildSDP_TX sic@ */
    /* @sic R5-153610: "sendrecv" media attribute removed from SDP message for C.11 step 7 sic@ */
    /* @sic R5-153798: p_SDP_Message183 replacing p_SDP_Attribute_curr_qos_remote and p_Step; p_IsC45 sic@ */
    /* @sic R5-153798, R5s150841: split of f_IMS_BuildSDP_AnnexC11_Step1or7 sic@ */
    /* @sic R5-168057, R5-168142: p_AudioCodec := AMR_16000 sic@ */
    var SDP_media_desc v_PrevMediaDescAudio := p_SDP_Message183.media_list[0];
    var template (value) SDP_bandwidth_list v_MediaBandwidth_List;
    var template (omit) SDP_attribute_list v_PreconditionAttributes;
    var template (value) IMS_SDP_MediaDescriptionRtpList_Type v_MediaDescription;
    var charstring v_DirectionRemote;
    var charstring v_StrengthRemote := c_mandatory;
    
    select (p_AudioCodec) {
      case (AMR_8000) {
        v_MediaBandwidth_List := cs_SDP_Bandwidth_List_Media(37, 0, 2000);
      }
      case (AMR_16000) {   /* @sic R5-168057 => C.11 sic@ */
        v_MediaBandwidth_List := cs_SDP_Bandwidth_List_Media(37, 0, 2000);      /* @sic R5-130751; R5-134270: RR=2500; R5-144700: AS=37; R5-172126: RR=2000 sic@ */
      }
      case (EVS_16000) {  /* => C.45 @sic R5-153798 sic@*/
        v_MediaBandwidth_List := cs_SDP_Bandwidth_List_Media(65, 0, 2000);
        if (not f_IMS_PTC_RanTypeIsNR5GC()) {
          v_StrengthRemote := c_optional;  // @sic R5-170671 sic@
          // @sic R5-212240: a=sendrecv removed from Attributes for media sic@
        }
      }
    }

    // get curr:qos remote for SDP message in step 7
    if (f_SDP_AttributeList_CheckAttribute(v_PrevMediaDescAudio.attributes, cr_SDP_Attribute_curr_qos(c_local, c_none))) {  // see C.11 step 7 Note 1
      v_DirectionRemote := c_none;
    } else {
      v_DirectionRemote := c_sendrecv;
    }
      
    v_PreconditionAttributes := cs_SDP_PreconditionAttributes(c_sendrecv, v_DirectionRemote, c_mandatory, v_StrengthRemote); /* @sic R5-153798: usage of cs_SDP_PreconditionAttributes sic@
                                                                                                                                    @sic R5s170078: remote strength v_StrengthRemote := mandatory sic@ */
    v_MediaDescription := f_SDP_MediaDescriptionSubsequentOfferAudioTX(p_AudioCodec, p_SDP_Message183);  /* @sic R5-213524, R5-213538, R5-213539, R5-213541: f_SDP_MediaDescriptionSubsequentOfferAudioTX sic@ */
    return f_IMS_BuildSDP_TX(cs_SDP_Media_MultiAudio(v_MediaDescription.FmtList), v_MediaBandwidth_List, v_MediaDescription.AttributeList, v_PreconditionAttributes);
  }

  /*
   * @desc      to receive SDP answer sent by the UE in C.11 step 4
   * @param     p_AudioCodec        (default value: AMR_16000)
   * @param     p_EvsConfiguration  (default value: NO_EVS)
   * @param     p_PreconditionsRequired (default value: true)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_InitialAnswerAudio_RX(IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000,
                                                SDP_EVS_Configuration_MTCallSetup_Type p_EvsConfiguration := NO_EVS,
                                                boolean p_PreconditionsRequired := true)
    runs on IMS_PTC return template (present) SDP_Message
  { /* @sic R5-123077 change 3: 'inactive' removed from 'Attributes for media' for step 4 sic@ */
    /* @sic R5s150704, R5s150751 - Additional changes: f_IMS_BuildSDP_RX used instead of cr_SDP_Message_Def sic@ */
    /* @sic R5-153798: p_IsC45 sic@ */
    /* @sic R5-168057: new default for p_AudioCodec sic@ */
    /* @sic R5s170946: p_PreconditionsRequired sic@ */
    /* @sic R5-217835: p_FormatSpecificParameters; R5-231489: removed sic@ */
    /* @sic R5-231489: p_EvsConfiguration; f_IMS_BuildSDP_AnswerAudio_RX split into f_IMS_BuildSDP_InitialAnswerAudio_RX and f_IMS_BuildSDP_FinalAnswerAudio_RX sic@ */
    /* @sic R5-243985: NO_EVS instead of EVS_A2 as default for p_EvsConfiguration sic@ */
   
    var template (present) SDP_media_field v_SDP_Media_Field := cr_SDP_Media_Audio;
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodec := f_SDP_AttributeRtpmapAudioRX(p_AudioCodec);   /* @sic R5-153798 sic@*/
    var template (present) SemicolonParam_List v_Fmtparameters;
    var template (present) SDP_attribute_fmtp_format_specific_params v_FormatSpecificParameters;
    var template (present) SDP_attribute_list v_MediaAttributes;
    var template (present) SDP_attribute_list v_PreconditionAttributes;
    
    select (p_AudioCodec) {
      case (EVS_16000) {
        select (p_EvsConfiguration) {                           // @sic R5-231489 sic@
          case (EVS_A2) {                                       // EVS default configuration
            v_Fmtparameters := cr_EVS_Fmtp_AudioParamsBrBwMaxRed("5.9-24.4", "nb-swb");
          }
          case (EVS_B0_A1) {
            /* @sic R5-250183: branch not used anymore sic@ */
          }
          case (EVS_C45) {                                      // @sic R5-243985: EVS_C45 sic@ @sic R5-153798 sic@
            v_Fmtparameters := cr_EVS_Fmtp_AudioParamsBrBw;     /* @sic R5-195318: "br" and "bw" instead of "br-recv", "br-send" and "bw-recv", "bw-send" sic@ */
          }
          case else {                                           // @sic R5-243985: NO_EVS sic@
            FatalError(__FILE__, __LINE__, "unknown EVS configuration");
          }
        }
        v_FormatSpecificParameters := cr_Fmtp_ParamList(v_Fmtparameters);
      }
      case else {                                               // AMR
        v_FormatSpecificParameters := ?;                        // fmtp not checked for AMR (e.g. 34.229-1 C.11 183 Session Progress (Step 4))
      }
    }

    v_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(cr_SDP_AnyMediaFormatDescr, v_RtpmapCodec),       // @sic R5s130681 change 2 sic@
      cr_SDP_Attribute_fmtp(cr_SDP_AnyMediaFormatDescr, v_FormatSpecificParameters)
    };

    if (p_PreconditionsRequired) {
      v_PreconditionAttributes := cr_SDP_PreconditionAttributesWithConf((c_none, c_sendrecv), c_none, c_mandatory, c_mandatory);  /* @sic R5s120530 change 3.15 sic@  NOTE: preconditions only if required
                                                                                                                                     @sic R5s140204, R5-214812 sic@ */
    } else {
      v_PreconditionAttributes := {};                                           // @sic R5s170946 sic@
    }
    return f_IMS_BuildSDP_RX(-, v_SDP_Media_Field, v_MediaAttributes, v_PreconditionAttributes);
  }

  /*
   * @desc      to receive final SDP answer sent by the UE in C.11 step 8 (200 OK sent by the SS)
   * @param     p_AudioCodec        (default value: AMR_16000)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_FinalAnswerAudio_RX(IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000)
    runs on IMS_PTC return template (present) SDP_Message
  { /* @sic R5-231489: f_IMS_BuildSDP_AnswerAudio_RX split into f_IMS_BuildSDP_InitialAnswerAudio_RX and f_IMS_BuildSDP_FinalAnswerAudio_RX sic@ */
    var template (present) SDP_media_field v_SDP_Media_Field := cr_SDP_Media_Audio;
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodec := f_SDP_AttributeRtpmapAudioRX(p_AudioCodec);   /* @sic R5-153798 sic@*/
    var template (present) SDP_attribute_list v_PreconditionAttributes := cr_SDP_PreconditionAttributes(c_sendrecv, c_sendrecv, c_mandatory, c_mandatory);
    var template (present) SDP_attribute_list v_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(cr_SDP_AnyMediaFormatDescr, v_RtpmapCodec),       // @sic R5s130681 change 2 sic@
      cr_SDP_Attribute_fmtp(cr_SDP_AnyMediaFormatDescr)                         // fmtp not checked in final SDP answer
    };
    
    /* @sic R5-150709: cr_SDP_Attribute_sendrecv removed sic@ */

    return f_IMS_BuildSDP_RX(-, v_SDP_Media_Field, v_MediaAttributes, v_PreconditionAttributes);
  }

  /*
   * @desc      return template for SDP message at step 2 according to 34.229-1 Annex C.21
   * @param     p_AudioCodecList
   * @param     p_PreconditionAttributes
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_InitialOfferAudioWithPreconditions_RX(IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                                                template (present) SDP_attribute_list p_PreconditionAttributes) runs on IMS_PTC return template (present) SDP_Message
  {
    var template (present) SDP_attribute_list v_MediaAttributes := {};
    var template (present) integer v_BandwidthRS := ?;               /* @sic R5-160906 sic@ */
    var template (present) integer v_BandwidthRR := (1..infinity);   /* @sic R5-160906 sic@ */
    var boolean v_IsWLAN := f_IMS_PTC_RanTypeIsWLAN();  /* @sic R5-171476: C.21a sic@ */
    var boolean v_IsCatM1 := f_IMS_TestcaseIsCatM1();   /* @sic R5-174483: C.21d sic@ */

    v_MediaAttributes := f_SDP_MediaAttributesAudioCodecListRX(p_AudioCodecList);   /* @sic R5-168031, R5-168053, R5-168054, R5-172931 sic@ */
    /* @sic R5-150709: "a=inactive" removed sic@ */
    
    if (not v_IsWLAN and not v_IsCatM1) {                                                       /* Attributes for media security mechanism may be required for C.21 only */
      v_MediaAttributes := f_IMS_SDP_MediaAttributes_AddMediaSecurityAttributesRX(v_MediaAttributes);    /* @sic R5-160293,  R5-160915 new TC H.12.3 sic@ */
    }
    
    return f_IMS_BuildSDP_RX(cr_SDP_Time_Any, cr_SDP_Media_Audio, v_MediaAttributes, p_PreconditionAttributes, -, v_BandwidthRS, v_BandwidthRR);
  }

  /*
   * @desc      return template for SDP message at step 2 according to 34.229-1 Annex C.21
   * @param     p_PreconditionsRequired   (default value:   true)
   * @param     p_AudioCodecList   (default value:   tsc_IMS_SDP_AudioCodecList_WBAMR_AMR)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_InitialOfferAudio_RX(boolean p_PreconditionsRequired := true,
                                               IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR) runs on IMS_PTC return template (present) SDP_Message
  { /* @sic R5-135020, R5-135021: new PICS pc_IMS_RtcpDuringVoiceSession sic@ */
    /* @sic R5w140113, R5w140009: new SDP type definitions */
    /* @sic R5s150704, R5s150751 - Additional changes: parameter p_PreconditionsRequired, f_IMS_BuildSDP_RX used instead of cr_SDP_Message_AnySession sic@ */
    /* @sic R5-160906: p_RtcpDuringVoiceSession removed sic@ */
    /* @sic R5-168053: p_AudioCodecList sic@ */
    var template (present) SDP_attribute_list v_PreconditionAttributes := {};

    if (p_PreconditionsRequired) { /* @sic R5s150704, R5s150751 - Additional changes sic@ */
      if (f_IMS_PTC_RanTypeIsWLAN()) { /* @sic R5-171476 - WLAN Annex C.21a sic@ */
        v_PreconditionAttributes := cr_SDP_PreconditionAttributes(c_sendrecv, c_none, c_mandatory, c_optional);
      } else {
        v_PreconditionAttributes := cr_SDP_PreconditionAttributes(c_none, c_none, c_mandatory, c_optional);
      }
    }
    
    return f_IMS_BuildSDP_InitialOfferAudioWithPreconditions_RX(p_AudioCodecList, v_PreconditionAttributes);  /* @sic R5s210462 change 2 sic@ */
  }

  /*
   * @desc      return media attributes for audio to be used in initial answer depending on the codec
   * @param     p_MediaDescription_Offer
   * @param     p_AudioCodec
   * @param     p_EvsConfiguration
   * @param     p_FmtAudio
   * @return    SDP_attribute_list
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_AudioMediaAttributes_InitialAnswer_TX(SDP_media_desc p_MediaDescription_Offer,
                                                           IMS_SDP_AudioCodec_Type p_AudioCodec,
                                                           SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration,
                                                           charstring p_FmtAudio) return SDP_attribute_list
  { /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    var template (omit) SDP_attribute_list v_MediaAttributes;
    var template (omit) SDP_attribute v_Attribute;
    var template (omit) SemicolonParam_List v_FmtpParameterList_Answer := omit;
    var SemicolonParam_List v_FmtpParameterList_Offer;
    var CharStringList_Type v_FmtpParametersToBoCopied;
    var charstring v_BwVal;

    select (p_AudioCodec) {                     // @sic R5-151968, R5-153999 sic@
      case (EVS_16000){
        select (p_EvsConfiguration) {
          case (EVS_A2) {
            v_FmtpParameterList_Answer := { cs_EVS_Br("5.9-24.4"), cs_EVS_Bw("nb-swb"), cs_AMR_MaxRed };
          }
          case (EVS_AnyNG114) {
            /* @sic R5-250180: branch not used anymore sic@ */
          }
          case (EVS_C44) {                      // C.44 @sic R5-153999 sic@ @sic R5-243984: EVS_C44 sic@
            v_Attribute := f_SDP_AttributeList_GetAttribute(p_MediaDescription_Offer.attributes, cr_SDP_Attribute_fmtp(p_FmtAudio));
            v_BwVal := f_SIP_SemicolonParamList_GetParamValue(v_Attribute.fmtp.params.paramList, "bw");   /* @sic R5s170336/R5-172069 sic@ */
            v_FmtpParameterList_Answer := {cs_EVS_Bw(v_BwVal), cs_EVS_BwSend(v_BwVal), cs_EVS_BwRecv(v_BwVal), cs_AMR_MaxRed};   /* @sic R5s160379: Additional Change by MCC160 sic@
                                                                                                                                    @sic R5s170336/R5-172069: v_BwVal sic@ */
            v_FmtpParametersToBoCopied := { "br", "br-send", "br-recv" };
            v_FmtpParameterList_Offer := f_SDP_MediaDescr_GetCodecParameters(p_MediaDescription_Offer.attributes, p_FmtAudio);
            v_FmtpParameterList_Answer := f_SIP_SemicolonParamList_CopyParams(v_FmtpParameterList_Offer, v_FmtpParameterList_Answer, v_FmtpParametersToBoCopied);
          }
          case else {                           // @sic R5-243984: NO_EVS sic@
            FatalError(__FILE__, __LINE__, "unknown EVS configuration");
          }
        }
        v_MediaAttributes := f_SDP_MediaAttributes_EVS_AudioDef(p_FmtAudio, valueof(v_FmtpParameterList_Answer));   // valueof to avoid compiler warning
      }
      case (AMR_16000){                         // @sic R5-153950 sic@
        v_MediaAttributes := f_SDP_MediaAttributes_AMR_WB_AudioDef(p_FmtAudio);  /* @sic R5s160379 change 2 sic@ @sic R5s220510 sic@ */
      }
      case (AMR_8000){
        v_MediaAttributes := f_SDP_MediaAttributes_AudioDef(p_FmtAudio);   /* @sic R5-144693: new function f_SDP_MediaAttributes_AudioDef sic@ */
      }
    }
    return valueof(v_MediaAttributes);
  }

  /*
   * @desc      return template for SDP message at step 4 according to 34.229-1 Annex C.21 and C.44
   * @param     p_SdpOffer
   * @param     p_PreconditionsRequired (default value: true)
   * @param     p_FmtAudio
   * @param     p_MediaAttributes
   * @param     p_BandwidthAS       (default value: 37)
   * @param     p_PreconditionAttributesIfRequired  (default value: omit)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_BuildSDP_InitialAnswerAudio_TX_Common(SDP_Message p_SdpOffer,
                                                        boolean p_PreconditionsRequired := true,
                                                        charstring p_FmtAudio,
                                                        template (omit) SDP_attribute_list p_MediaAttributes,
                                                        integer p_BandwidthAS := 37,
                                                        template (omit) SDP_attribute_list p_PreconditionAttributesIfRequired := omit)
    runs on IMS_PTC
    return template (value) SDP_Message
  { /* @sic R5-217835: new function for implementation of 7.4a.NR5GC sic@ */
    /* @sic R5-223349: p_PreconditionAttributesIfRequired sic@ */
    var SDP_media_desc v_SDP_Media_Invite := p_SdpOffer.media_list[0];
    var integer v_BandwidthRS := f_SDP_BandwidthList_GetBandwidth(v_SDP_Media_Invite.bandwidth, "RS");
    var integer v_BandwidthRR := f_SDP_BandwidthList_GetBandwidth(v_SDP_Media_Invite.bandwidth, "RR");
    var template (value) SDP_bandwidth_list v_Bandwidth_List_Media := cs_SDP_Bandwidth_List_Media(p_BandwidthAS, v_BandwidthRS, v_BandwidthRR); // @sic R5-123505, R5-135020; R5-144700: AS=p_BandwidthAS sic@
    var template (omit) SDP_attribute_list v_MediaAttributes := p_MediaAttributes;
    var template (omit) SDP_attribute_list v_PreconditionAttributes := omit;
    var boolean v_IsWLAN := f_IMS_PTC_RanTypeIsWLAN();  /* @sic R5-171477 sic@ */
    var boolean v_IsCatM1 := f_IMS_TestcaseIsCatM1();   /* @sic R5-174483: C.21d sic@ */

    if (not v_IsWLAN and not v_IsCatM1) {       // @sic R5-171476, R5-174483: not required for C.21a and C.21d sic@
      v_MediaAttributes := f_IMS_SDP_MediaAttributes_CopyEcnCapabilityAttributesTX(v_SDP_Media_Invite, v_MediaAttributes);
    }
    
    if (not v_IsWLAN and not v_IsCatM1) {                                                               /* Attributes for media security mechanism may be required for C.21 only */
      v_MediaAttributes := f_IMS_SDP_MediaAttributes_AddMediaSecurityAttributesTX(v_MediaAttributes);   /* @sic R5-160293,  R5-160915 new TC H.12.3 sic@ */
    }

    if (p_PreconditionsRequired) {                              /* @sic R5s150704, R5s150751 - Additional changes sic@ */
      if (isvalue(p_PreconditionAttributesIfRequired)) {        /* @sic R5-223349 sic@ */
        v_PreconditionAttributes := p_PreconditionAttributesIfRequired;
      } else {
        if (v_IsWLAN) {                                         /* @sic R5-171477 - WLAN Annex C.21a sic@ */
          v_PreconditionAttributes := cs_SDP_PreconditionAttributes(c_sendrecv, c_sendrecv, c_mandatory, c_mandatory);    // @sic R5s170904 change 3: sendrecv for remote precondition sic@
        } else {
          v_PreconditionAttributes := cs_SDP_PreconditionAttributesWithConf(c_none, c_none, c_mandatory, c_mandatory);    // @sic R5s120530 change 3.5 sic@
        }
      }
    }
    
    return f_IMS_BuildSDP_TX(cs_SDP_Media_Audio(p_FmtAudio), v_Bandwidth_List_Media, v_MediaAttributes, v_PreconditionAttributes);
  }

  /*
   * @desc      return template for SDP message at step 4 according to 34.229-1 Annex C.21 and C.44
   * @param     p_SdpOffer
   * @param     p_PreconditionsRequired (default value: true)
   * @param     p_AudioCodec      (default value: AMR_16000)
   * @param     p_EvsConfiguration  (default value: NO_EVS)
   * @param     p_BandwidthAS     (default value: 37)
   * @param     p_PreconditionAttributesIfRequired  (default value: omit)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_InitialAnswerAudio_TX(SDP_Message p_SdpOffer,
                                                boolean p_PreconditionsRequired := true,
                                                IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000,
                                                SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration := NO_EVS,
                                                integer p_BandwidthAS := 37,
                                                template (omit) SDP_attribute_list p_PreconditionAttributesIfRequired := omit)
    runs on IMS_PTC
    return template (value) SDP_Message
  { /* @sic R5-135020: parameter p_SdpOffer to get RR and RS values sic@ */
    /* @sic R5-144402: p_IPAddrOrigin removed sic@ */
    /* @sic R5s141244: use of f_IMS_BuildSDP_TX sic@ */
    /* @sic R5-151968: p_IsC44 sic@ */
    /* @sic R5s150704, R5s150751 - Additional changes: p_PreconditionsRequired sic@ */
    /* @sic R5-153999: p_IsC44 renamed to p_AudioCodec sic@ */
    /* @sic R5-168031: p_AudioCodec - default value changed from AMR_8000 to AMR_16000 sic@ */
    /* @sic R5-168031: p_BandwidthAS sic@ */
    /* @sic R5-182188: a=inactive removed from Attributes for media sic@ */
    /* @sic R5-223349: p_PreconditionAttributesIfRequired sic@ */
    /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    /* @sic R5-243984: NO_EVS instead of EVS_A2 as default for p_EvsConfiguration sic@ */

    var SDP_media_desc v_SDP_Media_Invite := p_SdpOffer.media_list[0];
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters := f_SDP_FmtpDefaultParametersAudioCodecRX(p_AudioCodec);   /* @sic R5s160379 change 2 sic@ */
    var charstring v_FmtAudio := f_SDP_MediaDescr_GetAudioCodec(v_SDP_Media_Invite, p_AudioCodec, v_FmtpParameters);      /* NOTE 1: The initial offer may contain more than one entries for the same codec (e.g. for EVS)
                                                                                                                           *         and in general v_FmtpParameters matches for each of the entries
                                                                                                                           *         => in general v_Fmt gets assigned the fmt value of the first entry of the codec
                                                                                                                           * NOTE 2: In case of 34.229-5 A.4.1 when the first EVS configuration in the offer is not B0
                                                                                                                           *         then the answer shall be configuration A1 which does not need be included in the offer
                                                                                                                           *         (i.e. in this case the answerer needs to choose an fmt value, it cannot be retrieved from the offer) */
    var template (omit) SDP_attribute_list v_MediaAttributes;

    v_MediaAttributes := f_IMS_SDP_AudioMediaAttributes_InitialAnswer_TX(v_SDP_Media_Invite, p_AudioCodec, p_EvsConfiguration, v_FmtAudio);   /* @sic R5-211433, R5-217835: f_IMS_SDP_AudioMediaAttributes_InitialAnswer_4G_TX sic@
                                                                                                                                                 @sic R5-243984: merge of f_IMS_SDP_AudioMediaAttributes_InitialAnswer4G/5G_TX sic@ */

    return fl_IMS_BuildSDP_InitialAnswerAudio_TX_Common(p_SdpOffer, p_PreconditionsRequired, v_FmtAudio, v_MediaAttributes, p_BandwidthAS, p_PreconditionAttributesIfRequired);   /* @sic R5-217835: f_IMS_BuildSDP_InitialAnswerAudio_TX_Common sic@ */
  }

  /*
   * @desc      to receive SDP answer sent by the UE in C.11 step 8 (200 OK sent by the SS) or 2nd SDP sent by the UE in C.21/C.44 step 5/7
   * @param     p_SDP_MessageInvite
   * @param     p_RemoteResourcesEstablished (default value: false)
   * @param     p_AudioCodec                 (default value: AMR_16000)
   * @param     p_EvsConfiguration           (default value: NO_EVS)
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_UpdatedOfferAudio_RX(SDP_Message p_SDP_MessageInvite,
                                               boolean p_RemoteResourcesEstablished := false,
                                               IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000,
                                               SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration := NO_EVS)
    runs on IMS_PTC
    return template (present) SDP_Message
  { /* @sic R5-145726: function restructured to allow it to be used by e.g. f_IMS_BuildSDP_AnnexC8_Step1; new parameter p_CallHoldC8 sic@ */
    /* @sic R5-151968 new parameter: p_AudioCodec sic@ */
    /* @sic R5-153610: p_SDP_MessageInvite instead of p_Fmt sic@ */
    /* @sic R5-151953: p_CallHoldC8 renamed to p_RemoteResourcesEstablished: to be set to true whenever the resources are established already e.g. in case of call-hold or CAT sic@
       NOTE: p_RemoteResourcesEstablished affects "a=curr:qos remote" attribute and is in general independent from whether or not the has resources (radio bearers) */
    /* @sic R5-168031, R5-168117: p_AudioCodec := AMR_16000 sic@ */
    /* @sic R5-217835: p_FormatSpecificParameters sic@ */
    /* @sic R5-225925..37: p_EvsConfiguration added; p_FormatSpecificParameters removed sic@ */
    /* @sic R5-243984: NO_EVS instead of EVS_A2 as default for p_EvsConfiguration sic@ */
    var SDP_media_desc v_SDP_Media_Invite := p_SDP_MessageInvite.media_list[0];
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters := f_SDP_FmtpDefaultParametersAudioCodecRX(p_AudioCodec);    /* @sic R5s160379 change 3 sic@ */
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapAttr := f_SDP_AttributeRtpmapAudioRX(p_AudioCodec); /* @sic R5-1551968 sic@ */
    var charstring v_Fmt := f_SDP_MediaDescr_GetMediaFormat(v_SDP_Media_Invite, v_RtpmapAttr, v_FmtpParameters);  /* @sic R5-153610 sic@ @sic R5s160379 change 3 sic@
                                                                                                                   * NOTE: The initial offer may contain more than one entries for the same codec (e.g. for EVS)
                                                                                                                   *       and in general v_RtpmapAttr and v_FmtpParameters match for each of the entries
                                                                                                                   *       => in general v_Fmt gets assigned the fmt value of the first entry of the codec */
    var template (present) SDP_media_field v_SDP_Media_Field := cr_SDP_Media_Audio(v_Fmt);
    var template (present) SDP_attribute_list v_MediaAttributes;
    var template (present) charstring v_DirectionRemote;
    var template (present) SDP_attribute_list v_PreconditionAttributes;
    var template (present) SDP_attribute_fmtp_format_specific_params v_FormatSpecificParameters := ?;

    select (p_AudioCodec) {
      case (EVS_16000) {                                            // @sic R5-212048 sic@
        if (f_IMS_PTC_RanTypeIsNR5GC()) {
          select (p_EvsConfiguration) {
            case (EVS_AnyNG114) {
              /* @sic R5-250180: branch not used anymore sic@ */
            }
            case (EVS_A2) {
              /* 34.229.5 A.4.1a UPDATE (Step 6) specifies fmtp parameters not to be checked (Note 4) */
            }
          }
        }
      }
    }

    v_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(v_Fmt, v_RtpmapAttr),                     // @sic R5s130681 change 2 sic@
      cr_SDP_Attribute_fmtp(v_Fmt, v_FormatSpecificParameters)          // @sic R5s130497 change 2: format parameters added; R5s130586 change 4: format parameters changed back to any parameters sic@
    };
    
    if (not p_RemoteResourcesEstablished) {
      // @sic R5-182188: a=sendrecv removed from Attributes for media sic@
      v_DirectionRemote := c_none;
    } else {
      v_DirectionRemote := c_sendrecv;
    }
    v_PreconditionAttributes := cr_SDP_PreconditionAttributes(c_sendrecv, v_DirectionRemote, c_mandatory, (c_optional, c_mandatory));
    return f_IMS_BuildSDP_RX(-, v_SDP_Media_Field, v_MediaAttributes, v_PreconditionAttributes);
  }

  /*
   * @desc      build SDP message to be sent in step 6 or 8 of 34.229-1 Annex C.21
   *            NOTE: function is not specific for C.21 but can be used for C.25 as well
   * @param     p_SDP_Message_PrevOffer
   * @param     p_DontIncrementSessVers       (default value: false)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_UpdatedAnswer_TX(SDP_Message p_SDP_Message_PrevOffer,
                                           boolean p_DontIncrementSessVers := false)
    runs on IMS_PTC
    return template (value) SDP_Message
  {
    var template (omit) charstring v_SessionVersion := omit;   // omit => session version gets maintained by f_IMS_BuildSDP_CommonResponseToOfferTX
    var template (value) SDP_Message v_SDP_Message;

    if (p_DontIncrementSessVers) {                                              // @sic R5s211703: session version shall not be incremented, if the SDP answer is not sent but used for other purposes sic@
      v_SessionVersion := int2str(f_IMS_PTC_ImsInfo_DialogGetSessVersionTX());  // Get session version as used in the latest SDP answer sent to the UE but don't increment the session version
    }

    v_SDP_Message := f_IMS_BuildSDP_CommonResponseToOfferTX(p_SDP_Message_PrevOffer, v_SessionVersion);

    v_SDP_Message.media_list := f_IMS_SDP_MediaList_ExchangeAttribute(v_SDP_Message.media_list,
                                                                      cs_SDP_Attribute_curr_qos(c_remote, c_none),      // value sent by the UE in step 5/7
                                                                      cs_SDP_Attribute_curr_qos(c_remote, c_sendrecv)); // ... to be replaced
    return v_SDP_Message;
  }

  /*
   * @desc      Build SDP record to be received from the UE at step 1 according to 34.229-1 Annex C.22 and 34.229-5 Annex A.6
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_EmergencyCallOffer_RX() runs on IMS_PTC return template (present) SDP_Message
  {
    var charstring v_AddrType := f_IMS_PTC_NW_Address_GetTypeStr();
    var template (present) charstring v_IPAddrOrigin := ?;
    var template (present) charstring v_IPAddrConnection := ?;
    var template (present) SDP_media_desc v_SDP_Media_Desc;
    var template SDP_bandwidth_list v_Bandwidth := *;
    var template SDP_attribute_list v_SDP_Attribute_List := *;     /* acc. to annex C.22 there shall be AMR/8000 and/or AMR-WB/16000
                                                                      this will be checked later-on when the fmt value for the AMR codec is extracted (-> f_IMS_EmergencyCallSetup) */
    v_SDP_Media_Desc := cr_SDP_Media_Desc(cr_SDP_Media_Audio,
                                          cr_SDP_Connection(v_AddrType, v_IPAddrOrigin),
                                          cr_SDP_Bandwidth_List_AS,
                                          v_SDP_Attribute_List);
    return cr_SDP_Message_Common(-, v_AddrType, v_IPAddrOrigin, v_IPAddrConnection, v_Bandwidth, cr_SDP_Time_Any, { v_SDP_Media_Desc }); /* @sic R5s130495 change 21 sic@ */
  }

  /*
   * @desc      Build SDP record to be sent to the UE at step 4 according to 34.229-1 Annex C.22 and 34.229-5 Annex A.6
   *            NOTE: the "payload type" of the rtpmap attribute and the "format" of the fmtp atribute refer to the format in the media description (RFC 4566)
   *                  => as long as there is only one media description, the fmt, payload type and format have the same value
   * @param     p_Fmt
   * @param     p_AudioCodec        (default value: AMR_8000)
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_BuildSDP_EmergencyCallAnswer_TX(charstring p_Fmt,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_8000) runs on IMS_PTC return template (value) SDP_Message
  { /* @sic R5s141244: use of f_IMS_BuildSDP_TX; p_IPAddrOrigin removed sic@ */
    /* @sic R5s170327: p_AudioCodec sic@ */
    var template (value) SDP_bandwidth_list v_Bandwidth_List_Media := cs_SDP_Bandwidth_List_Media(37, 0, 0); /* @sic R5-144700: AS=37 sic@ */
    var template (omit)  SDP_attribute_list v_MediaAttributes;
    var template (value) SemicolonParam_List v_AudioParams;
    var template (omit)  SDP_attribute_list v_PreconditionAttributes := omit;
    
    select (p_AudioCodec) {
      case (AMR_8000, AMR_16000) {   // 34.229-1 Annex C.22 step 4
        v_MediaAttributes := f_SDP_MediaAttributes_AMR_AudioDef(p_Fmt, p_AudioCodec);
      }
      case (EVS_16000) {             // 34.229-5 Annex A.6 step 4
        v_AudioParams := cs_Fmtp_AudioParamsDef;                                                // mode-change-capability=2; max-red=220
        v_MediaAttributes := f_SDP_MediaAttributes_EVS_AudioDef(p_Fmt, v_AudioParams);      // rtpmap, fmtp, ptime, maxptime
      }
      case else {
        FatalError(__FILE__, __LINE__, "");
      }
    }
    return f_IMS_BuildSDP_TX(cs_SDP_Media_Audio(p_Fmt), v_Bandwidth_List_Media, v_MediaAttributes, v_PreconditionAttributes);
  }

}
