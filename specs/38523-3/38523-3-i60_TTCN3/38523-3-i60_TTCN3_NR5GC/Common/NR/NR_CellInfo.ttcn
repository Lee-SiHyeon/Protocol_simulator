  /*
   * @desc  Function returning true if the sysinfo combination contains SIB2
   * @param     p_NR_SysinfoCombination
   * @return    boolean
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_IsSib2InSysinfoCombination(NR_SysinfoCombination_Type p_NR_SysinfoCombination) return boolean
  { //@sic R5-235359 sic@
    var boolean v_IsSIB2 := false;

    select (p_NR_SysinfoCombination) { //@sic R5-243555, R5-254023, R5-261598 sic@
      case (NR_2, NR_3, NR_4, NR_5, NR_6, NR_7, NR_14, NR_16, NR_17, NR_19, NR_20, NR_21, NR_22, NR_23, NR_24, NR_25, NR_27, NR_29, NR_30, NR_32, NR_34, NR_35, NR_40) { v_IsSIB2 := true; }
      case else { v_IsSIB2 := false; }
    }
    return v_IsSIB2;
  }

  /*
   * @desc      Set T-ReselectionNR value stored in SIB2 in the indicated cell
   * @param     p_NR_CellId
   * @param     p_T_ReselectionNR
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB2_T_ReselectionNR(NR_CellId_Type p_NR_CellId,
                                                 SIB2.intraFreqCellReselectionInfo.t_ReselectionNR p_T_ReselectionNR) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (f_NR_IsSib2InSysinfoCombination(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib2.intraFreqCellReselectionInfo.t_ReselectionNR := p_T_ReselectionNR;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
        f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
    } else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
    }
  }

