    cr_SDP_Attribute_curr_qos(c_remote, p_DirectionRemote),
    cr_SDP_Attribute_des_qos(p_StrengthLocal, c_local),
    cr_SDP_Attribute_des_qos(p_StrengthRemote, c_remote)
  };

