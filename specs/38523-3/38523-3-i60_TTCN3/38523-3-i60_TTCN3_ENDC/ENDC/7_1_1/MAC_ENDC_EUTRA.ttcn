    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.7.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_7_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
      //UE power headroom reporting / Periodic reporting / DL pathloss change reporting
     var template (omit) octetstring v_NR_SCGConfig := omit;
     f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_1DRB(0, tsc_DRB2));
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
     //@siclog "Steps 1&3" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    
   //@siclog "Steps 6-7" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
     //@siclog "Steps 9&11" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);// Test body now finished
     //@siclog "Steps 19-20" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.9.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_9_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    //Correct Handling of UL HARQ process / PUSCH Repetition Type A / PUSCH Aggregation
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON);
    
    f_EUTRA_TestBody_Set(true);

    fl_TC_7_1_1_3_9_ENDC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_7_1_1_3_9_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_7_1_1_3_9_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    //Correct Handling of UL HARQ process / PUSCH Aggregation
    var template (omit) octetstring v_NR_SCGConfig := omit;

    // Send trigger to NR to start step 1-2
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger);
  
    //@siclog "Steps 0A-0B" siclog@
    // SS transmits in the indicated downlink assignment an NR RRCReconfiguration
    // UE transmits NR RRCReconfigurationComplete message to the SS.
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1, -, -, v_NR_SCGConfig);

    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.4.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_4_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // DL-SCH Transport Block Size selection / DCI format 1_0
    f_TC_7_1_1_4_x_x_ENDC_EUTRA();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.4.2.1.ENDC
