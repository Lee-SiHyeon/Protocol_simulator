  template (value) SecurityConfigHO cs_SecurityConfigHO_IntraLTE(template (omit) SecurityAlgorithmConfig p_SecurityAlgorithmConfig := omit,
                                                                 boolean              p_KeyChangeIndicator,
                                                                 NextHopChainingCount p_NextHopChainingCount) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    /* @sic R5s120700 (additional change): new parameter p_SecurityAlgorithmConfig sic@ */
