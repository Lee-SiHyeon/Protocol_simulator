module MCX_XML_mcdataPresInfoFA {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcdataPresInfoFA_1_0 language "XSD" all;   

  type urn_3gpp_ns_mcdataPresInfoFA_1_0.FunctionalAlias MCData_FunctionalAlias_Type;            /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcdataPresInfoFA_1_0.StatusType      MCData_FunctionalAlias_Status_Type;     /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcdataPresInfoFA_1_0.P_id_fa         MCData_P_id_fa_Type;                    /* @status    APPROVED (MCX) */

  template (present) MCData_FunctionalAlias_Type cr_MCData_FunctionalAlias(XSD.AnyURI p_FunctionalAliasID := px_MCData_ID_FA_A) :=
  { /* FunctionalAlias according to 36.579-1 Table 5.5.3.5.1-1
       (see NOTEs for cs_MCData_FunctionalAlias)
       @status    APPROVED (MCX) */
    expires := omit,
    functionalAliasID := p_FunctionalAliasID,
    status := omit,
    user := omit,
    attr := omit,
    elem_list := {}
  };

  template (value) MCData_FunctionalAlias_Type cs_MCData_FunctionalAlias(XSD.AnyURI p_FunctionalAliasID := px_MCData_ID_FA_A,
                                                                         MCData_FunctionalAlias_Status_Type p_Status := activated) :=
  { /* FunctionalAlias according to 36.579-1 Table 5.5.3.5.2-1
       NOTEs: (see cs_MCPTT_FunctionalAlias)
       @status    APPROVED (MCX) */
    expires := omit,
    functionalAliasID := p_FunctionalAliasID,
    status := p_Status,
    user := omit,
    attr := omit,
    elem_list := {}
  };

  /*
   * @desc      encode MCData FunctionalAlias
   * @param     p_FunctionalAlias
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function fl_MCData_FunctionalAlias_Encode(template (value) urn_3gpp_ns_mcdataPresInfoFA_1_0.FunctionalAlias p_FunctionalAlias) return XSD.String
  {
    var bitstring v_EncodedFunctionalAlias := encvalue(p_FunctionalAlias);
    return f_Bit2XmlBody(v_EncodedFunctionalAlias);
  }

  /*
   * @desc      Encrypt and encode MCData FunctionalAlias
   * @param     p_FunctionalAlias
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCData_FunctionalAlias_EncryptEncode(template (value) MCData_FunctionalAlias_Type p_FunctionalAlias,
                                                  charstring p_MCServiceID,
                                                  template (omit) MCX_SecurityKey_Type p_CSK) return XSD.String
  {
    var template (value) MCData_FunctionalAlias_Type v_FunctionalAlias := p_FunctionalAlias;
    
    v_FunctionalAlias.functionalAliasID := f_MCX_XML_EncryptOptionalAttributeUri(v_FunctionalAlias.functionalAliasID, p_MCServiceID, p_CSK);
    
    return fl_MCData_FunctionalAlias_Encode(v_FunctionalAlias);
  }

  /*
   * @desc      Encode MCData P-Id
   * @param     p_P_id_fa
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCData_FunctionalAlias_P_id_fa_Encode(template (value) urn_3gpp_ns_mcdataPresInfoFA_1_0.P_id_fa p_P_id_fa) return XSD.String
  {
    var bitstring v_EncodedP_id_fa := encvalue(p_P_id_fa);
    return f_Bit2XsdString(v_EncodedP_id_fa);
  }

  /*
   * @desc      Decrypt FunctionalAlias
   * @param     p_FunctionalAlias
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    template (value) MCData_FunctionalAlias_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_FunctionalAlias_Decrypt(MCData_FunctionalAlias_Type p_FunctionalAlias,
                                            charstring p_MCServiceID,
                                            template (omit) MCX_SecurityKey_Type p_CSK) return template (value) MCData_FunctionalAlias_Type
  {
    var template (value) MCData_FunctionalAlias_Type v_FunctionalAlias := p_FunctionalAlias;

    v_FunctionalAlias.functionalAliasID := f_MCX_XML_DecryptOptionalAttributeUri(v_FunctionalAlias.functionalAliasID, p_MCServiceID, p_CSK);

    return v_FunctionalAlias;
  }

}
