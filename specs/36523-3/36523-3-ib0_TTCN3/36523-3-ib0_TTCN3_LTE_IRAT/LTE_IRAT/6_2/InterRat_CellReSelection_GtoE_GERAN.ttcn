  template (value) EUTRANParams cs_EUTRANParams (template (value) RptdEUTRANNeighCells p_RptdEUTRANNeighCells) :=
  { /* @status    APPROVED (LTE_IRAT) */
    gprsEutranMeasMask    := '1'B, // @sic R5s140648 sic@
    gprsEutranMeasParams  := cs_GPRS_EUTRANMeasParams,
    neighbourCells    := p_RptdEUTRANNeighCells,
    notAllowedCells   := cs_EUTRANNotAllowedCellsNone,
