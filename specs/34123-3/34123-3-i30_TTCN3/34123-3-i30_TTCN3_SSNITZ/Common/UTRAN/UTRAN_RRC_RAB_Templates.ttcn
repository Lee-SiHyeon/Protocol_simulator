  template (value) DL_DPCH_InfoPerRL_r7 cs_DL_DPCH_InfoPerRL_Speech_TDD :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ) */
    tdd := {
