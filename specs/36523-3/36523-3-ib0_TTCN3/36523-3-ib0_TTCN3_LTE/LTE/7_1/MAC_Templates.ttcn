  };

  template (value) MAC_MainConfig_Type cs_508_MAC_MainConfig_RBC_maxHARQ_Tx8_Explicit_DrxL :=
  { /* Default values except maxHARQ_Tx according to 36.523-1 Table 7.1.4.11.3.1-1 */
    /* @status    APPROVED (LTE) */
    /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
