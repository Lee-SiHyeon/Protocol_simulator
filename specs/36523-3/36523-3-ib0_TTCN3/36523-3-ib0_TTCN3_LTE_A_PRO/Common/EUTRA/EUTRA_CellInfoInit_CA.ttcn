        v_Freq.f3_DL_ChBandwidth := n50;
        v_Freq.f3_UL_ChBandwidth := n50;
      }
      case else { FatalError (__FILE__, __LINE__, "invalid Band"); }
    }
    
    //Assign EARFCN_r9 Handle band extension @sic R5-165892 sic@
    v_Freq := fl_AssignIntraBandCarrierFreq_r9(v_Freq, p_CA_FrequencyBand);
    return valueof(v_Freq);
  }

