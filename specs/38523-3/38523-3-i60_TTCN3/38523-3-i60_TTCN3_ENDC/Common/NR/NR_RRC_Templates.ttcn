  template (value) RRCReconfiguration_v1560_IEs.mrdc_SecondaryCellGroupConfig cs_MRDC_SecondaryCellGroupConfigSetup( template (omit) MRDC_SecondaryCellGroupConfig.mrdc_ReleaseAndAdd  p_ReleaseAndAdd := omit,
                                                                                                                    template (value) octetstring p_MRDC_RRCReconfiguration
                                                                                                                   ) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    setup := {
        mrdc_ReleaseAndAdd        :=  p_ReleaseAndAdd,
        mrdc_SecondaryCellGroup   := {
            nr_SCG :=  p_MRDC_RRCReconfiguration
        }
    }
  };

  template (value) RRCReconfiguration_v1560_IEs.mrdc_SecondaryCellGroupConfig cs_MRDC_SecondaryCellGroupConfigRelease :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    release := NULL
  };

