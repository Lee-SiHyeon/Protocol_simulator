module MCX_XML_mcpttregroup {

  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from urn_3gpp_ns_preconfiguredRegroup_1_0 language "XSD" all;

  type Mcpttregroup McpttRegroup_Type;    /* defined to avoid the need to import urn_3gpp_ns_preconfiguredRegroup_1_0 in MCX_MIME_Functions
                                             @status    APPROVED (MCX) */

  type record Mcpttregroup_ElementsToBeEncrypted_Type {                                                 /* @status    APPROVED (MCX) */
    charstring Element,
    charstring SubElement
  };

  type record of Mcpttregroup_ElementsToBeEncrypted_Type Mcpttregroup_ElementsToBeEncryptedList_Type;   /* @status    APPROVED (MCX) */

  const Mcpttregroup_ElementsToBeEncryptedList_Type tsc_Mcpttregroup_EncryptedElements := {
    /* @status    APPROVED (MCX) */
    { "preconfig-group-id", "preconfigured-group" },
    { "mcptt-regroup-uri", "mcptt-regroup-uri" },
    { "groups-for-regroup", "group" },
    { "users-for-regroup", "user" }
  };

  /*
   * @desc      Encode Mcpttregroup
   * @param     p_Mcpttregroup
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_Mcpttregroup_Encode(template (value) Mcpttregroup p_Mcpttregroup) return XmlBody_Type
  {
    var bitstring v_EncodedMcpttregroup := encvalue(p_Mcpttregroup);
    return f_Bit2XmlBody(v_EncodedMcpttregroup);
  }

  /*
   * @desc      Encrypt elements of a list in the given document
   * @param     charstring          (by reference)
   * @param     p_XmlBasePath
   * @param     p_ElementCount
   * @param     p_MCServiceID
   * @param     p_CSK
   * @status    APPROVED (MCX)
   */
  function fl_MCX_Mcpttregroup_EncryptElementList(inout universal charstring p_XmlDocument,
                                                  charstring p_XmlBasePath,
                                                  integer p_ElementCount,
                                                  charstring p_MCServiceID,
                                                  MCX_SecurityKey_Type p_CSK)
  {
    var charstring v_XmlPath;
    var integer i;
    
    for (i := 0; i < p_ElementCount; i := i + 1) {
      v_XmlPath := p_XmlBasePath & "[" & int2str(i+1) & "]";
      f_XML_Document_EncryptElementContent(p_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);
    }
  }

  /*
   * @desc      Encode and encrypt Mcpttregroup
   * @param     p_Mcpttregroup
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_Mcpttregroup_EncodeEncrypt(template (value) Mcpttregroup p_Mcpttregroup,
                                            charstring p_MCServiceID,
                                            template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := fl_MCX_Mcpttregroup_Encode(p_Mcpttregroup);
    var MCX_SecurityKey_Type v_CSK;
    var charstring v_XmlPath;
    var charstring v_ElementName;
    var charstring v_SubElementName;
    var integer v_ElementCount;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    
    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      v_CSK := valueof(p_CSK);

      for (i := 0; i < lengthof(tsc_Mcpttregroup_EncryptedElements); i := i + 1) {
        v_ElementName := tsc_Mcpttregroup_EncryptedElements[i].Element;
        v_SubElementName := tsc_Mcpttregroup_EncryptedElements[i].SubElement;
        v_XmlPath := "//mcpttregroup/mcpttregroup-Params/" & v_ElementName & "/" & v_SubElementName;
        select (v_ElementName) {
          case ("preconfig-group-id", "mcptt-regroup-uri") {
            f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, v_CSK);  // v_XmlDocument: inout parameter
          }
          case ("groups-for-regroup") {
            if (isvalue(p_Mcpttregroup.mcpttregroup_Params.groups_for_regroup)) {
              v_ElementCount := lengthof(p_Mcpttregroup.mcpttregroup_Params.groups_for_regroup.group_list);
              fl_MCX_Mcpttregroup_EncryptElementList(v_XmlDocument, v_XmlPath, v_ElementCount, p_MCServiceID, v_CSK);  // v_XmlDocument: inout parameter
            }
          }
          case ("users-for-regroup") {
            if (isvalue(p_Mcpttregroup.mcpttregroup_Params.users_for_regroup)) {
              v_ElementCount := lengthof(p_Mcpttregroup.mcpttregroup_Params.users_for_regroup.user_list);
              fl_MCX_Mcpttregroup_EncryptElementList(v_XmlDocument, v_XmlPath, v_ElementCount, p_MCServiceID, v_CSK);  // v_XmlDocument: inout parameter
            }
          }
        }
      }
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

}
