module IMS_XML_PIDF_Templates {

  import from CommonDefs all;
  import from XSD all;
  import from urn_ietf_params_xml_ns_pidf language "XSD" all;

  type Presence_1              PIDF_Presence_Type;                 /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  type Tuple                   PIDF_Tuple_Type;                    /* @status    APPROVED (MCX) */

  type Tuple.note_list         PIDF_Tuple_Note_List_Type;          /* @status    APPROVED (MCX) */

  type Status                  PIDF_Status_Type;                   /* @status    APPROVED (MCX) */

  type Status.elem_list        PIDF_Status_ElemList_Type;          /* @status    APPROVED (MCX) */

  type Basic                   PIDF_Basic_Type;                    /* @status    APPROVED (MCX) */

  template (present) PIDF_Status_Type cr_PIDF_Status(template PIDF_Basic_Type p_PIDF_Basic := *,
                                                     template (present) PIDF_Status_ElemList_Type p_PIDF_Status_ElemList := ?) :=
  { /* @status    APPROVED (MCX) */
    basic := p_PIDF_Basic,
    elem_list := p_PIDF_Status_ElemList
  };

  template (present) PIDF_Tuple_Type cr_PIDF_Tuple(template AnyURI p_Id := ?,
                                                   template (present) PIDF_Status_Type p_PIDF_Status := ?,
                                                   template Contact p_Contact := *,
                                                   template (present) PIDF_Tuple_Note_List_Type p_PIDF_Notes := ?,
                                                   template DateTime p_Timestamp := *) :=
  { /* @status    APPROVED (MCX) */
    id := p_Id,
    status := p_PIDF_Status,
    elem_list := {},
    contact := p_Contact,
    note_list := p_PIDF_Notes,
    timestamp := p_Timestamp
  };

  template (present) PIDF_Presence_Type cr_PIDF_Presence_SingleTuple(template (present) AnyURI p_Entity := ?,
                                                                     template (present) PIDF_Tuple_Type p_Tuple := ?,
                                                                     template (present) PIDF_Presence_Type.elem_list p_ElemList := {}) :=
  { /* @status    APPROVED (MCX) */
    entity := p_Entity,
    tuple_list := { p_Tuple },
    note_list := {},
    elem_list := p_ElemList
  };

  /*
   * @desc      Decode PIDF
   * @param     p_XmlBody
   * @return    PIDF_Presence_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_PIDF_Decode(charstring p_XmlBody) return PIDF_Presence_Type
  {
    var bitstring v_BitStr := oct2bit(char2oct(p_XmlBody));
    var Presence v_PIDF_Presence;  /* @sic R5s230374: Presence instead of PIDF_Presence_Type sic@ */

    if (decvalue(v_BitStr, v_PIDF_Presence) != 0) {
      FatalError(__FILE__, __LINE__, "Presence (PIDF) cannot be decoded");
    }
    return v_PIDF_Presence;
  }

}
