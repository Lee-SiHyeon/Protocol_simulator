  function fl_Build_cs_GNSS_ID_BDS_r16(IntegerList_Type p_SatelliteIdList,
                                   GNSS_ID_BDS_r16 p_ProvidedGNSS_ID_BDS) return template (value) GNSS_ID_BDS_r16
