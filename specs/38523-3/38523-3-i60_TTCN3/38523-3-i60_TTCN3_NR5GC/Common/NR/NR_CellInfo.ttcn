   */
  function f_NR_RetrieveBWP_UplinkCommon(NR_UplinkBWP_Type p_UL_BWP) return BWP_UplinkCommon
  {
    return p_UL_BWP.Common.R15;
  }

  /*
   * @desc      Retrieve index of NR_DownlinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_DownlinkBWP_List_Type
   * @param     p_DL_BWPs
   * @param     p_BWP_Id
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_RetrieveDownlinkBWP_Index(template (omit) NR_DownlinkBWP_List_Type p_DL_BWPs,
                                           BWP_Id p_BWP_Id) return integer
  {
    var integer v_Index;
    var integer i;

    for (i := 0; i < lengthof(p_DL_BWPs); i := i + 1) {
      if (match(p_BWP_Id, p_DL_BWPs[i].Id)) {
        v_Index := i;
        break;
      }
    }
    if (not isbound(v_Index)) {
      FatalError(__FILE__, __LINE__, "No DL BWP found for given BWP_Id");
    }
    return v_Index;
  }

  /*
   * @desc      Retrieve ASP type NR_DownlinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_DownlinkBWP_List_Type
   * @param     p_DL_BWPs
   * @param     p_BWP_Id
   * @return    NR_DownlinkBWP_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveDownlinkBWP(NR_DownlinkBWP_List_Type p_DL_BWPs,
                                    BWP_Id p_BWP_Id) return NR_DownlinkBWP_Type
  {
    var integer i := fl_NR_RetrieveDownlinkBWP_Index(p_DL_BWPs, p_BWP_Id);
    return p_DL_BWPs[i];
  }

  /*
   * @desc      Retrieve index of NR_UplinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_UplinkBWP_List_Type
   * @param     p_UL_BWPs
   * @param     p_BWP_Id
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_RetrieveUplinkBWP_Index(template (omit) NR_UplinkBWP_List_Type p_UL_BWPs,
                                         BWP_Id p_BWP_Id) return integer
  {
    var integer v_Index;
