module MCData_SDS_MCX_IMS {

  import from IMS_Component all;
  import from MCDataMessage_TypeDefs all;
  import from MCData_CommonProcedures all;
  import from MCData_MCDataMessages all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_MIKEY_Messages all;
  import from MCX_Parameters all;
  import from MCX_XML_mcdata_info all;
  import from MCX_XML_resource_lists all;
  import from MIKEY_TypeDefs all;

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.MCData
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_MCData_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Short Data Service (SDS) / Standalone SDS Using Signalling Control Plane / One-to-one Standalone SDS / Client Originated (CO)
    var MCData_SignallingAndDataPayload_Type v_SignallingAndDataPayload;
    var template (present) MCData_Info_Type v_McdataInfoRX;
    var template (present) ResourceLists_Type v_ResourceLists;
    var template (present) MIKEY_Message v_MIKEY_Message;
    var template (present) MCData_Message v_SDS_SIGNALLING_PAYLOAD;
    var template (present) MCData_Message v_DATA_PAYLOAD;
    var template (value) MCData_Info_Type v_McdataInfoTX;
    var template (value) MCData_Message v_SDS_NOTIFICATION;

    f_MCX_Preamble_IMS(MCData, IPCAN_SignallingOnly);

    f_IMS_TestBody_Set(true);

    v_McdataInfoRX := cr_MCData_Info_1to1("one-to-one-sds");                    // Table 6.1.1.3.3-2: 36.579-1 Table 5.5.3.2.1-3, condition MCD_1to1
    v_ResourceLists := cr_MCX_ResourceLists_ANYCALL(px_MCData_ID_User_B);       // Default:           36.579-1 Table 5.5.3.3.1-3: Resource-lists from the UE for MCData
    v_MIKEY_Message := f_MIKEY_SAKKE_MessageRX_PrivateCall(MCData);             // Default:           36.579-1 Table 5.5.9.1-2A: MIKEY-SAKKE I_MESSAGE (Private call)
    v_DATA_PAYLOAD := cr_MCData_DATA_PAYLOAD;                                   // Table 6.1.1.3.3-4: 36.579-1 Table 5.5.3.9.2-1
    v_McdataInfoTX := cs_MCData_Info_Base;                                      // Default:           Table 5.5.3.2.2-3: MCData-Info from the SS

    // @siclog "Step 1 - 2" siclog@
    f_MCData_ConnectionSetup(IPCAN_MO_IMS_Signalling, "Make the UE (MCData client) send a standalone one-to-one SDS message with disposition request ""DELIVERY""");

    // @siclog "Step 2A - 2B" siclog@
    v_SDS_SIGNALLING_PAYLOAD := cr_MCData_SDS_SIGNALLING_PAYLOAD('1'H);         // Table 6.1.1.3.3-3: 36.579-1 Table 5.5.3.8.1-1, condition DELIVERED
    v_SignallingAndDataPayload := f_MCData_ReceiveMESSAGE_Send202Accepted(MCDataSDS, PCK, v_McdataInfoRX, -, v_ResourceLists, v_MIKEY_Message, v_SDS_SIGNALLING_PAYLOAD, v_DATA_PAYLOAD);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 4" siclog@
    v_SDS_NOTIFICATION := f_MCData_SDS_NOTIFICATION_TX('02'O,                   // Table 6.1.1.3.3-7: 36.579-1 Table 5.5.3.8.4-1, condition DELIVERED
                                                       v_SignallingAndDataPayload.Signalling.SDS_SIGNALLING_PAYLOAD);
    f_MCData_SendMESSAGE_Receive200OK(MCDataSDS, PCK, v_McdataInfoTX, v_SDS_NOTIFICATION);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    f_MCX_IPCAN_ReleaseConnection();

    // @siclog "Step 5" Void siclog@

    // @siclog "Step 6" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCData client) provide the disposition notification to the user?", "Step 6");

    // @siclog "Step 7" siclog@
    f_MCData_ConnectionSetup(IPCAN_MO_IMS_Signalling, "Make the UE (MCData client) send a standalone one-to-one SDS message with disposition request ""READ""");

    // @siclog "Step 8" siclog@
    v_SDS_SIGNALLING_PAYLOAD := cr_MCData_SDS_SIGNALLING_PAYLOAD('2'H);         // Table 6.1.1.3.3-10: 36.579-1 Table 5.5.3.8.1-1, condition READ
    v_SignallingAndDataPayload := f_MCData_ReceiveMESSAGE_Send202Accepted(MCDataSDS, PCK, v_McdataInfoRX, -, v_ResourceLists, v_MIKEY_Message, v_SDS_SIGNALLING_PAYLOAD, v_DATA_PAYLOAD);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    f_MCX_IPCAN_ReleaseConnection();

    f_MCX_IPCAN_StartSignalling(IPCAN_MT_IMS_Signalling);

    // @siclog "Step 9" Void siclog@

    // @siclog "Step 10" siclog@
    v_SDS_NOTIFICATION := f_MCData_SDS_NOTIFICATION_TX('03'O,                   // Table 6.1.1.3.3-12: 36.579-1 Table 5.5.3.8.4-1, condition READ
                                                       v_SignallingAndDataPayload.Signalling.SDS_SIGNALLING_PAYLOAD);
    f_MCData_SendMESSAGE_Receive200OK(MCDataSDS, PCK, v_McdataInfoTX, v_SDS_NOTIFICATION);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    
    f_MCX_IPCAN_ReleaseConnection();

    // @siclog "Step 11" Void siclog@

    // @siclog "Step 12" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCData client) provide the disposition notification to the user?", "Step 12");

    // @siclog "Step 13" siclog@
    f_MCData_ConnectionSetup(IPCAN_MO_IMS_Signalling, "Make the UE (MCData client) send a standalone one-to-one SDS message with disposition request ""DELIVERY AND READ""");

    // @siclog "Step 14" siclog@
    v_SDS_SIGNALLING_PAYLOAD := cr_MCData_SDS_SIGNALLING_PAYLOAD('3'H);         // Table 6.1.1.3.3-14: 36.579-1 Table 5.5.3.8.1-1, condition DELIVERED_READ
    v_SignallingAndDataPayload := f_MCData_ReceiveMESSAGE_Send202Accepted(MCDataSDS, PCK, v_McdataInfoRX, -, v_ResourceLists, v_MIKEY_Message, v_SDS_SIGNALLING_PAYLOAD, v_DATA_PAYLOAD);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    f_MCX_IPCAN_ReleaseConnection();

    f_MCX_IPCAN_StartSignalling(IPCAN_MT_IMS_Signalling);

    // @siclog "Step 15" Void siclog@

    // @siclog "Step 16" siclog@
    v_SDS_NOTIFICATION := f_MCData_SDS_NOTIFICATION_TX('04'O,                    // Table 6.1.1.3.3-16: 36.579-1 Table 5.5.3.8.4-1, condition DELIVERED_READ
                                                       v_SignallingAndDataPayload.Signalling.SDS_SIGNALLING_PAYLOAD);
    f_MCData_SendMESSAGE_Receive200OK(MCDataSDS, PCK, v_McdataInfoTX, v_SDS_NOTIFICATION);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    
    f_MCX_IPCAN_ReleaseConnection();

    // @siclog "Step 17" Void siclog@

    // @siclog "Step 18" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCData client) provide the disposition notification to the user?", "Step 18");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.3.MCData
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_3_MCData_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Short Data Service (SDS) / Standalone SDS Using Signalling Control Plane / Group Standalone SDS / Client Originated (CO)
    var MCData_SignallingAndDataPayload_Type v_SignallingAndDataPayload;
    var template (present) MCData_Info_Type v_McdataInfoRX;
    var template (present) MCData_Message v_SDS_SIGNALLING_PAYLOAD;
    var template (present) MCData_Message v_DATA_PAYLOAD;
    var template (value) MCData_Info_Type v_McdataInfoTX;
    var template (value) MCData_Message v_SDS_NOTIFICATION;
    var charstring v_ClientId;

    f_MCX_Preamble_IMS(MCData, IPCAN_SignallingOnly);

    f_IMS_TestBody_Set(true);

    v_ClientId := f_MCX_IMS_PTC_ClientId_GetValue();
    v_McdataInfoRX := cr_MCData_Info_group("group-sds", -, v_ClientId);         // Table 6.1.3.3.3-2: 36.579-1 Table 5.5.3.2.1-3, condition MCD_grp
    v_DATA_PAYLOAD := cr_MCData_DATA_PAYLOAD;                                   // Table 6.1.3.3.3-4: 36.579-1 Table 5.5.3.9.2-1
    v_McdataInfoTX := cs_MCData_Info_Base(-, -, -, px_MCData_Group_A_ID);       // Table 6.1.3.3.3-5: Table 5.5.3.2.2-3 MCData-Info from the SS with mcdata-calling-group-id := px_MCData_Group_A_ID

    // @siclog "Step 1" siclog@
    f_MCData_ConnectionSetup(IPCAN_MO_IMS_Signalling, "Make the UE (MCData client) send a group standalone SDS message with disposition request ""DELIVERY""");

    // @siclog "Step 2 - 2B" siclog@
    v_SDS_SIGNALLING_PAYLOAD := cr_MCData_SDS_SIGNALLING_PAYLOAD('1'H);         // Table 6.1.3.3.3-2A: 36.579-1 Table 5.5.3.8.1-1, condition DELIVERED
    v_SignallingAndDataPayload := f_MCData_ReceiveMESSAGE_Send202Accepted(MCDataSDS, GMK, v_McdataInfoRX, -, -, -, v_SDS_SIGNALLING_PAYLOAD, v_DATA_PAYLOAD);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3" Void siclog@

    // @siclog "Step 4" siclog@
    v_SDS_NOTIFICATION := f_MCData_SDS_NOTIFICATION_TX('02'O,                   // Table 6.1.3.3.3-6: 36.579-1 Table 5.5.3.8.4-1, condition DELIVERED
                                                       v_SignallingAndDataPayload.Signalling.SDS_SIGNALLING_PAYLOAD);
    f_MCData_SendMESSAGE_Receive200OK(MCDataSDS, GMK, v_McdataInfoTX, v_SDS_NOTIFICATION);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    f_MCX_IPCAN_ReleaseConnection();

    // @siclog "Step 5" Void siclog@

    // @siclog "Step 6" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCData client) provide the disposition notification to the user?", "Step 6");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.4.MCData
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_4_MCData_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Short Data Service (SDS) / Standalone SDS Using Signalling Control Plane / Group Standalone SDS / Client Terminated (CT)
    var template (value) MCData_Info_Type v_McdataInfoTX;
    var template (value) MCData_Message v_SDS_SIGNALLING_PAYLOAD;
    var template (value) MCData_Message v_DATA_PAYLOAD;
    var template (present) MCData_Info_Type v_McdataInfoRX;
    var template (present) ResourceLists_Type v_ResourceLists;
    var template (present) MCData_Message v_SDS_NOTIFICATION;

    f_MCX_Preamble_IMS(MCData, IPCAN_SignallingOnly);

    f_IMS_TestBody_Set(true);

    v_McdataInfoTX := cs_MCData_Info_group("group-sds");                        // Table 6.1.4.3.3-2: 36.579-1 Table 5.5.3.2.2-3, condition MCD_group
    v_DATA_PAYLOAD := cs_MCData_DATA_PAYLOAD;                                   // Table 6.1.4.3.3-4: 36.579-1 Table 5.5.3.9.2-2

    v_McdataInfoRX := cr_MCData_Info_Base(-, -, cr_MCData_Content_URI(px_MCData_Group_A_ID));   // Table 6.1.4.3.3-7: 36.579-1 Table 5.5.3.2.1-3 with mcdata-calling-group-id := px_MCData_Group_A_ID
    v_ResourceLists := cr_MCX_ResourceLists_ANYCALL(px_MCData_ID_User_B);                       // Default:           36.579-1 Table 5.5.3.3.1-3: Resource-lists from the UE for MCData

    f_MCData_ConnectionSetup(IPCAN_MT_IMS_Signalling);

    // @siclog "Step 1 - 1B" siclog@
    v_SDS_SIGNALLING_PAYLOAD := f_MCData_SDS_SIGNALLING_PAYLOAD_TX('1'H);       // Table 6.1.4.3.3-3: 36.579-1 Table 5.5.3.8.2-1, condition DELIVERED
    f_MCData_SendMESSAGE_Receive200OK(MCDataSDS, GMK, v_McdataInfoTX, v_SDS_SIGNALLING_PAYLOAD, v_DATA_PAYLOAD);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2" Void siclog@

    // @siclog "Step 3" siclog@
    v_SDS_NOTIFICATION := f_MCData_SDS_NOTIFICATION_RX('02'O,                   // Table 6.1.2.3.3-7: 36.579-1 Table 5.5.3.8.3-1, condition DELIVERED
                                                       v_SDS_SIGNALLING_PAYLOAD.SDS_SIGNALLING_PAYLOAD);
    f_MCData_ReceiveMESSAGE_Send202Accepted(MCDataSDS, GMK, v_McdataInfoRX, -, v_ResourceLists, -, v_SDS_NOTIFICATION);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    f_MCX_IPCAN_ReleaseConnection();

    // @siclog "Step 4" Void siclog@

    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCData client) provide the contents of the Payload IE to the user?", "Step 5");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

}
