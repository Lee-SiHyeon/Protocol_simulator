  /*
   * @desc      return the delta value of a particular cell
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (NR5GC)
   */
  function f_NR_MobileInfo_GetDeltaValueOfCell (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var integer v_DeltaValue;
    var DeltaValues_Type v_DeltaValues;

    select (p_NR_CellId) {
      case(nr_Cell1, nr_Cell2, nr_Cell4, nr_Cell11) { //NRf1
        v_DeltaValues := f_NR_MobileInfo_GetPrimaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf1;
      }
      case(nr_Cell3, nr_Cell12, nr_Cell23){ //NRf2
        v_DeltaValues := f_NR_MobileInfo_GetPrimaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf2;
      }
      case(nr_Cell6, nr_Cell13) { //NRf3
        v_DeltaValues := f_NR_MobileInfo_GetPrimaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf3;
      }
      case(nr_Cell14){ //NRf4
        v_DeltaValues := f_NR_MobileInfo_GetPrimaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf4;
      }
      case(nr_Cell10, nr_Cell30, nr_Cell31) { //NRf5
        v_DeltaValues := f_NR_MobileInfo_GetSecondaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf1;
      }
      case(nr_Cell28, nr_Cell29){ //NRf6
        v_DeltaValues := f_NR_MobileInfo_GetSecondaryDeltaValue();
        v_DeltaValue := v_DeltaValues.DeltaNRf1;
      }
      case else { FatalError(__FILE__, __LINE__, "Invalid NR CellId"); }
    }
    return v_DeltaValue;
  }

