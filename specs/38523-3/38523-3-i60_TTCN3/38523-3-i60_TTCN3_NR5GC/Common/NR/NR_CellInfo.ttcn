    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
   };

  /*
   * @desc      Assign Paging Cycle in SIB1 in NR_Cellinfo of the cell
   * @param     p_NR_CellId
   * @param     p_DefaultPagingCycle
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetSIB1_DefaultPagingCycle(NR_CellId_Type p_NR_CellId,
                                                     PCCH_Config.defaultPagingCycle p_DefaultPagingCycle) runs on NR_BASE_PTC
    { //@sic R5s200869 sic@
      var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

      v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pcch_Config.defaultPagingCycle:= p_DefaultPagingCycle;
      f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
    };

  /*
   * @desc      Assign PEI configuration in SIB1 in NR_Cellinfo of the cell acc. to TS38.508
   * @param     p_NR_CellId
   * @param     p_SubgroupConfig_r17 (default value: cs_SubgroupConfig_r17)
   * @param     p_LastUsedCellOnly_r17 (default value: omit)
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetSIB1_PEI(NR_CellId_Type p_NR_CellId,
                                      template (value) SubgroupConfig_r17 p_SubgroupConfig_r17 := cs_SubgroupConfig_r17,
                                      template (omit) PEI_Config_r17.lastUsedCellOnly_r17 p_LastUsedCellOnly_r17 := omit) runs on NR_BASE_PTC
    { //@sic R5-243493 sic@
      var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
      var integer v_Length_SearchSpaceArray := lengthof(v_NR_CellInfo.PhysicalParameters.DL_BWPs[0].Pdcch.SearchSpaceArray);
      var integer v_Length_CommonSearchSpaceList := lengthof(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch_ConfigCommon.setup.commonSearchSpaceList);
      var template (value) NR_DownlinkBWP_Type v_DownlinkBWP;
      var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
      var template (value) SearchSpace v_SearchSpace;
      var template (value) NR_SearchSpace_NrofCandidates_Type v_NR_SearchSpace_NrofCandidates := f_NR_Get_SearchSpace_NrofCandidates(f_NR_CellInfo_GetBandIndicator(p_NR_CellId),f_NR_CellInfo_GetChannelBandwidth(p_NR_CellId));  //@sic R5-250401 sic@
      var template (value) PDCCH_ConfigCommon.pei_ConfigBWP_r17 v_PEI_ConfigBWP_r17;

      v_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, tsc_NR_BWP_Id);
      if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
        //@sic R5-235375 sic@ - SearchSpace
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch_ConfigCommon.setup.commonSearchSpaceList[v_Length_CommonSearchSpaceList] :=
            valueof(cs_38508_SearchSpace(tsc_NR_SearchSpaceId_PEI,
                                         tsc_NR_ControlResourceSetId_Zero,
                                         cs_NR_SearchSpace_SearchSpaceType_CSS,  // TS 38.508-1, Table 4.6.3-162
                                         v_NR_SearchSpace_NrofCandidates,
                                         -, -));
        // commonSearchSpaceListExt2_r17 acc to 38.508-1 Table 4.6.3-96: commonSearchSpaceListExt2-r17 with condition PEI
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch_ConfigCommon.setup.commonSearchSpaceListExt2_r17 := valueof(cs_38508_CommonSearchSpaceListExt2_r17_PEI);

        // pei_ConfigBWP_r17 acc to 38.508-1 Table 4.6.3-96: pei-ConfigBWP-r17 with condition PEI
        select (v_SCS){
            case (kHz15) {v_PEI_ConfigBWP_r17 := cs_38508_PEI_ConfigBWP_Def_SCS15;}
            case (kHz30) {v_PEI_ConfigBWP_r17 := cs_38508_PEI_ConfigBWP_Def_SCS30;}
            case (kHz120){v_PEI_ConfigBWP_r17 := cs_38508_PEI_ConfigBWP_Def_SCS120;}
            case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSpacing");}
        }

        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch_ConfigCommon.setup.pei_ConfigBWP_r17 := valueof(v_PEI_ConfigBWP_r17);

        // DownlinkConfigCommonSIB.pei_Config_r17 acc. to Table 4.6.3-53: DownlinkConfigCommonSIB with condition PEI
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pei_Config_r17 := valueof(cs_38508_PEI_Config_r17(p_SubgroupConfig_r17, p_LastUsedCellOnly_r17)); //pei_Config_r17
      }

      // Set in the CellArray
      v_SearchSpace := cs_38508_SearchSpace(tsc_NR_SearchSpaceId_PEI, tsc_NR_ControlResourceSetId_Zero, cs_NR_SearchSpace_SearchSpaceType_CSS, cs_38508_NrofCandidates_Def);
      v_DownlinkBWP.Pdcch.SearchSpaceArray[v_Length_SearchSpaceArray] := cs_NR_BWP_SearchSpaceConfig_CSS_DCI_2_7(v_SearchSpace);

      f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
      f_NR_CellInfo_SetDownlinkBWP(p_NR_CellId, v_DownlinkBWP, tsc_NR_BWP_Id);
    };

  /*
   * @desc      Assign IE DownlinkConfigCommonSIB.pei_Config_r17 in SIB1 in NR_Cellinfo of the cell
   * @param     p_NR_CellId
   * @param     p_SubgroupConfig_r17 (default value: cs_SubgroupConfig_r17)
   * @param     p_LastUsedCellOnly_r17 (default value: omit)
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetSIB1_PEI_Config_r17(NR_CellId_Type p_NR_CellId,
                                                 template (value) SubgroupConfig_r17 p_SubgroupConfig_r17 := cs_SubgroupConfig_r17,
                                                 template (omit) PEI_Config_r17.lastUsedCellOnly_r17 p_LastUsedCellOnly_r17 := omit) runs on NR_BASE_PTC
    {
      var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

      if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pei_Config_r17 := valueof(cs_38508_PEI_Config_r17(p_SubgroupConfig_r17, p_LastUsedCellOnly_r17));
        f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
      }
    };

  /*
   * @desc      Assign TAC in the NR_CellInfo NAS parameters and in the nth PLMN entry in SIB1
   * @param     p_NR_CellId
   * @param     p_TrackingAreaCode  - Note: value omit is an unvalid scenario, to be used in specific TC
   * @param     p_PLMN_Entry        (default value: 0)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetTAC(NR_CellId_Type p_NR_CellId,
                                template (omit) TrackingAreaCode p_TrackingAreaCode,
                                integer p_PLMN_Entry := 0)
    runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (isvalue(p_TrackingAreaCode)) {
      v_NR_CellInfo.NAS_Parameters.TrackingAreaCode := valueof(p_TrackingAreaCode);
      if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){ //@sic R5s190067 sic@
        //@sic R5s211526 BASELINE MOVING 2021 sic@
        if (f_NR_MobileInfo_IsNTN()) { //@sic R5s260034 sic@
            // For NTN: acc to 38.508-1 Table 4.6.3-108: PLMN-IdentityInfoList -> set the value in trackingAreaList-r17
            v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList[p_PLMN_Entry].trackingAreaList_r17[0] := valueof(p_TrackingAreaCode);
        } else {
            v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList[p_PLMN_Entry].trackingAreaCode := valueof(p_TrackingAreaCode);
        }
        // SNPN
        if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16)){
          //Handle one SNPN entry by default
          v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16[0].trackingAreaCode_r16 := valueof(p_TrackingAreaCode);
        }
      }
    } else {
        //@sic R5s200067 sic@
        // else: no need to set NAS_Parameters.TrackingAreaCode to omit as it is an invalid scenario it is enough to do it in SIB1
        if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){ //@sic R5s200067 sic@
          if (f_NR_MobileInfo_IsNTN()) { //@sic R5s260034 sic@
            // For NTN: acc to 38.508-1 Table 4.6.3-108: PLMN-IdentityInfoList -> set the value in trackingAreaList-r17
             v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList[p_PLMN_Entry].trackingAreaList_r17 := omit;
          } else {
            //@sic R5s211526 BASELINE MOVING 2021 sic@
            v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList[p_PLMN_Entry].trackingAreaCode := omit;
          }
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Assign PLMN in the NR_CellInfo NAS parameters and in the nth PLMN entry in SIB1
   * @param     p_NR_CellId
   * @param     p_PLMN_Identity
   * @param     p_PLMN_Entry1       (default value: 0)
   * @param     p_PLMN_Entry2       (default value: 0)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetPLMN(NR_CellId_Type p_NR_CellId,
                                 PLMN_Identity p_PLMN_Identity,
                                 integer p_PLMN_Entry1 := 0,
                                 integer p_PLMN_Entry2 := 0)
    runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.NAS_Parameters.PLMN_Identity := p_PLMN_Identity;
    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
      //@sic R5s211526 BASELINE MOVING 2021 sic@
      v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList[p_PLMN_Entry1].plmn_IdentityList[p_PLMN_Entry2] := p_PLMN_Identity;
       // SNPN
       if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16)){
            //Handle one SNPN entry by default
            v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16[0].npn_IdentityList_r16[0].snpn_r16.plmn_Identity_r16 := p_PLMN_Identity; // @sic R5s250465 Ch. 3 sic@
      }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Assign PLMN in the NR_CellInfo NAS parameters and a complete PLMN-IdentityInfoList in SIB1
   * @param     p_NR_CellId
   * @param     p_PLMN_IdentityInfoList
   * @param     p_PLMN_Identity                  (default value: tsc_NR_HPLMN_Def)
   * @param     p_NPN_IdentityInfoList_r16       (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetPLMNIdentityInfo_List (NR_CellId_Type p_NR_CellId,
                                        template (value) PLMN_IdentityInfoList p_PLMN_IdentityInfoList,
                                        PLMN_Identity p_PLMN_Identity := tsc_NR_HPLMN_Def,
                                        template (omit) NPN_IdentityInfoList_r16 p_NPN_IdentityInfoList_r16 := omit)
       runs on NR_BASE_PTC
  {
     var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

     v_NR_CellInfo.NAS_Parameters.PLMN_Identity := p_PLMN_Identity;

     if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityInfoList := valueof(p_PLMN_IdentityInfoList);

         // SNPN
         if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16)){
              //Handle one SNPN entry by default
              v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.npn_IdentityInfoList_r16 := valueof(p_NPN_IdentityInfoList_r16);
        }
     }

     f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Assign the parameterised PRACH configuration index in the CellArray UL BWP and SIB1(if available) of the cell
   * @param     p_NR_CellId
   * @param     p_PrachConfigurationIndex
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_SetPRACH_ConfigurationIndex(NR_CellId_Type p_NR_CellId,
                                                     integer p_PrachConfigurationIndex
                                                     ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP (p_NR_CellId, tsc_NR_BWP_Id); //Initial BWP

    if ((p_PrachConfigurationIndex > 255) or (p_PrachConfigurationIndex < 0)) {
      FatalError(__FILE__, __LINE__, "Parameter prach-ConfigurationIndex out of range(0..255)");
    }
    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){
      v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.rach_ConfigGeneric.prach_ConfigurationIndex := p_PrachConfigurationIndex;
    }
    v_NR_UplinkBWP.Common.R15.rach_ConfigCommon.setup.rach_ConfigGeneric.prach_ConfigurationIndex := p_PrachConfigurationIndex;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo); //@sic R5s190455 sic@
    f_NR_CellInfo_SetUplinkBWP(p_NR_CellId, v_NR_UplinkBWP, tsc_NR_BWP_Id);
   }

  /*
   * @desc      Assign the parameterised PRACH configuration index in the CellArray UL BWP and SIB1(if available) of the cell
   * @param     p_NR_CellId
   * @param     p_ZeroCorrelationZoneConfig
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_SetZeroCorrelationZoneConfig(NR_CellId_Type p_NR_CellId,
                                                     integer p_ZeroCorrelationZoneConfig
                                                     ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP (p_NR_CellId, tsc_NR_BWP_Id); //Initial BWP

    if ((p_ZeroCorrelationZoneConfig > 15) or (p_ZeroCorrelationZoneConfig < 0)) {
      FatalError(__FILE__, __LINE__, "Parameter zeroCorrelationZoneConfig out of range(0..15)");
    }
    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){
      v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.rach_ConfigGeneric.zeroCorrelationZoneConfig := p_ZeroCorrelationZoneConfig;
    }
    v_NR_UplinkBWP.Common.R15.rach_ConfigCommon.setup.rach_ConfigGeneric.zeroCorrelationZoneConfig := p_ZeroCorrelationZoneConfig; //@sic R5s200558 sic@
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo); //@sic R5s190455 sic@
    f_NR_CellInfo_SetUplinkBWP(p_NR_CellId, v_NR_UplinkBWP, tsc_NR_BWP_Id);
   }

  /*
   * @desc      Assign PLMN in the NR_CellInfo NAS parameters and in the nth PLMN entry in SIB1
   * @param     p_NR_CellId
   * @param     p_MultiFrequencyBandListNR_SIB
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_FrequencyBandlist(NR_CellId_Type p_NR_CellId,
                                                   MultiFrequencyBandListNR_SIB p_MultiFrequencyBandListNR_SIB
                                                   ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
      v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList := p_MultiFrequencyBandListNR_SIB;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set ConnEstFailureControl value stored in SIB1
   * @param     p_NR_CellId
   * @param     p_ConnEstFailureControl
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_ConnEstFailureControl(NR_CellId_Type p_NR_CellId,
                                                       template (omit) ConnEstFailureControl p_ConnEstFailureControl) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.connEstFailureControl:= valueof(p_ConnEstFailureControl);
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
