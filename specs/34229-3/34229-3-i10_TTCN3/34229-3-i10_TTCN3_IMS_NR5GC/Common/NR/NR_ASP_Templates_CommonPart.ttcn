module NR_ASP_Templates_CommonPart {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_CommonDefs all;

  const boolean tsc_FollowOnFlag := true;     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const boolean tsc_NoFollowOnFlag := false;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RoutingInfo_Type crs_NR_RoutingInfo_None := { None := true };                                                                                /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RoutingInfo_Type cs_NR_RoutingInfo_RbId(template (value) NR_RadioBearerId_Type p_RadioBearerId) := { RadioBearerId := p_RadioBearerId };     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (present) NR_RoutingInfo_Type cr_NR_RoutingInfo_RbId(template (present) NR_RadioBearerId_Type p_RadioBearerId) := { RadioBearerId := p_RadioBearerId }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RadioBearerId_Type cs_NR_RadioBearerId_DRB(DRB_Identity p_DrbId) := {Drb := p_DrbId};                        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (present) NR_CnfAspCommonPart_Type cr_NR_CnfAspCommonPart(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    CellId := p_NR_CellId,
    RoutingInfo := { None := true },
    TimingInfo := ?,
    Result := { Success := true }
  };

  template (value) NR_ReqAspCommonPart_Type cs_NR_ReqAspCommonPart(NR_CellId_Type p_NR_CellId,
                                                                   template (value) NR_RoutingInfo_Type p_RoutingInfo := crs_NR_RoutingInfo_None,
                                                                   template (value) RlcBearerRouting_Type p_RlcBearerRouting := crs_RlcBearerRouting_None,
                                                                   template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                   template (omit) boolean p_CnfFlag := omit,
                                                                   boolean p_FollowOnFlag := false,
                                                                   template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                                                   ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-213516 sic@
    CellId := p_NR_CellId,
    RoutingInfo := p_RoutingInfo,
    RlcBearerRouting := p_RlcBearerRouting,
    MacBearerRouting := p_MacBearerRoutingCA,
    TimingInfo := p_TimingInfo,
    ControlInfo := {
      CnfFlag := f_CnfFlag_Set(p_TimingInfo, p_CnfFlag),
      FollowOnFlag := p_FollowOnFlag
    }
  };

  template (value) NR_ReqAspCommonPart_Type cs_NR_ReqAspCommonPart_CellCfg(NR_CellId_Type p_NR_CellId,
                                                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                           template (omit) boolean p_CnfFlag := omit,
                                                                           boolean p_FollowOnFlag := false) :=
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_ReqAspCommonPart(p_NR_CellId, crs_NR_RoutingInfo_None, crs_RlcBearerRouting_None, p_TimingInfo, p_CnfFlag, p_FollowOnFlag);

  template (present) NR_IndAspCommonPart_Type cr_NR_IndAspCommonPart(template (present) NR_CellId_Type p_NR_CellId,
                                                                     template (present) NR_RoutingInfo_Type p_RoutingInfo,
                                                                     template (present) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                     template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                     template (omit)    NR_RoutingInfoSUL_Type p_NR_RoutingInfoSUL := omit,
                                                                     template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                     ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-213516 sic@
    CellId := p_NR_CellId,
    RoutingInfo := p_RoutingInfo,
    RoutingInfoSUL := p_NR_RoutingInfoSUL,
    RlcBearerRouting := p_RlcBearerRouting,
    MacBearerRouting := p_MacBearerRoutingCA,
    TimingInfo := p_TimingInfo,
    Status := cs_IndicationStatus_NoError
  };

}
