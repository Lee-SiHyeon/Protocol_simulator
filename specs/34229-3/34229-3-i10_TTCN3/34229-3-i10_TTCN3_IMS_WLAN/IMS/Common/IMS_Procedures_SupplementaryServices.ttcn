module IMS_Procedures_SupplementaryServices {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_Parameters all;
  import from IMS_CommonDefs all;
  import from IMS_Component all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_RegistrationCommon all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from LibSip_SimpleMsgSummaryTypes all;

  /*
   * @desc      check From header to be anonymous
   * @param     p_MessageHeader
   * @status    APPROVED (IMS)
   */
  function f_IMS_MessageHeader_CheckFromAnonymous(MessageHeader p_MessageHeader) runs on IMS_PTC
  {
    var template (present) From v_From_Anonymous := cr_From(cr_DisplayName("Anonymous"),
                                                            cr_SipUrl_Common(c_sipScheme,
                                                                             cr_SipUriComponent(cr_UserInfo("anonymous", omit),
                                                                                                "anonymous.invalid")));
    if (not match(p_MessageHeader.fromField, v_From_Anonymous)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid From header");
    }
  }

  type enumerated PrivacyCheckType_Type { idOnly, idOrHeader }; /* @status    APPROVED (IMS) */

  /*
   * @desc      Check privacy header
   * @param     p_MessageHeader
   * @param     p_PrivacyCheckType  (default value: idOnly)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MessageHeader_CheckPrivacy(MessageHeader p_MessageHeader,
                                            PrivacyCheckType_Type p_PrivacyCheckType := idOnly) runs on IMS_PTC
  { /* @sic R5-194827: p_PrivacyCheckType sic@ */
    var boolean v_PrivacyMatchId := match(p_MessageHeader.privacy, cr_Privacy("id"));
    var boolean v_PrivacyMatchHeader;
    var boolean v_Result;

    select (p_PrivacyCheckType) { /* @sic R5-194827 sic@ */
      case (idOnly) {
        v_Result := v_PrivacyMatchId;
      }
      case (idOrHeader) {
        v_PrivacyMatchHeader := match(p_MessageHeader.privacy, cr_Privacy("header"));
        v_Result := (v_PrivacyMatchId xor v_PrivacyMatchHeader);
      }
    }

    if (not v_Result) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid or missing Privacy header");
    }
  }

  template (value) Msg_summary_line cs_MsgSummaryLine_VoiceMessage(charstring p_Msgs,
                                                                   charstring p_UrgentMsgs := "0/0") :=
  { /* @status    APPROVED (IMS) */
    msg_context_class := c_voiceMessage,
    msgs := p_Msgs,
    urgent_msgs := p_UrgentMsgs
  };

  template (value) SimpleMsgSummary cs_SimpleMsgSummary_MessageWaiting(charstring p_Status,
                                                                       charstring p_AccountURI,
                                                                       template (omit) Msg_summary_line_list p_MsgSummaryLineList := omit,
                                                                       template (omit) Opt_msg_headers p_SetOfOptionalLines := omit) :=
  { /* @status    APPROVED (IMS) */
    // RFC 3842
    msg_status_line := {
      msg_type := c_messageWaiting,
      msg_status := p_Status
    },
    msg_account := {
      msg_type_account := c_messageAccount,
      account_URI := p_AccountURI
    },
    msg_summary_line_list := p_MsgSummaryLineList,
    opt_msg_headers := p_SetOfOptionalLines
  };

  template (value) MessageBody cs_MessageBody_SimpleMsgSummary(template (value) SimpleMsgSummary p_SimpleMsgSummary) :=
  { /* @status    APPROVED (IMS) */
    simpleMsgSummary := p_SimpleMsgSummary
  };

  /*
   * @desc      Build up message to be sent with NOTIFY for MWI (Message Waiting Indication)
   * @param     p_FromUrl
   * @param     p_MessageServerDomain
   * @return    Opt_msg_headers
   * @status    APPROVED (IMS)
   */
  function fl_IMS_MWI_Message(SipUrl p_FromUrl,
                              charstring p_MessageServerDomain) return Opt_msg_headers
  {
    var Opt_msg_headers v_SetOfOptionalLines := {
      "To: " & f_SIP_SipUrl2Str(p_FromUrl),
      "From: <user2_public1@home1.net>",
      "Subject: call me back!",
      "Message-ID: 27775334485@" & p_MessageServerDomain,
      "Message-Context: voice-message",
      "Date: Fri 09 Dec 2016 09:15 +0100",        // @sic R5-168947 sic@
      "Priority: urgent"                          // @sic R5-168947 sic@
    };
    return v_SetOfOptionalLines;
  }

  /*
   * @desc      send NOTIFY for Message Waiting Indication event package (34.229-1 A.6.2); receive 200 OK
   * @param     p_SubscribeRequest
   * @param     p_MessageWaiting
   * @status    APPROVED (IMS)
   */
  function f_IMS_MWI_Notify(SUBSCRIBE_Request p_SubscribeRequest,
                            boolean p_MessageWaiting) runs on IMS_PTC
  {  /* A.6.2 prose issues: A.6.2 specifies a pure DL message
        - Via header: there shall be nothing "optional"
        - From header: shall be clearly specified (i.e. not "any IMPU" but e.g. "same URI as sent by the UE in the To header of the SUBSCRIBE")
        - To header: as From header (e.g. "same URI as sent by the UE in the From header of the SUBSCRIBE")
        - Contact header: shall not be a PIXIT
        - Message Body: shall refer to "same IMPU as in From header" (@sic see R5-150705 sic@) */
    /* @sic R5-153756, R5-153986: p_CseqValue removed as global msgSummaryDialog is used instead sic@ */
    /* @sic R5-210664: p_MessageWaiting instead of p_MessageContent sic@ */
    var template (value) MessageHeader v_MessageHeader_Notify;
    var template (present) MessageHeader v_MessageHeader_Response;
    var charstring v_MessageServerDomain := f_IMS_PTC_ImsInfo_GetHomeDomainName();  /* @sic R5-210664: v_MessageServerDomain instead of p_MessageServerDomain sic@ */
    var charstring v_NW_AddrStr := f_IMS_PTC_NW_Address_GetAddrStr();
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    var CharStringList_Type v_ViaAddressList := { v_NW_AddrStr, tsc_IMS_Scscf, v_MessageServerDomain };
    var template (value) Via v_Via := f_IMS_NotifyRequest_ViaTX(v_ViaAddressList);    /* @sic R5-153986: new function f_IMS_NotifyRequest_ViaTX sic@ */
    var template (value) SipUrl v_RequestLineUrl := f_MessageHeader_GetContactSipUrl(p_SubscribeRequest.msgHeader);
    var template (value) SipUrl v_ContactSipUrl := cs_SipUri_HostPort("Contact@" & v_MessageServerDomain);       /* @sic R5-153764 sic@ */
    var template (value) ContentType v_ContentType := cs_ContentType("application/simple-message-summary");  /* @sic R5-153756 sic@ */
    var EventType v_EventType := "message-summary";
    var Opt_msg_headers v_Message;
    var SipUrl v_SubscribeFromUrl;
    var charstring v_AccountURI;
    var template (value) SimpleMsgSummary v_SimpleMsgSummary;
    
    v_MessageHeader_Notify := f_IMS_NotifyRequest_MessageHeader_Common(msgSummaryDialog, v_Via, cs_Contact(v_ContactSipUrl), v_EventType, cs_SubscriptionState_Active("7200"), v_ContentType);
    v_AccountURI := f_SIP_SipUrl2Str(f_Addr_Union_GetSipUrl(v_MessageHeader_Notify.fromField.addressField));

    if (not p_MessageWaiting) {
      v_SimpleMsgSummary := cs_SimpleMsgSummary_MessageWaiting("no", v_AccountURI);
    } else {
      v_SubscribeFromUrl := f_Addr_Union_GetSipUrl(p_SubscribeRequest.msgHeader.fromField.addressField);
      v_Message := fl_IMS_MWI_Message(v_SubscribeFromUrl, v_MessageServerDomain);
      v_SimpleMsgSummary := cs_SimpleMsgSummary_MessageWaiting("yes", v_AccountURI, {cs_MsgSummaryLine_VoiceMessage("1/0")}, v_Message);
    }
    
    IMS_Client.send(cas_IMS_Notify_Request(cs_IMS_RoutingInfo(v_Protocol), cs_NOTIFY_Request(v_RequestLineUrl, v_MessageHeader_Notify,  cs_MessageBody_SimpleMsgSummary(v_SimpleMsgSummary))));
    
    v_MessageHeader_Response := f_IMS_OtherResponse_200_MessageHeaderRX(v_MessageHeader_Notify);
    f_IMS_ReceiveResponse(v_MessageHeader_Notify, v_Protocol, cr_Response(c_statusLine200, v_MessageHeader_Response));  /* @sic R5s140350 sic@ */
  }

  /*
   * @desc      Receive SUBSCRIBE for MWI and reg even and send the corresponding 200 OK responses
   * @return    SUBSCRIBE_Request
   * @status    APPROVED (IMS)
   */
  function f_IMS_MWI_Subscribe() runs on IMS_PTC return SUBSCRIBE_Request
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ_ByRef;
    var SUBSCRIBE_Request v_SubscribeReq_MsgSummaryEvent;
    var CharStringList_Type v_IMPU_List;

    var template (present) SipUrl v_RequestUrl_RegEvent := f_IMS_PTC_ImsInfo_GetSipUriSubscriptionRX();
    var template (present) SipUrl v_RequestUrl_MsgSummaryEvent := cr_SipUri_HostPort(?);        // to be checked after SUBSCRIBE has been received
    var template (present) SipUrl v_ToUrl_MsgSummaryEvent := cr_SipUri_HostPort(?);             // to be checked after SUBSCRIBE has been received
    var template (present) charstring v_ExpireTime := ?;                                        // value not to be checked acc. to A.6.1
    var template (present) MessageHeader v_ExpectedMessageHeaderMsgSummary := f_IMS_SubscribeRequest_MessageHeaderRX("message-summary", v_ToUrl_MsgSummaryEvent, v_ExpireTime);
    var template (present) MessageHeader v_ExpectedMessageHeaderRegEvent := f_IMS_SubscribeRequest_MessageHeaderRX("reg");
    var boolean v_SubcribedToRegEventPackage := false;
    var boolean v_SubcribedToMsgSummaryEventPackage := false;

    alt {
      // Step 1. UE subscribes to the Message Waiting Indication event package.
      [not v_SubcribedToMsgSummaryEventPackage] a_IMS_SUBSCRIBE_Request(v_IMS_DATA_REQ_ByRef, msgSummaryDialog, v_RequestUrl_MsgSummaryEvent, v_ExpectedMessageHeaderMsgSummary) {
        v_SubscribeReq_MsgSummaryEvent := v_IMS_DATA_REQ_ByRef.Request.Subscribe;
        
        if (px_IMS_MessageAccountIdentity != "") {
          v_IMPU_List := { px_IMS_MessageAccountIdentity };      /* UE shall use MessageAccountIdentity when configured */
        } else {
          v_IMPU_List := f_IMS_PTC_ImsInfo_GetAllIMPUs();        /* any IMPU within the set of IMPUs on ISIM if MessageAccountIdentity is not configured at the UE */
        }
        if (not f_IMS_PublicUserId_Match(v_IMPU_List, v_SubscribeReq_MsgSummaryEvent.requestLine.requestUri)) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid request URI");
        }
        if (not f_IMS_PublicUserId_Match(v_IMPU_List, f_Addr_Union_GetSipUrl(v_SubscribeReq_MsgSummaryEvent.msgHeader.toField.addressField))) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid request URI");
        }
        
        // Step 2. The SS responds SUBSCRIBE with 200 OK
        f_IMS_SUBSCRIBE_Response(msgSummaryDialog, v_IMS_DATA_REQ_ByRef, "7200");   /* @sic R5-155913: ExpireTime := "7200" sic@ */
        
        v_SubcribedToMsgSummaryEventPackage := true;
        if (not v_SubcribedToRegEventPackage) { repeat; }
      }
      // Step 2a. The UE subscribes to the registration event package.
      [not v_SubcribedToRegEventPackage] a_IMS_SUBSCRIBE_Request(v_IMS_DATA_REQ_ByRef, regEventDialog, v_RequestUrl_RegEvent, v_ExpectedMessageHeaderRegEvent) {
        
        // Step 2b. The SS responds with 200 OK
        f_IMS_SUBSCRIBE_Response(regEventDialog, v_IMS_DATA_REQ_ByRef);
        
        v_SubcribedToRegEventPackage := true;
        if (not v_SubcribedToMsgSummaryEventPackage) { repeat; }
      }
    }
    return v_SubscribeReq_MsgSummaryEvent;
  }

  /*
   * @desc      used in 15.27 and 15.28 to check alertInfo
   * @param     p_MessageHeader_Ringing
   * @param     p_AlertInfoUrl      (default value: "urn:alert:service:call-waiting")
   * @status    APPROVED (IMS)
   */
  function f_IMS_CommunicationWaiting_Check180Ringing(template (omit) MessageHeader p_MessageHeader_Ringing,
                                                      charstring p_AlertInfoUrl := "urn:alert:service:call-waiting") runs on IMS_PTC
  {
    var template (present) charstring v_AlertInfoUrl := p_AlertInfoUrl;  /* @sic R5s140092 change 1.2 - temporary solution: (p_AlertInfoUrl, "<" & p_AlertInfoUrl &">") sic@
                                                                            @sic R5w140111, slide 8: "<", ">" shall be handled by the codec sic@ */
    
    if (not ispresent(p_MessageHeader_Ringing)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "No 180 Ringing");
    }
    if (not match(valueof(p_MessageHeader_Ringing.alertInfo), cr_AlertInfo(v_AlertInfoUrl))) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid 'alertInfo'");
    }
  }

  /*
   * @desc      to modify the dialog in case of call forwarding
   * @param     p_CseqValue
   * @param     p_SessId            (default value: "22222222")
   * @param     p_SessVersion       (default value: 22222222)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MO_ComunicationForwarding_ModifyDialog(integer p_CseqValue,
                                                        charstring p_SessId := "22222222",
                                                        integer p_SessVersion := 22222222) runs on IMS_PTC
  { /* @sic R5-220229: p_SessId, p_SessVersion sic@ */

    var integer v_SessVersion := p_SessVersion - 1;  // session version is incremented before being used in SDP message

    // set new tag for the dialog:
    f_IMS_PTC_ImsInfo_DialogSetLocalTag(f_IMS_GenerateTag("INVITE-FORWARDED"));     /* @sic R5s140621 1st change: in terms of the response the To-tag in the local tag here sic@ */
    // cseq needs to be reset to the value of the INVITE (@sic R5s140621 2nd change sic@)
    f_IMS_PTC_ImsInfo_CseqSet(dialogRemote, p_CseqValue);
    
    // 15.8 Step 11 Send 183 Session Progress
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX(p_SessId);              /* @sic R5-150707 sic@ */
    f_IMS_PTC_ImsInfo_DialogSetSessVersionTX(v_SessVersion);    /* @sic R5-150707 sic@ */
    f_IMS_PTC_ImsInfo_DialogSetPrevSdpMessageTX(omit);
    f_IMS_PTC_ImsInfo_DialogSetPrevSdpMessageRX(omit);          /* @sic R5s150666, R5-153525 sic@ */
  }

}
