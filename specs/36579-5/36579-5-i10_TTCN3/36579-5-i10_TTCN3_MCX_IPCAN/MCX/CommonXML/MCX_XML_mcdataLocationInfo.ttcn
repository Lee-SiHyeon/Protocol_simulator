module MCX_XML_mcdataLocationInfo {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcdataLocationInfo_1_0 language "XSD" all;

  type urn_3gpp_ns_mcdataLocationInfo_1_0.Location_info MCData_LocationInfo_Type;                               /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcdataLocationInfo_1_0.TRequestedLocationType MCData_LocationInfo_RequestedLocation_Type;    /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCData_LocInfo_EncryptedCurrentLocationElements := {                            /* @status    APPROVED (MCX) */
    "CurrentServingEcgi",
    "NeighbouringEcgi",
    "MbmsSaId",
    "MbsfnArea",
    "CurrentCoordinate/longitude",
    "CurrentCoordinate/latitude"
  };

  template (value) MCData_LocationInfo_Type cs_MCData_LocationInfo_Configuration(template (value) TRequestedLocationType p_NonEmergencyLocationInformation := cs_MCData_RequestedLocation(10),
                                                                                 template (value) TriggeringCriteriaType p_TriggeringCriteria := cs_MCData_TriggeringCriteria) :=
  { /* 36.579-1 Table 5.5.3.4.2-2: Location-info (Configuration sent by the SS) */
    /* @status    APPROVED (MCX) */
    attr := omit,
    choice := {
      configuration := {
        configScope := full,
        attr := omit,
        nonEmergencyLocationInformation := p_NonEmergencyLocationInformation,
        emergencyLocationInformation := cs_MCData_RequestedLocation(5),
        triggeringCriteria := p_TriggeringCriteria,
        elem_list := {},
        anyExt := omit
      }
    }
  };

  template (value) MCData_LocationInfo_RequestedLocation_Type cs_MCData_RequestedLocation(XSD.PositiveInteger p_MinimumIntervalLength) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    servingEcgi := {},                // present
    neighbouringEcgi_list := { {} },  // present (at least one element)
    mbmsSaId := {},                   // present
    mbsfnArea := {},                  // present
    geographicalCoordinate := {},     // present
    minimumIntervalLength := p_MinimumIntervalLength,
    elem_list := {},
    anyExt := omit
  };

  template (value) TriggeringCriteriaType cs_MCData_TriggeringCriteria(template (omit) TIntegerAttributeType p_PeriodicReport := omit) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    cellChange := omit,
    trackingAreaChange := omit,
    plmnChange  := omit,
    mbmsSaChange  := omit,
    mbsfnAreaChange  := omit,
    periodicReport  := p_PeriodicReport,
    travelledDistance  := omit,
    mcdataSignallingEvent  := omit,
    geographicalAreaChange:= cs_MCData_GeographicalAreaChangeEmpty,
    elem_list := {},
    anyExt := omit
  };

  template (value) TGeographicalAreaChange cs_MCData_GeographicalAreaChangeEmpty :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    anyAreaChange := omit,
    enterSpecificAreaType := omit,          /* @sic R5s240535/R5-246423 BASELINE MOVING/CORRECTION Rel-18 2024: enterSpecificAreaType kept sic@ */
    exitSpecificAreaType := omit,           /* @sic R5s240535/R5-246423 BASELINE MOVING/CORRECTION Rel-18 2024: exitSpecificAreaType kept sic@ */
    elem_list := {},
    anyExt := omit
  };

  /*
   * @desc      Encode MCData Location Info
   * @param     p_LocationInfo
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_LocationInfo_Encode(template (value) Location_info p_LocationInfo) return XmlBody_Type
  {
    var bitstring v_EncodedLocationInfo := encvalue(p_LocationInfo);
    return f_Bit2XmlBody(v_EncodedLocationInfo);
  }

  /*
   * @desc      Encode and encrypt MCData Location Info Report (only the Report contains encrypted content)
   * @param     p_LocationInfo
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_LocationInfoReport_EncodeEncrypt(template (value) Location_info p_LocationInfo,
                                                     charstring p_MCServiceID,
                                                     template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_MCData_LocationInfo_Encode(p_LocationInfo);
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    for (i := 0; i < lengthof(tsc_MCData_LocInfo_EncryptedCurrentLocationElements); i := i + 1) {
      v_XmlPath := "//location-info/Report/CurrentLocation/" & tsc_MCData_LocInfo_EncryptedCurrentLocationElements[i];
      f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  /*
   * @desc      Decode MCData Location Info
   * @param     p_XmlDocument
   * @return    MCData_LocationInfo_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCData_LocationInfo_Decode(XSD.String p_XmlDocument) return MCData_LocationInfo_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XmlDocument);
    var Location_info v_Location_info;

    if (decvalue(v_Bitstring, v_Location_info) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCData Location-Info");
    }
    return v_Location_info;
  }

  /*
   * @desc      Decrypt and decode MCData Location-Info
   *            In general Location-Info sent by the UE is a Report which contains <CurrentLocation> with encrypted information
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    MCData_LocationInfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_LocationInfo_DecryptDecode(XmlBody_Type p_XmlDocument,
                                               charstring p_MCServiceID,
                                               template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return MCData_LocationInfo_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var charstring v_ElementName;
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      for (i := 0; i < lengthof(tsc_MCData_LocInfo_EncryptedCurrentLocationElements); i := i + 1) {
        v_ElementName := tsc_MCData_LocInfo_EncryptedCurrentLocationElements[i];
        v_XmlPath := "//location-info/Report/CurrentLocation/" & v_ElementName;
        v_DecryptResult := f_XML_Document_DecryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, valueof(p_CSK));  // v_XmlDocument: inout parameter
        if (v_DecryptResult == NOT_ENCRYPTED) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, v_ElementName & " is not encrypted");
        }
      }
      fx_XML_Log(__FILE__, __LINE__, UPLINK, v_XmlDocument);
    }

    return fl_MCData_LocationInfo_Decode(v_XmlDocument);
  }

}
