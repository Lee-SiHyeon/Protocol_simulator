module IMS_CC_TestcaseImplementation_8 {

  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_Procedures_Registration all;

  /*
   * @desc      Common Test body of test case 8.1
   * @status    APPROVED (IMS)
   */
  function f_IMS_InitialRegistration() runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;

    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    f_IMS_TestBody_Set(true);
    // Steps 1 to 4
    // @siclog "Step 1 - 4" siclog@
    v_IMS_REGISTER_REQ := f_IMS_Register_NonGIBA();
    // Steps 5 to 8
    // @siclog "Step 5 - 8" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ);

    f_IMS_TestBody_Set(false);
  }

}
