    filterCoefficientRSRP := fc4,
    filterCoefficientRSRQ := fc4,
    filterCoefficientRS_SINR := fc4
  };

  template (value) MeasObjectToAddMod cs_NR_MeasObjectToAddMod_NR(MeasObjectId p_MeasObjectId,
                                                                  template (value) MeasObjectNR p_MeasObject) :=
