  template (present) LogMeasInfo_r16 cr_LogMeasInfo_r16_Def(template LocationInfo_r16                        p_LocationInfo_r16 := *,
                                              template(present) integer                        p_RelativeTimeStamp_r16 := ?,
                                              template(present) CGI_Info_Logging_r16           p_ServCellIdentity_r16,
                                              template MeasResultServingCell_r16               p_MeasResultServCell_r16 := *,
                                              template MeasResultListLogging2NR_r16            p_MeasResultNeighCellListNR_r16 := *,
                                              template MeasResultList2EUTRA_r16                p_MasResultNeighCellListEUTRA_r16 := *,
                                              template LogMeasInfo_r16.anyCellSelectionDetected_r16     p_AnyCellSelectionDetected_r16 := omit,
                                              template LogMeasInfo_r16.inDeviceCoexDetected_r17         p_InDeviceCoexDetected_r17 := * ) :=
  { // @status    APPROVED (NR5GC, NR5GC_IRAT)
    // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
    locationInfo_r16                     := p_LocationInfo_r16,
    relativeTimeStamp_r16                := p_RelativeTimeStamp_r16,
    servCellIdentity_r16                 := p_ServCellIdentity_r16,
    measResultServingCell_r16            := p_MeasResultServCell_r16,
    measResultNeighCells_r16             :=  {
        measResultNeighCellListNR        :=  p_MeasResultNeighCellListNR_r16,
        measResultNeighCellListEUTRA     :=  p_MasResultNeighCellListEUTRA_r16
    },
    anyCellSelectionDetected_r16         := p_AnyCellSelectionDetected_r16,
    inDeviceCoexDetected_r17             := p_InDeviceCoexDetected_r17      // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
  };

  template LogMeasReport_r16 cr_LogMeasReport_r16(template(present) AbsoluteTimeInfo_r16                    p_AbsoluteTimeStamp_r16,
                                                           template(present) TraceReference_r16                      p_TraceReference_r16,
                                                           template(present) octetstring                             p_TraceRecordingSessionRef_r16,
                                                           template(present) octetstring                             p_Tce_Id_r16,
