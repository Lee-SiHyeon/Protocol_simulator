module MTC_Component_LTE_IRAT {

  import from CDMA2000_Component all;
  import from EUTRA_Component all;
  import from GERAN_Component all;
  import from IMS_Component all;
  import from IP_PTC_Component all;
  import from MTC_Base all;
  import from NasEmu_Component_EUTRA all;
  import from UTRAN_Component all;

  type record MTC_LTE_IRAT_Components_Type {             /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    /* NOTE: there is no reference for IMS since no IMS behaviour will happen when all RAT PTC are gone */
    EUTRA_PTC  Eutra,
    UTRAN_PTC  Utran,
    GERAN_PTC  Geran,
    CDMA2000_PTC Cdma2000                       /* @sic R5-104796 change 12: CDMA2000 added sic@ */
  };

  type component MTC_LTE_IRAT extends MTC_BASE {     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    var MTC_LTE_IRAT_Components_Type vc_Components;
    var IP_PTC vc_IP_PTC;                            /* @sic R5w160107 slide 7 sic@ */
    var IMS_PTC vc_ImsPdn1;                          /* @sic R5-163201: IMS for WLAN sic@ */
  };

  type component SYSTEM_LTE_IRAT extends MTC_BASE_SYSTEM, EUTRA_SYSTEM, UTRAN_SYSTEM, GERAN_SYSTEM, CDMA2000_SYSTEM, NASEMU_EUTRA_SYSTEM, IP_SYSTEM {};     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

}
