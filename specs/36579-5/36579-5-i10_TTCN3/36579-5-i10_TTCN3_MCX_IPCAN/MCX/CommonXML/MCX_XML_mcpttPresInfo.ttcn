module MCX_XML_mcpttPresInfo {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttPresInfo_1_0 language "XSD" all;   

  type urn_3gpp_ns_mcpttPresInfo_1_0.Affiliation MCPTT_Affiliation_Type;                      /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttPresInfo_1_0.StatusType MCPTT_Affiliation_Status_Type;                /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttPresInfo_1_0.P_id MCPTT_P_id_Type;                                    /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttPresInfo_1_0.AdditionalData MCPTT_AdditionalData_Type;                /* @status    APPROVED (MCX) */

  template (present) MCPTT_Affiliation_Type cr_MCPTT_Affiliation(XSD.AnyURI p_Group := px_MCPTT_Group_A_ID,
                                                                 template MCPTT_Affiliation_Status_Type p_Status := omit) :=
  { // Affilation according to 36.579-1 Table 5.5.3.5.1-1
    /* @status    APPROVED (MCX) */
    client := omit,
    expires := omit,
    group_ :=  p_Group,
    status := p_Status,
    attr := omit,
    elem_list := {}
  };

  template (value) MCPTT_Affiliation_Type cs_MCPTT_Affiliation(template (omit) XSD.AnyURI p_Client := omit,
                                                               template (omit) XSD.DateTime p_Expires := omit,
                                                               template (omit) XSD.AnyURI p_Group := omit,
                                                               template (omit) MCPTT_Affiliation_Status_Type p_Status := omit) :=
  { // Affilation according to 36.579-1 Table 5.5.3.5.2-1
    /* @status    APPROVED (MCX) */
    client := p_Client,
    expires := p_Expires,
    group_ :=  p_Group,
    status := p_Status,
    attr := omit,
    elem_list := {}
  };

  /*
   * @desc      encode MCPTT Affiliation
   * @param     p_Affiliation
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_Affiliation_Encode(template (value) urn_3gpp_ns_mcpttPresInfo_1_0.Affiliation p_Affiliation) return XSD.String
  {
    var bitstring v_EncodedAffiliation := encvalue(p_Affiliation);
    return f_Bit2XmlBody(v_EncodedAffiliation);
  }

  /*
   * @desc      Encrypt and encode MCPTT Affiliation
   * @param     p_Affiliation
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Affiliation_EncryptEncode(template (value) MCPTT_Affiliation_Type p_Affiliation,
                                             charstring p_MCServiceID,
                                             template (omit) MCX_SecurityKey_Type p_CSK) return XSD.String
  {
    var template (value) MCPTT_Affiliation_Type v_Affiliation := p_Affiliation;

    v_Affiliation.client := f_MCX_XML_EncryptOptionalAttributeUri(v_Affiliation.client, p_MCServiceID, p_CSK);
    v_Affiliation.group_ := f_MCX_XML_EncryptOptionalAttributeUri(v_Affiliation.group_, p_MCServiceID, p_CSK);

    return fl_MCPTT_Affiliation_Encode(v_Affiliation);
  }

  /*
   * @desc      Encode MCPTT P-Id
   * @param     p_P_id
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Affiliation_P_id_Encode(template (value) urn_3gpp_ns_mcpttPresInfo_1_0.P_id p_P_id) return XSD.String
  {
    var bitstring v_EncodedP_id := encvalue(p_P_id);
    return f_Bit2XsdString(v_EncodedP_id);
  }

  /*
   * @desc      Encode MCPTT AdditionalData
   * @param     p_AdditionalData
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Affiliation_AdditionalData_Encode(template (value) urn_3gpp_ns_mcpttPresInfo_1_0.AdditionalData p_AdditionalData) return XSD.String
  {
    var bitstring v_EncodedAdditionalData := encvalue(p_AdditionalData);
    return f_Bit2XsdString(v_EncodedAdditionalData);
  }

  /*
   * @desc      Decrypt MCPTT Affiliation
   * @param     p_Affiliation
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    template (value) MCPTT_Affiliation_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Affiliation_Decrypt(MCPTT_Affiliation_Type p_Affiliation,
                                       charstring p_MCServiceID,
                                       template (omit) MCX_SecurityKey_Type p_CSK) return template (value) MCPTT_Affiliation_Type
  {
    var template (value) MCPTT_Affiliation_Type v_Affiliation := p_Affiliation;

    v_Affiliation.client := f_MCX_XML_DecryptOptionalAttributeUri(v_Affiliation.client, p_MCServiceID, p_CSK);
    v_Affiliation.group_ := f_MCX_XML_DecryptOptionalAttributeUri(v_Affiliation.group_, p_MCServiceID, p_CSK);

    return v_Affiliation;
  }

}
