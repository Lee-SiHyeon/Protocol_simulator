module NR5GC_Positioning_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from CommonDefs all;
  import from NAS_CommonTypeDefs all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_POS_ASP_TypeDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_Measurement_Templates all;
  import from NR_RRC_BWP_Templates all;

  template (value) NG_NAS_DL_Message_Type cs_NG_RESETUEPOSITIONINGSTOREDINFORMATION(B8_Type p_UePosTech) :=
  { /* @status    APPROVED (POS) */
    /* 24.501 cl. 8.2.11 */
    reset_UE_Positioning_Stored_Information := {
      skipIndicator := '0000'B,                // "0000" skip indicator BITSTRING [4]
      protocolDiscriminator := '1111'B,        // M, "1111" Protocol discriminator for test procedure messages BITSTRING [4]
      msgType := '10001000'B,                  // M, "10001000" message type BITSTRING [8]
      uePositioningTech := p_UePosTech         // M
    }
  };

  template (value) MeasObjectNR cds_NR_MeasObjectNR_POS(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                                       ARFCN_ValueNR p_FrequencySSB,
                                                       SubcarrierSpacing p_SubcarrierSpacingSSB)  // @sic R5-227527 sic@
    modifies cs_NR_MeasObjectNR_Base :=
  { /* @status    APPROVED (POS) */
    ssbFrequency := p_FrequencySSB,
    ssbSubcarrierSpacing := p_SubcarrierSpacingSSB,
    freqBandIndicatorNR := omit
  };

  template (value) MeasConfig cs_NR_MeasConfig_MeasGap (ARFCN_ValueNR p_SSB_Freq, // @sic R5-227527 sic@
                                                        SubcarrierSpacing p_SubCarrierSpacing, // @sic R5-227527 sic@
                                                        template (omit) MeasGapConfig p_MeasGapConfig) :=
    /* @status    APPROVED (POS) */
    // Acc Table 8.3.1-2 TS 37.571-2
    cs_NR_MeasConfigCommon(-,
                           {cs_NR_MeasObjectToAddMod_NR(1, cds_NR_MeasObjectNR_POS(1, p_SSB_Freq, p_SubCarrierSpacing))},
                           -,-,-,-,-,-,
                           p_MeasGapConfig);

  template (value) GapConfig cs_NR_GapConfig_OTDOA := cs_NR_GapConfig(10, ms3, ms160, ms0); /*  @sic R5s221043 sic@
                                                                                                @status    APPROVED (POS) */

 template (value) AdditionalInformation cs_RoutingInfoNR (octetstring p_RoutingId) :=
  { /* @status    APPROVED (POS) */
    /* 24.501 cl. 9.11.2.1 */
    // @sic R5s201391 sic@
    iei := '24'O,
    iel := '04'O,
    additionalInfo := p_RoutingId
  };

  template (present) AdditionalInformation cr_RoutingInfoNR (octetstring p_RoutingId) :=
  { /* @status    APPROVED (POS) */
    /* 24.501 cl. 9.11.2.1 */
    // @sic R5s201391 sic@
    iei := '24'O,
    iel := '04'O,
    additionalInfo := p_RoutingId
  };

  template (value) UplinkConfig cs_NR_UplinkConfigSrs(template (value) SRS_Config p_SRS_Config) :=
  { /* Acc. 37.571-2, Table 8.3.2-2 */
    /* @status    APPROVED (POS) */
    initialUplinkBWP := cs_BWP_UplinkDedicated_Def(omit,
                                                   omit,
                                                   cs_NR_Srs_Config_Setup(p_SRS_Config)),
    uplinkBWP_ToReleaseList     := omit,
    uplinkBWP_ToAddModList      := omit,
    firstActiveUplinkBWP_Id     := omit,
    pusch_ServingCellConfig     := omit,
    carrierSwitching            := omit,
    powerBoostPi2BPSK           := omit,
    uplinkChannelBW_PerSCS_List := omit,
    enablePL_RS_UpdateForPUSCH_SRS_r16  := omit,
    enableDefaultBeamPL_ForPUSCH0_0_r16 := omit,
    enableDefaultBeamPL_ForPUCCH_r16    := omit,
    enableDefaultBeamPL_ForSRS_r16      := omit,
    uplinkTxSwitching_r16               := omit,
    mpr_PowerBoost_FR2_r16              := omit,
    srs_PosTx_Hopping_r18               := omit,     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    enablePL_RS_UpdateForType1CG_PUSCH_r18:= omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    powerBoostPi2BPSK_r18               := omit,     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    powerBoostQPSK_r18                  := omit      /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) SRS_Config cs_SRS_Config_Pos (template (value) SRS_PeriodicityAndOffset_r16 p_SRS_PeriodicityAndOffset) :=
  { /* @status    APPROVED (POS) */
    srs_ResourceSetToReleaseList := omit,
    srs_ResourceSetToAddModList := omit,
    srs_ResourceToReleaseList := omit,
    srs_ResourceToAddModList := omit,
    tpc_Accumulation := omit,
    srs_RequestDCI_1_2_r16                  := omit,
    srs_RequestDCI_0_2_r16                  := omit,
    srs_ResourceSetToAddModListDCI_0_2_r16  := omit,
    srs_ResourceSetToReleaseListDCI_0_2_r16 := omit,
    srs_PosResourceSetToReleaseList_r16     := omit,
    srs_PosResourceSetToAddModList_r16      := {cs_SRS_PosResourceSetElement},
    srs_PosResourceToReleaseList_r16        := omit,
    srs_PosResourceToAddModList_r16         := {cs_SRS_PosResourceElement(p_SRS_PeriodicityAndOffset)},
    dci_TriggeringPosResourceSetLink_r18    := omit /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) SRS_PosResourceSet_r16 cs_SRS_PosResourceSetElement :=
  { // Acc. 37.571-2, Table 8.3.2-3
    /* @status    APPROVED (POS) */
    srs_PosResourceSetId_r16 := 0,
    srs_PosResourceIdList_r16 := {0},
    resourceType_r16 := {
      periodic_r16 := {}
    },
    alpha_r16 := omit,
    p0_r16 := -100,
    pathlossReferenceRS_Pos_r16 := {
      ssb_IndexServing_r16 := 1
    }
  };

  template (value) SRS_PosResource_r16 cs_SRS_PosResourceElement (template (value) SRS_PeriodicityAndOffset_r16 p_SRS_PeriodicityAndOffset):=
  { // Acc. 37.571-2, Table 8.3.2-4    @sic R5-221593, R5-233395 sic@
   /* @status    APPROVED (POS) */
    srs_PosResourceId_r16 := 0,
    transmissionComb_r16 := {
      n4_r16 := {
        combOffset_n4_r16 := 0,
        cyclicShift_n4_r16 := 0
      }
    },
    resourceMapping_r16 := {
      startPosition_r16 := 1,
      nrofSymbols_r16 := n2
    },
    freqDomainShift_r16 := 0,
    freqHopping_r16 := {
      c_SRS_r16 := 0
    },
    groupOrSequenceHopping_r16 := neither,
    resourceType_r16 := {
      periodic_r16 := {
        periodicityAndOffset_p_r16 := p_SRS_PeriodicityAndOffset,
        periodicityAndOffset_p_Ext_r16 := omit,          /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
        srs_PosPeriodicConfigHyperSFN_Index_r18 := omit  /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      }
    },
    sequenceId_r16 := 0,
    spatialRelationInfoPos_r16 := {
      servingRS_r16 :=  {
        servingCellId := 0,
        referenceSignal_r16 := {
          ssb_IndexServing_r16  := 1
        }
      }
    },
    txHoppingConfig_r18 := omit  /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) DlPrs_FreqLayerConfig_Type cs_DlPrsFreqLayerConfig(integer p_ResourceBW := 1,
                                                                      DlPrs_CombSizeN_Type p_CombSizeN := n2) :=
  { /* @status    APPROVED (POS) */
    DlPrs_ResourceBW := p_ResourceBW,
    DlPrs_CombSizeN := p_CombSizeN
  };

  template (value) NR_SYSTEM_CTRL_POSEXT_REQ cas_NR_CellConfig_DlPrs_REQ(NR_CellId_Type p_CellId,
                                                                         template (value) DlPrs_FreqLayerConfig_Type p_FreqLayerConfig,
                                                                         template (value) DlPrs_TRPConfig_Type p_TrpConfig) :=
  { /* @status    APPROVED (POS) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_CellId), //Timing now
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Downlink := {
              DL_PRSConfig := {
                DlPrs_FreqLayerConfig := p_FreqLayerConfig,
                DlPrs_TRPConfig := p_TrpConfig,
                RelativeTxPower := {
                  DlPrsToSSS := 0   // Acc. 38.508-1, Table 6.2.1.2-1  @sic R5-234191 sic@
                }
              }
            }
          }
        }
      }
    }
  };

  template (present) NR_SYSTEM_CTRL_POSEXT_CNF car_NR_CellConfig_PosExt_CNF(NR_CellId_Type p_CellId) :=
  { /* @status    APPROVED (POS) */
    Common := cr_NR_CnfAspCommonPart(p_CellId),
    Confirm := {
      Cell := true
    }
  };

}
