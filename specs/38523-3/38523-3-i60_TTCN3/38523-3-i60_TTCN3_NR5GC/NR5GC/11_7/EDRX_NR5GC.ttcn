module EDRX_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SecuritySteps all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_7_1_NR5GC() runs on NR5GC_PTC
  {// eDRX / IDLE
    // @sic R5s240061 R5-240657 sic@
    f_NR5GC_Init(NR_1);
  
    //Table 11.7.1.3.3-1: SIB1
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1, true_);
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, '0000000000'B);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // UE supporting extended DRX.
    f_UT_SwitchOnUE(UT, false, CNF_REQUIRED);
    f_UT_ConfigureEDRX(UT, true, -, CNF_REQUIRED);
    f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);

    // UE is in state 0N-B according to TS 38.508-1 Table 4.4A.2-2
    f_NR5GC_Preamble (nr_Cell1, STATE_OFF_0B);
    
    f_NR_TestBody_Set(true);
    f_TC_11_7_1_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_11_7_1_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.1
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_7_1_NR5GC_TestBody() runs on NR5GC_PTC
   { // @sic R5-233411 R5-235344 R5s240061 sic@
    var template (value) ExtdDRXParams v_NegotiatedExtdDRXParams := cs_NG_NAS_EDRXParams('0000'B, '0101'B,'00000001'B); // Step 14 - Table 11.7.1.3.3-3: REGISTRATION ACCEPT
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_NAS_GutiParameters_Type v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(nr_Cell1);
    var NG_5G_S_TMSI v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);

    //@siclog "Step 1" siclog@
    // Switch on UE.
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 2-15" siclog@
    //Steps 2-3 of the generic procedure for NR RRC_IDLE as specified in TS 38.508-1 Table 4.5.2.2-2 are performed.
    //The UE transmits a REGISTRATION REQUEST message including the Requested extended DRX parameters IE
    //Steps 5-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed.
    //The SS transmits a REGISTRATION ACCEPT message including the Negotiated extended DRX parameters IE.
    //Check: Does the UE transmit a REGISTRATION COMPLETE message?
    f_NR5GC_RRC_Idle_Steps2_15_eDRX(nr_Cell1, v_NegotiatedExtdDRXParams);
    
    //@siclog "Steps 16-17" siclog@
    // Steps 19a1-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed.
    f_NR5GC_RRC_Idle_Steps16_20(nr_Cell1, -, -, rrcConnectionRelease);

    //@siclog "Step 18" siclog@
    // The SS transmits a Paging message within a valid paging occasion within the PTW of the next upcoming UE's PH as per Idle eDRX.
    f_NR5GC_UE_Page_eDRX(nr_Cell1,
                         cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)),
                         1, 5);

    //@siclog "Step 19" siclog@
    // Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.1 Step 19");

    //@siclog "Step 20" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 21" siclog@
    // The UE transmit an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);

    //@siclog "Step 22-25" siclog@
    // Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //@siclog "Step 26" siclog@
    // Switch off UE in RRC CONNECTED as described in TS 38.508-1 subclause 4.9.6.3
    f_NR_UE_DeRegisterOnSwitchOff(nr_Cell1, STATE_CONNECTED_3A);
    
    //@siclog "Step 27" siclog@
    // Switch on UE.
    f_NR5GC_SwitchOnAndResetIMS();
    
    //@siclog "Step 28-46" siclog@
    // The generic test procedure in TS 38.508-1 Table 4.5.2.2-2 indicate that the UE performs registration on NR Cell 1.
    v_NegotiatedExtdDRXParams := cs_NG_NAS_EDRXParams('0000'B, '0001'B, '00000001'B); // Step 31 - Table 11.7.1.3.3-4: REGISTRATION ACCEPT
    f_NR5GC_RRC_Idle_Steps2_15_eDRX(nr_Cell1, v_NegotiatedExtdDRXParams);
    f_NR5GC_RRC_Idle_Steps16_20(nr_Cell1, -, -, rrcConnectionRelease);
    
    //@siclog "Step 47" siclog@
    // The SS transmits a Paging message in a valid PO.
    f_NR5GC_UE_Page_eDRX(nr_Cell1,
                         cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)),
                         1, 1);
    
    //@siclog "Step 48" siclog@
    // Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.1 Step 48");

    //@siclog "Step 49" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 50" siclog@
    // The UE transmits an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);

    //@siclog "Step 51-54" siclog@
    // Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    
    //@siclog "Step 55" siclog@
    // The SS transmits an RRCRelease message to release RRC connection and move the UE to RRC_IDLE.
    f_NR_RRCRelease(nr_Cell1);
    
    //@siclog "Step 56" siclog@
    // The SIB1 is updated according to Table 11.7.1.3.3-1 and transmits a Short message on PDCCH using P-RNTI indicating a systemInfoModification.
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, omit); // return value by default
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1);
    f_NR_ModifySysinfo(nr_Cell1, true); //Modify Sysinfo in SS
    
    //@siclog "Step 57" siclog@
    //Wait for 2.1* modification period to allow the new system information to take effect.
    f_NR_WaitModificationPeriods (nr_Cell1);
    
    //@siclog "Step 58" siclog@
    // The SS transmits a Paging message to the UE in a valid PO which is derived by normal DRX and not belonging to extended DRX.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    //@siclog "Step 59" siclog@
    // Check: Does the UE send an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.1 Step 59");
    
    //@siclog "Step 60-65" siclog@
    // Steps 3-8 of Generic procedure specified in TS 38.508-1 Table 4.5.4.2-3 are performed.
    f_NR_RRCSetup_Def (nr_Cell1);
    
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, ?,- , *),
                                               tsc_SHT_IntegrityProtected);
                                          
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (nr_Cell1)))) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);
    
    
    
   }//end of f_TC_11_7_1_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_7_2_NR5GC() runs on NR5GC_PTC
  {// eDRX / Inactive / RAN-initiated paging

    f_NR5GC_Init(NR_1);

    //Table 11.7.2.3.3-1: SIB1
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1, true_);
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedInactive(nr_Cell1, true_);
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, '0000000000'B);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // UE supporting extended DRX.
    f_UT_SwitchOnUE(UT, false, CNF_REQUIRED);
    f_UT_ConfigureEDRX(UT, true, -, CNF_REQUIRED);
    f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);

    // UE is in state 0N-B according to TS 38.508-1 Table 4.4A.2-2
    f_NR5GC_Preamble (nr_Cell1, STATE_OFF_0B);

    f_NR_TestBody_Set(true);
    f_TC_11_7_2_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_11_7_2_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_7_2_NR5GC_TestBody() runs on NR5GC_PTC
   { // @sic R5s230896 sic@
    var template (value) ExtdDRXParams v_NegotiatedExtdDRXParams := cs_NG_NAS_EDRXParams('0001'B, '0001'B, '00000001'B);// Step 14 - Table 11.7.2.3.3-2: REGISTRATION ACCEPT // @sic R5-233412 sic@
    var CellIdentity v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var template (value) SuspendConfig v_SuspendConfig;

    //@siclog "Step 1" siclog@
    //The UE is switched on
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 2-15" siclog@
    //Steps 19B-19C of the generic procedure for NR RRC_IDLE as specified in TS 38.508-1 Table 4.5.3.2-1 are performed.
    //The UE transmits a REGISTRATION REQUEST message including  the Requested extended DRX parameters IE
    //Steps 19E-19M of Table 4.5.3.2-1 of the generic procedure in TS 38.508-1 are performed.
    //The SS transmits a REGISTRATION ACCEPT message including the Negotiated extended DRX parameters IE?
    //Check: Does the UE transmit a REGISTRATION COMPLETE message?
    f_NR5GC_RRC_Idle_Steps2_15_eDRX(nr_Cell1, v_NegotiatedExtdDRXParams);

    //@siclog "Steps 16-18" siclog@
    //Void

    //@siclog "Steps 19Aa1-20" siclog@
    //Steps 19TAa1-20 of Table 4.5.3.2-1 of the generic procedure in TS 38.508-1 are performed.
    f_NR5GC_RRC_Idle_Steps16_20 (nr_Cell1);
    v_SuspendConfig := cs_SuspendConfigDef(cs_RAN_NotificationAreaInfo_1Cell(v_CellIdentity, omit), -, -, rf512);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,v_SuspendConfig)); // @sic R5s240531 sic@

    //@siclog "Step 21" siclog@
    //The SS transmits a Paging message within a paging occasion
    f_NR5GC_UE_Page_eDRX(nr_Cell1,
                         cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_FullI_RNTI(tsc_NR_I_RNTI_Value1)),
                         1, 1);

    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell1,tsc_NR_38508_NextHopChainingCount);
    //@siclog "Step 22" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message?
    f_NR_RRC_ResumeRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.2 Step 22");

    //@siclog "Step 23" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell1);

    //@siclog "Step 24" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell1);

    //@siclog "Step 25" siclog@
    //Void

    //@siclog "Step 26" siclog@
    //The SS transmits an RRCRelease message with suspend.
    v_SuspendConfig := cs_SuspendConfigDef(cs_RAN_NotificationAreaInfo_1Cell(v_CellIdentity, omit), -, -, rf256);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,v_SuspendConfig)); // @sic R5s240531 sic@

    //@siclog "Step 27" siclog@
    //The SS transmits a Paging message to the UE in a valid PO which is derived by the value of ran-ExtendedPagingCycle IE.
    f_NR5GC_UE_Page_eDRX(nr_Cell1,
                         cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_FullI_RNTI(tsc_NR_I_RNTI_Value1)),
                         1, 0); /* RRC_INACTIVE state, if the UE operates in eDRX and eDRX is configured by RRC, i.e., TeDRX, RAN , and/or upper layers, i.e., TeDRX, CN, as defined in clause 7.4:
                                      - If both TeDRX,CN and TeDRX,RAN are not longer than 1024 radio frames, T = min{TeDRX,RAN, TeDRX,CN} = min (5.12, 2.56)*/
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell1,tsc_NR_38508_NextHopChainingCount);
    //@siclog "Step 28" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message?
    f_NR_RRC_ResumeRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.2 Step 28");

    //@siclog "Step 29" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell1);

    //@siclog "Step 30" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell1);

    //@siclog "Step 31" siclog@
    //The SS transmits an RRCRelease message with suspend.
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,v_SuspendConfig)); // @sic R5s240531 sic@

    //@siclog "Step 32" siclog@
    //The SIB1 is updated according to Table 11.7.2.3.3-1 and transmits a Short Message on PDCCH using P-RNTI indicating a systemInfoModification.
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, omit); // return value by default
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1);
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedInactive(nr_Cell1);
    f_NR_ModifySysinfo(nr_Cell1, true, RRC_INACTIVE); //Modify Sysinfo in SS

    //@siclog "Step 33" siclog@
    //Wait for 2.1* modification period to allow the new system information to take effect.
    f_NR_WaitModificationPeriods (nr_Cell1);

    //@siclog "Step 34" siclog@
    //The SS transmits a Paging message to the UE in a valid PO which is derived by normal DRX and not belonging to extended DRX.
    f_NR_Paging_Def(nr_Cell1, RRC_INACTIVE);

    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell1,tsc_NR_38508_NextHopChainingCount);
    //@siclog "Step 35" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message?
    f_NR_RRC_ResumeRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.2 Step 35");

    //@siclog "Step 36" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell1);

    //@siclog "Step 37" siclog@
    //The UE transmits an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell1);

   }//end of f_TC_11_7_2_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_7_3_NR5GC() runs on NR5GC_PTC
  {// eDRX / Inactive / CN-initiated paging / eDRX Allowed / Not Allowed
    // @sic R5s230900 sic@

    f_NR5GC_Init(NR_1);

    //Table 11.7.3.3.3-1: SIB1
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1, true_);
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedInactive(nr_Cell1, true_);
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, '0000000000'B);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // UE supporting extended DRX.
    f_UT_SwitchOnUE(UT, false, CNF_REQUIRED);
    f_UT_ConfigureEDRX(UT, true, -, CNF_REQUIRED);
    f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);

    // UE is in state 0N-B according to TS 38.508-1 Table 4.4A.2-2.
    f_NR5GC_Preamble (nr_Cell1, STATE_OFF_0B);

    f_NR_TestBody_Set(true);
    f_TC_11_7_3_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_11_7_3_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.7.3
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_7_3_NR5GC_TestBody() runs on NR5GC_PTC
   { // @sic R5s230900 R5-241377 sic@
    var template (value) ExtdDRXParams v_NegotiatedExtdDRXParams := cs_NG_NAS_EDRXParams('0000'B, '0001'B, '00000001'B);// Step 14 - Table 11.7.3.3.3-3: REGISTRATION ACCEPT
    var CellIdentity v_CellIdentity := f_NR_CellInfo_GetCellIdentity(nr_Cell1);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) SuspendConfig v_SuspendConfig;
    var NG_NAS_GutiParameters_Type v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(nr_Cell1);
    var NG_5G_S_TMSI v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);
    var PCCH_Config v_PcchConfig := f_NR_GetSIB1_PcchConfig(nr_Cell1);
    var PagingCycle v_PagingCycle;

    //@siclog "Step 1" siclog@
    //The UE is switched on
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 2-15" siclog@
    //Steps 19B-19C of the generic procedure for NR RRC_INACTIVE as specified in TS 38.508-1 Table 4.5.3.2-1 are performed.
    //The UE transmits a REGISTRATION REQUEST message including  the Requested extended DRX parameters IE
    //Steps 19E-19M of Table 4.5.3.2-1 of the generic procedure in TS 38.508-1 are performed.
    //The SS transmits a REGISTRATION ACCEPT message including the Negotiated extended DRX parameters IE?
    // Note 1:  In NR connected to 5GCN, the Paging Time Window field is ignored and the PTW value is included in the Extended Paging Time Window field.
    // The UE transmits a REGISTRATION COMPLETE message
    f_NR5GC_RRC_Idle_Steps2_15_eDRX(nr_Cell1, v_NegotiatedExtdDRXParams);

    //@siclog "Steps 16-17" siclog@
    // Steps 19TAa1-20 of Table 4.5.3.2-1 of the generic procedure in TS 38.508-1 are performed.
    f_NR5GC_RRC_Idle_Steps16_20 (nr_Cell1);
    f_NR_RRC_InactiveDef(nr_Cell1, NotFollowedByResume);  //@sic R5s250008 sic@

    //@siclog "Steps 18" siclog@
    // The SS transmits a Paging message within a paging occasion.
    f_NR5GC_UE_Page_eDRX(nr_Cell1,
                         cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)), /* @sic R5-236166 sic@ */
                         1, 1);

    //@siclog "Step 19" siclog@
    // Check: Does the UE transmits an RRCSetupRequest message indicating that UE has moved to RRC_IDLE state?
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.3 Step 19");

    //@siclog "Step 20" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 21" siclog@
    // The UE transmits an RRCSetupComplete message including SERVICE REQUEST to confirm the successful completion of the connection establishment.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);

    //@siclog "Step 22-25" siclog@
    // Steps 5 to 8 of the NR RRC_CONNECTED procedure in TS 38.508-1 Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

    //@siclog "Step 26" siclog@
    // The SS transmits an RRCRelease message with suspend.
    v_SuspendConfig := cs_SuspendConfigDef(cs_RAN_NotificationAreaInfo_1Cell(v_CellIdentity, omit), -, -, rf256);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,v_SuspendConfig)); // @sic R5s240531 sic@

    //@siclog "Step 27" siclog@
    // The SIB1 is updated according to Table 11.7.3.3.3-1 and transmits a Short message on PDCCH using P-RNTI indicating a systemInfoModification.
    f_NR_CellInfo_SetSIB1_hyperSFN_r17(nr_Cell1, omit); // return value by default
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedIdle(nr_Cell1);
    f_NR_CellInfo_Set_SIB1_eDRX_AllowedInactive(nr_Cell1);
    f_NR_ModifySysinfo(nr_Cell1, true, RRC_INACTIVE); //Modify Sysinfo in SS
    
    //@siclog "Step 28" siclog@
    // Wait for 2.1* modification period to allow the new system information to take effect.
    f_NR_WaitModificationPeriods (nr_Cell1);
    
    //@siclog "Step 29" siclog@
    // The SS transmits a Paging message to the UE in a valid PO which is derived by normal DRX and not belonging to extended DRX.
    v_PagingCycle := v_PcchConfig.defaultPagingCycle;
    f_NR_Paging(nr_Cell1,cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)), v_PagingCycle);

    //@siclog "Step 30" siclog@
    // Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 11.7.3 Step 30");
    f_NR_ULGrantConfiguration_Start(nr_Cell1);

    //@siclog "Step 31" siclog@
    // The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (nr_Cell1);

    //@siclog "Step 32" siclog@
    // The UE transmits an RRCSetupComplete message.
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

                                               
   }//end of f_TC_11_7_3_NR5GC_TestBody

}
