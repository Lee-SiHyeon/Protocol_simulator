  template UE_MeasurementsAvailable_r16 cr_UE_MeasurementsAvailable_r16 ( template UE_MeasurementsAvailable_r16.logMeasAvailable_r16         p_LogMeasAvailable_r16 := *,
                                                                          template UE_MeasurementsAvailable_r16.logMeasAvailableBT_r16       p_LogMeasAvailableBT_r16 := *,
                                                                          template UE_MeasurementsAvailable_r16.logMeasAvailableWLAN_r16     p_LogMeasAvailableWLAN_r16 := *,
                                                                          template UE_MeasurementsAvailable_r16.connEstFailInfoAvailable_r16 p_ConnEstFailInfoAvailable_r16 := *,
                                                                          template UE_MeasurementsAvailable_r16.rlf_InfoAvailable_r16        p_Rlf_InfoAvailable_r16 := *,
                                                                          template UE_MeasurementsAvailable_r16.successHO_InfoAvailable_r17 p_SuccessHO_InfoAvailable_r17 := *,
                                                                          template UE_MeasurementsAvailable_r16.sigLogMeasConfigAvailable_r17 p_SigLogMeasConfigAvailable_r17 := *)  :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    //@sic R5-224094 sic@
    logMeasAvailable_r16          := p_LogMeasAvailable_r16,
    logMeasAvailableBT_r16        := p_LogMeasAvailableBT_r16,
    logMeasAvailableWLAN_r16      := p_LogMeasAvailableWLAN_r16,
    connEstFailInfoAvailable_r16  := p_ConnEstFailInfoAvailable_r16,
    rlf_InfoAvailable_r16         := p_Rlf_InfoAvailable_r16,
    successHO_InfoAvailable_r17   := p_SuccessHO_InfoAvailable_r17,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17, R5-227544 sic@ */
    sigLogMeasConfigAvailable_r17 := p_SigLogMeasConfigAvailable_r17,/* @sic R5s221179 BASELINE MOVING 2022 rel-17, R5-227544 sic@ */
    successPSCell_InfoAvailable_r18 := *                             /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

