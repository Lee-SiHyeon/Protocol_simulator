module UTRAN34_4C_RAB {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from Parameters all;
  import from UTRAN34_4C_ASN1_ASP_Templates all;
  import from UTRAN34_4C_ConfigurationSteps all;
  import from UTRAN34_4C_Functions all;
  import from UTRAN34_4C_InitFunctions all;
  import from UTRAN34_4C_Templates all;
  import from UTRAN34_ASN1_ASP_Templates all;
  import from UTRAN34_ASN1_ASP_Templates_r10 all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_Data_Templates all;
  import from UTRAN34_LoopBack_Functions all;
  import from UTRAN34_LoopBack_Templates all;
  import from UTRAN34_Parameters all;
  import from UTRAN34_RAB_Templates all;
  import from UTRAN34_RRC_CommonFunctions all;
  import from UTRAN34_RRC_CommonTemplates_r10 all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_Parameters all;
  import from UTRAN_RAB_Functions all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_TTCN_ASP_Templates all;

  type record TestPoint_Type {     /* @status    APPROVED (UTRAN) */
    boolean flag,          //Indicated if the test point is valid (true) or not (false)
    integer noOfCodes,     //Number of Channelization Codes
    integer noOfMAC_dPDUs, //Number of MAC-d PDUs, only relevant for the fixed RLC case
    integer tBS,           //Transport Block Size
    integer tFRI           //TB Size Index On HS-SCCH
  };

  template (value) TestPoint_Type cs_TestPoint(boolean p_Flag,
                                               integer p_NoOfCodes,
                                               integer p_NoOfMAC_dPDUs,
                                               integer p_TBS,
                                               integer p_TFRI) :=
  { /* @status    APPROVED (UTRAN) */
    flag := p_Flag,
    noOfCodes := p_NoOfCodes,
    noOfMAC_dPDUs := p_NoOfMAC_dPDUs,
    tBS := p_TBS,
    tFRI := p_TFRI
  };

  template (value) U_CRLC_CONFIG_REQ cas_CRLC_BindTestDataInMultipleMACehs_PDU_MultiFlows_REQ(integer p_CellId,
                                                                                              integer p_RbId,
                                                                                              integer p_PrimaryFlow,
                                                                                              template (omit) integer p_SecondaryFlow,
                                                                                              template (omit) integer p_SecPrimaryFlow,
                                                                                              template (omit) integer p_SecSecondaryFlow,
                                                                                              template (omit) BindTestDataInMultipleMACehs_r10OrLaterExtensionType p_BindTestDataInMultipleMACehs_r10) :=
  { /* @status    APPROVED (UTRAN) */
    bindTestDataMultiFlow := {
      cellId := p_CellId,
      routingInfo := {
        rB_Identity := p_RbId
      },
      primaryFlowNumOfSDUs := p_PrimaryFlow,    // Number of RLC SDU's for primary flow of serving cell
      secondaryFlowNumOfSDUs := p_SecondaryFlow, // Number of RLC SDU's for secondary flow of serving cell
      secPrimaryFlowNumOfSDUs := p_SecPrimaryFlow, // Number of RLC SDU's for secondary cell primary flow   Rel-9 or later
      secSecondaryFlowNumOfSDUs := p_SecSecondaryFlow, // Number of RLC SDU's for secondary cell secondary flow Rel-9 or later
      relAspTypeExtension := p_BindTestDataInMultipleMACehs_r10
    }
  };

  template (value) BindTestDataInMultipleMACehs_r10OrLaterExtensionType cs_BindTestDataInMultipleMACehs_r10(integer p_ThirdPrimaryFlow,
                                                                                                            template (omit) integer p_ThirdSecondayFlow,
                                                                                                            template (omit) integer p_FourthPrimaryFlow,
                                                                                                            template (omit) integer p_FourthSecondaryFlow) :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt := { // Extension for 4C-HSDPA with or without MIMO
      thirdPrimaryFlowNumOfSDUs := p_ThirdPrimaryFlow, //Number of RLC SDU's for primary flow of third cell
      thirdSecondaryFlowNumOfSDUs := p_ThirdSecondayFlow, // Number of RLC SDU's for secondary flow of third cell
      fourthPrimaryFlowNumOfSDUs := p_FourthPrimaryFlow, // Number of RLC SDU's for fourth cell primary flow
      fourthSecondaryFlowNumOfSDUs := p_FourthSecondaryFlow // Number of RLC SDU's for fourth cell secondary flow
    }
  };

  template (present) U_CRLC_CONFIG_CNF car_CRLC_BindTestDataInMultipleMACehs_PDU_MultiFlows_CNF(integer p_CellId,
                                                                                                integer p_RbId) :=
  { /* @status    APPROVED (UTRAN) */
    bindTestDataMultiFlow := {
      cellId := p_CellId,
      routingInfo := {
        rB_Identity := p_RbId
      },
      result := success
    }
  };

  template (value) TFC_Subset cs_TFC_Allowed_0_1_4_5_9 :=
  { /* @status    APPROVED (UTRAN) */
    allowedTFC_List:= { 0 , 1, 4 , 5 , 9 }
  };

  template (value) TFRC_Explicit_Type cs_TFRC_Explicit_RAB(ModulationScheme p_ModulationScheme,
                                                          integer p_NoOfChannelisationCodes,
                                                          integer p_TbSizeIndexOnHS_SCCH) :=
  /* @status    APPROVED (UTRAN) */
    cs_TFRC_Explicit_Common(p_ModulationScheme, p_NoOfChannelisationCodes, p_TbSizeIndexOnHS_SCCH, f_UTRAN34_SetRedundancyVersion(p_ModulationScheme, false));

  template (value) U_CMAC_CONFIG_REQ cas_CMAC_MACehs_HARQAssign_MultiFlows_REQ(UTRAN_CellId_Type p_CellId,
                                                                               integer p_PrimaryProcessId,
                                                                               template (omit) integer p_SecondaryProcessId,
                                                                               template (omit) integer p_SecPrimaryProcessId,
                                                                               template (omit) integer p_SecSecondaryProcessId,
                                                                               template (omit) HARQAssign_MultiFlows_r10OrLaterExtensionType p_HARQAssign_MultiFlows_r10) :=
  { /* @status    APPROVED (UTRAN) */
    configHARQ_MultiFlow := {
      cellId := f_UtranCellId2Int(p_CellId),
      primaryFlowHarqProcessId := p_PrimaryProcessId,  // of serving cell
      secondaryFlowHarqProcessId := p_SecondaryProcessId,   // of serving cell
      secPrimaryFlowHarqProcessId   := p_SecPrimaryProcessId, // of secondary cell  Rel-9 or later
      secSecondaryFlowHarqProcessId := p_SecSecondaryProcessId, // of secondary cell    Rel-9 or later
      relAspTypeExtension   := p_HARQAssign_MultiFlows_r10 // Rel-10 or later
    }
  };

  template (present) U_CMAC_CONFIG_CNF car_CMAC_MACehs_HARQAssign_MultiFlows_CNF(UTRAN_CellId_Type p_CellId) :=
  { /* @status    APPROVED (UTRAN) */
    //@sic R5s140782 sic@
    configHARQ_MultiFlow := {
      cellId := f_UtranCellId2Int(p_CellId)
    }
  };

  template (value) HARQAssign_MultiFlows_r10OrLaterExtensionType cs_HARQAssign_MultiFlows_r10(integer p_ThirdPrimaryProcessId,
                                                                                              template (omit) integer p_ThirdSecondaryFlowHarqProcessId,
                                                                                              template (omit) integer p_FourthPrimaryFlowHarqProcessId := omit,
                                                                                              template (omit) integer p_FourthSecondaryFlowHarqProcessId := omit) :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt := {
      thirdPrimaryFlowHarqProcessId := p_ThirdPrimaryProcessId, // of third cell
      thirdSecondaryFlowHarqProcessId := p_ThirdSecondaryFlowHarqProcessId, // for MIMO in third cell
      fourthPrimaryFlowHarqProcessId := p_FourthPrimaryFlowHarqProcessId, //of fourth cell for 4C-HSDPA
      fourthSecondaryFlowHarqProcessId := p_FourthSecondaryFlowHarqProcessId //for MIMO in fourth cell for 4C-HSDPA
    }
  };

  template (value) HARQ_Info_r7 cs_HARQ_Info6_FDD :=
  { /* @status    APPROVED (UTRAN) */
    numberOfProcesses := n6,
    memoryPartitioning := {
      implicit := NULL
    }
  };

  /*
   * @desc      Converts enumerated type into integer
   * @param     p_HARQInfo
   * @return    integer
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetNumberOfProcesses(HARQ_Info_r7 p_HARQInfo) return integer
  {
    var integer v_NoOfProcesses := 0;
    
    select (p_HARQInfo.numberOfProcesses) {
      case (n1) {
        v_NoOfProcesses := 1;
      }
      case (n2) {
        v_NoOfProcesses := 2;
      }
      case (n3) {
        v_NoOfProcesses := 3;
      }
      case (n4) {
        v_NoOfProcesses := 4;
      }
      case (n5) {
        v_NoOfProcesses := 5;
      }
      case (n6) {
        v_NoOfProcesses := 6;
      }
      case (n7) {
        v_NoOfProcesses := 7;
      }
      case (n8) {
        v_NoOfProcesses := 8;
      }
      case (n12) {
        v_NoOfProcesses := 12;
      }
      case (n14) {
        v_NoOfProcesses := 14;
      }
      case (n16) {
        v_NoOfProcesses := 16;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Modulation not valid");
      }
    }
    return v_NoOfProcesses;
  }

  /*
   * @desc      To check validity of px_ExecutePS_Class
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RAB_Check_ExecutePS_Class_IntOrBack() runs on UTRAN_PTC
  {
    if ((px_ExecutePS_Class < 0) or (px_ExecutePS_Class > 2) or (not pc_Interactive and not pc_Background) or
        ((px_ExecutePS_Class == 1) and not pc_Interactive) or ((px_ExecutePS_Class == 2) and not pc_Background)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Wrong PS Class for executing the test case");
    }
  }

  /*
   * @desc      To request of binding subsequent data sending RLC_TR/UM/AM_TestDataReq on the specified RB mapped on HS-DSCH in two MAC-ehs PDUs, one for each primary and secondary flow
   * @param     p_RbId
   * @param     p_PrimaryFlow
   * @param     p_SecondaryFlow
   * @param     p_SecPrimaryFlow
   * @param     p_SecSecondaryFlow
   * @param     p_ThirdPrimaryFlow
   * @param     p_ThirdSecondayFlow
   * @param     p_FourthPrimaryFlow (default value: omit)
   * @param     p_FourthSecondaryFlow (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_BindTestDataInMultipleMACehs_PDU_4C(integer p_RbId,
                                                         integer p_PrimaryFlow,
                                                         template (omit) integer p_SecondaryFlow,
                                                         template (omit) integer p_SecPrimaryFlow,
                                                         template (omit) integer p_SecSecondaryFlow,
                                                         integer p_ThirdPrimaryFlow,
                                                         template (omit) integer p_ThirdSecondayFlow,
                                                         template (omit) integer p_FourthPrimaryFlow := omit,
                                                         template (omit) integer p_FourthSecondaryFlow := omit) runs on UTRAN_PTC
  {
    U_CRLC.send(cas_CRLC_BindTestDataInMultipleMACehs_PDU_MultiFlows_REQ(f_UtranCellId2Int(utran_CellDedicated),
                                                                         p_RbId,
                                                                         p_PrimaryFlow,
                                                                         p_SecondaryFlow,
                                                                         p_SecPrimaryFlow,
                                                                         p_SecSecondaryFlow,
                                                                         cs_BindTestDataInMultipleMACehs_r10(p_ThirdPrimaryFlow,
                                                                                                             p_ThirdSecondayFlow,
                                                                                                             p_FourthPrimaryFlow,
                                                                                                             p_FourthSecondaryFlow)));
    U_CRLC.receive(car_CRLC_BindTestDataInMultipleMACehs_PDU_MultiFlows_CNF(f_UtranCellId2Int(utran_CellDedicated),
                                                                            p_RbId));
  }

  /*
   * @desc      Implements 34.123-1 tables 14.1.3.4b.2.1, 14.1.3.4b.2.2 and 14.1.3.4b.2.3: Test points for QPSK, 16QAM and QPSK
   *            fixed MAC-d PDU size=656 or flexible MAC-d PDU size; or for radio bearer combinations with mix of fixed and flexible MAC-d PDU sizes.
   *            It only considers non-MIMO 4C-HSDPA categories (i.e. Cat 29 and 31)
   * @param     p_Mod
   * @param     p_Index
   * @return    TestPoint_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetTestPoint_14_1_3_4b_2_1Or2Or3_4C(ModulationScheme p_Mod,
                                                         integer          p_Index) return TestPoint_Type
  {
    var template (value) TestPoint_Type v_TestPoint;
    
    if (p_Mod == qpsk) {
      select (p_Index) {
        case (7)   { v_TestPoint := cs_TestPoint(true,  15, 7,   4760,  2); }
        case (8)   { v_TestPoint := cs_TestPoint(true,  15, 8,   5392,  9); }
        case (9)   { v_TestPoint := cs_TestPoint(true,  15, 9,   6112,  16); }
        case (10)  { v_TestPoint := cs_TestPoint(true,  15, 10,  6808,  22); }
        case (11)  { v_TestPoint := cs_TestPoint(true,  15, 11,  7440,  27); }
        case (12)  { v_TestPoint := cs_TestPoint(true,  15, 12,  8136,  32); }
        case (13)  { v_TestPoint := cs_TestPoint(true,  15, 13,  8744,  36); }
        case (14)  { v_TestPoint := cs_TestPoint(true,  15, 14,  9560,  41); }
        case (15)  { v_TestPoint := cs_TestPoint(true,  15, 15,  10088, 44); }
        case (16)  { v_TestPoint := cs_TestPoint(true,  15, 16,  10840, 48); }
        case (17)  { v_TestPoint := cs_TestPoint(true,  15, 17,  11432, 51); }
        case (18)  { v_TestPoint := cs_TestPoint(true,  15, 18,  12280, 55); }
        case (19)  { v_TestPoint := cs_TestPoint(true,  15, 19,  12960, 58); }
        case (20)  { v_TestPoint := cs_TestPoint(true,  15, 20,  13672, 61); }
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else if (p_Mod == qam16){
      select (p_Index) {
        case (14)  { v_TestPoint := cs_TestPoint(true,  15, 14,  9560,  3); }
        case (15)  { v_TestPoint := cs_TestPoint(true,  15, 15,  10088, 6); }
        case (16)  { v_TestPoint := cs_TestPoint(true,  15, 16,  10840, 10); }
        case (17)  { v_TestPoint := cs_TestPoint(true,  15, 17,  11432, 13); }
        case (18)  { v_TestPoint := cs_TestPoint(true,  15, 18,  12280, 17); }
        case (19)  { v_TestPoint := cs_TestPoint(true,  15, 19,  12960, 20); }
        case (20)  { v_TestPoint := cs_TestPoint(true,  15, 20,  13672, 23); }
        case (21)  { v_TestPoint := cs_TestPoint(true,  15, 21,  14168, 25); }
        case (22)  { v_TestPoint := cs_TestPoint(true,  15, 22,  14952, 28); }
        case (23)  { v_TestPoint := cs_TestPoint(true,  15, 23,  15496, 30); }
        case (24)  { v_TestPoint := cs_TestPoint(true,  15, 24,  16352, 33); }
        case (25)  { v_TestPoint := cs_TestPoint(true,  15, 25,  16944, 35); }
        case (26)  { v_TestPoint := cs_TestPoint(true,  15, 26,  17568, 37); }
        case (27)  { v_TestPoint := cs_TestPoint(true,  15, 27,  17880, 38); }
        case (28)  { v_TestPoint := cs_TestPoint(true,  15, 28,  18536, 40); }
        case (29)  { v_TestPoint := cs_TestPoint(true,  15, 29,  19208, 42); }
        case (30)  { v_TestPoint := cs_TestPoint(true,  15, 30,  19904, 44); }
        case (31)  { v_TestPoint := cs_TestPoint(true,  15, 31,  20632, 46); }
        case (32)  { v_TestPoint := cs_TestPoint(true,  15, 32,  21384, 48); }
        case (33)  { v_TestPoint := cs_TestPoint(true,  15, 33,  21768, 49); }
        case (34)  { v_TestPoint := cs_TestPoint(true,  15, 34,  22968, 52); }
        case (35)  { v_TestPoint := cs_TestPoint(true,  15, 35,  23384, 53); }
        case (36)  { v_TestPoint := cs_TestPoint(true,  15, 36,  23808, 54); }
        case (37)  { v_TestPoint := cs_TestPoint(true,  15, 37,  24672, 56); }
        case (38)  { v_TestPoint := cs_TestPoint(true,  15, 38,  25568, 58); }
        case (39)  { v_TestPoint := cs_TestPoint(true,  15, 39,  26032, 59); }
        case (40)  { v_TestPoint := cs_TestPoint(true,  15, 40,  26504, 60); }
        case (41)  { v_TestPoint := cs_TestPoint(true,  15, 41,  26976, 61); } //@sic R5s140782 sic@
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else if (p_Mod == qam64){
      select (p_Index) {
        case (21)  { v_TestPoint := cs_TestPoint(true,  15, 21,  14168, 1); }
        case (22)  { v_TestPoint := cs_TestPoint(true,  15, 22,  14952, 4); }
        case (23)  { v_TestPoint := cs_TestPoint(true,  15, 23,  15496, 6); }
        case (24)  { v_TestPoint := cs_TestPoint(true,  15, 24,  16352, 9); }
        case (25)  { v_TestPoint := cs_TestPoint(true,  15, 25,  16944, 11); }
        case (26)  { v_TestPoint := cs_TestPoint(true,  15, 26,  17568, 13); }
        case (27)  { v_TestPoint := cs_TestPoint(true,  15, 27,  17880, 14); }
        case (28)  { v_TestPoint := cs_TestPoint(true,  15, 28,  18536, 16); }
        case (29)  { v_TestPoint := cs_TestPoint(true,  15, 29,  19208, 18); }
        case (30)  { v_TestPoint := cs_TestPoint(true,  15, 30,  19904, 20); }
        case (31)  { v_TestPoint := cs_TestPoint(true,  15, 31,  20632, 22); }
        case (32)  { v_TestPoint := cs_TestPoint(true,  15, 32,  21384, 24); }
        case (33)  { v_TestPoint := cs_TestPoint(true,  15, 33,  21768, 25); }
        case (34)  { v_TestPoint := cs_TestPoint(true,  15, 34,  22560, 27); }
        case (35)  { v_TestPoint := cs_TestPoint(true,  15, 35,  23384, 29); }
        case (36)  { v_TestPoint := cs_TestPoint(true,  15, 36,  23808, 30); }
        case (37)  { v_TestPoint := cs_TestPoint(true,  15, 37,  24672, 32); }
        case (38)  { v_TestPoint := cs_TestPoint(true,  15, 38,  25120, 33); }
        case (39)  { v_TestPoint := cs_TestPoint(true,  15, 39,  26032, 35); }
        case (40)  { v_TestPoint := cs_TestPoint(true,  15, 40,  26504, 36); }
        case (41)  { v_TestPoint := cs_TestPoint(true,  15, 41,  26976, 37); }
        case (42)  { v_TestPoint := cs_TestPoint(true,  15, 42,  27960, 39); }
        case (43)  { v_TestPoint := cs_TestPoint(true,  15, 43,  28464, 40); }
        case (44)  { v_TestPoint := cs_TestPoint(true,  15, 44,  28976, 41); }
        case (45)  { v_TestPoint := cs_TestPoint(true,  15, 45,  30032, 43); }
        case (46)  { v_TestPoint := cs_TestPoint(true,  15, 46,  30576, 44); }
        case (47)  { v_TestPoint := cs_TestPoint(true,  15, 47,  31128, 45); }
        case (48)  { v_TestPoint := cs_TestPoint(true,  15, 48,  31688, 46); }
        case (49)  { v_TestPoint := cs_TestPoint(true,  15, 49,  32264, 47); }
        case (50)  { v_TestPoint := cs_TestPoint(true,  15, 50,  32848, 48); } //@sic R5s140782 sic@
        case (52)  { v_TestPoint := cs_TestPoint(true,  15, 52,  34656, 51); }
        case (53)  { v_TestPoint := cs_TestPoint(true,  15, 53,  35280, 52); }
        case (54)  { v_TestPoint := cs_TestPoint(true,  15, 54,  35920, 53); }
        case (55)  { v_TestPoint := cs_TestPoint(true,  15, 55,  36568, 54); }
        case (56)  { v_TestPoint := cs_TestPoint(true,  15, 56,  37224, 55); }
        case (58)  { v_TestPoint := cs_TestPoint(true,  15, 58,  38576, 57); }
        case (59)  { v_TestPoint := cs_TestPoint(true,  15, 59,  39272, 58); }
        case (60)  { v_TestPoint := cs_TestPoint(true,  15, 60,  39984, 59); }
        case (61)  { v_TestPoint := cs_TestPoint(true,  15, 61,  40704, 60); }
        case (64)  { v_TestPoint := cs_TestPoint(true,  15, 64,  42192, 62); }
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else {
      FatalError(__FILE__, __LINE__, "Modulation not valid");
    }
    return valueof(v_TestPoint);
  }

  /*
   * @desc      Implements 34.123-1 table 14.1.3.4b.2.7: Test points for Three-Cell and mix of 64QAM and 16QAM for
   *            Three-Cell data flow#1 and Three-Cell data flow#2 and Three-Cell data flow#3, fixed MAC-d PDU size=656 or flexible MAC-d PDU size;
   *            or for radio bearer combinations with mix of fixed and flexible MAC-d PDU sizes
   * @param     p_Mod
   * @param     p_Index
   * @return    TestPoint_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetTestPoint_14_1_3_4b_2_7(ModulationScheme p_Mod,
                                                integer          p_Index) return TestPoint_Type
  {
    var template (value) TestPoint_Type v_TestPoint;
    
    if (p_Mod == qam64) {
      select (p_Index) {
        case (1)   { v_TestPoint := cs_TestPoint(true,  2,  3,   2048,  7); }
        case (2)   { v_TestPoint := cs_TestPoint(true,  4,  6,   4048,  6); }
        case (3)   { v_TestPoint := cs_TestPoint(true,  5,  8,   5392,  9); }
        case (4)   { v_TestPoint := cs_TestPoint(true,  6,  9,   6112,  6); }
        case (5)   { v_TestPoint := cs_TestPoint(true,  7,  10,  6808,  3); }
        case (6)   { v_TestPoint := cs_TestPoint(true,  8,  12,  8136,  6); }
        case (7)   { v_TestPoint := cs_TestPoint(true,  10, 14,  9560,  3); }
        case (9)   { v_TestPoint := cs_TestPoint(true,  11, 16,  10840, 4); }
        case (11)  { v_TestPoint := cs_TestPoint(true,  12, 17,  11432, 2); }
        case (12)  { v_TestPoint := cs_TestPoint(true,  13, 18,  12280, 2); }
        case (13)  { v_TestPoint := cs_TestPoint(true,  14, 20,  13672, 4); }
        case (14)  { v_TestPoint := cs_TestPoint(true,  15, 21,  14168, 1); }
        case (16)  { v_TestPoint := cs_TestPoint(true,  15, 22,  14952, 4); }
        case (18)  { v_TestPoint := cs_TestPoint(true,  15, 23,  15496, 6); }
        case (20)  { v_TestPoint := cs_TestPoint(true,  15, 24,  16352, 9); }
        case (22)  { v_TestPoint := cs_TestPoint(true,  15, 25,  16944, 11); }
        case (24)  { v_TestPoint := cs_TestPoint(true,  15, 26,  17568, 13); }
        case (26)  { v_TestPoint := cs_TestPoint(true,  15, 27,  17880, 14); }
        case (28)  { v_TestPoint := cs_TestPoint(true,  15, 32,  21384, 24); }
        case (29)  { v_TestPoint := cs_TestPoint(true,  15, 37,  24672, 32); }
        case (30)  { v_TestPoint := cs_TestPoint(true,  15, 42,  27960, 39); }
        case (31)  { v_TestPoint := cs_TestPoint(true,  15, 46,  30576, 44); }
        case (32)  { v_TestPoint := cs_TestPoint(true,  15, 50,  32848, 48); }
        case (33)  { v_TestPoint := cs_TestPoint(true,  15, 56,  37224, 55); }
        case (34)  { v_TestPoint := cs_TestPoint(true,  15, 59,  39272, 58); }
        case (35)  { v_TestPoint := cs_TestPoint(true,  15, 64,  42192, 62); }
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else if (p_Mod == qam16){
      select (p_Index) {
        case (1)   { v_TestPoint := cs_TestPoint(true,  2,  2,   1360,  6); }
        case (2)   { v_TestPoint := cs_TestPoint(true,  4,  4,   2736,  6); }
        case (3)   { v_TestPoint := cs_TestPoint(true,  5,  5,   3384,  6); }
        case (4)   { v_TestPoint := cs_TestPoint(true,  6,  6,   4048,  6); }
        case (5)   { v_TestPoint := cs_TestPoint(true,  7,  7,   4760,  6); }
        case (6)   { v_TestPoint := cs_TestPoint(true,  8,  8,   5392,  6); }
        case (7)   { v_TestPoint := cs_TestPoint(true,  10, 9,   6112,  0); }
        case (9)   { v_TestPoint := cs_TestPoint(true,  11, 10,  6808,  1); }
        case (11)  { v_TestPoint := cs_TestPoint(true,  12, 11,  7440,  1); }
        case (12)  { v_TestPoint := cs_TestPoint(true,  13, 12,  8136,  2); }
        case (13)  { v_TestPoint := cs_TestPoint(true,  14, 13,  8744,  1); }
        case (14)  { v_TestPoint := cs_TestPoint(true,  15, 14,  9560,  3); }
        case (16)  { v_TestPoint := cs_TestPoint(true,  15, 15,  10088, 6); }
        case (18)  { v_TestPoint := cs_TestPoint(true,  15, 16,  10840, 10); }
        case (20)  { v_TestPoint := cs_TestPoint(true,  15, 17,  11432, 13); }
        case (22)  { v_TestPoint := cs_TestPoint(true,  15, 18,  12280, 17); }
        case (24)  { v_TestPoint := cs_TestPoint(true,  15, 19,  12960, 20); }
        case (26)  { v_TestPoint := cs_TestPoint(true,  15, 20,  13672, 23); }
        case (28)  { v_TestPoint := cs_TestPoint(true,  15, 21,  14168, 25); }
        case (29)  { v_TestPoint := cs_TestPoint(true,  15, 22,  14952, 28); }
        case (30)  { v_TestPoint := cs_TestPoint(true,  15, 23,  15496, 30); }
        case (31)  { v_TestPoint := cs_TestPoint(true,  15, 24,  16352, 33); }
        case (32)  { v_TestPoint := cs_TestPoint(true,  15, 25,  16944, 35); }
        case (33)  { v_TestPoint := cs_TestPoint(true,  15, 26,  17568, 37); }
        case (34)  { v_TestPoint := cs_TestPoint(true,  15, 27,  17880, 38); }
        case (35)  { v_TestPoint := cs_TestPoint(true,  15, 28,  18536, 40); } // @sic R5s140782 sic@
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else {
      FatalError(__FILE__, __LINE__, "Modulation not valid");
    }
    return valueof(v_TestPoint);
  }

  /*
   * @desc      Implements 34.123-1 table 14.1.3.4b.2.8: Test points for Three-Cell and mix of 64QAM and 16QAM and QPSK for
   *            Three-Cell data flow#1 and Three-Cell data flow#2 and Three-Cell data flow#3, fixed MAC-d PDU size=656 or flexible MAC-d PDU size;
   *            or for radio bearer combinations with mix of fixed and flexible MAC-d PDU sizes
   * @param     p_Mod
   * @param     p_Index
   * @return    TestPoint_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetTestPoint_14_1_3_4b_2_8(ModulationScheme p_Mod,
                                                integer          p_Index) return TestPoint_Type
  {
    var template (value) TestPoint_Type v_TestPoint;
    
    if ((p_Mod == qam64) or (p_Mod == qam16)) {
      select (p_Index) {
        case (3, 5, 6, 8, 10, 11, 13, 15, 17, 19, 21, 23, 25, 27, 35) {
          v_TestPoint := cs_TestPoint(false, 0,  0,  0,     0);
        }
        case else {
          v_TestPoint := f_UTRAN34_GetTestPoint_14_1_3_4b_2_7(p_Mod, p_Index);
        }
      }
    }
    else if (p_Mod == qpsk){
      select (p_Index) {
        case (1)   { v_TestPoint := cs_TestPoint(true,  2,  1,   688,   7); }
        case (2)   { v_TestPoint := cs_TestPoint(true,  4,  2,   1360,  6); }
        case (4)   { v_TestPoint := cs_TestPoint(true,  6,  3,   2048,  7); }
        case (7)   { v_TestPoint := cs_TestPoint(true,  10, 4,   2736,  0); }
        case (9)   { v_TestPoint := cs_TestPoint(true,  11, 5,   3384,  1); }
        
        case (12)  { v_TestPoint := cs_TestPoint(true,  13, 6,   4048,  1); }
        case (14)  { v_TestPoint := cs_TestPoint(true,  15, 7,   4760,  2); }
        case (16)  { v_TestPoint := cs_TestPoint(true,  15, 8,   5392,  9); }
        case (18)  { v_TestPoint := cs_TestPoint(true,  15, 9,   6112,  16); }
        case (20)  { v_TestPoint := cs_TestPoint(true,  15, 10,  6808,  22); }
        case (22)  { v_TestPoint := cs_TestPoint(true,  15, 11,  7440,  27); }
        case (24)  { v_TestPoint := cs_TestPoint(true,  15, 12,  8136,  32); }
        case (26)  { v_TestPoint := cs_TestPoint(true,  15, 13,  8744,  36); }
        case (28)  { v_TestPoint := cs_TestPoint(true,  15, 14,  9560,  41); }
        case (29)  { v_TestPoint := cs_TestPoint(true,  15, 15,  10088, 44); }
        case (30)  { v_TestPoint := cs_TestPoint(true,  15, 16,  10840, 48); }
        case (31)  { v_TestPoint := cs_TestPoint(true,  15, 17,  11432, 51); }
        case (32)  { v_TestPoint := cs_TestPoint(true,  15, 18,  12280, 55); }
        case (33)  { v_TestPoint := cs_TestPoint(true,  15, 19,  12960, 58); }
        case (34)  { v_TestPoint := cs_TestPoint(true,  15, 20,  13672, 61); }
        case else  { v_TestPoint := cs_TestPoint(false, 0,  0,   0,     0); }
      }
    }
    else {
      FatalError(__FILE__, __LINE__, "Modulation not valid");
    }
    return valueof(v_TestPoint);
  }

  /*
   * @desc      Configures SS for test point execution - 3C-HSDPA case
   * @param     p_TestPoint_M1
   * @param     p_TestPoint_M2
   * @param     p_TestPoint_M3
   * @param     p_ActTime           (default value: cs_ActivateNow)
   * @param     p_HarqProcessId
   * @param     p_HSPA_Parameters
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SS_TestPointConfig_3C(TestPoint_Type p_TestPoint_M1,
                                           TestPoint_Type p_TestPoint_M2,
                                           TestPoint_Type p_TestPoint_M3,
                                           template (value) SS_ActivationTime p_ActTime := cs_ActivateNow,
                                           integer p_HarqProcessId,
                                           UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters) runs on UTRAN_PTC
  {
    //Update test point into HSPA parameters for SS configuration
    //@sic R5-145142 sic@: TFRCconfigure_r10 renamed and changed to a list.
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.serving_TFRC.noOfChannelisationCodes := p_TestPoint_M1.noOfCodes;
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.serving_TFRC.tbSizeIndexOnHS_SCCH := p_TestPoint_M1.tFRI;
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.firstSecondary_TFRC.noOfChannelisationCodes := p_TestPoint_M2.noOfCodes;
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.firstSecondary_TFRC.tbSizeIndexOnHS_SCCH := p_TestPoint_M2.tFRI;
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.secondSecondary_TFRC.noOfChannelisationCodes := p_TestPoint_M3.noOfCodes;
    p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.secondSecondary_TFRC.tbSizeIndexOnHS_SCCH := p_TestPoint_M3.tFRI;
    
    //Configure test point in the SS via TFRC_ExplicitCfg
    f_UTRAN_CMAC_MACHs_Config(utran_CellDedicated,
                              cas_CMAC_MAChs_TFRC_ExplicitConfigReq_r10(utran_CellDedicated,
                                                                        p_HSPA_Parameters.TFRCconfigure_ExtList[0], //@sic R5-145142 sic@: TFRCconfigure_r10 renamed and changed to a list
                                                                        p_ActTime,
                                                                        p_HSPA_Parameters.hSPA_InfoPerCell[0].hS_DSCH_TBSizeTable)); // @sic R5s140782 sic@
    
    //Calculate next HARQ process Id
    p_HarqProcessId := ((p_HarqProcessId + 1) mod f_UTRAN34_GetNumberOfProcesses(p_HSPA_Parameters.hARQ_Info_r7));
    
    //Set HARQ Process Id for the different flows. Same HARQ process Id is used for the 3 data flows
    // @sic R5s140782 sic@
    f_UTRAN_CMAC_MACehs_Harq_Config_MultiFlows(utran_CellDedicated,
                                               cas_CMAC_MACehs_HARQAssign_MultiFlows_REQ(utran_CellDedicated, p_HarqProcessId, omit, p_HarqProcessId, omit, cs_HARQAssign_MultiFlows_r10(p_HarqProcessId, omit)));
    //f_UTRAN34_SS_HS_SetHARQProcessId_3C(v_HarqProcess); //Same HARQ process Id is used for the 3 data flows
  }

   /*
   * @desc      Configures MAC-ehs for HARQ allocation with multiflows
   * @param     p_CellId
   * @param     p_CMAC_MACHs_Config_REQ
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_CMAC_MACehs_Harq_Config_MultiFlows (UTRAN_CellId_Type p_CellId,
                                                       template (value) U_CMAC_CONFIG_REQ p_CMAC_MACHs_Config_REQ) runs on UTRAN_PTC
  {
    U_CMAC.send ( p_CMAC_MACHs_Config_REQ );
    U_CMAC.receive ( car_CMAC_MACehs_HARQAssign_MultiFlows_CNF ( p_CellId ) );
  }

  /*
   * @desc      Auxiliary function to make the coding of the test case easier
   * @param     p_Mod1
   * @param     p_Mod2
   * @param     p_Mod3
   * @return    integer
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetModulationCase(ModulationScheme p_Mod1,
                                       ModulationScheme p_Mod2,
                                       ModulationScheme p_Mod3) return integer
  {
    var integer v_ModCase := 0;
    
    if ((p_Mod1 == p_Mod2) and (p_Mod2 == p_Mod3)) {
      v_ModCase := 1;
    }
    else if ((p_Mod1 == p_Mod2) and (p_Mod2 != p_Mod3)) {
      v_ModCase := 2;
    }
    else if ((p_Mod1 != p_Mod2) and (p_Mod2 != p_Mod3)) {
      v_ModCase := 3;
    }
    else {
      FatalError(__FILE__, __LINE__, "invalid configuration");
    }
    return v_ModCase;
  }

  /*
   * @desc      To send and receive SDUs for a specific test point
   * @param     p_DataSend
   * @param     p_DataRx
   * @param     p_DlRLC_SDUs
   * @status    APPROVED (UTRAN)
   */
  function f_TestPointExecute_RB25_3C(bitstring p_DataSend,
                                      bitstring p_DataRx,
                                      integer p_DlRLC_SDUs) runs on UTRAN_PTC
  {
    var integer i;
    var integer v_SDU_Count := 0;
    var integer v_PDUSperFlow := p_DlRLC_SDUs/3; //It will have the value 1 or 4
    timer t_Watchdog := 5.0;
    
    f_Delay(0.3); //300 ms delay for allowing any acks to be transmitted/Received
    
    f_UTRAN34_BindTestDataInMultipleMACehs_PDU_4C(tsc_RB25, v_PDUSperFlow, omit, v_PDUSperFlow, omit, v_PDUSperFlow, omit);
    
    // Send RLC SDUs
    for (i:=1; i<=p_DlRLC_SDUs; i:=i+1) {
      U_AM.send(cas_RLC_AM_TestData_Req(cs_RLC_AM_DataReq(utran_CellDedicated, tsc_RB25, cs_TrD_Data(p_DataSend))));
    }
    // Receive loopbacked RLC SDUs
    t_Watchdog.start;
    do {
      alt {
        [] U_AM.receive(car_RLC_AM_TestData_Ind(cr_RLC_AM_DataInd(utran_CellDedicated, tsc_RB25, cr_TrD_Data(p_DataRx)))) {
          v_SDU_Count := v_SDU_Count + 1;
          t_Watchdog.stop; //@sic R5s1400782 sic@
        }
        [] t_Watchdog.timeout {
          f_SetVerdict(fail, __FILE__, __LINE__, "Incomplete loopback RLC SDUs "); //@sic R5s1400782 sic@
          f_UTRAN34_ExitTestCase_3C();
        }
      }
    } while (v_SDU_Count < p_DlRLC_SDUs);
  }

  /*
   * @desc      Leave the test case in an orderly way, ready for next execution
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ExitTestCase_3C() runs on UTRAN_PTC
  {
    f_UTRAN34_OpenUE_TestLoop(ps_domain);
    f_UTRAN34_DeactivateRB_TestMode(ps_domain);
    f_UTRAN34_RRC_ConnRel(utran34_Cell1, cell_Dch);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
    f_UTRAN_ReleaseCell(utran34_Cell2, f_UTRAN_CellInfo_GetConfigType(utran34_Cell2));
    f_UTRAN_ReleaseCell(utran34_Cell3, f_UTRAN_CellInfo_GetConfigType(utran34_Cell3));
    f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Loopbacked PDUs not received on time");
  }

  /*
   * @desc      Generic test procedure in 34.123-1, 14.1..3.5b
   * @param     p_CellList
   * @param     p_Configuration_3C4C
   * @param     p_EstCause
   * @param     p_PagCause
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RAB_CommonTestProcedure_3C(UTRAN_CellIdList_Type  p_CellList,
                                            UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                            EstablishmentCause p_EstCause,
                                            PagingCause p_PagCause) runs on UTRAN_PTC
  {
    //Create serving cell
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);

    //Create Secondary cells @sic R5s140782 sic@
    f_UTRAN34_CreateSecondaryCell(utran34_Cell2);
    f_UTRAN34_CreateSecondaryCell(utran34_Cell3);

    //Idle Updated for Serving cell
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    //Configure Test mode from Idle
    f_UTRAN_Page(utran34_Cell1, p_PagCause, oct2bit(px_PTMSI_Def));
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, p_EstCause);
    f_UTRAN_GMM_ServReq(); // @sic R5s150838 sic@
    f_UTRAN34_RRC_Security(utran34_Cell1, false, ps_domain);
    f_UTRAN34_ActivateRB_TestMode();
    
    //Switch on Secondary cells @sic R5s140782 sic@
    f_UTRAN_SetCellPower(utran34_Cell2, tsc_AttenuationServingCell);
    f_UTRAN_SetCellPower(utran34_Cell3, tsc_AttenuationServingCell);
    
    f_UTRAN34_ExecCounter_3C(p_CellList, p_Configuration_3C4C, qpsk, qpsk, qpsk);    // Execution counter 1
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Execution counter 1"); //@sic R5s140782 sic@
    f_UTRAN34_ExecCounter_3C(p_CellList, p_Configuration_3C4C, qam16, qam16, qam16); // Execution counter 2
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Execution counter 2"); //@sic R5s140782 sic@
    f_UTRAN34_ExecCounter_3C(p_CellList, p_Configuration_3C4C, qam64, qam64, qam64); // Execution counter 3
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Execution counter 3"); //@sic R5s140782 sic@
    f_UTRAN34_ExecCounter_3C(p_CellList, p_Configuration_3C4C, qam64, qam64, qam16); // Execution counter 4
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Execution counter 4"); //@sic R5s140782 sic@
    f_UTRAN34_ExecCounter_3C(p_CellList, p_Configuration_3C4C, qam64, qam16, qpsk);  // Execution counter 5
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Execution counter 5"); //@sic R5s140782 sic@

    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_DeactivateRB_TestMode(ps_domain);
    
    f_UTRAN34_RRC_ConnRel(utran34_Cell1, cell_Dch);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
    f_UTRAN_ReleaseCell(utran34_Cell2, f_UTRAN_CellInfo_GetConfigType(utran34_Cell2));
    f_UTRAN_ReleaseCell(utran34_Cell3, f_UTRAN_CellInfo_GetConfigType(utran34_Cell3));
  }

  /*
   * @desc      Execution counter as described in the RAB test cases
   * @param     p_CellList
   * @param     p_Configuration_3C4C
   * @param     p_Mod1
   * @param     p_Mod2
   * @param     p_Mod3
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ExecCounter_3C(UTRAN_CellIdList_Type  p_CellList,
                                    UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                    ModulationScheme p_Mod1, ModulationScheme p_Mod2, ModulationScheme p_Mod3) runs on UTRAN_PTC
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo:= f_UTRAN_Security_Get();
    var template (value) UTRAN34_HSPA_Parameters_Type v_HSPA_Parameters_Template;
    var UTRAN34_HSPA_Parameters_Type v_HSPA_Parameters;
    var integer v_HarqProcessId; //Identifies the HARQ process to be used during the test point execution
    
    //@sic R5-145142 sic@: Change in function name, unused part removed
    v_HSPA_Parameters_Template := f_UTRAN34_InitialiseHSPA_Parameters(p_Mod1, false, false); // Initilize with default configuration for Serving Cell. @sic R5s140782 sic@
    // Non-MIMO, E-DCH not configured
    //Set parameters for execution counter
    v_HSPA_Parameters_Template.transmissionWindowSize := tw1024;
    v_HSPA_Parameters_Template.receivingWindowSize := rw2047;
    v_HSPA_Parameters_Template.hARQ_Info_r7 := cs_HARQ_Info6_FDD;
    
    // Change parameters according to modulations in secondary cells
    // @sic R5s140782 sic@
    if (p_Mod2==qam64) {
      v_HSPA_Parameters_Template.hSPA_InfoPerCell[1] := cs_HSPA_InfoPerCell_64QAM_NoEDCH;
    }
    else {
      v_HSPA_Parameters_Template.hSPA_InfoPerCell[1] := cs_HSPA_InfoPerCell_Def;
    }

    if (p_Mod3==qam64) {
      v_HSPA_Parameters_Template.hSPA_InfoPerCell[2] := cs_HSPA_InfoPerCell_64QAM_NoEDCH;
    }
    else {
      v_HSPA_Parameters_Template.hSPA_InfoPerCell[2] := cs_HSPA_InfoPerCell_Def;
    }
    
    //noOfChannelisatonCodes and tbSizeIndexOnHS_SCCH are initialized to these values for better configuration of TFRC in initial RB setup step.
    //Values chosen so that one RLC PDU (biggest case: AM 640 bits) can be sent in one TTI
    //(24 bit MAC-ehs fixed header, 0 Bit MAC-D H+ 16 Bit RLC AM header + 640 bit payload= 680. The lowest TF size satisfying this is 688 => kt =65 => as Ki,o =58, ki =7)
    v_HSPA_Parameters_Template.TFRCconfigure_ExtList[0] := cs_TFRCconfigure4C_Explicit(cs_TFRC_Explicit_RAB(p_Mod1, 2, 7), //@sic R5-145142 sic@: TFRCconfigure_r10 renamed and changed to a list
                                                                                cs_TFRC_Explicit_RAB(p_Mod2, 2, 7),
                                                                                cs_TFRC_Explicit_RAB(p_Mod3, 2, 7),
                                                                                omit);
    v_HSPA_Parameters := valueof(v_HSPA_Parameters_Template);
    
    v_HarqProcessId := f_UTRAN34_GetNumberOfProcesses(v_HSPA_Parameters.hARQ_Info_r7) - 1; // First PDU sent will be with HARQ Process 0
    
    f_UTRAN34_RB_SetUp_4C(p_CellList,
                          p_Configuration_3C4C,
                          v_HSPA_Parameters,
                          cell_DCH_HS_DSCH,
                          true, //Loopback activated
                          cs_RLC_InfoAM_Common(cds_UL_AM_RLC_Flexible(v_HSPA_Parameters.transmissionWindowSize),
                                               cds_DL_AM_RLC_Flexible_r7(v_HSPA_Parameters.receivingWindowSize),
                                               true_)); // @sic R5s140782 sic@
    
    //Step 13: Transfort format combination is limited to "Restricted UL TFCI"
    U_AM.send(cas_RLC_Data_Req_NoCnf(utran_CellDedicated, tsc_RB2, cs_TransportFormatCombCtrl(v_SecurityInfo.dl_IntegrityCheckInfo, cs_TFC_Allowed_0_1_4_5_9))); // @sic R5s140782 sic@
    
    //Step 14 - 15: UL RLC SDU Size is set to 1272 bits
    f_UTRAN34_CloseUE_TestLoop(ps_domain, tsc_UE_TestLoopMode1, cs_UE_TestLoopMode1_LB_Setup(1272, tsc_RB25));
    
    //Configure restricted UL TFCIs in the SS
    f_UTRAN34_SS_TFC_Restriction_UL(utran_CellDedicated, cs_TFC_Allowed_0_1_4_5_9);
    
    //Steps 16-19
    f_UTRAN34_Subtest_3C(v_HarqProcessId, v_HSPA_Parameters);
    
    //Steps 20 - 21
    f_UTRAN34_OpenUE_TestLoop(ps_domain);
    
    //Step 22
    f_UTRAN34_RB_Release_HSDSCH_4C(p_CellList, tsc_DL_DPCH1_2ndScrC); //@sic R5s140782 sic@
  }

  /*
   * @desc      Steps 16-19 of RAB generic test procedure
   * @param     p_HarqProcessId
   * @param     p_HSPA_Parameters
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_Subtest_3C(integer p_HarqProcessId,
                                UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters) runs on UTRAN_PTC
  {
    var integer v_TestPointCount := 1;
    var bitstring v_RB_TestData_41984 := f_GetLeastSignificantBits(oct2bit(f_GetN_OctetsFromPRBS(0, 5248)), 41984);
    
    do {
      f_UTRAN34_TestPoint_3C(v_TestPointCount, v_RB_TestData_41984, int2bit(1272, 16), p_HarqProcessId, p_HSPA_Parameters);
      v_TestPointCount := v_TestPointCount + 1;
    } while (v_TestPointCount <= 64); //64 is the maximun number of test points
  }

  /*
   * @desc      Execution for each test point
   * @param     p_Count
   * @param     p_Data
   * @param     p_RLCDataSize
   * @param     p_HarqProcessId
   * @param     p_HSPA_Parameters
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_TestPoint_3C(integer p_Count,
                                  bitstring p_Data,
                                  B16_Type  p_RLCDataSize,
                                  integer p_HarqProcessId,
                                  UTRAN34_HSPA_Parameters_Type p_HSPA_Parameters) runs on UTRAN_PTC
  {
    var TestPoint_Type v_TestPoint_M1;
    var TestPoint_Type v_TestPoint_M2;
    var TestPoint_Type v_TestPoint_M3;
    var bitstring v_RB_DataSend;
    var bitstring v_RB_DataRx;
    var integer v_DlRLC_SDUs;  //Number of DL RLC SDUs to be sent in step f) of 14.1.3.5b
    // @sic R5s140782 sic@: Deleted Activation time calculation
    //@sic R5-145142 sic@: TFRCconfigure_r10 renamed and changed to a list
    var ModulationScheme v_Mod1 := p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.serving_TFRC.modulationScheme;
    var ModulationScheme v_Mod2 := p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.firstSecondary_TFRC.modulationScheme;
    var ModulationScheme v_Mod3 := p_HSPA_Parameters.TFRCconfigure_ExtList[0].rel10_AspExt.explicitlyConfigured_4C.secondSecondary_TFRC.modulationScheme;
    var integer v_ModCase:= f_UTRAN34_GetModulationCase(v_Mod1, v_Mod2, v_Mod3); /* Case 1 -> Mod1=Mod2=Mod3
                                                                                    Case 2 -> Mod1=Mod2!=Mod3
                                                                                    Case 3 -> Mod1!=Mod2!=Mod3 */
    // Get test points
    select (v_ModCase) {
      case (1) { //Mod1=Mod2=Mod3
        v_TestPoint_M1 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_1Or2Or3_4C(v_Mod1, p_Count);
        v_TestPoint_M2 := v_TestPoint_M1; //Use same test point for all modulations
        v_TestPoint_M3 := v_TestPoint_M1;
      }
      case (2) { //Mod1=Mod2!=Mod3
        v_TestPoint_M1 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_7(v_Mod1, p_Count);
        v_TestPoint_M2 := v_TestPoint_M1;
        v_TestPoint_M3 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_7(v_Mod3, p_Count);
      }
      case (3) { //Mod1!=Mod2!=Mod3
        v_TestPoint_M1 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_8(v_Mod1, p_Count);
        v_TestPoint_M2 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_8(v_Mod2, p_Count);
        v_TestPoint_M3 := f_UTRAN34_GetTestPoint_14_1_3_4b_2_8(v_Mod3, p_Count);
      }
    }
    //Test point is valid
    if (v_TestPoint_M1.flag and v_TestPoint_M2.flag and v_TestPoint_M3.flag) {
      // Data to be sent
      select (v_ModCase) {
        case (1) { //Mod1=Mod2=Mod3
          if ((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS) <= 12032) {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-120)/24)));
            v_DlRLC_SDUs := 3;
          }
          else {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-408)/96)));
            v_DlRLC_SDUs := 12;
          }
        }
        case (2) { //Mod1=Mod2!=Mod3
          if ((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS) <= 12032) {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-152)/24)));
            v_DlRLC_SDUs := 3;
          }
          else {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-440)/96)));
            v_DlRLC_SDUs := 12;
          }
        }
        case (3) { //Mod1!=Mod2!=Mod3
          if ((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS) <= 12032) {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-168)/24)));
            v_DlRLC_SDUs := 3;
          }
          else {
            v_RB_DataSend := substr(p_Data, 0, (8*(((v_TestPoint_M1.tBS + v_TestPoint_M2.tBS + v_TestPoint_M3.tBS)-456)/96)));
            v_DlRLC_SDUs := 12;
          }
        }
      }
      // Data to be received
      v_RB_DataRx := f_GetMostSignificantBits_WrapAround(v_RB_DataSend, bit2int(p_RLCDataSize));
      // Configure SS with the test point
      f_UTRAN34_SS_TestPointConfig_3C(v_TestPoint_M1,
                                      v_TestPoint_M2,
                                      v_TestPoint_M3,
                                      -, //@sic R5s140782 sic@
                                      p_HarqProcessId,
                                      p_HSPA_Parameters);
      
      f_TestPointExecute_RB25_3C(v_RB_DataSend, v_RB_DataRx, v_DlRLC_SDUs);
    }
  }

  /*
   * @desc      To release RAB 25 configured in 3C/4C in cell_DCH_HSDSCH
   *            and reconfigure SRBs on UL/DL-DPCH (A1)
   * @param     p_CellList
   * @param     p_SecondaryScramblingCode (default value: tsc_DL_DPCH_ScrC_3)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_RB_Release_HSDSCH_4C(UTRAN_CellIdList_Type  p_CellList,
                                          SecondaryScramblingCode  p_SecondaryScramblingCode := tsc_DL_DPCH_ScrC_3) runs on UTRAN_PTC // @sic R5s140782 sic@: Default as in 34.108, RB RELEASE message
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var UTRAN_CFN_Info_Type v_CfnInfo := f_CalculateActTime(p_CellList[0]);
    var template (value) SS_ActivationTime v_SS_ActivationTime := cs_ActivateCFN(v_CfnInfo.actTime);
    var UL_ScramblingCode v_UL_ScrCode := f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellList[0]);
    var PrimaryScramblingCode v_PrimScrCode := f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellList[0]);
    
    // Send RadioBearerRelease message
    U_AM.send(cas_RLC_Data_Req_Cnf(utran_CellDedicated, tsc_RB2, tsc_Mui, cs_RB_Release_HSDSH_ToDCH_r10_FDD(v_SecurityInfo.dl_IntegrityCheckInfo, // @sic R5s140782 sic@
                                                                                                      v_CfnInfo.actTime,
                                                                                                      tsc_RB25,
                                                                                                      v_UL_ScrCode,
                                                                                                      v_PrimScrCode,
                                                                                                      p_SecondaryScramblingCode))); // @sic R5s140782 sic@
    U_AM.receive(car_AM_DataMuiCnf(utran_CellDedicated,tsc_RB2, tsc_Mui)); // @sic R5s140782 sic@
    
    //Reconfigure cells to StandAlone SRB on UL/DL-DPCH
    f_UTRAN_CRLC_Rel(utran_CellDedicated, tsc_RB25, UTRAN_FDD);
    
    // Release DL-HS-PDSCH
    f_UTRAN_CMAC_Config(cas_MAC_FDD_Release(utran_CellDedicated, tsc_HSPDSCH));
    f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellList[0], tsc_HSPDSCH, cs_TrChConfigTypeNonDCH));
    f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellList[0], tsc_HSPDSCH));
    f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellList[1], tsc_HSPDSCH, cs_TrChConfigTypeNonDCH));
    f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellList[1], tsc_HSPDSCH));
    f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellList[2], tsc_HSPDSCH, cs_TrChConfigTypeNonDCH));
    f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellList[2], tsc_HSPDSCH));
    if (lengthof(p_CellList) == 4) {
      f_UTRAN_CPHY_TrCH_Release(cas_PHY_ReleaseDCH_FDD(p_CellList[3], tsc_HSPDSCH, cs_TrChConfigTypeNonDCH));
      f_UTRAN_CPHY_RL_Release(cas_RL_RelReq_FDD(p_CellList[3], tsc_HSPDSCH));
    }
    
    // Reconfigure UL/DL-DPCH to SRBs 13.6kbps
    f_SS_DCH_ModifyToSRB136_FDD_r10( p_CellList[0],
                                     v_SS_ActivationTime,
                                     p_SecondaryScramblingCode); // @sic R5s140782 sic@
    
    //Set cell configuration
    f_UTRAN_CellInfo_SetConfigType(p_CellList[0], cell_DCH_StandAloneSRB);
    f_UTRAN_CellInfo_SetConfigType(p_CellList[1], cell_SecondaryDualCell_NoConn);
    f_UTRAN_CellInfo_SetConfigType(p_CellList[2], cell_SecondaryDualCell_NoConn);
    if (lengthof(p_CellList) == 4) {
      f_UTRAN_CellInfo_SetConfigType( p_CellList[3], cell_SecondaryDualCell_NoConn);
    }
    
    //Receive RB Release Complete message
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated, tsc_RB2, cr_108_radioBearerReleaseComplete(tsc_RRC_TI)));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 14.6.1j
   * @status    APPROVED (UTRAN)
   */
  function f_TC_14_6_1j_UTRAN() runs on UTRAN_PTC
  { /* Interactive or background / UL: 64 DL: [max bit rate depending on UE category] with Flexible RLC and MAC-ehs PS RAB + UL: 3.4 DL: 3.4 kbps SRBs for DCCH / DL: QPSK, 16QAM, 64QAM and 3C - 3C on Single Band (3-0) */

    var boolean v_Interactive := pc_Interactive and ((px_ExecutePS_Class == 0) or (px_ExecutePS_Class == 1));
    var boolean v_Background := pc_Background and ((px_ExecutePS_Class == 0) or (px_ExecutePS_Class == 2));
    
    f_UTRAN34_RAB_Check_ExecutePS_Class_IntOrBack();
    
    //Initialize all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    //Initialize frequencies for 3C/4C
    f_UTRAN34_InitFrequency_4C({utran34_Cell1, utran34_Cell2, utran34_Cell3}, C3_SingleBand, 3, 0);
    
    if (v_Interactive) {
      f_UTRAN34_RAB_CommonTestProcedure_3C({utran34_Cell1, utran34_Cell2, utran34_Cell3},
                                       C3_SingleBand, terminatingInteractiveCall, terminatingInteractiveCall);
    }
    if (v_Background) {
      f_UTRAN34_RAB_CommonTestProcedure_3C({utran34_Cell1, utran34_Cell2, utran34_Cell3},
                                       C3_SingleBand, terminatingBackgroundCall, terminatingBackgroundCall);
    }
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 14.6.1k
   * @status    APPROVED (UTRAN)
   */
  function f_TC_14_6_1k_UTRAN() runs on UTRAN_PTC
  { /* Interactive or background / UL: 64 DL: [max bit rate depending on UE category] with Flexible RLC and MAC-ehs PS RAB + UL: 3.4 DL: 3.4 kbps SRBs for DCCH / DL: QPSK, 16QAM, 64QAM and 3C - 3C on Dual Band (2-1) */
    var boolean v_Interactive := pc_Interactive and ((px_ExecutePS_Class == 0) or (px_ExecutePS_Class == 1));
    var boolean v_Background := pc_Background and ((px_ExecutePS_Class == 0) or (px_ExecutePS_Class == 2));
    
    f_UTRAN34_RAB_Check_ExecutePS_Class_IntOrBack();
    
    //Initialize all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    //Initialize frequencies for 3C/4C
    f_UTRAN34_InitFrequency_4C({utran34_Cell1, utran34_Cell2, utran34_Cell3}, C3_DualBand, 2, 1);
    
    if (v_Interactive) {
      f_UTRAN34_RAB_CommonTestProcedure_3C({utran34_Cell1, utran34_Cell2, utran34_Cell3},
                                       C3_DualBand, terminatingInteractiveCall, terminatingInteractiveCall);
    }
    if (v_Background) {
      f_UTRAN34_RAB_CommonTestProcedure_3C({utran34_Cell1, utran34_Cell2, utran34_Cell3},
                                       C3_DualBand, terminatingBackgroundCall, terminatingBackgroundCall);
    }
  }

}
