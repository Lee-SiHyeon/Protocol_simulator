                                                                    cs_MeasObjectToAddModList_2Entries(tsc_IdMeasObject_f1,
                                                                                                       cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq_1), p_MeasurementBandwidth_1), //@sic R5-172830 sic@
                                                                                                       tsc_IdMeasObject_f11,
                                                                                                       cs_MeasObject_measObjectGERAN(p_StartingARFCN,
                                                                                                                                     p_BandIndicator,
                                                                                                                                     cs_FollowingARFCNs_explicitListOfARFCNs(p_ExplicitListOfARFCNs),
                                                                                                                                     0,
                                                                                                                                     '01000000'B,
                                                                                                                                     omit)),
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfig_B2_GERAN,
                                                                                                       cs_508_ReportConfigInterRAT_B2_GERAN(-69, -79)),
                                                                    omit,
                                                                    cs_MeasIdToAddModList_1Entry(1, tsc_IdMeasObject_f11, tsc_IdReportConfig_B2_GERAN),
                                                                    cs_QuantityConfig(omit,
                                                                                      omit,
                                                                                      p_QuantityConfigGERAN,
                                                                                      omit),
                                                                    cs_508_MeasGapConfig_GP2, -, -, -,
                                                                    p_MeasObjectToAddModList_v9e0)); // @sic R5-171143 sic@

  template (value) QuantityConfigCDMA2000 cs_QuantityConfigCDMA2000 (QuantityConfigCDMA2000.measQuantityCDMA2000 p_MeasQuantityCDMA2000 ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    measQuantityCDMA2000 := p_MeasQuantityCDMA2000
  };

  template (value) ReportConfigInterRAT_Trigger_Type cs_ReportConfigInterRAT_Trigger_B2_CDMA2000(EUTRA_RS_EPRE_Type p_EUTRA_Thres) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    event := {
      eventId := {
        eventB2 := {
          b2_Threshold1 := {
            threshold_RSRP := p_EUTRA_Thres + 140 //@sic Changed back from 141 (R5-0904639) to formerly 140, R5-100111 sic@
          },
          b2_Threshold2 := {
            b2_Threshold2CDMA2000 := 30 // fixed to 30 (-15 DB as per 36508 9.0.0)
          }
        }
      },
      hysteresis := 2,
      timeToTrigger := ms0
    }
  };

  template (value) ReportConfigToAddMod_ReportConfig_Type cs_508_ReportConfigInterRAT_B2_CDMA2000(EUTRA_RS_EPRE_Type p_EUTRA_Thres) :=
  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
  /* @sic R5s160711 BASELINE MOVING 2016: use of cs_ReportConfig_reportConfigInterRAT sic@ */
    cs_ReportConfig_reportConfigInterRAT(cs_ReportConfigInterRAT_Trigger_B2_CDMA2000(p_EUTRA_Thres),
                                         8,
                                         ms2048,
                                         r1);

  template (present) MeasResultCDMA2000 cr_MeasResultCDMA2000(template (present) PhysCellIdCDMA2000 p_PhysCellId,
                                                              template MeasResultCDMA2000.cgi_Info p_Cgi_Info,
                                                              template CDMA2000_PilotPnPhase p_PilotPnPhase,
                                                              template (present) CDMA2000_PilotStrength p_PilotStrength) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    physCellId := p_PhysCellId,
    cgi_Info := p_Cgi_Info,
    measResult := {
      pilotPnPhase := p_PilotPnPhase,
      pilotStrength := p_PilotStrength
    }
  };

  template MeasResults.measResultNeighCells cr_MeasResultNeighCells_measResultsCDMA2000_1Entry(template (present) boolean p_PreRegistrationStatusHRPD,
                                                                                                         template (present) PhysCellIdCDMA2000 p_PhysCellId,
                                                                                                         template MeasResultCDMA2000.cgi_Info p_Cgi_Info,
                                                                                                         template CDMA2000_PilotPnPhase p_PilotPnPhase,
                                                                                                         template (present) CDMA2000_PilotStrength p_PilotStrength ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    /* @sic R5s120913 - additional change: usage of cr_MeasResultCDMA2000 sic@ */
    measResultsCDMA2000 := {
      preRegistrationStatusHRPD := p_PreRegistrationStatusHRPD,
      measResultListCDMA2000 := {
        cr_MeasResultCDMA2000(p_PhysCellId, p_Cgi_Info, p_PilotPnPhase, p_PilotStrength)
      }
    }
  };

