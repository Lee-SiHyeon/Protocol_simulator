module MCPTT_PrivateCall_MCX_IMS {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from MCPTT_MediaControl_Procedures all;
  import from MCPTT_SIP_CallControl all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_MIME_Functions all;
  import from MCX_Parameters all;
  import from MCX_SDP_MCPTT_MCVideo all;
  import from MCX_SIP_CallControl_Common all;
  import from MCX_SIP_CallControl_MCPTT_MCVideo all;
  import from MCX_SIP_Common all;
  import from MCX_XML_mcptt_info all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.1.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_1_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Automatic Commencement Mode / With Floor Control / Upgrade to Emergency Call / Cancellation of Emergency on User request / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a private call to user B with automatic commencement mode and implicit floor request");
    
     // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(PRIVATE_CALL, -, -, withImplictGrantRequest);    // Table 5.3A.1.3-1 NOTE1.b.ii
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 5" Void siclog@

    // @siclog "Step 5A" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 5A");

    // @siclog "Step 6" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 7" siclog@
    f_MCPTT_FloorReleaseTaken(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 8 - 9" Void siclog@

    // @siclog "Step 10" siclog@
    f_UT_MCX_PTTOn(MMI);
    
    // @siclog "Step 11" siclog@
    f_MCPTT_FloorRequestDenied(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 12" Void siclog@

    // @siclog "Step 13" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 14" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 15" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 16" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");

    // @siclog "Step 17" Void siclog@

    // @siclog "Step 18" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 18A" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 18A");

    // @siclog "Step 19" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request upgrade of the call to an emergency private call with implicit floor request");

    // @siclog "Step 20" siclog@
    f_MCPTT_SessionModificationCO_Upgrade(PRIVATE_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    
    // @siclog "Step 21 - 22" Void siclog@

    // @siclog "Step 22A" siclog@
    f_MCX_UserCheckFailOnly(__FILE__, __LINE__, "The UE (MCPTT client) provides floor granted notification to the user", "Step 22A"); // NOTE: prose does not specify a "Check" statement and a pass verdict

    // @siclog "Step 23" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 24" siclog@
    f_MCPTT_FloorReleaseTaken(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 24");

    // @siclog "Step 25 - 26" Void siclog@

    // @siclog "Step 27" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 28" siclog@
    f_MCPTT_FloorRequestGranted(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 28");

    // @siclog "Step 29" Void siclog@

    // @siclog "Step 30" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 31" siclog@
    f_MCPTT_FloorReleaseIdle(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 31");

    // @siclog "Step 32" Void siclog@

    // @siclog "Step 33" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request downgrade of the call to a normal private call");

    // @siclog "Step 34" siclog@
    f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCPTT, PRIVATE_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 34");

    // @siclog "Step 34A" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);      // @sic R5-216734 sic@

    // @siclog "Step 35 - 36" Void siclog@

    // @siclog "Step 36A" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 36B" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 36B");

    // @siclog "Step 37" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 38" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 38");

    // @siclog "Step 39" Void siclog@

    // @siclog "Step 40 - 41" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 41");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.2.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_2_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Automatic Commencement Mode / With Floor Control / Upgrade to Emergency Call / Cancellation of Emergency on User request / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCPTT, PRIVATE_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
    
    // @siclog "Step 2 - 3" Void siclog@
    
    // @siclog "Step 4" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL);

    // @siclog "Step 5" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 6" siclog@
    f_MCPTT_FloorRequestDenied(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    // @siclog "Step 7" Void siclog@
    
    // @siclog "Step 8" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 9" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 10" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    
    // @siclog "Step 11" Void siclog@
    
    // @siclog "Step 12" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 13" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    
    // @siclog "Step 14 - 15" Void siclog@
    
    // @siclog "Step 16" siclog@
    f_MCPTT_SessionModificationCT(UPGRADE, -, PRIVATE_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");

    // @siclog "Step 17" Void siclog@
    
    if (pc_MCX_DisplayInfoEmergencyCall) {
      // @siclog "Step 18a1" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the call has been upgraded to an emergency private call?", "Step 18a1");
    }

    // @siclog "Step 19" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(EMERGENCY_CALL);

    // @siclog "Step 20" Void siclog@
    
    // @siclog "Step 21" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(EMERGENCY_CALL);

    // @siclog "Step 22" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 23" siclog@
    f_MCPTT_FloorRequestGranted(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23");
    
    // @siclog "Step 24" Void siclog@
    
    // @siclog "Step 25" siclog@
    f_MCPTT_FloorControl_SendFloorRevoke(EMERGENCY_CALL);
    
    // @siclog "Step 26" Void siclog@

    // @siclog "Step 27" siclog@
    f_MCPTT_FloorReleaseTaken(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 27");

    // @siclog "Table 6.2.2.3.2-2: Parallel Behaviour" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the permission to send RTP media is being revoked?", "Table 6.2.2.3.2-2: Parallel Behaviour"); // @sic R5-213665 sic@

    // @siclog "Step 28 - 30" Void siclog@
    
    // @siclog "Step 31" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(EMERGENCY_CALL);

    // @siclog "Step 32" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 33" siclog@
    f_MCPTT_FloorRequestGranted(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 34");
    
    // @siclog "Step 34" Void siclog@

    // @siclog "Step 35" siclog@
    f_MCPTT_SessionModificationCT(DOWNGRADE, -, PRIVATE_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 35");

    // @siclog "Step 36" Void siclog@

    if (pc_MCX_DisplayInfoEmergencyCall) {
      // @siclog "Step 37a1" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the call has been downgraded?", "Step 37a1");
    }

    // @siclog "Step 38 - 39" Void siclog@

    // @siclog "Step 39A" siclog@
    f_UT_MCX_PTTOff(MMI);                       // @sic R5-222030 sic@

    // @siclog "Step 39B" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);      // @sic R5-222030 sic@

    // @siclog "Step 39C" siclog@
    f_UT_MCX_PTTOn(MMI);                        // @sic R5-216743 sic@

    // @siclog "Step 40" siclog@
    f_MCPTT_FloorRequestDenied(NORMAL_CALL);    // @sic R5-216743 sic@

    // @siclog "Step 41" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 41");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.3.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_3_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Automatic Commencement Mode / Without Floor Control / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a private call to user B with automatic commencement mode and without floor control");
     
     // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(PRIVATE_CALL, -, -, withoutFloorControl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 4A" Void siclog@

    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__,"Does the UE (MCPTT client) notify the user that the call has been established?", "Step 5");

    // @siclog "Step 6 - 7" Void siclog@

    // @siclog "Step 8 - 9" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.4.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_4_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Automatic Commencement Mode / Without Floor Control / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCPTT, PRIVATE_CALL, -, -, withoutFloorControl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
    
    // @siclog "Step 2 - 4" Void sic

    // @siclog "Step 5" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.5.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_5_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Emergency Private Call / On-demand / Automatic Commencement Mode / Force of automatic commencement mode / Without Floor Control / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of an emergency private call to user B with force of automatic commencement mode and without floor control");
     
     // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(PRIVATE_CALL, EMERGENCY_CALL, AUTOMATIC_FORCE, withoutFloorControl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 4A" Void siclog@

    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__,"Does the UE (MCPTT client) notify the user that the call has been established?", "Step 5");

    // @siclog "Step 6 - 7" Void siclog@

    // @siclog "Step 8 - 9" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.6.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_6_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Emergency Private Call / On-demand / Automatic Commencement Mode / Force of automatic commencement mode / Without Floor Control / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_100TryingOnly(MCPTT, PRIVATE_CALL, EMERGENCY_CALL, AUTOMATIC_FORCE, withoutFloorControl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
    
    // @siclog "Step 2" Void sic

    if (pc_MCX_DisplayInfoEmergencyCall) {
      // @siclog "Step 3a1" siclog@
      f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the call has been established?", "Step 3a1");
    }

    // @siclog "Step 4 - 5" Void sic

    // @siclog "Step 6" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.7.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_7_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Manual Commencement Mode / Without Floor Control / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a private call to user B with manual commencement mode and without floor control");
     
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMO_PrivateManual(MCPTT);

    // @siclog "Step 3 - 5" Void siclog@

    // @siclog "Step 6" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__,"Does the UE (MCPTT client) notify the user that the call has been established?", "Step 6");

    // @siclog "Step 7 - 8" Void siclog@

    // @siclog "Step 9 - 10" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.8.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_8_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / On-demand / Manual Commencement Mode / Without Floor Control / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_MCVideo_CallSetupMT_Manual(MCPTT, -, PRIVATE_CALL, -, -, withoutFloorControl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");
    
    // @siclog "Step 2 - 6" Void siclog@

    // @siclog "Step 7" siclog@
    f_Delay(5.0);     // Wait 5s

    // @siclog "Step 8" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      MCPTT-Info for ambientlisting call establishment
   * @return    template (present) MCPTT_Info_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_Info_AmbientListening_RX() runs on MCX_IMS_PTC return template (present) MCPTT_Info_Type
  { // @sic R5s221336: anyExt to be decoded and matched after receiving sic@
    var template (present) MCPTT_Info_Type v_MCPTT_Info := f_MCX_CallControl_MCPTTInfo_RX(PRIVATE_CALL, INVITE_REFER);   // @sic R5s221336 - final implementation: f_MCX_CallControl_MCPTTInfo_RX instead of cr_MCPTT_Info_Base sic@

    v_MCPTT_Info.mcptt_Params.session_type := "ambient-listening";

    return v_MCPTT_Info;
  }

  /*
   * @desc      MCPTT-Info for ambientlisting call establishment
   * @param     p_AmbientListeningType
   * @param     p_FurtherElems      (default value: {})
   * @return    template (value) MCPTT_Info_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_Info_AmbientListening_TX(MCPTT_Info_AmbientListening_Type p_AmbientListeningType,
                                             template (value) McpttInfoExt_ElementList_Type p_FurtherElems := {}) return template (value) MCPTT_Info_Type
  {
    var template (value) MCPTT_Info_Type v_MCPTT_Info := cs_MCPTT_Info_Base;
    var template (value) McpttInfoExt_ElementList_Type v_McpttInfoExtAmbientListening := { crs_McpttInfoExt_AmbientListening(p_AmbientListeningType) };

    v_McpttInfoExtAmbientListening := v_McpttInfoExtAmbientListening & p_FurtherElems;
    v_MCPTT_Info.mcptt_Params.session_type := "ambient-listening";
    v_MCPTT_Info.mcptt_Params.anyExt := f_MCX_McpttInfoExt_Encode(v_McpttInfoExtAmbientListening);

    return v_MCPTT_Info;
  }

  /*
   * @desc      CO session establishment according to 36.579-1 Table 5.3A.1.3-1 to establish an ambient listening call
   * @param     p_CommencementMode
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_CallSetupMO_AmbientListening(MCX_CommencementMode_Type p_CommencementMode) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var MCX_MediaControlCondition_Type v_MediaControlConditionSdpOffer;
    var MCX_MediaControlConditionSdpAnswer_Type v_MediaControlConditionSdpAnswer;
    var MCPTT_Info_AmbientListening_Type v_AmbientListeningType;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) Contact v_Contact;
    var template (value) MessageHeader v_MessageHeader200OK;
    var template (value) SDP_Message v_SDP_Answer;
    var template (value) SDP_attribute v_DirectionAttributeRX;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX;
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies;

    select (p_CommencementMode) {
      case (AMBIENT_LISTENING_REMOTE) {
        v_AmbientListeningType := remote_init;
        v_DirectionAttributeRX :=  cs_SDP_Attribute_recvonly;
        v_MediaControlConditionSdpOffer := withImplictGrantRequest; // @sic R5-240575: According to 24.379 clauses 11.1.6.2.2.1 and 6.4 there shall be an mc_implicit_request to grant the floor to the terminating client sic@
        v_MediaControlConditionSdpAnswer := implicitRequestNoted;
      }
      case (AMBIENT_LISTENING_LOCAL) {
        v_AmbientListeningType := local_init;
        v_DirectionAttributeRX :=  cs_SDP_Attribute_sendonly;
        v_MediaControlConditionSdpOffer := withImplictGrantRequest;
        v_MediaControlConditionSdpAnswer := implicitRequestGranted;
      }
    }
    
    // SDP info
    v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, ON_DEMAND, PRIVATE_CALL, SDP_OFFER, v_MediaControlConditionSdpOffer, v_DirectionAttributeRX);

    // XML Bodies
    v_XmlBodies := f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(MCPTT, PRIVATE_CALL);
    v_XmlBodies.McpttInfo := fl_MCPTT_Info_AmbientListening_RX();
    v_XmlBodies.McpttInfoExt := { crs_McpttInfoExt_AmbientListening(v_AmbientListeningType) };   // @sic R5s221336 sic@ @sic R5s230490 MCC160 comments sic@

    // Receive INVITE
    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_InviteMO_ReceiveINVITE(MCPTT, PRIVATE_CALL, -, p_CommencementMode, v_SdpInfoRX, v_XmlBodies);
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;

    // Send 100 Trying
    f_MCX_InviteMO_Send100Trying(v_InviteRequestWithSdp);

    // Send 200 OK
    v_Contact := f_MCX_CallSetup_ContactSS(MCPTT);
    v_MessageHeader200OK := f_MCX_CommonResponse_200_MessageHeaderTX(v_InviteRequest.msgHeader, v_Contact, cs_ContentTypeSDP);
    v_MessageHeader200OK.featureCaps := f_MCX_FeatureCaps_MCPTT_AmbientListeningCallRelease();
    v_SDP_Answer := f_MCX_SdpAnswer_TX(MCPTT, ON_DEMAND, v_InviteRequestWithSdp.SdpOffer, v_MediaControlConditionSdpAnswer);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine200, v_MessageHeader200OK, cs_MessageBody_SDP(v_SDP_Answer))));

    // Receive ACK
    f_MCX_InviteMO_ReceiveACK(v_InviteRequest);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Common fonction for client terminated ambient listening call
   * @param     p_CommencementMode
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_Replaces          (default value: omit)
   * @param     p_SdpOfferTX        (default value: omit)
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_CallSetupMT_AmbientListening(MCX_CommencementMode_Type p_CommencementMode,
                                                 MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                                 template (omit) Replaces p_Replaces := omit,
                                                 template (omit) SDP_Message p_SdpOfferTX := omit) runs on MCX_IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MCPTT_Info_AmbientListening_Type v_AmbientListeningType;
    var template (value) MCX_MIME_XmlBodies_Type v_XmlBodiesTX;
    var template (value) SDP_Message v_SdpOfferTX;
    var template (value) SDP_attribute v_DirectionAttributeTX;
    var template (value) SDP_attribute v_DirectionAttributeRX;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX;
    var template (present) MCPTT_Info_Type v_McpttInfo;
    var boolean v_AllowTrying := true;

    select (p_CommencementMode) {
      case (AMBIENT_LISTENING_REMOTE) {
        v_AmbientListeningType := remote_init;
        v_DirectionAttributeTX :=  cs_SDP_Attribute_recvonly;   /* @sic R5s211377 - additional change: exchange of RX/TX sic@ */
        v_DirectionAttributeRX :=  cs_SDP_Attribute_sendonly;   /* @sic R5s211377 - additional change: exchange of RX/TX sic@ */
      }
      case (AMBIENT_LISTENING_LOCAL) {
        v_AmbientListeningType := local_init;
        v_DirectionAttributeTX :=  cs_SDP_Attribute_sendonly;   /* @sic R5s211377 - additional change: exchange of RX/TX sic@ */
        v_DirectionAttributeRX :=  cs_SDP_Attribute_recvonly;   /* @sic R5s211377 - additional change: exchange of RX/TX sic@ */
      }
    }
    
    // SDP info
    if (isvalue(p_SdpOfferTX)) {
      v_SdpOfferTX := valueof(p_SdpOfferTX);
    } else {
      v_SdpOfferTX := f_MCX_SdpOffer_TX(MCPTT, p_SessionType, PRIVATE_CALL);
    }
    v_SdpOfferTX.media_list[0].attributes := f_SDP_Attributes_Add_TX(v_SdpOfferTX.media_list[0].attributes, v_DirectionAttributeTX);

    // XML Bodies
    v_XmlBodiesTX := cs_MCX_MIME_XmlBodies_AllOmit;
    v_XmlBodiesTX.McpttInfo := fl_MCPTT_Info_AmbientListening_TX(v_AmbientListeningType);   // @sic R5s220344 sic@

    // Send INVITE
    v_InviteRequestWithSdp := f_MCPTT_MCVideo_InviteMT_SendINVITE(MCPTT, PRIVATE_CALL, p_CommencementMode, p_Replaces, -, v_SdpOfferTX, v_XmlBodiesTX);

    // receive 100 Trying, 200 OK, send ACK
    v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, p_SessionType, PRIVATE_CALL, SDP_ANSWER, -, v_DirectionAttributeRX);
    v_McpttInfo := f_MCX_CallControl_MCPTTInfo_RX(PRIVATE_CALL, INVITE_RSP);
    f_MCPTT_MCVideo_InviteMT_Receive200OK_SendACK(MCPTT, PRIVATE_CALL, v_InviteRequestWithSdp, v_AllowTrying, -, v_SdpInfoRX, v_McpttInfo);
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.14.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_14_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Ambient listening call / Remotely initiated Ambient listening call / Remotely initiated ambient listening call release / Success / Client Originated (CO) / Server initiated ambient call release
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MCX_CommencementMode_Type v_CommencementMode := AMBIENT_LISTENING_REMOTE;
    var O2_Type v_NoPermissionToRequestFloor := '0000'O;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a remotely initiated ambient listening call to user B");
     
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := fl_MCPTT_CallSetupMO_AmbientListening(v_CommencementMode);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3" Void siclog@

    // @siclog "Step 4" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, v_NoPermissionToRequestFloor);

    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__,"Does the UE (MCPTT client) notify the user that the remotely initiated ambient listening call has been established?", "Step 5");

    // @siclog "Step 6" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 6A" siclog@
    f_Delay(5.0);     // Wait 5s to ensure that the UE does not send anything

    // @siclog "Step 7 - 8" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9 - 10" Void siclog@

    // @siclog "Step 11" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a remotely initiated ambient listening call to user B");
     
    // @siclog "Step 12" siclog@
    v_InviteRequestWithSdp := fl_MCPTT_CallSetupMO_AmbientListening(v_CommencementMode);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    // @siclog "Step 13" Void siclog@

    // @siclog "Step 14" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, v_NoPermissionToRequestFloor);
    
    // @siclog "Step 15" Void siclog@
    
   // @siclog "Step 16" Void siclog@
    f_MCPTT_CallReleaseMT_WithReleaseReason(administrator_action);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.15.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_15_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Ambient listening call / Remotely initiated Ambient listening call / Remotely initiated ambient listening call release / Success / Client Terminated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    fl_MCPTT_CallSetupMT_AmbientListening(AMBIENT_LISTENING_REMOTE);

    // @siclog "Step 2" Void siclog@

    // @siclog "Step 3" siclog@
    f_MCPTT_FloorControl_SendFloorGranted(NORMAL_CALL, ACK_REQUIRED);    /* @sic R5-240576: ACK_REQUIRED sic@ */

    // @siclog "Step 4" siclog@
    f_MCX_UserCheckNegative(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the remotely initiated ambient listening call has been established?", "Step 4");
    
    // @siclog "Step 5" Void siclog@

    // @siclog "Step 6" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    // @siclog "Step 7" Void siclog@

    // @siclog "Step 8" siclog@
    f_MCX_UserCheckNegative(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the remotely initiated ambient listening call has been released?", "Step 8");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.16.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_16_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Ambient listening call / Locally initiated Ambient listening call / Locally initiated ambient listening call release / Success / Client Originated (CO) / Server initiated ambient call release
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MCX_CommencementMode_Type v_CommencementMode := AMBIENT_LISTENING_LOCAL;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a locally initiated ambient listening call to user B");
     
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := fl_MCPTT_CallSetupMO_AmbientListening(v_CommencementMode);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 6" Void siclog@

    // @siclog "Step 7" siclog@
    f_MCX_UserCheckNegative(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the locally initiated ambient listening call has been established?", "Step 7");

    // @siclog "Step 8" Void siclog@

    // @siclog "Step 9 - 10" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 11 - 12" Void siclog@

    // @siclog "Step 13" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a locally initiated ambient listening call to user B");
     
    // @siclog "Step 14" siclog@
    fl_MCPTT_CallSetupMO_AmbientListening(v_CommencementMode);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    // @siclog "Step 15 - 18" siclog@

    // @siclog "Step 19" siclog@
    f_MCPTT_CallReleaseMT_WithReleaseReason(administrator_action);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.2.17.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_2_17_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Private Call / Ambient listening call / Locally initiated Ambient listening call / Locally initiated ambient listening call release / Success / Client Terminated (CT)
    var O2_Type v_NoPermissionToRequestFloor := '0000'O;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    fl_MCPTT_CallSetupMT_AmbientListening(AMBIENT_LISTENING_LOCAL);

    // @siclog "Step 2" Void siclog@

    // @siclog "Step 3" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, v_NoPermissionToRequestFloor);

    // @siclog "Step 3A" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) notify the user that the locally initiated ambient listening call has been established?", "Step 3A");

    // @siclog "Step 4" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 4A" siclog@
    f_Delay(5.0);     // Wait 5s to ensure that the UE does not send anything

    // @siclog "Step 5" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

}
