module UTRAN34_RAB_Templates_r11 {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_RAB_Templates_r10 all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_CapabilityFunctions_IRAT all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_RAB_Templates_r11 all;
  import from UTRAN_RRC_RAB_Templates_r9 all;
  import from UTRAN_RRC_Templates all;
  import from UTRAN_RRC_Templates_r11 all;

  template (value) HSDSCH_Info_r11 cs_HSDSCH_Info_MACehs_r11(template (value) HARQ_Info_r11 p_HARQ_Info,
                                                             template (value) AddOrReconfMAC_ehs_ReordQ_r11 p_AddOrReconfMAC_ehs_ReordQ) :=
  { /* @status    APPROVED (UTRAN) */
    harqInfo := p_HARQ_Info,
    dl_MAC_HeaderType := {
      mac_ehs := p_AddOrReconfMAC_ehs_ReordQ
    }
  };

  template (value) DL_InformationPerRL_DpchInfo_r11 cs_DL_InformationPerRL_DpchInfo_r11(template (value) DL_DPCH_InfoPerRL_r7 p_DL_DPCH_InfoPerRL_r7) :=
  { /* @status    APPROVED (UTRAN) */
    dl_DPCH_InfoPerRL := p_DL_DPCH_InfoPerRL_r7
  };

  template (value) DL_InformationPerRL_r11 cs_DL_InfoPerRL_HSU_FDD_r11(PrimaryScramblingCode   p_ScrmbCode,
                                                                       template (value) DL_InformationPerRL_DpchInfo_r11 p_DL_DpchInfo) :=
  { /* @status    APPROVED (UTRAN) */
    modeSpecificInfo := {
      fdd := {
        primaryCPICH_Info := {
          primaryScramblingCode := p_ScrmbCode
        },
        servingHSDSCH_RL_indicator := true,
        servingEDCH_RL_indicator := true
      }
    },
    dl_dpchInfo := p_DL_DpchInfo,
    e_AGCH_Information := cs_E_AGCH_Info_FDD_r8, // AGCH
    e_ROCH_Information := omit,
    modeSpecificInfo2 := {
      fdd := {
        e_HICH_Info := {  // HICH
          e_HICH_Information := cs_E_HICH_Info_r11
        },
        e_RGCH_Info := {  // RGCH
          e_RGCH_Information := cs_E_RGCH_Info
        },
        f_TPICH_Info := omit
      }
    },
    cell_id := omit
  };

  template (value) DL_InformationPerRL_List_r11 cs_DL_InfoPerRL_List_HSU_FDD_r11(PrimaryScramblingCode   p_ScrmbCode,
                                                                                 template (value) DL_InformationPerRL_DpchInfo_r11 p_DL_DpchInfo) :=
  { /* @status    APPROVED (UTRAN) */
    cs_DL_InfoPerRL_HSU_FDD_r11(p_ScrmbCode, p_DL_DpchInfo)
  };

  template (value) DL_InformationPerRL_List_r11 cs_DL_InfoPerRL_HSUwithDPCH_r11_FDD(PrimaryScramblingCode   p_ScrmbCode,
                                                                                    SF512_AndCodeNumber     p_SpreadingFactorDPCH,
                                                                                    SecondaryScramblingCode p_SecScramblingCodeDPCH) :=
  /* @status    APPROVED (UTRAN) */
    cs_DL_InfoPerRL_List_HSU_FDD_r11(p_ScrmbCode, cs_DL_InformationPerRL_DpchInfo_r11(cs_DL_DPCH_InfoPerRL_SRB_FDD(p_SpreadingFactorDPCH, p_SecScramblingCodeDPCH)));

  template (value) AddOrReconfMAC_ehs_ReordQ_r11 cs_AddOrReconfMAC_ehs_ReordQ_r11(template (value) MAC_ehs_AddReconfReordQ_r11 p_MAC_ehs_AddReconfReordQ) :=
  { /* @status    APPROVED (UTRAN) */
    mac_ehs_AddReconfQueue_List := {
      p_MAC_ehs_AddReconfReordQ
    }
  };

  template (value) MAC_ehs_AddReconfReordQ_r11 cs_MAC_ehs_AddReconfReordQ_r11(MAC_ehs_QueueId p_QID,
                                                                              MAC_hs_WindowSize_r11 p_Mw := mws16) :=
  { /* @status    APPROVED (UTRAN) */
    mac_ehs_QueueId := p_QID,
    reorderingReleaseTimer := rt50,
    reorderingResetTimer := omit,
    mac_ehsWindowSize := p_Mw,
    mac_ehsWindowSize_extension := omit //TDD only
  };

  template (value) UL_EDCH_Information_r11 cs_UL_EDCH_Information_r11_FDD :=
  { /* @status    APPROVED (UTRAN) */
    mac_es_e_resetIndicator := true_,
    modeSpecificInfo := {
      fdd := {
        e_DPCCH_Info := cs_E_DPCCH_Info,
        e_DPDCH_Info := cs_E_DPDCH_Info,
        ul_MIMO_Info := omit,
        schedulingTransmConfiguration := cs_E_DPDCH_SchedulingTransmConfiguration_NoGrant,
        ul_16QAM_Settings := omit,
        ul_64QAM_Settings := omit
      }
    }
  };

  template (value) RAB_InformationSetup_r11 cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_r11:=
  /* @status    APPROVED (UTRAN) */
    cs_RAB_Info_PS_Common_r11(tsc_RAB_DefPS_HS, tsc_RB25, cs_PDCP_Info_DCH_PS, cs_RLC_InfoAM_HSU_r11, {cs_RB_MappingOptionPS_RAB1_EDCH_HSDSCH_MACehs});

  template (value) RLC_Info_r11 cs_RLC_InfoAM_HSU_r11 := cs_RLC_InfoAM_Common_r11(cds_UL_AM_RLC_HSU, cds_DL_AM_RLC_HSDPA_r11); /* @status    APPROVED (UTRAN) */

  template (value) DL_DCCH_Message cs_108_RB_SetUpA17f_r11_FDD(IntegrityCheckInfo  p_Integrityinfo,
                                                               ActivationTime  p_ActTime,
                                                               UL_ScramblingCode   p_UL_ScramblingCode,
                                                               PrimaryScramblingCode p_PrimScramblingCode,
                                                               template (value) FrequencyInfo p_FreqInfo) :=
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r11(p_Integrityinfo, cds_RadioBearerSetup_r11_IEs_A17f_FDD(p_ActTime,
                                                                                   tsc_H_RNTI,
                                                                                   tsc_E_RNTI,
                                                                                   p_UL_ScramblingCode,
                                                                                   p_PrimScramblingCode,
                                                                                   p_FreqInfo));

  template (value) RadioBearerSetup_r11_IEs cds_RadioBearerSetup_r11_IEs_A17f_FDD(ActivationTime  p_ActTime,
                                                                                  H_RNTI  p_NewH_RNTI,
                                                                                  E_RNTI  p_E_RNTI,
                                                                                  UL_ScramblingCode   p_UL_ScramblingCode,
                                                                                  PrimaryScramblingCode p_PrimScramblingCode,
                                                                                  template (value) FrequencyInfo p_FreqInfo)
    modifies cs_RadioBearerSetup_r11_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    activationTime := p_ActTime,
    new_H_RNTI := p_NewH_RNTI,
    newPrimary_E_RNTI := p_E_RNTI,
    rrc_StateIndicator := cell_DCH,
    rab_InformationSetupList := {
      cs_RAB_InfoSetupHSUPA_RB25_1MuxOption_r11
    },
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_SRBs_EDCH,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_Rx),
    dl_AddReconfTransChInfoList := {
      cs_DL_AddReconfTransChInfoExplicit_r11(tsc_DL_DCH5, cs_DCH_148_TFS_UE_UL),
      cs_DL_AddReconfTransChHSDSCHInfo_HSDPA_r11(cs_HSDSCH_Info_MACehs_r11(cs_HARQ_Info_FDD_r11, cs_AddOrReconfMAC_ehs_ReordQ_r11(cs_MAC_ehs_AddReconfReordQ_r11(0, mws64))))
    },
    frequencyInfo := p_FreqInfo,
    maxAllowedUL_TX_Power := tsc_MaxAllowPwr,
    ul_DPCH_Info := cs_UL_DPCH_Info_FDD_r11(tsc_UL_DPDCH_SF_SRB, pl1, p_UL_ScramblingCode, cs_UL_DPCH_PowerControlInfo_FDD_r11(3, 3, 1)),
    ul_EDCH_Information := cs_UL_EDCH_Information_r11_FDD,
    dl_HSPDSCH_Information := cs_DL_HSPDSCH_Information_FDD_r11(cs_HS_SCCH_Info_r9_FDD_Common({tsc_HS_SCCH_ChC6, tsc_HS_SCCH_ChC7}),
                                                                cs_Measurement_Feedback_Info_r11,
                                                                true_, //64QAM
                                                                omit),
    dl_CommonInformation := cs_DL_CommonInformationRB_SetUp_FDD_r11(tsc_DL_DPCH1_SFP_SRB_3_4k,
                                                                    fixed,
                                                                    false),
    dl_InformationPerRL_List := cs_DL_InfoPerRL_HSUwithDPCH_r11_FDD(p_PrimScramblingCode,
                                                                    tsc_Sfc256_C11, //64QAM dependent
                                                                    tsc_DL_DPCH1_2ndScrC)
  };

  template (value) DL_DCCH_Message cs_108_RB_SetUpFACH_RB25_FDD_r11(IntegrityCheckInfo p_Integrityinfo,
                                                                    C_RNTI p_C_RNTI,
                                                                    bitstring p_RAB_Id) :=
  /* @status    APPROVED (UTRAN) */
    cs_RadioBearerSetup_r11(p_Integrityinfo, cds_RadioBearerSetup_r11_IEs_FACH_RB25_FDD(p_C_RNTI, p_RAB_Id));

  template (value) RadioBearerSetup_r11_IEs cds_RadioBearerSetup_r11_IEs_FACH_RB25_FDD(C_RNTI p_C_RNTI,
                                                                                       bitstring p_RAB_Id)
    modifies cs_RadioBearerSetup_r11_IEs_Omit :=
  { /* @status    APPROVED (UTRAN) */
    new_C_RNTI := p_C_RNTI,
    new_H_RNTI := omit,
    rrc_StateIndicator := cell_FACH,
    rab_InformationSetupList := {
      cs_RAB_InfoFACH_RB25_r11(p_RAB_Id, cs_RLC_InfoAM_Def_r11)
    },
    ul_CommonTransChInfo := cs_UL_CommTrChInfoDCH_PS_64k_FDD,
    ul_AddReconfTransChInfoList := cs_UL_AddReconfTransChInfoListDCH_PS_64k,
    dl_CommonTransChInfo := cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
    dl_AddReconfTransChInfoList := cs_DL_AddReconfTransChInfoListDCH_PS_64k_r11
  };

  template (value) RAB_InformationSetup_r11 cs_RAB_InfoFACH_RB25_r11(bitstring p_RAB_Id,
                                                                     template (value) RLC_Info_r11 p_RLC_Info,
                                                                     template (value) RLC_SizeExplicitList p_UL_RACH_RLC_SizeExplicitList := cs_RLC_SizeExplicit2) :=
  /* @status    APPROVED (UTRAN) */
    cs_RAB_Info_PS_Common_r11(p_RAB_Id, tsc_RB25, omit, p_RLC_Info, cs_RB_MappingInfo_PS(-, -, p_UL_RACH_RLC_SizeExplicitList));

}
