  template (value) SDP_attribute_rtpmap_codec cs_RTPMAP_AMR_8000 := cs_RTPMAP_Codec("AMR", "8000", "1");                    /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
                                                                                                                               @sic R5w140113, R5w140009: replaces tsc_CODEC_AMR_8000_TX sic@ */

  template (value) SDP_attribute_rtpmap_codec cs_RTPMAP_AMR_16000 := cs_RTPMAP_Codec("AMR-WB", "16000", "1");               /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
                                                                                                                               @sic R5w140113, R5w140009: replaces tsc_CODEC_AMR_16000_TX sic@ */

  template (value) SDP_attribute_rtpmap_codec cs_RTPMAP_H264_90000 := cs_RTPMAP_Codec("H264", "90000");                     /* @status    APPROVED (IMS, LTE, LTE_A_R12, MCX, NR5GC) */

  template (value) SDP_attribute_rtpmap_codec cs_RTPMAP_H265_90000 := cs_RTPMAP_Codec("H265", "90000");                     /* @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC) */

  template (value) SDP_attribute_rtpmap_codec cs_RTPMAP_EVS_16000 := cs_RTPMAP_Codec("EVS", "16000", "1");                  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (value)   SDP_attribute_fmtp_format_specific_params cs_Fmtp_ParamList(template (value) SemicolonParam_List p_ParamList) := {paramList := p_ParamList};      /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SDP_attribute_fmtp_format_specific_params cr_Fmtp_ParamList(template (present) SemicolonParam_List p_ParamList) := {paramList := p_ParamList};    /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (value)   GenericParam cs_AMR_ModeChangeCapability := cs_GenericParam("mode-change-capability", "2");                             /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) GenericParam cr_AMR_ModeChangeCapability := f_GenericParam_AsTX(cs_AMR_ModeChangeCapability);                           /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (value)   GenericParam cs_AMR_MaxRed(charstring p_Value := "220") := cs_GenericParam("max-red", p_Value);                         /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) GenericParam cr_AMR_MaxRed(template (present) charstring p_Value := pattern "[0-9]+") := cr_GenericParam("max-red", p_Value);  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
                                                                                                                                                @sic R5-141114: in UL max-red can be any value within 0..220 sic@ */

  template (value)   GenericParam cs_EVS_Br(charstring p_Value) := cs_GenericParam("br", p_Value);                                           /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (value)   GenericParam cs_EVS_Bw(charstring p_Value := "swb") := cs_GenericParam("bw", p_Value);                                  /* @sic R5-153999; R5s170336/R5-172069 sic@
                                                                                                                                                @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (present) GenericParam cr_EVS_Br(template (present) charstring p_Value) := cr_GenericParam("br", p_Value);                        /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (present) GenericParam cr_EVS_Bw(template (present) charstring p_Value) := cr_GenericParam("bw", p_Value);                        /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (value)   GenericParam cs_EVS_BwSend(charstring p_Value := "swb") := cs_GenericParam("bw-send", p_Value);                         /* @sic R5-153999 sic@
                                                                                                                                                @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  template (value)   GenericParam cs_EVS_BwRecv(charstring p_Value := "swb") := cs_GenericParam("bw-recv", p_Value);                         /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  template (value)   SemicolonParam_List cs_Fmtp_AudioParamsDef := {cs_AMR_ModeChangeCapability, cs_AMR_MaxRed};                             /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (present) SemicolonParam_List cr_AMR_Fmtp_AudioParamsDef := {cr_AMR_ModeChangeCapability, cr_AMR_MaxRed, *};                      /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SemicolonParam_List cr_EVS_Fmtp_AudioParamsDef := {cr_AMR_MaxRed, *};                                                   /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
                                                                                                                                                NOTE: only those parameters are contained which are common for all possible EVS configurations */

  template (present) SemicolonParam_List cr_EVS_Fmtp_AudioParamsBrBwMaxRed(template (present) charstring p_BrVal := ?,
                                                                           template (present) charstring p_BwVal := ?) :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cr_EVS_Br(p_BrVal),
    cr_EVS_Bw(p_BwVal),
    cr_AMR_MaxRed,                    /* @sic R5-210056: cr_AMR_MaxRed instead of cr_AMR_MaxRed("220") sic@ */
    *
  };

  template (value)   SDP_attribute_fmtp_format_specific_params cs_AMR_Fmtp_DefaultParameters := cs_Fmtp_ParamList(cs_Fmtp_AudioParamsDef);   /* @sic R5w140113, R5w140009: replaces tsc_AMR_Fmtp_DefaultParameters_TX sic@
                                                                                                                                                @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)*/

  template (present) SDP_attribute_fmtp_format_specific_params cr_AMR_Fmtp_DefaultParameters := cr_Fmtp_ParamList(cr_AMR_Fmtp_AudioParamsDef); /* @sic R5w140113, R5w140009: replaces tsc_AMR_Fmtp_DefaultParameters_RX sic@
                                                                                                                                                  @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  template (present) SDP_attribute_fmtp_format_specific_params cr_EVS_Fmtp_DefaultParameters := cr_Fmtp_ParamList(cr_EVS_Fmtp_AudioParamsDef);                                  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  template (present) GenericParam cr_Video_Fmtp_ProfileLevelId(template (present) charstring p_Value := ?) := cr_GenericParam("profile-level-id", p_Value);                     /* @sic R5-144595 sic@
                                                                                                                                                                                   @status    APPROVED (IMS, LTE, LTE_A_R12, MCX, NR5GC)*/

  template (present) SemicolonParam_List cr_Fmtp_VideoParamsH264_MO :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_R12, MCX, NR5GC)
       @sic R5-150703: any ProfileLevelId; all other parameters are optional sic@ */
    cr_Video_Fmtp_ProfileLevelId,
    *
  };

  template (present) SDP_attribute_fmtp_format_specific_params cr_SDP_FmtpParamsH264_MO := cr_Fmtp_ParamList(cr_Fmtp_VideoParamsH264_MO);  /* @status    APPROVED (IMS, LTE, LTE_A_R12, MCX, NR5GC) */

  template (present) GenericParam cr_Video_Fmtp_ProfileId(template (present) charstring p_Value := "1") := cr_GenericParam("profile-id", p_Value);   /* @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC) */

  template (present) GenericParam cr_Video_Fmtp_LevelId(template (present) charstring p_Value := ?) := cr_GenericParam("level-id", p_Value);         /* @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC) */

  template (present) SemicolonParam_List cr_Fmtp_VideoParamsH265(template (present) charstring p_ProfileIdValue := "1",
                                                                 template (present) charstring p_LevelIdValue := ?) :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC) */
    cr_Video_Fmtp_ProfileId(p_ProfileIdValue),
    cr_Video_Fmtp_LevelId(p_LevelIdValue),
    *
  };

  template (present) SDP_attribute_fmtp_format_specific_params cr_SDP_FmtpParamsH265(template (present) charstring p_ProfileIdValue := "1",
                                                                                     template (present) charstring p_LevelIdValue := ?) :=
  /* @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC) */
