module IMS_WLAN_SSXcapTestcases {

  import from CommonIP all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_Component all;
  import from IMS_CC_TestcaseImplementation_XCAP all;
  import from IMS_XCAP_Procedures all;
  import from WLAN_CommonDefs all;
  import from WLAN_Parameters all;

  /*
   * @desc      Returnts full XCAP Server Address Information for test procedures in  TS 34.229-1
   * @return    template (value) XCAP_ServerAddrInfo_Type
   * @status    APPROVED (IMS)
   */
  function fl_WLAN_XCAP_ServerAddrInfo() return template (value) XCAP_ServerAddrInfo_Type
  {
    var WLAN_AddressInfo_Type v_AddressInfo := f_WLAN_AddressInfo_Get();
    var template (value) XCAP_ServerAddrInfo_Type v_XCAP_ServerAddrInfo;
    var PDN_AddressInfo_Type v_PDN_AddressInfo;
    
    if (pc_WLAN_XCAP_without_PDN) {
      v_XCAP_ServerAddrInfo := cs_XCAP_ServerAddrInfo(v_AddressInfo.Non3GPP_XCAP_ServerAddressIPv4, v_AddressInfo.Non3GPP_XCAP_ServerAddressIPv6);
      
    }
    else { //DS2 option @sic R5-174498 sic@
      v_PDN_AddressInfo := f_PDN_AddressInfo_Get(ePDG_XCAP); // @sic R5-174542 sic@, @sic R5s230616 change 2.3 sic@
      v_XCAP_ServerAddrInfo := cs_XCAP_ServerAddrInfo(v_PDN_AddressInfo.DNS_ServerAddressIPv4, v_PDN_AddressInfo.DNS_ServerAddressIPv6);
    }
    // @sic R5-174542 sic@
    return v_XCAP_ServerAddrInfo;
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.1
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_1_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_OIP(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.3
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_3_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_TIP(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.5
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_5_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_CFU(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.6
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_6_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_CFNRy(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.8
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_8_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_CFB(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.10
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_10_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_CFNRc(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.15
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_15_IMS1() runs on IMS_XCAP_PTC
  {
    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_XCAP_BIC_ROAM(-, fl_WLAN_XCAP_ServerAddrInfo());
    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

}
