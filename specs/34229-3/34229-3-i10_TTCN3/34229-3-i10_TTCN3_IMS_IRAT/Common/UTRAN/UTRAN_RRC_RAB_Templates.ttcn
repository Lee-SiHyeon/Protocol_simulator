  template (value) HS_SCCH_TDD128_r6 cs_HS_SCCH_TDD128_r6(HS_ChannelisationCode_LCR p_FirstChannelisationCode,
                                                          HS_ChannelisationCode_LCR p_SecondChannelisationCode,
                                                          HS_ChannelisationCode_LCR p_HS_SICH_ChannelisationCode) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
