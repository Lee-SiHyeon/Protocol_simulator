module EPS_NAS_LoopBack_Templates {

  import from Common4G5G_LoopBack all;
  import from CommonDefs all;
  import from EPS_NAS_MsgContainers all;

  const UE_TestLoopMode_Type tsc_UE_TestLoopMode_TypeF   := '05'O;              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC_IRAT, POS) @sic R5s160711 BASELINE MOVING 2016 sic@ */

  const UE_TestLoopMode_Type tsc_UE_TestLoopMode_TypeG   := '06'O;              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC_IRAT, POS) */

  const UE_TestLoopMode_Type tsc_UE_TestLoopMode_TypeH   := '07'O;      // @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC_IRAT, POS)

  template (value) NAS_DL_Message_Type  cs_ACTIVATE_TEST_MODE (UE_TestLoopMode_Type p_UE_TestLoopMode) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC_IRAT, POS) */
    aCTIVATE_TEST_MODE:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Activate_TestMode,                    /*    M V 1      */
      ueTestLoopMode           := p_UE_TestLoopMode                                 /*    M V 1      */
    }
  };

  template (present) NAS_UL_Message_Type  cr_ACTIVATE_TEST_MODE_COMPLETE :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC_IRAT, POS) */
    aCTIVATE_TEST_MODE_COMPLETE:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Activate_TestModeCmpl                 /*    M V 1      */
    }
  };

}
