  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_1_7_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9  p_EUTRA_DL_CarrierFreq, //@sic R5-171996 sic@
