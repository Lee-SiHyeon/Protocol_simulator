module ECall_NR5GC_IMS {

  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_eCall_Functions all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.5.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_5_5_NR5GC_IMS2()runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;
    
    // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_ECall_CallSetup_A_23(MANUAL, A_2_1_A6);   //@sic R5-237453 R5s230679 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));  //@sic R5s230679 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    //@siclog "Step 5" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrlUE); // @sic R5-250313 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));  //@sic R5s230679 sic@
  }

}
