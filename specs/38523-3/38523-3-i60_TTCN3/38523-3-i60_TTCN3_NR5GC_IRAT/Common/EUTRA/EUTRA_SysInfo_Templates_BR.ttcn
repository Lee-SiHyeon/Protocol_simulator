    //@sic R5s170802: added p_StartSymbolBR_r13 sic@
    hyperSFN_r13 := omit,
    eDRX_Allowed_r13 := omit,  //eDRX condition handled inside TC
    cellSelectionInfoCE_r13 := cs_CellSelectionInfoCE_Def,
    bandwidthReducedAccessRelatedInfo_r13 := {
