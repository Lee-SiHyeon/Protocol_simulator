module RRC_Measurement_CA_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA38_SecurityFunctions all;
  import from EUTRA_CellInfo all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NR_CoordMsg all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.3.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_3_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / SCell change / Intra-NR measurement event A6 / SRB3 / EN-DC / Intra-band Contiguous CA
    f_TC_8_2_4_3_1_Common_ENDC_EUTRA()
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.3.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_3_1_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / SCell change / Intra-NR measurement event A6 / SRB3 / EN-DC / Intra-band non-Contiguous CA
    f_TC_8_2_4_3_1_Common_ENDC_EUTRA()
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.3.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_3_1_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / SCell change / Intra-NR measurement event A6 / SRB3 / EN-DC / Inter-band CA
    f_TC_8_2_4_3_1_Common_ENDC_EUTRA()
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.3.1.Common.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_3_1_Common_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //NR CA / SCell change / Intra-NR measurement event A6 / SRB3 / EN-DC / Intra-band Contiguous CA
    f_EUTRA38_Init_CA(EN_DC, c1); //@sic R5s210758 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell1, -79);
     
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    
    f_EUTRA_SetCellPowerList({cs_CellPower(eutra_Cell1, -79)});   //@sic R5s201309 sic@
    f_AdjustCellPowerForTestingFR2(eutra_Cell1);  //@sic R5s201309 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_4_3_1_x_TestBody();
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);    //@sic R5s201309 sic@
    f_EUTRA_TestBody_Set(false);
    
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  } // End of f_TC_8_2_4_3_1_1__ENDC_EUTRA()

  /*
   * @desc      test body of TC_8_2_4_3_1_x
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_4_3_1_x_TestBody() runs on EUTRA_5GS_PTC
  {
   
     var template (omit) octetstring v_NR_SCGConfig := omit;
     var template (omit) octetstring v_NR_RBConfig := omit;    // @sic R5s210453, R5-213480 sic@
     var EUTRA38_SecurityParamsExtd_Type v_Security_Params;
      
     //Send a trigger to NR to change the power
     f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
      
     //@siclog "Steps 1-2" siclog@
     //SS transmits an RRCConnectionReconfiguration message containing RRCReconfiguration message to configure SCell (NR Cell 3) and SRB3
     //The UE transmits an RRCConnectionReconfigurationComplete message containing RRCReconfigurationComplete message
     
     v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
     v_NR_RBConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "RB");  //@sic R5s210453, R5-213480, R5s210846 sic@
     
     f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig,
                                           v_NR_RBConfig,  //@sic R5s210453, R5-213480 sic@
                                           -, omit); //@sic R5s210160, R5-210399 sic@
     v_Security_Params := f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(NR);
     f_EUTRA38_Security_Set(v_Security_Params);
     // f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2"); @sic R5s201309 sic@

    //@siclog "Steps 3-4" siclog@
    //SS transmits an RRCConnectionReconfiguration message containing RRCReconfiguration message including measConfig to setup intra NR measurement and reporting for event A6
    //The UE transmits an RRCConnectionReconfigurationComplete message containing RRCReconfigurationComplete message.
    f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, Meas_SCGOnly);    //@sic R5s201515 sic@
    

    //@siclog "Step 6" siclog@
    //Step 6 and subsequent steps are running on NR side
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower")); //@sic R5s201309 sic@
    
  }//End of fl_TC_8_2_4_3_1_x_TestBody()

}
