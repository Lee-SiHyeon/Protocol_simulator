module NAS_Attach_EOnly_IMS {

  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Registration all;

  /*
   * @desc      test body of TC_9_2_1_1_28_and_9_2_1_1_28a
   * @param     p_Is_TC_9_2_1_1_28  (default value: true)
   * @status    APPROVED (LTE)
   */
  function fl_TC_9_2_1_1_28_and_9_2_1_1_28a_Body(boolean p_Is_TC_9_2_1_1_28 := true) runs on IMS_PTC
  {
    // Preamble   @sic R5s131000 change 1 sic@
    f_IMS_PTC_Init(PDN_1, -, IMS_Security);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);     // send trigger to EUTRA PTC to indicate start of IMS registration
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);     // send trigger to EUTRA PTC to indicate end of IMS registration
    
    f_IMS_IpcanReleaseWithOptionalDeregistration();    // @sic R5s140346  wait for the UE getting deregistered and switched off sic@
    f_IMS_PTC_Init(PDN_1, -, IMS_Security);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);     // @sic R5s131000 MCC160 implementation: send trigger to EUTRA PTC to indicate that IMS PTC is reset again sic@
    
    f_IMS_TestBody_Set(true);
    if (p_Is_TC_9_2_1_1_28)  {
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);     // send trigger to EUTRA PTC to indicate start of IMS registration
    }
    // Registration: 34.229-1 Annex C.2
    f_IMS_Registration();
    
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step C.2");
    
    // Inform EUTRA: IMS Registration done
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_TestBody_Set(false);
    f_IMS_IpcanReleaseWithOptionalDeregistration();    // @sic R5s140346  wait for the UE getting deregistered and switched off sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);     // @sic R5s140346 inform EUTRA sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.2.1.1.28
   * @status    APPROVED (LTE)
   */
  function f_TC_9_2_1_1_28_IMS1() runs on IMS_PTC
  {
     fl_TC_9_2_1_1_28_and_9_2_1_1_28a_Body (); // @sic R5-163059 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.2.1.1.28a
   * @status    APPROVED (LTE)
   */
  function f_TC_9_2_1_1_28a_IMS1() runs on IMS_PTC
  {
     fl_TC_9_2_1_1_28_and_9_2_1_1_28a_Body (false);
  }

}
