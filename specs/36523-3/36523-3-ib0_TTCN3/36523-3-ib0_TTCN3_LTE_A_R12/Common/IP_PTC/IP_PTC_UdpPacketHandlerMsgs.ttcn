module IP_PTC_UdpPacketHandlerMsgs {

  import from CommonDefs all;
  import from IP_ASP_TypeDefs all;

  type record UdpPacketHandler_Start_Type {     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type LocalSocket,
    IP_DrbInfo_Type DrbInfo
  };

  type record UdpPacketHandler_Data_Type {      /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type LocalSocket,
    IP_Socket_Type RemoteSocket,
    octetstring    Datagram
  };

  type record UdpPacketHandler_Stop_Type {      /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type LocalSocket
  };

  type union IP_PTC_UdpPacketHandler_Request_Type {     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    UdpPacketHandler_Start_Type Start,
    UdpPacketHandler_Data_Type  Send,
    UdpPacketHandler_Stop_Type  Stop
  };

  type record UdpPacketHandler_StartResponse_Type {    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_Socket_Type LocalSocket
  };

  type union IP_PTC_UdpPacketHandler_RespOrInd_Type {    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    UdpPacketHandler_StartResponse_Type Start,
    UdpPacketHandler_Data_Type Data
  };

  template (present) IP_PTC_UdpPacketHandler_Request_Type cr_IP_PTC_UdpPacketHandler_Start := { Start := ? };      /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_PTC_UdpPacketHandler_Request_Type cr_IP_PTC_UdpPacketHandler_DataRequest := { Send := ? }; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_PTC_UdpPacketHandler_Request_Type cr_IP_PTC_UdpPacketHandler_Stop := { Stop := ? };        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_PTC_UdpPacketHandler_RespOrInd_Type cs_IP_PTC_UdpPacketHandler_StartResponse(template (value) IP_Socket_Type p_LocalSocket) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Start := {
      LocalSocket := p_LocalSocket
    }
  };

  template (value) IP_PTC_UdpPacketHandler_RespOrInd_Type cs_IP_PTC_UdpPacketHandler_DataIndication(template (value) IP_Socket_Type p_LocalSocket,
                                                                                                    template (value) IP_Socket_Type p_RemoteSocket,
                                                                                                    template (value) octetstring p_Datagram) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Data := {
      LocalSocket := p_LocalSocket,
      RemoteSocket := p_RemoteSocket,
      Datagram := p_Datagram
    }
  };

  type port IP_UDP_HANDLER_PORT message
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    in  IP_PTC_UdpPacketHandler_Request_Type;
    out IP_PTC_UdpPacketHandler_RespOrInd_Type;
  };

}
