  /*
   * @desc      set info retrieved from IPCAN
   * @param     p_IpcanInfo
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_SetIpcanInfo(IPCAN_INFO_Type p_IpcanInfo) runs on IMS_PTC
  { /* @sic R5s120907 R5s130133 additional changes sic@ */
    if (ispresent(p_IpcanInfo.AuthResLength)) { vc_IMS_Global.Security.XRESLength := p_IpcanInfo.AuthResLength; }    /* @sic R5w160208 - FBBA: ispresent sic@ */
    if (ispresent(p_IpcanInfo.UE_Release))    { vc_IMS_Global.ImsInfo.UE_Release := p_IpcanInfo.UE_Release; }        /* @sic R5s130739 MCC160 implementation sic@ @sic R5w160208 - FBBA: ispresent sic@ */
    if (ispresent(p_IpcanInfo.RanType))       { vc_IMS_Global.ImsInfo.RanType := p_IpcanInfo.RanType; }              /* @sic R5w160208 - FBBA: ispresent sic@ */

    vc_IMS_Global.ImsInfo.NetworkSupportsVoiceOverIMS := p_IpcanInfo.NetworkSupportsVoiceOverIMS;                    /* @sic R5-177127 sic@ */
  }

  /*
   * @desc      get RAN type
   * @return    template (omit) IPCAN_RAN_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
