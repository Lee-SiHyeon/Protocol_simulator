  template (value) OtherConfig_v1610.releasePreferenceConfig_r16 cs_ReleasePreferenceConfig_r16_Setup(template (value) ReleasePreferenceConfig_r16.releasePreferenceProhibitTimer_r16 p_ReleasePreferenceProhibitTimer_r16,
                                                                                                      template (omit) ReleasePreferenceConfig_r16.connectedReporting p_ConnectedReporting := omit) :=
  { /* @status    APPROVED (NR5GC) */
