module EUTRA_UE_Location {

  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EPS_NAS_TypeDefs all;
  import from EUTRA_CellInfo all;
  import from EUTRA_Component all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_Paging all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;
  import from NAS_CommonTemplates all;
  import from Parameters all;
  import from TestcaseProperties all;
  import from UpperTesterFunctions all;

  template (value) NAS_DL_Message_Type  cs_Update_UE_LocationInformation_EUTRA(EllipsoidPointWithAltitude_Type p_EllipsoidPointWithAltitude,
                                                                               HorizontalVelocity_Type p_HorizontalVelocity,
                                                                               Gnss_TOD_msec_Type p_Gnss_TOD_msec) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11) */
    uPDATE_UE_LOCATION_INFORMATION := cs_Update_UE_Location_Information(p_EllipsoidPointWithAltitude, p_HorizontalVelocity, p_Gnss_TOD_msec) //@sic R5-213421 sic@
  };

  /*
   * @desc      Function to send LOCATION INFORMATION to UE using the Update_UE_LocationInformation message defined in 36.509
   *            To be used when UE is either in CONNECTED state or in IDLE state
   * @param     p_CellId
   * @param     p_State
   * @param     p_EllipsoidPointWithAltitude (default value: px_EllipsoidPointWithAltitude)
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11)
   */
  function f_EUTRA_SendUE_LocationInformation(EUTRA_CellId_Type p_CellId,
                                              EUTRA_RRC_STATE_Type  p_State,
                                              O8_Type p_EllipsoidPointWithAltitude := px_EllipsoidPointWithAltitude
                                              )
    runs on EUTRA_PTC
  { //@sic R5-165464: D2D added p_EllipsoidPointWithAltitude, v_HorizontalVelocity, v_CurrentTime sic@
    var Gnss_TOD_msec_Type v_Gnss_TOD_msec;
    var NAS_MSG_Indication_Type v_NasInd;
    var O3_Type v_HorizontalVelocity := px_HorizontalVelocity;
    var H12_Type v_CurrentTime;
    
    if (p_State == RRC_IDLE) {
      //SS sends a Paging message to the UE on the appropriate paging block, and including the UE identity in one entry of the IE pagingRecordLists
      f_EUTRA_UE_Page_Def(p_CellId);
      v_NasInd := f_EUTRA_RRC_ConnEst_DefWithNas(p_CellId,
                                                 tsc_RRC_TI_Def,
                                                 cr_EstablishmentCause_mt_Access,
                                                 cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                                   cr_508_SERVICE_REQUEST(f_EUTRA_SecurityKSIasme_Get())));
      f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(p_CellId, tsc_RRC_TI_Def, v_NasInd.SecurityProtection.NasCount); //@sic R5s160007 sic@
      SRB.receive (car_SRB1_RrcPdu_IND(p_CellId, cr_508_RRCConnectionReconfigurationComplete(tsc_RRC_TI_Def))); //@sic R5s160007 sic@
    }

    // Acc. to 36.355 cl 6.5.2.6:
    // This field specifies the GNSS TOD for which the measurements and/or location estimate are valid.
    // Scale factor 1 millisecond.
    v_Gnss_TOD_msec := bit2oct(int2bit(tsc_Gnss_TOD_msec, 22)); // set to the  value: 0h30min00s000ms

    if (f_GetTestcaseAttrib_D2D_Communication(testcasename())) { //Specific to D2D test cases
        v_HorizontalVelocity := '000000'O; //horizontalVelocity: 0 m/s
        v_CurrentTime := f_BCD_TimestampWithoutTimezone();
        v_Gnss_TOD_msec := bit2oct(int2bit( hex2int(v_CurrentTime),22));  //Equal to system time
    }
    
    //@sic R5s160289 sic@
    SRB.send (cas_SRB2_NasPdu_REQ(p_CellId,
                                  cs_TimingInfo_Now,
                                  cs_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                 cs_Update_UE_LocationInformation_EUTRA(p_EllipsoidPointWithAltitude,
                                                                                        v_HorizontalVelocity,
                                                                                        v_Gnss_TOD_msec))));
    
    if (p_State == RRC_IDLE) {
      // The SS releases the RRC connection.
      f_EUTRA_RRC_ConnectionRelease(p_CellId);
    }
  }

  /*
   * @desc      Function to provide LOCATION INFRMATION to UE
   *            To be used when UE is either in CONNECTED state or in IDLE state
   * @param     p_CellId
   * @param     p_State
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_A_R10_R11)
   */
  function f_EUTRA_ProvideUE_LocationInformation(EUTRA_CellId_Type p_CellId,
                                                 EUTRA_RRC_STATE_Type p_State) runs on EUTRA_PTC
  {
    if (pc_UpdateUE_LocationInformation) {
      f_EUTRA_SendUE_LocationInformation(p_CellId, p_State);
    } else {
      f_UT_MMI_ProvideLocationInfoToUE(UT);
    }
  }

}
