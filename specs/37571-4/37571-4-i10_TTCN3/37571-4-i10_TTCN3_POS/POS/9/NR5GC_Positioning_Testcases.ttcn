module NR5GC_Positioning_Testcases {

  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from OMA_LPPE language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonPOS_Functions all;
  import from CommonPOS_Templates all;
  import from EUTRA_OTDOA_NR_CoordMsg all;
  import from LPP_Templates all;
  import from NAS_CommonTemplates all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_POS_Component all;
  import from NR5GC_Positioning_Functions all;
  import from NR5GC_Positioning_Templates all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from OMA_LPPe_Templates all;
  import from POS_Parameters all;
  import from PosSystem_ASP_TypeDefs all;
  import from PosSystem_Control all;

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.1
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_1_NR5GC() runs on NR5GC_PTC
  {//Position Capability Transfer

    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_1_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_1_1_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.1
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_1_NR5GC_TestBody() runs on NR_BASE_PTC
  {
    var octetstring v_EncodedLppMessage;
    var octetstring v_Octetstring;
    var LPP_Message v_LppMessage;

    //@siclog "Step 1" siclog@
    //SS sends LPP REQUEST CAPABILITIES
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestCapabilities_ePDU(tsc_POS_TransactionNumber,
                                                                                 f_POS_EncodeOmaLppeMessage(cs_OmaLppe_RequestCapabilities)));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 2" siclog@
    //Receive LPP PROVIDE CAPABILITIES
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideCapabilities(tsc_POS_TransactionNumber));

    // Further matching is required according to PICS values:
    f_POS_NR_CheckCapabilities (v_LppMessage, true);

    //@siclog "Step 2a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 2
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.5s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_5s_NR5GC() runs on NR5GC_POS_PTC
  {//LPP Abort - OTDOA (LTE)
    var E_OTDOA_NR_CoOrd_OtdoaInfo_Type v_OtdoaInfo;

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    // Table 9.3.1.2.3.1-1: Configuration of measurement gaps for OTDOA
    //@sic R5-204489 sic@
    f_NR_ConfigMeasGap_OTDOA();
    f_E_OTDOA_NR_SendCoOrd(OTDOA, cms_E_OTDOA_NR_Trigger); //@sic R5s210651 sic@

    //Wait for co-ordination message from EUTRA_OTDOA component
    v_OtdoaInfo := f_E_OTDOA_NR_WaitForCoOrd_OtdoaInfo(OTDOA);

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_2_5s_NR5GC_TestBody(v_OtdoaInfo);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    //Send co-ordination message to EUTRA_OTDOA component to finish the test case
    f_E_OTDOA_NR_SendCoOrd(OTDOA, cms_E_OTDOA_NR_Trigger);
  } //end of f_TC_9_3_1_2_15s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.5s
   * @param     p_OtdoaInfo
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_5s_NR5GC_TestBody (E_OTDOA_NR_CoOrd_OtdoaInfo_Type p_OtdoaInfo) runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;
    timer t_Wait;

    //@siclog "Step 00" siclog@
    //Clear stored OTDOA assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_OtdoaUEPosTech);

    //@siclog "Steps 0, 0a, 0b" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 0c" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                          locationServer,
                                                                          omit,
                                                                          cs_OtdoaProvideAssistanceData_7_3_5_1(p_OtdoaInfo.Ecgi_RefCell,
                                                                                                                p_OtdoaInfo.PrsInfo,
                                                                                                                p_OtdoaInfo.Ecgi_Cell2,
                                                                                                                p_OtdoaInfo.Ecgi_Cell4)));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 1" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                            locationMeasurementsRequired, // OTDOA is only UE-Assisted (36.355, 6.5.1.7)
                                                                            10,
                                                                            omit,
                                                                            cs_OtdoaRequestLocationInfo (false),
                                                                            omit));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 2" siclog@
    //SS sends LPP ABORT
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                         *, *, *, *, *,
                                         cr_RoutingInfoNR(tsc_POS_RoutingId), //@sic R5s201393 sic@
                                         *, *, *, *, *); //@sic R5s201387, R5s240531 Baseline Moving sic@
    t_Wait.start(10.0);
    alt {
    [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                         tsc_NR_RbId_SRB2,
                                         cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                       v_GMMMsg))) -> value v_ReceivedAsp
      {
        v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
        f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_UEA(0));
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
        t_Wait.stop;
      }

    [] t_Wait.timeout
       {
         f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
       }
    }
  } // end of function f_TC_9_3_1_2_5s_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.15s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_15s_NR5GC() runs on NR5GC_POS_PTC
  {//LPP Abort - GNSS
    var PositioningSystemList_Type v_GNSSList := f_POS_GetListOfSupportedGNSS();

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_POS_StartPositioningSimulatorNR (v_GNSSList, 15); // Scenario for Subtest 15 according to 37.571-5, 6.1.2

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_2_GNSS_NR5GC_TestBody(v_GNSSList);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    f_POS_StopPositioningSimulatorNR (v_GNSSList);
  } //end of f_TC_9_3_1_2_15s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.GNSS
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_GNSS_NR5GC_TestBody (PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;
    timer t_Wait;

    //@siclog "Step 00" siclog@
    //Clear stored GNSS assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_AgnssUEPosTech);

    //@siclog "Steps 0, 0a, 0b" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    if (not pc_UEB_AGNSS and not pc_UEA_AGNSS) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in Location Method PICS");
    }

    v_ProvideAssistData := f_POS_RetrieveNR_DataGNSS(p_PosSystemListId); //Retrieved data is valid for both UEA and UEB

    //The procedure is executed for each method (UEB and/or UEA) supported)
    if (pc_UEB_AGNSS) {
      //SS sends LPP PROVIDE ASSISTANCE DATA
      f_POS_NR_SendLppProvideAssistanceData_GNSS (true, // UE-Based case
                                                  tsc_POS_TransactionNumber,
                                                  tsc_POS_RoutingId,
                                                  v_ProvideAssistData,
                                                  omit);

      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationEstimateRequired,//UEB
                                                                              10,
                                                                              cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId), //@sic R5-172963 sic@
                                                                                                          false),
                                                                              omit,
                                                                              omit));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
      //SS sends LPP ABORT
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                         *, *, *, *, *,
                                         cr_RoutingInfoNR(tsc_POS_RoutingId), //@sic R5s201393 sic@
                                         *, *, *, *, *); //@sic R5s201387, R5s240531 Baseline Moving sic@
      t_Wait.start(10.0);
      alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                           tsc_NR_RbId_SRB2,
                                           cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                         v_GMMMsg))) -> value v_ReceivedAsp
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_Agnss_UEB(0));
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
          t_Wait.stop;
        }

      [] t_Wait.timeout
         {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
         }
      }
    }
    if (pc_UEA_AGNSS) {
      //@siclog "Step 0c" siclog@
      //SS sends LPP PROVIDE ASSISTANCE DATA
      f_POS_NR_SendLppProvideAssistanceData_GNSS (false, // UE-Assisted case
                                                  tsc_POS_TransactionNumber,
                                                  tsc_POS_RoutingId,
                                                  v_ProvideAssistData,
                                                  omit);
      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationMeasurementsRequired,//UEA
                                                                              10,
                                                                              cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId), //@sic R5-172963 sic@
                                                                                                          false),
                                                                              omit,
                                                                              omit));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      t_Wait.start(10.0);
      alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                           tsc_NR_RbId_SRB2,
                                           cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                         v_GMMMsg))) -> value v_ReceivedAsp
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_UEA (0));
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
          t_Wait.stop;
        }

      [] t_Wait.timeout
         {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
         }
      }
    }
  } // end of function f_TC_9_3_1_2_GNSS_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.19s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_19s_NR5GC() runs on NR5GC_POS_PTC
  {//LPP Abort - Multi-RTT, Rel-16 onwards

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_POS_NR_CellConfig_DlPrs(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A);

    // Table 9.3.1.2.3.1-1: Configuration of measurement gaps for Multi-RTT
    f_NR_ConfigMeasGap_OTDOA();

    // Table 9.3.1.2.3.1-2: Configuration of UL-SRS for Multi-RTT
    f_NR_ConfigUlSrsMultiRTT(nr_Cell1);

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_2_MultiRTT_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_1_2_19s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.MultiRTT
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_MultiRTT_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;
    var template (value) NR_Multi_RTT_ProvideAssistanceData_r16  v_MultiRTTProvideAssistanceData;

    timer t_Wait;

    //@siclog "Step 00" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(19));

    //@siclog "Steps 0, 0a, 0b" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //Multi-RTT is only applicable to UEA case

      //@siclog "Step 0c" siclog@
      //SS sends LPP PROVIDE ASSISTANCE DATA
      v_MultiRTTProvideAssistanceData := cs_MultiRTTProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(1),
                                                                          {cs_NrSelectedDlPrsPerFreq(0)});
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                            locationServer,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,
                                                                            v_MultiRTTProvideAssistanceData));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationMeasurementsRequired, // UEA
                                                                              10,
                                                                              omit,
                                                                              omit,
                                                                              -,-,-,-,-,-,-,
                                                                              cs_MultiRTTRequestLocationInfoDef));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
      //SS sends LPP ABORT
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAbort_NetworkAbort(0));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 3" siclog@
      //The SS waits for 10 seconds to ensure the UE does not send a LPP message of type Provide Location Information
      //with the same transaction ID as in step 1.
      v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                         *, *, *, *, *,
                                         cr_RoutingInfoNR(tsc_POS_RoutingId),
                                         *, *, *, *, *); //@sic R5s240531 Baseline Moving sic@
      t_Wait.start(10.0);
      alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                         tsc_NR_RbId_SRB2,
                                         cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                       v_GMMMsg))) -> value v_ReceivedAsp
        {
          v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;
          f_POS_NR_LppMessage_DecodeAndMatch (v_Octetstring, cr_LppProvideLocationInformation_UEA(0));
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
          t_Wait.stop;
        }

      [] t_Wait.timeout
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.1.2 Step 3");
        }
      }

  } // end of function f_TC_9_3_1_2_MultiRTT_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.20s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_20s_NR5GC() runs on NR5GC_POS_PTC
  {//LPP Abort - DL-AoD, Rel-16 onwards

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_POS_NR_CellConfig_DlPrs(nr_Cell1);
    f_POS_NR_CellConfig_DlPrs(nr_Cell2); // This cell is only used in the UEB case (if supported by the UE)

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower(nr_Cell2, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);

    // Table 9.3.1.2.3.1-1: Configuration of measurement gaps for DL-AoD
    f_NR_ConfigMeasGap_OTDOA();

    f_NR_TestBody_Set(true);
    f_TC_9_3_1_2_DlAoD_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_1_2_20s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.DlAoD
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_DlAoD_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;
    var template (value) NR_DL_AoD_ProvideAssistanceData_r16  v_DlAoDProvideAssistanceData;
    var ReferencePoint_r16 v_RefPoint := valueof(cs_RefPoint); // 37.571-2, Table 8.4.1.7-1
    var RelativeLocation_r16 v_TrpLocation_Cell2 := valueof(cs_RelativeLocation); // 37.571-2, Table 8.4.1.7-1

    timer t_Wait;

    //@siclog "Step 00" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(20));

    //@siclog "Steps 0, 0a, 0b" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    if (not pc_UEB_DL_AoD and not pc_UEA_DL_AoD) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in Location Method PICS");
    }

    //The procedure is executed for each method (UEB and/or UEA) supported
    if (pc_UEB_DL_AoD) {
      //@siclog "Step 0c" siclog@
      //SS sends LPP PROVIDE ASSISTANCE DATA
      v_DlAoDProvideAssistanceData := cs_DlAoDProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(2),
                                                                    {cs_NrSelectedDlPrsPerFreq(0)},
                                                                    cs_NrPositionCalculationAssist({cs_NrTrpLocationInfoPerFreqLayer(v_RefPoint,
                                                                                                                                     {cs_TrpLocInfoElement(0),
                                                                                                                                      cs_TrpLocInfoElement(1, v_TrpLocation_Cell2)})}));
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                            locationServer,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,
                                                                            v_DlAoDProvideAssistanceData));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 1" siclog@
      //SS sends LPP REQUEST LOCATION INFORMATION
      v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(0,
                                                                              locationEstimateRequired, // UEB
                                                                              10,
                                                                              omit,
                                                                              omit,
                                                                              -,-,-,-,-,-,-,-,
                                                                              cs_DlAoDRequestLocationInfoDef));
      f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

      //@siclog "Step 2" siclog@
