  template (present) SDP_attribute cr_SDP_Attribute_maxptime(template (present) charstring p_Value := "240") :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5w140113, R5w140009 sic@ */
    maxptime := {
