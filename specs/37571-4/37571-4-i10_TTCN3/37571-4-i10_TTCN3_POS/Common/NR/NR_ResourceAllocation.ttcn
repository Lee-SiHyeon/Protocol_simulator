                                               NR_UplinkBWP_Type p_UplinkBWP,
                                               integer p_TimeResourceAllocationIndex := 0,
                                               NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats p_DciFormats := formats0_1_And_1_1
                                               ) return NR_ResourceAllocation_Type
  { /* @sic R5-196751: formats0_1_And_1_1 per default sic@ */
    var BWP_UplinkCommon v_BWP_UplinkCommon := p_UplinkBWP.Common.R15;
    var BWP_UplinkDedicated v_BWP_UplinkDedicated := p_UplinkBWP.Dedicated.R15;
    var NR_TimeResourceAllocation_Type v_TimeResourceAllocation;
    var NR_ResourceAllocation_Type v_ResourceAllocation;
    var PUSCH_TimeDomainResourceAllocation v_TimeDomainResourceAllocation;
    var PUSCH_TimeDomainResourceAllocation.mappingType v_MappingType;
    var DMRS_UplinkConfig v_DMRS_UplinkConfig;
    var integer v_Duration;
    var NR_AnnexB2_Table_Type v_NR_AnnexB2_Table;

    if (ispresent(v_BWP_UplinkCommon.pusch_ConfigCommon.setup.pusch_TimeDomainAllocationList[p_TimeResourceAllocationIndex].startSymbolAndLength)) {
      v_TimeDomainResourceAllocation := v_BWP_UplinkCommon.pusch_ConfigCommon.setup.pusch_TimeDomainAllocationList[p_TimeResourceAllocationIndex];
      v_TimeResourceAllocation := fl_NR_SLIV_GetStartAndLength(v_TimeDomainResourceAllocation.startSymbolAndLength);
      v_Duration := v_TimeResourceAllocation.Length;
      v_MappingType := v_TimeDomainResourceAllocation.mappingType;
    } else {
      FatalError(__FILE__, __LINE__, "no TimeDomainResourceAllocation found");
    }
    
    select (v_Duration) {
      /* @sic R5-190723: no v_Duration==2 anymore sic@ */
      case (14) {
        select (p_DciFormats) {
          case (formats0_0_And_1_0) {
            v_NR_AnnexB2_Table := table_B_2_1_5__1;
          }
          case (formats0_1_And_1_1) {
            select (v_MappingType) {
              case (typeA) { v_DMRS_UplinkConfig := v_BWP_UplinkDedicated.pusch_Config.setup.dmrs_UplinkForPUSCH_MappingTypeA.setup; }
              case (typeB) { v_DMRS_UplinkConfig := v_BWP_UplinkDedicated.pusch_Config.setup.dmrs_UplinkForPUSCH_MappingTypeB.setup; }
            }
            if (ispresent(v_DMRS_UplinkConfig.dmrs_AdditionalPosition)) {
              select (v_DMRS_UplinkConfig.dmrs_AdditionalPosition) {
                case (pos0) { v_NR_AnnexB2_Table := table_B_2_1_1__1; }
                case (pos1) { v_NR_AnnexB2_Table := table_B_2_1_2__1; }
              }
            }
          }
        }
      }
    }
