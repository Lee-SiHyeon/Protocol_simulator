module IMS_Component {

  import from Base64Encoding all;
  import from CommonDefs all;
  import from CommonIP all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_Common all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from NAS_AuthenticationCommon all;
  import from Parameters all;
  import from UpperTesterPtcToMtcDefs all;

  type enumerated IMS_PTC_Handling_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    testcaseSpecificHandling,
    defaultHandling
  };

  type record IMS_PTC_Ctrl_Type {               /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    default             Default,                /* default behaviour being activated on IMS PTC */
    boolean             TestBody,               /* true:  => fail may be assigend
                                                 * false: => inconc is assigned instead of fail */
    boolean             BlockUlDataInDefault,   /* @sic R5s140780 - MCC160 Implementation sic@
                                                 * true:  => ports IMS_Server and IMS_Client are not handle by default handler
                                                 *           i.e. any messages coming up at these ports are stored until there are explicit receive statements in the test case
                                                 * false: => UL data may cause test case fail/inconc */
    boolean             IgnoreReset,            /* @sic R5s150031: to deal with "Reset" sent from IPCAN to reset IMS in case of the UE being switched on after a switch-off during the test case sic@ */
    boolean             WaitForPublish          /* @sic R5-155916: PUBLISH during initial registration sic@ */
  };

  type record IMS_PTC_SecurityInfo_Type {                       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    IPsec_IntegrityAlgorithm_Type       IntegrityAlgorithm,
    IPsec_CipheringAlgorithm_Type       CipheringAlgorithm,
    IMS_ProtectedPorts_Type             ProtectedPorts       optional,
    IMS_SPIs_Type                       SPIs                 optional,
    charstring                          Nonce                optional,
    B32_128_Type                        XRES                 optional,
    integer                             XRESLength           optional  // @sic R5s120907 sic@
  };

  type enumerated IMS_UriInfo_UriType_Type { firstId, secondId, thirdId, defaultId, registrationId, emergencyId, dialogLocalId, dialogRemoteId, temporaryId, gruu };   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
                                                                                                                                                                          @sic R5-153760: gruu sic@ */

  type enumerated IMS_ContactUriType_Type {     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    registration,        /* contact URI as provided by the UE during registration */
    dialog               /* contact URI as provided by the UE for a dialog; different to the contact URI of the registration e.g. in case of GRUU */
  };

  type enumerated IMS_PTC_CseqType_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    register,           /* CSeq used by the UE in any REGISTER message (registration, re-registration and de-registration */
    dialogRemote,       /* CSeq to be used in requests which are sent MO requests */
    dialogLocal         /* CSeq to be used in requests which are sent MT requests */
  };

  type record IMS_PTC_RegistrationInfo_Type {   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    charstring          Uri optional,           /* SIP URI used for registration (To header of the REGISTER message; can be temporary SIP URI when the UE does not have an ISIM) */
    charstring          CallId  optional,       /* CallId used for registration (needed to check against CallId of INVITE) */
    integer             Cseq,
    SipUrl              ContactUrl optional
  };

  type record IMS_DialogInfo_Type {                     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
                                                           @sic R5s140092 change 1.5: RemoteURI, RemoteCseq, LocalURI, LocalCseq stored in this structure sic@
                                                           @sic R5-174544: SessionId removed sic@ */
    boolean             MobileOriginated  optional,     /* needed e.g. to get the right route-set for re-INVITE */
    charstring          RemoteTag         optional,     /* acc. to RFC 3261 when creating a dialog in first request there is a From tag but no To tag;
                                                           the To tag is chosen by the other end and sent in a response; in all further messages within the dialog the same From and To tags shall be used
                                                           (=> especially in request messages (e.g. BYE) it may be necessary to use this stored value whereas in responses the values can be used as sent in the request);
                                                           NOTE: in general outside a dialog (e.g. registration) requests get a new From tag and the corresponding reponses contain a new To tag */
    SipUrl              RemoteURI         optional,     /* URI of the remote side in a dialog created by INVITE @sic R5s160451: SipUrl instead of charstring sic@ */
    integer             RemoteCseq        optional,     /* @sic R5s140235: changed to optional sic@ */
    charstring          LocalTag          optional,
    SipUrl              LocalURI          optional,     /* URI of the UE in a dialog created by INVITE @sic R5s160451: SipUrl instead of charstring sic@ */
    integer             LocalCseq,
    charstring          CallId            optional,
    SipUrl              ContactUrlUE      optional,     /* Contact Url provided by the UE for this dialog (especially in case GRUU this is different to the (non-GRUU) URI used for registration); @sic R5s150908 sic@ */
    SipUrl              ContactUrlSS      optional,     /* @sic R5w220111: Session-id for MCX sic@ */
    charstring          SdpSessionIdTX,                 /* @sic R5-150707 sic@ */
    integer             SdpSessionVersionTX,            /* current SDP session version for the DL   @sic R5-150707 sic@ */
    SDP_Message         SdpMessagePrevTX  optional,     /* previous SDP message sent to the UE      @sic R5-225427, R5-225258 sic@ */
    SDP_Message         SdpMessagePrevRX  optional,     /* previous SDP message sent by the UE      @sic R5-150702 sic@ */
    integer             RemoteRSeq        optional      /* RemoteRSeq for ongoing transaction initiated by MT INVITE; shall be incremented for every reliable 1XX response (RFC 3262)   @sic R5-181190 sic@ */
  };

  const integer tsc_IMS_NoOfDialogs := 14;              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type record length(tsc_IMS_NoOfDialogs) of IMS_DialogInfo_Type IMS_PTC_DialogInfoList_Type;   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  type record IMS_PTC_DialogList_Type {                 /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    integer                     CurrentIndex,
    IMS_PTC_DialogInfoList_Type Info
  };

  type record IMS_PTC_ImsInfo_Type {                    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    CharStringList_Type         IMPUList,                       /* list of all Public User Ids acc. to ISIM setting (31.121) or as stored in the HSS */
    IP_AddrInfo_Type            UE_Address      optional,
    IP_AddrInfo_Type            NW_Address      optional,
    charstring                  P_CSCF_Address  optional,       /* @sic R5s140934 sic@ */
    InternetProtocol_Type       TransportProtocol,              /* transport protocol to be used for requests sent in DL
                                                                 * @sic R5s120530 change 1.7 sic@
                                                                 * NOTE: in contrast to @sic R5s120530 sic@ and acc. to rejection of @sic R5-130765 sic@ at RAN WG5 Meeting #58 in Malta UDP is used for all requests in DL;
                                                                 *       nevertheless "TransportProtocol" is kept in case there are other decisions in the future */
    IPCAN_RAN_Type              RanType         optional,
    integer                     UE_Release      optional,       /* @sic R5s130739 MCC160 implementation: new field to store the UE's release sic@ */
    boolean                     SigCompStarted,
    charstring                  HomeDomainName,
    charstring                  PrivateUserId,
    SipUrl                      ContactUrl      optional,       /* contact address as provided in contact header of the REGISTER message;
                                                                   to be used e.g. for Request-URI of INVITE for MT call */
    integer                     BranchIndex,                    /* internal index used to generate unique branches */
    integer                     CallIdCnt,                      /* counter to achieve unique callids e.g. for SMS MESSAGE sent to the UE @sic R5-133705 sic@ */
    IMS_PTC_RegistrationInfo_Type       Registration,
    IMS_PTC_DialogList_Type             Dialog,                 /* @sic R5s140092 change 1.5: two sets of dialogs sic@ */
    IMS_SecurityScheme_Type     SecurityScheme,                 /* IMS security or GIBA acc. to 34.229-2 Table A.6a; depends on PICS setting and may depend on test case */
    IntegerList_Type            SPI_ValidValueList[2],          /* list of valid SPI values for PDN_1 and PDN_2 (@sic R5-172048 sic@) */
    boolean                     NetworkSupportsVoiceOverIMS,    /* @sic R5-177127 sic@
                                                                   imsVoPS network feature tag indicated to the UE in ATTACH ACCEPT => audio feature tag to be checked (if supported) */
    boolean                     CheckAudioVideoTags,            /* @sic R5-201121, R5-201110 sic@
                                                                   audio/video tag to be checked at (re-)registration */
    boolean                     UEwithISIM                      /* @sic R5-203077: px_MCX_SIP_RegistrationWithTemporaryIdentities for MCX sic@ */
  };

  type record IMS_TestsuiteInfo_Type {
    IMS_TestSpec_Type           TestSpec,                       /* to distinguish e.g. MCX specific parts in common implementation   @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    NameValueList_Type          ParameterList
  };

  type record IMS_Global_Type {                                 /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    PDN_Index_Type              PdnIndex,                       /* @sic R5s130651: new variable sic@ */
    IMS_PTC_Ctrl_Type           Ctrl,
    IMS_PTC_SecurityInfo_Type   Security,
    IMS_PTC_ImsInfo_Type        ImsInfo,
    IMS_TestsuiteInfo_Type      TestsuiteInfo                   /* @sic R5-196983: MCX sic@ */
  };

  type component IMS_PTC {                                      /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

    var IMS_Global_Type         vc_IMS_Global;

    // port to RAT components
    port IMS_IPCAN_CO_ORD_PORT  IPCAN;
    port IMS_IPCAN_CO_ORD_PORT  OtherIPCAN;                     /* @sic R5-142919 sic@ */

    // port to other IMS PTC (other PDN)
    port IMS_IMS_CO_ORD_PORT    OtherPDN;

    // ports connected to IP:
    port IMS_IP_CTRL_PORT       IMS_CTRL;
    port IMS_IP_SERVER_PORT     IMS_Server;
    port IMS_IP_CLIENT_PORT     IMS_Client;

    // ports for MMI (used by IMS CC test suite)
    port UT_PTC_MTC_PORT        MMI;
  };

  template (value) IMS_PTC_SecurityInfo_Type cs_IMS_SecurityInfo_Init(template (omit) IMS_SPIs_Type p_SPIs := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    IntegrityAlgorithm := px_IMS_IPSecAlgorithm,
    CipheringAlgorithm := px_IMS_CiphAlgo_Def,
    ProtectedPorts := omit,
    SPIs := p_SPIs,     /* @sic R5s170679: to keep SPI values in case of reset => sub-sequent authorizations will use different SPI values sic@ */
    Nonce := omit,
    XRES := omit,
    XRESLength := omit  // @sic R5s120907 sic@
  };

  template (value) IMS_PTC_RegistrationInfo_Type cs_IMS_RegistrationInfo_Init :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    Uri := omit,
    CallId := omit,
    Cseq := 0,
    ContactUrl := omit // @sic R5s150908 sic@
  };

  template (value) IMS_DialogInfo_Type cs_IMS_DialogInfo_Init :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5-174544: SessionId removed sic@ */
    MobileOriginated := omit,
    RemoteTag := omit,
    RemoteURI := omit,
    RemoteCseq := omit,                     /* @sic R5s140235: changed to omit sic@ */
    LocalTag := omit,
    LocalURI := omit,
    LocalCseq := 0,
    CallId := omit,
    ContactUrlUE := omit,                   /* @sic R5s150908 sic@ */
    ContactUrlSS := omit,
    SdpSessionIdTX := "1111111111",         /* @sic R5-150707: new variable replacing tsc_SDP_SessionId sic@ */
    SdpSessionVersionTX := 1111111110,      /* @sic R5-150702: new variable; intialised with 1111111110 as being incremented firstly (see f_IMS_PTC_ImsInfo_DialogIncrAndGetSessVersionTX) sic@ */
    SdpMessagePrevTX := omit,
    SdpMessagePrevRX := omit,
    RemoteRSeq := omit
  };

  /*
   * @desc      initialise dialog status information
   * @return    template (value) IMS_PTC_DialogList_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_PTC_DialogList_Init() return template (value) IMS_PTC_DialogList_Type
  {
    var template (value) IMS_PTC_DialogList_Type v_DialogList;
    var integer i;
    v_DialogList.CurrentIndex := 0;
    for (i:=0; i<tsc_IMS_NoOfDialogs; i:=i+1) {
      v_DialogList.Info[i] := cs_IMS_DialogInfo_Init;
    }
    return v_DialogList;
  }

  template (value) IMS_PTC_ImsInfo_Type cs_IMS_ImsInfo_Init(template (omit) IPCAN_RAN_Type p_RanType,
                                                            CharStringList_Type p_IMPUList,
                                                            template (omit) integer p_UE_Release,
                                                            charstring p_HomeDomainName,
                                                            charstring p_PrivateUserId,
                                                            IMS_SecurityScheme_Type p_SecurityScheme,
                                                            IntegerList_Type p_SPI_ValidValueList_PDN1,
                                                            IntegerList_Type p_SPI_ValidValueList_PDN2,
                                                            boolean p_UEwithISIM,
                                                            boolean p_CheckAudioVideoTags := true,
                                                            integer p_BranchIndex := 0) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5s140802: new parameter p_BranchIndex sic@ */
    /* @sic R5-172048: p_SPI_ValidValueList_PDN1, p_SPI_ValidValueList_PDN2 sic@ */
    /* @sic R5s200997: p_CheckAudioVideoTags sic@ */
    IMPUList := p_IMPUList,
    UE_Address := omit,
    NW_Address := omit,
    P_CSCF_Address := omit,
    TransportProtocol := udp,
    RanType := p_RanType,
    UE_Release := p_UE_Release,
    SigCompStarted := false,
    HomeDomainName := p_HomeDomainName,
    PrivateUserId := p_PrivateUserId,
    ContactUrl := omit,
    BranchIndex := p_BranchIndex,
    CallIdCnt := 0,
    Registration := cs_IMS_RegistrationInfo_Init,
    Dialog := fl_IMS_PTC_DialogList_Init(),
    SecurityScheme := p_SecurityScheme,
    SPI_ValidValueList := {p_SPI_ValidValueList_PDN1, p_SPI_ValidValueList_PDN2},
    NetworkSupportsVoiceOverIMS := true,
    CheckAudioVideoTags := p_CheckAudioVideoTags,
    UEwithISIM := p_UEwithISIM
  };

  template (value) IMS_ProtectedPorts_Type cs_IMS_ProtectedPorts(PortNumber_Type p_Port_us,
                                                                 PortNumber_Type p_Port_uc,
                                                                 PortNumber_Type p_Port_ps,
                                                                 PortNumber_Type p_Port_pc) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    Port_us := p_Port_us,
    Port_uc := p_Port_uc,
    Port_ps := p_Port_ps,
    Port_pc := p_Port_pc
  };

  template (value) IMS_SPIs_Type cs_IMS_SPIs_Init(IPsec_SPI_Type p_SPI_us,
                                                  IPsec_SPI_Type p_SPI_uc) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    SPI_us := p_SPI_us,
    SPI_uc := p_SPI_uc,
    SPI_ps := omit,
    SPI_pc := omit
  };

  /*
   * @desc      get (next) SPI value
   * @param     p_Offset
   * @return    integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_SPI_GetValidValue(integer p_Offset) runs on IMS_PTC return integer
  {
    var integer v_Index := f_PDN_PdnIndex2ImsIndex(vc_IMS_Global.PdnIndex);    // @sic R5s201177: f_PDN_PdnIndex2ImsIndex instead of f_PDN_PdnIndex2Integer sic@
    var IntegerList_Type v_ValidValueList := vc_IMS_Global.ImsInfo.SPI_ValidValueList[v_Index];
    var integer v_ValidValueListLength := lengthof(v_ValidValueList);
    var integer v_SPI;

    if (v_ValidValueListLength > 0) {
      if (v_ValidValueListLength <= p_Offset) {
        FatalError(__FILE__, __LINE__, "Not enough SPI values");
      }
      v_SPI := v_ValidValueList[p_Offset];
    } else {
      v_SPI := 256 + (v_Index * 1024) + p_Offset; /* @sic R5s130651: v_Index used to get different SPIs for different PDNs sic@ */
    }
    if (v_SPI < 256) {  /* According to RFC 2406, SPI values from 0 to 255 are reserved */
      FatalError(__FILE__, __LINE__, "Invalid SPI value");
    }
    return v_SPI;
  }

  /*
   * @desc      search for unique SPIs
   *            Acc. to RFCs (e.g. RFC2406, RFC4302) the SPIs have local significance and source and destination address shall be taken into account to find the corresponding SA;
   *            as typically one end of the secure connection tells the other end which SPI it is using for its SAD, both ends may even use the same SPIs;
   *            nevertheless 33.203 cl. 7.1 specifies SPIs at the UE and at the P-CSCF to be different from each other
   *            => in this function we will ensure that in the 4-tuple of SPIs needed for IMS in a given PDN all values are distinct.
   *            In addition e.g. in case of re-authentication the network's SPIs shall be different than the previous ones.
   * @param     p_NewSPI_us
   * @param     p_NewSPI_uc
   * @param     p_PrevSPI_ps        (default value: omit)
   * @param     p_PrevSPI_pc        (default value: omit)
   * @return    IMS_SPIs_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_SPIs_Init(integer p_NewSPI_us,
                        integer p_NewSPI_uc,
                        template (omit) integer p_PrevSPI_ps := omit,
                        template (omit) integer p_PrevSPI_pc := omit) runs on IMS_PTC return IMS_SPIs_Type
  { /* @sic R5s130266 change 1.3, 4, 5 - MCC160 Implementation: taking into account the previous SPIs of the network side sic@ */
    /* p_PrevSPI_ps, p_PrevSPI_pc are omit at initial registration */

    var IMS_SPIs_Type v_SPIs := valueof(cs_IMS_SPIs_Init(p_NewSPI_us, p_NewSPI_uc));
    var integer v_Offset := 0;
    var integer v_SPI;

    if (p_NewSPI_uc == p_NewSPI_us) {
      FatalError(__FILE__, __LINE__, "SPIs of UE side have the same values");
    }

    while (not isvalue(v_SPIs.SPI_ps) or not isvalue(v_SPIs.SPI_pc)) {
      v_SPI := fl_SPI_GetValidValue(v_Offset); // @sic R5-172048, R5s170450 sic@
      if ((v_SPI != p_NewSPI_uc) and (v_SPI != p_NewSPI_us) and                // new value shall be neither equal to the UE's values ...
          not match(v_SPI, p_PrevSPI_pc) and not match(v_SPI, p_PrevSPI_ps)) { // ... nor to the network's previous values
        if (not isvalue(v_SPIs.SPI_ps)) {
          v_SPIs.SPI_ps := v_SPI;
        } else {
          v_SPIs.SPI_pc := v_SPI;
        }
      }
      v_Offset := v_Offset + 1;
    }
    return v_SPIs;
  }

  /*
   * @desc      initialise or re-initialise security at the IMS PTC
   * @param     p_AuthenticationParams (default value: omit)
   * @param     p_Port_us
   * @param     p_Port_uc
   * @param     p_SPI_us
   * @param     p_SPI_uc
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_Security_Init(template (omit) Common_AuthenticationParams_Type p_AuthenticationParams := omit,
                                   PortNumber_Type p_Port_us,
                                   PortNumber_Type p_Port_uc,
                                   IPsec_SPI_Type p_SPI_us,
                                   IPsec_SPI_Type p_SPI_uc) runs on IMS_PTC
  { /* @sic R5s130266 change 1.3, 4, 5 - MCC160 Implementation: taking into account SPIs for re-authentication sic@ */
    
    var Common_AuthenticationParams_Type v_AuthenticationParams;
    var template (omit) IPsec_SPI_Type v_PrevSPI_ps := omit;
    var template (omit) IPsec_SPI_Type v_PrevSPI_pc := omit;
    var PortNumber_Type v_Port_pc := tsc_IMS_Port_pc;

    if (isvalue(p_AuthenticationParams)) {
      v_AuthenticationParams := valueof(p_AuthenticationParams);
      vc_IMS_Global.Security.Nonce := f_Base64Encode(v_AuthenticationParams.RandValue & v_AuthenticationParams.AUTN);
      vc_IMS_Global.Security.XRES := v_AuthenticationParams.XRES;
    }
    if (isvalue(vc_IMS_Global.Security.SPIs)) { // => re-authentication
      v_PrevSPI_ps := vc_IMS_Global.Security.SPIs.SPI_ps;
      v_PrevSPI_pc := vc_IMS_Global.Security.SPIs.SPI_pc;
    }
    vc_IMS_Global.Security.SPIs := fl_SPIs_Init(p_SPI_us, p_SPI_uc, v_PrevSPI_ps, v_PrevSPI_pc);
    
    if (isvalue(vc_IMS_Global.Security.ProtectedPorts)) { // => re-authentication
      if (vc_IMS_Global.Security.ProtectedPorts.Port_pc == tsc_IMS_Port_pc) {
        v_Port_pc := tsc_IMS_Port_pc_2; // new client port
      }
    }
    vc_IMS_Global.Security.ProtectedPorts := valueof(cs_IMS_ProtectedPorts(p_Port_us, p_Port_uc, tsc_IMS_Port_ps, v_Port_pc));
  }

  /*
   * @desc      return true when IMS security is started on protected ports
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_Security_IPsecIsStarted() runs on IMS_PTC return boolean
  {
    return isvalue(vc_IMS_Global.Security.ProtectedPorts);
  }

  /*
   * @desc      return hash algorithm stored at the IMS PTC
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_Security_GetHashAlgorithm() runs on IMS_PTC return charstring
  {
    var charstring v_Algorithm;
    select (vc_IMS_Global.ImsInfo.SecurityScheme) {
      case (IMS_Security) {
        v_Algorithm := tsc_AKAv1_MD5;
      }
      case else {
        v_Algorithm := "";   // dummy
      }
    }
    return v_Algorithm;
  }

