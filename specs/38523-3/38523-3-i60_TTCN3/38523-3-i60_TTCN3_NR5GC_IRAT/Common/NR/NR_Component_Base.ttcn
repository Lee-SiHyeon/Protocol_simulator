module NR_Component_Base {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_TypeDefs all;
  import from NR_ASP_VirtualNoiseDefs all;
  import from NR_CommonDefs all;
  import from NR_SecurityFunctions all;
  import from TestcaseProperties all;
  import from UpperTesterPtcToMtcDefs all;

  type record NR_NAS_Parameters_Type {                                          /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    PLMN_Identity       PLMN_Identity,
    TrackingAreaCode    TrackingAreaCode,
    RAN_AreaCode        Ranac   optional,
    CellIdentity        CellIdentity
  };

  type record NR_RNTI_Type {                                                    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    RNTI_Value_Type       RNTI
  };

  type record NR_PhysicalParameters_Type {                                      /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SubcarrierSpacing              SubcarrierSpacing,                           //SCS applied on other channels
    NR_SSB_BurstConfig_Type        SSB_BurstConfig,
    NR_DownlinkBWP_List_Type       DL_BWPs optional,
    NR_UplinkBWP_List_Type         UL_BWPs optional,
    RACH_ConfigDedicated           RACH_ConfigDedicated optional,
    SSB_MTC                        SSB_MTC optional ,                            //Used in ENDC test cases
    NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type RadioLinkMonitoringConfig optional, /* RadioLinkMonitoringConfig for dedicated BWP
                                                                                                 * Note: one single RadioLinkMonitoringConfig for all BWP is handled. */
                                                                                                // @sic R5s190244 sic@
    integer                        OffsetCarrierCORESET0,  // Offset in RBs between the carrier and CORTESET#0 - used in DCI functions @sic R5-202677 sic@
    integer                        ChannelBandwidth        //Needed in NR_PhysicalParameters_Type for CBW3 @sic R5-250309 sic@
  };

  type  record NR_CellSysInfo_Type {                                            /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // type defined to contain all sysinfo related to an NR cell
    NR_BcchInfo_Type                   BcchInfo,                                // MIB, SIB1, SIs
    NR_SysinfoCombination_Type         NR_SysinfoCombination,                   // System Information Combination
    //@sic R5s200703 sic@
    NTN_CellInfo_Type                  NtnInfo                                  // additional NTN-related information relevant to TS 38.508-1 cl 6.3.4.1/6.3.4.2 @sic R5w240105r1 sic@
  };

  type enumerated NR_SysinfoCombination_Type {                                  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Acc to 38.508-1 Table 4.4.3.1.2-1
    //@sic R5-213452 R5-223387 R5-223417 R5-223399 R5-233379 R5-235359, R5-233436, R5-243555 R5-244716, R5-253084 R5-254943, R5-254023, R5-261589 sic@
    MibOnly, NR_1, NR_2, NR_3, NR_4, NR_5, NR_6, NR_7, NR_8, NR_9, NR_10, NR_11, NR_12, NR_14, NR_15, NR_16, NR_17, NR_18, NR_19, NR_20, NR_21, NR_22, NR_23, NR_24, NR_25, NR_26, NR_27, NR_29, NR_30, NR_32, NR_34, NR_35, NR_36, NR_40
  };

  type record NR_FrequencyBand_Type {                                           /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Frequency type used to store the frequency in the CellArray
    FreqBandIndicatorNR             FrequencyBandIndicator,
    integer                         ChannelBandwidth optional,         //@sic R5-203056 R5s200971 sic@
    FrequencyInfoDL                 FrequencyInfoDL optional,
    FrequencyInfoUL                 FrequencyInfoUL optional,
    integer                         Ssb_SubcarrierOffset optional,
    ControlResourceSetZero          Coreset0_Index optional,
    SubcarrierSpacing               SSB_SubcarrierSpacing optional,             //SCS applied on SS/PBCH blocks
    integer                         Dl_OffsetToPointA optional,
    integer                         OffsetCarrierCORESET0 optional,              //@sic R5-200678 R5-202578 sic@
    integer                         Coreset0_OffsetRBs optional,                 //@sic R5-201020 sic@
    FreqBandIndicatorNR             MFBI_Band optional                           //@sic R5s201305 sic@
  };

  type record NR_CellIdentities_Type {                                          /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    PhysCellId                  PhysicalCellId   // Physical cell ID
  };

  type record NR_ReferenceCellPower_Type { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    NR_AbsoluteCellPower_Type           MaxReferencePower,
    NR_Attenuation_Type                 Attenuation
  };

  type record NR_SupplementaryUplink_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    NR_ASN1_FrequencyInfoUL_Type        FrequencyInfoUL       optional,
    NR_UplinkBWP_List_Type              UL_BWPs               optional,
    NR_ASN1_RACH_ConfigDedicated_Type   RACH_ConfigDedicated  optional
  };

  type record NR_TimingScheduling_Type { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    UInt_Type   K2
  };

  type record NR_CellInfo_Type {                                                /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // this structure contains the information describing an NR cell configuration
    //@sic R5-216160: deleted NR_CellCapability_Type sic@
    NR_CellIdentities_Type      CellIds,
    NR_FrequencyBand_Type       FrequencyBand,
    NR_ReferenceCellPower_Type  ReferencePower,
    NR_CellSysInfo_Type         Sysinfo,
    CellTimingInfo_Type         CellTimingInfo,
    NR_DuplexMode_Type          DuplexMode,
    NR_PhysicalParameters_Type  PhysicalParameters,
    NR_RNTI_Type                RNTI,
    NR_NAS_Parameters_Type      NAS_Parameters,
    NR_ServingCellConfig_Type   ServingCellConfig,
    NR_MeasGapCtrl_Type         MeasGapCtrl, //@sic R5-195259 sic@
    NR_DrxCtrl_Type             DrxCtrl,
    RLF_TimersAndConstants      RLF_TimersAndConstants,  //@sic R5-197205 sic@
    NR_SupplementaryUplink_Type SupplementaryUplink optional,
    NR_TimingScheduling_Type    TimingScheduling,         //@sic R5s230634 R5-235286 sic@
    NR_NTN_TimingAdvanceConfig_Type NtnTA    optional //@sic R5-242320 sic@

  };

  type record of NR_CellInfo_Type NR_CellInfoList_Type;                         /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  type record NR_MobileInfo_Type {                                              /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    UE_NR_Capability            NR_Capability     optional,
    UE_MRDC_Capability          MRDC_Capability   optional,
    UE_NR_DeltaValues_Type      NR_DeltaValues    optional,   //@sic R5-197223 sic@
    NR_TestEnvironment_Type     NR_TestEnvironment optional,  // Test environment conducted or OTA @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    NTN_Satellite_Type          NTN_SatelliteType optional    //@sic R5-242320 sic@
  };

  type record NR_Ctrl_Type {                                                    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    default                             Default,                                /* default behaviour being activated as standard */
    boolean                             TestBody,                               /* true:  => fail may be assigned
                                                                                   false: => inconc is assigned instead of fail */
    VerdictCtrl_Type                    VerdictCtrl,                            /* Control the assignment of FAIL/INCOCN in default behaviour */
    HarqErrorHandling_Type              HarqErrorHandling                       /* handling of HARQ errors being reported by the SS; 'ignore' per default */
  };

  type record NR_Global_Type {                                                  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    NR_Ctrl_Type                Ctrl,
    NR_SecurityParams_Type      Security,
    NR_CellInfoList_Type        CellArray,
    NR_MobileInfo_Type          MobileInfo,
    NR_Configuration_Type       NR_Config
  };

  type component NR_BASE_PTC {                                                  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    var  NR_Global_Type vc_NR_Global;

    port NR_SYSTEM_PORT          SYS;
    port NR_SYSIND_PORT          SYSIND;
    port NR_SRB_PORT             SRB;
    port NR_DRB_PORT             DRB;
    port UT_PTC_MTC_PORT         UT;

    port IP_RAT_CTRL_PORT        IP;             // @sic R5s190328 sic@

    port EUTRA_NR_CO_ORD_PORT    EUTRA;

    port NR_VNG_PORT             VNG;            // @sic R5w190210 sic@
  };

  type component NR_BASE_SYSTEM {                                               /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    port NR_SYSTEM_PORT          NR_SYS;
    port NR_SYSIND_PORT          NR_SYSIND;
    port NR_DRB_PORT             NR_DRB;

    port NR_VNG_PORT             NR_VNG;         // @sic R5w190210 sic@
  };

  /*
   * @desc      Map NR's system ports
   * @param     p_System
   * @param     p_NR
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_BASE_PTC_Map(NR_BASE_SYSTEM p_System,
                             NR_BASE_PTC p_NR)
  {
    map(p_NR:SYS,    p_System:NR_SYS);
    map(p_NR:SYSIND, p_System:NR_SYSIND);
    map(p_NR:DRB,    p_System:NR_DRB);

    if (f_GetTestcaseAttrib_VNG(testcasename())) {
      /* Virtual noise generator for test cases using the noise generator */
      /* @sic R5w190210 R5-199027 sic@ */
      map(p_NR:VNG,  p_System:NR_VNG);
    }
  }

  template (present) NR_SRB_COMMON_IND  cr_NR_SRB_COMMON_IND_Any := ?;         /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      default behaviour does not cover coordination ports to other PTCs;
   *            this is to allow other PTCs to send sync messages at any time:
   *            these messages are in the port's queue until being handled by the NR PTC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  altstep a_NR_BASE_StandardDefault() runs on NR_BASE_PTC
  {
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var NR_SRB_COMMON_IND v_NR_SRB_COMMON_IND;
    var charstring v_Msg;

    [] SYS.receive (cr_NR_SYSTEM_CTRL_CNF_Any) {
      /* unexpected CNF shall always result in INCONC */
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected receive event at port SYS");
    }

    [] SYSIND.receive (cr_NR_SYSTEM_IND_Any) -> value v_SYSTEM_IND {
      if (ischosen(v_SYSTEM_IND.Indication.HarqError)) {

        select (vc_NR_Global.Ctrl.HarqErrorHandling) {
          case (ignore) {
            repeat;
          }
          case else {
            // don't repeat but terminate test case
          }
        }
      }
      all timer.stop;
      if (ischosen(v_SYSTEM_IND.Indication.Error)) {
        /* error indicated by the system simulator shall always result in INCONC */
        f_SetVerdictInconc(__FILE__, __LINE__, "error indicated at port SYS");
      } else {
        /* L1/MAC indications: all of these indications occur only when being activated by TTCN before */
        if (ischosen(v_SYSTEM_IND.Indication.RachPreamble) or
            ischosen(v_SYSTEM_IND.Indication.SchedReq) or
            ischosen(v_SYSTEM_IND.Indication.UL_HARQ) or
            ischosen(v_SYSTEM_IND.Indication.HarqError)) {
          /* L1 indications:
           * at layer 1 transmission errors may occur; therefore in general this is an unspecific behaviour */
          f_SetVerdictInconc(__FILE__, __LINE__, "unexpected L1 indication at port SYSIND");
        } else {
          /* MAC indications:
           * BSR, C_RNTI, PHR: within the test body a FAIL shall be assigned */
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected MAC indication at port SYSIND");
        }
      }
    }
    [] DRB.receive (cr_NR_DRB_COMMON_IND_Any) {
      /* unexpected data at the DRB port */
      all timer.stop;

      v_Msg := "unexpected data at port DRB";
      if (vc_NR_Global.Ctrl.VerdictCtrl == layer2) {         /* user plane data is part of the test purpose */
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, v_Msg);
      } else {                                                  /* user plane data is not part of the test purpose */
        f_SetVerdictInconc(__FILE__, __LINE__, v_Msg);
      }
    }
    [] SRB.receive (cr_NR_SRB_COMMON_IND_Any) -> value v_NR_SRB_COMMON_IND { // @sic R5s190283 sic@
      /* unexpected L3 signalling message */
      all timer.stop;
      if (not ispresent(v_NR_SRB_COMMON_IND.Signalling.Rrc)) {
        /* unexpected NAS message received in ULInformationTransfer => shall cause a FAIL when received in the test body */
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected NAS PDU at port SRB");
      } else if (not ispresent(v_NR_SRB_COMMON_IND.Signalling.Nas)) {
        /* unexpected RRC message received => shall cause a FAIL when received in the test body */
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected RRC PDU at port SRB");
      } else {
        /* unexpected RRC message with piggybacked NAS PDU received => shall cause a FAIL when received in the test body */
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected RRC PDU with piggybacked NAS PDU at port SRB");
      }
    }
    [] any timer.timeout {
      /* Note: there is no way to distinguish local timers in the default behaviour
       *       => there can be either an INCONC or a FAIL in the default behaviour;
       *       => we assign an INCONC - when there shall be FAIL in case of a timeout
       *          this needs to be handled where the timer is declared */
      all timer.stop;
      f_SetVerdictInconc(__FILE__, __LINE__, "unexpected timeout");
    }
  }

  /*
   * @desc      to deal with entry and exit of the test body
   * @param     p_TestBodyFlag
   * @param     p_VerdictCtrl       (default value: normal)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_TestBody_Set(boolean p_TestBodyFlag,
                             VerdictCtrl_Type p_VerdictCtrl := normal) runs on NR_BASE_PTC
  {
    vc_NR_Global.Ctrl.TestBody := p_TestBodyFlag;
    vc_NR_Global.Ctrl.VerdictCtrl := p_VerdictCtrl;
    if (p_TestBodyFlag) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "initial preliminary pass");
    }
  }

  /*
   * @desc      check whether test body is active
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_TestBody_Check() runs on NR_BASE_PTC return boolean
  {
    return vc_NR_Global.Ctrl.TestBody;
  }

  /*
   * @desc      set correct verdict: FAIL is assigned only when being in the test body
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SetVerdictFailOrInconc(charstring p_FileName,
                                       LineNo_Type p_LineNo,
                                       charstring p_Msg) runs on NR_BASE_PTC
  {
    if (fl_NR_TestBody_Check()) {
      f_SetVerdict(fail, p_FileName, p_LineNo, p_Msg);
    } else {
      f_SetVerdict(inconc, p_FileName, p_LineNo, p_Msg);
    }
    self.kill;    // => test case will be terminated immediately
  }

  /*
   * @desc      set correct verdict: prelininary PASS is only be assigned when being in the test body
   * @param     p_FileName
   * @param     p_LineNo
   * @param     p_Msg
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_PreliminaryPass(charstring p_FileName,
                                LineNo_Type p_LineNo,
                                charstring p_Msg) runs on NR_BASE_PTC
  {
    if (fl_NR_TestBody_Check()) {
      f_SetVerdict(pass, p_FileName, p_LineNo, p_Msg);
    }
  }

}
