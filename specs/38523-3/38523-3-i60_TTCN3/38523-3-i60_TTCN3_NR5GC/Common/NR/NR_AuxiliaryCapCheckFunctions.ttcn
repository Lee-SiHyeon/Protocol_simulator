  /*
   * @desc      Returns whether reported field sl_TransmissionMode1_r16 matches with expected contents in the specs
   * @param     p_Sl_TransmissionMode1_r16
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_Derive_sl_TransmissionMode1_r16 (BandSidelink_r16.sl_TransmissionMode1_r16 p_Sl_TransmissionMode1_r16) return boolean
  { // @sic R5-227571 sic@
    if (pc_NR_sl_TransmissionMode1_r16) {
      return ((p_Sl_TransmissionMode1_r16.harq_TxProcessModeOneSidelink_r16 == n8) or (p_Sl_TransmissionMode1_r16.harq_TxProcessModeOneSidelink_r16 == n16));
    } else {
      return false;
    }
  }

