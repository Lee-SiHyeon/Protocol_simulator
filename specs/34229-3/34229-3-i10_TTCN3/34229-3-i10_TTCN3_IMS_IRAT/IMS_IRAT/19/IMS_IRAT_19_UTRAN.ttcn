module IMS_IRAT_19_UTRAN {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonIratDefs all;
  import from IMS_IRAT_CSFB_UTRAN all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_IRAT_CommonFunctions all;
  import from UTRAN_IRAT_CommonProcedures all;
  import from UTRAN_IRAT_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.1.3
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_1_3_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Emergency call with emergency registration / Abnormal case / IM CN sends a 380 / UE performs emergency call via CS domain */
    var template ServCategory v_ServCategory := cr_ServCategory(cr_EmergServCat_non_eCall) ifpresent;
    f_IMS_CSFB_UTRAN_Body(-, v_ServCategory); // @sic R5-1500700, R5-185087 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Emergency call with emergency registration / Abnormal case / IM CN sends a 380 / UE performs emergency call via CS domain */
    f_IMS_CSFB_UTRAN_Body(); // @sic R5-1500699 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2b
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2b_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Non-UE detectable emergency call / IM CN sends a 380 with unavailable emergency service URN / UE performs normal call via CS domain / UTRAN or GERAN */
    
    f_IMS_CSFB_UTRAN_Init ();    //Initialise test case  @sic R5s160070 sic@

    f_UTRAN_TestBody_Set(true);
    
    //@siclog "Step 9" siclog@
    f_UTRAN_CS_Fallback_WithRedirection(utran_Cell5, false); // new in 19_3_2b
    
    //@siclog "Step 10" siclog@
    //The SS releases the UE connection
    f_UTRAN_CC_Disconnect();
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch, true);  //@sic R5s230160 sic@
    f_UTRAN_RRC_ConnEst(utran_Cell5);
    f_UTRAN_GMM_RAU(utran_Cell5, false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch);

    f_UTRAN_OptionalPDPEstabForIMSReRegistration(utran_Cell5); // @sic R5-183106 sic@

    f_UTRAN_TestBody_Set(false);

    // Switch off/power off and release cells
    // f_UTRAN_IP_Handling_Change_Configuration(utran_CellDedicated, cell_DCH_64kPS_RAB_SRB); // @sic R5s140788, R5s150736 now done in postamble sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE);
   
    // send coordination message for end of test case
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_Trigger);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2c
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2c_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Non-UE detectable emergency call / IM CN sends a 380 with available emergency service URN / UE performs CS Emergency call via CS domain / UTRAN or GERAN */
    f_IMS_CSFB_UTRAN_Body (); // @sic R5-1500700 sic@
  }

}
