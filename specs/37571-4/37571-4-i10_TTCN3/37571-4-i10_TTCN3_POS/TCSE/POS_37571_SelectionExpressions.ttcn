  /*
   * @desc      Set the applicability conditions according to 37.571-3 Table 4-5 and 4-7: Applicability of tests Conditions
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (POS)
   */
  function f_POS_SelectionExpr(POS_37571_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;

    select (p_Condition) {
      case (POS_C11us) {
        v_ApplCond := pc_FDD and pc_UEB_A_GANSS and pc_GLONASS and not (pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C12us) {
        v_ApplCond := pc_FDD and pc_UEB_A_GANSS and pc_GALILEO and not (pc_UeBasedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C13us) {
        v_ApplCond := pc_FDD and pc_UeBasedAgps and pc_UEB_A_GANSS and pc_MGPS and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C14us) {
        v_ApplCond := pc_FDD and pc_UeBasedAgps and pc_UEB_A_GANSS and pc_GLONASS and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C15us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GLONASS and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C16us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GALILEO and not (pc_UeAssistedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C17us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_MGPS and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C18us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GLONASS and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C19us) {
        v_ApplCond := pc_FDD and pc_UEB_A_GANSS and pc_GLONASS and pc_ParamPosEstimate and not (pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C20us) {
        v_ApplCond := pc_FDD and pc_UEB_A_GANSS and pc_GALILEO and pc_ParamPosEstimate and not (pc_UeBasedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C21us) {
        v_ApplCond := pc_FDD and pc_UeBasedAgps and pc_UEB_A_GANSS and pc_MGPS and pc_ParamPosEstimate and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C22us) {
        v_ApplCond := pc_FDD and pc_UeBasedAgps and pc_UEB_A_GANSS and pc_GLONASS and pc_ParamPosEstimate and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C23us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GLONASS and pc_ParamPosEstimate and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C24us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GALILEO and pc_ParamPosEstimate and not (pc_UeAssistedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C25us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_MGPS and pc_ParamPosEstimate and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C26us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GLONASS and pc_ParamPosEstimate and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C27us) {
        v_ApplCond := pc_FDD and (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_GLONASS and pc_ParamGpsAssisData and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C28us) {
        v_ApplCond := pc_FDD and (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_GALILEO and pc_ParamGpsAssisData and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C29us) {
        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GALILEO and pc_ParamGpsAssisData and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C30us) {
        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GLONASS and pc_ParamGpsAssisData and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C31us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GLONASS and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C32us) {
        v_ApplCond := pc_FDD and pc_UEA_A_GANSS and pc_GALILEO and not (pc_UeAssistedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C33us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_MGPS and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C34us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GLONASS and not (pc_GALILEO or pc_BDS);
      }
      case (POS_C35us) {
        v_ApplCond := pc_FDD and (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_GLONASS and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_BDS);
      }
      case (POS_C36us) {
        v_ApplCond := pc_FDD and (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_GALILEO and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_GLONASS or pc_MGPS or pc_BDS);
      }
      case (POS_C37us) {
        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GALILEO and not (pc_GLONASS or pc_GALILEO or pc_BDS);
      }
      case (POS_C38us) {
        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GLONASS and not (pc_GALILEO or pc_BDS);
      }
