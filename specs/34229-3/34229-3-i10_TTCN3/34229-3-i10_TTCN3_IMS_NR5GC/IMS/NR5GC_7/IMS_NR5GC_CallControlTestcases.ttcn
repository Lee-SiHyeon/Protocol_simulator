    // @siclog "Step 1" siclog@                 Steps 1-8 of generic procedure specified in Table 4.9.16.2.2-1 of TS 38.508-1
    
    // @siclog "Step 2 - 6" siclog@             INVITE, 100 Trying, 183 Session Progress, PRACK, 200 OK
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NoSdpInINVITE_Step1_6(tsc_SDP_WithoutPreconditions);    /* @sic R5-231495: EVS_AnyNG114 sic@
                                                                                                           @sic R5-236897: EVS_A2 instead of EVS_AnyNG114 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4, 6");
    
    // @siclog "Step 7 - 9" siclog@             180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithoutPreconditions);        /* @sic R5s210423: tsc_SDP_WithoutPreconditions sic@
                                                                                                                                   @sic R5-242750: tsc_OptionTagList_100rel sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 10A - 11" siclog@          MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.11.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_11_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice call without preconditions at terminating UE and originating UE requiring them / 5GS
    var template (value) IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (present) MessageHeader v_MessageHeader_Response420;
    var template (value) MessageHeader v_MessageHeaderACK;
    var IMS_DATA_RSP v_IMS_DATA_RSP;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartSignalling(IPCAN_MT_IMS_Signalling);

    // @siclog "Step 1 - 8" siclog@             Steps 1-8 of generic procedure specified in Table 4.9.16.2.2-1 of TS 38.508-1
    
    // @siclog "Step 9" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_BuildInviteRequestWithSdp(tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, EVS_A2, tsc_SDP_WithPreconditions);         /* @sic R5-246475: EVS_B0_A1 replaced by EVS_A2 sic@ */
    v_InviteRequestWithSdp.Invite.msgHeader.require := cs_Require(tsc_OptionTagList_precondition);
    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequestWithSdp.Invite));

    // @siclog "Step 10" siclog@                420 Bad Extension
    v_MessageHeader_Response420 := f_IMS_InviteResponse_4XX_MessageHeaderRX(v_InviteRequestWithSdp.Invite.msgHeader);
    v_MessageHeader_Response420.unsupported := cr_Unsupported(tsc_OptionTagList_precondition);
    v_IMS_DATA_RSP := f_IMS_ReceiveResponse_OptionalTrying(v_InviteRequestWithSdp.Invite.msgHeader, v_InviteRequestWithSdp.RoutingInfo.Protocol, cr_Response(c_statusLine420, v_MessageHeader_Response420)); /* @sic R5s210136: f_IMS_ReceiveResponse_OptionalTrying sic@ */
    f_IMS_Dialog_CompleteCreationForMTCall(v_IMS_DATA_RSP.Response.msgHeader);                                                                                                                               /* @sic R5s210136 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 11" siclog@                ACK
    v_MessageHeaderACK := f_IMS_AckRequest_MessageHeaderTX(v_InviteRequestWithSdp.Invite, c_statusLine420);
    IMS_Client.send(cas_IMS_Ack_Request(v_InviteRequestWithSdp.RoutingInfo, cs_ACK_Request(v_InviteRequestWithSdp.Invite.requestLine.requestUri, v_MessageHeaderACK)));

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.12.NR5GC
   * @status    APPROVED (IMS)
