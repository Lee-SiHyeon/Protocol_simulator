  };

  template (value) CommonSCell_UL_Configuration_Type cs_RadioResourceConfigCommonSCell_UL_Configuration_DEFAULT(PUSCH_HoppingOffset_Type p_PuschHoppingOffset,
                                                                                                                template (value) SoundingRS_UL_ConfigCommon p_SoundingRS_UL_ConfigCommon,
                                                                                                                //@sic R5s160322 sic@
                                                                                                                template (omit) SCell_UL_CarrierFreq_Type p_CarrierFreq_Scell := omit,
                                                                                                                template (omit) SCell_UL_Bandwidth_Type  p_SCell_UL_Bandwidth := omit
                                                                                                                ) :=
  { /* acc. to 36.508 Table 4.6.3-13A with condition UL CA */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    ul_FreqInfo_r10 := {
      ul_CarrierFreq_r10 :=  p_CarrierFreq_Scell ,
      ul_Bandwidth_r10 :=    p_SCell_UL_Bandwidth ,
      additionalSpectrumEmissionSCell_r10 := 1
