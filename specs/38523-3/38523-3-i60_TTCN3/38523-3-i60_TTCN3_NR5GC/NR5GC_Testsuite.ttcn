  //----------------------------------------------------------------------------
  testcase TC_6_1_2_2_NR5GC() runs on MTC_NR5GC system SYSTEM_NR5GC {
    // @purpose
    //   Cell Selection / Qqualmin/Intra NR / Serving cell becomes non-suitable (Srxlev > 0, Squal < 0)
    var NR5GC_PTC        v_NR5GC      := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_NR5GC := NR5GC_PTC.create("NR5GC") alive;
  
