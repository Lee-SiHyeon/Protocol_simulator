module RRC_Measurement_CA_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_CommonFunctions_CA all;
  import from NR5GC_NASSteps all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_CA all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_FrequencyCommon all;
  import from NR_Measurement_Functions all;
  import from NR_Measurement_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.17.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_17_1_NR5GC() runs on NR5GC_PTC
  { // NR CA / Measurement configuration control and reporting / Intra NR measurements / Event A6 / Intra-band Contiguous CA
  
    f_TC_8_1_3_1_17_Common(nr_Cell3, nr_Cell12, CA_IntraBandContiguous);
      
  }// End of f_TC_8_1_3_1_17_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.17.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_17_2_NR5GC() runs on NR5GC_PTC
  { //NR CA / Measurement configuration control and reporting / Intra NR measurements / Event A6 / Inter-band CA
  
   f_TC_8_1_3_1_17_Common(nr_Cell10, nr_Cell30, CA_InterBand);
      
  }// End of f_TC_8_1_3_1_17_2_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.17.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_17_3_NR5GC() runs on NR5GC_PTC
  { //NR CA / Measurement configuration control and reporting / Intra NR measurements / Event A6 / Intra-band non Contiguous CA
  
    f_TC_8_1_3_1_17_Common(nr_Cell3, nr_Cell12, CA_IntraBandNonContiguous);
      
  }// End of f_TC_8_1_3_1_17_3_NR5GC()

  /*
   * @desc      Common function for 8.1.3.1.17.1, 8.1.3.1.17.2, 8.1.3.1.17.3
   * @param     p_SCellId
   * @param     p_NeigbourCellId
   * @param     p_NR_CA_Tested
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_17_Common(NR_CellId_Type p_SCellId, NR_CellId_Type p_NeigbourCellId, NR_CA_Tested_Type p_NR_CA_Tested) runs on NR5GC_PTC
  {
    f_NR5GC_Init_CA(NR_4, {nr_Cell1, p_SCellId}, p_NR_CA_Tested, -, {p_SCellId , p_NeigbourCellId});    //@sic  R5s200717, R5-203811 sic@
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1,  -82, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_CellInfo_InitMaxReferencePower(p_NeigbourCellId, -78, tsc_NR_ServingCellSSS_EPRE_FR2);
      
    //Create and configure NR cell1 and NR cell 2
    f_NR_CellConfig_PCell_Def(nr_Cell1);
    f_NR_CellConfig_SCell(p_SCellId, Scell_Inactive); //@sic R5-216160 sic@
    f_NR_CellConfig_Def(p_NeigbourCellId);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
      
    f_NR_TestBody_Set(true);
    fl_TC_8_1_3_1_17_x_TestBody(p_SCellId, p_NeigbourCellId);
    f_NR_TestBody_Set(false);
    
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
  }// f_TC_8_1_3_1_17_Common

  /*
   * @desc      test body of TC_8_1_3_1_17_x
   * @param     p_SCellId
   * @param     p_NeigbourCellId
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_3_1_17_x_TestBody(NR_CellId_Type p_SCellId, NR_CellId_Type p_NeigbourCellId) runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    
    var PhysCellId v_PhysCellId_SpCell;
    var PhysCellId v_PhysCellId_SCell;
    var PhysCellId v_PhysCellId_Neighbour;

    var RSRP_Range v_RsrpThres;
     
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
      
    v_CellPowerList_AtT0 :=
    {
        cs_NR_CellPower(nr_Cell1, -82, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2),                              //@sic R5-234560 sic@
        cs_NR_CellPower(p_SCellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2),  //@sic R5-234560 sic@
        cs_NR_CellPower(p_NeigbourCellId, -94, tsc_NR_NonSuitableCellSSS_EPRE_FR2)                             //@sic R5-234560 sic@
    };
    v_CellPowerList_AtT1 :=
    {
        cs_NR_CellPower(p_NeigbourCellId, -78, tsc_NR_ServingCellSSS_EPRE_FR2)    //@sic R5-234560 sic@
    };
             
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message including sCellToAddModList with NR Cell 3 as SCell addition.
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR5GC_AddMod_1SCell( nr_Cell1, p_SCellId);
      
    //@siclog "Steps 3-4" siclog@
    //The SS transmits an RRCReconfiguration message including measConfig to setup intra NR measurement and reporting for event A6.
    v_RsrpThres := 0;
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, -, 2),
                             cs_MeasObjectId2(p_SCellId, -, 2)};
    v_ReportConfigList := {cs_NR_ReportConfigEventA6  (tsc_NR_IdReportConfigId1, v_RsrpThres, -, cs_NR_MeasReportQuantity_Rsrp, ms10240)};  //Table 8.1.3.1.17.1.3.3-6
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1}
      
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);
      
    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1, v_MeasConfig, tsc_NR_MeasObjectId2, -, -, -, -, crs_MacBearerRouting(nr_Cell1));
      
    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a MeasurementReport message within the next 10s?
    f_NR_Check_NoMeasurementReport(10.0, nr_Cell1, cr_NR_MeasurementReport_Any);
      
    //@siclog "Step 6" siclog@
    //The SS re-adjusts the SS/PBCH EPRE level according to row "T1" in table 8.1.3.1.17.1.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
     
    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit a MeasurementReport message to report event A6 with the measured RSRP value for NR Cell 12?
    v_PhysCellId_SpCell := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellId_SCell := f_NR_CellInfo_GetPhysicalCellId(p_SCellId);
    v_PhysCellId_Neighbour := f_NR_CellInfo_GetPhysicalCellId(p_NeigbourCellId);
    f_NR_ReceiveMeasurementReports(nr_Cell1,
                                  v_PhysCellId_SpCell,
                                  tsc_NR_MeasId1,
                                  1, // 1 report
                                  -, // no interval
                                  cr_NR_MeasResults_MeasResultNeighCells_NR({cr_NR_MeasResultNR_CellResults( v_PhysCellId_Neighbour, cr_NR_MeasQuantityResults_Rsrp)}),
                                  true, //SRB1
                                  v_PhysCellId_SCell,
                                  -, -, -, -,
                                  crs_MacBearerRouting(nr_Cell1)
                                  ); //@sic R5-204437, R5-211389 sic@
    
      
    //@siclog "Steps 8-9" siclog@
    //The SS transmits an RRCReconfiguration message including sCellToReleaseList with NR Cell 3 as SCell release.
    //Table 8.1.3.1.17.1.3.3-10
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR5GC_Rel_1SCell(nr_Cell1, p_SCellId);    //@sic R5s200717sic@
     
    //@siclog "Step 10" siclog@
    //Check: Does the UE attempt to transmit an uplink message for the next 15s?
    f_NR_Check_NoUplinkMessage(15.0);
      
  }//End of fl_TC_8_1_3_1_17_x_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.18.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_18_1_NR5GC() runs on NR5GC_PTC
  { //NR CA / Measurement configuration control and reporting / Intra NR measurements / Additional measurement reporting / Intra-band Contiguous CA
  
    f_TC_8_1_3_1_18_Common(nr_Cell3, nr_Cell12, nr_Cell23, CA_IntraBandContiguous);
      
  }// End of f_TC_8_1_3_1_18_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.18.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_18_2_NR5GC() runs on NR5GC_PTC
  { //NR CA / Measurement configuration control and reporting / Intra NR measurements / Additional measurement reporting / Inter-band CA
  
   f_TC_8_1_3_1_18_Common(nr_Cell10, nr_Cell30, nr_Cell31, CA_InterBand);
      
  }// End of f_TC_8_1_3_1_18_2_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.18.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_18_3_NR5GC() runs on NR5GC_PTC
  { //NR CA / Measurement configuration control and reporting / Intra NR measurements / Additional measurement reporting / Intra-band non Contiguous CA
  
    f_TC_8_1_3_1_18_Common(nr_Cell3, nr_Cell12, nr_Cell23, CA_IntraBandNonContiguous);
      
  }// End of f_TC_8_1_3_1_18_3_NR5GC()

  /*
   * @desc      Common function for 8.1.3.1.18.1, 8.1.3.1.18.2, 8.1.3.1.18.3
   * @param     p_SCellId
   * @param     p_NeigbourCellId1
   * @param     p_NeigbourCellId2
   * @param     p_NR_CA_Tested
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_18_Common(NR_CellId_Type p_SCellId, NR_CellId_Type p_NeigbourCellId1, NR_CellId_Type p_NeigbourCellId2, NR_CA_Tested_Type p_NR_CA_Tested) runs on NR5GC_PTC
  {//@sic R5-202530 sic@
    f_NR5GC_Init_CA(NR_4, {nr_Cell1, p_SCellId}, p_NR_CA_Tested, -, {p_SCellId , p_NeigbourCellId1, p_NeigbourCellId2});    //@sic  R5s200734,R5-203811 sic@
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1,  -82, tsc_NR_ServingCellSSS_EPRE_FR2);                    //@sic R5-203503 sic@
    f_NR_CellInfo_InitMaxReferencePower(p_SCellId, -82, tsc_NR_ServingCellSSS_EPRE_FR2);                    //@sic R5-203503 sic@
    f_NR_CellInfo_InitMaxReferencePower(p_NeigbourCellId1, -78, tsc_NR_ServingCellSSS_EPRE_FR2);            //@sic R5-203503 sic@
    f_NR_CellInfo_InitMaxReferencePower(p_NeigbourCellId2, -82, tsc_NR_ServingCellSSS_EPRE_FR2);            //@sic R5-203503 sic@
   
    //Create and configure NR cells
    //Removed f_NR_SetCellCapability broadcastOnlyCell for neighbouring cells  @sic R5-216160 R5-216637 sic@
    
    f_NR_CellConfig_PCell_Def(nr_Cell1);
    f_NR_CellConfig_SCell(p_SCellId, Scell_Inactive); //@sic R5-216160 sic@
    f_NR_CellConfig_Def (p_NeigbourCellId1);
    f_NR_CellConfig_Def (p_NeigbourCellId2);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
      
    f_NR_TestBody_Set(true);
    fl_TC_8_1_3_1_18_x_TestBody(p_SCellId, p_NeigbourCellId1, p_NeigbourCellId2 );
    f_NR_TestBody_Set(false);
    
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    
  }// f_TC_8_1_3_1_18_Common

  /*
   * @desc      test body of TC_8_1_3_1_18_x
   * @param     p_SCellId
   * @param     p_NeigbourCellId1
   * @param     p_NeigbourCellId2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_3_1_18_x_TestBody(NR_CellId_Type p_SCellId, NR_CellId_Type p_NeigbourCellId1,  NR_CellId_Type p_NeigbourCellId2) runs on NR_BASE_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT3;
    
    var PhysCellId v_PhysCellId_SpCell;
    var PhysCellId v_PhysCellId_SCell;
    var PhysCellId v_PhysCellId_Neighbour;

    var RSRP_Range v_RsrpThres;
     
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddMod v_ReportConfig;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;

    var template (present) MeasResultNR v_MeasResultBestNeighCell_SCell;
    var DeltaValues_Type v_Deltas;
      
    v_CellPowerList_AtT0 :=
    {//@sic R5-201477, R5-234560 sic@
        cs_NR_CellPower(nr_Cell1, -82, tsc_NR_ServingCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_SCellId, -82, tsc_NR_ServingCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId1, -91, tsc_NR_NonSuitableCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId2, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
    v_CellPowerList_AtT1 :=
    {//@sic R5-201477, R5-234560 sic@
        cs_NR_CellPower(p_SCellId, -98, tsc_NR_NonSuitableCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId1, -91, tsc_NR_ServingCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId2, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };
    v_CellPowerList_AtT2 :=
    {//@sic R5-202530, R5s201154, R5-203503, R5-234560 sic@
        cs_NR_CellPower(p_SCellId, -82, tsc_NR_ServingCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId1, -78, tsc_NR_ServingCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId2, -82, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };
             
    v_CellPowerList_AtT3 :=
    {//@sic R5-201477, R5s201154, R5-203503, R5-232510, R5-234560 sic@
        cs_NR_CellPower(nr_Cell1, -98, tsc_NR_NonSuitableCellSSS_EPRE_FR2),
        cs_NR_CellPower(p_NeigbourCellId2, -85, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };
             
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message including sCellToAddModList with NR Cell 3 as SCell addition.
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR5GC_AddMod_1SCell( nr_Cell1, p_SCellId);
      
    //@siclog "Steps 3-4" siclog@
    //The SS transmits an RRCReconfiguration message including measConfig to setup intra NR measurement and for event A2 reporting configuration and include reportAddNeighMeas
    //The UE transmits an RRCReconfigrationComplete message.
    v_Deltas := f_NR_MobileInfo_GetPrimaryDeltaValue(); //@sic R5-234560 sic@
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        v_RsrpThres := 67;    //@sic R5-201477 sic@
    }
    else
    {
        v_RsrpThres := 66 + v_Deltas.DeltaNRf1;  //@sic R5-234560 sic@
    }
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, -, 2),
                             cs_MeasObjectId2(p_SCellId, -, 2)};
    //Table 8.1.3.1.18.1.3.3-6
    v_ReportConfig := cs_NR_ReportConfigEventA2(tsc_NR_IdReportConfigId1, v_RsrpThres, r1, -, -, cs_NR_MeasReportQuantity_Rsrp);  //@sic R5s200734 sic@
    v_ReportConfig.reportConfig.reportConfigNR.reportType.eventTriggered.reportAddNeighMeas := setup;
    v_ReportConfigList := {v_ReportConfig};
    
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1,
                           cs_NR_MeasId_Config_id2_obj2_conf1}

    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);

    f_NR_SendRRCReconfiguration_MeasNR(nr_Cell1, v_MeasConfig, tsc_NR_MeasObjectId2, -, -, -, -, crs_MacBearerRouting(nr_Cell1));  //@sic R5-213516 sic@
      
    //@siclog "Step 5" siclog@
    //The SS re-adjusts the SS/PBCH EPRE level according to row "T1" in table 8.1.3.1.18.1.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
     
    //@siclog "Step 6" siclog@
    //Check: Does the UE transmit a MeasurementReport message that does not include the RSRP value of the best non-serving cell on the concerned serving frequency in measResultBestNeighCell?
    v_PhysCellId_SpCell := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellId_SCell := f_NR_CellInfo_GetPhysicalCellId(p_SCellId);
    f_NR_ReceiveMeasurementReports(nr_Cell1,
                                  v_PhysCellId_SpCell,
                                  tsc_NR_MeasId2,
                                  1, // 1 report
                                  -, // no interval
                                  -, //no neighbouring cells
                                  true, //SRB1
                                  v_PhysCellId_SCell,
                                  -, -, -, -,
                                  crs_MacBearerRouting(nr_Cell1)   //@sic R5-213516 sic@
                                  ); //@sic R5-204437, R5-211389 sic@
    
      
    //@siclog "Step 7" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T2" in table 8.1.3.1.18.1.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);
     
    //@siclog "Step 7A" siclog@
    //30 seconds after step 7, SS re-adjusts the cell-specific reference signal level according to row "T3" in table 8.1.3.1.18.1.3.2-1/2
    //@sic R5-202530, R5s200734, R5-213473, R5s210523 sic@
    f_Delay(30.0);
    f_NR_SetCellPowerList(v_CellPowerList_AtT3);

      
      
    //@siclog "Step 8" siclog@
    //Check: Check: Does the UE transmit a MeasurementReport message included the RSRP value of the best non-serving cell (NR Cell 12) on the concerned serving frequency in measResultBestNeighCell?
    v_PhysCellId_Neighbour := f_NR_CellInfo_GetPhysicalCellId(p_NeigbourCellId1);
    v_MeasResultBestNeighCell_SCell := cr_NR_MeasResultNR_CellResults(v_PhysCellId_Neighbour, cr_NR_MeasQuantityResults_Rsrp);
    f_NR_ReceiveMeasurementReports(nr_Cell1,
                                  v_PhysCellId_SpCell,
                                  tsc_NR_MeasId1,
                                  1, // 1 report
                                  -, // no interval
                                  -, //no neighbouring cells
                                  true, //SRB1
                                  v_PhysCellId_SCell,
                                  -,    //@sic R5s200734 sic@
                                  omit, // MeasResultBestNeighCell PCell
                                  v_MeasResultBestNeighCell_SCell,
                                  -,
                                  crs_MacBearerRouting(nr_Cell1)   //@sic R5-213516 sic@
                                  ); //@sic R5-204437, R5-211389 sic@

    f_NR5GC_Rel_1SCell(nr_Cell1, p_SCellId);   //Release CA so that MAC bearer routing is disabled @sic R5-213516 R5-214614 sic@
      
  }//End of fl_TC_8_1_3_1_18_x_TestBody

}
