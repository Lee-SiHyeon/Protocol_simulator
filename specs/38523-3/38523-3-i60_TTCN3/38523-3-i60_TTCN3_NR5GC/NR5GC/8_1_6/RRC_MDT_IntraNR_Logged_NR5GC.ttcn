      }
    }
    //@siclog "Step14a" siclog@
    //@sic R5s220180 sic@
    if (isvalue (v_ReceivedAsp.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ueInformationResponse_r16.criticalExtensions.ueInformationResponse_r16.logMeasReport_r16.logMeasAvailable_r16))
    {
         SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1,
