module UTRAN_IP_Component {

  import from CommonDefs all;
  import from IP_PTC_CtrlMsgs all;
  import from UTRAN_Component all;

  type component UTRAN_IP_PTC extends UTRAN_PTC {             /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT, POS, UTRAN) */
    var UTRAN_Global_IP_Type vc_UTRAN_Global_IP;
    port IP_RAT_CTRL_PORT       IP;
  };

  type record UTRAN_PDP_Info_Type { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT, POS, UTRAN)
                                       @sic R5-160730 sic@ */
    boolean             Active,
    PDN_Index_Type      PDN_Id  optional
  };

  type record of UTRAN_PDP_Info_Type UTRAN_PDP_InfoList_Type;  /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT, POS, UTRAN)
                                                                  assume max of 2 PDP contexts */

  type record UTRAN_Global_IP_Type { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT, POS, UTRAN) */
    integer                  NoOfPDPContexts,
    UTRAN_PDP_InfoList_Type  PDPInfo    optional
  };

  /*
   * @desc      to get the no of configured PDP contexts
   * @return    integer
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS)
   */
  function f_UTRAN_Global_IP_NoOfPDPContexts_Get() runs on UTRAN_IP_PTC return integer
  {
    return vc_UTRAN_Global_IP.NoOfPDPContexts;
  }

}
