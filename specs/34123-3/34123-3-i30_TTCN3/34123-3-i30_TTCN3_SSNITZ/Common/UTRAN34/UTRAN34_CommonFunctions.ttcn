    f_UTRAN_SysInfo_Set(p_CellId, v_CellSysInfo);
  }

  /*
   * @desc      Sends SIB12 only - Using default scheduling configuration 1 in 34.108
   * @param     p_CellId
   * @param     p_Timing
   * @param     p_Repetition
   * @param     p_RatType
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SendSIB12(UTRAN_CellId_Type p_CellId,
                               integer           p_Timing,
                               integer           p_Repetition,
                               RatType           p_RatType) runs on UTRAN_PTC
  { //@sic R5s140912 sic@
    var UTRAN_CellSysInfo_Type v_CellSysInfo := f_UTRAN_SysInfo_Get(p_CellId);
    var template (value) UTRAN_SIB_BCCH_BCH_Messages_Type v_SIB_BCCH_BCH_Msg;
    var SegmentsOfSysInfoBlock v_Segments;
    var integer v_Pos[3];
    var template (value) SchedulingInformation v_SchedulingInfo_SB1;
    
    v_Segments := f_UTRAN_SIB_Bitstring_Segmentation(encvalue(v_CellSysInfo.SIB12));
    
    v_Pos[0] := 13;
    v_Pos[1] := 14;
    v_Pos[2] := 15;
    v_SIB_BCCH_BCH_Msg := f_UTRAN_SIB_Segmentation(systemInformationBlockType12, v_Segments, 3);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[0], v_SIB_BCCH_BCH_Msg.Seg1, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[1], v_SIB_BCCH_BCH_Msg.Seg2, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[2], v_SIB_BCCH_BCH_Msg.Seg3, p_Timing, p_RatType);
    
    if (v_Segments.segCount == 1) {
      v_SchedulingInfo_SB1 := cs_SIB12_Schedul1;
    } else if (v_Segments.segCount == 2) {
      v_SchedulingInfo_SB1 := cs_SIB12_Schedul2;
    } else if (v_Segments.segCount == 3) {
      v_SchedulingInfo_SB1 := cs_SIB12_Schedul3;
    } else {
      FatalError(__FILE__, __LINE__,"sib11: more than 3 segments");
    }
    
    v_CellSysInfo.SB1.sib_ReferenceList[3].scheduling := valueof(v_SchedulingInfo_SB1);
    v_CellSysInfo := f_UTRAN_SIB_ChangeValueTag(v_CellSysInfo, systemInformationBlockType12);
    v_CellSysInfo := f_UTRAN_SB1_ChangeValueTag(v_CellSysInfo);
    f_UTRAN_SysInfo_Set(p_CellId, v_CellSysInfo);
  }

  /*
   * @desc      Sends SIB12 only - Using default scheduling configuration 8 in 34.108
   * @param     p_CellId
   * @param     p_Timing
   * @param     p_Repetition
   * @param     p_RatType
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SendSIB12_LongSIB5(UTRAN_CellId_Type p_CellId,
                                        integer           p_Timing,
                                        integer           p_Repetition,
                                        RatType           p_RatType) runs on UTRAN_PTC
  {
    var UTRAN_CellSysInfo_Type v_CellSysInfo := f_UTRAN_SysInfo_Get(p_CellId);
    var template (value) UTRAN_SIB_BCCH_BCH_Messages_Type v_SIB_BCCH_BCH_Msg;
    var SegmentsOfSysInfoBlock v_Segments;
    var integer v_Pos[2];
    var template (value) SchedulingInformation v_SchedulingInfo_SB1;
    
    v_Segments := f_UTRAN_SIB_Bitstring_Segmentation(encvalue(v_CellSysInfo.SIB12));
    
    v_Pos[0] := 13;
    v_Pos[1] := 14;
    v_SIB_BCCH_BCH_Msg := f_UTRAN_SIB_Segmentation(systemInformationBlockType12, v_Segments, 2);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[0], v_SIB_BCCH_BCH_Msg.Seg1, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[1], v_SIB_BCCH_BCH_Msg.Seg2, p_Timing, p_RatType);
    
    if (v_Segments.segCount == 1) {
      v_SchedulingInfo_SB1 := cs_SIB12_Schedul1;
    } else if (v_Segments.segCount == 2) {
      v_SchedulingInfo_SB1 := cs_SIB12_Schedul2;
    } else {
      FatalError(__FILE__, __LINE__,"sib11: more than 2 segments");
    }
    
    v_CellSysInfo.SB1.sib_ReferenceList[3].scheduling := valueof(v_SchedulingInfo_SB1);
    v_CellSysInfo := f_UTRAN_SIB_ChangeValueTag(v_CellSysInfo, systemInformationBlockType12);
    v_CellSysInfo := f_UTRAN_SB1_ChangeValueTag(v_CellSysInfo);
    f_UTRAN_SysInfo_Set(p_CellId, v_CellSysInfo);
  }

  /*
   * @desc      Sends SIB5 only - Using default scheduling configuration 8 in 34.108
   * @param     p_CellId
   * @param     p_SIB_Type
   * @param     p_Timing
   * @param     p_Repetition
   * @param     p_RatType
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SendSIB5_LongSIB5(UTRAN_CellId_Type p_CellId,
                                       SIB_Type          p_SIB_Type, // systemInformationBlockType5 or systemInformationBlockType5bis
                                       integer           p_Timing,
                                       integer           p_Repetition,
                                       RatType           p_RatType) runs on UTRAN_PTC
  {
    var UTRAN_CellSysInfo_Type v_CellSysInfo := f_UTRAN_SysInfo_Get(p_CellId);
    var template (value) UTRAN_SIB_BCCH_BCH_Messages_Type v_SIB_BCCH_BCH_Msg;
    var SegmentsOfSysInfoBlock v_Segments;
    var integer v_Pos[6];
    var template (value) SchedulingInformation v_SchedulingInfo[6];
    var template (value) SchedulingInformation v_SchedulingInfo_MIB;
    
    if ((p_SIB_Type != systemInformationBlockType5) and (p_SIB_Type != systemInformationBlockType5bis)) {
      FatalError(__FILE__, __LINE__,"invalid SIB Type");
    }
    v_Pos[0] := 15;
    v_Pos[1] := 19;
    v_Pos[2] := 21;
    v_Pos[3] := 22;
    v_Pos[4] := 23;
    v_Pos[5] := 27;
    v_SchedulingInfo[0] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 1);
    v_SchedulingInfo[1] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 2, {so8});
    v_SchedulingInfo[2] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 3, {so8, so4});
    v_SchedulingInfo[3] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 4, {so8, so4, so2});
    v_SchedulingInfo[4] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 5, {so8, so4, so2, so2});
    v_SchedulingInfo[5] := cs_SchedulingInformation( cs_SIB_Pos_Rep64(15), 6, {so8, so4, so2, so2, so8});
    
    v_Segments := f_UTRAN_SIB_Bitstring_Segmentation(encvalue(v_CellSysInfo.SIB5));
    v_SIB_BCCH_BCH_Msg := f_UTRAN_SIB_Segmentation(p_SIB_Type, v_Segments, 4);
    
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[0], v_SIB_BCCH_BCH_Msg.Seg1, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[1], v_SIB_BCCH_BCH_Msg.Seg2, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[2], v_SIB_BCCH_BCH_Msg.Seg3, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[3], v_SIB_BCCH_BCH_Msg.Seg4, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[4], v_SIB_BCCH_BCH_Msg.Seg5, p_Timing, p_RatType);
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, p_Repetition, v_Pos[5], v_SIB_BCCH_BCH_Msg.Seg6, p_Timing, p_RatType);
    
    if (v_Segments.segCount == 1) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[0];
    } else if (v_Segments.segCount == 2) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[1];
    } else if (v_Segments.segCount == 3) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[2];
    } else if (v_Segments.segCount == 4) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[3];
    } else if (v_Segments.segCount == 5) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[4];
    } else if (v_Segments.segCount == 6) {
      v_SchedulingInfo_MIB := v_SchedulingInfo[5];
    } else {
      FatalError(__FILE__, __LINE__,"sib5: more than 4 segments");
    }
    
    v_CellSysInfo.MIB.sibSb_ReferenceList[5].scheduling := valueof(v_SchedulingInfo_MIB);
    
    v_CellSysInfo := f_UTRAN_SIB_ChangeValueTag(v_CellSysInfo, p_SIB_Type);
    v_CellSysInfo := fl_UTRAN_MIB_ChangeValueTag(v_CellSysInfo);
    f_UTRAN_SysInfo_Set(p_CellId, v_CellSysInfo);
  }

  /*
   * @desc      Procedure to bring UE, depending on PS/CS and Operation mode of UE, in to a state
   *            Registered, Idle Mode (state 2) on an UTRAN cell.
   *            Handle all releases
   * @param     p_CellId
   * @param     p_EPLMN             (default value: omit)
   * @param     p_EstCause          (default value: registration)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_IdleUpdated(UTRAN_CellId_Type p_CellId,
                                 template (omit) PLMN_List p_EPLMN := omit,  //@sic R5-134916 sic@
                                 template (present) EstablishmentCause p_EstCause := registration) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);  // Updated in RRC Conn Est
    
    if (pc_CS and not pc_PS) {
      f_UTRAN34_RRC_ConnEst(p_CellId, p_EstCause); // Establish RRC connection
      f_UTRAN34_LocationUpdate(p_CellId, true, -, -, -, p_EPLMN); // @sic R5s150830 sic@
      select (v_CellConfig) {
        case (cell_FACH) {
          f_UTRAN34_RRC_ConnRel(p_CellId,cell_Fach_Dcch);
        }
        case else {
          f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch);
        }
      }
    } else { // PS only or PS and CS
      f_UTRAN34_GMMOnly_Attach(p_CellId, p_EPLMN, p_EstCause);
    }
  }

  /*
   * @desc      Perform the Location Updating procedure including activation of Security
   *            Handle all releases
   * @param     p_CellId
   * @param     p_DoAuth            (default value: false)
   * @param     p_LocAcceptType     (default value: TMSI)
   * @param     p_U_LocationUpdatingRequest (default value: cr_U_LocationUpdatingRequest)
   * @param     p_RRC_DataInd       (default value: omit)
   * @param     p_EPLMN             (default value: omit)
   * @param     p_U_MmInformation   (default value: omit)
   * @param     p_GPRS_Timer3       (default value: omit)
   * @return    B1_Type
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_LocationUpdate(UTRAN_CellId_Type p_CellId,
                                    boolean p_DoAuth := false,
                                    LOCATION_UPDATE_ACCEPT_TYPE p_LocAcceptType := TMSI,
                                    template (present) RRCDataIndType p_U_LocationUpdatingRequest := cr_U_LocationUpdatingRequest,
                                    template (omit) RRC_DATA_IND p_RRC_DataInd := omit, // @sic R5s150830 sic@
                                    template (omit) PLMN_List p_EPLMN := omit,
                                    template (omit) RRCDataReqType p_U_MmInformation := omit,
                                    template (omit) GPRS_Timer3 p_GPRS_Timer3 := omit) //@sic R5s15676 change 4.6 sic@
    runs on UTRAN_PTC return B1_Type
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var B1_Type v_FollowOnRequest;
    
    if (ispresent(p_RRC_DataInd)) {
      v_RRC_DataInd := valueof(p_RRC_DataInd);
    } else {
    //Receive Location Updating Request message
      U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated, tsc_RB3, p_U_LocationUpdatingRequest)) -> value v_RRC_DataInd;
    }
    v_START_Value := v_RRC_DataInd.ttcn_start;
    v_FollowOnRequest := v_RRC_DataInd.msg.locationUpdatingRequest.locUpdType.fOR;
    f_UTRAN34_LocationUpdate_WithoutLAUReq(p_CellId, v_START_Value, p_DoAuth, p_LocAcceptType, p_EPLMN, p_U_MmInformation, p_GPRS_Timer3);
    return v_FollowOnRequest;
  }

  /*
   * @desc      Perform the Location Updating procedure including activation of Security, after the LAU
   *            UTRAN34: Handle all releases
   *            UTRAN34: When p_U_MmInformation is present, the MM INFORMATION PDU is sent to UE
   * @param     p_CellId
   * @param     p_START_Value       (default value: '00000000000000000000'B)
   * @param     p_DoAuth            (default value: false)
   * @param     p_LocAcceptType     (default value: TMSI)
   * @param     p_EPLMN             (default value: omit)
   * @param     p_U_MmInformation   (default value: omit)
   * @param     p_GPRS_Timer3       (default value: omit)
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_LocationUpdate_WithoutLAUReq(UTRAN_CellId_Type p_CellId,
                                                  START_Value p_START_Value := '00000000000000000000'B,
                                                  boolean p_DoAuth := false,
                                                  LOCATION_UPDATE_ACCEPT_TYPE p_LocAcceptType := TMSI,
                                                  template (omit) PLMN_List p_EPLMN := omit, //@sic R5-134916 sic@
                                                  template (omit) RRCDataReqType p_U_MmInformation := omit,
                                                  template (omit) GPRS_Timer3 p_GPRS_Timer3 := omit)   //@sic R5s15676 change 4.6 sic@
    runs on UTRAN_PTC
  {
    var octetstring v_PLMN := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
    var octetstring v_LAC := f_UTRAN_CellInfo_GetLAC(p_CellId);
    var boolean v_NewKeyFlag := false;//No new key generation
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var template (value) MobileIdentity v_MobileIdIMSI := f_Imsi2MobileIdentity(px_IMSI_Def);
    v_MobileIdIMSI.iei := '17'O; // Need to include iei in LUAccept, but function returns without iei
    
    // Store flag to be sent to LTE later;
    v_SecurityInfo.authKeys.CSinOtherRAT := true;
    v_SecurityInfo.start_CS := p_START_Value; // @sic R5-153968 sic@
    f_UTRAN_Security_Set (v_SecurityInfo);
    
    if (p_DoAuth) {
      f_UTRAN_MM_Authentication ();
      v_NewKeyFlag := true;
    }
    
    //Send SECURITY MODE COMMAND and receive SECURITY MODE COMPLETE
    f_UTRAN34_RRC_Security(p_CellId, v_NewKeyFlag, cs_domain);
    
    // Send MM Information to the UE during LAU procedure
    if (isvalue (p_U_MmInformation)) {
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               valueof(p_U_MmInformation)));
    }
    
    //Send Location Updating Accept message
    select (p_LocAcceptType) {
      case (TMSI) {
        U_Dc.send (cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_LocUpdAcpTMSI (v_PLMN, v_LAC, p_EPLMN, p_GPRS_Timer3))); //@sic R5s15676 change 4.6 sic@
        //Receive TMSI Reallocation Complete
        U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_TMSI_ReallocCmpl));
      }
      case (IMSI) {
        U_Dc.send (cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_LocUpdAcpIMSI (v_PLMN, v_LAC, v_MobileIdIMSI, p_EPLMN)));
      }
      case (NONE) {
        U_Dc.send (cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_LocUpdAcp_NoMobId (v_PLMN, v_LAC, p_EPLMN)));
      }
    }
  }

  /*
   * @desc      Complete GMM_IdleUpdated handling NMO I and II, Operation Mode A and Automatic Switch On
   *            UTRAN34: Handle all releases + additional parameters
   * @param     p_CellId
   * @param     p_EPLMN             (default value: omit)
   * @param     p_EstCause          (default value: registration)
   * @param     p_U_MmInformation   (default value: omit)
   * @param     p_U_GmmInformation  (default value: omit)
   * @param     p_PTMSI_Def         (default value: px_PTMSI_Def)
   * @param     p_PTMSI_SigDef      (default value: px_PTMSI_SigDef)
   * @param     p_SendPTMSI         (default value: true)
   * @param     p_RAI_Rcd           (default value: cr_RAI)
   * @param     p_FOP               (default value: tsc_FOP_FollowOnProceed)
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_GMMOnly_Attach(UTRAN_CellId_Type p_CellId,
                                    template (omit) PLMN_List p_EPLMN := omit,  //@sic R5-134916 sic@
                                    template (present) EstablishmentCause p_EstCause := registration,
                                    template (omit) RRCDataReqType p_U_MmInformation := omit,
                                    template (omit) RRCDataReqType p_U_GmmInformation := omit,
                                    octetstring p_PTMSI_Def := px_PTMSI_Def,
                                    octetstring p_PTMSI_SigDef := px_PTMSI_SigDef,
                                    boolean p_SendPTMSI := true,
                                    template (present) RoutingAreaId p_RAI_Rcd := cr_RAI,
                                    B1_Type  p_FOP := tsc_FOP_FollowOnProceed)     //Follow-on proceed
    runs on UTRAN_PTC
  {
    f_UTRAN34_RRC_ConnEst(p_CellId, p_EstCause); // Establish RRC connection
    f_UTRAN34_GMMOnly_Attach_WithoutRRCConnection(p_CellId, p_EPLMN, -, p_U_MmInformation, p_U_GmmInformation, p_PTMSI_Def, p_PTMSI_SigDef, p_SendPTMSI, p_RAI_Rcd, p_FOP);
  }

  /*
   * @desc      Complete GMM_IdleUpdated handling NMO I and II without RRC connection establishment, Operation Mode A and Automatic Switch On
   *            UTRAN34: Handle all releases + additional parameters
   * @param     p_CellId
   * @param     p_EPLMN             (default value: omit)
   * @param     p_EstCause          (default value: registration)
   * @param     p_U_MmInformation   (default value: omit)
   * @param     p_U_GmmInformation  (default value: omit)
   * @param     p_PTMSI_Def         (default value: px_PTMSI_Def)
   * @param     p_PTMSI_SigDef      (default value: px_PTMSI_SigDef)
   * @param     p_SendPTMSI         (default value: true)
   * @param     p_RAI_Rcd           (default value: cr_RAI)
   * @param     p_FOP               (default value: tsc_FOP_FollowOnProceed)
   * @param     p_LocAcceptType     (default value: TMSI)
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_GMMOnly_Attach_WithoutRRCConnection(UTRAN_CellId_Type p_CellId,
                                                         template (omit) PLMN_List p_EPLMN := omit,  //@sic R5-134916 sic@
                                                         template (present) EstablishmentCause p_EstCause := registration,
                                                         template (omit) RRCDataReqType p_U_MmInformation := omit,
                                                         template (omit) RRCDataReqType p_U_GmmInformation := omit,
                                                         octetstring p_PTMSI_Def := px_PTMSI_Def,
                                                         octetstring p_PTMSI_SigDef := px_PTMSI_SigDef,
                                                         boolean p_SendPTMSI := true,
                                                         template (present) RoutingAreaId p_RAI_Rcd := cr_RAI,
                                                         B1_Type  p_FOP := tsc_FOP_FollowOnProceed,
                                                         LOCATION_UPDATE_ACCEPT_TYPE p_LocAcceptType := TMSI  //@sic R5s150611 change 4.5 sic@
                                                         ) runs on UTRAN_PTC
  {
    var START_Value v_START_Value_ps := '00000000000000000000'B;
    var START_Value v_START_Value_cs := '00000000000000000000'B;
    var RB_ConfigType v_CellConfig;
    var RRC_DATA_IND v_RRC_DataInd;
    var boolean v_NewKeyFlag := true;
    var B2_Type v_NMO := f_UTRAN_CellInfo_GetNMO(p_CellId);
    
    v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);  // Updated in RRC Conn Est
    
    alt {
      [] U_Dc.receive(car_PS_InitDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U34_AttachReq(cr_AttachType(?, (tsc_I_AttachTypeGPRSAtt, tsc_I_AttachTypeCombined)), -, p_RAI_Rcd))) // @sic R5s130477 sic@
        -> value v_RRC_DataInd {
        v_START_Value_ps := v_RRC_DataInd.ttcn_start;
        f_UTRAN_SS_SecurityDownloadStart(ps_domain, v_START_Value_ps);
      }
      [ pc_SupportOpModeA and ((v_NMO == tsc_NMO_II) or not pc_AutomaticAttachSwitchON)] U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_LocationUpdatingRequest))
        -> value v_RRC_DataInd {
        v_START_Value_cs := v_RRC_DataInd.ttcn_start;
        f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value_cs);
        
        if ((v_NMO == tsc_NMO_II) and  pc_AutomaticAttachSwitchON) { // need to wait for Attach Req before finishing LAU
          U_Dc.receive(car_PS_InitDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U34_AttachReq(cr_AttachType(?, (tsc_I_AttachTypeGPRSAtt, tsc_I_AttachTypeCombined)), -, p_RAI_Rcd))) // @sic R5s130477 sic@
            -> value v_RRC_DataInd;
          v_START_Value_ps := v_RRC_DataInd.ttcn_start;
          f_UTRAN_SS_SecurityDownloadStart(ps_domain, v_START_Value_ps);
          // include MM information to be sent to the UE during LAU procedure
          f_UTRAN34_LocationUpdate_WithoutLAUReq(p_CellId, v_START_Value_cs, true, p_LocAcceptType, p_EPLMN, p_U_MmInformation); //@sic R5s150611 change 4.5 sic@
        } else { // else finish LAU first
          // include MM information to be sent to the UE during LAU procedure
          f_UTRAN34_LocationUpdate_WithoutLAUReq(p_CellId, v_START_Value_cs, true, p_LocAcceptType, p_EPLMN, p_U_MmInformation); //@sic R5s150611 change 4.5 sic@
          // then trigger the Attach Req
          select (v_CellConfig) {
            case (cell_FACH) {
              f_UTRAN34_RRC_ConnRel(p_CellId, cell_Fach_Dcch);
            }
            case else {
              f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch);
            }
          }
          f_Delay (1.0);
          f_UT_TriggerAttach(UT);
          f_UTRAN34_RRC_ConnEst(p_CellId, p_EstCause); // Establish RRC connection
          
          U_Dc.receive(car_PS_InitDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U34_AttachReq(cr_AttachType(?, (tsc_I_AttachTypeGPRSAtt, tsc_I_AttachTypeCombined)), -, p_RAI_Rcd))) // @sic R5s130477 sic@
            -> value v_RRC_DataInd;
          v_START_Value_ps := v_RRC_DataInd.ttcn_start;
          f_UTRAN_SS_SecurityDownloadStart(ps_domain, v_START_Value_ps);
        }
      }
    }
    f_UTRAN_GMM_Authentication();
    f_UTRAN34_RRC_Security(p_CellId,                        // SECURITY MODE COMMAND, SECURITY MODE COMPLETE
                           v_NewKeyFlag,
                           ps_domain);

    // ATTACH ACCEPT, ATTACH COMPLETE
    f_UTRAN34_AttachAccept(p_CellId, v_RRC_DataInd.msg.attachRequest.attachType.attachType, p_PTMSI_Def, p_PTMSI_SigDef, -, -, -, -, -, p_SendPTMSI, p_EPLMN, p_FOP);
    
    // Send GMM information to the UE after Attach procedure
    if (isvalue (p_U_GmmInformation)) {
      U_Dc.send(cas_DataReq_PS (utran_CellDedicated,   //@sic R5s150611 R5s150613 sic@
                               tsc_RB3,
                               valueof(p_U_GmmInformation)));
    }

    select (v_CellConfig) {
      case (cell_FACH) {
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Fach_Dcch);
      }
      case else {
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch);
      }
    }
  }

  /*
   * @desc      Local function to initiate MO call
   *            Returns EstablishmentCause to be used in RRC Connection establishment procedure
   * @param     p_CN_Domain         (default value: px_CN_DomainTested)
   * @param     p_ForceSpeechCall   (default value: false)
   * @return    template (present) EstablishmentCause
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_TriggerOutgoingCallProcedure(CN_DomainIdentity p_CN_Domain := px_CN_DomainTested,
                                                  boolean p_ForceSpeechCall := false)
    runs on UTRAN_PTC return template (present) EstablishmentCause
  {
    var template (present) EstablishmentCause v_EstCause;
    var template (value) QualityOfService v_QualityOfService;
    var integer v_DedicatedId := 1;
    
    if (p_CN_Domain == cs_domain) {   // CS domain
      if (pc_Speech or pc_Streaming or pc_Conversational or p_ForceSpeechCall) { // @sic R5-140683 sic@
        if(pc_Streaming and (not (pc_Speech or pc_Conversational))){
            f_UT_RequestCSCall(UT, -, true); //@sic R5s150980 sic@
            v_EstCause := originatingConversationalCall;
        }   else    {
            f_UT_RequestCSCall(UT);
            v_EstCause := originatingConversationalCall;
        }
      } else if (pc_EmergSpeech){
        f_UT_RequestCSCall (UT, px_EmergencyCallNumber);
        v_EstCause := emergencyCall;
      } else if (pc_NonCallRelSS) {
        f_UT_RequestNonCallRelatedSS (UT);
      } else if (pc_SMS_CS_MO){
        // Sending of a 160 character MO SMS is initiated at the UE via MMI or  AT command
        if (px_SMS_MsgFrmt=="1") { // @sic R5s110751 sic@
          // Set text mode parameters to trigger status report.
          // bit 7(RP) 6(UDHI) 5(SRR) 4 3(VPF) 2(RD) 1 0(MIT)
          //     0     0       1      1 0      0     0 1
          f_UTRAN34_SMS_AT_CSMP(49, 167, 0);  // @sic R5s100773 sic@
          // Write message to memory storage
          f_UTRAN34_SMS_AT_CMGW_Text("""1111111111""", 129, tsc_Fox);
          v_EstCause := originatingConversationalCall;
        } else { // PDU mode
          // Write message to memory storage
          f_UTRAN34_SMS_AT_CMGW_PDU(153, tsc_Fox_PDU);
          v_EstCause := originatingConversationalCall;
        }
        // Send message from storage.
        f_UTRAN34_SMS_AT_CMSS(px_SMS_IndexOffset);
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "CS service not supported");
      }
    } else {  // PS domain
      //Init QoS and PDN Address parameters only if PS RAB is to be configured
      v_EstCause := f_GetMoEstCause();
      f_UG_GetPktDataProtoAddr (true);
            v_QualityOfService := f_UTRAN_InitialiseQoS (utran34_Cell1, cell_DCH_64kPS_RAB_SRB);
      //Initiate an outgoing PS call
      f_UT_ActivatePDPContextUG (UT, v_DedicatedId, f_ConvertQoS_ForATCommand(v_QualityOfService), tsc_RandomAPN); // @sic R5s160680, R5-192186 sic@
    }
    
    return v_EstCause;
  }

  /*
   * @desc      Check result of an SMS AT command
   * @param     p_ResultString
   * @param     p_ExpectedStartString
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function fl_UTRAN34_SMS_CheckResultString(charstring p_ResultString,
                                            charstring p_ExpectedStartString)  runs on UTRAN_PTC
  {
    if (not f_CheckStringStartWith (p_ResultString, p_ExpectedStartString)) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "The AT CMD results in an error.");
    }
  }

  /*
   * @desc      Transmission of AT Command CSMP
   * @param     p_Fo
   * @param     p_Vp
   * @param     p_Pid
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SMS_AT_CSMP(integer p_Fo,
                                 integer p_Vp,
                                 integer p_Pid) runs on UTRAN_PTC
  {
    var charstring v_ResultStr := f_UT_SetTextModeParameters(UT, p_Fo, p_Vp, p_Pid);
    fl_UTRAN34_SMS_CheckResultString(v_ResultStr, tsc_AT_ResultOK);
  }

  /*
   * @desc      Transmission of AT Command CMGW (Text Mode)
   * @param     p_Da
   * @param     p_Toda
   * @param     p_Text
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SMS_AT_CMGW_Text(charstring p_Da,
                                      integer p_Toda,
                                      charstring p_Text) runs on UTRAN_PTC
  {
    var charstring v_ResultStr := f_UT_WriteMessageToMemoryText(UT, p_Da, int2str(p_Toda), p_Text);
    fl_UTRAN34_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CMGW:");
  }

  /*
   * @desc      Transmission of AT Command CMGW (PDU Mode)
   * @param     p_Len
   * @param     p_Text
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SMS_AT_CMGW_PDU(integer p_Len,
                                     charstring p_Text) runs on UTRAN_PTC
  {
    var charstring v_ResultStr := f_UT_WriteMessageToMemoryPDU(UT, int2str(p_Len), p_Text);
    fl_UTRAN34_SMS_CheckResultString(v_ResultStr, "<CR><LF>+CMGW:");
  }

  /*
   * @desc      Transmission of AT Command CMSS
   * @param     p_Index
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SMS_AT_CMSS(integer p_Index) runs on UTRAN_PTC
  {
    f_UT_SendStoredOneMessage(UT, p_Index);
  }

  /*
   * @desc      Function to set the postamble conditions based on the UTRA CS/PS domain support
   * @param     p_DetachType
   * @return    UTRA_POSTAMBLE_CONDITIONS
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SetPostambleCondition(UTRAN34_DETACH_Type p_DetachType) return UTRA_POSTAMBLE_CONDITIONS // @sic R5s150247 sic@
  {
    var UTRA_POSTAMBLE_CONDITIONS v_UTRA_POSTAMBLE_CONDITION := UTRA_C1;
    
    select (p_DetachType) {
      case (IMSI_DetachOnly) { // @sic R5s150247 sic@
        v_UTRA_POSTAMBLE_CONDITION := UTRA_C4;
      }
      case (GPRS_Attached) { // As we don't check the Detach Request, doesn't matter if UE supports CS or not
        v_UTRA_POSTAMBLE_CONDITION := UTRA_C1;
      }
      case (NotSpecified) {
        if (pc_CS and not pc_PS) {
          v_UTRA_POSTAMBLE_CONDITION := UTRA_C4;
        } else if (pc_PS and not pc_CS) {
          v_UTRA_POSTAMBLE_CONDITION := UTRA_C2;
        }
      }
    }
    return v_UTRA_POSTAMBLE_CONDITION;
  }

  /*
   * @desc      Brings UE from UTRA idle (U1) state or UTRA connected (U2) state to UTRA State Off
   *            This procedure is different to 36.523-3 cl. 10.1.2 (this procedure releases RRC connection before switching off if UE is connected)
   * @param     p_CellId
   * @param     p_Utra_Connection_State
   * @param     p_DetachType        (default value: NotSpecified)
   * @param     p_USIM_Rmvd         (default value: false)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_SwitchPower_Off(UTRAN_CellId_Type         p_CellId,
                                     UTRA_CONNECTION_STATE_Type p_Utra_Connection_State, // @sic R5s150895 sic@
                                     UTRAN34_DETACH_Type p_DetachType := NotSpecified, // @sic R5s150247 sic@
                                     boolean p_USIM_Rmvd := false) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    var UTRA_POSTAMBLE_CONDITIONS v_Utra_Postamble_Condition := f_UTRAN34_SetPostambleCondition(p_DetachType); // @sic R5s141390, R5s150247 sic@
    var RRC_Rel_Status v_RRC_Rel_Status := cell_Dch;
                                                      
    if (v_CellConfig == cell_FACH or v_CellConfig == cell_FACH_NoConn) {
      v_RRC_Rel_Status := cell_Fach_Dcch;
    }
    
    //Step 1: The UE can be switched off or USIM removed
    if (pc_SwitchOnOff or p_USIM_Rmvd and pc_USIM_Removal) { // @sic R5s120597r1 sic@
      if (p_Utra_Connection_State == U2_CONNECTED) { // @sic R5s140611, R5s150895 sic@
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch);
      }
      //Step 1: The UE is switched off
      f_UT_SwitchOffUE(UT, p_USIM_Rmvd);
      
      //Step 2-4: RRC Connection establishment as UE is always in UTRA idle end state
      f_UTRAN34_RRC_ConnEst(p_CellId, detach);
      a_UTRAN_UE_DetachAfterSwitchOff_Common(p_CellId, v_Utra_Postamble_Condition);   // @sic R5s150895 sic@

      //Step 6-7: Release RRC connection when the UE has been switched off
      f_UTRAN34_RRC_ConnRel_AfterSwitchOff(p_CellId, v_RRC_Rel_Status);
    }
    //Step 1: The power must be removed from the UE
    else {
      f_UT_PowerOffUE (UT);
    }
  } // f_UTRAN34_SwitchPower_Off

  /*
   * @desc      Function to bring UE to switched/powered off state after test case execution in UTRA PTC
   *            This procedure is according to 36.523-3 cl. 10.1
   * @param     p_CellId
   * @param     p_UTRA_POSTAMBLE_STATE - as defined in 36.508 cl. 6.4.3A.2
   * @param     p_DetachType        (default value: NotSpecified)
   * @param     p_TI_S              (default value: cs_TI_MO)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_Postamble(UTRAN_CellId_Type         p_CellId,
                               UTRA_POSTAMBLE_STATE_Type p_UTRA_POSTAMBLE_STATE,
                               UTRAN34_DETACH_Type p_DetachType := NotSpecified, /// @sic R5s150247 sic@
                               template (value) TI  p_TI_S:= cs_TI_MO) runs on UTRAN_PTC //@sic R5s120086 sic@
  { // @sic R5s150599 use all UTRAN34_ sic@
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    
    select (p_UTRA_POSTAMBLE_STATE) {
      case (U1_IDLE) {
        //Switch/Power off UE
        f_UTRAN34_SwitchPower_Off(p_CellId, U1_IDLE, p_DetachType); // @sic R5s110176 sic@
      }
      case (U2_CONNECTED) {
        //Switch/Power off UE
        f_UTRAN34_SwitchPower_Off(p_CellId, p_UTRA_POSTAMBLE_STATE, p_DetachType); // @sic R5s110176 sic@
      }
      case (U3_HANDOVER) {
        // @sic R5s150599 this case is never reached in UTRAN34_ sic@
      }
      case (U5_CSCALL) {
        //Disconnect the active CC call
        f_UTRAN_CC_Disconnect(p_TI_S); //@sic R5s120086 sic@
        // @sic R5-142985 sic@
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch, true);
        f_UTRAN34_RRC_ConnEst(p_CellId);
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch); // @sic R5s140552 sic@
        
        //Switch/Power off UE
        f_UTRAN34_SwitchPower_Off(p_CellId, U1_IDLE, p_DetachType); // @sic R5s110176, R5s140552 sic@
      }
      case (U6_DEREGISTERED) {
        //If the UE can be switched off
        if (pc_SwitchOnOff == true) {
          //Simply switch the UE off
          f_UT_SwitchOffUE(UT, false);
        } else {//just remove power from UE
          f_UT_PowerOffUE(UT);
        }
      }
      case else {//No state defined - just remove power from UE
        f_UT_PowerOffUE(UT);
      }
    }
    //Release the UTRAN cell
    f_UTRAN_ReleaseCell(p_CellId, v_CellConfig); // @sic R5s110176 sic@
  } // f_UTRAN34_Postamble

  /*
   * @desc      Procedure to be used in the test case preamble when UE should be brought to state
   *            Registered, Idle Mode (state 2) on an UTRAN cell.
   * @param     p_CellId
   * @param     p_EstCause          (default value: registration)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_Preamble(UTRAN_CellId_Type p_CellId,
                              template (present) EstablishmentCause p_EstCause := registration //@sic R5s150676 change 4.3 sic@
                              ) runs on UTRAN_PTC
  { /* @sic R5s130347: local GuardTimer sic@ */
    
    timer t_GuardTimer := tsc_GuardTimePreamble;
    
    t_GuardTimer.start;
    
    //  Switch cell power on
    f_UTRAN_SetCellPower(p_CellId, tsc_AttenuationServingCell);
    
    //  Switch on UE
    f_UT_SwitchOnUE(UT, false);
    
    //  Establish RRC Connection, perform Authentication, Security Mode procedure,
    //  Attach procedure and release RRC Connection
    f_UTRAN34_IdleUpdated(p_CellId, -, p_EstCause);  //@sic R5s150676 change 4.3 sic@
    
    t_GuardTimer.stop;
  }

  /*
   * @desc      Setup MO CS call  34.108 cl. 7.2.3.2
   * @param     p_CellId
   * @param     p_ForceSpeechCall   (default value: false)
   * @param     p_DCH_Enhancements_SetupInfo (default value: omit)
   * @return    TI
   * @status    APPROVED (SSNITZ)
   */
  function f_UTRAN34_GoToState6_9_MO(UTRAN_CellId_Type  p_CellId,
                                     boolean p_ForceSpeechCall := false, // set to true for all Supplementary Service tests
                                     template (omit) DCH_Enhancements_Info_FDD p_DCH_Enhancements_SetupInfo := omit) runs on UTRAN_PTC return TI  //@sic R5-155768 sic@
  {
    var template (present) EstablishmentCause v_EstCause := originatingConversationalCall;
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R;
    
    // Trigger UE to make an outgoing call
    v_EstCause := f_UTRAN34_TriggerOutgoingCallProcedure(cs_domain, p_ForceSpeechCall);
    // Steps 2-4
    f_UTRAN34_RRC_ConnEst(p_CellId, v_EstCause);
    
    // Step 5 Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_ServReqAny(?)))-> value v_RRC_DataInd; // @sic R5s150084 sic@
    
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    v_TI_R := f_UTRAN34_MO_SpeechCall_Steps6_16 (p_CellId, true, false, true, false, p_DCH_Enhancements_SetupInfo); // @sic R5-145740 R5-155768 sic@

    return v_TI_R; // Needed for multiparty calls
  }

  /* @desc      Step 6-16 of 34.108 cl. 7.2.3.2
   * @param     p_CellId
   * @param     p_DoAuth            (default value: true)
   * @param     p_PS_RB_Already_Est (default value: false)
   * @param     p_DoCS_Security (default value: true)
   *            if p_DoAuth is true, p_DoCS_Security shall also be true
   * @param     p_StopAtU4State (default value: false) to stop after Alerting message @sic R5-150590 sic@
   * @param     p_DCH_Enhancements_Info_FDD (default value: omit)
   * @return    TI
   * @status    APPROVED (SSNITZ)
   */
  function f_UTRAN34_MO_SpeechCall_Steps6_16(UTRAN_CellId_Type p_CellId,
                                             boolean           p_DoAuth := true,
                                             boolean           p_PS_RB_Already_Est := false,
                                             boolean           p_DoCS_Security := true,
                                             boolean           p_StopAtU4State := false,
                                             template (omit) DCH_Enhancements_Info_FDD p_DCH_Enhancements_Info_FDD := omit) runs on UTRAN_PTC return TI  // @sic R5-155768 sic@
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo;
    var TI v_TI_R;
    var RRC_DATA_IND v_RRC_DataInd;
    
    f_CheckDTMFHandling (); // @sic R5s150330 sic@
    
    //Steps 6-7: Authentication Request and Authentication Response
    if (p_DoAuth) {
      v_SecurityInfo := f_UTRAN_Security_Get();
      v_SecurityInfo.authKeys.CSinOtherRAT := true;
      f_UTRAN_Security_Set(v_SecurityInfo);
      f_UTRAN_MM_Authentication();
    }
    
    //Step 8-9
    //Security Mode procedure
    if (p_DoCS_Security) {
      f_UTRAN34_RRC_Security(p_CellId, p_DoAuth, cs_domain);
    }
    
    //Step 10
    //Receive Set Up
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_SetupMOCall(cr_BcapSpeechMO))) // @sic R5s110580 sic@
      -> value v_RRC_DataInd;
    v_TI_R := v_RRC_DataInd.msg.setupul.ti;
    
    f_UTRAN34_MO_SpeechCall_Steps11_16 (p_CellId, v_TI_R, p_PS_RB_Already_Est, p_StopAtU4State, p_DCH_Enhancements_Info_FDD); // @sic R5-142954 R5-155768 sic@
    return v_TI_R; // @sic R5-145740 sic@
  }

  /* @desc      Step 11-16 of 34.108 cl. 7.2.3.2
   * @param     p_CellId
   * @param     p_TI_R
   * @param     p_PS_RB_Already_Est (default value: false)
   * @param     p_StopAtU4State     (default value: false) to stop after Alerting message @sic R5-150590 sic@
   * @param     p_DCH_Enhancements_Info_FDD      (default value: omit)
   * @status    APPROVED (SSNITZ)
   */
  function f_UTRAN34_MO_SpeechCall_Steps11_16(UTRAN_CellId_Type p_CellId,
                                              TI                 p_TI_R,
                                              boolean            p_PS_RB_Already_Est := false,
                                              boolean            p_StopAtU4State := false,
                                              template (omit) DCH_Enhancements_Info_FDD p_DCH_Enhancements_Info_FDD := omit ) runs on UTRAN_PTC  // @sic R5-155768 sic@
  {
    var TI v_TI_S := p_TI_R;
    v_TI_S.tiFlag := '1'B;
    
    //Step 11  -  Send Call PROCEEDING
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_CallProc(v_TI_S)));

    //Step 12-13 - Radio Bearer Establishment
    if (p_PS_RB_Already_Est){
      f_UTRAN_Setup_RAB_PS_and_ConvSpeech(p_CellId);
    }
    else {
      if (ispresent (p_DCH_Enhancements_Info_FDD)) { // @sic R5-155768 sic@  this check will catch up a possible dynamic test case error at runtime
        f_UTRAN34_RB_SetUp_Speech_DCH_Enh(p_CellId, valueof(p_DCH_Enhancements_Info_FDD));
      } else{
        f_UTRAN_RB_SetUp_Speech(p_CellId);  /* @sic R5s120139 - Additional Changes sic@ */
      }
    
      //Step 14  -  Send Alerting
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_Alert(v_TI_S)));
      
      if (not p_StopAtU4State) { // @sic R5-150590 sic@
        //Step 15  -  Send Connect
        U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_Connect(v_TI_S)));
        
        //Step 16  -  Receive CONNECT ACKOWLEDGE
        U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_ConnAck(p_TI_R)));
      }
    }
  }

  /*
   * @desc      To get the release status and release the connection
   * @param     p_CellId
   * @param     p_ConnEstFollows    (default value: false)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_RRC_ConnRelStatus(UTRAN_CellId_Type  p_CellId,
                                       boolean p_ConnEstFollows := false) runs on UTRAN_PTC
  {
    var RB_ConfigType v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);
    select (v_CellConfig) {
      case (cell_FACH) {
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Fach_Dcch, p_ConnEstFollows);
      }
      case else {
        f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch, p_ConnEstFollows);
      }
    }
  }

  /*
   * @desc      Send Attach Accept various parameters and receive Attach Complete
   *            UTRAN34: additional parameters
   *            NOTE: additional optional parameters can be added
   * @param     p_CellId
   * @param     p_AttachType
   * @param     p_PTMSI             (default value: px_PTMSI_Def)
   * @param     p_PTMSISig          (default value: px_PTMSI_SigDef)
   * @param     p_MobileIdentity    (default value: omit)
   * @param     p_T3312ExtdValue    (default value: false)
   * @param     p_GmmCause          (default value: omit)
   * @param     p_AddNwFeatSupport  (default value: omit)
   * @param     p_T3302Value        (default value: omit)
   * @param     p_SendPTMSI         (default value: true)
   * @param     p_EPLMN             (default value: omit)
   * @param     p_FOP               (default value: tsc_FOP_FollowOnProceed)
   * @param     p_T3324             (default value: omit)
   * @param     p_SendPtmsiAndTmsi  (default value: true)
   * @param     p_DCN_Id            (default value: omit)
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_AttachAccept(UTRAN_CellId_Type p_CellId,
                                  B3_Type p_AttachType,
                                  octetstring p_PTMSI := px_PTMSI_Def,
                                  octetstring p_PTMSISig := px_PTMSI_SigDef,
                                  template (omit) MobileIdentity p_MobileIdentity := omit,
                                  boolean p_T3312ExtdValue := false,
                                  template (omit) GMM_Cause p_GmmCause := omit, //@sic R5-140946 sic@
                                  template (omit) AddNtwFeatureSupport p_AddNwFeatSupport := omit, //@sic R5-140946 sic@
                                  template (omit) GPRS_Timer2 p_T3302Value:= omit, //@sic R5-140946 sic@
                                  boolean p_SendPTMSI := true,
                                  template (omit) PLMN_List p_EPLMN := omit,
                                  B1_Type  p_FOP := tsc_FOP_FollowOnProceed,
                                  template (omit) GPRS_Timer2 p_T3324 := omit,
                                  boolean p_SendPtmsiAndTmsi := true,  //@sic R5s160979 sic@
                                  template (omit) integer p_DCN_Id := omit  // @sic R5-174591 sic@
                                ) runs on UTRAN_PTC
  {
    var octetstring v_PLMN := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
    var octetstring v_LAC := f_UTRAN_CellInfo_GetLAC(p_CellId);
    var octetstring v_RAC := f_UTRAN_CellInfo_GetRAC(p_CellId);
    var template (value) RRCDataReqType v_U_AttachAcc;
    var template (omit) MobileIdentity v_MobileIdentity := omit; // @sic R5s150083 sic@
        
    if (p_AttachType == tsc_I_AttachTypeCombined) {
      v_MobileIdentity := cs_MobileIdTMSIorPTMSI('23'O, px_TMSI_Def); // @sic R5s150083 sic@
      if (isvalue(p_MobileIdentity)) { // @sic R5s150083 sic@
        v_MobileIdentity := p_MobileIdentity; // now overwrite if you need to pass something other than TMSI
      }
    }
    
    if (p_SendPTMSI) {
      if (p_SendPtmsiAndTmsi == false) {  //@sic R5s160979 sic@
        v_MobileIdentity := omit;
      }
      v_U_AttachAcc := cs_U_AttachAcc(cs_GMM_AttachResult(p_AttachType, p_FOP),
                                      cs_RAI(omit,
                                             cs_LAI(omit, v_PLMN, v_LAC),
                                             v_RAC),
                                      cs_PTMSI_Signature(p_PTMSISig),
                                      cs_MobileIdTMSIorPTMSI('18'O, p_PTMSI),
                                      v_MobileIdentity,
                                      p_EPLMN,
                                      p_GmmCause,
                                      p_AddNwFeatSupport,
                                      p_T3302Value);
    } else {
      v_U_AttachAcc := cs_U_AttachAcc(cs_GMM_AttachResult(p_AttachType, p_FOP),
                                      cs_RAI(omit,
                                             cs_LAI(omit, v_PLMN, v_LAC),
                                             v_RAC),
                                      omit,
                                      omit,
                                      omit, // @sic R5s150083 sic@
                                      p_EPLMN,
                                      p_GmmCause,
                                      p_AddNwFeatSupport,
                                      p_T3302Value);
    }
    if (p_T3312ExtdValue){
      v_U_AttachAcc.attachAccept.t3312ExtdValue := cs_GPRS_Timer2_3_IEI('39'O, tsc_Gprs3TimerUnit_1min, '00110'B); // @sic R5s150329 Baseline Moving sic@
    }

    if (isvalue(p_T3324)){ //@sic R5-155945 sic@
      v_U_AttachAcc.attachAccept.t3324Value := p_T3324;
    }

    if (isvalue(p_DCN_Id)){// @sic R5-174591 sic@
      v_U_AttachAcc.attachAccept.dcnID := cs_Dcn_Id(int2oct(valueof(p_DCN_Id),2));
    }

    U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                             tsc_RB3,
                             v_U_AttachAcc));
    
    if (p_SendPTMSI) { // Attach Complete will only be issued if new PTMSI has been assigned
      U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_AttachComplete));
    }
  }

  /*
   * @desc      Complete GMM_IdleUpdated handling NMO I and II, Operation Mode A and Automatic Switch On
   *            UTRAN34: Handle all releases + additional parameters
   * @param     p_CellId
   * @param     p_EstCause          (default value: registration)
   * @param     p_U_GmmInformation  (default value: omit)
   * @param     p_RAI_Rcd           (default value: cr_RAI)
   * @param     p_PTMSI_snd         (default value: px_PTMSI_Def)
   * @param     p_PTMSI_Sig_rcv     (default value: px_PTMSI_SigDef)
   * @param     p_PTMSI_Sig_snd     (default value: px_PTMSI_SigDef)
   * @param     p_DoAuth            (default value: true)
   * @param     p_RRCConnectionReleaseRequired (default value: rrcConnectionRelease)
   * @param     p_T3324             (default value: omit)
   * @param     p_T3312ExtdValue    (default value: omit)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_GMM_RAU(UTRAN_CellId_Type p_CellId,
                             template (present) EstablishmentCause p_EstCause := registration,
                             template (omit) RRCDataReqType p_U_GmmInformation := omit,
                             template (present) RoutingAreaId p_RAI_Rcd := cr_RAI,
                             octetstring p_PTMSI_snd := px_PTMSI_Def,
                             octetstring p_PTMSI_Sig_rcv := px_PTMSI_SigDef,
                             octetstring p_PTMSI_Sig_snd := px_PTMSI_SigDef,
                             boolean p_DoAuth := true,
                             RRCConnectionReleaseRequired_Type p_RRCConnectionReleaseRequired := rrcConnectionRelease,
                             template (omit) GPRS_Timer2 p_T3324 := omit,  // @sic R5-160781 sic@
                             template (omit) GPRS_Timer2 p_T3312ExtdValue := omit) runs on UTRAN_PTC // @sic R5-160782 sic@
  {
    f_UTRAN34_RRC_ConnEst(p_CellId, p_EstCause); // Establish RRC connection
    f_UTRAN34_GMM_RAU_WithoutRRCConnection(p_CellId, p_DoAuth, -, p_U_GmmInformation, p_RAI_Rcd, p_PTMSI_snd, p_PTMSI_Sig_rcv, p_PTMSI_Sig_snd, p_RRCConnectionReleaseRequired, p_T3324, p_T3312ExtdValue); // @sic R5-160781 R5-160782 sic@
  }

  /*
   * @desc      This function is according to 36.508 cl. 6.4.2.8    with the exception that when p_DoAuth is set to true
   *            the function also performs Authentication procedure
   *            UTRAN34: additional parameters
   * @param     p_CellId
   * @param     p_DoAuth            (default value: true)
   * @param     p_NoSecurityAfterHO (default value: false) - only set to true in HO test cases
   * @param     p_U_GmmInformation  (default value: omit)
   * @param     p_RAI_Rcd           (default value: cr_RAI)
   * @param     p_PTMSI_snd         (default value: px_PTMSI_Def)
   * @param     p_PTMSI_Sig_rcv     (default value: px_PTMSI_SigDef)
   * @param     p_PTMSI_Sig_snd     (default value: px_PTMSI_SigDef)
   * @param     p_RRCConnectionReleaseRequired (default value: rrcConnectionRelease)
   * @param     p_T3324             (default value: omit)
   * @param     p_T3312ExtdValue    (default value: omit)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_GMM_RAU_WithoutRRCConnection(UTRAN_CellId_Type p_CellId,
                                                  boolean     p_DoAuth := true,
                                                  boolean     p_NoSecurityAfterHO := false,
                                                  template (omit) RRCDataReqType p_U_GmmInformation := omit,
                                                  template (present) RoutingAreaId p_RAI_Rcd := cr_RAI,
                                                  octetstring p_PTMSI_snd := px_PTMSI_Def,
                                                  octetstring p_PTMSI_Sig_rcv := px_PTMSI_SigDef,
                                                  octetstring p_PTMSI_Sig_snd := px_PTMSI_SigDef,
                                                  RRCConnectionReleaseRequired_Type p_RRCConnectionReleaseRequired := rrcConnectionRelease,
                                                  template (omit) GPRS_Timer2 p_T3324 := omit, // @sic R5-160781 sic@
                                                  template (omit) GPRS_Timer2 p_T3312ExtdValue  := omit) runs on UTRAN_PTC // @sic R5-160782 sic@
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var B3_Type v_UpdateType := '000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var PDP_ContextStatus v_PDP_ContextStatus;
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var template (present) RRCDataIndType v_RAU;
    var template PTMSI_Signature v_PTMSI_Signature;
    var B1_Type v_FOP := '1'B;
    
    if (isvalue(p_PTMSI_Sig_rcv)) { // check RAI and PTMSI Signature
      v_PTMSI_Signature := cr_PTMSI_Signature(p_PTMSI_Sig_rcv);
    } else {
      v_PTMSI_Signature := cr_PTMSI_SignatureAny ifpresent;
    }

    v_RAU := cr_U34_RA_UpdReqAny(cr_GMM_UpdateType(?, (tsc_I_UpdateTypeRAOnly, tsc_I_UpdateTypeCombined, tsc_I_UpdateTypeCombinedWithIMSI)), // @sic R5s120776 R5s150682 sic@
                                 p_RAI_Rcd,
                                 v_PTMSI_Signature);
    if (isvalue(p_T3324)){ // @sic R5-160781 sic@
                  v_RAU.routingAreaUpdateRequest.t3324Value := p_T3324;
    }
    if (isvalue(p_T3312ExtdValue)){ // @sic R5-160782 sic@
                  v_RAU.routingAreaUpdateRequest.t3312ExtdValue := p_T3312ExtdValue;
    }

    alt {
      [] U_Dc.receive(car_PS_InitDirectTransfer(utran_CellDedicated,
                                                tsc_RB3,
                                                v_RAU)) // @sic R5s110216 sic@
        -> value v_RRC_DataInd {}
      [] U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated,
                                                  tsc_RB3,
                                                  v_RAU)) // @sic R5s110216 sic@
        -> value v_RRC_DataInd {}
    }
    
    if (p_DoAuth) { // @sic R5s120141 sic@
      v_START_Value := '00000000000000000000'B;
    } else if (ispresent(v_RRC_DataInd.ttcn_start)) {
      v_START_Value := v_RRC_DataInd.ttcn_start;
    } else {
      v_START_Value := v_SecurityInfo.start_PS; // current value.  If not previously set, default value is all zeros
    }
    if (not p_NoSecurityAfterHO) { // @sic R5s110216 sic@
      f_UTRAN_SS_SecurityDownloadStart(ps_domain, v_START_Value);
    }
    v_UpdateType := f_UG_RauReq_GetUpdateValueForRauAcc(v_RRC_DataInd.msg.routingAreaUpdateRequest); /* @sic R5s120019 Additional Changes sic@ */
    v_PDP_ContextStatus := v_RRC_DataInd.msg.routingAreaUpdateRequest.pDP_ContextStatus;
    if (v_RRC_DataInd.msg.routingAreaUpdateRequest.updateType.followOnReq == '1'B) {
      v_FOP := '0'B;
    } // to be checked
    f_UTRAN34_GMM_RAU_Without_RAUReq(p_CellId, v_START_Value, v_UpdateType, v_PDP_ContextStatus, p_DoAuth, p_NoSecurityAfterHO, v_FOP, p_U_GmmInformation, p_PTMSI_snd, p_PTMSI_Sig_snd, p_RRCConnectionReleaseRequired, p_T3324, p_T3312ExtdValue); // @sic R5-133584 @sic R5-160781 sic@
  }

  /*
   * @desc      Performs the Routing Area Procedure (except receiving the RAU Request message).
   *            Execution of Authentication is dependent on input parameter p_DoAuth
   *            UTRAN34: additional parameters
   * @param     p_CellId
   * @param     p_START_Value
   * @param     p_UpdateType
   * @param     p_PDP_ContextStatus
   * @param     p_DoAuth            (default value: true)
   * @param     p_NoSecurityAfterHO (default value: false) - only set to true in HO test cases
   * @param     p_FOP               (default value: '1'B)
   * @param     p_U_GmmInformation  (default value: omit)
   * @param     p_PTMSI_Def_snd     (default value: px_PTMSI_Def)
   * @param     p_PTMSI_SigDef_snd  (default value: px_PTMSI_SigDef)
   * @param     p_RRCConnectionReleaseRequired (default value: rrcConnectionRelease)
   * @param     p_T3324             (default value: omit)
   * @param     p_T3312ExtdValue    (default value: omit)
   * @param     p_AssignPTMSI       (default value: true)
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN34_GMM_RAU_Without_RAUReq(UTRAN_CellId_Type p_CellId,
                                            START_Value       p_START_Value,
                                            B3_Type           p_UpdateType,
                                            template (omit)   PDP_ContextStatus p_PDP_ContextStatus,
                                            boolean           p_DoAuth := true,
                                            boolean           p_NoSecurityAfterHO := false,
                                            B1_Type           p_FOP := '1'B,
                                            template (omit) RRCDataReqType p_U_GmmInformation := omit,
                                            octetstring p_PTMSI_Def_snd := px_PTMSI_Def,
                                            octetstring p_PTMSI_SigDef_snd := px_PTMSI_SigDef,
                                            RRCConnectionReleaseRequired_Type p_RRCConnectionReleaseRequired := rrcConnectionRelease,
                                            template (omit) GPRS_Timer2 p_T3324 := omit, // @sic R5-160781 sic@
                                            template (omit) GPRS_Timer2 p_T3312ExtdValue := omit,  // @sic R5-160782 sic@
                                            boolean p_AssignPTMSI := true  //@sic R5-174591 sic@
                                            ) runs on UTRAN_PTC
  {
    var octetstring v_PLMN := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
    var octetstring v_LAC := f_UTRAN_CellInfo_GetLAC(p_CellId);
    var octetstring v_RAC := f_UTRAN_CellInfo_GetRAC(p_CellId);
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get();
    var template (value) RRCDataReqType v_RAU_Accept;
    var RB_ConfigType v_CellConfig;
    
    if (not p_NoSecurityAfterHO) { // @sic R5s110216 sic@
      f_UTRAN_SS_SecurityDownloadStart(ps_domain, p_START_Value);
    }
    
    // Store flag to be sent to LTE later; @sic R5-110746 sic@
    if (p_UpdateType == tsc_I_UpdateTypeCombinedWithIMSI or p_UpdateType == tsc_I_UpdateTypeCombined) {
      v_SecurityInfo.authKeys.CSinOtherRAT := true;
      f_UTRAN_Security_Set(v_SecurityInfo);
    }
    
    if (p_DoAuth) {
      f_UTRAN_GMM_Authentication();
    }
    
    if (not p_NoSecurityAfterHO) {
      f_UTRAN34_RRC_Security(p_CellId,                        // SECURITY MODE COMMAND, SECURITY MODE COMPLETE
                           p_DoAuth,
                           ps_domain);   // @sic R5s150599 use UTRAN34_ sic@
    }
               
    if(p_AssignPTMSI){   //@sic R5-174591 sic@
        v_RAU_Accept := cs_U_RA_UpdAcc3(cs_GMM_UpdateResult(p_UpdateType),
                                    cs_RAI(omit,
                                           cs_LAI(omit, v_PLMN, v_LAC),
                                           v_RAC),
                                    cs_PTMSI_Signature(p_PTMSI_SigDef_snd),
                                    cs_MobileIdTMSIorPTMSI('18'O, p_PTMSI_Def_snd),
                                    p_PDP_ContextStatus); // @sic R5-133584 sic@
    }
    else{
        v_RAU_Accept := cs_U_RA_UpdAcc3(cs_GMM_UpdateResult(p_UpdateType),
                                    cs_RAI(omit,
                                           cs_LAI(omit, v_PLMN, v_LAC),
                                           v_RAC),
                                    omit,
                                    omit,
                                    p_PDP_ContextStatus);
    }
    v_RAU_Accept.routingAreaUpdateAccept.updateResult.fOP := p_FOP; // @sic R5-142978 sic@

    if (isvalue(p_T3324)){ // @sic R5-160781 sic@
      v_RAU_Accept.routingAreaUpdateAccept.t3324Value := p_T3324;
    }

    if (isvalue(p_T3312ExtdValue)){ // @sic R5-160782 sic@
      v_RAU_Accept.routingAreaUpdateAccept.t3312ExtdValue := p_T3312ExtdValue;
    }

    U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                             tsc_RB3,
                             v_RAU_Accept));
    
    U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_RAUpdComplete));
    
    // include GMM information to be sent to the UE after Attach procedure
    if (isvalue (p_U_GmmInformation)) {
      U_Dc.send(cas_DataReq_PS(utran_CellDedicated,   //@sic R5s150613 sic@
                               tsc_RB3,
                               valueof(p_U_GmmInformation)));
    }
    
    if (p_RRCConnectionReleaseRequired == rrcConnectionRelease) { // @sic R5s160060 sic@
      v_CellConfig := f_UTRAN_CellInfo_GetConfigType(p_CellId);  // Updated in RRC Conn Est
      select (v_CellConfig) {
        case (cell_FACH) {
          f_UTRAN34_RRC_ConnRel(p_CellId, cell_Fach_Dcch);
        }
        case else {
          f_UTRAN34_RRC_ConnRel(p_CellId, cell_Dch);
        }
      }
    }
  }

  /*
   * @desc      Function to establish RB setup to operate in DCH Enhanced mode and to configure SS accordingly
   * @param     p_CellId
   * @param     p_DCH_Enhancements_Info_FDD
   * @status    APPROVED (SSNITZ)
   *
   */
  function f_UTRAN34_RB_SetUp_Speech_DCH_Enh(UTRAN_CellId_Type  p_CellId,
                                             template (value) DCH_Enhancements_Info_FDD p_DCH_Enhancements_Info_FDD) runs on UTRAN_PTC
  { // @sic R5-155768 sic@
    var UL_ScramblingCode v_UL_ScramblingCode;
    var PrimaryScramblingCode v_PrimaryScramblingCode;
    var template (value) DL_DCCH_Message v_RB_SetUp;
    var UTRAN_CFN_Info_Type v_CfnInfo := f_CalculateActTime(p_CellId);
    var ActivationTime v_Activationtime := v_CfnInfo.actTime;
    var template (value) SS_ActivationTime v_SS_ActivationTime := cs_ActivateCFN(v_Activationtime);
    var UTRAN_SecurityInfo_Type v_SecurityInfo; v_SecurityInfo := f_UTRAN_Security_Get();
     
    v_UL_ScramblingCode:= f_UTRAN_CellInfo_GetULScrmCode_FDD(p_CellId);
    v_PrimaryScramblingCode:= f_UTRAN_CellInfo_GetPriScrmCode_FDD(p_CellId);
    v_RB_SetUp := cs_108_RB_SetUpSpeech_DCHEnh_r12_FDD(v_SecurityInfo.dl_IntegrityCheckInfo, v_Activationtime, v_PrimaryScramblingCode, v_UL_ScramblingCode, p_DCH_Enhancements_Info_FDD);
      
    f_UTRAN_RB_SetUp_Send(v_RB_SetUp);

    f_SS_Config_ConvSpeech_RAB(p_CellId, v_SS_ActivationTime, p_DCH_Enhancements_Info_FDD);
    
    f_UTRAN_RRC_ReceiveRB_SetupCmpl_Speech(p_CellId, v_Activationtime, true);
  }

}
