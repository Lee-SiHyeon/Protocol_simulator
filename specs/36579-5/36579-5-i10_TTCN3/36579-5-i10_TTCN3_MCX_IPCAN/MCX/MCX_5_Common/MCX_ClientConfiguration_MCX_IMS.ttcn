module MCX_ClientConfiguration_MCX_IMS {

  import from CommonDefs all;
  import from IMS_Component all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;
  import from MCX_CommonDefs all;
  import from MCX_CoordMsgs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_Parameters all;
  import from MCX_SIP_Affiliation all;
  import from MCX_SIP_Common all;
  import from MCX_SIP_Registration all;
  import from MCX_XML_affiliationCommand all;
  import from MCX_XML_mcdata_info all;
  import from MCX_XML_mcptt_info all;
  import from MCX_XML_mcvideo_info all;
  import from MCX_XML_simple_filter all;
  import from UpperTesterFunctions all;
  import from XSD all;

  /*
   * @desc      Common test procedure for test case 5.1 (MCPTT, MCVideo, MCData)
   * @param     p_ServiceType
   * @status    APPROVED (MCX)
   */
  function f_MCX_5_1_IMS(MCX_ServiceType_Type p_ServiceType) runs on MCX_IMS_PTC
  { // Configuration / Authentication / User Authorisation / UE Configuration / User Profile / Key Generation
    
    /* @sic R5-242351 change 4: Test case updated according R5-240555 and R5-240558 sic@ */
    
    var MCX_Coordination_MSG v_MCX_Coordination_MSG;
          
    f_MCX_Preamble_Init_IMS(IPCAN_SignallingOnly);

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCX_Preamble_InitialRegistration_IMS(p_ServiceType);                                      /* Switch on UE and do initial SIP registration; happens in parallel to step 3 - 16 */

    // @siclog "Step 2 Void" siclog@

    // @siclog "Step 3 - 16 HTTP siclog@
    v_MCX_Coordination_MSG := f_MCX_WaitForCoOrdMsg(HTTP, cmr_MCX_SecurityParameters);          /* MCX Initial Configuration and User Authentication according to 36.579-1 Table 5.3.2.3.1-1 (f_MCX_HTTP_UserAuthentication) is finished at HTTP PTC */

    f_MCX_IMS_PTC_SecurityParameters_Set(v_MCX_Coordination_MSG.SecurityParameters);

    // @siclog "Step 17 - 19 in parallel siclog@
    f_MCX_IMS_InitialServiceSettingsAndSubscriptions(p_ServiceType);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 17");                                       /* TP3 and TP6; TP4 and TP5 are at HTTP */

    /* @sic R5-242351 change 4: test case does not do Location reporting onfiguration (anymore) sic@ */

    f_IMS_TestBody_Set(false);

    f_MCX_IPCAN_ReleaseConnection();
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      test case specific function to receive SIP MESSAGE and send 200 OK (step 26 - 27)
   *            Table 5.3.3.3-38: SIP MESSAGE, Table 5.3.3.3-39: MCPTT-INFO, Table 5.3.3.3-40: MCPTT-AFFILIATION-COMMAND
   * @param     p_ServiceType
   * @param     p_AffiliationInfo
   * @status    APPROVED (MCX)
   */
  function fl_TC_5_3_ReceiveMESSAGE_Send200OK(MCX_ServiceType_Type p_ServiceType,
                                              MCX_AffiliationInfo_Type p_AffiliationInfo) runs on MCX_IMS_PTC
  {
    var charstring v_PublicServiceId := f_MCX_MCServer_PublicServiceId(p_ServiceType);
    var charstring v_GroupId_A := f_MCX_MCService_GroupID_Group_A(p_ServiceType);
    var template (present) MCX_Affiliation_CommandList_Type v_AffiliationCmd := cr_MCX_Affiliation_AffiliateCmd(v_GroupId_A);
    var template (present) MCX_ServiceInfo_Type v_ServiceInfo := f_MCX_Service_Info_Affiliation(p_ServiceType, p_AffiliationInfo.ServiceId);

    f_MCX_ReceiveMESSAGE_Send20xResponse_MIME(p_ServiceType, v_PublicServiceId, c_statusLine200, v_ServiceInfo.Mcptt, -, v_ServiceInfo.Mcvideo, -, v_ServiceInfo.Mcdata, -, v_AffiliationCmd);
  }

  /*
   * @desc      test case specific function to send SIP MESSAGE and receive 200 OK (step 39 - 40)
   *            Table 5.3.3.3-41: SIP MESSAGE, Table 5.3.3.3-42: MCPTT-INFO, Table 5.3.3.3-43: MCPTT-AFFILIATION-COMMAND
   * @param     p_ServiceType
   * @param     p_AffiliationInfo
   * @status    APPROVED (MCX)
   */
  function fl_TC_5_3_SendMESSAGE_Receive200OK(MCX_ServiceType_Type p_ServiceType,
                                              MCX_AffiliationInfo_Type p_AffiliationInfo) runs on MCX_IMS_PTC
  {
    var template (value) MCX_ServiceInfo_Type v_ServiceInfo := cs_MCX_Service_Info_Init;
    var template (value) MessageHeader v_MessageHeader := f_MCX_MessageRequest_MessageHeaderTX(p_ServiceType);
    var charstring v_AssertedService := f_MCX_FeatureTag_3gpp_service_ims_icsi_mcs(p_ServiceType);
    var charstring v_GroupId_A := f_MCX_MCService_GroupID_Group_A(p_ServiceType);
    var template (value) MCX_Affiliation_CommandList_Type v_AffiliationCmd := cs_MCX_Affiliation_AffiliateCmd(v_GroupId_A);

    v_MessageHeader.pAssertedService := cs_PAssertedService(v_AssertedService);                                 /* @sic R5-216671 sic@ */

    select (p_ServiceType) {
      case (MCPTT)   { v_ServiceInfo.Mcptt   := cs_MCPTT_Info_Base(p_AffiliationInfo.ServiceId, omit); }        /* mcptt-calling-user-id not present according to Table 5.3.3.3-42 */
      case (MCVideo) { v_ServiceInfo.Mcvideo := cs_MCVideo_Info_Base(p_AffiliationInfo.ServiceId, omit); }      /* mcptt-calling-user-id not present according to Table 5.3.3.3-42 */
      case (MCData)  { v_ServiceInfo.Mcdata  := cs_MCData_Info_Base(-, p_AffiliationInfo.ServiceId, omit); }    /* mcptt-calling-user-id not present according to Table 5.3.3.3-42 */
      case else      { FatalError(__FILE__, __LINE__, "Invalid service type"); }
    }

    f_MCX_SendMESSAGEwithMIME_Receive200OK(p_ServiceType, v_MessageHeader, v_ServiceInfo.Mcptt, v_ServiceInfo.Mcvideo, v_ServiceInfo.Mcdata, v_AffiliationCmd);
  }

  /*
   * @desc      Common test procedure for test case 5.3 (MCPTT, MCVideo, MCData)
   * @param     p_ServiceType
   * @status    APPROVED (MCX)
   */
  function f_MCX_5_3_IMS(MCX_ServiceType_Type p_ServiceType) runs on MCX_IMS_PTC
  {
    var charstring v_ServiceName := f_MCX_ServiceName(p_ServiceType);
    var boolean v_WithAffiliation := true;
    var charstring v_ServiceId_A := f_MCX_MCService_ID_User_A(p_ServiceType);
    var charstring v_ServiceId_B := f_MCX_MCService_ID_User_B(p_ServiceType);
    var MCX_AffiliationInfo_Type v_AffiliationInfo_A;
    var MCX_AffiliationInfo_Type v_AffiliationInfo_B;
    var template MCX_SimpleFilter_Type v_SimpleFilter := omit;
    var charstring v_MCX_Client_A_ID;
    var XSD.String v_P_id;

    f_MCX_Preamble_IMS(p_ServiceType, IPCAN_SignallingOnly);

    v_MCX_Client_A_ID := f_MCX_IMS_PTC_ClientId_GetValue();   // cannot be done before preamble
    v_AffiliationInfo_A := valueof(cs_MCX_AffiliationInfo(v_ServiceId_A, v_MCX_Client_A_ID, presenceDialog1));
    v_AffiliationInfo_B := valueof(cs_MCX_AffiliationInfo(v_ServiceId_B, px_MCX_Client_B_ID, presenceDialog2));

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCX_IPCAN_StartSignalling(IPCAN_MO_IMS_Signalling);
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) subscribe to affiliation status determination and later notifications for user A");

    // @siclog "Step 2 - 4A" siclog@
    /* v_SimpleFilter := cr_MCX_SimpleFilter_PerClient(p_ServiceType, v_MCX_Client_A_ID);                       // !!!! PROSE ISSUE: According to 24.379 clause 4.8 the MCPTT client ID is considered as sensitive data => ciphering is needed !!!!
       => R5_220483 has been withdrawn */
    f_MCX_Affiliation_Subscription(p_ServiceType, v_AffiliationInfo_A, INITIAL_SUBSCRIBE, v_SimpleFilter);      /* Table 5.3.3.3-1: SIP SUBSCRIBE, Table 5.3.3.3-2: MCPTT-INFO */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, affiliated);                             /* Table 5.3.3.3-24: SIP NOTIFY, Table 5.3.3.3-25: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 4B" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of being affiliated with group A?", "Step 4B");

    // @siclog "Step 4C" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) request de-affiliation of user A from group A");
    
    // @siclog "Step 4D - 4I" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_A, tsc_MCX_Expires0);                  /* Table 5.3.3.3-21: SIP PUBLISH, Table 5.3.3.3-22: MCPTT-INFO, Table 5.3.3.3-23: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, deaffiliating, v_P_id);                  /* Table 5.3.3.3-47: SIP NOTIFY, Table 5.3.3.3-48: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, omit, v_P_id);                           /* Table 5.3.3.3-46: SIP NOTIFY, Table 5.3.3.3-45: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4D");

    // @siclog "Step 4J" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of being no longer affiliated with group A?", "Step 4J");

    // @siclog "Step 5" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) request affiliation of user A to group A");

    // @siclog "Step 6 - 9A" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_A, -, v_WithAffiliation);              /* Table 5.3.3.3-12: SIP PUBLISH, Table 5.3.3.3-13: MCPTT-INFO, Table 5.3.3.3-14: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, affiliating, v_P_id);                    /* Table 5.3.3.3-26: SIP NOTIFY, Table 5.3.3.3-27: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, affiliated, v_P_id);                     /* Table 5.3.3.3-28: SIP NOTIFY, Table 5.3.3.3-29: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    // @siclog "Step 10" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of being affiliated with group A?", "Step 10");

    // @siclog "Step 11" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) subscribe to affiliation status determination and later notifications for targeted user B");
   
    // @siclog "Step 12 - 13B" siclog@
    f_MCX_Affiliation_Subscription(p_ServiceType, v_AffiliationInfo_B, INITIAL_SUBSCRIBE);                      /* Table 5.3.3.3-3: SIP SUBSCRIBE, Table 5.3.3.3-4: MCPTT-INFO */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, omit);                                   /* Table 5.3.3.3-44: SIP NOTIFY, Table 5.3.3.3-45: PIDF in SIP NOTIFY  */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    
    // @siclog "Step 14" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) send an affiliation status change request to affiliate targeted user B to group A (mandatory mode)");

    // @siclog "Step 15 - 18A" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_B, -, v_WithAffiliation);              /* Table 5.3.3.3-15: SIP PUBLISH, Table 5.3.3.3-16: MCPTT-INFO, Table 5.3.3.3-17: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, affiliating, v_P_id);                    /* Table 5.3.3.3-30: SIP NOTIFY, Table 5.3.3.3-31: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, affiliated, v_P_id);                     /* Table 5.3.3.3-32: SIP NOTIFY, Table 5.3.3.3-33: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    // @siclog "Step 19" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of the target user (user B) being affiliated with group A?", "Step 19");

    // @siclog "Step 20" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) send an affiliation status change request to de-affiliate targeted user B from group A (mandatory mode)");

    // @siclog "Step 21 - 23C" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_B, tsc_MCX_Expires0);                  /* Table 5.3.3.3-18: SIP PUBLISH, Table 5.3.3.3-19: MCPTT-INFO, Table 5.3.3.3-20: PIDF  */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, deaffiliating, v_P_id);                  /* Table 5.3.3.3-34: SIP NOTIFY, Table 5.3.3.3-35: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, omit, v_P_id);                           /* Table 5.3.3.3-46: SIP NOTIFY, Table 5.3.3.3-45: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21");
                                                                             
    // @siclog "Step 24" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of the target user (user B) being no longer affiliated with group A?", "Step 24");

    // @siclog "Step 25" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) send an affiliation status change request to affiliate targeted user B to group A (negotiated mode)");
   
    // @siclog "Step 26 - 27" siclog@
    fl_TC_5_3_ReceiveMESSAGE_Send200OK(p_ServiceType, v_AffiliationInfo_B);                                     /* Table 5.3.3.3-38: SIP MESSAGE, Table 5.3.3.3-39: MCPTT-INFO, Table 5.3.3.3-40: MCPTT-AFFILIATION-COMMAND */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 26");

    // @siclog "Step 28 - 29A" siclog@
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, affiliating);                            /* Table 5.3.3.3-31A: SIP NOTIFY, Table 5.3.3.3-31B: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_B, affiliated);                             /* Table 5.3.3.3-33A: SIP NOTIFY, Table 5.3.3.3-33B: PIDF */
    
    // @siclog "Step 30" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of the target user (user B) being affiliated with group A?", "Step 30");

    // @siclog "Step 31" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) de-subscribe from getting affiliation status notifications for targeted user B");
    
    // @siclog "Step 32 - 33" siclog@
    f_MCX_Affiliation_Subscription(p_ServiceType, v_AffiliationInfo_B, UN_SUBSCRIBE);                           /* Table 5.3.3.3-6: SIP SUBSCRIBE, Table 5.3.3.3-7: MCPTT-INFO */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 32");
    
    // @siclog "Step 34" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) request de-affiliation of user A from group A");

    // @siclog "Step 35 - 37C" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_A, tsc_MCX_Expires0);                  /* Table 5.3.3.3-21: SIP PUBLISH, Table 5.3.3.3-22: MCPTT-INFO, Table 5.3.3.3-23: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, deaffiliating, v_P_id);                  /* Table 5.3.3.3-36: SIP NOTIFY, Table 5.3.3.3-37: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, omit, v_P_id);                           /* Table 5.3.3.3-46: SIP NOTIFY, Table 5.3.3.3-45: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 35");

    // @siclog "Step 38" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of being no longer affiliated with group A?", "Step 38");

    // @siclog "Step 39 - 40" siclog@
    fl_TC_5_3_SendMESSAGE_Receive200OK(p_ServiceType, v_AffiliationInfo_A);                                     /* Table 5.3.3.3-41: SIP MESSAGE, Table 5.3.3.3-42: MCPTT-INFO, Table 5.3.3.3-43: MCPTT-AFFILIATION-COMMAND */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 39");

    // @siclog "Step 41" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of another user is requesting user A get affiliated to group A?", "Step 41");

    // @siclog "Step 42" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (" & v_ServiceName & " client) accept affiliatiom of user A to group A");

    // @siclog "Step 43 - 46A" siclog@
    v_P_id := f_MCX_Affiliation_Publish(p_ServiceType, v_AffiliationInfo_A, -, v_WithAffiliation);              /* Table 5.3.3.3-12: SIP PUBLISH, Table 5.3.3.3-13: MCPTT-INFO, Table 5.3.3.3-14: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, affiliating, v_P_id);                    /* Table 5.3.3.3-26: SIP NOTIFY, Table 5.3.3.3-27: PIDF */
    f_MCX_Affiliation_Notification(p_ServiceType, v_AffiliationInfo_A, affiliated, v_P_id);                     /* Table 5.3.3.3-28: SIP NOTIFY, Table 5.3.3.3-29: PIDF */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 43");
    
    // @siclog "Step 47" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (" & v_ServiceName & " client) notify the user of being affiliated with group A?", "Step 47");
        
    f_IMS_TestBody_Set(false);

    f_MCX_IPCAN_ReleaseConnection();
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      Common test procedure for test case 5.8 (MCPTT) and 5.7 (MCData)
   * @param     p_ServiceType
   * @status    APPROVED (MCX)
   */
  function f_MCX_5_8_IMS(MCX_ServiceType_Type p_ServiceType) runs on MCX_IMS_PTC
  {
    f_MCX_Preamble_IMS(p_ServiceType, IPCAN_SignallingOnly);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCX_FunctionalAliasSubscription(p_ServiceType);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2" siclog@
    f_MCX_FunctionalAliasChange(p_ServiceType, tsc_MCX_ExpiresMax);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 3E" siclog@
    f_MCX_FunctionalAliasChange(p_ServiceType, tsc_MCX_Expires0);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3 - 3E");

    // @siclog "Step 4 - 7" siclog@
    f_MCX_FunctionalAliasSubscription(p_ServiceType, UN_SUBSCRIBE);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4 - 7");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

}
