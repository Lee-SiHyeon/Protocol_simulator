module UTRAN_34123_SelectionExpressions {

  import from Parameters all;
  import from UTRAN34_Parameters all;
  import from UTRAN_Parameters all;

  type enumerated UTRAN_34123_Condition_Type { /* @status    APPROVED (SSNITZ, UTRAN) */
    UTRAN34_C01b,
    UTRAN34_C01c,
    UTRAN34_C01d,
    UTRAN34_C12,
    UTRAN34_C62a,
    UTRAN34_C62b,
    UTRAN34_C88,
    UTRAN34_C98d,
    UTRAN34_C647a,
    UTRAN34_C731a,
    UTRAN34_C829,
    UTRAN34_C829_C829a,
    UTRAN34_C829a,
    UTRAN34_C829b_C829c,
    UTRAN34_C838,
    UTRAN34_C838a,
    UTRAN34_C849,
    UTRAN34_C850,
    UTRAN34_C851,
    UTRAN34_C851a,
    UTRAN34_C852,
    UTRAN34_C853,
    UTRAN34_C854,
    UTRAN34_C856,
    UTRAN34_C857,
    UTRAN34_C858,
    UTRAN34_C859,
    UTRAN34_C860,
    UTRAN34_C860a,
    UTRAN34_C861,
    UTRAN34_C861a,
    UTRAN34_C862,
    UTRAN34_C862a,
    UTRAN34_C863,
    UTRAN34_C863a,
    UTRAN34_C864,
    UTRAN34_C865,
    UTRAN34_C866,
    UTRAN34_C867,
    UTRAN34_C868,
    UTRAN34_C872,
    UTRAN34_C872a,
    UTRAN34_C873,
    UTRAN34_C874,
    UTRAN34_C875,
    UTRAN34_C876,
    UTRAN34_C878,
    UTRAN34_C879,
    UTRAN34_C881,
    UTRAN34_C882,
    UTRAN34_C883,
    UTRAN34_C884,
    UTRAN34_C885,
    UTRAN34_C887,
    UTRAN34_C888,
    UTRAN34_C890,
    UTRAN34_C891,
    UTRAN34_C892,
    UTRAN34_C893,
    UTRAN34_C894,
    UTRAN34_C895,
    UTRAN34_C896,
    UTRAN34_C897,
    UTRAN34_C898,
    UTRAN34_C899,
    UTRAN34_C900,
    UTRAN34_C901,
    UTRAN34_C902,
    UTRAN34_C903,
    UTRAN34_C904,
    UTRAN34_C905,
    UTRAN34_C907,
    UTRAN34_C908,
    UTRAN34_C910,
    UTRAN34_C911,
    UTRAN34_C912,
    UTRAN34_C913,
    UTRAN34_C914,
    UTRAN34_C915,
    UTRAN34_C916
  };

  /*
   * @desc      Set the applicability conditions according to 34.123-2 Table 1: Applicability of tests Conditions
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (SSNITZ, UTRAN)
   */
  function f_UTRAN_SelectionExpr(UTRAN_34123_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;

    select (p_Condition) {
      case (UTRAN34_C01b) {
        v_ApplCond := pc_FDD and pc_EUTRA and (pc_UTRA_FeatrGrp_3 or pc_UTRA_FeatrGrp_4);
      }
      case (UTRAN34_C01c) {
        v_ApplCond := pc_FDD and pc_EUTRA and pc_UTRA_FeatrGrp_4;
      }
      case (UTRAN34_C01d) {
        v_ApplCond := pc_FDD and ( (pc_CS and pc_CS_CallEst) or pc_PS );
      }
      case (UTRAN34_C12) {
        v_ApplCond := pc_PS;
      }
      case (UTRAN34_C62a) {
        v_ApplCond := pc_PS and pc_ActivateSimultaneousPDP and pc_NwSecPDP_Support;
      }
      case (UTRAN34_C62b) {
        v_ApplCond := pc_TestLoopMode4 and pc_PS and pc_ActivateSimultaneousPDP and pc_NwSecPDP_Support;
      }
      case (UTRAN34_C88) {
        v_ApplCond := pc_SupportOpModeA;
      }
      case (UTRAN34_C98d) {
        v_ApplCond := pc_CS and pc_CS_CallEst;
      }
      case (UTRAN34_C647a) {
        v_ApplCond := pc_FDD and pc_HS_FACH_FallbackR99prach;
      }
      case (UTRAN34_C731a) {
        v_ApplCond := pc_FDD and pc_HS_FACH_DRX_2ndDRXcycle;
      }
      case (UTRAN34_C829) {
        v_ApplCond := pc_FDD and pc_PS and pc_UTRAN_ANR;
      }
      case (UTRAN34_C829_C829a) {
        v_ApplCond := (pc_FDD and pc_PS and pc_UTRAN_ANR) or ((pc_TDD_HCR or pc_TDD_LCR or pc_TDD_VHCR) and pc_PS and pc_UTRAN_ANR);
      }
      case (UTRAN34_C829a) {
        v_ApplCond := (pc_TDD_HCR or pc_TDD_LCR or pc_TDD_VHCR) and pc_PS and pc_UTRAN_ANR;
      }
      case (UTRAN34_C829b_C829c) {
        v_ApplCond := (pc_FDD and pc_UMTS_GSM and pc_PS and pc_UTRAN_ANR) or ((pc_TDD_HCR or pc_TDD_LCR or pc_TDD_VHCR) and pc_PS and pc_UMTS_GSM and pc_UTRAN_ANR);
      }
      case (UTRAN34_C838) {
        v_ApplCond := pc_Loggedmeasurements_Idle_PCH;
      }
      case (UTRAN34_C838a) {
        v_ApplCond := pc_Loggedmeasurements_Idle_PCH and pc_UE_PositioningStandaloneLocMethodsSup;
      }
      case (UTRAN34_C849) {
        v_ApplCond := pc_UMTS_GSM and pc_Loggedmeasurements_Idle_PCH;
      }
      case (UTRAN34_C850) {
        v_ApplCond := pc_EUTRA and pc_Loggedmeasurements_Idle_PCH;
      }
      case (UTRAN34_C851) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_SBCC3);
      }
      case (UTRAN34_C851a) {
        v_ApplCond := pc_FDD and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_SBCC3);
      }
      case (UTRAN34_C852) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_SBCC3);
      }
      case (UTRAN34_C853) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC12 or pc_DB_4C_CC21);
      }
      case (UTRAN34_C854) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC12 or pc_DB_4C_CC21);
      }
      case (UTRAN34_C856) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC31);
      }
      case (UTRAN34_C857) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension5_FDD==32) and ( pc_4C_DBCC22);
      }
      case (UTRAN34_C858) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC12);
      }
      case (UTRAN34_C859) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_DB_4C_CC21);
      }
      case (UTRAN34_C860) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC12);
      }
      case (UTRAN34_C860a) {
        v_ApplCond := pc_FDD and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC12);
      }
      case (UTRAN34_C861) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_DB_4C_CC21);
      }
      case (UTRAN34_C861a) {
        v_ApplCond := pc_FDD and (pc_HSDSCH_UE_Category_Extension4_FDD==29 or pc_HSDSCH_UE_Category_Extension4_FDD==30 or pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_DB_4C_CC21);
      }
      case (UTRAN34_C862) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC31);
      }
      case (UTRAN34_C862a) {
        v_ApplCond := pc_FDD and (pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and (pc_4C_DBCC31);
      }
      case (UTRAN34_C863) {
        v_ApplCond := pc_FDD and (pc_FDPCH or pc_EnhancedF_DPCH) and (pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and ( pc_4C_DBCC22);
      }
      case (UTRAN34_C863a) {
        v_ApplCond := pc_FDD and (pc_HSDSCH_UE_Category_Extension5_FDD==31 or pc_HSDSCH_UE_Category_Extension5_FDD==32) and ( pc_4C_DBCC22);
      }
      case (UTRAN34_C864) {
        v_ApplCond := pc_CS and pc_LAP;
      }
      case (UTRAN34_C865) {
        v_ApplCond := pc_CS and pc_MinimumPeriodicSearchTimer;
      }
      case (UTRAN34_C866) {
        v_ApplCond := pc_PS and pc_NMO_I_Behaviour;
      }
      case (UTRAN34_C867) {
        v_ApplCond := pc_PS and pc_AttachWithIMSI;
      }
      case (UTRAN34_C868) {
        v_ApplCond := pc_PS and pc_LAP;
      }
      case (UTRAN34_C872) {
        v_ApplCond := pc_ConEstFail_logging;
      }
      case (UTRAN34_C872a) {
        v_ApplCond := pc_ConEstFail_logging and pc_UE_PositioningStandaloneLocMethodsSup;
      }
      case (UTRAN34_C873) {
        v_ApplCond := pc_UMTS_GSM and pc_ConEstFail_logging;
      }
      case (UTRAN34_C874) {
        v_ApplCond := pc_EUTRA and pc_ConEstFail_logging;
      }
      case (UTRAN34_C875) {
        v_ApplCond := pc_CS and pc_LAP and pc_T3212Extended;
      }
      case (UTRAN34_C876) {
        v_ApplCond := pc_PS and pc_LAP and pc_T3312Extended;
      }
      case (UTRAN34_C878) {
        v_ApplCond := pc_PS and pc_LAP and pc_LAP_override;
      }
      case (UTRAN34_C879) {
        v_ApplCond := pc_SupportOpModeA and pc_SMS_Only;
      }
      case (UTRAN34_C881) {
        v_ApplCond := pc_FDD and pc_CS and (pc_DaylightSavingTime or pc_UniversalAndLocalTimeZone or pc_LocalTimeZone);
      }
      case (UTRAN34_C882) {
        v_ApplCond := pc_FDD and pc_PS and (pc_DaylightSavingTime or pc_UniversalAndLocalTimeZone or pc_LocalTimeZone);
      }
      case (UTRAN34_C883) {
        v_ApplCond := pc_FDD and pc_PS and (pc_ShortNameNetwork or pc_FullNameNetwork);
      }
      case (UTRAN34_C884) {
        v_ApplCond := pc_FDD and pc_PS and (pc_DaylightSavingTime or pc_FullNameNetwork or pc_ShortNameNetwork or pc_LocalTimeZone or pc_UniversalAndLocalTimeZone);
      }
      case (UTRAN34_C885) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_MT_Serv and pc_SS_CLIP;
      }
      case (UTRAN34_C887) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_MO_Serv and pc_SS_CLIR;
      }
      case (UTRAN34_C888) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_BAOC or pc_SS_BOIC or pc_SS_BOIC_ExHC or pc_SS_BAIC or pc_SS_BIC_Roam);
      }
      case (UTRAN34_C890) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_BAOC or pc_SS_BIC_Roam);
      }
      case (UTRAN34_C891) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS;
      }
      case (UTRAN34_C892) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_ExplictCallTransfer;
      }
      case (UTRAN34_C893) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_CallHold;
      }
      case (UTRAN34_C894) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_MultiParty;
      }
      case (UTRAN34_C895) {
        v_ApplCond := pc_FDD and pc_CS and pc_SS_USSD;
      }
      case (UTRAN34_C896) {
        v_ApplCond := pc_SS_USSD and pc_MO_Serv and pc_FDD and pc_CS and pc_Speech;
      }
      case (UTRAN34_C897) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_CallForwardinoNoReply or pc_SS_CallForwardingUnconditional);
      }
      case (UTRAN34_C898) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_CallForwardingSubscriberBusy or pc_SS_CallForwardingSubscriberNotReachable);
      }
      case (UTRAN34_C899) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_CallForwardingSubscriberBusy or pc_SS_CallForwardingUnconditional);
      }
      case (UTRAN34_C900) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and (pc_SS_CallForwardingSubscriberBusy or pc_SS_CallForwardinoNoReply);
      }
      case (UTRAN34_C901) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_MT_Serv and pc_SS_CNAP;
      }
      case (UTRAN34_C902) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_MO_Serv and pc_SS_CNAP;
      }
      case (UTRAN34_C903) {
        v_ApplCond := pc_EAB;
      }
      case (UTRAN34_C904) {
        v_ApplCond := pc_EAB and pc_CS;
      }
      case (UTRAN34_C905) {
        v_ApplCond := pc_EAB and pc_PS;
      }
      case (UTRAN34_C907) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_CallWaitingSupp;
      }
      case (UTRAN34_C908) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_CallWaitingSupp and pc_SS_CallHold;
      }
      case (UTRAN34_C910) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_BOIC;
      }
      case (UTRAN34_C911) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_BAIC;
      }
      case (UTRAN34_C912) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_SS_BOIC_ExHC;
      }
      case (UTRAN34_C913) {
        v_ApplCond := pc_FDD and pc_Speech and pc_CS and pc_MT_Serv and pc_SS_USSD;
      }
      case (UTRAN34_C914) {
        v_ApplCond := pc_FDD and pc_Multiflow_HSDPA and pc_SB_SF_DC;
      }
      case (UTRAN34_C915) {
        v_ApplCond := pc_FDD and pc_Multiflow_HSDPA and pc_SB_DF_3C;
      }
      case (UTRAN34_C916) {
        v_ApplCond := pc_FDD and pc_Multiflow_HSDPA and pc_DB_DF_3C;
      }
      case else {
        v_ApplCond := false;
      }
    }
    return v_ApplCond;
  }

}
