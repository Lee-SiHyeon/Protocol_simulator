  template (value) RLC_SDU_Type   cs_MBMS_Packet14   := f_GetN_OctetsFromPRBS(130,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet15   := f_GetN_OctetsFromPRBS(140,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet16   := f_GetN_OctetsFromPRBS(150,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

