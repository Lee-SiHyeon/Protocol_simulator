  /*
   * @desc      Function to set the value of ECID Measurements from PICS values
   * @return    bitstring
   * @status    APPROVED (POS)
   */
  function fl_SetSupportedECIDMeas() return bitstring
  {
    var bitstring v_ECIDMeas := '000'B;

    if (pc_ECID_Rsrp) {
      v_ECIDMeas := replace(v_ECIDMeas, 0, 1, '1'B); // Set first bit to 1
    }
    if (pc_ECID_Rsrq) {
      v_ECIDMeas := replace(v_ECIDMeas, 1, 1, '1'B); // Set second bit to 1
    }
    if (pc_ECID_UeRxTx) {
      v_ECIDMeas := replace(v_ECIDMeas, 2, 1, '1'B); // Set third bit to 1
    }

    return v_ECIDMeas;
  }

  /*
   * @desc      Function to set the value of NR ECID Measurements from PICS values
   * @return    bitstring
   * @status    APPROVED (POS)
   */
  function fl_NR_SetSupportedECIDMeas() return bitstring
  {
    var bitstring v_ECIDMeas := '0000'B;

    if (pc_NR_ECID_SSRsrp) {
      v_ECIDMeas := replace(v_ECIDMeas, 0, 1, '1'B); // Set first bit to 1
    }
    if (pc_NR_ECID_SSRsrq) {
      v_ECIDMeas := replace(v_ECIDMeas, 1, 1, '1'B); // Set second bit to 1
    }
    if (pc_NR_ECID_CSIRsrp) {
      v_ECIDMeas := replace(v_ECIDMeas, 2, 1, '1'B); // Set third bit to 1
    }
    if (pc_NR_ECID_CSIRsrq) {
      v_ECIDMeas := replace(v_ECIDMeas, 3, 1, '1'B); // Set fourth bit to 1
    }

    return v_ECIDMeas;
  }

  template (value) LPP_Message cs_LppAcknowledgement(SequenceNumber p_SeqNumber) :=
  { /* @status    APPROVED (POS) */
    transactionID := omit,
    endTransaction := true,
    sequenceNumber := omit,
    acknowledgement := cs_Acknowledgement(false, p_SeqNumber),
    lpp_MessageBody := omit
  };

  template (value) A_GNSS_RequestAssistanceData cs_A_GNSS_RequestAssistanceData (template (value) GNSS_ReferenceTimeReq p_ReferenceTimeReq,
                                                                                 template (value) GNSS_IonosphericModelReq p_IonosphericModelReq,
                                                                                 template (value) GNSS_GenericAssistDataReq p_GenericAssistDataReq) :=
  { //@sic R5-172963 sic@
    /* @status    APPROVED (POS) */
    gnss_CommonAssistDataReq := cs_GNSS_CommonAssistDataReq(p_ReferenceTimeReq,
                                                            cs_GNSS_ReferenceLocationReq,
                                                            p_IonosphericModelReq),
    gnss_GenericAssistDataReq := p_GenericAssistDataReq,
    gnss_PeriodicAssistDataReq_r15 := omit /*@sic R5-180554 - BASELINE MOVING 2018 sic@ */
  };

  template (value) GNSS_GenericAssistDataReqElement cs_GenericAssistDataReqElement_GPS (integer p_SignalID) := //@sic R5-186628: added parameter sic@
    /* @status    APPROVED (POS) */
    cs_GNSS_GenericAssistDataReqElement(cs_GNSS_ID_Gps,
                                        -,
                                        cs_GNSS_NavigationModelReq_ReqNavList(tsc_SvID_1_11_17_20_23_28, true), //@sic R5s130618 sic@
                                        cs_GNSS_AcquisitionAssistanceReq(p_SignalID),
                                        cs_GNSS_AlmanacReq,
                                        cs_GNSS_UTC_ModelReq(1));  // See 36.355, GNSS-ID to modelID relation

  template (value) GNSS_GenericAssistDataReqElement cs_GenericAssistDataReqElement_GLONASS :=
    /* @status    APPROVED (POS) */
    cs_GNSS_GenericAssistDataReqElement(cs_GNSS_ID_Glonass,
                                        cs_GNSS_TimeModelListReq(cs_GNSS_TimeModelElementReq(1, true)), // GPS
                                        cs_GNSS_NavigationModelReq_ReqNavList(tsc_SvID_3_4_9_10_18_20, false),
                                        cs_GNSS_AcquisitionAssistanceReq(0),
                                        cs_GNSS_AlmanacReq,
                                        cs_GNSS_UTC_ModelReq(1));

  template (value) GNSS_GenericAssistDataReqElement cs_GenericAssistDataReqElement_Galileo :=
