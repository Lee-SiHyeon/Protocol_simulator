    ul_TargetSIR := p_UL_TargetSIR,
    timeInfo := {
      activationTime := p_ActivationTime,
      durationTimeInfo := omit
    },
    commonTimeslotInfo := {
      secondInterleavingMode := frameRelated,
      tfci_Coding := p_TFCI_Coding,
      puncturingLimit := p_PuncturingLimit,
      repetitionPeriodAndLength := {repetitionPeriod1:= NULL}
    },
    tddOption := p_TddOption
  };

