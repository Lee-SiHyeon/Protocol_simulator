module IPCAN_MCX_IpcanModel {

  import from CommonDefs all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from IpcanModel_IPCAN_Component all;
  import from MCX_CommonDefs all;
  import from MCX_CommonIPCAN all;
  import from MCX_IPCAN_ASP_TypeDefs all;
  import from MCX_Parameters all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  const MCX_IPCAN_AbsoluteCellPower_Type tsc_MCX_IPCAN_ServingCellRS_EPRE := -85;               /* @status    APPROVED (MCX) */

  template (value) MCX_IPCAN_ASP_CommonReqPart_Type cs_MCX_IPCAN_ASP_CommonReqPart(EUTRA_CellId_Type p_CellId,
                                                                                   boolean p_CnfFlag := true) :=
  { /* @status    APPROVED (MCX) */
    CellId := p_CellId,
    CnfFlag := p_CnfFlag
  };

  template (value) MCX_IPCAN_IPv4IPv6Address_Type cs_MCX_IPCAN_IPv4IPv6Address(charstring p_IPv4Address,
                                                                               charstring p_IPv6Address) :=
  { /* @status    APPROVED (MCX) */
    IPv4 := p_IPv4Address,
    IPv6 := p_IPv6Address
  };

  template (value) MCX_IPCAN_PDN_Info_Type cs_MCX_IPCAN_PDN_Info(MCX_Registration_PDN_Type p_PdnType,
                                                                 MCX_IPCAN_EpsBearerId_Type p_EpsBearerId,
                                                                 template (omit) MCX_IPCAN_IPv4IPv6Address_Type p_IPAddressNW,
                                                                 template (omit) MCX_IPCAN_IPv4IPv6Address_Type p_IPAddressUE) :=
  { /* @status    APPROVED (MCX) */
    PdnType := p_PdnType,
    EpsBearerId := p_EpsBearerId,
    IPAddressNW := p_IPAddressNW,
    IPAddressUE := p_IPAddressUE
  };

  template (value) MCX_IPCAN_PacketFilterComponent_Type cs_MCX_IPCAN_PacketFilterComponent_ProtocolUDP := { Protocol := 17 };   /* @status    APPROVED (MCX) */

  template (value) MCX_IPCAN_PacketFilterComponent_Type cs_MCX_IPCAN_PacketFilterComponent_ProtocolTCP := { Protocol := 6 };    /* @status    APPROVED (MCX) */

  template (value) MCX_IPCAN_PacketFilterComponent_Type cs_MCX_IPCAN_PacketFilterComponent_SingleRemotePort(integer p_PortNumber) := { SingleRemotePort := p_PortNumber };      /* @status    APPROVED (MCX) */

  template (value) MCX_IPCAN_PacketFilterComponent_Type cs_MCX_IPCAN_PacketFilterComponent_RemotePortRangeRTP(integer p_PortNumber) :=
  { /* @status    APPROVED (MCX) */
    RemotePortRange := {
      Low := p_PortNumber,
      High := p_PortNumber + 1
    }
  };

  template (value) MCX_IPCAN_PacketFilter_Type cs_MCX_IPCAN_PacketFilter_RTP(integer p_PortNumberRTP) :=
  { /* Table 6.6.2-5: Reference packet filter #4 */
    /* @status    APPROVED (MCX) */
    Direction := bidirectional,
    ComponentList := {
      cs_MCX_IPCAN_PacketFilterComponent_RemotePortRangeRTP(p_PortNumberRTP),
      cs_MCX_IPCAN_PacketFilterComponent_ProtocolUDP
    }
  };

  template (value) MCX_IPCAN_PacketFilter_Type cs_MCX_IPCAN_PacketFilter_RTCPAPP(integer p_PortNumberRTCPAPP) :=
  { /* Table 6.6.2-11: Reference packet filter #10 */
    /* @status    APPROVED (MCX) */
    Direction := bidirectional,
    ComponentList := {
      cs_MCX_IPCAN_PacketFilterComponent_SingleRemotePort(p_PortNumberRTCPAPP),
      cs_MCX_IPCAN_PacketFilterComponent_ProtocolUDP
    }
  };

  template (value) MCX_IPCAN_PacketFilter_Type cs_MCX_IPCAN_PacketFilter_MSRP(integer p_PortNumberMSRP := tsc_MCData_MediaPort_MSRP) :=
  { /* Table 6.6.2-11: Reference packet filter #11 */
    /* @status    APPROVED (MCX) */
    Direction := bidirectional,
    ComponentList := {
      cs_MCX_IPCAN_PacketFilterComponent_SingleRemotePort(p_PortNumberMSRP),
      cs_MCX_IPCAN_PacketFilterComponent_ProtocolTCP
    }
  };

  template (value) MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCPTT :=
  { /* 36.508 Table 6.6.2-1: Reference dedicated EPS bearer context #5
       According to 23.379 clause 5.7.3 there is one dedicated bearer for voice and MCPTT-4 reference point messaging; according to clause 7.3.1 MCPTT-4 reference point carries unicast floor control signalling */
    /* @status    APPROVED (MCX) */
    EpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCPTT,
    PacketFilterList := {
      cs_MCX_IPCAN_PacketFilter_RTP(tsc_MCX_MediaPort_Audio),
      cs_MCX_IPCAN_PacketFilter_RTCPAPP(tsc_MCX_MediaControlPortNW)
    }
  };

  template (value) MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCVideo :=
  { /* @status    APPROVED (MCX) */
    EpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCVideo,
    PacketFilterList := {
      cs_MCX_IPCAN_PacketFilter_RTP(tsc_MCX_MediaPort_Audio),
      cs_MCX_IPCAN_PacketFilter_RTP(tsc_MCX_MediaPort_Video),
      cs_MCX_IPCAN_PacketFilter_RTCPAPP(tsc_MCX_MediaControlPortNW)
    }
  };

  template (value) MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCData :=
  { /* @status    APPROVED (MCX) */
    EpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCData,
    PacketFilterList := {
      cs_MCX_IPCAN_PacketFilter_MSRP
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_InitRequest :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(eutra_Cell_NonSpecific),
    Request := {
      Init := {}
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_CellConfigRequest(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId),
    Request := {
      CellConfig := {}
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_CellPowerRequest(EUTRA_CellId_Type p_CellId,
                                                                           MCX_IPCAN_AbsoluteCellPower_Type p_AbsoluteCellPower := tsc_MCX_IPCAN_ServingCellRS_EPRE) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId, false),   // no confirmation requested
    Request := {
      CellPower := {
        AbsoluteCellPower := p_AbsoluteCellPower
      }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_InitialRegistrationRequest(EUTRA_CellId_Type p_CellId,
                                                                                     boolean p_CnfFlag,
                                                                                     template (value) MCX_IPCAN_PDN_InfoList_Type p_PdnList,
                                                                                     octetstring p_DefaultAPN := px_AccessPointName) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId, p_CnfFlag),
    Request := {
      InitialRegistration := {
        PdnList := p_PdnList,
        DefaultAPN := p_DefaultAPN
      }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_AdditionalRegistrationMCXRequest(EUTRA_CellId_Type p_CellId,
                                                                                           MCX_IPCAN_EpsBearerId_Type p_EpsBearerId) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId, false),   // no confirmation requested
    Request := {
      AdditionalRegistrationMCX := {
        EpsBearerId := p_EpsBearerId
      }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_RRCConnectionSetupRequest_MO(EUTRA_CellId_Type p_CellId,
                                                                                       MCX_IPCAN_EpsBearerIdList_Type p_DedicatedEpsBearers := {}) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId, false),   // no confirmation requested
    Request := {
      RRCConnectionSetupMO := {
        DedicatedEpsBearers := p_DedicatedEpsBearers
      }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_RRCConnectionSetupRequest_MT(EUTRA_CellId_Type p_CellId,
                                                                                       MCX_IPCAN_EpsBearerIdList_Type p_DedicatedEpsBearers := {}) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId),
    Request := {
      RRCConnectionSetupMT := {
        DedicatedEpsBearers := p_DedicatedEpsBearers
      }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(EUTRA_CellId_Type p_CellId,
                                                                                               template (value) MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type p_DedicatedEpsBearer) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId),
    Request := {
      ActivateDedicatedEpsBearerMCX := { p_DedicatedEpsBearer }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_DeactivateDedicatedEpsBearerRequestMCX(EUTRA_CellId_Type p_CellId,
                                                                                                 MCX_IPCAN_EpsBearerId_Type p_EpsBearerId) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId),
    Request := {
      DeactivateDedicatedEpsBearerMCX := { p_EpsBearerId }
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_RRCConnectionReleaseRequest(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(p_CellId),
    Request := {
      RRCConnectionRelease := {}
    }
  };

  template (value) MCX_IPCAN_SYSTEM_CTRL_REQ cs_MCX_IPCAN_ReleaseRequest :=
  { /* @status    APPROVED (MCX) */
    Common := cs_MCX_IPCAN_ASP_CommonReqPart(eutra_Cell_NonSpecific),
    Request := {
      Release := {}
    }
  };

  template (present) MCX_IPCAN_SystemConfirmation_Type cr_MCX_IPCAN_SystemConfirmation_Init := { Init := ? };           /* @status    APPROVED (MCX) */

  template (present) MCX_IPCAN_SystemConfirmation_Type cr_MCX_IPCAN_SystemConfirmation_Other := { Other := true };      /* @status    APPROVED (MCX) */

  template (present) MCX_IPCAN_SystemConfirmation_Type cr_MCX_IPCAN_SystemConfirmation_Error := { Error := ? };         /* @status    APPROVED (MCX) */

  template (present) MCX_IPCAN_SYSTEM_CTRL_CNF cr_MCX_IPCAN_SYSTEM_CTRL_CNF(template (present) MCX_IPCAN_SystemConfirmation_Type p_Confirmation) :=
  { /* @status    APPROVED (MCX) */
    Confirmation := p_Confirmation
  };

  /*
   * @desc      Send configuration request to the system simulator and wait for confirmation
   * @param     p_SYSTEM_CTRL_REQ
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_SystemConfig(template (value) MCX_IPCAN_SYSTEM_CTRL_REQ p_SYSTEM_CTRL_REQ) runs on IpcanModel_IPCAN_PTC
  {
    var MCX_IPCAN_SYSTEM_CTRL_CNF v_MCX_IPCAN_SYSTEM_CTRL_CNF ;
    var boolean v_IsSystemInit := ischosen(p_SYSTEM_CTRL_REQ.Request.Init);

    IPCANSYS.send(p_SYSTEM_CTRL_REQ);
    if (match(true, p_SYSTEM_CTRL_REQ.Common.CnfFlag)) {
      alt {
        [v_IsSystemInit] IPCANSYS.receive(cr_MCX_IPCAN_SYSTEM_CTRL_CNF(cr_MCX_IPCAN_SystemConfirmation_Init)) -> value v_MCX_IPCAN_SYSTEM_CTRL_CNF {
          f_MCX_IpcanModel_SetRanType(v_MCX_IPCAN_SYSTEM_CTRL_CNF.Confirmation.Init.RanType);
        }
        [] IPCANSYS.receive(cr_MCX_IPCAN_SYSTEM_CTRL_CNF(cr_MCX_IPCAN_SystemConfirmation_Other)) {
        }
        [] IPCANSYS.receive(cr_MCX_IPCAN_SYSTEM_CTRL_CNF(cr_MCX_IPCAN_SystemConfirmation_Error)) -> value v_MCX_IPCAN_SYSTEM_CTRL_CNF {
          f_SetVerdictInconc(__FILE__, __LINE__, "Error indication from IPCAN (" & v_MCX_IPCAN_SYSTEM_CTRL_CNF.Confirmation.Error & ")");
        }
      }
    }
  }

  /*
   * @desc      Return DRB Id associated to the EPS bearer according to 36.508
   * @param     p_EpsBearerId
   * @return    integer
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_EpsBearerAssociatedDRB(MCX_IPCAN_EpsBearerId_Type p_EpsBearerId) return integer
  {
    return (p_EpsBearerId - 4);
  }

  template (value) IP_DrbInfo_Type cs_MCX_IpcanModel_DrbInfoMCX(EUTRA_CellId_Type p_CellId,
                                                                MCX_IPCAN_EpsBearerId_Type p_EpsBearerId := px_MCX_IPCAN_EpsBearerId_MCX) :=
  /* @status    APPROVED (MCX) */
    cs_DrbInfo_EUTRA(p_CellId, f_MCX_IpcanModel_EpsBearerAssociatedDRB(p_EpsBearerId));

  template (value) IP_DrbInfo_Type cs_MCX_IpcanModel_DrbInfoMCPTT(EUTRA_CellId_Type p_CellId) := cs_MCX_IpcanModel_DrbInfoMCX(p_CellId, px_MCX_IPCAN_DedicatedEpsBearerId_MCPTT);       /* @status    APPROVED (MCX) */

  template (value) IP_DrbInfo_Type cs_MCX_IpcanModel_DrbInfoMCVideo(EUTRA_CellId_Type p_CellId) := cs_MCX_IpcanModel_DrbInfoMCX(p_CellId, px_MCX_IPCAN_DedicatedEpsBearerId_MCVideo);   /* @status    APPROVED (MCX) */

  /*
   * @desc      return IPCAN information to be sent to the IMS PTC
   * @return    template (value) IPCAN_INFO_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_IMS_IpcanInfo() runs on IpcanModel_IPCAN_PTC return template (value) IPCAN_INFO_Type
  {
    var template (omit) IPCAN_RAN_Type v_RanType := f_MCX_IpcanModel_GetRanType();
    var template (omit) integer v_UE_Release := omit;      // no UE release available for IpcanModel
    var integer v_AuthResLength := 16;                     // most common value; may need to be retrieved from the SS or the UE
    var boolean v_NetworkSupportsVoiceOverIMS := true;
    return cs_IPCAN_INFO(v_RanType, v_UE_Release, v_AuthResLength, v_NetworkSupportsVoiceOverIMS);
  }

  /*
   * @desc      Initialise IPCAN
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_IPCAN_Init(IMS_IPCAN_CO_ORD_PORT p_Port,
                                       EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_Init();
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_InitRequest);
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_CellConfigRequest(p_CellId));
    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IPCAN_IMS_Response(IPCAN_INIT));
  }

  /*
   * @desc      Initial registration (36.579-1 clause 5.4.2)
   *            NOTE: after MCX registration the UE remains in RRC_CONNECTED
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_InitialRegistration(IMS_IPCAN_CO_ORD_PORT p_Port,
                                                EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    var MCX_Registration_PDN_Type v_PdnTypeList[3] := {px_MCX_InitialRegistration_TypeOfPDN1, px_MCX_InitialRegistration_TypeOfPDN2, px_MCX_InitialRegistration_TypeOfPDN3};
    var boolean v_AutomaticRegistrationMCX := false;
    var template (omit) MCX_IPCAN_IPv4IPv6Address_Type v_IPAddressNW := omit;
    var template (omit) MCX_IPCAN_IPv4IPv6Address_Type v_IPAddressUE := omit;
    var MCX_IPCAN_EpsBearerId_Type  v_EpsBearerId;
    var template (value) MCX_IPCAN_PDN_InfoList_Type v_PdnInfoList;
    var boolean v_CnfFlag;
    var integer i;

    for (i := 0; i < lengthof(v_PdnTypeList); i := i + 1) {    // 36.579-1 clause 5.4.1A
      select (v_PdnTypeList[i]) {
        case (mcxPDN) {
          v_EpsBearerId := px_MCX_IPCAN_EpsBearerId_MCX;
          v_AutomaticRegistrationMCX := true;
        }
        case (imsPDN) {
          v_EpsBearerId := px_MCX_IPCAN_EpsBearerId_IMS;
          v_IPAddressNW := cs_MCX_IPCAN_IPv4IPv6Address(px_IPv4_Address2_NW, px_IPv6_Address2_NW);
          v_IPAddressUE := cs_MCX_IPCAN_IPv4IPv6Address(px_IPv4_Address2_UE, px_IPv6_Address2_UE);
        }
        case (internetPDN) {
          v_EpsBearerId := px_MCX_IPCAN_EpsBearerId_INTERNET;
          v_IPAddressNW := cs_MCX_IPCAN_IPv4IPv6Address(px_IPv4_Address3_NW, px_IPv6_Address3_NW);
          v_IPAddressUE := cs_MCX_IPCAN_IPv4IPv6Address(px_IPv4_Address3_UE, px_IPv6_Address3_UE);
        }
        case else {
          break;
        }
      }
      v_PdnInfoList[i] := cs_MCX_IPCAN_PDN_Info(v_PdnTypeList[i], v_EpsBearerId, v_IPAddressNW, v_IPAddressUE);
    }

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_CellPowerRequest(p_CellId));

    f_IP_Handling_StartPDN(IP, PDN_1, cs_MCX_IpcanModel_DrbInfoMCX(p_CellId));
    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IPCAN_IMS_DrbInfo(cs_DrbInfo_EUTRA(p_CellId, f_MCX_IpcanModel_EpsBearerAssociatedDRB(px_MCX_IPCAN_EpsBearerId_MCX))));   // start media control handler and HTTP servers

    f_IMS_IPCAN_WaitForTrigger(p_Port);   // Wait until HTTP servers are started

    // 36.579-1 Table 5.4.2.1.2-1 step 1:
    f_UT_SwitchOnUE(UT);

    // 36.579-1 Table 5.4.2.2.3-1 step 2 - 16A:
    v_CnfFlag := not v_AutomaticRegistrationMCX;     // when MCX registration is part of initial registration no confirmation is needed
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_InitialRegistrationRequest(p_CellId, v_CnfFlag, v_PdnInfoList));

    if (not v_AutomaticRegistrationMCX) {
      // 36.579-1 Table 5.4.2.2.3-1 step 17:
      f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionReleaseRequest(p_CellId));
      // 36.579-1 Table 5.4.2.2.3-1 step 18:
      f_UT_MCX_UserAction(UT, "Make the UE (MCX client) request service authorisation/configuration");
      // 36.579-1 Table 5.4.2.2.3-1 step 19 - 26:
      f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_AdditionalRegistrationMCXRequest(p_CellId, px_MCX_IPCAN_EpsBearerId_MCX));
    }
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MO speech call
   * @param     p_Port
   * @param     p_CellId
   * @param     p_RRCConnectionEstablished
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MO_SpeechCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                          EUTRA_CellId_Type p_CellId,
                                          boolean p_RRCConnectionEstablished) runs on IpcanModel_IPCAN_PTC
  {
    if (not p_RRCConnectionEstablished) { // for some test cases the RRC connection is established already when a call shall be established (e.g. TC_6_2_25_MCPTT, TC_6_2_26_MCPTT)
      f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MO(p_CellId));
    }

    f_IMS_IPCAN_WaitForTrigger(p_Port);

    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Audio, cs_MCX_IpcanModel_DrbInfoMCPTT(p_CellId));

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCPTT));

    // NOTE: there is no coordination message as the UE should not send the ACK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MT speech call
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MT_SpeechCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                          EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MT(p_CellId));
    
    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Audio, cs_MCX_IpcanModel_DrbInfoMCPTT(p_CellId));

    f_IMS_IPCAN_SendCoOrdMsg(p_Port);                       // trigger IMS PTC to start MT call establishment

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCPTT));

    // NOTE: there is no coordination message as the UE should not send the 200 OK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MO video call
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MO_VideoCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                         EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MO(p_CellId));

    f_IMS_IPCAN_WaitForTrigger(p_Port);

    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Audio, cs_MCX_IpcanModel_DrbInfoMCPTT(p_CellId));
    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Video, cs_MCX_IpcanModel_DrbInfoMCVideo(p_CellId));

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCVideo));

    // NOTE: there is no coordination message as the UE should not send the ACK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MT video call
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MT_VideoCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                         EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MT(p_CellId));
    
    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Audio, cs_MCX_IpcanModel_DrbInfoMCPTT(p_CellId));
    f_IP_RtpRtcpLoopback(IP, PDN_1, tsc_MCX_MediaPort_Video, cs_MCX_IpcanModel_DrbInfoMCVideo(p_CellId));

    f_IMS_IPCAN_SendCoOrdMsg(p_Port);                       // trigger IMS PTC to start MT call establishment

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCVideo));

    // NOTE: there is no coordination message as the UE should not send the 200 OK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MO data call
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MO_DataCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                        EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    var integer v_MCDataDedicatedDrbId := f_MCX_IpcanModel_EpsBearerAssociatedDRB(px_MCX_IPCAN_DedicatedEpsBearerId_MCData);

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MO(p_CellId));

    f_IMS_IPCAN_WaitForTrigger(p_Port);
    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IPCAN_IMS_DrbInfo(cs_DrbInfo_EUTRA(p_CellId, v_MCDataDedicatedDrbId)));     // IMS_PTC needs to know the DRB info in order to start the MSRP server

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCData));

    // NOTE: there is no coordination message as the UE should not send the ACK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection with EPS bearer for MT data call
   * @param     p_Port
   * @param     p_CellId
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MT_DataCall(IMS_IPCAN_CO_ORD_PORT p_Port,
                                        EUTRA_CellId_Type p_CellId) runs on IpcanModel_IPCAN_PTC
  {
    var integer v_MCDataDedicatedDrbId := f_MCX_IpcanModel_EpsBearerAssociatedDRB(px_MCX_IPCAN_DedicatedEpsBearerId_MCData);

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MT(p_CellId));
    
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);                                                                             // common trigger to start MT call establishment at IMS PTC (expected in f_MCX_IPCAN_StartSignalling)
    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IPCAN_IMS_DrbInfo(cs_DrbInfo_EUTRA(p_CellId, v_MCDataDedicatedDrbId)));  // MCData specific coordination message with DRB info (needed in f_MCData_CallSetupMT: f_IMS_IPCAN_GetDrbInfo)

    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ActivateDedicatedEpsBearerRequestMCX(p_CellId, cs_MCX_IPCAN_ASP_DedicatedEpsBearerInfo_MCData));

    // NOTE: there is no coordination message as the UE should not send the 200 OK when it does not have all resources yet
  }

  /*
   * @desc      Configure RRC connection for MO SIP signalling
   * @param     p_CellId
   * @param     p_DedicatedEpsBearers
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MO_IMS_Signalling(EUTRA_CellId_Type p_CellId,
                                              MCX_IPCAN_EpsBearerIdList_Type p_DedicatedEpsBearers) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MO(p_CellId, p_DedicatedEpsBearers));
  }

  /*
   * @desc      Configure RRC connection for MT SIP signalling
   * @param     p_Port
   * @param     p_CellId
   * @param     p_DedicatedEpsBearers
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MT_IMS_Signalling(IMS_IPCAN_CO_ORD_PORT p_Port,
                                              EUTRA_CellId_Type p_CellId,
                                              MCX_IPCAN_EpsBearerIdList_Type p_DedicatedEpsBearers) runs on IpcanModel_IPCAN_PTC
  {
    f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionSetupRequest_MT(p_CellId, p_DedicatedEpsBearers));
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);       // trigger IMS PTC to do IMS signalling after RRC connection establishment
  }

  /*
   * @desc      Start IPCAN procedure
   * @param     p_Port
   * @param     p_CellId
   * @param     p_ProcedureType
   * @param     p_RRCConnectionEstablished
   * @param     p_DedicatedEpsBearers (default value: {})
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_IPCAN_StartProcedure(IMS_IPCAN_CO_ORD_PORT p_Port,
                                                 EUTRA_CellId_Type p_CellId,
                                                 IMS_TestProcedure_Type p_ProcedureType,
                                                 boolean p_RRCConnectionEstablished,
                                                 MCX_IPCAN_EpsBearerIdList_Type p_DedicatedEpsBearers := {}) runs on IpcanModel_IPCAN_PTC
  { /* p_RRCConnectionEstablished: for some test cases the RRC connection is established already when a call shall be established (e.g. TC_6_2_25_MCPTT, TC_6_2_26_MCPTT) */

    select (p_ProcedureType) {
      case (IPCAN_InitialRegistration) {
        f_MCX_IpcanModel_InitialRegistration(p_Port, p_CellId);
      }
      case (IPCAN_MO_SpeechCall) {
        f_MCX_IpcanModel_MO_SpeechCall(p_Port, p_CellId, p_RRCConnectionEstablished);
      }
      case (IPCAN_MT_SpeechCall) {
        f_MCX_IpcanModel_MT_SpeechCall(p_Port, p_CellId);
      }
      case (IPCAN_MO_VideoCall) {
        f_MCX_IpcanModel_MO_VideoCall(p_Port, p_CellId);
      }
      case (IPCAN_MT_VideoCall) {
        f_MCX_IpcanModel_MT_VideoCall(p_Port, p_CellId);
      }
      case (IPCAN_MO_DataCall) {
        f_MCX_IpcanModel_MO_DataCall(p_Port, p_CellId);
      }
      case (IPCAN_MT_DataCall) {
        f_MCX_IpcanModel_MT_DataCall(p_Port, p_CellId);
      }
      case (IPCAN_MO_IMS_Signalling) {
        f_MCX_IpcanModel_MO_IMS_Signalling(p_CellId, p_DedicatedEpsBearers);
      }
      case (IPCAN_MT_IMS_Signalling) {
        f_MCX_IpcanModel_MT_IMS_Signalling(p_Port, p_CellId, p_DedicatedEpsBearers);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid IPCAN procedure type");
      }
    }
  }

  /*
   * @desc      End IPCAN procedure: return false when the RRC connection is release, true if it is kept (MCData call)
   * @param     p_Port
   * @param     p_CellId
   * @param     p_ProcedureType
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_IPCAN_EndProcedure(IMS_IPCAN_CO_ORD_PORT p_Port,
                                               EUTRA_CellId_Type p_CellId,
                                               IMS_TestProcedure_Type p_ProcedureType) runs on IpcanModel_IPCAN_PTC return boolean
  {
    var template (omit) MCX_IPCAN_EpsBearerId_Type v_DedicatedEpsBearerId := omit;
    var boolean v_ReleaseRRC := true;

    select (p_ProcedureType) {
      case (IPCAN_InitialRegistration) {
      }
      case (IPCAN_MO_SpeechCall, IPCAN_MT_SpeechCall) {
        v_DedicatedEpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCPTT;
      }
      case (IPCAN_MO_VideoCall, IPCAN_MT_VideoCall) {
        v_DedicatedEpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCVideo;
      }
      case (IPCAN_MO_DataCall, IPCAN_MT_DataCall) {
        v_DedicatedEpsBearerId := px_MCX_IPCAN_DedicatedEpsBearerId_MCData;
        v_ReleaseRRC := false;   // in case of MCData only the dedicated bearer is released as further SIP signalling may follow
      }
      case (IPCAN_MO_IMS_Signalling) {
      }
      case (IPCAN_MT_IMS_Signalling) {
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid IPCAN procedure type");
      }
    }
    if (isvalue(v_DedicatedEpsBearerId)) {
      f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_DeactivateDedicatedEpsBearerRequestMCX(p_CellId, valueof(v_DedicatedEpsBearerId)));
    }
    
    if (v_ReleaseRRC) {
      f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_RRCConnectionReleaseRequest(p_CellId));
    }
    f_IMS_IPCAN_SendCoOrdMsg(p_Port);

    return (not v_ReleaseRRC);
  }

  /*
   * @desc      Main loop to handle commands from the IMS PTC:
   *            - IPCAN_INIT
   *            - IPCAN_STARTPROCEDURE  (procedure)
   *            - IPCAN_ENDPROCEDURE    (procedure)
   *            - IPCAN_RELEASE
   * @status    APPROVED (MCX)
   */
  function f_MCX_IpcanModel_MainLoop() runs on IpcanModel_IPCAN_PTC
  {
    var EUTRA_CellId_Type v_CellId := eutra_Cell1;
    var IMS_IPCAN_Coordination_MSG v_IMS_IPCAN_Coordination_MSG;
    var IMS_IPCAN_Command_Type v_Command;
    var IMS_TestProcedure_Type v_CurrentTestProcedure;
    var IMS_TestProcedure_Type v_ProcedureToBeEnded;
    var IMS_TestProcedure_Type v_TestProcedure;
    var integer v_PdnIndex := tsc_Index_IMS1;
    var MCX_IPCAN_EpsBearerIdList_Type v_DedicatedEpsBearers;
    var boolean v_IsPreestablishedSession := false;
    var boolean v_RRCConnectionEstablished := false;
    var boolean v_Done := false;

    while (not v_Done) {

      IMS[v_PdnIndex].receive(cmr_IMS_IPCAN_Command) -> value v_IMS_IPCAN_Coordination_MSG;
      v_Command := v_IMS_IPCAN_Coordination_MSG.IMS_IPCAN_Command;

      select (v_Command.Name) {
        case (IPCAN_INIT) {
          f_MCX_IpcanModel_IPCAN_Init(IMS[v_PdnIndex], v_CellId);
        }
        case (IPCAN_STARTPROCEDURE) {
          if (v_IsPreestablishedSession) {
            select (v_CurrentTestProcedure) {     // NOTE: TestCast warning "Uninitialized variable" can be ignored as v_CurrentTestProcedure is initialised when v_IsPreestablishedSession is true
              case (IPCAN_MO_SpeechCall) {
                v_DedicatedEpsBearers := { px_MCX_IPCAN_DedicatedEpsBearerId_MCPTT };
              }
              case (IPCAN_MO_VideoCall) {
                v_DedicatedEpsBearers := { px_MCX_IPCAN_DedicatedEpsBearerId_MCVideo };
              }
              case (IPCAN_MO_DataCall) {
                v_DedicatedEpsBearers := { px_MCX_IPCAN_DedicatedEpsBearerId_MCData };
              }
              case else {
                FatalError(__FILE__, __LINE__, "invalid procedure");
              }
            }
            select (v_Command.TestProcedure) {
              case (IPCAN_MO_SpeechCall, IPCAN_MO_VideoCall, IPCAN_MO_DataCall, IPCAN_MO_IMS_Signalling) {
                v_TestProcedure := IPCAN_MO_IMS_Signalling;
              }
              case (IPCAN_MT_SpeechCall, IPCAN_MT_VideoCall, IPCAN_MT_DataCall, IPCAN_MT_IMS_Signalling) {
                v_TestProcedure := IPCAN_MT_IMS_Signalling;
              }
              case else {
                FatalError(__FILE__, __LINE__, "invalid procedure");
              }
            }
            f_MCX_IpcanModel_IPCAN_StartProcedure(IMS[v_PdnIndex], v_CellId, v_TestProcedure, v_RRCConnectionEstablished, v_DedicatedEpsBearers);
          }
          else {
            v_CurrentTestProcedure := v_Command.TestProcedure;
            f_MCX_IpcanModel_IPCAN_StartProcedure(IMS[v_PdnIndex], v_CellId, v_CurrentTestProcedure, v_RRCConnectionEstablished);
          }
          v_RRCConnectionEstablished := true;
        }
        case (IPCAN_ENDPROCEDURE) {
          if (isvalue(v_Command.TestProcedure)) {  /* preestablished session: TestProcedure shall be either IPCAN_MO_IMS_Signalling or IPCAN_MT_IMS_Signalling to indicate release of the RRC connection (only) */
            v_ProcedureToBeEnded := v_Command.TestProcedure;
            v_IsPreestablishedSession := true;
          } else {                                 /* => no preestablished session */
            v_ProcedureToBeEnded := v_CurrentTestProcedure;
            v_IsPreestablishedSession := false;
          }
          v_RRCConnectionEstablished := f_MCX_IpcanModel_IPCAN_EndProcedure(IMS[v_PdnIndex], v_CellId, v_ProcedureToBeEnded);
          if (v_RRCConnectionEstablished) {                             /* => dedicated bearers have been released, but RRC Connection has been kept */
            v_CurrentTestProcedure := IPCAN_MO_IMS_Signalling;          /* IPCAN_MO_IMS_Signalling is as good as IPCAN_MT_IMS_Signalling: there is an RRC connection but no dedicated bearer */
          }
        }
        case (IPCAN_RELEASE) {
          f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);
          f_MCX_IpcanModel_SystemConfig(cs_MCX_IPCAN_ReleaseRequest);
          f_IMS_IPCAN_SendCoOrdMsg(IMS[v_PdnIndex]);
          v_Done := true;
        }
        case (IPCAN_QUERY) {
          IMS[v_PdnIndex].send(cms_IPCAN_IMS_QueryResponse(f_MCX_IpcanModel_IMS_IpcanInfo()));
        }
        case (IPCAN_PROVIDELOCATIONINFORMATION) {
          FatalError(__FILE__, __LINE__, "'IPCAN_PROVIDELOCATIONINFORMATION' not implemented for IpcanModel");  /* only used in (EUTRA) emergency call test cases */
        }
        case else {
          FatalError(__FILE__, __LINE__, "invalid command");
        }
      }
    }
  }

}
