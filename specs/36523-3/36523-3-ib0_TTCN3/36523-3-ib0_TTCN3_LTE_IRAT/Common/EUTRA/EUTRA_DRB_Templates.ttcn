module EUTRA_DRB_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_ASP_DrbDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_AspCommon_Templates all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_NB_ASP_L2DataDefs all;
  import from EUTRA_NB_CommonDefs all;

  const integer tsc_LogicalChannelPriorityLo := 13; /* According to 36.508 cl. 4.8.2.1.4 Table 4.8.2.1.4-1;     @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  const integer tsc_LogicalChannelPriorityHi := 6;  /* According to 36.508 cl. 4.8.2.1.4 Table 4.8.2.1.4-1;     @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) PDCP_Config.headerCompression cs_PDCP_Config_HeaderCompressionNotUsed := {notUsed := NULL}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) PDCP_Config cs_508_PDCP_Config_DRB_UM(PDCP_Config.discardTimer p_DiscardTimer := ms100,
                                                         template (value) PDCP_Config.rlc_UM.pdcp_SN_Size p_PDCP_SN_Size := len12bits,
                                                         template (value) PDCP_Config.headerCompression p_HeaderCompression := cs_PDCP_Config_HeaderCompressionNotUsed,
                                                         template (omit) PDCP_Config.ethernetHeaderCompression_r16 p_EthernetHeaderCompression_r16 := omit) :=
  { /* Default values according to 36.508 cl. 4.8.2.1.2.1 Table 4.8.2.1.2.1-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    discardTimer := p_DiscardTimer,
    rlc_AM := omit,
    rlc_UM := {
      pdcp_SN_Size := p_PDCP_SN_Size
    },
    headerCompression := p_HeaderCompression,
    rn_IntegrityProtection_r10 := omit,         /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
    pdcp_SN_Size_v1130 := omit,                 /* @sic R5s130195 BASELINE MOVING 2013 sic@ */
    ul_DataSplitDRB_ViaSCG_r12 := omit,         /* @sic BASELINE MOVING 2015 sic@ */
    t_Reordering_r12 := omit,                   /* @sic BASELINE MOVING 2015 sic@ */
    ul_DataSplitThreshold_r13 := omit,          /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    pdcp_SN_Size_v1310 := omit,                 /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    statusFeedback_r13 := omit,                 /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    ul_LWA_Config_r14  := omit,                 /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    uplinkOnlyHeaderCompression_r14 := omit,    /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    uplinkDataCompression_r15 := omit,          /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    pdcp_DuplicationConfig_r15 := omit,         /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    ethernetHeaderCompression_r16 := p_EthernetHeaderCompression_r16,      /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
    discardTimerExt_r17 := omit                 /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) PDCP_Config cs_508_PDCP_Config_DRB_AM :=
  { /* Default values according to 36.508 cl. 4.8.2.1.2.2 Table 4.8.2.1.2.2-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    discardTimer := infinity_,
    rlc_AM := {
      statusReportRequired := true
    },
    rlc_UM := omit,
    headerCompression := {
      notUsed := NULL
    },
    rn_IntegrityProtection_r10 := omit,         /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
    pdcp_SN_Size_v1130 := omit,                 /* @sic R5s130195 BASELINE MOVING 2013 sic@ */
    ul_DataSplitDRB_ViaSCG_r12 := omit,         /* @sic BASELINE MOVING 2015 sic@ */
    t_Reordering_r12 := omit,                   /* @sic BASELINE MOVING 2015 sic@ */
    ul_DataSplitThreshold_r13 := omit,          /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    pdcp_SN_Size_v1310 := omit,                 /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    statusFeedback_r13 := omit,                 /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    ul_LWA_Config_r14  := omit,                 /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    uplinkOnlyHeaderCompression_r14 := omit,    /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    uplinkDataCompression_r15 := omit,          /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    pdcp_DuplicationConfig_r15 := omit,         /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    ethernetHeaderCompression_r16 := omit,      /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
    discardTimerExt_r17 := omit                 /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) UL_AM_RLC cs_508_DRB_UL_AM_RLC :=
  { /*  Default values according to 36.508 cl. 4.8.2.1.3.2 Table 4.8.2.1.3.2-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    t_PollRetransmit := ms80,
    pollPDU := p128,
    pollByte := kB125,
    maxRetxThreshold := t4
  };

  template (value) DL_AM_RLC cs_508_DRB_DL_AM_RLC :=
  { /* Default values according to 36.508 cl. 4.8.2.1.3.2 Table 4.8.2.1.3.2-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    t_Reordering := ms80,
    t_StatusProhibit := ms60
  };

  template (value) UL_UM_RLC cs_508_DRB_UL_UM_RLC :=
  { /* Default values according to 36.508 cl. 4.8.2.1.3.1 Table 4.8.2.1.3.1-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    sn_FieldLength := size10
  };

  template (value) DL_UM_RLC cs_508_DRB_DL_UM_RLC :=
  { /* Default values according to 36.508 cl. 4.8.2.1.3.1 Table 4.8.2.1.3.1-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    sn_FieldLength := size10,
    t_Reordering := ms50
  };

  template (value) DL_UM_RLC cds_RX_UM_RLC_DRB_SN10_tReord55ms modifies cs_508_DRB_DL_UM_RLC :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT) */
    t_Reordering := ms55
  };

  template (value) RLC_Config cs_508_RLC_Config_DRB_UM(template (value) UL_UM_RLC p_DRB_UL_UM_RLC := cs_508_DRB_UL_UM_RLC,
                                                       template (value) DL_UM_RLC p_DRB_DL_UM_RLC := cs_508_DRB_DL_UM_RLC) :=
                                                       
  { /* Default values according to 36.508 cl. 4.8.2.1.3.1 Table 4.8.2.1.3.1-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s100469 Additional Changes sic@ */
    um_Bi_Directional := {
      ul_UM_RLC := p_DRB_UL_UM_RLC,
      dl_UM_RLC := p_DRB_DL_UM_RLC
    }
  };

  template (value) RLC_Config cs_508_RLC_Config_DRB_AM(template (value) UL_AM_RLC p_DRB_UL_AM_RLC := cs_508_DRB_UL_AM_RLC,
                                                       template (value) DL_AM_RLC p_DRB_DL_AM_RLC := cs_508_DRB_DL_AM_RLC) :=
  { /* Default values according to 36.508 cl. 4.8.2.1.3.2 Table 4.8.2.1.3.2-1 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s100469 Additional Changes sic@ */
    am := {
      ul_AM_RLC := p_DRB_UL_AM_RLC,
      dl_AM_RLC := p_DRB_DL_AM_RLC
    }
  };

  template (value) RLC_Configuration_Type cs_RLC_Configuration_AM(template (value) UL_AM_RLC p_DRB_UL_AM_RLC := cs_508_DRB_UL_AM_RLC,
                                                                  template (value) DL_AM_RLC p_DRB_DL_AM_RLC := cs_508_DRB_DL_AM_RLC) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s100469 Additional Changes sic@ */
    Rb := {
      AM := {
        Tx := cs_UL_AM_RLC_r8(p_DRB_UL_AM_RLC),
        Rx := cs_DL_AM_RLC_r8(p_DRB_DL_AM_RLC),
        ExtendedLI := omit
      }
    },
    TestMode := {
      None := true //as this template is not to be used for RLC testing
    }
  };

  template (value) RLC_Configuration_Type cs_RLC_Configuration_UM(template (value) UL_UM_RLC p_DRB_UL_UM_RLC := cs_508_DRB_UL_UM_RLC,
                                                                  template (value) DL_UM_RLC p_DRB_DL_UM_RLC := cs_508_DRB_DL_UM_RLC) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s100469 Additional Changes sic@ */
    Rb := {
      UM := {
        Tx := cs_UL_UM_RLC_r8(p_DRB_UL_UM_RLC),
        Rx := cs_DL_UM_RLC_r8(p_DRB_DL_UM_RLC)
      }
    },
    TestMode := {
      None := true //as this template is not to be used for RLC testing
    }
  };

  template (value) LogicalChannelConfig.ul_SpecificParameters cs_LogicalChannelConfigULParameters(integer p_Priority := tsc_LogicalChannelPriorityHi,
                                                                                                  PrioritizedBitRate_Type p_PrioritizedBitRate := kBps0,
                                                                                                  LogicalChannelConfig_BucketSizeDuration_Type p_BucketSizeDuration := ms100,
                                                                                                  integer p_LCG := 1) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    priority := p_Priority,
    prioritisedBitRate := p_PrioritizedBitRate,
    bucketSizeDuration := p_BucketSizeDuration,
    logicalChannelGroup := p_LCG
  };

  template (value) LogicalChannelConfig cs_LogicalChannelConfig(template (value) LogicalChannelConfig.ul_SpecificParameters p_LogicalChannelConfigULParameters,
                                                                template (omit) boolean p_Laa_UL_Allowed := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    ul_SpecificParameters := p_LogicalChannelConfigULParameters,
    logicalChannelSR_Mask_r9 := omit,          /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
    logicalChannelSR_Prohibit_r12 := omit,     /* @sic BASELINE MOVING 2015 sic@ */
    laa_UL_Allowed_r14 := p_Laa_UL_Allowed,    /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    bitRateQueryProhibitTimer_r14 := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    allowedTTI_Lengths_r15 := omit,            /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    logicalChannelSR_Restriction_r15 := omit,  /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    channelAccessPriority_r15 := omit,         /* @sic R5s180552 BASELINE MOVING 2018  R5s201386 BASELINE MOVING 2020 sic@ */
    lch_CellRestriction_r15 := omit,           /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    bitRateMultiplier_r16 := omit,             /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
    allowedHARQ_Mode_r18 := omit               /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
  };

  template (value) LogicalChannelConfig cs_508_LogicalChannelConfig_DRB_AM(integer p_Priority := tsc_LogicalChannelPriorityHi,
                                                                           PrioritizedBitRate_Type p_PrioritizedBitRate := kBps0,  // @sic R5-131806 sic@
                                                                           integer p_LCG := 1) :=
  /* Default values according to 36.508 cl. 4.8.2.1.4 Table 4.8.2.1.4-1 (using condition HI) */
  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
  /* @sic R5-165110: condition changed from LO to HI sic@ */
    cs_LogicalChannelConfig(cs_LogicalChannelConfigULParameters(p_Priority, p_PrioritizedBitRate, -, p_LCG));

  template (value) LogicalChannelConfig cs_508_LogicalChannelConfig_DRB_UM :=
    /* Default values according to 36.508 cl. 4.8.2.1.4 Table 4.8.2.1.4-1 (using condition HI) */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cs_LogicalChannelConfig(cs_LogicalChannelConfigULParameters(tsc_LogicalChannelPriorityLo));

  template (value) MAC_Configuration_Type cs_MAC_Configuration(integer p_Priority,
                                                               PrioritizedBitRate_Type p_PrioritizedBitRate := kBps0, //@sic R5w180206 sic@
                                                               template (omit) LAA_UL_Allowed_Type  p_LAA_UL_Allowed := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    LogicalChannel := {
      Priority := p_Priority,
      PrioritizedBitRate := p_PrioritizedBitRate,  // kBps0 per default
      LAA_UL_Allowed     := p_LAA_UL_Allowed       //@sic R5w180206 sic@
    },
    TestMode := {
      None := true //as this template is not to be used for MAC testing
    }
  };

  template (value) MAC_Configuration_Type cs_MAC_Configuration_AM :=
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cs_MAC_Configuration(tsc_LogicalChannelPriorityLo);

  template (value) MAC_Configuration_Type cs_MAC_Configuration_UM :=
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cs_MAC_Configuration(tsc_LogicalChannelPriorityHi);

  template (value) RadioBearer_Type cs_OneDRB_ConfigUM(DRB_Identity p_Drb,
                                                       template (value) PDCP_Config p_PdcpConfig := cs_508_PDCP_Config_DRB_UM,
                                                       template (value) RLC_Configuration_Type p_RlcConfig := cs_RLC_Configuration_UM,
                                                       template (omit) boolean p_DiscardULData := omit) :=
  { /* To configure 1 UM DRB in SS. Parameters according to 36.508 cl. 4.8.2.1.7 */
    /* @sic R5s100076: optional parameters p_PdcpConfig, p_RlcConfig sic@ */
    /* @sic R5s130681: optional parameter p_DiscardULData sic@ */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Id := cs_RadioBearerId_DRB(p_Drb),
    Config := {
      AddOrReconfigure := {
        Sdap := omit,       // @sic R5w220012 sic@
        Pdcp := cs_PDCP_Configuration_ConfigDRB(p_PdcpConfig),
        Rlc := p_RlcConfig,                  // @sic R5s090314: Additional comments sic@
        LogicalChannelId := p_Drb+2,
        Mac := cs_MAC_Configuration_UM,      // @sic R5s090314: Additional comments sic@
        DiscardULData := p_DiscardULData     // @sic RAN5 #55 sidebar meeting sic@
      }
    }
  };

  template (value) RadioBearer_Type cs_OneDRB_ConfigAM(DRB_Identity p_Drb := tsc_DRB1,
                                                       template (value) PDCP_Config p_PdcpConfig := cs_508_PDCP_Config_DRB_AM,
                                                       template (value) RLC_Configuration_Type p_RlcConfig := cs_RLC_Configuration_AM,
                                                       template (value) MAC_Configuration_Type p_MacConfig := cs_MAC_Configuration_AM) :=
  { /* To configure 1 AM DRB in SS. Parameters according to 36.508 cl. 4.8.2.1.7 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s100469 Additional Changes sic@ */
    Id := cs_RadioBearerId_DRB(p_Drb),
    Config := {
      AddOrReconfigure := {
        Sdap := omit,       // @sic R5w220012 sic@
        Pdcp := cs_PDCP_Configuration_ConfigDRB(p_PdcpConfig),
        Rlc := p_RlcConfig,                  // @sic R5s090314: Additional comments sic@
        LogicalChannelId := p_Drb+2,
        Mac := p_MacConfig,                  // @sic R5s090314: Additional comments sic@
        DiscardULData := omit                // @sic RAN5 #55 sidebar meeting sic@
      }
    }
  };

  template (value) RadioBearerList_Type cs_DrbConfigList_DRB1 := { cs_OneDRB_ConfigAM(tsc_DRB1) }; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) RadioBearerList_Type cs_DrbConfigList_DRB2 := { cs_OneDRB_ConfigAM(tsc_DRB2) }; /* @status    APPROVED (IMS_IRAT, LTE, LTE_A_PRO, LTE_IRAT)
                                                                                                      @sic R5s160032 ch. 1 sic@ */

  template (value) RadioBearer_Type cs_DRB_Release(DRB_Identity p_Drb) :=
  { /* To release the configured DRB in SS */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    Id := cs_RadioBearerId_DRB(p_Drb),
    Config := {
      Release := true
    }
  };

  template (value) DRB_ToAddMod cs_DRB_ToAddMod_AllOmit(DRB_Identity p_DRB_Id) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    eps_BearerIdentity := omit,
    drb_Identity := p_DRB_Id,
    pdcp_Config := omit,
    rlc_Config := omit,
    logicalChannelIdentity := omit,
    logicalChannelConfig := omit,
    drb_TypeChange_r12 := omit,          /* @sic BASELINE MOVING 2015 sic@ */
    rlc_Config_v1250 := omit,            /* @sic BASELINE MOVING 2015 sic@ */
    rlc_Config_v1310 := omit,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    drb_TypeLWA_r13 := omit,             /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    drb_TypeLWIP_r13 := omit,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    rlc_Config_v1430 := omit,            /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    lwip_UL_Aggregation_r14 := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    lwip_DL_Aggregation_r14 := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    lwa_WLAN_AC_r14 := omit,             /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    rlc_Config_v1510 := omit,            /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
    rlc_Config_v1530 := omit,            /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    rlc_BearerConfigSecondary_r15 := omit,    /* @sic R5s180552 BASELINE MOVING 2018 sic@ @sic R5s190544 BASELINE MOVING 2019: rlc_BearerConfigDupl_r15 -> rlc_BearerConfigSecondary_r15 sic@ */
    logicalChannelIdentity_r15 := omit,       /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    daps_HO_r16  := omit,                     /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
    rlc_Config_v1700 := omit                  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) DRB_ToAddMod cds_508_DRB_ToAddMod_Common(DRB_Identity p_DRB_Id,
                                                            template (omit) PDCP_Config  p_PDCP_Config,
                                                            template (omit) RLC_Config   p_RLC_Config,
                                                            template (omit) LogicalChannelConfig p_LogicalChannelConfig)
    modifies cs_DRB_ToAddMod_AllOmit :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    eps_BearerIdentity := p_DRB_Id+4,
    pdcp_Config := p_PDCP_Config,
    rlc_Config := p_RLC_Config,
    logicalChannelIdentity := p_DRB_Id+2,
    logicalChannelConfig := p_LogicalChannelConfig
  };

  template (value) DRB_ToAddMod cs_508_DRB_ToAddMod_DEFAULT_AM (DRB_Identity p_DRB_Id) :=
    /* According to 36.508 cl. 4.8.2.1.7 Table 4.8.2.1.7-1 (using condition AM) */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cds_508_DRB_ToAddMod_Common(p_DRB_Id,
                                cs_508_PDCP_Config_DRB_AM,
                                cs_508_RLC_Config_DRB_AM,
                                cs_508_LogicalChannelConfig_DRB_AM);

  template (value) DRB_ToAddMod cs_508_DRB_ToAddMod_DEFAULT_UM (DRB_Identity p_DRB_Id) :=
    /* According to 36.508 cl. 4.8.2.1.7 Table 4.8.2.1.7-1 (using condition UM) */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cds_508_DRB_ToAddMod_Common(p_DRB_Id,
                                cs_508_PDCP_Config_DRB_UM,
                                cs_508_RLC_Config_DRB_UM,
                                cs_508_LogicalChannelConfig_DRB_UM);

  template (value) PDCP_Config cds_PDCP_Config_DRB_AM_NoPDCP_StatusReport
  modifies cs_508_PDCP_Config_DRB_AM :=
  { /* Default values according to 36.508 cl. 4.8.2.1.2.2 Table 4.8.2.1.2.2-1 */
    /* except PDCP status report NOT required */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    rlc_AM := {
      statusReportRequired := false
    }
  };

  template (value) PDCP_Config cds_PDCP_Config_DRB_AM_UDC (template (omit) UplinkDataCompression_r15_Type p_UDC_r15)
  modifies cs_508_PDCP_Config_DRB_AM :=
  { /* Default values according to 36.508 cl. 4.8.2.1.2.2 Table 4.8.2.1.2.2-1 */
    /* except  */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    uplinkDataCompression_r15 := p_UDC_r15
  };

  template (value) DRB_ToAddMod cs_DRB_ToAddMod_NoPDCP_StatusReport (DRB_Identity p_DRB_Id) :=
    /* According to 36.508 cl. 4.8.2.1.7 Table 4.8.2.1.7-1 (using condition AM) */
    /* except PDCP status report NOT required */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cds_508_DRB_ToAddMod_Common(p_DRB_Id,
                                cds_PDCP_Config_DRB_AM_NoPDCP_StatusReport,
                                cs_508_RLC_Config_DRB_AM,
                                cs_508_LogicalChannelConfig_DRB_AM);

  template (value) DRB_ToAddMod cs_DRB_ToAddMod_UDC (DRB_Identity p_DRB_Id, template (omit) UplinkDataCompression_r15_Type p_UDC_r15) :=
    /* According to 36.508 cl. 4.8.2.1.7 Table 4.8.2.1.7-1 (using condition AM) */
    /* except  */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cds_508_DRB_ToAddMod_Common(p_DRB_Id,
                                cds_PDCP_Config_DRB_AM_UDC (p_UDC_r15),
                                cs_508_RLC_Config_DRB_AM,
                                cs_508_LogicalChannelConfig_DRB_AM);

  template (value) DRB_ToAddMod cds_508_DRB_ToAddMod_RECONFIG(DRB_Identity p_DRB_Id,
                                                              template (value) RLC_Config p_RLC_Config)
    modifies cs_DRB_ToAddMod_AllOmit :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    rlc_Config := p_RLC_Config
  };

  template (value) DRB_ToAddModList cs_508_DRB_ToAddModList_RECONFIG :=
  { /* Default values according to 36.508 cl. 4.6.3 Table 4.6.3-2A */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s110313 sic@ */
    cds_508_DRB_ToAddMod_RECONFIG(1, cs_508_RLC_Config_DRB_AM_RECONFIG),
    cds_508_DRB_ToAddMod_RECONFIG(2, cs_508_RLC_Config_DRB_AM_RECONFIG)  // @sic R5-100487 sic@
  };

  template (value) DRB_ToAddModList cs_508_DRB_ToAddModList_RECONFIG_UM :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT) */
    cds_508_DRB_ToAddMod_RECONFIG(1, cs_508_RLC_Config_DRB_AM_RECONFIG),
    cds_508_DRB_ToAddMod_RECONFIG(2, cs_508_RLC_Config_DRB_UM_RECONFIG)
  };

  template (value) RLC_Config cs_508_RLC_Config_DRB_AM_RECONFIG :=
  { /* Default values according to 36.508 cl. 4.6.3 Table 4.6.3-19A */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    am := {
      ul_AM_RLC := {
        t_PollRetransmit := ms85,
        pollPDU := p64,
        pollByte := kB250,
        maxRetxThreshold := t8
      },
      dl_AM_RLC := {
        t_Reordering := ms85,
        t_StatusProhibit := ms50
      }
    }
  };

  template (value) RLC_Config cs_508_RLC_Config_DRB_UM_RECONFIG :=
    /* According to 36.508 cl. 4.6.3 Table 4.6.3-19B */
    /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT) */
    cs_508_RLC_Config_DRB_UM(cs_508_DRB_UL_UM_RLC, cds_RX_UM_RLC_DRB_SN10_tReord55ms);

  template (value) HarqProcessAssignment_Type cs_HarqProcessAssignment_Automatic :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    Automatic := true
  };

  template (value) DRB_COMMON_REQ cas_DRB_COMMON_REQ(EUTRA_CellId_Type p_CellId,
                                                     template (value) RadioBearerId_Type p_RB_Id,
                                                     template (value) TimingInfo_Type p_TimingInfo,
                                                     template (value) L2DataList_Type p_L2DataList,
                                                     template (value) HarqProcessAssignment_Type p_HarqProcess := cs_HarqProcessAssignment_Automatic,
                                                     integer p_SubframeOffset := 0,
                                                     template (omit) RlcBearerRouting_Type p_RlcRouting := omit) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    /* @sic R5w190111r1, R5w190114 sic@ */
    Common   := cs_ReqAspCommonPart_RB(p_CellId, p_RB_Id, p_TimingInfo, p_RlcRouting), // @sic R5w180111 sic@
    U_Plane   := {
      SubframeDataList := {
        {
          SubframeOffset := p_SubframeOffset,
          HarqProcess := p_HarqProcess,
          PduSduList := p_L2DataList
        }
      }
    },
    SuppressPdcchForC_RNTI := omit
  };

  template (value) L2DataList_Type cs_L2DataList_PdcpSdu(template (value) PDCP_SDUList_Type p_PDCP_SDUList) := {PdcpSdu := p_PDCP_SDUList};     /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */

  template (value) DRB_COMMON_REQ cas_DRB_COMMON_REQ_PDCP_SDU(EUTRA_CellId_Type p_CellId,
                                                              template (value) RadioBearerId_Type p_RB_Id,
                                                              template (value) TimingInfo_Type p_TimingInfo,
                                                              template (value) PDCP_SDUList_Type p_PDCP_SDUList,
                                                              template (value) HarqProcessAssignment_Type p_HarqProcess := cs_HarqProcessAssignment_Automatic,
                                                              integer p_SubframeOffset := 0) :=
  /* Template for DRB Data REQ with PDCP SDUs */
  /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */
    cas_DRB_COMMON_REQ(p_CellId, p_RB_Id, p_TimingInfo, cs_L2DataList_PdcpSdu(p_PDCP_SDUList), p_HarqProcess, p_SubframeOffset);

  template (present) DRB_COMMON_IND car_DRB_COMMON_IND(EUTRA_CellId_Type p_CellId,
                                                       template (present) RadioBearerId_Type p_RbId,
                                                       template (present) TimingInfo_Type p_TimingInfo,
                                                       template (present) L2DataList_Type p_L2DataList,
                                                       template RlcBearerRouting_Type p_RlcRouting := *) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */
    /* @sic R5w190111r1 sic@ */
    Common   := cr_IndAspCommonPart_RB(p_CellId, p_RbId, p_TimingInfo, p_RlcRouting), // @sic R5w180111 sic@
    U_Plane := {
      SubframeData := {
        PduSduList := p_L2DataList,
        NoOfTTIs   := ?
      }
    }
  };

  template (present) L2DataList_Type cr_L2DataList_PdcpSdu(template (present) PDCP_SDUList_Type p_PDCP_SDUList := ?) := {PdcpSdu := p_PDCP_SDUList};     /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT) */

  template (present) DRB_COMMON_IND car_DRB_COMMON_IND_PDCP_SDUList(EUTRA_CellId_Type p_CellId,
                                                                    template (present) RadioBearerId_Type p_RbId,
                                                                    template (present) TimingInfo_Type p_TimingInfo,
                                                                    template (present) PDCP_SDUList_Type p_PDCP_SDUList) :=
  /* common ASP to receive PDUs from DRBs */
  /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */
    car_DRB_COMMON_IND(p_CellId, p_RbId, p_TimingInfo, cr_L2DataList_PdcpSdu(p_PDCP_SDUList));

}
