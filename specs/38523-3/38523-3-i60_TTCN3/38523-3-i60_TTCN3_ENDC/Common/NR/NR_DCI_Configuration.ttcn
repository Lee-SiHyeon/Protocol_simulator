      PdschHarqTimingIndicator := p_HarqTiming
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_0_P_RNTI_Params :=
  { /* 38.508-1 Table 4.3.6.1.2.1-2 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Format_1_0_P_RNTI := {
      ShortMessageIndicator := tsc_NR_DciFormat_1_0_ShortMessageIndicator_PagingOnly,   /* paging only => all bits of ShortMessages are reserved */
      ShortMessages := '00000000'B,                                                     /* reserved */
      TbScaling := tsc_NR_DciFormat_1_0_TbScaling_Factor1,                              /* Scaling factor S=1 */
      TrsAvailabilityIndication := cs_NR_DciFormat_1_0_P_RNTI_TrsAvailabilityIndication_None // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_0_SI_RNTI_Params(B1_Type p_SystemInfoIndicator) :=
  { /* 38.508-1 Table 4.3.6.1.2.1-3 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Format_1_0_SI_RNTI := {
      SystemInfoIndicator := p_SystemInfoIndicator                                      /* '0'B for SIB1, '1'B for (other) SI messages */
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_0_RA_RNTI_Params :=
  { /* 38.508-1 Table 4.3.6.1.2.1-4 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Format_1_0_RA_RNTI := {
      TbScaling := tsc_NR_DciFormat_1_0_TbScaling_Factor1,                               /* Scaling factor S=1 */
      LSBsOfSFN := cs_NR_DciFormat_1_0_LSBsOfSFN_None                                    /* LSBs of SFN
                                                                                            @sic R5s201387 BASELINE MOVING 2020 sic@ */
    }
  };

  /*
   * @desc      Sets DciFormat according to 38.213 clause 9.2.3
   * @param     p_SCS
   * @return    template (value) NR_DciFormat_1_X_PdschHarqTimingIndicator_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_DciFormat_1_0_PdschHarqTimingIndicator(SubcarrierSpacing p_SCS) return template (value) NR_DciFormat_1_X_PdschHarqTimingIndicator_Type
  {
    var B3_Type v_Value;

    select (p_SCS) {
      case(kHz15)  { v_Value := '110'B; }   /* 7 slots according to 38.213 clause 9.2.3 */
      case(kHz30)  { v_Value := '100'B; }   /* 5 slots according to 38.213 clause 9.2.3 */
      case(kHz120) { v_Value := '111'B; }   /* 8 slots according to 38.213 clause 9.2.3 */
      case else    { FatalError(__FILE__, __LINE__, "Invalid SubcarrierSpacing"); }
    }
    return cs_NR_DciFormat_1_X_PdschHarqTimingIndicator(v_Value);
  }

  template (value) NR_DciFormat_1_X_PrbBundlingSizeIndicator_Type cs_NR_DciFormat_1_1_PrbBundlingSizeIndicator_None := { None := true };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_RateMatchingIndicator_Type cs_NR_DciFormat_1_1_RateMatchingIndicator(bitstring p_Bitmap) := { Bitmap := p_Bitmap }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_ZP_CSI_RS_Trigger_Type cs_NR_DciFormat_1_1_ZP_CSI_RS_Trigger(bitstring p_Index) := { Index := p_Index };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_DAI_Type cs_NR_DciFormat_1_1_DAI_SingleServingCell(template (value) DAI_B2_Type p_DaiValue) := { TwoBits := p_DaiValue };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_DAI_Type cs_NR_DciFormat_1_1_DAI_MultipleServingCells(template (value) DAI_B4_Type p_DaiValue) := { FourBits := p_DaiValue };   /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_DciFormat_1_1_AntennaPorts_Type cs_NR_DciFormat_1_1_AntennaPorts(bitstring p_Index) := { Index := p_Index };     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_TCI_Type cs_NR_DciFormat_1_1_TCI_None := { None := true };                                         /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_TCI_Selection_Type cs_NR_DciFormat_1_X_TCI_Selection_None := { None := true };                     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_CBGTI_Type cs_NR_DciFormat_1_1_CBGTI(bitstring p_Bitmap) := { Bitmap := p_Bitmap };                /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_CBGFI_Type cs_NR_DciFormat_1_1_CBGFI_None := { None := true };                                     /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_OneShotHarqAckRequest_Type     cs_NR_DciFormat_1_1_OneShotHarqAckRequest_None := { None := true }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) @sic R5s221179 sic@ */

  template (value) NR_DciFormat_1_1_PdschGroupIndex_Type           cs_NR_DciFormat_1_1_PdschGroupIndex_None := { None := true };           /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_NewFeedbackIndicator_Type      cs_NR_DciFormat_1_1_NewFeedbackIndicator_None := { None := true };      /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_NumberRequestedPdschGroup_Type cs_NR_DciFormat_1_1_NumberRequestedPdschGroup_None := { None := true }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type cs_NR_DciFormat_1_1_ChannelAccessCPext_None := { None := true };           /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) @sic R5s221179 sic@ */

  template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type cs_NR_DciFormat_1_1_ChannelAccessCPext_Value(bitstring p_Value) := { Value := p_Value }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_SecondTpcCommand_Type cs_NR_DciFormat_1_X_SecondTpcCommand_None := { None := true };               /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_EnhancedType3CodebookIndicator_Type cs_NR_DciFormat_1_X_EnhancedType3CodebookIndicator_None := { None := true };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_HarqAckRetransmissionIndicator_Type cs_NR_DciFormat_1_X_HarqAckRetransmissionIndicator_None := { None := true };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_PucchCellIndicator_Type cs_NR_DciFormat_1_X_PucchCellIndicator_None := { None := true };                          /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_1_CoScheduledUE_Info_Type cs_NR_DciFormat_1_1_CoScheduledUE_Info_None := { None := true };                          /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_1_Params(SubcarrierSpacing p_SCS,
                                                                                 template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type p_NR_DciFormat_1_X_ChannelAccessCPext := cs_NR_DciFormat_1_1_ChannelAccessCPext_None) := //SharedSpectrum
  { /* 38.508-1 Table 4.3.6.1.2.2-1 and 38.212 clause 7.3.1.2.2 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Format_1_1 := {
      CarrierIndicator := cs_NR_DciCommon_CarrierIndicator_None,                        /* not present (no cross carrier scheduling):
                                                                                           ServingCellConfig.crossCarrierSchedulingConfig not present or
                                                                                           ServingCellConfig.crossCarrierSchedulingConfig.schedulingCellInfo.own.cif-Presence == false */
      BWPIndicator := cs_NR_DciCommon_BWPIndicator_SingleBWP,                           /* BWPIndicator not present as per default there is only one single BWP is configuered (initial BWP only) */
      PrbBundlingSizeIndicator := cs_NR_DciFormat_1_1_PrbBundlingSizeIndicator_None,    /* not present: staticBundling as configured by PDSCH-Config.prb-BundlingType */
      RateMatchingIndicator := cs_NR_DciFormat_1_1_RateMatchingIndicator(''B),          /* not present (0 bits): neither rateMatchPatternGroup1 nor rateMatchPatternGroup2 is configured by PDSCH-Config */
      ZP_CSI_RS_Trigger := cs_NR_DciFormat_1_1_ZP_CSI_RS_Trigger(''B),                  /* not present (0 bits): no ZP-CSI-RS-Resource being configured by PDSCH-Config (-> PDSCH-Config.zp-CSI-RS-ResourceToAddModList) */
      DAI := cs_NR_DciFormat_1_1_DAI_SingleServingCell(cs_DAI_B2_Automatic),            /* 2 bits for single serving cell and PhysicalCellGroupConfig.pdsch-HARQ-ACK-codebook == dynamic @sic R5-202677 R5-201572 sic@*/
      TpcCommandPucch := cs_NR_DciCommon_TpcCommand,                                    /* default TPC command: 0 dB ('01'B) */
      SecondTpcCommand := cs_NR_DciFormat_1_X_SecondTpcCommand_None,                    // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      PucchResourceIndicator := cs_NR_DciFormat_1_X_PucchResourceIndicator('110'B),     /* 3 bits (fix size) @sic R5-201195: '110'B instead of '000'B sic@ */
      PdschHarqTimingIndicator := fl_NR_DciFormat_1_1_PdschHarqTimingIndicator(p_SCS),  /* 3 bits corresponding to length of PUCCH-Config.dl-DataToUL-ACK @sic R5s190852 change 10/11 sic@ */
      OneShotHarqAckRequest     := cs_NR_DciFormat_1_1_OneShotHarqAckRequest_None,      /* One-shot HARQ-ACK request  @sic R5s201387 BASELINE MOVING 2020 sic@ */
      EnhancedType3CodebookIndicator := cs_NR_DciFormat_1_X_EnhancedType3CodebookIndicator_None,  // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      PdschGroupIndex           := cs_NR_DciFormat_1_1_PdschGroupIndex_None,            /* PDSCH group index   @sic R5s201387 BASELINE MOVING 2020 sic@ */
      NewFeedbackIndicator      := cs_NR_DciFormat_1_1_NewFeedbackIndicator_None,       /* New feedback indicator   @sic R5s201387 BASELINE MOVING 2020 sic@ */
      NumberRequestedPdschGroup := cs_NR_DciFormat_1_1_NumberRequestedPdschGroup_None,  /* Number of requested PDSCH group   @sic R5s201387 BASELINE MOVING 2020 sic@ */
      HarqAckRetransmissionIndicator := cs_NR_DciFormat_1_X_HarqAckRetransmissionIndicator_None,   // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      AntennaPorts := cs_NR_DciFormat_1_1_AntennaPorts('0000'B),                        /* 4 bits => 38.212 Table 7.3.1.2.2-1: one codeword, dmrs-Type=1, maxLength=1; Index=0 => 1 CDM group without data, port 0 (=> 1 layer) */
      TCI := cs_NR_DciFormat_1_1_TCI_None,                                              /* not present (TCI disabled -> ControlResourceSet.tci-PresentInDCI) */
      TCI_Selection := cs_NR_DciFormat_1_X_TCI_Selection_None,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      SrsRequest := cs_NR_DciFormat_X_1_SrsRequest_SingleUL('00'B),                     /* 2 bits (no SUL per default); No aperiodic SRS resource set triggered (38.212 Table 7.3.1.1.2-24)  */
      SrsOffsetIndicator := cs_NR_DciCommon_SrsOffsetIndicator_None,                    // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      CBGTI := cs_NR_DciFormat_1_1_CBGTI(''B),                                          /* not present: code-block-group based transmission is not enabled (-> PDSCH-ServingCellConfig.codeBlockGroupTransmission not present) */
      CBGFI := cs_NR_DciFormat_1_1_CBGFI_None,                                          /* not present: code-block-group based transmission is not enabled (-> PDSCH-ServingCellConfig.codeBlockGroupTransmission not present);
                                                                                           present only if PDSCH-CodeBlockGroupTransmission.codeBlockGroupFlushIndicator == true */
      DmrsSequenceInit := cs_NR_DciFormat_X_1_DmrsSequenceInit_Value('0'B),             /* 1 bit for DCI format 1_1 */
      PriorityIndicator := cs_NR_DciFormat_PriorityIndicator_None,                                 /* Priority indicator        @sic R5s201387 BASELINE MOVING 2020 sic@*/
      ChannelAccessCPext := p_NR_DciFormat_1_X_ChannelAccessCPext,                               /* ChannelAccess-CPext          @sic R5s201387 BASELINE MOVING 2020 sic@*/
      MinimumApplicableSchedulingOffset := cs_NR_DciFormat_X_1_MinimumApplicableSchedulingOffset_None, /* Minimum applicable scheduling offset indicator          @sic R5s201387 BASELINE MOVING 2020 sic@*/
      SCellDormancyIndication := cs_NR_DciFormat_X_1_SCellDormancyIndication_None,                      /* SCell dormancy indication           @sic R5s201387 BASELINE MOVING 2020 sic@*/
      PdcchMonitoringAdaptationIndication := cs_NR_DciCommon_PdcchMonitoringAdaptationIndication_None, /* PDCCH monitoring adaptation indication */
      PucchCellIndicator := cs_NR_DciFormat_1_X_PucchCellIndicator_None,  /* PUCCH Cell indicator
                                                                            @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      CoScheduledUE := cs_NR_DciFormat_1_1_CoScheduledUE_Info_None                      /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cds_NR_DciFormat_1_1_Params_DAI_MultipleServingCells(SubcarrierSpacing p_SCS,
                                                                                                           template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type p_NR_DciFormat_1_X_ChannelAccessCPext := cs_NR_DciFormat_1_1_ChannelAccessCPext_None) // SharedAccess: because of parameter added in root template
  modifies cs_NR_DciFormat_1_1_Params :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Format_1_1 := {
        DAI := cs_NR_DciFormat_1_1_DAI_MultipleServingCells(cs_DAI_B4_Automatic)            /* 4 bits for multiple serving cells */
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_1_AllOmit :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Format_1_1 := {
      CarrierIndicator := omit,
      BWPIndicator := omit,
      PrbBundlingSizeIndicator := omit,
      RateMatchingIndicator := omit,
      ZP_CSI_RS_Trigger := omit,
      DAI := omit,
      TpcCommandPucch := omit,
      SecondTpcCommand := omit,                     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      PucchResourceIndicator := omit,
      PdschHarqTimingIndicator := omit,
      OneShotHarqAckRequest     := omit,            /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      EnhancedType3CodebookIndicator := omit,       /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      PdschGroupIndex           := omit,            /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      NewFeedbackIndicator      := omit,            /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      NumberRequestedPdschGroup := omit,            /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
      HarqAckRetransmissionIndicator := omit,       /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      AntennaPorts := omit,
      TCI := omit,
      TCI_Selection := omit,                        /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      SrsRequest := omit,
      SrsOffsetIndicator := omit,                   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      CBGTI := omit,
      CBGFI := omit,
      DmrsSequenceInit := omit,
      PriorityIndicator := omit,                                 /* @sic R5s201387 BASELINE MOVING 2020 sic@*/
      ChannelAccessCPext := omit,                                /* @sic R5s201387 BASELINE MOVING 2020 sic@*/
      MinimumApplicableSchedulingOffset := omit,                 /* @sic R5s201387 BASELINE MOVING 2020 sic@*/
      SCellDormancyIndication := omit,                           /* @sic R5s201387 BASELINE MOVING 2020 sic@*/
      PdcchMonitoringAdaptationIndication := omit,               /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      PucchCellIndicator := omit,                                /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      CoScheduledUE := omit                                      /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    }
  };

  template (value) NR_FreqDomainResourceAssignmentDL_Type cs_NR_FreqDomainResourceAssignmentDL_Automatic(integer p_FirstRbIndex,
                                                                                                         integer p_MaxRbCnt) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Automatic := {
      FirstRbIndex := p_FirstRbIndex,
      MaxRbCnt := p_MaxRbCnt
    }
  };

  template (value) NR_FreqDomainResourceAssignmentDL_Type cs_NR_FreqDomainResourceAssignmentDL_Explicit(integer p_FirstRbIndex,
                                                                                                        integer p_Nprb) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Explicit := {
      FirstRbIndex := p_FirstRbIndex,
      Nprb := p_Nprb
    }
  };

  template (value) NR_TransportBlockSchedulingDL_Type cs_NR_TransportBlockSchedulingDL_Automatic(template (value) NR_ModulationSchemePDSCH_Type p_ModulationScheme,
                                                                                                 template (value) NR_RedundancyVersionList_Type p_RedundancyVersionList) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Automatic := {
      TransportBlock1 := p_ModulationScheme,
      TransportBlock2 := omit,
      RedundancyVersionList := p_RedundancyVersionList
    }
  };

  template (value) NR_DciFormat_DL_ResourceAssignment_Type cs_NR_DciFormat_DL_ResourceAssignment(template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := omit,
                                                                                                   template (omit) NR_FreqDomainResourceAssignmentDL_Type p_FreqDomainResourceAssignmentDL := omit,
                                                                                                   template (omit) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment := omit,
                                                                                                   template (omit) NR_TransportBlockSchedulingDL_Type p_NR_TransportBlockSchedulingDL := omit,
                                                                                                   template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5w240204 sic@
    ResourceAllocationType := p_ResourceAllocationType,
    FreqDomain := p_FreqDomainResourceAssignmentDL,
    TimeDomain := p_TimeDomainResourceAssignment,
    TransportBlockScheduling := p_NR_TransportBlockSchedulingDL,
    HarqProcessConfig := p_HarqProcessConfig
  };

  /*
   * @desc      Sets PDSCH-to-HARQ_feedback timing indicator for DCI format 1_1 corresponding to dl-DataToUL-ACK (PUCCH-Config)
   * @param     p_SCS
   * @return    template (value) NR_DciFormat_1_X_PdschHarqTimingIndicator_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_DciFormat_1_1_PdschHarqTimingIndicator(SubcarrierSpacing p_SCS) return template (value) NR_DciFormat_1_X_PdschHarqTimingIndicator_Type
  {
    var B3_Type v_Value;

    select (p_SCS) {
      case(kHz15)  { v_Value := '101'B; }   /* 7 slots according to 38.508-1 Table 4.6.3-112 PUCCH-Config: 6th entry of dl-DataToUL-ACK */
      case(kHz30)  { v_Value := '011'B; }   /* 5 slots according to 38.508-1 Table 4.6.3-112 PUCCH-Config: 4th entry of dl-DataToUL-ACK */
      case(kHz120) { v_Value := '110'B; }   /* 8 slots according to 38.508-1 Table 4.6.3-112 PUCCH-Config: 7th entry of dl-DataToUL-ACK */
      case else    { FatalError(__FILE__, __LINE__, "Invalid SubcarrierSpacing"); }
    }
    return cs_NR_DciFormat_1_X_PdschHarqTimingIndicator(v_Value);
  }

  /*
   * @desc      Inits DciDL Info as acc to TS 38.523-3 clause 7.1.2.2.3.1
   * @param     p_PhysicalParameters
   * @param     p_DciFormatAndParams
   * @param     p_RedundancyVersionList
   * @param     p_DciFormat1_0_Ccch (default value: false)
   * @param     p_Msg4              (default value: false)
   * @return    template (value) NR_DciDlInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DciDlInfo_Init(NR_PhysicalParameters_Type p_PhysicalParameters,
                               template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams,
                               template (value) NR_RedundancyVersionList_Type p_RedundancyVersionList,
                               boolean p_DciFormat1_0_Ccch := false,
                               boolean p_Msg4 := false
                               )
    return template (value) NR_DciDlInfo_Type
    {
    /* NOTE: In general the given p_PhysicalParameters are preconfigured in TTCN and the DciInfo is pre-configured at the SS before an RRC connection gets established at the UE */
    // @sic R5-202677 : added p_DciFormat1_0_Ccch R5-251932: added p_Msg4 sic@
    var template (value) NR_FreqDomainResourceAssignmentDL_Type v_FreqDomainResourceAssignmentDL;
    var template (omit) PDSCH_TimeDomainResourceAllocationList v_TimeDomainResourceAllocationList := omit;
    var NR_DownlinkBWP_Type v_DownlinkBWP := p_PhysicalParameters.DL_BWPs[0];
    var PDSCH_Config v_PDSCH_Config := v_DownlinkBWP.Pdsch.ConfigDedicated.R15;
    var PDSCH_ConfigCommon v_PDSCH_ConfigCommon := v_DownlinkBWP.Pdsch.ConfigCommon.R15;
    var NR_ResourceAllocationType_Type v_ResourceAllocationType := resourceAllocationType1;
    var template (value) NR_HarqProcessConfig_Type v_HarqProcessConfig;
    var NR_ModulationSchemePDSCH_Type v_ModulationScheme;
    var integer v_MaxRbCnt := 24; // minimum value of Maximum transmission bandwidth (taking into account CORESET#0)
    var integer v_TimeDomainResourceAssignmentTableSize := 16;
    var integer v_TimeDomainResourceAssignmentIndexValue := 0;    /* => first entry of the TimeDomainResourceAssignmentTable:
                                                                     NOTE 1: if there is no pdsch_TimeDomainAllocationList configured at the UE, 38.508-1 Table 5.1.2.1.1-2 applies
                                                                     NOTE 2: according to 38.508-1 Table 5.1.2.1.1-1 for SIB1 always 8.508-1 Table 5.1.2.1.1-2 applies */
    var template (value) NR_DciCommon_TimeDomainResourceAssignment_Type v_TimeDomainResourceAssignment;
    var boolean v_IsDciFormat_1_1 := ischosen(p_DciFormatAndParams.Format_1_1);
    var integer v_FirstRbIndex;
    var integer v_FirstRbIndexSI;
    var SSB_Index v_SSB_Index := f_NR_ConvertPositionsInBurst_ToSSB_Index(p_PhysicalParameters.SSB_BurstConfig.PositionsInBurst);  //@sic R5-201150 sic@
    var integer v_FirstRbIndexDcchDtch;  //@sic R5-202677  sic@
    // @sic R5s230656 R5-236303 R5w230308 sic@
    var integer v_SIB1_SI_TBS := 7;  //Acc to 38.523-3 cl 7.1.2.2.3.1
    var integer v_LRBs_max := 0; //LRBs,max as defined in Table 7.1.2.2.3.1-1

    //38.523-3 cl7.1.2.2.3.1: for channel bandwidth 3 MHz, NBWP is limited to the minimum value of 15 RBs
    if (p_PhysicalParameters.ChannelBandwidth == 3) { v_MaxRbCnt := 15; }   //@sic R5-250309 CBW3 sic@
    if (f_GetTestcaseAttrib_ExtendedSIB1_TBS(testcasename())){ v_SIB1_SI_TBS := 9; }  //Acc to 38.523-3 cl 7.1.2.2.3.1
    // Set RB start as per 38.523-3 Table 7.1.2.2.3.1-1: Resource allocation for frequency domain multiplexing, RA type1, non-interleaved @sic R5-201150 sic@
    select (v_SSB_Index) {
        case(tsc_NR_SSB_Index1) {
            v_FirstRbIndex := v_SIB1_SI_TBS;
            v_FirstRbIndexSI := 0;
            v_FirstRbIndexDcchDtch := v_SIB1_SI_TBS + p_PhysicalParameters.OffsetCarrierCORESET0;
        }
        case(tsc_NR_SSB_Index0) {
            v_FirstRbIndex := 0;
            v_FirstRbIndexSI := v_MaxRbCnt-v_SIB1_SI_TBS;
            v_FirstRbIndexDcchDtch := 0;
        }
    }
    //Set v_LRBs_max
    v_LRBs_max := v_MaxRbCnt-v_SIB1_SI_TBS;  //Default value
    if (pc_supportOfERedCap_r18 and p_PhysicalParameters.SubcarrierSpacing == kHz30) {
      select union (valueof(p_DciFormatAndParams)) {
        case (Format_1_1) {
          //DCCH/DTCH transmissions
          //Note 6: If eRedCap operation is configured in the SS, reduced baseband bandwidth and SCS=30kHz are applied, LRBs,max = 12. Channel bandwidth 3 MHz is not applicable to (e)RedCap UE.
          if (not(pc_eRedCapNotReducedBB_BW_r18)) {
            v_LRBs_max := 12;
          }
        }
        case (Format_1_0) {
          if (p_Msg4) {
            //CCCH and DCCH transmission on CSS in RA Msg4
            // Note 7: If eRedCap operation is configured in the SS and SCS=30kHz is applied, LRBs,max = 12. Channel bandwidth 3 MHz is not applicable to (e)RedCap UE.
            v_LRBs_max := 12;
          } else {
            //DCCH/DTCH transmissions with DCI 1_0 OR CCCH and DCCH transmission on CSS not in RA Msg4
            //Note 6: If eRedCap operation is configured in the SS, reduced baseband bandwidth and SCS=30kHz are applied, LRBs,max = 12. Channel bandwidth 3 MHz is not applicable to (e)RedCap UE.
            if (not(pc_eRedCapNotReducedBB_BW_r18)) {
              v_LRBs_max := 12;
            }
          }
        }
        case else { } //use default value
      }
    }

    if (v_IsDciFormat_1_1) {
      // resource allocation type for DCI format 1_1:
      if (match(resourceAllocationType0, v_PDSCH_Config.resourceAllocation)) {  // 38.214 clause 6.1.2.2: allocation type 0 is applicable for DCI format 0_1 only
        v_ResourceAllocationType := resourceAllocationType0;
      }

      // size of pdsch_TimeDomainAllocationList for DCI format 1_1:
      if (ischosen(v_PDSCH_Config.pdsch_TimeDomainAllocationList.setup)) {      // 38.214 Table 5.1.2.1.1-1: pdsch-TimeDomainAllocationList provided in pdsch-Config
        v_TimeDomainResourceAllocationList := v_PDSCH_Config.pdsch_TimeDomainAllocationList.setup;
      } else {                                                                  // 38.214 Table 5.1.2.1.1-1: pdsch-TimeDomainAllocationList provided in pdsch-ConfigCommon
        v_TimeDomainResourceAllocationList := v_PDSCH_ConfigCommon.pdsch_TimeDomainAllocationList;      /* NOTE: pdsch-TimeDomainAllocationList may be not present in PUSCH-ConfigCommon */
      }
      if (isvalue(v_TimeDomainResourceAllocationList)) {
        v_TimeDomainResourceAssignmentTableSize := lengthof(v_TimeDomainResourceAllocationList);
      } else {
        v_TimeDomainResourceAssignmentTableSize := 16;        /* Default PDSCH time domain resource allocation (38.214 Table 5.1.2.1.1-2/3/4/5) */
      }
    }
    v_TimeDomainResourceAssignment := fl_NR_DciCommon_TimeDomainResourceAssignment(v_TimeDomainResourceAssignmentTableSize, v_TimeDomainResourceAssignmentIndexValue);

    select union (valueof(p_DciFormatAndParams)) {
      case (Format_1_0, Format_1_1) {   /* UE-specific search space (C-RNTI, CS-RNTI(s)) or
                                           Type1-PDCCH common search space for scheduling of Msg4 of RACH procedure (TC-RNTI) */
        if (p_DciFormat1_0_Ccch) {
            v_FreqDomainResourceAssignmentDL := cs_NR_FreqDomainResourceAssignmentDL_Automatic(v_FirstRbIndex, v_LRBs_max);
        } else {
            v_FreqDomainResourceAssignmentDL := cs_NR_FreqDomainResourceAssignmentDL_Automatic(v_FirstRbIndexDcchDtch, v_LRBs_max);            /* according to 38.523-3 Table 7.1.2.2.3.1-1; may be changed dynamically during a test case @sic R5-192813 sic@ */
        }
        v_HarqProcessConfig := cs_NR_HarqProcessConfig_AnyProcess;                                                      /* may be changed dynamically during a test case */
        v_ModulationScheme := qam64;                                                                                    /* up to 64QAM only per default */
        if (v_IsDciFormat_1_1 and match(qam256, v_PDSCH_Config.mcs_Table)) {
          v_ModulationScheme := qam256;                                                                                 /* mcs-Table given by PDSCH-Config is set to '256QAM' AND DCI format 1_1
                                                                                                                           => MCS index table 2 with modulation scheme up to 256QAM */
        }
      }
      case (Format_1_0_P_RNTI) {        /* Type2-PDCCH common search space for scheduling of Paging messages (P-RNTI) */
        v_FreqDomainResourceAssignmentDL := cs_NR_FreqDomainResourceAssignmentDL_Automatic(v_FirstRbIndex, v_LRBs_max);            /* according to 38.523-3 Table 7.1.2.2.3.1-1 @sic R5-192813 sic@ */
        v_HarqProcessConfig := cs_NR_HarqProcessConfig_None;
        v_ModulationScheme := qpsk;                                                                                     /* 38.214 clause 5.1.3.1:
                                                                                                                           The UE is not expected to decode a PDSCH scheduled with P-RNTI, RA-RNTI, SI-RNTI and Qm > 2
                                                                                                                           (Qm=2 corresponds to QPSK acc. 38.211 Table 7.3.1.2-1) */
      }
      case (Format_1_0_SI_RNTI) {       /* Type0-PDCCH common search space for scheduling of SIB1 (SI-RNTI) or
                                           Type0A-PDCCH common search space for scheduling of other system information (SI-RNTI) */
        v_FreqDomainResourceAssignmentDL := cs_NR_FreqDomainResourceAssignmentDL_Automatic(v_FirstRbIndexSI, v_SIB1_SI_TBS);                       /* according to 38.523-3 Table 7.1.2.2.3.1-1 and Table 7.3.3.2-1 @sic R5-192812, R5-192813 sic@ */
        v_HarqProcessConfig := cs_NR_HarqProcessConfig_Broadcast;
        v_ModulationScheme := qpsk;                                                                                     /* 38.214 clause 5.1.3.1:
                                                                                                                           The UE is not expected to decode a PDSCH scheduled with P-RNTI, RA-RNTI, SI-RNTI and Qm > 2
                                                                                                                           (Qm=2 corresponds to QPSK acc. 38.211 Table 7.3.1.2-1) */
      }
      case (Format_1_0_RA_RNTI) {
        v_FreqDomainResourceAssignmentDL := cs_NR_FreqDomainResourceAssignmentDL_Automatic(v_FirstRbIndex, v_LRBs_max);            /* according to 38.523-3 Table 7.1.2.2.3.1-1 @sic R5-192813 sic@ */
        v_HarqProcessConfig := cs_NR_HarqProcessConfig_None;
        v_ModulationScheme := qpsk;                                                                                     /* 38.214 clause 5.1.3.1:
                                                                                                                           The UE is not expected to decode a PDSCH scheduled with P-RNTI, RA-RNTI, SI-RNTI and Qm > 2
                                                                                                                           (Qm=2 corresponds to QPSK acc. 38.211 Table 7.3.1.2-1) */
      }
      case else {
        FatalError(__FILE__, __LINE__, "unknown or invalid DCI format");
      }
    }
    return cs_NR_DciDlInfo_Init(v_ResourceAllocationType,
                                v_FreqDomainResourceAssignmentDL,
                                v_TimeDomainResourceAssignment,
                                cs_NR_TransportBlockSchedulingDL_Automatic(v_ModulationScheme, p_RedundancyVersionList),
                                v_HarqProcessConfig,
                                p_DciFormatAndParams);
  }

  template (value) NR_DciDlInfo_Type cs_NR_DciDlInfo_Init(NR_ResourceAllocationType_Type p_ResourceAllocationType,
                                                          template (value) NR_FreqDomainResourceAssignmentDL_Type p_FreqDomainResourceAssignmentDL,
                                                          template (value) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment,
                                                          template (value) NR_TransportBlockSchedulingDL_Type p_TransportBlockSchedulingDL,
                                                          template (value) NR_HarqProcessConfig_Type p_HarqProcessConfig ,
                                                          template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams) :=
  { /* DCI format 1_0 and DCI format 1_1 according to 38.508-1 Table 4.3.6.1.2.1-1 and Table 4.3.6.1.2.1-2 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ResoureAssignment := cs_NR_DciFormat_DL_ResourceAssignment(p_ResourceAllocationType,
                                                                p_FreqDomainResourceAssignmentDL,
                                                                p_TimeDomainResourceAssignment,
                                                                p_TransportBlockSchedulingDL,
                                                                p_HarqProcessConfig),
    VrbPrbMapping := f_NR_InitVrbPrbMapping_NonInterleaved(p_DciFormatAndParams), //@sic R5-234476 sic@
    Format := p_DciFormatAndParams
  };

  /*
   * @desc      Inititialise VRB-to-PRB mapping in nonInterleaved with 0 or 1 bit
   * @param     p_DciFormatAndParams
   * @return    template (value) NR_DciCommon_VrbPrbMapping_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitVrbPrbMapping_NonInterleaved (template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams) return template (value) NR_DciCommon_VrbPrbMapping_Type
  { //@sic R5-234476 sic@
    var template (value) NR_DciCommon_VrbPrbMapping_Type v_NR_DciCommon_VrbPrbMapping := cs_NR_DciCommon_VrbPrbMapping_NonInterleaved1bit;

    select union (valueof(p_DciFormatAndParams)) {
        case (Format_1_1, Format_1_2, Format_1_3) {
            v_NR_DciCommon_VrbPrbMapping := cs_NR_DciCommon_VrbPrbMapping_NonInterleaved0bit;
        }
        //case else variable unchanged
    }
    return v_NR_DciCommon_VrbPrbMapping;
  };

  template (value) NR_DciDlInfo_Type cs_NR_DciDlInfo(template (omit) NR_DciFormat_DL_ResourceAssignment_Type p_ResoureAssignment := omit,
                                                     template (omit) NR_DciCommon_VrbPrbMapping_Type p_VrbPrbMapping := omit,
                                                     template (omit) NR_DciFormat_1_X_SpecificInfo_Type p_Format := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    ResoureAssignment := p_ResoureAssignment,
    VrbPrbMapping := p_VrbPrbMapping,
    Format := p_Format
  };

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                       NR_SearchSpaceType_Type p_SearchSpaceType,
                                                                                       template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams,
                                                                                       template (value) NR_RedundancyVersionList_Type p_RedundancyVersionList,
                                                                                       template (value) NR_AssignedBWPs_Type p_AssignedBWPs := cs_NR_AssignedBWPs_InitialBWP,
                                                                                       boolean p_DciFormat1_0_Cccch := false,
                                                                                       boolean p_Msg4 := false
                                                                                       ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //@sic R5-202677: added p_DciFormat1_0_Cccch R5-251932: added p_Msg4 sic@
    AssignedBWPs := p_AssignedBWPs,
    SearchSpaceType := p_SearchSpaceType,
    DciInfo := f_NR_DciDlInfo_Init(p_PhysicalParameters, p_DciFormatAndParams, p_RedundancyVersionList, p_DciFormat1_0_Cccch, p_Msg4)
  };

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_USS(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                           template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, ussDL, p_DciFormatAndParams, cs_NR_RedundancyVersionList_Def, cs_NR_AssignedBWPs_ActiveBWP);

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_CSSType0(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                                NR_RedundancyVersion_Type p_RV) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, cssType0, cs_NR_DciFormat_1_0_SI_RNTI_Params(tsc_NR_DciFormat_1_0_SystemInfoIndicator_SIB1), cs_NR_RedundancyVersionList_SingleRV(p_RV));

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_CSSType0A(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                                 NR_RedundancyVersion_Type p_RV) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, cssType0A, cs_NR_DciFormat_1_0_SI_RNTI_Params(tsc_NR_DciFormat_1_0_SystemInfoIndicator_SI), cs_NR_RedundancyVersionList_SingleRV(p_RV));

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_CSSType1_Msg2(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, cssType1, cs_NR_DciFormat_1_0_RA_RNTI_Params, cs_NR_RedundancyVersionList_None);

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_CSSType1_Msg4(NR_PhysicalParameters_Type p_PhysicalParameters, boolean p_IsSharedSpectrum) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, cssType1, cs_NR_DciFormat_1_0_Params(p_PhysicalParameters.SubcarrierSpacing, f_NR_InitialiseDciFormat_X_0_ChAccess_CPext(p_IsSharedSpectrum)), cs_NR_RedundancyVersionList_Def, -, true, true); //SharedSpectrum

  template (value) NR_SearchSpaceDlDciAssignment_Type cs_NR_SearchSpaceDlDciAssignment_CSSType2(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cs_NR_SearchSpaceDlDciAssignment(p_PhysicalParameters, cssType2, cs_NR_DciFormat_1_0_P_RNTI_Params, cs_NR_RedundancyVersionList_None);

  /*
   * @desc      Initialise the template to be used in Format 1_0 for ChannelAccess-CPext field: template with None for license spectrum, template with Value for SharedSpectrum
   * @param     p_IsSharedSpectrum
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitialiseDciFormat_X_0_ChAccess_CPext(boolean p_IsSharedSpectrum) return template (value) NR_DciFormat_X_0_ChannelAccessCPext_Type
  {
    var template (value) NR_DciFormat_X_0_ChannelAccessCPext_Type v_NR_DciFormat_X_0_ChannelAccessCPext:= cs_NR_DciFormat_X_0_ChannelAccessCPext_None;
    if (p_IsSharedSpectrum) {
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_NR_DciFormat_X_0_ChannelAccessCPext:= cs_NR_DciFormat_X_0_ChannelAccessCPext_Value(int2bit(2,2)); //@sic R5-243481 sic@ Sharedspectrum, ChAccess_CPext_CAPT:=2 for semiStatic
      }
      else if (pc_ul_DynamicChAccess_r16){
        v_NR_DciFormat_X_0_ChannelAccessCPext:= cs_NR_DciFormat_X_0_ChannelAccessCPext_Value(int2bit(3,2)); //@sic R5-244791 sic@ Sharedspectrum, ChAccess_CPext_CAPT:=3 for dynamic
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
    }
    return v_NR_DciFormat_X_0_ChannelAccessCPext;
  }

  /*
   * @desc      Initialise the template to be used in Format 1_1 for ChannelAccess-CPext field: template with None for license spectrum and dynamic SharedSpectrum, template with Value for semiStatic SharedSpectrum
   * @param     p_IsSharedSpectrum
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitialiseDciFormat_1_1_ChAccess_CPext(boolean p_IsSharedSpectrum) return template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type
  {
    var template (value) NR_DciFormat_1_X_ChannelAccessCPext_Type v_NR_DciFormat_1_X_ChannelAccessCPext:= cs_NR_DciFormat_1_1_ChannelAccessCPext_None;
    if (p_IsSharedSpectrum and pc_ul_Semi_StaticChAccess_r16) { // @sic R5-244791 sic@
      v_NR_DciFormat_1_X_ChannelAccessCPext:= cs_NR_DciFormat_1_1_ChannelAccessCPext_Value(int2bit(2,2)); //@sic R5-243481 sic@ Sharedspectrum, ChAccess_CPext_CAPT:=2 for semiStatic, None for dynamic acc. TS 38.212
    }
    return v_NR_DciFormat_1_X_ChannelAccessCPext;
  }

  /*
   * @desc      Initialise the template to be used in Format 0_1 for ChannelAccess-CPextCAPC field: template with None for license spectrum and dynamic SharedSpectrum, template with Value for semiStatic SharedSpectrum
   * @param     p_IsSharedSpectrum
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitialiseDciFormat_0_1_ChAccess_CPextCAPC(boolean p_IsSharedSpectrum) return template (value) NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type
  {
    var template (value) NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type v_NR_DciFormat_0_X_ChannelAccessCPextCAPC:= cs_NR_DciFormat_0_X_ChannelAccessCPextCAPC_None;
    if (p_IsSharedSpectrum and pc_ul_Semi_StaticChAccess_r16) { // @sic R5-244791 sic@
      v_NR_DciFormat_0_X_ChannelAccessCPextCAPC:= cs_NR_DciFormat_0_X_ChannelAccessCPextCAPC_Value(int2bit(2,2)); //@sic R5-243481 sic@ Sharedspectrum, ChAccess_CPext_CAPT:=2 for semiStatic, None for dynamic acc. TS 38.212
    }
    return v_NR_DciFormat_0_X_ChannelAccessCPextCAPC;
  }

  /*
   * @desc      Wrapper function to use DCI parameters for DCI format 1_1 or 1_0 depending on test case attribute ShortDCI
   * @param     p_PhysicalParameters
   * @param     p_IsSharedSpectrum  (default value: false)
   * @return    template (value) NR_SearchSpaceDlDciAssignment_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SearchSpaceDlDciAssignment_USS(NR_PhysicalParameters_Type p_PhysicalParameters, boolean p_IsSharedSpectrum := false) return template (value) NR_SearchSpaceDlDciAssignment_Type
  {
    var template (value) NR_DciFormat_1_X_SpecificInfo_Type v_DciFormatAndParams;
    if (not (f_GetTestcaseAttrib_ShortDCI(testcasename()))) {
      v_DciFormatAndParams := cs_NR_DciFormat_1_1_Params(p_PhysicalParameters.SubcarrierSpacing, f_NR_InitialiseDciFormat_1_1_ChAccess_CPext(p_IsSharedSpectrum)); //SharedSpectrum
    } else {
      v_DciFormatAndParams := cs_NR_DciFormat_1_0_Params(p_PhysicalParameters.SubcarrierSpacing, f_NR_InitialiseDciFormat_X_0_ChAccess_CPext(p_IsSharedSpectrum)); //SharedSpectrum
    }
    return cs_NR_SearchSpaceDlDciAssignment_USS(p_PhysicalParameters, v_DciFormatAndParams);
  }

}
