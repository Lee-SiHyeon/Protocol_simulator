module NTN_Idle_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.1.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_1_1_NR5GC() runs on NR5GC_PTC
  {//NR NTN / Cell Selection / GNSS location
  
    // System information combination NR-29 as defined in TS 38.508-1 clause 4.4.3.1.2 is used in NR cells
    f_NR5GC_Init(NR_29, -, -, true);//@sic R5-254265 sic@

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_UT_SwitchOnUE(UT, false);//@sic R5s250203 sic@
    //Make sure that No UE location is pre-configured
    f_UT_ConfigureNTNPosition(UT,"No UE location is pre-configured");
    //Now Power OFF the UE
    f_UT_PowerOffUE (UT);
    
    // Preamble: The UE is in state Switched OFF (state 0N-B) according to TS 38.508-1.
    f_NR5GC_Preamble(nr_Cell1, STATE_OFF_0A, -, -, -, -, -, {NoNTN});//@sic R5s250203 sic@
    
    f_NR_TestBody_Set(true);

    fl_TC_6_7_1_1_Body();
    
    f_NR_TestBody_Set(false);
       
    // Finish
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_6_7_1_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_7_1_1_Body() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_NasInd;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    timer t_WaitRRCSetupRequest;

    // @siclog "Step 1" siclog@
    // Power on the UE
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 2" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1 within 6 minutes?
    f_NR_CheckNoRRCSetupReq(nr_Cell1, 360.0, -, "Step 2: UE sent an RRCSetupRequest on NR Cell 1 within 6 minutess");

    // @siclog "Step 3" siclog@
    // Power Off the UE
    f_UT_SwitchOffUE(UT, false);

    // @siclog "Step 4" siclog@
    // Power on UE and pre-configure the UE location with UE`s positioning engine enabled. (Note 1)
    f_NR5GC_SwitchOnAndResetIMS();
    f_NR_PreconfigureNTN_UE("38.508-1 clause 4.5C.1");

    // @siclog "Step 5" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1 within 6 minutes?
    t_WaitRRCSetupRequest.start(f_NR_SetTimerToleranceMin(nr_Cell1, nonProtocolTimer, 360.0));
    alt {
      [] SRB.receive( car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_WaitRRCSetupRequest.stop;
          f_NR_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.7.1.1 Step 5");
        }
      [] t_WaitRRCSetupRequest.timeout
        {
           f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.7.1.1 Step 5: No RRCSetupRequest received within 6 minutes");
        }
    }

    f_NR_ULGrantConfiguration_Start(nr_Cell1, -, -, -, cs_NR_UplinkTimeAlignment_Stop); //@sic R5s250203 sic@
    // @siclog "Step 6-23" siclog@
    v_NasInd := f_NR_RRCSetupComplete_Def(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_NoSecurityProtection);
    
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_NasInd.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, nr_Cell1, v_NasInd, TESTMode_OFF, -, Initial_NoSecurity); //@sic R5s250203 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_1_2_NR5GC() runs on NR5GC_PTC
  {//NR NTN / Cell Selection / MultiTAC / trackingAreaList-r17
      
    // System information combination NR-28 as defined in TS 38.508-1 clause 4.4.3.1.2 is used in NR cells.
    f_NR5GC_Init(NR_29, -, {nr_Cell11}); //@sic R5-252351 sic@
    
    //Configure trackingAreaList in SIB1 as per Table Table 6.7.1.2.3.3-1 and Table 6.7.1.2.3.3-2
    f_NR_CellInfo_SetPLMNIdentityInfo_List (nr_Cell1,
                                            {cs_NR_PLMN_IdentityInfo( f_NR_CellInfo_GetPLMN (nr_Cell1),
                                                                      omit, //@sic R5s250271 sic@
                                                                      1, //RAN_AreaCode set to 1 as per TS 38.508-1 Table 4.6.3-135
                                                                      f_NR_CellInfo_GetCellIdentity(nr_Cell1),
                                                                      {int2bit(1, 24), int2bit(2, 24)}
                                                                    )});
    f_NR_CellInfo_SetPLMNIdentityInfo_List (nr_Cell11,
                                            {cs_NR_PLMN_IdentityInfo( f_NR_CellInfo_GetPLMN (nr_Cell11),
                                                                      omit, //@sic R5s250271 sic@
                                                                      1, //RAN_AreaCode set to 1 as per TS 38.508-1 Table 4.6.3-135
                                                                      f_NR_CellInfo_GetCellIdentity(nr_Cell11),
                                                                      {int2bit(2, 24), int2bit(1, 24)}
                                                                    )});
    
    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell11);
    
    // Preamble: The UE is in test state 1N-A on NR Cell 1 according to TS 38.508-1 [4].
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);
    
    f_NR_TestBody_Set(true);

    fl_TC_6_7_1_2_Body();
    
    f_NR_TestBody_Set(false);
       
    // Finish
    f_NR_Postamble(nr_Cell11, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_6_7_1_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_7_1_2_Body() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_NasInd;

    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;

    v_CellPowerList_AtT1:={
      cs_NR_CellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE), //@sic R5s250271 sic@
      cs_NR_CellPower(nr_Cell11, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2)
    };

    // @siclog "Step 1" siclog@
    // The SS re-adjusts the SS/PBCH EPRE levels and according to row "T1" in table 6.1.2.12.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 11 within 3 minutes?
    f_NR_CheckNoRRCSetupReq(nr_Cell11, 180.0, -, "Step 2: UE sent an RRCSetupRequest on NR Cell 11 within 3 minutes");
    f_NR_ULGrantConfiguration_Start(nr_Cell11); //@sic R5s250105 sic@
    // @siclog "Step 3" siclog@
    // The SS transmits a Paging message on NR Cell 11.
    f_NR_Paging_Def(nr_Cell11, RRC_IDLE);
    
    // @siclog "Step 4" siclog@
    // Check: Does the UE transmit an RRCSetupRequest message on NR Cell 11?
    SRB.receive( car_NR_SRB0_RrcPdu_IND(nr_Cell11, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)));
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.7.1.2 Step 4");

    // @siclog "Step 5-10" siclog@
    // Steps 3 to 8 of the generic test procedure in TS 38.508-1 [4] subclause 4.9.4.2.2-1 are performed on NR Cell 11.
    f_NR_RRCSetup_Def (nr_Cell11);
    v_NasInd := f_NR_RRCSetupComplete_Def(nr_Cell11,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell11, v_NasInd);
    
    // @siclog "Step 11" siclog@
    // The SS transmits an RRCRelease message to move to RRC_IDLE state.
    f_NR_RRCRelease(nr_Cell11);/* @sic R5s250485 sic@ */
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.1.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_1_3_NR5GC() runs on NR5GC_PTC
  { // Cell Selection / Serving cell becomes non-suitable (CellBarredNTN)

    // System information combination NR-28 as defined in TS 38.508-1 clause 4.4.3.1.2 is used in NR cells.
    f_NR5GC_Init(NR_29); //@sic R5-252351 sic@

    // The UE is in Automatic PLMN selection mode.
    f_UT_AutomaticPLMN_Select(UT);
    // The pre-configured UE location is defined in TS 38.508-1 Clause 4.5C
    // Table 6.7.1.3.3.3-1: SIB1 for NR cell 1 - cellBarredNTN-r17 Not present for TP1 - @sic R5s250193 sic@

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // Preamble: The UE is in state Switched OFF (state 0N-B) according to TS 38.508-1.
    f_NR5GC_Preamble(nr_Cell1, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_6_7_1_3_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

  } // end of f_TC_6_7_1_3_NR5GC

  /*
   * @desc      test body of TC_6_7_1_3_NR5GC
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_7_1_3_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var template (omit) NR_BcchToPdschConfig_Type v_NR_BcchToPdschConfig;
    timer t_WaitRRCSetupRequest;

    // @siclog "Step 1" siclog@
    f_NR_CellInfo_SetSIB1_cellBarredNTN_r17(nr_Cell1); // @sic R5s250193 Ch. 3 sic@
    v_NR_BcchToPdschConfig := f_NR_InitialiseBcchToPdschConfig(nr_Cell1);
    f_NR_SS_ConfigureSysinfo(nr_Cell1, -, v_NR_BcchToPdschConfig);
    // Power on the UE
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 2" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1 within the next 60 s?
    f_NR_CheckNoRRCSetupReq(nr_Cell1, 60.0, -, "Step2: UE sent an RRCSetupRequest on NR Cell 1 within 60 s");

    // @siclog "Step 3" siclog@
    // Power Off the UE
    f_UT_PowerOffUE(UT); // @sic R5s250193 Ch. 3 sic@

    // @siclog "Step 4" siclog@
    // SS change NR Cell 1 SIB1 to include  cellBarredNTN and set to "not barred"
    f_NR_CellInfo_SetSIB1_cellBarredNTN_r17(nr_Cell1, notBarred);
    v_NR_BcchToPdschConfig := f_NR_InitialiseBcchToPdschConfig(nr_Cell1);
    f_NR_SS_ConfigureSysinfo(nr_Cell1, -, v_NR_BcchToPdschConfig);

    // @siclog "Step 5" siclog@
    // Power on the UE
    f_NR5GC_SwitchOnAndResetIMS();

    // @siclog "Step 6" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1 within the next 60 s?
    t_WaitRRCSetupRequest.start(f_NR_SetTimerToleranceMin(nr_Cell1, nonProtocolTimer, 60.0));
    alt {
      [] SRB.receive( car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_WaitRRCSetupRequest.stop;
          f_NR_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.7.1.3 Step 6");
        }
      [] t_WaitRRCSetupRequest.timeout
        {
           f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.7.1.3 Step 6: No RRCSetupRequest received within 60 s");
        }
    }

    f_NR_ULGrantConfiguration_Start(nr_Cell1, -, -, -, cs_NR_UplinkTimeAlignment_Stop); // @sic R5s250193 Ch. 3 sic@

    // @siclog "Steps 7-20Da1" siclog@
    // Steps 3 to 20a1 of the registration procedure described in TS 38.508-1 [4] Table 4.5.2.2-2 are performed on NR Cell 1.
    f_NR5GC_RRC_Idle_Steps3_20(nr_Cell1,TESTMode_OFF,noRrcConnectionRelease);

    // @siclog "Step 21" siclog@
    // SS change NR Cell 1 SIB1 to include cellBarredNTN and set to "barred"
    f_NR_CellInfo_SetSIB1_cellBarredNTN_r17(nr_Cell1, barred);

    // @siclog "Step 22" siclog@
    //The SS transmits a Short message on PDCCH using P-RNTI indicating a systemInfoModification.
    f_NR_ModifySysinfo(nr_Cell1); //Modify Sysinfo in SS

    // @siclog "Step 23" siclog@
    // Wait for 2.1* modification period to allow the new system information to take effect.
    f_NR_WaitModificationPeriods (nr_Cell1);

    // @siclog "Step 24" siclog@
    // The SS transmits a Paging message within a paging occasion
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);

    // @siclog "Step 25" siclog@
    // Check: Does the UE send an RRCSetupRequest on NR Cell 1 within the next 60 s?
    f_NR_CheckNoRRCSetupReq(nr_Cell1, 60.0, -, "Step 25: UE sent an RRCSetupRequest on NR Cell 1 within 60 s");

  } // end of fl_TC_6_7_1_3_NR5GC_TestBody

}
