  template (value) SS_AddOrReconfMAC_dFlow cs_SS_AddOrReconfMAC_dFlow(template (value) SS_MAC_hs_AddReconfQueue p_SS_MAC_hs_AddReconfQueue) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
    mac_hs_AddReconfQueue_List := {
      { mac_hs_AddReconfQueue := p_SS_MAC_hs_AddReconfQueue }
    },
    mac_hs_DelQueue_List := omit
  };

  template (value) SS_MAC_hs_AddReconfQueue cs_SS_MAC_hs_AddReconfQueue(template (value) MAC_hs_AddReconfQueue p_MAC_hs_AddReconfQueue) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
    mAChsAddReconfQueue := p_MAC_hs_AddReconfQueue,
    logicalChannelList := {
