    f_IMS_MT_VoiceCall_C11();

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      ResponseSDP for Step4 of TS 34.229-3 clause 12.13a
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS)
   */
  function fl_TC_12_13a_BuildResponseSDP_Step4() runs on IMS_PTC return template (present) SDP_Message
  {
    var template (present) SDP_attribute_fmtp_format_specific_params v_FormatSpecificParameters := ?;
    var template (present) SDP_attribute_list v_SDP_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(cr_SDP_AnyMediaFormatDescr, f_SDP_AttributeRtpmapAudioRX(AMR_16000)),
      cr_SDP_Attribute_fmtp(cr_SDP_AnyMediaFormatDescr, v_FormatSpecificParameters)
    };
    var template (present) SDP_attribute_list v_SDP_PreconditionAttributes := cr_SDP_PreconditionAttributes((c_none, c_sendrecv), c_sendrecv, c_mandatory, c_mandatory);

    return f_IMS_BuildSDP_RX(-, cr_SDP_Media_Audio, v_SDP_MediaAttributes, v_SDP_PreconditionAttributes);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.13a
   * @status    APPROVED (IMS)
   */
  function f_TC_12_13a_IMS1() runs on IMS_PTC
  {
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_WBAMR_AMR;
    var boolean v_RemoteResourcesReservedAlready := true;
    var InternetProtocol_Type v_Protocol;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) INVITE_Request v_InviteRequest;
    var template (value) MessageHeader v_MessageHeader_Invite;
    var template (value) SDP_Message v_SDP_MessageStep1;
    var SipUrl v_ContactUrl;
    var template ContentType v_ContentTypeRinging := omit;
    var template MessageBody v_MessageBodyRinging := omit;
    var template (present) SDP_Message v_SDP_MessageStep4;
    var template (omit) IMS_DATA_RSP v_IMS_RINGING_RSP;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var MessageHeader v_MessageHeader_183;
    var MessageHeader v_MessageHeader_180;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1" siclog@         Send INVITE
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE();
    v_SDP_MessageStep1 := f_IMS_BuildSDP_InitialOfferAudio_TX(v_AudioCodecList, -, -, v_RemoteResourcesReservedAlready);
    v_MessageHeader_Invite := f_IMS_InviteRequest_MessageHeaderTX();
    v_InviteRequest := cs_INVITE_Request(v_ContactUrl, v_MessageHeader_Invite, cs_MessageBody_SDP(v_SDP_MessageStep1));
    v_InviteRequestWithSdp := f_IMS_InviteRequestWithSdpMT(v_InviteRequest, v_SDP_MessageStep1);
    v_Protocol := v_InviteRequestWithSdp.RoutingInfo.Protocol;

    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequest));

    // @siclog "Step 2 (void)" siclog@

    // @siclog "Step 3 - 4" siclog@
    v_SDP_MessageStep4 := fl_TC_12_13a_BuildResponseSDP_Step4();
    v_ResponseWithSdp := f_IMS_MTCallSetup_Receive100Trying_Receive183SessionProgress(v_InviteRequest, v_SDP_MessageStep4, v_Protocol);
    v_MessageHeader_183 := v_ResponseWithSdp.Response.msgHeader;
    v_ContactUrl := f_MessageHeader_GetContactSipUrl(v_MessageHeader_183);
    
    // @siclog "Step 5 - 6" siclog@  Send PRACK, Receive 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequest, v_MessageHeader_183);

    // Establish Dedicated EPS bearer
    // See TS. 36.508 EUTRA/EPS signalling for IMS MT speech call Table 4.5A.7.3-1 Step 9-12
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall);  /* trigger IPCAN to continue with activation of dedicated EPS bearer */

    // @siclog "Step 7 - 9" siclog@     Receive optional 180 Ringing
    v_IMS_RINGING_RSP := f_IMS_ReceiveResponse_Optional(v_MessageHeader_Invite, v_Protocol, cr_Response(c_statusLine180,
                                                                                                        f_IMS_InviteResponse_180_MessageHeaderRX(v_InviteRequest, v_ContentTypeRinging),
                                                                                                        v_MessageBodyRinging));
    if (isvalue(v_IMS_RINGING_RSP)) {
      // @siclog "Step 8 - 9" siclog@     Send PRACK, Receive 200 OK if the 180 response contains 100rel option tag within the Require header
      v_MessageHeader_180 := valueof(v_IMS_RINGING_RSP.Response.msgHeader);
      f_IMS_MTCallSetup_SendPRACK_ReceiveOK_IfRequired(v_InviteRequest, v_MessageHeader_180);
    }
    
    // @siclog "Step 9A" siclog@        Make UE accept the speech AMR offer
    f_UT_AnswerCall(MMI);

    // @siclog "Step 10 - 11" siclog@   Receive 200 OK, Send ACK
    f_IMS_MTCallSetup_Receive200OK_SendACK(v_InviteRequestWithSdp);

    f_Delay(3.0);
    
    // @siclog "Step 12 - 13" siclog@   Send BYE, Receive 200 OK
    f_IMS_CallReleaseMT(v_ContactUrl);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.21
   * @status    APPROVED (IMS)
   */
  function f_TC_12_21_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    
    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);
    
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    // @siclog "Step 3  - 4" siclog@
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_VideoCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearers
    
    // @siclog "Step 5 - 13" siclog@
    f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    
    // @siclog "Step 14 - 15" siclog@
    f_IMS_CallReleaseMO(v_InviteRequest);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.22
   * @status    APPROVED (IMS)
   */
  function f_TC_12_22_IMS1() runs on IMS_PTC
  { /* MT MTSI Video call */
    var IMS_Response_Type v_SessionProgress183;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var template (value) INVITE_Request v_InviteRequest;
    var template (value) SDP_Message v_SDP_MessageStep1;
    var SDP_Message v_SDP_MessageStep4;
    var SipUrl v_ContactUrl;
    
    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_VideoCall);
    
    // @siclog "Step 1" siclog@
    v_SDP_MessageStep1 := f_IMS_BuildSDP_InitialOfferAudioVideo_TX();   /* @sic R5-213524, R5-213538, R5-213539, R5-213541: f_IMS_BuildSDP_MTCallAudioVideo_TX replaced by f_IMS_BuildSDP_InitialOfferAudioVideo_TX sic@ */
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_Video_SendInvite(SetupVideoCall, v_SDP_MessageStep1);  /* @sic R5-172930: v_FmtAudio, v_FmtVideo removed sic@ */
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    // @siclog "Step 2: Void" siclog@
    
    // @siclog "Step 3 - 4" siclog@
    v_ResponseWithSdp := f_IMS_MTCallSetup_Video_Receive183(SetupVideoCall, v_InviteRequestWithSdp);  /* @sic R5-172930: v_FmtAudio, v_FmtVideo removed sic@ */
    v_SessionProgress183 := v_ResponseWithSdp.Response;
    v_SDP_MessageStep4 := v_ResponseWithSdp.SdpMessage;
    v_ContactUrl := f_MessageHeader_GetContactSipUrl(v_SessionProgress183.msgHeader);
    
    // @siclog "Step 5 - 6" siclog@  Send PRACK, Receive 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequest, v_SessionProgress183.msgHeader);       /* @sic R5-181141: steps 5-6 before sending the trigger sic@ */
    
    // Establish Dedicated EPS bearer
    // See TS. 36.508 EUTRA/EPS signalling for IMS MT video call Table 4.5A.9.3-1 Step 13-16
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_VideoCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    // @siclog "Step 7 - 13" siclog@
    f_IMS_MTCallSetup_AnnexC26_Steps7_13(v_InviteRequestWithSdp, v_SDP_MessageStep4);  /* @sic R5-172930: v_FmtAudio, v_FmtVideo removed sic@ */
    
    // MT Call is now established
    
    // Step 14-15. SS sends BYE to release the call; UE sends 200 OK for the BYE request and ends the call
    // @siclog "Step 14 - 15" siclog@
    f_IMS_CallReleaseMT(v_ContactUrl);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MT_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.23
   * @status    APPROVED (IMS)
   */
  function f_TC_12_23_IMS1() runs on IMS_PTC
  {
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR;   /* @sic R5-172931: AMR_16000 is contained in the list of default audio codecs already sic@
                                                                                                       @sic R5-174483: v_AudioCodecList instead of v_AdditionalAudioCodecList sic@ */
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    f_IMS_MOCallSetup_AnnexC21_MOCallRelease(v_AudioCodecList, EVS_16000, EVS_C44, 65);   /* @sic R5s170419 sic@
                                                                                             @sic R5-174649: f_IMS_MOCallSetup_AnnexC21_MOCallRelease sic@
                                                                                             @sic R5-243984: EVS_C44 sic@ */
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.24
   * @status    APPROVED (IMS)
   */
  function f_TC_12_24_IMS1() runs on IMS_PTC
  {
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR;   /* @sic R5-168057: AMR_16000 new default codec sic@
                                                                                                       @sic R5-173535: v_AudioCodecList instead of v_AdditionalAudioCodecs sic@ */
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);
    f_IMS_MTCallSetup_AnnexC11_MTCallRelease(v_AudioCodecList, -, EVS_C45);    /* @sic R5-173535: f_IMS_MTCallSetup_AnnexC11 sic@
                                                                                  @sic R5-243985: EVS_C45 sic@ */

    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.25
   * @status    APPROVED (IMS)
   */
  function f_TC_12_25_IMS1() runs on IMS_PTC
  {
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR;   /* @sic R5-172931: AMR_16000 is contained in the list of default audio codecs already sic@
                                                                                                       @sic R5-174483: v_AudioCodecList instead of v_AdditionalAudioCodecList sic@ */
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    f_IMS_MOCallSetup_AnnexC21_MOCallRelease(v_AudioCodecList, AMR_16000, EVS_C44, 38);   /* @sic R5s170419 sic@
                                                                                             @sic R5-174649: f_IMS_MOCallSetup_AnnexC21_MOCallRelease sic@
                                                                                             @sic R5-243985: EVS_C44 sic@ */
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      modify first SDP media list element: inject SDP media description format attribute parameter
   * @param     p_SDP_media_desc_list
   * @return    template (omit) SDP_media_desc_list
   * @status    APPROVED (IMS)
   */
  function fl_SDP_MediaDesc_AddEvsModeSwitch(template (omit) SDP_media_desc_list p_SDP_media_desc_list) return template (omit) SDP_media_desc_list
  {
    var SDP_media_desc v_MediaDesc := valueof(p_SDP_media_desc_list[0]);
    var charstring v_Fmt := f_SDP_MediaDescr_GetMediaFormat(v_MediaDesc, cr_RTPMAP_EVS_16000); // @sic R5s170232 change 2 sic@
    var SemicolonParam_List v_FmtpParameterList := f_SDP_MediaDescr_GetCodecParameters(v_MediaDesc.attributes, v_Fmt);
    var template (value) SDP_attribute_fmtp_format_specific_params v_FmtpParameters := cs_Fmtp_ParamList(f_SemicolonParam_List_Add_TX(v_FmtpParameterList, cs_EVS_ModeSwitch));   /* @sic R5s170074 change 2 sic@ */
    var template (value) SDP_attribute v_SDP_Attribute_fmtp := cs_SDP_Attribute_fmtp(v_Fmt, v_FmtpParameters);
    var template (present) SDP_attribute v_SDP_Attribute_Anyfmtp := { fmtp := ? };

    return f_IMS_SDP_MediaList_ExchangeAttribute(p_SDP_media_desc_list, v_SDP_Attribute_Anyfmtp, v_SDP_Attribute_fmtp);
  }

  /*
   * @desc      inject FMTP parameters for media attribute in SDP response
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS)
   */
  function fl_TC_12_26_BuildResponseSDP_Step15() runs on IMS_PTC return template (present) SDP_Message
  {
    var template (present) SemicolonParam_List v_ParamList := {cr_EVS_ModeSwitch, *};   /* @sic R5-160917: parameter list without cr_AMR_ModeChangeCapability sic@ */
    var template (present) SDP_attribute_list v_SDP_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(-, cr_RTPMAP_EVS_16000),
      cr_SDP_Attribute_fmtp(-, cr_Fmtp_ParamList(v_ParamList))
    };
    return f_IMS_BuildSDP_RX(-, cr_SDP_Media_Audio, v_SDP_MediaAttributes, cr_SDP_PreconditionAttributes(c_sendrecv, c_sendrecv));
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.26
   * @status    APPROVED (IMS)
   */
  function f_TC_12_26_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var MessageHeader v_MessageHeader_Response183;
    var IMS_SDP_AudioCodecList_Type v_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR;   /* @sic R5-172931: AMR_16000 is contained in the list of default audio codecs already sic@
                                                                                                       @sic R5-174483: v_AudioCodecList instead of v_AdditionalAudioCodecList sic@ */
    var integer v_BandwidthAS := 65;
    var SipUrl v_ContactUrl_UE;
    var SDP_Message v_SDP_LatestOffer;
    var template (value) SDP_Message v_SDP_MessageTX;
    var template (present) SDP_Message v_SDP_MessageRX;
        
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(-, v_AudioCodecList);
    v_ContactUrl_UE := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp.Invite.msgHeader);
    
    // @siclog "Step 3 - 4" siclog@
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp, -, -, -, EVS_16000, EVS_C44, v_BandwidthAS);   /* @sic R5s170817: v_BandwidthAS sic@ @sic R5-243984: EVS_C44 sic@ */
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO speech call Table 4.5A.6.3-1 Step 9-11
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    // @siclog "Step 5 - 13" siclog@
    v_SDP_LatestOffer := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183, -, -, -, EVS_16000, EVS_C44);

    // preparation of new SDP for Step 14
    v_SDP_MessageTX := f_IMS_BuildSDP_UpdatedAnswer_TX(v_SDP_LatestOffer); // SDP offer from step 6 or 8, with incremented sess-version
    // @sic R5s170232 sic@ - removed  v_SDP_MessageTX := f_IMS_BuildSDP_CommonResponseToOfferTX(v_SDP_MessageTX);
    v_SDP_MessageTX.media_list := fl_SDP_MediaDesc_AddEvsModeSwitch(v_SDP_MessageTX.media_list);
    
    // preparation of expected SDP for Step 15
    v_SDP_MessageRX := fl_TC_12_26_BuildResponseSDP_Step15();

    // @siclog "Step 14 - 15A" siclog@
    f_IMS_MTSessionModification(v_ContactUrl_UE, v_SDP_MessageTX, v_SDP_MessageRX);                    /* @sic R5-197039, R5-197040: common function f_IMS_MTSessionModification sic@ */

    // Step 16-17. SS sends BYE to release the call; UE sends 200 OK for the BYE request and ends the call
    // @siclog "Step 16 -17" siclog@
    f_IMS_CallReleaseMT(v_ContactUrl_UE);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
