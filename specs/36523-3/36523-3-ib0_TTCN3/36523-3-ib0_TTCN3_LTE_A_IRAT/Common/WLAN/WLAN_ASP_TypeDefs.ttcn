module WLAN_ASP_TypeDefs {
  
  import from CommonDefs all;
  import from IP_ASP_TypeDefs all; //for IPsec_SecurityAssociation_Type

  group Common {                /* Type definitions being common for WLAN AP and ePDG */

  type record WLAN_ReqAspControlInfo_Type {
    boolean CnfFlag,            /* true => SS shall send CNF:
                                 * when the REQ is with no timing information (no activation time), SS shall send the confirmation when the configuration is done, i.e. when the test case may continue.
                                 * Example:
                                 * when there is a configuration followed by a send event it shall not be necessary to have a wait timer in between but the CNF triggers the send event or system Command.
                                 * If there are other triggers e.g. like the UE sending a message, CnfFlag shall be set to false by the test case to avoid racing conditions with the CNF and the signalling message.
                                 * When there is an activation time SS shall send the CNF after the configuration has been scheduled;
                                 * that means SS shall not wait until the activation time has been expired.
                                 */
    boolean FollowOnFlag        /* false => no further (related) information
                                 * true: further related information will be sent to SS; currently this value is not foreseen to be used. */
  };
  
  type record WLAN_ErrorIndication_Type {
    integer System              /* any other error: may be SS specific error code; this will not be evaluated by TTCN;
                                 * e.g. an error shall be raised when the UE performs an out of sequence signalling */
  };
  
  type union WLAN_IndicationStatus_Type {
    Null_Type                   Ok,
    WLAN_ErrorIndication_Type   Error
  };

  type union WLAN_ConfirmationResult_Type {
    Null_Type                   Success,
    integer                     Error           /* may contain SS specific error code; this will not be evaluated by TTCN */
  };

  } // End group Common
  
  //----------------------------------------------------------------------------

  group WLAN_AP {
  
  const integer tsc_WLAN_MaxNumberOfCells := 3 ; // Only one cell is foreseen to be used. defined 3 just for completeness.
  
  type WLAN_FeaturesToBeConfigured WLAN_RulesToBeTested ("ANDSF_Rules", "RAN_Rules");
  type charstring WLAN_FeaturesToBeConfigured ("ANDSF_Rules", "RAN_Rules", "BeaconRSSI", "BackhaulDL", "BackhaulUL", "ChannelUtilization");
  
  type enumerated WLAN_Band_Type   {
      Band2_4Ghz, // Band2_4Ghz  = 2.4 Ghz ISM band
      Band5Ghz,// Band5Ghz  = 5Ghz ISM band
      Band3_6Ghz //Band3_6Ghz  = 3.6 Ghz ISM band
  };

  type integer WLAN_ChannelNumber_Type (1..2047);               /* Channel Number of WLAN Channel
                                                                 * 1 to 14 belong to 2.4 Ghz ISM band
                                                                 * 131-138 belong to 3.6 Ghz ISM band
                                                                 * 36,40,44,48,52,56,60,64,100,104,108,112,116,120,124,128,132,136,140,149,153,157,161&165 belong to 5Ghz ISM band
                                                                 * Other channel numbers may be defined in future for other bands and are reserved until defined
                                                                 * Channel number uniquely identifies the frequency */
  
  type integer WLAN_BeaconRSSI_Type (0..255);                   /* WLAN Beacon RSSI signal strength in dBm is defined in IEEE 802.11-2012, Part 11 table 6.7 as integer -100..40,
                                                                 * but defined in TS 36.331/25.331 in ASN.1 as integer(0..255).
                                                                 * So actual beacon RSSI(dBm) = value -128. Note: Values 0..27 and 169..255 are not used or spares */
  type integer WLAN_ChannelUtilizationType (0..255);            /* As defined in in IEEE 802.11-2012, Part 11 clause 8.4.2.20 used in BSS load element */
  
  type integer WLAN_AttenuationValue_Type (0..127);

  type union WLAN_RoutingInfo_Type {
    Null_Type None                     /* place holder for any possible extensions, currently only none defined */
  };
  
  type O8_Type WLAN_TimeStamp_Type;     /* TimeStamp field (TSF) timer in microseconds as defined in IEEE 802.11-2012 clause 8.4.1.10 */
  
  type union WLAN_TimingInfo_Type {
    WLAN_TimeStamp_Type  TimeStamp,
    Null_Type            Now,           /* to be used in REQ ASPs when there is no 'activation time' */
    Null_Type            None           /* only to be used in WLAN_AP_SYSTEM_CTRL_CNF */
  };
  
  type record WLAN_ReqAspCommonPart_Type {
    WLAN_CellId_Type            CellId,
    WLAN_RoutingInfo_Type       RoutingInfo,
    WLAN_TimingInfo_Type        TimingInfo,
    WLAN_ReqAspControlInfo_Type ControlInfo
  };

  type record WLAN_IndAspCommonPart_Type {
    WLAN_CellId_Type            CellId,
    WLAN_RoutingInfo_Type       RoutingInfo,
    WLAN_TimingInfo_Type        TimingInfo,
    WLAN_IndicationStatus_Type  Status
  };

  type record WLAN_CnfAspCommonPart_Type {
    WLAN_CellId_Type                CellId,
    WLAN_RoutingInfo_Type           RoutingInfo,
    WLAN_TimingInfo_Type            TimingInfo,
    WLAN_ConfirmationResult_Type    Result      /* Similar definition as EUTRA */
  };

  type union WLAN_Attenuation_Type {                       /* attenuation of the reference power */
    WLAN_AttenuationValue_Type            Value,          /* cell power reference power reduced by the given attenuation (value is in dB) */
    Null_Type                              Off             /* for non suitable off cell we specify an explicit "Off" value here */
  };

  type record WLAN_CellAttenuation_Type {
    WLAN_CellId_Type            CellId,
    WLAN_Attenuation_Type       Attenuation
  };

  type record length(1..tsc_WLAN_MaxNumberOfCells) of WLAN_CellAttenuation_Type WLAN_CellAttenuationList_Type;

  type record WLAN_InitialCellPower_Type {
    WLAN_BeaconRSSI_Type        BeaconRSSI,     /* maximum value of beacon RSSI
                                                 * a cell is initialised with this Beacon RSSI;
                                                 * its value is the upper bound of the Beacon RSSI during the test case */
    WLAN_Attenuation_Type       Attenuation     /* initial attenuation Cell is off */
  };
  
  type enumerated WLAN_Revision_Type {
    Rev_2012,           /* 802.11-2012, specified to be used in corespecs */
    Rev_n               /* 802.11n */
  };
  
  type enumerated WLAN_ChannelBandwidth_Type {
    bw5,                /* 5 Mhz */
    bw10,               /* 10 Mhz */
    bw20,               /* 20 Mhz */
    bw40,               /* 40 Mhz */
    bw80                /* 80 Mhz */
  };

  type record WLAN_Identifiers_Type {
    octetstring SSID  length (1..32)  optional,
    O6_Type BSSID    optional,
    O6_Type HESSID   optional
  };

  type enumerated WLAN_Hotspot_Version_Type{
    None,               /* no hotspot certification */
    Rev_2,              /* Refered in core spec; Hotspot Revision 2.0 release 2 */
    Rev_1               /* Hotspot Revision 1.0 */
  };

  type record WLAN_AP_Parameters_Type {                         /* Parameters specific to WLAN AP */
    WLAN_Band_Type                      WLAN_Band,
    WLAN_ChannelNumber_Type             ChannelNumber,          /* WLAN band and channel number identify the frequency */
    WLAN_ChannelBandwidth_Type          ChannelBandwidth,       /* Channel Bandwidth of 802.11 */
    WLAN_Identifiers_Type               WLAN_Identifiers,       /* defined in 36.331, need to figure out how to import or define an equivalent */
    WLAN_Revision_Type                  WLAN_Revision,          /* Version of WLAN AP, core specs specify it to be 802.11-2012 */
    WLAN_Hotspot_Version_Type           WLAN_Hotspot_Version    /* Hotspot certification version, Core spec specify it is Hotspot 2.0 */
  };
  
  type record WLAN_AP_AddressInfo_Type {
    charstring UE_IPAddressIPv4,        /* IP Address of the UE in the WLAN */
    charstring UE_IPAddressIPv6,        /* IP Address of the UE in the WLAN */
    charstring DNS_ServerAddressIPv4,   /* IP address of the DNS server (WLAN) */
    charstring DNS_ServerAddressIPv6    /* IP address of the DNS server (WLAN) */
  };

  type record WLAN_AP_CellConfigInfo_Type {
    WLAN_AP_AddressInfo_Type            AP_AddressInfo,         /* IP addresses to be assigned to the UE while it associates to the WLAN AP */
    WLAN_AP_Parameters_Type             WLAN_AP_Parameters,     /* Parameters for WLAN AP*/
    WLAN_InitialCellPower_Type          InitialCellPower        /* Power level parameters */
  };
  
  type union WLAN_AP_CellConfigRequest_Type {
    WLAN_AP_CellConfigInfo_Type         AddOrReconfigure,       /* for cell configuration:
                                                                 * CellId : identifier of the cell to be configured
                                                                 * RoutingInfo : None
                                                                 * TimingInfo : Now (for initial configuration and for reconfiguration in general)
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
    Null_Type                           Release                 /* to remove a cell completely -
                                                                 * CellId : identifier of the cell to be released; Cell_NonSpecific, in case all cells shall be released
                                                                 * RoutingInfo : None
                                                                 * TimingInfo : Now
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
  };
  
  type record WLAN_OffloadSpecificParams_Type {                 /* parameters that are used for offload to/from WLAN and controlled by Hotspot 2.0 version 2 */
    WLAN_ChannelUtilizationType ChannelUtilisation optional,    /* omit means unchanged,
                                                                 * if present AP transmits this parameter in BSS Load element
                                                                 * IEEE 802.11-2012 clause 8.4.2.30 */
    O4_Type                     BackHaulDLBandwidth optional,   /* Omit means unchanged, DL WAN bandwidth in kbps
                                                                 * If present AP hotspot uses this value in WAN Metrics element
                                                                 * Hotspot 2.0 release 2 clause 4.4 */
    O4_Type                     BackHaulULBandwidth optional    /* Omit means unchanged,  UL WAN bandwidth in kbps
                                                                 * If present AP hotspot uses this value in WAN Metrics element
                                                                 * Hotspot 2.0 release 2 clause 4.4 */
  };

  type union WLAN_AP_SystemRequest_Type {
    WLAN_AP_CellConfigRequest_Type    Cell,                     /* configure/release a cell */
    WLAN_CellAttenuationList_Type     CellAttenuationList,      /* power attenuation for one or several cells, WLAN AP;
                                                                 * all cells included in the list shall be changed at the same time;
                                                                 * all cells in the list shall reach the new cell power within a maximum of 100ms (10 frames) */
    WLAN_OffloadSpecificParams_Type  OffloadSpecificParams      /* parameter used in offload decisions */
  };
  
  type union WLAN_AP_SystemConfirm_Type {                       /* confirmations for system configuration; in general to be sent after the configuration has been done */
    Null_Type                           Cell,                   /* (no further parameters from SS) */
    Null_Type                           CellAttenuationList,    /* (no further parameters from SS)
                                                                 * NOTE 1: the confirmation shall be sent when all cells have changed power levels
                                                                 * NOTE 2: for the CellId in the common ASP part the same rules are applied as for theWLAN SYSTEM REQ */
    Null_Type                           OffloadSpecificParams   /* (no further parameters from SS) */
  };
  
  type union WLAN_AP_SystemCommand_Type {
    Null_Type                           AssociateWLANAP,        /* To prepare SS to expect WLAN association by the UE:
                                                                 * SS shall indicate when the UE has already associated or if not already associated, indicate when the UE associates */
    Null_Type                           DisassociateWLANAP      /* To prepare SS to expect WLAN disassociation by the UE:
                                                                 * SS shall indicate when the UE has already disassociated or if not already disassociated, indicate when the UE disassociates */
  };
  
  type union WLAN_AP_SystemIndication_Type {
    Null_Type                           Error,                  /* Used by SS to indicate any error;
                                                                 * the Actual Error types reported in ASP common part in WLAN_IndicationStatus_Type */
    Null_Type                           AssociateWLANAP_Ind,    /* UE has associated to WLAN as per IEEE 802.11-2012 clause 4.5.3.3 */
    Null_Type                           DisassociateWLANAP_Ind  /* UE has disassociated from WLAN as per IEEE 802.11-2012 clause 4.5.3.5 */
  };
  
  type record WLAN_AP_SYSTEM_CTRL_REQ {
   WLAN_ReqAspCommonPart_Type           Common,                 /* CellId : Cell Id of the WLAN AP
                                                                 * RoutingInfo : None
                                                                 * TimingInfo : Now
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
   WLAN_AP_SystemRequest_Type           Request
  };
  
  type record WLAN_AP_SYSTEM_CTRL_CNF {
    WLAN_CnfAspCommonPart_Type          Common,                 /* TimingInfo is ignored by TTCN
                                                                 * => SS may set TimingInfo to "None" */
    WLAN_AP_SystemConfirm_Type          Confirm
  };
  
  type record WLAN_AP_SYSTEM_CMD {
    WLAN_ReqAspCommonPart_Type          Common,                 /* CellId : Cell Id of the WLAN AP
                                                                 * RoutingInfo : None
                                                                 * TimingInfo : Now (in general)
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
    WLAN_AP_SystemCommand_Type          Command                 /* WLAN AP System commands */
  };

  type record WLAN_AP_SYSTEM_IND {
    WLAN_IndAspCommonPart_Type          Common,                 /* The SS shall provide TimingInfo depending on the respective indication: */
    WLAN_AP_SystemIndication_Type       Indication              /* - Error
                                                                 *   TimingInfo: related to the error (if available)
                                                                 * - WLAN offload Procedure completion
                                                                 *   The timing info corresponding to logical completion of the complete procedure
                                                                 *   includes completion of all sub protocols */
  };

  type port WLAN_AP_SYSTEM_PORT message {                       /* WLAN PTC: Port for WLAN AP system configuration */
    out WLAN_AP_SYSTEM_CTRL_REQ;
    in  WLAN_AP_SYSTEM_CTRL_CNF;
  };
  
  type port WLAN_AP_SYSCMD_IND_PORT message {                   /* WLAN PTC: Port for WLAN AP system indications/Commands */
    out WLAN_AP_SYSTEM_CMD;
    in  WLAN_AP_SYSTEM_IND;
  };

  } // End group WLAN_AP

  //----------------------------------------------------------------------------

  group WLAN_ePDG {

  type record WLAN_PDN_AddressInfo_Type {           /* Identifier of a specific IPsec tunnel */
    charstring UE_IPAddressIPv4,                    /* PDN IP Address of the UE in the 3GPP network */
    charstring UE_IPAddressIPv6,                    /* PDN IP Address of the UE in the 3GPP network */
    charstring PCSCF_IPAddressIPv4   optional,      /* IP address of the P-CSCF (3GPP network); may be omitted in case of non-IMS PDN */
    charstring PCSCF_IPAddressIPv6   optional,      /* IP address of the P-CSCF (3GPP network); may be omitted in case of non-IMS PDN*/
    charstring DNS_ServerAddressIPv4 optional,      /* IP address of DNS-Server (3GPP network);may be omitted in case of IMS PDN
                                                     * DNS-Server shall resolve the IP address of any other server (e.g. XCAP) located in the 3GPP network for this PDN*/
    charstring DNS_ServerAddressIPv6 optional       /* IP address of DNS-Server (3GPP network);may be omitted in case of IMS PDN
                                                     * DNS-Server shall resolve the IP address of any other server (e.g. XCAP) located in the 3GPP network for this PDN*/
  };
  
  type union WLAN_ePDG_RoutingInfo_Type {
    Null_Type               None,       /* shall be used in configuration requests and configuration confirmations which are not specific for a particular PDN (IPsec tunnel) */
    PDN_Index_Type    PdnId       /* shall be used in IPsec tunnel specific commands and indications */
  };

  type record WLAN_ePDG_ReqAspCommonPart_Type {
    WLAN_ePDG_RoutingInfo_Type      RoutingInfo, /* None" in case of configuration of ePDG;specific PdnId in case of commands sent to a particular IPsec tunnel (PDN)*/
    WLAN_ReqAspControlInfo_Type     ControlInfo
  };
  
  type record WLAN_ePDG_IndAspCommonPart_Type {
    WLAN_ePDG_RoutingInfo_Type      RoutingInfo, /* PdnId as configured for the IPsec tunnel (PDN) for which an indication is raised*/
    WLAN_IndicationStatus_Type      Status
  };
  
  type record WLAN_ePDG_CnfAspCommonPart_Type {
    WLAN_ePDG_RoutingInfo_Type      RoutingInfo, /*As in the corresponding request*/
    WLAN_ConfirmationResult_Type    Result
  };
  
  type record WLAN_EAP_AKA_Cntrl_Type { /* configurable parameters for EAP AKA */
    hexstring IMSI,                     /* IMSI/USIM of UE */
    B128_Type RAND,                     /* RAND to be used in initial key derivation */
    B128_Type AuthK                     /* Authentication secret key shared between AAA-server and USIM */
  };
  
  type record IPsec_ePDG_Cntrl_Type {   /* Parameters to be used for all IPsec security associations between UE and ePDG */
    IPsec_IntegrityAlgorithm_Type IntegrityAlgorithm,
    IPsec_CipheringAlgorithm_Type CipheringAlgorithm
  };
  
  type record WLAN_ePDG_PDN_ConfigInfo_Type {                   /* Data set of PDN specific information being used for establishment of an IPsec tunnel */
    PDN_Index_Type                PdnId,                  /* PdnId to be used in commands and indications referring to a respective IPsec tunnel */
    WLAN_PDN_AddressInfo_Type           PDN_AddressInfo,        /* Various IP Addresses to be used */
    IPsec_ePDG_Cntrl_Type               IPsec_SA,               /* Parameters for ePDG secure tunnels */
    WLAN_EAP_AKA_Cntrl_Type             EAP_AKA_Cntrl           /* Parameters for EAP AKA control */
  };
  
  type record of WLAN_ePDG_PDN_ConfigInfo_Type WLAN_ePDG_PDN_ConfigInfoList_Type;
  
  type record WLAN_ePDG_ConfigInfo_Type {
    charstring                          ePDG_IPAddressIPv4,     /* IP address of the ePDG in the non-3GPP network */
    charstring                          ePDG_IPAddressIPv6,     /* IP address of the ePDG in the non-3GPP network */
    WLAN_ePDG_PDN_ConfigInfoList_Type   IPsecTunnelList         /* In general there is just one IPsec tunnel configured (e.g. for IMS in case of IMSoWLAN);
                                                                 * in case of IMSoWLAN XCAP scenarios there may be a second IPsec tunnel in which case the same working assumption is applied
                                                                 * as for IMSoLTE according to which connectivity for IMS is established first and connectivity to XCAP is using the second IPsec tunnel
                                                                 * => according to this working assumption the data set for the IMS IPsec tunnel shall be the first one and the data set for
                                                                 * the XCAP IPsec tunnel shall be the second one.*/
  };
  
  type union WLAN_ePDG_ConfigRequest_Type {                     /* Configuration of ePDG and AAA-server emulation */
    WLAN_ePDG_ConfigInfo_Type           AddOrReconfigure,       /* to setup configuration of ePDG and AAA-server emulation */
    Null_Type                           Release                 /* to release the ePDG/AAA-server emulation */
  };
  
  type union WLAN_ePDG_SystemRequest_Type {
    WLAN_ePDG_ConfigRequest_Type        ePDG                    /* setup/release configuration of ePDG and AAA-server emulation */
  };
  
  type union WLAN_ePDG_SystemConfirm_Type {                     /* confirmations for system configuration; in general to be sent after the configuration has been done */
    Null_Type                           ePDG                    /* (no further parameters from SS) */
  };
  
  type union WLAN_ePDG_SystemCommand_Type {
    Null_Type                           IpsecTunnelDiscCmd      /* To trigger SS for ePDG initiated tunnel disconnection procedure according to TS 24.302 clause 7.4.3.1 (and IETF RFC 5996 clause 1.4) */
  };
  
  type enumerated EAP_AKA_Cmpl_Status_Type { success, failure };
  
  type record EAP_AKA_Cmpl_Type {
    EAP_AKA_Cmpl_Status_Type    EAP_AKA_Status,
    integer                     XRES_Length optional    /* provide XRES_Length for success status */
   };
   
   type record IKE_AUTH_Req_Type {
    charstring  AccessPointName optional    /* Indication raised by the SS when the UE sends APN in IKE_AUTH_Req_Type. APN might be omitted when the UE establishes IPSec Tunnel for the Default APN acc. to 24.302 clause 7.2.2. */
   };


  type union IPsecTunnelEstabInd_Type {
    Null_Type                   IKE_SA_INIT_Ind,        /* indication by the SS that the UE has started the attempt to establish an IPsec tunnel to the ePDG by sending an initial IKEv2 IKE_SA_INIT (step 1 of Figure 8.2.2-1 in 33.402)
                                                           NOTE: the major purpose of this primitive is to get an early indication when the UE shall not attempt to establish the IPsec tunnel */
    IKE_AUTH_Req_Type           IKE_AUTH_Req,           /* Indication by the SS that the UE has started the attempt to establish an IPsec tunnel with a specific PDN.NOTE: The purpose of this indication is to get the APN of the PDN requested by the UE. */
    EAP_AKA_Cmpl_Type           EAP_AKA_Cmpl,           /* indication by the SS that the UE has provided all necessary parameters for EAP-AKA and the SS has sent an EAP Success/Failure message to UE according to step 11 of Figure 8.2.2-1 in 33.402 */
    Null_Type                   IPSecTunnelEstabCmpl    /* indication by the SS that IPsec tunnel is established: SS shall indicate this immediately after it has sent out the final IKE_AUTH response (containing the CFG_REPLY) at step 15 of Figure 8.2.2-1 in 33.402
                                                           NOTE: Typically the UE gets all relevant IP addresses of the 3GPP network in the configuration payload (CFG_REPLY) */
  };

  type union IPsecTunnelDiscInd_Type {
    Null_Type                   IPSecTunnelRelCmpl      /* Indication raised by the SS when the SS has received INFORMATIONAL response from the UE according to TS 24.302 clause 7.2.4.2
                                                         * (ePDG initiated tunnel disconnection) or
                                                         * SS has sent INFORMATIONAL response according to TS 24.302 clause 7.4.3.2 (UE initiated tunnel disconnection) */
  };

  type union WLAN_ePDG_SystemIndication_Type {
    Null_Type                   Error,                  /* Used by SS to indicate any error;
                                                         * the Actual Error types reported in ASP common part in WLAN_IndicationStatus_Type */
    IPsecTunnelEstabInd_Type    IPsecTunnelEstabInd,    /* To indicate progress for IPsec tunnel establishment */
    IPsecTunnelDiscInd_Type     IPsecTunnelDiscInd      /* To indicate progress for release of the IPsec tunnel */
  };
  
  type record WLAN_ePDG_SYSTEM_CTRL_REQ {
    WLAN_ePDG_ReqAspCommonPart_Type     Common,                 /* RoutingInfo : None
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
    WLAN_ePDG_SystemRequest_Type        Request
  };
  
  type record WLAN_ePDG_SYSTEM_CTRL_CNF {
    WLAN_ePDG_CnfAspCommonPart_Type     Common,                 /* RoutingInfo : As in the corresponding request  */
    WLAN_ePDG_SystemConfirm_Type        Confirm
  };
  
  type record WLAN_ePDG_SYSTEM_CMD  {
    WLAN_ePDG_ReqAspCommonPart_Type     Common,                 /* RoutingInfo: PdnId addressing the IPsec tunnel (PDN) for which the command shall be applied
                                                                 * ControlInfo : CnfFlag:=false; FollowOnFlag:=false */
    WLAN_ePDG_SystemCommand_Type        Command                 /* WLAN ePDG System commands */
  };

  type record WLAN_ePDG_SYSTEM_IND {
    WLAN_ePDG_IndAspCommonPart_Type     Common,         /* RoutingInfo : PdnId of the IPsec tunnel (PDN) the indication is coming from. Status : Ok | Error */
    WLAN_ePDG_SystemIndication_Type     Indication
  };
  
  type port WLAN_ePDG_SYSTEM_PORT message {             /* WLAN PTC: Port for WLAN ePDG/AAA-Server system configuration */
    out WLAN_ePDG_SYSTEM_CTRL_REQ;
    in  WLAN_ePDG_SYSTEM_CTRL_CNF;
  };
  
  type port WLAN_ePDG_SYSCMD_IND_PORT message {         /* WLAN PTC: Port for WLAN ePDG/AAA-Server emulation system indications/Commands */
    out WLAN_ePDG_SYSTEM_CMD;
    in  WLAN_ePDG_SYSTEM_IND;
  };

  } // End group WLAN_ePDG

  
}

