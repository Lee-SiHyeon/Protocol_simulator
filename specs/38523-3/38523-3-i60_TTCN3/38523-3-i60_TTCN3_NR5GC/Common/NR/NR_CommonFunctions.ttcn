module NR_CommonFunctions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_NR_Parameters all;
  import from IP_PTC_CtrlMsgs all;
  import from LoopbackIP all;
  import from NG_NAS_MsgContainers all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_NTN_Configuration all;
  import from NR_PDCP_Templates all;
  import from NR_PDCP_TypeDefs all;
  import from NR_Parameters all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_SecuritySteps all;
  import from NR_Timing all;
  import from SDAP_TypeDefs all;

   type enumerated ReconfigurationWithSyncAvailable_Type { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
        reconfigurationWithSync_CheckRACH,
        noRACH_Check
    }

  /*
   * @desc      Get the default RadioBearer config to be sent in the Reconfiguration message for ENDC on RLC UM
   * @param     p_NR_CellId
   * @param     p_DrbId
   * @param     p_LinkToOtherCellGroup (default value: crs_RlcBearerRouting_None)
   * @param     p_PDCP_RbConfig     (default value: cs_NR_PDCP_RbConfig_ParamsDRB)
   * @param     p_Sdap              (default value: omit)
   * @return    template (value) NR_RadioBearer_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT)
   */
   function f_NR_GetRadioBearerConfig_FullUM(NR_CellId_Type p_NR_CellId,
                                            DRB_Identity p_DrbId,
                                            template (value) RlcBearerRouting_Type p_LinkToOtherCellGroup := crs_RlcBearerRouting_None,
                                            template (omit)  NR_PDCP_RbConfig_Type p_PDCP_RbConfig := cs_NR_PDCP_RbConfig_ParamsDRB,
                                            template (omit)  SDAP_Configuration_Type p_Sdap := omit)
    runs on NR_BASE_PTC return template (value) NR_RadioBearer_Type
  {
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (value) NR_PDCP_Configuration_Type v_PDCP_Configuration := cs_NR_PDCP_Configuration_RBTerminating(p_PDCP_RbConfig, p_LinkToOtherCellGroup);
    var template (value) NR_RlcBearerConfig_Type v_RlcBearerConfig := cs_NR_RlcBearerConfig_UM(v_IsFR1, -, f_NR_LogicalChannelId_DRB(p_DrbId));
    return cs_NR_SS_DRB_Config(p_DrbId, v_PDCP_Configuration, v_RlcBearerConfig, p_Sdap);
  }

  /*
   * @desc      Get the default RadioBearer config to be sent in the Reconfiguration message for ENDC on RLC AM
   * @param     p_NR_CellId
   * @param     p_DrbId
   * @param     p_LinkToOtherCellGroup (default value: crs_RlcBearerRouting_None)
   * @param     p_PDCP_RbConfig     (default value: cs_NR_PDCP_RbConfig_ParamsDRB)
   * @param     p_NR_RLC_TestModeConfig (default value: omit)
   * @param     p_Sdap              (default value: omit)
   * @param     p_LogicalChannelId  (default value: omit)
   * @param     p_T_PollRetransmit  (default value: omit)
   * @return    template (value) NR_RadioBearer_Type
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetRadioBearerConfig_FullAM(NR_CellId_Type p_NR_CellId,
                                            DRB_Identity p_DrbId,
                                            template (value) RlcBearerRouting_Type p_LinkToOtherCellGroup := crs_RlcBearerRouting_None,
                                            template (omit)  NR_PDCP_RbConfig_Type p_PDCP_RbConfig := cs_NR_PDCP_RbConfig_ParamsDRB,
                                            template (omit)  NR_RLC_TestModeConfig_Type p_NR_RLC_TestModeConfig := omit,   // Testmodeconfig
                                            template (omit)  SDAP_Configuration_Type p_Sdap := omit,
                                            template (omit)  NR_LogicalChannelId_Type p_LogicalChannelId := omit,  //when a non default value is applied
                                            template (omit)  T_PollRetransmit p_T_PollRetransmit := omit
                                            )
    runs on NR_BASE_PTC return template (value) NR_RadioBearer_Type
  { //@sic R5s200690: added  p_T_PollRetransmit sic@
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (omit) NR_LogicalChannelId_Type v_LogicalChannelId := f_NR_LogicalChannelId_DRB(p_DrbId);  //Default value
    var template (value) NR_PDCP_Configuration_Type v_PDCP_Configuration := cs_NR_PDCP_Configuration_RBTerminating(p_PDCP_RbConfig, p_LinkToOtherCellGroup);
    var template (value) NR_RlcBearerConfig_Type v_RlcBearerConfig;
    if (isvalue (p_LogicalChannelId)) { //Use the parameterised value when passed - non default value
        v_LogicalChannelId := p_LogicalChannelId;
    }
    v_RlcBearerConfig := cs_NR_RlcBearerConfig_AM(v_IsFR1, p_NR_RLC_TestModeConfig, v_LogicalChannelId);
    if (isvalue(p_T_PollRetransmit)) {
      v_RlcBearerConfig.Config.Rlc.Rb.AM.Tx.R15.t_PollRetransmit := p_T_PollRetransmit;
    }
    return cs_NR_SS_DRB_Config(p_DrbId, v_PDCP_Configuration, v_RlcBearerConfig, p_Sdap);
  }

  /*
   * @desc      Get Default SCGConfig to send in RRC Reconfiguration message
   *            Acc to 38.508-1 Table 4.6.3-19: CellGroupConfig with with condition EN-DC
   *            NOTE: function specific to ENDC -> tsc_NR_DRB2 is (re)configured
   * @param     p_NR_CellId
   * @param     p_DrbId             (default value: tsc_NR_DRB2)
   * @return    template
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetSCGConfigDef(NR_CellId_Type p_NR_CellId, DRB_Identity p_DrbId := tsc_NR_DRB2)  runs on NR_BASE_PTC return template (value) CellGroupConfig
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RLC_BearerConfig v_RLC_BearerConfig;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_NR_CellId);
    var template (value) PhysicalCellGroupConfig v_PhysicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(p_NR_CellId);
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (value) UL_AM_RLC v_ParametersTX := f_NR_UL_AM_RLC(v_IsFR1);
    var template (value) DL_AM_RLC v_ParametersRX := f_NR_DL_AM_RLC(v_IsFR1);
    var template (value) SpCellConfig v_SpCellConfig := f_NR_GetSpCellConfigDef(p_NR_CellId);
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_NR_CellId); //@sic R5s201387 sic@
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
    
    v_RLC_BearerConfig := cs_38508_RLC_BearerConfig_DRB(p_DrbId,
                                                        cs_38508_RLC_Config_AM_DRB(v_ParametersTX, v_ParametersRX),
                                                        cs_38508_LogicalChannelConfig_DRB(-,-,-,-,-,f_NR_SharedAccessChAccPriority(p_NR_CellId)),  //SharedAccess @sic R5-243536 sic@
                                                        -,
                                                        v_RLC_Config_v1700);
    
    v_SCGConfig := cs_38508_CellGroupConfig(v_CellGroupId,
                                            {v_RLC_BearerConfig},
                                            omit,
                                            v_MAC_CellGroupConfig,
                                            v_PhysicalCellGroupConfig,
                                            v_SpCellConfig);
    return v_SCGConfig;
  }

  /*
   * @desc      Get Default CellgroupConfig to send in RRC Reconfiguration message to establish one DRB and SRB2 (if p_ConfigSRB2)
   *            Acc to 38.508-1 Table 4.6.3-19: CellGroupConfig with Condition SRB2_DRB1 or DRB1
   * @param     p_NR_CellId
   * @param     p_DRB_List
   * @param     p_ConfigSRB2
   * @return    template (value) CellGroupConfig
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetCellgroupConfig_DRB(NR_CellId_Type             p_NR_CellId,
                                       NR_DRB_IdentityList_Type   p_DRB_List,
                                       boolean                    p_ConfigSRB2)  runs on NR_BASE_PTC return template (value) CellGroupConfig
  {
    var template (value) NR_RLC_BearerToAddModList_Type v_NR_RLC_BearerToAddModList;
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (value) UL_AM_RLC v_ParametersTX := f_NR_UL_AM_RLC(v_IsFR1);
    var template (value) DL_AM_RLC v_ParametersRX := f_NR_DL_AM_RLC(v_IsFR1);
    var integer i;
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_NR_CellId); //@sic R5s201387 sic@
    var template (omit) integer v_ChAccPriority := f_NR_SharedAccessChAccPriority(p_NR_CellId); //SharedAccess @sic R5-243536 sic@
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
      
    for (i:=0; i<lengthof(p_DRB_List); i:=i+1){
      v_NR_RLC_BearerToAddModList[i] := cs_38508_RLC_BearerConfig_DRB(p_DRB_List[i],
                                                                      cs_38508_RLC_Config_AM_DRB (v_ParametersTX,v_ParametersRX),
                                                                      cs_38508_LogicalChannelConfig_DRB(-,-,-,-,-,v_ChAccPriority), //SharedAccess: @sic R5-243536 sic@
                                                                      -,
                                                                      v_RLC_Config_v1700);
    }
    if (p_ConfigSRB2) {
      v_NR_RLC_BearerToAddModList[i] := cs_38508_RLC_BearerConfig_SRB(tsc_SRB2, -, v_ChAccPriority, -, v_RLC_Config_v1700); //@sic R5-190360, R5-243536 sic@
    }
    return cs_38508_CellGroupConfig(v_CellGroupId, v_NR_RLC_BearerToAddModList); //@sic R5-190261 sic@
  }

  /*
   * @desc      To be used to re-configure DRB(n,m) AM, UM bearers (mainly for L2 tests)
   *            (also allows SRBs to be configured)
   *            PLEASE NOTE: If ANY of the RRC contents is specified, then the SS MUST BE specified too
   *            PLEASE NOTE: function specific to ENDC - tsc_NR_DRB2 is reconfigured
   * @param     p_NR_CellId
   * @param     p_NoOfNR_AMBearersN
   * @param     p_NoOfNR_UMBearersM
   * @param     p_SS_Drb_ConfigList (default value: omit)
   * @param     p_RLC_BearerConfigList (default value: omit)
   * @param     p_SRB_ToAddModList  (default value: omit)
   * @param     p_DRB_ToAddModList  (default value: omit)
   * @param     p_SecurityConfig    (default value: omit)
   * @param     p_MAC_CellGroupConfig (default value: omit)
   * @param     p_RRC_State         (default value: RRC_IDLE)
   * @param     p_NrofHARQ_ProcessesForPDSCH (default value: omit)
   * @param     p_ReconfigRLConly   (default value: false)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ENDC_ReConfigAM_UM(NR_CellId_Type p_NR_CellId,
                                   integer p_NoOfNR_AMBearersN,
                                   integer p_NoOfNR_UMBearersM,
                                   template (omit) NR_RadioBearerList_Type p_SS_Drb_ConfigList := omit,
                                   template (omit) NR_RLC_BearerToAddModList_Type p_RLC_BearerConfigList := omit,
                                   template (omit) SRB_ToAddModList p_SRB_ToAddModList := omit,
                                   template (omit) DRB_ToAddModList p_DRB_ToAddModList := omit,
                                   template (omit) SecurityConfig p_SecurityConfig := omit,
                                   template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig := omit,
                                   NR_RRC_STATE_Type p_RRC_State := RRC_IDLE,
                                   template (omit) PDSCH_ServingCellConfig.nrofHARQ_ProcessesForPDSCH  p_NrofHARQ_ProcessesForPDSCH := omit,
                                   boolean p_ReconfigRLConly := false // @sic R5s201514, R5-205671 sic@
                                   ) runs on NR_BASE_PTC // @sic R5s201010 sic@
  {
    // @sic R5-203533: added p_NrofHARQ_ProcessesForPDSCH sic@
    var DRB_Identity v_DrbId := tsc_NR_DRB2;    // for ENDC only
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) DRB_ToAddModList v_DRB_ToAddModList;
    var template (value) SecurityConfig v_SecurityConfig;
    var template (value) NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) RLC_Config v_RLC_Config;
    var EUTRA_NR_Coordination_MSG v_Coordination_MSG_Value;
    var integer i;
    var boolean v_IsFR1:= f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (omit) PDCP_Config.drb.statusReportRequired v_StatusReportRequired := true_;
    var ReconfigurationWithSyncAvailable_Type v_WaitForRachPreamble := reconfigurationWithSync_CheckRACH;   //@sic R5s210030 sic@
    var template (omit) NR_PDCP_T_Reordering_Type v_T_Reordering := omit;   //@sic R5-213445 sic@
    var template (omit) integer v_ChAccPriority := f_NR_SharedAccessChAccPriority(p_NR_CellId); //SharedAccess @sic R5-243536 sic@
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
      
    for (i:=0; i < p_NoOfNR_AMBearersN + p_NoOfNR_UMBearersM; i:=i+1) {
      if (i < p_NoOfNR_AMBearersN) {
        v_SS_Drb_ConfigList[i] := f_NR_GetRadioBearerConfig_FullAM(p_NR_CellId, v_DrbId);
        v_RLC_Config := cs_38508_RLC_Config_AM_DRB(f_NR_UL_AM_RLC(v_IsFR1), f_NR_DL_AM_RLC(v_IsFR1));
        v_T_Reordering := omit;        //as per 38.508-1 Table 4.6.3-99: PDCP-Config
      } else {   //UM
        v_SS_Drb_ConfigList[i] := f_NR_GetRadioBearerConfig_FullUM(p_NR_CellId, v_DrbId); //ENDC function: Sdap=omit
        v_RLC_Config := cs_38508_RLC_Config_UM_DRB(f_NR_UL_UM_RLC(), f_NR_DL_UM_RLC(v_IsFR1));
        v_StatusReportRequired := omit;
        v_T_Reordering := ms80;       //as per 38.508-1 Table 4.6.3-99: PDCP-Config
      }
      v_RLC_BearerConfigList[i] := cs_38508_RLC_BearerConfig_DRB(v_DrbId, v_RLC_Config, cs_38508_LogicalChannelConfig_DRB(-,-,-,-,-,v_ChAccPriority), -, v_RLC_Config_v1700); //SharedAccess: @sic R5-243536 sic@
      v_DRB_ToAddModList[i] := cs_38508_DRB_ToAddMod(v_DrbId, cs_38508_PDCP_Config ( -, v_T_Reordering, v_StatusReportRequired)); // @sic R5s200696, R5s200998 sic@
      v_DrbId := v_DrbId + 1;
    }
    
    v_SecurityConfig := cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig (f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), secondary);

    if (isvalue(p_SS_Drb_ConfigList)) {
      v_SS_Drb_ConfigList := valueof(p_SS_Drb_ConfigList);
    }
    if (isvalue(p_RLC_BearerConfigList)) {
      v_RLC_BearerConfigList := valueof(p_RLC_BearerConfigList);
    }
    if (isvalue(p_DRB_ToAddModList)) {
      v_DRB_ToAddModList := valueof(p_DRB_ToAddModList);
    }
    if (isvalue(p_SecurityConfig)) {
      v_SecurityConfig := valueof(p_SecurityConfig);
    }

    f_NR_SS_CommonRadioBearerConfig(p_NR_CellId, v_SS_Drb_ConfigList);
    v_RadioBearerConfig := cs_38508_RadioBearerConfigDef(p_SRB_ToAddModList, v_DRB_ToAddModList, -, v_SecurityConfig);
    v_SCGConfig := f_NR_GetSCGConfigDef(p_NR_CellId);
    if (p_ReconfigRLConly == false) {
      if (isvalue(p_MAC_CellGroupConfig)) {
        v_SCGConfig.mac_CellGroupConfig := p_MAC_CellGroupConfig;
        f_NR_SS_ServingCellConfig(p_NR_CellId, cs_TimingInfo_Now, cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfig(omit, omit, p_MAC_CellGroupConfig, omit)));
      }
      if (isvalue(p_NrofHARQ_ProcessesForPDSCH)) {
        v_SCGConfig.spCellConfig.spCellConfigDedicated.pdsch_ServingCellConfig := cs_NR_Pdsch_ServingCellConfigSetup(cs_NR_PDSCH_ServingCellConfigDef(-, -, p_NrofHARQ_ProcessesForPDSCH));
        f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_PDSCH_Config_REQ(p_NR_CellId, cs_TimingInfo_Now, cs_NR_PDSCH_CellLevelConfigDef(v_SCGConfig.spCellConfig.spCellConfigDedicated.pdsch_ServingCellConfig.setup))); //compiler warning may be ignored due to check
      }
    } else {
      v_SCGConfig.mac_CellGroupConfig :=  omit;
      v_SCGConfig.physicalCellGroupConfig := omit;
      v_SCGConfig.spCellConfig := omit;
      v_WaitForRachPreamble := noRACH_Check;  //@sic R5s210030 sic@
    }
    v_SCGConfig.rlc_BearerToAddModList := v_RLC_BearerConfigList;
    f_NR_SendRRCReconfigurationContentsToEUTRA(v_RadioBearerConfig, v_SCGConfig, -, -, false, v_WaitForRachPreamble );  //@sic R5s190541, R5s200647, R5s210030 sic@

    // Get Security info from EUTRA, calculate latest keys and configure SS
    // as only need to do this for the first reconfiguration @sic R5s200647, R5s201010 sic@
    if (p_RRC_State != RRC_CONNECTED)
    {
      f_ENDC_GetKeysActivateSecurity(p_NR_CellId, EUTRA);
    }

    //RRCReconfigurationComplete not yet received from E-UTRA - Wait for it @sic R5s200647 sic@
    EUTRA.receive(cmr_EUTRA_NR_OctetData ("Complete")) -> value v_Coordination_MSG_Value;
    f_NR_CheckReceived_RRCReconfigurationComplete(v_Coordination_MSG_Value);
  }

  /*
   * @desc      To get the keys from EUTRA and enable NR security
   * @param     p_NR_CellId
   * @param     p_Port
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_ENDC_GetKeysActivateSecurity(NR_CellId_Type p_NR_CellId,
                                          EUTRA_NR_CO_ORD_PORT p_Port) runs on NR_BASE_PTC
  {
    var EUTRA_NR_CoOrd_Security_Type v_SecurityRx;
    var NR_SecurityParams_Type v_SecurityParams;
    
    v_SecurityParams := f_NR_Security_Get ();
    // get security from EUTRA
    v_SecurityRx := f_EUTRA_NR_WaitForCoOrd_Security (p_Port);
    v_SecurityParams.SK_Counter := v_SecurityRx.SK_Counter;
    v_SecurityParams.S_KGNB := v_SecurityRx.Key; // @sic R5-194818 sic@
    
    // get latest security keys
    v_SecurityParams := f_NR_InitAS_KeyChaining_SKgNB (v_SecurityParams);
    // Ensure all keys used in ENDC are up to date @sic R5s201554 sic@
    v_SecurityParams.AS_Ciphering.KRRCenc := v_SecurityParams.AS_Ciphering_S.KRRCenc;
    v_SecurityParams.AS_Ciphering.KUPenc := v_SecurityParams.AS_Ciphering_S.KUPenc;
    v_SecurityParams.AS_Integrity.KRRCint := v_SecurityParams.AS_Integrity_S.KRRCint;
    f_NR_Security_Set(v_SecurityParams);
    
    // Configure PDCP security
    v_SecurityParams.AS_Ciphering.ActTimeList := f_NR_RRC_CipherActTime_GetCurrent(p_NR_CellId, false);  // @sic R5s190414, R5s210277 sic@
    f_NR_SS_RRC_EnableIntProt_CiphULandDL(p_NR_CellId,
                                          v_SecurityParams.AS_Integrity,
                                          v_SecurityParams.AS_Ciphering);
  }

  /*
   * @desc      Send RadioBearerConfig and SCGConfig to EUTRA PTC to encode into RRC Configuration Reconfiguration message
   *            and check Reconfiguration Complete sent back
   * @param     p_RadioBearerConfig
   * @param     p_SCGConfig
   * @param     p_MeasConfig        (default value: omit)
   * @param     p_RadioBearerConfig2 (default value: omit)
   * @param     p_WaitForRRCReconfigurationComplete (default value: true)
   * @param     p_WaitForRachPreamble (default value: noRACH_Check)
   * @param     p_TargetCellId      (default value: nr_Cell1)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_SendRRCReconfigurationContentsToEUTRA(template (omit) RadioBearerConfig p_RadioBearerConfig,
                                                      template (omit) CellGroupConfig p_SCGConfig,
                                                      template (omit) MeasConfig p_MeasConfig := omit,
                                                      template (omit) RadioBearerConfig p_RadioBearerConfig2 := omit,
                                                      boolean p_WaitForRRCReconfigurationComplete := true,
                                                      ReconfigurationWithSyncAvailable_Type p_WaitForRachPreamble := noRACH_Check,
                                                      NR_CellId_Type p_TargetCellId := nr_Cell1
                                                      ) runs on NR_BASE_PTC
  {
    //@sic R5-195240: added p_WaitForRRCReconfigurationComplete sic@
    //@sic R5s19541: added p_WaitForRachPreamble initial RACH sic@
    //@sic R5s200063 change 5: added p_TargetCellId sic@
    var template (omit) octetstring v_EncodedSCG_Config := omit;
    var template (value) RRCReconfiguration v_Reconfiguration;
    var octetstring v_EncodedRRCReconfig;
    var octetstring v_EncodedRB_Config;
    var boolean v_SendReconfigurationMsg := false;
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    
    //Enable RACH Preamble Indication
    if (p_WaitForRachPreamble == reconfigurationWithSync_CheckRACH) {
       f_NR_SS_SystemIndCtrlConfig(p_TargetCellId, cds_NR_SystemIndCtrl_RachPreamble(enable));
    }
    
    // RRC Reconfiguration only sent if either SCG Config or Meas Config included
    if (isvalue (p_SCGConfig) or isvalue (p_MeasConfig)) {
      v_SendReconfigurationMsg := true;
      if (isvalue (p_SCGConfig)) {
        v_EncodedSCG_Config := bit2oct(encvalue(p_SCGConfig));
      }
      v_Reconfiguration := cs_38508_RRCReconfigurationIE (tsc_NR_RRC_TI_Def, omit, v_EncodedSCG_Config, p_MeasConfig);
      v_EncodedRRCReconfig := bit2oct(encvalue(v_Reconfiguration));
      f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (v_EncodedRRCReconfig, "Reconfig"));
    }
    if (isvalue (p_RadioBearerConfig)) { // @sic R5s190115 sic@
      v_EncodedRB_Config := bit2oct(encvalue(p_RadioBearerConfig));
      f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (v_EncodedRB_Config, "RB"));
    }
    if (isvalue (p_RadioBearerConfig2)) {
      v_EncodedRB_Config := bit2oct(encvalue(p_RadioBearerConfig2));
      f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (v_EncodedRB_Config, "RB2")); // @sic R5s190062 sic@
    }
    
    // Wait for RACH Preamble Indication
    // NOTE: EUTRA-port is not handled by the default behaviour, so we can wait for NR_PRACH_Preamble_IND before looking at the EUTRA-port.
    if (p_WaitForRachPreamble == reconfigurationWithSync_CheckRACH) {
      SYSIND.receive(car_NR_PRACH_Preamble_IND(?, cr_TimingInfo_Any, ?));
      f_NR_SS_SystemIndCtrlConfig(p_TargetCellId, cds_NR_SystemIndCtrl_RachPreamble(disable));
    }
    
    // (Wait for and) handle coordination message:
    if (v_SendReconfigurationMsg and p_WaitForRRCReconfigurationComplete) {
      EUTRA.receive(cmr_EUTRA_NR_OctetData( "Complete")) -> value v_ReceivedMsg;
      // If we sent the reconfiguration message, then we need to check the complete sent back
      f_NR_CheckReceived_RRCReconfigurationComplete(v_ReceivedMsg);
    }

  }

  /*
   * @desc      Check the content of the received RRCReconfigurationComplete received from E-UTRA PTC
   * @param     p_EUTRA_NR_Coordination_MSG
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_CheckReceived_RRCReconfigurationComplete(EUTRA_NR_Coordination_MSG p_EUTRA_NR_Coordination_MSG)
  { //@sic R5s200126 sic@
    var RRCReconfigurationComplete v_Complete;
    var bitstring v_EncodedComplete;
    var octetstring v_OctetData;
    var integer v_Result;
    
      // If we sent the reconfiguration message, then we need to check the complete sent back
      v_OctetData := p_EUTRA_NR_Coordination_MSG.OctetData.Data;
      v_EncodedComplete := oct2bit(v_OctetData);
      v_Result := decvalue(v_EncodedComplete, v_Complete);
      if (v_Result != 0 or not match (v_Complete, cr_38508_RRCReconfigurationCompleteIE)) {
        FatalError(__FILE__, __LINE__, "Decoding error");
      }
  }

  /*
   * @desc      Send RRC Reconfiguration message with an optional piggybacked NAS message
   *            and receive RRC Reconfiguration Complete
   * @param     p_NR_CellId
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @param     p_RadioBearerConfig (default value: omit)
   * @param     p_V1530Ext          (default value: omit)
   * @param     p_NASMsg            (default value: omit)
   * @param     p_MeasConfig        (default value: omit)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ReceiveForRRCreconfigurationComplete (default value: true)
   * @param     p_NR_RoutingInfoSUL (default value: omit)
   * @param     p_MacBearerRoutingCA (default value: omit)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SendRRCReconfiguration(NR_CellId_Type p_NR_CellId,
                                       NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1,
                                       template (omit) RadioBearerConfig p_RadioBearerConfig := omit,
                                       template (omit) RRCReconfiguration_v1530_IEs p_V1530Ext := omit,
                                       template (omit) NG_NAS_MSG_RequestList_Type p_NASMsg := omit,
                                       template (omit) MeasConfig p_MeasConfig := omit,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                       boolean p_ReceiveForRRCreconfigurationComplete := true,
                                       template (omit) NR_RoutingInfoSUL_Type p_NR_RoutingInfoSUL := omit,
                                       template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                       )runs on NR_BASE_PTC
  { // @sic R5-213516: added p_MacBearerRoutingCA sic@
    var SubFrameTiming_Type v_Timing; // @sic R5-197256 sic@
    var template (value) NR_RRC_MSG_Request_Type v_RrcMsg := cs_NR_RRC_MSG_Request_DCCH(cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, p_RadioBearerConfig, -, p_MeasConfig, p_V1530Ext));

    if (isvalue(p_MeasConfig.measGapConfig)) { // @sic R5-197256 sic@
      //If MeasGap is to be configured send RRCReconfiguration with activation time and 5ms later configure the MeasGap in the SS
      v_Timing := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
      SRB.send(cas_NR_RrcNasPduList_REQ(p_NR_CellId, p_SRB, cs_TimingInfo_NR(v_Timing), v_RrcMsg, p_NASMsg, -, p_MacBearerRoutingCA, cs_RlcBearerRouting_NR(p_NR_CellId)));
      
      v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, 5);   // add 5ms
      f_NR_SS_MeasGapCtrlConfig(p_NR_CellId, cs_NR_MeasGapCtrl_Config(p_MeasConfig.measGapConfig), cs_TimingInfo_NR(v_Timing)); //compiler warning may be ignored due to isvalue check
    }
    else {
      SRB.send(cas_NR_RrcNasPduList_REQ(p_NR_CellId, p_SRB, p_TimingInfo, v_RrcMsg, p_NASMsg, -, p_MacBearerRoutingCA, cs_RlcBearerRouting_NR(p_NR_CellId)));
    }

    if (p_ReceiveForRRCreconfigurationComplete){
        SRB.receive(car_NR_SRB_RrcPdu_IND(p_NR_CellId, p_SRB, cr_38508_RRCReconfigurationComplete, p_NR_RoutingInfoSUL, p_MacBearerRoutingCA)); //@sic R5s190109 change 10 sic@
    }
  }

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_SduTX
   * @param     p_DRB_DL
   * @param     p_DRB_UL
   * @param     p_StepNo            (default value: "")
   * @param     p_CheckPING         (default value: true)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_CheckDataPathCommon(octetstring p_SduTX,
                                    template (value) NR_DRB_COMMON_REQ p_DRB_DL,
                                    template (present) NR_DRB_COMMON_IND p_DRB_UL,
                                    charstring p_StepNo := "",
                                    boolean p_CheckPING := true) runs on NR_BASE_PTC
  { /* implementation as according to @sic Rs190936 sic@ */
   var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
   var octetstring v_SduRX;
   var boolean v_UsePING := p_CheckPING and pc_IP_Ping; // @sic R5-206332 only use PING if required by test case sic@
   
   if (v_UsePING) { f_IP_Routing_ChangeToRawmode(IP); }   /* @sic R5s200044 change 4 sic@ */

   DRB.send(p_DRB_DL);
   DRB.receive(p_DRB_UL) -> value v_NR_DRB_COMMON_IND;

   if (v_UsePING) { f_IP_Routing_RestoreRoutingTable(IP); }   /* @sic R5s200044 change 4 sic@ */

   if (f_NR_Config_Get() == EN_DC) {
     v_SduRX := v_NR_DRB_COMMON_IND.U_Plane.SlotData.PduSduList.PdcpSdu[0];
   } else {
     v_SduRX := v_NR_DRB_COMMON_IND.U_Plane.SlotData.PduSduList.SdapSdu[0];
   }

   if (not f_LoopbackModeBorPing_CheckDataRX(p_SduTX, v_SduRX, v_UsePING)) {
     f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid Echo Reply");
   } else {
     f_NR_PreliminaryPass(__FILE__, __LINE__, p_StepNo);
   }
 }

  /*
   * @desc      Check that no uplink message is received within certain time
   * @param     p_Timer
   * @param     p_NR_SRB_COMMON_IND (default value: ?)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_Check_NoUplinkMessage(float p_Timer,
                                      template (present) NR_SRB_COMMON_IND p_NR_SRB_COMMON_IND := ?) runs on NR_BASE_PTC
  {
    timer t_Wait;
    t_Wait.start(p_Timer);
    alt {
      [] t_Wait.timeout
        {
        }
      [] SRB.receive(p_NR_SRB_COMMON_IND)
        {
            t_Wait.stop;
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Check failed: Uplink message received within a certain time");
        }
    }
  };

  /*
   * @desc      Check that No RRCSetupRequest is received during p_TimerValue
   *            when a running timer is handed over, this is used as watchdog.
   * @param     p_NR_CellId
   * @param     p_TimerValue
   * @param     p_EstablishmentCause (default value: cr_NR_EstablishmentCause_Any)
   * @param     p_VerdictMsg        (default value: "Unexpected RRCSetupREQ before timer expiry")
   * @return    boolean
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CheckNoRRCSetupReq(NR_CellId_Type p_NR_CellId,
                                   float p_TimerValue,
                                   template  EstablishmentCause p_EstablishmentCause := cr_NR_EstablishmentCause_Any,
                                   template (omit) charstring p_VerdictMsg := "Unexpected RRCSetupREQ before timer expiry" ) runs on NR_BASE_PTC return boolean
  {  //@sic R5s2013887: added p_VerdictMsg sic@
      var boolean v_Result;
      timer t_Wait;
      t_Wait.start(p_TimerValue);
      alt {
          [] SRB.receive(car_NR_SRB0_RrcPdu_IND(p_NR_CellId, cr_38508_RRCSetupRequest(p_EstablishmentCause, ?)))
            {
              t_Wait.stop;
              if (isvalue(p_VerdictMsg)) {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, valueof(p_VerdictMsg));
              }
              v_Result := false;
            }
          [] t_Wait.timeout
            {
                v_Result:= true;
            }
        }
        return v_Result;
  }

  /*
   * @desc      Performs calculation of Q_OffsetRange with an applied Delta as per 38.508-1 Table 4.6.2-3: SIB4
   * @param     p_Q_OffsetRange     (default value: 0)
   * @param     p_DeltaNRfs
   * @param     p_DeltaNRfn
   * @return    Q_OffsetRange
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_CalculateQ_OffsetRangeWithDelta ( integer p_Q_OffsetRange := 0,
                                                integer p_DeltaNRfs,
                                                integer p_DeltaNRfn) return Q_OffsetRange
  { //Q-OffsetRange 0dB + Delta(NRfn) Delta(NRfs)
    //@sic R5-198851 sic@
    var integer v_IntegerValue := p_Q_OffsetRange + p_DeltaNRfn - p_DeltaNRfs;
    
    if ( v_IntegerValue >= 5 or v_IntegerValue <= -5) {
        v_IntegerValue := ((v_IntegerValue/2)*2);
    }
    return f_ConvertQ_OffsetRange( v_IntegerValue );
  }

  /*
   * @desc      Convert Q_OffsetRange from integer to Q-OffsetRange type
   * @param     p_IntegerValue
   * @return    Q_OffsetRange
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_ConvertQ_OffsetRange ( integer p_IntegerValue) return Q_OffsetRange
  {
    var Q_OffsetRange v_Q_OffsetRange;
    select(p_IntegerValue){
        case(-24) { v_Q_OffsetRange := dB_24;}
        case(-22) { v_Q_OffsetRange := dB_22;}
        case(-20) { v_Q_OffsetRange := dB_20;}
        case(-18) { v_Q_OffsetRange := dB_18;}
        case(-16) { v_Q_OffsetRange := dB_16;}
        case(-14) { v_Q_OffsetRange := dB_14;}
        case(-12) { v_Q_OffsetRange := dB_12;}
        case(-10) { v_Q_OffsetRange := dB_10;}
        case(-8) { v_Q_OffsetRange := dB_8;}
        case(-6) { v_Q_OffsetRange := dB_6;}
        case(-5) { v_Q_OffsetRange := dB_5;}
        case(-4) { v_Q_OffsetRange := dB_4;}
        case(-3) { v_Q_OffsetRange := dB_3;}
        case(-2) { v_Q_OffsetRange := dB_2;}
        case(-1) { v_Q_OffsetRange := dB_1;}
        case(0) { v_Q_OffsetRange := dB0;}
        case(1) { v_Q_OffsetRange := dB1;}
        case(2) { v_Q_OffsetRange := dB2;}
        case(3) { v_Q_OffsetRange := dB3;}
        case(4) { v_Q_OffsetRange := dB4;}
        case(5) { v_Q_OffsetRange := dB5;}
        case(6) { v_Q_OffsetRange := dB6;}
        case(8) { v_Q_OffsetRange := dB8;}
        case(10) { v_Q_OffsetRange := dB10;}
        case(12) { v_Q_OffsetRange := dB12;}
        case(14) { v_Q_OffsetRange := dB14;}
        case(16) { v_Q_OffsetRange := dB16;}
        case(18) { v_Q_OffsetRange := dB18;}
        case(20) { v_Q_OffsetRange := dB20;}
        case(22) { v_Q_OffsetRange := dB22;}
        case(24) { v_Q_OffsetRange := dB24;}
        case else {FatalError(__FILE__, __LINE__, "Invalid Q_OffsetRange value");}
    }
    return v_Q_OffsetRange;
  }

  /*
   * @desc      Build the content of RRCReconfiguration_v1530_IEs with parameterised CellGroupConfig and RadioBearer2 - for NR-DC. Used only by L2 option 2 NR-DC
   * @param     p_CellGroupConfigSCG (default value: omit)
   * @param     p_CellGroupConfigMCG (default value: omit)
   * @param     p_RadioBearerConfig2 (default value: omit)
   * @param     p_MRDC_ReleaseAndAdd (default value: false)
   * @param     p_SK_Counter        (default value: omit)
   * @param     p_SCG_RRCReconfiguration_v1800_IEs (default value: omit)
   * @return    template
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NRDC_BuildRRCReconfiguration_v1530(template (omit) CellGroupConfig p_CellGroupConfigSCG := omit,
                                                 template (omit) CellGroupConfig p_CellGroupConfigMCG := omit,
                                                 template (omit) RadioBearerConfig p_RadioBearerConfig2 := omit,
                                                 boolean p_MRDC_ReleaseAndAdd := false,
                                                 template (omit) SK_Counter  p_SK_Counter := omit,
                                                 template (omit) RRCReconfiguration_v1800_IEs p_SCG_RRCReconfiguration_v1800_IEs := omit
                                                 ) return template (value) RRCReconfiguration_v1530_IEs
   {  //@sic R5-256671: added p_SCG_RRCReconfiguration_v1800_IEs for SCG sic@
        var template (value) RRCReconfiguration_v1560_IEs v_V1560Ext;
        var template (omit) RRCReconfiguration_v1560_IEs.mrdc_SecondaryCellGroupConfig v_MRDC_SecondaryCellGroupConfig := omit;
        var template (omit) octetstring v_RadioBearerConfig2 := omit;
        var template (omit) octetstring v_CellgroupConfigMCG := omit;
        var template (omit) RRCReconfiguration_v1530_IEs v_RRCReconfiguration_v1530 := omit;

        if (isvalue(p_SCG_RRCReconfiguration_v1800_IEs)) {
          v_RRCReconfiguration_v1530 := cs_NR_RRCReconfiguration_v1530_IEs(omit,-,-,-,-,cs_RRCReconfiguration_v1540_IEs(-,cs_RRCReconfiguration_v1560_IEs(-, -, -, cs_RRCReconfiguration_v1610_IEs(-, -, -, -, -,
                                                                                                                     cs_RRCReconfiguration_v1700_IEs_NonCritcExt(-, -, -,
                                                                                                                      p_SCG_RRCReconfiguration_v1800_IEs)))));
        }

        if (isvalue(p_CellGroupConfigSCG)) {
          v_MRDC_SecondaryCellGroupConfig := cs_MRDC_SecondaryCellGroupConfigSetup( -, bit2oct(encvalue(cs_38508_RRCReconfigurationIE(tsc_NR_RRC_TI_Def, omit,bit2oct(encvalue(p_CellGroupConfigSCG)),-,v_RRCReconfiguration_v1530))));
        } else if (p_MRDC_ReleaseAndAdd) {  //p_MRDC_ReleaseAndAdd can only be true if p_CellGroupConfigSCG is omitted
            v_MRDC_SecondaryCellGroupConfig := cs_MRDC_SecondaryCellGroupConfigRelease;
        }
        if (isvalue(p_RadioBearerConfig2)) {
            v_RadioBearerConfig2 := bit2oct(encvalue(p_RadioBearerConfig2));
        }
        if (isvalue(p_CellGroupConfigMCG)) {
            v_CellgroupConfigMCG := bit2oct(encvalue(p_CellGroupConfigMCG));
        }
        v_V1560Ext := cs_RRCReconfiguration_v1560_IEs (p_SK_Counter, v_MRDC_SecondaryCellGroupConfig, v_RadioBearerConfig2);
        return cs_NR_RRCReconfiguration_v1530_IEs(v_CellgroupConfigMCG, -, -, -, -, cs_RRCReconfiguration_v1540_IEs (- ,v_V1560Ext));
    }

  /*
   * @desc      Receive the time from EUTRA and align it with the NR cell timing offset
   *            Note: the returned time is not an activation time for UL/DL transmition -> will need to be calculated.
   * @param     p_NR_CellId
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ReceiveTimefromEUTRA (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var CellTimingInfo_Type v_CellTimingInfo := f_NR_CellInfo_GetCellTimingInfo(p_NR_CellId);
    var SubFrameTiming_Type v_ReceiveTimeAlignedToNoOffset;
    var integer v_SystemTimeUnits;
    
    v_ReceiveTimeAlignedToNoOffset := f_EUTRA_NR_WaitForCoOrd_Time(EUTRA);
    v_SystemTimeUnits := f_SystemTimeUnits_ConvertFromSubFrameTiming(v_ReceiveTimeAlignedToNoOffset) - f_SystemTimeUnits_ConvertFromCellTimingInfo(v_CellTimingInfo);
    return f_SystemTimeUnits_ConvertToSubFrameTiming(v_SystemTimeUnits, v_ReceiveTimeAlignedToNoOffset.Slot);
  }

  /*
   * @desc      Returns the supported Gaps set by PICS
   * @return    B22_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_DeriveSupportedGapsFromPics() return B22_Type
  {//@sic R5s200815 sic@
    var B22_Type v_SupportedGapPatterns   := f_ConvertBoolToBit(pc_gp2_nr) &
                                             f_ConvertBoolToBit(pc_gp3_nr) &
                                             f_ConvertBoolToBit(pc_gp4_nr) &
                                             f_ConvertBoolToBit(pc_gp5_nr) &
                                             f_ConvertBoolToBit(pc_gp6_nr) &
                                             f_ConvertBoolToBit(pc_gp7_nr) &
                                             f_ConvertBoolToBit(pc_gp8_nr) &
                                             f_ConvertBoolToBit(pc_gp9_nr) &
                                             f_ConvertBoolToBit(pc_gp10_nr) &
                                             f_ConvertBoolToBit(pc_gp11_nr) &
                                             f_ConvertBoolToBit(pc_gp12_nr) &
                                             f_ConvertBoolToBit(pc_gp13_nr) &
                                             f_ConvertBoolToBit(pc_gp14_nr) &
                                             f_ConvertBoolToBit(pc_gp15_nr) &
                                             f_ConvertBoolToBit(pc_gp16_nr) &
                                             f_ConvertBoolToBit(pc_gp17_nr) &
                                             f_ConvertBoolToBit(pc_gp18_nr) &
                                             f_ConvertBoolToBit(pc_gp19_nr) &
                                             f_ConvertBoolToBit(pc_gp20_nr) &
                                             f_ConvertBoolToBit(pc_gp21_nr) &
                                             f_ConvertBoolToBit(pc_gp22_nr) &
                                             f_ConvertBoolToBit(pc_gp23_nr) ;

    return v_SupportedGapPatterns;
  }

   /*
   * @desc      SharedSpectrum: Configures value of channelAccessPriority-r16 IE in LogicalChannelConfig
   * @param     p_NR_CellId
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_SharedAccessChAccPriority (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) integer
  {
    var template (omit) integer v_ChAccPriority := omit;
    
    if (f_NR_CellInfo_GetIsSharedSpectrum(p_NR_CellId)) {
      v_ChAccPriority := 3; // Acc. 38.508-1 Table 4.6.3-66 @sic R5-243536 sic@
    }
    return v_ChAccPriority;
  }

}
