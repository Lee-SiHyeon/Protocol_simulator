                                      ((ms230, ms235, ms240, ms245, ms250, ms300, ms350, ms400, ms450, ms500 */
  };

  template (value) DL_AM_RLC cs_RX_AM_RLC_SRB2_Def := cs_RX_AM_RLC_SRB1_Def;  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

