  /*
   * @desc      get information about the DRX configuration; this shall be the same configuration as configured at the SS
   * @param     p_CellId
   * @return    DrxCtrl_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
