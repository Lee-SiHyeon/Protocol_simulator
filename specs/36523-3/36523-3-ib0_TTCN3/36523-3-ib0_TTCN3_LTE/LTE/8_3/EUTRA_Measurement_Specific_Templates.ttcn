module EUTRA_Measurement_Specific_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_AuxiliaryFunctions all;
  import from EUTRA_Measurement_Templates all;
  import from EUTRA_RRC_Templates all;

  template (value) ReportProximityConfig_r9 cs_ReportProximityConfig_r9(template (omit) ReportProximityConfig_r9.proximityIndicationEUTRA_r9 p_ProximityIndicationEUTRA_r9 := enabled,
                                                                        template (omit) ReportProximityConfig_r9.proximityIndicationUTRA_r9 p_ProximityIndicationUTRA_r9 := omit) :=
  { /* @status    APPROVED (LTE) */
    proximityIndicationEUTRA_r9  := p_ProximityIndicationEUTRA_r9,
    proximityIndicationUTRA_r9   := p_ProximityIndicationUTRA_r9
  };

  template (value) RRCConnectionReconfiguration_v890_IEs cs_RRCConnectionReconfiguration_ReportProximityConfig_IEs(template (omit) ReportProximityConfig_r9.proximityIndicationEUTRA_r9 p_ProximityIndicationEUTRA_r9 := enabled,
                                                                                                                   template (omit) ReportProximityConfig_r9.proximityIndicationUTRA_r9 p_ProximityIndicationUTRA_r9 := omit) :=
  /* rel-9 extension acc. to 36.508 Table 4.6.1-8 with condition ReportProximityConfig */
  /* @status    APPROVED (LTE) */
    cs_RRCConnectionReconfiguration_v890_IEs(cs_RRCConnectionReconfiguration_v920_IEs(cs_OtherConfig_r9(cs_ReportProximityConfig_r9(p_ProximityIndicationEUTRA_r9, p_ProximityIndicationUTRA_r9))));

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_1_1_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9  p_EUTRA_DL_CarrierFreq, //@sic R5-171996 sic@
                                                                                 AllowedMeasBandwidth p_MeasurementBandwidth) :=
  /* @status    APPROVED (LTE) */
    cs_508_RRCConnectionReconfiguration_ConditionMEAS(p_RRC_TI,
                                                      cs_MeasConfig(omit,
                                                                    cs_MeasObjectToAddModList_1Entry(tsc_IdMeasObject_f1,
                                                                                                     cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq), p_MeasurementBandwidth)), //@sic R5-171996 sic@
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfig_A1,
                                                                                                       cs_ReportConfig_reportConfigEUTRA_eventA1_RSRP(-72,
                                                                                                                                                      6,
                                                                                                                                                      ms256,
                                                                                                                                                      rsrp,
                                                                                                                                                      both,
                                                                                                                                                      1,
                                                                                                                                                      ms1024,
                                                                                                                                                      infinity_)), //@sic R5-094520: Changed from r1 to infinity_ sic@
                                                                    
                                                                    omit,
                                                                    cs_MeasIdToAddModList_1Entry(1,
                                                                                                 tsc_IdMeasObject_f1,
                                                                                                 tsc_IdReportConfig_A1),
                                                                    -,-,-,-,-,
                                                                    f_ReturnMeasObjectToAddModList_v9e0(p_EUTRA_DL_CarrierFreq))); //@sic R5-171996 sic@

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_1_2_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9  p_EUTRA_DL_CarrierFreq, //@sic R5-171996 sic@
                                                                                 AllowedMeasBandwidth p_MeasurementBandwidth) :=
  /* @status    APPROVED (LTE) */
    cs_508_RRCConnectionReconfiguration_ConditionMEAS(p_RRC_TI,
                                                      cs_MeasConfig(omit,
                                                                    cs_MeasObjectToAddModList_1Entry(tsc_IdMeasObject_f1,
                                                                                                     cs_MeasObject_measObjectEUTRA_Common(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq), p_MeasurementBandwidth)), //@sic R5-171996 sic@
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfig_A2,
                                                                                                       cs_ReportConfig_reportConfigEUTRA_eventA2_RSRP(-83,
                                                                                                                                                      6,
                                                                                                                                                      ms320, //@sic R5s100176: Change 3: Change value of timeToTrigger parameter from 256ms to 320ms sic@
                                                                                                                                                      rsrp,
                                                                                                                                                      both,
                                                                                                                                                      1,
                                                                                                                                                      ms1024,
                                                                                                                                                      infinity_)), //@sic R5-095507: Changed from r1 to infinity_ sic@
                                                                    omit,
                                                                    cs_MeasIdToAddModList_1Entry(1,
                                                                                                 tsc_IdMeasObject_f1,
                                                                                                 tsc_IdReportConfig_A2),
                                                                    -,-,-,-,-,
                                                                    f_ReturnMeasObjectToAddModList_v9e0(p_EUTRA_DL_CarrierFreq))); //@sic R5-171996 sic@

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_1_3_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9  p_EUTRA_DL_CarrierFreq_1, //@sic R5-171996 sic@
