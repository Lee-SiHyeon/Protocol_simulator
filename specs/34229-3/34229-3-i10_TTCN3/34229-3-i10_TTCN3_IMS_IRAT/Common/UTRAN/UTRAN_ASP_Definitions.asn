--
-- CPHY-TrCH-Release-FDD-REQ
-- CPHY-TrCH-Release-TDD-REQ
--   To request to release tthe Radio Link
--
--**************************************************************

CPHY-TrCH-Release-FDD-REQ ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo,
