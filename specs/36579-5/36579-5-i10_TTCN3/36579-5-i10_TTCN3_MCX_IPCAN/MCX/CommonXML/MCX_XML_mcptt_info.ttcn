module MCX_XML_mcptt_info {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_Component all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttInfo_1_0 language "XSD" all;

  type Mcpttinfo_Type MCPTT_Info_Type;                                          /* @status    APPROVED (MCX) */

  type ContentType MCPTT_Info_Content_Type;                                     /* @status    APPROVED (MCX) */

  type AnyExtType MCPTT_Info_AnyExt_Type;                                       /* @status    APPROVED (MCX) */

  type ReleaseReasonType MCPTT_Info_ReleaseReason_Type;                         /* @status    APPROVED (MCX) */

  type AmbientListeningType MCPTT_Info_AmbientListening_Type;                   /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCPTT_Info_EncryptedElements := {               /* @status    APPROVED (MCX) */
    /* 24.379 F.1.3: <mcpttinfo><mcptt-Params> elements which may be ecrypted */
    "mcptt-access-token",
    "mcptt-request-uri",
    "mcptt-calling-user-id",
    "mcptt-called-party-id",
    "mcptt-calling-group-id",
    "emergency-ind",
    "alert-ind",
    "imminentperil-ind",
    "originated-by",
    "mcptt-client-id",
    "anyExt/functional-alias-URI",
    "anyExt/non-acknowledged-user"
  };

  type union McpttInfoExt_Element_Type {                                        /* @status    APPROVED (MCX) */
    AmbientListeningType AmbientListening,
    ReleaseReasonType ReleaseReason,
    RequestTypeType RequestType,
    ResponseTypeType ResponseType,
    Urgency_ind UrgencyInd,
    Time_of_request TimeOfRequest,
    SelectedGroupChangeOutcomeType SelectedGroupChangeOutcome,
    XSD.Boolean AffiliationRequired,
    RemotelyInitiatedCallOutcomeType RemotelyInitiatedCallOutcome,
    XSD.Boolean NotifyRemoteUser,
    ContentType FunctionalAliasURI
  };

  type record of McpttInfoExt_Element_Type McpttInfoExt_ElementList_Type;       /* @status    APPROVED (MCX) */

  template (value)   McpttInfoExt_Element_Type crs_McpttInfoExt_AmbientListening(AmbientListeningType p_AmbientListening) := { AmbientListening := p_AmbientListening };        /* @status    APPROVED (MCX) */

  template (value)   McpttInfoExt_Element_Type crs_McpttInfoExt_ReleaseReason(ReleaseReasonType p_ReleaseReason) := { ReleaseReason := p_ReleaseReason };                       /* @status    APPROVED (MCX) */

  template (value)   McpttInfoExt_Element_Type crs_McpttInfoExt_RequestType(RequestTypeType p_RequestType) := { RequestType := p_RequestType };                                 /* @status    APPROVED (MCX) */

  template (present) McpttInfoExt_Element_Type cr_McpttInfoExt_FunctionalAliasURI(XSD.AnyURI p_URI) := { FunctionalAliasURI := cr_MCPTT_Content_URI(p_URI) };                   /* @status    APPROVED (MCX) */

  /*
   * @desc      encode element for extension of mcptt-info
   * @param     p_McpttInfoExtElement
   * @return    universal charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_McpttInfoExt_EncodeElem(template (value) McpttInfoExt_Element_Type p_McpttInfoExtElement) return universal charstring
  {
    var McpttInfoExt_Element_Type v_McpttInfoExtElement := valueof(p_McpttInfoExtElement);
    var Ambient_listening_type v_Ambient_listening_type;
    var Release_reason v_Release_reason;
    var Request_type v_Request_type;
    var Response_type v_Response_type;
    var Urgency_ind v_Urgency_ind;
    var Time_of_request v_Time_of_request;
    var Selected_group_change_outcome v_Selected_group_change_outcome;
    var Affiliation_required v_Affiliation_required;
    var Remotely_initiated_call_outcome v_Remotely_initiated_call_outcome;
    var Notify_remote_user v_Notify_remote_user;
    var Functional_alias_URI v_Functional_alias_URI;
    var universal charstring v_Elem;
    
    select union (v_McpttInfoExtElement) {
      case (AmbientListening) {
        v_Ambient_listening_type := v_McpttInfoExtElement.AmbientListening;
        v_Elem := f_Bit2XsdString(encvalue(v_Ambient_listening_type));
      }
      case (ReleaseReason) {
        v_Release_reason := v_McpttInfoExtElement.ReleaseReason;
        v_Elem := f_Bit2XsdString(encvalue(v_Release_reason));
      }
      case (RequestType) {
        v_Request_type := v_McpttInfoExtElement.RequestType;
        v_Elem := f_Bit2XsdString(encvalue(v_Request_type));
      }
      case (ResponseType) {
        v_Response_type := v_McpttInfoExtElement.ResponseType;
        v_Elem := f_Bit2XsdString(encvalue(v_Response_type));
      }
      case (UrgencyInd) {
        v_Urgency_ind := v_McpttInfoExtElement.UrgencyInd;
        v_Elem := f_Bit2XsdString(encvalue(v_Urgency_ind));
      }
      case (TimeOfRequest) {
        v_Time_of_request := v_McpttInfoExtElement.TimeOfRequest;
        v_Elem := f_Bit2XsdString(encvalue(v_Time_of_request));
      }
      case (SelectedGroupChangeOutcome) {
        v_Selected_group_change_outcome := v_McpttInfoExtElement.SelectedGroupChangeOutcome;
        v_Elem := f_Bit2XsdString(encvalue(v_Selected_group_change_outcome));
      }
      case (AffiliationRequired) {
        v_Affiliation_required := v_McpttInfoExtElement.AffiliationRequired;
        v_Elem := f_Bit2XsdString(encvalue(v_Affiliation_required));
      }
      case (RemotelyInitiatedCallOutcome) {
        v_Remotely_initiated_call_outcome := v_McpttInfoExtElement.RemotelyInitiatedCallOutcome;
        v_Elem := f_Bit2XsdString(encvalue(v_Remotely_initiated_call_outcome));
      }
      case (NotifyRemoteUser) {
        v_Notify_remote_user := v_McpttInfoExtElement.NotifyRemoteUser;
        v_Elem := f_Bit2XsdString(encvalue(v_Notify_remote_user));
      }
      case (FunctionalAliasURI) {
        v_Functional_alias_URI := v_McpttInfoExtElement.FunctionalAliasURI;
        v_Elem := f_Bit2XsdString(encvalue(v_Functional_alias_URI));
      }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown extension");
      }
    }
    return v_Elem;
  }

  /*
   * @desc      encode xtension of mcptt-info
   * @param     p_McpttInfoExtElementList
   * @return    MCPTT_Info_AnyExt_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_McpttInfoExt_Encode(template (value) McpttInfoExt_ElementList_Type p_McpttInfoExtElementList) return MCPTT_Info_AnyExt_Type
  {
    var MCPTT_Info_AnyExt_Type v_AnyExt := {};
    var integer i;
    
    for (i := 0; i < lengthof(p_McpttInfoExtElementList); i := i + 1) {
      v_AnyExt.elem_list[i] := f_MCX_McpttInfoExt_EncodeElem(p_McpttInfoExtElementList[i]);
    }
    return v_AnyExt;
  }

  /*
   * @desc      decode extension of mcptt-info
   * @param     p_McpttInfoExt
   * @return    McpttInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_McpttInfoExt_Decode(template (omit) AnyExtType p_McpttInfoExt) runs on IMS_PTC return McpttInfoExt_ElementList_Type
  {
    // variables for decoding
    var Ambient_listening_type v_Ambient_listening_type;
    var Release_reason v_Release_reason;
    var Request_type v_Request_type;
    var Response_type v_Response_type;
    var Urgency_ind v_Urgency_ind;
    var Time_of_request v_Time_of_request;
    var Selected_group_change_outcome v_Selected_group_change_outcome;
    var Affiliation_required v_Affiliation_required;
    var Remotely_initiated_call_outcome v_Remotely_initiated_call_outcome;
    var Notify_remote_user v_Notify_remote_user;
    var Functional_alias_URI v_Functional_alias_URI;

    // other variables
    var AnyExtType v_McpttInfoExt;
    var McpttInfoExt_ElementList_Type v_McpttInfoExtElementList := {};
    var McpttInfoExt_Element_Type v_Element;
    var bitstring v_Bitstring;
    var integer i;

    if (isvalue(p_McpttInfoExt)) {
      v_McpttInfoExt := valueof(p_McpttInfoExt);
      for (i := 0; i < lengthof(v_McpttInfoExt.elem_list); i := i + 1) {
        v_Bitstring := f_Unichar2Bit(v_McpttInfoExt.elem_list[i]);
        
        if (decvalue(v_Bitstring, v_Ambient_listening_type) == 0) {
          v_Element.AmbientListening := v_Ambient_listening_type;
        }
        else if (decvalue(v_Bitstring, v_Release_reason) == 0) {
          v_Element.ReleaseReason := v_Release_reason;
        }
        else if (decvalue(v_Bitstring, v_Request_type) == 0) {
          v_Element.RequestType := v_Request_type;
        }
        else if (decvalue(v_Bitstring, v_Response_type) == 0) {
          v_Element.ResponseType := v_Response_type;
        }
        else if (decvalue(v_Bitstring, v_Urgency_ind) == 0) {
          v_Element.UrgencyInd := v_Urgency_ind;
        }
        else if (decvalue(v_Bitstring, v_Time_of_request) == 0) {
          v_Element.TimeOfRequest := v_Time_of_request;
        }
        else if (decvalue(v_Bitstring, v_Selected_group_change_outcome) == 0) {
          v_Element.SelectedGroupChangeOutcome := v_Selected_group_change_outcome;
        }
        else if (decvalue(v_Bitstring, v_Affiliation_required) == 0) {
          v_Element.AffiliationRequired := v_Affiliation_required;
        }
        else if (decvalue(v_Bitstring, v_Remotely_initiated_call_outcome) == 0) {
          v_Element.RemotelyInitiatedCallOutcome := v_Remotely_initiated_call_outcome;
        }
        else if (decvalue(v_Bitstring, v_Notify_remote_user) == 0) {
          v_Element.NotifyRemoteUser := v_Notify_remote_user;
        }
        else if (decvalue(v_Bitstring, v_Functional_alias_URI) == 0) {
          v_Element.FunctionalAliasURI := v_Functional_alias_URI;
        }
        else {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcpttinfo.mcptt-Params.anyExt: element[" & int2str(i) & "] cannot be decoded");
        }
        v_McpttInfoExtElementList := v_McpttInfoExtElementList & { v_Element };
      }
    }
    return v_McpttInfoExtElementList;
  }

  /*
   * @desc      Decode mcptt-Params extensions and raise verdict
   * @param     p_McpttInfo
   * @param     p_McpttInfoExtElementList
   * @return    McpttInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_McpttInfoExt_DecodeAndMatch(MCPTT_Info_Type p_McpttInfo,
                                             template McpttInfoExt_ElementList_Type p_McpttInfoExtElementList) runs on IMS_PTC return McpttInfoExt_ElementList_Type
  {
    var McpttInfoExt_ElementList_Type v_McpttInfoExtElementList := fl_MCX_McpttInfoExt_Decode(p_McpttInfo.mcptt_Params.anyExt); // even in case of anyExt==omit fl_MCX_McpttInfoExt_Decode returns an (empty) list
    var template (present) McpttInfoExt_ElementList_Type v_ExpectedElementList := {};                                           // @sic R5-233849: {} instead of ? sic@
    
    if (ispresent(p_McpttInfoExtElementList)) {
      v_ExpectedElementList := { permutation(all from p_McpttInfoExtElementList) };
    }
    if (not match(v_McpttInfoExtElementList, v_ExpectedElementList)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcpttinfo.mcptt-Params.anyExt does not match");
    }
    return v_McpttInfoExtElementList;
  }

  template (value) ContentType.choice cs_MCPTT_Info_Content_Choice_Boolean(XSD.Boolean p_Boolean) := { mcpttBoolean := p_Boolean };                             /* @status    APPROVED (MCX) */

  template (value) ContentType.choice cs_MCPTT_Info_Content_Choice_URI(XSD.AnyURI p_URI) := { mcpttURI := p_URI };                                              /* @status    APPROVED (MCX) */

  /*
   * @desc      Wrapper funnction to set ProtectionType depending on tsc_MCX_XML_ConfidentialityProtection
   * @return    ProtectionType
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_Info_ProtectionTypeTX() return ProtectionType
  {
    var ProtectionType v_ProtectionType := normal;
    if (tsc_MCX_XML_ConfidentialityProtection) {
      v_ProtectionType := encrypted;
    }
    return v_ProtectionType;
  }

  template (value) ContentType cs_MCPTT_Content(template (value) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := fl_MCPTT_Info_ProtectionTypeTX(),
    attr := omit,
    choice := p_Choice
  };

  template (value) ContentType cs_MCPTT_Content_Boolean(XSD.Boolean p_Boolean) := cs_MCPTT_Content(cs_MCPTT_Info_Content_Choice_Boolean(p_Boolean));            /* @status    APPROVED (MCX) */

  /*
   * @desc      return ContentType element with URI
   * @param     p_URI
   * @return    template (omit) ContentType
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Content_URI(template (omit) XSD.AnyURI p_URI) return template (omit) ContentType
  {
    if (isvalue(p_URI)) {
      return cs_MCPTT_Content(cs_MCPTT_Info_Content_Choice_URI(valueof(p_URI)));
    }
    return omit;
  }

  template (value) ContentType cs_MCPTT_Content_True := cs_MCPTT_Content_Boolean(true);      /* @status    APPROVED (MCX) */

  template (value) ContentType cs_MCPTT_Content_False := cs_MCPTT_Content_Boolean(false);    /* @status    APPROVED (MCX) */

  template (value) Mcpttinfo_Type cs_MCPTT_Info_Base(template (omit) charstring p_McpttRequestURI := px_MCPTT_ID_User_A,
                                                     template (omit) charstring p_McpttCallingUserId := px_MCPTT_ID_User_B) :=
  { /* MCPTT info according to 36.579-1 Table 5.5.3.2.2-1 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcptt_Params := {
      attr := omit,
      mcptt_access_token     := omit,
      session_type           := omit,
      mcptt_request_uri      := f_MCPTT_Content_URI(p_McpttRequestURI),
      mcptt_calling_user_id  := f_MCPTT_Content_URI(p_McpttCallingUserId),
      mcptt_called_party_id  := omit,
      mcptt_calling_group_id := omit,
      required               := omit,
      emergency_ind          := omit,
      alert_ind              := omit,
      imminentperil_ind      := omit,
      broadcast_ind          := omit,
      mc_org                 := omit,
      floor_state            := omit,
      associated_group_id    := omit,
      originated_by          := omit,
      mKFC_GKTPs             := omit,
      mcptt_client_id        := omit,
      alert_ind_rcvd         := omit,
      gw_mcptt_usage         := omit,                           // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list              := {},
      anyExt                 := omit
    },
    elem_list := {},
    anyExt := omit
  };

  /*
   * @desc      Table 5.5.3.2.2-1: MCPTT-Info from the SS with conditions GROUP-CALL or PRIVATE-CALL
   * @param     p_CallType          (default value: ANY)
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_McpttRequestURI   (default value: px_MCPTT_ID_User_A)
   * @param     p_McpttCallingUserId (default value: px_MCPTT_ID_User_B)
   * @return    template (value) MCPTT_Info_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CallControl_MCPTTInfo_TX(MCX_CallType_Type p_CallType := ANY,
                                          MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                          template (omit) charstring p_McpttRequestURI := px_MCPTT_ID_User_A,
                                          template (omit) charstring p_McpttCallingUserId := px_MCPTT_ID_User_B) return template (value) MCPTT_Info_Type
  { // p_CallType := ANY => per default there is no session-type

    var template (value) MCPTT_Info_Type v_McpttInfo := cs_MCPTT_Info_Base(p_McpttRequestURI, p_McpttCallingUserId);

    v_McpttInfo.mcptt_Params.session_type := f_MCX_MCServiceInfo_SessionType(p_CallType);

    select (p_CallType) {
      case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
        v_McpttInfo.mcptt_Params.mcptt_calling_group_id := f_MCPTT_Content_URI(px_MCPTT_Group_A_ID);
      }
    }
    select (p_PriorityCallType) {
      case (EMERGENCY_CALL) {
        v_McpttInfo.mcptt_Params.emergency_ind := cs_MCPTT_Content_True;
        v_McpttInfo.mcptt_Params.alert_ind := cs_MCPTT_Content_False;           // @sic R5-213654: false sic@
      }
      case (IMMPERIL_CALL) {
        v_McpttInfo.mcptt_Params.imminentperil_ind := cs_MCPTT_Content_True;
      }
      case (BROADCAST) {
        v_McpttInfo.mcptt_Params.broadcast_ind := true;        // @sic R5-206448 sic@
      }
    }
    return v_McpttInfo;
  }

  template (present) ContentType.choice cr_MCPTT_Info_Content_Choice_Boolean(template (present) XSD.Boolean p_Boolean) := { mcpttBoolean := p_Boolean };                        /* @status    APPROVED (MCX) */

  template (present) ContentType.choice cr_MCPTT_Info_Content_Choice_String(template (present) XSD.String p_String) := { mcpttString := p_String };                             /* @status    APPROVED (MCX) */

  template (present) ContentType.choice cr_MCPTT_Info_Content_Choice_URI(template (present) XSD.AnyURI p_URI) := { mcpttURI := p_URI };                                         /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCPTT_Content_True := cr_MCPTT_Content_Boolean(true);                                                                                       /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCPTT_Content(template urn_3gpp_ns_mcpttInfo_1_0.ProtectionType p_Protection := *,
                                                  template (present) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := p_Protection,
    attr := omit,
    choice := p_Choice
  };

  template (present) ContentType cr_MCPTT_Content_Boolean(template (present) XSD.Boolean p_Boolean) := cr_MCPTT_Content(-, cr_MCPTT_Info_Content_Choice_Boolean(p_Boolean));    /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCPTT_Content_String(template (present) XSD.String p_String) := cr_MCPTT_Content(-, cr_MCPTT_Info_Content_Choice_String(p_String));         /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCPTT_Content_URI(template (present) XSD.AnyURI p_URI) := cr_MCPTT_Content(-, cr_MCPTT_Info_Content_Choice_URI(p_URI));                     /* @status    APPROVED (MCX) */

  template ContentType cr_MCPTT_Content_FalseIfPresent := cr_MCPTT_Content_Boolean(false) ifpresent;                                                                            /* @status    APPROVED (MCX) */

  template (present) MCPTT_Info_Type cr_MCPTT_Info_Base :=
  { /* MCPTT info according to 36.579-1 Table 5.5.3.2.1-1 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcptt_Params := {
      attr := omit,
      mcptt_access_token     := omit,
      session_type           := omit,
      mcptt_request_uri      := omit,
      mcptt_calling_user_id  := omit,
      mcptt_called_party_id  := omit,
      mcptt_calling_group_id := omit,
      required               := omit,
      emergency_ind          := cr_MCPTT_Content_FalseIfPresent,
      alert_ind              := cr_MCPTT_Content_FalseIfPresent,
      imminentperil_ind      := cr_MCPTT_Content_FalseIfPresent,
      broadcast_ind          := false ifpresent,
      mc_org                 := omit,
      floor_state            := omit,
      associated_group_id    := omit,
      originated_by          := omit,
      mKFC_GKTPs             := omit,
      mcptt_client_id        := omit,
      alert_ind_rcvd         := omit,
      gw_mcptt_usage         := omit,                           // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list              := {},
      anyExt                 := *
    },
    elem_list := {},
    anyExt := *
  };

  template (present) MCPTT_Info_Type cdr_MCPTT_Info_WithRequestUri(charstring p_McpttRequestURI := px_MCPTT_ID_User_A) modifies cr_MCPTT_Info_Base :=
  { /* @status    APPROVED (MCX) */
    mcptt_Params := {
      mcptt_request_uri := cr_MCPTT_Content_URI(p_McpttRequestURI),
      mcptt_calling_user_id := cr_MCPTT_Content_URI(px_MCPTT_ID_User_A) ifpresent
    }
  };

  /*
   * @desc      Table 5.5.3.2.1-1: MCPTT-Info from the UE with conditions GROUP-CALL, CHAT-GROUP-CALL or PRIVATE-CALL
   * @param     p_CallType
   * @param     p_Condition         (default value: NONE)
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_AssociatedGroupId (default value: omit)
   * @return    template (present) MCPTT_Info_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CallControl_MCPTTInfo_RX(MCX_CallType_Type p_CallType,
                                          MCX_MCServiceInfoRX_Condition_Type p_Condition := NONE,
                                          MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                          template (omit) charstring p_AssociatedGroupId := omit) runs on MCX_IMS_PTC return template (present) MCPTT_Info_Type
  {
    var template (present) MCPTT_Info_Type v_McpttInfo := cr_MCPTT_Info_Base;
    var charstring v_UUID_URN := f_MCX_IMS_PTC_ClientId_GetValue();
    var template MCPTT_Info_Content_Type v_RequestURI := omit;
    var template MCPTT_Info_Content_Type v_ClientId := cr_MCPTT_Content_String(v_UUID_URN);

    select (p_CallType) {
      case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
        v_RequestURI := cr_MCPTT_Content_URI(px_MCPTT_Group_A_ID);
      }
      case (PRIVATE_CALL) {
        v_RequestURI := cr_MCPTT_Content_URI(px_MCPTT_ID_User_B) ifpresent;
      }
    }

    v_McpttInfo.mcptt_Params.mcptt_calling_user_id := cr_MCPTT_Content_URI(px_MCPTT_ID_User_A) ifpresent;
    v_McpttInfo.mcptt_Params.associated_group_id := p_AssociatedGroupId;

    select (p_Condition) {
      case (INVITE_REFER) {
        v_McpttInfo.mcptt_Params.session_type := f_MCX_MCServiceInfo_SessionType(p_CallType);
        v_McpttInfo.mcptt_Params.mcptt_request_uri := v_RequestURI;
        select (p_PriorityCallType) {
          case (EMERGENCY_CALL) {
            v_McpttInfo.mcptt_Params.emergency_ind := cr_MCPTT_Content_True;
            v_McpttInfo.mcptt_Params.alert_ind := cr_MCPTT_Content_Boolean(pc_MCX_EmergencyIndWithAlertInd);           // @sic R5-213654: pc_MCX_EmergencyIndWithAlertInd sic@
          }
          case (IMMPERIL_CALL) {
            v_McpttInfo.mcptt_Params.imminentperil_ind := cr_MCPTT_Content_True;
          }
          case (BROADCAST) {
            v_McpttInfo.mcptt_Params.broadcast_ind := true;
          }
          case else {      // NORMAL_CALL
            select (p_CallType) {
              case (PRIVATE_CALL, FIRST_TO_ANSWER) {  // NOTE: BROADCAST is not applicable for PRIVATE_CALL
                v_ClientId := v_ClientId ifpresent;   // <mcptt-client-id> optional
              }
            }
          }
        }
        v_McpttInfo.mcptt_Params.mcptt_client_id := v_ClientId;
      }
      case (INVITE_RSP) {
        v_McpttInfo.mcptt_Params.mcptt_called_party_id := cr_MCPTT_Content_URI(px_MCPTT_ID_User_A) ifpresent;
      }
    }

    return v_McpttInfo;
  }

  /*
   * @desc      Encode Mcpttinfo
   * @param     p_Mcpttinfo
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCPTTInfo_Encode(template (value) Mcpttinfo p_Mcpttinfo) return XmlBody_Type
  {
    var bitstring v_EncodedMcpttinfo := encvalue(p_Mcpttinfo);
    return f_Bit2XmlBody(v_EncodedMcpttinfo);
  }

  /*
   * @desc      Encode and encrypt Mcpttinfo
   * @param     p_MCPTT_Info
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCPTTInfo_EncodeEncrypt(template (value) Mcpttinfo_Type p_MCPTT_Info,
                                         charstring p_MCServiceID,
                                         template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_MCX_MCPTTInfo_Encode(p_MCPTT_Info);
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    for (i := 0; i < lengthof(tsc_MCPTT_Info_EncryptedElements); i := i + 1) {
      v_XmlPath := "//mcpttinfo/mcptt-Params/" & tsc_MCPTT_Info_EncryptedElements[i];
      f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  /*
   * @desc      Decode MCPTT Info
   * @param     charstring
   * @return    Mcpttinfo_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_MCPTTInfo_Decode(universal charstring p_XmlDocument) return Mcpttinfo_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XmlDocument);
    var Mcpttinfo v_Mcpttinfo;

    if (decvalue(v_Bitstring, v_Mcpttinfo) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCPTT-Info");
    }
    return v_Mcpttinfo;
  }

  /*
   * @desc      Decrypt and decode MCPTT Info
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    Mcpttinfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCPTTInfo_DecryptDecode(XmlBody_Type p_XmlDocument,
                                         charstring p_MCServiceID,
                                         template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return Mcpttinfo_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var charstring v_ElementName;
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      for (i := 0; i < lengthof(tsc_MCPTT_Info_EncryptedElements); i := i + 1) {
        v_ElementName := tsc_MCPTT_Info_EncryptedElements[i];
        v_XmlPath := "//mcpttinfo/mcptt-Params/" & v_ElementName;
        v_DecryptResult := f_XML_Document_DecryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, valueof(p_CSK));  // v_XmlDocument: inout parameter
        if (v_DecryptResult == NOT_ENCRYPTED) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, v_ElementName & " is not encrypted");
        }
      }
      fx_XML_Log(__FILE__, __LINE__, UPLINK, v_XmlDocument);
    }

    return fl_MCX_MCPTTInfo_Decode(v_XmlDocument);
  }

}
