  template (value) RedirectedCarrierInfo cs_NR_RedirectedCarrierInfoToEUTRA(ARFCN_ValueEUTRA p_ARFCN_ValueEUTRA):=
  { /* @status    APPROVED (NR5GC_IRAT) */
    eutra := {
      eutraFrequency := p_ARFCN_ValueEUTRA,
      cnType := epc       // @sic R5s190543 BASELINE MOVING 2019: cnType_r15 -> cnType sic@
    }
  };

  template (present) UE_Status cr_UEStatus_S1 :=
  { // 24.501 cl. 9.11.3.56
    /* @status    APPROVED (NR5GC_IRAT) */
    iei     := '2B'O,
    iel     := ?,
    spare   := tsc_Spare6,
    n1ModeRegistered    := ?,
    s1ModeRegistered    := '1'B
  };

  template (value) FreqBandList cs_NR_FreqList(integer p_NR) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    cs_NR_BandInformationNR(p_NR)
  };

  template (value) GSM_MobilityInfo_Type cs_GSM_MobilityInfo(template (value) O1_Type p_SessionId,
                                                             ProcedureTransactionIdentifier p_PTI := '00'O,  // !!!! should be omit if PTI is optional !!!!
                                                             PDU_PDN_DNN_Type p_PDUType,
                                                             template (omit) B3_Type p_SessionType := omit,
                                                             template (omit) DNN p_DNN := omit,
                                                             template (omit) AlwaysOnPDUSessionInd p_AlwaysOn := omit,
                                                             template (omit) ExtdProtocolConfigOptions p_PCO := omit,
                                                             template (omit) integer p_EPS_Bearer := omit,
                                                             template (omit) PDN_Index_Type p_PdnIndex := omit) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    SessionId   := p_SessionId,
    PTI         := p_PTI,
    PDUType     := p_PDUType,
    SessionType := p_SessionType,
    DNN         := p_DNN,
    AlwaysOn    := p_AlwaysOn,
    PCO         := p_PCO,
    EPS_Bearer  := p_EPS_Bearer, // @sic R5s201094 sic@
    PdnIndex    := p_PdnIndex,   // @sic R5s201094 sic@
    NSSAI       := omit
  };

  template (value) S1ToN1TransparentContainer cs_S1ToN1TransparentContainer (template (omit) O4_Type p_Mac,
                                                                             B4_Type p_CiphAlg,
                                                                             B4_Type p_IntAlg,
                                                                             B3_Type p_Ncc,
                                                                             B1_Type p_Tsc,
                                                                             B3_Type p_Ksi5G) :=
    
  { /* @status    APPROVED (NR5GC_IRAT) */
    /* 24.501 cl. 9.11.2.9 */
    mac         := p_Mac,
    ciphAlg     := p_CiphAlg,
    intAlg      := p_IntAlg,
    spareBit    := tsc_Spare1,
    ncc         := p_Ncc,
    tsc         := p_Tsc,
    ksi5G       := p_Ksi5G,
    spare       := '0000'O
  };

  /*
   * @desc      Transfer of capability info to/from EUTRA PTC during Preamble on EUTRA
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_UECapabilityTransfer(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {
    var template (value) FreqBandList v_NR_FreqList;
    var bitstring v_NRCapability;
    var UE_NR_Capability v_NR_Cap;
    var integer v_Result;
    var integer v_NRBandInd := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);
    var integer i;
    var boolean v_MatchedNRBand := false;
    
    // Send NR band under test to EUTRA
    v_NR_FreqList := cs_NR_FreqList(v_NRBandInd);
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (bit2oct(encvalue(v_NR_FreqList)), "NR_Freq"));
    // Finally receive NR capabilities
    v_NRCapability := oct2bit(f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "NRCap"));
    
    // Check NR Capability
    v_Result := decvalue(v_NRCapability, v_NR_Cap);
    if (v_Result != 0) {
      FatalError(__FILE__, __LINE__, "Decoding error");
    }
    f_NR_MobileInfo_NRCap_Set (v_NR_Cap);
    
    f_NR_CheckReleaseIndicator (v_NR_Cap.accessStratumRelease);
    for (i := 0; i < lengthof(v_NR_Cap.rf_Parameters.supportedBandListNR); i := i+1) {
      if (match(v_NR_Cap.rf_Parameters.supportedBandListNR[i].bandNR, v_NRBandInd)) {
        v_MatchedNRBand := true;
        break;
      }
    }
    if ( not v_MatchedNRBand) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NR Freq Band Ind must match value sent");
    }
       
  }

 /*
   * @desc      To be called at the same time as f_EUTRA38_TrackingAreaUpdateFromN1 is called on the EUTRA PTC
   *            to send both the GUTI parameters and authentication parameters to EUTRA
   * @param     p_NR_CellId
   * @return    NasCountInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_TrackingAreaUpdateFromN1 (NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC return NasCountInfo_Type
  {
    f_NR5GC_SendPduSessionInfoListToEUTRA(); // @sic R5-204399 sic@
    f_NR5GC_Send_GutiParametersToEUTRA (p_NR_CellId);
    // wait for EUTRA to trigger that it's ok to get the NAS count value
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    return f_NR5GC_Send_AuthParametersToEUTRA ();
  }

  /*
   * @desc      to send the GUTI parameters to EUTRA
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_Send_GutiParametersToEUTRA (NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_CoOrd_Guti(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN(p_NR_CellId)),
                                                         v_GutiParams.AMF_RegionId,
                                                         v_GutiParams.AMF_SetId,
                                                         v_GutiParams.AMF_Pointer,
                                                         v_GutiParams.NG_TMSI));
  }

  /*
   * @desc      to send both the authentication parameters to EUTRA
   * @return    NasCountInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_Send_AuthParametersToEUTRA () runs on NR5GC_PTC return NasCountInfo_Type
  {
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams := f_NR5GC_Security_Get();
    var NasCountInfo_Type v_NASCountInfo := f_SS_NG_NAS_CountGet(NASCTRL);
    
    v_NASCountInfo.DL := f_NasSecurity_IncrementCOUNT(v_NASCountInfo.DL); // @sic R5s200509 sic@
    v_NASCountInfo.UL := f_NasSecurity_IncrementCOUNT(v_NASCountInfo.UL); // @sic R5s200509 sic@
    
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Security(omit, omit,
                                                       v_NAS_SecurityParams.KAMF,
                                                       v_NAS_SecurityParams.KSIamf,
                                                       v_NASCountInfo.UL,
                                                       v_NASCountInfo.DL, // @sic R5w190307 sic@
                                                       omit, omit, omit, omit));
    return v_NASCountInfo;
  }

  /*
   * @desc      to convert the CoOrdination message containing the 5G GUTI parameters into the NG_MobileIdentity.
   *            Note: The 5G GUTI is currently passed in the coOrdination msg in its component parts
   * @param     p_CoOrdMsg
   * @param     p_IEI
   * @return    template (value) NG_MobileIdentity
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR_Convert_CoOrdTo5G_GUTI (EUTRA_NR_CoOrd_GUTI_Type p_CoOrdMsg,
                                        template (omit) IEI8_Type p_IEI) return template (value) NG_MobileIdentity
  {
    var bitstring v_AMFId := p_CoOrdMsg.AMF_RegionId & p_CoOrdMsg.AMF_SetId & p_CoOrdMsg.AMF_Pointer;
    var octetstring v_GutiString := p_CoOrdMsg.PLMN & bit2oct(v_AMFId) & bit2oct(p_CoOrdMsg.NG_TMSI);
    return cs_NG_MobileIdentity_Guti(p_IEI, v_GutiString);
  }

  /*
   * @desc      Function to be used to map the EUTRA parameters to 5G.
   *            If a new integrity and/or ciphering algoritm is to be used, this must have been previously set in the SecurityParams
   * @param     p_EUTRA_Auth_Params
   * @param     p_Handover
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_MappedContextFromS1_InitNAS(EUTRA_NR_CoOrd_Security_Type p_EUTRA_Auth_Params,
                                               boolean p_Handover )  runs on NR5GC_PTC
  {
    var NG_NAS_SecurityParams_Type v_SecurityParams := f_NR5GC_Security_Get();
    var NR_SecurityParams_Type v_RRC_SecurityParams := f_NR_Security_Get();

    if (p_Handover) {
      v_SecurityParams.KAMF := f_NG_Authentication_A15_HO(p_EUTRA_Auth_Params.NH,   // @sic R5s201078 sic@
                                                          p_EUTRA_Auth_Params.Key,
                                                          v_SecurityParams.KDF);
    } else {
      v_SecurityParams.KAMF := f_NG_Authentication_A15_IdleMode(p_EUTRA_Auth_Params.NASCountUL,
                                                                p_EUTRA_Auth_Params.Key,
                                                                v_SecurityParams.KDF);
    }

    // Derives KNASenc key
    v_SecurityParams.NAS_Ciphering.K_NAS := f_NG_Authentication_A8 (tsc_NAS_Enc_Alg,v_SecurityParams.NAS_Ciphering.Algorithm,
                                                                           v_SecurityParams.KAMF,
                                                                           v_SecurityParams.KDF);
    // Derives KNASint key
    v_SecurityParams.NAS_Integrity.K_NAS := f_NG_Authentication_A8 (tsc_NAS_Int_Alg,v_SecurityParams.NAS_Integrity.Algorithm,
                                                                           v_SecurityParams.KAMF,
                                                                           v_SecurityParams.KDF);
                                                                           
    // Now NAS parameters updated, store updated common values in RRC global variable @sic R5s201078 sic@
    v_RRC_SecurityParams.KAMF := v_SecurityParams.KAMF;
    v_RRC_SecurityParams.KSIamf := v_SecurityParams.KSIamf;
    
    // Derive KgNB  @sic R5s201078 sic@
    v_RRC_SecurityParams.KGNB := f_NR_Authentication_A9(v_RRC_SecurityParams.KDF, v_RRC_SecurityParams.KAMF, 'FFFFFFFF'O);
    
    // set NH and NCC as per 33.501 cl.8.4.2 point 3  @sic R5s201078 sic@
    v_RRC_SecurityParams.NH:= v_RRC_SecurityParams.KGNB;
    v_RRC_SecurityParams.NCC := 0;
    
    // Now update the SS
    f_SS_NG_NAS_ConfigureSecurity(NASCTRL, v_SecurityParams.NAS_Integrity, v_SecurityParams.NAS_Ciphering, true); // @sic R5s211342 sic@
    // @sic R5s210446, R5s201467 sic@
    if (p_Handover) {  //@sic R5s220175 sic@
        f_SS_NG_NAS_CountSet(NASCTRL, '00000000'O, omit);
    }
                                              
    f_NR_Security_Set(v_RRC_SecurityParams);
    f_NR5GC_Security_Set (v_SecurityParams);
  }

  /*
   * @desc      TS 38.508-1 table 4.9.9 Test procedure for S1 to N1 intersystem change / Idle mode
   * @param     p_NR_CellId
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_FirstTimeS1ToN1   (default value: true)
   * @param     p_GUTIFromPreamble  (default value: omit)
   * @param     p_TAI               (default value: *)
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_Registered_Previously_5GCN (default value: true)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @param     p_UERadioCapIdToSend      (default value: omit)
   * @return    NR_RadioBearerId_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_S1ToN1_IdleMode(NR_CellId_Type p_NR_CellId,
                                        RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                        boolean p_FirstTimeS1ToN1 := true,
                                        template (omit) NG_MobileIdentity p_GUTIFromPreamble := omit,
                                        template NG_TrackingAreaId p_TAI := *,
                                        template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                        template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                        boolean p_Registered_Previously_5GCN := true,

                                        InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                        template (omit) UERadioCapId p_UERadioCapIdToSend := omit)  runs on NR5GC_PTC return NR_RadioBearerId_Type
  {
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var template (value) NG_MobileIdentity v_GUTIFromPreamble;
    var template NG_TrackingAreaId v_TAI;
    //@sic R5s201060 sic@
    var template (value) NG_NetworkFeatureSupport v_NwkFeatureSupport := cs_NG_NetworkFeatureSupport_Def;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams := f_NR5GC_Security_Get();
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1;
    
    if (isvalue(p_GUTIFromPreamble)) {
      v_GUTIFromPreamble := valueof(p_GUTIFromPreamble);
    } else {
      v_GUTIFromPreamble := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    }
    
    if (isvalue(p_TAI)) {
      v_TAI := valueof(p_TAI);
    } else {
      v_TAI := f_LastVisited_TAI (p_NR_CellId);
    }
    
    if (p_IwkN26 == SUPPORTED) { // @sic R5-204401 sic@
      v_NwkFeatureSupport.iwk_N26 := '1'B;
    }
    
    f_NR5GC_IRAT_MobilityRegistration (p_NR_CellId,
                                      v_NAS_SecurityParams,
                                      //@sic R5s201060 sic@
                                      omit, //  @sic R5-198854 sic@
                                      v_GUTIFromPreamble,
                                      v_TAI,
                                      p_GUTIToSend,
                                      p_TAIList,
                                      noRrcConnectionRelease,
                                      p_Registered_Previously_5GCN,
                                      v_NwkFeatureSupport,
                                      p_UERadioCapIdToSend,  // @sic R5-222047 sic@
                                      -,
                                      p_IwkN26); // @sic R5-237320 sic@
    
    // @sic R5-205142 sic@
    v_SRB := f_NR5GC_IRAT_S1ToN1_Steps14(p_NR_CellId, p_ReleaseConnection, p_FirstTimeS1ToN1, p_IwkN26);
    return v_SRB; // @sic R5-204401 sic@
  }

  /*
   * @desc      TS 38.508-1 table 4.9.9 Test procedure for S1 to N1 intersystem change / Idle mode
   *            Steps 14 onwards for optional PDU Session Modification and Establishment
   * @param     p_NR_CellId
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_FirstTimeS1ToN1   (default value: true)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @return    NR_RadioBearerId_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_S1ToN1_Steps14(NR_CellId_Type p_NR_CellId,
                                        RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                        boolean p_FirstTimeS1ToN1 := true,
                                        InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED)  runs on NR5GC_PTC return NR_RadioBearerId_Type
  {
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList;
    //@sic R5s201060 sic@
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1;
    var boolean v_FailWhenK_LessN := false;
    var template NG_Request_Type v_RequestType := cr_NG_Request_Type('001'B);
    var boolean v_MsgRxd := false;
    var integer i;
    var boolean v_ReregisterIMS := false;
    var default v_MyDefaultVar := null;
    
    timer  t_Wait := 8.0; // @sic R5-204399, R5s210077 sic@

    if (p_IwkN26 == SUPPORTED) { // @sic R5-204401 sic@
      v_FailWhenK_LessN := true; // The only difference between 14a1 and 14b1 branch
      v_RequestType := cr_NG_Request_Type('010'B); // @sic R5-206290 sic@
    }
    
    // always wait for PDU info, even if not 1st time
    v_PduSessionInfoList := f_EUTRA_NR_WaitForCoOrd_PduSessionInfoList(EUTRA);

    // @sic R5s210520 sic@
    // Clear store of msgs received in parallel
    f_NR5GC_MsgInDefault_ResetStoreOfNASMessageReq(); // @sic R5s220174 sic@
    // Then activate store for any new msgs received - this works for Modification Reqs too
    v_MyDefaultVar := activate(a_NR5GC_AdditionalPDUSessionEstablishmentReq(p_NR_CellId));

    t_Wait.start;  //  @sic R5-204399 sic@

    // make sure all the PDNs configured on EUTRA are changed in routing table @sic R5s210149, R5s210520 sic@
    for (i := 0; i < lengthof (v_PduSessionInfoList); i := i + 1) {
      f_NR_ChangeDrbMappingForExistingPDNs(p_NR_CellId, v_PduSessionInfoList[i]);  // @sic R5s221175 sic@
    }
    // @sic R5s210520 sic@
    // has a NAS msg already been received? if so, stop waiting
    if (f_NR5GC_MsgInDefault_GetNumOfNASMessageReq() > 0) { // @sic R5s220174 sic@
      v_ReceivedAsp := f_NR5GC_MsgInDefault_GetOneNASMessageReq(1); // @sic R5s220174 sic@
      v_MsgRxd := true;
      t_Wait.stop;
    } else {
      alt { //  @sic R5-204401 sic@
        [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp  // @sic R5s201413 sic@
          {
           f_NR5GC_MsgInDefault_StoreNASMessageReq (v_ReceivedAsp); // @sic R5s210687 sic@
           v_MsgRxd := true;
           t_Wait.stop;
          }
        [] t_Wait.timeout {}
      }
    }
    if (v_MsgRxd and ischosen(v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request)) { // @sic R5s210520 sic@
      if (p_FirstTimeS1ToN1 and p_IwkN26 == NOT_SUPPORTED) {
        v_ReregisterIMS := f_NR5GC_IRAT_S1ToN1_SessionModification(p_NR_CellId, v_PduSessionInfoList, false, v_SRB); // @sic R5s201413 sic@
        v_SRB := tsc_NR_RbId_SRB2; // @sic R5s210687 sic@
      } else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Not expecting PDU Session Modification message");
      }
      // reset flag as 1st msg now been processed
      v_MsgRxd := false;
      t_Wait.start; // restart timer in case there are now PDU Establishment messages
      alt { //  @sic R5-204401 sic@
        [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp  // @sic R5s201413 sic@
          {
          // update v_ReceivedAsp and msg store if received again  @sic R5s210520 sic@
            f_NR5GC_MsgInDefault_StoreNASMessageReq (v_ReceivedAsp);
            v_MsgRxd := true;
            t_Wait.stop;
          }
        [] t_Wait.timeout {
              // Do nothing as no (more) PDU Modification/Establishment messages received so carry on
          }
      }
    }
    // don't need this anymore so deactivate it before it needs reactivating
    deactivate(v_MyDefaultVar);  // @sic R5s210520 sic@
    if (v_ReregisterIMS){ // @sic R5s240521 sic@
      f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_ReregistrationStop);
    }

    
    if (v_MsgRxd) {  // @sic R5s210672 sic@
      if (ischosen(v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Establishment_Request)) { // @sic R5s210520 sic@
        f_NR5GC_PDUSessionEstablishment (p_NR_CellId, pc_noOf_PDUsSameConnection, tsc_NR_RbId_SRB1, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, v_RequestType, -, -, -, -, -, -, "", v_FailWhenK_LessN, -, v_PduSessionInfoList, -, 1); // @sic R5-206290, R5s210149, R5s210520 sic@
        v_SRB := tsc_NR_RbId_SRB2; // @sic R5-204401 sic@
        //  @sic R5-204401 sic@
        if (pc_noOf_PDUsNewConnection >0 ){
          f_NR_RRCRelease(p_NR_CellId);
          f_NR5GC_RRC_Idle_Extension(p_NR_CellId, -, -, -, -, -, -, -, -, -, -, true);  // @sic R5-237315 sic@
        }
      } else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Wrong NAS Message Received");
      }
    }

    // in case there's no PDU messages at all, don't release the connection in the above functions, but do it here instead
    if (p_ReleaseConnection == rrcConnectionRelease) {
      // Release RRC to enter RRC_IDLE
      f_NR_RRCRelease(p_NR_CellId);
    }
    return v_SRB; // @sic R5-204401 sic@
  }

  /*
   * @desc      TS 38.508-1 Table 4.5A.2C-1: procedure for UE-requested PDU session modification
   *            N.B: a_NR5GC_AdditionalPDUSessionEstablishmentReq shall be started before entering this function
   * @param     p_NR_CellId
   * @param     p_PduSessionsFromLTE
   * @param     p_FailWhenK_LessN   (default value: true)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @param     p_ExpectedNumberOfNewPDUSessions (default value: (pc_noOf_PDNsSameConnection + pc_noOf_PDNsNewConnection +1))
   * @param     p_DRBsAlreadyConfigured (default value: false)
   * @return    boolean
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_S1ToN1_SessionModification(NR_CellId_Type p_NR_CellId,
                                                   EUTRA_NR_PduSessionInfoList_Type p_PduSessionsFromLTE,
                                                   boolean p_FailWhenK_LessN := true,
                                                   NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1,
                                                   integer p_ExpectedNumberOfNewPDUSessions := (pc_noOf_PDNsSameConnection + pc_noOf_PDNsNewConnection +1),  // @sic R5s220577 sic@
                                                   boolean p_DRBsAlreadyConfigured := false) runs on NR5GC_PTC return boolean
  {
    var template (value) PDUSessionInfoList_Type v_FromLTEList;
    var NG_NAS_UL_PduList_Type v_PduSessionModificationRequestList := {};
    var IntegerList_Type v_PDU_SessionIdList := {};
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo := f_NR5GC_MobileInfo_GetGMM_MobilityInfo();
    var GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_UL_Pdu_Type v_NG_NAS_UL_Pdu;
    var NG_NAS_UL_Message_Type v_GSMMsg;
    var integer v_PDU_SessionId;
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) NR_RadioBearerList_Type v_RadioBearerList;  // list of DRBs to be configured at the SS (SRB2 alredy configured in SS at cell creation/RRC release procedure => not needed here)
    var template (value) SDAP_ConfigurationList_Type v_SDAP_ConfigurationList;
    var template (value) SDAP_Config v_SDAP_Config := cs_SDAP_Config;
    var boolean v_ReregisterIMS := false;
    var template (value) NG_NAS_DL_Pdu_Type v_NG_NAS_DL_Pdu;
    var integer N := p_ExpectedNumberOfNewPDUSessions;  // number of PDU SESSION MODIFICATION REQUEST messages being expected
    var integer K := 0;   // number of PDU SESSION MODIFICATION REQUEST messages already processed (i.e. the corresponding PDU SESSION MODIFICATION COMMAND and PDU SESSION MODIFICATION COMPLETE have been sent/received)
    var integer L := 0;   // number of PDU SESSION MODIFICATION REQUEST messages being received
    var boolean v_WaitForComplete := false;
    var template (present) NG_UE_SM_Cap v_NG_UE_SM_Cap := ?;                         // according to 38.508-1 Table 4.5A.2C.2.3-1
    var template (present) IntegrityProtMaxDataRate v_IntegrityProtMaxDataRate := ?; // according to 38.508-1 Table 4.5A.2C.2.3-1
    var integer i;
    var SRBs_AlreadyConfigured v_SRBs := SRB1;
    var NR_RadioBearerId_Type v_SRB := p_SRB;  // @sic R5s210672 sic@
    var IntegerList_Type v_TransferredSessions;
    var PDU_PDN_DNN_Type v_PDU_Type := Internet_DNN; // assume this for now @sic R5-206296 sic@
    var boolean v_RxdMsg := false;
    var boolean v_WaitForRRCComplete := false;
    
    timer t_Wait := 10.0; // @sic R5-204330 sic@

    // Build the GSMMobilityInfo for all received PDUs, but don't store it (some may be established, rather than modified)
    if (ispresent(v_GMM_MobilityInfo.SessionStatus)) { // @sic R5-206290 sic@
      v_TransferredSessions := f_NG_ConvertPDU_SessionStatus(v_GMM_MobilityInfo.SessionStatus);
      for (i := 0; i < lengthof (p_PduSessionsFromLTE); i := i + 1) {
        if (f_IntegerList_Search(v_TransferredSessions, p_PduSessionsFromLTE[i].PDU_SessionId) != -1) {
          // don't store if not in transferred list
          if (p_PduSessionsFromLTE[i].IsIMS) {  // @sic R5-206296 sic@
            v_PDU_Type := IMS_DNN;
          }
          v_FromLTEList[i] := cs_GSM_MobilityInfo(int2oct(p_PduSessionsFromLTE[i].PDU_SessionId, 1), -, v_PDU_Type); // @sic R5s200564 sic@
        }
      }
    }
        
    t_Wait.start;  // @sic R5-204330 sic@
    while ((K < N) or v_WaitForRRCComplete) { // @sic R5-215678 sic@
      if (not (v_WaitForComplete) and f_NR5GC_MsgInDefault_GetNumOfNASMessageReq() > L) { // @sic R5s210520, R5s220174, R5s220577 sic@
        // 1st msg was received before entering function
        v_ReceivedAsp := f_NR5GC_MsgInDefault_GetOneNASMessageReq(L+1); // @sic R5s220174, R5s220577  sic@
        v_RxdMsg := true;
        t_Wait.stop;
      } else {
        alt { // @sic R5-204330 sic@
          [v_WaitForRRCComplete] SRB.receive(car_NR_SRB_RrcPdu_IND(p_NR_CellId,
                                      tsc_NR_RbId_SRB1,
                                      cr_38508_RRCReconfigurationComplete))     // @sic R5s211280 sic@
          {
            v_WaitForRRCComplete := false;
          }
          [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp // @sic R5s201413, R5s210672 sic@
          {
            v_RxdMsg := true;
            t_Wait.stop;
          }
          [] t_Wait.timeout {
            if (p_FailWhenK_LessN and (K < N)) {
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Not enough PDU Session Modification Request messages");
            } else if (not p_FailWhenK_LessN) { // New message not received in time, so just end the loop  @sic R5-204330 sic@
              break;
            }
          }
        }
      }
      if (v_RxdMsg) { // @sic R5s210520 sic@
        v_NG_NAS_UL_Pdu := v_ReceivedAsp.Signalling.Nas[0].Pdu;
        v_GSMMsg := v_NG_NAS_UL_Pdu.PiggybackedPduList[0].Msg;

        if (v_WaitForComplete and ischosen(v_GSMMsg.pdu_Session_Modification_Complete)) { // @sic R5s230141 sic@
          // The v_GSM_MobilityInfo WILL be initialised when this iteration of the loop is processed
          if (not f_Check_NG_PDUSessionModificationComplete(v_NG_NAS_UL_Pdu, v_GSM_MobilityInfo.SessionId, v_GSM_MobilityInfo.PTI)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid PDU SESSION MODIFICATION COMPLETE");
          }
          v_WaitForComplete := false;
          K := K + 1;
          if (L > K) { // @sic R5s230141 sic@
            v_NG_NAS_UL_Pdu := v_ReceivedAsp.Signalling.Nas[0].Pdu;
            v_GSMMsg := v_NG_NAS_UL_Pdu.PiggybackedPduList[0].Msg;
            L := L - 1;
          }
        }
        
        if (ischosen(v_GSMMsg.pdu_Session_Modification_Request)) {
          v_PduSessionModificationRequestList[L] := v_NG_NAS_UL_Pdu;
          L := L + 1;
          if (L > N) { // @sic R5-204330 sic@
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "L > N");
          }
          if (not v_WaitForComplete and (K < L)) {   // => process the next PDU SESSION MODIFICATION REQUEST
            v_NG_NAS_UL_Pdu := v_PduSessionModificationRequestList[K];

            if (not f_Check_NG_PDUSessionModificationReq(v_GSM_MobilityInfo, valueof(v_FromLTEList), v_NG_NAS_UL_Pdu, -, -, v_NG_UE_SM_Cap, -, -, -, v_IntegrityProtMaxDataRate, -, -, -, -, -, cr_NG_Request_Type('101'B))) {     // v_GSM_MobilityInfo is out parameter of f_Check_NG_PDUSessionModificationReq
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid PDU SESSION MODIFICATION REQUEST");
            }
            // ok, this PDU is to be modified, so can now store it in our list
            v_PDU_SessionId := oct2int(v_GSM_MobilityInfo.SessionId); // @sic R5s200564 sic@
            if (f_IntegerList_Search(v_PDU_SessionIdList, v_PDU_SessionId) < 0) {
              v_PDU_SessionIdList[K] := v_PDU_SessionId;
            } else {
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "There has been a PDU SESSION MODIFICATION REQUEST with the same session id already");
            }
            for (i := 0; i < N; i := i + 1) {
              if (p_PduSessionsFromLTE[i].PDU_SessionId == oct2int(v_GSM_MobilityInfo.SessionId)) {
     //             f_IP_ChangeDrbMappingNR(IP, p_NR_CellId, cs_IP_QosFlowId(p_PduSessionsFromLTE[i].PDU_SessionId, p_PduSessionsFromLTE[i].QFI), p_PduSessionsFromLTE[i].PdnIndex);
                v_GSM_MobilityInfo.EPS_Bearer := p_PduSessionsFromLTE[i].EPS_Bearer; // @sic R5s210408 sic@
                v_GSM_MobilityInfo.PDUType := p_PduSessionsFromLTE[i].PdnType;            // @sic R5-245495 sic@
                v_GSM_MobilityInfo.PdnIndex := p_PduSessionsFromLTE[i].PdnIndex; // @sic R5s210408 sic@
                v_ReregisterIMS := v_ReregisterIMS or p_PduSessionsFromLTE[i].IsIMS;
                v_SDAP_Config.mappedQoS_FlowsToAdd := {p_PduSessionsFromLTE[i].QFI};     // @sic R5s240585 sic@
                v_SDAP_Config.pdu_Session := p_PduSessionsFromLTE[i].PDU_SessionId;      // @sic R5s240585 sic@
                break;
              }
            }
            f_NR5GC_MobileInfo_AddPDUSession(v_GSM_MobilityInfo); // @sic R5s201413, R5s210408 sic@
            // At the moment no DRBs are configured in the prose - so this will only work for HO TCs
            if (v_ReregisterIMS) { // @sic R5-205942 sic@
              // Tell IMS to start waiting for the Register message.
              f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_ReregistrationStart(NR));
            }
            v_NG_NAS_DL_Pdu := f_Get_NG_PDUSessionModificationCommand(v_GSM_MobilityInfo.SessionId, v_GSM_MobilityInfo);
            f_BuildRRCReconfigParamsNewDRBs (v_RadioBearerConfig,
                                             v_CellGroupConfig,
                                             v_RadioBearerList,
                                             v_SDAP_ConfigurationList,
                                             p_NR_CellId,
                                             {v_GSM_MobilityInfo},
                                             v_SRBs,  // @sic R5-213442 sic@
                                             v_SDAP_Config);   // @sic R5s240585 sic@
            if (v_SRB == tsc_NR_RbId_SRB1) { // @sic R5s201654, R5s210672 sic@
              v_SRBs := SRB1_2;
              v_SRB := tsc_NR_RbId_SRB2;
            }
            if (p_DRBsAlreadyConfigured) {  // @sic R5-213442 sic@
              SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_NG_NAS_DL_Pdu))); // @sic R5s201413, R5s210672 sic@
              v_WaitForComplete := true;  // @sic R5-215678 sic@
            } else {                        // @sic R5-213442 sic@
              // Send with a RRC Reconfiguration message
              f_NR_RRCReconfigNewDRBWithSSConfig(p_NR_CellId,
                                                 v_RadioBearerConfig,
                                                 v_RadioBearerList,
                                                 v_CellGroupConfig,
                                                 { cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_NG_NAS_DL_Pdu)},
                                                 -, -, false); // @sic R5-215678 sic@
            }
            v_WaitForComplete := true;
            v_WaitForRRCComplete := true; // @sic R5-215678 sic@
            t_Wait.start;  // restart timer to wait for next Request
          }
        }
        // @sic R5s230141 sic@
      }
      v_RxdMsg := false; // @sic R5s210520 sic@
    }
    // Timer will have been started again in loop, but loop is now finished, so need to stop timer
    t_Wait.stop;
    
    return v_ReregisterIMS;
  }

  /*
   * @desc      TS 38.508-1 table 4.9.9 InterSystem Mobility Registration procedure
   * @param     p_NR_CellId
   * @param     p_SecurityParams
   * @param     p_NonCurrentKSI     (default value: omit)
   * @param     p_GUTIFromPreamble
   * @param     p_TAI               (default value: *)
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_Registered_Previously_5GCN (default value: true)
   * @param     p_NwkFeatureSupport (default value: cs_NG_NetworkFeatureSupport_Def)
   * @param     p_UERadioCapIdToSend   (default value: omit)
   * @param     p_PDU_SessionStatus   (default value: cr_PDU_SessionStatusAny)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_MobilityRegistration (NR_CellId_Type p_NR_CellId,
                                              NG_NAS_SecurityParams_Type p_SecurityParams,
                                              // @sic R5s201060 sic@
                                              template (omit) NAS_KeySetIdentifier p_NonCurrentKSI := omit,
                                              template (omit) NG_MobileIdentity p_GUTIFromPreamble,
                                              template NG_TrackingAreaId p_TAI := *,
                                              template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                              template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                              RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                              boolean p_Registered_Previously_5GCN := true,
                                              template (value) NG_NetworkFeatureSupport p_NwkFeatureSupport := cs_NG_NetworkFeatureSupport_Def,
                                              template (omit) UERadioCapId p_UERadioCapIdToSend := omit,
                                              template PDU_SessionStatus p_PDU_SessionStatus := cr_PDU_SessionStatusAny,
                                              InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED)  runs on NR5GC_PTC
  { //@sic R5-198854: added p_Registered_Previously_5GCN sic@
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NasCount_Type v_NasCount;
    var template (present) B1_Type v_Tsc := '0'B;                                 //@sic R5-198854 sic@
    var template (present) NAS_KsiValue v_KeySetId := p_SecurityParams.KSIamf;    //@sic R5-198854, R5s200798 sic@
    var TypeOfRegistration_Type v_RegType := Initial_Secure;
    var EUTRA_NR_CoOrd_GUTI_Type v_CoOrd_Guti; // @sic R5s201060 sic@
    var AccessStratumRelease v_AccessStratumRelease;//@sic R5-237320 sic@

    if ( not p_Registered_Previously_5GCN) { //@sic R5-198854 sic@
        v_KeySetId := '111'B;
        v_Tsc := '?'B;//('1'B, '0'B);
        v_RegType := Initial_NoSecurity;
    }
    // Steps 1 - 3
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    v_CoOrd_Guti := f_EUTRA_NR_WaitForCoOrd_GutiParams(EUTRA); // @sic R5s201060 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo,
                                           v_ReceivedMsg.Pdu,
                                           Mobility,
                                           f_NR_Convert_CoOrdTo5G_GUTI(v_CoOrd_Guti, omit), // @sic R5s201060 sic@
                                           v_KeySetId,
                                           v_Tsc,
                                           p_NonCurrentKSI,
                                           cdr_NG_GMM_Cap_S1,
                                           -,-,
                                           p_TAI,
                                           cdr_NR5GC_UENetworkCap('17'O),
                                           -,
                                           p_PDU_SessionStatus,  // @sic R5-231417 sic@
                                           -,
                                           cr_UEStatus_S1,
                                           p_GUTIFromPreamble,
                                           -, -, -,
                                           *,           // @sic R5s250090 sic@
                                           -, -, -, -, -, -, -,
                                           omit)) {  // @sic R5-206290 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    v_AccessStratumRelease:= f_NR_MobileInfo_NRCap_Get_AccessStratumRelease();//@sic R5-237320 sic@
    if ((p_IwkN26 == SUPPORTED) and ((v_AccessStratumRelease != rel15) and (v_AccessStratumRelease != rel16))){  //@sic R5-237320, R5s240678 sic@
      // Send an empty message
      f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_OctetData('00'O, "TAUReq"));
    } else {
      if (isvalue(v_ReceivedMsg.Pdu.Msg.registration_Request.epsMessage)) {  // @sic R5s250090 sic@
        // Send TAU Req for checking in EUTRA
        f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_OctetData(v_ReceivedMsg.Pdu.Msg.registration_Request.epsMessage.epsMsg, "TAUReq"));
      } else {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "EPS NAS message not included in Registration Request");
      }
    }
    
    // @sic R5-198854 sic@
    //Steps 4-9: 5GMM Authentication and 5GMM security
    v_NasCount :=f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (p_NR_CellId)), v_RegType);
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(v_GMM_MobilityInfo);
    //Steps 8-9 RRC security activation
    f_NR_RRC_ActivateSecurity (p_NR_CellId, v_NasCount);
    
    f_NR5GC_MobilityRegistration_Steps4_6(p_NR_CellId, v_GMM_MobilityInfo, p_GUTIToSend, p_TAIList, p_ReleaseConnection, p_NwkFeatureSupport, -, -, -, p_UERadioCapIdToSend); // @sic R5-222047 sic@
  }

  /*
   * @desc      to be used in the test case preamble
   *            when it states UE to be attached on EUTRA, switched off, then registered on NR
   *            This function finishes with NR cell on (EUTRA cell off) and
   *            UE has completed registration on NR
   * @param     p_NR_CellId
   * @param     p_State
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_FollowedByRRCResume (default value: FollowedByResume)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_PreambleEUTRA_NR (NR_CellId_Type p_NR_CellId,
                                          NG_STATE_Type p_State,
                                          NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                          INACTIVE_FollowOnState p_FollowedByRRCResume := FollowedByResume ) runs on NR5GC_PTC //@sic R5s201380 sic@
  {
    // First pass capability info to EUTRA
    f_NR5GC_IRAT_UECapabilityTransfer(p_NR_CellId);
    // Wait until UE has attached on EUTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Preamble");
    // Now register on NR
    f_NR5GC_Preamble (p_NR_CellId, p_State, p_TestMode, p_FollowedByRRCResume); // @sic R5s201380, R5s250008 sic@
    // Now tell EUTRA preamble finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Preamble"));
  }

  /*
   * @desc      to be used in the test case preamble
   *            when it states UE to be attached on NR, switched off, then registered on EUTRA
   *            This function finishes with EUTRA cell on (NR cell off) and
   *            UE has completed registration on EUTRA
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_PreambleNR_EUTRA (NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    // register on NR and switch off
    f_NR5GC_Preamble (p_NR_CellId, STATE_OFF_0B); // @sic R5-225300 sic@
    // Turn power off
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    // Now tell EUTRA to attach
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Preamble"));
    // First pass capability info to EUTRA
    f_NR5GC_IRAT_UECapabilityTransfer(p_NR_CellId);
    // Wait until UE has attached on EUTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger (EUTRA, "Preamble");
  }

  /*
   * @desc      Generic function to initialise Cell Array for NR5GC IRAT test cases
   * @param     p_NR_SysinfoCombination
   * @param     p_Neighbour_NTN_Cells (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
   function f_NR5GC_IRAT_Init (NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                               template (omit) NR_CellIdList_Type p_Neighbour_NTN_Cells := omit) runs on NR5GC_PTC
  {
    f_NR5GC_Init(p_NR_SysinfoCombination, -, p_Neighbour_NTN_Cells); //@sic R5-242320 sic@
    f_NR5GC_IRAT_InitSysinfo (p_NR_SysinfoCombination)
  }

  /*
   * @desc      Generic function to initialise Sysinfo for NR5GC IRAT test cases
   * @param     p_NR_SysinfoCombination
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_InitSysinfo(NR_SysinfoCombination_Type p_NR_SysinfoCombination) runs on NR_BASE_PTC
  {
    var template (value) EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_SysInfoList;
    var template (value) EUTRA_NR_CoOrd_SysInfo_Type v_NRSysInfoList := f_NR5GC_IRAT_ListOfFrequencies(); //Get NR frequencies to send to EUTRA
    var template (value) SIB5 v_SIB5;

    // Get EUTRA frequency info and send NR frequencies
    v_EUTRA_SysInfoList := f_EUTRA_NR_SysinfoCoOrd(EUTRA, v_NRSysInfoList);
    select (p_NR_SysinfoCombination){
        case (NR_6, NR_7){
            v_SIB5 := f_NR5GC_IRAT_InitSIB5(v_EUTRA_SysInfoList);
            f_NR5GC_CellInfo_SetSIB5_FreqListAllCells(v_SIB5);
        }
        case else {} //do nothing
    }
    
   }

  /*
   * @desc  Return the list of available NR frequencies of the primary band
   * @return    template (value) EUTRA_NR_CoOrd_SysInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function  f_NR5GC_IRAT_ListOfFrequencies ()  runs on NR_BASE_PTC return template (value) EUTRA_NR_CoOrd_SysInfo_Type
  {
    var template (value) CoOrd_NRSysInfo_List_Type v_CoOrd_NRSysInfo_List;
    var FreqBandIndicatorNR v_Band := f_NR_CellInfo_GetBandIndicator(nr_Cell1);
    var integer v_PrimaryNumberOfFreq := f_NR_BandGetNumberOfFreq(v_Band);
    
    v_CoOrd_NRSysInfo_List[0] := cs_CoOrd_SysInfoNR(f_NR_CellInfo_GetFrequencySSB (nr_Cell1),
                                                    f_NR_CellInfo_GetPhysicalCellId (nr_Cell1),
                                                    f_NR_ConvertSCSToInt(f_NR_CellInfo_GetSSB_SCS (nr_Cell1)),
                                                    f_NR_CellInfo_GetIsFDD(nr_Cell1),
                                                    f_NR_CellInfo_GetIsFR1(nr_Cell1),
                                                    f_NR_CellInfo_GetBandIndicator(nr_Cell1),
                                                    f_NR_CellInfo_GetChannelBandwidth(nr_Cell1)  //@sic R5-254995 sic@);
                                                    );
    if (v_PrimaryNumberOfFreq >= 2) {
        v_CoOrd_NRSysInfo_List[1] := cs_CoOrd_SysInfoNR(f_NR_CellInfo_GetFrequencySSB (nr_Cell3),
                                                   f_NR_CellInfo_GetPhysicalCellId (nr_Cell3),
                                                   f_NR_ConvertSCSToInt(f_NR_CellInfo_GetSSB_SCS (nr_Cell3)),
                                                   f_NR_CellInfo_GetIsFDD(nr_Cell3),
                                                   f_NR_CellInfo_GetIsFR1(nr_Cell3),
                                                   f_NR_CellInfo_GetBandIndicator(nr_Cell3),
                                                   f_NR_CellInfo_GetChannelBandwidth(nr_Cell3)  //@sic R5-254995 sic@);
                                                   );
    }
    if (v_PrimaryNumberOfFreq >= 3) {
        v_CoOrd_NRSysInfo_List[2] := cs_CoOrd_SysInfoNR(f_NR_CellInfo_GetFrequencySSB (nr_Cell6),
                                                   f_NR_CellInfo_GetPhysicalCellId (nr_Cell6),
                                                   f_NR_ConvertSCSToInt(f_NR_CellInfo_GetSSB_SCS (nr_Cell6)),
                                                   f_NR_CellInfo_GetIsFDD(nr_Cell6),
                                                   f_NR_CellInfo_GetIsFR1(nr_Cell6),
                                                   f_NR_CellInfo_GetBandIndicator(nr_Cell6),
                                                   f_NR_CellInfo_GetChannelBandwidth(nr_Cell6)  //@sic R5-254995 sic@);
                                                   );
    }
    if (v_PrimaryNumberOfFreq >= 4) {
        v_CoOrd_NRSysInfo_List[3] := cs_CoOrd_SysInfoNR(f_NR_CellInfo_GetFrequencySSB (nr_Cell14),
                                                   f_NR_CellInfo_GetPhysicalCellId (nr_Cell14),
                                                   f_NR_ConvertSCSToInt(f_NR_CellInfo_GetSSB_SCS (nr_Cell14)),
                                                   f_NR_CellInfo_GetIsFDD(nr_Cell14),
                                                   f_NR_CellInfo_GetIsFR1(nr_Cell14),
                                                   f_NR_CellInfo_GetBandIndicator(nr_Cell14),
                                                   f_NR_CellInfo_GetChannelBandwidth(nr_Cell14)  //@sic R5-254995 sic@);
                                                   );
    }
    
    return cs_EUTRA_NR_CoOrdSysInfo_NR(v_CoOrd_NRSysInfo_List);
  }

  /*
   * @desc  return SIB5 content with E-UTRA frequency list included
   * @param     p_EUTRA_SysInfoList
   * @return    template (value) SIB5
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_InitSIB5( template (value)EUTRA_NR_CoOrd_SysInfo_Type p_EUTRA_SysInfoList) return template (value) SIB5
  {
    var template (value) CarrierFreqListEUTRA v_CarrierFreqListEUTRA;
    var integer i;
    
    for (i:=0; i<lengthof(p_EUTRA_SysInfoList.Eutra); i:=i+1){
        v_CarrierFreqListEUTRA[i] := cs_38508_CarrierFreqEUTRA(p_EUTRA_SysInfoList.Eutra[i].Arfcn);
        if (f_GetTestcaseAttrib_Qbased_Rsrq(testcasename())){
            v_CarrierFreqListEUTRA[i].threshX_Q := cs_38508_SIB5_ThreshX_Q;
        }
    }
    return cs_38508_SIB5_Def(v_CarrierFreqListEUTRA);
  }

  /*
   * @desc      Function used for converting an integer input value to a EUTRA_AllowedMeasBandwidth value.
   *            The function is used in NR test cases when the EUTRA type v_DL_PrimaryBandwidth needs
   *            to be converted in to the NR type EUTRA_AllowedMeasBandwidth.
   * @param     p_EUTRA_DL_Bandwidth
   * @return    EUTRA_AllowedMeasBandwidth
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_IRAT_ConvertIntegerToEUTRA_AllowedMeasBandwidth(integer p_EUTRA_DL_Bandwidth) return EUTRA_AllowedMeasBandwidth
  {
    var EUTRA_AllowedMeasBandwidth v_MeasurementBandwidth;   // defined in NR_RRC_ASN1_Definitions
    
    select  (p_EUTRA_DL_Bandwidth) {
      case (6) {                                          //1.4MHz
        v_MeasurementBandwidth := mbw6;
      }
      case (15) {                                         //3MHz
        v_MeasurementBandwidth := mbw15;
      }
      case (25) {                                         //5MHz
        v_MeasurementBandwidth := mbw25;
      }
      case (50) {                                         //10MHz
        v_MeasurementBandwidth := mbw50;
      }
      case (75) {                                         //15MHz
        v_MeasurementBandwidth := mbw75;
      }
      case (100) {                                        //20MHz
        v_MeasurementBandwidth := mbw100;
      }
      case else {
        FatalError(__FILE__,__LINE__, "invalid value for ChannelBandwidth");
      }
    }
    return v_MeasurementBandwidth;
  }

  /*
   * @desc      to send the list of EPS Bearer Ids to EUTRA (other parameters are ignored by LTE)
   *            the EPS Bearer IDs have been assigned to the UE in the PDU Session Establishment Accept
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_SendPduSessionInfoListToEUTRA() runs on NR5GC_PTC
  {
    var EUTRA_NR_PduSessionInfoList_Type v_CoordMsgList := {};
    var PDUSessionInfoList_Type v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList();
    var integer i;
    var template (value) QosFlow_Identification_Type v_QosFlow_Identification_Type;

      for (i := 0; i < lengthof(v_PDUSessionInfo); i := i + 1) {
        v_CoordMsgList[i].PDU_SessionId := oct2int(v_PDUSessionInfo[i].SessionId);
        v_CoordMsgList[i].EPS_Bearer := v_PDUSessionInfo[i].EPS_Bearer;
        v_QosFlow_Identification_Type := f_NR_GetQosFlowIdentification_ForDRBId (f_NR_GetDefaultDRB_InDRBList(f_NR_GetDRBList_ForGivenPDUSession(v_CoordMsgList[i].PDU_SessionId))); // @sic R5s210414 sic@
        v_CoordMsgList[i].QFI := valueof(v_QosFlow_Identification_Type.QFI);
        v_CoordMsgList[i].PdnType := v_PDUSessionInfo[i].PDUType;            // @sic R5-245495 sic@
        v_CoordMsgList[i].PdnIndex := v_PDUSessionInfo[i].PdnIndex;
        v_CoordMsgList[i].IsIMS := match (v_PDUSessionInfo[i].PDUType, IMS_DNN);
    }
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_PduSessionInfoList(v_CoordMsgList));
  }

  /*
   * @desc      Function for performing SS and UE configuration at InterRAT handover.
   *            The function implements steps 1-14 of 38.523-3 7.3.5.3.1:Sequence of intra-NR inter-cell handover
   *            Note: By default RACH-ConfigDedictaed is not included in RRCReconfiguration => PRACH CBRA procedure is applied
   * @param     p_TargetCellId
   * @param     p_PduSessionInfoList
   * @param     p_EUTRASecurityParams
   * @param     p_RNTI_Value        (default value: tsc_C_RNTI_Value3)
   * @param     p_RACH_ConfigDedicated (default value: omit)
   * @param     p_RRCConnReconfigComplete (default value: cr_38508_RRCReconfigurationComplete)
   * @param     p_RACHCnfFlag       (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_508RRC_InterRAT_HO_ToNR(NR_CellId_Type                       p_TargetCellId,
                                           EUTRA_NR_PduSessionInfoList_Type     p_PduSessionInfoList,
                                           EUTRA_NR_CoOrd_Security_Type         p_EUTRASecurityParams,
                                           RNTI_Value                           p_RNTI_Value :=  tsc_C_RNTI_Value3,
                                           template (omit) ReconfigurationWithSync.rach_ConfigDedicated p_RACH_ConfigDedicated := omit,
                                           template (present) UL_DCCH_Message   p_RRCConnReconfigComplete := cr_38508_RRCReconfigurationComplete,
                                           template (omit) boolean              p_RACHCnfFlag := omit
                                           ) runs on NR5GC_PTC
  { //@sic R5s221238: added p_RACHCnfFlag sic@
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_TargetCellId);
    var template (value) NR_RachProcedureConfig_Type v_RachProcedureConfig := cs_NR_RachProcedureConfig_CRNTI_HO(v_NR_PhysicalParameters, p_RNTI_Value); //CBRA
    var template (value) RRCReconfiguration v_RRCReconfiguration;
    var template (value) PDUSessionInfoList_Type v_SessionInfoList;
    var integer v_NoOfPduSessions := lengthof(p_PduSessionInfoList);
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) NR_RadioBearerList_Type v_RadioBearerList;  // list of DRBs to be configured at the SS (SRB2 alredy configured in SS at cell creation/RRC release procedure => not needed here)
    var template (value) SDAP_ConfigurationList_Type v_SDAP_ConfigurationList;
    var template (value) MasterKeyUpdate v_MasterKeyUpdate;
    var NextHopChainingCount v_NCC := tsc_NR_38508_NextHopChainingCount;
    var NG_NAS_SecurityParams_Type v_SecurityParams := f_NR5GC_Security_Get();
    var MessageAuthenticationCode v_CalculatedMac;
    var template (value) S1ToN1TransparentContainer v_NASContainer;
    var bitstring v_NASContainerString;
    var integer i;

    if (isvalue(p_RACH_ConfigDedicated.uplink)){ //CFRA
       v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_TargetCellId);
       v_RachProcedureConfig := cs_NR_RachProcedureConfig_CFRA(v_NR_PhysicalParameters);
    }
    
    v_NASContainer := cs_S1ToN1TransparentContainer (omit,
                                                     v_SecurityParams.NAS_Ciphering.Algorithm,
                                                     v_SecurityParams.NAS_Integrity.Algorithm,
                                                     int2bit(p_EUTRASecurityParams.NCC, 3),   // @sic R5s201078 sic@
                                                     tsc_NasKsi_MappedSecurityContext,
                                                     p_EUTRASecurityParams.KSI);              // @sic R5s201078 sic@

    v_NASContainerString := encvalue(valueof(v_NASContainer));
    v_CalculatedMac := fx_NG_NasIntegrityAlgorithm(bit2oct(v_NASContainerString),
                                                   v_SecurityParams.NAS_Integrity.Algorithm,
                                                   v_SecurityParams.NAS_Integrity.K_NAS,
                                                   'FFFFFFFF'O,  // according to 33.501 cl. 8.4.2
                                                   '00001'B,
                                                   tsc_DirectionDL);
                                                    
    v_NASContainer.mac := v_CalculatedMac;
    v_NASContainerString := encvalue(v_NASContainer);
    
    v_MasterKeyUpdate := cs_MasterKeyUpdate(true, v_NCC, bit2oct(v_NASContainerString));
    
    for (i := 0; i < v_NoOfPduSessions; i := i + 1) {
      v_SessionInfoList[i] := cs_GSM_MobilityInfo(int2oct(p_PduSessionInfoList[i].PDU_SessionId, 1), -, p_PduSessionInfoList[i].PdnType);  // @sic R5s240298, R5-245495 sic@
      f_NR5GC_MobileInfo_AddPDUSession(valueof(v_SessionInfoList[i]));
    }
        
    f_BuildRRCReconfigParamsNewDRBs (v_RadioBearerConfig,
                                     v_CellGroupConfig,
                                     v_RadioBearerList,
                                     v_SDAP_ConfigurationList,
                                     p_TargetCellId,
                                     valueof(v_SessionInfoList),
                                     NONE);
                                      
    v_RRCReconfiguration := f_NR5GC_RRCReconfiguration_InterRAT_HO(v_RadioBearerConfig,
                                                                   v_CellGroupConfig,
                                                                   -,
                                                                   v_MasterKeyUpdate);

    // Enable IP handling for each default DRB
    for (i := 0; i < v_NoOfPduSessions; i := i + 1) {
      f_IP_ChangeDrbMappingNR(IP, p_TargetCellId, cs_IP_QosFlowId(p_PduSessionInfoList[i].PDU_SessionId, p_PduSessionInfoList[i].QFI), p_PduSessionInfoList[i].PdnIndex);
    }

    f_NR5GC_508RRC_InterRAT_HO_ToNR_Common_Steps1_14(p_TargetCellId,
                                                     v_RadioBearerList,
                                                     p_RNTI_Value,
                                                     v_RRCReconfiguration,
                                                     v_RachProcedureConfig,
                                                     -,
                                                     p_RRCConnReconfigComplete, // @sic R5-216287 sic@
                                                     v_NCC,
                                                     p_RACH_ConfigDedicated,
                                                     p_RACHCnfFlag);
  }

  /*
   * @desc      Function for performing SS and UE configuration at InterRAT handover.
   *            The function implements step 2-12 of 38.523-3 cl. 7.3.5.3.1 with
   *             1. configure C-RNTI based contention resolution in SS with minimal grant
   *                i.e. the UE will have to raise SR to send additional/user data.
   *             2. activate security at target cell according to 36.508 cl. 4.6.4 Table 4.6.4-1
   *                with keyChangeIndicator set to FALSE and nextHopChainingCount set to 0
   *             3. send the RRCReconfiguration to EUTRA.
   *             4. receive RRCReconfigurationComplete
   * @param     p_TargetCellId
   * @param     p_RadioBearerList
   * @param     p_RNTI_Value        (default value: tsc_C_RNTI_Value3)
   * @param     p_RRCReconfiguration
   * @param     p_RachProcedureConfig
   * @param     p_UL_GrantConfig_TargetCell (default value: cs_UL_GrantConfig_OnSR)
   * @param     p_RRCConnReconfigComplete (default value: cr_38508_RRCReconfigurationComplete)
   * @param     p_NCC               (default value: tsc_NR_38508_NextHopChainingCount)
   * @param     p_RACH_ConfigDedicated (default value: omit)
   * @param     p_RACHCnfFlag       (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_508RRC_InterRAT_HO_ToNR_Common_Steps1_14(NR_CellId_Type                                 p_TargetCellId,
                                                            template( value) NR_RadioBearerList_Type       p_RadioBearerList,
                                                            RNTI_Value                                     p_RNTI_Value :=  tsc_C_RNTI_Value3,
                                                            template (value) RRCReconfiguration            p_RRCReconfiguration,
                                                            template (value) NR_RachProcedureConfig_Type   p_RachProcedureConfig,
                                                            template (value) UL_GrantConfig_Type           p_UL_GrantConfig_TargetCell := cs_UL_GrantConfig_OnSR,
                                                            template (present) UL_DCCH_Message             p_RRCConnReconfigComplete := cr_38508_RRCReconfigurationComplete,
                                                            NextHopChainingCount                           p_NCC := tsc_NR_38508_NextHopChainingCount,
                                                            template (omit) ReconfigurationWithSync.rach_ConfigDedicated p_RACH_ConfigDedicated := omit,
                                                            template (omit) boolean                        p_RACHCnfFlag := omit
                                                             )
    runs on NR_BASE_PTC
  { //@sic R5s221238: added p_RACHCnfFlag sic@
    var octetstring v_EncodedRRCReconfig;
   
    // Step 1: Target Cell: Configuration of DRBs
    f_NR_SS_CommonRadioBearerConfig(p_TargetCellId, p_RadioBearerList);

    // Step 2: void
    // Don't need this step as 1st time on NR, so all counts start from 0
    //f_NR_SS_PdcpCount_Handover(p_SourceCellId, p_TargetCellId, p_RadioBearerList, p_RBConfig_KeyChange);
    
    // Step 3: void
    //f_NR_SS_PdcpHandoverCtrl(p_TargetCellId, cas_NR_PdcpHandoverInit_REQ(p_SourceCellId, p_TargetCellId));
    
    // Step 4: Target Cell: Configure RACH procedure either dedicated or C-RNTI based.
    // Save new C-RNTI in cell configuration for p_TargetCellId
    f_NR_CellInfo_SetRNTI(p_TargetCellId, p_RNTI_Value);
    f_NR_SS_C_RNTI_Config(p_TargetCellId, p_RNTI_Value);
    f_NR_SS_RachProcedureConfigHO(p_TargetCellId, p_RachProcedureConfig, -, p_RACH_ConfigDedicated);
    
    //Step 5: Target Cell:  Activate security.
    f_NR_SS_AS_ActivateSecurity_Current(p_TargetCellId, p_NCC);
    
    // Step 6: Void
    
    // Step 7:  void
    
    // Step 8: Target Cell: Configure UL grant configuration ("OnSR", periodic TA is not started).
    f_NR_ULGrantConfiguration_Common(p_TargetCellId, cs_TimingInfo_Now, -, -, p_UL_GrantConfig_TargetCell);
    
    // Step 9: Send RRCReconfiguration to EUTRA
    v_EncodedRRCReconfig := bit2oct(encvalue(p_RRCReconfiguration));
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (v_EncodedRRCReconfig, "HO Cmd"));
    
    // Step 10: Target Cell:    Receive RRCReconfigurationComplete
    SRB.receive(car_NR_SRB1_RrcPdu_IND(p_TargetCellId, p_RRCConnReconfigComplete));
    
    // Step 11: Target Cell:    Start periodic TA
    f_NR_ULGrantConfiguration_Common(p_TargetCellId, cs_TimingInfo_Now, -, cs_NR_UplinkTimeAlignment_Start, -);
    
    // Step 12: void
    
    // Step 13: Target Cell:    Re-configure RACH procedure as for initial access.
    // p_RACHCnfFlag may be set to false when an UL message is expected in the test sequence just after this function
    f_NR_SS_RachProcedureConfig_Def(p_TargetCellId,-, p_RACHCnfFlag);  //@sic R5s221238 sic@
        
    // Step 14: Target Cell:    Configure measurement gap (if configured in the source cell or as provided in the RRCReconfiguration message)
    /*if (isvalue(p_MeasConfig.measGapConfig) or              // MeasGap provided to UE in RRCReconfiguration
        (not(isvalue(p_MeasConfig.measGapConfig)) and not(match(f_NR_CellInfo_GetMeasGapCtrl(p_SourceCellId), cs_NR_MeasGapCtrl_None)))  //Or MeasGap started in the source cell => to be continued in the target cell
        ) {
        f_NR_SS_MeasGapCtrlConfig(p_TargetCellId, cs_NR_MeasGapCtrl_Config(p_MeasConfig.measGapConfig),cs_TimingInfo_Now);
    }*/
  }

  /*
   * @desc      Function to generate RRCConnectionReconfiguration to be used for interRAT HO to NR
   * @param     p_RadioBearerConfig
   * @param     p_CellGroupConfig
   * @param     p_MeasConfig        (default value: omit)
   * @param     p_MasterKeyUpdate   (default value: omit)
   * @return    template (value) RRCReconfiguration
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_RRCReconfiguration_InterRAT_HO(template (value) RadioBearerConfig            p_RadioBearerConfig,
                                                  template (value) CellGroupConfig              p_CellGroupConfig,
                                                  template (omit) MeasConfig                    p_MeasConfig := omit,
                                                  template (omit) MasterKeyUpdate               p_MasterKeyUpdate := omit)
    return template (value) RRCReconfiguration
  {
    var template (value) RRCReconfiguration v_RRCReconfiguration;
    var template (value) RRCReconfiguration_v1530_IEs v_RRCReconfiguration_v1530;

    v_RRCReconfiguration_v1530 := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(p_CellGroupConfig)),
                                                                     p_MasterKeyUpdate,
                                                                     -, -, -, -,
                                                                     true_);
    
    v_RRCReconfiguration := cs_38508_RRCReconfigurationIE(tsc_NR_RRC_TI_Def, p_RadioBearerConfig, omit, p_MeasConfig, v_RRCReconfiguration_v1530);
    return v_RRCReconfiguration;
  }

}
