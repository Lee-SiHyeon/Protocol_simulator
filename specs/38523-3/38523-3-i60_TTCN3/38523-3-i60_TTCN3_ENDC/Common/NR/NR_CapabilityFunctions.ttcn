        }
    }
    
    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.aerialParameters_r18)) {  // AerialParameters-r18
        if (pc_aerialUE_Capability_r18 or pc_altitudeMeas_r18 or pc_eventAxHy_r18) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling AerialParameters-r18, no PICS shall be set in a branch when parent is not present");
        }
    }

  }; //end of fl_Check_PICSinOptionalGroups_NR_r18

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of drx-Adaptation-r16 along with fr1-Add-UE-NR-Capabilities-v1610 and fr2-Add-UE-NR-Capabilities-v1610 for Rel-16 (and on) UEs.
                Note 19 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg_v1610
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_drx_Adaptation_r16(UE_NR_Capability_v1610 p_ReceivedCapabilityMsg_v1610)
  {
    var boolean v_UE_NR_Capability_v1610_drx_Adaptation_r16 := false;
    var boolean v_FR1_Add_UE_NR_Capabilities_v1610 := false;
    var boolean v_FR2_Add_UE_NR_Capabilities_v1610 := false;
    var UE_NR_Capability_v1610 v_ReceivedCapabilityMsg_v1610 := p_ReceivedCapabilityMsg_v1610;
    var MAC_ParametersFRX_Diff_r16 v_Mac_Parameters_v1610_Common;
    var MAC_ParametersFRX_Diff_r16 v_FR1_Add_UE_NR_Cap_drx_Adaptation_r16;
    var MAC_ParametersFRX_Diff_r16 v_FR2_Add_UE_NR_Cap_drx_Adaptation_r16;

    if (ispresent(v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16)) { //case common IE UE_NR_Capability_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16
      v_Mac_Parameters_v1610_Common := v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16;
    }
    if (ispresent(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16)) { //case fr1
      v_FR1_Add_UE_NR_Cap_drx_Adaptation_r16 := v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16;
    }
    if (ispresent(v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16)) { //case fr2
      v_FR2_Add_UE_NR_Cap_drx_Adaptation_r16 := v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16;
    }

    if(pc_DRX_Adaptation) {
      // check indication of UE_NR_Capability_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16
      if ((ispresent(v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16)) or (ispresent(v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16))) {
          v_UE_NR_Capability_v1610_drx_Adaptation_r16 := true;
      }
      // check indication of FR1 IE
      if ((ispresent(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16)) or (ispresent(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16))) {
          v_FR1_Add_UE_NR_Capabilities_v1610 := true;
      }
      // check indication of FR2 IE
      if ((ispresent(v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16)) or (ispresent(v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16))) {
          v_FR2_Add_UE_NR_Capabilities_v1610 := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_UE_NR_Capability_v1610_drx_Adaptation_r16, v_FR1_Add_UE_NR_Capabilities_v1610, v_FR2_Add_UE_NR_Capabilities_v1610)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for mac_ParametersFRX_Diff_r16.drx_Adaptation_r16 but pc_DRX_Adaptation is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_DRX_Adaptation to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_UE_NR_Capability_v1610_drx_Adaptation_r16) or v_FR1_Add_UE_NR_Capabilities_v1610 or v_FR2_Add_UE_NR_Capabilities_v1610)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_DRX_Adaptation on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //UE in FR1&FR2 case
      {
          if (not v_UE_NR_Capability_v1610_drx_Adaptation_r16)
          { //@sic R5-244254 R5-244262 R5-244263 sic@
             if ((v_FR1_Add_UE_NR_Capabilities_v1610 and v_FR2_Add_UE_NR_Capabilities_v1610) and match(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16, v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16) and match(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16, v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16)) // fail case: both FR1 and FR2 capabilities are reported and no IE in mac_Parameters_v1610
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
              if  (v_FR1_Add_UE_NR_Capabilities_v1610 or v_FR2_Add_UE_NR_Capabilities_v1610)  // fail cases: if IE in mac_Parameters_v1610 is reported but FR1 and/or FR2 capabilities are also reported
              {
                 f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
              }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if ((ispresent(v_Mac_Parameters_v1610_Common.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16) or (ispresent(v_Mac_Parameters_v1610_Common.drx_Adaptation_r16.sharedSpectrumChAccess_r16))) or
              (ispresent(v_FR1_Add_UE_NR_Cap_drx_Adaptation_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16) or (ispresent(v_FR1_Add_UE_NR_Cap_drx_Adaptation_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16))) or (ispresent(v_FR2_Add_UE_NR_Cap_drx_Adaptation_r16.drx_Adaptation_r16.non_SharedSpectrumChAccess_r16) or (ispresent(v_FR2_Add_UE_NR_Cap_drx_Adaptation_r16.drx_Adaptation_r16.sharedSpectrumChAccess_r16)))) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_DRX_Adaptation to false is inconsistent with reported capabilities for a Rel-16 and above UE");
          }
    }
  }

