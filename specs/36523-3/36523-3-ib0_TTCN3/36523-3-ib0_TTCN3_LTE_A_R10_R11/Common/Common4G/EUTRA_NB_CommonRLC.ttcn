  template (value) RLC_SDU_Type   cs_MBMS_Packet18   := f_GetN_OctetsFromPRBS(170,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet19   := f_GetN_OctetsFromPRBS(180,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDU_Type   cs_MBMS_Packet20   := f_GetN_OctetsFromPRBS(190,tsc_MBMS_PacSize);  /* @status    APPROVED (LTE_A_R10_R11) */

  template (value) RLC_SDUList_Type cs_MBMSPacketList := { /* @status    APPROVED (LTE_A_R10_R11) */
    cs_MBMS_Packet1,cs_MBMS_Packet2,cs_MBMS_Packet3,cs_MBMS_Packet4,cs_MBMS_Packet5,
    cs_MBMS_Packet6,cs_MBMS_Packet7,cs_MBMS_Packet8,cs_MBMS_Packet9,cs_MBMS_Packet10,
    cs_MBMS_Packet11,cs_MBMS_Packet12,cs_MBMS_Packet13,cs_MBMS_Packet14,cs_MBMS_Packet15,
    cs_MBMS_Packet16,cs_MBMS_Packet17,cs_MBMS_Packet18,cs_MBMS_Packet19,cs_MBMS_Packet20
