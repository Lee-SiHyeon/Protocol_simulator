module NAS_Security {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_Component all;
  import from EUTRA_NB_SecurityFunctions all;
  import from EUTRA_NasSecurityProcedures all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.4.1
   * @status    APPROVED (LTE)
   */
   //@sic R5s170124 sic@
  function f_TC_9_4_1_EUTRA() runs on EUTRA_PTC
  { //@desc Integrity protection: Correct functionality of EPS NAS integrity algorithm (SNOW3G)
    f_TC_9_4_x_Common (tsc_EPS_Encryption_Snow3G, true);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.4.2
   * @status    APPROVED (LTE)
   */
 //@sic R5s170124 sic@
  function f_TC_9_4_2_EUTRA() runs on EUTRA_PTC
  { //@desc Integrity protection: Correct functionality of EPS NAS integrity algorithm (AES)
    f_TC_9_4_x_Common (tsc_EPS_Integerity_AES, true);
    
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.4.3
   * @status    APPROVED (LTE)
   */
   //@sic R5s170124 sic@
   function f_TC_9_4_3_EUTRA() runs on EUTRA_PTC
  { //@desc Ciphering and Deciphering: Correct functionality of EPS NAS encryption algorithm (SNOW3G)
    f_TC_9_4_x_Common (tsc_EPS_Encryption_Snow3G, false);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.4.4
   * @status    APPROVED (LTE)
   */
  function f_TC_9_4_4_EUTRA() runs on EUTRA_PTC
  { //@sic R5s170124 sic@
    //@desc Ciphering and Deciphering: Correct functionality of EPS NAS encryption algorithm (AES)
    f_TC_9_4_x_Common(tsc_EPS_Encryption_Snow3G, false);
  }

}
