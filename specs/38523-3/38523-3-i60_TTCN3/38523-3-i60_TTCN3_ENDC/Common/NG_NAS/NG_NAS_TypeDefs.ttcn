  type union SOR_Header {                               // Jun24 @sic R5s240531 Baseline Moving sic@
    SOR_HeaderType0     dataType0,
    SOR_HeaderType1     dataType1
  }
  type record SOR_HeaderType1 {
    B4_Type                     spare,                  /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     msSSNPNSILS,            // Jun24 @sic R5s240531 Baseline Moving sic@
