  };

  template (value) MeasObjectToAddModList_v9e0 cs_MeasObjectToAddModList_v9e0_1Entry (ARFCN_ValueEUTRA_v9e0 p_ARFCN_ValueEUTRA_v9e0) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
