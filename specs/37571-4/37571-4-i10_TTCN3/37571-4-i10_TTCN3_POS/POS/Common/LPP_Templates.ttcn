  template (value) LPP_Message cs_LppReqCap (TransactionNumber p_TransactionNumber,
                                             template (omit) SequenceNumber p_SeqNum := omit,
                                             template (omit) Acknowledgement p_Ack := omit,
                                             template (omit) EPDU_Sequence p_EpduReqCap := omit):=
  { /* @status    APPROVED (POS) */
    transactionID := cs_TransId(locationServer, p_TransactionNumber),
    endTransaction := false,
    sequenceNumber := p_SeqNum,
    acknowledgement := p_Ack,
    lpp_MessageBody := {
      c1 := {
        requestCapabilities := {
          criticalExtensions := {
            c1 := {
              requestCapabilities_r9 := {
                commonIEsRequestCapabilities := {
                  lpp_message_segmentation_req_r14 := tsc_NoLPP_Segmentation, //@sic R5-18169 sic@
                  remoteUE_IndicationReq_r18 := omit  /* @sic R5s240532 BASELINE MOVING Rel-18 sic@ */
                },
                a_gnss_RequestCapabilities := {
                  gnss_SupportListReq := true,
                  assistanceDataSupportListReq := true,
                  locationVelocityTypesReq := true
                },
                otdoa_RequestCapabilities := {},
                ecid_RequestCapabilities := {},
                epdu_RequestCapabilities := p_EpduReqCap,
                sensor_RequestCapabilities_r13 := {}, /* @sic R5s160713 BASELINE MOVING 2016, R5-165996: iPOS inclusion sic@ */
                tbs_RequestCapabilities_r13 := {}, /* @sic R5s160713 BASELINE MOVING 2016, R5-165996: iPOS inclusion sic@ */
                wlan_RequestCapabilities_r13 := {}, /* @sic R5s160713 BASELINE MOVING 2016, R5-165996: iPOS inclusion sic@ */
                bt_RequestCapabilities_r13  := {}, /* @sic R5s160713 BASELINE MOVING 2016, R5-165996: iPOS inclusion sic@ */
                nr_ECID_RequestCapabilities_r16 := {}, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_Multi_RTT_RequestCapabilities_r16 := {}, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_DL_AoD_RequestCapabilities_r16 := {}, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_DL_TDOA_RequestCapabilities_r16 := {}, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_UL_RequestCapabilities_r16 := {} /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
              }
            }
          }
        }
      }
    }
  };

  template (value) LPP_Message cs_LppRequestCapabilities (TransactionNumber p_TransactionNumber) := cs_LppReqCap (p_TransactionNumber);                           /* @status    APPROVED (POS) */

  template (value) LPP_Message cs_LppRequestCapabilities_ePDU(TransactionNumber p_TransactionNumber,
