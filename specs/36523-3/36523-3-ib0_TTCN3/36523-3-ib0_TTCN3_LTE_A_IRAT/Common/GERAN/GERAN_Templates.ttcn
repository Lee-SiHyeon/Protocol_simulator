  const B4_Type               tsc_SkipIndicator := '0000'B;                     /* Skip Indicator field consists of latter half byte after Protocol discriminator field. Its value is '0000'B in all the messages.
                                                                                   @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const ProtocolDiscriminator tsc_PD_RR := '0110'B;                             /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const MessageType           tsc_MT_ImmediateAssignment := '00111111'B;        /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const MessageType           tsc_MT_CipheringModeCommand := '00110101'B;       /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const MessageType           tsc_MT_CipheringModeComplete := '00110010'B;      /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B3_Type               tsc_DefUSF := '000'B;                  /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_CS1 := 1;                          /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B1_Type               tsc_LLC_PM := '1'B;                    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B1_Type               tsc_LLC_NoCiph := '0'B;                /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_LLCSapi_GMM := 1;                  /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_LLCSapi_11 := 11;                  /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_SAPI_0 := 0;                       /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_NormalPaging := 0;                 /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B5_Type               tsc_DownlinkTFI := '00001'B;           /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B5_Type               tsc_UplinkTFI := '00000'B;             /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const PhysicalChId          tsc_PhyCh0 := 0;                       /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const PhysicalChId          tsc_PhyCh1 := 1;                       /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const PhysicalChId          tsc_TchCh := 2;                        /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B1_Type               tsc_RR_HopOff := '0'B;                 /* hopping off; @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const B8_Type               tsc_SignallingOnly := '00000000'B;     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const O4_Type               tsc_TLLI_Initial := 'FFFFFFFF'O;       /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const TN                    tsc_TN0 := '000'B;                     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const TN                    tsc_TN1 := '011'B;                     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_Power_ueVOffset := 113;            /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const integer               tsc_GERAN_ChPwrLvl_Off := -123;        /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_BCCH := 0;                         /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_RACH := 1;                         /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_PCH :=  2;                         /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_AGCH := 3;                         /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_SACCH_C4 := 5;                     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_FACCH_F := 9;                      /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_SACCH_TF := 10;                    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

  const G_LogicChType         tsc_PACCH_F := 19;                     /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */

