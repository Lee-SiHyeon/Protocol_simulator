module NR_PDCP_Common {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from L2_Common4G5G all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_L2_Common all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_SecuritySteps all;

  const B3_Type tsc_NR_PDU_Type_StatusRep := '000'B;      /* @status    APPROVED (ENDC, NR5GC) */

  type record NR_PDCP_SS_State_Type {              /* @status    APPROVED (ENDC, NR5GC)  * PDCP state variables, see 38.323 cl. 7.1 */
    NR_PDCP_SN_Size_Type       PDCP_SN_Size,       /* UL PDCP SDU size */
    integer                    TX_NEXT,            /* This state variable indicates the COUNT value of the next PDCP SDU */
    integer                    RX_NEXT,            /* This state variable indicates the COUNT value of the next PDCP SDU expected to be received */
    integer                    Maximum_PDCP_SN,    /* This state variable indicates  maximum value of the COUNT */
    DRB_Identity               DRB_Id,             /* Data Radio Bearer*/
    B128_Key_Type              KUPenc             /* This state variable indicates ciphering key for the user plane */
 };

  template (value) RadioBearerConfig cs_NR_RbReestPDCP( template (omit) PDCP_Config p_PDCP_Config := omit,
                                                       template (omit) SecurityConfig p_SecurityConfig := omit) :=
     /* @status    APPROVED (ENDC) */
    cs_38508_RadioBearerConfigDef(-, {cs_NR_DRB_ToAddMod_ReestPDCP(tsc_NR_DRB2, p_PDCP_Config)}, -, p_SecurityConfig);

  template (value) RadioBearerConfig cs_NR_RbRecoverPDCP(NR_KeyToUse_Type p_KeyToUse,
                                                       template (omit) PDCP_Config p_PDCP_Config) :=
    /* @status    APPROVED (ENDC) */
    cs_38508_RadioBearerConfigDef(-, {cs_NR_DRB_ToAddMod_RecoverPDCP(tsc_NR_DRB2, p_PDCP_Config)}, -, cs_38508_SecurityConfig(omit, p_KeyToUse));

  template (value) PDCP_Config cs_38508_NR_PDCP_Config(template (omit) NR_PDCP_DRB_Type p_DRB := omit,
                                                       template (omit) NR_MoreThanOneRLC_Type p_MoreThanOneRLC := omit,
                                                       template (omit) NR_PDCP_T_Reordering_Type p_T_Reordering := omit,
                                                       template (omit) NR_PDCP_CipheringDisabled_Type p_CipheringDisabled := omit):=
   /* @status    APPROVED (ENDC, NR5GC) */
   //As per 38.508-1 Table 4.6.3-99: PDCP-Config
   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
   cs_PDCP_Config_Def(p_DRB, p_MoreThanOneRLC, p_T_Reordering, p_CipheringDisabled);

  template (value) PDCP_Config cs_NR_PDCP_Config_UlPath(NR_PDCP_DiscardTimer_Type p_DiscardTimer,
                                                        NR_PDCP_SN_UL_Type p_SN_UL,
                                                        NR_PDCP_SN_DL_Type p_SN_DL,
                                                        CellGroupId p_CellGroup := tsc_NR_CellGroupId_SCG,
                                                        UL_DataSplitThreshold p_UlDataSplitThreshold := infinity_,
                                                        template (omit) NR_PDCP_CipheringDisabled_Type p_CipheringDisabled := omit, //@sic R5s200701 sic@
                                                        boolean p_Pdcp_Duplication := false,
                                                        DRB_Identity p_DRB_default := tsc_NR_DRB2) := //@sic R5s210888 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_38508_NR_PDCP_Config (cs_38508_PDCP_Config_DRB(p_DiscardTimer, p_SN_UL, p_SN_DL),
                             cs_NR_PDCP_MoreThanOneRLC(cs_NR_PDCP_PrimaryPath(p_CellGroup, f_NR_LogicalChannelId_DRB(p_DRB_default)), p_UlDataSplitThreshold, p_Pdcp_Duplication),
                             -,
                             p_CipheringDisabled);

   template (value) PDCP_Config cs_NR_PDCP_Config_UlPathOnEUTRA(NR_PDCP_DiscardTimer_Type p_DiscardTimer,
                                                        NR_PDCP_SN_UL_Type p_SN_UL,
                                                        NR_PDCP_SN_DL_Type p_SN_DL,
                                                        CellGroupId p_CellGroup := tsc_NR_CellGroupId_SCG,
                                                        UL_DataSplitThreshold p_UlDataSplitThreshold := infinity_,
                                                        template (omit) NR_PDCP_CipheringDisabled_Type p_CipheringDisabled := omit, //@sic R5s200701 sic@
                                                        boolean p_Pdcp_Duplication := false,
                                                        integer p_DRB_SCG := 2) :=
    /* @status    APPROVED (ENDC) */
   // Logical channel Id on EUTRA is DRB + 2.  This is different to on NR
    cs_38508_NR_PDCP_Config (cs_38508_PDCP_Config_DRB(p_DiscardTimer, p_SN_UL, p_SN_DL),
                             cs_NR_PDCP_MoreThanOneRLC(cs_NR_PDCP_PrimaryPath(p_CellGroup, (p_DRB_SCG+2)), p_UlDataSplitThreshold, p_Pdcp_Duplication),
                             -,
                             p_CipheringDisabled);

  template (value) PDCP_Config cs_NR_PDCP_Config_Split_moreThan1RLC(CellGroupId p_CellGroup := tsc_NR_CellGroupId_SCG) :=
    /* @status    APPROVED (ENDC) */
    cs_38508_NR_PDCP_Config (omit,
                             cs_NR_PDCP_MoreThanOneRLC(cs_NR_PDCP_PrimaryPath(p_CellGroup)));

  template (present) NR_PDCP_PDU_Type cr_NR_PDCP_STATUS_REPORT (integer p_PDCP_FMC, template octetstring p_Bitmap:= omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    CtrlPduStatus := {
      D_C                := tsc_NR_PDCP_D_C_Ctrl,
      PDU_Type           := tsc_NR_PDU_Type_StatusRep,
      Reserved           := tsc_B4_Reserved,
      FirstMissingCount  := int2bit(p_PDCP_FMC, 32),
      Bitmap             := p_Bitmap
    }
  };

 template (value) NR_RLC_TestModeConfig_Type cs_NR_RLC_TestModeConfig_NotAcK :=
  { /* @status    APPROVED (ENDC, NR5GC) */
   Info:={
         NotACK_NextRLC_PDU := Start
    }
  };

  template (value) NR_PDCP_PDU_Type cs_NR_PDCP_STATUS_REPORT (integer p_PDCP_FMC) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    CtrlPduStatus := {
      D_C                := tsc_NR_PDCP_D_C_Ctrl,
      PDU_Type           := tsc_NR_PDU_Type_StatusRep,
      Reserved           := tsc_B4_Reserved,
      FirstMissingCount  := int2bit(p_PDCP_FMC, 32),
      Bitmap             := omit
    }
  };

  template (value) NR_MAC_ControlElementDL_Type cs_NR_MAC_DuplicationActDeact(B8_Type p_DrbActDeact :='00000000'B ) :={
    /* @status    APPROVED (ENDC) */
    DuplicationActDeact := p_DrbActDeact
  };

  /*
   * @desc       Toggle Integrity Algorithm
   * @return    IntegrityProtAlgorithm
   * @status    APPROVED (ENDC)
   */
  function fl_NR_ToogleIntegrityAlgorithm() runs on NR_BASE_PTC  return IntegrityProtAlgorithm
  {
      var NR_SecurityParams_Type v_SecurityParams := f_NR_Security_Get();
      var IntegrityProtAlgorithm v_IntegrityAlg;

      select(v_SecurityParams.AS_Integrity.Algorithm)
      {
        case(nia0){v_IntegrityAlg := nia1;}
        case(nia1){v_IntegrityAlg := nia2;}
        case(nia2){v_IntegrityAlg := nia3;}
        case(nia3){v_IntegrityAlg := nia1;}
        case else{ FatalError (__FILE__, __LINE__, "Non defined AS Integrity algorithm Selected");}
      }
      return v_IntegrityAlg;
  }

  /* @desc     Configuring SS to use a different Integrity algorithm than already configured, so as to trigger
   *            MAC-I failure at UE
   * @param     p_NR_CellId
   * @param     p_RadioBearerId     (default value: tsc_NR_RbId_SRB3)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC)
   */
  function f_NR_SS_TriggerMAC_I_Failure(NR_CellId_Type p_NR_CellId,
                                        NR_RadioBearerId_Type p_RadioBearerId:= tsc_NR_RbId_SRB3,
                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
    var NR_SecurityParams_Type v_SecurityParams := f_NR_Security_Get();
  
    // Toggle the Integrity Algorithm
    v_SecurityParams.AS_Integrity.Algorithm := fl_NR_ToogleIntegrityAlgorithm();
    // Read PDCP SQN for SRB and calculate Integrity Activation times
    v_SecurityParams.AS_Integrity.ActTimeList := f_NR_RRC_GetActTime_SingleRB(p_NR_CellId, p_RadioBearerId); // Default value for p_SRB_ID = tsc_SRB3
    
    f_NR_SS_AS_SecurityConfig(p_NR_CellId, cs_NR_AS_SecurityStart_REQ(p_NR_CellId, cs_NR_AS_IntProtActivate( v_SecurityParams.AS_Integrity ), p_TimingInfo));
  }

  /*
   * @desc  Send RRC Reconfiguration message
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_RadioBearerConfig
   * @param     p_WaitRRCReconfCmpl (default value: true)
   * @status    APPROVED (ENDC)
   */
  function f_NR_PDCP_SendRRCReconfiguration(NR_CellId_Type p_NR_CellId,
                                            template (value) TimingInfo_Type p_TimingInfo:= cs_TimingInfo_Now,
                                            template (value) RadioBearerConfig  p_RadioBearerConfig,
                                            boolean p_WaitRRCReconfCmpl := true ) runs on NR_BASE_PTC
  {
     SRB.send(cas_NR_SRB3_RrcPdu_REQ(p_NR_CellId, p_TimingInfo, cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, p_RadioBearerConfig)));
     if(p_WaitRRCReconfCmpl){
       SRB.receive(car_NR_SRB3_RrcPdu_IND(p_NR_CellId, cr_38508_RRCReconfigurationComplete));
     }
  }

}
