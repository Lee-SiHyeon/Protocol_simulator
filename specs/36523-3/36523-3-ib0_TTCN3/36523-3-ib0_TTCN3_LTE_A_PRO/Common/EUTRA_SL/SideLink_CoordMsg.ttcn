module SideLink_CoordMsg {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NB_CommonDefs all;
  import from ProSe_Sidelink_CoordMsg_Common all;
  import from SideLinkUE_ASP_TypeDefs all;

  type union SideLink_Coordination_MSG { /* @status    APPROVED (LTE_A_PRO) */
    Null_Type                           TriggerEvent,
    InCoverageInfo_Type                 InCoverageInfo,
    OutOfCoverageInfo_Type              OutOfCoverageInfo,
    PDCP_SecurityInfo_Type              PDCP_SecurityInfo,
    MatchParam_List_Type                MatchParam_List,
    integer                             EUTRA_Timing //@sic R5-185111 sic@
  };

  type record InCoverageInfo_Type { /* @status    APPROVED (LTE_A_PRO) */
    CellInCoverageInfo_Type CellInCoverageInfo,
    DiscoveryInfo_Type      DiscoveryInfo optional
  };

  type record CellInCoverageInfo_Type { //@sic R5w160202 sic@
    /* @status    APPROVED (LTE_A_PRO) */
    ARFCN_ValueEUTRA_r9     UL_CarrierFreq,
    Ul_Bandwidth_Type       UL_Bandwidth,
    TDD_Config              TDD_Config optional,  /* omitted for FDD */
    CellTimingInfo_Type     CellTimingInfo
  }

  type record OutOfCoverageInfo_Type { /* @status    APPROVED (LTE_A_PRO) */
    ARFCN_ValueEUTRA_r9     CarrierFreq_r12,
    Ul_Bandwidth_Type       Ul_Bandwidth,
    EUTRA_FDD_TDD_Mode_Type EUTRA_FDD_TDD_Mode
  };

  type record DiscoveryInfo_Type { /* @status    APPROVED (LTE_A_PRO) */
    B184_Type  ProSeApplicationCode,
    B184_Type  ProSeApplicationCodeWrong optional
  };

  type record PDCP_SecurityInfo_Type { /* @status    APPROVED (LTE_A_PRO) */
    SL_Security_Type SL_SecurityInfo
  };

  type port SIDELINK_CO_ORD_PORT message
  { /* @status    APPROVED (LTE_A_PRO) */
    out SideLink_Coordination_MSG;
    in  SideLink_Coordination_MSG;
  };

  template (value) SideLink_Coordination_MSG cms_SideLink_Trigger  :=
  { /* @status    APPROVED (LTE_A_PRO) */
    TriggerEvent := true
  };

  template (present) SideLink_Coordination_MSG cmr_SideLink_Trigger :=
  { /* @status    APPROVED (LTE_A_PRO) */
    TriggerEvent := true
  };

  template (value) SideLink_Coordination_MSG cms_SideLink_OutOfCoverageInfo(integer p_ARFCN,
                                                                            Ul_Bandwidth_Type p_Ul_Bandwidth,
                                                                            EUTRA_FDD_TDD_Mode_Type p_EUTRA_FDD_TDD_Mode) :=  //Applied to communication
  { /* @status    APPROVED (LTE_A_PRO) */
    OutOfCoverageInfo := {
        CarrierFreq_r12 := p_ARFCN,
        Ul_Bandwidth := p_Ul_Bandwidth,
        EUTRA_FDD_TDD_Mode := p_EUTRA_FDD_TDD_Mode
    }
  };

  template (present) SideLink_Coordination_MSG cmr_SideLink_OutOfCoverageInfo :=
  { /* @status    APPROVED (LTE_A_PRO) */
    OutOfCoverageInfo := ?
  };

  /*
   * @desc      Wait for a coordination message
   * @param     p_Port
   * @param     p_ExpectedCoordMsg  (default value: cmr_SideLink_Trigger)
   * @return    SideLink_Coordination_MSG
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_WaitForCoordMsg(SIDELINK_CO_ORD_PORT p_Port,
                                      template (present) SideLink_Coordination_MSG p_ExpectedCoordMsg := cmr_SideLink_Trigger)
    return SideLink_Coordination_MSG
  {
    var SideLink_Coordination_MSG v_ReceivedCoordMsg;
    p_Port.receive(p_ExpectedCoordMsg) -> value v_ReceivedCoordMsg;
    return v_ReceivedCoordMsg;
  }

  /*
   * @desc      Send a coordination message
   * @param     p_Port
   * @param     p_CoordMsg          (default value: cms_SideLink_Trigger)
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_SendCoordMsg(SIDELINK_CO_ORD_PORT p_Port,
                                   template (value) SideLink_Coordination_MSG p_CoordMsg := cms_SideLink_Trigger)
  {
    p_Port.send(p_CoordMsg);
  }

  /*
   * @desc     Send and then wait for a coordination message
   * @param     p_Port
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SideLink_SynchronisePTC(SIDELINK_CO_ORD_PORT p_Port)
  {
    f_SideLink_SendCoordMsg(p_Port);
    f_SideLink_WaitForCoordMsg(p_Port);
  }

}
