module IMS_XCAP_Simserv {

  import from CommonDefs all;
  import from HTTP_XCAP_CoordMsg all;
  import from IMS_CC_Component all;
  import from IMS_CC_Parameters all;
  import from IMS_Component all;
  import from IMS_XCAP_Procedures all;
  import from UpperTesterFunctions all;
  import from XSD all;
  import from http_uri_etsi_org_ngn_params_xml_simservs_xcap language "XSD" all;
  import from urn_ietf_params_xml_ns_common_policy language "XSD" all;
  import from urn_oma_xml_xdm_common_policy language "XSD" all;

  type Simservs.absService_list Simservs_ServiceList_Type; /* @status    APPROVED (IMS)
                                                              @sic R5s140975 change 1.2 sic@
                                                              @sic R5w230106, R5s230374: encoding rule removed sic@ */

  const charstring tsc_XCAP_RuleId_Def := "rule1";  /* @status    APPROVED (IMS) */

  type record SupplementaryServiceInfo_Rule_Type
  { /* to simplify checks */
    /* @status    APPROVED (IMS) */
    RuleType SimservsRule,                      // urn_ietf_params_xml_ns_common_policy.Ruleset
    SetOfCharString_Type ConditionNames         // list of condition names corresponding to the conditions of the Rule
  };

  type record of SupplementaryServiceInfo_Rule_Type SupplementaryServiceInfo_ListOfRules_Type;          /* @status    APPROVED (IMS) */

  type record SupplementaryServiceInfo_Type
  { /* to simplify checks */
    /* @status    APPROVED (IMS) */
    AbsService_group Service,
    boolean Active,
    SupplementaryServiceInfo_ListOfRules_Type ListOfRules
  };

  template (present) ConditionsType cr_ConditionsType_Empty := {choice_list := {{identity_list := {}}}};  /* @status    APPROVED (IMS) */

  template (value) SupplementaryServiceInfo_Type cs_SupplementaryServiceInfo_Init(AbsService_group p_Service,
                                                                                  boolean p_Active,
                                                                                  SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules) :=
  { /* @status    APPROVED (IMS) */
    Service := p_Service,
    Active := p_Active,
    ListOfRules := p_ListOfRules
  };

  template (present) AbsService_group cr_Communication_diversion(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    communication_diversion := {
      active := p_Active,
      attr := *,
      noReplyTimer := *,
      ruleset := *
    }
  };

  template (present) AbsService_group cr_Originating_identity_presentation_restriction(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    originating_identity_presentation_restriction := {
      active := p_Active,
      attr := *,
      default_behaviour := *
    }
  };

  template (present) AbsService_group cr_Originating_identity_presentation(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    originating_identity_presentation := {
      active := p_Active,
      attr := *
    }
  };

  template (present) AbsService_group cr_Terminating_identity_presentation_restriction(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    terminating_identity_presentation_restriction := {
      active := p_Active,
      attr := *,
      default_behaviour := *
    }
  };

  template (present) AbsService_group cr_Terminating_identity_presentation(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    terminating_identity_presentation := {
      active := p_Active,
      attr := *
    }
  };

  template (present) AbsService_group cr_Incoming_communication_barring(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    incoming_communication_barring := {
      active := p_Active,
      password_required := false ifpresent,             // @sic R5s201409 BASELINE MOVING 2020 sic@
      attr := *,
      ruleset := *
    }
  };

  template (present) AbsService_group cr_Outgoing_communication_barring(template boolean p_Active := *) :=
  { /* @status    APPROVED (IMS) */
    outgoing_communication_barring := {
      active := p_Active,
      password_required := false ifpresent,             // @sic R5s201409 BASELINE MOVING 2020 sic@
      attr := *,
      ruleset := *
    }
  };

  template (value) Simservs cs_Simservs(template (value) Simservs_ServiceList_Type p_AbsServiceList) :=
  { /* @status    APPROVED (IMS) */
    attr := omit,
    absService_list := p_AbsServiceList,
    extensions := omit
  };

  template (value) Ruleset cs_Ruleset(template (omit) ConditionsType p_Conditions,
                                      template (value) XSD.String p_Action) :=
  { /* @status    APPROVED (IMS) */
    rule_list := {
      cs_CP_Rule(p_Conditions, p_Action)
    }
  };

  template (value) RuleType cs_CP_Rule(template (omit) ConditionsType p_Conditions,
                                       template (value) XSD.String p_Action) :=
  { /* @status    APPROVED (IMS) */
    id := tsc_XCAP_RuleId_Def,
    conditions := p_Conditions,               /* @sic R5-202502, R5-204531, R5s201286 sic@ */
    actions := {
      elem_list := {
        p_Action
      }
    },
    transformations := omit
  };

  template (value) Forward_to cs_ForwardTo(AnyURI p_Target) :=
  { /* @status    APPROVED (IMS) */
    target := p_Target,
    notify_caller := true,
    reveal_identity_to_caller := omit,
    reveal_served_user_identity_to_caller := omit,
    notify_served_user := omit,
    notify_served_user_on_outbound_call := omit,
    reveal_identity_to_target := omit
  };

  template (value) Allow cs_AllowBit(boolean p_Allow) := p_Allow;   /* @status    APPROVED (IMS) */

  template (value) Rule_deactivated   cs_Rule_deactivated := {};    /* @status    APPROVED (IMS) */

  template (value) No_answer          cs_No_answer := {};           /* @status    APPROVED (IMS) */

  template (value) Busy               cs_Busy := {};                /* @status    APPROVED (IMS) */

  template (value) Not_registered     cs_Not_registered := {};      /* @status    APPROVED (IMS) */

  template (value) Not_reachable      cs_Not_reachable := {};       /* @status    APPROVED (IMS) */

  template (value) Roaming            cs_Roaming := {};             /* @status    APPROVED (IMS) */

  template (value) Anonymous          cs_Anonymous := {};           /* @status    APPROVED (IMS) */

  template (value) International      cs_International := {};       /* @status    APPROVED (IMS) */

  template (value) International_exHC cs_International_exHC := {};  /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Rule_deactivated_elem   := f_Bit2XsdString(encvalue(cs_Rule_deactivated));  /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_No_answer_elem          := f_Bit2XsdString(encvalue(cs_No_answer));         /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Busy_elem               := f_Bit2XsdString(encvalue(cs_Busy));              /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Not_registered_elem     := f_Bit2XsdString(encvalue(cs_Not_registered));    /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Not_reachable_elem      := f_Bit2XsdString(encvalue(cs_Not_reachable));     /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Roaming_elem            := f_Bit2XsdString(encvalue(cs_Roaming));           /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Anonymous_elem          := f_Bit2XsdString(encvalue(cs_Anonymous));         /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_International_elem      := f_Bit2XsdString(encvalue(cs_International));     /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_International_exHC_elem := f_Bit2XsdString(encvalue(cs_International_exHC)); /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Action_ForwardTo_elem(AnyURI p_Target) := f_Bit2XsdString(encvalue(cs_ForwardTo(p_Target)));  /* @status    APPROVED (IMS) */

  template (value) XSD.String cs_Action_Allow_elem(boolean p_Allow)     := f_Bit2XsdString(encvalue(cs_AllowBit(p_Allow)));    /* @status    APPROVED (IMS) */

  template (value) ConditionsType cs_Conditions_ElemList(template (value) ConditionsType.choice_list[-].elem_list p_ElemList) :=
  { /* @status    APPROVED (IMS) */
    choice_list := {
      {
        elem_list := p_ElemList
      }
    }
  };

  template (value) ConditionsType cs_Conditions_Identity(template (value) IdentityType p_Identity) :=
  { /* @status    APPROVED (IMS) */
    choice_list := {
      {
        identity_list := { p_Identity }
      }
    }
  };

  template (value) IdentityType cs_Identity_Many(template (value) ManyType p_Many) :=
  { /* @status    APPROVED (IMS) */
    choice_list := {
      { many := p_Many }
    }
  };

  template (value) ManyType cs_Many(template (value) ManyType.choice_list[-].elem_list p_ElemList,
                                    AnyURI p_ExceptTarget := px_XCAP_TargetUri) :=
  { /* @status    APPROVED (IMS) */
    domain := omit,
    choice_list := {
      {
        except_ := {
          domain := omit,
          id := p_ExceptTarget
        }
      },
      {
        elem_list := p_ElemList
      }
    }
  };

  template (value) AbsService_group cs_Communication_diversion(template (value) ConditionsType.choice_list[-].elem_list p_ConditionsElemList,
                                                               boolean p_Active := true,
                                                               AnyURI p_Target := px_XCAP_TargetUri) :=
  { /* @status    APPROVED (IMS) */
    /* @sic R5-202502: p_Active := true sic@ */
    /* @sic R5-204531: p_ConditionsElemList sic@ */
    communication_diversion := {
      active := p_Active,
      attr := omit,
      noReplyTimer := omit,
      ruleset := cs_Ruleset(cs_Conditions_ElemList(p_ConditionsElemList), cs_Action_ForwardTo_elem(p_Target))    /* @sic R5-192311 sic@ */
    }
  };

  template (value) AbsService_group cs_Originating_identity_presentation_restriction(boolean p_Active := false) :=
  { /* @status    APPROVED (IMS) */
    originating_identity_presentation_restriction := {
      active := p_Active,
      attr := omit,
      default_behaviour := omit
    }
  };

  template (value) AbsService_group cs_Originating_identity_presentation(boolean p_Active := false) :=
  { /* @status    APPROVED (IMS) */
    originating_identity_presentation := {
      active := p_Active,
      attr := omit
    }
  };

  template (value) AbsService_group cs_Terminating_identity_presentation_restriction(boolean p_Active := false) :=
  { /* @status    APPROVED (IMS) */
    terminating_identity_presentation_restriction := {
      active := p_Active,
      attr := omit,
      default_behaviour := omit
    }
  };

  template (value) AbsService_group cs_Terminating_identity_presentation(boolean p_Active := false) :=
  { /* @status    APPROVED (IMS) */
    terminating_identity_presentation := {
      active := p_Active,
      attr := omit
    }
  };

  template (value) AbsService_group cs_Incoming_communication_barring(template (omit) ConditionsType p_Conditions,
                                                                      boolean p_Active := true,
                                                                      boolean p_Allow := false) :=
  { /* @status    APPROVED (IMS) */
    /* @sic R5-202502: p_Active := true sic@ */
    /* @sic R5-204531: p_Conditions sic@ */
    incoming_communication_barring := {
      active := p_Active,
      password_required := omit,                        // @sic R5s201409 BASELINE MOVING 2020 sic@
      attr := omit,
      ruleset := cs_Ruleset(p_Conditions, cs_Action_Allow_elem(p_Allow))   /* @sic R5-192311 sic@ */
    }
  };

  template (value) AbsService_group cs_Outgoing_communication_barring(template (omit) ConditionsType p_Conditions,
                                                                      boolean p_Active := true,
                                                                      boolean p_Allow := false) :=
  { /* @status    APPROVED (IMS) */
    /* @sic R5-202502: p_Active := true sic@ */
    /* @sic R5-204531, R5s201286: p_ConditionsElemList sic@ */
    outgoing_communication_barring := {
      active := p_Active,
      password_required := omit,                        // @sic R5s201409 BASELINE MOVING 2020 sic@
      attr := omit,
      ruleset := cs_Ruleset(p_Conditions, cs_Action_Allow_elem(p_Allow))   /* @sic R5-192311 sic@ */
    }
  };

  /*
   * @desc      set simservs document at the XCAP server
   * @param     p_Document
   * @status    APPROVED (IMS)
   */
  function f_IMS_XCAP_SetDocument(charstring p_Document) runs on IMS_XCAP_PTC
  {
    var template (value) IMS_HTTP_Command_Type v_Command := { DocumentSet := p_Document };
    f_IMS_HTTP_RunCommand(__FILE__, __LINE__, v_Command);
  }

  /*
   * @desc      get simservs document from the XCAP server
   * @return    Simservs
   * @status    APPROVED (IMS)
   */
  function f_IMS_XCAP_GetDocument() runs on IMS_XCAP_PTC return Simservs
  {
    var Simservs v_Simservs;
    var template (value) IMS_HTTP_Command_Type v_Command := {DocumentGet := true};
    var charstring v_Document := f_IMS_HTTP_RunCommand(__FILE__, __LINE__, v_Command);
    var bitstring v_Bitstring := oct2bit(char2oct(v_Document));
    if (decvalue(v_Bitstring, v_Simservs) != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "cannot decode simservs document");
    }
    return v_Simservs;
  }

  /*
   * @desc      initialise simservs document for supplementary service to be tested
   * @param     p_SupplementaryService
   * @status    APPROVED (IMS)
   */
  function f_IMS_XCAP_InitialiseSimservsDocument(SS_Type p_SupplementaryService) runs on IMS_XCAP_PTC
  { /* @sic R5-202502, R5-204531, R5s201286: Only one entry in the simservs document anymore sic@ */
    var template (value) ConditionsType.choice_list[-].elem_list v_ConditionsElemList;
    var template (value) ManyType.choice_list[-].elem_list v_ConditionsElemListMany;
    var template (omit) ConditionsType v_Conditions;
    var template (value) AbsService_group v_AbsService;
    var template (value) Simservs_ServiceList_Type v_AbsServiceList;
    var template (value) Simservs v_Simservs;
    var bitstring v_Bitstring;
    var charstring v_Document;

    select (p_SupplementaryService) {
      case (SS_CLIP) {                          // 15.1, 8.1.NR5GC
        v_AbsService := cs_Originating_identity_presentation;
      }
      case (SS_CLIR) {                          // 15.2, 8.2.NR5GC
        v_AbsService := cs_Originating_identity_presentation_restriction;
      }
      case (SS_COLP) {                          // 15.3, 8.4.NR5GC
        v_AbsService := cs_Terminating_identity_presentation;
      }
      case (SS_TIR) {                           // 15.4, 8.5.NR5GC
        v_AbsService := cs_Terminating_identity_presentation_restriction;
      }
      case (SS_CFU) {                           // 15.5, 8.7.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem };
        v_AbsService := cs_Communication_diversion(v_ConditionsElemList);
      }
      case (SS_CFNRy) {                         // 15.7, 8.15.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_No_answer_elem };
        v_AbsService := cs_Communication_diversion(v_ConditionsElemList);
      }
      case (SS_CFB) {                           // 15.9, 8.11.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Busy_elem };
        v_AbsService := cs_Communication_diversion(v_ConditionsElemList);
      }
      case (SS_CFNL) {                          // 15.10, 8.9.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Not_registered_elem };
        v_AbsService := cs_Communication_diversion(v_ConditionsElemList);
      }
      case (SS_CFNRc) {                         // 15.10a, 8.13.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Not_reachable_elem };
        v_AbsService := cs_Communication_diversion(v_ConditionsElemList);
      }
      case (SS_BAIC_EXCEPT_SPECIFIC_USER) {     // 15.13, 8.18.NR5GC
        v_ConditionsElemListMany := { cs_Rule_deactivated_elem };
        v_Conditions := cs_Conditions_Identity(cs_Identity_Many(cs_Many(v_ConditionsElemListMany)));
        v_AbsService := cs_Incoming_communication_barring(v_Conditions);
      }
      case (SS_BAIC_ANONYMOUS) {                // 15.14, 8.19.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Anonymous_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Incoming_communication_barring(v_Conditions);
      }
      case (SS_BAIC) {                          // 8.17.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Incoming_communication_barring(v_Conditions);
      }
      case (SS_BIC_ROAM) {                      // 15.14a, 8.25.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Roaming_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Incoming_communication_barring(v_Conditions);
      }
      case (SS_BARRING_OUT_ROAM) {               // 15.14b, 8.24.NR5GC
        if (f_IMS_PTC_RanTypeIsNR5GC()) {
          v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Roaming_elem, cs_International_exHC_elem };
        } else {
          v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_Roaming_elem };
        }
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Outgoing_communication_barring(v_Conditions);
      }
      case (SS_BAOC) {                           // 8.21.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Outgoing_communication_barring(v_Conditions);
      }
      case (SS_BOIC) {                           // 8.22.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_International_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Outgoing_communication_barring(v_Conditions);
      }
      case (SS_BOIC_EXHC) {                      // 8.23.NR5GC
        v_ConditionsElemList := { cs_Rule_deactivated_elem, cs_International_exHC_elem };
        v_Conditions := cs_Conditions_ElemList(v_ConditionsElemList);
        v_AbsService := cs_Outgoing_communication_barring(v_Conditions);
      }
    }

    v_AbsServiceList := { v_AbsService };
    v_Simservs := cs_Simservs(v_AbsServiceList);
    v_Bitstring := encvalue(v_Simservs);
    v_Document := oct2char(bit2oct(v_Bitstring));

    f_IMS_XCAP_SetDocument(v_Document);
  }

  /*
   * @desc      return entry for given supplementary service from the given simservs document
   * @param     p_Simservs
   * @param     p_RequiredService
   * @return    AbsService_group
   * @status    APPROVED (IMS)
   */
  function fl_Simservs_GetService(Simservs p_Simservs,
                                  template (present) AbsService_group p_RequiredService) return AbsService_group
  { /* @sic R5-202502, R5-204531, R5s201286: parameter p_DefaultForRequiredService removed sic@ */
    var integer i;
    var Simservs_ServiceList_Type v_ServiceList := p_Simservs.absService_list;
    var AbsService_group v_AbsService_Dummy := {
      absService := { omit, omit }
    };
    
    for (i:=0; i < lengthof(v_ServiceList); i:=i+1) {
      if (match(v_ServiceList[i], p_RequiredService)) {
        return v_ServiceList[i];
      }
    }
    FatalError(__FILE__, __LINE__, "Service not found in Simservs document");
    return v_AbsService_Dummy;   /* @sic R5-202502, R5-204531, R5s201286 sic@ */
  }

  /*
   * @desc      return either given ruleset if present or empty ruleset
   * @param     p_Ruleset
   * @return    SupplementaryServiceInfo_ListOfRules_Type
   * @status    APPROVED (IMS)
   */
  function fl_SupplementaryServiceInfo_ListOfRules(Ruleset p_Ruleset) return SupplementaryServiceInfo_ListOfRules_Type
  {
    var SupplementaryServiceInfo_ListOfRules_Type v_ListOfRules := {};
    var RuleType v_SimservsRule;
    var integer i;

    for (i := 0; i < lengthof(p_Ruleset.rule_list); i := i + 1) {
      v_SimservsRule := p_Ruleset.rule_list[i];
      v_ListOfRules[i].SimservsRule := v_SimservsRule;
      v_ListOfRules[i].ConditionNames := fl_Rule_GetCommonPolicyConditions(v_SimservsRule);
    }
    return v_ListOfRules;
  }

  /*
   * @desc      returns a single SupplementaryServiceInfo_Type;
   *            NOTE: there is no requirement anymore that a single supplementary service changes more than one element of the Simservs document
   * @param     p_Simservs
   * @param     p_SupplementaryService
   * @return    SupplementaryServiceInfo_Type
   * @status    APPROVED (IMS)
   */
  function f_Simservs_GetSupplementaryServiceInfo(Simservs p_Simservs,
                                                  SS_Type p_SupplementaryService) return SupplementaryServiceInfo_Type
  {
    var SupplementaryServiceInfo_ListOfRules_Type v_ListOfRules := {};
    var AbsService_group v_AbsService;
    var boolean v_ServiceIsActive;
    var template boolean v_ServiceActiveTemplate := true ifpresent;  /* @sic R5-165883: service needs to be considered to be active too when "active" attribute is absent sic@ */

    select (p_SupplementaryService) {
      case (SS_CLIP) {                          // 15.1, 8.1.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Originating_identity_presentation);
        v_ServiceIsActive := match(v_AbsService, cr_Originating_identity_presentation(v_ServiceActiveTemplate));
      }
      case (SS_CLIR) {                          // 15.2, 8.2.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Originating_identity_presentation_restriction);
        v_ServiceIsActive := match(v_AbsService, cr_Originating_identity_presentation_restriction(v_ServiceActiveTemplate));
      }
      case (SS_COLP) {                          // 15.3, 8.4.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Terminating_identity_presentation);
        v_ServiceIsActive := match(v_AbsService, cr_Terminating_identity_presentation(v_ServiceActiveTemplate));
      }
      case (SS_TIR) {                           // 15.4, 8.5.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Terminating_identity_presentation_restriction);
        v_ServiceIsActive := match(v_AbsService, cr_Terminating_identity_presentation_restriction(v_ServiceActiveTemplate));
      }
      case (SS_CFU,                             // 15.5, 8.7.NR5GC
            SS_CFNRy,                           // 15.7, 8.15.NR5GC
            SS_CFB,                             // 15.9, 8.11.NR5GC
            SS_CFNL,                            // 15.10, 8.9.NR5GC
            SS_CFNRc) {                         // 15.10a, 8.13.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Communication_diversion);
        v_ServiceIsActive := match(v_AbsService, cr_Communication_diversion(v_ServiceActiveTemplate));
        v_ListOfRules := fl_SupplementaryServiceInfo_ListOfRules(v_AbsService.communication_diversion.ruleset);
      }
      case (SS_BAIC,                            // 8.17.NR5GC
            SS_BAIC_ANONYMOUS,                  // 15.14, 8.19.NR5GC
            SS_BAIC_EXCEPT_SPECIFIC_USER,       // 15.13, 8.18.NR5GC
            SS_BIC_ROAM) {                      // 15.14a, 8.25.NR5GC      @sic R5-153995 sic@
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Incoming_communication_barring);
        v_ServiceIsActive := match(v_AbsService, cr_Incoming_communication_barring(v_ServiceActiveTemplate));
        v_ListOfRules := fl_SupplementaryServiceInfo_ListOfRules(v_AbsService.incoming_communication_barring.ruleset);
      }
      case (SS_BARRING_OUT_ROAM,                // 15.14b, 8.24.NR5GC      @sic R5s141115 change 1: no support outgoing communication barring; R5-151166: outgoing communication barring re-introduced; R5-153995: split incoming and outgoing sic@
            SS_BAOC,                            // 8.21.NR5GC
            SS_BOIC,                            // 8.22.NR5GC
            SS_BOIC_EXHC) {                     // 8.23.NR5GC
        v_AbsService := fl_Simservs_GetService(p_Simservs, cr_Outgoing_communication_barring);
        v_ServiceIsActive := match(v_AbsService, cr_Outgoing_communication_barring(v_ServiceActiveTemplate));
        v_ListOfRules := fl_SupplementaryServiceInfo_ListOfRules(v_AbsService.outgoing_communication_barring.ruleset);
      }
      case else {
        FatalError(__FILE__, __LINE__, "unknown supplementary service");
      }
    }
    return valueof(cs_SupplementaryServiceInfo_Init(v_AbsService, v_ServiceIsActive, v_ListOfRules)); // @sic R5-216570..82 - NOTE: there are no multiple services anymore sic@
  }

  /*
   * @desc      get rule from list of rules: if there is more than one rule (e.g. SS_CFNL), then the rule is found depending on the condition
   *            checks that maximum number of rules is not exceeded and for NR5GC whether the rule id is as expected
   *            NOTE:
   *            According to IR.92 clause 2.3.2 from v10.0 (2016) onward and NG.114 clause 2.3.2 the UE shall not add any new <rule> element to the XML document
   *            => as in case of p_SupplementaryService=CFNL there is no rule for SS_CFNRy in the initial XML document, the UE shall come up with only one rule (CFNL);
   *            => In general this function shall be used with p_RuleCntMax := 1 only  (@sic R5-232648 sic@)
   * @param     p_ListOfRules
   * @param     p_RuleCntMax        (default value: 1)
   * @param     p_ConditionName     (default value: ?)
   * @param     p_RuleId            (default value: tsc_XCAP_RuleId_Def)
   * @return    SupplementaryServiceInfo_Rule_Type
   * @status    APPROVED (IMS)
   */
  function fl_ListOfRules_GetRule(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules,
                                  integer p_RuleCntMax := 1,
                                  template (present) charstring p_ConditionName := ?,
                                  template (present) charstring p_RuleId := tsc_XCAP_RuleId_Def) runs on IMS_PTC return SupplementaryServiceInfo_Rule_Type
  {
    var integer v_RuleCnt := lengthof(p_ListOfRules);
    var SupplementaryServiceInfo_Rule_Type v_Rule;
    var integer i;

    if (v_RuleCnt > p_RuleCntMax) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "too many rules");
    }
    if (v_RuleCnt == 1) {                                       /* @sic R5-216570..82: in general the ruleset has only one rule sic@ */
      v_Rule := p_ListOfRules[0];
    } else {                                                    /* @sic R5-230876: SS_CFNL may come along with SS_CFNRy FOR 4G sic@
                                                                   @sic R5-232648: even for SS_CFNL there shall only be one rule, i.e. the else branch shall not be used anymore sic@ */
      for (i := 0; i < v_RuleCnt; i := i + 1) {
        if (match(p_ListOfRules[i].ConditionNames, superset(p_ConditionName))) {
          v_Rule := p_ListOfRules[i];
          break;
        }
      }
      if (not isbound(v_Rule)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "no rule found for expected condition");
      }
    }
    if (f_IMS_PTC_RanTypeIsNR5GC() and not match(v_Rule.SimservsRule.id, p_RuleId)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid rule id");
    }
    return v_Rule;
  }

  /*
   * @desc      check supplemantary service
   * @param     p_ListOfRules
   * @param     p_SupplementaryService
   * @param     p_Deactivated      (default value: false)
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function f_SupplementaryServiceInfo_CheckListOfRules(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules,
                                                       SS_Type p_SupplementaryService,
                                                       boolean p_Deactivated := false) runs on IMS_PTC return boolean
  {
    var boolean v_RulesetOK := true;
    var SupplementaryServiceInfo_Rule_Type v_Rule;
    var RuleType v_SimservsRule;

    // check ruleset for communication forwarding, communication barring
    select (p_SupplementaryService) {
      case (SS_CFU,
            SS_CFNRy,
            SS_CFB,
            SS_CFNL,
            SS_CFNRc) {
        v_Rule := fl_ListOfRules_GetRule(p_ListOfRules);        /* @sic R5-232648: even for SS_CFNL there shall only be one rule => p_RuleCntMax := 1, p_ConditionName := ? for fl_ListOfRules_GetRule sic@ */
        v_SimservsRule := v_Rule.SimservsRule;
        v_RulesetOK := (fl_Rule_CheckConditions(p_SupplementaryService, v_SimservsRule, p_Deactivated) and fl_ForwardingRule_CheckForwardTo(v_SimservsRule));
      }
      case (SS_BAIC,
            SS_BAIC_ANONYMOUS,
            SS_BIC_ROAM,
            SS_BAOC,
            SS_BOIC,
            SS_BOIC_EXHC,
            SS_BARRING_OUT_ROAM) {                              // @sic R5-153995 sic@
        v_Rule := fl_ListOfRules_GetRule(p_ListOfRules);
        v_SimservsRule := v_Rule.SimservsRule;
        v_RulesetOK := fl_Rule_CheckConditions(p_SupplementaryService, v_SimservsRule, p_Deactivated);
      }
      case (SS_BAIC_EXCEPT_SPECIFIC_USER) {
        v_RulesetOK := (fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option1(p_ListOfRules) or
                        (fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option2_Rule1(p_ListOfRules) and
                         fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option2_Rule2(p_ListOfRules)));
      }
    }
    return v_RulesetOK;
  }

  /*
   * @desc      Decode IETF common policy condition element (XCAP.xsd; ss:empty-element-type elements)
   * @param     p_EncodedCondition
   * @return    charstring
   * @status    APPROVED (IMS)
   */
  function fl_Rule_DecodeCommonPolicyCondition(XSD.String p_EncodedCondition) return charstring
  {
    var bitstring v_Bitstring := f_XsdString2Bit(p_EncodedCondition);
    var charstring v_ConditionName := "";
    var Anonymous v_Anonymous;
    var Rule_deactivated v_Rule_deactivated;
    var Not_registered v_Not_registered;
    var Busy v_Busy;
    var No_answer v_No_answer;
    var Not_reachable v_Not_reachable;
    var Roaming v_Roaming;
    var International v_International;
    var International_exHC v_International_exHC;

    if      (decvalue(v_Bitstring, v_Anonymous) == 0)           { v_ConditionName := "anonymous"; }
    else if (decvalue(v_Bitstring, v_Roaming) == 0)             { v_ConditionName := "roaming"; }
    else if (decvalue(v_Bitstring, v_No_answer) == 0)           { v_ConditionName := "no-answer"; }
    else if (decvalue(v_Bitstring, v_Busy) == 0)                { v_ConditionName := "busy"; }
    else if (decvalue(v_Bitstring, v_Not_registered) == 0)      { v_ConditionName := "not-registered"; }
    else if (decvalue(v_Bitstring, v_Not_reachable) == 0)       { v_ConditionName := "not-reachable"; }
    else if (decvalue(v_Bitstring, v_Rule_deactivated) == 0)    { v_ConditionName := "rule-deactivated"; }
    else if (decvalue(v_Bitstring, v_International) == 0)       { v_ConditionName := "international"; }
    else if (decvalue(v_Bitstring, v_International_exHC) == 0)  { v_ConditionName := "international-exHC"; }
    else { FatalError(__FILE__, __LINE__, "Invalid condition"); }

    return v_ConditionName;
  }

  /*
   * @desc      Get list of IETF common policy conditions (XCAP.xsd)
   *            (all elements are ss:empty-element-type elements)
   * @param     p_Rule
   * @return    SetOfCharString_Type
   * @status    APPROVED (IMS)
   */
  function fl_Rule_GetCommonPolicyConditions(RuleType p_Rule) return SetOfCharString_Type
  {
    var SetOfCharString_Type v_ConditionList := {};
    var integer n := 0;
    var integer i;
    var integer k;
    var charstring v_ConditionName;

    if (ispresent(p_Rule.conditions)) {
      for (i := 0; i < lengthof(p_Rule.conditions.choice_list); i := i + 1) {
        if (ischosen(p_Rule.conditions.choice_list[i].elem_list)) {
          for (k := 0; k < lengthof(p_Rule.conditions.choice_list[i].elem_list); k := k + 1) {
            v_ConditionName := fl_Rule_DecodeCommonPolicyCondition(p_Rule.conditions.choice_list[i].elem_list[k]);
            v_ConditionList[n] := v_ConditionName;
            n := n + 1;
          }
        }
      }
    }
    return v_ConditionList;
  }

  /*
   * @desc      returns true if p_Deactivated==true and all rules have "rule-deactivated" condition
   *            or if p_Deactivated==false and no rule has "rule-deactivated" condition
   * @param     p_ListOfRules
   * @param     p_RulesetDeactivated
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function f_SupplementaryServiceInfo_CheckDeactivated(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules,
                                                       boolean p_RulesetDeactivated) return boolean
  { // @sic R5-216570..82: Cleanup for IMSoNR5GC XCAP test cases sic@
    var boolean v_RuleDeactivated;
    var integer i;
    
    for (i := 0; i < lengthof(p_ListOfRules); i := i + 1) {
      v_RuleDeactivated := match(p_ListOfRules[i].ConditionNames, superset("rule-deactivated"));
      if (v_RuleDeactivated != p_RulesetDeactivated) {
        return false;
      }
    }
    return true;
  }

  /*
   * @desc      check conditions of the given rule according to given service
   * @param     p_SupplementaryService
   * @param     p_Rule
   * @param     p_Deactivated       (default value: false)
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_Rule_CheckConditions(SS_Type p_SupplementaryService,
                                   RuleType p_Rule,
                                   boolean p_Deactivated := false) runs on IMS_PTC return boolean
  { // @sic R5-216570..82: Cleanup for IMSoNR5GC XCAP test cases sic@
    var template (present) SetOfCharString_Type v_ExpectedConditions;
    var SetOfCharString_Type v_Conditions;
        
    select (p_SupplementaryService) {
      case (SS_CFU) {
        v_ExpectedConditions := {};
      }
      case (SS_CFNRy) {
        v_ExpectedConditions := { "no-answer" };
      }
      case (SS_CFB) {
        v_ExpectedConditions := { "busy" };
      }
      case (SS_CFNL) {
        v_ExpectedConditions := { "not-registered" };
      }
      case (SS_CFNRc) {
        v_ExpectedConditions := { "not-reachable" };                    // @sic R5s141162 change 1 overruled by R5-145722 and R5s141350 sic@
      }
      case (SS_BAIC_ANONYMOUS) {
        v_ExpectedConditions := { "anonymous" };                        // check rule at step 2 for testcase 15.14
      }
      case (SS_BAIC, SS_BAOC) {
        v_ExpectedConditions := {};                                     // 8.17.NR5GC, 8.21.NR5GC: empty condition or no condition
      }
      case (SS_BIC_ROAM) {                                              // @sic R5-153995 sic@
        v_ExpectedConditions := { "roaming" };
      }
      case (SS_BOIC) {
        v_ExpectedConditions := { "international" };                    // 8.22.NR5GC
      }
      case (SS_BOIC_EXHC) {
        v_ExpectedConditions := { "international-exHC" };               // 8.23.NR5GC
      }
      case (SS_BARRING_OUT_ROAM) {
        if (f_IMS_PTC_RanTypeIsNR5GC()) {
          v_ExpectedConditions := { "roaming", "international-exHC" };  // 8.24.NR5GC
        } else {
          v_ExpectedConditions := { "roaming" };                        /* @sic R5-151166: outgoing communication barring re-introduced sic@ */
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "invalid supplementary service");
      }
    }
    if (p_Deactivated) {
      v_ExpectedConditions := v_ExpectedConditions & { "rule-deactivated" };
    }
    
    if (lengthof(v_ExpectedConditions) == 0) {  // => "unconditional"
      return match(p_Rule.conditions, cr_ConditionsType_Empty ifpresent);       // @sic R5s130794 change 26 sic@
    }
    else {
      v_Conditions := fl_Rule_GetCommonPolicyConditions(p_Rule);
      if (not f_IMS_PTC_RanTypeIsNR5GC()) {                                     // For 4G it is not clear whether or not there may be additional conditions
        v_ExpectedConditions := superset(all from v_ExpectedConditions);
      }
      return match(v_Conditions, v_ExpectedConditions);
    }
  }

  /*
   * @desc      check forward-to
   * @param     p_Rule
   * @param     p_TargetAddress    (default value: px_XCAP_TargetUri)
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_ForwardingRule_CheckForwardTo(RuleType p_Rule,
                                            XSD.AnyURI p_TargetAddress := px_XCAP_TargetUri) return boolean
  {
    var integer i;
    var bitstring v_Bitstring;
    var Forward_to v_Forward_to;
    
    for (i := 0; i < lengthof(p_Rule.actions.elem_list); i := i + 1) {
      v_Bitstring := f_XsdString2Bit(p_Rule.actions.elem_list[i]);
      if (decvalue(v_Bitstring, v_Forward_to) == 0) {
        if (match(v_Forward_to.target, p_TargetAddress)) {
          return true;
        }
      }
    }
    return false;
  }

  /*
   * @desc      check allow
   * @param     p_Rule
   * @param     p_AllowValue
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_BarringRule_CheckAllow(RuleType p_Rule,
                                     boolean p_AllowValue) return boolean
  {
    var integer i;
    var bitstring v_Bitstring;
    var Allow v_Allow;
    
    for (i := 0; i < lengthof(p_Rule.actions.elem_list); i := i + 1) {
      v_Bitstring := f_XsdString2Bit(p_Rule.actions.elem_list[i]);
      if (decvalue(v_Bitstring, v_Allow) == 0) {
        if (v_Allow == p_AllowValue) {
          return true;
        }
      }
    }
    return false;
  }

  /*
   * @desc      check for excepted user
   * @param     p_Rule
   * @param     p_UserId
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_BarringRule_CheckExceptSpecificUser(RuleType p_Rule,
                                                  XSD.AnyURI p_UserId) return boolean
  {
    var IdentityType v_Identity;
    var ManyType v_Many;
    var integer i;
    var integer k;
    var integer l;

    if (ispresent(p_Rule.conditions)) {
      for (i := 0; i < lengthof(p_Rule.conditions.choice_list); i := i + 1) {
        if (ischosen(p_Rule.conditions.choice_list[i].identity_list)) {
          if (ispresent(p_Rule.conditions.choice_list[i].identity_list[0])) {
            v_Identity := p_Rule.conditions.choice_list[i].identity_list[0];

            for (k := 0; k < lengthof(v_Identity.choice_list); k := k + 1) {
              if (ischosen(v_Identity.choice_list[k].many)) {
                v_Many := v_Identity.choice_list[k].many;
                for (l := 0; l < lengthof(v_Many.choice_list); l := l + 1) {
                  if (ischosen(v_Many.choice_list[l].except_)) {
                    if (v_Many.choice_list[l].except_.id == p_UserId) {
                      return true;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    return false;
  }

  /*
   * @desc      check for specific user
   * @param     p_Rule
   * @param     p_UserId
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_BarringRule_CheckOneSpecificUser(RuleType p_Rule,
                                               XSD.AnyURI p_UserId) return boolean
  {
    var IdentityType v_Identity;
    var OneType v_One;
    var integer i;
    var integer k;

    if (ispresent(p_Rule.conditions)) {
      for (i := 0; i < lengthof(p_Rule.conditions.choice_list); i := i + 1) {
        if (ischosen(p_Rule.conditions.choice_list[i].identity_list)) {
          if (ispresent(p_Rule.conditions.choice_list[i].identity_list[0])) {
            v_Identity := p_Rule.conditions.choice_list[i].identity_list[0];

            for (k := 0; k < lengthof(v_Identity.choice_list); k := k + 1) {
              if (ischosen(v_Identity.choice_list[k].one)) {
                v_One := v_Identity.choice_list[k].one;
                if (v_One.id == p_UserId) {
                  return true;
                }
              }
            }
          }
        }
      }
    }
    return false;
  }

  /*
   * @desc      check for "other-identity"
   * @param     p_Rule
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_BarringRule_CheckOtherIdentity(RuleType p_Rule) return boolean
  {
    var bitstring v_Bitstring;
    var Other_identity v_Other_identity;
    var integer i;
    var integer k;

    if (ispresent(p_Rule.conditions)) {
      for (i := 0; i < lengthof(p_Rule.conditions.choice_list); i := i + 1) {
        if (ischosen(p_Rule.conditions.choice_list[i].elem_list)) {
          for (k := 0; k < lengthof(p_Rule.conditions.choice_list[i].elem_list); k := k + 1) {
            v_Bitstring := f_XsdString2Bit(p_Rule.conditions.choice_list[i].elem_list[k]);
            if (decvalue(v_Bitstring, v_Other_identity) == 0) {
              return true;
            }
          }
        }
      }
    }
    return false;
  }

  /*
   * @desc      check option 1 at step 2 for testcase 15.13
   * @param     p_ListOfRules
   * @param     p_UserId            (default value: px_XCAP_TargetUri)
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option1(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules,
                                                                                  XSD.AnyURI p_UserId := px_XCAP_TargetUri) return boolean
  {
    var integer i;
    var RuleType v_Rule;

    for (i := 0; i < lengthof(p_ListOfRules); i := i + 1) {
      v_Rule := p_ListOfRules[i].SimservsRule;
      if (fl_BarringRule_CheckAllow(v_Rule, false) and fl_BarringRule_CheckExceptSpecificUser(v_Rule, p_UserId)) {
        return true;
      }
    }
    return false;
  }

  /*
   * @desc      check 1st rule of option 2 at step 2 for testcase 15.13
   * @param     p_ListOfRules
   * @param     p_UserId            (default value: px_XCAP_TargetUri)
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option2_Rule1(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules,
                                                                                        XSD.AnyURI p_UserId := px_XCAP_TargetUri) return boolean
  {
    var integer i;
    var RuleType v_Rule;

    for (i := 0; i < lengthof(p_ListOfRules); i := i + 1) {
      v_Rule := p_ListOfRules[i].SimservsRule;
      if (fl_BarringRule_CheckAllow(v_Rule, true) and fl_BarringRule_CheckOneSpecificUser(v_Rule, p_UserId)) {
        return true;
      }
    }
    return false;
  }

  /*
   * @desc      check 2nd rule of option 2 at step 2 for testcase 15.13
   * @param     p_ListOfRules
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function fl_IncomingCommunicationBarringExceptSpecificUser_CheckRuleset_Option2_Rule2(SupplementaryServiceInfo_ListOfRules_Type p_ListOfRules) return boolean
  {
    var integer i;
    var RuleType v_Rule;

    for (i := 0; i < lengthof(p_ListOfRules); i := i + 1) {
      v_Rule := p_ListOfRules[i].SimservsRule;
      if (fl_BarringRule_CheckAllow(v_Rule, false) and fl_BarringRule_CheckOtherIdentity(v_Rule)) {
        return true;
      }
    }
    return false;
  }

}
