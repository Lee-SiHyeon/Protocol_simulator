  const TimeslotNumber           tsc_UL_TS_SICH := 1;                            /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) @sic R5s130661 sic@*/

  const HS_SCCH_Codes            tsc_HS_SCCH_ChC7 := 7;                          /* Channelization code for HS-SCCH
