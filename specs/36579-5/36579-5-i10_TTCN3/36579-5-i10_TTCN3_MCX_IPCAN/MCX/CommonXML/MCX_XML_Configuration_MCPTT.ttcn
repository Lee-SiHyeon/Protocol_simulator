  function f_MCPTT_UserProfile_Extension() return MCPTT_UserProfile_Extension_Type
  {
    var boolean v_AllowAutomaticCommencement := not f_GetTestcaseAttrib_Disallow_automatic_commencement(testcasename());                      // Needs to be false for test case 6.2.6

    var urn_3gpp_mcptt_user_profile_1_0.Allow_create_delete_user_alias                   v_Allow_create_delete_user_alias := true;            // @sic R5-213589: true sic@
    var urn_3gpp_mcptt_user_profile_1_0.Allow_private_call                               v_Allow_private_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_private_call_to_any_user                   v_Allow_private_call_to_any_user := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_manual_commencement                        v_Allow_manual_commencement := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_automatic_commencement                     v_Allow_automatic_commencement := v_AllowAutomaticCommencement;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_force_auto_answer                          v_Allow_force_auto_answer := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_failure_restriction                        v_Allow_failure_restriction := false;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_private_call_media_protection              v_Allow_private_call_media_protection := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_private_call_floor_control_protection      v_Allow_private_call_floor_control_protection := tsc_MCX_XML_ConfidentialityProtection;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_emergency_private_call                     v_Allow_emergency_private_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_cancel_private_emergency_call              v_Allow_cancel_private_emergency_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_emergency_group_call                       v_Allow_emergency_group_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_cancel_group_emergency                     v_Allow_cancel_group_emergency := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_imminent_peril_call                        v_Allow_imminent_peril_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_cancel_imminent_peril                      v_Allow_cancel_imminent_peril := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_activate_emergency_alert                   v_Allow_activate_emergency_alert := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_cancel_emergency_alert                     v_Allow_cancel_emergency_alert := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_create_group_broadcast_group               v_Allow_create_group_broadcast_group := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_create_user_broadcast_group                v_Allow_create_user_broadcast_group := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_offnetwork                                 v_Allow_offnetwork := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_listen_both_overriding_and_overridden      v_Allow_listen_both_overriding_and_overridden := false;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_transmit_during_override                   v_Allow_transmit_during_override := false;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_off_network_group_call_change_to_emergency v_Allow_off_network_group_call_change_to_emergency := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_imminent_peril_change                      v_Allow_imminent_peril_change := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_regroup                                    v_Allow_regroup := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_presence_status                            v_Allow_presence_status := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_presence                           v_Allow_request_presence := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_private_call_participation                 v_Allow_private_call_participation := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_override_of_transmission                   v_Allow_override_of_transmission := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_manual_off_network_switch                  v_Allow_manual_off_network_switch := true;

    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_private_call_call_back             v_Allow_request_private_call_call_back := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_cancel_private_call_call_back              v_Allow_cancel_private_call_call_back := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_remote_initiated_ambient_listening v_Allow_request_remote_initiated_ambient_listening := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_locally_initiated_ambient_listening v_Allow_request_locally_initiated_ambient_listening := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_first_to_answer_call               v_Allow_request_first_to_answer_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_remote_init_private_call           v_Allow_request_remote_init_private_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_request_remote_init_group_call             v_Allow_request_remote_init_group_call := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_query_functional_alias_other_user          v_Allow_query_functional_alias_other_user := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_takeover_functional_alias_other_user       v_Allow_takeover_functional_alias_other_user := true;
    var urn_3gpp_mcptt_user_profile_1_0.Allow_location_info_when_talking                 v_Allow_location_info_when_talking := tsc_MCX_Allow_location_info_when_talking;

    var urn_3gpp_mcptt_user_profile_1_0.AnyExt v_AnyExt;
    var urn_3gpp_mcptt_user_profile_1_0.AnyExt.elem_list v_AnyExtElemList;
    var template (value) ExtensibleType v_Actions;
    var template (value) urn_ietf_params_xml_ns_common_policy.RuleType v_Rule;
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_Ruleset;
    var MCPTT_UserProfile_Extension_Type v_Extension;

    v_AnyExtElemList := {
      f_Bit2XsdString(encvalue(v_Allow_request_private_call_call_back)),                        // @sic R5-217632 sic@
      f_Bit2XsdString(encvalue(v_Allow_cancel_private_call_call_back)),                         // @sic R5-217632 sic@
      f_Bit2XsdString(encvalue(v_Allow_request_remote_initiated_ambient_listening)),            // @sic R5-217632 sic@
      f_Bit2XsdString(encvalue(v_Allow_request_locally_initiated_ambient_listening)),           // @sic R5-217632 sic@
      f_Bit2XsdString(encvalue(v_Allow_request_first_to_answer_call)),                          // @sic R5-212146 sic@
      f_Bit2XsdString(encvalue(v_Allow_request_remote_init_private_call)),                      // @sic R5-212146 sic@
      f_Bit2XsdString(encvalue(v_Allow_query_functional_alias_other_user)),                     // @sic R5-213589 sic@
      f_Bit2XsdString(encvalue(v_Allow_request_remote_init_group_call)),                        // @sic R5-217632 sic@
      f_Bit2XsdString(encvalue(v_Allow_takeover_functional_alias_other_user)),                  // @sic R5-213589 sic@
      f_Bit2XsdString(encvalue(v_Allow_location_info_when_talking))
    };

    v_AnyExt := {                         /* @sic R5-206110: Rel-15 sic@ */
      elem_list := v_AnyExtElemList
    };
    
    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_Allow_create_delete_user_alias)),
        f_Bit2XsdString(encvalue(v_Allow_private_call)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_to_any_user)),
        f_Bit2XsdString(encvalue(v_Allow_manual_commencement)),
        f_Bit2XsdString(encvalue(v_Allow_automatic_commencement)),
        f_Bit2XsdString(encvalue(v_Allow_force_auto_answer)),
        f_Bit2XsdString(encvalue(v_Allow_failure_restriction)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_media_protection)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_floor_control_protection)),
        f_Bit2XsdString(encvalue(v_Allow_emergency_private_call)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_private_emergency_call)),
        f_Bit2XsdString(encvalue(v_Allow_emergency_group_call)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_group_emergency)),
        f_Bit2XsdString(encvalue(v_Allow_imminent_peril_call)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_imminent_peril)),
        f_Bit2XsdString(encvalue(v_Allow_activate_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_create_group_broadcast_group)),
        f_Bit2XsdString(encvalue(v_Allow_create_user_broadcast_group)),
        f_Bit2XsdString(encvalue(v_Allow_offnetwork)),
        f_Bit2XsdString(encvalue(v_Allow_listen_both_overriding_and_overridden)),
        f_Bit2XsdString(encvalue(v_Allow_transmit_during_override)),
        f_Bit2XsdString(encvalue(v_Allow_off_network_group_call_change_to_emergency)),
        f_Bit2XsdString(encvalue(v_Allow_imminent_peril_change)),
        f_Bit2XsdString(encvalue(v_Allow_regroup)),
        f_Bit2XsdString(encvalue(v_Allow_presence_status)),
        f_Bit2XsdString(encvalue(v_Allow_request_presence)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_participation)),
        f_Bit2XsdString(encvalue(v_Allow_override_of_transmission)),
        f_Bit2XsdString(encvalue(v_Allow_manual_off_network_switch)),
        f_Bit2XsdString(encvalue(v_AnyExt))                            // @sic R5-206110 sic@
      }
    };
    
    v_Rule := cs_MCX_CP_Rule("rule1", v_Actions);
    v_Ruleset := cs_MCX_CP_Ruleset(v_Rule);
    
    v_Extension := {
      f_Bit2XsdString(encvalue(v_Ruleset))
    };
    return v_Extension;
  }

  template (value) MCPTT_UserProfile_Type cs_MCPTT_UserProfile(template (value) MCPTT_UserProfile_OnNetwork_Type p_OnNetwork := cs_MCPTT_UserProfile_OnNetwork,
                                                               MCPTT_UserProfile_Extension_Type p_Extension) :=
  { /* 36.579-1 Table 5.5.8.3-1: MCPTT User Profile Defaults
       @status    APPROVED (MCX) */
    /* @sic R5s240535 Rel-18 Jun'24 baseline upgrade - Further changes: @fuzzy removed, p_Extension added sic@
       => f_MCPTT_UserProfile_Extension is handed over as p_Extension and therefore evaluated when cs_MCPTT_UserProfile is used in a test case but not at the unspecified point in time when cs_MCPTT_UserProfile gets initialised
       => It is ensured that in f_MCPTT_UserProfile_Extension testcasename() returns the actual testcase name (rather than "") */
    xUI_URI := "sip:" & px_MCPTT_ID_User_A,                                                                             // @sic R5-217985: same as the XUI value of the Document URI sic@
    user_profile_index := tsc_MCX_ProfileId_MCPTT,
    attr := omit,
    choice_list := {
      { status := true },
      { profileName := cs_MCPTT_UserProfile_Name("mcptt-user-profile-" & int2str(tsc_MCX_ProfileId_MCPTT) & ".xml") },  // @sic R5-217985: name of the user profile document; user-profile-index is the value of the user-profile-index attribute sic@
      { common := cs_MCPTT_UserProfile_Common },
      { offNetwork := cs_MCPTT_UserProfile_OffNetwork },
      { onNetwork := p_OnNetwork },
      { elem_list := p_Extension }
    }
  };

