          (pc_ue_CategoryDL_9 and pc_ue_Category_9 and pc_ue_Category_6 and pc_ue_Category_4 and
                                 (pc_ue_CategoryUL_5 or (pc_ue_CategoryUL_5 and pc_ue_CategoryUL_16))) or // @sic R5-172923 sic@
          (pc_ue_CategoryDL_10 and pc_ue_Category_10 and pc_ue_Category_7 and pc_ue_Category_4 and
                                  (pc_ue_CategoryUL_13 or (pc_ue_CategoryUL_13 and pc_ue_CategoryUL_18))) or  // @sic R5-172923 sic@
