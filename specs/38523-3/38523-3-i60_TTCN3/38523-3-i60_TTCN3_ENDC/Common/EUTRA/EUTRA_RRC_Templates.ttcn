                                                              template (omit) RequestedFrequencyBands_r11_Type p_RequestedFrequencyBands_r11 := omit) := //@sic R5-221544 sic@
  { /* According to 36.508 cl. 4.6.1 Table 4.6.1-22 - to be updated - */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5-217903 sic@ */
    message_ := {
      c1 := {
        ueCapabilityEnquiry := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            c1 := {
              ueCapabilityEnquiry_r8 := {
                ue_CapabilityRequest := p_UE_CapabilityRequest,
                nonCriticalExtension := {
                  lateNonCriticalExtension := omit,
                  nonCriticalExtension := {
                    requestedFrequencyBands_r11 := p_RequestedFrequencyBands_r11, //@sic R5-221544 sic@
                    nonCriticalExtension := {
                      requestReducedFormat_r13 := omit,
                      requestSkipFallbackComb_r13 := omit,
                      requestedMaxCCsDL_r13 := omit,
                      requestedMaxCCsUL_r13 := omit,
                      requestReducedIntNonContComb_r13 := omit,
                      nonCriticalExtension := {
                        requestDiffFallbackCombList_r14 := omit,
                        nonCriticalExtension := {
                          requestedFreqBandsNR_MRDC_r15 := p_MRDC,
                          nonCriticalExtension := {
                            requestSTTI_SPT_Capability_r15 := p_RequestSTTI_SPT_Capability_r15,
                            eutra_nr_only_r15 := p_Eutra_nr_only_r15,
                            nonCriticalExtension := {
                               requestedCapabilityNR_r15 := omit,
                               nonCriticalExtension := {
                                 requestedCapabilityCommon_r15 := omit,
                                 nonCriticalExtension := {
                                   rrc_SegAllowed_r16   := p_Rrc_SegAllowed_r16,
                                   nonCriticalExtension := omit
                                   }
                                 }
                               }
                            }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

