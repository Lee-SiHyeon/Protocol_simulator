                                                                                                                                     p_BandIndicator_1,
                                                                                                                                     cs_FollowingARFCNs_explicitListOfARFCNs(p_ExplicitListOfARFCNs_1),
                                                                                                                                     0,
                                                                                                                                     omit,
                                                                                                                                     omit)),
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(tsc_IdReportConfigInterRAT_PERIODICAL,
                                                                                                       cs_508_ReportConfigInterRAT_Periodical),
                                                                    omit, //@sic R5s120244 sic@
                                                                    cs_MeasIdToAddModList_1Entry(1, tsc_IdMeasObject_f12, tsc_IdReportConfigInterRAT_PERIODICAL),
                                                                    cs_QuantityConfig(cs_QuantityConfigEUTRA(omit, omit),
