module UTRAN_AGNSS_Testcases {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from ComponentsType all;
  import from LCS_Objects_Templates all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from POS_Parameters all;
  import from Parameters all;
  import from PosSystem_Common all;
  import from PosSystem_CommonUTRAN all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN_AGNSS_Functions all;
  import from UTRAN_AGNSS_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_IRAT_CommonFunctions all;
  import from UTRAN_IRAT_CommonProcedures all;
  import from UTRAN_IRAT_Component all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_POS_Component all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.1.1, Subtest 4 (UE supporting A-GPS and A-GLONASS only)
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_1_1_4s_UTRAN() runs on UTRAN_POS_PTC
  {
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_StartSatelliteSimulatorAGNSS({gps, glonass}, 4); // Scenario for Subtest 4 according to 37.571-5, 6.1.2
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_TestBody_Set(true);
    f_CheckCallEstAGNSS(utran_Cell5, 4, ue_Based, uEBased);
    f_UT_CheckDTCH_ThroughConn(UT);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.1.1 subtest 4 Step 13");
    f_AGNSS_MeasControlAndReport_UeBased(4);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.1.1 subtest 4 Step 15");
    f_UTRAN_CC_Disconnect();
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
    f_StopSatelliteSimulatorAGNSS({gps, glonass});
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.2.1.4s
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_2_1_4s_UTRAN() runs on UTRAN_POS_PTC
  { //Changes for code optimisation. See @sic R5s150706 sic@
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_StartSatelliteSimulatorAGNSS({gps, glonass}, 4); // Scenario for Subtest 4 according to 37.571-5, 6.1.2
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_TestBody_Set(true);
    fl_TC_6_2_2_1_TestBody (4);
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
    f_StopSatelliteSimulatorAGNSS({gps, glonass});
  }

  /*
   * @desc      test body of TC_6_2_2_1_x test cases
   * @param     p_Subtest
   * @status    APPROVED (POS)
   */
  function fl_TC_6_2_2_1_TestBody(integer p_Subtest) runs on UTRAN_POS_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_Ti_S;
    var InvokeIdType v_InvokeId := 0; // To store InvokeId sent by the UE in the REGISTER message
    var PositionEstimate v_PositionEstimate;
    var octetstring v_Octetstring;
    var octetstring v_EncodedComponents;
    var Components v_Components;
    
    f_UT_InitMOLR(UT, POSITION_ESTIMATE); //AT
    
    // Step 1. RRC Connection
    f_UTRAN_RRC_ConnEst(utran_Cell5, originatingHighPrioritySignalling);
    
    // Step 2. Receive CM SERVICE REQUEST of type "call independent supplementary service"
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_ServReqWithType(?, tsc_SupplementaryServiceActivation))) -> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);

    // Steps 3 and 4. MM Authentication
    f_UTRAN_MM_Authentication();

    // Step 5. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    
    // Step 6. Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndOneOrAbove)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_InvokeComponent(cdr_InvokeLocEstimate)));
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.2.1 subtest "& int2char(p_Subtest) & " Step 6");
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_Ti_S := v_RRC_DataInd.msg.register.ti;
    v_Ti_S.tiFlag := '1'B;
    
    // Steps 7 to 8. Send MEASUREMENT CONTROL(s) and receive MESAUREMENT REPORT with Position Estimate
    v_PositionEstimate := f_AGNSS_MeasControlAndReport_UeBased_r8Or12(p_Subtest);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.2.1 subtest " & int2char(p_Subtest) & " Step 8");
    
    // Step 9. Send FACILITY message
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ResultLocEstimate(v_InvokeId, bit2oct(encvalue(v_PositionEstimate)))))); //@sic R5-140685 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_Ti_S, cs_FacilityIE_lv(v_EncodedComponents))));
    
    // Step 10. Receive RELEASE COMPLETE message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteAny(cr_TI_MO)));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.2.1 subtest " & int2char(p_Subtest) &  "Step 10");
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.2.3.4s
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_2_3_4s_UTRAN() runs on UTRAN_POS_PTC {
    // Note: The Satellite Simulator is switched on at the begining of the test to get the assistance data
    //       (to be send by the SS in the MEASUREMENT CONTROL message(s), and then switched off so that the
    //       UE does not receive enought satellite signals.
    //Changes for code optimisation. See @sic R5s150706 sic@
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_StartSatelliteSimulatorAGNSS({gps, glonass}, 4); // Scenario for Subtest 4 according to 37.571-5, 6.1.2
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_TestBody_Set(true);
    fl_TC_6_2_2_3_TestBody (4);
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
  }

  /*
   * @desc      test body of TC_6_2_2_3_x test cases
   * @param     p_Subtest
   * @status    APPROVED (POS)
   */
  function fl_TC_6_2_2_3_TestBody(integer p_Subtest) runs on UTRAN_POS_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_Ti_S;
    var InvokeIdType v_InvokeId := 0; // To store InvokeId sent by the UE in the REGISTER message
    var octetstring v_Octetstring;
    var octetstring v_EncodedComponents;
    var Components v_Components;
    
    f_UT_InitMOLR(UT, POSITION_ESTIMATE); //AT
    
    // Step 1. RRC Connection
    f_UTRAN_RRC_ConnEst(utran_Cell5, originatingHighPrioritySignalling);
    
    // Step 2. Receive CM SERVICE REQUEST of type "call independent supplementary service"
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_ServReqWithType(?, tsc_SupplementaryServiceActivation)))-> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    // Steps 3 and 4. MM Authentication
    f_UTRAN_MM_Authentication();
    
    // Step 5. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    
    // Step 6. Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndOneOrAbove)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_InvokeComponent(cdr_InvokeLocEstimate)));
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.2.3 subtest " & int2char(p_Subtest) & "  Step 6");
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_Ti_S := v_RRC_DataInd.msg.register.ti;
    v_Ti_S.tiFlag := '1'B;
    
    // Steps 7 to 8. Send MEASUREMENT CONTROL(s) and receive MESAUREMENT REPORT with Error reason "Not enough satellites"
    f_AGNSS_MeasControlAndReport_UeBasedFailure_r8Or12(p_Subtest);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.2.3 subtest " & int2char(p_Subtest) & "  Step 8");
    
    // Step 10. SS sends RELEASE COMPLETE
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ErrorMOLR(v_InvokeId, cs_PositionMethodFailure))));//@sic R5-140685 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));
  }

  /*
   * @desc      Initial condition for test cases 6.2.3.1 and 6.2.3.2
   * @status    APPROVED (POS)
   */
  function fl_TC_6_2_3_1And2_Init () runs on UTRAN_IRAT_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    
    f_UTRAN_IdleUpdated(utran_Cell5);
    f_UTRAN_PageCS(utran_Cell5, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN_RRC_ConnEst(utran_Cell5, terminatingConversationalCall);
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cr_MobileIdAny))) -> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
  }

