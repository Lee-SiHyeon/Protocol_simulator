    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_PreestablishedSession_CallSetupMT(v_CallType, tsc_MCPTT_PreestablishedSessionControl_AnswerState_Unconfirmed);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2" Void siclog@

    // @siclog "Step 3" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(BROADCAST);

    // @siclog "Step 4" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide notification to the user indicating a broadcast call?", "Step 4");

    // @siclog "Step 5" siclog@
    f_MCPTT_PreestablishedSession_CallReleaseMT(v_CallType);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_TestBody_Set(false);
    
    f_MCX_PreestablishedSession_ReleaseMT();
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.19.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_19_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Active functional alias / Client Originated (CO)
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall, REGISTERED_AUTHORIZED_FA_ACTIVATED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call using the active functional alias with automatic commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_CallSetupMO_ReceiveINVITE_Send100Trying(MCPTT, GROUP_CALL, -, -, withImplictGrantRequest, px_MCPTT_ID_FA_A);   /* @sic R5s230486 MCC160 comments sic@ */
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(MCPTT, -, v_InviteRequestWithSdp);
    f_MCPTT_FloorControl_SendFloorGranted(NORMAL_CALL);

    // @siclog "Step 3" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 3");
    
    // @siclog "Step 4 - 5" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);  // @sic R5s240111: MMI of step 4 is done in f_MCX_CallReleaseMO already sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.1.20.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_1_20_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / On-demand Pre-arranged Group Call / Multi Talker
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var O4_Type v_RTCP_SSRC_SS;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);       /* preamble with <multi-talker-control> element of the MCPTT Group Configuration Defaults set to "true"
                                                          and <max-number-simultaneous-talkers> element of the MCPTT Group Configuration Defaults set to "2"
                                                          (Test case attribute MULTI_TALKER -> f_MCPTT_Group_Extensions_mcpttgi) */
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call with automatic commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, -, -, withImplictGrantRequest);   // 36.579-1 table 5.3A.1.3-1 NOTE1 b.ii
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 3");
    
    // @siclog "Step 4" siclog@
    f_MCPTT_FloorControl_SendFloorTaken_MultiTalker();

    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide notification to the user indicating a multi-talker call?", "Step 5");
    
    // @siclog "Step 6" siclog@
    v_RTCP_SSRC_SS := f_MCX_IMS_PTC_RTCP_SSRC_SS_Get();    // @sic R5-236323: RTCP SSRC stored at the MCX_IMS_PTC to be future proven sic@
    f_MCPTT_FloorControl_SendRequest(cs_FloorCtrlMsg_ReleaseMultiTalker(v_RTCP_SSRC_SS));
    
    // @siclog "Step 7" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide notification to the user indicating that the participant has released the floor in a multi-talker group?", "Step 7");
    
    // @siclog "Step 8 - 9" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

