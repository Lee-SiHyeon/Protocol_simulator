module EUTRA_L2_CommonTemplates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_AspCommon_Templates all;

  group L1_MAC_Indication {

  template (value) SYSTEM_CTRL_REQ cas_UL_HARQ_IndConfig_REQ(EUTRA_CellId_Type p_CellId,
                                                             IndicationAndControlMode_Type p_UL_HARQ_Mode,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,   //@sic R5s120024 sic@
                                                             template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    /* @sic R5s120201: parameter p_CnfFlag sic@ */
    Common := cs_ReqAspCommonPart_CellCfg(p_CellId, p_TimingInfo, p_CnfFlag),
    Request := {
      L1MacIndCtrl := cs_EnableUL_HARQ_Req(p_UL_HARQ_Mode)
    }
  };

  template (value) L1Mac_IndicationControl_Type cs_EnableUL_HARQ_Req(IndicationAndControlMode_Type p_HARQ_Mode) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    RachPreamble := omit,
    SchedReq  := omit,
    BSR       := omit,
    UL_HARQ   := p_HARQ_Mode,
    C_RNTI    := omit,
    PHR       := omit,
    HarqError := omit,
    PeriodicRI := omit,
    EPHR := omit,
    PeriodicCQI := omit,
    SRS := omit,
    DC_PHR := omit
  };

  template (present) SYSTEM_IND car_UL_HARQ_IND(EUTRA_CellId_Type p_CellId,
                                                template (present) TimingInfo_Type p_TimingInfo,
                                                template (present)  HARQ_Type p_HARQ_Type) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    Common        := cr_IndAspCommonPart_SysInd (p_CellId, p_TimingInfo),
    Indication    := {
      UL_HARQ := p_HARQ_Type
    }
  };

  } // end of group L1_MAC_Indication

  template (present) SYSTEM_IND car_HarqError_IND(EUTRA_CellId_Type p_CellId) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_R10_R11) */
    Common        := cr_IndAspCommonPart_SysInd (p_CellId, ?),
    Indication    := {
      HarqError := ?
    }
  };

}
