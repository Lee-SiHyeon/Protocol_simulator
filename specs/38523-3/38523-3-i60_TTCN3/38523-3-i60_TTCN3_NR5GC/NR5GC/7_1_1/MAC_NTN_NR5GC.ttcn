module MAC_NTN_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NAS_5GC_Parameters all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_NTN_Configuration all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;
  import from UpperTesterFunctions all;

  template (value) NR_MAC_ControlElementDL_Type cs_NR_MAC_DifferentialKoffset_CE( B6_Type    p_Koffset) :=
  { /* @status    APPROVED (NR5GC) */
      DifferentialKoffset :=
      {
          Reserved := '00'B,
          DifferentialKoffset := p_Koffset
      }
  };

  template (value) TAR_Config_r17 cs_TAR_Config_r17 (TAR_Config_r17.offsetThresholdTA_r17 p_OffsetThresholdTA_r17,
                                                     TAR_Config_r17.timingAdvanceSR_r17 p_TimingAdvanceSR_r17):=
  { /* @status    APPROVED (NR5GC) */
      offsetThresholdTA_r17 := p_OffsetThresholdTA_r17,
      timingAdvanceSR_r17 := p_TimingAdvanceSR_r17
  }

  /*
   * @desc     Function to modify K-offset configured in SS by the given DifferentialKoffset
   * @param     p_NR_CellId
   * @param     p_DiffKoffet
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_SS_NTN_ApplyDifferentialKoffset(NR_CellId_Type p_NR_CellId,
                                                   integer p_DiffKoffet,
                                                   template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
      var template (value) NR_NTN_Config_Type v_NTN_Config;
      var integer v_Koffset;
      var template (omit) NR_NTN_TimingOffset_Type v_TA := cs_NTN_TimingOffset_AllOmit;
      
      v_Koffset:= f_NR_CellInfo_GetKoffset (p_NR_CellId) - p_DiffKoffet;
      v_TA.Koffset := v_Koffset;
      v_NTN_Config := cs_38508_NTN_Config(v_TA);
      f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_NTN_Config_REQ(nr_Cell1, p_TimingInfo, v_NTN_Config));
      
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.10.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_1_10_4_NR5GC() runs on NR5GC_PTC
  { // NTN / UE specific TA report / UE specific Koffset
    var template (value) DL_DCCH_Message v_DL_DCCH_Message;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    var NG_NAS_MSG_Indication_Type v_DedicatedNAS_Message;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN;
    var NAS_PlmnId v_PLMN;
    var SubFrameTiming_Type v_Timing;
    var integer v_DifferentialKoffset;
    var template (value) FreqBandInformation v_FirstBand;
    var octetstring v_EncodeCapRequest;
    
    //Init NTN Cell parameters
    f_NR5GC_Init(NR_29);  /*@sic R5-252350 sic@*/
      
    //Table 7.1.1.10.4.3.3-2: NTN-Config
    f_NR_CellInfo_SetSIB19_NTN_ta_Report_r17(nr_Cell1, enabled);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
      
    //The UE is in state Switched OFF (state 0N-B) as defined in TS 38.508-1 [4], subclause 4.4A on NR Cell 1.
    f_NR5GC_Preamble(nr_Cell1, STATE_OFF_0B);
    
    f_NR_TestBody_Set(true);
      
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    f_NR_CellInfo_SetMAC_CellGroupConfigL2(nr_Cell1);
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(enable));
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(enable));
      
    //@siclog "Step 1" siclog@
    //Power on the UE.
    f_UT_SwitchOnUE(UT, false);
      
    //@siclog "Step 2" siclog@
    //The UE transmits preamble on PRACH
    SYSIND.receive(car_NR_PRACH_Preamble_IND(nr_Cell1, cr_TimingInfo_Any, ?));
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(disable));
     
    //@siclog "Step 3" siclog@
    //The SS transmits Random Access Response with RAPID corresponding to the transmitted preamble in step 2.
    //Preconfigured at SS
     
    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message with Timing Advance Report MAC CE included?
    f_NR_CheckMacPduAndTimingAdvanceReport(nr_Cell1,true,"Step 4",cr_38508_RRCSetupRequest,-,true);     /*@sic R5s250260, R5-254990 sic@*/
              
    //@sic Steps 5-22 sic@
    //Steps 3 to 20a1 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2.2-2 are performed
    f_NR5GC_RRC_Idle_Steps3_20(nr_Cell1, TESTMode_OFF, noRrcConnectionRelease, Initial_NoSecurity);
     
    //@sic Step 23 sic@
    //The UE is switched off by executing generic procedure in Table 4.9.6.1-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(nr_Cell1, STATE_CONNECTED_3A);
    f_NR5GC_MobileInfo_Init();
      
    //@sic Step 24 sic@
    //SS broadcasts SIB19 with ta-Report-r17 not present.
    //Table 7.1.1.10.4.3.3-2: NTN-Config
    f_NR_CellInfo_SetSIB19_NTN_ta_Report_r17(nr_Cell1, omit);
    f_NR_ModifySysinfo(nr_Cell1);
    f_NR_WaitModificationPeriods(nr_Cell1);
          
    //@sic Step 25 sic@
    //Power on the UE.
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(enable));
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_MAC_UL_TA_Report(enable)); /*@sic R5s250260 sic@*/
    f_NR5GC_SwitchOnAndResetIMS();
      
    //@siclog "Step 26" siclog@
    //The UE transmits preamble on PRACH
    SYSIND.receive(car_NR_PRACH_Preamble_IND(nr_Cell1, cr_TimingInfo_Any, ?));
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(disable));
     
    //@siclog "Step 27" siclog@
    //The SS transmits Random Access Response with RAPID corresponding to the transmitted preamble in step 26.
    //Preconfigured at SS
      
    //@sic Step 28 sic@
    //The UE transmits an RRCSetupRequest message with no Timing Advance Report MAC CE included.
    f_NR_CheckMacPduAndTimingAdvanceReport(nr_Cell1,false,"Step 28",cr_38508_RRCSetupRequest,-,false);  /*@sic R5-254990 sic@*/
    f_NR_ULGrantConfiguration_Start(nr_Cell1);
      
    //@sic Step 29 sic@
    //The SS transmits an RRCSetup message configuring offsetThresholdTA.
    //Table 7.1.1.10.4.3.3-5:
    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(nr_Cell1);
    v_MAC_CellGroupConfig.tar_Config_r17 := {setup := cs_TAR_Config_r17(ms15, enabled)};
    f_NR_CellInfo_SetMAC_CellGroupConfig(nr_Cell1, v_MAC_CellGroupConfig);
    SRB.send(cas_NR_SRB0_RrcPdu_REQ(nr_Cell1, -, f_NR_38508_RRCSetup(nr_Cell1))); /*@sic R5s250260 sic@*/
      
    //@sic Step 30 sic@
    //Check: Does the UE transmit an RRCSetupComplete message with Timing Advance Report MAC CE included?
    v_DedicatedNAS_Message := valueof(f_NR_CheckMacPduAndTimingAdvanceReport(nr_Cell1,true,"Step 30",omit,cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),true));   /*@sic R5-254990 sic@*/
      
    //@sic Step 31-45 sic@
    //Steps 5 to 19a1 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2.2-2 are performed.
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_DedicatedNAS_Message.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    v_ASN_PLMN := f_NR_CellInfo_GetPLMN (nr_Cell1);
    v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    f_NR5GC_RRC_Idle_Steps5_15(v_GMM_MobilityInfo, nr_Cell1, v_DedicatedNAS_Message, v_PLMN, TESTMode_OFF);
      
    if (pc_noOf_PDUsSameConnection > 0 ){
      f_NR5GC_PDUSessionEstablishment(nr_Cell1,-,tsc_NR_RbId_SRB1);
    }
    
    //@sic Step 46 sic@
    //The SS transmits a MAC PDU containing a Differential Koffset MAC CE with differential Koffset set to 20 ms (GSO scenario) or 1ms (NGSO scenario).
    if(f_NR_MobileInfo_GetNTNSatelliteType() == ntn_GSO)    //@sic R5s250425 Ch.1.1, R5-255842 sic@
    {
        v_DifferentialKoffset := 20;
    }else
    {
        v_DifferentialKoffset := 1;
    }

    v_Timing := f_NR_GetNextSendOccasion_DL(nr_Cell1);
    f_NR_SS_CommonCellConfig(nr_Cell1, cas_NR_MacCommandTrigger_REQ(nr_Cell1, cs_TimingInfo_NR(v_Timing), cs_NR_MAC_DifferentialKoffset_CE(int2bit(v_DifferentialKoffset,6))));
    //Reconfigure SS with a new TA
    v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, 2);   // add 2ms
    f_NR5GC_SS_NTN_ApplyDifferentialKoffset(nr_Cell1,v_DifferentialKoffset, cs_TimingInfo_NR(v_Timing)) ;

    //@sic Step 47 sic@
    //The SS transmits a UECapabilityEnquiry message
    v_FirstBand := cs_NR_BandInformationNR(f_NR_CellInfo_GetBandIndicator(nr_Cell1));
    v_EncodeCapRequest := bit2oct(encvalue( cs_38508_UECapabilityRequestFilterNR({v_FirstBand})));
    v_DL_DCCH_Message := cs_38508_UECapabilityEnquiry(tsc_NR_RRC_TI_Def, nr, v_EncodeCapRequest);
       
    if(f_NR_CellInfo_GetNTN_UE_gNB_RTT(nr_Cell1)< 100) //@sic R5s250425 Ch.1.2 sic@
    {
        v_Timing := f_NR_GetNextSendOccasion_DL(nr_Cell1); // add RTT delay to allow UE to apply DifferentialKoffset
    }else
    {
        v_Timing := f_NR_GetNextSendOccasion_DL(nr_Cell1, f_NR_CellInfo_GetNTN_UE_gNB_RTT(nr_Cell1)); // add RTT delay to allow UE to apply DifferentialKoffset
    }
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, cs_TimingInfo_NR(v_Timing), v_DL_DCCH_Message));
        
    //@sic Step 48 sic@
    //Check: Does the UE transmit a UECapabilityInformation message after applying differential Koffset of 20ms (GSO scenario) or 1ms (NGSO scenario) received at step 46?
    //Note: Successful reception of this message at SS confirms that differential Koffset is applied at UE.
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_UECapabilityInformationAny(tsc_NR_RRC_TI_Def)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 48");
      
    f_NR_TestBody_Set(false);
    
    //Postamble
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A, tsc_NR_RbId_SRB1); /*@sic R5s250260 sic@*/
  };

}
