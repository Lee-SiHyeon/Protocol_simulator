  template (value) RachProcedureConfig_Type cs_RachProcedureConfig_CRNTI_Dedicated(RACH_TimingAdvance_Type p_RAR_TA,
                                                                                   Dl_Bandwidth_Type p_Dl_Bandwidth,  // @sic R5-103846 sic@
