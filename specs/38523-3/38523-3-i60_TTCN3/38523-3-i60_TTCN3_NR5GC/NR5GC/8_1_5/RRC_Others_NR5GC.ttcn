  const IntegerList_Type tsc_ListFreqBandIndicator := {1, 2, 3, 5, 7, 8, 12, 14, 20, 25, 26, 28, 29, 30, 34, 38, 39, 40, 41, 48, 50, 51, 53, 65, 66, 70, 71, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 86, 257, 258, 260, 261}; /* @status    APPROVED (NR5GC) */

  template (value) OtherConfig_v1700.rrm_MeasRelaxationReportingConfig_r17 cs_RRM_MeasRelaxationReportingConfig_r17_Setup( template (value) RRM_MeasRelaxationReportingConfig_r17.s_SearchDeltaP_Stationary_r17 p_S_SearchDeltaP_Stationary_r17,
                                                                                                                           template (value) RRM_MeasRelaxationReportingConfig_r17.t_SearchDeltaP_Stationary_r17 p_T_SearchDeltaP_Stationary_r17
                                                                                                                          ) :=
  { /* @status    APPROVED (NR5GC) */
    setup := {
      s_SearchDeltaP_Stationary_r17        := p_S_SearchDeltaP_Stationary_r17,
      t_SearchDeltaP_Stationary_r17        := p_T_SearchDeltaP_Stationary_r17
    }
  };

  template (value) UE_TimersAndConstants cds_UE_TimersAndConstants_t310
      modifies cs_38508_UE_TimersAndConstants :=
