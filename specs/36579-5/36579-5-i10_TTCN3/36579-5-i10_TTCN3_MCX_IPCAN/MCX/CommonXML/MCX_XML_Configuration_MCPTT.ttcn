  template (value) urn_3gpp_mcptt_user_profile_1_0.Manual_deactivation_not_allowed_if_location_criteria_met cs_MCPTT_UserProfile_Manual_deactivation_not_allowed_if_location_criteria_met := false;     /* @status    APPROVED (MCX) */

  template (value) urn_3gpp_mcptt_user_profile_1_0.AnyExtType cs_MCPTT_FunctionalAliasEntry_AnyExt :=
  { /* @status    APPROVED (MCX) */
    elem_list := {
      f_Bit2XsdString(encvalue(cs_MCPTT_UserProfile_LocationCriteriaForActivation)),
      f_Bit2XsdString(encvalue(cs_MCPTT_UserProfile_LocationCriteriaForDeactivation)),
      f_Bit2XsdString(encvalue(cs_MCPTT_UserProfile_Manual_deactivation_not_allowed_if_location_criteria_met))
    }
  };

  template (value) MCPTT_UserProfile_ListEntry_Type.choice_list cs_MCPTT_UserProfile_FunctionalAliasList_EntryList :=
  { /* @status    APPROVED (MCX) */
    { entry := cs_MCPTT_UserProfile_Entry(-, -, px_MCPTT_ID_FA_A, -, cs_MCPTT_FunctionalAliasEntry_AnyExt) }  // @sic R5-231917: cs_MCPTT_FunctionalAliasEntry_AnyExt sic@ */
