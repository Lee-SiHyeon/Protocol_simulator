module IMS_CC_SSConferencingTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_Parameters all;
  import from IMS_CC_TestcaseImplementation_15_Conferencing all;
  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_ConferenceEventPackage all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_CallHold all;
  import from IMS_Procedures_Conferencing all;
  import from IMS_SDP_Messages all;
  import from IMS_SIP_Templates all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.17
   * @status    APPROVED (IMS)
   */
  function f_TC_15_17_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (omit) SUBSCRIBE_Request v_SubscribeRequest;
    var charstring v_ConferenceFactoryUri;
    var charstring v_TemporaryConferenceUri;
    var charstring v_FinalConferenceUri;
    var IMS_CallType_Type v_CallType := CONFERENCE_CALL;  /* @sic R5-155179 sic@ */
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);             // @sic R5-150745, R5s160602 sic@
    v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);           // @sic R5-150745, R5s160602 sic@
    v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);               // @sic R5-150745, R5s160602 sic@

    // @siclog "Step 1 - 9" siclog@    same steps as for C.10
    v_InviteRequestWithSdp := f_IMS_ConferenceCreation_AnnexC10C38_Steps1_9(IPCAN_MO_SpeechCall, v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri);  /* @sic R5-150745 sic@ */

    // @siclog "Step 10 - 13" siclog@    same steps as for C.10
    v_SubscribeRequest := f_IMS_Conferencing_OptionalSubscription(v_FinalConferenceUri);     /* @sic R5-150745 sic@ */

    // @siclog "Step 14 - 15" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, f_SIP_BuildSipUri_RX(v_FinalConferenceUri), v_CallType);
    
    // @siclog "Step 16 - 17" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);           /* @sic R5-176937 - new steps sic@ */

    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.19
   * @status    APPROVED (IMS)
   */
  function f_TC_15_19_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_InvitingUser_ByReferToFocus(IPCAN_MO_SpeechCall, tsc_MediaTypeList_Audio);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.19a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_19a_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);
    
    f_IMS_InvitingUser_ByReferToFocus(IPCAN_MO_VideoCall, tsc_MediaTypeList_AudioVideo);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.21a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_21a_IMS1() runs on IMS_PTC
  { // Three way session creation

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_ThreeWaySession_Creation(IPCAN_MO_SpeechCall);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.21c
   * @status    APPROVED (IMS)
   */
  function f_TC_15_21c_IMS1() runs on IMS_PTC
  { // Three way session creation / video

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);

    f_IMS_ThreeWaySession_Creation(IPCAN_MO_VideoCall);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.25
   * @status    APPROVED (IMS)
   */
  function f_TC_15_25_IMS1() runs on IMS_PTC
  { // MO Explicit Communication Transfer - Consultative Call Transfer
    var charstring v_CalleeUri_Dialog1 := px_IMS_CalleeUri;
    var charstring v_CalleeUri_Dialog2 := px_IMS_CalleeUri2;
    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog1;
    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog2;
    var charstring v_CalleeContactUri_Dialog1 := px_IMS_CalleeContactUri;
    var template (value) SipUrl v_ContactUrl_1;
    var REFER_Request v_REFER_Request;
    var integer v_CSeqREFER;
    var SipUrl v_UEContactUrl;
    var template (value)  SDP_Message v_SDP_LatestMessageBySS;
    var boolean v_DontIncrementSessVers;
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    // Setup MO speech call
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, v_CalleeUri_Dialog1);
    
    // Call establishment (Annex C.21 / Dialog-1) in preamble
    v_SessionInfo_Dialog1.InviteRequestWithSdp := f_IMS_MOCallSetup_Step2(IPCAN_MO_SpeechCall, v_CalleeUri_Dialog1);
    v_UEContactUrl := f_Addr_Union_GetSipUrl(v_SessionInfo_Dialog1.InviteRequestWithSdp.Invite.msgHeader.contact.contactBody.contactAddresses[0].addressField);
    
    v_SessionInfo_Dialog1.MessageHeader_PrevResponse := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_SessionInfo_Dialog1.InviteRequestWithSdp);
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);
    v_SessionInfo_Dialog1.LatestSdpOffer := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_SessionInfo_Dialog1.InviteRequestWithSdp, v_SessionInfo_Dialog1.MessageHeader_PrevResponse);
    v_SessionInfo_Dialog1.ContactUrl := f_MessageHeader_GetContactSipUrl(v_SessionInfo_Dialog1.MessageHeader_PrevResponse);
    v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@
    v_SDP_LatestMessageBySS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_SessionInfo_Dialog1.LatestSdpOffer, v_DontIncrementSessVers);

    v_ContactUrl_1 := f_SIP_BuildSipUri_TX(v_CalleeContactUri_Dialog1);    // @sic R5s221272 - Further Changes: f_IMS_PTC_GetPort_ps() removed sic@
        
    f_IMS_TestBody_Set(true);
    
    // Initiate Explicit Communication Transfer (ECT) - 3GPP TS 24.629
    f_UT_CallHold(MMI);        // @sic R5-227599 sic@

    // Steps 1-4
    /* Steps defined in Annex C.8 to hold the call.
     * Note: UE starts automatically the call hold procedure
     */
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog1.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog1.MessageHeader_PrevResponse, v_SessionInfo_Dialog1.LatestSdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
 
    // Steps 5-16 (Annex C.21 / Dialog-2)
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");      // @sic R5-220212 sic@

    // !!!! @sic R5-227599: MMI to start the second call seems to be still missing sic@ !!!!

    v_SessionInfo_Dialog2.InviteRequestWithSdp := f_IMS_MOCallSetup_Step2(IPCAN_MO_SpeechCall, v_CalleeUri_Dialog2);
    v_SessionInfo_Dialog2.MessageHeader_PrevResponse := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_SessionInfo_Dialog2.InviteRequestWithSdp, px_IMS_CalleeContactUri2);
    v_SessionInfo_Dialog2.LatestSdpOffer := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_SessionInfo_Dialog2.InviteRequestWithSdp, v_SessionInfo_Dialog2.MessageHeader_PrevResponse, px_IMS_CalleeContactUri2);
    v_SessionInfo_Dialog2.ContactUrl := f_MessageHeader_GetContactSipUrl(v_SessionInfo_Dialog2.MessageHeader_PrevResponse);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
    
    // Step 16A
    f_UT_ExplicitCallTransfer(MMI);        // @sic R5-227599 sic@

    // Steps 17-20
    /* Steps defined in Annex C.8 to hold the call (on second call.
     * Note: UE starts automatically the call hold procedure
     */
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog2.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog2.MessageHeader_PrevResponse, v_SessionInfo_Dialog2.LatestSdpOffer, px_IMS_CalleeContactUri2);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
    
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);

    // Steps 21-22: Receive REFER, send 200 OK for REFER
    v_REFER_Request := f_IMS_CallTransfer_Refer(v_CalleeContactUri_Dialog1, v_CalleeUri_Dialog2, secondDialog);                            // @sic R5-211446: f_IMS_CallTransfer_Refer sic@
    v_CSeqREFER := v_REFER_Request.msgHeader.cSeq.seqNumber;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");

    // Steps 23-24: Send NOTIFY, receive 200 OK for NOTIFY
    f_IMS_CallTransfer_Notify_Active(v_ContactUrl_1, v_UEContactUrl, v_CSeqREFER);                                       /* @sic R5-211446: f_IMS_CallTransfer_Notify_Active sic@
                                                                                                                           @sic R5-230997 change 2: v_CSeqREFER sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");

    // Steps 25-28
    // Steps defined in Annex C.9 to hold the call. The same messages as in Annex C.9 Steps 1-4 are used.
    f_IMS_MTCallHoldResume(HOLDINACTIVE, v_UEContactUrl, v_SDP_LatestMessageBySS, v_ContactUrl_1);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
    
    // Steps 29-30 BYE/200 OK on Session-2 (UE <-> Target)
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_CallReleaseMT(v_UEContactUrl);
    
    // Steps 31-32
    // The SS, simulating the transferee, sends a NOTIFY to confirm that the call transfer has been completed
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);
    f_IMS_CallTransfer_Notify_200OK_Terminated(v_ContactUrl_1, v_UEContactUrl, v_CSeqREFER);                            /* @sic R5-211446: f_IMS_CallTransfer_Notify_Terminated sic@
                                                                                                                           @sic R5-230997 change 2: v_CSeqREFER sic@ */
    // Steps 33 to 34
    // Optional: UE may send BYE request to release call with transferee UE
    f_IMS_OptionalCallReleaseMO(v_SessionInfo_Dialog1.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog1.ContactUrl);   // @sic R5-211446: f_IMS_OptionalCallReleaseMO sic@
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
