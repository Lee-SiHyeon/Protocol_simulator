module NR_NoiseGenerator {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_VirtualNoiseDefs all;
  import from NR_Component_Base all;

  type record NR_CellNoiseLevel_Type { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    NR_CellId_Type CellId,
    integer        Noc
  };

  type record of NR_CellNoiseLevel_Type NR_CellNoiseLevelList_Type;  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) NR_CellNoiseLevel_Type cs_CellNoiseLevel(NR_CellId_Type p_NR_CellId, integer p_Noc) :=
    { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
        CellId := p_NR_CellId,
        Noc := p_Noc
    };

  template (value) NR_VNG_CTRL_REQ cas_NR_VNG_Configure_REQ(NR_CellId_Type p_NR_CellId,
                                                               integer  p_NocLevel ):=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, cs_TimingInfo_Now),
    Request := {
     Configure := {
       CellNocLevel := p_NocLevel
     }
    }
  };

  template (value) NR_VNG_CTRL_REQ cas_NR_VNG_Activate_REQ (NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, cs_TimingInfo_Now),
    Request := {
      Activate := true
    }
  };

  template (value) NR_VNG_CTRL_REQ cas_NR_VNG_Deactivate_REQ (NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cs_NR_ReqAspCommonPart_CellCfg(p_NR_CellId, cs_TimingInfo_Now),
    Request := {
      Deactivate := true
    }
  };

  template (present) NR_VNG_CTRL_CNF cr_NR_VNG_Action_CNF(NR_CellId_Type p_NR_CellId):=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := true
  };

  /*
   * @desc      Configure provided noise level for the corresponding cell
   * @param     p_CellNoise
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_ConfigureVNG(NR_CellNoiseLevel_Type p_CellNoise ) runs on NR_BASE_PTC
  {
      VNG.send (cas_NR_VNG_Configure_REQ ( p_CellNoise.CellId, p_CellNoise.Noc));
      VNG.receive(cr_NR_VNG_Action_CNF (p_CellNoise.CellId));    //@sic R5s200818 sic@
     
  }

  /*
   * @desc      Activate the noise (switched on) for the given cell
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_ActivateVNG ( NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {
    VNG.send (cas_NR_VNG_Activate_REQ ( p_NR_CellId)) ;
    VNG.receive(cr_NR_VNG_Action_CNF (p_NR_CellId));    //@sic R5s200818 sic@
  }

  /*
   * @desc      Deactivate noise for given cell
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_DeactivateVNG ( NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {
    VNG.send(cas_NR_VNG_Deactivate_REQ(p_NR_CellId));
    VNG.receive(cr_NR_VNG_Action_CNF (p_NR_CellId));    //@sic R5s200818 sic@
  }

  /*
   * @desc      Configure and activate noise for listed cells
   * @param     p_CellsList
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_ConfigureAndActivateVNG_MultipleCells( template (value) NR_CellNoiseLevelList_Type p_CellsList ) runs on NR_BASE_PTC
  {
      var integer v_CellsCounter := 0;
      while (v_CellsCounter < lengthof(p_CellsList))
      {
          f_NR_ConfigureVNG(valueof(p_CellsList[v_CellsCounter]));
          f_NR_ActivateVNG(valueof(p_CellsList[v_CellsCounter].CellId));
          v_CellsCounter := v_CellsCounter + 1;
      }
     
  }

    /*
   * @desc      Deactivate noise for listed cells
   * @param     p_CellsList
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_DeactivateVNG_MultipleCells(template (value) NR_CellIdList_Type p_CellsList ) runs on NR_BASE_PTC
  {
      var integer v_CellsCounter := 0;
      while (v_CellsCounter < lengthof(p_CellsList))
      {
         f_NR_DeactivateVNG(valueof(p_CellsList[v_CellsCounter]));
          v_CellsCounter := v_CellsCounter + 1;
      }
     
  }

   /*
   * @desc      Return list of cells with activated VNG
   * @param     p_CellsList
   * @return    template (value)  NR_CellIdList_Type
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetCellIdListWithActiveVNG(template (value) NR_CellNoiseLevelList_Type p_CellsList )  return template (value)  NR_CellIdList_Type
  {
      var template (value) NR_CellIdList_Type v_NR_CellIdList;
      var integer v_CellsCounter := 0;
      while (v_CellsCounter < lengthof(p_CellsList))
      {
         v_NR_CellIdList[v_CellsCounter] := p_CellsList[v_CellsCounter].CellId;
         v_CellsCounter := v_CellsCounter + 1;
      }
      
      return v_NR_CellIdList;
     
  }

}
