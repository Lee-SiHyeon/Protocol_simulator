module MCX_XML_mcpttLocationInfo {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttLocationInfo_1_0 language "XSD" all;

  type Location_info MCPTT_LocationInfo_Type;                                                  /* @status    APPROVED (MCX) */

  type TRequestedLocationType MCPTT_LocationInfo_RequestedLocation_Type;                       /* @status    APPROVED (MCX) */

  type TCurrentLocationType MCPTT_LocationInfo_CurrentLocation_Type;                           /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCPTT_LocInfo_EncryptedCurrentLocationElements := {            /* @status    APPROVED (MCX) */
    "CurrentServingEcgi",
    "NeighbouringEcgi",
    "MbmsSaId",
    "MbsfnArea",
    "CurrentCoordinate/longitude",
    "CurrentCoordinate/latitude"
  };

  template (value) MCPTT_LocationInfo_Type cs_MCPTT_LocationInfo_Configuration(template (value) TRequestedLocationType p_NonEmergencyLocationInformation := cs_MCPTT_RequestedLocation(10),
                                                                               template (value) TriggeringCriteriaType p_TriggeringCriteria := cs_MCPTT_TriggeringCriteria) :=
  { /* 36.579-1 Table 5.5.3.4.2-1: Location-info (Configuration sent by the SS) */
    /* @status    APPROVED (MCX) */
    attr := omit,
    choice := {
      configuration := {
        configScope := full,
        attr := omit,
        nonEmergencyLocationInformation := p_NonEmergencyLocationInformation,
        emergencyLocationInformation := cs_MCPTT_RequestedLocation(5),
        triggeringCriteria := p_TriggeringCriteria,
        elem_list := {},
        anyExt := {
          elem_list := {
            f_MCPTT_LocationInfo_EncodeEmergencyTriggeringCriteria(cs_MCPTT_TriggeringCriteria)    // @sic R5-212354 sic@
          }
        }
      }
    }
  };

  template (value) MCPTT_LocationInfo_RequestedLocation_Type cs_MCPTT_RequestedLocation(XSD.PositiveInteger p_MinimumIntervalLength) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    servingEcgi := {},                // present
    neighbouringEcgi_list := { {} },  // present (at least one element)
    mbmsSaId := {},                   // present
    mbsfnArea := {},                  // present
    geographicalCoordinate := {},     // present   @sic R5s201409 BASELINE MOVING 2020 geographicalCordinate -> geographicalCoordinate sic@
    minimumIntervalLength := p_MinimumIntervalLength,
    elem_list := {},
    anyExt := omit
  };

  template (value) TriggeringCriteriaType cs_MCPTT_TriggeringCriteria(template (omit) TIntegerAttributeType p_PeriodicReport := omit) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    cellChange := omit,
    trackingAreaChange := omit,
    plmnChange  := omit,
    mbmsSaChange  := omit,
    mbsfnAreaChange  := omit,
    periodicReport  := p_PeriodicReport,
    travelledDistance  := omit,
    mcpttSignallingEvent  := omit,
    geographicalAreaChange:= cs_MCPTT_GeographicalAreaChangeEmpty,
    elem_list := {},
    anyExt := omit
  };

  template (value) TGeographicalAreaChange cs_MCPTT_GeographicalAreaChangeEmpty :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    anyAreaChange := omit,
    enterSpecificAreaType := omit,          /* @sic R5s240535/R5-246423 BASELINE MOVING/CORRECTION Rel-18 2024: enterSpecificAreaType kept sic@ */
    exitSpecificAreaType := omit,           /* @sic R5s240535/R5-246423 BASELINE MOVING/CORRECTION Rel-18 2024: exitSpecificAreaType kept sic@ */
    elem_list := {},
    anyExt := omit
  };

  template (value) MCPTT_LocationInfo_Type cs_MCPTT_LocationInfo_Report(integer p_Longitude,
                                                                        integer p_Latitude) :=
  { /* 36.579-1 Table 5.5.3.4.4-1: Location-info (Report from the SS) for MCPTT */
    /* @status    APPROVED (MCX) */
    attr := omit,
    choice := {
      report := {
        reportID := omit,
        reportType := emergency,
        attr := omit,
        triggerId_list := {},  // @sic R5-216678: empty list as for test case 6.1.1.16 there should be no triggerId and there are no other cases sic@
        mcptt_reporting_uri := omit,   /* @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@ */
        currentLocation := {
          attr := omit,
          currentServingEcgi := omit,
          neighbouringEcgi_list := {},
          mbmsSaId := omit,
          mbsfnArea := omit,
          currentCoordinate := cs_MCPTT_PointCoordinate(p_Longitude, p_Latitude),
          elem_list := {},
          anyExt := omit
        },
        elem_list := {},
        anyExt := omit
      }
    }
  };

  template (value) TPointCoordinate cs_MCPTT_PointCoordinate(integer p_Longitude,
                                                             integer p_Latitude) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    longitude := cs_MCPTT_Coordinate(-, p_Longitude),
    latitude := cs_MCPTT_Coordinate(-, p_Latitude),
    elem_list := {},
    anyExt := omit
  };

  template (value) TCoordinateType cs_MCPTT_Coordinate(ProtectionType p_Protection := encrypted,
                                                       integer p_Value) :=
  { /* @status    APPROVED (MCX) */
    type_ := p_Protection,
    attr := omit,
    choice := {
      threebytes_list := { p_Value }
    }
  };

  /*
   * @desc      Encode EmergencyTriggeringCriteria
   * @param     p_EmergencyTriggeringCriteria
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_LocationInfo_EncodeEmergencyTriggeringCriteria(template (value) EmergencyTriggeringCriteria p_EmergencyTriggeringCriteria) return XSD.String
  {
    var bitstring v_EncodedTriggeringCriteria := encvalue(p_EmergencyTriggeringCriteria);
    return f_Bit2XsdString(v_EncodedTriggeringCriteria);
  }

  /*
   * @desc      Encode MCPTT Location Info
   * @param     p_LocationInfo
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_LocationInfo_Encode(template (value) Location_info p_LocationInfo) return XmlBody_Type
  {
    var bitstring v_EncodedLocationInfo := encvalue(p_LocationInfo);
    return f_Bit2XmlBody(v_EncodedLocationInfo);
  }

  /*
   * @desc      Encode and encrypt MCPTT Location Info Report (only the Report contains encrypted content)
   * @param     p_LocationInfo
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_LocationInfoReport_EncodeEncrypt(template (value) Location_info p_LocationInfo,
                                                    charstring p_MCServiceID,
                                                    template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_MCPTT_LocationInfo_Encode(p_LocationInfo);
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    for (i := 0; i < lengthof(tsc_MCPTT_LocInfo_EncryptedCurrentLocationElements); i := i + 1) {
      v_XmlPath := "//location-info/Report/CurrentLocation/" & tsc_MCPTT_LocInfo_EncryptedCurrentLocationElements[i];
      f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  template (present) MCPTT_LocationInfo_CurrentLocation_Type cr_MCPTT_CurrentLocation_Any :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    currentServingEcgi := *,
    neighbouringEcgi_list := { * },
    mbmsSaId := *,
    mbsfnArea := *,
    currentCoordinate := cr_MCPTT_PointCoordinate ifpresent,
    elem_list := {},
    anyExt := omit
  };

  template (present) MCPTT_LocationInfo_Type cr_MCPTT_LocationInfo_Report(template XSD.String p_ReportId := omit,
                                                                          TReportType.reportType p_ReportType := emergency,
                                                                          TReportType.triggerId_list p_TriggerIdList := {},
                                                                          template (present) TCurrentLocationType p_CurrentLocation := cr_MCPTT_CurrentLocation_Any) :=
  { /* 36.579-1 Table 5.5.3.4.1-1: Location-info (Report from the UE)
       @status    APPROVED (MCX) */
    attr := omit,
    choice := {
      report := {
        reportID := p_ReportId,
        reportType := p_ReportType,
        attr := omit,
        triggerId_list := p_TriggerIdList,
        mcptt_reporting_uri := omit,   /* @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@ */
        currentLocation := p_CurrentLocation,
        elem_list := {},
        anyExt := omit
      }
    }
  };

  template (present) TPointCoordinate cr_MCPTT_PointCoordinate(template (present) integer p_Longitude := ?,
                                                               template (present) integer p_Latitude := ?) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    longitude := cr_MCPTT_Coordinate(-, p_Longitude),
    latitude := cr_MCPTT_Coordinate(-, p_Latitude),
    elem_list := {},
    anyExt := omit
  };

  template (present) TCoordinateType cr_MCPTT_Coordinate(ProtectionType p_Protection := encrypted,
                                                         template (present) integer p_Value := ?) :=
  { /* @status    APPROVED (MCX) */
    type_ := p_Protection,
    attr := omit,
    choice := {
      threebytes_list := { p_Value }
    }
  };

  /*
   * @desc      Decode MCPTT Location Info
   * @param     p_XmlDocument
   * @return    MCPTT_LocationInfo_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_LocationInfo_Decode(XSD.String p_XmlDocument) return MCPTT_LocationInfo_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XmlDocument);
    var Location_info v_Location_info;

    if (decvalue(v_Bitstring, v_Location_info) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCPTT Location-Info");
    }
    return v_Location_info;
  }

  /*
   * @desc      Decrypt and decode MCPTT Location-Info
   *            In general Location-Info sent by the UE is a Report which contains <CurrentLocation> with encrypted information
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    MCPTT_LocationInfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_LocationInfo_DecryptDecode(XmlBody_Type p_XmlDocument,
                                              charstring p_MCServiceID,
                                              template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return MCPTT_LocationInfo_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var charstring v_ElementName;
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      for (i := 0; i < lengthof(tsc_MCPTT_LocInfo_EncryptedCurrentLocationElements); i := i + 1) {
        v_ElementName := tsc_MCPTT_LocInfo_EncryptedCurrentLocationElements[i];
        v_XmlPath := "//location-info/Report/CurrentLocation/" & v_ElementName;
        v_DecryptResult := f_XML_Document_DecryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, valueof(p_CSK));  // v_XmlDocument: inout parameter
        if (v_DecryptResult == NOT_ENCRYPTED) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, v_ElementName & " is not encrypted");
        }
      }
      fx_XML_Log(__FILE__, __LINE__, UPLINK, v_XmlDocument);
    }

    return fl_MCPTT_LocationInfo_Decode(v_XmlDocument);
  }

}
