  }

  /*
   * @desc      Assign SIB31 for all combinations for p_CellId
   * @param     p_CellId
   * @param     p_SIB31
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_CellInfo_SetSIB31(NBIOT_CellId_Type p_CellId,
                                    template (value) SystemInformationBlockType31_NB_r17 p_SIB31) runs on NBIOT_PTC
  {//@sic R5-235420, R5s230550, R5s240168, R5-251417 sic@
    var template (value) NBIOT_CellInfo_Type v_CellInfo := f_NBIOT_CellInfo_Get(p_CellId);
    var integer v_Index := f_NBIOT_CellInfo_Get_SI_Index(valueof(v_CellInfo.Sysinfo.Combination), 31);
    if (valueof(v_CellInfo.Sysinfo.Combination) != c9 and valueof(v_CellInfo.Sysinfo.Combination) != c14){
        v_CellInfo.Sysinfo.BCCH_Info.SIs[v_Index].message_.c1.systemInformation_r13.criticalExtensions.systemInformation_r13.sib_TypeAndInfo_r13[0].sib31_v1700 := p_SIB31;
    }
    else{
        v_CellInfo.Sysinfo.BCCH_Info.SIs[v_Index].message_.c1.systemInformation_r13.criticalExtensions.systemInformation_r13.sib_TypeAndInfo_r13[1].sib31_v1700 := p_SIB31;
    }
    f_NBIOT_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Modify value of ul_SyncValidityDuration_r17 in SIB32-NB, applicable only for NTN combinations c8 .. c13
   * @param     p_CellId
   * @param     p_UL_SyncValidityDuration_r17
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_CellInfo_ModifySIB31_UL_SyncValidityDuration_r17(NBIOT_CellId_Type p_CellId,
                                                                    SystemInformationBlockType31_NB_r17.servingSatelliteInfo_r17.ul_SyncValidityDuration_r17 p_UL_SyncValidityDuration_r17) runs on NBIOT_PTC
  {//@sic R5s240707 add changes sic@
    var SystemInformationBlockType31_NB_r17 v_SIB31_NB;
    v_SIB31_NB := f_NBIOT_CellInfo_GetSIB31(p_CellId);
    v_SIB31_NB.servingSatelliteInfo_r17.ul_SyncValidityDuration_r17 := p_UL_SyncValidityDuration_r17;
    f_NBIOT_CellInfo_SetSIB31(p_CellId, v_SIB31_NB);
  }

