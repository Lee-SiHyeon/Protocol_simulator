module IMS_EmergencyCall_UGC_IMS {

  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.11
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_11_2_11_IMS2() runs on IMS_PTC // @sic R5s160253 add. ch. sic@
  {
    f_IMS_PTC_Init(PDN_2); // @sic R5s160253 add. ch. sic@
    
    // Emergency call setup: 34.229-1 Annex C.22
    f_IMS_EmergencyCallSetup(A_2_1_A6); // @sic R5s140708 ch. 3.2 sic@
    
    // Inform EUTRA: IMS Call established.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // after this UE selects to UTRA ...
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.12
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_11_2_12_IMS2() runs on IMS_PTC // @sic R5s160253 add. ch. sic@
  {
    f_IMS_PTC_Init(PDN_2); // @sic R5s160253 add. ch. sic@
    
    // Emergency call setup: 34.229-1 Annex C.22
    f_IMS_EmergencyCallSetup(A_2_1_A6);
    
    // Inform EUTRA: IMS Call established.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // after this UE selects GERAN ...
  }

}
