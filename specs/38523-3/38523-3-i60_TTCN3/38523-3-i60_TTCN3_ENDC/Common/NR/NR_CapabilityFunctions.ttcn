         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_directSCG_SCellActivationResume_r16 on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //UE in FR1&FR2 case
      {
          if (not v_UE_NR_Capability_v1610_directSCG_SCellActivationResume_r16)
          {
             if (v_FR1_Add_UE_NR_Capabilities_v1610 and v_FR2_Add_UE_NR_Capabilities_v1610) // fail case: both FR1 and FR2 capabilities are reported and no IE in mac_Parameters_v1610
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
              if  (v_FR1_Add_UE_NR_Capabilities_v1610 or v_FR2_Add_UE_NR_Capabilities_v1610)  // fail cases: if IE in mac_Parameters_v1610 is reported but FR1 and/or FR2 capabilities are also reported
              {
                 f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
              }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if ((ispresent(v_Mac_Parameters_v1610_Common.directSCG_SCellActivationResume_r16)) or
              (ispresent(v_FR1_Add_UE_NR_Cap_directSCG_SCellActivationResume_r16.directSCG_SCellActivationResume_r16)) or (ispresent(v_FR2_Add_UE_NR_Cap_directSCG_SCellActivationResume_r16.directSCG_SCellActivationResume_r16))) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_directSCG_SCellActivationResume_r16 to false is inconsistent with reported capabilities for a Rel-16 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of directSCG_SCellActivation_r16 along with fr1-Add-UE-NR-Capabilities-v1610 and fr2-Add-UE-NR-Capabilities-v1610 for Rel-16 (and on) UEs.
                Note 27 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg_v1610
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_directSCG_SCellActivation_r16(UE_NR_Capability_v1610 p_ReceivedCapabilityMsg_v1610)
  { // @sic R5-241518 sic@
    var boolean v_UE_NR_Capability_v1610_directSCG_SCellActivation_r16 := false;
    var boolean v_FR1_Add_UE_NR_Capabilities_v1610 := false;
    var boolean v_FR2_Add_UE_NR_Capabilities_v1610 := false;
    var UE_NR_Capability_v1610 v_ReceivedCapabilityMsg_v1610 := p_ReceivedCapabilityMsg_v1610;
    var MAC_ParametersFRX_Diff_r16 v_Mac_Parameters_v1610_Common;
    var MAC_ParametersFRX_Diff_r16 v_FR1_Add_UE_NR_Cap_directSCG_SCellActivation_r16;
    var MAC_ParametersFRX_Diff_r16 v_FR2_Add_UE_NR_Cap_directSCG_SCellActivation_r16;

    if (ispresent(v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16)) { //case common IE UE_NR_Capability_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16
      v_Mac_Parameters_v1610_Common := v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16;
    }
    if (ispresent(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16)) { //case fr1
      v_FR1_Add_UE_NR_Cap_directSCG_SCellActivation_r16 := v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16;
    }
    if (ispresent(v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16)) { //case fr2
      v_FR2_Add_UE_NR_Cap_directSCG_SCellActivation_r16 := v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16;
    }

    if(pc_directSCG_SCellActivation_r16) {
      // check indication of UE_NR_Capability_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16
      if (ispresent(v_ReceivedCapabilityMsg_v1610.mac_Parameters_v1610.mac_ParametersFRX_Diff_r16.directSCG_SCellActivation_r16)) {
          v_UE_NR_Capability_v1610_directSCG_SCellActivation_r16 := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_ReceivedCapabilityMsg_v1610.fr1_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.directSCG_SCellActivation_r16)) {
          v_FR1_Add_UE_NR_Capabilities_v1610 := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_ReceivedCapabilityMsg_v1610.fr2_Add_UE_NR_Capabilities_v1610.mac_ParametersFRX_Diff_r16.directSCG_SCellActivation_r16)) {
          v_FR2_Add_UE_NR_Capabilities_v1610 := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_UE_NR_Capability_v1610_directSCG_SCellActivation_r16, v_FR1_Add_UE_NR_Capabilities_v1610, v_FR2_Add_UE_NR_Capabilities_v1610)))  //@sic R5s240547 sic@
      { // inconclusive case: UE does not report any IE for mac_ParametersFRX_Diff_r16.directSCG_SCellActivation_r16 but pc_directSCG_SCellActivation_r16 is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_directSCG_SCellActivation_r16 to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_UE_NR_Capability_v1610_directSCG_SCellActivation_r16) or v_FR1_Add_UE_NR_Capabilities_v1610 or v_FR2_Add_UE_NR_Capabilities_v1610)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_directSCG_SCellActivation_r16 on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //UE in FR1&FR2 case
      {
          if (not v_UE_NR_Capability_v1610_directSCG_SCellActivation_r16)
          {
             if (v_FR1_Add_UE_NR_Capabilities_v1610 and v_FR2_Add_UE_NR_Capabilities_v1610) // fail case: both FR1 and FR2 capabilities are reported and no IE in mac_Parameters_v1610
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
              if  (v_FR1_Add_UE_NR_Capabilities_v1610 or v_FR2_Add_UE_NR_Capabilities_v1610)  // fail cases: if IE in mac_Parameters_v1610 is reported but FR1 and/or FR2 capabilities are also reported
              {
                 f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
              }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if ((ispresent(v_Mac_Parameters_v1610_Common.directSCG_SCellActivation_r16)) or
              (ispresent(v_FR1_Add_UE_NR_Cap_directSCG_SCellActivation_r16.directSCG_SCellActivation_r16)) or (ispresent(v_FR2_Add_UE_NR_Cap_directSCG_SCellActivation_r16.directSCG_SCellActivation_r16))) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_directSCG_SCellActivation_r16 to false is inconsistent with reported capabilities for a Rel-16 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UE Capability message against the setting of the PICS declaring the support of twoPUCCH-AnyOthersInSlot along with fr1-Add-UE-NR-Capabilities and fr2-Add-UE-NR-Capabilities for Rel-15 (and on) UEs.
                Note 26 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_Check_twoPUCCH_AnyOthersInSlot(UE_NR_Capability p_ReceivedCapabilityMsg)
  {
    var boolean v_Phy_ParametersFRX_Diff_twoPUCCH_AnyOthersInSlot := false;
    var boolean v_FR1_Add_twoPUCCH_AnyOthersInSlot := false;
    var boolean v_FR2_Add_twoPUCCH_AnyOthersInSlot := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var Phy_ParametersFRX_Diff v_Phy_ParametersFRX_twoPUCCH_AnyOthersInSlot_Common;
    var Phy_ParametersFRX_Diff v_FR1_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot;
    var Phy_ParametersFRX_Diff v_FR2_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot;

    if (ispresent(v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersFRX_Diff)) { //case common IE phy_ParametersFRX_Diff
      v_Phy_ParametersFRX_twoPUCCH_AnyOthersInSlot_Common := v_ReceivedCapabilityMsg.phy_Parameters.phy_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff)) { //case fr1
      v_FR1_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff)) { //case fr2
      v_FR2_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.phy_ParametersFRX_Diff;
    }

    if(pc_twoPUCCH_AnyOthersInSlot) {
      // check indication of Phy_ParametersFRX_twoPUCCH_AnyOthersInSlot_Common
      if (ispresent(v_Phy_ParametersFRX_twoPUCCH_AnyOthersInSlot_Common.twoPUCCH_AnyOthersInSlot)) {
          v_Phy_ParametersFRX_Diff_twoPUCCH_AnyOthersInSlot := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot.twoPUCCH_AnyOthersInSlot)) {
          v_FR1_Add_twoPUCCH_AnyOthersInSlot := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot.twoPUCCH_AnyOthersInSlot)) {
          v_FR2_Add_twoPUCCH_AnyOthersInSlot := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_Phy_ParametersFRX_Diff_twoPUCCH_AnyOthersInSlot, v_FR1_Add_twoPUCCH_AnyOthersInSlot, v_FR2_Add_twoPUCCH_AnyOthersInSlot)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for twoPUCCH_AnyOthersInSlot but pc_twoPUCCH_AnyOthersInSlot is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_twoPUCCH_AnyOthersInSlot to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_Phy_ParametersFRX_Diff_twoPUCCH_AnyOthersInSlot) or v_FR1_Add_twoPUCCH_AnyOthersInSlot or v_FR2_Add_twoPUCCH_AnyOthersInSlot)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_twoPUCCH_AnyOthersInSlot on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //UE in FR1&FR2 case
      {
          if (not v_Phy_ParametersFRX_Diff_twoPUCCH_AnyOthersInSlot)
          {
             if (v_FR1_Add_twoPUCCH_AnyOthersInSlot and v_FR2_Add_twoPUCCH_AnyOthersInSlot) // fail case: both FR1 and FR2 capabilities are reported and no IE in phy_Parameters.phy_ParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
              if  (v_FR1_Add_twoPUCCH_AnyOthersInSlot or v_FR2_Add_twoPUCCH_AnyOthersInSlot)  // fail cases: if IE in phy_Parameters.phy_ParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
              {
                 f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
              }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_Phy_ParametersFRX_twoPUCCH_AnyOthersInSlot_Common.twoPUCCH_AnyOthersInSlot) or
              ispresent(v_FR1_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot.twoPUCCH_AnyOthersInSlot) or
              ispresent(v_FR2_Add_UE_NR_Cap_twoPUCCH_AnyOthersInSlot.twoPUCCH_AnyOthersInSlot)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_twoPUCCH_AnyOthersInSlot to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check some Rel 15 UE NR capabilities. Prints out all the PICS wrongly set specific within r15 v30 and v40
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NRCap_CommonChecks_r15(UE_NR_Capability p_NRCapability,
                                     NR_Configuration_Type p_Configuration_Type)
  { // @sic R5-213468 R5-213482 R5-227571 R5-227572 R5-227573 R5-231410 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;

    v_Received_NRCapabilityMsg := p_NRCapability;

    fl_Check_Rf_Parameters_NRBand_PICS_Supp(v_Received_NRCapabilityMsg, p_Configuration_Type);  //rf-Parameters and NR supported bands fully checked. Note 8, 9, 20 and 21 of Table UE-NR-Capability
    fl_Check_MeasAndMobParametersCommon(v_Received_NRCapabilityMsg, p_Configuration_Type);      //check conditions as per TS 38.306 clause 4.2.9

    fl_Check_featureSets_r15(v_Received_NRCapabilityMsg, p_Configuration_Type);            // @sic R5-225384 sic@ featureSets IEs
    fl_Check_NR_Notes(v_Received_NRCapabilityMsg);               // @sic R5-197070 sic@ Notes 1 to 18 on Table UE-NR-Capability
    fl_Check_NR_Capability_1540(v_Received_NRCapabilityMsg);     // UE-NR-Capability-1540 IEs checked
    fl_Check_PICSinOptionalGroups_NR_r15(v_Received_NRCapabilityMsg);     // PICS set in optional group of IEs checked in Rel-15
  } // end of fl_NRCap_CommonChecks_r15

  /*
   * @desc      Function to check applicable Rel 16 UE NR capabilities plus legacy releases
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NRCap_CommonChecks_r16(UE_NR_Capability p_NRCapability,
                                     NR_Configuration_Type p_Configuration_Type)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg := p_NRCapability;

    fl_NRCap_CommonChecks_r15(v_Received_NRCapabilityMsg, p_Configuration_Type);
    fl_Check_NR_Notes_r16(v_Received_NRCapabilityMsg); // Note 22 and Input(s) in field UE-NR-Capability-v1610 for Note 19, 23, 24, 25
    fl_Check_featureSets_r16(v_Received_NRCapabilityMsg);
    f_FeaturesDependencies_r16(v_Received_NRCapabilityMsg, p_Configuration_Type);

    fl_Check_PICSinOptionalGroups_NR_r16(v_Received_NRCapabilityMsg);     // PICS set in optional group of IEs checked in Rel-16
  } // end of fl_NRCap_CommonChecks_r16

  /*
   * @desc      Function to check applicable Rel 17 UE NR capabilities plus earlier releases
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NRCap_CommonChecks_r17(UE_NR_Capability p_NRCapability,
                                     NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-250329 R5-227571 R5-231410 R5s240547 R5-246407 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    v_Received_NRCapabilityMsg := p_NRCapability;

    fl_NRCap_CommonChecks_r16(v_Received_NRCapabilityMsg, p_Configuration_Type);

    fl_Check_featureSets_r17(v_Received_NRCapabilityMsg);
    f_FeaturesDependencies_r17(v_Received_NRCapabilityMsg, p_Configuration_Type);

    fl_Check_PICSinOptionalGroups_NR_r17(v_Received_NRCapabilityMsg);     // PICS set in optional group of IEs checked in Rel-17
  } // end of fl_NRCap_CommonChecks_r17

  /*
   * @desc      Function to check applicable Rel 18 UE NR capabilities plus earlier releases
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NRCap_CommonChecks_r18(UE_NR_Capability p_NRCapability,
                                     NR_Configuration_Type p_Configuration_Type)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    v_Received_NRCapabilityMsg := p_NRCapability;

    fl_NRCap_CommonChecks_r17(v_Received_NRCapabilityMsg, p_Configuration_Type); // (e)RedCap IEs already checked in Rel-17 with fl_SupportOfRedCap_IEs

    f_FeaturesDependencies_r18();
    fl_Check_PICSinOptionalGroups_NR_r18(v_Received_NRCapabilityMsg);     // PICS set in optional group of IEs checked in Rel-18

  } // end of fl_NRCap_CommonChecks_r18

  /*
   * @desc      Function to match the received UECapabilityInformation with the expected UE-NR-Capability template
   * @param     p_ReceivedCapabilityMsg
   * @param     p_Expected_Ue_NR_Capability
   * @param     p_OutputText        (default value: "")
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_UE_Capability_MatchTemplates(UE_NR_Capability p_ReceivedCapabilityMsg,
                                             template UE_NR_Capability p_Expected_Ue_NR_Capability,
                                             charstring p_OutputText := "") return boolean
  {
    var boolean v_Result := true;
    // Match the received decoded UE_NR_Capability template with the expected template
    if (not match(p_ReceivedCapabilityMsg, p_Expected_Ue_NR_Capability)) {
      f_SetVerdict(fail, __FILE__, __LINE__, p_OutputText);
      v_Result := false;
    }
    return v_Result;
  }

  /*
   * @desc      Function that indicates whether UE supports single frequency range (FR1 or FR2), or the UE supports both frequency ranges (FR1 and FR2) acc. to pc_nrFR1 and pc_nrFR2
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_FreqRangeFr1AndFR2 () return boolean
  {
    // note: as per prose, there is no mandatory check to confirm that either pc_nrFR1 or pc_nrFR2 must be true
    return (pc_nrFR1 and pc_nrFR2);
  }

  /*
   * @desc      Function to match the received UECapabilityInformation with the expected UECapabilityInformation.
   * @param     p_NRCapability
   * @param     p_MRDC_Capability
   * @param     p_OutputText
   * @param     p_OutputText2
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function f_NR_EUTRANR_FullCapabilityCheck (UE_NR_Capability p_NRCapability,
                                             UE_MRDC_Capability p_MRDC_Capability,
                                             charstring p_OutputText,
                                             charstring p_OutputText2,
                                             NR_Configuration_Type p_Configuration_Type)
  {
     f_NR_NRFullCapabilityCheck (p_NRCapability,
                                 p_OutputText,
                                 p_OutputText2,
                                 p_Configuration_Type);
     f_NR_MRDCFullCapabilityCheck (p_MRDC_Capability, p_NRCapability.accessStratumRelease, p_Configuration_Type);
  }

  /*
   * @desc      Function to match the received UECapabilityInformation with the expected UECapabilityInformation
   * @param     p_NRCapability
   * @param     p_OutputText        (default value: "PICS for condition on (pc_nrFDD or pc_nrTDD) not set")
   * @param     p_OutputText2       (default value: "Received UE Capability template does not match with the expected template")
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_NRFullCapabilityCheck (UE_NR_Capability p_NRCapability,
                                       charstring p_OutputText := "PICS for condition on (pc_nrFDD or pc_nrTDD) not set",
                                       charstring p_OutputText2 := "Received UE Capability template does not match with the expected template",
                                       NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-194844 R5-225384 R5-227571 R5-227572 R5-227573 R5-231410 sic@
    var UE_NR_Capability v_Received_NRCapability;
    var template UE_NR_Capability v_NRCapability;

     if ((not (pc_nrFDD or pc_nrTDD))){
        FatalError(__FILE__, __LINE__, p_OutputText);
     }

     v_Received_NRCapability := p_NRCapability;

     select (v_Received_NRCapability.accessStratumRelease) {
         case (spare4, spare3, spare2, spare1) {  /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
              f_SetVerdictInconc (__FILE__, __LINE__, "AccessStratumRelease < rel15");
              // a UE implementing relesase older than rel15 is not considered
         }
         case (rel15) { // @sic R5s200028 R5s200542 sic@
           v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r15; // check on Rel 15 IEs vs. IEs provided

           fl_NRCap_CommonChecks_r15(v_Received_NRCapability, p_Configuration_Type);

         }
         case (rel16) { /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
           v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r16; // check on Rel 16 IEs vs. IEs provided

           fl_NRCap_CommonChecks_r16(v_Received_NRCapability, p_Configuration_Type);

         }
         case (rel17) { /* @sic R5s221179 BASELINE MOVING 2022 sic@ */
           if (p_Configuration_Type == NR_SA) {

              v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r17_RedCap; // check on Rel 17 IEs vs. IEs provided in UE-NR-Capability as per Table 8.1.5.1.1.3.3-3
           }
           else {
              v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r17;        // check on Rel 17 IEs vs. IEs provided in UE-NR-Capability as per Tables 8.2.1.1.1.3.3-6 and Table 8.2.1.1.2.3.3-4
           }

           fl_NRCap_CommonChecks_r17(v_Received_NRCapability, p_Configuration_Type);
          }
         case (rel18) { /* @sic R5s240531 BASELINE MOVING 2024 sic@ */
           if (p_Configuration_Type == NR_SA) {

              v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r18_RedCap; // check on Rel 18 IEs vs. IEs provided in UE-NR-Capability as per Table 8.1.5.1.1.3.3-3
           }
           else {
              v_NRCapability := cr_UeCapabilitiesRAT_Container_NR_r18;        // check on Rel 18 IEs vs. IEs provided in UE-NR-Capability as per Tables 8.2.1.1.1.3.3-6 and Table 8.2.1.1.2.3.3-4
           }

           fl_NRCap_CommonChecks_r18(v_Received_NRCapability, p_Configuration_Type);
         }
         case else  {
           f_SetVerdictInconc (__FILE__, __LINE__, "AccessStratumRelease not applicable");
           // a UE implementing an unsupported release must not be failed
         }
    }
    // Match the received UE-NR-CapabilityInformation with the expected UE_NR_Capability template
    fl_NR_UE_Capability_MatchTemplates(v_Received_NRCapability, v_NRCapability, p_OutputText2);
  }

}
