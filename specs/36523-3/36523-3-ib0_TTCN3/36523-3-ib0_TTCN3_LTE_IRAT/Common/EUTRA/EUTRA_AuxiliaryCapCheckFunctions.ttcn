                                 f_ConvertBoolToBit(pc_eBand88_Supp) & //@sic R5-205088 sic@
                                 p_BitValuseForUndefinedBand &//Band 89 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 90 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 91 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 92 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 93 not yet defined
