                                                            template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig,
                                                            template (omit) PhysicalCellGroupConfig p_PhysicalCellGroupConfig,
                                                            template (omit) SpCellConfig p_SpCellConfig,
                                                            template (omit) NR_SCellToAddModList_Type p_SCellConfig := omit,
                                                            template (omit) NR_SCellToReleaseList_Type p_SCellIndex := omit,
                                                            template (omit) CellGroupConfig.reportUplinkTxDirectCurrent p_ReportUplinkTxDirectCurrent := omit
