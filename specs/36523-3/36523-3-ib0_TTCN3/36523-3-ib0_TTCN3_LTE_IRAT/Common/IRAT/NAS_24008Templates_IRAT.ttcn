    priorityLvl     := p_PriorityLevel, // @sic R5-140684 sic@
    addUpdateParams := cr_AddUpdateParams_Any ifpresent,  /* cl. 10.3.14 O TV 1 IEI=0xC- @sic R5s120178 Baseline Moving sic@*/
    deviceProperties := cr_DeviceProperties('D'H) ifpresent /* cl. 10.5.7.8 O TV 1 IEI=0xD- @sic R5s120178 Baseline Moving sic@*/
  };

