  template (value) PhysicalConfigDedicatedSCell_r10 cds_508_PhysicalConfigDedicated_Default_SCell_AddMod_eIMTA(template (omit) DedicatedSCell_UL_Configuration_Type p_SCell_UL_Configuration := omit,
                                                                                                               template (value) AntennaInfoDedicated_r10 p_AntennaInfoDedicated := cs_AntennaInfoDedicated_r10,
