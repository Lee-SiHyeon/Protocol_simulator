module CDMA2000_Component {

  import from CDMA2000_ASP_TypeDefs all;
  import from CDMA2000_CellInfo all;
  import from CommonIratDefs all;
  import from UpperTesterPtcToMtcDefs all;

  type record CDMA2000_Ctrl_Type {      /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    default                     Default,
    boolean                     TestBody
  };

  type record CDMA2000_Global_Type {    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    CDMA2000_Ctrl_Type          Ctrl,
    CDMA2000_CellArray_Type     CellArray
  };

  type component CDMA2000_PTC {         /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    var  CDMA2000_Global_Type           vc_CDMA2000_Global;
    port IRAT_CO_ORD_PORT               EUTRA;

    port CDMA2000_SYSTEM_PORT           SYS;
    port CDMA2000_SYSCMD_IND_PORT       SYSCMD_IND;
    port CDMA2000_RLP_FLOW_PORT         RLP_FLOW;
    
    port UT_PTC_MTC_PORT                UT;
  };

  type component CDMA2000_SYSTEM {                              /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT) */
    port CDMA2000_SYSTEM_PORT        CDMA2000_SYS;
    port CDMA2000_SYSCMD_IND_PORT    CDMA2000_SYSCMD_IND;
    port CDMA2000_RLP_FLOW_PORT      CDMA2000_RLP_FLOW;
  };

  /*
   * @desc      Map CDMA2000's system ports
   * @param     p_System
   * @param     p_Cdma2000
   * @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT)
   */
  function f_CDMA2000_PTC_Map(CDMA2000_SYSTEM p_System,
                              CDMA2000_PTC p_Cdma2000)
  {
    map(p_Cdma2000:SYS,        p_System:CDMA2000_SYS);
    map(p_Cdma2000:SYSCMD_IND, p_System:CDMA2000_SYSCMD_IND);
    map(p_Cdma2000:RLP_FLOW,   p_System:CDMA2000_RLP_FLOW);
  }

}
