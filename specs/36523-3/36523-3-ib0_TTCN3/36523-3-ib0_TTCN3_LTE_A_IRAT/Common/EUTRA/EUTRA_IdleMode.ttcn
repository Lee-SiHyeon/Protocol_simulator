module EUTRA_IdleMode {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_AuxiliaryCapCheckFunctions all;
  import from EUTRA_CapabilityFunctions all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_NASSteps all;
  import from EUTRA_SysInfo_Templates all;

  type CarrierFreqUTRA_FDD.p_MaxUTRA P_MaxUTRA_FDD;  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type CarrierFreqUTRA_FDD.q_QualMin Q_QualMin_FDD;  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const float tsc_IdleMode_GenericTimer := 360.0;               /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */

  template (value) CarrierFreqUTRA_FDD cs_CarrierFreqUTRA_FDD_Common(ARFCN_ValueEUTRA                         p_ARFCN_ValueUTRA,
                                                                     template (omit) CellReselectionPriority p_CellReselectionPriority := 3,
                                                                     ReselectionThreshold                    p_ThreshX_High := 2,
                                                                     ReselectionThreshold                    p_ThreshX_Low  := 1,
                                                                     Q_RxLevMin                              p_Q_RxLevMin   := -40,
                                                                     P_MaxUTRA_FDD                           p_P_MaxUTRA    := 21,
                                                                     Q_QualMin_FDD                           p_Q_QualMin    := -24,
                                                                     template (omit) CarrierFreqUTRA_FDD_threshX_Q_r9_Type p_CarrierFreqUTRA_FDD_threshX_Q_r9 := omit) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    /* @sic R5s120964: new parameter p_CarrierFreqUTRA_FDD_threshX_Q_r9 sic@ */
    /* @sic R5-165892:  p_EUTRA_CarrierFreq -> ARFCN_ValueEUTRA sic@ */
    carrierFreq             := p_ARFCN_ValueUTRA,
    cellReselectionPriority := p_CellReselectionPriority,
    threshX_High            := p_ThreshX_High,
    threshX_Low             := p_ThreshX_Low,
    q_RxLevMin              := p_Q_RxLevMin,
    p_MaxUTRA               := p_P_MaxUTRA,
    q_QualMin               := p_Q_QualMin,
    threshX_Q_r9            := p_CarrierFreqUTRA_FDD_threshX_Q_r9       /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
  };

  template (value) CarrierFreqUTRA_TDD cs_CarrierFreqUTRA_TDD_Common(ARFCN_ValueUTRA                         p_ARFCN_ValueUTRA,
                                                                     template (omit) CellReselectionPriority p_CellReselectionPriority := 3,
                                                                     ReselectionThreshold                    p_ThreshX_High := 2,
                                                                     ReselectionThreshold                    p_ThreshX_Low  := 1,
                                                                     Q_RxLevMin                              p_Q_RxLevMin   := -40,
                                                                     P_MaxUTRA_FDD                           p_P_MaxUTRA    := 21) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    carrierFreq             := p_ARFCN_ValueUTRA,
    cellReselectionPriority := p_CellReselectionPriority,
    threshX_High            := p_ThreshX_High,
    threshX_Low             := p_ThreshX_Low,
    q_RxLevMin              := p_Q_RxLevMin,
    p_MaxUTRA               := p_P_MaxUTRA
  };

  template (value) CarrierFreqUTRA_FDD cs_CarrierFreqUTRA_FDD_CRPrio_PMax(ARFCN_ValueUTRA                         p_ARFCN_ValueUTRA,
                                                                          template (omit) CellReselectionPriority p_CellReselectionPriority,
                                                                          P_MaxUTRA_FDD                           p_P_MaxUTRA) :=
  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cs_CarrierFreqUTRA_FDD_Common(p_ARFCN_ValueUTRA, p_CellReselectionPriority, -, -, -, p_P_MaxUTRA); //@sic R5s110168 sic@

  template (value) CarrierFreqUTRA_TDD cs_CarrierFreqUTRA_TDD_CRPrio_PMax(ARFCN_ValueUTRA                         p_ARFCN_ValueUTRA,
                                                                          template (omit) CellReselectionPriority p_CellReselectionPriority,
                                                                          P_MaxUTRA_FDD                           p_P_MaxUTRA) :=
  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cs_CarrierFreqUTRA_TDD_Common(p_ARFCN_ValueUTRA, p_CellReselectionPriority, -, -, -, p_P_MaxUTRA);

  template (value) SystemInformationBlockType1_v890_IEs cs_SystemInformationBlockType1_v890_IEs(template (omit) CellSelectionInfo_v920 p_CellSelectionInfo := omit,
                                                                                                template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R12, LTE_IRAT) */
    lateNonCriticalExtension := omit,
    nonCriticalExtension := {
      ims_EmergencySupport_r9 := omit,
      cellSelectionInfo_v920 := p_CellSelectionInfo,
      nonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_Cat0_ECallOverIMS(p_Category0Allowed) //@sic R5-151975 R5-176132 sic@
    }
  };

  template (value) CellSelectionInfo_v920 cs_CellSelectionInfo_v920(template (omit) Q_QualMin_r9 p_Q_QualMin_r9 := omit,
                                                                    template (omit) integer      p_Q_QualMinOffset_r9 := omit) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT) */
    q_QualMin_r9 := p_Q_QualMin_r9,
    q_QualMinOffset_r9 := p_Q_QualMinOffset_r9
  };

  template (value) IdleModeMobilityControlInfo_v9e0 cs_IdleModeMobCntrlInfo_v9e0_1Entry(ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell1) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT, NR5GC_IRAT) */
    freqPriorityListEUTRA_v9e0 := {
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell1
      }
    }
  };

  /*
   * @desc      Function used in Idle Mode test cases to perform Tracking Area Update on the new EUTRA cell upon
   *            mobility from another RAT
   * @param     p_CellId .. The EUTRA cell on which the random access request and the TAU will happen
   * @param     p_PDPContext    Set to true if UE has earlier established PDP context on other RAT
   * @param     p_PreambleOnLTE    Set to true if UE performed the preamble on the LTE cell (and so configured the default bearer)
   * @param     p_EUTRA_Cap
   * @param     p_ForcedAttach      (default value: NORMAL)
   * @status    APPROVED (LTE_A_IRAT, LTE_IRAT)
   */
  function f_EUTRA_IdleMode_TAU_UponMobility_FromOtherRAT(EUTRA_CellId_Type p_CellId,
                                                          boolean p_PDPContext,
                                                          boolean p_PreambleOnLTE,
                                                          template (omit) octetstring p_EUTRA_Cap,   // @sic R5-123734 sic@
                                                          EUTRA_ATTACH_Type p_ForcedAttach := NORMAL) runs on EUTRA_PTC
  { /* @sic R5-110746 sic@ */
    timer t_IdleMode_GenericTimer := tsc_IdleMode_GenericTimer;

    t_IdleMode_GenericTimer.start;
    f_EUTRA_508CheckCampOnNewEutraCellUponMobilityFromAnotherRAT(p_CellId, p_PDPContext, p_PreambleOnLTE, p_EUTRA_Cap, p_ForcedAttach); // @sic R5s110176, R5-135075, R5-140325 sic@
    t_IdleMode_GenericTimer.stop;
  }

  /*
   * @desc  Check that a Band is not supported by UE
   * @param     p_Band
   * @param     p_EUTRA_Cap         (default value: omit)
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_IRAT)
   */
  function f_EUTRA_CheckNotSupportedBand(integer p_Band,
                                         template (omit) octetstring p_EUTRA_Cap := omit) runs on EUTRA_PTC
  {
    var bitstring v_SuppEutraBandsAccToPICS := f_DeriveSuppEutraBandsFromPics();
    var bitstring v_SuppEutraBandsAccToPICS_v9e0 := f_DeriveSuppEutraBandsFromPics_v9e0(); //@sic R5s250360 sic@
    var UE_EUTRA_Capability v_EUTRA_Cap;
    var SupportedBandListEUTRA v_EUTRA_BandListReported;
    var template(omit) SupportedBandListEUTRA_v9e0 v_SupportedBandListEUTRA_v9e0; //@sic R5s250360 sic@
    var UE_EUTRA_Capability_v9a0_IEs v_UE_EUTRA_Capability_v9a0_IEs;
    var bitstring v_UE_EUTRA_Capability_v9a0_IEsContainer;
    var boolean v_BandReported := false;
    var integer v_BandEUTRA_v9e0;
    var integer i:=0;
    var integer v_Result;

    if (isvalue(p_EUTRA_Cap)) {  //@sic R5s150635 change 2 sic@
        v_EUTRA_Cap := f_EUTRA_DecodeEutraCapMsg(valueof(p_EUTRA_Cap));
    } else {
        v_EUTRA_Cap := f_EUTRA_MobileInfo_GetUECapability();
    }
    v_EUTRA_BandListReported := v_EUTRA_Cap.rf_Parameters.supportedBandListEUTRA; //@sic R5s150635 change 2 sic@
    if (p_Band > 64 ) { //@sic R5s200365 sic@
        if (isvalue(v_EUTRA_Cap.nonCriticalExtension.nonCriticalExtension.lateNonCriticalExtension)) {
            v_UE_EUTRA_Capability_v9a0_IEsContainer := oct2bit(v_EUTRA_Cap.nonCriticalExtension.nonCriticalExtension.lateNonCriticalExtension);
            v_Result := decvalue(v_UE_EUTRA_Capability_v9a0_IEsContainer, v_UE_EUTRA_Capability_v9a0_IEs);
            if (v_Result != 0) {
                FatalError(__FILE__, __LINE__, "UE_EUTRA_Capability_v9a0_IEs cannot be decoded");
            }
            if (isvalue(v_UE_EUTRA_Capability_v9a0_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.rf_Parameters_v9e0.supportedBandListEUTRA_v9e0)){ //@sic R5s250295 R5s250360 sic@
                v_SupportedBandListEUTRA_v9e0 := v_UE_EUTRA_Capability_v9a0_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.rf_Parameters_v9e0.supportedBandListEUTRA_v9e0;
            }
        } else {
            f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE_EUTRA_Capability_v9a0_IEs not provided");
        }
    }
    //Check the band support against the PICS
    if ((v_SuppEutraBandsAccToPICS[p_Band-1] == '1'B)) {
        f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Band is wrongly reported as supported in the PICS");
    }
    //Check the band support against the PICS (extended bands) @sic R5s250360 sic@
    if ((v_SuppEutraBandsAccToPICS_v9e0[p_Band-65] == '1'B)) { // maxFBI + 1
        f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Band is wrongly reported as supported in the PICS");
    }

    //Check the band support against the UE capabilities
    if ( p_Band < 64){
        for (i:=0; (i < lengthof(v_EUTRA_BandListReported) and v_BandReported==false) ; i:=i+1) {
            if (v_EUTRA_BandListReported[i].bandEUTRA == p_Band){
                v_BandReported:= true;
            }
        }
    } else { //Band > 64 @sic R5s200365, R5s250360 sic@
        if (isvalue(v_SupportedBandListEUTRA_v9e0)) {
            for (i:=0; (i < lengthof(v_SupportedBandListEUTRA_v9e0) and v_BandReported==false) ; i:=i+1) {
                if (isvalue(v_SupportedBandListEUTRA_v9e0[i].bandEUTRA_v9e0)) {
                    v_BandEUTRA_v9e0 := valueof(v_SupportedBandListEUTRA_v9e0[i].bandEUTRA_v9e0);
                    if (v_BandEUTRA_v9e0 == p_Band) {
                        v_BandReported:= true;
                    }
                }
            }
        }
    }
    if (v_BandReported) {
      f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Band is wrongly reported as supported in UE capabilities");
    }
  }

}
