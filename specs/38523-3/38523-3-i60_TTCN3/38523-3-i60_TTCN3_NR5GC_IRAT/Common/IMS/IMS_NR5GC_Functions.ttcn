module IMS_NR5GC_Functions {

  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_eCall_Functions all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Generic Test Procedure for IMS side of the MO Speech call establishment in NR (TS 38.508-1 cl. 4.9.16)
   *            This takes care of if the UE supports preconditions (A.5.1) or not (A.5.2)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_IMS_NR5GC_MTSpeechCall() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var IMS_DATA_RSP v_IMS_DATA_RSP;

    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Start MT Speech IMS");                                                   // @sic R5-225362 sic@

    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(pc_Preconditions);                            // @sic R5-246483: EVS_A2 instead of EVS_B0_A1 sic@
    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_5(v_InviteRequestWithSdp, pc_Preconditions);       // @sic R5-246483: EVS_A2 instead of EVS_B0_A1 sic@

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Add Voice Bearer"));                                 // @sic R5-225362 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Voice Bearer Added");          // @sic R5s250362 sic@
    if (pc_Preconditions) {
      f_IMS_MTCallSetup_NR5GC_A_5_1a_Step6_7(v_InviteRequestWithSdp, v_ResponseWithSdp);
    }
    a_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, -, v_IMS_DATA_RSP);
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);   // @sic R5s250362 sic@

    // Call established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Voice Call Established"));                           // @sic R5-225362 sic@
  }

  /*
   * @desc  Generic Test Procedure for IMS side of eCall establishment in NR
   *        38.508-1 4.9.11
   * @param     p_ECallType
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_IMS_NR5GC_ECall (ECall_Type p_ECallType) runs on IMS_PTC
  {
    // Steps 1- 7
    f_ECall_CallSetup_A_23 (p_ECallType);
    // Inform NR: eCall established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));
  }

}
