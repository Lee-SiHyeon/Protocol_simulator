/******************************************************************************/
module NR5GC_LoopBack {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};   
  import from Common4G5G_LoopBack all;
  import from CommonDefs all;
  import from CommonIP all;
  import from EPS_NAS_LoopBack_TypeDefs all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from NAS_CommonTemplates all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;

  template (value) NG_NAS_DL_Message_Type  cs_NR_CLOSE_UE_TEST_LOOP_ModeA(template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_LB_Setup) :=
  { /* parameter is mandatory since "UE_TestLoopMode := tsc_UE_TestLoopMode_TypeA */
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    close_Ue_Test_Loop:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                          /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                   /*    M V 1/2    */
      messageType              := tsc_MsgType_CloseUE_TestLoop,                   /*    M V 1      */
      ueTestLoopMode           := tsc_UE_TestLoopMode_TypeA,                      /*    M V 1      */
      ueTestLoopModeA_LB_Setup := p_UE_TestLoopModeA_LB_Setup,                    /*    C LV 1-16  */
      ueTestLoopModeB_LB_Setup := omit,                                           /*    C V 1      */
      ueTestLoopModeC_LB_Setup := omit,                                           /*    C V 3 @sic R5s240546 sic@ */
      ueTestLoopModeE_LB_Setup := omit
    }
  };

  template (value) NG_NAS_DL_Message_Type cs_NR_CLOSE_UE_TEST_LOOP_ModeB(UE_TestLoopModeB_LB_Setup_Type p_TlModeB_Setup) :=
  { /* parameter is mandatory since "UE_TestLoopMode := tsc_UE_TestLoopMode_TypeB */
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    close_Ue_Test_Loop:= {
      skipIndicator             := tsc_Gen_SkipIndicator,
      protocolDiscriminator     := tsc_LB_ProtocolDiscriminator,
      messageType               := tsc_MsgType_CloseUE_TestLoop,
      ueTestLoopMode            := tsc_UE_TestLoopMode_TypeB,
      ueTestLoopModeA_LB_Setup  := omit,
      ueTestLoopModeB_LB_Setup  := p_TlModeB_Setup,
      ueTestLoopModeC_LB_Setup := omit,                                           /*    C V 3 @sic R5s240546 sic@ */
      ueTestLoopModeE_LB_Setup  := omit
    }
  };

  template (value) NG_NAS_DL_Message_Type  cs_NR_CLOSE_UE_TEST_LOOP_ModeC(template (value) NR_UE_TestLoopModeC_LB_Setup_Type p_UE_TestLoopModeC_LB_Setup):=
  { /* parameter is mandatory since "UE_TestLoopMode := tsc_UE_TestLoopMode_TypeC */
    /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    close_Ue_Test_Loop:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                          /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                   /*    M V 1/2    */
      messageType              := tsc_MsgType_CloseUE_TestLoop,                   /*    M V 1      */
      ueTestLoopMode           := tsc_UE_TestLoopMode_TypeC,                      /*    M V 1      */
      ueTestLoopModeA_LB_Setup := omit,                                           /*    C LV 1-16  */
      ueTestLoopModeB_LB_Setup := omit,                                           /*    C V 1      */
      ueTestLoopModeC_LB_Setup := p_UE_TestLoopModeC_LB_Setup,  //@sic eMBMS sic@
      ueTestLoopModeE_LB_Setup := omit
    }
  };

  template (present) NG_NAS_UL_Message_Type  cr_NR_CLOSE_UE_TEST_LOOP_COMPLETE :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    close_Ue_Test_Loop_Complete:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_CloseUE_TestLoopCmpl                  /*    M V 1      */
    }
  };

  template (value) NG_NAS_DL_Message_Type  cs_NR_ACTIVATE_TEST_MODE (UE_TestLoopMode_Type p_UE_TestLoopMode) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    activate_Test_Mode:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Activate_TestMode,                    /*    M V 1      */
      ueTestLoopMode           := p_UE_TestLoopMode                                 /*    M V 1      */
    }
  };

  template (present) NG_NAS_UL_Message_Type  cr_NR_ACTIVATE_TEST_MODE_COMPLETE :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    activate_Test_Mode_Complete:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Activate_TestModeCmpl                 /*    M V 1      */
    }
  };

  template (value) NG_NAS_DL_Message_Type  cs_NR_DEACTIVATE_TEST_MODE :=
  { /* @status    APPROVED (NR5GC) */
    deactivate_Test_Mode:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Deactivate_TestMode                   /*    M V 1      */
    }
  };

  template (present) NG_NAS_UL_Message_Type  cr_NR_DEACTIVATE_TEST_MODE_COMPLETE :=
  { /* @status    APPROVED (NR5GC) */
    deactivate_Test_Mode_Complete:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_Deactivate_TestModeCmpl               /*    M V 1      */
    }
  };

  template (value) NG_NAS_DL_Message_Type  cs_NR_OPEN_UE_TEST_LOOP :=
  { /* @status    APPROVED (NR5GC) */
    open_Ue_Test_Loop:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_OpenUE_TestLoop                       /*    M V 1      */
    }
  };

  template (present) NG_NAS_UL_Message_Type  cr_NR_OPEN_UE_TEST_LOOP_COMPLETE :=
  { /* @status    APPROVED (NR5GC) */
    open_Ue_Test_Loop_Complete:= {
      skipIndicator            := tsc_Gen_SkipIndicator,                            /*    M V 1/2    */
      protocolDiscriminator    := tsc_LB_ProtocolDiscriminator,                     /*    M V 1/2    */
      messageType              := tsc_MsgType_OpenUE_TestLoopCmpl                   /*    M V 1      */
    }
  };

  template (value) NG_NAS_DL_Message_Type  cs_NR5GC_SET_UL_MESSAGE_REQUEST (B1_Type p_UsePreconfigured) :=
  { /* @status    APPROVED (NR5GC) */
    set_UL_Message_Request := cs_SET_UL_MESSAGE_REQUEST (p_UsePreconfigured)
  };

  template (present) NG_NAS_UL_Message_Type  cr_NR5GC_SET_UL_MESSAGE_RESPONSE :=
  { /* @status    APPROVED (NR5GC) */
    set_UL_Message_Response := cr_SET_UL_MESSAGE_RESPONSE
  };

  /*
   * @desc      Close test loop mode A at the UE
   * @param     p_NR_CellId
   * @param     p_UE_TestLoopModeA_NR_LB_Setup
   * @param     p_NR_RoutingInfoSUL (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CloseUE_TestLoopModeA(NR_CellId_Type p_NR_CellId,
                                         template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup,
                                         template (omit) NR_RoutingInfoSUL_Type p_NR_RoutingInfoSUL := omit)
    runs on NR_BASE_PTC
  {
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;
    
    f_IP_Routing_ChangeToRawmode(IP);
    
    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_CLOSE_UE_TEST_LOOP_ModeA(p_UE_TestLoopModeA_NR_LB_Setup))));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_CLOSE_UE_TEST_LOOP_COMPLETE), p_NR_RoutingInfoSUL));
  }

  /*
   * @desc      Close test loop mode B at the UE
   * @param     p_NR_CellId
   * @param     p_IpPduDelayTime
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CloseUE_TestLoopModeB(NR_CellId_Type p_NR_CellId,
                                         UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime)
    runs on NR_BASE_PTC
  {
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;
    
    f_IP_Routing_ChangeToRawmode(IP);

    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_CLOSE_UE_TEST_LOOP_ModeB(p_IpPduDelayTime))));
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_CLOSE_UE_TEST_LOOP_COMPLETE)));
  }

  /*
   * @desc      Close test loop mode C at the UE
   * @param     p_NR_CellId
   * @param     p_UE_TestLoopModeC_LB_Setup
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CloseUE_TestLoopModeC(NR_CellId_Type p_NR_CellId,
                                         template (value) NR_UE_TestLoopModeC_LB_Setup_Type p_UE_TestLoopModeC_LB_Setup)
    runs on NR_BASE_PTC
  {
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;
    
    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_CLOSE_UE_TEST_LOOP_ModeC(p_UE_TestLoopModeC_LB_Setup))));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_CLOSE_UE_TEST_LOOP_COMPLETE)));
  }

  /*
   * @desc      open test loop at the UE (independent from mode A or B)
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_OpenUE_TestLoopMode(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;

    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_OPEN_UE_TEST_LOOP)));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_OPEN_UE_TEST_LOOP_COMPLETE)));
    
    f_IP_Routing_RestoreRoutingTable(IP); // @sic R5s201373 sic@
  }

  /*
   * @desc      activate test mode at the UE side
   * @param     p_NR_CellId
   * @param     p_UE_TestLoopMode
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_Activate_TestMode(NR_CellId_Type p_NR_CellId,
                                     UE_TestLoopMode_Type p_UE_TestLoopMode,
                                     NR_RadioBearerId_Type p_SRB:= tsc_NR_RbId_SRB1) runs on NR5GC_PTC // @sic R5s230095 sic@
  {
    var NR_RadioBearerId_Type v_SRB := p_SRB; // @sic R5s230095 sic@

    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_ACTIVATE_TEST_MODE(p_UE_TestLoopMode))));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_ACTIVATE_TEST_MODE_COMPLETE)));

    f_NR5GC_SetLoopbackIsActivated(true);
  }

  /*
   * @desc      deactivate test mode
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_Deactivate_TestMode(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;

    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR_DEACTIVATE_TEST_MODE)));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR_DEACTIVATE_TEST_MODE_COMPLETE)));

    f_IMS_IPCAN_SendCoOrdMsg(IMS[f_PDN_PdnIndex2Integer(PDN_1)], cms_IPCAN_IMS_Reset);    // @sic R5s201373 sic@
  }

  /*
   * @desc      open test loop and deactivate test mode
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    f_NR5GC_OpenUE_TestLoopMode(p_NR_CellId);
    f_NR5GC_Deactivate_TestMode(p_NR_CellId);
    f_NR5GC_SetLoopbackIsActivated(false); // @sic R5s210644 sic@
  }

  /*
   * @desc      Set the UL Message
   * @param     p_NR_CellId
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @param     p_UsePreconfigured  (default value: '1'B)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_SetULMessage(NR_CellId_Type p_NR_CellId,
                                NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2,
                                B1_Type p_UsePreconfigured := '1'B) runs on NR_BASE_PTC
  {
    SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, p_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NR5GC_SET_UL_MESSAGE_REQUEST(p_UsePreconfigured))));
    SRB.receive (car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered, cr_NR5GC_SET_UL_MESSAGE_RESPONSE)));
  }

}
