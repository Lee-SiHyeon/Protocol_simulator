module RRC_Reconfiguration_NRDC_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonAspDefs all;
  import from EUTRA_NR_Parameters all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_LoopBack all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRCSteps_NRDC all;
  import from NR5GC_RRC_Templates all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_FrequencyInit_SA all;
  import from NR_RRC_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.2.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_2_2_1_2_NR5GC() runs on NR5GC_PTC
  { //SRB3 Establishment, Reconfiguration and Release / NR addition, modification and release / NR-DC

    f_NR5GC_Init_NRDC(NR_4, {nr_Cell1, nr_Cell10});

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell);  //@sic R5s210891 sic@

    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (NR-DC) according to TS 38.508-1 [4], Table 4.5.1-1.
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);

    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_SCG);

    f_NR_TestBody_Set(true);

    f_TC_8_2_2_1_2_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_8_2_2_1_2_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.2.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_2_2_1_2_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var template (value) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var template (value) CellGroupConfig v_SCGConfig;
    var template (omit) octetstring v_EncodedSCG_Config;
    var template (omit) RadioBearerConfig v_RadioBearerConfig;
    var template (omit) RadioBearerConfig v_RadioBearerConfig2;
    var template (value) NR_RadioBearer_Type v_SS_ConfigSCG;
    var template (value) DRX_Config v_DRX_Config;
    var FreqBandIndicatorNR v_FreqBandIndicatorNR := f_NR_CellInfo_GetBandIndicator(nr_Cell10);

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCReconfiguration message via SRB1 to establish SRB3.
    //Check: Does the UE transmit an RRCReconfigurationComplete message via SRB1?
    f_NR_ReconfigureAddSRB3_NRDC(nr_Cell1, nr_Cell10);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    //@siclog "Step 3" siclog@
    //The SS transmits an RRCReconfiguration message via SRB3 to reconfigure NR MAC.
    if (f_NR_IsBandFR1(v_FreqBandIndicatorNR)) { // FR1
      v_DRX_Config := cs_38508_DRX_Config_FR1;
    } else { // FR2
      v_DRX_Config := cs_38508_DRX_Config_FR2;
    }
    v_SCGConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_SCG, -, -, cs_NR_MAC_CellGroupConfig(cs_NR_DRX_Config_Setup(v_DRX_Config)));
    v_EncodedSCG_Config := bit2oct(encvalue(v_SCGConfig));
    SRB.send(cas_NR_SRB3_RrcPdu_REQ(nr_Cell10, -, cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, -, v_EncodedSCG_Config)));

    //Reconfigure SS with mac_CellGroupConfig
    f_NR_CellInfo_SetDrxCtrl(nr_Cell10, valueof(cs_NR_DrxCtrl_Config(v_DRX_Config)));
    f_NR_SS_ServingCellConfig(nr_Cell10, -, cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfig(omit, omit, v_SCGConfig.mac_CellGroupConfig, omit)));

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message via SRB3?
    SRB.receive(car_NR_SRB3_RrcPdu_IND(nr_Cell10, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    //@siclog "Step 5" siclog@
    //The SS transmits an RRCReconfiguration message via SRB3 to reconfigure PDCP.
    //@sic R5s221315 R5s230098 R5-231411 R5s230382 sic@
    v_RadioBearerConfig := cs_38508_RadioBearerConfigDef({cs_NR_SRB_ToAddMod(tsc_SRB3, cs_PDCP_Config_Def(-, -, ms40))}); //@sic R5s230339, R5-237479 sic@
    SRB.send(cas_NR_SRB3_RrcPdu_REQ(nr_Cell10, -, cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, v_RadioBearerConfig))); //@sic R5-237479 sic@

    //@siclog "Step 6" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message via SRB3?
    SRB.receive(car_NR_SRB3_RrcPdu_IND(nr_Cell10, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    //@siclog "Step 7" siclog@
    //The SS transmits an RRCReconfiguration message via SRB1 to release SRB3.
    v_RadioBearerConfig2 := cs_NR_RadioBearer_ReleaseSRB3;
    v_SCGConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_SCG, -,{f_NR_LogicalChannelId_SRB(tsc_SRB3)});
    v_V1530Ext := f_NRDC_BuildRRCReconfiguration_v1530(v_SCGConfig, omit, v_RadioBearerConfig2);
    f_NR_SendRRCReconfiguration (nr_Cell1, -, -, v_V1530Ext, -, -, -, false);

    //@siclog "Step 8" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message via SRB1?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_RRCReconfigurationComplete(cr_RRCReconfigurationComplete_v1530(-, cr_RRCReconfigurationComplete_v1560(?)))));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    //Release SRB3 in SS
    v_SS_ConfigSCG := cs_NR_SS_RadioBearer_Release(tsc_NR_RbId_SRB3);
    f_NR_SS_CommonRadioBearerConfig(nr_Cell10, {v_SS_ConfigSCG});
  }//end of f_TC_8_2_2_1_2_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.2.4.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_2_4_2_NR5GC() runs on NR5GC_PTC
  { //PSCell addition, modification and release / SCG DRB / NR-DC
    // @sic R5-203650 R5-214749 sic@
    f_NR5GC_Init_NRDC(NR_1, {nr_Cell1, nr_Cell10});// @sic R5s210716 sic@

    //Create and configure NR cell1 and NR cell 10.
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell);  //@sic R5s210891 sic@

    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A, PING_Or_TESTModeB_ON);// @sic R5s210716 R5-214749 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_2_2_4_2_TestBody();

    f_NR_TestBody_Set(false);

    //@sic R5s230130 sic@
    //if (not pc_IP_Ping) {
      //f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1);
   //}

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_2_2_4_2
   * @status    APPROVED (NR5GC)
   */
   function fl_TC_8_2_2_4_2_TestBody() runs on NR5GC_PTC
  {
    var integer v_DrbId;
    var template (value) DRB_ToAddModList v_DRBToAddModList;
    var template (value) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var template (value) RadioBearerConfig v_RadioBearerConfig2;
    var PDUSessionInfoList_Type v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList();


    // @siclog "Step 1" siclog@
    // The SS transmits an RRCReconfiguration message and a PDU SESSION MODIFICATION COMMAND to add NR PSCell with SCG DRB.
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit the RRCReconfigurationComplete message including nr-SCG-Response?
    // @siclog "Step 2A siclog@
    // The UE transmits a ULInformationTransfer message and an PDU SESSION MODIFICATION COMPLETE message.
    f_NR_SetCellPower (nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_RRCReconfig_AddSCG_DRBs_NRDC(nr_Cell1, nr_Cell10, MCG_SCG);// @sic R5-206342 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Steps 2Ba1-2Ba2 siclog@
    // @sic R5s210716 R5-214749 sic@
    // IF pc_IP_Ping = FALSE, then, the SS transmits a CLOSE UE TEST LOOP message.
    // The UE transmits a CLOSE UE TEST LOOP COMPLETE message
    if(not pc_IP_Ping) {
      f_NR5GC_CloseUE_TestLoopModeB (nr_Cell1, '00'O);
    }

    //@siclog "Step 3" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on SCG DRB?
    v_DrbId := f_NR_GetDefaultDRB_SCG();
    f_NR5GC_CheckDataPath(nr_Cell10, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DrbId, "Step 3");

    v_DRBToAddModList[0] := cs_NR_DRB_ToAddMod(omit, v_DrbId,-,-,cs_38508_PDCP_Config (ms500));
    v_RadioBearerConfig2 := cs_38508_RadioBearerConfigDef(-, v_DRBToAddModList);
    v_V1530Ext := f_NRDC_BuildRRCReconfiguration_v1530(omit, omit, v_RadioBearerConfig2);

    // @siclog "Step 4" siclog@
    //SS transmits an RRCReconfiguration message containing NR RadioBearerConfig to modify PDCP discardTimer value of SCG DRB.
    f_NR_SendRRCReconfiguration (nr_Cell1,-,-,v_V1530Ext,-,-,-,false);

    // @siclog "Step 5" siclog@
    // @sic R5s210716 R5-214749 sic@
    // Check: Does the UE transmit an RRCReconfigurationComplete message?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    //@siclog "Step 6" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on SCG DRB?
    f_NR5GC_CheckDataPath(nr_Cell10, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DrbId, "Step 6");

    v_RadioBearerConfig2 := cs_38508_RadioBearerConfigDef(-, -, {v_DrbId});
    v_V1530Ext := f_NRDC_BuildRRCReconfiguration_v1530(omit, omit, v_RadioBearerConfig2, true);// @sic R5-206342 sic@

    // @siclog "Step 7" siclog@
    //SS transmits an RRCReconfiguration message to release NR PSCell with SCG DRB.
    f_NR_SendRRCReconfiguration (nr_Cell1,-,-,v_V1530Ext,-,-,-,false);

    // @siclog "Step 8" siclog@
    // @sic R5-206342 sic@
    // Check: Does the UE transmit an RRCReconfigurationComplete message without nr-SCG-Response?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    f_NR_SS_CommonRadioBearerConfig (nr_Cell10, {cs_NR_SS_RadioBearer_Release(cs_NR_RadioBearerId_DRB(v_DrbId))});

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.2.9.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_2_2_5_2_NR5GC() runs on NR5GC_PTC
  { //PSCell addition, modification and release / Split DRB / NR-DC
   // @sic R5-203650 sic@
    f_NR5GC_Init_NRDC(NR_1, {nr_Cell1, nr_Cell10});//@sic R5-214750 R5s210755 sic@

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell);  //@sic R5s210891 sic@

    // Preamble: If pc_IP_Ping is set to TRUE then, the UE is in state NR RRC_CONNECTED using generic procedure parameter Connectivity (NR-DC), according to TS 38.508-1 [4], clause 4.5.4.
    // else, the UE is in state NR RRC_CONNECTED using generic procedure parameter Connectivity (NR-DC), Test Mode (On) associated with UE test loop mode B configured on NR Cell 1 according to TS 38.508-1 [4], clause 4.5.4.
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A, PING_Or_TESTModeB_ON);//@sic R5s220785 R5s221133 sic@
    f_NR_TestBody_Set(true);

    f_TC_8_2_2_5_2_TestBody();

    f_NR_TestBody_Set(false);

    //if (not pc_IP_Ping) { // @sic R5s200541 sic@//@sic R5s230130 sic@
      //f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1);
    //}

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_2_2_5_2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_2_2_5_2_TestBody() runs on NR5GC_PTC
  {

    var template (value) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var template (value) RRCReconfiguration_v1560_IEs v_V1560Ext;
    var template (omit) RadioBearerConfig v_RadioBearerConfig2;
    var template GSM_MobilityInfo_Type v_PDUSessionInfo;
    var template (value) CellGroupConfig v_CellGroupConfigMCG;
    var template (value) DRB_ToAddModList v_DRBToAddModList;
    var DRB_Identity v_DRBId;// @sic R5s211330 sic@

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCReconfiguration containing RRCReconfiguration-SCG message to add NR PSCell with Split DRB.
    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message including nr-SCG-Response?
    //@siclog "Step 2A" siclog@
    //The UE transmits a ULInformationTransfer message and an PDU SESSION MODIFICATION COMPLETE message.
    f_NR_SetCellPower (nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_RRCReconfig_AddSCG_DRBs_NRDC(nr_Cell1,nr_Cell10,MCG_Split, omit); // @sic R5-206342 R5s210755 R5s211355 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2 PASS");
    //EXCEPTION: Steps 2Ba1 to 2Ba2 describe behaviour that depends on the UE implementation; the "lower case letter" identifies a step sequence that take place depending on the UE implementation.
    //@siclog "Step 2Ba1-2Ba2" siclog@//@sic R5-214750 R5s210755 sic@
    //IF pc_IP_Ping = FALSE, then, the SS transmits a CLOSE UE TEST LOOP message.
    //The UE transmits a CLOSE UE TEST LOOP COMPLETE message.
    if(not pc_IP_Ping) {
      f_NR5GC_CloseUE_TestLoopModeB (nr_Cell1, '00'O);
    }
    //@siclog "Step 3" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on Split DRB over the SCG path?// @sic R5-206342 sic@
    v_PDUSessionInfo := f_Get_PDUSessionForDNNType(f_NR5GC_MobileInfo_GetSessionInfoList(), Internet_DNN);
    v_DRBId:=f_NR_GetDefaultDRB_SCG();// @sic R5s211330 sic@
    f_NR5GC_CheckDataPath(nr_Cell10,
                          f_NR5GC_GetPdnIndex(valueof(v_PDUSessionInfo)),
                          dedicatedBearer,
                          v_DRBId,
                          "Step 3",
                          -, -, nr_Cell10);

    //@siclog "Step 4" siclog@
    //SS transmits RRCReconfiguration message containing NR RadioBearerConfig to modify PDCP discardTimer value of Split DRB.
    v_DRBToAddModList[0] := cs_NR_DRB_ToAddMod(omit, v_DRBId,-,-,cs_38508_PDCP_Config(ms500,-,-,omit));
    v_RadioBearerConfig2:=cs_38508_RadioBearerConfigDef(omit, valueof(v_DRBToAddModList));// @sic R5-206342 sic@
    v_V1530Ext :=f_NRDC_BuildRRCReconfiguration_v1530(-,-,v_RadioBearerConfig2);
    f_NR_SendRRCReconfiguration (nr_Cell1,-,-,v_V1530Ext,-,-,-,false);

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message // @sic R5-214750 sic@
    SRB.receive(car_NR_SRB_RrcPdu_IND(nr_Cell1, tsc_NR_RbId_SRB1, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5 PASS");
    //@siclog "Step 6" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on Split DRB over the SCG path?
    // @sic R5-206342 sic@
    f_NR5GC_CheckDataPath(nr_Cell10,
                          f_NR5GC_GetPdnIndex(valueof(v_PDUSessionInfo)),
                          dedicatedBearer,
                          v_DRBId,
                          "Step 6",
                          -, -, nr_Cell10);

    //@siclog "Steps 7" siclog@
    //SS transmits RRCReconfiguration message containing NR RadioBearerConfig to release PSCell and Split DRB.
    //@siclog "Step 8" siclog@
    //Check: Does the UE transmit an RRCReconfigurationComplete message ? // @sic R5-206342 sic@
    v_RadioBearerConfig2:=cs_38508_RadioBearerConfigDef(-,-,{v_DRBId});
    v_CellGroupConfigMCG:=cs_38508_CellGroupConfig(tsc_NR_CellGroupId_MCG, -, {f_NR_LogicalChannelId_DRB(v_DRBId)});
    v_V1560Ext := cs_RRCReconfiguration_v1560_IEs (-, cs_MRDC_SecondaryCellGroupConfigRelease, bit2oct(encvalue(v_RadioBearerConfig2)));
    v_V1530Ext := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_CellGroupConfigMCG)), -, -, -, -, cs_RRCReconfiguration_v1540_IEs(- ,v_V1560Ext));
    //Release DRB in SS
    f_NR_SS_CommonRadioBearerConfig (nr_Cell1, {cs_NR_SS_RadioBearer_Release(cs_NR_RadioBearerId_DRB(v_DRBId))});
    f_NR_SS_CommonRadioBearerConfig (nr_Cell10, {cs_NR_SS_RadioBearer_Release(cs_NR_RadioBearerId_DRB(v_DRBId))});
    f_NR_SendRRCReconfiguration (nr_Cell1, -,-, v_V1530Ext);
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 8 PASS");
    }//End of fl_TC_8_2_2_5_2_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.2.9.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_2_9_2_NR5GC() runs on NR5GC_PTC
  { // Bearer Modification / Uplink data path / Split DRB Reconfiguration / NR-DC
    f_NR5GC_Init_NRDC(NR_1, {nr_Cell1, nr_Cell10}); //@sic R5s210772, R5-214751 sic@

    // Create and configure NR cell1 and NR cell 10
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell); //@sic R5s210891 sic@

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A, PING_Or_TESTModeB_ON); //@sic R5s210772, R5-214751 sic@
    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_Split, PING_Or_TEST_LOOPModeB_ON, -, -, omit); //@sic R5s211470 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_2_2_9_2_TestBody();

    f_NR_TestBody_Set(false);

    //@sic R5s230130 sic@

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_2_2_9_2
   * @status    APPROVED (NR5GC)
   */
   function fl_TC_8_2_2_9_2_TestBody() runs on NR5GC_PTC
  { //@sic R5s210772, R5-214751 sic@
    var template (value) DRB_ToAddModList v_DRBToAddModList;
    var template (value) PDCP_Config v_PDCP_Config;
    var DRB_Identity v_DrbId;
    var template (value) RadioBearerConfig v_RadioBearerConfig2;
    var PDUSessionInfoList_Type v_PDUSessionInfo;
    var template (omit) GSM_MobilityInfo_Type v_GSM_MobilityInfo := f_Get_PDUSessionForDNNType(f_NR5GC_MobileInfo_GetSessionInfoList(), Internet_DNN);
    var template (value) SDAP_Config v_SDAP_ConfigSCG;

    // @siclog "Step 1" siclog@
    // The SS transmits an RRCReconfiguration message containing NR RadioBearerConfig to change the primaryPath to MCG radio path from SCG radio path
    v_SDAP_ConfigSCG := cs_SDAP_Config(oct2int(valueof(v_GSM_MobilityInfo.SessionId)), false, {5});
    v_DrbId := f_NR_GetDefaultDRB_SCG();
    v_PDCP_Config := cs_NR_PDCP_Config_Split(cs_38508_PDCP_Config_DRB, f_NR_LogicalChannelId_DRB(v_DrbId), tsc_NR_CellGroupId_MCG);
    v_DRBToAddModList[0] := cs_NR_DRB_ToAddMod(cs_NR_DRB_SDAP(v_SDAP_ConfigSCG), v_DrbId, true_, true_, v_PDCP_Config);
    v_RadioBearerConfig2 := cs_38508_RadioBearerConfigDef(omit, v_DRBToAddModList);

    f_ReconfigureDRBs_NRDC( nr_Cell1,
                            nr_Cell10,
                            omit,
                            -,
                            omit,
                            v_RadioBearerConfig2,
                            omit,
                            omit,
                            omit,
                            omit,
                            None, //@sic R5s220786 sic@
                            -,
                            -,
                            noRACH_Check,
                            false,
                            cr_38508_RRCReconfigurationComplete,
                            false); //@sic R5s211470, R5s220185 sic@

    // @siclog "Step 2" siclog@
    // Check: Does the UE transmits an RRCReconfigurationComplete message?
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3" siclog@
    // Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on Split DRB#n using MCG radio path in the uplink?
    v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList();
    f_NR5GC_CheckDataPath(nr_Cell10, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DrbId, "Step 3", -, -, nr_Cell1);

    // @siclog "Step 4" siclog@
    // The SS transmits an RRCReconfiguration message containing NR RadioBearerConfig to change the primaryPath to SCG radio path from MCG radio path
    v_PDCP_Config := cs_NR_PDCP_Config_Split(cs_38508_PDCP_Config_DRB, f_NR_LogicalChannelId_DRB(v_DrbId), tsc_NR_CellGroupId_SCG);
    v_DRBToAddModList[0] := cs_NR_DRB_ToAddMod(cs_NR_DRB_SDAP(v_SDAP_ConfigSCG), v_DrbId, true_, true_, v_PDCP_Config);
    v_RadioBearerConfig2 := cs_38508_RadioBearerConfigDef(omit, v_DRBToAddModList);

     f_ReconfigureDRBs_NRDC(nr_Cell1,
                            nr_Cell10,
                            omit,
                            -,
                            omit,
                            v_RadioBearerConfig2,
                            omit,
                            omit,
                            omit,
                            omit,
                            None, //@sic R5s220786 sic@
                            -,
                            -,
                            noRACH_Check,
                            false,
                            cr_38508_RRCReconfigurationComplete,
                            false); //@sic R5s211470, R5s220185 sic@

    // @siclog "Step 5" siclog@
    // Check: Does the UE transmits an RRCReconfigurationComplete message?
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    // @siclog "Step 6" siclog@
    // Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on Split DRB#n using SCG radio path in the uplink?
    f_NR5GC_CheckDataPath(nr_Cell10, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DrbId, "Step 6", -, -, nr_Cell10);
  }

}
