    // @siclog "Step 2" siclog@                 Steps 2-7 of generic procedure specified in Table 4.9.15.2.2-1 of TS 38.508-1
    
    // @siclog "Step 3" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();   // @sic R5-236898: A.4.1a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    // @siclog "Step 4 - 7" siclog@             100 Trying, 183 Session Progress, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_5(v_InviteRequestWithSdp);     // @sic R5-236898: A.4.2a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);     // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1

    // @siclog "Step 8 - 8B" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6(v_InviteRequestWithSdp, tsc_OptionTagList_100rel);     // @sic R5-241656: 100rel sic@

    // @siclog "Step 9 - 10" siclog@            200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.13.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_13_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call with RTCP disabled / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var InternetProtocol_Type v_Protocol;
    var template (value) SDP_Message v_SdpOffer;
    var template (present) SDP_Message v_SdpAnswer;
    var template (value) SDP_bandwidth_list v_BandwidthListTX := cs_SDP_Bandwidth_List_Media(65, 0, 0);
    var template (present) SDP_bandwidth_list v_BandwidthListRX := cr_SDP_Bandwidth_List_Media(?, 0, 0);

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1" siclog@                 INVITE
    v_SdpOffer := f_IMS_BuildSDP_InitialOfferAudio_TX(tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, EVS_A2, tsc_SDP_WithPreconditions);     /* @sic R5-232152: EVS_B0_A1 replaced by EVS_A2 sic@ */
    v_SdpOffer.media_list[0].bandwidth := v_BandwidthListTX;
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_BuildInviteRequestWithSpecificSdp(v_SdpOffer);
    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequestWithSdp.Invite));

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_RX(EVS_16000, EVS_A2, tsc_SDP_WithPreconditions);                                  /* @sic R5-232152: EVS_B0_A1 replaced by EVS_A2 sic@ */
    v_SdpAnswer.media_list[0].bandwidth := v_BandwidthListRX;
    v_Protocol := v_InviteRequestWithSdp.RoutingInfo.Protocol;
    v_ResponseWithSdp := f_IMS_MTCallSetup_Receive100Trying_Receive183SessionProgress(v_InviteRequestWithSdp.Invite, v_SdpAnswer, v_Protocol, tsc_SDP_WithPreconditions);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    
    // Establish Dedicated EPS bearer
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_SpeechCall);  /* trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer*/

    // @siclog "Step 6 - 7" siclog@             UPDATE, 200 OK
    v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_TX(v_ResponseWithSdp.SdpMessage, EVS_16000);
    v_SdpOffer.media_list[0].bandwidth := v_BandwidthListTX;
    v_SdpAnswer := f_IMS_BuildSDP_FinalAnswerAudio_RX(EVS_16000);
    v_SdpAnswer.media_list[0].bandwidth := v_BandwidthListRX;
    f_IMS_MTCallSetup_NR5GC_SendUPDATE_Receive200OK(v_InviteRequestWithSdp, v_SdpOffer, v_SdpAnswer);
    
    // @siclog "Step 8 - 10" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithPreconditions);                   /* @sic R5-232152: tsc_OptionTagList_100rel sic@ */

    // @siclog "Step 11 - 13" siclog@           MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.14.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_14_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call with preconditions at both originating and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);

    // @siclog "Step 2" IPCAN siclog@
    
    // @siclog "Step 3" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall, -, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2); // @sic R5-230324: EVS_A2 sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    // @siclog "Step 4 - 5" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2);        // @sic R5-230324: EVS_A2 sic@

    // @siclog "Step 6 - 7" siclog@             PRACK, 200 OK
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_VideoCall);

    // @siclog "Step 8 - 9" siclog@             UPDATE, 200 OK
    f_IMS_MOCallSetup_NR5GC_Video_Step6_7(SetupVideoCall, v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 10 - 12" siclog@           180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 13 - 14" siclog@           200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_VideoCall);
  }

