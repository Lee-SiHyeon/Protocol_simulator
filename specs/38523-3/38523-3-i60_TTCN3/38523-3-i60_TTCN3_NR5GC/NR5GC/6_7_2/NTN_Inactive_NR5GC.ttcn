module NTN_Inactive_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SecuritySteps all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.2.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_2_1_NR5GC() runs on NR5GC_PTC
  {// NR NTN / Cell reselection, Sintrasearch, Snonintrasearch in RRC_Inactive state / location based measurements
          
    //NR Cell 2 and NR Cell 3 use System information combination NR-32 as defined in TS 38.508-1 [4] Table 4.4.3.1.2-1.
    f_NR5GC_Init(NR_32,-,{nr_Cell2, nr_Cell3});
      
    //NR Cell 1 uses System information combination NR-29 as defined in TS 38.508-1 [4] Table 4.4.3.1.2-1.
    f_NR_ModifySysinfoCombinationToNR_29(nr_Cell1);
      
    //Update SIB2 as per Table 6.7.2.1.3.3-2: SIB2 of NR Cell 1, NR Cell 2 and NR Cell 3 (preamble and all steps, Table 6.7.2.1.3.2-2)
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell2, 5);
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell3, 5);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell2, 5);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell3, 1);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell2, 5);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell3, 5);
      
    //Update SIB4 as per Table 6.7.2.1.3.3-3: SIB4 of NR Cell 2 and NR Cell 3 (preamble and all steps, Table 6.7.2.1.3.2-2)
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell2, 0, 1);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell3, 0, 5);
   
    //Update SIB19 as per Table 6.7.2.1.3.3-4: SIB19 of NR Cell 1, NR Cell 2 and NR Cell 3 (preamble and all steps, Table 6.7.2.1.3.2-2)
    f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(nr_Cell1,hex2oct('2273BA566355'H),500);
    f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(nr_Cell2,hex2oct('2273BA566355'H),500);
    f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(nr_Cell3,hex2oct('2273BA566355'H),500);
      
    // Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);
    f_NR_CellConfig_Def(nr_Cell3);
      
    // Preamble: The UE is in state 2N-A on NR Cell 1(serving cell) according to TS 38.508-1 [4] Table 4.4A.2-2.
    f_NR5GC_Preamble(nr_Cell1, STATE_INACTIVE_2A, -, ResumeNoSecurity); /*@sic R5s250474 Ch.1.2 sic@*/

    f_NR_TestBody_Set(true);
      
    f_TC_6_7_2_1_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell3, STATE_IDLE_1A);
  } //end of f_TC_6_7_2_1_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.2.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_2_1_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell2);
    var RNTI_Value_Type v_RNTI_Value_Type := f_NR_CellInfo_GetRNTI(nr_Cell2);

    
    //Table 6.7.2.1.3.2-1: Time instances of cell power level and parameter changes
    //T0 -> Done in the preamble
    v_CellPowerList_AtT1:={// NR_Cell1-> -94, NR_Cell2-> -88
      cs_NR_CellPower(nr_Cell1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell2, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
    v_CellPowerList_AtT2:={// NR_Cell1-> Off, NR_Cell2-> -94, NR_Cell3-> -88
      cs_NR_CellPower(nr_Cell1,tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell2, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell3, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
      
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell2,tsc_NR_38508_NextHopChainingCount);  /*@sic R5s250474 Ch.2, Ch.1.1 sic@*/
    f_NR_SS_RachProcedureConfig(nr_Cell2, cs_NR_RachProcedureConfig_RRCResume(v_NR_PhysicalParameters, v_RNTI_Value_Type, tsc_NR_Msg4GrantHO_Def));  /*@sic R5s250474 Ch.2, Ch.1.1 sic@*/
      
    //@siclog "Step 1" siclog@
    //The SS re-adjusts the SS/PBCH EPRE levels according to row "T1" in table 6.7.2.1.3.2-1.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
      
    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message on the NR Cell 2?
    SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell2, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1, rna_Update)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
     
    //@siclog "Step 3" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell2);
      
    //@siclog "Step 4" siclog@
    //The UE transmit an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell2);

    // @siclog "Step 5" siclog@
    // The SS transmits an RRCRelease message including suspendConfig with NR_RRC_INACTIVE condition.
    f_NR_RRC_InactiveDef(nr_Cell2, ResumeNoSecurity, -, -, -, -, -, -, nr_Cell3);  // @sic R5s250008 sic@
      
     //@siclog "Step 6" siclog@
    //The SS re-adjusts the SS/PBCH EPRE levels according to row "T2" in table 6.7.2.1.3.2-1.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell3);
      
    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message on the NR Cell 3?
    SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell3, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1, rna_Update)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
     
    //@siclog "Step 8" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell3);
      
    //@siclog "Step 9" siclog@
    //The UE transmit an RRCResumeComplete message.
    f_NR_RRCResumeComplete_Def(nr_Cell3);

    // @siclog "Step 10" siclog@
    // The SS transmits an RRCRelease message
    f_NR_RRCRelease(nr_Cell3);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.2.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_2_2_NR5GC() runs on NR5GC_PTC
  {// NR NTN / Cell reselection, Sintrasearch, Snonintrasearch in RRC_Inactive state / time based measurements
    
    var ARFCN_ValueNR v_SSB_Freq_Cell12;
    var ARFCN_ValueNR v_SSB_Freq_Cell1;
          
    //NR Cell 11 and NR Cell 12 use System information combination NR-32 as defined in TS 38.508-1 [4] Table 4.4.3.1.2-1.
    f_NR5GC_Init(NR_32,-,{nr_Cell11,nr_Cell12});
      
    //NR Cell 1 uses System information combination NR-29 as defined in TS 38.508-1 [4] Table 4.4.3.1.2-1.
    f_NR_ModifySysinfoCombinationToNR_29(nr_Cell1);
      
    //Update SIB2 as per Table 6.7.2.2.3.3-2: SIB2 of NR Cell 1, NR Cell 11 and NR Cell 12 (preamble and all steps, Table 6.7.2.2.3.2-2)
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell11, 5);
    f_NR_CellInfo_SetSIB2_S_NonIntraSearchP(nr_Cell12, 5);
    f_NR_CellInfo_SetSIB2_ThreshServingLowP(nr_Cell11,10);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell11, 5);
    f_NR_CellInfo_SetSIB2_CellReselectionPriority(nr_Cell12, 1);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell1, 5);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell11, 5);
    f_NR_CellInfo_SetSIB2_S_IntraSearchP(nr_Cell12, 5);

      
    //Update SIB4 as per Table 6.7.2.2.3.3-3: SIB4 of NR Cell 11 and NR Cell 12 (preamble and all steps, Table 6.7.2.2.3.2-2)
    v_SSB_Freq_Cell12 := f_NR_CellInfo_GetFrequencySSB(nr_Cell12);
    v_SSB_Freq_Cell1 := f_NR_CellInfo_GetFrequencySSB(nr_Cell1);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_DL_CarrierFreq(nr_Cell11, 0, v_SSB_Freq_Cell12); //@sic R5s250483 Ch.1.1 sic@
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_DL_CarrierFreq(nr_Cell12, 0, v_SSB_Freq_Cell1);  //@sic R5s250483 Ch.1.1 sic@

    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell11, 0, 1);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell12, 0, 5);
     
     
    // Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell11);
    f_NR_CellConfig_Def(nr_Cell12);
     
    // Preamble: The UE is in state 2N-A on NR Cell 1(serving cell) according to TS 38.508-1 [4] Table 4.4A.2-2.
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
      
    f_TC_6_7_2_2_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell12, STATE_IDLE_1A);
  } //end of f_TC_6_7_2_2_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.7.2.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_7_2_2_NR5GC_TestBody() runs on NR5GC_PTC
  {
    
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
      
    var integer v_TimestampSeconds;
          
    var H14_Type v_TimestampWithTimezone;
    var O1_Type v_Timezone;
    var O1_Type v_Year;
    var O1_Type v_Month;
    var O1_Type v_Day;
    var O1_Type v_Hour;
    var O1_Type v_Minute;
    var O1_Type v_Second;
    var B2_Type v_DaylightSavingTime := '00'B;
      
    var template (omit) NG_NAS_MSG_Indication_Type v_DedicatedNAS_Message;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
      
    timer t_WaitForRRCResume_Step4 := 360.0;  //@sic R5s250483 Ch.2.2 sic@
    timer t_WaitForRRCResume_Step11 := 540.0; //@sic R5s250483 Ch.2.2 sic@
    
    //Table 6.7.2.2.3.2-1: Time instances of cell power level and parameter changes
    //T0 -> Done in the preamble
    v_CellPowerList_AtT1:={// NR_Cell1-> -94, NR_Cell2-> -88
      cs_NR_CellPower(nr_Cell1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell11, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE) //@sic R5s250483 Ch.2.1 sic@
    };
    v_CellPowerList_AtT2:={// NR_Cell1-> Off, NR_Cell2-> -94, NR_Cell3-> -88
      cs_NR_CellPower(nr_Cell1,tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell11, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE), //@sic R5s250483 Ch.2.1 sic@
      cs_NR_CellPower(nr_Cell12, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)            //@sic R5s250483 Ch.2.1 sic@
    };
      
    // Calculation of Time Zone parameters - it is done in a consecutive call to fx_GetSystemTime after calculation of v_TimestampSeconds.
    // As a tolerance is applied to steps 4 and 6 it is taken for granted v_TimestampSeconds and v_TimestampWithTimezone can be used
    v_TimestampWithTimezone := f_BCD_TimestampWithTimezone();
    v_Year := hex2oct(substr(v_TimestampWithTimezone, 0, 2));
    v_Month := hex2oct(substr(v_TimestampWithTimezone, 2, 2));
    v_Day := hex2oct(substr(v_TimestampWithTimezone, 4, 2));
    v_Hour := hex2oct(substr(v_TimestampWithTimezone, 6, 2));
    v_Minute := hex2oct(substr(v_TimestampWithTimezone, 8, 2));
    v_Second := hex2oct(substr(v_TimestampWithTimezone, 10, 2));
    v_Timezone := hex2oct(substr(v_TimestampWithTimezone, 12, 2));
    if (fl_IsDaylightSavingTime()){
      v_DaylightSavingTime := '01'B;
    }
     
    //@siclog "Step 0" siclog@
    //SS modifies SIB19 in NR Cell 1 and NR Cell 11 to update t-service based on Local time zone, Universal time and local time zone
    //Table 6.7.2.2.3.3-4: SIB19 of NR Cell 1 and NR Cell 11 (step 0, Table 6.7.2.2.3.2-2)
    v_TimestampSeconds :=  100*f_UTC_TimestampSeconds(); // Note 1: Value is calculated in multiples of 10 ms after 00:00:00 on Gregorian calendar date 1 January, 1900
    f_NR5GC_CellInfo_SetSIB19_t_Service_r17(nr_Cell1, v_TimestampSeconds + 36000); //+6min @sic R5s250483 Ch.2.4 sic@
    f_NR5GC_CellInfo_SetSIB19_t_Service_r17(nr_Cell11,v_TimestampSeconds + 54000); //+9min @sic R5s250483 Ch.2.4 sic@
    f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(nr_Cell1,hex2oct('2273BA566355'H),20000);
    f_NR_CellInfo_SetSIB19_NTN_RefLocation_AndDistanceThresh(nr_Cell11,hex2oct('2273BA566355'H),20000);
    
    //@siclog "Step 0A" siclog@
    //The SS transmits a Short message on PDCCH using P-RNTI indicating a systemInfoModification on Cell1
    f_NR_ModifySysinfo(nr_Cell1,-, RRC_CONNECTED);   //@sic R5s250483r2 Ch.2.6, R5-261204 sic@
    f_NR_ModifySysinfo(nr_Cell11);  //@sic R5s250483r2 Ch.2.6, R5-261204 sic@
     
    //@siclog "Step 0B" siclog@
    //Wait for 2.1* modification period to allow the new system information to take effect.
    f_NR_WaitModificationPeriods(nr_Cell1);  //@sic R5-261204 sic@
             
    //@siclog "Step 1" siclog@
    //The SS transmits a CONFIGURATION UPDATE COMMAND message including Local time zone, Universal time and local time zone, Network daylight saving time information. (Note 1)
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1, tsc_NR_RbId_SRB2, cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_NG_CONFIGURATION_UPDATE_COMMAND(-, -, -, -, -, -, -,
                                                                      cs_TimeZone(v_Timezone),
                                                                      cs_TimeZoneAndTime(v_Year, v_Month, v_Day, v_Hour, v_Minute, v_Second,v_Timezone),
                                                                      cs_DaylightSavingTime_tlv(v_DaylightSavingTime)))));
    t_WaitForRRCResume_Step4.start;
    t_WaitForRRCResume_Step11.start;
      
    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message including suspendConfig with NR_RRC_INACTIVE condition.
    f_NR_RRC_InactiveDef(nr_Cell1, ResumeNoSecurity, -, -, -, -, -, -, nr_Cell11);    // @sic R5s250008 sic@
      
    //@siclog "Step 3" siclog@
    //The SS re-adjusts the SS/PBCH EPRE levels according to row "T1" in table 6.1.2.18a.3.2-1.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell11);
     
    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message on NR Cell 11 within 6mins after step 1?
    alt
    {
        []SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell11, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1, mo_Signalling))){
            t_WaitForRRCResume_Step4.stop;
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
        }
        [] t_WaitForRRCResume_Step4.timeout {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4");
        }
    }
     
    //@siclog "Step 5" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell11);
      
    //@siclog "Step 6" siclog@
    //The UE transmits an RRCResumeComplete message and a REGISTRATION REQUEST message indicating "mobility registration updating" is sent to update the registration of NR Cell11.
    v_DedicatedNAS_Message := f_NR_RRCResumeComplete_Def(nr_Cell11);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, valueof(v_DedicatedNAS_Message.Pdu), Mobility)) {
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
     
    //@siclog "Step 7-8" siclog@
    //Steps 4 to 5 of the generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 with condition MOBILITY are performed.
    //NOTE: PLMN1 and PLMN2 are listed as an Equivalent PLMN in the REGISTRATION ACCEPT message

    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell11, v_GMM_MobilityInfo, omit, omit,
                                                noRrcConnectionRelease,-,tsc_NR_RbId_SRB2, //@sic R5s250483 Ch.2.6 sic@
                                                cs_PLMN_List_1PLMN(f_NR_Asn2Nas_PlmnId(tsc_NR_HPLMN_002_11))); //Table 6.7.2.2.3.3-5: REGISTRATION ACCEPT
    // @siclog "Step 9" siclog@
    // The SS transmits an RRCRelease message including suspendConfig with NR_RRC_INACTIVE condition.
    f_NR_RRC_InactiveDef(nr_Cell11, ResumeNoSecurity, -, -, -, -, -, -, nr_Cell12);
      
    //@siclog "Step 10" siclog@
    //TThe SS re-adjusts the SS/PBCH EPRE levels according to row "T2" in table 6.1.2.18a.3.2-1.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);
    f_NR_SS_AS_ActivateSecurity_Current(nr_Cell12);
      
    //@siclog "Step 11" siclog@
    //Check: Does the UE transmit an RRCResumeRequest message on NR Cell 12 within 9mins after step 1?
    alt
    {
        []SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell12, cr_38508_RRCResumeRequest(tsc_NR_ShortI_RNTI_Value1, mo_Signalling))){
            t_WaitForRRCResume_Step11.stop;
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");
        }
        [] t_WaitForRRCResume_Step11.timeout {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 11");
        }
    }
      
    //@siclog "Step 12" siclog@
    //The SS transmits an RRCResume message.
    f_NR_SendRRCResume_Def(nr_Cell12);
      
    //@siclog "Step 13" siclog@
    //The UE transmits an RRCResumeComplete message and a REGISTRATION REQUEST message indicating "mobility registration updating" is sent to update the registration of NR Cell12.
    v_DedicatedNAS_Message := f_NR_RRCResumeComplete_Def(nr_Cell12);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, valueof(v_DedicatedNAS_Message.Pdu), Mobility)) {
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    // @siclog "Step 14-16" siclog@
    //Steps 4 to 5 of the generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 with condition MOBILITY are performed.
    //NOTE: PLMN1 and PLMN2 are listed as an Equivalent PLMN in the REGISTRATION ACCEPT message
    // The SS transmits an RRCRelease message
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell12, v_GMM_MobilityInfo, omit, omit,
                                                -,-,tsc_NR_RbId_SRB2,  //@sic R5s250483 Ch.2.6 sic@
                                                cs_PLMN_List_1PLMN(f_NR_Asn2Nas_PlmnId(tsc_NR_HPLMN_Def))); //Table 6.7.2.2.3.3-5: REGISTRATION ACCEPT
   
  } // end f_TC_6_7_2_2_NR5GC_TestBody

}
