    v_RLC_Rec.AM_SN_Size := 12;
    v_RLC_Rec.t_PollRetransmit := 0.3;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};
    v_RLC_Rec.pollPDU := 40000001; // greater than mB40
    v_RLC_Rec.pollByte := 65537; // greater than p65536

    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_5_NR_TestBody (v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
