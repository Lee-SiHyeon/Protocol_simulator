  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.2.GNSS
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_2_GNSS_NR5GC_TestBody (PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;
    var GNSS_MeasurementList v_GNSS_MeasurementList;

    //@siclog "Step 1" siclog@
    //Clear stored GNSS assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_AgnssUEPosTech);

    //@siclog "Steps 1b, 1c, 1d" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    // Retrieve data from Satellite simulator
    v_ProvideAssistData := f_POS_RetrieveNR_DataGNSS(p_PosSystemListId);

    //@siclog "Step 2" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    f_POS_NR_SendLppProvideAssistanceData_GNSS(false, // UE-Assisted case
                                               tsc_POS_TransactionNumber,
                                               tsc_POS_RoutingId,
                                               v_ProvideAssistData,
                                               omit);

    //@siclog "Step 3" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationMeasurementsRequired, //@sic R5s201403 sic@
                                                                            tsc_ResponseTimeDef,
                                                                            cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId),
                                                                                                        false,
                                                                                                        f_MultiFreqAGNSS()),
                                                                            omit,
                                                                            omit));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 4" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, (cr_LppProvideLocationInformation_NoError_Agnss_UEA(tsc_POS_TransactionNumber), cr_LppProvideLocationInformation_Agnss_UEA (tsc_POS_TransactionNumber)));
    v_GNSS_MeasurementList := v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.a_gnss_ProvideLocationInformation.gnss_SignalMeasurementInformation.gnss_MeasurementList;
    f_POS_NR_CheckGnssMeasurementList(v_GNSS_MeasurementList); //@sic R5s210633 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.2 Step 4");

    //@siclog "Step 4a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 4
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_2_GNSS_NR5GC_TestBody

