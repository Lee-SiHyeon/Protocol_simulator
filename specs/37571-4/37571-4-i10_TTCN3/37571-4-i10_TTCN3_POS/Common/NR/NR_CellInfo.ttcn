  /*
   * @desc      Return SSB_MTC stored in SIB2 or in cell array
   * @param     p_NR_CellId
   * @return    SSB_MTC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSSB_MTC(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SSB_MTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var SSB_MTC v_SSB_MTC;

    if ((v_NR_CellInfo.Sysinfo.NR_SysinfoCombination !=  MibOnly) and (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != NR_1)){
      v_SSB_MTC := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib2.intraFreqCellReselectionInfo.smtc;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
    } else {
      v_SSB_MTC := v_NR_CellInfo.PhysicalParameters.SSB_MTC;
    }
    return v_SSB_MTC;
  }

  /*
   * @desc      Return PCCH configuration stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @return    PCCH_Config
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetSIB1_PcchConfig(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return PCCH_Config
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (not isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pcch_Config)) {
      FatalError(__FILE__, __LINE__, "SIB1 not found");
    }
    return v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pcch_Config;
  }

