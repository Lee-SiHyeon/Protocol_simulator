                  measResultPCell_v1250 := p_RSRQ_Range_v1250,                             /* @sic BASELINE MOVING 2015 sic@ */
                  measResultCSI_RS_List_r12 := p_MeasResultCSI_RS_List_r12,                /* @sic BASELINE MOVING 2015 sic@ */
                  measResultForRSSI_r13 := p_MeasResultForRSSI_r13,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultServFreqListExt_r13 := *,    /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultSSTD_r13 := *,               /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultPCell_v1310 := *,            /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  ul_PDCP_DelayResultList_r13 := p_UL_PDCP_DelayResultList,      /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultListWLAN_r13 := *,           /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
                  measResultPCell_v1360 := *,            /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultListCBR_r14 := *,            /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultListWLAN_r14 := *,           /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
                  measResultServFreqListNR_r15 := *,     /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
                  measResultCellListSFTD_r15 := *,       /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
                  logMeasResultListBT_r15 := *,          /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  logMeasResultListWLAN_r15 := p_LogMeasResultListWlan_r15,        /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  measResultSensing_r15 := *,            /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  heightUE_r15 := p_LogMeasResultList_heightUE_r15,                     /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
                  ul_PDCP_DelayValueResultList_r16 := *, /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
                  measResultForRSSI_NR_r16 := *,         /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
                  uncomBarPreMeasResult_r17:= *,         /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
                  coarseLocationInfo_r17   := *          /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
                },
                nonCriticalExtension := *                //according to 36.508 4.6.1 table 4.6.1-5
              }
            }
          }
        }
      }
    }
  };

  template (present) UL_DCCH_Message cr_MeasurementReport(template (present) integer p_MeasId,
                                                          template (present) RSRP_Range p_RsrpResult,
                                                          template (present) RSRQ_Range p_RsrqResult,
                                                          template MeasResults.measResultNeighCells p_MeasResultNeighCells,
                                                          template MeasResultForECID_r9 p_MeasResultForECID_r9 := omit,
                                                          template LocationInfo_r10 p_LocationInfo_r10 := omit,
                                                          template MeasResultServFreqList_r10 p_MeasResultServFreqList_r10 := omit) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    cr_MeasurementReport_Common(p_MeasId,
                                p_RsrpResult,
                                p_RsrqResult,
                                p_MeasResultNeighCells,
                                p_MeasResultForECID_r9,
                                p_LocationInfo_r10,
                                p_MeasResultServFreqList_r10);

  template (present) UL_DCCH_Message cr_MeasurementReport_CheckAny := cr_MeasurementReport(?, ?, ?, *); /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  template (value) MeasGapConfig cs_508_MeasGapConfig_GP2 :=
    /* @status    APPROVED (ENDC, LTE_A_IRAT, LTE_IRAT) */
    cs_MeasGapConfig_setup_gp1(30);    /* TGRP = 80ms
                                          @sic R5-120235/R5-120236 offset changed from 0 to 30 sic@ */

  template (value) MeasGapConfig cs_508_ENDC_MeasGapConfig_GP2 :=
    /* @status    APPROVED (ENDC) */
    cs_MeasGapConfig_setup_gp1(19);    /* TGRP = 80ms
                                          @sic R5s190943 sic@ */

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectNR(integer p_NR_ARFCN_f1,
                                                                            RS_ConfigSSB_NR_r15.subcarrierSpacingSSB_r15 p_SCS,
                                                                            FreqBandIndicatorNR_r15 p_FreqBandIndicatorNR_r15) :=
                                                                             
  { /* @status    APPROVED (ENDC) */
    measObjectNR_r15 := {
      carrierFreq_r15 := p_NR_ARFCN_f1,
      rs_ConfigSSB_r15 := {
        measTimingConfig_r15 := {
          periodicityAndOffset_r15 := {sf20_r15 := 0}, //@sic R5s190178 sic@
          ssb_Duration_r15 := sf5
        },
        subcarrierSpacingSSB_r15 := p_SCS, // kHz15 hard coded in spec
        ssb_ToMeasure_r15 := omit,                        /* @sic R5s190544 BASELINE MOVING 2019 sic@ */
        ssb_PositionQCL_CommonNR_r16            := omit,  /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
        ssb_PositionQCL_CellsToAddModListNR_r16 := omit,  /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
        ssb_PositionQCL_CellsToRemoveListNR_r16 := omit,  /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
        subcarrierSpacingSSB_r17                := omit,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
        ssb_PositionQCL_CommonNR_r17            := omit,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
        ssb_PositionQCL_CellsToAddModListNR_r17 := omit,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
        ssb_PositionQCL_CellsToRemoveListNR_r17 := omit   /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      },
      threshRS_Index_r15 := omit,
      maxRS_IndexCellQual_r15 := omit,
      offsetFreq_r15 := 0,
      excludedCellsToRemoveList_r15 := omit,              /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      excludedCellsToAddModList_r15 := omit,              /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      quantityConfigSet_r15 := 1,
      cellsForWhichToReportSFTD_r15 := omit,              /* @sic R5s180412 BASELINE MOVING 2018-2 sic@ */
      cellForWhichToReportCGI_r15 := omit,                /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
      deriveSSB_IndexFromCell_r15 := omit,                /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
      ss_RSSI_Measurement_r15 := omit,                    /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
      bandNR_r15 := {setup := p_FreqBandIndicatorNR_r15}, /* @sic R5s180552 BASELINE MOVING 2018 R5-194875 sic@ */
      rmtc_ConfigNR_r16 := omit,                          /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      cellsToRemoveList_r16 := omit,                      /* @sic R5s230534 BASELINE UPGRADE 2023 sic@ */
      cellsToAddModList_r16 := omit                       /* @sic R5s230534 BASELINE UPGRADE 2023 sic@ */
    }
  };

  template (value) MeasObjectToAddMod_v9e0 cs_MeasObjectToAddMod_v9e0(template (value) ARFCN_ValueEUTRA_v9e0 p_ARFCN_ValueEUTRA_v9e0) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    measObjectEUTRA_v9e0 := {
      carrierFreq_v9e0 := p_ARFCN_ValueEUTRA_v9e0
    }
  };

