  /*
   * @desc      Retrieve the type of the simmulated satellite
   * @return    NTN_Satellite_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_MobileInfo_GetNTNSatelliteType() runs on NR_BASE_PTC return NTN_Satellite_Type
  {
      return vc_NR_Global.MobileInfo.NTN_SatelliteType
  }

    /*
   * @desc      Retrieve true if the satelitte type is different than ntn_None
   * @return    boolean
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_MobileInfo_IsNTN() runs on NR_BASE_PTC return boolean
  {
    var NTN_Satellite_Type v_NTN_Satellite := f_NR_MobileInfo_GetNTNSatelliteType();
    if (v_NTN_Satellite == ntn_None)  {
      return false;
    } else {
      return true;
    }
  }

  /*
   * @desc      Retrieve ASN.1 type BWP_DownlinkCommon from ASP type NR_DownlinkBWP_Type
   * @param     p_DL_BWP
   * @param     p_Coreset0_Index
   * @param     p_InitiaBWP         (default value: false)
   * @return    template (value) BWP_DownlinkCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveBWP_DownlinkCommon(NR_DownlinkBWP_Type p_DL_BWP,
                                           template (omit) ControlResourceSetZero p_Coreset0_Index,
                                           boolean p_InitiaBWP := false)
    return template (value) BWP_DownlinkCommon
  { //@sic R5-206302: added p_InitiaBWP sic@
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := p_DL_BWP;
    var template (omit) SearchSpaceId v_SearchSpaceSIB1 := tsc_NR_SearchSpaceId_Zero;
    var template (omit) SearchSpaceId v_PagingSearchSpace := tsc_NR_SearchSpaceId_Zero;
    var template (omit) SearchSpaceId v_SearchSpaceOtherSystemInformation := tsc_NR_SearchSpaceId_SISS; //@sic R5-191187 sic@
    var template (omit) PDCCH_ConfigCommon.commonSearchSpaceList v_CommonSearchSpaceList; //@sic R5-191187 sic@
    var integer v_SearchSpaceIndex_CSS := f_NR_DownlinkBWP_GetSearchSpace_Index(p_DL_BWP, tsc_NR_SearchSpaceId_CSS);  //@sic R5-191187 sic@
    var integer v_SearchSpaceIndex_SISS;  //@sic R5-191187 sic@
    var template (omit) ControlResourceSet v_ControlResourceSetNonZero; //@sic R5-202561 sic@
    var template (omit) SearchSpaceZero v_SearchSpaceZero := 0;

    if (f_GetTestcaseAttrib_ENDC(testcasename())) { // Acc to 38.508-1 Table 4.6.3-96: PDCCH-ConfigCommon con EN-DC @sic R5-190718 sic@
      v_SearchSpaceSIB1 := omit;
      v_PagingSearchSpace := omit;
      v_SearchSpaceOtherSystemInformation := omit;
      v_CommonSearchSpaceList := {
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_CSS].SearchSpaceConfigAtUE.R15
      };
      v_ControlResourceSetNonZero := v_NR_DownlinkBWP.Pdcch.CoresetArray[1].R15;
    } else {
      v_SearchSpaceIndex_SISS := f_NR_DownlinkBWP_GetSearchSpace_Index(p_DL_BWP, tsc_NR_SearchSpaceId_SISS);
      v_CommonSearchSpaceList := {
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_CSS].SearchSpaceConfigAtUE.R15,
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_SISS].SearchSpaceConfigAtUE.R15
      };
      v_ControlResourceSetNonZero := omit;
    }
    if (p_InitiaBWP) {
        //As per TS 38.508-1 Table 4.6.3-96: PDCCH-ConfigCommon condition InitialBWP_SIB = Configured via DownlinkConfigCommonSIB or in other BWPs
        // @sic R5-206302 sic@
        v_ControlResourceSetNonZero := omit;
        v_SearchSpaceZero := omit;
    }
    v_BWP_DownlinkCommon := cs_38508_BWP_DownlinkCommon(v_NR_DownlinkBWP.BWP.R15,
                                                        cs_38508_PDCCH_ConfigCommon(p_Coreset0_Index,
                                                                                    v_ControlResourceSetNonZero, //commonControlResourceSet
                                                                                    v_CommonSearchSpaceList,
                                                                                    v_SearchSpaceZero,
                                                                                    -,
                                                                                    v_SearchSpaceSIB1,
                                                                                    v_PagingSearchSpace,
                                                                                    v_SearchSpaceOtherSystemInformation),
                                                        v_NR_DownlinkBWP.Pdsch.ConfigCommon.R15);
    return v_BWP_DownlinkCommon;
  }

  /*
   * @desc      Retrieve ASN.1 type BWP_UplinkCommon from ASP type NR_DownlinkBWP_Type
   * @param     p_UL_BWP
   * @return    BWP_UplinkCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveBWP_UplinkCommon(NR_UplinkBWP_Type p_UL_BWP) return BWP_UplinkCommon
  {
    return p_UL_BWP.Common.R15;
  }

  /*
   * @desc      Retrieve index of NR_DownlinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_DownlinkBWP_List_Type
   * @param     p_DL_BWPs
   * @param     p_BWP_Id
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_RetrieveDownlinkBWP_Index(template (omit) NR_DownlinkBWP_List_Type p_DL_BWPs,
                                           BWP_Id p_BWP_Id) return integer
  {
    var integer v_Index;
    var integer i;

    for (i := 0; i < lengthof(p_DL_BWPs); i := i + 1) {
      if (match(p_BWP_Id, p_DL_BWPs[i].Id)) {
        v_Index := i;
        break;
      }
    }
    if (not isbound(v_Index)) {
      FatalError(__FILE__, __LINE__, "No DL BWP found for given BWP_Id");
    }
    return v_Index;
  }

  /*
   * @desc      Retrieve ASP type NR_DownlinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_DownlinkBWP_List_Type
   * @param     p_DL_BWPs
   * @param     p_BWP_Id
   * @return    NR_DownlinkBWP_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveDownlinkBWP(NR_DownlinkBWP_List_Type p_DL_BWPs,
                                    BWP_Id p_BWP_Id) return NR_DownlinkBWP_Type
  {
    var integer i := fl_NR_RetrieveDownlinkBWP_Index(p_DL_BWPs, p_BWP_Id);
    return p_DL_BWPs[i];
  }

  /*
   * @desc      Retrieve index of NR_UplinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_UplinkBWP_List_Type
   * @param     p_UL_BWPs
   * @param     p_BWP_Id
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_RetrieveUplinkBWP_Index(template (omit) NR_UplinkBWP_List_Type p_UL_BWPs,
                                         BWP_Id p_BWP_Id) return integer
  {
    var integer v_Index;
    var integer i;

    for (i := 0; i < lengthof(p_UL_BWPs); i := i + 1) {
      if (match(p_BWP_Id, p_UL_BWPs[i].Id)) {
        v_Index := i;
        break;
      }
    }
    if (not isbound(v_Index)) {
      FatalError(__FILE__, __LINE__, "No UL BWP found for given BWP_Id");
    }
    return v_Index;
  }

  /*
   * @desc      Retrieve ASP type NR_UplinkBWP_Type with BWP_Id matching p_BWP_Id from ASP type NR_UplinkBWP_List_Type
   * @param     p_UL_BWPs
   * @param     p_BWP_Id
   * @return    NR_UplinkBWP_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveUplinkBWP(NR_UplinkBWP_List_Type p_UL_BWPs,
                                  BWP_Id p_BWP_Id) return NR_UplinkBWP_Type
  {
    var integer i := fl_NR_RetrieveUplinkBWP_Index(p_UL_BWPs, p_BWP_Id);
    return p_UL_BWPs[i];
  }

  /*
   * @desc      return nrofCandidates as acc to 38.508-1 Table 4.6.3-28: ControlResourceSet
   * @param     p_FreqBandIndicatorNR
   * @param     p_ChannelBandwidth
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Get_SearchSpace_NrofCandidates (FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                                integer p_ChannelBandwidth
                                                ) return template (value) NR_SearchSpace_NrofCandidates_Type
  { //@sic R5-250401 sic@
    var template (value) NR_SearchSpace_NrofCandidates_Type v_NrofCandidates;
    if (f_NR_IsBandFR1(p_FreqBandIndicatorNR)) { //FR1
      if (p_ChannelBandwidth == 3) {
        v_NrofCandidates := cs_38508_NrofCandidates_CBW3;
      } else {
        v_NrofCandidates := cs_38508_NrofCandidates_Def;
      }
    } else {                                        //FR2
      v_NrofCandidates := cds_38508_NrofCandidates_FR2
    }
    return v_NrofCandidates;
  }

}
