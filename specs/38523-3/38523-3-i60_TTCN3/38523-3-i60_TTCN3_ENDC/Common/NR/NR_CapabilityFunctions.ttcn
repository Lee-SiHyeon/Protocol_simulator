  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of ss_SINR_Meas along with fr1-Add-UE-NR-Capabilities, fr2-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 10 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_ss_SINR_Meas(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5s190471 R5-197070 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamFRX_Diff_ss_SINR_Meas := false;
    var boolean v_FR1_Add_ss_SINR_Meas := false;
    var boolean v_FR2_Add_Cap_ss_SINR_Meas := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersFRX_Diff v_MeasAndMobParamFRX_ss_SINR_Meas_Common;
    var MeasAndMobParametersFRX_Diff v_FR1_Add_UE_NR_Cap_ss_SINR_Meas;
    var MeasAndMobParametersFRX_Diff v_FR2_Add_UE_NR_Cap_ss_SINR_Meas;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff)) {
      v_MeasAndMobParamFRX_ss_SINR_Meas_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR1_Add_UE_NR_Cap_ss_SINR_Meas := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR2_Add_UE_NR_Cap_ss_SINR_Meas := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }

    if(pc_ss_SINR_Meas) {
      // check indication of MeasAndMobParametersFRX_Diff_Common
      if (ispresent(v_MeasAndMobParamFRX_ss_SINR_Meas_Common.ss_SINR_Meas)) {
          v_MeasAndMobParamFRX_Diff_ss_SINR_Meas := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_ss_SINR_Meas.ss_SINR_Meas)) {
          v_FR1_Add_ss_SINR_Meas := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_ss_SINR_Meas.ss_SINR_Meas)) {
          v_FR2_Add_Cap_ss_SINR_Meas := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamFRX_Diff_ss_SINR_Meas, v_FR1_Add_ss_SINR_Meas, v_FR2_Add_Cap_ss_SINR_Meas)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for ss_SINR_Meas but pc_ss_SINR_Meas is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_ss_SINR_Meas to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_MeasAndMobParamFRX_Diff_ss_SINR_Meas) or v_FR1_Add_ss_SINR_Meas or v_FR2_Add_Cap_ss_SINR_Meas)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_ss_SINR_Meas on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_MeasAndMobParamFRX_Diff_ss_SINR_Meas)
          {
             if (v_FR1_Add_ss_SINR_Meas and v_FR2_Add_Cap_ss_SINR_Meas) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FR1_Add_ss_SINR_Meas or v_FR2_Add_Cap_ss_SINR_Meas)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_ss_SINR_Meas_Common.ss_SINR_Meas) or
              ispresent(v_FR1_Add_UE_NR_Cap_ss_SINR_Meas.ss_SINR_Meas) or
              ispresent(v_FR2_Add_UE_NR_Cap_ss_SINR_Meas.ss_SINR_Meas)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_ss_SINR_Meas to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

