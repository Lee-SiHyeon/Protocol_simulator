    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {  // UE_NR_Capability_v1650
        if (pc_NR_mpsPriorityIndication_r16) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_NR_Capability_v1650, no PICS shall be set in a branch when parent is not present");    // UE_NR_Capability_v1650
        }
    }
    if (not isvalue(v_Received_NRCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {  // UE_NR_Capability_v1690
        if (pc_NR_UL_Segmentation) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_NR_Capability_v1690, no PICS shall be set in a branch when parent is not present");    // UE_NR_Capability_v1690
