          (p_NrDlPrsProcessingCapabilityBandList[v_Index].maxNumOfDL_PRS_ResProcessedPerSlot_r16.scs30_r16 == pc_maxNumOfDL_PRS_ResProcessedPerSlot_SCS30)) {
