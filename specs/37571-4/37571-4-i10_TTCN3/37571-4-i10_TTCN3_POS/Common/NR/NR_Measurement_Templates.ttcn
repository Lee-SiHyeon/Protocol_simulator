module NR_Measurement_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};

  template (value) MeasConfig cs_NR_MeasConfigCommon (template (omit) MeasObjectToRemoveList p_MeasObjectToRemoveList := omit,
                                                      template (omit) MeasObjectToAddModList p_MeasObjectToAddModList := omit,
                                                      template (omit) ReportConfigToRemoveList p_ReportConfigToRemoveList := omit,
                                                      template (omit) ReportConfigToAddModList p_ReportConfigToAddModList := omit,
                                                      template (omit) MeasIdToRemoveList p_MeasIdToRemoveList := omit,
                                                      template (omit) MeasIdToAddModList p_MeasIdToAddModList := omit,
                                                      template (omit) MeasConfig.s_MeasureConfig p_S_MeasureConfig := omit,
                                                      template (omit)QuantityConfig p_QuantityConfig := omit,
                                                      template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                                      template (omit) MeasGapSharingConfig  p_MeasGapSharingConfig := omit
   ):=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    measObjectToRemoveList := p_MeasObjectToRemoveList,
    measObjectToAddModList := p_MeasObjectToAddModList,
    reportConfigToRemoveList := p_ReportConfigToRemoveList,
    reportConfigToAddModList := p_ReportConfigToAddModList,
    measIdToRemoveList :=  p_MeasIdToRemoveList,
    measIdToAddModList := p_MeasIdToAddModList,
    s_MeasureConfig := p_S_MeasureConfig,
    quantityConfig := p_QuantityConfig,
    measGapConfig := p_MeasGapConfig,
    measGapSharingConfig := p_MeasGapSharingConfig,
    interFrequencyConfig_NoGap_r16 := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    effectiveMeasWindowConfig_r18  := omit     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
};

  template (value) MeasObjectToAddMod cs_NR_MeasObjectToAddMod_NR(MeasObjectId p_MeasObjectId,
                                                                  template (value) MeasObjectNR p_MeasObject) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    measObjectId := p_MeasObjectId,
    measObject   := {
      measObjectNR := p_MeasObject
    }
  };

  template (value) MeasObjectNR cs_NR_MeasObjectNR_Base(FreqBandIndicatorNR p_FreqBandIndicatorNR) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-194795: p_FreqBandIndicatorNR sic@
    ssbFrequency := omit,
    ssbSubcarrierSpacing := omit,
    smtc1 := omit,
    smtc2 := omit,
    refFreqCSI_RS := omit,
    referenceSignalConfig := {
      ssb_ConfigMobility := omit,
      csi_rs_ResourceConfigMobility := omit
    },
    absThreshSS_BlocksConsolidation := omit,
    absThreshCSI_RS_Consolidation := omit,
    nrofSS_BlocksToAverage := omit,
    nrofCSI_RS_ResourcesToAverage := omit,
    quantityConfigIndex := 1,
    offsetMO := cs_NR_Q_OffsetRangeList_0dB,
    cellsToRemoveList := omit,
    cellsToAddModList := omit,
    excludedCellsToRemoveList :=  omit,     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    excludedCellsToAddModList := omit,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    allowedCellsToRemoveList := omit,       /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    allowedCellsToAddModList := omit,       /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    freqBandIndicatorNR := p_FreqBandIndicatorNR,      // @sic BASELINE MOVING OCT 2018 R5s201387 BASELINE MOVING 2020 sic@
    measCycleSCell  := omit,                           // @sic BASELINE MOVING OCT 2018 R5s201387 BASELINE MOVING 2020 sic@
    smtc3list_r16   := omit,                           /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    rmtc_Config_r16 := omit,                           /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    t312_r16        := omit,                           /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    associatedMeasGapSSB_r17      := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    associatedMeasGapCSIRS_r17    := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    smtc4list_r17                 := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    measCyclePSCell_r17           := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    cellsToAddModListExt_v1710    := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    associatedMeasGapSSB2_v1720   := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    associatedMeasGapCSIRS2_v1720 := omit,             /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    measSequence_r18              := omit,             /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    cellsToAddModListExt_v1800    := omit              /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) Q_OffsetRangeList cs_NR_Q_OffsetRangeList_0dB :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    rsrpOffsetSSB := dB0,
    rsrqOffsetSSB := dB0,
    sinrOffsetSSB := dB0,
    rsrpOffsetCSI_RS := dB0,
    rsrqOffsetCSI_RS := dB0,
    sinrOffsetCSI_RS := dB0
  };

  template (value) GapConfig cs_NR_GapConfig (GapConfig.gapOffset p_GapOffset,
                                            GapConfig.mgl p_Mgl,
                                            GapConfig.mgrp p_Mgrp,
                                            GapConfig.mgta p_Mgta,
                                            template (omit) GapConfig.refServCellIndicator p_RefServCellIndicator := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    gapOffset := p_GapOffset,
    mgl := p_Mgl,
    mgrp := p_Mgrp,
    mgta := p_Mgta,
    refServCellIndicator := p_RefServCellIndicator,    /* @sic R5s190543 BASELINE MOVING 2019 sic@ */
    refFR2ServCellAsyncCA_r16 := omit,                 /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    mgl_r16 := omit                                    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
  };

 template (value) GapConfig cs_38508_GapConfig := cs_NR_GapConfig(39, ms6, ms40, ms0); /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */

  template (value) MeasGapConfig cs_38508_MeasGapConfig_Base :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    gapFR2 := omit,
    gapFR1 := omit,
    gapUE  := omit,
    gapToAddModList_r17    := omit,                /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    gapToReleaseList_r17   := omit,                /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    posMeasGapPreConfigToAddModList_r17  := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    posMeasGapPreConfigToReleaseList_r17 := omit   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) MeasGapConfig cds_MeasGapConfig_UE (template (value) GapConfig p_GapConfig := cs_38508_GapConfig)
    modifies cs_38508_MeasGapConfig_Base :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
        gapUE := {
          setup := p_GapConfig
        }
  };

}
