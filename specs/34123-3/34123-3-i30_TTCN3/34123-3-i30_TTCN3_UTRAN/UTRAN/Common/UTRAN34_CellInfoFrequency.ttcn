module UTRAN34_CellInfoFrequency {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_CellInfo all;
  import from UTRAN_CellInfo all;
  import from UTRAN_Component all;
  import from UTRAN_Parameters all;
  import from UTRAN_RRC_Templates all;

  type record UTRAN34_Frequency_List_Type {  /* @status    APPROVED (UTRAN) */
    /* This structure is used to contain the different frequencies f1, f2, f3, f4 as per 34.123-1 Table 6.3 */
    FrequencyInfo      f1,
    FrequencyInfo      f2,
    FrequencyInfo      f3,
    FrequencyInfo      f4
  };

  /* @desc      Function used to return the FDD UTRAN frequencies as defined in 34.123-1 Table 6.3
   * @param     p_Band
   * @return    UTRAN34_Frequency_List_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetSpecificFrequenciesFDD(integer p_Band) return UTRAN34_Frequency_List_Type
  {
    var template (value) UTRAN34_Frequency_List_Type v_Frequency_List;
   
    //Initialise with dummy frequencies
    v_Frequency_List.f1 := cs_FreqInfo_FDD(0);
    v_Frequency_List.f2 := cs_FreqInfo_FDD(0);
    v_Frequency_List.f3 := cs_FreqInfo_FDD(0);
    v_Frequency_List.f4 := cs_FreqInfo_FDD(0);

    select (p_Band) {
      case (1){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(9613 + 950);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(9663 + 950);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(9713 + 950);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(9763 + 950);
      }
      case (2){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(9263 + 400);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(9313 + 400);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(9363 + 400);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(9413 + 400);
      }
      case (3){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(938 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(988 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(1038 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(1088 + 225);
      }
      case (4){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(1313 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(1363 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(1413 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(1463 + 225);
      }
      case (5){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4133 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4158 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4183 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(4208 + 225);
      }
      case (6){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(812 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(837 + 225);
      }
      case(7){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(2013 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(2063 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(2113 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(2163 + 225);
      }
      case(8){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(2713 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(2763 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(2813 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(2862 + 225);
      }
      case(9){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(8762 + 475);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(8812 + 475);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(8862 + 475);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(8912 + 475);
      }
      case(10){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(2888 + 475);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(2938 + 475);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(2988 + 475);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(3038 + 475);
      }
      case(11){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3487 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3512 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(3537 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(3562 + 225);
      }
      case(12){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3613 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3638 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(3663 + 225);
      }
      case(13){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3842 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3867 + 225);
      }
      case(14){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3942 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3967 + 225);
      }
      case(19){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(387 + 400);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(412 + 400);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(437 + 400);
      }
      case(20){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4288 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4338 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4388 + 225);
      }
      case(21){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(462 + 400);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(487 + 400);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(512 + 400);
      }
      case(22){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4438 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4488 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4538 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(4588 + 225);
      }
      case(25){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4488 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4538 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4588 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(4638 + 225);
      }
      case(26){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4083 + 225);
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4108 + 225);
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4133 + 225);
        v_Frequency_List.f4 := cs_FreqInfo_FDD(4158 + 225);
      }
      case else { FatalError (__FILE__, __LINE__, "Invalid UTRAN Band, not defined in 34.123-1 table 6.3"); }
    }
    return valueof(v_Frequency_List);
  }

  /* @desc      Function used to return the TDD UTRAN frequencies as defined in 34.123-1 Table 6.4a
   * @param     p_Band
   * @return    UTRAN34_Frequency_List_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetSpecificFrequenciesTDD(charstring p_Band) return UTRAN34_Frequency_List_Type
  {
    var template (value) UTRAN34_Frequency_List_Type v_Frequency_List;
   
    //Initialise with dummy frequencies
    v_Frequency_List.f1 := cs_FreqInfo_TDD(0);
    v_Frequency_List.f2 := cs_FreqInfo_TDD(0);
    v_Frequency_List.f3 := cs_FreqInfo_TDD(0);
    v_Frequency_List.f4 := cs_FreqInfo_TDD(0);
   
    select (p_Band) {
      case ("a"){  //Band a
        v_Frequency_List.f1 := cs_FreqInfo_TDD(9505);
        v_Frequency_List.f2 := cs_FreqInfo_TDD(9550);
        v_Frequency_List.f3 := cs_FreqInfo_TDD(9595);
        v_Frequency_List.f4 := cs_FreqInfo_TDD(10055);
      }
      case("b"){  //Band b
        v_Frequency_List.f1 := cs_FreqInfo_TDD(9255);
        v_Frequency_List.f2 := cs_FreqInfo_TDD(9400);
        v_Frequency_List.f3 := cs_FreqInfo_TDD(9545);
        v_Frequency_List.f4 := cs_FreqInfo_TDD(9655);
      }
      case("c"){  //Band c
        v_Frequency_List.f1 := cs_FreqInfo_TDD(9555);
        v_Frequency_List.f2 := cs_FreqInfo_TDD(9573);
        v_Frequency_List.f3 := cs_FreqInfo_TDD(9591);
        v_Frequency_List.f4 := cs_FreqInfo_TDD(9608);
      }
      case else { FatalError(__FILE__, __LINE__, "Invalid TDD UTRAN Band, not defined in 34.123-1 table 6.4a"); }
    }
    return valueof(v_Frequency_List);
  }

  /* @desc      Function used to assign the specific frequency test channel 1/2/3/4 acc to 34.123-1 clause 6
   * @param     p_CellId
   * @param     p_TestChannel
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_SetSpecificFrequency(UTRAN_CellId_Type p_CellId,
                                          integer p_TestChannel) runs on UTRAN_PTC
  {
    var UTRAN34_Frequency_List_Type v_Frequency_List;
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var integer v_FDD_Band;
    var charstring v_TDD_Band := px_TDD_OperationBandCharstring;  //TDD band not stored in UTRAN cell info
    
    if (v_FDD_TDD_Mode == UTRAN_FDD) {  // FDD
      v_FDD_Band := f_UTRAN_CellInfo_GetFDD_Band(p_CellId);
      v_Frequency_List := f_UTRAN34_GetSpecificFrequenciesFDD(v_FDD_Band);
    }
    else {
      v_Frequency_List := f_UTRAN34_GetSpecificFrequenciesTDD(v_TDD_Band);
    }
    
    select (p_TestChannel){
      case(1) { f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f1) }
      case(2) { f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f2) }
      case(3) { f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f3) }
      case(4) { f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f4) }
      case else { FatalError(__FILE__, __LINE__, "Invalid UTRAN Band, not defined in 34.123-1 table 6.3"); }
    }
  }

}
