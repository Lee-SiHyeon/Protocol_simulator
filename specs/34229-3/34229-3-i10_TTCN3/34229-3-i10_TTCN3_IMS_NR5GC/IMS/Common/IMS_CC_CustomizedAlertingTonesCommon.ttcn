module IMS_CC_CustomizedAlertingTonesCommon {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      return template for SDP message used in 183 Session Progress for CAT test cases
   * @param     p_SDP_MessageInvite
   * @param     p_AudioCodec
   * @param     p_EvsConfiguration
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS)
   */
  function fl_IMS_CAT_BuildSdpMessage(SDP_Message p_SDP_MessageInvite,
                                      IMS_SDP_AudioCodec_Type p_AudioCodec,
                                      SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration) runs on IMS_PTC return template (value) SDP_Message
  { /* @sic R5s150714: optimization see 4.4  sic@ */
    /* @sic R5s210788: p_AudioCodec sic@ */
    /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    var template (value) SDP_Message v_SDP_Message := f_IMS_BuildSDP_InitialAnswerAudio_TX(p_SDP_MessageInvite, tsc_SDP_WithoutPreconditions, p_AudioCodec, p_EvsConfiguration);   /* preconditions to be added later on */
    var template (omit) SDP_attribute_list v_SDP_MediaAttributes;
    var template (omit) SDP_attribute_list v_SDP_PreconditionAttributes;

    v_SDP_PreconditionAttributes := cs_SDP_PreconditionAttributesWithConf(c_sendrecv, c_none, c_mandatory, c_mandatory);
    
    v_SDP_MediaAttributes := f_SDP_Attributes_Add_TX(v_SDP_Message.media_list[0].attributes, cs_SDP_Attribute_content("g.3gpp.cat"));
    v_SDP_Message.media_list[0].attributes := f_SDP_Attributes_Concat_TX(v_SDP_MediaAttributes, v_SDP_PreconditionAttributes);
    
    return v_SDP_Message;
  }

  /*
   * @desc      Send 183 Session Progress for CAT forking (step 9 of test TC_20_1 and step 9 of TC_7_26_NR5GC)
   * @param     p_InviteRequestWithSdp
   * @param     p_AudioCodec      (default value: AMR_16000)
   * @param     p_EvsConfiguration  (default value: NO_EVS)
   * @param     p_ContactUri      (default value: "sip:cat-as.home1.net")
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS)
   */
  function f_IMS_CAT_Send183SessionProgress(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                            IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000,
                                            SDP_EVS_Configuration_MOCallSetup_Type p_EvsConfiguration := NO_EVS,
                                            charstring p_ContactUri := "sip:cat-as.home1.net") runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5s210788: p_AudioCodec sic@ */
    /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    /* @sic R5-243984: p_EvsConfiguration := NO_EVS sic@ */
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(p_InviteRequestWithSdp.RoutingInfo);
    var template (value) SemicolonParam_List v_AditionalContactParams := { crs_FeatureParam_3gpp_icsi_ref };  // @sic R5s190882: crs_FeatureParam_3gpp_icsi_ref sic@
    var charstring v_ToTag := "xyzTC20_1-INVITE-Totag";
    var template (value) SDP_Message v_SdpMessage := fl_IMS_CAT_BuildSdpMessage(p_InviteRequestWithSdp.SdpOffer, p_AudioCodec, p_EvsConfiguration);
    var template (value) MessageHeader v_MessageHeader183;

    v_MessageHeader183 := f_IMS_InviteResponse_183_MessageHeaderTX(p_InviteRequestWithSdp.Invite, p_ContactUri, v_AditionalContactParams);
    v_MessageHeader183.pEarlyMedia  := cs_PEarlyMedia({c_sendonly});            /* @sic R5s190882 sic@ */
    v_MessageHeader183.toField.toParams[0].paramValue.tokenOrHost := v_ToTag;   /* @sic R5s150714: dialog 2 setting see 4.2  sic@ */

    f_IMS_PTC_ImsInfo_DialogSetLocalTag(v_ToTag);

    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine183, v_MessageHeader183, cs_MessageBody_SDP(v_SdpMessage))));
    
    return v_MessageHeader183;
  }

}
