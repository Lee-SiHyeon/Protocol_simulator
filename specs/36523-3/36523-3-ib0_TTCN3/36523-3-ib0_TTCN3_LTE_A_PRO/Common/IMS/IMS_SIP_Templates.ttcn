  /*
   * @desc      return pattern to match accessType field of the PAccessNetworkInfo header
   *            (see 24.229 clause 7.2A.4.3)
   * @param     p_RAN_Type
   * @return    template (present) charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_PAccessNetworkInfo_AccessType(template (omit) IPCAN_RAN_Type p_RAN_Type) return template (present) charstring
  {
    var template (present) charstring v_RanString := ?;
    var IPCAN_RAN_Type v_RAN_Type;
    
    if (ispresent(p_RAN_Type)) {
      v_RAN_Type := valueof(p_RAN_Type);
      select (v_RAN_Type) {
        case (UTRAN_FDD) {
          v_RanString := "3GPP-UTRAN-FDD";
        }
        case (UTRAN_TDD) { v_RanString := "3GPP-UTRAN-TDD";
        }
        case (GERAN) {
          v_RanString := "3GPP-GERAN";
        }
        case (EUTRA_FDD) {
          v_RanString := "3GPP-E-UTRAN-FDD";            // @sic R5s120530 change 1.4 sic@
        }
        case (EUTRA_TDD) {
          v_RanString := "3GPP-E-UTRAN-TDD";
        }
        case (WLAN) {
          v_RanString := pattern "IEEE-802.11*";        // @sic R5-165947: WLAN registration sic@
        }
        case (NR) {
          if (pc_supportOfRedCap_r17) {                 // @sic R5-254960 sic@
            v_RanString := ("3GPP-NR", "3GPP-NR-FDD", "3GPP-NR-TDD", "3GPP-NR-REDCAP");
          } else {
            v_RanString := ("3GPP-NR", "3GPP-NR-FDD", "3GPP-NR-TDD");
          }
        }
        case else {
          FatalError(__FILE__, __LINE__, "Unknown RANTech");
        }
      }
    }
    return v_RanString;
  }

  /*
   * @desc      return parameter list with mandatory parameter for given RAN type
   * @param     p_RAN_Type
   * @param     p_MandatoryParameterValue
   * @return    template SemicolonParam_List
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_PAccessNetworkInfo_ParamList(template (omit) IPCAN_RAN_Type p_RAN_Type,
                                           template GenValue p_MandatoryParameterValue) return template SemicolonParam_List
  { /* p_MandatoryParameterValue: cell-id or MAC addr */
    var template SemicolonParam_List v_ParamList := *;
    var IPCAN_RAN_Type v_RAN_Type;
    
    if (ispresent(p_RAN_Type)) {
      v_RAN_Type := valueof(p_RAN_Type);
      select (v_RAN_Type) {
        case (UTRAN_FDD, UTRAN_TDD, EUTRA_FDD, EUTRA_TDD, NR) {
          v_ParamList := { cr_GenericParam_Common("utran-cell-id-3gpp", p_MandatoryParameterValue), * };
        }
        case (WLAN) {
          v_ParamList := { cr_GenericParam_Common("i-wlan-node-id", p_MandatoryParameterValue), * };
        }
      }
    }
    return v_ParamList;
  }

