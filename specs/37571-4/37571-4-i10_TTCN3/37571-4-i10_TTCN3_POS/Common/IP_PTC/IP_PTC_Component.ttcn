module IP_PTC_Component {

  import from CommonDefs all;
  import from CommonIP all;
  import from HTTP_ASP_TypeDefs all;
  import from IMS_ASP_TypeDefs all;
  import from IP_ASP_TypeDefs all;
  import from IP_PTC_CtrlMsgs all;
  import from IP_PTC_TcpHandlerMsgs all;
  import from IP_PTC_UdpPacketHandlerMsgs all;

  type record PDN_MappingInfo_Type {                            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_DrbInfo_Type DefaultDrb optional                         /* omit => no IP handling for the respective PDN */
  };

  type record of PDN_MappingInfo_Type PDN_MappingTable_Type;    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type record AddrServerInfo_Type {                             /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    charstring         ServerAddr       optional,               /* the server's address;
                                                                   global address in case of IPv6 */
    charstring         ClientAddr       optional,               /* IP address to be assigned to the UE via DHCP or ICMPv6;
                                                                   global address in case of IPv6 */
    PDN_Index_Type     PdnIndex         optional                /* omit as long as a server is not started;
                                                                   @sic R5-145754 sic@ */
  };

  type record of AddrServerInfo_Type IP_AddrServerArray_Type;   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
                                                                   @sic R5s170448 - WLAN: length restriction removed sic@ */

  type record PDN_IP_AddrServer_Type {                          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_AddrServerArray_Type    DHCP,                            /* NOTE: this information is needed for assignment of the IP address only */
    IP_AddrServerArray_Type    ICMPv6,                          /* NOTE: this information is needed for assignment of the IP address only;
                                                                 *       due to the privacy option the UE may use a different IPv6 address after stateless address autoconfiguration
                                                                 *       (see TS 23.401 cl. 5.3.1.2.2) */
    IP_AddrServerArray_Type    DNS_UdpIPv4,                     /* @sic R5-145754 sic@ */
    IP_AddrServerArray_Type    DNS_UdpIPv6                      /* @sic R5-145754 sic@ */
  };

  type union IMS_SecurityContextInfo_Type {     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IMS_SecurityInfo_Type       Protected,
    IMS_UnprotectedPorts_Type   Unprotected
  };

  type record IMS_SecurityContext_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IMS_SecurityContextInfo_Type SecurityInfo,
    IP_Connection_Type TcpClient optional,      /* IP connection with TTCN-side being client (i.e. connection setup by TTCN connecting to the UE) */
    IP_Connection_Type TcpServer optional       /* IP connection with TTCN-side being server (i.e. connection setup by the UE connecting to TTCN) */
  };

  type record IMS_PendingSecurityContext_Type {                         /* to store all information needed to remove a security context (IPsec configuration) after closing of related TCP connections has been confirmed
                                                                           @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IMS_RegistrationAddress_Type        RegistrationAddress,            /* UE and NW address to be used to release the IPsec connection
                                                                           @sic R5s170580: IMS server's RegistrationAddress may be released already when a pending security context is relased => RegistrationAddress needs to be copied sic@ */
    IMS_SecurityContext_Type            SecurityContext                 /* context to be released */
  };

  type record of IMS_PendingSecurityContext_Type IMS_PendingSecurityContextList_Type; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type record IMS_RegistrationAddress_Type {    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_AddrInfo_Type    NW,
    IP_AddrInfo_Type    UE
  };

  type record IMS_Server_Type {                                 /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IMS_SecurityContext_Type            UnprotectedContext,
    IMS_SecurityContext_Type            ProtectedContext1   optional,
    IMS_SecurityContext_Type            ProtectedContext2   optional,
    IP_AddrInfo_Type                    IPv4Addr            optional,   /* the server's IPv4 address, omit as long as the server is not started */
    IP_AddrInfo_Type                    IPv6Addr            optional,   /* the server's IPv6 address, omit as long as the server is not started */
    IPsec_SecurityKeys_Type             SecurityKeys        optional,   /* security keys to be applied for security associations */
    IMS_RegistrationAddress_Type        RegistrationAddress optional,   /* if present => UE has at least started the registration and in case of non-GIBA
                                                                           IPsec and UDP server for protected signalling are started */
    PDN_Index_Type                      PdnIndex            optional,   /* omit as long as the server is not started
                                                                           @sic R5s150648 Change 2.2: DrbInfo replaced by PdnIndex sic@ */
    IMS_PendingSecurityContextList_Type PendingSecurityContextList      /* @sic R5s170203 sic@
                                                                           List of security contexts which need to be released after closing of TCP connections has been confirmed */
  };

  type record length(tsc_NoOfIMSPDNs) of IMS_Server_Type IMS_ServerArray_Type;     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
                                                                                      @sic R5s201177: tsc_NoOfIMSPDNs instead of tsc_NoOfPDNs sic@ */

  type record IP_PTC_IMS_Info_Type {                            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IMS_ServerArray_Type        Server
  };

  type record IP_PTC_WLAN_Info_Type {  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    AddrServerInfo_Type    DNS_UdpServerIPv4,
    AddrServerInfo_Type    DNS_UdpServerIPv6,
    WLAN_AddressInfo_Type  AddressInfo optional,
    IP_DrbInfo_Type        DrbInfo optional,
    boolean                ExplicitDnsHandling /* @sic R5-169075 (test case 20.1) sic@ */
  };

  type record IP_PTC_DRB_RoutingInfo_Type {  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_RoutingTable_Type   Table,
    boolean                RawMode
  };

  type component IP_PTC {               /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    var IP_PTC_DRB_RoutingInfo_Type     vc_IP_PTC_DRB_RoutingInfo;     /* @sic R5s200490: vc_IP_PTC_DRB_RoutingInfo instead of vc_IP_PTC_DRB_RoutingTable sic@ */
    var PDN_IP_AddrServer_Type          vc_IP_PTC_PDN_AddrServer;
    var IP_PTC_IMS_Info_Type            vc_IP_PTC_IMS_Info;
    var PDN_MappingTable_Type           vc_IP_PTC_PDN_MappingTable;    /* @sic R5s150648 Change 2.1 sic@ */
    var IP_PTC_WLAN_Info_Type           vc_IP_PTC_WLAN_Info;
    var boolean                         vc_IP_PTC_MuSimConfiguration;  /* MUSIM: shall be set to true for MUSIM configurations, where the UE may camp on more than one cell simultaneously */

    // ports connected to IMS:
    port IP_IMS_CTRL_PORT       IMS_CTRL[tsc_NoOfIMSPDNs];             /* @sic R5s201177: tsc_NoOfIMSPDNs instead of tsc_NoOfPDNs sic@ */
    port IP_IMS_SERVER_PORT     IMS_Server[tsc_NoOfIMSPDNs];           /* @sic R5s201177: tsc_NoOfIMSPDNs instead of tsc_NoOfPDNs sic@ */
    port IP_IMS_CLIENT_PORT     IMS_Client[tsc_NoOfIMSPDNs];           /* @sic R5s201177: tsc_NoOfIMSPDNs instead of tsc_NoOfPDNs sic@ */

    // coordination ports:
    port IP_PTC_CTRL_PORT       EUTRA_CTRL;
    port IP_PTC_CTRL_PORT       UTRAN_CTRL;
    port IP_PTC_CTRL_PORT       GERAN_CTRL;
    port IP_PTC_CTRL_PORT       WLAN_CTRL;  /* @sic R5w160107 sic@ */
    port IP_PTC_CTRL_PORT       IPCAN_CTRL; /* @sic R5-203077: MCX IP test model - common IPCAN port independent from test model sic@ */
    port IP_PTC_CTRL_PORT       NR_CTRL;
    port IP_PTC_CTRL_PORT       USIM_B_CTRL;         /* MUSIM: coordination port for 2nd EUTRA/NR PTC */

    // coordination ports to HTTP_PTC
    port IP_HTTP_CTRL_PORT      HTTPCTRL;
    port IP_HTTP_DATA_PORT      HTTPDATA;

    // coordination port for sending of UDP packets to the UE (e.g. for OMA Push)
    port IP_UDP_HANDLER_PORT    UDPHANDLER;

    // coordination port for generic TCP handler
    port IP_TCP_HANDLER_PORT    TCPHANDLER;

    // ports to IP_MUX_PTC
    port IP_SOCKET_PORT         IP_SOCK_DATA;           /* @sic R5s150900 - MCC160 implementation sic@ */
    port IP_SOCKET_PORT         IP_SOCK_CTRL;           /* @sic R5s150900 - MCC160 implementation sic@ */

    port SOCKET_PORT_IPMUX      IP_SOCK_CTRL_QUEUE;     /* @sic R5s220117 - MCC160 implementation sic@ */

    // system ports
    port IP_CONTROL_PORT        IP_CTRL;
    port IPSEC_CONTROL_PORT     IPSEC_CTRL;
  };

  type component IPMUX_PTC {                            /* @sic R5s150900 - MCC160 implementation sic@
                                                           @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    // ports to IP_PTC
    port SOCKET_PORT_IPMUX      IP_SOCK_DATA;
    port SOCKET_PORT_IPMUX      IP_SOCK_CTRL;
    port IP_SOCKET_PORT         IP_SOCK_CTRL_QUEUE;     /* @sic R5s220117 - MCC160 implementation sic@ */
    // system port
    port IP_SOCKET_PORT         IP_SOCK;
  };

  type component IP_SYSTEM {                            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    port IP_CONTROL_PORT        IP_CTRL;
    port IPSEC_CONTROL_PORT     IPSEC_CTRL;
    port IP_SOCKET_PORT         IP_SOCK;
  };

  /*
   * @desc      set DrbInfo for given PDN
   * @param     p_PdnIndex
   * @param     p_DrbInfo
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_PTC_PDN_SetDrbInfoForDefaultDrb(PDN_Index_Type p_PdnIndex,
                                                IP_DrbInfo_Type p_DrbInfo) runs on IP_PTC
  {
    var integer v_Index := f_PDN_PdnIndex2Integer(p_PdnIndex);
    vc_IP_PTC_PDN_MappingTable[v_Index].DefaultDrb := p_DrbInfo;
  }

  /*
   * @desc      get DrbInfo for given PDN
   * @param     p_PdnIndex
   * @return    template (omit) IP_DrbInfo_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_PTC_PDN_GetDrbInfoForDefaultDrb(PDN_Index_Type p_PdnIndex) runs on IP_PTC return template (omit) IP_DrbInfo_Type
  {
    var integer v_Index := f_PDN_PdnIndex2Integer(p_PdnIndex);
    return vc_IP_PTC_PDN_MappingTable[v_Index].DefaultDrb;
  }

  type record of IP_SOCKET_IND IP_SOCKET_IND_List;                              /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_SOCKET_REQ cr_IP_SOCKET_REQ_Any := ?;                   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_SOCKET_IND cr_IP_SOCKET_IND_AnyData := {DATA := ?};     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_SOCKET_IND cr_IP_SOCKET_IND_AnyCtrl := {CTRL := ?};     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_SOCKET_IND crs_IP_FLUSH_IND :=  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
  { /* @sic R5s220117: flush command sent by the IP_PTC to tell the IPMUX PTC that it shall send the queued CTRL ASPs sic@ */
    CTRL := {
      ConnectionId := omit,
      Ind := omit
    }
  };

  /*
   * @desc      to multiplex data and ctrl in DL
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  altstep a_IPMUX_PTC_HandlerDL(SOCKET_PORT_IPMUX p_Port) runs on IPMUX_PTC
  {
    var IP_SOCKET_REQ v_IP_SOCKET_REQ;
    
    [] p_Port.receive(cr_IP_SOCKET_REQ_Any) -> value v_IP_SOCKET_REQ {
      IP_SOCK.send(v_IP_SOCKET_REQ);
    }
  }

  /*
   * @desc      to de-multiplex data and ctrl in UL
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  altstep a_IPMUX_PTC_HandlerUL() runs on IPMUX_PTC
  {
    var IP_SOCKET_IND v_IP_SOCKET_IND;
    
    [] IP_SOCK.receive(cr_IP_SOCKET_IND_AnyData) -> value v_IP_SOCKET_IND {
      IP_SOCK_DATA.send(v_IP_SOCKET_IND);
    }
    [] IP_SOCK.receive(cr_IP_SOCKET_IND_AnyCtrl) -> value v_IP_SOCKET_IND {
      IP_SOCK_CTRL.send(v_IP_SOCKET_IND);
    }
  }

  /*
   * @desc      to queue ASPs sent back by the IP_PTC to be processed later
   * @param     p_IP_SOCKET_IND_List  (by reference)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  altstep a_IPMUX_PTC_HandlerUL_Queue(inout IP_SOCKET_IND_List p_IP_SOCKET_IND_List) runs on IPMUX_PTC
  {
    var IP_SOCKET_IND v_IP_SOCKET_IND;
    var integer i;

    [] IP_SOCK_CTRL_QUEUE.receive(crs_IP_FLUSH_IND) {
      for (i := 0; i < lengthof(p_IP_SOCKET_IND_List); i:= i + 1) {
        IP_SOCK_CTRL.send(p_IP_SOCKET_IND_List[i]);
      }
      p_IP_SOCKET_IND_List := {};
    }
    [] IP_SOCK_CTRL_QUEUE.receive(cr_IP_SOCKET_IND_AnyCtrl) -> value v_IP_SOCKET_IND {
      i := lengthof(p_IP_SOCKET_IND_List);
      p_IP_SOCKET_IND_List[i] := v_IP_SOCKET_IND;
    }
  }

  /*
   * @desc      Multiplexer to distinguish DATA and CTRL in UL:
   *            as socket configuration typically is blocking (i.e. TTCN sends a request to the SS and waits for the confirmation) there is a problem when there is UL data in parallel to the configuration:
   *            TTCN expects the CNF to come but instead there is data (i.e. a message not matching the expected CNF) and therefore TTCN gets blocked as the data remains in the input queue.
   *            By multiplexing (and de-multiplexing) DATA and CTRL primitives the data will be put to the IP_SOCK_DATA port and will remain in the input queue until the IP_PTC has gotten the CNF from the IP_SOCK_CTRL port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IPMUX_PTC_MainLoop() runs on IPMUX_PTC
  {
    var IP_SOCKET_IND_List v_IP_SOCKET_IND_List_ByRef := {};            // @sic R5s220117: to queue CTRL ASPs sent back from the IP_PTC sic@
    while (true) {
      alt {
        [] a_IPMUX_PTC_HandlerDL(IP_SOCK_DATA);
        [] a_IPMUX_PTC_HandlerDL(IP_SOCK_CTRL);
        [] a_IPMUX_PTC_HandlerUL_Queue(v_IP_SOCKET_IND_List_ByRef);     // @sic R5s220117: store CTRL ASPs sent back from IP_PTC in queue until flush command is sent by the IP_PTC sic@
        [] a_IPMUX_PTC_HandlerUL();
      }
    }
  }

  /*
   * @desc      Wait for the expected confirmation and send back all other indications to the IPMUX to avoid blocking
   * @param     p_ExpectedCNF
   * @param     p_ReceivedCNF       (by reference)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  altstep a_IP_PTC_ReceiveCNF_NonBlocking(template (present) IP_SOCKET_IND p_ExpectedCNF,
                                          out IP_SOCKET_IND p_ReceivedCNF) runs on IP_PTC
  {
    var IP_SOCKET_IND v_IP_SOCKET_IND;

    [] IP_SOCK_CTRL.receive(p_ExpectedCNF) -> value v_IP_SOCKET_IND {
      IP_SOCK_CTRL_QUEUE.send(crs_IP_FLUSH_IND);                             /* @sic R5s220117: tell IPMUX_PTC to resend queued ASPs sic@ */
      p_ReceivedCNF := v_IP_SOCKET_IND;
    }
    [] IP_SOCK_CTRL.receive(cr_IP_SOCKET_IND_AnyCtrl) -> value v_IP_SOCKET_IND {
      IP_SOCK_CTRL_QUEUE.send(v_IP_SOCKET_IND);                               /* @sic R5s220117: send ASP back to IPMUX_PTC to be processed after the TCP_CLOSE_CNF corresponding to the current TCP_CLOSE_REQ has been received sic@ */
      repeat;
    }
  }

  /*
   * @desc      Send request and wait for the confirmation;
   *            all other indications which are received from the IPMUX are sent back to the IPMUX to avoid blocking
   * @param     p_IP_SOCKET_REQ
   * @param     p_IP_SOCKET_CNF
   * @return    IP_SOCKET_IND
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_PTC_SendREQ_ReceiveCNF_NonBlocking(template (value) IP_SOCKET_REQ p_IP_SOCKET_REQ,
                                                   template (present) IP_SOCKET_IND p_IP_SOCKET_CNF) runs on IP_PTC return IP_SOCKET_IND
  {
    var IP_SOCKET_IND v_IP_SOCKET_IND;
    
    IP_SOCK_CTRL.send(p_IP_SOCKET_REQ);
    a_IP_PTC_ReceiveCNF_NonBlocking(p_IP_SOCKET_CNF, v_IP_SOCKET_IND);
    return v_IP_SOCKET_IND;
  }

  /*
   * @desc      Create IP PTC and map system ports
   * @param     p_System
   * @return    IP_PTC
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_PTC_CreateAndMap(IP_SYSTEM p_System) return IP_PTC
  {
    var IP_PTC v_IP_PTC := IP_PTC.create("IP") alive;                // @sic R5s210270 sic@
    var IPMUX_PTC v_IPMUX_PTC := IPMUX_PTC.create("IPMUX") alive;    // @sic R5s210270 sic@

    map(v_IP_PTC:IP_CTRL,    p_System:IP_CTRL);
    map(v_IP_PTC:IPSEC_CTRL, p_System:IPSEC_CTRL);
    map(v_IPMUX_PTC:IP_SOCK, p_System:IP_SOCK);

    connect(v_IP_PTC:IP_SOCK_DATA, v_IPMUX_PTC:IP_SOCK_DATA);
    connect(v_IP_PTC:IP_SOCK_CTRL, v_IPMUX_PTC:IP_SOCK_CTRL);
    connect(v_IP_PTC:IP_SOCK_CTRL_QUEUE, v_IPMUX_PTC:IP_SOCK_CTRL_QUEUE);

    v_IPMUX_PTC.start(f_IPMUX_PTC_MainLoop());

    return v_IP_PTC;
  }

}
