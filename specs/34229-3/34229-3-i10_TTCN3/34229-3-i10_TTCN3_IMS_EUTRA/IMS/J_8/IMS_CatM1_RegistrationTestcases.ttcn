module IMS_CatM1_RegistrationTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_8 all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.8.1
   * @status    APPROVED (IMS)
   */
  function f_TC_J_8_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_InitialRegistration();

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

}
