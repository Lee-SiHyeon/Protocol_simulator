module MTC_Component_POS {

  import from EUTRA_Component all;
  import from EUTRA_POS_Component all;
  import from IP_PTC_Component all;
  import from MTC_Base all;
  import from NR5GC_POS_Component all;
  import from NR_Component_NR5GC all;
  import from NasEmu5G_Component_NR_BASE all;
  import from NasEmu_Component_EUTRA all;
  import from PosSystem_ASP_TypeDefs all;
  import from UTRAN_Component all;

  type record MTC_POS_Components_Type {  /* @status    APPROVED (POS) */
    EUTRA_PTC  Eutra,
    UTRAN_PTC  Utran,
    NR5GC_PTC  Nr, //NR addition
    EUTRA_PTC  EutraOtdoa  //NR addition
  };

  type component MTC_POS extends MTC_BASE {  /* @status    APPROVED (POS) */
    var MTC_POS_Components_Type vc_Components;
    var POS_Ctrl_Type vc_POS_Ctrl;
    
    // System Ports:
    port POS_MTC_SYSTEM_PORT    POSSYS;        // Positioning: Port at MTC connected to the system interface

    // Coordination Ports:
    port POS_MTC_PTC_PORT       PTC_POSSYS[tsc_NoOfCordPorts];     // coordination ports to up to 4 PTCs
  };

  type component SYSTEM_POS extends MTC_BASE_SYSTEM, EUTRA_POS_SYSTEM, UTRAN_SYSTEM, NASEMU_EUTRA_SYSTEM, IP_SYSTEM, NR_POS_SYSTEM, NASEMU_NR_SYSTEM { //NR addition
    /* @status    APPROVED (POS) */
    port POS_MTC_SYSTEM_PORT POSSYS;
  };

}
