    f_IMS_MOCallHoldResume(RESUME, v_InviteRequest, v_CallInfo.MessageHeader183, v_CallInfo.LatestSdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 11 - 13" siclog@
    f_IMS_CallReleaseMO(v_InviteRequest);
    
