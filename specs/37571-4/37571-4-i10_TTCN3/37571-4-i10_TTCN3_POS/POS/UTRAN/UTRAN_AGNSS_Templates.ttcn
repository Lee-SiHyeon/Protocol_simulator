  template (value) UE_Positioning_Measurement_r8 cs_UePositioningMeasurement_r8(UE_Positioning_MethodType  p_PositioningMethod,
                                                                                boolean p_AdditionalAssistDataReq,
                                                                                bitstring  p_GANSS_PositioningMethod,
                                                                                template (omit) bitstring  p_GANSS_MultiFreqMeasReq,
                                                                                template (value) UE_Positioning_ReportCriteria_r7       p_ReportCriteria,
                                                                                template (omit) UE_Positioning_GPS_AssistanceData_r7    p_GPS_AssistanceData,
                                                                                template (omit) UE_Positioning_GANSS_AssistanceData_r8  p_GANSS_AssistanceData_r8) :=
  { /* @status    APPROVED (POS) */
    ue_positioning_ReportingQuantity := {
      methodType := p_PositioningMethod,
      positioningMethod := gps,
      horizontalAccuracy := int2bit (127,7),
      verticalAccuracy := int2bit (127,7),
      gps_TimingOfCellWanted := false,
      additionalAssistanceDataReq := p_AdditionalAssistDataReq,
      environmentCharacterisation := omit,
      velocityRequested := omit,
      gANSSPositioningMethods := p_GANSS_PositioningMethod,
      gANSSTimingOfCellWanted := omit,
      gANSSCarrierPhaseMeasurementRequested := omit,
      gANSSMultiFreqMeasurementRequested := p_GANSS_MultiFreqMeasReq
    },
    measurementValidity := {
      ue_State := all_States
    },
    reportCriteria := p_ReportCriteria,
    ue_positioning_OTDOA_AssistanceData := omit,
    ue_positioning_GPS_AssistanceData := p_GPS_AssistanceData,
    ue_positioning_GANSS_AssistanceData := p_GANSS_AssistanceData_r8
  };

