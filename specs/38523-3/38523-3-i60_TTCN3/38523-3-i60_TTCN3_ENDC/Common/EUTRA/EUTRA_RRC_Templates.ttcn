      c1 := {
        securityModeCommand := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
            c1 := {
              securityModeCommand_r8 := {
                securityConfigSMC := {
                  securityAlgorithmConfig := cs_SecurityAlgorithmConfig(p_IntegrityProtAlgorithm, p_CipheringAlgorithm)
                },
                nonCriticalExtension := omit
              }
            }
          }
        }
      }
    }
  };

