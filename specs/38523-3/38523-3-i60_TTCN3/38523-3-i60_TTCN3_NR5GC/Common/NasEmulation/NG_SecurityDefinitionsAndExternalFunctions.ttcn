module NG_SecurityDefinitionsAndExternalFunctions {

  import from CommonDefs all;

  //============================================================================
  external function fx_NG_NasIntegrityAlgorithm(octetstring   p_EncodedNasPdu,
                                             B4_Type       p_IntegrityAlgorithm,
                                             B128_Key_Type p_KNASint,
                                             NasCount_Type p_NasCount,
                                             B5_Type       p_BearerId,
                                             MAC_Direction_Type p_Direction) return MessageAuthenticationCode;

  external function fx_NG_NasCiphering(octetstring p_EncodedNasPdu,
                                    B4_Type       p_CipheringAlgorithm,
                                    B128_Key_Type p_KNASenc,
                                    NasCount_Type p_NasCount,
                                    B5_Type p_BearerId) return octetstring;

  external function fx_NG_NasDeciphering(octetstring p_CipheredNasMsg,
                                      B4_Type       p_CipheringAlgorithm,
                                      B128_Key_Type p_KNASenc,
                                      NasCount_Type p_NasCount,
                                      B5_Type p_BearerId) return octetstring;

  //----------------------------------------------------------------------------
}
