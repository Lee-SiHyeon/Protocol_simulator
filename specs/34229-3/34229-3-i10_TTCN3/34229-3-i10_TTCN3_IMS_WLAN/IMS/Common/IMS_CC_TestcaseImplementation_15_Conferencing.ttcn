module IMS_CC_TestcaseImplementation_15_Conferencing {

  import from CommonDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions4G all;
  import from IMS_CC_Parameters all;
  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_ConferenceEventPackage all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_CallHold all;
  import from IMS_Procedures_Conferencing all;
  import from IMS_Procedures_Video all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_MessagesVideo all;
  import from IMS_SIP_Templates all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      function to receive INVITE for voice/video call for conferencing
   * @param     p_TestProcedure
   * @param     p_CalleeUri
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MOCallSetup_Step2(IMS_TestProcedure_Type p_TestProcedure,
                                   charstring p_CalleeUri) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (present) SipUrl v_CalleeSipUrl := f_SIP_BuildSipUri_RX(p_CalleeUri);
 
    select (p_TestProcedure) {
      case (IPCAN_MO_SpeechCall) {
        v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(v_CalleeSipUrl);
      }
      case (IPCAN_MO_VideoCall) {
        v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall, v_CalleeSipUrl);
      }
    }
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      steps 2 .. 9 of C.10 (or steps 2 ..10 of C.38)
   * @param     p_TestProcedure
   * @param     p_ConferenceFactoryUri
   * @param     p_TemporaryConferenceUri
   * @param     p_FinalConferenceUri
   * @param     p_RadioBearersEstablished (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_ConferenceCreation_AnnexC10C38_Steps2_9(IMS_TestProcedure_Type p_TestProcedure,
                                                         charstring p_ConferenceFactoryUri,
                                                         charstring p_TemporaryConferenceUri,
                                                         charstring p_FinalConferenceUri,
                                                         boolean p_RadioBearersEstablished := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var template (value) SemicolonParam_List v_AdditionalContactParams := {cs_GenericParam("isfocus")}; // As per C.10
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var MessageHeader v_MessageHeader_183;
    var template (omit) SDP_Message v_SDP_Message_200OK := omit;
    var IMS_CallType_Type v_CallType := CONFERENCE_CALL;  /* @sic R5-155179 sic@ */
    var boolean v_IsWLAN := f_IMS_PTC_RanTypeIsWLAN();

    // @siclog "Step 2" siclog@         UE sends INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Step2(p_TestProcedure, p_ConferenceFactoryUri);
    
    if (v_IsWLAN) {
      f_IMS_MOCallSetup_Send100Trying(v_InviteRequestWithSdp);
      if (not p_RadioBearersEstablished) {
        f_IMS_CC_TriggerDedicatedBearerActivation(p_TestProcedure);
      }
      select (p_TestProcedure) {
        case (IPCAN_MO_SpeechCall) {
          v_SDP_Message_200OK := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer);
        }
        case (IPCAN_MO_VideoCall) {
          v_SDP_Message_200OK := f_IMS_BuildSDP_InitialAnswerAudioVideo_TX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer);
        }
      }
    }
    else {
      // @siclog "Step 3 - 4" siclog@
      select (p_TestProcedure) {
        case (IPCAN_MO_SpeechCall) {  // same steps as for C.10 what in fact are steps 3 - 4 of C.21
          v_MessageHeader_183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp, p_TemporaryConferenceUri, v_AdditionalContactParams, v_CallType);
        }
        case (IPCAN_MO_VideoCall) {   // same steps as for C.10 what in fact are steps 3 - 4 of C.25
          v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp, -, -, -, p_TemporaryConferenceUri, v_AdditionalContactParams, v_CallType);
          v_MessageHeader_183 := v_ResponseWithSdp.Response.msgHeader;
        }
      }
      if (not p_RadioBearersEstablished) {
        // See TS. 36.508 EUTRA/EPS signalling for IMS MO speech call Table 4.5A.6.3-1 Step 9-11
        f_IMS_CC_TriggerDedicatedBearerActivation(p_TestProcedure);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
      }
      
      // @siclog "Step 5 - 7a" siclog@
      select (p_TestProcedure) {
        case (IPCAN_MO_SpeechCall) {    // same steps as steps 5 - 8 of C.21
          f_IMS_MOCallSetup_AnnexC21_Steps5_8(v_InviteRequestWithSdp, v_MessageHeader_183, -, -, v_CallType);
        }
        case (IPCAN_MO_VideoCall) {     // same steps as steps 5 - 8 of C.25
          f_IMS_MOCallSetup_Video_Steps5_8(SetupVideoCall, v_InviteRequestWithSdp, v_MessageHeader_183, v_CallType);        // @sic R5s150373 change 1: C25 instead of AddVideo sic@
        }
      }
    }
      
    // @siclog "Step 8 - 9" siclog@         Send 200 OK (response to INVITE), receive ACK
    f_IMS_Conferencing_Send200OK_ReceiveACK(v_InviteRequestWithSdp, p_FinalConferenceUri, v_AdditionalContactParams, v_SDP_Message_200OK);  // @sic R5-211443: f_IMS_Conferencing_Send200OK_ReceiveACK sic@
 
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      steps 1 - 9 of C.10 or C.38 (video)
   * @param     p_TestProcedure
   * @param     p_ConferenceFactoryUri
   * @param     p_TemporaryConferenceUri
   * @param     p_FinalConferenceUri
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_ConferenceCreation_AnnexC10C38_Steps1_9(IMS_TestProcedure_Type p_TestProcedure,
                                                         charstring p_ConferenceFactoryUri,
                                                         charstring p_TemporaryConferenceUri,
                                                         charstring p_FinalConferenceUri) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    // @siclog "Step 1" siclog@         Trigger UE to create conference call
    f_IMS_CC_StartCall(p_TestProcedure, p_ConferenceFactoryUri, conferenceCall);  /* @sic R5s150373: p_TestProcedure instead of IPCAN_MO_SpeechCall sic@
                                                                                     @sic R5s150537: p_ConferenceFactoryUri sic@ */
    
    // @siclog "Step 2 - 7a" siclog@
    v_InviteRequestWithSdp := f_IMS_ConferenceCreation_AnnexC10C38_Steps2_9(p_TestProcedure, p_ConferenceFactoryUri, p_TemporaryConferenceUri, p_FinalConferenceUri);
    
    return v_InviteRequestWithSdp;
  }

  /* @desc      Test case body for 34.229-1 TC 15.19, 15.19a, G.15.18 and G.15.21
   *            Procedure for Inviting user to conference by sending a REFER request to the conference focus
   * @param     p_TestProcedure
   * @param     p_MediaTypeList
   * @status    APPROVED (IMS)
   */
  function f_IMS_InvitingUser_ByReferToFocus(IMS_TestProcedure_Type p_TestProcedure,
                                             CharStringList_Type p_MediaTypeList) runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (omit) SUBSCRIBE_Request v_SubscribeRequest := omit;
    var charstring v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);             // @sic R5-150745 sic@
    var charstring v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);           // @sic R5-150745 sic@
    var charstring v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);               // @sic R5-150745 sic@
    var IMS_CallType_Type v_CallType := CONFERENCE_CALL;  /* @sic R5-155179 sic@ */
    
    // C.10
    v_InviteRequestWithSdp := f_IMS_ConferenceCreation_AnnexC10C38_Steps1_9(p_TestProcedure, v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri);      // @sic R5-150745 sic@
    v_SubscribeRequest := f_IMS_Conferencing_OptionalSubscription(v_FinalConferenceUri);  /* @sic R5-150745 sic@ */

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 9" siclog@
    f_IMS_InviteUserToConference(v_FinalConferenceUri, v_SubscribeRequest, p_MediaTypeList);   /* @sic R5-211444: f_IMS_InviteUserToConference sic@ */
    
    // @siclog "Step 9a - 11" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, f_SIP_BuildSipUri_RX(v_FinalConferenceUri), v_CallType);  // @sic R5s141343 change 1.2 sic@

    // @siclog "Step 12 - 13" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);           /* @sic R5-176937 - new steps sic@ */

    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      Create session for three way conferencing
   * @param     p_TestProcedure
   * @param     p_CalleeUri
   * @param     p_CalleeContactUri
   * @param     p_RadioBearersEstablished
   * @return    ThreeWaySession_SessionInfo_Type
   * @status    APPROVED (IMS)
   */
  function fl_IMS_ThreeWaySession_CreateSession(IMS_TestProcedure_Type p_TestProcedure,
                                                charstring p_CalleeUri,
                                                charstring p_CalleeContactUri,
                                                boolean p_RadioBearersEstablished) runs on IMS_PTC return ThreeWaySession_SessionInfo_Type
  {
    var ThreeWaySession_SessionInfo_Type v_SessionInfo;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var boolean v_IsWLAN := f_IMS_PTC_RanTypeIsWLAN();
          
    v_SessionInfo.InviteRequestWithSdp := f_IMS_MOCallSetup_Step2(p_TestProcedure, p_CalleeUri);     // C.21/25/21a/25a Step 2

    if (v_IsWLAN) {
      v_ResponseWithSdp := f_IMS_MOCallSetup_AnnexC21aC25a_Steps3_8(p_TestProcedure, v_SessionInfo.InviteRequestWithSdp, p_CalleeContactUri, -, p_RadioBearersEstablished);  /* @sic R5s180220: p_CalleeContactUri sic@ */
      v_SessionInfo.MessageHeader_PrevResponse := v_ResponseWithSdp.Response.msgHeader;
      v_SessionInfo.LatestSdpOffer := v_SessionInfo.InviteRequestWithSdp.SdpOffer
    }
    else {
      select (p_TestProcedure) {
        case (IPCAN_MO_SpeechCall) {
          v_SessionInfo.MessageHeader_PrevResponse := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_SessionInfo.InviteRequestWithSdp, p_CalleeContactUri);                                   // C.21 Step 3, 4
          if (not p_RadioBearersEstablished) {
            f_IMS_CC_TriggerDedicatedBearerActivation(p_TestProcedure);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
          }
          v_SessionInfo.LatestSdpOffer := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_SessionInfo.InviteRequestWithSdp, v_SessionInfo.MessageHeader_PrevResponse, p_CalleeContactUri);   // C.21 Step 5 .. 13
        }
        case (IPCAN_MO_VideoCall) {
          v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_SessionInfo.InviteRequestWithSdp,  -, -, -, p_CalleeContactUri);                                   // C.25 Step 3, 4
          v_SessionInfo.MessageHeader_PrevResponse := v_ResponseWithSdp.Response.msgHeader;
          if (not p_RadioBearersEstablished) {
            f_IMS_CC_TriggerDedicatedBearerActivation(p_TestProcedure);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
          }
          v_SessionInfo.LatestSdpOffer := f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_SessionInfo.InviteRequestWithSdp, v_SessionInfo.MessageHeader_PrevResponse, p_CalleeContactUri);   // C.25 Step 5 .. 13
        }
      }
    }
    v_SessionInfo.ContactUrl := f_MessageHeader_GetContactSipUrl(v_SessionInfo.MessageHeader_PrevResponse);
    return v_SessionInfo;
  }

  /*
   * @desc      Three way session creation: Common function for TC_15_21a, TC_15_21c, TC_G_15_20, TC_G_15_23
   * @param     p_TestProcedure
   * @status    APPROVED (IMS)
   */
  function f_IMS_ThreeWaySession_Creation(IMS_TestProcedure_Type p_TestProcedure) runs on IMS_PTC
  {
    var charstring v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);             // @sic R5-150745 sic@
    var charstring v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);           // @sic R5-150745 sic@
    var charstring v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);               // @sic R5-150745 sic@
    
    var CharStringList_Type v_MediaTypeList := f_IMS_ConferenceEventPackage_MediaTypeList(p_TestProcedure);  // @sic R5-214877: different media for speech call (audio) and video call (speech, video) sic@

    var InviteUserToConference_StateInfo_Type v_Dialog1_StateInfo := valueof(cs_InviteUserToConference_StateInfo_Init(px_IMS_CalleeUri,  px_IMS_CalleeContactUri));
    var InviteUserToConference_StateInfo_Type v_Dialog2_StateInfo := valueof(cs_InviteUserToConference_StateInfo_Init(px_IMS_CalleeUri2, px_IMS_CalleeContactUri2));  // @sic R5s220523: px_IMS_CalleeContactUri2 instead of px_IMS_CalleeContactUri sic@

    var boolean v_RadioBearersEstablished := false;

    var template (omit) SUBSCRIBE_Request v_SubscribeRequest;      // optional SUBSCRIBE for conference event package

    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog1;
    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog2;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp_Dialog3;
    var SipUrl v_ContactUrl_UE;

    //--------------------------------------------
    // DIALOG 1
    //--------------------------------------------
    // Setup MO speech call
    f_IMS_CC_StartCall(p_TestProcedure, v_Dialog1_StateInfo.CalleeUri);                                     // C.21/25 Step 1
    
    v_SessionInfo_Dialog1 := fl_IMS_ThreeWaySession_CreateSession(p_TestProcedure, v_Dialog1_StateInfo.CalleeUri, v_Dialog1_StateInfo.CalleeContactUri, v_RadioBearersEstablished);
    v_RadioBearersEstablished := true;
    
    f_IMS_TestBody_Set(true);
    
    //Steps 1 to 4 - Messages in Annex C.8 - Set ongoing call on hold
    // @siclog "Step 1 - 4" siclog@
    f_UT_CallHold(MMI);
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog1.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog1.MessageHeader_PrevResponse, v_SessionInfo_Dialog1.LatestSdpOffer, v_Dialog1_StateInfo.CalleeContactUri);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
 
    //--------------------------------------------
    // DIALOG 2
    //--------------------------------------------
    
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");      // @sic R5-220212 sic@
    
    // @siclog "Step 5" siclog@    Step 1 of C.21
    select (p_TestProcedure) {                            // @sic R5s180053: AT command trigger added to start second call after holding 1st call sic@
      case (IPCAN_MO_SpeechCall) {
        f_UT_RequestIMSCall(MMI, v_Dialog2_StateInfo.CalleeUri);
      }
      case (IPCAN_MO_VideoCall) {
        f_UT_RequestIMSVideoCall(MMI, v_Dialog2_StateInfo.CalleeUri);
      }
    }

    // @siclog "Step 6 - 17" siclog@    Steps defined in Annex C.21 - MO call
    v_SessionInfo_Dialog2 := fl_IMS_ThreeWaySession_CreateSession(p_TestProcedure, v_Dialog2_StateInfo.CalleeUri, v_Dialog2_StateInfo.CalleeContactUri, v_RadioBearersEstablished);

    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
    
    // @siclog "Step 17A" siclog@
    f_UT_CallMPTY(MMI);  // There is no IPCAN signalling involved => f_IMS_CC_StartCall shall not be used
    // @siclog "Step 17B - 17E" siclog@
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog2.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog2.MessageHeader_PrevResponse, v_SessionInfo_Dialog2.LatestSdpOffer, v_Dialog2_StateInfo.CalleeContactUri);
    
    //--------------------------------------------
    // DIALOG 3
    //--------------------------------------------
    
    f_IMS_PTC_ImsInfo_ActivateDialog(thirdDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111113");      // @sic R5-220212 sic@
    
    // @siclog "Step 18 - 30" siclog@   Steps defined in Annex C.10
    v_InviteRequestWithSdp_Dialog3 := f_IMS_ConferenceCreation_AnnexC10C38_Steps2_9(p_TestProcedure, v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri, v_RadioBearersEstablished);
    v_ContactUrl_UE := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp_Dialog3.Invite.msgHeader);
    
    //--------------------------------------------
    // Subscribe to conference event package (A.19 steps 10 - 13), invite user A/B (A.20), terminate dialog 1/2
    //--------------------------------------------
    
    // @siclog "Step 27 - 46D" siclog@
    v_SubscribeRequest := f_IMS_ThreeWaySession_SubscribeInvite(v_SessionInfo_Dialog1, v_SessionInfo_Dialog2, v_Dialog1_StateInfo, v_Dialog2_StateInfo, v_FinalConferenceUri, v_MediaTypeList);  /* @sic R5-213528: f_IMS_ThreeWaySession_SubscribeInvite sic@
                                                                                                                                                                                                    @sic R5-214877: v_MediaTypeList sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "");
    
    //--------------------------------------------
    // Release session
    //--------------------------------------------
    
    // @siclog "Step 47 - 48" siclog@   Terminate conference
    f_IMS_CallReleaseMT(v_ContactUrl_UE);

    //--------------------------------------------
    // Unsubscribe
    //--------------------------------------------

    // @siclog "Step 49 - 50" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);           /* @sic R5-176937 - new steps sic@ */

    f_IMS_TestBody_Set(false);
  }

}
