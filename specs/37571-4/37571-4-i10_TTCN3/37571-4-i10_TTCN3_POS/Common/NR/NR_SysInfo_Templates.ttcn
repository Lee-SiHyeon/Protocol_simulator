module NR_SysInfo_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_CommonDefs all;
  import from NR_FrequencyCommon all;
  import from NR_FrequencyInit_SA all;
  import from NR_RRC_Templates all;

  template (value) BCCH_BCH_Message cs_38508_MIB_Def(MIB.subCarrierSpacingCommon p_SubCarrierSpacingCommon,
                                                     MIB.ssb_SubcarrierOffset    p_LSB_Kssb,
                                                     ControlResourceSetZero      p_ControlResourceSetZero,
                                                     SearchSpaceZero             p_SearchSpaceZero := 0) :=
  { /* Acc to 38.508-1 Table 4.6.1-6: MIB */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      mib := {
        systemFrameNumber := int2bit(0, 6),  /* Defines the The 6 most significant bit (MSB) of the 10 bit System Frame Number
                                                This value shall be fulfilled by SS */
        subCarrierSpacingCommon := p_SubCarrierSpacingCommon,
        ssb_SubcarrierOffset    := p_LSB_Kssb,
        dmrs_TypeA_Position     := pos2,
        pdcch_ConfigSIB1 := {          // @sic BASELINE MOVING OCT 2018 sic@
          // Table 4.6.3-73A: PDCCH-ConfigSIB1
          controlResourceSetZero    := p_ControlResourceSetZero,
          searchSpaceZero           := p_SearchSpaceZero
        },
        cellBarred              := notBarred,
        intraFreqReselection    := allowed,
        spare                   := '0'B
      }
    }
  };

  template (value) SI_SchedulingInfo cs_NR_SI_SchedulingInfoDef(template (value) SI_SchedulingInfo.schedulingInfoList p_SI_SchedulingInfo,
                                                                SI_SchedulingInfo.si_WindowLength p_SI_WindowLength):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    schedulingInfoList      := p_SI_SchedulingInfo,
    si_WindowLength         := p_SI_WindowLength,
    si_RequestConfig        := omit,
    si_RequestConfigSUL     := omit,
    systemInformationAreaID := '000000000000000000000001'B
  };

  template (value)  SI_SchedulingInfo.schedulingInfoList cs_NR_SI_SchedulingInfo_List1(template (value) SchedulingInfo p_SchedulingInfo1) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    p_SchedulingInfo1
  };

  template (value)  SI_SchedulingInfo.schedulingInfoList cs_NR_SI_SchedulingInfo_List2(template (value) SchedulingInfo p_SchedulingInfo1,
                                                                                       template (value) SchedulingInfo p_SchedulingInfo2):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    p_SchedulingInfo1,
    p_SchedulingInfo2
  };

  template (value)  SI_SchedulingInfo.schedulingInfoList cs_NR_SI_SchedulingInfo_List3(template (value) SchedulingInfo p_SchedulingInfo1,
                                                                                       template (value) SchedulingInfo p_SchedulingInfo2,
                                                                                       template (value) SchedulingInfo p_SchedulingInfo3):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    p_SchedulingInfo1,
    p_SchedulingInfo2,
    p_SchedulingInfo3
  };

  template (value) SchedulingInfo cs_NR_SchedulingInfoDef(SchedulingInfo.si_Periodicity p_SI_Periodicity,
                                                          template (value) SIB_Mapping p_SIB_Mapping,
                                                          SchedulingInfo.si_BroadcastStatus p_SiBroadcastStatus := broadcasting
                                                          ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    si_BroadcastStatus := p_SiBroadcastStatus,
    si_Periodicity     := p_SI_Periodicity,  // {rf8, rf16, rf32, rf64, rf128, rf256, rf512}
    sib_MappingInfo    := p_SIB_Mapping
  };

  template (value) SIB_TypeInfo cs_NR_SIB_TypeInfoDef(SIB_TypeInfo.type_ p_Type,
                                                      integer p_ValueTag := 0) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    type_       := p_Type,
    valueTag    := p_ValueTag,
    areaScope   := omit
  };

  template (value) BCCH_DL_SCH_Message cs_NR_BCCH_DL_SCH_SIB1(template (value) SIB1 p_SIB1) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        systemInformationBlockType1 := p_SIB1
      }
    }
  };

  template (value) BCCH_DL_SCH_Message cs_NR_BCCH_DL_SCH_SIB(template (value) SystemInformation p_SI) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        systemInformation := p_SI
      }
    }
  };

  template (value) SystemInformation cs_NR_SI(template (value) SystemInformation_IEs p_SystemInformation_IEs):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    criticalExtensions := {
      systemInformation := p_SystemInformation_IEs  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
    }
  };

