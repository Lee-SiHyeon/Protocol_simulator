  template (value) SI_SchedulingInfo_v1700 cs_SI_SchedulingInfo_v1700_Def( template (value) SI_SchedulingInfo_v1700.schedulingInfoList2_r17 p_SchedulingInfoList2
                                                                         )  :=
  {/* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    schedulingInfoList2_r17     := p_SchedulingInfoList2,
    dummy := omit  /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
  };

  template (value) SchedulingInfo2_r17 cs_SchedulingInfo2_r17( SchedulingInfo2_r17.si_WindowPosition_r17 p_Si_WindowPosition,
                                                              SchedulingInfo2_r17.si_Periodicity_r17    p_Si_Periodicity_r17,
                                                              template (value) SIB_Mapping_v1700         p_SIB_Mapping_v1700
                                                             ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // As per 38.508-1 Table 4.6.3-173AA: SI-SchedulingInfo-v1700
    si_BroadcastStatus_r17 := broadcasting,
    si_WindowPosition_r17  := p_Si_WindowPosition,
    si_Periodicity_r17     := p_Si_Periodicity_r17,
    sib_MappingInfo_r17    := p_SIB_Mapping_v1700
  };

