module PS_Data_OFF_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from IMS_PTC_CoordMsg all;
  import from NAS_5GC_Parameters all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_IMSProcedures all;
  import from NR5GC_NASSteps all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_1_NR5GC() runs on NR5GC_PTC
  {
    //Data Off / MO Voice Call
    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    //Preamble
    //The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    
    f_NR_TestBody_Set(true);
    
    //Main test body
    fl_TC_11_6_1_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_11_6_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_11_6_1_Body() runs on NR5GC_PTC
  {
    var template (omit) GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    //Main test body
    fl_TC_11_6_x_Body();
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 8 - 12");
    v_GSM_MobilityInfo:= f_Get_PDUSessionForDNNType(f_NR5GC_MobileInfo_GetSessionInfoList(), IMS_DNN);
    //@siclog "Steps 13-15" siclog@
    f_NR5GC_ModifyPDUSession_AddVoice(nr_Cell1, valueof(v_GSM_MobilityInfo)); // @sic R5-223441 R5s220718 sic@

    //Receive coord from IMS PTC that call is setup
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    
    //Now release the call
    f_NR5GC_CallRelease(nr_Cell1, IPCAN_SpeechCall);

    //Removed wait for Trigger  @sic R5s220828 sic@

  } //End of test body of TC_11_6_1

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_2_NR5GC() runs on NR5GC_PTC
  {
    //Data Off / MO Video Call
    //var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    //Preamble
    //The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    
    //Main test body
    fl_TC_11_6_x_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_3_NR5GC() runs on NR5GC_PTC
  {//Data Off / SMSoIP
  
    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    //Preamble
    //The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    
    f_NR_TestBody_Set(true);
    //Main test body
    fl_TC_11_6_x_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_11_6_x
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_11_6_x_Body() runs on NR5GC_PTC
  {
    var PDUSessionInfoList_Type v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList(); //How many PDU sessions are established ?
    var O1_Type v_PDUSessionIdToModify := v_PDUSessionInfo[0].SessionId;
    var O1_Type v_PDUSessionIdToRelease;
    var GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    var template (omit) GSM_MobilityInfo_Type v_GSM_MobilityInfo_IMS_DNN := f_Get_PDUSessionForDNNType(f_NR5GC_MobileInfo_GetSessionInfoList(), IMS_DNN);
    //Prose CR needed var boolean v_PrcocessedAllReleaseReq := false;
    var boolean v_PDUSessionInternetReleased := false;
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB2;
    var template (value) NG_NAS_DL_Pdu_Type v_MsgToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (omit) ExtdProtocolConfigOptions v_Pco := omit;
    var NAS_ProtocolConfigOptions_Type v_ProtocolConfigOptions;
    var integer i := 0;
    var integer v_NumOfPDUSessionModReqsRcvd := 1;
    timer t_Wait := 1.0;

    //@siclog "Steps 1" siclog@
    //AT command to activate Data Off
    f_UT_TriggerPS_DataOff(UT, true);
      
    //EXCEPTION: Step 2 is repeated (pc_noOf_PDUsSameConnection + pc_noOf_PDUsNewConnection) times
    // @sic R5-261239 sic@
    //@siclog "Steps 2" siclog@
    // The UE transmits a PDU SESSION MODIFICATION REQ
    //This is to capture all PDU Session Modification Requests in case of MultiPDU or Single PDU
    f_NR5GC_MsgInDefault_ResetStoreOfNASMessageReq();
    for(i := 0;i < (pc_noOf_PDUsNewConnection + pc_noOf_PDUsSameConnection); i := i +1) {
        SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
        f_NR5GC_MsgInDefault_StoreNASMessageReq (v_ReceivedAsp);
        v_Pco := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.extdProtocolConfigurationOptions;
       //Check if the UE has set the Data Off status to activated
        if (f_ExtdProtocolConfigOptions_CheckPSDataOff(v_Pco,'02'O)) // @sic R5s220828 sic@
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
        }else{
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
        }
        
    }
   
    /*Some UEs could transmit a PDU Session Release REQ for Internet PDU session because once the PS data is off, there is no point in
     maintaining this PDU session as there are no services that exempt from PS data OFF.
     This is handled below.
    */
    //EXCEPTION: Steps 2A to 2Bb1 shall be repeated until timer T1 expires.
    //@siclog "Steps 2A" siclog@
    // @sic R5-261239 sic@
    //Prose CR neededwhile (not v_PrcocessedAllReleaseReq) {
        t_Wait.start;
        //EXCEPTION: Steps 2Ba1-2Bb1 describe behaviour depending on UE implementation
        // @sic R5-261239 sic@
        alt {
        //@siclog "Steps 2Ba1" siclog@
        //The UE transmits a PDU SESSION RELEASE REQUEST message for non-IMS PDU Session (NOTE 2).
          [] SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp
          {
           //@siclog "Steps 2Ba2" siclog@
            t_Wait.stop;
            if ( match(v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Release_Request.pduSessionId.sessionId,v_GSM_MobilityInfo_IMS_DNN.SessionId)) {
               f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE released IMS PDU session");
            } else {
               //@siclog "Steps 2Ba3" siclog@
               //Store the PDU session ID for which a PDU Session Release REQ is received.
               v_PDUSessionIdToRelease := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Release_Request.pduSessionId.sessionId;
               //Now release the PDU session for which the PDU Session Release REQ is received
               f_NR5GC_PDUSessionRelease (nr_Cell1,
                                       v_PDUSessionIdToRelease,
                                       cs_GMM_GSM_Cause (omit, '00100100'B));
               v_PDUSessionInternetReleased := true;
     
            }
          }
          //@siclog "Steps 2Bb1" siclog@
          [] t_Wait.timeout
          {
              //Prose CR needed v_PrcocessedAllReleaseReq := true;
          }
        }
    //Prose CR needed}
      
    //EXCEPTION: Steps 2Ca1-2Ca2 are repeated for each active non-IMS PDU session (if any)
    v_NumOfPDUSessionModReqsRcvd := f_NR5GC_MsgInDefault_GetNumOfNASMessageReq();
    i:=0;
    while(i < v_NumOfPDUSessionModReqsRcvd) {
        v_ReceivedAsp := f_NR5GC_MsgInDefault_GetOneNASMessageReq(1);
        if (not match(v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.pduSessionId.sessionId,v_GSM_MobilityInfo_IMS_DNN.SessionId)
                and not(v_PDUSessionInternetReleased) ) {
                //This is the case when Modification REQ for Internet PDU Session is received, and the UE has not transmitted PDU session Release REQ for Internet PDU Session
                v_PDUSessionIdToModify := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.pduSessionId.sessionId;
                if (not f_Check_NG_PDUSessionModificationReq (v_GSM_MobilityInfo, v_PDUSessionInfo,
                                                 v_ReceivedAsp.Signalling.Nas[0].Pdu,v_PDUSessionIdToModify)) {
                      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Incorrect PDU Session ID");
                 }

                v_Pco := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.extdProtocolConfigurationOptions;
                
                if (isvalue(v_Pco.pco)) {
                v_ProtocolConfigOptions := valueof(v_Pco.pco);
                 for (i := 0; i < lengthof(v_ProtocolConfigOptions); i := i + 1) {
                   if (v_ProtocolConfigOptions[i].protocolID == '0017'O) {
                      v_Pco.pco[i].protocolLength :='00'O;
                      v_Pco.pco[i].content := omit;
                   }
                 }
               }
            
                //@siclog "Steps 2Ca1" siclog@
                //Send PDU Session Modification Command
                v_MsgToSend := f_Get_NG_PDUSessionModificationCommand (v_PDUSessionIdToModify, v_GSM_MobilityInfo);
                v_MsgToSend.PiggybackedPduList[0].Msg.pdu_Session_Modification_Command.extdProtocolConfigurationOptions := v_Pco;
                SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1, -, -, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
                
            
                //@siclog "Steps 2Ca2" siclog@
                //receive PDU Session Modification Complete
                SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
                if (not f_Check_NG_PDUSessionModificationComplete (v_ReceivedAsp.Signalling.Nas[0].Pdu, v_PDUSessionIdToModify)) {
                  f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Wrong PDU Session Modification");
                }
                f_NR5GC_MsgInDefault_RemoveOneNASMessageReq(); //The Modification REQ for Internet PDU session is now done so remove it from stored NAS messaged.
        }
        i := i + 1;
    }
    
    v_ReceivedAsp := f_NR5GC_MsgInDefault_GetOneNASMessageReq(1); //Now only the Modification REQ for IMS is pending
    v_PDUSessionIdToModify := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.pduSessionId.sessionId;
    if (not f_Check_NG_PDUSessionModificationReq (v_GSM_MobilityInfo, v_PDUSessionInfo,
                                        v_ReceivedAsp.Signalling.Nas[0].Pdu,v_PDUSessionIdToModify)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Incorrect PDU Session ID");
        }
    v_Pco := v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Modification_Request.extdProtocolConfigurationOptions;
    
    if (isvalue(v_Pco.pco)) {
        v_ProtocolConfigOptions := valueof(v_Pco.pco);
        for (i := 0; i < lengthof(v_ProtocolConfigOptions); i := i + 1) {
        if (v_ProtocolConfigOptions[i].protocolID == '0017'O) {
            v_Pco.pco[i].protocolLength :='00'O;
            v_Pco.pco[i].content := omit;
        }
        }
    }

    //@siclog "Steps 3" siclog@
    //Send PDU Session Modification Command
    v_MsgToSend := f_Get_NG_PDUSessionModificationCommand (v_PDUSessionIdToModify, v_GSM_MobilityInfo);
    v_MsgToSend.PiggybackedPduList[0].Msg.pdu_Session_Modification_Command.extdProtocolConfigurationOptions := v_Pco;
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1, -, -, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    

    //@siclog "Steps 4" siclog@
    //receive PDU Session Modification Complete
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not f_Check_NG_PDUSessionModificationComplete (v_ReceivedAsp.Signalling.Nas[0].Pdu, v_PDUSessionIdToModify)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4");
    }
    
    //Postamble after receiving coordination from IMS PTC
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

  } //End of test body of TC_11_6_x

}
