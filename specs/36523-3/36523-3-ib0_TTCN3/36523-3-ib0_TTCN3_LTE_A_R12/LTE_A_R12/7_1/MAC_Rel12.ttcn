  function f_TC_7_1_7_1_11_EUTRA() runs on EUTRA_PTC
  { /* DL-SCH transport block size selection / DCI format 2A / RA type 0 / Two transport blocks enabled /
     * Transport block to codeword swap flag value set to '0' / 256QAM */
    f_EUTRA_7_1_7_1_x_MIMO_256QAM(dci_2A, ra_0,'0'B);
