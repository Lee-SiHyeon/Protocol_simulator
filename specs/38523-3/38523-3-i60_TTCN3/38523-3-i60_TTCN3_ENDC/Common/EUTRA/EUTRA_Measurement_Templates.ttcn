      reportConfigId := p_ReportConfigId,
      reportConfig   := p_ReportConfig
    }
  };

  template (value) ReportConfigToAddMod_ReportConfig_Type cs_ReportConfig_reportConfigInterRAT(template (value) ReportConfigInterRAT_Trigger_Type p_Trigger,
                                                                                               integer p_MaxReportCells,
                                                                                               ReportInterval p_ReportInterval,
                                                                                               ReportConfigInterRAT.reportAmount p_ReportAmount,
                                                                                               template (omit) ReportConfigInterRAT.si_RequestForHO_r9 p_Si_RequestForHO_r9 := omit,
                                                                                               template (omit) boolean p_IncludeLocationInfo_r11 := omit,
                                                                                               template (omit) ReportQuantityNR_r15 p_ReportQuantityCellNR_r15 := omit,
                                                                                               template (omit) CondReconfigurationTriggerNR_r17 p_CondReconfigurationTriggerNR_r17 := omit
                                                                                               ) := //@sic R5-190673, R5s190019 sic@
  { /* @status    APPROVED (ENDC, LTE_A_IRAT, LTE_IRAT) */
    reportConfigInterRAT := {
      triggerType := p_Trigger,
      maxReportCells := p_MaxReportCells,
      reportInterval := p_ReportInterval,
      reportAmount := p_ReportAmount,
      si_RequestForHO_r9 := p_Si_RequestForHO_r9,             /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reportQuantityUTRA_FDD_r10 := omit,                     /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
      includeLocationInfo_r11 := p_IncludeLocationInfo_r11,   /* @sic R5s130195 BASELINE MOVING 2013, R5s150730 sic@ */
      b2_Threshold1_v1250 := omit,                            /* @sic BASELINE MOVING 2015 sic@ */
      reportQuantityWLAN_r13 := omit,                         /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      reportAnyWLAN_r14 := omit,                              /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      reportQuantityCellNR_r15 := p_ReportQuantityCellNR_r15, //@sic R5-190673, R5s190019 sic@ /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      maxReportRS_Index_r15 := omit,                          /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportQuantityRS_IndexNR_r15 := omit,                   /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportRS_IndexResultsNR := omit,                        /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportSFTD_Meas_r15 := omit,                            /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      useAutonomousGapsNR_r16 := omit,                        /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      measRSSI_ReportConfigNR_r16 := omit,                    /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      condReconfigurationTriggerNR_r17 := p_CondReconfigurationTriggerNR_r17  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
    }
  };

    template (value) ReportConfigToAddMod_ReportConfig_Type cs_ReportConfig_reportConfigInterRAT_Sftd(template (value) ReportConfigInterRAT_Trigger_Type p_Trigger,
                                                                                                      integer p_MaxReportCells,
                                                                                                      ReportInterval p_ReportInterval,
                                                                                                      ReportConfigInterRAT.reportAmount p_ReportAmount,
                                                                                                      template (omit) ReportConfigInterRAT.si_RequestForHO_r9 p_Si_RequestForHO_r9 := omit,
                                                                                                      template (omit) boolean p_IncludeLocationInfo_r11 := omit,
                                                                                                      template (omit) ReportQuantityNR_r15 p_ReportQuantityCellNR_r15 := omit,
                                                                                                      ReportConfigInterRAT.reportSFTD_Meas_r15 p_Report_Sftd_Meas_r15) := //@sic R5-190673, R5s190019 sic@
  { /* @status    APPROVED (ENDC) */
    //@sic R5-202695 sic@
    reportConfigInterRAT := {
      triggerType := p_Trigger,
      maxReportCells := p_MaxReportCells,
      reportInterval := p_ReportInterval,
      reportAmount := p_ReportAmount,
      si_RequestForHO_r9 := p_Si_RequestForHO_r9,             /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reportQuantityUTRA_FDD_r10 := omit,                     /* @sic R5s120178 BASELINE MOVING 2012 sic@ */
      includeLocationInfo_r11 := p_IncludeLocationInfo_r11,   /* @sic R5s130195 BASELINE MOVING 2013, R5s150730 sic@ */
      b2_Threshold1_v1250 := omit,                            /* @sic BASELINE MOVING 2015 sic@ */
      reportQuantityWLAN_r13 := omit,                         /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      reportAnyWLAN_r14 := omit,                              /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      reportQuantityCellNR_r15 := p_ReportQuantityCellNR_r15, //@sic R5-190673, R5s190019 sic@ /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      maxReportRS_Index_r15 := omit,                          /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportQuantityRS_IndexNR_r15 := omit,                   /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportRS_IndexResultsNR := omit,                        /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      reportSFTD_Meas_r15 := p_Report_Sftd_Meas_r15,          /* @sic R5-202695, R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
      useAutonomousGapsNR_r16 := omit,                        /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      measRSSI_ReportConfigNR_r16 := omit,                    /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      condReconfigurationTriggerNR_r17 := omit                /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
    }
  };

  template (value) ReportQuantityNR_r15 cs_ReportQuantityNR_r15(boolean p_Ss_Rsrp,
                                                                boolean p_Ss_Rsrq,
                                                                boolean p_Ss_Sinr) :=
  { //@sic R5-190673, R5s190019 sic@
    /* @status    APPROVED (ENDC) */
    ss_rsrp := p_Ss_Rsrp,
    ss_rsrq := p_Ss_Rsrq,
    ss_sinr := p_Ss_Sinr
  };

  template (value) ReportConfigInterRAT_Trigger_Type cs_ReportConfigInterRAT_Trigger_B1_NR(RSRP_RangeNR_r15 p_NR_RSRP_Thres) :=
  { /* @status    APPROVED (ENDC) */
    event := {
      eventId := {
        eventB1_NR_r15 := {
          b1_ThresholdNR_r15 := {
            nr_RSRP_r15 := p_NR_RSRP_Thres
          },
          reportOnLeave_r15 := false
        }
      },
      hysteresis := 0,
      timeToTrigger := ms0
    }
  };

  template (value) ReportConfigInterRAT_Trigger_Type cs_ReportConfigInterRAT_Trigger_periodical(ReportConfigInterRAT.triggerType.periodical.purpose p_Purpose) :=
  { /* @status    APPROVED (ENDC, LTE_IRAT) */
    periodical := {
      purpose := p_Purpose //enumerated{ reportStrongestCells, reportStrongestCellsForSON, reportCGI }
    }
  };

  template (value) ReportConfigToAddMod_ReportConfig_Type cs_508_ReportConfig_reportConfigInterRAT_Sftd(ReportConfigInterRAT.triggerType.periodical.purpose p_Purpose := reportStrongestCells,
                                                                                                        integer p_MaxReportCells := 1,
                                                                                                        ReportInterval p_ReportInterval := ms1024,
                                                                                                        ReportConfigInterRAT.reportAmount p_ReportAmount := r1,
                                                                                                        template (omit) ReportConfigInterRAT.si_RequestForHO_r9 p_Si_RequestForHO_r9 := omit,
                                                                                                        ReportConfigInterRAT.reportSFTD_Meas_r15 p_Report_Sftd_Meas_r15) :=
  /* @status    APPROVED (ENDC) */
  //@sic R5-202695 sic@
    cs_ReportConfig_reportConfigInterRAT_Sftd(cs_ReportConfigInterRAT_Trigger_periodical(p_Purpose),
                                              p_MaxReportCells,
                                              p_ReportInterval,
                                              p_ReportAmount,
                                              p_Si_RequestForHO_r9,
                                              omit,
                                              omit,
                                              p_Report_Sftd_Meas_r15);

  template (value) MeasIdToRemoveList cs_MeasIdToRemoveList_1Entry(MeasId p_MeasId) :=
