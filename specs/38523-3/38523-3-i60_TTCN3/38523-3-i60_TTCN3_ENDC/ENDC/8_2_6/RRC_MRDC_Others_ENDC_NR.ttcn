module RRC_MRDC_Others_ENDC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_NR_CoordMsg all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit_ENDC all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_ENDC all;
  import from NR_Component_Base all;
  import from NR_Component_ENDC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.6.2.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_6_2_1_ENDC_NR() runs on ENDC_NR_PTC
  { // Processing delay / PSCell addition / SCG DRB / Success / Latency check / EN-DC
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);

    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);// @sic R5s210735 sic@

    f_NR_TestBody_Set(true);
    fl_TC_8_2_6_2_1_ENDC_NR_TestBody ();
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_6_2_1_ENDC_NR
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_6_2_1_ENDC_NR_TestBody() runs on NR_BASE_PTC
  { //
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) FreqBandList v_MRDC_FreqList;// @sic R5s200666 sic@
    var octetstring v_OctetData;// @sic R5s200666 sic@
    var integer v_EUTRABandInd;// @sic R5s200666 sic@
    var integer v_NRBandInd;// @sic R5s200666 sic@

    f_NR_SS_CommonRadioBearerConfig(nr_Cell1, {f_NR_GetRadioBearerConfig_FullAM_DRB2(nr_Cell1)});
    v_RadioBearerConfig := cs_NR_RadioBearer(tsc_NR_DRB2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get());

    v_SCGConfig := f_NR_GetSCGConfigDef(nr_Cell1);

    // Get Security info from EUTRA, calculate latest keys and configure SS
    f_ENDC_GetKeysActivateSecurity(nr_Cell1, EUTRA);

    // Now send octetstrings to EUTRA
    f_NR_SendRRCReconfigurationContentsToEUTRA (v_RadioBearerConfig, v_SCGConfig, -, -, -, reconfigurationWithSync_CheckRACH);

    // @sic R5s200666 sic@
    v_OctetData := f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "EUTRA Band");
    v_EUTRABandInd := oct2int(v_OctetData);
    v_NRBandInd := f_NR_CellInfo_GetBandIndicator(nr_Cell1);
    // Then send both bands under test back to EUTRA
    v_MRDC_FreqList := cs_NR_MRDC_FreqList(v_EUTRABandInd, v_NRBandInd);
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_OctetData (bit2oct(encvalue(v_MRDC_FreqList)), "MRDC_Freq"));
  }

}
