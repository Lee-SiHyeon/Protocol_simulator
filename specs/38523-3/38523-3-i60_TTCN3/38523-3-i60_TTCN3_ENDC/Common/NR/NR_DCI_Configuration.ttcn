      TransformPrecoderIndicator := omit,   /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      FirstDAI := omit,
      SecondDAI := omit,
      ThirdDAI := omit,                     // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      SecondTpcCommandPusch := omit,        // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      SrsResourceSetIndicator := omit,      // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      SrsResourceIndicator := omit,
      SecondSrsResourceIndicator := omit,   // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      PrecodingInfo := omit,
      SecondPrecodingInfo := omit,          // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      AntennaPorts := omit,
      SrsRequest := omit,
      SrsOffsetIndicator := omit,           // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      CsiRequest := omit,
      CBGTI := omit,
      PtrsDmrsAssociation := omit,
      SecondPtrsDmrsAssociation := omit,    // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
      BetaOffsetIndicator := omit,
      DmrsSequenceInit := omit,
      UlschIndicator := omit,
      ChannelAccessCPextCAPC := omit,
      OpenLoopPowerControl := omit,
      PriorityIndicator := omit,
      InvalidSymbolPatternIndicator := omit,
      MinimumApplicableSchedulingOffset := omit,
      SCellDormancyIndication := omit,
      SidelinkAssignmentIndex := omit,
      PdcchMonitoringAdaptationIndication := omit   // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
    }
  };

  template (value) NR_DciFormat_0_X_ResourceAssignment_Type cs_NR_DciFormat_0_X_ResourceAssignment(template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := omit,
                                                                                                   template (omit) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul := omit,
                                                                                                   template (omit) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment := omit,
                                                                                                   template (omit) NR_TransportBlockRetransmissionList_Type p_TransportBlockRetransmissionList := omit,
                                                                                                   template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ResourceAllocationType := p_ResourceAllocationType,
    FreqDomain := p_FreqDomainSchedul,
    TimeDomain := p_TimeDomainResourceAssignment,
    TransportBlockScheduling := p_TransportBlockRetransmissionList,
    HarqProcessConfig := p_HarqProcessConfig
  };

 /*
  * @desc  Return the grant provided as parameter if any otherwise return the default grant depending on the ChannelBandwidth
   * @param     p_ChannelBandwidth
   * @param     p_FreqDomainSchedul
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetreiveDefault_FreqDomainSchedul(integer  p_ChannelBandwidth,
                                                  template (omit) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul
                                                  ) return template (value) NR_FreqDomainSchedulExplicit_Type
  { //@sic R5-250309 CBW3 sic@
    if (isvalue(p_FreqDomainSchedul)) {
      return p_FreqDomainSchedul;  // compiler warning may be ignored due to check
    } else {
      return f_NR_GetDefault_FreqDomainSchedul(p_ChannelBandwidth);
    }
  }

  /*
   * @desc  Return the default grant depending on the ChannelBandwidth - acc to 38.523-3 Table 7.1.2.3.3-1: Default grants
   * @param     p_ChannelBandwidth
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetDefault_FreqDomainSchedul (integer p_ChannelBandwidth) return template (value) NR_FreqDomainSchedulExplicit_Type
  {//@sic R5-250309 CBW3 sic@
    if (p_ChannelBandwidth == 3) {
      return cs_NR_FreqDomainSchedulExplicit(-, tsc_NR_DefaultGrant_Lrbs_CBW3);  //15 RBs
    } else {
      return cs_NR_FreqDomainSchedulExplicit(-, tsc_NR_DefaultGrant_Lrbs);       //24RBs
    }
  }

  /*
   * @desc      Initialisation of DCI for scheduling of UL transmissions depending on configuration of search space and BWP
   * @param     p_PhysicalParameters
   * @param     p_DciFormatAndParams
   * @param     p_ImcsValue
   * @param     p_FreqDomainSchedul
   * @return    template (value) NR_DciUlInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_DciUlInfo_Init(NR_PhysicalParameters_Type p_PhysicalParameters,
                                template (value) NR_DciFormat_0_X_SpecificInfo_Type p_DciFormatAndParams,
                                template (value) NR_ImcsValue_Type p_ImcsValue,
                                template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul) return template (value) NR_DciUlInfo_Type
  {
    var NR_UplinkBWP_Type v_UplinkBWP := p_PhysicalParameters.UL_BWPs[0];
    var template (omit) PUSCH_TimeDomainResourceAllocationList v_TimeDomainResourceAllocationList := omit;
    var NR_ResourceAllocationType_Type v_ResourceAllocationType := resourceAllocationType1;
    var integer v_TimeDomainResourceAssignmentTableSize := 16;        /* => 4 bits per default as for DCI format 0_1 */
    var integer v_TimeDomainResourceAssignmentIndexValue := 0;
    var template (value) NR_DciCommon_TimeDomainResourceAssignment_Type v_TimeDomainResourceAssignment;
    var template (value) NR_DciFormat_0_X_PuschHoppingCtrl_Type v_PuschHoppingCtrl;
    var boolean v_IsDciFormat_0_1 := ischosen(p_DciFormatAndParams.Format_0_1);


    if (v_IsDciFormat_0_1) {
      // resource allocation type for DCI format 0_1:
      if (match(resourceAllocationType0, v_UplinkBWP.Dedicated.R15.pusch_Config.setup.resourceAllocation)) {  // acc. 38.214 clause 6.1.2.2: allocation type 0 is applicable for DCI format 0_1 only
        v_ResourceAllocationType := resourceAllocationType0;
      }

      // size of pusch_TimeDomainAllocationList for DCI format 0_1:
      if (ischosen(v_UplinkBWP.Dedicated.R15.pusch_Config.setup.pusch_TimeDomainAllocationList.setup)) {
        v_TimeDomainResourceAllocationList := v_UplinkBWP.Dedicated.R15.pusch_Config.setup.pusch_TimeDomainAllocationList.setup;
      } else {
        v_TimeDomainResourceAllocationList := v_UplinkBWP.Common.R15.pusch_ConfigCommon.setup.pusch_TimeDomainAllocationList;  /* NOTE: pusch-TimeDomainAllocationList may be not present in PUSCH-ConfigCommon */
      }
      if (isvalue(v_TimeDomainResourceAllocationList)) {
        v_TimeDomainResourceAssignmentTableSize := lengthof(v_TimeDomainResourceAllocationList);
      } else {
        v_TimeDomainResourceAssignmentTableSize := 16;                          /* Default PUSCH time domain resource allocation (38.214 Table 6.1.2.1.1-2/3) */
      }
      v_PuschHoppingCtrl := cs_NR_DciFormat_0_X_PuschHoppingCtrl_None;          /* acc. to 38.508-1 Table 4.3.6.1.1.2-1) */
    }
    else {
      v_PuschHoppingCtrl := cs_NR_DciFormat_0_X_PuschHoppingCtrl_Flag('0'B);    /* acc. to 38.508-1 Table 4.3.6.1.1.1-1) */
    }

    v_TimeDomainResourceAssignment := fl_NR_DciCommon_TimeDomainResourceAssignment(v_TimeDomainResourceAssignmentTableSize, v_TimeDomainResourceAssignmentIndexValue);

    return cs_NR_DciUlInfo_Init(v_ResourceAllocationType,
                                p_ImcsValue,
                                p_FreqDomainSchedul,
                                v_TimeDomainResourceAssignment,
                                v_PuschHoppingCtrl,
                                p_DciFormatAndParams);
  }

  template (value) NR_DciUlInfo_Type cs_NR_DciUlInfo_Init(NR_ResourceAllocationType_Type p_ResourceAllocationType,
                                                          template (value) NR_ImcsValue_Type p_ImcsValue,
                                                          template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul,
                                                          template (value) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment,
                                                          template (value) NR_DciFormat_0_X_PuschHoppingCtrl_Type p_PuschHoppingCtrl,
                                                          template (value) NR_DciFormat_0_X_SpecificInfo_Type p_DciFormatAndParams) :=
  { /* local template for initialisation of the DCI */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ResoureAssignment := cs_NR_DciFormat_0_X_ResourceAssignment(p_ResourceAllocationType,
                                                                p_FreqDomainSchedul,
                                                                p_TimeDomainResourceAssignment,
                                                                cs_NR_TransportBlockRetransmissionList_Def(p_ImcsValue),
                                                                cs_NR_HarqProcessConfig_AnyProcess),
    PuschHoppingCtrl := p_PuschHoppingCtrl,
    TpcCommandPusch := cs_NR_DciCommon_TpcCommand,
    UL_SUL_Indicator := cs_NR_DciFormat_0_X_UL_SUL_Indicator_None,
    Format := p_DciFormatAndParams
  };

  template (value) NR_SearchSpaceUlDciAssignment_Type cs_NR_SearchSpaceUlDciAssignment(NR_PhysicalParameters_Type p_PhysicalParameters,
                                                                                       template (value) NR_DciFormat_0_X_SpecificInfo_Type p_DciFormatAndParams := cs_NR_DciFormat_0_1_Params,
                                                                                       template (value) NR_ImcsValue_Type p_ImcsValue := tsc_NR_DefaultGrant_Imcs,
                                                                                       template (omit) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul := cs_NR_FreqDomainSchedulDefault,  //omit=DEFAULT grant
                                                                                       template (value) NR_AssignedBWPs_Type p_AssignedBWPs := cs_NR_AssignedBWPs_ActiveBWP) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    /* @sic R5-196751: DCI format 0_1 instead of 0_0 sic@ */
    AssignedBWPs := p_AssignedBWPs,
    SearchSpaceType := ussUL,
    DciInfo := fl_NR_DciUlInfo_Init(p_PhysicalParameters, p_DciFormatAndParams, p_ImcsValue, f_NR_RetreiveDefault_FreqDomainSchedul(p_PhysicalParameters.ChannelBandwidth, p_FreqDomainSchedul)) //@sic R5-250309 CBW3 sic@
  };

  /*
   * @desc      Wrapper function to use DCI parameters for DCI format 0_1 or 0_0 depending on test case attribute ShortDCI
   * @param     p_PhysicalParameters
   * @param     p_IsSharedSpectrum  (default value: false)
   * @param     p_DCI_0_0           (default value: false)
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SearchSpaceUlDciAssignment(NR_PhysicalParameters_Type p_PhysicalParameters,
                                           boolean p_IsSharedSpectrum := false,
                                           boolean p_DCI_0_0 := false
                                           ) return template (value) NR_SearchSpaceUlDciAssignment_Type //SharedSpectrum
  { //@sic R5w240308: DCI 0_3/1_3 sic@
    var template (value) NR_DciFormat_0_X_SpecificInfo_Type v_DciFormatAndParams;

    if (not (f_GetTestcaseAttrib_ShortDCI(testcasename())) or p_DCI_0_0) {
      v_DciFormatAndParams := cs_NR_DciFormat_0_1_Params(-,-, f_NR_InitialiseDciFormat_0_1_ChAccess_CPextCAPC(p_IsSharedSpectrum)); //SharedSpectrum
    } else {
      v_DciFormatAndParams := cs_NR_DciFormat_0_0_Params(f_NR_InitialiseDciFormat_X_0_ChAccess_CPext(p_IsSharedSpectrum)); //SharedSpectrum
    }
    return cs_NR_SearchSpaceUlDciAssignment(p_PhysicalParameters, v_DciFormatAndParams);
  }

  template (value) NR_DciUlInfo_Type cs_NR_DciUlInfo_AllOmit :=
  { /* local base template */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ResoureAssignment := omit,
    PuschHoppingCtrl := omit,
    TpcCommandPusch := omit,
    UL_SUL_Indicator := omit,
    Format := omit
  };

  template (value) NR_DciUlInfo_Type cds_NR_DciUlInfo_ModifyGrant(template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul,
                                                                  template (omit) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment := omit,
                                                                  template (value) NR_ImcsValue_Type p_ImcsValue,
                                                                  template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit,
                                                                  template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := omit, //@sic R5-221589 sic@
                                                                  template (omit)  NR_DciFormat_0_X_SpecificInfo_Type p_NR_DciFormat_0_X_SpecificInfo := omit,
                                                                  template (omit) NR_DciCommon_UL_SUL_Indicator_Type p_UL_SUL_Indicator := omit
                                                                  )
    modifies cs_NR_DciUlInfo_AllOmit :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-245503: added p_UL_SUL_Indicator sic@
    ResoureAssignment := cs_NR_DciFormat_0_X_ResourceAssignment(p_ResourceAllocationType,
                                                                p_FreqDomainSchedul,
                                                                p_TimeDomainResourceAssignment,                 /* @sic R5s190827 change 9 sic@ */
                                                                cs_NR_TransportBlockRetransmissionList_Def(p_ImcsValue),
                                                                p_HarqProcessConfig),
    UL_SUL_Indicator := p_UL_SUL_Indicator,
    Format         := p_NR_DciFormat_0_X_SpecificInfo
   };

  const B2_Type tsc_NR_DciFormat_1_0_ShortMessageIndicator_PagingOnly := '01'B;    /* 38.212 Table 7.3.1.2.1-1     @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const B2_Type tsc_NR_DciFormat_1_0_TbScaling_Factor1 := '00'B;                   /* 38.214 Table 5.1.3.2-2       @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)*/

  const B1_Type tsc_NR_DciFormat_1_0_SystemInfoIndicator_SIB1 := '0'B;             /* 38.212 Table 7.3.1.2.1-2     @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const B1_Type tsc_NR_DciFormat_1_0_SystemInfoIndicator_SI := '1'B;               /* 38.212 Table 7.3.1.2.1-2     @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_RedundancyVersionList_Type cs_NR_RedundancyVersionList_None := {};                                            /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

