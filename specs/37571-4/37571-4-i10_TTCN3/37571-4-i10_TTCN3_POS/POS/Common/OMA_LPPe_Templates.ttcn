module OMA_LPPe_Templates {

  import from OMA_LPPE language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"}; 

  template (value) OMA_LPPe_LPPeVersion cs_OMA_LPPe_LPPeVersion_1_0 :=
  { /* @status    APPROVED (POS) */
    majorVersion := 1,
    minorVersion := 0
  };

  template (value) OMA_LPPe_MessageExtension cs_OmaLppe_RequestCapabilities :=
  { /* @status    APPROVED (POS) */
    lppeCompatibilityLevel := 0,
    lppeVersion := cs_OMA_LPPe_LPPeVersion_1_0,
    lppeMode := normal,
    messageExtensionBody := {
      requestCapabilities := {
        commonIEsRequestCapabilities := {
          iP_Address_RequestCapabilities := {},
          assistanceContainerSupportReq := {
            vendorOrOperatorIDList := omit
          },
          locationInformationContainerSupportReq := {
            vendorOrOperatorIDList := omit
          },
          relativeLocationChange_RequestCapabilities  := {},
          highAccuracyFormatCapabilitiesReq := {},
          segmentedAssistanceData_ReqCapabilities := {},
          referencePointCapabilitiesReq := {
            referencePointProviderSupportListReq := omit
          },
          scheduledLocation_RequestCapabilities := {},
          accessCapabilitiesReq := {},
          segmentedLocationInformation_ReqCapabilities := {}
        },
        agnss_RequestCapabilities := {
          assistanceDataSupportListReq := NULL,
          environmentObservationSupportListReq := NULL,
          haGNSSsupportReq := NULL
        },
        otdoa_RequestCapabilities := {},
        eotd_RequestCapabilities := {},
        otdoa_utra_RequestCapabilities := {},
        ecid_lte_RequestCapabilities := {},
        ecid_gsm_RequestCapabilities := {},
        ecid_utra_RequestCapabilities := {},
        wlan_ap_RequestCapabilities := {},
        ecid_wimax_RequestCapabilities := {},
        sensor_RequestCapabilities := {},
        srn_RequestCapabilities := {
          capabilitiesRequestedFor := omit
        }
      }
    }
  };

  template (present) OMA_LPPe_MessageExtension cr_OmaLppe_ProvideCapabilities :=
  { /* @status    APPROVED (POS) */
    lppeCompatibilityLevel := 0,
    lppeVersion := cs_OMA_LPPe_LPPeVersion_1_0,
    lppeMode := normal,
    messageExtensionBody := {
      provideCapabilities := {
        commonIEsProvideCapabilities := *,
        agnss_ProvideCapabilities := *,
        otdoa_ProvideCapabilities := *,
        eotd_ProvideCapabilities := *,
        otdoa_utra_ProvideCapabilities := *,
        ecid_lte_ProvideCapabilities := *,
        ecid_gsm_ProvideCapabilities := *,
        ecid_utra_ProvideCapabilities := *,
        wlan_ap_ProvideCapabilities := *,
        ecid_wimax_ProvideCapabilities := *,
        sensor_ProvideCapabilities := *,
        srn_ProvideCapabilities := *
      }
    }
  };

}
