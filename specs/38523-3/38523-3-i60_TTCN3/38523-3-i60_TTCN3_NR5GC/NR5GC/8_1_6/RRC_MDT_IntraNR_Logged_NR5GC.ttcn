    //@siclog "Step 30" siclog@
    //The SS transmits a RRCRelease message to release the RRC connection.
    f_NR_RRCRelease(nr_Cell1);
    //@siclog "Step 31" siclog@
    //Wait 30 seconds.
    f_Delay(30.0);
    //@siclog "Step 32" siclog@
    //The SS transmits a Paging message on NR Cell 1.
    f_NR_Paging_Def(nr_Cell1, RRC_IDLE);
    //@siclog "Step 33" siclog@
    //The UE transmits an RRCRequest message on NR Cell 1.
    f_NR_RRC_SetupRequest_Def(nr_Cell1);
    //@siclog "Step 34" siclog@
    //The SS transmits an RRCSetup message on NR Cell 1.
    f_NR_RRCSetup_Def (nr_Cell1);
    //@siclog "Step 35" siclog@
    //@sic R5-230757 sic@
    //Check: Does UE transmit an RRCSetupComplete message with logMeasAvailable IE not present?
    SRB.receive(car_NR_SRB1_RrcNasPdu_IND(nr_Cell1,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def,-,-,-,*),?)) -> value v_ReceivedAsp; //@sic R5s230330 sic@
    v_ReceivedMsg := v_ReceivedAsp.Signalling.Nas[0];
    if (ispresent (v_ReceivedAsp.Signalling.Rrc.Dcch.message_.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.nonCriticalExtension ))
    {
        if (not ispresent (v_ReceivedAsp.Signalling.Rrc.Dcch.message_.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.nonCriticalExtension.ue_MeasurementsAvailable_r16))
        {
          f_NR_PreliminaryPass(__FILE__, __LINE__, " Step 35");
        }
        else {//@sic R5-237360 sic@
          if (not ispresent (v_ReceivedAsp.Signalling.Rrc.Dcch.message_.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.nonCriticalExtension.ue_MeasurementsAvailable_r16.logMeasAvailable_r16))
         {
            f_NR_PreliminaryPass(__FILE__, __LINE__, " Step 35");
         }
          else {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 35: UE transmit an RRCSetupComplete message with logMeasAvailable IE not present")
         }
        }
    }else{
        f_NR_PreliminaryPass(__FILE__, __LINE__, " Step 35");
    }
    //@siclog "Step 36-40" siclog@
    //Steps 5 to 9 of the generic procedure in TS 38.508-1[4] Table 4.5.4.2-3 are executed to successfully complete the service request procedure.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(nr_Cell1, v_ReceivedMsg);

  }//End of f_TC_8_1_6_1_2_12_NR5GC_TestBody

