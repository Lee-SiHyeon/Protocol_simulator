module EUTRA_NR_CoordMsg {

  import from Common4G5G all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from CommonIratDefs all;

  type union EUTRA_NR_Coordination_MSG {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    EUTRA_NR_CoOrd_Security_Type    Security,
    EUTRA_NR_CoOrd_Trigger_Type     TriggerEvent,
    EUTRA_NR_CoOrd_OctetData_Type   OctetData,
    EUTRA_NR_CoOrd_SysInfo_Type     SysInfo,
    EUTRA_NR_CoOrd_Timing_Type      Timing,
    EUTRA_NR_CoOrd_GUTI_Type        GutiParams,
    UE_NR_DeltaValues_Type          DeltaValues, //@sic R5-197223 sic@
    EUTRA_NR_PduSessionInfoList_Type    PduSessionInfoList     //@sic R5-199103 sic@
  };

  type record EUTRA_NR_CoOrd_Timing_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SubFrameTiming_Type    Time
  };

  type record EUTRA_NR_CoOrd_Trigger_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    charstring    Reason
  };

  type record EUTRA_NR_CoOrd_OctetData_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    octetstring   Data,
    charstring    Description
  };

  type union EUTRA_NR_CoOrd_SysInfo_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    CoOrd_EUTRASysInfo_List_Type Eutra,
    CoOrd_NRSysInfo_List_Type NR
  };

  type record EUTRA_NR_CoOrd_Security_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // All fields are optional as some are only required for different options
    integer             SK_Counter  optional,
    CoOrd_KeyToUse_Type KeyToUse    optional,
    B256_Type           Key         optional,
    B3_Type             KSI         optional,
    NasCount_Type       NASCountUL  optional,   // @sic R5w190307 sic@
    NasCount_Type       NASCountDL  optional,   // @sic R5w190307 sic@
    CoOrd_E_NEACap_Type E_NEACap    optional,
    CoOrd_E_NIACap_Type E_NIACap    optional,
    B256_Type           NH          optional,  // @sic R5s201078 sic@
    integer             NCC         optional  // @sic R5s201078 sic@
  };

  type enumerated CoOrd_KeyToUse_Type { KENB, S_KGNB };  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  type record CoOrd_E_NEACap_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    B1_Type E_Nea0,
    B1_Type E_Nea1,
    B1_Type E_Nea2
  };

  type record CoOrd_E_NIACap_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    B1_Type E_Nia0,
    B1_Type E_Nia1,
    B1_Type E_Nia2
  };

  type record of CoOrd_NRSysInfo_Type CoOrd_NRSysInfo_List_Type;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  type record CoOrd_NRSysInfo_Type {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    integer Arfcn,
    integer PhysCellId,
    integer SCS   optional,
    boolean IsFDD,
    boolean IsFR1,
    integer Band,        //@sic R5-194875 sic@
    integer Bandwidth    //@sic R5-254995 sic@
  };

  type record EUTRA_NR_CoOrd_GUTI_Type { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    O3_Type  PLMN,                     // the PLMN of the cell, defined in octets
    B8_Type  AMF_RegionId,
    B10_Type AMF_SetId,
    B6_Type  AMF_Pointer,
    B32_Type NG_TMSI
  };

  type port EUTRA_NR_CO_ORD_PORT message {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    out EUTRA_NR_Coordination_MSG;
    in  EUTRA_NR_Coordination_MSG;
  };

  group Templates {

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_Trigger(charstring p_Reason := "") :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    TriggerEvent := {
      Reason := p_Reason
    }
  };

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_Trigger(charstring p_Reason := "") :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    TriggerEvent := {
      Reason := p_Reason
    }
  };

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_OctetData(octetstring p_Data,
                                                                    charstring p_Descr) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    OctetData := {
      Data := p_Data,
      Description := p_Descr
    }
  };

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_OctetData(charstring p_Descr) :=
  {  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    OctetData := {
      Data := ?,
      Description := p_Descr
    }
  };

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_Security(template (omit) integer             p_SK_Counter,
                                                                   template (omit) CoOrd_KeyToUse_Type p_KeyToUse,
                                                                   template (omit) B256_Type           p_Key,
                                                                   template (omit) B3_Type             p_KSI,
                                                                   template (omit) NasCount_Type       p_NASCountUL,
                                                                   template (omit) NasCount_Type       p_NASCountDL,
                                                                   template (omit) CoOrd_E_NEACap_Type p_E_NEACap,
                                                                   template (omit) CoOrd_E_NIACap_Type p_E_NIACap,
                                                                   template (omit) B256_Type           p_NH,
                                                                   template (omit) integer             p_NCC) :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    // Added fields for IRAT @sic R5-194814 sic@
    Security := {
      SK_Counter := p_SK_Counter,
      KeyToUse   := p_KeyToUse,
      Key        := p_Key,
      KSI        := p_KSI,
      NASCountUL := p_NASCountUL,
      NASCountDL := p_NASCountDL,
      E_NEACap   := p_E_NEACap,
      E_NIACap   := p_E_NIACap,
      NH         := p_NH,    // @sic R5s201078 sic@
      NCC        := p_NCC    // @sic R5s201078 sic@
    }
  };

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_Security :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Security := ?
  };

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_CoOrd_Guti (O3_Type  p_PLMN,                     // the PLMN of the cell, defined in octets
                                                           B8_Type  p_AMF_RegionId,
                                                           B10_Type p_AMF_SetId,
                                                           B6_Type  p_AMF_Pointer,
                                                           B32_Type p_NG_TMSI) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
   GutiParams := {
    PLMN := p_PLMN,                     // the PLMN of the cell, defined in octets
    AMF_RegionId  := p_AMF_RegionId,
    AMF_SetId  := p_AMF_SetId,
    AMF_Pointer  := p_AMF_Pointer,
    NG_TMSI  := p_NG_TMSI
   }
  }

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_CoOrd_Guti :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    GutiParams := ?
  };

  template (value) CoOrd_NRSysInfo_Type cs_CoOrd_SysInfoNR(integer p_Arfcn,
                                                           integer p_PhysCellId,
                                                           template (omit) integer p_SCS,
                                                           boolean p_IsFDD,
                                                           boolean p_IsFR1,
                                                           integer p_Band,
                                                           integer p_Bandwidth) :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    Arfcn       := p_Arfcn,
    PhysCellId  := p_PhysCellId,
    SCS         := p_SCS,
    IsFDD       := p_IsFDD,
    IsFR1       := p_IsFR1,
    Band        := p_Band,
    Bandwidth   := p_Bandwidth    //@sic R5-254995 sic@
  };

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_SysInfoEUTRA(template (value) EUTRA_NR_CoOrd_SysInfo_Type p_EUTRA_NR_CoOrd_SysInfo) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    SysInfo := p_EUTRA_NR_CoOrd_SysInfo
  };

  template (value) EUTRA_NR_CoOrd_SysInfo_Type cs_EUTRA_NR_CoOrdSysInfo_Eutra (template (value) CoOrd_EUTRASysInfo_List_Type p_EUTRASysInfoList) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    Eutra := p_EUTRASysInfoList
  };

  template (value) EUTRA_NR_CoOrd_SysInfo_Type cs_EUTRA_NR_CoOrdSysInfo_NR (template (value) CoOrd_NRSysInfo_List_Type p_NRSysInfoList) :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    NR := p_NRSysInfoList
  };

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_SysInfo :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    SysInfo := ?  //@sic R5s191140 sic@
  };

  template (value) EUTRA_NR_Coordination_MSG cms_EUTRA_NR_PduSessionInfoList(EUTRA_NR_PduSessionInfoList_Type p_PduSessionInfoList) :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    PduSessionInfoList := p_PduSessionInfoList
  };

  template (present) EUTRA_NR_Coordination_MSG cmr_EUTRA_NR_PduSessionInfoList :=
  { /* @status    APPROVED (NR5GC_IRAT) */
    PduSessionInfoList := ?
  };

  } // end of group Templates

  /*
   * @desc      to immediately detect programming errors (shall normally not happen)
   * @param     p_Port
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  altstep a_EUTRA_NR_Default(EUTRA_NR_CO_ORD_PORT p_Port)
  {
    [] p_Port.receive {
      FatalError(__FILE__, __LINE__, "unexpected coordination message");
    }
  }

  /*
   * @desc      send message to the other PTC
   * @param     p_Port
   * @param     p_Msg
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_EUTRA_NR_SendCoOrd(EUTRA_NR_CO_ORD_PORT p_Port,
                                template (value) EUTRA_NR_Coordination_MSG p_Msg)
  {
    p_Port.send(p_Msg);
  }

  /*
   * @desc      Wait for a coordination meessage from other PTC at the given port
   * @param     p_Port
   * @return    EUTRA_NR_CoOrd_Security_Type
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_Security(EUTRA_NR_CO_ORD_PORT p_Port) return EUTRA_NR_CoOrd_Security_Type
  {
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    var EUTRA_NR_CoOrd_Security_Type v_SecurityRx;

    alt {
      [] p_Port.receive(cmr_EUTRA_NR_Security) -> value v_ReceivedMsg {
        v_SecurityRx := v_ReceivedMsg.Security;
      }
      [] a_EUTRA_NR_Default(p_Port) {}
    }
    return v_SecurityRx;
  }

  /*
   * @desc      wait for trigger sent by the other PTC
   * @param     p_Port
   * @param     p_Reason            (default value: "")
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA_NR_CO_ORD_PORT p_Port,
                                           charstring p_Reason := "")
  {
    alt {
      [] p_Port.receive(cmr_EUTRA_NR_Trigger(p_Reason)) {}
      [] a_EUTRA_NR_Default(p_Port) {}
    }
  }

  /*
   * @desc      wait for Data sent by the other PTC
   * @param     p_Port
   * @param     p_Descr
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_Data(EUTRA_NR_CO_ORD_PORT p_Port,
                                        charstring p_Descr) return octetstring
  {
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    alt {
      [] p_Port.receive(cmr_EUTRA_NR_OctetData (p_Descr)) -> value v_ReceivedMsg  {}
      [] a_EUTRA_NR_Default(p_Port) {}
    }
    return v_ReceivedMsg.OctetData.Data;
  }

  /*
   * @desc      wait for SysInfo sent by the other PTC
   * @param     p_Port
   * @return    EUTRA_NR_CoOrd_SysInfo_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA_NR_CO_ORD_PORT p_Port) return EUTRA_NR_CoOrd_SysInfo_Type
  {
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    alt {
      [] p_Port.receive(cmr_EUTRA_NR_SysInfo) -> value v_ReceivedMsg {}  //@sic R5-191140 sic@
      [] a_EUTRA_NR_Default(p_Port) {}
    }
    return v_ReceivedMsg.SysInfo;
  }

   /*
   * @desc      send system information of this PTC to the other PTC and wait for the system information from the other side
   * @param     p_Port
   * @param     p_EUTRA_NR_CoOrd_SysInfo
   * @return    EUTRA_NR_CoOrd_SysInfo_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_NR_SysinfoCoOrd(EUTRA_NR_CO_ORD_PORT p_Port,
                                   template (value) EUTRA_NR_CoOrd_SysInfo_Type p_EUTRA_NR_CoOrd_SysInfo
                                   ) return EUTRA_NR_CoOrd_SysInfo_Type
  {
    var EUTRA_NR_CoOrd_SysInfo_Type v_SysInfoRx;
    
    p_Port.send(cms_EUTRA_NR_SysInfoEUTRA(p_EUTRA_NR_CoOrd_SysInfo));
    v_SysInfoRx := f_EUTRA_NR_WaitForCoOrd_SysInfo (p_Port);
    
    return v_SysInfoRx;
  }

  /*
   * @desc      send system information of this PTC to the other PTC
   * @param     p_Port
   * @param     p_EUTRA_NR_CoOrd_SysInfo
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_NR_SendSysinfoCoOrd(EUTRA_NR_CO_ORD_PORT p_Port,
                                       template (value) EUTRA_NR_CoOrd_SysInfo_Type p_EUTRA_NR_CoOrd_SysInfo
                                       )
  {
    
    p_Port.send(cms_EUTRA_NR_SysInfoEUTRA(p_EUTRA_NR_CoOrd_SysInfo));

  }

  /*
   * @desc      wait for GutiParams sent by the other PTC
   * @param     p_Port
   * @return    EUTRA_NR_CoOrd_GUTI_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_GutiParams(EUTRA_NR_CO_ORD_PORT p_Port) return EUTRA_NR_CoOrd_GUTI_Type
  {
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    alt {
      [] p_Port.receive(cmr_EUTRA_NR_CoOrd_Guti) -> value v_ReceivedMsg {}
      [] a_EUTRA_NR_Default(p_Port) {}
    }
    return v_ReceivedMsg.GutiParams;
  }

  /*
   * @desc      wait for PDU session information from EUTRA
   * @param     p_Port
   * @return    EUTRA_NR_PduSessionInfoList_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_NR_WaitForCoOrd_PduSessionInfoList(EUTRA_NR_CO_ORD_PORT p_Port) return EUTRA_NR_PduSessionInfoList_Type
  {
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    alt {
      [] p_Port.receive(cmr_EUTRA_NR_PduSessionInfoList) -> value v_ReceivedMsg  {}
      [] a_EUTRA_NR_Default(p_Port) {}
    }
    return v_ReceivedMsg.PduSessionInfoList;
  }

}
