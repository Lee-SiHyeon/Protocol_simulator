module MCX_XML_common_policy {

  import from XSD all;
  import from urn_ietf_params_xml_ns_common_policy language "XSD" all;  

  type urn_ietf_params_xml_ns_common_policy.Ruleset  CP_Ruleset_Type;   /* @status    APPROVED (MCX) */

  type urn_ietf_params_xml_ns_common_policy.RuleType CP_Rule_Type;      /* @status    APPROVED (MCX) */

  template (value) CP_Ruleset_Type cs_MCX_CP_Ruleset(template (value) RuleType p_Rule) :=
  { /* @status    APPROVED (MCX) */
    rule_list := {
      p_Rule
    }
  };

  template (value) CP_Rule_Type cs_MCX_CP_Rule(XSD.ID p_Id,
                                               template (value) ExtensibleType p_Actions) :=
  { /* @status    APPROVED (MCX) */
    id := p_Id,
    conditions := omit,
    actions := p_Actions,
    transformations := omit
  };

}
