    var integer v_MCCH_Offset := v_Sib13.mbsfn_AreaInfoList_r9[0].mcch_Config_r9.mcch_Offset_r9;
    return v_MCCH_Offset;
  }

  /*
   * @desc      Return the MCCH Notification Indicator of the cell
   * @param     p_CellId
   * @return    NotificationIndicator_r9_Type
   * @status    APPROVED (LTE_A_R10_R11)
