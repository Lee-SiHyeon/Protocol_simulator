module UTRAN34_RRC_CommonTemplates_r11 {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN_RRC_Templates_r11 all;

  template (value) DL_AM_RLC_Mode_r11 cds_DL_AM_RLC_Flexible_r11(template (value) ReceivingWindowSize p_Rw := rw2047,
                                                                 template (value) TimerStatusProhibit p_TimerStatusProhibit := tsp100,
                                                                 template (omit) TimerReordering p_TimerReordering := omit)
    modifies cs_DL_AM_RLC_r11 :=
  { /* @status    APPROVED (UTRAN) */
    dl_RLC_PDU_size := {
      flexibleSize := size7
    },
    receivingWindowSize := p_Rw,
    dl_RLC_StatusInfo := {
      timerStatusProhibit := p_TimerStatusProhibit,
      timerReordering := p_TimerReordering
    }
  };

}
