  template (value) UE_CapabilityRequest cs_UE_CapabilityRequest_NR := {nr};                      /* @status    APPROVED (ENDC, NR5GC_IRAT) */

  template (value) UE_CapabilityRequest cs_UE_CapabilityRequest_EUTRA_NR := {eutra_nr};          /* @status    APPROVED (ENDC) */

  template (value) UE_CapabilityRequest cs_UE_CapabilityRequest_EUTRA_ENDC := {nr, eutra_nr};    /* @status    APPROVED (ENDC, NR5GC_IRAT) */

  template (value) DL_DCCH_Message cs_508_UeCapabilityEnquiry_MRDC_r15(RRC_TransactionIdentifier p_RRC_TI,
                                                                       template (value) UE_CapabilityRequest p_UE_CapabilityRequest,
                                                                       template (omit) octetstring p_MRDC) :=
    /* According to 36.508 cl. 4.6.1 Table 4.6.1-22 */
    /* @status    APPROVED (ENDC, NR5GC_IRAT) */
              cs_508_UeCapabilityEnquiry(p_RRC_TI,
                                         p_UE_CapabilityRequest,
                                         p_MRDC);

  template (value) RRCConnectionReconfiguration_v1510_IEs.nr_Config_r15 cs_RRCConnectionReconfiguration_v1510_IEs_NR_Config_Setup(template (omit) octetstring p_SCGConfig := omit,
                                                                                                                                  template (omit) P_Max p_P_Max := fl_NR_GetP_Max(),
                                                                                                                                  boolean p_ENDC_ReleaseAndAdd_r15 := false
                                                                                                                                  ) :=
  {/* @status    APPROVED (ENDC, NR5GC_IRAT) */
    setup := {
      endc_ReleaseAndAdd_r15  := p_ENDC_ReleaseAndAdd_r15,
      nr_SecondaryCellGroupConfig_r15  := p_SCGConfig,
      p_MaxEUTRA_r15     := p_P_Max
    }
  };

  template (present) UL_DCCH_Message cr_RRCConnectionReconfigurationComplete_r15 :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    message_ := {
      c1 := {
       rrcConnectionReconfigurationComplete  := {
         rrc_TransactionIdentifier := tsc_RRC_TI_Def,
         criticalExtensions := {
            rrcConnectionReconfigurationComplete_r8 := {
              nonCriticalExtension := {
                lateNonCriticalExtension := *,
                nonCriticalExtension := {
                  rlf_InfoAvailable_r10 := *,
                  logMeasAvailable_r10 := *,
                  nonCriticalExtension := {
                    connEstFailInfoAvailable_r11 := *,
                    nonCriticalExtension := {
                      logMeasAvailableMBSFN_r12 := *,
                      nonCriticalExtension := {
                        perCC_GapIndicationList_r14 := *,
                        numFreqEffective_r14 := *,
                        numFreqEffectiveReduced_r14 := *,
                        nonCriticalExtension := {
                          scg_ConfigResponseNR_r15 := ?,
                          nonCriticalExtension := *
                        }
                      }
                    }
                  }
                }
              }
            }
          }
       }
      }
    }
  };

  template (value) RadioBearer_Type cs_RadioBearer_Reconfig(template (value) RadioBearerId_Type p_Id,
                                                            template (value) PDCP_Configuration_Type p_PdcpConfig,
                                                            template (omit) RLC_Configuration_Type p_RlcConfig := omit,
                                                            template (omit) MAC_Configuration_Type p_MacConfig := omit,
                                                            template (omit) LogicalChannelId_Type p_LogicalChannelId := omit ) :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    //@sic R5s200052: added p_LogicalChannelId sic@
    Id := p_Id,
    Config := {
      AddOrReconfigure := {
        Sdap := omit,       // @sic R5w220012 sic@
        Pdcp := p_PdcpConfig,
        Rlc := p_RlcConfig,
        LogicalChannelId := p_LogicalChannelId,
        Mac := p_MacConfig,
        DiscardULData := omit
      }
    }
  };

  template (value) RadioBearer_Type cs_RadioBearer_Reconfig_DRBonEUTRAwithUPIP( DRB_Identity p_DRB_Id,
                                                                                  template (omit) RLC_Configuration_Type p_RlcConfig := cs_RLC_Configuration_AM,
                                                                                  template (omit) MAC_Configuration_Type p_MacConfig := cs_MAC_Configuration_AM
                                                                                  ) :=
   /* @status    APPROVED (ENDC, NR5GC_IRAT) */
   cs_RadioBearer_Reconfig(cs_RadioBearerId_DRB(p_DRB_Id),
                            cs_PDCP_Configuration_NR_Terminating(cs_NR_PDCP_RbConfig_ParamsDRB(cs_NR_PDCP_DRB_Config_Parameters(true))),
                            p_RlcConfig , p_MacConfig, p_DRB_Id+2);

  template (value) PDCP_Configuration_Type cs_PDCP_Configuration_NR_Proxy(template (value) RlcBearerRouting_Type p_LinkToOtherCellGroup) :=
  { /* @status    APPROVED (ENDC) */
    Proxy := {
      LinkToOtherNode := p_LinkToOtherCellGroup
    }
  };

  template (value) PDCP_Configuration_Type cs_PDCP_Configuration_NR_Terminating(template (value) NR_PDCP_RbConfig_Type p_RbConfig,
                                                                                template (value) RlcBearerRouting_Type p_LinkToOtherCellGroup := crs_RlcBearerRouting_None) :=
  { /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    NR_PDCP := {
      RbConfig := p_RbConfig,
      LinkToOtherCellGroup := p_LinkToOtherCellGroup
    }
  };

  template (present) UE_NetworkCap cdr_UPIP_UENetworkCap (template (omit) IEI8_Type p_IEI)
           modifies cr_UENetworkCap_Any :=
  {  /* @status    APPROVED (ENDC) */
   eiaCap := (? length (7) & '1'B)
  };

  /*
   * @desc      Get P_Max value based on PICS
   * @return    template (omit) P_Max
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function fl_NR_GetP_Max () return template (omit) P_Max
  { // @sic R5-190721 R5-211891 sic@
    var template (omit) P_Max v_P_Max := omit;
    
    if (pc_dynamicPowerSharingENDC){ //@sic R5s190064 sic@
      //SIG AND EN-DC AND pc_dynamicPowerSharingENDC
      v_P_Max := 23;
    } else {
      //SIG AND EN-DC AND (NOT pc_dynamicPowerSharingENDC)
      v_P_Max := 20;
    }
    return v_P_Max;
  }

  /*
   * @desc      Converts bit string to ASN.1 CipheringAlgorithm representation
   * @param     p_String
   * @return    CipheringAlgorithm_r12
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA_ConvertCiphAlg2Bitstring(B3_Type  p_String) return CipheringAlgorithm_r12
  {
    var CipheringAlgorithm_r12 v_Alg;
    select (p_String) {
      case ('000'B){
        v_Alg := eea0;
      }
      case ('001'B){
        v_Alg := eea1;
      }
      case ('010'B){
        v_Alg := eea2;
      }
      case ('011'B){
        v_Alg := eea3_v1130;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Ciphering algorithm Selected");
      }
    }
    return v_Alg;
  }

  /*
   * @desc      Converts bit string to ASN.1 IntegrityProtAlgorithm_Type representation
   * @param     p_String
   * @return    IntegrityProtAlgorithm_Type
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA_ConvertIntAlg2Bitstring(B3_Type p_String) return IntegrityProtAlgorithm_Type
  {
    var IntegrityProtAlgorithm_Type v_Alg;
    select (p_String) {
      case ('001'B) {
        v_Alg := eia1;
      }
      case ('010'B) {
        v_Alg := eia2;
      }
      case ('011'B) {
        v_Alg := eia3_v1130;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Non defined AS Integrity algorithm Selected");
      }
    }
    return v_Alg;
  }

  /*
   * @desc      convert integer to EUTRA ASN.1 from co-ord message
   *            3 types are defined separately in the EUTRA ASN.1 definitions, but with the same values
   *            therefore we need 3 different conversion functions!
   * @param     p_IntegerValue
   * @return    RS_ConfigSSB_NR_r15.subcarrierSpacingSSB_r15
   * @status    APPROVED (ENDC)
   */
  function f_NR_ConvertIntToSCS(integer p_IntegerValue) return RS_ConfigSSB_NR_r15.subcarrierSpacingSSB_r15
  {
    var RS_ConfigSSB_NR_r15.subcarrierSpacingSSB_r15 v_ASN1Value;
    select (p_IntegerValue) {
      case (15) {
        v_ASN1Value := kHz15;
      }
      case (30) {
        v_ASN1Value := kHz30;
      }
      case (120) {
        v_ASN1Value := kHz120;
      }
      case (240) {
        v_ASN1Value := kHz240;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid SCS value");
      }
    }
    return v_ASN1Value;
  }

  /*
   * @desc      Calculate the time to no cell timing offset and send it to NR PTC
   * @param     p_CellId
   * @param     p_ActivationTime
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_SendTimeToNR(EUTRA_CellId_Type  p_CellId,
                                  SubFrameTiming_Type p_ActivationTime) runs on EUTRA_5GS_PTC
  {
    var SubFrameTiming_Type v_SubFrameTimingAlignToNoOffset;
    var CellTimingInfo_Type v_CellTimingInfo := f_EUTRA_CellInfo_GetCellTimingInfo(p_CellId);
    var integer v_SystemTimeUnits := f_SystemTimeUnits_ConvertFromSubFrameTiming(p_ActivationTime) + f_SystemTimeUnits_ConvertFromCellTimingInfo(v_CellTimingInfo); // add SNF offset and TCell (=> normalised time)
      
    v_SubFrameTimingAlignToNoOffset := f_SystemTimeUnits_ConvertToSubFrameTiming(v_SystemTimeUnits, p_ActivationTime.Slot);
    f_EUTRA_NR_SendCoOrd_Time(NR, v_SubFrameTimingAlignToNoOffset);
  }

  /*
   * @desc      Sets the cell power attenuation and stores the value in the EUTRA_CellInfo
   * @param     p_CellId
   * @param     p_NewPowerLevel_FR1   absolute (negative) value as specified in the test prose for FR1
   * @param     p_NewPowerLevel_FR2   absolute (negative) value as specified in the test prose for FR2
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_SetCellPower(EUTRA_CellId_Type p_CellId,
                                  AbsoluteCellPower_Type p_NewPowerLevel_FR1,
                                  AbsoluteCellPower_Type p_NewPowerLevel_FR2,
                                  template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on EUTRA_5GS_PTC
  {
    var template (value) CellPowerList_Type v_CellPowerList;
    var EUTRA_CellId_Type v_ReferenceCellId;

    if (f_EUTRA38_NR_TestEnvironment_Get() == Conducted) {  // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
      v_CellPowerList := { cs_CellPower(p_CellId, p_NewPowerLevel_FR1) };
    } else {
      v_CellPowerList := { cs_CellPower(p_CellId, p_NewPowerLevel_FR2) };
    }
    if (f_TimingInfo_IsNow(p_TimingInfo)) {
      v_ReferenceCellId := eutra_Cell_NonSpecific;
    } else {
      v_ReferenceCellId := p_CellId;
    }
    f_EUTRA_SetCellPowerList(v_CellPowerList, p_TimingInfo, v_ReferenceCellId);
  }

  /*
   * @desc      protocol configuration options for condition Interworking_with_5GS in 36.508 Table 4.7.3-6
   *            NOTE: this function uses NG_NAS_Templates/TypeDefs and therefore it shall not be used by legacy LTE test cases
   * @param     p_CellId
   * @param     p_IMS_PDN_ConnEstab
   * @param     p_EpsBearerId      (default value: 'C'H)
   *             .. - values hardcoded for ENDC
   * @param     p_InterworkWithEPS (default value: true)
   *             ..  - as this is only called after ueNetworkCapability has been checked for N1 support, this should always be true
   * @param     p_IwkN26           (default value: NOT_SUPPORTED)
   * @param     p_PDN_Type         (default value: None)
   * @return    template (value) NAS_ProtocolConfigOptions_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_AdditionalProtocolConfigOptions(EUTRA_CellId_Type p_CellId,
                                                        boolean p_IMS_PDN_ConnEstab,
                                                        EPS_BearerIdentity p_EpsBearerId := 'C'H,
                                                        boolean p_InterworkWithEPS := true,
                                                        InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                                        PDU_PDN_DNN_Type p_PDN_Type := None) runs on EUTRA_PTC return template (value) NAS_ProtocolConfigOptions_Type
  {
    var template (value) NAS_ProtocolConfigOptions_Type v_AdditionalProtocolConfigOptions := {};
    var template (value) QoS_RuleList v_QoS_RuleList;
    var template (value) QoS_FlowList v_QoS_Flows;
    var template (value) NAS_ProtocolConfigOptions_Type v_ProtocolConfigOptions := {};
    
    if (not (p_IwkN26 == SUPPORTED and p_PDN_Type == Emergency_PDN)) { // @sic R5s220883 sic@
      // Don't add anything if w/o N26 supported and emergency PDN
      v_ProtocolConfigOptions := {
      cs_ProtocolContainer('001B'O, '01'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))),  // @sic R5s201102, R5-204488 sic@
      cs_ProtocolContainer('001B'O, '02'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))), // @sic R5-221467 default now contains 4 SSTs sic@
      cs_ProtocolContainer('001B'O, '03'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))),
      cs_ProtocolContainer('001B'O, '04'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId)))
      };
      
      if (p_IwkN26 == NOT_SUPPORTED) { // @sic R5-221406 sic@
        if (p_IMS_PDN_ConnEstab) {
          v_QoS_RuleList := { f_BuildDefaultQoSRule ("2") };    // QoS rules according to TS 38.508-1 [67] Table 4.8.2.1-2  // @sic R5-202585 sic@
          v_QoS_Flows := { cs_QoS_Flow2 (p_InterworkWithEPS, '50'O)};  // @sic R5-204488 sic@ Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-2.  BearerId hardcoded to 5 for IMS
          if (p_PDN_Type == Emergency_PDN) { // @sic R5s230883 sic@
            v_QoS_Flows := { cs_QoS_Flow2 (p_InterworkWithEPS, hex2oct(p_EpsBearerId & '0'H))};  // Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-2.  BearerId different to 5 for emergency PDN
          }
        } else {
          v_QoS_RuleList := { f_BuildDefaultQoSRule ("1") };    // QoS rules according to TS 38.508-1 [67] Table 4.8.2.1-1  // @sic R5-202585 sic@
          v_QoS_Flows := { cs_QoS_Flow1 (p_InterworkWithEPS, hex2oct(p_EpsBearerId & '0'H))};  // @sic R5-204488 sic@ Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-1
        }
        v_AdditionalProtocolConfigOptions := {
        cs_ProtocolContainer('001D'O, bit2oct(encvalue(cs_Session_AMBR(omit, '05'O, '0004'O, '05'O, '0004'O)))),
        cs_ProtocolContainer('001C'O, bit2oct(encvalue(v_QoS_RuleList))),
        cs_ProtocolContainer('001F'O, bit2oct(encvalue(v_QoS_Flows)))};
      }
    }
    
    v_ProtocolConfigOptions := v_ProtocolConfigOptions & v_AdditionalProtocolConfigOptions; // restructured to avoid tool error
    return v_ProtocolConfigOptions;
  }

  /*
   * @desc      to be used in the test case preamble
   * @param     p_CellId
   * @param     p_State
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_EquivalentPlmnList (default value: omit)
   * @param     p_AbsoluteCellPowerLevel_FR1 (default value: omit)
   * @param     p_AbsoluteCellPowerLevel_FR2 (default value: omit)
   * @param     p_UserPlaneIntegrity (default value: false)
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_NR_InitialRegistration(EUTRA_CellId_Type p_CellId,
                                              IDLEUPDATED_STATE_Type p_State,
                                              RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                              template (omit) PLMN_List p_EquivalentPlmnList := omit,
                                              template (omit) AbsoluteCellPower_Type p_AbsoluteCellPowerLevel_FR1 := omit,
                                              template (omit) AbsoluteCellPower_Type p_AbsoluteCellPowerLevel_FR2 := omit,
                                              boolean p_UserPlaneIntegrity := false) runs on EUTRA_5GS_PTC
  {
    var NAS_MSG_Indication_Type v_NAS_Ind;
    var AbsoluteCellPower_Type v_AbsoluteCellPowerLevel_FR1 := tsc_ServingCellRS_EPRE;
    var AbsoluteCellPower_Type v_AbsoluteCellPowerLevel_FR2 := tsc_ServingCellRS_EPRE_FR2;
    var template (omit) AdditionalUpdateType v_AdditionalUpdateType;
    var NAS_UL_Message_Type v_PdnConnectivityRequest;
    var ProcedureTransactionIdentifier v_EPS_TI;
    var template (value) ProtocolConfigOptions v_PcoToUE;
    var template (omit) ProtocolConfigOptions v_PcoFromUE := omit;  // may be omit
    var template (omit) ExtdProtocolConfigOptions v_ExtdPcoToUE := omit;
    var template (omit) ExtdProtocolConfigOptions v_ExtdPcoFromUE := omit;
    var boolean v_IPv4AllocationViaNasFlag := f_CheckPCOforIPallocationViaNas(v_PcoFromUE); // See TS 36.508 v.8.2.2 Table 4.7.3_6
    var APNandPCOs_Type v_APNandPCOs;
    var PDN_Index_Type v_PdnIndex := f_EUTRA_InitialRegistrationPdnIndex(firstPDN);
    var template (value) NAS_ProtocolConfigOptions_Type v_AdditionalProtocolConfigOptions_FirstPDN := {};
    var template (value) NAS_ProtocolConfigOptions_Type v_AdditionalProtocolConfigOptions_SecondPDN := {};
    var boolean v_IMS_PDN_ConnEstab_FirstPDN;
    var boolean v_IMS_PDN_ConnEstab_SecondPDN;
    var template (omit) EUTRA_NR_PduSessionInfo_Type v_PduSessionInfo := omit;
    var template (omit) integer v_SessionId := omit;
    var template (omit) integer v_QFI := omit;
    var NR_Configuration_Type v_NR_ConfigType := f_EUTRA38_NR_Config_Get();
    var PDU_PDN_DNN_Type v_PdnType := Internet_DNN;   // @sic R5-245495 sic@

    timer t_GuardTimer := tsc_GuardTimePreamble;

    t_GuardTimer.start;
    
    if (ispresent(p_AbsoluteCellPowerLevel_FR1) and ispresent(p_AbsoluteCellPowerLevel_FR2)) {
      v_AbsoluteCellPowerLevel_FR1 := valueof(p_AbsoluteCellPowerLevel_FR1);
      v_AbsoluteCellPowerLevel_FR2 := valueof(p_AbsoluteCellPowerLevel_FR2);
    }
    // First switch cell back on
    f_EUTRA38_SetCellPower(p_CellId, v_AbsoluteCellPowerLevel_FR1, v_AbsoluteCellPowerLevel_FR2);
    
    // Switch on UE
    f_EUTRA_SwitchOnUEandStartIP(p_CellId);
    
    // Now continue with the procedure
    v_NAS_Ind := f_EUTRA_InitialRegistration_Step1_4(p_CellId, PREAMBLE, NORMAL);
    
    // @sic R5s194877 do extra checks now on Attach Req message sic@
    if (not ispresent (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueAddSecurityCap)){
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueAddSecurityCap should be present for ENDC");
    }
    select (v_NR_ConfigType) { // @sic R5s200421 sic@
      case (EN_DC) {
        if (not match (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueNetworkCapability, cdr_EUTRA_UENetworkCap(omit))){
          f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueNetworkCapability does not indicate support for ENDC");
        }
      }
      case else {
        if (not match (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueNetworkCapability, cdr_NR5GC_UENetworkCap(omit))){
          f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueNetworkCapability does not indicate support for NR");
        }
        else { /* @sic R5-198996 - Assumption: additional PCOs only for IRAT test cases sic@ */
          v_IMS_PDN_ConnEstab_FirstPDN := tsc_EUTRA_Registration_PDN1isIMS;
          v_IMS_PDN_ConnEstab_SecondPDN := not v_IMS_PDN_ConnEstab_FirstPDN;

          f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_IpcanInd);   // @sic R5-199103: S1-N1-mode change; IMS registration at EUTRA side sic@

          v_AdditionalProtocolConfigOptions_FirstPDN := f_EUTRA38_NR_AdditionalProtocolConfigOptions(p_CellId, v_IMS_PDN_ConnEstab_FirstPDN); // @sic R5s201102 sic@
          v_AdditionalProtocolConfigOptions_SecondPDN := f_EUTRA38_NR_AdditionalProtocolConfigOptions(p_CellId, v_IMS_PDN_ConnEstab_SecondPDN); // @sic R5s201102 sic@
        }
      }
    }
    
    if (p_UserPlaneIntegrity) {    // @sic R5-235380 sic@
      if (not match (v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.ueNetworkCapability, cdr_UPIP_UENetworkCap(omit))){
        f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "ueNetworkCapability does not indicate support for UPIP");
      }
    }
    
    v_AdditionalUpdateType := v_NAS_Ind.Pdu.Msg.aTTACH_REQUEST.addUpdateType;
    v_PdnConnectivityRequest := v_NAS_Ind.Pdu.PiggybackedPduList[0].Msg;
    v_EPS_TI := v_PdnConnectivityRequest.pDN_CONNECTIVITY_REQUEST.procedureTransactionIdentifier;
    v_PcoFromUE := v_PdnConnectivityRequest.pDN_CONNECTIVITY_REQUEST.protocolConfigurationOptions;
    v_ExtdPcoFromUE := v_PdnConnectivityRequest.pDN_CONNECTIVITY_REQUEST.extdProtocolConfigurationOptions; // @sic R5-200648 sic@
    v_APNandPCOs := f_EUTRA38_NR_InitialRegistration_Step5_13(p_CellId, p_State, v_NAS_Ind);
    
    if (ispresent(v_APNandPCOs.protocolConfigurationOptions)) { // @sic R5s200654 sic@
      v_PcoFromUE := v_APNandPCOs.protocolConfigurationOptions;
    } else if (ispresent(v_APNandPCOs.extdProtocolConfigurationOptions)) { // @sic R5-200649 sic@
      v_ExtdPcoFromUE := v_APNandPCOs.extdProtocolConfigurationOptions;
    }
    
    if (isvalue(v_PcoFromUE)) { // @sic R5s200654 sic@
      v_IPv4AllocationViaNasFlag := v_IPv4AllocationViaNasFlag and f_CheckPCOforIPallocationViaNas(v_PcoFromUE);
      if ((f_CheckPCOforProtocolID(v_PcoFromUE, '001A'O))) { // @sic R5-200649 sic@
        v_SessionId := f_ProtocolConfigOptions_GetSessionId(v_PcoFromUE);
      } else if (v_NR_ConfigType != EN_DC) { // @sic R5s200421 sic@
        f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Id not present in PCO");
      }
    } else {
      v_IPv4AllocationViaNasFlag := v_IPv4AllocationViaNasFlag and f_CheckExtdPCOforIPallocationViaNas(v_ExtdPcoFromUE);
      if ((f_CheckExtdPCOforProtocolID(v_ExtdPcoFromUE, '001A'O))) { // @sic R5-200649 sic@
        v_SessionId := f_ExtdProtocolConfigOptions_GetSessionId(v_ExtdPcoFromUE);
      } else if (v_NR_ConfigType != EN_DC) { // @sic R5s200421 sic@
        f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Id not present in PCO");
      }
    }
    
    v_PcoToUE := f_GetDefaultProtocolConfigOptions(v_PcoFromUE, v_PdnIndex, v_AdditionalProtocolConfigOptions_FirstPDN);  /* @sic R5-198996: v_AdditionalProtocolConfigOptions_FirstPDN sic@ */
    v_ExtdPcoToUE := f_GetDefaultEUTRAExtdProtocolConfigOptions(v_ExtdPcoFromUE, v_PdnIndex, v_AdditionalProtocolConfigOptions_FirstPDN);  // @sic R5-200649, R5s200643 sic@
    v_QFI := f_ProtocolConfigOptions_GetQosFlowId(v_PcoToUE);
    if (not isvalue (v_QFI)) {
      v_QFI := f_ExtdProtocolConfigOptions_GetQosFlowId(v_ExtdPcoToUE);
    }
    if (isvalue (v_ExtdPcoFromUE)) { // @sic R5s200421 sic@
      // At the moment, 36.508 table 4.7.3-6 specifies ExtdPCO should be not present
      v_PcoToUE.iel := int2oct(oct2int(valueof(v_ExtdPcoToUE.iel)), 1);
      v_PcoToUE.pco := v_ExtdPcoToUE.pco;
    }
    
    if (tsc_EUTRA_Registration_PDN2isIMS) {    // @sic R5-245495 sic@
      v_PdnType := IMS_DNN;
    }

    v_PduSessionInfo := f_EUTRA_NR_PduSessionInfo(v_SessionId,
                                                  0, // @sic R5s201094 not relevant in this direction sic@
                                                  v_QFI,
                                                  v_PdnType,            // @sic R5-245495 sic@
                                                  v_PdnIndex,
                                                  tsc_EUTRA_Registration_PDN1isIMS);
    f_EUTRA_InitialRegistration_Step14_15(p_CellId,
                                          NORMAL,
                                          v_AdditionalUpdateType,
                                          v_EPS_TI,
                                          v_IPv4AllocationViaNasFlag,
                                          v_PcoToUE,
                                          v_APNandPCOs.accessPointName,
                                          cs_GprsTimer_v_deact,
                                          omit,
                                          omit,
                                          p_EquivalentPlmnList,
                                          0,
                                          omit,
                                          firstPDN,
                                          -,
                                          v_PduSessionInfo);      /* @sic R5-199103: v_PduSessionInfo sic@ */
    
    f_EUTRA_InitialRegistration_Step16_16c1(p_CellId, -, -, -, v_AdditionalProtocolConfigOptions_SecondPDN);   /* @sic R5-198996: v_AdditionalProtocolConfigOptions_SecondPDN sic@ */
    // need to keep all PDNs active
    if (p_ReleaseConnection == rrcConnectionRelease) {
      f_EUTRA_RRC_ConnectionRelease(p_CellId);
    }
    
    t_GuardTimer.stop;
  }

  /*
   * @desc      step 5 .. 13 of UE Registration acc. to 36.508 cl. 4.5.2
   * @param     p_CellId
   * @param     p_State
   * @param     p_NAS_Ind
   * @return    APNandPCOs_Type
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_NR_InitialRegistration_Step5_13(EUTRA_CellId_Type p_CellId,
                                                       IDLEUPDATED_STATE_Type p_State,
                                                       NAS_MSG_Indication_Type p_NAS_Ind) runs on EUTRA_5GS_PTC return APNandPCOs_Type
  {
    var NasCount_Type v_NasCountUL;
    var APNandPCOs_Type v_APNandPCOs;
    
    v_NasCountUL := f_EUTRA_InitialRegistration_Step5_8 (p_CellId, p_NAS_Ind);
    v_APNandPCOs := f_EUTRA38_NR_InitialRegistration_Step9_13 (p_CellId, p_State, p_NAS_Ind, v_NasCountUL);
    
    return v_APNandPCOs;
  }

  /*
   * @desc      step 9 .. 13 of UE Registration acc. to 36.508 cl. 4.5.2
   * @param     p_CellId
   * @param     p_State
   * @param     p_NAS_Ind
   * @param     p_NasCountUL
   * @return    APNandPCOs_Type
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_NR_InitialRegistration_Step9_13(EUTRA_CellId_Type p_CellId,
                                                       IDLEUPDATED_STATE_Type p_State,
                                                       NAS_MSG_Indication_Type p_NAS_Ind,
                                                       NasCount_Type p_NasCountUL) runs on EUTRA_5GS_PTC return APNandPCOs_Type
  { /* the returned APNandPCOs_Type contains the valid APN (i.e. accessPointName is present) */
    
    var APNandPCOs_Type v_APNandPCOs := f_EUTRA_InitialRegistration_Step9_11 (p_CellId, p_State, p_NAS_Ind, p_NasCountUL);
    
    // Step 12-13 UE Capability check
    f_EUTRA_Capability(p_CellId, tsc_RRC_TI_Def); // This enquires for the eutra capability but does not check the contents of the message received
    // Step 13Aa1-13Aa2 EN-DC UE Capability check
    f_EUTRA38_NR_Capability(p_CellId, tsc_RRC_TI_Def); // This asks for the eutra and nr capabilities but does not check the contents of the message received
    
    return v_APNandPCOs;
  }

  /*
   * @desc      Send UECapabilityEnquiry message and receives UECapabilityInformation message.
   *            The received UE Capabilities are decoded and stored in the structure for the Mobile Info.
   * @param     p_CellId
   * @param     p_RRC_TI
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_Capability(EUTRA_CellId_Type p_CellId,
                                        RRC_TransactionIdentifier p_RRC_TI) runs on EUTRA_5GS_PTC
  {
    var SRB_COMMON_IND v_ReceivedAspForUeCapabilityInfo;
    var octetstring v_NRCapability;
    var octetstring v_ENDCCapability;
    var octetstring v_NR_MRDC_Freqs;
    
    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (int2oct(f_EUTRA_CellInfo_GetBand (p_CellId), 1), "EUTRA Band"));
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "MRDC_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15(p_RRC_TI, cs_UE_CapabilityRequest_EUTRA_ENDC, v_NR_MRDC_Freqs)));
        SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_UeCapabilityInformation_Any(p_RRC_TI)))
          -> value v_ReceivedAspForUeCapabilityInfo;
      }
      case (NR_SA) { // @sic R5s200369 sic@
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "NR_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15(p_RRC_TI, cs_UE_CapabilityRequest_NR, v_NR_MRDC_Freqs)));
        SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_UeCapabilityInformation_Any(p_RRC_TI)))
          -> value v_ReceivedAspForUeCapabilityInfo;
      }
      // To be extended for other options
    }
    
    // Decode and store the ueCapabilitiesRAT-Container
    v_NRCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[0].ueCapabilityRAT_Container;
    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        v_ENDCCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[1].ueCapabilityRAT_Container;
        // Send NR capabilities to NR PTC
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_ENDCCapability, "ENDCCap"));
      }
      case (NR_SA) { // @sic R5s200369 sic@
        // Send NR capabilities to NR PTC
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
      }
      // To be extended for other options
    }
  }

  /*
   * @desc      To disconnect a PDN and deactivate the associated bearer
                Can be called as an alternative to Detach Request message at switch off
                UE must already be in connected mode
   * @param     p_CellId
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  altstep a_EUTRA38_DisconnectPDN(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    var SRB_COMMON_IND v_ReceivedAsp;
    var ProcedureTransactionIdentifier v_EpsTi;
    var EPS_BearerIdentity v_EpsBearerId;
    
    []  SRB.receive(car_SRB2_NasPdu_IND(p_CellId, cr_NAS_Indication(tsc_SHT_IntegrityProtected_Ciphered, cr_PDNDisconnectReq(?)))) -> value v_ReceivedAsp
      {
        v_EpsTi := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_DISCONNECT_REQUEST.procedureTransactionIdentifier;
        v_EpsBearerId := bit2hex(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_DISCONNECT_REQUEST.linkedEpsBearerId.idValue); // @sic R5s201546 sic@
        f_EUTRA_DeactivateEPS_BearerContext(p_CellId, v_EpsBearerId, v_EpsTi, tsc_ESM_Cause36_RegularDeactivation);
      }
  }

  type enumerated DataPath_Protocol_Type { PDCP, NR_PDCP, SDAP }; /* @sic R5w220012 sic@ @status    APPROVED (ENDC, NR5GC_IRAT) */

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_CellId
   * @param     p_PDCP_Protocol
   * @param     p_BearerType
   * @param     p_StepNo
   * @param     p_DRB
   * @param     p_SequenceNumber    (default value: 1)
   * @param     p_UsePING           (default value: true)
   * @param     p_PdnIndex          (default value: PDN_2)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_CheckDataPath(EUTRA_CellId_Type p_CellId,
                                 DataPath_Protocol_Type p_PDCP_Protocol,
                                 DataPathCheck_BearerType_Type p_BearerType,
                                 charstring p_StepNo,
                                 template (value) RadioBearerId_Type p_DRB,
                                 integer p_SequenceNumber := 1,
                                 boolean p_UsePING := true,
                                 PDN_Index_Type p_PdnIndex := PDN_2) runs on EUTRA_PTC // @sic R5s201390 sic@
  { // split to call a common function @ sic R5w220012 sic@
   var boolean v_UsePING := p_UsePING and pc_IP_Ping; // @sic  only use PING if required by test case sic@
   var octetstring v_PdcpSduTX := f_LoopbackModeBorPing_GetDataTX(p_PdnIndex, p_BearerType, p_SequenceNumber, v_UsePING);
   var PDCP_SDUList_Type v_PDCP_SDUList := { v_PdcpSduTX };
   var template (value) L2DataList_Type v_PDCP_DataTX;
   var template (present) L2DataList_Type v_PDCP_DataRX;
   var template (value) DRB_COMMON_REQ v_DRB_DL;
   var template (present) DRB_COMMON_IND v_DRB_UL;

   select (p_PDCP_Protocol) {
     case (PDCP) {
       v_PDCP_DataTX := cs_L2DataList_PdcpSdu(v_PDCP_SDUList);
       v_PDCP_DataRX := cr_L2DataList_PdcpSdu;
     }
     case (NR_PDCP) {
       v_PDCP_DataTX := cs_L2DataList_NrPdcpSdu(v_PDCP_SDUList);
       v_PDCP_DataRX := cr_L2DataList_NrPdcpSdu;
     }
   }

   v_DRB_DL := cas_DRB_COMMON_REQ(p_CellId, p_DRB, cs_TimingInfo_Now, v_PDCP_DataTX);
   v_DRB_UL := car_DRB_COMMON_IND(p_CellId, p_DRB, cr_TimingInfo_Any, v_PDCP_DataRX);

   f_EUTRA_CheckDataPathCommon (v_PdcpSduTX, v_DRB_DL, v_DRB_UL, p_PDCP_Protocol, p_StepNo, v_UsePING);
  }

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_SduTX
   * @param     p_DRB_DL
   * @param     p_DRB_UL
   * @param     p_Protocol
   * @param     p_StepNo            (default value: "")
   * @param     p_UsePING           (default value: true)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_CheckDataPathCommon(octetstring p_SduTX,
                                       template (value) DRB_COMMON_REQ p_DRB_DL,
                                       template (present) DRB_COMMON_IND p_DRB_UL,
                                       DataPath_Protocol_Type p_Protocol,
                                       charstring p_StepNo := "",
                                       boolean p_UsePING := true) runs on EUTRA_PTC
  {
   var DRB_COMMON_IND v_DRB_COMMON_IND;
   var octetstring v_SduRX;

   if (p_UsePING) { f_IP_Routing_ChangeToRawmode(IP); }   /* @sic R5s200044 change 4, R5-206332 sic@ */

   DRB.send(p_DRB_DL);
   DRB.receive(p_DRB_UL) -> value v_DRB_COMMON_IND;

   if (p_UsePING) { f_IP_Routing_RestoreRoutingTable(IP); }   /* @sic R5s200044 change 4, R5-206332 sic@ */

   select (p_Protocol) {
     case (PDCP)    { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.PdcpSdu[0]; }
     case (NR_PDCP) { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.NrPdcpSdu[0]; }
     case (SDAP)    { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.SdapSdu[0]; }
   }

   if (not f_LoopbackModeBorPing_CheckDataRX(p_SduTX, v_SduRX)) {
     f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid Echo Reply");
   } else {
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, p_StepNo);
   }
  }

  /*
   * @desc      To be called during initialization of the EUTRA38 PTC
   * @param     p_Port
   * @param     p_SK_Counter        (default value: tsc_SK_Counter)
   * @return    EUTRA38_SecurityParamsExtd_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(EUTRA_NR_CO_ORD_PORT p_Port,
                                                   integer p_SK_Counter := tsc_SK_Counter)
    runs on EUTRA_5GS_PTC return EUTRA38_SecurityParamsExtd_Type
  {
    var EUTRA38_SecurityParamsExtd_Type v_Extd_Security_Params := f_EUTRA38_Security_Get();
    var EUTRA_SecurityParams_Type v_Security_Params := f_EUTRA_Security_Get();
    var template (omit) CoOrd_E_NEACap_Type v_EEACap := omit;
    var template (omit) CoOrd_E_NIACap_Type v_EIACap := omit;
    
    v_Extd_Security_Params.SK_Counter := p_SK_Counter; // @sic R5s190491 sic@
    v_Extd_Security_Params.S_KGNB := f_EUTRA_NR_InitAS_KeyChaining_SgNB(v_Security_Params.KDF,
                                                                        v_Security_Params.KENB,
                                                                        p_SK_Counter);
    if (isvalue(v_Security_Params.NAS_SecurityCap5G)) { // @sic R5s220853 sic@
      v_EEACap.E_Nea0 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 0, 1);
      v_EEACap.E_Nea1 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 1, 1);
      v_EEACap.E_Nea2 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 2, 1);
      v_EIACap.E_Nia0 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 0, 1);
      v_EIACap.E_Nia1 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 1, 1);
      v_EIACap.E_Nia2 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 2, 1);
    }
    
    f_EUTRA_NR_SendCoOrd (p_Port, cms_EUTRA_NR_Security(v_Extd_Security_Params.SK_Counter,
                                                        S_KGNB,
                                                        v_Extd_Security_Params.S_KGNB,
                                                        omit, // @sic R5-194814 sic@
                                                        omit, // @sic R5-194814 sic@
                                                        omit, // @sic R5w190307 sic@
                                                        v_EEACap,
                                                        v_EIACap,
                                                        omit, omit));
    return v_Extd_Security_Params;
  }

  /*
   * @desc      common initialisation of the EUTRA38_PTC
   *            - store the NR configuration, then call the base function
   *            Function to be used in ENDC test cases and in NR5GC tc with HO to ENDC configuration
   * @param     p_NR_Config
   * @param     p_SysinfoCombination
   * @param     p_HandleULDataUM    (default value: omit)
   * @param     p_UseBigGrants      (default value: omit)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_Init(NR_Configuration_Type p_NR_Config,
                          Combination_Type p_SysinfoCombination,
                          template (omit) EUTRA_HandleUlDataUM_Type p_HandleULDataUM := omit,
                          template (omit) EUTRA_UseBigGrants_Type p_UseBigGrants := omit) runs on EUTRA_5GS_PTC
  {
    var integer v_EUTRA_PrimaryBand := f_ENDC_GetEUTRA_Band(px_ENDC_BandCombination);
    var integer v_EUTRA_SecondaryBand := f_ENDC_GetEUTRA_Band(px_ENDC_SecondaryBandCombination); //@sic R5-190669 sic@

    f_EUTRA38_NR_Config_Set (p_NR_Config);
    if (f_EUTRA38_NR_IsFR1(f_ENDC_GetNR_Band(px_ENDC_BandCombination))){ //@sic R5s201351 sic@
        f_EUTRA38_NR_IsFR1_Set(true);
    } else {
        f_EUTRA38_NR_IsFR1_Set(false);
    }
    // Set test environment depending on NR bands under test
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    if (f_GetTestcaseAttrib_InterBandTC(testcasename())) {
    // test case using 2 NR bands
       f_EUTRA38_NR_InitTestEnvironmnent(f_ENDC_GetNR_Band(px_ENDC_BandCombination), f_ENDC_GetNR_Band(px_ENDC_SecondaryBandCombination));
    } else {
    // test case using 1 NR bands
       f_EUTRA38_NR_InitTestEnvironmnent(f_ENDC_GetNR_Band(px_ENDC_BandCombination), omit);
    }
    f_EUTRA38_Security_Init();
    f_EUTRA_Init(p_SysinfoCombination, p_HandleULDataUM, p_UseBigGrants, v_EUTRA_PrimaryBand, v_EUTRA_SecondaryBand);
    f_EUTRA38_InitFrequencies(px_ENDC_BandCombination);
  }

  /*
   * @desc     return true if the parameterized NR band is an FR1 band
   * @param     p_NR_Band
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_IsFR1 ( integer p_NR_Band ) return boolean
  {
    if (p_NR_Band < 257){ //@sic R5s201351 sic@
        return true;
    } else {
        return false;
    }
  }

  /*
   * @desc      Set test environment depending on the NR bands under test
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_SecondaryFreqBandIndicatorNR (default value: omit)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_InitTestEnvironmnent( integer  p_PrimaryFreqBandIndicatorNR,
                                              template (omit) integer  p_SecondaryFreqBandIndicatorNR := omit
                                            ) runs on EUTRA_5GS_PTC
  { // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    if (isvalue(p_SecondaryFreqBandIndicatorNR)) {
        // test case using 2 NR bands
        if ( f_EUTRA38_NR_IsFR1(p_PrimaryFreqBandIndicatorNR) and f_EUTRA38_NR_IsFR1(valueof(p_SecondaryFreqBandIndicatorNR))) {
            vc_EUTRA38_Global.NR_TestEnvironment := Conducted;
        } else {
            vc_EUTRA38_Global.NR_TestEnvironment := OTA;
        }
    } else { // test using 1 NR band
        if ( f_EUTRA38_NR_IsFR1(p_PrimaryFreqBandIndicatorNR)) {
            vc_EUTRA38_Global.NR_TestEnvironment := Conducted;
        } else {
            vc_EUTRA38_Global.NR_TestEnvironment := OTA;
        }
    }
  }

}
