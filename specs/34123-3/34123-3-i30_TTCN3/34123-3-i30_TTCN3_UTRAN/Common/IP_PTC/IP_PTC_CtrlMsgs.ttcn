module IP_PTC_CtrlMsgs {

  import from CommonDefs all;
  import from CommonIP all;
  import from IP_ASP_TypeDefs all;

  type record IP_StartPDN_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId,
    IP_DrbInfo_Type     DrbInfo
  };

  type union IP_StopPDN_Type {          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    Null_Type           All,
    PDN_Index_Type      PdnId
  };

  type record IP_StartWLAN_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    WLAN_AddressInfo_Type AddressInfo,
    IP_DrbInfo_Type     DrbInfo,
    boolean             ExplicitDnsHandling     /* if set, DNS handling shall be not done implicitly by the IP_PTC but explicitly in the test case
                                                   @sic R5-169075 (test case 20.1) sic@ */
  };

  type record IP_StopWLAN_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
  };

  type record IP_ChangeDrbInfo_Type {   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId,
    IP_DrbInfo_Type     DrbInfo
  };

  type record IP_SendRouterAdvertisement_Type { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    PDN_Index_Type      PdnId
  };

  type union IP_ExplicitRouting_Type {          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_RoutingInfo_Type Add,
    IP_Connection_Type  Remove
  };

  type octetstring IP_DnsQuery_Type;            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type octetstring IP_DnsResponse_Type;         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  type union IP_ConfigReq_Type {        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    IP_StartPDN_Type                    StartPDN,
    IP_StopPDN_Type                     StopPDN,                /* @sic R5s131000: Null_Type replaced by IP_Stop_Type sic@ */
    IP_StartWLAN_Type                   StartWLAN,
    IP_StopWLAN_Type                    StopWLAN,
    Null_Type                           GeranCnf,               /* e.g. to confirm GeranTrigger */
    IP_ChangeDrbInfo_Type               ChangeDrbInfo,          /* @sic R5s150648 Change 5.1 sic@ */
    AnyCellId_Type                      ChangeCell,             /* @sic R5s150648 Change 5.1 sic@ @sic R5s210603: AnyCellId_Type instead of EUTRA_CellId_Type sic@ */
    IP_SendRouterAdvertisement_Type     SendRouterAdvertisement,
    IP_ExplicitRouting_Type             ExplicitRouting,        /* @sic R5s130681 change 3: handling of RTP data; R5s160131: Start/Stop sic@ */
    Null_Type                           ChangeToRawmode,        /* @sic R5s150074 - Additional change sic@ */
    Null_Type                           RestoreRoutingTable,    /* @sic R5s200044 change 4 sic@ */
    IP_DnsResponse_Type                 DnsResponse             /* @sic R5-169075 (test case 20.1) sic@ */
  };

  type union IP_Indication_Type {       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN)
                                           @sic R5-133612: trigger to GERAN sic@ */
    Null_Type                   Cnf,
    IP_DrbInfo_Type             GeranTrigger,
    IP_DnsQuery_Type            DnsQuery                  /* @sic R5-169075 (test case 20.1) sic@ */
  };

  type port IP_RAT_CTRL_PORT message {         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    out IP_ConfigReq_Type;
    in  IP_Indication_Type;
  };

  type port IP_PTC_CTRL_PORT message {         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    in  IP_ConfigReq_Type;
    out IP_Indication_Type;
  };

  template (value) IP_ConfigReq_Type cs_IP_StartPdnReq(PDN_Index_Type p_PdnId,
                                                       template (value) IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    StartPDN := {
      PdnId := p_PdnId,
      DrbInfo := p_DrbInfo
    }
  };

  template (value) IP_StopPDN_Type cs_IP_StopAllPDNs := {All := true};                           /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_ConfigReq_Type cs_IP_StopPdnReq(template (value) IP_StopPDN_Type p_IP_StopPDN) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    /* @sic R5s131000: new parameter p_IP_Stop sic@ */
    StopPDN := p_IP_StopPDN
  };

  template (present) IP_Indication_Type cr_IP_CommonCnf := {Cnf := true}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_DnsQuery(IP_DnsQuery_Type p_DnsQuery) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    DnsQuery := p_DnsQuery
  };

  template (present) IP_ConfigReq_Type cr_IP_DnsResponse := {DnsResponse := ?}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (present) IP_ConfigReq_Type cr_IP_CtrlAnyReq := ?;   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_CommonCnf := {Cnf := true};   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */

  template (value) IP_Indication_Type cs_IP_GeranTrigger(template (value) IP_DrbInfo_Type p_DrbInfo) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN) */
    GeranTrigger := p_DrbInfo
  };

  template (value) IP_DrbInfo_Type cs_DrbInfo_UTRAN(UTRAN_CellId_Type p_CellId,
                                                    IP_DrbId_Type p_DrbId) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
    Utran := {
      CellId := f_UtranCellId2Int(p_CellId),
      DrbId := p_DrbId
    }
  };

  /*
   * @desc      generic function to configure IP
   * @param     p_Port
   * @param     p_IP_ConfigReq
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function fl_IP_Config(IP_RAT_CTRL_PORT p_Port,
                        template (value) IP_ConfigReq_Type p_IP_ConfigReq)
  {
    p_Port.send(p_IP_ConfigReq);
    p_Port.receive(cr_IP_CommonCnf);
  }

  /*
   * @desc      RAT independent function to start DHCP and ICMPv6 server for given PDN
   * @param     p_Port
   * @param     p_PdnIndex         .. index of the PDN
   * @param     p_DrbInfo          .. DRB on which user plane signalling happens for this PDN
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_Handling_StartPDN(IP_RAT_CTRL_PORT p_Port,
                                  PDN_Index_Type p_PdnIndex,
                                  template (value) IP_DrbInfo_Type p_DrbInfo)
  { /* @sic R5-113734 change 8: replacing former f_DHCPv4_Start, f_ICMPv6_Start sic@ */
    fl_IP_Config(p_Port, cs_IP_StartPdnReq(p_PdnIndex, p_DrbInfo));
  }

  /*
   * @desc      RAT independent function to stop all DHCP and ICMPv6 servers
   * @param     p_Port
   * @param     p_IP_Stop          (default value: cs_IP_StopAllPDNs)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS, UTRAN)
   */
  function f_IP_Handling_StopPDN(IP_RAT_CTRL_PORT p_Port,
                                 template (value) IP_StopPDN_Type p_IP_Stop := cs_IP_StopAllPDNs)
  { /* @sic R5-113734 change 8: replacing former f_DHCPv4_Stop, f_ICMPv6_Stop sic@ */
    /* @sic R5s131000: new parameter p_IP_Stop sic@ */
    fl_IP_Config(p_Port, cs_IP_StopPdnReq(p_IP_Stop));
  }

}
