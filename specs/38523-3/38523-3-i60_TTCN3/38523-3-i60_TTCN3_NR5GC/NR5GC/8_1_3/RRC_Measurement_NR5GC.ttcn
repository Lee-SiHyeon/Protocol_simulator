  } // End of function f_TC_8_1_3_1_7_NR5GC

  /*
   * @desc      Common test body function for TC 8.1.3.1.5, 8.1.3.1.6, 8.1.3.1.7
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_5or6or7_TestBody(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  {//@sic R5-195259, R5-195260 sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var template (value) NR_CellPowerLevels_Type v_CellPowerLevels;

    var NR_AbsoluteCellPower_Type v_CellPower_Serving_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_NoEntry_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_EntryCondition_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_Leaving_FR1;

    var RSRP_Range v_RsrpThres;
    var Hysteresis v_Hysteresis; //@sic R5-198917 sic@
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var DeltaValues_Type v_Deltas;
      
    //Power levels of NR cell 1 and cell 2 FR1 acc. Table 8.1.3.1.5.3.2-1
    /*         |   Cell 1   |  Cell 2
     * -------------------------------
     *   T0    |    -85     |   -91
     * -------------------------------
     *   T1    |    -85     |   -79
     * -------------------------------
     *   T2    |    -85     |   -93
     *
     */
      
    //Power levels of NR cell 1 and cell 2 FR2 Table 8.1.3.1.5.3.2-2
    /*         |   Cell 1   |  Cell 2
     * -------------------------------
     *   T0    |    -91     |   -100
     * -------------------------------
     *   T1    |    -91     |   -82
     * -------------------------------
     *   T2    |    -91     |   -100
     *
     */
      
    v_CellPower_Serving_FR1 := -85;
    v_CellPower_NoEntry_FR1 := -91;
    v_CellPower_EntryCondition_FR1 := -79; //@sic R5-198917 sic@
    v_CellPower_Leaving_FR1 := -93;        //@sic R5-198917 sic@
     
    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_Serving_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2),        //@sic R5-234560 sic@
                                cs_NR_CellPower(p_NR_CellId, v_CellPower_NoEntry_FR1, tsc_NR_NonSuitableCellSSS_EPRE_FR2)};       //@sic R5-234560 sic@
    v_CellPowerList_AtT1    := {cs_NR_CellPower(p_NR_CellId, v_CellPower_EntryCondition_FR1, tsc_NR_ServingCellSSS_EPRE_FR2)};    //@sic R5-234560 sic@
    v_CellPowerList_AtT2    := {cs_NR_CellPower(p_NR_CellId, v_CellPower_Leaving_FR1, tsc_NR_NonSuitableCellSSS_EPRE_FR2)};       //@sic R5-234560 sic@
    v_CellPowerLevels := {v_CellPowerList_AtT0,
                          v_CellPowerList_AtT1,
                          v_CellPowerList_AtT2};    //@sic R5s198917 sic@
      
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message including MeasConfig to setup intra NR measurement and reporting for intra-frequency event A4 (measId 1).
    //The UE transmits an RRCReconfigrationComplete message
    v_Deltas := f_NR_MobileInfo_GetPrimaryDeltaValue();  //@sic R5-2334560 sic@
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        v_RsrpThres := 70;    //@sic R5-198917 sic@
    }
    else
    {
        v_RsrpThres := 66 + v_Deltas.DeltaNRf1;    //@sic R5-234560 sic@
    }
    v_Hysteresis := 2;     //@sic R5-108917 sic@
    v_ReportConfigList := {cs_NR_ReportConfigEventA4(tsc_NR_IdReportConfigId1, v_RsrpThres, infinity_, -, cs_NR_MeasReportQuantity_Rsrp, v_Hysteresis)};
            
    
    //@siclog "Steps  3-7 " siclog@
     fl_TC_8_1_3_1_x_CommonTestBody(p_NR_CellId, v_CellPowerLevels, v_ReportConfigList);
  } //End of f_TC_8_1_3_1_5_TestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.8
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_8_NR5GC() runs on NR5GC_PTC
  { //Measurement configuration control and reporting / Event A5 / Measurement of Neighbor NR cell / Intra-frequency measurements
  
    f_NR5GC_Init(NR_2);
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -82);    //@sic R5s190778, R5-234560 sic@
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell2, -79, -82);    //@sic R5-197856, R5-234560 sic@

    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_8_1_3_1_8or9or10_TestBody(nr_Cell2);    //re-use of test body of 8.1.3.8 for 8.1.3.9 and 8.1.3.10
    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
      
  } // End of function f_TC_8_1_3_1_8_NR5GC

