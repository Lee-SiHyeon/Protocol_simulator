  /*
   * @desc      To bring UE from switched off to state 6-11
   * @param     p_CellId
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GoToState6_11_MO(UTRAN_CellId_Type  p_CellId) runs on UTRAN_IP_PTC
  {
    var ACTIVATEPDPCONTEXTREQUESTul v_ActPdpContextReq;
    var TI v_Ti_R;// Transaction Identifier. r = value used to receive CC PDU. s = value used to send CC PDU.
    var TI v_Ti_S;// Transaction Identifier. r = value used to receive CC PDU. s = value used to send CC PDU.
    var template (value) PktDataProtoAddr v_ExpectedPDN_Address;
    var template (value) QualityOfService v_QualityOfService;
   // var UTRAN_SecurityInfo_Type v_SecurityInfo; @sic R5s170071 sic@
    
    /*This generic function will bring UE to state 6-8, though the name says state 6-7. Inside function f_UTRAN34_RRC_ConnEst will actually take care of it
      and will set the cell config type to cell_FACH */
    v_QualityOfService:= f_UTRAN_InitialiseQoS (p_CellId, cell_FACH_PS);
    v_ActPdpContextReq:= f_UTRAN34_GoToState6_7_MO(p_CellId, v_QualityOfService);
    f_UTRAN_CellInfo_SetConfigType (p_CellId, cell_FACH_PS);
    
    //Steps to bring UE to state 6-11 according to 34.108 7.4.2.6.2.3
    //Steps 1-2 in 34.108 cl. 7.4.2.6.2.3: Send RADIO BEARER SETUP and receive RADIO BEARER SETUP COMPLETE
    //v_SecurityInfo := f_UTRAN_Security_Get();@sic R5s170071 sic@
    f_UTRAN_RB_SetUp_PS_RAB(p_CellId, cell_FACH_PS); //@sic R5s170071 sic@
    
    //Step 3 in 34.108 cl. 7.4.2.6.2.3: Send ACTIVATE PDP CONTEXT ACCEPT
    v_Ti_R := v_ActPdpContextReq.ti;
    v_Ti_S.tiFlag := '1'B;
    v_Ti_S.tiVal := v_Ti_R.tiVal;
    
    v_ExpectedPDN_Address := f_UG_GetPktDataProtoAddr(true);
    
    f_UTRAN34_SendActivatePDP_Accept(v_QualityOfService,
                                     v_Ti_S,
                                     cs_PktDataProtoAddrMT(v_ExpectedPDN_Address.iel,
                                                           v_ExpectedPDN_Address.pDP_TypeNo,
                                                           v_ExpectedPDN_Address.addrInfo));
  }

  /*
   * @desc      Local function for TC_8_3_1_1f  to perform a cell update from a serving to a target cell.
   *            Depending parameter p_CellUdateConfigurationType passed in the function, SS may request UE to reconfigure phy, tr channels or RBs
   * @param     p_ServingCellId
   * @param     p_TargetCellId
   * @param     p_RRC_StateIndicator
   * @param     p_New_C_RNTI        (default value: omit)
   * @param     p_New_U_RNTI        (default value: omit)
   * @param     p_CellUdateConfigurationType (default value: defaultCellUpdate)
   * @param     p_PerformHO         (default value: true)
   * @param     p_RRC_TI            (default value: tsc_RRC_TI)
   * @status    APPROVED (UTRAN)
   */
  function fl_TC_8_3_1_1f_CellReselectionProcedure(UTRAN_CellId_Type p_ServingCellId,
                                                   UTRAN_CellId_Type p_TargetCellId,
                                                   RRC_StateIndicator  p_RRC_StateIndicator,
                                                   template (omit) C_RNTI p_New_C_RNTI := omit,
                                                   template (omit) U_RNTI p_New_U_RNTI := omit,
                                                   CellUdateConfigurationType p_CellUdateConfigurationType := defaultCellUpdate,
                                                   boolean p_PerformHO := true,
                                                   RRC_TransactionIdentifier p_RRC_TI := tsc_RRC_TI) runs on UTRAN_PTC //@sic R5s170071 sic@
  {
    var UTRAN_CellInfo_Type v_ServingCellInfo;
    var UTRAN_CellInfo_Type v_TargetCellInfo;
    var UTRAN_SecurityInfo_Type v_SecurityInfo;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI;
    
    v_ServingCellInfo:= f_UTRAN_CellInfo_Get(p_ServingCellId);
    v_TargetCellInfo:= f_UTRAN_CellInfo_Get(p_TargetCellId);
    f_UTRAN_RRC_ReceiveCellUpdateNonPeriodic(p_TargetCellId, cr_108_CellUpdate_r10(v_ServingCellInfo.uRNTI, cellReselection));
    
    if (p_PerformHO) {
      f_UTRAN34_HO_ReconfFACH_ToFACH(p_ServingCellId, p_TargetCellId);
      f_UTRAN34_CMAC_New_RNTI_Reconf(p_TargetCellId, v_ServingCellInfo.uRNTI);
    }
    
    v_SecurityInfo := f_UTRAN_Security_Get();
    
    select (p_CellUdateConfigurationType) {
      case (defaultCellUpdate) {
        //Step 4, 4b, 8, 30a
        if (ispresent(p_New_C_RNTI) and not (ispresent(p_New_U_RNTI))) {     //Step 4b
          v_TargetCellInfo.cRNTI := valueof(p_New_C_RNTI);
          v_TargetCellInfo.uRNTI := v_ServingCellInfo.uRNTI;
        } else if (ispresent(p_New_C_RNTI) and (ispresent(p_New_U_RNTI))) {  //Step 8
          v_TargetCellInfo.cRNTI := valueof(p_New_C_RNTI);
          v_TargetCellInfo.uRNTI := valueof(p_New_U_RNTI);
          v_ServingCellInfo.uRNTI := valueof(p_New_U_RNTI);          // @sic R5s107071 sic@
        }
        f_UTRAN_CellInfo_Set(p_TargetCellId, v_TargetCellInfo);      // @sic R5s107071 sic@
        f_UTRAN_CellInfo_Set(p_ServingCellId, v_ServingCellInfo);    // @sic R5s107071 sic@
        
        U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                            tsc_RB1,
                                            cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                    p_New_U_RNTI,
                                                                    p_New_C_RNTI,
                                                                    p_RRC_StateIndicator,
                                                                    -, -, -, -, -, -, -, -, -, -, -, -, -,
                                                                    p_RRC_TI)));  //@sic R5s170071 sic@
        f_Delay(tsc_DelaySetupFACH/3.0); //f_Delay(0.02) @sic R5s170071 sic@
        
        f_UTRAN_Default_BlockAM(true); //@sic R5s107071 sic@
        
        if (ispresent(p_New_C_RNTI)) {   //Step 4b, 8, 30a
          f_UTRAN34_CMAC_New_RNTI_Reconf(p_TargetCellId, v_TargetCellInfo.uRNTI, v_TargetCellInfo.cRNTI);
        }
        f_UTRAN_Default_BlockAM(false); //@sic R5s107071 sic@
        
      }
      case (phyChanIEs) {
        //Step 12
        U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                            tsc_RB1,
                                            cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                    -,
                                                                    -,
                                                                    p_RRC_StateIndicator,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    cs_UL_DPCH_Info_FDD(tsc_UL_DPDCH_SF_64k_PS,
                                                                                        pl0_96,
                                                                                        v_TargetCellInfo.cellInfo_Specific_FDD.uL_ScramblingCode),
                                                                    cs_DL_CommonInfoDCH_SRB_FDD(tsc_DL_DPCH1_SFP_64k_PS,
                                                                                                flexible,
                                                                                                true),
                                                                    cs_DL_InformationPerRL_r8_FDD(v_TargetCellInfo.cellInfo_Specific_FDD.priScrmCode,
                                                                                                  tsc_DL_DPCH1_ChC_64k_PS,
                                                                                                  tsc_DL_DPCH1_2ndScrC))));
        f_Delay(5.0*tsc_DelayTransmitFACH); //@sic R5s170071 sic@
        f_UTRAN34_ReconfigureFACH_ToDCH(p_TargetCellId);
        U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated, tsc_RB2, cr_PhysicalChannelReconfigurationComplete(v_RRC_TI)));
      }
      case (trChanIEs) {
        //Step 17
        U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                            tsc_RB1,
                                            cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                    -,
                                                                    -,
                                                                    p_RRC_StateIndicator,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    cs_UL_DPCH_Info_FDD(tsc_UL_DPDCH_SF_64k_PS,
                                                                                        pl0_96,
                                                                                        v_TargetCellInfo.cellInfo_Specific_FDD.uL_ScramblingCode),
                                                                    cs_DL_CommonInfoDCH_SRB_FDD(tsc_DL_DPCH1_SFP_64k_PS,
                                                                                                flexible,
                                                                                                true),
                                                                    cs_DL_InformationPerRL_r8_FDD(v_TargetCellInfo.cellInfo_Specific_FDD.priScrmCode,
                                                                                                  tsc_DL_DPCH1_ChC_64k_PS,
                                                                                                  tsc_DL_DPCH1_2ndScrC),
                                                                    cs_UL_CommTrChInfoDCH_PS_64k_FDD,
                                                                    cs_UL_AddReconfTransChInfoListDCH_PS_64k,
                                                                    cs_DL_CommonTransChInfoDCH_FDD(cs_TFCS_Cmpl0_1_2_3_4_5_6_7_8_9_Rx),
                                                                    cs_DL_AddReconfTransChInfoListDCH_PS_64k)));
        f_Delay(5.0*tsc_DelayTransmitFACH); //f_Delay(0.5) @sic R5s170071 sic@
        f_UTRAN34_ReconfigureFACH_ToDCH(p_TargetCellId);
        //Step 18
        U_AM.receive (car_RLC_Data_Ind(utran_CellDedicated,
                                       tsc_RB2,
                                       cr_108_TrChReconfCmpl_Any(v_RRC_TI)));
      }
      
      case (recfgRBsIEs) {
        //Step 23
        U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                            tsc_RB1,
                                            cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                    p_New_U_RNTI,
                                                                    p_New_C_RNTI,
                                                                    p_RRC_StateIndicator,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    {cs_RB_InformationReconfig_r8(tsc_RB20, omit, omit)},
                                                                    cs_RB_InformationAffectedList_8_3_1_1f)));
        f_Delay(tsc_DelaySetupFACH/3.0); //f_Delay(0.02) /@sic R5s170071 sic@
        f_UTRAN_Default_BlockAM(true);   //@sic R5s170071 sic@
        
        f_UTRAN34_CMAC_New_RNTI_Reconf(p_TargetCellId, v_TargetCellInfo.uRNTI, p_New_C_RNTI);  //@sic R5s170071 sic@
        f_UTRAN_Default_BlockAM(false);  //@sic R5s170071 sic@
        
        //Step 24
        U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,
                                      tsc_RB2,
                                      cdr_RadioBearerReconfigurationComplete_Any(v_RRC_TI)));  //@sic R5s170071 sic@
        
      }
      case (releaseRBsIEs) {
        //Step 27
        U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                            tsc_RB1,
                                            cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                    p_New_U_RNTI,
                                                                    p_New_C_RNTI,
                                                                    p_RRC_StateIndicator,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    -,
                                                                    {4})));
        
        f_Delay(tsc_DelaySetupFACH/3.0); //f_Delay(0.02) @sic R5s170071 sic@
        f_UTRAN_Default_BlockAM(true);   //@sic R5s170071 sic@
        f_UTRAN34_CMAC_New_RNTI_Reconf(p_TargetCellId, v_TargetCellInfo.uRNTI, p_New_C_RNTI);  // replaced  v_TargetCellInfo.cRNTI by p_New_C_RNTI @sic R5s170071 sic@
        f_UTRAN_Default_BlockAM(false);  //@sic R5s170071 sic@
        
        //Step 28
        U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,
                                      tsc_RB2,
                                      cdr_RadioBearerReleaseComplete_Any(tsc_RRC_TI))); // @sic R5s170071 sic@
      }
    }
  }

  /*
   * @desc      Local function for TC_8_3_1_1d  to swap power levels of a serving and a target cell
   * @param     p_ServingCellId
   * @param     p_TargetCellId
   * @status    APPROVED (UTRAN)
   */
  function fl_SwapPowerLevels(UTRAN_CellId_Type p_ServingCellId,
                              UTRAN_CellId_Type p_TargetCellId) runs on UTRAN_PTC
  {
    f_UTRAN_SetCellPower(p_ServingCellId, -69);
    f_UTRAN_SetCellPower(p_TargetCellId, -60);
  }

  /*
   * @desc      Local function for TC_8_3_1_1f used to create a cell set up the cell's system information according to the test case needs
   * @param     p_CellId
   * @status    APPROVED (UTRAN)
   */
  function fl_ConfigureCell_8_3_1_1f(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    // Configure cell1
    f_UTRAN_SS_CreateCellFACH(p_CellId);
    
    //Set system information configuration 6 according to TS 34.108 clause 6.1.0a2 to transmit SIB19
    f_UTRAN34_ChangeSysinfoConfiguration(p_CellId, configuration6);
      
    //Set FACH measurement occasions in SIB11
    f_UTRAN_SysInfo_SetSIB11_FACHMeasurementOccasionInfo(p_CellId, cs_FACH_MeasurementOccasionInfo_FDD(3,true, omit)); //@sic R5s170071 sic@
    
    //Set Qualmin in SIB4 to -16 dB
    f_UTRAN_SysInfo_SetSIB4_QqualMin(p_CellId,-16);
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(p_CellId);
      
    //Configure FACH Measurement Occasions in SS @sic R5s170920 sic@
    f_UTRAN_ConfigFACHMeasOccas(p_CellId, tsc_S_CCPCH1,1,3, true);
    
    f_UTRAN_SysInfoModifySIB19(p_CellId, cs_SIB19_Common(cs_Utra_PriorityInfoList_Def(4, //UtraPriorityValue
                                                                                      8, //S_PrioritySearch1
                                                                                      4), //ThreshServingLow
                                                         omit,
                                                         cs_Eutra_FreqAndPriList_OneEntry_Common(3250,
                                                                                                 mbw100,  //measurement bandwidth
                                                                                                 7, // priority
                                                                                                 -60, //qRxLevMinEUTR
                                                                                                 9, //threshXhigh 9
                                                                                                 2, //threshXlow 2
                                                                                                 omit, // EUTRA-Exclude-listedCellPerFreqList
                                                                                                 true), //eutraDetection
                                                         cs_SIB19_v920NonCriticalExtensions_Params(0, -, -, -, all_layers))); /* According to prose p_ThreshServingLow2 should be omitted -
                                                                                                                                 equivalent of default value of 0 (as per TS 36.508) */
  }

  /*
   * @desc      Local function for TC_8_3_1_1d used to send physical reconfiguration request message to the UE,
   *            to reconfigure DCH to FACH and to receive physical reconfiguration complete message from the UE
   * @param     p_CellId
   * @param     p_NewC_RNTI         (default value: omit)
   * @status    APPROVED (UTRAN)
   */
  function fl_PhyChReconfigDCH_ToFACH(UTRAN_CellId_Type p_CellId,
                                      template (omit) C_RNTI p_NewC_RNTI := omit) runs on UTRAN_PTC
  {
    var UTRAN_SecurityInfo_Type v_SecurityInfo := f_UTRAN_Security_Get ();
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI;
    var UTRAN_CellInfo_Type v_ServingCellInfo := f_UTRAN_CellInfo_Get(p_CellId); //@sic R5s170071 sic@
      
    
    U_AM.send(cas_RLC_Data_Req_NoCnf(utran_CellDedicated,
                                     tsc_RB2,
                                     cs_PhysicalChannelReconfiguration(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                                       v_RRC_TI,
                                                                       -,
                                                                       -,
                                                                       cell_FACH,
                                                                       -,
                                                                       -,
                                                                       cs_DL_InformationPerRL_NoDPCH_r8_FDD(v_ServingCellInfo.cellInfo_Specific_FDD.priScrmCode), //@sic R5s170071 sic@
                                                                       p_NewC_RNTI,
                                                                       v_ServingCellInfo.frequencyInfo )));                                                       //@sic R5s170071 sic@
    f_Delay(4.0*tsc_DelayDPCH ); //4*40ms @sic R5s170071 sic@
    f_UTRAN34_ReconfigureDCH_ToFACH(p_CellId, p_NewC_RNTI);
    
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,
                                  tsc_RB2,
                                  cr_PhysicalChannelReconfigurationComplete(v_RRC_TI)));
  }

  /*
   * @desc      The function is used to set cell 1 and cell 7 being inter-frequency cells (by default they are intra-fequency cells)
                It initialises SIB11 for cell 1 with 3 intra and 5 inter frequencies and SIB11 for vell 7 with 2 intra and 5 interfrequencies
   * @status    APPROVED (UTRAN)
   */
  function fl_InitialiseSIB11() runs on UTRAN_PTC
  {
    var template (value) SysInfoType11 v_SIB11;
    var UTRAN_CellInfo_Type v_CellInfo1 := f_UTRAN_CellInfo_Get(utran34_Cell1);
    var UTRAN_CellInfo_Type v_CellInfo2 := f_UTRAN_CellInfo_Get(utran34_Cell2);
    var UTRAN_CellInfo_Type v_CellInfo3 := f_UTRAN_CellInfo_Get(utran34_Cell3);
    var UTRAN_CellInfo_Type v_CellInfo4 := f_UTRAN_CellInfo_Get(utran34_Cell4);
    var UTRAN_CellInfo_Type v_CellInfo5 := f_UTRAN_CellInfo_Get(utran34_Cell5);
    var UTRAN_CellInfo_Type v_CellInfo6 := f_UTRAN_CellInfo_Get(utran34_Cell6);
    var UTRAN_CellInfo_Type v_CellInfo7 := f_UTRAN_CellInfo_Get(utran34_Cell7);
    var UTRAN_CellInfo_Type v_CellInfo8 := f_UTRAN_CellInfo_Get(utran34_Cell8);
    
    v_SIB11 := cs_SIB11_3Intra_5Inter_FDD(1, v_CellInfo1.cellInfo_Specific_FDD.priScrmCode,
                                          2, v_CellInfo2.cellInfo_Specific_FDD.priScrmCode,
                                          3, v_CellInfo3.cellInfo_Specific_FDD.priScrmCode,
                                          4, v_CellInfo4.frequencyInfo, v_CellInfo4.cellInfo_Specific_FDD.priScrmCode,
                                          5, v_CellInfo5.frequencyInfo, v_CellInfo5.cellInfo_Specific_FDD.priScrmCode,
                                          6, v_CellInfo6.frequencyInfo, v_CellInfo6.cellInfo_Specific_FDD.priScrmCode,
                                          7, v_CellInfo7.frequencyInfo, v_CellInfo7.cellInfo_Specific_FDD.priScrmCode,
                                          8, v_CellInfo8.frequencyInfo, v_CellInfo8.cellInfo_Specific_FDD.priScrmCode);
    
    f_UTRAN_SysInfo_SetSIB11(utran34_Cell1,v_SIB11);
    
    v_SIB11 := cs_SIB11_2Intra_6Inter_FDD(7, v_CellInfo7.cellInfo_Specific_FDD.priScrmCode,
                                          8, v_CellInfo8.cellInfo_Specific_FDD.priScrmCode,
                                          1, v_CellInfo1.frequencyInfo, v_CellInfo1.cellInfo_Specific_FDD.priScrmCode,
                                          2, v_CellInfo2.frequencyInfo, v_CellInfo2.cellInfo_Specific_FDD.priScrmCode,
                                          3, v_CellInfo3.frequencyInfo, v_CellInfo3.cellInfo_Specific_FDD.priScrmCode,
                                          4, v_CellInfo4.frequencyInfo, v_CellInfo4.cellInfo_Specific_FDD.priScrmCode,
                                          5, v_CellInfo5.frequencyInfo, v_CellInfo5.cellInfo_Specific_FDD.priScrmCode,
                                          6, v_CellInfo6.frequencyInfo, v_CellInfo6.cellInfo_Specific_FDD.priScrmCode);
    
    f_UTRAN_SysInfo_SetSIB11(utran34_Cell7, v_SIB11);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 8.3.1.1d
   * @status    APPROVED (UTRAN)
   */
  function f_TC_8_3_1_1d_UTRAN() runs on UTRAN_IP_PTC
  { // Inter-frequency absolute priority based reselection in CELL_FACH (Lower Priority
    var UTRAN_SecurityInfo_Type v_SecurityInfo;
    var UTRAN_CellInfo_Type v_CellInfo;
    
    timer t_WaitForCellUpdate := tsc_IdleMode_GenericTimer_UTRAN;
    
    //Verify that  pixit values are set properly
    if (valueof(cs_U_RNTI_Def) == valueof(cs_U_RNTI1)) {
      FatalError(__FILE__, __LINE__, "Test Case 8.3.1.1d, Please adjust U-RNTI value by changing px_SRNC_Id and px_SRNTI to ensure a different U-RNTI value that is defined for step 7");
    }
    
    //Initialize all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    // Configure cell1
    f_UTRAN_SS_CreateCellFACH(utran34_Cell1);
    
    //Set system information configuration 6 according to TS 34.108 clause 6.1.0a2 to transmit SIB19
    f_UTRAN34_ChangeSysinfoConfiguration(utran34_Cell1, configuration6);
    
    //Configure cell4
    f_UTRAN34_AssignBandAndFrequency(utran34_Cell4);    //@sic R5160943 sic@
    f_UTRAN_SS_CreateCellFACH(utran34_Cell4);
    
    //Configure cell5
    f_UTRAN34_AssignBandAndFrequency(utran34_Cell7, -, true); //@sic R5-163154,R5160943 sic@
    f_UTRAN_SS_CreateCellFACH(utran34_Cell7);
       
    //Set Cell7 to be an inter-frequency cell both to Cell1 and to Cell4
    fl_InitialiseSIB11(); //@sic R5-163154 sic@
    
    //Set FACH measurement occasions in SIB11
    f_UTRAN_SysInfo_SetSIB11_FACHMeasurementOccasionInfo(utran34_Cell1, cs_FACH_MeasurementOccasionInfo_FDD(3,true, omit)); //@sic R5160943 sic@
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell4);
    f_UTRAN34_SendDefSysInfo(utran34_Cell7);
      
    //Configure FACH Measurement Occasions in SS @sic R5s170920 sic@
    f_UTRAN_ConfigFACHMeasOccas(utran34_Cell1, tsc_S_CCPCH1,1,3, true);

    //Set cell power according to T0 in table 8.3.1.1d
    f_UTRAN_SetCellPower(utran34_Cell4, -75);
    f_UTRAN_SetCellPower(utran34_Cell7, -90);
    
    //Steps to set UE to PS-DCCH+DTCH_FACH (state 6-11)
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN34_GoToState6_11_MO(utran34_Cell1);
    
    //.............. T E S T   B O D Y ....................
    
    f_UTRAN_TestBody_Set(true);
    //Set cell power according to T0 in table 8.3.1.1d
    
    //@siclog "Steps 2-3" siclog@
    //Modify SIB19 of cell 1 with following settings: cell 5 set as a higher priority cell and cell 4 set as a lower priority cell. Then notify UE
    f_UTRAN_SysInfoModifySIB19(utran34_Cell1, cs_SIB19_Common(cs_Utra_PriorityInfoList_Common(4, //UtraPriorityValue
                                                                                              8, //S_PrioritySearch1
                                                                                              -,
                                                                                              4, //ThreshServingLow
                                                                                              {cs_UTRAN_FDD_Frequency_Priority(f_UTRAN_CellInfo_GetUARFCN(utran34_Cell7),  //uarfcn
                                                                                                                               5,  //priority
                                                                                                                               10, //threshXhigh
                                                                                                                               5,  //threshXlow
                                                                                                                               -24, //qQualMinFDD
                                                                                                                               -41), //qRxLevMinFDD
                                                                                                  cs_UTRAN_FDD_Frequency_Priority(f_UTRAN_CellInfo_GetUARFCN(utran34_Cell4),  //uarfcn
                                                                                                                                  3,  //priority
                                                                                                                                  10, //threshXhigh
                                                                                                                                  5,  //threshXlow
                                                                                                                                  -24, //qQualMinFDD
                                                                                                                                  -41)}), //ThreshServingLow
                                                              omit,
                                                              omit,
                                                              cs_SIB19_v920NonCriticalExtensions_Params(0, -, -, -, all_layers))); //According to prose p_ThreshServingLow2 should be omitted - equivalent of  default value of 0 (as per TS 36.508)
    
    f_Delay(5.0); //SS waits for 5s to ensure UE reads all the SIB information
    
    //@siclog "Step 4" siclog@
    //SS configures downlink transmission power settings according to columns "T1" in the table 8.3.1.1d
    f_UTRAN_SetCellPower(utran34_Cell1, -65);
    f_UTRAN_SetCellPower(utran34_Cell7, -75);
    
    // Step d)  UE does not reselect to cell 5 or Cell 4 as power levels do not meet the absolute priority cell reselection criteria defined in SIB19
    // Step e)  SS monitors that the UE doesn't send CELL UPDATE on cell 4 or cell 5
    v_CellInfo := f_UTRAN_CellInfo_Get(utran34_Cell1);
    t_WaitForCellUpdate.start;
    alt{
      [] U_TM.receive(car_RRC_CellUpdate(utran34_Cell4,tsc_RB0,?))
        {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.3.1.1d, Step 4 SS monitors that the UE doesn't send CELL UPDATE on cell 4");
          t_WaitForCellUpdate.stop;
        }
      [] U_TM.receive(car_RRC_CellUpdate(utran34_Cell7,tsc_RB0,?))
        {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.3.1.1d, Step 4 SS monitors that the UE doesn't send CELL UPDATE on cell 5");
          t_WaitForCellUpdate.stop;
        }
      [] t_WaitForCellUpdate.timeout
        {
          f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1d, Step 4 UE does not reselect to a higher priority Cell 5 nor to a lower priority cell 4");
        }
    }
    
    //@siclog "Step 5" siclog@
    // Step SS configures the downlink transimission power settings according to columns "T2" from table 8.3.1.1d.
    f_UTRAN_SetCellPower(utran34_Cell1, -80);
    f_UTRAN_SetCellPower(utran34_Cell4, -70);
    f_UTRAN_SetCellPower(utran34_Cell7, -65);
    
    //@siclog "Step 6" siclog@
    // SS waits for "Treselection" time configured in SIB3 and UE should perform reselection to lower priority cell 4 as the absolute priority reselection criteria is met now and UE should not reselect to higher priority cell 5 as the absolute priority reselection criteria is not met
    f_Delay(int2float(v_CellInfo.sysInfo.SIB3.cellSelectReselectInfo.t_Reselection_S));
    // UE sends a CELL UPDATE with cause CELL RESELECTION on cell 4 and SS responds with CELL UPDATE CONFIRM
    U_TM.receive(car_RRC_CellUpdate(utran34_Cell4,tsc_RB0,cr_108_CellUpdate_r10(v_CellInfo.uRNTI, cellReselection)));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1d, Step 6 UE sends a CELL UPDATE with cause - CELL RESELECTION on cell 4");
    
    f_UTRAN34_HO_ReconfFACH_ToFACH(utran34_Cell1, utran34_Cell4); //@sic R5160943 sic@
    
    v_SecurityInfo := f_UTRAN_Security_Get ();
    v_CellInfo := f_UTRAN_CellInfo_Get(utran34_Cell4);
    
    f_UTRAN34_CMAC_New_RNTI_Reconf(utran34_Cell4, v_CellInfo.uRNTI);
    
    //@siclog "Step 7" siclog@
    U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                        tsc_RB1,
                                        cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo, cs_U_RNTI1, tsc_CRNTI1 )));
    
    f_Delay (tsc_DelaySetupFACH); //@sic R5160943 sic@
    f_UTRAN34_CMAC_New_RNTI_Reconf(utran34_Cell4, cs_U_RNTI1, tsc_CRNTI1);
     
    
    v_CellInfo.cRNTI := tsc_CRNTI1;                  // @sic R5s107073 sic@
    v_CellInfo.uRNTI := valueof(cs_U_RNTI1);         // @sic R5s107073 sic@
    f_UTRAN_CellInfo_Set(utran34_Cell4, v_CellInfo); // @sic R5s107073 sic@


    //@siclog "Step 8" siclog@
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,tsc_RB2, cr_108_UTRAN_MobilityInfoCnf(tsc_RRC_TI)));  /* @sic R5-153707 sic@*/
    
    //@siclog "Step 9" siclog@
    f_UTRAN34_RRC_ConnRel (utran34_Cell4, cell_Fach_Dcch);
    
    //.............. E N D   O F   T H E   T E S T   B O D Y ....................
    f_UTRAN_TestBody_Set(false);
    f_UTRAN34_Postamble(utran34_Cell4, U1_IDLE);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
    f_UTRAN_ReleaseCell(utran34_Cell7, f_UTRAN_CellInfo_GetConfigType(utran34_Cell7));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 8.3.1.1e
   * @status    APPROVED (UTRAN)
   */
  function f_TC_8_3_1_1e_UTRAN() runs on UTRAN_IP_PTC
  { // Inter-frequency absolute priority based reselection in CELL_FACH (Higher Priority)
    var UTRAN_SecurityInfo_Type v_SecurityInfo;
    var UTRAN_CellInfo_Type v_CellInfo;
    timer t_WaitForCellUpdate := tsc_IdleMode_GenericTimer_UTRAN;
    
    //Initialize all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    // Configure cell1
    f_UTRAN_SS_CreateCellFACH(utran34_Cell1);
    
    //Set system information configuration 6 according to TS 34.108 clause 6.1.0a2 to transmit SIB19
    f_UTRAN34_ChangeSysinfoConfiguration(utran34_Cell1, configuration6);
    
    //Configure cell4
    f_UTRAN34_AssignBandAndFrequency(utran34_Cell4);  // @sic R5s160945 sic@
    f_UTRAN_SS_CreateCellFACH(utran34_Cell4);
    
    //Configure cell5
    f_UTRAN34_AssignBandAndFrequency(utran34_Cell7, - , true); //@sic R5-163154, @sic R5s160945 sic@
    f_UTRAN_SS_CreateCellFACH(utran34_Cell7);
    
    //Set Cell7 to be an inter-frequency cell both to Cell1 and to Cell4
    fl_InitialiseSIB11(); //@sic R5-163154 sic@
    
    //Set FACH measurement occasions in SIB11
    f_UTRAN_SysInfo_SetSIB11_FACHMeasurementOccasionInfo(utran34_Cell1, cs_FACH_MeasurementOccasionInfo_FDD(3,true, omit)); // @sic R5s160945 sic@
    
    //Send default system information
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell4);
    f_UTRAN34_SendDefSysInfo(utran34_Cell7);
      
    //Configure FACH Measurement Occasions in SS @sic R5s170920 sic@
    f_UTRAN_ConfigFACHMeasOccas(utran34_Cell1, tsc_S_CCPCH1,1,3, true);
    
    //Set cell power according to T0 in table 8.3.1.1e
    f_UTRAN_SetCellPower(utran34_Cell4, -75);
    f_UTRAN_SetCellPower(utran34_Cell7, -90);
    
    //Steps to set UE to PS-DCCH+DTCH_FACH (state 6-11)
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN34_GoToState6_11_MO(utran34_Cell1);
    
    //.............. T E S T   B O D Y ....................
    
    f_UTRAN_TestBody_Set(true);
    
    //@siclog "Steps 2-3" siclog@
    //Modify SIB19 of cell 1 with following settings: cell 5 set as a higher priority cell and cell 4 set as a lower priority cell. Then notify UE
    f_UTRAN_SysInfoModifySIB19(utran34_Cell1, cs_SIB19_Common(cs_Utra_PriorityInfoList_Common(4, //UtraPriorityValue
                                                                                              8, //S_PrioritySearch1
                                                                                              -,
                                                                                              4, //ThreshServingLow
                                                                                              {cs_UTRAN_FDD_Frequency_Priority(f_UTRAN_CellInfo_GetUARFCN(utran34_Cell7),  //uarfcn
                                                                                                                               5,  //priority
                                                                                                                               5, //threshXhigh
                                                                                                                               1,  //threshXlow
                                                                                                                               -24, //qQualMinFDD
                                                                                                                               -41), //qRxLevMinFDD
                                                                                                  cs_UTRAN_FDD_Frequency_Priority(f_UTRAN_CellInfo_GetUARFCN(utran34_Cell4),  //uarfcn
                                                                                                                                  3,  //priority
                                                                                                                                  5, //threshXhigh
                                                                                                                                  1,  //threshXlow
                                                                                                                                  -24, //qQualMinFDD
                                                                                                                                  -41)}), //ThreshServingLow
                                                              omit,
                                                              omit,
                                                              cs_SIB19_v920NonCriticalExtensions_Params(0, -, -, -, high_priority_layers))); // @sic R5s160945 sic@ According to prose p_ThreshServingLow2 should be omitted - equivalent of  default value of 0 (as per TS 36.508)
    
    f_Delay(5.0); //SS waits for 5s to ensure UE reads all the SIB information
    
    //@siclog "Step 4" siclog@
    //SS configures downlink transmission power settings according to columns "T1" in the table 8.3.1.1e
    f_UTRAN_SetCellPower(utran34_Cell4, -65);
    f_UTRAN_SetCellPower(utran34_Cell7, -80);
    
    // UE does not reselect to cell 4 or cell 5 as power levels do not meet the absolute priority cell reselection criteria defined in SIB19
    // SS monitors that the UE doesn't send CELL UPDATE on cell 4 or cell 5
    v_CellInfo := f_UTRAN_CellInfo_Get(utran34_Cell1);
    
    t_WaitForCellUpdate.start;
    alt{
      [] U_TM.receive(car_RRC_CellUpdate(utran34_Cell4,tsc_RB0,?))
        {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.3.1.1e, Step 4 SS monitors that the UE doesn't send CELL UPDATE on cell 4");
          t_WaitForCellUpdate.stop;
        }
      [] U_TM.receive(car_RRC_CellUpdate(utran34_Cell7,tsc_RB0,?))
        {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.3.1.1e, Step 4 SS monitors that the UE doesn't send CELL UPDATE on cell 5");
          t_WaitForCellUpdate.stop;
        }
      [] t_WaitForCellUpdate.timeout
        {
          f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1e, Step 4 UE does not reselect to a higher priority Cell 5 nor to a lower priority cell 4");
        }
    }
    
    //@siclog "Step 5" siclog@
    // SS configures the downlink transimission power settings according to columns "T2" from table 8.3.1.1e.
    f_UTRAN_SetCellPower(utran34_Cell4, -60);
    f_UTRAN_SetCellPower(utran34_Cell7, -62);
    
    //@siclog "Step 6" siclog@
    // SS waits for "Treselection" time configured in SIB3 and UE should perform reselection to higher priority cell 5 as the absolute priority reselection criteria is met now
    f_Delay(int2float(v_CellInfo.sysInfo.SIB3.cellSelectReselectInfo.t_Reselection_S));
    //UE sends a CELL UPDATE with cause CELL RESELECTION on cell 5 and SS responds with CELL UPDATE CONFIRM
    U_TM.receive(car_RRC_CellUpdate(utran34_Cell7,tsc_RB0,cr_108_CellUpdate_r10(v_CellInfo.uRNTI, cellReselection)));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1e, Step 6 UE sends a CELL UPDATE with cause - CELL RESELECTION on cell 5");
    
    f_UTRAN34_HO_ReconfFACH_ToFACH(utran34_Cell1,utran34_Cell7); //@sic 160945 sic@
    
    v_SecurityInfo := f_UTRAN_Security_Get();
    v_CellInfo := f_UTRAN_CellInfo_Get(utran34_Cell7);
    f_UTRAN34_CMAC_New_RNTI_Reconf(utran34_Cell7, v_CellInfo.uRNTI);
    
    //@siclog "Step 7" siclog@
    // New C-RNTI and U-RNTI identities are assigned to the UE. IE "RRC State Indicator" is set to "CELL_FACH".
    U_UM.send(cas_RRC_CellUpdateCnfDCCH(utran_CellDedicated,
                                        tsc_RB1,
                                        cs_108_CellUpdateCnf_r8(v_SecurityInfo.dl_IntegrityCheckInfo, cs_U_RNTI1, tsc_CRNTI1)));
    f_Delay (tsc_DelaySetupFACH); //@sic 160945 sic@
    f_UTRAN34_CMAC_New_RNTI_Reconf(utran34_Cell7, cs_U_RNTI1, tsc_CRNTI1);
      
    v_CellInfo.cRNTI := tsc_CRNTI1;                  // @sic R5s170073 sic@
    v_CellInfo.uRNTI := valueof(cs_U_RNTI1);         // @sic R5s170073 sic@
    f_UTRAN_CellInfo_Set(utran34_Cell7, v_CellInfo); // @sic R5s170073 sic@

    
    //@siclog "Step 8" siclog@
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,tsc_RB2, cr_108_UTRAN_MobilityInfoCnf(tsc_RRC_TI)));
    
    //@siclog "Step 9" siclog@
    f_UTRAN34_RRC_ConnRel (utran34_Cell7, cell_Fach_Dcch);
    
    //.............. E N D   O F   T H E   T E S T   B O D Y ....................
    f_UTRAN_TestBody_Set(false);
    f_UTRAN34_Postamble(utran34_Cell7, U1_IDLE);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
    f_UTRAN_ReleaseCell(utran34_Cell4, f_UTRAN_CellInfo_GetConfigType(utran34_Cell4));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 8.3.1.1f
   * @status    APPROVED (UTRAN)
   */
  function f_TC_8_3_1_1f_UTRAN() runs on UTRAN_IP_PTC
  { // Inter-frequency reselection to a no priority layer when NW and UE supports absolute priority in CELL_FACH
    
    //Initialize all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    //Set Cell4 to be an inter-frequency cell to Cell1
    fl_InitialiseSIB11(); // @sic R5s170071 sic@
    
    // Configure Cell1
    fl_ConfigureCell_8_3_1_1f(utran34_Cell1);
    //Cell2 is mapped to Cell4
    
    f_UTRAN34_AssignBandAndFrequency(utran34_Cell4);  //@sic R5s170071 sic@
    fl_ConfigureCell_8_3_1_1f(utran34_Cell4);
    
    
    //Adjust power of Cell 4
    f_UTRAN_SetCellPower(utran34_Cell4, -69);
    
    //Steps to set UE to PS-DCCH+DTCH_FACH (state 6-11)
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN34_GoToState6_11_MO(utran34_Cell1);
    
    //.............. T E S T   B O D Y ....................
    
    f_UTRAN_TestBody_Set(true);
    
    //Step 1. The UE is in the CELL_FACH state in cell 1
    // Step 2. SS applies the downlink transmission power settings, according to the values in columns "T1" of table 8.3.1.1.
    fl_SwapPowerLevels(utran34_Cell1, utran34_Cell4);
    
    // Steps 3-4. The UE shall find cell 2 to be more suitable for service and hence perform a cell reselection.
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell1, utran34_Cell4, cell_FACH, omit);    //no new C-RNTI
    
    // Steps 4a-4b . UE shall verify that IE "New C-RNTI" is not included in the downlink message and shall send a CELL UPDATE message to SS again
    //  SS respond with a CELL UPDATE CONFIRM message which includes a valid IE "New C-RNTI".
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell1, utran34_Cell4, cell_FACH, tsc_CRNTI1,-,-,false, tsc_RRC_TI_1); //@sic R5s170071 sic@
    
    //Step 5. SS verifies that the UE send UTRAN MOBILITY INFORMATION CONFIRM message
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,tsc_RB2, cr_108_UTRAN_MobilityInfoCnf(tsc_RRC_TI_1))); // @sic R5s170071 sic@
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1f, Step 5");
    
    //Step 6. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell4, utran34_Cell1);
    
    //Steps 7-8 Cell update procedure. New C-RNTI and U-RNTI identities are assigned to the UE. IE "RRC State Indicator" is set to "CELL_FACH".
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell4, utran34_Cell1, cell_FACH, tsc_CRNTI2, cs_U_RNTI1);
    
    //Step 9. SS verifies that the UE send UTRAN MOBILITY INFORMATION CONFIRM message
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,tsc_RB2, cr_108_UTRAN_MobilityInfoCnf(tsc_RRC_TI)));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1f, Step 9");
    
    //Step 10. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell1, utran34_Cell4);
    
    //Steps 11-12a. Cell update procedure. IE "RRC State Indicator" is set to "CELL_DCH". IE "Physical channel information elements" is included in this message
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell1, utran34_Cell4, cell_DCH, omit, omit, phyChanIEs);
    
    //Step 13-14. The UE is in CELL_DCH now. The SS shall send PHYSICAL CHANNEL RECONFIGURATION message to the UE asking the UE to transit to CELL_FACH state.
    //UE responds with  PHYSICAL CHANNEL RECONFIGURATION COMPLETE message
    fl_PhyChReconfigDCH_ToFACH(utran34_Cell4, tsc_CRNTI1); //@sic R5s170071 sic@
    
    //Step 15. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell4, utran34_Cell1);
    
    //Steps 16-18. Cell update procedure. IE "Physical channel information elements" is included in this message, and IE "RRC State Indicator" is set to "CELL_DCH". IE "Transport channel information elements" is included in this message
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell4, utran34_Cell1, cell_DCH, omit, omit, trChanIEs);
    
    //Step 19-20. The UE is in CELL_DCH now. The SS shall send PHYSICAL CHANNEL RECONFIGURATION message to the UE asking the UE to transit to CELL_FACH state.
    //UE responds with  PHYSICAL CHANNEL RECONFIGURATION COMPLETE message
    fl_PhyChReconfigDCH_ToFACH(utran34_Cell1, tsc_CRNTI2);
    
    //Step 21. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell1, utran34_Cell4);
    
    //Steps 22-24. Cell update procedure. New C-RNTI identity is assigned to the UE. IE "RRC State Indicator" is set to "CELL_FACH".
    //IE "RB information to reconfigure list" and IE "RB information to be affected list" is included in this message.
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell1, utran34_Cell4, cell_FACH, tsc_CRNTI1, omit, recfgRBsIEs);
    
    //Step 25. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell4, utran34_Cell1);
    
    //Step 26-28
    //The UE shall send a CELL UPDATE message on the uplink CCCH of cell 1. SS replies with a CELL UPDATE CONFIRM message which contains IE "RB information to release list". The UE shall send RADIO BEARER RELEASE COMPLETE message.
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell4, utran34_Cell1, cell_FACH, tsc_CRNTI2, omit, releaseRBsIEs);
    
    //Step 29. SS reverses the transmission power level of cell 1 and cell 4
    fl_SwapPowerLevels(utran34_Cell1, utran34_Cell4);
    
    //Steps 30-30b The UE shall send a CELL UPDATE message on the uplink CCCH of cell 4. New C-RNTI identity is assigned to the UE.
    fl_TC_8_3_1_1f_CellReselectionProcedure(utran34_Cell1, utran34_Cell4, cell_FACH, tsc_CRNTI, omit);
    U_AM.receive(car_RLC_Data_Ind(utran_CellDedicated,tsc_RB2, cr_108_UTRAN_MobilityInfoCnf(tsc_RRC_TI)));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case  8.3.1.1f, Step 30a");
    
    //Step 35. If the test result of C.2 indicates that UE is in CELL_FACH state, the test passes, otherwise it fails.
    f_UTRAN34_RRC_ConnRel(utran34_Cell4, cell_Fach_Dcch, true);    //@sic R5s170071 sic@
    
    //.............. E N D   O F   T H E   T E S T   B O D Y ....................
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble (utran34_Cell4, U1_IDLE);    //@sic R5s170071 sic@
    f_UTRAN_ReleaseCell (utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));  //@sic R5s170071 sic@
  }

}
