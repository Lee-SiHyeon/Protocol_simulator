  const charstring tsc_MCX_MIME_Boundary := "MCX-MIME-Boundary--";              /* @status    APPROVED (MCX) */

  type record MCX_MIME_XmlBodies_Type {                                         /* @status    APPROVED (MCX) */
    MCPTT_Info_Type                     McpttInfo         optional,
    McpttInfoExt_ElementList_Type       McpttInfoExt      optional,
    MCVideo_Info_Type                   McvideoInfo       optional,
    McvideoInfoExt_ElementList_Type     McvideoInfoExt    optional,
    MCData_Info_Type                    McdataInfo        optional,
    McdataInfoExt_ElementList_Type      McdataInfoExt     optional,
    MCPTT_LocationInfo_Type             McpttLocationInfo optional,
    MCVideo_LocationInfo_Type           McvideoLocationInfo optional,
    MCData_LocationInfo_Type            McdataLocationInfo optional,
    ResourceLists_Type                  ResourceLists     optional,
    MCX_SimpleFilter_Type               SimpleFilter      optional,
    MCX_PIDF_Type                       PIDF              optional,
    MCX_Affiliation_CommandList_Type    AffiliationCmd    optional,             /* NOTE: schemata for MCPTT, MCVideo and MCData are effectively the same => urn_3gpp_ns_affiliationCommand_1_0 is used for all services
                                                                                 *       => MCX_Affiliation_CommandList_Type is common for MCPTT, MCVideo and MCData */
    PocSettings_Type                    PocSettings       optional
  };

  template (value) MCX_MIME_XmlBodies_Type cs_MCX_MIME_XmlBodies_AllOmit :=
  { /* @status    APPROVED (MCX) */
    McpttInfo         := omit,
    McpttInfoExt      := omit,
    McvideoInfo       := omit,
    McvideoInfoExt    := omit,
    McdataInfo        := omit,
    McdataInfoExt     := omit,
    McpttLocationInfo := omit,
    McvideoLocationInfo := omit,
    McdataLocationInfo := omit,
    ResourceLists     := omit,
    SimpleFilter      := omit,
    PIDF              := omit,
    AffiliationCmd    := omit,
    PocSettings       := omit
  };

  /*
   * @desc      Get body part for SDP message, decode and match the SDP message
   * @param     p_MIME_Message
   * @param     p_SdpTemplate
   * @return    template (omit) SDP_Message
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_DecodeMatchAndCheckSDP(MIME_Message p_MIME_Message,
                                             template SDP_Message p_SdpTemplate) runs on IMS_PTC return template (omit) SDP_Message
  {
    var boolean v_IsRequired := ispresent(p_SdpTemplate);
    var template (omit) MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, c_sdpApplication, v_IsRequired);  // => fail/inconc if MIME part is not there but required
    var SdpBody v_SdpBody;
    var SDP_Message v_SDP_Message;

    if (isvalue(v_MIME_Part)) {
      v_SdpBody := valueof(v_MIME_Part.body.sdpMessageBody);
      v_SDP_Message := f_IMS_SIP_DecodeMatchAndCheckSDP(v_SdpBody, p_SdpTemplate);                /* => FAIL if v_SdpTemplate=omit */
      return v_SDP_Message;
    }
    return omit;
  }

  /*
   * @desc      Get body part for MCPTT info, decode and match the MCPTT info
   * @param     p_MIME_Message
   * @param     p_McpttInfo
   * @param     p_MCServiceID
   * @param     p_CSK               (default value: omit)
   * @return    template (omit) MCPTT_Info_Type
   * @status    APPROVED (MCX)
   */
  function fl_MIME_DecodeAndMatchMcpttInfo(MIME_Message p_MIME_Message,
                                           template MCPTT_Info_Type p_McpttInfo,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK := omit) runs on IMS_PTC return template (omit) MCPTT_Info_Type
  {
    var boolean v_IsRequired := ispresent(p_McpttInfo);
    var template (omit) MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, tsc_MimeType_McpttInfo, v_IsRequired);  // => fail/inconc if MIME part is not there but required
    var XmlBody v_XmlBody;
    var MCPTT_Info_Type v_McpttInfo;
    
    if (isvalue(v_MIME_Part)) {
      v_XmlBody := valueof(v_MIME_Part.body.xmlBody);
      v_McpttInfo := f_MCX_MCPTTInfo_DecryptDecode(v_XmlBody, p_MCServiceID, p_CSK);
      if (not match(v_McpttInfo, p_McpttInfo)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid MCPTT-Info in MIME body");
      }
      return v_McpttInfo;
    }
    return omit;
  }

