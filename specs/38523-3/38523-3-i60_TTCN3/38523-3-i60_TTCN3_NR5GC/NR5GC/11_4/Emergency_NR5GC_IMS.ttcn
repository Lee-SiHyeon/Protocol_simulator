module Emergency_NR5GC_IMS {

  import from IMS_Component all;
  import from IMS_NR5GC_Functions all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.1.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_1_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    // The test case currently sets up 1 IMS Emg Call in Normal service
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndRelease();
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.2.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_4_2_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndReleaseWithoutRegistration();
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.3.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_3_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndReleaseWithoutRegistration();
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.4.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_4_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    var integer i;
    var integer v_MaxEmgCalls := 2;    // The test case currently sets up 2 IMS Emg Call in Normal service
    
    f_IMS_PTC_Init(PDN_2);

    for (i:=0; i < v_MaxEmgCalls; i:=i+1) {
      f_IMS_EmergencyCallAndRelease();
    }
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.5.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_4_5_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndReleaseWithoutRegistration(); //@sic R5s210875, R5s211306 sic@

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.6.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_6_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndRelease(); //@sic R5s211306 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.7.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_7_NR5GC_IMS1()runs on IMS_PTC
  { // Initial PDU session - for e.g Registration and 'normal' calls
    var integer v_MaxMOCalls := 5; //5 IMS MO calls to be initiated
    var template (present) SipUrl v_OtherCalleeUri := cr_SipUrl_Common((c_sipScheme, c_telScheme), ?); // @sic R5s210603 sic@
    var integer i;
    
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    for (i:=0; i< v_MaxMOCalls; i:=i+1) {
      f_IMS_NR5GC_MOSpeechCallAndRelease(v_OtherCalleeUri);  // @sic R5s210603 sic@
    }

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.7.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_7_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    var integer i;
    var integer v_MaxEmgCalls := 9;    // The test case currently sets up 9 IMS Emg Call in Normal service
    
    f_IMS_PTC_Init(PDN_2);

    for (i:=0; i < v_MaxEmgCalls; i:=i+1) {
      f_IMS_EmergencyCallAndRelease();
    }
 }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.8.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_8_NR5GC_IMS1()runs on IMS_PTC
  { // Initial PDU session - for e.g Registration and 'normal' calls
    var integer v_MaxMOCalls := 2; //2 IMS MO calls to be initiated
    var template (present) SipUrl v_OtherCalleeUri := cr_SipUrl_Common((c_sipScheme, c_telScheme), ?); // @sic R5s210603 sic@
    var integer i;
    
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @sic R5s210810 sic@
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    f_IMS_GlobalRelease();
    
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    for (i:=0; i< v_MaxMOCalls; i:=i+1) {
      f_IMS_NR5GC_MOSpeechCallAndRelease(v_OtherCalleeUri);
    }

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.8.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_8_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    var integer i;
    var integer v_MaxEmgCalls := 10 + 20;
    
    f_IMS_PTC_Init(PDN_2);

    for (i:=0; i < v_MaxEmgCalls; i:=i+1) {
      f_IMS_EmergencyCallAndRelease();
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.9.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_4_9_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndReleaseWithoutRegistration(); //@sic R5s211323 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.14.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_14_NR5GC_IMS2()runs on IMS_PTC
  { //5GMM-REGISTERED.NORMAL-SERVICE / 5GMM-IDLE / Emergency call /Deregistration upon emergency registration expiration
    //@sic R5-227446 sic@
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_2);
    
    f_IMS_EmergencyRegistration(-, "30000", IPCAN_E);
    f_IMS_EmergencyCallSetup_NR5GC_A_6(A_2_1_A7); // @sic R5s230350 sic@
    // Inform NR: Emergency Call established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Trigger MT Call Release");

    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrlUE);
    //Tell NR that call is released
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.1a.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_4_1a_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    
    //@sic R5s250341 sic@
    var SipUrl v_ContactUrlUE;
    
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyRegistration(-, -, IPCAN_E);
    f_IMS_EmergencyCallSetup_NR5GC_A_6(A_2_1_A7);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));
    // step 24 initiate MT call release
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));

  }

}
