module Common4G5G {

  import from CommonDefs all;

  type record EUTRA_NR_PduSessionInfo_Type  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, UTRAN) */
  {
    integer PDU_SessionId,
    integer EPS_Bearer,    // @sic R5s201094 sic@
    integer QFI         optional,  // @sic R5s220883 sic@
    PDU_PDN_DNN_Type PdnType,        // @sic R5-245495 sic@
    PDN_Index_Type PdnIndex,
    boolean IsIMS
  };

  group NTN_Common_Types {

        type enumerated NTN_ScenarioUnderTest {GSO, NGSO}; /* @status    APPROVED (ENDC, IMS, NBIOT, NR5GC, NR5GC_IRAT, POS) */

        type record NTN_CellInfo_Type { /* @status    APPROVED (ENDC, IMS, NBIOT, NR5GC, NR5GC_IRAT, POS) */
            integer NtnCellType  (1..3) /* value 1 corresponds to cell type "First",
                                   * value 2 corresponds to cell type "Second",
                                   * value 3 corresponds to cell type "Third" as defined in  36.508 Tables 6.3.5.1-1/6.3.5.2-1 and 38.508-1 Tables 6.3.4.1-1/6.3.4.2-1 @sic R5-237126, R5w240105r1 sic@ */
  }

  } // end of group NTN_Common_Types

}
