    revokeMessage := {
      commonHdr := cs_FloorControl_CommonHdr('00110'B, p_RTCP_SSRC_SS),         // Revoke subtype 24.380 clause 8.2.2.1
      rejectCause := fl_FloorControl_RejectCause(p_RejectCause, p_RejectPhrase),
      trackInfo := omit,
      floorIndicator := cs_FloorControl_FloorIndicator(p_FloorInd)
    }
  };

  template (present) FloorControlMsg_Type cr_FloorCtrlMsg_QueuePositionRequest(template (present) RTP_SSRC p_RTCP_SSRC_UE) :=
  { // 36.579-1 clause 5.5.6.9
    /* @status    APPROVED (MCX) */
    queuePositionRequestMessage := {
      commonHdr := cr_FloorControl_CommonHdr('01000'B, p_RTCP_SSRC_UE),         // Queue Info Request subtype 24.380 clause 8.2.2.1
      userId := omit,
      trackInfo := omit
    }
  };

  template (value) FloorControlMsg_Type cs_FloorCtrlMsg_QueuePositionInfo(RTP_SSRC p_RTCP_SSRC_SS,
                                                                          B16_Type p_FloorInd,
                                                                          MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) :=
  { // 36.579-1 Table 5.5.6.10-1
    /* @status    APPROVED (MCX) */
    queuePositionInfoMessage := {
      commonHdr := cs_FloorControl_CommonHdr(f_MCX_MediaControlSubtype_TX('01001'B, p_AckRequest), p_RTCP_SSRC_SS),        // QueuePositionInfo subtype 24.380 clause 8.2.2.1
      userId := omit,                           // @sic R5s210779 - additional change: omit sic@
      ssrcQueuedParticipant := omit,            // @sic R5s210779 - additional change: omit sic@
      queuedUserId := omit,
      queueInfo := cs_FloorControl_QueueInfo('01'O, '00'O),
