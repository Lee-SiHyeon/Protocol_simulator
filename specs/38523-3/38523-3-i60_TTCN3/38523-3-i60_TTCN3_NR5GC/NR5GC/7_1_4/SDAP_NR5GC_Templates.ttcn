module SDAP_NR5GC_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_DRB_Data all;
  import from SDAP_TypeDefs all;

  type SDAP_Config.sdap_HeaderDL Sdap_HeaderDL_Type;   /* @status    APPROVED (NR5GC) */

  type SDAP_Config.sdap_HeaderUL Sdap_HeaderUL_Type;   /* @status    APPROVED (NR5GC) */

  const B6_Type tsc_QFI2 := '000010'B;   /* @status    APPROVED (NR5GC) */

  const B6_Type tsc_QFI4 := '000100'B;   /* @status    APPROVED (NR5GC) */

  const B6_Type tsc_QFI5 := '000101'B;   /* @status    APPROVED (NR5GC) */

  const B1_Type tsc_RDI0 := '0'B;        /* @status    APPROVED (NR5GC) */

  const B1_Type tsc_RDI1 := '1'B;        /* @status    APPROVED (NR5GC) */

  const B1_Type tsc_RQI0 := '0'B;        /* @status    APPROVED (NR5GC) */

  template (value) SdapTransparentMode_Type cs_SdapTransparentMode_HeaderUL(SDAP_Header_Type p_HeaderUL):=
  { /* @status    APPROVED (NR5GC) */
    Sdap_HeaderUL := p_HeaderUL //@sic R5s191119 sic@
  }

  template (value) SDAP_Configuration_Type cs_SDAP_ConfigTransparentMode(SDAP_Header_Type p_HeaderUL := Absent) :=
  { /* @status    APPROVED (NR5GC) */
    Config := {
      TransparentMode := cs_SdapTransparentMode_HeaderUL(p_HeaderUL)  //@sic R5s191119 sic@
    }
  };

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_SDAP_PDUList(NR_CellId_Type p_NR_CellId,
                                                                        DRB_Identity p_DrbId,
                                                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                        template (value) SDAP_PDUList_Type p_SDAP_PDUList,
                                                                        template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                        integer p_SlotOffset := 0) :=
    /* @status    APPROVED (NR5GC) */
    cas_NR_DRB_COMMON_REQ_DataPerSlot(p_NR_CellId, p_DrbId, p_TimingInfo, {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, p_HarqProcess, cs_NR_L2DataList_SdapPdu(p_SDAP_PDUList))} );

  template (value) NR_L2DataList_Type cs_NR_L2DataList_SdapPdu(template (value) SDAP_PDUList_Type p_PDUList) := { SdapPdu := p_PDUList };  /* @status    APPROVED (NR5GC) */

  template (value) SDAP_DL_PduHeader_Type cs_SDAP_DL_PduHeader(B1_Type p_Rdi,
                                                               B1_Type p_Rqi,
                                                               B6_Type p_Qfi) :=
  { /* @status    APPROVED (NR5GC) */
    RDI := p_Rdi,
    RQI := p_Rqi,
    QFI := p_Qfi
  };

  template (value) SDAP_PDU_Type cs_SDAP_PDU_DL_Common(template (omit) SDAP_DL_PduHeader_Type p_SDAP_DL_Header,
                                                       template (value) SDAP_SDU_Type p_SDAP_SDU) :=
  { /* @status    APPROVED (NR5GC) */
    DL := {
      Header := p_SDAP_DL_Header,
      Data := p_SDAP_SDU
    }
  };

  template (value) SDAP_PDU_Type cs_SDAP_PDU_DL_WithHeader(template (omit) SDAP_DL_PduHeader_Type p_SDAP_DL_Header,
                                                           template (value) SDAP_SDU_Type p_SDAP_SDU) :=
    /* @status    APPROVED (NR5GC) */
    cs_SDAP_PDU_DL_Common(p_SDAP_DL_Header, p_SDAP_SDU);

  template (value) SDAP_PDU_Type cs_SDAP_PDU_DL_NoHeader(template (value) SDAP_SDU_Type p_SDAP_SDU) :=
    /* @status    APPROVED (NR5GC) */
    cs_SDAP_PDU_DL_Common(omit, p_SDAP_SDU);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_SDAP_PDUList(NR_CellId_Type p_NR_CellId,
                                                                          template (present) DRB_Identity p_DrbId,
                                                                          template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                          template (present) SDAP_PDUList_Type p_SDAP_PDUList := ?) :=
    /* @status    APPROVED (NR5GC) */
    car_NR_DRB_COMMON_IND(p_NR_CellId, p_DrbId, p_TimingInfo, cr_NR_L2DataList_SdapPdu(p_SDAP_PDUList));

  template (present) NR_L2DataList_Type cr_NR_L2DataList_SdapPdu(template (present) SDAP_PDUList_Type p_PDUList) := { SdapPdu := p_PDUList }; /* @status    APPROVED (NR5GC) */

  template (present) SDAP_PDU_Type cr_SDAP_PDU_UL_Common(template (omit) SDAP_UL_PduHeader_Type p_SDAP_UL_Header,
                                                         template (omit) SDAP_SDU_Type p_SDAP_Sdu) :=
  { /* @status    APPROVED (NR5GC) */
    UL := {
      Header := p_SDAP_UL_Header,
      Data := p_SDAP_Sdu
    }
  };

  template (present) SDAP_UL_PduHeader_Type cr_SDAP_UL_PduHeader(B1_Type p_DC,
                                                                 B6_Type p_Qfi) :=
  { /* @status    APPROVED (NR5GC) */
    DC := p_DC,
    R := '0'B, //reserved
    QFI := p_Qfi
  };

  template (present) SDAP_UL_PduHeader_Type cr_SDAP_UL_PduHeader_Data(B6_Type p_Qfi) :=
    /* @status    APPROVED (NR5GC) */
    cr_SDAP_UL_PduHeader('1'B, p_Qfi);

  template (present) SDAP_UL_PduHeader_Type cr_SDAP_UL_PduHeader_Control(B6_Type p_Qfi) :=
    /* @status    APPROVED (NR5GC) */
    cr_SDAP_UL_PduHeader('0'B, p_Qfi);

  template (present) SDAP_PDU_Type cr_SDAP_PDU_UL_WithHeader(template (omit) SDAP_UL_PduHeader_Type p_SDAP_UL_Header,
                                                             template (omit) SDAP_SDU_Type p_SDAP_Sdu) :=
    /* @status    APPROVED (NR5GC) */
    cr_SDAP_PDU_UL_Common(p_SDAP_UL_Header, p_SDAP_Sdu);

  template (present) SDAP_PDU_Type cr_SDAP_PDU_UL_NoHeader(template (omit) SDAP_SDU_Type p_SDAP_Sdu) :=
    /* @status    APPROVED (NR5GC) */
    cr_SDAP_PDU_UL_Common(omit, p_SDAP_Sdu);

  template (present) SDAP_PDU_Type cr_SDAP_PDU_UL_EndMarker(B6_Type p_Qfi) :=
    /* @status    APPROVED (NR5GC) */
    cr_SDAP_PDU_UL_Common(cr_SDAP_UL_PduHeader_Control(p_Qfi), omit);

  template (value) SDAP_Config cs_SDAP_Config_Sdap(PDU_SessionID p_PDUSessionId,
                                                   Sdap_HeaderDL_Type p_HeaderDL,
                                                   Sdap_HeaderUL_Type p_HeaderUL,
                                                   boolean p_DefaultDRB,
                                                   template (omit) QFI_List_Type p_QoSFlowList := omit) :=
  { /* @status    APPROVED (NR5GC) */
    pdu_Session                := p_PDUSessionId,
    sdap_HeaderDL              := p_HeaderDL,
    sdap_HeaderUL              := p_HeaderUL,
    defaultDRB                 := p_DefaultDRB,
    mappedQoS_FlowsToAdd       := p_QoSFlowList,
    mappedQoS_FlowsToRelease   := omit
  };

}
