module NR_RLC_Common {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from L2_Common4G5G all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_L2_Common all;
  import from NR_NTN_Configuration all;
  import from NR_RRC_Templates all;

  const NR_RLC_SegmentationInfo_Type tsc_NR_SI_StartOfSDU := '01'B;     /* @desc     Value to indicate that PDU contains the starting part of an SDU.
                                                                         *           3Ref 3G TS 8.322 cl 6.2.3.4: Segmentation Info (SI) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  const NR_RLC_SegmentationInfo_Type tsc_NR_SI_EndOfSDU := '10'B;       /* @desc     Value to indicate that PDU contains the ending part of an SDU.
                                                                         *           Ref 3G TS 38.322 cl 6.2.3.4: Segmentation Info (SI) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  const NR_RLC_SegmentationInfo_Type tsc_NR_SI_SegmentOfSDU := '11'B;   /* @desc     Value to indicate that PDU contains the Data field contains neither the first nor last segment of an RLC SDU.
                                                                         *           Ref 3G TS 38.322 cl 6.2.3.4: Segmentation Info (SI) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.ul_AM_RLC.t_PollRetransmit     UL_t_PollRetransmit_Type;    /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.dl_AM_RLC.t_Reassembly         DL_t_Reassembly_Type;        /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.ul_AM_RLC.sn_FieldLength       UL_sn_FieldLength_Type;      /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.ul_AM_RLC.pollPDU              UL_pollPDU_Type;             /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.ul_AM_RLC.pollByte             UL_pollByte_Type;            /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.ul_AM_RLC.maxRetxThreshold     UL_maxRetxThreshold_Type;    /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.dl_AM_RLC.sn_FieldLength       DL_sn_FieldLength_Type;      /* @status    APPROVED (ENDC, NR5GC) */

  type RLC_Config.am.dl_AM_RLC.t_StatusProhibit     DL_t_StatusProhibit_Type;    /* @status    APPROVED (ENDC, NR5GC) */

  type octetstring NR_RLC_DataField_Type;                                         /* @status    APPROVED (ENDC, NR5GC) */

  type record of NR_RLC_DataField_Type NR_RLC_DataFieldList_Type;                 /* @status    APPROVED (ENDC, NR5GC) */

  type record NR_RLC_SS_State_Type {      /* @desc      Describes the state (state variables, counters) of simulated RLC NR entity within the tester
                                           *            Relevant variables are to be initialized with the default values from 38.508
                                           * @status    APPROVED (ENDC, NR5GC) */
    /* built by adapting RLC_SS_State from legacy LTE
     * converted items as per 38.522
     * currently unused items are commented, may be deleted later (after GTCs)
     */
    // RLC AM state variables, see 38.322 cl. 7.1
    integer AM_TX_Next,   // Send state variable TX_Next; previous VT(S)
    integer AM_RX_Next_Ack,// Acknowledgement state variable; previous  VT(A) - as seen by the SS
    // determines Maximum send state variable VT(MS)
    integer AM_RX_Next,   // Receive state variable; previous  VR(R)
    // determines Maximum send state variable VR(MR)
    //    integer AM_VRX,       // t_Reordering state variable VR(X)
    //    integer AM_VRMS,      // Maximum STATUS transmit state variable VR(MS)
    //    integer AM_VRH,       // Highest received state variable VR(H)
    // RLC UM state variables, see 36.322 cl. 7.1
    integer UM_TX_Next,      // UM Send state variable; previous VT(US)
    integer UM_RX_Next,// UM receive state variable; previous VR(R)
    //    integer UM_VRUX,      // UM t_Reordering state variable VR(UX)
    //    integer UM_VRUH,      // UM highest received state variable VR(UH)
    // Timers, see 36.322 cl. 7.3
    float t_PollRetransmit,   // t_PollRetransmit
    //    float t_PollRetransmit_r13,   // t_PollRetransmit-r13 (for NBIoT)
    float t_Reassembly,       // t_Reassembly
    float t_ReassemblyExt_r17,// t_ReassemblyExt_r17
    float t_StatusProhibit,   // t_StatusProhibit
    // Configurable parameters, see 36.322 cl. 7.4
    integer maxRetxThreshold, // maxRetxThreshold
    //    integer maxRetxThreshold_r13, // maxRetxThreshold-r13 (for NBIoT)
    integer pollPDU,          // pollPDU
    integer pollByte,         // pollByte
    // Other configurable parameters
    integer UM_SN_Size,    // 6 or 12, see 38.322 cl. 6.2.2.3
    integer AM_SN_Size,    // 12 or 18, see 38.322 cl. 6.2.2.4
    // other variables
    SubFrameTiming_Type TimeStampLastReceivedPDU,
    integer LastSNReceived,
    integer TxPRBS_Pos,
    integer RxPRBS_Pos,
    integer TxDataSize,
    integer RxDataSize,
    // PDCP state variables, see 38.323 cl. 7.1
    integer PDCP_TX_Next,  // indicates the PDCP sequence number of the next PDCP SDU; previous  Next_PDCP_TX_SN
    integer PDCP_RX_Next,  // indicates the next expected PDCP sequence number; previous  Next_PDCP_RX_SN
    //  PDCP36.509 state variables, see 36.509 cl. 7.4
    integer UL_PDCP_SDU_size   // UL PDCP SDU size for returned UL PDCP SDUs
  };

  template (value) NR_RLC_SS_State_Type cs_NR_RLC_SS_State :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to initialize RLC record  */
    // @sic R5s190906 ch. 1 sic@
    AM_TX_Next := 0,
    AM_RX_Next_Ack := 0,
    AM_RX_Next := 0,
    UM_TX_Next := 0,
    UM_RX_Next := 0,
    t_PollRetransmit := 0.08,// defaulted to FR1
    t_Reassembly := 0.08,// defaulted to FR1
    t_ReassemblyExt_r17 := 1.1,// defaulted as required by 7.1.2.2.5a
    t_StatusProhibit := 0.03,
    maxRetxThreshold := 8,
    pollPDU := 32768,
    pollByte := 18000000,
    UM_SN_Size := 12,
    AM_SN_Size := 18,
    // Initialisation of other parameters
    TimeStampLastReceivedPDU := cs_SubFrameTiming (0,0,0),
    LastSNReceived := 0,
    TxPRBS_Pos := 0,
    RxPRBS_Pos := 0,
    TxDataSize := 0,
    RxDataSize := 0,
    PDCP_TX_Next := 0,
    PDCP_RX_Next := 0,
    UL_PDCP_SDU_size := 100
  }

  template (value) NR_RLC_Status_NackSN18Bit_Type crs_NR_RLC_NACK_SN18_Simple(integer p_NackSN,
                                                                             B1_Type p_E1 := '0'B
                                                                             ) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to transmit or receive  */
    //@sic R5s190288 additional change 2: added p_E1 sic@
    SequenceNumberNACK := int2bit(p_NackSN, 18),       /* 18 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field @sic R5s190179 sic@ */
    E2 := '0'B,                         /* 1 bit E2 field */
    E3 := '0'B,                         /* 1 bit E3 field */
    Reserved := '000'B,                 /* 1 bits reserved */
    SOstart := omit,
    SOstop := omit,
    NACKrange := omit
  };

  template (value) NR_RLC_Status_NackSN18Bit_Type crs_NR_RLC_NACK_SN18_Range(integer p_NackSN,
                                                                            integer p_NACKrange,
                                                                             B1_Type p_E1 := '0'B) :=
  { /* serves to transmit or receive  */
    //@sic R5s190288 additional change 2: added p_E1, R5s190894 ch. 6: E1 defaulted to '0' sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    SequenceNumberNACK := int2bit(p_NackSN, 18),       /* 18 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field */
    E2 := '0'B,                         /* 1 bit E2 field */
    E3 := '1'B,                         /* 1 bit E3 field */
    Reserved := '000'B,                 /* 1 bits reserved */
    SOstart := omit,
    SOstop := omit,
    NACKrange := int2bit(p_NACKrange, 8)
  };

  template (value) NR_RLC_Status_NackSN18Bit_Type crs_NR_RLC_NACK_SN18_SOs(integer p_NackSN,
                                                                           integer p_SOstart,
                                                                           integer p_SOstop,
                                                                           B1_Type p_E1 := '0'B
                                                                           ) :=
  { /* serves to transmit or receive  */
    // @sic R5s190340 change 4.3 : added p_E1 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    SequenceNumberNACK := int2bit(p_NackSN, 18),       /* 18 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field */
    E2 := '1'B,                         /* 1 bit E2 field */
    E3 := '0'B,                         /* 1 bit E3 field */
    Reserved := '000'B,                 /* 1 bits reserved */
    SOstart := int2bit(p_SOstart, 16),
    SOstop := int2bit(p_SOstop, 16),
    NACKrange := omit
  };

  template (value) NR_RLC_Status_NackSN12Bit_Type crs_NR_RLC_NACK_SN12_Simple(integer p_NackSN,
                                                                              B1_Type p_E1 := '0'B) :=
  { /* serves to transmit or receive  */
    // @sic R5s230118 added p_E1 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    SequenceNumberNACK := int2bit(p_NackSN, 12),       /* 12 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field */
    E2 := '0'B,                         /* 1 bit E2 field */
    E3 := '0'B,                         /* 1 bit E3 field */
    Reserved := '0'B,                   /* 1 bits reserved */
    SOstart := omit,
    SOstop := omit,
    NACKrange := omit
  };

  template (value) NR_RLC_Status_NackSN12Bit_Type crs_NR_RLC_NACK_SN12_SOs(integer p_NackSN,
                                                                           integer p_SOstart,
                                                                           integer p_SOstop,
                                                                           B1_Type p_E1 := '0'B) :=
  { /* serves to transmit or receive  */
    // @sic R5s230118 added p_E1 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    SequenceNumberNACK := int2bit(p_NackSN, 12),       /* 12 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field */
    E2 := '1'B,                         /* 1 bit E2 field */
    E3 := '0'B,                         /* 1 bit E3 field */
    Reserved := '0'B,                   /* 1 bits reserved */
    SOstart := int2bit(p_SOstart, 16),
    SOstop := int2bit(p_SOstop, 16),
    NACKrange := omit
  };

  template (value) NR_RLC_Status_NackSN12Bit_Type crs_NR_RLC_NACK_SN12_Range(integer p_NackSN,
                                                                             integer p_NACKrange,
                                                                             B1_Type p_E1 := '0'B) :=
  { /* serves to transmit or receive  */
    // @sic R5s230118 added p_E1 sic@
    /* @status    APPROVED (ENDC, NR5GC) */
    SequenceNumberNACK := int2bit(p_NackSN, 12),       /* 12 bits SN */
    E1 := p_E1,                         /* 1 bit E1 field */
    E2 := '0'B,                         /* 1 bit E2 field */
    E3 := '1'B,                         /* 1 bit E3 field */
    Reserved := '0'B,                   /* 1 bits reserved */
    SOstart := omit,
    SOstop := omit,
    NACKrange := int2bit(p_NACKrange, 8)
  };

  /*
   * @desc      Return an RLC PDU containing a full SDU which is to be sent
   *            Increment AM_TX_Next
   * @param     p_RLC_Rec           (by reference)
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_Data
   * @return    template
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_Get_AMD_FullSDU_TX(inout NR_RLC_SS_State_Type p_RLC_Rec,
                                       B1_Type p_Poll := tsc_NR_P_NoPoll,
                                       NR_RLC_AMD_Data_Type p_Data) return template (value) NR_RLC_AMD_PDU_Type
  { // @sic R5s190179 R5s190317 sic@
    var template (value) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU := f_NR_RLC_Get_AMD_PDU_TX (p_RLC_Rec, p_Poll, -, -, p_Data);
    f_NR_RLC_SS_State_AM_TX_Next_Incr(p_RLC_Rec); // increment AM_TX_Next
    return v_NR_RLC_AMD_PDU;
  }

  /*
   * @desc      Return an RLC PDU which is to be sent
   * @param     p_RLC_Rec
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_SegmentationInfo  (default value: tsc_NR_SI_FullSDU)
   * @param     p_NR_RLC_SegmentOffset (default value: omit)
   * @param     p_Data
   * @return    template (value) NR_RLC_AMD_PDU_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_Get_AMD_PDU_TX(NR_RLC_SS_State_Type p_RLC_Rec,
                                   B1_Type p_Poll := tsc_NR_P_NoPoll,
                                   NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                   template (omit) NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset:= omit,
                                   NR_RLC_AMD_Data_Type p_Data) return template (value) NR_RLC_AMD_PDU_Type
  {
    var template (value) NR_RLC_AMD_PduSN18Bit_Type v_NR_RLC_AMD_PduSN18Bit;
    var template (value) NR_RLC_AMD_PduSN12Bit_Type v_NR_RLC_AMD_PduSN12Bit;
    var template (value) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU;
    
    select (p_RLC_Rec.AM_SN_Size) {
      case (18) {
        v_NR_RLC_AMD_PduSN18Bit := cs_NR_RLC_AMD_PduSN18Bit(p_RLC_Rec.AM_TX_Next,
                                                            p_Poll,
                                                            p_SegmentationInfo,
                                                            p_NR_RLC_SegmentOffset,
                                                            p_Data);
        v_NR_RLC_AMD_PDU := cs_NR_RLC_AMD_PDU_SN18Bit(v_NR_RLC_AMD_PduSN18Bit);
      }
      case (12) {
        v_NR_RLC_AMD_PduSN12Bit := cs_NR_RLC_AMD_PduSN12Bit(p_RLC_Rec.AM_TX_Next,
                                                            p_Poll,
                                                            p_SegmentationInfo,
                                                            p_NR_RLC_SegmentOffset,
                                                            p_Data);
        v_NR_RLC_AMD_PDU := cs_NR_RLC_AMD_PDU_SN12Bit(v_NR_RLC_AMD_PduSN12Bit);
      }
    }
    return v_NR_RLC_AMD_PDU;
  }

  template (present) NR_RLC_AMD_PduSN12Bit_Type cr_NR_RLC_AMD_PduSN12Bit(template (present) integer p_SN := ?,
                                                                         template (present) B1_Type p_Poll := ?,
                                                                         NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                                                         template NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset := omit,
                                                                         template (present)NR_RLC_AMD_Data_Type p_Data := ?) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to receive one AMD SDU of SN size 12 without segmentation info */
    // @sic R5-226947 sic@
    Header := {
      D_C := tsc_NR_RLC_D_C_Data,
      Poll := p_Poll,
      SegmentationInfo := p_SegmentationInfo,
      SequenceNumber := f_TemplateInt2Bit (p_SN, 12),      // f_TemplateInt2Bit results in ? for p_SN = ?
      SegmentOffset := p_NR_RLC_SegmentOffset
    },
    Data := p_Data
  };

  template (present) NR_RLC_AMD_PduSN18Bit_Type cr_NR_RLC_AMD_PduSN18Bit(template (present) integer p_SN := ?,
                                                                         template (present) B1_Type p_Poll := ?,
                                                                         NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                                                         template NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset := omit,
                                                                         template (present) NR_RLC_AMD_Data_Type p_Data := ?) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to receive one AMD SDU of SN size 18 without segmentation info */
    Header := {
      D_C := tsc_NR_RLC_D_C_Data,
      Poll := p_Poll,
      SegmentationInfo := p_SegmentationInfo,
      Reserved := '00'B,
      SequenceNumber := f_TemplateInt2Bit(p_SN, 18),      // f_TemplateInt2Bit results in ? for p_SN = ?
      SegmentOffset := p_NR_RLC_SegmentOffset
    },
    Data := p_Data
  };

  /*
   * @desc      Return an RLC PDU containing a full SDU which is expected to be received
   *            Increment AM_RX_Next
   * @param     p_RLC_Rec           (by reference)
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_Data
   * @return    template
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_Get_AMD_FullSDU_RX(inout NR_RLC_SS_State_Type p_RLC_Rec,
                                       template (present) B1_Type p_Poll := tsc_NR_P_NoPoll,
                                       template (present) NR_RLC_AMD_Data_Type p_Data) return template (present) NR_RLC_AMD_PDU_Type
  { // @sic R5s190179 R5s190317 sic@
    var template (present) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU := f_NR_RLC_Get_AMD_PDU_RX (p_RLC_Rec, p_Poll, -, -, p_Data);
    f_NR_RLC_SS_State_AM_RX_Next_Incr(p_RLC_Rec); // increment AM_RX_Next
    return v_NR_RLC_AMD_PDU;
  }

  /*
   * @desc      Return an RLC PDU which is expected to be received
   * @param     p_RLC_Rec
   * @param     p_Poll
   * @param     p_SegmentationInfo  (default value: tsc_NR_SI_FullSDU)
   * @param     p_NR_RLC_SegmentOffset (default value: omit)
   * @param     p_Data
   * @return    template (present) NR_RLC_AMD_PDU_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_Get_AMD_PDU_RX(NR_RLC_SS_State_Type p_RLC_Rec,
                                   template (present) B1_Type p_Poll,
                                   NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                   template NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset := omit,
                                   template (present) NR_RLC_AMD_Data_Type p_Data) return template (present) NR_RLC_AMD_PDU_Type
  {
    var template (present) NR_RLC_AMD_PduSN18Bit_Type v_NR_RLC_AMD_PduSN18Bit;
    var template (present) NR_RLC_AMD_PduSN12Bit_Type v_NR_RLC_AMD_PduSN12Bit;
    var template (present) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU;

    select (p_RLC_Rec.AM_SN_Size) {
      case (18) {
        v_NR_RLC_AMD_PduSN18Bit := cr_NR_RLC_AMD_PduSN18Bit(p_RLC_Rec.AM_RX_Next,
                                                            p_Poll,
                                                            p_SegmentationInfo,
                                                            p_NR_RLC_SegmentOffset,
                                                            p_Data);
        v_NR_RLC_AMD_PDU := cr_NR_RLC_AMD_PDU_SN18Bit(v_NR_RLC_AMD_PduSN18Bit);
      }
      case (12) {
        v_NR_RLC_AMD_PduSN12Bit := cr_NR_RLC_AMD_PduSN12Bit(p_RLC_Rec.AM_RX_Next,
                                                            p_Poll,
                                                            p_SegmentationInfo,
                                                            p_NR_RLC_SegmentOffset,
                                                            p_Data);
        v_NR_RLC_AMD_PDU := cr_NR_RLC_AMD_PDU_SN12Bit(v_NR_RLC_AMD_PduSN12Bit);
      }
    }
    return v_NR_RLC_AMD_PDU;
  }

  /*
   * @desc      Returne DL_t_Reassembly
   * @param     p_IsFR1
   * @return    DL_t_Reassembly_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_DL_AM_T_Reassembly(boolean p_IsFR1) return DL_t_Reassembly_Type
  { // 38.508-1 Table 4.6.3-149: RLC-Config
    var DL_t_Reassembly_Type v_T_Reassembly;
    
    if (p_IsFR1) {//@sic R5-187675 sic@
      v_T_Reassembly := ms80;
    } else {
      v_T_Reassembly := ms30;
    }
    return v_T_Reassembly;
  }

  /*
   * @desc      Returns t_PollRetransmit
   * @param     p_IsFR1
   * @return    UL_t_PollRetransmit_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_UL_AM_T_PollRetransmit(boolean p_IsFR1) return UL_t_PollRetransmit_Type
  { // 38.508-1 Table 4.6.3-149: RLC-Config
    var UL_t_PollRetransmit_Type v_T_PollRetransmit;
    
    if (p_IsFR1) { //@sic R5-187675 sic@
      v_T_PollRetransmit := ms80;
    } else {
      v_T_PollRetransmit := ms30;
    }
    return v_T_PollRetransmit;
  }

  /*
   * @desc      Return RLC_BearerConfigList AM with specific parameters
   * @param     p_NR_DRB_Id
   * @param     p_UL_sn_FieldLength (default value: size18)
   * @param     p_UL_t_PollRetransmit
   * @param     p_UL_pollPDU        (default value: p32768)
   * @param     p_UL_pollByte       (default value: kB750)
   * @param     p_UL_maxRetxThreshold (default value: t8)
   * @param     p_DL_sn_FieldLength (default value: size18)
   * @param     p_DL_t_Reassembly
   * @param     p_DL_t_StatusProhibit (default value: ms30)
   * @param     p_ReestablishRLC    (default value: omit)
   * @param     p_T_ReassemblyExt_r17    (default value: omit)
   * @return    template
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ReconfigureRLC_AM(DRB_Identity p_NR_DRB_Id,
                                  UL_sn_FieldLength_Type p_UL_sn_FieldLength := size18,
                                  UL_t_PollRetransmit_Type p_UL_t_PollRetransmit,
                                  UL_pollPDU_Type p_UL_pollPDU := p32768,
                                  UL_pollByte_Type p_UL_pollByte := kB750,
                                  UL_maxRetxThreshold_Type p_UL_maxRetxThreshold := t8,
                                  DL_sn_FieldLength_Type p_DL_sn_FieldLength := size18,
                                  DL_t_Reassembly_Type p_DL_t_Reassembly,
                                  DL_t_StatusProhibit_Type p_DL_t_StatusProhibit := ms30,
                                  template (omit) RLC_BearerConfig.reestablishRLC p_ReestablishRLC := omit,
                                  template (omit) T_ReassemblyExt_r17 p_T_ReassemblyExt_r17 := omit) runs on NR_BASE_PTC return template (value) NR_RLC_BearerToAddModList_Type  //@sic R5-256933 sic@
  { //@sic R5s190340 change 4.4 p_UL_pollByte := kB750 sic@
    var template (value) UL_AM_RLC v_UL_AM_RLC;
    var template (value) DL_AM_RLC v_DL_AM_RLC;
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;

    // Establishing UL AM RLC  parameters
    v_UL_AM_RLC.sn_FieldLength := p_UL_sn_FieldLength;
    v_UL_AM_RLC.t_PollRetransmit := p_UL_t_PollRetransmit;
    v_UL_AM_RLC.pollPDU := p_UL_pollPDU;
    v_UL_AM_RLC.pollByte := p_UL_pollByte;
    v_UL_AM_RLC.maxRetxThreshold := p_UL_maxRetxThreshold;
    // Establishing DL AM RLC  parameters
    v_DL_AM_RLC.sn_FieldLength := p_DL_sn_FieldLength;
    v_DL_AM_RLC.t_Reassembly := p_DL_t_Reassembly;
    v_DL_AM_RLC.t_StatusProhibit := p_DL_t_StatusProhibit;
    if (isvalue(p_T_ReassemblyExt_r17)){
      v_RLC_Config_v1700 := cs_RLC_Config_v1700_Def(p_T_ReassemblyExt_r17, - );
    }

    // Configuration
    v_RLC_BearerConfigList[0] := cs_38508_RLC_BearerConfig_DRB(p_NR_DRB_Id,
                                                               cs_38508_RLC_Config_AM_DRB (v_UL_AM_RLC, v_DL_AM_RLC),
                                                               cs_38508_LogicalChannelConfig_DRB,
                                                               p_ReestablishRLC,
                                                               v_RLC_Config_v1700);
    return v_RLC_BearerConfigList;
  }

  /*
   * @desc      Get configurable parameters to create a generate a PCDP PDU for transmission
   * @param     p_RLC_Rec           (by reference)
   * @return    NR_RLC_DataField_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetTx_PRBS(inout NR_RLC_SS_State_Type p_RLC_Rec)return NR_RLC_DataField_Type
  {
    var integer v_TxDataSize := p_RLC_Rec.TxDataSize;
    var integer v_TxPRBS_Pos := p_RLC_Rec.TxPRBS_Pos;
    var NR_RLC_DataField_Type v_NR_RLC_Data := ''O;
    
    if (v_TxDataSize > 0) {
      v_NR_RLC_Data := f_GetN_OctetsFromPRBS(v_TxPRBS_Pos, v_TxDataSize);
      v_TxPRBS_Pos := v_TxPRBS_Pos + v_TxDataSize;
      if (v_TxPRBS_Pos >= tsc_MaxPRBS_Pos) {
        v_TxPRBS_Pos := v_TxPRBS_Pos - tsc_MaxPRBS_Pos;
      }
    }
    p_RLC_Rec.TxPRBS_Pos := v_TxPRBS_Pos;
    return v_NR_RLC_Data;

  }

  /*
   * @desc      Initialisation of configurable parameters to their defaults according to 38.058 cl. 4.8
   * @return    NR_RLC_SS_State_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_InitRLC_Record() return NR_RLC_SS_State_Type
  { // @sic R5s190906 ch. 1 sic@
    return (valueof(cs_NR_RLC_SS_State));
  }

  /*
   * @desc      Increments RLC AM TX Window
   * @param     p_RLC_Rec           (by reference)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_SS_State_AM_TX_Next_Incr(inout NR_RLC_SS_State_Type p_RLC_Rec)
  {
    p_RLC_Rec.AM_TX_Next := (p_RLC_Rec.AM_TX_Next + 1) mod f_Power(2, p_RLC_Rec.AM_SN_Size);
  }

  /*
   * @desc      Increments AM Rx Window on RLC
   * @param     p_RLC_Rec           (by reference)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_RLC_SS_State_AM_RX_Next_Incr(inout NR_RLC_SS_State_Type p_RLC_Rec)
  {
    p_RLC_Rec.AM_RX_Next := (p_RLC_Rec.AM_RX_Next + 1) mod f_Power(2, p_RLC_Rec.AM_SN_Size);
  }

  /*
   * @desc      Increments UM Tx Window on RLC
   * @param     p_RLC_Rec           (by reference)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_SS_State_UM_TX_Next_Incr(inout NR_RLC_SS_State_Type p_RLC_Rec)
  {
    p_RLC_Rec.UM_TX_Next := (p_RLC_Rec.UM_TX_Next + 1) mod f_Power(2, p_RLC_Rec.UM_SN_Size);
  }

  /*
   * @desc      Increments PDCP Rx Window
   * @param     p_RLC_Rec           (by reference)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_SS_State_UM_RX_Next_Incr(inout NR_RLC_SS_State_Type p_RLC_Rec)
  {
    p_RLC_Rec.UM_RX_Next := (p_RLC_Rec.UM_RX_Next + 1) mod f_Power(2, p_RLC_Rec.UM_SN_Size);
  }

  /*
   * @desc      Increments PDCP Tx Window
   * @param     p_RLC_Rec           (by reference)
   * @param     p_Maximum_PDCP_SN   (default value: tsc_NR_Maximum_PDCP_SN_18)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_RLC_SS_State_PDCP_TX_Next_Incr(inout NR_RLC_SS_State_Type p_RLC_Rec,
                                               integer p_Maximum_PDCP_SN := tsc_NR_Maximum_PDCP_SN_18)
  {
    p_RLC_Rec.PDCP_TX_Next := (p_RLC_Rec.PDCP_TX_Next + 1) mod (p_Maximum_PDCP_SN + 1);
  }

  template (present) NR_RLC_PDU_Type cr_NR_RLC_PDU_AMD(template (present) NR_RLC_AMD_PDU_Type p_PDU) := {AMD := p_PDU};                             /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_PDU_Type cr_NR_RLC_PDU_UMD(template (present) NR_RLC_UMD_PDU_Type p_PDU) := {UMD := p_PDU};                             /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_UMD_PDU_Type cs_NR_RLC_UMD_PDU_SN6Bit(template (value) NR_RLC_UMD_PduSN6Bit_Type p_PDU) := {SN6Bit := p_PDU};             /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_UMD_PDU_Type cs_NR_RLC_UMD_PDU_SN12Bit(template (value) NR_RLC_UMD_PduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};          /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_AMD_PDU_Type cr_NR_RLC_AMD_PDU_SN12Bit(template (present) NR_RLC_AMD_PduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};       /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_AMD_PDU_Type cr_NR_RLC_AMD_PDU_SN18Bit(template (present) NR_RLC_AMD_PduSN18Bit_Type p_PDU) := {SN18Bit := p_PDU};       /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_UMD_PDU_Type cr_NR_RLC_UMD_PDU_NoSN(template (present) NR_RLC_UMD_PduNoSN_Type p_PDU) := {NoSN := p_PDU};                /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_UMD_PDU_Type cr_NR_RLC_UMD_PDU_SN6Bit(template (present) NR_RLC_UMD_PduSN6Bit_Type p_PDU) := {SN6Bit := p_PDU};          /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_UMD_PDU_Type cr_NR_RLC_UMD_PDU_SN12Bit(template (present) NR_RLC_UMD_PduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};       /* @status    APPROVED (ENDC, NR5GC) */

  /*
   * @desc      Transmission of a STATUS PDU with ACK_SN only
   * @param     p_RLC_Rec
   * @param     p_NR_DRB_Id
   * @param     p_NR_NackSN18Bit_List (default value: omit)
   * @param     p_NR_NackSN12Bit_List (default value: omit)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CellId            (default value: nr_Cell1)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_TxSTATUS_PDU(NR_RLC_SS_State_Type p_RLC_Rec,
                             DRB_Identity p_NR_DRB_Id,
                             template (omit) NR_RLC_Status_NackListSN18Bit_Type p_NR_NackSN18Bit_List := omit,
                             template (omit) NR_RLC_Status_NackListSN12Bit_Type p_NR_NackSN12Bit_List := omit,
                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now, //@sic R5s190513 add. ch. 3 sic@
                             NR_CellId_Type p_CellId := nr_Cell1) //@sic R5s210791 ch. 3 sic@
    runs on NR_BASE_PTC
  {
    var template (value) NR_RLC_StatusPduSN18Bit_Type v_StatusPduSN18Bit;
    var template (value) NR_RLC_StatusPduSN12Bit_Type v_StatusPduSN12Bit;
    var template (value) NR_RLC_AM_StatusPDU_Type v_NR_RLC_StatusPDU;
    var template (value) NR_RLC_PDUList_Type v_PDUList;
    
    if (p_RLC_Rec.AM_SN_Size == 18) {
      v_StatusPduSN18Bit := cs_NR_RLC_StatusPduSN18Bit(p_RLC_Rec.AM_RX_Next, p_NR_NackSN18Bit_List);
      v_NR_RLC_StatusPDU := cs_NR_RLC_StatusPDU_SN18Bit(v_StatusPduSN18Bit);
    }
    else { // AM SN size = 12
      v_StatusPduSN12Bit := cs_NR_RLC_StatusPduSN12Bit(p_RLC_Rec.AM_RX_Next, p_NR_NackSN12Bit_List);
      v_NR_RLC_StatusPDU := cs_NR_RLC_StatusPDU_SN12Bit(v_StatusPduSN12Bit);
    }
    v_PDUList := { cs_NR_RLC_PDU_Status(v_NR_RLC_StatusPDU) };

    DRB.send(cas_NR_DRB_COMMON_REQ_RLC_PDUList(p_CellId, //@sic R5s210791 ch. 3 sic@
                                               p_NR_DRB_Id,
                                               p_TimingInfo, //@sic R5s190513 add. ch. 3 sic@
                                               v_PDUList));
  }

  /*
   * @desc      Send one AM PDU transporting an SDU (meaning part of a PDCP PDU)
   * @param     p_RLC_Rec           (by reference)
   * @param     p_DRBId
   * @param     p_NR_RLC_Data
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CellId            (default value: nr_Cell1)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_TxAMD_SDU(inout NR_RLC_SS_State_Type p_RLC_Rec,
                          DRB_Identity p_DRBId,
                          NR_RLC_DataField_Type p_NR_RLC_Data,
                          B1_Type p_Poll := tsc_NR_P_NoPoll,
                          template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                          NR_CellId_Type p_CellId := nr_Cell1) //@sic R5s210791 ch. 4 sic@
  runs on NR_BASE_PTC
  {
    var template (value) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU;
    var template (value) NR_RLC_PDUList_Type v_NR_RLC_PDUList;
    
    v_NR_RLC_AMD_PDU := f_NR_RLC_Get_AMD_FullSDU_TX(p_RLC_Rec, p_Poll, p_NR_RLC_Data);
    v_NR_RLC_PDUList := { cs_NR_RLC_PDU_AMD(v_NR_RLC_AMD_PDU) };

    DRB.send(cas_NR_DRB_COMMON_REQ_RLC_PDUList(p_CellId, //@sic R5s210791 ch. 4 sic@
                                               p_DRBId,
                                               p_TimingInfo,
                                               v_NR_RLC_PDUList));
  }

  /*
   * @desc      Receive one AM PDU transporting an SDU
   * @param     p_RLC_Rec           (by reference)
   * @param     p_DRBId
   * @param     p_NR_RLC_Data
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_CellId            (default value: nr_Cell1)
   * @return    NR_DRB_COMMON_IND
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_RxAMD_SDU_Common(inout NR_RLC_SS_State_Type p_RLC_Rec,
                                  DRB_Identity p_DRBId,
                                  template (present) NR_RLC_DataField_Type p_NR_RLC_Data,
                                  template (present) B1_Type p_Poll := tsc_NR_P_NoPoll,
                                  NR_CellId_Type p_CellId := nr_Cell1) //@sic R5s210791 ch. 6 sic@
    runs on NR_BASE_PTC return NR_DRB_COMMON_IND
  {
    var template (present) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU_Expected;
    var template (present) NR_RLC_PDUList_Type v_NR_RLC_PDUList;
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;

    v_NR_RLC_AMD_PDU_Expected := f_NR_RLC_Get_AMD_FullSDU_RX(p_RLC_Rec, p_Poll, p_NR_RLC_Data);
    v_NR_RLC_PDUList := { cr_NR_RLC_PDU_AMD(v_NR_RLC_AMD_PDU_Expected) };

    DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(p_CellId, //@sic R5s210791 ch. 6 sic@
                                                  p_DRBId,
                                                  -,
                                                  v_NR_RLC_PDUList)) -> value v_NR_DRB_COMMON_IND;
    p_RLC_Rec.TimeStampLastReceivedPDU := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame;
    return v_NR_DRB_COMMON_IND;
  }

  /*
   * @desc      Receive list of L2Data
   * @param     p_RLC_Rec           (by reference)
   * @param     p_DRBId
   * @return    NR_L2DataList_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RxAMD_PDU_GetList(inout NR_RLC_SS_State_Type p_RLC_Rec,
                                  DRB_Identity p_DRBId)
    runs on NR_BASE_PTC return NR_L2DataList_Type
  { // @sic R5-206326  R5s210395 sic@
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
    var NR_L2DataList_Type v_NR_L2DataList;

    DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(nr_Cell1,
                                                  p_DRBId)) -> value v_NR_DRB_COMMON_IND;
    p_RLC_Rec.TimeStampLastReceivedPDU := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame;
    v_NR_L2DataList := v_NR_DRB_COMMON_IND.U_Plane.SlotData.PduSduList;
    return v_NR_L2DataList;
  }

  /*
   * @desc      Receive one AM PDU transporting part of a SDU (meaning part of a PDCP PDU)
   * @param     p_RLC_Rec           (by reference)
   * @param     p_DRBId
   * @param     p_NR_RLC_Data
   * @param     p_Poll              (default value: tsc_NR_P_NoPoll)
   * @param     p_CellId            (default value: nr_Cell1)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RxAMD_SDU(inout NR_RLC_SS_State_Type p_RLC_Rec,
                          DRB_Identity p_DRBId,
                          template (present) NR_RLC_DataField_Type p_NR_RLC_Data,
                          template (present) B1_Type p_Poll := tsc_NR_P_NoPoll,
                          NR_CellId_Type p_CellId := nr_Cell1) //@sic R5s210791 ch. 5 sic@
    runs on NR_BASE_PTC
  {
    fl_NR_RxAMD_SDU_Common(p_RLC_Rec, p_DRBId, p_NR_RLC_Data, p_Poll, p_CellId); //@sic R5s210791 ch. 5 sic@
  }

}
