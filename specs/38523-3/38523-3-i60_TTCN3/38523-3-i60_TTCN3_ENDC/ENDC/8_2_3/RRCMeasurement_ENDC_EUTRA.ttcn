  template (value) ReportConfigInterRAT_Trigger_Type cs_ReportConfigInterRAT_Trigger_B2_NR(RSRP_Range p_RSRP_Range,
                                                                                           RSRP_RangeNR_r15 p_NR_RSRP_Thres,
                                                                                           Hysteresis p_Hysteresis,
                                                                                           TimeToTrigger p_TimeToTrigger) :=
  { /* @status    APPROVED (ENDC) */
    event := {
      eventId := {
        eventB2_NR_r15 := {
          b2_Threshold1_r15 := {
            threshold_RSRP := p_RSRP_Range
          },
          b2_Threshold2NR_r15:={
            nr_RSRP_r15 := p_NR_RSRP_Thres
          },
          reportOnLeave_r15 := false
        }
      },
      hysteresis := p_Hysteresis,
      timeToTrigger := p_TimeToTrigger
    }
  };

