module IMS_CatM1_CallControlTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_12 all;
  import from IMS_CommonDefs all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.12.1
   * @status    APPROVED (IMS)
   */
  function f_TC_J_12_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MO_VoiceCall_C21(tsc_IMS_SDP_AudioCodecList_AMR_only, AMR_8000);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.12.2
   * @status    APPROVED (IMS)
   */
  function f_TC_J_12_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MT_VoiceCall_C11(tsc_IMS_SDP_AudioCodecList_AMR_only);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

}
