   * @desc      REFERENCE TS 36.523-1 clause 7.1.7.1.8
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_7_1_7_1_8_EUTRA() runs on EUTRA_PTC
  { /* DL-SCH transport block size selection / DCI format 1 / RA type 1 / 256QAM  */
    f_EUTRA_7_1_7_1_x_256QAM(dci_1, ra_1);
  }

