module NR_Measurement_Functions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions_CA all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Templates all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  /*
   * @desc      Function to generate NR measurement object based on ssb-ConfigMobility
   * @param     p_NR_CellId
   * @param     p_AbsThreshSSB
   * @param     p_NrofSS_BlocksToAverage (default value: 2)
   * @param     p_ServCellId        (default value: nr_Cell1)
   * @return    template (value) MeasObjectNR
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_MeasObjectNR_SSB(NR_CellId_Type p_NR_CellId,
                                 template (omit) RSRP_Range p_AbsThreshSSB,
                                 template (omit) integer p_NrofSS_BlocksToAverage := 2,
                                 NR_CellId_Type p_ServCellId := nr_Cell1)
    runs on NR_BASE_PTC return template (value) MeasObjectNR
  {
    var FreqBandIndicatorNR v_FreqBandIndicator := f_NR_CellInfo_GetBandIndicator(p_NR_CellId);  //@sic R5-194795 sic@
    var ARFCN_ValueNR v_SSB_Freq := f_NR_CellInfo_GetFrequencySSB(p_NR_CellId);
    var SubcarrierSpacing v_SubCarrierSpacing := f_NR_CellInfo_GetSSB_SCS(p_NR_CellId); //@sic R5-206301, R5-206305 sic@
    var template (value) SSB_MTC v_SSB_MTC := f_NR_GetSSB_MTC_InterFreqOdd(p_ServCellId, p_NR_CellId);    //@sic R5-199013 sic@
        
    return cds_38508_MeasObjectNR_SSB(v_FreqBandIndicator,
                                      v_SSB_Freq,
                                      v_SubCarrierSpacing,
                                      v_SSB_MTC,
                                      p_AbsThreshSSB,
                                      p_NrofSS_BlocksToAverage);
  }

  /*
   * @desc      Function to generate measurement config with NR and EUTRA Measurement objects
   * @param     p_ARFCN_ValueEUTRA
   * @param     p_MeasurementBandwidth
   * @param     p_TC_8_1_3_2_4      (default value: false)
   * @param     p_MeasObjects_NR
   * @param     p_MeasObjects_EUTRA
   * @param     p_ReportConfigToAddModList
   * @param     p_MeasIdToAddModList (default value: cs_NR_MeasIdToAddModList_1Entry)
   * @param     p_MeasGapConfig     (default value: omit)
   * @param     p_QuantityConfig    (default value: cs_38508_QuantityConfig)
   * @return    template (value) MeasConfig
   * @status    APPROVED (NR5GC_IRAT)
   */
    function f_NR_GenerateMeasurementConfigNR_EUTRA (ARFCN_ValueEUTRA p_ARFCN_ValueEUTRA,
                                                     EUTRA_AllowedMeasBandwidth p_MeasurementBandwidth,
                                                     boolean p_TC_8_1_3_2_4 := false,
                                                     template (omit) MeasObjectParamsList_Type p_MeasObjects_NR,
                                                     template (omit) MeasObjectParamsList_Type_EUTRA p_MeasObjects_EUTRA,
                                                     template (omit) ReportConfigToAddModList p_ReportConfigToAddModList,
                                                     template (omit) MeasIdToAddModList p_MeasIdToAddModList := cs_NR_MeasIdToAddModList_1Entry,
                                                     template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                                     template (omit) QuantityConfig p_QuantityConfig := cs_38508_QuantityConfig
                                                    )runs on NR_BASE_PTC return template (value) MeasConfig
    { //@sic R5-195268, R5-195345, R5-195345, R5-206301, R5-206305 sic@
        var template (omit) MeasObjectToAddModList v_MeasObjectToAddModList;
        var template (value) MeasObjectToAddMod v_MeasObjectToAdd_NR;
        var template (value) MeasObjectToAddMod v_MeasObjectToAdd_EUTRA;
        var template (value) MeasObjectNR v_MeasObjectNR;
        var template (value) MeasObjectEUTRA v_MeasObjectEUTRA;
        var NR_CellId_Type v_CellId;
        
            v_CellId := valueof(p_MeasObjects_NR[0].cellId);
            
            if (p_TC_8_1_3_2_4)
            {
               v_MeasObjectNR := f_NR_MeasObjectNR_SSB(v_CellId, omit, omit);  //@sic R5-201148, R5-199020, R5-195268, R5-206334, R5-206301, R5-206305 sic@
            }
            else
            {
               v_MeasObjectNR := f_NR_MeasObjectNR_SSB(v_CellId, p_MeasObjects_NR[0].nrofSS_BlocksToAverage, omit); //@sic R5-201148, R5-206334, R5-206301, R5-206305 sic@
            }
            v_MeasObjectToAdd_NR := cs_NR_MeasObjectToAddMod_NR(valueof(p_MeasObjects_NR[0].measObjId), v_MeasObjectNR);
            v_MeasObjectToAddModList[0] := v_MeasObjectToAdd_NR;
            v_MeasObjectEUTRA := cs_MeasObjectEUTRA_Common(p_ARFCN_ValueEUTRA, p_MeasurementBandwidth);
            v_MeasObjectToAdd_EUTRA := cs_NR_MeasObjectToAddMod_EUTRA(valueof(p_MeasObjects_EUTRA[0].measObjId), v_MeasObjectEUTRA);
            v_MeasObjectToAddModList[1] := v_MeasObjectToAdd_EUTRA;

        return cs_NR_MeasConfig_Partial(v_MeasObjectToAddModList,
                                       p_ReportConfigToAddModList,
                                       p_MeasIdToAddModList,
                                       p_MeasGapConfig,
                                       p_QuantityConfig);

    };

  /*
   * @desc     Ingore measurement reports for a certain time
   * @param     p_Timer
   * @param     p_NR_CellId         (default value: nr_Cell1)
   * @param     p_MeasReport        (default value: cr_NR_MeasurementReport_Any)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_IgnorePeriodicalMeasurmentReport(float p_Timer,
                                                 NR_CellId_Type p_NR_CellId := nr_Cell1,
                                                 template (present) UL_DCCH_Message p_MeasReport := cr_NR_MeasurementReport_Any  //@sic R5-225397 sic@
                                                 ) runs on NR_BASE_PTC
  {
    var default v_DefaultRef;
        
    //Activate defalut and and ignore measurement reports for p_Timer seconds
    v_DefaultRef := activate(a_NR_AddDefault_IgnorePeriodicalMeasurmentReport(p_NR_CellId, p_MeasReport));
    f_Delay(p_Timer);
    
    //Deactivate the default to stop ignoring measurement reports
    deactivate(v_DefaultRef);
  };

   /*
   * @desc      Ensure no Measurement Report is received within a certain time
   * @param     p_Timer
   * @param     p_NR_CellId
   * @param     p_RrcPdu
   * @param     p_NewCellPower      (default value: omit)
   * @param     p_ReceiveOnSRB1     (default value: true)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_Check_NoMeasurementReport(float p_Timer,
                                          NR_CellId_Type p_NR_CellId,
                                          template (present) UL_DCCH_Message p_RrcPdu,
                                          template (omit) NR_CellPowerList_Type p_NewCellPower := omit,
                                          boolean p_ReceiveOnSRB1 := true) runs on NR_BASE_PTC
  {//@sic R5-201224 sic@
    timer t_Wait;
    
    if(ispresent( p_NewCellPower))  //@sic R5s201366 sic@
    {
       f_NR_SetCellPowerList(p_NewCellPower);   //compiler warning may be ignored due to check
    }
      
    t_Wait.start(p_Timer);
    alt {
      [] t_Wait.timeout
        {
        }
      [p_ReceiveOnSRB1] SRB.receive( car_NR_SRB1_RrcPdu_IND( p_NR_CellId, p_RrcPdu ) )
        {
            t_Wait.stop;
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Check failed: Measurement Report received within a certain time");
        }
      [not(p_ReceiveOnSRB1)] SRB.receive( car_NR_SRB3_RrcPdu_IND( p_NR_CellId, p_RrcPdu ) )
        {
            t_Wait.stop;
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Check failed: Measurement Report received within a certain time");
        }
    }
  };

  /*
   * @desc      Additional default behaviour to be activated on top of the standard default behaviour
   *            when periodical MeasurmentReports shall be ignored
   * @param     p_NR_CellId
   * @param     p_RrcPdu
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  altstep a_NR_AddDefault_IgnorePeriodicalMeasurmentReport(NR_CellId_Type p_NR_CellId,
                                                           template (present) UL_DCCH_Message p_RrcPdu) runs on NR_BASE_PTC
  {
    [] SRB.receive( car_NR_SRB1_RrcPdu_IND( p_NR_CellId, p_RrcPdu ) )
      {
        repeat;
      };
  };

  /*
   * @desc      Function to receive (periodical) measurement reports and, if needed, to check if they indeed arrive within a given period
   * @param     p_NR_CellId
   * @param     p_PhysCellId
   * @param     p_MeasId            (default value: tsc_NR_MeasId1)
   * @param     p_NumReports        (default value: 1)
   * @param     p_ReportInterval    (default value: 0.0)
   * @param     p_MeasResultNeighCells (default value: omit)
   * @param     p_ReceiveOnSRB1     (default value: true)
   * @param     p_PhysCellId_SCell  (default value: omit)
   * @param     p_ServCellIndex_SCell (default value: f_NR_ServCellIndex() + 1)
   * @param     p_MeasResultBestNeighCell_PCell (default value: omit)
   * @param     p_MeasResultBestNeighCell_SCell (default value: omit)
   * @param     p_MeasQuantityResults (default value: f_NR_Get_MeasQuantityResults())
   * @param     p_MacBearerRoutingCA_UL (default value: omit)
   * @param     p_MeasResultServingMOList_NotChecked (default value: false)
   * @param     p_AltitudeUE_r18    (default value: omit)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
   function f_NR_ReceiveMeasurementReports(NR_CellId_Type p_NR_CellId,
                                           PhysCellId  p_PhysCellId,
                                           MeasId p_MeasId := tsc_NR_MeasId1,
                                           integer p_NumReports := 1,
                                           float p_ReportInterval := 0.0, //@sic R5s190776 sic@
                                           template MeasResults.measResultNeighCells p_MeasResultNeighCells := omit,
                                           boolean p_ReceiveOnSRB1 := true,
                                           template PhysCellId  p_PhysCellId_SCell := omit,
                                           template (present) ServCellIndex p_ServCellIndex_SCell := f_NR_ServCellIndex() + 1,  //@sic R5s200734, R5-204443 sic@
                                           template MeasResultNR p_MeasResultBestNeighCell_PCell := omit,
                                           template MeasResultNR p_MeasResultBestNeighCell_SCell := omit,
                                           template (present) MeasQuantityResults p_MeasQuantityResults := f_NR_Get_MeasQuantityResults(), //@sic R5-204437, R5-211389 sic@
                                           template (omit) MacBearerRouting_Type p_MacBearerRoutingCA_UL := omit,
                                           boolean p_MeasResultServingMOList_NotChecked := false, //@sic R5-217997 sic@
                                           template Altitude_r18 p_AltitudeUE_r18 := omit // @sic R5-255043 sic@
                                          ) runs on NR_BASE_PTC
    {//@sic R5-195344 R5-201097 R5-201224 R5-204437 R5-213516: added p_MacBearerRoutingCA_UL sic@
        var integer v_Counter := 0;
        var integer v_PreviousSfn := -1;  //@sic R5s190776, R5s190897 sic@
        var integer v_CurrentSfn;         //@sic R5s190776 sic@
        var float v_MinTolerance := p_ReportInterval * 0.9;    //@sic R5s190776 sic@
        var float v_MaxTolerance := p_ReportInterval * 1.1;    //@sic R5s190776 sic@
        var float v_ExpectedInterval;     //@sic R5s190776 sic@
        
        var NR_SRB_COMMON_IND v_ReceivedMsg;
        var charstring v_VerdictMessage := "Received a measurement report for the measId " & int2str(p_MeasId);    //@sic R5s190426 sic@
        var template (present) MeasResults v_MeasResults;
        var template (present) MeasQuantityResults v_MeasQuantityResults;
        
        v_MeasQuantityResults := p_MeasQuantityResults; //@sic R5-211389 sic@
        
        if(ispresent(p_PhysCellId_SCell))  //@sic R5s201366 sic@
        {//CA case
            v_MeasResults := cr_38508_MeasResults_CA(p_MeasId,p_PhysCellId, valueof(p_PhysCellId_SCell), p_ServCellIndex_SCell, p_MeasResultNeighCells, p_MeasResultBestNeighCell_PCell, p_MeasResultBestNeighCell_SCell, v_MeasQuantityResults);
        }
        else if (ispresent(p_AltitudeUE_r18))  //@sic R5-255043 sic@
        {
            v_MeasResults := cr_38508_MeasResults_AltitudeUE(p_MeasId, p_PhysCellId, p_MeasResultNeighCells, v_MeasQuantityResults, p_AltitudeUE_r18);
            if (p_MeasResultServingMOList_NotChecked) {
              v_MeasResults.measResultServingMOList := ?;
            }
        }
        else
        {
            v_MeasResults := cr_38508_MeasResults(p_MeasId,p_PhysCellId, p_MeasResultNeighCells, v_MeasQuantityResults);
            if (p_MeasResultServingMOList_NotChecked) { //@sic R5-217997 sic@
              v_MeasResults.measResultServingMOList := ?;
            }
        }

        
        while (v_Counter<p_NumReports)
        {
            if(p_ReceiveOnSRB1)
            {
                SRB.receive(car_NR_SRB1_RrcPdu_IND(p_NR_CellId, cr_NR_MeasurementReport(v_MeasResults), -, p_MacBearerRoutingCA_UL)) -> value v_ReceivedMsg;
            }
            else
            {
                SRB.receive(car_NR_SRB3_RrcPdu_IND(p_NR_CellId, cr_NR_MeasurementReport(v_MeasResults), p_MacBearerRoutingCA_UL)) -> value v_ReceivedMsg;
            }
            if(p_ReportInterval > 0.0)
            { //@sic R5s190776 sic@
                v_CurrentSfn := v_ReceivedMsg.Common.TimingInfo.SubFrame.SFN.Number;
                if(v_PreviousSfn >= 0)  //@sic R5s190897 sic@
                {
                    v_ExpectedInterval := int2float((v_CurrentSfn - v_PreviousSfn +1024) mod 1024);
                    if(v_ExpectedInterval < v_MinTolerance or v_ExpectedInterval > v_MaxTolerance)
                    {
                          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Measurement report was received within a wrong interval");
                    }
                }
                v_PreviousSfn := v_CurrentSfn;
            }
            f_NR_PreliminaryPass (__FILE__, __LINE__, v_VerdictMessage);
            v_Counter := v_Counter +1;
        }
        
    };

  /*
   * @desc      Function to check if a measurement report has been received within a given time
   * @param     p_NR_CellId
   * @param     p_PhysCellId
   * @param     p_MeasId            (default value: tsc_NR_MeasId1)
   * @param     p_TimerValue
   * @param     p_MeasResultNeighCells (default value: omit)
   * @param     p_MeasQuantityResults (default value: f_NR_Get_MeasQuantityResults())
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
   function f_NR_CheckReceiveMeasurementReports(NR_CellId_Type p_NR_CellId,
                                                PhysCellId  p_PhysCellId,
                                                MeasId p_MeasId := tsc_NR_MeasId1,
                                                float p_TimerValue,
                                                template MeasResults.measResultNeighCells p_MeasResultNeighCells := omit,
                                                template (present) MeasQuantityResults p_MeasQuantityResults := f_NR_Get_MeasQuantityResults() //@sic R5s201018 sic@
                                                ) runs on NR_BASE_PTC
    { //@sic R5-197213, R5-195344, R5-201097 sic@
        
        timer t_Watchdog := p_TimerValue;
        
        t_Watchdog.start;
        alt
        {
        [] SRB.receive(car_NR_SRB1_RrcPdu_IND(p_NR_CellId, cr_NR_MeasurementReport(cr_38508_MeasResults(p_MeasId,p_PhysCellId, p_MeasResultNeighCells, p_MeasQuantityResults)))) //@sic R5s201018 sic@
           {
               t_Watchdog.stop;
               f_NR_PreliminaryPass (__FILE__, __LINE__, "Measurement report has been received");
           }

        [] t_Watchdog.timeout
           {
               f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Check failed: No correct Measurement report was received in time");
        
           }
        }
        
    };

  /*
   * @desc      Function to check if expected measurement report has been received within a given time
   * @param     p_NR_CellId
   * @param     p_TimerValue
   * @param     p_NumReports        (default value: 1)
   * @param     p_ExpectedMeasReport
   * @param     p_ReceiveOnSRB1     (default value: true)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
   function f_NR_ReceivePeriodicalMeasurementReports(NR_CellId_Type p_NR_CellId,
                                          float p_TimerValue,
                                          integer p_NumReports := 1,
                                          template (present) UL_DCCH_Message p_ExpectedMeasReport,
                                          boolean p_ReceiveOnSRB1 := true //@sic R5s201080 sic@
                                          ) runs on NR_BASE_PTC
    {
        var integer v_ReportCounter := 0;
        timer t_Watchdog := p_TimerValue;
        
        t_Watchdog.start;
        alt
        {
        [p_ReceiveOnSRB1] SRB.receive(car_NR_SRB1_RrcPdu_IND(p_NR_CellId, p_ExpectedMeasReport))
           {
                v_ReportCounter := v_ReportCounter + 1;
               if (v_ReportCounter == p_NumReports)
               {
                   t_Watchdog.stop;
                   f_NR_PreliminaryPass (__FILE__, __LINE__, "All reports have been received");
                   
               }
               else
               {
                   repeat;
               }
               
           } //@sic R5s201080 sic@
        [not p_ReceiveOnSRB1] SRB.receive(car_NR_SRB3_RrcPdu_IND(p_NR_CellId, p_ExpectedMeasReport))
           {
                v_ReportCounter := v_ReportCounter + 1;
               if (v_ReportCounter == p_NumReports)
               {
                   t_Watchdog.stop;
                   f_NR_PreliminaryPass (__FILE__, __LINE__, "All reports have been received");
                   
               }
               else
               {
                   repeat;
               }
               
           } //@sic R5s201080 sic@
        []t_Watchdog.timeout
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Check failed: not all reports were received in time");
        
        }
      }
        
    };

  /*
   * @desc      Send RRC Reconfiguration message with measurement config
   *            and receive RRC Reconfiguration Complete
   * @param     p_NR_CellId
   * @param     p_MeasConfig
   * @param     p_MeasObjectId_SCell (default value: omit)
   * @param     p_MeasObjectId_SpCell (default value: tsc_NR_MeasObjectId1)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ReceiveForRRCreconfigurationComplete (default value: true)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @param     p_MacBearerRoutingCA (default value: omit)
   * @param     p_OtherConfig_v1610 (default value: omit)
   * @param     p_RRCReconfiguration_v1700_IEs (default value: omit)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_SendRRCReconfiguration_MeasNR(NR_CellId_Type p_NR_CellId,
                                              template (omit) MeasConfig p_MeasConfig,
                                              template (omit) MeasObjectId p_MeasObjectId_SCell := omit,
                                              template (value) MeasObjectId p_MeasObjectId_SpCell := tsc_NR_MeasObjectId1,
                                              template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                              boolean p_ReceiveForRRCreconfigurationComplete := true,
                                              NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1,
                                              template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit,
                                              template (omit) OtherConfig_v1610 p_OtherConfig_v1610 := omit, //@sic R5-231194,R5-231195 sic@
                                              template (omit) RRCReconfiguration_v1700_IEs p_RRCReconfiguration_v1700_IEs := omit //@sic R5-255040 sic@
                                              ) runs on NR_BASE_PTC
  {//@sic R5-198871, R5-201214, R5-201236, R5-213516: added p_MacBearerRoutingCA sic@
    var SubFrameTiming_Type v_Timing;
    var template (value) DL_DCCH_Message v_RrcMsg;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (omit) SCellConfig v_SCellConfig := omit;
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_NR_CellId); //@sic R5s201387 sic@
    
    v_CellGroupConfig := cs_NR_CellGroupConfigMeas(v_CellGroupId,
                                                   cs_NR_SpCellConfigDef(v_CellGroupId,
                                                                           -,
                                                                           -,
                                                                           cs_NR_ServingCellConfigMeas(p_MeasObjectId_SpCell)));
      
    if(ispresent(p_MeasObjectId_SCell))  //@sic R5s201366 sic@
    {//@sic R5-201224 sic@
        v_SCellConfig := cs_SCellConfig_Def(omit,cs_NR_ServingCellConfigMeas(p_MeasObjectId_SCell), tsc_NR_SCellIndex_1);  //warning can be ignored due to check
        v_CellGroupConfig.sCellToAddModList := {v_SCellConfig};
    }


    v_RrcMsg := cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def,
                                            omit,
                                            -,
                                            p_MeasConfig,
                                            cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_CellGroupConfig)),-,-,-,-,cs_RRCReconfiguration_v1540_IEs(-,cs_RRCReconfiguration_v1560_IEs(-, -, -, cs_RRCReconfiguration_v1610_IEs(-,-,p_OtherConfig_v1610,-,-,p_RRCReconfiguration_v1700_IEs))))); //@sic R5-255040 sic@

    if (ispresent(p_MeasConfig.measGapConfig)) {  //@sic R5s201366 sic@
      //If MeasGap is to be configured send RRCReconfiguration with activation time and 5ms later configure the MeasGap in the SS
      v_Timing := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
      SRB.send(cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, p_SRB, cs_TimingInfo_NR(v_Timing), v_RrcMsg, p_MacBearerRoutingCA));
      
      v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, 5);   // add 5ms
      f_NR_SS_MeasGapCtrlConfig(p_NR_CellId, cs_NR_MeasGapCtrl_Config(p_MeasConfig.measGapConfig), cs_TimingInfo_NR(v_Timing)); //warning can be ignored due to check
    }
    else {
      SRB.send(cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, p_SRB, p_TimingInfo, v_RrcMsg, p_MacBearerRoutingCA));
    }

    if (p_ReceiveForRRCreconfigurationComplete){
        SRB.receive(car_NR_SRB_RrcPdu_IND(p_NR_CellId, p_SRB, cr_38508_RRCReconfigurationComplete, -, p_MacBearerRoutingCA));
    }
  }

  /*
   * @desc      Send RRC Reconfiguration message with measurement config including CellGroupConfig-DRX
   *            and receive RRC Reconfiguration Complete
   * @param     p_NR_CellId
   * @param     p_MeasConfig
   * @param     p_MeasObjectId_SCell (default value: omit)
   * @param     p_MAC_CellGroupConfig
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ReceiveForRRCreconfigurationComplete (default value: true)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_SendRRCReconfiguration_MeasNR_CellGroupConfig_DRX(NR_CellId_Type p_NR_CellId,
                                                                  template (omit) MeasConfig p_MeasConfig,
                                                                  template (omit) MeasObjectId p_MeasObjectId_SCell := omit,
                                                                  template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig,
                                                                  template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                  boolean p_ReceiveForRRCreconfigurationComplete := true,
                                                                  NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1
                                                                  ) runs on NR_BASE_PTC
  {//@sic R5-201138, R5-201139, R5-198871, R5-201214, R5-201236  sic@
    var SubFrameTiming_Type v_Timing;
    var template (value) DL_DCCH_Message v_RrcMsg;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (omit) SCellConfig v_SCellConfig := omit;
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_NR_CellId); //@sic R5s201387 sic@

    v_CellGroupConfig := cs_38508_CellGroupConfig(v_CellGroupId, omit, omit, p_MAC_CellGroupConfig, omit, omit, omit, omit);
      
    if(ispresent(p_MeasObjectId_SCell))  //@sic R5s201366 sic@
    {//@sic R5-201224 sic@
        v_SCellConfig := cs_SCellConfig_Def(omit,cs_NR_ServingCellConfigMeas(p_MeasObjectId_SCell), tsc_NR_SCellIndex_1);  //warning can be ignored due to check
        v_CellGroupConfig.sCellToAddModList := {v_SCellConfig};
    }


    v_RrcMsg := cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def,
                                            omit,
                                            -,
                                            p_MeasConfig,
                                            cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_CellGroupConfig))));

    if (ispresent(p_MeasConfig.measGapConfig)) {  //@sic R5s201366 sic@
      //If MeasGap is to be configured send RRCReconfiguration with activation time and 5ms later configure the MeasGap in the SS
      v_Timing := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
      SRB.send(cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, p_SRB, cs_TimingInfo_NR(v_Timing), v_RrcMsg));
      
      v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, 5);   // add 5ms
      f_NR_SS_MeasGapCtrlConfig(p_NR_CellId, cs_NR_MeasGapCtrl_Config(p_MeasConfig.measGapConfig), cs_TimingInfo_NR(v_Timing)); //warning can be ignored due to check
    }
    else {
      SRB.send(cas_NR_SRB_RrcPdu_REQ(p_NR_CellId, p_SRB, p_TimingInfo, v_RrcMsg));
    }

    if (p_ReceiveForRRCreconfigurationComplete){
        SRB.receive(car_NR_SRB_RrcPdu_IND(p_NR_CellId, p_SRB, cr_38508_RRCReconfigurationComplete));
    }
  }

}
