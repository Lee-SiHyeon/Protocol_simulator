module HTTP_XCAP_Component {

  import from HTTP_ASP_TypeDefs all;
  import from HTTP_XCAP_CoordMsg all;
  import from XCAP_ASP_TypeDefs all;

  type component HTTP_XCAP_PTC { /* @status    APPROVED (IMS) */

    // port to IMS components
    port XCAP_IMS_CO_ORD_PORT IMS;

    port HTTP_CTRL_PORT HTTPCTRL;
    port HTTP_DATA_PORT HTTPDATA;

    port XCAP_PORT XCAP;     /* Simulates XCAP Server in the NW. See TS 24.623 clause 5.1 */
  };

  type component HTTP_XCAP_SYSTEM {  /* @status    APPROVED (IMS) */
    port XCAP_PORT Xcap;
  };

  /*
   * @desc      create and map HTTP PTC
   * @param     p_System
   * @return    HTTP_XCAP_PTC
   * @status    APPROVED (IMS)
   */
  function f_HTTP_XCAP_PTC_CreateAndMap(HTTP_XCAP_SYSTEM p_System) return HTTP_XCAP_PTC
  {
    var HTTP_XCAP_PTC v_HTTP_XCAP_PTC := HTTP_XCAP_PTC.create("HTTP_XCAP") alive;    // @sic R5s210270 sic@
    
    map(v_HTTP_XCAP_PTC:XCAP, p_System:Xcap);

    return v_HTTP_XCAP_PTC;
  }

}
