    s_RNTI := '00000000000001010101'B
  };

  template (value) UTRAN_FDD_Frequency cs_UTRAN_FDD_Frequency_Priority(UARFCN p_UARFCN,
                                                                       integer p_Priority,
                                                                       integer p_ThreshXhigh,
                                                                       integer p_ThreshXlow,
                                                                       template (omit) integer p_Q_QualMinFDD := omit,
                                                                       template (omit) integer p_Q_RxLevMinFDD := omit):=
  { /* @status    APPROVED (UTRAN) */
    uarfcn := p_UARFCN,
    priority := p_Priority,
    threshXhigh := p_ThreshXhigh,
    threshXlow := p_ThreshXlow,
    qQualMinFDD := p_Q_QualMinFDD,
    qRxLevMinFDD := p_Q_RxLevMinFDD
  };

  template (value) DL_DCCH_Message cs_108_CellUpdateCnf_r8(IntegrityCheckInfo p_IntegrityCheckInfo,
                                                           template (omit) U_RNTI      p_U_RNTI := omit,
                                                           template (omit) C_RNTI      p_C_RNTI := omit,
                                                           template (omit) RRC_StateIndicator p_RRC_StateIndicator :=cell_FACH,
                                                           template (omit) DSCH_RNTI   p_DSCH_RNTI := omit,
                                                           template (omit) H_RNTI      p_H_RNTI := omit,
                                                           template (omit) E_RNTI      p_E_RNTI_prim := omit,
                                                           template (omit) UL_DPCH_Info_r7 p_UL_DPCH_Info := omit,
                                                           template (omit) DL_CommonInformation_r8 p_DL_CommonInformation := omit,
                                                           template (omit) DL_InformationPerRL_List_r8 p_DL_InformationPerRL_List := omit,
                                                           template (omit) UL_CommonTransChInfo_r4 p_UL_CommonTransChInfo := omit,
                                                           template (omit) UL_AddReconfTransChInfoList_r8 p_UL_AddReconfTransChInfoList := omit,
                                                           template (omit) DL_CommonTransChInfo_r4 p_DL_CommonTransChInfo := omit,
                                                           template (omit) DL_AddReconfTransChInfoList_r7 p_DL_AddReconfTransChInfoList := omit,
                                                           template (omit) RB_InformationReconfigList_r8 p_RB_InformationReconfigList:= omit,
                                                           template (omit) RB_InformationAffectedList_r8 p_RB_InformationAffectedList := omit,
                                                           template (omit) RB_InformationReleaseList p_RB_InformationReleaseList := omit,
                                                           RRC_TransactionIdentifier   p_RRC_TI := tsc_RRC_TI) :=
  { /* @status    APPROVED (UTRAN) */
    integrityCheckInfo := p_IntegrityCheckInfo,
    message_ := {
      cellUpdateConfirm  := {
        later_than_r3 := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions  :={
            criticalExtensions := {
              criticalExtensions   := {
                criticalExtensions := {
                  criticalExtensions  := {
                    r8 := {
                      cellUpdateConfirm_r8 := {
                        integrityProtectionModeInfo         := omit,
                        cipheringModeInfo                   := omit,
                        activationTime                      := omit,
                        new_U_RNTI                          := p_U_RNTI,
                        new_C_RNTI                          := p_C_RNTI,
                        new_DSCH_RNTI                       := p_DSCH_RNTI,
                        new_H_RNTI                          := p_H_RNTI,
                        newPrimary_E_RNTI                   := p_E_RNTI_prim,
                        newSecondary_E_RNTI                 := omit,
                        rrc_StateIndicator                  := p_RRC_StateIndicator,
                        utran_DRX_CycleLengthCoeff          := omit,
                        waitTime                            := omit,
                        rlc_Re_establishIndicatorRb2_3or4   := false,
                        rlc_Re_establishIndicatorRb5orAbove := false,
                        cn_InformationInfo                  := omit,
                        ura_Identity                        := omit,
                        supportForChangeOfUE_Capability     := omit,
                        dummy                               := omit,
                        rab_InformationSetup                := omit,
                        rb_InformationReleaseList           := p_RB_InformationReleaseList,
                        rb_InformationReconfigList          := p_RB_InformationReconfigList,
                        rb_InformationAffectedList          := p_RB_InformationAffectedList,
                        dl_CounterSynchronisationInfo       := omit,
                        pdcp_ROHC_TargetMode                := omit,
                        ul_CommonTransChInfo                := p_UL_CommonTransChInfo,
                        ul_deletedTransChInfoList           := omit,
                        ul_AddReconfTransChInfoList         := p_UL_AddReconfTransChInfoList,
                        dl_CommonTransChInfo                := p_DL_CommonTransChInfo,
                        dl_DeletedTransChInfoList           := omit,
                        dl_AddReconfTransChInfoList         := p_DL_AddReconfTransChInfoList,
                        frequencyInfo                       := omit,
                        multi_frequencyInfo                 := omit,
                        dtx_drx_TimingInfo                  := omit,
                        dtx_drx_Info                        := omit,
                        hs_scch_LessInfo                    := omit,
                        mimoParameters                      := omit,
                        maxAllowedUL_TX_Power               := omit,
                        ul_DPCH_Info                        := p_UL_DPCH_Info,
                        ul_EDCH_Information                 := omit,
                        dl_HSPDSCH_Information              := omit,
                        dl_CommonInformation                := p_DL_CommonInformation,
                        dl_InformationPerRL_List            := p_DL_InformationPerRL_List,
                        dl_SecondaryCellInfoFDD             := omit,
                        controlChannelDRXInfo_TDD128        := omit,
                        sps_Information_TDD128              := omit,
                        mbms_PL_ServiceRestrictInfo         := omit
                      },
                      cellUpdateConfirm_r8_add_ext := omit,
                      v7d0NonCriticalExtensions := omit
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  };

  template (present) UL_DCCH_Message cr_108_TrChReconfCmpl_Any(RRC_TransactionIdentifier p_RRC_TransactionIdentifier) :=
