module MTC_Component_LTE_V2X {

  import from MTC_Component_LTE_SL all;
  import from PosSystem_ASP_TypeDefs all;

  type component MTC_LTE_V2X extends MTC_LTE_SL { /* @status    APPROVED (LTE_A_PRO) */

    // System Ports:
    port POS_MTC_SYSTEM_PORT    POSSYS;        // Positioning: Port at MTC connected to the system interface
    
    // Coordination Port:
    port POS_MTC_PTC_PORT       EUTRA_POSSYS;
  };

  type component SYSTEM_LTE_V2X extends SYSTEM_LTE_SL { /* @status    APPROVED (LTE_A_PRO) */
    port POS_MTC_SYSTEM_PORT POSSYS;
  };

}
