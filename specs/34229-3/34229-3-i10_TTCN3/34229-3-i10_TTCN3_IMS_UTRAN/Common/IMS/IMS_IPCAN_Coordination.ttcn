module IMS_IPCAN_Coordination {

  import from IMS_PTC_CoordMsg all;
  import from NAS_CommonTypeDefs all;

  template (value) IMS_IPCAN_Coordination_MSG cms_IMS_IPCAN_InitReq(IMS_TestConfiguration_Type p_TestConfiguration, template (omit) IMS_TestProcedure_Type p_TestProcedure)    := cms_IMS_IPCAN_Command(IPCAN_INIT, p_TestConfiguration, p_TestProcedure);          /* @status    APPROVED (IMS, MCX) @sic R5s220611 sic@ */

  template (value) IMS_IPCAN_Coordination_MSG cms_IMS_IPCAN_StartProcedureReq(IMS_TestProcedure_Type p_TestProcedure, template (omit) IMS_TestConfiguration_Type p_TestConfiguration := omit)  := cms_IMS_IPCAN_Command(IPCAN_STARTPROCEDURE, p_TestConfiguration, p_TestProcedure); /* @status    APPROVED (IMS, MCX) @sic R5-225426 sic@*/

  template (value) IMS_IPCAN_Coordination_MSG cms_IMS_IPCAN_EndProcedureReq(template (omit) IMS_TestProcedure_Type p_TestProcedure, template (omit) IMS_TestConfiguration_Type p_TestConfiguration := omit) := cms_IMS_IPCAN_Command(IPCAN_ENDPROCEDURE, p_TestConfiguration, p_TestProcedure);   /* @status    APPROVED (IMS, MCX) @sic R5-216220 sic@ */

  template (value) IMS_IPCAN_Coordination_MSG cms_IMS_IPCAN_ReleaseReq                                                 := cms_IMS_IPCAN_Command(IPCAN_RELEASE);                            /* @status    APPROVED (IMS, MCX) */

  template (value) IMS_IPCAN_Coordination_MSG cms_IMS_ProtocolConfigurationOptions(template (value) NAS_ProtocolConfigOptions_Type p_ProtocolConfigurationOptions) :=
  { /* @status    APPROVED (IMS) */
    ProtocolConfigOptions := p_ProtocolConfigurationOptions
  };

  template (present) IMS_IPCAN_Coordination_MSG cmr_IMS_ProtocolConfigurationOptions :=
  { /* @status    APPROVED (IMS) */
    ProtocolConfigOptions := ?
  };

  /*
   * @desc      Initialise IPCAN
   * @param     p_Port
   * @param     p_TestConfiguration
   * @param     p_TestProcedure     (default value: omit)
   * @status    APPROVED (IMS, MCX)
   */
  function f_IMS_IPCAN_Init(IMS_IPCAN_CO_ORD_PORT p_Port,
                            IMS_TestConfiguration_Type p_TestConfiguration,
                            template (omit) IMS_TestProcedure_Type p_TestProcedure := omit)
  { /* p_TestConfiguration specifies the DRBs needed by the test cases so that IPCAN can do pre-configuration of DRBs accordingly */
    p_Port.send(cms_IMS_IPCAN_InitReq(p_TestConfiguration, p_TestProcedure)); // @sic R5s220611 sic@
    alt {
      [] p_Port.receive(cmr_IPCAN_IMS_Response) {}
      [] a_IMS_IPCAN_Default(p_Port) {}
    }
  }

  /*
   * @desc      trigger start of test procedure at the IPCAN PTC (e.g. InitialRegistration, MO Speech Call, etc.)
   * @param     p_Port
   * @param     p_TestProcedure
   * @param     p_TestConfiguration (default value: omit)
   * @status    APPROVED (IMS, MCX)
   */
  function f_IMS_IPCAN_StartProcedure(IMS_IPCAN_CO_ORD_PORT p_Port,
                                      IMS_TestProcedure_Type p_TestProcedure,
                                      template (omit) IMS_TestConfiguration_Type p_TestConfiguration := omit)
  {
    p_Port.send(cms_IMS_IPCAN_StartProcedureReq(p_TestProcedure, p_TestConfiguration));  //@sic R5-225426 sic@
  }

  /*
   * @desc      terminate a (current) test procedure
   * @param     p_Port
   * @param     p_TestProcedure
   * @param     p_TestConfiguration (default value: omit)
   * @param     p_WaitForTrigger    (default value: true)
   * @status    APPROVED (IMS, MCX)
   */
  function f_IMS_IPCAN_EndProcedure(IMS_IPCAN_CO_ORD_PORT p_Port,
                                    template (omit) IMS_TestProcedure_Type p_TestProcedure,
                                    template (omit) IMS_TestConfiguration_Type p_TestConfiguration := omit,
                                    boolean p_WaitForTrigger := true)
  {
    p_Port.send(cms_IMS_IPCAN_EndProcedureReq(p_TestProcedure, p_TestConfiguration)); // @sic R5-216220 sic@
    if (p_WaitForTrigger) {
      f_IMS_IPCAN_WaitForTrigger(p_Port);
    }
  }

  /*
   * @desc      Wait for PCOs from IMS/IPCAN PTC
   * @param     p_Port
   * @return    NAS_ProtocolConfigOptions_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_IPCAN_WaitForPCOs(IMS_IPCAN_CO_ORD_PORT p_Port) return NAS_ProtocolConfigOptions_Type
  {
    var IMS_IPCAN_Coordination_MSG v_CoordinationMsg;

    alt {
      [] p_Port.receive(cmr_IMS_ProtocolConfigurationOptions) -> value v_CoordinationMsg {}
      [] a_IMS_IPCAN_Default(p_Port) {}
    }
    return v_CoordinationMsg.ProtocolConfigOptions;
  }

  /*
   * @desc      Send PCOs to the other side (IPCAN PTC)
   * @param     p_Port
   * @param     p_ProtocolConfigOptions
   * @status    APPROVED (IMS)
   */
  function f_IMS_IPCAN_SendPCOs(IMS_IPCAN_CO_ORD_PORT p_Port,
                                template (value) NAS_ProtocolConfigOptions_Type p_ProtocolConfigOptions)
  {
    f_IMS_IPCAN_SendCoOrdMsg(p_Port, cms_IMS_ProtocolConfigurationOptions(p_ProtocolConfigOptions));
  }

}
