        condHandoverWithCandSCG_FDD_TDD_Change_r18         := f_NR_MRDC_condHandoverWithCandSCG_FDD_TDD_change_r18()         // pc_condHandoverWithCandSCG_FDD_TDD_change_r18
       } ifpresent // MeasAndMobParametersMRDC-Common-v1810
