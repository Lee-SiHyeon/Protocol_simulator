  /*
   * @desc      Function that returns whether a given value is found on supportedBandList array of frequencies
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC, POS)
   */
  function fl_NR_FindEntries_FreqBandIndicatorNR(FreqBandIndicatorNR p_BandNR) return boolean
  {
    var boolean v_Found := false;
    var integer i:=0;

      while (i < lengthof(tsc_SupportedBandListNR) and (not v_Found)) {
         if (tsc_SupportedBandListNR[i] == p_BandNR){
           v_Found := true;
           break;
         }
         else {
           i:=i+1;
         }
      }

    return v_Found;
  };

  /*
   * @desc      Function that returns whether a given value is found on the HDD-FDD supportedBandList array of frequencies
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_FindEntries_HD_FDD_FreqBandIndicatorNR(FreqBandIndicatorNR p_BandNR) return boolean
  {
    var boolean v_Found := false;
    var integer i:=0;

      while (i < lengthof(tsc_SupportedBandListNR_HDFDD) and (not v_Found)) {
         if (tsc_SupportedBandListNR_HDFDD[i] == p_BandNR){
           v_Found := true;
           break;
         }
         else {
           i:=i+1;
         }
      }

    return v_Found;
  };

  /*
   * @desc      Returns true if only up to one of the three parameters is active and false otherwise
   * @param     p_FirstParameter
   * @param     p_SecondParameter
   * @param     p_ThirdParameter
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_UptoOneParameterSet (boolean p_FirstParameter,
                                  boolean p_SecondParameter,
                                  boolean p_ThirdParameter) return boolean
  {

    return (((not p_FirstParameter) and (not p_SecondParameter) and (not p_ThirdParameter)) or ((not p_FirstParameter) and (not p_SecondParameter) and p_ThirdParameter) or ((not p_FirstParameter) and p_SecondParameter and (not p_ThirdParameter)) or (p_FirstParameter and (not p_SecondParameter) and (not p_ThirdParameter)));
  }

  /*
   * @desc      Returns a usable integer value from the MIMO_LayersDL PICS set. Raises a verdict if more than one PICS is set. Zero (no PICS set) is a valid option.
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_MIMO_LayersDLParameterSet () return integer
  {
    var integer v_MIMO_LayersDLParameterSet := 0;

    if (f_UptoOneParameterSet(pc_maxNumberMIMO_LayersPDSCH_twoLayers, pc_maxNumberMIMO_LayersPDSCH_fourLayers, pc_maxNumberMIMO_LayersPDSCH_eightLayers))
    { // Case where as much only one is set
       if (pc_maxNumberMIMO_LayersPDSCH_twoLayers){
          v_MIMO_LayersDLParameterSet := 2;
       }
       if (pc_maxNumberMIMO_LayersPDSCH_fourLayers) {
          v_MIMO_LayersDLParameterSet := 4;
       }
       if (pc_maxNumberMIMO_LayersPDSCH_eightLayers){
          v_MIMO_LayersDLParameterSet := 8;
       }
    }
    else
    { // Fail case
       f_SetVerdict(inconc,__FILE__, __LINE__, "More than one MIMO_LayersPDSCH PICS are set simultaneously"); //@sic R5s230315 Ch. 2 sic@
    }


    return v_MIMO_LayersDLParameterSet;
  }

  /*
   * @desc      Return true if the input band is HAPS or NTN satellite operating bands
   * @param     p_FreqBandIndicatorNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_IsHAPSorNTNBand( FreqBandIndicatorNR p_FreqBandIndicatorNR ) return boolean
  {
    return (((p_FreqBandIndicatorNR > 253) and (p_FreqBandIndicatorNR < 257)) or ((p_FreqBandIndicatorNR > 509) and (p_FreqBandIndicatorNR < 513)) or (p_FreqBandIndicatorNR == 1));
  }

  /*
   * @desc      Returns whether input band belongs to the list of bands where standard requires 4 RX (reception) antennas for 5G bands with 3.5 GHz (TDD) as well as n7 2.6 GHz (FDD), n38 2.6 GHz (TDD) and n41 2.5 GHz (TDD).
   * @param     p_BandInNRCapability
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Is5GCoreBand(integer p_BandInNRCapability) return boolean
  {
    var integer v_Single_CC;
    var boolean v_Found := false;
    var integer v_Index := 0;
    var List_5G_CoreBand v_NR_CoreBand := {7,38,41,77,78,79};

    v_Single_CC := p_BandInNRCapability;

    while ((v_Index < lengthof(v_NR_CoreBand)) and (not v_Found))
    {
       if (v_Single_CC == v_NR_CoreBand[v_Index]) {
           v_Found := true;
       }
       v_Index := v_Index + 1;
    }
    return v_Found;
  };

  /*
   * @desc      Function checking whether the band is defined as its corresponding HD-FDD NR Bands PICS
   * @param     p_Band
   * @status    APPROVED (ENDC, NR5GC, POS)
   */
    function fl_CheckNRBandCapability(integer p_Band)
    {
      if (fl_NR_FindEntries_FreqBandIndicatorNR(p_Band)) {
         //UE reported a known FreqBandIndicatorNR, now check whether it is set on PICS pc_nrBandX_Supp accordingly
          if (not f_NR_ContentOf_pc_nrBandX(p_Band)) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "pc_nrBand" & int2str(p_Band) & "_Supp not set accordingly"); // @sic R5s200277 sic@
          }
      } // end of checks for IE bandNR

    }

 /*
  * @desc      Function to check MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 and pc_nrBand41_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16/pc_nrBand79_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 PICS. If there is a mismatch, a verdict is raised
  * @param     p_BandNR
  * @status    APPROVED (ENDC, NR5GC)
  */
  function fl_Check_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 (template (value) BandNR p_BandNR)
  { // @sic R5-225323 sic@
    var MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 v_PICS_MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16;
    var integer v_BandNR41or79 := valueof(p_BandNR.bandNR);//valueof not avoided but will not raise a runtime error because it is a mandatory field

    if (v_BandNR41or79 == 41){
      v_PICS_MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 := pc_nrBand41_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16;
    }
    else { //this function is called only in case of Band NR is 41 or 79
      v_PICS_MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 := pc_nrBand79_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16;
    } //no further checks


    if (isvalue(p_BandNR.maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16)){
       if (not (valueof(p_BandNR.maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16) == v_PICS_MaxUplinkDutyCycle_PC1dot5_MPE_FR1_r16)){ // valueof - no possible runtime error due to previous check
          f_SetVerdict(inconc,__FILE__, __LINE__, "pc_nrBand" & int2str(v_BandNR41or79) & "_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16 not correctly set");
       }
    }
  }

  /*
   * @desc      Returns whether field maxNumberCSI-RS-BFD is signalled by the UE and controls that matches with expected contents in TS 38.306, 4.2.7.2
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_maxNumberCSI_RS_BFD (BandNR p_BandNR) return boolean
  { // @sic R5s240587 sic@
    var boolean v_MaxNumberCSI_RS_BFD := false;

    if (isvalue(p_BandNR.mimo_ParametersPerBand)) { // mimo_ParametersPerBand signalled. Check error cases.
        if (isvalue(p_BandNR.mimo_ParametersPerBand.maxNumberCSI_RS_BFD)) { // maxNumberCSI_RS_BFD signalled.
           if (p_BandNR.mimo_ParametersPerBand.maxNumberCSI_RS_BFD > 16) {
              f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 field maxNumberCSI_RS_BFD shall be up to 16."); //In this release, the maximum value that can be signalled is 16
           }
           v_MaxNumberCSI_RS_BFD := true;
        }
    }
    return v_MaxNumberCSI_RS_BFD;
  }

  /*
   * @desc      Returns whether field maxNumberCSI-RS-SSB-CBD is signalled by the UE and controls that matches with expected contents in TS 38.306, 4.2.7.2
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_maxNumberCSI_RS_SSB_CBD (BandNR p_BandNR) return boolean
  {  // @sic R5s240587 sic@
    var boolean v_MaxNumberCSI_RS_SSB_CBD := false;
    var boolean v_IsFR2 := (not f_NR_IsBandFR1(p_BandNR.bandNR));

    if (isvalue(p_BandNR.mimo_ParametersPerBand)) { // mimo_ParametersPerBand signalled. Check error cases.
       if (isvalue(p_BandNR.mimo_ParametersPerBand.maxNumberCSI_RS_SSB_CBD)) { // maxNumberCSI_RS_SSB_CBD signalled.
           if ((v_IsFR2 and (p_BandNR.mimo_ParametersPerBand.maxNumberCSI_RS_SSB_CBD < 32)) or (p_BandNR.mimo_ParametersPerBand.maxNumberCSI_RS_SSB_CBD > 128))
           {
              f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 the maximum value that can be signalled for maxNumberCSI-RS-SSB-CBD is 128 and at least 32 for FR2"); //See TS 38.306, 4.2.7.2 - maxNumberCSI-RS-SSB-CBD
           }
           v_MaxNumberCSI_RS_SSB_CBD := true;
       }
    }

    return v_MaxNumberCSI_RS_SSB_CBD;
  }

  /*
   * @desc      Returns whether field mTRP-PUSCH-cyclicMapping-r17 is signalled by the UE and controls that matches with expected contents in TS 38.306, 4.2.7.2
   * @param     p_BandNR
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_mTRP_PUSCH_cyclicMapping_r17 (BandNR p_BandNR) return boolean
  {
    var boolean v_MTRP_PUSCH_cyclicMapping_r17 := false;

    if (isvalue(p_BandNR.mimo_ParametersPerBand) and (isvalue(p_BandNR.mimo_ParametersPerBand.mTRP_PUSCH_cyclicMapping_r17))) { // mTRP-PUSCH-cyclicMapping-r17 signalled.
       if (not (match(p_BandNR.mimo_ParametersPerBand.mTRP_PUSCH_cyclicMapping_r17, (typeA, typeB, both)))) {
          f_SetVerdict(fail,__FILE__, __LINE__, "mTRP_PUSCH_cyclicMapping_r17 is not correctly signalled by UE as per TS 38.306, 4.2.7.2");
       }
       v_MTRP_PUSCH_cyclicMapping_r17 := true;
    }
    return v_MTRP_PUSCH_cyclicMapping_r17;
  }

  /*
   * @desc      Function to fully check feature nes-CellDTX-DRX-r18 BandNR parameters acc. to TS38.306 cl. 4.2.7.2. If there is a mismatch, a verdict is raised.
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_Rf_Parameters_nes_CellDTX_DRX_r18 (UE_NR_Capability p_NRCapability)
  { // @sic R5-250329 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Index;

    var boolean v_Found_nes_CellDTX_r18 := false;      //  pc_nes_CellDTX_r18
    var boolean v_Found_nes_CellDRX_r18 := false;      //  pc_nes_CellDRX_r18
    var boolean v_Found_nes_CellDTX_DRX_r18 := false;

      v_Received_NRCapabilityMsg := p_NRCapability;
      v_Index := 0;
      while (v_Index < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR)) { //Condition Rel-18 already checked in call to function
         if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].nes_CellDTX_DRX_r18)) {

            if (match((v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].nes_CellDTX_DRX_r18),cellDTXonly)) {//pc_longDRX_Cycle
               v_Found_nes_CellDTX_r18 := true;
            }
            else if (match((v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].nes_CellDTX_DRX_r18),cellDRXonly)) {
               v_Found_nes_CellDRX_r18 := true;
            }
            else if (match((v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].nes_CellDTX_DRX_r18),both)) {
               v_Found_nes_CellDTX_DRX_r18 := true;
            }
            else {
               f_SetVerdict(fail,__FILE__, __LINE__, "UE does not signal nes_CellDTX_DRX_r18 correctly");
            }
         }
         v_Index:=v_Index+1;
      }

      if ((v_Found_nes_CellDTX_r18 or v_Found_nes_CellDTX_DRX_r18) and (not pc_longDRX_Cycle)) {
        f_SetVerdict(inconc,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2  a UE setting nes-CellDTX-DRX-r18 to value 'cellDTXonly' or 'both' shall also indicate support of longDRX-Cycle.");
      }

      f_CompareCapability_vs_PICS(pc_nes_CellDTX_r18, v_Found_nes_CellDTX_r18,"nes-CellDTX-r18");
      f_CompareCapability_vs_PICS(pc_nes_CellDRX_r18, v_Found_nes_CellDRX_r18,"nes-CellDRX-r18");
      f_CompareCapability_vs_PICS((pc_nes_CellDTX_r18 and v_Found_nes_CellDRX_r18), v_Found_nes_CellDTX_DRX_r18,"nes-CellDTX-DRX-r18");
  }

  /*
   * @desc      Function to fully check feature pdsch_256QAM_FR2 and pusch_256QAM per NR Band supported PICS and rf_Parameters PICS acc. to TS38.306 cl. 4.2.7.2. If there is a mismatch, a verdict is raised. Notes 8 and 9 of UE-NR-Capability Table
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_Rf_Parameters_PDSCH_PUSCH_256QAM (UE_NR_Capability p_NRCapability)
  { // @sic R5-232202 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var FreqBandIndicatorNR v_Band;
    var integer v_Index;

    var boolean v_Found_Pdsch_256QAM_FR2 := false;
    var boolean v_Found_Pusch_256QAM_FR2 := false;
    var boolean v_Found_Pusch_256QAM_FR1 := false;

      v_Received_NRCapabilityMsg := p_NRCapability;
      v_Index := 0;
      while ((v_Index < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR)) and ((not v_Found_Pdsch_256QAM_FR2) or (not v_Found_Pusch_256QAM_FR2) or (not v_Found_Pusch_256QAM_FR1))) {
          v_Band := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR;
          if (v_Band >= 257){ // Note8 and Note9 (FR2) of UE-NR-Capability table
               if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].pdsch_256QAM_FR2)) {
                  v_Found_Pdsch_256QAM_FR2 := true;
               }
               if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].pusch_256QAM)) {
                  v_Found_Pusch_256QAM_FR2 := true;
               }
          }
          else {              // Note9 (FR1) of UE-NR-Capability table
               if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].pusch_256QAM)) {
                  v_Found_Pusch_256QAM_FR1 := true;
               }
          }
          v_Index:=v_Index+1;
      }

      f_CompareCapability_vs_PICS(pc_pdsch_256QAM_FR2, v_Found_Pdsch_256QAM_FR2,"Pdsch-256QAM-FR2");
      f_CompareCapability_vs_PICS(pc_pusch_256QAM_FR2, v_Found_Pusch_256QAM_FR2,"Pusch-256QAM-FR2");
      f_CompareCapability_vs_PICS(pc_pusch_256QAM_FR1, v_Found_Pusch_256QAM_FR1,"Pusch-256QAM-FR1");
  }

  /*
   * @desc      Function to check setting feature bwp_DiffNumerology acc. to TS38.306 cl. 4.2.7.2. If there is a mismatch, a verdict is raised. Note 20 of UE-NR-Capability tables
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_Rf_Parameters_bwp_DiffNumerology (UE_NR_Capability p_NRCapability)
  { // @sic R5-232202 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var FreqBandIndicatorNR v_Band;
    var integer v_Index;
    var boolean v_Found_bwp_DiffNumerology_FR1_FDD := false;
    var boolean v_Found_bwp_DiffNumerology_FR1_TDD := false;
    var boolean v_Found_bwp_DiffNumerology_FR2 := false;

      v_Received_NRCapabilityMsg := p_NRCapability;
      v_Index := 0;
      while ((v_Index < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR)) and ((not v_Found_bwp_DiffNumerology_FR1_FDD) or (not v_Found_bwp_DiffNumerology_FR1_TDD) or (not v_Found_bwp_DiffNumerology_FR2))) {
          v_Band := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR;

        if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_DiffNumerology)) {

            if (not (match(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_DiffNumerology, upto4))) {
                 f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 field bwp-DiffNumerology shall be set to upto4 if supported.");
            }

            if (v_Band >= 257){ // FR2
                 v_Found_bwp_DiffNumerology_FR2 := true;
            }
            else {              // FR1
               if (f_NR_IsBandFDD(v_Band)){
                 v_Found_bwp_DiffNumerology_FR1_FDD := true;
               }
               else {
                 v_Found_bwp_DiffNumerology_FR1_TDD := true;
               }
            }
        }
          v_Index:=v_Index+1;
      }

      f_CompareCapability_vs_PICS(pc_bwp_DiffNumerology_FR2, v_Found_bwp_DiffNumerology_FR2,"bwp-DiffNumerology-FR2");
      f_CompareCapability_vs_PICS(pc_bwp_DiffNumerology_FR1_FDD, v_Found_bwp_DiffNumerology_FR1_FDD,"bwp-DiffNumerology-FR1-FDD");
      f_CompareCapability_vs_PICS(pc_bwp_DiffNumerology_FR1_TDD, v_Found_bwp_DiffNumerology_FR1_TDD,"bwp-DiffNumerology-FR1-TDD");
  }

  /*
   * @desc      Function to check setting bwp_SameNumerology acc. to TS 38.306 cl. 4.2.7.2. If there is a mismatch, a verdict is raised. Note 21 of UE-NR-Capability tables
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_Rf_Parameters_bwp_SameNumerology (UE_NR_Capability p_NRCapability)
  { // @sic R5-232202 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var FreqBandIndicatorNR v_Band;
    var integer v_Index;

    var boolean v_Found_bwp_SameNumerology_upto2_FR1_FDD := false;
    var boolean v_Found_bwp_SameNumerology_upto2_FR1_TDD := false;
    var boolean v_Found_bwp_SameNumerology_upto2_FR2 := false;
    var boolean v_Found_bwp_SameNumerology_upto4_FR1_FDD := false;
    var boolean v_Found_bwp_SameNumerology_upto4_FR1_TDD := false;
    var boolean v_Found_bwp_SameNumerology_upto4_FR2 := false;
    var BandNR.bwp_SameNumerology v_Value_bwp_SameNumerology;

      v_Received_NRCapabilityMsg := p_NRCapability;
      v_Index := 0;
      while ((v_Index < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR)) and ((not v_Found_bwp_SameNumerology_upto2_FR1_FDD) or (not v_Found_bwp_SameNumerology_upto2_FR1_TDD) or (not v_Found_bwp_SameNumerology_upto2_FR2) or (not v_Found_bwp_SameNumerology_upto4_FR1_FDD) or (not v_Found_bwp_SameNumerology_upto4_FR1_TDD) or (not v_Found_bwp_SameNumerology_upto4_FR2))) {
          v_Band := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR;

        if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_SameNumerology)) {

            v_Value_bwp_SameNumerology := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_SameNumerology;
            if (not (match(v_Value_bwp_SameNumerology, (upto2, upto4)))){
                 f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS 38.306 cl. 4.2.7.2 field bwp-SameNumerology shall be set to upto2 or upto4 if supported.");
            }

            if (v_Band >= 257){ // FR2
               if (v_Value_bwp_SameNumerology == upto2) {
                 v_Found_bwp_SameNumerology_upto2_FR2 := true;
               }
               else {
                 v_Found_bwp_SameNumerology_upto4_FR2 := true;
               }
            }
            else {              // FR1
               if (f_NR_IsBandFDD(v_Band)){  // FDD
                   if (v_Value_bwp_SameNumerology == upto2) {
                     v_Found_bwp_SameNumerology_upto2_FR1_FDD := true;
                   }
                   else {
                     v_Found_bwp_SameNumerology_upto4_FR1_FDD := true;
                   }
               }
               else {                        // TDD
                   if (v_Value_bwp_SameNumerology == upto2) {
                     v_Found_bwp_SameNumerology_upto2_FR1_TDD := true;
                   }
                   else {
                     v_Found_bwp_SameNumerology_upto4_FR1_TDD := true;
                   }
               }
            }
        }
          v_Index:=v_Index+1;
      }

      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto2_FR2, v_Found_bwp_SameNumerology_upto2_FR2,"bwp-SameNumerology-upto2-FR2");
      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto2_FR1_FDD, v_Found_bwp_SameNumerology_upto2_FR1_FDD,"bwp-SameNumerology-upto2-FR1-FDD");
      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto2_FR1_TDD, v_Found_bwp_SameNumerology_upto2_FR1_TDD,"bwp-SameNumerology-upto2-FR1-TDD");

      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto4_FR2, v_Found_bwp_SameNumerology_upto4_FR2,"bwp-SameNumerology-upto4-FR2");
      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto4_FR1_FDD, v_Found_bwp_SameNumerology_upto4_FR1_FDD,"bwp-SameNumerology-upto4-FR1-FDD");
      f_CompareCapability_vs_PICS(pc_bwp_SameNumerology_upto4_FR1_TDD, v_Found_bwp_SameNumerology_upto4_FR1_TDD,"bwp-SameNumerology-upto4-FR1-TDD");
  }

  /*
   * @desc      Function to fully check NR Band supported PICS and rf_Parameters PICS. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_Rf_Parameters_NRBand_PICS_Supp (UE_NR_Capability p_NRCapability,
                                                    NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-194844 R5-201141 R5-201123 R5-225384 R5s221147 R5-227571 R5-227572 R5-227573 R5-231410 R5-232202 R5-233295 R5-235311 R5-236307 R5-245527 R5-246407 R5-251949 R5-255069 R5-254821 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Index;
    var FreqBandIndicatorNR v_Band;
    var boolean v_Found_maxNumberCSI_RS_BFD := false;              //  pc_maxNumberCSI_RS_BFD
    var boolean v_Found_maxNumberCSI_RS_SSB_CBD := false;          //  pc_maxNumberCSI_RS_SSB_CBD
    var boolean v_Found_bwp_WithoutRestriction := false;

    var boolean v_Found_interFreqDAPS_r16 := false;
    var boolean v_Found_condHandover_r16 := false;
    var boolean v_Found_condHandoverFailure_r16 := false;
    var boolean v_Found_condHandoverTwoTriggerEvents_r16 := false;
    var boolean v_Found_condPSCellChange_r16 := false;
    var boolean v_Found_activeConfiguredGrant_r16 := false;
    var boolean v_Found_sps_r16 := false;                     //  @sic R5-236307 sic@ - pc_multi_sps_r16
    var boolean v_Found_txDiversity_r16 := false;             //  pc_txDiversity_r16  - only specified in NR5GC so far in FR1
    var boolean v_Found_ul_Semi_StaticChAccess_r16 := false;             //  pc_ul_Semi_StaticChAccess_r16
    var boolean v_Found_ul_DynamicChAccess_r16     := false;             //  pc_ul_DynamicChAccess_r16
    var boolean v_Found_rssi_ChannelOccupancyReporting_r16 := false;     //  pc_rssi_ChannelOccupancyReporting_r16
    var boolean v_Found_scellDormancyOutsideActiveTime_r16 := false;
    var boolean v_BWP_SameNumerology_Set := (pc_bwp_SameNumerology_upto2_FR1_FDD or pc_bwp_SameNumerology_upto2_FR1_TDD or pc_bwp_SameNumerology_upto2_FR2 or pc_bwp_SameNumerology_upto4_FR1_FDD or pc_bwp_SameNumerology_upto4_FR1_TDD or pc_bwp_SameNumerology_upto4_FR2);  //@sic R5-230775 sic@
    var boolean v_Found_PUSCH_RepetitionMultiSlots_v1650 := false;  //@sic R5s250367 sic@
    var boolean v_Type2_PUSCH_RepetitionMultiSlots := false; // found under Phy-Parameters.Phy-ParametersCommon

    var boolean v_Set_uplink_TA_Reporting_r17_InBand := false;
    var boolean v_Set_uplinkPreCompensation_r17_InBand := false;
    var boolean v_Found_cg_SDT_r17 := false;                     //  pc_cg_SDT_r17 - only present in NR5GC
    var boolean v_Found_timeBasedCondHandover_r17 := false;      //  pc_timeBasedCondHandover_r17
    var boolean v_Found_locationBasedCondHandover_r17 := false;  //  pc_locationBasedCondHandover_r17
    var boolean v_Found_unifiedJointTCI_r17 := false;            //  pc_unifiedJointTCI_r17
    var boolean v_Found_srs_partialFrequencySounding_r17 := false;       //  pc_srs_partialFrequencySounding_r17
    var boolean v_Found_srs_startRB_locationHoppingPartial_r17 := false; //  pc_srs_startRB_locationHoppingPartial_r17
    var boolean v_Found_unifiedSeparateTCI_multiMAC_CE_r17 := false;    //  pc_unifiedSeparateTCI_multiMAC_CE_r17
    var boolean v_Found_mTRP_PUSCH_cyclicMapping_r17 := false;          //  pc_mTRP_PUSCH_cyclicMapping_r17
    var boolean v_Found_sn_InitiatedCondPSCellChangeNRDC_r17 := false;  //  pc_sn_InitiatedCondPSCellChangeNRDC_r17
    var boolean v_Found_sssg_Switching_1BitInd_r17 := false;            //  pc_sssg_Switching_1BitInd_r17
    var boolean v_Found_sssg_Switching_2BitInd_r17 := false;            //  pc_sssg_Switching_2BitInd_r17
    var boolean v_Found_searchSpaceSetGrp_switchCap2_r17 := false;      //  pc_searchSpaceSetGrp_switchCap2_r17
    var boolean v_Found_eventA4BasedCondHandover_r17 := false;          //  pc_eventA4BasedCondHandover_r17
    var boolean v_Found_uplink_TA_Reporting_r17 := false;
    var boolean v_Found_ue_specific_K_Offset_r17 := false;
    var boolean v_HalfDuplexFDD_TypeA_RedCap_r17 := false;              //  pc_halfDuplexFDD_TypeA_RedCap_r17 - only present in RedCap or eRedCap UE FDD FR1
    var boolean v_Found_maxNumberPUSCH_TypeA_Repetition_r17 := false;   //  pc_maxNumberPUSCH_TypeA_Repetition_r17
    var boolean v_Found_puschTypeA_RepetitionsAvailSlot_r17 := false;   //  pc_puschTypeA_RepetitionsAvailSlot_r17
    var boolean v_Found_tb_ProcessingMultiSlotPUSCH_r17 := false;       //  pc_tb_ProcessingMultiSlotPUSCH_r17
    var boolean v_Found_tb_ProcessingRepMultiSlotPUSCH_r17 := false;    //  pc_tb_ProcessingRepMultiSlotPUSCH_r17
    var boolean v_Found_pusch_RepetitionMsg3_r17 := false;              //  pc_pusch_RepetitionMsg3_r17
    var boolean v_Found_bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17 := false;//  pc_bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17  - only present in NR5GC

    var boolean v_Found_nes_CellDTX_DRX_DCI2_9_r18 := false;            //  pc_nes_CellDTX_DRX_DCI2_9_r18
    var boolean v_Found_mt_CG_SDT_r18 := false;                         //  pc_mt_CG_SDT_r18
    var boolean v_Found_prach_CoverageEnh_r18 := false;                 //  pc_prach_CoverageEnh_r18
    var boolean v_Found_dynamicWaveformSwitchPHR_r18 := false;          //  pc_dynamicWaveformSwitchPHR_r18
    var boolean v_Found_dynamicWaveformSwitch_r18 := false;             //  pc_dynamicWaveformSwitch_r18
    var boolean v_Found_locationBasedCondHandoverATG_r18 := false;      //  pc_locationBasedCondHandoverATG_r18
    var boolean v_Found_ltm_BeamIndicationJointTCI_r18 := false;        //  pc_ltm_BeamIndicationJointTCI_r18
    var boolean v_Found_spatialAdaptation_CSI_Feedback_r18 := false;    //  pc_spatialAdaptation_CSI_Feedback_r18
    var boolean v_Found_spatialAdaptation_CSI_FeedbackAperiodic_r18 := false; //  pc_spatialAdaptation_CSI_FeedbackAperiodic_r18
    var boolean v_Found_powerAdaptation_CSI_FeedbackPUCCH_r18 := false; //  pc_powerAdaptation_CSI_FeedbackPUCCH_r18
    var boolean v_Found_ue_TA_Measurement_r18 := false;                 //  pc_ue_TA_Measurement_r18
    var boolean v_Found_ta_IndicationCellSwitch_r18 := false;           //  pc_ta_IndicationCellSwitch_r18
    var boolean v_Found_cg_SDT_PeriodicityExt_r18 := false;             //  pc_cg_SDT_PeriodicityExt_r18
    var boolean v_Found_condHandoverWithCandSCG_change_r18 := false;    //  pc_condHandoverWithCandSCG_change_r18
    var boolean v_Found_supportOf2RxXR_r18 := false;                    //  pc_supportOf2RxXR_r18
    var boolean v_Found_ltm_MCG_IntraFreq_r18 := false;                 //  pc_ltm_MCG_IntraFreq_r18
    var boolean v_Found_ltm_SCG_IntraFreq_r18 := false;                 //  pc_ltm_SCG_IntraFreq_r18
    var boolean v_Found_ltm_MAC_CE_JointTCI_r18 := false;               //  pc_ltm_MAC_CE_JointTCI_r18
    var boolean v_Found_ltm_MAC_CE_SeparateTCI_r18 := false;            //  pc_ltm_MAC_CE_SeparateTCI_r18
    var boolean v_Found_multiCell_PDSCH_DCI_1_3_SameSCS_r18 := false;
    var boolean v_Found_multiCell_PUSCH_DCI_0_3_SameSCS_r18 := false;
    var boolean v_Found_supportOfSearchSpace_r18_DCI_0_3 := false;
    var boolean v_Found_supportOfSearchSpace_r18_DCI_1_3 := false;
    var template(value) CA_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.coScheduledCellIndicationScheme_r18 v_CoScheduledCellIndicationScheme_r18_DCI_1_3;
    var template(value) CA_ParametersNR_v1800.multiCell_PUSCH_DCI_0_3_SameSCS_r18.coScheduledCellIndicationScheme_r18 v_CoScheduledCellIndicationScheme_r18_DCI_0_3;
    var template(value) CA_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.harqFeedbackType_r18 v_HarqFeedbackType_DCI_1_3_r18;

    v_Received_NRCapabilityMsg := p_NRCapability;
    v_Type2_PUSCH_RepetitionMultiSlots := isvalue(v_Received_NRCapabilityMsg.phy_Parameters.phy_ParametersCommon.type2_PUSCH_RepetitionMultiSlots); // Refers to type2-PUSCH-RepetitionMultiSlots

    if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters) and isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[0])) { // rf_Parameters and rf_Parameters.supportedBandListNR[x] are mandatory, so need to check first

      for (v_Index := 0; v_Index < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR); v_Index:=v_Index+1) {
          fl_CheckNRBandCapability(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR); // checks bandNR against capability PICS

          if (fl_Check_maxNumberCSI_RS_BFD(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index])) { // maxNumberCSI_RS_BFD - @sic R5-245527 sic@
             v_Found_maxNumberCSI_RS_BFD := true;
          }
          if (fl_Check_maxNumberCSI_RS_SSB_CBD(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index])) { // maxNumberCSI_RS_SSB_CBD - @sic R5-245527 sic@
             v_Found_maxNumberCSI_RS_SSB_CBD := true;
          }

          if (not (match(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].multipleTCI, supported))) { // @sic R5-211500 R5-211501 sic@
            f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 field multipleTCI shall be set to supported.");
          }

          if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_WithoutRestriction)) {
            v_Found_bwp_WithoutRestriction := true;
          }

          if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel16, rel17, rel18))) { // checks Rel16&17@rel18
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sharedSpectrumChAccessParamsPerBand_r16.ul_DynamicChAccess_r16)) {
                v_Found_ul_DynamicChAccess_r16 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sharedSpectrumChAccessParamsPerBand_r16.ul_Semi_StaticChAccess_r16)) { // @sic R5-245527 sic@
                v_Found_ul_Semi_StaticChAccess_r16 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sharedSpectrumChAccessParamsPerBand_r16.rssi_ChannelOccupancyReporting_r16)) { // @sic R5-245527 sic@
                v_Found_rssi_ChannelOccupancyReporting_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].condHandover_r16)) {
                v_Found_condHandover_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].condHandoverFailure_r16)) {
                v_Found_condHandoverFailure_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].condHandoverTwoTriggerEvents_r16)) {
                v_Found_condHandoverTwoTriggerEvents_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].condPSCellChange_r16)) {
                v_Found_condPSCellChange_r16 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].activeConfiguredGrant_r16)) {
                v_Found_activeConfiguredGrant_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].type2_PUSCH_RepetitionMultiSlots_v1650)) { // @sic R5s250367 sic@
                v_Found_PUSCH_RepetitionMultiSlots_v1650 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sps_r16)) { // @sic R5-236307 sic@
                  if (not pc_downlinkSPS){
                      f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 the UE can include this feature only if it indicates support of downlinkSPS");
                  }
                v_Found_sps_r16 := true; // Checked as boolean because it is an optional field. No further check of contents
              }

              if (p_Configuration_Type == NR_SA) { // only in TC8.1.5.1.1
                  if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].txDiversity_r16)) {
                    if (v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR >= 257){ //.bandNR < 257
                       f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 field txDiversity_r16 is FR1 only.");
                    }
                    v_Found_txDiversity_r16 := true;
                  }
              }

              // @sic R5-225323 sic@
              if ((v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR == 41) or (v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR == 79)){
                fl_Check_maxUplinkDutyCycle_PC1dot5_MPE_FR1_r16(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index]);
              }
          }

          if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel17, rel18))) { // checks Rel17&Rel18 only
              if (p_Configuration_Type ==  NR_SA) { // only in TC8.1.5.1.1
                 if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].cg_SDT_r17)) {
                   v_Found_cg_SDT_r17 := true;
                 }

                 // @sic R5-247553 sic@
                 if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17)) { // IE bwp-WithoutCD-SSB-OrNCD-SSB-RedCap-r17
                   v_Found_bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17 := true;
                 }
              }

              v_Found_mTRP_PUSCH_cyclicMapping_r17 := fl_Check_mTRP_PUSCH_cyclicMapping_r17(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index]); // mTRP-PUSCH-cyclicMapping-r17 - @sic R5-250329 sic@

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].mimo_ParametersPerBand.srs_partialFrequencySounding_r17)) { //@sic R5-255069 sic@
                 v_Found_srs_partialFrequencySounding_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].mimo_ParametersPerBand.srs_startRB_locationHoppingPartial_r17)) { //@sic R5-255069 sic@
                 v_Found_srs_startRB_locationHoppingPartial_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].mimo_ParametersPerBand.unifiedJointTCI_r17)) { // @sic R5-251949 sic@
                 v_Found_unifiedJointTCI_r17 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].mimo_ParametersPerBand.unifiedSeparateTCI_multiMAC_CE_r17)) { // @sic R5-251949 sic@
                 v_Found_unifiedSeparateTCI_multiMAC_CE_r17 := true;
              }

              // @sic R5-250329 sic@
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].locationBasedCondHandover_r17)) {
                v_Found_locationBasedCondHandover_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].timeBasedCondHandover_r17)) {
                v_Found_timeBasedCondHandover_r17 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].eventA4BasedCondHandover_r17)) {
                v_Found_eventA4BasedCondHandover_r17 := true;
              }

              // @sic R5-250329 sic@
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sn_InitiatedCondPSCellChangeNRDC_r17)) {
                v_Found_sn_InitiatedCondPSCellChangeNRDC_r17 := true;
              }
              // @sic R5-254821 sic@
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sssg_Switching_1BitInd_r17)) {
                v_Found_sssg_Switching_1BitInd_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].sssg_Switching_2BitInd_r17)) {
                v_Found_sssg_Switching_2BitInd_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].searchSpaceSetGrp_switchCap2_r17)) {
                v_Found_searchSpaceSetGrp_switchCap2_r17 := true;
              }

              v_Set_uplinkPreCompensation_r17_InBand := isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].uplinkPreCompensation_r17);
              v_Set_uplink_TA_Reporting_r17_InBand := false;
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].uplink_TA_Reporting_r17)) {
                if (not (f_NR_IsHAPSorNTNBand(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR))) { //HAPS and NTN satellite operating bands
                       f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2, uplink_TA_Reporting_r17 is only applicable for bands in Table 5.2.2-1 and Table 5.2.3-1 in TS 38.101-5 and HAPS operation bands in clause 5.2 of TS 38.104");
                }
                if (not v_Set_uplinkPreCompensation_r17_InBand) {
                       f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2, UE indicating support of uplink_TA_Reporting_r17 shall also indicate support of uplinkPreCompensation-r17 for this band.");
                }
                v_Found_uplink_TA_Reporting_r17 := true;
                v_Set_uplink_TA_Reporting_r17_InBand := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ue_specific_K_Offset_r17)) {
                if (not (f_NR_IsHAPSorNTNBand(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR))) { //HAPS and NTN satellite operating bands
                       f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 ue_specific_K_Offset_r17 is only applicable for bands in Table 5.2.2-1 and Table 5.2.3-1 in TS 38.101-5 and HAPS operation bands in clause 5.2 of TS 38.104");
                }
                if (not (v_Set_uplink_TA_Reporting_r17_InBand and v_Set_uplinkPreCompensation_r17_InBand)) {
                       f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2, UE indicating support of ue_specific_K_Offset_r17 shall also indicate support of uplink-TA-Reporting-r17 and uplinkPreCompensation-r17 for this bandu");
                }
                v_Found_ue_specific_K_Offset_r17 := true;
              }

              // @sic R5-233295 R5-234441 R5-234442 sic@
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].maxNumberPUSCH_TypeA_Repetition_r17)) {
                v_Found_maxNumberPUSCH_TypeA_Repetition_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].puschTypeA_RepetitionsAvailSlot_r17)) {
                v_Found_puschTypeA_RepetitionsAvailSlot_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].tb_ProcessingMultiSlotPUSCH_r17)) {
                v_Found_tb_ProcessingMultiSlotPUSCH_r17 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].tb_ProcessingRepMultiSlotPUSCH_r17)) {
                v_Found_tb_ProcessingRepMultiSlotPUSCH_r17 := true;
              }
              /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].pusch_RepetitionMsg3_r17)) { // IE pusch-RepetitionMsg3-r17
                v_Found_pusch_RepetitionMsg3_r17 := true;
              }

              if ((p_Configuration_Type == NR_SA) and isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].halfDuplexFDD_TypeA_RedCap_r17))
              { // @sic R5-233070 sic@

                  v_Band := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR;
                  if (fl_NR_FindEntries_HD_FDD_FreqBandIndicatorNR(v_Band)) { // @sic R5-251506 sic@
                     //UE reported a known HD-FDD FreqBandIndicatorNR, now check whether it is set on PICS pc_nrBandX_Supp accordingly
                      if (not f_NR_ContentOf_pc_nr_HDFDD_BandX(v_Band)) {
                        f_SetVerdict(inconc,__FILE__, __LINE__, "pc_nrBand" & int2str(v_Band) & "_HD_FDD_Supp not set accordingly");
                      }
                  } // end of checks for IE HD-FDD NR Bands

                  if (not (pc_supportOfRedCap_r17 or pc_supportOfERedCap_r18)) // neither RedCap nor eRedCap ICSs are set - @sic R5-247239 sic@
                  {
                    f_SetVerdict(inconc,__FILE__, __LINE__, "UE supports (e)RedCap but neiter pc_supportOfRedCap_r17 nor pc_supportOfERedCap_r18 are set");
                  }
                  if ((v_Band >= 257) or (not f_NR_IsBandFDD(v_Band))) // Band not FDD FR1 is signalling the feature
                  {
                    f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.21.6.1 support of Half-duplex FDD operation (instead of full-duplex FDD operation) type A is applicable to FDD FR1 UEs only");
                  }
                  v_HalfDuplexFDD_TypeA_RedCap_r17 := true;
              }
          }

          if (match (v_Received_NRCapabilityMsg.accessStratumRelease, rel18)) { // checks Rel18 only

              if (p_Configuration_Type == NR_SA) { // only in TC8.1.5.1.1

                  if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].mt_CG_SDT_r18)) {
                    v_Found_mt_CG_SDT_r18 := true;
                  }
                  if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].cg_SDT_PeriodicityExt_r18)) {
                    v_Found_cg_SDT_PeriodicityExt_r18 := true;
                  }
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ltm_BeamIndicationJointTCI_r18)) {
                v_Found_ltm_BeamIndicationJointTCI_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ta_IndicationCellSwitch_r18)) {
                v_Found_ta_IndicationCellSwitch_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ue_TA_Measurement_r18)) {
                v_Found_ue_TA_Measurement_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].prach_CoverageEnh_r18)) {
                v_Found_prach_CoverageEnh_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].dynamicWaveformSwitch_r18)) {
                v_Found_dynamicWaveformSwitch_r18 := true; // @sic R5-261140 sic@
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].dynamicWaveformSwitchPHR_r18)) {
                v_Found_dynamicWaveformSwitchPHR_r18 := true; // @sic R5-255779 sic@
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].locationBasedCondHandoverATG_r18)) {
                v_Found_locationBasedCondHandoverATG_r18 := true; // @sic R5-255779 sic@
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].supportOf2RxXR_r18)) {
                v_Found_supportOf2RxXR_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].condHandoverWithCandSCG_change_r18)) {
                v_Found_condHandoverWithCandSCG_change_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ltm_MCG_IntraFreq_r18)) {
                v_Found_ltm_MCG_IntraFreq_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ltm_SCG_IntraFreq_r18)) {
                v_Found_ltm_SCG_IntraFreq_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ltm_MAC_CE_JointTCI_r18)) {
                v_Found_ltm_MAC_CE_JointTCI_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].ltm_MAC_CE_SeparateTCI_r18)) {
                v_Found_ltm_MAC_CE_SeparateTCI_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].spatialAdaptation_CSI_Feedback_r18)) {
                v_Found_spatialAdaptation_CSI_Feedback_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].spatialAdaptation_CSI_FeedbackAperiodic_r18)) {
                v_Found_spatialAdaptation_CSI_FeedbackAperiodic_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].powerAdaptation_CSI_FeedbackPUCCH_r18)) {
                v_Found_powerAdaptation_CSI_FeedbackPUCCH_r18 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].nes_CellDTX_DRX_DCI2_9_r18)) {
                v_Found_nes_CellDTX_DRX_DCI2_9_r18 := true;
              }
          }
      }

      f_CompareCapability_vs_PICS(pc_maxNumberCSI_RS_BFD, v_Found_maxNumberCSI_RS_BFD,"maxNumberCSI-RS-BFD"); // @sic R5-245527 sic@
      f_CompareCapability_vs_PICS(pc_maxNumberCSI_RS_SSB_CBD, v_Found_maxNumberCSI_RS_SSB_CBD,"maxNumberCSI-RS-SSB-CBD"); // @sic R5-245527 sic@
      f_CompareCapability_vs_PICS(pc_bwp_WithoutRestriction, v_Found_bwp_WithoutRestriction,"bwp_WithoutRestriction");

      if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel16, rel17, rel18))) { // checks Rel16&17&Rel18
          f_CompareCapability_vs_PICS(pc_ul_DynamicChAccess_r16, v_Found_ul_DynamicChAccess_r16,"ul-DynamicChAccess-r16");
          f_CompareCapability_vs_PICS(pc_ul_Semi_StaticChAccess_r16, v_Found_ul_Semi_StaticChAccess_r16,"ul-Semi-StaticChAccess-r16"); // @sic R5-245527 sic@
          f_CompareCapability_vs_PICS(pc_rssi_ChannelOccupancyReporting_r16, v_Found_rssi_ChannelOccupancyReporting_r16,"rssi-ChannelOccupancyReporting-r16"); // @sic R5-245527 sic@
          f_CompareCapability_vs_PICS(pc_condHandover_r16, v_Found_condHandover_r16,"condHandover-r16");
          f_CompareCapability_vs_PICS(pc_condHandoverFailure_r16, v_Found_condHandoverFailure_r16,"condHandoverFailure-r16");
          f_CompareCapability_vs_PICS(pc_condHandoverTwoTriggerEvents_r16, v_Found_condHandoverTwoTriggerEvents_r16,"condHandoverTwoTriggerEvents-r16");
          f_CompareCapability_vs_PICS(pc_condPSCellChange_r16, v_Found_condPSCellChange_r16,"condPSCellChange-r16");
          f_CompareCapability_vs_PICS(pc_activeConfiguredGrant_r16, v_Found_activeConfiguredGrant_r16,"activeConfiguredGrant-r16");

          if (v_Found_PUSCH_RepetitionMultiSlots_v1650 and v_Type2_PUSCH_RepetitionMultiSlots){  // @sic R5s250367, R5s260002 sic@
                   f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2: The UE only includes type2-PUSCH-RepetitionMultiSlots-v1650 if type2-PUSCH-RepetitionMultiSlots is absent");
          }
          v_Found_PUSCH_RepetitionMultiSlots_v1650 := v_Found_PUSCH_RepetitionMultiSlots_v1650 or v_Type2_PUSCH_RepetitionMultiSlots;
          f_CompareCapability_vs_PICS(pc_type2_PUSCH_RepetitionMultiSlots, v_Found_PUSCH_RepetitionMultiSlots_v1650,"PUSCH-RepetitionMultiSlots-v1650");
          f_CompareCapability_vs_PICS(pc_multi_sps_r16, v_Found_sps_r16,"multi-sps-r16");
          if (p_Configuration_Type == NR_SA) { // only in TC8.1.5.1.1
             f_CompareCapability_vs_PICS(pc_txDiversity_r16, v_Found_txDiversity_r16,"txDiversity_r16");
          } // @sic R5s240137 sic@

        // fields supportedBandCombinationList - CA-ParametersNR-v1610
        v_Index := 0;
        while (v_Index < maxBandComb) { // check over all reported band combinations

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1610[v_Index].ca_ParametersNR_v1610.scellDormancyOutsideActiveTime_r16)) {
                v_Found_scellDormancyOutsideActiveTime_r16 := true;
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1610[v_Index].ca_ParametersNR_v1610.interFreqDAPS_r16)) {
                v_Found_interFreqDAPS_r16 := true;
              }
              v_Index:=v_Index+1;
        }

        f_CompareCapability_vs_PICS(pc_scellDormancyOutsideActiveTime_r16, v_Found_scellDormancyOutsideActiveTime_r16,"scellDormancyOutsideActiveTime-r16");
        if (pc_scellDormancyOutsideActiveTime_r16 and (not pc_DRX_Adaptation or (not v_BWP_SameNumerology_Set))) {
             f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.4 A UE supporting scellDormancyOutsideActiveTime_r16 shall also indicate support of power saving DRX adaptation using drx-Adaptation-r16 and shall also support one dormant BWP and at least one non-dormant BWP per carrier");
        }
        
        f_CompareCapability_vs_PICS(pc_interFreqDAPS_r16, v_Found_interFreqDAPS_r16,"interFreqDAPS-r16");
      }

      if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel17, rel18))) { // checks Rel17&Rel18 only
          if (p_Configuration_Type == NR_SA) { // only in TC8.1.5.1.1
              f_CompareCapability_vs_PICS(pc_cg_SDT_r17, v_Found_cg_SDT_r17,"cg-SDT-r17");
              f_CompareCapability_vs_PICS(pc_halfDuplexFDD_TypeA_RedCap_r17, v_HalfDuplexFDD_TypeA_RedCap_r17,"HalfDuplexFDD-TypeA-RedCap-r17");
              f_CompareCapability_vs_PICS(pc_bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17, v_Found_bwp_WithoutCD_SSB_OrNCD_SSB_RedCap_r17,"bwp-WithoutCD-SSB-OrNCD-SSB-RedCap-r17"); // @sic R5-247553 sic@
          } // @sic R5s240137 sic@

          f_CompareCapability_vs_PICS(pc_locationBasedCondHandover_r17, v_Found_locationBasedCondHandover_r17,"locationBasedCondHandover-r17"); // @sic R5-250329 sic@
          if (v_Found_locationBasedCondHandover_r17 and not (pc_condHandover_r16 or pc_nonTerrestrialNetwork_r17)) { // Check done through PICS for easiness
                   f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 A UE supporting locationBasedCondHandover_r17 shall also indicate the support of condHandover-r16 for NTN bands and the support of nonTerrestrialNetwork-r17.");
          }
          f_CompareCapability_vs_PICS(pc_timeBasedCondHandover_r17, v_Found_timeBasedCondHandover_r17,"timeBasedCondHandover-r17"); // @sic R5-250329 sic@
          if (v_Found_timeBasedCondHandover_r17 and not (pc_condHandover_r16 or pc_nonTerrestrialNetwork_r17)) { // Check done through PICS for easiness
                   f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 A UE supporting timeBasedCondHandover_r17 shall also indicate the support of condHandover-r16 for NTN bands and the support of nonTerrestrialNetwork-r17.");
          }

          f_CompareCapability_vs_PICS(pc_eventA4BasedCondHandover_r17, v_Found_eventA4BasedCondHandover_r17,"eventA4BasedCondHandover-r17"); // @sic R5-245527 sic@
          f_CompareCapability_vs_PICS(pc_sn_InitiatedCondPSCellChangeNRDC_r17, v_Found_sn_InitiatedCondPSCellChangeNRDC_r17,"sn-InitiatedCondPSCellChangeNRDC-r17"); // @sic R5-250329 sic@

          if ((v_Found_sssg_Switching_2BitInd_r17 or v_Found_searchSpaceSetGrp_switchCap2_r17) and (not v_Found_sssg_Switching_1BitInd_r17)) { // @sic R5-254821 sic@
              f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS 38.306 cl. 4.2.7.2: UE indicating support of sssg_Switching_2BitInd_r17 or searchSpaceSetGrp_switchCap2_r17 shall also indicate support of sssg-Switching-1bitInd-r17.");
          }
          if (v_Found_searchSpaceSetGrp_switchCap2_r17 and v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[v_Index].bandNR >= 257) { // If not FR1
              f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS 38.306 cl. 4.2.7.2 searchSpaceSetGrp_switchCap2_r17 is FR1 only.");
          }
          f_CompareCapability_vs_PICS(pc_sssg_Switching_1BitInd_r17, v_Found_sssg_Switching_1BitInd_r17,"sssg-Switching-1BitInd-r17");
          f_CompareCapability_vs_PICS(pc_sssg_Switching_2BitInd_r17, v_Found_sssg_Switching_2BitInd_r17,"sssg-Switching-2BitInd-r17");
          f_CompareCapability_vs_PICS(pc_searchSpaceSetGrp_switchCap2_r17, v_Found_searchSpaceSetGrp_switchCap2_r17,"searchSpaceSetGrp-switchCap2-r17");
          f_CompareCapability_vs_PICS(pc_mtrpPuschCyclicMapping_r17, v_Found_mTRP_PUSCH_cyclicMapping_r17,"mTRP-PUSCH-cyclicMapping-r17"); // @sic R5-250329 sic@
          f_CompareCapability_vs_PICS(pc_srs_partialFrequencySounding_r17, v_Found_srs_partialFrequencySounding_r17,"srs-partialFrequencySounding-r17");
          f_CompareCapability_vs_PICS(pc_srs_startRB_locationHoppingPartial_r17, v_Found_srs_startRB_locationHoppingPartial_r17,"srs-startRB-locationHoppingPartial-r17");
          
          if (v_Found_srs_startRB_locationHoppingPartial_r17 and (not v_Found_srs_partialFrequencySounding_r17)) {
              f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2: The UE supporting srs_startRB_locationHoppingPartial_r17 shall also indicate the support of srs-partialFrequencySounding-r17.");
          }

          f_CompareCapability_vs_PICS(pc_unifiedJointTCI_r17, v_Found_unifiedJointTCI_r17,"unifiedJointTCI-r17"); // @sic R5-251949 sic@
          f_CompareCapability_vs_PICS(pc_unifiedSeparateTCI_multiMAC_CE_r17, v_Found_unifiedSeparateTCI_multiMAC_CE_r17,"unifiedSeparateTCI-multiMAC-CE-r17"); // @sic R5-251949 sic@
          f_CompareCapability_vs_PICS(pc_uplink_TA_Reporting_r17, v_Found_uplink_TA_Reporting_r17,"uplink-TA-Reporting-r17");
          f_CompareCapability_vs_PICS(pc_ue_specific_K_Offset_r17, v_Found_ue_specific_K_Offset_r17,"ue-specific-K-Offset-r17");
          f_CompareCapability_vs_PICS(pc_maxNumberPUSCH_TypeA_Repetition_r17, v_Found_maxNumberPUSCH_TypeA_Repetition_r17,"maxNumberPUSCH-TypeA-Repetition-r17"); // @sic R5-233295 sic@
          f_CompareCapability_vs_PICS(pc_puschTypeA_RepetitionsAvailSlot_r17, v_Found_puschTypeA_RepetitionsAvailSlot_r17,"puschTypeA-RepetitionsAvailSlot-r17");
          f_CompareCapability_vs_PICS(pc_tb_ProcessingMultiSlotPUSCH_r17, v_Found_tb_ProcessingMultiSlotPUSCH_r17,"tb-ProcessingMultiSlotPUSCH-r17");
          f_CompareCapability_vs_PICS(pc_tb_ProcessingRepMultiSlotPUSCH_r17, v_Found_tb_ProcessingRepMultiSlotPUSCH_r17,"tb-ProcessingRepMultiSlotPUSCH-r17");
          f_CompareCapability_vs_PICS(pc_pusch_RepetitionMsg3_r17, v_Found_pusch_RepetitionMsg3_r17,"pusch-RepetitionMsg3-r17");
      }

      if (match (v_Received_NRCapabilityMsg.accessStratumRelease, (rel18))) { // checks Rel18 only
          if (p_Configuration_Type == NR_SA) { // only in TC8.1.5.1.1
              f_CompareCapability_vs_PICS(pc_mt_CG_SDT_r18, v_Found_mt_CG_SDT_r18,"mt-CG-SDT-r18");
              f_CompareCapability_vs_PICS(pc_cg_SDT_PeriodicityExt_r18, v_Found_cg_SDT_PeriodicityExt_r18,"cg-SDT-PeriodicityExt-r18");
          } // @sic R5-245527 sic@

          f_CompareCapability_vs_PICS(pc_ue_TA_Measurement_r18, v_Found_ue_TA_Measurement_r18,"ue-TA-Measurement-r18");
          f_CompareCapability_vs_PICS(pc_ta_IndicationCellSwitch_r18, v_Found_ta_IndicationCellSwitch_r18,"ta-IndicationCellSwitch-r18");
          f_CompareCapability_vs_PICS(pc_ltm_BeamIndicationJointTCI_r18, v_Found_ltm_BeamIndicationJointTCI_r18,"ltm-BeamIndicationJointTCI-r18");
          f_CompareCapability_vs_PICS(pc_prach_CoverageEnh_r18, v_Found_prach_CoverageEnh_r18,"prach-CoverageEnh-r18"); // @sic R5-250329 sic@
          f_CompareCapability_vs_PICS(pc_dynamicWaveformSwitch_r18, v_Found_dynamicWaveformSwitch_r18,"dynamicWaveformSwitch-r18"); // @sic R5-261140 sic@
          f_CompareCapability_vs_PICS(pc_dynamicWaveformSwitchPHR_r18, v_Found_dynamicWaveformSwitchPHR_r18,"dynamicWaveformSwitchPHR-r18");
          f_CompareCapability_vs_PICS(pc_locationBasedCondHandoverATG_r18, v_Found_locationBasedCondHandoverATG_r18,"locationBasedCondHandoverATG-r18");

          f_CompareCapability_vs_PICS(pc_supportOf2RxXR_r18, v_Found_supportOf2RxXR_r18,"supportOf2RxXR-r18"); // @sic R5-250329 sic@
          if (v_Found_supportOf2RxXR_r18 and (pc_supportOfRedCap_r17 or pc_supportOfERedCap_r18)) { // Check done through PICS for easiness
                   f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 A UE reporting this parameter shall not indicate support of supportOfRedCap-r17 or supportOfERedCap-r18.");
          }

          f_CompareCapability_vs_PICS(pc_condHandoverWithCandSCG_change_r18, v_Found_condHandoverWithCandSCG_change_r18,"condHandoverWithCandSCG-change-r18"); // @sic R5-245527 sic@
          f_CompareCapability_vs_PICS(pc_ltm_MCG_IntraFreq_r18, v_Found_ltm_MCG_IntraFreq_r18,"ltm-MCG-IntraFreq-r18");
          f_CompareCapability_vs_PICS(pc_ltm_SCG_IntraFreq_r18, v_Found_ltm_SCG_IntraFreq_r18,"ltm-SCG-IntraFreq-r18"); // @sic R5-251316 sic@
          f_CompareCapability_vs_PICS(pc_ltm_MAC_CE_JointTCI_r18, v_Found_ltm_MAC_CE_JointTCI_r18,"ltm-MAC-CE-JointTCI-r18");
          f_CompareCapability_vs_PICS(pc_ltm_MAC_CE_SeparateTCI_r18, v_Found_ltm_MAC_CE_SeparateTCI_r18,"ltm-MAC-CE-SeparateTCI-r18"); // @sic R5-251316 sic@

          fl_Check_Rf_Parameters_nes_CellDTX_DRX_r18(v_Received_NRCapabilityMsg); // @sic R5-250329 sic@
          f_CompareCapability_vs_PICS(pc_spatialAdaptation_CSI_Feedback_r18, v_Found_spatialAdaptation_CSI_Feedback_r18,"spatialAdaptation-CSI-Feedback-r18"); // @sic R5-261140 sic@
          f_CompareCapability_vs_PICS(pc_spatialAdaptation_CSI_FeedbackAperiodic_r18, v_Found_spatialAdaptation_CSI_FeedbackAperiodic_r18,"spatialAdaptation-CSI-FeedbackAperiodic-r18"); // @sic R5-261140 sic@
          f_CompareCapability_vs_PICS(pc_powerAdaptation_CSI_FeedbackPUCCH_r18, v_Found_powerAdaptation_CSI_FeedbackPUCCH_r18,"powerAdaptation-CSI-FeedbackPUCCH-r18"); // @sic R5-261140 sic@
          f_CompareCapability_vs_PICS(pc_nes_CellDTX_DRX_DCI2_9_r18, v_Found_nes_CellDTX_DRX_DCI2_9_r18,"nes-CellDTX-DRX-DCI2-9-r18");
          if (v_Found_nes_CellDTX_DRX_DCI2_9_r18 and not (pc_nes_CellDTX_r18 or pc_nes_CellDRX_r18)) { // Check done through PICS for easiness
                   f_SetVerdict(fail,__FILE__, __LINE__, "Acc. to TS38.306 cl. 4.2.7.2 A UE supporting this feature shall also indicate support of nes-CellDTX-DRX-r18.");
          } // @sic R5-250329 sic@

        // fields supportedBandCombinationList CA-ParametersNR-v1800
        v_Index := 0;
        while (v_Index < maxBandComb) { // check over all reported band combinations

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18)) {
                v_Found_multiCell_PDSCH_DCI_1_3_SameSCS_r18 := true;
                v_CoScheduledCellIndicationScheme_r18_DCI_1_3 := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.coScheduledCellIndicationScheme_r18; // IE is mandatory
                if (not fl_Check_CoScheduledCellIndicationScheme_DCI_1_3_r18(v_CoScheduledCellIndicationScheme_r18_DCI_1_3)) {
                    f_SetVerdict(inconc,__FILE__, __LINE__, "pc_coScheduledCellIndicationScheme_r18_fdra_DCI_1_3 and pc_coScheduledCellIndicationScheme_r18_SchedCellInd_DCI_1_3 not correctly set");
                }
                v_HarqFeedbackType_DCI_1_3_r18 := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.harqFeedbackType_r18;  // IE is mandatory
                if (not fl_Check_HarqFeedbackType_r18(v_HarqFeedbackType_DCI_1_3_r18)) {
                    f_SetVerdict(inconc,__FILE__, __LINE__, "pc_harqFeedbackType1_DCI_1_3 and pc_harqFeedbackType2_DCI_1_3 not correctly set");
                }
                if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.supportOfSearchSpace_r18)) {
                   v_Found_supportOfSearchSpace_r18_DCI_1_3 := true;
                }
              }

              if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PUSCH_DCI_0_3_SameSCS_r18)) {
                v_Found_multiCell_PUSCH_DCI_0_3_SameSCS_r18 := true;
                v_CoScheduledCellIndicationScheme_r18_DCI_0_3 := v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PUSCH_DCI_0_3_SameSCS_r18.coScheduledCellIndicationScheme_r18;
                if (not fl_Check_CoScheduledCellIndicationScheme_DCI0_3_r18(v_CoScheduledCellIndicationScheme_r18_DCI_0_3)) {
                    f_SetVerdict(inconc,__FILE__, __LINE__, "pc_coScheduledCellIndicationScheme_r18_fdra_DCI_0_3 and pc_coScheduledCellIndicationScheme_r18_cellInd_DCI_0_3 not correctly set");
                }
                if (isvalue(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandCombinationList_v1800[v_Index].ca_ParametersNR_v1800.multiCell_PUSCH_DCI_0_3_SameSCS_r18.supportOfSearchSpace_r18)) {
                   v_Found_supportOfSearchSpace_r18_DCI_0_3 := true;
                }
              }
              v_Index:=v_Index+1;
        }

        f_CompareCapability_vs_PICS(pc_supportOfSearchSpace_r18_DCI_1_3, v_Found_supportOfSearchSpace_r18_DCI_1_3,"supportOfSearchSpace-r18-DCI-1-3");
        f_CompareCapability_vs_PICS(pc_multiCell_PDSCH_DCI_1_3_SameSCS_r18, v_Found_multiCell_PDSCH_DCI_1_3_SameSCS_r18,"multiCell-PDSCH-DCI-1-3-SameSCS-r18");
        f_CompareCapability_vs_PICS(pc_multiCell_PUSCH_DCI_0_3_SameSCS_r18, v_Found_multiCell_PUSCH_DCI_0_3_SameSCS_r18,"PUSCH-DCI-0-3-SameSCS-r18");
        f_CompareCapability_vs_PICS(pc_supportOfSearchSpace_r18_DCI_0_3, v_Found_supportOfSearchSpace_r18_DCI_0_3,"supportOfSearchSpace-r18-DCI-0-3");
      }
    }
    else {
      f_SetVerdict(fail,__FILE__, __LINE__, "Mandatory rf-Parameters not included on UE Capability message Rx");
    }

    fl_Check_Rf_Parameters_PDSCH_PUSCH_256QAM(v_Received_NRCapabilityMsg); // Notes 8 and 9 of UE-NR-Capability table
    fl_Check_Rf_Parameters_bwp_DiffNumerology(v_Received_NRCapabilityMsg); // Note 20 of UE-NR-Capability tables
    fl_Check_Rf_Parameters_bwp_SameNumerology(v_Received_NRCapabilityMsg); // Note 21 of UE-NR-Capability tables

 }; //end of fl_Check_Rf_Parameters_NRBand_PICS_Supp

  /*
   * @desc      Function that returns true only for FR2 Only UEs, i.e. if UE signals FR2 Bands as suppported but no FR1 Band at all
   * @param     p_NRCapability
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_UESupportsFR2BandOnly(UE_NR_Capability p_NRCapability ) return boolean
  { //@sic R5s230297 R5s230315 Ch. 1 sic@
    var boolean v_FoundFR1 := false;
    var integer i:=0;
    var UE_NR_Capability v_Received_NRCapabilityMsg := p_NRCapability;

    while (i < lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR) and (not v_FoundFR1)) {
      if ((v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[i].bandNR < 257)){ // Condition for FR1 Band signalled by the UE
         v_FoundFR1 := true;
         break;
      }

      i:=i+1;
    }
    return (not v_FoundFR1);
  };

  /*
   * @desc      Function that returns content of multiCell_PDSCH_DCI_1_3_SameSCS_r18.coScheduledCellIndicationScheme_r18
   * @param     p_CoScheduledCellIndicationScheme_r18
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_CoScheduledCellIndicationScheme_DCI_1_3_r18(template (value) CA_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.coScheduledCellIndicationScheme_r18 p_CoScheduledCellIndicationScheme_r18) return boolean
  {
    var boolean v_CorrectSettings := true;
    var boolean v_CoScheduledCellIndicationScheme_r18_fdra := pc_coScheduledCellIndicationScheme_r18_fdra_DCI_1_3;       // checks against DCI_1_3 parameters
    var boolean v_CoScheduledCellIndicationScheme_r18_cellInd := pc_coScheduledCellIndicationScheme_r18_SchedCellInd_DCI_1_3;

    select (valueof(p_CoScheduledCellIndicationScheme_r18)) {
      case (fdra) {

        if (not v_CoScheduledCellIndicationScheme_r18_fdra) {
          v_CorrectSettings := false;
        }
      }
      case (cellInd) {
        if (not v_CoScheduledCellIndicationScheme_r18_cellInd) {
          v_CorrectSettings := false;
        }
      }
      case (both) {
        if (not (v_CoScheduledCellIndicationScheme_r18_fdra and v_CoScheduledCellIndicationScheme_r18_cellInd)) {
          v_CorrectSettings := false;
        }
      }
      case else {FatalError(__FILE__, __LINE__, "Invalid multiCell_PDSCH_DCI_1_3_SameSCS_r18.coScheduledCellIndicationScheme_r18");}
    }

    return v_CorrectSettings;
  };

  /*
   * @desc      Function that returns content of multiCell_PDSCH_DCI_0_3_SameSCS_r18.coScheduledCellIndicationScheme_r18
   * @param     p_CoScheduledCellIndicationScheme_r18
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_CoScheduledCellIndicationScheme_DCI0_3_r18(template (value) CA_ParametersNR_v1800.multiCell_PUSCH_DCI_0_3_SameSCS_r18.coScheduledCellIndicationScheme_r18 p_CoScheduledCellIndicationScheme_r18) return boolean
  {
    var boolean v_CorrectSettings := true;
    var boolean v_CoScheduledCellIndicationScheme_r18_fdra := pc_coScheduledCellIndicationScheme_r18_fdra_DCI_0_3;       // checks against DCI_0_3 parameters
    var boolean v_CoScheduledCellIndicationScheme_r18_cellInd := pc_coScheduledCellIndicationScheme_r18_SchedCellInd_DCI_1_3;

    select (valueof(p_CoScheduledCellIndicationScheme_r18)) {
      case (fdra) {

        if (not v_CoScheduledCellIndicationScheme_r18_fdra) {
          v_CorrectSettings := false;
        }
      }
      case (cellInd) {
        if (not v_CoScheduledCellIndicationScheme_r18_cellInd) {
          v_CorrectSettings := false;
        }
      }
      case (both) {
        if (not (v_CoScheduledCellIndicationScheme_r18_fdra and v_CoScheduledCellIndicationScheme_r18_cellInd)) {
          v_CorrectSettings := false;
        }
      }
      case else {FatalError(__FILE__, __LINE__, "Invalid multiCell_PDSCH_DCI_0_3_SameSCS_r18.coScheduledCellIndicationScheme_r18");}
    }

    return v_CorrectSettings;
  };

  /*
   * @desc      Function that returns content of harqFeedbackType_r18
   * @param     p_HarqFeedbackType_r18
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_HarqFeedbackType_r18(template (value) CA_ParametersNR_v1800.multiCell_PDSCH_DCI_1_3_SameSCS_r18.harqFeedbackType_r18 p_HarqFeedbackType_r18) return boolean
  {
    var boolean v_CorrectSettings := true;

    select (valueof(p_HarqFeedbackType_r18)) {
      case (type1) {
        if (not pc_harqFeedbackType1_DCI_1_3) {
          v_CorrectSettings := false;
        }
      }
      case (type2) {
        if (not pc_harqFeedbackType2_DCI_1_3) {
          v_CorrectSettings := false;
        }
      }
      case (type1And2) {
        if (not (pc_harqFeedbackType1_DCI_1_3 and pc_harqFeedbackType2_DCI_1_3)) {
          v_CorrectSettings := false;
        }
      }
      case else {f_SetVerdict(inconc,__FILE__, __LINE__, "Invalid harqFeedbackType_r18");}
    }

    return v_CorrectSettings;
  };

  /*
   * @desc      Function to check CGI_Reporting fields in measAndMobParameters.measAndMobParametersCommon conditional to supported PICS pc_nr_CGI_Reporting_ENDC or pc_eutra_CGI_Reporting_NEDC or pc_nr_CGI_Reporting_NEDC and configuration type
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_MeasAndMobParametersCommon_CGI_Reporting (UE_NR_Capability p_NRCapability,
                                                              NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-230376 sic@
    var UE_NR_Capability v_Received_NRCapability;

      if (isvalue (p_NRCapability.measAndMobParameters.measAndMobParametersCommon)){

          v_Received_NRCapability := p_NRCapability;
          if (p_Configuration_Type == EN_DC) { // check pc_nr_CGI_Reporting_ENDC
             f_CompareCapability_vs_PICS(pc_nr_CGI_Reporting_ENDC, isvalue(v_Received_NRCapability.measAndMobParameters.measAndMobParametersCommon.nr_CGI_Reporting_ENDC),"nr-CGI-Reporting-ENDC");

          }
          if (p_Configuration_Type == NE_DC) { // check pc_eutra_CGI_Reporting_NEDC and pc_nr_CGI_Reporting_NEDC
             f_CompareCapability_vs_PICS(pc_eutra_CGI_Reporting_NEDC, isvalue(v_Received_NRCapability.measAndMobParameters.measAndMobParametersCommon.eutra_CGI_Reporting_NEDC),"eutra-CGI-Reporting-NEDC");
             f_CompareCapability_vs_PICS(pc_nr_CGI_Reporting_NEDC, isvalue(v_Received_NRCapability.measAndMobParameters.measAndMobParametersCommon.nr_CGI_Reporting_NEDC),"nr-CGI-Reporting-NEDC");
          }
      }
      else { // UE does not signal any of the checked parameters but some PICS is set
        if (pc_nr_CGI_Reporting_ENDC or pc_eutra_CGI_Reporting_NEDC or pc_nr_CGI_Reporting_NEDC) {
           f_SetVerdict(inconc,__FILE__, __LINE__, "UE does not signal CGI specific elements in UE-NR-Capability for MR-DC but some PICS are wrongly set");
        }
      }
  }

  /*
   * @desc      Function to check measAndMobParameters.measAndMobParametersCommon.supportedGapPattern and related PICS acc. to TS 38.306 cl. 4.2.9. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_MeasAndMobParametersCommon_supportedGapPattern (UE_NR_Capability p_NRCapability,
                                                                    NR_Configuration_Type p_Configuration_Type)
  { //@sic R5s230297 R5s230546 R5s250394 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var B22_Type v_SupportedGapPatternsPICS := f_NR_DeriveSupportedGapsFromPics();
    var B22_Type v_SupportedGapPatternsFromPics;
    var B22_Type v_UE_supportedGapPattern;

    v_Received_NRCapabilityMsg := p_NRCapability;
    v_SupportedGapPatternsFromPics := substr(v_SupportedGapPatternsPICS, 0, 22);
    if (isvalue(v_Received_NRCapabilityMsg.measAndMobParameters) and isvalue(v_Received_NRCapabilityMsg.measAndMobParameters.measAndMobParametersCommon.supportedGapPattern)) { // MeasAndMobParameters is OPTIONAL
        v_UE_supportedGapPattern := v_Received_NRCapabilityMsg.measAndMobParameters.measAndMobParametersCommon.supportedGapPattern;
        if (match(p_Configuration_Type, (NR_SA, NGEN_DC)) and f_NR_UESupportsFR2BandOnly(p_NRCapability)) // This check applies only to FR2 on NR SA or (NG)EN-DC
        {
           //The UE shall set the bits corresponding to the measurement gap pattern 13, 14, 17, 18 and 19 to 1 if the UE is an NR standalone capable UE that supports a band in FR2 or if the UE is an (NG)EN-DC capable UE that supports independentGapConfig and supports a band in FR2
           if (not((pc_gp13_nr and pc_gp14_nr and pc_gp17_nr and pc_gp18_nr and pc_gp19_nr))) {
                f_SetVerdict(inconc,__FILE__, __LINE__, "pc_gp13_nr, pc_gp14_nr, pc_gp17_nr, pc_gp18_nr or pc_gp19_nr not correctly set for a NR standalone capable UE that supports a band in FR2");
           }
           
           if (not(match(v_SupportedGapPatternsFromPics, v_UE_supportedGapPattern))){ //safe match due to check with isvalue
             f_SetVerdict(inconc,__FILE__, __LINE__, "NR Measurement gap pattern PICS not set as per capabilities signalled by UE supporting FR2 Bands in a NR_SA network");
           }
        }
        else if (match(p_Configuration_Type, (NE_DC, NR_SA))){ // This check applies to option 2 or option 4
            if (not match(v_SupportedGapPatternsFromPics, substr(v_UE_supportedGapPattern, 0, 22))) {
               f_SetVerdict(inconc,__FILE__, __LINE__, "NR Measurement gap pattern PICS not set as per capabilities signalled by the UE");
            }
        }
    }
    else if (bit2int(v_SupportedGapPatternsPICS) > 0) {
         f_SetVerdict(inconc,__FILE__, __LINE__, "NR Measurement gap pattern PICS are set while UE does not signal such capabilities");
    }

 }; //end of fl_Check_MeasAndMobParametersCommon_supportedGapPattern

  /*
   * @desc      Function to check measAndMobParametersCommon.ltm_FastUE_Processing_r18 and parameters against PICS. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_MeasAndMobParametersCommon_ltm_FastUE_Processing_r18 (UE_NR_Capability p_NRCapability)
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var template(omit) UE_NR_Capability.measAndMobParameters.measAndMobParametersCommon.ltm_FastUE_Processing_r18 v_LTM_FastUE_Processing_r18;

    var boolean v_Found_fr1_r18 := false;
    var boolean v_Found_fr2_r18 := false;
    var boolean v_Found_fr1_AndFR2_r18 := false;

    v_Received_NRCapabilityMsg := p_NRCapability;

    if (match (v_Received_NRCapabilityMsg.accessStratumRelease, rel18)) { // checks Rel18 otherwise do nothing

        if(ispresent(v_Received_NRCapabilityMsg.measAndMobParameters.measAndMobParametersCommon.ltm_FastUE_Processing_r18)) {
              v_LTM_FastUE_Processing_r18 := v_Received_NRCapabilityMsg.measAndMobParameters.measAndMobParametersCommon.ltm_FastUE_Processing_r18;

              if (ispresent(v_LTM_FastUE_Processing_r18.fr1_r18)) {
                v_Found_fr1_r18 := true;
              }
              if (ispresent(v_LTM_FastUE_Processing_r18.fr2_r18)) {
                v_Found_fr2_r18 := true;
              }
              if (ispresent(v_LTM_FastUE_Processing_r18.fr1_AndFR2_r18)) {
                v_Found_fr1_AndFR2_r18 := true;
              }

        }
        f_CompareCapability_vs_PICS(pc_ltm_FastUE_Processing_fr1_r18,v_Found_fr1_r18,"ltm-FastUE-Processing-r18.fr1-r18");
        f_CompareCapability_vs_PICS(pc_ltm_FastUE_Processing_fr2_r18,v_Found_fr2_r18,"ltm-FastUE-Processing-r18.fr2-r18");
        f_CompareCapability_vs_PICS(pc_ltm_FastUE_Processing_fr1_AndFR2_r18, v_Found_fr1_AndFR2_r18,"ltm-FastUE-Processing-r18.fr1_AndFR2_r18");
    }
  }

  /*
   * @desc      Function to check measAndMobParameters.measAndMobParametersCommon conditional to current supported PICS
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_MeasAndMobParametersCommon (UE_NR_Capability p_NRCapability,
                                                NR_Configuration_Type p_Configuration_Type)
  {
    fl_Check_MeasAndMobParametersCommon_supportedGapPattern(p_NRCapability, p_Configuration_Type);  //check conditions as per TS 38.306 clause 4.2.9
    fl_Check_MeasAndMobParametersCommon_CGI_Reporting(p_NRCapability, p_Configuration_Type);  //check conditions as per TS 38.306 clause 4.2.9
    fl_Check_MeasAndMobParametersCommon_ltm_FastUE_Processing_r18(p_NRCapability); //check parameters in IE ltm-FastUE-Processing-r18 as per TS 38.306 clause 4.2.9
  }

   /*
   * @desc      Converts the value of MIMO-LayersDL into an integer
   * @param     p_MaxNumberMIMO_LayersPDSCH
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Convert_NumberMIMO_LayersPDSCH (MIMO_LayersDL p_MaxNumberMIMO_LayersPDSCH) return integer
  {
    var integer v_Current_maxNumberMIMO_LayersPDSCH;

    select (p_MaxNumberMIMO_LayersPDSCH) {
      case (twoLayers) {
        v_Current_maxNumberMIMO_LayersPDSCH := 2;
      }
      case (fourLayers) {
        v_Current_maxNumberMIMO_LayersPDSCH := 4;
      }
      case (eightLayers) {
        v_Current_maxNumberMIMO_LayersPDSCH := 8;
      }
      case else {FatalError(__FILE__, __LINE__, "Invalid maxNumberMIMO_LayersPDSCH");}
    }
    return v_Current_maxNumberMIMO_LayersPDSCH;
  }

 /*
  * @desc      Check for maxNumberMIMO-LayersPDSCH in UE-NR-Capability. A verdict is raised if there is any inconsistency
  * @param     p_NRCapability
  * @param     p_Configuration_Type
  * @status    APPROVED (ENDC, NR5GC)
  */
  function f_Check_maxNumberMIMO_LayersPDSCH (UE_NR_Capability p_NRCapability,
                                               NR_Configuration_Type p_Configuration_Type)
  { //@sic R5s230297 R5s240674 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Current_MAX_MIMO_LayersDL := 0; // 0, 2, 4 or 8
    var integer v_Found_MIMO_LayersDL := 0; // if signalled, the actual Max MIMO LayersPDSCH found is 2, 4 or 8
    var integer v_MIMO_LayersDLPICS_Set;
    var integer v_Index := 0;
    var boolean v_Exit := false;

    v_Received_NRCapabilityMsg := p_NRCapability;
    v_MIMO_LayersDLPICS_Set := f_MIMO_LayersDLParameterSet(); // Retrieves the maxNumberMIMO_LayersPDSCH as integer set in PICS or raises error if more than one option is chosen

    if (ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC)) //OPTIONAL parameter
    {
        while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC)) and (not v_Exit)) { // search for the maxNumberMIMO-LayersPDSCH content in featureSetsDownlinkPerCC
          if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC[v_Index].maxNumberMIMO_LayersPDSCH))
          {
            v_Found_MIMO_LayersDL := fl_Convert_NumberMIMO_LayersPDSCH(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC[v_Index].maxNumberMIMO_LayersPDSCH);

            if (v_Found_MIMO_LayersDL >= v_Current_MAX_MIMO_LayersDL){
               v_Current_MAX_MIMO_LayersDL := v_Found_MIMO_LayersDL;
            }

            if (v_Current_MAX_MIMO_LayersDL==8)
            {
              v_Exit:= true; // It won't find a bigger value than eightLayers
            }
          }
          v_Index := v_Index + 1;
        }

        if (not (v_MIMO_LayersDLPICS_Set == v_Current_MAX_MIMO_LayersDL)) {
           f_SetVerdict(inconc,__FILE__, __LINE__, "PICS set for maxNumberMIMO-LayersPDSCH not matching the maxNumberMIMO-LayersPDSCH signalled by the UE for DL reception");
        }
        // TS 38.306, clause 4.2.7.6 FeatureSetDownlinkPerCC parameters.
        if ((p_Configuration_Type == NR_SA) and lengthof(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR) == 1)
        {
           if ((not pc_supportOfRedCap_r17) and (v_Current_MAX_MIMO_LayersDL < 4) and (f_NR_Is5GCoreBand(v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[0].bandNR))) {
               f_SetVerdict(fail,__FILE__, __LINE__, "TS 38.306, clause 4.2.7.6: For single CC standalone NR, it is mandatory with capability signalling to support at least 4 MIMO layers in the bands where 4Rx is specified as mandatory");
           }

           if (pc_supportOfRedCap_r17 and (v_Current_MAX_MIMO_LayersDL < 2)) {
               f_SetVerdict(fail,__FILE__, __LINE__, "TS 38.101, clause 7.2: A RedCap UE is required to be equipped with a minimum of single Rx antenna port and maximum of two Rx antenna ports. ");
           } // Conditions for RedCap UEs

           if ((v_Current_MAX_MIMO_LayersDL == 0) and (v_Received_NRCapabilityMsg.rf_Parameters.supportedBandListNR[0].bandNR > 256))  { // It is standalone NR, simple check for FR2 Band
               f_SetVerdict(fail,__FILE__, __LINE__, "TS 38.306, clause 4.2.7.6: For single CC standalone NR, it is mandatory with capability signalling to support at least 2 MIMO layers in FR2");
           }
        }
    }
    else if (v_MIMO_LayersDLPICS_Set > 0)
    {
        f_SetVerdict(inconc,__FILE__, __LINE__, "A maxNumberMIMO_LayersPDSCH PICS is wrongly set as this feature is not supported by the UE");
    }
  }

  /*
   * @desc      Function to check featureSets in Rel15 against PICS. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_featureSets_r15 (UE_NR_Capability p_NRCapability,
                                NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-250329 R5s221100 R5s221147 R5-227571 R5-227572 R5-227573 R5-231410 R5-241518 R5-242327 R5-246407 R5s250177 R5s250243 R5s250468 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Index := 0;
    var boolean v_Found_dynamicSwitchSUL := false;
    var boolean v_Found_twoPUCCH_Group := false;
    var boolean v_Found_mimo_CB_PUSCH := false;

    v_Received_NRCapabilityMsg := p_NRCapability;
    f_Check_maxNumberMIMO_LayersPDSCH (p_NRCapability, p_Configuration_Type); // Check featureSets.featureSetDownlinkPerCC.maxNumberMIMO-LayersPDSCH

    if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink))
    {
        while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink)) and ((not v_Found_dynamicSwitchSUL) or (not v_Found_twoPUCCH_Group))) { // check featureSetsUplink
          if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink[v_Index].dynamicSwitchSUL)) {
            v_Found_dynamicSwitchSUL := true;
          }
          if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink[v_Index].twoPUCCH_Group)) {
            v_Found_twoPUCCH_Group := true;
          }
          v_Index := v_Index + 1;
        }
    }
    f_CompareCapability_vs_PICS(pc_dynamicSwitch_SUL, v_Found_dynamicSwitchSUL,"dynamicSwitchSUL");
    f_CompareCapability_vs_PICS(pc_twoPUCCH_group, v_Found_twoPUCCH_Group,"twoPUCCH-Group");

    v_Index := 0;
    if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC)) { // @sic R5-255779 sic@
        while (v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC)) { // check featureSetsUplinkPerCC. Checks all carriers
          if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH)) {
            if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH.maxNumberMIMO_LayersCB_PUSCH)) { // field is optional, check maxNumberMIMO_LayersCB_PUSCH
              if (match(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH.maxNumberMIMO_LayersCB_PUSCH, twoLayers) and not (pc_maxNumberMIMO_LayersCB_PUSCH_twolayer))
              {
                 f_SetVerdict(inconc,__FILE__, __LINE__, "pc_maxNumberMIMO_LayersCB_PUSCH_twolayer not correctly set");
              }
              if (match(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH.maxNumberMIMO_LayersCB_PUSCH, fourLayers) and not (pc_maxNumberMIMO_LayersCB_PUSCH_fourlayer))
              {
                 f_SetVerdict(inconc,__FILE__, __LINE__, "pc_maxNumberMIMO_LayersCB_PUSCH_fourlayer not correctly set");
              }
              if (not match(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH.maxNumberMIMO_LayersCB_PUSCH, (oneLayer,twoLayers,fourLayers)))
              {
                 f_SetVerdict(fail,__FILE__, __LINE__, "Wrong values signaled by UE in maxNumberMIMO_LayersCB_PUSCH");
              }
            }
            
            v_Found_mimo_CB_PUSCH := true;
            if (not isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC[v_Index].mimo_CB_PUSCH.maxNumberSRS_ResourcePerSet))
            {
               f_SetVerdict(fail,__FILE__, __LINE__, "mimo-CB-PUSCH.maxNumberSRS-ResourcePerSet is not signalled by UE in an existing featureSetsUplinkPerCC");
            }
          }
        v_Index := v_Index + 1;
        }
        f_CompareCapability_vs_PICS(pc_nrMIMO_CB_PUSCH, v_Found_mimo_CB_PUSCH,"mimo-CB-PUSCH");
    }
  }

  /*
   * @desc      Function to check featureSets in Rel16 against PICS. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_featureSets_r16 (UE_NR_Capability p_NRCapability) /*NR_Configuration_Type p_Configuration_Type)*/
  {
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Index := 0;
    var boolean v_Found_intraFreqDAPS_r16 := false;
    var boolean v_Found_pusch_RepetitionTypeB_r16 := false;
    var boolean v_Found_ul_FullPwrMode_r16 := false;
    var boolean v_Found_ul_FullPwrMode1_r16 := false;
    var boolean v_Found_MultiDCI_MultiTRP_r16 := false;

    v_Received_NRCapabilityMsg := p_NRCapability;

    if (match (v_Received_NRCapabilityMsg.accessStratumRelease, rel16)) { // checks Rel16
        v_Index := 0;
        if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlink_v1610))
        {
            while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlink_v1610)) and (not v_Found_intraFreqDAPS_r16)) { // check featureSetsDownlink_v1610
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlink_v1610[v_Index].intraFreqDAPS_r16)) {
                v_Found_intraFreqDAPS_r16 := true;
              }
                v_Index := v_Index + 1;
            }
        }
        f_CompareCapability_vs_PICS(pc_intraFreqDAPS_r16, v_Found_intraFreqDAPS_r16,"intraFreqDAPS-r16");

        v_Index := 0;
        if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1610))
        {
            while (v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1610)) { // check featureSetsUplink_v1610
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1610[v_Index].pusch_RepetitionTypeB_r16)) {
                v_Found_pusch_RepetitionTypeB_r16 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1610[v_Index].ul_FullPwrMode_r16)) {
                v_Found_ul_FullPwrMode_r16 := true;
              }
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1610[v_Index].ul_FullPwrMode1_r16)) {
                v_Found_ul_FullPwrMode1_r16 := true;
              }
              v_Index := v_Index + 1;
            }
        }
        f_CompareCapability_vs_PICS(pc_pusch_RepetitionTypeB_r16, v_Found_pusch_RepetitionTypeB_r16,"pusch-RepetitionTypeB-r16");
        f_CompareCapability_vs_PICS(pc_ul_FullPwrMode_r16, v_Found_ul_FullPwrMode_r16,"ul-FullPwrMode-r16");
        f_CompareCapability_vs_PICS(pc_ul_FullPwrMode1_r16, v_Found_ul_FullPwrMode1_r16,"ul-FullPwrMode1-r16");

        v_Index := 0;
        if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620))
        {
            while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620)) and (not v_Found_MultiDCI_MultiTRP_r16)) { // check featureSetDownlinkPerCC_v1620.multiDCI-MultiTRP-r16
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620[v_Index].multiDCI_MultiTRP_r16)) {
                v_Found_MultiDCI_MultiTRP_r16 := true;
                if ((not (match(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620[v_Index].multiDCI_MultiTRP_r16.maxNumberCORESET_r16,(n2,n3,n4,n5)))) or (not (match(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620[v_Index].multiDCI_MultiTRP_r16.maxNumberCORESETPerPoolIndex_r16,(1,2,3)))) or (not (match(v_Received_NRCapabilityMsg.featureSets.featureSetDownlinkPerCC_v1620[v_Index].multiDCI_MultiTRP_r16.maxNumberUnicastPDSCH_PerPool_r16,(n1,n2,n3,n4,n7))))) {
                  f_SetVerdict(fail,__FILE__, __LINE__, "MultiDCI_MultiTRP_r16 contents sent by UE do not match with expected values");
                  }
              }
                v_Index := v_Index + 1;
            }
        }
        f_CompareCapability_vs_PICS(pc_multiDCI_MultiTRP_r16, v_Found_MultiDCI_MultiTRP_r16,"MultiDCI-MultiTRP-r16");
    }
  }

  /*
   * @desc      Function to check featureSets in Rel17 against PICS. If there is a mismatch, a verdict is raised
   * @param     p_NRCapability
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_featureSets_r17 (UE_NR_Capability p_NRCapability)
  { //@sic R5-255069 sic@
    var UE_NR_Capability v_Received_NRCapabilityMsg;
    var integer v_Index := 0;
    var boolean v_Found_mTRP_PUSCH_TypeB_CB_r17 := false;
    var boolean v_Found_broadcastSCell_r17 := false;
    var boolean v_Found_mtrpPuschTypeACB_r17 := false;

    v_Received_NRCapabilityMsg := p_NRCapability;

    if (match (v_Received_NRCapabilityMsg.accessStratumRelease, rel17)) { // checks Rel17
        v_Index := 0;
        if(ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1710)) {
            while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1710)) and (not v_Found_mtrpPuschTypeACB_r17)) { // check featureSetsUplink_v1710
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplink_v1710[v_Index].mTRP_PUSCH_TypeA_CB_r17)) {
                v_Found_mtrpPuschTypeACB_r17 := true;
              }
              v_Index := v_Index + 1;
            }
        }
        f_CompareCapability_vs_PICS(pc_mtrpPuschTypeACb_r17, v_Found_mtrpPuschTypeACB_r17,"mtrpPuschTypeACB-r17");

        v_Index := 0;
        if (ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC_v1700)) {
            while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC_v1700)) and (not v_Found_broadcastSCell_r17)) { // check FeatureSetDownlinkPerCC_v1700
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsDownlinkPerCC_v1700[v_Index].broadcastSCell_r17)) {
                v_Found_broadcastSCell_r17 := true;
              }
              v_Index := v_Index + 1;
            }
        }

        v_Index := 0;
        if (ispresent(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC_v1700)) {
            while ((v_Index < lengthof(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC_v1700)) and (not v_Found_mTRP_PUSCH_TypeB_CB_r17)) { // check featureSetsUplinkPerCC_v1700
              if (isvalue(v_Received_NRCapabilityMsg.featureSets.featureSetsUplinkPerCC_v1700[v_Index].mTRP_PUSCH_TypeB_CB_r17)) {
                v_Found_mTRP_PUSCH_TypeB_CB_r17 := true;
              }
              v_Index := v_Index + 1;
            }
        }
        f_CompareCapability_vs_PICS(pc_broadcastSCell_r17, v_Found_broadcastSCell_r17,"broadcastSCell-r17");

        f_CompareCapability_vs_PICS(pc_mtrpPuschTypeBCb_r17, v_Found_mTRP_PUSCH_TypeB_CB_r17,"mTRP-PUSCH-TypeB-CB-r17");
        if ((not pc_nrMIMO_CB_PUSCH) and (v_Found_mtrpPuschTypeACB_r17 or v_Found_mTRP_PUSCH_TypeB_CB_r17))
        {
           f_SetVerdict(fail,__FILE__, __LINE__, "TS 38.306, clause 4.2.7.7: The UE indicating support of mTRP_PUSCH_TypeA_CB_r17 or mTRP-PUSCH-TypeB-CB-r17 shall also indicate the support of mimo-CB-PUSCH");
        }
    }
  }

  /*
   * @desc      Function to check the notes on UE-NR-Capability calling a nested function per IE
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_NR_Notes(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-197070 R5-225384 sic@
    fl_Check_intraAndInterF_MeasAndReport(p_ReceivedCapabilityMsg); // Note 1
    fl_Check_eventA_MeasAndReport(p_ReceivedCapabilityMsg);         // Note 2
    fl_Check_csi_RSRP_AndRSRQ_MeasWithSSB(p_ReceivedCapabilityMsg); // Note 3
    fl_Check_skipUplinkTxDynamic(p_ReceivedCapabilityMsg);          // Note 4
    fl_Check_logicalChannelSR_DelayTimer(p_ReceivedCapabilityMsg);  // Note 5
    fl_Check_longDRX_Cycle(p_ReceivedCapabilityMsg);                // Note 6
    fl_Check_shortDRX_Cycle(p_ReceivedCapabilityMsg);               // Note 7
    //Note 8 and 9 are checked in fl_Check_Rf_Parameters_NRBand_PICS_Supp/fl_Check_Rf_Parameters_PDSCH_PUSCH_256QAM
    fl_Check_ss_SINR_Meas (p_ReceivedCapabilityMsg);                    // Note 10
    fl_Check_csi_RSRP_AndRSRQ_MeasWithoutSSB(p_ReceivedCapabilityMsg);  // Note 11
    fl_Check_multipleConfiguredGrants(p_ReceivedCapabilityMsg);         // Note 12
    fl_Check_sftd_MeasNR_Neigh(p_ReceivedCapabilityMsg);                // Note 13
    fl_Check_handoverInterF_FRX_Diff(p_ReceivedCapabilityMsg);          // Note 14
    fl_Check_handoverInterF_XDD_Diff(p_ReceivedCapabilityMsg);          // Note 15
    fl_Check_voiceOverNR(p_ReceivedCapabilityMsg);                      // Note 16
    fl_Check_dl_SchedulingOffset_PDSCH_TypeA_XDD_Diff(p_ReceivedCapabilityMsg); // Note 17
    fl_Check_dl_SchedulingOffset_PDSCH_TypeA_FRX_Diff(p_ReceivedCapabilityMsg); // Note 18
    f_Check_twoPUCCH_AnyOthersInSlot(p_ReceivedCapabilityMsg); // Note 26
    //Note 20 is checked in fl_Check_Rf_Parameters_NRBand_PICS_Supp/fl_Check_Rf_Parameters_bwp_DiffNumerology
    //Note 21 is checked in fl_Check_Rf_Parameters_NRBand_PICS_Supp/fl_Check_Rf_Parameters_bwp_SameNumerology
    //Notes 19, 22, 23, 24, 25 are checked in fl_Check_NR_Notes_r16
  }

  /*
   * @desc      Function to check the notes within UE-NR-Capability-v1610 (>= Rel16) calling a nested function per IE
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_NR_Notes_r16(UE_NR_Capability p_ReceivedCapabilityMsg)
  {
    if(ispresent(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) //@sic R5s230297 sic@
    {
        fl_Check_drx_Adaptation_r16(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension);   // Note 19

        fl_Check_directMCG_SCellActivation_r16(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension);   // Note 23
        fl_Check_directMCG_SCellActivationResume_r16(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension);   // Note 24
        fl_Check_directSCG_SCellActivationResume_r16(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension);   // Note 25
        fl_Check_directSCG_SCellActivation_r16(p_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension);   // Note 27
    }

    fl_Check_idleInactiveNR_MeasReport_FRX_Diff(p_ReceivedCapabilityMsg); // Note 22
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of intraAndInterF_MeasAndReport along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs. Note 1 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_intraAndInterF_MeasAndReport(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5-197070 R5s191050 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamXDD_Diff_intraAndInterF_MeasAndReport := false;
    var boolean v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD := false;
    var boolean v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersXDD_Diff v_IntraAndInterF_MeasAndReport_Common;
    var MeasAndMobParametersXDD_Diff v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport;
    var MeasAndMobParametersXDD_Diff v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff)) {
      v_IntraAndInterF_MeasAndReport_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }

    if (pc_intraAndInterF_MeasAndReport) {
      // check indication of MeasAndMobParametersXDD_Diff_Common
      if (ispresent(v_IntraAndInterF_MeasAndReport_Common.intraAndInterF_MeasAndReport)) {
          v_MeasAndMobParamXDD_Diff_intraAndInterF_MeasAndReport := true;
        }

      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport.intraAndInterF_MeasAndReport)) {
          v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD := true;
        }

      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport.intraAndInterF_MeasAndReport)) {
          v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD := true;
        }

      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamXDD_Diff_intraAndInterF_MeasAndReport, v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD, v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD)))  //@sic R5s240547 sic@
      { // inconclusive case: UE does not report any IE for intraAndInterF_MeasAndReport but pc_intraAndInterF_MeasAndReport is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_intraAndInterF_MeasAndReport to true is inconsistent with reported capabilities");
      }

      // Error cases if the feature is set
      if ((not f_NR_DualModeCheck()) and (not v_MeasAndMobParamXDD_Diff_intraAndInterF_MeasAndReport) or v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD or v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-CapabilityAddXDD IEs is inconsistent with pc_intraAndInterF_MeasAndReport on Single Mode");
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_MeasAndMobParamXDD_Diff_intraAndInterF_MeasAndReport)
          {
             if (v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD and v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD) // fail case: both FDD and TDD capabilities are reported and IE on IntraAndInterF_MeasAndReport_Common is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs is inconsistent");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD or v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport_XDD)  // fail cases: if IE measAndMobParameters.measAndMobParametersXDD_Diff.intraAndInterF_MeasAndReport is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_IntraAndInterF_MeasAndReport_Common.intraAndInterF_MeasAndReport) or
          ispresent(v_FDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport.intraAndInterF_MeasAndReport) or
          ispresent(v_TDD_Add_UE_NR_Cap_intraAndInterF_MeasAndReport.intraAndInterF_MeasAndReport)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_intraAndInterF_MeasAndReport to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of eventA_MeasAndReport along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs. Note 2 on on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_eventA_MeasAndReport(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5s190471 R5s191050 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamXDD_Diff_Common := false;
    var boolean v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD := false;
    var boolean v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersXDD_Diff v_EventA_MeasAndReport_Common;
    var MeasAndMobParametersXDD_Diff v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport;
    var MeasAndMobParametersXDD_Diff v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff)) {
      v_EventA_MeasAndReport_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.measAndMobParametersXDD_Diff;
    }

    if(pc_eventA_MeasAndReport) {
      // check indication of MeasAndMobParametersXDD_Diff_Common
      if (ispresent(v_EventA_MeasAndReport_Common.eventA_MeasAndReport)) {
          v_MeasAndMobParamXDD_Diff_Common := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport.eventA_MeasAndReport)) {
          v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport.eventA_MeasAndReport)) {
          v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD := true;
      }

      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamXDD_Diff_Common, v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD, v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for eventA_MeasAndReport but pc_eventA_MeasAndReport is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_eventA_MeasAndReport to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_DualModeCheck()) and (not v_MeasAndMobParamXDD_Diff_Common) or v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD or v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-CapabilityAddXDD IEs are inconsistent with pc_eventA_MeasAndReport on Single Mode");
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_MeasAndMobParamXDD_Diff_Common)
          {
             if (v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD and v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD) // fail case: both FDD and TDD capabilities are reported and IE in measAndMobParameters.measAndMobParametersXDD_Diff is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD or v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport_XDD)  // fail cases: if measAndMobParameters.measAndMobParametersXDD_Diff.eventA_MeasAndReport is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_EventA_MeasAndReport_Common.eventA_MeasAndReport) or
          ispresent(v_FDD_Add_UE_NR_Cap_eventA_MeasAndReport.eventA_MeasAndReport) or
          ispresent(v_TDD_Add_UE_NR_Cap_eventA_MeasAndReport.eventA_MeasAndReport)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_eventA_MeasAndReport to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of csi_RSRP_AndRSRQ_MeasWithSSB along with fr1-Add-UE-NR-Capabilities, fr2-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 3 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_csi_RSRP_AndRSRQ_MeasWithSSB(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5s190471 R5-197070 R5-206430 R5s210949 sic@
    var boolean v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithSSB := false;
    var boolean v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB := false;
    var boolean v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MeasAndMobParametersFRX_Diff v_MeasAndMobParamFRX_csi_RSRP_AndRSRQ_MeasWithSSB_Common;
    var MeasAndMobParametersFRX_Diff v_FR1_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB;
    var MeasAndMobParametersFRX_Diff v_FR2_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB;

    if (ispresent(v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff)) {
      v_MeasAndMobParamFRX_csi_RSRP_AndRSRQ_MeasWithSSB_Common := v_ReceivedCapabilityMsg.measAndMobParameters.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR1_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB := v_ReceivedCapabilityMsg.fr1_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff)) {
      v_FR2_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB := v_ReceivedCapabilityMsg.fr2_Add_UE_NR_Capabilities.measAndMobParametersFRX_Diff;
    }

    if(pc_csi_RSRP_AndRSRQ_MeasWithSSB) {
      // check indication of MeasAndMobParametersFRX_Diff_Common
      if (ispresent(v_MeasAndMobParamFRX_csi_RSRP_AndRSRQ_MeasWithSSB_Common.csi_RSRP_AndRSRQ_MeasWithSSB)) {
          v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithSSB := true;
      }
      // check indication of FR1 IE
      if (ispresent(v_FR1_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB.csi_RSRP_AndRSRQ_MeasWithSSB)) {
          v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB := true;
      }
      // check indication of FR2 IE
      if (ispresent(v_FR2_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB.csi_RSRP_AndRSRQ_MeasWithSSB)) {
          v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB := true;
      }

      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithSSB, v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB, v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for csi_RSRP_AndRSRQ_MeasWithSSB but pc_csi_RSRP_AndRSRQ_MeasWithSSB is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_csi_RSRP_AndRSRQ_MeasWithSSB to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithSSB) or v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB or v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_csi_RSRP_AndRSRQ_MeasWithSSB on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithSSB)
          {
             if (v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB and v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithSSB or v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithSSB)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_csi_RSRP_AndRSRQ_MeasWithSSB_Common.csi_RSRP_AndRSRQ_MeasWithSSB) or
              ispresent(v_FR1_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB.csi_RSRP_AndRSRQ_MeasWithSSB) or
              ispresent(v_FR2_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithSSB.csi_RSRP_AndRSRQ_MeasWithSSB)) {
            f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_csi_RSRP_AndRSRQ_MeasWithSSB to false is inconsistent with reported capabilities for a Rel-15 and above UE");
          }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of skipUplinkTxDynamic along with fdd-Add-UE-NR-Capabilities, tdd-Add-UE-NR-Capabilities for Rel-15 UEs.
                Note 4 on Table UE-NR-Capability
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_Check_skipUplinkTxDynamic(UE_NR_Capability p_ReceivedCapabilityMsg)
  { //@sic R5-201761 R5-197070 R5-206430 R5s210949 sic@
    var boolean v_Mac_ParametersXDD_Diff_skipUplinkTxDynamic  := false;
    var boolean v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic := false;
    var boolean v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic := false;
    var UE_NR_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var MAC_ParametersXDD_Diff v_SkipUplinkTxDynamic_Common;
    var MAC_ParametersXDD_Diff v_FDD_Add_UE_NR_Cap;
    var MAC_ParametersXDD_Diff v_TDD_Add_UE_NR_Cap;

    if (ispresent(v_ReceivedCapabilityMsg.mac_Parameters.mac_ParametersXDD_Diff)) {
      v_SkipUplinkTxDynamic_Common := v_ReceivedCapabilityMsg.mac_Parameters.mac_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff)) {
      v_FDD_Add_UE_NR_Cap := v_ReceivedCapabilityMsg.fdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff;
    }
    if (ispresent(v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff)) {
      v_TDD_Add_UE_NR_Cap := v_ReceivedCapabilityMsg.tdd_Add_UE_NR_Capabilities.mac_ParametersXDD_Diff;
    }

    if(pc_skipUplinkTxDynamic) {
      // check indication of mac-ParametersXDD-Diff
      if (ispresent(v_SkipUplinkTxDynamic_Common.skipUplinkTxDynamic)) {
          v_Mac_ParametersXDD_Diff_skipUplinkTxDynamic := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_NR_Cap.skipUplinkTxDynamic)) {
          v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_NR_Cap.skipUplinkTxDynamic)) {
          v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic := true;
      }
      if (not (f_NR_AnyOfThree_SignaledbyUE(v_Mac_ParametersXDD_Diff_skipUplinkTxDynamic, v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic, v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for skipUplinkTxDynamic but pc_skipUplinkTxDynamic is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_skipUplinkTxDynamic to true is inconsistent with reported capabilities");
      }

      //@sic R5s200160 sic@
      if ((not f_NR_DualModeCheck()) and ((not v_Mac_ParametersXDD_Diff_skipUplinkTxDynamic) or (v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic or v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic))) {
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-Capabilities IEs are inconsistent with pc_skipUplinkTxDynamic on Single Mode"); // fail case single mode
      }
      else if(f_NR_DualModeCheck()) // case dual mode
      {
          if (not v_Mac_ParametersXDD_Diff_skipUplinkTxDynamic)
          {
             if (v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic and v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic) // fail case: both FDD and TDD capabilities are reported and IE in mac_Parameters.mac_ParametersXDD_Diff is not
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FDD_Add_UE_NR_Cap_skipUplinkTxDynamic or v_TDD_Add_UE_NR_Cap_skipUplinkTxDynamic)  // fail cases: if mac_Parameters.mac_ParametersXDD_Diff.skipUplinkTxDynamic is reported but FDD and/or TDD capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_SkipUplinkTxDynamic_Common.skipUplinkTxDynamic) or ispresent(v_FDD_Add_UE_NR_Cap.skipUplinkTxDynamic) or
          ispresent(v_TDD_Add_UE_NR_Cap.skipUplinkTxDynamic)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_skipUplinkTxDynamic to false is inconsistent with reported capabilities for a Rel-15 and above UE");
      }
    }
  }

