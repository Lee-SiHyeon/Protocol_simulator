   */
  function f_NR_CellInfo_SetSIB1_CellSelectionInfo(NR_CellId_Type p_NR_CellId,
                                                   template (value) SIB1.cellSelectionInfo p_CellSelectionInfo) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellSelectionInfo:= valueof(p_CellSelectionInfo);
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  };

  /*
   * @desc      Assign the parameterised PRACH configuration index in the CellArray UL BWP and SIB1(if available) of the cell
   * @param     p_NR_CellId
