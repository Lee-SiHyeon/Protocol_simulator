    {
      RNTI := tsc_C_RNTI_Def,     // 4097 ('1001'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(20, 4),        // subframe 0
        cs_CCE_StartIndex_DL_UL( 2, 18),       // subframe 1
        cs_CCE_StartIndex_DL_UL(10, 26),       // subframe 2
        cs_CCE_StartIndex_DL_UL(28, 12),       // subframe 3
        cs_CCE_StartIndex_DL_UL( 0, 16),       // subframe 4
        cs_CCE_StartIndex_DL_UL(26, 10),       // subframe 5
        cs_CCE_StartIndex_DL_UL(16, 0),        // subframe 6
        cs_CCE_StartIndex_DL_UL( 8, 24),       // subframe 7
