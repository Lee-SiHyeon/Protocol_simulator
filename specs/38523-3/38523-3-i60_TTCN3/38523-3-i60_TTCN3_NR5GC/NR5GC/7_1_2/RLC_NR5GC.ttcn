    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    if (v_PDCP_LongSN == false) { v_RLC_Rec.AM_SN_Size := 12; } // @sic R5-227529, R5-256644 sic@
    v_RLC_Rec.t_PollRetransmit := 0.5;
    v_RLC_Rec.t_Reassembly := 0.15;
    v_RLC_Rec.t_StatusProhibit := 0.3;

    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_9_NR_TestBody (v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.10
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_3_10_NR5GC() runs on NR5GC_PTC
  { // AM RLC / Re-transmission of RLC PDU with and without re-segmentation
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var DL_t_Reassembly_Type v_T_Reassembly;
    var DRB_Identity v_DRBId;
    var SN_FieldLengthAM v_SN_FieldLengthAM := size18;
    var boolean v_PDCP_LongSN := not f_NR_SupportOfRedCap(); // @sic R5-226644 sic@ eRedCap: short PDCP header and one more data octet
    
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);

    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();

    if (v_PDCP_LongSN == false) { // @sic R5-227601, R5-256644 sic@
      v_SN_FieldLengthAM := size12;
    };

    // Establishing UL AM RLC parameters
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(v_DRBId,
                                                     f_NR_38508_SetSNFieldLengthAM(), // @sic R5-227601 sic@
                                                     ms150, // t_PollRetransmit
                                                     -,
                                                     -,
                                                     -,
                                                     f_NR_38508_SetSNFieldLengthAM(), // @sic R5-227601 sic@
                                                     v_T_Reassembly);
    f_NR5GC_RRC_ConnectedState3N_RLC_AM (v_DRBId, v_RLC_BearerConfigList[0], v_SN_FieldLengthAM); // @sic R5-227601 sic@

    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    if (v_PDCP_LongSN == false) { v_RLC_Rec.AM_SN_Size := 12; } // @sic R5-227601, R5-256644 sic@
    v_RLC_Rec.t_PollRetransmit := 0.15;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};

    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_10_NR_TestBody (v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.11
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_3_11_NR5GC() runs on NR5GC_PTC
  { // AM RLC / RLC re-establishment procedure
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    var DRB_Identity v_DRBId;
    var SN_FieldLengthAM v_SN_FieldLengthAM := size18;
    var boolean v_PDCP_LongSN := not f_NR_SupportOfRedCap(); // @sic R5-226644 sic@ eRedCap: short PDCP header and one more data octet
    
    f_NR5GC_Init(NR_1);
    
    //Set sr-transmax to 64
    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(nr_Cell1);
    v_MAC_CellGroupConfig.schedulingRequestConfig.schedulingRequestToAddModList[0].sr_TransMax := n64; // @sic R5s250330 sic@
    f_NR_CellInfo_SetMAC_CellGroupConfig(nr_Cell1, v_MAC_CellGroupConfig); // @sic R5s191200_r2 sic@

    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);

    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();

    if (v_PDCP_LongSN == false) { // @sic R5-227518, R5-256644 sic@
      v_SN_FieldLengthAM := size12;
    };

    //Re-establish DRB1 and modify RLC parameters
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(v_DRBId,
                                                     f_NR_38508_SetSNFieldLengthAM(), // @sic R5-227518 sic@
                                                     ms4000,
                                                     -,
                                                     -,
                                                     -,
                                                     f_NR_38508_SetSNFieldLengthAM(), // @sic R5-227518 sic@
                                                     ms200); // @sic R5s191200 sic@
    f_NR5GC_RRC_ConnectedState3N_RLC_AM (v_DRBId, v_RLC_BearerConfigList[0], v_SN_FieldLengthAM, omit);   // @sic R5-227518 sic@
                                                                                        //statusReportRequired not present @sic R5-194296 sic@
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.t_PollRetransmit := 4.0; // @sic R5s191200 sic@
    v_RLC_Rec.t_Reassembly := 0.2; // @sic R5s191200 sic@
    if (v_PDCP_LongSN == false) { v_RLC_Rec.AM_SN_Size := 12; } // @sic R5-227518, R5-256644 sic@
    
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_11_NR_TestBody (v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.11
   * @param     p_RLC_Rec
   * @param     p_NR_DRB_Id
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_3_11_NR_TestBody(NR_RLC_SS_State_Type p_RLC_Rec,
                                        DRB_Identity p_NR_DRB_Id) runs on NR5GC_PTC
  { // AM RLC / RLC re-establishment procedure
    //@sic R5-194296 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList := f_NR5GC_GetExisting_BearerToAddModList(true_);
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigListDRB_Only;
    var NR_RLC_DataFieldList_Type v_NR_RLC_DataList;
    var template (value) NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (present) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU_Expected;
    var template (present) NR_RLC_PDUList_Type v_NR_RLC_PDUList;
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
    var SN_FieldLengthAM v_SN_FieldLengthAM := size18;
    var boolean v_PDCP_LongSN := not f_NR_SupportOfRedCap(); // @sic R5-226644 sic@ eRedCap: short PDCP header and one more data octet

    if (v_PDCP_LongSN == false) { // @sic R5-227518, R5-256644 sic@
      v_SN_FieldLengthAM := size12;
    };

    v_RLC_BearerConfigList := f_NR5GC_GetExisting_BearerToAddModList(true_); //@sic R5-227421 sic@
    v_RLC_BearerConfigListDRB_Only := f_NR_ReconfigureRLC_AM(p_NR_DRB_Id,
                                                             f_NR_38508_SetSNFieldLengthAM(),
                                                             ms4000,
                                                             -,
                                                             -,
                                                             -,
                                                             f_NR_38508_SetSNFieldLengthAM(),
                                                             ms200,
                                                             -,
                                                             true_); // @sic R5-227518 sic@
    v_RLC_BearerConfigList[2] := v_RLC_BearerConfigListDRB_Only[0];
    v_SS_Drb_ConfigList := f_NR5GC_GetRadioBearerList(f_NR5GC_MobileInfo_GetDRBInfoList()); // @sic R5-227421 sic@
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(p_NR_DRB_Id, v_SN_FieldLengthAM); // @sic R5-227518 sic@
    v_CellGroupConfig := f_NR_GetCellGroupConfigHO (nr_Cell1, v_RLC_BearerConfigList); //tsc_C_RNTI_Value3

    v_NR_RLC_DataList := f_TC_7_1_2_3_11_NR_Steps1To4(p_RLC_Rec, p_NR_DRB_Id); // RedCap considered !
     
    // @siclog "Step 5" siclog@
    //The SS transmits NR RRCReconfiguration message to trigger RLC re-establishment on DRB using Reconfig with sync procedure.
    // @siclog "Step 6" siclog@
    //The SS starts the UL default grant transmissions
    f_NR_RLC_ReconfigurationHO_Steps1_8 (nr_Cell1,
                                         p_NR_DRB_Id,
                                         v_RLC_BearerConfigList,
                                         cs_38508_PDCP_Config(-, ms160, omit), // @sic R5-227518 sic@
                                         v_SS_Drb_ConfigList,
                                         -,
                                         v_CellGroupConfig,
                                         -,
                                         480  //Note 10: UL grant in Random Access Msg4 of 480 bits  @sic R5-232972 sic@
                                         ); // @sic R5s191200, R5-204512 sic@

    //EXCEPTION: Steps 7 and 8 can occur in any order.
    // @siclog "Step 7" siclog@
    //The UE transmits a NR RRCReconfigurationComplete message.
    // @siclog "Step 8" siclog@
    //The UE retransmits RLC SDU #1 (SN=0).
    p_RLC_Rec.AM_RX_Next := 0; // only update of the RLC record which is needed @sic R5s201335 sic@
    v_NR_RLC_AMD_PDU_Expected := f_NR_RLC_Get_AMD_FullSDU_RX(p_RLC_Rec, ?, v_NR_RLC_DataList[tsc_RLC_SDU1]);
    v_NR_RLC_PDUList := { cr_NR_RLC_PDU_AMD(v_NR_RLC_AMD_PDU_Expected) };

    interleave { // @sic R5-204512 sic@
      []  SRB.receive(car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_RRCReconfigurationComplete)) {}
      []  DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(nr_Cell1,
                                                        p_NR_DRB_Id,
                                                        -,
                                                        v_NR_RLC_PDUList)) -> value v_NR_DRB_COMMON_IND
        { p_RLC_Rec.TimeStampLastReceivedPDU := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame; }
    }

    // steps left from HO: f_NR5GC_508RRC_IntraNR_HO_IntraCell_Step9_10 @sic R5-204512 sic@
    //Step 9 (after step 8) Re-configure RACH procedure as for initial access, enable TA transmissions.
    f_NR_SS_RachProcedureConfig_Def(nr_Cell1);
    // enable TA transmissions
    f_NR_ULGrantConfiguration_Common(nr_Cell1, -, -, cs_NR_UplinkTimeAlignment_Start, cs_UL_GrantConfig_OnSR);

    f_TC_7_1_2_3_11_NR_Steps9To15(p_RLC_Rec, p_NR_DRB_Id, v_NR_RLC_DataList); // @sic R5s191200, R5-204512 sic@
  }

}
