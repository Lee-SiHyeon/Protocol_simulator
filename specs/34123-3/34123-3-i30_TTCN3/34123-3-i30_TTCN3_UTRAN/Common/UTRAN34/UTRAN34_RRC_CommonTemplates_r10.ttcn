module UTRAN34_RRC_CommonTemplates_r10 {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_CommonTemplates all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_RAB_Templates_r9 all;

    /*
   * @desc      To convert boolean to specific enumerated type
   * @param     p_Qam64Boolean
   * @return    template (omit) DL_64QAM_Configured_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_ConvertBoolTo64QAM(boolean p_Qam64Boolean) return template (omit) DL_64QAM_Configured_Type
  {
    var template (omit) DL_64QAM_Configured_Type v_QAM64 := omit;
    if (p_Qam64Boolean) {
      v_QAM64 := true_;
    }
    return v_QAM64;
  }

  /*
   * @desc      To convert boolean to specific enumerated type
   * @param     p_Qam64Boolean
   * @return    template (omit) DL_SecondaryCell64QAM_Configured_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN_ConvertBoolToSecondaryCell64QAM(boolean p_Qam64Boolean) return template (omit) DL_SecondaryCell64QAM_Configured_Type
  {
    var template (omit) DL_SecondaryCell64QAM_Configured_Type v_QAM64 := omit;
    if (p_Qam64Boolean) {
      v_QAM64 := true_;
    }
    return v_QAM64;
  }

  template (value) DL_CommonInformation_r10 cs_DL_CommonInformationF_DPCH_FDD_r10 :=
  { /* @status    APPROVED (UTRAN) */
    dl_dpchInfoCommon := {
      dl_FDPCH_InfoCommon := cs_DL_FDPCH_InfoCommon_r6
    },
    modeSpecificInfo := {
      fdd := {
        defaultDPCH_OffsetValue := tsc_DefaultDPCH_OffsetValue,
        dpch_CompressedModeInfo := omit,
        tx_DiversityMode := noDiversity
      }
    },
    mac_hsResetIndicator := omit,
    postVerificationPeriod := omit
  };

  template (value) SS_MAC_ehs_AddReconfReordQ_r9 cs_SS_MAC_ehs_AddReconfReordQ_r9(MAC_ehs_QueueId p_QID,
                                                                                  integer  p_QueuePriority) :=
  { /* @status    APPROVED (UTRAN) */
    mAC_ehs_AddReconfReordQ := cs_MAC_ehs_AddReconfReordQ_r9 (p_QID),
    priority := p_QueuePriority
  };

    template (value) MAC_ehs_AddReconfReordQ_r9 cs_MAC_ehs_AddReconfReordQ_r9(MAC_ehs_QueueId p_QID,
                                                                            MAC_hs_WindowSize_r9 p_Mw := mws16) := // @sic R5s140782 sic@
  { /* @status    APPROVED (UTRAN) */
    mac_ehs_QueueId := p_QID,
    reorderingReleaseTimer := rt50,
    reorderingResetTimer := omit,
    mac_ehsWindowSize := p_Mw
  };

    template (value) SS_DL_RLC_Mode cs_SS_DL_RLC_Mode_RB25_Flexible(template (value) UL_AM_RLC_Mode p_UL_AM_RLC_Mode) :=
  /* @status    APPROVED (UTRAN) */
    cs_SS_DL_RLC_AM_Mode(omit, p_UL_AM_RLC_Mode, cs_SS_DL_RLC_Mode_PDU_flexibleSize);

    template (value) DL_AM_RLC_Mode_r7 cds_DL_AM_RLC_Flexible_r7(template (value) ReceivingWindowSize p_Rw := rw2047) modifies cs_DL_AM_RLC_r7 :=
  { /* @status    APPROVED (UTRAN) */
    dl_RLC_PDU_size := {
      flexibleSize := size7
    },
    receivingWindowSize := p_Rw,
    dl_RLC_StatusInfo := {
      timerStatusProhibit := tsp80
    }
  };

  template (value) HSPA_InfoPerCell_Type cs_HSPA_InfoPerCell_64QAM(template (value) HS_SCCH_Info_r9 p_HS_SCCH_Info := cs_HS_SCCH_Info_r9_FDD_ChC6_7) :=
  { /* @status    APPROVED (UTRAN) */
    // 64 QAM
    dl_64QAM := true,
    hS_SCCH_Info := p_HS_SCCH_Info,
    // OCTETALIGNED
    octetAlignedConfigured := true,
    hS_DSCH_TBSizeTable:= omit //@sic R5-145759 sic@
   };

  template (value) HSPA_InfoPerCell_Type cs_HSPA_InfoPerCell_64QAM_NoEDCH := cs_HSPA_InfoPerCell_64QAM(cs_HS_SCCH_Info_r9_FDD_ChC4_5); /* @status    APPROVED (UTRAN) */

  template (value) HS_SCCH_Info_r9 cs_HS_SCCH_Info_r9_FDD_ChC6_7 := cs_HS_SCCH_Info_r9_FDD_Common({tsc_HS_SCCH_ChC6, tsc_HS_SCCH_ChC7});      /* @status    APPROVED (UTRAN) */

  template (value) HS_SCCH_Info_r9 cs_HS_SCCH_Info_r9_FDD_ChC4_5 := cs_HS_SCCH_Info_r9_FDD_Common({tsc_HS_SCCH_ChC4, tsc_HS_SCCH_ChC5});      /* @status    APPROVED (UTRAN) */

  template (value) MIMO_Parameters_r9 cs_MIMO_ParametersStart_r9(template (omit) ChannelisationCode256 p_SCPICH_ChannelisationCode) :=
  { /* @status    APPROVED (UTRAN) */
    mimoOperation := start_,
    modeSpecificInfo := { fdd := {
        mimoN_M_Ratio := mnm1_1,
        mimoPilotConfiguration := {
          secondCPICH_Pattern := {
            diversityPattern := {
              channelisationCode := p_SCPICH_ChannelisationCode,
              s_cpich_PowerOffset_Mimo := 0
            }
          }
        },
        precodingWeightSetRestriction := true_
      }
    }
  };

}
