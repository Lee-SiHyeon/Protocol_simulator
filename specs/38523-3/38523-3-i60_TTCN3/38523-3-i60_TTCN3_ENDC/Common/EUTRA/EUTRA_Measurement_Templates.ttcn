    template (value) MeasConfig cs_Meassurement_Config_Gap_ENDC(template (omit) MeasGapConfig p_MeasGapConfig := cs_MeasGapConfig_setup_gp0(9),
                                                                template (omit) boolean p_Fr1_Gap_r15 := false,
                                                                template (omit) boolean p_Mgta_r15 := false) :=
       /* @status    APPROVED (ENDC) */
       cs_MeasConfig(omit, omit, omit, omit, omit, omit, omit, p_MeasGapConfig, omit, omit, omit, omit, p_Fr1_Gap_r15, p_Mgta_r15);

  /*
   * @desc      This function return the EARFCN-v9e0 value to be used in MeasConfig. If measObjectToAddModList has 2 entries,
   *            and the second entry is for NR, use the p_NeedsSecondEmptyEntry set to true
   * @param     p_ARFCN_ValueEUTRA_r9
   * @param     p_NeedsSecondEmptyEntry (default value: false)
   * @return    template
   * @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_ReturnMeasObjectToAddModList_v9e0(ARFCN_ValueEUTRA_r9 p_ARFCN_ValueEUTRA_r9,
                                               boolean p_NeedsSecondEmptyEntry := false) return template (omit) MeasObjectToAddModList_v9e0
  { //@sic R5-169116 sic@
    var template (omit) MeasObjectToAddModList_v9e0 v_MeasObjectToAddModList_v9e0 := omit;
    
    if (p_ARFCN_ValueEUTRA_r9 >= maxEARFCN) { //i.e. Band > 64
      if (p_NeedsSecondEmptyEntry) {//@sic R5-260136 sic@
          v_MeasObjectToAddModList_v9e0:={cs_MeasObjectToAddMod_v9e0(p_ARFCN_ValueEUTRA_r9),
                                          cs_MeasObjectToAddMod_v9e0_Omit};
          
      }
      else{
          v_MeasObjectToAddModList_v9e0 := cs_MeasObjectToAddModList_v9e0_1Entry(p_ARFCN_ValueEUTRA_r9);
      }
    }
    return v_MeasObjectToAddModList_v9e0;
  }

}
