    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5-195369, R5s@210089, R5s210379 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_Common_TestBody(triggerEvent_A1);
