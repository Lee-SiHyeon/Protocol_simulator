      gnss_TimeOfDay := p_GNSS_ReferenceTime.gnss_SystemTime.gnss_TimeOfDay,
      gnss_TimeOfDayFrac_msec := omit,
      notificationOfLeapSecond := p_NotificationOfLeapSecond,
      gps_TOW_Assist := p_GPS_TOW_Assist
    },
    referenceTimeUnc := p_GNSS_ReferenceTime.referenceTimeUnc,
    gnss_ReferenceTimeForCells := omit
  };

