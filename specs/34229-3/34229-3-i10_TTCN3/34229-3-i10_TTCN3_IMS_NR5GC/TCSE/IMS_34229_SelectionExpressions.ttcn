      }
      case (IMS34_C141) {
        v_ApplCond := pc_NG102_Call_Combined_Registration_WLAN;
      }
      case (IMS34_C147) {
        v_ApplCond := pc_EPS_IMS_eCall_Capable and pc_eCall_manual_Initiated;
      }
      case (IMS34_C148) {
        v_ApplCond := pc_EPS_IMS_eCall_Capable and pc_eCall_automatic_Initiated;
      }
      case (IMS34_C149) {
        v_ApplCond := pc_EPS_IMS_eCall_Only and pc_eCall_manual_Initiated;
      }
      case (IMS34_C150) {
        v_ApplCond := pc_EPS_IMS_eCall_Only and pc_eCall_automatic_Initiated;
      }
      case (IMS34_C151) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C152) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C153) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_Preconditions and pc_WLAN and pc_MTSI_Video;
      }
      case (IMS34_C154) {
        v_ApplCond := pc_SMS_IP_MO and pc_Use_SMS_over_IP and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C155) {
        v_ApplCond := pc_SMS_IP_MT and pc_Use_SMS_over_IP and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C157) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_InitiateSession and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1 and pc_IMS_Session_Timer;
      }
      case (IMS34_C158) {
