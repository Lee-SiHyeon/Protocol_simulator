  type enumerated MCX_SessionModificationType_Type { UPGRADE, DOWNGRADE };                                              /* @status    APPROVED (MCX) */

  type enumerated MCX_MCServiceInfoRX_Condition_Type { NONE, INVITE_REFER, INVITE_RSP };                                /* @status    APPROVED (MCX) */

  type enumerated MCX_CommencementMode_Type {                                                                           /* @status    APPROVED (MCX) */
    ANY,
    AUTOMATIC,
    AUTOMATIC_FORCE,
    AMBIENT_LISTENING_REMOTE,
    AMBIENT_LISTENING_LOCAL,
    AMBIENT_VIEWING_REMOTE,
    AMBIENT_VIEWING_LOCAL,
    MANUAL,
    PRIV_MANUAL,
    NONE
  };

  const boolean tsc_MCX_ReInvite := true;                       /* @status    APPROVED (MCX) */

  type record MCX_SecurityKey_Type {    /* @status    APPROVED (MCX) */
    B32_Type    Id,
    octetstring Value,
    octetstring RAND optional
  };

  /*
   * @desc      Build absolute URI according to clause 4.3 of RFC 3986
   * @param     p_Scheme            (default value: "https")
   * @param     p_IpAddressOrHostname
   * @param     p_Portnumber        (default value: omit)
   * @param     p_AbsolutePath      (default value: "")
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_AbsoluteServerURI(charstring p_Scheme := "https",
                                   charstring p_IpAddressOrHostname,
                                   template (omit) integer p_Portnumber := omit,
                                   charstring p_AbsolutePath := "") return charstring
  {
    var charstring v_UriString := p_Scheme & "://" & f_IpAddressAsHostname(p_IpAddressOrHostname);   // f_IpAddressAsHostname returns p_IpAddressOrHostname if it is not an IPv6 adddress

    if (isvalue(p_Portnumber)) {
      v_UriString := v_UriString & ":" & int2str(valueof(p_Portnumber));
    }
    v_UriString := v_UriString & p_AbsolutePath;
    
    return v_UriString;
  }

  /*
   * @desc      Convert MCX_ServiceType_Type into string
   *            p_ServiceType may be MCPTT, MCVideo, MCData but shall not be MCDataSDS, MCDataFD, MCDataIPCONN
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_ServiceName(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_ServiceName;

    select (p_ServiceType) {
      case (MCPTT)   { v_ServiceName := "MCPTT"; }
      case (MCVideo) { v_ServiceName := "MCVideo"; }
      case (MCData)  { v_ServiceName := "MCData"; }
      case else      { FatalError(__FILE__, __LINE__, "Invalid service type"); }
    }
    return v_ServiceName;
  }

  /*
   * @desc      Return Public Service Id (PSI) for MCPTT/MCVideo/MCData
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCServer_PublicServiceId(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_PublicServiceId;
    
    select (p_ServiceType) {
      case (MCPTT) {
        v_PublicServiceId := tsc_MCPTT_PublicServiceId_A;
      }
      case (MCVideo) {
        v_PublicServiceId := tsc_MCVideo_PublicServiceId_A;
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_PublicServiceId := tsc_MCData_PublicServiceId_A;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    return v_PublicServiceId;
  }

  /*
   * @desc      Return session id for an MCPTT/MCVideo/MCData call
   * @param     p_ServiceType
   * @param     p_SessionId         (default value: omit)
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_SessionId(MCX_ServiceType_Type p_ServiceType,
                           template (omit) charstring p_SessionId := omit) return charstring
  {
    var charstring v_SessionId;
    
    if (isvalue(p_SessionId)) {
      v_SessionId := valueof(p_SessionId);
    } else {                                                    // p_PublicServiceId := omit indicates default value to be used
      select (p_ServiceType) {
        case (MCPTT) {
          v_SessionId := tsc_MCPTT_SessionId;
        }
        case (MCVideo) {
          v_SessionId := tsc_MCVideo_SessionId;
        }
        case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
          v_SessionId := tsc_MCData_SessionId;
        }
        case else {
          FatalError(__FILE__, __LINE__, "Invalid service type");
        }
      }
    }
    return v_SessionId;
  }

  /*
   * @desc      Return MCPTT/MCVideo/MCData Id for user A
   * @param     p_ServiceType
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCService_ID_User_A(MCX_ServiceType_Type p_ServiceType) return charstring
  {
    var charstring v_MCServiceId;
    select (p_ServiceType) {
      case (MCPTT) {
        v_MCServiceId := px_MCPTT_ID_User_A;
      }
      case (MCVideo) {
        v_MCServiceId := px_MCVideo_ID_User_A;
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_MCServiceId := px_MCData_ID_User_A;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    return v_MCServiceId;
  }

