module NR_CellInfoInit {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from ENDC_CA_CommonFrequencyFunctions all;
  import from EUTRA_NR_Parameters all;
  import from NRDC_CA_CommonFunctions all;
  import from NR_ASP_Templates_BWP all;
  import from NR_ASP_TypeDefs all;
  import from NR_CA_CommonFunctions all;
  import from NR_CA_IntraBandFrequencyFunctions all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_DC_CommonFunctions all;
  import from NR_FrequencyCommon all;
  import from NR_FrequencyHighestBandwidth all;
  import from NR_FrequencyInit_SA all;
  import from NR_NTN_Configuration all;
  import from NR_Parameters all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_SysInfo_Templates all;
  import from Parameters all;
  import from TestcaseProperties all;

  const SchedulingInfo.si_Periodicity tsc_SIB2_Periodicity := rf32;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB3_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB4_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB5_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB6_Periodicity := rf32;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB7_Periodicity := rf32;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB8_Periodicity := rf32;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB10_Periodicity := rf64; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB11_Periodicity := rf64; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo.si_Periodicity tsc_SIB12_Periodicity := rf64; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB16_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB18_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB19_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB20_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB21_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB22_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB23_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const SchedulingInfo2_r17.si_Periodicity_r17 tsc_SIB25_Periodicity := rf64;  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_CellInfo_Type cs_NR_CellInfoDef(NR_CellIdentities_Type                     p_NR_CellIds,
                                                      template (value) NR_FrequencyBand_Type     p_NR_FrequencyBand,
                                                      template (value) NR_CellSysInfo_Type       p_NR_CellSysInfo,
                                                      CellTimingInfo_Type                        p_CellTimingInfo,
                                                      template (value) NR_DuplexMode_Type        p_NR_DuplexMode,
                                                      SubcarrierSpacing                          p_SubcarrierSpacing,
                                                      template (value) NR_SSB_BurstConfig_Type   p_SSB_Burstconfig,
                                                      template (omit) NR_DownlinkBWP_List_Type   p_DL_BWPs := omit,
                                                      template (omit) NR_UplinkBWP_List_Type     p_UL_BWPs := omit,
                                                      template (omit) RACH_ConfigDedicated       p_RACH_ConfigDedicated,
                                                      NR_AbsoluteCellPower_Type                  p_MaxReferencePower,
                                                      template (value) NR_NAS_Parameters_Type    p_NAS_Parameters,
                                                      template (value) NR_ServingCellConfig_Type p_NR_ServingCellConfig,
                                                      template (value) SSB_MTC                   p_SSB_MTC,
                                                      integer                                    p_OffsetCarrierCORESET0 := 0,
                                                      template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type p_RadioLinkMonitoringConfig := omit,
                                                      template (omit) NR_NTN_TimingAdvanceConfig_Type p_NtnTA := omit,
                                                      integer p_ChannelBandwidth
                                                      ) :=
  { /* @desc Default NR cell info value */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-212409 R5-216160 deleted CellCapability R5-226041: added default value 0 to p_OffsetCarrierCORESET0 for SDL bands having no CORESET0 sic@
    CellIds      :=  p_NR_CellIds,
    FrequencyBand := p_NR_FrequencyBand,
    ReferencePower := {
      MaxReferencePower := p_MaxReferencePower,
      Attenuation := {Off := true}
    },
    Sysinfo := p_NR_CellSysInfo,
    CellTimingInfo := p_CellTimingInfo,
    DuplexMode := p_NR_DuplexMode,
    PhysicalParameters := {
      SubcarrierSpacing := p_SubcarrierSpacing,  //Carrier SCS
      SSB_BurstConfig := p_SSB_Burstconfig,
      DL_BWPs := p_DL_BWPs,
      UL_BWPs := p_UL_BWPs,
      RACH_ConfigDedicated := p_RACH_ConfigDedicated,
      SSB_MTC := p_SSB_MTC,
      RadioLinkMonitoringConfig := p_RadioLinkMonitoringConfig,    //@sic R5s190244 R5-212409 sic@
      OffsetCarrierCORESET0 := p_OffsetCarrierCORESET0,    //@sic R5-202677 sic@
      ChannelBandwidth := p_ChannelBandwidth
    },
    RNTI  := { RNTI := tsc_C_RNTI_Value1 }, //Acc to 38.508-1 Table 4.6.3-151: RNTI-Value @sic R5s180640 change 1.2.3 sic@ @sic R5s190024 tsc_C_RNTI_Value1 instead of tsc_NR_RNTI_Value1 sic@
    NAS_Parameters := p_NAS_Parameters,
    ServingCellConfig := p_NR_ServingCellConfig,
    MeasGapCtrl := cs_NR_MeasGapCtrl_None,
    DrxCtrl := cs_NR_DrxCtrl_None,
    RLF_TimersAndConstants := cs_38508_RLF_TimersAndConstants,
    SupplementaryUplink := omit,
    TimingScheduling := {
        K2 := tsc_NR_SlotOffsetK2
    },
    NtnTA := p_NtnTA    //@sic R5-242320 sic@
  };

  template (value) NR_DuplexMode_Type cs_NR_DuplexModeFDD( boolean p_HalfDuplexFDD ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FDD := {
        HalfDuplexFDD := p_HalfDuplexFDD
    }
  };

  template (value) NR_DuplexMode_Type cs_NR_DuplexModeTDD(template (value) TDD_UL_DL_ConfigCommon p_TDD_UL_DL_ConfigCommon,
                                                          template (omit) NR_SharedSpectrum_ChannelAccessMode_Config_Type p_SharedSpectrumConfig := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    TDD := {
      Config := {
        Common := {  /* Common TDD UL/DL configuration */
          R15 := p_TDD_UL_DL_ConfigCommon
        },
        Dedicated := omit,
        SharedSpectrum := p_SharedSpectrumConfig /* @sic R5w24202r1 sic@ */
      }
    }
  };

  template (value) NR_SSB_BurstConfig_Type cs_NR_SSB_BurstConfig(NR_SS_BlockPattern_Type p_NR_SS_BlockPattern,
                                                                 ServingCellConfigCommon.ssb_PositionsInBurst  p_SSB_PositionsInBurst):=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    BlockPattern := p_NR_SS_BlockPattern,   /* case A..E according to 38.213 clause 4.1 */
    PositionsInBurst := p_SSB_PositionsInBurst,
    BeamArray := omit     // @sic R5w190122 sic@
  };

  template (value) NR_FrequencyBand_Type cs_NR_FrequencyBand(FreqBandIndicatorNR p_Band,
                                                             template (omit) integer p_ChannelBandwidth := omit,
                                                             template (omit) FrequencyInfoDL p_FreqDL := omit,
                                                             template (omit) FrequencyInfoUL p_FreqUL := omit,
                                                             integer p_Ssb_SubcarrierOffset := 0,
                                                             template (omit) ControlResourceSetZero p_Coreset0_Index := omit,
                                                             SubcarrierSpacing p_SSB_SubcarrierSpacing := kHz15,
                                                             template (omit) integer p_Dl_OffsetToPointA := omit,
                                                             template (omit) integer p_OffsetCarrierCORESET0 := omit,
                                                             template (omit) integer p_Coreset0_OffsetRBs := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    FrequencyBandIndicator  := p_Band,
    ChannelBandwidth        := p_ChannelBandwidth,
    FrequencyInfoDL         := p_FreqDL,
    FrequencyInfoUL         := p_FreqUL,
    Ssb_SubcarrierOffset    := p_Ssb_SubcarrierOffset,
    Coreset0_Index          := p_Coreset0_Index,
    SSB_SubcarrierSpacing   := p_SSB_SubcarrierSpacing,
    Dl_OffsetToPointA       := p_Dl_OffsetToPointA,
    OffsetCarrierCORESET0   := p_OffsetCarrierCORESET0,
    Coreset0_OffsetRBs      := p_Coreset0_OffsetRBs,
    MFBI_Band               := omit
  };

  template (value) NR_CellSysInfo_Type cs_NR_CellSysInfoDef(NR_SysinfoCombination_Type           p_NR_SysinfoCombination,
                                                            template (omit) BCCH_BCH_Message      p_MIB := omit,
                                                            template (omit) BCCH_DL_SCH_Message   p_SIB1 := omit,
                                                            template (omit) NR_SI_List_Type       p_SIs := omit,
                                                            template (omit) NR_SegmentedSI_List_Type p_SegmentedSIs := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    BcchInfo  := cs_NR_BcchInfo(p_MIB, p_SIB1, p_SIs, p_SegmentedSIs),
    NR_SysinfoCombination := p_NR_SysinfoCombination,
    NtnInfo := cs_NTNCellType

  };

  template (value) NR_BcchInfo_Type cs_NR_BcchInfo(template (omit) BCCH_BCH_Message p_MIB := omit,
                                                   template (omit) BCCH_DL_SCH_Message p_SIB1 := omit,
                                                   template (omit) NR_SI_List_Type p_SIs := omit,
                                                   template (omit) NR_SegmentedSI_List_Type p_SegmentedSIs := omit,
                                                   template (omit) NR_PosSI_List_Type p_PosSIs := omit
                                                   ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    MIB  := p_MIB,
    SIB1 := p_SIB1,
    SIs  := p_SIs,
    SegmentedSIs := p_SegmentedSIs,
    PosSIs := p_PosSIs,            //@sic R5w220107 sic@
    NCD_MIBs := omit               //@sic R5w230309 sic@
  };

  template (value) NTN_CellInfo_Type cs_NTNCellType (NTN_CellInfo_Type.NtnCellType p_NtnCellType := 1) :=
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  {NtnCellType := p_NtnCellType};

  template (value) NR_SharedSpectrum_ChannelAccessMode_Config_Type cs_SharedSpectrumConfig_SemiStatic (SemiStaticChannelAccessConfig_r16.period_r16 p_Period := ms5) :=
  {/* @sic R5w24202r1 sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    SemiStatic := {
      R16 := {
        period_r16 := p_Period
      }
    }
  };

  template (value) NR_SharedSpectrum_ChannelAccessMode_Config_Type cs_SharedSpectrumConfig_Dynamic :=
  {/* @sic R5w24202r1 sic@ */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Dynamic := true
  };

  /*
   * @desc      Common initialisation of the NR_PTC
   * @param     p_NR_Configuration
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4 (default value: cs_NR_Frequencyf1tof4_Dummy)
   * @param     p_SecondaryFreqBandIndicatorNR (default value: 1)
   * @param     p_NR_SysinfoCombination
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Init(NR_Configuration_Type p_NR_Configuration,
                     template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                     FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                     template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4 := cs_NR_Frequencyf1tof4_Dummy, //Dummy value for configuration with no secondary band
                     FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR  := 1,    //Dummy value for configuration with no secondary band
                     NR_SysinfoCombination_Type p_NR_SysinfoCombination)
    runs on NR_BASE_PTC
  {
    fl_NR_Common_Init(p_NR_Configuration, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination);
    //Add frequency list in SIB4 after the cellArray is initialised
    if (not (f_GetTestcaseAttrib_ENDC(testcasename()))) { //@sic R5-191193 sic@
      f_NR_InitSysinfoFrequencyList(p_NR_SysinfoCombination);
    }
  }

  /*
   * @desc      Set test environment depending on the bands under test
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_SecondaryFreqBandIndicatorNR (default value: omit)
   * @param     p_ThirdFreqBandIndicatorNR (default value: omit)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitTestEnvironmnent( FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                                      template (omit) FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR := omit,
                                      template (omit) FreqBandIndicatorNR  p_ThirdFreqBandIndicatorNR := omit
                                     ) runs on NR_BASE_PTC
  {
      if (isvalue(p_SecondaryFreqBandIndicatorNR) and isvalue(p_ThirdFreqBandIndicatorNR)) {
        // test case using 3 bands
        if ( f_NR_IsBandFR1(p_PrimaryFreqBandIndicatorNR) and f_NR_IsBandFR1(valueof(p_SecondaryFreqBandIndicatorNR)) and f_NR_IsBandFR1(valueof(p_ThirdFreqBandIndicatorNR))) {
            vc_NR_Global.MobileInfo.NR_TestEnvironment := Conducted;
        } else {
            vc_NR_Global.MobileInfo.NR_TestEnvironment := OTA;
        }
    } else if (isvalue(p_SecondaryFreqBandIndicatorNR)) {
            // test case using 2 bands
            if ( f_NR_IsBandFR1(p_PrimaryFreqBandIndicatorNR) and f_NR_IsBandFR1(valueof(p_SecondaryFreqBandIndicatorNR))) {
                vc_NR_Global.MobileInfo.NR_TestEnvironment := Conducted;
            } else {
                vc_NR_Global.MobileInfo.NR_TestEnvironment := OTA;
            }
    } else { // test using 1 band
        if ( f_NR_IsBandFR1(p_PrimaryFreqBandIndicatorNR)) {
            vc_NR_Global.MobileInfo.NR_TestEnvironment := Conducted;
        } else {
           vc_NR_Global.MobileInfo.NR_TestEnvironment := OTA;
        }
    }
  }

  /*
   * @desc      Common initialisation of the NR_PTC
   * @param     p_NR_Configuration
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4
   * @param     p_SecondaryFreqBandIndicatorNR
   * @param     p_NR_SysinfoCombination
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_Common_Init(NR_Configuration_Type p_NR_Configuration,
                              template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                              FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                              template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4,
                              FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR,
                              NR_SysinfoCombination_Type p_NR_SysinfoCombination)
   runs on NR_BASE_PTC
   {
    // Initialise Ctrl
    vc_NR_Global.Ctrl.Default := null;
    vc_NR_Global.Ctrl.TestBody := false;
    vc_NR_Global.Ctrl.VerdictCtrl := normal;
    vc_NR_Global.Ctrl.HarqErrorHandling := ignore;

    // Initialise security parameters
    vc_NR_Global.Security := f_NR_Security_Init();

    //Initialise MobileInfo
    vc_NR_Global.MobileInfo := f_NR_MobileInfo_Init(p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR);

    //Initialise CellArray
    vc_NR_Global.CellArray := f_NR_CellArray_Init(p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, vc_NR_Global.MobileInfo.NR_DeltaValues.DeltaPrimaryBand, vc_NR_Global.MobileInfo.NR_DeltaValues.DeltaSecondaryBand);

    vc_NR_Global.NR_Config := p_NR_Configuration;
  }

  /*
   * @desc      Initialise NR Mobile info to omit
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4
   * @param     p_SecondaryFreqBandIndicatorNR
   * @return    NR_MobileInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_MobileInfo_Init(template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                                FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                                template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4,
                                FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR
                                ) runs on NR_BASE_PTC return NR_MobileInfo_Type
  {
    var NR_MobileInfo_Type v_MobileInfo := f_NR_GetMobileInfo();  //Retrieve MobileInfo fields already initialised @sic R5s220759 sic@
    v_MobileInfo.NR_Capability := omit;
    v_MobileInfo.MRDC_Capability := omit;
    v_MobileInfo.NTN_SatelliteType := ntn_None;

    //@sic R5w190312: ASP for delta values sic@
    v_MobileInfo.NR_DeltaValues := f_NR_RetrieveDeltaValues(p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR);

    if (f_NR_IsBandNTN(p_PrimaryFreqBandIndicatorNR)) { //@sic R5-242320 sic@
        if (px_NTN_ScenarioUnderTest == GSO){
            v_MobileInfo.NTN_SatelliteType := ntn_GSO;
        }
        else{//@sic R5-243597 sic@
            v_MobileInfo.NTN_SatelliteType := ntn_NGSO;
        }
    }
    return v_MobileInfo;
  }

  /*
   * @desc      Retrieve delta values from SS
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4
   * @param     p_SecondaryFreqBandIndicatorNR
   * @return    UE_NR_DeltaValues_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_RetrieveDeltaValues(template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                                    FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                                    template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4,
                                    FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR
                                    ) runs on NR_BASE_PTC return UE_NR_DeltaValues_Type
  { //@sic R5w190312: ASP for delta values sic@
    var template (value) Band_SsbInfo_Type v_Band_SsbInfoPrimary := fl_GetNR_Band_SsbForDelta(p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR);
    var template (value) Band_SsbInfo_Type v_Band_SsbInfoSecondary := fl_GetNR_Band_SsbForDelta(p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR);
    var NR_SYSTEM_CTRL_CNF  v_ReceivedAsp;

    SYS.send(cas_NR_DeltaValuesTrigger_REQ(v_Band_SsbInfoPrimary, v_Band_SsbInfoSecondary));
    SYS.receive(car_NR_DeltaValuesTrigger_CNF) -> value v_ReceivedAsp;

    return v_ReceivedAsp.Confirm.DeltaValues;
  }

  /*
   * @desc      Retrieve NR_Band_SsbForDelta_Type per band - to be used for delta value intialisation
   * @param     p_NR_Frequencyf1tof4
   * @param     p_FreqBandIndicatorNR
   * @return    template (omit) Band_SsbInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_GetNR_Band_SsbForDelta(template (value) NR_Frequencyf1tof4_Type p_NR_Frequencyf1tof4,
                                    FreqBandIndicatorNR  p_FreqBandIndicatorNR
                                    ) return template (value) Band_SsbInfo_Type
  { var template (value) Band_SsbInfo_Type v_Band_SsbInfo;   //@sic R5s240385 sic@

    if ( not(f_NR_IsBandSUL(p_FreqBandIndicatorNR))) {
        v_Band_SsbInfo := cs_Band_SsbInfo( p_FreqBandIndicatorNR,
                                           fl_GetNR_ASN1_ARFCN_ValueNR(p_NR_Frequencyf1tof4.FrequencyInfoDL_f1),
                                           fl_GetNR_ASN1_ARFCN_ValueNR(p_NR_Frequencyf1tof4.FrequencyInfoDL_f2),
                                           fl_GetNR_ASN1_ARFCN_ValueNR(p_NR_Frequencyf1tof4.FrequencyInfoDL_f3),
                                           fl_GetNR_ASN1_ARFCN_ValueNR(p_NR_Frequencyf1tof4.FrequencyInfoDL_f4)
                                          );
    } else { //@sic R5s240385 sic@
       v_Band_SsbInfo := cs_Band_SsbInfo( p_FreqBandIndicatorNR);
    }
    return v_Band_SsbInfo;
  }

  /*
   * @desc      Returns the content of the IE absoluteFrequencySSB whithin NR FrequencyInfoDL element
   * @param     p_NR_SS_FrequencyInfoDL
   * @return    template (omit) NR_ASN1_ARFCN_ValueNR_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_GetNR_ASN1_ARFCN_ValueNR (template (omit) NR_SS_FrequencyInfoDL_Type p_NR_SS_FrequencyInfoDL ) return template (omit) NR_ASN1_ARFCN_ValueNR_Type
  {
    var template (omit) NR_ASN1_ARFCN_ValueNR_Type v_NR_ASN1_ARFCN := omit;

    if (isvalue(p_NR_SS_FrequencyInfoDL.FrequencyInfoDL.absoluteFrequencySSB)){
        v_NR_ASN1_ARFCN := cs_NR_ASN1_ARFCN_ValueNR(valueof(p_NR_SS_FrequencyInfoDL.FrequencyInfoDL.absoluteFrequencySSB));
    }
    return v_NR_ASN1_ARFCN;
  }

  /*
   * @desc      Initialise all NR cell info
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4
   * @param     p_SecondaryFreqBandIndicatorNR
   * @param     p_NR_SysinfoCombination
   * @param     p_PrimaryDeltaValues
   * @param     p_SecondaryDeltaValues
   * @return    NR_CellInfoList_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellArray_Init(template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                               FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                               template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4,
                               FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR,
                               NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                               DeltaValues_Type p_PrimaryDeltaValues,
                               DeltaValues_Type p_SecondaryDeltaValues
                               ) runs on NR_BASE_PTC
    return NR_CellInfoList_Type
  { //@sic R5s190109 sic@
    var NR_CellInfoList_Type v_NR_CellArray;
    var integer v_Index;

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell1);
    v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell1, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell2);
    v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell2, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell4);
    v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell4, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell11);
    v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell11, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

    if (ispresent(p_NR_PrimaryFrequencyf1tof4.FrequencyInfoDL_f2)){
        v_Index := f_NR_CellInfo_GetIndex(nr_Cell3);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell3, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

        v_Index := f_NR_CellInfo_GetIndex(nr_Cell12);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell12, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

        v_Index := f_NR_CellInfo_GetIndex(nr_Cell23);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell23, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);
    }
    if (ispresent(p_NR_PrimaryFrequencyf1tof4.FrequencyInfoDL_f3)){
        v_Index := f_NR_CellInfo_GetIndex(nr_Cell6);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell6, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);

        v_Index := f_NR_CellInfo_GetIndex(nr_Cell13);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell13, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);
    }
    if (ispresent(p_NR_PrimaryFrequencyf1tof4.FrequencyInfoDL_f4)){
        v_Index := f_NR_CellInfo_GetIndex(nr_Cell14);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell14, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_PrimaryDeltaValues);
    }

    //@sic R5-190669 sic@
    if ( not f_NR_IsBandSUL(p_SecondaryFreqBandIndicatorNR)) { // For NR SUL there is no need to initialise cells on the secondary SUL band as there is no DL frequency
        v_Index := f_NR_CellInfo_GetIndex(nr_Cell10);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell10, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_SecondaryDeltaValues);

        v_Index := f_NR_CellInfo_GetIndex(nr_Cell30);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell30, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_SecondaryDeltaValues);

        v_Index := f_NR_CellInfo_GetIndex(nr_Cell31);
        v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell31, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_SecondaryDeltaValues);

        if (ispresent(p_NR_SecondaryFrequencyf1tof4.FrequencyInfoDL_f2)){
            v_Index := f_NR_CellInfo_GetIndex(nr_Cell28);
            v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell28, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_SecondaryDeltaValues);

            v_Index := f_NR_CellInfo_GetIndex(nr_Cell29);
            v_NR_CellArray[v_Index] := f_NR_CellInfo_Init(nr_Cell29, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination, p_SecondaryDeltaValues);
        }
    }
    return v_NR_CellArray;
  }

  /*
   * @desc      Initialise cell info for one cell
   * @param     p_NR_CellId
   * @param     p_NR_Frequencyf1tof4
   * @param     p_BandIndicatorNR
   * @param     p_NR_SysinfoCombination
   * @param     p_DeltaValues
   * @return    NR_CellInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_Init(NR_CellId_Type                p_NR_CellId,
                              template (value) NR_Frequencyf1tof4_Type p_NR_Frequencyf1tof4,
                              FreqBandIndicatorNR           p_BandIndicatorNR,
                              NR_SysinfoCombination_Type    p_NR_SysinfoCombination,
                              DeltaValues_Type              p_DeltaValues ) runs on NR_BASE_PTC
    return NR_CellInfo_Type
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo;
    var template (value) NR_NAS_Parameters_Type v_NAS_Parameters := fl_NR_InitNAS_forRRC_Cells(p_NR_CellId);
    var NR_CellIdentities_Type  v_NR_CellIdentities := fl_NR_InitCellIdentities(p_NR_CellId);
    var PhysCellId v_PhysCellId := v_NR_CellIdentities.PhysicalCellId;
    var NR_FrequencyBand_Type v_NR_FrequencyBand := fl_NR_InitCellFrequency(p_NR_CellId, p_NR_Frequencyf1tof4, p_BandIndicatorNR);
    var SubcarrierSpacing v_SSB_SubcarrierSpacing := v_NR_FrequencyBand.SSB_SubcarrierSpacing;
    var SubcarrierSpacing v_Carrier_SubcarrierSpacing := v_NR_FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList[0].subcarrierSpacing;
    var template (value) NR_DuplexMode_Type v_NR_DuplexMode := f_NR_InitDuplexMode(p_BandIndicatorNR, v_SSB_SubcarrierSpacing);
    var CellTimingInfo_Type v_CellTimingInfo := f_NR_InitCellTiming(p_NR_CellId, p_BandIndicatorNR);
    var SSB_Index v_SSB_Index := fl_NR_InitSSB_Index(p_NR_CellId);
    var template (value) NR_DownlinkBWP_List_Type v_DL_BWPs := f_NR_InitDL_BWPs(v_PhysCellId, v_NR_FrequencyBand, v_SSB_Index);
    var template (value) NR_CellSysInfo_Type v_NR_CellSysInfo;
    var NR_Prach_RootSequenceIndex_Type v_Prach_RootSequenceIndex := f_NR_InitPrach_RootSequenceIndex(p_NR_CellId);
    var template (omit) NR_UplinkBWP_List_Type v_UL_BWPs;
    var NR_AbsoluteCellPower_Type v_MaxReferencePower;
    var template (value) NR_SSB_BurstConfig_Type v_SSB_Burstconfig := f_NR_ConvertSSB_PositionsInBurst(v_SSB_Index, p_BandIndicatorNR, v_SSB_SubcarrierSpacing);
    var boolean v_IsFR1 := f_NR_IsBandFR1(v_NR_FrequencyBand.FrequencyBandIndicator);
    var template (value) NR_ServingCellConfig_Type v_NR_ServingCellConfig := f_NR_ServingCellConfig_Init(v_IsFR1);
    var template (value) SSB_MTC v_SSB_MTC := f_NR_InitSSB_MTC(p_BandIndicatorNR);
    var integer v_DeltaNRFs := fl_NR_InitCellDeltaValue(p_NR_CellId, p_DeltaValues);
    var PRB_Id v_PRB_SecondHopPRBId;
    var template (value) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type v_RadioLinkMonitoringConfig := cs_38508_RadioLinkMonitoringConfigDef(v_SSB_Index); //@sic R5-212409 sic@
    var NR_TestEnvironment_Type v_NR_TestEnvironment := f_NR_MobileInfo_GetTestEnvironment(); //@sic R5s220477 sic@
    var NTN_Satellite_Type v_SatelliteType := f_NR_MobileInfo_GetNTNSatelliteType(); //@sic R5-242320 sic@
    var template (omit) NR_NTN_TimingAdvanceConfig_Type v_NtnTA := omit; //@sic R5-242320 sic@

    //Initialise Maximum power reference as per 38.508-1 clause 6.2.2
    if (v_NR_TestEnvironment == Conducted) {    //@sic R5s220477 sic@
      v_MaxReferencePower := tsc_NR_ServingCellSSS_EPRE_FR1;
    } else {
      v_MaxReferencePower := tsc_NR_ServingCellSSS_EPRE_FR2;
    }
    if (not fl_IsUL_FrequencyAvailable(v_NR_FrequencyBand)) { //SDL or no UL @sic R5-226041 sic@
        v_UL_BWPs := omit;
    } else {
        //Acc to 38.508-1 Table 4.6.3-109: PRB-Id
        //Set to value of the number of RBs - 1 where number of RBs is found in Table 4.3.1.0D-1 or Table 4.3.1.0D-2 for the bandwidth and SCS configured
        v_PRB_SecondHopPRBId := v_NR_FrequencyBand.FrequencyInfoUL.scs_SpecificCarrierList[0].carrierBandwidth;  //@sic R5-203287 sic@
        v_UL_BWPs := f_NR_InitUL_BWPs(v_Carrier_SubcarrierSpacing, p_BandIndicatorNR, v_Prach_RootSequenceIndex, v_SSB_Index, v_NR_FrequencyBand.ChannelBandwidth, v_PRB_SecondHopPRBId, v_SatelliteType);
    }
    //Initialise NTN TA if needed
    if(f_NR_IsBandNTN(p_BandIndicatorNR)){//Apply only for NTN cell
      if (v_SatelliteType == ntn_GSO)
      {//@sic R5-242320 sic@
        v_NtnTA := cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_GSO_Cell1);
      }
      else if (v_SatelliteType == ntn_NGSO)
      {//@sic R5-243597 sic@
        v_NtnTA := cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_NGSO_Cell1);
      }
    }

    v_NR_CellSysInfo := f_NR_InitSystemInformation(p_NR_SysinfoCombination,
                                                   v_NR_FrequencyBand,
                                                   v_Carrier_SubcarrierSpacing,
                                                   v_NAS_Parameters,
                                                   v_DL_BWPs,
                                                   v_UL_BWPs,
                                                   v_DeltaNRFs,
                                                   v_SSB_Index,
                                                   p_NR_CellId);
    v_NR_CellInfo := cs_NR_CellInfoDef(v_NR_CellIdentities,
                                       v_NR_FrequencyBand,
                                       v_NR_CellSysInfo,
                                       v_CellTimingInfo,
                                       v_NR_DuplexMode,
                                       v_Carrier_SubcarrierSpacing,
                                       v_SSB_Burstconfig,
                                       v_DL_BWPs,
                                       v_UL_BWPs,
                                       omit,                   //@sic R5s180640 change 1.4.2 sic@
                                       v_MaxReferencePower,
                                       v_NAS_Parameters,
                                       v_NR_ServingCellConfig,
                                       v_SSB_MTC,
                                       v_NR_FrequencyBand.OffsetCarrierCORESET0,
                                       v_RadioLinkMonitoringConfig,   //@sic R5-212409 sic@
                                       v_NtnTA,    //@sic R5-242320 sic@
                                       v_NR_FrequencyBand.ChannelBandwidth  //@sic R5-250309 sic@
                                       );
    return valueof(v_NR_CellInfo);
  }

  /*
   * @desc      Initialise the SSB_Index of a cell as per 38.508-1 Table 4.4.2-2: Default NR parameters for simulated NR cells
   * @param     p_NR_CellId
   * @return    SSB_Index
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_InitSSB_Index (NR_CellId_Type p_NR_CellId) return SSB_Index
  {
    var SSB_Index v_SSB_Index := tsc_NR_SSB_Index1;

    select (p_NR_CellId) {
        case(nr_Cell1, nr_Cell3, nr_Cell4, nr_Cell6, nr_Cell10, nr_Cell14, nr_Cell23, nr_Cell28, nr_Cell31) {
            v_SSB_Index := tsc_NR_SSB_Index1;
        }
        case(nr_Cell2, nr_Cell11, nr_Cell12, nr_Cell13, nr_Cell29, nr_Cell30){
            v_SSB_Index := tsc_NR_SSB_Index0;
        }
    }
    return v_SSB_Index;
  }

  /*
   * @desc      Initialise the physical cell identity to 38.508-1 Table 4.4.2-2: PhysCellId
   * @param     p_NR_CellId
   * @return    NR_CellIdentities_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitCellIdentities(NR_CellId_Type p_NR_CellId) return NR_CellIdentities_Type
  {
    var NR_CellIdentities_Type v_NR_CellIdentities;
    // As per 38.508-1 Table 4.4.2-2: Default NR parameters for simulated NR cells
    //@sic R5-237422 sic@
    select (p_NR_CellId) {
      case(nr_Cell1) {
        v_NR_CellIdentities.PhysicalCellId := 42;
      }
      case(nr_Cell2) {
        v_NR_CellIdentities.PhysicalCellId := 50;
      }
      case(nr_Cell3) {
        v_NR_CellIdentities.PhysicalCellId := 58;
      }
      case(nr_Cell4) {
        v_NR_CellIdentities.PhysicalCellId := 46;
      }
      case(nr_Cell6) {
        v_NR_CellIdentities.PhysicalCellId := 18;
      }
      case(nr_Cell10) {
        v_NR_CellIdentities.PhysicalCellId := 10;
      }
      case(nr_Cell11) {
        v_NR_CellIdentities.PhysicalCellId := 54;
      }
      case(nr_Cell12) {
        v_NR_CellIdentities.PhysicalCellId := 62;
      }
      case(nr_Cell13) {
        v_NR_CellIdentities.PhysicalCellId := 22;
      }
      case(nr_Cell14) {
        v_NR_CellIdentities.PhysicalCellId := 14;
      }
      case(nr_Cell23) {
        v_NR_CellIdentities.PhysicalCellId := 66;
      }
      case(nr_Cell28) {
        v_NR_CellIdentities.PhysicalCellId := 46;
      }
      case(nr_Cell29) {
        v_NR_CellIdentities.PhysicalCellId := 34;
      }
      case(nr_Cell30) {
        v_NR_CellIdentities.PhysicalCellId := 26;
      }
      case(nr_Cell31) {
        v_NR_CellIdentities.PhysicalCellId := 38;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid NR CellId");
      }
    }
    return v_NR_CellIdentities;
  }

  /*
   * @desc      Initialise tRoot sequence index value of the cell acc to 38.508-1 Table 4.4.2-2: Default NR parameters for simulated NR cells
   * @param     p_NR_CellId
   * @return    NR_Prach_RootSequenceIndex_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitPrach_RootSequenceIndex(NR_CellId_Type  p_NR_CellId) return NR_Prach_RootSequenceIndex_Type
  {
    var NR_Prach_RootSequenceIndex_Type v_Prach_RootSequenceIndex;
    // As per 38.508-1 Table 4.4.2-2: Default NR parameters for simulated NR cells
    // Note: no difference between FDD/TDD values
    select (p_NR_CellId) {
      case(nr_Cell1) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell2) {
        v_Prach_RootSequenceIndex := {l139 := 32};
      }
      case(nr_Cell3) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell4) {
        v_Prach_RootSequenceIndex := {l139 := 64};
      }
      case(nr_Cell6) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell10) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell11) {
        v_Prach_RootSequenceIndex := {l139 := 96};
      }
      case(nr_Cell12) {
        v_Prach_RootSequenceIndex := {l139 := 32};
      }
      case(nr_Cell13) {
        v_Prach_RootSequenceIndex := {l139 := 32};
      }
      case(nr_Cell14) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell23) {
        v_Prach_RootSequenceIndex := {l139 := 64};
      }
      case(nr_Cell28) {
        v_Prach_RootSequenceIndex := {l139 := 0};
      }
      case(nr_Cell29) {
        v_Prach_RootSequenceIndex := {l139 := 32};
      }
      case(nr_Cell30) {
        v_Prach_RootSequenceIndex := {l139 := 32};
      }
      case(nr_Cell31) {
        v_Prach_RootSequenceIndex := {l139 := 64};
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid NR CellId");
      }
    }
    return v_Prach_RootSequenceIndex;
  }

  /*
   * @desc      Initialise cell timing info acc to 36.523-3 Table 7.1.5.2-1
   * @param     p_NR_CellId
   * @param     p_FreqBandIndicatorNR
   * @return    CellTimingInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitCellTiming(NR_CellId_Type  p_NR_CellId,
                               FreqBandIndicatorNR p_FreqBandIndicatorNR
                              ) return CellTimingInfo_Type
  { //@sic R5-198992: added p_BandIndicatorNR to handle FDD/TDD sic@
    var CellTimingInfo_Type v_CellTimingInfo;

    v_CellTimingInfo.HsfnOffset:= 0;
    v_CellTimingInfo.Tcell := 0;
    v_CellTimingInfo.TcOffset := 0;

    select (p_NR_CellId) {
        case(nr_Cell1) {
            v_CellTimingInfo.SfnOffset := 0;
        }
        case(nr_Cell2) {
            v_CellTimingInfo.SfnOffset := 124;
        }
        case(nr_Cell3){
            v_CellTimingInfo.SfnOffset := 257;
        }
        case(nr_Cell4){
            v_CellTimingInfo.SfnOffset := 1000;
        }
        case(nr_Cell6){
            v_CellTimingInfo.SfnOffset := 656;
        }
        case(nr_Cell10){
            v_CellTimingInfo.SfnOffset := 129;
        }
        case(nr_Cell11){
            v_CellTimingInfo.SfnOffset := 956;
        }
        case(nr_Cell12){
            v_CellTimingInfo.SfnOffset := 1015;
        }
        case(nr_Cell13){
            v_CellTimingInfo.SfnOffset := 890;
        }
        case(nr_Cell14){
            v_CellTimingInfo.SfnOffset := 680;
        }
        case(nr_Cell23){
            v_CellTimingInfo.SfnOffset := 383;
        }
        case(nr_Cell28){
            v_CellTimingInfo.SfnOffset := 890;
        }
        case(nr_Cell29){
            v_CellTimingInfo.SfnOffset := 680;
        }
        case(nr_Cell30){
            v_CellTimingInfo.SfnOffset := 1015;
        }
        case(nr_Cell31){
            v_CellTimingInfo.SfnOffset := 53;
        }
    }
    if (not(f_NR_IsBandFDD( p_FreqBandIndicatorNR))){    //TDD @sic R5-198992 sic@
        select (p_NR_CellId) {
            case(nr_Cell1, nr_Cell2, nr_Cell4, nr_Cell11) {
                v_CellTimingInfo.SfnOffset := 0;
            }
            case(nr_Cell3, nr_Cell12, nr_Cell23){
                v_CellTimingInfo.SfnOffset := 257;
            }
            case(nr_Cell6, nr_Cell13){
                v_CellTimingInfo.SfnOffset := 656;
            }
            case(nr_Cell10, nr_Cell30, nr_Cell31){
                v_CellTimingInfo.SfnOffset := 129;
            }
            case(nr_Cell14){
                v_CellTimingInfo.SfnOffset := 680;
            }
            case(nr_Cell28, nr_Cell29){
                v_CellTimingInfo.SfnOffset := 890;
            }
        }
    }
    return v_CellTimingInfo;
  }

  /*
   * @desc      Initialise FDD/TDD info from the band under test
   * @param     p_FreqBandIndicatorNR
   * @param     p_SubcarrierSpacing
   * @return    template (value) NR_DuplexMode_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitDuplexMode(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                               SubcarrierSpacing   p_SubcarrierSpacing)
    return template (value) NR_DuplexMode_Type
  {
    var template (value) NR_DuplexMode_Type v_DuplexMode;
    var template (value) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon;
    var template (omit) NR_SharedSpectrum_ChannelAccessMode_Config_Type v_SharedSpectrumConfig := omit; /* @sic R5w24202r1 sic@ */

    //FDD/TDD specified in 38.101-1 Table 5.2-1 & 38.101-2 Table 5.2-1
    if (f_NR_IsBandFDD( p_FreqBandIndicatorNR)){
      v_DuplexMode := cs_NR_DuplexModeFDD(pc_halfDuplexFDD_TypeA_RedCap_r17); //@sic R5-233406 sic@
    } else  {
      v_TDD_UL_DL_ConfigCommon := fl_NR_InitTDD_UL_DL_ConfigCommonForTDD(p_FreqBandIndicatorNR, p_SubcarrierSpacing);
      if(f_NR_IsBandSharedSpectrum(p_FreqBandIndicatorNR)){ /* @sic R5w24202r1 sic@ */
        if(pc_ul_Semi_StaticChAccess_r16) {
          v_SharedSpectrumConfig := cs_SharedSpectrumConfig_SemiStatic;
        }
        else if (pc_ul_DynamicChAccess_r16){
          v_SharedSpectrumConfig := cs_SharedSpectrumConfig_Dynamic;
        }
        else {
          FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
        }
      }
      v_DuplexMode := cs_NR_DuplexModeTDD(v_TDD_UL_DL_ConfigCommon, v_SharedSpectrumConfig); /* @sic R5w24202r1 sic@ */
    }
    return v_DuplexMode;
  }

  /*
   * @desc      Initialise TDD_UL_DL_ConfigCommon - Returns OMIT for FDD only
   * @param     p_FreqBandIndicatorNR
   * @param     p_SubcarrierSpacing
   * @return    template (omit) TDD_UL_DL_ConfigCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitTDD_UL_DL_ConfigCommon(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                            SubcarrierSpacing p_SubcarrierSpacing) return template (omit) TDD_UL_DL_ConfigCommon
  {
    var template (omit) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon := omit;  //FDD

    //TDD specified in 38.101-1 Table 5.2-1 & 38.101-2 Table 5.2-1
    if (not f_NR_IsBandFDD( p_FreqBandIndicatorNR)) { //TDD
      v_TDD_UL_DL_ConfigCommon := fl_NR_InitTDD_UL_DL_ConfigCommonForTDD(p_FreqBandIndicatorNR, p_SubcarrierSpacing);
    }
    return v_TDD_UL_DL_ConfigCommon;
  }

  /*
   * @desc      Initialise TDD_UL_DL_ConfigCommon for TDD
   * @param     p_FreqBandIndicatorNR
   * @param     p_SubcarrierSpacing
   * @return    template (value) TDD_UL_DL_ConfigCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitTDD_UL_DL_ConfigCommonForTDD(FreqBandIndicatorNR p_FreqBandIndicatorNR,
                                                  SubcarrierSpacing p_SubcarrierSpacing) return template (value) TDD_UL_DL_ConfigCommon
  {
    var template (value) TDD_UL_DL_Pattern v_TDD_UL_DL_Pattern;

    //TDD specified in 38.101-1 Table 5.2-1 & 38.101-2 Table 5.2-1
    if (f_NR_IsBandFR1(p_FreqBandIndicatorNR)) { //FR1 TDD
      if (p_SubcarrierSpacing == kHz15) {
        v_TDD_UL_DL_Pattern := cs_38508_TDD_UL_DL_Pattern1_FR1_SCS15;
      } else {
        v_TDD_UL_DL_Pattern := cs_38508_TDD_UL_DL_Pattern1_FR1_SCS30;
      }
    } else { //FR2 TDD
      v_TDD_UL_DL_Pattern := cs_38508_TDD_UL_DL_Pattern1_FR2;
    }
    return cs_38508_TDD_UL_DL_ConfigCommon1(p_SubcarrierSpacing, v_TDD_UL_DL_Pattern);
  }

  /*
   * @desc      DL BWPs
   * @param     p_PhysCellId
   * @param     p_NR_FrequencyBand
   * @param     p_SSB_Index
   * @return    template (value) NR_DownlinkBWP_List_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitDL_BWPs(PhysCellId p_PhysCellId,
                            NR_FrequencyBand_Type p_NR_FrequencyBand,
                            SSB_Index p_SSB_Index
                            )
    return template (value) NR_DownlinkBWP_List_Type
  { /* @sic R5-190786: p_PhysCellId sic@ */
    var template (value) NR_DownlinkBWP_List_Type v_DL_BWPs;
    var template (value) DMRS_DownlinkConfig v_DMRS_DownlinkConfig;
    var template (value) NR_SearchSpace_NrofCandidates_Type v_NrofCandidates := f_NR_Get_SearchSpace_NrofCandidates(p_NR_FrequencyBand.FrequencyBandIndicator, p_NR_FrequencyBand.ChannelBandwidth); //@sic R5-201655 RP-201138 R5-250401 sic@
    var template (value) PDSCH_TimeDomainResourceAllocationList v_PDSCH_TimeDomainResourceAllocationList;
    var template (omit) PDSCH_Config.mcs_Table v_Mcs_Table := omit;  // @sic R5-190670: qam64 per default independent from FR1/FR2 sic@
    var BWP.locationAndBandwidth v_LocationAndBandwidth := f_NR_InitLocationAndBandwidth(p_NR_FrequencyBand.FrequencyBandIndicator, p_NR_FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList[0].subcarrierSpacing, p_NR_FrequencyBand.ChannelBandwidth);  //Same SCS used for all channels)  @sic R5s210242 sic@
    var template (value) SearchSpace.monitoringSlotPeriodicityAndOffset v_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS;    //@sic R5-233406 sic@
    var template (omit)  SearchSpace.duration v_Duration := omit;     //@sic R5-233406 sic@
    var B45_Type v_Coreset0_FrequencyDomain := tsc_Coreset0_FrequencyDomain; //@sic R5w240005 sic@ - Default value (licensed spectrum)
    var integer v_Coreset0Duration := tsc_Coreset_Duration; //@sic R5w240005 sic@ - Default value (licensed spectrum)
    var template (omit) integer v_Coreset0_PuncturingSize := omit;
    var B45_Type v_Coreset1_FrequencyDomain := f_NR_GetCoreset1_FrequencyDoomain(p_NR_FrequencyBand.ChannelBandwidth); //@sic R5-250401 sic@

    if (f_NR_IsBandFR1(p_NR_FrequencyBand.FrequencyBandIndicator)) { //FR1
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR1;
      v_PDSCH_TimeDomainResourceAllocationList := cs_38508_PDSCH_TimeDomainResourceAllocationList_FR1;
    } else {                                        //FR2
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR2;
      v_PDSCH_TimeDomainResourceAllocationList := cs_38508_PDSCH_TimeDomainResourceAllocationList_FR2;
    }
    if (f_NR_IsBandFDD(p_NR_FrequencyBand.FrequencyBandIndicator) and pc_halfDuplexFDD_TypeA_RedCap_r17) {
        v_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS_HDUE;
        v_Duration := 4;
    }
    //@sic R5-240531, R5w240005 sic@ - SharedSpectrum, configure CORESET#0 acc. TS 38.508-1. clause 6.2.3
    if (f_NR_IsBandSharedSpectrum(p_NR_FrequencyBand.FrequencyBandIndicator)) {
      v_Coreset0_FrequencyDomain := tsc_Coreset0_FrequencyDomain_SharedSpectrum; // 48 RBs acc. 38.213, Table 13-4A
      v_Coreset0Duration := tsc_Coreset0_Duration_SharedSpectrum; // 1 symbol acc. 38.213, Table 13-4A
    }
    if (p_NR_FrequencyBand.FrequencyBandIndicator == 106) { //Acc to 38.211 clause 7.3.2.2
      //@sic R5w250011 sic@
      v_Coreset0_PuncturingSize := 9; //CORESET#0 punctured by 9 RBs -> 15RBs
    }
    v_DL_BWPs := cs_NR_DownlinkBWP_List_Def(p_NR_FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList[0].subcarrierSpacing, //@sic R5s210242 sic@
                                            p_PhysCellId,
                                            v_LocationAndBandwidth,
                                            v_DMRS_DownlinkConfig,
                                            v_NrofCandidates,
                                            v_PDSCH_TimeDomainResourceAllocationList,
                                            v_Mcs_Table,
                                            p_NR_FrequencyBand.Coreset0_OffsetRBs,
                                            p_SSB_Index,
                                            v_SlotPeriodicityAndOffset,
                                            v_Duration,
                                            v_Coreset0_FrequencyDomain, //@sic R5-240531, R5w240005 sic@- SharedSpectrum
                                            v_Coreset0Duration, //@sic R5-240531, R5w240005 sic@ - SharedSpectrum
                                            v_Coreset0_PuncturingSize,
                                            v_Coreset1_FrequencyDomain);
    return v_DL_BWPs;
  }

  /*
   * @desc      return FrequencyDomainResources as acc to 38.508-1 Table 4.6.3-28: ControlResourceSet
   * @param     p_ChannelBandwidth
   * @return    B45_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function  f_NR_GetCoreset1_FrequencyDoomain(integer p_ChannelBandwidth) return B45_Type
   { //@sic R5-250401 sic@
    if (p_ChannelBandwidth == 3) {
      return tsc_Coreset1_FrequencyDomain_CBW3;
    } else {
      return tsc_Coreset1_FrequencyDomain;
    }
   }

  /*
   * @desc      Initialise LocationAndBandwidth value as per 38.508-1 clause 4.3.1.0D
   * @param     p_FrequencyBandIndicator
   * @param     p_SubcarrierSpacing
   * @param     p_ChannelBandwidth
   * @return    BWP.locationAndBandwidth
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitLocationAndBandwidth(FreqBandIndicatorNR  p_FrequencyBandIndicator,
                                         SubcarrierSpacing    p_SubcarrierSpacing,
                                         integer              p_ChannelBandwidth)
    return BWP.locationAndBandwidth
  {
    var BWP.locationAndBandwidth v_LocationAndBandwidth := 0;

    if (f_NR_IsBandFR1(p_FrequencyBandIndicator)) {
      //Table 4.3.1.0D-1: locatinAndBandwidth in BWP for FR1
      select (p_ChannelBandwidth) {
        case (5) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 6600; }
            case (kHz30) { v_LocationAndBandwidth := 2750; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(10) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 14025; }
            case (kHz30) { v_LocationAndBandwidth := 6325; }
            case (kHz60) { v_LocationAndBandwidth := 2750; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(15) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 21450; }
            case (kHz30) { v_LocationAndBandwidth := 10175; }
            case (kHz60) { v_LocationAndBandwidth := 4675; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(20) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 28875; }
            case (kHz30) { v_LocationAndBandwidth := 13750; }
            case (kHz60) { v_LocationAndBandwidth := 6325; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(25) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 36300; }
            case (kHz30) { v_LocationAndBandwidth := 17600; }
            case (kHz60) { v_LocationAndBandwidth := 8250; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(30) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 32174; }
            case (kHz30) { v_LocationAndBandwidth := 21175; }
            case (kHz60) { v_LocationAndBandwidth := 10175; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(35) {  //@sic R5-227087 sic@
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 24474; }
            case (kHz30) { v_LocationAndBandwidth := 25025; }
            case (kHz60) { v_LocationAndBandwidth := 11825; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(40) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 16774; }
            case (kHz30) { v_LocationAndBandwidth := 28875; }
            case (kHz60) { v_LocationAndBandwidth := 13750; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(45) { //@sic R5-222503 sic@
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 9624; }
            case (kHz30) { v_LocationAndBandwidth := 32450; }
            case (kHz60) { v_LocationAndBandwidth := 15675; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(50) {
          select (p_SubcarrierSpacing){
            case (kHz15) { v_LocationAndBandwidth := 1924; }
            case (kHz30) { v_LocationAndBandwidth := 36300; }
            case (kHz60) { v_LocationAndBandwidth := 17600; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(60) {
          select (p_SubcarrierSpacing){
            case (kHz30) { v_LocationAndBandwidth := 31624; }
            case (kHz60) { v_LocationAndBandwidth := 21450; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(70) { //@sic R5s220224 sic@
          select (p_SubcarrierSpacing){
            case (kHz30) { v_LocationAndBandwidth := 24199; }
            case (kHz60) { v_LocationAndBandwidth := 25300; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(80) {
          select (p_SubcarrierSpacing){
            case (kHz30) { v_LocationAndBandwidth := 16499; }
            case (kHz60) { v_LocationAndBandwidth := 29150; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(90) { //@sic R5s220224 sic@
          select (p_SubcarrierSpacing){
            case (kHz30) { v_LocationAndBandwidth := 8799; }
            case (kHz60) { v_LocationAndBandwidth := 33000; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case(100) {
          select (p_SubcarrierSpacing){
            case (kHz30) { v_LocationAndBandwidth := 1099; }
            case (kHz60) { v_LocationAndBandwidth := 36850; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case else { FatalError(__FILE__, __LINE__, "Invalid Channel Bandwidth"); }
      }
    } else {
      // FR2 acc to 38.508-1 Table 4.3.1.0D-2: locationAndBandwidth in BWP for FR2
      select (p_ChannelBandwidth) {
        case (50) {
          select (p_SubcarrierSpacing){
            case (kHz60) { v_LocationAndBandwidth := 17875; }
            case (kHz120) { v_LocationAndBandwidth := 8525; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case (100) {
          select (p_SubcarrierSpacing){
            case (kHz60) { v_LocationAndBandwidth := 36025; }
            case (kHz120) { v_LocationAndBandwidth := 17875; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case (200) {
          select (p_SubcarrierSpacing){
            case (kHz60) { v_LocationAndBandwidth := 3574; }
            case (kHz120) { v_LocationAndBandwidth := 36025; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case (400) {
          select (p_SubcarrierSpacing){
            case (kHz120) { v_LocationAndBandwidth := 3574; }
            case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
          }
        }
        case else { FatalError(__FILE__, __LINE__, "Invalid Channel Bandwidth"); }
      }
    }
    return v_LocationAndBandwidth;
  }

  /*
   * @desc      UL BWPs
   * @param     p_SubcarrierSpacing
   * @param     p_FrequencyBandIndicator
   * @param     p_Prach_RootSequenceIndex
   * @param     p_SSB_Index
   * @param     p_ChannelBandwidth
   * @param     p_PRB_SecondHopPRBId
   * @param     p_SatelliteType     (default value: ntn_None)
   * @return    template (value) NR_UplinkBWP_List_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitUL_BWPs(SubcarrierSpacing p_SubcarrierSpacing,
                            FreqBandIndicatorNR p_FrequencyBandIndicator,
                            NR_Prach_RootSequenceIndex_Type p_Prach_RootSequenceIndex,
                            SSB_Index p_SSB_Index,
                            integer p_ChannelBandwidth,
                            PRB_Id p_PRB_SecondHopPRBId,
                            NTN_Satellite_Type p_SatelliteType := ntn_None
                            ) return template (value) NR_UplinkBWP_List_Type
  {
    //@sic R5-202820: added p_PRB_SecondHopPRBId R5s250100 R5-253086: added p_SatelliteType sic@
    var template (value) NR_UplinkBWP_List_Type v_UL_BWPs;
    var NR_DMRS_UL_AdditionalPosition_Type v_DMRS_UL_AdditionalPosition;
    var PUSCH_TimeDomainResourceAllocation.k2 v_K2forMsg3;
    var template (value) PUSCH_TimeDomainResourceAllocationList v_PUSCH_TimeDomainResourceAllocationList;
    var template (value) PUSCH_Config v_PUSCH_Config;
    var template (omit) BWP_UplinkDedicated.srs_Config  v_SRS_Config := omit;  //@sic R5s200057 sic@
    var BWP.locationAndBandwidth v_LocationAndBandwidth:= f_NR_InitLocationAndBandwidth(p_FrequencyBandIndicator, p_SubcarrierSpacing, p_ChannelBandwidth); //@sic R5s190134 change 4.3 sic@
    var RACH_ConfigCommon.ssb_perRACH_OccasionAndCB_PreamblesPerSSB v_SSB_perRACH_Occasion;
    var template (value) RACH_ConfigGeneric v_RACH_ConfigGeneric;
    var integer v_C_SRS := 0;   //@sic R5-198860 sic@
    var RACH_ConfigGeneric.ra_ResponseWindow v_RA_ResponseWindow := sl20; //@sic R5-199423 sic@
    var template (omit) PUCCH_Config.dl_DataToUL_ACK v_DL_DataToUL_ACK := cs_38508_DL_DataToUL_ACK; //@sic As per 38.508-1 Table 4.6.3-112: PUCCH-Config R5-214381 sic@
    var template (omit) BWP_UplinkDedicated.lbt_FailureRecoveryConfig_r16 v_LBT_FailureRecoveryConfig_r16 := omit;
    var template (omit) PUCCH_Config.ul_AccessConfigListDCI_1_1_r16 v_Ul_AccessConfigListDCI_1_1_r16 := omit; //@sic R5-245544 sic@
    var template (omit) PUSCH_Config.ul_AccessConfigListDCI_0_1_r16 v_Ul_AccessConfigListDCI_0_1_r16 := omit; //@sic R5-245544 sic@

    //@sic R5-240531, R5w240005, R5-245544 sic@ - SharedSpectrum conditions
    if (f_NR_IsBandSharedSpectrum(p_FrequencyBandIndicator)) {
      v_LBT_FailureRecoveryConfig_r16 := cs_38508_LBT_FailureRecoveryConfigSetup; //in Table 4.6.3-15: BWP-UplinkDedicated
      v_Ul_AccessConfigListDCI_1_1_r16 := cs_38508_Ul_AccessConfigListDCI_1_1; //in Table 4.6.3-112: PUCCH-Config
      v_Ul_AccessConfigListDCI_0_1_r16 := cs_38508_Ul_AccessConfigListDCI_0_1; //in Table 4.6.3-118: PUSCH-Config
    }
    if (f_NR_IsBandFR1(p_FrequencyBandIndicator)) {
      // FR1
      select (p_SubcarrierSpacing) {   /* @sic R5-190723 sic@ */
        case (kHz15) {v_K2forMsg3 := 2;}
        case (kHz30) {v_K2forMsg3 := 6;}
      }
      v_DMRS_UL_AdditionalPosition := pos1;
      v_SSB_perRACH_Occasion := { one := n8 }; //Table 4.6.3-128: RACH-ConfigCommon

      //Set ra-ResponseWindow as per 38.508-1 Table 4.6.3-130: RACH-ConfigGeneric
      if ( p_SubcarrierSpacing == kHz15) { v_RA_ResponseWindow := sl10; }
      v_RACH_ConfigGeneric := cs_38508_RACH_ConfigGeneric_FR1(v_RA_ResponseWindow);

      if (f_NR_IsBandFDD(p_FrequencyBandIndicator) and pc_halfDuplexFDD_TypeA_RedCap_r17) { //@sic R5-233406 sic@
        v_RACH_ConfigGeneric := cs_38508_RACH_ConfigGeneric_FR1_HDUE(v_RA_ResponseWindow);
      }
      if (not (f_GetTestcaseAttrib_ShortDCI(testcasename()))) { //@sic R5s190892 R5s190895 sic@
        //set c-SRS acc to Table 4.6.3-182: SRS-Config
        if ( p_ChannelBandwidth == 100 ) { v_C_SRS := 63; }   //@sic R5-198860 sic@
        v_SRS_Config := cs_NR_Srs_Config_Setup(cs_38508_SRS_Config_FR1(v_C_SRS, p_SSB_Index));
        v_PUSCH_Config := cs_38508_PUSCH_Config_FR1(cs_38508_DMRS_UplinkConfig(v_DMRS_UL_AdditionalPosition), p_SSB_Index, v_Ul_AccessConfigListDCI_0_1_r16); //@sic R5-245544 sic@
      } else { //TC using Short_DCI x_0
        v_PUSCH_Config := cs_38508_PUSCH_Config_ShortDCI_FR1(cs_38508_DMRS_UplinkConfig(v_DMRS_UL_AdditionalPosition), p_SSB_Index);
      }
    } else {
      // FR2
      v_K2forMsg3 := 3;   /* @sic R5-190723 sic@ */
      v_DMRS_UL_AdditionalPosition := pos0;
      v_SSB_perRACH_Occasion := { one := n4 };  //Table 4.6.3-128: RACH-ConfigCommon @sic R5-187672 sic@
      v_RACH_ConfigGeneric := cs_38508_RACH_ConfigGeneric_FR2;
      if (not (f_GetTestcaseAttrib_ShortDCI(testcasename()))) { //@sic R5s190892 R5s190895 sic@
        //set c-SRS acc to Table 4.6.3-182: SRS-Config
        if ( p_ChannelBandwidth == 100 ) { v_C_SRS := 17; }  //@sic R5-198860 sic@
        v_SRS_Config := cs_NR_Srs_Config_Setup(cs_38508_SRS_Config_FR2(v_C_SRS, p_SSB_Index));
        v_PUSCH_Config := cs_38508_PUSCH_Config_FR2(cs_38508_DMRS_UplinkConfig(v_DMRS_UL_AdditionalPosition), p_SSB_Index);
      } else { //TC using Short_DCI x_0
        v_PUSCH_Config := cs_38508_PUSCH_Config_ShortDCI_FR2(cs_38508_DMRS_UplinkConfig(v_DMRS_UL_AdditionalPosition), p_SSB_Index);
      }
    }
    if (f_GetTestcaseAttrib_ShortDCI(testcasename())){
        //  As per 38.508-1 Table 4.6.3-112: PUCCH-Config condition Short_DCI
        v_DL_DataToUL_ACK := omit;
    }
    v_PUSCH_TimeDomainResourceAllocationList := cs_38508_PUSCH_TimeDomainResourceAllocationList(v_K2forMsg3);   /* @sic R5-190723 sic@ */
    v_UL_BWPs := {
        cs_NR_UplinkBWP_Initial(
          p_SubcarrierSpacing,
          v_LocationAndBandwidth,
          p_Prach_RootSequenceIndex,
          v_SSB_perRACH_Occasion,
          v_RACH_ConfigGeneric,
          v_PUSCH_TimeDomainResourceAllocationList,
          v_PUSCH_Config,
          v_SRS_Config,
          p_SSB_Index,
          p_PRB_SecondHopPRBId,
          v_DL_DataToUL_ACK,
          v_LBT_FailureRecoveryConfig_r16,
          v_Ul_AccessConfigListDCI_1_1_r16,
          p_SatelliteType)    /* @sic R5s190852 change 2: v_SRS_Config, R5-245544 sic@ */
    };

    return v_UL_BWPs;
  }

  /*
   * @desc      Initialise SSB position in Burst Acc to 38.508-1 Table 4.6.3-168: ServingCellConfigCommon and Table 4.6.3-187: SSB-ToMeasure
   * @param     p_SSB_Index
   * @param     p_FrequencyBandIndicator
   * @param     p_SCS
   * @return    template (value) NR_SSB_BurstConfig_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertSSB_PositionsInBurst( SSB_Index            p_SSB_Index,
                                             FreqBandIndicatorNR  p_FrequencyBandIndicator,
                                             SubcarrierSpacing    p_SCS
                                             ) return template (value) NR_SSB_BurstConfig_Type
  { //@sic R5-204398: added p_SCS sic@
    var NR_SS_BlockPattern_Type v_SS_BlockPattern := fl_NR_GetBlockPatternTC(p_FrequencyBandIndicator);
    var ServingCellConfigCommon.ssb_PositionsInBurst v_Ssb_PositionsInBurst;
    var bitstring v_SSB_Bitstring := f_NR_InitSSB(p_SSB_Index, p_FrequencyBandIndicator, p_SCS);

    //Value of SSB position in burst acc to 38.508-1 Table 4.6.3-168: ServingCellConfigCommon and Table 4.6.3-187: SSB-ToMeasure
    select (lengthof(v_SSB_Bitstring)) {
      case(4) { v_Ssb_PositionsInBurst := {shortBitmap := v_SSB_Bitstring} }
      case(8) { v_Ssb_PositionsInBurst := {mediumBitmap := v_SSB_Bitstring} }
      case(64) { v_Ssb_PositionsInBurst := {longBitmap := v_SSB_Bitstring} }
      case else {FatalError(__FILE__, __LINE__, "Invalid SSB bitstring length");}
    }
    return cs_NR_SSB_BurstConfig(v_SS_BlockPattern, v_Ssb_PositionsInBurst);
  }

  /*
   * @desc      Return block pattern depending on TC type
   * @param     p_FrequencyBandIndicator
   * @return    NR_SS_BlockPattern_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_GetBlockPatternTC ( FreqBandIndicatorNR  p_FrequencyBandIndicator) return NR_SS_BlockPattern_Type
  { //@sic R5s211581 sic@
    if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) {
        return f_NR_GetBlockPattern(p_FrequencyBandIndicator);
    } else {
        return f_NR_GetBlockPattern_GetHighestCarrierBandwidth(p_FrequencyBandIndicator);
    }
  }

  /*
   * @desc      Initialise the frequency NRf1/NRf2/NRf3/NRf4 of the cell
   * @param     p_NR_CellId
   * @param     p_NR_Frequencyf1Tof4
   * @param     p_NR_Band
   * @return    NR_FrequencyBand_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitCellFrequency(NR_CellId_Type p_NR_CellId,
                                   template (value) NR_Frequencyf1tof4_Type p_NR_Frequencyf1Tof4,
                                   FreqBandIndicatorNR p_NR_Band)
    return NR_FrequencyBand_Type
  { // @sic R5-187745 sic@
    var template (value) NR_FrequencyBand_Type v_NR_FrequencyBand := cs_NR_FrequencyBand(p_NR_Band);

    select (p_NR_CellId) {
      case(nr_Cell1, nr_Cell2, nr_Cell4, nr_Cell11, nr_Cell10, nr_Cell30, nr_Cell31) { //NRf1 or equivalent NRf5 on secondary band
        v_NR_FrequencyBand := fl_NR_SetFrequency(v_NR_FrequencyBand, p_NR_Frequencyf1Tof4.FrequencyInfoDL_f1, p_NR_Frequencyf1Tof4.FrequencyInfoUL_f1);
      }
      case(nr_Cell3, nr_Cell12, nr_Cell23, nr_Cell28, nr_Cell29){ //NRf2 or equivalent NRf6 on secondary band
        v_NR_FrequencyBand := fl_NR_SetFrequency(v_NR_FrequencyBand, p_NR_Frequencyf1Tof4.FrequencyInfoDL_f2, p_NR_Frequencyf1Tof4.FrequencyInfoUL_f2);
      }
      case(nr_Cell6, nr_Cell13) { //NRf3
        v_NR_FrequencyBand := fl_NR_SetFrequency(v_NR_FrequencyBand, p_NR_Frequencyf1Tof4.FrequencyInfoDL_f3, p_NR_Frequencyf1Tof4.FrequencyInfoUL_f3);
      }
      case(nr_Cell14){ //NRf4
        v_NR_FrequencyBand := fl_NR_SetFrequency(v_NR_FrequencyBand, p_NR_Frequencyf1Tof4.FrequencyInfoDL_f4, p_NR_Frequencyf1Tof4.FrequencyInfoUL_f4);
      }
      case else { FatalError(__FILE__, __LINE__, "Invalid NR CellId"); }
    }

    return valueof(v_NR_FrequencyBand);
  }

  /*
   * @desc      Set all parameters for a given frequency
   * @param     p_NR_FrequencyBand
   * @param     p_NR_FrequencyDL
   * @param     p_NR_FrequencyUL
   * @return    template (value) NR_FrequencyBand_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_SetFrequency(template (value) NR_FrequencyBand_Type p_NR_FrequencyBand,
                              template (omit) NR_SS_FrequencyInfoDL_Type p_NR_FrequencyDL,
                              template (omit) NR_SS_FrequencyInfoUL_Type p_NR_FrequencyUL)
    return template (value) NR_FrequencyBand_Type
  {
    var template (value) NR_FrequencyBand_Type v_NR_FrequencyBand := p_NR_FrequencyBand;
    //DL
    if (isvalue(p_NR_FrequencyDL)) {
      v_NR_FrequencyBand.FrequencyInfoDL := p_NR_FrequencyDL.FrequencyInfoDL;
      v_NR_FrequencyBand.Ssb_SubcarrierOffset := p_NR_FrequencyDL.Ssb_SubcarrierOffset;
      v_NR_FrequencyBand.Coreset0_Index := p_NR_FrequencyDL.Coreset0_Index;
      v_NR_FrequencyBand.Dl_OffsetToPointA := p_NR_FrequencyDL.OffsetToPointA;
      v_NR_FrequencyBand.OffsetCarrierCORESET0 := p_NR_FrequencyDL.OffsetCarrierCORESET0;
      v_NR_FrequencyBand.Coreset0_OffsetRBs := p_NR_FrequencyDL.Coreset0_OffsetRBs;
      v_NR_FrequencyBand.SSB_SubcarrierSpacing := p_NR_FrequencyDL.SSB_SubcarrierSpacing;
    }
    //UL
    if (isvalue(p_NR_FrequencyUL)) {
      v_NR_FrequencyBand.FrequencyInfoUL := p_NR_FrequencyUL.FrequencyInfoUL;
    }
    //So far it is assumed that the same channel Bandwidth is used in DL and UL
    if (isvalue(p_NR_FrequencyDL)) {
      v_NR_FrequencyBand.ChannelBandwidth := p_NR_FrequencyDL.DL_ChannelBandwith;
    } else {
      v_NR_FrequencyBand.ChannelBandwidth := p_NR_FrequencyUL.UL_ChannelBandwith;
    }

    return v_NR_FrequencyBand;
  }

  /*
   * @desc      Initialise Delta(NRfs): delta value of the cell depending of NRf1/NRf2/NRf3/NRf4 of the cell
   * @param     p_NR_CellId
   * @param     p_DeltaValues
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitCellDeltaValue(NR_CellId_Type p_NR_CellId,
                                    DeltaValues_Type p_DeltaValues
                                    )
  return integer
  {
    var integer v_DeltaValue := 0;

    select (p_NR_CellId) {
      case(nr_Cell1, nr_Cell2, nr_Cell4, nr_Cell11, nr_Cell10, nr_Cell30, nr_Cell31) { //NRf1 or equivalent NRf5 on secondary band
        v_DeltaValue := p_DeltaValues.DeltaNRf1;
      }
      case(nr_Cell3, nr_Cell12, nr_Cell23, nr_Cell28, nr_Cell29){ //NRf2 or equivalent NRf6 on secondary band
        v_DeltaValue := p_DeltaValues.DeltaNRf2;
      }
      case(nr_Cell6, nr_Cell13) { //NRf3
        v_DeltaValue := p_DeltaValues.DeltaNRf3;
      }
      case(nr_Cell14){ //NRf4
        v_DeltaValue := p_DeltaValues.DeltaNRf4;
      }
      case else { FatalError(__FILE__, __LINE__, "Invalid NR CellId"); }
    }
    return v_DeltaValue;
  }

  /*
   * @desc      Initialise ServingCellConfig
   * @param     p_IsBandFR1
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ServingCellConfig_Init(boolean p_IsBandFR1) return template (value) NR_ServingCellConfig_Type
  { //@sic R5-255209 : added p_IsBandFR1 sic@
    var template (value) NR_ServingCellConfig_Type v_ServingCellConfig;
    var CellGroupId v_CellGroupId := tsc_NR_CellGroupId_MCG;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig := cs_38508_MAC_CellGroupConfig;  //@sic R5s190446 sic@
    var template (omit) P_Max v_P_Max := f_NR_InitP_Max(p_IsBandFR1);  //@sic R5-190784 sic@
    var template (value) PhysicalCellGroupConfig v_PhysicalCellGroupConfig:= cs_38508_PhysicalCellGroupConfig(v_P_Max); //@sic R5-190784 sic@
    var integer v_ServCellIndex := f_NR_ServCellIndex();   //@sic R5-192274 sic@

    if (f_GetTestcaseAttrib_ENDC(testcasename())) {
      v_CellGroupId := tsc_NR_CellGroupId_SCG;

      if (f_NR_TestcaseIsL2Testcase()) { //@sic R5s210315 sic@
        // Common test specific parameters for L2 as per 38.523-1 Table 7.1.0-1
        //For NR5GC layer test cases, these parameters are set after the NR5GC preamble when briging UE to RRC_CONNECTED state
        v_MAC_CellGroupConfig.bsr_Config := cs_NR_BSR_Config_L2;
        v_MAC_CellGroupConfig.phr_Config := { release := NULL };
      }
    }

    v_ServingCellConfig := cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfig(v_ServCellIndex,
                                                                                v_CellGroupId,
                                                                                v_MAC_CellGroupConfig,
                                                                                v_PhysicalCellGroupConfig));
    return v_ServingCellConfig;
  }

  /*
   * @desc      check whether given testcase name fits L2 test case
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_TestcaseIsL2Testcase() return boolean
  {
    var charstring v_TestcaseName := testcasename();
    var template charstring v_L2TestcasePattern := pattern "TC_7_1_[1-9]_*"; //@sic R5s210013 sic@
    return match(v_TestcaseName, v_L2TestcasePattern);
  }

  /*
   * @desc      Initialise NAS parameters for NR cells as per 38.508-1 Table 4.4.2-2 and Table 4.4.2-3
   *            Note: GUTI parameters are initialised in f_NR5GC_Init->f_NR_RRC_InitGuti
   * @param     p_NR_CellId
   * @return    template (value) NR_NAS_Parameters_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitNAS_forRRC_Cells(NR_CellId_Type   p_NR_CellId) return template (value) NR_NAS_Parameters_Type
  {
    var template (value) NR_NAS_Parameters_Type v_NAS_Param;

    v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_Def;
    v_NAS_Param.Ranac := 1;   //Table 4.6.3-135: RAN-AreaCode
    v_NAS_Param.TrackingAreaCode := int2bit(1,24);

    select (p_NR_CellId) {
      //CellIdentity as per 38.508-1 Table 4.4.2-2: Default NR parameters for simulated NR cells
      //Table 4.4.2-3: Default NAS parameters for simulated NR cells
      //@sic R5-187674 R5-187660 sic@
      case (nr_Cell1) {
        v_NAS_Param.CellIdentity := '00000000000000000000000001'B & '0000000000'B;
      }
      case(nr_Cell2) {
        v_NAS_Param.CellIdentity := '00000000000000000000000001'B & '0000000010'B;
      }
      case(nr_Cell3) {
        v_NAS_Param.CellIdentity := '00000000000000000000000010'B & '0000000011'B;
      }
      case(nr_Cell4) {
        v_NAS_Param.CellIdentity := '00000000000000000000000011'B & '0000000100'B;
      }
      case(nr_Cell6) {
        v_NAS_Param.CellIdentity := '00000000000000000000000100'B & '0000000110'B;
      }
      case(nr_Cell10) {
        v_NAS_Param.CellIdentity := '00000000000000000000000101'B & '0000001010'B;
      }
      case(nr_Cell11) {
        v_NAS_Param.TrackingAreaCode := int2bit(2,24);
        v_NAS_Param.CellIdentity := '00000000000000000000000110'B & '0000001011'B;
      }
      case(nr_Cell12) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_002_11;
        v_NAS_Param.CellIdentity := '00000000000000000000000010'B & '0000001100'B;
      }
      case(nr_Cell13) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_003_21;
        v_NAS_Param.CellIdentity := '00000000000000000000000100'B & '0000001101'B;
      }
      case(nr_Cell14) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_004_31;
        v_NAS_Param.CellIdentity := '00000000000000000000000111'B & '0000001110'B;
      }
      case(nr_Cell23) {
        v_NAS_Param.TrackingAreaCode := int2bit(2,24);
        v_NAS_Param.CellIdentity := '00000000000000000000000110'B & '0000010111'B;
      }
      case(nr_Cell28) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_002_11;
        v_NAS_Param.CellIdentity := '00000000000000000000000010'B & '0000011100'B;
      }
      case(nr_Cell29) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_003_21;
        v_NAS_Param.CellIdentity := '00000000000000000000000100'B & '0000011101'B;
      }
      case(nr_Cell30) {
        v_NAS_Param.PLMN_Identity := tsc_NR_HPLMN_004_31;
        v_NAS_Param.CellIdentity := '00000000000000000000000111'B & '0000011110'B;
      }
      case(nr_Cell31) {
        v_NAS_Param.TrackingAreaCode := int2bit(2,24);
        v_NAS_Param.CellIdentity := '00000000000000000000000110'B & '0000011111'B;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid NR CellId");
      }
    }
    return v_NAS_Param;
  }

  /*
   * @desc      function initialising the default sysinfo as per 38.508-1
   * @param     p_NR_SysinfoCombination
   * @param     p_NR_FrequencyBand
   * @param     p_SubcarrierSpacing
   * @param     p_NAS_Parameters
   * @param     p_DL_BWPs
   * @param     p_UL_BWPs
   * @param     p_DeltaNRFs
   * @param     p_SSB_Index
   * @param     p_NR_CellId
   * @return    template (value) NR_CellSysInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitSystemInformation(NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                                      NR_FrequencyBand_Type      p_NR_FrequencyBand,
                                      SubcarrierSpacing          p_SubcarrierSpacing,
                                      template (value) NR_NAS_Parameters_Type    p_NAS_Parameters,
                                      template (value) NR_DownlinkBWP_List_Type  p_DL_BWPs,
                                      template (omit) NR_UplinkBWP_List_Type    p_UL_BWPs,
                                      integer                                    p_DeltaNRFs,
                                      SSB_Index                                  p_SSB_Index,
                                      NR_CellId_Type                             p_NR_CellId
                                      )
    runs on NR_BASE_PTC return template (value) NR_CellSysInfo_Type
  { //@sic R5-201148 sic@
    var template (value) NR_CellSysInfo_Type v_NR_CellSysInfo;
    var MIB.subCarrierSpacingCommon v_SubCarrierSpacingCommon := f_NR_ConvertSCS_To_SubCarrierSpacingCommon(p_SubcarrierSpacing);
    var integer v_Ssb_SubcarrierOffset_4LSB := p_NR_FrequencyBand.Ssb_SubcarrierOffset mod 16;     // Retrieve the 4 LSB of k_ssb
    var template (value) BCCH_BCH_Message     v_MIB;
    var template (omit)  BCCH_DL_SCH_Message  v_SIB1 := omit;
    var template (value) SIB2  v_SIB2;
    var template (value) SIB3  v_SIB3;
    var template (value) SIB4  v_SIB4;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI1 := omit;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI2 := omit;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI3 := omit;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI4 := omit;
    var template (omit)  NR_SI_List_Type  v_SI_List := omit;
    var NR_SysinfoCombination_Type v_NR_SysinfoCombination := p_NR_SysinfoCombination;
    var NID_r16 v_NID_r16 := f_NR_InitNDI(p_NR_CellId);

    if (not fl_IsUL_FrequencyAvailable(p_NR_FrequencyBand)) { //In SDL cells or SCell with no UL only NR MIB is broadcasted @sic R5-202573 R5-226041 sic@
        v_NR_SysinfoCombination := MibOnly;
    }

    v_MIB := cs_38508_MIB_Def(v_SubCarrierSpacingCommon, v_Ssb_SubcarrierOffset_4LSB, p_NR_FrequencyBand.Coreset0_Index);
    if (v_NR_SysinfoCombination != MibOnly) {
        v_SIB1 := fl_NR_InitSIB1(v_NR_SysinfoCombination, p_NR_FrequencyBand, p_SubcarrierSpacing, p_NAS_Parameters, p_DL_BWPs, p_UL_BWPs, p_DeltaNRFs, p_SSB_Index, p_NR_CellId);
        v_SIB2 := fl_NR_InitSIB2(p_NR_FrequencyBand.FrequencyBandIndicator, p_SubcarrierSpacing);  //@sic R5-196981 sic@
    }
    select(v_NR_SysinfoCombination) {
      case(MibOnly) {
      }
      case(NR_1){
      }
      case(NR_2){ // SIB2
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SI_List := {v_BCCH_SI1}; //@sic R5s190354 sic@
      }
      case(NR_3) { // SIB2 & SIB3
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB3 := cs_38508_SIB3_Def;
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB3(v_SIB3)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_4) { //SIB2 & SIB4
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_5){ // SIB2 & SIB3 & SIB4
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB3 := cs_38508_SIB3_Def;
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB3(v_SIB3)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_6) { // SIB2 & SIB5
        //@sic R5-195326 sic@
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB5(cs_38508_SIB5_Def(omit)))); //Initialise with empty frequency list - Will get initialised after coordination with EUTRA PTC
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_7) { // SIB2 & SIB4 & SIB5
        //@sic R5-195326 sic@
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4_SIB5(v_SIB4, cs_38508_SIB5_Def(omit)))); //Initialise with empty frequency list - Will get initialised after coordination with EUTRA PTC
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2}; //@sic R5s190354 sic@
      }
      case(NR_8, NR_9, NR_10, NR_11) {
        //Sysinfo combination for ETWS/CMAS
        // Test cases using NR_8 or NR_9 or NR_10 or NR_11 shall be initialised with NR_1 in the preamble
        FatalError(__FILE__, __LINE__, "Invalid sysinfo combination NR_8 or NR_9 or NR_10 or NR_11 shall be started inside the test case");
      }
      case(NR_12) {
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB10(cs_38508_SIB10_Def)));
        v_SI_List := {v_BCCH_SI1};   //@sic R5s220753 sic@
      }
      case(NR_14) { // SIB2 & SIB4 & SIB12
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB12(cs_38508_SIB12_Def(0, lastSegment, '00'O)))); //Initialise SIB12 as dummy - will be updated in the NR5GC V2X common function
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3}; //@sic R5s190354 sic@
      }
      case(NR_15, NR_16, NR_17) { //@sic R5-223387 sic@
        //Sysinfo combination for PosSIB
        // Test cases using NR_15 or NR_16 or NR_17 shall be initialised with NR_1 in the preamble
        FatalError(__FILE__, __LINE__, "Invalid sysinfo combination NR_15 or NR_16 or NR_17 shall be started inside the test case");
      }
      case(NR_18) { //@sic R5-223399 sic@
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB11(cs_38508_SIB11_Def))); //Initialise SIB11 as empty
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_19) {
        //Sysinfo combination for Extended field in SI scenario
        // Test cases using NR_19 shall be initialised with NR_1 in the preamble
        // Sysinfo combination updated inside the test case
        // @sic R5-223417 sic@
        FatalError(__FILE__, __LINE__, "Invalid sysinfo combination NR_19 shall be started inside the test case");
      }
      case(NR_20) { //SIB2 + SIB20
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB20(cs_38508_SIB20)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_21) {  //SIB2 + SIB21
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB21(cs_38508_SIB21)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_22) { //SIB2 + SIB20 + SIB21
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB20(cs_38508_SIB20)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB21(cs_38508_SIB21)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_23) { //SIB2 + SIB4 + SIB20
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB20(cs_38508_SIB20)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_24) {//SIB2 + SIB4 + SIB21
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB21(cs_38508_SIB21)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_25) {//SIB2 + SIB4 + SIB20 + SIB21
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB20(cs_38508_SIB20)));
        v_BCCH_SI4 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB21(cs_38508_SIB21)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3, v_BCCH_SI4};
      }
      case(NR_26) {
        //SI1: SIB10+SIB18
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB10_SIB18(cs_38508_SIB10_Def, cs_38508_SIB18_Def(p_NAS_Parameters.PLMN_Identity, v_NID_r16))));
        v_SI_List := {v_BCCH_SI1};
      }
      case(NR_27) {
        //SI1: SIB2
        //SI2: SIB10+SIB18
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB10_SIB18(cs_38508_SIB10_Def, cs_38508_SIB18_Def(p_NAS_Parameters.PLMN_Identity, v_NID_r16))));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      //case (NR_28) @sic R5-253084 sic@
      case(NR_29){ //@sic R5-232436 sic@
        //SIB1 with cellBarredNTN-r17 = notBarred
        v_SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellBarredNTN_r17 := notBarred;
        //SI1: SIB2
        //SI2: SIB19
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB19(f_NR_InitSIB19())));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2}
      }
      case(NR_30) { //@sic R5-233379 sic@
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB16(cs_38508_SIB16_Def))); //NSAG-Id initialised with a dummy value -> to be updated after the initialisation function
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_32) { //@sic R5-243555 sic@
        //SIB1 with cellBarredNTN-r17 = notBarred
        v_SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellBarredNTN_r17 := notBarred;
        //SI1: SIB2
        //SI2: SIB4
        //SI3: SIB19
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        v_BCCH_SI3 :=  cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB19(f_NR_InitSIB19())));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case(NR_34){ //@sic R5-254023 sic@
        //SIB1 with condition ATG in Table 4.6.1-28: cellBarredATG-r18 = notBarred
        v_SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellBarredATG_r18 := notBarred;
        //SI1: SIB2
        //SI2: SIB22
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB22(cs_38508_SIB22_Def)));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2}
      }
      case(NR_35) { //@sic R5-254943 sic@
        //SIB1 with cellBarredNTN-r17 = notBarred
        v_SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellBarredNTN_r17 := notBarred;
        //SI1: SIB2
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        //SI2: SIB4
        v_SIB4 := fl_NR_InitSIB4(p_NR_FrequencyBand, p_SubcarrierSpacing); //Initialise SIB4 with an empty frequencyList as per 38.508-1
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB4(v_SIB4)));
        //SI3: SIB19
        v_BCCH_SI3 :=  cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB19(f_NR_InitSIB19())));
        //SI4: SIB25
        // ReferenceLocation set by default to RefLocation_1 (tsc_38508_ReferenceLocation_1) => to be updated later for the neighbouring cells
        v_BCCH_SI4 :=  cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB25(cs_38508_SIB25_Def({cs_38508_CoverageAreaInfo_r18}))));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3, v_BCCH_SI4};
      }
      case(NR_36) { // SIB2 & SIB23 & SIB12
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2_SIB23(v_SIB2, cs_38508_SIB23_Def(''O))));  //Initialise SIB23 with an empty content
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB12(cs_38508_SIB12_Def(0, lastSegment, '00'O)))); //Initialise SIB12 as dummy - will be updated in the NR5GC V2X common function
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2};
      }
      case(NR_40) { //@sic R5-261589 sic@
        //SIB1 with cellBarredNTN-r17 = notBarred
        v_SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellBarredNTN_r17 := notBarred;
        //SI1: SIB2
        //SI2: SIB3
        //SI3: SIB19
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB2(v_SIB2)));
        v_SIB3 := cs_38508_SIB3_Def;
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB3(v_SIB3)));
        v_BCCH_SI3 :=  cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB19(f_NR_InitSIB19())));
        v_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid Sysinfo combination");
      }
    }
    v_NR_CellSysInfo := cs_NR_CellSysInfoDef(p_NR_SysinfoCombination, v_MIB, v_SIB1, v_SI_List);
    return v_NR_CellSysInfo;
  }

  /*
   * @desc      function converting SCS (tye SubcarrierSpacing) to MIB.subCarrierSpacingCommon
   * @param     p_SubcarrierSpacing
   * @return    MIB.subCarrierSpacingCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertSCS_To_SubCarrierSpacingCommon ( SubcarrierSpacing p_SubcarrierSpacing) return MIB.subCarrierSpacingCommon
  { //@sic R5-236413 sic@
    var MIB.subCarrierSpacingCommon v_SubCarrierSpacingCommon := scs15or60;
    select(p_SubcarrierSpacing) {
      case(kHz15, kHz60)  { v_SubCarrierSpacingCommon := scs15or60; }
      case(kHz30, kHz120) { v_SubCarrierSpacingCommon := scs30or120; }
      case else { FatalError(__FILE__, __LINE__, "Invalid NR CellId"); }
    }
    return v_SubCarrierSpacingCommon;
  }

  /*
   * @desc      function initialising SIB1 as per 38.508-1 Table 4.6.1-28: SIB1
   * @param     p_NR_SysinfoCombination
   * @param     p_NR_FrequencyBand
   * @param     p_SubcarrierSpacing
   * @param     p_NAS_Parameters
   * @param     p_DL_BWPs
   * @param     p_UL_BWPs
   * @param     p_DeltaNRFs
   * @param     p_SSB_Index
   * @param     p_NR_CellId
   * @return    template (value) BCCH_DL_SCH_Message
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitSIB1(NR_SysinfoCombination_Type                 p_NR_SysinfoCombination,
                          NR_FrequencyBand_Type                      p_NR_FrequencyBand,
                          SubcarrierSpacing                          p_SubcarrierSpacing,
                          template (value) NR_NAS_Parameters_Type    p_NAS_Parameters,
                          template (omit) NR_DownlinkBWP_List_Type   p_DL_BWPs,
                          template (omit) NR_UplinkBWP_List_Type     p_UL_BWPs,
                          integer                                    p_DeltaNRFs,
                          SSB_Index                                  p_SSB_Index,
                          NR_CellId_Type                             p_NR_CellId
                          ) runs on NR_BASE_PTC return template (value) BCCH_DL_SCH_Message
  { //@sic R5-187745 sic@
    var template (value) BCCH_DL_SCH_Message v_SIB1;
    var template (omit) SI_SchedulingInfo v_SI_SchedulingInfo := fl_NR_InitSI_SchedulingInfo(p_NR_SysinfoCombination, p_NR_FrequencyBand.FrequencyBandIndicator);
    var template (omit) SI_SchedulingInfo_v1700 v_SI_SchedulingInfo_v1700 := fl_NR_InitSI_SchedulingInfo_v1700(p_NR_SysinfoCombination); //@sic R5-233379 sic@
    var template (omit) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon := fl_NR_InitTDD_UL_DL_ConfigCommon( p_NR_FrequencyBand.FrequencyBandIndicator, p_SubcarrierSpacing);
    var template (value) DownlinkConfigCommonSIB v_DownlinkConfigCommonSIB;
    var template (omit) UplinkConfigCommonSIB v_UplinkConfigCommonSIB := omit;
    var boolean v_IsFR1 := f_NR_IsBandFR1(p_NR_FrequencyBand.FrequencyBandIndicator);
    var template (omit) P_Max v_P_Max := f_NR_InitP_Max(v_IsFR1);
    var template (value) FrequencyInfoDL_SIB v_FrequencyInfoDL_SIB;
    var template (value) FrequencyInfoUL_SIB v_FrequencyInfoUL;
    var NR_DownlinkBWP_Type v_DL_BWP := f_NR_RetrieveDownlinkBWP(valueof(p_DL_BWPs), tsc_NR_BWP_Id);
    var template (omit) NR_UplinkBWP_Type v_UL_BWP := omit;
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon := f_NR_RetrieveBWP_DownlinkCommon(v_DL_BWP, p_NR_FrequencyBand.Coreset0_Index, true);
    var template (value) ServingCellConfigCommonSIB.ssb_PositionsInBurst v_Ssb_PositionsInBurst;
    var Q_RxLevMin v_Q_RxLevMin;       //@sic R5-197243 sic@
    var template (omit) Q_QualMin  v_Q_QualMin := omit;       //@sic R5-197243 sic@
    var template (omit) SIB1.eCallOverIMS_Support v_ECallOverIMS_Support := omit; //@sic R5-216327 sic@
    var template (omit) NPN_IdentityInfoList_r16 v_NPN_IdentityInfoList := f_NR_InitNPN_IdentityInfoList(p_NR_CellId, p_NAS_Parameters);
    var template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse v_CellReservedForOtherUse := f_NR_InitCellReservedForOtherUse(); //@sic R5-225299 sic@
    var template (omit) SIB1_v1610_IEs v_SIB1_v1610 := omit;                             //@sic R5-227518 sic@
    var template (omit) RedCap_ConfigCommonSIB_r17 v_RedCap_ConfigCommonSIB_r17 := omit; //@sic R5-227518 sic@
    var template (omit) ServingCellConfigCommonSIB.channelAccessMode_r16 v_ChannelAccessMode_r16 := omit;
    var NTN_Satellite_Type v_SatelliteType := f_NR_MobileInfo_GetNTNSatelliteType();  //@sic R5s250100  R5-253086 sic@
    var template (value) UE_TimersAndConstants v_UE_TimersAndConstants := cs_38508_UE_TimersAndConstants; //@sic R5s250100 R5-253086 sic@
    var template (value) PLMN_IdentityInfo v_PLMN_IdentityInfo:= cs_NR_PLMN_IdentityInfo(p_NAS_Parameters.PLMN_Identity,
                                                                                         p_NAS_Parameters.TrackingAreaCode,
                                                                                         p_NAS_Parameters.Ranac,
                                                                                         p_NAS_Parameters.CellIdentity); //@sic R5-254144 sic@
    
    if (v_IsFR1) {
        v_Ssb_PositionsInBurst := cs_NR_SIB_Ssb_PositionInBurst_FR1(f_NR_ConvertSSB_IndexToBit(p_SSB_Index,8));
        v_Q_RxLevMin := -55;
    } else {
        v_Ssb_PositionsInBurst := cs_NR_SIB_Ssb_PositionInBurst_FR2(f_NR_ConvertSSB_IndexToBit(p_SSB_Index,8));
        // FR2 q-RxLevMin = ROUND((-110+Delta(NRfs))/2) @sic R5-197243 sic@
        v_Q_RxLevMin := f_NR_CalculateQ_RxLevMin(-110.0, p_DeltaNRFs);
    }
    if (f_GetTestcaseAttrib_Qbased_Rsrq(testcasename())) {
        v_Q_QualMin := -20;
    }
    v_FrequencyInfoDL_SIB := cs_38508_FrequencyInfoDL_SIB(cs_38508_NR_MultiBandInfo( p_NR_FrequencyBand.FrequencyBandIndicator),  // Table 4.6.5-0H: MultiFrequencyBandListNR-SIB
                                                                                     p_NR_FrequencyBand.Dl_OffsetToPointA,
                                                                                     p_NR_FrequencyBand.FrequencyInfoDL.scs_SpecificCarrierList);
    //@sic R5-240531, R5w240005 sic@ - SharedSpectrum condition
    if (f_NR_IsBandSharedSpectrum(p_NR_FrequencyBand.FrequencyBandIndicator)) {
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_SemiStatic_SIB; // @sic R5-242772 sic@
      }
      else if (pc_ul_DynamicChAccess_r16){
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_Dynamic_SIB;  // @sic R5-242772 sic@
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
    }
    v_DownlinkConfigCommonSIB := cs_38508_DownlinkConfigCommonSIB(v_FrequencyInfoDL_SIB,
                                                                  v_BWP_DownlinkCommon,
                                                                  cs_38508_BCCH_Config,
                                                                  cs_38508_PCCH_Config
                                                                  );

    if (f_NR_IsBandFDD( p_NR_FrequencyBand.FrequencyBandIndicator)) {  //@sic R5-194805 sic@
        v_FrequencyInfoUL := cs_38508_FrequencyInfoUL_SIB({cs_38508_NR_MultiBandInfo( p_NR_FrequencyBand.FrequencyBandIndicator)},
                                                           p_NR_FrequencyBand.FrequencyInfoUL.absoluteFrequencyPointA,
                                                           p_NR_FrequencyBand.FrequencyInfoUL.scs_SpecificCarrierList,
                                                           v_P_Max);
    } else {//@sic R5-194805 sic@
       v_FrequencyInfoUL := cs_38508_FrequencyInfoUL_SIB(omit,
                                                         omit,
                                                         p_NR_FrequencyBand.FrequencyInfoUL.scs_SpecificCarrierList,
                                                         v_P_Max);
    }
    if (isvalue(p_UL_BWPs)) {
        v_UL_BWP := f_NR_RetrieveUplinkBWP(valueof(p_UL_BWPs), tsc_NR_BWP_Id);
        v_UplinkConfigCommonSIB := cs_38508_UplinkConfigCommonSIB(v_FrequencyInfoUL, f_NR_RetrieveBWP_UplinkCommon(valueof(v_UL_BWP)));
    }
    if (f_GetTestcaseAttrib_ECallOverIMS(testcasename())) {  //@sic R5-216327 sic@
        v_ECallOverIMS_Support := true_;
    }
    if (pc_supportOfRedCap_r17) {  //@sic R5-227518 R5-247239 sic@
        if (pc_halfDuplexFDD_TypeA_RedCap_r17) { //@sic R5-233406 sic@
          v_RedCap_ConfigCommonSIB_r17 := cs_RedCap_ConfigCommonSIB(true_);
        }
        v_SIB1_v1610 := cs_SIB1_v1610_IEs_Def( omit, cs_SIB1_v1630_IEs_Def(cs_SIB1_v1700_IEs_Def(v_RedCap_ConfigCommonSIB_r17, allowed, v_SI_SchedulingInfo_v1700)));
    } else {
        if (isvalue(v_SI_SchedulingInfo_v1700)) {
            v_SIB1_v1610 := cs_SIB1_v1610_IEs_Def(omit, cs_SIB1_v1630_IEs_Def(cs_SIB1_v1700_IEs_Def(omit, omit, v_SI_SchedulingInfo_v1700)));
        }
    }
    if (pc_supportOfERedCap_r18) {  //@sic R5-245624 sic@
       if (isvalue(v_SIB1_v1610)) {
          v_SIB1_v1610.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SIB1_v1740_IEs_Def( -, cs_SIB1_v1800_IEs_Def( omit, omit, allowed));
       } else {
          v_SIB1_v1610 := cs_SIB1_v1610_IEs_Def(omit, cs_SIB1_v1630_IEs_Def(cs_SIB1_v1700_IEs_Def(-, -, -, -, -, cs_SIB1_v1740_IEs_Def( -, cs_SIB1_v1800_IEs_Def( omit, omit, allowed)))));
       }
    }
    select (v_SatelliteType) {
      case (ntn_GSO) {v_UE_TimersAndConstants := cds_38508_UE_TimersAndConstants_NTN}
    }
    // Set v_PLMN_IdentityInfo as per Table 4.6.3-108: PLMN-IdentityInfoList with condition NTN
    // @sic R5-254144 sic@
    if (v_SatelliteType != ntn_None) { //NTN condition apply
      v_PLMN_IdentityInfo := cs_NR_PLMN_IdentityInfo(p_NAS_Parameters.PLMN_Identity,
                                                     omit,
                                                     p_NAS_Parameters.Ranac,
                                                     p_NAS_Parameters.CellIdentity,
                                                     {p_NAS_Parameters.TrackingAreaCode});
    }
    v_SIB1 := cs_NR_BCCH_DL_SCH_SIB1(cs_38508_SIB1_Def(v_PLMN_IdentityInfo,
                                                       v_SI_SchedulingInfo,
                                                       v_DownlinkConfigCommonSIB,
                                                       v_UplinkConfigCommonSIB,
                                                       v_TDD_UL_DL_ConfigCommon,
                                                       v_Ssb_PositionsInBurst,
                                                       v_Q_RxLevMin,
                                                       omit,
                                                       v_Q_QualMin,
                                                       v_ECallOverIMS_Support,
                                                       v_NPN_IdentityInfoList,
                                                       v_CellReservedForOtherUse,
                                                       v_SIB1_v1610,
                                                       v_ChannelAccessMode_r16,
                                                       v_UE_TimersAndConstants   //@sic R5s250100 R5-253086 sic@
                                                       ));
    return v_SIB1;
  }

  /*
   * @desc      Initialise SI Scheduling as per NR sysinfo combination - Scheduling defined in 38.508-1 cl 4.4.3.1.3
   * @param     p_NR_SysinfoCombination
   * @param     p_FreqBandIndicatorNR
   * @return    template (omit) SI_SchedulingInfo
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitSI_SchedulingInfo(NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                                       FreqBandIndicatorNR p_FreqBandIndicatorNR) return template (omit) SI_SchedulingInfo
  {
    var template (omit) SI_SchedulingInfo v_SI_SchedulingInfo := omit;
    var template (value) SI_SchedulingInfo.schedulingInfoList v_SchedulingInfoList;
    var SI_SchedulingInfo.si_WindowLength v_SI_WindowLength;

    if (f_NR_IsBandFR1(p_FreqBandIndicatorNR)) { // As per 38.508-1 Table 4.6.3-173: SI-SchedulingInfo
      v_SI_WindowLength := s80;
    } else {
      v_SI_WindowLength := s160;
    }
    //Acc to 38.508-1 cl 4.4.3.1.3 @sic R5-187662 sic@
    select (p_NR_SysinfoCombination) {
      case(NR_1) { //No SI scheduling v_SI_SchedulingInfo = omit as default
      }
      case(NR_2) { //SIB2
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_3) { //SIB2 & SIB3
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB3_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType3)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_4) { //SIB2 & SIB4
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_5) { //SIB2 & SIB3 & SIB4
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List3(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB3_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType3)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_6) { //SIB2 & SIB5
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB5_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType5)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_7) { // SIB2 & SIB4 & SIB5
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4), cs_NR_SIB_TypeInfoDef(sibType5)})
                                                              );
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_8) { //SIB6 & SIB7
        //@sic R5-202525 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB6_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType6)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB7_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType7)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_9) { //SIB8
        //@sic R5-202525 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB8_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType8)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_10) { //SIB6
        // @sic R5-191450 R5-202525 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB6_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType6)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_11) { //SIB7
        // @sic R5-191450 R5-202525 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB7_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType7)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_12) { //SIB10
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB10_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType10_v1610)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_14) { //SIB2 + SIB4 + SIB12
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List3(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB12_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType12_v1610)})
                                                             );
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_15) { //PosSIBs scheduling included in another field
        //@sic R5-223387 sic@
        v_SI_SchedulingInfo := omit;
      }
      case(NR_16) { //SIB2 + PosSIBs (not in this field)
        //@sic R5-223387 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_17) { //SIB2 + SIB4 + PosSIBs (not in this field)
        //@sic R5-223387 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)})
                                                              );
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_18) { //SIB4 + SIB11
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB11_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType11_v1610)})
                                                              );
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_19) {
        // @sic R5-213452 R5-223417 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2),cs_NR_SIB_TypeInfoDef(sibType11_v1610)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_20, NR_21, NR_22) {
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}));
        // SIB20/SIB21 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_23, NR_24, NR_25) {
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)})
                                                              );
        // SIB20/SIB21 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_26) {
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB10_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType10_v1610)}));
        // SIB18 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_27) {
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB10_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType10_v1610)}));
        // SIB18 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      
      //case(NR_28) @sic R5-253084 sic@
      case(NR_29) {
        // SIB19 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_30) {
        // @sic R5-233379 sic@
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}));
        // SIB16 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700                                                       `     `
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_32) { //@sic R5-243555 sic@
        // SIB19 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
       v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}));
       v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_34) {//@sic R5-254023 sic@
        // SIB22 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List1(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_35) { //@sic R5-254943 sic@
        // SIB19 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        // SIB25 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
       v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB4_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType4)}));
       v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_36) {
        // SIB23 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
        v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB12_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType12_v1610)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case(NR_40) { //SIB2 & SIB3 /* @sic R5-261589 sic@ */
        // SIB19 scheduled in si-SchedulingInfo-v1700 - done inside fl_NR_InitSI_SchedulingInfo_v1700
       v_SchedulingInfoList := cs_NR_SI_SchedulingInfo_List2(cs_NR_SchedulingInfoDef(tsc_SIB2_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType2)}),
                                                              cs_NR_SchedulingInfoDef(tsc_SIB3_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType3)}));
        v_SI_SchedulingInfo := cs_NR_SI_SchedulingInfoDef(v_SchedulingInfoList, v_SI_WindowLength);
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid NR SysinfoCombination");
      }
    }
    return v_SI_SchedulingInfo;
  }

  /*
   * @desc      Initialise SI-SchedulingInfo-v1700 as per NR sysinfo combination - Scheduling defined in 38.508-1 cl 4.4.3.1.3
   * @param     p_NR_SysinfoCombination
   * @return    template (omit) SI_SchedulingInfo_v1700
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitSI_SchedulingInfo_v1700(NR_SysinfoCombination_Type p_NR_SysinfoCombination) return template (omit) SI_SchedulingInfo_v1700
  {
    var template (omit) SI_SchedulingInfo_v1700 v_SI_SchedulingInfo_v1700 := omit;
    var template (value) SI_SchedulingInfo_v1700.schedulingInfoList2_r17 v_SchedulingInfoList2;

    //Acc to 38.508-1 cl 4.4.3.1.3
    select (p_NR_SysinfoCombination){
      case(NR_20) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB20_Periodicity, {cs_SIB_TypeInfo_Type1(sibType20)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_21) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB21_Periodicity, {cs_SIB_TypeInfo_Type1(sibType21)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_22) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB20_Periodicity, {cs_SIB_TypeInfo_Type1(sibType20)}),
                                   cs_SchedulingInfo2_r17(3, tsc_SIB21_Periodicity, {cs_SIB_TypeInfo_Type1(sibType21)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_23) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB20_Periodicity, {cs_SIB_TypeInfo_Type1(sibType20)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_24) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB21_Periodicity, {cs_SIB_TypeInfo_Type1(sibType21)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_25) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB20_Periodicity, {cs_SIB_TypeInfo_Type1(sibType20)}),
                                   cs_SchedulingInfo2_r17(4, tsc_SIB21_Periodicity, {cs_SIB_TypeInfo_Type1(sibType21)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_26) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(1, tsc_SIB18_Periodicity, {cs_SIB_TypeInfo_Type1(sibType18)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_27) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB18_Periodicity, {cs_SIB_TypeInfo_Type1(sibType18)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      //case (NR_28) @sic R5-253084 sic@
      case(NR_29) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB19_Periodicity, {cs_SIB_TypeInfo_Type1(sibType19)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_30) {
        // @sic R5-233379 sic@
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB16_Periodicity, {cs_SIB_TypeInfo_Type1(sibType16)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_32, NR_40) {//@sic R5-243555, R5-261589 sic@
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB19_Periodicity, {cs_SIB_TypeInfo_Type1(sibType19)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_34) {//@sic R5-254023 sic@
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(2, tsc_SIB22_Periodicity, {cs_SIB_TypeInfo_Type1(sibType22_v1800)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_35) {//@sic R5-243555 sic@
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(3, tsc_SIB19_Periodicity, {cs_SIB_TypeInfo_Type1(sibType19)}),
                                   cs_SchedulingInfo2_r17(3, tsc_SIB25_Periodicity, {cs_SIB_TypeInfo_Type1(sibType25_v1800)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case(NR_36) {
        v_SchedulingInfoList2 := { cs_SchedulingInfo2_r17(1, tsc_SIB23_Periodicity, {cs_SIB_TypeInfo_Type1(sibType23_v1800)})};
        v_SI_SchedulingInfo_v1700 := cs_SI_SchedulingInfo_v1700_Def(v_SchedulingInfoList2);
      }
      case else { //do nothing
      }
    }
    return v_SI_SchedulingInfo_v1700;
  }

  /*
   * @desc      Initialise SIB2 as per 38.508-1 Table 4.6.2-1: SIB2
   * @param     p_FrequencyBandIndicator
   * @param     p_SCS
   * @return    template (value) SIB2
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
 function fl_NR_InitSIB2(FreqBandIndicatorNR     p_FrequencyBandIndicator,
                         SubcarrierSpacing       p_SCS
                         ) return template (value) SIB2
 {  //@sic R5-204395: added p_SCS sic@
    var boolean v_DeriveSSB_IndexFromCell := f_RetrieveDeriveSSB_IndexFromCellFromBand(p_FrequencyBandIndicator); //@sic R5-199020 sic@
    var template (value) SIB2  v_SIB2;
    var template (omit) SSB_PositionQCL_Relation_r16 v_Ssb_PositionQCL_Common := omit;

    //@sic R5-240531, R5w240005 sic@ - SharedSpectrum condition
    if (f_NR_IsBandSharedSpectrum(p_FrequencyBandIndicator)) {
        v_Ssb_PositionQCL_Common := n2;
    }
    if (f_GetTestcaseAttrib_Qbased_Rsrq(testcasename())) {
       v_SIB2 := cs_38508_SIB2_Def( p_FrequencyBandIndicator, p_SCS, v_DeriveSSB_IndexFromCell , 3, -20, v_Ssb_PositionQCL_Common);
    } else {
       v_SIB2 := cs_38508_SIB2_Def( p_FrequencyBandIndicator, p_SCS, v_DeriveSSB_IndexFromCell, -, -, v_Ssb_PositionQCL_Common);
    }
    return v_SIB2;
  }

  /*
   * @desc      Initialise SIB2 SSB_Index as per 38.508-1 Table 4.6.2-1: SIB2
   * @param     p_FreqBandIndicatorNR
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_RetrieveDeriveSSB_IndexFromCellFromBand(FreqBandIndicatorNR   p_FreqBandIndicatorNR) return boolean
  {
    var boolean v_DeriveSSB_IndexFromCell;
    if (f_NR_IsBandFDD(p_FreqBandIndicatorNR)){
        v_DeriveSSB_IndexFromCell := false; //FDD
    } else { //TDD (FR1 or FR2))
        v_DeriveSSB_IndexFromCell := true;
    }
    return v_DeriveSSB_IndexFromCell;
   }

  /*
   * @desc      Initialise SIB4 with an empty frequencyList
   *            Frequency list to be initialised after cellArray initialisation
   * @param     p_NR_FrequencyBand
   * @param     p_SubcarrierSpacing
   * @return    template (value) SIB4
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitSIB4(NR_FrequencyBand_Type p_NR_FrequencyBand,
                          SubcarrierSpacing p_SubcarrierSpacing) return template (value) SIB4
  {
    var template (value) SIB4 v_SIB4;
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierFreqList;
    var template (value) SSB_MTC v_SSB_MTC := f_NR_InitSSB_MTC(p_NR_FrequencyBand.FrequencyBandIndicator);

    //Dummy Frequency list - To be initialised after cellAray initialisation
    v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(p_NR_FrequencyBand.FrequencyInfoDL.absoluteFrequencySSB,
                                                                       p_SubcarrierSpacing,
                                                                       p_NR_FrequencyBand.FrequencyBandIndicator,
                                                                       f_RetrieveDeriveSSB_IndexFromCellFromBand(p_NR_FrequencyBand.FrequencyBandIndicator), //@sic R5-199020 sic@
                                                                       4,
                                                                       -55,  //Temporary FR1 value
                                                                       dB0,
                                                                       v_SSB_MTC
                                                                       ); //p_CellReselectionPriority
    v_SIB4 := cs_38508_SIB4_Def(v_InterFreqCarrierFreqList);
    return v_SIB4;
  }

  /*
   * @desc      Initialise frequencyList in SYSINFO as per 38.508-1 Table 6.3.1.2-1
   * @param     p_NR_SysinfoCombination
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitSysinfoFrequencyList (NR_SysinfoCombination_Type p_NR_SysinfoCombination
                                          ) runs on NR_BASE_PTC
  { //@sic R5-190659 R5s240053 sic@
    select (p_NR_SysinfoCombination)  {
      case(NR_4, NR_5, NR_7, NR_14, NR_17, NR_18, NR_30, NR_32, NR_35){ //Add InterFreqCarrierFreqList in SIB4 for all cells
        fl_NR_InitSIB4_FreqInfoList();
      }
      case else {} //case else do nothing - no SIB3/SIB4 included
    }
  }

  /*
   * @desc    Get the number of frequencies available on the primary band - The test case type is handled (CA, ENDC CA etc...)
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetNumberOfFreqPrimaryBand() runs on NR_BASE_PTC return integer
  {
    var integer                    v_PrimaryNumberOfFreq;
    var FreqBandIndicatorNR        v_PrimaryBand := f_NR_CellInfo_GetBandIndicator(nr_Cell1);
    var NR_CA_Tested_Type          v_NR_CA_Tested;
    var NR_CA_BandCombination_Type v_NR_CA_BandCombination;

    if (f_GetTestcaseAttrib_NR_CA(testcasename())) {  //@sic R5s201463 sic@
        // CA test case, get the number of frequencies from the NR CA functions
        if (f_GetTestcaseAttrib_ENDC(testcasename())) {
            // ENDC CA test case
            v_NR_CA_BandCombination := f_ENDCCA_GetNR_CABand(px_ENDC_CA_BandCombination);
        } else {
            //NR5GC CA test case
            v_NR_CA_BandCombination := px_NR_CA_BandCombination;
        }
        v_PrimaryBand := f_NR_GetCA_PrimaryBand(v_NR_CA_BandCombination);
        v_NR_CA_Tested := f_NR_GetCA_CombinationType(v_NR_CA_BandCombination);

        select ( v_NR_CA_Tested ) {
            case(CA_InterBand){ v_PrimaryNumberOfFreq := f_NR_BandGetNumberOfFreq(v_PrimaryBand); }
            case(CA_IntraBandContiguous, CA_IntraBandNonContiguous) { v_PrimaryNumberOfFreq := f_NR_GetCA_GetNumberOfFreqPrimaryBand(v_NR_CA_BandCombination); }
        }
    } else if (f_GetTestcaseAttrib_NR_DC(testcasename()) and f_GetTestcaseAttrib_NR_CA(testcasename())) { //@sic R5-227565 sic@
        v_PrimaryBand := f_NR_GetNRDC_CA_PrimaryBand (px_NR_DC_CA_BandCombination);
        v_PrimaryNumberOfFreq := f_NR_BandGetNumberOfFreq(v_PrimaryBand);
    } else if (f_GetTestcaseAttrib_NR_DC(testcasename())) {
        v_PrimaryBand := f_NR_GetNR_DC_PrimaryBand (px_NR_DC_BandCombination);
        v_PrimaryNumberOfFreq := f_NR_BandGetNumberOfFreq(v_PrimaryBand);
    } else {
        v_PrimaryNumberOfFreq := f_NR_BandGetNumberOfFreq(v_PrimaryBand);
    }
    return v_PrimaryNumberOfFreq;
  }

  /*
   * @desc      Add InterFreqCarrierFreqList in SIB4 for all cells
   *            Acc to 38.508-1 Table 6.3.1.2-1: Inter-frequency carrier frequency lists for NR cells
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_InitSIB4_FreqInfoList() runs on NR_BASE_PTC
  { //@sic R5-190659 sic@
    var FreqBandIndicatorNR v_PrimaryBand := f_NR_CellInfo_GetBandIndicator(nr_Cell1);
    var integer v_PrimaryNumberOfFreq := f_NR_GetNumberOfFreqPrimaryBand(); //@sic R5s201090 sic@
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierFreqList;
    var template (value) InterFreqCarrierFreqList v_SecondaryInterFreqCarrierFreqList;
    var SubcarrierSpacing v_PrimarySubcarrierSpacing := f_NR_CellInfo_GetSSB_SCS(nr_Cell1);
    var FreqBandIndicatorNR v_SecondaryBand := f_NR_CellInfo_GetBandIndicator(nr_Cell10);
    var SubcarrierSpacing v_SecondarySubcarrierSpacing := f_NR_CellInfo_GetSSB_SCS(nr_Cell10);
    var ARFCN_ValueNR v_NRf1_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell1);
    var ARFCN_ValueNR v_NRf2_SSB;   //May not be available
    var ARFCN_ValueNR v_NRf3_SSB;   //May not be available
    var ARFCN_ValueNR v_NRf5_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell10);
    var DeltaValues_Type v_DeltaPrimaryBand := vc_NR_Global.MobileInfo.NR_DeltaValues.DeltaPrimaryBand; //@sic R5-197243 sic@
    var DeltaValues_Type v_DeltaSecondaryBand := vc_NR_Global.MobileInfo.NR_DeltaValues.DeltaSecondaryBand;
    var Q_RxLevMin v_Q_RxLevMinNRf1 := f_NR_CalculateQ_RxLevMin(-110.0, v_DeltaPrimaryBand.DeltaNRf1);
    var Q_RxLevMin v_Q_RxLevMinNRf2 := f_NR_CalculateQ_RxLevMin(-110.0, v_DeltaPrimaryBand.DeltaNRf2);
    var Q_RxLevMin v_Q_RxLevMinNRf3 := f_NR_CalculateQ_RxLevMin(-110.0, v_DeltaPrimaryBand.DeltaNRf3);
    var Q_RxLevMin v_Q_RxLevMinNRf5 := f_NR_CalculateQ_RxLevMin(-110.0, v_DeltaSecondaryBand.DeltaNRf1);
    var template (omit) Q_QualMin v_Q_QualMin := omit;
    var template (omit) InterFreqCarrierFreqInfo.threshX_Q v_ThreshX_Q := omit;
    var template (value) SSB_MTC v_SSB_MTC_NRf1;
    var template (value) SSB_MTC v_SSB_MTC_NRf2;
    var template (value) SSB_MTC v_SSB_MTC_NRf3;
    var template (value) SSB_MTC v_SSB_MTC_NRf5;
    var boolean v_IsPrimaryBand3MHz := f_NR_CellInfo_GetIsBandwidth3MHz(nr_Cell1);     //@sic R5-254993 sic@
    var boolean v_IsSecondaryBand3MHz := f_NR_CellInfo_GetIsBandwidth3MHz(nr_Cell10);  //@sic R5-254993 sic@
    var template (omit) InterFreqCarrierFreqInfo_v1800 v_InterFreqCarrierFreqInfo_v1800_NRf1 := omit;    //@sic R5-254993 sic@
    var template (omit) InterFreqCarrierFreqInfo_v1800 v_InterFreqCarrierFreqInfo_v1800_NRf2 := omit;    //@sic R5-254993 sic@
    var template (omit) InterFreqCarrierFreqInfo_v1800 v_InterFreqCarrierFreqInfo_v1800_NRf3 := omit;    //@sic R5-254993 sic@
    var template (omit) InterFreqCarrierFreqInfo_v1800 v_InterFreqCarrierFreqInfo_v1800_NRf5 := omit;    //@sic R5-254993 sic@
    var template (omit) InterFreqCarrierFreqList_v1800 v_InterFreqCarrierFreqList_v1800 := omit;    //@sic R5-254993 sic@
    
    if (f_GetTestcaseAttrib_Qbased_Rsrq(testcasename())) {  //in RSRQ tc the Condition QBASED is applied in SIB4
        v_Q_QualMin := -20;
        v_ThreshX_Q := cs_38508_ThreshX_Q;
    }
    if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) {
      // Neighbour band is BW3
      // Set NRf5 ARFCN to 250
      // Set secondaryBand to 200
      // Include InterFreqCarrierFreqList-v1800
      //@sic R5-254993 sic@
      v_InterFreqCarrierFreqInfo_v1800_NRf5 := cs_InterFreqCarrierFreqInfo_v1800_Def ( omit, v_NRf5_SSB, {cs_38508_NR_MultiBandInfo(v_SecondaryBand)});
      v_NRf5_SSB := 250;
      v_SecondaryBand := 200;
    }

    select (v_PrimaryNumberOfFreq) {
      case(3, 4) {
        // for NR Cell 1/NR Cell 2/ NR Cell 4 / NR Cell 11  NRf1
        // include  NRf2, NRf3, NRf5(if interBand TC)
        v_NRf2_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
        v_NRf3_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell6);
        v_SSB_MTC_NRf2 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell3);
        v_SSB_MTC_NRf3 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell6);
        v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf2_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf2,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf2),
                                                                           v_SSB_MTC_NRf2,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        v_InterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf3_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf3,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf3),
                                                                           v_SSB_MTC_NRf3,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell10);
          v_InterFreqCarrierFreqList[2] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand), //@sic R5-199020 sic@
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
            v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf3_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 v_InterFreqCarrierFreqInfo_v1800_NRf5};
          } else {
            v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf3_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)})};
          }
        }
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell1, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell2, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell4, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell11, v_InterFreqCarrierFreqList);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz) {
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell1, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell2, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell4, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell11, v_InterFreqCarrierFreqList_v1800);
        }
        // for NR Cell 3/NR Cell 23
        // include  NRf1 NRf3 NRf5(if interBand TC)
        v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell3, nr_Cell1);
        v_SSB_MTC_NRf3 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell3, nr_Cell6);
        v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf1,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf2, v_DeltaPrimaryBand.DeltaNRf1),
                                                                           v_SSB_MTC_NRf1,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        v_InterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf3_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf3,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf2, v_DeltaPrimaryBand.DeltaNRf3),
                                                                           v_SSB_MTC_NRf3,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell3, nr_Cell10);
          v_InterFreqCarrierFreqList[2] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand), //@sic R5-199020 sic@
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf2, v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
            v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf3_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 v_InterFreqCarrierFreqInfo_v1800_NRf5};
          } else {
            v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                 cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf3_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)})};
          }
        }
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell3, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell23, v_InterFreqCarrierFreqList);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz) {
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell3, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell23, v_InterFreqCarrierFreqList_v1800);
        }
        //For NR Cell 6
        //include NRf1 NRf2 NRf5(if interBand TC)
        v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell6, nr_Cell1);
        v_SSB_MTC_NRf2 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell6, nr_Cell3);
        v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf1,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf3, v_DeltaPrimaryBand.DeltaNRf1),
                                                                           v_SSB_MTC_NRf1,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        v_InterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf2_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf2,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf3, v_DeltaPrimaryBand.DeltaNRf2),
                                                                           v_SSB_MTC_NRf2,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell6, nr_Cell10);
          v_InterFreqCarrierFreqList[2] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand), //@sic R5-199020 sic@
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf3, v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                  cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                  v_InterFreqCarrierFreqInfo_v1800_NRf5};
          } else {
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                  cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)})};
          }
       }
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell6, v_InterFreqCarrierFreqList);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz) {
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell6, v_InterFreqCarrierFreqList_v1800);
        }
      }
      case(2) {
        // for NR Cell 1/NR Cell 2/ NR Cell 4 / NR Cell 11  NRf1
        // include  NRf2 NRf5(if interBand TC)
        v_NRf2_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
        v_SSB_MTC_NRf2 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell3);
        v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf2_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf2,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf2),
                                                                           v_SSB_MTC_NRf2,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell10);
          v_InterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand), //@sic R5-199020 sic@
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                  v_InterFreqCarrierFreqInfo_v1800_NRf5};
          } else {
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)})}
          }
        }
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell1, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell2, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell4, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell11, v_InterFreqCarrierFreqList);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz) {
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell1, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell2, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell4, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell11, v_InterFreqCarrierFreqList_v1800);
        }
        // for NR Cell 3/NR Cell 23
        // include  NRf1 NRf5(if interBand TC)
        v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell3, nr_Cell3);
        v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                           v_PrimarySubcarrierSpacing,
                                                                           v_PrimaryBand,
                                                                           f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                           -,
                                                                           v_Q_RxLevMinNRf1,
                                                                           f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf2, v_DeltaPrimaryBand.DeltaNRf1),
                                                                           v_SSB_MTC_NRf1,
                                                                           v_Q_QualMin,
                                                                           v_ThreshX_Q);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell3, nr_Cell10);
          v_InterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand), //@sic R5-199020 sic@
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf2,v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)}),
                                                  v_InterFreqCarrierFreqInfo_v1800_NRf5};
          } else {
             v_InterFreqCarrierFreqList_v1800 := {cs_InterFreqCarrierFreqInfo_v1800_Def(omit, v_NRf1_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)})};
          }
        }
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell3, v_InterFreqCarrierFreqList);
        f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell23, v_InterFreqCarrierFreqList);
        if (f_GetTestcaseAttrib_InterBandTC(testcasename()) and v_IsSecondaryBand3MHz) {
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell3, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell23, v_InterFreqCarrierFreqList_v1800);
        }
        //NRf3 not available
      }
      case(1) {
        // for NR Cell 1/NR Cell 2/ NR Cell 4 / NR Cell 11  NRf1
        // include  NRf5(if interBand TC)
        if (f_GetTestcaseAttrib_InterBandTC(testcasename())) { //InterBand TC
          v_SSB_MTC_NRf5 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1, nr_Cell10);
          v_InterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf5_SSB,
                                                                             v_SecondarySubcarrierSpacing,
                                                                             v_SecondaryBand,
                                                                             f_RetrieveDeriveSSB_IndexFromCellFromBand(v_SecondaryBand),
                                                                             -,
                                                                             v_Q_RxLevMinNRf5,
                                                                             f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaPrimaryBand.DeltaNRf1, v_DeltaSecondaryBand.DeltaNRf1),
                                                                             v_SSB_MTC_NRf5,
                                                                             v_Q_QualMin,
                                                                             v_ThreshX_Q);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell1, v_InterFreqCarrierFreqList);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell2, v_InterFreqCarrierFreqList);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell4, v_InterFreqCarrierFreqList);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell11, v_InterFreqCarrierFreqList);
          if(v_IsSecondaryBand3MHz and not(v_IsPrimaryBand3MHz)) { //@sic R5s250373 sic@
            v_InterFreqCarrierFreqList_v1800 := {v_InterFreqCarrierFreqInfo_v1800_NRf5};
          }
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell1, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell2, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell4, v_InterFreqCarrierFreqList_v1800);
          f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell11, v_InterFreqCarrierFreqList_v1800);
        } else {
          FatalError(__FILE__, __LINE__, "SIB4 can't be initialised with a Band with only one frequency available");
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid number of frequencies in primary band");
      }
    }
    
    if (f_GetTestcaseAttrib_InterBandTC(testcasename())) {
      // For InterBand TC initialise SIB4 in NR Cell 10 =>  NRf5 includes NRf1/NRf2/NRf3 if available
      if (v_IsPrimaryBand3MHz and not(v_IsSecondaryBand3MHz)) {
        // Neighbour band is BW3
        // Set NRf1/2/3 ARFCN to 250
        // Set primary Bane to 200
        // Include InterFreqCarrierFreqList-v1800
        //@sic R5-254993 sic@
        v_InterFreqCarrierFreqInfo_v1800_NRf1 := cs_InterFreqCarrierFreqInfo_v1800_Def ( omit, v_NRf5_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)});
        v_NRf1_SSB := 250;
        if (v_PrimaryNumberOfFreq >= 2) {
          v_NRf2_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
          v_InterFreqCarrierFreqInfo_v1800_NRf2 := cs_InterFreqCarrierFreqInfo_v1800_Def ( omit, v_NRf2_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)});
          v_NRf2_SSB := 250;
        }
        if (v_PrimaryNumberOfFreq >= 3) {
          v_NRf3_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell6);
          v_InterFreqCarrierFreqInfo_v1800_NRf3 := cs_InterFreqCarrierFreqInfo_v1800_Def ( omit, v_NRf3_SSB, {cs_38508_NR_MultiBandInfo(v_PrimaryBand)});
          v_NRf3_SSB := 250;
        }
        v_PrimaryBand := 200;
      }
      select(v_PrimaryNumberOfFreq) {
        case(3, 4) {
          v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell1);
          v_SSB_MTC_NRf2 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell3);
          v_SSB_MTC_NRf3 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell6);
          v_SecondaryInterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf1,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf1),
                                                                                      v_SSB_MTC_NRf1,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          v_SecondaryInterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf2_SSB,
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf2,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0,v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf2),
                                                                                      v_SSB_MTC_NRf2,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          v_SecondaryInterFreqCarrierFreqList[2] := cs_38508_InterFreqCarrierFreqInfo(v_NRf3_SSB,  //@sic R5s200368 sic@
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf3,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf3),
                                                                                      v_SSB_MTC_NRf3,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          if (v_IsPrimaryBand3MHz and not(v_IsSecondaryBand3MHz)) {
            v_InterFreqCarrierFreqList_v1800 := {v_InterFreqCarrierFreqInfo_v1800_NRf1, v_InterFreqCarrierFreqInfo_v1800_NRf2, v_InterFreqCarrierFreqInfo_v1800_NRf3};
            f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell10, v_InterFreqCarrierFreqList_v1800);
          }
        }
        case(2) {
          v_NRf2_SSB := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
          v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell1);
          v_SSB_MTC_NRf2 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell3);
          v_SecondaryInterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf1,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf1),
                                                                                      v_SSB_MTC_NRf1,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          v_SecondaryInterFreqCarrierFreqList[1] := cs_38508_InterFreqCarrierFreqInfo(v_NRf2_SSB,
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf2,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf2),
                                                                                      v_SSB_MTC_NRf2,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          if (v_IsPrimaryBand3MHz and not(v_IsSecondaryBand3MHz)) {
            v_InterFreqCarrierFreqList_v1800 := {v_InterFreqCarrierFreqInfo_v1800_NRf1, v_InterFreqCarrierFreqInfo_v1800_NRf2};
            f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell10, v_InterFreqCarrierFreqList_v1800);
          }
        }
        case(1) {
          v_SSB_MTC_NRf1 := f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell10, nr_Cell1);
          v_SecondaryInterFreqCarrierFreqList[0] := cs_38508_InterFreqCarrierFreqInfo(v_NRf1_SSB,
                                                                                      v_PrimarySubcarrierSpacing,
                                                                                      v_PrimaryBand,
                                                                                      f_RetrieveDeriveSSB_IndexFromCellFromBand(v_PrimaryBand), //@sic R5-199020 sic@
                                                                                      -,
                                                                                      v_Q_RxLevMinNRf1,
                                                                                      f_CalculateQ_OffsetRangeWithDelta(0, v_DeltaSecondaryBand.DeltaNRf1, v_DeltaPrimaryBand.DeltaNRf1),
                                                                                      v_SSB_MTC_NRf1,
                                                                                      v_Q_QualMin,
                                                                                      v_ThreshX_Q);
          if (v_IsPrimaryBand3MHz and not(v_IsSecondaryBand3MHz)) {
            v_InterFreqCarrierFreqList_v1800 := {v_InterFreqCarrierFreqInfo_v1800_NRf1};
            f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(nr_Cell10, v_InterFreqCarrierFreqList_v1800);
          }
        }
        case else {
          FatalError(__FILE__, __LINE__, "Invalid number of frequencies in primary band");
        }
      }
      f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell10, v_SecondaryInterFreqCarrierFreqList);
    }
  }

  /*
   * @desc      Get SSB-MTC of the cell and return the value as per 38.508-1 Table 4.6.3-185: SSB-MTC
   *            with the condition SIG AND INTER-FREQ_ODD handled
   * @param     p_Cell
   * @param     p_NeighCell
   * @return    template (value) SSB_MTC
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_GetSSB_MTC_InterFreqOdd ( NR_CellId_Type p_Cell,
                                           NR_CellId_Type p_NeighCell) runs on NR_BASE_PTC return template (value) SSB_MTC
   { //@sic R5-199013 sic@
     var template (value) SSB_MTC v_SSB_MTC := f_NR_GetSSB_MTC(p_Cell);
     var CellTimingInfo_Type v_CellTimingInfo_Cell := f_NR_CellInfo_GetCellTimingInfo(p_Cell);
     var CellTimingInfo_Type v_CellTimingInfo_NeighCell := f_NR_CellInfo_GetCellTimingInfo(p_NeighCell);
     if (((v_CellTimingInfo_Cell.SfnOffset + v_CellTimingInfo_NeighCell.SfnOffset)mod 2) == 1) {
        v_SSB_MTC.periodicityAndOffset.sf20 := 10;
     }
     return v_SSB_MTC;
   }

  /*
   * @desc      Common initialization all SCell withthe same timing as the PSCell
   * @param     p_NR_CA_CellIdList
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_InitialiseWithSameCellTiming(NR_CellIdList_Type p_NR_CA_CellIdList) runs on NR_BASE_PTC
  {
    var integer i;
    var CellTimingInfo_Type v_PCellTiming := f_NR_CellInfo_GetCellTimingInfo(p_NR_CA_CellIdList[0]); // In CA the first cell is the PCell

    // Initialise SFN and Tcell of all cells to the values used in the first Cell in the list
    for (i:=1; i< lengthof(p_NR_CA_CellIdList); i:=i+1) {
      f_NR_CellInfo_Set_CellTimingInfo(p_NR_CA_CellIdList[i], v_PCellTiming);
    }
  }

  /*
   * @desc      Set MultiplePHR to true as per 38.508-1 Table 4.6.3-104: PHR-Config
   * @param     p_NR_CA_CellIdList
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_InitialiseMultiplePHR (NR_CellIdList_Type p_NR_CA_CellIdList) runs on NR_BASE_PTC
  {
    var  integer i;
    for (i:=1; i< lengthof(p_NR_CA_CellIdList); i:=i+1) {
      f_NR_CellInfo_Set_MultiplePHR(p_NR_CA_CellIdList[i], true);
    }
  }

  /*
   * @desc      Initialise NPN_IdentityInfoList_r16 acc to 38.508-1 Table 4.6.3-84AB: NPN-IdentityInfoList
   * @param     p_NR_CellId
   * @param     p_NAS_Parameters
   * @return    template (omit) NPN_IdentityInfoList_r16
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitNPN_IdentityInfoList(NR_CellId_Type p_NR_CellId,
                                          template (value) NR_NAS_Parameters_Type    p_NAS_Parameters
                                         ) return template (omit) NPN_IdentityInfoList_r16
   {
     var template (omit) NPN_IdentityInfoList_r16 v_NPN_IdentityInfoList := omit;
     var NID_r16 v_NID_r16 := f_NR_InitNDI(p_NR_CellId);

     if (f_GetTestcaseAttrib_NR_SNPN(testcasename()) or pc_SNPN_only) {
        v_NPN_IdentityInfoList := { cs_NPN_IdentityInfo_Def(cs_NPN_IdentitySNPN ( valueof(p_NAS_Parameters.PLMN_Identity), {v_NID_r16}),
                                                            p_NAS_Parameters.TrackingAreaCode,
                                                            p_NAS_Parameters.Ranac,
                                                            p_NAS_Parameters.CellIdentity
                                                            )
                                   }
     }
     return v_NPN_IdentityInfoList;
   }

  /*
   * @desc      Funtcion to get the cellReservedForOtherUse content acc to 38.508-1 Table 4.6.3-16: CellAccessRelatedInfo
   * @return    template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitCellReservedForOtherUse() return template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse
   { //@sic R5-225299 sic@
     var template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse v_CellReservedForOtherUse := omit;
     if (f_GetTestcaseAttrib_NR_SNPN(testcasename()) or pc_SNPN_only  ) {
        v_CellReservedForOtherUse := true_;
     }
     return v_CellReservedForOtherUse;
   }

  /*
   * @desc      Initialise NDI value of a cell acc to 38.508-1 Table 4.4.2-4: Default parameters for simulated SNPN cells
   * @param     p_NR_CellId
   * @param     p_AssignmentMode    (default value: 1) @sic R5s230092 sic@
   * @return    NID_r16
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitNDI( NR_CellId_Type p_NR_CellId,
                          integer p_AssignmentMode := 1) return NID_r16
   {  //  @sic R5s230092 R5-240349 sic@
     var NID_r16 v_NID_r16;
     if (pc_SNPN_only and not(f_GetTestcaseAttrib_NR_SNPN(testcasename()))) {  //@sic R5s230281 sic@
        v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(0, 40)
     } else {
        select (p_NR_CellId) {
            case(nr_Cell1) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(1, 40) }
            case(nr_Cell2) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(2, 40) }
            case(nr_Cell3) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(3, 40) }
            case(nr_Cell4) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(4, 40) }
            case(nr_Cell6) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(6, 40) }
            case(nr_Cell10) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(10, 40) }
            case(nr_Cell11) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(11, 40) }
            case(nr_Cell12) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(12, 40) }
            case(nr_Cell13) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(13, 40) }
            case(nr_Cell14) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(14, 40) }
            case(nr_Cell23) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(23, 40) }
            case(nr_Cell28) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(28, 40) }
            case(nr_Cell29) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(29, 40) }
            case(nr_Cell30) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(30, 40) }
            case(nr_Cell31) { v_NID_r16 := int2bit(p_AssignmentMode,4) & int2bit(31, 40) }
            case else {FatalError(__FILE__, __LINE__, "Invalid NR CellId");}
        }
     }
     return v_NID_r16;
   }

  /*
   * @desc      Return true if the UL Frequency is defined for the cell otherwise return false
   *            Note: function to be used ONLY in the NR_CellInfoInit module - f_NR_IsUL_FrequencyAvailable to be used in other modules
   * @param     p_NR_FrequencyBand
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_IsUL_FrequencyAvailable(NR_FrequencyBand_Type p_NR_FrequencyBand) return boolean
   {
    if (ispresent(p_NR_FrequencyBand.FrequencyInfoUL) and not(f_NR_IsBandSDL(p_NR_FrequencyBand.FrequencyBandIndicator))) {
        return true;
    } else {
        return false;
    }
   }

   /*
   * @desc      Return contents of SIB19 for a given NTN cell type
   * @param     p_CellType          (default value: 1)
   * @return    template
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_InitSIB19(NTN_CellInfo_Type.NtnCellType p_CellType := 1) runs on NR_BASE_PTC return template (value) SIB19_r17
   {
       var template (value) EphemerisInfo_r17 v_EphemerisInfo_r17;
       var NTN_Satellite_Type v_SatelliteType := f_NR_MobileInfo_GetNTNSatelliteType();
       var NTN_Config_r17.cellSpecificKoffset_r17 v_CellSpecificKoffset := 550; //GSO
       var template (omit) NTN_Config_r17.kmac_r17 v_Kmac := omit; //GSO
       var template (value) TA_Info_r17 v_TA_Info := cs_TA_Info_r17; //NGSO
       var template (value) SIB19_r17 v_SIB19;

       select (p_CellType)
       {
           case(1)
           {
               if(v_SatelliteType == ntn_GSO)
               {//TS 38.508-1 Table 6.3.4.1-1. Cell Type : First
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-16976014,27636499));
                   v_TA_Info := cs_TA_Info_r17(65896378);
               }
               else
               {//TS 38.508-1 Table 6.3.4.2-1. Cell Type : First
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-2550081,4151097,2263034,21970,-48164,114109));
                   v_CellSpecificKoffset := 5;
                   v_Kmac := 3;
               }
           }
           case(2)
           {
               if(v_SatelliteType == ntn_GSO)
               {//TS 38.508-1 Table 6.3.4.1-1. Cell Type : Second
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-23550424,22301093));
                   v_TA_Info := cs_TA_Info_r17(66485757);
               }
               else
               {//TS 38.508-1 Table 6.3.4.2-1. Cell Type : Second
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-2654549,4386991,1594205,14581,-34487,120182));
                   v_CellSpecificKoffset := 8;
                   v_Kmac := 4;
               }
           }
           case(3)
           {
               if(v_SatelliteType == ntn_GSO)
               {//TS 38.508-1 Table 6.3.4.1-1. Cell Type : Third
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-14502736,29010891));
                   v_TA_Info := cs_TA_Info_r17(66485757);
               }
               else
               {//TS 38.508-1 Table 6.3.4.2-1. Cell Type : Third
                   v_EphemerisInfo_r17 := cs_38508_EphemerisInfo_Def(cs_PositionVelocity_r17(-2401021,3830217,2907041,28879,-61410,105774));
                   v_CellSpecificKoffset := 8;
                   v_Kmac := 4;
               }
           }

       }
       
       v_SIB19 := cs_38508_SIB19_Def(cs_38508_NTN_Config_Def(v_EphemerisInfo_r17, v_CellSpecificKoffset, v_Kmac, v_TA_Info));
       if (f_GetTestcaseAttrib_NTN_Enh(testcasename())){//@sic R5-261148 sic@
           v_SIB19.movingReferenceLocation_r18 := hex2oct('2273BA566355'H);
           v_SIB19.ntnCovEnh_r18.numberOfMsg4HARQ_ACK_Repetitions_r18 := '1100'B;
           v_SIB19.ntnCovEnh_r18.rsrp_ThresholdMsg4HARQ_ACK_r18 := omit;
       }
       return v_SIB19
   }

}
