  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.16.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_16_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Video call with preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var template (value) SDP_Message v_SdpOffer;
    var SipUrl v_ContactUrl;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);                         // @sic R5s220235: IPCAN_VideoCall instead of IPCAN_SpeechCall sic@
        
    f_IMS_TestBody_Set(true);

    // @siclog "Step 0A - 0H" siclog@
    f_IMS_CC_StartCall(IPCAN_MT_VideoCall);

    // @siclog "Step 1" siclog@                 INVITE
    v_SdpOffer := f_IMS_BuildSDP_InitialOfferAudioVideo_TX(tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_only, EVS_A2);     /* @sic R5s220505: tsc_IMS_SDP_VideoCodecList_H265_only instead of tsc_IMS_SDP_VideoCodecList_H264_only sic@
                                                                                                                                                           @sic R5-232153: EVS_B0_A1 replaced by EVS_A2 sic@ */
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_Video_SendInvite(SetupVideoCall, v_SdpOffer);

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MTCallSetup_Video_Receive183(SetupVideoCall, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2);                     /* @sic R5-232153: EVS_A2 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    
    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // @siclog "Step 5A" siclog@
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_VideoCall);
    
    // @siclog "Step 6 - 7" siclog@             UPDATE, 200 OK
    f_IMS_MTCallSetup_NR5GC_Video_Step6_7(SetupVideoCall, v_InviteRequestWithSdp, v_ResponseWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 8 - 10" siclog@            180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel);      /* @sic R5-242749, R5-242752: tsc_OptionTagList_100rel sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 11 - 13" siclog@           MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    // @siclog "Step 14 - 15" siclog@
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrl);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.17.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_17_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Video call without preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var template (value) SDP_Message v_SdpOffer;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);                         // @sic R5s220239: IPCAN_VideoCall instead of IPCAN_SpeechCall sic@
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 0A - 0H" siclog@
    f_IMS_CC_StartCall(IPCAN_MT_VideoCall);                                     // @sic R5s220239: IPCAN_MT_VideoCall instead of IPCAN_MT_SpeechCall sic@

    // @siclog "Step 1" siclog@                 INVITE
    v_SdpOffer := f_IMS_BuildSDP_InitialOfferAudioVideo_TX(tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_only, EVS_A2, tsc_SDP_WithoutPreconditions);       /* @sic R5s220239: tsc_IMS_SDP_VideoCodecList_H265_only instead of tsc_IMS_SDP_VideoCodecList_H264_only sic@
                                                                                                                                                                                           @sic R5-241255: EVS_A2 instead of EVS_B0_A1 sic@ */
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_Video_SendInvite(SetupVideoCall, v_SdpOffer);

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MTCallSetup_Video_Receive183(SetupVideoCall, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2, tsc_SDP_WithoutPreconditions);                       /* @sic R5-241255: EVS_A2 instead of EVS_B0_A1 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    
    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // @siclog "Step 5A" siclog@
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MT_VideoCall, tsc_SDP_WithoutPreconditions);
    
    // @siclog "Step 6 - 8" siclog@             180 Ringing, PRACK, 200 OK
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel, tsc_SDP_WithoutPreconditions);        /* @sic R5s220239: tsc_SDP_WithoutPreconditions sic@
                                                                                                                                   @sic R5-241255: tsc_OptionTagList_100rel sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 9 - 11" siclog@            MMI (Accept Call), 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_VideoCall);                    // @sic R5s220239: IPCAN_MT_VideoCall instead of IPCAN_MT_SpeechCall sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.18.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_18_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / EVS / AMR-WB / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var integer v_BandwidthAS := 38;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 7" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 8" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();          // @sic R5-225927: A_4_1 -> A_4_1a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9" siclog@                 100 Trying
    f_IMS_MOCallSetup_Send100Trying(v_InviteRequestWithSdp);

    // @siclog "Step 10 - 12" siclog@           183 Session Progress, PRACK, 200 OK for PRACK
    f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(v_InviteRequestWithSdp, -, -, -, -, AMR_16000, v_BandwidthAS, tsc_SDP_WithPreconditions);

    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);     // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1

    // @siclog "Step 13 - 14" siclog@           UPDATE, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp, -, -, -, AMR_16000);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");

    // @siclog "Step 15 - 17" siclog@           180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp);

    // @siclog "Step 18 - 19" siclog@           200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      Step 20 for test case 7.19.NR5GC
   * @param     p_LatestSdpOfferFromUE
   * @return    template (value) SDP_Message
   * @status    APPROVED (IMS)
   */
  function fl_TC_7_19_SdpOfferStep20(SDP_Message p_LatestSdpOfferFromUE) runs on IMS_PTC return template (value) SDP_Message
  {
    var template (value) SDP_Message v_SdpMessage := f_IMS_BuildSDP_UpdatedAnswer_TX(p_LatestSdpOfferFromUE); /* same SDP message as used at step 7 of A.4.1a but with actual value for sess-version */
    var SDP_media_desc v_SDP_Media_Desc := valueof(v_SdpMessage.media_list[0]);
    var charstring v_Fmt := f_SDP_MediaDescr_GetAudioCodec(v_SDP_Media_Desc, EVS_16000);
    var template (value) SDP_attribute v_FmtpAttribute := valueof(f_SDP_AttributeList_GetAttribute(v_SDP_Media_Desc.attributes, cr_SDP_Attribute_fmtp(v_Fmt)));

    v_FmtpAttribute.fmtp.params.paramList := f_SemicolonParam_List_Add_TX(v_FmtpAttribute.fmtp.params.paramList, cs_GenericParam("evs-mode-switch", "1"));
    v_SdpMessage.media_list[0].attributes := f_SDP_ExchangeAttribute(v_SdpMessage.media_list[0].attributes, cr_SDP_Attribute_fmtp(v_Fmt), v_FmtpAttribute);

    return v_SdpMessage;
  }

  /*
   * @desc      Step 22 for test case 7.19.NR5GC
   * @return    template (present) SDP_Message
   * @status    APPROVED (IMS)
   */
  function fl_TC_7_19_SdpAnswerStep22() runs on IMS_PTC return template (present) SDP_Message
  {
    var template (present) SDP_attribute_list v_PreconditionAttributes := cr_SDP_PreconditionAttributes(c_sendrecv, c_sendrecv, c_mandatory, c_mandatory);
    var template (present) SDP_attribute_list v_MediaAttributes := {
      cr_SDP_Attribute_rtpmap(-, cr_RTPMAP_EVS_16000),
      cr_SDP_Attribute_fmtp(-, cr_Fmtp_ParamList(superset(cr_GenericParam("evs-mode-switch", "1"))))
    };

    return f_IMS_BuildSDP_RX(-, cr_SDP_Media_Audio, v_MediaAttributes, v_PreconditionAttributes);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.19.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_19_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call / EVS / AMR-WB IO mode / 5GS
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) SDP_Message v_SdpOffer;
    var template (present) SDP_Message v_SdpAnswer;
    var SipUrl v_ContactUrl_UE;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 7" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 8 - 19" siclog@
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a();             /* @sic R5-231492: f_IMS_MOCallSetup_NR5GC_A_4_1a instead of f_IMS_MOCallSetup_NR5GC_A_4_1 sic@ */

    // @siclog "Step 20 - 23" siclog@
    v_SdpOffer := fl_TC_7_19_SdpOfferStep20(v_CallInfo.LatestSdpOffer);
    v_SdpAnswer := fl_TC_7_19_SdpAnswerStep22();
    v_ContactUrl_UE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_MTSessionModification(v_ContactUrl_UE, v_SdpOffer, v_SdpAnswer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.20.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_20_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / add video and remove video / with preconditions at both originating UE and terminating UE / 5GS */
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var charstring v_CallIdentification;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, -, normalCall_ReturnId);
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a();             /* @sic R5-231493: A.4.1a sic@ */
    v_CallIdentification := f_UT_ReceivedIMSCallId(MMI);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_UT_AddVideoToIMSCall(MMI, v_CallIdentification);

    // @siclog "Step 2" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(AddVideo, -, tsc_IMS_SDP_AudioCodecList_EVS_only, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 4" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(AddVideo, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2);

    // @siclog "Step 5 - 6" siclog@             PRACK, 200 OK
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    // @siclog "Step 6A" siclog@
    f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_MO_AddVideo);
      
    // @siclog "Step 7 - 8" siclog@             UPDATE, 200 OK
    f_IMS_MOCallSetup_NR5GC_Video_Step6_7(AddVideo, v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    // @siclog "Step 9 - 10" siclog@            200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // @siclog "Step 11 - 16" siclog@           Release Video
    f_IMS_VideoCall_NR5GC_ReleaseVideoMO(v_InviteRequestWithSdp.SdpOffer, v_CallIdentification);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12, 16");

    // @siclog "Step 17 - 19" siclog@
    f_IMS_CallReleaseMO(v_CallInfo.InviteRequestWithSdp.Invite);
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.21.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_21_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / add video and remove video / without preconditions at both originating UE and terminating UE / 5GS
    var template (omit) IMS_DATA_RSP v_IMS_DATA_RSP;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdpAudio;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdpVideo;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdpAudio;
    var template (value) IMS_SDP_MediaDescriptionRtpList_Type v_MediaDescriptionRtpListAudio;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdpVideo;
    var template (value) SDP_Message v_SdpOffer;
    var SDP_media_desc v_MediaDescrAudio;
    var SDP_attribute v_FmtpAttributeAudio;
    var charstring v_FmtAudio;
    var charstring v_BrVal;
    var charstring v_BwVal;
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParamsAudio;
    var template (present) SDP_Message v_ExpectedSdpAnswer;
    var template (present) IMS_Response_Type v_Response183;
    var IMS_Response_Type v_Response;
    var SDP_Message v_SdpAnswer;
    var charstring v_CallIdentification;

    timer t_Timer := 2.0;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, -, normalCall_ReturnId);

    v_InviteRequestWithSdpAudio := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1();                                                      /* @sic R5-241256: A_4_2a instead of A_4_2 sic@ */
    v_ResponseWithSdpAudio := f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_8(v_InviteRequestWithSdpAudio);                              /* @sic R5-241256: A_4_2a instead of A_4_2 sic@ */
    v_CallIdentification := f_UT_ReceivedIMSCallId(MMI);

    f_IMS_TestBody_Set(true);

    v_MediaDescrAudio := valueof(f_IMS_SDP_MediaList_GetMediaStream(v_ResponseWithSdpAudio.SdpMessage.media_list, c_audio));    /* @sic R5s221127: Get media description from 183 session progress sic@ */
    v_MediaDescriptionRtpListAudio := cs_IMS_SDP_MediaDescriptionRtpList(v_MediaDescrAudio.media_field.fmts, v_MediaDescrAudio.attributes);
    v_SdpOffer := f_IMS_BuildSDP_InitialOfferAddVideo_TX(v_MediaDescriptionRtpListAudio, tsc_IMS_SDP_VideoCodecList_H265_only, tsc_SDP_WithoutPreconditions);

    v_FmtAudio := f_SDP_MediaDescr_GetAudioCodec(v_MediaDescrAudio, EVS_16000);
    v_FmtpAttributeAudio := valueof(f_SDP_AttributeList_GetAttribute(v_MediaDescrAudio.attributes, cr_SDP_Attribute_fmtp(v_FmtAudio)));
    v_BrVal := f_SIP_SemicolonParamList_GetParamValue(v_FmtpAttributeAudio.fmtp.params.paramList, "br");
    v_BwVal := f_SIP_SemicolonParamList_GetParamValue(v_FmtpAttributeAudio.fmtp.params.paramList, "bw");
    v_FmtpParamsAudio := cr_Fmtp_ParamList(cr_EVS_Fmtp_AudioParamsBrBwMaxRed(v_BrVal, v_BwVal));
    v_ExpectedSdpAnswer := f_IMS_BuildSDP_MTCallAudioVideo_RX(AddVideo, InitialAnswer, EVS_16000, v_FmtAudio, v_FmtpParamsAudio, H265_90000, tsc_SDP_WithoutPreconditions); // @sic R5-225423: audio description for 183 Session Progress (step 3a1) or 200 OK (step 3b2) sic@

    f_IMS_IPCAN_Query(IPCAN);           // @sic R5s220939 change 1.1: IPCAN will not send the response before f_NR5GC_IPCAN_MO_SpeechCall (calling f_NR5GC_ModifyPDUSession_AddVoice) has finished sic@

    // @siclog "Step 1" siclog@                 INVITE
    v_InviteRequestWithSdpVideo := f_IMS_MTCallSetup_Video_SendInvite(AddVideo, v_SdpOffer);

    // @siclog "Step 2A" siclog@                Start timer
    t_Timer.start;

    // @siclog "Step 2 - 3a1" siclog@           100 Trying, 183 Session Progress (optional)
    v_Response183 := cr_Response(c_statusLine183,
                                 f_IMS_InviteResponse_183_MessageHeaderRX(v_InviteRequestWithSdpVideo.Invite, -, tsc_OptionTagList_100rel),
                                 cr_MessageBody_SDP);
    v_IMS_DATA_RSP := f_IMS_ReceiveResponse_OptionalTrying_Timeout(t_Timer,
                                                                   v_InviteRequestWithSdpVideo.Invite.msgHeader,
                                                                   v_InviteRequestWithSdpVideo.RoutingInfo.Protocol,
                                                                   v_Response183);
    if (isvalue(v_IMS_DATA_RSP)) {
      v_Response := valueof(v_IMS_DATA_RSP.Response);
      v_SdpAnswer := f_IMS_SIP_SdpMessageBody_DecodeMatchAndCheckSDP(v_Response.messageBody, v_ExpectedSdpAnswer);

      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3a1");
      
      // @siclog "Step 3a2" siclog@             Stop timer
      t_Timer.stop;

      // @siclog "Step 3a3 - 3a4" siclog@       PRACK, 200 OK
      f_IMS_MTCallSetup_SendPRACK_ReceiveOK(v_InviteRequestWithSdpVideo.Invite, v_Response.msgHeader);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3a4");
    
      // @siclog "Step 3a5" siclog@
      f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_MT_AddVideo);
      f_IMS_IPCAN_WaitForTrigger(IPCAN);
      
      // @siclog "Step 3a6 - 3a8" siclog@       MMI (Accept Call), 200 OK, ACK
      f_UT_IMS_AcceptMediaChange(MMI, v_CallIdentification);   // @sic R5s221287 sic@
      f_IMS_MTCallSetup_Receive200OK_SendACK(v_InviteRequestWithSdpVideo);  // @sic R5s221287 sic@
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3a7");
    }
    else {
      // @siclog "Step 3b1" siclog@             MMI (Accept Call)
      f_UT_IMS_AcceptMediaChange(MMI, v_CallIdentification);  // @sic R5s221287 sic@

      // @siclog "Step 3b2" siclog@             200 OK
      v_ResponseWithSdpVideo := f_IMS_MTCallSetup_Receive200OKforINVITE(v_InviteRequestWithSdpVideo, v_ExpectedSdpAnswer);
      v_SdpAnswer := v_ResponseWithSdpVideo.SdpMessage;
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3b2");

      // @siclog "Step 3b3" siclog@
      f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_MT_AddVideo);
      f_IMS_IPCAN_WaitForTrigger(IPCAN);

      // @siclog "Step 3b4" siclog@             ACK
      f_IMS_InviteMT_SendACK(v_InviteRequestWithSdpVideo);
    }

    // @siclog "Step 4 - 7" Void siclog@

    // @siclog "Step 8 - 13" siclog@            MMI (Remove Video), INVITE, 100 Trying, 200 OK, ACK
    f_IMS_VideoCall_NR5GC_ReleaseVideoMO(v_SdpAnswer, v_CallIdentification);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9, 13");

    // @siclog "Step 14 - 16" siclog@           MMI (Release Call), BYE, 200 OK
    f_IMS_CallReleaseMO(v_InviteRequestWithSdpAudio.Invite);
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.22.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_22_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call / add video and remove video / with preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var SDP_Message v_LatestSdpOfferFromUE;
    var template (value) SDP_Message v_LatestSdpAnswerFromSS;
    var charstring v_CallIdentification;
    var boolean v_DontIncrementSessVers := true;
    var charstring v_ContactUrlStrSS;
    var SipUrl v_ContactSipUrlSS;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a();                                         /* @sic R5-232154: f_IMS_MTCallSetup_NR5GC_A_5_1a sic@ */
    v_ContactSipUrlSS := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp.Invite.msgHeader);     /* @sic R5s220500 change 1, R5-222412: get contact from INVITE creating the dialog sic@ */
    v_ContactUrlStrSS := f_SIP_SipUrl2Str(v_ContactSipUrlSS);

    v_CallIdentification := f_UT_GetCallId(MMI);

    f_IMS_TestBody_Set(true);

    f_UT_AddVideoToIMSCall(MMI, v_CallIdentification);

    // @siclog "Step 1" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(AddVideo, v_ContactSipUrlSS, tsc_IMS_SDP_AudioCodecList_EVS_only, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2);    /* @sic R5-231490, R5-230324: EVS_AnyNG114 sic@
                                                                                                                                                                                   @sic R5-232154: EVS_A2 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2 - 3" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(AddVideo, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2, v_ContactUrlStrSS);                                   /* @sic R5-231490, R5-230324: EVS_AnyNG114 sic@
                                                                                                                                                                                   @sic R5-232154: EVS_A2 sic@ */
    // @siclog "Step 4 - 5" siclog@             PRACK, 200 OK
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // @siclog "Step 5A" siclog@
    f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_MO_AddVideo);
      
    // @siclog "Step 6 - 7" siclog@             UPDATE, 200 OK
    v_LatestSdpOfferFromUE := f_IMS_MOCallSetup_NR5GC_Video_Step6_7(AddVideo, v_InviteRequestWithSdp, v_ContactUrlStrSS);
    v_LatestSdpAnswerFromSS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_LatestSdpOfferFromUE, v_DontIncrementSessVers);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");

    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    // @siclog "Step 8 - 9" siclog@             200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp, v_ContactUrlStrSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    // @siclog "Step 10 - 14" siclog@           Release Video
    f_IMS_VideoCall_NR5GC_ReleaseVideoMT(v_LatestSdpAnswerFromSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.23.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_23_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call / add video and remove video / without preconditions at both originating UE and terminating UE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var charstring v_CallIdentification;
    var charstring v_ContactUrlStrSS;
    var SipUrl v_ContactSipUrlSS;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(tsc_SDP_WithoutPreconditions);                        /* @sic R5-241257: EVS_A2 instead of EVS_B0_A1 sic@ */
    v_ContactSipUrlSS := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp.Invite.msgHeader);
    v_ContactUrlStrSS := f_SIP_SipUrl2Str(v_ContactSipUrlSS);
    f_IMS_MTCallSetup_NR5GC_A_5_2a_Step2_10(v_InviteRequestWithSdp);                                                    /* @sic R5-241257: EVS_A2 instead of EVS_B0_A1 sic@ */
    v_CallIdentification := f_UT_GetCallId(MMI);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_UT_AddVideoToIMSCall(MMI, v_CallIdentification);

    // @siclog "Step 2" siclog@                 INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(AddVideo,
                                                            v_ContactSipUrlSS,                                          /* @sic R5s220336 2.5 change 1, R5-222412: v_ContactSipUrlSS sic@ */
                                                            tsc_IMS_SDP_AudioCodecList_EVS_only,
                                                            tsc_IMS_SDP_VideoCodecList_H265_H264,
                                                            EVS_A2,                                                     /* @sic R5-231490, R5-230324: EVS_AnyNG114 sic@ @sic R5-232157: EVS_A2 sic@ */
                                                            tsc_SDP_WithoutPreconditions);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 3 - 4" siclog@             100 Trying, 183 Session Progress
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(AddVideo,
                                                         v_InviteRequestWithSdp,
                                                         EVS_16000,
                                                         H265_90000,
                                                         EVS_A2,                                                        /* @sic R5-231490, R5-230324: EVS_AnyNG114 sic@ */
                                                         v_ContactUrlStrSS);                                            /* @sic R5s220336 2.5 change 1, R5-222099, R5-223453: v_ContactUrlStrSS sic@ */
    // @siclog "Step 5 - 6" siclog@             PRACK, 200 OK
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    // @siclog "Step 6A" siclog@
    f_IMS_IPCAN_StartProcedure(IPCAN, IPCAN_MO_AddVideo);
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
      
    // @siclog "Step 7 - 8" siclog@             200 OK, ACK
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp, v_ContactUrlStrSS);                                  /* @sic R5s220336 2.5 change 1, R5-222099: v_ContactUrlStrSS sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9 - 13" siclog@            Release Video
    f_IMS_VideoCall_NR5GC_ReleaseVideoMT(v_ResponseWithSdp.SdpMessage, tsc_SDP_WithoutPreconditions);                   /* @sic R5s220336: tsc_SDP_WithoutPreconditions sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");

    // @siclog "Step 14 - 16" siclog@           MMI (Release Call), BYE, 200 OK
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, v_ContactSipUrlSS);                                              /* @sic R5s220593 change 1 sic@ */
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.24.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_24_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call / Forking / UE receives CANCEL request for a forked MT voice call / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 8" siclog@
    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 9 - 18" siclog@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10();        // @sic R5-231494: A.5.1a sic@

    // @siclog "Step 19 - 21" siclog@
    f_IMS_MTCallSetup_CancelCall(v_InviteRequestWithSdp.Invite, cs_Reason(200, "Call completed elsewhere"));
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.24a.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_24a_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / Forking / UE receives two preliminary responses and one early dialog termination / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) MessageHeader v_MessageHeader;
    var template (value) SDP_Message v_SdpAnswer;
    var template (present) SDP_Message v_SdpOffer;
    var SipUrl v_ContactUrlUE;
    var charstring v_ToTag2 := f_IMS_GenerateTag("TC_7_24a-Dialog-2");
    var boolean v_RadioBearersEstablished := true;

    timer t_Timer;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 8" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();           // @sic R5-226704: A_4_1 -> A_4_1a sic@
    if (not match(v_InviteRequestWithSdp.Invite.msgHeader.supported, cr_Supported( { "199" } ))) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Supported header field does not contain '199' option tag");
    }

    // @siclog "Step 9 - 20" siclog@
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp);            // @sic R5-226704: A_4_1 -> A_4_1a sic@

    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");                                      // @sic R5-220221 sic@
    f_IMS_PTC_ImsInfo_DialogInit(dialogRemote, v_InviteRequestWithSdp.Invite.msgHeader);  // second dialog
    f_IMS_PTC_ImsInfo_DialogSetLocalTag(v_ToTag2);                                        // second dialog: different To-tag

    // @siclog "Step 21" siclog@                183 Session progress (dialog 2)
    v_MessageHeader := f_IMS_InviteResponse_183_MessageHeaderTX(v_InviteRequestWithSdp.Invite, px_IMS_CalleeContactUri2);
    v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2, 65);     /* @sic R5-226704: EVS_A2 sic@ */
    IMS_Server.send(cas_IMS_DATA_RSP(v_InviteRequestWithSdp.RoutingInfo, cs_Response(c_statusLine183, v_MessageHeader, cs_MessageBody_SDP(v_SdpAnswer))));

    // @siclog "Step 22 - 23B" siclog@
    v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2);           /* Updated offer for 2nd remote UE  @sic R5-226704: EVS_A2 sic@ */
    f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step4_7(IPCAN_MO_SpeechCall, v_InviteRequestWithSdp, v_MessageHeader, v_SdpOffer, -, v_RadioBearersEstablished);   /* @sic R5s220385 Change 1.1 + R5-222101 sic@
                                                                                                                                                                    @sic R5-231508/RP-230602: optional UPDATE / 200 OK sic@ */
    // @siclog "Step 24 - 26" siclog@
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp, px_IMS_CalleeContactUri2);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 25");

    // @siclog "Step 27" siclog@                199 Early Dialog Terminated
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);                                        // @sic R5s220237 change 2 sic@
    v_MessageHeader := f_IMS_BaseResponse_MessageHeaderTX(v_InviteRequestWithSdp.Invite.msgHeader);
    IMS_Server.send(cas_IMS_DATA_RSP(v_InviteRequestWithSdp.RoutingInfo, cs_Response(c_statusLine199, v_MessageHeader)));

    // @siclog "Step 28 - 29" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);                                       // @sic R5s220237 change 3 sic@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp, px_IMS_CalleeContactUri2);           // @sic R5s240396: px_IMS_CalleeContactUri2 sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 29");

    // @siclog "Step 30" siclog@
    t_Timer.start(5.0);
    alt {
      [] IMS_Server.receive(car_IMS_Bye_Request(cr_REGISTER_Request)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Unexpected BYE");
      }
      [] t_Timer.timeout {}
    }

    // @siclog "Step 31 - 32" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 7.24b.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_24b_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MO Voice Call / Forking / UE receives two preliminary responses and one final response / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) MessageHeader v_MessageHeader;
    var template (value) SDP_Message v_SdpAnswer;
    var template (present) SDP_Message v_SdpOffer;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var charstring v_ToTag2 := f_IMS_GenerateTag("TC_7_24b-Dialog-2");
    var template (value) MessageHeader v_MessageHeader200;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (present) MessageHeader v_MessageHeaderACK;
    var template (present) MessageHeader v_MessageHeaderBYE;
    var IMS_DATA_REQ v_IMS_DATA_REQ_Dummy;
    var boolean v_WaitForACK := true;
    var boolean v_WaitForBYE := true;
    var boolean v_RadioBearersEstablished := true;
 
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 9" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();           // @sic R5-225929: A_4_1 -> A_4_1a sic@
    if (not match(v_InviteRequestWithSdp.Invite.msgHeader.supported, cr_Supported( { "199" } ))) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Supported header field does not contain '199' option tag");
    }

    // @siclog "Step 9 - 20" siclog@
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp);            // @sic R5-225929: A_4_1 -> A_4_1a sic@

    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");                                      // @sic R5-221475 sic@
    f_IMS_PTC_ImsInfo_DialogInit(dialogRemote, v_InviteRequestWithSdp.Invite.msgHeader);  // second dialog
    f_IMS_PTC_ImsInfo_DialogSetLocalTag(v_ToTag2);                                        // second dialog: different To-tag

    // @siclog "Step 21" siclog@                183 Session progress (dialog 2)
    v_MessageHeader := f_IMS_InviteResponse_183_MessageHeaderTX(v_InviteRequestWithSdp.Invite, px_IMS_CalleeContactUri2);
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_MessageHeader);
    v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2, 65);     // @sic R5-225929: EVS_A2 sic@
    IMS_Server.send(cas_IMS_DATA_RSP(v_InviteRequestWithSdp.RoutingInfo, cs_Response(c_statusLine183, v_MessageHeader, cs_MessageBody_SDP(v_SdpAnswer))));

    // @siclog "Step 22 - 23B siclog@
    v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2);           // @sic R5-225929: EVS_A2 sic@
    f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step4_7(IPCAN_MO_SpeechCall, v_InviteRequestWithSdp, v_MessageHeader, v_SdpOffer, -, v_RadioBearersEstablished);   /* @sic R5s220385 Change 1.1 + R5-222101 sic@
                                                                                                                                                                    @sic R5-231508/RP-230602: optional UPDATE / 200 OK sic@ */
    // @siclog "Step 24 - 26" siclog@
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp, px_IMS_CalleeContactUri2);

    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);

    // @siclog "Step 27 - 28" siclog@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 28");

    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);

    // @siclog "Step 29" siclog@
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);
    v_MessageHeader200 := f_IMS_OtherResponse_200_MessageHeaderTX(v_InviteRequestWithSdp.Invite.msgHeader, -, -, px_IMS_CalleeContactUri2); /* @sic R5s220385: px_IMS_CalleeContactUri2 sic@ */
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine200, v_MessageHeader200)));

    v_MessageHeaderACK := f_IMS_AckRequest_MessageHeaderRX(v_InviteRequestWithSdp.Invite, c_statusLine200);
    v_MessageHeaderBYE := f_IMS_ByeRequest_MessageHeaderRX(v_InviteRequestWithSdp.Invite);
    while (v_WaitForACK or v_WaitForBYE) {
      alt {     /* @sic R5s220385, R5-222101 sic@ */
        // @siclog "Step 30" siclog@
        [v_WaitForACK] a_IMS_ReceiveRequest(car_IMS_Ack_Request(cr_ACK_Request(v_ContactUrlSS, v_MessageHeaderACK)), v_IMS_DATA_REQ_Dummy) {
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 30");
          v_WaitForACK := false;
        }
        // @siclog "Step 31 - 32" siclog@
        [v_WaitForBYE] a_IMS_ReceiveByeSendOK(-, v_ContactUrlSS, v_MessageHeaderBYE) {
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 31");
          v_WaitForBYE := false;
        }
      }
    }

    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);

    // @siclog "Step 33" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.25.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_25_NR5GC_IMS1() runs on IMS_PTC
  { // MTSI MT Voice Call  without SDP offer in INVITE / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var SDP_Message v_InitialSdpOffer;
    var template (value) SDP_Message v_SdpOffer;
    var template (value) SDP_attribute_list v_PreconditionAttributes;
    var template (present) SDP_Message v_SdpAnswer;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1" siclog@                 Steps 1-8 of generic procedure specified in Table 4.9.16.2.2-1 of TS 38.508-1
    
    // @siclog "Step 2 - 6" siclog@             INVITE, 100 Trying, 183 Session Progress, PRACK, 200 OK
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NoSdpInINVITE_Step1_6(tsc_SDP_WithPreconditions);               /* v_InviteRequestWithSdp contains the INVITE and the SDP offer send by the UE at step 4
                                                                                                                   @sic R5-231495: EVS_A2 sic@ */
    v_InitialSdpOffer := v_InviteRequestWithSdp.SdpOffer;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    // @siclog "Step 7 - 8" siclog@             UPDATE, 200 OK
    v_SdpOffer := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InitialSdpOffer, false, EVS_16000, EVS_A2, 65);        /* the SDP offer for the UPDATE is the same as the answer at step 5 but with the session version being incremented and updated preconditions
                                                                                                                   @sic R5-231495: EVS_A2 sic@ */
    v_PreconditionAttributes := cs_SDP_PreconditionAttributes(c_sendrecv, c_none, c_mandatory, c_mandatory);
    v_SdpOffer.media_list[0].attributes := f_SDP_Attributes_Concat_TX(v_SdpOffer.media_list[0].attributes, v_PreconditionAttributes);
    v_SdpOffer := f_IMS_MTCallSetup_NoSdpInINVITE_SdpAddVideoIfNeeded_TX(v_InitialSdpOffer, v_SdpOffer);        /* @sic R5-220230: sic@
                                                                                                                   if the initial SDP offer sent by the UE has had a video stream, it needs to be kept in all subsequent offers and answers (-> RFC 3264 clause 8) */
    v_SdpAnswer := f_IMS_BuildSDP_FinalAnswerAudio_RX(EVS_16000);
    v_SdpAnswer := f_IMS_MTCallSetup_NoSdpInINVITE_SdpAddVideoIfNeeded_RX(v_InitialSdpOffer, v_SdpAnswer);      /* @sic R5-223460: if initial SDP offer contains video sic@ */

    f_IMS_MTCallSetup_NR5GC_SendUPDATE_Receive200OK(v_InviteRequestWithSdp, v_SdpOffer, v_SdpAnswer);

    // @siclog "Step 9 - 11" siclog@            180 Ringing, PRACK (conditional), 200 OK (conditional)
    f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp, tsc_OptionTagList_100rel);                      /* @sic R5-242754: tsc_OptionTagList_100rel sic@ */

    // @siclog "Step 12 - 15" siclog@           Accept call, 200 OK, ACK
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");

    f_IMS_TestBody_Set(false);

    // Call release and postamble:
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.26.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_26_NR5GC_IMS1() runs on IMS_PTC
  { // Mobile Originating CAT / Forking Model / MO Voice Call / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) MessageHeader v_MessageHeader183;
    var template (present) SDP_Message v_SdpOffer;
    var boolean v_RemoteResourcesEstablished := true;
    var boolean v_RadioBearersEstablished := true;
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2 - 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1_5();         // @sic R5-225930: A_4_1 -> A_4_1a sic@
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);             // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);             // @sic R5-225930: A_4_1 -> A_4_1a sic@
    
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");      // @sic R5-220244 sic@
    f_IMS_PTC_ImsInfo_DialogInit(dialogRemote, v_InviteRequestWithSdp.Invite.msgHeader);
    f_IMS_PTC_ImsInfo_CseqSet(dialogRemote, v_InviteRequestWithSdp.Invite.msgHeader.cSeq.seqNumber);

    // @siclog "Step 9" siclog@
    v_MessageHeader183 := f_IMS_CAT_Send183SessionProgress(v_InviteRequestWithSdp, EVS_16000, EVS_A2);  /* @sic R5s210788 sic@ @sic R5-225930: EVS_A2 sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    // @siclog "Step 10 - 11B" siclog@
    v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(v_InviteRequestWithSdp.SdpOffer, v_RemoteResourcesEstablished, EVS_16000, EVS_A2);  /* @sic R5s210788 sic@ @sic R5-225930: EVS_A2 sic@ */
    f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step4_7(IPCAN_MO_SpeechCall, v_InviteRequestWithSdp, v_MessageHeader183, v_SdpOffer, -, v_RadioBearersEstablished);   /* @sic R5-231508/RP-230602: optional UPDATE / 200 OK sic@ */

    // @siclog "Step 12 - 13" Void siclog@

    // @siclog "Step 14 - 15" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog); // Signalling continues on first dialog
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    // @siclog "Step 16 - 18" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.27.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_27_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MO Voice Call / UE is able to refresh the session / 5GS
    var Method_List v_MethodList := {"INVITE", "UPDATE", "PRACK", "ACK", "OPTIONS", "CANCEL", "BYE"};
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) Allow v_Allow := cs_Allow(v_MethodList);
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeaderInvite;
    var MessageHeader v_MessageHeaderUpdate;
    var SipUrl v_ContactUrlSS;
    var SipUrl v_ContactUrlUE;
    var integer v_DeltaSec := 1800;
    var boolean v_CheckMinSE := true;
    var integer i;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2 - 7" IPCAN siclog@

    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();           // @sic R5-225931: A_4_1 -> A_4_1a sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_MessageHeaderInvite := v_InviteRequest.msgHeader;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    if (not ispresent(v_MessageHeaderInvite.sessionExpires)) {
      v_DeltaSec := 1920;
    } else {
      f_IMS_CallWithSessionTimer_CheckSessionExpires(v_MessageHeaderInvite.sessionExpires, v_DeltaSec, "uac" ifpresent);

      // @siclog "Steps 9a0 - 9a7" siclog@
      for (i := 0; i < 2; i := i + 1) {
        v_DeltaSec := v_DeltaSec + 60;
        f_IMS_CallWithSessionTimer_Send100Send422ReceiveACK(v_InviteRequest, v_RoutingInfo_DL, v_DeltaSec);
        f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9a2/9a6");

        v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();       // @sic R5-225931: A_4_1 -> A_4_1a sic@
        f_IMS_CallWithSessionTimer_CheckInviteAfter422(v_InviteRequestWithSdp, v_DeltaSec);
        f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9a3/9a7");

        v_InviteRequest := v_InviteRequestWithSdp.Invite;
        v_MessageHeaderInvite := v_InviteRequest.msgHeader;
      }
    }
    // @siclog "Steps 10 - 18" siclog@
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp, v_Allow);     // @sic R5-225931: A_4_1 -> A_4_1a sic@
    v_ContactUrlSS := fl_IMS_CC_MO_CallInfo_GetContactUrlSS(v_CallInfo);

    // @siclog "Step 19" siclog@
    f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderInvite, v_RoutingInfo_DL, v_Allow, cs_Require_timer, cs_Supported_timer, cs_SessionExpires(v_DeltaSec, "uac"), cs_MinSE(v_DeltaSec));
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    // @siclog "Step 20" siclog@
    f_IMS_CallWithSessionTimer_ReceiveACK(v_InviteRequest, v_ContactUrlSS);

    // @siclog "Step 21 - 24" siclog@
    for (i := 0; i < 2; i := i + 1) {
      v_IMS_DATA_REQ := f_IMS_CallWithSessionTimer_ReceiveUpdate(v_ContactUrlSS, v_InviteRequest, v_DeltaSec, "uac", v_CheckMinSE);
      v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo);   // @sic R5s220951: get RoutingInfo from latest IMS_DATA_REQ sic@
      v_MessageHeaderUpdate := v_IMS_DATA_REQ.Request.Update.msgHeader;
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21/23");
      f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderUpdate, v_RoutingInfo_DL, -, -, cs_Supported_timer, cs_SessionExpires(v_DeltaSec, "uac"), cs_MinSE(v_DeltaSec));
    }

    // @siclog "Step 25 - 26" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.28.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_28_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MO Voice Call / Remote end is refresher / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeaderInvite;
    var template (value) MessageHeader v_MessageHeaderUpdate;
    var InternetProtocol_Type v_Protocol;
    var template (omit) Contact v_ContactSS;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var integer v_DeltaSec := 1800;
    var template charstring v_Refressher := omit;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    // @siclog "Step 2 - 7" IPCAN siclog@

    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();                           // @sic R5-225932: A_4_1 -> A_4_1a sic@
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_MessageHeaderInvite := v_InviteRequest.msgHeader;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    if (ispresent(v_MessageHeaderInvite.sessionExpires)) {
      f_IMS_CallWithSessionTimer_CheckSessionExpires(v_MessageHeaderInvite.sessionExpires, v_DeltaSec, v_Refressher);
    }
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Steps 9 - 17" siclog@
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp);              // @sic R5-225932: A_4_1 -> A_4_1a sic@
    v_ContactSS := v_CallInfo.MessageHeader183.contact;
    v_ContactUrlSS := fl_IMS_CC_MO_CallInfo_GetContactUrlSS(v_CallInfo);

    // @siclog "Step 18" siclog@
    f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderInvite, v_RoutingInfo_DL, -, cs_Require_timer, cs_Supported_timer, cs_SessionExpires(v_DeltaSec, "uas"));

    // @siclog "Step 19" siclog@
    f_IMS_CallWithSessionTimer_ReceiveACK(v_InviteRequest, v_ContactUrlSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Step 20" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    v_RoutingInfo_DL := cs_IMS_RoutingInfo(v_Protocol);     /* @sic R5s200206 change 2.2.1 sic@ */
    v_MessageHeaderUpdate := f_IMS_CallWithSessionTimer_SendUpdateAfterHalfDeltaSec(v_InviteRequest, v_RoutingInfo_DL, v_ContactSS, v_ContactUrlUE, v_DeltaSec, "uac");

    // @siclog "Step 21" siclog@
    f_IMS_CallWithSessionTimer_Receive200OK(v_Protocol, v_MessageHeaderUpdate, cr_Require_timer, -, v_DeltaSec, "uac");
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21");

    // @siclog "Steps 22 - 23" siclog@
    f_IMS_CallWithSessionTimer_MOCallRelease(v_InviteRequest, v_ContactUrlSS, v_DeltaSec);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.29.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_29_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MO Voice Call / Remote end does not support Session Timer / 5GS
    var Method_List v_MethodList := {"INVITE", "UPDATE", "PRACK", "ACK", "OPTIONS", "CANCEL", "BYE"};
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) Allow v_Allow := cs_Allow(v_MethodList);
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeaderInvite;
    var MessageHeader v_MessageHeaderUpdate;
    var SipUrl v_ContactUrlSS;
    var SipUrl v_ContactUrlUE;
    var integer v_DeltaSec := 1800;
    var integer i;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // @siclog "Step 2 - 7" IPCAN siclog@

    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();                           // @sic R5-225933: A_4_1 -> A_4_1a sic@
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_MessageHeaderInvite := v_InviteRequest.msgHeader;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    if (ispresent(v_MessageHeaderInvite.sessionExpires)) {
      f_IMS_CallWithSessionTimer_CheckSessionExpires(v_MessageHeaderInvite.sessionExpires, v_DeltaSec, "uac" ifpresent);
    }
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Steps 9 - 17" siclog@
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp, v_Allow);     // @sic R5-225933: A_4_1 -> A_4_1a; v_Allow added sic@
    v_ContactUrlSS := fl_IMS_CC_MO_CallInfo_GetContactUrlSS(v_CallInfo);

    // @siclog "Step 18" siclog@
    f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderInvite, v_RoutingInfo_DL, v_Allow);

    // @siclog "Step 19" siclog@
    f_IMS_CallWithSessionTimer_ReceiveACK(v_InviteRequest, v_ContactUrlSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Steps 20 - 23" siclog@
    for (i := 0; i < 2; i := i + 1) {
      v_IMS_DATA_REQ := f_IMS_CallWithSessionTimer_ReceiveUpdate(v_ContactUrlSS, v_InviteRequest, v_DeltaSec, "uac");
      v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo);                 // @sic R5s220951: get RoutingInfo from latest IMS_DATA_REQ sic@
      v_MessageHeaderUpdate := v_IMS_DATA_REQ.Request.Update.msgHeader;
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20/22");
      f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderUpdate, v_RoutingInfo_DL);
    }

    // @siclog "Step 24 - 25" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.30.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_30_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MO Voice Call / Remote end supports but does not use Session Timer / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeaderInvite;
    var SipUrl v_ContactUrlSS;
    var SipUrl v_ContactUrlUE;
    var integer v_DeltaSec := 1800;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // @siclog "Step 2 - 7" IPCAN siclog@

    // @siclog "Step 8" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();                           // @sic R5-225934: A_4_1 -> A_4_1a sic@
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_MessageHeaderInvite := v_InviteRequest.msgHeader;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    if (ispresent(v_MessageHeaderInvite.sessionExpires)) {
      f_IMS_CallWithSessionTimer_CheckSessionExpires(v_MessageHeaderInvite.sessionExpires, v_DeltaSec, "uac" ifpresent);
    }
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Steps 9 - 17" siclog@
    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_10(v_InviteRequestWithSdp);              // @sic R5-225934: A_4_1 -> A_4_1a sic@
    v_ContactUrlSS := fl_IMS_CC_MO_CallInfo_GetContactUrlSS(v_CallInfo);

    // @siclog "Step 18" siclog@
    f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderInvite, v_RoutingInfo_DL, -, -, cs_Supported_timer);

    // @siclog "Step 19" siclog@
    f_IMS_CallWithSessionTimer_ReceiveACK(v_InviteRequest, v_ContactUrlSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Step 20 - 21" siclog@
    f_Delay(int2float(1860));
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.31.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_7_31_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MT Voice Call / Remote end supports but does not send Session-Expires / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var SipUrl v_ContactUrlSS;
    var SipUrl v_ContactUrlUE;
    var IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) MessageHeader v_MessageHeaderUpdate;
    var integer v_DeltaSec := 1800;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1 - 8" IPCAN siclog@

    // @siclog "Step 9 - 18A" IPCAN siclog@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A();                        // @sic R5-231496: steps 1 - 10 of A.5.1a; R5s230345: steps 1 - 10A sic@
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_InviteRequest.msgHeader);
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_RoutingInfo_DL := v_InviteRequestWithSdp.RoutingInfo;

    // @siclog "Steps 19 - 20" siclog@
    f_IMS_MTCallSetupWithSessionTimer_Receive200OK_SendACK(v_InviteRequestWithSdp, cr_Require_timer, -, v_DeltaSec, "uac");
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Step 21" siclog@
    v_MessageHeaderUpdate := f_IMS_CallWithSessionTimer_SendUpdateAfterHalfDeltaSec(v_InviteRequest, v_RoutingInfo_DL, -, v_ContactUrlUE, v_DeltaSec, "uac");

    // @siclog "Step 22" siclog@
    f_IMS_CallWithSessionTimer_Receive200OK(v_RoutingInfo_DL.Protocol, v_MessageHeaderUpdate, cr_Require_timer, -, v_DeltaSec, "uac");  // @sic R5s210450: cr_Supported_timer removed sic@ @sic R5-213533: cr_Require_timer added sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    // @siclog "Steps 23 - 24" siclog@
    f_IMS_CallWithSessionTimer_MOCallRelease(v_InviteRequest, v_ContactUrlSS, v_DeltaSec);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.32.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_7_32_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MT Voice Call / Remote end sends Session-Expires but does not choose refresher / 5GS
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var SipUrl v_ContactUrlUE;
    var IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) MessageHeader v_MessageHeaderUpdate;
    var integer v_DeltaSec := 1800;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1 - 8" IPCAN siclog@

    // @siclog "Step 9 - 18A" IPCAN siclog@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A(cs_SessionExpires(v_DeltaSec));   // @sic R5-231497: steps 1 - 10 of A.5.1a; R5s230345: steps 1 - 10A sic@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_RoutingInfo_DL := v_InviteRequestWithSdp.RoutingInfo;

    // @siclog "Steps 19 - 20" siclog@
    f_IMS_MTCallSetupWithSessionTimer_Receive200OK_SendACK(v_InviteRequestWithSdp, cr_Require_timer, -, v_DeltaSec, "uac");
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Step 21" siclog@
    v_MessageHeaderUpdate := f_IMS_CallWithSessionTimer_SendUpdateAfterHalfDeltaSec(v_InviteRequestWithSdp.Invite, v_RoutingInfo_DL, -, v_ContactUrlUE, v_DeltaSec, "uac");

    // @siclog "Step 22" siclog@
    f_IMS_CallWithSessionTimer_Receive200OK(v_RoutingInfo_DL.Protocol, v_MessageHeaderUpdate, cr_Require_timer, -, v_DeltaSec, "uac");  // @sic R5s210467: cr_Supported_timer removed sic@  @sic R5-213533: cr_Require_timer added sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    // @siclog "Step 23 - 24" siclog@
    f_IMS_CallReleaseMT(v_ContactUrlUE);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.33.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_33_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MT Voice Call / Remote end chooses UE as refresher / 5GS
    var Method_List v_MethodList := {"INVITE", "ACK", "OPTIONS", "CANCEL", "BYE"};
    var template (value) IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var integer v_DeltaSec := 1800;
    var integer i;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1 - 8" IPCAN siclog@

    // @siclog "Step 9" siclog@  @sic R5-213545: A.5.2 instead of A.5.1 sic@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_BuildInviteRequestWithSdp(tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, EVS_A2, tsc_SDP_WithoutPreconditions);   /* @sic R5-236899: EVS_A2 instead of EVS_B0_A1 sic@ */
    v_InviteRequestWithSdp.Invite.msgHeader.sessionExpires := cs_SessionExpires(v_DeltaSec, "uas");
    v_InviteRequestWithSdp.Invite.msgHeader.allow := cs_Allow(v_MethodList);
    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequestWithSdp.Invite));
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp.Invite.msgHeader);

    // @siclog "Step 10 - 16" IPCAN siclog@
    f_IMS_MTCallSetup_NR5GC_A_5_2a_Step2_8(valueof(v_InviteRequestWithSdp));    // @sic R5-213545: A.5.2 instead of A.5.1 sic@ @sic R5-236899: EVS_A2 instead of EVS_B0_A1 sic@

    // @siclog "Steps 17" siclog@
    f_UT_AnswerCall(MMI);

    // @siclog "Steps 18" Void siclog@

    // @siclog "Steps 19 - 20" siclog@
    f_IMS_MTCallSetupWithSessionTimer_Receive200OK_SendACK(valueof(v_InviteRequestWithSdp), -, -, v_DeltaSec, "uas");   /* @sic R5s210678 change 1: cr_Supported_timer instead of cr_Require_timer sic@
                                                                                                                           @sic R5-214450: cr_Supported_timer removed sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Steps 21 - 26" siclog@
    for (i := 0; i < 2; i := i + 1) {
      f_IMS_CallWithSessionTimer_MORefresh(v_ContactUrlSS, cs_Require_timer, -, v_DeltaSec, "uac");  /* @sic R5-210124: common function sic@
                                                                                                        @sic R5s210678 change 2: cs_Require_timer as parameter sic@ */
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21/24");
    }

    // @siclog "Step 27 - 28" siclog@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 7.34.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_7_34_NR5GC_IMS1() runs on IMS_PTC
  { // Session Timer / MT Voice Call / Remote end does not support Session Timer / 5GS
    var Method_List v_MethodList := {"INVITE", "UPDATE", "PRACK", "ACK", "OPTIONS", "CANCEL", "BYE"};
    var OptionTag_List v_OptionTagsForSupported := tsc_OptionTagList_100rel & tsc_OptionTagList_precondition;   // no 'timer'
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var MessageHeader v_MessageHeaderUpdate;
    var integer v_DeltaSec := 1800;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    f_IMS_CC_StartCall(IPCAN_MT_SpeechCall);

    // @siclog "Step 1 - 8" IPCAN siclog@

    // @siclog "Step 9 - 18" IPCAN siclog@
    v_InviteRequestWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_10A(-, cs_Allow(v_MethodList), v_OptionTagsForSupported);    // @sic R5-231498: steps 1 - 10A of A.5.1a sic@
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_InviteRequest.msgHeader);
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_RoutingInfo_DL := v_InviteRequestWithSdp.RoutingInfo;

    // @siclog "Steps 19 - 20" siclog@
    f_IMS_MTCallSetupWithSessionTimer_Receive200OK_SendACK(v_InviteRequestWithSdp, -, -, v_DeltaSec, "uas");
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    // @siclog "Step 21" siclog@
    v_IMS_DATA_REQ := f_IMS_CallWithSessionTimer_ReceiveUpdate(v_ContactUrlSS, v_InviteRequest, v_DeltaSec, "uac");
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo);   // @sic R5s220951: get RoutingInfo from latest IMS_DATA_REQ sic@
    v_MessageHeaderUpdate := v_IMS_DATA_REQ.Request.Update.msgHeader;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21");

    // @siclog "Step 22" siclog@
    f_IMS_CallWithSessionTimer_Send200OK(v_MessageHeaderUpdate, v_RoutingInfo_DL, -, -, -, -, -, f_SIP_SipUrl2Str(v_ContactUrlSS));   /* @sic R5s240677: f_SIP_SipUrl2Str(v_ContactUrlSS) sic@ */

    // @siclog "Step 16 - 19" siclog@
    f_IMS_CallReleaseMT(v_ContactUrlUE);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

}
