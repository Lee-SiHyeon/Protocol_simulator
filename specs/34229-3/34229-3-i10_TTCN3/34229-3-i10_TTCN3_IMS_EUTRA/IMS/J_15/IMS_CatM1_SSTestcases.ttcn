module IMS_CatM1_SSTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_15 all;
  import from IMS_CommonDefs all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.15.1
   * @status    APPROVED (IMS)
   */
  function f_TC_J_15_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CW_Answering(tsc_IMS_SDP_AudioCodecList_AMR_only);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.15.2
   * @status    APPROVED (IMS)
   */
  function f_TC_J_15_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_CW_Cancelling(tsc_IMS_SDP_AudioCodecList_AMR_only);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.15.3
   * @status    APPROVED (IMS)
   */
  function f_TC_J_15_3_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL);

    f_IMS_Subscription_MWI_Event_Package_4G();

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.15.4
   * @status    APPROVED (IMS)
   */
  function f_TC_J_15_4_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MOCallwithOIR(tsc_IMS_SDP_AudioCodecList_AMR_only);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause J.15.6
   * @status    APPROVED (IMS)
   */
  function f_TC_J_15_6_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MO_ComunicationForwardingOnNonReply_C21(tsc_IMS_SDP_AudioCodecList_AMR_only);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
