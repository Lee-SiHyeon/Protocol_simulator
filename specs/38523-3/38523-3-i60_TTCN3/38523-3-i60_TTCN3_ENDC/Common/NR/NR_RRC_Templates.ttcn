  /*
   * @desc      Return periodicityAndOffset included in SchedulingRequestResourceConfig acc to 38.508-1 Table 4.6.3-157: SchedulingRequestResourceConfig
   * @param     p_SubcarrierSpacing
   * @param     p_SatelliteType     (default value: ntn_None)
   * @return    template (value) SchedulingRequestResourceConfig.periodicityAndOffset
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ReturnPeriodicityAndOffset(SubcarrierSpacing p_SubcarrierSpacing,
                                           NTN_Satellite_Type p_SatelliteType := ntn_None
                                           ) return template (value) SchedulingRequestResourceConfig.periodicityAndOffset
  {
    var template (value) SchedulingRequestResourceConfig.periodicityAndOffset v_PeriodicityAndOffset;
    //@sic R5s250100 R5-253086: added p_SatelliteType  sic@
    //As per 38.508-1 Table 4.6.3-157: SchedulingRequestResourceConfig
    select (p_SubcarrierSpacing) {
      case(kHz15)  {
        if (p_SatelliteType == ntn_GSO) { //@sic R5s250100 R5-253086 sic@
          v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl640;  // sl640 := 639
        } else {
          v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl10;
        }
      }
      case(kHz30)  { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl20; }
      case(kHz120) { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl80; }
      case else    { FatalError(__FILE__, __LINE__, "SCS value not handled in TTCN"); }
    }
    return v_PeriodicityAndOffset;
  }

  /*
   * @desc      Return periodicityAndOffset included in SchedulingRequestResourceConfig acc to 38.523-1 Table 7.1.1.3.1.3.3-13: SchedulingRequestResourceConfig
   * @param     p_SubcarrierSpacing
   * @return    template (value) SchedulingRequestResourceConfig.periodicityAndOffset
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_ReturnPeriodicityAndOffset_5_4(SubcarrierSpacing p_SubcarrierSpacing) return template (value) SchedulingRequestResourceConfig.periodicityAndOffset
  {//@sic R5s200412 R5-201637 sic@
    var template (value) SchedulingRequestResourceConfig.periodicityAndOffset v_PeriodicityAndOffset;

    //As per 38.508-1 Table 4.6.3-157: SchedulingRequestResourceConfig
    select (p_SubcarrierSpacing) {
      case(kHz15)  { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl10_5; }
      case(kHz30)  { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl20_5; }
      case(kHz120) { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl80_4; }
      case else    { FatalError(__FILE__, __LINE__, "SCS value not handled in TTCN"); }
    }
    return v_PeriodicityAndOffset;
  }

  /*
   * @desc      Return multiplePHR field as per 38.508-1 Table 4.6.3-104: PHR-Config
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_ReturnMultiplePHR () return boolean
  { //@sic R5s190446 R5-197245 sic@
    if (f_GetTestcaseAttrib_ENDC(testcasename())) { //UL CA: initialised later
        return true;
    } else {
        return false;
    }
  }

  /*
   * @desc      Convert the SSB_Index to bitstring
   * @param     p_SSB_Index
   * @param     p_BitstringLength
   * @return    bitstring
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ConvertSSB_IndexToBit ( SSB_Index p_SSB_Index,
                                        integer p_BitstringLength) return bitstring
  {
    var bitstring v_SSB_IndexBit := ''B; //@sic R5s200546 sic@
    var integer i;
    for (i:=0; i<p_BitstringLength; i:=i+1){
        v_SSB_IndexBit[i]:='0'B
    }
    v_SSB_IndexBit[p_SSB_Index] := '1'B;
    return v_SSB_IndexBit;
  }

  /*
   * @desc      Return the AM SN field length according to TS 38.508-1 Table 4.6.3-149: RLC-Config
   * @return    SN_FieldLengthAM
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR_38508_SetSNFieldLengthAM() return SN_FieldLengthAM
  { //@sic R5-227518 R5-246598 sic@
    if (f_GetTestcaseAttrib_ENDC(testcasename()) or not( f_NR_SupportOfRedCap()) ) {
        return size18;
    } else {
        return size12;
    }
  }

  /*
   * @desc      Return the pdcp-SN-Size-UL field according to TS 38.508-1 Table 4.6.3-99: PDCP-Config
   * @return    NR_PDCP_SN_UL_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_38508_SetPDCP_SN_UL() return NR_PDCP_SN_UL_Type
  { //@sic R5-227518 R5-246598 sic@
    if ( f_GetTestcaseAttrib_ENDC(testcasename()) or not(f_NR_SupportOfRedCap())) {
        return len18bits;
    } else {
        return len12bits;
    }
  }

  /*
   * @desc      Return the pdcp-SN-Size-DL field according to TS 38.508-1 Table 4.6.3-99: PDCP-Config
   * @return    NR_PDCP_SN_DL_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_38508_SetPDCP_SN_DL() return NR_PDCP_SN_DL_Type
  { //@sic R5-246598 sic@
    if ( f_GetTestcaseAttrib_ENDC(testcasename()) or not(f_NR_SupportOfRedCap())) {
        return len18bits;
    } else {
        return len12bits;
    }
  }

  /*
   * @desc      Return PUCCH resource as acc to 38.508-1 Table 4.6.3-157: SchedulingRequestResourceConfig
   * @return    PUCCH_ResourceId
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitSchedulingRequestResource() return PUCCH_ResourceId
  { //@sic R5-235279 sic@
    var PUCCH_ResourceId v_PUCCH_ResourceId := 0;
    if (not(pc_twoPUCCH_AnyOthersInSlot)) {
        v_PUCCH_ResourceId := 6;
    }
    return v_PUCCH_ResourceId;
  };

   /*
   * @desc      determine if any flavour of RedCap is supported
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SupportOfRedCap() return boolean
  { //@sic R5-256674 sic@
    if (pc_supportOfRedCap_r17 or pc_supportOfERedCap_r18) {return true} else {return false};
  }

}
