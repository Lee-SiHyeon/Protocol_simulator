module RRC_ConnEst_R12 {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_CommonTestcaseFunctions all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_DRB_Templates all;
  import from EUTRA_IdleMode all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_LoopBack all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_ASP_L2DataDefs all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_RRC_Templates all;
  import from EUTRA_Paging all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;
  import from EUTRA_SecurityFunctions all;
  import from EUTRA_SecuritySteps all;
  import from EUTRA_SysInfo_Templates all;
  import from LoopbackIP all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.2.5a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_8_1_2_5a_EUTRA() runs on EUTRA_PTC
  { /* RRC connection establishment / 0% access probability for MO data, no restriction for MO signalling / AC-Barring per PLMN */

    var template (value) CellPowerList_Type v_CellPowerList_AtT1;
    var float v_TimerValue;
    var NAS_MSG_Indication_Type v_NasInd;
    var PDCP_SDUList_Type v_PDCP_SDUList_DRB1 := { f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE()) };

    f_EUTRA_Init(c1);

    //Set cell power level for cell 1 and 11 to be used at creation
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell11, -79);

    //Create and configure cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell11);
    
                                      
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1); //@sic R5-253053 sic@
    
    
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell11,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);  //@sic R5-253053 sic@
    // Preamble
    f_EUTRA_Preamble(eutra_Cell1, STATE2A_TESTLOOP_ModeB);
    f_EUTRA_RbEst_Def(eutra_Cell1);
    f_EUTRA_CloseUE_TestLoopModeB(eutra_Cell1, '05'O);
    f_EUTRA_RRC_ConnectionRelease( eutra_Cell1); //@sic R5s250379 sic@
    

    f_EUTRA_TestBody_Set(true);

    //@siclog "Step 1" siclog@
    //The SS changes configures SystemInformationBlockType2 parameters to 0% access probability for MO Data
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell11, 1, omit, omit, omit, cs_AC_BarringConfig(p00, s128, '11111'B));
    f_EUTRA_ModifySysinfo(eutra_Cell11); //@sic R5s250379 sic@

    //@siclog "Step 2 - Void" siclog@
    //@sic R5-253053 sic@

    
    //@siclog "Step 3" siclog@
    //The SS changes Cell 1 and Cell 11 level according to the row "T1" in table 8.1.2.5a.3.2-1.
    v_CellPowerList_AtT1 := {
      cs_CellPower(eutra_Cell11, -79)
    };
    f_EUTRA_SetCellPowerList(v_CellPowerList_AtT1);
    
    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest on Cell 11?
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell11, cr_EstablishmentCause_MoSignalling);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.2.5a Step 4");
   
    //@siclog "Steps 5-8A" siclog@
    //Steps 2 to 6 of the generic test procedure in TS 36.508 [18] subclause 6.4.2.7 are performed on Cell 11.
    //Note: The UE performs a TAU procedure and the RRC connection is released.
    f_EUTRA_TrackingAreaUpdate_WithoutRrcConnReq (eutra_Cell11);
    
    //@siclog "Steps 8B" siclog@
    //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state
    //@sic R5-253053 sic@
    f_Delay(5.0);
      
    //@siclog "Steps 8C" siclog@
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed on Cell 11.
    //NOTE: The UE performs the establishment of the new data radio bearer associated with the default EPS bearer context.
    //@sic R5-253053 sic@
    f_EUTRA_RbEst_Def(eutra_Cell11);

    //@siclog "Step 9" siclog@
    //The SS transmits one IP packet to the UE on the DRB associated with the default EPS bearer context on Cell 11.
    DRB.send(cas_DRB_COMMON_REQ_PDCP_SDU(eutra_Cell11, tsc_RbId_DRB1, cs_TimingInfo_Now, v_PDCP_SDUList_DRB1));
    
    //@siclog "Step 10" siclog@
    //Wait for 1 s after the IP packet has been transmitted in step 9. (Note 3)
    f_Delay(1.0);
    
    //@siclog "Step 11" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 11.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell11);
    
    //@siclog "Step 12" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message on Cell 11 within 30s?
    v_TimerValue := 30.0;
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell11, v_TimerValue)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.1.2.5a Step 12");
    }
    
    //@siclog "Step 13" siclog@
    //SS changes SIB2 according to TS 36.508, table 4.4.3.3-1 and transmits a Paging message including systemInfoModification. The systemInfoValueTag in the SystemInformationBlockType1 is increased
   // f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Video (eutra_Cell11, omit);
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell11,1,-, -, -, omit);  //@sic R5s250379 sic@
    f_EUTRA_ModifySysinfo(eutra_Cell11);
    
    //@siclog "Step 14" siclog@
    //Wait for 15 s (Note 2) to allow the new system information to take effect.
    f_Delay(15.0);
    
    //@siclog "Step 15" siclog@
    //Wait for 167 s (Note 4) to make the Tbarring expire
    f_Delay(167.0);
    
    //@siclog "Step 16" siclog@
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed on Cell 11.
    //NOTE: The UE performs the establishment of the new data radio bearer associated with the default EPS bearer context.
    f_EUTRA_RbEst_Def(eutra_Cell11);
    
    //@sic R5s250379 sic@
    //@siclog "Steps 16A - 16D" siclog@
    f_EUTRA_OpenUE_TestLoopMode(eutra_Cell11);
    f_EUTRA_CloseUE_TestLoopModeB(eutra_Cell11, '05'O);

    
    //@siclog "Step 17" siclog@
    //The SS transmits one IP packet to the UE on the DRB associated with the default EPS bearer context on Cell 11.
    DRB.send(cas_DRB_COMMON_REQ_PDCP_SDU(eutra_Cell11, tsc_RbId_DRB1, cs_TimingInfo_Now, v_PDCP_SDUList_DRB1));
    
    //@siclog "Step 18" siclog@
    //Wait for 1 s for the UE to enter E-UTRA RRC_IDLE state.
    f_Delay(1.0);
    
    //@siclog "Step 19" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 11.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell11);
    
    //@siclog "Step 20" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message on Cell 11 within 30s?
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell11, cr_EstablishmentCause_MoData);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.2.5a Step 20");
    
    //@siclog "Step 21-27" siclog@
    //Steps 3 to 10 generic test procedure in TS 36.508 subclause 6.4.2.2 are performed.
    //@sic R5s250379 sic@
    f_EUTRA_RRC_ConnectionSetup_Def(eutra_Cell11);
    
    v_NasInd := f_EUTRA_RRCConnectionSetupComplete_Def(eutra_Cell11,
                                                       cr_508_RRCConnectionSetupComplete(tsc_RRC_TI_Def, ?),
                                                       cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                                         cr_508_SERVICE_REQUEST(f_EUTRA_SecurityKSIasme_Get())));
                                                                         
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell11, tsc_RRC_TI_Def,v_NasInd.SecurityProtection.NasCount);
    
    //@siclog "Steps 28 - 29" siclog@
    //The UE loop backs the IP packet received in step 18 on the DRB associated with the default EPS bearer context on Cell 11.
    interleave {  //@sic R5s250379 sic@
      [] SRB.receive(car_SRB1_RrcPdu_IND(eutra_Cell11, cr_508_RRCConnectionReconfigurationComplete(tsc_RRC_TI_Def))) {}
      [] DRB.receive (car_DRB_COMMON_IND_PDCP_SDUList(eutra_Cell11, tsc_RbId_DRB1, ?, v_PDCP_SDUList_DRB1)) {}
    }

    
    f_EUTRA_TestBody_Set(false);

    //Switch off UE and expect Detach Request
    f_EUTRA_Postamble(eutra_Cell11, E3_TESTMODE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.2.7a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_8_1_2_7a_EUTRA() runs on EUTRA_PTC
  { /*  RRC Connection establishment / 0% access probability for AC 0 to 9, AC 10 is barred, AC 11 to 15 are not barred, access for UE with access class in the range 11 to 15 is allowed / AC-Barring per PLMN  */

    f_EUTRA_Init(c1);

    //Set cell power level for cell 1 and 11 to be used at creation
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell11, -79);

    //Create and configure cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell11);
    
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_001_02 //PLMNid 2 (index 1)
                                      );
    
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell11,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_001_02 //PLMNid 2 (index 1)
                                      );
                                       
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, omit, omit, cs_AC_BarringConfig(p00, s4, '00000'B), cs_AC_BarringConfig(p00, s4, '00000'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell1);
    
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell11, 1, omit, omit, cs_AC_BarringConfig(p00, s4, '00000'B), cs_AC_BarringConfig(p00, s4, '00000'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell11);
    
    
    f_UT_USIM_Insert(UT, "USIM set as per 36.523-1 Table 8.1.2.7a.3.1-2");
    
    // The UE is in state Switched OFF
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_UE_Detach_SwitchOffUe(eutra_Cell1, RRC_IDLE);

    f_EUTRA_TestBody_Set(true);

    fl_TC_8_1_2_7a_TestBody();
   
    f_EUTRA_TestBody_Set(false);

    //UE is switched off (powered off) and detached
    f_EUTRA_Postamble (eutra_Cell11, E1_IDLE); //@sic R5s250160 sic@

    f_UT_USIM_Remove(UT);
    f_UT_USIM_Insert(UT, "Default USIM");
  }

  /*
   * @desc      test body of TC_8_1_2_7a
   * @status    APPROVED (LTE_A_R12)
   */
  function fl_TC_8_1_2_7a_TestBody() runs on EUTRA_PTC
  {

    var template (value) CellPowerList_Type v_CellPowerList_AtT0 := {
                                                                      cs_CellPower(eutra_Cell11, -91)
                                                                     };
    var template (value) CellPowerList_Type v_CellPowerList_AtT1 := {
                                                                      cs_CellPower(eutra_Cell11, -79)
                                                                     };
    var EUTRA_SecurityParams_Type v_AuthParams;
    var NAS_MSG_Indication_Type v_NasInd;
    var O4_Type v_NasCountUL;
    var NAS_KsiValue v_KsiValue;
    var template (value) EUTRA_FDD_TDD_CellInfo_Type v_EUTRA_FDD_TDD_Info;
    var template (value) PhysicalConfigDedicated_AntennaInfo_Type v_AntennaInfo;
    var PDCP_SDUList_Type v_PDCP_SDUList_DRB1 := { f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE(), f_LoopbackModeB_IP_Address_NW()) };

    //Get FDD or TDD mode from Cell-configuration
    v_EUTRA_FDD_TDD_Info := f_EUTRA_CellInfo_GetFDD_TDD_Info(eutra_Cell1);
    v_AntennaInfo := f_EUTRA_CellInfo_GetAntennaInfoDedicated (eutra_Cell1);
   
    //@siclog "Step 1" siclog@
    //The SS changes Cell 1 and Cell 11 level according to the row "T0" in table 8.1.2.7a.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_AtT0);

    //@siclog "Step 2" siclog@
    //The UE is switched on and brought to state Loop Back Activated (state 4) with condition UE TEST LOOP MODE B on Cell 1 according to [18].
    f_UT_SwitchOnUE(UT); //@sic R5s250160 sic@
    f_EUTRA_InitialRegistration(eutra_Cell1, PREAMBLE, STATE2A_TESTLOOP_ModeB, NORMAL);
    f_EUTRA_RbEst_Def(eutra_Cell1);
    f_EUTRA_CloseUE_TestLoopModeB(eutra_Cell1, '0A'O);
    
    //@siclog "Step 3" siclog@
    //The SS transmits one IP packet to the UE on the DRB associated with the default EPS bearer context on Cell 1.
    DRB.send(cas_DRB_COMMON_REQ_PDCP_SDU(eutra_Cell1, tsc_RbId_DRB1, cs_TimingInfo_Now, v_PDCP_SDUList_DRB1));
    
    //@siclog "Step 4" siclog@
    //Wait for 1 s after the IP packet has been transmitted in step 3. (Note 1)
    f_Delay(1.0);

    //@siclog "Step 5" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 1.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);

    v_AuthParams := f_EUTRA_Security_Get();
    
    //@siclog "Step 6" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message on the Cell 1?
    v_KsiValue := f_EUTRA_SecurityKSIasme_Get();
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_HighPriorityAccess);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.2.7a Step 6");
    
    //@siclog "Step 7" siclog@
    //The SS transmits an RRCConnectionSetup message on Cell 1.
    f_EUTRA_RRC_ConnectionSetup_Def(eutra_Cell1);
    
    //@siclog "Step 8" siclog@
    //The UE transmits an RRCConnectionSetupComplete message on Cell 1. This message includes a SERVICE REQUEST message.
    v_NasInd := f_EUTRA_RRCConnectionSetupComplete_Def(eutra_Cell1,
                                                       cr_508_RRCConnectionSetupComplete(tsc_RRC_TI_Def, ?),
                                                       cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                                         cr_508_SERVICE_REQUEST(v_KsiValue)));
    
    v_NasCountUL := v_NasInd.SecurityProtection.NasCount;
    
    //@siclog "Step 9" siclog@
    //The SS transmits a SecurityModeCommand message on Cell 1.
    //@siclog "Step 10" siclog@
    //The UE transmits a SecurityModeComplete message on Cell 1.
    v_AuthParams := f_EUTRA_RRC_ActivateSecurity(eutra_Cell1, v_AuthParams, v_NasCountUL);
    f_EUTRA_Security_Set(v_AuthParams);

    //@siclog "Step 11" siclog@
    //The SS transmits an RRCConnectionReconfiguration message on Cell 1.
    SRB.send(cas_SRB1_RrcPdu_REQ(eutra_Cell1,
                                 cs_TimingInfo_Now,
                                 cs_RRCConnectionReconfiguration_SRB2_1AM_DRB_Est(tsc_RRC_TI_Def,
                                                                                  v_EUTRA_FDD_TDD_Info.cqi_ReportConfig,
                                                                                  v_EUTRA_FDD_TDD_Info.soundingRS_UL_Config,
                                                                                  v_AntennaInfo)));

    //EXCEPTION: Steps 12 and 13 can occur in any order.
    //@siclog "Step 12 -13" siclog@
    //The UE transmits an RRCConnectionReconfigurationComplete message on Cell 1.
    //UE loop backs the IP packet received in step 0 on the DRB associated with the default EPS bearer context on Cell 1.
    interleave {
      [] SRB.receive(car_SRB1_RrcPdu_IND(eutra_Cell1, cr_508_RRCConnectionReconfigurationComplete(tsc_RRC_TI_Def))) {}
      [] DRB.receive (car_DRB_COMMON_IND_PDCP_SDUList(eutra_Cell1, tsc_RbId_DRB1, ?, v_PDCP_SDUList_DRB1)) {}
    }

    //@siclog "Step 14- 15" siclog@
    // The SS sends OPEN UE TEST LOOP message to open the UE test loop. The UE responds with an OPEN UE TEST LOOP COMPLETE message.
    f_EUTRA_OpenUE_TestLoopMode(eutra_Cell1);

    //@siclog "Step 16" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 1.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);

    //@siclog "Step 17" siclog@
    //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state.
    f_Delay(5.0);

    //@siclog "Step 18" siclog@
    //The SS changes Cell 1 and Cell 11 level according to the row "T1" in table 8.1.2.7a.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 19" siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 11?
    //NOTE: The UE performs a TAU procedure and the RRC connection is released.
    f_EUTRA_TrackingAreaUpdate(eutra_Cell11, tsc_RRC_TI_Def, NORMAL, cr_EstablishmentCause_HighPriorityAccess);

    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "508Check CampOnNewEutraCell");
  
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.2.9a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_8_1_2_9a_EUTRA() runs on EUTRA_PTC
  { /* RRC Connection Establishment / 0% access probability for MO data, non-zero percent access probability for MO signalling / AC-Barring per PLMN */

    var GutiParameters_Type v_GutiParameters;
    var NAS_MSG_Indication_Type v_NasInd;
    var NAS_KsiValue v_KsiValue;
    var template (value) CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) CellPowerList_Type v_CellPowerList_AtT2;
    var boolean v_RrcMsgReceived;
    var boolean v_DataPduReceived;
    var integer v_ExecutionCounter_K;
    var integer v_ExecutionCounter_L;
    var float v_ModificationPeriod_s; // Modification period in second
    var float v_TimerValue;
    var PDCP_SDUList_Type v_PDCP_SDUList_DRB1 := { f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE()) };
   
    timer t_Wait;

    f_EUTRA_Init(c1);
    
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell11, -79); //@sic R5s250178 sic@

    //Create and configure cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell11);
    
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_001_02 //PLMNid 2 (index 1)
                                      );
    f_EUTRA_CellInfo_SetSysInfo_CellReservedForOpUse ( eutra_Cell1, reserved, 1);
   
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell11,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_001_02 //PLMNid 2 (index 1)
                                      );
    f_EUTRA_CellInfo_SetSysInfo_CellReservedForOpUse ( eutra_Cell11, reserved, 1);
                                       
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell11, 1, omit, omit, cs_AC_BarringConfig(p50, s64, '00000'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell11);


    // The UE is in state Loopback Activated (state 4) with condition UE TEST LOOP MODE B on Cell 1 according to [18].
    // As extended access barring is active a test case specific version of the preamble is employed to avoid user initated PDN disconnection
    f_EUTRA_Preamble(eutra_Cell1, STATE2A_TESTLOOP_ModeB, -, -, -, noRrcConnectionRelease);
    f_EUTRA_InitialRegistration_ReleaseInternetPDN_ConnectedMode(eutra_Cell1, rrcConnectionRelease);
    f_EUTRA_RbEst_Def(eutra_Cell1);
    f_EUTRA_CloseUE_TestLoopModeB(eutra_Cell1, '05'O);

    //Cell power levels at T1
    v_CellPowerList_AtT1 := {
      cs_CellPower(eutra_Cell11, -79)
    };

    //Cell power levels at T2
    v_CellPowerList_AtT2 := {
      cs_CellPower(eutra_Cell11, -91)
    };

    f_EUTRA_TestBody_Set(true);

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 1.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);

    //@siclog "Step 2" siclog@
    //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state.
    f_Delay( 5.0);

    //@siclog "Step 3" siclog@
    //The SS notifies the UE of change of System Information. SS adjusts S//IB2 of Cell 1 as per table 8.1.2.9a.3.3-2 and transmits a Paging message including systemInfoModification.
    //The systemInfoValueTag in the SystemInformationBlockType1 is increased.
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1,  omit, omit, omit, cs_AC_BarringConfig(p00, s512, '00000'B));
    f_EUTRA_ModifySysinfo(eutra_Cell1);
    
    //@siclog "Step 4" siclog@
    //Wait for 2.1* modification period to allow the new system information to take effect. (Note 1).
    v_ModificationPeriod_s := int2float(f_CalculateModificationPeriod (eutra_Cell1))/100.0;
    f_Delay (2.1*v_ModificationPeriod_s);

    //@siclog "Step 5" siclog@
    //The SS initializes internal counters: K to 0 and L to 0.
    v_ExecutionCounter_K := 0;
    v_ExecutionCounter_L := 0;
   
   //EXCEPTION: Steps 6 to 7b15 shall be repeated maximum 50 times unless K > 0 and L >0. (Note 2)
    while ((v_ExecutionCounter_K == 0 or v_ExecutionCounter_L == 0) and (v_ExecutionCounter_K + v_ExecutionCounter_L) < 50)
      {
        //@siclog "Step 6" siclog@
        //The SS changes the power level setting according to the row "T1" in table 8.1.2.9a.3.2-1.
        f_EUTRA_SetCellPowerList(v_CellPowerList_AtT1);

        // IF the UE does not transmit any RRCConnectionRequest message within 34 s when K=0 and L=0 and within 8 s for other repeat times THEN the SS increments the counter K by 1.
        if (v_ExecutionCounter_K == 0 and v_ExecutionCounter_L == 0) {
          t_Wait.start( 34.0);
        }
        else {
          t_Wait.start( 8.0);
        }

        if (not f_EUTRA_RRC_ConnectionRequest_Common(eutra_Cell11, t_Wait, cr_EstablishmentCause_MoSignalling)) {

          //@siclog "Step 7a1" siclog@
          //IF the UE does not transmit any RRCConnectionRequest message within 5 s (Note 2) THEN the SS increments the counter K by 1
          v_ExecutionCounter_K := v_ExecutionCounter_K + 1;
        
          //@siclog "Step 7a2" siclog@
          //The SS changes the power level setting according to the row "T2" in table 8.1.2.9a.3.2-1.
          f_EUTRA_SetCellPowerList(v_CellPowerList_AtT2);
        
          //@siclog "Step 7a3" siclog@
          //The SS waits for 20s for the UE to perform cell reselection procedure. (Note 3)
          f_Delay(20.0);
        }
        else {
          //@siclog "Step 7b1" siclog@
          //ELSE IF the UE transmits an RRCConnectionRequest message on Cell 11 THEN the SS increments the counter L by 1.

          v_ExecutionCounter_L := v_ExecutionCounter_L + 1;
        
          //@siclog "Step 7b2 - 7b6" siclog@
          //Steps 2 to 6 of the generic test procedure in TS 36.508 [18] subclause 6.4.2.7 are performed on Cell 11.
          //Note: The UE performs a TAU procedure and the RRC connection is released.
          f_EUTRA_TrackingAreaUpdate_WithoutRrcConnReq(eutra_Cell11, tsc_RRC_TI_Def);
        
          //@siclog "Step 7b7" siclog@
          //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state.
          f_Delay(5.0);
        
          //@siclog "Step 7b8" siclog@
          //The SS changes the power level setting according to the row "T2" in table 8.1.2.9.3.2-1.
          f_EUTRA_SetCellPowerList(v_CellPowerList_AtT2);
        
          //@siclog "Step 7b9" siclog@
          //The UE transmits an RRCConnectionRequest message on Cell 1.
          f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoSignalling);
        
          //@siclog "Step 7b10 - 7b14" siclog@
          //Steps 2 to 6 of the generic test procedure in TS 36.508 [18] subclause 6.4.2.7 are performed on Cell 1.
          //Note: The UE performs a TAU procedure and the RRC connection is released.
          f_EUTRA_TrackingAreaUpdate_WithoutRrcConnReq(eutra_Cell1, tsc_RRC_TI_Def);
        
          //@siclog "Step 7b15" siclog@
          //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state.
          f_Delay(5.0);
        }
      } //while

    //@siclog "Step 8" siclog@
    //Check: Is the counter K > 0 and L > 0?
    if (v_ExecutionCounter_K > 0 and v_ExecutionCounter_L > 0) {
      f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.2.9a Step 8");
    }
    else {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.1.2.9a Step 8");
    }

    //@siclog "Step 9" siclog@
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed on Cell 1.
    //NOTE: The UE performs the establishment of the new data radio bearer associated with the default EPS bearer context.
    f_EUTRA_RbEst_Def(eutra_Cell1);

    //@siclog "Step 10" siclog@
    //The SS transmits one IP packet to the UE on the DRB associated with the default EPS bearer context on Cell 1.
    DRB.send(cas_DRB_COMMON_REQ_PDCP_SDU(eutra_Cell1, tsc_RbId_DRB1, cs_TimingInfo_Now, v_PDCP_SDUList_DRB1));

    //@siclog "Step 11" siclog@
    //Wait for 1 s after the IP packet has been transmitted in step 8. (Note 4)
    f_Delay(1.0);

    //@siclog "Step 12" siclog@
    //The SS transmits an RRCConnectionRelease message on Cell 1.
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);

    //@siclog "Step 13" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message on Cell 1 within 30s?
    v_TimerValue := 30.0;
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerValue)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.1.2.9a Step 13");
    }

    //@siclog "Step 14 - 23" siclog@
    //Check: Does the test result of steps 1 to 10 generic test procedure in TS 36.508 subclause 6.4.2.2 indicate that the UE is in E-UTRA RRC_IDLE state on Cell 1?
    v_GutiParameters := f_EUTRA_CellInfo_GetGuti(eutra_Cell1);
    f_EUTRA_UE_Page(eutra_Cell1,
                    cs_NasPaging_OneRecord(cs_PagingUE_Identity_S_TMSI(v_GutiParameters.MME_Code, v_GutiParameters.M_TMSI)));

    v_KsiValue := f_EUTRA_SecurityKSIasme_Get();
    v_NasInd := f_EUTRA_RRC_ConnEst_DefWithNas(eutra_Cell1,
                                               tsc_RRC_TI_Def,
                                               cr_EstablishmentCause_mt_Access,
                                               cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                                 cr_508_SERVICE_REQUEST(v_KsiValue)));

    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         tsc_RRC_TI_Def,
                                         v_NasInd.SecurityProtection.NasCount);

    //@siclog "Step 24a1" siclog@
    //IF the UE has user data pending THEN the UE loop backs the IP packet received in step 8 on the DRB associated with the default EPS bearer context on Cell 1 within 10 s.
    t_Wait.start(10.0);
    v_RrcMsgReceived := false;
    v_DataPduReceived := false;

    alt {
      [not v_DataPduReceived] DRB.receive(car_DRB_COMMON_IND_PDCP_SDUList(eutra_Cell1, tsc_RbId_DRB1, ?, v_PDCP_SDUList_DRB1))
        {
          if (not v_RrcMsgReceived) {
            v_DataPduReceived := true;
            repeat;
          }
        }
      [not v_RrcMsgReceived] SRB.receive(car_SRB1_RrcPdu_IND(eutra_Cell1,
                                                             cr_508_RRCConnectionReconfigurationComplete(tsc_RRC_TI_Def)))
        {
          if (not v_DataPduReceived) {
            v_RrcMsgReceived := true;
            repeat;
          }
        }
      [] t_Wait.timeout
        {
          if (not v_RrcMsgReceived) {
            f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test Case 8.1.2.9a Step 23 or 24a1");
          }
        }
    }
    t_Wait.stop;

    f_EUTRA_TestBody_Set(false);

    //Switch off UE and expect Detach Request
   f_EUTRA_Postamble(eutra_Cell1, E3_TESTMODE);

  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.2.13a
   * @status    APPROVED (LTE_A_R12)
   */
   function f_TC_8_1_2_13a_EUTRA() runs on EUTRA_PTC
   { /*  RRC Connection establishment / 0% access probability for MO data, 0% access probability for MO signalling / AC-Barring per PLMN  */
    f_TC_8_1_2_13x (true);
   }

}
