module PosSystem_Control {

  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from CommonDefs all;
  import from POS_Parameters all;
  import from PosSystem_ASP_TypeDefs all;

  template (value) POS_SYSTEM_CTRL_REQ cas_POS_SYSTEM_Start( PositioningSystemList_Type p_PosSystemListId ) :=
  { /* @status    APPROVED (LTE_A_PRO, POS) */
    PositioningSystemList := p_PosSystemListId,
    CnfFlag := true, //@sic R5s230711 sic@
    Request := {
      Start := true
    }
  };

  template (present) POS_SYSTEM_CTRL_CNF car_POS_SYSTEM_Start(PositioningSystemList_Type p_PosSystemListId) :=
  { /* @status    APPROVED (LTE_A_PRO, POS) */
    // @sic R5s230502 sic@
    PositioningSystemList := p_PosSystemListId,
    Confirm := {
      Start := ?
    }
  };

  template (value) POS_SYSTEM_CTRL_REQ cas_POS_SYSTEM_Stop(PositioningSystemList_Type p_PosSystemListId) :=
  { /* @status    APPROVED (LTE_A_PRO, POS) */
    PositioningSystemList := p_PosSystemListId,
    CnfFlag := false,
    Request := {
      Stop := true
    }
  };

  template (value) PositioningScenario_Type cs_SatelliteScenario_AGNSS(ScenarioNumber_Type p_ScenarioNumber) :=
  { /* @status    APPROVED (POS) */
    AGNSS := p_ScenarioNumber
  };

  template (value) PositioningScenario_Type cs_SatelliteScenario_LTEPos(ScenarioNumber_Type p_ScenarioNumber) :=
  { /* @status    APPROVED (POS) */
    LTE_Positioning := p_ScenarioNumber
  };

  template (value) PositioningScenario_Type cs_SatelliteScenario_NrPos(ScenarioNumber_Type p_ScenarioNumber) :=
  { /* @status    APPROVED (POS) */
    NR_Positioning := p_ScenarioNumber
  };

  template (value) POS_SYSTEM_CTRL_REQ cas_POS_SYSTEM_LoadScenario(PositioningSystemList_Type p_PosSystemListId,
                                                                   template (value) PositioningScenario_Type p_PositioningScenario) :=
  { /* @status    APPROVED (LTE_A_PRO, POS) */
    PositioningSystemList := p_PosSystemListId,
    CnfFlag := true, //@sic R5s230711 sic@
    Request := {
      LoadScenario := p_PositioningScenario
    }
  };

  template (present) POS_SYSTEM_CTRL_CNF car_POS_SYSTEM_LoadScenario(PositioningSystemList_Type p_PosSystemListId) :=
  { /* @status    APPROVED (LTE_A_PRO, POS) */
    // @sic R5s230502 sic@
    PositioningSystemList := p_PosSystemListId,
    Confirm := {
      LoadScenario := ?
    }
  };

  template (value) UTRAN_AssistanceDataRequest_Type cs_UTRAN_AssistanceDataGANSS(template (omit) bitstring p_AssistanceDataGANSS,
                                                                                 template (omit) bitstring p_AssistanceDataGANSSv860ext,
                                                                                 template (omit) bitstring p_AssistanceDataGANSSvc50ext := omit) :=
  { /* @status    APPROVED (POS) */
    //@sic R5-145737 - BDS inclusion sic@
    GANSS := {
      AssistanceDataReqGANSS := p_AssistanceDataGANSS,
      AssistanceDataReqGANSSv860ext := p_AssistanceDataGANSSv860ext,
      AssistanceDataReqGANSSvc50ext := p_AssistanceDataGANSSvc50ext
    }
  };

  template (value) UTRAN_AssistanceDataRequest_Type cs_UTRAN_AssistanceDataGPS(bitstring p_AssistanceDataGPS) :=
  { /* @status    APPROVED (POS) */
    GPS := {
      AssistanceDataReqGPS := p_AssistanceDataGPS
    }
  };

  template (value) AssistanceDataRetrieveRequest_Type cs_AssistanceDataRetrieveRequestAGNSS(template (value) UTRAN_AssistanceDataRequestList_Type p_UTRAN_AssistanceDataRequestList) :=
  { /* @status    APPROVED (POS) */
    UTRA_GNSS := p_UTRAN_AssistanceDataRequestList
  };

  template (value) AssistanceDataRetrieveRequest_Type cs_AssistanceDataRetrieveRequestLPP(template (value) LPP_AssistanceDataRequestList_Type p_LPP_AssistanceDataRequestList) :=
  { /* @status    APPROVED (POS) */
    //@sic R5w190203 sic@
    LPP := p_LPP_AssistanceDataRequestList
  };

  template (value) LPP_AssistanceDataRequest_Type cs_LPP_AssistanceDataRequest(bitstring p_AssistanceDataRequest) :=
  { /* @status    APPROVED (POS) */
    //@sic R5s190203 sic@
    LPP_AssistanceData := p_AssistanceDataRequest
  };

  template (value) POS_SYSTEM_CTRL_REQ cas_POS_SYSTEM_RetrieveData(PositioningSystemList_Type p_PosSystemListId,
                                                                   template (value) AssistanceDataRetrieveRequest_Type p_AssistanceDataRetrieveRequest) :=
    
  { /* @status    APPROVED (POS) */
    PositioningSystemList := p_PosSystemListId,
    CnfFlag := true,
    Request := {
      RetrieveData := p_AssistanceDataRetrieveRequest
    }
  };

  template (present) POS_SYSTEM_CTRL_CNF car_POS_SYSTEM_RetrieveData(PositioningSystemList_Type p_PosSystemListId) :=
  { /* @status    APPROVED (POS) */
    PositioningSystemList := p_PosSystemListId,
    Confirm := {
      RetrieveData := ?
    }
  };

  /*
   * @desc      common function to start a satellite system from EUTRA/UTRAN PTC;
   *            no confirmation is expected
   * @param     p_Port
   * @param     p_PosSystemListId
   * @status    APPROVED (LTE_A_PRO, POS)
   */
  function f_PosSystem_Start(POS_PTC_MTC_PORT p_Port,
                             PositioningSystemList_Type p_PosSystemListId)
    
  {
    p_Port.send(cas_POS_SYSTEM_Start(p_PosSystemListId));
    p_Port.receive(car_POS_SYSTEM_Start(p_PosSystemListId)); //@sic R5s230502 sic@
  }

  /*
   * @desc      common function to stop a satellite system from EUTRA/UTRAN PTC;
   *            no confirmation is expected
   * @param     p_Port
   * @param     p_PosSystemListId
   * @status    APPROVED (LTE_A_PRO, POS)
   */
  function f_PosSystem_Stop(POS_PTC_MTC_PORT p_Port,
                            PositioningSystemList_Type p_PosSystemListId)
    
  {
    p_Port.send(cas_POS_SYSTEM_Stop(p_PosSystemListId));
  }

  /*
   * @desc      common function to load a scenario to a satellite system from EUTRA/UTRAN PTC;
   *            no confirmation is expected
   * @param     p_Port
   * @param     p_PosSystemListId
   * @param     p_PositioningScenario
   * @status    APPROVED (LTE_A_PRO, POS)
   */
  function f_PosSystem_LoadScenario(POS_PTC_MTC_PORT p_Port,
                                    PositioningSystemList_Type p_PosSystemListId,
                                    template (value) PositioningScenario_Type p_PositioningScenario)
    
  {
    p_Port.send(cas_POS_SYSTEM_LoadScenario(p_PosSystemListId, p_PositioningScenario));
    p_Port.receive(car_POS_SYSTEM_LoadScenario(p_PosSystemListId)); //@sic R5s230502 sic@
  }

  /*
   * @desc      common function to retrieve data from the satellite system and give it back to EUTRA/UTRAN PTC
   * @param     p_Port
   * @param     p_PosSystemListId
   * @param     p_AssistanceDataRetrieveRequest
   * @return    AssistanceDataRetrieveResponse_Type
   * @status    APPROVED (POS)
   */
  function f_SatSystem_RetrieveData(POS_PTC_MTC_PORT p_Port,
                                    PositioningSystemList_Type p_PosSystemListId,
                                    template (value) AssistanceDataRetrieveRequest_Type p_AssistanceDataRetrieveRequest) return AssistanceDataRetrieveResponse_Type
  {
    var POS_SYSTEM_CTRL_CNF v_POS_SYSTEM_CTRL_CNF;
    
    p_Port.send(cas_POS_SYSTEM_RetrieveData(p_PosSystemListId, p_AssistanceDataRetrieveRequest));
    p_Port.receive(car_POS_SYSTEM_RetrieveData(p_PosSystemListId)) -> value v_POS_SYSTEM_CTRL_CNF;
    
    return v_POS_SYSTEM_CTRL_CNF.Confirm.RetrieveData;
  }

    /*
   * @desc      Checks the PICS and returns the list of supported GNSS systems
   * @return    PositioningSystemList_Type
   * @status    APPROVED (LTE_A_PRO, POS)
   */
  function f_POS_GetListOfSupportedGNSS() return PositioningSystemList_Type
  {
    var PositioningSystemList_Type v_GNSS_List;
    var integer i := 0;
    
    if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) {
      v_GNSS_List[i] := gps;
      i := i + 1;
    }
    if (pc_A_GLONASS) {
      v_GNSS_List[i] := glonass;
      i := i + 1;
    }
    if (pc_A_Galileo) {
      v_GNSS_List[i] := galileo;
      i := i + 1;
    }
    if (pc_A_BDS) {
      v_GNSS_List[i] := bds;
      i := i + 1;
    }
    if (pc_A_GPS_L1C_A_MGPS or pc_A_GPS_L1C or pc_A_GPS_L2C or pc_A_GPS_L5) { //@sic R5s210033 sic@
      v_GNSS_List[i] := modernizedGPS;
      i:= i + 1;
    }
    //At this point, v_GNSS_List contains all the supported GNSS.
    if (i == 0) {
      FatalError (__FILE__, __LINE__, "No GNSS declared as supported in the PICS");
    }
    return v_GNSS_List;
  }

}
