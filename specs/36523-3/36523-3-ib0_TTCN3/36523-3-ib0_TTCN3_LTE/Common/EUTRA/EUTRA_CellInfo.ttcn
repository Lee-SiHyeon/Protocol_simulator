  /*
   * @desc      Set TAC parameter in EUTRA_CellInfo
   * @param     p_CellId
   * @param     p_TAC
   * @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_SetTAC(EUTRA_CellId_Type p_CellId,
                                   TrackingAreaCode p_TAC) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-167569 sic@

    v_CellInfo.NAS_Parameters.TrackingAreaCode := p_TAC;
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.trackingAreaCode := p_TAC;
    if (v_SysinfoType == sysinfoAndBR) {//UE supports category M1 or enhanced coverage TC
      v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.trackingAreaCode := p_TAC;
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Set the Guti parameters in the EUTRA_CellInfo
   * @param     p_CellId
   * @param     p_Guti
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_SetGuti(EUTRA_CellId_Type p_CellId,
                                    template (value) GutiParameters_Type p_Guti) runs on EUTRA_PTC
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var template (value) EUTRA_CellInfo_Type v_NewCellInfo := v_CellInfo;
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-167569 sic@

    if (v_CellInfo.Frequency.FrequencyBandIndicator == 6) {
      // For Band 6: set MCC to the Japan MCC value
      v_NewCellInfo.NAS_Parameters.Guti_Parameters := p_Guti;
      v_NewCellInfo.NAS_Parameters.Guti_Parameters.PLMN_Identity.mcc := f_EUTRA_ConvertMCC_Nas2Asn(px_eJapanMCC_Band6);
      v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mcc := f_EUTRA_ConvertMCC_Nas2Asn(px_eJapanMCC_Band6);
      v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mnc := p_Guti.PLMN_Identity.mnc;
      if (v_SysinfoType == sysinfoAndBR) {//UE supports category M1 or enhanced coverage TC
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mcc := f_EUTRA_ConvertMCC_Nas2Asn(px_eJapanMCC_Band6);
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mnc := p_Guti.PLMN_Identity.mnc;
      }
    } else {
      v_NewCellInfo.NAS_Parameters.Guti_Parameters := p_Guti;
      v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mcc := p_Guti.PLMN_Identity.mcc;  // @sic R5s100008 sic@
      v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mnc := p_Guti.PLMN_Identity.mnc;  // @sic R5s100008 sic@
      if (v_SysinfoType == sysinfoAndBR) {//UE supports category M1 or enhanced coverage TC
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mcc := p_Guti.PLMN_Identity.mcc;  // @sic R5s100008 sic@
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[0].plmn_Identity.mnc := p_Guti.PLMN_Identity.mnc;  // @sic R5s100008 sic@
      }

    }
    f_EUTRA_CellInfo_Set(p_CellId, v_NewCellInfo);
  }

  /*
   * @desc      Set the parameterised PLMN value in EUTRA Cellinfo
   * @param     p_CellId
   * @param     p_PlmnList
   * @param     p_PlmnIndex         (default value: 0)
   * @param     p_UtranConfigured   (default value: false)
   * @param     p_CellReservedCheck (default value: false)
   * @param     p_Reserved_plmn_idx   (default value: 0)
   * @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetPLMN_Common(EUTRA_CellId_Type p_CellId,
                                           template (value) PLMN_IdentityList_Type p_PlmnList,
                                           integer p_PlmnIndex := 0,
                                           boolean p_UtranConfigured := false, //@sic R5s160174 sic@
                                           boolean p_CellReservedCheck := false,  //@sic R5s250052sic@
                                           integer p_Reserved_plmn_idx := 0)
    runs on EUTRA_PTC
  { // @sic R5s110468: adding parameter p_PlmnIndex  sic@
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var template (value) EUTRA_CellInfo_Type v_NewCellInfo := v_CellInfo;
    var integer v_NoOfPlmns := lengthof(p_PlmnList);
    var MCC v_MCC_JapanBand6;
    var integer i;
    var Combination_Type v_SysinfoCombination := f_EUTRA_CellInfo_GetCombination(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-167569 sic@

    v_NewCellInfo.NAS_Parameters.Guti_Parameters.PLMN_Identity := p_PlmnList[p_PlmnIndex];  // @sic R5s110468 sic@
    for (i:=0; i<v_NoOfPlmns; i:=i+1) {
    v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[i].plmn_Identity := p_PlmnList[i];
      if (p_CellReservedCheck and i == p_Reserved_plmn_idx) {//@sic R5s250052 sic@
          v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[i].cellReservedForOperatorUse := reserved; //@sic R5s100850 sic@
      }
      else  {
          v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[i].cellReservedForOperatorUse := notReserved; //@sic R5s100850 sic@
      }
      if (v_SysinfoType==sysinfoAndBR) { //UE supports category M1 or enhanced coverage TC
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[i].plmn_Identity := p_PlmnList[i];
        v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[i].cellReservedForOperatorUse := notReserved; //@sic R5s100850 sic@
      }
    }

    if (v_CellInfo.Frequency.FrequencyBandIndicator == 6 or
        (px_FDD_OperationBand==6 and ((v_SysinfoCombination == c4) or (v_SysinfoCombination == c9) or (v_SysinfoCombination == c10) or (v_SysinfoCombination == c10a) or (v_SysinfoCombination == c11 or p_UtranConfigured))))    {
      // For Band 6: set MCC to the Japan MCC value
      v_MCC_JapanBand6 := f_EUTRA_ConvertMCC_Nas2Asn(px_eJapanMCC_Band6);
      v_NewCellInfo.NAS_Parameters.Guti_Parameters.PLMN_Identity.mcc := v_MCC_JapanBand6;

      for (i:=0; i<v_NoOfPlmns; i:=i+1) {
        v_NewCellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo.plmn_IdentityList[i].plmn_Identity.mcc := v_MCC_JapanBand6;
        if (v_SysinfoType==sysinfoAndBR) {//UE supports category M1 or enhanced coverage TC
          v_NewCellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellAccessRelatedInfo.plmn_IdentityList[i].plmn_Identity.mcc := v_MCC_JapanBand6;
        }
      }
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_NewCellInfo);
  }

    /*
   * @desc      Assign the parameterised Qrxlevmin value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_Q_Rxlevmin
   * @status    APPROVED (LTE, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_SetSysInfo_Q_Rxlevmin(EUTRA_CellId_Type p_CellId,
                                                  Q_Rxlevmin_Type p_Q_Rxlevmin) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-171541 sic@

    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.cellSelectionInfo.q_RxLevMin := p_Q_Rxlevmin;
    if (v_SysinfoType == sysinfoAndBR) { //@sic R5-171541 sic@
        //UE supports category M1 or enhanced coverage TC
        v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellSelectionInfoCE_r13.q_RxLevMinCE_r13 := p_Q_Rxlevmin;
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Set the band in EUTRA_CellInfo and in MIB
   * @param     p_CellId
   * @param     p_Band
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R12, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_SetBand(EUTRA_CellId_Type p_CellId,
                                    integer p_Band) runs on EUTRA_PTC
  { //@sic R5-163085 p_FrequencyBand type changed to integer sic@
    //@sic R5-165248: band extension sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-167569 sic@

    v_CellInfo.Frequency.FrequencyBandIndicator:= p_Band;
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.freqBandIndicator := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicator(p_Band);
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.lateNonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(p_Band);
    if (v_SysinfoType == sysinfoAndBR) {//UE supports category M1 or enhanced coverage TC
      v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.freqBandIndicator := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicator(p_Band);
      v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.lateNonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(p_Band);
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised nonCriticalExtension value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_SystemInformationBlockType1_v890_IEs
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R12, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_SetSysInfo_NCEinSIB1(EUTRA_CellId_Type p_CellId,
                                                 template (omit) SystemInformationBlockType1_v890_IEs p_SystemInformationBlockType1_v890_IEs) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-171541 sic@
    var integer v_BandCell := f_EUTRA_CellInfo_GetBand(p_CellId); //@sic R5s170268 sic@

    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension := p_SystemInformationBlockType1_v890_IEs;
    //set the band extension when band>64 @sic R5s170268 sic@
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.lateNonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(v_BandCell);
    if (v_SysinfoType == sysinfoAndBR) { //UE supports category M1 or enhanced coverage TC @sic R5-171541 sic@
        v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension := p_SystemInformationBlockType1_v890_IEs;
        //set the band extension when band>64 @sic R5s170268 sic@
        v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.lateNonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(v_BandCell);
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised CellSelectionInfo_v920 value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_CellSelectionInfo
   * @status    APPROVED (LTE, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetSysInfo_CellSelectionInfo_r9(EUTRA_CellId_Type p_CellId,
                                                            template (value) CellSelectionInfo_v920 p_CellSelectionInfo) runs on EUTRA_PTC
  { //@sic R5s170229 sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId);

    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.cellSelectionInfo_v920 := p_CellSelectionInfo;
    if (v_SysinfoType == sysinfoAndBR) {
      //UE supports category M1 or enhanced coverage TC
      v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.cellSelectionInfo_v920 := p_CellSelectionInfo;
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised nonCriticalExtension SystemInformationBlockType1_v8h0_IEs value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_SystemInformationBlockType1_v8h0_IEs
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R12, LTE_IRAT, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetSysInfo_SIB1_v8h0_IEs(EUTRA_CellId_Type p_CellId,
                                                     template (value) SystemInformationBlockType1_v8h0_IEs p_SystemInformationBlockType1_v8h0_IEs) runs on EUTRA_PTC
  { /* Assign the parameterised SystemInformationBlockType1_v8h0_IEs value in SIB1 of the cell */
    var bitstring v_SystemInformationBlockType1_v8h0_IEs := encvalue(p_SystemInformationBlockType1_v8h0_IEs);
    var octetstring v_SIB1_v8h0_IEs_Octetstring := bit2oct(f_OctetAlignedBitString(v_SystemInformationBlockType1_v8h0_IEs));
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId); //@sic R5-171541 sic@

    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.lateNonCriticalExtension := v_SIB1_v8h0_IEs_Octetstring;
    if (v_SysinfoType == sysinfoAndBR) { ////UE supports category M1 or enhanced coverage TC @sic R5-171541 sic@
        v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.lateNonCriticalExtension := v_SIB1_v8h0_IEs_Octetstring;
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised nonCriticalExtension SystemInformationBlockType1_v8h0_IEs value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_SystemInformationBlockType1_v12j0
   * @status    APPROVED (LTE, NR5GC_IRAT)
   */
   function f_EUTRA_CellInfo_SetSysInfo_SIB1_v12j0 ( EUTRA_CellId_Type p_CellId,
                                                     template (value) SystemInformationBlockType1_v12j0_IEs p_SystemInformationBlockType1_v12j0
                                                   ) runs on EUTRA_PTC
  { //@sic R5s221143 sic@
    var template (value) SystemInformationBlockType1_v8h0_IEs v_SIB1_v8h0;
    var integer v_Band := f_EUTRA_CellInfo_GetBand(p_CellId);

    if (v_Band >= maxFBI){
      v_SIB1_v8h0 := cs_SystemInformationBlockType1_v8h0_IEs(omit,cs_SystemInformationBlockType1_v9e0(v_Band, omit, cs_SystemInformationBlockType1_v10j0(cs_SystemInformationBlockType1_v10l0(cs_SystemInformationBlockType1_v10x0(p_SystemInformationBlockType1_v12j0)))));
    } else {
      v_SIB1_v8h0 := cs_SystemInformationBlockType1_v8h0_IEs(omit,cs_SystemInformationBlockType1_v9e0(omit, omit, cs_SystemInformationBlockType1_v10j0(cs_SystemInformationBlockType1_v10l0(cs_SystemInformationBlockType1_v10x0(p_SystemInformationBlockType1_v12j0)))));
    }
   f_EUTRA_CellInfo_SetSysInfo_SIB1_v8h0_IEs(p_CellId, v_SIB1_v8h0);
  }

  /*
   * @desc      Assign the parameterised nonCriticalExtension SystemInformationBlockType1-v1800-IEs value in SIB1 of the cell
   * @param     p_CellId
   * @param     p_SystemInformationBlockType1_v1800_IEs
   * @status    APPROVED (LTE)
   */
  function f_EUTRA_CellInfo_SetSysInfo_SIB1_v1800_IEs(EUTRA_CellId_Type p_CellId,
                                                      template (omit) SystemInformationBlockType1_v1800_IEs p_SystemInformationBlockType1_v1800_IEs) runs on EUTRA_PTC
  { /* Assign the parameterised SystemInformationBlockType1_v1700_IEs value in SIB1 of the cell */
    /* @sic R5-237431 R5-244434 sic@ */
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId);
    var template (omit) SystemInformationBlockType1_v1800_IEs v_SystemInformationBlockType1_v1800_IEs := omit;

    if (isvalue(p_SystemInformationBlockType1_v1800_IEs)) {
       v_SystemInformationBlockType1_v1800_IEs := p_SystemInformationBlockType1_v1800_IEs;
    }
    //@sic R5s240264 sic@
    if (not ispresent(v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) { // SystemInformationBlockType1-v1130-IEs
        v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1130_Cat0Allowed(omit);
    }
    if (not ispresent(v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) { // SystemInformationBlockType1-v1310-IEs
        v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1310(omit, cs_SystemInformationBlockType1_v1320_EcallOverIMS);
    }
    if (not ispresent(v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) { // SystemInformationBlockType1-v1450-IEs
        v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1450_IES(cs_SystemInformationBlockType1_v1530_IES(notBarred, cs_SystemInformationBlockType1_v1540_IES(cs_SystemInformationBlockType1_v1610_IES(cs_SystemInformationBlockType1_v1700_IEs(v_SystemInformationBlockType1_v1800_IEs)))));
    } else {
        v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := v_SystemInformationBlockType1_v1800_IEs;
    }

    if (v_SysinfoType == sysinfoAndBR) {
        //@sic R5s240264 sic@
        if (not ispresent(v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) { // SystemInformationBlockType1-v1130-IEs
           v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1130_Cat0Allowed(omit);
        }
        if (not ispresent(v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)){
            v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1320_EcallOverIMS; // SystemInformationBlockType1-v1320-IEs
            v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := cs_SystemInformationBlockType1_v1450_IES(cs_SystemInformationBlockType1_v1530_IES(notBarred, cs_SystemInformationBlockType1_v1540_IES(cs_SystemInformationBlockType1_v1610_IES(cs_SystemInformationBlockType1_v1700_IEs(v_SystemInformationBlockType1_v1800_IEs))))); // From SystemInformationBlockType1-v1450-IEs
        } else {
            v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := v_SystemInformationBlockType1_v1800_IEs;
         }
    }

    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

