module Initial_Registration_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NAS_5GC_Parameters all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;
  import from UpperTesterFunctions all;

  template (present) MICO_Ind cr_MicoInd (template (present) B1_Type p_Sprti,  template (present) B1_Type p_Raai) :=
  { /* @status    APPROVED (NR5GC) */
    // @sic R5-247673 sic@
    iei := 'B'H,
    spare := tsc_Spare2,
    sprti := p_Sprti,
    raai := p_Raai
  }

  template (value) MICO_Ind cs_MicoInd (template(value) B1_Type p_Sprti, B1_Type p_Raai) :=
  { /* @status    APPROVED (NR5GC) */
    // @sic R5-247673 sic@
    iei := 'B'H,
    spare := tsc_Spare2,
    sprti := p_Sprti,
    raai := p_Raai
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_1_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Success / 5G-GUTI reallocation / last visited TAI // @sic R5-212847 sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN); // @sic R5-190698 sic@
    var NR_CellId_Type v_NGC_NASCellH := f_NR5GC_MapNASCell(ngc_CellH, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellC);
    f_NR_CellConfig_Def(v_NGC_NASCellH);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    fl_TC_9_1_5_1_1_Body();

    // Finish
    f_NR_Postamble(v_NGC_NASCellC, STATE_IDLE_1A); //@sic R5s191189 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_1_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellH := f_NR5GC_MapNASCell(ngc_CellH, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;

    //@siclog "Step 1" siclog@
    //Set NGC Cell A to serving cell power and NGC Cell C and NGC Cell H to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    f_NR_SetCellPower (v_NGC_NASCellH, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Steps 3-5" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    //@siclog "Step 6" siclog@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_NoSecurityProtection, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_EmmCause_IllegalUe))))); //@sic R5-194859 sic@
    //@siclog "Step 7" siclog@
    // Switch off the UE
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_DEREGISTERED);
    //@siclog "Step 8" siclog@
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS(); //@sic R5s211243 sic@
    //@siclog "Steps 9 - 11" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection); //@sic R5s191189 sic@
    //@siclog "Step 12" siclog@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,
                                           cr_NG_MobileIdentitySUCI(?, ?), //Check the SUCI
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           - //@sic R5s191189 sic@
                                           )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    //@siclog "Step 13 - 21" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                TESTMode_OFF,
                                Initial_NoSecurity); //@sic R5s191189 sic@

    //Create the RGISTRATION ACCEPT for Step 22
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA), //Set 5G-GUTI according to Table 9.1.5.1.1.3.3-2
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellA))}),
                                                   -,-,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );
    //@siclog "Step 22" siclog@
    // Registration Accept
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 23" siclog@
    // Registration Complete , No SRB2 so must be on SRB1
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    //@siclog Steps 24 - 27a1 siclog@
    // No SRB2 so must be on SRB1
    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellA); //@sic R5s201489 sic@
    //@siclog "Step 28" siclog@
    //Prose does not mention to handle the DEREGISTRATION, a Prose CR is needed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_CONNECTED_3A);

    //@siclog "Step 29" siclog@
    //Set NGC Cell H to serving cell power and NGC Cell C and NGC Cell A to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    f_NR_SetCellPower (v_NGC_NASCellH, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Step 30" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); //@sic R5s211243 sic@
    //@siclog "Steps 31- 33" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellH, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    //@siclog "Step 34" siclog@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,
                                           f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA, omit), //Check the 5G-GUTI
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           f_LastVisited_TAI (v_NGC_NASCellA) //Check the LastVisitedTAI
                                           )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 34");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 34");
    //@siclog "Step 35 - 43" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellH, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellH)),
                                TESTMode_OFF,
                                Initial_Secure);

    //Create the RGISTRATION ACCEPT for Step 44
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellH), //Set 5G-GUTI according to Table 9.1.5.1.1.3.3-2
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellH)), //@sic R5s191189 sic@
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellH))}), //@sic R5s191189 sic@
                                                   cs_PLMN_List_1PLMN(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA))),
                                                   -,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );
    //@siclog "Step 44" siclog@
    // Registration Accept
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellH,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 45" siclog@
    // Registration Complete , No SRB2 so must be on SRB1
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellH, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    //@siclog Steps 46 - 49a1 siclog@
    // No SRB2 so must be on SRB1
    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellH); //@sic R5s201489 sic@
    //@siclog "Step 50" siclog@
    //Prose does not mention to handle the DEREGISTRATION, a Prose CR is needed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellH, STATE_CONNECTED_3A);
    //@siclog "Step 51" siclog@
    //Set NGC Cell A to serving cell power and NGC Cell H and NGC Cell C to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    f_NR_SetCellPower (v_NGC_NASCellH, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    //@siclog "Step 52" siclog@
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS(); //@sic R5s211243 sic@

    // RRC Connection Setup
    //@siclog "Step 53 - 55" siclog@
    //Establish RRC connection
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);

    //@siclog "Step 56" siclog@
    //Receive REGISTRATION REQ
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,
                                           f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellH, omit), //Check the 5G-GUTI
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           f_LastVisited_TAI (v_NGC_NASCellH) //Check the LastVisitedTAI
                                           )) {
    f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 56");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 56");
    //@siclog "Step 57 - 65" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), //@sic R5s191189 sic@
                                TESTMode_OFF,
                                Initial_Secure);

    //Create the RGISTRATION ACCEPT for Step 66
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA), //@sic R5s191189 sic@
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellA))}),
                                                   -,-,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );

    //@siclog "Step 66" siclog@
    // Registration Accept
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 67" siclog@
    // Registration Complete , No SRB2 so must be on SRB1
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    //@siclog Steps 68 - 71a1 siclog@
    // No SRB2 so must be on SRB1
    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellA); //@sic R5s201489 sic@
    //@siclog "Step 72" siclog@
    //Prose does not mention to handle the DEREGISTRATION, a Prose CR is needed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_CONNECTED_3A);
    //@siclog "Step 73" siclog@
    //Set NGC Cell A to serving cell power and NGC Cell H and NGC Cell C to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellH, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 sic@ //@sic R5s191189 sic@
    //@siclog "Step 74" siclog@
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS(); //@sic R5s211243 sic@

    // RRC Connection Setup
    //@siclog "Step 75 - 77" siclog@
    //Establish RRC connection
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);

    //@siclog "Step 78" siclog@
    //Receive REGISTRATION REQ
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure,
                                           f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA, omit), //Check the 5G-GUTI
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           -,
                                           f_LastVisited_TAI (v_NGC_NASCellA) //Check the LastVisitedTAI
                                           )) {
    f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 78");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 78");
    //@siclog "Step 79 - 94" siclog@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, // @sic R5-237369 sic@
                                v_NGC_NASCellC,
                                v_ReceivedMsg,
                                TESTMode_OFF);
    } //End of fl_TC_9_1_5_1_1_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_2_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / 5GS services / Equivalent PLMN list handling
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN); // @sic R5-190698 sic@
    var NR_CellId_Type v_NGC_NASCellF := f_NR5GC_MapNASCell(ngc_CellF, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_4, NG_CellsOnDifferentPLMN, NR5GC_NAS_ReplaceNRf4_NRf3);//@sic R5-197085 sic@
    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellE);
    f_NR_CellConfig_Def(v_NGC_NASCellF);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0A);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_2_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(v_NGC_NASCellF, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_2
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_2_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellF := f_NR5GC_MapNASCell(ngc_CellF, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NAS_PlmnId v_PLMN_A := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    var NAS_PlmnId v_PLMN_E := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellE));
    var NAS_PlmnId v_PLMN_F := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellF));
    //@siclog "Step 1" siclog@
    //The SS configures:- NGC Cell A as the "Serving cell".- NGC Cell E as the "Non-Suitable "off" cell".- NGC Cell F as the "Non-Suitable "off" cell".

    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);//@sic R5-201086,R5s200047 sic@
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-201086,R5s200047 sic@

    //@siclog "Step 2" siclog@
    //The UE is Switched ON
    f_UT_SwitchOnUE(UT);
    //@siclog "Steps 3-14" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellF, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));//@sic R5-201086,R5s200047 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellF, v_ReceivedMsg,//@sic R5-201086,R5s200047 sic@
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellF)),
                                TESTMode_OFF,
                                Initial_NoSecurity);

    //@siclog "Step 15" siclog@
    //SS transmits a REGISTRATION ACCEPT message with PLMN ID of NGC Cell F included in the Equivalent PLMNs IE
    //Create the RGISTRATION ACCEPT for Step 22
    //@sic R5-201086,R5s200047 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_NoSecurity,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellF),
                                                   cs_NG_TAIListNonConsecutive(v_PLMN_F,
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellF))}),
                                                   cs_PLMN_List_1PLMN(v_PLMN_A),
                                                   -,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );

    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellF,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Step 16-20a1" siclog@
    // Steps 15-19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellF,TESTMode_OFF,noRrcConnectionRelease);//@sic R5-201086,R5s200047 sic@
    //@siclog "Step 21" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.3-1 in TS 38.508-1 [4]
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellF, STATE_CONNECTED_3A);//@sic R5-201086,R5s200047 sic@
    //@siclog "Step 22" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    //@siclog "Step 23-34" siclog@
    //@sic R5-201086,R5s200047 sic@
    //step 2-4 of Table 4.5.2.2-2
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellF, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    //step 5-13 of Table 4.5.2.2-2
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellF, v_ReceivedMsg,
                                v_PLMN_F,
                                TESTMode_OFF,
                                Initial_Secure);
    //@siclog "Step 35" siclog@
    //SS transmits a REGISTRATION ACCEPT message with PLMN ID of NGC Cell E included in the Equivalent PLMNs IE
    //@sic R5-201086,R5s200047 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellF), //
                                                   cs_NG_TAIListNonConsecutive(v_PLMN_F,
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellF))}),
                                                   cs_PLMN_List_1PLMN(v_PLMN_E),
                                                   -,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );

    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellF,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));


    //@siclog "Step 36-40a1" siclog@
    //Steps 15-19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    //@sic R5-201086,R5s200047 sic@
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellF,TESTMode_OFF,noRrcConnectionRelease);
    //@siclog "Step 41" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.3-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellF, STATE_CONNECTED_3A); //@sic R5-201086,R5s200047 sic@
    //@siclog "Step 42" siclog@
    //The SS configures:- NGC Cell A as the "Non-Suitable "off" cell".- NGC Cell E as the "Suitable neighbour cell".- NGC Cell F as the "Serving cell".
    //@sic R5-201086,R5s200047 sic@
    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Step 43" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    //@siclog "Step 44-62" siclog@
    //Steps 2-20 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_IdleState1N_Def(v_NGC_NASCellE);
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 44-62 PASS");
    //@siclog "Step 63" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.1-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellE, STATE_IDLE_1A);
    //@siclog "Step 63A" siclog@
    //The SS configures:- NGC Cell A as the " Serving cell".- NGC Cell E as the "Non-Suitable "off" cell".- NGC Cell F as the "Suitable neighbour cell".
    //@sic R5-201086 sic@
    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2);
    //@siclog "Step 64" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    //@siclog "Step 64A" siclog@
    //Steps 2-19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_IdleState1N_Def(v_NGC_NASCellA,-,noRrcConnectionRelease);//@sic R5-201086,R5s200047 sic@
    //@siclog "Step 64B" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.3-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellA, STATE_CONNECTED_3A); //@sic R5-201086,R5s200047 sic@
    //@siclog "Step 64C" siclog@
    //The SS configures:- NGC Cell A as the "Non-Suitable "off" cell"
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-201086,R5s200047 sic@
    //@siclog "Step 64D" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299, R5-201086,R5s200047 sic@
    //@siclog "Step 65-76" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellF, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellF, v_ReceivedMsg,
                                v_PLMN_F,
                                TESTMode_OFF,
                                Initial_Secure);
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 65-76 PASS");
    //@siclog "Step 76A" siclog@
    //The SS configures:- NGC Cell E as the "Non-Suitable "off" cell ".
    //void//@sic R5-201086,R5s200047 sic@
    //@siclog "Step 77" siclog@
    //SS transmits a REGISTRATION REJECT with cause #11 (PLMN not allowed)
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellF,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause (omit, '00001011'B)))));
    //@siclog "Step 78" siclog@
    //The SS releases the RRC connection
    f_NR_RRCRelease(v_NGC_NASCellF);
    //@siclog "Step 79" siclog@
    //The SS configures:- NGC Cell A as the "Serving cell".- NGC Cell E as the "Suitable neighbour cell".- NGC Cell F as the "Non-Suitable "off" cell ".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    //@siclog "Step 80-93" siclog@
    //Steps 2-13 of Table 4.5.5.2.2- 2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                v_PLMN_A,
                                TESTMode_OFF,
                                Initial_NoSecurity);
    //@siclog "Step 94" siclog@
    //SS transmits a REGISTRATION ACCEPT message with PLMN ID of NGC Cell E and NGC Cell F included in the Equivalent PLMNs IE
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg ( Initial_NoSecurity,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA), //
                                                   cs_NG_TAIListNonConsecutive(v_PLMN_A,
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(v_NGC_NASCellA))}),
                                                   cs_PLMN_List_2PLMNs(v_PLMN_E,v_PLMN_F),
                                                   -,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );

    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 95-99a1" siclog@
    //Steps 15-19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA,TESTMode_OFF,noRrcConnectionRelease);
    //@siclog "Step 100" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.3-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellA, STATE_CONNECTED_3A);
    //@siclog "Step 101" siclog@
    //The SS configures:- NGC Cell A as the "Non-Suitable "off" cell ".- NGC Cell E as the "Suitable neighbour cell".- NGC Cell F as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Step 102" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    //@siclog "Step 103-121" siclog@
    //Steps 2-20 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_IdleState1N_Def(v_NGC_NASCellE);
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 103-121 PASS");
    //@siclog "Step 122" siclog@
    //The UE is switched off by executing generic procedure in Table 4.9.6.1-1 in TS 38.508-1 [4].
    f_NR_UE_DeRegisterOnSwitchOff(v_NGC_NASCellE, STATE_IDLE_1A);
    //@siclog "Step 123" siclog@
    //The SS configures:- NGC Cell A as the "Non-Suitable "off" cell ".- NGC Cell E as the "Non-Suitable "off" cell ".- NGC Cell F as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellF, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Step 124" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    //The user is prompted to manually select PLMN of NGC Cell F
    f_UT_ManualPLMN_Select (UT, v_PLMN_F);
    //@siclog "Step 125-143" siclog@
    //Steps 2-20 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_IdleState1N_Def(v_NGC_NASCellF);
    //@siclog "Step 144" siclog@
    //The user sets the UE in Automatic PLMN selection mode.//@sic R5-201372 sic@
    f_UT_AutomaticPLMN_Select(UT);
    //@siclog "Step 145" siclog@
    //wait 300 seconds to let UE complete automatic PLMN search//@sic R5-210322 sic@
    f_Delay(300.0);

    } //End of fl_TC_9_1_5_1_2_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_3_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / 5GS services / NSSAI handling
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_AllCellsOnSamePLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var TrackingAreaCode v_TAC;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var template (value) NSSAI v_ConfiguredNSSAI := cs_NSSAI_Def('31'O,{cs_S_NSSAI('01'O, '01'O, omit)});// @sic R5s230072 sic@
    var template (value) NSSAI v_AllowedNSSAI:= cs_NSSAI_Def('15'O, {cs_S_NSSAI('01'O, '01'O, omit)});

    f_NR5GC_Init_NAS(NR_2);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);
    f_NR_CellConfig_Def(v_NGC_NASCellC);

    // Now turn Cells ready for test body
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();

    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_NoSecurity);

    // Registration Accept
    // @sic R5-227436 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -, v_ConfiguredNSSAI,-,
                                                   v_GMM_MobilityInfo.SessionStatus
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF, rrcConnectionRelease);
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_3_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_3
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_3_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_AllCellsOnSamePLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (present) NSSAI v_RequestedNSSAI;
    var NAS_PlmnId v_PLMN;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var TrackingAreaCode v_TAC;
    var TrackingAreaCode v_TAC1;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var charstring v_AT_Response;

    var template (value) NSSAI v_AllowedNSSAI:= cs_NSSAI_Def('15'O, {cs_S_NSSAI('01'O, '02'O, omit)});     // @sic R5s221179 Baseline Moving sic@
    var template (value) NSSAI v_ConfiguredNSSAI := cs_NSSAI_Def('31'O, {cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}); // @sic R5s221179 Baseline Moving sic@
    var template (value) RejectedNSSAI v_RejectedNSSAI := {
      iei := '11'O,
      iel := '02'O,
      rejectS_NSSAI := {cs_RejectedS_NSSAI('0001'B,   //@sic R5s200758 sic@
                                           '0000'B, '02'O, omit)}
      };

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Step 2" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := { // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit)}   //@sic R5s201048 R5-227436 sic@
      }};
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, v_RequestedNSSAI)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));

    //@siclog "Step 3-11" siclog@
    //Steps 5 to13 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    //@siclog "Step 12" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Allowed NSSAI and Configured NSSAI.
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -, v_ConfiguredNSSAI);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 13-18" siclog@
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellA, -, -, -, -, -, -, -, -, -, -, -, -, cs_S_NSSAI_WithIEI('22'O, cs_S_NSSAI('01'O, '02'O, omit)));  //@sic R5s210577, R5s221179 Baseline Moving sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15");
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 19" siclog@
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_IDLE_1A);

    //@siclog "Step 20" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 21" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including Requested NSSAI?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := ({ // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit)}
      }}, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '01'O, omit)}
      }});
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, v_RequestedNSSAI)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 21");
    }

    //@siclog "Step 22-30" siclog@
    //Steps 5 to 13 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 31" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Allowed NSSAI and Rejected NSSAI.
    v_AllowedNSSAI:= { // @sic R5s221179 Baseline Moving sic@
      iei := '15'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit)}
      }
    };
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   v_RejectedNSSAI);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 32-37" siclog@
    //Steps 15 to 20 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF);

    //@siclog "Step 38" siclog@
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);   // @sic R5-216483 sic@

    //@siclog "Step 39" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including Requested NSSAI?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := { // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit, omit)}
      }
    };
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, -, -, v_RequestedNSSAI)) //@sic R5s201356 sic@
    {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 39");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 39");
    }

    //@siclog "Step 40-48" siclog@
    //Void
    //@siclog "Step 49" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Allowed NSSAI.
    v_AllowedNSSAI := v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg.registration_Request.requestedNSSAI;
    v_AllowedNSSAI.iei := '15'O;
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellC);                        //@sic R5s200758 sic@
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});    //@sic R5s200758 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI    // @sic R5-206352 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellC, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 50" siclog@
    //The UE transmits a REGISTRATION COMPLETE message.
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellC, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    //@siclog "Step 51" siclog@
    f_NR_RRCRelease(v_NGC_NASCellC);

    //@siclog "Step 52" siclog@
    v_AT_Response := f_UT_ReadRejectedNSSAI(UT, f_ConvertPLMNtoString(v_PLMN));
    if (match (v_AT_Response, f_Convert_ListOfRejectedNSSAI_ForATCommand(v_RejectedNSSAI))) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 52");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 52");
    }

    //@siclog "Step 53" siclog@
    //Switch off procedure in RRC_Idle specified in TS 38.508-1 subclause 4.9.6.1 is performed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellC, STATE_IDLE_1A);

    //@siclog "Step 54" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 55" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including Requested NSSAI?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := ({ // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '01'O, omit)}   // @sic R5s210001 sic@
     }});
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, v_RequestedNSSAI)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 55");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 55");
    }

    //@siclog "Step 56-64" siclog@
    //Steps 5 to 13 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellC, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 65" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Allowed NSSAI and Rejected NSSAI.
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellC);
    v_TAC1 := f_NR_CellInfo_GetTAC (v_NGC_NASCellB);      //@sic R5s200758 sic@
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC), bit2oct(v_TAC1)});   //@sic R5s200758 sic@
    v_AllowedNSSAI:= { // @sic R5s221179 Baseline Moving sic@
      iei := '15'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit)}
        }
      };
    v_RejectedNSSAI := {
      iei := '11'O,
      iel := '02'O,
      rejectS_NSSAI := {cs_RejectedS_NSSAI('0001'B,     //@sic R5s200758 sic@
                                           '0001'B, '01'O, omit)}
      };
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   v_RejectedNSSAI);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellC, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 66-71" siclog@
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellC, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }

    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellC, -, -, -, -, -, -, -, -, -, -, -, -, cs_S_NSSAI_WithIEI('22'O, cs_S_NSSAI('01'O, '02'O, omit)));   //@sic R5s210134, R5s221179 Baseline Moving sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 68");

    f_NR_RRCRelease(v_NGC_NASCellC);

    //@siclog "Step 72" siclog@
    //Check: Is S-NSSAI=2 removed from the Rejected NSSAI list associated with current PLMN?
    //@siclog "Step 72A" siclog@
    v_AT_Response := f_UT_ReadRejectedNSSAI(UT, f_ConvertPLMNtoString(v_PLMN));
    if (match (v_AT_Response, f_Convert_ListOfRejectedNSSAI_ForATCommand(v_RejectedNSSAI))) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 72A");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 72A");
    }

    //@siclog "Step 73" siclog@
    //The SS configures NGC Cell C as the "Non-suitable cell" and NGC Cell B as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);     //@sic R5s216483 sic@

    //@siclog "Step 74" siclog@
    //@sic R5-202658 sic@
    if(f_NR_CellInfo_GetIsFR1(v_NGC_NASCellB))
     {
         f_Delay(34.0);
     }
     else
     {
         f_Delay(130.0);
     }
    f_NR5GC_CheckRRCIdle(v_NGC_NASCellB);

    //@siclog "Step 75-86" siclog@
    //void
    //@siclog "Step 87" siclog@
    v_AT_Response := f_UT_ReadRejectedNSSAI(UT, f_ConvertPLMNtoString(v_PLMN));
    if (match (v_AT_Response, f_Convert_ListOfRejectedNSSAI_ForATCommand(v_RejectedNSSAI))) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 87");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 87");
    }
    //@siclog "Step 88" siclog@
    //The SS configures NGC Cell B as the "Non-suitable cell" and NGC Cell A as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    //@sic R5s216483 sic@

    //@siclog "Step 89" siclog@
    //Check: Does UE transmit a REGISTRATION REQUEST message including Requested NSSAI?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := ({ // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit), cs_S_NSSAI('01'O, '01'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}    // @sic R5s210001 sic@
      }});
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, -, -, v_RequestedNSSAI)) //@sic R5s201356 sic@
    {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 89");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 89");
    }
    //@siclog "Step 90-98" siclog@
    //void

    //@siclog "Step 99" siclog@
    //The SS transmits a REGISTRATION ACCEPT message including Allowed NSSAI.
    v_AllowedNSSAI := v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg.registration_Request.requestedNSSAI;
    v_AllowedNSSAI.iei := '15'O;
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);   //@sic R5s200758 sic@
    v_TAIList := cs_NG_TAIListConsecutive('00001'B, valueof(cs_NG_PartialTai(v_PLMN, bit2oct(v_TAC))));     //@sic R5s200758 sic@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI   // @sic R5-206352 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 100" siclog@
    //The UE transmits a REGISTRATION COMPLETE message.
    SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");}

    //@siclog "Step 101" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 102" siclog@
    //Check: Is S-NSSAI=1 removed from the Rejected NSSAI list associated with current PLMN and registration area combination?
    v_AT_Response := f_UT_ReadRejectedNSSAI(UT, f_ConvertPLMNtoString(v_PLMN));
    if (match (v_AT_Response, ""))  //@sic R5s200758 sic@
    {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 102");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 102");
    }

 }//End of fl_TC_9_1_5_1_3_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.3a
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_3a_NR5GC() runs on NR5GC_PTC
  { // Initial registration / 5GS services / NSSAI handling / NSSAI storage
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var TrackingAreaCode v_TAC;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var NAS_PlmnId v_PLMN;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var template (value) NSSAI v_ConfiguredNSSAI := cs_NSSAI_Def('31'O,{cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}); // @sic R5s221179 Baseline Moving sic@
    var template (value) NSSAI v_AllowedNSSAI:= cs_NSSAI_Def('15'O,{cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}); // @sic R5s221179, R5-253079 sic@

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN, NR5GC_NAS_ReplaceNRf2_NRf1);  //@sic R5-198148 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellG);

    // turn on NR cell
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();

    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA));
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});

    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_NoSecurity);

    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -, v_ConfiguredNSSAI,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellA, TESTMode_OFF);

    // Now turn off again
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_IDLE_1A);

    // Now turn Cell G and A off ready for test body
    f_NR_SetCellPower (v_NGC_NASCellG, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_3a_TestBody();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellG, STATE_IDLE_1A);

  }

  /*
   * @desc      test body of TC_9_1_5_1_3a
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_3a_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);
    var NG_NAS_GutiParameters_Type v_GutiParamsCellG := f_NR5GC_CellInfo_GetGutiParameters(v_NGC_NASCellG);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellG));
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellG);
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParamsCellG);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (present) NSSAI v_RequestedNSSAI;
    var integer v_LengthOfNSSAI := 0;
    var integer i;
    var template (value) NSSAI v_ConfiguredNSSAI := cs_NSSAI_Def('31'O,{cs_S_NSSAI('02'O, '04'O, omit, '01'O), cs_S_NSSAI('02'O, '05'O, omit, '02'O)}); // @sic R5s221179 Baseline Moving sic@
    var template (value) NSSAI v_AllowedNSSAI:= cs_NSSAI_Def('15'O,{cs_S_NSSAI('01'O, '04'O, omit), cs_S_NSSAI('01'O, '05'O, omit)}); // @sic R5s221179, R5-253079 sic@
    var template (value) NSSAI v_DefaultConfiguredNSSAI:= { // @sic R5s221179 Baseline Moving sic@
      iei := omit, // not sent over the air so value doesn't matter
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}
      }
    };
    var template (value) S_NSSAI_Type v_Allowed_S_NSSAI := cs_S_NSSAI_WithIEI('22'O, cs_S_NSSAI('01'O, '04'O, omit)); // @sic R5s221179 Baseline Moving sic@

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 2" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Steps 3-11" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 12" siclog@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -, v_ConfiguredNSSAI,
                                                   -, v_GMM_MobilityInfo.SessionStatus);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellG, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Steps 13" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellG); // @sic R5-213117 sic@

    //@siclog "Steps 14-18" siclog@
    f_NR5GC_RRC_Idle_Steps16_20(v_NGC_NASCellG,
                                -,
                                TESTMode_OFF,
                                noRrcConnectionRelease,
                                -, -, -, -, -, -, -, -, -,
                                v_Allowed_S_NSSAI);     // @sic R5-213117 sic@

    //@siclog "Steps 19-20" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Allowed, '000000'O, '00'B);

    //@siclog "Step 21" siclog@
    f_NR_RRCRelease(v_NGC_NASCellG);

    //@siclog "Step 22" siclog@
    // Switch off the UE
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellG, STATE_IDLE_1A);

    //@siclog "Step 23" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 24" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := ({ // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '03'O,
        s_nssai := {cs_S_NSSAI('02'O, '04'O, omit, '01'O)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '03'O,
        s_nssai := {cs_S_NSSAI('02'O, '05'O, omit, '02'O)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '06'O,
        s_nssai := {cs_S_NSSAI('02'O, '04'O, omit, '01'O), cs_S_NSSAI('02'O, '05'O, omit, '02'O)}
        }
      });
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -, v_RequestedNSSAI)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 24");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 24");
    }

    //@siclog "Steps 25-33" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 34" siclog@
    v_AllowedNSSAI := v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg.registration_Request.requestedNSSAI;
    v_AllowedNSSAI.iei := '15'O;
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellG, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Steps 35" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellG); // @sic R5-213117 sic@

    v_Allowed_S_NSSAI := cs_S_NSSAI_WithIEI('22'O, cs_S_NSSAI('02'O, '04'O, omit, '01'O)); // @sic R5-215716, R5s221179 Baseline Moving sic@

    //@siclog "Steps 36-40" siclog@
    f_NR5GC_RRC_Idle_Steps16_20(v_NGC_NASCellG,
                                -,
                                TESTMode_OFF,
                                noRrcConnectionRelease,
                                -, -, -, -, -, -, -, -, -,
                                v_Allowed_S_NSSAI);     // @sic R5-213117 sic@

    //@siclog "Steps 41-42" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Default_Configured);

    //@siclog "Step 43" siclog@
    for (i :=0; i< lengthof(v_DefaultConfiguredNSSAI.lvPart.s_nssai); i := i+1) { // @sic R5s200627, R5s221179 Baseline Moving sic@
      v_LengthOfNSSAI := v_LengthOfNSSAI + oct2int(valueof(v_DefaultConfiguredNSSAI.lvPart.s_nssai[i].iel));  // @sic R5s221179 Baseline Moving sic@
    }
    f_UT_SetDefaultConfiguredNSSAI (UT,  v_LengthOfNSSAI, f_Convert_ListOfNSSAI_ForATCommand(v_DefaultConfiguredNSSAI)); // @sic R5s200339, R5s200627 sic@

    //@siclog "Steps 44-45" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Configured, '000000'O);

    //@siclog "Steps 46-47" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Allowed, '000000'O, '00'B);

    //@siclog "Step 48" siclog@
    f_NR_RRCRelease(v_NGC_NASCellG);

    //@siclog "Step 49" siclog@
    // Switch off the UE
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellG, STATE_IDLE_1A);

    //@siclog "Step 50" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 51" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?);
    v_RequestedNSSAI := ({   // @sic R5s221179 Baseline Moving sic@
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '02'O,
        s_nssai := {cs_S_NSSAI('01'O, '02'O, omit)}
        }
      }, {
      iei := '2F'O,
      lvPart := {
        iel := '04'O,
        s_nssai := {cs_S_NSSAI('01'O, '01'O, omit), cs_S_NSSAI('01'O, '02'O, omit)}
    }});
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -,
                                       v_RequestedNSSAI, -, -, -, -, -, -, -, -, -, -, -, -, -, -,
                                       cs_NetworkSlicingInd('1'B, '0'B))) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 51");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 51");
    }

    //@siclog "Steps 52-60" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 61" siclog@
    v_AllowedNSSAI:= { // @sic R5s230857 sic@
      iei := '15'O,
      lvPart := {
        iel := '06'O,
        s_nssai := {cs_S_NSSAI('02'O, '01'O, omit, '01'O), cs_S_NSSAI('02'O, '02'O, omit, '02'O)}
      }
    };
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   v_AllowedNSSAI,
                                                   -,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus //@sic R5-198509 sic@
                                                   );
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellG, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Steps 62-67" siclog@
    f_NR5GC_RRC_Idle_Steps15_20(v_NGC_NASCellG, TESTMode_OFF, noRrcConnectionRelease);

    //@siclog "Steps 68-69" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Default_Configured);

    //@siclog "Steps 70-71" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Configured, '000000'O);

    //@siclog "Steps 72-73" siclog@
    f_NR5GC_DeleteNSSAI (v_NGC_NASCellG, Delete_Allowed, '000000'O, '00'B);

    //@siclog "Step 74" siclog@
    f_NR_RRCRelease(v_NGC_NASCellG);

    //@siclog "Step 75" siclog@
    // Switch off the UE
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellG, STATE_IDLE_1A);

    //@siclog "Step 76" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Step 77" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?);
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, -, -, -, -, -, -,
                                       omit)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 77");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 77");
    }

    //@siclog "Steps 78-93" siclog@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, TESTMode_OFF);

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_4_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / 5GS services / MICO mode / TAI list handling
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN);
    //@sic R5-242487sic@

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellC);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);// @sic R5-226023 sic@

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_4_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(v_NGC_NASCellC, STATE_CONNECTED_3A);//@sic R5s240115 R5s240433 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_4
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_4_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var float v_Delay := f_NR_SetTimerToleranceMin(v_NGC_NASCellC, nasTimer, 60.0);
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var template (value) B1_Type v_SPRTI := '0'B; // @sic R5-247673 sic@

    //@siclog "Step 0" siclog@
    //The SS configures:
    //- NGC Cell A as the "Non-suitable "Off" cell".//@sic R5-216484sic@
    //- NGC Cell C as the "Non-suitable "Off" cell".//@sic R5-216484sic@
    //@sic R5-242487sic@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 1" siclog@
    //The UE is Switched ON
    f_UT_SwitchOnUE(UT);
    //@siclog "Step 2" siclog@
    //The user requests enabling of MICO mode by MMI or AT command
    f_UT_TriggerMICO(UT,true);
    //@siclog "Step 3" siclog@
    //The SS configures:- NGC Cell A as the "Serving cell".- NGC Cell C as the "Non-suitable "Off" cell".- NGC Cell E as the "Non-suitable "Off" cell".//@sic R5-216484sic@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Steps 4-6" siclog@
    //The UE establishes an RRC connection by executing steps 2-4 of Table 4.5.2.2-2 in TS38.508-1 [4].
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));

    //@siclog "Steps 7" siclog@
    //Check : Does the UE transmit a REGISTRATION REQUEST message including IE MICO indication
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           -,-,-,-,-,-,-,-,-,-,-,
                                           cr_MicoInd(?,'0'B))) // @sic R5-247673 sic@
    {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
        else {
      f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 7 PASS");
    }
    if (ispresent(v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg.registration_Request.micoInd.sprti)) { // @sic R5-247673 sic@
        v_SPRTI := v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg.registration_Request.micoInd.sprti;
    }
    //@siclog "Steps 8-16" siclog@
    //Steps 5-13 of Table 4.5.2.2-2 of the generic procedure in TS 38508-1 [4] are performed
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                v_PLMN,
                                TESTMode_OFF,
                                Initial_NoSecurity);
    //@siclog "Steps 17 siclog@
    //SS transmits a REGISTRATION ACCEPT message that includes IE MICO indication
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellA),
                                                   omit,
                                                   -,-,-,-,-,
                                                   v_GMM_MobilityInfo.SessionStatus, //@sic R5-198509 sic@
                                                   -,-,-,
                                                   cs_MicoInd(v_SPRTI,'1'B)); // @sic R5-247673 sic@
    // Registration Accept
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    //@siclog "Steps 17A siclog@// @sic R5-226023 sic@//@sic R5s240115 sic@
    //The UE transmits a REGISTRATION COMPLETE message.
    f_NR5GC_Registration_Complete(v_NGC_NASCellA);
    //@siclog "Steps 17Aa1 siclog@//@sic R5-233348 sic@
    //Exception
    // The generic procedure for UE-requested PDU session establishmentspecified in subclause 4.5A.2,
    //takes place performing establishment of UE-requested PDU session(s) with ExpectedNumberOfNewPDUSessions = pc_noOf_PDUsSameConnection.
    if (pc_noOf_PDUsSameConnection > 0 ){//@sic R5-227239 sic@
      SRB.check(receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp);//@sic R5s240115 sic@
      if (f_Check_NG_ULNASTransport(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_PayloadContainerType('0001'B), omit,omit,cr_NG_Request_Type('001'B)))
        {
        f_NR5GC_PDUSessionEstablishment (v_NGC_NASCellA,-,tsc_NR_RbId_SRB1);//@sic R5s240115 sic@
        }
      }
    //Prose CR needed for following steps//@sic R5s240433 sic@
    if (pc_noOf_PDUsNewConnection > 0 or pc_noOf_PDUsSameConnection == 0){
      f_NR_RRCRelease(v_NGC_NASCellA);
      f_NR5GC_RRC_Idle_Extension(v_NGC_NASCellA);
    }
    //@siclog "Steps 17B siclog@// @sic R5-226023 sic@
    //Void//@sic R5-233348 sic@
    //@siclog "Steps 18 siclog@
    //The SS releases the RRC Connection
    f_NR_RRCRelease(v_NGC_NASCellA);//@sic R5-233348 sic@
    //@siclog "Steps 19 siclog@
    //The SS configures:- NGC Cell A as the "Non-suitable "Off" cell".- NGC Cell C as the "Serving cell".- NGC Cell E as the "Non-suitable "Off" cell".//@sic R5-216484sic@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    //@siclog "Steps 20 siclog@
    //Check : Does the UE transmit a RRCSetupRequest on NGC Cell C ? This is checked for 60s
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellC, v_Delay, cr_NR_EstablishmentCause_Any, "Step 20: RRCSetupRequest received"); //@sic R5s201387 sic@
    //@siclog "Steps 21 siclog@
    //Void//@sic R5-242487 sic@
    //@siclog "Step 21A-28 siclog@
    //Void//@sic R5-242487 sic@
    //@siclog "Steps 29 siclog@
    //Cause the UE to request connectivity to an PDU session// @sic R5-242487 sic@
     f_UT_RequestPDUSession(UT, f_NR5GC_MobileInfo_GetNoOfSessions()+1, tsc_RandomAPN);
    // @siclog "Steps 30-31" siclog@// @sic R5-242487 sic@
    // Steps 2-3 of the generic procedure for NR RRC_Connected specified in TS 38.508-1 [4] Table 4.5.4.2-3 are performed.
    // @siclog "Step 32" siclog@// @sic R5-242487 sic@
    // The UE transmits an RRCSetupComplete message and a SERVICE REQUEST message with service type IE set to "signalling"?.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu,
                                      cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (),tsc_NasKsi_NativeSecurityContext),
                                      f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellC)), '0000'B)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }
    // @siclog "Steps 33-36" siclog@// @sic R5-242487 sic@
    // Steps 5-8 of the generic procedure for NR RRC_Connected specified in TS 38.508-1 [4] Table 4.5.4.2-3 are performed.
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(v_NGC_NASCellC, v_ReceivedMsg);
    // @siclog "Step 37" siclog@
    // The PDU session establishment procedure as specified in TS 38.508-1 [4] subclause 4.5A.2  take place.
    f_NR5GC_PDUSessionEstablishment (v_NGC_NASCellC,1,tsc_NR_RbId_SRB2);// @sic R5-242487 R5s240433 sic@/
    } //End of fl_TC_9_1_5_1_4_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_5_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Abnormal / Failure after 5 attempts
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0A);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_5_Body();

    f_NR_TestBody_Set(false);
    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_5
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_5_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var float v_T3510Val := f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 15.0);
    var float v_T3511Val := f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 10.0);
    var float v_T3502Val := f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 720.0);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var boolean v_Step17a1 := true; //@sic R5s190938 sic@
    timer t_T3511 ; //@sic R5s190938 sic@

    //@siclog "Step 1" siclog@
    //The SS configures:- NGC Cell A as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 2" siclog@
    //The UE is Switched ON
    f_UT_SwitchOnUE(UT);
    //@siclog "Steps 3-5" siclog@
    //Steps 2-4 of  4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed and the UE transmits a REGISTRATION REQUEST with IE 5GS registration type set to "initial registration"?.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_RRCRelease_Local(v_NGC_NASCellA, f_NR_GetNextSendOccasion_DL(v_NGC_NASCellA));//@sic R5s200260 sic@
    //@siclog "Step 6" siclog@
    //The SS waits 25 seconds (15 seconds T3510 and 10 seconds T3511). (UE's registration attempt counter = 1)
    f_Delay(v_T3510Val);
    f_Delay(v_T3511Val);
    //@siclog "Step 7" siclog@
    //Check: Does the UE transmit a REGISTRATION REQUEST message with IE 5GS registration type set to "initial registration"?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7 PASS");
    }
    //@siclog "Step 8 siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellA);
    //@siclog "Step 8A siclog@
    //The SS waits 10 seconds (T3511). (UE's registration attempt counter = 2)
    //prose CR needed.
    f_Delay(v_T3511Val-(int2float(tsc_NR_DelayAfterRRCRelease) / 1000.0));

    //@siclog "Steps 9-11 siclog@
    //Steps 2-4 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    //Check: Does the UE transmit a REGISTRATION REQUEST message with IE 5GS registration type set to "initial registration"?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11 PASS");
    }
    //@siclog "Steps 12-16 siclog@
    //Steps 5-9 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, Initial_NoSecurity);
    //@siclog "Step 17 siclog@
    //The SS transmits a REGISTRATION REJECT with cause #95 (Semantically incorrect message). (UE's registration attempt counter = 5)
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                       cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_EmmCause_SemanticallyIncorrect)))));
    //@siclog "Step 17A siclog@
    //The SS releases the RRC connection.
    //@sic R5-198952 sic@
    f_Delay(0.1); //@sic R5s250508 sic@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 17Aa1 siclog@
    //IF the UE transmits a REGISTRATION REQUEST message with IE 5GS registration type set to "initial registration" 10s after step 17A.
    //@sic R5-198952 R5s190938 sic@
    t_T3511.start(f_NR_SetTimerToleranceMax(v_NGC_NASCellA, nasTimer, 10.0));
    alt {
        [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellA, cr_38508_RRCSetupRequest()))
        {
               t_T3511.stop;
               f_NR_RRCSetup_Def (v_NGC_NASCellA);
               v_ReceivedMsg := f_NR_RRCSetupComplete_Def(v_NGC_NASCellA,
                                              cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
        }
        [] t_T3511.timeout
        {/*The UE didnt send a REG REQ in 10s*/
            v_Step17a1 := false;
        }
    }

    //@siclog "Step 17Ab1 siclog@
    //ELSE Check: Does the UE transmit a REGISTRATION REQUEST message with IE 5GS registration type set to "initial registration" after 12 minutes after step 17A?
    //(UE's registration attempt counter has been reset to 0 after expiry of T3502)
    //@sic R5-198952 R5s190938 sic@
    if(v_Step17a1 == false){
    f_Delay(v_T3502Val-v_T3511Val-(int2float(tsc_NR_DelayAfterRRCRelease) / 1000.0));

    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity, cr_NG_MobileIdentitySUCI(?,?),'111'B ,-,-,-,-,-,omit)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
      }
      else {
      f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 18 PASS");
      }
    }
    //@siclog "Step 18 siclog@
    //Void
    //@siclog "Steps 19-34 siclog@
    //Steps 5-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA,
                                v_ReceivedMsg,
                                TESTMode_OFF,
                                -,
                                Initial_NoSecurity);
    } //End of fl_TC_9_1_5_1_5_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_6_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Rejected / Illegal UE
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);


    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_6_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_6
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_6_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_Plmn := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var float v_Wait:= 30.0;

    //@siclog "Step 1" siclog@
    //NGC cell A as the "Serving cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Steps 3-14" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_Plmn, TESTMode_OFF, Initial_Secure);

    //@siclog "Steps 15" siclog@
    //The SS transmits a REGISTRATION REJECT message with the 5GMM cause set to 'Illegal UE' as specified.
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_EmmCause_IllegalUe)))));
    //@siclog "Step 16" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 17" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message on NGC cell A in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellA, v_Wait, -, "Step 17: RRCSetupRequest received");  //@sic R5s201387 sic@

    //@siclog "Step 18" siclog@
    //The user initiates Registration Request by MMI or by AT command.
    f_UT_Register(UT);

    //@siclog "Step 19" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq( v_NGC_NASCellA, v_Wait, -, "Step 19: RRCSetupRequest received");    //@sic R5s201387 sic@

    //@siclog "Step 20" siclog@
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_DEREGISTERED);

    //@siclog "Step 21" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 22" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message on NGC Cell A?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?, ?),   //Check the SUCI
                                           tsc_NasKsi_NoKey      //check the NAS key set identifier
                                           )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 22");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    //@siclog "Step 23 - 38" siclog@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity);   // @sic R5s190620 sic@ // @sic R5-237369 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.8
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_8_NR5GC() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN);

    //Create and configure cell
    f_NR_CellConfig_Def(v_NGC_NASCellE);
    f_NR_CellConfig_Def(v_NGC_NASCellI);
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    //
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-205866 R5-217816 sic@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE); //@sic R5-194879 R5-217816 sic@


    f_NR5GC_Preamble (v_NGC_NASCellE, STATE_OFF_0B);
    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_8_TestBody();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellE, STATE_IDLE_1A);//@sic R5s200154 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_8
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_8_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellE);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var AccessStratumRelease v_AccessStratumRelease;//@sic R5s210768 sic@
    var SecurityHeaderType v_SecurityHeader;//@sic R5s210768 sic@
    var TypeOfRegistration_Type v_RegType;//@sic R5s210768 sic@
    timer t_Wait := 30.0;

    //The UE is switched on
    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@
    //Steps 2-9 of Table 4.5.2.2-2 in TS38.508-1 [4] are performed on NGC Cell E.
    //@siclog "Step 2-9" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellE, v_ReceivedMsg, v_PLMN, Initial_Secure);
    //The SS transmits a REGISTRATION REJECT with cause #73 (Serving network not authorized).
    //@siclog "Step 10" siclog@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,//@sic R5s200154 sic@
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_NR5GCCause_ServNetNotAuthorized)))));
    //The SS releases RRC connection.
    //@siclog "Step 11" siclog@
    f_NR_RRCRelease(v_NGC_NASCellE);
    //@siclog "Step 11A" siclog@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1);//@sic R5-205866 sic@
    //@siclog "Step 12" siclog@
    //Check: Does the UE send in the next 30 sec a request for RRC connection establishment on Cell E or Cell I.
    t_Wait.start;
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellE, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12: RRCSetupRequest received");
        }
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellI, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12: RRCSetupRequest received");
        }
      [] t_Wait.timeout {}
    }

    //@siclog "Step 13" siclog@
    //The SS configures-NGC Cell A as "Serving Cell"?
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 14" siclog@
    //Check: Does the UE perform Registration procedure on NGC Cell A as specified in TS 38.508-1 [4] subclause 4.5.2?
    v_AccessStratumRelease:= f_NR_MobileInfo_NRCap_Get_AccessStratumRelease();//@sic R5s210768 sic@
    if (v_AccessStratumRelease == rel15){//@sic R5s210768 R5s211329 sic@
      v_SecurityHeader:= tsc_SHT_IntegrityProtected;//@sic R5s210768 sic@
      v_RegType:= Initial_Secure;//@sic R5s210768 sic@
    }
    else {
      v_SecurityHeader:= tsc_SHT_NoSecurityProtection;//@sic R5s210768 sic@
      v_RegType:= Initial_NoSecurity;//@sic R5s210768 sic@
    }
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, v_SecurityHeader);//@sic R5 200154 sic@//@sic R5s210768 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, v_RegType)) {//@sic R5s210768 sic@
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
      }
      else {
      f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 14");
      }

    //Steps 5-20 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA,
                                v_ReceivedMsg,
                                TESTMode_OFF,
                                -,
                                v_RegType);//@sic R5s211609 sic@
     //@siclog "Step 14A" siclog@//@sic R5-203413, R5s201113 sic@
    // Switch off procedure in RRC_IDLE specified in TS 38.508-1 subclause 4.9.6.1 is performed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellA, STATE_IDLE_1A);

    //@siclog "Step 15" siclog@
    //The SS configures-NGC Cell A as "Non-suitable "Off" cell" - NGC Cell I as "Non-suitable "Off" cell"?
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-194879, R5-203413, R5s201113 sic@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-210191 sic@
    //@siclog "Step 15A" siclog@//@sic R5-203413, R5s201113 sic@
    // The UE is brought back to operation or the USIM is inserted. The UE is powered on or switched on.
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 16" siclog@
    //Set the UE in manual PLMN selection mode or request a PLMN search.
    //@siclog "Step 17" siclog@
    //The user selects the PLMN of NGC Cell E.
    f_UT_ManualPLMN_Select (UT, v_PLMN);
    //@siclog "Step 18" siclog@
    //The UE performs Registration procedure on NGC Cell E as specified in TS 38.508-1 [4] subclause 4.5.2 with 'connected without release'.
    f_NR5GC_RRC_IdleState1N_Def(v_NGC_NASCellE);//@sic R5-200102, R5s200154 sic@
    //@siclog "Step 19" siclog@
    //Set the UE in Automatic PLMN selection mode.
    f_UT_AutomaticPLMN_Select(UT);
    //@siclog "Step 20" siclog@ //@sic R5-210322 sic@
    //wait 300 seconds to let UE complete automatic PLMN search
    f_Delay(300.0);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.9
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_9_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Abnormal / Change of cell into a new tracking area
    // Imported in NR5GC_RRC_Templates -> const PagingCycle tsc_NR_RAN_PagingCycle_Def :=  rf32;    //@sic R5-202659 sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);


    f_NR5GC_Init_NAS(NR_1);

    f_NR_CellInfo_SetSIB1_DefaultPagingCycle(v_NGC_NASCellA, tsc_NR_RAN_PagingCycle_Def);   //@sic R5-202659 sic@

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_9_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_9
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_9_Body() runs on NR5GC_PTC
  { //@sic R5-202659 R5s201101 R5-201087 sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_Plmn := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var TrackingAreaCode v_TAC;
    var NR_SRB_COMMON_IND v_ReceivedAsp;  //@sic R5s201101 sic@
    timer t_T3510;

    //@siclog "Step 1 - void" siclog@

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Step 3 - 14" siclog@
    //Steps 2 - 13 of Table 4.5.2.2-2 in TS38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    t_T3510.start(f_NR_SetTimerToleranceMax(v_NGC_NASCellA, nasTimer, 15.0));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_Plmn, TESTMode_OFF, Initial_Secure);

    //@siclog "Step 15" siclog@
    //SS does not send REGISTRATION ACCEPT to the UE and update TAC value in SIB1.
    f_NR_CellInfo_SetTAC(v_NGC_NASCellA, int2bit(2,24));    //@sic R5-197081 sic@

    //@siclog "Step 15A - void" siclog@

    //@siclog "Step 16" siclog@
    //The SS notifies the UE of change of System Information on NGC Cell A by sending Short Message on PDCCH using P-RNTI.
    f_NR_ModifySysinfo(v_NGC_NASCellA,
                       -, RRC_CONNECTED     //@sic R5s201613 sic@
                       );

    //@siclog "Step 16A-28 - void" siclog@

    //@siclog "Step 29" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message before the 15 second timer (T3510) started in step 5 expires?
    alt {
      [] SRB.receive(car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, tsc_NR_RbId_SRB1, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp    //@sic R5s201101 sic@
        {
          t_T3510.stop;
          v_ReceivedMsg := v_ReceivedAsp.Signalling.Nas[0];  //@sic R5s201101 sic@
          if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu,
                                                ?    //@sic R5s201381 sic@
                                                )) {
             f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
             }
          if (match(v_ReceivedMsg.Pdu.Msg.registration_Request.registrationType.registrationType, tsc_NG_RegistrationInitial))   //@sic R5s201381 sic@
            {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 29");
            } else {
             f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Type incorrect");
          }
        }
      [] t_T3510.timeout
        {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
        }
    }

    //@siclog "Step 29A1" siclog@
    //@sic R5-204460 sic@
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_Plmn, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA));
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_Plmn, {bit2oct(v_TAC)});
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList);
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    // @siclog "Step 29A2" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellA);     //@sic R5-204460 sic@

    //@siclog "Step 30" siclog@
    f_NR5GC_RRC_Idle_Steps16_20(v_NGC_NASCellA);   //@sic R5-204460 sic@

  }//End of fl_TC_9_1_5_1_9_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.10
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_10_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Rejected / PLMN not allowed
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN, NR5GC_NAS_ReplaceNRf3_NRf1);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellG);
    f_NR_CellConfig_Def(v_NGC_NASCellI);

    f_NR5GC_Preamble (v_NGC_NASCellG, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_10_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellG, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_10
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_10_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellG);
    var NAS_PlmnId v_Plmn := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var float v_Wait1:= 90.0;
    var float v_Wait2:= 30.0;

    //@siclog "Step 1" siclog@
    f_NR_SetCellPower (v_NGC_NASCellG, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 3" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Steps 4-11" siclog@
    //Steps 2-9 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, v_Plmn, Initial_Secure);

    //@siclog "Steps 12" siclog@
    //The SS transmits an REGISTRATION REJECT message including an appropriate 5GMM cause value #11 (PLMN not allowed).
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellG,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_PLMN_NotAllowed)))));
    //@siclog "Step 13" siclog@
    f_NR_RRCRelease(v_NGC_NASCellG);

    //@siclog "Step 14" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message on NGC cell G in the next 90 seconds?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellG, v_Wait1, -, "Step 14: RRCSetupRequest received");   //@sic R5s201387 sic@

    //@siclog "Step 15" siclog@
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellG, STATE_DEREGISTERED);

    //@siclog "Step 16" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 17" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellG, v_Wait2, -, "Step 17: RRCSetupRequest received");   //@sic R5s201387 sic@

    //@siclog "Step 18" siclog@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2);

    //@siclog "Step 20-22" siclog@
    //The UE establishes RRC connection by executing steps 2-4 of Table 4.5.2.2-2 in TS 38.508-1 [4]
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellI, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);

    //@siclog "Step 23" siclog@
    //Check: Does the UE transmit an REGISTRATION REQUEST message as specified?
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 23");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 23");

    //@siclog "Step 24-39a1" siclog@
    //Steps 5-19a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellI, v_ReceivedMsg, TESTMode_OFF, noRrcConnectionRelease, Initial_NoSecurity); // @sic R5-198948 sic@

    //@siclog "Step 40" siclog@
    //The generic test procedure in TS 38.508-1 Table 4.9.6.3-1 of Switch off procedure in RRC_CONNECTED are performed.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellI, STATE_CONNECTED_3A); // @sic R5-198948 sic@
    //@siclog "Step 40A" siclog@
    f_NR_SetCellPower (v_NGC_NASCellG, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);      // @sic R5-198948 sic@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);       // @sic R5-198948 sic@
    //@siclog "Step 40B" siclog@
    //The UE is brought back to operation or the USIM is inserted. The UE is powered on or switched on.
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299, R5-198948 sic@

    //@siclog "Step 40C" siclog@
    //The user sets the UE in manual PLMN selection mode or requests a PLMN search.
    //@siclog "Step 41" siclog@
    //The user selects PLMN of NGC Cell G.
    f_UT_ManualPLMN_Select (UT, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellG)));

    //@siclog "Step 42-60a1" siclog@
    //Steps 2 to 20a1 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2 are performed on NGC Cell G.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);  // @sic R5s200134 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure, f_NR5GC_GetMobileIdGUTI (v_NGC_NASCellI,omit))) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }  // @sic R5s200134 sic@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, TESTMode_OFF); // @sic R5s200134 sic@

    //@siclog "Step 61" siclog@
    //The user sets the UE in Automatic PLMN selection mode.
    f_UT_AutomaticPLMN_Select(UT);
    //@siclog "Step 62" siclog@ //@sic R5-210322 sic@
    //wait 300 seconds to let UE complete automatic PLMN search
    f_Delay(300.0);

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.11
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_11_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Rejected / Tracking area not allowed
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_2);    // @sic R5s200830 sic@

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_11_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_11
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_11_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var NasCount_Type v_NasCount;
    var float v_Wait:= 30.0;
    timer t_Wait:= 30.0;

    //@siclog "Step 1" siclog@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);   //@sic R5-216490 sic@

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Steps 3-14" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13(v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Steps 15" siclog@
    //The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #12 "Tracking area not allowed".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_TA_NotAllowed)))));
    //@siclog "Step 16" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 17" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell A in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq( v_NGC_NASCellA, v_Wait, -, "Step 17: RRCSetupRequest received");   //@sic R5s201387 sic@

    //@siclog "Step 18" siclog@
    //The SS reconfigures: - NGC cell B as the "Serving cell". - NGC cell A as a "Non-Suitable Neighbour cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);   // @sic R5-199101 R5-216490 sic@
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 19" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell B?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 19");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    //@siclog "Step 20-26" siclog@
    //Steps 5 to 11 from procedure in TS 38.508-1 [4] Table 4.5.2.2-2 are performed.
    v_NasCount :=f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellB, v_ReceivedMsg, f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellB)), Initial_NoSecurity);
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(v_GMM_MobilityInfo);
    f_NR_RRC_ActivateSecurity (v_NGC_NASCellB, v_NasCount); // Use NasCount returned from NAS S.M. Complete

    //@siclog "Step 27" siclog@
    //The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #12 " "Tracking area not allowed".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellB,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_TA_NotAllowed)))));

    //@siclog "Step 28" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellB);

    //@siclog "Step 28A" siclog@
    //The SS reconfigures:- NGC cell A as a "Suitable neighbour intra-frequency cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);  // @sic R5-199101 sic@

    //@siclog "Step 29" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message in the next 30 seconds on NGC Cell A or NGC Cell B?
    t_Wait.start;
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellB, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 29: RRCSetupRequest received");
        }
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellA, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 29: RRCSetupRequest received");
        }
      [] t_Wait.timeout {}
    }

    //@siclog "Step 30" siclog@
    //Switch off UE in State Deregistered as described in TS38.508-1 [4] subclause 4.9.6.4.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellB, STATE_DEREGISTERED);

    //@siclog "Step 31" siclog@
    //The SS reconfigures: - NGC cell A as the "Serving cell". - NGC cell B as "Non-suitable off cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    //@sic R5-216490 sic@

    //@siclog "Step 32" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 33" siclog@
    //Check: Does the UE transmit a REGISTRATION REQUEST message on NGC Cell A?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 33");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 33");

    //@siclog "Step 42-60a1" siclog@
    //Steps 5-19a1 of Table 4.5.2.2-2 in TS38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.12
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_12_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Rejected / Roaming not allowed in this tracking area
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_1, NG_CellsOnDifferentPLMN, NR5GC_NAS_ReplaceNRf3_NRf2);

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellC);
    f_NR_CellConfig_Def(v_NGC_NASCellE);
    f_NR_CellConfig_Def(v_NGC_NASCellI);

    f_NR5GC_Preamble (v_NGC_NASCellE, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_12_Body();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellC, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_1_5_1_12
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_12_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellI := f_NR5GC_MapNASCell(ngc_CellI, NG_CellsOnDifferentPLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellE);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var NasCount_Type v_NasCount;
    var float v_Wait:= 30.0;
    timer t_Wait:= 30.0;

    //@siclog "Step 1" siclog@
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    //@sic R5-216491 sic@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    //@sic R5-216491 sic@

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Steps 3-14" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13(v_GMM_MobilityInfo, v_NGC_NASCellE, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure);

    //@siclog "Steps 15" siclog@
    //The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #13 " roaming not allowed in this tracking area ".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_Roaming_NotAllowed)))));
    //@siclog "Step 16" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellE);

    //@siclog "Step 17" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell E in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellE, v_Wait, -, "Step 17: RRCSetupRequest received");   //@sic R5s201387 sic@

    //@siclog "Step 18" siclog@
    //The SS reconfigures: - NGC cell I as the "Serving cell". - NGC cell E as a "Suitable Neighbour cell", - NGC cell C as "Non-suitable cell".
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);      //@sic R5-216491 sic@
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 19" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell I?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellI, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 19");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");

    //@siclog "Step 20-26" siclog@
    //Steps 5 to 11 from procedure in TS 38.508-1 [4] Table 4.5.2.2-2 are performed.
    v_NasCount :=f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellI, v_ReceivedMsg,
                                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellI)),
                                                Initial_NoSecurity);
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(v_GMM_MobilityInfo);
    f_NR_RRC_ActivateSecurity (v_NGC_NASCellI, v_NasCount); // Use NasCount returned from NAS S.M. Complete

    //@siclog "Step 27" siclog@
    //The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #13 " roaming not allowed in this tracking area ".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellI,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit,
                                   tsc_Cause_Roaming_NotAllowed // @sic R5s200138 sic@
                                   )))));

    //@siclog "Step 28" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellI);

    //@siclog "Step 29" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message in the next 30 seconds on NGC cell I?
    t_Wait.start;
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellI, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 29: RRCSetupRequest received");
        }
      [] t_Wait.timeout {}
    }

    //@siclog "Step 30" siclog@
    //Switch off UE in State Deregistered as described in TS38.508-1 [4] subclause 4.9.6.4.
    f_NR_UE_DeRegisterOnSwitchOff (v_NGC_NASCellI, STATE_DEREGISTERED);

    //@siclog "Step 31" siclog@
    //The SS reconfigures: - NGC cell E as the "Serving cell". - Other NGC cells as "Non-suitable cell".
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellI, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);    //@sic R5-216491 sic@

    //@siclog "Step 32" siclog@
    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@

    //@siclog "Step 33" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell E?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 33");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 33");

    //@siclog "Step 34-42" siclog@
    //Steps 5 to 13 from procedure in TS 38.508-1 [4] Table 4.5.2.2-2 are performed.
    f_NR5GC_RRC_Idle_Steps5_13(v_GMM_MobilityInfo, v_NGC_NASCellE, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_NoSecurity);

    //@siclog "Step 43" siclog@
    //The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #13 " roaming not allowed in this tracking area ".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit,
                                   tsc_Cause_Roaming_NotAllowed // @sic R5s200138 sic@
                                   )))));

    //@siclog "Step 44" siclog@
    //The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellE);

    //@siclog "Step 45" siclog@
    //The SS reconfigures: - NGC Cell E as the "Serving cell", - NGC Cell C as a "Suitable neighbour cell". - NGC Cell I as "Non-suitable cell".
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);      //@sic R5-216491 sic@
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);      //@sic R5-216491 sic@

    //@siclog "Step 46" siclog@
    //Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell C?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           cr_NG_MobileIdentitySUCI(?,?),   //Check the SUCI
                                           tsc_NasKsi_NoKey,      //check the NAS key set identifier
                                           -, -, -, -, -, omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 46");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 46");

    //@siclog "Step 47-62" siclog@
    //Steps 5-20 of Table 4.5.2.2-2 in TS38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellC, v_ReceivedMsg, TESTMode_OFF, -, Initial_NoSecurity);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.13
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_13_NR5GC() runs on NR5GC_PTC
  {
    //Initial registration / Rejected / No suitable cells in tracking area
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_1);

    f_NR_CellInfo_SetTAC (v_NGC_NASCellA, int2bit(1,24));
    f_NR_CellInfo_SetTAC (v_NGC_NASCellB, int2bit(1,24));
    f_NR_CellInfo_SetTAC (v_NGC_NASCellC, int2bit(2,24));

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);
    f_NR_CellConfig_Def(v_NGC_NASCellC);

    //Preamble
    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B); //@sic R5s200142 sic@

    f_NR_TestBody_Set(true);//@sic R5s200142 sic@

    fl_TC_9_1_5_1_13_Body();

    f_NR_TestBody_Set(false);//@sic R5s200142 sic@

    // Finish
    f_NR_Postamble(v_NGC_NASCellC, STATE_CONNECTED_3A);//@sic R5s200142 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_13
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_13_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellC := f_NR5GC_MapNASCell(ngc_CellC, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_Plmn := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    timer t_Wait := 30.0;   //@sic R5-216492 sic@

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Step 2-9" siclog@
    //Steps 2-9 of Table 4.5.2.2-2 in TS38.508-1 [4] are performed on NGC Cell A
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, v_Plmn, Initial_Secure);

    //@siclog "Steps 10" siclog@
    //The SS transmits a REGISTRATION REJECT with cause #15 (No suitable cells in tracking area).
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_NR5GCCause_NoSuitableCellsInTA)))));

    //@siclog "Step 11" siclog@
    //The SS releases RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 12" siclog@
    //Check: Does the UE transmit a REGISTRATION REQUEST message on NGC Cell A in the next 30 seconds?
    //@sic R5-216492 sic@
    t_Wait.start;
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellA, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12: RRCSetupRequest received");
        }
      [] t_Wait.timeout {}
    }

    //@siclog "Step 12A" siclog@
    //The SS configures NGC CellB as "Serving Cell",NGC Cell A and Cell C as "Non-suitable "Off" cell"
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 12B" siclog@
    //Check: Does the UE transmit a REGISTRATION REQUEST message on NGC Cell B in the next 30 seconds?
    t_Wait.start;
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellB, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_Wait.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12B: RRCSetupRequest received");
        }
      [] t_Wait.timeout {}
    }

    //@siclog "Step 13" siclog@
    //The SS configures NGC Cell C as "Serving Cell", NGC Cell A and Cell B as "Non-suitable "Off"cell"
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellC, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 14" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellC, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                        cr_NG_MobileIdentitySUCI(?, ?),   //Check the SUCI
                        tsc_NasKsi_NoKey      //check the NAS key set identifier
                        )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    //@siclog "Step 15-29" siclog@
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo,
                                v_NGC_NASCellC,
                                v_ReceivedMsg,
                                TESTMode_OFF,
                                noRrcConnectionRelease,
                                Initial_NoSecurity);//@sic R5s200142 sic@
    } //End of fl_TC_9_1_5_1_13_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.14
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_14_NR5GC() runs on NR5GC_PTC
  { //Initial registration / Rejected / Congestion / Abnormal / T3346
    //@sic R5-196287sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    f_NR5GC_Init_NAS(NR_2, NG_CellsOnDifferentPLMN);//@sic R5-194868 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);
    f_NR_CellConfig_Def(v_NGC_NASCellE);
    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0A);// @sic R5-192340 sic@
    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_14_TestBody();

    f_NR_TestBody_Set(false);

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);// @sic R5-204463 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_14
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_14_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellE := f_NR5GC_MapNASCell(ngc_CellE, NG_CellsOnDifferentPLMN);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NasCount_Type v_NasCount;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    timer t_T3346 := f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 180.0);

    //@siclog "Step 0" siclog@
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    //@siclog "Step 0A" siclog@
    //The UE is Switched/Powerd ON
    f_UT_SwitchOnUE(UT);//@sic R5-194868 sic@
    //@siclog "Step 1-12" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));//@sic R5s201207 sic@
      if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {//@sic R5s200305 sic@
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
      }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellE, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellE)),
                                TESTMode_OFF,
                                Initial_NoSecurity);//@sic R5s200305 sic@
    //SS transmits a REGISTRATION REJECT message with cause #22 (Congestion) and T3346 set to 3 minutes.
    //@siclog "Step 13" siclog@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_NR5GCCause_Congestion), cs_GPRS_Timer2_3_IEI('5F'O, '001'B, '00011'B)))));
    t_T3346.start;
    //@siclog "Step 14" siclog@
    //The SS releases the RRC connection
    f_NR_RRCRelease(v_NGC_NASCellE);
    //@siclog "Step 15" siclog@
    // Check : Does the UE transmit a RRCSetupRequest on NGC Cell E within T3346 of step 13?
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellE, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_T3346.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4: RRCSetupRequest received");
        }
      [] t_T3346.timeout {}
    }
    //@siclog "Step 16" siclog@
    //Check : Does the UE transmit a REGISTRATION REQUEST on NGC Cell E
    //@sic R5s200305,R5-201144 sic@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellE, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 16: PASS");

    //@siclog "Step 17-25" siclog@
    //Void//@sic R5s200305,R5-201144 sic@

    //@siclog "Step 26" siclog@
    //SS transmits a REGISTRATION REJECT message with cause #22 (Congestion) and T3346 set to 3 minutes.
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellE,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_NR5GCCause_Congestion), cs_GPRS_Timer2_3_IEI('5F'O, '001'B, '00011'B)))));
    t_T3346.start;

    //@siclog "Step 27" siclog@
    //The SS releases the RRC connection
    f_NR_RRCRelease(v_NGC_NASCellE);
    //@siclog "Step 28" siclog@
    //The SS configures:- NGC Cell A as the "Non-suitable "Off" cell".- NGC Cell B as the "Serving cell".- NGC Cell E as the "Non-suitable "Off" cell".
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-216493 sic@
    f_NR_SetCellPower (v_NGC_NASCellE, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-216493 sic@
    //@siclog "Step 29" siclog@
    //Check : Does the UE transmit a REGISTRATION REQUEST on NGC Cell B within T3346 minutes of Step 26.
    //@sic R5s200305,R5-201144 sic@
    alt {
      [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellB, cr_38508_RRCSetupRequest)))
        {
          v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
          if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
          }
          t_T3346.stop;
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 29: PASS");
        }
      [] t_T3346.timeout {}
    }
    //@siclog "Step 30-38" siclog@
    //Steps 5-11 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    //@sic R5s200305,R5-201144 sic@
    //Steps 5-9 of Table 4.5.2.2-2
    v_NasCount := f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, v_NGC_NASCellB, v_ReceivedMsg, v_PLMN, Initial_Secure);
    //Steps 10-11 of Table 4.5.2.2-2
    f_NR_RRC_ActivateSecurity (v_NGC_NASCellB, v_NasCount);

    //@siclog "Step 39" siclog@
    //SS transmits a REGISTRATION REJECT message with cause #22 (Congestion) and T3346 set to 3 minutes.
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellB,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_NR5GCCause_Congestion), cs_GPRS_Timer2_3_IEI('5F'O, '001'B, '00011'B)))));

    t_T3346.start;
    //@siclog "Step 40" siclog@
    //The SS releases the RRC connection
    f_NR_RRCRelease(v_NGC_NASCellB);
    //@siclog "Step 41" siclog@
    //The SS configures:- NGC Cell A as the "Serving cell".- NGC Cell B as the "Non-suitable "Off" cell".- NGC Cell E as the "Non-suitable "Off" cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);//@sic R5-216493 sic@
    //@siclog "Step 42" siclog@
    //Check : Does the UE transmit a RRCSetupRequest on NGC Cell A within T3346 minutes of Step 39(Note 1)
    //@siclog "Step 43" siclog@
    //Check : Does the UE transmit a REGISTRATION REQUEST on NGC Cell A
    alt {
      [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellA, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any)))
        {
          t_T3346.stop;
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 42: RRCSetupRequest received");
        }
      [] t_T3346.timeout
        { //@sic R5s200305,R5-201144 sic@
          v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
          if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
          }
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 43: RRCSetupRequest received");
        }
      }
    //@siclog "Step 44 -74b1" void siclog@
    //@sic R5-204463 sic@
    //@siclog "Step 75-90a1" siclog@
    //Steps 5-20a1 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo,v_NGC_NASCellA,v_ReceivedMsg,TESTMode_OFF);//@sic R5-204463 sic@
   } //End of fl_TC_9_1_5_1_14_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.5.1.15
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_5_1_15_NR5GC() runs on NR5GC_PTC
  { //Initial registration / Success / Extended and spare fields in Registration Accept message
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    f_NR5GC_Init_NAS(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);
    f_NR_TestBody_Set(true);

    fl_TC_9_1_5_1_15_TestBody();

    f_NR_TestBody_Set(false);

    //Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);     //@sic R5-220367 sic@
  }

  /*
   * @desc      test body of TC_9_1_5_1_15
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_5_1_15_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var TrackingAreaCode v_TAC;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var UE_NR_Capability v_NrCapability;

    //@siclog "Step 1" siclog@
    f_NR5GC_SwitchOnAndResetIMS();  // @sic R5s210729 sic@

    //@siclog "Step 2" siclog@
    //Check: Does the UE transmit a REGISTRATION REQUEST message?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
      if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
      }

    //@siclog "Step 3-14" siclog@
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                v_NGC_NASCellA, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                                TESTMode_OFF);

    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);
    v_TAIList := cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), {bit2oct(v_TAC)});

    //@siclog "Step 15" siclog@
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, cs_EmptyRANTimingSync);  //@sic R5-245202 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    //@siclog "Step 16" siclog@
    f_NR5GC_Registration_Complete(v_NGC_NASCellA);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");

    //@siclog "Step 17a1-18a1" siclog@
    f_NR5GC_RRC_Idle_Steps16_20 (v_NGC_NASCellA, -, -, rrcConnectionRelease);   //@sic R5s211673 R5-220367 sic@

    v_NrCapability := f_NR_MobileInfo_NRCap_Get();
    if (match (v_NrCapability.accessStratumRelease, rel18))
    { //@sic R5-213385 R5-245202 sic@
      f_SetVerdictInconc(__FILE__, __LINE__, "Test Case applicable to Rel-15 to Rel-17 UE");
    }
   } //End of fl_TC_9_1_5_1_15_Body

}
