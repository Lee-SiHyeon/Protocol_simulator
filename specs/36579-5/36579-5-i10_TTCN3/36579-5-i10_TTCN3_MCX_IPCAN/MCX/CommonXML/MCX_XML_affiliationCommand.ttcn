module MCX_XML_affiliationCommand {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from XSD all;
  import from urn_3gpp_ns_affiliationCommand_1_0 language "XSD" all;

  type Command_list MCX_Affiliation_CommandList_Type;         /* @status    APPROVED (MCX) */

  template (value) Affiliate_command cs_MCX_AffiliateCmd(XSD.AnyURI p_Group) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    group_list := { p_Group },
    elem_list := {},
    anyExt := omit
  };

  template (value) MCX_Affiliation_CommandList_Type cs_MCX_Affiliation_AffiliateCmd(XSD.AnyURI p_Group) :=
  { /* 36.579-1 Table 5.5.3.7-1 */
    /* @status    APPROVED (MCX) */
    affiliate := cs_MCX_AffiliateCmd(p_Group),
    de_affiliate := omit,
    anyExt := omit,
    elem_list := {}
  };

  template (present) MCX_Affiliation_CommandList_Type cr_MCX_Affiliation_AffiliateCmd(XSD.AnyURI p_Group) := cs_MCX_Affiliation_AffiliateCmd(p_Group); /* ... as long as there are no matching pattern
                                                                                                                                                          @status    APPROVED (MCX) */

  /*
   * @desc      Encode Affiliation Command
   * @param     p_CommandList
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_AffiliationCommand_Encode(template (value) Command_list p_CommandList) return XmlBody_Type
  {
    var bitstring v_EncodedAffiliationCommand := encvalue(p_CommandList);
    return f_Bit2XmlBody(v_EncodedAffiliationCommand);
  }

  /*
   * @desc      Decode Affiliation Command
   * @param     p_XmlDocument
   * @return    MCX_Affiliation_CommandList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_AffiliationCommand_Decode(XmlBody_Type p_XmlDocument) return MCX_Affiliation_CommandList_Type
  {
    var bitstring v_Bitstring := f_XmlBody2Bit(p_XmlDocument);
    var Command_list v_Command_list;

    if (decvalue(v_Bitstring, v_Command_list) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode Affiliation");
    }
    return v_Command_list;
  }

}
