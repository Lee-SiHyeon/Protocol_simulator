module MCX_XML_poc_settings {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from XSD all;
  import from urn_3gpp_mcsSettings_1_0 language "XSD" all;
  import from urn_oma_params_xml_ns_poc_poc_settings language "XSD" all;

  type Poc_settingsType PocSettings_Type;                                       /* @status    APPROVED (MCX) */

  type Selected_user_profile_indexType PocSettings_SelectedProfileIndex_Type;   /* @status    APPROVED (MCX) */

  template (present) AmSettingType cr_AmSetting(template (present) AmSettingType.answer_mode p_AnswerMode) :=
  { /* <am-settings> */
    /* @status    APPROVED (MCX) */
    attr := omit,
    answer_mode := p_AnswerMode,
    elem_list := {}
  };

  template (present) EntityType cr_PocSettingsEntity(template (present) AmSettingType.answer_mode p_AnswerMode) :=
  { /* single <entity> element with <am-settings> and (any) extension */
    /* @status    APPROVED (MCX) */
    id := ?,
    attr := omit,
    isb_settings := omit,
    am_settings := cr_AmSetting(p_AnswerMode),
    ipab_settings := omit,
    sss_settings := omit,
    elem_list := { ? }  // extension: <selected-user-profile-index> according to 36.579-1 Table 5.5.3.11-1
  };

  template (present) Poc_settingsType cr_PocSettings(template (present) AmSettingType.answer_mode p_AnswerMode := ?) :=
  { /* <poc-settings> with <am-settings> and (any) extension */
    /* @status    APPROVED (MCX) */
    attr := omit,
    entity_list := {
      cr_PocSettingsEntity(p_AnswerMode)
    },
    elem_list := {}
  };

  /*
   * @desc      Decode POC settings
   * @param     p_XmlDocument
   * @return    PocSettings_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_PocSettings_Decode(XmlBody_Type p_XmlDocument) return PocSettings_Type
  {
    var bitstring v_Bitstring := f_XmlBody2Bit(p_XmlDocument);
    var Poc_settings v_PocSettings;

    if (decvalue(v_Bitstring, v_PocSettings) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode PoC-Settings");
    }
    return v_PocSettings;
  }

  template (present) Selected_user_profile_indexType cr_SelectedUserProfileIndex(XSD.NonNegativeInteger p_ProfileIndex) :=
  { /* <selected-user-profile-index>; extension according to 24.379 clause 7.4.1 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    user_profile_index := p_ProfileIndex,
    elem_list := {}
  };

  /*
   * @desc      Decode <selected-user-profile-index>
   * @param     p_XsdString
   * @return    Selected_user_profile_indexType
   * @status    APPROVED (MCX)
   */
  function f_MCX_PocSettings_SelectedUserProfileIndex_Decode(XSD.String p_XsdString) return Selected_user_profile_indexType
  {
    var bitstring v_Bitstring := f_XsdString2Bit(p_XsdString);
    var Selected_user_profile_index v_ProfileIndex;

    if (decvalue(v_Bitstring, v_ProfileIndex) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode PoC-Settings' ProfileIndex");
    }
    return v_ProfileIndex;
  }

  /*
   * @desc      Encode poc-settings
   * @param     p_Poc_settings
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_PocSettings_Encode(template (value) Poc_settings p_Poc_settings) return XmlBody_Type
  {
    return f_Bit2XmlBody(encvalue(p_Poc_settings));
  }

}
