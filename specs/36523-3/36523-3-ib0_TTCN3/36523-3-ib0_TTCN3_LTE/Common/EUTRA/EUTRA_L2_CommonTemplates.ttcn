    Request := {
      Cell := {
        AddOrReconfigure := {
          Basic := omit,
          Active := {
            C_RNTI := omit,
            PhysicalLayerConfigUL := omit,
            RachProcedureConfig := omit,
            CcchDcchDtchConfig := {
              MeasGapCtrl := omit,
              DL := {
                DciInfo := p_DciDlInfo,
                AntennaInfo := p_AntennaInfoDedicated,
                HarqProcessConfig := p_HarqProcessConfigDL
              },
              UL := omit,
              DrxCtrl := omit,
              TtiBundling := omit,
              CifPresence := omit
            },
            ServingCellConfig := omit,
            SciSchedulingConfig := omit, //@sic R5w160202 sic@
            EIMTA_Config := omit, //@sic R5w160203r1 sic@
            CE_Mode := omit //@sic R5w160205 sic@
          }
        }
      }
    }
  };

