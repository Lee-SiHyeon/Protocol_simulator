module NR5GC_POS_Component {

  import from EUTRA_OTDOA_NR_CoordMsg all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_POS_ASP_TypeDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from PosSystem_ASP_TypeDefs all;

  type component NR5GC_POS_PTC extends NR5GC_PTC {  /* @status    APPROVED (POS) */
    port POS_PTC_MTC_PORT             POSSYS;       // coordination port to be connected to the MTC
    port E_OTDOA_NR_CO_ORD_PORT       OTDOA;        // coordination port to be connected to the EUTRA_OTDOA component (to be used for OTDOA Rel-15)
    port NR_SYSTEM_POSEXT_PORT        SYS_POSEXT;   // extension of the SYS port (for DL-PRS config); Rel-16 upgrade
  };

  type component NR_POS_SYSTEM extends NR_BASE_SYSTEM { /* @status    APPROVED (POS) */
    port NR_SYSTEM_POSEXT_PORT  NR_SYS_POSEXT; //Rel-16 upgrade
  };

  /*
   * @desc      Default error handler for NR5GC POS PTC
   * @status    APPROVED (POS)
   */
  altstep a_NR5GC_POS_DefaultExtension() runs on NR5GC_POS_PTC
  {
    [] SYS_POSEXT.receive { //Rel-16 upgrade
      all timer.stop;
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected receive event at SYS_POSEXT port");
    }
    [] OTDOA.receive {
      all timer.stop;
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected receive event at OTDOA port");
    }
    [] POSSYS.receive {
      all timer.stop;
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected receive event at POSSYS port");
    }
  }

  /*
   * @desc      initialisation of the NR5GC_POS PTC
   * @param     p_NR_SysinfoCombination
   * @status    APPROVED (POS)
   */
  function f_NR5GC_POS_Init(NR_SysinfoCombination_Type p_NR_SysinfoCombination) runs on NR5GC_POS_PTC
  {
    f_NR5GC_Init(p_NR_SysinfoCombination);
    activate(a_NR5GC_POS_DefaultExtension());   // activate extension for NR5GC default behaviour
  }

}
