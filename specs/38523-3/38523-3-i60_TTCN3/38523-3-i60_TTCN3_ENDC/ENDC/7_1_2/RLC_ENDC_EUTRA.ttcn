    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble(eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE); // @sic R5s190254 ch. 1.1 sic@

    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 0, 1, TEST_LOOPModeA_ON); // @sic R5s190163, R5s190165 sic@
    // Inform NR about the start of the TestBody
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Start TestBody")); // @sic R5s190163 sic@
    f_EUTRA_TestBody_Set(true);
    fl_TC_7_1_2_2_2_ENDC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    // f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1); @sic R5s230130 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); // @sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell.
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

