module IMS_WLAN_CC_SSTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions4G all;
  import from IMS_CC_TestcaseImplementation_15 all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Video all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.2
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_2_IMS1() runs on IMS_PTC
  {
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MOCallwithOIR();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.4
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_4_IMS1() runs on IMS_PTC
  {
      
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MTCallwithTIR();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.7
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_7_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_MO_ComunicationForwardingOnNonReply_C21a();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.11
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_11_IMS1() runs on IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure := IPCAN_MO_SpeechCall;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    // setup MO speech call
    f_IMS_CC_StartCall(v_TestProcedure);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();
    v_ResponseWithSdp := f_IMS_MOCallSetup_AnnexC21aC25a_Steps3_8(v_TestProcedure, v_InviteRequestWithSdp);

    f_IMS_MO_CallOnHoldWithoutAnnouncement(v_InviteRequestWithSdp.Invite,
                                           v_ResponseWithSdp.Response.msgHeader,
                                           v_InviteRequestWithSdp.SdpOffer);

    f_IMS_CC_Postamble(v_TestProcedure);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.12
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_12_IMS1() runs on IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure := IPCAN_MO_SpeechCall;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    // setup MO speech call
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();
    v_ResponseWithSdp := f_IMS_MOCallSetup_AnnexC21aC25a_Steps3_8(v_TestProcedure, v_InviteRequestWithSdp);

    f_IMS_MT_CallOnHoldWithoutAnnouncement(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.SdpMessage);

    f_IMS_CC_Postamble(v_TestProcedure);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.13
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_13_IMS1() runs on IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure := IPCAN_MO_VideoCall;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED, IMS_Security, WLAN);

    // setup MO video call
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    v_ResponseWithSdp := f_IMS_MOCallSetup_AnnexC21aC25a_Steps3_8(v_TestProcedure, v_InviteRequestWithSdp);

    f_IMS_MO_CallOnHoldWithoutAnnouncement(v_InviteRequestWithSdp.Invite,
                                           v_ResponseWithSdp.Response.msgHeader,
                                           v_InviteRequestWithSdp.SdpOffer);

    f_IMS_CC_Postamble(v_TestProcedure);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.14
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_14_IMS1() runs on IMS_PTC
  {
    var IMS_TestProcedure_Type v_TestProcedure := IPCAN_MO_VideoCall;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED, IMS_Security, WLAN);

    // setup MO video call
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    v_ResponseWithSdp := f_IMS_MOCallSetup_AnnexC21aC25a_Steps3_8(v_TestProcedure, v_InviteRequestWithSdp);

    f_IMS_MT_CallOnHoldWithoutAnnouncement(v_InviteRequestWithSdp.Invite, v_ResponseWithSdp.SdpMessage);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.17
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_17_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security, WLAN);
    f_IMS_Subscription_MWI_Event_Package_4G();
    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.24
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_24_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_CW_Answering();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.25
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_25_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_CW_Cancelling();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
