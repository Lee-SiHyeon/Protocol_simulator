module MultiLayer_Procedures_EU_UTRAN {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from CommonIratDefs all;
  import from EUTRA_CapabilityFunctions all;
  import from LoopbackIP all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_CommonTemplates all;
  import from Parameters all;
  import from UTRANGERAN_CommonFunctions all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_IRAT_CommonFunctions all;
  import from UTRAN_IRAT_CommonProcedures all;
  import from UTRAN_IRAT_Component all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_RAB_Functions all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_SysInfo_Templates all;
  import from UTRAN_RRC_Templates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;

  template (present) EstablishmentCause cr_EstCause_OrigConvCall := originatingConversationalCall;  /* @status    APPROVED (LTE_IRAT) */

  template (value) System_Information_Container cs_UTRA_SystemInformationContainer(octetstring p_Mib,
                                                                                   octetstring p_SysInfoType1,
                                                                                   octetstring p_SysInfoType3,
                                                                                   octetstring p_SysInfoType5,
                                                                                   template (omit) octetstring p_SysInfoTypeSB1 := omit,
                                                                                   template (omit) octetstring p_SysInfoTypeSB2 := omit,
                                                                                   template (omit) octetstring p_SysInfoType7 := omit,
                                                                                   template (omit) octetstring p_SysInfoType11 := omit,
                                                                                   template (omit) octetstring p_SysInfoType11bis := omit,
                                                                                   template (omit) octetstring p_SysInfoType12 := omit) :=
  { /* @status    APPROVED (LTE_IRAT) */
    mib                   := p_Mib,              //OCTET STRING (CONTAINING MasterInformationBlock),
    sysInfoTypeSB1        := p_SysInfoTypeSB1,   //OCTET STRING (CONTAINING SysInfoTypeSB1)   OPTIONAL,
    sysInfoTypeSB2        := p_SysInfoTypeSB2,   //OCTET STRING (CONTAINING SysInfoTypeSB2)   OPTIONAL,
    sysInfoType1          := p_SysInfoType1,     //OCTET STRING (CONTAINING SysInfoType1),
    sysInfoType3          := p_SysInfoType3,     //OCTET STRING (CONTAINING SysInfoType3),
    sysInfoType5          := p_SysInfoType5,     //OCTET STRING (CONTAINING SysInfoType5),
    sysInfoType7          := p_SysInfoType7,     //OCTET STRING (CONTAINING SysInfoType7),
    sysInfoType11         := p_SysInfoType11,    //OCTET STRING (CONTAINING SysInfoType11)      OPTIONAL,
    sysInfoType11bis      := p_SysInfoType11bis, //OCTET STRING (CONTAINING SysInfoType11bis)   OPTIONAL,
    sysInfoType12         := p_SysInfoType12,    //OCTET STRING (CONTAINING SysInfoType12)      OPTIONAL,
    vb50NonCriticalExtensions := omit            /* @sic R5s130195 BASELINE MOVING 2013 sic@ */
  };

  /*
   * @desc      function to encode System information into BCCH container
   * @param     p_CellId
   * @return    octetstring  ..  encoded octetstring
   * @status    APPROVED (LTE_IRAT)
   */
  function f_U_EncodeUtraSystemInformation_Into_BCCHContainer(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC return octetstring
  {
    var bitstring v_MIB_Bitstring;
    var bitstring v_SB1_Bitstring;
    var bitstring v_SIB1_Bitstring;
    var bitstring v_SIB3_Bitstring;
    var bitstring v_SIB5_Bitstring;
    var bitstring v_SIB7_Bitstring;
    var bitstring v_SIB11_Bitstring;
    var bitstring v_SIB12_Bitstring;
    var bitstring v_SySInfoContainer_Bitstring;
    var octetstring v_MIB_Octetstring;
    var octetstring v_SB1_Octetstring;
    var octetstring v_SIB1_Octetstring;
    var octetstring v_SIB3_Octetstring;
    var octetstring v_SIB5_Octetstring;
    var octetstring v_SIB7_Octetstring;
    var octetstring v_SIB11_Octetstring;
    var octetstring v_SIB12_Octetstring;
    var octetstring v_SySInfoContainer_Octetstring;
    
    var MasterInformationBlock v_MIB := f_UTRAN_SysInfo_GetMIB(p_CellId);
    var SysInfoTypeSB1 v_SB1 := f_UTRAN_SysInfo_GetSB1(p_CellId);
    var SysInfoType1 v_SIB1 := f_UTRAN_SysInfo_GetSIB1(p_CellId);
    var SysInfoType3 v_SIB3 := f_UTRAN_SysInfo_GetSIB3(p_CellId);
    var SysInfoType5 v_SIB5 := f_UTRAN_SysInfo_GetSIB5(p_CellId);
    var SysInfoType7 v_SIB7 := f_UTRAN_SysInfo_GetSIB7(p_CellId);
    var SysInfoType11 v_SIB11 := f_UTRAN_SysInfo_GetSIB11(p_CellId);
    var SysInfoType12 v_SIB12 := f_UTRAN_SysInfo_GetSIB12(p_CellId);
    
    //Create the MIB octetstring
    v_MIB.mib_ValueTag := 1; //Modify MIB according to Table 13.1.2a.3.3-5
    v_MIB_Bitstring := encvalue(v_MIB);
    v_MIB_Octetstring := bit2oct(f_OctetAlignedBitString(v_MIB_Bitstring));
    
    //Create the sysInfoTypeSB1 octetstring
    v_SB1_Bitstring := encvalue(v_SB1);
    v_SB1_Octetstring := bit2oct(f_OctetAlignedBitString(v_SB1_Bitstring));
    
    //Create the sysInfoTypeSB2 octetstring
    //It is set to omit
    
    //Create the sysInfoType1 octetstring
    v_SIB1_Bitstring := encvalue(v_SIB1);
    v_SIB1_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB1_Bitstring));
    
    //Create the sysInfoType3 octetstring
    v_SIB3_Bitstring := encvalue(v_SIB3);
    v_SIB3_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB3_Bitstring));
    
    //Create the sysInfoType5 octetstring
    v_SIB5_Bitstring := encvalue(v_SIB5);
    v_SIB5_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB5_Bitstring));
    
    //Create the sysInfoType7 octetstring
    v_SIB7_Bitstring := encvalue(v_SIB7);
    v_SIB7_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB7_Bitstring));
    
    //Create the sysInfoType11 octetstring
    v_SIB11_Bitstring := encvalue(v_SIB11);
    v_SIB11_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB11_Bitstring));
    
    //Create the sysInfoType11bis octetstring
    //It is set to omit
    
    //Create the sysInfoType12 octetstring
    v_SIB12_Bitstring := encvalue(v_SIB12);
    v_SIB12_Octetstring := bit2oct(f_OctetAlignedBitString(v_SIB12_Bitstring));
    
    v_SySInfoContainer_Bitstring := encvalue(cs_UTRA_SystemInformationContainer(v_MIB_Octetstring,      //octetstring p_Mib
                                                                                v_SIB1_Octetstring,     //octetstring p_SysInfoType1
                                                                                v_SIB3_Octetstring,     //octetstring p_SysInfoType3
                                                                                v_SIB5_Octetstring,     //octetstring p_SysInfoType5
                                                                                v_SB1_Octetstring,     //template (omit) octetstring p_SysInfoTypeSB1
                                                                                //@sic R5s130636 sic@
                                                                                omit,                   //template (omit) octetstring p_SysInfoTypeSB2 := omit
                                                                                v_SIB7_Octetstring,     //template (omit) octetstring p_SysInfoType7
                                                                                v_SIB11_Octetstring,    //template (omit) octetstring p_SysInfoType11
                                                                                omit,                   //template (omit) octetstring p_SysInfoType11bis
                                                                                v_SIB12_Octetstring)); //template (omit) octetstring p_SysInfoType12
    
    v_SySInfoContainer_Octetstring := bit2oct(f_OctetAlignedBitString(v_SySInfoContainer_Bitstring));
    return v_SySInfoContainer_Octetstring;
  }

  /* @desc      REFERENCE TS 36.523-1 clause 13.1.2
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_2_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var integer v_T0_CPICH_Cell5;
    var integer v_T0_PCCPCH_Cell5;
    var U_RLC_TM_IND v_RLC_TR_DATA_IND;  //@sic R5-150124 sic@
    v_T0_CPICH_Cell5 := -70;
    v_T0_PCCPCH_Cell5 := -72;       //@sic R5-120663 sic@
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    
    //cell 5 is in NMO 1. NMO1 is by default set in f_UTRAN_CellInfo_Init_FDD or f_UTRAN_CellInfo_Init_TDD
    
    //Send the cell info to the EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    
    //Set cell power level according to T0
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
    
    f_UTRAN_TestBody_Set (true);
    
    //Wait for E-UTRA to complete Step 1 to Step 5,
    //then receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //@siclog "Step 9" siclog@
    U_TM.receive(car_RRC_ConnReq(utran_Cell5,
                                      tsc_RB0,
                                      cr_108_RRC_ConnReq_r8(originatingConversationalCall))) -> value v_RLC_TR_DATA_IND;
    f_UTRAN_CheckReleaseIndicator(v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.v3d0NonCriticalExtensions.v4b0NonCriticalExtensions.rrcConnectionRequest_v4b0ext.accessStratumReleaseIndicator);

    //@siclog "Step 9a" siclog@
    //Notify EUTRA change power level as per T1
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);//@sic R5-130653 sic@
    //@siclog "Step 10 - 11" siclog@
    f_UTRAN_RRC_ConnEst_WithoutRRCConnectionReq(utran_Cell5, v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity);
    //Perform 36.508 cl. 6.4.3.7.2 - CS fallback to UTRAN with redirection / MO call (PS bearers not established)
    f_UTRAN_CS_Fallback_WithRedirection_WithoutRRCConnEst(utran_Cell5, false);
    
    f_UTRAN_TestBody_Set (false);
    
    //Notify EUTRA after completing test body
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.2a
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_2a_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode;
    var U_RLC_TM_IND v_RLC_TR_DATA_IND; //@sic R5-150124 sic@
    var InitialUE_Identity v_InitialUE_Id;
    var integer v_T0_CPICH_Cell5;
    var integer v_T0_PCCPCH_Cell5;
    var template (value) SysInfoType3 v_SIB3;
    var RRC_DATA_IND v_RRC_DATA_IND;
    var octetstring v_PLMN;
    var octetstring v_LAC;
    var octetstring v_RAC;
    var boolean v_CMS := true;
    var boolean v_RAU := true;
    var B3_Type v_UpdateType := '000'B;

    v_T0_CPICH_Cell5 := -70;
    v_T0_PCCPCH_Cell5 := -72; //@sic R5-120710 sic@
    
    //Initialise all cells
    f_UTRAN_Init(EUTRA_UTRAN);
    
    //Send the cell info to the EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA(utran_Cell5);
    
    //Send the encoded sys info to the EUTRA component
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_OctetData(f_U_EncodeUtraSystemInformation_Into_BCCHContainer(utran_Cell5)));
    
    //Set SIB3 according to Table Table 13.1.2a.3.3-6
    v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD (utran_Cell5);
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_4_ModeSpecificInfo_FDD, 21),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_AllBarred),
                                omit);
    }
    else {//TDD
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_ModeSpecificInfo_TDD, tsc_MaxAllowedUL_TX_Power_TDD),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_AllBarred),
                                omit);
    }
    f_UTRAN_SysInfo_SetSIB3(utran_Cell5, v_SIB3);
    
    //Set MIB according to Table 13.1.2a.3.3-7
    f_UTRAN_SysInfo_SetMIB_ValueTag(utran_Cell5, 2);
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    
    //Set cell power level according to T0
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
    
    f_UTRAN_TestBody_Set(true);
    
    //Wait for E-UTRA to complete Step 1 to Step 5,
    //then receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //@siclog "Step 6" siclog@
    //Receive RRC Connection Request
    U_TM.receive (car_RRC_ConnReq(utran_Cell5,
                                  tsc_RB0,
                                  cr_108_RRC_ConnReq_r8 (cr_EstCause_OrigConvCall))) -> value v_RLC_TR_DATA_IND;
    v_InitialUE_Id := v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity;
    f_UTRAN_CheckReleaseIndicator(v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.v3d0NonCriticalExtensions.v4b0NonCriticalExtensions.rrcConnectionRequest_v4b0ext.accessStratumReleaseIndicator);
    f_UTRAN_PreliminaryPass (__FILE__, __LINE__, "Test Case 13.1.2a Step 6");
    //@siclog "Step 6a" siclog@
    //Notify EUTRA change power level as per T1
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);//@sic R5-130653 sic@
    
    //@siclog "Step 7-8" siclog@
    //RRC Connection Establishment
    f_UTRAN_RRC_ConnEst_WithoutRRCConnectionReq(utran_Cell5, v_InitialUE_Id);
    
    alt {
      //@siclog "Step 1 of Table 13.1.2a.3.2-2" siclog@
      //The UE transmits a ROUTING AREA UPDATE REQUEST message.
      [v_CMS] U_Dc.receive (car_PS_InitDirectTransfer(utran_CellDedicated,
                                                      tsc_RB3,
                                                      cr_U_RA_UpdReqAny(cr_GMM_UpdateType(?, (tsc_I_UpdateTypeRAOnly, tsc_I_UpdateTypeCombined, tsc_I_UpdateTypeCombinedWithIMSI))))) -> value v_RRC_DATA_IND // @sic R5-125545 sic@
        {
          v_CMS := false;
          if (v_RAU) {
            repeat;
          }
        }
      //@siclog "Step 9" siclog@
      //The UE transmits a CM SERVICE REQUEST message on Cell 5.
      [v_RAU] U_Dc.receive (car_InitDirectTransfer(utran_CellDedicated,
                                                   tsc_RB3,
                                                   cr_U_ServReqAny(?))) // @sic R5s130856 sic@
        {
          v_RAU := false;
          if (v_CMS) {
            repeat;
          }
        }
    }
    
    //@siclog "Step 10-11" siclog@
    //SMC procedure for PS domain
    f_UTRAN_SS_SecurityDownloadStart(ps_domain, v_RRC_DATA_IND.ttcn_start);
    f_UTRAN_RRC_Security(utran_Cell5, false, ps_domain);
    
    //@siclog "Step 12" siclog@
    //The SS transmits a ROUTING AREA UPDATE ACCEPT message on Cell 5.
    v_UpdateType := f_UG_RauReq_GetUpdateValueForRauAcc(v_RRC_DATA_IND.msg.routingAreaUpdateRequest);
    v_PLMN := f_U_Asn2Nas_PlmnId(f_UTRAN_CellInfo_GetPLMNIdentity (utran_Cell5));
    v_LAC := f_UTRAN_CellInfo_GetLAC(utran_Cell5);
    v_RAC := f_UTRAN_CellInfo_GetRAC(utran_Cell5);
    
    U_Dc.send (cas_DataReq_PS(utran_CellDedicated,
                              tsc_RB3,
                              cs_U_RA_UpdAcc3(cs_GMM_UpdateResult (v_UpdateType),
                                              cs_RAI(omit, cs_LAI(omit, v_PLMN, v_LAC), v_RAC),
                                              omit,
                                               cs_MobileIdTMSIorPTMSI('18'O, 'efb1ee97'O), // @sic R5-166255 sic@
                                              v_RRC_DATA_IND.msg.routingAreaUpdateRequest.pDP_ContextStatus))); // @sic R5-133584 sic@
    
    // Step 12A: Receive ROUTING AREA UPDATE COMPLETE
    U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_RAUpdComplete)); // @sic R5s160822, R5s170008 sic@

    //@siclog "Step 13-21" siclog@
    //Steps 8 to 16 of the generic test procedure in TS 34.108 subclause 7.2.3.2 are performed on Cell 5
    //(the SS performs a SMC procedure and the CS call is set up).
    f_UTRAN_MO_SpeechCall_Steps6_16(utran_Cell5); //@sic R5s130636, R5s130856 sic@
    
    // Just wait for the Signalling Conn Rel Ind to be sent @sic R5-145699 sic@
    //@siclog "Step 22" siclog@
    U_AM.receive (car_RLC_Data_Ind (utran_CellDedicated, tsc_RB2, cr_108_RRC_SigConnRelInd));

    f_UTRAN_TestBody_Set (false);
    
    //Set cell 5 unbarred
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_4_ModeSpecificInfo_FDD, 21),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_NotBarred),
                                omit);
    }
    else {//TDD
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_ModeSpecificInfo_TDD, tsc_MaxAllowedUL_TX_Power_TDD),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_NotBarred),
                                omit);
    }
    
    f_UTRAN_SysInfo_SetSIB3(utran_Cell5, v_SIB3);
    f_UTRAN_SysInfo_SetMIB_ValueTag(utran_Cell5, 3);
    f_UTRAN_SendDefSysInfo (utran_Cell5);

    //Notify EUTRA after completing test body
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.3
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_3_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var integer v_T0_CPICH_Cell5;
    var integer v_T0_PCCPCH_Cell5;
    var octetstring v_IPv4IPv6_IcmpEchoReply := f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE());      /* @sic R5s120470 sic@ */
    var bitstring v_IpPacket_Bitstring := oct2bit(v_IPv4IPv6_IcmpEchoReply);
    var U_RLC_TM_IND v_RLC_TR_DATA_IND; //@sic R5-150124 sic@
    v_T0_CPICH_Cell5 := -70;
    v_T0_PCCPCH_Cell5 := -72; //@sic R5-120664 sic@
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    
    //Send the cell info to the EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
  
    //Set cell power level according to T0
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
    
    f_UTRAN_TestBody_Set(false);
    
    //Wait for E-UTRA to complete Step 1 to Step 5
    //then receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //@siclog "Step 6" siclog@
    U_TM.receive(car_RRC_ConnReq(utran_Cell5,
                                 tsc_RB0,
                                 cr_108_RRC_ConnReq_r8((registration, terminatingConversationalCall)))) -> value v_RLC_TR_DATA_IND;
    f_UTRAN_CheckReleaseIndicator(v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.v3d0NonCriticalExtensions.v4b0NonCriticalExtensions.rrcConnectionRequest_v4b0ext.accessStratumReleaseIndicator);
    //@siclog "Step 6A1- 6A2" siclog@
    f_UTRAN_RRC_ConnEst_WithoutRRCConnectionReq(utran_Cell5, v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity);
    
    //@siclog "Step 7 - 11 Void" siclog@
    
    //@siclog "Step 12-20" siclog@
    //Perform 36.508 cl. 6.4.3.7.3 - CS fallback to UTRAN with redirection / MT call (PS bearer established)
    f_UTRAN_CS_Fallback_WithRedirection_WithoutRRCConnEst(utran_Cell5, true, true); // @sic R5-144731, R5s141334 sic@

    //@siclog "Step 21" siclog@
    //Check: Does the UE loop back the IP packet on the RAB associated with the PDP context?
    interleave {
      [] U_PDCP.receive(car_PDCP_Test_Data_Ind(utran_CellDedicated, tsc_RB20, v_IpPacket_Bitstring)) {  //@sic R5s130195 sic@
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 13.1.3 Parallel behaviour in Table 13.1.3.3.2-3 step 21");
      }
      [] U_AM.receive (car_RLC_Data_Ind (utran_CellDedicated, tsc_RB2, cr_108_RB_SetUpCmpl (tsc_RRC_TI)))  //@sic R5s110210 sic@
        {
        }
    }
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 13.1.3 Parallel behaviour in Table 13.1.3.3.2-3 step 21");
    
    //Notify EUTRA after completing test body
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UTRAN_TestBody_Set (false);
    
    //Perform Switch/Power off and release UTRAN cell 5
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL, -,  cs_TI_MT);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.4
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_4_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var integer v_T0_CPICH_Cell5 := -70;
    var integer v_T0_PCCPCH_Cell5 := -72;
    timer t_WaitForOptional_IMS_Dereg := 6.0;
        
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    
    //Send UTRAN cell info to EUTRA PTC
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    
    f_UTRAN_Pre_Preamble (utran_Cell5, NotSpecified); // @sic R5s110776 sic@
    
    //Configure a dedicated channel in the UTRAN FDD with configuration according to 34.108 cl. 6.10.2.4.1.26
    f_SS_Config_64kPS_DCH4_RAB (utran_Cell5);  // @sic R5s120070 sic@
    
    //Wait for preamble and then set appropiate cell power level
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
    
    f_UTRAN_TestBody_Set (true);
    
    //Receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
        
    //Configure ciphering in SS before HO
    f_UTRAN_ConfigureCipheringBeforeHO (utran_Cell5);
    
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);  // Tell LTE to transmit HO cmd now
    
    //@siclog "Step 7-19" siclog@
    //Perfrom 36.508 cl. 6.4.3.7.5 - CS fallback to UTRAN with Handover / MT call
    f_UTRAN_CS_Fallback_WithHandover(utran_Cell5);
    
    //@siclog "Step 1a1 Parallel Behaviour" siclog@
    if (pc_IMS) { // @sic R5-182996 sic@
      t_WaitForOptional_IMS_Dereg.start; // @sic R5-182996 sic@
      alt { // @sic R5-182996 sic@
        [] a_UTRAN_Optional_IMS_Reg (utran_Cell5, t_WaitForOptional_IMS_Dereg, false)
          {
            f_UTRAN_RRC_ConnRel (utran_Cell5, cell_Dch);
          }
        [] t_WaitForOptional_IMS_Dereg.timeout {}
      }
    }
    
    //@siclog "Step 20" siclog@
    //Notify EUTRA change power level as per T1
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);//@sic R5-130653 sic@
    
    f_UTRAN_TestBody_Set(false);
    
    
    
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL, -,  cs_TI_MT); //@sic R5s120070 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.5
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_5_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var integer v_T0_CPICH_Cell5 := -70;
    var integer v_T0_PCCPCH_Cell5 := -72;
    var octetstring v_IPv4IPv6_IcmpEchoReply := f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE());      /* @sic R5s120470 sic@ */
    var bitstring v_IpPacket_Bitstring := oct2bit(v_IPv4IPv6_IcmpEchoReply);
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);

    //Send relevant UTRAN cell info to EUTRA PTC
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);

    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);

    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    //@sic R5s130656 sic@
     f_UTRAN_Pre_Preamble (utran_Cell5, NotSpecified); //@sic R5s130137 sic@
    //Configure a dedicated channel in the UTRAN FDD with configuration according to 34.108 cl. 6.10.2.4.1.26
    f_SS_Config_64kPS_DCH4_RAB (utran_Cell5);
    
    //Wait for preamble and then set appropiate cell power level
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);

    f_UTRAN_TestBody_Set(true);
    
    //Receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //Configure ciphering in SS before HO
    f_UTRAN_ConfigureCipheringBeforeHO (utran_Cell5);

    //Notify E-UTRA completion of Ciphering config
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    //@siclog "Step 6-13" siclog@
    //Perfrom 36.508 cl. 6.4.3.7.6 - CS fallback to UTRAN with Handover / MO call
    f_UTRAN_CS_Fallback_WithHandover(utran_Cell5, false, -, '0'B); // @sic R5-145699 sic@

    //@siclog "Step 6a" siclog@
    //Notify EUTRA change power level as per T1
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);//@sic R5-130653 sic@

    //@siclog "Step 14" siclog@
    //Send one IP packet to UE
    U_PDCP.send(cas_PDCP_Test_Data_Req (utran_CellDedicated,  //@sic R5s130195 PDCP sic@
                                     tsc_RB20,
                                     v_IpPacket_Bitstring));
    //@siclog "Step 15" siclog@
    //Receive the looped back IP packet
    U_PDCP.receive(car_PDCP_Test_Data_Ind (utran_CellDedicated, //@sic R5s130195 PDCP sic@
                                        tsc_RB20,
                                        v_IpPacket_Bitstring));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 13.1.3 Step 15");

    f_UTRAN_TestBody_Set(false);

    //Notify E-UTRA after configuring the E-UTRA cell
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);

    //Switch/Power off UE and release cell
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.15
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_15_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode;
    var template (value) SysInfoType3 v_SIB3;
    
    f_UTRAN_Init (EUTRA_UTRAN);
    
    v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD (utran_Cell5);
    
    //Update SIB3 of cell 5 according to Table 13.1.15.3.3-1
    if (v_FDD_TDD_Mode == UTRAN_FDD) {
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_4_ModeSpecificInfo_FDD, 21),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_AllBarred),
                                cs_DSACRestriction_PPAC_ParametersForPLMNOfMIB);
    }
    else {//TDD
      v_SIB3 := cds_SIB3_Barred(f_UTRAN_GetCellIndentity(utran_Cell5),
                                cs_CellSelectReselectInfoSIB_3_4(cs_SIB3_ModeSpecificInfo_TDD, tsc_MaxAllowedUL_TX_Power_TDD),
                                cs_CellAccessRestriction_Common(cs_CellNotBarred,
                                                                notReserved,
                                                                notReserved,
                                                                cs_AllAccessClassesBarred_AllBarred),
                                cs_DSACRestriction_PPAC_ParametersForPLMNOfMIB);
    }
    f_UTRAN_SysInfo_SetSIB3(utran_Cell5, v_SIB3);
    
    //Send the cell info to the EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    
    //Set cell power level according to T0
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, -70, -72);  //@sic R5-120665 sic@
    
    f_UTRAN_TestBody_Set (true);
    
    //Receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //@siclog "Step 10-28" siclog@
    //Perform 36.508 cl. 6.4.3.7.1 - CS fallback to UTRAN with redirection / MT call (PS bearers not established)
    f_UTRAN_CS_Fallback_WithRedirection(utran_Cell5);
    
    //Notify E-UTRA after configuring the E-UTRA cell
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UTRAN_TestBody_Set (false);
    
    //Postamble
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL, -,  cs_TI_MT); //@sic R5s120086 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.1.16
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_1_16_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var integer v_T0_CPICH_Cell5 := -70;
    var integer v_T0_PCCPCH_Cell5 := -72;
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);

    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);

    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);

    //Send relevant UTRAN cell info to EUTRA PTC
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);

   // f_UTRAN_Pre_Preamble (utran_Cell5, NotSpecified); // @sic R5s110776 R5-131302 sic@

    //Configure a dedicated channel in the UTRAN FDD with configuration according to 34.108 cl. 6.10.2.4.1.26
    f_SS_Config_64kPS_DCH4_RAB (utran_Cell5); //@sic R5s120111 sic@
    
    //Wait for preamble and then set appropiate cell power level
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);

    f_UTRAN_TestBody_Set(true);
    
    //Receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //Configure ciphering in SS before HO
    f_UTRAN_ConfigureCipheringBeforeHO (utran_Cell5);

    //Notify E-UTRA ready to send Mobility from EUTRA
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    //@siclog "Step 6-13" siclog@
    //Perfrom 36.508 cl. 6.4.3.7.7 - CS fallback to UTRAN with Handover / emergency call
    f_UTRAN_CS_Fallback_WithHandover(utran_Cell5, false, true);
    
    //Notify E-UTRA end of test body
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    f_UTRAN_TestBody_Set(false);
    
    //Switch/Power off UE and release cell
    f_UTRAN_Postamble (utran_Cell5, U5_CSCALL);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.2.1
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_2_1_UTRAN() runs on UTRAN_IRAT_PTC
  {
    //@sic R5s120113 sic@
    var integer v_T0_CPICH_Cell5;
    var integer v_T1_CPICH_Cell5;
    var integer v_T0_PCCPCH_Cell5;
    var integer v_T1_PCCPCH_Cell5;
    var octetstring v_IPv4IPv6_IcmpEchoReply := f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE());      /* @sic R5s120470 sic@ */
    var bitstring v_IpPacket_Bitstring := oct2bit(v_IPv4IPv6_IcmpEchoReply);
    //@sic R5s120645 sic@
    v_T0_CPICH_Cell5 := -82;//-23 //@sic R5-121768 sic@
    v_T1_CPICH_Cell5 := -72; //-12

    v_T0_PCCPCH_Cell5 := -82;     // TDD: To be clarified in prose, currently -82.5 specified which cannot be simulated [integer required]
    v_T1_PCCPCH_Cell5 := -72;
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    
    
    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);

    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    //@sic R5s120312 sic@
    //Send the cell info to the EUTRA component, and inform completion of Pre-preamble
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //f_UTRAN_Pre_Preamble (utran_Cell5, NotSpecified); // @sic R5s110776 R5-131336 sic@

    //Configure a dedicated channel in the UTRAN cell with configuration according to 34.108 cl. 6.10.2.4.1.26
    f_SS_Config_64kPS_RAB (utran_Cell5);

    

    //Set cell power levels according to T0
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);

        
    f_UTRAN_TestBody_Set (true);
    
    //@siclog "Step 5" siclog@
    //Set Cell parameters according to T1
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_SetCellPower(utran_Cell5, v_T1_CPICH_Cell5, v_T1_PCCPCH_Cell5);
    
    //Receive authentication parameters and continue with the test case
    f_UTRAN_InterRAT_InitialiseAuthParams();
    
    //Configure ciphering in SS before HO
    f_UTRAN_ConfigureCipheringBeforeHO (utran_Cell5);
    
    //Notify E-UTRA ready to send Mobility from EUTRA
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    //@siclog "Step 8-13" siclog@
    //Receive HANDOVER TO UTRAN COMPLETE message and perform RAU
    f_UTRAN_PS_Handover(utran_Cell5);
    
    //@siclog "Step 14 siclog@
    //Send one IP packet to UE
    U_PDCP.send(cas_PDCP_Test_Data_Req (utran_CellDedicated,  //@sic R5s130195 PDCP sic@
                                     tsc_RB20,
                                     v_IpPacket_Bitstring));
    //@siclog "Step 15" siclog@
    //Receive the looped back IP packet
    U_PDCP.receive(car_PDCP_Test_Data_Ind (utran_CellDedicated,  //@sic R5s130195 PDCP sic@
                                        tsc_RB20,
                                        v_IpPacket_Bitstring));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 13.4.2.1 Step 15");
    
    //Test case ends
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    f_UTRAN_TestBody_Set (true);
    
    //Perform Switch/Power off and release cell 5
    f_UTRAN_RRC_ConnRel ( utran_Cell5, cell_Dch); // @sic R5s140659 sic@
    f_UTRAN_Postamble ( utran_Cell5, U1_IDLE ); // @sic R5s140659 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.3.2.1
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_3_2_1_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Inter-system connection re-establishment / E-UTRAN to UTRAN / Further data are to be transferred */
    
    var octetstring v_IPv4IPv6_IcmpEchoReply := f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_UE());      /* @sic R5s120470 sic@ */
    var bitstring v_IpPacket_Bitstring := oct2bit(v_IPv4IPv6_IcmpEchoReply);
    var U_RLC_AM_IND v_U_RLC_AM_IND;
    var UTRAN_SecurityInfo_Type v_SecurityInfo ;
    
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);

    //Create and configure Cell 5 (cell started switched on but with max attenuation)
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    
    //Receive Authentication parameters and transfer of control to UTRA
    f_UTRAN_InterRAT_InitialiseAuthParams();
    f_UTRAN_TestBody_Set(true);
    //@siclog "Step 2" siclog@
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell);
    //@siclog "Step 3" siclog@
    //The UE reselects Cell5 and camps on Cell5.
    f_UTRAN_IdleMode_RAU (utran_Cell5, cell_Dch);
    //@siclog "Step 3" siclog@
    //@siclog "Step 4-16" siclog@
    f_UTRAN_RRC_ConnEst (utran_Cell5);
    f_UTRAN_GMM_ServReq (); // @sic R5s150838 sic@
    f_UTRAN_RRC_Security (utran_Cell5, false, ps_domain);
    f_UTRAN_RB_SetUp_PS_RAB (utran_Cell5, cell_DCH_64kPS_RAB_SRB, false); // don't wait for RB Setup Cmpl
    
    // RBSetupComplete and the IP packet can come in any order
    //Receive the looped back IP packet
    interleave {
      [] U_PDCP.receive(car_PDCP_Test_Data_Ind(utran_CellDedicated,  //@sic R5s130195 sic@
                                               tsc_RB20,
                                               v_IpPacket_Bitstring))
        {
          f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 13.4.2.1 Step 17");
        }
      [] U_AM.receive (car_RLC_Data_Ind(utran_CellDedicated, //@sic R5s110210 sic@
                                        tsc_RB2,
                                        cr_108_RB_SetUpCmpl (tsc_RRC_TI))) -> value v_U_RLC_AM_IND
      {
        v_SecurityInfo := f_UTRAN_Security_Get();
        v_SecurityInfo.start_PS := v_U_RLC_AM_IND.data.aM_message.uL_DCCH_Message.message_.radioBearerSetupComplete.start_Value;
        f_UTRAN_Security_Set(v_SecurityInfo);
      }
    }
    
    //Test case ends
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    f_UTRAN_TestBody_Set (false);
    
    //Perform Switch/Power off and release cell 5
    f_UTRAN_Postamble (utran_Cell5, U2_CONNECTED);

  } // end of f_TC_13_3_2_1_UTRA

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.4.2.4
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_13_4_2_4_UTRAN() runs on UTRAN_IRAT_PTC
  { /* Inter-system mobility / Service based redirection from UTRA to E-UTRA */
    var InitialUE_Identity v_InitialUE_Id;
    var U_RLC_TM_IND v_RLC_TR_DATA_IND; //@sic R5-150124 sic@
    var EUTRA_FDD_TDD_Mode_Type v_FDD_TDD_Mode;  // @sic R5s141365 sic@
    var IRAT_CoOrd_SysInfo_Type v_EUTRASysInfo;
    var UTRAN_SecurityInfo_Type v_SecurityInfo;
    var integer v_T1_CPICH_Cell5 := -70;
    var integer v_T1_PCCPCH_Cell5 := -72;
    var EUTRA_MeasurementBandwidth v_EUTRA_MeasurementBandwidth := f_UTRAN_ConvertIntegerToEUTRA_MeasurementBandwidth(f_ConvertDL_BandwidthPIXITToInteger());
    var template (value) EUTRA_TargetFreqInfoList v_EUTRA_TargetFreqInfoList;
    var template (omit) EUTRA_TargetFreqInfoList_vb50ext v_EUTRA_TargetFreqInfoList_vb50ext := omit;
        
    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);
    //Send the cell info to the EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA (utran_Cell5);
    
    //Get Cell Parameters for EUTRA cell
    v_EUTRASysInfo := f_IRAT_WaitForCoOrd_SysInfo (EUTRA);
    
    //Create and configure Cell 5 (cell started switched on but with max attenuation)
    f_UTRAN_SS_CreateCellDCH (utran_Cell5);
    
    //Set the Frequency Info accounting for eventual band extension
    if (v_EUTRASysInfo.Eutra[0].Arfcn > tsc_EUTRA_MaxEARFCN) {  // @sic R5-181145 sic@
      v_EUTRA_TargetFreqInfoList := {cs_EUTRA_TargetFreqInfo(tsc_EUTRA_MaxEARFCN)};
      v_EUTRA_TargetFreqInfoList_vb50ext := {cs_EUTRA_TargetFreqInfo_vb50ext(v_EUTRASysInfo.Eutra[0].Arfcn)};
    } else { //Band < 64
        v_EUTRA_TargetFreqInfoList := {cs_EUTRA_TargetFreqInfo(v_EUTRASysInfo.Eutra[0].Arfcn)};
    }

    //Start sending System Information
    if (v_EUTRASysInfo.Eutra[0].Arfcn < tsc_EUTRA_MaxEARFCN) { // @sic R5-172918 sic@
      f_UTRAN_SysInfo_SetSIB19 (utran_Cell5,
                              cs_SIB19_UtraAndOneEutraEntry (cs_Utra_PriorityInfoList_Def (4),
                                                             cs_Eutra_FreqAndPriList_OneEntry_Def (v_EUTRASysInfo.Eutra[0].Arfcn, v_EUTRA_MeasurementBandwidth, 3))); // @sic R5s130775 sic@
    } else { // EUTRA Band > 64 // @sic R5-172918 sic@
      f_UTRAN_SysInfo_SetSIB19 (utran_Cell5,
                              cs_SIB19_UtraAndOneEutraEntryExtension (cs_Utra_PriorityInfoList_Def (4),
                                                             omit, // @sic R5s130775 r5s174550 sic@
                                                             {cs_EUTRA_FrequencyAndPriorityInfoExtension_Common (v_EUTRASysInfo.Eutra[0].Arfcn,
                                                                                                                 v_EUTRA_MeasurementBandwidth,
                                                                                                                 3, -53, 2, 1, omit, true)}));
    }
    f_UTRAN_SendDefSysInfo (utran_Cell5);
    //Update SIB19 of cell 5 according to Table 6.3.8.3.3-7
    //Receive Authentication parameters and transfer of control to UTRA
    // Make UE camp on UTRA cell
    f_UTRAN_InterRAT_InitialiseAuthParams();
    f_UTRAN_SetCellPower (utran_Cell5, v_T1_CPICH_Cell5,v_T1_PCCPCH_Cell5);//@sic R5s120646 sic@
    //The UE reselects Cell5 and camps on Cell5.
    f_UTRAN_IdleMode_RAU (utran_Cell5, cell_Dch);
    f_Delay (5.0); // @sic R5s120711 sic@
    //UE is now in GMM-Registered and pdp-active State on Cell 5
    v_FDD_TDD_Mode := f_EUTRA_ConvertEutraFDDTDD_FromPIXIT (); // @sic R5s141365 sic@
    
    f_UTRAN_TestBody_Set(true);
    //@siclog "Step 1" siclog@
    //Page the UE
    f_UTRAN_Page (utran_Cell5, terminatingHighPrioritySignalling, oct2bit(px_PTMSI_Def));
    //@siclog "Step 2" siclog@
    alt {
      [v_FDD_TDD_Mode == FDD] U_TM.receive(car_RRC_ConnReq(utran_Cell5,
                                                                 tsc_RB0,
                                                                 cdr_RRC_ConnReqWith_v860ext(terminatingHighPrioritySignalling, cr_RRCConnReq_v860ext(true, ?), cr_RRCConnReq_v690ext_PSDomain))) -> value v_RLC_TR_DATA_IND
        {
          v_InitialUE_Id := v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity;
        }
      [v_FDD_TDD_Mode == TDD] U_TM.receive(car_RRC_ConnReq(utran_Cell5,
                                                                 tsc_RB0,
                                                                 cdr_RRC_ConnReqWith_v860ext(terminatingHighPrioritySignalling, cr_RRCConnReq_v860ext(?, true), cr_RRCConnReq_v690ext_PSDomain))) -> value v_RLC_TR_DATA_IND
        {
          v_InitialUE_Id := v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity;
        }
    }
    //@siclog "Step 3-4" siclog@
    f_UTRAN_RRC_ConnEst_WithoutRRCConnectionReq(utran_Cell5, v_InitialUE_Id);
    //@siclog "Step 5" siclog@
    f_UTRAN_GMM_ServReq(tsc_PagingResponse); // @sic R5s150838 sic@
    v_SecurityInfo := f_UTRAN_Security_Get();
    // Send Authentication parameters to EUTRA and also trigger further steps in EUTRA
    f_UTRAN_SendAuthCoOrdParameters (EUTRA, omit);
    U_UM.send (cas_RRC_ConnRelDCCH(utran_CellDedicated,
                                   tsc_RB1,
                                   cs_108_RRC_ConnRelDCCH_r4(v_SecurityInfo.dl_IntegrityCheckInfo,
                                                             tsc_RRC_TI,
                                                              1,
                                                             -,
                                                             cs_RRCConnectionRelease_NonCriticalExtensions_EutraReDirection(v_EUTRA_TargetFreqInfoList,
                                                                                                                            v_EUTRA_TargetFreqInfoList_vb50ext)))); // @sic R5-181154 sic@
    
    //@siclog "Step 6" siclog@
    //Receive RRC Connection Release Complete
    U_UM.receive(car_RRC_ConnRelCmplUM(utran_CellDedicated, //@sic R5s120092 sic@
                                       tsc_RB1,
                                       cr_108_RRC_ConnRelCmpl(tsc_RRC_TI)));
    //@siclog "Step 7" siclog@
    //Receive RRC Connection Release Complete
    U_UM.receive(car_RRC_ConnRelCmplUM(utran_CellDedicated, //@sic R5s120092 sic@
                                       tsc_RB1,
                                       cr_108_RRC_ConnRelCmpl(tsc_RRC_TI)));
    //Wait till end of test case
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_UTRAN_TestBody_Set (false);
    
    //Release UTRA cell
    f_UTRAN_ReleaseCell (utran_Cell5, f_UTRAN_CellInfo_GetConfigType (utran_Cell5)); // @sic R5s110176 sic@

  } // end of f_TC_13_4_2_4_UTRA

}
