module NR_ResourceAllocation {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_Parameters all;

  type enumerated NR_AnnexB2_Table_Type {table_B_2_1_1__1, table_B_2_1_2__1, table_B_2_1_5__1};  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      calculation of RIV
   * @param     p_N
   * @param     p_L
   * @param     p_RBstart
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RIV_Calculate(integer p_N,
                               integer p_L,
                               integer p_RBstart) return integer
  {
    var integer v_RIV;

    if (p_L - 1 <= p_N / 2) {
      v_RIV := (p_N * (p_L - 1)) + p_RBstart;
    } else {
      v_RIV := (p_N * (p_N - p_L + 1)) + p_N - 1 - p_RBstart;
    }
    return v_RIV;
  }

  /*
   * @desc      return size of the BWP: The calculation is as for the RIV according to 38.214 (clause 5.1.2.2.2 and 6.1.2.2.2) with N=275 and according to TS 38.508-1 clause 4.3.1.0B with RBstart=0
   * @param     p_RIV
   * @param     p_N                 (default value: 275)
   * @param     p_RBstart           (default value: 0)
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RIV_GetLength(integer p_RIV,
                               integer p_N := 275,
                               integer p_RBstart := 0) return integer
  {
    var integer v_L;

    for (v_L := 1; v_L <= p_N; v_L := v_L + 1) {
      if (f_NR_RIV_Calculate(p_N, v_L, p_RBstart) == p_RIV) {
        return v_L;
      }
    }
    FatalError(__FILE__, __LINE__, "invalid RIV");
    return 0;
  }

  type record NR_TimeResourceAllocation_Type
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    integer Start,
    integer Length
  };

  /*
   * @desc      Calculate SLIV
   * @param     p_Start
   * @param     p_Length
   * @return    integer
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_SLIV_Calculate(integer p_Start,
                               integer p_Length) return integer
  { /* calculate SLIV according to 38.214 clause 5.1.2.1 and 6.1.2.1 */
    if (p_Length < 9) {
      return (14 * (p_Length - 1)) + p_Start;
    } else {
      return (14 * (14 - p_Length + 1)) + 14 - 1 - p_Start;
    }
  }

  /*
   * @desc      return {Start Length} for given SLIV
   * @param     p_SLIV
   * @return    NR_TimeResourceAllocation_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_SLIV_GetStartAndLength(integer p_SLIV) return NR_TimeResourceAllocation_Type
  {
    var integer v_Start;
    var integer v_Length;

    for (v_Start := 0; v_Start < 14; v_Start := v_Start + 1) {
      for (v_Length := 1; v_Length <= 14 - v_Start; v_Length := v_Length + 1){
        if (p_SLIV == fl_NR_SLIV_Calculate(v_Start, v_Length)) {
          return {v_Start, v_Length};
        }
      }
    }
    FatalError(__FILE__, __LINE__, "invalid SLIV");
    return {0, 0}
  }

  type record NR_ResourceAllocation_Type
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    integer Lrbs,
    NR_ImcsValue_Type Imcs
  };

  template (value) NR_ResourceAllocation_Type cs_NR_ResourceAllocation(integer p_Lrbs,
                                                                      NR_ImcsValue_Type p_Imcs) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Lrbs := p_Lrbs,
    Imcs := p_Imcs
  };

  template (value) NR_ResourceAllocation_Type cs_NR_ResourceAllocationMin := cs_NR_ResourceAllocation(1, 0);                                    /* minimum grant according to 38.523-3 Table 7.1.2.3.3-1
                                                                                                                                                  @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      return {Lrbs Imcs} pair for given TBS
   * @param     p_TBS
   * @param     p_UplinkBWP
   * @param     p_TimeResourceAllocationIndex (default value: 0)
   * @param     p_DciFormats        (default value: formats0_1_And_1_1)
   * @return    NR_ResourceAllocation_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
