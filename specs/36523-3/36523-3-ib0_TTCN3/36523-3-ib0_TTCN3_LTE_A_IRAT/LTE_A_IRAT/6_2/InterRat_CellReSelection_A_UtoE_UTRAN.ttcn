module InterRat_CellReSelection_A_UtoE_UTRAN {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from CommonIratDefs all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_IRAT_CommonFunctions all;
  import from UTRAN_IRAT_CommonProcedures all;
  import from UTRAN_IRAT_Component all;
  import from UTRAN_RRC_SysInfo_Templates all;

  template (value) SysInfoType19_va80ext cs_SysInfoType19_va80ext_NoEntry :=
  { /* @status    APPROVED (LTE_A_IRAT) */
    multipleEutraFrequencyInfoList := omit
  };

  template (value) MultipleEUTRAFrequencyInfoExtensionList cs_MultipleEUTRAFrequencyBandExtensionInfo_1Entry (RadioFrequencyBandEUTRAExt p_Band ):=
  { /* @status    APPROVED (LTE_A_IRAT) */
    {
      multipleEUTRAFrequencyBandIndicatorlist := {p_Band}
    }
  };

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.2.3.35
   * @status    APPROVED (LTE_A_IRAT)
   */
  function f_TC_6_2_3_35_UTRAN() runs on UTRAN_IRAT_PTC
  { //Inter-RAT cell reselection from UTRA to E-UTRA / MFBI
    
    var integer v_T0_CPICH_Cell5 := -60;
    var integer v_T0_PCCPCH_Cell5 := -62;
    var integer v_T1_CPICH_Cell5 := -90;
    var integer v_T1_PCCPCH_Cell5 := -92;
    var IRAT_CoOrd_SysInfo_Type v_EUTRASysInfo;
    var template (omit) SIB19_vb30NonCriticalExtensions_Type v_SIB19_vb30NonCriticalExtensions := omit;

    //Initialise all cells
    f_UTRAN_Init(EUTRA_UTRAN);
    
    //Send System Information of UTRAN cell to EUTRA component
    f_UTRAN_Send_IR_SysInfoToEUTRA(utran_Cell5);
    
    //Get Cell Parameters for EUTRA cell
    v_EUTRASysInfo := f_IRAT_WaitForCoOrd_SysInfo(EUTRA);

    //Update SIB19 of cell 5 according to Table Table 6.2.3.35.3.3-1
    if (v_EUTRASysInfo.Eutra[0].Arfcn < tsc_EUTRA_MaxEARFCN ) {  // EUTRA Band < 64  @sic R5-174503 sic@
        f_UTRAN_SysInfo_SetSIB19(utran_Cell5, cs_SIB19_Common(cs_Utra_PriorityInfoList_Def,
                                                          omit,
                                                          cs_Eutra_FreqAndPriList_OneEntry_Def( v_EUTRASysInfo.Eutra[0].Arfcn,
                                                                                                f_UTRAN_ConvertIntegerToEUTRA_MeasurementBandwidth(v_EUTRASysInfo.Eutra[0].DL_Bandwidth)),
                                                          cs_SIB19_v920NonCriticalExtensions( cs_SysInfoType19V920ext(7,      // ThreshServingLow2
                                                                                                                      -20,    // QqualMinEUTRA
                                                                                                                      5,      // ThreshXhigh2
                                                                                                                      5),     // ThreshXlow2
                                                                                              // @sic R5s150092 sic@
                                                                                              cs_SIB19_va80NonCriticalExtensions(cs_SysInfoType19_va80ext_1Entry({v_EUTRASysInfo.Eutra[0].freqBandIndicator})))));
    } else { // Band > 64   @sic R5-174503 sic@
        v_SIB19_vb30NonCriticalExtensions := cs_SIB19_vb30NonCriticalExtensions (
                                                omit,
                                                cs_SIB19_vb50NonCriticalExtensions(
                                                    cs_SysInfoType19_vb50ext_Def(
                                                        {cs_EUTRA_FrequencyAndPriorityInfoExtension_Def(v_EUTRASysInfo.Eutra[0].Arfcn,
                                                                                                        f_UTRAN_ConvertIntegerToEUTRA_MeasurementBandwidth(v_EUTRASysInfo.Eutra[0].DL_Bandwidth))},
                                                        cs_MultipleEUTRAFrequencyBandExtensionInfo_1Entry(v_EUTRASysInfo.Eutra[0].freqBandIndicator)
                                                    )));
    
        f_UTRAN_SysInfo_SetSIB19(utran_Cell5, cs_SIB19_Common(cs_Utra_PriorityInfoList_Def,
                                                              omit,
                                                              omit,  // Band > 64
                                                              cs_SIB19_v920NonCriticalExtensions( cs_SysInfoType19V920ext(7,      // ThreshServingLow2
                                                                                                                      -20,    // QqualMinEUTRA
                                                                                                                      5,      // ThreshXhigh2
                                                                                                                      5),     // ThreshXlow2
                                                                                              cs_SIB19_va80NonCriticalExtensions(cs_SysInfoType19_va80ext_NoEntry,v_SIB19_vb30NonCriticalExtensions))));
    }
   
    //Create and configure Cell 5 (cell started switched on but with max attenuation)
    f_UTRAN_SS_CreateCellFACH(utran_Cell5);
    
    //Start sending System Information
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    
    //Set cell power level according to T0
    f_UTRAN_SetCellPower(utran_Cell5, v_T0_CPICH_Cell5, v_T0_PCCPCH_Cell5);
    
    //Preamble to ensure USIM is updated with valid TAI and to bring UE to initial state
    f_UTRAN_Preamble(utran_Cell5, true); // @sic R5-160991 sic@
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_OctetData(valueof(f_UTRAN_MobileInfo_EUTRACapability_Get()))); // @sic R5s160394 sic@
    
    f_UTRAN_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS change power levels according to the row "T1" in tables 6.2.3.35.3.2-2.
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_Trigger);
    f_UTRAN_SetCellPower(utran_Cell5, v_T1_CPICH_Cell5, v_T1_PCCPCH_Cell5);
    
    //Wait for the end of the test case
    f_IRAT_WaitForCoOrd_Trigger(EUTRA);
    
    f_UTRAN_TestBody_Set(false);
    
    //Release UTRAN Cell 5
    f_UTRAN_ReleaseCell(utran_Cell5, f_UTRAN_CellInfo_GetConfigType(utran_Cell5));
  }

}
