module NR_ASP_Templates_SysInd {

  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_Component_Base all;

template (value) NR_System_IndicationControl_Type cs_NR_SystemIndCtrl_AllOmit :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    RLC_Discard  := omit,
    MAC_BSR      := omit,
    MAC_PHR      := omit,
    RachPreamble := omit,
    SchedReq     := omit,
    UL_HARQ      := omit,
    HarqError    := omit,
    RecommendedBitRate := omit,     //@sic R5w210306 sic@
    UL_SRB0_LCID := omit,
    MAC_SL_BSR   := omit,           //@sic R5w230215 sic@
    MAC_SL_CG_Confirmation := omit, //@sic R5w230215 sic@
    MAC_PosMeasGap := omit,         //@sic R5w230202 sic@
    LBT_Failure := omit,            //@sic R5w240005 sic@
    MAC_UL_TA_Report :=  omit,      //@sic R5w240203 sic@
    SRS := omit,                    //@sic R5w250116 sic@
    MAC_PHRAssumedPUSCH := omit,    //@sic R5w250203 sic@
    MAC_DSR := omit,                //@sic R5w250204 sic@
    CSI_Report := omit,             //@sic R5w250304 sic@
    SL_HARQ := omit                 //@sic R5w260007 sic@
  };

  template (value) NR_System_IndicationControl_Type cds_NR_SystemIndCtrl_MAC_PHR     (IndicationAndControlMode_Type p_Mode) modifies cs_NR_SystemIndCtrl_AllOmit := { MAC_PHR      := p_Mode };  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_System_IndicationControl_Type cds_NR_SystemIndCtrl_RachPreamble(IndicationAndControlMode_Type p_Mode) modifies cs_NR_SystemIndCtrl_AllOmit := { RachPreamble := p_Mode };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) NR_System_IndicationControl_Type cds_NR_SystemIndCtrl_SchedReq    (IndicationAndControlMode_Type p_Mode) modifies cs_NR_SystemIndCtrl_AllOmit := { SchedReq     := p_Mode };  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_System_IndicationControl_Type cds_NR_SystemIndCtrl_UL_HARQ     (IndicationAndControlMode_Type p_Mode) modifies cs_NR_SystemIndCtrl_AllOmit := { UL_HARQ      := p_Mode };  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_SystemIndCtrl_REQ(NR_CellId_Type p_NR_CellId,
                                                               template (value) NR_System_IndicationControl_Type p_SystemIndCtrl,
                                                               template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                               template (omit) boolean p_CnfFlag := omit
                                                               ) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    //@sic R5s210842: added p_TimingInfo R5s220683: added p_CnfFlag sic@
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo, p_CnfFlag),
    Request := {
      SystemIndCtrl := p_SystemIndCtrl
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_SystemIndCtrl_CNF(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      SystemIndCtrl := true
    }
  };

  template (present) NR_SystemIndication_Type cr_NR_SystemIndication_RachPreamble (template (present) NR_RachPreamble_Type         p_RachPreamble)  := { RachPreamble  := p_RachPreamble };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (present) NR_SystemIndication_Type cr_NR_SystemIndication_UL_HARQ      (template (present) HARQ_Type                    p_UL_HARQ)       := { UL_HARQ       := p_UL_HARQ };       /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_SystemIndication_Type cr_NR_SystemIndication_SchedReq := { SchedReq := true };         /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RachPreamble_Type cr_NR_RachPreamble(template integer p_NR_PrachPreambleIndex) := { RAPID := p_NR_PrachPreambleIndex };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

    template (present) NR_SYSTEM_IND car_NR_SYSTEM_IND(template (present) NR_CellId_Type p_NR_CellId,
                                                     template (present) NR_SystemIndication_Type p_SystemIndication,
                                                     template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    Common := cr_NR_IndAspCommonPart_SysInd(p_NR_CellId, p_TimingInfo),
    Indication := p_SystemIndication
  };

 template (present) NR_SYSTEM_IND car_NR_PRACH_Preamble_IND(template (present) NR_CellId_Type p_NR_CellId,
                                                             template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                             template integer p_NR_PrachPreambleIndex := ?) :=
    /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_RachPreamble(cr_NR_RachPreamble(p_NR_PrachPreambleIndex)), p_TimingInfo);

    template (present) NR_SYSTEM_IND car_NR_SYSTEM_UL_HARQ_IND(NR_CellId_Type p_NR_CellId,
                                                             template (present) HARQ_Type p_HARQ_Type) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_UL_HARQ(p_HARQ_Type));

  template (present) NR_SYSTEM_IND car_NR_SchedulingReq_IND(NR_CellId_Type p_NR_CellId,
                                                            template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_SchedReq, p_TimingInfo);

  template (present) NR_SYSTEM_IND car_NR_SYSTEM_IND_Any :=
  {  /* @status    APPROVED (ENDC, NR5GC) */
    Common        := cr_NR_IndAspCommonPart_SysInd(?, cr_TimingInfo_Any),
    Indication    := ?
  };

  /*
   * @desc      Configures the SS
   * @param     p_NR_CellId
   * @param     p_SystemIndCtrl
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_CnfFlag           (default value: omit)
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
   function f_NR_SS_SystemIndCtrlConfig(NR_CellId_Type p_NR_CellId,
                                        template (value) NR_System_IndicationControl_Type p_SystemIndCtrl,
                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                        template (omit) boolean p_CnfFlag := omit
                                       ) runs on NR_BASE_PTC
  { //@sic R5s210842: added p_TimingInfo R5s220683: added p_CnfFlag sic@
    var template (value) NR_SYSTEM_CTRL_REQ v_NR_SYSTEM_CTRL_REQ := cas_NR_SystemIndCtrl_REQ(p_NR_CellId, p_SystemIndCtrl, p_TimingInfo, p_CnfFlag);
    var boolean v_CnfFlag := valueof(v_NR_SYSTEM_CTRL_REQ.Common.ControlInfo.CnfFlag);

    SYS.send(v_NR_SYSTEM_CTRL_REQ);
    if (v_CnfFlag) {
      SYS.receive(car_NR_SystemIndCtrl_CNF(p_NR_CellId));
    }
  }

}
