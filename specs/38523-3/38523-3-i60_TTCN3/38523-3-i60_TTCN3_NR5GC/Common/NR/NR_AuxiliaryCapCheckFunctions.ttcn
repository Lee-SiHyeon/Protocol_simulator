 /*
   * @desc      udc-r17 must be supported if pc_NR_udc_r17 is supported
   * @return    template Pdcp_udc_r17
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_udc_r17() return template Pdcp_udc_r17
  { // @sic R5-233835 sic@

    var template Pdcp_udc_r17 v_Pdcp_udc_r17 := *;

    if ((not pc_NR_udc_r17) and (pc_NR_udc_standardDictionary_r17 or pc_NR_udc_continueUDC_r17)){
        f_SetVerdict(inconc, __FILE__, __LINE__, "Acc. to TS 38.306, 4.2.4, udc-r17 shall be set as it comprises all its parameters");
    }

    v_Pdcp_udc_r17  := {
       standardDictionary_r17     := fl_NR_standardDictionary_r17() ifpresent,
       operatorDictionary_r17     := *,
       continueUDC_r17            := fl_NR_continueUDC_r17() ifpresent,
       supportOfBufferSize_r17    := *
    } ifpresent;

    if (pc_NR_udc_r17) {
      return v_Pdcp_udc_r17;
    } else {
      v_Pdcp_udc_r17 := omit;
      return v_Pdcp_udc_r17 ifpresent;
    }
  }

