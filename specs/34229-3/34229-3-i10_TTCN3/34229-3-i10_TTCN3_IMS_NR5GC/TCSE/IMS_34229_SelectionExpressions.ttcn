  /*
   * @desc      Set the applicability conditions according to 34.229-2 clause 4 table "Conditions/Options"
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT)
   */
  function f_IMS_SelectionExpr(IMS_34229_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;

    select (p_Condition) {
      case (IMS34_C04) {
        v_ApplCond := pc_InitiatesDedicatedPDPContext;
      }
      case (IMS34_C05) {
        v_ApplCond := pc_InitiateP_CSCFDiscovery_viaPCO;
      }
      case (IMS34_C17) {
        v_ApplCond := pc_IMS_Sec and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C23) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommHold and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C24) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Incoming_CB and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C27) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C28) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_InitiateSession and pc_MTSI_Speech and pc_MTSI_Speech_AMRWB and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C29) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_IMS_ExplicitConsultativeTransfer and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C30) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_CommDivert and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C31) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommDivert and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C32) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Conference and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C43) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIP and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C44) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIR and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C48) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIP and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C49) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIR and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C50) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_MessageWait and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C55) {
        v_ApplCond := pc_SMS_IP_MO and (pc_eFDD or pc_eTDD) and pc_Use_SMS_over_IP and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C56) {
        v_ApplCond := pc_SMS_IP_MT and (pc_eFDD or pc_eTDD) and pc_Use_SMS_over_IP and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C57) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommWaiting and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C59) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C61) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Conference and pc_IMS_TWS and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C62) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_EmergSpeech and (pc_UTRA or pc_GERAN);
      }
      case (IMS34_C64) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C66) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_BidirecVoiceOverIMS and pc_MTSI_Speech and pc_EmergSpeech and (pc_UTRA or pc_GERAN);
      }
      case (IMS34_C70) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C71) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_InitiateSession and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C72) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_CommunicationHold_DuringEmergencyCall and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C73) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_MultimediaTelephonyService and pc_MTSI_Speech and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C74) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_EmergSpeech and pc_1xRTT;
      }
      case (IMS34_C75) {
        v_ApplCond := pc_BidirecVoiceOverIMS and pc_MTSI_Speech and pc_EmergSpeech and pc_1xRTT;
      }
      case (IMS34_C76) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_IMS_Geolocation and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C77) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_MTSI_CommHold and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C78) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_MTSI_Conference and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C79) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_MTSI_Conference and pc_IMS_TWS and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C80) {
        v_ApplCond := pc_IMS_Sec and pc_IMS_Deregistration and (pc_eFDD or pc_eTDD) and (pc_CS_PS_data_centric or pc_PS_data_centric) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C81) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIP and pc_HttpGBAAuthentication and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C82) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_EarlyMedia and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C83) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech_EVS and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C84) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Outgoing_CB and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C88) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIR_C and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C89) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIR_C and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication) and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C92) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIP and pc_WLAN;
      }
      case (IMS34_C93) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIR and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C94) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIP and pc_WLAN;
      }
      case (IMS34_C95) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIR and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C101) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_CommDivert and pc_WLAN;
      }
      case (IMS34_C102) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommDivert and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C106) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_InitiateSession and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C107) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C108) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_WLAN;
      }
      case (IMS34_C109) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommHold and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C110) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_MTSI_CommHold and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C111) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Incoming_CB and pc_WLAN and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication);
      }
      case (IMS34_C112) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Outgoing_CB and pc_WLAN and (pc_HttpGBAAuthentication or pc_HttpDigestAuthentication);
      }
      case (IMS34_C113) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_MessageWait and pc_WLAN;
      }
      case (IMS34_C114) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Conference and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C116) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Conference and pc_IMS_TWS and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C117) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_MTSI_Conference and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C119) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Video and pc_VideoCodecH264CBP and pc_MTSI_Conference and pc_IMS_TWS and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C120) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_CommWaiting and pc_Preconditions and pc_WLAN;
      }
      case (IMS34_C121) {
        v_ApplCond := pc_WLAN_IMS_EmergencyCall and pc_WLAN;
      }
      case (IMS34_C124) {
        v_ApplCond := pc_IMS_Sec and pc_IMS_GIBA_Sec and pc_EPS_IMS_EmergencyCall and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C125) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_IMS_after_EmReg_rejection and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C126) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C127) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_CommWaiting and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C128) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_MessageWait and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C129) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_OIR and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C130) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_TIR and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C131) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_CommDivert and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C132) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_IMS_Geolocation and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C133) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C134) {
        v_ApplCond := pc_IMS_Sec and not pc_IMS_GIBA_Sec and pc_EPS_IMS_EmergencyCall and pc_IMS_after_EmReg_rejection and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C135) {
        v_ApplCond := pc_NG102_Combined_Registration_EUTRA;
      }
      case (IMS34_C136) {
