   * @desc      REFERENCE TS 37.571-2 clause 6.2.3.2, Subtest 4 (UE supporting A-GPS and A-GLONASS only)
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_3_2_4s_UTRAN() runs on UTRAN_POS_PTC
  {
    //Changes for code optimisation. See @sic R5s150706 sic@
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_StartSatelliteSimulatorAGNSS({gps, glonass}, 4);  // Scenario for Subtest 4 according to 37.571-5, 6.1.2
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    fl_TC_6_2_3_1And2_Init();
    f_UTRAN_TestBody_Set(true);
    fl_TC_6_2_3_2_TestBody(4);
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
  }

  /*
   * @desc      Main body of test case 6.2.3.2
   * @param     p_Subtest
   * @status    APPROVED (POS)
   */
  function fl_TC_6_2_3_2_TestBody(integer p_Subtest) runs on UTRAN_POS_PTC {
    // Steps 1 and 2. MM Authentication
    f_UTRAN_MM_Authentication();

    // Step 3. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    // Steps 4 to 6: Void.
    // Steps 7 to 8. Send MEASUREMENT CONTROL(s) and receive MESAUREMENT REPORT with Error reason "Not enough satellites"
    f_AGNSS_MeasControlAndReport_UeBasedFailure_r8Or12(p_Subtest);
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.2 subtest " & int2char(p_Subtest) & " Step 8");
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.3.3
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_3_3_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S;
    var octetstring v_Octetstring;
    var octetstring v_EncodedComponents;
    
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_PageCS(utran_Cell5, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN_RRC_ConnEst(utran_Cell5, terminatingConversationalCall);
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cr_MobileIdAny))) -> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    f_UTRAN_TestBody_Set(true);
    
    // @sic R5s140316 sic@
    f_UT_AT_SubscribeLocationRequestNotifications (UT, true);

    // Steps 1 and 2. MM Authentication
    f_UTRAN_MM_Authentication();
    
    // Step 3. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    
    // Step 4. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5s150911 sic@
                                                                       notifyLocationAllowed);
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(cs_TI_MT, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // Steps 5 and 6 can happen in any order so wait until Release Complete arrived before checking UT port
    // @sic R5s140316 sic@
    v_Ti_S := cs_TI_MT;
    v_Ti_S.tiFlag := '1'B;
    
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_NOTIFICATION); // @sic R5-153746 sic@

    //@siclog "Step 6" siclog@
    //Receive RELEASE COMPLETE message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_S, cr_FacilityIE_tlv))) -> value v_RRC_DataInd;
    
    //@siclog "Step 5" siclog@
    //UE notifies the UE user of the location request
    f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_NOTIFICATION); // @sic R5-153746 sic@
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.3 Step 5");
    
    v_Octetstring := v_RRC_DataInd.msg.releaseComplete.facility.components;
    f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_ReturnResult(cr_ResultLocNotification(tsc_InvokeId, permissionGranted))));
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.3 Step 8");

    // @sic R5s140316 sic@
    f_UT_AT_SubscribeLocationRequestNotifications (UT, false);
    
    f_UTRAN_TestBody_Set(false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.3.4
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_3_4_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S := cs_TI_MT;
    var template (present) TI v_Ti_R;
    var float v_TimeUeLcsNotification := int2float((px_UeLcsNotification * 90) / 100);
    var octetstring v_Octetstring;
    var octetstring v_EncodedComponents;
    var integer v_HandleId;     //@sic R5s140318 sic@
    timer t_Watchdog; // General purpose wait timer
    
    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_PageCS(utran_Cell5, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN_RRC_ConnEst(utran_Cell5, terminatingConversationalCall);
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cr_MobileIdAny)))-> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    f_UTRAN_TestBody_Set(true);
    
    // Steps 1 and 2. MM Authentication
    f_UTRAN_MM_Authentication();
    
    // Step 3. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    
    //Enable the UE to send notifications via AT response
    //@sic R5s140318 sic@
    f_UT_AT_SubscribeLocationRequestNotifications (UT, true);
    
    // Step 4. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@ @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationAllowedIfNoResponse);

    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    // Step 5
    t_Watchdog.start(v_TimeUeLcsNotification);
    
    // Step 6
    //@sic R5s140318 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.4 Step 6");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.4 Step 6");
    }
    
    // Step 7
    //@sic R5s140318 sic@
    f_UT_AT_AnswerLocationRequest (UT, v_HandleId, true);
    t_Watchdog.stop; // the timeout will be implicitly handled in the default behaviour.
    
    v_Ti_R := v_Ti_S;
    v_Ti_R.tiFlag := '1'B;
    
    // Step 8. Receive RELEASE COMPLETE message - permission granted
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_R, cr_FacilityIE_tlv)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.releaseComplete.facility.components; //@sic R5s140318 sic@
    f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_ReturnResult(cr_ResultLocNotification(tsc_InvokeId, permissionGranted))));
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.4 Step 8");
    
    // Step 9. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@ @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationAllowedIfNoResponse);
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    // Step 10
    t_Watchdog.start(v_TimeUeLcsNotification);
    
    // Step 11
    //@sic R5s140318 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.4 Step 11");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.4 Step 11");
    }
    
    // Step 12
    //@sic R5s140318 sic@
    f_UT_AT_AnswerLocationRequest (UT, v_HandleId, false);
    t_Watchdog.stop; // the timeout will be implicitly handled in the default behaviour.
    
    // Step 13. Receive RELEASE COMPLETE message -  permission denied
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_R, cr_FacilityIE_tlv)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.releaseComplete.facility.components; //@sic R5s140318 sic@
    f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_ReturnResult(cr_ResultLocNotification(tsc_InvokeId, permissionDenied))));

    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.4 Step 13");
    
    // Step 14. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@ @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationAllowedIfNoResponse);
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // Step 15
    t_Watchdog.start(v_TimeUeLcsNotification);

    // Step 16
    //@sic R5s140318 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_ALLOWED); // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.4 Step 16");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.4 Step 16");
    }
    
    // Step 17
    //@sic R5s140318 sic@
    // Do nothing until timeout
    
    // Step 18
    t_Watchdog.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Location Request ignored");
    
    // Step 19. Send RELEASE COMPLETE
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete(v_Ti_S)));
    
    f_UTRAN_TestBody_Set(false);

    //@sic R5s140318 sic@
    //Disable the UE to send notifications via AT response
    f_UT_AT_SubscribeLocationRequestNotifications (UT, false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 6.2.3.5
   * @status    APPROVED (POS)
   */
  function f_TC_6_2_3_5_UTRAN() runs on UTRAN_IRAT_PTC
  {
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    var template (value) TI v_Ti_S := cs_TI_MT;
    var template (present) TI v_Ti_R;
    var float v_TimeUeLcsNotification := int2float((px_UeLcsNotification * 90) / 100);
    var octetstring v_Octetstring;
    var octetstring v_EncodedComponents;
    var integer v_HandleId;     //@sic R5s140320 sic@
    timer t_Watchdog; // General purpose wait timer

    f_UTRAN_Init(UTRAN_Only);
    f_UTRAN_SS_CreateCellDCH(utran_Cell5);
    f_UTRAN_SendDefSysInfo(utran_Cell5);
    f_UTRAN_SetCellPower (utran_Cell5, tsc_AttenuationServingCell); // @sic R5s140316 sic@
    f_UT_SwitchOnUE(UT, false); //  Switch on UE
    f_UTRAN_IdleUpdated (utran_Cell5);
    f_UTRAN_PageCS(utran_Cell5, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN_RRC_ConnEst(utran_Cell5, terminatingConversationalCall);
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, cr_MobileIdAny))) -> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    f_UTRAN_TestBody_Set(true);
    
    // Steps 1 and 2. MM Authentication
    f_UTRAN_MM_Authentication();

    // Step 3. Security Mode procedure
    f_UTRAN_RRC_Security(utran_Cell5, true, cs_domain);
    
    //Enable the UE to send notifications via AT response
    //@sic R5s140320 sic@
    f_UT_AT_SubscribeLocationRequestNotifications (UT, true);

    // Step 4. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@, @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationNotAllowedIfNoResponse);
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN); // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S, cs_FacilityIE_tlv(v_EncodedComponents))));
    // Step 5
    t_Watchdog.start(v_TimeUeLcsNotification);
    
    // Step 6
    //@sic R5s140320 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN); // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.5 Step 6");
    } else {
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.5 Step 6");
    }
    
    // Step 7
    //@sic R5s140320 sic@
    f_UT_AT_AnswerLocationRequest (UT, v_HandleId, true);
    t_Watchdog.stop; // the timeout will be implicitly handled in the default behaviour.
    
    v_Ti_R := v_Ti_S;
    v_Ti_R.tiFlag := '1'B;
    
    // Step 8. Receive RELEASE COMPLETE message - permission granted
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_R, cr_FacilityIE_tlv)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.releaseComplete.facility.components; //@sic R5s140320 sic@
    f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_ReturnResult(cr_ResultLocNotification(tsc_InvokeId, permissionGranted))));
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.5 Step 8");
    
    // Step 9. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@, @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationNotAllowedIfNoResponse);
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN);  // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S,
                                             cs_FacilityIE_tlv(v_EncodedComponents))));
    // Step 10
    t_Watchdog.start(v_TimeUeLcsNotification);
    
    // Step 11
    //@sic R5s140320 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN);  // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.5 Step 11");
    } else {
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.5 Step 11");
    }
    
    // Step 12
    //@sic R5s140320 sic@
    f_UT_AT_AnswerLocationRequest (UT, v_HandleId, false);
    t_Watchdog.stop; // the timeout will be implicitly handled in the default behaviour.
    
    // Step 13. Receive RELEASE COMPLETE message -  permission denied
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                          cr_U_ReleaseCompleteFacility(v_Ti_R, cr_FacilityIE_tlv)))
      -> value v_RRC_DataInd;
    v_Octetstring := v_RRC_DataInd.msg.releaseComplete.facility.components; //@sic R5s140320 sic@
    f_UTRAN_FacilityIE_Components_DecodeAndMatch(v_Octetstring, cr_Components(cr_ReturnResult(cr_ResultLocNotification(tsc_InvokeId, permissionDenied))));
    
    
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.5 Step 13");
    
    // Step 14. Send REGISTER
    v_EncodedComponents := f_SS_EncodeComponents_InvokeLocNotification(tsc_InvokeId, //@sic R5-140685 sic@, @sic R5s150911 sic@
                                                                       notifyAndVerify_LocationNotAllowedIfNoResponse);
    f_UT_AT_TriggerNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN);  // @sic R5-153746 sic@

    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RegisterMT(v_Ti_S,
                                             cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // Step 15
    t_Watchdog.start(v_TimeUeLcsNotification);
    
    // Step 16
    //@sic R5s140320 sic@
    v_HandleId := f_UT_AT_CheckNotifyLocationRequest (UT, LOCATION_REQ_FORBIDDEN);  // @sic R5-153746 sic@
    if (v_HandleId  < 0 ) {
      f_UTRAN_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.5 Step 16");
    } else {
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.2.3.5 Step 16");
    }
    
    // Step 17
    //@sic R5s140320 sic@
    // Do nothing until timeout
    
    // Step 18
    t_Watchdog.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Location Request ignored");
    
    // Step 19. Send RELEASE COMPLETE
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete(v_Ti_S)));

    f_UTRAN_TestBody_Set(false);

    //@sic R5s140320 sic@
    //Disable the UE to send notifications via AT response
    f_UT_AT_SubscribeLocationRequestNotifications (UT, false);
    f_UTRAN_RRC_ConnRel(utran_Cell5, cell_Dch); // @sic R5s150011 sic@
    f_UTRAN_Postamble(utran_Cell5, U1_IDLE); // @sic R5s140316, R5s150011 sic@
  }

}
