  //----------------------------------------------------------------------------
  testcase TC_9_3_1_2_15s_NR5GC() runs on MTC_POS system SYSTEM_POS {
    // @purpose
    //   LPP Abort: Subtest 15
    var EUTRA_POS_PTC    v_EUTRA      := null;
    var UTRAN_POS_PTC    v_UTRAN      := null;
    var NR5GC_POS_PTC    v_NR5GC      := null;
    var EUTRA_OTDOA_POS_PTC v_EUTRA_OTDOA_POS := null;
  
    timer t_GuardTimer := int2float(360);
  
    v_NR5GC := NR5GC_POS_PTC.create("NR5GC") alive;
  
    f_MTC_ConnectPTCs_POS(system, v_EUTRA, v_UTRAN, v_NR5GC, v_EUTRA_OTDOA_POS);
  
