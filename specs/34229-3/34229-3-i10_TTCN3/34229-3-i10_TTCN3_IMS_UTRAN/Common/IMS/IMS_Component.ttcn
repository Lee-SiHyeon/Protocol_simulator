  /*
   * @desc      return true when UE release is >= given release
   * @param     p_Release
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_UE_ReleaseGreaterOrEqual(integer p_Release) runs on IMS_PTC return boolean
  {
    var template (omit) integer v_UERelease := f_IMS_PTC_GetUE_Release();
    var boolean v_Result := false;

    if (isvalue(v_UERelease)) {
      v_Result := (valueof(v_UERelease) >= p_Release);
    }
    return v_Result;
  }

