module IMS_eCall_Testcases {

  import from IMS_CC_TestcaseImplementation_eCall all;
  import from IMS_Component all;
  import from IMS_XML_eCall_Templates all;

  /*
   * @desc      Call the common function
   * @status    APPROVED (IMS)
   */
  function fl_IMS_ECall_IMS1 () runs on IMS_PTC
{  // @sic R5-221598 re-used common code with 4G and 5G sic@
   f_IMS_ECallOverIMS_IMS1("TS 36.508 Table 4.9.3.5-1 for eCall Capable UE");
}

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.1
   * @status    APPROVED (IMS)
   */
  function f_TC_21_1_IMS1() runs on IMS_PTC
  { /* IMS implementation for PDN1 -  IMS normal registration */
    fl_IMS_ECall_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.1
   * @status    APPROVED (IMS)
   */
  function f_TC_21_1_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(MANUAL, msdUpdateNotRequired); //@sic R5-197038 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.2
   * @status    APPROVED (IMS)
   */
  function f_TC_21_2_IMS1() runs on IMS_PTC
  {
    fl_IMS_ECall_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.2
   * @status    APPROVED (IMS)
   */
  function f_TC_21_2_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateNotRequired); //@sic R5-197038 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.4
   * @status    APPROVED (IMS)
   */
  function f_TC_21_4_IMS1() runs on IMS_PTC
  { /* IMS implementation for PDN1 -  IMS normal registration */
    fl_IMS_ECall_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.4
   * @status    APPROVED (IMS)
   */
  function f_TC_21_4_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(MANUAL, msdUpdateRequired);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.5
   * @status    APPROVED (IMS)
   */
  function f_TC_21_5_IMS1() runs on IMS_PTC
  { /* IMS implementation for PDN1 -  IMS normal registration */
    fl_IMS_ECall_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.5
   * @status    APPROVED (IMS)
   */
  function f_TC_21_5_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateRequired);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.6
   * @status    APPROVED (IMS)
   */
  function f_TC_21_6_IMS1() runs on IMS_PTC
  { /* IMS implementation for PDN1 -  IMS normal registration */
    fl_IMS_ECall_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 21.6
   * @status    APPROVED (IMS)
   */
  function f_TC_21_6_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateRequired, cs_EmergencyCallData_Control_Request(-, tsc_EmergencyCallData_DataType_invalidMSD));
  }

}
