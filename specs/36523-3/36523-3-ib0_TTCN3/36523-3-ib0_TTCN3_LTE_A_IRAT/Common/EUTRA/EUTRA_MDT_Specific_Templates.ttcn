    measResultLastServCell_v1360  := *,                                 /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    logMeasResultListBT_r15       := *,                                 /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
