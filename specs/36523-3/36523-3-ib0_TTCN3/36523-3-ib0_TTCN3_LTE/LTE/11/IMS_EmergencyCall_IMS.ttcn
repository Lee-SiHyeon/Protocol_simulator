module IMS_EmergencyCall_IMS {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.1
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_1_IMS2() runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;
    
    f_IMS_PTC_Init(PDN_2);
    
    // Test Case Body
    // Emergency registration: 34.229-1 Annex C.20
    f_IMS_EmergencyRegistration();
    
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup();
    
    //Release Emergency Call MO
    //@siclog "Step 13A" siclog@
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest); // @sic R5s130748 sic@
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.2
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_2_IMS2() runs on IMS_PTC // @sic R5s160033 ch. 1 sic@
  {
    var INVITE_Request v_InviteRequest;
        
    f_IMS_PTC_Init(PDN_2);                        /* @sic R5s130754 change 3 sic@ @sic R5s140675 change 2.2 sic@ @sic R5s160033 ch. 1 sic@ */
     
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup(A_2_1_A6);    /* @sic R5s130754 change 2 sic@ */
    
    //Release Emergency Call MO
    //@siclog "Step 22" siclog@
    f_IMS_CallReleaseMO(v_InviteRequest, -, REGULAR_EMERGENCY); // @sic R5s140675 change 2.1 sic@ @sic R5s150692 change 23 sic@ @sic R5-250336 no impact sic@

    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_GlobalRelease(tsc_IMS_WaitForTcpClose);       /* @sic R5s140675 change 2.1 sic@
                                                           @sic R5s250228 change 2.1.7: f_IMS_GlobalRelease instead of f_IMS_TCP_CloseHandling sic@ */
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.3
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_3_IMS1() runs on IMS_PTC // @sic R5s160033 ch. 1 sic@
  {
    f_IMS_PTC_Init(PDN_1);
    
    f_IMS_Registration(); // @sic R5s141339 change 2.1 sic@
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN); // @sic R5s141339 change 2.2 sic@
    
    f_IMS_GlobalRelease (-, keepUnprotected); // @sic R5s170468 sic@ @sic R5s220609 - Additional changes: keepUnprotected instead of oldestProtectedContextOnly sic@
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
    f_IMS_Registration(); // @sic R5s141339 change 2.5 sic@

    f_IMS_IpcanReleaseWithOptionalDeregistration(); // @sic R5s160033 r1 sic@

  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.3
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_3_IMS2() runs on IMS_PTC
  { // @sic R5s160033 ch. 1 sic@
    var INVITE_Request v_InviteRequest;
     
    f_IMS_PTC_Init(PDN_2);
    
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup(A_2_1_A6); // @sic R5s141339 change 2.3 sic@
    
    //Release Emergency Call MO
    f_IMS_CallReleaseMO(v_InviteRequest, -, REGULAR_EMERGENCY); // @sic R5s141339 change 2.4 sic@ @sic R5s150692 change 23 sic@ @sic  R5-250336 no impact sic@

    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_GlobalRelease(tsc_IMS_WaitForTcpClose);       /* @sic R5s141339 change 2.4 sic@
                                                           @sic R5s250228 change 2.1.7: f_IMS_GlobalRelease instead of f_IMS_TCP_CloseHandling sic@ */
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.4
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_4_IMS2() runs on IMS_PTC // @sic R5s160033 ch. 1 sic@
  {
    var INVITE_Request v_InviteRequest;
    var integer i;
    var integer v_MaxEmgCalls := 7;    // The test case currently sets up 7 IMS Emg Call in Limited service in a loop @sic R5s142979 sic@
    
    f_IMS_PTC_Init(PDN_2); // @sic R5s140675 change 3 sic@ @sic R5s160033 ch. 1 sic@
    
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup(A_2_1_A6);    /* @sic R5s130758 change 2 sic@ */
        
    //IMS call to be released.
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    //Release Emergency Call MO
    //@siclog "Step 20A" siclog@
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest); // @sic R5s130748 sic@
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // Steps 24-45 (loop)
    for (i:=0; i< v_MaxEmgCalls; i:=i+1) {
    
      // Emergency call setup: 34.229-1 Annex C.22
      v_InviteRequest := f_IMS_EmergencyCallSetup(A_2_1_A6);
 
      //IMS call to be released.
      f_IMS_IPCAN_WaitForTrigger(IPCAN);

      //Release Emergency Call MO
      f_IMS_EmergencyCallReleaseMO(v_InviteRequest); // @sic R5-250336 no impact sic@
    
      // Inform EUTRA: IMS Call released.
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    }

  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.5
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_5_IMS2() runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;
    
    f_IMS_PTC_Init(PDN_2);
    
    // Emergency registration: 34.229-1 Annex C.20
    f_IMS_EmergencyRegistration();
    
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup();
    
    //IMS call to be released.
    f_IMS_IPCAN_WaitForTrigger(IPCAN); // @sic R5-142920 sic@

    //Release Emergency Call MO
    //@siclog "Step 20" siclog@
    f_IMS_CallReleaseMO(v_InviteRequest, -, REGULAR_EMERGENCY); // @sic R5s150294 sic@ @sic R5s150692 change 23 sic@
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_GlobalRelease(tsc_IMS_WaitForTcpClose);       /* @sic R5s150294 ch. 2.3 sic@
                                                           @sic R5s250228 change 2.1.7: f_IMS_GlobalRelease instead of f_IMS_TCP_CloseHandling sic@ */
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.6
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_6_IMS1() runs on IMS_PTC
  { // @sic R5s150177 sic@ @sic R5-150733 sic@
    var template (present) SipUrl v_OtherCalleeUri := cr_SipUrl_Common((c_sipScheme, c_telScheme), ?); // @sic R5s150177 change 9, R5s150204: cr_SipUri_HostPort(?) sic@ @sic R5s150855 change 5 sic@
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var MessageHeader v_MessageHeader_Response183;

    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration(-, -, -, "600000"); // @sic R5-151769 change 1 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    /* Table 11.2.6.x.x.x Parallel behaviour
       Steps 5-13 expected sequence defined in annex C.21 of TS 34.229-1 [35]. */
    // @sic R5s220273 - consequence of R5s206434 sic@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(v_OtherCalleeUri);
      
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // @sic R5s140589 sic@
      
    f_IMS_MOCallSetup_AnnexC21C25_Steps5_8(v_InviteRequestWithSdp, v_MessageHeader_Response183);
    f_IMS_MOCallSetup_AnnexC21C25_Step9_11(v_InviteRequestWithSdp);
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);
      
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    //IMS call to be released
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
      
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
      
    //Inform EUTRA : IMS call released
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.6
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_6_IMS2() runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;
    var integer i;
    var integer v_MaxEmgCalls := 13;    // The test case currently sets up 13 IMS Emg Call in Normal service
    timer t_RegExpire;
   
    f_IMS_PTC_Init(PDN_2);

    for (i:=0; i < v_MaxEmgCalls; i:=i+1) {
      
      // Emergency registration: 34.229-1 Annex C.20 with expiration interval of 30 seconds
      f_IMS_EmergencyRegistration(-, "30"); // @sic R5-151769 change 1, R5-165914 sic@
      
      // The registration expiry timer is set to 30 seconds
      t_RegExpire.start(f_IMS_SetTimerToleranceMax(30.0)); // @sic R5-165914 sic@

      // Emergency call setup: 34.229-1 Annex C.22
      v_InviteRequest := f_IMS_EmergencyCallSetup();
      
      // Inform EUTRA: IMS Call established
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
      
      //IMS call to be released.
      f_IMS_IPCAN_WaitForTrigger(IPCAN);
      
      //Release Emergency Call MO
      f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
      f_IMS_GlobalRelease(); // @sic R5s141339 change 2 - additional change sic@

      // Inform EUTRA: IMS Call released.
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // @sic R5s160813 sic@

      // The SS waits for the expiration interval to elapse unless it is the last emergency call
      if (i < (v_MaxEmgCalls - 1)) { // @sic R5-165914 sic@ @sic R5s160813 sic@
        t_RegExpire.timeout;
      }
      else {
        t_RegExpire.stop;
      }
      
      // Inform EUTRA: Reregistration time has expired resp. last Emg Call has been done.
      f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    }
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 11.2.7
   * @status    APPROVED (LTE)
   */
  function f_TC_11_2_7_IMS2() runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var default v_RetransmissionHandler := null; // @sic R5s220985 sic@

    f_IMS_PTC_Init(PDN_2);
    
    // Emergency registration: 34.229-1 Annex C.20
    f_IMS_EmergencyRegistration();
    
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup();

    //Release Emergency Call MO
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    // Receive 2nd optional emergency registration / INVITE for emergency call
    IMS_Server.check(receive(cr_IMS_DATA_REQ_Any) -> value v_IMS_DATA_REQ); // @sic R5s220985 sic@
    // Handle Retransmissions of REGISTER / INVITE that may be received by SS, due to overhead of following few functions post reception of above
    v_RetransmissionHandler := activate(a_IMS_RetransmissionHandler(v_IMS_DATA_REQ));

    if (ischosen(v_IMS_DATA_REQ.Request.Register)) {
      //Release Register info
      f_IMS_GlobalRelease(-, keepUnprotected); // @sic R5s230344 sic@

      // Emergency registration: 34.229-1 Annex C.20
      f_IMS_EmergencyRegistration(v_IMS_DATA_REQ);
    }
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup();

    deactivate(v_RetransmissionHandler);
    
    // Inform EUTRA: IMS Call established.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
     
    //IMS call to be released.
    f_IMS_IPCAN_WaitForTrigger(IPCAN);

    //Release Emergency Call MO
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
    
    // Inform EUTRA: IMS Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

}
