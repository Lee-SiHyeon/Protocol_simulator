      }
      case (POS_C65es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UEA_AGNSS and pc_EPC_MO_LR_RequestPositionEstimate;
      }
      case (POS_C66es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UEB_AGNSS;
      }
      case (POS_C67es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UEA_AGNSS;
      }
      case (POS_C68es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_UEB_AGNSS or pc_UEA_AGNSS);
