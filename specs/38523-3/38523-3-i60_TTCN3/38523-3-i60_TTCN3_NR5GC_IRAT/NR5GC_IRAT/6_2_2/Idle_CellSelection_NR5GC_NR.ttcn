module Idle_CellSelection_NR5GC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_NR_CoordMsg all;
  import from NR5GC_IRAT_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.2.2.1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_6_2_2_1_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT cell selection / From NR RRC_IDLE to EUTRA_Idle / Serving cell becomes non-suitable
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var boolean v_IsFR1;
    
    f_NR5GC_IRAT_Init(NR_6);  // System information combination NR-6 as defined in TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -85);
    
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA);                     // E-UTRA Cell 1 information Rx

    // Table 6.2.2.1.3.3-1: SIB5 of NR Cell 1
    f_NR_CellInfo_SetSIB5_CarrierFreq(nr_Cell1, 0, v_CoOrd_SysInfo.Eutra[0].Arfcn);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    // NR Cell 1 is configured to operate in FR1 bands as defined in TS 38.508-1 clause 6.2.3.
    v_IsFR1 := f_NR_CellInfo_GetIsFR1(nr_Cell1); // @sic R5-225372 sic@
    if (not v_IsFR1) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.2.1: NR Cell 1 shall operate in FR1 bands");
    }

    f_NR5GC_IRAT_PreambleEUTRA_NR(nr_Cell1, STATE_IDLE_1A); // EUTRA cell off (NR cell on) and UE completed registration on NR

    f_NR_TestBody_Set(true);
    fl_TC_6_2_2_1_TestBody();
    f_NR_TestBody_Set(false);

    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    // UE now on EUTRA
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_6_2_2_1
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_6_2_2_1_TestBody() runs on NR5GC_PTC
  {
    // @siclog "Step 1" siclog@
    // The SS adjusts the NR and E-UTRAN Cell power levels according to row "T1" in table 6.2.2.1.3.2-1
    f_NR_SetCellPower (nr_Cell1, -115, -115);

    // @siclog "Step 2" siclog@
    // Send both authentication and NR sysinfo parameters to EUTRA that will be used throughout the test
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);

    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    // @siclog "Step 3" siclog@
    // The SS adjusts the NR and E-UTRAN Cell power levels according to row "T2" in table 6.2.2.1.3.2-1
    f_NR_SetCellPower(nr_Cell1, -85, -85);

    // @siclog "Step 4" siclog@
    // Generic test procedure in TS 38.508-1 Table 4.9.9.2.2-1 take place and UE is camped on NR Cell 1
    // The SS transmits RRCRelease message on NR Cell 1
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell1, -, false);// @sic R5s210043 sic@
    
    // @siclog "Step 5" siclog@
    // The SS changes SIB1 of NR Cell 1 according to table 6.2.2.1.3.3-3 and notifies the UE of change of System Information on NR Cell 1 by sending Short Message on PDCCH using P-RNTI.
    // Table 6.2.2.1.3.3-3: SIB1 for NR Cell 1
    f_NR_CellInfo_SetSIB1_CellReservedForOtherUse(nr_Cell1, true_);
    f_NR_ModifySysinfo(nr_Cell1); //Modify Sysinfo in SS
    
    // @siclog "Step 6" siclog@
    // Wait for 2.1* modification period to allow the new system information to take effect
    f_NR_WaitModificationPeriods(nr_Cell1);
    
    // @siclog "Step 7" siclog@
    // The SS adjusts the NR and E-UTRAN Cell power levels according to row "T3" in table 6.2.3.3.3.2-1
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger); // send coordination to move context to EUTRA

    // @siclog "Step 8" siclog@
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.2.2.2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_6_2_2_2_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT cell selection / From E-UTRA_Idle to NR RRC_IDLE / Serving cell becomes non-suitable
    var EUTRA_NR_CoOrd_SysInfo_Type v_CoOrd_SysInfo;
    var boolean v_IsFR1;
    
    f_NR5GC_IRAT_Init(NR_6);  // System information combination NR-6 as defined in TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -85);
    
    v_CoOrd_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(EUTRA); // E-UTRA Cell 1 information Rx

    // Table 6.2.2.2.3.3-1: SIB5 of NR Cell 1
    f_NR_CellInfo_SetSIB5_CarrierFreq(nr_Cell1, 0, v_CoOrd_SysInfo.Eutra[0].Arfcn);

    // Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    // NR Cell 1 is configured to operate in FR1 bands as defined in TS 38.508-1 clause 6.2.3.
    v_IsFR1 := f_NR_CellInfo_GetIsFR1(nr_Cell1); // @sic R5-225372 sic@
    if (not v_IsFR1) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.2.2: NR Cell 1 shall operate in FR1 bands");
    }
    
    f_NR5GC_IRAT_PreambleNR_EUTRA (nr_Cell1); // EUTRA cell on (NR cell off) and UE completed registration on EUTRA

    f_NR_TestBody_Set(true);
    fl_TC_6_2_2_2_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
    // Tell EUTRA test is finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_6_2_2_2
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_6_2_2_2_TestBody() runs on NR5GC_PTC
  {
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA); // wait power change on EUTRA first to do the steps only on NR side

    // @siclog "Step 1" siclog@
    // The SS adjusts the E-UTRAN and NR Cell power levels according to row "T1" in table 6.2.2.2.3.2-1
    f_NR_SetCellPower (nr_Cell1, -85, -85);

    // @siclog "Step 2" siclog@
    // Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.9.2.2-1 indicate that the UE is camped on NR Cell 1?
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    // @siclog "Step 3" siclog@
    // The SS adjusts the E-UTRAN and NR Cell power levels according to row "T2" in table 6.2.3.1.3.2-1
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);
    f_NR_SetCellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    
    // @siclog "Step 4" siclog@
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);

    // Send both authentication and NR sysinfo parameters to EUTRA that will be used throughout the test
    f_NR5GC_TrackingAreaUpdateFromN1(nr_Cell1);
    
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);  // change power levels on NR side, step 11
    // @siclog "Step 6" siclog@
    // The SS re-adjusts the E-UTRAN and NR Cell levels according to row "T3" in table 6.2.2.2.3.2-1
    f_NR_SetCellPower (nr_Cell1, -85, -85);
    
    // @siclog "Step 7" siclog@
    // Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.9.2.2-1 indicate that the UE is camped on NR Cell 1?
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell1,-,false);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
  }

}
