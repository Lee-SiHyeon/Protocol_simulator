  /*
   * @desc      Assign the parameterised CAG-ID value in SIB1(if available) of the cell
   * @param     p_NR_CellId
   * @param     p_Cag_Identity      (default value: 1)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_SetPNI_NPN_IdentityInfoList( NR_CellId_Type p_NR_CellId,
                                                              integer p_Cag_Identity := 1
                                                            ) runs on NR_BASE_PTC
   {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var template (omit) NPN_IdentityInfoList_r16 v_NPN_IdentityInfoList ;

    v_NPN_IdentityInfoList := f_NR_GetPNI_NPN_IdentityInfoList(v_NR_CellInfo.NAS_Parameters, p_Cag_Identity);
    f_NR_CellInfo_SetSIB1_SetNPN_IdentityInfoList(p_NR_CellId, valueof(v_NPN_IdentityInfoList));
   };

  /*
   * @desc      Initialise NPN_IdentityInfoList_r16 acc to 38.508-1 Table 4.6.3-84AB: NPN-IdentityInfoList with condition CAG
   * @param     p_NAS_Parameters
   * @param     p_Cag_Identity      (default value: 1)
   * @return    template (omit) NPN_IdentityInfoList_r16
   * @status    APPROVED (NR5GC)
   */
  function f_NR_GetPNI_NPN_IdentityInfoList( template (value) NR_NAS_Parameters_Type p_NAS_Parameters,
                                             integer p_Cag_Identity := 1) return template (omit) NPN_IdentityInfoList_r16
   {
     var template (omit) NPN_IdentityInfoList_r16 v_NPN_IdentityInfoList := omit;
     var template (omit) RAN_AreaCode v_NAS_Param_Ranac := omit;

     if (isvalue(p_NAS_Parameters.Ranac)) {
          v_NAS_Param_Ranac := p_NAS_Parameters.Ranac;
     }

     v_NPN_IdentityInfoList := {cs_NPN_IdentityInfo_Def(cs_NPN_IdentityCAG ( valueof(p_NAS_Parameters.PLMN_Identity), valueof(cs_CAG_IdentityInfo(int2bit(p_Cag_Identity,32)))),
                                                         p_NAS_Parameters.TrackingAreaCode,
                                                         v_NAS_Param_Ranac,
                                                         p_NAS_Parameters.CellIdentity)
     }
     return v_NPN_IdentityInfoList;
   }

  /* @desc      Calculate Q_RxLevMin with the parameterized delta value and using q-RxLevMin = ROUND((dB_value+Delta(NRfs))/2).
   *            Set the calculated value in SIB1 of the cell info.
   * @param     p_NR_CellId
   * @param     p_Q_RxLevMinInitial_DB
   * @param     p_DeltaNRFs
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetAndCalculateQ_RxLevMin ( NR_CellId_Type p_NR_CellId,
                                                     float p_Q_RxLevMinInitial_DB,
                                                     integer p_DeltaNRFs
                                                   ) runs on NR_BASE_PTC
  {
    var Q_RxLevMin v_Q_RxLevMin;

    v_Q_RxLevMin := f_NR_CalculateQ_RxLevMin(p_Q_RxLevMinInitial_DB, p_DeltaNRFs);
    f_NR_CellInfo_SetSIB1_CellSelectionInfo(p_NR_CellId, cs_38508_SIB1_CellSelectionInfo(v_Q_RxLevMin));
  }

  /*
   * @desc      Assign the parameterised PUCCH-ConfigCommon in SIB1(if available) of the cell
