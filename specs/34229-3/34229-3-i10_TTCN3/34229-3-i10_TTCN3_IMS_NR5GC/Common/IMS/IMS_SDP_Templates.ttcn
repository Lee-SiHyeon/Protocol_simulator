  /*
   * @desc      returns media attributes for EVS in updated SDP offer
   * @param     p_PrevMediaDescAudioFromUE
   * @param     p_Fmt
   * @return    template (value) SemicolonParam_List
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_SDP_EVS_UpdatedFmtpParams(SDP_media_desc p_PrevMediaDescAudioFromUE,
                                       charstring p_Fmt) return template (value) SemicolonParam_List
  {
    var template (omit) SDP_attribute v_FmtpAttributeEVS := f_SDP_AttributeList_GetAttribute(p_PrevMediaDescAudioFromUE.attributes, cr_SDP_Attribute_fmtp(p_Fmt));
    var charstring v_ReceivedBrVal := f_SIP_SemicolonParamList_GetParamValue(v_FmtpAttributeEVS.fmtp.params.paramList, "br");  /* @sic R5-195318: "br" instead of "br-recv", "br-send" sic@ */
    var charstring v_ReceivedBwVal := f_SIP_SemicolonParamList_GetParamValue(v_FmtpAttributeEVS.fmtp.params.paramList, "bw");  /* @sic R5-195318: "bw" instead of "bw-recv", "bw-send" sic@ */
    var template (value) SemicolonParam_List v_EVS_FmtpParams := cs_EVS_Fmtp_AudioParams(v_ReceivedBrVal, v_ReceivedBwVal);    /* @sic R5-195318 sic@ @sic R5-210056: NR5GC sic@ */
    
    return v_EVS_FmtpParams;
  }

  /*
   * @desc      returns default media attributes for DTMF
   * @param     p_Fmt
   * @param     p_Bandwidth
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_TelephoneEvent(charstring p_Fmt,
                                                charstring p_Bandwidth) return template (omit) SDP_attribute_list
  {
    var template (value) SDP_attribute_list v_MediaAttributes;
    var template (value) SemicolonParam_List v_FmtpParameterList := { cs_GenericParam("0-15") };
    var template (value) SDP_attribute_fmtp_format_specific_params v_FmtpParameters := cs_Fmtp_ParamList(v_FmtpParameterList);
    v_MediaAttributes:= {
      cs_SDP_Attribute_rtpmap(p_Fmt, cs_RTPMAP_TELEPHONE_EVENT(p_Bandwidth)),
      cs_SDP_Attribute_fmtp(p_Fmt, v_FmtpParameters)
    };
    return v_MediaAttributes;
  }

  /*
   * @desc      returns default attributes for audio (at least rtpmap, fmtp)
   * @param     p_FmtAudio
   * @param     p_AddMediaAttributes (default value: omit)
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AMR_WB_AudioCommon(charstring p_FmtAudio,
                                                    template (omit) SDP_attribute_list p_AddMediaAttributes := omit)
    return template (omit) SDP_attribute_list
  {
    var template (value) SDP_attribute_list v_MediaAttributes := {
      cs_SDP_Attribute_rtpmap(p_FmtAudio, cs_RTPMAP_AMR_16000),
      cs_SDP_Attribute_fmtp(p_FmtAudio, cs_AMR_Fmtp_DefaultParameters)
    };
    return f_SDP_Attributes_Concat_TX(v_MediaAttributes, p_AddMediaAttributes);
  }

  /*
   * @desc      returns default media attributes for audio (rtpmap, fmtp, ptime, maxptime)
   * @param     p_FmtAudio
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AMR_WB_AudioDef(charstring p_FmtAudio) return template (omit) SDP_attribute_list
  {
    return f_SDP_MediaAttributes_AMR_WB_AudioCommon(p_FmtAudio, cs_SDP_MediaAttributes_ptime_maxptime);
  }

  /*
   * @desc      returns default media attributes for audio (rtpmap, fmtp, ptime, maxptime)
   * @param     p_Fmt
   * @param     p_AudioCodec        (default value: AMR_16000)
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AMR_AudioDef(charstring p_Fmt,
                                              IMS_SDP_AudioCodec_Type p_AudioCodec := AMR_16000) return template (omit) SDP_attribute_list
  {
    var template (omit) SDP_attribute_list v_MediaAttributes := omit;
    
    select (p_AudioCodec) { // @sic R5s170327 sic@
      case (AMR_8000) {
        v_MediaAttributes := f_SDP_MediaAttributes_AudioDef(p_Fmt);   /* @sic R5-144693: new function f_SDP_MediaAttributes_AudioDef sic@ */
      }
      case (AMR_16000) {
        v_MediaAttributes := f_SDP_MediaAttributes_AMR_WB_AudioDef(p_Fmt);
      }
      case else {
        FatalError(__FILE__, __LINE__, "");
      }
    }
    return v_MediaAttributes;
  }

  type record IMS_SDP_MediaDescriptionRtpList_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT) */
    SDP_fmt_list FmtList,
    SDP_attribute_list AttributeList optional
  };

  template (value) IMS_SDP_MediaDescriptionRtpList_Type cs_IMS_SDP_MediaDescriptionRtpList(SDP_fmt_list p_FmtList,
                                                                                           template (omit) SDP_attribute_list p_AttributeList) :=
  { /* @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT) */
    FmtList := p_FmtList,
    AttributeList := p_AttributeList
  };

  /*
   * @desc      build up a list of fmt values for the given codecs and the list of corresponding media attributes
   * @param     p_AudioCodecList
   * @param     p_EvsConfiguration  (default value: NO_EVS)
   * @param     p_PtimeMaxptime     (default value: cs_SDP_MediaAttributes_ptime_maxptime)
   * @return    template (value) IMS_SDP_MediaDescriptionRtpList_Type
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_SDP_MediaDescriptionInitialOfferAudioTX(IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                                     SDP_EVS_Configuration_MTCallSetup_Type p_EvsConfiguration := NO_EVS,
                                                     template (omit) SDP_attribute_list p_PtimeMaxptime := cs_SDP_MediaAttributes_ptime_maxptime)
    return template (value) IMS_SDP_MediaDescriptionRtpList_Type
  { /* @sic R5-172930/R5-172931: new fucntion sic@ */
    /* @sic R5-231489: p_EvsConfiguration sic@ */
    /* @sic R5-243985: NO_EVS instead of EVS_A2 as default for p_EvsConfiguration sic@ */
    var template (omit) SDP_attribute_list v_MediaAttributes := {};
    var SDP_fmt_list v_FmtList := {};
    var SDP_fmt_list v_AdditionalFmtList := {};
    var charstring v_Fmt;
    var charstring v_AdditionalFmt;
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var integer i;

    for (i:=0; i<lengthof(p_AudioCodecList); i:=i+1) {
      v_AudioCodec := p_AudioCodecList[i];
      v_Fmt := f_SDP_AudioCodec_GetFmt(v_AudioCodec);    /* @sic R5-197050: fix mapping of fmt values sic@ */
      v_FmtList[i] := v_Fmt;
      select (v_AudioCodec) {
        case (AMR_8000) {
          v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_AudioCommon(v_Fmt)); /* @sic R5-165942: f_SDP_MediaAttributes_AudioCommon instead of f_SDP_MediaAttributes_AudioDef to have ptime, maxptime at the end of the list sic@ */
        }
        case (AMR_16000) {  /* SDP media attributes for AMR-WB according to C.45 step 1: */
          v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_AMR_WB_AudioCommon(v_Fmt));
        }
        case (EVS_16000) {  /* SDP media attributes for EVS according to C.45 step 1: */
          select (p_EvsConfiguration) {
            case (EVS_A2) {                                     // @sic R5-231489 sic@
              v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_EVS_AudioCommon(v_Fmt, cs_EVS_Fmtp_AudioParams("5.9-24.4", "nb-swb")));
            }
            case (EVS_B0_A1) {
              v_AdditionalFmt := "102";                         // @sic R5-223456 sic@
              v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_EVS_AudioCommon(v_Fmt,           cs_EVS_Fmtp_AudioParams("13.2",     "swb")));
              v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_EVS_AudioCommon(v_AdditionalFmt, cs_EVS_Fmtp_AudioParams("5.9-13.2", "nb-swb")));  // @sic R5-223456 sic@
              v_AdditionalFmtList := { v_AdditionalFmt };       // @sic R5-223456 sic@
            }
            case (EVS_C45) {                                    // @sic R5-243985: EVS_C45 sic@
              v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_EVS_AudioCommon(v_Fmt, cs_EVS_Fmtp_AudioParams("8-48", "nb-fb")));   /* @sic R5-195318: "br" and "bw" instead of "br-recv", "br-send" and "bw-recv", "bw-send" sic@ */
            }
            case else {                                         // @sic R5-243985: NO_EVS sic@
              FatalError(__FILE__, __LINE__, "unknown EVS configuration");
            }
          }
        }
        case (DTMF_8000) {  /* SDP media attributes for DTMF @sic R5-165942 sic@ @sic R5-172930: DTMF_8000 sic@ */
          v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_TelephoneEvent(v_Fmt, "8000"));
        }
        case (DTMF_16000) { /* SDP media attributes for DTMF @sic R5-172930: DTMF_16000 sic@ */
          v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, f_SDP_MediaAttributes_TelephoneEvent(v_Fmt, "16000"));
        }
        case else {
          FatalError(__FILE__, __LINE__, "");
        }
      }
    }
    v_MediaAttributes := f_SDP_Attributes_Concat_TX(v_MediaAttributes, p_PtimeMaxptime);  /* @sic R5-213524, R5-213538, R5-213539, R5-213541: cs_SDP_MediaAttributes_ptime_maxptime sic@ */
    v_FmtList := v_FmtList & v_AdditionalFmtList;
    return cs_IMS_SDP_MediaDescriptionRtpList(v_FmtList, v_MediaAttributes);
  }

  /*
   * @desc      build up media attributes for non-initial audio offer
   * @param     p_AudioCodec
   * @param     p_PrevSdpFromUE     (default value: omit)
   * @param     p_PtimeMaxptime     (default value: cs_SDP_MediaAttributes_ptime_maxptime)
   * @return    template (value) IMS_SDP_MediaDescriptionRtpList_Type
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_SDP_MediaDescriptionSubsequentOfferAudioTX(IMS_SDP_AudioCodec_Type p_AudioCodec,
                                                        template (omit) SDP_Message p_PrevSdpFromUE := omit,
                                                        template (omit) SDP_attribute_list p_PtimeMaxptime := cs_SDP_MediaAttributes_ptime_maxptime) return template (value) IMS_SDP_MediaDescriptionRtpList_Type
  { /* @sic R5-213524, R5-213538, R5-213539, R5-213541: new common function sic@ */
    var template (omit) SDP_attribute_list v_MediaAttributes;
    var template (value) SemicolonParam_List v_EVS_FmtpParams;
    var SDP_Message v_PrevSdpFromUE;
    var SDP_media_desc v_MediaDesc;
    var charstring v_Fmt := f_SDP_AudioCodec_GetFmt(p_AudioCodec);

    if (isvalue(p_PrevSdpFromUE)) {
      v_PrevSdpFromUE := valueof(p_PrevSdpFromUE);
      v_MediaDesc := valueof(f_IMS_SDP_MediaList_GetMediaStream(v_PrevSdpFromUE.media_list, c_audio));
      v_Fmt := f_SDP_MediaDescr_GetAudioCodec(v_MediaDesc, p_AudioCodec);
    }

    select (p_AudioCodec) {
      case (AMR_8000) {
        v_MediaAttributes := f_SDP_MediaAttributes_AudioCommon(v_Fmt, p_PtimeMaxptime);
      }
      case (AMR_16000) {   /* @sic R5-168057 => C.11 sic@ */
        v_MediaAttributes := f_SDP_MediaAttributes_AMR_WB_AudioCommon(v_Fmt, p_PtimeMaxptime);              /* @sic R5-144693: new function f_SDP_MediaAttributes_AudioDef; R5-168057: change for AMR_16000 sic@ */
      }
      case (EVS_16000) {   /* => C.45 @sic R5-153798 sic@ */
        if (not isbound(v_MediaDesc)) {
          FatalError(__FILE__, __LINE__, "");
        }
        v_EVS_FmtpParams := f_SDP_EVS_UpdatedFmtpParams(v_MediaDesc, v_Fmt);
        v_MediaAttributes := f_SDP_MediaAttributes_EVS_AudioCommon(v_Fmt, v_EVS_FmtpParams, p_PtimeMaxptime);
      }
    }
    return cs_IMS_SDP_MediaDescriptionRtpList({v_Fmt}, v_MediaAttributes);
  }

  /*
   * @desc      return media attributes for given list of codecs
   * @param     p_AudioCodecList
   * @param     p_SDP_AdditionalMediaAttributes (default value: cr_SDP_MediaAttributes_ptime_maxptime)
   * @return    template (present) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributesAudioCodecListRX(IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                                 template (present) SDP_attribute_list p_SDP_AdditionalMediaAttributes := cr_SDP_MediaAttributes_ptime_maxptime) return template (present) SDP_attribute_list
  { /* @sic R5-172930/R5-172931: new fucntion sic@ */
    var template (present) SDP_attribute_list v_MediaAttributes := {};
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodecInfo;
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters;
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var integer i;
    
    for (i:=0; i<lengthof(p_AudioCodecList); i:=i+1) {
      v_AudioCodec := p_AudioCodecList[i];
      v_RtpmapCodecInfo := f_SDP_AttributeRtpmapAudioRX(v_AudioCodec);
      v_FmtpParameters := f_SDP_FmtpDefaultParametersAudioCodecRX(v_AudioCodec);
      v_MediaAttributes := f_SDP_Attributes_Add_RX(v_MediaAttributes, cr_SDP_Attribute_rtpmap(-, v_RtpmapCodecInfo));
      v_MediaAttributes := f_SDP_Attributes_Add_RX(v_MediaAttributes, cr_SDP_Attribute_fmtp(-, v_FmtpParameters));
    }
    v_MediaAttributes := f_SDP_Attributes_Concat_RX(v_MediaAttributes, p_SDP_AdditionalMediaAttributes);
    return v_MediaAttributes;
  }

