    cs_NewInterFreqCell_FDD(p_InterCellInfo2_CellId, p_InterCellInfo2_FreqInfo, p_InterCellInfo2_PriScrmCode),
    cs_NewInterFreqCell_FDD(p_InterCellInfo3_CellId, p_InterCellInfo3_FreqInfo, p_InterCellInfo3_PriScrmCode),
    cs_NewInterFreqCell_FDD(p_InterCellInfo4_CellId, p_InterCellInfo4_FreqInfo, p_InterCellInfo4_PriScrmCode),
    cs_NewInterFreqCell_FDD(p_InterCellInfo5_CellId, p_InterCellInfo5_FreqInfo, p_InterCellInfo5_PriScrmCode),
    cs_NewInterFreqCell_FDD(p_InterCellInfo6_CellId, p_InterCellInfo6_FreqInfo, p_InterCellInfo6_PriScrmCode)
  };

  template (value) SysInfoType11 cs_SIB11_2Intra_6Inter_FDD(integer p_ActiveCellInfo_CellId,
                                                            PrimaryScramblingCode p_ActiveCellInfo_PriScrmCode,
                                                            integer p_IntraCellInfo2_CellId,
                                                            PrimaryScramblingCode p_IntraCellInfo2_PriScrmCode,
                                                            integer p_InterCellInfo1_CellId,
                                                            FrequencyInfo p_InterCellInfo1_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo1_PriScrmCode,
                                                            integer p_InterCellInfo2_CellId,
                                                            FrequencyInfo p_InterCellInfo2_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo2_PriScrmCode,
                                                            integer p_InterCellInfo3_CellId,
                                                            FrequencyInfo p_InterCellInfo3_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo3_PriScrmCode,
                                                            integer p_InterCellInfo4_CellId,
                                                            FrequencyInfo p_InterCellInfo4_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo4_PriScrmCode,
                                                            integer p_InterCellInfo5_CellId,
                                                            FrequencyInfo p_InterCellInfo5_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo5_PriScrmCode,
                                                            integer p_InterCellInfo6_CellId,
                                                            FrequencyInfo p_InterCellInfo6_FreqInfo,
                                                            PrimaryScramblingCode p_InterCellInfo6_PriScrmCode) :=
  /* @status    APPROVED (UTRAN) */
    cs_SIB11_Common_FDD(cs_NewIntraFreqCellList2_FDD(p_ActiveCellInfo_CellId, p_ActiveCellInfo_PriScrmCode,
                                                     p_IntraCellInfo2_CellId, p_IntraCellInfo2_PriScrmCode),
                        cs_NewInterFreqCellList6_FDD(p_InterCellInfo1_CellId, p_InterCellInfo1_FreqInfo, p_InterCellInfo1_PriScrmCode,
                                                     p_InterCellInfo2_CellId, p_InterCellInfo2_FreqInfo, p_InterCellInfo2_PriScrmCode,
                                                     p_InterCellInfo3_CellId, p_InterCellInfo3_FreqInfo, p_InterCellInfo3_PriScrmCode,
                                                     p_InterCellInfo4_CellId, p_InterCellInfo4_FreqInfo, p_InterCellInfo4_PriScrmCode,
                                                     p_InterCellInfo5_CellId, p_InterCellInfo5_FreqInfo, p_InterCellInfo5_PriScrmCode,
                                                     p_InterCellInfo6_CellId, p_InterCellInfo6_FreqInfo, p_InterCellInfo6_PriScrmCode));

  template (present) UL_DCCH_Message cdr_RadioBearerReconfigurationComplete_Any(RRC_TransactionIdentifier p_RRC_Ti)
