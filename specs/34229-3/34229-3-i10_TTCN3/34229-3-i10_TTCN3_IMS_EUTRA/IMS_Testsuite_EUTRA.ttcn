  //----------------------------------------------------------------------------
  testcase TC_10_1() runs on MTC_IMS system SYSTEM_IMS {
    // @purpose
    //   Invalid Behaviour - 503 Service Unavailable
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_IMS1 := IMS_PTC.create("IMS1") alive;
  
    f_MTC_IMS_CreateMapAndConnectPTCs_EUTRA(system, v_IMS1, v_IMS2);
  
    v_IMS1.start(f_TC_10_1_IMS1());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_IMS(t_GuardTimer);
  }
