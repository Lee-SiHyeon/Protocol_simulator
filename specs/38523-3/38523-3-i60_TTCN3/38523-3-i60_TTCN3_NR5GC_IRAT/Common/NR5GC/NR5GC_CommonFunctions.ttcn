module NR5GC_CommonFunctions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_Parameters all;
  import from LoopbackIP all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_TypeDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_FrequencyCommon all;
  import from NR_FrequencyHighestBandwidth all;
  import from NR_FrequencyInit_SA all;
  import from NR_Frequency_NTN_FlexibleTxRx all;
  import from NR_Parameters all;
  import from TestcaseProperties all;

  type enumerated NR5GC_NAS_CellSpecialFreq {  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    NR5GC_NAS_NormalFreq,
    NR5GC_NAS_ReplaceNRf2_NRf1, // NR5GC NAS test case: replace NRf2 by NRf1 @sic R5-198148 sic@
    NR5GC_NAS_ReplaceNRf3_NRf1, // NR5GC NAS test case: replace NRf3 by NRf1
    NR5GC_NAS_ReplaceNRf3_NRf2, // NR5GC NAS test case: replace NRf3 by NRf2
    NR5GC_NAS_ReplaceNRf4_NRf3  // NR5GC NAS test case: replace NRf4 by NRf3
  };

  template (value) NG_CellInfo_Type cs_NG_CellInfoDef (template (value) NG_NAS_GutiParameters_Type p_Guti) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Guti := p_Guti
  }

  /*
   * @desc      Return Guti Parameters (PLMN is stored in NR_Base)
   * @param     p_NR_CellId
   * @return    NG_NAS_GutiParameters_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
    function f_NR5GC_CellInfo_GetGutiParameters(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC return NG_NAS_GutiParameters_Type
    {
      var integer v_Index := f_NR_CellInfo_GetIndex(p_NR_CellId);
      return vc_NR5GC_Global.CellArray[v_Index].Guti;
    }

  /*
   * @desc      Return S-Tmsi stored in the Guti Parameter of the cell
   * @param     p_NR_CellId
   * @return    B32_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CellInfo_GetNG_TMSI(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC return B32_Type
  {
    var integer v_Index := f_NR_CellInfo_GetIndex(p_NR_CellId);
    return vc_NR5GC_Global.CellArray[v_Index].Guti.NG_TMSI;
  }

  /*
   * @desc      To map the NAS cell id to an NR cell
   * @param     p_NASCell
   * @param     p_NumOfPLMN
   * @return    NR_CellId_Type
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_MapNASCell(NGC_CellId_Type p_NASCell,
                              NG_NAS_NumOfPLMN_Type p_NumOfPLMN) return NR_CellId_Type
  {
    var NR_CellId_Type v_NRCell;
    select (p_NASCell) {
      case (ngc_Cell_NonSpecific) {
        v_NRCell := nr_Cell_NonSpecific;
      }
      case (ngc_CellA) {
        v_NRCell := nr_Cell1;
      }
      case (ngc_CellB) {
        v_NRCell := nr_Cell2;
      }
      case (ngc_CellC) {
        v_NRCell := nr_Cell4;
      }
      case (ngc_CellD) {
        v_NRCell := nr_Cell11;
      }
      case (ngc_CellE) {
        v_NRCell := nr_Cell3;
      }
      case (ngc_CellF) {
        if (p_NumOfPLMN == NG_AllCellsOnSamePLMN){
          v_NRCell := nr_Cell3;
        } else {
          v_NRCell := nr_Cell14;
        }
      }
      case (ngc_CellG) {
        v_NRCell := nr_Cell12;
      }
      case (ngc_CellH) {
        v_NRCell := nr_Cell23;
      }
      case (ngc_CellI) {
        v_NRCell := nr_Cell6;
      }
      case (ngc_CellJ) {
        if (p_NumOfPLMN == NG_AllCellsOnSamePLMN){
          v_NRCell := nr_Cell12;
        } else {
          v_NRCell := nr_Cell13;
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "");
      }
    }
    return v_NRCell;
  }

  /*
   * @desc      To Initialise the RRC cells with NAS GUTI values
   *            according to 38.508-1 cl. 4.4.2-3
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RRC_InitGuti() runs on NR5GC_PTC
  {
    var integer v_Index;
    var NG_CellInfoList_Type v_NG_CellArray;
    var B32_Type v_NG_TMSI := tsc_NG_TMSI1;

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell1);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell2);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell3);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell4);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell6);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell10);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell11);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell23);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell12);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(253, 8), v_NG_TMSI)));

    v_Index := f_NR_CellInfo_GetIndex(nr_Cell28);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(253, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell13);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(252, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell29);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(252, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell14);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(251, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell30);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(251, 8), v_NG_TMSI)));
   
    v_Index := f_NR_CellInfo_GetIndex(nr_Cell31);
    v_NG_CellArray[v_Index] := valueof(cs_NG_CellInfoDef(cs_NG_NAS_GutiParameters(int2bit(254, 8), v_NG_TMSI)));

    // Now initialise global variable
    vc_NR5GC_Global.CellArray := v_NG_CellArray;
  }

  /*
   * @desc      common initialisation of the NR5GC_PTC for RRC Tests
   * @param     p_NR_SysinfoCombination
   * @param     p_NAS_CellSpecialFreq (default value: NR5GC_NAS_NormalFreq)
   * @param     p_Neighbour_NTN_Cells (default value: omit)
   * @param     p_NTN_CandidateTCForFlexibleTxRx (default value: false)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_Init(NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                        NR5GC_NAS_CellSpecialFreq p_NAS_CellSpecialFreq := NR5GC_NAS_NormalFreq,
                        template (omit) NR_CellIdList_Type p_Neighbour_NTN_Cells := omit,
                        boolean p_NTN_CandidateTCForFlexibleTxRx := false
                        ) runs on NR5GC_PTC
  { //@sic R5-195681: added p_NAS_CellSpecialFreq; R5-254262: added p_NTN_CandidateTCForFlexibleTxRx sic@
    // p_NTN_CandidateTCForFlexibleTxRx to be set to TRUE in NR NTN test cases using px_NR_NTN_TxRx_FrequencySeparation to set the frequency separation
    var template (value) NR_Frequencyf1tof4_Type v_NR_PrimaryFrequencyf1Tof4;
    var template (value) NR_Frequencyf1tof4_Type v_NR_SecondaryFrequencyf1tof4;

    // Set test environment depending on the bands under test - Needs to be done before calling the init function making use of it
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 R5s220477 sic@
    if (f_GetTestcaseAttrib_InterBandTC(testcasename())) {
    // test case using 2 bands
       f_NR_InitTestEnvironmnent(px_NR_PrimaryBand, px_NR_SecondaryBand);
    } else { // test case using 1 band
       f_NR_InitTestEnvironmnent(px_NR_PrimaryBand, omit);
    }
    if (not f_GetTestcaseAttrib_HighestCarrierBandwidth(testcasename())) {
      if (p_NTN_CandidateTCForFlexibleTxRx and (px_NR_NTN_TxRx_FrequencySeparation == flexible)) {  //@sic R5-254262 sic@
        //NR NTN Frequencies are set with the applicable Tx-Rx frequency separation specified in px_NR_NTN_TxRx_FrequencySeparation = flexible
        if(f_NR_IsBandNTN(px_NR_PrimaryBand)){
          v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetFrequencyNTN_FlexibleTxRx(px_NR_PrimaryBand);
        } else {  //In case of NTN/TN TC scenario
          v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetFrequencySA_f1tof4(px_NR_PrimaryBand);
        }
        if(f_NR_IsBandNTN(px_NR_SecondaryBand)){
          v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetFrequencyNTN_FlexibleTxRx(px_NR_SecondaryBand);
        } else {//In case of NTN/TN TC scenario
          v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetFrequencySA_f1tof4(px_NR_SecondaryBand);
        }
      } else {
        // For NR NTN - default Tx-Rx frequency separation is used - Acc to 38.508-1 cl 6.2.3.8
        v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetFrequencySA_f1tof4(px_NR_PrimaryBand);
        v_NR_SecondaryFrequencyf1tof4 := f_NR_GetFrequencySA_f1tof4(px_NR_SecondaryBand);
      }
    } else { //@sic R5s190826/827 sic@
        v_NR_PrimaryFrequencyf1Tof4 := f_NR_GetHighestBandwidthFrequency(px_NR_PrimaryBand);
        v_NR_SecondaryFrequencyf1tof4 := f_NR_GetHighestBandwidthFrequency(px_NR_SecondaryBand);
    }
        
    select (p_NAS_CellSpecialFreq) {
        case(NR5GC_NAS_ReplaceNRf2_NRf1) {
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f2 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f1;  // @sic R5s210820 sic@
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f2 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f1;  // @sic R5s210820 sic@
        }
        case(NR5GC_NAS_ReplaceNRf3_NRf1) {
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f3 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f1;  // @sic R5s210820 sic@
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f3 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f1;  // @sic R5s210820 sic@
        }
        case(NR5GC_NAS_ReplaceNRf3_NRf2) {
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f3 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f2;
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f3 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f2;
        }
        case(NR5GC_NAS_ReplaceNRf4_NRf3){
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f4 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoDL_f3;
            v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f4 := v_NR_PrimaryFrequencyf1Tof4.FrequencyInfoUL_f3;
        }
    }
    f_NR_InitCommon( v_NR_PrimaryFrequencyf1Tof4, px_NR_PrimaryBand, v_NR_SecondaryFrequencyf1tof4, px_NR_SecondaryBand, p_NR_SysinfoCombination, p_Neighbour_NTN_Cells); //@sic R5w240105r1, R5-242320 sic@
  }

  /*
   * @desc      Common local initialisation of the NR5GC_PTC for RRC and CA Tests
   *            NOTE: local function ONLY
   * @param     p_NR_PrimaryFrequencyf1tof4
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_NR_SecondaryFrequencyf1tof4 (default value: cs_NR_Frequencyf1tof4_Dummy)
   * @param     p_SecondaryFreqBandIndicatorNR (default value: 1)
   * @param     p_NR_SysinfoCombination
   * @param     p_Neighbour_NTN_Cells (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_InitCommon ( template (value) NR_Frequencyf1tof4_Type p_NR_PrimaryFrequencyf1tof4,
                              FreqBandIndicatorNR  p_PrimaryFreqBandIndicatorNR,
                              template (value) NR_Frequencyf1tof4_Type p_NR_SecondaryFrequencyf1tof4 := cs_NR_Frequencyf1tof4_Dummy, //Dummy value for configuration with no secondary band
                              FreqBandIndicatorNR  p_SecondaryFreqBandIndicatorNR  := 1,    //Dummy value for configuration with no secondary band
                              NR_SysinfoCombination_Type p_NR_SysinfoCombination,
                              template (omit) NR_CellIdList_Type p_Neighbour_NTN_Cells := omit
                              ) runs on NR5GC_PTC
  {
    f_NR_Init(NR_SA, p_NR_PrimaryFrequencyf1tof4, p_PrimaryFreqBandIndicatorNR, p_NR_SecondaryFrequencyf1tof4, p_SecondaryFreqBandIndicatorNR, p_NR_SysinfoCombination);
    f_NR_RRC_InitGuti();  //@sic R5-187660 sic@
    f_NR5GC_Ctrl_Init ();
    f_NR5GC_Security_Init();
    f_NR5GC_MobileInfo_Init();
    f_NR5GC_ActivateDefault();
    f_NR5GC_UpdateNeigbourNTNCells(p_Neighbour_NTN_Cells); //@sic R5w240105r1, R5-242320 sic@
    f_NR5GC_MsgInDefault_ResetStoreOfNASMessageReq();      //@sic R5s250265 MCC160 implementation for change 6.2 sic@
    f_NR5GC_SetNetworkSupport(NOT_SUPPORTED); // Set this as default @sic R5-255943 sic@
  }

  /*
   * @desc      Add a new PDU Session in global Mobile Info
   * @param     p_SessionInfo
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_MobileInfo_AddPDUSession(GSM_MobilityInfo_Type p_SessionInfo) runs on NR5GC_PTC
  {
    var integer v_NoOfSessions := f_NR5GC_MobileInfo_GetNoOfSessions();
    var PDUSessionInfoList_Type v_List;
    
    if (v_NoOfSessions > 0) { // if list already exists, get current version
      v_List := f_NR5GC_MobileInfo_GetSessionInfoList();
    }
    // add new info to next/first element
    v_List[v_NoOfSessions] := p_SessionInfo;
    // now store back updated values
    f_NR5GC_MobileInfo_SetSessionInfoList (v_List);
  }

  /*
   * @desc      Get and return a 5G GUTI as a NG_MobileIdentity
   * @param     p_NR_CellId
   * @param     p_IEI               (default value: '77'O)
   * @return    template (value) NG_MobileIdentity
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_GetMobileIdGUTI (NR_CellId_Type p_NR_CellId,
                                    template (omit) IEI8_Type p_IEI := '77'O) runs on NR5GC_PTC return template (value) NG_MobileIdentity
  {
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);

    return f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams, p_IEI); // @sic R5s190761 sic@
  }

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_NR_CellId
   * @param     p_PdnIndex
   * @param     p_BearerType
   * @param     p_DRBId
   * @param     p_StepNo            (default value: "")
   * @param     p_SequenceNumber    (default value: 1)
   * @param     p_CheckPING         (default value: true)
   * @param     p_NR_RlcRoutingCellId (default value: omit)
   * @param     p_MacBearerRoutingDL (default value: omit)
   * @param     p_MacBearerRoutingUL (default value: omit)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_EUTRA_RlcRoutingCellId (default value: omit)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_CheckDataPath(NR_CellId_Type p_NR_CellId,
                                 PDN_Index_Type p_PdnIndex,
                                 DataPathCheck_BearerType_Type p_BearerType,
                                 DRB_Identity p_DRBId,
                                 charstring p_StepNo := "",
                                 integer p_SequenceNumber := 1,
                                 boolean p_CheckPING := true,
                                 template (omit) NR_CellId_Type p_NR_RlcRoutingCellId := omit,
                                 template (omit) MacBearerRouting_Type p_MacBearerRoutingDL := omit,
                                 template (omit) MacBearerRouting_Type p_MacBearerRoutingUL := omit,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now, //@sic R5-216260 sic@
                                 template (omit) EUTRA_CellId_Type p_EUTRA_RlcRoutingCellId := omit
                                 ) runs on NR5GC_PTC
  { //@sic R5-213516: deleted p_UL_Cell added p_MacBearerRoutingUL and p_MacBearerRoutingDL sic@
   var octetstring v_SduTX := f_LoopbackModeBorPing_GetDataTX(p_PdnIndex, p_BearerType, p_SequenceNumber, p_CheckPING);   // @sic R5-206332 sic@
   var template (value) NR_DRB_COMMON_REQ v_DRB_DL;
   var template (present) NR_DRB_COMMON_IND v_DRB_UL;
   var template (value) QosFlow_Identification_Type v_QosFlowId;
   
   v_QosFlowId := f_NR_GetQosFlowIdentification_ForDRBId(p_DRBId);
   v_DRB_DL := cas_NR_DRB_COMMON_REQ_SDAP_SDUList(p_NR_CellId, v_QosFlowId, { v_SduTX }, p_TimingInfo, -, p_MacBearerRoutingDL);
   v_DRB_UL := car_NR_DRB_COMMON_IND_SDAP_SDUList(p_NR_CellId, v_QosFlowId, { ? }, -, p_MacBearerRoutingUL);   /* @sic R5s200341 Change 2: ? instead of v_SduTX sic@ */
   //When data is routed to anoter cell - e.g. split DRB or MN terminated SCG DRB or SN terminated MCG DRB
   if (isvalue(p_NR_RlcRoutingCellId)) { //compiler warning may be ignored due to check
        v_DRB_DL.Common.RlcBearerRouting := cs_RlcBearerRouting_NR(p_NR_RlcRoutingCellId);
        v_DRB_UL.Common.RlcBearerRouting := cs_RlcBearerRouting_NR(p_NR_RlcRoutingCellId);
   }
   if (isvalue(p_EUTRA_RlcRoutingCellId)) { //compiler warning may be ignored due to check
        v_DRB_DL.Common.RlcBearerRouting := crs_RlcBearerRouting_Eutra(p_EUTRA_RlcRoutingCellId);
        v_DRB_UL.Common.RlcBearerRouting := crs_RlcBearerRouting_Eutra(p_EUTRA_RlcRoutingCellId);
   }
   f_NR_CheckDataPathCommon(v_SduTX, v_DRB_DL, v_DRB_UL, p_StepNo, p_CheckPING);  // @sic R5-206332 sic@
 }

  /*
   * @desc      Loop back one IP packet to verify the data path
   *            Always use loopback, regardless of whether UE supports PING
   * @param     p_NR_CellId
   * @param     p_PDUSession_MobilityInfo
   * @param     p_StepNo            (default value: "")
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR5GC_LoopbackIPdataOnDefaultBearer(NR_CellId_Type p_NR_CellId,
                                 GSM_MobilityInfo_Type p_PDUSession_MobilityInfo,
                                 charstring p_StepNo := "") runs on NR5GC_PTC
  {
   var integer v_DRBId := f_NR_GetDefaultDRB_InDRBList (f_NR_GetDRBList_ForGivenPDUSession(oct2int((p_PDUSession_MobilityInfo.SessionId))));
   f_NR5GC_CheckDataPath (p_NR_CellId,
                          f_NR5GC_GetPdnIndex(p_PDUSession_MobilityInfo),
                          defaultBearer,
                          v_DRBId,
                          p_StepNo,
                          -,
                          false);
 }

  /*
   * @desc      To return the DRB Info for the given DR id
   * @param     p_DRBId
   * @return    template (omit) NR_DRBInfo_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetDRBInfo_FromId(integer p_DRBId)  runs on NR5GC_PTC return template (omit) NR_DRBInfo_Type
  {
    var integer i;
    var NR_DRBInfoList_Type v_ExistingDRBs := f_NR5GC_MobileInfo_GetDRBInfoList();
    
    for (i:= 0; i < lengthof(v_ExistingDRBs); i :=i+1) {
      if (match (v_ExistingDRBs[i].DRB_Id, p_DRBId)) {
        return v_ExistingDRBs[i];
      }
    }
    return omit;
  }

  /*
   * @desc      To return the index of the entry in the DRB Info list or -1 if no entry has been found
   * @param     p_ExistingDRBs
   * @param     p_DRBId
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DRBInfo_FindEntry(NR_DRBInfoList_Type p_ExistingDRBs,
                                  integer p_DRBId) return integer
  {
    var integer i;
    
    for (i:= 0; i < lengthof(p_ExistingDRBs); i :=i+1) {
      if (match (p_ExistingDRBs[i].DRB_Id, p_DRBId)) {
        return i;
      }
    }
    return -1;
  }

  /*
   * @desc      To add a single entry to the DRB Info list, or overwrite the current entry if it already exists
   * @param     p_ExistingDRBs
   * @param     p_DRBInfo
   * @return    NR_DRBInfoList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DRBInfo_AddEntry(NR_DRBInfoList_Type p_ExistingDRBs,
                                 NR_DRBInfo_Type p_DRBInfo) return NR_DRBInfoList_Type
  {
    var NR_DRBInfoList_Type v_NewList := p_ExistingDRBs;
    var integer v_Index := f_NR_DRBInfo_FindEntry(p_ExistingDRBs, p_DRBInfo.DRB_Id);
    
    if (v_Index < 0) { // No entry found => new entry
      v_Index := lengthof(p_ExistingDRBs);
    } else {} // existing entry, just overwrite
    
    v_NewList[v_Index] := p_DRBInfo;
    return v_NewList;
  }

  /*
   * @desc      To add a list of entries to the DRB Info list, or overwrite the current entry if one already exists
   * @param     p_ExistingDRBs
   * @param     p_ListToAdd
   * @return    NR_DRBInfoList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DRBInfo_AddListOfEntries(NR_DRBInfoList_Type p_ExistingDRBs,
                                         NR_DRBInfoList_Type p_ListToAdd) return NR_DRBInfoList_Type
  {
    var NR_DRBInfoList_Type v_NewList := p_ExistingDRBs;
    var integer i;
    
    for (i := 0; i < lengthof(p_ListToAdd); i := i+1) {
      // Keep overwriting v_NewList
      v_NewList := f_NR_DRBInfo_AddEntry (v_NewList, p_ListToAdd[i]);
    }
    return v_NewList;
  }

  /*
   * @desc      To remove an entry in the DRB Info list
   * @param     p_ExistingDRBs
   * @param     p_DRBId
   * @return    NR_DRBInfoList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DRBInfo_RemoveEntry(NR_DRBInfoList_Type p_ExistingDRBs,
                                    integer p_DRBId) return NR_DRBInfoList_Type
  {
    var NR_DRBInfoList_Type v_NewList := {}; // @sic R5s191170 sic@
    var integer i;
    var integer j := 0;
    var integer v_Index := f_NR_DRBInfo_FindEntry(p_ExistingDRBs, p_DRBId
                                                  );
    
    if (v_Index < 0) { // entry not found
      return p_ExistingDRBs;
    }
    for (i:= 0; i < lengthof(p_ExistingDRBs); i :=i+1) {
      if (i != v_Index) {
        v_NewList[j] := p_ExistingDRBs[i];
        j := j+ 1;
      }
    }
    return v_NewList;
  }

  /*
   * @desc      To get DRB(s) associated with the provided PDU session
   * @param     p_PDUSessionId
   * @return    IntegerList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetDRBList_ForGivenPDUSession (integer p_PDUSessionId) runs on NR5GC_PTC return IntegerList_Type
  {
    var integer v_NoOfDRBs := f_NR5GC_MobileInfo_GetNoOfDRBs();
    var NR_DRBInfoList_Type v_ExistingDRBs;
    var IntegerList_Type v_ListOfDRBs;
    var integer i;
    var integer k := 0;
    
    if (p_PDUSessionId >= 0) { // Found a PDU session
      if (v_NoOfDRBs == 0) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "No DRBs have been configured");
        return {-1};
      } else {
        v_ExistingDRBs := f_NR5GC_MobileInfo_GetDRBInfoList();
        for (i:= 0; i < lengthof(v_ExistingDRBs); i :=i+1) { // The same PDU session id might be in more than 1 DRB
          if (match (v_ExistingDRBs[i].PDUSessionId, p_PDUSessionId)) {
            v_ListOfDRBs[k] :=  v_ExistingDRBs[i].DRB_Id;
            k := k + 1;
          }
        }
        return v_ListOfDRBs;
      }
    } else {  // just return the error (in a list format)
      return {p_PDUSessionId}
    }
  }

  /*
   * @desc      To get default DRB from a list of DRBs
   * @param     p_ListOfDRBs
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetDefaultDRB_InDRBList (IntegerList_Type p_ListOfDRBs) runs on NR5GC_PTC return integer
  {
    var NR_DRBInfoList_Type v_ExistingDRBs;
    var integer i;
    var integer v_DRBIndex;
    
    if (lengthof(p_ListOfDRBs) == 1) {
      if (p_ListOfDRBs[0] < 0) { // There's an error @sic R5s201078 sic@
        return -1;
      } else { // only one entry and not an error
        return p_ListOfDRBs[0];
      }
    } else { // more than entry
      v_ExistingDRBs := f_NR5GC_MobileInfo_GetDRBInfoList();
      for (i:= 0; i < lengthof(p_ListOfDRBs); i :=i+1) { // find the default DRB
        v_DRBIndex := f_NR_DRBInfo_FindEntry (v_ExistingDRBs, p_ListOfDRBs[i]);
        if (v_ExistingDRBs[v_DRBIndex].DefaultDRB) {
          break;
        }
      }
      return p_ListOfDRBs[i];
    }
  }

  /*
   * @desc      To get QoSFlow Identification from DRB Id
   *            Note: This just returns the first QFI in the list
   * @param     p_DRBId
   * @return    template (value) QosFlow_Identification_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_GetQosFlowIdentification_ForDRBId (integer p_DRBId) runs on NR5GC_PTC return template (value) QosFlow_Identification_Type
  {
    var NR_DRBInfoList_Type v_ExistingDRBs := f_NR5GC_MobileInfo_GetDRBInfoList();
    var integer v_Index := f_NR_DRBInfo_FindEntry (v_ExistingDRBs, p_DRBId);
    
    return cs_IP_QosFlowId(v_ExistingDRBs[v_Index].PDUSessionId,
                           v_ExistingDRBs[v_Index].SDAP_Config.mappedQoS_FlowsToAdd[0]);
  }

  /*
   * @desc      Allocate the next, unused, DRB Identities
   *            Note: There is a constant value for the DRB Id to use for IMS registration (default DRB for IMS)
   * @param     p_GSM_MobilityInfo
   * @param     p_DefaultDRB
   * @param     p_NoOfDRBs          (default value: 1)
   * @return    IntegerList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetNextDRBIds (template (omit) GSM_MobilityInfo_Type p_GSM_MobilityInfo, boolean p_DefaultDRB, integer p_NoOfDRBs := 1) runs on NR5GC_PTC return IntegerList_Type
  {
    var integer v_NoOfExistingDRBs := f_NR5GC_MobileInfo_GetNoOfDRBs();
    var integer v_DRBId := 0;
    var IntegerList_Type v_DRBList;
    var NR_DRBInfoList_Type v_ExistingDRBs;
    var integer v_Index;
    var boolean v_AlreadyIMS_DRB := false;
    var integer j := 0;
    
    if (v_NoOfExistingDRBs > 0) {
      v_ExistingDRBs := f_NR5GC_MobileInfo_GetDRBInfoList();
        v_Index := f_NR_DRBInfo_FindEntry(v_ExistingDRBs, tsc_NR_IMS_DRB);
        if (v_Index >= 0) { // IMS is already allocated
          v_AlreadyIMS_DRB := true;
        }
    }
    if (isvalue(p_GSM_MobilityInfo)) { // @sic R5-204399 sic@
      if (match (IMS_DNN, p_GSM_MobilityInfo.PDUType) and p_DefaultDRB) { // @sic R5-206296 sic@
        v_DRBList[j] := tsc_NR_IMS_DRB;
        j := j+1;
      }
    }
    
    while (j < p_NoOfDRBs) {
      if (v_AlreadyIMS_DRB) {
        v_DRBId := v_NoOfExistingDRBs + (2-1); // allocate the next one, from 2 onwards
      } else { // IMS is not yet allocated
        v_DRBId := v_NoOfExistingDRBs + 2;
      }
      v_DRBList[j] := v_DRBId;
      j := j+1;
      // now update number of DRBs whilst in the loop
      v_NoOfExistingDRBs := v_NoOfExistingDRBs +1;
    }
    return v_DRBList;
  }

  /*
   * @desc      Allocate the next, unused, DRB Identity
   *            Note: There is a constant value for the DRB Id to use for IMS registration (default DRB for IMS)
   *
   * @param     p_GSM_MobilityInfo
   * @param     p_DefaultDRB
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetNextDRBId (GSM_MobilityInfo_Type p_GSM_MobilityInfo, boolean p_DefaultDRB) runs on NR5GC_PTC return integer
  {
    var IntegerList_Type v_List := f_NR_GetNextDRBIds(p_GSM_MobilityInfo, p_DefaultDRB);
    return v_List[0];
  }

}
