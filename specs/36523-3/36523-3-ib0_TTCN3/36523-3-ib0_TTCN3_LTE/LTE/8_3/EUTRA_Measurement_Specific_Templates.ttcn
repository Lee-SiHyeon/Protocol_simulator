                                                                                                                               p_MeasurementBandwidth,
                                                                                                                               omit,
                                                                                                                               cs_ExcludedCellsToAddModList_1Entry(1,   /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
                                                                                                                                                                p_PhysCellId,
                                                                                                                                                                omit),
                                                                                                                               omit)),
                                                         omit,
                                                         cs_ReportConfigToAddModList_1Entry(1,
                                                                                            cs_ReportConfig_reportConfigEUTRA_eventA3(0, false, 0, ms640, rsrp, both, 3, ms1024, r1)), //@sic R5s100678 sic@
                                                         omit,
