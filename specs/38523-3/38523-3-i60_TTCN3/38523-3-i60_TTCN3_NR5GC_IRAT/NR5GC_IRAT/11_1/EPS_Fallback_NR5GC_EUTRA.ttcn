module EPS_Fallback_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EPS_NAS_Constants all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EPS_NAS_TypeDefs all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA38_NR5GC_InitialRegistration all;
  import from EUTRA_ASP_SrbDefs all;
  import from EUTRA_CellCfg_Templates all;
  import from EUTRA_CellInfo all;
  import from EUTRA_Component all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_ASP_Templates all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_NASSteps all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_NR_Parameters all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;
  import from EUTRA_SecurityFunctions all;
  import from EUTRA_SecuritySteps all;
  import from EUTRA_Timing all;
  import from IMS_PTC_CoordMsg all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from UpperTesterFunctions all;

  const AbsoluteCellPower_Type tsc_CellRS_EPRE_73 := -73; /* @status    APPROVED (NR5GC_IRAT) */

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_1_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  { //MO MMTEL voice call setup from NR RRC_IDLE / EPS Fallback with redirection / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, HANDLE_UM_DATA, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_1_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    // Test finishes in NR
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_11_1_1_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_1_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  {
    var EUTRA_NR_CoOrd_SysInfo_Type v_SysInfoNR;
    var NasCount_Type v_NasCount;
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo;
    var integer v_EPSBearerId;
    
    // Send EUTRA frequency to NR and wait for NR info
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
    v_SysInfoNR := f_EUTRA_NR_WaitForCoOrd_SysInfo(NR);
   
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step "4A" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);

    // @siclog "Step 15 - 20" siclog@
    v_NasCount := f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_Cell1, tsc_RRC_TI_Def, -, MAPPED_CXT, noRrcConnectionRelease, -, -, -, -, -, true); // @sic R5s210149 sic@

    // @siclog "Step 21 - 23" siclog@
    // Steps 5-7 of 4.5A.6.3-1
    f_EUTRA38_MultiPDN_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         tsc_RRC_TI_Def,
                                         v_NasCount);
    
    // @siclog "Step 24" siclog@
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  tsc_RRC_TI_Def);

    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));

    // @siclog "Step 26 - 28" siclog@
    v_EPSBearerId := f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s220448 sic@
    
    // @siclog "Step 29 - 33" siclog@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, int2hex(v_EPSBearerId, 1)); // @sic R5s220448 sic@

    v_RedirectedCarrierInfo := cs_RedirectionInfo_NR(v_SysInfoNR.NR[0].Arfcn, f_NR_ConvertIntToSCS_CarrierInfoNR(v_SysInfoNR.NR[0].SCS)); //SubcarrierSpacingSSB
    // @siclog "Step 34" siclog@
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell1, cs_RRCConnectionRelease(tsc_RRC_TI_Def, other, v_RedirectedCarrierInfo));
    
    // @siclog "Step 35" siclog@
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell1, true); // @sic R5s210149 sic@
    
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR, "Postamble");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.1a.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_1a_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { // MO MMTEL enhanced voice service call setup from NR RRC_IDLE / EPS Fallback with redirection / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    // The test body is the same as 11.1.1.  If this changes, then a new function can be used.
    fl_TC_11_1_1_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    // Test finishes in NR
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_2_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  { //MO MMTEL voice call setup from NR RRC_IDLE / EPS Fallback with redirection / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1, SUPPORTED); // @sic R5-221406 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_2_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble (eutra_Cell1, E2_CONNECTED); // @sic R5-204399 sic@
  }

  /*
   * @desc      test body of TC_11_1_2_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_2_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  {
    var integer v_EPSBearerId;
    var SRB_COMMON_IND v_ReceivedAsp;
    var NAS_MSG_Indication_Type v_NasInd;
    var PDN_CONNECTIVITY_REQUEST v_PDNConnReq;
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList;
    var EPS_BearerIdentity v_EpsBearerId;
    var boolean v_ConfiguredSpeechBearer := false;
    var boolean v_EndLoop := false;
    var boolean v_RxdMsg;
    var integer v_L_NumOfReqsReceivedInParallel := 0;
    var integer v_K_NumOfPDNsProcessed := 0;
    var default v_MyDefaultVar := null;
    timer t_Wait1s := 1.0;

    // Send EUTRA frequency to NR and wait for NR info
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step 5AA" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE);

    v_PduSessionInfoList := f_TAUReject_AttachWithoutN26 (eutra_Cell1); // @sic R5s230015 sic@
    
    // First clear store of previously received messages
    f_EUTRA38_MsgInDefault_ResetStoreOfPDNConnectivityReq(); // @sic R5-231581 sic@
    // Then activate store for any new msgs received  @sic R5-231581 sic@
    v_MyDefaultVar := activate(a_EUTRA38_AdditionalPDNConnectivityReq(eutra_Cell1, cr_PDNConnReqAdditionalPDN(f_GetPdnType(), cr_AccessPointName_Any ifpresent, '010'B))); // @sic R5-260174 sic@
    
    // @siclog "Parallel Behaviour" siclog@
    // @siclog "Step 24A - 24C" siclog@
    // can't use common function as has to be in parallel with speech bearer activation
    while ((v_K_NumOfPDNsProcessed < lengthof(v_PduSessionInfoList)) and not v_EndLoop) {  // @sic R5s250010 sic@
      v_RxdMsg := false;
      if (isvalue(f_Get_EPSBearerIdForAPNType(IMS_DNN)) and not v_ConfiguredSpeechBearer) { // @sic R5s250010 sic@
        // IMS bearer already configured, so can go ahead and configure the speech bearer
        v_EPSBearerId := f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s220448 sic@
        v_ConfiguredSpeechBearer := true;
        // Step 29
        t_Wait1s.start;
      } else {
        // Either step 29 or no IMS bearer yet, so wait for it to be configured
        t_Wait1s.start;
      }
      
      if (f_EUTRA38_MsgInDefault_GetNumOfPDNConnectivityReq() > v_L_NumOfReqsReceivedInParallel) {
        t_Wait1s.stop;
        v_L_NumOfReqsReceivedInParallel := v_L_NumOfReqsReceivedInParallel +1;
        v_ReceivedAsp := f_EUTRA38_MsgInDefault_GetOnePDNConnectivityReq(v_L_NumOfReqsReceivedInParallel);
        v_RxdMsg := true;

      } else { // No PDN Connectivity Req waiting to be processed
        alt {
          [] SRB.receive(car_SRB_NasPdu_IND(eutra_Cell1, tsc_SRB2, cr_NAS_Indication(tsc_SHT_IntegrityProtected_Ciphered, cr_PDNConnReqAdditionalPDN(f_GetPdnType(), cr_AccessPointName_Any, '010'B))))
             -> value v_ReceivedAsp
            {
              t_Wait1s.stop;
              v_RxdMsg := true;
            }
           [] t_Wait1s.timeout
            {
              if (v_ConfiguredSpeechBearer) {
                v_EndLoop := true;
              }
            }
        }
      }
      if (v_RxdMsg) {
        v_K_NumOfPDNsProcessed := v_K_NumOfPDNsProcessed +1;
        v_NasInd := v_ReceivedAsp.Signalling.Nas[0];
        v_PDNConnReq := v_NasInd.Pdu.Msg.pDN_CONNECTIVITY_REQUEST;
        v_EpsBearerId := f_EUTRA38_MultiPDN_EstablishAdditionalPDN_Step2(eutra_Cell1, v_PDNConnReq, -, -, v_PduSessionInfoList);
        a_EUTRA_IdleUpdated_ConnectToAdditionalPDN_Step3(eutra_Cell1);
        a_EUTRA38_MultiPDN_ConnectToAdditionalPDN_Step4(eutra_Cell1, v_EpsBearerId);
        
        // Start timer again for another PDN, or step 29
        t_Wait1s.start;
      }
    }
      
    // all expected msgs have been processed,  so deactivate the extra default
    deactivate(v_MyDefaultVar);
    
    // Test body finishes on IMS PTC
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, int2hex(v_EPSBearerId, 1)); // @sic R5s220448 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_3_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  { //MO MMTEL voice call setup from NR RRC_CONNECTED / EPS Fallback with handover / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    // Call this before turning the UE on in the preamble function
    f_UT_PreconditionsNotConfigured (UT); // @sic R5-221455, R5s221028 sic@
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_3_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED); // @sic R5-204399 sic@
  }

  /*
   * @desc      test body of TC_11_1_3_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_3_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  {
    var EUTRA_NR_CoOrd_GUTI_Type v_CoOrd_Guti;
    var EUTRA_NR_CoOrd_Security_Type v_SecurityRx;
    var SRB_COMMON_IND v_ReceivedMsg;
    var template AdditionalUpdateType v_AdditionalUpdateType := f_GetAdditionalUpdateType (NORMAL);
    var GutiParameters_Type v_GutiParams := f_EUTRA_CellInfo_GetGuti(eutra_Cell1);
    var NAS_PlmnId v_PLMN := f_Asn2Nas_PlmnId(v_GutiParams.PLMN_Identity);
    var TrackingAreaCode v_Tac := f_EUTRA_CellInfo_GetTAC(eutra_Cell1);
    var template (present) TrackingAreaId v_TAI := cr_TAI(v_PLMN, bit2oct(v_Tac));
    var template (value) MobileIdentity v_MappedGUTI;
    var integer v_EPSBearerId;
    var EUTRA_SecurityParams_Type v_Auth_Params := f_EUTRA_Security_Get();
    var octetstring v_HOCmd; // @sic R5s211351 sic@

    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    v_HOCmd := f_Encode_RRCConnectionReconfiguration_HO5GToEUTRA(eutra_Cell1, // @sic R5-204399 sic@ // @sic R5s211351 sic@
                                                                                 f_EUTRA_CellInfo_GetFrequencyIEs(eutra_Cell1),
                                                                                 f_EUTRA_CellInfo_GetDL_ChBandwidth (eutra_Cell1),
                                                                                 f_EUTRA_CellInfo_GetUL_ChBandwidth (eutra_Cell1),
                                                                                 f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),
                                                                                 f_EUTRA_CellInfo_GetRootSequenceIndex (eutra_Cell1));
    // @siclog "Step 9A" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE);

    //Receive the GUTI and security params before handover from NR.
    v_CoOrd_Guti := f_EUTRA_NR_WaitForCoOrd_GutiParams(NR);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    v_SecurityRx := f_EUTRA_NR_WaitForCoOrd_Security (NR);
    //Generate the Mapped GUTI expected in the TAU REQ later
    v_MappedGUTI := f_EUTRA38_NR_Convert5G_CoOrdToEPS_GUTI (v_CoOrd_Guti, omit);
    
    // Configure C-RNTI based contention resolution in target cell
    f_EUTRA_SS_ConfigRachProcedure(eutra_Cell1, tsc_C_RNTI_Def2, cs_RachProcedureConfig_CRNTI_Dedicated(f_EUTRA_CellInfo_GetRAR_TA(eutra_Cell1), // @sic R5s201237 sic@
                                                                                                        f_EUTRA_CellInfo_GetDL_ChBandwidth(eutra_Cell1)));
    
    f_EUTRA_CellInfo_SetC_RNTI ( eutra_Cell1, tsc_C_RNTI_Def2 ); // @sic R5s201237 sic@
    f_EUTRA_SS_SRBs_DRBs_Config(eutra_Cell1, -, -, true); // @sic R5s201237 sic@
    
    v_Auth_Params := f_EUTRA38_MappedContextFromN1_InitNAS(eutra_Cell1, v_SecurityRx, true);
    v_Auth_Params.AS_Ciphering.ActTimeList := f_EUTRA_RRC_CipherActTime_GetForHO(eutra_Cell1, tsc_DrbList_Def);
    //f_EUTRA_NB_SS_NAS_ConfigureSecurity(NASCTRL, v_Auth_Params.NAS_Integrity, v_Auth_Params.NAS_Ciphering);
    f_EUTRA_SS_RRC_EnableIntProt_CiphULandDL(eutra_Cell1,
                                             v_Auth_Params.AS_Integrity,
                                             v_Auth_Params.AS_Ciphering,
                                             cs_TimingInfo_Now);
    f_EUTRA_Security_Set(v_Auth_Params);
    
    //Configure UL grant configuration ("OnSR", periodic TA is NOT started) in target cell (cell 1)
    f_EUTRA_ULGrantConfiguration_Common(eutra_Cell1,
                                        cs_TimingInfo_Now,
                                        f_EUTRA_DciUlInfo_Get(eutra_Cell1),
                                        cs_UplinkTimeAlignment_Synch_None,
                                        cs_UL_GrantConfig_OnSR);  // @sic R5s250415 sic@

    // Send EUTRA HO command to NR
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_HOCmd, "HO Cmd")); // @sic R5s201475 sic@

    // @siclog "Step 18" siclog@
    SRB.receive( car_SRB1_RrcPdu_IND( eutra_Cell1, cr_508_RRCConnectionReconfigurationComplete( tsc_RRC_TI_Def ) ) );
    /* SS automatically checks that UE transmit an RRCConnectionReconfigurationComplete using the indicated
       security key and the indicated security algorithms */
    f_EUTRA_PreliminaryPass( __FILE__, __LINE__, "Step 18" );
    
    //Configure UL grant configuration
    f_EUTRA_ULGrantConfiguration_Common(eutra_Cell1,
                                         cs_TimingInfo_Now,
                                         f_EUTRA_DciUlInfo_Get(eutra_Cell1),
                                         cs_UplinkTimeAlignment_Synch_Auto_Def,
                                        cs_UL_GrantConfig_OnSR);  // @sic R5s250415 sic@

    // @siclog "Step 19" siclog@
    SRB.receive(car_SRB2_NasPdu_IND(eutra_Cell1,
                                    cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                      cr_TAU_Request_N1ToS1((tsc_EpsUpdate_TaUpdate, tsc_EpsUpdate_Combined_IMSIAttach, tsc_EpsUpdate_Combined_TaLaUpdate),// @sic R5s201237 sic@  @sic R5-211406 sic@
                                                                            v_SecurityRx.KSI,
                                                                            cr_DRXparameter_Any ('5C'O) ifpresent,
                                                                            v_AdditionalUpdateType,
                                                                            v_MappedGUTI,
                                                                            v_TAI,
                                                                            -, // @sic R5s201237 sic@ @sic R5-211406 sic@
                                                                            tsc_NasKsi_MappedSecurityContext, // @sic R5s201237 sic@
                                                                            cdr_NAS_KeySetIdentifier_tlv (?, ?) ifpresent,
                                                                            -, -, *))))-> value v_ReceivedMsg; // @sic R5s201237 sic@ // @sic R5s210305 sic@

    // @siclog "Step 20 - 23" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1_WithoutReq (eutra_Cell1,
                                                   v_ReceivedMsg.Signalling.Nas[0],
                                                   -, noRrcConnectionRelease,
                                                   -, true,
                                                   -, true); // @sic R5s210149 sic@

    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));

    // @siclog "Step 24 - 26" siclog@
    v_EPSBearerId := f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s220448 sic@

    // wait for Trigger for Step 27
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

    // @siclog "Step 27" siclog@
    f_Delay(1.0); // @sic R5-225245 sic@

    // @siclog "Step 28a" siclog@
    //Void @sic R5-211407 sic@
    

    //Now send the Coord to IMS to release the call
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]); // @sic R5s201237 sic@

    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, int2hex(v_EPSBearerId, 1)); // @sic R5s210305, R5s220448 sic@
    
    //Send a trigger to NR for it to release its cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.3a.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_3a_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-223432 sic@
  { //MO MMTEL voice call setup from NR RRC_CONNECTED / EPS Fallback with handover / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    //The test body is the same as 11.1.3 except the Step numbers.
    fl_TC_11_1_3_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_4_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //MO MMTEL voice call setup from NR RRC_CONNECTED / EPS Fallback with redirection / Single registration mode with N26 interface / E-UTRAN cell reselection using cell status barred / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@
    f_EUTRA_CellInfo_SetSysInfo_CellBarred(eutra_Cell3, barred); // @sic R5s210722 sic@ // @sic R5-214593 sic@

    //Create and configure cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell3); // @sic R5-206360 sic@
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1); // @sic R5-206360 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_4_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED); // @sic R5-204399 sic@
  }

  /*
   * @desc      test body of TC_11_1_4_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_4_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var NasCount_Type v_NasCount; // @sic R5s210304 sic@
    
    // Send EUTRA frequency to NR and wait for NR info
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1, eutra_Cell3})); // @sic R5s210304 sic@
    
    // @siclog "Step 9A" siclog@
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_SuitableCellRS_EPRE, tsc_SuitableCellRS_EPRE_FR2); // @sic R5-206360 sic@ // @sic R5-216190 R5-241629 sic@
    f_EUTRA38_SetCellPower(eutra_Cell3, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2); // @sic R5-206360 sic@ // @sic R5-216190 R5-241629 sic@
    
    // @siclog "Step 18" siclog@
    //Generic test procedure in TS 38.508-1 [4] Table 4.9.7.2.2-1 is performed without 'connected without release' on E-UTRAN cell upon mobility from NR.
    v_NasCount := f_EUTRA38_TrackingAreaUpdateFromN1(eutra_Cell1, tsc_RRC_TI_Def, -, -, noRrcConnectionRelease, -, -, -, -, -, true); // @sic R5s210149 sic@ // @sic R5s210304 sic@


    // @siclog "Step 18A - 18D" siclog@
    f_EUTRA38_MultiPDN_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1, // @sic R5s210304 sic@
                                         tsc_RRC_TI_Def,
                                         v_NasCount,-,-, -,true);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1, // @sic R5s210304 sic@
                                                  tsc_RRC_TI_Def);


    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));

    // @siclog "Step 19 - 21" siclog@
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s210304 sic@

    // wait for Trigger for Step 22
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

    // @siclog "Step 22" siclog@
    f_Delay(1.0);

    // @siclog "Step 23a1" siclog@
    //Void @sic R5-211407 sic@

    //Now send the Coord to IMS to release the call
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    
    //Send a trigger to NR for it to release its cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.5.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_5_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { ////MO MMTEL voice call setup from NR RRC_CONNECTED / EPS Fallback with redirection / Single registration mode without N26 interface / E-UTRAN cell reselection using cell status reservation / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create Eutra Cell 2 and set it as reserved for operator use and modify Sysinfo updated
    f_EUTRA_CellInfo_SetSysInfo_CellReservedForOpUse (eutra_Cell3, reserved); // @sic R5-216189 sic@
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell3, -73); // @sic R5s211660 sic@

    //Create and configure cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell3); // @sic R5-216189 sic@
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1, SUPPORTED); // @sic R5-221453 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_5_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      test body of TC_11_1_5_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_5_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var EPS_BearerIdentity v_EpsBearerId; // @sic R5s211660 sic@
    var SRB_COMMON_IND v_ReceivedAsp; // @sic R5s211660 sic@
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList; // @sic R5s240649 sic@
    timer t_Wait := 5.0; // @sic R5s211660 sic@

    // Send EUTRA frequency to NR and wait for NR info
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell3})); // @sic R5s211660 sic@
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step 9A" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2); // @sic R5s211660 sic@
    f_EUTRA38_SetCellPower(eutra_Cell3, tsc_CellRS_EPRE_73, tsc_ServingCellRS_EPRE_FR2); // @sic R5-221453 sic@
    // @siclog "Step 14 - 27" siclog@
    v_PduSessionInfoList := f_TAUReject_AttachWithoutN26 (eutra_Cell1); // @sic R5s240649 sic@

    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]); // @sic R5s211660 sic@
    t_Wait.start; // @sic R5s211660 sic@
    alt { // @sic R5s211660 sic@
      [] SRB.receive(car_SRB2_NasPdu_IND(eutra_Cell1,
                                           cr_NAS_Indication(tsc_SHT_IntegrityProtected_Ciphered, cr_PDN_CONNECTIVITY_REQUEST_N1ToS1(tsc_PdnRequest_Handover, ?, -, -, *)))) -> value v_ReceivedAsp // @sic R5-226605 sic@
        {
          t_Wait.stop;   // @sic R5s220177 sic@
          v_EpsBearerId := f_EUTRA38_MultiPDN_EstablishAdditionalPDN_Step2 (eutra_Cell1, v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_CONNECTIVITY_REQUEST, -, -, v_PduSessionInfoList); // @sic R5s240649 sic@
          a_EUTRA_IdleUpdated_ConnectToAdditionalPDN_Step3(eutra_Cell1);
          a_EUTRA38_MultiPDN_ConnectToAdditionalPDN_Step4(eutra_Cell1, v_EpsBearerId);
        }
      [] t_Wait.timeout {}
    }

    // @siclog "Step 30 -32" siclog@
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    
    // Test body finishes on IMS PTC
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.6.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_6_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //MT MMTEL voice call setup from NR RRC_IDLE / EPS Fallback with redirection / Single registration mode without N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1, SUPPORTED); // @sic R5-221454 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_6_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble (eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      test body of TC_11_1_6_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_6_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var EPS_BearerIdentity v_EpsBearerId; // @sic R5s211708 sic@
    var SRB_COMMON_IND v_ReceivedAsp; // @sic R5s211708 sic@
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList; // @sic R5s240649 sic@
    timer t_Wait := 5.0; // @sic R5s211708 sic@

    
    // Send EUTRA frequency to NR and wait for NR info
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step 5A" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE);

    v_PduSessionInfoList := f_TAUReject_AttachWithoutN26 (eutra_Cell1); // @sic R5s240649 sic@

    t_Wait.start;
    alt { // @sic R5s211708 sic@ // @sic R5-221454 sic@
      [] SRB.receive(car_SRB2_NasPdu_IND(eutra_Cell1,
                                           cr_NAS_Indication(tsc_SHT_IntegrityProtected_Ciphered, cr_PDN_CONNECTIVITY_REQUEST_N1ToS1(tsc_PdnRequest_Handover, ?, -, -, *)))) -> value v_ReceivedAsp // @sic R5s230082 sic@ // @sic R5-231415 sic@
        {
          t_Wait.stop;
          v_EpsBearerId := f_EUTRA38_MultiPDN_EstablishAdditionalPDN_Step2(eutra_Cell1, v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_CONNECTIVITY_REQUEST, -, -, v_PduSessionInfoList); // @sic R5s240649 sic@
          a_EUTRA_IdleUpdated_ConnectToAdditionalPDN_Step3(eutra_Cell1);
          a_EUTRA38_MultiPDN_ConnectToAdditionalPDN_Step4(eutra_Cell1, v_EpsBearerId);
        }
      [] t_Wait.timeout
        {
        }
     }

    // Wait here for optional re-register
    f_EUTRA_DelayForUserPlaneSignalling (waitForIMS);
    // then tell IMS to continue with MT call
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);

    // @siclog "Step 21 -22 " siclog@
    //Void // @sic R5-236541 sic@

    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

    // @siclog "Step 26 - 28" siclog@
    f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    // Test body finishes on IMS PTC
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.7.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_7_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  { //Emergency call setup from NR RRC_IDLE / Emergency services Fallback to EPS with redirection / Single registration mode with N26 interface / Success
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_7_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble (eutra_Cell1, E1_IDLE); // optional IMS Deregistration is handled in the default, before the UE detaches // @sic R5-204399, R5-241691 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_11_1_7_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_7_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC // @sic R5-204399 sic@
  {
    var NasCount_Type v_NasCount;
    var NAS_MSG_Indication_Type v_NasInd;
    var boolean v_N1disabled := false;
    var template UE_AdditionalSecurityCapability v_UEAddSecurityCap;
    var template(present) UE_NetworkCap v_UENWCap := cdr_NR5GC_UENetworkCap('58'O);    // @sic R5-244663 sic@
    timer t_T1 := f_EUTRA_SetTimerToleranceMin (eutra_Cell1, nasTimer, 60.0);
    
    // Send EUTRA frequency to NR
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
   
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step 5C" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE); //@sic R5-210133 sic@

    // @siclog "Steps 7-10b2" siclog@
    // The UE transmits an RRCConnectionRequest message with 'establishmentCause' set to 'emergency'.
     // @sic R5-204467, R5s211357 sic@

    v_UENWCap.cIoT_proSeCap := ?;   // @sic R5s240588 sic@
    v_UENWCap.cIoT_V2X := *; // Any allowed value for all bits, if present = * @sic R5-244725 sic@

    v_NasInd := f_EUTRA38_TAUReqFromN1(eutra_Cell1,
                                       tsc_RRC_TI_Def,
                                       -,
                                       MAPPED_CXT,
                                       -,
                                       emergency,
                                       -,
                                       cr_UE_AddSecurityCap_Any ifpresent, // @sic R5-244663 sic@
                                       v_UENWCap);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 7");
                                       
    if (match (v_NasInd.Pdu.Msg.tRACKING_AREA_UPDATE_REQUEST.ueNetworkCapability, cdr_NR5GC_UENetworkCap_N1Disabled('58'O)) // @sic R5-227443 sic@
          or not (isvalue(v_NasInd.Pdu.Msg.tRACKING_AREA_UPDATE_REQUEST.ueNetworkCapability.cIoT_V2X))) {   // @sic R5-244663 sic@
      v_N1disabled := true;
    }
    if (pc_EN_DC == true or not v_N1disabled ) { // @sic R5-244663, R5s240588 sic@
      v_UEAddSecurityCap := cr_UE_AddSecurityCap_Any;
    }
    else {
      v_UEAddSecurityCap := omit;
    }
    if (not match (v_NasInd.Pdu.Msg.tRACKING_AREA_UPDATE_REQUEST.ueAddSecurityCap, v_UEAddSecurityCap)) {   // @sic R5-244663 sic@
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "TAU Req failed");
    }
    v_NasCount := v_NasInd.SecurityProtection.NasCount;
    
    // @siclog "Step 10A - 10D" siclog@
    f_EUTRA38_MultiPDN_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         tsc_RRC_TI_Def,
                                         v_NasCount);

    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  tsc_RRC_TI_Def); // @sic R5s210341 sic@ // @sic R5s210616 sic@

    // Steps 4a1 - 4b2 are not performed for mapped security context, so not included here
    // @siclog "Step 10E - 11" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1_WithoutReq(eutra_Cell1,
                                                    v_NasInd,
                                                    MAPPED_CXT,
                                                    noRrcConnectionRelease,
                                                    -, true,
                                                    -, true); // @sic R5s210149 sic@
                                                                
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));
    
    // @siclog "Steps 12 - 16" siclog@
    // Steps 9-15 of 4.5A.4.3-1
    f_EUTRA38_MultiPDN_EstablishAdditionalPDNs(eutra_Cell1, 1, -, -, -, '100'B, omit, v_N1disabled); // @sic R5s211357, R5-227443 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    // @siclog "Step 19-20" siclog@
    f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1, Emergency_PDN);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    // @siclog "Step 21" siclog@
    f_Delay(1.0);

    // @siclog "Step 21A" siclog@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Change Power Level"));  // @sic R5-241691 sic@

    // @siclog "Step 22" siclog@
    // Tell IMS PTC to release the call
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS2]);

    //IMS call has been released.
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2]);
    // The SS deactivates the EPS bearer. [This is the rest of C.32]
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1,
                                         int2hex(valueof(f_Get_EPSBearerIdForAPNType(Emergency_PDN)), 1));
       
    // @siclog "Step 23" siclog@
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);// @sic R5-241691 sic@
    
    // @siclog "Step 24" siclog@
    t_T1.start; // @sic R5-241691 sic@
    
    alt {// @sic R5-241691 sic@
         // @siclog "Step 25a1" siclog@
      [] SRB.check(receive(car_SRB0_RrcPdu_IND(eutra_Cell1, cr_RRCConnectionRequest(cr_EstablishmentCause_Any))))
        {
          // @siclog "Step 25a2" siclog@
          t_T1.stop;
          // @siclog "Step 25a3-7" siclog@
          // @sic R5-243591 sic@
          v_NasInd := f_EUTRA_RRC_ConnEst_DefWithNas(eutra_Cell1,
                                               tsc_RRC_TI_Def,
                                               ?,
                                               cr_NAS_Indication(tsc_SHT_IntegrityProtected,
                                                                 cr_TAU_Request_N1ToS1(('000'B, '001'B, '010'B),
                                                                                        ?,
                                                                                        cr_DRXparameter_Any ('5C'O) ifpresent,
                                                                                        f_GetAdditionalUpdateType(NORMAL),
                                                                                        -, -, -,
                                                                                        ?,
                                                                                        -, -,
                                                                                        cr_UeRadioCap ifpresent,
                                                                                        -,
                                                                                        cr_UENetworkCap_Any('58'O),          // @sic R5s240588 sic@
                                                                                        cr_UE_AddSecurityCap_Any ifpresent,
                                                                                        cr_UEStatus_Any ifpresent)));  // @sic R5s240439 sic@
      
          f_EUTRA_TrackingAreaUpdate_Accept_Complete(eutra_Cell1,
                                                     f_EUTRA_CellInfo_GetGuti(eutra_Cell1),
                                                     f_GetEPSTAUType(NORMAL),
                                                     v_NasInd.Pdu.Msg.tRACKING_AREA_UPDATE_REQUEST.epsBearerContextStatus,
                                                     v_NasInd.Pdu.Msg.tRACKING_AREA_UPDATE_REQUEST.addUpdateType,
                                                     NORMAL);
          f_EUTRA_RRC_ConnectionRelease(eutra_Cell1);  // @sic R5s240439 sic@
        }
         // @siclog "Step 25b1" siclog@
      [] t_T1.timeout {}
    }

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.8.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_8_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { ///MO MMTEL voice call setup from NR RRC_CONNECTED / EPS Fallback with handover / Single registration mode with N26 interface / voiceFallbackIndication
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    //Set voiceServiceCauseIndication  in SIB-2 for eutra cell 2
    f_EUTRA_CellInfo_SetSIB2_voiceServiceCauseIndication_r12 (eutra_Cell2, true); // @sic R5s211309 sic@ // @sic R5-216806 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell2);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_8_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell2, E2_CONNECTED); // @sic R5s220071 sic@
  }

  /*
   * @desc      test body of TC_11_1_8_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_8_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var NasCount_Type v_NasCount;
    var octetstring v_HOCmd; // @sic R5s211309 sic@
    var integer v_EPSBearerId;

    // @siclog "Step 1" siclog@
    //f_EUTRA38_SetCellPower(eutra_Cell2, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE);

    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    v_HOCmd := f_Encode_RRCConnectionReconfiguration_HO5GToEUTRA(eutra_Cell1, // @sic R5s211309 sic@
                                                                 f_EUTRA_CellInfo_GetFrequencyIEs(eutra_Cell1),
                                                                 f_EUTRA_CellInfo_GetDL_ChBandwidth (eutra_Cell1),
                                                                 f_EUTRA_CellInfo_GetUL_ChBandwidth (eutra_Cell1),
                                                                 f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),
                                                                 f_EUTRA_CellInfo_GetRootSequenceIndex (eutra_Cell1));
    // @siclog "Step 10" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell2, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE);

    // Send EUTRA HO command to NR
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_HOCmd, "HO Cmd"));
    // @siclog "Step 18 -23" siclog@
    v_NasCount := f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_Cell2, tsc_RRC_TI_Def, -, MAPPED_CXT, noRrcConnectionRelease, mo_VoiceCall_v1280, -, -, -, -, true);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 18");

    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));

    // @siclog "Step 24 - 27" siclog@
    // Steps 5-7 of 4.5A.6.3-1
    f_EUTRA38_MultiPDN_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell2,
                                         tsc_RRC_TI_Def,
                                         v_NasCount);

    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell2, // @sic R5s211309 sic@
                                                  tsc_RRC_TI_Def);

    // @siclog "Step 28 - 30" siclog@
    v_EPSBearerId := f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell2); // @sic R5s220448 sic@

    // wait for Trigger for Step 31
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

    // @siclog "Step 31" siclog@
    f_Delay(1.0);
    
    //Now send the Coord to IMS to release the call
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);

    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell2, int2hex(v_EPSBearerId, 1)); // @sic R5s220448 sic@
    
    //Send a trigger to NR for it to release its cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.1.9.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_1_9_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //MO MMTEL voice call setup from NR RRC_IDLE / EPS Fallback with redirection / Single registration mode with N26 interface / voiceFallbackIndication
    
    f_EUTRA38_IRAT_Init(c31, HANDLE_UM_DATA, USE_BIG_GRANTS); // @sic R5s210414, R5s220751 sic@

    //Create and configure cell
    f_EUTRA_CellInfo_SetSIB2_voiceServiceCauseIndication_r12 (eutra_Cell1, true); // @sic R5s211536 sic@ // @sic R5-216806 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_11_1_9_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      test body of TC_11_1_9_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_11_1_9_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var NasCount_Type v_NasCount;
    var integer v_EPSBearerId;

    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1})); // @sic R5s211536 sic@

    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Change Power Level");  // @sic R5-216190 sic@
    // @siclog "Step 5" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE, tsc_ServingCellRS_EPRE_FR2);
   
    // @siclog "Step 15 - 20" siclog@
    v_NasCount := f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_Cell1, tsc_RRC_TI_Def, -, MAPPED_CXT, noRrcConnectionRelease, mo_VoiceCall_v1280, -, -, -, -, true); // @sic R5s210149 sic@

    // @siclog "Step 21 - 23" siclog@
    // Steps 5-7 of 4.5A.6.3-1
    f_EUTRA38_MultiPDN_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         tsc_RRC_TI_Def,
                                         v_NasCount);
    
    // @siclog "Step 24" siclog@
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  tsc_RRC_TI_Def);

    // Tell IMS PTC the RAT has changed
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_QueryResponse(f_EUTRA_IMS_IpcanInfo()));

    // @siclog "Step 26 - 28" siclog@
    v_EPSBearerId := f_EUTRA38_MultiPDN_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s220448 sic@
    
    // @siclog "Step 29 - 33" siclog@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, int2hex(v_EPSBearerId, 1)); // @sic R5s220448 sic@
    
    //Postamble is in Eutra
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

}
