                                                                          p_CellList[v_Index_Cell8].cellInfo_Specific_FDD.priScrmCode,
                                                                          4,
                                                                          p_CellList[v_Index_Cell4].frequencyInfo,
                                                                          p_CellList[v_Index_Cell4].cellInfo_Specific_FDD.priScrmCode,
                                                                          5,
                                                                          p_CellList[v_Index_Cell5].frequencyInfo,
                                                                          p_CellList[v_Index_Cell5].cellInfo_Specific_FDD.priScrmCode,
                                                                          6,
                                                                          p_CellList[v_Index_Cell6].frequencyInfo,
                                                                          p_CellList[v_Index_Cell6].cellInfo_Specific_FDD.priScrmCode);
    
    v_CellList[v_Index_Cell2].sysInfo.SIB11 := cs_SIB11_5Intra_3Inter_FDD(2,
                                                                          p_CellList[v_Index_Cell2].cellInfo_Specific_FDD.priScrmCode,
