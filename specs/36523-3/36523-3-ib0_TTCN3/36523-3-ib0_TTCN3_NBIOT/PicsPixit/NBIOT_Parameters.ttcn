module NBIOT_Parameters {

  import from NBIOT_CommonDefs all;

  modulepar boolean                     px_DoAttachWithoutPDN       := false;           // @desc  UE is configured to do Attach without PDN, if the value is FALSE it is assumed that the UE is configured to do Attach with PDN

  modulepar NB_OperationMode_Type       px_NB_OperationMode         := standalone;      // @desc  NB-IoT Operation Mode

  modulepar integer                     px_NS_Value                 := 1;               // @desc  Network Signalling value as defined in TS 36.101 [34] clause 6.2.4F and used in TS 36.508 [3] clause 8.1.3.1 to select the NB-IoT frequencies

  modulepar boolean                     pc_Additional_APN_RateControl := false;         // @desc  The UE supports additional APN rate control for exception data reporting

  modulepar boolean                     pc_HCCPCIoT                 := false;           // @desc  The UE supports Header compression for control plane CIoT EPS optimisation

  modulepar boolean                     pc_IP_PDN                   := false;           // @desc  UE capable of requesting PDN of type "IP"

  modulepar boolean                     pc_NB_Control_Plane_data_backoff := false;      // @desc  Support of control plane data back-off timer T3448

  modulepar boolean                     pc_NB_FDD                   := false;           // @desc  NB-IoT FDD

  modulepar boolean                     pc_NB_InterferenceRandomisation := false;       // @desc  Support of interference randomisation in connected mode in NB-IoT

  modulepar boolean                     pc_NB_MultiCarrier          := false;           // @desc  Support of multi-carrier operation in NB-IoT

  modulepar boolean                     pc_NB_MultiCarrier_NPRACH   := false;           // @desc  Support of PRACH on non-anchor carrier in NB-IoT

  modulepar boolean                     pc_NB_MultiCarrier_Paging   := false;           // @desc  Support of paging on non-anchor carriers for FDD in NB-IoT

  modulepar boolean                     pc_NB_MultiCarrier_Paging_TDD := false;         // @desc  Support of paging on non-anchor carriers for TDD in NB-IoT

  modulepar boolean                     pc_NB_MultiDRB              := false;           // @desc  Support of multiple DRBs in NB-IoT

  modulepar boolean                     pc_NB_MultiTone             := false;           // @desc  Support of UL multi-tone transmissions on NPUSCH in NB-IoT

  modulepar boolean                     pc_NB_RLC_UM                := false;           // @desc  Support of RLC UM mode in NB-IoT

  modulepar boolean                     pc_NB_Rai_Support           := false;           // @desc  Support of 2 Release Assistance Indication (RAI) in NB-IoT

  modulepar boolean                     pc_NB_S1_only               := false;           // @desc  UE supports only NB-S1 mode (i.e. NB-IoT)

  modulepar boolean                     pc_NB_TDD                   := false;           // @desc  NB-IoT TDD

  modulepar boolean                     pc_NB_TwoHARQ_Processes     := false;           // @desc  Support of 2 HARQ processes in DL and UL in NB-IoT

  modulepar boolean                     pc_NB_earlyContentionResolution_r14 := false;   // @desc  Support of Early contention resolution in NB-IoT

  modulepar boolean                     pc_NB_mixedOperationMode    := false;           // @desc  Support of Mixed Operation Mode in NB-IoT

  modulepar boolean                     pc_NB_nprach_Format2        := false;           // @desc  Support of NPRACH resources using preamble format 2 for FDD in NB-IoT

  modulepar boolean                     pc_NB_ntn_Connectivity_EPC  := false;           // @desc  Support of NTN access in NB-IoT

  modulepar boolean                     pc_NB_ntn_DL_HARQ_disable_RRC_singleTB := false;

  modulepar boolean                     pc_NB_ntn_DiscontinuousCoverage := false;       // @desc  Support of Discontinuous coverage

  modulepar boolean                     pc_NB_ntn_GSO_ScenarioSupport := false;         // @desc  Support of NTN features in GSO scenario in NB-IoT

  modulepar boolean                     pc_NB_ntn_NGSO_ScenarioSupport := false;        // @desc  Support of NTN features in NGSO scenario in NB-IoT

  modulepar boolean                     pc_NB_ntn_OffsetTimingEnh   := false;           // @desc  Support of timing relationship enhancements using Differential Koffset in NB-IoT

  modulepar boolean                     pc_NB_ntn_PUR_TimerEnhancement := false;        // @desc  Support of modified timer value for PUR operation required for NTN operation in NB-IoT

  modulepar boolean                     pc_NB_ntn_TA_Report         := false;           // @desc  Support of Timing advance reporting in NTN cell in NB-IoT

  modulepar boolean                     pc_NB_ntn_UL_HARQ_MODE_B_singleTB := false;     // @desc  Support of uplink HARQ mode B for a single TB per HARQ process

  modulepar boolean                     pc_NB_ntn_Uplink_Tx_Extension := false;         // @desc  Support of ntn uplink Tx extension

  modulepar boolean                     pc_NB_ntn_autonomous_GNSS_position_fix := false;

  modulepar boolean                     pc_NB_ntn_only_Connectivity_EPC := false;       // @desc  Support of NTN only access in NB-IoT

  modulepar boolean                     pc_NB_ntn_triggered_GNSS_position_fix := false; // @desc  Support of network triggered GNSS position fix

  modulepar boolean                     pc_RRC_re_establishment_CP_CIoT := false;       // @desc  Support of RRC connection re-establishment

  modulepar boolean                     pc_S1_U_DataTransfer        := false;           // @desc  Support of S1-U data transfer

  modulepar boolean                     pc_SCPTM_IDLE               := false;           // @desc  The UE supports SC-PTM in idle mode

  modulepar boolean                     pc_SR_WithHARQ_ACK          := false;           // @desc  Support of physical layer SR with HARQ ACK

  modulepar boolean                     pc_SR_WithoutHARQ_ACK       := false;           // @desc  Support of physical layer SR without HARQ ACK

  modulepar boolean                     pc_cellReselectionMeasurements_locationBased_earthMovingCell := false;

  modulepar boolean                     pc_cellReselectionMeasurements_locationBased_fixedCell := false;

  modulepar boolean                     pc_ue_Category_NB2          := false;           // @desc  Category NB2

}
