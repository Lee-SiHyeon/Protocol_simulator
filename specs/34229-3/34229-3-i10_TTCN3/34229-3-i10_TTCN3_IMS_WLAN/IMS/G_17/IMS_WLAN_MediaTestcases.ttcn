module IMS_WLAN_MediaTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_17 all;
  import from IMS_Component all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.17.1
   * @status    APPROVED (IMS)
   */
  function f_TC_G_17_1_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_MOSpeechAddVideoRemoveVideo();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.17.2
   * @status    APPROVED (IMS)
   */
  function f_TC_G_17_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    
    f_IMS_MTSpeechAddVideoRemoveVideo();
   
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
