module MTC_Component_MCX_IPCAN {

  import from CommonDefs all;
  import from IPCAN_MCX_IpcanModel all;
  import from IpcanModel_IPCAN_Component all;
  import from MCX_HTTP_Component all;
  import from MCX_IMS_Component all;
  import from MTC_Base all;
  import from MTC_Component_MCX_Common all;

  type component SYSTEM_MCX extends IpcanModel_SYSTEM, SYSTEM_MCX_BASE {};      /* @status    APPROVED (MCX) */

  /*
   * @desc      Connect ports of PTCs and MTC and map system ports
   * @param     p_System
   * @param     p_MCX
   * @param     p_HTTP
   * @status    APPROVED (MCX)
   */
  function f_MTC_MCX_CreateMapAndConnectPTCs_IPCAN(SYSTEM_MCX p_System,
                                                   MCX_IMS_PTC p_MCX,
                                                   MCX_HTTP_PTC p_HTTP) runs on MTC_MCX
  {
    var IpcanModel_IPCAN_PTC v_IPCAN := IpcanModel_IPCAN_PTC.create("IPCAN") alive;

    f_MTC_MCX_InitAndConnect_IP_IMS_HTTP(p_System, p_MCX, p_HTTP);

    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_MCX_IPCAN], v_IPCAN:UT);
    connect(v_IPCAN:IP, vc_Components.IP:IPCAN_CTRL);
    connect(vc_Components.MCX:IPCAN, v_IPCAN:IMS[tsc_Index_IMS1]);
    
    map(v_IPCAN:IPCANSYS, p_System:S_IPCANSYS);

    v_IPCAN.start(f_MCX_IpcanModel_MainLoop());
  }

}
