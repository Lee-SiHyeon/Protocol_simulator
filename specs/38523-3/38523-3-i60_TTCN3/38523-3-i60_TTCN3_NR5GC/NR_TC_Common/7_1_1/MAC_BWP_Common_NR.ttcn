module MAC_BWP_Common_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_BWP all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_DCI_Configuration all;
  import from NR_L2_Common all;
  import from NR_PDCP_TypeDefs all;
  import from NR_Parameters all;
  import from NR_RLC_Common all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_ResourceAllocation all;
  import from NR_Timing all;
  import from TestcaseProperties all;

  const BWP_Id tsc_NR_BWP_Id_Initial := 0;       /* @status    APPROVED (ENDC, NR5GC) */

  const BWP_Id tsc_NR_BWP_Id_1 := 1;             /* @status    APPROVED (ENDC, NR5GC) */

  const BWP_Id tsc_NR_BWP_Id_2 := 2;             /* @status    APPROVED (ENDC, NR5GC) */

  const BWP_Id tsc_NR_BWP_Id_3 := 3;             /* @status    APPROVED (ENDC, NR5GC) */

  const BWP_Id tsc_NR_BWP_Id_FirstActive := 1;   /* @status    APPROVED (ENDC, NR5GC) */

  template (value) BWP_DownlinkCommon cs_BWP_DownlinkCommon_GenericParametersOnly(template (value) BWP p_BWP) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    // Table 7.1.1.8.1.3.3-2A
    genericParameters    := p_BWP,
    pdcch_ConfigCommon   := omit,
    pdsch_ConfigCommon   := omit
  };

  template (value) NR_SearchSpace_NrofCandidates_Type cs_NR_SearchSpace_NrofCandidates_AggregationLevel2Only :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    // Table 7.1.1.8.1.3.3-2E
    aggregationLevel1 := n0,
    aggregationLevel2 := n1,
    aggregationLevel4 := n0,
    aggregationLevel8 := n0,
    aggregationLevel16 := n0
  };

  template (value) PUCCH_ResourceSet cs_TC_7_1_1_8_1_PUCCH_ResourceSet :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    // Table 7.1.1.8.1.3.3-2G
    pucch_ResourceSetId       := 0,
    resourceList              := {0},
    maxPayloadSize            := 256    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
  };

  /*
   * @desc      return BWP generic parameters (Table 7.1.1.8.1.3.3-2A: BWP-Downlink-BWP-N, Table 7.1.1.8.1.3.3-2F: BWP-Uplink-BWP-N)
   * @param     p_NR_CellId
   * @param     p_BWP_Id
   * @return    template (value) BWP
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_TC_7_1_1_8_1_BWP_Generic(NR_CellId_Type p_NR_CellId,
                                       BWP_Id p_BWP_Id) runs on NR_BASE_PTC return template (value) BWP
  {
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var BWP.locationAndBandwidth v_LocationAndBandwidth;
    var integer v_Bandwidth := f_NR_CellInfo_GetChannelBandwidth(p_NR_CellId);

    //@sic R5-213459 R5-235393 R5-241507 sic@
    if ( v_Bandwidth==3 ) {                 //@sic R5-254997 sic@
        v_LocationAndBandwidth := 3850;
    } else if ( v_Bandwidth==5 ) {          // BWP#1,2,3 5MHz
      v_LocationAndBandwidth := 6600;
    } else if (v_Bandwidth==10 and v_SubcarrierSpacing==kHz30) {
      v_LocationAndBandwidth := 6325;
    } else if (v_Bandwidth==100 ) {   // BWP#1,2,3
      if (p_BWP_Id==1) { v_LocationAndBandwidth := 17875; }
      if (p_BWP_Id==2) { v_LocationAndBandwidth := 14575; }
      if (p_BWP_Id==3) { v_LocationAndBandwidth := 16225; }
    } else { // BWP#1,2,3
      if (p_BWP_Id==1) { v_LocationAndBandwidth := 7975; }
      if (p_BWP_Id==2) { v_LocationAndBandwidth := 12925; }
      if (p_BWP_Id==3) { v_LocationAndBandwidth := 13475; }
    }
    return cs_38508_BWP(v_SubcarrierSpacing, v_LocationAndBandwidth);
  }

  /*
   * @desc      Return the value of pc_bwp_SameNumerology_upto4_FR1_FDD/FR1_TDD/FR2 depending on the band under test
   * @param     p_NR_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_ReturnBWP_SameNumerologyUpto4_Capability(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return boolean
  {  //@sic R5-231578 sic@
    var DuplexBand_Type v_DuplexBand := f_NR_CellInfo_GetDuplexBand(p_NR_CellId);
    var boolean v_BWP_SameNumerologyUpto4 := false;

    select (v_DuplexBand) {
        case(fdd) {
           v_BWP_SameNumerologyUpto4 := pc_bwp_SameNumerology_upto4_FR1_FDD;
        }
        case(tdd_FR1){
           v_BWP_SameNumerologyUpto4 := pc_bwp_SameNumerology_upto4_FR1_TDD;
        }
        case(tdd_FR2){
           v_BWP_SameNumerologyUpto4 := pc_bwp_SameNumerology_upto4_FR2;
        }
        case else {FatalError (__FILE__, __LINE__, "Band and duplex mode not defined");}
    }
    return v_BWP_SameNumerologyUpto4;
   }

  /*
   * @desc      Initialise PDSCH_TimeDomainResourceAllocationList as per Table 7.1.1.8.1.3.3-0A and Table 7.1.1.8.1.3.3-2CA
   * @param     p_NR_CellId
   * @return    template (value) PDSCH_TimeDomainResourceAllocationList
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_InitialisePDSCH_TimeDomainResourceAllocationList(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) PDSCH_TimeDomainResourceAllocationList
  { //@sic R5s230220 R5-235286 R5s230634 sic@
    var template (value) PDSCH_TimeDomainResourceAllocationList v_PDSCH_TimeDomainResourceAllocationList;
    var SubcarrierSpacing v_SubcarrierSpacing;

    v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);
    select (v_SubcarrierSpacing) {
        case(kHz15) {
            if (pc_bwp_SwitchingDelay_Type1) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(1, typeA, 53)};
            } else if (pc_bwp_SwitchingDelay_Type2) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(6, typeA, 53)};
            }
        }
        case(kHz30) {
            if (pc_bwp_SwitchingDelay_Type1) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(2, typeA, 53)};
            } else if (pc_bwp_SwitchingDelay_Type2) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(6, typeA, 53)};
            }
        }
        case(kHz60) {
            if (pc_bwp_SwitchingDelay_Type1) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(3, typeA, 53)};
            } else if (pc_bwp_SwitchingDelay_Type2) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(9, typeA, 53)};
            }
        }
        case(kHz120) {
            if (pc_bwp_SwitchingDelay_Type1) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(6, typeA, 53)};
            } else if (pc_bwp_SwitchingDelay_Type2) {
                v_PDSCH_TimeDomainResourceAllocationList := {cs_NR_PDSCH_TimeDomainResourceAllocation(omit, typeA, 53),
                                                             cs_NR_PDSCH_TimeDomainResourceAllocation(18, typeA, 53)};
            }
        }
        case else { FatalError (__FILE__, __LINE__, "Invalid Subcarrier Spacing");
        }
    }
    return v_PDSCH_TimeDomainResourceAllocationList;
  }

  /*
   * @desc      return list of DL BWPs (Table 7.1.1.8.1.3.3-2: ServingCellConfig-Dedicated)
   * @param     p_NR_CellId
   * @return    template (value) ServingCellConfig.downlinkBWP_ToAddModList
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_TC_7_1_1_8_1_DedicatedBwpListDL(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) ServingCellConfig.downlinkBWP_ToAddModList
  {
    var SSB_Index v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);
    var B45_Type v_Coreset_FrequencyDomain  := '100000000000000000000000000000000000000000000'B;   // Table 7.1.1.8.1.3.3-2D: ControlResourceSet-BWP-N
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var template (omit) PDCCH_Config.controlResourceSetToAddModList v_ControlResourceSetToAddModList;
    var template (value) SearchSpace v_SearchSpace1;
    var template (value) SearchSpace v_SearchSpace2;
    var template (value) DMRS_DownlinkConfig v_DMRS_DownlinkConfig;
    var template (value) PDCCH_Config v_PDCCH_Config;
    var template (value) PDSCH_Config v_PDSCH_Config;
    var template (value) PDSCH_TimeDomainResourceAllocationList v_PDSCH_TimeDomainResourceAllocationList := fl_NR_InitialisePDSCH_TimeDomainResourceAllocationList(p_NR_CellId); //@sic R5s230220 change 2 R5-231578 sic@
    var template (value) BWP_DownlinkDedicated v_BWP_DownlinkDedicated;
    var template (value) ServingCellConfig.downlinkBWP_ToAddModList v_DedicatedBwpListDL;
    var ControlResourceSetId v_ControlResourceSetId;
    var SearchSpaceId v_SearchSpaceId;
    var SearchSpaceId v_SearchSpaceId_CSS;
    var BWP_Id v_BwpId;
    var integer i;
    var integer v_MaxBWP := 3;   //@sic R5-213459 sic@
    var boolean v_BWP_SameNumerology_upto4 := fl_NR_ReturnBWP_SameNumerologyUpto4_Capability(p_NR_CellId);  //@sic R5-231578 sic@

    if (not v_BWP_SameNumerology_upto4) { v_MaxBWP := 1; }  //@sic R5-227417 R5s230220 change 2 sic@
    if (f_NR_CellInfo_GetIsFR1(p_NR_CellId)) {
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR1;
    } else {
      v_DMRS_DownlinkConfig := cs_38508_DMRS_DownlinkConfig_FR2;
    }
    //Table 7.1.1.8.1.3.3-2CA: PDSCH-TimeDomainResourceAllocationList (Table 7.1.1.8.1.3.3-2C)
    v_PDSCH_Config := cs_38508_PDSCH_Config(v_DMRS_DownlinkConfig, -, v_SSB_Index);                   // Table 7.1.1.8.1.3.3-2C: PDSCH-Config
    v_PDSCH_Config.pdsch_TimeDomainAllocationList.setup := v_PDSCH_TimeDomainResourceAllocationList;  // Table 7.1.1.8.1.3.3-2C: PDSCH-Config, 38.508-1 Table 4.6.3-103: PDSCH-TimeDomainResourceAllocationList

    for (i := 0; i < v_MaxBWP; i := i + 1) {
      // Table 7.1.1.8.1.3.3-2A: BWP-Downlink-BWP-N
      v_BwpId := i + 1;
      v_ControlResourceSetId := 9 + i;
      v_SearchSpaceId := 37 + i;
      v_SearchSpaceId_CSS := 30 + i;

      v_BWP_DownlinkCommon := cs_BWP_DownlinkCommon_GenericParametersOnly(fl_TC_7_1_1_8_1_BWP_Generic(p_NR_CellId, v_BwpId));      // Table 7.1.1.8.1.3.3-2A: BWP-Downlink-BWP-N

      v_ControlResourceSetToAddModList := { cs_38508_ControlResourceSet(v_ControlResourceSetId, -, v_Coreset_FrequencyDomain) };   // Table 7.1.1.8.1.3.3-2D: ControlResourceSet-BWP-N
      //@sic R5-213459 R5-235393 sic@
      v_SearchSpace1 := cs_38508_SearchSpace(v_SearchSpaceId, v_ControlResourceSetId, cs_NR_SearchSpace_SearchSpaceType_USS(formats0_1_And_1_1), cs_NR_SearchSpace_NrofCandidates_AggregationLevel2Only);  // Table 7.1.1.8.1.3.3-2E: SearchSpace-BWP-N
      v_PDCCH_Config := cs_38508_PDCCH_Config(v_SearchSpace1, -, v_ControlResourceSetToAddModList);     // Table 7.1.1.8.1.3.3-2B: PDCCH-Config-BWP-N
      v_SearchSpace2 := cs_38508_SearchSpace(v_SearchSpaceId_CSS, v_ControlResourceSetId, cs_NR_SearchSpace_SearchSpaceType_CSS, cs_NR_SearchSpace_NrofCandidates_AggregationLevel2Only);
      v_PDCCH_Config.searchSpacesToAddModList[1]:= v_SearchSpace2;
      //@sic R5-213459 R5-235393 sic@
      v_BWP_DownlinkDedicated := cs_38508_BWP_DownlinkDedicated(v_PDCCH_Config, v_PDSCH_Config);
      v_DedicatedBwpListDL[i] := cs_38508_BWP_Downlink(v_BwpId, v_BWP_DownlinkCommon, v_BWP_DownlinkDedicated);
    }
    return v_DedicatedBwpListDL;
  }

  /*
   * @desc      return list of UL BWPs (Table 7.1.1.8.1.3.3-2: ServingCellConfig-Dedicated)
   * @param     p_NR_CellId
   * @return    template (value) UplinkConfig.uplinkBWP_ToAddModList
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_TC_7_1_1_8_1_DedicatedBwpListUL(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) UplinkConfig.uplinkBWP_ToAddModList
  { //@sic R5-227417 sic@
    var NR_UplinkBWP_Type v_NR_UplinkBWP_Default := f_NR_CellInfo_GetUplinkBWP(p_NR_CellId, 0); //@sic R5s230220 change 3 sic@
    var SSB_Index v_SSB_Index := f_NR_CellInfo_GetSSB_Index(p_NR_CellId);
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var template (value) BWP_UplinkCommon v_BWP_UplinkCommon;
    var template (value) PUCCH_Config v_PUCCH_Config;
    var template (value) PUSCH_Config v_PUSCH_Config := v_NR_UplinkBWP_Default.Dedicated.R15.pusch_Config.setup;
    var template (value) BWP_UplinkDedicated.srs_Config v_SRS_Config;
    var template (value) BWP_UplinkDedicated v_BWP_UplinkDedicated;
    var template (value) UplinkConfig.uplinkBWP_ToAddModList v_DedicatedBwpListUL;
    var BWP_Id v_BwpId;
    var PRB_Id v_StartingPRB;
    var integer i;
    var integer v_MaxBWP := 3;   //@sic R5-213459 sic@
    var integer v_C_SRS := 0;
    var boolean v_BWP_SameNumerology_upto4 := fl_NR_ReturnBWP_SameNumerologyUpto4_Capability(p_NR_CellId); //@sic R5-231578 sic@
    var template (value) PUSCH_TimeDomainResourceAllocationList v_PUSCH_TimeDomainResourceAllocationList;   //@sic R5s230220 change 3 R5s230313 sic@
    var PUSCH_TimeDomainResourceAllocation.k2 v_K2forMsg3;   //@sic R5s230313 sic@
    var PUSCH_TimeDomainResourceAllocation.k2 v_K2:=4;       //@sic R5-235286 sic@
    var FrequencyInfoUL v_FrequencyInfoUL := f_NR_CellInfo_GetFrequencyInfoUL(p_NR_CellId);  //@sic R5s230634 sic@
    var PRB_Id v_PRB_SecondHopPRBId;       //@sic R5s230634 change 2.6 sic@

    if (not v_BWP_SameNumerology_upto4) { v_MaxBWP := 1; }  //@sic R5s230220 change 3 sic@
    if (f_NR_CellInfo_GetIsFR1(p_NR_CellId)) {
      v_SRS_Config := cs_NR_Srs_Config_Setup(cs_38508_SRS_Config_FR1(v_C_SRS, v_SSB_Index));
      select (v_SubcarrierSpacing) {       //@sic R5s230313 sic@
        case (kHz15) {v_K2forMsg3 := 2;}
        case (kHz30) {v_K2forMsg3 := 6;}
      }
    } else {
      v_SRS_Config := cs_NR_Srs_Config_Setup(cs_38508_SRS_Config_FR2(v_C_SRS, v_SSB_Index));
      v_K2forMsg3 := 3;        //@sic R5s230313 sic@
    }
    if ((pc_bwp_SwitchingDelay_Type2 and v_SubcarrierSpacing == kHz30) or (pc_bwp_SwitchingDelay_Type1 and v_SubcarrierSpacing == kHz120)) {
        v_K2 := 6;
    } else if ((pc_bwp_SwitchingDelay_Type2 and v_SubcarrierSpacing == kHz120)) {
        v_K2 := 18;
    }
    f_NR_CellInfo_SetK2(p_NR_CellId, v_K2);
    v_PUSCH_TimeDomainResourceAllocationList := cs_38508_PUSCH_TimeDomainResourceAllocationList(v_K2forMsg3, v_K2);     //@sic R5s230313 R5-241507 sic@
    v_PUSCH_Config.pusch_TimeDomainAllocationList.setup := v_PUSCH_TimeDomainResourceAllocationList;  //@sic R5s230220 change 3 sic@

    for (i := 0; i < v_MaxBWP; i := i + 1) {
      // Table 7.1.1.8.1.3.3-2F: BWP-Uplink-BWP-N
      v_BwpId := i + 1;
      v_StartingPRB := 0;     // @sic R5-205578 sic@
      
      //@sic R5-213459 sic@
      // Table 7.1.1.8.1.3.3-2F: BWP-Uplink-BWP-N
      v_BWP_UplinkCommon := cs_BWP_UplinkCommon_Def(fl_TC_7_1_1_8_1_BWP_Generic(p_NR_CellId, v_BwpId), omit, cs_Pusch_ConfigCommon_Setup(cs_38508_PUSCH_ConfigCommon(omit)), cs_Pucch_ConfigCommon_Setup(cs_PUCCH_Config_Def(omit,enable,omit,omit,omit, omit, omit, omit)));
      v_PRB_SecondHopPRBId := v_FrequencyInfoUL.scs_SpecificCarrierList[0].carrierBandwidth;
      v_PUCCH_Config := cs_38508_PUCCH_Config(v_SubcarrierSpacing, -, v_PRB_SecondHopPRBId, v_SSB_Index, cs_38508_DL_DataToUL_ACK);     // Table 7.1.1.8.1.3.3-2G: PUCCH-Config-BWP-N
      v_PUCCH_Config.resourceSetToAddModList := { cs_TC_7_1_1_8_1_PUCCH_ResourceSet };                                                  // Table 7.1.1.8.1.3.3-2G: PUCCH-Config-BWP-N
      v_PUCCH_Config.resourceToAddModList := { cs_38508_PUCCH_ResourceDef(0, v_StartingPRB, omit, cs_38508_ResourceFormat0(0, 2, 10), omit) };   // Table 7.1.1.8.1.3.3-2G: PUCCH-Config-BWP-N
      //@sic R5-235393 sic@
      v_PUCCH_Config.schedulingRequestResourceToAddModList :=  { cs_NR_SchedulingRequestResourceConfigDef(tsc_NR_SchedulingRequestResourceId, //Table 4.6.3-158: SchedulingRequestResourceId
                                                                                                           0,
                                                                                                          f_NR_ReturnPeriodicityAndOffset(v_SubcarrierSpacing),
                                                                                                          0)};
      v_BWP_UplinkDedicated := cs_38508_BWP_UplinkDedicated(v_PUCCH_Config, v_PUSCH_Config, v_SRS_Config);
      v_DedicatedBwpListUL[i] := cs_38508_BWP_Uplink(v_BwpId, v_BWP_UplinkCommon, v_BWP_UplinkDedicated);
    }
    //@sic R5s250095 R5-251263 sic@
    select (v_SubcarrierSpacing) {
      case(kHz15)  { v_DedicatedBwpListUL[0].bwp_Dedicated.pucch_Config.setup.schedulingRequestResourceToAddModList[0].periodicityAndOffset := {sl20 := 9}; }
      case(kHz30)  { v_DedicatedBwpListUL[0].bwp_Dedicated.pucch_Config.setup.schedulingRequestResourceToAddModList[0].periodicityAndOffset := {sl40 := 9}; }
      case(kHz120) { v_DedicatedBwpListUL[0].bwp_Dedicated.pucch_Config.setup.schedulingRequestResourceToAddModList[0].periodicityAndOffset := {sl160 := 9}; }
      case else    { FatalError(__FILE__, __LINE__, "SCS value not handled in TTCN"); }
    }

    return v_DedicatedBwpListUL;
  }

  /*
   * @desc      build up CellGroupConfig (Table 7.1.1.8.1.3.3-1A)
   * @param     p_NR_CellId
   * @param     p_DedicatedBwpListDL
   * @param     p_DedicatedBwpListUL
   * @return    template (value) CellGroupConfig
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_8_1_CellGroupConfig(NR_CellId_Type  p_NR_CellId,
                                          template (value) ServingCellConfig.downlinkBWP_ToAddModList p_DedicatedBwpListDL,
                                          template (value) UplinkConfig.uplinkBWP_ToAddModList p_DedicatedBwpListUL) runs on NR_BASE_PTC return template (value) CellGroupConfig
  {
    var template (omit) CellGroupConfig.reportUplinkTxDirectCurrent v_ReportUplinkTxDirectCurrent := true_;  /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    var CellGroupId v_CellGroupId;
    var template (omit) ServCellIndex v_ServCellIndex;
    var template (value) SpCellConfig v_SpCellConfig;
    var template (value) ServingCellConfig v_SpCellConfigDedicated;
    var template (value) UplinkConfig v_UplinkConfig;
    var boolean v_BWP_SameNumerology_upto4 := fl_NR_ReturnBWP_SameNumerologyUpto4_Capability(p_NR_CellId); //@sic R5-231578 sic@
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP (p_NR_CellId, tsc_NR_BWP_Id);       // @sic R5-236453 sic@

    if (f_GetTestcaseAttrib_ENDC(testcasename())) {
      v_CellGroupId := tsc_NR_CellGroupId_SCG;
      v_ServCellIndex := f_NR_ServCellIndex();
    } else {
      v_CellGroupId := tsc_NR_CellGroupId_MCG;
      v_ServCellIndex := omit;
    }
    //@sic R5-213459 sic@
    v_UplinkConfig := cs_NR_UplinkConfigDef(omit, omit, tsc_NR_BWP_Id_FirstActive);
    v_UplinkConfig.uplinkBWP_ToAddModList := p_DedicatedBwpListUL;
    // Set initialUplinkBWP as acc to Table 7.1.1.8.1.3.3-2: ServingCellConfig-Dedicated
    // @sic R5-236453 sic@
    v_UplinkConfig.initialUplinkBWP := cs_BWP_UplinkDedicated_Def(v_NR_UplinkBWP.Dedicated.R15.pucch_Config,
                                                                  p_DedicatedBwpListUL[0].bwp_Dedicated.pusch_Config,  //Same PUSCH-TimeDomainResourceAllocationList as in teh dedicated BWP
                                                                  v_NR_UplinkBWP.Dedicated.R15.srs_Config);

    // Table 7.1.1.8.1.3.3-2: ServingCellConfig-Dedicated
    v_SpCellConfigDedicated := cs_NR_ServingCellConfigDef();    // all fields are omit in the first place
    v_SpCellConfigDedicated.downlinkBWP_ToAddModList := p_DedicatedBwpListDL;
    v_SpCellConfigDedicated.firstActiveDownlinkBWP_Id := tsc_NR_BWP_Id_FirstActive;
    v_SpCellConfigDedicated.bwp_InactivityTimer := ms750;      // @sic R5-213459 sic@
    if (v_BWP_SameNumerology_upto4) {                         // @sic R5-227417 sic@
        v_SpCellConfigDedicated.defaultDownlinkBWP_Id := 2;
    } else {
        v_SpCellConfigDedicated.defaultDownlinkBWP_Id := 0;
    }
    v_SpCellConfigDedicated.uplinkConfig := v_UplinkConfig;
    v_SpCellConfig := cs_NR_SpCellConfigDef(v_ServCellIndex, -, -, v_SpCellConfigDedicated);
    return cs_NR_CellGroupConfigDef(v_CellGroupId, omit, omit, omit, omit, v_SpCellConfig, -, -, v_ReportUplinkTxDirectCurrent);  // 38.508-1 Table 4.6.3-19: CellGroupConfig
  }

 template (value) NR_SYSTEM_CTRL_REQ cads_NR_BWP_CONFIG_REQ(NR_CellId_Type  p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                             BWP_Id p_ActiveBWP_DL,
                                                             template (value) NR_AssignedBWPs_Type p_DCI_AssignedBWP_DL,
                                                             template (omit) NR_DciDlInfo_Type p_DciInfo_DL,
                                                             template (value) NR_ActiveUplinkBWP_Id_Type p_ActiveUplinkBWP_Id,
                                                             template (value) NR_AssignedBWPs_Type p_DCI_AssignedBWP_UL,
                                                             template (omit) NR_DciUlInfo_Type p_DciInfo_UL,
                                                             template (omit) NR_DownlinkBWP_List_Type p_DownlinkBWP_List := omit,
                                                             template (omit) NR_UplinkBWP_List_Type p_UplinkBWP_List := omit,
                                                             template (omit) NR_DownlinkBWP_SwitchIndicator_Type p_DL_BWP_SwitchIndicator,
                                                             template (omit) NR_UplinkBWP_SwitchIndicator_Type p_UL_BWP_SwitchIndicator
                                                             ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s230634sic@
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Common := omit,
            Downlink := {
              FrequencyInfoDL := omit,
              SSPbchBlock := omit,
              PdschCellLevelConfig := omit,
              BWPs := {
                ActiveBWP := p_ActiveBWP_DL,
                BwpArray  := p_DownlinkBWP_List,
                InitialBWP_RedCap := omit,
                BWP_SwitchIndicator := p_DL_BWP_SwitchIndicator  //@sic R5w240304r1 sic@
              },
              CsiConfig := omit
            },
            Uplink := {
              Uplink := {
                Config:= {
                  FrequencyInfoUL := omit,
                  BWPs := {
                    ActiveBWP := p_ActiveUplinkBWP_Id,
                    BwpArray := p_UplinkBWP_List,
                    InitialBWP_RedCap := omit,
                    BWP_SwitchIndicator := p_UL_BWP_SwitchIndicator  //@sic R5w240304r1 sic@
                  },
                  RACH_ConfigDedicated := omit,
                  SI_RequestConfig := omit
                }
              },
              SupplementaryUplink     := omit,
              TimingAdvance           := omit,
              PUSCH_ServingCellConfig := omit,
              PUSCH_ServingCellConfigSUL := omit
            }
           },
           DcchDtchConfig := {
            DL := {
              SearchSpaceAndDci := {
                AssignedBWPs    := p_DCI_AssignedBWP_DL,
                SearchSpaceType := omit,
                DciInfo         := p_DciInfo_DL
              },
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            UL := {
              SearchSpaceAndDci := {
                AssignedBWPs := p_DCI_AssignedBWP_UL,
                SearchSpaceType := omit,
                DciInfo := p_DciInfo_UL
              },
              PUCCH_Synch := omit,
              GrantConfig := omit,
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            DrxCtrl := omit,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          }
        }
      }
    }
  };

  template (value) NR_AssignedBWPs_Type cs_NR_AssignedBWPs_DedicatedBWP(BWP_Id p_Id) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    ActiveBWP := omit,
    InitialBWP := omit,
    DedicatedBWPs := {p_Id},
    InitialBWP_RedCap := omit,
    CfrBWP := omit
  };

  /*
   * @desc      return BWPIndicator according to p_NoPfBWPs
   * @param     p_NoPfBWPs
   * @param     p_BwpId
   * @return    template (value) NR_DciCommon_BWPIndicator_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_DciCommon_BWPIndicator(integer p_NoPfBWPs,
                                       BWP_Id p_BwpId) return template (value) NR_DciCommon_BWPIndicator_Type
  { //@sic R5s240450 sic@
    var template (value) NR_DciCommon_BWPIndicator_Type v_BWPIndicator;
    if (p_NoPfBWPs >= 3) {
      v_BWPIndicator := cs_NR_DciCommon_BWPIndicator_MoreThanTwoBWPs(p_BwpId);
    } else if (p_NoPfBWPs == 2) {
      v_BWPIndicator := cs_NR_DciCommon_BWPIndicator_TwoBWPs(p_BwpId);
    } else {
      v_BWPIndicator := cs_NR_DciCommon_BWPIndicator_SingleBWP;
    }
    return v_BWPIndicator;
  }

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_Common(template (value) NR_SearchSpaceTypeAndPriorityList_Type p_SearchSpaceTypeAndPriorityList := cs_NR_SearchSpaceTypeAndPriorityList_USS,
                                                                                    NR_PDCCH_CCE_AggregationLevel_Type p_AggregationLevel,
                                                                                    template (value) SearchSpace p_SearchSpace) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    TypeAndPriorityList := p_SearchSpaceTypeAndPriorityList,
    AggregationLevel := p_AggregationLevel,
    SearchSpaceConfigAtUE := {
      R15 := p_SearchSpace,
      R16 := omit,    //@sic R5w230011 sic@
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_DownlinkBWP_Type cs_NR_DownlinkBWP(template (value) BWP_Id p_Id,
                                                         template (value) BWP p_BWP,
                                                         template (value) NR_BWP_SearchSpaceConfig_Type p_SearchSpaceConfig,
                                                         template (value) NR_BWP_SearchSpaceConfig_Type p_SearchSpaceConfig2,
                                                         template (value) ControlResourceSet p_ControlResourceSet,
                                                         template (value) PDSCH_Config p_PDSCH_Config) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Id := p_Id,
    BWP := {
      R15 := p_BWP
    },
    Pdcch := {
      SearchSpaceArray := {
        p_SearchSpaceConfig,
        p_SearchSpaceConfig2  //@sic R5s230220 change 5 sic@
      },
      CoresetArray := {
        cs_NR_ASN1_ControlResourceSet(p_ControlResourceSet)
      },
      RelativeTxPower  := cs_NR_PDCCH_EPREs_Def,
      Coreset0_OffsetRBs := omit,      // CORESET#0 only
      Coreset0_PuncturingSize := omit  // CORESET#0 only @sic R5w250011 sic@
    },
    Pdsch := {
      ConfigCommon := omit,
      ConfigDedicated := {
        R15 := p_PDSCH_Config
      },
      RelativeTxPower := cs_NR_PDSCH_EPREs_Def
    },
    Sps       := omit,
    SL_Pdcch  := omit,         //@sic R5w230215 sic@
    NCD_SSPbchBlock := omit    //@sic R5w230309 sic@
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_BWP_CONFIG_DL_REQ(NR_CellId_Type  p_NR_CellId,
                                                                template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                BWP_Id p_ActiveBWP,
                                                                template (value) NR_AssignedBWPs_Type p_AssignedBWPs,
                                                                template (omit) NR_DciDlInfo_Type p_DciDlInfo,
                                                                template (omit) NR_DownlinkBWP_List_Type p_DownlinkBWP_List := omit,
                                                                template (omit) NR_DownlinkBWP_SwitchIndicator_Type p_DL_BWP_SwitchIndicator
                                                                ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s210263 added omit IEs sic@
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Common := omit,
            Downlink := {
              FrequencyInfoDL := omit,
              SSPbchBlock := omit,
              PdschCellLevelConfig := omit,
              BWPs := {
                ActiveBWP := p_ActiveBWP,
                BwpArray := p_DownlinkBWP_List,
                InitialBWP_RedCap := omit, //@sic R5w230008 sic@
                BWP_SwitchIndicator := p_DL_BWP_SwitchIndicator   //@sic R5w240304r1 sic@
              },
              CsiConfig := omit
            },
            Uplink := omit
          },
          DcchDtchConfig := {
            DL := {
              SearchSpaceAndDci := {
                AssignedBWPs    := p_AssignedBWPs,
                SearchSpaceType := omit,
                DciInfo         := p_DciDlInfo
              },
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            UL := omit,
            DrxCtrl := omit,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          }
        }
      }
    }
  };

  /*
   * @desc      build up list of BWPs to be configured at the SS
   * @param     p_NR_CellId
   * @param     p_DedicatedBwpListDL
   * @return    template (value) NR_DownlinkBWP_List_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SS_BWP_List_DL(NR_CellId_Type p_NR_CellId,
                               template (value) ServingCellConfig.downlinkBWP_ToAddModList p_DedicatedBwpListDL) runs on NR_BASE_PTC return template (value) NR_DownlinkBWP_List_Type
  {
    var BWP_Downlink v_BWP_Downlink;
    var template (value) NR_DownlinkBWP_List_Type v_DownlinkBWP_List := { f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, tsc_NR_BWP_Id_Initial) };  // initial BWP as stored for the cell
    var integer k := lengthof(v_DownlinkBWP_List);
    var integer i;

    for (i := 0; i < lengthof(p_DedicatedBwpListDL); i := i + 1) {
      v_BWP_Downlink := valueof(p_DedicatedBwpListDL[i]);     // valueof to get around useless compiler warnings
      v_DownlinkBWP_List[i+k] := cs_NR_DownlinkBWP(v_BWP_Downlink.bwp_Id,
                                                   v_BWP_Downlink.bwp_Common.genericParameters,
                                                   cs_NR_BWP_SearchSpaceConfig_Common(-, AggregationLevel2, v_BWP_Downlink.bwp_Dedicated.pdcch_Config.setup.searchSpacesToAddModList[0]),
                                                   cs_NR_BWP_SearchSpaceConfig_Common(cs_NR_SearchSpaceTypeAndPriorityList_CSS, AggregationLevel2, v_BWP_Downlink.bwp_Dedicated.pdcch_Config.setup.searchSpacesToAddModList[1]),  //@sic R5s230220 change 4 sic@
                                                   v_BWP_Downlink.bwp_Dedicated.pdcch_Config.setup.controlResourceSetToAddModList[0],
                                                   v_BWP_Downlink.bwp_Dedicated.pdsch_Config.setup);

    }
    return v_DownlinkBWP_List;
  }

  /*
   * @desc      Configure DL BWPs at the SS and/or the active DL BWP, the BWP which is used for the next DL assignment and the BWP indicated by the next DL assignemet (i.e. the BWP used for the next DL transmission
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_BwpId_DCI
   * @param     p_BwpId_Data        (default value: omit)
   * @param     p_FreqDomainSchedul (default value: omit)
   * @param     p_DownlinkBWP_List  (default value: omit)
   * @param     p_NoPfBWPs          (default value: 4)
   * @param     p_DL_BWP_SwitchIndicator (default value: omit)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SS_ConfigureBWPs_DL(NR_CellId_Type p_NR_CellId,
                                    template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                    BWP_Id p_BwpId_DCI,
                                    template (omit) BWP_Id p_BwpId_Data := omit,
                                    template (omit) NR_FreqDomainResourceAssignmentDL_Type p_FreqDomainSchedul := omit,
                                    template (omit) NR_DownlinkBWP_List_Type p_DownlinkBWP_List := omit,
                                    integer p_NoPfBWPs := 4,
                                    template (omit) NR_DownlinkBWP_SwitchIndicator_Type p_DL_BWP_SwitchIndicator := omit
                                    ) runs on NR_BASE_PTC
  { //@sic R5w240304r1: added p_DL_BWP_SwitchIndicator sic@
    var template (value) NR_AssignedBWPs_Type v_AssignedBWPs;
    var template (value) NR_DciCommon_BWPIndicator_Type v_BWPIndicator;
    var template (value) NR_DciFormat_DL_ResourceAssignment_Type v_ResourceAssignment;
    var template (value) NR_DciFormat_1_X_SpecificInfo_Type v_DciFormat := cs_NR_DciFormat_1_1_AllOmit;
    var template (value) NR_DciDlInfo_Type v_DciDlInfo;
    var BWP_Id v_BwpId_Data;
    var BWP_Id v_BwpId_ActiveBWP;

    if (isvalue(p_BwpId_Data)) {
      v_BwpId_Data := valueof(p_BwpId_Data);
    } else {
      v_BwpId_Data := p_BwpId_DCI;
    }

    v_BwpId_ActiveBWP := v_BwpId_Data;                                                          // Set to the same BWP as where the DL data is sent
    v_AssignedBWPs := cs_NR_AssignedBWPs_DedicatedBWP(p_BwpId_DCI);                             // BWP assigned to the searchspace (i.e. in which DCI is sent)
    v_BWPIndicator := f_NR_DciCommon_BWPIndicator(p_NoPfBWPs, v_BwpId_Data);                    // BWP indicator in DCI format 1_1
    v_DciFormat.Format_1_1.BWPIndicator := v_BWPIndicator;                                      // Only the BWP indicator needs to be modified

    //PUCCH configured with ony one resource in Table 7.1.1.8.1.3.3-2G
    //@sic R5s230220 change 6 sic@
    v_DciFormat.Format_1_1.PucchResourceIndicator.Value := '000'B;

    v_ResourceAssignment := cs_NR_DciFormat_DL_ResourceAssignment(-, p_FreqDomainSchedul, cs_NR_DciCommon_TimeDomainResourceAssignment('1'B)); //@sic R5s230220 change 6 sic@
    v_DciDlInfo := cs_NR_DciDlInfo(v_ResourceAssignment, -, v_DciFormat);
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_BWP_CONFIG_DL_REQ(p_NR_CellId, p_TimingInfo, v_BwpId_ActiveBWP, v_AssignedBWPs, v_DciDlInfo, p_DownlinkBWP_List, p_DL_BWP_SwitchIndicator));
  }

  template (value) NR_ActiveUplinkBWP_Id_Type cs_ActiveUplinkBWP_Id_Explicit(BWP_Id p_BWP_Id) := { Explicit := p_BWP_Id }; /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_UplinkBWP_Type cs_NR_UplinkBWP(template (value) BWP_Id p_Id,
                                                     template (value) BWP_UplinkCommon p_BWP_UplinkCommon,
                                                     template (value) BWP_UplinkDedicated p_BWP_UplinkDedicated) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Id := p_Id,
    Common := {
      R15 := p_BWP_UplinkCommon
    },
    Dedicated := {
      R15 := p_BWP_UplinkDedicated
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_BWP_CONFIG_UL_REQ(NR_CellId_Type  p_NR_CellId,
                                                                template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                template (value) NR_ActiveUplinkBWP_Id_Type p_ActiveUplinkBWP_Id,
                                                                template (value) NR_AssignedBWPs_Type p_AssignedBWPs,
                                                                template (value) NR_DciUlInfo_Type p_DciUlInfo,
                                                                template (omit) NR_UplinkBWP_List_Type p_UplinkBWP_List := omit,
                                                                template (omit) NR_UplinkBWP_SwitchIndicator_Type p_UL_BWP_SwitchIndicator
                                                               ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s210263 added IE AddOrReconfigure->PhysicalLayer->Common sic@
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Common   := omit,
            Downlink := omit,
            Uplink := {
              Uplink := {
                Config:= {
                  FrequencyInfoUL := omit,
                  BWPs := {
                    ActiveBWP := p_ActiveUplinkBWP_Id,
                    BwpArray := p_UplinkBWP_List,
                    InitialBWP_RedCap := omit,
                    BWP_SwitchIndicator := p_UL_BWP_SwitchIndicator  //@sic R5w240304r1 sic@
                  },
                  RACH_ConfigDedicated := omit,
                  SI_RequestConfig := omit
                }
              },
              SupplementaryUplink     := omit,   //@sic R5s240505 sic@
              TimingAdvance           := omit,   //@sic R5s240505 sic@
              PUSCH_ServingCellConfig := omit,   //@sic R5s240505 sic@
              PUSCH_ServingCellConfigSUL := omit   //@sic R5s240505 sic@
            }
          },
          DcchDtchConfig := {
            DL := omit,
            UL := {
              SearchSpaceAndDci := {
                AssignedBWPs := p_AssignedBWPs,
                SearchSpaceType := omit,
                DciInfo := p_DciUlInfo
              },
              PUCCH_Synch := omit,
              GrantConfig := omit,
              CoresetPoolIndex := omit  //@sic R5w240003 sic@
            },
            DrxCtrl := omit,
            MeasGapCtrl := omit,
            DL2         := omit,          //@sic R5w240003 sic@
            UL2         := omit           //@sic R5w240003 sic@
          }
        }
      }
    }
  };

  /*
   * @desc      build up list of BWPs to be configured at the SS
   * @param     p_NR_CellId
   * @param     p_DedicatedBwpListUL
   * @return    template (value) NR_UplinkBWP_List_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SS_BWP_List_UL(NR_CellId_Type p_NR_CellId,
                               template (value) UplinkConfig.uplinkBWP_ToAddModList p_DedicatedBwpListUL) runs on NR_BASE_PTC return template (value) NR_UplinkBWP_List_Type
  {
    var BWP_Uplink v_BWP_Uplink;
    var template (value) NR_UplinkBWP_List_Type v_UplinkBWP_List := { f_NR_CellInfo_GetUplinkBWP(p_NR_CellId, tsc_NR_BWP_Id_Initial) };  // initial BWP as stored for the cell
    var integer k := lengthof(v_UplinkBWP_List);
    var integer i;

    //Update bwp-Dedicated for BWP#0
    //@sic R5s240007 sic@
    v_BWP_Uplink := valueof(p_DedicatedBwpListUL[0]);
    //Update only PUSCH Config in BWP#0  @sic R5s260056 sic@
    v_UplinkBWP_List[0].Dedicated.R15.pusch_Config := v_BWP_Uplink.bwp_Dedicated.pusch_Config;
    //Additional BWPs
    for (i := 0; i < lengthof(p_DedicatedBwpListUL); i := i + 1) {
      v_BWP_Uplink := valueof(p_DedicatedBwpListUL[i]);     // valueof to get around useless compiler warnings
      v_UplinkBWP_List[i+k] := cs_NR_UplinkBWP(v_BWP_Uplink.bwp_Id,
                                               v_BWP_Uplink.bwp_Common,
                                               v_BWP_Uplink.bwp_Dedicated);
    }
    return v_UplinkBWP_List;
  }

  /*
   * @desc      Configure UL BWPs at the SS and/or the active UL BWP, the BWP which is used for the next UL grant and the BWP indicated by the next UL grant (i.e. the BWP used for the next UL transmission;
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_BwpId_DCI
   * @param     p_BwpId_Data        (default value: omit)
   * @param     p_UplinkBWP_List    (default value: omit)
   * @param     p_NoPfBWPs          (default value: 4)
   * @param     p_UL_BWP_SwitchIndicator
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SS_ConfigureBWPs_UL(NR_CellId_Type p_NR_CellId,
                                    template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                    BWP_Id p_BwpId_DCI,
                                    template (omit) BWP_Id p_BwpId_Data := omit,
                                    template (omit) NR_UplinkBWP_List_Type p_UplinkBWP_List := omit,
                                    integer p_NoPfBWPs := 4,
                                    template (omit) NR_UplinkBWP_SwitchIndicator_Type p_UL_BWP_SwitchIndicator
                                    ) runs on NR_BASE_PTC
  { //@sic R5w240304r1: added p_UL_BWP_SwitchIndicator sic@
    var template (value) NR_AssignedBWPs_Type v_AssignedBWPs;
    var template (value) NR_ActiveUplinkBWP_Id_Type v_ActiveUplinkBWP_Id;
    var template (value) NR_DciCommon_BWPIndicator_Type v_BWPIndicator;
    var template (value) NR_DciFormat_0_X_SpecificInfo_Type v_DciFormat := cs_NR_DciFormat_0_1_AllOmit;
    var template (value) NR_DciUlInfo_Type v_DciUlInfo;
    var BWP_Id v_BwpId_Data;

    if (isvalue(p_BwpId_Data)) {
      v_BwpId_Data := valueof(p_BwpId_Data);
    } else {
      v_BwpId_Data := p_BwpId_DCI;
    }

    v_AssignedBWPs := cs_NR_AssignedBWPs_DedicatedBWP(p_BwpId_DCI);                             // BWP in which DCI is sent
    v_ActiveUplinkBWP_Id := cs_ActiveUplinkBWP_Id_Explicit(v_BwpId_Data);                       // Active UL BWP: same as in DCI format 0_1
    v_BWPIndicator := f_NR_DciCommon_BWPIndicator(p_NoPfBWPs, v_BwpId_Data);                    // BWP indicator in DCI format 0_1
    v_DciFormat.Format_0_1.BWPIndicator := v_BWPIndicator;                                      // only the BWP indicator needs to be modified
    v_DciUlInfo := cs_NR_DciUlInfo_AllOmit;
    v_DciUlInfo.Format := v_DciFormat;

    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_BWP_CONFIG_UL_REQ(p_NR_CellId, p_TimingInfo, v_ActiveUplinkBWP_Id, v_AssignedBWPs, v_DciUlInfo, p_UplinkBWP_List, p_UL_BWP_SwitchIndicator));
  }

  /*
   * @desc      Configure DL and UL BWPs at the SS and/or the active DL BWP, the BWP which is used for the next DL assignment and the BWP indicated by the next DL assignemet (i.e. the BWP used for the next DL transmission
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_BwpId_DCI_DL
   * @param     p_BwpId_Data_DL
   * @param     p_BwpId_DCI_UL
   * @param     p_BwpId_Data_UL
   * @param     p_NoPfBWPs          (default value: 4)
   * @param     p_FreqDomainSchedul (default value: omit)
   * @param     p_DownlinkBWP_List  (default value: omit)
   * @param     p_UplinkBWP_List    (default value: omit)
   * @param     p_DL_BWP_SwitchIndicator
   * @param     p_UL_BWP_SwitchIndicator
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SS_ConfigureBWPs(NR_CellId_Type p_NR_CellId,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                 BWP_Id p_BwpId_DCI_DL,
                                 BWP_Id p_BwpId_Data_DL,
                                 BWP_Id p_BwpId_DCI_UL,
                                 BWP_Id p_BwpId_Data_UL,
                                 integer p_NoPfBWPs := 4,
                                 template (omit) NR_FreqDomainResourceAssignmentDL_Type p_FreqDomainSchedul := omit,
                                 template (omit) NR_DownlinkBWP_List_Type p_DownlinkBWP_List := omit,
                                 template (omit) NR_UplinkBWP_List_Type p_UplinkBWP_List := omit,
                                 template (omit) NR_DownlinkBWP_SwitchIndicator_Type p_DL_BWP_SwitchIndicator,
                                 template (omit) NR_UplinkBWP_SwitchIndicator_Type p_UL_BWP_SwitchIndicator
                                 ) runs on NR_BASE_PTC
  { //@sic R5s230634 change 2.1 sic@
    //@sic R5w240304r1: added p_DL_BWP_SwitchIndicator and p_UL_BWP_SwitchIndicator sic@
    var template (value) NR_AssignedBWPs_Type v_DCI_AssignedBWPs_DL;
    var template (value) NR_DciCommon_BWPIndicator_Type v_BWPIndicator;
    var template (value) NR_DciFormat_DL_ResourceAssignment_Type v_ResourceAssignment_DL;
    var template (value) NR_DciFormat_1_X_SpecificInfo_Type v_DlDciFormat := cs_NR_DciFormat_1_1_AllOmit;
    var template (value) NR_DciDlInfo_Type v_DciDlInfo;
    var template (value) NR_ActiveUplinkBWP_Id_Type v_ActiveUplinkBWP_Id;
    var template (value) NR_AssignedBWPs_Type v_DCI_AssignedBWPs_UL;
    var template (value) NR_DciUlInfo_Type v_DciUlInfo;
    var template (value) NR_DciFormat_0_X_SpecificInfo_Type v_DciFormat_UL := cs_NR_DciFormat_0_1_AllOmit;

    //DL
    v_DCI_AssignedBWPs_DL := cs_NR_AssignedBWPs_DedicatedBWP(p_BwpId_DCI_DL);          // BWP assigned to the searchspace (i.e. in which DCI is sent)
    v_BWPIndicator := f_NR_DciCommon_BWPIndicator(p_NoPfBWPs, p_BwpId_Data_DL);        // BWP indicator in DCI format 1_1
    v_DlDciFormat.Format_1_1.BWPIndicator := v_BWPIndicator;                           // Only the BWP indicator needs to be modified
    //PUCCH configured with ony one resource in Table 7.1.1.8.1.3.3-2G
    //@sic R5s230220 change 6 sic@
    v_DlDciFormat.Format_1_1.PucchResourceIndicator.Value := '000'B;
    v_ResourceAssignment_DL := cs_NR_DciFormat_DL_ResourceAssignment(-, p_FreqDomainSchedul, cs_NR_DciCommon_TimeDomainResourceAssignment('1'B)); //@sic R5s230220 change 6 sic@
    v_DciDlInfo := cs_NR_DciDlInfo(v_ResourceAssignment_DL, -, v_DlDciFormat);

    //UL
    v_ActiveUplinkBWP_Id := cs_ActiveUplinkBWP_Id_Explicit(p_BwpId_Data_UL);           // Active UL BWP: same as in DCI format 0_1
    v_DCI_AssignedBWPs_UL := cs_NR_AssignedBWPs_DedicatedBWP(p_BwpId_DCI_UL);          // BWP in which DCI is sent
    v_BWPIndicator := f_NR_DciCommon_BWPIndicator(p_NoPfBWPs, p_BwpId_Data_UL);        // BWP indicator in DCI format 0_1
    v_DciFormat_UL.Format_0_1.BWPIndicator := v_BWPIndicator;                          // only the BWP indicator needs to be modified
    v_DciUlInfo := cs_NR_DciUlInfo_AllOmit;
    v_DciUlInfo.Format := v_DciFormat_UL;

    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_BWP_CONFIG_REQ(p_NR_CellId, p_TimingInfo,
                                                                 p_BwpId_Data_DL,  //@sic R5s230733 sic@
                                                                 v_DCI_AssignedBWPs_DL,
                                                                 v_DciDlInfo,
                                                                 v_ActiveUplinkBWP_Id,
                                                                 v_DCI_AssignedBWPs_UL,
                                                                 v_DciUlInfo,
                                                                 p_DownlinkBWP_List,
                                                                 p_UplinkBWP_List,
                                                                 p_DL_BWP_SwitchIndicator,
                                                                 p_UL_BWP_SwitchIndicator
                                                                 ));
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.8.1
   * @param     p_NR_CellId
   * @param     p_MilliSeconds      (default value: 100)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(NR_CellId_Type p_NR_CellId,
                                                    UInt_Type p_MilliSeconds := 100
                                                    )runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    //@sic R5s230220: added p_MilliSeconds sic@
    var SubFrameTiming_Type v_Timing := f_NR_GetNextSendOccasion_DL(p_NR_CellId, p_MilliSeconds);
    var boolean v_FDD := f_NR_CellInfo_GetIsFDD(p_NR_CellId);
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);

    //In case of FDD - no need to change the data scheduling
    if (not(v_FDD)) {  //TDD
        select (v_SubcarrierSpacing) {
            case (kHz15) {
                if (pc_bwp_SwitchingDelay_Type1) {  //k0=1 k1=7
                    //PDCCH in subframe 6 - PDSCH in subframe 7 - UL HARQ in subframe 4
                    v_Timing.Subframe.Number := 6;
                } else if (pc_bwp_SwitchingDelay_Type2) {  //k0=6 k1=7
                    //PDCCH in subframe 1 - PDSCH in subframe 6 - UL HARQ in subframe 4
                    v_Timing.Subframe.Number := 1;
                }
            }
            case (kHz30) {
                if (pc_bwp_SwitchingDelay_Type1) {  //k0=2 k1=5
                    //PDCCH in subframe 6 slot 0 - PDSCH in subframe 7 slot 0 - UL HARQ in subframe 9 slot 1
                    v_Timing.Subframe.Number := 6;
                    v_Timing.Slot.SlotOffset.Numerology1 := 0;
                } else if (pc_bwp_SwitchingDelay_Type2) {  //k0=6 k1=7
                    //PDCCH in subframe 3 slot 1 - PDSCH in subframe 6 slot 1 - UL HARQ in suframe 9 slot 0
                    v_Timing.Subframe.Number := 3;
                    v_Timing.Slot.SlotOffset.Numerology1 := 1;
                }
            }
            case (kHz120) {
                if (pc_bwp_SwitchingDelay_Type1) {  //k0=6 k1=8
                    //PDCCH in subframe 6 slot 2 - PDSCH in subframe 7 slot 0 - UL HARQ in subframe 8 slot 0
                    v_Timing.Subframe.Number := 6;
                    v_Timing.Slot.SlotOffset.Numerology3 := 2;
                } else if (pc_bwp_SwitchingDelay_Type2) {  //k0=18 k1=8
                    //PDCCH in subframe 4 slot 6 - PDSCH in subframe 7 slot 0 - UL HARQ in subframe 8 slot 0
                    v_Timing.Subframe.Number := 4;
                    v_Timing.Slot.SlotOffset.Numerology3 := 6;
                }
            }
        }
    }
    return v_Timing;
  }

  /*
   * @desc      transmit a MAC PDU containing RLC PDU for test case 7.1.1.8.1;
   *            NOTE 1: There is no need to configure any MAC test mode for test case 7.1.1.8.1 as there is only the requirement to send some MAC PDU
   *                    => The SS shall be configured with MAC in normal mode, RLC in test mode (transparent, AM 18bit-SN), PDCP and SDAP not being configured
   *            NOTE 2: the same sequence number (p_SN) is used for RLC and PDCP
   * @param     p_NR_CellId
   * @param     p_DrbId
   * @param     p_TimingInfo
   * @param     p_SN
   * @param     p_PollBit           (default value: tsc_NR_P_NoPoll)
   * @return    NR_RLC_AMD_Data_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_TC_7_1_1_8_1_SendData(NR_CellId_Type p_NR_CellId,
                                    DRB_Identity p_DrbId,
                                    template (value) TimingInfo_Type p_TimingInfo,
                                    integer p_SN,
                                    B1_Type p_PollBit := tsc_NR_P_NoPoll) runs on NR_BASE_PTC return NR_RLC_AMD_Data_Type
  {
    var NR_PDCP_SDU_Type v_PDCP_SDU := f_GetN_OctetsFromPRBS(p_SN, 36);   // arbitrarily selected
    var NR_RLC_AMD_Data_Type v_EncodedPdcpPdu := f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU(p_SN, v_PDCP_SDU));  //@sic R5-227518 sic@
    var template (value) NR_RLC_PDU_Type v_RLC_PDU;
    var template (value) NR_RLC_PDUList_Type v_PDUList;

    if (f_NR_SupportOfRedCap()) {   //@sic R5-227518 sic@
        v_RLC_PDU := cs_NR_RLC_PDU_AMD(cs_NR_RLC_AMD_PDU_SN12Bit(cs_NR_RLC_AMD_PduSN12Bit(p_SN, p_PollBit, -, -, v_EncodedPdcpPdu)));
    } else {
        v_RLC_PDU := cs_NR_RLC_PDU_AMD(cs_NR_RLC_AMD_PDU_SN18Bit(cs_NR_RLC_AMD_PduSN18Bit(p_SN, p_PollBit, -, -, v_EncodedPdcpPdu)));
    }
    v_PDUList := { v_RLC_PDU };
    DRB.send(cas_NR_DRB_COMMON_REQ_RLC_PDUList(p_NR_CellId, p_DrbId, p_TimingInfo, v_PDUList));
    return v_EncodedPdcpPdu;
  }

  /*
   * @desc      receive a MAC PDU containing RLC PDU for test case 7.1.1.8.1
   * @param     p_NR_CellId
   * @param     p_DrbId
   * @param     p_EncodedPdcpPduList
   * @param     p_SendRLC_ACK       (default value: false)
   * @param     p_SN_RLC_Status     (default value: 0)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_TC_7_1_1_8_1_ReceiveData(NR_CellId_Type p_NR_CellId,
                                       DRB_Identity p_DrbId,
                                       OctetStringList_Type p_EncodedPdcpPduList,
                                       boolean p_SendRLC_ACK := false,
                                       integer p_SN_RLC_Status := 0    //Used only when p_SendRLC_ACK=true
                                       ) runs on NR_BASE_PTC
  {//@sic R5-231578 R5s230220 change 8: added p_SendRLC_ACK and p_SN_RLC_Status sic@
    var template (present) NR_RLC_PDUList_Type v_RLC_PDUList;
    var template (value) NR_RLC_PDUList_Type v_RLC_StatusPDUList;
    var integer i;
    var template (value) NR_RLC_StatusPduSN12Bit_Type v_StatusPduSN12Bit;
    var template (value) NR_RLC_StatusPduSN18Bit_Type v_StatusPduSN18Bit;
    var template (value) NR_RLC_AM_StatusPDU_Type v_NR_RLC_StatusPDU;

    for (i := 0; i < lengthof(p_EncodedPdcpPduList); i := i + 1) {
        /* per default the poll bit is '?';
           nevertheless in this testcase the UE should set the poll bit as its transmission buffer gets empty after each transmission
           => the UE expects a STATUS PDU within T-PollRetransmit */
      if (f_NR_SupportOfRedCap()) {  //@sic R5-227518 sic@
        v_RLC_PDUList[i] := cr_NR_RLC_PDU_AMD(cr_NR_RLC_AMD_PDU_SN12Bit(cr_NR_RLC_AMD_PduSN12Bit(-, -, -, -, p_EncodedPdcpPduList[i])));
      } else {
        v_RLC_PDUList[i] := cr_NR_RLC_PDU_AMD(cr_NR_RLC_AMD_PDU_SN18Bit(cr_NR_RLC_AMD_PduSN18Bit(-, -, -, -, p_EncodedPdcpPduList[i])));
      }
    }
    DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(p_NR_CellId, p_DrbId, -, v_RLC_PDUList));

    //@sic R5-231578 R5s230220 change 8 sic@
    if (p_SendRLC_ACK) {
        if (f_NR_SupportOfRedCap()) {  //@sic R5-227518 sic@
            v_StatusPduSN12Bit := cs_NR_RLC_StatusPduSN12Bit(p_SN_RLC_Status + 1, omit);
            v_NR_RLC_StatusPDU := cs_NR_RLC_StatusPDU_SN12Bit(v_StatusPduSN12Bit);
        } else {
            v_StatusPduSN18Bit := cs_NR_RLC_StatusPduSN18Bit(p_SN_RLC_Status + 1, omit);
            v_NR_RLC_StatusPDU := cs_NR_RLC_StatusPDU_SN18Bit(v_StatusPduSN18Bit);
        }
        v_RLC_StatusPDUList := { cs_NR_RLC_PDU_Status(v_NR_RLC_StatusPDU) };
        DRB.send(cas_NR_DRB_COMMON_REQ_RLC_PDUList(p_NR_CellId,
                                                   p_DrbId,
                                                   -, //now
                                                   v_RLC_StatusPDUList));
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.8.1
   * @param     p_NR_CellId
   * @param     p_DrbId
   * @param     p_ResourceAllocationUL
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_8_1_NR_CommonTestBody(NR_CellId_Type p_NR_CellId,
                                            DRB_Identity p_DrbId,
                                            template (value) NR_ResourceAllocation_Type p_ResourceAllocationUL) runs on NR_BASE_PTC
  { //@sic R5-213459 R5-227417 R5-244020 sic@
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters;
    var template (value) NR_RachProcedureConfig_Type v_NR_RachProcedure;
    var template (value) NR_PDCCH_Order_Type v_PDCCH_Order;
    var BWP_Id v_BWP_Id_PDCCH_Order;
    var SubFrameTiming_Type v_TimingInfoDL;
    var SubFrameTiming_Type v_TimingInfoDL_Step16;  //@sic R5s250095 sic@
    var SubFrameTiming_Type v_TimingInfoDL_Step17;  //@sic R5s250095 sic@
    var SubFrameTiming_Type v_TimingInfoUL_Step18;  //@sic R5s250095 sic@
    var SubFrameTiming_Type v_TimingInfoDL_Step20;  //@sic R5s250095 sic@
    
    var SubFrameTiming_Type v_TimingInfoSS;     //@sic R5s240283 sic@
    var SubFrameTiming_Type v_TimingInfoUL;
    var SubFrameTiming_Type v_TimingInfoConfig;
    var octetstring v_RLC_SDU1;
    var octetstring v_RLC_SDU2;
    var integer v_RA_PreambleIndex;
    var integer v_SN := 0;
    var boolean v_BWP_SameNumerology_upto4 := fl_NR_ReturnBWP_SameNumerologyUpto4_Capability(p_NR_CellId); //@sic R5-231578 sic@
    var SubFrameTiming_Type v_TimingInfoUL_SS;
    var BWP_Id v_BwpId_DL_DCI;                 //BWP on which the DL DCI is transmitted
    var BWP_Id v_BwpId_DL_DCI_IndicatorData;   //Indicator inside DL BWP = BWP on which DL data is tranmsitted
    var BWP_Id v_DL_BwpId_UL_DCI;              //DL BWP on which the UL DCI is transmitted
    var BWP_Id v_BwpId_UL_DCI_IndicatorData;   //Indicator inside UL BWP = BWP on which UL data is tranmsitted
    var boolean v_IsFDD := f_NR_CellInfo_GetIsFDD(p_NR_CellId);
    var integer v_MaxBWP := 4;   //@sic R5s240450 sic@
    var template (omit) NR_UplinkBWP_SwitchIndicator_Type v_UL_SwitchIndicator;    //@sic R5w240304r1 sic@
    var template (omit) NR_DownlinkBWP_SwitchIndicator_Type v_DL_SwitchIndicator;  //@sic R5w240304r1 sic@
    

    if (not v_BWP_SameNumerology_upto4) { v_MaxBWP := 2; }   //@sic R5s240450 sic@

    // @siclog "Step 1" siclog@
    v_TimingInfoDL := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId);
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL), v_SN);

    // @siclog "Step 2" siclog@
    v_TimingInfoUL := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL, 100);            // 100ms after step 1
    f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL), p_ResourceAllocationUL);

    // @siclog "Steps 3-3A" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN); //@sic R5-231578 R5s230220 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");

    v_SN := v_SN + 1;

   //@sic R5s240283 sic@
   v_DL_SwitchIndicator := ActiveBWP_SwitchWithDCI;
    if (v_BWP_SameNumerology_upto4) {
      if (not(v_IsFDD)) { // TDD
        //step 5a - 6a - 7a
        //IF (pc_bwp_sameNumerology_upto4_FR1_TDD and  band under test is FR1 TDD) or (pc_bwp_sameNumerology_upto4_FR2 and band under test is FR2)
        //THEN The SS indicates on PDCCH (transmitted in Downlink BWP#1) DL DCI format 1_1 with new BWP Id BWP#2 and transmits a MAC PDU containing RLC PDU on the newly configured BWP (BWP#2)
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_2;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_2;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_2;
        v_UL_SwitchIndicator := ActiveBWP_SwitchNoDCI;
      } else { // FDD
        //Step 5b - 6b - 7b
        //IF pc_bwp_sameNumerology_upto4_FR1_FDD and band under test is FR1 FDD
        //THEN The SS indicates on PDCCH (transmitted in Downlink BWP#1) DL DCI format 1_1 with new BWP Id BWP #2 and transmits a MAC PDU containing RLC PDU on the newly configured BWP (BWP#2)
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_2;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_2;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_UL_SwitchIndicator := omit;
      }
    } else {
      if (not(v_IsFDD)) { // TDD
        //Step 5c - 6c - 7c
        //IF (pc_bwp_sameNumerology_upto2_FR1_TDD and band under test is FR1 TDD ) or (pc_bwp_sameNumerology_upto2_FR2 and band under test is FR2)
        //THEN The SS indicates on PDCCH (transmitted in Downlink BWP#1) DL DCI format 1_1 with new BWP Id BWP#0 and transmits a MAC PDU containing RLC PDU on the newly configured BWP (BWP#0)
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_UL_SwitchIndicator := ActiveBWP_SwitchNoDCI;
      } else {
        //Step 5d - 6d - 7d
        //IF pc_bwp_sameNumerology_upto2_FR1_FDD and band under test is FR1 FDD
        //THEN The SS indicates on PDCCH (transmitted in Downlink BWP#1) DL DCI format 1_1 with new BWP Id BWP #0 and transmits a MAC PDU containing RLC PDU on the newly configured BWP (BWP#0)
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_UL_SwitchIndicator := omit;
      }
    }
    v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
    f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), v_BwpId_DL_DCI, v_BwpId_DL_DCI_IndicatorData, v_DL_BwpId_UL_DCI, v_BwpId_UL_DCI_IndicatorData, v_MaxBWP,
                          -,-,-,
                          v_DL_SwitchIndicator, v_UL_SwitchIndicator);

    // @siclog "Step 5a/b/c/d" siclog@
    v_TimingInfoDL := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId);
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL), v_SN);

    // @siclog "Step 6a/b/c/d" siclog@
    v_TimingInfoUL := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL, 100);    // 100ms after step 5
    f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL), p_ResourceAllocationUL);

    // @siclog "Steps 7a/b/c/d-7A" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN); //@sic R5-231578 R5s230220 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    v_SN := v_SN + 1;

    //@sic R5s240283 sic@
    v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
    //@sic R5s230220 change 9.2 R5-2134599 R5s240450sic@
    // Reconfigure DL DCI to be transmitted on v_BwpId_DL_DCI_IndicatorData
    f_NR_SS_ConfigureBWPs_DL(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), v_BwpId_DL_DCI_IndicatorData, v_BwpId_DL_DCI_IndicatorData, -, -, v_MaxBWP, omit);

    // @siclog "Step 9a/b/c/d" siclog@
    v_TimingInfoDL := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId, 300);
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL), v_SN);

    //@sic R5s230220 change 9.2 sic@
    //Initialise variable for step 10a/b/c/d
    v_UL_SwitchIndicator := ActiveBWP_SwitchWithDCI;
    if (v_BWP_SameNumerology_upto4) {
      if (not(v_IsFDD)) { //TDD
        //step 10a - 11a
        //IF pc_bwp_sameNumerology_upto4_FR1_TDD and  band under test is FR1 TDD) or (pc_bwp_sameNumerology_upto4_FR2 and band under test is FR2)
        //THEN after 100ms from step 9 the SS indicates on PDCCH (transmitted in Downlink BWP#2) an UL DCI format 0_1 with new BWP Id BWP #3 and allocates an UL Grant, sufficient for loopback of the RLC SDU from step 9.
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_3;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_3;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_2;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_3;
        v_DL_SwitchIndicator := ActiveBWP_SwitchNoDCI;
      } else {
        //Step 10b - 11b
        //IF pc_bwp_sameNumerology_upto4_FR1_FDD and band under test is FR1 FDD
        //THEN After 100ms from step 9 the SS indicates on PDCCH (transmitted in Downlink BWP#2) an UL DCI format 0_1 with new BWP Id BWP #3 and allocates an UL Grant, sufficient for loopback of the RLC SDU from step 9.
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_2;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_2;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_2;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_3;
        v_DL_SwitchIndicator := omit;
      }
    } else {
      if (not(v_IsFDD)) {
        //Step 10c - 11c
        //IF (pc_bwp_sameNumerology_upto2_FR1_TDD and band under test is FR1 TDD) or (pc_bwp_sameNumerology_upto2_FR2 and band under test is FR2)
        //THEN After 100ms from step 9 the SS indicates on PDCCH (transmitted in Downlink BWP#0 an UL DCI format 0_1 with new BWP Id BWP#1 and allocates an UL Grant, sufficient for loopback of the RLC SDU from step 9.
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_DL_SwitchIndicator := ActiveBWP_SwitchNoDCI;
      } else {
        // Step 10d - 11d
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_DL_SwitchIndicator := omit;
      }
    }
    v_TimingInfoUL_SS := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL, 90);              // 90 ms after step 9 - reconfigure UL/DL BWP in SS
    v_TimingInfoUL := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL, 100);                // 100ms after step 9
    if (not(v_IsFDD)) {
      f_NR_SS_ConfigureBWPs( p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL_SS), v_BwpId_DL_DCI, v_BwpId_DL_DCI_IndicatorData, v_DL_BwpId_UL_DCI, v_BwpId_UL_DCI_IndicatorData, v_MaxBWP, -, -, -, v_DL_SwitchIndicator, v_UL_SwitchIndicator);
    } else {
      // For FDD reconfigure only UL BWP
      f_NR_SS_ConfigureBWPs_UL( p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL_SS), v_DL_BwpId_UL_DCI, v_BwpId_UL_DCI_IndicatorData, -, v_MaxBWP, v_UL_SwitchIndicator);
    }
    // @siclog "Step 10a/b/c/d" siclog@
    f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL), p_ResourceAllocationUL);

    // @siclog "Steps 11a/b/c/d-11AA" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN); //@sic R5-231578 R5s230220 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    if (not(v_IsFDD)) { //TDD reconfigure UL DCI on new BWPId
      f_NR_SS_ConfigureBWPs_UL( p_NR_CellId, -, v_BwpId_DL_DCI, v_BwpId_DL_DCI_IndicatorData, -, v_MaxBWP, omit);
    }

    if (v_IsFDD  and not(v_BWP_SameNumerology_upto4)) {
    // for FDD and  pc_bwp_sameNumerology_upto2_FR1_FDD switch DL and UL BWP from BWP#0 to (BWP#1)
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_UL_SwitchIndicator := ActiveBWP_SwitchWithDCI;
        v_DL_SwitchIndicator := ActiveBWP_SwitchWithDCI;

        v_SN := v_SN + 1;

        //@siclog 11AABa1 siclog@
        v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
        f_NR_SS_ConfigureBWPs( p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), v_BwpId_DL_DCI, v_BwpId_DL_DCI_IndicatorData, v_DL_BwpId_UL_DCI, v_BwpId_UL_DCI_IndicatorData, v_MaxBWP, -,-,-, v_DL_SwitchIndicator, v_UL_SwitchIndicator);
        v_TimingInfoDL := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId);
        v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL), v_SN);

        // @siclog "Step 11AABa2" siclog@
        //After 100ms from step 11AABa1 the SS indicates on PDCCH (transmitted in Downlink BWP#1 an UL DCI format 0_1 with new BWP Id BWP#1 and allocates an UL Grant, sufficient for loopback of the RLC SDU from step 11AABa1.
        v_TimingInfoUL := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL, 100);
        f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL), p_ResourceAllocationUL);

        // @siclog "Steps 11AABa3 - 11AABa4" siclog@
        fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN);
        v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
        f_NR_SS_ConfigureBWPs_DL(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), v_BwpId_DL_DCI_IndicatorData, -, -, -, v_MaxBWP, omit);
    }

    // configure CBRA CRNTI Based RACH procedure
    //@sic R5s230220 change 10 sic@
    v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_NR_CellId);
    v_NR_RachProcedure := cs_NR_RachProcedureConfig_CBRA_CrntiBased(v_NR_PhysicalParameters, p_ResourceAllocationUL, -, tsc_NR_ENDC_Msg3Grant_Def, cs_NR_AssignedBWPs_InitialBWP);
    f_NR_SS_RachProcedureConfig(p_NR_CellId, v_NR_RachProcedure);

    v_SN := v_SN + 1;
    //@sic R5-2134599  R5s230634 sic@
    if (v_BWP_SameNumerology_upto4) {
        v_BWP_Id_PDCCH_Order := tsc_NR_BWP_Id_3;
    } else {
        v_BWP_Id_PDCCH_Order := tsc_NR_BWP_Id_1;
    }
    // @sic R5s230733 sic@

    // Reconfiguration for step 11Ab
    // FDD 4BWPs - DL BWP switch from DL BWP#2 to DL BWP#3
    //@sic R5-251261 sic@
    if (v_IsFDD and v_BWP_SameNumerology_upto4) {
      f_NR_SS_ConfigureBWPs(p_NR_CellId, -, tsc_NR_BWP_Id_2, tsc_NR_BWP_Id_3, tsc_NR_BWP_Id_3, tsc_NR_BWP_Id_3, v_MaxBWP,
                            -,-,-,
                            ActiveBWP_SwitchWithDCI, omit);
    }

    // @siclog "Step 11Aa/b/c/d" siclog@
    v_TimingInfoDL := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId);
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL), v_SN);

    // Enable PRACH reception indication
    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_RachPreamble(enable));

    // @siclog "Step 12" siclog@
    v_TimingInfoDL := f_SubFrameTiming_AddMilliSeconds(v_TimingInfoDL, 100);                            // 100ms after step 9
    v_RA_PreambleIndex := 0;                                                                            // => contention-based random access
    v_PDCCH_Order := cs_NR_PDCCH_Order(f_NR_CellInfo_GetSSB_Index(p_NR_CellId), v_RA_PreambleIndex);
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_DciTriggerPDCCHOrder_REQ(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoDL), v_PDCCH_Order, cs_NR_AssignedBWPs_DedicatedBWP(v_BWP_Id_PDCCH_Order)));
    // @sic R5s230733 sic@
    v_TimingInfoConfig := f_SubFrameTiming_AddMilliSeconds(v_TimingInfoDL, 10);
    f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoConfig), tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, v_MaxBWP, -, -, -, ActiveBWP_SwitchNoDCI, ActiveBWP_SwitchNoDCI);

    // @siclog "Step 13" siclog@
    SYSIND.receive(car_NR_PRACH_Preamble_IND(p_NR_CellId));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");

    // @siclog "Step 13A - 13C" siclog@
    // steps are done automatically according to configuration of the RACH procedure

    // @siclog "Steps 13D-13E" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN); //@sic R5-231578 R5s230220 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13D");
    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_RachPreamble(disable)); //@sic R5s230634 sic@

    v_SN := v_SN + 1;

    v_DL_SwitchIndicator := ActiveBWP_SwitchWithDCI;
    if (not(v_IsFDD)) { //TDD
        //Step 16 - 18a/18c - 19a/c
        //IF (pc_bwp_sameNumerology_upto2_FR1_TDD and band under test is FR1 TDD) or (pc_bwp_sameNumerology_upto2_FR2 and band under test is FR2)
        //THEN After 100ms from step 9 the SS indicates on PDCCH (transmitted in Downlink BWP#0 an UL DCI format 0_1 with new BWP Id BWP#1 and allocates an UL Grant, sufficient for loopback of the RLC SDU from step 9.
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_1;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_UL_SwitchIndicator := ActiveBWP_SwitchNoDCI;
      } else { //FDD
        // Step 16 - 18b/d - 19b/d
        v_BwpId_DL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_DL_DCI_IndicatorData := tsc_NR_BWP_Id_1;
        v_DL_BwpId_UL_DCI := tsc_NR_BWP_Id_Initial;
        v_BwpId_UL_DCI_IndicatorData := tsc_NR_BWP_Id_Initial;
        v_UL_SwitchIndicator := omit;
    }
    //@sic R5s240283 sic@
    v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
    //@sic  R5s230634 sic@
    f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), v_BwpId_DL_DCI, v_BwpId_DL_DCI_IndicatorData, v_DL_BwpId_UL_DCI, v_BwpId_UL_DCI_IndicatorData, v_MaxBWP, -, -, -, v_DL_SwitchIndicator, v_UL_SwitchIndicator);

    // @siclog "Step 16" siclog@
    v_TimingInfoDL_Step16 := f_TC_7_1_1_8_1_NR_GetNextSendOccasion_DL(p_NR_CellId);                            //@sic R5s230220 change 10 sic@
    v_TimingInfoConfig := f_SubFrameTiming_AddMilliSeconds(v_TimingInfoDL_Step16, 100);                        // 100ms after step 16
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL_Step16), v_SN);
    v_SN := v_SN + 1;  //@sic R5s230220 change 10 sic@

    if (not (v_IsFDD)) { //TDD
      f_NR_SS_ConfigureBWPs_DL(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoConfig), tsc_NR_BWP_Id_1, -, -, -, v_MaxBWP, omit);
    } else {
      // For FDD reconfigure DL/UL DCI BWP and prepare for the UL BWP switch with UL DCI happening in step 18
      // @sic R5s250095 sic@
      f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoConfig), tsc_NR_BWP_Id_1, tsc_NR_BWP_Id_1, tsc_NR_BWP_Id_1, tsc_NR_BWP_Id_1, v_MaxBWP, -, -, -, omit, ActiveBWP_SwitchWithDCI);
    }
    // @siclog "Step 17" siclog@
    v_TimingInfoDL_Step17 := f_SubFrameTiming_AddMilliSeconds(v_TimingInfoDL_Step16, 200);      // 200ms after step 16 @sic R5s230220 R5-231578 sic@
    v_RLC_SDU2 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL_Step17), v_SN);

    //Steps 18b/18d
    // FDD UL BWP switch from UL BWP#0 to UL BWP#1
    // SS already reconfigured
    // @sic R5-251263 R5s250095 sic@
    // @siclog "Step 18a/b/c/d" siclog@
    v_TimingInfoUL_Step18 := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL_Step17, 400);    // 400 ms from step 17 @sic R5s230220 R5-231578 R5-251263 R5s250112 R5-253074 sic@
    f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL_Step18), p_ResourceAllocationUL);

    // @siclog "Steps 19a/b/c/d-19A" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1, v_RLC_SDU2}, true, v_SN); //@sic R5-231578 R5s230220 sic@

    v_SN := v_SN + 1;
    //@sic R5-216169 R5s230220 R5s230634 R5s240283 sic@
    v_TimingInfoSS := f_NR_GetNextSendOccasion_DL(p_NR_CellId);
    if (v_BWP_SameNumerology_upto4 ) {
        f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), tsc_NR_BWP_Id_2, tsc_NR_BWP_Id_2, tsc_NR_BWP_Id_2, tsc_NR_BWP_Id_2, v_MaxBWP, -, -, -, ActiveBWP_SwitchNoDCI, ActiveBWP_SwitchNoDCI);
    } else {
        f_NR_SS_ConfigureBWPs(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoSS), tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, tsc_NR_BWP_Id_Initial, v_MaxBWP, -, -, -, ActiveBWP_SwitchNoDCI, ActiveBWP_SwitchNoDCI);
    }

    // @siclog "Step 20a/b/c/d" siclog@
    //The SS waits 1000 ms from step 18 to ensure that the bwp-InactivityTimer expired and then transmits a valid MAC PDU containing RLC PDU in the BWP with defaultDownlinkBWP-Id (= Downlink BWP#2 IF pc_bwp_sameNumerology_upto4_FR1_TDD and band under test is FR1 TDD ELSE BWP#0 IF pc_bwp_sameNumerology_upto2_FR1_TDD and band under test is FR1 TDD).
    v_TimingInfoDL_Step20 := f_SubFrameTiming_AddMilliSeconds(v_TimingInfoDL_Step17, 1600);                           // 1000ms after step 17 @sic R5s240283 R5s250095 sic@
    v_RLC_SDU1 := fl_TC_7_1_1_8_1_SendData(p_NR_CellId, p_DrbId, cs_TimingInfo_NR(v_TimingInfoDL_Step20), v_SN);

    // @siclog "Step 21" siclog@
    v_TimingInfoUL := f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingInfoDL_Step20, 100);                // 100ms after step 20
    f_NR_OneULGrantTransmission(p_NR_CellId, cs_TimingInfo_NR(v_TimingInfoUL), p_ResourceAllocationUL);

    // @siclog "Steps 22-22A" siclog@
    fl_TC_7_1_1_8_1_ReceiveData(p_NR_CellId, p_DrbId, {v_RLC_SDU1}, true, v_SN); //@sic R5-231578 R5s230220 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    //DL and UL BWP already configured on tsc_NR_BWP_Id_2/tsc_NR_BWP_Id_Initial @sic R5s230733 sic@
  }

}
