//This module contains type definitions that are common to ProSe_CoordMsg and SideLink_CoordMsg.

module ProSe_Sidelink_CoordMsg_Common {

  import from CommonDefs all;
  import from PC5_Message_TypeDefs all;

  type record length(1..3) of MatchParam_Type MatchParam_List_Type; /* @status    APPROVED (LTE_A_PRO) */

  type record MatchParam_Type { /* @status    APPROVED (LTE_A_PRO) */
    B32_Type UTC_BasedCounter,
    MIC_Type MIC1,
    MIC_Type MIC2
  };

}
