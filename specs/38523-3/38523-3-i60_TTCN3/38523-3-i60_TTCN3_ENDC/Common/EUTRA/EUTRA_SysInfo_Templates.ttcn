  };

  template (value) SystemInformationBlockType1_v1430_IEs cs_SystemInformationBlockType1_v1430_ECallOverIMS :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    eCallOverIMS_Support_r14 := true_,
    tdd_Config_v1430 := omit,
    cellAccessRelatedInfoList_r14 := omit,
    nonCriticalExtension := omit
  };

  template (value) BCCH_DL_SCH_Message cs_508_SystemInformationBlockType1_Def(template (value) PLMN_IdentityList p_PLMN_IdentityList,
                                                                              template (value) TrackingAreaCode p_TrackingAreaCode,
                                                                              template (value) CellIdentity p_CellIdentity,
                                                                              integer p_EutraBand,
                                                                              template (value) SchedulingInfoList p_SchedulingInformation,
                                                                              template (omit) TDD_Config p_TDD_Config,
                                                                              Q_Rxlevmin_Type p_Q_Rxlevmin) :=
  { /* Note: in 36.331 V8.2.0 there are no types defined for sub-structures of SystemInformationBlockType1;
       there it is currently not possible to hand over a parameter containing e.g. the scheduling info (Sib2SchedulingInfoAllSI_Type);
       @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
     //@sic R5-167569: added p_Q_Rxlevmin sic@
    message_ := {
      c1 := {
        systemInformationBlockType1 := {
          cellAccessRelatedInfo := {
            plmn_IdentityList := p_PLMN_IdentityList,
            trackingAreaCode := p_TrackingAreaCode,
            cellIdentity := p_CellIdentity,
            cellBarred := notBarred,
            intraFreqReselection := notAllowed,            /*  Cond CellBarred */
            csg_Indication := false,
            csg_Identity  := omit
          },
          cellSelectionInfo := {
            q_RxLevMin := p_Q_Rxlevmin,    // -106dB acc. to 36.508 table 4.4.3.2-3
            q_RxLevMinOffset := omit
          },
          p_Max  :=  omit,
          freqBandIndicator :=  f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicator(p_EutraBand), //@sic R5-16892 sic@
          schedulingInfoList := p_SchedulingInformation,
          tdd_Config := p_TDD_Config,
          si_WindowLength := ms20,
          systemInfoValueTag := 0,                     /* to be incremented whenever the SIB is changed */
          nonCriticalExtension :=   { // @sic R5-120616 sic@
             lateNonCriticalExtension :=  f_EUTRA_SetSystemInformationBlockType1_FreqBandIndicatorExt(p_EutraBand),  //@sic R5-165892 sic@
             nonCriticalExtension := {
                ims_EmergencySupport_r9 := true_,
                cellSelectionInfo_v920 := omit,
                nonCriticalExtension := f_EUTRA_SetSystemInformationBlockType1_Cat0_ECallOverIMS() //@sic R5-151975 R5-176132 sic@
            }
          }
        }
      }
    }
  };

  template (value) BCCH_DL_SCH_Message cds_508_SystemInformationBlockType1_QBased(template (value) PLMN_IdentityList p_PLMN_IdentityList,
                                                                                  template (value) TrackingAreaCode p_TrackingAreaCode,
                                                                                  template (value) CellIdentity p_CellIdentity,
                                                                                  integer p_EutraBand,
                                                                                  template (value) SchedulingInfoList p_SchedulingInformation,
                                                                                  template (omit) TDD_Config p_TDD_Config,
                                                                                  Q_Rxlevmin_Type p_Q_Rxlevmin)
    modifies cs_508_SystemInformationBlockType1_Def :=
  { // Content acc. to 36.508 Table 4.4.3.2-3 with condition QBASED
    //@sic R5-167569: added p_Q_Rxlevmin sic@
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        systemInformationBlockType1 := {
          nonCriticalExtension := {
            nonCriticalExtension := {
              cellSelectionInfo_v920 := {
                q_QualMin_r9 := -20,
                q_QualMinOffset_r9 := omit
              }
            }
          }
        }
      }
    }
  };

  template (value) SystemInformationBlockType1_v8h0_IEs cs_SystemInformationBlockType1_v8h0_IEs(template (omit) MultiBandInfoList p_MultiBandInfoList := omit,
                                                                                                template (omit) SystemInformationBlockType1_v9e0_IEs p_SystemInformationBlockType1_v9e0 := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    multiBandInfoList    := p_MultiBandInfoList,
    nonCriticalExtension := p_SystemInformationBlockType1_v9e0  //@sic R5s165892 sic@
  }

  template (value) SystemInformationBlockType1_v9e0_IEs cs_SystemInformationBlockType1_v9e0(template (omit) FreqBandIndicator_v9e0 p_BandExt := omit,
                                                                                            template (omit) MultiBandInfoList_v9e0 p_MFBI_BandListExt := omit,
                                                                                            template (omit) SystemInformationBlockType1_v10j0_IEs p_NonCriticalExtension := omit ) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    freqBandIndicator_v9e0 := p_BandExt,
    multiBandInfoList_v9e0 := p_MFBI_BandListExt,
    nonCriticalExtension := p_NonCriticalExtension
  };

  template (value) CIOT_EPS_OptimisationInfo_r13 cs_CIOT_EPS_OptimisationInfo_OneEntry(template (omit) UP_CIoT_EPS_Optimisation_r13_Type p_UP_CIoT_EPS_Optimisation := omit,
                                                                                      template (omit) CP_CIoT_EPS_Optimisation_r13_Type p_CP_CIoT_EPS_Optimisation := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    //@sic R5-172875 sic@
