    conditionalReconfiguration_r16 := p_ConditionalReconfiguration,
    daps_SourceRelease_r16 := p_Daps_SourceRelease,
    t316_r16 := omit,
    needForGapsConfigNR_r16 := omit,
    onDemandSIB_Request_r16 := p_OnDemandSIB_Request,
    dedicatedPosSysInfoDelivery_r16 := omit,
    sl_ConfigDedicatedNR_r16 := p_SL_ConfigDedicatedNR,
    sl_ConfigDedicatedEUTRA_Info_r16 := omit,
    targetCellSMTC_SCG_r16 := omit,
    nonCriticalExtension := p_RRCReconfiguration_v1700_IEs      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) SecurityAlgorithmConfig cs_38508_SecurityAlgorithmConfig(CipheringAlgorithm p_CipheringAlgorithm := px_NR_CipheringAlgorithm,
                                                                            template (omit) IntegrityProtAlgorithm p_IntegrityProtAlgorithm := px_NR_IntegrityProtAlgorithm) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    cipheringAlgorithm    := p_CipheringAlgorithm,
    integrityProtAlgorithm  := p_IntegrityProtAlgorithm
