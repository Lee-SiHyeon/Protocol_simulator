module SS_EncDecComponents {

  import from CommonDefs all;
  import from ComponentsType all;

  /*
   * @desc      Encodes parameter of type Components into an octetstring
   * @param     p_Components
   * @return    octetstring
   * @status    APPROVED (POS, SSNITZ)
   */
  function f_SS_EncodeComponents(template (value) Components p_Components) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_Components);
    return bit2oct(v_Bitstring);
  }

  /*
   * @desc      Decodes parameter of type octetstring into type Components
   * @param     p_EncodedComponents
   * @return    Components
   * @status    APPROVED (POS, SSNITZ)
   */
  function f_SS_ComponentsDecode(octetstring p_EncodedComponents) return Components
  {
    var Components v_ReceivedComponents;
    var bitstring v_EncodedComponents := oct2bit(p_EncodedComponents);
    var integer v_DecodeResult := decvalue(v_EncodedComponents, v_ReceivedComponents);
    
    if (v_DecodeResult != 0) {
      FatalError(__FILE__, __LINE__, "Components cannot be decoded");
    }
    return v_ReceivedComponents;
  }

}
