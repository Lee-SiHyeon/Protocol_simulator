module IMS_NR5GC_CC_SMSTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_NR5GC_CC_TestcaseImplementation_9 all;

  /*
   * @desc      REFERENCE TS 34.229-5 clause 9.1.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_9_1_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5-204482 sic@
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);
    f_IMS_NR5GC_MobileOriginatingSMS();
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 9.2.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_9_2_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5-204483 sic@
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED, IMS_Security);
    f_IMS_NR5GC_MobileTerminatingSMS();
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 9.3.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_9_3_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5-204486 sic@
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);
    f_IMS_NR5GC_MobileOriginatingConcatenatedSMS();
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 9.4.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_9_4_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5-204477 sic@
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED, IMS_Security);
    f_IMS_NR5GC_MobileTerminatingConcatenatedSMS();
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 9.5.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_9_5_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5-204478 sic@
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);
    f_IMS_NR5GC_MobileOriginatingSMS_RPError();
    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

}
