    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
      
  } // End of function f_TC_8_1_3_1_6_NR5GC

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.3.1.7
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_3_1_7_NR5GC() runs on NR5GC_PTC
