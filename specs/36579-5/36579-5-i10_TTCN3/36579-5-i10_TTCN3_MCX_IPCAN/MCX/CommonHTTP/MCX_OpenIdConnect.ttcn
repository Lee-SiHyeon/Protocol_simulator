module MCX_OpenIdConnect {

  import from CommonDefs all;
  import from IMS_CommonDefs all;
  import from JSON all;
  import from MCX_CommonDefs all;
  import from MCX_HTTP_Component all;
  import from MCX_JSON_Objects all;

  type set of charstring MCX_OpenIdConnect_ValueList_Type;                              /* @status    APPROVED (MCX) */

  type record MCX_OpenIdConnect_ValueListParameter_Type {                               /* @status    APPROVED (MCX) */
    charstring Name,
    MCX_OpenIdConnect_ValueList_Type ValueList
  };

  type NameValue_Type MCX_OpenIdConnect_ValueParameter_Type;                            /* @status    APPROVED (MCX) */

  type union MCX_OpenIdConnect_Parameter_Type {                                         /* @status    APPROVED (MCX) */
    MCX_OpenIdConnect_ValueParameter_Type     NameValue,
    MCX_OpenIdConnect_ValueListParameter_Type NameValueList
  };

  type set of MCX_OpenIdConnect_Parameter_Type MCX_OpenIdConnect_ParameterList_Type;    /* @status    APPROVED (MCX) */

  /*
   * @desc      Generate scope list to be sent to the UE
   * @param     p_ServiceType
   * @return    MCX_OpenIdConnect_ValueList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenIdConnect_ScopeList(MCX_ServiceType_Type p_ServiceType) return MCX_OpenIdConnect_ValueList_Type
  {
    var MCX_OpenIdConnect_ValueList_Type v_ValueList := { "openid" };

    select (p_ServiceType) {
      case (MCPTT) {
        v_ValueList := v_ValueList & {"3gpp:mc:ptt_service", "3gpp:mc:ptt_key_management_service", "3gpp:mc:ptt_config_management_service", "3gpp:mc:ptt_group_management_service"};
      }
      case (MCVideo) {
        v_ValueList := v_ValueList & {"3gpp:mc:video_service", "3gpp:mc:video_key_management_service", "3gpp:mc:video_config_management_service", "3gpp:mc:video_group_management_service"};
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_ValueList := v_ValueList & {"3gpp:mc:data_service", "3gpp:mc:data_key_management_service", "3gpp:mc:data_config_management_service", "3gpp:mc:data_group_management_service"};
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }
    return v_ValueList;
  }

  template (present) MCX_OpenIdConnect_Parameter_Type cr_MCX_OpenIdConnect_NameValueParameter(charstring p_Name,
                                                                                              template (present) charstring p_Value) :=
  { /* @status    APPROVED (MCX) */
    NameValue := {
      Name := p_Name,
      Value := p_Value
    }
  };

  template (present) MCX_OpenIdConnect_Parameter_Type cr_MCX_OpenIdConnect_NameValueListParameter(charstring p_Name,
                                                                                                  template (present) MCX_OpenIdConnect_ValueList_Type p_ValueList) :=
  { /* @status    APPROVED (MCX) */
    NameValueList := {
      Name := p_Name,
      ValueList := p_ValueList
    }
  };

  template (value) MCX_OpenIdConnect_Parameter_Type cs_MCX_OpenIdConnect_NameValueParameter(charstring p_Name,
                                                                                            charstring p_Value) :=
  { /* @status    APPROVED (MCX) */
    NameValue := {
      Name := p_Name,
      Value := p_Value
    }
  };

  template (value) MCX_OpenIdConnect_Parameter_Type cs_MCX_OpenIdConnect_NameValueListParameter(charstring p_Name,
                                                                                                MCX_OpenIdConnect_ValueList_Type p_ValueList) :=
  { /* @status    APPROVED (MCX) */
    NameValueList := {
      Name := p_Name,
      ValueList := p_ValueList
    }
  };

  template (present) MCX_OpenIdConnect_ParameterList_Type cr_MCX_OpenIdConnect_AuthenticationRequest(MCX_ServiceType_Type p_ServiceType,
                                                                                                     charstring p_RedirectURI,
                                                                                                     charstring p_ClientId) :=
  { /* Authentication Request (36.579-1 Table 5.5.4.10.1-1 */
    /* @status    APPROVED (MCX) */
    cr_MCX_OpenIdConnect_NameValueParameter("response_type", "code"),
    cr_MCX_OpenIdConnect_NameValueParameter("client_id", p_ClientId),
    cr_MCX_OpenIdConnect_NameValueListParameter("scope", superset(all from f_MCX_OpenIdConnect_ScopeList(p_ServiceType))),
    cr_MCX_OpenIdConnect_NameValueParameter("redirect_uri", p_RedirectURI),
    cr_MCX_OpenIdConnect_NameValueParameter("state", ?),
    cr_MCX_OpenIdConnect_NameValueParameter("acr_values", "3gpp:acr:password"),
    cr_MCX_OpenIdConnect_NameValueParameter("code_challenge", ?),
    cr_MCX_OpenIdConnect_NameValueParameter("code_challenge_method", "S256"),
    *       // @sic R5-232215: 33.180 B.4.2.2 specifies that "Other parameters defined by the OpenID Connect specification are optional" for the Authentication request sic@
  };

  template (value) MCX_OpenIdConnect_ParameterList_Type cs_MCX_OpenIdConnect_AuthenticationResponse(charstring p_State,
                                                                                                    charstring p_Code) :=
  { /* Authentication Response (36.579-1 Table 5.5.4.10.2-1) */
    /* @status    APPROVED (MCX) */
    cs_MCX_OpenIdConnect_NameValueParameter("code", p_Code),
    cs_MCX_OpenIdConnect_NameValueParameter("state", p_State)
  };

  template (present) MCX_OpenIdConnect_ParameterList_Type cr_MCX_OpenIdConnect_TokenRequest(charstring p_Code,
                                                                                            charstring p_ClientId,
                                                                                            charstring p_RedirectURI) :=
  { /* Token Request (36.579-1 Table 5.5.4.10.3-1) */
    /* @status    APPROVED (MCX) */
    cr_MCX_OpenIdConnect_NameValueParameter("grant_type", "authorization_code"),
    cr_MCX_OpenIdConnect_NameValueParameter("code", p_Code),
    cr_MCX_OpenIdConnect_NameValueParameter("client_id", p_ClientId),
    cr_MCX_OpenIdConnect_NameValueParameter("redirect_uri", p_RedirectURI),
    cr_MCX_OpenIdConnect_NameValueParameter("code_verifier", ?)
  };

  template (value) JSON.Object.memberList cs_MCX_OpenIdConnect_TokenResponse(charstring p_AccessToken,
                                                                                  charstring p_RefreshToken,
                                                                                  charstring p_IdToken) :=
  { /* Token Response (36.579-1 Table 5.5.4.10.4-1) */
    /* @status    APPROVED (MCX) */
    cs_JSON_ObjectMember_String("access_token", p_AccessToken),
    cs_JSON_ObjectMember_String("refresh_token", p_RefreshToken),
    cs_JSON_ObjectMember_String("id_token", p_IdToken),
    cs_JSON_ObjectMember_String("token_type", "Bearer"),
    cs_JSON_ObjectMember_String("expires_in",  "7199")
  };

  /*
   * @desc      Get value of the NameValue parameter with given name
   * @param     p_ParameterList
   * @param     p_Name
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_GetParameter(MCX_OpenIdConnect_ParameterList_Type p_ParameterList,
                                     charstring p_Name) runs on MCX_HTTP_PTC return charstring
  {
    var integer i;

    for (i := 0; i < lengthof(p_ParameterList); i := i + 1) {
      if (ischosen(p_ParameterList[i].NameValue)) {
        if (p_ParameterList[i].NameValue.Name == p_Name) {
          return p_ParameterList[i].NameValue.Value;
        }
      }
    }
    f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "no name/value parameter found for given name");
    return "";
  }

  /*
   * @desc      decode and check OpenId Connect parameters which may be part of a URI or the message body of a HTTP GET or POST
   *            (-> https://openid.net/specs/openid-connect-core-1_0.html and 33.180 B.4.2)
   * @param     p_Parameters
   * @param     p_QueryList
   * @return    MCX_OpenIdConnect_ParameterList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_DecodeAndCheckQueryParameters(charstring p_Parameters,
                                                      template (present) MCX_OpenIdConnect_ParameterList_Type p_QueryList) runs on MCX_HTTP_PTC return MCX_OpenIdConnect_ParameterList_Type
  {
    var template (value) MCX_OpenIdConnect_Parameter_Type v_Parameter;
    var MCX_OpenIdConnect_ParameterList_Type v_OpenIdParameterList := {};
    var Char1List_Type v_Separator := {"&"};
    var CharStringList_Type v_ParameterList := f_StringSplit(p_Parameters, v_Separator);
    var CharStringList_Type v_CharStringList;
    var MCX_OpenIdConnect_ValueList_Type v_ScopeList;
    var charstring v_Name;
    var charstring v_Value;
    var integer i;
    var integer k;
    var integer l;
    var integer n := 0;

    for (i := 0; i < lengthof(v_ParameterList); i := i + 1) {
      v_Separator := {"="};
      v_CharStringList := f_StringSplit(v_ParameterList[i], v_Separator);
      v_Name := v_CharStringList[0];
      if (lengthof(v_CharStringList) != 2) {
        f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid OAuth 2.0 request parameter");
      }
      v_Value := f_URL_Decoding(v_CharStringList[1]);
      select (v_Name) {
        case ("scope") {
          l := 0;
          v_Separator := {" "};
          v_CharStringList := f_StringSplit(v_Value, v_Separator);
          for (k := 0; k < lengthof(v_CharStringList); k := k + 1) {
            v_Value := v_CharStringList[k];
            if (v_Value != "") {
              v_ScopeList[l] := v_Value;
              l := l + 1;
            }
          }
          v_Parameter := cs_MCX_OpenIdConnect_NameValueListParameter(v_Name, v_ScopeList);
        }
        case else {
          v_Parameter := cs_MCX_OpenIdConnect_NameValueParameter(v_Name, v_Value);
        }
      }
      v_OpenIdParameterList[n] := valueof(v_Parameter);
      n := n + 1;
    }
    if (not match(v_OpenIdParameterList, p_QueryList)) {
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid query");
    }
    return v_OpenIdParameterList;
  }

  /*
   * @desc      decode and check URI with OpenId Connect parameters
   * @param     p_UriString
   * @param     p_URI
   * @param     p_QueryList
   * @return    MCX_OpenIdConnect_ParameterList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_DecodeAndCheckURI(charstring p_UriString,
                                          template (present) charstring p_URI,
                                          template (present) MCX_OpenIdConnect_ParameterList_Type p_QueryList) runs on MCX_HTTP_PTC return MCX_OpenIdConnect_ParameterList_Type
  {
    var Char1List_Type v_Separator := {"?"};
    var CharStringList_Type v_CharStringList := f_StringSplit(p_UriString, v_Separator);
    var charstring v_URI := v_CharStringList[0];

    if (not match(v_URI, p_URI)) {
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid URI");
    }
    if (lengthof(v_CharStringList) != 2) {
      f_MCX_HTTP_SetVerdictFailOrInconc(__FILE__, __LINE__, "missing parameters");
    }

    return f_MCX_OpenID_DecodeAndCheckQueryParameters(v_CharStringList[1], p_QueryList);
  }

  /*
   * @desc      decode and check message body containing OpenId Connect parameters
   * @param     p_MessageBody
   * @param     p_QueryList
   * @return    MCX_OpenIdConnect_ParameterList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_DecodeAndCheckMessageBody(charstring p_MessageBody,
                                                  template (present) MCX_OpenIdConnect_ParameterList_Type p_QueryList) runs on MCX_HTTP_PTC return MCX_OpenIdConnect_ParameterList_Type
  {
    return f_MCX_OpenID_DecodeAndCheckQueryParameters(p_MessageBody, p_QueryList);
  }

  /*
   * @desc      encode OpenId Connect parameters
   * @param     p_ParameterList
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_EncodeParameters(template (value) MCX_OpenIdConnect_ParameterList_Type p_ParameterList) return charstring
  {
    var MCX_OpenIdConnect_Parameter_Type v_Parameter;
    var MCX_OpenIdConnect_ValueList_Type v_ValueList;
    var CharStringList_Type v_CharStringList1;
    var CharStringList_Type v_CharStringList2;
    var charstring v_Name;
    var charstring v_Value;
    var integer i;
    var integer k;

    for (i := 0; i < lengthof(p_ParameterList); i := i + 1) {
      v_Parameter := valueof(p_ParameterList[i]);
      select union (v_Parameter) {
        case (NameValueList) {
          v_Name := v_Parameter.NameValueList.Name;
          v_ValueList := v_Parameter.NameValueList.ValueList;
          for (k := 0; k < lengthof(v_ValueList); k := k + 1) { v_CharStringList2[k] := v_ValueList[k]; } // convert "set of" into "record of"
          v_Value := f_StringJoin(v_CharStringList2);
        }
        case else {
          v_Name := v_Parameter.NameValue.Name;
          v_Value := v_Parameter.NameValue.Value;
        }
      }
      v_CharStringList1[i] := v_Name & "=" & f_URL_Encoding(v_Value);
    }
    return f_StringJoin(v_CharStringList1, "&");
  }

  /*
   * @desc      encode URI containing OpenId Connect parameters
   * @param     p_URI
   * @param     p_ParameterList
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_OpenID_EncodeURI(charstring p_URI,
                                  template (value) MCX_OpenIdConnect_ParameterList_Type p_ParameterList) return charstring
  {
    var CharStringList_Type v_CharStringList;
    v_CharStringList[0] := p_URI;
    v_CharStringList[1] := f_MCX_OpenID_EncodeParameters(p_ParameterList);
    return f_StringJoin(v_CharStringList, "?");
  }

}
