    ulTFCS               := p_UlTfcs,
    dlconnectedTrCHList  := p_DlconnectedTrCHList,
    dlTFCS               := p_DlTfcs,
    hsDSCHMacdFlows      := p_HsDSCHMacdFlows,
    e_DCHMacdFlows       := p_E_DCHMacdFlows,
    ehs_DSCH_Flows       := p_Ehs_DSCH_Flows,
    ehs_DSCH_CommonFlows := p_Ehs_DSCH_CommonFlows,
    e_DCHMacd_CommonFlows := omit,
    ehs_DSCH_Flows_r9     := omit,  // @sic R5s110176 Baseline Moving sic@
    relAspTypeExtension := omit // @sic R5-130613 sic@
  };

