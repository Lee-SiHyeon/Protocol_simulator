module Base64Encoding {


  const charstring tsc_Base64IndexTable := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  const charstring tsc_Base64urlIndexTable := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";  /* @status    APPROVED (MCX) */

  /*
   * @desc      Convert a bitstring into its Base64 representation (see RFC 4648)
   *            Adapted from Java Base64 implementation in en.wikibooks.org
   * @param     p_Bitstring
   * @param     p_Base64Table
   * @param     p_AddPadding        (default value: true)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_Base64EncodeCommon(bitstring p_Bitstring,
                                 charstring p_Base64Table,
                                 boolean p_AddPadding := true) return charstring
  {
    var octetstring v_Octetstring := bit2oct(p_Bitstring); // String to be encoded
    var bitstring v_Bitstring;
    var charstring v_Resultstring := "";
    var charstring v_Padding := ""; // Padding
    var integer v_Idx;
    var integer i;

    // Add right zero pad to make string a multiple of 3 characters
    for (i := 0; i < lengthof(v_Octetstring) mod 3; i := i + 1) {
      /* NOTE: code is confusing here as lengthof(v_Octetstring) increases for each loop; nevertheless it result is
       *       - no padding       for lengthof(v_Octetstring) mod 3 == 0 at the beginning
       *       - 2 bytes padding  for lengthof(v_Octetstring) mod 3 == 1 at the beginning
       *       - 1 byte padding   for lengthof(v_Octetstring) mod 3 == 2 at the beginning
       *       => as expected */
      v_Padding := v_Padding & "=";
      v_Octetstring := v_Octetstring & '00'O;
    }
    // Run over the bitstring
    v_Bitstring := oct2bit(v_Octetstring);
    for (i := 0; i < lengthof(v_Bitstring) / 6; i := i + 1) {
      v_Idx := bit2int(substr(v_Bitstring, i*6, 6));
      v_Resultstring := v_Resultstring & p_Base64Table[v_Idx];
    }
    // Now return result considering padding
    v_Resultstring := substr(v_Resultstring, 0, (lengthof(v_Resultstring) - lengthof(v_Padding)));
    if (p_AddPadding) {
      v_Resultstring := v_Resultstring & v_Padding;
    }
    return v_Resultstring;
  }

  /*
   * @desc      Wrapper function for 'normal' Base64 encoding (i.e. with padding)
   * @param     p_Bitstring
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_Base64Encode(bitstring p_Bitstring) return charstring
  {
    return fl_Base64EncodeCommon(p_Bitstring, tsc_Base64IndexTable);
  }

  /*
   * @desc      Wrapper function for Base64 encoding without padding
   * @param     p_Bitstring
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_Base64urlEncode(bitstring p_Bitstring) return charstring
  {
    var boolean v_AddPadding := false;
    return fl_Base64EncodeCommon(p_Bitstring, tsc_Base64urlIndexTable, v_AddPadding);
  }

  /*
   * @desc      decode base64-encoded string; the string may or may not be padded
   *            Assumption: input string is not a concatenation of padded bitstrings (i.e. does not contain padding somewhere in the middle)
   * @param     p_Base64EncodedString
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_Base64Decode(charstring p_Base64EncodedString) return bitstring
  {
    var charstring v_Base64IndexTable := tsc_Base64IndexTable;
    var integer v_Strlen := lengthof(p_Base64EncodedString);
    var bitstring v_Bitstring := ''B;
    var bitstring v_BinaryValue;
    var integer v_BitStrlen;
    var integer i;
    var integer k;

    if (v_Strlen > 0) {
      // remove padding
      while (p_Base64EncodedString[v_Strlen - 1] == "=") {
        v_Strlen := v_Strlen - 1;
      }
      // decode character by character
      for (i := 0; i < v_Strlen; i := i + 1) {
        v_BinaryValue := ''B;    // for the case that a character is not in the table (e.g. blank, \n ...)
        for (k := 0; k < lengthof(v_Base64IndexTable); k := k + 1) {
          if (p_Base64EncodedString[i] == v_Base64IndexTable[k]) {
            v_BinaryValue := int2bit(k, 6);
            break;
          }
        }
        v_Bitstring := v_Bitstring & v_BinaryValue;
      }
      // cut bitstring to its length
      v_BitStrlen := ((v_Strlen * 6) / 8) * 8;
      v_Bitstring := substr(v_Bitstring, 0, v_BitStrlen);
    }
    return v_Bitstring;
  }

}
