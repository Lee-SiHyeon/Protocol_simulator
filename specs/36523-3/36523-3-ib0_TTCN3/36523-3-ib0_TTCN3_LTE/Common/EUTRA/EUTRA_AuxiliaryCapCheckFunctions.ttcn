  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of ss-CCH-InterfHandl for Dual Mode capable Rel-11 and above UEs
   * @param     p_ReceivedCapabilityMsg         ..  received ueCapabilitiesRAT-Container
   * @status    APPROVED (LTE)
   */
  function fl_Check_ss_CCH_InterfHandl(UE_EUTRA_Capability p_ReceivedCapabilityMsg)
  {  // @sic R5s170738, R5-180721 sic@
    var boolean v_Ss_CCH_Interference_Handling_Common := false;
    var boolean v_Ss_CCH_Interference_Handling_FDD := false;
    var boolean v_Ss_CCH_Interference_Handling_TDD := false;
    var UE_EUTRA_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var PhyLayerParameters_v1130 v_PhyLayerParameters_v1130;
    var PhyLayerParameters_v1130 v_FDD_Add_UE_EUTRA_Capabilities_v1130;
    var PhyLayerParameters_v1130 v_TDD_Add_UE_EUTRA_Capabilities_v1130;
    
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.phyLayerParameters_v1130)) {
      v_PhyLayerParameters_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.phyLayerParameters_v1130;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.fdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130)) {
      v_FDD_Add_UE_EUTRA_Capabilities_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.fdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.tdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130)) {
      v_TDD_Add_UE_EUTRA_Capabilities_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.tdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130;
    }
    
    if(pc_ss_CCH_Interference_Handling) {
      // check indication of common IE
      if (ispresent(v_PhyLayerParameters_v1130.ss_CCH_InterfHandl_r11)){
          v_Ss_CCH_Interference_Handling_Common := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_EUTRA_Capabilities_v1130.ss_CCH_InterfHandl_r11)){
          v_Ss_CCH_Interference_Handling_FDD := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_EUTRA_Capabilities_v1130.ss_CCH_InterfHandl_r11)){
          v_Ss_CCH_Interference_Handling_TDD := true;
      }
      // common IE indicated as well as FDD or TDD IE  ?
      if ((v_Ss_CCH_Interference_Handling_Common == true) and ((v_Ss_CCH_Interference_Handling_FDD == true) or (v_Ss_CCH_Interference_Handling_TDD == true))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_ss_CCH_Interference_Handling inconsistent with reported capabilities for Rel-11 and above UE");
      }
      // common IE not indicated and both FDD and TDD IE have the same value ?
      if ((v_Ss_CCH_Interference_Handling_Common == false) and ((v_Ss_CCH_Interference_Handling_FDD == true) and(v_Ss_CCH_Interference_Handling_TDD == true) or
                                                                (v_Ss_CCH_Interference_Handling_FDD == false) and (v_Ss_CCH_Interference_Handling_TDD == false))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_ss_CCH_Interference_Handling to true is inconsistent with reported capabilities for Rel-11 and above UE");
      }
    }
    else {  // the whole IE is missing or the IE inside is omitted
      if (((ispresent(v_PhyLayerParameters_v1130.ss_CCH_InterfHandl_r11))) or
          ((ispresent(v_FDD_Add_UE_EUTRA_Capabilities_v1130.ss_CCH_InterfHandl_r11))) or
          ((ispresent(v_TDD_Add_UE_EUTRA_Capabilities_v1130.ss_CCH_InterfHandl_r11)))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_ss_CCH_Interference_Handling to false is inconsistent with reported capabilities for Rel-11 and above UE"); // @sic R5s190011 sic@
      }
    }
  }

  /*
   * @desc      Function to check the UECapabilitymessage against the setting of the PICS declaring the support of crs-InterfHandl-r11 for Dual Mode capable Rel-11 and above UEs
   * @param     p_ReceivedCapabilityMsg         ..  received ueCapabilitiesRAT-Container
   * @status    APPROVED (LTE)
   */
  function fl_Check_crs_InterfHandl_r11(UE_EUTRA_Capability p_ReceivedCapabilityMsg)
  { // @sic R5-182799 sic@
    var boolean v_Crs_InterfHandl_r11_Common := false;
    var boolean v_Crs_InterfHandl_r11_FDD := false;
    var boolean v_Crs_InterfHandl_r11_TDD := false;
    var UE_EUTRA_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var PhyLayerParameters_v1130 v_PhyLayerParameters_v1130;
    var PhyLayerParameters_v1130 v_FDD_Add_UE_EUTRA_Capabilities_v1130;
    var PhyLayerParameters_v1130 v_TDD_Add_UE_EUTRA_Capabilities_v1130;
    
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.phyLayerParameters_v1130)) {
      v_PhyLayerParameters_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.phyLayerParameters_v1130;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.fdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130)) {
      v_FDD_Add_UE_EUTRA_Capabilities_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.fdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130;
    }
    if (ispresent(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.tdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130)) {
      v_TDD_Add_UE_EUTRA_Capabilities_v1130 := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.tdd_Add_UE_EUTRA_Capabilities_v1130.phyLayerParameters_v1130;
    }
        
    if(pc_CRS_Interference_Handling) {
      // check indication of common IE
      if (ispresent(v_PhyLayerParameters_v1130.crs_InterfHandl_r11)){
          v_Crs_InterfHandl_r11_Common := true;
      }
      // check indication of FDD IE
      if (ispresent(v_FDD_Add_UE_EUTRA_Capabilities_v1130.crs_InterfHandl_r11)){
          v_Crs_InterfHandl_r11_FDD := true;
      }
      // check indication of TDD IE
      if (ispresent(v_TDD_Add_UE_EUTRA_Capabilities_v1130.crs_InterfHandl_r11)){
          v_Crs_InterfHandl_r11_TDD := true;
      }
      // common IE indicated as well as FDD or TDD IE  ?
      if ((v_Crs_InterfHandl_r11_Common == true) and ((v_Crs_InterfHandl_r11_FDD == true) or (v_Crs_InterfHandl_r11_TDD == true))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_crs_InterfHandl_r11 inconsistent with reported capabilities for Rel-11 and above UE");
      }
      // common IE not indicated and both FDD and TDD IE have the same value ?
      if ((v_Crs_InterfHandl_r11_Common == false) and ((v_Crs_InterfHandl_r11_FDD == true) and(v_Crs_InterfHandl_r11_TDD == true) or
                                                                (v_Crs_InterfHandl_r11_FDD == false) and (v_Crs_InterfHandl_r11_TDD == false))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_crs_InterfHandl_r11 to true is inconsistent with reported capabilities for Rel-11 and above UE");
      }
    }
    else {  // the whole IE is missing or the IE inside is omitted
      if (((ispresent(v_PhyLayerParameters_v1130.crs_InterfHandl_r11))) or
          ((ispresent(v_FDD_Add_UE_EUTRA_Capabilities_v1130.crs_InterfHandl_r11))) or
          ((ispresent(v_TDD_Add_UE_EUTRA_Capabilities_v1130.crs_InterfHandl_r11)))) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_crs_InterfHandl_r11 to false is inconsistent with reported capabilities for Rel-11 and above UE"); // @sic R5s190011 sic@
      }
    }
  }

  /*
   * @desc      IE freqBandPriorityAdjustment-r12 of rf_Parameters_v1250 must be supported if pc_freqBandPriorityAdjustment
   * @return    template RF_Parameters_v1250
   * @status    APPROVED (LTE)
   */
  function f_Derive_RF_Parameters_v1250() return template RF_Parameters_v1250
  { // @sic R5-169038, R5s190011 sic@
    var template RF_Parameters_v1250 v_RF_Parameters_v1250 := *;

    v_RF_Parameters_v1250 := {
      supportedBandListEUTRA_v1250 := *,
      supportedBandCombination_v1250 := *,
      supportedBandCombinationAdd_v1250 := *,
      freqBandPriorityAdjustment_r12 := supported
    }
    
    if (pc_freqBandPriorityAdjustment) {
      return v_RF_Parameters_v1250;
    }
    else {
      v_RF_Parameters_v1250.freqBandPriorityAdjustment_r12 := omit;
      return v_RF_Parameters_v1250 ifpresent;
    };
  }

  /*
   * @desc      IE freqBandPriorityAdjustment-r12 of measParameters_v1250 must be supported if pc_CSI-RS_DS_Meas
   * @return    template MeasParameters_v1250
   * @status    APPROVED (LTE)
   */
  function f_Derive_MeasParameters_v1250() return template MeasParameters_v1250
  { // @sic R5-169038, R5s190011 sic@
    var template MeasParameters_v1250 v_MeasParameters_v1250 := *;

    v_MeasParameters_v1250 := {
      timerT312_r12 := *,
      alternativeTimeToTrigger_r12 := *,
      incMonEUTRA_r12 := *,
      incMonUTRA_r12 := *,
      extendedMaxMeasId_r12 := *,
      extendedRSRQ_LowerRange_r12 := *,
      rsrq_OnAllSymbols_r12 := *,
      crs_DiscoverySignalsMeas_r12 := *,
      csi_RS_DiscoverySignalsMeas_r12 := supported
    }

    if (pc_CSI_RS_DS_Meas) {
      return v_MeasParameters_v1250;
    }
    else {
      v_MeasParameters_v1250.csi_RS_DiscoverySignalsMeas_r12 := omit;
      return v_MeasParameters_v1250 ifpresent;
    };
  }

  /*
   * @desc      IE extendedLongDRX_r13 of MAC_Parameters_v1310 must be supported if pc_extendedLongDRX is supported
   * @return    template MAC_Parameters_v1310
   * @status    APPROVED (LTE)
   */
  function f_Derive_MAC_Parameters_v1310 () return template MAC_Parameters_v1310
  { // @sic R5-166324, R5s190011 sic@
    var template MAC_Parameters_v1310 v_MAC_Parameters_v1310 := *;
    
    v_MAC_Parameters_v1310 := {
      extendedMAC_LengthField_r13 := *,
      extendedLongDRX_r13 := supported
    }

    if (pc_extendedLongDRX) {
      return v_MAC_Parameters_v1310;
    }
    else {
      v_MAC_Parameters_v1310.extendedLongDRX_r13 := omit;
      return v_MAC_Parameters_v1310 ifpresent;
    };
  }

  /*
   * @desc      IE rssi_AndChannelOccupancyReporting_r13 of measParameters_v1310 must be supported if pc_rssiAndChannelOccupancyReporting
   * @return    template MeasParameters_v1310
   * @status    APPROVED (LTE)
   */
  function f_Derive_MeasParameters_v1310 () return template MeasParameters_v1310
  { // @sic R5-166324, R5s190011 sic@
    var template MeasParameters_v1310 v_MeasParameters_v1310 := *;
    
    v_MeasParameters_v1310 := {
      rs_SINR_Meas_r13 := *,
      allowedCellList_r13 := *,   /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      extendedMaxObjectId_r13 := *,
      ul_PDCP_Delay_r13 := *,
      extendedFreqPriorities_r13 := *,
      multiBandInfoReport_r13 := *,
      rssi_AndChannelOccupancyReporting_r13 := supported
    }

    if (pc_rssiAndChannelOccupancyReporting) { // @sic R5-169038 sic@
      return v_MeasParameters_v1310;
    }
    else {
      v_MeasParameters_v1310.rssi_AndChannelOccupancyReporting_r13 := omit;
      return v_MeasParameters_v1310 ifpresent;
    };
  }

  /*
   * @desc      ce_ModeA_r13 must be supported if pc_CEmodeA
   * @return    template CE_ModeA_r13_Type
   * @status    APPROVED (LTE)
   */
  function f_Derive_ce_ModeA_r13() return template CE_ModeA_r13_Type
  { // @sic R5-172832, R5s190011 sic@
    if (pc_CEmodeA) {
      return supported;
    } else {
      return omit;
    }
  }

  /*
   * @desc      ce_ModeB_r13 must be supported if pc_CEmodeB
   * @return    template CE_ModeB_r13_Type
   * @status    APPROVED (LTE)
   */
  function f_Derive_ce_ModeB_r13() return template CE_ModeB_r13_Type
  { // @sic R5-172832, R5s190011 sic@
    if (pc_CEmodeB) {
      return supported;
    } else {
      return omit;
    }
  }

  /*
   * @desc      CE_Parameters_r13 must be supported if pc_CEmodeA or pc_CEmodeB is supported
   * @return    template CE_Parameters_r13
   * @status    APPROVED (LTE)
   */
  function f_Derive_CE_Parameters_r13() return template CE_Parameters_r13
  { // @sic R5-172832, R5s190011 sic@
    var template CE_Parameters_r13 v_CE_Parameters_r13 := *;

    v_CE_Parameters_r13 := {
      ce_ModeA_r13 := f_Derive_ce_ModeA_r13(),
      ce_ModeB_r13 := f_Derive_ce_ModeB_r13()
    }

    if (pc_CEmodeA or pc_CEmodeB) {
      return v_CE_Parameters_r13;
    }
    else {
      return v_CE_Parameters_r13 ifpresent;
    }
  }

  /*
