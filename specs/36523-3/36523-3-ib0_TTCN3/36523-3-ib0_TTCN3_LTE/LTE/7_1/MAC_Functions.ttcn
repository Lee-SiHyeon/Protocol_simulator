  /*
   * @desc      Function to Config SS to use a sub set of DL HARQ process
   * @param     p_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_HarqProcessList
   * @status    APPROVED (LTE)
   */
