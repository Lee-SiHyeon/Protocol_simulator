module SideLink_CommonFunctions {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_NB_ASP_L2DataDefs all;
  import from EUTRA_NB_ASP_TypeDefs all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_SideLink_Common all;
  import from SideLinkUE_ASP_TypeDefs all;
  import from SideLink_Component all;
  import from SideLink_CoordMsg all;
  import from SidelinkUE_Common_TypeDefs all;

  const B24_Type tsc_SSUE_GroupId := '100000000000000000000001'B;  /* Acc to 36.508 cl 4.9.3 with a different UE Id as it is SS-UE Id
                                                                    @status    APPROVED (LTE_A_PRO) */

  const SLRB_Identity_Type tsc_SLRB1 := 1;   /* @status    APPROVED (LTE_A_PRO) */

  const B5_Type   tsc_SLRB_LCID := '00001'B; /* @status    APPROVED (LTE_A_PRO) */

  const AbsoluteCellPower_Type tsc_SS_UE_Serving := -85;  /* Acc to 36.508 Table 6.2.2.3-1
                                                          @status    APPROVED (LTE_A_PRO) */

  const Attenuation_Type tsc_CellAttenuation_On := {Value:=0}; /* @status    APPROVED (LTE_A_PRO) */

  const integer tsc_STCH_PacSize  := 300; /* @status    APPROVED (LTE_A_PRO) */

  template (value) SL_SCH_Config_Type cs_SL_SCH_Config (B24_Type p_SSUE_GroupId := tsc_SSUE_GroupId) :=
  { //@sic R5w170205 sic@
    /* @status    APPROVED (LTE_A_PRO) */
    SS_UE_Layer2Id := p_SSUE_GroupId
  };

    template (value) STCH_Config_Type cs_STCH_Config(template (omit) B24_Type p_UE_GroupId := tsc_UE_GroupId) :=
  { /* RLC PDCP configuration */
    /* @status    APPROVED (LTE_A_PRO) */
    SLRB := tsc_SLRB1,
    SL_RBIDConfig := {
      AddOrReconfigure := {
        Rlc := { //Normal test mode
          Layer2Id := p_UE_GroupId,
          LCID := tsc_SLRB_LCID
        },
        Pdcp := cs_PDCP_SLRB_Def //@sic R5w170205 sic@
      }
    }
  };

  template (value) SL_PDCP_ConfigInfo_Type cs_PDCP_SLRB_Def :=
  { /* @status    APPROVED (LTE_A_PRO) */
    SlRb   :=  {
      headerCompression := omit // 36.508 cl 6.8.1 - ROHC compression is not applied in the signalling test cases simulating in coverage and out-of-coverage scenarios.
    },
    TestMode := {
      None := true   //This template is not to be used for PDCP testing
    }
  };

  template (value) SS_UE_ConfigInfo_Type cs_SS_UE_Config(template (omit) SS_UE_CoverageSynchronisation_Type p_SSUE_ProSeCoverage,
                                                         template (omit) CommConfig_Type p_CommConfig := omit,
                                                         template (omit) DiscConfig_Type p_DiscConfig := omit,
                                                         AbsoluteCellPower_Type p_AbsoluteCellPower := tsc_SS_UE_Serving,
                                                         template (omit) V2X_CommConfig_Type p_V2X_CommConfig := omit,
                                                         Attenuation_Type p_Attenuation := tsc_CellAttenuation_On
                                                         ) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    SS_UE_CoverageSynchronisation := p_SSUE_ProSeCoverage, //@sic R5w170205 sic@
    Power := {
      MaxReferencePower := p_AbsoluteCellPower,
      Attenuation := p_Attenuation // Initial attenuation: ON
    },
    DiscConfig := p_DiscConfig,
    CommConfig := p_CommConfig,
    V2X_CommConfig := p_V2X_CommConfig
  };

  template (value) SL_RoutingInfo_Type cs_SL_RoutingInfo_None :=
  { /* @status    APPROVED (LTE_A_PRO) */
    None := true
  };

  template (present) SL_RoutingInfo_Type cr_SL_RoutingInfo_None :=
  { /* @status    APPROVED (LTE_A_PRO) */
    None := true
  };

  template (value) SL_ReqAspCommonPart_Type cs_SSUE_ReqAspCommonPart(SS_UE_Id_Type p_SSUE_Id,
                                                                     template (value) SL_RoutingInfo_Type p_SL_RoutingInfo,
                                                                     template (value) SL_TimingInfo_Type p_SL_TimingInfo,
                                                                     boolean p_CnfFlag := false) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    SS_UE_Id := p_SSUE_Id,
    RoutingInfo := p_SL_RoutingInfo,
    TimingInfo := p_SL_TimingInfo,
    ControlInfo := {
      CnfFlag      := p_CnfFlag,
      FollowOnFlag := false
    }
  };

  template (value) SL_TimingInfo_Type cs_TimingIC_Now := /* @status    APPROVED (LTE_A_PRO) */
  { // Incoverage - Now
    InCoverageTiming := cs_TimingInfo_Now
  };

  template (value) SL_TimingInfo_Type cs_TimingOC_Now := /* @status    APPROVED (LTE_A_PRO) */
  { // Incoverage - Now
    OutOfCoverageTiming := { Now := true }
  };

  template (value) SS_UE_TimingInfo_Type cs_TimingInfo_SSUE1_Def := /* @status    APPROVED (LTE_A_PRO) */
  { //Offset 0
    DSubframeOffset := 0,
    DfnOffset := 0
  };

  template (value) SS_UE_CoverageSynchronisation_Type cs_SSUE_OoC_Common(template (value) ARFCN_ValueEUTRA_r9 p_CarrierFreq_r12,
                                                               template (value) SL_Bandwidth_Type   p_Bandwidth,
                                                               template (value) SS_UE_TimingInfo_Type p_SS_UE_TimingInfo) := /* @status    APPROVED (LTE_A_PRO) */
  { // @sic R5w170205 sic@
    OutOfCoverage := {
      CarrierFreq_r12 := p_CarrierFreq_r12,
      SL_bandwidth_r12 := p_Bandwidth,
      TDD_ConfigSL_r12 := cs_TDD_ConfigSL_FDD,
      SS_UE_TimingInfo := p_SS_UE_TimingInfo
    }
  };

  template (value) SS_UE_CoverageSynchronisation_Type cs_SSUE_IC(CellInCoverageInfo_Type p_CellInCoverageInfo) := /* @status    APPROVED (LTE_A_PRO) */
  { // @sic R5w170205 sic@
    InCoverage := { //@sic R5w160202 sic@
        UL_CarrierFreq := p_CellInCoverageInfo.UL_CarrierFreq,
        UL_bandwidth := p_CellInCoverageInfo.UL_Bandwidth,
        TDD_Config := p_CellInCoverageInfo.TDD_Config,  /* omitted for FDD */
        CellTimingInfo := p_CellInCoverageInfo.CellTimingInfo
    }
  };

  template (value) SS_UE_CoverageSynchronisation_Type cs_SSUE_UTC(OutOfCoverageInfo_Type p_OutOfCoverageInfo) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    UTC_Synchronised := {
        CarrierFreq_r12 := p_OutOfCoverageInfo.CarrierFreq_r12,
        SL_bandwidth_r12 := f_ConvertBandwidth_ToSL_Type(p_OutOfCoverageInfo.Ul_Bandwidth),
        TDD_ConfigSL_r12 := cs_TDD_ConfigSL_FDD, //FDD only
        OffsetDFN_r14 := omit
    }
  };

  template (value) SL_ReqAspCommonPart_Type cs_SSUE_ReqAspCommonPart_Cfg(SS_UE_Id_Type p_SSUE_Id,
                                                                         template (value) SL_TimingInfo_Type p_SL_TimingInfo,
                                                                         boolean p_CnfFlag := false
                                                                         ) :=
   /* @status    APPROVED (LTE_A_PRO) */
    cs_SSUE_ReqAspCommonPart(p_SSUE_Id, cs_SL_RoutingInfo_None, p_SL_TimingInfo, p_CnfFlag);

  template (value) SL_SYSTEM_CTRL_REQ cas_SSUE_Config(SS_UE_Id_Type p_SSUE_Id,
                                                      template (value) SL_TimingInfo_Type p_SL_TimingInfo,
                                                      template (value) SS_UE_ConfigInfo_Type p_SS_UE_ConfigInfo_Type,
                                                      boolean p_CnfFlag := false
                                                      ) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    Common := cs_SSUE_ReqAspCommonPart_Cfg(p_SSUE_Id, p_SL_TimingInfo, p_CnfFlag),
    Request := {
      SS_UE_Config := {
        AddOrReconfigure := p_SS_UE_ConfigInfo_Type
      }
    }
  };

  template (value) SL_SYSTEM_CTRL_REQ cas_SSUE_Release_REQ(SS_UE_Id_Type p_SSUE_Id,
                                                           template (value) SL_TimingInfo_Type p_SL_TimingInfo) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    Common := cs_SSUE_ReqAspCommonPart_Cfg(p_SSUE_Id, p_SL_TimingInfo),
    Request := {
      SS_UE_Config := {
        Release := true
      }
    }
  };

  template (value) PscchConfig_Type cs_PscchConfig_Def := /* @status    APPROVED (LTE_A_PRO) */
  { //Acc to 36.508 Table 6.2.1.4-1
    RelativeTxPower   := 0
  };

  template (value) PsschConfig_Type cs_PsschConfig_Def:=
  { /* @status    APPROVED (LTE_A_PRO) */
    RelativeTxPower := 0 //Acc to 36.508 Table 6.2.1.4-1 @sic R5-162028 sic@
  };

  template (present) SL_SYSTEM_CTRL_CNF car_SSUE_Config_CNF(SS_UE_Id_Type p_SSUE_Id) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    Common := cr_SSUE_CnfAspCommonPart_Config(p_SSUE_Id),
    Confirm := {
      SS_UE_Config := true
    }
  };

  template (present) SL_CnfAspCommonPart_Type cr_SSUE_CnfAspCommonPart_Config(SS_UE_Id_Type p_SSUE_Id) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    SS_UE_Id := p_SSUE_Id,
    RoutingInfo := cr_SL_RoutingInfo_None,
    TimingInfo := ?,
    Result := {
      Success := true
    }
  };

  template (present) SL_DATA_IND car_SL_DATA_IND(template (present) SL_IndAspCommonPart_Type p_CommonPart,
                                                 template (present) SL_U_PlaneRx_Type p_U_PlaneData) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    Common := p_CommonPart,
    U_Plane := p_U_PlaneData
  };

  template (present) SL_DATA_IND car_SL_CommData_IND(template(present) SS_UE_Id_Type p_SSUE_Id,
                                                     template(present) SLRB_Identity_Type p_SLRB,
                                                     template (present) SL_U_PlaneRx_Type p_U_PlaneData) :=
  /* @status    APPROVED (LTE_A_PRO) */
    car_SL_DATA_IND(cr_SSUE_IndAspCommonPart_CommData(p_SSUE_Id, p_SLRB),
                    p_U_PlaneData);

  template (present) SL_IndAspCommonPart_Type cr_SSUE_IndAspCommonPart_CommData(template(present) SS_UE_Id_Type p_SSUE_Id,
                                                                                template(present) SLRB_Identity_Type p_SLRB,
                                                                                template (present) SL_TimingInfo_Type p_TimingInfo := ?) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    SS_UE_Id := p_SSUE_Id,
    RoutingInfo := cr_SL_RoutingInfo_SLRB(p_SLRB),
    TimingInfo := p_TimingInfo,
    Status := {
      Ok := true
    }
  };

  template (present) SL_RoutingInfo_Type cr_SL_RoutingInfo_SLRB(template(present) SLRB_Identity_Type p_SLRB) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    ChannelRadioBearerId := {
      SLRB := p_SLRB
    }
  };

  template (present) SL_U_PlaneRx_Type cr_SL_CommDataRx(template (present) PDCP_SDUList_Type p_PDCP_SDUList := ?,
                                                        template FreqDomainSchedulExplicit_Type p_FreqDomainSchedul := *) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    U_Plane := {
      PdcpSdu := p_PDCP_SDUList
    },
    FreqDomainSchedul := p_FreqDomainSchedul, //Default Scheduling configured
    SCIformat := *
  };

  template (value) SL_DATA_REQ cas_SL_DATA_REQ(template (value) SL_ReqAspCommonPart_Type p_CommonPart,
                                               template (value) SL_U_PlaneTx_Type p_SL_U_PlaneTx) :=
  { /* @status    APPROVED (LTE_A_PRO) */
    Common := p_CommonPart,
    U_Plane := p_SL_U_PlaneTx
  };

  template (value) SL_ReqAspCommonPart_Type cs_SSUE_ReqAspCommonPart_Data(SS_UE_Id_Type p_SSUE_Id,
                                                                          SLRB_Identity_Type p_SLRB,
                                                                          template (value) SL_TimingInfo_Type p_SL_TimingInfo) :=
    /* @status    APPROVED (LTE_A_PRO) */
    cs_SSUE_ReqAspCommonPart(p_SSUE_Id, cs_SL_RoutingInfo_SLRB(p_SLRB), p_SL_TimingInfo);

  template (value) SL_DATA_REQ cas_SL_CommData_REQ(SS_UE_Id_Type p_SSUE_Id,
                                                   SLRB_Identity_Type p_SLRB,
                                                   template (value) SL_TimingInfo_Type p_SL_TimingInfo,
                                                   template (value) SL_U_PlaneTx_Type p_U_PlaneData) :=
    /* @status    APPROVED (LTE_A_PRO) */
    cas_SL_DATA_REQ(cs_SSUE_ReqAspCommonPart_Data(p_SSUE_Id, p_SLRB, p_SL_TimingInfo),
                    p_U_PlaneData);

  template (value) SL_RoutingInfo_Type cs_SL_RoutingInfo_SLRB(SLRB_Identity_Type p_SLRB) :=
  { /* @status    APPROVED (LTE_A_PRO) */
   ChannelRadioBearerId := {
      SLRB := p_SLRB
    }
  };

  template (value) PDCP_SDU_Type   cs_STCH_Packet1   := f_GetN_OctetsFromPRBS(0,tsc_STCH_PacSize);   /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet2   := f_GetN_OctetsFromPRBS(10,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet3   := f_GetN_OctetsFromPRBS(20,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet4   := f_GetN_OctetsFromPRBS(30,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet5   := f_GetN_OctetsFromPRBS(40,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet6   := f_GetN_OctetsFromPRBS(50,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet7   := f_GetN_OctetsFromPRBS(60,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet8   := f_GetN_OctetsFromPRBS(70,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet9   := f_GetN_OctetsFromPRBS(80,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet10  := f_GetN_OctetsFromPRBS(90,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet11  := f_GetN_OctetsFromPRBS(100,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet12  := f_GetN_OctetsFromPRBS(110,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet13  := f_GetN_OctetsFromPRBS(120,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet14  := f_GetN_OctetsFromPRBS(130,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet15  := f_GetN_OctetsFromPRBS(140,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet16  := f_GetN_OctetsFromPRBS(150,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet17  := f_GetN_OctetsFromPRBS(160,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet18  := f_GetN_OctetsFromPRBS(170,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet19  := f_GetN_OctetsFromPRBS(180,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDU_Type   cs_STCH_Packet20  := f_GetN_OctetsFromPRBS(190,tsc_STCH_PacSize);  /* @status    APPROVED (LTE_A_PRO) */

  template (value) PDCP_SDUList_Type cs_STCH_PacketList := {   /* @status    APPROVED (LTE_A_PRO) */
    cs_STCH_Packet1,  cs_STCH_Packet2,  cs_STCH_Packet3,  cs_STCH_Packet4,  cs_STCH_Packet5,
    cs_STCH_Packet6,  cs_STCH_Packet7,  cs_STCH_Packet8,  cs_STCH_Packet9,  cs_STCH_Packet10,
    cs_STCH_Packet11, cs_STCH_Packet12, cs_STCH_Packet13, cs_STCH_Packet14, cs_STCH_Packet15,
    cs_STCH_Packet16, cs_STCH_Packet17, cs_STCH_Packet18, cs_STCH_Packet19, cs_STCH_Packet20
  };

  /*
   * @desc   To configure SSUE
   * @param     p_SSUE_Id
   * @param     p_SL_SYSTEM_CTRL_REQ
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SSUE_CommonConfig(SS_UE_Id_Type p_SSUE_Id,
                               template (value) SL_SYSTEM_CTRL_REQ p_SL_SYSTEM_CTRL_REQ) runs on SideLink_PTC
  {
    SYS.send(p_SL_SYSTEM_CTRL_REQ);
    if (valueof(p_SL_SYSTEM_CTRL_REQ.Common.ControlInfo.CnfFlag) == true) {
      SYS.receive(car_SSUE_Config_CNF(p_SSUE_Id));
    }
  };

  /*
   * @desc   Check that no STCH data is received during a specified period of time
   * @param     p_SSUE_Id
   * @param     p_StepNo
   * @param     p_TimeInSeconds     (default value: 0.200)
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SSUE_CheckNoSTCH_DataReceived(SS_UE_Id_Type p_SSUE_Id,
                                           charstring p_StepNo,
                                           float p_TimeInSeconds := 0.200) runs on SideLink_PTC // Default time corresponds to more than 3 communication periods (3*40ms)
  {
    timer t_Delay;
    
    t_Delay.start(p_TimeInSeconds);
    alt{
        []DATA.receive(car_SL_CommData_IND(p_SSUE_Id, tsc_SLRB1, cr_SL_CommDataRx(?, *))){
            f_SideLink_SetVerdictFailOrInconc(__FILE__, __LINE__, p_StepNo)
        }
        []t_Delay.timeout{
            f_SideLink_PreliminaryPass(__FILE__, __LINE__, p_StepNo);
        }
    }
  };

  /*
   * @desc     To release all SSUEs
   * @param     p_TimingInfo        (default value: cs_TimingIC_Now)
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_SSUE_ReleaseAll(template (value) SL_TimingInfo_Type p_TimingInfo := cs_TimingIC_Now) runs on SideLink_PTC
  {
    f_SSUE_CommonConfig(ss_UE_NonSpecific, cas_SSUE_Release_REQ(ss_UE_NonSpecific,  p_TimingInfo));
  };

  /*
   * @desc      Convert the DL bandwidth value from Dl_Bandwidth_Type to SL_Bandwidth_Type
   * @param     p_Ul_ChBandwidth
   * @return    SL_Bandwidth_Type
   * @status    APPROVED (LTE_A_PRO)
   */

  function f_ConvertBandwidth_ToSL_Type(Ul_Bandwidth_Type p_Ul_ChBandwidth) return SL_Bandwidth_Type
  {
    var SL_Bandwidth_Type v_SL_Bandwith;
    
    select (p_Ul_ChBandwidth){
      case (n6){ v_SL_Bandwith := n6  }
      case (n15){ v_SL_Bandwith := n15  }
      case (n25){ v_SL_Bandwith := n25  }
      case (n50){ v_SL_Bandwith := n50  }
      case (n75){ v_SL_Bandwith := n75  }
      case (n100){ v_SL_Bandwith := n100  }
      case else {
        FatalError (__FILE__, __LINE__, "invalid value for ChannelBandwidth");
      }
    }
    return v_SL_Bandwith;
  };

  /*
   * @desc      To receive STCH SDUs tranmsitted by UE
   * @param     p_SSUE_Id
   * @status    APPROVED (LTE_A_PRO)
   */
  altstep a_SidelinkUE_STCH_Reception(SS_UE_Id_Type p_SSUE_Id )
    runs on SideLink_PTC
  {
    []DATA.receive(car_SL_CommData_IND(p_SSUE_Id, tsc_SLRB1, cr_SL_CommDataRx(-, ?)))
      {
        repeat;
      }
  }

}
