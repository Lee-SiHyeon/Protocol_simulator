module UTRAN34_4C_Templates {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_RAB_Templates all;
  import from UTRAN34_RAB_Templates_r10 all;
  import from UTRAN34_RRC_CommonTemplates_r10 all;
  import from UTRAN34_RRC_Templates all;
  import from UTRAN_CapabilityFunctions_IRAT all;
  import from UTRAN_CommonDefs all;
