      {
        f_SetVerdict(fail, __FILE__, __LINE__, "Invalid UE Category setting per 36.306 Table 4.1A-6");
      }
    }
    else {
      if ((pc_ue_CategoryDL_0 == true) or
          (pc_ue_CategoryDL_4 == true) or // @sic R5s190339 sic@
          (pc_ue_CategoryDL_6 == true) or
          (pc_ue_CategoryDL_7 == true) or
          (pc_ue_CategoryDL_9 == true) or
          (pc_ue_CategoryDL_10 == true) or
          (pc_ue_CategoryDL_11 == true) or
          (pc_ue_CategoryDL_12 == true) or
          (pc_ue_CategoryDL_13 == true) or
          (pc_ue_CategoryDL_14 == true))
