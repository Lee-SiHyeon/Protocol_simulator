module NR5GC_Positioning_Functions {

  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from OMA_LPPE language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from CommonPOS_Functions all;
  import from EUTRA_AuxiliaryCapCheckFunctions all;
  import from LPP_Templates all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_POS_ASP_TypeDefs all;
  import from NR5GC_POS_Component all;
  import from NR5GC_Positioning_Templates all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CapabilityFunctions all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Templates all;
  import from NR_Parameters all;
  import from NR_RRC_Templates all;
  import from OMA_LPPe_Templates all;
  import from POS_Parameters all;
  import from Parameters all;
  import from PosSystem_ASP_TypeDefs all;
  import from PosSystem_CommonNR5GC all;
  import from PosSystem_Control all;

  template (value) DlPrs_TRPConfig_Type cs_DlPrsTRPConfig(template (value) NR_DL_PRS_Info_r16 p_DlPrsInfo) :=
  { /* @status    APPROVED (POS) */
    NrDlPrsSfn0Offset := cs_NrDlPrsSfn0Offset_0,
    NrDlPrsExpectedRstd := 0,
    NrDlPrsExpectedRstdUncertainty := 4,
    NrDlPrsInfo := p_DlPrsInfo
  };

  /*
   * @desc      Objective: To load the required pre-defined NR positioning test scenario
   *            and start generating positioning signals in the positioning simulator
   * @param     p_PosSystemListId
   * @param     p_Scenario
   * @status    APPROVED (POS)
   */
  function f_POS_StartPositioningSimulatorNR(PositioningSystemList_Type p_PosSystemListId,
                                             ScenarioNumber_Type p_Scenario) runs on NR5GC_POS_PTC
  {
    f_PosSystem_LoadScenario(POSSYS, p_PosSystemListId, cs_SatelliteScenario_NrPos(p_Scenario));
    f_PosSystem_Start(POSSYS, p_PosSystemListId);
  }

  /*
   * @desc      Objective: To stop generating positioning signals in the positioning simulator
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_POS_StopPositioningSimulatorNR(PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    f_PosSystem_Stop(POSSYS, p_PosSystemListId);
  }

  /*
   * @desc      To clear any assistance data the may be stored in the UE. TS 36.509, 5.5.1, 6.9
   * @param     p_NR_CellId
   * @param     p_UEPosTech
   * @status    APPROVED (POS)
   */
  function f_POS_NR_ClearStoredData(NR_CellId_Type p_NR_CellId,
                                    bitstring p_UEPosTech) runs on NR_BASE_PTC
  {
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   -, //tsc_NR_RbId_SRB2,
                                   -, //cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                     cs_NG_RESETUEPOSITIONINGSTOREDINFORMATION (p_UEPosTech))));
  }

  /*
   * @desc      To send an encoded LPP Message through SRB2 in NR Cell 1
   * @param     p_EncodedLppMessage
   * @param     p_RoutingId         (default value: tsc_POS_RoutingId)
   * @status    APPROVED (POS)
   */
  function f_POS_NR_SendEncodedLppMessage(octetstring p_EncodedLppMessage,
                                          octetstring p_RoutingId := tsc_POS_RoutingId) runs on NR_BASE_PTC
  {
    var template (value) NG_NAS_DL_Pdu_Type v_PduToSend;

    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                            omit, // Not a GSM Msg
                                            cs_PayloadContainer(omit, p_EncodedLppMessage),
                                            omit, //PDU session ID
                                            cs_RoutingInfoNR(p_RoutingId), //@sic R5s201391 sic@
                                            omit,
                                            omit); // @sic R5s221179 Baseline Moving sic@

    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1,
                                   -, //tsc_NR_RbId_SRB2
                                   -, //cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                     v_PduToSend.Msg)));  // @sic R5s221179 Baseline Moving sic@
  }

  /*
   * @desc      To send LPP ACKNOWLEDGEMENT if requested by the UE
   * @param     p_NR_CellId
   * @param     p_RoutingId
   * @param     p_LppMsgFromUE
   * @status    APPROVED (POS)
   */
  function f_POS_NR_SendLppAck(NR_CellId_Type p_NR_CellId,
                               octetstring p_RoutingId,
                               LPP_Message p_LppMsgFromUE) runs on NR_BASE_PTC
  {
    var octetstring v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppAcknowledgement(p_LppMsgFromUE.sequenceNumber));
    var template (value) NG_NAS_DL_Pdu_Type v_PduToSend;

    v_PduToSend := f_Get_NG_DLNASTransport  (cs_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                            omit, // Not a GSM Msg
                                            cs_PayloadContainer(omit, v_EncodedLppMessage),
                                            omit, //PDU session ID
                                            cs_RoutingInfoNR(p_RoutingId), // @sic R5s201529 sic@
                                            omit,
                                            omit); // @sic R5s221179 Baseline Moving sic@

    if (isvalue(p_LppMsgFromUE.acknowledgement)) {// UE requested ack
      SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                     -, //tsc_NR_RbId_SRB2,
                                     -, //cs_TimingInfo_Now,
                                     cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                     v_PduToSend.Msg)));  // @sic R5s221179 Baseline Moving sic@
    }
  }

  /*
   * @desc      To receive any encoded LPP message in NR. The function returns an octetstring
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_POS_NR_ReceiveEncodedLppMessage() runs on NR_BASE_PTC return octetstring
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var octetstring v_Octetstring;
    var template (present) NG_NAS_UL_Message_Type v_GMMMsg;

    v_GMMMsg := cr_NG_UL_NAS_TRANSPORT(cr_PayloadContainerType(tsc_PayloadContainerLPPMsg),
                                       *, *, *, *, *,
                                       cr_RoutingInfoNR(tsc_POS_RoutingId),  //@sic R5s201391 sic@
                                       *, *, *, *, *); //@sic R5s201387, R5s240531 Baseline Moving sic@

    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell1,
                                      tsc_NR_RbId_SRB2,
                                      cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                    v_GMMMsg))) -> value v_ReceivedAsp;

    v_Octetstring := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.ul_Nas_Transport.payload.payload;

    return v_Octetstring;
  }

  /*
   * @desc      Decode LPP message and match against expected PDU
   * @param     p_EncodedLppMessage
   * @param     p_ExpectedLppMessage
   * @return    LPP_Message
   * @status    APPROVED (POS)
   */
  function f_POS_NR_LppMessage_DecodeAndMatch(octetstring p_EncodedLppMessage,
                                              template (present) LPP_Message p_ExpectedLppMessage) runs on NR_BASE_PTC return LPP_Message
  {
    var LPP_Message v_DecodedLppMessage := f_POS_LppMessage_Decode(p_EncodedLppMessage);

    if (not match(v_DecodedLppMessage, p_ExpectedLppMessage))  {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "LPP Message do not match to template");
    }
    return v_DecodedLppMessage;
  }

  /*
   * @desc      Decode and match OMA LPPE message
   * @param     p_EncodedOmaLppeMessage
   * @param     p_ExpectedOmaLppeMessage
   * @return    OMA_LPPe_MessageExtension
   * @status    APPROVED (POS)
   */
  function f_POS_NR_OmaLppeMessage_DecodeAndMatch(octetstring p_EncodedOmaLppeMessage,
                                                  template (present) OMA_LPPe_MessageExtension p_ExpectedOmaLppeMessage) runs on NR_BASE_PTC return OMA_LPPe_MessageExtension
  {
    var OMA_LPPe_MessageExtension v_DecodedOmaLppeMessage := f_POS_OmaLppeMessage_Decode(p_EncodedOmaLppeMessage);

    if (not match(v_DecodedOmaLppeMessage, p_ExpectedOmaLppeMessage))  {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "OMA LPPe Message do not match to template");
    }
    return v_DecodedOmaLppeMessage;
  }

  /*
   * @desc      Capability Transfer procedure initiated at the start of the tests to preempt any unsolicited LPP PROVIDE CAPABILITIES message.
   *            (According to TS 36.305 clause 7.1.2.5  and TS 36.355 clause 5.1.2, a UE may at any time send  capability information
   *            to the server if a Capability Transfer procedure has not already been performed.)
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CapabilityTransferProcedure () runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var LPP_Message v_LppMessage;

    //@siclog "Step 0" siclog@
    //SS sends LPP REQUEST CAPABILITIES
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestCapabilities(tsc_POS_TransactionNumber));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 0a" siclog@
    //Receive LPP PROVIDE CAPABILITIES
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideCapabilities (tsc_POS_TransactionNumber));

    // Further matching is required according to PICS values:
    f_POS_NR_CheckCapabilities (v_LppMessage, false);

    //@siclog "Step 0b" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 2
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }

  /*
   * @desc      Retrieves adequate data from satellite simulator depending on the supported GNSSs
   * @param     p_GNSS_List
   * @return    ProvideAssistanceData_r9_IEs
   * @status    APPROVED (POS)
   */
  function f_POS_RetrieveNR_DataGNSS(PositioningSystemList_Type p_GNSS_List) runs on NR5GC_POS_PTC return ProvideAssistanceData_r9_IEs
  {

    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;
    var template (value) A_GNSS_RequestAssistanceData v_RequestAssistData;

    //Note: In order to simplify the code, all GNSS Assistance data IEs for the supported GNSSs will be requested to the Satellite simulator, but only those
    //      indicated in TS 37.571-5 Table 6.1.3.3-1 will be later sent to the UE.
    v_RequestAssistData := cs_A_GNSS_RequestAssistanceData (f_POS_SelectTemplateReq_ReferenceTime(),
                                                            f_POS_SelectTemplateReq_IonosphModel(),
                                                            f_POS_SelectTemplateReq_GenericAssistData());

    v_ProvideAssistData := f_POS_NR_RetrieveData(p_GNSS_List, cs_RequestAssistData(v_RequestAssistData));

    return v_ProvideAssistData;
  }

  /*
   * @desc      To provide Assitance Data for A-GNSS depending on the GNSS supported by the UE
   * @param     p_UEB
   * @param     p_TransactionNumber
   * @param     p_RoutingId
   * @param     p_ProvideAssistData
   * @param     p_OtdoaProvideAssistData
   * @param     p_MbsProvideAssistanceData (default value: omit)
   * @status    APPROVED (POS)
   */
  function f_POS_NR_SendLppProvideAssistanceData_GNSS(boolean p_UEB,
                                                      TransactionNumber p_TransactionNumber,
                                                      octetstring p_RoutingId,
                                                      ProvideAssistanceData_r9_IEs p_ProvideAssistData,
                                                      template (omit) OTDOA_ProvideAssistanceData p_OtdoaProvideAssistData,
                                                      template (omit) TBS_ProvideAssistanceData_r14 p_MbsProvideAssistanceData := omit) runs on NR_BASE_PTC
  {
    var octetstring v_EncodedLppMessage;
    var template (value) A_GNSS_ProvideAssistanceData v_GNSS_ProvideAssistData;

    v_GNSS_ProvideAssistData := cs_AgnssProvideAssistData(f_POS_SelectTemplateProv_ReferenceTime(p_ProvideAssistData),
                                                          f_POS_SelectTemplateProv_ReferenceLocation(p_ProvideAssistData, p_UEB),
                                                          f_POS_SelectTemplateProv_IonosphericModel(p_ProvideAssistData, p_UEB),
                                                          f_POS_SelectTemplateProv_GenericAssistData(p_ProvideAssistData, p_UEB));


    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(p_TransactionNumber,
                                                                          locationServer,
                                                                          v_GNSS_ProvideAssistData,
                                                                          p_OtdoaProvideAssistData,
                                                                          -,
                                                                          p_MbsProvideAssistanceData));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage, p_RoutingId);
  }

  /*
   * @desc      Compares the capability received with the values in the PICS
   * @param     p_LppMessage
   * @param     p_CheckEpduCap
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities (LPP_Message p_LppMessage, boolean p_CheckEpduCap) runs on NR_BASE_PTC
  {
    var octetstring v_Octetstring;

    //CommonIEs
    if (pc_LPP_MsgSegmentation) {
      if (not isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.commonIEsProvideCapabilities)) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in Common capabilities PICS");
      }
      else {
        if (not match(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.commonIEsProvideCapabilities, cr_CommonIEsProvideCapabilities)) {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in LPP-Segmentation capabilities");
        }
      }
    }
    //AGNSS
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.a_gnss_ProvideCapabilities) and (pc_UEB_AGNSS or pc_UEA_AGNSS)) {
      f_POS_NR_CheckCapabilities_Agnss(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.a_gnss_ProvideCapabilities);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.a_gnss_ProvideCapabilities) or pc_UEB_AGNSS or pc_UEA_AGNSS) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in A-GNSS capabilities PICS");
    }
    //OTDOA
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.otdoa_ProvideCapabilities) and pc_OTDOA_onNR) { //@sic R5-225313, R5s240160 sic@
      if(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.otdoa_ProvideCapabilities.otdoa_Mode[0]== '1'B){
          f_POS_NR_OTDOA_CheckEutraBand(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.otdoa_ProvideCapabilities);
      }
      else{
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE reported OTDOA UE-Assisted mode not supported");
      }
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.otdoa_ProvideCapabilities) or pc_OTDOA_onNR) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in OTDOA capabilities PICS");
    }

    //ECID
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.ecid_ProvideCapabilities) and pc_ECID_onNR) { //@sic R5-225313 sic@
      f_POS_NR_CheckCapabilities_Ecid(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.ecid_ProvideCapabilities);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.ecid_ProvideCapabilities) or pc_ECID_onNR) { //@sic R5-225313 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in ECID capabilities PICS");
    }
    //LPPe
    if(p_CheckEpduCap){
      if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.epdu_ProvideCapabilities) and pc_OMA_LPPe) {
        v_Octetstring := p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.epdu_ProvideCapabilities[0].ePDU_Body;
        f_POS_NR_OmaLppeMessage_DecodeAndMatch(v_Octetstring, cr_OmaLppe_ProvideCapabilities);
      }
      else if(isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.epdu_ProvideCapabilities) or pc_OMA_LPPe) {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in EPDU capabilities PICS!");
      }
    }
    //MBS
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.tbs_ProvideCapabilities_r13)) {
      if (not(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.tbs_ProvideCapabilities_r13.tbs_Modes_r13[1]=='1'B and pc_UEA_MBS)){
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE reported UE-Assisted MBS not supported");
      }
    }
    //WLAN
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.wlan_ProvideCapabilities_r13)) {
      if (not(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.wlan_ProvideCapabilities_r13.wlan_Modes_r13[1]=='1'B and pc_WLAN)){
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE reported UE-Assisted WLAN not supported");
      }
    }
    //Sensor
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.sensor_ProvideCapabilities_r13)) {
      if (not(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.sensor_ProvideCapabilities_r13.sensor_Modes_r13[1]=='1'B and pc_Sens)){
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE reported UE-Assisted Sensor not supported");
      }
    }
    //Bluetooth
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.bt_ProvideCapabilities_r13)) {
      if (not(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.bt_ProvideCapabilities_r13.bt_Modes_r13[1]=='1'B and pc_Bluetooth)){
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE reported UE-Assisted Bluetooth not supported");
      }
    }
    //NR ECID
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_ECID_ProvideCapabilities_r16) and pc_NR_ECID) { //@sic POS Rel-16 R5-213638 sic@
      f_POS_NR_CheckCapabilities_NR_Ecid(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_ECID_ProvideCapabilities_r16);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_ECID_ProvideCapabilities_r16) or pc_NR_ECID) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR ECID capabilities PICS");
    }
    //NR Multi RTT
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_Multi_RTT_ProvideCapabilities_r16) and pc_Multi_RTT) { //@sic POS Rel-16 R5-213638 sic@
      f_POS_NR_CheckCapabilities_NR_MultiRTT(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_Multi_RTT_ProvideCapabilities_r16);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_Multi_RTT_ProvideCapabilities_r16) or pc_Multi_RTT) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR Multi RTT capabilities PICS");
    }
    //NR DL AoD
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_AoD_ProvideCapabilities_r16) and (pc_UEA_DL_AoD or pc_UEB_DL_AoD)) { //@sic POS Rel-16 R5-213638 sic@
      f_POS_NR_CheckCapabilities_NR_DL_AoD(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_AoD_ProvideCapabilities_r16);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_AoD_ProvideCapabilities_r16) or (pc_UEA_DL_AoD or pc_UEB_DL_AoD)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR DL AoD capabilities PICS");
    }
    //NR DL TDOA
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_TDOA_ProvideCapabilities_r16) and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA)) { //@sic POS Rel-16 R5-213638 sic@
      f_POS_NR_CheckCapabilities_NR_DL_TDOA(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_TDOA_ProvideCapabilities_r16);
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_DL_TDOA_ProvideCapabilities_r16) or (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR DL TDOA capabilities PICS");
    }
    //NR UL SRS
    if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16)) { //@sic POS Rel-16 R5-213638 sic@
      f_POS_NR_CheckCapabilities_NR_UL_SRS(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16.nr_UL_SRS_Capability_r16);

      if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16.nr_UE_TEG_Capability_r17)) {
        f_POS_NR_CheckCapabilities_NR_UL_TEG(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16.nr_UE_TEG_Capability_r17); //TBD
      }
      else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16.nr_UE_TEG_Capability_r17) or pc_nr_UE_TxTEG_ID) { //@sic R5-235341 sic@
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR UE TEG capabilities PICS");
      }
    }
    else if (isvalue(p_LppMessage.lpp_MessageBody.c1.provideCapabilities.criticalExtensions.c1.provideCapabilities_r9.nr_UL_ProvideCapabilities_r16) or (pc_NR_UL_SRS_Capability)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR UL SRS capabilities PICS");
    }
  }

  /*
   * @desc      Function to check A-GNSS provide capabilities
   *            Reference 37.571-2 Table 7.3.1.1.3.3-6
   * @param     p_AgnssProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_Agnss(A_GNSS_ProvideCapabilities p_AgnssProvideCapabilities) runs on NR_BASE_PTC
  {
    var integer i;
    var template LocationCoordinateTypes v_LocationCoordinateTypesCap := cr_LocationCoordinateTypesCap;

    //Check gnss-SupportList
    f_POS_NR_CheckGnssSupportList (p_AgnssProvideCapabilities.gnss_SupportList);

    //Check assistanceDataSupportList
    // - CommonAssistanceDataSupport
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_RefTimeSup, "pc_GNSS_RefTimeSup", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_ReferenceTimeSupport));
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_RefLocSup, "pc_GNSS_RefLocSup", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_ReferenceLocationSupport));
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_IonoModSup, "pc_GNSS_IonoModSup", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_IonosphericModelSupport));
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_EOPSup, "pc_GNSS_EOPSup", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_EarthOrientationParametersSupport));
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_RTK_RefStationInfo, "pc_GNSS_RTK_RefStationInfo", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_RTK_ReferenceStationInfoSupport_r15));
    f_NR_CheckPICS_PresenceOfReceivedField(pc_GNSS_RTK_AuxStationInfo, "pc_GNSS_RTK_AuxStationInfo", ispresent(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_CommonAssistanceDataSupport.gnss_RTK_AuxiliaryStationDataSupport_r15));

    // - GenericAssistanceDataSupport
    for (i:=0; i < lengthof(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport); i:=i+1) {
      select (p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i].gnss_ID.gnss_id) {
        case (gps) {
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_Gps,
                                                  pc_GNSS_DGNSS_Sup_Gps,
                                                  pc_GNSS_NavModSup_Gps,
                                                  pc_GNSS_RTISup_Gps,
                                                  pc_GNSS_DataBitsSup_Gps,
                                                  pc_GNSS_AcquAssistSup_Gps,
                                                  pc_GNSS_AlmanacSup_Gps,
                                                  pc_GNSS_UTCModSup_Gps,
                                                  pc_GNSS_AuxInfoSup_Gps,
                                                  -,-,
                                                  pc_GNSS_RTK_OBS_Gps, //@sic R5-192381 sic@
                                                  -,
                                                  pc_GNSS_RTK_MAC_CorrectionDifferences_Gps,
                                                  pc_GNSS_RTK_Residuals_Gps,
                                                  pc_GNSS_RTK_FKP_Gradients_Gps,
                                                  pc_GNSS_RTK_SSR_OrbitCorrections_Gps,
                                                  pc_GNSS_RTK_SSR_ClockCorrections_Gps,
                                                  pc_GNSS_RTK_SSR_CodeBias_Gps);
        }
        case (sbas) {
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_Sbas,
                                                  pc_GNSS_DGNSS_Sup_Sbas,
                                                  pc_GNSS_NavModSup_Sbas,
                                                  pc_GNSS_RTISup_Sbas,
                                                  pc_GNSS_DataBitsSup_Sbas,
                                                  pc_GNSS_AcquAssistSup_Sbas,
                                                  pc_GNSS_AlmanacSup_Sbas,
                                                  pc_GNSS_UTCModSup_Sbas,
                                                  pc_GNSS_AuxInfoSup_Sbas);
        }
        case (qzss) {
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_Qzss,
                                                  pc_GNSS_DGNSS_Sup_Qzss,
                                                  pc_GNSS_NavModSup_Qzss,
                                                  pc_GNSS_RTISup_Qzss,
                                                  pc_GNSS_DataBitsSup_Qzss,
                                                  pc_GNSS_AcquAssistSup_Qzss,
                                                  pc_GNSS_AlmanacSup_Qzss,
                                                  pc_GNSS_UTCModSup_Qzss,
                                                  pc_GNSS_AuxInfoSup_Qzss);
        }
        case (galileo) {
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_Galileo,
                                                  pc_GNSS_DGNSS_Sup_Galileo,
                                                  pc_GNSS_NavModSup_Galileo,
                                                  pc_GNSS_RTISup_Galileo,
                                                  pc_GNSS_DataBitsSup_Galileo,
                                                  pc_GNSS_AcquAssistSup_Galileo,
                                                  pc_GNSS_AlmanacSup_Galileo,
                                                  pc_GNSS_UTCModSup_Galileo,
                                                  pc_GNSS_AuxInfoSup_Galileo,
                                                  -,-,
                                                  pc_GNSS_RTK_OBS_Galileo, //@sic R5-192381 sic@
                                                  -,
                                                  pc_GNSS_RTK_MAC_CorrectionDifferences_Galileo,
                                                  pc_GNSS_RTK_Residuals_Galileo,
                                                  pc_GNSS_RTK_FKP_Gradients_Galileo,
                                                  pc_GNSS_RTK_SSR_OrbitCorrections_Galileo,
                                                  pc_GNSS_RTK_SSR_ClockCorrections_Galileo,
                                                  pc_GNSS_RTK_SSR_CodeBias_Galileo);
        }
        case (glonass) {
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_Glonass,
                                                  pc_GNSS_DGNSS_Sup_Glonass,
                                                  pc_GNSS_NavModSup_Glonass,
                                                  pc_GNSS_RTISup_Glonass,
                                                  pc_GNSS_DataBitsSup_Glonass,
                                                  pc_GNSS_AcquAssistSup_Glonass,
                                                  pc_GNSS_AlmanacSup_Glonass,
                                                  pc_GNSS_UTCModSup_Glonass,
                                                  pc_GNSS_AuxInfoSup_Glonass,
                                                  -,-,
                                                  pc_GNSS_RTK_OBS_Glonass,  //@sic R5-192381 sic@
                                                  pc_GNSS_RTK_BiasInfo_Glonass,
                                                  pc_GNSS_RTK_MAC_CorrectionDifferences_Glonass,
                                                  pc_GNSS_RTK_Residuals_Glonass,
                                                  pc_GNSS_RTK_FKP_Gradients_Glonass,
                                                  pc_GNSS_RTK_SSR_OrbitCorrections_Glonass,
                                                  pc_GNSS_RTK_SSR_ClockCorrections_Glonass,
                                                  pc_GNSS_RTK_SSR_CodeBias_Glonass);
        }
        case (bds) { // @sic R5-145737,  R5-145098 sic@
          f_POS_NR_CheckGenericAssistanceDataSupport(p_AgnssProvideCapabilities.assistanceDataSupportList.gnss_GenericAssistanceDataSupport[i],
                                                  pc_GNSS_TimeModSup_BDS,
                                                  pc_GNSS_DGNSS_Sup_BDS,
                                                  pc_GNSS_NavModSup_BDS,
                                                  pc_GNSS_RTISup_BDS,
                                                  pc_GNSS_DataBitsSup_BDS,
                                                  pc_GNSS_AcquAssistSup_BDS,
                                                  pc_GNSS_AlmanacSup_BDS,
                                                  pc_GNSS_UTCModSup_BDS,
                                                  pc_GNSS_AuxInfoSup_BDS,
                                                  pc_BDS_DiffCorr,
                                                  pc_BDS_GridMod,
                                                  pc_GNSS_RTK_OBS_Bds, //@sic R5-192381 sic@
                                                  -,
                                                  pc_GNSS_RTK_MAC_CorrectionDifferences_Bds,
                                                  pc_GNSS_RTK_Residuals_Bds,
                                                  pc_GNSS_RTK_FKP_Gradients_Bds,
                                                  pc_GNSS_RTK_SSR_OrbitCorrections_Bds,
                                                  pc_GNSS_RTK_SSR_ClockCorrections_Bds,
                                                  pc_GNSS_RTK_SSR_CodeBias_Bds);
        }
      }
    }
    //Check Location Coordinate Types and Velocity Types
    if (pc_UEB_AGNSS) {
      if (not isvalue (p_AgnssProvideCapabilities.locationCoordinateTypes)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "LocationCoordinateTypes missing");
      }
      //@sic R5s190462 sic@
      if (not(pc_A_GPS_HA or pc_GLONASS_HA or pc_BDS_HA or pc_QZSS_HA or pc_GALILEO_HA or pc_SBAS_HA)) { //High Accuracy not supported
        v_LocationCoordinateTypesCap := cr_LocationCoordinateTypesCap (omit, omit); //capabilities related to HA will not be reported
      }
      if (not match (p_AgnssProvideCapabilities.locationCoordinateTypes, v_LocationCoordinateTypesCap)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for locationCoordinateTypes");
      }
      if (not isvalue (p_AgnssProvideCapabilities.velocityTypes)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "velocityTypes missing");
      }
      if (not match (p_AgnssProvideCapabilities.velocityTypes, cr_VelocityTypesCap)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for velocityTypes");
      }
    }
  }

  /*
   * @desc      Function to check different signals reported for a specific GNSS element
   * @param     p_GnssSupportElement
   * @param     p_Gnss
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckGnssSignals(GNSS_SupportElement p_GnssSupportElement,
                                     charstring p_Gnss) runs on NR_BASE_PTC
  {
    select(p_Gnss) {
      case("gps") {
        if (not((f_ConvertBoolToBit(pc_A_GPS_L1C_A) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0]) and  //Check L1 C/A
                (f_ConvertBoolToBit(pc_A_GPS_L1C) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[1]) and    //Check L1C
                (f_ConvertBoolToBit(pc_A_GPS_L2C) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[2]) and    //Check L2C
                (f_ConvertBoolToBit(pc_A_GPS_L5) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[3]))) {      //Check L5
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for gps gnss-signals");
        }
      }
      case("sbas") {
        if (not((f_ConvertBoolToBit(pc_A_SBAS) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0]))) {  //Check L1
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for sbas gnss-signals");
        }
      }
      case("qzss") {
        if (not((f_ConvertBoolToBit(pc_QZSS_QZS_L1)  == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0]) and  //Check QZS L1
                (f_ConvertBoolToBit(pc_QZSS_QZS_L1C) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[1]) and  //Check L1C
                (f_ConvertBoolToBit(pc_QZSS_QZS_L2C) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[2]) and  //Check L2C
                (f_ConvertBoolToBit(pc_QZSS_QZS_L5)  == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[3]))) {  //Check L5
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for qzss gnss-signals");
        }
      }
      case("galileo") {
        if (not((f_ConvertBoolToBit(pc_GALILEO_E1) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0]) and   //Check E1
                (f_ConvertBoolToBit(pc_GALILEO_E5a) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[1]) and  //Check E5a
                (f_ConvertBoolToBit(pc_GALILEO_E5b) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[2]) and  //Check E5b
                (f_ConvertBoolToBit(pc_GALILEO_E6) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[3]) and   //Check E6
                (f_ConvertBoolToBit(pc_GALILEO_E5aE5b) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[4]))) {   //Check E5a+E5b
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for galileo gnss-signals");
        }
      }
      case("glonass") {
        if (not((f_ConvertBoolToBit(pc_GLONASS_G1) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0]) and  //Check G1
                (f_ConvertBoolToBit(pc_GLONASS_G2) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[1]) and    //Check G2
                (f_ConvertBoolToBit(pc_GLONASS_G3) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[2]))) {      //Check G3
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for glonass gnss-signals");
        }
      }
      case("bds") {
        if (not(f_ConvertBoolToBit(pc_BDS_B1I) == p_GnssSupportElement.gnss_Signals.gnss_SignalIDs[0])) {      //Check B1I
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for bds gnss-signals");
        }
      }
    }
  }

  /*
   * @desc      To check a specific element of GNSS Support List in A-GNSS capabilities
   * @param     p_GnssSupportElement
   * @param     p_Gnss
   * @param     p_ADR_Pics
   * @param     p_ADR_ENH_Pics
   * @param     p_VelocityMeas_Pics
   * @param     p_HA_Pics
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckGnssSupport(GNSS_SupportElement p_GnssSupportElement,
                                     charstring p_Gnss,
                                     boolean p_ADR_Pics,
                                     boolean p_ADR_ENH_Pics,
                                     boolean p_VelocityMeas_Pics,
                                     boolean p_HA_Pics) runs on NR_BASE_PTC
  {
    //Check sbas-id not present
    if (isvalue (p_GnssSupportElement.sbas_IDs)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "sbas-ID present for "& p_Gnss);
    }
    //Check positioning modes
    if (not(f_POS_CheckAgnssPositioningModes(p_GnssSupportElement.agnss_Modes))) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " agnss-Modes");
    }
    //Check signals
    f_POS_NR_CheckGnssSignals(p_GnssSupportElement, p_Gnss);
    //Check FTA MeasSupport
    if (isvalue(p_GnssSupportElement.fta_MeasSupport) ) {
      if (not((f_ConvertBoolToBit(pc_GNSS_FTA and (pc_eFDD or pc_eTDD)) == p_GnssSupportElement.fta_MeasSupport.cellTime.accessTypes[0]) and  //Check FTA for EUTRA
        (f_ConvertBoolToBit(pc_GNSS_FTA and pc_UTRA) == p_GnssSupportElement.fta_MeasSupport.cellTime.accessTypes[1]) and  //Check FTA for UTRA
        (f_ConvertBoolToBit(pc_GNSS_FTA and pc_GERAN) == p_GnssSupportElement.fta_MeasSupport.cellTime.accessTypes[2]) and
        (f_POS_CheckAgnssPositioningModes(p_GnssSupportElement.fta_MeasSupport.mode, true)))) {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " FTA Measurements");
      }
    }
    else {
      if (pc_GNSS_FTA or pc_GNSS_FTA_UEB or pc_GNSS_FTA_UEA) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match: FTA=supported but no FTA Measurements included");
      }
    }
    //Check ADR support
    if (not (p_ADR_Pics == p_GnssSupportElement.adr_Support)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " ADR support");
    }
    //Check ADR enhancements support
    if (p_ADR_Pics) {
      if (not (p_ADR_ENH_Pics and (p_GnssSupportElement.adrEnhancementsSupport_r15 == true_))) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " ADR enhancements support");
      }
    }
    //Check velocity measurement support
    if (not (p_VelocityMeas_Pics == p_GnssSupportElement.velocityMeasurementSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " velocity measurement support");
    }
    //Check High Accuracy for GNSS modes support
    if (p_HA_Pics xor isvalue(p_GnssSupportElement.ha_gnss_Modes_r15)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for " & p_Gnss & " HA for GNSS modes support");
    }
  }

   /*
   * @desc      To check GNSS Support List in A-GNSS capabilities
   * @param     p_GnssSupportList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckGnssSupportList(GNSS_SupportList p_GnssSupportList) runs on NR_BASE_PTC
  {
    var boolean v_GpsFound := false;
    var boolean v_SbasFound := false;
    var boolean v_QzssFound := false;
    var boolean v_GalileoFound := false;
    var boolean v_GlonassFound := false;
    var boolean v_BdsFound := false;
    var integer i;

    for (i:=0; i < lengthof(p_GnssSupportList); i:=i+1) {
      select (p_GnssSupportList[i].gnss_ID.gnss_id) {
        case (gps) {
          v_GpsFound := true;
          if (pc_A_GPS_L1C_A or pc_A_GPS_L1C_A_MGPS) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "gps",
                                      pc_A_GPS_ADR,
                                      pc_A_GPS_ADR_ENH,
                                      pc_A_GPS_VelocityMeas,
                                      pc_A_GPS_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for gps");
          }
        }
        case (sbas) {
          v_SbasFound := true;
          if (pc_A_SBAS) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "sbas",
                                      pc_SBAS_ADR,
                                      pc_SBAS_ADR_ENH,
                                      pc_SBAS_VelocityMeas,
                                      pc_SBAS_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for sbas");
          }
        }
        case (qzss) {
          v_QzssFound := true;
          if (pc_A_QZSS) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "qzss",
                                      pc_QZSS_ADR,
                                      pc_QZSS_ADR_ENH,
                                      pc_QZSS_VelocityMeas,
                                      pc_QZSS_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for qzss");
          }
        }
        case (galileo) {
          v_GalileoFound := true;
          if (pc_A_Galileo) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "galileo",
                                      pc_GALILEO_ADR,
                                      pc_GALILEO_ADR_ENH,
                                      pc_GALILEO_VelocityMeas,
                                      pc_GALILEO_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for galileo");
          }
        }
        case (glonass) {
          v_GlonassFound := true;
          if (pc_A_GLONASS) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "glonass",
                                      pc_GLONASS_ADR,
                                      pc_GLONASS_ADR_ENH,
                                      pc_GLONASS_VelocityMeas,
                                      pc_GLONASS_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for glonass");
          }
        }
        case (bds) {
          v_BdsFound := true;
          if (pc_A_BDS) {
            f_POS_NR_CheckGnssSupport(p_GnssSupportList[i],
                                      "bds",
                                      pc_BDS_ADR,
                                      pc_BDS_ADR_ENH,
                                      pc_BDS_VelocityMeas,
                                      pc_BDS_HA);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for bds");
          }
        }
      }
    }
    //Check if the UE did not report capabilities for any of the supported GNSS
    if (not(((pc_A_GPS_L1C_A == v_GpsFound) or (pc_A_GPS_L1C_A_MGPS == v_GpsFound)) and
            (pc_A_SBAS == v_SbasFound) and
            (pc_A_QZSS == v_QzssFound) and
            (pc_A_Galileo == v_GalileoFound) and
            (pc_A_GLONASS == v_GlonassFound) and
            (pc_A_BDS == v_BdsFound))) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Not all supported GNSS were reported by the UE");
    }
  }

  /*
   * @desc      Function to check GNSS_GenericAssistanceDataSupport elements
   *            Reference 37.571-2 Table 7.3.1.1.3.3-8
   * @param     p_GenericAssisDataElement
   * @param     p_GNSS_TimeModSup
   * @param     p_GNSS_DGNSS_Sup
   * @param     p_GNSS_NavModSup
   * @param     p_GNSS_RTISup
   * @param     p_GNSS_DataBitsSup
   * @param     p_GNSS_AcquAssistSup
   * @param     p_GNSS_AlmanacSup
   * @param     p_GNSS_UTCModSup
   * @param     p_GNSS_AuxInfoSup
   * @param     p_BDS_DiffCorr      (default value: omit)
   * @param     p_BDS_GridMod       (default value: omit)
   * @param     p_GNSS_RTK_Obs      (default value: omit)
   * @param     p_Glo_RTK_BiasInfo  (default value: omit)
   * @param     p_GNSS_RTK_MAC      (default value: omit)
   * @param     p_GNSS_RTK_Res      (default value: omit)
   * @param     p_GNSS_RTK_FKP      (default value: omit)
   * @param     p_GNSS_SSR_Orbit    (default value: omit)
   * @param     p_GNSS_SSR_Clock    (default value: omit)
   * @param     p_GNSS_SSR_Code     (default value: omit)
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckGenericAssistanceDataSupport(GNSS_GenericAssistDataSupportElement p_GenericAssisDataElement,
                                                      boolean p_GNSS_TimeModSup,
                                                      boolean p_GNSS_DGNSS_Sup,
                                                      boolean p_GNSS_NavModSup,
                                                      boolean p_GNSS_RTISup,
                                                      boolean p_GNSS_DataBitsSup,
                                                      boolean p_GNSS_AcquAssistSup,
                                                      boolean p_GNSS_AlmanacSup,
                                                      boolean p_GNSS_UTCModSup,
                                                      boolean p_GNSS_AuxInfoSup,
                                                      template (omit) boolean p_BDS_DiffCorr := omit,
                                                      template (omit) boolean p_BDS_GridMod := omit,
                                                      template (omit) boolean p_GNSS_RTK_Obs := omit,
                                                      template (omit) boolean p_Glo_RTK_BiasInfo := omit,
                                                      template (omit) boolean p_GNSS_RTK_MAC := omit,
                                                      template (omit) boolean p_GNSS_RTK_Res := omit,
                                                      template (omit) boolean p_GNSS_RTK_FKP := omit,
                                                      template (omit) boolean p_GNSS_SSR_Orbit := omit,
                                                      template (omit) boolean p_GNSS_SSR_Clock := omit,
                                                      template (omit) boolean p_GNSS_SSR_Code := omit) runs on NR_BASE_PTC
  {
    if (isvalue (p_GenericAssisDataElement.sbas_ID) and (p_GenericAssisDataElement.gnss_ID.gnss_id != sbas)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "sbas-ID present for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID));
    }
    if (p_GNSS_TimeModSup != ispresent(p_GenericAssisDataElement.gnss_TimeModelsSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-TimeModelsSupport");
    }
    if (p_GNSS_DGNSS_Sup != ispresent(p_GenericAssisDataElement.gnss_DifferentialCorrectionsSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-DifferentialCorrectionsSupport");
    }
    if (p_GNSS_NavModSup != ispresent(p_GenericAssisDataElement.gnss_NavigationModelSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-NavigationModelSupport");
    }
    if (p_GNSS_RTISup != ispresent(p_GenericAssisDataElement.gnss_RealTimeIntegritySupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-RealTimeIntegritySupport");
    }
    if (p_GNSS_DataBitsSup != ispresent(p_GenericAssisDataElement.gnss_DataBitAssistanceSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-DataBitAssistanceSupport");
    }
    if (p_GNSS_AcquAssistSup != ispresent(p_GenericAssisDataElement.gnss_AcquisitionAssistanceSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-AcquisitionAssistanceSupport");
    }
    if (p_GNSS_AlmanacSup != ispresent(p_GenericAssisDataElement.gnss_AlmanacSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-AlmanacSupport");
    }
    if (p_GNSS_UTCModSup != ispresent(p_GenericAssisDataElement.gnss_UTC_ModelSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-UTC-ModelSupport");
    }
    if (p_GNSS_AuxInfoSup != ispresent(p_GenericAssisDataElement.gnss_AuxiliaryInformationSupport)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-AuxiliaryInformationSupport");
    }
    if (isvalue(p_BDS_DiffCorr) and valueof(p_BDS_DiffCorr)) {
      if (not isvalue (p_GenericAssisDataElement.bds_DifferentialCorrectionsSupport_r12)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "bds-DifferentialCorrectionsSupport-r12");
      }
    }
    if (isvalue(p_BDS_GridMod) and valueof(p_BDS_GridMod)) {
      if (not isvalue (p_GenericAssisDataElement.bds_GridModelSupport_r12)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "bds-GridModelSupport-r12");
      }
    }
    if (isvalue(p_GNSS_RTK_Obs) and valueof(p_GNSS_RTK_Obs)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_RTK_ObservationsSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-RTK-ObservationsSupport-r15");
      }
    }
    if (isvalue(p_Glo_RTK_BiasInfo) and valueof(p_Glo_RTK_BiasInfo)) {
      if (not isvalue (p_GenericAssisDataElement.glo_RTK_BiasInformationSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "glo-RTK-BiasInformationSupport-r15");
      }
    }
    if (isvalue(p_GNSS_RTK_MAC) and valueof(p_GNSS_RTK_MAC)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_RTK_MAC_CorrectionDifferencesSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-RTK-MAC-CorrectionDifferencesSupport-r15");
      }
    }
    if (isvalue(p_GNSS_RTK_Res) and valueof(p_GNSS_RTK_Res)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_RTK_ResidualsSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-RTK-ResidualsSupport-r15");
      }
    }
    if (isvalue(p_GNSS_RTK_FKP) and valueof(p_GNSS_RTK_FKP)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_RTK_FKP_GradientsSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-RTK-FKP-GradientsSupport-r15");
      }
    }
    if (isvalue(p_GNSS_SSR_Orbit) and valueof(p_GNSS_SSR_Orbit)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_SSR_OrbitCorrectionsSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "   gnss-SSR-OrbitCorrectionsSupport-r15");
      }
    }
    if (isvalue(p_GNSS_SSR_Clock) and valueof(p_GNSS_SSR_Clock)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_SSR_ClockCorrectionsSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-SSR-ClockCorrectionsSupport-r15");
      }
    }
    if (isvalue(p_GNSS_SSR_Code) and valueof(p_GNSS_SSR_Code)) {
      if (not isvalue (p_GenericAssisDataElement.gnss_SSR_CodeBiasSupport_r15)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for" & f_POS_GnssId2charstring(p_GenericAssisDataElement.gnss_ID) & "gnss-SSR-CodeBiasSupport-r15");
      }
    }
  }

  /*
   * @desc      To check the presence of the capability field with the PICS
   *            If PICS=true the capability field shall be present
   *            If PICS=false the capability field shall be omitted
   * @param     p_PicsStatement
   * @param     p_PicsName
   * @param     p_ReceivedField
   * @status    APPROVED (POS)
   */
  function f_NR_CheckPICS_PresenceOfReceivedField(boolean p_PicsStatement,
                                                  charstring p_PicsName,
                                                  boolean p_ReceivedField) runs on NR_BASE_PTC
  {
    if (p_PicsStatement != p_ReceivedField) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_PicsName & " not matching the received statement");
    }
  }

  /*
   * @desc      Function to check EUTRA band in OTDOA provide capabilities
   *            Reference 37.571-2 Table 7.3.1.1.3.3-11
   * @param     p_OtdoaProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_OTDOA_CheckEutraBand(OTDOA_ProvideCapabilities p_OtdoaProvideCapabilities) runs on NR_BASE_PTC
  {
    var OTDOA_ProvideCapabilities v_OtdoaProvideCapabilities;
    var integer i;
    var integer v_BandEUTRA;
    var integer v_BitStringIndex;
    var bitstring v_SuppEutraBandsAccToPICS := f_DeriveSuppEutraBandsFromPics();
    var bitstring v_SuppEutraBandsAccToPICS_v9a0 := f_DeriveSuppEutraBandsFromPics_v9a0();
    var bitstring v_SuppEutraBandsAccToPICS_Chunk;

    v_OtdoaProvideCapabilities := p_OtdoaProvideCapabilities;

    if (not isvalue(v_OtdoaProvideCapabilities.supportedBandListEUTRA)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "SupportedBandListEUTRA not included in OTDOA capabilities");
    }

    // It is no longer checked that number of supported EUTRA bands is at least a subset of the PICS parameters (pc_eBanda_Supp)
    // There may be more bands reported than there are PICS defined for bands

    // Check that all OTDOA reported bands are also set to true in the EUTRA band PICS
    // Check only the bands for which there are PICS; do not check other bands which may or may not be reported
    v_SuppEutraBandsAccToPICS_Chunk := substr(v_SuppEutraBandsAccToPICS, 0, 14); // bands 1 - 14
    f_CheckUE_SupportedEUTRA_Bands_ChunkOtdoa (v_OtdoaProvideCapabilities, v_SuppEutraBandsAccToPICS_Chunk, 0, 14);
    v_SuppEutraBandsAccToPICS_Chunk := substr(v_SuppEutraBandsAccToPICS, 16, 30); // bands 17 - 46
    f_CheckUE_SupportedEUTRA_Bands_ChunkOtdoa (v_OtdoaProvideCapabilities, v_SuppEutraBandsAccToPICS_Chunk, 16, 30);
    v_SuppEutraBandsAccToPICS_Chunk := substr(v_SuppEutraBandsAccToPICS, 47, 1); // band 48
    f_CheckUE_SupportedEUTRA_Bands_ChunkOtdoa (v_OtdoaProvideCapabilities, v_SuppEutraBandsAccToPICS_Chunk, 47, 1);

    if (lengthof(v_OtdoaProvideCapabilities.supportedBandListEUTRA) == maxFBI) {
      //Check supportedBandListEUTRA-v9a0
      if (isvalue (v_OtdoaProvideCapabilities.supportedBandListEUTRA_v9a0)) {
        // @sic R5-150483 sic@
        // It is no longer checked that number of supported EUTRA bands is at least a subset of the PICS parameters (pc_eBanda_Supp)
        // There may be more bands reported than there are PICS defined for bands
        // Check that all OTDOA reported bands are also set to true in the EUTRA band PICS
        for (i := 0; i < lengthof(v_OtdoaProvideCapabilities.supportedBandListEUTRA_v9a0); i := i + 1) {
          v_BandEUTRA := v_OtdoaProvideCapabilities.supportedBandListEUTRA_v9a0[i].bandEUTRA_v9a0;
          v_BitStringIndex := v_BandEUTRA - 1;

          if (not f_Bitstring_BitIsSet(v_SuppEutraBandsAccToPICS_v9a0, v_BitStringIndex)) {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for EUTRA band No. " & int2str(v_BandEUTRA));// @sic R5s240460 add. change sic@
          }
        }
      }
    }
    //Checking of interFreqRSTDmeasurement-r10.
    if (pc_InterFreq_RSTD_WithGaps) {
      if (not(v_OtdoaProvideCapabilities.interFreqRSTDmeasurement_r10 == supported)) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "interFreqRSTDmeasurement_r10 not reported")
      }
    }
    //Checking of OTDOA measurements
    //@sic R5-201624 sic@
    if (pc_OTDOA_interFreqRSTDmeasurement != ispresent (v_OtdoaProvideCapabilities.interFreqRSTDmeasurement_r10)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for interFreqRSTDmeasurement_r10")
    }
    if (pc_OTDOA_additionalNeighbourCellInfoList != ispresent (v_OtdoaProvideCapabilities.additionalNeighbourCellInfoList_r10)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for additionalNeighbourCellInfoList_r10")
    }
    if (pc_OTDOA_prs_id != ispresent (v_OtdoaProvideCapabilities.prs_id_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for prs_id_r14")
    }
    if (pc_OTDOA_tp_separation_via_muting != ispresent (v_OtdoaProvideCapabilities.tp_separation_via_muting_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for tp_separation_via_muting_r14")
    }
    if (pc_OTDOA_additional_prs_config != ispresent (v_OtdoaProvideCapabilities.additional_prs_config_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for additional_prs_config_r14")
    }
    if (pc_OTDOA_prs_based_tbs != ispresent (v_OtdoaProvideCapabilities.prs_based_tbs_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for prs_based_tbs_r14")
    }
    if (pc_OTDOA_additionalPathsReport != ispresent (v_OtdoaProvideCapabilities.additionalPathsReport_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for additionalPathsReport_r14")
    }
    if (pc_OTDOA_densePrsConfig != ispresent (v_OtdoaProvideCapabilities.densePrsConfig_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for densePrsConfig_r14")
    }
    if (ispresent (v_OtdoaProvideCapabilities.maxSupportedPrsBandwidth_r14)) { // @sic R5-214181, R5s211669 sic@
      if (v_OtdoaProvideCapabilities.maxSupportedPrsBandwidth_r14 != pc_OTDOA_maxSupportedPrsBandwidth_r14) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for maxSupportedPrsBandwidth_r14")
      }
    }
    if (pc_OTDOA_prsOccGroup != ispresent (v_OtdoaProvideCapabilities.prsOccGroup_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for prsOccGroup_r14")
    }
    if (pc_OTDOA_prsFrequencyHopping != ispresent (v_OtdoaProvideCapabilities.prsFrequencyHopping_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for prsFrequencyHopping_r14")
    }
    if (ispresent(v_OtdoaProvideCapabilities.maxSupportedPrsConfigs_r14)) { // @sic R5-214181, R5s211669 sic@
      if (v_OtdoaProvideCapabilities.maxSupportedPrsConfigs_r14 != pc_OTDOA_maxSupportedPrsConfigs_r14) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for maxSupportedPrsConfigs_r14")
      }
    }
    if (pc_OTDOA_periodicalReporting != ispresent (v_OtdoaProvideCapabilities.periodicalReporting_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for periodicalReporting_r14")
    }
    if (pc_OTDOA_multiPrbNprs != ispresent (v_OtdoaProvideCapabilities.multiPrbNprs_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for multiPrbNprs_r14")
    }
    if (pc_OTDOA_idleStateForMeasurements != ispresent (v_OtdoaProvideCapabilities.idleStateForMeasurements_r14)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for idleStateForMeasurements_r14")
    }
    if (ispresent(v_OtdoaProvideCapabilities.numberOfRXantennas_r14)) { // @sic R5-214181, R5s211669 sic@
      if (v_OtdoaProvideCapabilities.numberOfRXantennas_r14 != pc_OTDOA_numberOfRXantennas_r14) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for numberOfRXantennas_r14")
      }
    }
    if (pc_OTDOA_motionMeasurements != ispresent (v_OtdoaProvideCapabilities.motionMeasurements_r15)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for motionMeasurements_r15")
    }
    if (pc_OTDOA_interRAT_RSTDmeasurement != ispresent (v_OtdoaProvideCapabilities.interRAT_RSTDmeasurement_r15)){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for interRAT_RSTDmeasurement_r15")
    }

  }

  /*
   * @desc      Function to check ECID Measurements supported in ECID provide capabilities
   *            Reference 37.571-2 Table 7.3.1.1.3.3-12
   * @param     p_EcidProvideCapabilities
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_Ecid (ECID_ProvideCapabilities  p_EcidProvideCapabilities) runs on NR_BASE_PTC
  {
    var integer i;
    var bitstring v_Bitstring := f_ConvertBoolToBit(pc_ECID_Rsrp) &
                                 f_ConvertBoolToBit(pc_ECID_Rsrq) &
                                 f_ConvertBoolToBit(pc_ECID_UeRxTx);

    for (i := 0; i < 2; i := i + 1) {
      if (not (v_Bitstring[i] == p_EcidProvideCapabilities.ecid_MeasSupported[i])) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for ECID measurements");
      }
    }
    //@sic R5-201624 sic@
    if (pc_ECID_ueRxTxSupTDD != ispresent(p_EcidProvideCapabilities.ueRxTxSupTDD_r13)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for ECID ueRxTxSupTDD");
    }
    if (pc_ECID_periodicalReporting != ispresent(p_EcidProvideCapabilities.periodicalReporting_r14)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for ECID periodicalReporting");
    }
    if (pc_ECID_triggeredReporting != ispresent(p_EcidProvideCapabilities.triggeredReporting_r14)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for ECID triggeredReporting");
    }
    if (pc_ECID_idleStateForMeasurements != ispresent(p_EcidProvideCapabilities.idleStateForMeasurements_r14)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for ECID idleStateForMeasurements");
    }
  }

  /*
   * @desc      To check the measurements reported by the UE for different GNSS method and signals
   * @param     p_GNSS_MeasList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckGnssMeasurementList(GNSS_MeasurementList p_GNSS_MeasList) runs on NR_BASE_PTC
  { // NOTE: Function previously called f_POS_CheckAgnssMultiFreq. Renamed as now also non multifrequency signals are checked
    // @sic R5-198966, R5s210633 sic@
    var integer i;
    var boolean v_AgpsSignalSupported := pc_A_GPS_L1C_A or pc_A_GPS_L1C or pc_A_GPS_L2C or pc_A_GPS_L5;
    var boolean v_GlonassSignalSupported := pc_GLONASS_G1 or pc_GLONASS_G2 or pc_GLONASS_G3;
    var boolean v_GalileoSignalSupported := pc_GALILEO_E1 or pc_GALILEO_E5a or pc_GALILEO_E5b or pc_GALILEO_E6 or pc_GALILEO_E5aE5b;
    var boolean v_QzssSignalSupported := pc_QZSS_QZS_L1 or pc_QZSS_QZS_L1C or pc_QZSS_QZS_L2C or pc_QZSS_QZS_L5;
    var boolean v_BdsSignalSupported := pc_BDS_B1I or pc_BDS_B1C or pc_BDS_B2a or pc_BDS_B3I; //@sic R5-241577 sic@
    //@sic R5s201403 sic@
    //Check the measurements reported by the UE
    for (i:=0; i<lengthof(p_GNSS_MeasList); i:=i+1) {
      select (p_GNSS_MeasList[i].gnss_ID.gnss_id){
        case(gps){
          if (v_AgpsSignalSupported){
            f_POS_NR_CheckSignalsGps(p_GNSS_MeasList[i].gnss_SgnMeasList);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Measurement reported for A-GPS but not supported by UE");
          }
        }
        case(glonass){
          if (v_GlonassSignalSupported){
            f_POS_NR_CheckSignalsGlonass(p_GNSS_MeasList[i].gnss_SgnMeasList);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Measurement reported for Glonass but not supported by UE");
          }
        }
        case(galileo){
          if (v_GalileoSignalSupported){
            f_POS_NR_CheckSignalsGalileo(p_GNSS_MeasList[i].gnss_SgnMeasList);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Measurement reported for Galileo but not supported by UE");
          }
        }
        case(qzss){
          if (v_QzssSignalSupported){
            f_POS_NR_CheckSignalsQzss(p_GNSS_MeasList[i].gnss_SgnMeasList);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Measurement reported for Qzss but not supported by UE");
          }
        }
        case(bds){ // @sic R5s201610, R5s210633 sic@
          if (v_BdsSignalSupported){
            f_POS_NR_CheckSignalsBds(p_GNSS_MeasList[i].gnss_SgnMeasList);
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Measurement reported for Bds but not supported by UE");
          }
        }
        case else {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "UE reported method different to GPS, GLONASS, GALILEO, QZSS or BDS");
        }
      }
    }
  }

  /*
   * @desc      To check the A-GPS signals reported by the UE
   * @param     p_GNSS_SgnMeasList
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckSignalsGps(GNSS_SgnMeasList p_GNSS_SgnMeasList) runs on NR_BASE_PTC
  {// @sic R5-198966, R5s210633 sic@
   var integer i;
   var boolean v_A_GPS_L1C_A_Reported := false;
   var boolean v_A_GPS_L1C_Reported := false;
   var boolean v_A_GPS_L2C_Reported := false;
   var boolean v_A_GPS_L5_Reported := false;

   for (i:=0; i<lengthof(p_GNSS_SgnMeasList); i:=i+1) {
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(0))) {
       v_A_GPS_L1C_A_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(1))) {
       v_A_GPS_L1C_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(2))) {
       v_A_GPS_L2C_Reported := true;
     }
     if (match(p_GNSS_SgnMeasList[i], cr_GNSS_SgnMeasElement(3))) {
       v_A_GPS_L5_Reported := true;
     }
   } //@sic R5s210887 sic@
   if (not((v_A_GPS_L1C_A_Reported == pc_A_GPS_L1C_A) and (v_A_GPS_L1C_Reported == pc_A_GPS_L1C) and (v_A_GPS_L2C_Reported == pc_A_GPS_L2C) and (v_A_GPS_L5_Reported == pc_A_GPS_L5)))
   {
     f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "A-GPS signals not reported correctly");
   }
  }

