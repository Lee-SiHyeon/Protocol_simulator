  template (value) NR_AssignedBWPs_Type cs_NR_AssignedBWPs_NoDedicatedBWP(template (omit) NR_AssignedBWPs_Type.ActiveBWP         p_ActiveBWP := omit,
                                                                          template (omit) NR_AssignedBWPs_Type.InitialBWP        p_InitialBWP := omit,
                                                                          template (omit) NR_AssignedBWPs_Type.InitialBWP_RedCap p_InitialBWP_RedCap := omit,
                                                                          template (omit) NR_AssignedBWPs_Type.CfrBWP             p_CfrBWP := omit
                                                                          ) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    ActiveBWP := p_ActiveBWP,       //in connected mode
    InitialBWP := p_InitialBWP,      //in idle mode
    DedicatedBWPs := {},
    InitialBWP_RedCap := p_InitialBWP_RedCap,  //@sic R5w230008 sic@
    CfrBWP := p_CfrBWP                         //@sic R5w240204 sic@
  };

  template (value) NR_AssignedBWPs_Type cs_NR_AssignedBWPs_ActiveBWP :=
   /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
