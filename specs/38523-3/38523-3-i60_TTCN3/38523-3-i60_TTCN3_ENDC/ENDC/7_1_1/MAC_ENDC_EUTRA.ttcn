  function f_TC_7_1_1_4_2_5_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // UL-SCH Transport Block Size selection / DCI format 0_0 / Transform precoding and 64QAM
    f_TC_7_1_1_4_x_x_ENDC_EUTRA();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.9.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_9_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // MAC Reset
    f_EUTRA38_Init(EN_DC, c1);
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON);
    f_EUTRA_TestBody_Set(true);
    fl_TC_7_1_1_9_1_ENDC_EUTRA_TestBody ();
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);

    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_7_1_1_9_1_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_7_1_1_9_1_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
  
    // Wait for RRC Reconfiguration message to be handed over in step 3 from NR PTC and then handle it
    f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, SCG_RBConfig); //@sic R5s220716 sic@
    
    // Wait for RRC Reconfiguration message to be handed over in step 22 from NR PTC and then handle it
    f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, SCG_RBConfig); //@sic R5s220716 sic@

  };

}
