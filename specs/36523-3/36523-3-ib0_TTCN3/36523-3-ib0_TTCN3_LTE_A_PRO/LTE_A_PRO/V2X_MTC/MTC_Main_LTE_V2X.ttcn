module MTC_Main_LTE_V2X {

  import from EUTRA_V2X_Component all;
  import from MTC_Base all;
  import from MTC_Component_LTE_V2X all;
  import from MTC_Main_LTE_SL all;
  import from MTC_UpperTester all;
  import from PosSystem_ASP_TypeDefs all;
  import from SideLink_Component all;
  import from TestcaseProperties all;
  import from UpperTesterSystemCmds all;

  /*
   * @desc      Connect all PTCs (LTE test cases)
   * @param     p_System
   * @param     p_Eutra
   * @param     p_SideLink
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_MTC_ConnectPTCs_LTE_V2X(SYSTEM_LTE_V2X p_System,
                                     EUTRA_V2X_PTC p_Eutra,
                                     SideLink_PTC p_SideLink) runs on MTC_LTE_V2X
  { //Comment: MTC_LTE_V2X needed for POSSYS port mapping
    var boolean v_MapPOSSYS := f_GetTestcaseAttrib_SpecificMTC_SatPort(testcasename());

    f_MTC_ConnectPTCs_LTE_SL_Common(p_System, p_Eutra, p_SideLink);

    // ***** MTC *****
    f_MTC_BASE_Map(p_System);    // Map MTC's system ports

    if (v_MapPOSSYS) {
      map(mtc:POSSYS, p_System:POSSYS);
      connect(mtc:EUTRA_POSSYS, p_Eutra:POSSYS);
    }

    f_UT_InitialPowerOffUE(Ut);
  }

  /*
   * @desc   Default handler for received event from POSSYS
   * @status    APPROVED (LTE_A_PRO)
   */
  altstep a_V2X_POSSYS_ReceiveFromSystem_SendToPTC() runs on MTC_LTE_V2X
  {
    var POS_SYSTEM_CTRL_CNF v_POS_SYSTEM_CTRL_CNF;
    
    [] POSSYS.receive(car_POS_SYSTEM_CTRL_CNF_Any) -> value v_POS_SYSTEM_CTRL_CNF // @sic R5-255776 sic@
      {
        EUTRA_POSSYS.send(v_POS_SYSTEM_CTRL_CNF);
      }
  }

  /*
   * @desc      Default handler for received event from EUTRA_POSSYS
   * @status    APPROVED (LTE_A_PRO)
   */
  altstep a_V2X_POSSYS_ReceiveFromPTC_SendToSystem() runs on MTC_LTE_V2X
  {
    var POS_SYSTEM_CTRL_REQ v_POS_SYSTEM_CTRL_REQ;

    [] EUTRA_POSSYS.receive(car_POS_SYSTEM_CTRL_REQ_Any) -> value v_POS_SYSTEM_CTRL_REQ // @sic R5-255776 sic@
      {
        POSSYS.send(v_POS_SYSTEM_CTRL_REQ);
      }
  }

  /*
   * @desc      Main loop of the MTC
   * @param     p_GuardTimer
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_MTC_MainLoop_LTE_V2X(timer p_GuardTimer) runs on MTC_LTE_V2X
  {
    f_MTC_BASE_Init();

    while (true) {      /* mtc will be stopped by a_PTC_Control_LTE_D2D or due to timeout of the guard timer;
                           => neither a_PTC_Control_LTE_D2D nor a_UpperTester needs to use 'repeat' */
      alt {
        [] a_PTC_Control_LTE_SL();             // handle 'done' and 'killed' of PTCs: MTC will be stopped, when all PTCs are terminated or a fatal error occurs
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_EUTRA);    // handle upper tester for PTC 0 (EUTRA)
        [] a_MTC_ReceiveFromUT_SendToPTC();

        [] a_V2X_POSSYS_ReceiveFromPTC_SendToSystem();
        [] a_V2X_POSSYS_ReceiveFromSystem_SendToPTC();

        [] p_GuardTimer.timeout {f_MTC_Stop(fail);}    /* acc. to the assumption that preamble and postamble are short compared to the testbody
                                                          a FAIL verdict is assigned (rather than an INCONC) */
      }
    }
  }

}
