module SS_CommonTemplates {

  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from CommonDefs all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTypeDefs all;
  import from UTRAN_NAS_PDU_Templates all;

  const B7_Type tsc_SS_CauValue_NormalUnspecified := '0011111'B;                /* @status    APPROVED (POS) */

  const CMServType tsc_SupplementaryServiceActivation := '1000'B;               /* CM Service Type: Supplementary Service Activation. See 24.008, 10.5.3.3
                                                                                   @status    APPROVED (POS, SSNITZ) */

  const InvokeIdType tsc_InvokeId := 100;                                       /* Invoke ID to be used in messages sent by the System Simulator. This value has been chosen randomly.
                                                                                   @status    APPROVED (POS, SSNITZ) */

  group Common_Templates {

  template (present) REGISTER cr_RegisterMO(template (present) FacilityIE p_Facility,
                                            template SS_VersionInd p_SSVersionInd) :=  // @sic R5s150605 sic@
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := cr_TI_MO,     // TI flag '0'
    sS_ProtocolDiscriminator := tsc_PD_SS,
    msgType         := '??111011'B,
    facility_Str    := p_Facility,
    sS_VersionInd   := p_SSVersionInd
  };

  template (value) REGISTER cs_RegisterMT(template (value) TI p_TI,
                                          template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := p_TI,
    sS_ProtocolDiscriminator := tsc_PD_SS,
    msgType         := '00111011'B,
    facility_Str    := p_Facility,
    sS_VersionInd   := omit
  };

  template (present) Components cr_Components(template (present) Component p_Component) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    p_Component
  };

  template (value) Components cs_Components (template (value) Component p_Component) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    p_Component
  };

  template (present) Component cr_InvokeComponent(template (present) Invoke p_Invoke) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    invoke := p_Invoke
  };

  template (value) Component cs_InvokeComponent (template (value) Invoke p_Invoke) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    invoke := p_Invoke
  };

  template (value) Component cs_ReturnResult (template (value) ReturnResult p_ReturnRes) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnResultLast := p_ReturnRes
  };

  template (present) Component cr_ReturnResult (template (present) ReturnResult p_ReturnRes) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnResultLast := p_ReturnRes
  };

  template (value) Component cs_ReturnError (template (value) ReturnError p_ReturnError) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnError := p_ReturnError
  };

  template (present) SS_VersionInd cr_SS_VersionIndOneOrAbove :=
  { /* @status    APPROVED (POS) */
    iei             := '7F'O,
    iel             := ?,
    sS_VersionInfo  := complement ('00'O)
  };

  template (value) Cau cs_SS_Cau(B7_Type p_CauValue) := cs_Cau_Common(-, tsc_CodingStd_GSM, tsc_Location_User, p_CauValue);  /* @status    APPROVED (POS, SSNITZ) */

  template (present) RELEASECOMPLETE cr_ReleaseCompleteFacility(template (present) TI p_TI,
                                                                template (present) FacilityIE p_Facility,
                                                                template ProtocolDiscriminator p_PD := tsc_PD_SS) :=
  /* @status    APPROVED (POS, SSNITZ) */
    cr_ReleaseComplete(p_TI, -, p_Facility, p_PD); // @sic R5s140884 sic@

  template (value) RELEASECOMPLETE cs_ReleaseComplete(template (value) TI p_TI,
                                                      template (omit) Cau p_Cau := cs_SS_Cau(tsc_SS_CauValue_NormalUnspecified), //@sic R5s140088, R5-140606, R5-140608 sic@
                                                      template (omit) FacilityIE p_Facility := omit) :=
  /* @status    APPROVED (POS) */
    cs_RelCmpl_Common (p_TI, tsc_PD_SS, p_Cau, p_Facility);

  template (value) FACILITY cs_Facility(template (value) TI p_TI,
                                        ProtocolDiscriminator p_PD := tsc_PD_SS,
                                        template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := p_TI,     // TI flag '0'
    sS_ProtocolDiscriminator := p_PD,
    msgType         := '00111010'B,
    facility_Str    := valueof (p_Facility)
  };

  template (value) FacilityIE cs_FacilityIE(template (omit) O1_Type p_IEI,
                                            octetstring p_ComponentsOct) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    iei        := p_IEI,
    iel        := int2oct(lengthof(p_ComponentsOct),1),
    components := p_ComponentsOct
  };

  template (value) FacilityIE cs_FacilityIE_lv(octetstring p_ComponentsOct) := cs_FacilityIE(omit, p_ComponentsOct);    /* @status    APPROVED (POS, SSNITZ) */

  template (value) FacilityIE cs_FacilityIE_tlv(octetstring p_ComponentsOct) := cs_FacilityIE('1C'O, p_ComponentsOct);  /* @status    APPROVED (POS, SSNITZ) */

  template (present) FacilityIE cr_FacilityIE(template O1_Type p_IEI,
                                              template (present) octetstring p_ComponentsOct) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    iei        := p_IEI,
    iel        := ?,
    components := p_ComponentsOct
  };

  template (present) FacilityIE cr_FacilityIE_tlv (template (present) octetstring p_ComponentsOct := ?) := cr_FacilityIE('1C'O, p_ComponentsOct); /* @status    APPROVED (POS, SSNITZ) */

  } // end of group Common_Templates

}
