   * @status    APPROVED (IMS)
   */
  function f_IMS_PTC_RanTypeIsUTRAN() runs on IMS_PTC return boolean
  {
    return (fl_IMS_PTC_CheckRanType(UTRAN_FDD) or fl_IMS_PTC_CheckRanType(UTRAN_TDD));
