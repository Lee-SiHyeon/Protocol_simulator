module MCPTT_ClientConfiguration_MCX_IMS {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from MCPTT_MediaControl_Procedures all;
  import from MCPTT_SIP_CallControl all;
  import from MCX_ClientConfiguration_MCX_IMS all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_Parameters all;
  import from MCX_SDP_MCPTT_MCVideo all;
  import from MCX_SIP_CallControl_Common all;
  import from MCX_SIP_CallControl_MCPTT_MCVideo all;
  import from MCX_SIP_Common all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.579-2 clause 5.1
   * @status    APPROVED (MCX)
   */
  function f_TC_5_1_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // Configuration / Authentication / User Authorisation / UE Configuration / User Profile / Key Generation
    f_MCX_5_1_IMS(MCPTT);   // @sic R5-220489 sic@
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 5.3
   * @status    APPROVED (MCX)
   */
  function f_TC_5_3_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // Configuration / Group Affiliation / Remote change / De-affiliation / Home MCPTT system
    f_MCX_5_3_IMS(MCPTT);   // @sic R5-220491, R5-220500 sic@
  }

  /*
   * @desc      Receive UPDATE, send 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_SdpInfoRX
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_ReceiveUPDATE_Send200OK(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                           template (present) MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX) runs on MCX_IMS_PTC
  {
    var MCX_SessionType_Type v_SessionType := valueof(p_SdpInfoRX.CheckInfo.SessionType);
    var template (present) SipUrl v_RequestUrl := f_IMS_PTC_ImsInfo_GetContactUrlSS();  /* @sic R5w220111, R5-223945: global variable ContactUrlSS sic@ */
    var template (present) SipUrl v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    var template (present) SemicolonParam_List v_MandatoryContactParams := f_MCX_SIP_CallControl_ContactParams_RX(MCPTT, PRE_EST_SESSION_ESTAB_MOD);
    var template (present) MessageHeader v_MessageHeader_Update;
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var UPDATE_Request v_UpdateRequest;
    var SDP_Message v_SdpOffer;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL;
    var template (value) SDP_Message v_SdpAnswer;

    v_MessageHeader_Update := f_IMS_UpdateRequest_MessageHeaderRX(p_InviteRequestWithSdp.Invite, -, v_ContactUrlUE, v_MandatoryContactParams);
    v_IMS_DATA_REQ := f_IMS_ReceiveRequest(car_IMS_Update_Request(cr_UPDATE_Request(v_RequestUrl, v_MessageHeader_Update, cr_MessageBody_SDP)));
    v_UpdateRequest := v_IMS_DATA_REQ.Request.Update;
    v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo);

    v_SdpOffer := valueof(f_MCPTT_MCVideo_DecodeMatchAndCheckSDP(MCPTT, v_UpdateRequest.messageBody, p_SdpInfoRX));
    v_SdpAnswer := f_MCX_SdpAnswer_TX(MCPTT, v_SessionType, v_SdpOffer);
    
    f_MCX_InviteMO_Send200OK(MCPTT, v_UpdateRequest.msgHeader, v_RoutingInfo_DL, v_SdpAnswer);
  }

  /*
   * @desc      Send UPDATE, receive 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_SdpOffer
   * @param     p_SdpInfoAnswer
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_SendUPDATE_Receive200OK(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                           template (value) SDP_Message p_SdpOffer,
                                           template (present) MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoAnswer) runs on MCX_IMS_PTC
  {
    var SipUrl v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    var template (value) Contact v_ContactSS := f_MCX_CallSetup_ContactSS(MCPTT);      // same Contact as in the response for the INVITE creating the dialog (200 OK)
    var template (value) SipUrl v_ContactSipUrlSS := f_Contact_GetSipUrl(v_ContactSS);
    var template (value) HostPort v_HostPortSS := v_ContactSipUrlSS.components.sip.hostPort;
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    var template (value) MessageHeader v_MessageHeaderUpdate;
    var template (value) IMS_DATA_REQ v_IMS_DATA_REQ;

    v_MessageHeaderUpdate := f_IMS_UpdateRequest_MessageHeaderTX(p_InviteRequestWithSdp.Invite, -, v_ContactSS, v_HostPortSS);  /* @sic R5s240228: v_HostPortSS sic@ */
    v_IMS_DATA_REQ := cas_IMS_Update_Request(cs_IMS_RoutingInfo(v_Protocol), cs_UPDATE_Request(v_ContactUrlUE, v_MessageHeaderUpdate, cs_MessageBody_SDP(p_SdpOffer)));
    IMS_Client.send(v_IMS_DATA_REQ);

    f_MCPTT_MCVideo_InviteUpdateMT_Receive200OK(MCPTT, -, v_MessageHeaderUpdate, v_Protocol, -, PRE_EST_SESSION_ESTAB_MOD, p_SdpInfoAnswer);
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 5.4
   * @status    APPROVED (MCX)
   */
  function f_TC_5_4_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // Configuration / Pre-established Session Establishment / Pre-established Session Modification / Pre-established Session Release
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdpMO;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdpMT;
    var template (present) MCPTT_MCVideo_SdpInfoRX_Type v_SdpInfoRX;
    var template (value) SDP_Message v_SdpMessageTX;
    var charstring v_FmtAudio;
    var integer v_MC_Priority;
    
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);    // even though the test case does not establish a call, it activates the dedicated EPS bearer
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 2" siclog@    Make the MCPTT User request the creation of a pre-established session without implicit floor request
    
    v_InviteRequestWithSdpMO := f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCPTT);
    v_FmtAudio := f_MCX_SdpOffer_GetFmtAudio(v_InviteRequestWithSdpMO.SdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 2A - 3A Void" siclog@

    // @siclog "Step 4" siclog@
    if (pc_MCX_UserInitiatedPreestablishedSessionModification) {
    
      // @siclog "Step 4a2" siclog@
      f_MCX_IPCAN_StartSignalling(IPCAN_MO_IMS_Signalling);                     // @sic R5-213659 sic@

      // @siclog "Step 4a1" siclog@
      f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request to modify the pre-established session by requesting usage of implicit floor control");
      
      v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, PRE_ESTABLISHED, -, SDP_OFFER, withImplictGrantRequest);     // @sic R5s220129 - Additional change: withImplictGrantRequest sic@
      
      alt {
        [] IMS_Server.check(receive(car_IMS_Update_Request(cr_UPDATE_Request(?)))) {
          // @siclog "Step 5a1 - 5a2" siclog@
          f_MCPTT_ReceiveUPDATE_Send200OK(v_InviteRequestWithSdpMO, v_SdpInfoRX);
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5a1");
        }
        [] IMS_Server.check(receive(car_IMS_Invite_Request(cr_INVITE_Request(?)))) {
          // @siclog "Step 5b" siclog@
          f_MCPTT_MCVideo_PreestablishedSession_Establishment(MCPTT, -, v_SdpInfoRX, tsc_MCX_ReInvite);
          f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5b1");
        }
      }
    } else {
      // @siclog "Step 6Aa1" siclog@
      f_MCX_IPCAN_StartSignalling(IPCAN_MT_IMS_Signalling);                     // @sic R5-213659 sic@
    }
    
    // @siclog "Step 7 - 8" siclog@
    v_MC_Priority := 2;
    v_SdpMessageTX := f_MCX_SdpOffer_TX(MCPTT, PRE_ESTABLISHED, -, v_FmtAudio, -, -, v_MC_Priority);
    v_SdpInfoRX := f_MCX_SdpInfo_RX(MCPTT, PRE_ESTABLISHED, -, SDP_ANSWER);
    v_SdpInfoRX.CheckInfo.NonDefaultPriority := v_MC_Priority;                  // @sic R5s220129: NonDefaultPriority sic@
    f_MCPTT_SendUPDATE_Receive200OK(v_InviteRequestWithSdpMO, v_SdpMessageTX, v_SdpInfoRX);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    v_MC_Priority := 3;
    v_SdpMessageTX := f_MCX_SdpOffer_TX(MCPTT, PRE_ESTABLISHED, -, v_FmtAudio, -, -, v_MC_Priority);
    v_SdpInfoRX.CheckInfo.NonDefaultPriority := v_MC_Priority;                  // @sic R5s220129: NonDefaultPriority sic@

    // @siclog "Step 9" siclog@
    v_InviteRequestWithSdpMT := f_MCPTT_MCVideo_InviteMT_SendINVITE(MCPTT, -, -, -, -, v_SdpMessageTX, -, tsc_MCX_ReInvite);
    f_MCPTT_MCVideo_InviteMT_Receive200OK_SendACK(MCPTT, -, v_InviteRequestWithSdpMT, -, PRE_EST_SESSION_ESTAB_MOD, v_SdpInfoRX);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    // @siclog "Step 10 Void" siclog@

    // @siclog "Step 11 - 12" siclog@    Make the MCPTT User request to release the pre-established session
    f_MCX_CallReleaseMO(v_InviteRequestWithSdpMO.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 13 Void" siclog@
    
    // @siclog "Step 14 - 15" siclog@ Make the MCPTT User request the creation of a pre-established session
    v_InviteRequestWithSdpMO := f_MCPTT_MCVideo_PreestablishedSession_Establishment_Initial(MCPTT);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    // @siclog "Step 15A - 16A Void" siclog@

    // @siclog "Step 17" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 17");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 5.6
   * @status    APPROVED (MCX)
   */
  function f_TC_5_6_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // Configuration / Download CSK

    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCX_CSK_Download(MCPTT);               // @sic R5-232595: f_MCX_CSK_Download sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 2 Void" siclog@
    
    // @siclog "Step 3" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a group call with automatic commencement mode and implicit floor request");
    
    // @siclog "Step 4" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(GROUP_CALL, -, -, withImplictGrantRequest, implicitRequestGranted);    // 36.579-1 table 5.3A.1.3-1 NOTE1 b.i
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    // @siclog "Step 5" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 5");
    
    // @siclog "Step 6" siclog@
    f_UT_MCX_PTTOff(MMI);             // Make the UE (MCPTT client) release the floor
    
    // @siclog "Step 7" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 8 - 9" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    f_IMS_TestBody_Set(false);

    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 5.8.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_5_8_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // Configuration / Functional Alias / Functional alias status determination / Activate functional alias / Deactivate functional alias
    f_MCX_5_8_IMS(MCPTT);
  }

}
