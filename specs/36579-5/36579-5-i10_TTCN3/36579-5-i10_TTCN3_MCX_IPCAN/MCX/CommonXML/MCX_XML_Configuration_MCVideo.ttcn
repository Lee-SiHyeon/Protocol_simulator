   * @return    MCVideo_UserProfile_Extension_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCVideo_UserProfile_Extension() return MCVideo_UserProfile_Extension_Type
  {
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_presence_status                                   v_Allow_presence_status := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_request_presence                                  v_Allow_request_presence := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_query_availability_for_private_calls              v_Allow_query_availability_for_private_calls := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_enable_disable_user                               v_Allow_enable_disable_user := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_enable_disable_UE                                 v_Allow_enable_disable_UE := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_private_call                                      v_Allow_private_call := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_manual_commencement                               v_Allow_manual_commencement := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_automatic_commencement                            v_Allow_automatic_commencement := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_force_auto_answer                                 v_Allow_force_auto_answer := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_failure_restriction                               v_Allow_failure_restriction := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_emergency_group_call                              v_Allow_emergency_group_call := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_emergency_private_call                            v_Allow_emergency_private_call := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_cancel_group_emergency                            v_Allow_cancel_group_emergency := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_cancel_private_emergency_call                     v_Allow_cancel_private_emergency_call := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_imminent_peril_call                               v_Allow_imminent_peril_call := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_cancel_imminent_peril                             v_Allow_cancel_imminent_peril := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_activate_emergency_alert                          v_Allow_activate_emergency_alert := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_cancel_emergency_alert                            v_Allow_cancel_emergency_alert := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_offnetwork                                        v_Allow_offnetwork := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_imminent_peril_change                             v_Allow_imminent_peril_change := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_private_call_media_protection                     v_Allow_private_call_media_protection := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_request_affiliated_groups                         v_Allow_request_affiliated_groups := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_request_to_affiliate_other_users                  v_Allow_request_to_affiliate_other_users := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_recommend_to_affiliate_other_users                v_Allow_recommend_to_affiliate_other_users := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_private_call_to_any_user                          v_Allow_private_call_to_any_user := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_regroup                                           v_Allow_regroup := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_private_call_participation                        v_Allow_private_call_participation := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_manual_off_network_switch                         v_Allow_manual_off_network_switch := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_off_network_group_call_change_to_emergency        v_Allow_off_network_group_call_change_to_emergency := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_revoke_transmit                                   v_Allow_revoke_transmit := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_create_group_broadcast_group                      v_Allow_create_group_broadcast_group := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_create_user_broadcast_group                       v_Allow_create_user_broadcast_group := true;

    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_request_remote_initiated_ambient_viewing          v_Allow_request_remote_initiated_ambient_viewing := true;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.Allow_request_locally_initiated_ambient_viewing         v_Allow_request_locally_initiated_ambient_viewing := true;

    var urn_3gpp_ns_mcvideo_user_profile_1_0.AnyExt v_AnyExt;
    var urn_3gpp_ns_mcvideo_user_profile_1_0.AnyExt.elem_list v_AnyExtElemList;
    var template (value) ExtensibleType v_Actions;
    var template (value) urn_ietf_params_xml_ns_common_policy.RuleType v_Rule;
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_Ruleset;
    var MCVideo_UserProfile_Extension_Type v_Extension;

    v_AnyExtElemList := {
      f_Bit2XsdString(encvalue(v_Allow_request_remote_initiated_ambient_viewing)),
      f_Bit2XsdString(encvalue(v_Allow_request_locally_initiated_ambient_viewing))
    };

    v_AnyExt := {
      elem_list := v_AnyExtElemList
    };

    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_Allow_presence_status)),
        f_Bit2XsdString(encvalue(v_Allow_request_presence)),
        f_Bit2XsdString(encvalue(v_Allow_query_availability_for_private_calls)),
        f_Bit2XsdString(encvalue(v_Allow_enable_disable_user)),
        f_Bit2XsdString(encvalue(v_Allow_enable_disable_UE)),
        f_Bit2XsdString(encvalue(v_Allow_private_call)),
        f_Bit2XsdString(encvalue(v_Allow_manual_commencement)),
        f_Bit2XsdString(encvalue(v_Allow_automatic_commencement)),
        f_Bit2XsdString(encvalue(v_Allow_force_auto_answer)),
        f_Bit2XsdString(encvalue(v_Allow_failure_restriction)),
        f_Bit2XsdString(encvalue(v_Allow_emergency_group_call)),
        f_Bit2XsdString(encvalue(v_Allow_emergency_private_call)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_group_emergency)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_private_emergency_call)),
        f_Bit2XsdString(encvalue(v_Allow_imminent_peril_call)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_imminent_peril)),
        f_Bit2XsdString(encvalue(v_Allow_activate_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_offnetwork)),
        f_Bit2XsdString(encvalue(v_Allow_imminent_peril_change)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_media_protection)),
        f_Bit2XsdString(encvalue(v_Allow_request_affiliated_groups)),
        f_Bit2XsdString(encvalue(v_Allow_request_to_affiliate_other_users)),
        f_Bit2XsdString(encvalue(v_Allow_recommend_to_affiliate_other_users)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_to_any_user)),
        f_Bit2XsdString(encvalue(v_Allow_regroup)),
        f_Bit2XsdString(encvalue(v_Allow_private_call_participation)),
        f_Bit2XsdString(encvalue(v_Allow_manual_off_network_switch)),
        f_Bit2XsdString(encvalue(v_Allow_off_network_group_call_change_to_emergency)),
        f_Bit2XsdString(encvalue(v_Allow_revoke_transmit)),
        f_Bit2XsdString(encvalue(v_Allow_create_group_broadcast_group)),
        f_Bit2XsdString(encvalue(v_Allow_create_user_broadcast_group)),

        f_Bit2XsdString(encvalue(v_AnyExt))                            // @sic R5-221545 sic@
      }
    };

    v_Rule := cs_MCX_CP_Rule("rule1", v_Actions);
    v_Ruleset := cs_MCX_CP_Ruleset(v_Rule);
    
    v_Extension := {
      f_Bit2XsdString(encvalue(v_Ruleset))
    };
    return v_Extension;
  }

