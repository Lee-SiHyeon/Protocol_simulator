module MCX_XML_GroupConfiguration_MCPTT {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_GroupConfiguration_Common all;
  import from MCX_XML_common_policy all;
  import from TestcaseProperties all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttGroupInfo_1_0 language "XSD" all;        
  import from urn_ietf_params_xml_ns_common_policy language "XSD" all;  
  import from urn_oma_xml_poc_list_service language "XSD" all;          
  import from urn_oma_xml_xdm_extensions language "XSD" all;            

  /*
   * @desc      Build entry for MCPTT Group Member List
   * @param     p_URI
   * @param     p_UserPriority
   * @param     p_ParticipantType
   * @return    template (value) MCX_ResourceLists_EntryType_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_GroupMemberListEntryTX(XSD.AnyURI p_URI,
                                          urn_3gpp_ns_mcpttGroupInfo_1_0.User_priority p_UserPriority,
                                          urn_3gpp_ns_mcpttGroupInfo_1_0.Participant_type p_ParticipantType) return template (value) MCX_ResourceLists_EntryType_Type
  {
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Multi_talker_allowed v_Multi_talker_allowed := {};
    var MCX_ResourceLists_EntryType_Type.elem_list v_AdditionalExtensions := {
      f_Bit2XsdString(encvalue(v_Multi_talker_allowed))          // @sic R5-213266 sic@
    };
    return f_MCX_GroupMemberListEntryTX_Common(p_URI, p_UserPriority, p_ParticipantType, v_AdditionalExtensions);
  }

  /*
   * @desc      Setup MCPTT Group Ruleset for MCPTT Group Configuration
   * @param     p_Id                (default value: "rule1")
   * @return    template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_GroupRuleset(XSD.ID p_Id := "rule1") return template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
  { /* cp:ruleset for "rule1" according to Table 5.5.7.1-1: MCPTT Group Configuration Defaults */
    var urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_allow_getting_member_list      v_On_network_allow_getting_member_list := true;
    var urn_oma_xml_poc_list_service.Allow_initiate_conference                   v_Allow_initiate_conference := true;
    var urn_oma_xml_poc_list_service.Join_handling                               v_Join_handling := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Allow_MCPTT_emergency_call                v_Allow_MCPTT_emergency_call := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Allow_imminent_peril_call                 v_Allow_imminent_peril_call := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Allow_MCPTT_emergency_alert               v_Allow_MCPTT_emergency_alert := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_allow_getting_affiliation_list v_On_network_allow_getting_affiliation_list := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_allow_conference_state         v_On_network_allow_conference_state := true;
    var template (value) ExtensibleType v_Actions;
    var template (value) CP_Rule_Type v_Rule;

    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_On_network_allow_getting_member_list)),
        f_Bit2XsdString(encvalue(v_Allow_initiate_conference)),
        f_Bit2XsdString(encvalue(v_Join_handling)),
        f_Bit2XsdString(encvalue(v_Allow_MCPTT_emergency_call)),
        f_Bit2XsdString(encvalue(v_Allow_imminent_peril_call)),
        f_Bit2XsdString(encvalue(v_Allow_MCPTT_emergency_alert)),
        f_Bit2XsdString(encvalue(v_On_network_allow_getting_affiliation_list)),
        f_Bit2XsdString(encvalue(v_On_network_allow_conference_state))
      }
    };
    v_Rule := cs_MCX_CP_Rule(p_Id, v_Actions);
    
    return cs_MCX_CP_Ruleset(v_Rule);
  }

  /*
   * @desc      Setup MCPTT Group Extensions for MCPTT Group Configuration
   * @param     p_Owner
   * @param     p_PreferredVoiceCodec
   * @param     p_Off_network_ProSe_layer_2_group_id
   * @return    MCX_PocListService_ListService_Type.elem_list
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_Group_Extensions_mcpttgi(urn_3gpp_ns_mcpttGroupInfo_1_0.Owner p_Owner,
                                            XSD.String p_PreferredVoiceCodec,
                                            urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_layer_2_group_id p_Off_network_ProSe_layer_2_group_id) return MCX_PocListService_ListService_Type.elem_list
  {
    var template (value) MCX_GroupInfo_Encodings_Type v_Preferred_voice_encodings := cs_MCX_GroupInfo_Encodings(p_PreferredVoiceCodec);
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_group_hierarchy v_Level_within_group_hierarchy := 0;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_user_hierarchy v_Level_within_user_hierarchy := 0;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Protect_media v_Protect_media := tsc_MCX_XML_ConfidentialityProtection;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Protect_floor_control_signalling v_Protect_floor_control_signalling := tsc_MCX_XML_ConfidentialityProtection;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_IP_multicast_address v_Off_network_IP_multicast_address := "0.0.0.0";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_relay_service_code v_Off_network_ProSe_relay_service_code := char2oct("123456");
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_in_progress_emergency_state_cancellation_timeout v_Off_network_in_progress_emergency_state_cancellation_timeout := "PT18H12M15S";            // 65535s see e.g.http://www.datypic.com/sc/xsd/t-xsd_duration.html
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_in_progress_imminent_peril_state_cancellation_timeout v_Off_network_in_progress_imminent_peril_state_cancellation_timeout := "PT18H12M15S";  // 65535s see e.g.http://www.datypic.com/sc/xsd/t-xsd_duration.html
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_hang_timer v_Off_network_hang_timer := "PT5S";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_maximum_duration v_Off_network_maximum_duration := "PT1M";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_queue_usage v_Off_network_queue_usage := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_signalling_PPPP v_Off_network_ProSe_signalling_PPPP := '01'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_media_PPPP v_Off_network_ProSe_media_PPPP := '01'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_emergency_call_signalling_PPPP v_Off_network_ProSe_emergency_call_signalling_PPPP := '08'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_emergency_call_media_PPPP v_Off_network_ProSe_emergency_call_media_PPPP := '08'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_imminent_peril_call_signalling_PPPP v_Off_network_ProSe_imminent_peril_call_signalling_PPPP := '07'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_imminent_peril_call_media_PPPP v_Off_network_ProSe_imminent_peril_call_media_PPPP := '07'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Multi_talker_control v_Multi_talker_control := false;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Max_number_simultaneous_talkers v_Max_number_simultaneous_talkers := 1;
    var MCX_PocListService_ListService_Type.elem_list v_Extension;
    
    if (f_GetTestcaseAttrib_Multi_talker(testcasename())) {   // test case 6.1.1.20
      v_Multi_talker_control := true;
      v_Max_number_simultaneous_talkers := 2;
    }

    v_Extension := {
      f_Bit2XsdString(encvalue(p_Owner)),
      f_Bit2XsdString(encvalue(v_Preferred_voice_encodings)),
      f_Bit2XsdString(encvalue(v_Level_within_group_hierarchy)),                // @sic R5s220869 Change 2 sic@
      f_Bit2XsdString(encvalue(v_Level_within_user_hierarchy)),                 // @sic R5s220869 Change 2 sic@
      f_Bit2XsdString(encvalue(v_Protect_media)),
      f_Bit2XsdString(encvalue(v_Protect_floor_control_signalling)),
      f_Bit2XsdString(encvalue(p_Off_network_ProSe_layer_2_group_id)),
      f_Bit2XsdString(encvalue(v_Off_network_IP_multicast_address)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_relay_service_code)),
      f_Bit2XsdString(encvalue(v_Off_network_in_progress_emergency_state_cancellation_timeout)),
      f_Bit2XsdString(encvalue(v_Off_network_in_progress_imminent_peril_state_cancellation_timeout)),
      f_Bit2XsdString(encvalue(v_Off_network_hang_timer)),
      f_Bit2XsdString(encvalue(v_Off_network_maximum_duration)),
      f_Bit2XsdString(encvalue(v_Off_network_queue_usage)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_emergency_call_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_emergency_call_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_imminent_peril_call_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_imminent_peril_call_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Multi_talker_control)),                        // @sic R5-213266 sic@
      f_Bit2XsdString(encvalue(v_Max_number_simultaneous_talkers))              // @sic R5-213266 sic@
    };
    return v_Extension;
  }

  /*
   * @desc      36.579-1 Table 5.5.7.1-1: MCPTT Group Configuration Defaults
   * @param     p_Regrouped         (default value: omit)
   * @return    template (value) MCX_PocListService_Group_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_GroupConfiguration(template (omit) urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_regrouped p_Regrouped := omit) return template (value) MCX_PocListService_Group_Type
  { /* @sic R5-206051: second group removed sic@ */
    var template (value) MCX_PocListService_Group_Type.sequence_list v_GroupList;
    var template (value) MCX_PocListService_ListService_Type v_Group1;
    var template (value) MCX_PocListService_List_Type.entry_list v_GroupMemberList;
    var template (omit)  XSD.NonNegativeInteger v_MaxParticipants := omit;      // not present in Table 5.5.7.1-1
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryA := f_MCPTT_GroupMemberListEntryTX(px_MCPTT_ID_User_A, tsc_MCX_User_A_Priority, px_MCX_User_A_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryB := f_MCPTT_GroupMemberListEntryTX(px_MCPTT_ID_User_B, tsc_MCX_User_B_Priority, px_MCX_User_B_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryC := f_MCPTT_GroupMemberListEntryTX(px_MCPTT_ID_User_C, tsc_MCX_User_C_Priority, px_MCX_User_C_ParticipantType);
    var template (value) urn_oma_xml_xdm_extensions.Supported_services v_SupportedServices := f_MCX_ListServiceExtensions_SupportedService(MCPTT);
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_GroupRuleset;
    var MCX_PocListService_ListService_Type.elem_list v_Extensions := {};

    v_GroupMemberList := {
      v_GroupMemberListEntryA,
      v_GroupMemberListEntryB,
      v_GroupMemberListEntryC
    };
    
    v_GroupRuleset := f_MCPTT_GroupRuleset();

    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_GroupRuleset)));
    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_SupportedServices)));   // @sic R5-214652 change 1 sic@
    v_Extensions := f_MCX_GroupExtensions_Concat(v_Extensions, f_MCPTT_Group_Extensions_mcpttgi(px_MCX_Group_A_Owner_Organization, px_MCPTT_Group_A_preferred_VCodec, tsc_MCX_Group_A_ProSeLayer2GroupID));
    if (isvalue(p_Regrouped)) {
      v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,  f_Bit2XsdString(encvalue(valueof(p_Regrouped))));
    }

    v_Group1 := cs_MCX_PocListService_ListService(px_MCPTT_Group_A_ID,
                                                  cs_MCX_ResourceLists_DisplayName(-, px_MCPTT_Group_A_Name),
                                                  cs_MCX_PocListService_List(v_GroupMemberList),
                                                  v_MaxParticipants,
                                                  v_Extensions);
    v_GroupList := {
      { list_service := v_Group1 }
    };
    
    return cs_MCX_PocListService_Group(v_GroupList);
  }

  const MCX_GroupInfo_ConstituentGroupList_Type tsc_MCPTT_GroupInfo_ConstituentGroupList_A_B := { px_MCPTT_Group_A_ID, px_MCPTT_Group_B_ID };   /* @status    APPROVED (MCX) */

  /*
   * @desc      36.579-1 Table 5.3.22.4-5
   * @param     p_TemporaryGroupRequestor (default value: px_MCPTT_ID_User_B)
   * @param     p_TemporaryGroupID  (default value: px_MCPTT_Group_T_ID)
   * @param     p_ConstituentGroupList (default value: tsc_MCPTT_GroupInfo_ConstituentGroupList_A_B)
   * @return    template (value) MCX_PocListService_Group_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_GroupConfiguration_Regrouped(charstring p_TemporaryGroupRequestor := px_MCPTT_ID_User_B,
                                                charstring p_TemporaryGroupID := px_MCPTT_Group_T_ID,
                                                MCX_GroupInfo_ConstituentGroupList_Type p_ConstituentGroupList := tsc_MCPTT_GroupInfo_ConstituentGroupList_A_B) return template (value) MCX_PocListService_Group_Type
  {
    var template (value) MCX_GroupInfo_Regrouped_Type v_Regrouped := cs_MCX_GroupInfo_Regrouped(p_TemporaryGroupRequestor, p_TemporaryGroupID, p_ConstituentGroupList);
    var template (value) MCX_PocListService_Group_Type v_GroupConfiguration := f_MCPTT_GroupConfiguration(v_Regrouped);
 
    return v_GroupConfiguration;
  }

}
