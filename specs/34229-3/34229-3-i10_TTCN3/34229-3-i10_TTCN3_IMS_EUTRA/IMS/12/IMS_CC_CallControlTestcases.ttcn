module IMS_CC_CallControlTestcases {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_CommonFunctions4G all;
  import from IMS_CC_TestcaseImplementation_12 all;
  import from IMS_CommonDefs all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Video all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_MessagesVideo all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Signalling according 34.229-1 Annex C.26 steps 7 to 13
   * @param     p_InviteRequestWithSdp
   * @param     p_SDP_MessageStep183
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_AnnexC26_Steps7_13(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                SDP_Message p_SDP_MessageStep183) runs on IMS_PTC
  { /* @sic R5-172930: p_FmtAudio, p_FmtVideo removed (need to be set dynamically) sic@ */
    /* @sic R5-181141: f_IMS_MTCallSetup_AnnexC26_Steps5_13 -> f_IMS_MTCallSetup_AnnexC26_Steps7_13 sic@ */
    var template (value)   SDP_Message v_SDP_MessageStep7;
    var template (present) SDP_Message v_SDP_MessageStep8;
    
    // Step 7 - 8. Send UPDATE, Receive 200 OK, Receive optional 180 Ringing and send PRACK if requested
    v_SDP_MessageStep7 := f_IMS_BuildSDP_UpdatedOfferAudioVideo_TX(SetupVideoCall, -, -, p_SDP_MessageStep183);   /* @sic R5-213524, R5-213538, R5-213539, R5-213541: f_IMS_BuildSDP_MTCallAudioVideo_TX replaced by f_IMS_BuildSDP_UpdatedOfferAudioVideo_TX sic@ */
    v_SDP_MessageStep8 := f_IMS_BuildSDP_MTCallAudioVideo_RX(SetupVideoCall, FinalAnswer);
    f_IMS_MTCallSetup_Common_Steps7_11(p_InviteRequestWithSdp, v_SDP_MessageStep7, v_SDP_MessageStep8);

    // Step 11A - Make UE accept the speech AMR offer
    f_UT_AnswerCall(MMI);  // @sic R5-134070 sic@

    // Step 12. Receive 200 OK, Send ACK
    f_IMS_MTCallSetup_Receive200OK_SendACK(p_InviteRequestWithSdp);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.2
   * @status    APPROVED (IMS)
   */
  function f_TC_12_2_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MO_Call_503_ServiceUnavailable();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.2a
   * @status    APPROVED (IMS)
   */
  function f_TC_12_2a_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security);  // prose specifies only Annex C.2 => not applicable for GIBA
    
    f_IMS_MO_Call_504_ServerTimeout();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 12.12
