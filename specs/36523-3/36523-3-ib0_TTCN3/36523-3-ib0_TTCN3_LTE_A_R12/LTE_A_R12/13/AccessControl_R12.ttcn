  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.3b
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_3b_EUTRA() runs on EUTRA_PTC
  { // Emergency Call / Success / SSAC/ 0% access probability for MTSI MO speech call / AC-Barring per PLMN
  
    var EPS_BearerIdentity v_EpsDefBearerId2 := '6'H;
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);  // @sic R5s250119 sic@
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, cs_AC_BarringConfig(p00, s4, '11111'B));
    
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    // @sic R5s250119 sic@
    //f_UT_USIM_Insert(UT, "Insert special USIM"); //USIM with PLMN2 is set in it as 'forbidden PLMN'
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS2]);
    f_EUTRA_508_EstablishIMSEmergencyCall(eutra_Cell1, px_EmergencyCallNumber);
  
    // @siclog "Step 2" siclog@
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2]);
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, v_EpsDefBearerId2);
    
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.4
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_4_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech Call / SCM / 0% access probability skip for MTSI MO speech call
    /* @sic R5-153959: TC renamed sic@ */
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    // @sic R5s180047 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1-2 Void" siclog@
    
    // @siclog "Step 3" siclog@
    f_EUTRA_CellInfo_SetSysInfo_AccessBarring (eutra_Cell1, cs_AccessBarringInformation_Prob0_ForMOCalls); // @sic R5-174514 sic@
    f_EUTRA_CellInfo_SetSIB2_SCM_BarringForMMTEL_Voice_r12 (eutra_Cell1, true);
    f_EUTRA_ModifySysinfo (eutra_Cell1);
    
    // @siclog "Step 3A" siclog@
    f_Delay(13.0);
    
    // @siclog "Step 4" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 5" siclog@
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData); // @sic R5s160880 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // Steps 6 to 18 - MTSI MO call for EPS
    // @siclog "Step 6 - 18" siclog@
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq (eutra_Cell1, v_RRC_TI); // @sic R5s160880 sic@
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1, // @sic R5s160880 sic@
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1, // @sic R5s160880 sic@
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1); // @sic R5s160880 sic@
    
    // @siclog "Step 19" siclog@
    f_EUTRA_508Check_ConnectedState (eutra_Cell1);// @sic R5s160880 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.4a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_4a_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech Call / SCM / 0% access probability skip for MTSI MO speech call / AC-Barring per PLMN
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);

    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11 //PLMNid 2 (index 1)
                                      );
    f_EUTRA_CellInfo_SetSysInfo_CellReservedForOpUse (eutra_Cell1, reserved, 1);
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, -, -, -, cs_AC_BarringConfig(p00, s512, '11111'B), -, true_); // @sic R5s250121 sic@
    f_EUTRA_ModifySysinfo (eutra_Cell1);
    
    // @siclog "Step 2" siclog@
    f_Delay(13.0);
    
    // @siclog "Step 3" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 4" siclog@
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    // Steps 5 to 16 - MTSI MO call for EPS
    // @siclog "Step 5 - 16" siclog@
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq (eutra_Cell1, v_RRC_TI);
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

   /*
   * @desc      The same test case body is used in 13.5.5 and 13.5.5a
   *            Only the SIB1 and SIB2 contents (sent at step 3) are different
   *            This function starts just after SIB2 has been changed in calling function
   * @status    APPROVED (LTE_A_R12)
   */
  function fl_TC_13_5_5x_Step3aToEnd_EUTRA() runs on EUTRA_PTC
  {
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;
    
    // @siclog "Step 3A" siclog@
    f_Delay(13.0);
    
    // @siclog "Step 4" siclog@
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 5" siclog@
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // Steps 6 to 18 - MTSI MO Video call for EPS
    // @siclog "Step 6 - 18" siclog@
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq(eutra_Cell1, v_RRC_TI);
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(eutra_Cell1);
    
    // @siclog "Step 19 Void" siclog@
    // @sic R5-250461 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

