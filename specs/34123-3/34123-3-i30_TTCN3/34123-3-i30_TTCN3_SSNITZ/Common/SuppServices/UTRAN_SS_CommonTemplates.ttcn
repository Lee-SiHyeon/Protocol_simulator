module UTRAN_SS_CommonTemplates {

  import from CommonDefs all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from SS_CommonTemplates all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_TypeDefs all;

  const B6_Type tsc_CallState_U4 := '000100'B;                  /* @status    APPROVED (SSNITZ) */

  const B6_Type tsc_CallState_U7 := '000111'B;                  /* @status    APPROVED (SSNITZ) */

  const B6_Type tsc_CallState_U10 := '001010'B;                 /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_Idle := '00'B;               /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_HoldReq := '01'B;            /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_CallHeld := '10'B;           /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_RetrieveReq := '11'B;        /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_MptyReq := '01'B;            /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_CallInMpty := '10'B;         /* @status    APPROVED (SSNITZ) */

  const B2_Type tsc_AuxiliaryState_SplitReq := '11'B;           /* @status    APPROVED (SSNITZ) */

  template (present) RRCDataIndType cr_U_RegisterMO(template (present) FacilityIE p_Facility,
                                                    template SS_VersionInd p_SSVersionInd) :=  // @sic R5s150605 sic@
  { /* @status    APPROVED (POS, SSNITZ) */
    register := cr_RegisterMO(p_Facility, p_SSVersionInd)
  };

  template (value) RRCDataReqType cs_U_RegisterMT (template (value) TI p_TI,
                                                   template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    register := cs_RegisterMT (p_TI, p_Facility)
  };

  template (present) RRCDataIndType cr_U_ReleaseCompleteFacility(template (present) TI p_TI,
                                                                 template (present) FacilityIE p_Facility,
                                                                 template ProtocolDiscriminator p_PD := tsc_PD_SS) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    releaseComplete := cr_ReleaseCompleteFacility(p_TI, p_Facility, p_PD)  // @sic R5s140884 sic@
  };

  template (present) RRCDataIndType cr_U_ReleaseComplete_Cau(template (present) TI p_TI,
                                                             B7_Type p_CauValue) :=
  { /* @status    APPROVED (SSNITZ) */
    releaseComplete := cr_ReleaseComplete(p_TI, cr_CauAny(-, p_CauValue), -, tsc_PD_CC) // @sic R5s150084 sic@
  };

  template (value) RRCDataReqType cs_U_ReleaseCompleteFacility(template (value) TI p_TI,
                                                               template (value) FacilityIE p_Facility,
                                                               template (omit) Cau p_Cau := omit) := // @sic R5s150084 sic@
  { /* @status    APPROVED (POS, SSNITZ) */
    releaseComplete := cs_RelCmpl_Common(p_TI, tsc_PD_SS, p_Cau, p_Facility)
  };

  template (present) RRCDataIndType cr_U_CMServReq_SSDef(template (present) KeySeq p_KeySeq) :=
  { /* @status    APPROVED (SSNITZ) */
    cmServiceRequest := cr_CM_ServReq(p_KeySeq, tsc_SupplementaryServiceActivation, cr_MobileIdTMSI_lv(px_TMSI_Def), omit)
  };

  template (value) RRCDataReqType cs_U_Facility(template (value) TI p_TI,
                                                template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    facility := cs_Facility(p_TI, tsc_PD_SS, p_Facility)
  };

  template (value) RRCDataReqType cs_U_Facility_CallControl (template (value) TI p_TI,
                                                             template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (SSNITZ) */
    facility := cs_Facility(p_TI, tsc_PD_CC, p_Facility)
  };

  template (present) RRCDataIndType cr_U_Facility(template (present) TI p_TI,
                                                  template (present) FacilityIE p_Facility) :=
  { /* @status    APPROVED (SSNITZ) */
    facilityul := cr_Facility(p_TI, p_Facility) // @sic R5s140989 sic@
  };

  template (present) RRCDataIndType cr_U_Facility_CallControl(template (present) TI p_TI,
                                                              template (present) FacilityIE p_Facility) :=
  { /* @status    APPROVED (SSNITZ) */
    facilityul := cr_Facility(p_TI, p_Facility, tsc_PD_CC)  // @sic R5s140989 sic@
  };

  template (value) RRCDataReqType cs_U_SetupMTCall_SS(template (value) Bcap p_Bcap,
                                                      template (value) TI p_TI := cs_TI_MT,
                                                      template (omit) FacilityIE p_Facility := omit,
                                                      template (omit) Signal p_Signal := cs_Signal,
                                                      template (omit) CGPN p_CGPN := omit) :=
  /* @status    APPROVED (SSNITZ) */
    {
      setupdl := cs_SetupMT_Common(p_Bcap, p_TI, p_Facility, p_Signal, p_CGPN) // @sic R5s150422 sic@
    }

  template (present) Call_State cr_Call_State(B6_Type p_State) :=
  { /* @status    APPROVED (SSNITZ) */
    iei             := omit,
    codingStandard  := '11'B,
    callState       := p_State
  };

  template (present) AuxiliaryStates cr_AuxiliaryStates(B2_Type p_HoldState,
                                                        B2_Type p_MPTYState) :=
  { /* @status    APPROVED (SSNITZ) */
    iei           := '24'O,
    iel           := '01'O,           // length
    ext           := '1'B,
    spare         := '000'B,
    holdAuxState  := p_HoldState,
    mptyAuxState  := p_MPTYState
  };

  template (present) STATUS cr_Status(template (present) TI p_TI,
                                      template (present) Cau p_Cau := cr_CauAny (omit),
                                      template (present) Call_State p_CallState,
                                      template AuxiliaryStates p_AuxiliaryStates := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,                    // transaction identifier BITSTRING [4]
    cC_ProtocolDiscriminator    := tsc_PD_CC, // CC protocol discriminator BITSTRING [4]
    msgType         := '??111101'B,       // message type BITSTRING [8]
    statusCause     := p_Cau,              // cause M LV [3-31]
    callState       := p_CallState,                // call state M V [1]
    auxStates       := p_AuxiliaryStates    // auxiliary states O TLV [3] IEI=24
  };

  template (value) STATUS_ENQUIRY cs_StatusEnq_Common(template (value) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,                    // transaction identifier BITSTRING [4]
    cC_ProtocolDiscriminator    := tsc_PD_CC, // CC protocol discriminator BITSTRING [4]
    msgType         := '00110100'B       // message type BITSTRING [8]
  };

  template (present) RRCDataIndType cr_U_Status(template (present) TI p_TI,
                                      template (present) Cau p_Cau := cr_CauAny (omit),
                                      template (present) Call_State p_CallState,
                                      template AuxiliaryStates p_AuxiliaryStates := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    status := cr_Status (p_TI, p_Cau, p_CallState, p_AuxiliaryStates)
  };

  template (value) RRCDataReqType cs_U_StatusEnquiry(template (value) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    statusEnquiry := cs_StatusEnq_Common(p_TI)
  };

  template (present) RRCDataIndType cr_U_Retrieve(template (present) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    retrieve := cr_Retrieve(p_TI)
  };

  template (value) RRCDataReqType cs_U_RetrieveAck(template (value) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    retrieveAcknowledge := cs_RetrieveAck(p_TI)
  };

  template (present) RETRIEVE cr_Retrieve(template (present) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '??011100'B
  };

  template (value) RETRIEVEACKNOWLEDGE cs_RetrieveAck(template (value) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '00011101'B
  };

  template (value) RRCDataReqType cs_U_RetrieveReject(template (value) TI p_TI,
                                                      template (value) Cau p_Cause) :=
  { /* @status    APPROVED (SSNITZ) */
    retrieveReject := cs_RetrieveReject(p_TI, p_Cause)
  };

  template (value) RETRIEVEREJECT cs_RetrieveReject(template (value) TI p_TI,
                                                    template (value) Cau p_Cause) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType         := '00011110'B,
    cause           := p_Cause
  };

  template (value) Cau cs_SS_CauLV(B7_Type p_CauValue) := cs_Cau_Common(omit, tsc_CodingStd_GSM, tsc_Location_PLMN, p_CauValue);   /* @status    APPROVED (SSNITZ) */

}
