  /*
   * @desc      returns default attributes for audio (at least rtpmap, fmtp)
   * @param     p_FmtAudio
   * @param     p_AddMediaAttributes (default value: omit)
   * @return    template (value) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AudioCommon(charstring p_FmtAudio,
                                             template (omit) SDP_attribute_list p_AddMediaAttributes := omit) return template (value) SDP_attribute_list
  {
    var template (value) SDP_attribute_list v_MediaAttributes := {
      cs_SDP_Attribute_rtpmap(p_FmtAudio, cs_RTPMAP_AMR_8000),
      cs_SDP_Attribute_fmtp(p_FmtAudio, cs_AMR_Fmtp_DefaultParameters)
    };
    return valueof(f_SDP_Attributes_Concat_TX(v_MediaAttributes, p_AddMediaAttributes));
  }

  /*
   * @desc      returns default media attributes for audio (rtpmap, fmtp, ptime, maxptime)
   * @param     p_FmtAudio
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaAttributes_AudioDef(charstring p_FmtAudio) return template (omit) SDP_attribute_list
  {
    return f_SDP_MediaAttributes_AudioCommon(p_FmtAudio, cs_SDP_MediaAttributes_ptime_maxptime);
  }

