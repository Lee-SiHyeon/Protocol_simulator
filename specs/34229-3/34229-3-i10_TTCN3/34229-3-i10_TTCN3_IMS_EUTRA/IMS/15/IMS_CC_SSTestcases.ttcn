module IMS_CC_SSTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_15 all;
  import from IMS_Component all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Video all;
  import from IMS_SDP_Messages all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.2a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_2a_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MOCallwithOIR();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.4a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_4a_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MTCallwithTIR();
    
    f_IMS_CC_Postamble(IPCAN_MT_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.8
   * @status    APPROVED (IMS)
   */
  function f_TC_15_8_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_MO_ComunicationForwardingOnNonReply_C21();
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.11
   * @status    APPROVED (IMS)
   */
  function f_TC_15_11_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeader_Response183;
    var SDP_Message v_SDP_OriginalOffer;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

     // setup MO speech call
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);  /* @sic R5w140112 sic@ */
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    v_SDP_OriginalOffer := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);   // v_SDP_OriginalOffer: SDP offer sent by the UE in step 5 or 7 of C.21

    f_IMS_MO_CallOnHoldWithoutAnnouncement(v_InviteRequest, v_MessageHeader_Response183, v_SDP_OriginalOffer);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.11a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_11a_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var INVITE_Request v_InviteRequest;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var SDP_Message v_SDP_Offer;

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);

    // setup MO video call
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_VideoCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearers
    
    v_SDP_Offer := f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    
    f_IMS_MO_CallOnHoldWithoutAnnouncement(v_InviteRequest, v_ResponseWithSdp.Response.msgHeader, v_SDP_Offer);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.12
   * @status    APPROVED (IMS)
   */
  function f_TC_15_12_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var INVITE_Request v_InviteRequest;
    var MessageHeader v_MessageHeader_183;
    var SDP_Message v_SDP_LatestMessageByUE;
    var template (value)  SDP_Message v_SDP_LatestMessageBySS;
    var boolean v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    // setup MO speech call
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);                                                  // C.21 Step 1
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();                          // C.21 Step 2
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    v_MessageHeader_183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);        // C.21 Step 3, 4
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    v_SDP_LatestMessageByUE := f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_183); // @sic R5s120609 sic@
    v_SDP_LatestMessageBySS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_SDP_LatestMessageByUE, v_DontIncrementSessVers); // as in f_IMS_MOCallSetup_AnnexC21_Steps5_13

    f_IMS_MT_CallOnHoldWithoutAnnouncement(v_InviteRequest, v_SDP_LatestMessageBySS);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.12a
   * @status    APPROVED (IMS)
   */
  function f_TC_15_12a_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;  /* @sic R5w140112: IMS_InviteRequestWithSdp_Type instead of IMS_DATA_REQ */
    var INVITE_Request v_InviteRequest;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    var SDP_Message v_SDP_UE;
    var template (value) SDP_Message v_SDP_SS;
    var boolean v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);

    // setup MO speech call
    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);  // C.25 Step 1
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    v_InviteRequest := v_InviteRequestWithSdp.Invite;
    
    v_SDP_UE := v_InviteRequestWithSdp.SdpOffer;
    
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_VideoCall);  // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearers
    
    v_SDP_UE := f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    v_SDP_SS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_SDP_UE, v_DontIncrementSessVers);

    f_IMS_MT_CallOnHoldWithoutAnnouncement(v_InviteRequest, v_SDP_SS);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.15
   * @status    APPROVED (IMS)
   */
  function f_TC_15_15_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL);

    f_IMS_Subscription_MWI_Event_Package_4G();

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.27
   * @status    APPROVED (IMS)
   */
  function f_TC_15_27_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CW_Answering();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 15.28
   * @status    APPROVED (IMS)
   */
  function f_TC_15_28_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_CW_Cancelling();

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
