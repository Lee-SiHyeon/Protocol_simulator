        }
        case else  {
          f_SetVerdict(fail, __FILE__, __LINE__, "Invalid UE CategoryDL received from the UE");
        }
      }
      // checks based on 36.306 Table 4.1A-6
      if (not(
          (pc_ue_CategoryDL_0 == pc_ue_CategoryUL_0) or
          (pc_ue_CategoryDL_4 and pc_ue_Category_4 and
                                  pc_ue_CategoryUL_5) or // @sic R5s190339 sic@
          (pc_ue_CategoryDL_6 and pc_ue_Category_6 and pc_ue_Category_4 and
                                 (pc_ue_CategoryUL_5 or (pc_ue_CategoryUL_5 and pc_ue_CategoryUL_16))) or // @sic R5-172923 sic@
          (pc_ue_CategoryDL_7 and pc_ue_Category_7 and pc_ue_Category_4 and
