module EUTRA_POS_ASP_TypeDefs {
  /* Type definitions for configuration of Positioning Reference Signal in the system simulator;
   * Common design principles: refer to 3GPP TS 36.523-3 [6] annex D.
   */

  import from CommonDefs all;
  import from EUTRA_CommonDefs all;
  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_NB_ASP_TypeDefs all;

  //****************************************************************************
  //****************************************************************************

  group System_Configuration_PosExt {
  //****************************************************************************
  // Formal ASP Definitions for EUTRA PRS system configuration
  //****************************************************************************

  type union SystemRequest_PosExt_Type {                        /* NOTE: Same structure as SystemRequest_Type in 3GPP TS 36.523-3 [6] annex D */
    CellConfigRequest_PosExt_Type       Cell                    /* configure PRS in an LTE cell;
                                                                   the cell shall be configured as usual beforehand and SS shall raise an error when the cell does not exist yet;
                                                                   there is no explicit release of the PRS but the whole cell needs to be released */
  };

  type union SystemConfirm_PosExt_Type {                        /* confirmations for system configuration;
                                                                   in general to be sent after the configuration has been done */
    Null_Type                           Cell                    /* (no further parameters from SS) */
  };

  } // End group System_Configuration_PosExt

  //****************************************************************************

  group Cell_Configuration_PosExt { /* Specific Info for PRS Cell Configuration Primitive */

  // Primitive definition covers:
  // - Initial PRS configuration
  // - PRS reconfigurations

  //----------------------------------------------------------------------------

  group Cell_Configuration_Common_PosExt {

  type union CellConfigRequest_PosExt_Type {                    /* NOTE: Same structure as SystemRequest_Type in 3GPP TS 36.523-3 [6] annex D */

    CellConfigInfo_PosExt_Type         AddOrReconfigure         /* for PRS configuration of given cell:
                                                                 * CellId : identifier of the cell to be configured
                                                                 * RoutingInfo : None
                                                                 * TimingInfo : Now (for initial configuration and for reconfiguration in general)
                                                                 * ControlInfo : CnfFlag:=true; FollowOnFlag:=false (in general) */
  };
  
  type record CellConfigInfo_PosExt_Type {                      /* NOTE: Same structure as SystemRequest_Type in 3GPP TS 36.523-3 [6] annex D */
    /* common information for initial cell configuration or reconfiguration;
       in case of reconfiguration OMIT means 'keep configuration as it is' */
    BasicCellConfig_PosExt_Type        Basic     optional       /* Extended PRS information for a cell */
  };

  type record BasicCellConfig_PosExt_Type {                     /* NOTE: Same structure as SystemRequest_Type in 3GPP TS 36.523-3 [6] annex D */
    // Physical layer:
    PhysicalLayerConfigDL_PosExt_Type  PhysicalLayerConfigDL optional  /* Default settings regarding physical control PRS signal */
  };

  } // End sub-group Cell_Configuration_Common_PosExt

  //----------------------------------------------------------------------------

  group Downlink_Physical_Layer_Configuration_PosExt {
  /* Downlink physical layer configuration:
   * - DL antenna configuration for port 6.
   * - PRS configuration.
   */
 
  type record AntennaPort6_Config_Type {
    /* to configure antenna port 6 for positioning;
     * all fields are declared as optional to allow single reconfigurations; in this case omit means "keep as it is" */
    AntennaPort_Type                    Port            optional,
    PRS_Info                            PRS             optional,
    ToRS_EPRE_Ratio_Type                RelativeTxPower optional  /* power ratio for Dl-PRS resource elements relative to the RS */
  };

  type record PhysicalLayerConfigDL_PosExt_Type {
    /* all fields are declared as optional to allow single reconfigurations; in this case omit means "keep as it is" */
    AntennaPort6_Config_Type            AntennaPort6    optional
  };

  } // End sub-group Downlink_Physical_Layer_Configuration_PosExt

  } // End group Cell_Configuration_PosExt

  //****************************************************************************

  group System_Interface_PosExt {

  type record SYSTEM_CTRL_POSEXT_REQ {
    ReqAspCommonPart_Type       Common,         /* For configuration of antenna port 6 TimingInfo is now */
    SystemRequest_PosExt_Type   Request         /* configure a PRS in a cell */
  };

  type record SYSTEM_CTRL_POSEXT_CNF {
    CnfAspCommonPart_Type       Common,         /* TimingInfo is ignored by TTCN
                                                 * => SS may set TimingInfo to "None" */
    SystemConfirm_PosExt_Type   Confirm
  };

  type port EUTRA_SYSTEM_POSEXT_PORT message {  /* EUTRA PTC: Ext Port for system configuration of antenna port 6 */
    out SYSTEM_CTRL_POSEXT_REQ;
    in  SYSTEM_CTRL_POSEXT_CNF;
  };

  } // End group System_Interface_PosExt

}
