  template (value) MCPTT_UserProfile_DisplayName_Type cs_MCPTT_UserProfile_DisplayName(XSD.String p_Base) :=
  { /* @status    APPROVED (MCX) */
    lang := omit,
    attr := omit,
    base := p_Base
  };

  /*
   * @desc      Wrapper to build and return MCPTT_UserProfile_DisplayName_Type (or omit)
   * @param     p_DisplayNameString
   * @return    template (omit) MCPTT_UserProfile_DisplayName_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_UserProfile_DisplayName(template (omit) XSD.String p_DisplayNameString) return template (omit) MCPTT_UserProfile_DisplayName_Type
  {
    var template (omit) MCPTT_UserProfile_DisplayName_Type v_DisplayName := omit;
    if (isvalue(p_DisplayNameString)) {
      v_DisplayName := cs_MCPTT_UserProfile_DisplayName(valueof(p_DisplayNameString));
    }
    return v_DisplayName;
  }

  template (value) MCPTT_UserProfile_Entry_Type cs_MCPTT_UserProfile_Entry(template (omit) EntryInfoTypeList p_EntryInfo := omit,
                                                                           template (omit) XSD.Token p_Index := omit,
                                                                           XSD.AnyURI p_URI,
                                                                           template (omit) XSD.String p_DisplayName := omit,
                                                                           template (omit) urn_3gpp_mcptt_user_profile_1_0.AnyExtType p_AnyExt := omit) :=
  { /* @status    APPROVED (MCX) */
    /* @sic R5-231917: p_AnyExt sic@ */
    entry_info := p_EntryInfo,
    index := p_Index,
    attr := omit,
    uri_entry := p_URI,
    display_name := fl_MCPTT_UserProfile_DisplayName(p_DisplayName),
    anyExt := p_AnyExt,
    elem_list := {}
  };

