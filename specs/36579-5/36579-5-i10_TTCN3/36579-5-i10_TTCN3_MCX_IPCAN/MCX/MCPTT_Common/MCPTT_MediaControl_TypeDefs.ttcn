module MCPTT_MediaControl_TypeDefs {
  
  import from CommonDefs all;
  import from RTCP_APP_Common all;

  //============================================================================

  group FloorControl_Group {

  // TS 24.380 clause 8.2
  type union FloorControlMsg_Type {
    FloorControl_Request requestMessage,
    FloorControl_Release releaseMessage,
    FloorControl_Ack ackMessage,
    FloorControl_FloorGranted grantedMessage,
    FloorControl_FloorDeny denyMessage,
    FloorControl_Idle idleMessage,
    FloorControl_Taken takenMessage,
    FloorControl_Revoke revokeMessage,
    FloorControl_QueuePositionInfo queuePositionInfoMessage,
    FloorControl_QueuePositionRequest queuePositionRequestMessage,
    FloorControl_ReleaseMultiTalker releaseMultiTalkerMessage,
    FloorControl_QueuedFloorRequests queuedFloorRequestsMessage,
    FloorControl_UnicastMediaFlowControl unicastMediaFlowControlMessage
  };
  
  // --- Messages ---
  
  // TS 24.380 clause 8.2.4
  type set FloorControl_Request {                               // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_FloorPriority prio optional,
    FloorControl_UserID userId optional,                        // off-network and in messages sent by a non-controlling function to a controlling function
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional,
    FloorControl_FunctionalAlias functionalAlias optional,      // Rel-15
    FloorControl_Location location optional                     // Rel-15
  };
  
  // TS 24.380 clause 8.2.5
  type set FloorControl_FloorGranted {                          // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_Duration duration,
    FloorControl_SSRC ssrcGrantedParticipant,
    FloorControl_FloorPriority prio optional,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_QueueSize queueSize optional,                  // off-network only
    FloorControl_SSRC ssrcQueuedParticipant optional,           // off-network only; NOTE: coding/contents of the field is not clearly specified
    FloorControl_UserID queuedUserId optional,                  // off-network only
    FloorControl_QueueInfo queueInfo optional,                  // off-network only
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };
  
  // TS 24.380 clause 8.2.6
  type set FloorControl_FloorDeny {                             // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_RejectCause rejectCause,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };
   
  // TS 24.380 clause 8.2.7
  type set FloorControl_Release {                               // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };
 
  // TS 24.380 clause 8.2.8
  type set FloorControl_Idle {                                  // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_MsgSeqNum msgSeqNum optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };

  // TS 24.380 clause 8.2.9
  type set FloorControl_Taken {                                 // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_GrantedPartysId grantedPartysId optional,
    FloorControl_PermissionToRequest permissionToRequest optional,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_MsgSeqNum msgSeqNum optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional,
    FloorControl_SSRC ssrcGrantedParticipant optional,
    FloorControl_FunctionalAlias functionalAlias optional,              // Rel-15
    FloorControl_ListOfGrantedUsers grantedUsers optional,              // Rel-15
    FloorControl_ListOfSSRCs ssrcsGrantedParticipants optional,         // Rel-15, multi-talker scenario: List of Audio SSRCs of Granted Participants
    FloorControl_ListOfFunctionalAliases functionalAliases optional,    // Rel-15
    FloorControl_Location location optional,                            // Rel-15
    FloorControl_ListOfLocations locations optional                     // Rel-15
  };
  
  // TS 24.380 clause 8.2.10
  type set FloorControl_Revoke {                                // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_RejectCause rejectCause optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };

  // TS 24.380 clause 8.2.11
  type set FloorControl_QueuePositionRequest {                  // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_TrackInfo trackInfo optional
  };

  // TS 24.380 clause 8.2.12
  type set FloorControl_QueuePositionInfo {                     // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_UserID userId optional,                        // off-network only
    FloorControl_SSRC ssrcQueuedParticipant optional,           // off-network only
    FloorControl_QueuedUserID queuedUserId optional,            // off-network only
    FloorControl_QueueInfo queueInfo optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };
  
  // TS 24.380 clause 8.2.13
  type set FloorControl_Ack {                                   // @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_Source source,
    FloorControl_MsgType msgType,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_Location location optional                     // Rel-16
  };

  // TS 24.380 clause 8.2.14
  type set FloorControl_ReleaseMultiTalker {                    // Rel-15    @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_UserID userId optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_FloorIndicator floorIndicator optional
  };

  // TS 24.380 clause 8.2.15
  type set FloorControl_QueuedFloorRequests {                   // Rel-17    @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_FunctionalAlias functionalAlias optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_ListOfQueuedUsers listOfQueuedUsers optional,
    FloorControl_UserID requestedPartysId optional,
    FloorControl_QueuedFloorRequestsPurpose queuedFloorRequestsPurpose optional,
    FloorControl_QueuedFloorRequestsResult queuedFloorRequestsResult optional
  };

  // TS 24.380 clause 8.2.16
  type set FloorControl_UnicastMediaFlowControl {               // Rel-17    @sic R5w230312: set instead of record sic@
    FloorControl_CommonHdr commonHdr,
    FloorControl_UserID userId optional,
    FloorControl_TrackInfo trackInfo optional,
    FloorControl_MediaFlowControlIndicator mediaFlowControlIndicator optional
  };

  // --- Components ---

  type RTCP_APP_CommonHdr FloorControl_CommonHdr;

  type record FloorControl_GenericId {                          /* generic id or name as used for List of Functional Aliases or List of Granted Users */
    O1_Type lgth,
    octetstring val
  };
  type record of FloorControl_GenericId FloorControl_GenericIdList;

  type record FloorControl_LongId {                            /* id or name as used for List of List of Queued Users */
    O2_Type lgth,
    octetstring val
  };
  type record of FloorControl_LongId FloorControl_LongIdList;

  // TS 24.380 Table 8.2.3.21-2: Location value coding
  type record FloorControl_LocationValue {                      // Rel-15
    O1_Type locType,
    octetstring locVal
  };
  type record of FloorControl_LocationValue FloorControl_LocationValueList;

  // TS 24.380 clause 8.2.3.2
  type record FloorControl_FloorPriority {
    O1_Type id,
    O1_Type lgth,
    O1_Type val,
    O1_Type spare
  };

  // TS 24.380 clause 8.2.3.3
  type record FloorControl_Duration {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.2.3.4
  type record FloorControl_RejectCause {
    O1_Type id,
    O1_Type lgth,
    O2_Type val,
    octetstring rejectPhrase,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.5
  type record FloorControl_QueueInfo {
    O1_Type id,
    O1_Type lgth,
    O1_Type positionInfo,
    O1_Type prioInfo
  };

  // TS 24.380 clause 8.2.3.6
  type record FloorControl_GrantedPartysId {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };
  
  // TS 24.380 clause 8.2.3.7
  type record FloorControl_PermissionToRequest {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.2.3.8
  type record FloorControl_UserID {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };
 
  // TS 24.380 clause 8.2.3.9
  type record FloorControl_QueueSize {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };
  
  // TS 24.380 clause 8.2.3.10
  type record FloorControl_MsgSeqNum {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };
  
  // TS 24.380 clause 8.2.3.11
  type record FloorControl_QueuedUserID {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };
  
  // TS 24.380 clause 8.2.3.12
  type record FloorControl_Source {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.2.3.13
  type record FloorControl_TrackInfo {
    O1_Type id,
    O1_Type lgth,
    O1_Type queueingVal,
    O1_Type typeLgth,
    octetstring participantVal,
    octetstring padding,
    record of O4_Type participantRefs
  };
  
  // TS 24.380 clause 8.2.3.14
  type record FloorControl_MsgType {
    O1_Type id,
    O1_Type lgth,
    O1_Type val,
    O1_Type spare
  };
  
  // TS 24.380 clause 8.2.3.15
  type record FloorControl_FloorIndicator {
    O1_Type id,
    O1_Type lgth,
    B16_Type val
  };
  
  // TS 24.380 clause 8.2.3.16
  type record FloorControl_SSRC {
    O1_Type id,
    O1_Type lgth,
    O4_Type val,
    O2_Type spare
  };
  
  // TS 24.380 clause 8.2.3.17
  type record FloorControl_ListOfGrantedUsers {                 // Rel-15
    O1_Type id,
    O1_Type lgth,
    O1_Type noOfUsers,
    FloorControl_GenericIdList list,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.18
  type record FloorControl_ListOfSSRCs {                        // Rel-15
    O1_Type id,
    O1_Type lgth,
    O1_Type noOfSSRCs,                                          // @sic R5s221241: BASELINE MOVING 2022 09 sic@
    O1_Type spare,
    RTP_SSRC_List list
  };

  // TS 24.380 clause 8.2.3.19
  type record FloorControl_FunctionalAlias {                    // Rel-15
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.20
  type record FloorControl_ListOfFunctionalAliases {            // Rel-15
    O1_Type id,
    O1_Type lgth,
    O1_Type noOfUsers,
    FloorControl_GenericIdList list,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.21
  type record FloorControl_Location {                           // Rel-15
    O1_Type id,
    O1_Type lgth,
    FloorControl_LocationValue val,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.22
  type record FloorControl_ListOfLocations {                    // Rel-15
    O1_Type id,
    O1_Type lgth,
    O1_Type noOfLocations,
    FloorControl_LocationValueList list,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.23
  type record FloorControl_QueuedFloorRequestsPurpose {         // Rel-17
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.2.3.24
  type record FloorControl_ListOfQueuedUsers  {                 // Rel-17
    O1_Type id,
    O2_Type lgth,
    O1_Type noOfUsers,
    FloorControl_LongIdList list,
    octetstring padding
  };

  // TS 24.380 clause 8.2.3.25
  type record FloorControl_QueuedFloorRequestsResult {          // Rel-17
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.2.3.26
  type record FloorControl_MediaFlowControlIndicator {          // Rel-17
    O1_Type id,
    O1_Type lgth,
    O1_Type val,
    O1_Type spare
  };
  
  } with { encode "FloorCtrlCodec" };  // end FloorControl_Group

  //============================================================================

  group PreestablishedSessionControl_Group {

  // TS 24.380 clause 8.3
  type union PreestablishedSessionControlMsg_Type {
    PreestablishedSessionControl_Connect     connectMessage,
    PreestablishedSessionControl_Disconnect  disconnectMessage,
    PreestablishedSessionControl_Acknowledge acknowledgeMessage
  };
  
  // --- Messages ---
  
  // TS 24.380 clause 8.3.4
  type set PreestablishedSessionControl_Connect {               // @sic R5w230312: set instead of record sic@
    PreestablishedSessionControl_CommonHdr              commonHdr,
    PreestablishedSessionControl_SessionIdentity        sessionIdentity optional,
    PreestablishedSessionControl_GroupIdentity          groupIdentity optional,
    PreestablishedSessionControl_MediaStreams           mediaStreams optional,
    PreestablishedSessionControl_WarningText            warningText optional,
    PreestablishedSessionControl_AnswerState            answerState optional,
    PreestablishedSessionControl_InvitingUserIdentity   invitingUserIdentity optional,
    PreestablishedSessionControl_InvitedUserIdentity    invitedUserIdentity optional,            // Rel-18
    PreestablishedSessionControl_PCK_I_Message          pckIMessage optional
  };
  
  // TS 24.380 clause 8.3.5
  type set PreestablishedSessionControl_Disconnect {            // @sic R5w230312: set instead of record sic@
    PreestablishedSessionControl_CommonHdr              commonHdr,
    PreestablishedSessionControl_SessionIdentity        sessionIdentity optional,
    PreestablishedSessionControl_ReasonCause            reasonCause optional                     // Rel-17
  };
  
  // TS 24.380 clause 8.3.6
  type set PreestablishedSessionControl_Acknowledge {           // @sic R5w230312: set instead of record sic@
    PreestablishedSessionControl_CommonHdr              commonHdr,
    PreestablishedSessionControl_ReasonCode             reasonCode optional
  };
  
  // --- Components ---

  type RTCP_APP_CommonHdr PreestablishedSessionControl_CommonHdr;

  // TS 24.380 clause 8.3.3.2
  type record PreestablishedSessionControl_MediaStreams {
    O1_Type id,
    O1_Type lgth,
    O1_Type mediaStreamVal,
    O1_Type controlStreamVal
  };

  // TS 24.380 clause 8.3.3.3
  type record PreestablishedSessionControl_SessionIdentity {
    O1_Type id,
    O1_Type lgth,
    O1_Type sessionType,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.3.3.4
  type record PreestablishedSessionControl_WarningText {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.3.3.5
  type record PreestablishedSessionControl_GroupIdentity {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.3.3.6
  type record PreestablishedSessionControl_AnswerState {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.3.3.7
  type record PreestablishedSessionControl_InvitingUserIdentity {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.3.3.8
  type record PreestablishedSessionControl_ReasonCode {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.3.3.10
  type record PreestablishedSessionControl_PCK_I_Message {
    O1_Type id,
    O2_Type lgth,
    octetstring val,
    octetstring padding
  };

  // TS 24.380 clause 8.3.3.11
  type record PreestablishedSessionControl_ReasonCause {
    O1_Type id,
    O1_Type lgth,
    O2_Type val
  };

  // TS 24.380 clause 8.3.3.12
  type record PreestablishedSessionControl_InvitedUserIdentity {
    O1_Type id,
    O1_Type lgth,
    octetstring val,
    octetstring padding
  };

  } with { encode "PreestablishedSessionCtrlCodec" };  // end PreestablishedSessionControl_Group
}
