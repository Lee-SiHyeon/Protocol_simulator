module NR_Measurement_Templates {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_Parameters all;
  import from NR_CellInfoInit all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;

  const ReportConfigId tsc_NR_IdReportConfigId1 := 1;           /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  const ReportConfigId tsc_NR_IdReportConfigId2 := 2;           /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  const MeasId tsc_NR_MeasId1 := 1;                             /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) @sic R5-198933 sic@ */

  const MeasId tsc_NR_MeasId2 := 2;                             /* @status    APPROVED (ENDC, NR5GC) @sic R5-198933 sic@*/

  const MeasObjectId tsc_NR_MeasObjectId2 := 2;                 /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  type ReportConfigNR.reportType.eventTriggered.reportAmount ReportConfigNR_EventTriggered_ReportAmount_Type;    /* @status    APPROVED (ENDC, NR5GC)
                                                                                                                    @sic R5-185154 sic@ */

  type enumerated NR_RRCMeasurement_TriggerEvent_Type {         /* @status    APPROVED (ENDC) */
    triggerEvent_A1,
    triggerEvent_A2
  };

  type EventTriggerConfig.eventId NR_TriggerEventId_Type;       /* @status    APPROVED (ENDC, NR5GC) */

  type record AbsThresholdSS_Type
    { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
        RSRP_Range absThresSS_RSRP    optional,
        RSRQ_Range absThresSS_RSRQ    optional,
        SINR_Range absThresSS_SNIR    optional
    }

    type record MeasObjectParams_Type
    { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
        NR_CellId_Type         cellId,
        MeasObjectId           measObjId,
        AbsThresholdSS_Type    absThresSS               optional,
        integer                nrofSS_BlocksToAverage   optional
        
    }

    type record of MeasObjectParams_Type MeasObjectParamsList_Type; /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

   template (value) MeasObjectParams_Type cs_MeasObjectParams_RSRP (NR_CellId_Type  p_NR_CellId,
                                                               MeasObjectId p_MeasObjectId,
                                                               template (omit) RSRP_Range p_AbsThresSS := omit,
                                                               template (omit) integer p_NrofSS_BlocksToAverage := 2)
    :=
    { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
        cellId := p_NR_CellId,
        measObjId := p_MeasObjectId,
        absThresSS := {
            absThresSS_RSRP := p_AbsThresSS,
            absThresSS_RSRQ := omit,
            absThresSS_SNIR := omit
        },
        nrofSS_BlocksToAverage := p_NrofSS_BlocksToAverage      //@sic R5-195365 sic@
    };

    template (value) MeasObjectParams_Type cs_MeasObjectId1(NR_CellId_Type  p_NR_CellId,
                                                           template (omit) RSRP_Range p_AbsThresSS := omit,
                                                           template (omit) integer p_NrofSS_BlocksToAverage := omit //@sic R5-195365 sic@
                                                           ) :=
    /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    cs_MeasObjectParams_RSRP(p_NR_CellId, tsc_NR_MeasObjectId1, p_AbsThresSS, p_NrofSS_BlocksToAverage);

    template (value) MeasObjectParams_Type cs_MeasObjectId2(NR_CellId_Type  p_NR_CellId,
                                                           template (omit) RSRP_Range p_AbsThresSS := omit,
                                                           template (omit) integer p_NrofSS_BlocksToAverage := omit //@sic R5-195365 sic@
                                                           ):=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_MeasObjectParams_RSRP(p_NR_CellId, tsc_NR_MeasObjectId2, p_AbsThresSS, p_NrofSS_BlocksToAverage);

  template (present) UL_DCCH_Message cr_NR_MeasurementReport (template (present) MeasResults p_MeasResults):=
  {  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
      message_:=
      {
          c1:=
          {
              measurementReport :=
              {
                  criticalExtensions :=
                  {
                      measurementReport :=
                      {
                          measResults := p_MeasResults,
                          lateNonCriticalExtension := *,
                          nonCriticalExtension := *
                      }
                  }
              }
          }
      }
      
  };

  template (present) UL_DCCH_Message cr_NR_MeasurementReport_Any := cr_NR_MeasurementReport(?);   /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) MeasConfig cs_NR_MeasConfigCommon (template (omit) MeasObjectToRemoveList p_MeasObjectToRemoveList := omit,
                                                      template (omit) MeasObjectToAddModList p_MeasObjectToAddModList := omit,
                                                      template (omit) ReportConfigToRemoveList p_ReportConfigToRemoveList := omit,
                                                      template (omit) ReportConfigToAddModList p_ReportConfigToAddModList := omit,
                                                      template (omit) MeasIdToRemoveList p_MeasIdToRemoveList := omit,
                                                      template (omit) MeasIdToAddModList p_MeasIdToAddModList := omit,
                                                      template (omit) MeasConfig.s_MeasureConfig p_S_MeasureConfig := omit,
                                                      template (omit)QuantityConfig p_QuantityConfig := omit,
                                                      template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                                      template (omit) MeasGapSharingConfig  p_MeasGapSharingConfig := omit
   ):=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT, POS) */
    measObjectToRemoveList := p_MeasObjectToRemoveList,
    measObjectToAddModList := p_MeasObjectToAddModList,
    reportConfigToRemoveList := p_ReportConfigToRemoveList,
    reportConfigToAddModList := p_ReportConfigToAddModList,
    measIdToRemoveList :=  p_MeasIdToRemoveList,
    measIdToAddModList := p_MeasIdToAddModList,
    s_MeasureConfig := p_S_MeasureConfig,
    quantityConfig := p_QuantityConfig,
    measGapConfig := p_MeasGapConfig,
    measGapSharingConfig := p_MeasGapSharingConfig,
    interFrequencyConfig_NoGap_r16 := omit,    /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    effectiveMeasWindowConfig_r18  := omit     /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
};

  template (value) MeasConfig cs_NR_MeasConfig_Partial(template (omit) MeasObjectToAddModList p_MeasObjectToAddModList := omit,
                                                       template (omit) ReportConfigToAddModList p_ReportConfigToAddModList := omit,
                                                       template (omit) MeasIdToAddModList p_MeasIdToAddModList := omit,
                                                       template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                                       template (omit) QuantityConfig p_QuantityConfig := cs_38508_QuantityConfig,
                                                       template (omit) MeasIdToRemoveList p_MeasIdToRemoveList := omit //@sic R5s201450 sic@
                                                       ):=
    // Acc Table 4.6.3-50 TS 38.508-1
    /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    cs_NR_MeasConfigCommon(-,p_MeasObjectToAddModList,-,p_ReportConfigToAddModList,p_MeasIdToRemoveList,p_MeasIdToAddModList,-,p_QuantityConfig,p_MeasGapConfig);

  template (value) MeasIdToAddMod cs_NR_MeasIdToAddMod(MeasId p_MeasId := tsc_NR_MeasId1,
                                                       MeasObjectId p_MeasObjectId := tsc_NR_MeasObjectId1,
                                                       ReportConfigId p_ReportConfigId := tsc_NR_IdReportConfigId1) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    measId := p_MeasId,
    measObjectId := p_MeasObjectId,
    reportConfigId := p_ReportConfigId
  };

  template (value) MeasIdToAddMod cs_NR_MeasId_Config_id1_obj1_conf1 := cs_NR_MeasIdToAddMod;            /* @status    APPROVED (ENDC, NR5GC) */

  template (value) MeasIdToAddMod cs_NR_MeasId_Config_id1_obj2_conf1 := cs_NR_MeasIdToAddMod(tsc_NR_MeasId1, tsc_NR_MeasObjectId2, tsc_NR_IdReportConfigId1); /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) MeasIdToAddMod cs_NR_MeasId_Config_id2_obj1_conf2 := cs_NR_MeasIdToAddMod(tsc_NR_MeasId2, tsc_NR_MeasObjectId1, tsc_NR_IdReportConfigId2); /* @status    APPROVED (ENDC, NR5GC) */

