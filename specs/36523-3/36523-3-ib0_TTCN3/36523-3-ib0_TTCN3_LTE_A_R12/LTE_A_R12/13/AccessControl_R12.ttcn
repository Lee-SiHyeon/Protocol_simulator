module AccessControl_R12 {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EPS_NAS_Constants all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_TypeDefs all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SysInfo_Templates all;
  import from EUTRA_Timing all;
  import from IMS_CommonParameters all;
  import from IMS_PTC_CoordMsg all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1a_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech Call / SSAC in Connected mode / 0% access probability for MTSI MO speech call
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Voice (eutra_Cell1,cs_AC_BarringConfig(p00, s64, '11111'B)); // @sic R5s160935 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def (eutra_Cell1); // @sic R5-185126 sic@
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 5" siclog@
    // Make the UE attempt a MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED); // @sic R5s230790 sic@
    
    // @siclog "Step 6" siclog@
    // Check: Does the UE transmit an INVITE message  within 10 s?
    f_Delay(10.0);

    // @siclog "Step 6AA" siclog@
    // @sic R5-162789 sic@
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Voice (eutra_Cell1, omit);
    f_EUTRA_ModifySysinfo (eutra_Cell1,-,RRC_CONNECTED); // @sic R5s160609 sic@

    // @siclog "Step 6AB" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0); // @sic R5-162789 sic@
    
    // @siclog "Step 6A" siclog@
    // Make the UE attempt a MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED); // @sic R5-160920, R5s230790 sic@
    // @siclog "Step 6B" siclog@
    // Wait for 10 s (Note 1) to allow the new system information to take effect.
    f_Delay(10.0); // @sic R5-160920 sic@
    
    // @siclog "Step 7" siclog@
    // Check: Does the UE transmit an INVITE message with in 10s?
    f_Delay(49.0); // @sic R5-160920 sic@ @sic R5-162789 sic@
    
    // @siclog "Step 8" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    // @siclog "Step 13 - 15" siclog@
    // Steps 12 to 14 of the generic procedure for MTSI MO speech call establishment (TS 36.508 table 4.5A.6.3-1).
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    
    // @sic R5s250239 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1c
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1c_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech call / SSAC / 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;
    var float v_TimerNoRRCSetupReq;

    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);
    v_TimerNoRRCSetupReq := f_EUTRA_SetTimerToleranceMin(eutra_Cell1, nonProtocolTimer, 10.0); // @sic R5s250052 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell1);
     
     f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);  // @sic R5s250052 sic@
    
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1,cs_AC_BarringConfig(p00, s128, '11111'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell1);
    
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    //Make the UE attempt an MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED);
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit a RRCConnectionRequest message  within 10 s?
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerNoRRCSetupReq)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, " Step 2");
    }
    
    // @siclog "Step 3" siclog@
    //SS adjusts SIB2 of Cell1 and transmits a Paging message. The systemInfoValueTag in the SystemInformationBlockType1 is increased.
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, -,-,-,-,-,-,-,-,true);
    f_EUTRA_ModifySysinfo(eutra_Cell1);
    
    // @siclog "Step 4" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0);
    
    // @siclog "Step 5" siclog@
    //Make the UE attempt an MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED);
    
    // @siclog "Step 6 - 7" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message with in 10s?
    // Wait for 132 s (Note 2) to make the ac-BarringTime 128s Ty expire.
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerNoRRCSetupReq)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, " Step 6");
    }
    f_Delay(132.0);
    
    // @siclog "Step 8 - 21" siclog@
    // Steps 1 to 14 of the generic test procedure for MTSI MO Speech call establishment in EUTRA: Normal Service (TS 36.508 4.5A.6.3-1).
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri);
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData);
    
    // @siclog "Step 6 - 18" siclog@
    // Steps 6 to 18 - MTSI MO call for EPS
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq (eutra_Cell1, v_RRC_TI);
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1d
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_1d_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech Call / SSAC in Connected mode / 0% access probability for MTSI MO speech call / AC-Barring per PLMN
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);  // @sic R5s250117  sic@
                                       
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, cs_AC_BarringConfig(p00, s128, '11111'B));
    f_EUTRA_CellConfig_Def(eutra_Cell1);
   
    // @sic R5s250117 sic@
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def (eutra_Cell1);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE attempt a MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED);
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit an INVITE message within 10 s?
    // Any message received during the delay will cause a failure
    f_Delay(f_EUTRA_SetTimerToleranceMin(eutra_Cell1, nonProtocolTimer, 10.0));

    // @siclog "Step 3" siclog@
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, -, -, -, -, -, -, -, -, true); // @sic R5s250117 sic@
    f_EUTRA_ModifySysinfo (eutra_Cell1, -, RRC_CONNECTED);

    // @siclog "Step 4" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0);
    
    // @siclog "Step 5" siclog@
    // Make the UE attempt a MTSI MO Speech call
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED);
    
    // @siclog "Step 6" siclog@
    // Check: Does the UE transmit an INVITE message within 10 s?
    // Any message received during the delay will cause a failure
    f_Delay(f_EUTRA_SetTimerToleranceMin(eutra_Cell1, nonProtocolTimer, 10.0));
    
    // @siclog "Step 7" siclog@
    // Wait for 132 s (Note 2) to make the ac-BarringTime 128s Ty expire.
    f_Delay(132.0);
    
    // @siclog "Step 8" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri);
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    // @siclog "Step 13 - 15" siclog@
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
       
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2x.Connected
   * @param     p_Ty
   * @param     p_AcBarringPerPLMN
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2x_Connected_EUTRA(float p_Ty, boolean p_AcBarringPerPLMN) runs on EUTRA_PTC
  {
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def (eutra_Cell1); // @sic R5-186985 sic@
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 5" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 6" siclog@
    // Check: Does the UE transmit an INVITE message  within 10 s?
    f_Delay(10.0);

    // @siclog "Step 6AA" siclog@
    // @sic R5-162789 sic@
    if (p_AcBarringPerPLMN) { // 13.5.2d @sic R5-251245 sic@
      f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1);
    } else { // 13.5.2a
      f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Video(eutra_Cell1, omit);
    }
    f_EUTRA_ModifySysinfo (eutra_Cell1,-,RRC_CONNECTED); // @sic R5s160609 sic@

    // @siclog "Step 6AB" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0); // @sic R5-162789 sic@
    
    // @siclog "Step 6A" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri); // @sic R5-160921 sic@
    
    // @siclog "Step 6B" siclog@
    // Check: Does the UE transmit an INVITE message  within 10 s?
    f_Delay(10.0); // @sic R5-160921 sic@
    
    // @siclog "Step 7" siclog@
    // Check: Does the UE transmit an INVITE message with in 10s?
    f_Delay(p_Ty); // @sic R5-160920, R5-162789, R5-251245 sic@
    
    // @siclog "Step 8" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);

    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(eutra_Cell1);
    
    // @sic R5s250239 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2a_EUTRA() runs on EUTRA_PTC
  { // MTSI MO Video Call / SSAC in Connected mode/ 0% access probability for MTSI MO video call
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Video (eutra_Cell1,cs_AC_BarringConfig(p00, s64, '11111'B)); // @sic R5s160935 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_TC_13_5_2x_Connected_EUTRA(49.0, false); // @sic R5-251245 sic@
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2d
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_2d_EUTRA() runs on EUTRA_PTC
  { // MTSI MO Video Call / SSAC in Connected mode/ 0% access probability for MTSI MO video call / AC-Barring per PLMN
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);
                                       
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1,
                                                        omit, cs_AC_BarringConfig(p00, s128, '11111'B));
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s250187 sic@ */
    f_TC_13_5_2x_Connected_EUTRA(128.0, true);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2c
   * @status    APPROVED (LTE_A_R12)
   */
  
  function f_TC_13_5_2c_EUTRA() runs on EUTRA_PTC
  { // MTSI MO video call / SSAC / 0% access probability for MTSI MO video call / AC-Barring per PLMN

    var float v_TimerNoRRCSetupReq;

    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);

    v_TimerNoRRCSetupReq := f_EUTRA_SetTimerToleranceMin(eutra_Cell1, nonProtocolTimer, 10.0); // @sic R5s250102 sic@

    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellInfo_SetPLMN_2Entries (eutra_Cell1,
                                       cs_HPLMN_Def, //PLMNid 1 (index 0)
                                       cs_HPLMN_002_11, //PLMNid 2 (index 1)
                                       -, true, 1);  // @sic R5s250102 subject to prose CR approval sic@
                                       
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, omit, cs_AC_BarringConfig(p00, s128, '11111'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell1);
    
    // @sic R5s250102 sic@
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit a RRCConnectionRequest message  within 10 s?
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerNoRRCSetupReq)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, " Step 2");
    }
    
    // @siclog "Step 3" siclog@
    //SS adjusts SIB2 of Cell1 and transmits a Paging message. The systemInfoValueTag in the SystemInformationBlockType1 is increased.
    f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12 (eutra_Cell1, 1, -, -, -, -, -, -, -, -, true);  //@sic R5s250102 sic@
    f_EUTRA_ModifySysinfo(eutra_Cell1);
    
    // @siclog "Step 4" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0);
    
    // @siclog "Step 5" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 6 - 7" siclog@
    //Check: Does the UE transmit an RRCConnectionRequest message with in 10s?
    // Wait for 132 s (Note 2) to make the ac-BarringTime 128s Ty expire.
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerNoRRCSetupReq)) {
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, " Step 6");
    }
    f_Delay(132.0);
    
    // @siclog "Step 8 - 21" siclog@
    // Steps 1 to 15 of the generic test procedure for MTSI MO Video call establishment in EUTRA: Normal Service (TS 36.508 4.5A.8.3-1).
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    f_EUTRA_ServiceRequestAndActivate_SRB2_DRB(eutra_Cell1, -, -, -, -, -, -, -, -, -, cr_EstablishmentCause_MoData);
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(eutra_Cell1);
    
    // @siclog "Step 20 - 23" siclog@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

   /*
   * @desc      The same test case body is used in 13.5.3a and 13.5.3c
   *            Only the SIB1 and SIB2 contents (sent in the pramble) are different
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_3x_Connected_EUTRA() runs on EUTRA_PTC
  {
    var NAS_MSG_Indication_Type v_NasInd;
    var EPS_BearerIdentity v_EpsDefBearerId2 := '6'H;
    var EPS_BearerIdentity v_EpsDedicatedBearerId := f_EUTRA_IncrementEpsBearerId(v_EpsDefBearerId2); // the bearer id following the EPS default bearer
    
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def (eutra_Cell1); // @sic R5-185126 sic@
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1 - 10" siclog@
    f_UT_RequestIMSEmergencyCall(UT, px_EmergencyCallNumber);
    
    // @siclog "Step 3 - 13" siclog@
    //Steps 2 to 12 of the generic procedure for MTSI MO emergency speech call establishment in E-UTRA (TS 36.508 4.5A.4.3-1)
    v_NasInd := f_EUTRA_508_EstablishIMSEmergencyCall_Step9(eutra_Cell1);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS2]); // @sic R5s160118 sic@
    
    f_EUTRA_508_EstablishIMSEmergencyCall_Steps10_12(eutra_Cell1,
                                                     v_EpsDefBearerId2,
                                                     v_NasInd,
                                                     true,
                                                     PDN_2);
    // @siclog "Step 18 - 20" siclog@
    // Steps 13 to 15 of the generic EUTRA/EPC procedure for IMS emergency speech call establishment in E-UTRA (TS 36.508 4.5A.4.3-1).
    
    f_EUTRA_508_EstablishIMSEmergencyCall_Steps13_15(eutra_Cell1,
                                                     v_EpsDefBearerId2,
                                                     v_EpsDedicatedBearerId,
                                                     PDN_2);  /* @sic R5-153746: "Steps13_14" ->  "Steps13_15" sic@ */
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2]);
    
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, v_EpsDefBearerId2); // @sic R5s160282 R5s160614 sic@
    
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
