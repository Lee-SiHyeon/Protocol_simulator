    /* @sic R5w140111: p_DisplayName - type changed from charstring to DisplayName sic@ */
    displayName := p_DisplayName,
    addrSpec    := p_SipUrl
  };

  template (value) NameAddr cs_NameAddr(template (value) SipUrl p_SipUrl) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    displayName := omit,
    addrSpec    := p_SipUrl
  };

  template (present) Accept cr_AcceptDef (charstring p_MediaRange) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    fieldName := ACCEPT_E,
    acceptArgs := {
      {
        mediaRange := p_MediaRange,
        acceptParam := omit
      }
    }
  };

  template (value) AcceptBody cs_AcceptBody(charstring p_MediaRange) :=
