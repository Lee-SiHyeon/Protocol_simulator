    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("QoS", p_Value);

