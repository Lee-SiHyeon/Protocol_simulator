module EUTRA_CellInfoInit_MFBI {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoFrequencyRF all;
  import from EUTRA_Component all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_SysInfo_Templates all;

  /*
   * @desc      To initialise the band and MFBI CA frequencies of a cell
   *            Frequencies are defined in 36.508 Table 6.2.3.4: Test frequencies for MFBI frequency band priority adjustment signalling test
   *            Function specific to MFBI CA TC 6.1.2.23
   * @param     p_Band_Cell1
   * @param     p_DL_ChBandwidth_Cell1
   * @param     p_UL_ChBandwidth_Cell1
   * @param     p_Band_Cell10
   * @param     p_OverlappingBand_Cell10
   * @param     p_DL_ChBandwidth_Cell10
   * @param     p_UL_ChBandwidth_Cell10
   * @status    APPROVED (LTE_A_R12)
   */
  function f_EUTRA_InitBandFrequency_MFBI_CA(integer  p_Band_Cell1,
                                             Dl_Bandwidth_Type  p_DL_ChBandwidth_Cell1,
                                             Ul_Bandwidth_Type  p_UL_ChBandwidth_Cell1,
                                             integer  p_Band_Cell10,
                                             integer  p_OverlappingBand_Cell10,
                                             Dl_Bandwidth_Type  p_DL_ChBandwidth_Cell10,
                                             Ul_Bandwidth_Type  p_UL_ChBandwidth_Cell10) runs on EUTRA_PTC
  {
    var FrequencyLowMidHigh_Type v_FreqLMH_Cell1;
    var FrequencyLowMidHigh_Type v_FreqLMH_Cell10;
    
    //Initialise Frequencies f1/f2/f3/f4
    v_FreqLMH_Cell1 := f_EUTRA_InitFrequencyLowMidHigh( p_Band_Cell1, p_DL_ChBandwidth_Cell1, p_UL_ChBandwidth_Cell1 );
    v_FreqLMH_Cell10 := f_EUTRA_InitFrequencyLowMidHigh( p_Band_Cell10, p_DL_ChBandwidth_Cell10, p_UL_ChBandwidth_Cell10 );
    //Acc to 36.508 Table 6.2.3.4
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell1, v_FreqLMH_Cell1.FrequencyMid);
    f_EUTRA_CellInfo_SetEARFCN(eutra_Cell10, v_FreqLMH_Cell10.FrequencyMid);
    
    //Set the frequency band
    f_EUTRA_CellInfo_SetBand(eutra_Cell1, p_Band_Cell1);
    f_EUTRA_CellInfo_SetBand(eutra_Cell10, p_Band_Cell10);
    
    //Set MFBI band
    if (p_OverlappingBand_Cell10<64) { //Handle MFBI Band extension
      f_EUTRA_CellInfo_SetSysInfo_SIB1_v8h0_IEs(eutra_Cell10,cs_SystemInformationBlockType1_v8h0_IEs({p_OverlappingBand_Cell10}));
    } else { //Band>64
      f_EUTRA_CellInfo_SetSysInfo_SIB1_v8h0_IEs(eutra_Cell10,cs_SystemInformationBlockType1_v8h0_IEs({maxFBI},
                                                                                                     cs_SystemInformationBlockType1_v9e0(omit, cs_MultiBandInfoList1_v9e0(p_OverlappingBand_Cell10))));
    }
  }

}
