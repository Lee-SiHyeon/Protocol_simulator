  template (value) UL_DPCH_PowerControlInfo_r4 cs_UL_DPCH_PowerControlInfo_r4_TDD(UL_TargetSIR p_UL_TargetSIR := tsc_UL_TargetSIR) :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    tdd := {
      ul_TargetSIR := p_UL_TargetSIR,
      ul_OL_PC_Signalling := {
        individuallySignalled := {
          tddOption := {
            tdd128 := {
              tpc_StepSize := tsc_TPC_StepSize_TDD  // 1
            }
          },
          primaryCCPCH_TX_Power := tsc_PrimaryCCPCH_TX_Power  // 12
        }
      }
    }
  };

