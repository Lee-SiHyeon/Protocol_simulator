module RRC_MDT_InterRAT_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from CommonIratDefs all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA_BandDependentParam all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_SecurityFunctions all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;
  import from EUTRA_SecurityFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_1_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { // Inter-RAT MDT / Immediate MDT / Periodic Reporting of E-UTRAN / Location Information
    var integer v_EUTRA_CellPower_T0_FR1_FR2 := -85;

    f_EUTRA38_IRAT_Init(c31);

    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, v_EUTRA_CellPower_T0_FR1_FR2); //@sic R5-216497 sic@
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);

    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_6_2_1_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();

  }

  /*
   * @desc      test body of TC_8_1_6_2_1_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_1_NR5GC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    var Frequency_IE_Type v_Frequency_IE_f1;
    var ChannelBandwidthDependency_Type v_ChBandDependency_f1;
    var integer v_Arfcn;
    var AllowedMeasBandwidth v_DL_AllowedMeasBandwidth;
    var integer v_DL_Bandwidth;
    var template (value) B28_Type v_EUTRA_CellId;
    var template (value) CoOrd_EUTRASysInfo_List_Type v_SysInfo_EUTRA;
    var integer v_EUTRA_CellPower_T1_FR1 := -85; //@sic R5-220050, R5-216497 sic@
    var integer v_EUTRA_CellPower_T1_FR2 := -96; //@sic R5-232393 sic@
    
    v_EUTRA_CellId := int2bit(f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),28);
    v_Frequency_IE_f1 := f_EUTRA_CellInfo_GetFrequencyIEs(eutra_Cell1);
    v_ChBandDependency_f1 := f_EUTRA_BandDependentParam(v_Frequency_IE_f1.DL_ChBandwidth, v_Frequency_IE_f1.UL_ChBandwidth );
    v_DL_AllowedMeasBandwidth := v_ChBandDependency_f1.AllowedMeasBandwidth;
    v_DL_Bandwidth := f_EUTRA38_IRAT_ConvertEUTRA_AllowedMeasBandwidthToInteger(v_DL_AllowedMeasBandwidth);
    v_Arfcn := v_Frequency_IE_f1.UL_DL_Earfcn.dl_CarrierFreq_r9;
    v_SysInfo_EUTRA[0] := cs_CoOrdEUTRASysInfo(v_Arfcn, v_DL_Bandwidth, -, -, -,  v_EUTRA_CellId, -, -, -);
    f_EUTRA_NR_SendSysinfoCoOrd(NR, cs_EUTRA_NR_CoOrdSysInfo_Eutra(v_SysInfo_EUTRA));

    //@siclog "Step  3" siclog@
    //The SS changes E-UTRA Cell 1 parameters according to row "T1" in Table 8.1.6.2.1.3.2-1 or 8.1.6.2.1.3.2-2.
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    if (f_EUTRA38_NR_IsFR1_Get())
    {
       f_EUTRA38_SetCellPower(eutra_Cell1, v_EUTRA_CellPower_T1_FR1, v_EUTRA_CellPower_T1_FR1)
    }
    else
    {
       f_EUTRA38_SetCellPower(eutra_Cell1, v_EUTRA_CellPower_T1_FR2, v_EUTRA_CellPower_T1_FR2)
    }
    
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
 function f_TC_8_1_6_2_2_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //Inter-RAT MDT / Logged MDT / E-UTRA Inter-RAT measurement, logging and reporting
    var template (value) B28_Type v_EUTRA_CellId;
    var template (value) CoOrd_EUTRASysInfo_Type v_CoOrd_SysInfo;
    
    f_EUTRA38_IRAT_Init(c31);

    //@sic R5s230326, R5-232333 sic@
    v_CoOrd_SysInfo := f_EUTRA_CoOrdSysInfo(eutra_Cell1);
    v_EUTRA_CellId := int2bit(f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),28);
    v_CoOrd_SysInfo.CellId := v_EUTRA_CellId;
    f_EUTRA_NR_SendSysinfoCoOrd(NR, cs_EUTRA_NR_CoOrdSysInfo_Eutra({v_CoOrd_SysInfo})); // sends Freq. Info to the other RAT
 
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
          
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_6_2_2_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    // take down the cell now, UE finished postamble on NR side
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_6_2_2_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_2_NR5GC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {

   // @siclog "Step 3" siclog@
   //The SS changes cell power levels according to the row "T1" in table 8.1.6.2.2.3.2-1/2.
   f_EUTRA_NR_WaitForCoOrd_Trigger (NR);
   f_EUTRA38_SetCellPower(eutra_Cell1, -95, -96);//@sic R5-241045 sic@

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_3_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { // Inter-RAT MDT / Radio Link Failure / Reporting at E-UTRA Inter-RAT handover
    
    f_EUTRA38_IRAT_Init(c31); //System information combination 31 as defined in TS 36.508 [7] clause 4.4.3.1 is used in the E-UTRA cell.
    //initiate the power level
    f_EUTRA_CellInfo_InitMaxReferencePower( eutra_Cell1, -73);
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);// @sic R5s220831 sic@
    f_EUTRA38_SetCellPower(eutra_Cell1, -73, tsc_NonSuitableOffCellRS_EPRE);// @sic R5-216499 R5-220052 sic@
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_6_2_3_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);

    // UE now on NR
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_6_2_3_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_3_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var octetstring v_NR_HOCmd;
    var EUTRA_SecurityParams_Type v_SecurityParams := f_EUTRA_Security_Get();
    var template (value) B28_Type v_EUTRA_CellId;
    var template (value) CoOrd_EUTRASysInfo_Type v_CoOrd_SysInfo := f_EUTRA_CoOrdSysInfo(eutra_Cell1);// @sic R5s220831 sic@
      // Send EUTRA frequency to NR
    v_EUTRA_CellId := int2bit(f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),28);// @sic R5s220831 sic@
    v_CoOrd_SysInfo.CellId := v_EUTRA_CellId;// @sic R5s220831 sic@
    f_EUTRA_NR_SendSysinfoCoOrd(NR, cs_EUTRA_NR_CoOrdSysInfo_Eutra({v_CoOrd_SysInfo}));// @sic R5s220831 sic@

    
    // @siclog "Step 5-5F" siclog@
    f_TAU_N1ToS1_ReconfigDRBs(eutra_Cell1, tsc_RRC_TI_Def, "Step5", omit);
    v_SecurityParams := f_EUTRA_Security_Get();
    // @siclog "Step 6" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, -85, tsc_NonSuitableOffCellRS_EPRE);// @sic R5-216499 R5-220052 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Power Level"));
    // @siclog "Step 7" siclog@
    // the source MME shall increase its locally kept NCC value by one and compute a fresh NH using A.4
    v_SecurityParams.NH := f_EUTRA_NB_Authentication_S12(v_SecurityParams.KDF,
                                                         v_SecurityParams.KASME,
                                                         v_SecurityParams.NH);
    // 33.501 cl. 8.4.2 point 3: the target AMF shall also set the NCC to zero
    v_SecurityParams.NCC := 2; // @sic R5-212374 sic@
    f_EUTRA_Security_Set (v_SecurityParams);
    // Send latest parameters to NR
    f_EUTRA38_Send_AuthParametersToNR();
    
    f_EUTRA38_SendPduSessionInfoListToNR();
    
    // Wait for NR to send back encoded RRC Reconfiguration message
    v_NR_HOCmd := f_EUTRA_NR_WaitForCoOrd_Data(NR, "HO Cmd");

    SRB.send( cas_SRB1_RrcPdu_REQ( eutra_Cell1, cs_TimingInfo_Now, cs_MobilityFromEutraCommand_Handover( tsc_RRC_TI_Def,
                                                                                                         false,
                                                                                                         nr,
                                                                                                         v_NR_HOCmd,
                                                                                                         omit)));
    // UE now moved to NR
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.6.2.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_6_2_4_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { // Inter-RAT MDT / Radio Link Failure / Reporting at E-UTRA Inter-RAT handover
    // @sic R5s220801, R5s230112 sic@
    var template (value) B28_Type v_EUTRA_CellId;
    var template (value) CoOrd_EUTRASysInfo_Type v_CoOrd_SysInfo;
    
    f_EUTRA38_IRAT_Init(c1);
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell1, -90);

    v_CoOrd_SysInfo := f_EUTRA_CoOrdSysInfo(eutra_Cell1);
    v_EUTRA_CellId := int2bit(f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell1),28);
    v_CoOrd_SysInfo.CellId := v_EUTRA_CellId;
    f_EUTRA_NR_SendSysinfoCoOrd(NR, cs_EUTRA_NR_CoOrdSysInfo_Eutra({v_CoOrd_SysInfo}));

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_6_2_4_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);

    f_EUTRA_NR_WaitForCoOrd_Trigger(NR, "Postamble");
    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_6_2_4_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_6_2_4_NR5GC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR, "Power Level");
   if (f_EUTRA38_NR_IsFR1_Get())
    {
       f_EUTRA38_SetCellPower(eutra_Cell1, -96, -96); //@sic R5s230492 sic@
    }
    else
    {
       f_EUTRA38_SetCellPower(eutra_Cell1, -96, -96); //@sic R5-232393 sic@)
    }
  }

}
