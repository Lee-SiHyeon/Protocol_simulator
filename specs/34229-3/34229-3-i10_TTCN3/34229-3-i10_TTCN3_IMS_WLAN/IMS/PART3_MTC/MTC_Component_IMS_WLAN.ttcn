module MTC_Component_IMS_WLAN {

  import from CommonDefs all;
  import from IMS_CC_Component all;
  import from IMS_Component all;
  import from IPCAN_WLAN all;
  import from MTC_Base all;
  import from MTC_Component_IMS_Common all;
  import from UpperTesterSystemCmds all;
  import from WLAN_Component all;

  type component SYSTEM_IMS extends WLAN_SYSTEM, SYSTEM_IMS_BASE {};  /* @status    APPROVED (IMS) */

  /*
   * @desc      Create parallel test components and connect all MTC ports to the system ports
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @param     p_UseXCAP           (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_CreateMapAndConnectPTCs_WLAN(SYSTEM_IMS p_System,
                                                  IMS_PTC p_IMS1,
                                                  IMS_PTC p_IMS2,
                                                  boolean p_UseXCAP := false) runs on MTC_IMS
  {
    var WLAN_PTC v_WLAN;
    var boolean v_UseDNS := true;

    f_MTC_IMS_InitAndConnect_IP_IMS(p_System, p_IMS1, p_IMS2, v_UseDNS, p_UseXCAP);

    v_WLAN := WLAN_PTC.create("WLAN") alive;                                      // @sic R5s201263 sic@  @sic R5s210270 sic@  @sic R5s221170 sic@

    f_WLAN_PTC_Map(p_System, v_WLAN);

    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_WLAN], v_WLAN:UT);
    connect(v_WLAN:IP, vc_Components.IP:WLAN_CTRL);
    if (p_IMS1 != null) { connect(vc_Components.IMS1:IPCAN, v_WLAN:IMS[tsc_Index_IMS1]); }
    if (p_IMS2 != null) { connect(vc_Components.IMS2:IPCAN, v_WLAN:IMS[tsc_Index_IMS2]); }

    f_UT_InitialPowerOffUE(Ut);

    v_WLAN.start(f_WLAN_IPCAN_MainLoop());
  }

  /*
   * @desc      Create parallel test components, connects all MTC ports and starts HTTP
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_XCAP_CreateMapAndConnectPTCs_WLAN(SYSTEM_IMS p_System,
                                                       IMS_XCAP_PTC p_IMS1,
                                                       IMS_XCAP_PTC p_IMS2) runs on MTC_IMS
  {
    var boolean v_UseXCAP := true;
    f_MTC_IMS_CreateMapAndConnectPTCs_WLAN(p_System, p_IMS1, p_IMS2, v_UseXCAP);
    f_MTC_IMS_CreateMapConnectAndStartHTTP(p_System, p_IMS1);
  }

}
