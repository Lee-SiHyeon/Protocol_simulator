module MCX_SecurityParameters {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_SecurityFunctions all;

  const octetstring tsc_ECCSI_KSAK := '012345'O;                /* ECCSI KSM Secret Authentication Key according to RFC 6507
                                                                   value arbetrarily selected (0x12345 as in appendix A;
                                                                   constant may be replaced by PIXIT if needed
                                                                   @status    APPROVED (MCX) */

  const octetstring tsc_SAKKE_MasterSecret := '01234567'O;      /* SAKKE master secret z_T according to RFC 6508
                                                                   value arbetrarily selected;
                                                                   constant may be replaced by PIXIT if needed
                                                                   @status    APPROVED (MCX) */

  const integer tsc_MCX_KeyPeriodLength := 2592000;             /* Key period length in seconds: 30 days
                                                                   @status    APPROVED (MCX) */

  const B4_Type tsc_MCX_KeyId_PurposeGMK := '0000'B;   /* lower 4 bits of the GMK Type in 33.180 Table E.6.11-1  @status    APPROVED (MCX) */

  const B4_Type tsc_MCX_KeyId_PurposePCK := '0001'B;   /* lower 4 bits of the PCK Type in 33.180 Table E.6.11-1  @status    APPROVED (MCX) */

  const B4_Type tsc_MCX_KeyId_PurposeCSK := '0010'B;   /* lower 4 bits of the CSK Type in 33.180 Table E.6.11-1  @status    APPROVED (MCX) */

  const O16_Type tsc_MIKEY_RAND := 'FEDCBA0987654321FEDCBA0987654321'O;         /* @status    APPROVED (MCX) */

  type enumerated MCX_KeyIndex_Type {                                           /* @status    APPROVED (MCX) */
    GMK,        // Group Master Key
    PCK,        // Private Call Key
    CSK,        // Client-Server Key used between the UE and the MCX server (in general up-loaded by the UE)
    CSK_CMS,    // Client-Server Key used between the UE and the Configuration Management Server
    CSK_GMS1,   // First Client-Server Key used between the UE and the Group Management Server (e.g. to be used for xcap-diff dialog for group documents)
    CSK_GMS2,   // Second Client-Server Key used between the UE and the Group Management Server (may be used for xcap-diff dialog for GMK download; GKTP)
    CSK_GMS3,   // Third Client-Server Key used between the UE and the Group Management Server (may be used for xcap-diff dialog for 2nd group document)
    CSK_GMS4,   // Fourth Client-Server Key used between the UE and the Group Management Server (may be used for xcap-diff dialog for 2nd group GKTP)
    TrK,
    InK
  };

  type record ECCSI_Parameters {                        /* @status    APPROVED (MCX) */
    octetstring                 KSAK,                   /* KMS Secret Authentication Key */
    octetstring                 KPAK,                   /* KMS Public Authentication Key; distributed to the client in the KMS Certificate */
    ECCSI_SskPvtPair_Type       ClientSskPvtPair        /* SSK, PVT distributed to the client in the KMS Key Set */
  };

  type record SAKKE_Parameters {                        /* @status    APPROVED (MCX) */
    octetstring MasterSecret,
    octetstring PublicKey,
    octetstring ClientRSK
  };

  type record MCX_KeyPeriod_Parameters {                /* @status    APPROVED (MCX) */
    integer     Length,                                 /* 33.180 F.2.1: P3 := Key Period length in seconds */
    integer     Offset,                                 /* 33.180 F.2.1: P4 := Key Period offset in seconds */
    integer     No                                      /* 33.180 F.2.1: P5 := Current Key Period No. since 0h on 1 January 1900 */
  };

  type record MCX_SecurityKeyContainer_Type {           /* to allow initialisation of keys in the array as omit
                                                           @status    APPROVED (MCX) */
    MCX_SecurityKey_Type Key optional
  };

  type record of MCX_SecurityKeyContainer_Type MCX_SecurityKeyContainerList_Type;               /* @status    APPROVED (MCX) */

  type record MCX_Tokens_Type {                         /* @status    APPROVED (MCX) */
    charstring IdToken,
    charstring AccessToken,
    charstring RefreshToken
  };

  type record MCX_SecurityParameters_Type {             /* @status    APPROVED (MCX) */
    charstring                          KSM_Id,         // KMS Identifier as used as P2 in 33.180 F.2.1.1
    ECCSI_Parameters                    ECCSI,          // Parameters for ECCSI (RFC 6507): KSAK, KPAK and the SSK, PVT pair which is provided to the client in KMS Key Set to protect keys provided by the UE (e.g. CSK upload)
    SAKKE_Parameters                    SAKKE,
    MCX_KeyPeriod_Parameters            KeyPeriod,
    MCX_SecurityKeyContainerList_Type   Keys,
    MCX_Tokens_Type                     Tokens
    /* to be continued */
  };

  template (value) MCX_SecurityKey_Type cs_MCX_SecurityKey(B32_Type p_Id,
                                                           octetstring p_Value,
                                                           template (omit) octetstring p_RAND := omit) :=
  { /* @status    APPROVED (MCX) */
    Id := p_Id,
    Value := p_Value,
    RAND := p_RAND
  };

  template (value) MCX_SecurityParameters_Type cs_MCX_SecurityParameters_Init :=
  { /* @status    APPROVED (MCX) */
    KSM_Id := "",
    ECCSI := {
      KSAK := tsc_ECCSI_KSAK,
      KPAK := ''O,
      ClientSskPvtPair := {
        SSK := ''O,
        PVT := ''O
      }
    },
    SAKKE := {
      MasterSecret := tsc_SAKKE_MasterSecret,
      PublicKey := ''O,
      ClientRSK := ''O
    },
    KeyPeriod := {
      Length := tsc_MCX_KeyPeriodLength,
      Offset := -1,
      No := -1
    },
    Keys := {},
    Tokens := {
      IdToken := "",
      AccessToken := "",
      RefreshToken := ""
    }
  };

  /*
   * @desc      Initialisation of security parameters
   * @param     p_KSM_Id
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_Init(charstring p_KSM_Id) return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := valueof(cs_MCX_SecurityParameters_Init);
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var MCX_SecurityKey_Type v_GMK := f_MCX_SecurityParameters_CreateKey(GMK);
    var MCX_SecurityKey_Type v_PCK := f_MCX_SecurityParameters_CreateKey(PCK);

    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, GMK, v_GMK);
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, PCK, v_PCK);
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK);            // initialised as omit
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK_CMS);        // initialised as omit
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK_GMS1);       // initialised as omit
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK_GMS2);       // initialised as omit
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK_GMS3);       // initialised as omit @sic R5s210398 sic@
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, CSK_GMS4);       // initialised as omit @sic R5s210398 sic@
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, TrK, cs_MCX_SecurityKey(px_MCX_TrK_ID, bit2oct(px_MCX_TrK)));
    v_SecurityParameters := f_MCX_SecurityParameters_SetKey(v_SecurityParameters, InK, cs_MCX_SecurityKey(px_MCX_InK_ID, bit2oct(px_MCX_InK)));

    v_SecurityParameters.KSM_Id := p_KSM_Id;
    v_SecurityParameters.ECCSI.KPAK := fx_ECCSI_GenerateKPAK(v_SecurityParameters.ECCSI.KSAK);
    v_SecurityParameters.SAKKE.PublicKey := fx_SAKKE_GeneratePublicKey(v_SecurityParameters.SAKKE.MasterSecret);
    v_SecurityParameters.KeyPeriod.Offset := v_TimestampSeconds mod v_SecurityParameters.KeyPeriod.Length;      /* 36.579-1 Table 5.5.4.10.6-1: KMS Certificate
                                                                                                                   P4 in 33.180 F.2.1; P4 set so that the current timestamp is at the beginning of key period */
    v_SecurityParameters.KeyPeriod.No :=
      (v_TimestampSeconds - v_SecurityParameters.KeyPeriod.Offset) / v_SecurityParameters.KeyPeriod.Length;     /* 36.579-1 Table 5.5.4.10.8-1: KMS Key Set;
                                                                                                                   P5 in 33.180 F.2.1: P5 = Floor ( ( TIME - P4 ) / P3 )
                                                                                                                   @sic R5s240360: TIME - P4 sic@ */
    return v_SecurityParameters;
  }

  /*
   * @desc      Generate and store Receiver Secret Key (RSK); RFC 6508
   * @param     p_SecurityParameters
   * @param     p_MCPTT_UID
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_SetClientRSK(MCX_SecurityParameters_Type p_SecurityParameters,
                                                 octetstring p_MCPTT_UID) return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    v_SecurityParameters.SAKKE.ClientRSK := fx_SAKKE_GenerateRSK(v_SecurityParameters.SAKKE.MasterSecret, p_MCPTT_UID);
    return v_SecurityParameters;
  }

  /*
   * @desc      Generate and store SSK/PVT pair; RFC 6507
   * @param     p_SecurityParameters
   * @param     p_MCPTT_UID
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_SetSskPvtPair(MCX_SecurityParameters_Type p_SecurityParameters,
                                                  octetstring p_MCPTT_UID) return MCX_SecurityParameters_Type
  {
    var integer v_EphemeralValue := hex2int('65432'H);     // random (ephemeral) non-zero v according to RFC 6507 clause 5.1.1; arbitrarily selected
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    
    v_SecurityParameters.ECCSI.ClientSskPvtPair := f_ECCSI_GenerateSskPvtPair(p_MCPTT_UID,
                                                                              v_SecurityParameters.ECCSI.KSAK,
                                                                              v_SecurityParameters.ECCSI.KPAK,
                                                                              v_EphemeralValue);
    return v_SecurityParameters;
  }

  /*
   * @desc      Set Id, Access and Refresh Token
   * @param     p_SecurityParameters
   * @param     p_Tokens
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_SetTokens(MCX_SecurityParameters_Type p_SecurityParameters,
                                              MCX_Tokens_Type p_Tokens) return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    v_SecurityParameters.Tokens := p_Tokens;
    return v_SecurityParameters;
  }

  /*
   * @desc      Create key, initialise and return MCX_SecurityKey_Type
   * @param     p_KeyIndex
   * @param     p_KeyOffset         (default value: 1)
   * @return    MCX_SecurityKey_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_CreateKey(MCX_KeyIndex_Type p_KeyIndex,
                                              integer p_KeyOffset := 1) return MCX_SecurityKey_Type
  { /* p_KeyOffset  ..  In case that more than one key of the same type (p_KeyIndex) is needed */
    var integer v_RandomIndex := (p_KeyOffset * 64) + enum2int(p_KeyIndex);       /* used to achieve KeyId random part and the key value to be different for different keys */
    var B28_Type v_KeyIdRandomPart := int2bit(v_RandomIndex, 28);
    var O16_Type v_MIKEY_RandomKey := f_GetN_OctetsFromPRBS(v_RandomIndex, 16);
    var template (value) MCX_SecurityKey_Type v_SecurityKey;
    var B4_Type v_KeyIdPurpose;
    var B32_Type v_KeyId;

    select (p_KeyIndex) {
      case (GMK) { v_KeyIdPurpose := tsc_MCX_KeyId_PurposeGMK; }
      case (PCK) { v_KeyIdPurpose := tsc_MCX_KeyId_PurposePCK; }
      case (CSK) { v_KeyIdPurpose := tsc_MCX_KeyId_PurposeCSK; }
      case else  { FatalError(__FILE__, __LINE__, "Invalid key index"); }
    }
    v_KeyId := v_KeyIdPurpose & v_KeyIdRandomPart;
    v_SecurityKey := cs_MCX_SecurityKey(v_KeyId, v_MIKEY_RandomKey, tsc_MIKEY_RAND);
    return valueof(v_SecurityKey);
  }

  /*
   * @desc      Set key with given index
   * @param     p_SecurityParameters
   * @param     p_KeyIndex
   * @param     p_SecurityKey       (default value: omit)
   * @return    MCX_SecurityParameters_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_SetKey(MCX_SecurityParameters_Type p_SecurityParameters,
                                           MCX_KeyIndex_Type p_KeyIndex,
                                           template (omit) MCX_SecurityKey_Type p_SecurityKey := omit) return MCX_SecurityParameters_Type
  {
    var MCX_SecurityParameters_Type v_SecurityParameters := p_SecurityParameters;
    var integer v_Index := enum2int(p_KeyIndex);
    if (isvalue(p_SecurityKey)) {
      v_SecurityParameters.Keys[v_Index].Key := valueof(p_SecurityKey);
    } else {
      v_SecurityParameters.Keys[v_Index].Key := omit;
    }
    return v_SecurityParameters;
  }

  /*
   * @desc      Check whether key with given index exists already
   * @param     p_SecurityParameters
   * @param     p_KeyIndex
   * @return    boolean
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_KeyExists(MCX_SecurityParameters_Type p_SecurityParameters,
                                              MCX_KeyIndex_Type p_KeyIndex) return boolean
  {
    var integer v_Index := enum2int(p_KeyIndex);
    return isvalue(p_SecurityParameters.Keys[v_Index].Key);
  }

  /*
   * @desc      Get key with given index; returns omit when the key does not exist
   * @param     p_SecurityParameters
   * @param     p_KeyIndex
   * @return    template (omit) MCX_SecurityKey_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_GetOptionalKey(MCX_SecurityParameters_Type p_SecurityParameters,
                                                   MCX_KeyIndex_Type p_KeyIndex) return template (omit) MCX_SecurityKey_Type
  {
    var integer v_Index := enum2int(p_KeyIndex);

    if (not f_MCX_SecurityParameters_KeyExists(p_SecurityParameters, p_KeyIndex)) {
      return omit;
    }
    return p_SecurityParameters.Keys[v_Index].Key;
  }

  /*
   * @desc      Get key with given index; a runtime error is raised when the key does not exist
   * @param     p_SecurityParameters
   * @param     p_KeyIndex
   * @return    MCX_SecurityKey_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_GetExistingKey(MCX_SecurityParameters_Type p_SecurityParameters,
                                                   MCX_KeyIndex_Type p_KeyIndex) return MCX_SecurityKey_Type
  {
    var template (omit) MCX_SecurityKey_Type v_Key := f_MCX_SecurityParameters_GetOptionalKey(p_SecurityParameters, p_KeyIndex);   // @sic R5s240279: f_MCX_SecurityParameters_GetOptionalKey sic@

    if (not isvalue(v_Key)) {
      FatalError(__FILE__, __LINE__, "key is not initialised");
    }
    return valueof(v_Key);
  }

  /*
   * @desc      Extract and validate 16 octet key
   * @param     p_SecurityParameters
   * @param     p_ReceiverURI
   * @param     p_CSK_Id
   * @param     p_SakkeData
   * @return    template (omit) MCX_SecurityKey_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_ExtractKeyFromSakkeData(MCX_SecurityParameters_Type p_SecurityParameters,
                                                            charstring p_ReceiverURI,
                                                            B32_Type p_CSK_Id,
                                                            octetstring p_SakkeData) return template (omit) MCX_SecurityKey_Type
  {
    var octetstring v_UID := f_MCX_SecurityParameters_GetUID(p_SecurityParameters, p_ReceiverURI);      // the receiver's UID
    var octetstring v_RSK := fx_SAKKE_GenerateRSK(p_SecurityParameters.SAKKE.MasterSecret, v_UID);
    var template (omit) O16_Type v_CSK := fx_SAKKE_ExtractKey(p_SakkeData, v_RSK, p_SecurityParameters.SAKKE.PublicKey, v_UID);
    var template (omit) MCX_SecurityKey_Type v_SecurityKey := omit;

    if (isvalue(v_CSK)) {
      v_SecurityKey := cs_MCX_SecurityKey(p_CSK_Id, valueof(v_CSK));
    }
    
    return v_SecurityKey;
  }

  /*
   * @desc      Generate UID for given identifier
   * @param     p_SecurityParameters
   * @param     p_Identifier
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_SecurityParameters_GetUID(MCX_SecurityParameters_Type p_SecurityParameters,
                                           charstring p_Identifier) return octetstring
  {
    return f_MCX_MIKEY_SAKKE_GenerateUID(p_Identifier, p_SecurityParameters.KSM_Id, p_SecurityParameters.KeyPeriod.Length, p_SecurityParameters.KeyPeriod.Offset, p_SecurityParameters.KeyPeriod.No);
  }

}
