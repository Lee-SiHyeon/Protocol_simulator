module RRC_NPN_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_Measurement_Functions all;
  import from NR_Measurement_Templates all;

  template MeasResultNR cr_NR_MeasResultNR_CellResults_NPN(PhysCellId p_PhysCellId,
                                                           template CGI_InfoNR p_CGI_InfoNR
  ):=   /* @status    APPROVED (NR5GC) */
    cr_NR_MeasResultNR(p_PhysCellId, ?, p_CGI_InfoNR);

  template CGI_InfoNR cr_CGI_InfoNR_Base (template PLMN_IdentityInfoList p_PLMN_IdentityInfoList := omit,
                                          template MultiFrequencyBandListNR p_MultiFrequencyBandListNR := omit,
                                          template NPN_IdentityInfoList_r16 p_NPN_IdentityInfoList_r16 := omit,
                                          template CGI_InfoNR.cellReservedForOtherUse_r16 p_CellReservedForOtherUse_r16 := omit) :=
  { /* @status    APPROVED (NR5GC) */
      plmn_IdentityInfoList := p_PLMN_IdentityInfoList,
      frequencyBandList := p_MultiFrequencyBandListNR,
      noSIB1 := omit,
      npn_IdentityInfoList_r16 := p_NPN_IdentityInfoList_r16,
      cellReservedForOtherUse_r16 := p_CellReservedForOtherUse_r16
  }

  template CGI_InfoNR cr_CGI_InfoNR_NoSIB1 (integer p_SSB_SubcarrierOffset,
                                            template PDCCH_ConfigSIB1 p_PDCCH_ConfigSIB1) :=
  { /* @status    APPROVED (NR5GC) */
      plmn_IdentityInfoList := omit,
      frequencyBandList := omit,
      noSIB1 :=
      {
          ssb_SubcarrierOffset := p_SSB_SubcarrierOffset,
          pdcch_ConfigSIB1 := p_PDCCH_ConfigSIB1
      },
      npn_IdentityInfoList_r16 := omit,
      cellReservedForOtherUse_r16 := omit
  }

  /*
   * @desc      Retrieve CGI info of a given cell
   * @param     p_NR_CellId
   * @return    template CGI_InfoNR
   * @status    APPROVED (NR5GC)
   */
  function f_NR_GetCGI_InfoNR(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template CGI_InfoNR
  {
    var template (value) CellAccessRelatedInfo  v_CellAccessRelatedInfo;
    var template CGI_InfoNR.cellReservedForOtherUse_r16 v_CellReservedForOtherUse_r16 := omit;
    var template (omit) MultiFrequencyBandListNR v_FreqBandList;
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var MIB v_MIB;
    if (isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo))
    {
        v_CellAccessRelatedInfo := v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.cellAccessRelatedInfo;
        if (isvalue(v_NR_CellInfo.FrequencyBand.FrequencyInfoDL))
        { //DL defined in the cell
              v_FreqBandList := v_NR_CellInfo.FrequencyBand.FrequencyInfoDL.frequencyBandList;
        }
        else
        {//UL cell only
          v_FreqBandList := v_NR_CellInfo.FrequencyBand.FrequencyInfoUL.frequencyBandList;
        }
        if (ispresent(v_CellAccessRelatedInfo.cellReservedForOtherUse))
        {
            v_CellReservedForOtherUse_r16 := true_;
        }
        return  cr_CGI_InfoNR_Base(v_CellAccessRelatedInfo.plmn_IdentityInfoList,
                                   v_FreqBandList,
                                   v_CellAccessRelatedInfo.npn_IdentityInfoList_r16,
                                   v_CellReservedForOtherUse_r16)
    }
    else
    {//SIB1 is not broadcasted
        v_MIB := v_NR_CellInfo.Sysinfo.BcchInfo.MIB.message_.mib;
        return  cr_CGI_InfoNR_NoSIB1(v_MIB.ssb_SubcarrierOffset,
                                     v_MIB.pdcch_ConfigSIB1)
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.7.1.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_7_1_1_NR5GC() runs on NR5GC_PTC
  { //Measurement configuration control and reporting / CGI reporting of NR NPN cell
      
    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template CGI_InfoNR v_CGI_InfoNR;
    var float v_Wait;
      
    f_NR5GC_Init(NR_2);
      
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        v_Wait := 2.0;
        f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -88, -82);
    }
    else
    {
        v_Wait := 16.0;
        f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -82, -91);
    }

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellInfo_SetSIB1_SetPNI_NPN_IdentityInfoList(nr_Cell2);  //CAG cell2
    f_NR_CellInfo_SetSIB1_CellReservedForOtherUse(nr_Cell2, true_); //@sic R5-225304 sic@
    f_NR_CellConfig_Def(nr_Cell2);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);
    f_NR_SetCellPower (nr_Cell2, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2);

    f_NR_TestBody_Set(true);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCReconfiguration message including measConfig including reportCGI for Cell 2
    //and sufficient idle periods for UE to acquire the relevant system information from Cell 2
    //The UE transmits an RRCReconfigurationComplete message.
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1)};
    v_PhysCellIdNeighbour := f_NR_CellInfo_GetPhysicalCellId(nr_Cell2);
    v_ReportConfigList := {cs_NR_ReportConfigCGI(tsc_NR_IdReportConfigId1, v_PhysCellIdNeighbour)};
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1}
      
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);
      
    f_NR_SendRRCReconfiguration_MeasNR_CellGroupConfig_DRX(nr_Cell1, v_MeasConfig, omit, cs_38508_MAC_CellGroupConfig_DRX);
    
    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit a MeasurementReport message
    //with CGI of NR Cell 2 within 2 sec if Cell 2 is in FR1 (or within 16 sec if Cell 2 is in FR2)?
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_CGI_InfoNR := f_NR_GetCGI_InfoNR(nr_Cell2);  //@sic R5s221019, R5-225304 sic@
    f_NR_CheckReceiveMeasurementReports(nr_Cell1, v_PhysCellIdServing, tsc_NR_MeasId1, v_Wait, cr_NR_MeasResults_MeasResultNeighCells_NR({cr_NR_MeasResultNR_CellResults_NPN(v_PhysCellIdNeighbour, v_CGI_InfoNR)}),cr_NR_MeasQuantityResults_Any);
    f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 3");
            
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
      
  }// End of f_TC_8_1_7_1_1_NR5GC()

}
