                                  template (value) SysInfoTypeSB1 p_SB1) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_CellId);
    v_CellInfo.sysInfo.SB1 := valueof(p_SB1);
    f_UTRAN_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Set MIB for given cell
   * @param     p_CellId
   * @param     p_MIB_ValueTag
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UTRAN_SysInfo_SetMIB_ValueTag(UTRAN_CellId_Type p_CellId,
                                           integer           p_MIB_ValueTag) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_CellId);
    v_CellInfo.sysInfo.MIB.mib_ValueTag := p_MIB_ValueTag;
    f_UTRAN_CellInfo_Set(p_CellId, v_CellInfo);
  }

