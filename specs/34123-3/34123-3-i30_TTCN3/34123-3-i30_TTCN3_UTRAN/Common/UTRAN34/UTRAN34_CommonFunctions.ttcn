  /*
   * @desc      To Change the sysinfo configuration in the PREAMBLE
   *            Note:This function can be used only in the preamble before broadcasting sysinfo
   * @param     p_CellId
   * @param     p_Configuration
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ChangeSysinfoConfiguration(UTRAN_CellId_Type p_CellId,
                                                SysinfoConfiguration_Type p_Configuration) runs on UTRAN_PTC
  { //@sic R5-144708 sic@
    var UTRAN_FDD_TDD_Type v_UTRAN_FDD_TDD_Type := f_IRAT_GetUTRAN_FDD_TDD_Mode();
    var template UTRAN_CellSysInfo_Type v_CellSysInfo:= f_UTRAN_SysInfo_Get(p_CellId);
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var integer v_FDD_Band;
    
    if (v_FDD_TDD_Mode == UTRAN_FDD) {  // FDD
      v_FDD_Band := f_UTRAN_CellInfo_GetFDD_Band(p_CellId);
    }
    select (p_Configuration) {
      case(configuration1){
        //Configuration 1 MIB, SB1, SIB1, SIB2, SIB3, SIB4, SIB5/SIB5bis, SIB6, SIB7, SIB11, SIB12, SIB18
        v_CellSysInfo.MIB  := cs_MIB_Def(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
        v_CellSysInfo.SB1  := cs_SB1_NoSIB19;
        v_CellSysInfo.config :=  p_Configuration;
      }
      case(configuration6){ //SIB19 is already initialised in f_UTRAN34_Init
        //Configuration 6   MIB, SB1, SIB1, SIB2, SIB3, SIB4, SIB5/SIB5bis, SIB7, SIB11, SIB12, SIB18, SIB19
        v_CellSysInfo.MIB  := cs_MIB_Def(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
        v_CellSysInfo.SB1  := cs_SB1_Def;
        //SIB5: noSIB6
        v_CellSysInfo.SIB5.sib6indicator := false;
        v_CellSysInfo.config :=  p_Configuration;
      }
      case(configuration8){ //@sic R5-150125 feFACH sic@
        //Configuration 8 MIB, SB1, SIB1, SIB2, SIB3, SIB4, SIB5/SIB5bis, SIB6, SIB7, SIB11, SIB12, SIB18
        //feFACH SIB5 to be initialised inside the test case
        v_CellSysInfo.MIB  := cds_MIB_LongSIB5(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
        v_CellSysInfo.SB1  := cds_SB1_NoSIB19_LongSIB5;
        v_CellSysInfo.config :=  p_Configuration;
      }
      case(configuration9){
        // Initialised SIB21 will all items barred
        v_CellSysInfo.SIB21 := cs_SIB21_Def;
        v_CellSysInfo.MIB  := cs_MIB_Def(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
        v_CellSysInfo.SB1  := cs_SB1_SIB21;
        v_CellSysInfo.config :=  p_Configuration;
      }
      case(configuration10){
        // Initialised SIB22 will acc to 34.108
        v_CellSysInfo.SIB22 := cs_SIB22_Def;
        //feFACH SIB5 to be initialised inside the test case
        v_CellSysInfo.MIB  := cs_MIB_Def(f_UTRAN_CellInfo_GetPLMNIdentity(p_CellId));
        v_CellSysInfo.SB1  := cs_SB1_SIB22;
        v_CellSysInfo.config :=  p_Configuration;
      }
      case else {
        FatalError(__FILE__, __LINE__, "invalid sysinfo configuration");
      }
    }
    //Initialise SIB5/5bis in MIB
    if ((v_UTRAN_FDD_TDD_Type == UTRAN_FDD) and ((v_FDD_Band == 4) or (v_FDD_Band == 9) or (v_FDD_Band == 10))) {
      v_CellSysInfo.MIB.sibSb_ReferenceList[5].sibSb_Type := {sysInfoType5bis := 1};
    } else {
      v_CellSysInfo.SIB5_Type := systemInformationBlockType5;
    }
    f_UTRAN_SysInfo_Set(p_CellId, valueof(v_CellSysInfo));
  }

  /*
   * @desc      Function broadcast sysinfo of the UTRAN cell - use default sheduling 1 in 34.108
   *            Handle all releases
   * @param     p_CellId
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SendDefSysInfo(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    var SysInfoType5 v_Sib5 := f_UTRAN_CellInfo_GetSIB5(p_CellId);
    var UTRAN_CellSysInfo_Type v_CellSysInfo := f_UTRAN_SysInfo_Get(p_CellId);
    var RatType v_RatType  := f_UTRAN_CellInfo_GetRatType(p_CellId);
    var UTRAN_FDD_TDD_Type v_FDD_TDD_Mode := f_UTRAN_CellInfo_GetFDD_TDD(p_CellId);
    var UTRAN_FddTddMessageClass_Type v_TestCaseRelease := f_UTRAN_ConfigurationInfo_TestCaseRelease_Get();
    var SysinfoConfiguration_Type v_Configuration := f_UTRAN34_CellInfo_GetSysinfoConfiguration(p_CellId); // @sic EAB sic@
    
    if (v_FDD_TDD_Mode==UTRAN_FDD) {
      if ((v_TestCaseRelease == FDDr99) or (v_TestCaseRelease == FDDr5)) {
        // In Rel-99 and Rel-5 RACH TFS is not included in the extension of SIB5
        // @sic R5s140220 sic@
        v_Sib5.v4b0NonCriticalExtensions.v590NonCriticalExtensions.v650NonCriticalExtensions.v680NonCriticalExtensions.v690NonCriticalExtensions := omit;
        f_UTRAN_CellInfo_SetSIB5(p_CellId,  v_Sib5);
      }
    }
    select (v_Configuration) {
      case (configuration1) {
        f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, cs_SIB_MsgNoSegment, tsc_Now, v_RatType);
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB12(p_CellId, tsc_Now, 6, v_RatType); //@sic R5s140912 sic@
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      //Broadcast default Sysinfo + SIB19 acc to 34.108 cl 6.1.0a.2 Configuration 6
      case (configuration6) {
        if (v_FDD_TDD_Mode == UTRAN_TDD) {
          v_RatType := tdd128;
        }
        f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, cs_SIB_MsgNoSegment, tsc_Now, v_RatType);
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB12(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB19(p_CellId, tsc_Now, v_RatType);
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      case (configuration8) {  //@sic R5-150125 feFACH sic@
        f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, cs_SIB_MsgNoSegment, tsc_Now, v_RatType);
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN34_SendSIB5_LongSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB12_LongSIB5(p_CellId, tsc_Now, 6, v_RatType);
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      //Broadcast default Sysinfo + SIB21 acc to 34.108 cl 6.1.0a.2 Configuration 9
      case (configuration9) {
        if (v_FDD_TDD_Mode == UTRAN_TDD) {
          v_RatType := tdd128;
        }
        f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, cs_SIB_MsgNoSegment, tsc_Now, v_RatType);
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB12(p_CellId, tsc_Now, 6, v_RatType); //@sic R5s140912 sic@
        f_UTRAN34_SendSIB21(p_CellId, tsc_Now, v_RatType);
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      case (configuration10) {
        if (v_FDD_TDD_Mode == UTRAN_TDD) {
          v_RatType := tdd128;
        }
        f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, cs_SIB_MsgNoSegment, tsc_Now, v_RatType);
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB12(p_CellId, tsc_Now, 6, v_RatType);  //@sic R5s140912 sic@
        f_UTRAN34_SendSIB22(p_CellId, tsc_Now, v_RatType);
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      case (configuration11) {
        if (v_FDD_TDD_Mode == UTRAN_TDD) {
          v_RatType := tdd128;
        }
        f_UTRAN_SendSIB1_SIB2(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB5(p_CellId, v_CellSysInfo.SIB5_Type, tsc_Now, 6, v_RatType);
        f_UTRAN_SendSIB6(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB3_4_7_18(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendSIB11(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB12(p_CellId, tsc_Now, 6, v_RatType);
        f_UTRAN34_SendSIB23(p_CellId, tsc_Now, v_RatType);
        
        f_UTRAN_SendSB1(p_CellId, tsc_Now, v_RatType);
        f_UTRAN_SendMIB(p_CellId, tsc_Now, v_RatType);
      }
      case else {
        FatalError(__FILE__, __LINE__, "invalid sysinfo configuration");
      }
    }
  }

    /*
   * @desc      Sends SIB21 only - sysinformation configuration 9
   * @param     p_CellId
   * @param     p_Timing
   * @param     p_RatType
   * @status    APPROVED (IMS, SSNITZ, UTRAN)
   */
  function f_UTRAN34_SendSIB21( UTRAN_CellId_Type p_CellId,
                                integer           p_Timing,
                                RatType           p_RatType) runs on UTRAN_PTC
  { // @sic R5-144708 sic@
    var UTRAN_CellSysInfo_Type v_CellSysInfo := f_UTRAN_SysInfo_Get(p_CellId);
    var SegmentsOfSysInfoBlock v_Segments;
    var template (value) BCCH_BCH_Message v_BCCH_BCH_Message;
    
    v_Segments.seg1 := encvalue(v_CellSysInfo.SIB21);
    
    if (lengthof(v_Segments.seg1) == 226) {
      v_BCCH_BCH_Message := cs_SIB_MsgCmpl(extensionType, v_Segments.seg1);
    } else {
      v_BCCH_BCH_Message := cs_SIB_MsgCmplList1(extensionType, v_Segments.seg1);
    }
    f_UTRAN_BCCH_BCH_Msg_Schedule(p_CellId, 6, 27, v_BCCH_BCH_Message, p_Timing, p_RatType);
    v_CellSysInfo := f_UTRAN_SIB_ChangeValueTag(v_CellSysInfo, extensionType);
    v_CellSysInfo := fl_UTRAN_MIB_ChangeValueTag(v_CellSysInfo);
    f_UTRAN_SysInfo_Set(p_CellId, v_CellSysInfo);
  }

