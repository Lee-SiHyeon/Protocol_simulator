module EUTRA_NR_Parameters {

  import from Common4G5G all;

  modulepar ENDC_BandCombination_Type   px_ENDC_BandCombination     := DC_25A_n41A;     // @desc  EN-DC Band Combination

  modulepar ENDC_CA_BandCombination_Type px_ENDC_CA_BandCombination  := DC_1A_n28A_n78A;

  modulepar NEDC_BandCombination_Type   px_NEDC_BandCombination     := DC_n28A_3A;      // @desc  NE-DC Band Combination

  modulepar integer                     px_NR_PrimaryBand           := 1;               // @desc  NR primary band

  modulepar NTN_ScenarioUnderTest       px_NTN_ScenarioUnderTest    := GSO;             // @desc  NTN satellite scenario under test if UE supports NTN.

  modulepar boolean                     pc_5GCN                     := false;           // @desc  UE supports 5GS Core

  modulepar boolean                     pc_EN_DC                    := false;           // @desc  EN-DC (Option 3)

  modulepar boolean                     pc_EPS_UPIP                 := false;           // @desc  Support of user plane integrity protection with EPS

  modulepar boolean                     pc_EUTRA_mpspriorityindication_r16 := false;    // @desc  Support of mpsPriorityIndication on RRC release with redirect

  modulepar boolean                     pc_IP_Ping                  := false;           // @desc  Support of ICMP or ICMP IPv6

  modulepar boolean                     pc_InterBand_CA_BetweenFR1PCell_FR2SCell := false;

  modulepar boolean                     pc_InterBand_CA_WithinFR1   := false;           // @desc  Inter-Band CA within FR1

  modulepar boolean                     pc_InterBand_CA_WithinFR2   := false;           // @desc  Inter-Band CA within FR2

  modulepar boolean                     pc_InterBand_ENDC_IncludingFR1_FR2 := false;    // @desc  Inter-Band EN-DC including FR1 and FR2

  modulepar boolean                     pc_InterBand_ENDC_IncludingFR2 := false;        // @desc  Inter-Band EN-DC including FR2

  modulepar boolean                     pc_InterBand_ENDC_WithinFR1 := false;           // @desc  Inter-Band EN-DC within FR1

  modulepar boolean                     pc_InterBand_NRDC_BetweenFR1_FR2 := false;      // @desc  Inter-Band NR-DC between FR1 and FR2

  modulepar boolean                     pc_IntraBand_Contiguous_CA_WithinFR1 := false;  // @desc  Intra-Band Contiguous CA within FR1

  modulepar boolean                     pc_IntraBand_Contiguous_CA_WithinFR2 := false;  // @desc  Intra-Band Contiguous CA within FR2

  modulepar boolean                     pc_IntraBand_Contiguous_ENDC := false;          // @desc  Intra-Band Contiguous EN-DC

  modulepar boolean                     pc_IntraBand_NonContiguous_CA_WithinFR1 := false;

  modulepar boolean                     pc_IntraBand_NonContiguous_CA_WithinFR2 := false;

  modulepar boolean                     pc_IntraBand_NonContiguous_ENDC := false;       // @desc  Intra-Band Non-Contiguous EN-DC

  modulepar boolean                     pc_TransferEmergencyPDUN1toS1noN26 := false;    // @desc  Support of Emergency PDU session transfer from N1 mode to S1 mode when network does not support N26 interface

  modulepar boolean                     pc_TransferEmergencyPDUS1toN1noN26 := false;    // @desc  Support of Emergency PDN connection transfer from S1 mode to N1 mode when network does not support N26 interface

  modulepar boolean                     pc_configuredUL_GrantType1  := false;           // @desc  Support Type 1 PUSCH transmissions with configured grant

  modulepar boolean                     pc_configuredUL_GrantType2  := false;           // @desc  Support Type 2 PUSCH transmissions with configured grant

  modulepar boolean                     pc_csi_RS_CFRA_ForHO        := false;           // @desc  Support reconfiguration with sync using a contention free random access on PRACH resources that are associated with CSI-RS resources of the target cell

  modulepar boolean                     pc_data_centric             := false;           // @desc  Support of UE's usage setting as data centric

  modulepar boolean                     pc_dynamicPowerSharingENDC  := false;           // @desc  Support dynamic EN-DC power sharing for at least one EN-DC band combination_FR1 only

  modulepar boolean                     pc_dynamicSwitchRA_Type0_1_PDSCH := false;      // @desc  Support dynamic switching between resource allocation Types 0 and 1 for PDSCH

  modulepar boolean                     pc_dynamicSwitchRA_Type0_1_PUSCH := false;      // @desc  Support dynamic switching between resource allocation Types 0 and 1 for PUSCH

  modulepar boolean                     pc_eWLAN                    := false;           // @desc  WLAN

  modulepar boolean                     pc_eutra_EPC_HO_ToNR_FDD_FR1_r15 := false;      // @desc  Support inter-RAT Handover to NR FR1 FDD from EUTRA connected to EPC

  modulepar boolean                     pc_eutra_EPC_HO_ToNR_TDD_FR1_r15 := false;      // @desc  Support inter-RAT Handover to NR FR1 TDD from EUTRA connected to EPC

  modulepar boolean                     pc_eutra_EPC_HO_ToNR_TDD_FR2_r15 := false;      // @desc  Support inter-RAT Handover to NR FR2 TDD from EUTRA connected to EPC

  modulepar boolean                     pc_idleInactiveEUTRA_MeasReport := false;       // @desc  Support configuration of E-UTRA measurements in RRC_IDLE/RRC_INACTIVE and reporting of the corresponding results upon network request as specified in TS 38.331

  modulepar boolean                     pc_inactiveState            := false;           // @desc  Support of RRC_INACTIVE as specified in TS 38.331

  modulepar boolean                     pc_interRAT_NR_ToENDC       := false;           // @desc  Support inter-RAT Handover from NR to EN-DC

  modulepar boolean                     pc_maxNumberCSI_RS_BFD      := false;           // @desc  Support of CSI-RS based BFD

  modulepar boolean                     pc_maxNumberCSI_RS_SSB_CBD  := false;           // @desc  Support of SSB and/or CSI-RS based Link Recovery

  modulepar boolean                     pc_mtrpPuschCyclicMapping_r17 := false;         // @desc  Indicates whether UE supports cyclic mapping when the number of repetitions is larger than 2 with repetition type.

  modulepar boolean                     pc_ra_Type0_PUSCH           := false;           // @desc  Support resource allocation Type 0 for PUSCH

  modulepar boolean                     pc_srb3                     := false;           // @desc  Support direct SRB between the SN and the UE

  modulepar boolean                     pc_ss_SINR_Meas             := false;           // @desc  Support SS-SINR measurements

