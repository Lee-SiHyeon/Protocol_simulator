  template (value) UL_DPCH_Info cs_UL_DPCH_Info_FDDr99(SpreadingFactor   p_SprdFct,
                                                       PuncturingLimit   p_PuncLimit,
                                                       UL_ScramblingCode p_UL_ScramblingCode) :=
  { /* According to condition A3 in TS 34.108 clause 9.1.1: Uplink DPCH info */
    /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    ul_DPCH_PowerControlInfo := cs_UL_DPCH_PowerControlInfo_FDDr99,
    modeSpecificInfo := {
      fdd := {
        scramblingCodeType := longSC,
        scramblingCode := p_UL_ScramblingCode,
        numberOfDPDCH := omit,    // DEFAULT: 1
        spreadingFactor := p_SprdFct,
        tfci_Existence := true,
        numberOfFBI_Bits := omit,
        puncturingLimit := p_PuncLimit
      }
    }
  };

