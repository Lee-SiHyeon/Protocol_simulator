/*   const JSON.String_usi cu_lf := char(UA); // encoded as "\u000A" (Line feed)  */
/*   const JSON.String_usi cu_vt := char(UB); // encoded as "\u000B" (Vertical tab)  */
/*   const JSON.String_usi cu_ff := char(UC); // encoded as "\u000C" (Form feed)  */
