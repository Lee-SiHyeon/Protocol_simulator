module MCX_XML_mcvideo_info {

  import from CommonDefs all;
  import from IMS_Component all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_Component all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcvideoInfo_1_0 language "XSD" all;

  type urn_3gpp_ns_mcvideoInfo_1_0.Mcvideoinfo_Type MCVideo_Info_Type;          /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcvideoInfo_1_0.ContentType MCVideo_Info_Content_Type;       /* @status    APPROVED (MCX) */

  const CharStringList_Type tsc_MCVideo_Info_EncryptedElements := {             /* @status    APPROVED (MCX) */
    /* 24.281 F.1.3: <mcvideoinfo><mcvideo-Params> elements which may be ecrypted */
    "mcvideo-access-token",
    "mcvideo-request-uri",
    "mcvideo-calling-user-id",
    "mcvideo-called-party-id",
    "mcvideo-calling-group-id",
    "emergency-ind",
    "alert-ind",
    "imminentperil-ind",
    "originated-by",
    "mcvideo-client-id"
  };

  type union McvideoInfoExt_Element_Type {                                      /* @status    APPROVED (MCX) */
    ReleaseReasonType ReleaseReason,
    RequestTypeType RequestType,
    ResponseTypeType ResponseType,
    SelectedGroupChangeOutcomeType SelectedGroupChangeOutcome,
    XSD.Boolean AffiliationRequired,
    AmbientViewingType AmbientViewing,
    XSD.AnyURI VideoPushUrl
  };

  type record of McvideoInfoExt_Element_Type McvideoInfoExt_ElementList_Type;   /* @status    APPROVED (MCX) */

  /*
   * @desc      decode extension of mcvideo-info
   * @param     p_McvideoInfoExt
   * @return    McvideoInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_McvideoInfoExt_Decode(template (omit) AnyExtType p_McvideoInfoExt) runs on IMS_PTC return McvideoInfoExt_ElementList_Type
  {
    // variables for decoding
    var Release_reason v_Release_reason;
    var Request_type v_Request_type;
    var Response_type v_Response_type;
    var Selected_group_change_outcome v_Selected_group_change_outcome;
    var Affiliation_required v_Affiliation_required;
    var Ambient_viewing_type v_Ambient_viewing_type;
    var Video_push_url v_Video_push_url;

    // other variables
    var AnyExtType v_McvideoInfoExt;
    var McvideoInfoExt_ElementList_Type v_McvideoInfoExtElementList := {};
    var McvideoInfoExt_Element_Type v_Element;
    var bitstring v_Bitstring;
    var integer i;

    if (isvalue(p_McvideoInfoExt)) {
      v_McvideoInfoExt := valueof(p_McvideoInfoExt);
      for (i := 0; i < lengthof(v_McvideoInfoExt.elem_list); i := i + 1) {
        v_Bitstring := f_Unichar2Bit(v_McvideoInfoExt.elem_list[i]);
        
        if (decvalue(v_Bitstring, v_Release_reason) == 0) {
          v_Element.ReleaseReason := v_Release_reason;
        }
        else if (decvalue(v_Bitstring, v_Request_type) == 0) {
          v_Element.RequestType := v_Request_type;
        }
        else if (decvalue(v_Bitstring, v_Response_type) == 0) {
          v_Element.ResponseType := v_Response_type;
        }
        else if (decvalue(v_Bitstring, v_Selected_group_change_outcome) == 0) {
          v_Element.SelectedGroupChangeOutcome := v_Selected_group_change_outcome;
        }
        else if (decvalue(v_Bitstring, v_Affiliation_required) == 0) {
          v_Element.AffiliationRequired := v_Affiliation_required;
        }
        else if (decvalue(v_Bitstring, v_Ambient_viewing_type) == 0) {
          v_Element.AmbientViewing := v_Ambient_viewing_type;
        }
        else if (decvalue(v_Bitstring, v_Video_push_url) == 0) {
          v_Element.VideoPushUrl := v_Video_push_url;
        }
        else {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcvideoinfo.mcvideo-Params.anyExt: element[" & int2str(i) & "] cannot be decoded");
        }
        v_McvideoInfoExtElementList := v_McvideoInfoExtElementList & { v_Element };
      }
    }
    return v_McvideoInfoExtElementList;
  }

  /*
   * @desc      Decode mcvideo-Params extensions and raise verdict
   * @param     p_McvideoInfo
   * @param     p_McvideoInfoExtElementList
   * @return    McvideoInfoExt_ElementList_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_McvideoInfoExt_DecodeAndMatch(MCVideo_Info_Type p_McvideoInfo,
                                               template McvideoInfoExt_ElementList_Type p_McvideoInfoExtElementList) runs on IMS_PTC return McvideoInfoExt_ElementList_Type
  {
    var McvideoInfoExt_ElementList_Type v_McvideoInfoExtElementList := fl_MCX_McvideoInfoExt_Decode(p_McvideoInfo.mcvideo_Params.anyExt);   // even in case of anyExt==omit fl_MCX_McvideoInfoExt_Decode returns an (empty) list
    var template (present) McvideoInfoExt_ElementList_Type v_ExpectedElementList := {};                                                     // @sic R5-233849: {} instead of ? sic@

    if (ispresent(p_McvideoInfoExtElementList)) {
      v_ExpectedElementList := { permutation(all from  p_McvideoInfoExtElementList) };
    }
    if (not match(v_McvideoInfoExtElementList, v_ExpectedElementList)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "mcvideoinfo.mcvideo-Params.anyExt does not match");
    }
    return v_McvideoInfoExtElementList;
  }

  template (value) urn_3gpp_ns_mcvideoInfo_1_0.ContentType.choice cs_MCVideo_Info_Content_Choice_Boolean(XSD.Boolean p_Boolean) := { mcvideoBoolean := p_Boolean };     /* @status    APPROVED (MCX) */

  template (value) urn_3gpp_ns_mcvideoInfo_1_0.ContentType.choice cs_MCVideo_Info_Content_Choice_URI(XSD.AnyURI p_URI) := { mcvideoURI := p_URI };                      /* @status    APPROVED (MCX) */

  /*
   * @desc      Wrapper funnction to set ProtectionType depending on tsc_MCX_XML_ConfidentialityProtection
   * @return    ProtectionType
   * @status    APPROVED (MCX)
   */
  function fl_MCVideo_Info_ProtectionTypeTX() return ProtectionType
  {
    var ProtectionType v_ProtectionType := normal;
    if (tsc_MCX_XML_ConfidentialityProtection) {
      v_ProtectionType := encrypted;
    }
    return v_ProtectionType;
  }

  template (value) ContentType cs_MCVideo_Content(template (value) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := fl_MCVideo_Info_ProtectionTypeTX(),
    attr := omit,
    choice := p_Choice
  };

  template (value) ContentType cs_MCVideo_Content_Boolean(XSD.Boolean p_Boolean) := cs_MCVideo_Content(cs_MCVideo_Info_Content_Choice_Boolean(p_Boolean));      /* @status    APPROVED (MCX) */

  /*
   * @desc      return ContentType element with URI
   * @param     p_URI
   * @return    template (omit) ContentType
   * @status    APPROVED (MCX)
   */
  function f_MCVideo_Content_URI(template (omit) XSD.AnyURI p_URI) return template (omit) ContentType
  {
    if (isvalue(p_URI)) {
      return cs_MCVideo_Content(cs_MCVideo_Info_Content_Choice_URI(valueof(p_URI)));
    }
    return omit;
  }

  template (value) ContentType cs_MCVideo_Content_True := cs_MCVideo_Content_Boolean(true);                             /* @status    APPROVED (MCX) */

  template (value) ContentType cs_MCVideo_Content_False := cs_MCVideo_Content_Boolean(false);                           /* @status    APPROVED (MCX) */

  template (value) MCVideo_Info_Type cs_MCVideo_Info_Base(template (omit) charstring p_McvideoRequestURI := px_MCVideo_ID_User_A,
                                                          template (omit) charstring p_McvideoCallingUserId := px_MCVideo_ID_User_B) :=
  { /* MCVideo info according to 36.579-1 Table 5.5.3.2.2-2 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcvideo_Params := {
      attr := omit,
      mcvideo_access_token     := omit,
      session_type             := omit,
      mcvideo_request_uri      := f_MCVideo_Content_URI(p_McvideoRequestURI),
      mcvideo_calling_user_id  := f_MCVideo_Content_URI(p_McvideoCallingUserId),
      mcvideo_called_party_id  := omit,
      mcvideo_calling_group_id := omit,
      required                 := omit,
      emergency_ind            := omit,
      alert_ind                := omit,
      imminentperil_ind        := omit,
      broadcast_ind            := omit,
      mc_org                   := omit,
      associated_group_id      := omit,
      originated_by            := omit,
      mKFC_GKTPs               := omit,
      mcvideo_client_id        := omit,
      alert_ind_rcvd           := omit,
      multiple_devices_ind     := omit,
      video_pull_url           := omit,
      gw_mcvideo_usage         := omit,                         // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list                := {},
      anyExt                   := omit
    },
    elem_list := {},
    anyExt := omit
  };

  /*
   * @desc      Table 5.5.3.2.2-1: MCVideo-Info from the SS with conditions GROUP-CALL or PRIVATE-CALL
   * @param     p_CallType          (default value: ANY)
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_McvideoRequestURI   (default value: px_MCVideo_ID_User_A)
   * @param     p_McvideoCallingUserId (default value: px_MCVideo_ID_User_B)
   * @return    template (value) MCVideo_Info_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CallControl_MCVideoInfo_TX(MCX_CallType_Type p_CallType := ANY,
                                            MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                            template (omit) charstring p_McvideoRequestURI := px_MCVideo_ID_User_A,
                                            template (omit) charstring p_McvideoCallingUserId := px_MCVideo_ID_User_B) return template (value) MCVideo_Info_Type
  { // p_CallType := ANY => per default there is no session-type

    var template (value) MCVideo_Info_Type v_McvideoInfo := cs_MCVideo_Info_Base(p_McvideoRequestURI, p_McvideoCallingUserId);

    v_McvideoInfo.mcvideo_Params.session_type := f_MCX_MCServiceInfo_SessionType(p_CallType);

    select (p_CallType) {
      case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
        v_McvideoInfo.mcvideo_Params.mcvideo_calling_group_id := f_MCVideo_Content_URI(px_MCVideo_Group_A_ID);
      }
    }
    select (p_PriorityCallType) {
      case (EMERGENCY_CALL) {
        v_McvideoInfo.mcvideo_Params.emergency_ind := cs_MCVideo_Content_True;
        v_McvideoInfo.mcvideo_Params.alert_ind := cs_MCVideo_Content_False;
      }
      case (IMMPERIL_CALL) {
        v_McvideoInfo.mcvideo_Params.imminentperil_ind := cs_MCVideo_Content_True;
      }
      case (BROADCAST) {
        v_McvideoInfo.mcvideo_Params.broadcast_ind := true;
      }
    }
    return v_McvideoInfo;
  }

  template (present) ContentType.choice cr_MCVideo_Info_Content_Choice_Boolean(template (present) XSD.Boolean p_Boolean) := { mcvideoBoolean := p_Boolean };                        /* @status    APPROVED (MCX) */

  template (present) ContentType.choice cr_MCVideo_Info_Content_Choice_String(template (present) XSD.String p_String) := { mcvideoString := p_String };                             /* @status    APPROVED (MCX) */

  template (present) ContentType.choice cr_MCVideo_Info_Content_Choice_URI(template (present) XSD.AnyURI p_URI) := { mcvideoURI := p_URI };                                         /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCVideo_Content_True := cr_MCVideo_Content_Boolean(true);                           /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCVideo_Content(template urn_3gpp_ns_mcvideoInfo_1_0.ProtectionType p_Protection := *,
                                                    template (present) ContentType.choice p_Choice) :=
  { /* @status    APPROVED (MCX) */
    type_ := p_Protection,
    attr := omit,
    choice := p_Choice
  };

  template (present) ContentType cr_MCVideo_Content_Boolean(template (present) XSD.Boolean p_Boolean) := cr_MCVideo_Content(-, cr_MCVideo_Info_Content_Choice_Boolean(p_Boolean));  /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCVideo_Content_String(template (present) XSD.String p_String) := cr_MCVideo_Content(-, cr_MCVideo_Info_Content_Choice_String(p_String));       /* @status    APPROVED (MCX) */

  template (present) ContentType cr_MCVideo_Content_URI(template (present) XSD.AnyURI p_URI) := cr_MCVideo_Content(-, cr_MCVideo_Info_Content_Choice_URI(p_URI));                   /* @status    APPROVED (MCX) */

  template ContentType cr_MCVideo_Content_FalseIfPresent := cr_MCVideo_Content_Boolean(false) ifpresent;                /* @status    APPROVED (MCX) */

  template (present) MCVideo_Info_Type cr_MCVideo_Info_Base :=
  { /* MCVideo info according to 36.579-1 Table 5.5.3.2.1-1 */
    /* @status    APPROVED (MCX) */
    attr := omit,
    mcvideo_Params := {
      attr := omit,
      mcvideo_access_token     := omit,
      session_type             := omit,
      mcvideo_request_uri      := omit,
      mcvideo_calling_user_id  := omit,
      mcvideo_called_party_id  := omit,
      mcvideo_calling_group_id := omit,
      required                 := omit,
      emergency_ind            := cr_MCVideo_Content_FalseIfPresent,
      alert_ind                := cr_MCVideo_Content_FalseIfPresent,
      imminentperil_ind        := cr_MCVideo_Content_FalseIfPresent,
      broadcast_ind            := false ifpresent,
      mc_org                   := omit,
      associated_group_id      := omit,
      originated_by            := omit,
      mKFC_GKTPs               := omit,
      mcvideo_client_id        := omit,
      alert_ind_rcvd           := omit,
      multiple_devices_ind     := omit,
      video_pull_url           := omit,
      gw_mcvideo_usage         := omit,                         // @sic R5s240535 BASELINE MOVING Rel-18 2024 sic@
      elem_list                := {},
      anyExt                   := *
    },
    elem_list := {},
    anyExt := *
  };

  /*
   * @desc      Table 5.5.3.2.1-2: MCVideo-Info from the UE with conditions GROUP-CALL, CHAT-GROUP-CALL or PRIVATE-CALL
   * @param     p_CallType
   * @param     p_Condition         (default value: NONE)
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_AssociatedGroupId (default value: omit)
   * @return    template (present) MCVideo_Info_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CallControl_MCVideoInfo_RX(MCX_CallType_Type p_CallType,
                                            MCX_MCServiceInfoRX_Condition_Type p_Condition := NONE,
                                            MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                            template (omit) charstring p_AssociatedGroupId := omit) runs on MCX_IMS_PTC return template (present) MCVideo_Info_Type
  {
    var template (present) MCVideo_Info_Type v_McvideoInfo := cr_MCVideo_Info_Base;
    var charstring v_UUID_URN := f_MCX_IMS_PTC_ClientId_GetValue();
    var template MCVideo_Info_Content_Type v_RequestURI := omit;
    var template MCVideo_Info_Content_Type v_ClientId := cr_MCVideo_Content_String(v_UUID_URN);

    select (p_CallType) {
      case (GROUP_CALL, GROUP_REJOIN, CHAT_GROUP_CALL) {
        v_RequestURI := cr_MCVideo_Content_URI(px_MCVideo_Group_A_ID);
      }
      case (PRIVATE_CALL) {
        v_RequestURI := cr_MCVideo_Content_URI(px_MCVideo_ID_User_B) ifpresent;
      }
    }

    v_McvideoInfo.mcvideo_Params.mcvideo_calling_user_id := cr_MCVideo_Content_URI(px_MCVideo_ID_User_A) ifpresent;
    v_McvideoInfo.mcvideo_Params.associated_group_id := p_AssociatedGroupId;

    select (p_Condition) {
      case (INVITE_REFER) {
        v_McvideoInfo.mcvideo_Params.session_type := f_MCX_MCServiceInfo_SessionType(p_CallType);
        v_McvideoInfo.mcvideo_Params.mcvideo_request_uri := v_RequestURI;
        select (p_PriorityCallType) {
          case (EMERGENCY_CALL) {
            v_McvideoInfo.mcvideo_Params.emergency_ind := cr_MCVideo_Content_True;
            v_McvideoInfo.mcvideo_Params.alert_ind := cr_MCVideo_Content_Boolean(pc_MCX_EmergencyIndWithAlertInd);           // @sic R5-222396: pc_MCX_EmergencyIndWithAlertInd sic@
          }
          case (IMMPERIL_CALL) {
            v_McvideoInfo.mcvideo_Params.imminentperil_ind := cr_MCVideo_Content_True;
          }
          case (BROADCAST) {
            v_McvideoInfo.mcvideo_Params.broadcast_ind := true;
          }
          case else {      // NORMAL_CALL
            select (p_CallType) {
              case (PRIVATE_CALL) {
                v_ClientId := v_ClientId ifpresent;   // <mcvideo-client-id> optional
              }
            }
          }
        }
        v_McvideoInfo.mcvideo_Params.mcvideo_client_id := v_ClientId;
      }
      case (INVITE_RSP) {
        v_McvideoInfo.mcvideo_Params.mcvideo_called_party_id := cr_MCVideo_Content_URI(px_MCVideo_ID_User_A) ifpresent;
      }
    }

    return v_McvideoInfo;
  }

  /*
   * @desc      Encode Mcvideoinfo
   * @param     p_Mcvideoinfo
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCVideoInfo_Encode(template (value) Mcvideoinfo p_Mcvideoinfo) return XmlBody_Type
  {
    var bitstring v_EncodedMcvideoinfo := encvalue(p_Mcvideoinfo);
    return f_Bit2XmlBody(v_EncodedMcvideoinfo);
  }

  /*
   * @desc      Encode and encrypt Mcvideoinfo
   * @param     p_MCVideo_Info
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCVideoInfo_EncodeEncrypt(template (value) Mcvideoinfo_Type p_MCVideo_Info,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var universal charstring v_XmlDocument := f_MCX_MCVideoInfo_Encode(p_MCVideo_Info);
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK)) {
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);
    }
    for (i := 0; i < lengthof(tsc_MCVideo_Info_EncryptedElements); i := i + 1) {
      v_XmlPath := "//mcvideoinfo/mcvideo-Params/" & tsc_MCVideo_Info_EncryptedElements[i];
      f_XML_Document_EncryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, p_CSK);  // v_XmlDocument: inout parameter
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

  /*
   * @desc      Decode MCVideo Info
   * @param     charstring
   * @return    Mcvideoinfo_Type
   * @status    APPROVED (MCX)
   */
  function fl_MCX_MCVideoInfo_Decode(universal charstring p_XmlDocument) return Mcvideoinfo_Type
  {
    var bitstring v_Bitstring := f_Unichar2Bit(p_XmlDocument);
    var Mcvideoinfo v_Mcvideoinfo;

    if (decvalue(v_Bitstring, v_Mcvideoinfo) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCVideo-Info");
    }
    return v_Mcvideoinfo;
  }

  /*
   * @desc      Decrypt and decode MCVideo Info
   * @param     p_XmlDocument
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    Mcvideoinfo_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCVideoInfo_DecryptDecode(XmlBody_Type p_XmlDocument,
                                           charstring p_MCServiceID,
                                           template (omit) MCX_SecurityKey_Type p_CSK) runs on IMS_PTC return Mcvideoinfo_Type
  {
    var universal charstring v_XmlDocument := p_XmlDocument;
    var XML_Document_DecryptElementContent_Result_Type v_DecryptResult;
    var charstring v_ElementName;
    var charstring v_XmlPath;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_ConfidentialityProtection) {
      for (i := 0; i < lengthof(tsc_MCVideo_Info_EncryptedElements); i := i + 1) {
        v_ElementName := tsc_MCVideo_Info_EncryptedElements[i];
        v_XmlPath := "//mcvideoinfo/mcvideo-Params/" & v_ElementName;
        v_DecryptResult := f_XML_Document_DecryptElementContent(v_XmlDocument, v_XmlPath, p_MCServiceID, valueof(p_CSK));  // v_XmlDocument: inout parameter
        if (v_DecryptResult == NOT_ENCRYPTED) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, v_ElementName & " is not encrypted");
        }
      }
      fx_XML_Log(__FILE__, __LINE__, UPLINK, v_XmlDocument);
    }

    return fl_MCX_MCVideoInfo_Decode(v_XmlDocument);
  }

}
