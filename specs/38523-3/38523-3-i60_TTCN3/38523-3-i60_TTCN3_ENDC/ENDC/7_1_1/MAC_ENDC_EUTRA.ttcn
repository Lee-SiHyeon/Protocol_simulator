module MAC_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_LoopBack all;
  import from Common4G5G_Templates all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA38_Handover all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_NR_Parameters all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SRB_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {

    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TESTMode_OFF, -, -);
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    //@sic R5-195336 sic@
     //@siclog "Steps 1& 6" siclog@
    // Update SgNB Keys for new SK Counter value
    f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(NR, 1);
    f_EUTRA38_RRC_PSCellChange_InterCell (eutra_Cell1, omit, false); //@sic R5s190934 R5s230301 sic@

    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.1a.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_1_1a_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
     var template (omit) octetstring v_NR_SCGConfig := omit;
     f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TESTMode_OFF, -, -);
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
     //@siclog "Steps 0A-0B" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble (eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_1_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
      //Random access procedure / Successful / C-RNTI Based / Preamble selected by MAC itself
     var template (omit) octetstring v_NR_SCGConfig := omit;
     var template (omit) RRCConnectionReconfiguration_v890_IEs v_RRCConnectionReconfiguration_v890_IEs := omit;
     f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON); //@sic R5s201316 sic@
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
     //@siclog "Steps 0A-0B" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);


    //@siclog "Steps 17A-17B" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    v_RRCConnectionReconfiguration_v890_IEs := f_EUTRA38_508_BuildRRCConnReconfig_NR_Config_Setup (v_NR_SCGConfig);

    SRB.send(cas_SRB1_RrcNasPduList_REQ(eutra_Cell1,
                                        cs_TimingInfo_Now,
                                        cs_RRCConnectionReconfiguration_Common(tsc_RRC_TI_Def,
                                                                               -,
                                                                               -,
                                                                               f_EUTRA38_BuildEUTRA_RadioResourceConfigDedicated(eutra_Cell1, MCG_SCG, RRC_CONNECTED),
                                                                               omit,
                                                                               v_RRCConnectionReconfiguration_v890_IEs),
                                        omit));
      f_EUTRA38_ENDC_ReceiveRrcAndNasMsg(eutra_Cell1, 0, cr_RRCConnectionReconfigurationComplete_r15, omit);

    
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.2.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_2_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    var EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_NR_SysInfo;
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_1DRB(0, tsc_DRB2));
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    //Acquire information of NR cell (Cell1)
    v_EUTRA_NR_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(NR);
    if ( not (v_EUTRA_NR_SysInfo.NR[0].IsFDD) )
    {
        //@siclog "Steps 19-20" siclog@
   
        v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

          f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
         f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    };
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.2.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_2_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    //Correct Handling of DL HARQ process PDSCH Aggregation
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    //@sic R5s221033 sic@
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_1DRB(0, tsc_DRB2));
    
    f_EUTRA_TestBody_Set(true);

    fl_TC_7_1_1_2_2_ENDC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s221033 R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_7_1_1_2_2_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_7_1_1_2_2_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  {
    //Correct Handling of DL HARQ process PDSCH Aggregation
    var template (omit) octetstring v_NR_SCGConfig := omit;

    // Send trigger to NR to start step 1-2
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger);
  
    //@siclog "Steps 1 & 2" siclog@
    // Wait for RRC Reconfiguration message to be handed over in step 3 from NR PTC and then handle it
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1, -, -, v_NR_SCGConfig);

    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    var EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_NR_SysInfo;
    // Correct Handling of UL MAC PDU / Assignment / HARQ process
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);

    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON);
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
   //Acquire information of NR cell (Cell1)
    v_EUTRA_NR_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(NR);
    if ( not (v_EUTRA_NR_SysInfo.NR[0].IsFDD) )
    {
        //@siclog "Steps 20-21" siclog@
   
        v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

        f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
        f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    }
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    //@sic R5-204475 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

