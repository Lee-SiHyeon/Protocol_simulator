/******************************************************************************/

module NR_ASP_DrbDefs {
  //****************************************************************************
  // ASP interface for DRBs
  //****************************************************************************

  import from CommonDefs all;
  import from NR_CommonDefs all;
  import from NR_PDCP_TypeDefs all;
  import from SDAP_TypeDefs all;

  group PDU_TypeDefs {

  group MAC_PDU {

  //****************************************************************************
  // MAC PDU definitions
  //----------------------------------------------------------------------------

  type record NR_MAC_PDU_DL_Type {
    NR_MAC_CE_SubPDU_DL_List_Type       CE_SubPDUList         optional, /* list of subPDUs with MAC CE */
    NR_MAC_SDU_SubPDU_List_Type         SDU_SubPDUList        optional, /* list of subPDUs with MAC SDU */
    NR_MAC_Padding_SubPDU_Type          Padding_SubPDU        optional  /* subPDU with padding */
  };

  type record NR_MAC_PDU_UL_Type {
    NR_MAC_SDU_SubPDU_List_Type         SDU_SubPDUList        optional, /* list of subPDUs with MAC SDU */
    NR_MAC_CE_SubPDU_UL_List_Type       CE_SubPDUList         optional, /* list of subPDUs with MAC CE */
    NR_MAC_Padding_SubPDU_Type          Padding_SubPDU        optional  /* subPDU with padding */
  };

  type union NR_MAC_PDU_Type {
    NR_MAC_PDU_DL_Type DL,
    NR_MAC_PDU_UL_Type UL
  };

  type record of NR_MAC_PDU_Type NR_MAC_PDUList_Type;

  group MAC_PDU_SubPDU {                                                /* MAC subPDU (TS 38.321 clause 6.1.2) */

  type bitstring B8_16_Type length(8..16);                              /* NOTE: length restriction can only be a range but not two distinct lengths */
  type octetstring NR_MAC_SDU_Type;

  type record NR_MAC_PDU_SubHeader_Type {                               /* MAC PDU SubHeader (TS 38.321 clause 6.1.2) */
    B1_Type             Reserved_or_LX,                                 /* Reserved bit or LX bit
                                                                           The LCID extension field indicates the use of extended LCID space. The LX field set to 1 indicates the use of 38.321 Table 6.2.1-2c, otherwise R bit is present instead (i.e. set to 0)
                                                                         */
    B1_Type             Format,                                         /* F:
                                                                         * The Format field indicates the size of the Length field according to TS 38.321 clause 6.2.1: value 0 => 8 bits, value 1 => 16 bits.
                                                                         * In case of MAC subheader for fixed sized MAC CE or padding (R/LCID MAC subheader) this field is reserved (i.e. treated as another R field) */
    B6_Type             LCID,                                           /* LCID:
                                                                           Logical Channel ID field according to TS 38.321 Tables 6.2.1-1 and 6.2.1-2 */
    B8_16_Type          ELCID  optional,                                /* eLCID:
                                                                           The extended Logical Channel ID field according to TS 38.321 Tables 6.2.1-1a, 6.2.1-1b, 6.2.1-2a and 6.2.1-2b for the DL-SCH and UL-SCH respectively.
                                                                           The size of the eLCID field is either 8 bits or 16 bits.
                                                                         */
    B8_16_Type          Length optional                                 /* Either omit (fixed-sized MAC CE) or 8 bits (F=0) or 16 bits (F=1) */
  };

  type record NR_MAC_CE_SubPDU_DL_Type {                                /* MAC DL subPPU with MAC subheader only (in case of MAC CE with fixed size of zero bits) or MAC subheader + MAC CE */
    NR_MAC_PDU_SubHeader_Type           SubHeader,
    NR_MAC_ControlElementDL_Type        ControlElement        optional  /* omit if MAC CE has fixed size of zero bits */
  };

  type set of NR_MAC_CE_SubPDU_DL_Type NR_MAC_CE_SubPDU_DL_List_Type;

  type record NR_MAC_CE_SubPDU_UL_Type {                                /* MAC UL subPPU with MAC subheader only (in case of MAC CE with fixed size of zero bits) or MAC subheader + MAC CE */
    NR_MAC_PDU_SubHeader_Type           SubHeader,
    NR_MAC_ControlElementUL_Type        ControlElement        optional  /* omit if MAC CE has fixed size of zero bits */
  };

  type set of NR_MAC_CE_SubPDU_UL_Type NR_MAC_CE_SubPDU_UL_List_Type;

  type record NR_MAC_SDU_SubPDU_Type {                                  /* MAC subPPU with MAC subheader + MAC SDU */
    NR_MAC_PDU_SubHeader_Type           SubHeader,
    NR_MAC_SDU_Type                     SDU
  };

  type set of NR_MAC_SDU_SubPDU_Type NR_MAC_SDU_SubPDU_List_Type;

  type record NR_MAC_Padding_SubPDU_Type {                              /* MAC subPPU with MAC subheader + Padding */
    NR_MAC_PDU_SubHeader_Type           SubHeader,
    octetstring                         Padding                         /* 0 or more octets padding */
  };

  } // End sub-sub-group MAC_PDU_SubHeader

  group MAC_ControlElements {                                   /* MAC Control Elements (CEs) (TS 38.321 clause 6.1.3) */

  type union NR_MAC_ControlElementDL_Type {                     /* TimingInfo : 'Now' or specific activation time */
    NR_MAC_CE_ContentionResolutionId_Type       ContentionResolutionID,         /* TS 38.321 clause 6.1.3.3 */
    NR_MAC_CE_TimingAdvance_Type                TimingAdvance,                  /* TS 38.321 clause 6.1.3.4 */
    // DRX command MAC CE has a fixed size of zero bits
    // Long DRX command MAC CE has a fixed size of zero bits
    NR_MAC_CE_SCellActDeact_Type                SCellActDeact,                  /* TS 38.321 clause 6.1.3.10 */
    NR_MAC_CE_DuplicationActDeact_Type          DuplicationActDeact,            /* TS 38.321 clause 6.1.3.11 */
    NR_MAC_CE_SP_ResourceSetActDeact_Type       SP_ResourceSetActDeact,         /* TS 38.321 clause 6.1.3.12 */
    NR_MAC_CE_CSI_TriggerStateSubselection_Type CSI_TriggerStateSubselection,   /* TS 38.321 clause 6.1.3.13 */
    NR_MAC_CE_TCI_StatesActDeact_Type           TCI_StatesActDeact,             /* TS 38.321 clause 6.1.3.14 */
    NR_MAC_CE_TCI_StateIndication_Type          TCI_StateIndication,            /* TS 38.321 clause 6.1.3.15 */
    NR_MAC_CE_SP_CSI_ReportingActDeact_Type     SP_CSI_ReportingActDeact,       /* TS 38.321 clause 6.1.3.16 */
    NR_MAC_CE_SP_SRS_ActDeact_Type              SP_SRS_ActDeact,                /* TS 38.321 clause 6.1.3.17 */
    NR_MAC_CE_PUCCH_SpatialRelationActDeact_Type PUCCH_SpatialRelationActDeact, /* TS 38.321 clause 6.1.3.18 */
    NR_MAC_CE_SP_ZP_ResourceSetActDeact_Type    SP_ZP_ResourceSetActDeact,      /* TS 38.321 clause 6.1.3.19 */
    NR_MAC_CE_RecommendedBitrate_Type           RecommendatdBitrate,            /* TS 38.321 clause 6.1.3.20 */
    NR_MAC_CE_RLC_DuplicationActDeact_Type      RlcDuplicationActDeact,         /* TS 38.321 clause 6.1.3.32 */
    //POS MAC CE
    NR_MAC_CE_POS_MeasGapActDeact_Type          PosMeasGapActDeactCmd,          /* TS 38.321 clause 6.1.3.41 */
    NR_MAC_CE_PPWActDeactCmd_Type               PPWActDeactCmd,                 /* TS 38.321 clause 6.1.3.42 */
    NR_MAC_CE_DifferentialKoffset_Type          DifferentialKoffset,            /* TS 38.321 clause 6.1.3.57 */
    NR_MAC_CE_LTM_CellSwitch_Type               LTM_CellSwitch,                 /* TS 38.321 clause 6.1.3.75 */
    NR_MAC_CE_CandCellTCI_ActDeact_Type         CandCellTCI_ActDeact,           /* TS 38.321 clause 6.1.3.76 */
    NR_MAC_CE_EnhancedSP_CSI_ReportActDeac_Type EnhancedSP_CSI_ReportActDeact     /* TS 38.321 clause 6.1.3.80 */
  };

  type union NR_MAC_ControlElementUL_Type {
    NR_MAC_CE_ShortBSR_Type                     ShortBSR,                        /* TS 38.321 clause 6.1.3.1 */
    NR_MAC_CE_LongBSR_Type                      LongBSR,                         /* TS 38.321 clause 6.1.3.1 */
    RNTI_B16_Type                               C_RNTI,                          /* TS 38.321 clause 6.1.3.2 */
    NR_MAC_CE_SingleEntryPHR_Type               SingleEntryPHR,                  /* TS 38.321 clause 6.1.3.8 */
    NR_MAC_CE_MultiEntryPHR_Type                MultiEntryPHR,                   /* TS 38.321 clause 6.1.3.9 */
    // Configured Grant Confirmation MAC CE has a fixed size of zero bits
    NR_MAC_CE_RecommendedBitrate_Type           RecommendedBitrate,              /* TS 38.321 clause 6.1.3.20 */
    NR_MAC_CE_SL_BSR_List_Type                  SL_BSR,                          /* TS 38.321 clause 6.1.3.33 */
    O1_Type                                     SL_CG_Confirmation,              /* TS 38.321 clause 6.1.3.34 */
    NR_MAC_CE_POS_MeasGapActDeact_Type          PosMeasGapActDeactReq,           /* TS 38.321 clause 6.1.3.40 */
    NR_MAC_CE_LBT_Failure_Type                  LBT_Failure,                     /* TS 38.321 clause 6.1.3.30 */
    NR_MAC_CE_TimingAdvanceReport_Type          TimingAdvance,                   /* TS 38.321 clause 6.1.3.56 */
    NR_MAC_CE_EnhSingleEntryPHRMultiTRP_Type    EnhSingleEntryPHRMultiTRP,       /* TS 38.321 clause 6.1.3.50 */
    NR_MAC_CE_EnhMultiEntryPHRMultiTRP_Type     EnhMultiEntryPHRMultiTRP,        /* TS 38.321 clause 6.1.3.51 */
    NR_MAC_CE_SingleEntryPHRAssumedPUSCH_Type   SingleEntryPHRAssumedPUSCH,      /* TS 38.321 clause 6.1.3.78 */
    NR_MAC_CE_MultiEntryPHRAssumedPUSCH_Type    MultiEntryPHRAssumedPUSCH,       /* TS 38.321 clause 6.1.3.79 */
    NR_MAC_CE_DSR_Type                          DSR,                             /* TS 38.321 clause 6.1.3.72 */
    NR_MAC_CE_RefinedLongBSR_Type               RefinedLongBSR,                  /* TS 38.321 clause 6.1.3.1 */
    NR_MAC_CE_SL_CSI_Reporting_Type             SL_CSI_Reporting                 /* TS 38.321 clause 6.1.3.35 */
  };

  group MAC_ControlElement_Common {

  type record NR_MAC_CE_SCellFlags_Type {                       /* bitmap to indicate presence of SCell with SCellIndex according to TS 38.331
                                                                   either SCellIndex7_1 is present only or all octets are present*/
    B8_Type     SCellIndex7_1,                                  /* leftmost bit corresponds to SCellIndex7, 2nd bit from the right corresponds to SCellIndex1, rightmost bit is reserved */
    B8_Type     SCellIndex15_8 optional,                        /* leftmost bit corresponds to SCellIndex15, rightmost bit corresponds to SCellIndex8 */
    B8_Type     SCellIndex23_16 optional,                       /* leftmost bit corresponds to SCellIndex23, rightmost bit corresponds to SCellIndex16 */
    B8_Type     SCellIndex31_24 optional                        /* leftmost bit corresponds to SCellIndex31, rightmost bit corresponds to SCellIndex24 */
  };

  type record NR_MAC_CE_ServCellId_BwpId_Type {                 /* Common definition for first octet of CEs defined in TS 38.321 clause 6.1.3.12 .. TS 38.321 clause 6.1.3.19 */
    B1_Type     Field1,                                         /* A/D field for NR_MAC_CE_SP_ResourceSetActDeact_Type and NR_MAC_CE_SP_SRS_ActDeact_Type
                                                                   or
                                                                   CORESET Pool ID for NR_MAC_CE_TCI_StatesActDeact_Type
                                                                   reserved (set to 0) otherwise */
    B5_Type     ServCellId,                                     /* identity of the Serving Cell for which the MAC CE applies */
    B2_Type     BwpId                                           /* BWP-Id (as specified in TS 38.331) of the uplink/downlink bandwidth part for which the MAC CE applies */
  };

  } // End sub-sub-sub-group MAC_ControlElement_Common

  group MAC_ControlElement_BSR {                                /* TS 38.321 clause 6.1.3.1 (Buffer Status Report MAC CEs) */

  type record NR_MAC_CE_ShortBSR_Type {                         /* Short BSR and Short Truncated BSR MAC CE according to TS 38.321 Figure 6.1.3.1-1 */
    B3_Type     LCG,
    B5_Type     BufferSize
  };

  type O1_Type NR_MAC_LongBSR_BufferSize_Type;
  type record length (0..8) of NR_MAC_LongBSR_BufferSize_Type NR_MAC_LongBSR_BufferSizeList_Type;

  type record NR_MAC_CE_LongBSR_Type {                          /* Long BSR, Long Truncated BSR and Pre-emptive BSR MAC CE according to TS 38.321 Figure 6.1.3.1-2 */
    B8_Type                             LCG_Presence,           /* '1' indicates that the Buffer Size field for a logical channel group i is reported,
                                                                   with i = 7 for the leftmost bit and i = 0 for the rightmost */
    NR_MAC_LongBSR_BufferSizeList_Type  BufferSizeList          /* According to TS 38.321 clause 6.1.3.1 the Buffer Size fields are included in ascending order based on the LCGi */
  };
  
  type record NR_MAC_CE_RefinedLongBSR_Type {                   /* Refined Long BSR MAC CE according to TS 38.321 Figure 6.1.3.1-5 */
    B8_Type                             LCG_Presence,           /* '1' indicates that the Buffer Size field for a logical channel group i is reported,
                                                                    with i = 7 for the leftmost bit and i = 0 for the rightmost */
    B8_Type                             BT,                     /* '1' indicates that for a reported logical channel group i buffer size table specified in Table 6.1.3.1-3 is used, '0' indicates buffer size table specified in Table 6.1.3.1-2 is used,
                                                                    with i = 7 for the leftmost bit and i = 0 for the rightmost */
    NR_MAC_LongBSR_BufferSizeList_Type  BufferSizeList          /* According to TS 38.321 clause 6.1.3.1 the Buffer Size fields are included in ascending order based on the LCGi */
  };

  } // End sub-sub-sub-group MAC_ControlElement_BSR

  group MAC_ControlElement_ContentionResolutionId {             /* TS 38.321 clause 6.1.3.3 (UE Contention Resolution Identity MAC CE) */

  type B48_Type NR_MAC_CE_ContentionResolutionId_Type;          /* TS 38.321 Figure 6.1.3.3-1; fix size of 48 bits */

  } // End sub-sub-sub-group MAC_ControlElement_ContentionResolutionId

  group MAC_ControlElement_TimingAdvance {                      /* TS 38.321 clause 6.1.3.4 (Timing Advance Command MAC CE) */
                                                                /* TS 38.321 clause 6.1.3.56 (Timing Advance Report MAC CE) */

  type record NR_MAC_CE_TimingAdvance_Type {                    /* TS 38.321 Figure 6.1.3.4-1 */
    B2_Type     TAG_ID,                                         /* TAG Identity of the addressed TAG */
    B6_Type     TimingAdvanceCommand                            /* index value TA (0..63) used to control the amount of timing adjustment that MAC entity has to apply (as specified in TS 38.213) */
  };

  type record NR_MAC_CE_TimingAdvanceReport_Type {              /* TS 38.321 Figure 6.1.3.56-1 */
    B2_Type            Reserved,                                /* Reserved bits, set to 0 */
    B14_Type           TimingAdvance                            /* Except for ATG in FR1, the least integer number of slots, using subcarrier spacing of 15 kHz, greater than or equal to the Timing Advance value (TS 38.211 clause 4.3.1)
                                                                   For ATG in FR1, the least integer number of symbols greater than or equal to the Timing Advance value (see TS 38.211 clause 4.3.1). The symbol duration is based on the SCS of the active BWP. Only 15 kHz and 30 kHz SCS are applicable and only values 1 - 56 are used
                                                                */
  };

type record NR_MAC_CE_PH_MultiTRP_Record_Type {
    B1_Type     P_Bit,                    /* P bit: 1 indicates the UE applies power backoff due to power management;
                                           * If mpe-Reporting is configured indicates the applied power backoff to meet MPE requirements.
                                           */
    B1_Type     V1,                       /* V bit: Indicates when the PH value is based on a real transmission or a reference format; For Type 1 PH, the V field set to 0 indicates real transmission on PUSCH and the V field set to 1 indicates that a PUSCH reference format is used. */
    B6_Type     Value1,                   /* The power headroom level. Ph Type 2 (if configured) for PCell and Type 1 for PCell and SCell, associated with the SRS-ResourceSet with a lower srs-ResourceSetId. */
    B1_Type     Reserved    optional,     /* R: Reserved bit, set to 0 */
    B1_Type     V2          optional,     /* V bit: Indicates when the PH value is based on a real transmission or a reference format; For Type 1 PH, the V field set to 0 indicates real transmission on PUSCH and the V field set to 1 indicates that a PUSCH reference format is used. */
    B6_Type     Value2    optional,       /* The power headroom level. Ph Type 2 (if configured) for PCell and Type 1 for PCell and SCell, associated with the SRS-ResourceSet with a higher srs-ResourceSetId. */
    B2_Type     MPE_or_R    optional,     /* 2 reserved bits or MPE (Maximum Permissible Exposure)
                                           * If mpe-Reporting-FR2 is not configured, or if the Serving Cell operates on FR1, or if the P field is set to 0, R bits are present instead.
                                           */
    B6_Type     PCMaxc    optional        /* indicates the PCMAX,f,c */
  };

  type NR_MAC_CE_PH_MultiTRP_Record_Type NR_MAC_CE_EnhSingleEntryPHRMultiTRP_Type;  /* TS 38.321 Figure 6.1.3.50-1 */

  type record NR_MAC_CE_EnhMultiEntryPHRMultiTRP_Type {                    /* TS 38.321 Figure 6.1.3.51-1 and Figure 6.1.3.51-2 */
    NR_MAC_CE_SCellFlags_Type                    PHFieldPresentForSCell,   /* to indicate presence of PH field for particular SCell */
    record of NR_MAC_CE_PH_MultiTRP_Record_Type  PH_Record                 /* list of PH_Records for PCell and SCells as described in TS 38.321 clause 6.1.3.51 */
  };

  } // End sub-sub-sub-group MAC_ControlElement_TimingAdvance

  group MAC_ControlElement_PHR {                                /* TS 38.321 clause 6.1.3.8 (Single Entry PHR) and 6.1.3.9 (Multiple Entry PHR) */

  type record NR_MAC_CE_PH_Record_Type {
    B1_Type     P_Bit,                                          /* P bit: 1 indicates the UE applies power backoff due to power management;
                                                                   For Single Entry PHR MAC CE: If mpe-Reporting is configured indicates the applied power backoff to meet MPE requirements.  */
    B1_Type     V_or_R,                                         /* V bit: Indicates when the PH value is based on a real transmission or a reference format;
                                                                   reserved (R = '0'B) for Single Entry PHR MAC CE */
    B6_Type     Value,                                          /* The power headroom level. Ph Type 2 (if configured) for PCell and Type 1 for PCell and SCell */
    B2_Type     MPE_or_DPC_or_R optional,                       /* 2 reserved bits or MPE (Maximum Permissible Exposure) or DPC (Delta Power Class);
                                                                   present if V=0 */
    B6_Type     PCMaxc   optional                               /* present if V=0 */
  };

  type NR_MAC_CE_PH_Record_Type NR_MAC_CE_SingleEntryPHR_Type;  /* TS 38.321 Figure 6.1.3.8-1 */

  type record NR_MAC_CE_MultiEntryPHR_Type {                    /* TS 38.321 Figure 6.1.3.9-1 and Figure 6.1.3.9-2 */
    NR_MAC_CE_SCellFlags_Type           PHFieldPresentForSCell, /* to indicate presence of PH field for particular SCell */
    record of NR_MAC_CE_PH_Record_Type  PH_Record               /* list of PH_Records for PCell and SCells as described in TS 38.321 clause 6.1.3.9 */
  };

  } // End sub-sub-sub-group MAC_ControlElement_PHR

  group MAC_ControlElement_SCellActivationDeactivation {        /* TS 38.321 clause 6.1.3.10 (SCell Activation/Deactivation MAC CEs) */

  type NR_MAC_CE_SCellFlags_Type NR_MAC_CE_SCellActDeact_Type;  /* TS 38.321 Figure 6.1.3.10-1 and Figure 6.1.3.10-2 */

  } // End sub-sub-sub-group MAC_ControlElement_SCellActivationDeactivation

  group MAC_ControlElement_DuplicationActivationDeactivation {  /* TS 38.321 clause 6.1.3.11 (Duplication Activation/Deactivation MAC CE) */

  type B8_Type NR_MAC_CE_DuplicationActDeact_Type;              /* TS 38.321 Figure 6.1.3.11-1 */

  } // End sub-sub-sub-group MAC_ControlElement_DuplicationActivationDeactivation

  group MAC_ControlElement_SP_ResourceSetActivationDeactivation {                               /* TS 38.321 clause 6.1.3.12 (SP CSI-RS / CSI-IM Resource Set Activation/Deactivation MAC CE) */

  type record NR_MAC_CE_SP_ResourceSetActDeact_Octet2_Type {
    B1_Type     Reserved,
    B1_Type     IM,                                                                             /* indicates whether or not octet 3 is present */
    B6_Type     CSI_RS_ResourcesetId
  };

  type record NR_MAC_CE_SP_ResourceSetActDeact_Octet3_Type {
    B2_Type     Reserved,
    B6_Type     CSI_IM_ResourcesetId
  };

  type record NR_MAC_CE_SP_ResourceSetActDeact_TciStateId_Type {
    B1_Type     Reserved,
    B7_Type     Id
  };
  type record of NR_MAC_CE_SP_ResourceSetActDeact_TciStateId_Type NR_MAC_CE_SP_ResourceSetActDeact_TciStateIdList_Type;

  type record NR_MAC_CE_SP_ResourceSetActDeact_Type {                                           /* TS 38.321 Figure 6.1.3.12-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: A/D field */
    NR_MAC_CE_SP_ResourceSetActDeact_Octet2_Type                Octet2,
    NR_MAC_CE_SP_ResourceSetActDeact_Octet3_Type                Octet3                optional, /* present if IM=1 in octet 2 */
    NR_MAC_CE_SP_ResourceSetActDeact_TciStateIdList_Type        IdList
  };

  } // End sub-sub-sub-group MAC_ControlElement_SP_ResourceSetActivationDeactivation

  group MAC_ControlElement_CSI_TriggerStateSubselection {                                       /* TS 38.321 clause 6.1.3.13 (Aperiodic CSI Trigger State Subselection MAC CE) */

  type record NR_MAC_CE_CSI_TriggerStateSubselection_Type {                                     /* TS 38.321 Figure 6.1.3.13-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: reserved */
    B8_List_Type                                                Selection
  };

  } // End sub-sub-sub-group MAC_ControlElement_CSI_TriggerStateSubselection

  group MAC_ControlElement_TCI_StatesActivationDeactivation {                                   /* TS 38.321 clause 6.1.3.14 (TCI States Activation/Deactivation for UE-specific PDSCH MAC CE) */

  type record NR_MAC_CE_TCI_StatesActDeact_Type {                                               /* TS 38.321 Figure 6.1.3.14-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: CORESET Pool ID field */
    B8_List_Type                                                Status
  };

  } // End sub-sub-sub-group MAC_ControlElement_TCI_StatesActivationDeactivation

  group MAC_ControlElement_TCI_StateIndication {                                                /* TS 38.321 clause 6.1.3.15 (TCI State Indication for UE-specific PDCCH MAC CE) */

  type record NR_MAC_CE_TCI_StateIndication_Type {                                              /* TS 38.321 Figure 6.1.3.15-1 */
    B5_Type     ServCellId,                                                                     /* identity of the Serving Cell for which the MAC CE applies */
    B4_Type     CoresetId,                                                                      /* ControlResourceSetId for which the TCI State is being indicated */
    B7_Type     TciStateId                                                                      /* TCI-StateId applicable to the Control Resource Set identified by CORESET ID field */
  };

  } // End sub-sub-sub-group MAC_ControlElement_TCI_StateIndication

  group MAC_ControlElement_SP_CSI_ReportingActivationDeactivation {                             /* TS 38.321 clause 6.1.3.16 (SP CSI reporting on PUCCH Activation/Deactivation MAC CE) */

  type record NR_MAC_CE_SP_CSI_ReportingActDeact_Type {                                         /* TS 38.321 Figure 6.1.3.16-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: reserved */
    B3_Type                                                     Reserved,
    B1_Type                                                     L_or_Reserved,                  /* L: indicates whether the MAC CE applies to SP CSI reporting on PUCCH Activation/Deactivation for LTM or not.
                                                                                                   If ltm-CSI-ReportConfigToAddModList is not configured,
                                                                                                   R field is present instead (i.e. set to 0);
                                                                                                 */
    B4_Type                                                     ConfigState
  };

  } // End sub-sub-sub-group MAC_ControlElement_SP_CSI_ReportingActivationDeactivation

  group MAC_ControlElement_SP_SRS_ActivationDeactivation {

  type record NR_MAC_CE_SP_SRS_ActDeact_Octet2_Type {                                           /* TS 38.321 clause 6.1.3.17 (SP SRS Activation/Deactivation MAC CE) */
    B2_Type     Reserved,
    B1_Type     C,
    B1_Type     SUL,
    B4_Type     SRS_ResourcesetId
  };

  type record NR_MAC_CE_SP_SRS_ActDeact_ResourceId_Type {
    B1_Type     F,
    B7_Type     Id
  };

  type record of NR_MAC_CE_SP_SRS_ActDeact_ResourceId_Type NR_MAC_CE_SP_SRS_ActDeact_ResourceIdList_Type;

  type record NR_MAC_CE_SP_SRS_ActDeact_ResourceInfo_Type {
    B1_Type     Reserved,
    B5_Type     ServingCellId,
    B2_Type     BwpId
  };

  type record of NR_MAC_CE_SP_SRS_ActDeact_ResourceInfo_Type NR_MAC_CE_SP_SRS_ActDeact_ResourceInfoList_Type;

  type record NR_MAC_CE_SP_SRS_ActDeact_Type {                                                  /* TS 38.321 Figure 6.1.3.17-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: A/D field */
    NR_MAC_CE_SP_SRS_ActDeact_Octet2_Type                       Octet2,
    NR_MAC_CE_SP_SRS_ActDeact_ResourceIdList_Type               ResourceIdList,
    NR_MAC_CE_SP_SRS_ActDeact_ResourceInfoList_Type             ResourceInfoList                /* empty list when C=0 */
  };

  } // End sub-sub-sub-group MAC_ControlElement_SP_SRS_ActivationDeactivation

  group MAC_ControlElement_PUCCH_SpatialRelationActivationDeactivation {                        /* TS 38.321 clause 6.1.3.18 (PUCCH spatial relation Activation/Deactivation MAC CE) */

  type record NR_MAC_CE_PUCCH_SpatialRelationActDeact_Octet2_Type {
    B1_Type     Reserved,
    B7_Type     ResourceId
  };

  type record NR_MAC_CE_PUCCH_SpatialRelationActDeact_Type {                                    /* TS 38.321 Figure 6.1.3.18-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                         /* Field1: reserved */
    NR_MAC_CE_PUCCH_SpatialRelationActDeact_Octet2_Type         Octet2,
    B8_Type                                                     ActivationStatus
  };

  } // End sub-sub-sub-group MAC_ControlElement_PUCCH_SpatialRelationActivationDeactivation

  group MAC_ControlElement_ZP_ResourceSetActivationDeactivation {                               /* TS 38.321 clause 6.1.3.19 (SP ZP CSI-RS Resource Set Activation/Deactivation MAC CE) */

  type record NR_MAC_CE_SP_ZP_ResourceSetActDeact_Octet2_Type {
    B4_Type     Reserved,
    B4_Type     Id
  };

  type record NR_MAC_CE_SP_ZP_ResourceSetActDeact_Type {                                        /* TS 38.321 Figure 6.1.3.19-1 */
    NR_MAC_CE_ServCellId_BwpId_Type                             Octet1,                          /* Field1: A/D field  */
    NR_MAC_CE_SP_ZP_ResourceSetActDeact_Octet2_Type             Octet2
  };

  } // End sub-sub-sub-group MAC_ControlElement_ZP_ResourceSetActivationDeactivation

  group MAC_ControlElement_RecommendedBitrate {                                                 /* TS 38.321 clause 6.1.3.20 (Recommended bit rate MAC CE) */

  type record NR_MAC_CE_RecommendedBitrate_Type {                                               /* TS 38.321 Figure 6.1.3.20-1 */
    B6_Type     LCID,
    B1_Type     UL_DL,
    B6_Type     Bitrate,
    B1_Type     X,                                                                             /* Bit rate multiplier */
    B2_Type     Reserved
  };

  } // End sub-sub-sub-group MAC_ControlElement_RecommendedBitrate

  group MAC_ControlElement_CE_RLC_DuplicationActDeact {

  type record NR_MAC_CE_RLC_DuplicationActDeact_Type {
    B5_Type    DrbId,
    B1_Type    Rlc2,
    B1_Type    Rlc1,
    B1_Type    Rlc0
  };
  } // End sub-sub-sub-group MAC_ControlElement_CE_RLC_DuplicationActDeact

  group MAC_ControlElement_SL_BSR {                           /* TS 38.321 clause 6.1.3.33 (Sidelink Buffer Status Report MAC CEs) */

  type record of NR_MAC_CE_SL_BSR_Type NR_MAC_CE_SL_BSR_List_Type;   /* SL-BSR and Truncated SL-BSR MAC CE according to TS 38.321 Figure 6.1.3.33-1 */

  type record NR_MAC_CE_SL_BSR_Type {
    B5_Type     DestinationIndex,
    B3_Type     LCG,
    O1_Type     BufferSize
  };

  type O1_Type NR_SL_MAC_LongBSR_BufferSize_Type;
  type record length (0..8) of NR_SL_MAC_LongBSR_BufferSize_Type NR_SL_MAC_LongBSR_BufferSizeList_Type;

  type record NR_SL_MAC_CE_LongBSR_Type {                       /* Long BSR, Long Truncated BSR and Pre-emptive BSR MAC CE according to TS 38.321 Figure 6.1.3.1-2 */
    B8_Type                             LCG_Presence,           /* '1' indicates that the Buffer Size field for a logical channel group i is reported,
                                                                   with i = 7 for the leftmost bit and i = 0 for the rightmost */
    NR_MAC_LongBSR_BufferSizeList_Type  BufferSizeList          /* According to TS 38.321 clause 6.1.3.1 the Buffer Size fields are included in ascending order based on the LCGi */
  };

  } // End sub-sub-sub-group MAC_ControlElement_SL_BSR

  group MAC_ControlElement_CE_POS_MeasGapActDeact {                                    /* TS 38.321 clause 6.1.3.40 (Positioning Measurement Gap Activation/Deactivation Request MAC CE);
                                                                                          TS 38.321 clause 6.1.3.41 (Positioning Measurement Gap Activation/Deactivation Command MAC CE)*/

  type record NR_MAC_CE_POS_MeasGapActDeact_Type {                                     /* TS 38.321 Figure 6.1.3.40-1; TS 38.321 Figure 6.1.3.41-1 */
    B3_Type    Reserved,
    B1_Type    Field2,                                                                  /* A/D field; set to 1 for activation, set to 0 for deactivation */
    B4_Type    PosMG_Id                                                                 /* Positioning MG ID */
  };
  } // End sub-sub-sub-group MAC_ControlElement_CE_POS_MeasGapActDeactCmd

  group MAC_ControlElement_CE_PPWActDeactCmd {                                          /* TS 38.321 clause 6.1.3.42 (PPW Activation/Deactivation Command MAC CE) */

  type record PpwInfo_Type {
    B5_Type  ServingCellId,                                                             /* Identity of the Serving Cell for which the MAC CE applies */
    B2_Type  PpwId,                                                                     /* Index of the PPW configured on active DL BWP of the Serving Cell */
    B1_Type  Field3                                                                     /* A/D field; set to 1 for activation, set to 0 for deactivation */
  };

  type record of PpwInfo_Type PpwInfo_List_Type;

  type record NR_MAC_CE_PPWActDeactCmd_Type {                                           /* TS 38.321 Figure 6.1.3.42-1 */
    B6_Type            Reserved,
    B2_Type            NumEntry,                                                        /* Number of entries N-1 in the MAC CE. 00 indicates that N equals to 2; 01 indicates that N equals to 3 and so on */
    PpwInfo_List_Type  PpwInfo_List                                                     /* List of PPW info */
  };
  } // End sub-sub-sub-group MAC_ControlElement_CE_PPWActDeactCmd

  group MAC_ControlElement_CE_LBT_Failure_Type {

  type record NR_MAC_CE_LBT_Failure_Type {                                              /* bitmap to indicate presence of ServCell with ServCellIndex according to TS 38.331 either ServCellIndex7_0 is present only or all octets are present */
    B8_Type             ServCellIndex7_0,                                               /* leftmost bit corresponds to ServCellIndex7, rightmost bit corresponds to ServCellIndex0 */
    B8_Type             ServCellIndex15_8                                 optional,     /* leftmost bit corresponds to ServCellIndex15, rightmost bit corresponds to ServCellIndex8 */
    B8_Type             ServCellIndex23_16                                optional,     /* leftmost bit corresponds to ServCellIndex23, rightmost bit corresponds to ServCellIndex16 */
    B8_Type             ServCellIndex31_24                                optional      /* leftmost bit corresponds to ServCellIndex31, rightmost bit corresponds to SCellIndex24 */
  };
  } // End sub-sub-sub-group MAC_ControlElement_CE_LBT_Failure_Type

  group MAC_ControlElement_CE_DifferentialKoffset_Type {                                /* TS 38.321 clause 6.1.3.57 (Differential Koffset MAC CE) */

  type record NR_MAC_CE_DifferentialKoffset_Type {                                      /* TS 38.321 Figure 6.1.3.57-1 */
    B2_Type            Reserved,                                                        /* Reserved bits, set to 0 */
    B6_Type            DifferentialKoffset                                              /* Differential Koffset in the number of slots (TS 38.213 clause 4.2), using subcarrier spacing of 15 kHz */
  };
  } // End sub-sub-sub-group MAC_ControlElement_CE_DifferentialKoffset_Type

  group MAC_CE_LTM_CellSwitch_Type {
    
  type NR_MAC_CE_SP_ResourceSetActDeact_TciStateId_Type NR_MAC_CE_TciStateId_Type;
  
  type record NR_MAC_CE_UL_TciStateId_Type {
    B2_Type     Reserved,
    B6_Type     Id
  };
  
  type record NR_MAC_CE_LTM_CellSwitch_Type {               /* TS 38.321 Figure 6.1.3.75-1 */
    B1_Type                       Cont_Free,                /* Presence of contention-free Random Access Resources fields  if 1,: Random Access Preamble index field, S/U field, SS/PBCH index field, PRACH Mask index field, Repetition number field and the reserved bits are present else not present */
    B3_Type                       TargConfigId,             /* Target Configuration ID */
    B12_Type                      TimingAdvance,            /* TA is valid for the LTM target cell */
    NR_MAC_CE_TciStateId_Type     TciStateId,               /* TCI state for the LTM target cell */
    NR_MAC_CE_UL_TciStateId_Type  UL_TciStateId optional,   /* Uplink TCI state for the LTM target cell */
    B6_Type                       RA_PreambleIndex optional,/* Random Access Preamble index of the contention-free Random Access Resources */
    B6_Type                       SSB_Index optional,       /* SS/PBCH that shall be used to determine the RACH occasion for the PRACH transmission */
    B4_Type                       PrachMaskIndex optional,  /* PRACH Mask index */
    B5_Type                       Reserved optional,        /* Reserved */
    B1_Type                       S_U optional,             /* If the value of this field is set to 1, SUL is used; otherwise, NUL is used*/
    B2_Type                       RepetitionNumber optional /* Msg1 repetition number to be applied to the contention-free Random Access */
  };
  } //End sub-sub-sub-group MAC_CE_LTM_CellSwitch_Type
  
  group MAC_CE_CandCellTCI_ActDeact_Type {
    
  type record NR_MAC_CE_CandCellActDeact_CellId_Type {
    B5_Type     Reserved,
    B3_Type     CellId
  };

  type record NR_MAC_CE_CandCellActDeact_TciStateId_Type {
    B1_Type     D_U,
    B7_Type     TCI_Id
  };
  
  type record of NR_MAC_CE_CandCellActDeact_TciStateId_Type NR_MAC_CE_CandCellActDeact_TciStateIdList_Type;
  
  type record NR_MAC_CE_CandCellTCI_ActDeact_Type {                 /* TS 38.321 Figure 6.1.3.76-1: Candidate Cell TCI state activation/deactivation MAC CE */
    NR_MAC_CE_CandCellActDeact_CellId_Type          CellId,         /* Candidate Cell ID */
    B8_Type                                         Pi,             /* TCI codepoint multiple TCI states /single TCI state  indicator*/
    NR_MAC_CE_CandCellActDeact_TciStateIdList_Type  TciStateIdList  /* TCI state ID 8-16 Octets */
  };
  } //End sub-sub-sub-group MAC_CE_CandCellTCI_ActDeact_Type
  group MAC_ControlElement_PHR_WithAssumedPUSCH {
    
  type NR_MAC_CE_PHRAssumedPUSCH_Type NR_MAC_CE_SingleEntryPHRAssumedPUSCH_Type;  /* TS 38.321 Figure 6.1.3.78-1: Single Entry PHR with assumed PUSCH MAC CE */

  type record NR_MAC_CE_PHRAssumedPUSCH_Type {
    B1_Type             P_Bit,                       /* P bit: 1 indicates the UE applies power backoff due to power management
                                                        If mpe-Reporting-FR2 is configured and the Serving Cell operates on FR2,
                                                        - 0 if the applied P-MPR value, to meet MPE requirements, as specified in TS 38.101-2, is less than P-MPR_00 as specified in TS 38.133
                                                        - 1 otherwise.
                                                        else, this field indicates whether power backoff is applied due to power management
                                                       */
    B1_Type             EorV_Bit,                     /*  E bit as according to 38.321 clause 6.1.3.78: indicates the presence of a PCMaxfc for assumed PUSCH field for PCell.
                                                        - 1 indicates that a PCMaxfc for assumed PUSCH field for PCell is reported.
                                                        - 0 indicates that a PCMaxfc for assumed PUSCH field for PCell is not reported
                                                        Or V bit as according to 38.321 clause 6.1.3.79: indicates if the PH value is based on a real transmission or a reference format.
                                                      */
    B6_Type             PH_Value,                     /* Power Headroom (PH): indicates the power headroom level */
    B2_Type             MPE_or_R,                     /* MPE (Maximum Permissible Exposure) or 2 reserved bits */
    B6_Type             PCMaxfc,                        /* PCMAX,f,c */
    B2_Type             R_Bits optional,              /* reserved bits */
    B6_Type             PCMaxfcAssumedPUSCH optional  /*    PCMAX,f,c for assumed PUSCH */
  };
  
  type record NR_MAC_CE_CandE_SCellFlags_Type {
  /* C bitmap to indicate presence of PH field for SCell with SCellIndex according to TS 38.331; either C_SCellIndex7_1 is present only or all C_SCellIndex are present
     E bitmap to indicate presence of PCMAX,f,c for assumed PUSCH field for SCell with SCellIndex according to TS 38.331; either E_SCellIndex7_1 is present only or all E_SCellIndex are present
  */
    B8_Type             C_SCellIndex7_1,              /* leftmost bit corresponds to C_SCellIndex7, 2nd bit from the right corresponds to C_SCellIndex1, rightmost bit is reserved */
    B8_Type             C_SCellIndex15_8 optional,    /* leftmost bit corresponds to C_SCellIndex15, rightmost bit corresponds to C_SCellIndex8 */
    B8_Type             C_SCellIndex23_16 optional,   /* leftmost bit corresponds to C_SCellIndex23, rightmost bit corresponds to C_SCellIndex16 */
    B8_Type             C_SCellIndex31_24   optional,   /* leftmost bit corresponds to C_SCellIndex31, rightmost bit corresponds to C_SCellIndex24 */
    B8_Type             E_SCellIndex7_0,              /* leftmost bit corresponds to E_SCellIndex7,  rightmost bit corresponds to E_SCellIndex0 */
    B8_Type             E_SCellIndex15_8    optional,   /* leftmost bit corresponds to E_SCellIndex15, rightmost bit corresponds to E_SCellIndex8 */
    B8_Type             E_CellIndex23_16 optional,    /* leftmost bit corresponds to E_SCellIndex23, rightmost bit corresponds to E_SCellIndex16 */
    B8_Type             E_SCellIndex31_24   optional    /* leftmost bit corresponds to E_SCellIndex31, rightmost bit corresponds to E_SCellIndex24 */
  };
  
  type record NR_MAC_CE_MultiEntryPHRAssumedPUSCH_Type {
    NR_MAC_CE_CandE_SCellFlags_Type           CandE_FieldPresentForSCell,     /* to indicate presence of PH and PCMAX,f,c for assumed PUSCH fields for particular SCell */
    record of NR_MAC_CE_PHRAssumedPUSCH_Type  PH_Record                     /* list of PH with assumed PUSCH records for PCell and SCells as described in TS 38.321 clause 6.1.3.78 */
  };

  } // End sub-sub-sub-group MAC_ControlElement_PHR_WithAssumedPUSCH
  
  group MAC_CE_DelayStatusReport_Type {
  
  type record NR_DelayInformation_Type {
    /* TS 38.321 Figure 6.1.3.72-1: DSR MAC CE */
    B1_Type             BT,             /* BT: This field is present only if the corresponding LCG is configured with additionalBS-TableAllowed and the buffer size indicated by the corresponding Buffer Size field is not zero; otherwise, this field is reserved and set to 0. */
    B1_Type             Reserved,       /* Reserved bit */
    B6_Type             RemainingTime,  /* Remaining Time indicates the shortest remaining value of running PDCP discardTimer (described in clause 7.3 in TS 38.323 [4]) among all PDCP SDUs that are buffered for an LCG but have not been transmitted in any MAC PDU, at the time of the first symbol of the first PUSCH transmission that includes this DSR MAC CE. The length of this field is 6 bits. This field is present only if the buffer size indicated by the corresponding Buffer Size field is not zero; otherwise, this field is reserved and set to 0. */
    B8_Type             BufferSize      /* Buffer Size field indicates the total amount of delay-critical UL data for an LCG */
  };

  type record of NR_DelayInformation_Type NR_DelayInformationList_Type;

  type record NR_MAC_CE_DSR_Type {
    /* TS 38.321 Figure 6.1.3.72-1: DSR MAC CE */
    B8_Type                         LCGIndex,       /* bitmap to indicate the presence of delay information for the LCG
                                                       leftmost bit corresponds to LCG7, rightmost bit corresponds to LCG0
                                                    */
    NR_DelayInformationList_Type    DelayInformationList
  };

  } // End dub-dub-dub-group MAC_CE_DelayStatusReport_Type
 
  group MAC_CE_EnhancedSP_CSI_ReportActDeac_Type {
  
  type record NR_MAC_CE_EnhancedSP_CSI_ReportActDeac_Type {
  /* TS 38.321 Figure 6.1.3.80-1: Enhanced SP CSI reporting on PUCCH Activation/Deactivation MAC CE */
    B1_Type           Reserved,     /* Reserved bit */
    B5_Type           ServCellId,   /* Identity of the Serving Cell for which the MAC CE applies */
    B2_Type           BwpId,        /* BWP-Id (as specified in TS 38.331) of the uplink/downlink bandwidth part for which the MAC CE applies */
    B4_Type           Reserved2,    /* 4 bits reserved */
    B4_Type           Si,           /* Si fields indicating activation/deactivation of the Semi-Persistent CSI report configuration within csi-ReportConfigToAddModList */
    B8_List_Type      Nix           /* Ni,x fields indicate the activation/deactivation status of the Semi-Persistent CSI report sub-configuration x within csi-ReportSubConfigToAddModList */
  };
  
  }  // End dub-dub-dub-group MAC_CE_EnhancedSP_CSI_ReportActDeac_Type
  
  group MAC_CE_SL_CSI_Reporting {

  type record NR_MAC_CE_SL_CSI_Reporting_Type {
  /* TS 38.321 Figure 6.1.3.35-1: Sidelink CSI Reporting MAC CE */
    B1_Type           RI,        /* Derived value of the Rank Indicator for sidelink CSI reporting */
    B4_Type           CQI,       /* Derived value of the Channel Quality Indicator for sidelink CSI reporting */
    B3_Type           Reserved   /* 3 bits reserved */
  };
    
  } // End sub-sub-sub-group MAC_CE_SL_CSI_Reporting
      
  } // End sub-sub-group MAC_ControlElements
  } // End sub-group MAC_PDU

  //****************************************************************************
  // RLC PDU definition
  //----------------------------------------------------------------------------

  group RLC_PDU {

  group Common {  /* RLC PDU definition: common AM/UM field definitions */

  type B2_Type NR_RLC_SegmentationInfo_Type;    /* Segmentation Info (SI) field (TS 38.322, clause 6.2.3.4)
                                                   00 - Data field contains all bytes of an RLC SDU
                                                   01 - Data field contains the first segment of an RLC SDU
                                                   10 - Data field contains the last segment of an RLC SDU
                                                   11 - Data field contains neither the first nor last segment of an RLC SDU */
  type B16_Type NR_RLC_SegmentOffset_Type;      /* Segment Offset (SO) field (TS 38.322, 6.2.3.5) */
  } // End sub-sub-group Common

  //****************************************************************************

  group TM_Data { /* RLC PDU definition: UM  (TS 38.322, clause 6.2.2.2) */

  type octetstring NR_RLC_TMD_PDU_Type;                 /* TS 38.322, clause 6.2.2.2 */

  } // End sub-sub-group TM_Data

  group UM_Data { /* RLC PDU definition: UM  (TS 38.322, clause 6.2.2.3) */

  type octetstring NR_RLC_UMD_Data_Type;                        /* TS 38.322, clause 6.2.2.3 */


  type record NR_RLC_UMD_HeaderNoSN_Type {                      /* TS 38.322, clause 6.2.2.3 (Figure 6.2.2.3-1; one octet */
    NR_RLC_SegmentationInfo_Type        SegmentationInfo,
    B6_Type                             Reserved
   };

  type record NR_RLC_UMD_PduNoSN_Type {                         /* TS 38.322, clause 6.2.2.3 (Figure 6.2.2.3-1); one octet */
    NR_RLC_UMD_HeaderNoSN_Type          Header,
    NR_RLC_UMD_Data_Type                Data
  };

  type record NR_RLC_UMD_HeaderSN6Bit_Type {                    /* TS 38.322, clause 6.2.2.3 (6.2.2.3-2, 6.2.2.3-4); one octet */
    NR_RLC_SegmentationInfo_Type        SegmentationInfo,       /* 2 bits SI */
    B6_Type                             SequenceNumber,         /* 6 bits SN */
    NR_RLC_SegmentOffset_Type           SegmentOffset optional  /* 16 bits SO; included in case of segmentation but not for the first segment (TS 38.322 clause 6.2.2.3) */
  };

  type record NR_RLC_UMD_PduSN6Bit_Type {                       /* TS 38.322, clause 6.2.2.3 (6.2.2.3-2, 6.2.2.3-4); one octet */
    NR_RLC_UMD_HeaderSN6Bit_Type        Header,
    NR_RLC_UMD_Data_Type                Data
  };

  type record NR_RLC_UMD_HeaderSN12Bit_Type {                   /* TS 38.322, clause 6.2.2.3 (Figure 6.2.2.3-3, 6.2.2.3-5); two octets */
    NR_RLC_SegmentationInfo_Type        SegmentationInfo,       /* 2 bits SI */
    B2_Type                             Reserved,               /* 2 bits reserved */
    B12_Type                            SequenceNumber,         /* 12 bits SN */
    NR_RLC_SegmentOffset_Type           SegmentOffset optional  /* 16 bits SO; included in case of segmentation but not for the first segment (TS 38.322 clause 6.2.2.3) */
  };

  type record NR_RLC_UMD_PduSN12Bit_Type {                      /* TS 38.322, clause 6.2.2.3 (Figure 6.2.2.3-3, 6.2.2.3-5); two octets */
    NR_RLC_UMD_HeaderSN12Bit_Type       Header,
    NR_RLC_UMD_Data_Type                Data
  };

  type union NR_RLC_UMD_PDU_Type {
    NR_RLC_UMD_PduNoSN_Type             NoSN,
    NR_RLC_UMD_PduSN6Bit_Type           SN6Bit,
    NR_RLC_UMD_PduSN12Bit_Type          SN12Bit
  };

  } // End sub-sub-group UM_Data

  group AM_Data { /* RLC PDU definition: AM  (TS 38.322, clause 6.2.2.4) */

  type octetstring NR_RLC_AMD_Data_Type;                        /* TS 38.322, clause 6.2.2.4 */

  type record NR_RLC_AMD_HeaderSN12Bit_Type {                   /* TS 38.322, clause 6.2.2.4 (Figure 6.2.2.4-1, 6.2.2.4-3) */
    B1_Type                             D_C,                    /* 1 bit, '1'B for Data PDU */
    B1_Type                             Poll,                   /* 1 bit, '0'B - Status report not requested
                                                                 *        '1'B - Status report is requested */
    NR_RLC_SegmentationInfo_Type        SegmentationInfo,       /* 2 bits SI */
    B12_Type                            SequenceNumber,         /* 12 bits SN */
    NR_RLC_SegmentOffset_Type           SegmentOffset optional  /* 16 bits SO; included in case of segmentation but not for the first segment (TS 38.322 clause 6.2.2.4) */
  };

  type record NR_RLC_AMD_PduSN12Bit_Type {                      /* TS 38.322, clause 6.2.2.4 (Figure 6.2.2.4-1, 6.2.2.4-3) */
    NR_RLC_AMD_HeaderSN12Bit_Type       Header,
    NR_RLC_AMD_Data_Type                Data
  };

  type record NR_RLC_AMD_HeaderSN18Bit_Type {                   /* TS 38.322, clause 6.2.2.4 (Figure 6.2.2.4-2, 6.2.2.4-4) */
    B1_Type                             D_C,                    /* 1 bit, '1'B for Data PDU */
    B1_Type                             Poll,                   /* 1 bit, 0 - Status report not requested
                                                                 *        1 - Status report is requested */
    NR_RLC_SegmentationInfo_Type        SegmentationInfo,       /* 2 bits SI */
    B2_Type                             Reserved,               /* 2 bits reserved */
    B18_Type                            SequenceNumber,         /* 18 bits SN */
    NR_RLC_SegmentOffset_Type           SegmentOffset optional  /* 16 bits SO; included in case of segmentation but not for the first segment (TS 38.322 clause 6.2.2.4) */
  };

  type record NR_RLC_AMD_PduSN18Bit_Type {                      /* TS 38.322, clause 6.2.2.4 Figure 6.2.2.4-2, 6.2.2.4-4) */
    NR_RLC_AMD_HeaderSN18Bit_Type       Header,
    NR_RLC_AMD_Data_Type                Data
  };


  type union NR_RLC_AMD_PDU_Type {                              /* TS 38.322, clause 6.2.2.4 */
    NR_RLC_AMD_PduSN12Bit_Type          SN12Bit,
    NR_RLC_AMD_PduSN18Bit_Type          SN18Bit
  };

  } // End sub-sub-group AM_Data

  //****************************************************************************

  group AM_Status {     /* AM Status PDU (TS 36.322, clause 6.2.1.6) */

  type B1_Type NR_RLC_Status_ExtensionBit1_Type;                /* TS 38.322, clause 6.2.3.11 Extension bit 1 (E1) field:
                                                                   '0'B  A set of NACK_SN, E1, E2 and E3 does not follow.
                                                                   '1'B  A set of NACK_SN, E1, E2 and E3 follows. */

  type B1_Type NR_RLC_Status_ExtensionBit2_Type;                /* TS 38.322, clause 6.2.3.13 Extension bit 2 (E2) field:
                                                                   '0'B  A set of SOstart and SOend does not follow for this NACK_SN.
                                                                   '1'B  A set of SOstart and SOend follows for this NACK_SN. */

  type B1_Type NR_RLC_Status_ExtensionBit3_Type;                /* TS 38.322, clause 6.2.3.16 Extension bit 3 (E3) field:
                                                                   '0'B  A set of NACK_SN, E1, E2 and E3 follows.
                                                                   '1'B  NACK range field follows for this NACK_SN. */

  type record NR_RLC_Status_NackSN12Bit_Type {                  /* TS 38.322, clause 6.2.2.5 (Figure 6.2.2.5-1) */
    B12_Type                            SequenceNumberNACK,     /* 12 bits SN */
    NR_RLC_Status_ExtensionBit1_Type    E1,                     /* 1 bit E1 field; set if further NACK set follows */
    NR_RLC_Status_ExtensionBit2_Type    E2,                     /* 1 bit E2 field */
    NR_RLC_Status_ExtensionBit3_Type    E3,                     /* 1 bit E3 field */
    B1_Type                             Reserved,               /* 1 bit reserved */
    NR_RLC_SegmentOffset_Type           SOstart       optional, /* segment offset (start), present only if E2 is set to '1'B */
    NR_RLC_SegmentOffset_Type           SOstop        optional, /* segment offset (stop),  present only if E2 is set to '1'B */
    B8_Type                             NACKrange     optional  /* NACK range,  present only if E3 is set to '1'B */
  };

  type record of NR_RLC_Status_NackSN12Bit_Type NR_RLC_Status_NackListSN12Bit_Type;

  type record NR_RLC_StatusPduSN12Bit_Type {                    /* TS 38.322, clause 6.2.2.5 (Figure 6.2.2.5-1) */
    B1_Type                             D_C,                    /* 1 bit,  '0'B for Control PDU */
    B3_Type                             CPT,                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                                 *         '000'B  STATUS PDU
                                                                 *         ELSE    reserved */
    B12_Type                            SequenceNumberACK,      /* 12 bits SN */
    NR_RLC_Status_ExtensionBit1_Type    E1,                     /* 1 bit E1 field */
    B7_Type                             Reserved,               /* 7 bits reserved */
    NR_RLC_Status_NackListSN12Bit_Type  NackList      optional  /* zero or more sets of a NACK_SN, E1, E2 and E3 and possibly a pair of SOstart/SOend or NACK range field for each NACK_SN */
  };

  type record NR_RLC_Status_NackSN18Bit_Type {                  /* TS 38.322, clause 6.2.2.5 (Figure 6.2.2.5-1) */
    B18_Type                            SequenceNumberNACK,     /* 18 bits SN */
    NR_RLC_Status_ExtensionBit1_Type    E1,                     /* 1 bit E1 field; set if further NACK set follows */
    NR_RLC_Status_ExtensionBit2_Type    E2,                     /* 1 bit E2 field */
    NR_RLC_Status_ExtensionBit3_Type    E3,                     /* 1 bit E3 field */
    B3_Type                             Reserved,               /* 3 bits reserved */
    NR_RLC_SegmentOffset_Type           SOstart       optional, /* segment offset (start), present only if E2 is set to '1'B */
    NR_RLC_SegmentOffset_Type           SOstop        optional, /* segment offset (stop),  present only if E2 is set to '1'B */
    B8_Type                             NACKrange     optional  /* NACK range,  present only if E3 is set to '1'B */
  };

  type record of NR_RLC_Status_NackSN18Bit_Type NR_RLC_Status_NackListSN18Bit_Type;

  type record NR_RLC_StatusPduSN18Bit_Type {                    /* TS 38.322, clause 6.2.2.5 (Figure 6.2.2.5-1) */
    B1_Type                             D_C,                    /* 1 bit,  '0'B for Control PDU */
    B3_Type                             CPT,                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                                 *         '000'B  STATUS PDU
                                                                 *         ELSE    reserved */
    B18_Type                            SequenceNumberACK,      /* 18 bits SN */
    NR_RLC_Status_ExtensionBit1_Type    E1,                     /* 1 bit E1 field */
    B1_Type                             Reserved,               /* 1 bit reserved */
    NR_RLC_Status_NackListSN18Bit_Type  NackList      optional  /* zero or more sets of a NACK_SN, E1, E2 and E3 and possibly a pair of SOstart/SOend or NACK range field for each NACK_SN */
  };

  type union NR_RLC_AM_StatusPDU_Type {                         /* TS 38.322, clause 6.2.254 */
    NR_RLC_StatusPduSN12Bit_Type        SN12Bit,
    NR_RLC_StatusPduSN18Bit_Type        SN18Bit
  };

  } // End sub-sub-group AM_Status

  type union NR_RLC_PDU_Type {
    NR_RLC_TMD_PDU_Type         TMD,
    NR_RLC_UMD_PDU_Type         UMD,
    NR_RLC_AMD_PDU_Type         AMD,
    NR_RLC_AM_StatusPDU_Type    Status
  };

  type record of NR_RLC_PDU_Type NR_RLC_PDUList_Type;

  type octetstring NR_RLC_SDU_Type;
  type record of NR_RLC_SDU_Type NR_RLC_SDUList_Type;

  } // End sub-group RLC

  } with { encode "DRB Types"} // End group PDU_TypeDefs

  //****************************************************************************

  group DRB_Primitive_Definitions {  // Primitive definitions to send/receive data PDUs over DRB's

  group DRB_Common {

  type union NR_L2DataList_Type {               /* MAC:
                                                 * acc. to rel-15 protocols there is exactly one MAC PDU per TB but in case of spatial multiplexing there can be one or more TB per HARQ process;
                                                 * any MAC PDU is completely included in one slot (TTI)
                                                 * RLC:
                                                 * one or more RLC PDUs per slot (TTI)
                                                 * (e.g. RLC Data + Status PDU on a logical channel;
                                                 * more than one RLC Data PDU in one MAC PDU is valid too)
                                                 * any RLC PDU is completely included in one slot (TTI)
                                                 * PDCP:
                                                 * one or more PDUs per slot (TTI); one PDCP PDU may be included in more than one slot (TTI) */
    NR_MAC_PDUList_Type         MacPdu,          /* SS configuration: RLC TM mode, MAC no header removal (PDCP is not configured) */
    NR_RLC_PDUList_Type         RlcPdu,          /* SS configuration: RLC TM mode, MAC header removal (PDCP is not configured) */
    NR_RLC_SDUList_Type         RlcSdu,          /* SS configuration: RLC UM mode with no PDCP */
    NR_PDCP_PDUList_Type        PdcpPdu,         /* SS configuration: RLC AM/UM mode, no handling of PDCP header */
    NR_PDCP_SDUList_Type        PdcpSdu,         /* SS configuration: RLC AM/UM mode, PDCP normal mode (automatic handling of PDCP header) */
    SDAP_PDUList_Type           SdapPdu,         /* SS configuration: RLC AM/UM mode, PDCP normal mode (automatic handling of PDCP header), no handling of SDAP header */
    SDAP_SDUList_Type           SdapSdu          /* SS configuration: RLC AM/UM mode, PDCP normal mode (automatic handling of PDCP header), automatic handling of SDAP header */
  };

  type union NR_HarqProcessAssignment_Type {    /* in DL the HARQ process id may be specified by the test case or automatically assigned by SS */
    NR_HarqProcessId_Type       Id,             /* HARQ process as specified by the test case
                                                 * NOTE1:
                                                 * the scope of this type is only for data being sent in one slot (TTI);
                                                 * if data needs more than one slot (TTI) the HarqProcessId is undefined for the 2nd TTI onward what shall be handled as an error at the SS; SS may send a SYSTEM_IND indicating an error in this case;
                                                 * NOTE2:
                                                 * The initial value of the NDI shall be the same for all HARQ processes and cells */
    Null_Type                   Automatic       /* HARQ process id automatically assigned by SS */
  };

  } // End sub-group DRB_Common
  //----------------------------------------------------------------------------

  group Downlink {

  type record NR_DRB_DataPerSlot_DL_Type {                      /* common definition for one or several PDUs/SDUs;
                                                                 * in NR the DL data is sent in the slot given by the slot offset
                                                                 * NOTE 1:
                                                                 * For MAC and RLC PDUs a single PDU is always sent in one slot;
                                                                 * SS shall raise an error indication (using SYSTEM_IND) when that is not possible
                                                                 * NOTE 2:
                                                                 * For PDCP the data may be spread over more than one slot (segmented by the RLC);
                                                                 * the TTCN implementation is responsible to calculate appropriate offsets accordingly;
                                                                 * the exact timing depends on (and is exactly specified by) configuration of the DL scheduling;
                                                                 * SS shall raise an error when there is any conflict */
    integer                             SlotOffset,             /* NR:
                                                                 * Slot offset relative to the absolute timing information given in the common part of the ASP;
                                                                 * NOTE:
                                                                 * if a PDCP PDU or SDU takes more than one slot, SlotOffset specifies the first slot (TTI) */
    NR_HarqProcessAssignment_Type       HarqProcess optional,   /* HARQ process to be used: specific value or automatically assigned by SS;
                                                                 * in automatic mode SS chooses HARQ process out of the set configured by DcchDtchConfig.DL.SearchSpaceAndDci.DciInfo.ResoureAssignment.HarqProcessConfig
                                                                 * NOTE:
                                                                 * for PDCP SDUs or PDUs automatic mode shall be used; otherwise SS shall raise an error */
    NR_L2DataList_Type                  PduSduList              /* list of PDUs/SDUs to be sent in one slot (TTI) */
  };

  type record of NR_DRB_DataPerSlot_DL_Type
    NR_DRB_DataPerSlotList_DL_Type;                             /* list of user plane data to be sent in slots given by the SlotOffset in the single elements of the list;
                                                                 * Timing:
                                                                 * the start time for the whole sequence is given by the timing info of the ASP (common information);
                                                                 * the timing for the respective data pdus is given by the SlotOffset relative to the common timing info;
                                                                 * design consideration:
                                                                 * repetitions of this sequence are not foreseen
                                                                 * (in which case the slot offset could not be related to the timing info of the ASP) */
  type union NR_L2Data_Request_Type {                          /* NOTE: formal type definition to allow later enhancements */
    NR_DRB_DataPerSlotList_DL_Type              SlotDataList,
    NR_DRB_DataPerSlotCoSchedulingList_DL_Type  SlotDataListCoScheduling
  };

  type record of NR_DRB_DataPerSlotCoScheduling_DL_Type NR_DRB_DataPerSlotCoSchedulingList_DL_Type;

  type record NR_DRB_DataPerSlotCoScheduling_DL_Type {
    /* Applied if NR CA and multi-cell scheduling by a single DCI are configured*/
    MacBearerRouting_Type           MacBearerRouting,  /* TTCN provides the id of the cell hosting the physical layer, which the SS shall use to send the data out to the UE. It shall be set in accordance to ScheduledCellList in the DCI format. */
    NR_DRB_DataPerSlotList_DL_Type  SlotDataList
  };

  } // End sub-group Downlink

  //----------------------------------------------------------------------------

  group Uplink {

  type record NR_DRB_DataPerSlot_UL_Type {                      /* common definition for one or several PDUs/SDUs being received in one slot
                                                                 * or to receive one PDCP PDU or SDU being spread over more than one slot (TTI);
                                                                 * NOTE:
                                                                 * There is a fix relation between HARQ process id and slot in UL
                                                                 * => it is not necessary to include HARQ process id for UL data */
    NR_L2DataList_Type          PduSduList,                     /* list of PDUs/SDUs being received in one TTI;
                                                                 * elements of the list appear in the same order as the PDUs/SDUs in the MAC PDU;
                                                                 * for PDCP when a PDU or SDU takes more than one TTI the list only contains this PDU or SDU */
    integer                     NoOfTTIs                        /* in case of PDCP:
                                                                 * number of TTIs the SDU or PDU has taken
                                                                 * NOTE 1: for the time being the NoOfTTIs is not checked by TTCN-3 and may be set to 1 by SS;
                                                                 * NOTE 2: the timing info in common part of the ASP refers to the last TTI
                                                                 * NOTE 3: when NoOfTTIs > 1 => PduSduList shall only contain one PDCP PDU or SDU
                                                                 * in case of MAC or RLC PDUs:
                                                                 * NoOfTTIs shall always be 1 */
  };

  type record NR_L2Data_Indication_Type {                       /* NOTE: formal type definition to allow later enhancements;
                                                                 * L2Data_Indication_Type defines data being received in a single slot
                                                                 * i.e. PDUs of subsequent TTIs are indicated in separated ASPs */
    NR_DRB_DataPerSlot_UL_Type SlotData
  };

  } // End sub-group Uplink

  } // End group DRB_Primitive_Definitions

  //****************************************************************************
  //****************************************************************************

  group System_Interface {

  //****************************************************************************
  // ASP definitions
  //****************************************************************************

  type record NR_DRB_COMMON_REQ {               /* common ASP to send PDUs to DRBs */
    NR_ReqAspCommonPart_Type    Common,         /* CellId : identifier of the cell
                                                 * RoutingInfo : QosFlow when SDAP is configured in non-transparent mode at the SS, else DRB id
                                                 * RlcBearerRouting : TTCN provides the id of the cell hosting the RLC bearer, which the SS shall use to send the data out to the UE (for non-split bearers in general same as CellId)
                                                 * MacBearerRouting :
                                                 *   If NR CA is configured, TTCN provides the id of the cell hosting the physical layer, which the SS shall use to send the data out to the UE.
                                                 *   If NR CA and multi-cell scheduling by a single DCI are configured, TTCN provides the id of the cell hosting the physical layer, which the SS shall use to send the DCI.
                                                 *   Else 'omit'
                                                 * TimingInfo : starting point when to start sending sequence of data PDUs
                                                 *   e.g.
                                                 *     SFN = X, subframe number = x; slot number = slot_i depending on numerology
                                                 *     U_Plane.SubframeDataList[i].SlotOffset := offset_i;
                                                 *   => U_Plane.SubframeDataList[0].PduSduList shall be sent out at (X, x, i)
                                                 *      U_Plane.SubframeDataList[i].PduSduList shall be sent out offset_i slots after U_Plane.SubframeDataList[0].PduSduList (depending on the numerology)
                                                 * NOTE: In case of K0>0 (K0 according to 38.214 clause 5.1.2.1) the timing specifies the PDCCH assignment (rather than the PDSCH transmission)
                                                 * ControlInfo : CnfFlag:=false; FollowOnFlag:=false */
    NR_L2Data_Request_Type      U_Plane,
    Null_Type                   SuppressPdcchForC_RNTI optional /* By default all DRB_COMMON_REQ scheduled DL PDU's are associated with an appropriate explicit configured or SS selected DL assignment allocation on PDCCH.
                                                                 * For SuppressPdcch:=true in the sub frame in which DL PDU's are transmitted, there is no associated DL assignment allocation for configured C-RNTI. This will be used for SPS assignment based transmission or in any error scenarios;
                                                                 * NOTE: this flag has no impact on PDCCH messages required for SPS activation */
  };

  type record NR_DRB_COMMON_IND {               /* common ASP to receive PDUs from DRBs */
    NR_IndAspCommonPart_Type    Common,         /* CellId : identifier of the cell
                                                 * RoutingInfo : QosFlow when SDAP is configured in non-transparent mode at the SS, else DRB id
                                                 * RoutingInfoSUL : The SS shall include this field when data is received from SUL carrier. Else 'omit'.
                                                 * RlcBearerRouting : The SS shall provide the id of the cell hosting the RLC bearer in which the data has been received from the UE
                                                 * MacBearerRouting : If NR CA is configured, the SS shall provide the id of the cell hosting the physical layer in which the data has been received from the UE. Else 'omit'
                                                 * TimingInfo : time when message has been received
                                                 * NOTE 1:
                                                 * For MAC and RLC PDUs per definition L2Data_Indication_Type corresponds to exactly one slot
                                                 * => TimingInfo refers to this slot
                                                 * NOTE 2:
                                                 * For PDCP a single PDU or SDU may take more than one TTI
                                                 * => TimingInfo refers to the end of the PDU/SDU and the length is given by NoOfTTIs in L2Data_Indication_Type
                                                 * (the end of the PDU/SDU is the last RLC PDU being received; in case of retransmissions this is not necessarily the RLC PDU with the last SN) */
    NR_L2Data_Indication_Type   U_Plane
  };

  //****************************************************************************
  // Port definitions
  //****************************************************************************

  type port NR_DRB_PORT message {
    out NR_DRB_COMMON_REQ;
    in  NR_DRB_COMMON_IND;
  };

  // Used in default behaviour
  template (present) NR_DRB_COMMON_IND  cr_NR_DRB_COMMON_IND_Any := ?;         /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  } // End group System_Interface

}
