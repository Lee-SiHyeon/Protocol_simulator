  };

  type Null_Type NR_RoutingInfoSUL_Type;

  type record MacBearerRouting_Type {                 /* Physical layer cell data routing.
                                                         Applicable for NR CA, multi-RAT Dual Connectivity (MR-DC) with NR CA as well as single-RAT Dual Connectivity with NR CA
                                                       */
