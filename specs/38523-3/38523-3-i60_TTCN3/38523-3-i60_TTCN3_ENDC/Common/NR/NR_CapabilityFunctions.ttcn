         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD UE-NR-Capabilities IEs are inconsistent with pc_logicalChannelSR_DelayTimer Single Mode");  // Fail case on Single Mode
      }
      else if(f_NR_DualModeCheck()) // case dual mode
