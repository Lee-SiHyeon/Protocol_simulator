module IMS_IRAT_19_GERAN {

  import from CommonIratDefs all;
  import from GERAN_CommonFunctions all;
  import from GERAN_Component all;
  import from GERAN_Templates all;
  import from IMS_IRAT_CSFB_GERAN all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.1.3
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_1_3_GERAN() runs on GERAN_PTC
  { /* Emergency call with emergency registration / Abnormal case / IM CN sends a 380 / UE performs emergency call via CS domain */
    var template ServCategory v_ServCategory := cr_ServCategory(cr_EmergServCat_non_eCall) ifpresent;
    f_IMS_CSFB_GERAN_Body (-, v_ServCategory); // @sic R5-150700, R5-185087 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2_GERAN() runs on GERAN_PTC
  { /* Non-UE detectable emergency call / IM CN sends 380 Alternative Service / Non-emergency IMS registration */
    f_IMS_CSFB_GERAN_Body (); // @sic R5-150699 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2b
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2b_GERAN() runs on GERAN_PTC
  { /* Non-UE detectable emergency call / IM CN sends a 380 with unavailable emergency service URN / UE performs normal call via CS domain / UTRAN or GERAN */
    
    f_IMS_CSFB_GERAN_Init();  // @sic R5s160070 sic@

    f_GERAN_TestBody_Set(true);
    
    f_GERAN_SetCellPowerLevel(geran_Cell24, tsc_GERAN_ServingCell);
    f_GERAN_SetChPwrLevel(geran_Cell24, tsc_TchCh, tsc_GERAN_ServingCell);
    
    //@siclog "Step 5b1 - 5b3" siclog@
    f_GERAN_CSFB_Redirection_CCO_M0(geran_Cell24); // new in 19_3_2b
    
    f_GERAN_TestBody_Set(false);
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_Trigger);     // Tell EUTRA test is over
    
    //Perform postamble
    f_GERAN_Postamble(geran_Cell24, G1_IDLE, -, -, tsc_TCH_F);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 19.3.2c
   * @status    APPROVED (IMS_IRAT)
   */
  function f_TC_19_3_2c_GERAN() runs on GERAN_PTC
  { /* Non-UE detectable emergency call / IM CN sends a 380 with available emergency service URN / UE performs CS Emergency call via CS domain / UTRAN or GERAN */
    f_IMS_CSFB_GERAN_Body(); // @sic R5-150699 sic@
  }

}
