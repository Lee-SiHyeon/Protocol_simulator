  { // MTSI MO Video Call / SCM / 0% access probability skip for MTSI MO speech call
    /* @sic R5-153959: TC renamed sic@ */
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Response183;
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4();
    
    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);  /* @sic R5w140112 sic@ */
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO call Table 4.5A.6.3-1 Step 12-15
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);       // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_IMS_TestBody_Set(false);
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.4a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_4a_IMS1() runs on IMS_PTC
  { // MTSI MO speech Call / SCM / 0% access probability skip for MTSI MO speech call / AC-Barring per PLMN
    // same behaviour on IMS
    f_TC_13_5_4_IMS1();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.5
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_5_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call / SCM / 0% access probability skip for MTSI MO video call
    /* @sic R5-153960: TC renamed sic@ */
    
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @siclog "Step 6 - 18" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall);
    
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp);
    
    // See TS. 36.508 EUTRA/EPS signalling for IMS MO video call Table 4.5A.8.3-1 Step 12-15
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);       // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer
    
    f_IMS_MOCallSetup_AnnexC25_Steps5_13(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    // @siclog "Step 20 - 22" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);  // @sic R5-250461 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_TestBody_Set(false);

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.5a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_5a_IMS1() runs on IMS_PTC
  { // MTSI MO Video Call / SCM / 0% access probability skip for MTSI MO video call / AC-Barring per PLMN
    f_TC_13_5_5_IMS1();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.6
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_6_IMS1() runs on IMS_PTC
  { // MTSI MO SMS / SCM / 0% access probability skip for MTSI MO SMS over IP
    var IMS_DATA_REQ v_IMS_DATA_REQ;

    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @siclog "Step 12" siclog@
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_IMS_DATA_REQ := f_IMS_MO_SMS_Step1 ();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);       // trigger IPCAN to continue with activation of secondary PDP context or dedicated EPS bearer

    // @siclog "Step 17 - 18" siclog@
    f_IMS_MO_SMS_Step2to8 (v_IMS_DATA_REQ);
    
    f_IMS_TestBody_Set(false);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.6a
   * @status    APPROVED (LTE_A_R12)
   */
  function f_TC_13_5_6a_IMS1() runs on IMS_PTC
  { // MTSI MO SMS / SCM / 0% access probability skip for MTSI MO SMS over IP / AC-Barring per PLMN
    f_TC_13_5_6_IMS1();
  }

}
