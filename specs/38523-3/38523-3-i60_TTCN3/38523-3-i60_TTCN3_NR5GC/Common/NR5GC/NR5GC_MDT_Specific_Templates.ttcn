   /*
   * @desc      Verifies location coordinate
   * @param     p_LocationCoordinate
   * @return    boolean
   * @status    APPROVED (NR5GC)
   */
    function f_NR_VerifyLocationCoordinate_r16 ( CommonLocationInfo_r16.locationCoordinate_r16 p_LocationCoordinate) return boolean
    {
       var bitstring v_ReceivedLocCoord;
       var LocationCoordinates v_LocCoord;
       var boolean v_Match := false;
       
       v_ReceivedLocCoord := oct2bit(p_LocationCoordinate);
       if(decvalue(v_ReceivedLocCoord,v_LocCoord)== 0)
        {
            v_Match := true;
        }
        return v_Match;
    }

}
