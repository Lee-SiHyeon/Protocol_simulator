module IMS_Procedures_5G {

  import from IMS_ASP_Templates all;
  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_SDP_Messages all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      34.229-5 A.4.1a/2a Step 1: Receive INVITE
   * @param     p_WithPreconditions
   * @param     p_OtherCalleeUri    (default value: omit)
   * @param     p_OriginatingIdentificationRestriction (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_X_Step1(boolean p_WithPreconditions,
                                               template SipUrl p_OtherCalleeUri := omit,
                                               boolean p_OriginatingIdentificationRestriction := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    /* @sic R5-246482, R5-246478, R5-246479: p_EvsConfiguration removed sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_ReceiveINVITE_Common(p_OtherCalleeUri, -, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, p_WithPreconditions, p_OriginatingIdentificationRestriction);
    f_IMS_SDP_CheckMediaDescr_EVS_Configuration(v_InviteRequestWithSdp.SdpOffer.media_list[0], EVS_A2);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.4.1a Step 1: Receive INVITE with preconditions; wrapper function
   * @param     p_OtherCalleeUri    (default value: omit)
   * @param     p_OriginatingIdentificationRestriction (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(template SipUrl p_OtherCalleeUri := omit,
                                                boolean p_OriginatingIdentificationRestriction := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    return f_IMS_MOCallSetup_NR5GC_A_4_X_Step1(tsc_SDP_WithPreconditions, p_OtherCalleeUri, p_OriginatingIdentificationRestriction);
  }

  /*
   * @desc      34.229-5 A.4.1a/2a Step 3 - 5: Send 183 Session Progress, receive PRACK, send 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUriSS      (default value: px_IMS_CalleeContactUri)
   * @param     p_AditionalContactParams (default value: omit)
   * @param     p_Allow             (default value: omit)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @param     p_BandwidthAS       (default value: 65)
   * @param     p_WithPreconditions
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 charstring p_ContactUriSS := px_IMS_CalleeContactUri,
                                                 template (omit) SemicolonParam_List p_AditionalContactParams := omit,
                                                 template (omit) Allow p_Allow := omit,
                                                 IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000,
                                                 integer p_BandwidthAS := 65,
                                                 boolean p_WithPreconditions) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-246478, R5-246479: p_EvsConfiguration removed sic@ */
    var template (value) SDP_Message v_SDP_Message183 := f_IMS_BuildSDP_InitialAnswerAudio_TX(p_InviteRequestWithSdp.SdpOffer, p_WithPreconditions, p_AudioCodec, EVS_A2, p_BandwidthAS);
    var OptionTag_List v_OptionTagsForRequire := tsc_OptionTagList_100rel;
    var template (value) MessageHeader v_MessageHeader_Response183;

    if (p_WithPreconditions) {
      v_OptionTagsForRequire := v_OptionTagsForRequire & tsc_OptionTagList_precondition;
    }
    
    v_MessageHeader_Response183 := f_IMS_InviteResponse_183_MessageHeaderTX(p_InviteRequestWithSdp.Invite, p_ContactUriSS, p_AditionalContactParams, v_OptionTagsForRequire, p_CallType);
    v_MessageHeader_Response183.allow := p_Allow;
    return f_IMS_MOCallSetup_Send18X_Reliable(p_InviteRequestWithSdp, c_statusLine183, v_MessageHeader_Response183, v_SDP_Message183, p_CallType); /* @sic R5-213531, R5-214884: p_CallType sic@ */
  }

  /*
   * @desc      34.229-5 A.4.1a Step 2 - 5: Send 100 Trying, send 183 Session Progress, receive PRACK, send 200 OK
   *            returns MessageHeader of 183 response
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUriSS      (default value: px_IMS_CalleeContactUri)
   * @param     p_Allow             (default value: omit)
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  charstring p_ContactUriSS := px_IMS_CalleeContactUri,
                                                  template (omit) Allow p_Allow := omit) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  {
    f_IMS_MOCallSetup_Send100Trying(p_InviteRequestWithSdp);
    return f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(p_InviteRequestWithSdp, p_ContactUriSS, -, p_Allow, -, EVS_16000, -, tsc_SDP_WithPreconditions);
  }

  /*
   * @desc      34.229-5 A.4.1a Step 6 - 7: Receive UPDATE, send 200 OK
   *            returns the SDP offer which has been contained in the UPDATE
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUri        (default value: px_IMS_CalleeContactUri)
   * @param     p_GeolocationInfoAvailable (default value: false)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @param     p_PreconditionIndication (default value: PreconditionRequired)
   * @return    SDP_Message
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  charstring p_ContactUri := px_IMS_CalleeContactUri,
                                                  boolean p_GeolocationInfoAvailable := false,
                                                  IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                  IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000,
                                                  IMS_PreconditionIndication_Type p_PreconditionIndication := PreconditionRequired) runs on IMS_PTC return SDP_Message
  { /* @sic R5-246478: p_EvsConfiguration removed sic@ */
    var template (present) SDP_Message v_ExpectedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(p_InviteRequestWithSdp.SdpOffer, -, p_AudioCodec, EVS_A2);  /* @sic R5s210392, R5s210397, R5-213523: no a=sendrecv sic@ */
    var SDP_Message v_ReceivedSdpOffer := f_IMS_MOCallSetup_ReceiveUpdateSend200OK(p_InviteRequestWithSdp.Invite, p_ContactUri, v_ExpectedSdpOffer, p_GeolocationInfoAvailable, p_CallType, p_PreconditionIndication);

    return v_ReceivedSdpOffer;
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 1: Send INVITE
   * @param     p_WithPreconditions (default value: false)
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(boolean p_WithPreconditions := false,
                                               IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-231489: p_EvsConfiguration (A2 is the default configuration) sic@ */
    /* @sic R5-246480, R5-246481: p_EvsConfiguration removed sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_IMS_MTCallSetup_BuildInviteRequestWithSdp(p_AudioCodecList, EVS_A2, p_WithPreconditions);

    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequestWithSdp.Invite));

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 1: Receive 100 Trying and 183 Session Progress
   * @param     p_InviteRequestWithSdp
   * @param     p_WithPreconditions
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 boolean p_WithPreconditions,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-230323: p_EvsConfiguration sic@ */
    /* @sic R5-246480, R5-246481: p_EvsConfiguration removed, f_IMS_CheckNoPreconditions removed as in A.5.2a precondition attributes and precondition option tag are not checked to be not present sic@ */
    var INVITE_Request v_InviteRequest := p_InviteRequestWithSdp.Invite;
    var InternetProtocol_Type v_Protocol := p_InviteRequestWithSdp.RoutingInfo.Protocol;
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_RX(p_AudioCodec, EVS_A2, p_WithPreconditions);

    return f_IMS_MTCallSetup_Receive100Trying_Receive183SessionProgress(v_InviteRequest, v_SdpAnswer, v_Protocol, p_WithPreconditions);   /* @sic R5s210334: p_WithPreconditions sic@ */
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 2 - 5
   * @param     p_InviteRequestWithSdp
   * @param     p_WithPreconditions
   * @return    IMS_ResponseWithSdp_Type
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @status    APPROVED (IMS, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 boolean p_WithPreconditions,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-246480, R5-246481: p_EvsConfiguration removed sic@ */
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(p_InviteRequestWithSdp, p_WithPreconditions, p_AudioCodec);
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(p_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    return v_ResponseWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a Step 6 - 7: Send UPDATE with preconditions, receive 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_SessionProgress183
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @status    APPROVED (IMS, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_1a_Step6_7(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  IMS_ResponseWithSdp_Type p_SessionProgress183,
                                                  IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC
  {
    var SDP_Message v_SDP_Message183 := p_SessionProgress183.SdpMessage;
    var template (value) SDP_Message v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_TX(v_SDP_Message183, p_AudioCodec);
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_FinalAnswerAudio_RX(p_AudioCodec);
    
    f_IMS_MTCallSetup_SendUPDATE_Receive200OK(p_InviteRequestWithSdp, v_SdpOffer, v_SdpAnswer);
  }

  /*
   * @desc      34.229-5 A.5.2 Step 8A - 10: Accept call, receive 200 OK and send ACK
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (IMS, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_AcceptAndAcknowledge(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on IMS_PTC
  {
    f_UT_AnswerCall(MMI);                       // @sic R5-210056 sic@
    f_IMS_MTCallSetup_Receive200OK_SendACK(p_InviteRequestWithSdp);
  }

}
