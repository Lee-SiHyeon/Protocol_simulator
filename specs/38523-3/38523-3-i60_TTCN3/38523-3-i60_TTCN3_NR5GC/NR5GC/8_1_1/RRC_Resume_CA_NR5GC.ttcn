module RRC_Resume_CA_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_CommonFunctions_CA all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions_CA all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_DCI_Configuration all;
  import from NR_FrequencyCommon all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.4.4
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_1_1_4_4_NR5GC() runs on NR5GC_PTC
  {
    //RRC resume / Suspend-Resume / RRC reconfiguration / Active MCG SCell addition / Intra-band Contiguous CA
    f_TC_8_1_1_4_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.4.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_4_5_NR5GC() runs on NR5GC_PTC
  {
    //RRC resume / Suspend-Resume / RRC reconfiguration / Active MCG SCell addition / Intra-band non-Contiguous CA
    f_TC_8_1_1_4_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandNonContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.4.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_4_6_NR5GC() runs on NR5GC_PTC
  {
    //RRC resume / Suspend-Resume / RRC reconfiguration / Active MCG SCell addition / Inter-band CA
    f_TC_8_1_1_4_x_NR_Common(nr_Cell1, nr_Cell10, CA_InterBand);
  }

  /*
   * @desc      Common TC function for 8.1.1.4.4/5/6
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_NR_CA_Tested
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_1_1_4_x_NR_Common (NR_CellId_Type  p_PCell,
                                      NR_CellId_Type  p_SCell,
                                      NR_CA_Tested_Type p_NR_CA_Tested) runs on NR5GC_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0 :={ cs_NR_CellPower(p_SCell, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2 )};
    f_NR5GC_Init_CA(NR_1, {p_PCell, p_SCell}, p_NR_CA_Tested);
  
    // Create and configure cell
    f_NR_CellConfig_PCell_Def(p_PCell);
    f_NR_CellConfig_SCell(p_SCell, Scell_Active);

    // Preamble: according to TS 38.508-1, clause 4.4A.2 Table 4.4A.2-2
    f_NR5GC_Preamble (p_PCell, STATE_INACTIVE_2A, PING_Or_TEST_LOOPModeB_ON);//@sic R5-244450 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    f_NR_TestBody_Set(true);
    f_TC_8_1_1_4_x_NR5GC_TestBody(p_PCell, p_SCell);
    f_NR_TestBody_Set(false);
    
    //Switch/Power off UE
    f_NR_Postamble(p_PCell, STATE_CONNECTED_3A);
  }

  /*
   * @desc      Common test body function for 8.1.1.4.4/5/6
   * @param     p_PCell
   * @param     p_SCell
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_4_x_NR5GC_TestBody(NR_CellId_Type     p_PCell,
                                         NR_CellId_Type     p_SCell) runs on NR5GC_PTC
  {
    var template (value) CellGroupConfig v_SCGConfigCA := f_NR_GetSCGConfig_SCellAdd(p_SCell, tsc_NR_SCellIndex_1, -, -, -, -, activated);
    var template (value) CellGroupConfig v_CellGroupConfig;
    var SubFrameTiming_Type v_TimingInfo2;
    var SubFrameTiming_Type v_TimingInfo;
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_PCell); //@sic R5s240575 sic@

    //Prepare variables
    //@sic R5s240525 sic@
    v_CellGroupConfig := f_NR_GetSCGConfigResume(p_PCell);                              // condition RESUME
    v_CellGroupConfig.sCellToAddModList  := v_SCGConfigCA.sCellToAddModList;            // condition SCell_Add
    
    //@siclog "Step 1" siclog@
    //The SS transmits a Paging message including a matched identity (correct fullI-RNTI).
    f_NR_Paging_Def(p_PCell, RRC_INACTIVE);

    //@siclog "Step 2" siclog@
    //The UE transmits an RRCResumeRequest message.
    f_NR_RRC_ResumeRequest_Def(p_PCell);

    //Configure SS with CA
    v_TimingInfo := f_NR_GetNextSendOccasion_DL(p_PCell);
    v_TimingInfo2 := f_SubFrameTiming_AddMilliSeconds(v_TimingInfo, 5);
    f_NR_ConfigPCell_AddRelSCells (p_PCell, {p_SCell}, tsc_PCellIndex_0, cs_TimingInfo_NR(v_TimingInfo2), f_NR_CellInfo_GetRNTI(p_PCell));
    f_NR_ConfigSCell(p_SCell,v_CellGroupConfig, cs_TimingInfo_NR(v_TimingInfo2));

    //@siclog "Step 3" siclog@
    //The SS transmits an RRCResume message
    f_NR_SendRRCResume_Def(p_PCell, cs_TimingInfo_NR(v_TimingInfo), -, v_CellGroupConfig,-,-,-,crs_MacBearerRouting(p_PCell)); //@sic R5s240575 sic@

    //@siclog "Step 4" siclog@
    //Check: Does the UE transmit an RRCResumeComplete message?
    SRB.receive(car_NR_SRB1_RrcPdu_IND(p_PCell, cr_38508_RRCResumeComplete,-,crs_MacBearerRouting(p_PCell)));//@sic R5s240575 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    f_NR_SS_ReconfigSStoUSS_DCI1_1(nr_Cell1);//@sic R5s240575 sic@
    f_NR_SS_CommonCellConfig(p_PCell, cas_NR_SearchSpaceDlDciAssignment_REQ(p_PCell, cs_TimingInfo_Now, f_NR_SearchSpaceDlDciAssignment_USS(v_NR_PhysicalParameters)));//@sic R5s240575 sic@

    //@siclog "Step 5" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB1 and SCell?
    f_NR5GC_CheckDataPath_CA(p_PCell, p_SCell, "Step 5", false );  //@sic R5s240525 sic@

    //@siclog "Steps 5-6" siclog@
    //@sic R5-244450 sic@
    //The SS transmits an RRCReconfigurationmessage containing an sCellToReleaseList with SCell NR Cell 3.
    //The UE transmit an RRCReconfigurationComplete message?
    f_NR5GC_Rel_1SCell(p_PCell, p_SCell);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");

  }

}
