module RRC_CarrierAggregation_ENDC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit_ENDC all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_CA all;
  import from NR_CommonFunctions_ENDC all;
  import from NR_CommonFunctions_ENDC_CA all;
  import from NR_Component_Base all;
  import from NR_Component_ENDC all;
  import from NR_ConfigurationSteps all;
  import from NR_FrequencyCommon all;
  import from NR_HandoverCommonFunctions all;
  import from NR_Handover_ENDC all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;

  template (value) PDCCH_Config.tpc_SRS cs_PDCCH_TPC_SRS1 :=
  { /* @status    APPROVED (ENDC) */
    //@sic R5-201098 sic@
    setup := {
        startingBitOfFormat2_3  := 1,
        fieldTypeFormat2_3  := 1,
        startingBitOfFormat2_3SUL := omit         /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_1_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Intra-band Contiguous CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell3, CA_IntraBandContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_2_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Intra-band non-Contiguous CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell3, CA_IntraBandNonContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_3_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Inter-band CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell10, CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.4.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_4_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Intra-band Contiguous CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell3, CA_IntraBandContiguous, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.5.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_5_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Intra-band non-Contiguous CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell3, CA_IntraBandNonContiguous, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.6.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_1_1_6_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / NR SCell addition / modification / release / Success / EN-DC / Active SCG SCell addition / Inter-band CA
    f_TC_8_2_4_1_1_x_NR_Common ( nr_Cell1, nr_Cell10, CA_InterBand, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.1.1.x
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_NR_CA_Tested
   * @param     p_SCellState        (default value: omit)
   * @status    APPROVED (ENDC)
   */
   function f_TC_8_2_4_1_1_x_NR_Common(NR_CellId_Type  p_PSCell,
                                       NR_CellId_Type  p_SCell,
                                       NR_CA_Tested_Type p_NR_CA_Tested,
                                       template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                       ) runs on ENDC_NR_PTC
  {
    f_ENDC_NR_Init_CA(p_NR_CA_Tested, {p_PSCell, p_SCell});
    
    //Create and configure NR cell1s
    f_NR_CellConfig_PCell_Def(p_PSCell);
    f_NR_CellConfig_SCell(p_SCell);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(p_PSCell, MCG_SCG);
    f_NR_SetCellPower(p_SCell, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_4_1_1_x_ENDC_NR_TestBody (p_PSCell, p_SCell, p_SCellState);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_4_1_1_x_ENDC_NR
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_SCellState        (default value: omit)
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_4_1_1_x_ENDC_NR_TestBody(NR_CellId_Type  p_PSCell,
                                              NR_CellId_Type  p_SCell,
                                              template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                              ) runs on NR_BASE_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) BWP_DownlinkDedicated v_BWP_DownlinkDedicated;
    var SearchSpace v_SearchSpaceUSS := f_NR_CellInfo_GetSearchSpaceConfigAtUE(p_SCell, tsc_NR_SearchSpaceId_USS, tsc_NR_BWP_Id);
    var template (value) ServingCellConfig v_ServingCellConfig;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_SCell, tsc_NR_BWP_Id);
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_PSCell); //@sic R5s201387 sic@
    var boolean v_ActivateSCell := true;
    
    //@siclog "Steps 1 - 2" siclog@
    f_NR_AddMod_1SCell_ENDC(p_PSCell, p_SCell, -, -, -, -, -, -, -, p_SCellState);

    //@siclog "Step 2A" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.1-1A indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 3?
    //@sic R5-203666 sic@
    if (isvalue(p_SCellState)) {
        if (valueof(p_SCellState) == activated) {
            v_ActivateSCell := false; //SCell shall be activated without MAC CE indication
        }
    }
    f_NR_CheckDataPath_CA(p_PSCell, p_SCell, "2A", v_ActivateSCell,tsc_NR_SCellIndex_2);

    //@siclog "Steps 3 - 4" siclog@
    //The SS transmits a RRCConnectionReconfiguration message including NR RRCReconfiguration message to modify the startingBitOfFormat2-3 of the NR SCell
    v_BWP_DownlinkDedicated:= cs_38508_BWP_DownlinkDedicated(cs_38508_PDCCH_Config (v_SearchSpaceUSS, cs_PDCCH_TPC_SRS1),
                                                             v_NR_DownlinkBWP.Pdsch.ConfigDedicated.R15,
                                                             -,
                                                             omit); //@sic R5s220214 R5-221449 sic@
    v_ServingCellConfig :=  cs_NR_ServingCellConfigDef(v_BWP_DownlinkDedicated,
                                                       omit,  //@sic R5s2106184 sic@
                                                       tsc_NR_BWP_Id,
                                                       omit,                 //UplinkConfig
                                                       cs_NR_Pdcch_ServingCellConfigSetup(cs_38508_PDCCH_ServingCellConfig),
                                                       cs_NR_Pdsch_ServingCellConfigSetup(cs_38508_PDSCH_ServingCellConfig));
    v_SCGConfig := cs_38508_CellGroupConfig(v_CellGroupId,
                                            omit,  //p_RLC_Bearer_Config
                                            omit,  //RLC_BearerToRelease
                                            omit,  //MAC_CellGroupConfig
                                            omit,  //PhysicalCellGroupConfig
                                            omit,  //SpCellConfig
                                            {cs_SCellConfig_Def(omit, v_ServingCellConfig, tsc_NR_SCellIndex_2)});
    f_NR_SendRRCReconfigurationContentsToEUTRA(omit, v_SCGConfig);
    //Nothing to do in SS as SRS is an uplink configuration

    //@siclog "Step 4A" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.1-1A indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 3?
    //@sic R5-203666 sic@
    f_NR_CheckDataPath_CA(p_PSCell, p_SCell, "4A", false,tsc_NR_SCellIndex_2);

    //@siclog "Steps 5 - 6" siclog@
    f_NR_Release_1SCell_ENDC(p_PSCell, p_SCell, tsc_NR_SCellIndex_2);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_1_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Intra-band Contiguous CA
    f_TC_8_2_4_2_1_x_NR_Common ( nr_Cell1, nr_Cell2, nr_Cell3, nr_Cell12, CA_IntraBandContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_2_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Intra-band non-Contiguous CA
    f_TC_8_2_4_2_1_x_NR_Common ( nr_Cell1, nr_Cell2, nr_Cell3, nr_Cell12, CA_IntraBandNonContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_4_2_1_3_ENDC_NR() runs on ENDC_NR_PTC
  { //NR CA / Simultaneous PSCell and SCell addition / PSCell and SCell change / CA Release / EN-DC / Inter-band CA
    f_TC_8_2_4_2_1_x_NR_Common ( nr_Cell1, nr_Cell2, nr_Cell10, nr_Cell30, CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.4.2.1.x
   * @param     p_PSCell1
   * @param     p_PSCell2
   * @param     p_SCell1
   * @param     p_SCell2
   * @param     p_NR_CA_Tested
   * @status    APPROVED (ENDC)
   */
   function f_TC_8_2_4_2_1_x_NR_Common(NR_CellId_Type  p_PSCell1,
                                       NR_CellId_Type  p_PSCell2,
                                       NR_CellId_Type  p_SCell1,
                                       NR_CellId_Type  p_SCell2,
                                       NR_CA_Tested_Type p_NR_CA_Tested) runs on ENDC_NR_PTC
  {
    f_ENDC_NR_Init_CA(p_NR_CA_Tested, {p_PSCell1, p_PSCell2, p_SCell1, p_SCell2});
    
    //Create and configure NR cell1s
    f_NR_CellConfig_PCell_Def(p_PSCell1);
    f_NR_CellConfig_PCell_Def(p_PSCell2);
    f_NR_CellConfig_SCell(p_SCell1);
    f_NR_CellConfig_PCell_Def(p_SCell2);  //@sic R5s221199 change 2.1 sic@
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(p_PSCell1, MCG_Only);
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_4_2_1_x_ENDC_NR_TestBody (p_PSCell1, p_PSCell2, p_SCell1, p_SCell2);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_4_2_1_x_ENDC_NR
   * @param     p_PSCell1
   * @param     p_PSCell2
   * @param     p_SCell1
   * @param     p_SCell2
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_4_2_1_x_ENDC_NR_TestBody(NR_CellId_Type  p_PSCell1,
                                              NR_CellId_Type  p_PSCell2,
                                              NR_CellId_Type  p_SCell1,
                                              NR_CellId_Type  p_SCell2) runs on ENDC_NR_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) CellGroupConfig v_SCGConfig := f_NR_GetSCGConfigDef(p_PSCell2);
    var template (value) CellGroupConfig v_SCGConfig_SCell := f_NR_GetSCGConfig_SCellAdd(p_SCell2, 2);
    var template (value) RadioBearerConfig v_RadioBearerConfig := cs_NR_RadioBearer(tsc_NR_DRB2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get());
    var template (value) NR_RadioBearerList_Type v_RadioBearerToReleaseList := {cs_NR_SS_DRB_Release(tsc_NR_DRB2)};
    var template (value) NR_RadioBearerList_Type v_RadioBearerList := {f_NR_GetRadioBearerConfig_FullAM_DRB2(p_PSCell2)};

    v_CellPowerList_AtT0 := {cs_NR_CellPower(p_PSCell1, -88, -91),
                             cs_NR_CellPower(p_SCell1, -88, -91)};
    v_CellPowerList_AtT1 := {cs_NR_CellPower(p_PSCell2, -88, -91),
                             cs_NR_CellPower(p_SCell2, -88, -91)};

    // @siclog "Step 1" siclog@
    //The SS changes Cell parameters according to the row "T0" in table 8.2.4.2.1.1.3.2-1.
    // Send trigger to NR to change power level of NR Cell1
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT0);

    //@siclog "Steps 2 - 3" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to configure NR Cell 1 as the NR PSCell and sCellToAddModList with an sCellIndex set to NR Cell 3 as the configured SCell.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message?
    f_NR_AddMod_PSCell_SCell_ENDC( p_PSCell1, p_SCell1 );
    //@sic R5s221199 R5s221141 sic@

    //@siclog "Step 3A" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.1-1A indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 3?
    //@sic R5-203666 sic@
    f_NR_CheckDataPath_CA(p_PSCell1, p_SCell1, "3A", true,tsc_NR_SCellIndex_2);
    
    //@siclog "Step 4" siclog@
    //The SS changes NR Cell 2 and NR Cell 12 parameters according to the row "T1" in table 8.2.4.2.1.1.3.2-1.
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT1);
        
    //@siclog "Steps 5 - 6" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to perform both NR Cell 1 and NR Cell 3 changed to the configured target NR Cell 2 and NR Cell 12.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message configuring the new PSCell and SCell and configure lower layers to consider the SCell to be in deactivated state?
    //@sic R5s220809 sic@
    f_NR_CellInfo_SetRNTI(p_PSCell2, tsc_C_RNTI_Value3);  //@sic R5s221199 R5s221141 sic@
    v_SCGConfig := f_NR_GetSCGConfigDef(p_PSCell2);
    v_SCGConfig.sCellToAddModList := v_SCGConfig_SCell.sCellToAddModList;
    v_SCGConfig.rlc_BearerToAddModList[0].reestablishRLC := true_;
    v_SCGConfig.sCellToReleaseList[0] := tsc_NR_SCellIndex_2;
    v_SCGConfig.spCellConfig.reconfigurationWithSync.newUE_Identity := tsc_C_RNTI_Value3;   //@sic R5s230131 sic@
    v_RadioBearerConfig := f_NR_RetrieveRadioBearerConfig_PSCellChange( false, -, secondary);  //@sic R5s220809 R5s230131 sic@
    f_NR_RRC_PSCellChangeCA_InterCell(p_PSCell1, p_SCell1, p_PSCell2, p_SCell2, false, v_RadioBearerConfig, v_SCGConfig, v_RadioBearerToReleaseList);
    
    //@siclog "Step 6A" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.1-1A indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 12?
    //@sic R5-203666 sic@
    f_NR_CheckDataPath_CA(p_PSCell2, p_SCell2, "6A", true, tsc_NR_SCellIndex_2);

    //@siclog "Steps 7 - 8" siclog@
    //The SS transmits an RRCConnectionReconfiguration message with nr-Config IE including NR RRCReconfiguration message to change the current PSCell (NR Cell 2) to NR Cell 12 equaling to one of the current UE SCell configuration.
    //Check: Does the UE send an RRCConnectionReconfigurationComplete message and reconfigure the current NR SCell to PSCell?
    //@sic R5s220809 sic@
    v_SCGConfig := f_NR_GetSCGConfigDef(p_SCell2);
    v_SCGConfig_SCell := f_NR_GetSCGConfigDef(p_PSCell2);
    v_SCGConfig.rlc_BearerToAddModList[0].reestablishRLC := true_;
    v_SCGConfig.sCellToAddModList := v_SCGConfig_SCell.sCellToAddModList;
    v_SCGConfig.sCellToReleaseList[0] := tsc_NR_SCellIndex_2;
    f_NR_ReconfigSCellToNormalCell(p_SCell2, v_RadioBearerList);
    f_NR_RRC_PSCellChangeCA_InterCell(p_PSCell2, p_SCell2, p_SCell2, omit, false, v_RadioBearerConfig, v_SCGConfig, v_RadioBearerToReleaseList);
    //@sic R5s221199 sic@
  }

  /*
   * @desc  PSCell change procedure with CA - As per 38.523-3 cl 7.2.6.4 Sequence of EN-DC NR CA inter-cell PSCell change
   * @param     p_SourcePSCellId
   * @param     p_SourceSCellId
   * @param     p_TargetPSCellId
   * @param     p_TargetSCellId
   * @param     p_RBConfig_KeyChange (default value: true)
   * @param     p_RadioBearerConfig
   * @param     p_SCGConfig
   * @param     p_RadioBearerToReleaseList
   * @status    APPROVED (ENDC)
   */
    function f_NR_RRC_PSCellChangeCA_InterCell(NR_CellId_Type                       p_SourcePSCellId,
                                               NR_CellId_Type                       p_SourceSCellId,
                                               NR_CellId_Type                       p_TargetPSCellId,
                                               template (omit) NR_CellId_Type       p_TargetSCellId,
                                               boolean                              p_RBConfig_KeyChange := true,
                                               template (omit) RadioBearerConfig    p_RadioBearerConfig,
                                               template (value) CellGroupConfig     p_SCGConfig,
                                               template (value) NR_RadioBearerList_Type  p_RadioBearerToReleaseList
                                              ) runs on NR_BASE_PTC
  { //@sic R5s230169 p_TargetSCellId updated to template (omit) sic@
    var template (value) NR_RachProcedureConfig_Type v_RachProcedureConfig := f_NR_GetRACHProcedureConfigPSCell( p_TargetPSCellId, -);
    var NR_CellIdList_Type v_SCellList := {};   //@sic R5s230169 sic@

    // Steps 1 to 6
    f_NR_RRC_PSCellChange_InterCell_Steps1To6(p_SourcePSCellId,
                                              p_TargetPSCellId,
                                              -, //tsc_C_RNTI_Value3
                                              p_RBConfig_KeyChange,
                                              false, //p_IsSrb3Configured,
                                              v_RachProcedureConfig );
    //Step 7. NR Target PSCell: Configure Target PSCell as PSCell.
    // NOTE 5:  The FollowOnFlag is set to true in the ASP reconfiguring PSCell.
    if (isvalue (p_TargetSCellId)) {      //@sic R5s230169 sic@
      v_SCellList := {valueof(p_TargetSCellId)};
      //Condition only needed when there is a target SCell
      f_NR_ConfigPCell_AddRelSCells(p_TargetPSCellId, v_SCellList, tsc_PCellIndex_1, cs_TimingInfo_Now, tsc_C_RNTI_Value3, -, tsc_NoCnfReq, tsc_FollowOnFlag );    //@sic R5-206369 R5s230348 sic@
    }

    //Step 8. NR Target SCell: Configure Target SCell as SCell with new PSCell association.
    if (  ispresent(p_SCGConfig.sCellToAddModList) and isvalue(p_TargetSCellId)) {  //@sic R5s220809 change 2 sic@
        // In step 7 there is no SCell
        f_NR_ConfigSCell(valueof(p_TargetSCellId), p_SCGConfig, cs_TimingInfo_Now);
    }
    
    // Step 9. E-UTRA Cell: Send RRCConnectionReconfiguration.
    // Step 10. E-UTRA Cell: Receive RRCConnectionReconfigurationComplete.
    f_NR_SendRRCReconfigurationContentsToEUTRA(p_RadioBearerConfig, p_SCGConfig, -, -, -, reconfigurationWithSync_CheckRACH, p_TargetPSCellId); //@sic R5s221199 R5s230131 sic@
    
    // Step 11. NR Target PSCell: Inform the SS about completion of the PSCell change (e.g. to trigger PDCP STATUS REPORT PDU).
    f_NR_SS_PdcpHandoverCtrl(p_TargetPSCellId, cas_NR_PdcpHandoverComplete_REQ(p_TargetPSCellId));
   
    // Step 12. NR Source PSCell: If source PSCell is not the same as target SCell, Release SRB3 (if necessary) and DRBs, reconfigure the cell as a normal cell.
    if (isvalue (p_TargetSCellId)) {
        if (p_SourcePSCellId != valueof(p_TargetSCellId)) { //@sic R5-204475 sic@
            f_NR_SS_CommonRadioBearerConfig(p_SourcePSCellId, p_RadioBearerToReleaseList);
        }
    }
    
    //Step 13. NR Source SCell: If source SCell is not the same as target SCell or target PSCell, reconfigure the cell as a normal cell
    //NOTE 6:   The FollowOnFlag is set to true in the ASP reconfiguring PSCell
    if (p_SourceSCellId != p_TargetPSCellId) {
        f_NR_Rel_SCell_Common(p_SourcePSCellId, p_SourceSCellId, tsc_PCellIndex_1, -, -, tsc_NoCnfReq, tsc_FollowOnFlag );   //@sic R5-206369 sic@
    }
  }

}
