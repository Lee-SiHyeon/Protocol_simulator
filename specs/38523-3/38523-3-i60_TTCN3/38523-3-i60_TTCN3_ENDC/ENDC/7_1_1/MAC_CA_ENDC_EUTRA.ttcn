module MAC_CA_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_LoopBack all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NR_CoordMsg all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_8_EUTRA_Common() runs on EUTRA_5GS_PTC {
    // UE power headroom reporting / SCell activation / DL pathloss change reporting
    var template (omit) octetstring v_NR_SCGConfig := omit;
    f_EUTRA38_Init_CA(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE into RRC Connected
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_Only, RRC_IDLE);//@sic R5s211385 sic@
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TESTMode_OFF, -, -);//@sic R5s211385 sic@
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
     //@siclog "Steps 1&2" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);
    
   //@siclog "Steps 4-5" siclog@
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);

     //@siclog "Steps 21&22" siclog@
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);

    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s220591 remove f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_8_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //UE power headroom reporting / SCell activation / DL pathloss change reporting/  Intra-band Contiguous CA
    f_TC_7_1_1_3_8_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_8_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //UE power headroom reporting / SCell activation / DL pathloss change reporting/  Inter-band  CA
    f_TC_7_1_1_3_8_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_EUTRA_Common() runs on EUTRA_5GS_PTC {
    // Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer
    var template (omit) octetstring v_NR_SCGConfig := omit;
    f_EUTRA38_Init_CA(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE into RRC Connected
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling);
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    // is this to be done in the preamble and test body is empty ?
     //@siclog "Steps 1&2" siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration( eutra_Cell1, -, -, v_NR_SCGConfig, -, -, omit);
    
     // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Intra-band Contiguous CA
    f_TC_7_1_1_7_1_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Inter-band  CA
    f_TC_7_1_1_7_1_EUTRA_Common ();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Intra-band Non Contiguous CA
    f_TC_7_1_1_7_1_EUTRA_Common ();
  }

}
