  /*
   * @desc      Function that returns Dual Mode or Single Mode set on PICS acc. to pc_nrFDD and pc_nrTDD
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_DualModeCheck () return boolean
  {
    return (pc_nrFDD and pc_nrTDD);
  }

  /*
   * @desc      Function that returns whether one of the three inputs is true. Used in capability check test cases to get whether an optional feature under a Note in the specs is signaled in one its three possible branches.
   * @param     p_Rootfield
   * @param     p_LeftField
   * @param     p_RightField
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_AnyOfThree_SignaledbyUE(boolean p_Rootfield, boolean p_LeftField, boolean p_RightField) return boolean
  { // @sic R5s240547 sic@
    return (p_Rootfield or p_LeftField or p_RightField);
  };

 /*
   * @desc      ShortSN must be supported if pc_shortSN is supported
   * @return    template ShortSN_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Derive_ShortSN() return template ShortSN_Type
  {
    if (pc_shortSN) {
      return supported;
    } else {
      return omit;
    }
  }

