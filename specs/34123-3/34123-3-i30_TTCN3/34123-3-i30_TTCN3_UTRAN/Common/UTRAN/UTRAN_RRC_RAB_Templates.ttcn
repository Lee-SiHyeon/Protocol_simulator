                                                                    integer p_Id := 0  // @sic R5s120671 sic@
                                                                    ) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
    mac_hsQueueId := p_Id,
    mac_dFlowId := p_Id,
    reorderingReleaseTimer := rt50,
    mac_hsWindowSize := mws16,
    mac_d_PDU_SizeInfo_List := {
      {
