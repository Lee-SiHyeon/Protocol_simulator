module UTRAN34_Parameters {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;

  modulepar MaxSimultaneousCCTrCH_Count px_DL_MaxCCTrCH             := 8;               // @desc  Maximum number of Simultaneous CCTrCH for downlink

  modulepar MaxNoBits                   px_DL_MaxCC_TB_Bits         := b163840;         // @desc  Maximum sum of number of bits of all convolutionally coded transport blocks being received at an arbitrary time instant.

  modulepar MaxNoBits                   px_DL_MaxTB_Bits            := b163840;         // @desc  Maximum sum of number of bits of all transport blocks being received at an arbitrary time instant

  modulepar MaxNoBits                   px_DL_MaxTC_TB_Bits         := b163840;         // @desc  Maximum sum of number of bits of all turbo coded transport blocks being received at an arbitrary time instant.

  modulepar MaxNumberOfTF               px_DL_MaxTF                 := tf1024;          // @desc  Maximum number of TF for downlink

  modulepar MaxNumberOfTFC_DL           px_DL_MaxTFS                := tfc1024;         // @desc  Maximum number of TFC in the TFCS for downlink

  modulepar MaxTransportBlocksDL        px_DL_MaxTTI_TB             := tb512;           // @desc  Maximum total number of transport blocks received within TTIs that end within the same 10 ms interval.

  modulepar MaxSimultaneousTransChsDL   px_DL_MaxTrCHs              := e32;             // @desc  Maximum number of simultaneous transport channels for downlink

  modulepar MaximumAM_EntityNumberRLC_Cap px_MaxAM_EntityNumberRLC_Cap := am30;         // @desc  Maximum AM Entity Number for RLC.

  modulepar MaxHcContextSpace           px_MaxHcContextSpace        := by1024;          // @desc  MaxHcContextSpace if RFC 2507 is supported.

  modulepar integer                     px_MaxNoDPCH_PDSCH_Codes    := 8;               // @desc  Part of DL_PhysChCapabilityFDD. INTEGER (1..8 ).

  modulepar MaxNoDPDCH_BitsTransmitted  px_MaxNoDPDCH_BitsTransmitted := b57600;        // @desc  Part of UL_PhysChCapabilityFDD.

  modulepar MaxNoPhysChBitsReceived     px_MaxNoPhysChBitsReceived  := b76800;          // @desc  Part of DL_PhysChCapabilityFDD.

  modulepar MaximumRLC_WindowSize       px_MaxRLC_WindowSize        := mws4095;         // @desc  Maximum RLC window size.

  modulepar PrimaryScramblingCode       px_PriScrmCode              := 100;             // @desc  Primary scrambling code.

  modulepar Tcell                       px_TCellA                   := 256;             // @desc  TCell value for cell A or 1. Except for the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellB                   := 512;             // @desc  TCell value for cell B or 2. Except for the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellC                   := 1536;            // @desc  TCell value for cell C or 3. Except  the  first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellD                   := 321;             // @desc  TCell value for cell D or 4. Except the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellE                   := 833;             // @desc  TCell value for cell E or 5. Except the  first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellF                   := 6577;            // @desc  TCell value for cell F or 6. Except the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellG                   := 7253;            // @desc  TCell value for cell G or 7. Except the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar Tcell                       px_TCellH                   := 4351;            // @desc  TCell value for cell H or 8. Except the first created cell, the value 0 applied in ts_SS_CellCfg.

  modulepar TotalRLC_AM_BufferSize      px_TotalRLC_AM_BufferSize   := kb1000;          // @desc  Total RLC AM buffer size for R99. The values are according to TotalRLC-AM-BufferSize defined in 3GPP TS 25.331

  modulepar UE_OperationMode            px_UE_OpModeDef             := opModeA;         // @desc  Default UE operation mode (either opModeA or opModeC). (For most Ues this corresponds class-A or class-C, and can not be changed by the user).

  modulepar NetworkAssistedGPS_Supported px_UE_PositioningNetworkAssistedGPS_Sup := networkBased;

  modulepar MaxNoBits                   px_UL_MaxCC_TB_Bits         := b163840;         // @desc  Maximum sum of number of bits of all convolutionally coded transport blocks being transmitted at an arbitrary time instant.

  modulepar MaxNoBits                   px_UL_MaxTB_Bits            := b163840;         // @desc  Maximum sum of number of bits of all transport blocks being transmitted at an arbitrary time instant.

  modulepar MaxNoBits                   px_UL_MaxTC_TB_Bits         := b163840;         // @desc  Maximum sum of number of bits of all turbo coded transport blocks being transmitted at an arbitrary time instant.

  modulepar MaxNumberOfTF               px_UL_MaxTF                 := tf1024;          // @desc  Maximum number of TF for uplink.

  modulepar MaxNumberOfTFC_UL           px_UL_MaxTFS                := tfc1024;         // @desc  Maximum number of TFC in the TFCS for uplink.

  modulepar MaxTransportBlocksUL        px_UL_MaxTTI_TB             := tb512;           // @desc  Maximum total number of transport blocks transmitted within TTIs that start at the same time.

  modulepar MaxSimultaneousTransChsUL   px_UL_MaxTrCHs              := e32;             // @desc  Maximum number of simultaneous transport channels for uplink.

  modulepar UL_ScramblingCode           px_UL_ScramblingCode        := 0;               // @desc  UL scrambling code value to be used by UE.

  modulepar boolean                     pc_4C_DBCC12                := false;           // @desc  Setting this ICS means that Dual band carrier combination (1,2) is supported for one or more of the supported 4C-HSDPA Dual band combinations (A-B) in table A.18a.0a.This ICS is set to true if UE supports Dual band Carrier Combination (1,2), (2,2) or (1,3).

  modulepar boolean                     pc_4C_DBCC22                := false;           // @desc  Setting this ICS means that Dual band carrier combination (2,2) is supported for one or more of the supported 4C-HSDPA Dual band combinations (A-B) in table A.18a.0a.

  modulepar boolean                     pc_4C_DBCC31                := false;           // @desc  Setting this ICS means that Dual band carrier combination (3,1) is supported for one or more of the supported 4C-HSDPA Dual band combinations (A-B) in table A.18a.0a.

  modulepar boolean                     pc_DL_TC_FDD                := false;           // @desc  Support for turbo decoding for downlink - FDD

  modulepar boolean                     pc_DL_TC_TDD                := false;           // @desc  Support for turbo decoding for downlink - TDD

  modulepar boolean                     pc_FourCell                 := false;           // @desc  Support of Four cell

  modulepar boolean                     pc_FourCellMIMO             := false;           // @desc  Support of Four cell MIMO

  modulepar HSDSCH_physical_layer_category_ext4 pc_HSDSCH_UE_Category_Extension4_FDD;   // @desc  FDD HS-DSCH physical layer category 4 Multi Cell with/without MIMO extensions

  modulepar HSDSCH_physical_layer_category_ext5 pc_HSDSCH_UE_Category_Extension5_FDD;   // @desc  FDD HS-DSCH physical layer category 5 Multi Cell with/without MIMO extensions

  modulepar boolean                     pc_Loggedmeasurements_Idle_PCH := false;        // @desc  Support of logged measurements in Idle mode and PCH States

  modulepar boolean                     pc_LosslessSRNS_Reloc       := false;           // @desc  Lossless SRNS Relocation is supported

  modulepar boolean                     pc_RFC2507                  := false;           // @desc  IP header compression protocol RFC 2507 is supported

  modulepar boolean                     pc_SupportForSF_512         := false;           // @desc  Downlink support. Part of DL_PhysChCapabilityFDD.

  modulepar boolean                     pc_SupportOfMultiCarrier    := false;           // @desc  Multi carrier supported

  modulepar boolean                     pc_ThreeCell                := false;           // @desc  Support of Three cell

  modulepar boolean                     pc_ThreeCellMIMO            := false;           // @desc  Support of Three cell MIMO

  modulepar boolean                     pc_UEA2_UIA2                := false;           // @desc  Set UEA2/UIA2 to FALSE if not fully IOT tested

  modulepar boolean                     pc_UE_PositioningBasedOTDOA_Sup := false;       // @desc  UE positioning capability: the Based OTDOA is supporting by UE

  modulepar boolean                     pc_UE_PositioningGPS_TimingOfCellFramesSup := false;

  modulepar boolean                     pc_UE_PositioningIPDL_Sup   := false;           // @desc  UE positioning capability: support for IPDL

  modulepar boolean                     pc_UE_PositioningStandaloneLocMethodsSup := false;

  modulepar boolean                     pc_UL_TC_FDD                := false;           // @desc  Support for turbo encoding for uplink - FDD

  modulepar boolean                     pc_UL_TC_TDD                := false;           // @desc  Support for turbo encoding for uplink - TDD

}
