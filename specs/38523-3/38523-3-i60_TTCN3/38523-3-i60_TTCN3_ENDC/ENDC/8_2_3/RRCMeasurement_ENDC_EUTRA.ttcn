   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.5.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_5_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Measurement configuration control and reporting / Event A2 / Measurement of NR PSCell / EN-DC
    
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    f_AdjustCellPowerForTestingFR2();  //@sic R5-195369 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));    //@sic R5s190060 sic@
    
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_3_X_Common_TestBody ("Step 8");
    f_EUTRA_TestBody_Set(false);
    
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Measurement configuration control and reporting / Event A3 / Measurement of Neighbour NR cells / Intra-frequency measurements / EN-DC
    //@sic R5-195365, R5-195366, R5-1999097 sic@
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
     
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    f_AdjustCellPowerForTestingFR2();  //@sic R5-195369 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
   
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_3_6_1_CommonTestBody(false);
    f_EUTRA_TestBody_Set(false);
    
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1a.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1a_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Measurement configuration control and reporting / Event A3 / Measurement of Neighbour NR cell / Inter-frequency measurements / EN-DC
    //@sic R5-199097 sic@
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
     
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    f_AdjustCellPowerForTestingFR2();  //@sic R5-195369 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
   
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_3_6_1_CommonTestBody(true);
    f_EUTRA_TestBody_Set(false);
    
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1b.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1b_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Measurement configuration control and reporting / Event A3 / Measurement of Neighbour NR cell / Inter-band measurements / EN-DC
    //@sic R5-199097 sic@
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
     
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    f_AdjustCellPowerForTestingFR2();  //@sic R5-195369 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
   
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_3_6_1_CommonTestBody(true);
    f_EUTRA_TestBody_Set(false);
    
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_2_3_X_Common
   * @param     p_TestStep
   * @param     p_TransmitRRCReconfig (default value: true)
   * @param     p_ReportsToReceive  (default value: 4)
   * @param     p_IsMeasGapNeeded   (default value: false)
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_X_Common_TestBody(charstring p_TestStep,
                                         boolean p_TransmitRRCReconfig := true,
                                         integer p_ReportsToReceive := 4,
                                         boolean p_IsMeasGapNeeded := false    //@sic R5-199097 sic@
    
   ) runs on EUTRA_5GS_PTC
  {
    var integer v_Counter;
    var default v_DefaultRef;
    
    var float v_Watchdog := 10.0;  // To be used in steps 8/14(8.2.3.7.1)/20(8.2.3.7.1)/11(8.2.3.8.1)
    
    if (p_TransmitRRCReconfig) {
      //@siclog "Step 1-2 (8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)" siclog@
      //The SS transmits an RRCConnectionReconfiguration message including nr Config to setup NR measurements and reporting for event Ax
      //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message?
      if(p_IsMeasGapNeeded)
        {//@sic R5-199097 sic@
            f_EUTRA38_508_ENDC_Reconfiguration_MeasGap(eutra_Cell1);
        }
        else
        {
           f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, Meas_SCGOnly); //@sic R5s190060 sic@
        }
    }
    
    //@siclog "Step 3(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)/9(8.2.3.7.1)/15(8.2.3.7.1)/6(8.2.3.8.1)/12(8.2.3.8.1)" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row:
    //"T1"(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)
    //"T2"(8.2.3.8.1), "T4"(8.2.3.8.1)
    //in table 8.2.3.X.3.2-1/-1A.
    //Send a trigger to NR to change the power
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("ChangePower"));
    
    //@siclog "Steps 4-5(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)/10-11(8.2.3.7.1)/16-17(8.2.3.7.1)/7-8(8.2.3.8.1)/13(8.2.3.8.1)" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message to report event Ax with the measured results?
    v_Counter := 0;
    while(v_Counter< p_ReportsToReceive) {
      a_EUTRA_ReceiveULInformationTransferMRDC(eutra_Cell1);
      v_Counter:= v_Counter + 1;
    }
    
    //Start ignoring Measurement reports
    v_DefaultRef := activate(a_EUTRA_AddDefault_PeriodicalMeasurmentReport(eutra_Cell1,
                                                                           cr_ULInformationTransferMRDC));
    
    //@siclog "Step 6(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)/9(8.2.3.8.1)"/14(8.2.3.8.1)/24(8.2.3.8.1)/ siclog@
    //SS re-adjusts the cell-specific reference signal level according to row
    //"T2" 8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)
    //"T3"(8.2.3.8.1), "T5"(8.2.3.8.1) and "T9"(8.2.3.8.1)
    //in table 8.2.3.X.3.2-1/-1A.
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
    
    //@siclog "Step 7(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)/10(8.2.3.8.1)/15(8.2.3.8.1)" siclog@
    //Wait and ignore MeasurementReport messages for 15 s to allow change of power levels for NR Cell and UE measurement.
    f_Delay(15.0);
    //Deactivate the default to stop receiving periodical Measurement Report
    deactivate(v_DefaultRef);
    
    //@siclog "Step 8(8.2.3.4.1, 8.2.3.5.1, 8.2.3.7.1)/11(8.2.3.8.1)/16(8.2.3.8.1)" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message, with the measured [Results] value for NR Cell 1 within the next 10s?
    f_EUTRA38_ENDC_CheckForNoULInformationTransferMRDC(p_TestStep, eutra_Cell1, v_Watchdog )
    
  }

  /*
   * @desc      test body of TC_8_2_3_4_1
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_4_1_TestBody() runs on EUTRA_5GS_PTC
  {
    //@siclog "Step 9-10" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including nr Config to setup intra NR measurement for NR Cell 1 and reporting for event A1 on leaving condition.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message?
    f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, Meas_SCGOnly);    //@sic R5s190062 sic@
    
    //@siclog "Step 11" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1"
    //Send a trigger to NR to change the power
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));

    //@siclog "Step 12" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message to report event A1 with the measured [Results] value for NR Cell 1?
    a_EUTRA_ReceiveULInformationTransferMRDC(eutra_Cell1);

    //@siclog "Step 13" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T0"
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));

    //@siclog "Step 14" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message to report event A1 with the measured [Results] value for NR Cell 1?
    a_EUTRA_ReceiveULInformationTransferMRDC(eutra_Cell1);
    f_EUTRA_PreliminaryPass (__FILE__, __LINE__, "Step 14");
  }

  /*
   * @desc      Common test body for 8.2.3.6.1, 8.2.3.6.1a, 8.2.3.6.1b
   * @param     p_IsMeasGapNeeded
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_6_1_CommonTestBody(boolean p_IsMeasGapNeeded) runs on EUTRA_5GS_PTC
  {
    
    var float v_Watchdog := 10.0;

    //@siclog "Step 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including nr Config to setup intra NR measurement for NR Cell 1 and reporting for event A1/A2
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message?
    if(p_IsMeasGapNeeded)
    {//@sic R5-199097 sic@
        f_EUTRA38_508_ENDC_Reconfiguration_MeasGap(eutra_Cell1);
    }
    else
    {
       f_EUTRA38_508_ENDC_Reconfiguration (eutra_Cell1, Meas_SCGOnly);
    }
    
    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message within the next 10s to report event A3?
    f_EUTRA38_ENDC_CheckForNoULInformationTransferMRDC("Step 3. No measurement report is expected", eutra_Cell1, v_Watchdog);

    //@siclog "Step 4" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T1"
    //Send a trigger to NR to change the power
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
    
    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A3 (measId 1) with the measured value for NR Cell 2?
    a_EUTRA_ReceiveULInformationTransferMRDC(eutra_Cell1);
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.7.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_7_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { //Measurement configuration control and reporting / Event A4 / Measurement of Neighbour NR cell / Intra-frequency measurements / EN-DC
    //@sic R5-196118, R5-196119, R5-199097 sic@
    f_EUTRA38_Init(EN_DC, c1);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1, clause 4.5.4
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    f_AdjustCellPowerForTestingFR2();  //@sic R5-195369 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("ChangePower"));
    
    f_EUTRA_TestBody_Set(true);
    //Steps 1-8
    fl_TC_8_2_3_X_Common_TestBody("Step 8");
    
    f_EUTRA_TestBody_Set(false);
      
    //Postamble
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED); //@sic R5-204475 sic@
    // If finishing in E2_CONNECTED, need to wait until connection released before taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

