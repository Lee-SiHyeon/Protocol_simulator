  template (value) SystemInformationBlockType2 cs_508_SystemInformationBlockType2_Def(template (omit) EUTRA_SysinfoUL_Bandwidth_Type p_UL_ChBandwidth,
                                                                                      N_RB_CQI_Type p_N_RB_CQI,
                                                                                      PUSCH_HoppingOffset_Type p_PuschHoppingOffset,
                                                                                      template (value) SoundingRS_UL_ConfigCommon p_SoundingRS_UL_ConfigCommon,
                                                                                      template (value) PRACH_ConfigSIB p_PRACH_ConfigSIB,
                                                                                      P_b_Type p_P_b,
                                                                                      template (omit) PDSCH_ConfigCommon_v1310 p_PDSCH_ConfigCommon_v1310 := omit,
                                                                                      template (omit) PUSCH_ConfigCommon_v1310 p_PUSCH_ConfigCommon_v1310 := omit,
                                                                                      template (omit) PRACH_ConfigSIB_v1310 p_PRACH_ConfigSIB_v1310 := omit,
                                                                                      template (omit) PUCCH_ConfigCommon_v1310 p_PUCCH_ConfigCommon_v1310 := omit,
                                                                                      template (omit) PCCH_Config_v1310 p_PCCH_Config_v1310 := omit,
                                                                                      template (omit) PreambleTransMax p_PreambleTransMax := omit,
                                                                                      template (omit) RACH_CE_LevelInfoList_r13 p_RACH_CE_LevelInfoList_r13 := omit,
                                                                                      template (omit) CIOT_EPS_OptimisationInfo_r13 p_CIOT_EPS_OptimisationInfo_r13 := omit,
                                                                                      template (omit) FreqHoppingParameters_r13 p_FreqHoppingParameters_r13 := omit,
                                                                                      template (omit) HighSpeedConfig_r14 p_HighSpeedConfig := omit,
                                                                                      template (omit) PRACH_Config_v1430 p_PRACH_Config_v1430 := omit,
                                                                                      template (omit) ARFCN_ValueEUTRA p_UL_ARFCN_ValueEUTRA := omit ) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    //@sic R5-167569: added p_PDSCH_ConfigCommon_v1310, p_PUSCH_ConfigCommon_v1310, p_PRACH_ConfigSIB_v1310, p_PUCCH_ConfigCommon_v1310, p_PCCH_Config_v1310 sic@
    //@sic R5-172875: added p_CIOT_EPS_OptimisationInfo_r13 sic@
    //@sic R5s170550: added p_FreqHoppingParameters_r13 sic@
    //@sic R5-216082: added p_ARFCN_ValueEUTRA sic@
    // Acc. 36.508 Table 4.4.3.3-1: SystemInformationBlockType2
    ac_BarringInfo            := omit,
    radioResourceConfigCommon := cs_508_RadioResourceConfigCommonSIB_Default(p_N_RB_CQI, p_PuschHoppingOffset, p_SoundingRS_UL_ConfigCommon, p_PRACH_ConfigSIB, p_P_b,
                                                                             p_PDSCH_ConfigCommon_v1310, p_PUSCH_ConfigCommon_v1310, p_PRACH_ConfigSIB_v1310, p_PUCCH_ConfigCommon_v1310, p_PCCH_Config_v1310,
                                                                             p_PreambleTransMax, p_RACH_CE_LevelInfoList_r13,p_FreqHoppingParameters_r13, p_HighSpeedConfig, p_PRACH_Config_v1430),
    ue_TimersAndConstants     := cs_508_UE_TimersAndConstants,
    freqInfo := {
      ul_CarrierFreq          := p_UL_ARFCN_ValueEUTRA,
      ul_Bandwidth            := p_UL_ChBandwidth,            /* n6, n15, n25, n50, n75, n100 */
      additionalSpectrumEmission := 1                         // Acc. Table 4.4.3.3-1: SystemInformationBlockType2 and acc to TS 36.101 Table 6.2.4-1;
    },
