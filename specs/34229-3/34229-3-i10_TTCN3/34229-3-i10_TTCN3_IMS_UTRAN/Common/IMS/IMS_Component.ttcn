   * @desc      get UE release
   * @return    template (omit) integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_GetUE_Release() runs on IMS_PTC return template (omit) integer
  {
    return vc_IMS_Global.ImsInfo.UE_Release;
