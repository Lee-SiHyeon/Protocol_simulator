module ESM_Testcases_IMS {

  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 10.4.2
   * @status    APPROVED (LTE)
   */
  function f_TC_10_4_2_IMS1() runs on IMS_PTC
  {
    f_IMS_PTC_Init(-, -, IMS_Security);
    
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // @sic R5s150740 sic@
    
    // Registration: 34.229-1 Annex C.2
    f_IMS_Registration();

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); // @sic R5s150740 sic@
    
    f_IMS_TestBody_Set(true);

    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step C.2");
    
    f_IMS_GlobalRelease(); // @sic R5s150257 sic@
    f_IMS_Registration();

    // Inform EUTRA: IMS Registration done
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_TestBody_Set(false);
    // handling optional deregistration
    f_IMS_IpcanReleaseWithOptionalDeregistration();  /* @sic R5s160044 sic@ */
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

  }

}
