  const charstring tsc_AKAv1_MD5 := "AKAv1-MD5";                    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  const octetstring tsc_COLON_HEX := '3A'O;                         /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      generate URN acc. to 23.003 clause 13.8 and rules given by RFC 7254
   * @param     p_IMEI              (default value: px_IMEI_Def)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SIP_InstanceId(hexstring p_IMEI := px_IMEI_Def) return charstring
  { /* @sic R5s240680 change 1: function split into f_SIP_InstanceId (URN) and f_SIP_InstanceIdWithAngleBrackets ("sip.instnce" with angle brackets sic@ */
    var charstring v_ImeiString := hex2str(p_IMEI);
    var charstring v_InstanceId := "urn:gsma:imei:" & substr(v_ImeiString, 0, 8) & "-" & substr(v_ImeiString, 8, 6) & "-0"; // @sic R5s160006 sic@

    return v_InstanceId;
  }

  /*
   * @desc      generate "+sip.instance" parameter used in Contact header field (RFC 5626, RFC 5627) or by Registration Event Package (RFC 5628)
   * @param     p_IMEI              (default value: px_IMEI_Def)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SIP_InstanceIdWithAngleBrackets(hexstring p_IMEI := px_IMEI_Def) return charstring
  {
    return "<" & f_SIP_InstanceId(p_IMEI) & ">";
  }

