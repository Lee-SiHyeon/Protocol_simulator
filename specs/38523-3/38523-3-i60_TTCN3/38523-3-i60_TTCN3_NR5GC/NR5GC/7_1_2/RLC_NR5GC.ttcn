  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_5_NR5GC() runs on NR5GC_PTC
  { // UM RLC / Receive window operation and t-Reassembly expiry
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var SN_FieldLengthUM v_DL_Len;
    var SN_FieldLengthUM v_UL_Len;
    var T_Reassembly v_T_Reassembly;
    var NR_PDCP_T_Reordering_Type v_T_Reordering;
    var DRB_Identity v_DRBId;
    
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    if (pc_um_WithShortSN) {
      v_DL_Len := size6;
      v_UL_Len := size6;
      v_RLC_Rec.UM_SN_Size := 6;
    } else {
      v_DL_Len := size12;
      v_UL_Len := size12;
      v_RLC_Rec.UM_SN_Size := 12;
    }
    v_RLC_Rec.t_Reassembly := 0.02; // @sic R5s190548 sic@
    v_T_Reassembly := ms200; // @sic R5s190548 sic@
    v_T_Reordering := ms30; // @sic R5s190548, R5-197250 sic@
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_UM (v_DRBId, v_DL_Len, v_UL_Len, v_T_Reassembly);
    f_NR5GC_RRC_ConnectedState3N_RLC_UM (v_DRBId, v_RLC_BearerConfigList[0], v_DL_Len, v_T_Reordering); // @sic R5s190548, R5-197250 sic@
 
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_2_5_NR_TestBody(v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_6_NR5GC() runs on NR5GC_PTC
  { // UM RLC / RLC re-establishment procedure
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigListDRB_Only;
    var template (value) PDCP_Config v_PDCP_Config;
    var SN_FieldLengthUM v_DL_Len;
    var SN_FieldLengthUM v_UL_Len;
    var T_Reassembly v_T_Reassembly;
    var DRB_Identity v_DRBId;
    
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    if (pc_um_WithShortSN) {
      v_DL_Len := size6;
      v_UL_Len := size6;
      v_RLC_Rec.UM_SN_Size := 6;
    } else {
      v_DL_Len := size12;
      v_UL_Len := size12;
      v_RLC_Rec.UM_SN_Size := 12;
    }
    v_RLC_Rec.t_Reassembly := 0.02; // @sic R5s190632 sic@

    v_SS_Drb_ConfigList := f_NR5GC_GetRadioBearerList(f_NR5GC_MobileInfo_GetDRBInfoList()); // @sic R5-2277420 sic@
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_UM_Test(v_DRBId, v_DL_Len); // @sic R5-227420 sic@
    v_PDCP_Config := cs_38508_PDCP_Config(-, -, omit); // @sic R5-227518 sic@
    v_T_Reassembly := ms200; // @sic R5s190632 sic@
    v_RLC_BearerConfigList := f_NR5GC_GetExisting_BearerToAddModList(true_); //@sic R5-227420 sic@
    v_RLC_BearerConfigListDRB_Only := f_NR_ReconfigureRLC_UM (v_DRBId, v_DL_Len, v_UL_Len, v_T_Reassembly, true_);
    v_RLC_BearerConfigList[2] := v_RLC_BearerConfigListDRB_Only[0];
    // Get NR capabilities sent during EUTRA preamble
    f_NR5GC_RRC_ConnectedState3N_RLC_UM (v_DRBId, v_RLC_BearerConfigList[2], v_DL_Len); //@sic R5s230060 sic@
    
    f_NR_TestBody_Set(true);

    f_TC_7_1_2_2_6_NR_TestBody(v_RLC_Rec, // @sic R5s190905_r1 sic@
                               v_DRBId, // @sic R5s220321 sic@
                               v_DL_Len,
                               v_UL_Len,
                               v_T_Reassembly,
                               v_PDCP_Config,
                               v_SS_Drb_ConfigList);

    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.6
   * @param     p_RLC_Rec
   * @param     p_NR_DRB_Id
   * @param     p_DL_Len
   * @param     p_UL_Len
   * @param     p_T_Reassembly
   * @param     p_PDCP_Config
   * @param     p_SS_Drb_ConfigList
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_6_NR_TestBody(NR_RLC_SS_State_Type p_RLC_Rec,
                                      DRB_Identity p_NR_DRB_Id,
                                      SN_FieldLengthUM p_DL_Len,
                                      SN_FieldLengthUM p_UL_Len,
                                      T_Reassembly p_T_Reassembly,
                                      template (value) PDCP_Config p_PDCP_Config,
                                      template (value) NR_RadioBearerList_Type p_SS_Drb_ConfigList) runs on NR5GC_PTC
  { // AM RLC / RLC re-establishment procedure
    // @sic R5s190905_r1 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList := f_NR5GC_GetExisting_BearerToAddModList(true_); //@sic R5s200755 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigListDRB_Only;
    var NR_RLC_DataFieldList_Type v_NR_RLC_DataList;
    var template (value) CellGroupConfig v_CellGroupConfig; //@sic R5s191200 sic@

    v_RLC_BearerConfigListDRB_Only := f_NR_ReconfigureRLC_UM (p_NR_DRB_Id, p_DL_Len, p_UL_Len, p_T_Reassembly, true_);
    v_RLC_BearerConfigList[2] := v_RLC_BearerConfigListDRB_Only[0]; //@sic R5s200755 sic@
    v_CellGroupConfig := f_NR_GetCellGroupConfigHO (nr_Cell1, v_RLC_BearerConfigList); //tsc_C_RNTI_Value3

    // Steps 1-3
    v_NR_RLC_DataList := f_TC_7_1_2_2_6_NR_TestBody_Steps1_3(p_RLC_Rec, p_NR_DRB_Id);

    // @siclog "Steps 4-4A" siclog@ @sic R5-198901 sic@
    //The SS transmits NR RRCReconfiguration message to trigger RLC re-establishment on DRB using Reconfig with sync procedure
    //The UE transmits a NR RRCReconfigurationcomplete message.
    f_NR_RLC_ReconfigurationHO (nr_Cell1, p_NR_DRB_Id, v_RLC_BearerConfigList, p_PDCP_Config, p_SS_Drb_ConfigList, true, v_CellGroupConfig);  // UM_TX_Next == 0 and UM_RX_Next == 0 @sic R5s190800, R5s200180 sic@

    // Steps 5-10A
    f_TC_7_1_2_2_6_NR_TestBody_Steps5_10A(p_RLC_Rec, p_NR_DRB_Id, v_NR_RLC_DataList); // @sic R5s200024 sic@

    // @siclog "Steps 11-11A" siclog@ @sic R5-198901 sic@
    //The SS transmits NR RRCReconfiguration message to trigger RLC re-establishment on DRB using Reconfig with sync procedure
    //The UE transmits a NR RRCReconfigurationcomplete message.
    //v_SS_Drb_Config and v_RLC_BearerConfigList as in step 4
    f_NR_RLC_ReconfigurationHO (nr_Cell1, p_NR_DRB_Id, v_RLC_BearerConfigList, p_PDCP_Config, p_SS_Drb_ConfigList, true, v_CellGroupConfig);  // UM_TX_Next == 0 and UM_RX_Next == 0 @sic R5s190800, R5s200180 sic@

    // Steps 11B-15
    f_TC_7_1_2_2_6_NR_TestBody_Steps11B_15(p_RLC_Rec, p_NR_DRB_Id, v_NR_RLC_DataList); // @sic R5s200024 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_3_1_NR5GC() runs on NR5GC_PTC
  { // AM RLC / 12-bit SN / Segmentation and reassembly / Segmentation Info (SI) field
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var UL_t_PollRetransmit_Type v_T_PollRetransmit;
    var DL_t_Reassembly_Type v_T_Reassembly;
    var DRB_Identity v_DRBId;
    
    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    //Re-establish DRB and modify RLC parameters
    v_T_PollRetransmit := f_NR_UL_AM_T_PollRetransmit(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(v_DRBId,
                                                     size12,
                                                     v_T_PollRetransmit,
                                                     -,
                                                     -,
                                                     -,
                                                     size12,
                                                     v_T_Reassembly);
    f_NR5GC_RRC_ConnectedState3N_RLC_AM (v_DRBId, v_RLC_BearerConfigList[0], size12);
   
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.AM_SN_Size := 12;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {
      v_RLC_Rec.t_PollRetransmit := 0.03;
      v_RLC_Rec.t_Reassembly := 0.03;
    };
    f_NR_TestBody_Set(true);
    
    f_TC_7_1_2_3_1_NR_TestBody(v_RLC_Rec, v_DRBId);

    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_3_2_NR5GC() runs on NR5GC_PTC
  { // AM RLC / 18-bit SN / Segmentation and reassembly / Segmentation Info (SI) field
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var UL_t_PollRetransmit_Type v_T_PollRetransmit;
    var DL_t_Reassembly_Type v_T_Reassembly;
    var DRB_Identity v_DRBId;
    
    f_NR5GC_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    //Re-establish DRB1 and modify RLC parameters
    v_T_PollRetransmit := f_NR_UL_AM_T_PollRetransmit(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(v_DRBId,
                                                     -, // size18
                                                     v_T_PollRetransmit,
                                                     -,
                                                     -,
                                                     -,
                                                     -, // size18
                                                     v_T_Reassembly);
    f_NR5GC_RRC_ConnectedState3N_RLC_AM (v_DRBId, v_RLC_BearerConfigList[0]);  // size18
   
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {
      v_RLC_Rec.t_PollRetransmit := 0.03;
      v_RLC_Rec.t_Reassembly := 0.03;
    };

    f_NR_TestBody_Set(true);
    
    f_TC_7_1_2_3_2_NR_TestBody(v_RLC_Rec, v_DRBId);

    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

