      }
      case (POS_C41us) {
        v_ApplCond := pc_UeBasedAgps and pc_UEB_A_GANSS and pc_BDS and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C42us) {
        v_ApplCond := pc_UEA_A_GANSS and pc_BDS and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C43us) {
        v_ApplCond := pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_BDS and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C44us) {
        v_ApplCond := pc_UEB_A_GANSS and pc_BDS and pc_ParamPosEstimate and not (pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C45us) {
        v_ApplCond := pc_UeBasedAgps and pc_UEB_A_GANSS and pc_BDS and pc_ParamPosEstimate and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C46us) {
        v_ApplCond := pc_UEA_A_GANSS and pc_BDS and pc_ParamPosEstimate and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C47us) {
        v_ApplCond := pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_BDS and pc_ParamPosEstimate and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C48us) {
        v_ApplCond := (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_BDS and pc_ParamGpsAssisData and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C49us) {
        v_ApplCond := ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_BDS and pc_ParamGpsAssisData and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C50us) {
        v_ApplCond := pc_UEA_A_GANSS and pc_BDS and not (pc_UeAssistedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C51us) {
        v_ApplCond := pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_BDS and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C52us) {
        v_ApplCond := (pc_UEB_A_GANSS or pc_UEA_A_GANSS) and pc_BDS and not (pc_UeAssistedAgps or pc_UeBasedAgps or pc_MGPS or pc_GALILEO or pc_GLONASS);
      }
      case (POS_C53us) {
        v_ApplCond := ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_BDS and not (pc_GALILEO or pc_GLONASS);
      }
      case (POS_C54us) {
        v_ApplCond := pc_FDD and pc_UeBasedAgps and pc_UEB_A_GANSS and pc_GALILEO and not (pc_GLONASS or pc_BDS);
      }
      case (POS_C55us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GALILEO and not (pc_GLONASS or pc_BDS);
      }
      case (POS_C56us) {
