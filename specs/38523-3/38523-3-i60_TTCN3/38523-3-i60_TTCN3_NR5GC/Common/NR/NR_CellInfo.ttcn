          if (isvalue(p_IntraFreqReselectionRedCap_r17)) {
              v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.intraFreqReselectionRedCap_r17 := valueof(p_IntraFreqReselectionRedCap_r17);
          } else {
