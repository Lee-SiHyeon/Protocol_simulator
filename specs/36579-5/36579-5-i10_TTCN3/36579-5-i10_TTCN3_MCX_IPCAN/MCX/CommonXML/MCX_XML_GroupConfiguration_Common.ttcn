module MCX_XML_GroupConfiguration_Common {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttGroupInfo_1_0 language "XSD" all;        
  import from urn_ietf_params_xml_ns_resource_lists language "XSD" all; 
  import from urn_oma_xml_poc_list_service language "XSD" all;          
  import from urn_oma_xml_xdm_extensions language "XSD" all;            

  type urn_ietf_params_xml_ns_resource_lists.Display_nameType    MCX_ResourceLists_DisplayName_Type;  /* @status    APPROVED (MCX) */

  type urn_ietf_params_xml_ns_resource_lists.EntryType           MCX_ResourceLists_EntryType_Type;    /* @status    APPROVED (MCX) */

  type urn_oma_xml_poc_list_service.Group                        MCX_PocListService_Group_Type;       /* @status    APPROVED (MCX) */

  type urn_oma_xml_poc_list_service.List_type                    MCX_PocListService_List_Type;        /* @status    APPROVED (MCX) */

  type urn_oma_xml_poc_list_service.List_service_type            MCX_PocListService_ListService_Type; /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttGroupInfo_1_0.EncodingType               MCX_GroupInfo_Encoding_Type;         /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttGroupInfo_1_0.EncodingsType              MCX_GroupInfo_Encodings_Type;        /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttGroupInfo_1_0.RegroupedType              MCX_GroupInfo_Regrouped_Type;        /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcpttGroupInfo_1_0.ConstituentMCPTTgroupTypeIDsType.constituent_MCPTT_group_ID_list MCX_GroupInfo_ConstituentGroupList_Type;   /* @status    APPROVED (MCX) */

  template (value) MCX_ResourceLists_DisplayName_Type cs_MCX_ResourceLists_DisplayName(template (omit) XSD.Language p_Language := omit,
                                                                                       XSD.String p_Name) :=
  { /* @status    APPROVED (MCX) */
    lang := p_Language,
    base := p_Name
  };

  template (value) MCX_ResourceLists_EntryType_Type cs_MCX_ResourceLists_Entry(XSD.AnyURI p_URI,
                                                                               template (omit) MCX_ResourceLists_DisplayName_Type p_DisplayName := omit,
                                                                               template (value) MCX_ResourceLists_EntryType_Type.elem_list p_Extensions := {}) :=
  { /* @status    APPROVED (MCX) */
    uri := p_URI,
    attr := omit,
    display_name := p_DisplayName,
    elem_list := p_Extensions
  };

  template (value) MCX_PocListService_Group_Type cs_MCX_PocListService_Group(template (value) MCX_PocListService_Group_Type.sequence_list p_GroupList) :=
  { /* @status    APPROVED (MCX) */
    sequence_list := p_GroupList
  };

  template (value) MCX_PocListService_List_Type cs_MCX_PocListService_List(template (value) MCX_PocListService_List_Type.entry_list p_EntryList) :=
  { /* @status    APPROVED (MCX) */
    entry_list := p_EntryList,
    external_list := {}
  };

  template (value) MCX_PocListService_ListService_Type cs_MCX_PocListService_ListService(XSD.AnyURI p_URI,
                                                                                         template (value) MCX_ResourceLists_DisplayName_Type p_DisplayName,
                                                                                         template (value) MCX_PocListService_List_Type p_List,
                                                                                         template (omit) XSD.NonNegativeInteger p_MaxParticipants,
                                                                                         template (value) MCX_PocListService_ListService_Type.elem_list p_Extensions) :=
  { /* @status    APPROVED (MCX) */
    uri := p_URI,
    attr := omit,
    display_name := p_DisplayName,
    list := p_List,
    invite_members := omit,
    max_participant_count := p_MaxParticipants,
    elem_list := p_Extensions
  };

  template (value) MCX_GroupInfo_Encoding_Type cs_MCX_GroupInfo_Encoding(XSD.String p_EncodingName) :=
  { /* @status    APPROVED (MCX) */
    name := p_EncodingName,
    attr := omit,
    anyExt := omit,
    elem_list := {}
  };

  template (value) MCX_GroupInfo_Encodings_Type cs_MCX_GroupInfo_Encodings(XSD.String p_EncodingName) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    encoding_list := { cs_MCX_GroupInfo_Encoding(p_EncodingName) },
    anyExt := omit,
    elem_list := {}
  };

  template (value) urn_oma_xml_xdm_extensions.ExtensionType cs_MCX_GroupMediaExtension :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    sequence_list := {}
  };

  template (value) urn_oma_xml_xdm_extensions.MediaListType crs_MCX_ListServiceExtensions_Media(XSD.String p_Media) :=
  { /* @status    APPROVED (MCX) */
    choice := {
      sequence_list := {
        {
          choice := {
            elem := p_Media
          }
        }
      }
    }
  };

  template (value) urn_oma_xml_xdm_extensions.ServiceType.sequence_list[-] crs_MCX_ListServiceExtensions_Service_Media(XSD.String p_Media) :=
  { /* @status    APPROVED (MCX) */
    group_media := crs_MCX_ListServiceExtensions_Media(p_Media),
    elem := omit
  };

  template (value) urn_oma_xml_xdm_extensions.ServiceType crs_MCX_ListServiceExtensions_Service(XSD.String p_Enabler,
                                                                                                             template (value) urn_oma_xml_xdm_extensions.ServiceType.sequence_list p_MediaList) :=
  { /* @status    APPROVED (MCX) */
    enabler := p_Enabler,
    attr := omit,
    sequence_list := p_MediaList
  };

  template (value) urn_oma_xml_xdm_extensions.ServiceListType crs_MCX_ListServiceExtensions_SupportedService(XSD.String p_Enabler,
                                                                                                             template (value) urn_oma_xml_xdm_extensions.ServiceType.sequence_list p_MediaList) :=
  { /* @status    APPROVED (MCX) */
    choice := {
      sequence_list := {
        {
          choice := {
            service := crs_MCX_ListServiceExtensions_Service(p_Enabler, p_MediaList)
          }
        }
      }
    }
  };

  /*
   * @desc      Return oxe:supported-services extension for group document depending on the service
   * @param     p_ServiceType
   * @return    template (value) urn_oma_xml_xdm_extensions.Supported_services
   * @status    APPROVED (MCX)
   */
  function f_MCX_ListServiceExtensions_SupportedService(MCX_ServiceType_Type p_ServiceType) return  template (value) urn_oma_xml_xdm_extensions.Supported_services
  {
    var template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.Mcptt_speech        v_MediaExtensionSpeech := cs_MCX_GroupMediaExtension;
    var template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_video_media v_MediaExtensionVideo  := cs_MCX_GroupMediaExtension;
    var template (value) urn_oma_xml_xdm_extensions.ServiceType.sequence_list v_ServiceMediaList;
    var XSD.String v_EncodedMediaExtension;
    var charstring v_FeatureParamValue;

    select (p_ServiceType) {
      case (MCPTT) {
        v_FeatureParamValue := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcptt;
        v_EncodedMediaExtension := f_Bit2XsdString(encvalue(v_MediaExtensionSpeech));
        v_ServiceMediaList := { crs_MCX_ListServiceExtensions_Service_Media(v_EncodedMediaExtension) };
      }
      case (MCVideo) {
        v_FeatureParamValue := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcvideo;
        v_EncodedMediaExtension := f_Bit2XsdString(encvalue(v_MediaExtensionVideo));
        v_ServiceMediaList := { crs_MCX_ListServiceExtensions_Service_Media(v_EncodedMediaExtension) };
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_FeatureParamValue := tsc_MCX_FeatureTag_3gpp_service_ims_icsi_mcdata;
        v_ServiceMediaList := {};
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }

    return crs_MCX_ListServiceExtensions_SupportedService(v_FeatureParamValue, v_ServiceMediaList);
  }

  template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.ConstituentMCPTTgroupTypeIDsType cs_MCX_ConstituentMCPTTgroupTypeIDs(MCX_GroupInfo_ConstituentGroupList_Type p_ConstituentGroupList) :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    constituent_MCPTT_group_ID_list := p_ConstituentGroupList,
    anyExt := omit,
    elem_list := {}
  };

  template (value) MCX_GroupInfo_Regrouped_Type cs_MCX_GroupInfo_Regrouped(charstring p_TemporaryGroupRequestor,
                                                                           charstring p_TemporaryGroupID,
                                                                           MCX_GroupInfo_ConstituentGroupList_Type p_ConstituentGroupList) :=
  { // 36.579-1 Table 5.3.22.4-5
    /* @status    APPROVED (MCX) */
    temporary_MCPTT_group_ID := p_TemporaryGroupID,
    temporary_MCPTT_group_requestor := p_TemporaryGroupRequestor,
    attr := omit,
    constituent_MCPTT_group_IDs := cs_MCX_ConstituentMCPTTgroupTypeIDs(p_ConstituentGroupList),
    on_network_group_priority := omit,
    protect_media := true,
    protect_floor_control_signalling := true,
    require_multicast_floor_control_signalling := omit,
    anyExt := omit,
    elem_list := {}
  };

  /*
   * @desc      Build entry for MCX Group Member List
   * @param     p_URI
   * @param     p_UserPriority
   * @param     p_ParticipantType
   * @param     p_AdditionalExtensions
   * @return    template (value) MCX_ResourceLists_EntryType_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_GroupMemberListEntryTX_Common(XSD.AnyURI p_URI,
                                               urn_3gpp_ns_mcpttGroupInfo_1_0.User_priority p_UserPriority,
                                               urn_3gpp_ns_mcpttGroupInfo_1_0.Participant_type p_ParticipantType,
                                               MCX_ResourceLists_EntryType_Type.elem_list p_AdditionalExtensions) return template (value) MCX_ResourceLists_EntryType_Type
  {
    var MCX_ResourceLists_EntryType_Type.elem_list v_Extensions := {
      f_Bit2XsdString(encvalue(p_UserPriority)),
      f_Bit2XsdString(encvalue(p_ParticipantType))
    };
    v_Extensions := v_Extensions & p_AdditionalExtensions;

    return cs_MCX_ResourceLists_Entry(p_URI, -, v_Extensions);
  }

  /*
   * @desc      concationation of two elem_list
   * @param     p_GroupExtensions1
   * @param     p_GroupExtensions2
   * @return    MCX_PocListService_ListService_Type.elem_list
   * @status    APPROVED (MCX)
   */
  function f_MCX_GroupExtensions_Concat(MCX_PocListService_ListService_Type.elem_list p_GroupExtensions1,
                                        MCX_PocListService_ListService_Type.elem_list p_GroupExtensions2) return MCX_PocListService_ListService_Type.elem_list
  {
    return p_GroupExtensions1 & p_GroupExtensions2;
  }

  /*
   * @desc      Add single elem to the extension (element_list) of a group document
   * @param     p_GroupExtensions
   * @param     p_Elem
   * @return    MCX_PocListService_ListService_Type.elem_list
   * @status    APPROVED (MCX)
   */
  function f_MCX_GroupExtensions_Add(MCX_PocListService_ListService_Type.elem_list p_GroupExtensions,
                                       XSD.String p_Elem) return MCX_PocListService_ListService_Type.elem_list
  {
    var MCX_PocListService_ListService_Type.elem_list v_AdditionalExtensions := { p_Elem };
    return f_MCX_GroupExtensions_Concat(p_GroupExtensions, v_AdditionalExtensions);
  }

  /*
   * @desc      Encode MCX Group Configuration
   * @param     p_GroupConfiguration
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_GroupConfiguration_Encode(template (value) urn_oma_xml_poc_list_service.Group p_GroupConfiguration) return bitstring
  {
    return encvalue(p_GroupConfiguration);
  }

}
