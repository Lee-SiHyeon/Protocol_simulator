module MAC_CA_ENDC_NR {

    import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from MAC_TC_Common_NR all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit_ENDC all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_CA all;
  import from NR_CommonFunctions_ENDC all;
  import from NR_CommonFunctions_ENDC_CA all;
  import from NR_Component_Base all;
  import from NR_Component_ENDC all;
  import from NR_ConfigurationSteps all;
  import from NR_FrequencyCommon all;
  import from NR_L2_Common all;
  import from NR_RLC_Common all;
  import from NR_RRC_Templates all;
  import from NR_ResourceAllocation all;
  import from NR_Timing all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_NR_CA_Tested
   * @status    APPROVED (ENDC)
   */
   function f_TC_7_1_1_3_8_ENDC_Common(NR_CellId_Type  p_PSCell,
                                       NR_CellId_Type  p_SCell,
                                       NR_CA_Tested_Type p_NR_CA_Tested) runs on ENDC_NR_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    var NR_ResourceAllocation_Type v_NR_ResourceAllocation;
    var NR_UplinkBWP_Type v_NR_UplinkBWP;
    var SubFrameTiming_Type v_TimingUL;

     // Multi PR initialisation is taken care in Test body.
    f_ENDC_NR_Init_CA(p_NR_CA_Tested, {p_PSCell, p_SCell}, false);//@sic R5s211385 R5s210894 sic@
    
    //Create and configure NR cell1s
    f_NR_CellConfig_PCell_Def(p_PSCell);
    f_NR_CellConfig_SCell(p_SCell,Scell_Active);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(p_PSCell, MCG_Only);
    f_NR_AS_CipheringAlgorithm_Set(nea0);

    //Configure on SS the SCG DRB in test mode
    f_NR_ENDC_ConfigAM_UM(p_PSCell, 1, 0, -, -, -, -, -, -);
    // Wait for Trigger from EUTRA indicating start of Test Body
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPower(p_SCell, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    f_NR_TestBody_Set(true);

    //@siclog "Steps 1 - 2" siclog@
    f_NR_AddMod_1SCell_ENDC(p_PSCell, p_SCell,-,-,-,-,true,-,false); //@sic R5-215675 sic@
     
    v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_PSCell, tsc_NR_BWP_Id);
    v_NR_ResourceAllocation := f_NR_ResourceAllocation_UplinkGrant(136, v_NR_UplinkBWP);
    //@sic R5s210894 sic@
    // Enable reception of PHR

    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_MAC_PHR(enable));
    //The SS transmits UL grant to the UE at every 10ms in PDCCH occasion.
   //@siclog "Step 3 " siclog@
    v_TimingUL := f_NR_GetNextSendOccasion_UL(p_PSCell, 100);
    f_NR_ULGrantConfiguration_StartPeriodicGrant(p_PSCell, cs_TimingInfo_NR(v_TimingUL), v_NR_ResourceAllocation, 10);
    //@siclog "Steps 4&5" siclog@
    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_PSCell);
    v_MAC_CellGroupConfig.phr_Config := cs_38508_PHR_Config_Setup(cs_PHR_Config_71138);
    f_NR_CellInfo_SetMAC_CellGroupConfig(p_PSCell, v_MAC_CellGroupConfig);
    v_SCGConfig := cs_38508_CellGroupConfig (tsc_NR_CellGroupId_SCG,
                                            omit,
                                             omit,
                                             v_MAC_CellGroupConfig);

   f_NR_SendRRCReconfigurationContentsToEUTRA (omit, v_SCGConfig);  // Now send octetstrings to EUTRA
   
   
  //@siclog "Steps 5" siclog@
  SYSIND.receive(car_NR_SYSTEM_MultiEntryPHR_IND(p_PSCell, cr_NR_MAC_CE_MultiEntryPHR(?)));
  f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
 
   
    //@siclog "Steps 7-20" siclog@
    f_TC_7_1_1_3_8_NR_TestBody(p_PSCell, p_SCell,cr_NR_MAC_CE_MultiEntryPHR_3Entries(?),tsc_NR_SCellIndex_2);

    //@siclog "Steps 21-22" siclog@
    v_MAC_CellGroupConfig.phr_Config := { release := NULL };
    f_NR_CellInfo_SetMAC_CellGroupConfig(p_PSCell, v_MAC_CellGroupConfig);
    v_SCGConfig := cs_38508_CellGroupConfig (tsc_NR_CellGroupId_SCG, //@sic R5s200753 sic@
                                            omit,
                                             omit,
                                             v_MAC_CellGroupConfig);
    f_NR_SendRRCReconfigurationContentsToEUTRA (omit, v_SCGConfig);  // Now send octetstrings to EUTRA
    //@sic R5s210894 sic@
    // disable reception of PHR
    f_NR_SS_SystemIndCtrlConfig(p_PSCell, cds_NR_SystemIndCtrl_MAC_PHR(disable));
    f_NR_TestBody_Set(false);
    // Send Trigger to EUTRA indicating Finish of Test Body
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_8_1_ENDC_NR() runs on ENDC_NR_PTC
  { //UE power headroom reporting / SCell activation / DL pathloss change reporting/  Intra-band Contiguous CA
    f_TC_7_1_1_3_8_ENDC_Common ( nr_Cell1, nr_Cell3,  CA_IntraBandContiguous);
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.8.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_8_2_ENDC_NR() runs on ENDC_NR_PTC
  { //UE power headroom reporting / SCell activation / DL pathloss change reporting/  Inter-band  CA
    f_TC_7_1_1_3_8_ENDC_Common ( nr_Cell1, nr_Cell10,  CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_NR_CA_Tested
   * @status    APPROVED (ENDC)
   */
   function f_TC_7_1_1_7_1_ENDC_Common(NR_CellId_Type  p_PSCell,
                                       NR_CellId_Type  p_SCell,
                                       NR_CA_Tested_Type p_NR_CA_Tested) runs on ENDC_NR_PTC
  {
    //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer
    var boolean v_UL_CA := f_NR5GC_Get_UL_CA(p_NR_CA_Tested) ; //@sic R5-226021 sic@
    var template (value)  NR_RadioBearerList_Type v_SS_Drb_ConfigList  := {cs_NR_SS_RadioBearer_MAC_TestMode(tsc_NR_DRB2, cs_NR_MAC_TestModeInfo_NormalMode)};
    //@sic R5s210855 R5-214587 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var T_PollRetransmit v_T_PollRetransmit := ms80;
    var DL_t_Reassembly_Type v_T_Reassembly;


    f_ENDC_NR_Init_CA(p_NR_CA_Tested, {p_PSCell, p_SCell}, v_UL_CA);
    
    //Create and configure NR cell1s
    f_NR_CellConfig_PCell_Def(p_PSCell);
    f_NR_CellConfig_SCell(p_SCell,Scell_Active);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(p_PSCell, MCG_Only);
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    //@sic R5s210855 R5-214587 sic@
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(p_PSCell));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2, -, v_T_PollRetransmit, -, -, -, -, v_T_Reassembly);


    //Configure on SS the SCG DRB in test mode
    //@sic R5s210855 R5-214587 sic@
    f_NR_ENDC_ConfigAM_UM(p_PSCell, 1, 0, v_SS_Drb_ConfigList, v_RLC_BearerConfigList);
    // Wait for Trigger from EUTRA indicating start of Test Body
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPower(p_SCell, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    f_NR_TestBody_Set(true);

    //@siclog "Steps 1 - 2" siclog@
    f_NR_AddMod_1SCell_ENDC(p_PSCell, p_SCell,-,-,-,-,v_UL_CA, ms320,false); //@sic R5s210668 R5-214764 sic@

    //Configure SS in No header manipulation
    v_SS_Drb_ConfigList  := {cs_NR_SS_RadioBearer_MAC_TestMode(tsc_NR_DRB2, cs_NR_MAC_TestModeInfo_NoHeaderManipulationDL_UL)};
    f_NR_SS_CommonRadioBearerConfig(nr_Cell1, v_SS_Drb_ConfigList);
   
    //@siclog "Steps 3-20" siclog@
    f_TC_7_1_1_7_1_NR_TestBody(p_PSCell, p_SCell,tsc_NR_SCellIndex_2,tsc_NR_DRB2,v_UL_CA);

    f_NR_TestBody_Set(false);
    // Send Trigger to EUTRA indicating Finish of Test Body
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Intra-band Contiguous CA
    f_TC_7_1_1_7_1_ENDC_Common ( nr_Cell1, nr_Cell3,  CA_IntraBandContiguous);
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_2_ENDC_NR() runs on ENDC_NR_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Inter-band  CA
    f_TC_7_1_1_7_1_ENDC_Common ( nr_Cell1, nr_Cell10,  CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.7.1.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_7_1_3_ENDC_NR() runs on ENDC_NR_PTC
  { //Activation/Deactivation of SCells / Activation/Deactivation MAC control element reception / sCellDeactivationTimer/  Intra-band Non Contiguous CA
    f_TC_7_1_1_7_1_ENDC_Common ( nr_Cell1, nr_Cell3,  CA_IntraBandNonContiguous);
  }

}
