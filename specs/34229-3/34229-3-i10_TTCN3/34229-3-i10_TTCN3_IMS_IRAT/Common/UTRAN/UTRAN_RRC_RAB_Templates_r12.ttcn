            cs_TFCS_CtfcSize_Ctfc8Bit_r12(49),
            cs_TFCS_CtfcSize_Ctfc8Bit_r12(59),
            cs_TFCS_CtfcSize_Ctfc8Bit_r12(60),
            cs_TFCS_CtfcSize_Ctfc8Bit_r12(61),
            cs_TFCS_CtfcSize_Ctfc8Bit_r12(71),
