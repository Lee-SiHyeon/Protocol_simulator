module PosSystem_Common {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from CommonDefs all;
  import from LCS_Objects_Templates all;
  import from POS_Parameters all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;

  /*
   * @desc      Gets the LCS Client Address from various PIXIT that will be passed as parameters (px_LcsClientAddressTOA, px_LcsClientAddressNPI and px_LcsClientAddressDigits)
   * @param     p_TOA
   * @param     p_NPI
   * @param     p_String
   * @return    ISDN_AddressString
   * @status    APPROVED (POS)
   */
  function f_POS_Get_LcsClientAddress(B4_Type p_TOA,
                                      B4_Type p_NPI,
                                      charstring p_String) return ISDN_AddressString
  {
    var ISDN_AddressString v_ISDN_AddressString;
    var octetstring v_FirstOctet;

    v_FirstOctet := hex2oct(bit2hex(p_TOA) & bit2hex(p_NPI));
    v_ISDN_AddressString := v_FirstOctet & f_CharPacking_IA5toBCD(p_String);

    return v_ISDN_AddressString;
  }

  /*
   * @desc      Encodes parameter of type Components into an octetstring
   * @param     p_InvokeId
   * @param     p_NotificationType
   * @return    octetstring
   * @status    APPROVED (POS)
   */
  function f_SS_EncodeComponents_InvokeLocNotification(InvokeIdType p_InvokeId,
                                                       NotificationToMSUser p_NotificationType) return octetstring
  { //@sic R5s150911 sic@
    var template (value) Invoke v_InvokeLocNotification := cs_InvokeLocNotification(p_InvokeId,
                                                                                    p_NotificationType,
                                                                                    f_POS_Get_LcsClientAddress(px_LcsClientAddressTOA,
                                                                                                               px_LcsClientAddressNPI,
                                                                                                               px_LcsClientAddressDigits),
                                                                                    f_CharPacking_IA5toGsm7Bit(px_LcsClientName, USSD_Packing));
    return f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(v_InvokeLocNotification)));
  }

}
