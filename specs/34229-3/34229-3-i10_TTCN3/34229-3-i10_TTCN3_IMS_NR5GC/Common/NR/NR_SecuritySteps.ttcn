module NR_SecuritySteps {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_SecurityFunctions all;

  template (value) NR_SYSTEM_CTRL_REQ cs_NR_AS_SecurityStart_REQ(NR_CellId_Type p_NR_CellId,
                                                                 template (value) NR_AS_SecStartRestart_Type p_AS_SecStartRestart,
                                                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                 template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo, p_CnfFlag),
    Request := {
      AS_Security := {
        StartRestart := p_AS_SecStartRestart
      }
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cs_NR_AS_SecurityRelease_REQ(NR_CellId_Type p_NR_CellId,
                                                                   template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                   template (omit) boolean p_CnfFlag := omit) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo, p_CnfFlag),
    Request := {
      AS_Security := {
        Release := true
      }
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_AsSecurity_CNF(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      AS_Security := true
    }
  };

  template (value) NR_AS_SecStartRestart_Type cs_NR_AS_IntProt_CiphActivate(template (value) NR_AS_IntegrityInfo_Type p_IntInfo,
                                                                            template (value) NR_AS_CipheringInfo_Type p_CiphInfo) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Integrity := p_IntInfo,
    Ciphering := p_CiphInfo
  };

  template (value) NR_PDCP_CountReq_Type cs_NR_PDCP_CountGet_AllRBs  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Get := {
      AllRBs := true
    }
  };

  template (value) NR_PDCP_CountReq_Type cs_NR_PDCP_CountGet_SingleRB(template (value) NR_RadioBearerId_Type p_RadioBearerId)  :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Get := {
      SingleRB := p_RadioBearerId
    }
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_PdcpCount_REQ(NR_CellId_Type p_NR_CellId,
                                                           template (value) NR_PDCP_CountReq_Type p_CountReq,
                                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common  := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo),
    Request := {
      PdcpCount := p_CountReq
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_PdcpCount_CNF(NR_CellId_Type p_NR_CellId,
                                                             template (present) NR_PDCP_CountCnf_Type p_PDCP_CountCnf) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      PdcpCount := p_PDCP_CountCnf
    }
  };

  /*
   * @desc      enable PDCP integrity and ciphering at the SS
   * @param     p_NR_CellId
   * @param     p_AS_IntegrityInfo
   * @param     p_AS_CipheringInfo
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_RRC_EnableIntProt_CiphULandDL(NR_CellId_Type p_NR_CellId,
                                                 NR_AS_IntegrityInfo_Type p_AS_IntegrityInfo,
                                                 NR_AS_CipheringInfo_Type p_AS_CipheringInfo,
                                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
    f_NR_SS_AS_SecurityConfig(p_NR_CellId, cs_NR_AS_SecurityStart_REQ(p_NR_CellId, cs_NR_AS_IntProt_CiphActivate(p_AS_IntegrityInfo, p_AS_CipheringInfo), p_TimingInfo));
  }

  /*
   * @desc      release AS security at the SS
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_RRC_ReleaseSecurity(NR_CellId_Type p_NR_CellId,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC
  {
    f_NR_SS_AS_SecurityConfig(p_NR_CellId, cs_NR_AS_SecurityRelease_REQ(p_NR_CellId, p_TimingInfo));
  }

  /*
   * @desc      Common function to configure AS security
   * @param     p_NR_CellId
   * @param     p_SYSTEM_CTRL_REQ
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_AS_SecurityConfig(NR_CellId_Type p_NR_CellId,
                                     template (value) NR_SYSTEM_CTRL_REQ p_SYSTEM_CTRL_REQ) runs on NR_BASE_PTC
  {
    SYS.send(p_SYSTEM_CTRL_REQ);
    if (valueof(p_SYSTEM_CTRL_REQ.Common.ControlInfo.CnfFlag) == true) {
      SYS.receive(car_NR_AsSecurity_CNF(p_NR_CellId));
    }
  }

  /*
   * @desc      depending on the given format p_PdcpCount is converted to integer
   * @param     p_PdcpCount
   * @return    NR_PdcpSQN_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SQN_ConvertFromPdcpCount(NR_PdcpCount_Type p_PdcpCount) return NR_PdcpSQN_Type
  {
    var NR_PdcpSQN_Type v_PdcpSQN;
    var bitstring v_Bitstring := p_PdcpCount.Value;
    
    select (p_PdcpCount.Format) {
      
      case (PdcpCount_Srb, PdcpCount_DrbSQN12) {
        v_Bitstring := substr(v_Bitstring, 20, 12); /* 20 bit HFN; 12 bit SQN */
      }
      case (PdcpCount_DrbSQN18) {
        v_Bitstring := substr(v_Bitstring, 14, 18);/* 14 bit HFN; 18 bit SQN */
      }
    }
    v_PdcpSQN.Format := p_PdcpCount.Format;
    v_PdcpSQN.Value := bit2int(v_Bitstring);
    return v_PdcpSQN;
  }

  /*
   * @desc      increment PDCP SQN
   * @param     p_PdcpSQN
   * @return    NR_PdcpSQN_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SQN_Increment(NR_PdcpSQN_Type p_PdcpSQN) return NR_PdcpSQN_Type
  {
    var NR_PdcpSQN_Type v_PdcpSQN := p_PdcpSQN;
    
    select (p_PdcpSQN.Format) {
      case (PdcpCount_DrbSQN18) {
        v_PdcpSQN.Value := (p_PdcpSQN.Value + 1) mod 262144;
      }
      case (PdcpCount_Srb, PdcpCount_DrbSQN12) {
        v_PdcpSQN.Value := (p_PdcpSQN.Value + 1) mod 4096;
      }
    }
    return v_PdcpSQN;
  }

  /*
   * @desc      Common function to request PDCP sequence numbers
   * @param     p_NR_CellId
   * @param     p_RadioBearerId     (default value: omit)
   * @return    NR_PdcpCountInfoList_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_PdcpCount_Get(NR_CellId_Type p_NR_CellId,
                                 template (omit) NR_RadioBearerId_Type p_RadioBearerId:= omit) runs on NR_BASE_PTC return NR_PdcpCountInfoList_Type
  {
    var NR_SYSTEM_CTRL_CNF v_ReceivedAsp;
    var template (value) NR_PDCP_CountReq_Type v_PdcpCount := cs_NR_PDCP_CountGet_AllRBs;
    var template (present) NR_PDCP_CountCnf_Type v_PdcpCountCnf := {Get := ?};
    
    if (isvalue(p_RadioBearerId)) {
      v_PdcpCount := cs_NR_PDCP_CountGet_SingleRB(valueof(p_RadioBearerId));
    }
    SYS.send(cas_NR_PdcpCount_REQ (p_NR_CellId, v_PdcpCount));
    SYS.receive(car_NR_PdcpCount_CNF(p_NR_CellId, v_PdcpCountCnf)) -> value v_ReceivedAsp;

    return v_ReceivedAsp.Confirm.PdcpCount.Get;
  }

  /*
   * @desc      Common function to enquire PDCP sequence numbers and generate a ciphering activation list for everything that's already configured
   * @param     p_NR_CellId
   * @return    NR_SecurityActTimeList_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RRC_CipherActTime_GetInitial(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_SecurityActTimeList_Type
  {
    return f_NR_RRC_CipherActTime_GetCurrent(p_NR_CellId, true);
  }

  /*
   * @desc      Common functon to enquire PDCP sequence numbers and generate a ciphering activation list for everything that's already configured
   * @param     p_NR_CellId
   * @param     p_IncrSRB1
   * @param     p_IncrSRB1_DL       (default value: false)
   * @param     p_PdcpCountInfoList (default value: omit)
   * @return    NR_SecurityActTimeList_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RRC_CipherActTime_GetCurrent(NR_CellId_Type p_NR_CellId,
                                             boolean p_IncrSRB1,
                                             boolean p_IncrSRB1_DL := false,
                                             template (omit) NR_PdcpCountInfoList_Type p_PdcpCountInfoList:= omit
                                             ) runs on NR_BASE_PTC return NR_SecurityActTimeList_Type
  { //@sic R5s220123: added p_PdcpCountInfoList sic@
    var NR_PdcpCountInfoList_Type v_PdcpCountInfoList;
    var NR_PdcpCountInfo_Type v_PdcpCountInfo;
    var NR_PDCP_ActTime_Type v_PDCP_ActTimeUL;
    var NR_PDCP_ActTime_Type v_PDCP_ActTimeDL;
    var NR_RadioBearerId_Type v_RadioBearerId;
    var NR_SecurityActTime_Type v_SecurityActTime;
    var integer I;
    var NR_SecurityActTimeList_Type v_SecurityActTimeList;
   
    if (isvalue(p_PdcpCountInfoList)) {
        v_PdcpCountInfoList := valueof(p_PdcpCountInfoList);
    } else {
       v_PdcpCountInfoList := f_NR_SS_PdcpCount_Get(p_NR_CellId);
    }
    
    for (I:=0; I < lengthof(v_PdcpCountInfoList); I:=I+1) {
      v_PdcpCountInfo := v_PdcpCountInfoList[I];
      if ((not ispresent(v_PdcpCountInfo.UL)) or (not ispresent(v_PdcpCountInfo.DL))) {
        FatalError(__FILE__, __LINE__, "missing PdcpCountInfo for UL or DL");
      }
      
      v_RadioBearerId := v_PdcpCountInfo.RadioBearerId;
      // Convert PdcpCount to integer value (UL an DL)
      v_PDCP_ActTimeUL.SQN := f_NR_SQN_ConvertFromPdcpCount(v_PdcpCountInfo.UL);
      v_PDCP_ActTimeDL.SQN := f_NR_SQN_ConvertFromPdcpCount(v_PdcpCountInfo.DL);
      
      // increment SQN for SRB1 (UL and DL)
      if (p_IncrSRB1 and (ischosen(v_RadioBearerId.Srb) and (v_RadioBearerId.Srb == tsc_SRB1))) { // @sic R5s190214 sic@
        v_PDCP_ActTimeUL.SQN := f_NR_SQN_Increment(v_PDCP_ActTimeUL.SQN);
        v_PDCP_ActTimeDL.SQN := f_NR_SQN_Increment(v_PDCP_ActTimeDL.SQN);
      }

      // When transmitting RRCReestablishment to UE on DL SRB1 ciphering is not applied
      // When receiving RRCReestablishemntComplete on UL SRB1 ciphering is applied by UE.
      // So the new ciphering keys needs to be applied at SN+1 in DL and at SN in UL => increment DL SN only
      // @sic R5s201221 sic@
      if ((p_IncrSRB1_DL) and (ischosen(v_RadioBearerId.Srb) and (v_RadioBearerId.Srb == tsc_SRB1))) {
        v_PDCP_ActTimeDL.SQN := f_NR_SQN_Increment(v_PDCP_ActTimeDL.SQN);
      }
      
      // set activation time
      v_SecurityActTime.RadioBearerId := v_RadioBearerId;
      v_SecurityActTime.UL := v_PDCP_ActTimeUL;
      v_SecurityActTime.DL := v_PDCP_ActTimeDL;
      
      v_SecurityActTimeList[I] := v_SecurityActTime;
    }
    return v_SecurityActTimeList;
  }

  /*
   * @desc      return list of alls DRBs which are currently configured at the SS
   * @param     p_NR_CellId
   * @return    IntegerList_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetActiveDRBs(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return IntegerList_Type
  {
    var NR_PdcpCountInfoList_Type v_PdcpCountInfoList := f_NR_SS_PdcpCount_Get(p_NR_CellId);
    var IntegerList_Type v_DRBList := {};
    var integer i;
    var integer j := 0;
    
    for (i :=0; i < lengthof(v_PdcpCountInfoList); i := i+1) {
      if (ischosen (v_PdcpCountInfoList[i].RadioBearerId.Drb)) {
        v_DRBList[j] := v_PdcpCountInfoList[i].RadioBearerId.Drb;
        j := j+1;
      }
    }
    return v_DRBList;
  }

  /*
   * @desc      Get the current PDCP count, get AS security and activate it using these sequence numbers
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_PdcpCountInfoList (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SS_AS_ActivateSecurity_NoRefresh( NR_CellId_Type p_NR_CellId,
                                                  template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                  template (omit) NR_PdcpCountInfoList_Type p_PdcpCountInfoList:= omit //@sic R5s240414 sic@
                                                  ) runs on NR_BASE_PTC
  {
    var NR_SecurityParams_Type v_RRC_SecurityParams := f_NR_Security_Get();
    v_RRC_SecurityParams.AS_Ciphering.ActTimeList := f_NR_RRC_CipherActTime_GetCurrent(p_NR_CellId, false, -, p_PdcpCountInfoList); //@sic R5s240414 sic@
    f_NR_SS_RRC_EnableIntProt_CiphULandDL(p_NR_CellId,
                                          v_RRC_SecurityParams.AS_Integrity,
                                          v_RRC_SecurityParams.AS_Ciphering,
                                          p_TimingInfo);
    
    f_NR_Security_Set(v_RRC_SecurityParams);
  }

}
