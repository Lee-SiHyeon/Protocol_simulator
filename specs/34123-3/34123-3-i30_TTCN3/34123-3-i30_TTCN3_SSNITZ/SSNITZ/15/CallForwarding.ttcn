module CallForwarding {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTypeDefs all;
  import from SS_CommonFunctions all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_Parameters all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UpperTesterFunctions all;

  template (present) Cau cr_CauResponseToStatusEnquiry := cr_CauAny(omit, '0011110'B);   /* @status    APPROVED (SSNITZ)
                                                                                            Table 10.5.123/3GPP TS 24.008: Cause information element values. Response to STATUS ENQUIRY */

  template (present) Invoke cr_InvokeCFNRy(AddressString p_ForwardedToNumber,
                                           NoReplyConditionTime p_NoReplyConditionTime) :=
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeRegister(?,                   // InvokeId
                      tsc_SS_Code_CFNRy,
                      (cr_Teleservice_AllSpeech, cr_Teleservice_TS11),
                      p_ForwardedToNumber,
                      omit, // ISDN_SubaddressString
                      p_NoReplyConditionTime);

  template (value) ReturnResult cs_ReturnResultRegisterCFNRy(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                             SS_Code p_SS_Code,
                                                             template (omit) BasicServiceCode p_BasicServiceCode := omit,
                                                             template (omit) AddressString p_ForwardedToNumber := omit,
                                                             template (omit) NoReplyConditionTime p_NoReplyConditionTime := omit) :=
  /* @status    APPROVED (SSNITZ) */
    cs_ReturnResultRegister(p_InvokeId, cs_SS_InfoCF(p_SS_Code, p_BasicServiceCode, p_ForwardedToNumber, p_NoReplyConditionTime, tsc_SS_StatusPR));

  template (value) SS_Info cs_SS_InfoCF(SS_Code p_SS_Code,
                                        template (omit) BasicServiceCode p_BasicServiceCode := omit,
                                        template (omit) AddressString p_ForwardedToNumber := omit,
                                        template (omit) NoReplyConditionTime p_NoReplyConditionTime := omit,
                                        template (value) SS_Status p_Ss_Status := tsc_SS_StatusPRA):=
  { /* @status    APPROVED (SSNITZ) */
    forwardingInfo := {
      ss_Code := p_SS_Code,
      forwardingFeatureList := {
        {
          basicService := p_BasicServiceCode,
          ss_Status := p_Ss_Status,
          forwardedToNumber := p_ForwardedToNumber,
          forwardedToSubaddress := omit,
          forwardingOptions := omit,
          noReplyConditionTime := p_NoReplyConditionTime,
          longForwardedToNumber := omit
        }
      }
    }
  };

  template (present) Invoke cr_InvokeCFU(AddressString p_ForwardedToNumber) :=
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeRegister(?,                   // InvokeId
                      tsc_SS_Code_CFU,     // SS_Code
                      (cr_Teleservice_AllSpeech, cr_Teleservice_TS11),
                      p_ForwardedToNumber);

  template (value) ReturnResult cs_ReturnResultRegisterCFU(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                           SS_Code p_SS_Code,
                                                           BasicServiceCode p_BasicServiceCode,
                                                           AddressString p_ForwardedToNumber) :=
  /* @status    APPROVED (SSNITZ) */
    cs_ReturnResultRegister(p_InvokeId, cs_SS_InfoCF(p_SS_Code, p_BasicServiceCode, p_ForwardedToNumber, omit, tsc_SS_StatusPR));

  template (present) Invoke cr_InvokeErase_SSCode(template SS_Code p_SS_Code,
                                                  template BasicServiceCode p_BasicServiceCode := omit) := // p_BasicServiceCode omit implies all services
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeErase(?, cr_SS_ForBS_Code(p_SS_Code, p_BasicServiceCode));

  template (value) ReturnResult cs_ReturnResultErase_CF(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                        SS_Code p_SS_Code,
                                                        template (omit) BasicServiceCode p_BasicServiceCode := omit) :=
  /* @status    APPROVED (SSNITZ) */
    cs_ReturnResultErase(p_InvokeId, cs_SS_InfoCF(p_SS_Code, p_BasicServiceCode, -, -, tsc_SS_StatusProvisioned)); // @sic R5s160130 Ch.2 sic@

  template (present) Invoke cr_InvokeActivate_SSCode_BearerService(SS_Code p_SS_Code,
                                                                   template (omit) BasicServiceCode p_BasicServiceCode := omit) :=
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeActivate(?, cr_SS_ForBS_Code(p_SS_Code, p_BasicServiceCode));

  template (value) ReturnResult cs_ReturnResultActivate_CF(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                           SS_Code p_SS_Code):=
  /* @sic R5s200154 sic@
     @status    APPROVED (SSNITZ) */
    cs_ReturnResultActivate(p_InvokeId, cs_SS_InfoCF(p_SS_Code, omit, omit, omit, tsc_SS_StatusPR));

  template (present) Invoke cr_InvokeDeactivate_SSCode_BearerService(SS_Code p_SS_Code) :=  //@sic R5-144613 sic@
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeDeactivate(?,                   // InvokeId
                        cr_SS_ForBS_Code(p_SS_Code, (cr_Teleservice_AllSpeech, cr_Teleservice_TS11)));

  template (value) ReturnResult cs_ReturnResultDeactivate_CF(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                             SS_Code p_SS_Code) :=
  /* @status    APPROVED (SSNITZ) */
    cs_ReturnResultDeactivate(p_InvokeId,  // tsc_InvokeId - to be updated during the procedure
                              cs_SS_InfoCF(p_SS_Code, omit, omit, omit, tsc_SS_StatusPR));

  template (present) Invoke cr_InvokeInterrogate_SSCode_BearerService(template SS_Code p_SS_Code, //@sic R5-144614 sic@ @sic R5-144615 sic@
                                                  template BasicServiceCode p_BasicServiceCode := omit) :=
  /* @status    APPROVED (SSNITZ) */
    cr_InvokeInterrogate(?, cr_SS_ForBS_Code(p_SS_Code, p_BasicServiceCode));

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_1_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Registration accepted  */
   
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var charstring v_ForwardedToNumber:= "01234556789"; //Any number
    // ASN.1 requires number in BCD format with prefix octet describing numbering plan
    var octetstring v_ForwardedToNumber_ForASN1 := tsc_NumberingPlan_Oct & f_CharPacking_IA5toBCD(v_ForwardedToNumber); // @sic R5s150538 sic@
    var NoReplyConditionTime v_NoReplyConditionTime := 15; //Any number
    var charstring v_NoReplyConditionTime_Charstring := int2str(v_NoReplyConditionTime); // @sic R5s160839 sic@
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var boolean v_DoAuth := true;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFNRy, then step 1 to 10 are executed
    if (pc_SS_CallForwardinoNoReply) {
      
      // @siclog "Step 1" siclog@
      // The UE is made to initiate a registration of call forwarding service for CFNRy (Speech)
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            REGISTER_MODE,
                                            SS_CFNRy,
                                            v_ForwardedToNumber,
                                            v_NoReplyConditionTime_Charstring,
                                            SS_SPEECH);
      
      // @siclog "Steps 2-7 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeCFNRy(v_ForwardedToNumber_ForASN1, v_NoReplyConditionTime),  // @sic R5s150538 sic@
                                                      "Step 2",
                                                      "Step 7",
                                                      v_DoAuth); //Steps 3-4 enabled
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      v_DoAuth := false;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultRegisterCFNRy(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                           tsc_SS_Code_CFNRy,
                                                                                                           v_FacilityInvoke[0].invoke.parameter.registerSS.basicService,
                                                                                                           v_ForwardedToNumber_ForASN1,  // @sic R5s150538 sic@
                                                                                                           v_NoReplyConditionTime))));
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 8" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 9" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 10" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFNRy", "Registration of CFNRy")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
      }
    }
    //If UE supports CFU, then step 11 to 20 are executed
    if (pc_SS_CallForwardingUnconditional) {
      // @siclog "Step 11" siclog@
      // The UE is made to initiate a registration of call forwarding service for CFU (Speech).
      // "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            REGISTER_MODE,
                                            SS_CFU,
                                            v_ForwardedToNumber,
                                            -,
                                            SS_SPEECH);
      // @siclog "Steps 12-17 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeCFU(v_ForwardedToNumber_ForASN1),  // @sic R5s150538 sic@
                                                      "Step 12",
                                                      "Step 17",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultRegisterCFU(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                         tsc_SS_Code_CFU,
                                                                                                         v_FacilityInvoke[0].invoke.parameter.registerSS.basicService,
                                                                                                         v_ForwardedToNumber_ForASN1)))); // @sic R5s150538 sic@
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 18" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 19" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 20" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFU", "registration of call forwarding service for CFU")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 20");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
      }
    }
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_2_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Registration rejected */
   
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var octetstring v_EncodedComponents;
    var charstring v_ForwardedToNumber:= "01234556789"; //Any number
    var octetstring v_ForwardedToNumber_ForASN1 := tsc_NumberingPlan_Oct & f_CharPacking_IA5toBCD(v_ForwardedToNumber); // @sic R5s150538 sic@
    var NoReplyConditionTime v_NoReplyConditionTime := 15; //Any number
    var charstring v_NoReplyConditionTime_Charstring := int2str(v_NoReplyConditionTime); // @sic R5s160839 sic@
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    
    // @sic R5s160129 sic@ Introduced additional variables to consider the possibility that the UE may use different TI values for call related and non call related supplementary services
    var TI v_TI_R_CC;
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;
    
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); //Establishment of an outgoing call TS34.123, Table 10.1.2/3
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFNRy, then step 1 to 8 are executed
    if (pc_SS_CallForwardinoNoReply) {
      
      // @siclog "Step 1" siclog@
      // The UE is made to initiate a registration of call forwarding service for CFNRy (Speech)"
      f_UT_SupplementaryService_CallForward(UT,
                                            REGISTER_MODE,
                                            SS_CFNRy,
                                            v_ForwardedToNumber,
                                            v_NoReplyConditionTime_Charstring,
                                            SS_SPEECH);
      // @siclog "Steps 2-4" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeCFNRy(v_ForwardedToNumber_ForASN1, v_NoReplyConditionTime), // @sic R5s150538 sic@
                                                                "Step 2",
                                                                "Step 4");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B); // @sic R5s160129 sic@
      
      // Assign invokeID in the ReturnError with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode (v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_BearerServiceNotProvisioned))));
      
      // @siclog "Step 5" siclog@
      // SS sends RELEASE COMPLETE with Return error component with BearerServiceNotProvisioned
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 6" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFNRy", "Registration failure due to BearerService Not Provisioned")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
      }
      
      // @siclog "Step 7-8" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
      
    }
    
    //If UE supports CFU, then step 9 to 16 are executed
    if (pc_SS_CallForwardingUnconditional) {
      // @siclog "Step 9" siclog@
      // The UE is made to initiate a registration of call forwarding service for CFU (Speech)
      f_UT_SupplementaryService_CallForward(UT,
                                            REGISTER_MODE,
                                            SS_CFU,
                                            v_ForwardedToNumber,
                                            -,
                                            SS_SPEECH);
      // @siclog "Steps 10-12" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeCFU(v_ForwardedToNumber_ForASN1), // @sic R5s150538 sic@
                                                                "Step 10",
                                                                "Step 12");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);     // @sic R5s160129 sic@
      
      
      // @siclog "Step 13" siclog@
      // RegisterSS operation Return reject component with cause "resource limitation"
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_EncodedComponents)))); // @sic R5s150540 sic@
      // @siclog "Step 14" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFU", "Registration failure due to Resource limitation")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
      }
      
      // @siclog "Step 15-16" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 16", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
      
    }
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.3
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_3_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Erasure accepted */
   
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var boolean v_DoAuth := true;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    // If UE supports CFB, then step 1 to 10 are executed.
    // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling".
    if (pc_SS_CallForwardingSubscriberBusy) {
      // @siclog "Step 1" siclog@
      // The UE is made to initiate erasure of call forwarding for CFB (all basic services)
      f_UT_SupplementaryService_CallForward(UT,
                                            DELETE_MODE,
                                            SS_CFB,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_ALLSERVICES); // @sic R5s160130 Ch.1 sic@

      
      // @siclog "Steps 2-7 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeErase_SSCode(tsc_SS_Code_CFB),
                                                      "Step 2",
                                                      "Step 7",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      v_DoAuth := false;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultErase_CF(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                      tsc_SS_Code_CFB))));
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 8" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));

      // @siclog "Step 9 - Void" siclog@
      // @sic R5-153699 sic@

      // @siclog "Step 10" siclog@
      // The SS releases the RRC connection
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);

      // @siclog "Step 10a" siclog@
      // @sic R5-153699 sic@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFB", "Successful erasure of call forwarding service for CFB")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10a");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10a");
      }
    }
    
    //If UE supports CFNRc, then step 11 to 18 are executed
    if (pc_SS_CallForwardingSubscriberNotReachable) {
      // @siclog "Step 11" siclog@
      // The UE is made to initiate a erasure of call forwarding service for CFNRc (all basic services)
      // "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            DELETE_MODE,
                                            SS_CFNRc,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_ALLSERVICES); // @sic R5s160130 Ch.1 sic@

      // @siclog "Steps 12-17" siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeErase_SSCode(tsc_SS_Code_CFNRc),
                                                      "Step 12",
                                                      "Step 17",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultErase_CF(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                      tsc_SS_Code_CFNRc))));
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 18" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      // @siclog "Step 19" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 20 " siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFNRc", "Successful erasure of call forwarding service for CFNRc (all basic services)")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 20");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
      }
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.4
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_4_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Erasure rejected */
    
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var octetstring v_EncodedComponents;
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;

    // @sic R5s160151 sic@ Introduced additional variables to consider the possibility that the UE may use different TI values for call related and non call related supplementary services
    var TI v_TI_R_CC;
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); //Establishment of an outgoing call TS34.123, Table 10.1.2/3
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFB, then steps 1 to 8 are executed
    if (pc_SS_CallForwardingSubscriberBusy) {
      
      // @siclog "Step 1" siclog@
      // The UE is made to initiate erasure of call forwarding for CFB (speech)
      f_UT_SupplementaryService_CallForward(UT,
                                            DELETE_MODE,
                                            SS_CFB,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_SPEECH);
      
      // @siclog "Steps 2-4" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeErase_SSCode(tsc_SS_Code_CFB, (cr_Teleservice_AllSpeech, cr_Teleservice_TS11)), "Step 2", "Step 4");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);
        
      // Assign invokeID in the ReturnError with the value received in the Register at Step4
      //@sic R5-144611 sic@
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode (v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_TeleServiceNotProvisioned))));
      
      // @siclog "Step 5" siclog@
      // SS sends RELEASE COMPLETE with Return error component with TeleServiceNotProvisioned
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 6" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFB", "EraseSS operation failure due to BearerService Not Provisioned")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
      }
        
      // @siclog "Step 7-8" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
      
    }
    
    //If UE supports CFNRc, then steps 9 to 16 are executed
    if (pc_SS_CallForwardingSubscriberNotReachable) {
      // @siclog "Step 9" siclog@
      // The UE is made to initiate erasure of call forwarding service for CFNRc (all basic services)
      f_UT_SupplementaryService_CallForward(UT,
                                            DELETE_MODE,
                                            SS_CFNRc,
                                            omit,
                                            -,
                                            SS_ALLSERVICES); // @sic R5s160913 R5s170076 sic@
      
      // @siclog "Steps 10-12" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeErase_SSCode(tsc_SS_Code_CFNRc),
                                                                "Step 10",
                                                                "Step 12");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);

      // @siclog "Step 13" siclog@
      // ErasureSS operation Return reject component with cause "resource limitation"
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_EncodedComponents)))); // @sic R5s150540 sic@
      // @siclog "Step 14" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFNRc", "EraseSS operation failure due to Resource limitation")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
      }
      
      // @siclog "Step 15-16" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 16", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
      
    }
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.5
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_5_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Activation */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var boolean v_DoAuth := true;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFB, then step 1 to 10 are executed.
    if (pc_SS_CallForwardingSubscriberBusy) {
      // @siclog "Step 1" siclog@
      // The UE is made to initiate an activation of call forwarding service for CFB (all synchronous services).
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            ACTIVATE_MODE,
                                            SS_CFB,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_SYNC);
                              
      // @siclog "Steps 2-7 " siclog@
      // RAN5 agreed should only test Speech.  All synchronous services must be removed from the prose
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeActivate_SSCode_BearerService(tsc_SS_Code_CFB, cr_BearerService_AllSynchronousServices),
                                                      "Step 2",
                                                      "Step 7",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      v_DoAuth := false;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate_CF(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                         tsc_SS_Code_CFB))));
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 8" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 9" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      
      // @siclog "Step 10" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFB", "Successful activation of call forwarding service for CFB (all synchronous services)")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
      }
    }
    //If UE supports CFU, then step 11 to 20 are executed
    if (pc_SS_CallForwardingUnconditional) {
      // @siclog "Step 11" siclog@
      // The UE is made to initiate an activation of call forwarding service for CFU (all basic service groups).
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            ACTIVATE_MODE,
                                            SS_CFU,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_ALLSERVICES); // @sic R5s160255 sic@
      
      // @siclog "Steps 12-17 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeActivate_SSCode_BearerService(tsc_SS_Code_CFU),
                                                      "Step 12",
                                                      "Step 17",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate_CF(v_FacilityInvoke[0].invoke.invokeID, tsc_SS_Code_CFU))));
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 18" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 19" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 20" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFU", "Successful activation of call forwarding service for CFU (all basic service groups)")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 20");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
      }
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.6
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_6_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Deactivation  */

    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var boolean v_DoAuth := true;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFB, then step 1 to 10 are executed.
    if (pc_SS_CallForwardingSubscriberBusy) {
      // @siclog "Step 1" siclog@
      // The UE is made to initiate a deactivation of call forwarding service for CFB (speech).
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            DEACTIVATE_MODE,
                                            SS_CFB,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_SPEECH);
      
      // @siclog "Steps 2-7 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeDeactivate_SSCode_BearerService(tsc_SS_Code_CFB),
                                                      "Step 2",
                                                      "Step 7",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      v_DoAuth := false;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultDeactivate_CF(v_FacilityInvoke[0].invoke.invokeID, tsc_SS_Code_CFB))));
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 8" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 9" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 10" siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFB", "Successful deactivation of call forwarding service for CFB (speech)")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
      }
    }
    //If UE supports CFNRc, then step 11 to 20 are executed
    if (pc_SS_CallForwardingSubscriberNotReachable) {
      // @siclog "Step 11" siclog@
      // The UE is made to initiate a deactivation of call forwarding service for CFNRc (speech)
      f_UT_SupplementaryService_CallForward(UT,
                                            DEACTIVATE_MODE,
                                            SS_CFNRc,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_SPEECH);
      
      // @siclog "Steps 12-17 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeDeactivate_SSCode_BearerService(tsc_SS_Code_CFNRc),
                                                      "Step 12",
                                                      "Step 17",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultDeactivate_CF(v_FacilityInvoke[0].invoke.invokeID, tsc_SS_Code_CFNRc))));
      
      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // @siclog "Step 18" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 19" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 20 " siclog@
      // Provide user indication
      if (f_UT_ChkSuppServiceUserIndication(UT, "CFNRc", "Successful deactivation of call forwarding service for CFNRc (speech)")) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 20");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
      }
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.7
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_7_UTRAN() runs on UTRAN_PTC
  { /* Call forwarding supplementary services, Interrogation accepted  */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var charstring v_ForwardedToNumber:= "01234556789"; //Any number
    var octetstring v_ForwardedToNumber_ForASN1 := tsc_NumberingPlan_Oct & f_CharPacking_IA5toBCD(v_ForwardedToNumber); // @sic R5s150538 sic@
    var NoReplyConditionTime v_NoReplyConditionTime := 15; //Any number
    var charstring v_NoReplyConditionTime_Charstring := int2str(v_NoReplyConditionTime); // @sic R5s160839 sic@
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var boolean v_DoAuth := true;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFB, then step 1 to 10 are executed.
    if (pc_SS_CallForwardingSubscriberBusy) {
      // @siclog "Step 1" siclog@
      // The UE is made to initiate an interrogation of call forwarding service for CFB (all).
      // The SS verifies that the IE "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            QUERY_MODE,
                                            SS_CFB,
                                            omit, // @sic R5s160913 sic@
                                            -,
                                            SS_ALLSERVICES);  // @sic R5s160971 Ch. 1 sic@
      // @siclog "Steps 2-7 " siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeInterrogate_SSCode_BearerService(tsc_SS_Code_CFB),
                                                      "Step 2",
                                                      "Step 7",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      v_DoAuth := false;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultInterrogate_ParamInterrogate(v_FacilityInvoke[0].invoke.invokeID, // @sic R5s160971 Ch. 2 sic@
                                                                                                                          v_FacilityInvoke[0].invoke.parameter.interrogateSS.basicService,
                                                                                                                          v_ForwardedToNumber_ForASN1,
                                                                                                                          -,
                                                                                                                          tsc_SS_StatusPR)))); // @sic R5s150538 R5s190950 sic@

      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // Set up the upper tester to receive an unsolicited response
      f_UT_TriggerCallForwardResponse (UT, false); //  @sic R5-153746 R5s160971 Ch. 2.1 sic@
      //expected output parameterised as part of dummy command
      
      // @siclog "Step 8" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 9" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 10" siclog@
      // Provide user indication
      if (f_UT_ChkCallForwardQueryResponse(UT, false)) { // @sic R5s160971 Ch. 3 sic@
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
      }
    }
    //If UE supports CFNRy, then step 11 to 20 are executed
    if (pc_SS_CallForwardinoNoReply) {
      // @siclog "Step 11" siclog@
      // The UE is made to initiate an interrogation of call forwarding service for CFNRy(speech).
      // "Establishment cause" in the received RRC CONNECTION REQUEST message is set to "Originating High Priority Signalling"
      f_UT_SupplementaryService_CallForward(UT,
                                            QUERY_MODE,
                                            SS_CFNRy,
                                            omit, // @sic R5s160913 sic@
                                            v_NoReplyConditionTime_Charstring,
                                            SS_SPEECH);
      // @siclog "Steps 12-17" siclog@
      v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                      cr_InvokeInterrogate_SSCode_BearerService(tsc_SS_Code_CFNRy, (cr_Teleservice_AllSpeech, cr_Teleservice_TS11)),
                                                      "Step 12",
                                                      "Step 17",
                                                      v_DoAuth);
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R := v_ReceiveRegisterResult.ti;
      
      // Assign invokeID in the ReturnResult with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultInterrogate_ParamInterrogate(v_FacilityInvoke[0].invoke.invokeID,
                                                                                                                          v_FacilityInvoke[0].invoke.parameter.interrogateSS.basicService,
                                                                                                                          v_ForwardedToNumber_ForASN1, // @sic R5s150538 sic@
                                                                                                                          v_NoReplyConditionTime,
                                                                                                                          tsc_SS_StatusPRA))));  // @sic R5s190950 sic@

      // Set TI value for response to be sent from the SS
      v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
      
      // Set up the upper tester to receive an unsolicited response
      f_UT_TriggerCallForwardResponse (UT, true); //  @sic R5-153746 R5s160971 Ch. 2.1 sic@
      //expected output parameterised as part of dummy command
      
      // @siclog "Step 18" siclog@
      // SS sends RELEASE COMPLETE with the ReturnResult
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 19" siclog@
      // The SS releases the RRC connection.
      f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
      
      // @siclog "Step 20" siclog@
      // Provide user indication
      if (f_UT_ChkCallForwardQueryResponse(UT, true)) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 20");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
      }
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.4.8
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_4_8_UTRAN() runs on UTRAN_PTC
  {
    /* Call forwarding supplementary services, Interrogation rejected */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var octetstring v_EncodedComponents;
    var NoReplyConditionTime v_NoReplyConditionTime := 15; //Any number
    var charstring v_NoReplyConditionTime_Charstring := int2str(v_NoReplyConditionTime); // @sic R5s160839 sic@
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    
    var TI v_TI_R_CC;
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true);
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    //If UE supports CFB, then steps 1 to 8 are executed
    if (pc_SS_CallForwardingSubscriberBusy) {
      
      // @siclog "Step 1" siclog@
      // The UE is made to initiate an interrogation of call forwarding service for CFB (all)
      f_UT_SupplementaryService_CallForward(UT,
                                            QUERY_MODE,
                                            SS_CFB,
                                            omit,  // @sic R5s160913 sic@
                                            -,
                                            SS_ALLSERVICES); // @sic R5s160972 Ch. 1 sic@
      
      // @siclog "Steps 2-4" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeInterrogate_SSCode_BearerService(tsc_SS_Code_CFB),
                                                                "Step 2",
                                                                "Step 4");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);
        
      // Assign invokeID in the ReturnError with the value received in the Invoke
      v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode (v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_SSNotAvailable))));
      
      // Set up the upper tester to receive an unsolicited response
      f_UT_TriggerCallForwardResponse (UT, false); //  @sic R5-153746 R5s160972 sic@
      //expected output parameterised as part of dummy command
      
      // @siclog "Step 5" siclog@
      // SS sends RELEASE COMPLETE with Return error component with SS-NotAvailable
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn))));
      
      // @siclog "Step 6" siclog@
      // Provide user indication
      if (f_UT_ChkCallForwardQueryResponse(UT, false)) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
      }
      
      // @siclog "Step 7-8" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
    }
    
    //If UE supports CFNRy, then step 9 to 16 are executed
    if (pc_SS_CallForwardinoNoReply) {
      // @siclog "Step 9" siclog@
      // The UE is made to initiate an interrogation of call forwarding service for CFNRy(speech)
      f_UT_SupplementaryService_CallForward(UT,
                                            QUERY_MODE,
                                            SS_CFNRy,
                                            omit, // @sic R5s160913 sic@
                                            v_NoReplyConditionTime_Charstring,
                                            SS_SPEECH);
      
      // @siclog "Steps 10-12" siclog@
      // CM SERVICE REQUEST - CM SERVICE ACCEPT - REGISTER
      v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeInterrogate_SSCode_BearerService
                                                                (tsc_SS_Code_CFNRy,(cr_Teleservice_AllSpeech, cr_Teleservice_TS11)),
                                                                "Step 10",
                                                                "Step 12");
      v_FacilityInvoke := v_ReceiveRegisterResult.components;
      v_TI_R_SS := v_ReceiveRegisterResult.ti;
      
      // Set TI value for response to be sent from the SS
      v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);
      
      // Set up the upper tester to receive an unsolicited response
      f_UT_TriggerCallForwardResponse (UT, false); //  @sic R5-153746 R5s160972 sic@
      //expected output parameterised as part of dummy command
      
      // @siclog "Step 13" siclog@
      // InterrogateSS operation Return reject component with cause "resource limitation"
      v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_EncodedComponents))));
      // @siclog "Step 14" siclog@
      // Provide user indication
      if (f_UT_ChkCallForwardQueryResponse(UT, false)) {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
      } else {
        f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
      }
      
      // @siclog "Step 15-16" siclog@
      f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 16", cr_CauResponseToStatusEnquiry, tsc_CallState_U10);
      
    }
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

}
