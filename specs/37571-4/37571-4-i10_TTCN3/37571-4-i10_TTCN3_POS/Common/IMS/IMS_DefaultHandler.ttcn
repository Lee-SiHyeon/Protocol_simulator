module IMS_DefaultHandler {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;

  type enumerated IMS_DefaultHandlerState_Type { WaitForRegistration, WaitForReregistration, WaitForDeregistration, NoRegistration };  /* @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
                                                                                                                                          @sic R5-169150: NoRegistration sic@ */

  type record IMS_DefaultHandlerInfo_Type {  /* @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */
    IMS_DefaultHandlerState_Type State,
    IMS_IpcanPortType_Type IpcanType
  };

  /*
   * @desc      Send coordination message to IPCAN or OtherIPCAN
   * @param     p_IpcanType          (default value: IPCAN_E)
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_DefaultHandler_SendCoOrdMsg(IMS_IpcanPortType_Type p_IpcanType := IPCAN_E) runs on IMS_PTC
  {
    select (p_IpcanType) {
      case (IPCAN_E) {
        f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
      }
      case else {
        f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN);
      }
    }
  }

  /*
   * @desc      Initial IMS registration with synchronistion between IMS and IPCAN
   * @param     p_IpcanType         (default value: IPCAN_E)
   * @param     p_IMS_DATA_REQ      (default value: omit)
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_DefaultHandler_InitialRegistration(IMS_IpcanPortType_Type p_IpcanType := IPCAN_E,
                                                    template (omit) IMS_DATA_REQ p_IMS_DATA_REQ := omit) runs on IMS_PTC
  { /* @sic R5s140788 change 2: new function sic@ */
    /* @sic R5s160133: p_IpcanType sic@ */
    fl_IMS_DefaultHandler_SendCoOrdMsg(p_IpcanType);   /* send trigger to EUTRA PTC to indicate start of IMS registration @sic R5-123731 sic@ */
    f_IMS_Registration(p_IpcanType, p_IMS_DATA_REQ);
    f_IMS_TCP_CloseHandling(justWait);                 /* @sic R5s140219 - MCC160 implementation (UE may close the unprotected connection) sic@ */
    fl_IMS_DefaultHandler_SendCoOrdMsg(p_IpcanType);   /* send trigger to EUTRA PTC to indicate end of IMS registration @sic R5-123731 sic@ */
  }

  /*
   * @desc      procedure to re-register UE acc. to 34.229-1 C.46
   * @param     p_IpcanType
   * @param     p_IMS_DATA_REQ      (default value: omit)
   * @param     p_NonceCount
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_DefaultHandler_Reregistration(IMS_IpcanPortType_Type p_IpcanType,
                                                template (omit) IMS_DATA_REQ p_IMS_DATA_REQ := omit,
                                                integer p_NonceCount) runs on IMS_PTC
  { /* NOTE: RanType needs to be set correctly at the IMS PTC (e.g. to WLAN in case of WLAN offload */

    fl_IMS_DefaultHandler_SendCoOrdMsg(p_IpcanType);   /* send trigger to EUTRA PTC to indicate start of IMS re-registration */
    f_IMS_Reregistration_C46(p_IMS_DATA_REQ, p_NonceCount);
    fl_IMS_DefaultHandler_SendCoOrdMsg(p_IpcanType);   /* send trigger to EUTRA PTC to indicate end of IMS registration */
  }

  /*
   * @desc      Change status information for IMS default handler
   * @param     p_DefaultHandlerInfo
   * @param     p_IpcanType
   * @param     p_IPCAN_IMS_Control
   * @return    IMS_DefaultHandlerInfo_Type
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_DefaultHandler_ChangeInfo(IMS_DefaultHandlerInfo_Type p_DefaultHandlerInfo,
                                            IMS_IpcanPortType_Type p_IpcanType,
                                            IPCAN_IMS_Control_Type p_IPCAN_IMS_Control) runs on IMS_PTC return IMS_DefaultHandlerInfo_Type
  {
    var IMS_DefaultHandlerInfo_Type v_DefaultHandlerInfo := p_DefaultHandlerInfo;
    var boolean v_WaitForCNF;

    v_DefaultHandlerInfo.IpcanType := p_IpcanType;                              /* IPCAN_E or OtherIPCAN_E */
    
    select union (p_IPCAN_IMS_Control) {
      case (Reset) {
        v_WaitForCNF := (p_IPCAN_IMS_Control.Reset == WithCNF);                 /* @sic R5s221193, R5s230197 sic@ */
        if (v_DefaultHandlerInfo.State != WaitForRegistration) {                /* @sic R5s230197 sic@ */
          v_DefaultHandlerInfo.State := WaitForRegistration;
          f_IMS_GlobalRelease(full, v_WaitForCNF);                              /* @sic R5s210124 sic@ @sic R5s221193: v_WaitForCNF sic@ */
        }
        if (v_WaitForCNF) {                                                     /* @sic R5s221193: send trigger back to IPCAN if requested sic@ */
          fl_IMS_DefaultHandler_SendCoOrdMsg(p_IpcanType);
        }
      }
      case (IpcanInd) {
        /* nothing else to be done */
      }
      case (ReregistrationStart) {
        f_IMS_PTC_SetRanType(p_IPCAN_IMS_Control.ReregistrationStart);
        v_DefaultHandlerInfo.State := WaitForReregistration;
      }
      case (ReregistrationStop) {
        if (v_DefaultHandlerInfo.State == WaitForReregistration) {
          v_DefaultHandlerInfo.State := WaitForDeregistration;
        }
      }
      case (NoRegistration) {                                                    // @sic R5-169150 sic@
        v_DefaultHandlerInfo.State := NoRegistration;
      }
    }
    return v_DefaultHandlerInfo;
  }

  /*
   * @desc      Handling of control primitives from an IPCAN PTC
   * @param     p_DefaultHandlerInfo
   * @param     p_IpcanType
   * @param     p_IMS_IPCAN_Coordination_MSG
   * @return    IMS_DefaultHandlerInfo_Type
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_DefaultHandler_IpcanControl(IMS_DefaultHandlerInfo_Type p_DefaultHandlerInfo,
                                              IMS_IpcanPortType_Type p_IpcanType,
                                              IMS_IPCAN_Coordination_MSG p_IMS_IPCAN_Coordination_MSG) runs on IMS_PTC return IMS_DefaultHandlerInfo_Type
  {
    var IMS_DefaultHandlerInfo_Type v_DefaultHandlerInfo := p_DefaultHandlerInfo;

    select union (p_IMS_IPCAN_Coordination_MSG) {
      case (IPCAN_IMS_Control) {
        v_DefaultHandlerInfo := fl_IMS_DefaultHandler_ChangeInfo(p_DefaultHandlerInfo, p_IpcanType, p_IMS_IPCAN_Coordination_MSG.IPCAN_IMS_Control);
      }
      case (TriggerEvent) {
        /* @sic R5s230372: functions like f_EUTRA38_NR5GC_PreambleAndSwitchOff are sending TriggerEvent which is expected by test cases with testcase specific IMS implementation sic@ */
        f_ErrorLog(__FILE__, __LINE__, "unexpected TriggerEvent (skipped)");
      }
      case else {
        FatalError(__FILE__, __LINE__, "unexpected coordination message");
      }
    }

    return v_DefaultHandlerInfo;
  }

  /*
   * @desc      default IMS behaviour:
   *            used for non-IMS test cases to deal with the initial IMS registration
   * @param     p_PdnIndex          (default value: PDN_1)
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_DefaultHandler(PDN_Index_Type p_PdnIndex := PDN_1) runs on IMS_PTC
  { /* @sic R5s240511 - additional changes: p_PdnIndex sic@ */
    var IMS_DefaultHandlerInfo_Type v_DefaultHandlerInfo;       /* @sic R5-163201 sic@ */
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var IMS_IPCAN_Coordination_MSG v_IMS_IPCAN_Coordination_MSG;
    var integer v_NonceCountForNextRegister;

    f_IMS_PTC_Init(p_PdnIndex, defaultHandling, IMS_Security);  /* @sic R5s240511: p_PdnIndex sic@ */
    f_IMS_PTC_CheckAudioVideoTags_Set(false);                   /* @sic R5-201110: set check of audio/video feature tag to be false sic@ */

    v_DefaultHandlerInfo.State := WaitForRegistration;
    v_DefaultHandlerInfo.IpcanType := IPCAN_E;                  /* @sic R5s160133 sic@ */

    while (true) {
      alt {
        [] IPCAN.receive(cmr_IPCAN_IMS_Any) -> value v_IMS_IPCAN_Coordination_MSG {         /* @sic R5s160133 sic@ */
          v_DefaultHandlerInfo := fl_IMS_DefaultHandler_IpcanControl(v_DefaultHandlerInfo, IPCAN_E, v_IMS_IPCAN_Coordination_MSG);
        }
        [] OtherIPCAN.receive(cmr_IPCAN_IMS_Any) -> value v_IMS_IPCAN_Coordination_MSG {    /* @sic R5s160133 sic@ */
          v_DefaultHandlerInfo := fl_IMS_DefaultHandler_IpcanControl(v_DefaultHandlerInfo, OtherIPCAN_E, v_IMS_IPCAN_Coordination_MSG);
        }
        [] IMS_Server.receive(car_IMS_Register_Request(?)) -> value v_IMS_DATA_REQ {      // receive any REGISTER
          select (v_DefaultHandlerInfo.State) {
            case (WaitForRegistration) {
              f_IMS_DefaultHandler_InitialRegistration(v_DefaultHandlerInfo.IpcanType, v_IMS_DATA_REQ);  // @sic R5s140788 change 2 sic@
              v_DefaultHandlerInfo.State := WaitForDeregistration;
              v_NonceCountForNextRegister := 2;  /* next (re-)registration shall have nounce count of 2 @sic R5-163201 sic@ */
            }
            case (WaitForReregistration) {
              fl_IMS_DefaultHandler_Reregistration(v_DefaultHandlerInfo.IpcanType, v_IMS_DATA_REQ, v_NonceCountForNextRegister);  // @sic R5-163201 sic@
              v_NonceCountForNextRegister := v_NonceCountForNextRegister + 1;
            }
            case (WaitForDeregistration) {
              f_IMS_PTC_ResetRanType();                 // @sic R5s150057 change 3: reset RanType to allow de-registrtion from any RAT sic@
              f_IMS_PTC_Deregistration(v_IMS_DATA_REQ); // @sic R5-132037 sic@
              f_IMS_TCP_CloseHandling(waitAndClose);    /* @sic R5s170445: closing of TCP connection (after R5s140219 moving it into f_IMS_PTC_Deregistration) sic@ */
              f_IMS_GlobalRelease();                    /* the UE is not registered anymore => reset IMS
                                                         * @sic R5s150231 change 2 sic@
                                                         * reset IMS_PTC and IP_PTC's registration info in case of de-registration or the UE being switched off (-> cmr_IPCAN_IMS_Reset)
                                                         * NOTE 1: f_IMS_TCP_CloseHandling and f_IMS_GlobalRelease both are closing the TCP connections (if any);
                                                         *         nevertheless f_IMS_TCP_CloseHandling cannot be removed as additionally it has a delay before closing the connections
                                                         *         => even though f_IMS_TCP_CloseHandling(justWait) should do the same, there is no need to change this (@sic R5s170580 sic@
                                                         * NOTE 2: There is no need to call f_IMS_GlobalRelease with WaitForCNF := true as f_IMS_TCP_CloseHandling implicitly uses WaitForCNF := true
                                                         *         when releasing the TCP connections and servers (-> @sic R5s221193 sic@) */
              v_DefaultHandlerInfo.State := WaitForRegistration;
            }
            case (NoRegistration) {                     // @sic R5-169150 sic@
              f_SetVerdictInconc(__FILE__, __LINE__, "IMS registration not allowed (e.g. as UE is in test loop mode)");
            }
            case else {
              FatalError(__FILE__, __LINE__, "IMS DefaultHandler: invalid state");
            }
          }
        }
      }
    }
  }

}
