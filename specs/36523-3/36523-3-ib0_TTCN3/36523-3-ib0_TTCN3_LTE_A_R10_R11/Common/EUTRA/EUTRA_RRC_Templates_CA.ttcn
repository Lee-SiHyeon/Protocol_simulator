  template (value) PUCCH_ConfigDedicated_v1020  cs_508_PUCCH_ConfigDedicated_v1020_1TX (template (value) N1PUCCH_AN_CS_r10 p_N1PUCCH_AN_CS_r10 ):=
  { /* acc. to 36.508 Table 4.6.3-9A for condition 1TX */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    pucch_Format_r10 := {
      channelSelection_r10 := {
        n1PUCCH_AN_CS_r10 := {
          setup := {
            n1PUCCH_AN_CS_List_r10 := { p_N1PUCCH_AN_CS_r10 }
          }
        }
      }
    },
    twoAntennaPortActivatedPUCCH_Format1a1b_r10 := omit,
    simultaneousPUCCH_PUSCH_r10                 := omit,
    n1PUCCH_AN_RepP1_r10                        := omit
  };

  template (value) PUCCH_ConfigDedicated_v1020  cs_508_PUCCH_ConfigDedicated_v1020_2TX (template (value) N1PUCCH_AN_CS_r10 p_N1PUCCH_AN_CS_r10,
                                                                                        template (value) N1PUCCH_AN_CS_r10 p_N1PUCCH_AN_CS_r10_1):=
  { /* acc. to 36.508 Table 4.6.3-9A for condition 2 TX */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    pucch_Format_r10 := {
      channelSelection_r10 := {
        n1PUCCH_AN_CS_r10 := {
          setup := {
            n1PUCCH_AN_CS_List_r10 := { p_N1PUCCH_AN_CS_r10, p_N1PUCCH_AN_CS_r10_1 }
          }
        }
      }
    },
    twoAntennaPortActivatedPUCCH_Format1a1b_r10 := omit,
    simultaneousPUCCH_PUSCH_r10                 := omit,
    n1PUCCH_AN_RepP1_r10                        := omit
  };

  template (value) PUCCH_ConfigDedicated_v1020 cs_508_PUCCH_ConfigDedicated_v1020_TDD_FDD_CA :=
  { /* acc. to 36.508 Table 4.6.3-9A for condition TDD FDD CA */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    pucch_Format_r10 := {
      format3_r10 := {
        n3PUCCH_AN_List_r13 := { 101, 102, 103, 104 },     // @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@
        twoAntennaPortActivatedPUCCH_Format3_r13 := omit   // @sic R5s180271 BASELINE MOVING 2018 Phase 1 sic@
      }
    },
    twoAntennaPortActivatedPUCCH_Format1a1b_r10 := omit,
