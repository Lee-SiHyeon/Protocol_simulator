  template (present) TimingInfo_Type cr_TimingInfo_NR(template (present)SubFrameTiming_Type p_TimingInfo) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubFrame := {
      SFN := p_TimingInfo.SFN,
      Subframe := p_TimingInfo.Subframe,
      HSFN := p_TimingInfo.HSFN,
      Slot := p_TimingInfo.Slot,
      Symbol := p_TimingInfo.Symbol
    }
  };

