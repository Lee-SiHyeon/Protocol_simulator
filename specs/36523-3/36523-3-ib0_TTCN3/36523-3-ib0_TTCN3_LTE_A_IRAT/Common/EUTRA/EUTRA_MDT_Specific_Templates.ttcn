    {
      carrierFreq_r9    := p_CarrierFreq_r9,
      measResultList_r9 := {
        {
          physCellId := p_PhysCellId,
          cgi_Info   := p_Cgi_Info,
          measResult := cr_MeasResultEUTRA(p_RsrpResult, p_RsrqResult, p_AdditionalSI_Info_r9)   /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
        }
      }
