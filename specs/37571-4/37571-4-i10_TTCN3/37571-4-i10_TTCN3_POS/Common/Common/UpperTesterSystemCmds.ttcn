  template (value) Ut_System_Cmd_Type cs_AT_RELEASE_IMS_CALL (charstring p_CallId)  :=
    cs_AT_Cmd("AT+CHCCS="& p_CallId & "<CR>");                                                                        /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

