module EUTRA_POS_Component {

  import from EUTRA_CellInfoInit all;
  import from EUTRA_Component all;
  import from EUTRA_POS_ASP_TypeDefs all;
  import from PosSystem_ASP_TypeDefs all;
  import from TestcaseProperties all;

  type component EUTRA_POS_PTC extends EUTRA_PTC {
    /* @status    APPROVED (POS) */
    port POS_PTC_MTC_PORT          POSSYS;            // coordination port to be connected to the MTC
    port EUTRA_SYSTEM_POSEXT_PORT  SYS_POSEXT;        // extension of the SYS port (mainly antenna port 6)
  };

  type component EUTRA_POS_SYSTEM extends EUTRA_SYSTEM {
    /* @status    APPROVED (POS) */
    port EUTRA_SYSTEM_POSEXT_PORT  E_SYS_POSEXT;
  };

  /*
   * @desc      map system ports
   * @param     p_System
   * @param     p_Eutra
   * @status    APPROVED (POS)
   */
  function f_EUTRA_POS_PTC_Map(EUTRA_POS_SYSTEM p_System,
                               EUTRA_POS_PTC p_Eutra)
  {
    f_EUTRA_PTC_Map(p_System, p_Eutra);
    if (f_GetTestcaseAttrib_SpecificOTDOA_Port(testcasename())) {
      map(p_Eutra:SYS_POSEXT, p_System:E_SYS_POSEXT);
    }
  }

  /*
   * @desc      Default error handler for EUTRA POS PTC
   * @status    APPROVED (POS)
   */
  altstep a_EUTRA_POS_DefaultExtension() runs on EUTRA_POS_PTC
  {
    [] SYS_POSEXT.receive {
      all timer.stop;
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected receive event at SYS_POSEXT port");
    }
    [] POSSYS.receive {
      all timer.stop;
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected receive event at POSSYS port");
    }
  }

  /*
   * @desc      initialisation of the EUTRA_POS PTC
   * @param     p_SysinfoCombination
   * @status    APPROVED (POS)
   */
  function f_EUTRA_POS_Init(Combination_Type p_SysinfoCombination) runs on EUTRA_POS_PTC
  {
    f_EUTRA_Init(p_SysinfoCombination);
    activate(a_EUTRA_POS_DefaultExtension());   // activate extension for EUTRA default behaviour
  }

}
