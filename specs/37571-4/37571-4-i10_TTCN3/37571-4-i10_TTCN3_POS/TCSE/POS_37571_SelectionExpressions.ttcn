      }
      case (POS_C57us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GALILEO and pc_ParamPosEstimate and not (pc_GLONASS or pc_BDS);
      }
