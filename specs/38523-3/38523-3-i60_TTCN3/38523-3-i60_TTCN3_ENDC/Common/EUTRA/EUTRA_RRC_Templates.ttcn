  template (value) PhysicalConfigDedicated cs_PhysicalConfigDedicated_Omit :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    pdsch_ConfigDedicated := omit,
    pucch_ConfigDedicated := omit,
    pusch_ConfigDedicated := omit,
    uplinkPowerControlDedicated := omit,
    tpc_PDCCH_ConfigPUCCH := omit,
