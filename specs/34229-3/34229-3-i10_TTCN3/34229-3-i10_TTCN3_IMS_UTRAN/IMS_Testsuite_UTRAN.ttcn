module IMS_Testsuite_UTRAN {

  import from MTC_Component_IMS_Common all;
  import from MTC_Component_IMS_UTRAN all;
  import from IMS_34229_SelectionExpressions all;
  import from IMS_Component all;
  import from IMS_CC_PDPContextActivationTestcases all;
  import from IMS_CC_P_CSCFDiscoveryTestcases all;

  //----------------------------------------------------------------------------
  testcase TC_6_3() runs on MTC_IMS system SYSTEM_IMS {
    // @purpose
    //   Dedicated PDP Context Establishment
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_IMS1 := IMS_PTC.create("IMS1") alive;
  
    f_MTC_IMS_CreateMapAndConnectPTCs_UTRAN(system, v_IMS1, v_IMS2);
  
    v_IMS1.start(f_TC_6_3_IMS1());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_IMS(t_GuardTimer);
  }
  //----------------------------------------------------------------------------
  //----------------------------------------------------------------------------
  testcase TC_7_1() runs on MTC_IMS system SYSTEM_IMS {
    // @purpose
    //   P-CSCF Discovery via PDP Context
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_IMS1 := IMS_PTC.create("IMS1") alive;
  
    f_MTC_IMS_CreateMapAndConnectPTCs_UTRAN(system, v_IMS1, v_IMS2);
  
    v_IMS1.start(f_TC_7_1_IMS1());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_IMS(t_GuardTimer);
  }
  //----------------------------------------------------------------------------
  control {
    if (f_IMS_SelectionExpr(IMS34_C04))                 { execute(TC_6_3()); }
    if (f_IMS_SelectionExpr(IMS34_C05))                 { execute(TC_7_1()); }
  }
}
