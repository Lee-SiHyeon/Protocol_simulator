    O1_Type                     criterionType,
    octetstring                 criterionValue  optional
  };

  type record SOR_SNPN_SI {                            /* 24.501 cl. 9.11.3.51 */
    Type6Length_Type                iel,
    B6_Type                         spare,
    B1_Type                         clgi,
    B1_Type                         clsi,
    CHPrioritizedSNPN_GINList       listofPreferredSNPNs    optional,
    CHPrioritizedSNPN_GINList       listofPrioritizedGINs   optional
  };
  
  type record SOR_SNPN_SI_LS {                         /* 24.501 cl. 9.11.3.51 */
    Type6Length_Type                    iel,
    B6_Type                             spare,
    B1_Type                             clglsi,
    B1_Type                             clssli,
    CHPrioritizedLS_SNPN_GINList        listofPreferredSNPNs    optional,
    CHPrioritizedLS_SNPN_GINList        listofPrioritizedGINs   optional
  };
  
  type record of CHPrioritizedSNPN_GIN CHPrioritizedSNPN_GINList;
  type record CHPrioritizedSNPN_GIN {                   /* 24.501 cl. 9.11.3.51 */
