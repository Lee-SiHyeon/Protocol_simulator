    areaScope_r17 := omit
  };

  template (value) SIB1 cs_38508_SIB1_Def(template (value) PLMN_IdentityInfo          p_PLMN_IdentityInfo,
                                          template (omit)  SI_SchedulingInfo          p_SI_SchedulingInfo,
                                          template (value) DownlinkConfigCommonSIB    p_DownlinkConfigCommonSIB,
                                          template (omit)  UplinkConfigCommonSIB      p_UplinkConfigCommonSIB,
                                          template (omit)  TDD_UL_DL_ConfigCommon     p_TDD_UL_DL_ConfigCommon,
                                          template (value) ServingCellConfigCommonSIB.ssb_PositionsInBurst    p_Ssb_PositionsInBurst,
                                          Q_RxLevMin p_Q_RxLevMin,
                                          template (omit) Q_RxLevMin p_Q_RxLevMinSUL := omit,
                                          template (omit) Q_QualMin  p_Q_QualMin := omit,
                                          template (omit) SIB1.eCallOverIMS_Support p_ECallOverIMS_Support := omit,
                                          template (omit) NPN_IdentityInfoList_r16 p_NPN_IdentityInfoList := omit,
                                          template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse p_CellReservedForOtherUse := omit,
                                          template (omit) SIB1_v1610_IEs p_SIB1_v1610 := omit,
                                          template (omit) ServingCellConfigCommonSIB.channelAccessMode_r16 p_ChannelAccessMode_r16 := omit
                                          ) :=
  { //Acc to 38.508-1 Table 4.6.1-28: SIB1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    // @sic R5-216327: added p_ECallOverIMS_Support R5-227518: added p_SIB1_v1610 sic@
    cellSelectionInfo         := cs_38508_SIB1_CellSelectionInfo(p_Q_RxLevMin, p_Q_RxLevMinSUL, p_Q_QualMin),
    cellAccessRelatedInfo     := cs_38508_CellAccessRelatedInfo(p_PLMN_IdentityInfo, p_NPN_IdentityInfoList, p_CellReservedForOtherUse),
    connEstFailureControl     := cs_38508_ConnEstFailureControl,
    si_SchedulingInfo         := p_SI_SchedulingInfo,
    servingCellConfigCommon   := cs_38508_ServingCellConfigCommonSIB(p_DownlinkConfigCommonSIB,
                                                                     p_UplinkConfigCommonSIB,
                                                                     p_TDD_UL_DL_ConfigCommon,
                                                                     p_Ssb_PositionsInBurst,
                                                                     p_ChannelAccessMode_r16),
    ims_EmergencySupport      := true_,  //@sic R5-206304 sic@
    eCallOverIMS_Support      := p_ECallOverIMS_Support,
    ue_TimersAndConstants     := cs_38508_UE_TimersAndConstants,
    uac_BarringInfo           := omit,
    useFullResumeID           := omit,
    lateNonCriticalExtension  := omit,
    nonCriticalExtension      := p_SIB1_v1610
  };

  template (value) SIB1.cellSelectionInfo cs_38508_SIB1_CellSelectionInfo(Q_RxLevMin p_Q_RxLevMin,
                                                                          template (omit) Q_RxLevMin p_Q_RxLevMinSUL := omit,
                                                                          template (omit) Q_QualMin  p_Q_QualMin := omit
                                                                          ) :=
  { //Acc to 38.508-1 Table 4.6.1-28: SIB1
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    q_RxLevMin        := p_Q_RxLevMin,
    q_RxLevMinOffset  := omit,
    q_RxLevMinSUL     := p_Q_RxLevMinSUL,
    q_QualMin         := p_Q_QualMin,  //@sic R5-195322 sic@
    q_QualMinOffset   := omit
  };

  template (value) CellAccessRelatedInfo cs_38508_CellAccessRelatedInfo(template (value) PLMN_IdentityInfo p_PLMN_IdentityInfo,
                                                                        template (omit) NPN_IdentityInfoList_r16 p_NPN_IdentityInfoList := omit,
                                                                        template (omit) SIB1.cellAccessRelatedInfo.cellReservedForOtherUse p_CellReservedForOtherUse := omit
                                                                        )  :=
  { //Acc to 38.508-1 Table 4.6.3-16: CellAccessRelatedInfo
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    plmn_IdentityInfoList        := {p_PLMN_IdentityInfo},          //@sic R5s211526 BASELINE MOVING 2021 sic@
    cellReservedForOtherUse      := p_CellReservedForOtherUse,      //@sic R5-225299 used for option SNPN sic@
    cellReservedForFutureUse_r16 := omit,                           /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    npn_IdentityInfoList_r16     := p_NPN_IdentityInfoList,         /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    snpn_AccessInfoList_r17      := omit                            /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) PLMN_IdentityInfo cs_NR_PLMN_IdentityInfo(template (value) PLMN_Identity     p_PLMN_Identity,
                                                             template (omit) TrackingAreaCode   p_TrackingAreaCode,
                                                             template (omit) RAN_AreaCode       p_RAN_AreaCode,
                                                             template (value) CellIdentity      p_CellIdentity,
                                                             template (omit) PLMN_IdentityInfo.trackingAreaList_r17  p_TrackingAreaList_r17 := omit
                                                             ) :=
  { //Acc to 38.508-1 Table 4.6.3-80C: PLMN-IdentityInfoList
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    plmn_IdentityList   := {p_PLMN_Identity}, //1 entry
    trackingAreaCode    := p_TrackingAreaCode,
    ranac               := p_RAN_AreaCode,
    cellIdentity        := p_CellIdentity,
    cellReservedForOperatorUse := notReserved,
    iab_Support_r16 := omit,                        /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    trackingAreaList_r17 := p_TrackingAreaList_r17, /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    gNB_ID_Length_r17    := omit,                   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    mobileIAB_Support_r18:= omit                    /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
  };

  template (value) ConnEstFailureControl cs_38508_ConnEstFailureControl :=
  { //Acc to 38.508-1 Table 4.6.3-16A: ConnEstFailureControl
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    connEstFailCount          := n1,
    connEstFailOffsetValidity := s30,
    connEstFailOffset         := 1
  };

