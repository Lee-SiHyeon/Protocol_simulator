module UTRAN34_LoopBack_Functions {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from NAS_34109TypeDefs all;
  import from UTRAN34_LoopBack_Templates all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_Component all;
  import from UTRAN_TTCN_ASP_Templates all;

  /*
   * @desc      Function to activate RB test node at UE side (from 34.109)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_ActivateRB_TestMode() runs on UTRAN_PTC
  {
    // Send activate RB test mode
    U_Dc.send(cas_DataReq_PS(utran_CellDedicated, tsc_RB3, cs_U_ActRB_TestMode(cs_ActivateRB_TestMode)));

    //Receive confirmation from UE
    U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_ActRB_TestModeCmpl(cr_ActivateRB_TestModeCmpl)));
  }

  /*
   * @desc      Close UE Test Loop
   * @param     p_CN_Domain
   * @param     p_UE_TestLoopMode
   * @param     p_UE_TestLoopMode1LB_Setup
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_CloseUE_TestLoop(CN_DomainIdentity p_CN_Domain,
                                      UE_TestLoopMode_Type p_UE_TestLoopMode,
                                      template (value) UE_TestLoopMode1_LB_Setup_Type p_UE_TestLoopMode1LB_Setup) runs on UTRAN_PTC
  {
    if (p_CN_Domain == cs_domain){
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_CloseUE_TestLoop(cs_CloseUE_TestLoop(p_UE_TestLoopMode, p_UE_TestLoopMode1LB_Setup))));
      
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_CloseUE_TestLoopCmpl(cr_CloseUE_TestLoopCompl)));
    }
    else {
      U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_CloseUE_TestLoop(cs_CloseUE_TestLoop(p_UE_TestLoopMode, p_UE_TestLoopMode1LB_Setup))));
      
      U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_CloseUE_TestLoopCmpl(cr_CloseUE_TestLoopCompl)));
    }
  }

  /*
   * @desc      Open UE Test Loop
   * @param     p_CN_Domain
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_OpenUE_TestLoop(CN_DomainIdentity p_CN_Domain) runs on UTRAN_PTC
  {
    if (p_CN_Domain == cs_domain) {
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_OpenUE_TestLoop(cs_OpenUE_TestLoop)));
      
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_OpenUE_TestLoopCmpl(cr_OpenUE_TestLoopCmpl)));
    }
    else {
      U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_OpenUE_TestLoop(cs_OpenUE_TestLoop)));
      
      U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_OpenUE_TestLoopCmpl(cr_OpenUE_TestLoopCmpl)));
    }
  }

  /*
   * @desc      Deactivate UE Radio Bearer test mode
   * @param     p_CN_Domain
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_DeactivateRB_TestMode(CN_DomainIdentity p_CN_Domain) runs on UTRAN_PTC
  {
    if (p_CN_Domain == cs_domain) {
      U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_DeactRB_TestMode(cs_DeactivateRB_TestMode)));
      
      U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                            tsc_RB3,
                                            cr_U_DeactRB_TestModeCmpl(cr_DeactivateRB_TestModeCmpl)));
      
    }
    else {
      U_Dc.send(cas_DataReq_PS(utran_CellDedicated,
                               tsc_RB3,
                               cs_U_DeactRB_TestMode(cs_DeactivateRB_TestMode)));
      
      U_Dc.receive(car_PS_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_DeactRB_TestModeCmpl(cr_DeactivateRB_TestModeCmpl)));
    }
  }

  /*
   * @desc      returns the `p_Lg` least significant bits of the original p_Bstring
   * @param     p_Bstring
   * @param     p_Lg
   * @return    bitstring
   * @status    APPROVED (UTRAN)
   */
  function f_GetLeastSignificantBits(bitstring p_Bstring, integer p_Lg) return bitstring
  {
    var integer v_Length := lengthof(p_Bstring);
    var integer v_Start := (v_Length - p_Lg);
    
    return substr(p_Bstring, v_Start, p_Lg);
  }

  /*
   * @desc      Returns the p_Size most significant bits of the original p_Data. If p_Size is greater than the length of p_Data, then a bitsring of size greater than p_Size
   *            is created by concatenating p_Data to itself (any number of times till it is size is greater than p_Size), and then 'p_Size' most significant bits of concatenated
   *            p_Data are returned.  Example: f_GetMostSignificantBits('1100'B, 9) = '110011001'B.
   * @param     p_Data
   * @param     p_Size
   * @return    bitstring
   * @status    APPROVED (UTRAN)
   */
  function f_GetMostSignificantBits_WrapAround(bitstring p_Data,
                                               integer p_Size) return bitstring
  {
    var bitstring v_Data := p_Data;
    
    while (lengthof(v_Data) < p_Size) {
      v_Data := v_Data & v_Data;
    }
    return substr(v_Data, 0, p_Size);
  }

}
