--
--**************************************************************

CPHY-TrCH-Config-TDD-REQ ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo,
  ratType RatType,
  trchConfigType TrChConfigType,
  configMessage CphyTrchConfigReq-TDD
}

