module MTC_Component_IMS_EUTRA {

  import from CommonDefs all;
  import from EUTRA_Component all;
  import from IMS_CC_Component all;
  import from IMS_Component all;
  import from IPCAN_EUTRA all;
  import from MTC_Base all;
  import from MTC_Component_IMS_Common all;
  import from NasEmu_Component_EUTRA all;
  import from NasEmu_Main_EUTRA all;
  import from UpperTesterSystemCmds all;

  type component SYSTEM_IMS extends EUTRA_SYSTEM, NASEMU_EUTRA_SYSTEM, SYSTEM_IMS_BASE {};  /* @status    APPROVED (IMS) */

  /*
   * @desc      Create parallel test components and connect all MTC ports to the system ports
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @param     p_UseDNS            (default value: false)
   * @param     p_UseXCAP           (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_CreateMapAndConnectPTCs_EUTRA(SYSTEM_IMS p_System,
                                                   IMS_PTC p_IMS1,
                                                   IMS_PTC p_IMS2,
                                                   boolean p_UseDNS := false,
                                                   boolean p_UseXCAP := false) runs on MTC_IMS
  { /* @sic R5-134070: generic handling of UT commands for IMS PTC as well as for the other PTCs sic@ */
    /* @sic R5w140125: additional parameter p_HTTP_PTC sic@ */
    /* @sic R5w140206: common implementation for EUTRA/UTRAN sic */
    /* @sic R5s141051 change 2: parameter p_UseXCAP sic@ */
    /* @sic R5s170448: p_UseDNS sic@ */
    var EUTRA_PTC v_EUTRA;
    var NASEMU_EUTRA_PTC v_NASEMU_PTC;

    f_MTC_IMS_InitAndConnect_IP_IMS(p_System, p_IMS1, p_IMS2, p_UseDNS, p_UseXCAP);

    v_EUTRA := EUTRA_PTC.create("EUTRA") alive;                             // @sic R5s201263 sic@  @sic R5s210270 sic@
    f_EUTRA_PTC_Map(p_System, v_EUTRA);                                     // map EUTRA system ports
    v_NASEMU_PTC := f_NasEmu_CreateConnectAndMap_EUTRA(p_System, v_EUTRA);  // create NasEmu, map system ports and connect with EUTRA PTC
    v_NASEMU_PTC.start(f_NASEMU_MainLoop_EUTRA());                          // start NASEMU
    

    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_EUTRA], v_EUTRA:UT);
    connect(v_EUTRA:IP, vc_Components.IP:EUTRA_CTRL);
    if (p_IMS1 != null) { connect(vc_Components.IMS1:IPCAN, v_EUTRA:IMS[tsc_Index_IMS1]); }
    if (p_IMS2 != null) { connect(vc_Components.IMS2:IPCAN, v_EUTRA:IMS[tsc_Index_IMS2]); }

    f_UT_InitialPowerOffUE(Ut);

    v_EUTRA.start(f_EUTRA_IPCAN_MainLoop());
  }

  /*
   * @desc      Extension for XCAP test cases
   * @param     p_System
   * @param     p_IMS1
   * @param     p_IMS2
   * @status    APPROVED (IMS)
   */
  function f_MTC_IMS_XCAP_CreateMapAndConnectPTCs_EUTRA(SYSTEM_IMS p_System,
                                                        IMS_XCAP_PTC p_IMS1,
                                                        IMS_XCAP_PTC p_IMS2) runs on MTC_IMS
  {
    var boolean v_UseXCAP := true;  /* @sic R5s141051 change 1 sic@ */
    var boolean v_UseDNS := true;   /* @sic R5s170448 sic@ */
    f_MTC_IMS_CreateMapAndConnectPTCs_EUTRA(p_System, p_IMS1, p_IMS2, v_UseDNS, v_UseXCAP);
    f_MTC_IMS_CreateMapConnectAndStartHTTP(p_System, p_IMS1);
  }

}
