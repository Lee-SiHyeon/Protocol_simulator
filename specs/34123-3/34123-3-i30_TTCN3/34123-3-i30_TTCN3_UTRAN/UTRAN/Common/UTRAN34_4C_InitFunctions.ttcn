module UTRAN34_4C_InitFunctions {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from Parameters all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CellInfoInterBand all;
  import from UTRAN34_CommonDefs all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_Parameters all;
  import from UTRAN_CellInfo all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_RRC_Templates all;

  /*
   * @desc      Return the UL/DL frequencies for the second secondary serving cell per band for f1(Mid)
   * @param     p_Band
   * @return    FrequencyInfo
   * @status    APPROVED (UTRAN)
   */
  function f_Get3C4C_SecondSecondaryFrequency(integer p_Band) return FrequencyInfo
  {
    var template (value) FrequencyInfo v_FreqInfoMid;

    select (p_Band) {
      case (1) { v_FreqInfoMid := cs_FreqInfo_ULDL_FDD(9750, 10750); }
      case (4) { v_FreqInfoMid := cs_FreqInfo_ULDL_FDD(1450, 1700); }
      case (5) { v_FreqInfoMid := cs_FreqInfo_ULDL_FDD(4175, 4425); }
      case (32) { v_FreqInfoMid := cs_FreqInfo_ULDL_FDD(omit, 6740); } //@sic R5-151886 sic@
      // Other combination not specified in 25.101 cl 5.2
      case else {FatalError(__FILE__, __LINE__, "Configuration not valid according to TS 25.101, Table 5.0aC");}
    }
    return valueof(v_FreqInfoMid);
  }

  /*
   * @desc      Initialise UTRAN SFN offset, Tcell and frequencies for 3C/4C configuration
   * @param     p_CellList  => list of 4C cells, the first cell is the serving cell
   * @param     p_Configuration_3C4C
   * @param     p_NumberOfCarrierBandA
   * @param     p_NumberOfCarrierBandB
   * @param     p_DcHsupaConfigured (default value: false)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_InitFrequency_4C(UTRAN_CellIdList_Type p_CellList,
                                      UTRAN34_3C4C_Configuration_Type p_Configuration_3C4C,
                                      integer p_NumberOfCarrierBandA,
                                      integer p_NumberOfCarrierBandB,
                                      boolean p_DcHsupaConfigured := false) runs on UTRAN_PTC
  {
    // Set TCell to the same value - all cells are timing aligned
    if (f_UTRAN_NoOfConfiguredCells() == 0) {
      f_UTRAN_CellInfo_SetTCell(p_CellList[0], 0);
      f_UTRAN_CellInfo_SetTCell(p_CellList[1], 0);
      f_UTRAN_CellInfo_SetTCell(p_CellList[2], 0);
      if (ispresent(p_CellList[3])) {
        f_UTRAN_CellInfo_SetTCell(p_CellList[3], 0);
      }
    } else {
      f_UTRAN_CellInfo_SetTCell(p_CellList[1], f_UTRAN34_CellInfo_GetTcell(p_CellList[0]));
      f_UTRAN_CellInfo_SetTCell(p_CellList[2], f_UTRAN34_CellInfo_GetTcell(p_CellList[0]));
      if (isvalue(p_CellList[3])) {
        f_UTRAN_CellInfo_SetTCell(p_CellList[3], f_UTRAN34_CellInfo_GetTcell(p_CellList[0]));
      }
    }
    
    // Set SFNOffset to the same value - all cells are timing aligned
    f_UTRAN34_CellInfo_SetSFNOffset(p_CellList[1], f_UTRAN_CellInfo_GetSFNOffset(p_CellList[0]));
    f_UTRAN34_CellInfo_SetSFNOffset(p_CellList[2], f_UTRAN_CellInfo_GetSFNOffset(p_CellList[0]));
    if (ispresent(p_CellList[3])) {
      f_UTRAN34_CellInfo_SetSFNOffset(p_CellList[3], f_UTRAN_CellInfo_GetSFNOffset(p_CellList[0]));
    }
    
    // Init frequencies according to 34.108, 5.1.1
    f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[0], f_Get3C4C_ServingFrequency(px_FDD_OperationBand));
    
    select (p_Configuration_3C4C) {
      case (C3_SingleBand, C3_SingleBand_Mimo) {
        f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[1], f_Get3C4C_FirstSecondaryFrequency(px_FDD_OperationBand, p_DcHsupaConfigured));
        f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[2], f_Get3C4C_SecondSecondaryFrequency(px_FDD_OperationBand));
      }
      case (C3_DualBand, C3_DualBand_Mimo) {
        
        if ((p_NumberOfCarrierBandA == 2) and (p_NumberOfCarrierBandB == 1)) {
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[1], f_Get3C4C_FirstSecondaryFrequency(px_FDD_OperationBand, p_DcHsupaConfigured));
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[2], f_Get3C4C_FirstSecondaryFrequency(px_SecondaryBand, false));  //No DC-HSUPA when in DB-DC-HSDPA
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[2], px_SecondaryBand);
          
        } else if ((p_NumberOfCarrierBandA == 1) and (p_NumberOfCarrierBandB == 2)) {
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[1], f_Get3C4C_FirstSecondaryFrequency(px_SecondaryBand, p_DcHsupaConfigured));
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[1], px_SecondaryBand);
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[2], f_Get3C4C_SecondSecondaryFrequency(px_SecondaryBand));
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[2], px_SecondaryBand);
        }
      }
      case (C4_DualBand, C4_DualBand_Mimo) {
        if ((p_NumberOfCarrierBandA == 2) and (p_NumberOfCarrierBandB == 2)) {
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[1], f_Get3C4C_FirstSecondaryFrequency(px_FDD_OperationBand, p_DcHsupaConfigured));
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[2], f_Get3C4C_FirstSecondaryFrequency(px_SecondaryBand, false));   //No DC-HSUPA when in DB-DC-HSDPA
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[2], px_SecondaryBand);
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[3], f_Get3C4C_SecondSecondaryFrequency(px_SecondaryBand));
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[3], px_SecondaryBand);
        } else if ((p_NumberOfCarrierBandA == 3) and (p_NumberOfCarrierBandB == 1)) {
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[1], f_Get3C4C_FirstSecondaryFrequency(px_FDD_OperationBand, p_DcHsupaConfigured));
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[2], f_Get3C4C_SecondSecondaryFrequency(px_FDD_OperationBand));
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellList[3], f_Get3C4C_FirstSecondaryFrequency(px_SecondaryBand, false));   //No DC-HSUPA when in DB-DC-HSDPA
          f_UTRAN34_CellInfo_ChangeBand(p_CellList[3], px_SecondaryBand);
        }
      }
    }
  }

}
