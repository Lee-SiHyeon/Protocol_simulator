module MCX_XML_conference_info {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_XML_Encryption all;
  import from urn_ietf_params_xml_ns_conference_info language "XSD" all;

  type Conference_type ConferenceInfo_Type;                             /* @status    APPROVED (MCX) */

  /*
   * @desc      Encode Conference_type
   * @param     p_ConferenceInfo
   * @return    universal charstring
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ConferenceInfo_Encode(template (value) Conference_type p_ConferenceInfo) return universal charstring
  {
    var bitstring v_EncodedConferenceInfo := encvalue(p_ConferenceInfo);
    return f_Bit2Unichar(v_EncodedConferenceInfo);
  }

  /*
   * @desc      Encrypt attribute URIs and encode Conference_type
   *            NOTE: in contrast to e.g. content encryption the attribute URI encryption happens before encoding
   * @param     p_ConferenceInfo
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_ConferenceInfo_EncodeEncrypt(template (value) Conference_type p_ConferenceInfo,
                                              charstring p_MCServiceID,
                                              template (omit) MCX_SecurityKey_Type p_CSK) return XmlBody_Type
  {
    var Conference_type v_ConferenceInfo := valueof(p_ConferenceInfo);
    var universal charstring v_XmlDocument;
    var integer i;

    if (isvalue(p_CSK)) {
      v_XmlDocument := fl_MCX_ConferenceInfo_Encode(v_ConferenceInfo);
      fx_XML_Log(__FILE__, __LINE__, DOWNLINK, v_XmlDocument);

      v_ConferenceInfo.entity := f_MCX_XML_EncryptAttributeUri(v_ConferenceInfo.entity, p_MCServiceID, p_CSK);
      for (i := 0; i < lengthof(v_ConferenceInfo.users.user_list); i := i + 1) {
        v_ConferenceInfo.users.user_list[i].entity := f_MCX_XML_EncryptAttributeUri(v_ConferenceInfo.users.user_list[i].entity, p_MCServiceID, p_CSK);
      }
      v_XmlDocument := fl_MCX_ConferenceInfo_Encode(v_ConferenceInfo);
    }
    return f_UniCharstring2XmlBody(v_XmlDocument);
  }

}
