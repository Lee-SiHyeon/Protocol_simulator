module IMS_NR5GC_Functions {

  import from IMS_CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_Video all;
  import from IMS_SDP_MessagesVideo all;
  import from IMS_eCall_Functions all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Generic Test Procedure for IMS side of the MO Speech call establishment in NR (TS 38.508-1 cl. 4.9.15)
   *            This takes care of if the UE supports preconditions (A.4.1) or not (A.4.2)
   * @param     p_OtherCalleeUri    (default value: omit)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (NR5GC)
   */
  function fl_IMS_NR5GC_MOSpeechCall_Step1(template SipUrl p_OtherCalleeUri := omit) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    if (pc_Preconditions) {  // @sic R5-222077: Additional checks for A.4.2 (no 'precondition' option tag in Supported header field, no precondition attributes), R5s220817 sic@
      return f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(p_OtherCalleeUri); // @sic R5s220817; R5-246482: A.4.1 -> A.4.1a sic@
    } else {
      return f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1(p_OtherCalleeUri); // @sic R5-246482: A.4.2 -> A.4.2a sic@
    }
  }

  /*
   * @desc      Generic Test Procedure for IMS side of the MO Speech call establishment in NR (TS 38.508-1 cl. 4.9.15)
   *            This takes care of if the UE supports preconditions (A.4.1) or not (A.4.2)
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (NR5GC)
   */
  function fl_IMS_NR5GC_MOSpeechCall_Step2ToEnd(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := p_InviteRequestWithSdp;

    if (pc_Preconditions) {
      f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_5(v_InviteRequestWithSdp);   // @sic R5-246482: A.4.1 -> A.4.1a sic@
    } else {
      f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_5(v_InviteRequestWithSdp);   // @sic R5-246482: A.4.2 -> A.4.2a sic@
    }
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Add Voice Bearer")); // @sic R5-225362 sic@
    if (pc_Preconditions) {
      f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);   // @sic R5-246482: A.4.1 -> A.4.1a sic@
      f_IMS_MOCallSetup_NR5GC_A_4_1a_Step8_12(v_InviteRequestWithSdp);  // @sic R5-246482: A.4.1 -> A.4.1a sic@
    } else {
      f_IMS_IPCAN_WaitForTrigger(IPCAN, "Voice Bearer Added");          // @sic R5s211486, R5-225362 sic@
      f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6_8(v_InviteRequestWithSdp);
    }
    // Call established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Voice Call Established")); // @sic R5-225362 sic@
  }

  /*
   * @desc      Generic Test Procedure for IMS side of speech call establishment in NR (38.508-1 4.9.15)
   * @param     p_OtherCalleeUri    (default value: omit)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_NR5GC_MOSpeechCall (template SipUrl p_OtherCalleeUri := omit) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := fl_IMS_NR5GC_MOSpeechCall_Step1(p_OtherCalleeUri); // @sic R5s210603 sic@
    fl_IMS_NR5GC_MOSpeechCall_Step2ToEnd(v_InviteRequestWithSdp);
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Generic Test Procedure for IMS side of speech call establishment and Release in NR
   * @param     p_OtherCalleeUri    (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_NR5GC_MOSpeechCallAndRelease (template SipUrl p_OtherCalleeUri := omit) runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := f_IMS_NR5GC_MOSpeechCall(p_OtherCalleeUri); // @sic R5s210603 sic@

    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Trigger MO Call Release");  // @sic R5-225362 sic@
    // Call can now be released
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));  // @sic R5-225362 sic@
  }

  /*
   * @desc  Generic Test Procedure for IMS side of video call establishment in NR
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_NR5GC_MOVideoCall () runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := f_IMS_NR5GC_MOVideoCall_Step1();
    f_IMS_NR5GC_MOVideoCall_Step2ToEnd(v_InviteRequestWithSdp);
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Generic Test Procedure for IMS side of the MO video call establishment in NR (TS 38.508-1 cl. 4.9.24)
   *            This takes care of if the UE supports preconditions (A.15.1a) or not (A.15.2a)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_NR5GC_MOVideoCall_Step1() runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { // Step 1 of A.15 is Rx INVITE
    return f_IMS_MOCallSetup_Video_Step2(SetupVideoCall, -, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2, pc_Preconditions);       /* @sic R5-231490, R5-230324: EVS_AnyNG114 sic@
                                                                                                                                                                                @sic R5-250180: EVS_A2 instead of EVS_AnyNG114 sic@ */
  }

  /*
   * @desc      Generic Test Procedure for IMS side of the MO video call establishment in NR (TS 38.508-1 cl. 4.9.24)
   *            This takes care of if the UE supports preconditions (A.15.1a) or not (A.15.2a)
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_NR5GC_MOVideoCall_Step2ToEnd(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := p_InviteRequestWithSdp;
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;
    
    // preconditions handled within function
    v_ResponseWithSdp := f_IMS_MOCallSetup_Video_Step3_4(SetupVideoCall, v_InviteRequestWithSdp, EVS_16000, H265_90000, EVS_A2);        /* @sic R5-231490: EVS_AnyNG114 sic@
                                                                                                                                           @sic R5-250180: EVS_A2 instead of EVS_AnyNG114 sic@ */
    f_IMS_BuildSDP_UpdatedOfferAudioVideo_RX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer, EVS_16000, H265_90000);
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_ResponseWithSdp.Response.msgHeader);     // A.15.1 Step 4 - 5    PRACK, 200 OK @sic R5s230200 sic@

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Add Video Bearer")); // @sic R5-225362 sic@
    if (pc_Preconditions) {
      f_IMS_MOCallSetup_NR5GC_Video_Step6_7(SetupVideoCall, v_InviteRequestWithSdp);            // A.15.1 Step 6 - 7    UPDATE, 200 OK
    }
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp);                                 // A.15.1 Step 8 - 10   180 Ringing, PRACK, 200 OK  @sic R5-241554: f_IMS_MOCallSetup_Send180_Reliable can be used for A.15.1 and A.15.2 sic@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp);                             // A.15.1 Step 11 - 12  200 OK, ACK
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Video Bearer Added");  // @sic R5-225362, R5s230200 sic@
    // Call established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Video Call Established"));           // @sic R5-225362 sic@
  }

  /*
   * @desc  Generic Test Procedure for IMS side of Emergency call establishment and Release in NR
   *        For Limited Service - without emergency registration
   *        38.508-1 4.9.12
   * @param     p_Context           (default value: A_2_1_A6)
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_EmergencyCallAndReleaseWithoutRegistration (INVITE_A_2_1_Context_Type p_Context := A_2_1_A6) runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;

    // Emergency call setup: 34.229-5 Annex A.6
    v_InviteRequest := f_IMS_EmergencyCallSetup_NR5GC_A_6(p_Context); // @sic R5s210875, R5-217857 sic@
    
    // Inform NR: Emergency Call established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established")); // @sic R5-225362 sic@
           
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Trigger MO Call Release"); // @sic R5-225362 sic@
    //Release Emergency Call MO
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);

    // Inform NR: Emergency Call released.
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent")); // @sic R5-225362 sic@
}

  /*
   * @desc  Generic Test Procedure for IMS side of Emergency call establishment and Release in NR
   *        38.508-1 4.9.11
   * @param     p_IpcanType         (default value: IPCAN_E)
   * @status    APPROVED (NR5GC)
   */
  function f_IMS_EmergencyCallAndRelease (IMS_IpcanPortType_Type p_IpcanType := IPCAN_E) runs on IMS_PTC
  {
    // Emergency registration: 34.229-5 Annex A.3
    f_IMS_EmergencyRegistration(-, -, p_IpcanType); // @sic R5-212384 sic@
    f_IMS_EmergencyCallAndReleaseWithoutRegistration(A_2_1_A7); // @sic R5s210518 sic@
    
    // Release IMS as this will be (re)started in the next loop
    f_IMS_GlobalRelease(); // @sic R5-212383 sic@
  }

  /*
   * @desc  Generic Test Procedure for IMS side of eCall establishment in NR
   *        38.508-1 4.9.11
   * @param     p_ECallType
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_IMS_NR5GC_ECall (ECall_Type p_ECallType) runs on IMS_PTC
  {
    // Steps 1- 7
    f_ECall_CallSetup_A_23 (p_ECallType);
    // Inform NR: eCall established
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));
  }

}
