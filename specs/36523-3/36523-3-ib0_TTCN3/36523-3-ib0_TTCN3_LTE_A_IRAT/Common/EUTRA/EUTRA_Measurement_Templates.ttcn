      cdma2000_Type := p_CDMA2000_Type,
      carrierFreq := {
        bandClass := p_BandClass,
        arfcn := p_ARFCN
      },
      searchWindowSize := p_SearchWindowSize,
      offsetFreq := p_OffsetFreq,
