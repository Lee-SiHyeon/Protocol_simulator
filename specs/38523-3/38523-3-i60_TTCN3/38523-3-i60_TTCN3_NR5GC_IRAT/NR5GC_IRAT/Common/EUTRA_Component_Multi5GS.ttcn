module EUTRA_Component_Multi5GS {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_ASP_SrbDefs all;
  import from EUTRA_ASP_TypeDefs all;
  import from EUTRA_Component_5GS all;
  import from NAS_CommonTypeDefs all;

  type record of EUTRA38_DRBInfo_Type EUTRA38_DRBInfoList_Type;   /* @status    APPROVED (NR5GC_IRAT) */

  type record EUTRA38_DRBInfo_Type {                              /* @status    APPROVED (NR5GC_IRAT) */
    integer                         DRB_Id,
    integer                         BearerId,
    boolean                         DefaultBearer,
    RadioBearer_Type                SS_Config,
    DRB_ToAddMod                    DRB_ToAdd,
    PDU_PDN_DNN_Type                APN
  };

  type record EUTRA_Multi5GS_MobileInfo_Type { /* @status    APPROVED (NR5GC_IRAT) */
    // @sic R5s210414 sic@
    EUTRA38_DRBInfoList_Type            ListOfDRBs
  };

  type record PDNConnectivityReq_Type {        /* @status    APPROVED (NR5GC_IRAT) */
    integer                         L_NoOfMsgsRxd,
    record of SRB_COMMON_IND        ListOfMsgs  optional
  };

  type union EPSMsgInDefault_Type {  /* @status    APPROVED (NR5GC_IRAT) */
    PDNConnectivityReq_Type   pdnConnectivityReq
  };

  type record EUTRA_Multi5GS_Global_Type { /* @status    APPROVED (NR5GC_IRAT) */
    EUTRA_Multi5GS_MobileInfo_Type          MobileInfo,
    EPSMsgInDefault_Type                    MsgInDefault,
    InterworkWithoutN26                     NetworkSupport
  };

  type component EUTRA_Multi5GS_PTC extends EUTRA_5GS_PTC { /* @status    APPROVED (NR5GC_IRAT) */

    var  EUTRA_Multi5GS_Global_Type vc_EUTRA_Multi5GS_Global;
  };

  /*
   * @desc      Returns Network support of N26
   * @return    InterworkWithoutN26
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_GetNetworkSupport() runs on EUTRA_Multi5GS_PTC return InterworkWithoutN26
  {
    return vc_EUTRA_Multi5GS_Global.NetworkSupport;
  }

  /*
   * @desc      set  Network support of N26
   * @param     p_IwkN26
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_SetNetworkSupport(InterworkWithoutN26 p_IwkN26) runs on EUTRA_Multi5GS_PTC
  {
    vc_EUTRA_Multi5GS_Global.NetworkSupport := p_IwkN26;
  }

  /*
   * @desc      Return No of DRBs Configured
   * @return    integer
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MobileInfo_GetNoOfDRBs() runs on EUTRA_Multi5GS_PTC return integer
  {
    return lengthof(vc_EUTRA_Multi5GS_Global.MobileInfo.ListOfDRBs);
  }

  /*
   * @desc      Returns List of DRBs Configured
   * @return    EUTRA38_DRBInfoList_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MobileInfo_GetDRBInfoList() runs on EUTRA_Multi5GS_PTC return EUTRA38_DRBInfoList_Type
  {
    return vc_EUTRA_Multi5GS_Global.MobileInfo.ListOfDRBs;
  }

  /*
   * @desc      set updated list of DRB Info
   * @param     p_DRBInfoList
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MobileInfo_SetDRBInfoList(EUTRA38_DRBInfoList_Type p_DRBInfoList) runs on EUTRA_Multi5GS_PTC
  {
    vc_EUTRA_Multi5GS_Global.MobileInfo.ListOfDRBs := p_DRBInfoList;
  }

  /*
   * @desc      to be called during initialization of the EUTRA_Multi5GS_PTC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MobileInfo_Init()  runs on EUTRA_Multi5GS_PTC
  {
    vc_EUTRA_Multi5GS_Global.MobileInfo.ListOfDRBs := {};
    vc_EUTRA_Global.MobileInfo.PdnInfo.EpsBearerContextList := {};             // @sic R5s210414 sic@
  }

  /*
   * @desc      reset / clear list of PDN Connectivity Req messsages stored
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MsgInDefault_ResetStoreOfPDNConnectivityReq() runs on EUTRA_Multi5GS_PTC
  {
    vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.L_NoOfMsgsRxd := 0;
    vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.ListOfMsgs := omit;
  }

  /*
   * @desc      Store 1 PDN Connectivity Req messsage
   * @param     p_Msg
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MsgInDefault_StorePDNConnectivityReq(SRB_COMMON_IND p_Msg) runs on EUTRA_Multi5GS_PTC
  {
    var integer L := vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.L_NoOfMsgsRxd;
    
    vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.ListOfMsgs[L] := p_Msg;
    vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.L_NoOfMsgsRxd := L + 1;
  }

  /*
   * @desc      Get 1 PDN Connectivity Req messsage from store
   * @param     p_L
   * @return    SRB_COMMON_IND
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MsgInDefault_GetOnePDNConnectivityReq(integer p_L) runs on EUTRA_Multi5GS_PTC return SRB_COMMON_IND
  {
    return vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.ListOfMsgs[p_L-1];
  }

  /*
   * @desc      Get number of PDN Connectivity Req messsages in store
   * @return    integer
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_MsgInDefault_GetNumOfPDNConnectivityReq() runs on EUTRA_Multi5GS_PTC return integer
  {
    return vc_EUTRA_Multi5GS_Global.MsgInDefault.pdnConnectivityReq.L_NoOfMsgsRxd;
  }

}
