      measId         := p_MeasId,
      measObjectId   := p_MeasObjectId,
      reportConfigId := p_ReportConfigId
    }
  };

  template (value) QuantityConfig cs_QuantityConfig(template (omit) QuantityConfigEUTRA p_QuantityConfigEUTRA,
                                                    template (omit) QuantityConfigUTRA p_QuantityConfigUTRA,
                                                    template (omit) QuantityConfigGERAN p_QuantityConfigGERAN,
                                                    template (omit) QuantityConfigCDMA2000 p_QuantityConfigCDMA2000,
                                                    template (omit) QuantityConfigUTRA_v1020 p_QuantityConfigUTRA_v1020 := omit,
                                                    template (omit) QuantityConfigEUTRA_v1250 p_QuantityConfigEUTRA_v1250 := omit,
                                                    template (omit) QuantityConfigEUTRA_v1310 p_QuantityConfigEUTRA_v1310 := omit,
                                                    template (omit) QuantityConfigWLAN_r13 p_QuantityConfigWLAN_r13 := omit,
                                                    template (omit) QuantityConfigNRList_r15 p_QuantityConfigNRList_r15 := omit) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    quantityConfigEUTRA := p_QuantityConfigEUTRA,
    quantityConfigUTRA := p_QuantityConfigUTRA,
    quantityConfigGERAN := p_QuantityConfigGERAN,
    quantityConfigCDMA2000 := p_QuantityConfigCDMA2000,
    quantityConfigUTRA_v1020 := p_QuantityConfigUTRA_v1020,            /* @sic BASELINE MOVING 2012 sic@ */
    quantityConfigEUTRA_v1250 := p_QuantityConfigEUTRA_v1250,          /* @sic BASELINE MOVING 2015 sic@ */
    quantityConfigEUTRA_v1310 := p_QuantityConfigEUTRA_v1310,          /* @sic R5-200704, R5s160711 BASELINE MOVING 2016 sic@ */
    quantityConfigWLAN_r13 := p_QuantityConfigWLAN_r13,             /* @sic R5-200704, R5s160711 BASELINE MOVING 2016 sic@ */
    quantityConfigNRList_r15 := p_QuantityConfigNRList_r15            /* @sic R5-200704, R5s180271 BASELINE MOVING 2018 Phase 1 sic@ */
  };

