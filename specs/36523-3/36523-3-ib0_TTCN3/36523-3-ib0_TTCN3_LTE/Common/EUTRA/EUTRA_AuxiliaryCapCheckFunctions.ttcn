  /*
   * @desc      Function to convert the PICS parameters pc_eBandX_Supp from single booleans to a bitstring.
   *            The leftmost bit represent eBand1 support ('1'B if supported according to PICS pc_eBand1_Supp
   *            and '0'B if not supported according to PICS pc_eBand1_Supp).
   *            Bands for which no PICS are defined are set to p_BitValuseForUndefinedBand value
   * @param     p_BitValuseForUndefinedBand (default value: '0'B)
   * @return    bitstring
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, POS, UTRAN)
   */
  function f_DeriveSuppEutraBandsFromPics(B1_Type p_BitValuseForUndefinedBand := '0'B ) return bitstring
  {
    //@sic R5s170598: added p_BitValuseForUndefinedBand sic@
    var bitstring v_Bitstring := f_ConvertBoolToBit(pc_eBand1_Supp) &
                                 f_ConvertBoolToBit(pc_eBand2_Supp) &
                                 f_ConvertBoolToBit(pc_eBand3_Supp) &
                                 f_ConvertBoolToBit(pc_eBand4_Supp) &
                                 f_ConvertBoolToBit(pc_eBand5_Supp) &
                                 f_ConvertBoolToBit(pc_eBand6_Supp) &
                                 f_ConvertBoolToBit(pc_eBand7_Supp) &
                                 f_ConvertBoolToBit(pc_eBand8_Supp) &
                                 f_ConvertBoolToBit(pc_eBand9_Supp) &
                                 f_ConvertBoolToBit(pc_eBand10_Supp) &
                                 f_ConvertBoolToBit(pc_eBand11_Supp) &
                                 f_ConvertBoolToBit(pc_eBand12_Supp) &
                                 f_ConvertBoolToBit(pc_eBand13_Supp) &
                                 f_ConvertBoolToBit(pc_eBand14_Supp) &
                                 p_BitValuseForUndefinedBand &//Band 15 is reserved
                                 p_BitValuseForUndefinedBand &//Band 16 is reserved
                                 f_ConvertBoolToBit(pc_eBand17_Supp) &
                                 f_ConvertBoolToBit(pc_eBand18_Supp) &
                                 f_ConvertBoolToBit(pc_eBand19_Supp) &
                                 f_ConvertBoolToBit(pc_eBand20_Supp) & // @sic R5-103122 sic@
                                 f_ConvertBoolToBit(pc_eBand21_Supp) & // @sic R5-103122 sic@
                                 f_ConvertBoolToBit(pc_eBand22_Supp) & // @sic R5-115190 sic@
                                 f_ConvertBoolToBit(pc_eBand23_Supp) & // @sic R5-113669 sic@
                                 f_ConvertBoolToBit(pc_eBand24_Supp) & // @sic R5-112489 sic@
                                 f_ConvertBoolToBit(pc_eBand25_Supp) & // @sic R5-113156 sic@
                                 f_ConvertBoolToBit(pc_eBand26_Supp) & // @sic R5-121224 sic@
                                 f_ConvertBoolToBit(pc_eBand27_Supp) & // @sic R5s130320 sic@
                                 f_ConvertBoolToBit(pc_eBand28_Supp) & // @sic R5s130320 sic@
                                 f_ConvertBoolToBit(pc_eBand29_Supp) & // @sic R5s130320 sic@
                                 f_ConvertBoolToBit(pc_eBand30_Supp) & // @sic R5-144079 sic@
                                 f_ConvertBoolToBit(pc_eBand31_Supp) & // @sic R5s133307 sic@
                                 f_ConvertBoolToBit(pc_eBand32_Supp) & // @sic R5-151966 sic@
                                 f_ConvertBoolToBit(pc_eBand33_Supp) &
                                 f_ConvertBoolToBit(pc_eBand34_Supp) &
                                 f_ConvertBoolToBit(pc_eBand35_Supp) &
                                 f_ConvertBoolToBit(pc_eBand36_Supp) & //@sic R5s100020 sic@
                                 f_ConvertBoolToBit(pc_eBand37_Supp) &
                                 f_ConvertBoolToBit(pc_eBand38_Supp) &
                                 f_ConvertBoolToBit(pc_eBand39_Supp) &
                                 f_ConvertBoolToBit(pc_eBand40_Supp) &
                                 f_ConvertBoolToBit(pc_eBand41_Supp) & //@sic R5-106554 sic@
                                 f_ConvertBoolToBit(pc_eBand42_Supp) & //@sic R5-110537 sic@
                                 f_ConvertBoolToBit(pc_eBand43_Supp) & //@sic R5-110537 sic@
                                 f_ConvertBoolToBit(pc_eBand44_Supp) & //@sic R5-130710 sic@
                                 f_ConvertBoolToBit(pc_eBand45_Supp) & //@sic R5-165506 sic@
                                 f_ConvertBoolToBit(pc_eBand46_Supp) & //@sic R5-171990 sic@
                                 p_BitValuseForUndefinedBand & //Band 47 not yet defined
                                 f_ConvertBoolToBit(pc_eBand48_Supp) & //@sic R5-172672 sic@
                                 p_BitValuseForUndefinedBand & //Band 49 not yet defined
                                 p_BitValuseForUndefinedBand & //Band 50 not yet defined
                                 p_BitValuseForUndefinedBand & //Band 51 not yet defined
                                 p_BitValuseForUndefinedBand & //Band 52 not yet defined
                                 f_ConvertBoolToBit(pc_eBand53_Supp) & //@sic R5-192337 sic@
                                 f_ConvertBoolToBit(pc_eBand54_Supp);  //@sic R5-232325 sic@
    return v_Bitstring;
  }

  /*
   * @desc      Function to convert the PICS parameters pc_eBand65_Supp to pc_eBand256_Supp from single booleans to a bitstring.
   *            The leftmost bit represent eBand65 support ('1'B if supported according to PICS pc_eBand65_Supp
   *            and '0'B if not supported according to PICS pc_eBand65_Supp).
   *            Bands for which no PICS are defined are set to p_BitValuseForUndefinedBand value
   * @param     p_BitValuseForUndefinedBand (default value: '0'B)
   * @return    bitstring
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_IRAT, UTRAN)
   */
  function f_DeriveSuppEutraBandsFromPics_v9e0(B1_Type p_BitValuseForUndefinedBand := '0'B ) return bitstring
  {
    //@sic R5s170598: added p_BitValuseForUndefinedBand sic@
    var bitstring v_Bitstring := f_ConvertBoolToBit(pc_eBand65_Supp) & //@sic R5-162652 sic@
                                 f_ConvertBoolToBit(pc_eBand66_Supp) & //@sic R5-163090 sic@
                                 f_ConvertBoolToBit(pc_eBand67_Supp) & //@sic R5-236579 sic@
                                 f_ConvertBoolToBit(pc_eBand68_Supp) & //@sic R5-181164 sic@
                                 f_ConvertBoolToBit(pc_eBand69_Supp) & //@sic R5-176304 sic@
                                 f_ConvertBoolToBit(pc_eBand70_Supp) & //@sic R5-168397 sic@
                                 f_ConvertBoolToBit(pc_eBand71_Supp) & //@sic R5-176295 sic@
                                 f_ConvertBoolToBit(pc_eBand72_Supp) & //@sic R5-181163 sic@
                                 f_ConvertBoolToBit(pc_eBand73_Supp) & //@sic R5-196883 sic@
                                 f_ConvertBoolToBit(pc_eBand74_Supp) & //@sic R5-180920 sic@
                                 p_BitValuseForUndefinedBand &//Band 75 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 76 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 77 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 78 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 79 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 80 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 81 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 82 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 83 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 84 not yet defined
                                 f_ConvertBoolToBit(pc_eBand85_Supp) & //@sic R5-193737 sic@
                                 p_BitValuseForUndefinedBand &//Band 86 not yet defined
                                 f_ConvertBoolToBit(pc_eBand87_Supp) & //@sic R5-205088 sic@
                                 f_ConvertBoolToBit(pc_eBand88_Supp) & //@sic R5-205088 sic@
                                 p_BitValuseForUndefinedBand &//Band 89 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 90 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 91 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 92 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 93 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 94 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 95 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 96 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 97 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 98 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 99 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 100 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 101 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 102 not yet defined;
                                 f_ConvertBoolToBit(pc_eBand103_Supp) & //@sic R5-225938 sic@
                                 p_BitValuseForUndefinedBand &//Band 104 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 105 not yet defined
                                 f_ConvertBoolToBit(pc_eBand106_Supp) & //@sic R5s250452 sic@
                                 f_ConvertBoolToBit(pc_eBand107_Supp) & //@sic R5s256237 sic@
                                 f_ConvertBoolToBit(pc_eBand108_Supp) & //@sic R5s256237 sic@
                                 p_BitValuseForUndefinedBand &//Band 109 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 110 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 111 not yet defined
                                 p_BitValuseForUndefinedBand &//Band 122 not yet defined;
