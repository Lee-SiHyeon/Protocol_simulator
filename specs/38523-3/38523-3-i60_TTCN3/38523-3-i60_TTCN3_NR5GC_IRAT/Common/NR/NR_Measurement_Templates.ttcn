  template (present) MeasResults cr_38508_MeasResults(MeasId p_MeasId := tsc_NR_MeasId1,
                                                      PhysCellId p_PhysCellId,
                                                      template MeasResults.measResultNeighCells p_MeasResultNeighCells := omit,
                                                      template (present) MeasQuantityResults p_MeasQuantityResults := f_NR_Get_MeasQuantityResults(),
