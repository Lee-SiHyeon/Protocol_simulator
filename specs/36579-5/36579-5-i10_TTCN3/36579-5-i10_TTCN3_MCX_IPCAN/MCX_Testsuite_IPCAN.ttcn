  testcase TC_5_1_MCData() runs on MTC_MCX system SYSTEM_MCX {
    // @purpose
    //   Configuration / Authentication / User Authorisation / UE Configuration / User Profile / Key Generation
    var MCX_IMS_PTC      v_MCX_IMS    := null;
    var MCX_HTTP_PTC     v_MCX_HTTP   := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_MCX_IMS := MCX_IMS_PTC.create("MCX_IMS") alive;
    v_MCX_HTTP := MCX_HTTP_PTC.create("MCX_HTTP") alive;
  
    f_MTC_MCX_CreateMapAndConnectPTCs_IPCAN(system, v_MCX_IMS, v_MCX_HTTP);
  
    v_MCX_IMS.start(f_TC_5_1_MCData_MCX_IMS());
    v_MCX_HTTP.start(f_TC_5_1_MCData_MCX_HTTP());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_MCX(t_GuardTimer);
  }
