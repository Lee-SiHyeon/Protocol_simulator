  template (value) UL_TimingAdvanceControl_r4 cs_TDD_UL_TimingAdvanceControl_r4 :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    enabled := {
      tddOption := {
        tdd128 := {
          ul_SynchronisationParameters := {
            stepSize := tsc_SS_StepSize_TDD,
            frequency  := tsc_SS_Frequency
          },
          synchronisationParameters := omit
        }
      }
    }
  };

  template (value) UL_CCTrCH_r4 cs_UL_CCTrCH_TDD_r4(TFCS_IdentityPlain p_TFCS_ID := 1,
                                                    UL_TargetSIR p_UL_TargetSIR,
