  template (value) ThresholdUTRA cs_ThresholdUTRA_TDD(UTRA_RSCP_dBm_Type p_UTRAN_Thres) :=
  { /* @status    APPROVED (LTE_IRAT) */
    utra_RSCP := p_UTRAN_Thres + 115
  };

  template (value) MeasObjectUTRA.cellForWhichToReportCGI cs_CellForWhichToReportCGI_FDD (PhysCellIdUTRA_FDD p_PhysCellIdUTRA_FDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    utra_FDD := p_PhysCellIdUTRA_FDD
  };

  template (value) MeasObjectUTRA.cellForWhichToReportCGI cs_CellForWhichToReportCGI_TDD (PhysCellIdUTRA_TDD p_PhysCellIdUTRA_TDD) :=
  { /* @status    APPROVED (LTE_IRAT) */
    utra_TDD := p_PhysCellIdUTRA_TDD
  };

  template (value) CellsToAddModListUTRA_FDD cs_CellsToAddModListUTRA_FDD_2Entries(template (value) CellsToAddModUTRA_FDD.cellIndex p_CellIndex_1,
                                                                                   template (value) PhysCellIdUTRA_FDD p_PhysCellId_1,
                                                                                   template (value) CellsToAddModUTRA_FDD.cellIndex p_CellIndex_2,
                                                                                   template (value) PhysCellIdUTRA_FDD p_PhysCellId_2) :=
  { /* @status    APPROVED (LTE_IRAT) */
    cs_CellsToAddModUTRA_FDD(p_CellIndex_1, p_PhysCellId_1),
    cs_CellsToAddModUTRA_FDD(p_CellIndex_2, p_PhysCellId_2)
  };

  template (value) CellsToAddModListUTRA_TDD cs_CellsToAddModListUTRA_TDD_2Entries(template (value) CellsToAddModUTRA_TDD.cellIndex p_CellIndex_1,
                                                                                   template (value) PhysCellIdUTRA_TDD p_PhysCellId_1,
                                                                                   template (value) CellsToAddModUTRA_TDD.cellIndex p_CellIndex_2,
                                                                                   template (value) PhysCellIdUTRA_TDD p_PhysCellId_2) :=
  { /* @status    APPROVED (LTE_IRAT) */
    cs_CellsToAddModUTRA_TDD(p_CellIndex_1, p_PhysCellId_1),
    cs_CellsToAddModUTRA_TDD(p_CellIndex_2, p_PhysCellId_2)
  };

  template (value) ThresholdUTRA cs_ThresholdUTRA_FDD(UTRA_Ec_Io_dB_Type p_UTRAN_Thres) :=
  { /* @status    APPROVED (LTE_IRAT) */
    utra_EcN0 := p_UTRAN_Thres *2 + 49
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectUTRA_FDD_2entries(ARFCN_ValueUTRA p_CarrierFreq,
                                                                                           PhysCellIdUTRA_FDD p_PhysCellIdUTRA_FDD_1,
                                                                                           PhysCellIdUTRA_FDD p_PhysCellIdUTRA_FDD_2) :=
  { /* @status    APPROVED (LTE_IRAT) */
    measObjectUTRA := {
      carrierFreq := p_CarrierFreq,
      offsetFreq := 0,
      cellsToRemoveList := omit,
      cellsToAddModList := cs_MeasObjectUTRA_cellsToAddModList_FDD(cs_CellsToAddModListUTRA_FDD_2Entries(1, p_PhysCellIdUTRA_FDD_1, 2, p_PhysCellIdUTRA_FDD_2)),
      cellForWhichToReportCGI := omit,
      csg_allowedReportingCells_v930 := omit,   /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reducedMeasPerformance_r12 := omit        /* @sic BASELINE MOVING 2015 sic@ */
    }
  }; //@sic R5s170597 sic@

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectUTRA_TDD_2entries(ARFCN_ValueUTRA p_CarrierFreq,
                                                                                           PhysCellIdUTRA_TDD p_PhysCellIdUTRA_TDD_1,
                                                                                           PhysCellIdUTRA_TDD p_PhysCellIdUTRA_TDD_2) :=
  { /* @status    APPROVED (LTE_IRAT) */
    measObjectUTRA := {
      carrierFreq := p_CarrierFreq,
      offsetFreq := 0,
      cellsToRemoveList := omit,
      cellsToAddModList := cs_MeasObjectUTRA_cellsToAddModList_TDD(cs_CellsToAddModListUTRA_TDD_2Entries(1, p_PhysCellIdUTRA_TDD_1, 2, p_PhysCellIdUTRA_TDD_2)), // @sic R5s170789 sic@
      cellForWhichToReportCGI := omit,
      csg_allowedReportingCells_v930 := omit,   /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reducedMeasPerformance_r12 := omit        /* @sic BASELINE MOVING 2015 sic@ */
    }
  }; //@sic R5s170597 sic@

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_2_1_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9 p_EUTRA_DL_CarrierFreq, //@sic R5-171115, R5-112614 sic@
                                                                                 AllowedMeasBandwidth p_EUTRA_MeasurementBandwidth, //@sic CR R5-112614 sic@
                                                                                 ARFCN_ValueGERAN p_StartingARFCN,
                                                                                 BandIndicatorGERAN p_BandIndicator,
                                                                                 ExplicitListOfARFCNs p_ExplicitListOfARFCNs) :=
  /* @status    APPROVED (LTE_IRAT) */
    cs_508_RRCConnectionReconfiguration_ConditionMEAS(p_RRC_TI,
                                                      cs_MeasConfig(omit,
                                                                    cs_MeasObjectToAddModList_2Entries(//@sic CR R5-112614 sic@
                                                                                                       tsc_IdMeasObject_f1,
                                                                                                       cs_508_MeasObjectEUTRA_GENERIC(f_EUTRA_ARFCN_Value(p_EUTRA_DL_CarrierFreq), p_EUTRA_MeasurementBandwidth), //@sic R5-171115, R5-112614 sic@
                                                                                                       tsc_IdMeasObject_f11,
                                                                                                       cs_MeasObject_measObjectGERAN(p_StartingARFCN,
                                                                                                                                     p_BandIndicator,
                                                                                                                                     cs_FollowingARFCNs_explicitListOfARFCNs(p_ExplicitListOfARFCNs),
                                                                                                                                     0,
                                                                                                                                     omit,
                                                                                                                                     omit)),
                                                                    omit,
                                                                    cs_ReportConfigToAddModList_1Entry(1,
                                                                                                       cs_ReportConfig_reportConfigInterRAT_eventB2_GERAN(-69, -79, 0, ms0, 6, ms1024, infinity_)), //@sic R5-106182 sic@
                                                                    omit,
                                                                    cs_MeasIdToAddModList_1Entry(1, tsc_IdMeasObject_f11, 1),
                                                                    cs_QuantityConfig(cs_QuantityConfigEUTRA(omit, omit),
                                                                                      omit,
                                                                                      cs_QuantityConfigGERAN(rssi, fc0),
                                                                                      omit),  // @sic CR R5-101039 sic@
                                                                    cs_508_MeasGapConfig_GP2,
                                                                    -,-,-,
                                                                    f_ReturnMeasObjectToAddModList_2Entries_v9e0(p_EUTRA_DL_CarrierFreq, omit))); //@sic R5-172903, R5-171115 sic@

  template (value) DL_DCCH_Message cs_RRCConnectionReconfiguration_8_3_2_2_Step1(RRC_TransactionIdentifier p_RRC_TI,
                                                                                 ARFCN_ValueEUTRA_r9 p_EUTRA_DL_CarrierFreq, //@sic R5-171115, R5-112614 sic@
