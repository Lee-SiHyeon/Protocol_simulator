        v_Freq.f2.dl_CarrierFreq := 43490;
        v_Freq.f3.dl_CarrierFreq := 42590;
      }
      case (CA_66A_66A) {   // CA_66A-66A  //@sic R5-166132 sic@
        v_Freq.f1.dl_CarrierFreq := maxEARFCN;
        v_Freq.f1.dl_CarrierFreq_v9e0 := 66486;
        v_Freq.f1.ul_CarrierFreq := maxEARFCN;
        v_Freq.f1.ul_CarrierFreq_v9e0 := 132022;
        v_Freq.f1_DL_ChBandwidth := n50;
        v_Freq.f1_UL_ChBandwidth := n50;
