  //----------------------------------------------------------------------------
  //----------------------------------------------------------------------------
  testcase TC_19_5_10() runs on MTC_LTE_IRAT system SYSTEM_LTE_IRAT {
    // @purpose
    //   Deregistration upon emergency registration expiration
    var EUTRA_PTC        v_EUTRA      := null;
    var UTRAN_IRAT_PTC   v_UTRAN      := null;
    var GERAN_PTC        v_GERAN      := null;
    var CDMA2000_PTC     v_CDMA2000   := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_EUTRA := EUTRA_PTC.create("EUTRA") alive;
    v_IMS2 := IMS_PTC.create("IMS2") alive;
  
    f_MTC_ConnectPTCs_LTE_IRAT(system, v_EUTRA, v_UTRAN, v_GERAN, v_CDMA2000, v_IMS1, v_IMS2);
  
    v_EUTRA.start(f_TC_19_5_10_EUTRA());
    v_IMS2.start(f_TC_19_5_10_IMS2());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_LTE_IRAT(t_GuardTimer);
  }
  //----------------------------------------------------------------------------
  control {
    if (f_IMS_SelectionExpr(IMS34_C62))                 { execute(TC_19_1_3()); }
    if (f_IMS_SelectionExpr(IMS34_C66))                 { execute(TC_19_3_2()); }
    if (f_IMS_SelectionExpr(IMS34_C66))                 { execute(TC_19_3_2b()); }
    if (f_IMS_SelectionExpr(IMS34_C66))                 { execute(TC_19_3_2c()); }
    if (f_IMS_SelectionExpr(IMS34_C162))                { execute(TC_19_4_1()); }
    if (f_IMS_SelectionExpr(IMS34_C64))                 { execute(TC_19_4_2()); }
    if (f_IMS_SelectionExpr(IMS34_C59))                 { execute(TC_19_4_5()); }
    if (f_IMS_SelectionExpr(IMS34_C59))                 { execute(TC_19_5_1()); }
    if (f_IMS_SelectionExpr(IMS34_C59))                 { execute(TC_19_5_10()); }
  }
}
