module InterRat_PLMNSelection_GERAN {

  import from CommonDefs all;
  import from CommonIratDefs all;
  import from GERAN_CellInfo all;
  import from GERAN_CommonFunctions all;
  import from GERAN_Component all;
  import from GERAN_Templates all;
  import from GERAN_TypeDefs all;
  import from NAS_24008Templates_IRAT all;
  import from Parameters all;
  import from UTRANGERAN_CommonFunctions all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.2.1.1
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_6_2_1_1_GERAN ( ) runs on GERAN_PTC
  {
    var G_LLC_DATAMESSAGE_IND v_LLCDataInd;
    var integer v_T3_RF_SignalLevel_Cell24 := tsc_GERAN_ServingCell;
    var B3_Type v_UpdateType;
    var IRAT_Coordination_MSG v_OctetData;
    var octetstring v_PLMN13 := f_U_Asn2Nas_PlmnId(cs_U_PLMN_Identity({0, 0, 2}, {8, 1})); //PLMN13 according to Table 6.2.1.1.3.2-1: Cell PLMN identities
    timer t_IdleMode_GenericTimer_GERAN := 360.0;   //Idle mode generic timer according to 36.523-3 cl. 7.8
    
    //Initialise test case
    f_GERAN_Init ( EUTRA_GERAN ); // @sic R5s120568 sic@

    if (pc_GERAN) { // @sic R5-133723 sic@
        //Set PLMN according to Table 6.2.1.2.3.2-1: Cell PLMN identities
        f_GERAN_PLMN_Set ( geran_Cell24, v_PLMN13 );
        f_GERAN_SysInfo_SetSI2q_1 (geran_Cell24, cs_SysInfoType2quater(cs_SI2quaterRO('0000'B,'0000'B, // @sic R5s120568 sic@
                                                                      '0'B,
                                                                      omit,
                                                                      omit,
                                                                      omit,
                                                                      omit)));
        f_GERAN_SysInfo_SetSI2q_2 (geran_Cell24, omit);
        //Create GERAN cell and broadcast System Infomation
        f_GERAN_CreateCell ( geran_Cell24 );
        f_GERAN_SetCellPowerLevel( geran_Cell24, tsc_GERAN_ChPwrLvl_Off );
        f_GERAN_TestBody_Set( true );

        //Receive updated Authentication parameters from EUTRA PTC
        f_GERAN_InterRAT_InitialiseAuthParams();
        //@siclog "Step 20a18" siclog@
        f_GERAN_SetCellPowerLevel( geran_Cell24, v_T3_RF_SignalLevel_Cell24 );
        EUTRA.receive (cmr_IRAT_OctetData) -> value v_OctetData; // @sic R5s130883 sic@

        //@siclog "Step 20a21" siclog@
        //Wait for CHANNEL REQUEST on cell 24
        t_IdleMode_GenericTimer_GERAN.start;
        v_LLCDataInd := f_GPRS_ReceiveUplinkMsg(geran_Cell24,
                                                car_G_LLC_UnitData_IND(cr_G_RA_UpdReqAny(cr_GMM_UpdateType)),
                                                "Step 20a21");
        t_IdleMode_GenericTimer_GERAN.stop;
        f_IRAT_SendCoOrd ( EUTRA, cms_IRAT_Trigger ); // @sic R5-171567 sic@

        v_UpdateType := f_UG_RauReq_GetUpdateValueForRauAcc(v_LLCDataInd.unit.msg.rauReq);

        //@siclog "Step 20a31" siclog@
        //Perform RAU procedure on cell 24
        f_GERAN_RAUWithoutRAUReq (geran_Cell24, v_UpdateType, -, true, true, oct2int(v_OctetData.OctetData)); //  @sic R5s120811, R5-133584, R5s130883, R5-153114 sic@

        //@siclog "Step 20a32" siclog@
        //Check if PLMN13 is indicated by UE
        f_UT_PLMN_Check ( UT, "00281" );
        //* @verdict pass PLMN13 is indicated by UE
        f_GERAN_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.2.1.1 Step 20a32");

        //@siclog "Step 34" siclog@
        //Adjust cell power levels according to T3
        f_IRAT_SendCoOrd ( EUTRA, cms_IRAT_Trigger );
        f_IRAT_SendCoOrd ( UTRAN, cms_IRAT_Trigger ); // @sic R5s130735 sic@
        f_GERAN_TestBody_Set ( false );
        //Release cell 24
        f_GERAN_SS_CellRelease ( geran_Cell24 );
    }
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.2.1.4
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_6_2_1_4_GERAN() runs on GERAN_PTC
  {
    var octetstring v_PLMN2 := f_U_Asn2Nas_PlmnId(cs_U_PLMN_Identity({0, 0, 2}, {1, 1})); // @sic R5s120025 sic@
    var template (value) SYSTEMINFORMATIONTYPE2quater v_SI2quater1;
    var template (omit) SYSTEMINFORMATIONTYPE2quater v_SI2quater2;

    //Initialise test case
    f_GERAN_Init (EUTRA_GERAN);

    //Set PLMN according to Table 6.2.1.2.3.2-1: Cell PLMN identities
    f_GERAN_PLMN_Set (geran_Cell24, v_PLMN2);

    // @sic R5s150221 sic@
    v_SI2quater1 := f_GERAN_SysInfo_GetSI2q_1 (geran_Cell24);
    v_SI2quater1.sI2quaterRO.geranPrior := '101'B;
    v_SI2quater1.sI2quaterRO.threshPriorSearch := '0000'B;
    f_GERAN_SysInfo_SetSI2q_1 (geran_Cell24, v_SI2quater1);
    v_SI2quater2 := f_GERAN_SysInfo_GetSI2q_2 (geran_Cell24);
    if (isvalue (v_SI2quater2)) {
      v_SI2quater2.sI2quaterRO.geranPrior := '101'B;
      v_SI2quater2.sI2quaterRO.threshPriorSearch := '0000'B;
      f_GERAN_SysInfo_SetSI2q_2 (geran_Cell24, v_SI2quater2);
    }
    
    //Create GERAN cell and broadcast System Information
    f_GERAN_CreateCell (geran_Cell24);

    //Set cell power level according to T0
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_GERAN_SetCellPowerLevel(geran_Cell24, tsc_GERAN_ServingCell);
    
    f_GERAN_TestBody_Set(true);

    // @sic R5-144649 sic@
    //@siclog "Step 21a1&21b1" siclog@
    //IF pc_Available_PLMNs_AcT_Ind (Support of Access Technology Indication in available PLMNs list)
    //THEN PLMN2 (GERAN) is selected.ELSE (No Access Technology shown to the User) PLMN2 is selected
    if(pc_Available_PLMNs_AcT_Ind){    //@sic R5-144649 sic@

      f_IRAT_WaitForCoOrd_Trigger (EUTRA);
      //@siclog "Step 21a2" siclog@
      //The UE completes the registration procedure on GERAN cell 24 as specified in TS 51.010-1 clause 41.2.8.1.1.
      f_GERAN_IdleUpdated (geran_Cell24, -, -, true); // @sic R5-169036 sic@

      //@siclog "Step 21a3" siclog@
      //Check: Is PLMN2 indicated by the UE as the PLMN on which the UE is registered?
      f_UT_PLMN_Check (UT, "00211");
      f_GERAN_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.2.1.4 Step 21a3");

      //Tell E-UTRA PTC that test case is over and perform postamble
      f_GERAN_TestBody_Set (false);
      f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
      // Wait for EUTRA to release cells
      f_IRAT_WaitForCoOrd_Trigger (EUTRA);
      // Set UE in automatic PLMN selection mode
      f_UT_AutomaticPLMN_Select ( UT );
      //wait 300 seconds to let UE complete automatic PLMN search
      f_Delay(300.0);
      
      f_GERAN_Postamble(geran_Cell24, G1_IDLE);

    }else{
      //Wait for end of test case
      f_IRAT_WaitForCoOrd_Trigger (EUTRA);
      f_GERAN_TestBody_Set (false);
      f_GERAN_SS_CellRelease (geran_Cell24);
    }
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.2.1.6
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_6_2_1_6_GERAN ( ) runs on GERAN_PTC
  {
    var octetstring v_PLMN15 := f_U_Asn2Nas_PlmnId(cs_U_PLMN_Identity({0, 0, 1}, {1, 1})); //PLMN15 @sic GP-120370 sic@
    
    //Initialise test case
    f_GERAN_Init (EUTRA_GERAN);
    
    //Set PLMN according to Table 6.2.1.6.3.1-1
    f_GERAN_PLMN_Set (geran_Cell24, v_PLMN15);
    
    //Create GERAN cell and broadcast System Infomation
    f_GERAN_CreateCell (geran_Cell24);

    f_UT_USIM_Insert (UT, "36.523-1 Table 6.2.1.6.3.1-2");
    f_GERAN_Preamble (geran_Cell24);
    f_GERAN_SwitchPowerOff (geran_Cell24, NotSpecified);

    f_GERAN_TestBody_Set(true);
    f_GERAN_SetCellPowerLevel(geran_Cell24, tsc_GERAN_ServingCell);
    
    //Bring UE to initial state
    f_UT_SwitchOnUE(UT, false);
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger); // @sic R5s120027 sic@
    f_GERAN_IdleUpdated (geran_Cell24, -, -, true); // @sic R5-169036 sic@
    //Send updated authentication parameters to EUTRA PTC
    f_GERAN_SendAuthParameters (EUTRA);
    
    //Wait for end of test case
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    
    f_GERAN_TestBody_Set (false);
    
    //Release cell 24
    f_GERAN_SS_CellRelease (geran_Cell24);
  }

}
