  template (present) UE_EUTRA_Capability_v1510_IEs cr_UeCapabilitiesRAT_Container_ENDC_r16 := // @sic R5s201387 BASELINE MOVING 2020 sic@
     /* @status    APPROVED (ENDC) */
     cr_UE_EUTRA_Capability_v1510_IEs(cr_UE_EUTRA_Capability_v1550_IEs);

  template (present) UE_EUTRA_Capability_v1510_IEs cr_UeCapabilitiesRAT_Container_ENDC_r17 := // @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@
     /* @status    APPROVED (ENDC) */
     cr_UE_EUTRA_Capability_v1510_IEs(cr_UE_EUTRA_Capability_v1550_IEs(cr_UE_EUTRA_Capability_v1630_IEs));

  template (present) UE_EUTRA_Capability_v1510_IEs cr_UeCapabilitiesRAT_Container_ENDC_r18 := // @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@
     /* @status    APPROVED (ENDC) */
     cr_UE_EUTRA_Capability_v1510_IEs(cr_UE_EUTRA_Capability_v1550_IEs(cr_UE_EUTRA_Capability_v1630_IEs(cr_UE_EUTRA_Capability_v1730_IEs)));

  /*
   * @desc      Function to check FDD and TDD IEs within UE-EUTRA-Capability-v1540-IEs. Further handling of Table 8.2.1.1.1.3.3-3 Note 1.
   * @param     p_Rx_EutraCapability_v1540
   * @status    APPROVED (ENDC)
   */
  function fl_Check_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR (UE_EUTRA_Capability_v1540_IEs p_Rx_EutraCapability_v1540)
  { //@sic R5-227572 R5-230111 sic@
    var UE_EUTRA_Capability_v1540_IEs v_Rx_EutraCapability_v1540;
    
    var boolean v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15  := false;
    var boolean v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 := false;
    var boolean v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 := false;
    var boolean v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15  := false;
    var boolean v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 := false;
    var boolean v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 := false;
    var boolean v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15  := false;
    var boolean v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 := false;
    var boolean v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 := false;


    v_Rx_EutraCapability_v1540 := p_Rx_EutraCapability_v1540;
    
        
    if (pc_eutra_EPC_HO_ToNR_FDD_FR1_r15) { // eutra_EPC_HO_ToNR_FDD_FR1_r15 fields
        // check indication of eutra_EPC_HO_ToNR_FDD_FR1_r15 in Common IE
        if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15)) {
          v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 := true;
        }

        // check indication of FDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15)) {
          v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 := true;
        }

        // check indication of TDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15)) {
          v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 := true;
        }

        // Error cases if the feature is set
        if ((not (pc_eFDD and pc_eTDD)) and ((not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15) or (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15))) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent with pc_eutra_EPC_HO_ToNR_FDD_FR1_r15 in Single Mode");
        }
        else if (pc_eFDD and pc_eTDD)  // case Dual Mode
        {
           if (not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15)
           {
                if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 and v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15)
                {
                    f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent");
                }
                if ((not v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15) and (not v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15)) {
                    f_SetVerdict(inconc, __FILE__, __LINE__, "pc_eutra_EPC_HO_ToNR_FDD_FR1_r15 is set but eutra_EPC_HO_ToNR_FDD_FR1_r15 IEs are not reported by the UE"); // inconclusive case: UE does not report any IE but pc_eutra_EPC_HO_ToNR_FDD_FR1_r15 is set
                }
            }
            else
            if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_FDD_FR1_r15){
                f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
            }
        }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15) or ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15) or ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_FDD_FR1_r15)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_eutra_EPC_HO_ToNR_FDD_FR1_r15 to false is inconsistent with reported capabilities for >=Rel-15 UEs");
      }
    }// end eutra_EPC_HO_ToNR_FDD_FR1_r15 fields
    
    if (pc_eutra_EPC_HO_ToNR_TDD_FR1_r15) { // eutra_EPC_HO_ToNR_TDD_FR1_r15 fields
        // check indication of eutra_EPC_HO_ToNR_TDD_FR1_r15 in Common IE
        if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15)) {
          v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 := true;
        }

        // check indication of FDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15)) {
          v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 := true;
        }

        // check indication of TDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15)) {
          v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 := true;
        }

        // Error cases if the feature is set
        if ((not (pc_eFDD and pc_eTDD)) and ((not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15) or (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15))) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent with pc_eutra_EPC_HO_ToNR_TDD_FR1_r15 in Single Mode");
        }
        else if (pc_eFDD and pc_eTDD)  // case Dual Mode
        {
           if (not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15)
           {
                if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 and v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15)
                {
                    f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent");
                }
                if ((not v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15) and (not v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15)) {
                    f_SetVerdict(inconc, __FILE__, __LINE__, "pc_eutra_EPC_HO_ToNR_TDD_FR1_r15 is set but eutra_EPC_HO_ToNR_TDD_FR1_r15 IEs are not reported by the UE"); // inconclusive case: UE does not report any IE but pc_eutra_EPC_HO_ToNR_TDD_FR1_r15 is set
                }
            }
            else
            if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR1_r15){
                f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
            }
        }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15) or ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15) or ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR1_r15)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_eutra_EPC_HO_ToNR_TDD_FR1_r15 to false is inconsistent with reported capabilities for >=Rel-15 UEs");
      }
    } // end eutra_EPC_HO_ToNR_TDD_FR1_r15 fields

    if (pc_eutra_EPC_HO_ToNR_TDD_FR2_r15) { // eutra_EPC_HO_ToNR_TDD_FR2_r15 fields
        // check indication of eutra_EPC_HO_ToNR_TDD_FR2_r15 in Common IE
        if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15)) {
          v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 := true;
        }

        // check indication of FDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15)) {
          v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 := true;
        }

        // check indication of TDD IE
        if (ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15)) {
          v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 := true;
        }

        // Error cases if the feature is set
        if ((not (pc_eFDD and pc_eTDD)) and ((not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15) or (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15))) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent with pc_eutra_EPC_HO_ToNR_TDD_FR2_r15 in Single Mode");
        }
        else if (pc_eFDD and pc_eTDD)  // case Dual Mode
        {
           if (not v_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15)
           {
                if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 and v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15)
                {
                    f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent");
                }
                if ((not v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15) and (not v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15)) {
                    f_SetVerdict(inconc, __FILE__, __LINE__, "pc_eutra_EPC_HO_ToNR_TDD_FR2_r15 is set but eutra_EPC_HO_ToNR_TDD_FR2_r15 IEs are not reported by the UE"); // inconclusive case: UE does not report any IE but pc_eutra_EPC_HO_ToNR_TDD_FR2_r15 is set
                }
            }
            else
            if (v_FDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_eutra_EPC_HO_ToNR_TDD_FR2_r15){
                f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
            }
        }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15) or ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15) or ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.eutra_EPC_HO_ToNR_TDD_FR2_r15)) {
        f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_eutra_EPC_HO_ToNR_TDD_FR2_r15 to false is inconsistent with reported capabilities for >=Rel-15 UEs");
      }
    } // end eutra_EPC_HO_ToNR_TDD_FR2_r15 fields
    
  }; //end of fl_Check_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR

  /*
   * @desc      Function to check UE-EUTRA-Capability-v1540-IEs.UE-EUTRA-Capability-v1540-IEs. Handling of Table 8.2.1.1.1.3.3-3 Note 1.
   * @param     p_UE_EUTRA_Capability
   * @status    APPROVED (ENDC)
   */
  function fl_Check_IRAT_ParametersNR_v1540 (UE_EUTRA_Capability p_UE_EUTRA_Capability)
  {
    var UE_EUTRA_Capability_v1540_IEs v_Rx_EutraCapability_v1540;
    var boolean v_IRAT_ParametersNR_v1540_supportedBandListNR_SA_r15  := false;
    var boolean v_FDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 := false;
    var boolean v_TDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 := false;
    
    v_Rx_EutraCapability_v1540 := p_UE_EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;

    // checks ONLY presence of supportedBandListNR-SA-r15
    if (ispresent(v_Rx_EutraCapability_v1540.irat_ParametersNR_v1540.supportedBandListNR_SA_r15)) {
      v_IRAT_ParametersNR_v1540_supportedBandListNR_SA_r15 := true;
    }
    if (ispresent(v_Rx_EutraCapability_v1540.fdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.supportedBandListNR_SA_r15)) {
      v_FDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 := true;
    }
    if (ispresent(v_Rx_EutraCapability_v1540.tdd_Add_UE_EUTRA_Capabilities_v1540.irat_ParametersNR_v1540.supportedBandListNR_SA_r15)) {
      v_TDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 := true;
    }
    
    // supportedBandListNR-SA-r15 fields
    if (v_IRAT_ParametersNR_v1540_supportedBandListNR_SA_r15 or v_FDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15)
    { // check presence of resp. supportedBandListNR-SA-r15 fields only if any irat_ParametersNR_v1540 IE is reported
      
        if ((not (pc_eFDD and pc_eTDD)) and ((not v_IRAT_ParametersNR_v1540_supportedBandListNR_SA_r15) or (v_FDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 or v_TDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15))) {
             f_SetVerdict(fail, __FILE__, __LINE__, "reporting of SupportedBandListNR-r15 in common IE or derived FDD/TDD UE-NR-Capabilities IEs is inconsistent with Single Mode case");  // Fail case on Single Mode
        }
        else if ((pc_eFDD and pc_eTDD) and (v_IRAT_ParametersNR_v1540_supportedBandListNR_SA_r15 and (v_FDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15 xor v_TDD_Add_UE_EUTRA_Cap_v1540_supportedBandListNR_SA_r15))) {
            f_SetVerdict(fail, __FILE__, __LINE__, "reporting of SupportedBandListNR-r15 in common IE and derived FDD/TDD UE-NR-Capabilities IEs is inconsistent with Dual Mode case"); // Fail case on Dual Mode
        }
    }// end supportedBandListNR-SA-r15 fields
    
    fl_Check_IRAT_ParametersNR_v1540_eutra_EPC_HO_ToNR (v_Rx_EutraCapability_v1540);

  }; //end of fl_Check_IRAT_ParametersNR_v1540

  /*
   * @desc      Reported value of IRAT-ParametersNR-v1610.nr-HO-ToEN-DC-r16 checked against pc_interRAT_NR_ToENDC.
                Checks the UECapabilitymessage against the setting of the PICS declaring the support of nr-HO-ToEN-DC-r16 along with fdd_Add_UE_EUTRA_Capabilities_v1610, tdd_Add_UE_EUTRA_Capabilities_v1610
                for Rel-16 UEs. Handling of Table 8.2.1.1.1.3.3-3 Note 2.
   * @param     p_UE_EUTRA_Capability
   * @status    APPROVED (ENDC)
   */
  function fl_Derive_EUTRA_nr_HO_ToEN_DC_r16(UE_EUTRA_Capability p_UE_EUTRA_Capability)
  { /* @status    APPROVED (ENDC) */
    // @sic R5-206430 R5-211501 R5s211482 sic@
    var UE_EUTRA_Capability_v1610_IEs v_Rx_EutraCapability_v1610;
    var boolean v_IRAT_ParametersNR_v1610_nr_HO_ToEN_DC_r16 := false;
    var boolean v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 := false;
    var boolean v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 := false;
    
    if (ispresent(p_UE_EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension))
    {
         v_Rx_EutraCapability_v1610 := p_UE_EUTRA_Capability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
    }

    if (pc_interRAT_NR_ToENDC) {
        // check indication of MeasAndMobParametersXDD_Diff_Common
        if (ispresent(v_Rx_EutraCapability_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16)) {
          v_IRAT_ParametersNR_v1610_nr_HO_ToEN_DC_r16 := true;
        }

        // check indication of FDD IE
        if (ispresent(v_Rx_EutraCapability_v1610.fdd_Add_UE_EUTRA_Capabilities_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16)) {
          v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 := true;
        }

        // check indication of TDD IE
        if (ispresent(v_Rx_EutraCapability_v1610.tdd_Add_UE_EUTRA_Capabilities_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16)) {
          v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 := true;
        }

        // Error cases if the feature is set
        if ((not (pc_eFDD and pc_eTDD)) and ((not v_IRAT_ParametersNR_v1610_nr_HO_ToEN_DC_r16) or (v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 or v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16))) { // fail cases on Single mode
         f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent with pc_interRAT_NR_ToENDC on Single Mode");
        }
        else if (pc_eFDD and pc_eTDD)  // case Dual Mode
        {
           if (not v_IRAT_ParametersNR_v1610_nr_HO_ToEN_DC_r16)
           {
                if (v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 and v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16)
                {
                    f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FDD/TDD Add_UE_EUTRA_Capabilities IEs is inconsistent");
                }
                if ((not v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16) and (not v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16)) {
                    f_SetVerdict(inconc, __FILE__, __LINE__, "pc_interRAT_NR_ToENDC is set but IRAT_ParametersNR_v1610_nr_HO_ToEN_DC_r16 IEs are not reported by the UE"); // inconclusive case: UE does not report any IE but pc_interRAT_NR_ToENDC is set
                }
            }
            else
            if (v_FDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16 or v_TDD_Add_UE_EUTRA_Capabilities_v1610_nr_HO_ToEN_DC_r16){
                f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
            }
        }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FDD/TDD IEs are reported by the UE
      if (ispresent(v_Rx_EutraCapability_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16) or ispresent(v_Rx_EutraCapability_v1610.fdd_Add_UE_EUTRA_Capabilities_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16) or ispresent(v_Rx_EutraCapability_v1610.tdd_Add_UE_EUTRA_Capabilities_v1610.irat_ParametersNR_v1610.nr_HO_ToEN_DC_r16)) {
        f_SetVerdict(fail, __FILE__, __LINE__, "setting of pc_interRAT_NR_ToENDC to false is inconsistent with reported capabilities for >=Rel-16 UEs");
      }
    }
  }

  /*
   * @desc      Function to match the received UECapabilityInformation with the expected UE-EUTRA-Capability template
   * @param     p_ReceivedCapabilityMsg
   * @param     p_Expected_Ue_EUTRA_Capability
   * @status    APPROVED (ENDC)
   */
  function fl_EUTRA_UE_Capability_MatchTemplates(UE_EUTRA_Capability_v1510_IEs p_ReceivedCapabilityMsg,
                                                 template UE_EUTRA_Capability_v1510_IEs p_Expected_Ue_EUTRA_Capability)
  {
    // Match the received decoded UE_EUTRA_Capability template with the expected template
    if (not match(p_ReceivedCapabilityMsg, p_Expected_Ue_EUTRA_Capability)) {
      f_SetVerdict(fail, __FILE__, __LINE__, "Test Case 8.2.1.1.1 Step 2 - Received UE_EUTRA_Capability template does not match with the expected template");
    }
  }

  /*
   * @desc      TP1 of tc8.2.1.1.1: SS transmits a UECapabilityEnquiry message including eutra with
                rrc-segAllowed-r16 set to enabled, decodes UECapabilityInformation message including UE radio access capability information as per the ue-CapabilityRequestand from the UE and stores the UE-CapabilityRAT-Container
   * @param     p_CellId
   * @param     p_RRC_TI            (default value: tsc_RRC_TI_Def)
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_TxUECapEnquiry_RxUECapabilityInformation_TP1(EUTRA_CellId_Type         p_CellId,
                                                                  RRC_TransactionIdentifier p_RRC_TI := tsc_RRC_TI_Def) runs on EUTRA_PTC
  { // @sic R5-211501 R5-216277 sic@
    var UE_EUTRA_Capability v_RxEutraCapability;
    var template UE_EUTRA_Capability_v1510_IEs v_EutraCapability_Expected;
    var UE_EUTRA_Capability_v1510_IEs v_Rx_Decoded_EutraCapability;
    var boolean v_Completed_AllSegments := false;

        //@siclog "Step 1" siclog@
        // The SS transmits a UECapabilityEnquiry message including eutra with rrc-segAllowed-r16 set to enabled
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15IEs_true_SegAllowed_r16_enabled(p_RRC_TI)));

        v_RxEutraCapability := f_EUTRA_GetCaps(p_CellId, p_RRC_TI);  // @sic R5-217903 sic@
        
        v_Rx_Decoded_EutraCapability := v_RxEutraCapability.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
        
        select (v_RxEutraCapability.accessStratumRelease) { //As per TS36.523-1 Table 8.5.4.1.3.3/2; details not checked in the scope of the present NR RRC TC 8.2.1.1.1
          case (rel8, rel9, rel10, rel11, rel12, rel13, rel14) {
            f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "AccessStratumRelease < release15");
          }
          case (rel15) {
            v_EutraCapability_Expected := cr_UeCapabilitiesRAT_Container_ENDC_r15;
          }
          case (rel16) { // @sic R5s201387 BASELINE MOVING 2020 R5s221179 BASELINE MOVING 2022 sic@
            v_EutraCapability_Expected := cr_UeCapabilitiesRAT_Container_ENDC_r16;
            
            fl_EUTRACap_CommonChecks_r16(v_RxEutraCapability);
          }
          case (rel17) { // @sic R5s221179 BASELINE MOVING 2022 sic@
            v_EutraCapability_Expected := cr_UeCapabilitiesRAT_Container_ENDC_r17;
            
            fl_EUTRACap_CommonChecks_r17(v_RxEutraCapability);
          }
          case (rel18) { // @sic R5s240531 BASELINE MOVING 2024 sic@
            v_EutraCapability_Expected := cr_UeCapabilitiesRAT_Container_ENDC_r18;
            
            fl_EUTRACap_CommonChecks_r18(v_RxEutraCapability);
          }
          case else  {
            f_SetVerdictInconc (__FILE__, __LINE__, "AccessStratumRelease not applicable for the purpose of tc8.2.1.1.1");
          }
        }
        
        // Match the received UE-EUTRA-CapabilityInformation with the expected UE_EUTRA_Capability template
        fl_EUTRA_UE_Capability_MatchTemplates(v_Rx_Decoded_EutraCapability, v_EutraCapability_Expected);
        if (v_Completed_AllSegments) {
            f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2a2");
        }
        else {
            f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2b1");
        }
  };

  /*
   * @desc      TP2 of tc8.2.1.1.1: SS transmits a UECapabilityEnquiry message including eutra-nr and nr  with
                rrc-segAllowed-r16 set to enabled, decodes UECapabilityInformation message including UE radio access capability information as per the ue-CapabilityRequestand from the UE and sends the UE-CapabilityRAT-Container to NR for check
   * @param     p_CellId
   * @param     p_RRC_TI            (default value: tsc_RRC_TI_Def)
   * @status    APPROVED (ENDC)
   */
  function f_EUTRA38_TxUECapEnquiry_RxUECapabilityInformation_TP2(EUTRA_CellId_Type p_CellId,
                                                                  RRC_TransactionIdentifier p_RRC_TI := tsc_RRC_TI_Def) runs on EUTRA_5GS_PTC
  { // @sic R5-216277 sic@
    var SRB_COMMON_IND v_ReceivedAspForUeCapabilityInfo;
    var octetstring v_NRCapability;
    var octetstring v_ENDCCapability;
    var octetstring v_NR_MRDC_Freqs;
    var SRB_COMMON_IND v_Received_DedicatedMessageSegment;
    
    var octetstring v_Rx_SegmentOct := ''O;
    var boolean v_Completed_AllSegments := false;
    var ULDedicatedMessageSegment_r16_IEs.segmentNumber_r16 v_MessageSegmentRx := 0; //INTEGER (0..15)
    
    // Step 3: The SS transmits a UECapabilityEnquiry message including eutra-nr and nr with rrc-segAllowed-r16 set to enabled
    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (int2oct(f_EUTRA_CellInfo_GetBand (p_CellId), 1), "EUTRA Band"));
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "MRDC_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15_SegAllowed_r16_enabled(p_RRC_TI, cs_UE_CapabilityRequest_EUTRA_ENDC, v_NR_MRDC_Freqs)));
      }
      case (NR_SA) { // @sic R5s200369 sic@
      // TCSE for tc8.2.1.1.1 is NR_C01 (pc_ENDC) so this condition won't be reached anyway
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "NR_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15_SegAllowed_r16_enabled(p_RRC_TI, cs_UE_CapabilityRequest_NR, v_NR_MRDC_Freqs)));
      }
      // To be extended for other options
    }
                                                                
    // Rx UE Capability Information as per Steps (4a1/4a2 | 4b1)
    // IF pc_LTE_UL_Segmentation and UE's encoded UECapabilityInformation message >= Max PDCP SDU size then steps 4a1 and 4a2 will be performed else step 4b1 will be performed
    alt {
       // EXCEPTION: Step 4a1 is repeated a maximum of 16 times or till rrc-MessageSegmentType-16 IE within the UlDedicatedMessageSegment message indicate rrc-MessageSegmentType-r16 = lastSegment.
       [pc_LTE_UL_Segmentation] SRB.receive( car_SRB1_RrcPdu_IND(p_CellId, cr_508_ULDedicatedMessageSegment_r16(cr_ULDedicatedMessageSegment_r16_enabled(v_MessageSegmentRx))) ) -> value v_Received_DedicatedMessageSegment
       {
         v_Rx_SegmentOct := v_Rx_SegmentOct & v_Received_DedicatedMessageSegment.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ulDedicatedMessageSegment_r16.criticalExtensions.ulDedicatedMessageSegment_r16.rrc_MessageSegmentContainer_r16;   //compact segment
         if (v_Received_DedicatedMessageSegment.Signalling.Rrc.Dcch.message_.messageClassExtension.c2.ulDedicatedMessageSegment_r16.criticalExtensions.ulDedicatedMessageSegment_r16.rrc_MessageSegmentType_r16 == lastSegment){ // no more segments to receive
             v_Completed_AllSegments := true;
         }
         else { // notLastSegment received
             if (v_MessageSegmentRx == 15) { f_EUTRA_SetVerdictFailOrInconc(__FILE__,__LINE__, "Received a notLastSegment as 16th segment from the UE");}
             v_MessageSegmentRx := v_MessageSegmentRx + 1;
             repeat;
         }
       }
       [not pc_LTE_UL_Segmentation] SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_508_ULDedicatedMessageSegment_r16(?))) // VerdictFail case
       {
          f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "pc_LTE_UL_Segmentation not set for segmentation when UECapabilityInformation message >= Max PDCP SDU size");
       }
       //Step 4b1: Check: Does the UE transmit a UECapabilityInformation message including UE radio access capability information as per the ue-CapabilityRequest variable?
       [] SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_UeCapabilityInformation_Any(p_RRC_TI)))
                                                                -> value v_ReceivedAspForUeCapabilityInfo
       {
           if (v_MessageSegmentRx>0) {
               f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE radio access capability information received after a segment"); // VerdictFail case: steps 4b1 are mutually exclusive with 4ax
           }
       }
    };//end alt
    
    // Decode and store the UE-CapabilityRAT-Container
    if (v_Completed_AllSegments){ //UECapabilityInformation Rx. on segments
        if (lengthof(v_Rx_SegmentOct) < tsc_Max_LTE_PDCP_SDU_size) //Set to <8188 by default - @sic R5s220330 sic@
        {
          f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "UE segmented the UECapabilityInformation message being smaller than Max PDCP SDU size");
        }
        v_NRCapability := v_Rx_SegmentOct;
    }
    else{                         //UECapabilityInformation Rx. in one message
        // Decode and store the ueCapabilitiesRAT-Container
        v_NRCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[0].ueCapabilityRAT_Container;
        // UE-EUTRA-Capability encoded as per TS 36.331 clause 6.3.6
    }

    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        v_ENDCCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[1].ueCapabilityRAT_Container;
        // Send NR capabilities to NR PTC
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_ENDCCapability, "ENDCCap"));
      }
      case (NR_SA) { // @sic R5s200369 sic@
        // Send NR capabilities to NR PTC. TCSE for tc8.2.1.1.1 is NR_C01 (pc_ENDC) so this condition won't be reached anyway
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
      }
      // To be extended for other options
    }
  }

  /*
   * @desc      Function to check some Rel 16 UE EUTRA capabilities. Prints out all the PICS wrongly set specific within r16
   * @param     p_EUTRACapability
   * @status    APPROVED (ENDC)
   */
  function fl_EUTRACap_CommonChecks_r16(UE_EUTRA_Capability p_EUTRACapability)
  { // @sic R5-211501 sic@
    var UE_EUTRA_Capability v_Received_EUTRACapability;
    
    v_Received_EUTRACapability := p_EUTRACapability;

    fl_Check_IRAT_ParametersNR_v1540(v_Received_EUTRACapability);  //Note 1 of TS 38.523-1 Table 8.2.1.1.1.3.3-3
    fl_Derive_EUTRA_nr_HO_ToEN_DC_r16(v_Received_EUTRACapability); //Note 2 of TS 38.523-1 Table 8.2.1.1.1.3.3-3
  } // end of fl_EUTRACap_CommonChecks_r16

  /*
   * @desc      Function to check some Rel 17 UE EUTRA capabilities. Prints out all the PICS wrongly set specific within r17
   * @param     p_EUTRACapability
   * @status    APPROVED (ENDC)
   */
  function fl_EUTRACap_CommonChecks_r17(UE_EUTRA_Capability p_EUTRACapability)
  {
    fl_EUTRACap_CommonChecks_r16(p_EUTRACapability);
  } // end of fl_EUTRACap_CommonChecks_r17

  /*
   * @desc      Function to check some Rel 18 UE EUTRA capabilities. Prints out all the PICS wrongly set specific within r18
   * @param     p_EUTRACapability
   * @status    APPROVED (ENDC)
   */
  function fl_EUTRACap_CommonChecks_r18(UE_EUTRA_Capability p_EUTRACapability)
  {
    fl_EUTRACap_CommonChecks_r17(p_EUTRACapability);
  } // end of fl_EUTRACap_CommonChecks_r18

  /*
   * @desc      test body of TC_8_2_1_1_1_ENDC_EUTRA
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_1_1_1_ENDC_EUTRA_TestBody() runs on EUTRA_5GS_PTC
  { // @sic R5-216277 sic@
    // The SS transmits a UECapabilityEnquiry message including eutra with rrc-segAllowed-r16 set to enabled
    // @siclog "Steps 1-2x" siclog@
    // Check: Does the UE transmit a UECapabilityInformation message including UE radio access capability information as per the ue-CapabilityRequest variable?
    f_EUTRA38_TxUECapEnquiry_RxUECapabilityInformation_TP1(eutra_Cell1);
    /* This function enquires for the eutra capability without checking */
    /* the contents of the message received but checks the structure of the template */
    
    // @siclog "Steps 3-4x" siclog@
    // The SS transmits a UECapabilityEnquiry message including eutra-nr and nr
    // Receives UECapabilityInformation message to be checked on NR side
    f_EUTRA38_TxUECapEnquiry_RxUECapabilityInformation_TP2(eutra_Cell1);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 4");

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.1.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_1_1_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  { // UE Capability transfer / RRC Others
    // @sic R5s190192 sic@
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //The UE is in state RRC_CONNECTED in EN-DC mode according to TS 38.508-1 [4] clause 4.5.4.2 with MCG and SCG.
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTMode_OFF, MCG_SCG, RRC_CONNECTED);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_2_1_1_1_ENDC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    // taking down the NR cell!
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

}
