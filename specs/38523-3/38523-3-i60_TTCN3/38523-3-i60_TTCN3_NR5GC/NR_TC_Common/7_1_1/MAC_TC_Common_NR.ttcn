  /*
   * @desc      Configures UL GrantConfiguration on SS full configurable
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ImcsValue
   * @param     p_N_PRB
   * @param     p_Index
   * @param     p_NR_ResourceAllocationType (default value: resourceAllocationType0)
   * @param     p_NR_DciFormat_0_X_SpecificInfo (default value: omit)
   * @param     p_StartIndex        (default value: 0)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_ULGrantConfiguration_ULTBS(NR_CellId_Type   p_NR_CellId,
                                           template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                           NR_ImcsValue_Type p_ImcsValue,
                                           integer p_N_PRB,
                                           bitstring p_Index,
                                           template (value) NR_ResourceAllocationType_Type p_NR_ResourceAllocationType := resourceAllocationType0, //@sic R5-221589 sic@
                                            template (omit)  NR_DciFormat_0_X_SpecificInfo_Type p_NR_DciFormat_0_X_SpecificInfo := omit, //@sic R5s240522 sic@
                                            integer p_StartIndex:=0) runs on NR_BASE_PTC
  {
    var template (value) NR_DciUlInfo_Type v_DciUlInfo := cds_NR_DciUlInfo_ModifyGrant(cs_NR_FreqDomainSchedulExplicit(p_StartIndex, p_N_PRB),
                                                                                       cs_NR_DciCommon_TimeDomainResourceAssignment(p_Index),
                                                                                       p_ImcsValue,
                                                                                       -,//@sic R5-221589 sic@
                                                                                       -,
                                                                                       p_NR_DciFormat_0_X_SpecificInfo);
    v_DciUlInfo.ResoureAssignment.ResourceAllocationType := p_NR_ResourceAllocationType;
    f_NR_ULGrantConfiguration_Common(p_NR_CellId, p_TimingInfo, v_DciUlInfo, cs_NR_UplinkTimeAlignment_Start, cs_UL_GrantConfig_OnSR); //@sic R5s210884 sic@
  }

  /*
   * @desc      Configures UL Grant to start tc7.1.1.3.1
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ImcsValue         (default value: tsc_NR_DefaultGrant_Imcs)
   * @param     p_FreqDomainSchedul (default value: )
   * @param     p_PUCCH_Synch       (default value: cs_NR_UplinkTimeAlignment_Start)
   * @param     p_UL_GrantConfig    (default value: cs_UL_GrantConfig_OnSR)
   * @param     p_HarqProcessConfig (default value: omit)
   * @status    APPROVED (ENDC, NR5GC)
   */

   function f_NR_ULGrantConfiguration_Start_71131(NR_CellId_Type   p_NR_CellId,
                                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                 NR_ImcsValue_Type p_ImcsValue := tsc_NR_DefaultGrant_Imcs,
                                                 template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul,
                                                 template (omit)  NR_UplinkTimeAlignment_Synch_Type p_PUCCH_Synch := cs_NR_UplinkTimeAlignment_Start,
                                                 template (omit)  UL_GrantConfig_Type p_UL_GrantConfig := cs_UL_GrantConfig_OnSR, //@sic R5s200010 sic@
                                                 template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit) runs on NR_BASE_PTC
  {
    var template (value) NR_DciUlInfo_Type v_DciUlInfo := cs_NR_DciUlInfo_AllOmit;
    var template (value) NR_TransportBlockRetransmissionList_Type v_TransportBlockRetransmissionList := {
      cs_NR_TransportBlockSingleTransmission(p_ImcsValue),
      cs_NR_TransportBlockSingleTransmission(p_ImcsValue, 1, false) //@sic R5s200931 sic@
    };
    v_DciUlInfo.ResoureAssignment := cs_NR_DciFormat_0_X_ResourceAssignment(-, p_FreqDomainSchedul, -, v_TransportBlockRetransmissionList,p_HarqProcessConfig);//@sic R5s200010 sic@
    f_NR_ULGrantConfiguration_Common(p_NR_CellId, p_TimingInfo, v_DciUlInfo, p_PUCCH_Synch, p_UL_GrantConfig);
  }

