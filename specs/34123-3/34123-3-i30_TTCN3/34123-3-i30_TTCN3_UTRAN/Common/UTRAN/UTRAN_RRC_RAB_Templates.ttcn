  const E_DCH_MAC_d_FlowIdentity    tsc_E_DCH_MAC_d_FlowId_DCCH := 1;            /* MAC-d flow id for DCCH mapped on E-DCH
                                                                                    @status    APPROVED (LTE_IRAT, UTRAN) */

  const E_HICH_ChannelisationCode   tsc_E_HICH_ChannelisationCode := 4;          /* channelisation code acc. TS 34.108
                                                                                    @status    APPROVED (LTE_IRAT, UTRAN) */

