module CommonPOS_Templates {

  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"}; 
  import from NAS_CommonTypeDefs all;

  const bitstring tsc_AgnssUEPosTech := '00000000'B;       /* @status    APPROVED (POS) */

  const bitstring tsc_OtdoaUEPosTech := '00000001'B;       /* @status    APPROVED (POS) */

  const bitstring tsc_MbsUEPosTech := '00000010'B;         /* @sic R5-165996: MBS inclusion sic@
                                                              @status    APPROVED (POS) */

  const bitstring tsc_WlanUEPosTech := '00000011'B;        /* @sic R5-170735 sic@ /
                                                              @status    APPROVED (POS) sic@*/

  const bitstring tsc_BluetoothUEPosTech := '00000100'B;   /* @sic R5-170735 sic@
                                                              @status    APPROVED (POS)*/

  const bitstring tsc_SensorUEPosTech := '00000101'B;      /* @sic R5-170735  sic@
                                                              @status    APPROVED (POS)*/

  const bitstring tsc_MultiRttUEPosTech := '00000110'B;    /* @sic R5-217935  sic@
                                                              @status    APPROVED (POS)*/

  const bitstring tsc_DlTdoaUEPosTech := '00000111'B;      /* @sic R5-217935  sic@
                                                              @status    APPROVED (POS)*/

  const bitstring tsc_DlAodUEPosTech := '00001000'B;       /* @sic R5-217935  sic@
                                                              @status    APPROVED (POS)*/

  template (value) AdditionalInformation cs_RoutingInfo (octetstring p_RoutingId) :=
  { /* 24.301 cl. 9.9.2.0 */
    /* @status    APPROVED (POS) */
    iei := '65'O,
    iel := '04'O,
    additionalInfo := p_RoutingId
  };

  template (present) AdditionalInformation cr_RoutingInfo (octetstring p_RoutingId) :=
  { /* 24.301 cl. 9.9.2.0 */
    /* @status    APPROVED (POS) */
    iei := '65'O,
    iel := '04'O,
    additionalInfo := p_RoutingId
  };

}
