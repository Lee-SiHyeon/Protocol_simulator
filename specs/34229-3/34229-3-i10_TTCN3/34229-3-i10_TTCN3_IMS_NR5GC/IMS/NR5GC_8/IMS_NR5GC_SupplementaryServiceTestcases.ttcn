  /*
   * @desc      REFERENCE TS 34.229-5 clause 8.28.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_28_NR5GC_IMS1() runs on IMS_PTC
  { // MT Voice Call Hold without announcement / 5GS
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) SDP_Message v_SDP_LatestMessageBySS;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var boolean v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);

    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a();             /* @sic R5-231504: f_IMS_MOCallSetup_NR5GC_A_4_1a instead of f_IMS_MOCallSetup_NR5GC_A_4_1 sic@ */
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_CallInfo.MessageHeader183);
    v_SDP_LatestMessageBySS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_CallInfo.LatestSdpOffer, v_DontIncrementSessVers);

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 4" siclog@
    f_IMS_MTCallHoldResume(HOLD, v_ContactUrlUE, v_SDP_LatestMessageBySS, v_ContactUrlSS);      /* @sic R5s210707: as the call is MO the SS's contact address not as per default for MT sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    
    // @siclog "Step 5 - 8" siclog@
    f_IMS_MTCallHoldResume(RESUME, v_ContactUrlUE, v_SDP_LatestMessageBySS, v_ContactUrlSS);    /* @sic R5s210707: as the call is MO the SS's contact address not as per default for MT sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 9 - 10" siclog@
    f_IMS_CallReleaseMO(v_CallInfo.InviteRequestWithSdp.Invite);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.29.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_29_NR5GC_IMS1() runs on IMS_PTC
  { // MT Video Call Hold without announcement / 5GS
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var template (value) SDP_Message v_SDP_LatestMessageBySS;
    var SipUrl v_ContactUrlUE;
    var SipUrl v_ContactUrlSS;
    var boolean v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MO_VideoCall);

    v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_15_1a();      // @sic R5-231505: A_15_1a sic@
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    v_ContactUrlSS := f_MessageHeader_GetContactSipUrl(v_CallInfo.MessageHeader183);
    v_SDP_LatestMessageBySS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_CallInfo.LatestSdpOffer, v_DontIncrementSessVers);

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 4" siclog@
    f_IMS_MTCallHoldResume(HOLD, v_ContactUrlUE, v_SDP_LatestMessageBySS, v_ContactUrlSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    
    // @siclog "Step 5 - 8" siclog@
    f_IMS_MTCallHoldResume(RESUME, v_ContactUrlUE, v_SDP_LatestMessageBySS, v_ContactUrlSS);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 9 - 11" siclog@
    f_IMS_CallReleaseMO(v_CallInfo.InviteRequestWithSdp.Invite);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 8.30.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_30_NR5GC_IMS1() runs on IMS_PTC
  { // Subscription to the MWI event package / 5GS
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var REGISTER_Request v_RegisterRequest;
    var SUBSCRIBE_Request v_SubscribeReq_MsgSummaryEvent;
    var SipUrl v_ContactUrl_RegEvent;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL);

    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    v_IMS_REGISTER_REQ := f_IMS_Register();
    v_RegisterRequest := v_IMS_REGISTER_REQ.Request.Register;
    v_ContactUrl_RegEvent := f_MessageHeader_GetContactSipUrl(v_RegisterRequest.msgHeader);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 4" siclog@
    v_SubscribeReq_MsgSummaryEvent := f_IMS_MWI_Subscribe(); /* !!!! PROSE ISSUE: SUBSCRIBE messages at steps 1 and 3 may come in any order !!!! */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 1");

    // @siclog "Step 5 - 6" siclog@
    f_IMS_MWI_Notify(v_SubscribeReq_MsgSummaryEvent, false);   // no message waiting
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    // @siclog "Step 7 - 8" siclog@
    f_IMS_MWI_Notify(v_SubscribeReq_MsgSummaryEvent, true);    // message waiting
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9 - 10" siclog@
    f_IMS_Register_Notify(v_ContactUrl_RegEvent, f_IMS_XmlMessageForNotify_Active(v_RegisterRequest));
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      34.229-5 A.19 Steps 1 to 9
   * @param     p_ConferenceFactoryUri
   * @param     p_TemporaryConferenceUri
   * @param     p_FinalConferenceUri
   * @param     p_RadioBearersEstablished (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_ConferenceCreation_NR5GC_A_19_Steps1_9(charstring p_ConferenceFactoryUri,
                                                        charstring p_TemporaryConferenceUri,
                                                        charstring p_FinalConferenceUri,
                                                        boolean p_RadioBearersEstablished := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var template (value) SemicolonParam_List v_AdditionalContactParams := {cs_GenericParam("isfocus")};
    var template (present) SipUrl v_ConferenceFactoryUri := f_SIP_BuildSipUri_RX(p_ConferenceFactoryUri);
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) SDP_Message v_InitialSdpAnswer;
    var template (present) SDP_Message v_UpdatedSdpOffer;

    // Step 1:                  Receive INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(v_ConferenceFactoryUri);                                                           /* @sic R5-232762: A_4_1a (EVS_A2) sic@ */

    // step 2 - 7
    v_InitialSdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer, tsc_SDP_WithPreconditions, EVS_16000, EVS_A2, 65);    /* @sic R5-232762: A_4_1a (EVS_A2) sic@ */
    v_UpdatedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2);                                  /* @sic R5-232762: A_4_1a (EVS_A2) sic@ */
    f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step2_7(IPCAN_MO_SpeechCall, v_InviteRequestWithSdp, p_TemporaryConferenceUri, v_AdditionalContactParams, v_InitialSdpAnswer, v_UpdatedSdpOffer, CONFERENCE_CALL, p_RadioBearersEstablished);  // @sic R5s220849: v_EarlyQosConfirmation removed sic@

    // Step 8 - 9:              Send 200 OK, seceive ACK
    f_IMS_Conferencing_Send200OK_ReceiveACK(v_InviteRequestWithSdp, p_FinalConferenceUri, v_AdditionalContactParams);
 
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.25 Steps 1 to 9
   * @param     p_ConferenceFactoryUri
   * @param     p_TemporaryConferenceUri
   * @param     p_FinalConferenceUri
   * @param     p_RadioBearersEstablished (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_ConferenceCreation_NR5GC_A_25_Steps1_9(charstring p_ConferenceFactoryUri,
                                                        charstring p_TemporaryConferenceUri,
                                                        charstring p_FinalConferenceUri,
                                                        boolean p_RadioBearersEstablished := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var template (value) SemicolonParam_List v_AdditionalContactParams := {cs_GenericParam("isfocus")};
    var template (present) SipUrl v_ConferenceFactoryUri := f_SIP_BuildSipUri_RX(p_ConferenceFactoryUri);
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) SDP_Message v_InitialSdpAnswer;
    var template (present) SDP_Message v_UpdatedSdpOffer;

    // Step 1:                  Receive INVITE
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_Video_Step2(SetupVideoCall, v_ConferenceFactoryUri, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, tsc_IMS_SDP_VideoCodecList_H265_H264, EVS_A2);

    // step 2 - 7
    v_InitialSdpAnswer := f_IMS_BuildSDP_InitialAnswerAudioVideo_TX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer, EVS_16000, H265_90000, EVS_A2);   /* @sic R5s220820: EVS_16000, H265_90000 sic@  @sic R5-231490: EVS_AnyNG114 sic@ @sic R5-232761: EVS_AnyNG114 removed sic@ */
    v_UpdatedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudioVideo_RX(SetupVideoCall, v_InviteRequestWithSdp.SdpOffer, EVS_16000, H265_90000);
    f_IMS_MOCallSetup_NR5GC_WithPreconditions_Step2_7(IPCAN_MO_VideoCall, v_InviteRequestWithSdp, p_TemporaryConferenceUri, v_AdditionalContactParams, v_InitialSdpAnswer, v_UpdatedSdpOffer, CONFERENCE_CALL, p_RadioBearersEstablished);  // @sic R5s220849: v_EarlyQosConfirmation removed sic@

    // Step 8 - 9:              Send 200 OK, seceive ACK
    f_IMS_Conferencing_Send200OK_ReceiveACK(v_InviteRequestWithSdp, p_FinalConferenceUri, v_AdditionalContactParams);
 
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      Calls the procedure for 34.229-5 A.19 Steps 1 to 9 for option Speech or Video Call
   * @param     p_TestProcedure
   * @param     p_ConferenceFactoryUri
   * @param     p_TemporaryConferenceUri
   * @param     p_FinalConferenceUri
   * @param     p_RadioBearersEstablished (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_ConferenceCreation_NR5GC_Steps1_9(IMS_TestProcedure_Type p_TestProcedure,
                                                   charstring p_ConferenceFactoryUri,
                                                   charstring p_TemporaryConferenceUri,
                                                   charstring p_FinalConferenceUri,
                                                   boolean p_RadioBearersEstablished := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    select (p_TestProcedure) {
      case (IPCAN_MO_SpeechCall) { v_InviteRequestWithSdp := f_IMS_ConferenceCreation_NR5GC_A_19_Steps1_9(p_ConferenceFactoryUri, p_TemporaryConferenceUri, p_FinalConferenceUri, p_RadioBearersEstablished); }
      case (IPCAN_MO_VideoCall)  { v_InviteRequestWithSdp := f_IMS_ConferenceCreation_NR5GC_A_25_Steps1_9(p_ConferenceFactoryUri, p_TemporaryConferenceUri, p_FinalConferenceUri, p_RadioBearersEstablished); }
    }
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.31.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_31_NR5GC_IMS1() runs on IMS_PTC
  { // Creating and leaving a conference / 5GS
    // sister test case of 15.17
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (omit) SUBSCRIBE_Request v_SubscribeRequest;
    var charstring v_ConferenceFactoryUri;
    var charstring v_TemporaryConferenceUri;
    var charstring v_FinalConferenceUri;
  
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);
    
    v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);
    v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);
    v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, v_ConferenceFactoryUri, conferenceCall);
    
    // @siclog "Step 2 - 10" siclog@
    v_InviteRequestWithSdp := f_IMS_ConferenceCreation_NR5GC_A_19_Steps1_9(v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 11 - 14" siclog@
    v_SubscribeRequest := f_IMS_Conferencing_OptionalSubscription(v_FinalConferenceUri);

    // @siclog "Step 15 - 16" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, f_SIP_BuildSipUri_RX(v_FinalConferenceUri), CONFERENCE_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");
        
    // @siclog "Step 17 - 18" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      Test body for TS 34.229-1 clause 8.32.NR5GC and 8.33.NR5GC
   * @param     p_TestProcedure
   * @status    APPROVED (IMS)
   */
  function fl_IMS_InvitingUserToConference_NR5GC_TestBody(IMS_TestProcedure_Type p_TestProcedure) runs on IMS_PTC
  {
    var charstring v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);
    var charstring v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);
    var charstring v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);
    var CharStringList_Type v_MediaTypeList := f_IMS_ConferenceEventPackage_MediaTypeList(p_TestProcedure);
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (omit) SUBSCRIBE_Request v_SubscribeRequest;

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_IMS_CC_StartCall(p_TestProcedure, v_ConferenceFactoryUri, conferenceCall);
    
    // @siclog "Step 2 - 10" siclog@
    v_InviteRequestWithSdp := f_IMS_ConferenceCreation_NR5GC_Steps1_9(p_TestProcedure, v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    // @siclog "Step 11 - 14" siclog@
    v_SubscribeRequest := f_IMS_Conferencing_OptionalSubscription(v_FinalConferenceUri);

    // @siclog "Step 14 - 22" siclog@
    f_IMS_InviteUserToConference(v_FinalConferenceUri, v_SubscribeRequest, v_MediaTypeList);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15, 18, 20, 22");

    // @siclog "Step 23 - 25" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, f_SIP_BuildSipUri_RX(v_FinalConferenceUri), CONFERENCE_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 24");

    // @siclog "Step 26 - 27" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);


    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.32.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_32_NR5GC_IMS1() runs on IMS_PTC
  { // Inviting user to conference by sending a REFER request to the conference focus / 5GS
    // sister test case of 15.19

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    fl_IMS_InvitingUserToConference_NR5GC_TestBody(IPCAN_MO_SpeechCall);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.33.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_33_NR5GC_IMS1() runs on IMS_PTC
  { // Inviting user to conference by sending a REFER request to the conference focus / Video / 5GS
    // sister test case of 15.19a

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);
    
    fl_IMS_InvitingUserToConference_NR5GC_TestBody(IPCAN_MO_VideoCall);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      Session Info Dialog contents for the UE to create the session
   * @param     p_TestProcedure
   * @param     p_CalleeUri
   * @param     p_CalleeContactUri
   * @param     p_RadioBearersEstablished
   * @return    ThreeWaySession_SessionInfo_Type
   * @status    APPROVED (IMS)
   */
  function fl_IMS_ThreeWaySession_MOCallSetup_NR5GC(IMS_TestProcedure_Type p_TestProcedure,
                                                    charstring p_CalleeUri,
                                                    charstring p_CalleeContactUri,
                                                    boolean p_RadioBearersEstablished) runs on IMS_PTC return ThreeWaySession_SessionInfo_Type
  {
    var IMS_CC_MO_CallInfo_Type v_CallInfo;
    var ThreeWaySession_SessionInfo_Type v_SessionInfo;

    select (p_TestProcedure) {
      case (IPCAN_MO_SpeechCall) { v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_4_1a(p_CalleeUri, p_CalleeContactUri, p_RadioBearersEstablished); }                  // @sic R5-233372: A_4_1a sic@
      case (IPCAN_MO_VideoCall)  { v_CallInfo := f_IMS_MOCallSetup_NR5GC_A_15_1a(p_CalleeUri, p_CalleeContactUri, p_RadioBearersEstablished); }                 // @sic R5-233372: A_15_1a sic@
    }
    v_SessionInfo.InviteRequestWithSdp := v_CallInfo.InviteRequestWithSdp;
    v_SessionInfo.MessageHeader_PrevResponse := v_CallInfo.MessageHeader183;
    v_SessionInfo.LatestSdpOffer := v_CallInfo.LatestSdpOffer;
    v_SessionInfo.ContactUrl := f_MessageHeader_GetContactSipUrl(v_SessionInfo.MessageHeader_PrevResponse);

    return v_SessionInfo;
  }

  /*
   * @desc      Three way session creation for MO Call setup stablishment
   * @param     p_TestProcedure
   * @status    APPROVED (IMS)
   */
  function f_IMS_ThreeWaySession_NR5GC_Testbody(IMS_TestProcedure_Type p_TestProcedure) runs on IMS_PTC
  {
    var charstring v_ConferenceFactoryUri   := f_IMS_BuildConferenceUri(conferenceFactoryUri);
    var charstring v_TemporaryConferenceUri := f_IMS_BuildConferenceUri(temporaryConferenceUri);
    var charstring v_FinalConferenceUri     := f_IMS_BuildConferenceUri(finalConferenceUri);
    var CharStringList_Type v_MediaTypeList := f_IMS_ConferenceEventPackage_MediaTypeList(p_TestProcedure);

    var InviteUserToConference_StateInfo_Type v_Dialog1_StateInfo := valueof(cs_InviteUserToConference_StateInfo_Init(px_IMS_CalleeUri,  px_IMS_CalleeContactUri));
    var InviteUserToConference_StateInfo_Type v_Dialog2_StateInfo := valueof(cs_InviteUserToConference_StateInfo_Init(px_IMS_CalleeUri2, px_IMS_CalleeContactUri2));     // @sic R5s220523: px_IMS_CalleeContactUri2 instead of px_IMS_CalleeContactUri sic@

    var boolean v_RadioBearersEstablished := false;

    var template (omit) SUBSCRIBE_Request v_SubscribeRequest;      // optional SUBSCRIBE for conference event package

    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog1;
    var ThreeWaySession_SessionInfo_Type v_SessionInfo_Dialog2;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp_Dialog3;
    var SipUrl v_ContactUrl_UE;

    //--------------------------------------------
    // DIALOG 1
    //--------------------------------------------
    // Setup MO speech call
    f_IMS_CC_StartCall(p_TestProcedure, v_Dialog1_StateInfo.CalleeUri);
    
    v_SessionInfo_Dialog1 := fl_IMS_ThreeWaySession_MOCallSetup_NR5GC(p_TestProcedure, v_Dialog1_StateInfo.CalleeUri, v_Dialog1_StateInfo.CalleeContactUri, v_RadioBearersEstablished);
    v_RadioBearersEstablished := true;
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 4" siclog@
    f_UT_CallHold(MMI);
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog1.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog1.MessageHeader_PrevResponse, v_SessionInfo_Dialog1.LatestSdpOffer, v_Dialog1_StateInfo.CalleeContactUri);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "steps 1 - 4");

    //--------------------------------------------
    // DIALOG 2
    //--------------------------------------------
    
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");      // @sic R5-220224/R5-220225 sic@

    // @siclog "Step 5" siclog@
    select (p_TestProcedure) {
      case (IPCAN_MO_SpeechCall) {
        f_UT_RequestIMSCall(MMI, v_Dialog2_StateInfo.CalleeUri);
        v_MediaTypeList := tsc_MediaTypeList_Audio;
      }
      case (IPCAN_MO_VideoCall) {
        f_UT_RequestIMSVideoCall(MMI, v_Dialog2_StateInfo.CalleeUri);
        v_MediaTypeList := tsc_MediaTypeList_AudioVideo;
      }
    }

    // @siclog "Step 6 - 17" siclog@
    v_SessionInfo_Dialog2 := fl_IMS_ThreeWaySession_MOCallSetup_NR5GC(p_TestProcedure, v_Dialog2_StateInfo.CalleeUri, v_Dialog2_StateInfo.CalleeContactUri, v_RadioBearersEstablished);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "steps 6 - 17");
    
    // @siclog "Step 18" siclog@
    f_UT_CallMPTY(MMI);

    // @siclog "Step 19 - 22" siclog@
    f_IMS_MOCallHoldResume(HOLD, v_SessionInfo_Dialog2.InviteRequestWithSdp.Invite, v_SessionInfo_Dialog2.MessageHeader_PrevResponse, v_SessionInfo_Dialog2.LatestSdpOffer, v_Dialog2_StateInfo.CalleeContactUri);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "steps 19 - 22");
    
    //--------------------------------------------
    // DIALOG 3
    //--------------------------------------------
    
    f_IMS_PTC_ImsInfo_ActivateDialog(thirdDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111113");      // @sic R5-222106, R5-223462 sic@
    
    // @siclog "Step 23 - 32" siclog@  A.19 Steps 1 - 9
    v_InviteRequestWithSdp_Dialog3 := f_IMS_ConferenceCreation_NR5GC_Steps1_9(p_TestProcedure, v_ConferenceFactoryUri, v_TemporaryConferenceUri, v_FinalConferenceUri, v_RadioBearersEstablished);
    v_ContactUrl_UE := f_MessageHeader_GetContactSipUrl(v_InviteRequestWithSdp_Dialog3.Invite.msgHeader);
    
    //--------------------------------------------
    // Subscribe to conference event package (A.19 steps 10 - 13), invite user A/B (A.20), terminate dialog 1/2
    //--------------------------------------------
    
    // @siclog "Step 33 - 55" siclog@
    v_SubscribeRequest := f_IMS_ThreeWaySession_SubscribeInvite(v_SessionInfo_Dialog1, v_SessionInfo_Dialog2, v_Dialog1_StateInfo, v_Dialog2_StateInfo, v_FinalConferenceUri, v_MediaTypeList);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "steps 33 - 55");

    //--------------------------------------------
    // Release session
    //--------------------------------------------
    
    // @siclog "Step 56 - 57" siclog@   Terminate conference
    f_IMS_CallReleaseMT(v_ContactUrl_UE);

    //--------------------------------------------
    // Unsubscribe
    //--------------------------------------------
    
    // @siclog "Step 58 - 59" siclog@
    f_IMS_ConferenceEventPackage_Unsubscribe(v_SubscribeRequest, v_FinalConferenceUri);

    f_IMS_TestBody_Set(false);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.34.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_34_NR5GC_IMS1() runs on IMS_PTC
  { // Three way session creation / Voice / 5GS
    // sister test case of 15.21a

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_ThreeWaySession_NR5GC_Testbody(IPCAN_MO_SpeechCall);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.35.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_35_NR5GC_IMS1() runs on IMS_PTC
  { // Three way session creation / Video / 5GS
    // sister test case of 15.21c

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED);

    f_IMS_ThreeWaySession_NR5GC_Testbody(IPCAN_MO_VideoCall);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.36.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_36_NR5GC_IMS1() runs on IMS_PTC
  { // MO Voice Call Explicit Communication Transfer / Consultative Call Transfer / 5GS
    /* sister test case of 15.25:
       Explicit Communication Transfer according to 24.629 with consultative transfer (24.629 annex A.2):
       The UE is the transferror (UE-B in figure A.2), the SS emulates the transferee (UE-A) and the Transfer-Target (UE-C);
       in the test case there are two dialogs only as the UE (UE-B) is not involved in dialog 3 of figure A.2 */
    var IMS_CC_MO_CallInfo_Type v_CallInfo_Dialog1;
    var IMS_CC_MO_CallInfo_Type v_CallInfo_Dialog2;
    var charstring v_CalleeUri_Dialog1 := px_IMS_CalleeUri;
    var charstring v_CalleeUri_Dialog2 := px_IMS_CalleeUri2;
    var charstring v_CalleeContactUri_Dialog1 := px_IMS_CalleeContactUri;
    var charstring v_CalleeContactUri_Dialog2 := px_IMS_CalleeContactUri2;
    var template (value) SDP_Message v_SDP_LatestMessageBySS;
    var template (value) SipUrl v_ContactSipUrlSS_Dialog1;
    var SipUrl v_ContactSipUrlUE;
    var REFER_Request v_REFER_Request;
    var integer v_CSeqREFER;
    var boolean v_RadioBearersEstablished;
    var boolean v_DontIncrementSessVers;

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);

    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall, v_CalleeUri_Dialog1);
    
    v_CallInfo_Dialog1 := f_IMS_MOCallSetup_NR5GC_A_4_1a(v_CalleeUri_Dialog1, v_CalleeContactUri_Dialog1); /* Call between the UE (transferror, UE-B) and the emulated transferee (UE-A)
                                                                                                              @sic R5-233372: A_4_1a sic@ */
    v_DontIncrementSessVers := true;  // @sic R5s211703: session version shall not be incremented sic@
    v_SDP_LatestMessageBySS := f_IMS_BuildSDP_UpdatedAnswer_TX(v_CallInfo_Dialog1.LatestSdpOffer, v_DontIncrementSessVers);
    v_ContactSipUrlSS_Dialog1 := f_MessageHeader_GetContactSipUrl(v_CallInfo_Dialog1.MessageHeader183);    /* NOTE: Dialog 2 should have only one transferee's Contact (even though in f_TC_15_25_IMS1 there is v_SessionInfo_Dialog1.ContactUrl and v_ContactUrl_1) */
    v_ContactSipUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);

    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@   Initiate Explicit Communication Transfer (ECT) - 3GPP TS 24.629
    f_UT_CallHold(MMI);        // @sic R5-227599 sic@
    
    // @siclog "Step 2 - 5" siclog@
    f_IMS_MOCallHoldResume(HOLD, v_CallInfo_Dialog1.InviteRequestWithSdp.Invite, v_CallInfo_Dialog1.MessageHeader183, v_CallInfo_Dialog1.LatestSdpOffer, v_CalleeContactUri_Dialog1);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
 
    // @siclog "Step 6" Void siclog@

    // @siclog "Step 6A" Void siclog@
    f_UT_RequestIMSCall(MMI, v_CalleeUri_Dialog2);        // @sic R5-231509 sic@

    // @siclog "Step 7 - 18" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");      // @sic R5-221479 sic@
    v_RadioBearersEstablished := true;                    // @sic R5s211703 sic@
    v_CallInfo_Dialog2 := f_IMS_MOCallSetup_NR5GC_A_4_1a(v_CalleeUri_Dialog2, v_CalleeContactUri_Dialog2, v_RadioBearersEstablished);   /* Call between the UE (transferror, UE-B) and the emulated Transfer-Target (UE-C)
                                                                                                                                           @sic R5-233372: A_4_1a sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    // @siclog "Step 19" Void siclog@

    // Step 19A
    f_UT_ExplicitCallTransfer(MMI);        // @sic R5-227599 sic@

    // @siclog "Step 20 - 23" siclog@
    f_IMS_MOCallHoldResume(HOLD, v_CallInfo_Dialog2.InviteRequestWithSdp.Invite, v_CallInfo_Dialog2.MessageHeader183, v_CallInfo_Dialog2.LatestSdpOffer, v_CalleeContactUri_Dialog2);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");
    
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);

    // @siclog "Step 24 - 25" siclog@
    v_REFER_Request := f_IMS_CallTransfer_Refer(v_CalleeContactUri_Dialog1, v_CalleeUri_Dialog2, secondDialog);
    v_CSeqREFER := v_REFER_Request.msgHeader.cSeq.seqNumber;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 24");

    // @siclog "Step 26 - 27" siclog@
    f_IMS_CallTransfer_Notify_Active(v_ContactSipUrlSS_Dialog1, v_ContactSipUrlUE, v_CSeqREFER);                                        /* @sic R5-230997 change 2: v_CSeqREFER sic@ */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 27");

    // @siclog "Step 28 - 31" siclog@
    f_IMS_MTCallHoldResume(HOLDINACTIVE, v_ContactSipUrlUE, v_SDP_LatestMessageBySS, v_ContactSipUrlSS_Dialog1);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 30");

    // @siclog "Step 32 - 33" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_CallReleaseMT(v_ContactSipUrlUE);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 33");

    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);

    // @siclog "Step 34 - 35" siclog@
    f_IMS_CallTransfer_Notify_200OK_Terminated(v_ContactSipUrlSS_Dialog1, v_ContactSipUrlUE, v_CSeqREFER);                              /* @sic R5-230997 change 2: v_CSeqREFER sic@ */

    // @siclog "Step 36 - 37" siclog@
    f_IMS_OptionalCallReleaseMO(v_CallInfo_Dialog1.InviteRequestWithSdp.Invite, v_ContactSipUrlSS_Dialog1);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 37");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.37.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_37_NR5GC_IMS1() runs on IMS_PTC
  { // Communication Waiting and answering the voice call / 5Gs
    // sister test case of 15.27
    var IMS_CC_MO_CallInfo_Type v_CallInfo_Dialog1;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp_Dialog2;
    var MessageHeader v_MessageHeader180;
    var template (present) MessageHeader v_MessageHeader_ExpectedBye_Dialog1;
    var template (present) SipUrl v_ContactUrl_Dialog1;
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    v_CallInfo_Dialog1 := f_IMS_MOCallSetup_NR5GC_A_4_1a();                                             /* @sic R5-232767: A_4_1a sic@ */
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 7" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");                                                    /* @sic R5-220227 sic@ */
    v_InviteRequestWithSdp_Dialog2 := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_7(secondDialog);             /* @sic R5-232767: A_5_1a sic@ */
    
    // @siclog "Step 8 - 10" siclog@
    v_MessageHeader180 := f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp_Dialog2, tsc_OptionTagList_100rel);    /* @sic R5-242755: tsc_OptionTagList_100rel sic@ */
    f_IMS_CommunicationWaiting_Check180Ringing(v_MessageHeader180);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    // @siclog "Step 11" siclog@
    f_UT_HangupIMSCall(MMI);
    
    // @siclog "Step 12 - 13" siclog@
    v_ContactUrl_Dialog1 := f_SIP_BuildSipUri_RX(px_IMS_CalleeContactUri);
    v_MessageHeader_ExpectedBye_Dialog1 := f_IMS_ByeRequest_MessageHeaderRX(v_CallInfo_Dialog1.InviteRequestWithSdp.Invite, -, firstDialog);   // @sic R5s211570: firstDialog sic@
    a_IMS_ReceiveByeSendOK(firstDialog, v_ContactUrl_Dialog1, v_MessageHeader_ExpectedBye_Dialog1);
    
    // @siclog "Step 14 - 16" siclog@
    f_IMS_MTCallSetup_AcceptAndAcknowledge(v_InviteRequestWithSdp_Dialog2);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15");
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_PostambleWithCallReleaseMT(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 8.38.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_38_NR5GC_IMS1() runs on IMS_PTC
  { // Communication Waiting and cancelling the voice call / 5GS
    // sister test case of 15.28
    var IMS_CC_MO_CallInfo_Type v_CallInfo_Dialog1;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp_Dialog2;
    var MessageHeader v_MessageHeader180;
    
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    v_CallInfo_Dialog1 := f_IMS_MOCallSetup_NR5GC_A_4_1a();                                     /* @sic R5-232768: A_4_1a sic@ */
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1 - 7" siclog@
    f_IMS_PTC_ImsInfo_ActivateDialog(secondDialog);
    f_IMS_PTC_ImsInfo_DialogSetSessIdTX("11111112");                                            /* @sic R5-221476 sic@ */
    v_InviteRequestWithSdp_Dialog2 := f_IMS_MTCallSetup_NR5GC_A_5_1a_Step1_7(secondDialog);     /* @sic R5-232768: A_5_1a sic@ */
    
    // @siclog "Step 8 - 10" siclog@
    v_MessageHeader180 := f_IMS_MTCallSetup_Receive180Ringing(v_InviteRequestWithSdp_Dialog2, tsc_OptionTagList_100rel);    /* @sic R5-242756: tsc_OptionTagList_100rel sic@ */
    f_IMS_CommunicationWaiting_Check180Ringing(v_MessageHeader180);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    // @siclog "Step 11 - 14" siclog@
    f_IMS_MTCallSetup_CancelCall(v_InviteRequestWithSdp_Dialog2.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    
    f_IMS_PTC_ImsInfo_DialogRelease();
    f_IMS_PTC_ImsInfo_ActivateDialog(firstDialog);
    
    // @siclog "Step 15 - 17" siclog@
    f_IMS_CallReleaseMO(v_CallInfo_Dialog1.InviteRequestWithSdp.Invite);
    
    f_IMS_TestBody_Set(false);
    
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.40.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_40_NR5GC_IMS1() runs on IMS_PTC
  { // User initiated USSI / 5GS
    // sister test case of 15.30
    var charstring v_UssdString := "*#60#";                                         // same command as for UTRAN test case 15.9.1
    
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED);
    
    f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_UT_SupplementaryService_SendUSSD(MMI, v_UssdString);

    // @siclog "Step 2 - 5" siclog@
    f_IMS_USSD_MOCallSetup(v_UssdString);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2, 5");

    // @siclog "Step 6 - 7" siclog@
    f_IMS_USSD_MTCallRelease();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 7");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.41.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_41_NR5GC_IMS1() runs on IMS_PTC
  { // Communication Forwarding on No Reply: MO Voice Call initiation with preconditions
    // sister test case of 15.8
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var template (value) SDP_Message v_SdpMessage183;
    var template (value) MessageHeader v_MessageHeader183;
    var template (value) MessageHeader v_MessageHeader180;
    var template (present) SDP_Message v_UpdatedSdpOffer;
    var template (value) SipUrl v_TargetedTo := f_SIP_BuildSipUri_TX("sip:user@company.com");
    var template (value) HistoryInfo v_HistoryInfo := cs_HistoryInfo(v_TargetedTo);

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 7" siclog@
    f_IMS_CC_StartCall(IPCAN_MO_SpeechCall);
    
    // @siclog "Step 8 - 17" siclog@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1_5();         // @sic R5-225937: A_4_1 -> A_4_1a sic@
    f_IMS_CC_TriggerDedicatedBearerActivation(IPCAN_MO_SpeechCall);             // to trigger step 13 of 38.508-1 Table 4.9.15.2.2-1
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);             // @sic R5-225937: A_4_1 -> A_4_1a sic@
    f_IMS_MOCallSetup_Send180_Reliable(v_InviteRequestWithSdp);

    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_InviteRequestWithSdp.RoutingInfo);

    // @siclog "Step 18" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine181, f_IMS_InviteResponse_181_MessageHeaderTX(v_InviteRequestWithSdp.Invite, v_TargetedTo))));

    // @siclog "Step 19" siclog@
    f_IMS_MO_ComunicationForwarding_ModifyDialog(v_InviteRequestWithSdp.Invite.msgHeader.cSeq.seqNumber, "1111111112", 1111111111);    // @sic R5-220229: "1111111112", 1111111111 sic@
    v_MessageHeader183 := f_IMS_InviteResponse_183_MessageHeaderTX(v_InviteRequestWithSdp.Invite, px_IMS_CalleeContactUri2);
    v_SdpMessage183 := f_IMS_BuildSDP_InitialAnswerAudio_TX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2, 65);                // @sic R5-225937: EVS_A2 sic@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine183, v_MessageHeader183, cs_MessageBody_SDP(v_SdpMessage183))));

    // @siclog "Step 20 - 21" siclog@
    v_UpdatedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(v_InviteRequestWithSdp.SdpOffer, -, EVS_16000, EVS_A2);                   // @sic R5-225937: EVS_A2 sic@
    f_IMS_MOCallSetup_ReceivePRACK_Send200OK(v_InviteRequestWithSdp, v_MessageHeader183, cr_ContentTypeSDP, v_UpdatedSdpOffer);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    // @siclog "Step 22 - 24" siclog@
    v_MessageHeader180 := f_IMS_InviteResponse_180_MessageHeaderTX(v_InviteRequestWithSdp.Invite, px_IMS_CalleeContactUri2, -, tsc_OptionTagList_100rel);
    v_MessageHeader180.historyInfo := v_HistoryInfo;
    f_IMS_MOCallSetup_Send18X_Reliable(v_InviteRequestWithSdp, c_statusLine180, v_MessageHeader180);
 
    // @siclog "Step 25 - 26" siclog@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(v_InviteRequestWithSdp, px_IMS_CalleeContactUri2, -, v_HistoryInfo);

    // @siclog "Step 27 - 29" siclog@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite, f_SIP_BuildSipUri_RX(px_IMS_CalleeContactUri2));

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

}
