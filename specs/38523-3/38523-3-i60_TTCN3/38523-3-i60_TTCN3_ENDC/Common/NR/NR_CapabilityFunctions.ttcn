      if (not (f_NR_AnyOfThree_SignaledbyUE(v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithoutSSB, v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithoutSSB, v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithoutSSB)))  //@sic R5s240547 sic@
      {// inconclusive case: UE does not report any IE for csi_RSRP_AndRSRQ_MeasWithoutSSB but pc_csi_RSRP_AndRSRQ_MeasWithoutSSB is set
         f_SetVerdict(inconc, __FILE__, __LINE__, "setting of pc_csi_RSRP_AndRSRQ_MeasWithoutSSB to true is inconsistent with reported capabilities");
      }

      if ((not f_NR_FreqRangeFr1AndFR2()) and ((not v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithoutSSB) or v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithoutSSB or v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithoutSSB)) { // fail cases on Single frequency range
         f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent with pc_csi_RSRP_AndRSRQ_MeasWithoutSSB on Single frequency range");
      }
      else if(f_NR_FreqRangeFr1AndFR2()) //FR1&FR2 case
      {
          if (not v_MeasAndMobParamFRX_Diff_csi_RSRP_AndRSRQ_MeasWithoutSSB)
          {
             if (v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithoutSSB and v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithoutSSB) // fail case: both FR1 and FR2 capabilities are reported and no IE in measAndMobParameters.measAndMobParametersFRX_Diff
             {
                f_SetVerdict(fail, __FILE__, __LINE__, "reporting of FR1/FR2_Add_UE_NR_Capabilities IEs are inconsistent");
             }
          }
          else
          if  (v_FR1_Add_csi_RSRP_AndRSRQ_MeasWithoutSSB or v_FR2_Add_Cap_csi_RSRP_AndRSRQ_MeasWithoutSSB)  // fail cases: if IE in measAndMobParameters.measAndMobParametersFRX_Diff is reported but FR1 and/or FR2 capabilities are also reported
          {
             f_SetVerdict(fail, __FILE__, __LINE__, "Reported IEs are inconsistent");
          }
      }
    }
    else {  // Error cases if the feature is NOT set: neither the Common IE nor any of FR1/FR2 IEs are reported by the UE
          if (ispresent(v_MeasAndMobParamFRX_csi_RSRP_AndRSRQ_MeasWithoutSSB_Common.csi_RSRP_AndRSRQ_MeasWithoutSSB) or
              ispresent(v_FR1_Add_UE_NR_Cap_csi_RSRP_AndRSRQ_MeasWithoutSSB.csi_RSRP_AndRSRQ_MeasWithoutSSB) or
