module MCX_IPCAN_ASP_TypeDefs {
  import from CommonDefs all;
  import from MCX_CommonIPCAN all;

  type integer MCX_IPCAN_AbsoluteCellPower_Type (-150..0);      /* absolute cell power (dBm); same as AbsoluteCellPower_Type */

  type record of MCX_IPCAN_EpsBearerId_Type MCX_IPCAN_EpsBearerIdList_Type;

  type enumerated MCX_IPCAN_PacketFilterDirection_Type {        /* packet filter direction according to 24.008 Table 10.5.162 */
    downlinkOnly,
    uplinkOnly,
    bidirectional
  };

  type record MCX_IPCAN_PacketFilterComponentPortRange_Type {
    integer     Low,
    integer     High
  };
  
  type union MCX_IPCAN_PacketFilterComponent_Type {             /* 24.008 Table 10.5.162 */
    integer     Protocol,                                       /* Protocol identifier/Next header type: 17 for UDP */
    integer     SingleRemotePort,
    MCX_IPCAN_PacketFilterComponentPortRange_Type RemotePortRange
  };

  type record of MCX_IPCAN_PacketFilterComponent_Type MCX_IPCAN_PacketFilterComponentList_Type;
  
  type record MCX_IPCAN_PacketFilter_Type {
    MCX_IPCAN_PacketFilterDirection_Type        Direction,
    MCX_IPCAN_PacketFilterComponentList_Type    ComponentList
  };

  type record of MCX_IPCAN_PacketFilter_Type MCX_IPCAN_PacketFilterList_Type;

  type record MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type {
    MCX_IPCAN_EpsBearerId_Type          EpsBearerId,            /* EPS bearer id of the dedicated EPS bearer */
    MCX_IPCAN_PacketFilterList_Type     PacketFilterList
  };

  type record MCX_IPCAN_IPv4IPv6Address_Type {
    charstring  IPv4,
    charstring  IPv6
  };

  type record MCX_IPCAN_PDN_Info_Type {
    MCX_Registration_PDN_Type           PdnType,                /* MCX, IMS or INTERNET */
    MCX_IPCAN_EpsBearerId_Type          EpsBearerId,            /* EPS bearer id of the PDN's default EPS bearer */
    MCX_IPCAN_IPv4IPv6Address_Type      IPAddressNW optional,   /* not present for MCX PDN as the IP signalling is handled by TTCN */
    MCX_IPCAN_IPv4IPv6Address_Type      IPAddressUE optional    /* not present for MCX PDN as the IP signalling is handled by TTCN */
  };
  type record length (1..3) of MCX_IPCAN_PDN_Info_Type MCX_IPCAN_PDN_InfoList_Type;             /* list of PDNs to be connected to during Idle Update procedure */

  type record MCX_IPCAN_ASP_CommonReqPart_Type {
    EUTRA_CellId_Type           CellId,
    boolean                     CnfFlag
  };

  //----------------------------------------------------------------------------
  // System primitives:

  type record MCX_IPCAN_Init_Type {};                           /* Initialisation of the system simulator.
                                                                   CellId : eutra_Cell_NonSpecific
                                                                   Reference implementation: f_EUTRA_Init with p_SysinfoCombination:=c1, p_HandleULDataUM:=HANDLE_UM_DATA, p_UseBigGrants:=USE_BIG_GRAN*/

  type record MCX_IPCAN_CellConfig_Type {};                     /* Create a cell and send out system information.
                                                                   CellId : cell id of the cell to be created
                                                                   Reference implementation: f_EUTRA_CellConfig_Def */

  type record MCX_IPCAN_CellPower_Type {                        /* Set the cell power of a cell.
                                                                   CellId : cell id of the cell
                                                                   Reference implementation: f_EUTRA_SetCellPower */
     MCX_IPCAN_AbsoluteCellPower_Type   AbsoluteCellPower
  };

  type record MCX_IPCAN_InitialRegistration_Type {              /* Perform initial registration procedure according to 36.579-1 clause 5.4.1A and Table 5.4.2.2.3-1 steps 2 - 16A to bring the UE into state 3 according to Figure 4.5.1-1 in 36.508.
                                                                   As described in clause 5.4.1A of 36.579-1 after switch on the UE may register to an internet PDN, an IMS PDN and the MCX PDN.
                                                                   NOTE: The UE does not need to register to MCX during initial registration after switch-on.
                                                                   CellId : cell id of the cell */
    MCX_IPCAN_PDN_InfoList_Type         PdnList,                /* list of PDNs the UE is expected to connect to during Idle Update procedure; the list may or may not contain MCX */
    octetstring                         DefaultAPN              /* APN to be used for the PDN (if any) for which the UE does not provide an APN; APN encoded according to 23.003 clause 9.1 and RFC 1035 clause 4.1.2 */
  };

  type record MCX_IPCAN_AdditionalRegistrationMCX_Type {        /* Procedure used, if the UE is configured not to connect automatically to the MCX PDN after switch-on:
                                                                   In this case after initial registration the UE gets triggered from TTCN by an MMI command to start MCX registration and this procedure is started to perform steps 19 - 26 of 36.579-1 Table 5.4.2.2.3-1.
                                                                   CellId : cell id of the cell */
    MCX_IPCAN_EpsBearerId_Type          EpsBearerId
  };

  type record MCX_IPCAN_RRCConnectionSetupMO_Type {             /* MO RRC connection establishment according to 36.579-1 table 5.4.3.2.3-1
                                                                   CellId : cell id of the cell
                                                                   Reference implementation: f_MCX_EUTRA_IPCAN_RRCConnectionEstablishment_MO */
    MCX_IPCAN_EpsBearerIdList_Type      DedicatedEpsBearers     /* In case of a pre-established session: list of dedicated EPS bearers for which the DRBs need to be established; otherwise {} */
  };

  type record MCX_IPCAN_RRCConnectionSetupMT_Type {             /* MT RRC connection establishment according to 36.579-1 table 5.4.4.2.3-1
                                                                   CellId : cell id of the cell
                                                                   Reference implementation: f_MCX_EUTRA_IPCAN_RRCConnectionEstablishment_MT */
    MCX_IPCAN_EpsBearerIdList_Type      DedicatedEpsBearers     /* In case of a pre-established session: list of dedicated EPS bearers for which the DRBs need to be established; otherwise {} */
  };

  type record of MCX_IPCAN_ASP_DedicatedEpsBearerInfo_Type MCX_IPCAN_ActivateDedicatedEpsBearerMCX_Type;        /* Establish dedicated EPS bearer(s) for the MCX PDN
                                                                                                                   CellId : cell id of the cell
                                                                                                                   Reference implementation: f_MCX_EUTRA_IPCAN_ActivateDedicatedEpsBearer */
  type MCX_IPCAN_EpsBearerIdList_Type MCX_IPCAN_DeactivateDedicatedEpsBearerMCX_Type;                           /* Deactivate dedicated EPS bearer(s) for the MCX PDN
                                                                                                                   CellId : cell id of the cell
                                                                                                                   Reference implementation: f_EUTRA_DeactivateEPS_BearerContext */
  type record MCX_IPCAN_RRCConnectionRelease_Type {};           /* Relase RRC connection
                                                                   CellId : cell id of the cell
                                                                   Reference implementation: f_EUTRA_RRC_ConnectionRelease */

  type record MCX_IPCAN_Release_Type {};                        /* Release all configuration at the system simulator;
                                                                   CellId : eutra_Cell_NonSpecific */

  type union MCX_IPCAN_SystemRequest_Type {
    MCX_IPCAN_Init_Type                                 Init,
    MCX_IPCAN_CellConfig_Type                           CellConfig,
    MCX_IPCAN_CellPower_Type                            CellPower,
    MCX_IPCAN_InitialRegistration_Type                  InitialRegistration,
    MCX_IPCAN_AdditionalRegistrationMCX_Type            AdditionalRegistrationMCX,
    MCX_IPCAN_RRCConnectionSetupMO_Type                 RRCConnectionSetupMO,
    MCX_IPCAN_RRCConnectionSetupMT_Type                 RRCConnectionSetupMT,
    MCX_IPCAN_ActivateDedicatedEpsBearerMCX_Type        ActivateDedicatedEpsBearerMCX,
    MCX_IPCAN_DeactivateDedicatedEpsBearerMCX_Type      DeactivateDedicatedEpsBearerMCX,
    MCX_IPCAN_RRCConnectionRelease_Type                 RRCConnectionRelease,
    MCX_IPCAN_Release_Type                              Release
  };

  type record MCX_IPCAN_SYSTEM_CTRL_REQ {
    MCX_IPCAN_ASP_CommonReqPart_Type    Common,
    MCX_IPCAN_SystemRequest_Type        Request
  };

  type record MCX_IPCAN_InitConfirmation_Type {
    IPCAN_RAN_Type                      RanType
  };

  type union MCX_IPCAN_SystemConfirmation_Type {
    MCX_IPCAN_InitConfirmation_Type     Init,                   /* Confirmation for Init request: carries the RAN Type */
    Null_Type                           Other,                  /* Confirmation for any other request */
    charstring                          Error                   /* Error indication when the corresponding request causes error;
                                                                   the charstring may be used to provide information about the error */
  };

  type record MCX_IPCAN_SYSTEM_CTRL_CNF {
    MCX_IPCAN_SystemConfirmation_Type   Confirmation
  };

  type port MCX_IPCAN_SYSTEM_PORT message {
    out MCX_IPCAN_SYSTEM_CTRL_REQ;
    in  MCX_IPCAN_SYSTEM_CTRL_CNF;
  };


}
