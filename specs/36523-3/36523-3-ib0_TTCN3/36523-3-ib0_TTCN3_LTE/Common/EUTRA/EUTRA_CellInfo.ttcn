  /*
   * @desc      set cell info for given cell
   * @param     p_CellId
   * @param     p_CellInfo
   *            note: "template (value)" to allow a formal template being handed over;
   *                   this is to cope with parameters of set-functions being "template (omit)"
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_Set(EUTRA_CellId_Type p_CellId,
                                template (value) EUTRA_CellInfo_Type p_CellInfo) runs on EUTRA_PTC
  {
    var integer v_Index := f_EUTRA_CellInfo_GetIndex(p_CellId);
    vc_EUTRA_Global.CellArray[v_Index] := valueof(p_CellInfo);   /* valueof cannot be avoided here */
  }

  /*
   * @desc      Set the EARFCN parameters (DL and UL) in the EUTRA_CellInfo
   * @param     p_CellId
   * @param     p_CarrierFreqEUTRA
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetEARFCN(EUTRA_CellId_Type p_CellId,
