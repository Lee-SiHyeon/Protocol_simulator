    f_NR5GC_IRAT_PreambleNR_EUTRA (nr_Cell1); // EUTRA cell on (NR cell off) and UE completed registration on EUTRA

    f_NR_TestBody_Set(true);
    fl_TC_6_2_3_10and11_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
    // Tell EUTRA test is finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.2.3.11
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_6_2_3_11_NR5GC() runs on NR5GC_PTC
  { // Inter-RAT cell reselection / From E-UTRA_Idle to NR RRC_IDLE / schedulingInfoListExt-r12
    var boolean v_IsFR1; // @sic R5-225372 sic@

    f_NR5GC_IRAT_Init(NR_1);  // System information combination NR-1 defined in TS 38.508-1 clause 4.4.3.1.3 is used in NR Cell 1
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -80, -78);

    v_IsFR1 := f_NR_CellInfo_GetIsFR1(nr_Cell1);
    //NR Cell 1 is configured to operate in FR1 bands as defined in TS 38.508-1 clause 6.2.3.
    if (not v_IsFR1) {
        f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.2.3.11: NR Cell 1 shall operate in FR1 bands");
    }

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_IRAT_PreambleNR_EUTRA (nr_Cell1); // EUTRA cell on (NR cell off) and UE completed registration on EUTRA

    f_NR_TestBody_Set(true);
    fl_TC_6_2_3_10and11_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
    // Tell EUTRA test is finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_6_2_3_10and11
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_6_2_3_10and11_TestBody() runs on NR5GC_PTC
  {
    var float v_Timer;
    timer t_Tmax;

    //@siclog "Step 1" siclog@
    //The SS adjusts the E-UTRAN and NR Cell power levels according to row "T1" in the respective table
    f_NR_SetCellPower (nr_Cell1, -80, -78);

    //@siclog "Step 2" siclog@
    // Check: Does the test result of generic test procedure in TS 38.508-1 Table 4.9.9.2.2-1 indicate that the UE is camped on NR Cell 1 within 34s for FR1 ? (Note 1)
    v_Timer := 34.0;
    t_Tmax.start(f_NR_SetTimerToleranceMax(nr_Cell1, nonProtocolTimer, v_Timer)); // @sic R5s210353 sic@
    alt {
      [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any))))
        {
          t_Tmax.stop;
        }
      [] t_Tmax.timeout
      {
         f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Step 2");
      }
    }
    f_NR5GC_IRAT_S1ToN1_IdleMode(nr_Cell1);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

 }

}
