module UTRAN34_ASN1_ASP_Templates_r10 {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_RAB_Templates_r11 all;
  import from UTRAN_ASN1_ASP_RAB_Templates all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_ASN1_ASP_Templates_r11 all;
  import from UTRAN_CommonAspDefs all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_RRC_RAB_Templates all;
  import from UTRAN_RRC_RAB_Templates_r9 all;

  template (value) HS_PDSCHInfo_r10OrLaterExtensionType cs_DL_HS_DSCH_FDD_r10(template (omit) HSDSCH_physical_layer_category      p_HSDSCH_physical_layer_category,
                                                                              template (omit) HSDSCH_physical_layer_category_ext  p_HSDSCH_physical_layer_category_ext,
                                                                              template (omit) HSDSCH_physical_layer_category_ext2 p_HSDSCH_physical_layer_category_ext2,
                                                                              template (omit) HSDSCH_physical_layer_category_ext3 p_HSDSCH_physical_layer_category_ext3,
                                                                              template (omit) HSDSCH_physical_layer_category_ext4 p_HSDSCH_physical_layer_category_ext4,
                                                                              template (omit) HSDSCH_physical_layer_category_ext5 p_HSDSCH_physical_layer_category_ext5,
                                                                              template (value) DL_HSPDSCH_Information_r9          p_DL_HSPDSCH_Information_r9,
                                                                              template (omit) MIMO_Parameters_r9                  p_MIMO_Parameters_r9 := omit) :=
  { /* @status    APPROVED (UTRAN) */
    rel10_AspExt := {
      hSDSCHPhysicalLayerCategory := p_HSDSCH_physical_layer_category,
      hsdsch_physical_layer_category_ext:= p_HSDSCH_physical_layer_category_ext,      // when mach-ehs is not configured,
      hsdsch_physical_layer_category_ext2:= p_HSDSCH_physical_layer_category_ext2,    // when DC-HSDPA is configured
      hsdsch_physical_layer_category_ext3:= p_HSDSCH_physical_layer_category_ext3,    // when DC-HSDPA with MIMO is configured
      hsdsch_physical_layer_category_ext4 := p_HSDSCH_physical_layer_category_ext4,   // when 2 secondary cells are configured
      hsdsch_physical_layer_category_ext5 := p_HSDSCH_physical_layer_category_ext5,   // when 3 secondary cells are configured
      h_RNTI:= tsc_H_RNTI,
      dlHSPDSCHInformation := p_DL_HSPDSCH_Information_r9,
      sttd_Indicator := false,
      hs_SCCH_TxPower := tsc_DL_hs_SCCH_TxPower,
      ss_DTX_Info := omit,
      hs_scch_LessInfo := omit,
      mimo_Parameters := p_MIMO_Parameters_r9,
      hs_DPCCHToFollow := omit, // DEFAULT TRUE
      hs_SCCH_SttdIndicator := omit
    }
  };

  template (value) CphyTrchConfigReq cs_CphyTrchConfigReq_Common_FDD_r9(template (value) SS_ActivationTime           p_ActivationTime,
                                                                        template (omit) CphyUlConnectedTrCHList_Type p_UlconnectedTrCHList,
                                                                        template (omit) TFCS                         p_UlTfcs,
                                                                        template (omit) CphyDlConnectedTrCHList_Type p_DlconnectedTrCHList,
                                                                        template (omit) TFCS                         p_DlTfcs,
                                                                        template (omit) HS_DSCHMACdFlows             p_HsDSCHMacdFlows,
                                                                        template (omit) E_DCHMACdFlows               p_E_DCHMacdFlows,
                                                                        template (omit) EHS_DSCH_Flows_r9            p_Ehs_DSCH_Flows) :=
  /* @status    APPROVED (UTRAN) */
    cs_CphyTrchConfigReq_Common_FDD(p_ActivationTime, p_UlconnectedTrCHList, p_UlTfcs, p_DlconnectedTrCHList, p_DlTfcs, p_HsDSCHMacdFlows, p_E_DCHMacdFlows, omit, omit, p_Ehs_DSCH_Flows);

  template (value) TrCH_LogCHMappingList1 cs_TrLogMappingDL_MAC_eHS_DC ( MAC_ehs_QueueId p_QueueId := 0) :=
  { /* @status    APPROVED (UTRAN) */
    //@sic R5s140782 sic@
    ulconnectedTrCHList := omit,
    dlconnectedTrCHList := omit,
    dlconnectedMACdFlows := omit,
    dlconnectedMAC_ehsFlows := omit,
    dlconnectedMAC_ehsCommonFlows := omit,
    dlconnectedMAC_ehsFlowsDC := {
      {
        mac_ehs_QueueId := p_QueueId,
        trCH_LogCHMappingList := {
          cs_TrCH_LogicalChannelMapping_DL_RB25
        }
      }
    },
    relAspTypeExtension := omit
  };

  template (value) TrCH_LogCHMappingList1 cs_TrLogMappingDL_MAC_eHS(MAC_ehs_QueueId p_QueueId := 0) :=
  { /* @status    APPROVED (UTRAN) */
    ulconnectedTrCHList := omit,
    dlconnectedTrCHList := omit,
    dlconnectedMACdFlows := omit,
    dlconnectedMAC_ehsFlows := {
      {
        mac_ehs_QueueId := p_QueueId,
        trCH_LogCHMappingList := {
          cs_TrCH_LogicalChannelMapping_DL_RB25
        }
      }
    },
    dlconnectedMAC_ehsCommonFlows := omit,
    dlconnectedMAC_ehsFlowsDC := omit,
    relAspTypeExtension := omit
  };

  template (value) U_CMAC_CONFIG_REQ cas_CMAC_MAChs_TFRC_ExplicitConfigReq_16QAM(UTRAN_CellId_Type p_CellId,
                                                                                 template (value) SS_ActivationTime p_ActTime := cs_ActivateNow) :=
  /* @status    APPROVED (UTRAN) */
  /* @sic R5-145760 sic@ */
    cas_CMAC_MAChs_TFRC_ExplicitConfigReq_FDD(p_CellId, p_ActTime, qam16, -, -, -, -, {6, 2, 1, 5, 3, 4, 7, 0});

  template (value) U_CMAC_CONFIG_REQ cas_CMAC_MAChs_TFRC_ExplicitConfigReq_64QAM(UTRAN_CellId_Type p_CellId,
                                                                                 template (value) SS_ActivationTime p_ActTime := cs_ActivateNow) :=
  /* @status    APPROVED (UTRAN) */
  //@sic R5-145760 sic@
    cas_CMAC_MAChs_TFRC_ExplicitConfigReq_FDD(p_CellId, p_ActTime, qam64, -, -, -, -, {6, 2, 1, 5, 3, 4, 7, 0}, octetAligned);

  template (present) U_CMAC_CONFIG_CNF car_CMAC_MACi_Config_CNF(template integer p_NodeB_Id) :=
  { /* @status    APPROVED (UTRAN) */
    configMACi := {
      nodeB_Id := p_NodeB_Id
    }
  };

  template (present) U_CMAC_CONFIG_CNF car_CMAC_MACis_Config_CNF(UTRAN_CellId_Type p_CellId) :=
  { /* @status    APPROVED (UTRAN) */
    configMACis := {
      cellId := f_UtranCellId2Int(p_CellId)
    }
  };

  template (value) EHS_DSCH_Flows_r9 cs_HS_DSCHMacdFlows_r9(template (value) HARQ_Info_r7 p_HARQ_Info,
                                                            template (value) SS_MAC_ehs_AddReconfReordQueueList_r9 p_SS_MAC_ehs_AddReconfReordQueueList_r9,
                                                            template (omit) boolean p_MimoStatus := omit) :=
  { /* @status    APPROVED (UTRAN) */
    harqInfo_r7 := p_HARQ_Info,
    addOrReconfMAC_ehs_ReordQ := p_SS_MAC_ehs_AddReconfReordQueueList_r9,
    ackNackRepetitionFactor := 1,
    mimoStatus := p_MimoStatus
  };

  template (value) E_DCHMACdFlows cs_E_DCHMACdFlows_FDD_DTCH:=
  { /* @status    APPROVED (UTRAN) */
    tti := f_Get_EDCH_TTI_Value(),
    harq_Info := rvtable,
    addReconf_MAC_d_FlowList := omit,
    addReconf_MAC_d_FlowList_r7 := {
      cs_E_DCH_AddReconf_MAC_d_Flow_DTCH_r7
    }
  };

  template (value) U_CMAC_CONFIG_REQ cas_CMAC_MAChs_TFRC_ExplicitConfigReq_r10(UTRAN_CellId_Type p_CellId,
                                                                               template (value) TFRCconfigure_r10OrLaterExtensionType p_TFRCconfigure_r10OrLaterExtensionType,
                                                                               template (value) SS_ActivationTime p_SS_ActivationTime,
                                                                               template (omit) HS_DSCH_TBSizeTable  p_OctetAligned := omit) :=  //@sic R5s140782 sic@
  { /* @status    APPROVED (UTRAN) */
    tfrc_FDD := {
      cellId := f_UtranCellId2Int(p_CellId),
      tfrcConfigMode := {
        relAspTypeExtension := p_TFRCconfigure_r10OrLaterExtensionType
      },
      activationTime := p_SS_ActivationTime,
      ss_DTX_Info := omit,
      hs_DSCH_TBSizeTable := p_OctetAligned
    }
  };

  template (value) TFRC_Explicit_Type cs_TFRC_Explicit_Common(ModulationScheme p_ModulationScheme,
                                                             integer p_NoOfChannelisationCodes := 1,
                                                             integer p_TbSizeIndexOnHS_SCCH := 19,
                                                             RedundancyVersionList p_RedundancyVersionList) :=
  { /* @status    APPROVED (UTRAN) */
    modulationScheme            :=  p_ModulationScheme,
    channelisationCodeOffset    :=  1,
    noOfChannelisationCodes     :=  p_NoOfChannelisationCodes,
    tbSizeIndexOnHS_SCCH        :=  p_TbSizeIndexOnHS_SCCH,
    minimumInterTTIinterval     :=  3,
    redundancyVersions          :=  p_RedundancyVersionList,
    hs_PDSCH_TxPower            :=  tsc_DL_hs_PDSCH_TxPower
  };

  template (value) SS_E_HICH_Info_r10OrLaterExtensionType cs_SS_E_HICH_r11 :=
  { /* @status    APPROVED (UTRAN) */
    rel11_AspExt :=    {
      e_HICHInfo_r11 := {
        channelisationCode := tsc_E_HICH_ChannelisationCode,
        signatureSequence := tsc_E_HICH_SignatureSequence,
        secondarySignatureSequence := omit
      }
    }
  };

  template (value) CphyTrchConfigReq cs_CphyTrchConfigReq_Common_FDD_r11(template (value) SS_ActivationTime p_ActivationTime,
                                                                         template (value) TrCHInfo_r10OrLaterExtensionType p_TrCHInfoExtension) :=
  /* @status    APPROVED (UTRAN) */
    cs_CphyTrchConfigReq_Common_FDD(p_ActivationTime, -, -, -, -, -, -, omit, omit, -, p_TrCHInfoExtension);

  template (value) SS_MAC_ehs_AddReconfReordQueueList_r11 cs_SS_MAC_ehs_AddReconfReordQueue_1Q_r11(MAC_ehs_QueueId p_QID,
                                                                                                   integer  p_QueuePriority) :=
  { /* @status    APPROVED (UTRAN) */
    cs_SS_MAC_ehs_AddReconfReordQ_r11(p_QID, p_QueuePriority)
  };

  template (value) SS_MAC_ehs_AddReconfReordQ_r11 cs_SS_MAC_ehs_AddReconfReordQ_r11(MAC_ehs_QueueId p_QID,
                                                                                    integer  p_QueuePriority) :=
  { /* @status    APPROVED (UTRAN) */
    mAC_ehs_AddReconfReordQ := cs_MAC_ehs_AddReconfReordQ_r11(p_QID),
    priority := p_QueuePriority
  };

  template (value) SS_RLC_Info_r10OrLaterExtensionType cds_RB_AM_Info_HE_FDD_r11(template (value) DL_AM_RLC_Mode_r11 p_DL_AM_RLC_Mode,
                                                                                 template (value) SS_DL_RLC_Mode p_SS_DL_RLC_Mode)
    modifies cs_RB_AM_Info_Common_FDD_r11:=
  { /* @status    APPROVED (UTRAN) */
    rel11_AspExt := {
      useSpecialValueOfHEField := true_
    }
  };

}
