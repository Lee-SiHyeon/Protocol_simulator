  /*
   * @desc      modify PDCCH configuration
   * @param     p_EUTRA_FDD_TDD_Mode
   * @return    template (value) PdcchConfig_Type
   * @status    APPROVED (LTE_A_R10_R11)
   */
  function f_EUTRA_PdcchConfig_ModifyCCESpecialSubframe_eMBMS_5MHz(EUTRA_FDD_TDD_Mode_Type p_EUTRA_FDD_TDD_Mode) return template (value) PdcchConfig_Type
  { /* @sic R5-135000 sic@ */
    var template (value) PdcchConfig_Type v_PdcchConfig;
    var template (value) PdcchCandidateList_Type v_PdcchCandidateList;
    var integer v_CommSearch;
    var integer v_UeSpecificSearch;
    select (p_EUTRA_FDD_TDD_Mode) {
      case (FDD) {  // FDD
        v_PdcchCandidateList := cs_PdcchCandidateList_FDD_eMBMS_5MHz;
        v_CommSearch       := 2;
        v_UeSpecificSearch := 1;
      }
      case (TDD) {  // TDD
        v_PdcchCandidateList := cs_PdcchCandidateList_TDD_eMBMS_5MHz;
        v_CommSearch       := 2;
        v_UeSpecificSearch := 1;
      }
    }
    v_PdcchConfig := {
      CommonSearchSpaceFormat := v_CommSearch,
      UeSpecificSearchSpaceFormat := v_UeSpecificSearch,
      PdcchCandidateList := v_PdcchCandidateList,
      RelativeTxPower := omit
    }
    return v_PdcchConfig;
  };

  template (value) PmchConfig_Type cs_PmchConfig_Def :=
  { //Acc to 36.508 Table 4.3.3.2-1/2
    /* @status    APPROVED (LTE_A_R10_R11) */
    RelativeTxPower  := cs_PowerRatios_PMCH
  };

  template (value) ToRS_EPRE_Ratios_Type cs_PowerRatios_PMCH :=
  { /* @status    APPROVED (LTE_A_R10_R11) */
    RA := 0,
    RB := omit
