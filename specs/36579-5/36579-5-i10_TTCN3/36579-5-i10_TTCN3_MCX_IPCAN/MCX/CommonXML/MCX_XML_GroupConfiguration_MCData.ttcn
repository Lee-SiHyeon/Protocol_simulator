module MCX_XML_GroupConfiguration_MCData {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_GroupConfiguration_Common all;
  import from MCX_XML_common_policy all;
  import from TestcaseProperties all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttGroupInfo_1_0 language "XSD" all;        
  import from urn_ietf_params_xml_ns_common_policy language "XSD" all;  
  import from urn_oma_xml_xdm_extensions language "XSD" all;            

  /*
   * @desc      Build entry for MCData Group Member List
   * @param     p_URI
   * @param     p_UserPriority
   * @param     p_ParticipantType
   * @return    template (value) MCX_ResourceLists_EntryType_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_GroupMemberListEntryTX(XSD.AnyURI p_URI,
                                           urn_3gpp_ns_mcpttGroupInfo_1_0.User_priority p_UserPriority,
                                           urn_3gpp_ns_mcpttGroupInfo_1_0.Participant_type p_ParticipantType) return template (value) MCX_ResourceLists_EntryType_Type
  {
    var template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_mcdata_id v_Mcdata_mcdata_id := cs_MCX_ResourceLists_Entry(p_URI);
    var MCX_ResourceLists_EntryType_Type.elem_list v_AdditionalExtensions := {
      f_Bit2XsdString(encvalue(v_Mcdata_mcdata_id))
    };
    return f_MCX_GroupMemberListEntryTX_Common(p_URI, p_UserPriority, p_ParticipantType, v_AdditionalExtensions);
  }

  /*
   * @desc      Setup MCData Group Ruleset for MCData Group Configuration
   * @param     p_Id                (default value: "rule1")
   * @return    template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
   * @status    APPROVED (MCX)
   */
  function f_MCData_GroupRuleset(XSD.ID p_Id := "rule1") return template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
  { /* cp:ruleset for "rule1" according to Table 5.5.7.3-1: MCData Group Configuration Defaults */
    var urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_allow_getting_member_list               v_On_network_allow_getting_member_list := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_on_network_allow_getting_affiliation_list   v_Mcdata_on_network_allow_getting_affiliation_list := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_allow_transmit_data_in_this_group           v_Mcdata_allow_transmit_data_in_this_group := true;
    var template (value) ExtensibleType v_Actions;
    var template (value) CP_Rule_Type v_Rule;

    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_On_network_allow_getting_member_list)),
        f_Bit2XsdString(encvalue(v_Mcdata_on_network_allow_getting_affiliation_list)),
        f_Bit2XsdString(encvalue(v_Mcdata_allow_transmit_data_in_this_group))
      }
    };
    v_Rule := cs_MCX_CP_Rule(p_Id, v_Actions);
    
    return cs_MCX_CP_Ruleset(v_Rule);
  }

  template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.LanguageString cs_MCData_LanguageString(XSD.String p_Text) :=
  { /* @status    APPROVED (MCX) */
    sequence_list := {
      {
        langType := "English",
        langText := p_Text
      }
    }
  };

  template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.EnhancedStatusType cs_MCData_EnhancedStatus(XSD.NonNegativeInteger p_Id,
                                                                                              XSD.String p_ShortText,
                                                                                              XSD.String p_Description) :=
  { /* @status    APPROVED (MCX) */
    id := p_Id,
    shortText := cs_MCData_LanguageString(p_ShortText),
    description := cs_MCData_LanguageString(p_Description)
  };

  template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.EnhancedStatusList cs_Mcdata_enhanced_status_operational_values :=
  { /* @status    APPROVED (MCX) */
    sequence_list := {
      { choice := { status := cs_MCData_EnhancedStatus(0, "going", "going to the operation site") } },
      { choice := { status := cs_MCData_EnhancedStatus(1, "arrived", "just arrived at the operation site") } }
    }
  };

  /*
   * @desc      Setup MCData Group Extensions for MCData Group Configuration
   * @param     p_Owner
   * @param     p_Off_network_ProSe_layer_2_group_id
   * @return    MCX_PocListService_ListService_Type.elem_list
   * @status    APPROVED (MCX)
   */
  function f_MCData_Group_Extensions_mcpttgi(urn_3gpp_ns_mcpttGroupInfo_1_0.Owner p_Owner,
                                             urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_layer_2_group_id p_Off_network_ProSe_layer_2_group_id) return MCX_PocListService_ListService_Type.elem_list
  {
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_group_hierarchy v_Level_within_group_hierarchy := 0;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_user_hierarchy v_Level_within_user_hierarchy := 0;
    var template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_enhanced_status_operational_values  v_Mcdata_enhanced_status_operational_values := cs_Mcdata_enhanced_status_operational_values;  // @sic R5-217905 sic@
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_IP_multicast_address           v_Off_network_IP_multicast_address := "0.0.0.0";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_relay_service_code       v_Off_network_ProSe_relay_service_code := char2oct("123456");
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_on_network_group_priority           v_Mcdata_on_network_group_priority := 1;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_on_network_max_data_size_for_SDS    v_Mcdata_on_network_max_data_size_for_SDS := 10000;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_on_network_max_data_size_for_FD     v_Mcdata_on_network_max_data_size_for_FD := 10000;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_on_network_max_data_size_auto_recv  v_Mcdata_on_network_max_data_size_auto_recv := 2000;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_off_network_ProSe_signalling_PPPP   v_Mcdata_off_network_ProSe_signalling_PPPP := '01'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcdata_off_network_ProSe_media_PPPP        v_Mcdata_off_network_ProSe_media_PPPP := '01'O;
    var MCX_PocListService_ListService_Type.elem_list v_Extension;
    
    if (f_GetTestcaseAttrib_FD_UsingHttp_NonMandatoryDownload_group(testcasename())) {
      v_Mcdata_on_network_max_data_size_auto_recv := 0;          // @sic R5w220011 Proposal 2.6.3-1 sic@
    }

    v_Extension := {
      f_Bit2XsdString(encvalue(p_Off_network_ProSe_layer_2_group_id)),
      f_Bit2XsdString(encvalue(v_Off_network_IP_multicast_address)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_relay_service_code)),
      f_Bit2XsdString(encvalue(p_Owner)),
      f_Bit2XsdString(encvalue(v_Level_within_group_hierarchy)),
      f_Bit2XsdString(encvalue(v_Mcdata_enhanced_status_operational_values)),  // @sic R5-217905 sic@
      f_Bit2XsdString(encvalue(v_Level_within_user_hierarchy)),
      f_Bit2XsdString(encvalue(v_Mcdata_on_network_group_priority)),
      f_Bit2XsdString(encvalue(v_Mcdata_on_network_max_data_size_for_SDS)),
      f_Bit2XsdString(encvalue(v_Mcdata_on_network_max_data_size_for_FD)),
      f_Bit2XsdString(encvalue(v_Mcdata_on_network_max_data_size_auto_recv)),
      f_Bit2XsdString(encvalue(v_Mcdata_off_network_ProSe_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcdata_off_network_ProSe_media_PPPP))
    };
    return v_Extension;
  }

  /*
   * @desc      36.579-1 Table 5.5.7.3-1: MCData Group Configuration Defaults
   * @param     p_Regrouped         (default value: omit)
   * @return    template (value) MCX_PocListService_Group_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_GroupConfiguration(template (omit) urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_regrouped p_Regrouped := omit) return template (value) MCX_PocListService_Group_Type
  {
    var template (value) MCX_PocListService_Group_Type.sequence_list v_GroupList;
    var template (value) MCX_PocListService_ListService_Type v_Group1;
    var template (value) MCX_PocListService_List_Type.entry_list v_GroupMemberList;
    var template (omit)  XSD.NonNegativeInteger v_MaxParticipants := omit;      // not present in Table 5.5.7.3-1
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryA := f_MCData_GroupMemberListEntryTX(px_MCData_ID_User_A, tsc_MCX_User_A_Priority, px_MCX_User_A_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryB := f_MCData_GroupMemberListEntryTX(px_MCData_ID_User_B, tsc_MCX_User_B_Priority, px_MCX_User_B_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryC := f_MCData_GroupMemberListEntryTX(px_MCData_ID_User_C, tsc_MCX_User_C_Priority, px_MCX_User_C_ParticipantType);
    var template (value) urn_oma_xml_xdm_extensions.Supported_services v_SupportedServices := f_MCX_ListServiceExtensions_SupportedService(MCData);
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_GroupRuleset;
    var MCX_PocListService_ListService_Type.elem_list v_Extensions := {};

    v_GroupMemberList := {
      v_GroupMemberListEntryA,
      v_GroupMemberListEntryB,
      v_GroupMemberListEntryC
    };
    
    v_GroupRuleset := f_MCData_GroupRuleset();

    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_GroupRuleset)));
    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_SupportedServices)));
    v_Extensions := f_MCX_GroupExtensions_Concat(v_Extensions, f_MCData_Group_Extensions_mcpttgi(px_MCX_Group_A_Owner_Organization, tsc_MCX_Group_A_ProSeLayer2GroupID));
    if (isvalue(p_Regrouped)) {
      v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,  f_Bit2XsdString(encvalue(valueof(p_Regrouped))));
    }

    v_Group1 := cs_MCX_PocListService_ListService(px_MCData_Group_A_ID,
                                                  cs_MCX_ResourceLists_DisplayName(-, px_MCData_Group_A_Name),
                                                  cs_MCX_PocListService_List(v_GroupMemberList),
                                                  v_MaxParticipants,
                                                  v_Extensions);
    v_GroupList := {
      { list_service := v_Group1 }
    };
    
    return cs_MCX_PocListService_Group(v_GroupList);
  }

}
