   * @param     p_StartMICO
   * @status    APPROVED (NR5GC)
   */
  function f_UT_TriggerMICO(UT_PTC_MTC_PORT p_Port, boolean p_StartMICO)
  {
    // @sic R5s240350 sic@
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(MICO, CNF_REQUIRED, {cs_Ut_Parameter_Common("MICO", bit2str(f_ConvertBoolToBit(p_StartMICO)))}));
  };

  /*
   * @desc      To trigger PS Data Off (activate or deactivate)
   * @param     p_Port
   * @param     p_ActivatePSDataOff
   * @status    APPROVED (NR5GC)
   */
  function f_UT_TriggerPS_DataOff(UT_PTC_MTC_PORT p_Port, boolean p_ActivatePSDataOff)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PS_DATA_OFF, NO_CNF_REQUIRED, {cs_Ut_Parameter_Common("DATA_OFF", bit2str(f_ConvertBoolToBit(p_ActivatePSDataOff)))}));
  };

  /*
   * @desc      To configure UUAA parameters, used for UAS
   * @param     p_Port
   * @param     p_UAV_Id
   * @param     p_USS_IPaddr
   * @param     p_AuthorizationPayload
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_UAS_UUAA_Params(UT_PTC_MTC_PORT p_Port,
                                   octetstring p_UAV_Id,
                                   octetstring p_USS_IPaddr,
                                   octetstring p_AuthorizationPayload)
  {
    var charstring v_Cmd := "0," & oct2str(p_UAV_Id) & "," & oct2str(p_USS_IPaddr) & "," & oct2str(p_AuthorizationPayload);
    
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(UAS_UUAA, CNF_REQUIRED, {cs_Ut_Parameter_Common("UUAA", v_Cmd)}));
  };

  /*
   * @desc      To configure SATELLITE_TRAJECTORY_PREDICTION for NGSO
   * @param     p_Port
   * @param     p_Enable            (default value: DISABLE)
   * @status    APPROVED (NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_DisableNGSO_SatellitePrediction(UT_PTC_MTC_PORT p_Port,
                                   SatellitePrediction p_Enable := DISABLE)  // @sic R5-253187 sic@
  {
    var charstring v_String := "DISABLE";
    
    if (p_Enable == ENABLE) {
      v_String := "ENABLE";
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(SATELLITE_TRAJECTORY_PREDICTION, CNF_REQUIRED, {cs_Ut_Parameter_Common("Prediction", v_String)})); // @sic R5-253187 sic@
  };

  /*
   * @desc      To trigger the UE to clear the SOR CMCI NV memory
   * @param     p_Port
   * @status    APPROVED (NR5GC)
   */
  function f_UT_MMI_ClearSOR_CMCI_NV_Memory(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(CLEAR_SOR_CMCI_NV_MEM, CNF_REQUIRED));
  };

}
