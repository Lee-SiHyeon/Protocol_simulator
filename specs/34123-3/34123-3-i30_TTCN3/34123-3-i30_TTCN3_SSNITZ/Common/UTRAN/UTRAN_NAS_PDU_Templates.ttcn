module UTRAN_NAS_PDU_Templates {

  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UTRAN_Parameters all;
  import from UTRAN_TypeDefs all;

  template (value) RRCDataReqType cs_U_AttachAcc(template (value) AttachResult p_AttachRes,
                                                 template (value) RoutingAreaId p_RAI,
                                                 template (omit) PTMSI_Signature p_PTMSIsig,
                                                 template (omit) MobileIdentity p_PTMSI,
                                                 template (omit) MobileIdentity p_TMSI,
                                                 template (omit) PLMN_List p_EPLMN := omit,  //@sic R5-134916 sic@
                                                 template (omit) GMM_Cause p_GmmCause := omit, //@sic R5-140946 sic@
                                                 template (omit) AddNtwFeatureSupport p_AddNwFeatSupport := omit,//@sic R5-140946 sic@
                                                 template (omit) GPRS_Timer2 p_T3302Value:= omit) := //@sic R5-140946 sic@
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    attachAccept := cs_AttachAcc_Common(p_AttachRes, p_RAI, p_PTMSIsig, p_PTMSI, p_EPLMN, p_TMSI, p_GmmCause, p_AddNwFeatSupport, p_T3302Value) // @sic R5-123114 sic@, @sic R5-140946 sic@
  };

  template (value) RRCDataReqType cs_U_AuthReq(template (value) KeySeq p_KeySeq,
                                               template (value) MM_RAND p_RAND,
                                               template (value) AUTN p_AUTN) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationRequest := cs_AuthReq_Common(p_KeySeq, p_RAND, p_AUTN)
  };

  template (value) RRCDataReqType cs_U_AuthAndCiphReq(template (value) RAND p_Rand,
                                                      template (value) CiphKeySeqNum p_CiphKeySeqNum,
                                                      template (value) AUTN p_Autn) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationAndCipheringRequest := cs_AuthAndCiphReq_Common(p_Rand, p_CiphKeySeqNum, int2bit (enum2int(px_GPRS_CipheringAlgorithm), 3), p_Autn) // @sic R5-130618, R5s130132 sic@
  };

  template (value) RRCDataReqType cs_U_LocUpdAcpTMSI(octetstring p_PLMN,
                                                     octetstring p_LAC,
                                                     template (omit) PLMN_List p_EPLMN := omit,
                                                     template (omit) GPRS_Timer3 p_GPRS_Timer3 := omit   //@sic R5s150676 change 4.7 sic@
                                                     ) :=  //@sic R5-134916 sic@
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    locationUpdatingAccept := cs_LocUpdAcp_Common (p_PLMN, p_LAC, cs_MobileIdTMSIorPTMSI ('17'O, px_TMSI_Def), p_EPLMN, p_GPRS_Timer3)
  };

  template (value) RRCDataReqType cs_U_LocUpdAcpIMSI(octetstring p_PLMN,
                                                     octetstring p_LAC,
                                                     template (value) MobileIdentity p_IMSIMobileIdWithIEI,
                                                     template (omit) PLMN_List p_EPLMN := omit) :=  //@sic R5-134916 sic@
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    locationUpdatingAccept := cs_LocUpdAcp_Common (p_PLMN, p_LAC, p_IMSIMobileIdWithIEI, p_EPLMN)
  };

  template (value) RRCDataReqType cs_U_LocUpdAcp_NoMobId(octetstring p_PLMN, // @sic R5-112706 sic@
                                                         octetstring p_LAC,
                                                         template (omit) PLMN_List p_EPLMN := omit) :=  //@sic R5-134916 sic@
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    locationUpdatingAccept := cs_LocUpdAcp_Common (p_PLMN, p_LAC, omit, p_EPLMN)
  };

  template (value) RRCDataReqType cs_U_RA_UpdAcc3(template (value) UpdateResult p_UpdateResult,
                                                  template (value) RoutingAreaId p_RAI,
                                                  template (omit) PTMSI_Signature p_PTMSIsig,
                                                  template (omit) MobileIdentity p_PTMSI,
                                                  template (omit) PDP_ContextStatus p_PDP_ContextStatus) := // @sic R5-133604 sic@
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    routingAreaUpdateAccept := cs_RA_UpdAcc_Common (p_UpdateResult,
                                                    p_RAI,
                                                    p_PTMSIsig,
                                                    p_PTMSI,
                                                    p_PDP_ContextStatus)
  };

  template (value) RRCDataReqType cs_U_CM_ServAcc :=
  { /* @status    APPROVED (LTE_IRAT, SSNITZ, UTRAN) */
    cmServiceAccept := {
      skipIndicator := '0000'B,
      mMProtocolDiscriminator := '0101'B,
      msgType := '00100001'B
    }
  };

  template (value) RRCDataReqType cs_U_CallProc ( template (value) TI p_TI ):=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ) */
    callProceeding := cs_CallProc_Common ( p_TI )
  };

  template (value) RRCDataReqType cs_U_Alert ( template (value) TI p_TI ) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ) */
    alertingdl := cs_Alert_Common ( p_TI )
  };

  template (value) RRCDataReqType cs_U_Connect ( template (value) TI p_TI ) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ) */
    connectdl := cs_Connect_Common ( p_TI )
  };

  template (value) RRCDataReqType cs_U_Disconnect(template (value) TI p_Ti, template (omit) FacilityIE p_Facility := omit ) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    disconnectDL := cs_Disconnect_Common(p_Ti, p_Facility)  // @sic R5s150240 sic@
  };

  template (value) RRCDataReqType cs_U_ReleaseComplete(template (value) TI p_TI,
                                                       ProtocolDiscriminator p_PD := tsc_PD_CC, // Call related SS
                                                       template (omit) Cau p_Cau := omit,
                                                       template (omit) FacilityIE p_Facility := omit) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    releaseComplete := cs_RelCmpl_Common(p_TI, p_PD, p_Cau, p_Facility)
  };

  template (present) RRCDataIndType cr_U_AttachComplete :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    attachComplete := cr_AttachComplete_Common
  };

  template (present) RRCDataIndType cr_U_DetachRequest(template DetachType p_Type := cr_DetachTypeOnSwitchOff,
                                                       template MobileIdentity p_Ptmsi := cr_MobileIdAny('18'O) ifpresent,
                                                       template PTMSI_Signature p_Signature := cr_PTMSI_Signature2Any ifpresent) := // @sic R5s110112 sic@
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    /* @sic R5s140387 : default values for p_Type and p_Ptmsi => removed at calling side sic@ */
    detachRequest := cr_DetachReq_Common(p_Type, p_Ptmsi, p_Signature)
  };

  template (present) RRCDataIndType cr_U_AuthFailAny :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationFailure := cr_AuthFailAny_Common
  };

  template (present) RRCDataIndType cr_U_AuthAndCiphFailureAny :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationAndCipheringFailure := cr_AuthAndCiphFailure_Common
  };

  template (present) RRCDataIndType cr_U_AuthAndCiphRsp(template AuthRsp p_AuthRsp,
                                                        template AuthRspExt p_AuthRspExt) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationAndCipheringResponse := cr_AuthAndCiphRsp_Common (p_AuthRsp, p_AuthRspExt)
  };

  template (present) RRCDataIndType cr_U_AuthRspAnyExt :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationResponse := cr_AuthResponse_Common(cr_AuthRspExtAny)
  };

  template (present) RRCDataIndType cr_U_AuthRspAnyNoExt :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    authenticationResponse := cr_AuthResponse_Common
  };

  template (present) RRCDataIndType cr_U_LocationUpdatingRequest :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    locationUpdatingRequest := cr_LocUpdReq_Common(?)
  };

  template (present) RRCDataIndType cr_U_PagRsp(template (present) KeySeq         p_KeySeq,
                                                template (present) MobileIdentity p_MobileId) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    pagingResponse := cr_PagRsp_Common ( p_KeySeq, p_MobileId )
  };

  template (present) RRCDataIndType cr_U_RAUpdComplete :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    routingAreaUpdateComplete:= cr_RAUpdComplete_Common
  };

  template (present) RRCDataIndType cr_U_ServReqAny(template (present) KeySeq p_KeySeq) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    cmServiceRequest := cr_CM_ServReq(p_KeySeq)
  };

  template (present) RRCDataIndType cr_U_CMServReq_SS_MO(template (present) KeySeq p_KeySeq) :=
  { /* @status    APPROVED (SSNITZ) */
    cmServiceRequest := cr_CM_ServReq(p_KeySeq, tsc_MOCallOrPacketModeConn, cr_MobileIdTMSI_lv(px_TMSI_Def), omit)
  };

  template (present) RRCDataIndType cr_U_ConnAck(template TI p_TI) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ) */
    connectAcknowledge := cr_ConnAck_Common(p_TI)
  };

  template (present) RRCDataIndType cr_U_TMSI_ReallocCmpl :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    tmsiReallocationComplete := cr_TMSI_ReallocCmpl_Common
  };

  template (present) RRCDataIndType cr_U_Imsi_DetachInd :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    imsiDetachIndication := cr_IMSI_DetachInd_Common (-, ?) // @sic R5s110777, R5-120624 sic@
  };

  template (present) RRCDataIndType cr_U_Rel(template TI p_Ti) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    releaseUL := cr_Rel_Common(p_Ti)
  };

  template (present) RRCDataIndType cr_U_CallConfirmed(template TI p_TI,
                                                       template StreamId p_StrId := *) := // @sic R5s120070 sic@
  { /* @status    APPROVED (IMS_IRAT, LTE_IRAT, SSNITZ) */
    callConfirmed := cr_CallConf_Common (p_TI, p_StrId)
  };

  template (value) RRCDataReqType cs_U_SetupMTCall(template (value) Bcap p_Bcap) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_IRAT, SSNITZ) */
    setupdl := cs_SetupMT_Common(p_Bcap, -, -, omit) // @sic R5s150422 sic@ Signal IE NOT present in 34.108 7.2.3.1 procedure
  };

  template (present) RRCDataIndType cr_U_SetupMOCall(template (present) Bcap p_Bcap) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    setupul :=  cdr_SetupMO_Speech_Common(p_Bcap)
  };

  template (present) RRCDataIndType cr_U_Alerting (template TI p_TI) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_IRAT, SSNITZ) */
    alertingul := cr_Alert_Common (p_TI)
  };

  template (present) RRCDataIndType cr_U_Connect(template TI p_TI) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    connectul := cr_Connect_Common (p_TI)
  };

  template (value) RRCDataReqType cs_U_ConnectAck(template (value) TI p_TI) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    connectAcknowledge := cs_ConnAck_Common(p_TI)
  };

  template (value) RRCDataReqType cs_U_StartDTMFAck(template (value) TI p_TI,
                                                    KeypadFacility p_KPF) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    startDTMFAck := cs_StartDTMFAck(p_TI, p_KPF)
  };

  template (value) RRCDataReqType cs_U_StopDTMFAck(template (value) TI p_TI) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    stopDTMFAck := cs_StopDTMFAck(p_TI)
  };

  template (present) RRCDataIndType cr_U_StartDTMF(template (present) TI p_TI := ?,
                                                   template (present) KeypadFacility p_KPF := ?) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    startDTMF := cr_StartDTMF(p_TI, p_KPF)
  };

  template (present) RRCDataIndType cr_U_StopDTMF(template (present) TI p_TI := ?) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    stopDTMF := cr_StopDTMF(p_TI)
  };

  template (present) RRCDataIndType cr_U_Hold(template (present) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    hold := cr_Hold(p_TI)
  };

  template (value) RRCDataReqType cs_U_HoldAck(template (value) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    holdAcknowledge := cs_HoldAck(p_TI)
  };

  template (present) RRCDataIndType cr_U_DisconnectUL(template (present) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    disconnectUL := cr_DisconnectUL_Common(p_TI)
  };

  template (present) DISCONNECTul cr_DisconnectUL_Common(template (present) TI p_Ti) :=
  { /* @status    APPROVED (SSNITZ) */
    Ti                       := p_Ti,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType                  := '??100101'B,
    cau             := cr_CauAny(omit),  //@sic R5s141120 sic@
    facility        := cr_Facility_Any ifpresent,
    userUser        := cr_UserUserAny ifpresent,
    ssVersionInd    := cr_SS_VersionIndAny ifpresent
  };

  template (value) RRCDataReqType cs_U_ReleaseDL(template (value) TI p_TI,
                                                 template (omit) Cau p_Cau1 := omit,
                                                 template (omit) Cau p_Cau2 := omit,
                                                 template (omit) FacilityIE p_Facility := omit,
                                                 template (omit) UserUser p_UserUser := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    releaseDL := cs_RelDL_Common(p_TI, p_Cau1, p_Cau2, p_Facility, p_UserUser)
  };

  template (value) RELEASEdl cs_RelDL_Common(template (value) TI p_Ti,
                                             template (omit) Cau p_Cau1 := omit,
                                             template (omit) Cau p_Cau2 := omit,
                                             template (omit) FacilityIE p_Facility := omit,
                                             template (omit) UserUser p_UserUser := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    ti                       := p_Ti,
    cC_ProtocolDiscriminator := tsc_PD_CC,
    msgType                  := '00101101'B,
    cau                      := p_Cau1,
    cau2                     := p_Cau2,
    facility                 := p_Facility,
    userUser                 := p_UserUser
  };

  template (present) RRCDataIndType cr_U_ReleaseComplete_CallSS(template (present) TI p_TI) :=
  { /* @status    APPROVED (SSNITZ) */
    releaseComplete := cr_ReleaseComplete(p_TI, -, -, tsc_PD_CC)  // @sic R5s140884 sic@
  };

  template (present) RELEASECOMPLETE cr_ReleaseComplete(template (present) TI p_TI,
                                                        template Cau p_Cau := cr_CauAny ifpresent,
                                                        template FacilityIE p_Facility := cr_Facility_Any ifpresent,
                                                        template ProtocolDiscriminator p_PD := tsc_PD_SS) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := p_TI,
    protocolDiscriminator := p_PD, // @sic R5s140884 sic@
    msgType         := '??101010'B,
    cau             := p_Cau,
    facility        := p_Facility,
    userUser        := cr_UserUserAny ifpresent,
    sS_VersionInd   := cr_SS_VersionIndAny ifpresent
  };

}
