          (p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr1_FR2Mix_r16.fr1_r16 == pc_maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_fr1_FR2Mix_fr1) and
          (p_NrDlPrsResourcesBandCombinationList[v_Index].maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_r16.fr1_FR2Mix_r16.fr2_r16 == pc_maxNrOfDL_PRS_ResourcesAcrossAllFL_TRP_ResourceSet_fr1_FR2Mix_fr2)){
