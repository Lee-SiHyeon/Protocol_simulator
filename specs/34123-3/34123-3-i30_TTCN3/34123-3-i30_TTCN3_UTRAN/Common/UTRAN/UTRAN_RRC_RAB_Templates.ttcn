  template (value) DedicatedTransChTFS cs_DCH_336_TFS_UE :=
  { /* Transport format set for transport channel used in CreateCell_DCH_64kPS_RAB_SRB for message sent to UE
       3GPP TS 34.108 clause 6.10.2.4.1.24
       TTI = 20 ms;
       5 transport formats:
       TB size always=336 bits; TransportBlocks = 0,1,2,3 and 4 ;
       rlsc_Size = TB_Size ( DCH, w/o MUX)
       coding = turbo;
       CRCsize = 16;
       RateMatching = 150 */
    /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    tti := {
      tti20 := {
        {
          rlc_Size := {
            octetModeType1 := {
              sizeType2 := {
                part1 := 2,
                part2 := omit
              }
            }
          },
          numberOfTbSizeList := {
            { zero := NULL },
            { one := NULL },
            { small := 2 },
            { small := 3 },
            { small := 4 }
          },
          logicalChannelList := {
            allSizes := NULL
          }
        }
      }
    },
    semistaticTF_Information := {
      channelCodingType := {
        turbo := NULL
      },
      rateMatchingAttribute := 150,
      crc_Size := crc16
    }
  };

