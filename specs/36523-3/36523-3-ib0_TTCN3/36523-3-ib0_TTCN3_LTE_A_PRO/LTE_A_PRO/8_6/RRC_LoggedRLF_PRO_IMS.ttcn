module RRC_LoggedRLF_PRO_IMS {

  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Registration all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.6.4.11
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_8_6_4_11_IMS1() runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var MessageHeader v_MessageHeader_Response183;
    
    // Register
    f_IMS_PTC_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // MO Call Setup
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    f_UT_RequestIMSCall(MMI, px_IMS_CalleeUri);
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_AnnexC21_Step2_A4(); //@sic R5s170899 sic@

    v_MessageHeader_Response183 := f_IMS_MOCallSetup_AnnexC21_Step3_4(v_InviteRequestWithSdp);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN); //@sic R5s180062 sic@
    f_IMS_MOCallSetup_AnnexC21_Steps5_13(v_InviteRequestWithSdp, v_MessageHeader_Response183);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IPCAN_WaitForTrigger(IPCAN); //@sic R5s170899 sic@
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite); //@sic R5s170899 sic@

    // Wait for optional deregistration
    f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN();
  }

}
