  type record RegistrationResult {                                /* 24.501 cl. 9.11.3.6 */
    // IEI is always skipped
    Type4Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
    B1_Type                     spare,                          /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     disasterRoamingResult,          /* Sep22 @sic R5s221179 Baseline Moving sic@ */
    B1_Type                     emergencyRegistered,            /* Sep20 @sic R5s201387 Baseline Moving sic@ */
    B1_Type                     nssaaPerformed,                 /* Sep20 @sic R5s201387 Baseline Moving sic@ */
