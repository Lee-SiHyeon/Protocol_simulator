module NR_L2_Common {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from L2_Common4G5G all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_NTN_Configuration all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;
  import from TestcaseProperties all;

  const NR_RACH_TimingAdvance_Type tsc_NR_RACH_TA_Def := 0;           /* Acc to 38.523-3 cl 7.1.5.2: By default, the timing advance is initialised to 0 (unless specifically specified otherwise in the test case prose).
                                                                         @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_TimingAdvanceIndex_Type tsc_NR_TA_Def := 31;               /* by default all timing advance in a typical simulation environment is zero
                                                                         @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const NR_TempC_RNTI_Type tsc_NR_TempC_RNTI_SameAsC_RNTI := {SameAsC_RNTI := true};      /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const B6_Type tsc_LCID_Padding := '111111'B;                 /* @status    APPROVED (ENDC, NR5GC) */

  const B6_Type tsc_LCID_LongBSR := '111110'B;                 /* @status    APPROVED (ENDC, NR5GC) */

  const integer tsc_PreambleIndex := 37;                       /* @status    APPROVED (ENDC, NR5GC) */

   template (present) NR_MAC_ControlElementUL_Type cr_LongBSR_Payload(template (present) B8_Type   p_LCG_Presence := '00000110'B,
                                                                     template (present) NR_MAC_LongBSR_BufferSizeList_Type  p_BufferSizeList := {?,?}) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    LongBSR := {
      LCG_Presence  := p_LCG_Presence,
      BufferSizeList := p_BufferSizeList
    }
  };

  const integer tsc_NR_Maximum_PDCP_SN_12 := 4095;    /* @status    APPROVED (ENDC, NR5GC) */

  const integer tsc_NR_Maximum_PDCP_SN_18 := 262143;  /* @status    APPROVED (ENDC, NR5GC) */

  const octetstring tsc_RandomPRBS_2bytes := 'F658'O; /* @status    APPROVED (ENDC, NR5GC) */

  const octetstring tsc_RandomPRBS_1bytes := 'F6'O;   /* @status    APPROVED (ENDC, NR5GC) */

  const B1_Type tsc_NR_PDCP_D_C_Data := '1'B;                           /*  D/C field as per 38.323 cl 6.3.7   @status    APPROVED (ENDC, NR5GC) */

  const B1_Type tsc_NR_PDCP_D_C_Ctrl := '0'B;                          /*   D/C field as per 38.323 cl 6.3.7   @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_PDCP_PDU_Type cs_NR_PDCP_PDU_12B(integer p_PDCP_SN_12B,
                                                       template (value) NR_PDCP_SDU_Type p_PDCP_SDU) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    DataPduSN12Bits := {
      D_C             := tsc_NR_PDCP_D_C_Data,
      Reserved        := tsc_B3_Reserved,
      SequenceNumber  := int2bit(p_PDCP_SN_12B, 12),
      SDU             := p_PDCP_SDU,
      MAC_I           := omit
    }
  };

  template (value) NR_PDCP_PDU_Type cs_NR_PDCP_PDU_18B(integer p_PDCP_SN_18B,
                                                       template (value) NR_PDCP_SDU_Type p_PDCP_SDU) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    DataPduSN18Bits := {
      D_C             := tsc_NR_PDCP_D_C_Data,
      Reserved        := tsc_B5_Reserved,
      SequenceNumber  := int2bit(p_PDCP_SN_18B, 18),
      SDU             := p_PDCP_SDU,
      MAC_I           := omit
    }
  };

  /*
   * @desc      encode NR PDCP PDU
   * @param     p_PDCP_PDU
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_PDCP_PDU_Encvalue(template (value) NR_PDCP_PDU_Type p_PDCP_PDU) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_PDCP_PDU);
    var octetstring v_Octetstring := bit2oct(f_OctetAlignedBitString(v_Bitstring));
    return v_Octetstring;
  };

  const B1_Type tsc_NR_RLC_D_C_Data := '1'B;                            /* @status    APPROVED (ENDC, NR5GC) * D/C field as per 38.322 cl 6.2.3.6 */

  const B1_Type tsc_NR_RLC_D_C_Ctrl := '0'B;                            /* D/C field as per 38.322 cl 6.2.3.6
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  const B1_Type tsc_NR_P_NoPoll := '0'B;                                /* Value for PollingBit field within an AMDPDU/AMDPDUsegment indicating that a status report is not requested.
                                                                         * Ref 3G TS 38.322 cl 6.2.3.7  Polling bit (P) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  const B1_Type tsc_NR_P_Poll := '1'B;                                  /* Value for PollingBit field within an AMDPDU/AMDPDUsegment indicating that a status report is requested.
                                                                         * Ref 3G TS 38.322 cl 6.2.3.7  Polling bit (P) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  const NR_RLC_SegmentationInfo_Type tsc_NR_SI_FullSDU := '00'B;        /* Value to indicate that PDU contains a complete SDU. Ref 3G TS
                                                                         * Ref 3G TS 38.322 cl 6.2.3.4: Segmentation Info (SI) field
                                                                         * @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_PDU_Type cs_NR_RLC_PDU_UMD(template (value) NR_RLC_UMD_PDU_Type p_PDU) := {UMD := p_PDU};                                 /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_UMD_PDU_Type cs_NR_RLC_UMD_PDU_NoSN(template (value) NR_RLC_UMD_PduNoSN_Type p_PDU) := {NoSN := p_PDU};                   /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_PDU_Type cs_NR_RLC_PDU_AMD(template (value) NR_RLC_AMD_PDU_Type p_PDU) := {AMD := p_PDU};                                /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_PDU_Type cs_NR_RLC_PDU_Status(template (value) NR_RLC_AM_StatusPDU_Type p_PDU) := {Status := p_PDU};                     /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_PDU_Type cr_NR_RLC_PDU_Status(template (present) NR_RLC_AM_StatusPDU_Type p_PDU) := {Status := p_PDU}; /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_AMD_PDU_Type cs_NR_RLC_AMD_PDU_SN12Bit(template (value) NR_RLC_AMD_PduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};          /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_AMD_PDU_Type cs_NR_RLC_AMD_PDU_SN18Bit(template (value) NR_RLC_AMD_PduSN18Bit_Type p_PDU) := {SN18Bit := p_PDU};          /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_AM_StatusPDU_Type cs_NR_RLC_StatusPDU_SN12Bit(template (value) NR_RLC_StatusPduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_AM_StatusPDU_Type cs_NR_RLC_StatusPDU_SN18Bit(template (value) NR_RLC_StatusPduSN18Bit_Type p_PDU) := {SN18Bit := p_PDU}; /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_AM_StatusPDU_Type cr_NR_RLC_StatusPDU_SN18Bit(template (present) NR_RLC_StatusPduSN18Bit_Type p_PDU) := {SN18Bit := p_PDU}; /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_RLC_AM_StatusPDU_Type cr_NR_RLC_StatusPDU_SN12Bit(template (present) NR_RLC_StatusPduSN12Bit_Type p_PDU) := {SN12Bit := p_PDU};  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_RLC_AMD_PduSN12Bit_Type cs_NR_RLC_AMD_PduSN12Bit(integer p_SN,
                                                                       B1_Type p_Poll := tsc_NR_P_NoPoll,
                                                                       NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                                                       template (omit) NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset:= omit,
                                                                       NR_RLC_AMD_Data_Type p_Data) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to transmit one AMD SDU of SN size 12 without segmentation info  */
    Header := {
      D_C := tsc_NR_RLC_D_C_Data,
      Poll := p_Poll,
      SegmentationInfo := p_SegmentationInfo,
      SequenceNumber := int2bit(p_SN, 12),
      SegmentOffset := p_NR_RLC_SegmentOffset
    },
    Data := p_Data
  };

  template (value) NR_RLC_AMD_PduSN18Bit_Type cs_NR_RLC_AMD_PduSN18Bit(integer p_SN,
                                                                       B1_Type p_Poll := tsc_NR_P_NoPoll,
                                                                       NR_RLC_SegmentationInfo_Type p_SegmentationInfo := tsc_NR_SI_FullSDU,
                                                                       template (omit) NR_RLC_SegmentOffset_Type p_NR_RLC_SegmentOffset:= omit,
                                                                       NR_RLC_AMD_Data_Type p_Data) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to transmit one AMD SDU of SN size 18 without segmentation info  */
    Header := {
      D_C := tsc_NR_RLC_D_C_Data,
      Poll := p_Poll,
      SegmentationInfo := p_SegmentationInfo,
      Reserved := '00'B,
      SequenceNumber := int2bit(p_SN, 18),
      SegmentOffset := p_NR_RLC_SegmentOffset
    },
    Data := p_Data
  };

  template (value) NR_RLC_StatusPduSN12Bit_Type cs_NR_RLC_StatusPduSN12Bit(integer p_AckSN,
                                                                           template (omit) NR_RLC_Status_NackListSN12Bit_Type p_NackList := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /*  serves to transmit one STATUS PDU with NackList */
    D_C := tsc_NR_RLC_D_C_Ctrl,
    CPT := '000'B,                                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                       *         '000'B  STATUS PDU
                                                       *         ELSE    reserved */
    SequenceNumberACK := int2bit(p_AckSN, 12),        /* 12 bits SN */
    E1 := f_ConvertBoolToBit(ispresent(p_NackList)),  /* 1 bit E1 field */
    Reserved := '0000000'B,                           /* 7 bits reserved */
    NackList := p_NackList                            /* if present: one or more sets of a NACK_SN, E1, E2 and E3 and possibly a pair of SOstart/SOend or NACK range field for each NACK_SN */
  };

  template (value) NR_RLC_StatusPduSN18Bit_Type cs_NR_RLC_StatusPduSN18Bit(integer p_AckSN,
                                                                           template (omit) NR_RLC_Status_NackListSN18Bit_Type p_NackList := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /*  serves to transmit one STATUS PDU with NackList */
    D_C := tsc_NR_RLC_D_C_Ctrl,
    CPT := '000'B,                                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                       *         '000'B  STATUS PDU
                                                       *         ELSE    reserved */
    SequenceNumberACK := int2bit(p_AckSN, 18),        /* 18 bits SN */
    E1 := f_ConvertBoolToBit(ispresent(p_NackList)),  /* 1 bit E1 field */
    Reserved := '0'B,                                 /* 1 bit reserved */
    NackList := p_NackList                            /* if present: one or more sets of a NACK_SN, E1, E2 and E3 and possibly a pair of SOstart/SOend or NACK range field for each NACK_SN */
  };

  template (present) NR_RLC_StatusPduSN18Bit_Type cr_NR_RLC_StatusPduSN18Bit(integer p_AckSN,
                                                                             template NR_RLC_Status_NackListSN18Bit_Type p_NackList := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /*  serves to transmit one STATUS PDU with NackList */
    D_C := tsc_NR_RLC_D_C_Ctrl,
    CPT := '000'B,                                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                       *         '000'B  STATUS PDU
                                                       *         ELSE    reserved */
    SequenceNumberACK := int2bit(p_AckSN, 18),        /* 18 bits SN */
    E1 := f_ConvertBoolToBit(ispresent(p_NackList)),  /* 1 bit E1 field */
    Reserved := '0'B,                                 /* 1 bit reserved */
    NackList := p_NackList                            /* if present: one or more sets of a NACK_SN, E1, E2 and E3 and possibly a pair of SOstart/SOend or NACK range field for each NACK_SN */
  };

   template (present) NR_RLC_StatusPduSN12Bit_Type cr_NR_RLC_StatusPduSN12Bit(integer p_AckSN,
                                                                             template NR_RLC_Status_NackListSN12Bit_Type p_NackList := omit) :=
  { /*  serves to receive one STATUS PDU */
    /* @status    APPROVED (ENDC, NR5GC) */
    D_C := tsc_NR_RLC_D_C_Ctrl,
    CPT := '000'B,                                    /* 3 bits, TS 38.322, clause 6.2.3.9 Control PDU Type (CPT) field:
                                                       *         '000'B  STATUS PDU
                                                       *         ELSE    reserved */
    SequenceNumberACK := int2bit(p_AckSN, 12),        /* 12 bits SN */
    E1 := f_ConvertBoolToBit(ispresent(p_NackList)),  /* 1 bit E1 field */
    Reserved := '0000000'B,                           /* 7 bits reserved */
    NackList := p_NackList
  };

  template (value) NR_RLC_UMD_PduNoSN_Type cs_NR_RLC_UMD_PduNoSN(NR_RLC_UMD_Data_Type p_Data) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    /* serves to transmit one UMD SDU without SN and segmentation info  */
    Header := {
      SegmentationInfo := tsc_NR_SI_FullSDU,
      Reserved := '000000'B
    },
    Data := p_Data
  };

  template ( value) RLC_Config_v1700 cs_RLC_Config_v1700_Def (template(omit) T_ReassemblyExt_r17 p_T_ReassemblyExt_r17_AM := omit,
                                                              template(omit) T_ReassemblyExt_r17 p_T_ReassemblyExt_r17_UM := omit
                                                              ) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    dl_AM_RLC_v1700 := {
      t_ReassemblyExt_r17 :=  p_T_ReassemblyExt_r17_AM
    },
    dl_UM_RLC_v1700 := {
      t_ReassemblyExt_r17 :=  p_T_ReassemblyExt_r17_UM
    }
  };

  /*
   * @desc      Return RLC_BearerConfigList UM with specific parameters
   * @param     p_NR_DRB_Id
   * @param     p_DL_Len            (default value: size12)
   * @param     p_UL_Len            (default value: size12)
   * @param     p_T_Reassembly
   * @param     p_ReestablishRLC    (default value: omit)
   * @param     p_NR_ConfiguredGrantType1Allowed (default value: omit)
   * @param     p_T_ReassemblyExt_r17    (default value: omit)
   * @return    template (value) NR_RLC_BearerToAddModList_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ReconfigureRLC_UM(DRB_Identity p_NR_DRB_Id,
                                  SN_FieldLengthUM p_DL_Len := size12,
                                  SN_FieldLengthUM p_UL_Len := size12,
                                  T_Reassembly p_T_Reassembly,
                                  template (omit) RLC_BearerConfig.reestablishRLC p_ReestablishRLC := omit, //@sic R5s230287 sic@
                                  template (omit) NR_ConfiguredGrantType1Allowed p_NR_ConfiguredGrantType1Allowed := omit,
                                  template (omit) T_ReassemblyExt_r17 p_T_ReassemblyExt_r17 := omit) runs on NR_BASE_PTC return template (value) NR_RLC_BearerToAddModList_Type
  {//@sic R5-256933 sic@ runs on NR_BASE_PTC
    var template (value) UL_UM_RLC v_UL_UM_RLC;
    var template (value) DL_UM_RLC v_DL_UM_RLC;
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;

    // Establishing UL UM RLC  parameters
    v_UL_UM_RLC.sn_FieldLength := p_UL_Len;

    // Establishing DL UM RLC  parameters
    v_DL_UM_RLC.sn_FieldLength := p_DL_Len;
    v_DL_UM_RLC.t_Reassembly := p_T_Reassembly;
    if (isvalue(p_T_ReassemblyExt_r17)){
      v_RLC_Config_v1700 := cs_RLC_Config_v1700_Def(-, p_T_ReassemblyExt_r17 );
    }
    // Configuration
    v_RLC_BearerConfigList[0] := cs_38508_RLC_BearerConfig_DRB (p_NR_DRB_Id,
                                                                cs_38508_RLC_Config_UM_DRB (v_UL_UM_RLC, v_DL_UM_RLC),
                                                                cs_38508_LogicalChannelConfig_DRB(-,-,-,-,p_NR_ConfiguredGrantType1Allowed),
                                                                p_ReestablishRLC,
                                                                v_RLC_Config_v1700);
    return v_RLC_BearerConfigList;
  }

  /*
   * @desc      comparison of time slot values which must be different
   * @param     p_T1
   * @param     p_T2
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SubFrameTiming_DifferentSlots(SubFrameTiming_Type p_T1,
                                              SubFrameTiming_Type p_T2) runs on NR_BASE_PTC
  {
    if (p_T1 == p_T2) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "2 PDU lists erroneously in the same time slot");
    }
  }

  /*
   * @desc      Return default PDCP PDU accouting for the SN size
   * @param     p_PDCP_SN
   * @param     p_PDCP_SDU
   * @param     p_RedCapLenghtExtendedPdcpSdu (default value: 2)
   * @return    template (value) NR_PDCP_PDU_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ReturnDefaultPDCP_PDU( integer  p_PDCP_SN,
                                       template (value) NR_PDCP_SDU_Type p_PDCP_SDU,
                                       integer  p_RedCapLenghtExtendedPdcpSdu := 2
                                     ) return template (value) NR_PDCP_PDU_Type
  {
    var template (value) NR_PDCP_PDU_Type v_NR_PDCP_PDU;
    var template (value) NR_PDCP_SDU_Type v_PDCP_SDU := p_PDCP_SDU;
    //@sic R5-246598 sic@
    if (f_NR_SupportOfRedCap() and f_GetTestcaseAttrib_RedCapAddBytesPdcpSdu(testcasename())) {
        //Applicable for RedCap and specific MAC test cases using MAC test mode
        //PDCP header is using SN=12bits instead of 18bits
        //RLC AM header is using SN=12bits instead of 18bits
        //Adding 1 (UM) or 2 (AM) bytes to the PDCP SDU
        select (p_RedCapLenghtExtendedPdcpSdu) {
            case (1) { v_PDCP_SDU := p_PDCP_SDU & tsc_RandomPRBS_1bytes;}  //UM
            case (2) { v_PDCP_SDU := p_PDCP_SDU & tsc_RandomPRBS_2bytes;}  //AM
            case else {  FatalError(__FILE__, __LINE__, "value of p_RedCapLenghtExtendedPdcpSdu not handled");}
        }
    }
    if ( f_GetTestcaseAttrib_ENDC(testcasename()) or not(f_NR_SupportOfRedCap())) { //@sic R5-246598 sic@
        v_NR_PDCP_PDU := cs_NR_PDCP_PDU_18B(p_PDCP_SN, v_PDCP_SDU);
    } else {
        v_NR_PDCP_PDU := cs_NR_PDCP_PDU_12B(p_PDCP_SN, v_PDCP_SDU);
    }
    return v_NR_PDCP_PDU;
  }

 group TestMode {

 template (value) NR_MAC_TestModeInfo_Type cs_NR_MAC_TestModeInfo(NR_MAC_Test_SCH_NoHeaderManipulation_Type p_NR_MAC_Test_SCH_NoHeaderManipulation) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    DiffLogChId := {
      ConfigLchId := true
    },
    No_HeaderManipulation := p_NR_MAC_Test_SCH_NoHeaderManipulation
  };

 template (value) NR_MAC_TestModeInfo_Type cs_NR_MAC_TestModeInfo_NormalMode                 := cs_NR_MAC_TestModeInfo(NormalMode);  /* @status    APPROVED (ENDC, NR5GC) */

 template (value) NR_MAC_TestModeInfo_Type cs_NR_MAC_TestModeInfo_NoHeaderManipulationDL_UL  := cs_NR_MAC_TestModeInfo(DL_UL_SCH);   /* @status    APPROVED (ENDC, NR5GC) */

 template (value) NR_MAC_TestModeInfo_Type cs_NR_MAC_TestModeInfo_NoHeaderManipulationDLOnly := cs_NR_MAC_TestModeInfo(DL_SCH_Only); /* @status    APPROVED (ENDC, NR5GC) */

 template (value) NR_RadioBearer_Type cs_NR_SS_RadioBearer_MAC_TestMode(DRB_Identity p_DrbId,
                                                                         template (value) NR_MAC_TestModeInfo_Type p_NR_MAC_TestModeInfo := cs_NR_MAC_TestModeInfo_NoHeaderManipulationDLOnly) :=
  /* @status    APPROVED (ENDC, NR5GC) */
  // later a 2nd parameter could be the SN size which is an ASN.1 item
  cs_NR_SS_RadioBearer_RlcBearer_TestMode(p_DrbId,  cs_NR_RLC_TestModeConfig_AM(f_NR_38508_SetSNFieldLengthAM()), cs_NR_MAC_TestModeConfig(p_NR_MAC_TestModeInfo));  //@sic R5-227518 sic@

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_L1_TestMode_DL_SCH_CRC_REQ(NR_CellId_Type p_NR_CellId,
                                                                        template (value) NR_MAC_Test_DL_SCH_CRC_Mode_Type p_NR_MAC_Test_DL_SCH_CRC_Mode:= Normal,
                                                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cas_NR_L1_TestMode_REQ(p_NR_CellId, p_TimingInfo, p_NR_MAC_Test_DL_SCH_CRC_Mode);

  template (value) NR_DL_SCH_CRC_Type cs_NR_DL_SCH_CRC_CRNTI(template (value) NR_MAC_Test_DL_SCH_CRC_Mode_Type p_NR_MAC_Test_DL_SCH_CRC_Mode) := { C_RNTI := p_NR_MAC_Test_DL_SCH_CRC_Mode };   /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_L1_TestMode_REQ(NR_CellId_Type p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                             template (value) NR_MAC_Test_DL_SCH_CRC_Mode_Type p_NR_MAC_Test_DL_SCH_CRC_Mode := Normal) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo),
    Request := {
      L1_TestMode := {
        DL_SCH_CRC := cs_NR_DL_SCH_CRC_CRNTI(p_NR_MAC_Test_DL_SCH_CRC_Mode)
      }
    }
  };

 } // end of group TestMode

 group HARQ {

   template (value) NR_HarqProcessConfig_Type cs_HarqProcessConfig(integer p_HarqProcess := 0) := {SpecificSubset := {p_HarqProcess}}; /* @status    APPROVED (ENDC, NR5GC) */

   template (value) NR_HarqProcessAssignment_Type  cs_NR_HarqProcessAssignment(integer p_HarqProcess := 0) := { Id := p_HarqProcess }; /* @status    APPROVED (ENDC, NR5GC) */

 } // end of group HARQ

 group MAC_PDU {

  template (value) NR_MAC_PDU_SubHeader_Type cs_NR_MAC_SubHeader(B6_Type p_LCID,
                                                                 template (value) B1_Type   p_Format := '0'B,
                                                                 template (omit) B8_16_Type  p_Length := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Reserved_or_LX   := '0'B,                                 /* Reserved bit set to 0 - @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    Format     := p_Format,                                   /* F:
                                                               * The Format field indicates the size of the Length field according to TS 38.321 clause 6.2.1: value 0 => 8 bits, value 1 => 16 bits.
                                                               * In case of MAC subheader for fixed sized MAC CE or padding (R/LCID MAC subheader) this field is reserved (i.e. treated as another R field) */
    LCID       := p_LCID,                                     /* LCID:
                                                                 Logical Channel ID field according to TS 38.321 Tables 6.2.1-1 and 6.2.1-2 */
    ELCID      := omit,                                        /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    Length     := p_Length
  };

  template (value) NR_MAC_PDU_SubHeader_Type cs_NR_MAC_SubHeader_LI8(B6_Type p_LCID,
                                                                     integer p_Length):=
  /* @status    APPROVED (ENDC, NR5GC) */
   cs_NR_MAC_SubHeader(p_LCID, -, int2bit(p_Length, 8));

   template (present) NR_MAC_PDU_SubHeader_Type cr_NR_MAC_SubHeader(B6_Type p_LCID) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Reserved_or_LX   := '0'B,                                 /* Reserved bit set to 0 - @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    Format     := '0'B,                                       /* F:
                                                               * The Format field indicates the size of the Length field according to TS 38.321 clause 6.2.1: value 0 => 8 bits, value 1 => 16 bits.
                                                               * In case of MAC subheader for fixed sized MAC CE or padding (R/LCID MAC subheader) this field is reserved (i.e. treated as another R field) */
    LCID       := p_LCID,                                     /* LCID:
                                                                 Logical Channel ID field according to TS 38.321 Tables 6.2.1-1 and 6.2.1-2 */
    ELCID      := omit,                                        /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    Length     := omit
  };

  template (present) NR_MAC_PDU_SubHeader_Type cr_NR_MAC_PaddingSubHeader := cr_NR_MAC_SubHeader(tsc_LCID_Padding);               /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_MAC_PDU_SubHeader_Type cr_NR_MAC_LongBSR_SubHeader(template (present) B8_16_Type  p_Length := '????????'B) := cr_NR_MAC_SubHeaderWithLI(tsc_LCID_LongBSR, p_Length);  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_MAC_SDU_SubPDU_Type cs_NR_MAC_SDU_SubPDU_LI8(B6_Type p_LCID,
                                                                   NR_MAC_SDU_Type p_SDU) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubHeader := cs_NR_MAC_SubHeader_LI8(p_LCID, lengthof(p_SDU)),
    SDU       := p_SDU
  };

  template (value) NR_MAC_PDU_SubHeader_Type cs_NR_MAC_PaddingSubHeader := cs_NR_MAC_SubHeader(tsc_LCID_Padding);                 /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_MAC_Padding_SubPDU_Type cs_NR_MAC_Padding_SubPDU(template (value) octetstring p_Padding := ''O) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubHeader  := cs_NR_MAC_PaddingSubHeader,
    Padding    := p_Padding
  };

 template (value) NR_MAC_PDU_Type cs_NR_DL_MAC_PDU(template (omit) NR_MAC_CE_SubPDU_DL_List_Type p_CE_SubPDUList,
                                                    template (omit) NR_MAC_SDU_SubPDU_List_Type   p_SDU_SubPDUList,
                                                    template (omit) NR_MAC_Padding_SubPDU_Type    p_Padding_SubPDU) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    DL := {
      CE_SubPDUList  := p_CE_SubPDUList,
      SDU_SubPDUList := p_SDU_SubPDUList,
      Padding_SubPDU := p_Padding_SubPDU
    }
  };

 template (value) NR_MAC_PDU_Type cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(template (value) NR_MAC_SDU_SubPDU_List_Type p_SDU_SubPDUList,
                                                                       template (omit) NR_MAC_Padding_SubPDU_Type p_Padding_SubPDU := omit) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_NR_DL_MAC_PDU(omit, p_SDU_SubPDUList, p_Padding_SubPDU);

  template (present) NR_MAC_PDU_Type cr_NR_UL_MAC_PDU(template  NR_MAC_SDU_SubPDU_List_Type   p_SDU_SubPDUList,
                                                      template  NR_MAC_CE_SubPDU_UL_List_Type p_CE_SubPDUList := *,
                                                      template  NR_MAC_Padding_SubPDU_Type    p_Padding_SubPDU := *) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    UL  := {
      SDU_SubPDUList := p_SDU_SubPDUList,
      CE_SubPDUList  := p_CE_SubPDUList,
      Padding_SubPDU := p_Padding_SubPDU
    }
  };

  template (present)  NR_MAC_SDU_SubPDU_Type cr_NR_MAC_SDU_SubPDU(template (present) NR_MAC_PDU_SubHeader_Type p_SubHeader,
                                                                  template (present) NR_MAC_SDU_Type p_SDU):=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubHeader := p_SubHeader,
    SDU := p_SDU
  };

  template (present) NR_MAC_CE_SubPDU_UL_Type cr_NR_MAC_CE_SubPDU_UL(template (present) NR_MAC_PDU_SubHeader_Type p_SubHeader,
                                                                     template NR_MAC_ControlElementUL_Type p_ControlElement := omit) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubHeader   := p_SubHeader,
    ControlElement  := p_ControlElement  /* omit if MAC CE has fixed size of zero bits */
  };

  template (present) NR_MAC_Padding_SubPDU_Type cr_NR_MAC_Padding_SubPDU (template (present) octetstring p_Padding := ''O) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SubHeader  := cr_NR_MAC_PaddingSubHeader,
    Padding    := p_Padding
  };

  template (value) NR_PDCP_SDU_Type crs_NR_PDCP_SDU_36B   := f_GetN_OctetsFromPRBS(20, 36);       /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_MAC_PDU_SubHeader_Type cr_NR_MAC_SubHeaderWithLI(template (present) B6_Type p_LCID,
                                                                         template (present) B8_16_Type  p_Length := '????????'B,
                                                                         template  B1_Type p_Format := '0'B) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Reserved_or_LX   := '0'B,                                       /* Reserved bit set to 0 - @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
    Format     := p_Format,                                   /* F:
                                                               * The Format field indicates the size of the Length field according to TS 38.321 clause 6.2.1: value 0 => 8 bits, value 1 => 16 bits.
                                                               * In case of MAC subheader for fixed sized MAC CE or padding (R/LCID MAC subheader) this field is reserved (i.e. treated as another R field) */
    LCID       := p_LCID,                                     /* LCID:
                                                                 Logical Channel ID field according to TS 38.321 Tables 6.2.1-1 and 6.2.1-2 */
    ELCID      := omit,                                        /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    Length     := p_Length
  };

 } // end of group MAC_PDU

 template (value) DRX_Config.drx_onDurationTimer cs_NR_DRX_OnDurationTimerMs20 := { milliSeconds := ms20 }; /* @status    APPROVED (ENDC, NR5GC) */

 template (value) DRX_Config.drx_onDurationTimer cs_NR_DRX_OnDurationTimerMs40 := { milliSeconds := ms40 }; /* @status    APPROVED (ENDC, NR5GC)@sic R5s200924 sic@ */

  /*
   * @desc      encode NR RLC PDU
   * @param     p_RLC_PDU
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_PDU_Encvalue(template (value) NR_RLC_PDU_Type p_RLC_PDU) return octetstring
  {
    var bitstring v_Bitstring := encvalue(p_RLC_PDU);
    var octetstring v_Octetstring := bit2oct(f_OctetAlignedBitString(v_Bitstring));
    return v_Octetstring;
  }

  /*
   * @desc      encode NR RLC data PDU with one RLC SDU
   * @param     p_SN
   * @param     p_Poll
   * @param     p_RLC_SDU
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_AMD_FullPDU_Encvalue(integer p_SN,
                                         B1_Type p_Poll,
                                         octetstring p_RLC_SDU) return octetstring
  {
    var template (value) NR_RLC_PDU_Type v_RLC_PDU;
    if (f_NR_SupportOfRedCap()) {  //@sic R5-227518 R5-246598 sic@
        v_RLC_PDU := cs_NR_RLC_PDU_AMD(cs_NR_RLC_AMD_PDU_SN12Bit(cs_NR_RLC_AMD_PduSN12Bit(p_SN, p_Poll, -, -, p_RLC_SDU)));
    } else {
        v_RLC_PDU := cs_NR_RLC_PDU_AMD(cs_NR_RLC_AMD_PDU_SN18Bit(cs_NR_RLC_AMD_PduSN18Bit(p_SN, p_Poll, -, -, p_RLC_SDU)));
    }
    return f_NR_RLC_PDU_Encvalue(v_RLC_PDU);
  }

  /*
   * @desc      Returns next subframe to be available according to DRX parameters on 7.1.1.5.x tests
   *            needed when a test case sends an invalid MAC PDU
   * @param     p_NR_CellId
   * @param     p_DrxCycle
   * @param     p_DrxStartOffset
   * @param     p_CountY            (default value: 0)
   * @param     p_DrxCycleOffset    (default value: 0)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetNextSendOccasion_7_1_1_5_X(NR_CellId_Type p_NR_CellId,
                                              integer p_DrxCycle,
                                              integer p_DrxStartOffset,
                                              integer p_CountY :=0, // in slots
                                              //@sic R5s221086 sic@
                                              integer p_DrxCycleOffset := 0 // Additional DRX cycles to be added to timing over and above 2
                                              ) runs on NR_BASE_PTC return SubFrameTiming_Type
  { // Function does not consider drx-SlotOffset as it is always set to 0 in all 7.1.1.5.x test cases
    var SubFrameTiming_Type v_SubFrameInfo := f_NR_GetCurrentTiming(p_NR_CellId);
    var integer v_SlotsInSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(p_NR_CellId) ;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var integer v_DRXnumberofSubframe;
    var integer v_DrxNumberofCycle;
    var integer v_SubframeNumber;
    var integer v_FrameNumber;
    var integer v_HSFN;
    var SubFrameTiming_Type v_Timing;
    var template (value) SlotTimingInfo_Type v_SlotTimingInfo;
    select (v_SCS){
        case (kHz15) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology0;}
        case (kHz30) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology1(p_CountY mod v_SlotsInSubframe);}
        case (kHz60) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology2(p_CountY mod v_SlotsInSubframe); }
        case (kHz120){v_SlotTimingInfo := cs_SlotTimingInfo_Numerology3(p_CountY mod v_SlotsInSubframe); }
        case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSpacing");}
    }

    //  2 cycles ahead is selected to provide enough time for SS
    v_DrxNumberofCycle := (v_SubFrameInfo.SFN.Number * 10 + v_SubFrameInfo.Subframe.Number + (p_CountY / v_SlotsInSubframe))/p_DrxCycle;
    //  2 cycles ahead is selected to provide enough time for SS
    v_DRXnumberofSubframe := p_DrxCycle * (v_DrxNumberofCycle + 2 + p_DrxCycleOffset) + p_DrxStartOffset;
    v_SubframeNumber := v_DRXnumberofSubframe mod 10 ;
    v_FrameNumber := v_DRXnumberofSubframe / 10;
    v_HSFN := (v_SubFrameInfo.HSFN.Number + (v_FrameNumber / 1024)) mod 1024;
    v_FrameNumber := (v_FrameNumber) mod 1024;

    v_Timing := valueof(cs_SubFrameTiming(v_FrameNumber, v_SubframeNumber, v_HSFN));
    v_Timing.Slot := valueof(v_SlotTimingInfo);
    return v_Timing;

  };

  /*
   * @desc      Transmission of a STATUS MAC PDU with sub PDU List
   * @param     p_LchId
   * @param     p_SN
   * @param     p_NR_DRB_Id
   * @param     p_NR_CellId         (default value: nr_Cell1)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_MacBearerRoutingCA (default value: omit)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_RLC_Status_MAC_PDU_Tx(B6_Type p_LchId,
                                      integer p_SN,
                                      DRB_Identity p_NR_DRB_Id,
                                      NR_CellId_Type p_NR_CellId := nr_Cell1,
                                      template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now, //@sic R5-221467 - R5w220022 sic@
                                      template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) runs on NR_BASE_PTC
  {
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(p_LchId, f_NR_RLC_AMD_StatusPDU_Encvalue(p_SN)) };
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };

    // Size made 40 bits 3 Byte RLC Status PDU and 2 Byte MAC Header
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(p_NR_CellId, p_NR_DRB_Id,  p_TimingInfo, v_MAC_PDUListDL,-,-, p_MacBearerRoutingCA));
  }

  /*
   * @desc      encode NR RLC status PDU with one RLC SDU
   * @param     p_ACK_SN
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_AMD_StatusPDU_Encvalue(integer p_ACK_SN) return octetstring
  {
    var template (value) NR_RLC_PDU_Type v_RLC_PDU;
    if (f_NR_SupportOfRedCap()) {  //@sic R5-227518 R5-246598 sic@
        v_RLC_PDU := cs_NR_RLC_PDU_Status(cs_NR_RLC_StatusPDU_SN12Bit(cs_NR_RLC_StatusPduSN12Bit(p_ACK_SN)));
    } else {
        v_RLC_PDU := cs_NR_RLC_PDU_Status(cs_NR_RLC_StatusPDU_SN18Bit(cs_NR_RLC_StatusPduSN18Bit(p_ACK_SN)));
    }
    return f_NR_RLC_PDU_Encvalue(v_RLC_PDU);
  }

  /*
   * @desc      Sets Slot Offset K1 acc. to 38.211 Table 4.3.2-1
   * @param     p_NR_CellId
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetSlotOffsetK1(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return integer
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
     var integer v_NR_SlotOffsetK1 := 5;

    select (v_SCS) { //Acc to 38.211 Table 4.3.2-1
      case(kHz15)  { v_NR_SlotOffsetK1 := 7; }
      case(kHz30)  { v_NR_SlotOffsetK1 := 5; }
      case(kHz120) { v_NR_SlotOffsetK1 := 8; }
      case else    { FatalError(__FILE__, __LINE__, "Invalid SubcarrierSpacing"); }
    }
    return v_NR_SlotOffsetK1;
  }

  /*
   * @desc    This function returns SubFrameTiming of the Next valid DL slot start after input Timing
   * @param     p_NR_CellId
   * @param     p_TimingInfo
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_NextDL_Slot( NR_CellId_Type p_NR_CellId,
                                SubFrameTiming_Type p_TimingInfo) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
      // K1 = 7,5,8 for TDD SCS15, SCS30, SCS120
    var integer v_LastSlot:= 0;
    var NR_DuplexMode_Type v_NR_DuplexMode := f_NR_CellInfo_GetDuplexMode(p_NR_CellId);
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var integer v_SlotsInSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(nr_Cell1) ;
    var integer v_Dl_UL_TransPeriodicity :=5;
    var integer v_MinSlot := 0;
    var integer v_MaxSlot := 5;
    var integer v_Slot := 0;
    var SubFrameTiming_Type v_TimingInfo := f_NR_SubFrameTiming_AddSlots( p_TimingInfo, 1);
    
    if (ischosen(v_NR_DuplexMode.TDD))
    {
      select (v_SCS) {
          case (kHz15) {
            // K1 = 7, DDDFU-DDDFU, valid DL slot 1,2,6,7
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number;
            v_TimingInfo.Subframe.Number := 0;
            v_MinSlot := 1;
            v_MaxSlot := 2;
          }
          case (kHz30) {
            // K1 = 5, DD, DD,DD,DF,UU-DD,DD,IDD,DF,UU, valid DL slot 2,3,4,12,13,14
            v_Dl_UL_TransPeriodicity := 10;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology1;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology1 := 0;
            v_MinSlot := 2;
            v_MaxSlot := 4;
          }
          case (kHz120) {
            // K1 = 8, DDDFU DDDFU, ...., valid DL slot 0,5,10,...,75
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology3;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology3 := 0;
            v_MinSlot := 0;
            v_MaxSlot := 0;
          }
          case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing");}
      }
      
      v_LastSlot := v_Slot mod v_Dl_UL_TransPeriodicity;
      if (v_LastSlot > v_MaxSlot)
      {
        v_LastSlot := v_Slot - v_LastSlot + v_MinSlot + v_Dl_UL_TransPeriodicity;
      }
      else
      {
        if (v_LastSlot < v_MinSlot)
        {
          v_LastSlot := v_Slot - v_LastSlot + v_MinSlot;
        }
        else{
          v_LastSlot := v_Slot;
        }
      }
      v_TimingInfo := f_NR_SubFrameTiming_AddSlots( v_TimingInfo, v_LastSlot);
    }
    // for FDD, any slot is valid
    return v_TimingInfo;
  }

  /*
   * @desc    This function returns SubFrameTiming of the last valid PDCCH slot for scheduling UL slot up to the input SubFrameTiming
   * @param     p_NR_CellId
   * @param     p_TimingInfo
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_LastUL_Slot( NR_CellId_Type p_NR_CellId,
                                SubFrameTiming_Type p_TimingInfo) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var integer v_LastSlot:= 0;
    var NR_DuplexMode_Type v_NR_DuplexMode := f_NR_CellInfo_GetDuplexMode(p_NR_CellId);
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var integer v_SlotsInSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(nr_Cell1) ;
    var integer v_SlotsInframe := v_SlotsInSubframe * 10;
    var integer v_Dl_UL_TransPeriodicity :=5;
    var integer v_MinSlot := 0;
    var integer v_MaxSlot := 5;
    var integer v_Slot := 0;
    var SubFrameTiming_Type v_TimingInfo := p_TimingInfo;
    
    if (ischosen(v_NR_DuplexMode.TDD))
    {
      select (v_SCS) {
          case (kHz15) {
            // K2 = 4, DDDFU-DDDFU, valid PDCCH slot 0, 5
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number;
            v_TimingInfo.Subframe.Number := 0;
            v_MinSlot := 0;
            v_MaxSlot := 0;
          }
          case (kHz30) {
            // K2 = 4, DD, DD,DD,DF,UU-DD,DD,IDD,DF,UU, valid PDCCH slot 4,5,14,15
            v_Dl_UL_TransPeriodicity := 10;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology1;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology1 := 0;
            v_MinSlot := 4;
            v_MaxSlot := 5;
          }
          case (kHz120) {
            // K2 = 4, DDDFU DDDFU, ...., valid DL slot 0,5,10,...,75
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology3;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology3 := 0;
            v_MinSlot := 0;
            v_MaxSlot := 0;
          }
          case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing");}
      }
      
      v_LastSlot := v_Slot mod v_Dl_UL_TransPeriodicity;
      if (v_LastSlot > v_MaxSlot)
      {
        v_LastSlot := v_Slot - (v_LastSlot - v_MaxSlot);
      }
      else
      {
        if (v_LastSlot < v_MinSlot)
        {
          v_LastSlot := v_Slot - (v_LastSlot + v_Dl_UL_TransPeriodicity - v_MaxSlot);
        }
        else{
          v_LastSlot := v_Slot;
        }
      }
      
      if (v_LastSlot < 0 )
      { // LastSlot is in previous Frame
        v_LastSlot := v_LastSlot + v_SlotsInframe;
        v_TimingInfo.SFN.Number := (v_TimingInfo.SFN.Number + 1023) mod 1024;
        if (v_TimingInfo.SFN.Number > 1022)
        {
          v_TimingInfo.HSFN.Number := (v_TimingInfo.HSFN.Number + 1023) mod 1024;
        }
      }
      
      v_TimingInfo := f_NR_SubFrameTiming_AddSlots( v_TimingInfo, v_LastSlot);
    }
    // for FDD, any slot is valid
    return v_TimingInfo;
  }

}
