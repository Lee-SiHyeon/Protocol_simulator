module MCX_XML_GroupConfiguration_MCVideo {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_GroupConfiguration_Common all;
  import from MCX_XML_common_policy all;
  import from XSD all;
  import from urn_3gpp_ns_mcpttGroupInfo_1_0 language "XSD" all;        
  import from urn_ietf_params_xml_ns_common_policy language "XSD" all;  
  import from urn_oma_xml_xdm_extensions language "XSD" all;            

  /*
   * @desc      Build entry for MCVideo Group Member List
   * @param     p_URI
   * @param     p_UserPriority
   * @param     p_ParticipantType
   * @return    template (value) MCX_ResourceLists_EntryType_Type
   * @status    APPROVED (MCX)
   */
  function f_MCVideo_GroupMemberListEntryTX(XSD.AnyURI p_URI,
                                            urn_3gpp_ns_mcpttGroupInfo_1_0.User_priority p_UserPriority,
                                            urn_3gpp_ns_mcpttGroupInfo_1_0.Participant_type p_ParticipantType) return template (value) MCX_ResourceLists_EntryType_Type
  {
    var template (value) urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_mcvideo_id v_Mcvideo_mcvideo_id := cs_MCX_ResourceLists_Entry(p_URI);
    
    var MCX_ResourceLists_EntryType_Type.elem_list v_AdditionalExtensions := {
      f_Bit2XsdString(encvalue(v_Mcvideo_mcvideo_id))
    };
    return f_MCX_GroupMemberListEntryTX_Common(p_URI, p_UserPriority, p_ParticipantType, v_AdditionalExtensions);
  }

  /*
   * @desc      Setup MCVideo Group Ruleset for MCVideo Group Configuration
   * @param     p_Id                (default value: "rule1")
   * @return    template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
   * @status    APPROVED (MCX)
   */
  function f_MCVideo_GroupRuleset(XSD.ID p_Id := "rule1") return template (value) urn_ietf_params_xml_ns_common_policy.Ruleset
  { /* cp:ruleset for "rule1" according to Table 5.5.7.2-1: MCVideo Group Configuration Defaults */
    var urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_allow_getting_member_list               v_On_network_allow_getting_member_list := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_allow_emergency_call                       v_Mcvideo_allow_emergency_call := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_allow_emergency_alert                      v_Mcvideo_allow_emergency_alert := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_allow_imminent_peril_call                  v_Mcvideo_allow_imminent_peril_call := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_allow_conference_state          v_Mcvideo_on_network_allow_conference_state := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_allow_getting_affiliation_list  v_Mcvideo_on_network_allow_getting_affiliation_list := true;
    var template (value) ExtensibleType v_Actions;
    var template (value) CP_Rule_Type v_Rule;

    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_On_network_allow_getting_member_list)),
        f_Bit2XsdString(encvalue(v_Mcvideo_allow_emergency_call)),
        f_Bit2XsdString(encvalue(v_Mcvideo_allow_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Mcvideo_allow_imminent_peril_call)),
        f_Bit2XsdString(encvalue(v_Mcvideo_on_network_allow_conference_state)),
        f_Bit2XsdString(encvalue(v_Mcvideo_on_network_allow_getting_affiliation_list))
      }
    };
    v_Rule := cs_MCX_CP_Rule(p_Id, v_Actions);
    
    return cs_MCX_CP_Ruleset(v_Rule);
  }

  /*
   * @desc      Setup MCVideo Group Extensions for MCVideo Group Configuration
   * @param     p_Owner
   * @param     p_Off_network_ProSe_layer_2_group_id
   * @return    MCX_PocListService_ListService_Type.elem_list
   * @status    APPROVED (MCX)
   */
  function f_MCVideo_Group_Extensions_mcpttgi(urn_3gpp_ns_mcpttGroupInfo_1_0.Owner p_Owner,
                                              urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_layer_2_group_id p_Off_network_ProSe_layer_2_group_id) return MCX_PocListService_ListService_Type.elem_list
  {
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_group_hierarchy v_Level_within_group_hierarchy := 0;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Level_within_user_hierarchy v_Level_within_user_hierarchy := 0;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_IP_multicast_address                                            v_Off_network_IP_multicast_address := "0.0.0.0";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Off_network_ProSe_relay_service_code                                        v_Off_network_ProSe_relay_service_code := char2oct("123456");
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_invite_members                                           v_Mcvideo_on_network_invite_members := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_maximum_duration                                         v_Mcvideo_on_network_maximum_duration := "PT30M";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_urgent_real_time_video_mode                                         v_Mcvideo_urgent_real_time_video_mode := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_non_urgent_real_time_video_mode                                     v_Mcvideo_non_urgent_real_time_video_mode := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_non_real_time_video_mode                                            v_Mcvideo_non_real_time_video_mode := true;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_active_real_time_video_mode                                         v_Mcvideo_active_real_time_video_mode := "non-urgent-real-time";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_maximum_simultaneous_mcvideo_transmitting_group_members             v_Mcvideo_maximum_simultaneous_mcvideo_transmitting_group_members := 1;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_minimum_number_to_start                                  v_Mcvideo_on_network_minimum_number_to_start := 1;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_on_network_group_priority                                           v_Mcvideo_on_network_group_priority := 1;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_arbitration_approach                                    v_Mcvideo_off_network_arbitration_approach := "self";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_maximum_simultaneous_transmissions                      v_Mcvideo_off_network_maximum_simultaneous_transmissions := 1;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_signalling_PPPP                                   v_Mcvideo_off_network_ProSe_signalling_PPPP := '01'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_emergency_call_signalling_PPPP                    v_Mcvideo_off_network_ProSe_emergency_call_signalling_PPPP := '10'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_imminent_peril_call_signalling_PPPP               v_Mcvideo_off_network_ProSe_imminent_peril_call_signalling_PPPP := '07'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_media_PPPP                                        v_Mcvideo_off_network_ProSe_media_PPPP := '01'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_emergency_call_media_PPPP                         v_Mcvideo_off_network_ProSe_emergency_call_media_PPPP := '10'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_ProSe_imminent_peril_call_media_PPPP                    v_Mcvideo_off_network_ProSe_imminent_peril_call_media_PPPP := '07'O;
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_maximum_duration                                        v_Mcvideo_off_network_maximum_duration := "PT1M";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_in_progress_emergency_state_cancellation_timeout        v_Mcvideo_off_network_in_progress_emergency_state_cancellation_timeout := "PT18H12M15S";
    var urn_3gpp_ns_mcpttGroupInfo_1_0.Mcvideo_off_network_in_progress_imminent_peril_state_cancellation_timeout   v_Mcvideo_off_network_in_progress_imminent_peril_state_cancellation_timeout := "PT18H12M15S";
    var MCX_PocListService_ListService_Type.elem_list v_Extension;
    
    v_Extension := {
      f_Bit2XsdString(encvalue(p_Off_network_ProSe_layer_2_group_id)),
      f_Bit2XsdString(encvalue(v_Off_network_IP_multicast_address)),
      f_Bit2XsdString(encvalue(v_Off_network_ProSe_relay_service_code)),
      f_Bit2XsdString(encvalue(p_Owner)),
      f_Bit2XsdString(encvalue(v_Level_within_group_hierarchy)),
      f_Bit2XsdString(encvalue(v_Level_within_user_hierarchy)),
      f_Bit2XsdString(encvalue(v_Mcvideo_on_network_invite_members)),
      f_Bit2XsdString(encvalue(v_Mcvideo_on_network_maximum_duration)),
      f_Bit2XsdString(encvalue(v_Mcvideo_urgent_real_time_video_mode)),
      f_Bit2XsdString(encvalue(v_Mcvideo_non_urgent_real_time_video_mode)),
      f_Bit2XsdString(encvalue(v_Mcvideo_non_real_time_video_mode)),
      f_Bit2XsdString(encvalue(v_Mcvideo_active_real_time_video_mode)),
      f_Bit2XsdString(encvalue(v_Mcvideo_maximum_simultaneous_mcvideo_transmitting_group_members)),
      f_Bit2XsdString(encvalue(v_Mcvideo_on_network_minimum_number_to_start)),
      f_Bit2XsdString(encvalue(v_Mcvideo_on_network_group_priority)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_arbitration_approach)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_maximum_simultaneous_transmissions)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_emergency_call_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_imminent_peril_call_signalling_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_emergency_call_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_ProSe_imminent_peril_call_media_PPPP)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_maximum_duration)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_in_progress_emergency_state_cancellation_timeout)),
      f_Bit2XsdString(encvalue(v_Mcvideo_off_network_in_progress_imminent_peril_state_cancellation_timeout))
    };
    return v_Extension;
  }

  /*
   * @desc      36.579-1 Table 5.5.7.2-1: MCVideo Group Configuration Defaults
   * @param     p_Regrouped         (default value: omit)
   * @return    template (value) MCX_PocListService_Group_Type
   * @status    APPROVED (MCX)
   */
  function f_MCVideo_GroupConfiguration(template (omit) urn_3gpp_ns_mcpttGroupInfo_1_0.On_network_regrouped p_Regrouped := omit) return template (value) MCX_PocListService_Group_Type
  {
    var template (value) MCX_PocListService_Group_Type.sequence_list v_GroupList;
    var template (value) MCX_PocListService_ListService_Type v_Group1;
    var template (value) MCX_PocListService_List_Type.entry_list v_GroupMemberList;
    var template (omit)  XSD.NonNegativeInteger v_MaxParticipants := omit;      // not present in Table 5.5.7.2-1
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryA := f_MCVideo_GroupMemberListEntryTX(px_MCVideo_ID_User_A, tsc_MCX_User_A_Priority, px_MCX_User_A_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryB := f_MCVideo_GroupMemberListEntryTX(px_MCVideo_ID_User_B, tsc_MCX_User_B_Priority, px_MCX_User_B_ParticipantType);
    var template (value) MCX_ResourceLists_EntryType_Type v_GroupMemberListEntryC := f_MCVideo_GroupMemberListEntryTX(px_MCVideo_ID_User_C, tsc_MCX_User_C_Priority, px_MCX_User_C_ParticipantType);
    var template (value) urn_oma_xml_xdm_extensions.Supported_services v_SupportedServices := f_MCX_ListServiceExtensions_SupportedService(MCVideo);
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_GroupRuleset;
    var MCX_PocListService_ListService_Type.elem_list v_Extensions := {};

    v_GroupMemberList := {
      v_GroupMemberListEntryA,
      v_GroupMemberListEntryB,
      v_GroupMemberListEntryC
    };
    
    v_GroupRuleset := f_MCVideo_GroupRuleset();

    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_GroupRuleset)));
    v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,    f_Bit2XsdString(encvalue(v_SupportedServices)));
    v_Extensions := f_MCX_GroupExtensions_Concat(v_Extensions, f_MCVideo_Group_Extensions_mcpttgi(px_MCX_Group_A_Owner_Organization, tsc_MCX_Group_A_ProSeLayer2GroupID));
    if (isvalue(p_Regrouped)) {
      v_Extensions := f_MCX_GroupExtensions_Add(v_Extensions,  f_Bit2XsdString(encvalue(valueof(p_Regrouped))));
    }

    v_Group1 := cs_MCX_PocListService_ListService(px_MCVideo_Group_A_ID,
                                                  cs_MCX_ResourceLists_DisplayName(-, px_MCVideo_Group_A_Name),
                                                  cs_MCX_PocListService_List(v_GroupMemberList),
                                                  v_MaxParticipants,
                                                  v_Extensions);
    v_GroupList := {
      { list_service := v_Group1 }
    };
    
    return cs_MCX_PocListService_Group(v_GroupList);
  }

}
