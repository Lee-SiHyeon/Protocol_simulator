  template (value) NR_DciFormat_0_X_TransformPrecoderIndicator_Type cs_NR_DciFormat_0_X_TransformPrecoderIndicator_None := {None := true }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  /*
   * @desc      Returns PUSCH_Config TransformPrecoder IE
   * @param     p_TransformPrecoder
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_PUSCH_TransformPrecoderEnabled(template (omit) PUSCH_Config.transformPrecoder p_TransformPrecoder) return boolean
  {
    return ispresent(p_TransformPrecoder);
  }

  /*
   * @desc      return antenna port configuration for DCI format 0_1 depending on transform precoder being enabled or disabled
   * @param     p_TransformPrecoder
   * @param     p_PortNumber        (default value: 0)
   * @return    template (value) NR_DciFormat_0_X_AntennaPorts_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR__DciFormat_0_X_AntennaPorts(template (omit) PUSCH_Config.transformPrecoder p_TransformPrecoder,
                                             integer p_PortNumber := 0) return template (value) NR_DciFormat_0_X_AntennaPorts_Type
  {
    if (not fl_NR_PUSCH_TransformPrecoderEnabled(p_TransformPrecoder)) {
      return cs_NR_DciFormat_0_1_AntennaPorts(int2bit(p_PortNumber, 3));    // 3 bits when transform precoder is disabled
    } else {
      return cs_NR_DciFormat_0_1_AntennaPorts(int2bit(p_PortNumber, 2));    // 2 bits when transform precoder is enabled and DMRS type 1 with len1
    }
  }

  /*
   * @desc      return DMRS sequence initialization for DCI format 0_1 depending on transform precoder being enabled or disabled
   * @param     p_TransformPrecoder
   * @return    template (value) NR_DciCommon_DmrsSequenceInit_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR__DciFormat_0_1_DmrsSequenceInit(template (omit) PUSCH_Config.transformPrecoder p_TransformPrecoder) return template (value) NR_DciCommon_DmrsSequenceInit_Type
  {
    if (not fl_NR_PUSCH_TransformPrecoderEnabled(p_TransformPrecoder)) {
      return cs_NR_DciFormat_X_1_DmrsSequenceInit_Value('0'B);
    } else {
      return cs_NR_DciFormat_X_1_DmrsSequenceInit_None;
    }
  }

  template (value) NR_DciFormat_0_X_SpecificInfo_Type cs_NR_DciFormat_0_1_Params(template (omit) PUSCH_Config.transformPrecoder p_TransformPrecoder := omit, //@sic 711313 sic@
                                                                                 template (omit) NR_DciCommon_PriorityIndicator_Type  p_NR_DciCommon_PriorityIndicator := cs_NR_DciFormat_PriorityIndicator_None,
                                                                                 template (omit) NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type p_NR_DciFormat_0_X_ChannelAccessCPextCAPC:= cs_NR_DciFormat_0_X_ChannelAccessCPextCAPC_None) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    /* 38.508-1 Table 4.3.6.1.1.2-1 and 38.212 clause 7.3.1.1.2 */
    Format_0_1 := {
      CarrierIndicator := cs_NR_DciCommon_CarrierIndicator_None,                        /* not present (no cross carrier scheduling):
                                                                                           ServingCellConfig.crossCarrierSchedulingConfig not present or
                                                                                           ServingCellConfig.crossCarrierSchedulingConfig.schedulingCellInfo.own.cif-Presence == false */
      DfiFlag := cs_NR_DciFormat_0_1_DfiFlag_None,                                      /* DFI flag         @sic R5s201387 BASELINE MOVING 2020 sic@ */
      BWPIndicator := cs_NR_DciCommon_BWPIndicator_SingleBWP,                           /* BWPIndicator not present as per default there is only one single BWP is configuered (initial BWP only) */
      TransportBlock2Scheduling := cs_NR_DciFormat_0_1_TransportBlock2RetransmissionList_None, /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      TransformPrecoderIndicator := cs_NR_DciFormat_0_X_TransformPrecoderIndicator_None,       /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      FirstDAI := cs_NR_DciFormat_0_X_FirstDAI_Automatic,                               /* Automatic - depends on test parameters
                                                                                           @sic R5-202677 R5-201572 sic@*/
      SecondDAI := cs_NR_DciFormat_0_X_SecondDAI_None,                                  /* not present as for semi-static HARQ-ACK codebook configuration (-> PhysicalCellGroupConfig.pdsch-HARQ-ACK-Codebook) */
      ThirdDAI := cs_NR_DciFormat_0_X_ThirtdDAI_None,                                   /* 3rd downlink assignment index @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      SecondTpcCommandPusch := cs_NR_DciCommon_SecondTpcCommand_None,                   /* Second TPC command for scheduled PUSCH @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      SrsResourceSetIndicator := cs_NR_DciFormat_0_X_SrsResourceSetIndicator_None,      /* SRS resource set indicator @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      SrsResourceIndicator := cs_NR_DciFormat_0_X_SrsResourceIndicator_CodeBook(''B),   /* not present (0 bits); PUSCH-Config.txConfig==codebook and only one configured SRS resourcee with usage==codebook in SRS-Config */
      SecondSrsResourceIndicator := cs_NR_DciFormat_0_X_SecondSrsResourceIndicator_None,/* Second SRS resource indicator @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      PrecodingInfo := cs_NR_DciFormat_0_X_PrecodingInfo_CodeBook(''B),                 /* not present (0 bits); txConfig==CodeBook but one antenna port only */
      SecondPrecodingInfo := cs_NR_DciFormat_0_X_SecondPrecodingInfo_None,              /* Second Precoding information  */
      AntennaPorts := fl_NR__DciFormat_0_X_AntennaPorts(p_TransformPrecoder, 0),        /* 3 bits for PUSCH_Config.transformPrecoder==omit (38.508-1 Table 4.6.3-118)
                                                                                           2 bits for PUSCH_Config.transformPrecoder==enabled (38.508-1 Table 4.6.3-118),
                                                                                           DMRS-UplinkConfig.dmrs-Type==1, DMRS-UplinkConfig.maxLength==1 (Table 4.6.3-51),
                                                                                           => 38.212 Table 7.3.1.1.2-6: 2 DMRS CDM groups without data; index corresponds to DMRS port */
      SrsRequest := cs_NR_DciFormat_X_1_SrsRequest_SingleUL('00'B),                     /* 2 bits (no SUL per default); No aperiodic SRS resource set triggered (38.212 Table 7.3.1.1.2-24)  */
      SrsOffsetIndicator := cs_NR_DciCommon_SrsOffsetIndicator_None,                    /* SRS offset indicator @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      CsiRequest := cs_NR_DciFormat_0_X_CsiRequest(''B),                                /* not present (0 bits); given by CSI-MeasConfig.reportTriggerSize being 0 per default */
      CBGTI := cs_NR_DciFormat_0_1_CBGTI(''B),                                          /* not present (0 bits): PUSCH-ServingCellConfig.codeBlockGroupTransmission is not configured */
      PtrsDmrsAssociation := cs_NR_DciFormat_0_X_PtrsDmrsAssociation_None,              /* not present for DMRS-UplinkConfig.phaseTrackingRS not being present */
      SecondPtrsDmrsAssociation := cs_NR_DciFormat_0_X_SecondPtrsDmrsAssociation_None,  /* Second PTRS-DMRS association @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      BetaOffsetIndicator := cs_NR_DciFormat_0_X_BetaOffsetIndicator_None,              /* not present for UCI-OnPUSCH.betaOffsets indicating "semiStatic" */
      DmrsSequenceInit := fl_NR__DciFormat_0_1_DmrsSequenceInit(p_TransformPrecoder),   /* not present for transform precoder being enabled (PUSCH_Config.transformPrecoder==enabled; 38.508-1 Table 4.6.3-118)
                                                                                           1 bit for transform precoder being disabled */
      UlschIndicator := cs_NR_DciFormat_0_X_UlschIndicator('1'B),                       /* 1 bit: '1'B for UL-SCH transmitted on the PUSCH */
      ChannelAccessCPextCAPC := p_NR_DciFormat_0_X_ChannelAccessCPextCAPC,              /* ChannelAccess-CPext-CAPC @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@, SharedSpectrum */
      OpenLoopPowerControl := cs_NR_DciFormat_0_X_OpenLoopPowerControl_None,            /* Open-loop power control parameter set indication */
      PriorityIndicator := p_NR_DciCommon_PriorityIndicator,                            /* Priority indicator     @sic R5s201387 BASELINE MOVING 2020 sic@ */
      InvalidSymbolPatternIndicator := cs_NR_DciFormat_0_X_InvalidSymbolPatternIndicator_None,          /* Invalid symbol pattern indicator     @sic R5s201387 BASELINE MOVING 2020 sic@ */
      MinimumApplicableSchedulingOffset := cs_NR_DciFormat_X_1_MinimumApplicableSchedulingOffset_None,  /* Minimum applicable scheduling offset indicator     @sic R5s201387 BASELINE MOVING 2020 sic@*/
      SCellDormancyIndication := cs_NR_DciFormat_X_1_SCellDormancyIndication_None,                      /* SCell dormancy indication     @sic R5s201387 BASELINE MOVING 2020 sic@ */
      SidelinkAssignmentIndex := cs_NR_DciFormat_0_1_SidelinkAssignmentIndex_None,                      /* Sidelink assignment index     @sic R5s201387 BASELINE MOVING 2020 sic@ */
      PdcchMonitoringAdaptationIndication := cs_NR_DciCommon_PdcchMonitoringAdaptationIndication_None   /* PDCCH monitoring adaptation indication @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    }
  };

  template (value) NR_DciFormat_0_X_SpecificInfo_Type cs_NR_DciFormat_0_1_AllOmit :=
