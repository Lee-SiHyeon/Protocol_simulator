      if (not((pc_ue_CategoryDL_21 and pc_ue_Category_11 and pc_ue_Category_9 and pc_ue_Category_6 and pc_ue_Category_4 and
               ((pc_ue_CategoryUL_3 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_5 and pc_ue_CategoryDL_11 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_5 and pc_ue_CategoryUL_16 and pc_ue_CategoryDL_11 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18))) or
              (pc_ue_CategoryDL_21 and pc_ue_Category_12 and pc_ue_Category_10 and pc_ue_Category_7 and pc_ue_Category_4 and
               ((pc_ue_CategoryUL_7 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_13 and pc_ue_CategoryDL_12 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_13 and pc_ue_CategoryUL_15 and pc_ue_CategoryDL_12 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_13 and pc_ue_CategoryUL_18 and pc_ue_CategoryDL_12 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18) or
                (pc_ue_CategoryUL_13 and pc_ue_CategoryUL_15 and pc_ue_CategoryUL_20 and pc_ue_CategoryDL_12 and pc_ue_CategoryDL_16 and pc_ue_CategoryDL_18)))))// @sic R5-183070, R5-183073 sic@
      {
        f_SetVerdict(fail, __FILE__, __LINE__, "Invalid UE Category setting per 36.306 Table 4.1A-6");
      }
    } else {
      if (pc_ue_CategoryDL_21 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 21 omitted is inconsistent with PICS");}
    }
  }

  /*
   * @desc      check the reported UE DL Category 22-26 vs. UE Category 22-26 PICS items.
   *            Details see table 4.1A-6 (36.306 cl. 4.1)
   *            Inconsistency leads to verdict INCONCLUSIVE
   * @param     p_ReceivedCapabilityMsg
   * @status    APPROVED (LTE)
   */
  function f_CheckUE_CategoryDL_22to26 (UE_EUTRA_Capability p_ReceivedCapabilityMsg)
  { // @sic R5-187768 sic@
    var UE_EUTRA_Capability v_ReceivedCapabilityMsg := p_ReceivedCapabilityMsg;
    var UE_EUTRA_Capability_v1310_IEs v_UE_EUTRA_Capability_v1310_IEs; // intermediate variable
    var boolean v_CommonCategories := false;

    if (isvalue(v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)){
      v_UE_EUTRA_Capability_v1310_IEs := v_ReceivedCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension;
    }
    else {
      f_SetVerdict(inconc, __FILE__, __LINE__, "Rel_14 UE does not provide UE_EUTRA_Capability_v1310_IEs");
    }

    if (isvalue(v_UE_EUTRA_Capability_v1310_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1530)){
      select (v_UE_EUTRA_Capability_v1310_IEs.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.ue_CategoryDL_v1530) {
        case (22) {
          if (not pc_ue_CategoryDL_22) {f_SetVerdict(inconc, __FILE__, __LINE__, "UE_CategoryDL_22 reported inconsistent with PICS");}
        }
        case (23) {
          if (not pc_ue_CategoryDL_23) {f_SetVerdict(inconc, __FILE__, __LINE__, "UE_CategoryDL_23 reported inconsistent with PICS");}
        }
        case (24) {
          if (not pc_ue_CategoryDL_24) {f_SetVerdict(inconc, __FILE__, __LINE__, "UE_CategoryDL_24 reported inconsistent with PICS");}
        }
        case (25) {
          if (not pc_ue_CategoryDL_25) {f_SetVerdict(inconc, __FILE__, __LINE__, "UE_CategoryDL_25 reported inconsistent with PICS");}
        }
        case (26) {
          if (not pc_ue_CategoryDL_26) {f_SetVerdict(inconc, __FILE__, __LINE__, "UE_CategoryDL_26 reported inconsistent with PICS");}
        }
        case else  {
          f_SetVerdict(fail, __FILE__, __LINE__, "Invalid UE CategoryDL received in ue-CategoryDL-v1530 from the UE ");
        }
      }
      // checks based on 36.306 Table 4.1A-6
      // one of the UL categories per DL category
      v_CommonCategories := pc_ue_CategoryUL_20 or pc_ue_CategoryUL_22 or pc_ue_CategoryUL_23 or pc_ue_CategoryUL_24 or pc_ue_CategoryUL_25 or pc_ue_CategoryUL_26;
      // plus DL category 20 and UL category 20 per NOTE3
      v_CommonCategories := pc_ue_CategoryDL_20 and pc_ue_CategoryUL_20 and v_CommonCategories;
      if (not((pc_ue_CategoryDL_22 and v_CommonCategories) or
              (pc_ue_CategoryDL_23 and v_CommonCategories) or
              (pc_ue_CategoryDL_24 and v_CommonCategories) or
              (pc_ue_CategoryDL_25 and v_CommonCategories) or
              (pc_ue_CategoryDL_26 and v_CommonCategories)))
      {
        f_SetVerdict(fail, __FILE__, __LINE__, "Invalid UE Category setting per 36.306 Table 4.1A-6");
      }
    } else {
      if (pc_ue_CategoryDL_22 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 22 omitted is inconsistent with PICS");}
      if (pc_ue_CategoryDL_23 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 23 omitted is inconsistent with PICS");}
      if (pc_ue_CategoryDL_24 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 24 omitted is inconsistent with PICS");}
      if (pc_ue_CategoryDL_25 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 25 omitted is inconsistent with PICS");}
      if (pc_ue_CategoryDL_26 == true) {f_SetVerdict(fail, __FILE__, __LINE__, "UE_Category DL 26 omitted is inconsistent with PICS");}
    }
  }

