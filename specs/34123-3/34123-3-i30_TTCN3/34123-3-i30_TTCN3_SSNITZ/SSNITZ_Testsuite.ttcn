  //----------------------------------------------------------------------------
  testcase TC_12_2_1_13() runs on MTC_SSNITZ system SYSTEM_SSNITZ {
    // @purpose
    //   NITZ / GMM/ Time zone, Time and DST Handling
    var UTRAN_PTC        v_UTRAN      := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_UTRAN := UTRAN_PTC.create("UTRAN") alive;
  
    f_MTC_ConnectPTCs_SSNITZ(system, v_UTRAN);
  
    v_UTRAN.start(f_TC_12_2_1_13_UTRAN());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_SSNITZ(t_GuardTimer);
  }
