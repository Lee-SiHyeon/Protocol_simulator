      }
      case (IMS34_C160) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_InitiateSession and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C162) {
        v_ApplCond := pc_EPS_IMS_EmergencyCall and (pc_eFDD or pc_eTDD) and pc_No_USIM_TestExecution and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C163) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_Preconditions and pc_ue_CategoryDL_M1;
      }
      case (IMS34_C167) {
        v_ApplCond := pc_MultimediaTelephonyService and pc_MTSI_Speech and pc_MTSI_Speech_AMRWB and not pc_MTSI_Speech_EVS and pc_Preconditions and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
      }
      case (IMS34_C168) {
        v_ApplCond := pc_Concatenated_SMS_IP_MO and (pc_eFDD or pc_eTDD) and not pc_ue_CategoryDL_M1;
