--
--**************************************************************

CMAC-PAGING-Config-FDD-REQ ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo,
  ratType RatType,
  configMessage CmacPagingConfigReq
}

--**************************************************************
--
-- CMAC-PAGING-Config-TDD-REQ
--   To request MAC layer to send the Paging message on the specified configuration.
--   CMAC-PAGING-Config-REQ in TTCN-2
--
--**************************************************************

CMAC-PAGING-Config-TDD-REQ ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo,
  ratType RatType,
  configMessage CmacPagingConfigReq-TDD
}
--**************************************************************
--
-- CMAC-SYSINFO-Config-CNF
--   To confirm to setup the BCCH message to MAC layer
--
--**************************************************************

CMAC-SYSINFO-Config-CNF ::= SEQUENCE {
  cellId INTEGER (0..63),
  routingInfo RoutingInfo
}

--**************************************************************
--
-- CMAC-SYSINFO-Config-REQ
--   To request MAC layer to send the BCCH message on the specified configuration.
--
--**************************************************************

CMAC-SYSINFO-Config-REQ ::= SEQUENCE {
  cellId INTEGER (0..63),
