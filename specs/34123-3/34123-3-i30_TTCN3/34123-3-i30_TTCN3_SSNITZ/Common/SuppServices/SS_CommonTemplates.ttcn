module SS_CommonTemplates {

  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from CommonDefs all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTypeDefs all;
  import from UTRAN_NAS_PDU_Templates all;

  const O1_Type tsc_TeleserviceSpeech := '11'O;                                 /* @status    APPROVED (SSNITZ) */

  const O1_Type tsc_AllSpeechTransmissionServices := '10'O;                     /* @status    APPROVED (SSNITZ) */

  const BearerServiceCode tsc_AllSynchronousServices := '68'O;                  /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_CFNRy := '2A'O;                                     /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_CFU := '21'O;                                       /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_CFNRc := '2B'O;                                     /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_CFB := '29'O;                                       /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_BAOC := '92'O;                                      /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_BOIC := '93'O;                                      /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_BOICExHC := '94'O;                                  /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_BAIC := '9A'O;                                      /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_BIC_ROAM := '9B'O;                                  /* @status    APPROVED (SSNITZ) */

  const SS_Code tsc_SS_Code_AllBarringSS := '90'O;                              /* @status    APPROVED (SSNITZ) */

  const B7_Type tsc_SS_CauValue_RequestedFacilityNotSubscribed := '0110010'B;   /* @status    APPROVED (SSNITZ) */

  const B7_Type tsc_SS_CauValue_OperatorDetermindBarring := '0001000'B;         /* @status    APPROVED (SSNITZ) */

  const B7_Type tsc_SS_CauValue_ResourcesUnavailableUnspecified := '0101111'B;  /* @status    APPROVED (SSNITZ) */

  const B7_Type tsc_SS_CauValue_TemporaryFailure := '0101001'B;                 /* @status    APPROVED (SSNITZ) */

  const B7_Type tsc_SS_CauValue_Invalid_TI_Value := '1010001'B;                 /* TS24008 Annex H.5.1: Cause No. 81
                                                                                   @status    APPROVED (SSNITZ) */

  const Password tsc_SS_Password := "1"&"2"&"3"&"4";                            /* @status    APPROVED (SSNITZ) */

  const Password tsc_SS_NewPassword := "5"&"5"&"5"&"5";                         /* @status    APPROVED (SSNITZ) */

  const SS_Status tsc_SS_StatusProvisioned  := '04'O;                           /* @sic R5s160130 sic@
                                                                                   @status    APPROVED (SSNITZ) */

  const SS_Status tsc_SS_StatusPRA  := '07'O;                                   /* @sic R5s200154 sic@
                                                                                   @status    APPROVED (SSNITZ) */

  const SS_Status tsc_SS_StatusPR := '06'O;                                     /* @sic R5s200247 sic@
                                                                                   @status    APPROVED (SSNITZ) */

  const CMServType tsc_SupplementaryServiceActivation := '1000'B;               /* CM Service Type: Supplementary Service Activation. See 24.008, 10.5.3.3
                                                                                   @status    APPROVED (POS, SSNITZ) */

  const InvokeIdType tsc_InvokeId := 100;                                       /* Invoke ID to be used in messages sent by the System Simulator. This value has been chosen randomly.
                                                                                   @status    APPROVED (POS, SSNITZ) */

  const integer tsc_OperationCode_RegisterSS := 10;                             /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_EraseSS := 11;                                /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_ActivateSS := 12;                             /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_DeactivateSS := 13;                           /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_InterrogateSS := 14;                          /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_NotifySS := 16;                               /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_RegisterPassword := 17;                       /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_GetPassword := 18;                            /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_ProcessUnstructuredSS_Data := 19;             /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_ProcessUnstructuredSS_Request := 59;          /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_UnstructuredSS_Request := 60;                 /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_UnstructuredSS_Notify := 61;                  /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_SplitMPTY := 121;                             /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_RetrieveMPTY := 122;                          /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_HoldMPTY := 123;                              /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_BuildMPTY := 124;                             /* @status    APPROVED (SSNITZ) */

  const integer tsc_OperationCode_ExplicitCT := 126;                            /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_SSNotAvailable := 18;                             /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_MaxNumberOfMPTY_ParticipantsExceeded := 126;      /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_UnknownSubscriber := 1;                           /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_USSD_Busy := 72;                                  /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_BearerServiceNotProvisioned := 10;                /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_TeleServiceNotProvisioned := 11;                  /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_NegativePW_Check := 38;                           /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_SS_SubscriptionViolation := 19;                   /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_ShortTermDenial := 29;                            /* @status    APPROVED (SSNITZ) */

  const integer tsc_ErrorCode_LongTermDenial := 30;                             /* @status    APPROVED (SSNITZ) */

  const InvokeProblem tsc_InvokeProblem_UnrecognizedOperation := 1;             /* @status    APPROVED (SSNITZ) */

  const InvokeProblem tsc_InvokeProblem_MistypedParameter := 2;                 /* @status    APPROVED (SSNITZ) */

  const InvokeProblem tsc_InvokeProblem_ResourceLimitation := 3;                /* @status    APPROVED (SSNITZ) */

  const InvokeProblem tsc_InvokeProblem_InitiatingRelease := 4;                 /* @status    APPROVED (SSNITZ) */

  group Invoke_Templates {

  template (value) Invoke cs_InvokeNotify(InvokeIdType p_InvokeId := tsc_InvokeId,
                                          template (omit) SS_Code p_SS_Code := omit,
                                          template (omit) SS_Status p_SS_Status := omit,
                                          template (omit) SS_Notification p_SS_Notification := omit,
                                          template (omit) CallOnHold_Indicator p_CallOnHold_Indicator := omit,
                                          template (omit) CUG_Index p_CUG_Index := omit,
                                          template (omit) ECT_Indicator p_ECT_Indicator := omit,
                                          template (omit) NameIndicator p_NameIndicator := omit,
                                          template (omit) CCBS_Feature p_CCBS_Feature := omit,
                                          template (omit) AlertingPattern p_AlertingPattern := omit,
                                          template (omit) Multicall_Indicator p_Multicall_Indicator := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_NotifySS
    },
    parameter := {
      notifySS := {
        ss_Code                 := p_SS_Code,
        ss_Status               := p_SS_Status,
        ss_Notification         := p_SS_Notification,
        callIsWaiting_Indicator := omit,
        callOnHold_Indicator    := p_CallOnHold_Indicator,
        mpty_Indicator          := omit,
        cug_Index               := p_CUG_Index,
        clirSuppressionRejected := omit,
        ect_Indicator           := p_ECT_Indicator,
        nameIndicator           := p_NameIndicator,
        ccbs_Feature            := p_CCBS_Feature,
        alertingPattern         := p_AlertingPattern,
        multicall_Indicator     := p_Multicall_Indicator
      }
    }
  };

  template (present) Invoke cr_InvokeRegister(template (present) InvokeIdType p_InvokeId := ?,
                                              template SS_Code p_SS_Code := omit,
                                              template BasicServiceCode p_BasicServiceCode := omit,
                                              template AddressString p_AddressString := omit,
                                              template ISDN_SubaddressString p_ISDN_SubaddressString := omit,
                                              template NoReplyConditionTime p_NoReplyConditionTime := omit,
                                              template EMLPP_Priority p_EMLPP_Priority := omit,
                                              template MC_Bearers p_MC_Bearers := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_RegisterSS
    },
    parameter := {
      registerSS := {
        ss_Code               := p_SS_Code,
        basicService          := p_BasicServiceCode,
        forwardedToNumber     := p_AddressString,
        forwardedToSubaddress := p_ISDN_SubaddressString,
        noReplyConditionTime  := p_NoReplyConditionTime,
        defaultPriority       := p_EMLPP_Priority,
        nbrUser               := p_MC_Bearers,
        longFTN_Supported     := * // @sic R5s150981 sic@
      }
    }
  };

  template (present) Invoke cr_InvokeInterrogate(template (present) InvokeIdType p_InvokeId := ?,
                                                 template (present) SS_ForBS_Code p_SS_ForBS_Code) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_InterrogateSS
    },
    parameter := {
      interrogateSS := p_SS_ForBS_Code
    }
  };

  template (present) Invoke cr_InvokeActivate(template (present) InvokeIdType p_InvokeId := ?,
                                              template (present) SS_ForBS_Code p_SS_ForBS_Code) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_ActivateSS
    },
    parameter := {
      activateSS := p_SS_ForBS_Code
    }
  };

  template (present) Invoke cr_InvokeDeactivate(template (present) InvokeIdType p_InvokeId := ?,
                                                template (present) SS_ForBS_Code p_SS_ForBS_Code) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_DeactivateSS
    },
    parameter := {
      deactivateSS := p_SS_ForBS_Code
    }
  };

  template (present) Invoke cr_InvokeErase(template (present) InvokeIdType p_InvokeId := ?,
                                           template (present) SS_ForBS_Code p_SS_ForBS_Code) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_EraseSS
    },
    parameter := {
      eraseSS := p_SS_ForBS_Code
    }
  };

  template (present) SS_ForBS_Code cr_SS_ForBS_Code(template SS_Code p_SS_Code := omit,
                                                    template BasicServiceCode p_BasicServiceCode := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    ss_Code             := p_SS_Code,
    basicService        := p_BasicServiceCode,
    longFTN_Supported   := * //@sic R5s150981 sic@
  };

  template (present) Invoke cr_RegisterPassword(template (present) InvokeIdType p_InvokeId := ?,
                                                SS_Code p_SS_Code) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_RegisterPassword
    },
    parameter := {
      registerPassword := p_SS_Code
    }
  };

  template (present) Invoke cr_ProcessUnstructuredSS_Request(template (present) InvokeIdType p_InvokeId := ?,
                                                             template (present) USSD_Arg p_USSD_Arg) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_ProcessUnstructuredSS_Request
    },
    parameter := {
      processUnstructuredSS_Request := p_USSD_Arg
    }
  };

  template (present) Invoke cr_ProcessUnstructuredSS_Data(template (present) InvokeIdType p_InvokeId := ?,
                                                          template (present) SS_UserData p_SS_UserData) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_ProcessUnstructuredSS_Data
    },
    parameter := {
      processUnstructuredSS_Data := p_SS_UserData
    }
  };

  template (present) USSD_Arg cr_USSD_Arg(template (present) USSD_DataCodingScheme p_USSD_DataCodingScheme,
                                          template (present) USSD_String p_USSD_String,
                                          template AlertingPattern p_AlertingPattern := omit,
                                          template ISDN_AddressString p_ISDN_AddressString := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    ussd_DataCodingScheme   := p_USSD_DataCodingScheme,
    ussd_String             := p_USSD_String,
    alertingPattern         := p_AlertingPattern,
    msisdn                  := p_ISDN_AddressString
  }

  } // end of group Invoke_Templates

  group Return_Templates {

  template (value) ReturnResult cs_ReturnResultInterrogate_SSStatus(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                                    template (value) SS_Status p_SS_Status) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_InterrogateSS
      },
      parameter := {
        interrogateSSRes := {
          ss_Status := p_SS_Status
        }
      }
    }
  };

  template (value) ForwardingFeature cs_ForwardingFeature(template (omit) BasicServiceCode p_BasicServiceCode := omit,
                                                          template (omit) AddressString p_ForwardedToNumber := omit,
                                                          template (omit) NoReplyConditionTime p_NoReplyConditionTime := omit,
                                                          template (value) SS_Status p_Ss_Status := tsc_SS_StatusPRA) :=
  { /* @status    APPROVED (SSNITZ) */
    // @sic R5s160971 Ch. 2 sic@
    basicService := p_BasicServiceCode,
    ss_Status := p_Ss_Status,
    forwardedToNumber := p_ForwardedToNumber,
    forwardedToSubaddress := omit,
    forwardingOptions := omit,
    noReplyConditionTime := p_NoReplyConditionTime,
    longForwardedToNumber := omit
  };

  template (value) ReturnResult cs_ReturnResultInterrogate_ParamInterrogate(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                                            template (omit) BasicServiceCode p_BasicServiceCode := omit,
                                                                            template (omit) AddressString p_ForwardedToNumber := omit,
                                                                            template (omit) NoReplyConditionTime p_NoReplyConditionTime := omit,
                                                                            template (value) SS_Status p_Ss_Status := tsc_SS_StatusPRA) :=
  { /* @status    APPROVED (SSNITZ) */
    // @sic R5s160971 Ch. 2 sic@
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_InterrogateSS
      },
      parameter := {
        interrogateSSRes := {
          forwardingFeatureList := {
            cs_ForwardingFeature(p_BasicServiceCode,
                                 p_ForwardedToNumber,
                                 p_NoReplyConditionTime,
                                 p_Ss_Status)
          }
        }
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultRegister(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                        template (value) SS_Info p_SS_Info) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_RegisterSS
      },
      parameter := {
        registerSSRes := p_SS_Info
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultActivate(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                        template (value) SS_Info p_SS_Info) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_ActivateSS
      },
      parameter := {
        activateSS := p_SS_Info
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultDeactivate(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                          template (value) SS_Info p_SS_Info) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_DeactivateSS
      },
      parameter := {
        deactivateSS := p_SS_Info
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultErase(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                     template (value) SS_Info p_SS_Info) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_EraseSS
      },
      parameter := {
        eraseSS := p_SS_Info
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultRegisterPassword(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                                template (value) Password p_Password) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_RegisterPassword
      },
      parameter := {
        registerPassword := p_Password
      }
    }
  };

  template (value) ReturnResult cs_ReturnResultProcessUnstructuredSS_Request(template (value) InvokeIdType p_InvokeId := tsc_InvokeId,
                                                                             template (value) USSD_Res p_USSD_Res) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    result := {
      operationCode :=  {
        local := tsc_OperationCode_ProcessUnstructuredSS_Request
      },
      parameter := {
        processUnstructuredSS_Request := p_USSD_Res
      }
    }
  };

  template (value) USSD_Res cs_USSD_Res(template (value) USSD_DataCodingScheme p_USSD_DataCodingScheme,
                                        template (value) USSD_String p_USSD_String) :=
  { /* @status    APPROVED (SSNITZ) */
    ussd_DataCodingScheme   := p_USSD_DataCodingScheme,
    ussd_String             := p_USSD_String
  };

  } // end of group Return_Templates

  group Error_Templates {

  template (value) ReturnError cs_ReturnErrorCode(InvokeIdType p_InvokeId,
                                                  integer p_ErrorCode) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    errorCode := {
      local := p_ErrorCode
    },
    parameter := omit
  };

  template (present) ReturnError cr_ReturnErrorCode(template (present) InvokeIdType p_InvokeId := ?,
                                                    integer p_ErrorCode) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    errorCode := {
      local := p_ErrorCode
    },
    parameter :=  //@sic R5s160836 sic@
    { // Parameter should be present
        unstructuredSS_Notify := {
            ussd_Busy := NULL
        }
    }

  };

  template (value) Reject cs_Reject_InvokeProblem(InvokeIdType p_InvokeId,
                                                  InvokeProblem p_InvokeProblem) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := {
      derivable := p_InvokeId
    },
    problem := {
      invokeProblem := p_InvokeProblem
    }
  };

  template (value) Reject cs_Reject_ResourceLimitation(InvokeIdType p_InvokeId) := cs_Reject_InvokeProblem(p_InvokeId, tsc_InvokeProblem_ResourceLimitation);   /* @status    APPROVED (SSNITZ) */

  template (value) Reject cs_Reject_InitiatingRelease(InvokeIdType p_InvokeId) := cs_Reject_InvokeProblem(p_InvokeId, tsc_InvokeProblem_InitiatingRelease);     /* @status    APPROVED (SSNITZ) */

  } // end of group Error_Templates

  group Common_Templates {

  template (present) REGISTER cr_RegisterMO(template (present) FacilityIE p_Facility,
                                            template SS_VersionInd p_SSVersionInd) :=  // @sic R5s150605 sic@
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := cr_TI_MO,     // TI flag '0'
    sS_ProtocolDiscriminator := tsc_PD_SS,
    msgType         := '??111011'B,
    facility_Str    := p_Facility,
    sS_VersionInd   := p_SSVersionInd
  };

  template (value) REGISTER cs_RegisterMT(template (value) TI p_TI,
                                          template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := p_TI,
    sS_ProtocolDiscriminator := tsc_PD_SS,
    msgType         := '00111011'B,
    facility_Str    := p_Facility,
    sS_VersionInd   := omit
  };

  template (present) Components cr_Components(template (present) Component p_Component) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    p_Component
  };

  template (value) Components cs_Components (template (value) Component p_Component) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    p_Component
  };

  template (present) Component cr_InvokeComponent(template (present) Invoke p_Invoke) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    invoke := p_Invoke
  };

  template (value) Component cs_InvokeComponent (template (value) Invoke p_Invoke) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    invoke := p_Invoke
  };

  template (value) Component cs_ReturnResult (template (value) ReturnResult p_ReturnRes) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnResultLast := p_ReturnRes
  };

  template (present) Component cr_ReturnResult (template (present) ReturnResult p_ReturnRes) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnResultLast := p_ReturnRes
  };

  template (value) Component cs_ReturnError (template (value) ReturnError p_ReturnError) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    returnError := p_ReturnError
  };

  template (value) Component cs_ReturnReject (template (value) Reject p_Rej) :=
  { /* @status    APPROVED (SSNITZ) */
    reject := p_Rej
  };

  template (value) Cau cs_SS_Cau(B7_Type p_CauValue) := cs_Cau_Common(-, tsc_CodingStd_GSM, tsc_Location_User, p_CauValue);  /* @status    APPROVED (POS, SSNITZ) */

  template (present) RELEASECOMPLETE cr_ReleaseCompleteFacility(template (present) TI p_TI,
                                                                template (present) FacilityIE p_Facility,
                                                                template ProtocolDiscriminator p_PD := tsc_PD_SS) :=
  /* @status    APPROVED (POS, SSNITZ) */
    cr_ReleaseComplete(p_TI, -, p_Facility, p_PD); // @sic R5s140884 sic@

  template (value) FACILITY cs_Facility(template (value) TI p_TI,
                                        ProtocolDiscriminator p_PD := tsc_PD_SS,
                                        template (value) FacilityIE p_Facility) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    ti              := p_TI,     // TI flag '0'
    sS_ProtocolDiscriminator := p_PD,
    msgType         := '00111010'B,
    facility_Str    := valueof (p_Facility)
  };

  template (value) FacilityIE cs_FacilityIE(template (omit) O1_Type p_IEI,
                                            octetstring p_ComponentsOct) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    iei        := p_IEI,
    iel        := int2oct(lengthof(p_ComponentsOct),1),
    components := p_ComponentsOct
  };

  template (value) FacilityIE cs_FacilityIE_lv(octetstring p_ComponentsOct) := cs_FacilityIE(omit, p_ComponentsOct);    /* @status    APPROVED (POS, SSNITZ) */

  template (value) FacilityIE cs_FacilityIE_tlv(octetstring p_ComponentsOct) := cs_FacilityIE('1C'O, p_ComponentsOct);  /* @status    APPROVED (POS, SSNITZ) */

  template (present) FacilityIE cr_FacilityIE(template O1_Type p_IEI,
                                              template (present) octetstring p_ComponentsOct) :=
  { /* @status    APPROVED (POS, SSNITZ) */
    iei        := p_IEI,
    iel        := ?,
    components := p_ComponentsOct
  };

  template (present) FacilityIE cr_FacilityIE_tlv (template (present) octetstring p_ComponentsOct := ?) := cr_FacilityIE('1C'O, p_ComponentsOct); /* @status    APPROVED (POS, SSNITZ) */

  template (present) FacilityIE cr_FacilityIE_lv (template (present) octetstring p_ComponentsOct := ?) := cr_FacilityIE(omit, p_ComponentsOct);   /* @status    APPROVED (SSNITZ) */

  template (present) FACILITYul cr_Facility(template (present) TI p_TI,
                                            template (present) FacilityIE p_Facility,
                                            ProtocolDiscriminator p_PD := tsc_PD_SS) :=
  { /* @status    APPROVED (SSNITZ) */
    ti              := p_TI,     // TI flag '0'
    sS_ProtocolDiscriminator := p_PD,
    msgType         := '??111010'B,
    facility_Str    := p_Facility,
    sS_VersionInd   := cr_SS_VersionIndAny ifpresent  // @sic R5s140989 sic@
  };

  template (value) SS_Info cs_SS_InfoBarring(SS_Code p_SS_Code,
                                             template (omit) BasicServiceCode p_BasicServiceCode := omit,
                                             template (omit) SS_Status p_SS_Status) :=
  { /* @status    APPROVED (SSNITZ) */
    callBarringInfo := {
      ss_Code := p_SS_Code,
      callBarringFeatureList := {
        {
          basicService := p_BasicServiceCode,
          ss_Status := p_SS_Status
        }
      }
    }
  };

  template (value) SS_Info cs_SS_Data(SS_Code p_SS_Code,
                                      template (omit) BasicServiceGroupList p_BasicServiceGroupList := omit,
                                      template (omit) SS_Status p_SS_Status := omit) :=
  { /* @status    APPROVED (SSNITZ) */
    // @sic R5s160389 R5s210264 sic@
    ss_Data := {
      ss_Code := p_SS_Code,
      ss_Status := p_SS_Status,
      ss_SubscriptionOption := omit,
      basicServiceGroupList := p_BasicServiceGroupList,
      defaultPriority       := omit,
      nbrUser               := omit
    }
   };

  } // end of group Common_Templates

}
