module NR5GC_Handover {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};

  template (value) MasterKeyUpdate cs_MasterKeyUpdate(boolean p_KeySetChangeIndicator,
                                                      NextHopChainingCount p_NextHopChainingCount,
                                                      template (omit) octetstring p_IRAT_NASContainer := omit) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    keySetChangeIndicator := p_KeySetChangeIndicator,
    nextHopChainingCount := p_NextHopChainingCount,
    nas_Container := p_IRAT_NASContainer
  };

}
