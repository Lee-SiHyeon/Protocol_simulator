        v_ApplCond := (pc_NG_RAN_NR or pc_NG_RAN_EUTRA) and pc_UEB_WLAN;
      }
      case (POS_C13ns) {
        v_ApplCond := (pc_NG_RAN_NR or pc_NG_RAN_EUTRA) and pc_UEB_Sens;
      }
      case (POS_C14ns) {
        v_ApplCond := (pc_NG_RAN_NR or pc_NG_RAN_EUTRA) and pc_UEA_AGNSS;
      }
      case (POS_C16ns) {
        v_ApplCond := (pc_NG_RAN_NR and pc_UEA_AGNSS and pc_OTDOA and pc_OTDOA_interRAT_RSTDmeasurement) or (pc_NG_RAN_EUTRA and pc_UEA_AGNSS and pc_OTDOA);
      }
      case (POS_C19ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT;
      }
      case (POS_C20ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_AoD or pc_UEB_DL_AoD);
      }
      case (POS_C21ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA);
      }
      case (POS_C22ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_UEB_DL_AoD;
      }
      case (POS_C23ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_UEB_DL_TDOA;
      }
      case (POS_C24ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_UEA_DL_AoD;
      }
      case (POS_C25ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_UEA_DL_TDOA;
      }
      case (POS_C26ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_NR_ECID;
      }
      case (POS_C27ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_MBS or pc_UEB_MBS);
      }
      case (POS_C28ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_Sens or pc_UEB_Sens);
      }
      case (POS_C29ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT and pc_mg_ActivationRequest and pc_mg_ActivationCommPRS_Meas and pc_mg_ActivationRequestPRS_Meas;
      }
      case (POS_C30ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_AoD or pc_UEB_DL_AoD) and pc_mg_ActivationRequest and pc_mg_ActivationCommPRS_Meas and pc_mg_ActivationRequestPRS_Meas;
      }
      case (POS_C31ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA) and pc_mg_ActivationRequest and pc_mg_ActivationCommPRS_Meas and pc_mg_ActivationRequestPRS_Meas;
      }
      case (POS_C32ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT and pc_prs_ProcessingCapabilityOutsideMGinPPW and (pc_prs_ProcessingWindowType1A or pc_prs_ProcessingWindowType1B or pc_prs_ProcessingWindowType2);
      }
      case (POS_C33ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_AoD or pc_UEB_DL_AoD) and pc_prs_ProcessingCapabilityOutsideMGinPPW and (pc_prs_ProcessingWindowType1A or pc_prs_ProcessingWindowType1B or pc_prs_ProcessingWindowType2);
      }
      case (POS_C34ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA) and pc_prs_ProcessingCapabilityOutsideMGinPPW and (pc_prs_ProcessingWindowType1A or pc_prs_ProcessingWindowType1B or pc_prs_ProcessingWindowType2);
      }
      case (POS_C35ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_UEA_UL_TDOA and pc_nr_UE_TxTEG_ID;
      }
      case (POS_C36ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT and pc_nr_DL_PRS_RSCP_ReportingRRC_Connected_Multi_RTT;
      }
      case (POS_C37ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA) and pc_nr_DL_PRS_RSCPD_ReportingRRC_Connected_DL_TDOA;
      }
      case (POS_C41ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT and pc_posSRS_ValidityAreaRRC_InactiveInitialUL_BWP;
      }
      case (POS_C42ns) {
        v_ApplCond := pc_NG_RAN_NR and pc_Multi_RTT and pc_aggregated_prs_MeasureAndReport and pc_DL_PRS_BWA_RRC_Connected_Multi_RTT;
      }
      case (POS_C43ns) {
        v_ApplCond := pc_NG_RAN_NR and (pc_UEA_DL_TDOA or pc_UEB_DL_TDOA) and pc_aggregated_prs_MeasureAndReport and pc_DL_PRS_BWA_RRC_Connected_DL_TDOA;
      }
      case else {
        v_ApplCond := false;
      }
    }
    return v_ApplCond;
  }

}
