module LibSip_MessageBodyTypes
{
  import from LibSip_SimpleMsgSummaryTypes all;
  import from LibSip_Common all;
  
  type enumerated MIME_FieldName {
    MIME_CONTENT_DISPOSITION_E,
    MIME_CONTENT_TYPE_E,
    MIME_CONTENT_ID_E
  };

  
  type charstring XmlBody;
  type charstring SdpBody;
  type charstring MikeyMsg;      /* Base64 encoded MIKEY message RFC 3830 clause 6 */

  group MIMETypes {

  type record MIME_ContentDisposition {   // RFC 2183
    MIME_FieldName fieldName (MIME_CONTENT_DISPOSITION_E),
    charstring dispositionType,
    SemicolonParam_List dispositionParams optional
  };
  type record MIME_ContentType {   // RFC 2045 clause 5
    MIME_FieldName fieldName (MIME_CONTENT_TYPE_E),
    charstring typeAndSubtype,
    SemicolonParam_List typeParams optional
  };
  type record MIME_ContentId {   // RFC 2045 clause 7
    MIME_FieldName fieldName (MIME_CONTENT_ID_E),
    charstring msgId
  };


  type set MIME_Part_Header { // @sic R5w180006 sic@
    MIME_ContentType          contentType,
    MIME_ContentDisposition   contentDisposition optional,
    MIME_ContentId            contentId optional
  };

  type union MIME_Part_Body {
    SdpBody sdpMessageBody,       /* @sic R5w140112: sdpMessageBody changed back to charstring sic@
                                     to be applied when contentType is "application/sdp" */
    XmlBody xmlBody,              /* to be applied when contentType indicates an XML body, e.g. matches "application/xml", "text/xml", "application/(.*)+xml" */
    charstring commonText,        /* to be applied when contentType indicates text based content other than SDP or XML, e.g. "application/mikey" (base64encoded), "application/json", "text/html", "application/x-www-form-urlencoded" */
    octetstring commonBinary      /* to be applied when contentType indicates binary data, e.g. "application/EmergencyCallData.eCall.MSD" */
  };

  
  type record MIME_Part { // @sic R5w180006 sic@
    MIME_Part_Header  header,
    MIME_Part_Body    body
  };

  
  type record MIME_Message {
    charstring boundary,  // boundary according to RFC 2046 clause 5.1.1
    MIME_Part_List  mimePartList
  };

  type set of MIME_Part MIME_Part_List; // @sic R5w180006 sic@

  } // group MIMETypes

  type union MessageBody {          /* @sic R5w200103/R5-201585: sipfrag removed at IWD 20wk38 sic@ */
    SdpBody sdpMessageBody,         /* @sic R5w140112: sdpMessageBody changed back to charstring sic@
                                       to be applied when contentType is "application/sdp" */
    XmlBody xmlBody,                /* to be applied when contentType indicates an XML body, e.g. matches "application/xml", "text/xml", "application/(.*)+xml" */
    MIME_Message mimeMessageBody,   /* to be applied when contentType is "multipart/mixed" */
    SimpleMsgSummary simpleMsgSummary, /* RFC 3842 (Message Summary and Message Waiting Indication Event Package for the Session Initiation Protocol); to be applied when contentType is "application/simple-message-summary" */
    octetstring smsMessage,         /* encoded SMS message 3GPP 23.040, 24.011; to be applied when contentType is "application/vnd.3gpp.sms" */
    charstring commonText,          /* to be applied when contentType indicates text based content other than SDP, XML or simple message summary, e.g. "application/mikey" (base64encoded), "application/json", "text/html", "application/x-www-form-urlencoded" */
    octetstring commonBinary        /* to be applied when contentType indicates binary data other than SMS, e.g. "application/EmergencyCallData.eCall.MSD" */
  };

}
