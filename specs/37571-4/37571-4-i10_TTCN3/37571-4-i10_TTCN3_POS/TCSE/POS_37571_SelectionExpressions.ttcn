        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GALILEO and pc_ParamGpsAssisData and not (pc_GLONASS or pc_BDS);
      }
      case (POS_C59us) {
        v_ApplCond := pc_FDD and ((pc_UEB_A_GANSS and pc_UeBasedAgps) or (pc_UEA_A_GANSS and pc_UeAssistedAgps)) and pc_GALILEO and not (pc_GLONASS or pc_BDS);
      }
      case (POS_C60us) {
        v_ApplCond := pc_FDD and pc_UeAssistedAgps and pc_UEA_A_GANSS and pc_GALILEO and not (pc_GLONASS or pc_BDS);
      }
      case (POS_C09es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_OTDOA and pc_EPC_MO_LR_RequestPositionEstimate;
      }
      case (POS_C10es) {
        v_ApplCond := pc_eFDD and pc_ECID and pc_EPC_MO_LR_RequestPositionEstimate;
      }
      case (POS_C11es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_LPP;
      }
      case (POS_C12es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_FDD or pc_TDD_LCR) and pc_CS_MO_LR_CSFallback;
      }
      case (POS_C13es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_FDD or pc_TDD_LCR) and pc_CS_MO_LR_CSFallback and not (pc_EPC_MO_LR_RequestAssistanceData and pc_EPC_MO_LR_RequestPositionEstimate);
      }
      case (POS_C14es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_MT_LR_loc_notif;
      }
      case (POS_C21es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_UEA_AGNSS and pc_OTDOA;
      }
      case (POS_C26es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_OTDOA;
      }
      case (POS_C27es) {
        v_ApplCond := pc_eFDD and pc_ECID;
      }
      case (POS_C36es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_LPP and pc_LPP_SendingACK_ProvideCapabilities;
      }
      case (POS_C37es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_InterFreq_RSTD_withGaps;
      }
      case (POS_C53es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_EPC_MO_LR_RequestPositionEstimate and pc_UEA_MBS;
      }
      case (POS_C54es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and (pc_UEA_AGNSS or pc_OTDOA or pc_ECID or pc_UEA_MBS or pc_WLAN or pc_Bluetooth or pc_Sens) and not (pc_UEA_AGNSS and pc_OTDOA and pc_ECID and pc_UEA_MBS and pc_WLAN and pc_Bluetooth and pc_Sens);
      }
