  /*
   * @desc      return network address stored at the IMS PTC as charstring
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_NW_Address_GetAddrStr() runs on IMS_PTC return charstring
  {
    if (not isvalue(vc_IMS_Global.ImsInfo.NW_Address)) {
      FatalError(__FILE__, __LINE__, "NW address not initialiased yet");
    }
    return f_IP_AddrInfo_AddrStr(vc_IMS_Global.ImsInfo.NW_Address);
  }

  /*
   * @desc      return P-CSCF address (FQDN) stored at the IMS PTC
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_Pcscf_Get() runs on IMS_PTC return charstring
  { /* @sic R5-144747 removal of px_IMS_Pcscf and px_IMS_Pcscf_Emg sic@ */
    /* @sic R5s140934: P_CSCF_Address sic@ */
    var charstring v_P_CSCF_Address;

    if (ispresent(vc_IMS_Global.ImsInfo.P_CSCF_Address)) {
      v_P_CSCF_Address := vc_IMS_Global.ImsInfo.P_CSCF_Address;
    } else {
      v_P_CSCF_Address := f_IMS_PTC_NW_Address_GetAddrStr();
    }
    return v_P_CSCF_Address;
  }

  /*
   * @desc      Check P-CSCF address;
   *            NOTE: the P-CSCF address is the same address as the NW_Address but in case of IPv6 it may be a different notation
   *                  typically the UE may use the canonical format acc. to RFC 5952
   * @param     p_P_CSCF_Address
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_Pcscf_CheckAndSet(charstring p_P_CSCF_Address) runs on IMS_PTC return boolean
  {
    var charstring v_P_CSCF_Address := f_IMS_PTC_Pcscf_Get();

    if (v_P_CSCF_Address != p_P_CSCF_Address) {
      if (f_IPAddresses_Compare(v_P_CSCF_Address, p_P_CSCF_Address)) {
        vc_IMS_Global.ImsInfo.P_CSCF_Address := p_P_CSCF_Address;
      } else {
        return false;
      }
    }
    return true;
  }

  /*
   * @desc      check validity of the host/port information used by the UE
   * @param     p_HostPort
   * @param     p_Port              (default value: *)
   * @param     p_AllowFQDN         (default value: true)
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_CheckHostPortForIPAddrOrFQDN(HostPort p_HostPort,
                                                  template integer p_Port := *,
                                                  boolean p_AllowFQDN := true) runs on IMS_PTC return boolean
  { /* p_AllowFQDN  ..  shall be set to false e.g. for condition A6 of A.2.1 */
    if (p_AllowFQDN and match(p_HostPort, cr_HostPort(f_IMS_PTC_ImsInfo_GetHomeDomainName(), p_Port))) {  // => FQDN
      return true;
    }
    return (match(p_HostPort.portField, p_Port) and                                       // check port
            f_IMS_IpAddrMatch(f_IMS_PTC_UE_Address_Get(), p_HostPort.host));              // check IP address taking into account that formats may be different
  }

  /*
   * @desc      Check SipUrl (e.g. in Contact header) to be "SIP URI with IP address or FQDN and protected server port of UE or GRUU as returned by the SS in registration"
   * @param     p_SipUrl
   * @param     p_Port              (default value: *)
   * @param     p_GRUUsInSIP
   * @param     p_AllowFQDN         (default value: true)
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_CheckSipUrlForIPAddrOrFQDNOrGRUU(SipUrl p_SipUrl,
                                                      template integer p_Port := *,
                                                      boolean p_GRUUsInSIP,
                                                      boolean p_AllowFQDN := true) runs on IMS_PTC return boolean
  { /* @sic R5s130195 BASELINE MOVING 2013: change of SipUrl sic@ */
    /* @sic R5-153760: p_GRUUsInSIP := pc_IMS_GRUUsInSIP; R5s150908: p_GRUUsInSIP handed over from f_IMS_MessageHeader_CheckContactAddr sic@ */
    
    var template (present) SipUrl v_ExpectedSipUrl;
    var HostPort v_HostPort;
    
    if (not ischosen(p_SipUrl.components.sip)) {
      return false;
    }
    v_HostPort := p_SipUrl.components.sip.hostPort;

    if (p_GRUUsInSIP) {  // @sic R5-153760 sic@
      v_ExpectedSipUrl := f_SIP_BuildSipUri_RX(f_IMS_PTC_ImsInfo_GetUriString(gruu), cr_UriParameters_gruu);    /* when "obtaining and using GRUUs in SIP" the UE shall use the public GRUU in the Contact header
                                                                                                                   => SIP URI as used during registration + "gr" uri-parameter
                                                                                                                   @sic R5s150721, R5-153760 sic@ */
      return match(p_SipUrl, v_ExpectedSipUrl);
    } else { // No GRUU
      return f_IMS_PTC_CheckHostPortForIPAddrOrFQDN(v_HostPort, p_Port, p_AllowFQDN);
    }
  }

  /*
   * @desc      return true when SigComp is started
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_SigCompStarted() runs on IMS_PTC return boolean
  {
    return vc_IMS_Global.ImsInfo.SigCompStarted;
  }

  /*
   * @desc      return sig comp parameters or omit when sig comp is not started
   * @return    template (omit) GenericParam
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetSigCompParam() runs on IMS_PTC return template (omit) GenericParam
  {
    if (vc_IMS_Global.ImsInfo.SigCompStarted) {
      return cs_SigCompParam;
    } else {
      return omit;
    }
  }

  /*
   * @desc      function returning IMPU; FatalError is raised in case of invalid index
   * @param     p_Index
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_PTC_ImsInfo_GetIMPU(integer p_Index) runs on IMS_PTC return charstring
  { /* @sic R5-160290 FBBA registration: new function to avoid runtime error sic@ */
    if (p_Index > lengthof(vc_IMS_Global.ImsInfo.IMPUList)) {
      FatalError(__FILE__, __LINE__, "not that many IMPUs configured");
    }
    return vc_IMS_Global.ImsInfo.IMPUList[p_Index];
  }

  /*
   * @desc      return specific public user id e.g. as used for registration
   * @param     p_IdType
   * @param     p_DialogIndex       (default value: omit)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetUriString(IMS_UriInfo_UriType_Type p_IdType,
                                          template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return charstring
  {
    var template (omit) SipUrl v_SipUrl;

    select (p_IdType) {
      case (firstId, defaultId, emergencyId) {
        return fl_IMS_PTC_ImsInfo_GetIMPU(0);
      }
      case (secondId) {
        return fl_IMS_PTC_ImsInfo_GetIMPU(1);
      }
      case (thirdId) {
        return fl_IMS_PTC_ImsInfo_GetIMPU(2);
      }
      case (registrationId, gruu) {     /* @sic R5-153760: support of gruu; same URI as used by the UE in the To header of the REGISTER message sic@ */
        if (ispresent(vc_IMS_Global.ImsInfo.Registration.Uri)) {
          return vc_IMS_Global.ImsInfo.Registration.Uri;
        }
      }
      case (dialogLocalId, dialogRemoteId) {
        v_SipUrl := f_IMS_PTC_ImsInfo_DialogGetSipUri(p_IdType, p_DialogIndex); /* @sic R5s160451: f_IMS_PTC_ImsInfo_DialogGetSipUri sic@ */
        if (isvalue(v_SipUrl)) {
          return f_SIP_SipUrl2Str(valueof(v_SipUrl));
        }
      }
      case (temporaryId) {
        return f_IMS_TemporaryPublicUserIdentity(px_IMSI_Def);
      }
    }
    FatalError(__FILE__, __LINE__, "Invalid URI or URI not initialised");
    return "";
  }

  /*
   * @desc      return SipUrl to be used in DL
   * @param     p_IdType
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (value) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetSipUriTX(IMS_UriInfo_UriType_Type p_IdType,
                                         template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (value) SipUrl
  { /* @sic R5s150382 change 1: p_DialogIndex sic@ */
    /* @sic R5s160451: p_Port removed as never being used sic@ */
    var template (omit) SipUrl v_DialogSipUrl := f_IMS_PTC_ImsInfo_DialogGetSipUri(p_IdType, p_DialogIndex);  /* @sic R5s160451: SipUrl as in From/To header of message creating the dialog sic@ */
    var template (value) SipUrl v_SipUrl;

    if (isvalue(v_DialogSipUrl)) {        /* URI is related to the given dialog */
      v_SipUrl := valueof(v_DialogSipUrl);
    } else {
      v_SipUrl := f_SIP_BuildSipUri_TX(f_IMS_PTC_ImsInfo_GetUriString(p_IdType, p_DialogIndex));
    }
    return v_SipUrl;
  }

  /*
   * @desc      return SipUrl to be used in UL
   * @param     p_IdType
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (present) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetSipUriRX(IMS_UriInfo_UriType_Type p_IdType,
                                         template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (present) SipUrl
  { /* @sic R5s150382 change 1: p_DialogIndex sic@ */
    var template (omit) SipUrl v_DialogSipUrl := f_IMS_PTC_ImsInfo_DialogGetSipUri(p_IdType, p_DialogIndex);  /* @sic R5s160451: SipUrl as in From/To header of message creating the dialog sic@ */
    var template (present) SipUrl v_SipUrl;

    if (isvalue(v_DialogSipUrl)) {
      v_SipUrl := valueof(v_DialogSipUrl);
    } else {
      v_SipUrl := f_SIP_BuildSipUri_RX(f_IMS_PTC_ImsInfo_GetUriString(p_IdType, p_DialogIndex));
    }
    return v_SipUrl;
  }

  /*
   * @desc      return all PublicUserIds for which the UE is registered or shall be registered
   * @return    CharStringList_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetAllIMPUs() runs on IMS_PTC return CharStringList_Type
  {
    return vc_IMS_Global.ImsInfo.IMPUList;
  }

  /*
   * @desc      return SipUrl as used for subscription (ref event package)
   * @return    template (present) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetSipUriSubscriptionRX() runs on IMS_PTC return template (present) SipUrl
  {
    var charstring v_PublicUserIdDefault := f_IMS_PTC_ImsInfo_GetUriString(defaultId);
    var charstring v_PublicUserIdRegistration := f_IMS_PTC_ImsInfo_GetUriString(registrationId);
    var template (present) SipUrl v_SipUrl;

    if (f_IMS_PTC_ImsInfo_GetUEwithISIM() and (v_PublicUserIdDefault != v_PublicUserIdRegistration)) {             /* @sic R5-203077: f_IMS_PTC_ImsInfo_GetUEwithISIM instead of px_UEwithISIM sic@ */
      v_SipUrl := (f_SIP_BuildSipUri_RX(v_PublicUserIdDefault), f_SIP_BuildSipUri_RX(v_PublicUserIdRegistration));
    } else {
      v_SipUrl := f_SIP_BuildSipUri_RX(v_PublicUserIdDefault);
    }
    return v_SipUrl;
  }

  /*
   * @desc      return SipUrl with "any IMPU within the set of IMPUs on ISIM"
   * @return    template (present) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetSipUriAnyRX() runs on IMS_PTC return template (present) SipUrl
  {
    var CharStringList_Type v_IMPUList := f_IMS_PTC_ImsInfo_GetAllIMPUs();
    var template (present) SipUrlList_Type v_SipUrlList;
    var integer i;

    for (i := 0; i < lengthof(v_IMPUList); i := i + 1) {
      v_SipUrlList[i] := f_SIP_BuildSipUri_RX(v_IMPUList[i]);
    }
    return (all from v_SipUrlList);
  }

  /*
   * @desc      Initialise structure of type IMS_DialogInfo_Type
   * @param     p_DialogInfo
   * @param     p_CseqType
   * @param     p_MessageHeader_InviteOrReferOrSubscribe
   * @return    IMS_DialogInfo_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_DialogInfo_Init(IMS_DialogInfo_Type p_DialogInfo,
                                 IMS_PTC_CseqType_Type p_CseqType,
                                 MessageHeader p_MessageHeader_InviteOrReferOrSubscribe) return IMS_DialogInfo_Type
  { /* @sic R5-174544: SessionId removed sic@ */
    var SipUrl v_FromURI := f_Addr_Union_GetSipUrl(p_MessageHeader_InviteOrReferOrSubscribe.fromField.addressField);  /* @sic R5s160451: SipUrl instead of charstring sic@ */
    var SipUrl v_ToURI   := f_Addr_Union_GetSipUrl(p_MessageHeader_InviteOrReferOrSubscribe.toField.addressField);    /* @sic R5s160451: SipUrl instead of charstring sic@ */
    var charstring v_FromTag := f_MessageHeader_GetFromTag(p_MessageHeader_InviteOrReferOrSubscribe);
    var integer v_CseqValue := p_MessageHeader_InviteOrReferOrSubscribe.cSeq.seqNumber;
    var IMS_DialogInfo_Type v_Dialog := p_DialogInfo;
    
    select (p_CseqType) {
      case (dialogLocal) {                 /* MT establishment of the dialog */
        v_Dialog.LocalURI  := v_FromURI;   /* @sic R5s140121 change 2.2: needs to be v_FromURI instead of v_ToURI sic@ */
        v_Dialog.RemoteURI := v_ToURI;     /* @sic R5s140121 change 2.2: needs to be v_ToURI instead of v_FromURI sic@ */
        v_Dialog.MobileOriginated := false;
        v_Dialog.LocalTag := v_FromTag;
        v_Dialog.RemoteTag := omit;        /* @sic R5s130497 change 1 - MCC160 implementation sic@ */
        v_Dialog.LocalCseq := v_CseqValue;
      }
      case (dialogRemote) {                /* MO establishment of the dialog */
        v_Dialog.LocalURI  := v_ToURI;     /* @sic R5s140121 change 2.2: needs to be v_ToURI instead of v_FromURI sic@ */
        v_Dialog.RemoteURI := v_FromURI;   /* @sic R5s140121 change 2.2: needs to be v_FromURI instead of v_ToURI sic@ */
        v_Dialog.MobileOriginated := true;
        v_Dialog.LocalTag := omit;         /* @sic R5s130497 change 1 - MCC160 implementation sic@ */
        v_Dialog.RemoteTag := v_FromTag;
        v_Dialog.RemoteCseq := v_CseqValue;
        v_Dialog.ContactUrlUE := f_MessageHeader_GetContactSipUrl(p_MessageHeader_InviteOrReferOrSubscribe);
      }
      case else {
        FatalError (__FILE__, __LINE__, "");
      }
    }

    v_Dialog.CallId := p_MessageHeader_InviteOrReferOrSubscribe.callId.callid;
    return v_Dialog;
  }

  /*
   * @desc      Initialise global variables for SIP dialog
   * @param     p_CseqType
   * @param     p_MessageHeader_InviteOrReferOrSubscribe
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogInit(IMS_PTC_CseqType_Type p_CseqType,
                                        MessageHeader p_MessageHeader_InviteOrReferOrSubscribe,
                                        template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  { /* @sic R5s140017 MCC160 implementation: ToTag replaced by RemoteTag and LocalTag; additional state variables: CallId, SessionId sic@ */
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);

    v_Dialog := f_IMS_DialogInfo_Init(v_Dialog, p_CseqType, p_MessageHeader_InviteOrReferOrSubscribe);
    fl_IMS_PTC_ImsInfo_SetDialog(p_DialogIndex, v_Dialog);
  }

  /*
   * @desc      check whether given dialog is started
   * @param     p_DialogIndex       (default value: omit)
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_PTC_ImsInfo_DialogIsStarted(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return boolean
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    return ispresent(v_Dialog.CallId);
  }

  /*
   * @desc      returns true if a dialog is (fully) established
   *            according to RFC 3261 clause 12.1 2xx and 101-199 responses with a To tag establish a dialog
   *            => this is the case when remote and local tag are set (independent of whether the dialog is MO or MT)
   * @param     p_DialogIndex       (default value: omit)
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogIsEstablished(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return boolean
  {
    var template (omit) charstring v_LocalTag := f_IMS_PTC_ImsInfo_DialogGetLocalTag(p_DialogIndex);
    var template (omit) charstring v_RemoteTag := f_IMS_PTC_ImsInfo_DialogGetRemoteTag(p_DialogIndex);
    return (isvalue(v_LocalTag) and isvalue(v_RemoteTag));
  }

  /*
   * @desc      function to set local tag acc. to response for INVITE (MO call setup)
   * @param     p_Tag
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogSetLocalTag(charstring p_Tag,
                                               template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    v_Dialog.LocalTag := p_Tag;
    fl_IMS_PTC_ImsInfo_SetDialog(p_DialogIndex, v_Dialog);
  }

  /*
   * @desc      function to be used to get local tag for sending any request to a UE within a dialog (e.g. PRACK, BYE etc.)
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (omit) charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogGetLocalTag(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (omit) charstring
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    return v_Dialog.LocalTag;
  }

  /*
   * @desc      Get SipUrl related to the dialog
   * @param     p_IdType
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (omit) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogGetSipUri(IMS_UriInfo_UriType_Type p_IdType,
                                             template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (omit) SipUrl
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    var template (omit) SipUrl v_SipUrl := omit;

    select (p_IdType) {
      case (dialogLocalId) {
        v_SipUrl := v_Dialog.LocalURI;
      }
      case (dialogRemoteId) {
        v_SipUrl := v_Dialog.RemoteURI;
      }
    }
    return v_SipUrl;
  }

  /*
   * @desc      function to be used to get remote tag for sending any request to a UE within a dialog (e.g. PRACK, BYE etc.)
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (omit) charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogGetRemoteTag(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (omit) charstring
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    return v_Dialog.RemoteTag;
  }

  /*
   * @desc      function to get call id of the current dialog
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (value) CallId
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogGetCallId(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (value) CallId
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    return cs_CallId(v_Dialog.CallId);
  }

  /*
   * @desc      get latest RSeq value sent by the UE for an ongoing MT INVITE transaction
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (omit) integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogGetRemoteRSeq(template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (omit) integer
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    return v_Dialog.RemoteRSeq;
  }

  /*
   * @desc      set latest RSeq value sent by the UE for an ongoing MT INVITE transaction
   * @param     p_RSeq
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_DialogSetRemoteRSeq(template (omit) integer p_RSeq,
                                                 template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    if (isvalue(p_RSeq)) {
      v_Dialog.RemoteRSeq := valueof(p_RSeq);
    } else {
      v_Dialog.RemoteRSeq := omit;
    }
    fl_IMS_PTC_ImsInfo_SetDialog(p_DialogIndex, v_Dialog);
  }

  /*
   * @desc      return UE's contact address as provided in contact header of the REGISTER message or as provided in the INVITE (MO call) or and appropriate response (MT call)
   * @param     p_ContactUriType    (default value: registration)
   * @param     p_DialogIndex       (default value: omit)
   * @return    SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetContactUrlUE(IMS_ContactUriType_Type p_ContactUriType := registration,
                                             template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return SipUrl
  { /* @sic R5s150908: contact URI for dialogs sic@ */
    var IMS_DialogInfo_Type v_Dialog;
    var template (omit) SipUrl v_ContactUri := omit;

    select (p_ContactUriType) {
      case (registration) {
        v_ContactUri := vc_IMS_Global.ImsInfo.Registration.ContactUrl;
      }
      case (dialog) {
        v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
        v_ContactUri := v_Dialog.ContactUrlUE;
      }
    }
    if (not isvalue(v_ContactUri)) {
      FatalError(__FILE__, __LINE__, "no valid contact uri stored at IMS PTC");
    }
    return valueof(v_ContactUri);
  }

  /*
   * @desc      wrapper function setting URI parameters to any-or-omit
   * @param     p_ContactUriType    (default value: registration)
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (present) SipUrl
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetContactUrlUE_RX(IMS_ContactUriType_Type p_ContactUriType := registration,
                                                template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (present) SipUrl
  {
    var template (present) SipUrl v_ContactUri := f_IMS_PTC_ImsInfo_GetContactUrlUE(p_ContactUriType, p_DialogIndex);

    v_ContactUri.urlParameters := *;
    return v_ContactUri;
  }

  /*
   * @desc      set the UE's contact address for registration or a given dialog
   * @param     p_ContactUrl
   * @param     p_ContactUriType    (default value: registration)
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_SetContactUrlUE(SipUrl p_ContactUrl,
                                             IMS_ContactUriType_Type p_ContactUriType := registration,
                                             template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  { /* @sic R5s150908: contact URI for dialogs sic@ */
    var IMS_DialogInfo_Type v_Dialog;

    select (p_ContactUriType) {
      case (registration) {                  /* shall be used when subsequent REGISTER has been received during registration */
        vc_IMS_Global.ImsInfo.Registration.ContactUrl := p_ContactUrl;
      }
      case (dialog) {                       /* to set contact URI for given dialog @sic R5s150908 sic@ */
        v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
        v_Dialog.ContactUrlUE := p_ContactUrl;
        fl_IMS_PTC_ImsInfo_SetDialog(p_DialogIndex, v_Dialog);
      }
    }
  }

  /*
   * @desc      return transport protocol (UDP/TCP) to be used for requests in DL
   * @return    InternetProtocol_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetTransportProtocol() runs on IMS_PTC return InternetProtocol_Type
  {
    return vc_IMS_Global.ImsInfo.TransportProtocol;
  }

  /*
   * @desc      get CSeq for respective message
   * @param     p_CseqType
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (omit) integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_CseqGet(IMS_PTC_CseqType_Type p_CseqType,
                                     template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (omit) integer
  { /* @sic R5s140235: return value changed to "template (omit)" sic@ */
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    var template (omit) integer v_CseqValue;

    select (p_CseqType) {
      case (register)     { v_CseqValue := vc_IMS_Global.ImsInfo.Registration.Cseq; }
      case (dialogRemote) { v_CseqValue := v_Dialog.RemoteCseq; }
      case (dialogLocal)  { v_CseqValue := v_Dialog.LocalCseq; }
      case else { FatalError (__FILE__, __LINE__, ""); }
    }
    return v_CseqValue;
  }

  /*
   * @desc      get CSeq for respective message
   * @param     p_CseqType
   * @param     p_DialogIndex       (default value: omit)
   * @return    integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_CseqGetValue(IMS_PTC_CseqType_Type p_CseqType,
                                          template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return integer
  { /* @sic R5s140235: new function sic@ */
    var template (omit) integer v_Cseq := f_IMS_PTC_ImsInfo_CseqGet(p_CseqType, p_DialogIndex);

    if (not isvalue(v_Cseq)) {
      FatalError(__FILE__, __LINE__, "no valid Cseq yet");
    }
    return valueof(v_Cseq);
  }

  /*
   * @desc      set CSeq for respective message
   * @param     p_CseqType
   * @param     p_CseqValue
   * @param     p_DialogIndex       (default value: omit)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_CseqSet(IMS_PTC_CseqType_Type p_CseqType,
                                     integer p_CseqValue,
                                     template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC
  {
    var IMS_DialogInfo_Type v_Dialog := fl_IMS_PTC_ImsInfo_GetDialog(p_DialogIndex);
    select (p_CseqType) {
      case (register)     { vc_IMS_Global.ImsInfo.Registration.Cseq := p_CseqValue; }
      case (dialogRemote) { v_Dialog.RemoteCseq := p_CseqValue; }
      case (dialogLocal)  { v_Dialog.LocalCseq := p_CseqValue; }
      case else { FatalError (__FILE__, __LINE__, ""); }
    }
    fl_IMS_PTC_ImsInfo_SetDialog(p_DialogIndex, v_Dialog);
  }

  /*
   * @desc      increment CSeq for respective message
   * @param     p_CseqType
   * @param     p_DialogIndex       (default value: omit)
   * @return    integer
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_CseqIncr(IMS_PTC_CseqType_Type p_CseqType,
                                      template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return integer
  { /* @sic R5s140235: Cseq may be omit sic@ */
    var integer v_CseqValue := f_IMS_PTC_ImsInfo_CseqGetValue(p_CseqType, p_DialogIndex) + 1;
    f_IMS_PTC_ImsInfo_CseqSet(p_CseqType, v_CseqValue, p_DialogIndex);
    return v_CseqValue;
  }

  /*
   * @desc      return appropriate branch value
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_IMS_PTC_ImsInfo_GetNextBranch() runs on IMS_PTC return charstring
  { /* @sic R5s130561 change 4: addtional branch values sic@ */
    /* @sic R5s160540 change 2: more branch values sic@ */
    /* @sic R5s190963: more branch values sic@ */
    const CharStringList_Type tsc_TagList1 := { "1234567890", "2345678901", "3456789012", "4567890123", "5678901234", "6789012345", "7890123456", "8901234567", "9012345678", "0123456789",
                                                "0987654321", "9876543210", "8765432109", "7654321098", "6543210987", "5432109876", "4321098765", "3210987654", "2109876543", "1098765432",
                                                "0987654320", "9876543200", "8765432009", "7654320098", "6543200987", "5432009876", "4320098765", "3200987654", "2009876543", "0098765432",
                                                "0987654300", "9876543000", "8765430009", "7654300098", "6543000987", "5430009876", "4300098765", "3000987654", "0009876543", "0098765430",
                                                "0987654000", "9876540000", "8765400009", "7654000098", "6540000987", "5400009876", "4000098765", "0000987654", "0009876540", "0098765400",
                                                "0987650000", "9876500000", "8765000009", "7650000098", "6500000987", "5000009876", "0000098765", "0000987650", "0009876500", "0098765000",
                                                "0987600000", "9876000000", "8760000009", "7600000098", "6000000987", "0000009876", "0000098760", "0000987600", "0009876000", "0098760000" };
    const CharStringList_Type tsc_TagList2 := { "123456789a", "23456789a1", "3456789a12", "456789a123", "56789a1234", "6789a12345", "789a123456", "89a1234567", "9a12345678", "a123456789",
                                                "a987654321", "987654321a", "87654321a9", "7654321a98", "654321a987", "54321a9876", "4321a98765", "321a987654", "21a9876543", "1a98765432",
                                                "a98765432a", "98765432aa", "8765432aa9", "765432aa98", "65432aa987", "5432aa9876", "432aa98765", "32aa987654", "2aa9876543", "aa98765432",
                                                "a9876543aa", "9876543aaa", "876543aaa9", "76543aaa98", "6543aaa987", "543aaa9876", "43aaa98765", "3aaa987654", "aaa9876543", "aa9876543a",
                                                "a987654aaa", "987654aaaa", "87654aaaa9", "7654aaaa98", "654aaaa987", "54aaaa9876", "4aaaa98765", "aaaa987654", "aaa987654a", "aa987654aa",
                                                "a98765aaaa", "98765aaaaa", "8765aaaaa9", "765aaaaa98", "65aaaaa987", "5aaaaa9876", "aaaaa98765", "aaaa98765a", "aaa98765aa", "aa98765aaa",
                                                "a9876aaaaa", "9876aaaaaa", "876aaaaaa9", "76aaaaaa98", "6aaaaaa987", "aaaaaa9876", "aaaaa9876a", "aaaa9876aa", "aaa9876aaa", "aa9876aaaa" };
    var CharStringList_Type v_TagList;
    var charstring v_Branch;

    if (vc_IMS_Global.PdnIndex == PDN_1) {    /* @sic R5s170137: different branches for different PDNs sic@ */
      v_TagList := tsc_TagList1;
    } else {
      v_TagList := tsc_TagList2;
    }

    if (vc_IMS_Global.ImsInfo.BranchIndex >= lengthof(v_TagList)) {
      FatalError (__FILE__, __LINE__, "not enough branches");
    }

    v_Branch := c_branchCookie & v_TagList[vc_IMS_Global.ImsInfo.BranchIndex];
    vc_IMS_Global.ImsInfo.BranchIndex := vc_IMS_Global.ImsInfo.BranchIndex + 1;
    return v_Branch;
  }

