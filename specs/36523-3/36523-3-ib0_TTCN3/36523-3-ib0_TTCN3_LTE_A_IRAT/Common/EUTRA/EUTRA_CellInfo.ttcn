  /*
   * @desc      Return the EARFCN parameters (DL and UL) stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    integer
   * @status    APPROVED (ENDC, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_GetBand(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return integer
  { //@sic R5-163085 p_FrequencyBand type changed to integer sic@
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.Frequency.FrequencyBandIndicator;
  }

 /*
   * @desc      Return if the cell is on LAA Band 46
   * @param     p_CellId
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_IsLAA(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return boolean
  { //@sic R5-171366  sic@
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);

    return (v_CellInfo.Frequency.FrequencyBandIndicator == 46);
  }

