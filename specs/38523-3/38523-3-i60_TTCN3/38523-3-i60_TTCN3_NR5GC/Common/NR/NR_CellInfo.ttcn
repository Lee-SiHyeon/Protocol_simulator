  /*
   * @desc      Cell Info configuration uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup fields, used in MAC test 71112
   * @param     p_NR_CellId
   * @param     p_RACH_ConfigGeneric
   * @param     p_TotalNumberOfRA_Preambles
   * @param     p_Ssb_perRACH_OccasionAndCB_PreamblesPerSSB
   * @param     p_GroupBconfigured
   * @param     p_RA_ContentionResolutionTimer
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetUplinkConfigCommon(NR_CellId_Type p_NR_CellId,
                                                    template (value) RACH_ConfigGeneric p_RACH_ConfigGeneric,
                                                    template (value) RACH_ConfigCommon.totalNumberOfRA_Preambles p_TotalNumberOfRA_Preambles,
                                                    template (value) RACH_ConfigCommon.ssb_perRACH_OccasionAndCB_PreamblesPerSSB p_Ssb_perRACH_OccasionAndCB_PreamblesPerSSB,
                                                    template (value) RACH_ConfigCommon.groupBconfigured p_GroupBconfigured,
                                                    template (value) RACH_ConfigCommon.ra_ContentionResolutionTimer p_RA_ContentionResolutionTimer
                                                    ) runs on NR_BASE_PTC
 {  //Script failure lc add 20200605; for 71112
   var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

   if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){
       v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.rach_ConfigGeneric := valueof(p_RACH_ConfigGeneric);
       v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.totalNumberOfRA_Preambles := valueof(p_TotalNumberOfRA_Preambles);
       v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.ssb_perRACH_OccasionAndCB_PreamblesPerSSB := valueof(p_Ssb_perRACH_OccasionAndCB_PreamblesPerSSB);
       v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.groupBconfigured := valueof(p_GroupBconfigured);
       v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.ra_ContentionResolutionTimer := valueof(p_RA_ContentionResolutionTimer);
   }
   f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Return SIB2 of the cell
   * @param     p_NR_CellId
   * @return    SIB2
   * @status    APPROVED (NR5GC)
   */
  function f_NR_GetSIB2(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SIB2
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (not isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib2)) {  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
      FatalError(__FILE__, __LINE__, "SIB2 not found");
    }
    return v_NR_CellInfo.Sysinfo.BcchInfo.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib2;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
  }

  /*
   * @desc      Get SIB4 in the cell
   * @param     p_NR_CellId
   * @return    InterFreqCarrierFreqList
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_CellInfo_GetSIB4_InterFreqCarrierFreqList(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return InterFreqCarrierFreqList
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var InterFreqCarrierFreqList v_InterFreqCarrierFreqList;
    select (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination) {
      case (NR_4, NR_7, NR_32, NR_35) {
        v_InterFreqCarrierFreqList := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[1].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
      }
      case (NR_5) {
        v_InterFreqCarrierFreqList := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[2].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList;  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
      }
    }
    return v_InterFreqCarrierFreqList;
  }

  /*
   * @desc      Get SIB19
   * @param     p_NR_CellId
   * @return    SIB19_r17
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_GetSIB19(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SIB19_r17
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var SIB19_r17 v_SIB19;

    select (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination) {
      //case (NR_28) /*@sic R5-253084 sic@*/
      case (NR_29) {
        v_SIB19 := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[1].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700;
      }
      case (NR_32, NR_35, NR_40) { /*@sic R5-261589 sic@*/
        v_SIB19 := v_NR_CellInfo.Sysinfo.BcchInfo.SIs[2].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib19_v1700;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
      }
    }
    return v_SIB19;
  }

