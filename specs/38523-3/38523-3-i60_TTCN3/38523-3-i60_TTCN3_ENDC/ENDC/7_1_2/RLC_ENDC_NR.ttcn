    f_NR_AS_CipheringAlgorithm_Set(nea0); // @sic R5s190254 ch. 1.1 sic@
    
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB2); // SNsize 18 by default
     
    v_DRB_ToAddModList[0] := cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config);
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2,
                                                     -,
                                                     ms400, // t_PollRetransmit
                                                     infinity_,
                                                     infinity_,
                                                     -,
                                                     -,
                                                     ms150, // t_Reassembly
                                                     ms300); // t_StatusProhibit
    
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_ConfigAM_UM(nr_Cell1, 1, 0, v_SS_Drb_ConfigList, v_RLC_BearerConfigList, -, v_DRB_ToAddModList);
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.AM_SN_Size := 18;
    v_RLC_Rec.t_Reassembly := 0.15;
    v_RLC_Rec.t_StatusProhibit := 0.3;
    v_RLC_Rec.t_PollRetransmit := 0.4;
    
    // Synchronize with the EUTRA PTC
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Start TestBody"); // @sic R5s190163, R5s190254, R5s190541 sic@
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_8_NR_TestBody (v_RLC_Rec, tsc_NR_DRB2);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.9.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_2_3_9_ENDC_NR() runs on ENDC_NR_PTC
  { // AM RLC / Reassembling of AMD PDUs
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (omit)  NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) DRB_ToAddModList  v_DRB_ToAddModList;
    
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0); // @sic R5s190254 ch. 1.1 sic@
    
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB2); // SNsize 18 by default
    
    v_DRB_ToAddModList[0] := cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config);
    
    // Establishing UL AM RLC  parameters
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2,
                                                     -,
                                                     ms500, // t_PollRetransmit
                                                     -,
                                                     -,
                                                     -,
                                                     -,
                                                     ms150, // t_Reassembly
                                                     ms300);  // t_StatusProhibit
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_ConfigAM_UM(nr_Cell1, 1, 0, v_SS_Drb_ConfigList, v_RLC_BearerConfigList, -, v_DRB_ToAddModList);
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.AM_SN_Size := 18;
    v_RLC_Rec.t_PollRetransmit := 0.5;
    v_RLC_Rec.t_Reassembly := 0.15;
    v_RLC_Rec.t_StatusProhibit := 0.3;
    
    // Synchronize with the EUTRA PTC
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Start TestBody"); // @sic R5s190163, R5s190254, R5s190541 sic@
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_9_NR_TestBody (v_RLC_Rec, tsc_NR_DRB2);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.10.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_2_3_10_ENDC_NR() runs on ENDC_NR_PTC
  { // AM RLC / Re-transmission of RLC PDU with and without re-segmentation
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var DL_t_Reassembly_Type v_T_Reassembly;
    var template (omit)  NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) DRB_ToAddModList  v_DRB_ToAddModList;
    
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0); // @sic R5s190254 ch. 1.1 sic@
    
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB2); // SNsize 18 by default
    
    v_DRB_ToAddModList[0] := cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config);
    v_T_Reassembly := f_NR_DL_AM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1));
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2,
                                                     -,
                                                     ms150, // t_PollRetransmit
                                                     -,
                                                     -,
                                                     -,
                                                     -,
                                                     v_T_Reassembly);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_ConfigAM_UM(nr_Cell1, 1, 0, v_SS_Drb_ConfigList, v_RLC_BearerConfigList, -, v_DRB_ToAddModList);
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.AM_SN_Size := 18;
    v_RLC_Rec.t_PollRetransmit := 0.15;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};
    
    // Synchronize with the EUTRA PTC
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Start TestBody"); // @sic R5s190163, R5s190254, R5s190541 sic@
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_10_NR_TestBody (v_RLC_Rec, tsc_NR_DRB2);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.11.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_2_3_11_ENDC_NR() runs on ENDC_NR_PTC
  { // AM RLC / RLC re-establishment procedure
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (omit)  NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var template (value) DRB_ToAddModList  v_DRB_ToAddModList;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    
    f_ENDC_NR_Init();

    //Set sr-transmax to 64
    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(nr_Cell1);
    v_MAC_CellGroupConfig.schedulingRequestConfig.schedulingRequestToAddModList[0].sr_TransMax := n64; // @sic R5s250330 sic@
    f_NR_CellInfo_SetMAC_CellGroupConfig(nr_Cell1, v_MAC_CellGroupConfig); // @sic R5s191200_r2 sic@
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0); // @sic R5s190254 ch. 1.1 sic@
    
    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB2); // SNsize 18 by default
    
    v_DRB_ToAddModList[0] := cs_38508_DRB_ToAddMod(tsc_NR_DRB2, cs_38508_PDCP_Config(-, ms160, omit)); //statusReportRequired not present @sic R5-194296, R5-227518 sic@
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(tsc_NR_DRB2, -, ms4000, -, -, -, -, ms200); // @sic R5s191200 sic@

    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_ConfigAM_UM(nr_Cell1, 1, 0, v_SS_Drb_ConfigList, v_RLC_BearerConfigList, -, v_DRB_ToAddModList);
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.t_PollRetransmit := 4.0; // @sic R5s191200 sic@
    v_RLC_Rec.t_Reassembly := 0.2; // @sic R5s191200 sic@
    
    // Synchronize with the EUTRA PTC
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Start TestBody"); // @sic R5s190163, R5s190254, R5s190541 sic@
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_3_11_NR_TestBody (v_RLC_Rec, tsc_NR_DRB2);
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.3.11
   * @param     p_RLC_Rec
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_2_3_11_NR_TestBody(NR_RLC_SS_State_Type p_RLC_Rec,
                                           DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC
  { // AM RLC / RLC re-establishment procedure
  //@sic R5-194296 sic@
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var NR_RLC_DataFieldList_Type v_NR_RLC_DataList;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (present) NR_RLC_AMD_PDU_Type v_NR_RLC_AMD_PDU_Expected;
    var template (present) NR_RLC_PDUList_Type v_NR_RLC_PDUList;
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;

    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_AM(p_NR_DRB_Id, -, ms4000, -, -, -, -, ms200, -, true_); // @sic R5s191200 sic@
    v_CellGroupConfig := f_NR_GetCellGroupConfigHO (nr_Cell1, v_RLC_BearerConfigList); //tsc_C_RNTI_Value3
    
    v_NR_RLC_DataList := f_TC_7_1_2_3_11_NR_Steps1To4(p_RLC_Rec, p_NR_DRB_Id);

    // @siclog "Steps 5" siclog@
    //The SS transmits NR RRCReconfiguration message to trigger RLC re-establishment on DRB using Reconfig with sync procedure
    //The UE transmits a NR RRCReconfigurationcomplete message.
    // Reconfiguration Msg to be transmitted on E-UTRA side for ENDC tc or NR side for NR5GC tc
    f_NR_RLC_ReconfigurationHO_ENDC (nr_Cell1,
                                     v_RLC_BearerConfigList,
                                     cs_38508_PDCP_Config(-, ms160, omit), // @sic R5-227518 sic@
                                     -,
                                     v_CellGroupConfig,
                                     false); // @sic R5-204512 sic@

    // @siclog "Step 6" siclog@
    //The SS starts the UL default grant transmissions
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s191200, R5-204512 sic@

    //EXCEPTION: Steps 7 and 8 can occur in any order.
    // @siclog "Step 7" siclog@
    //The UE transmits a NR RRCReconfigurationComplete message.
    // @siclog "Step 8" siclog@
    //The UE retransmits RLC SDU #1 (SN=0).
    p_RLC_Rec.AM_RX_Next := 0; // only update of the RLC record which is needed @sic R5s201335 sic@
    v_NR_RLC_AMD_PDU_Expected := f_NR_RLC_Get_AMD_FullSDU_RX(p_RLC_Rec, ?, v_NR_RLC_DataList[tsc_RLC_SDU1]);
    v_NR_RLC_PDUList := { cr_NR_RLC_PDU_AMD(v_NR_RLC_AMD_PDU_Expected) };

    interleave { // @sic R5-204512 sic@
      []  EUTRA.receive(cmr_EUTRA_NR_OctetData( "Complete")) -> value v_ReceivedMsg
        { f_NR_CheckReceived_RRCReconfigurationComplete(v_ReceivedMsg); }
      []  DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(nr_Cell1,
                                                        p_NR_DRB_Id,
                                                        -,
                                                        v_NR_RLC_PDUList)) -> value v_NR_DRB_COMMON_IND
        { p_RLC_Rec.TimeStampLastReceivedPDU := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame; }
    }

    f_TC_7_1_2_3_11_NR_Steps9To15(p_RLC_Rec, p_NR_DRB_Id, v_NR_RLC_DataList); // @sic R5s191200, R5-204512 sic@

  }

}
