    if (i == -1) {//Galileo element was not found in the list
      FatalError (__FILE__, __LINE__, "Invalid CellId"); // This function is only called if PICS indicate Galileo support. If Galileo assistance data is not there, it is a FatalError
    }
    else {
      //Include all possible elements in the template
      // @sic R5-240554 sic@
      v_GenericAssistDataElement := cs_GNSS_GenericAssistDataElement(cs_GNSS_ID_Galileo,
