module UpperTesterFunctions {

  import from CommonDefs all;
  import from IMS_CommonParameters all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UpperTesterCommon all;
  import from UpperTesterPtcToMtcDefs all;

  type enumerated UT_PDU_Request_Type {Normal, Emergency, MA}; /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS) */

  const integer tsc_ManualPLMN_GERAN := 0;                      /* @status    APPROVED (LTE_IRAT) */

  const integer tsc_ManualPLMN_None := -1;                      /* @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT) */

  const charstring tsc_RandomAPN := "ABCC"; /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT, NR5GC, POS, SSNITZ, UTRAN) */

  template (value) UT_COMMON_CMD cas_UT_Req(template (value) Ut_Common_Req_Type p_Cmd,
                                            template (value) Ut_CnfReq_Type p_Cnf,
                                            template (omit)  Ut_ParameterList_Type p_Parameters := omit) :=
  {   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    Cmd := p_Cmd,
    CnfReq := p_Cnf,
    ParameterList := p_Parameters
  };

  template (value) Ut_Parameter_Type cs_Ut_Parameter_Cid(charstring p_Value) :=
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("Cid", p_Value);

  template (value) Ut_Parameter_Type cs_Ut_Parameter_QoS(charstring p_Value) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("QoS", p_Value);

  template (value) Ut_Parameter_Type cs_Ut_Parameter_PLMN(charstring p_Value) :=
    /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS) */
    cs_Ut_Parameter_Common("PLMN", p_Value);

  template (value) Ut_ParameterList_Type cs_CEMode(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT) */
    cs_Ut_Parameter_Common("CE MODE", p_Value)
  };

  template (value) Ut_ParameterList_Type cs_CheckPlmn(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC_IRAT) */
    cs_Ut_Parameter_PLMN(p_Value)
  };

  template (value) Ut_ParameterList_Type cs_UplinkData(charstring p_Data,
                                                       charstring p_Sapi) :=
  { /* @status    APPROVED (LTE_IRAT) */
    cs_Ut_Parameter_Common("DATA", p_Data),
    cs_Ut_Parameter_Common("SAPI", p_Sapi)
  };

  template (value) Ut_ParameterList_Type cs_ManualPlmn(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT) */
    /* @sic R5-106675 sic@ */
    cs_Ut_Parameter_PLMN(p_Value)
  };

  template (value) Ut_ParameterList_Type cs_PlmnCSG(charstring p_PLMN,
                                                    charstring p_CSG,
                                                    charstring p_RAT) :=
  { /* @status    APPROVED (LTE, LTE_IRAT) */
    /* @sic R5-106675 sic@ */
    cs_Ut_Parameter_PLMN(p_PLMN),
    cs_Ut_Parameter_Common("CSG", p_CSG),
    cs_Ut_Parameter_Common("RAT", p_RAT)
  };

  template (value) Ut_ParameterList_Type cs_DialNumber(charstring p_Value) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("DIAL", p_Value)
  };

  template (value) Ut_ParameterList_Type cs_InsertUsim(template (value) charstring p_Value) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, UTRAN) */
    cs_Ut_Parameter_Common("USIM", p_Value)
  };

  template (value) Ut_ParameterList_Type cs_PDP_Cid(charstring p_Cid) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Cid(p_Cid)
  };

  template (value) Ut_ParameterList_Type cs_RequestPDP(charstring p_PDPParams) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Common("RequestPDP", p_PDPParams)
  };

  template (value) Ut_ParameterList_Type cs_QoS_Profile(charstring p_Cid,
                                                        charstring p_QoSParams) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    cs_Ut_Parameter_Cid(p_Cid),
    cs_Ut_Parameter_QoS(p_QoSParams)
  };

  template (value) Ut_Parameter_Type cs_Ut_Parameter_Uri(charstring p_Value)          := cs_Ut_Parameter_Common("Uri", p_Value);              /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  /*
   * @desc      local function to send command and get confirmation
   * @param     p_Port
   * @param     p_Cmd
   * @param     p_DontWaitForCnf    (default value: false)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_UT_ApplyCommand(UT_PTC_MTC_PORT p_Port,
                              template (value) UT_COMMON_CMD p_Cmd,
                              boolean p_DontWaitForCnf := false) // @sic R5-140347 sic@
  {
    p_Port.send(p_Cmd);
    if (f_UT_CommandRequiresCnf(p_Cmd.CnfReq) and not p_DontWaitForCnf) { // @sic R5s110275 sic@
      p_Port.receive(car_UT_COMMON_CNF);
    }
  }

  /*
   * @desc      To ask the UE to configure Combined Attach
   *            TTCN waits until operation is confirmed before continuing
   *            TTCN waits until operation is confirmed before continuing.
   *            If the CS PS mode to which p_UE_CS_PS_UsageSetting_Tested is set is supported then this mode is chosen.
   *            If it does not matter which mode is selected then a supported mode is chosen.
   *            If the prose requests a specific mode it should be indicated as explicit parameter.
   *            To be used when the UE is switched off.
   * @param     p_Port
   * @param     p_UE_CS_PS_UsageSetting_Tested (default value: px_UE_CS_PS_UsageSetting_Tested)
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_UT_ConfigureCombinedAttach(UT_PTC_MTC_PORT p_Port,
                                        CS_PS_MODE p_UE_CS_PS_UsageSetting_Tested := px_UE_CS_PS_UsageSetting_Tested)
  {
    var integer v_Mode := 1; // PS/CS Mode 1 // @sic R5-106675 sic@  @sic R5s120511 sic@
    var CS_PS_MODE v_UE_CS_PS_UsageSetting_Tested := p_UE_CS_PS_UsageSetting_Tested; // Whether UE is voice or data centric
    
    // The attach mode is configured in the preamble. The UE is switched on to reach a mode where AT command setting is possible.
    f_UT_SwitchOnUE(p_Port, false, CNF_REQUIRED); // @sic R5s120597r1 sic@
    
    if ((v_UE_CS_PS_UsageSetting_Tested == DATA_CENTRIC) and pc_CS_PS_data_centric) {
      v_UE_CS_PS_UsageSetting_Tested := DATA_CENTRIC;
    }
    else if ((v_UE_CS_PS_UsageSetting_Tested == VOICE_CENTRIC) and pc_CS_PS_voice_centric) {
      v_UE_CS_PS_UsageSetting_Tested := VOICE_CENTRIC;
    }
    else {
      FatalError(__FILE__, __LINE__, "Invalid Usage Settings, please check pc_CS_PS_data_centric, pc_CS_PS_voice_centric and px_UE_CS_PS_UsageSetting_Tested"); // @sic R5s130828 add. change sic@
    }
    if (pc_Combined_Attach) { // The message is only needed if both options are supported; @sic R5-103815 sic@ @sic R5s120079r1 sic@
      if (v_UE_CS_PS_UsageSetting_Tested == DATA_CENTRIC) {// @sic R5-106675 sic@
        v_Mode := 2; // PS/CS Mode 2
      }
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(CONFIGURE_CEMODE, CNF_REQUIRED, cs_CEMode(int2str(v_Mode)))); // @sic R5-106675 sic@
    }
    else {
      FatalError(__FILE__, __LINE__, "inconsistent parameter setting");
    }
    
    // The attach mode is configured in the preamble. At the end the UE is switched off properly.
    f_UT_SwitchOffUE(p_Port, false, CNF_REQUIRED); // @sic R5s120597r1 sic@
    
  } // f_UT_ConfigureCombinedAttach

  /*
   * @desc      To ask the UE to configure EPS Attach
   *            TTCN waits until operation is confirmed before continuing.
   *            If the PS mode to which p_UE_PS_UsageSetting_Tested is set is supported then this mode is chosen.
   *            If it does not matter which mode is chosen then a supported mode is chosen.
   *            If the prose requests a specific mode it should be indicated as explicit parameter.
   *            To be used when the UE is switched off.
   * @param     p_Port
   * @param     p_UE_PS_UsageSetting_Tested (default value: px_UE_PS_UsageSetting_Tested)
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_UT_ConfigureEPSAttach(UT_PTC_MTC_PORT p_Port,
                                   PS_MODE p_UE_PS_UsageSetting_Tested := px_UE_PS_UsageSetting_Tested)
  {
    var integer v_Mode := 0; // PSMode 2 // @sic R5-106675 sic@ @sic R5s120511r1 sic@
    var PS_MODE v_UE_PS_UsageSetting_Tested := p_UE_PS_UsageSetting_Tested;
    
    // The attach mode is configured in the preamble. The UE is switched on to reach a mode where AT command setting is possible.
    f_UT_SwitchOnUE(p_Port, false, CNF_REQUIRED); // @sic R5s120597r1 sic@
    
    if ((v_UE_PS_UsageSetting_Tested == DATA_CENTRIC) and (pc_PS_data_centric == true)) {
      v_UE_PS_UsageSetting_Tested := DATA_CENTRIC;
    }
    else if ((v_UE_PS_UsageSetting_Tested == VOICE_CENTRIC) and (pc_PS_voice_centric == true)) {
      v_UE_PS_UsageSetting_Tested := VOICE_CENTRIC;
    }
    else {
      FatalError(__FILE__, __LINE__, "Invalid Usage Settings, please check pc_PS_data_centric, pc_PS_voice_centric and px_UE_PS_UsageSetting_Tested"); // @sic R5s130828 add. change sic@
    }
    if (pc_Attach) { // The message is only needed if both options are supported;  @sic R5-103815 sic@ @sic R5s120079r1 sic@
      if (v_UE_PS_UsageSetting_Tested == VOICE_CENTRIC) {// @sic R5-106675 sic@
        v_Mode := 3; // PS Mode 1
      }
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(CONFIGURE_CEMODE, CNF_REQUIRED, cs_CEMode(int2str(v_Mode)))); // @sic R5-106675 sic@
    }
    else {
      FatalError(__FILE__, __LINE__, "inconsistent parameter setting");
    }
    // The attach mode is configured in the preamble. At the end the UE is switched off properly.
    f_UT_SwitchOffUE(p_Port, false, CNF_REQUIRED); // @sic R5s120597r1 sic@
    
  } // f_UT_ConfigureEPSAttach

  /*
   * @desc      To ask the operator disable EPS in the UE
   *            TTCN does not wait until operation is confirmed before continuing
   *            because the UE may send a DETACH immediately @sic R5s110694 sic@
   * @param     p_Port
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UT_DisableEPS(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(DISABLE_EPS, NO_CNF_REQUIRED));
  }

  /*
   * @desc      Objective: To make the operator aware that has to remove the USIM card
   * @param     p_Port
   * @param     p_CnfRequired       (default value: CNF_REQUIRED)
   * @param     p_Description       (default value: omit)
   * @status    APPROVED (IMS_IRAT, LTE, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC)
   */
  function f_UT_USIM_Remove(UT_PTC_MTC_PORT p_Port, Ut_CnfReq_Type p_CnfRequired := CNF_REQUIRED, template (omit) charstring p_Description := omit)
  {
    var template (omit)  Ut_ParameterList_Type v_Parameters := omit;
    
    if (isvalue(p_Description)) { // @sic R5-235423 sic@
      v_Parameters := {cs_Ut_Parameter_Common("USIM", valueof(p_Description))};
    }

    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REMOVE_USIM, p_CnfRequired, v_Parameters)); // @sic R5s180172, R5-236316 sic@
  }

  /*
   * @desc      Objective: To make the operator insert the USIM card
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @param     p_USIM_ID
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, UTRAN)
   */
  function f_UT_USIM_Insert(UT_PTC_MTC_PORT p_Port,
                            template (omit) charstring p_USIM_ID)
  {
    if (isvalue(p_USIM_ID)) {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(INSERT_USIM, CNF_REQUIRED, cs_InsertUsim(valueof(p_USIM_ID))));
    } else {
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(INSERT_USIM, CNF_REQUIRED));
    }
  }

  /*
   * @desc      Objective: To power off the UE
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_PowerOffUE(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(POWER_OFF, CNF_REQUIRED));
  }

  /*
   * @desc      switch on the UE
   * @param     p_Port
   * @param     p_USIM_Rmvd         (default value: false)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_SwitchOnUE(UT_PTC_MTC_PORT p_Port,
                           boolean p_USIM_Rmvd := false,
                           Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var Ut_Common_Req_Type v_Request;

    if (pc_SwitchOnOff) {        // switch on the UE
      v_Request := SWITCH_ON;
    } else if (p_USIM_Rmvd and pc_USIM_Removal) {       // USIM needs to be removed @sic R5s120597r1 sic@
      v_Request := INSERT_USIM;
    } else {                            // power on the UE
      v_Request := POWER_ON;
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(v_Request, p_CnfRequired));
  }

  /*
   * @desc      switch off the UE
   * @param     p_Port
   * @param     p_USIM_Rmvd
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @param     p_DontWaitForCnf    (default value: false)
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_SwitchOffUE(UT_PTC_MTC_PORT p_Port,
                            boolean p_USIM_Rmvd,
                            Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED,
                            boolean p_DontWaitForCnf := false)
  {
    if (pc_SwitchOnOff) {        // switch off the UE
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(SWITCH_OFF, p_CnfRequired), p_DontWaitForCnf);  //  @sic R5s110395, R5s220417 sic@
    } else if (p_USIM_Rmvd and pc_USIM_Removal) {  // UE doesn't support switch off, but does support SIM removal, so remove it;  @sic R5-104083 sic@ @sic R5s120597r1 sic@
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(REMOVE_USIM, CNF_REQUIRED));
    } else {                            // power off the UE - last resort
      fl_UT_ApplyCommand(p_Port, cas_UT_Req(POWER_OFF, CNF_REQUIRED));
    }
  } // f_UT_SwitchOffUE

  /*
   * @desc      To ask the operator to dial a CS call
   * @param     p_Port
   * @param     p_NumToDial         (default value: "01234567890")
   * @param     p_CSData            (default value: false)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_RequestCSCall(UT_PTC_MTC_PORT p_Port,
                              charstring p_NumToDial := "01234567890",
                              boolean p_CSData := false,
                              Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var charstring v_StringToDial := p_NumToDial;
    if (not p_CSData) { // @sic R5s150980 sic@
      v_StringToDial := v_StringToDial &";";
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_CALL, p_CnfRequired, cs_DialNumber(v_StringToDial))); // @sic R5s180172 sic@
  }

  /*
   * @desc      To ask the operator to dial an IMS call
   * @param     p_Port
   * @param     p_NumToDial         (default value: px_IMS_CalleeUri)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_RequestIMSCall(UT_PTC_MTC_PORT p_Port,
                               charstring p_NumToDial := px_IMS_CalleeUri, // @sic R5s220215 sic@
                               Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED)
  {
    var boolean v_DontWaitForCnf := true;
    var charstring v_NumToDial := p_NumToDial;
    
    // @sic R5s220215 sic@
    if (regexp (p_NumToDial, "([0-9]+)", 0) != "") { // If string is a number, have to convert this into a URI @sic R5s220509 sic@
      v_NumToDial := "tel:" & v_NumToDial;
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_IMS_VOICE_CALL, p_CnfRequired, {cs_Ut_Parameter_Uri(v_NumToDial)}), v_DontWaitForCnf); // @sic R5-134290, R5-145723, R5s160855 sic@
  }

  /*
   * @desc      To ask the operator to dial an IMS call
   * @param     p_Port
   * @param     p_NumToDial         (default value: px_EmergencyCallNumber)
   * @param     p_CnfRequired       (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_RequestIMSEmergencyCall(UT_PTC_MTC_PORT p_Port,
                                        charstring p_NumToDial := px_EmergencyCallNumber,
                                        Ut_CnfReq_Type p_CnfRequired := NO_CNF_REQUIRED) // set to LOCAL_CNF_REQUIRED if followed by e.g. a timer
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_IMS_VOICE_CALL, p_CnfRequired, {cs_Ut_Parameter_Uri(p_NumToDial)})); // @sic R5-134290, R5s230789  sic@
  }

  /*
   * @desc      Objective: To make the operator check the indicated PLMN
   *            TTCN waits until operation is confirmed before continuing
   * @param     p_Port
   * @param     p_PLMN_ID
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC_IRAT)
   */
  function f_UT_PLMN_Check(UT_PTC_MTC_PORT p_Port,
                           charstring p_PLMN_ID)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(CHECK_PLMN, CNF_REQUIRED, cs_CheckPlmn(p_PLMN_ID)));
  }

  /*
   * @desc      To set manual PLMN selection and select PLMNN (i.e. both of the above in 1 function)
   * @param     p_Port
   * @param     p_PLMN_ID
   * @param     p_Cell_AccessTechnology (default value: tsc_ManualPLMN_None)
   * @param     p_Ut_CnfReq_Type    (default value: NO_CNF_REQUIRED)
   * @status    APPROVED (LTE, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_ManualPLMN_Select(UT_PTC_MTC_PORT p_Port,
                                  NAS_PlmnId p_PLMN_ID,
                                  integer p_Cell_AccessTechnology := tsc_ManualPLMN_None, // @sic R5-106675 sic@ - only set this if the prose says e.g. 'select PLMN9 (UTRAN)'; options are _GERAN, _NR or _EUTRA
                                  Ut_CnfReq_Type p_Ut_CnfReq_Type := NO_CNF_REQUIRED) // @sic R5s110633 sic@
  { /* Objective: To manually select the specified PLMN
     *            TTCN waits until operation is confirmed before continuing */
    /* @sic R5-106675 sic@ */
    var charstring v_AT := """" & f_ConvertPLMNtoString(p_PLMN_ID) & """"; // @sic R5s160365 sic@

    if (p_Cell_AccessTechnology != tsc_ManualPLMN_None) {
      v_AT := v_AT & "," & int2str(p_Cell_AccessTechnology);
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PLMN_MANUAL, p_Ut_CnfReq_Type, cs_ManualPlmn(v_AT))); // @sic R5s110633 sic@
  }

  /*
   * @desc      To convert the PLMN in NAS format into that required by the AT command
   * @param     p_PLMN_ID
   * @return    charstring
   * @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_ConvertPLMNtoString(NAS_PlmnId p_PLMN_ID) return charstring
  { /* @sic R5-106675, R5s160365 sic@ */
    var hexstring v_PLMN_Hex := oct2hex(p_PLMN_ID); // Now re-order it for the AT command
    var hexstring v_PLMN_ForAT := v_PLMN_Hex[1] & v_PLMN_Hex[0] & v_PLMN_Hex[3] & v_PLMN_Hex[5] & v_PLMN_Hex[4];
    
    if (v_PLMN_Hex[2] != 'F'H) { // @sic R5s120576 sic@
      v_PLMN_ForAT := v_PLMN_ForAT & v_PLMN_Hex[2];
    }
    return hex2str(v_PLMN_ForAT); // @sic R5s160365 sic@
  }

  type charstring UT_RAT_Type ("EUTRA", "UTRAN");  /* @status    APPROVED (LTE, LTE_IRAT) */

  /*
   * @desc      To request manual PLMN selection of a CSG
   * @param     p_Port
   * @param     p_PLMN_ID
   * @param     p_CSG_ID
   * @param     p_RAT               (default value: "EUTRA")
   * @status    APPROVED (LTE, LTE_IRAT)
   */
  function f_UT_ManualPLMN_CSG(UT_PTC_MTC_PORT p_Port,
                               NAS_PlmnId p_PLMN_ID,
                               bitstring p_CSG_ID,
                               UT_RAT_Type p_RAT := "EUTRA")
  { /* Objective: To ask the operator to manually select the specified CSG cell TTCN waits until operation is confirmed before continuing */
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(SELECT_CSG, NO_CNF_REQUIRED, cs_PlmnCSG(f_ConvertPLMNtoString(p_PLMN_ID), int2str(bit2int(p_CSG_ID)), p_RAT)));  // @sic R5s120298, R5s150982 sic@
  }

  /*
   * @desc      To request automatic PLMN selection
   * @param     p_Port
   * @status    APPROVED (LTE, LTE_A_PRO, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT)
   */
  function f_UT_AutomaticPLMN_Select(UT_PTC_MTC_PORT p_Port)
  { /* Objective: To change the UE into automatic mode */
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(PLMN_AUTOMATIC, LOCAL_CNF_REQUIRED)); // @sic R5-106675, R5s180214 sic@
  }

  /*
   * @desc      To deactivate either an EPS bearer or UTRAN/GERAN PDP context
   * @param     p_Port
   * @param     p_DedicatedId
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, POS)
   */
  function f_UT_DeactivateBearer(UT_PTC_MTC_PORT p_Port,
                                 integer p_DedicatedId)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(DEACTIVATE_BEARER, NO_CNF_REQUIRED, cs_PDP_Cid(int2str(p_DedicatedId))));
  }

  /*
   * @desc      To create a PDP context on either UTRAN or GERAN
   * @param     p_Port
   * @param     p_CId
   * @param     p_QoSstring
   * @param     p_APN               (default value: tsc_RandomAPN)
   * @param     p_NSLPI             (default value: -1)
   * @status    APPROVED (LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UT_ActivatePDPContextUG(UT_PTC_MTC_PORT p_Port,
                                     integer p_CId,
                                     charstring p_QoSstring, // @sic R5-192186 sic@
                                     charstring p_APN := tsc_RandomAPN, // @sic R5s160680 sic@
                                     integer p_NSLPI := -1)
  {
    var charstring v_PDP_CtxtString := "";
    
    // string produced: "p_PDP_Type","p_AccessPointName","p_PDP_Address" - this field is no longer included
    if (p_APN != "") {
      v_PDP_CtxtString := """" & p_APN & """";
    }
    
    if (p_NSLPI >= 0) { // @sic R5-140628 sic@
       v_PDP_CtxtString := v_PDP_CtxtString & ",,,,,,,," & int2str (p_NSLPI) ;
    }
    // @sic C1-141830 sic@

    fl_RequestPDPContext(p_Port, p_CId, v_PDP_CtxtString);
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(DEFINE_QOS, CNF_REQUIRED, cs_QoS_Profile(int2str(p_CId), p_QoSstring))); // @sic R5s110570 sic@
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ACTIVATE_BEARER, NO_CNF_REQUIRED, cs_PDP_Cid(int2str(p_CId))));
  }

  /*
   * @desc      To build the start of the request for an additional PDN - to be associated with given bearer (p_BearerId)
   * @param     p_APN               (default value: "")
   * @param     p_EmergencyOrMABearer   (default value: Normal)
   * @return    charstring
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_BuildPDNRequest(charstring p_APN := "", // @sic R5s100466 sic@
                              UT_PDU_Request_Type p_EmergencyOrMABearer := Normal)  // @sic R5-120403 sic@
    return charstring
  {
    var charstring v_Cmd := "";
    var charstring v_CommasToReqType := ",,,,,";
    
    if (p_APN != "") {
      v_Cmd := """" & p_APN & """"; // @sic R5s100466, R5s100538 sic@
    }
    select (p_EmergencyOrMABearer) { // @sic R5-120403, R5-255822 sic@
      case (Emergency) {
        v_Cmd := v_Cmd & v_CommasToReqType & "1";
      }
      case (MA) {
        v_Cmd := v_Cmd & v_CommasToReqType & "5";
      }    }
    return v_Cmd;
  }

  /*
   * @desc      To request an PDP context - to be associated with an already existing bearer (p_BearerId)
   * @param     p_Port
   * @param     p_BearerId
   * @param     p_APN               (default value: "")
   * @param     p_EmergencyOrMABearer   (default value: Normal)
   * @param     p_NSLPI             (default value: -1)
   * @param     p_SpecialType       (default value: "")
   *             .. - specify if different to IP type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, POS)
   */
  function f_UT_RequestPDN(UT_PTC_MTC_PORT p_Port,
                        integer p_BearerId,
                        charstring p_APN := "", // @sic R5s100466 sic@
                        UT_PDU_Request_Type p_EmergencyOrMABearer := Normal,  // @sic R5-120403 sic@
                        integer p_NSLPI := -1, // @sic R5s130330 sic@
                        charstring p_SpecialType := "")
  {
    var charstring v_Cmd := fl_BuildPDNRequest(p_APN, p_EmergencyOrMABearer); // @sic R5-192186 sic@
    var charstring v_CommasToReqType := ",,,,,";
    var charstring v_CommasToNSLPI := ",,,";  // @sic R5-192186 sic@
    
    if (p_NSLPI >= 0) { // @sic R5-140628 sic@
      if (p_EmergencyOrMABearer == Normal) { // @sic R5-255822 sic@
        v_Cmd := v_Cmd & v_CommasToReqType & v_CommasToNSLPI;
      }
      v_Cmd := v_Cmd & int2str(p_NSLPI);
    }
    // @sic C1-141830 sic@
    
    fl_RequestPDPContext(p_Port, p_BearerId, v_Cmd, p_SpecialType); // @sic R5-244433 sic@
  }

  /*
   * @desc      To request an additional PDN connection - to be associated with an already existing bearer (p_BearerId)
   * @param     p_Port
   * @param     p_BearerId
   * @param     p_APN               (default value: "")
   * @param     p_EmergencyOrMABearer   (default value: Normal)
   * @param     p_Ut_CnfReq_Type    (default value: NO_CNF_REQUIRED)
   * @param     p_NSLPI             (default value: -1)
   * @param     p_SpecialType       (default value: "")
   *             .. - specify if different to IP type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, POS)
   */
  function f_UT_RequestAdditionalPDNConnectivity(UT_PTC_MTC_PORT p_Port,
                                                 integer p_BearerId,
                                                 charstring p_APN := "", // @sic R5s100466 sic@
                                                 UT_PDU_Request_Type p_EmergencyOrMABearer := Normal,  // @sic R5-120403 sic@
                                                 Ut_CnfReq_Type p_Ut_CnfReq_Type := NO_CNF_REQUIRED,
                                                 integer p_NSLPI := -1,
                                                 charstring p_SpecialType := "") // @sic R5s130330 sic@
  {
    f_UT_RequestPDN (p_Port, p_BearerId, p_APN, p_EmergencyOrMABearer, p_NSLPI, p_SpecialType); // @sic R5s150821, R5-244433 sic@
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ACTIVATE_BEARER, p_Ut_CnfReq_Type, cs_PDP_Cid(int2str(p_BearerId))));
  }

  /*
   * @desc      Used by LTE, UTRAN and GERAN to send the DCONT AT command
   * @param     p_Port
   * @param     p_BearerId
   * @param     p_RestOfCmd
   * @param     p_SpecialType       (default value: "")
   *             .. - specify if different to IP type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)
   */
  function fl_RequestPDPContext(UT_PTC_MTC_PORT p_Port,
                                integer p_BearerId,
                                charstring p_RestOfCmd,
                                charstring p_SpecialType := "")
  { // @sic R5s100466 change 5 sic@
    var charstring v_Cmd := "";
    var charstring v_Type := """IP""";
    
    if (p_SpecialType != "") {  // @sic R5-227473 sic@
      v_Type := p_SpecialType;
    } else {
      if (pc_IPv6 and (not pc_IPv4)) {
        v_Type := """IPV6""";
      }
      if (pc_IPv6 and pc_IPv4) {
        v_Type := """IPV4V6""";
      }
    }
    v_Cmd := v_Cmd & int2str(p_BearerId);
    v_Cmd := v_Cmd & "," & v_Type;
    
    if (p_RestOfCmd != "") { // @sic R5s120002 sic@
      v_Cmd := v_Cmd & "," & p_RestOfCmd; // @sic R5s100520 sic@
    }
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(REQUEST_PDPCONTEXT, CNF_REQUIRED, cs_RequestPDP(v_Cmd))); // @sic R5s110570 sic@
  }

  /*
   * @desc      To attach for PS services
   * @param     p_Port
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_IRAT, NBIOT, NR5GC, POS, SSNITZ, UTRAN)
   */
  function f_UT_TriggerAttach(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ATTACH, NO_CNF_REQUIRED));
  }

  /*
   * @desc      To detach
   * @param     p_Port
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS)
   */
  function f_UT_InitiateDetach(UT_PTC_MTC_PORT p_Port)  // @sic R5-113807 sic@
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(DETACH, NO_CNF_REQUIRED));
  }

  /*
   * @desc      To answer a call
   * @param     p_Port
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT, SSNITZ)
   */
  function f_UT_AnswerCall(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(ANSWER_CALL, NO_CNF_REQUIRED));
  }

  /*
   * @desc      To trigger the UE to send data uplink on the GERAN GPRS Sapi specified
   * @param     p_Port
   * @param     p_Data - the amount of uplink data to send
   * @param     p_Sapi = the GPRS SAPI to send the data on
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UT_GeranUplinkData(UT_PTC_MTC_PORT p_Port,
                                charstring p_Data,
                                charstring p_Sapi)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(GERAN_UPLINK_DATA, NO_CNF_REQUIRED, cs_UplinkData(p_Data, p_Sapi)));
  }

  /*
   * @desc      To trigger an HRPD PDN Connection
   * @param     p_Port
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UT_Trigger_HRPD_PDN_Connection(UT_PTC_MTC_PORT p_Port)
  {
    fl_UT_ApplyCommand(p_Port, cas_UT_Req(HRPD_PDN_CONNECTION, NO_CNF_REQUIRED));
  }

}
