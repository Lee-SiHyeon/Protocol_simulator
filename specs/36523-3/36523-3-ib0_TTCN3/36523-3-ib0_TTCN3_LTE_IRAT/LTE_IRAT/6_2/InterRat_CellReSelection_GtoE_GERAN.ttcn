    earfcnNC := cs_EUTRAN_NC_descr(p_XtdEARFCN, p_Priority, p_ThreshHigh, p_ThreshLow, p_EutranQrxLevelMin)  // only present if prefix = 1
  };

  template (value) EUTRAN_NC_descr cs_EUTRAN_NC_descr (template (value) RptdXTD_EARFCN_NC p_XtdEARFCN,
                                                       template (omit) B3_Type p_Priority := '100'B,
                                                       template (value) B5_Type p_ThreshHigh := '00010'B,
                                                       template (omit) B5_Type p_ThreshLow := '00010'B,
                                                       template (omit) B5_Type p_EutranQrxLevelMin := '10001'B) :=
  { /* @status    APPROVED (LTE_IRAT) */
    xtdEARFCN  := p_XtdEARFCN,
    priorMask  := f_ConvertBoolToBit(isvalue(p_Priority)),
    eutranPriority  := p_Priority, // not present if priorMask = 0
    threshEUTRANHigh := p_ThreshHigh,
    lowMask := f_ConvertBoolToBit(isvalue(p_ThreshLow)),
    threshEUTRANLow  := p_ThreshLow, // not present if lowMask = 0
    rxMask := f_ConvertBoolToBit(isvalue(p_EutranQrxLevelMin)),
    eutranQRxLevMin  := p_EutranQrxLevelMin // not present if rxMask = 0
  };

