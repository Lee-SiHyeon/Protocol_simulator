module MAC_PowerSaving_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_LoopBack all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_Measurement_Templates all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRC_Templates all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.12.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_12_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {//DRX adaptation / UE wakeup indication
    var template (omit) octetstring v_NR_SCGConfig := omit;
    // Logical channel prioritization handling
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter same Pre-test conditions as in clause 7.1.1.0 except that set to return no data in uplink.
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_1DRB(0, tsc_DRB2));
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
    
    //@siclog Steps 1-2 siclog@
    //SS transmits RRCReconfiguration to configure specific DCP parameters. (Note 1)
    //The UE transmits RRCReconfigurationComplete. (Note 2)
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

    //@siclog Steps 3-6 siclog@
    // On NR side
      
    //@siclog Steps 7-8 siclog@
    //SS transmits RRCReconfiguration to configure ps-wakeup with value true. (Note 1)
    //The UE transmits RRCReconfigurationComplete. (Note 2)
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    //@siclog Steps 9-11 siclog@
    // On NR side
      
    //@siclog Steps 12-13 siclog@
    //SS transmits RRCReconfiguration to configure ps-wakeup with value true. (Note 1)
    //The UE transmits RRCReconfigurationComplete. (Note 2)
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                          v_NR_SCGConfig);
      
    //@siclog Steps 14-19 siclog@
    // On NR side
      
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");
    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                          v_NR_SCGConfig,
                                          -,-,-,-,-,
                                          cs_Meassurement_Config_Gap_ENDC(cs_MeasGapConfig_setup_gp0(34))); //@sic R5s230531, R5-234451 sic@
      
      
    //@siclog Steps 20-24 siclog@
    // On NR side
      
    // Wait till test body is finished on the NR side
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    
    f_EUTRA_TestBody_Set(false);
    
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1); @sic R5s230130 sic@
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
      
    // Inform NR side that TCs is finished
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

}
