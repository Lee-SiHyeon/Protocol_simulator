module MCData_MCDataMessages {

  import from CommonDefs all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_Procedures_Common all;
  import from LibSip_MessageBodyTypes all;
  import from MCDataMessage_Common all;
  import from MCDataMessage_TypeDefs all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_Component all;
  import from MCX_SecurityFunctions all;
  import from MCX_SecurityParameters all;

  template (value) MCData_SDS_DispositionRequestType cs_MCData_SDS_DispositionRequestType(H1_Type p_Val) :=
  { /* @status    APPROVED (MCX) */
    iei := '8'H,
    val := p_Val
  };

  template (present) MCData_SDS_DispositionRequestType cr_MCData_SDS_DispositionRequestType(template (present) H1_Type p_Val) :=
  {/* @status    APPROVED (MCX) */
    iei := '8'H,
    val := p_Val
  };

  template (present) MCData_Payload cr_MCData_Payload(O1_Type p_IEI := '78'O,
                                                      O1_Type p_ContentType,
                                                      template (present) octetstring p_Content) :=
  { /* @status    APPROVED (MCX) */
    iei := p_IEI,
    iel := ?,
    contentType := p_ContentType,
    content := p_Content
  };

  template (value) MCData_Payload cs_MCData_Payload_TEXT(charstring p_Text := "Test") := cs_MCData_Payload(-, tsc_MCData_PayloadContentType_TEXT, char2oct(p_Text)); /* @status    APPROVED (MCX) */

  template (present) MCData_Payload cr_MCData_Payload_TEXT := cr_MCData_Payload(-, tsc_MCData_PayloadContentType_TEXT, ?);    /* @status    APPROVED (MCX) */

  template (present) MCData_ApplicationMetadata cr_MCData_ApplicationMetadata(O1_Type p_IEI := '53'O) :=
  { /* @status    APPROVED (MCX) */
    iei := p_IEI,
    iel := ?,
    content := ?
  };

  template (value) MCData_Message cs_MCData_SDS_SIGNALLING_PAYLOAD(integer p_TimestampSeconds,
                                                                   MCData_ConversationID p_ConversationID,
                                                                   MCData_MessageID p_MessageID,
                                                                   H1_Type p_DispositionRequestType) :=
  { /* @status    APPROVED (MCX) */
    SDS_SIGNALLING_PAYLOAD := {
      messageType := oct2bit('01'O),
      dateAndTime := int2oct(p_TimestampSeconds, 5),
      conversationID := p_ConversationID,
      messageID := p_MessageID,
      inReplyTo := omit,
      applicationID := omit,
      dispositionRequestType := cs_MCData_SDS_DispositionRequestType(p_DispositionRequestType),
      extendedApplicationID := omit,
      userLocation := omit,
      senderUserID := omit,
      applicationMetadata := omit    // @sic R5s221241: BASELINE MOVING 2022 09: new field sic@
    }
  };

  /*
   * @desc      Build up SDS SIGNALLING PAYLOAD to be sent to the UE
   * @param     p_DispositionRequestType
   * @return    template (value) MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_SDS_SIGNALLING_PAYLOAD_TX(H1_Type p_DispositionRequestType) return template (value) MCData_Message
  {
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var MCData_ConversationID v_ConversationID := '01010101010101010101010101010101'O;  // according to 36.579-1 Table 5.5.3.8.2-1
    var MCData_MessageID v_MessageID           := '01010101010101010101010101010101'O;  // according to 36.579-1 Table 5.5.3.8.2-1
    return cs_MCData_SDS_SIGNALLING_PAYLOAD(v_TimestampSeconds, v_ConversationID, v_MessageID, p_DispositionRequestType);
  }

  template (present) MCData_Message cr_MCData_SDS_SIGNALLING_PAYLOAD(template (present) H1_Type p_DispositionRequestType) :=
  { /* @status    APPROVED (MCX) */
    SDS_SIGNALLING_PAYLOAD := {
      messageType := oct2bit('01'O),
      dateAndTime := ?,
      conversationID := ?,
      messageID := ?,
      inReplyTo := omit,
      applicationID := omit,
      dispositionRequestType := cr_MCData_SDS_DispositionRequestType(p_DispositionRequestType),
      extendedApplicationID := omit,
      userLocation := *,
      senderUserID := omit,
      applicationMetadata := cr_MCData_ApplicationMetadata ifpresent  // @sic R5s221241: BASELINE MOVING 2022 09: new field sic@
    }
  };

  template (value) MCData_Message cs_MCData_SDS_NOTIFICATION(MCData_SDS_DispositionNotificationType p_DispositionNotificationType,
                                                             integer p_TimestampSeconds,
                                                             MCData_ConversationID p_ConversationID,
                                                             MCData_MessageID p_MessageID) :=
  { /* @status    APPROVED (MCX) */
    SDS_NOTIFICATION := {
      messageType := oct2bit('05'O),
      notificationType := p_DispositionNotificationType,
      dateAndTime := int2oct(p_TimestampSeconds, 5),
      conversationID := p_ConversationID,
      messageID := p_MessageID,
      applicationID := omit,
      extendedApplicationID := omit,
      senderUserID := omit
    }
  };

  /*
   * @desc      Build up SDS NOTIFICATION to be sent to the UE
   * @param     p_DispositionNotificationType
   * @param     p_SDS_SIGNALLING_PAYLOAD
   * @return    template (value) MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_SDS_NOTIFICATION_TX(MCData_SDS_DispositionNotificationType p_DispositionNotificationType,
                                        MCData_SDS_SIGNALLING_PAYLOAD p_SDS_SIGNALLING_PAYLOAD) return template (value) MCData_Message
  {
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    return cs_MCData_SDS_NOTIFICATION(p_DispositionNotificationType,
                                      v_TimestampSeconds,
                                      p_SDS_SIGNALLING_PAYLOAD.conversationID,
                                      p_SDS_SIGNALLING_PAYLOAD.messageID);
  }

  template (present) MCData_Message cr_MCData_SDS_NOTIFICATION(template (present) MCData_SDS_DispositionNotificationType p_DispositionNotificationType,
                                                               template (present) MCData_ConversationID p_ConversationID,
                                                               template (present) MCData_MessageID p_MessageID) :=
  { /* @status    APPROVED (MCX) */
    SDS_NOTIFICATION := {
      messageType := oct2bit('05'O),
      notificationType := p_DispositionNotificationType,
      dateAndTime := ?,
      conversationID := p_ConversationID,
      messageID := p_MessageID,
      applicationID := omit,
      extendedApplicationID := omit,
      senderUserID := omit
    }
  };

  /*
   * @desc       Build up SDS NOTIFICATION to be received from the UE
   * @param     p_DispositionNotificationType
   * @param     p_SDS_SIGNALLING_PAYLOAD
   * @return    template (present) MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_SDS_NOTIFICATION_RX(template (present) MCData_SDS_DispositionNotificationType p_DispositionNotificationType,
                                        template (value) MCData_SDS_SIGNALLING_PAYLOAD p_SDS_SIGNALLING_PAYLOAD) return template (present) MCData_Message
  {
    return cr_MCData_SDS_NOTIFICATION(p_DispositionNotificationType,
                                      p_SDS_SIGNALLING_PAYLOAD.conversationID,
                                      p_SDS_SIGNALLING_PAYLOAD.messageID);
  }

  template (value) MCData_Message cs_MCData_DATA_PAYLOAD(template (value) MCData_Payload p_Payload := cs_MCData_Payload_TEXT) :=
  { /* @status    APPROVED (MCX) */
    DATA_PAYLOAD := {
      messageType := oct2bit('03'O),
      numberOfPayloads := '01'O,
      protectedPayloads := {},
      payloads := { p_Payload }
    }
  };

  template (present) MCData_Message cr_MCData_DATA_PAYLOAD(template (present) MCData_Payload p_Payload := cr_MCData_Payload_TEXT) :=
  { /* @status    APPROVED (MCX) */
    DATA_PAYLOAD := {
      messageType := oct2bit('03'O),
      numberOfPayloads := '01'O,
      protectedPayloads := {},
      payloads := { p_Payload }
    }
  };

  template (present) MCData_Message cr_MCData_DATA_PAYLOAD_Protected1to1(B32_Type p_DPPK_Id) :=
  { // local template, used by f_MIME_DecodeAndMatchMCDataMessageWithEncryptedPayload
     /* @status    APPROVED (MCX) */
    DATA_PAYLOAD := {
      messageType := oct2bit('03'O),
      numberOfPayloads := '01'O,
      protectedPayloads := { cr_MCX_ProtectedPayloadMessage(oct2bit('7A'O), p_DPPK_Id) },
      payloads := {}
    }
  };

  template (present) MCData_ProtectedPayloadMessage cr_MCX_ProtectedPayloadMessage(template (present) MCData_MessageType p_MessageType := '01??????'B,
                                                                                   B32_Type p_DPPK_Id) :=
  {  /* @status    APPROVED (MCX) */
     /* MCData Protected Payload message as defined in 33.180 Clause 8.5.4 */
    messageType := p_MessageType,
    dateAndTime := ?,
    payloadId := ?,
    payloadSequenceNumber := ?,
    payloadAlgorithm := '01'O,          // AEAD_AES_128_GCM
    signallingAlgorithm := omit,
    initialisationVector := ?,
    dppkId := bit2oct(p_DPPK_Id),
    payload := ?,
    mikeySakkeIMessage := omit
  };

  /*
   * @desc      return ProtectedPayloadMessage without content according to 36.579-1 Table 5.5.9.1-3 (MCData Protected Payload message as defined in 33.180 Clause 8.5.4);
   *            the content (payload) needs to be added separately
   * @param     p_MessageType
   * @param     p_DPPK_Id
   * @return    template (value) MCData_ProtectedPayloadMessage
   * @status    APPROVED (MCX)
   */
  function fl_MCX_ProtectedPayloadMessageWithoutContentTX(MCData_MessageType p_MessageType,
                                                          B32_Type p_DPPK_Id) return template (value) MCData_ProtectedPayloadMessage
  {
    var integer v_TimestampSeconds := f_UTC_TimestampSeconds();
    var O4_Type v_PayloadId := '00000001'O;                     // 36.579-1 Table 5.5.3.10-2
    var O1_Type v_PayloadSequenceNumber := '01'O;               // 36.579-1 Table 5.5.3.10-2
    var O16_Type v_IV := 'DCB9085150B3CF21E2F7DF5B542C25C2'O;   // 36.579-1 Table 5.5.3.10-2

    return cs_MCX_ProtectedPayloadMessage(p_MessageType,
                                          v_TimestampSeconds,
                                          v_PayloadId,
                                          v_PayloadSequenceNumber,
                                          v_IV,
                                          p_DPPK_Id);
  }

  /*
   * @desc      Build-up Protected Payload Message, encrypt the data and encode the Protected Payload Message
   *            Used to protect a whole MCData message or content of MSRP SEND request
   * @param     p_MessageType
   * @param     p_Data
   * @param     p_KeyIndex
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_ProtectedPayloadMessage_SetupEncryptAndEncode(MCData_MessageType p_MessageType,
                                                               octetstring p_Data,
                                                               MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return octetstring
  {
    var template (omit) MCX_SecurityKey_Type v_Key := f_MCX_IMS_PTC_SecurityParameters_GetKey(p_KeyIndex);
    var octetstring v_Data := p_Data;
    var MCX_SecurityKey_Type v_DPPK;
    var template (value) MCData_ProtectedPayloadMessage v_ProtectedPayloadWithoutContent;
    var AEAD_EncryptionMethod_Type v_EncryptionMethod;
    var bitstring v_ProtectionKey;
    
    if (isvalue(v_Key) and tsc_MCX_XML_ConfidentialityProtection) {
      v_DPPK := valueof(v_Key);
      v_ProtectedPayloadWithoutContent := fl_MCX_ProtectedPayloadMessageWithoutContentTX(p_MessageType, v_DPPK.Id);
      v_EncryptionMethod := f_AEAD_Oct2EncryptionMethod(v_ProtectedPayloadWithoutContent.payloadAlgorithm);
      v_ProtectionKey := f_MCX_MCData_GenerateProtectionKey(v_DPPK, v_EncryptionMethod);
      v_Data := f_MCData_ProtectedPayloadMessage_EncryptAndEncode(v_ProtectedPayloadWithoutContent, v_ProtectionKey, v_Data);
    }
    return v_Data;
  }

  /*
   * @desc      Wrapper function to encode and ecrypt whole MCData message
   *            Encode MCData message (any message of 24.282 clause 15.1), encrypt it to a Protected Payload (33.180 Table 8.5.4.1-1)
   *            and return the encoded Protected Payload, if protection is required (otherwise the encoded MCData message is returned)
   * @param     p_MCDataMessage
   * @param     p_KeyIndex
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_Message_EncodeAndEncryptWholeMessage(template (value) MCData_Message p_MCDataMessage,
                                                         MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return octetstring
  {
    var octetstring v_EncodedMessage := bit2oct(encvalue(p_MCDataMessage));
    var MCData_MessageType v_MessageType := oct2bit(v_EncodedMessage[0]) or4b '01000000'B;   // set bit 7, R5w210310 assumption 2.2.1-3a
    
    return f_MCX_ProtectedPayloadMessage_SetupEncryptAndEncode(v_MessageType, v_EncodedMessage, p_KeyIndex);
  }

  /*
   * @desc      Encrypt payload of the MCData DATA_PAYLOAD message and encode the message
   *            used according to 24.282 clause 15.1.4 for 1-to-1 when end-to-end security is required
   * @param     p_MCDataMessage
   * @param     p_KeyIndex
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_DataMessage_EncryptPayloadsAndEncode(template (value) MCData_Message p_MCDataMessage,
                                                         MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return octetstring
  {
    var template (omit) MCX_SecurityKey_Type v_Key := f_MCX_IMS_PTC_SecurityParameters_GetKey(p_KeyIndex);
    var template (value) MCData_Message v_MCDataMessage := p_MCDataMessage;
    var MCX_SecurityKey_Type v_DPPK;
    var MCData_MessageType v_MessageType;
    var template (value) MCData_ProtectedPayloadMessage v_ProtectedPayloadWithoutContent;
    var AEAD_EncryptionMethod_Type v_EncryptionMethod;
    var bitstring v_ProtectionKey;
    var octetstring v_EncodedPayloads;
    
    if (isvalue(v_Key) and tsc_MCX_XML_ConfidentialityProtection) {
      v_DPPK := valueof(v_Key);
      v_MessageType := oct2bit('7A'O);      // IEI of Security parameters and Payload according to 24.282 Table 15.1.4.1-1; R5w210310 Assumption 2.2.1-4
      v_ProtectedPayloadWithoutContent := fl_MCX_ProtectedPayloadMessageWithoutContentTX(v_MessageType, v_DPPK.Id);
      v_EncryptionMethod := f_AEAD_Oct2EncryptionMethod(v_ProtectedPayloadWithoutContent.payloadAlgorithm);
      v_ProtectionKey := f_MCX_MCData_GenerateProtectionKey(v_DPPK, v_EncryptionMethod);
      
      select union (valueof(v_MCDataMessage)) {
        case (DATA_PAYLOAD) {
          v_EncodedPayloads := bit2oct(encvalue(v_MCDataMessage.DATA_PAYLOAD.payloads));
          v_MCDataMessage.DATA_PAYLOAD.payloads := {};
          v_MCDataMessage.DATA_PAYLOAD.protectedPayloads := { fl_MCX_ProtectedPayloadMessage_Encrypt(v_ProtectedPayloadWithoutContent, v_ProtectionKey, v_EncodedPayloads) };
        }
        case else {
          FatalError(__FILE__, __LINE__, "unexpected MCData message");
        }
      }
    }
    return bit2oct(encvalue(v_MCDataMessage));
  }

  /*
   * @desc      Depending on the given key encrypt either the whole MCData message (CSK, GMK) or the the payloads of the MCData message (PCK)
   * @param     p_MCDataMessage
   * @param     p_KeyIndex
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_Message_EncodeEncrypt(template (value) MCData_Message p_MCDataMessage,
                                          MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return octetstring
  { /* Working assumptions:
       - different ways of encryption for group and ono-to-one communication (R5w220007 clause 2.2.2)
       - no payload authentication, neither for MCData Data signalling messages nor for MCData Data messages (R5w220007 Assumption 2.1-1, clause 2.2.5) */
    var octetstring v_EncodedMessage;
    
    select (p_KeyIndex) {
      case (CSK, GMK) {    /* MCData Data signalling message or MCData Data message for group communication: protection of the whole message */
        v_EncodedMessage := f_MCData_Message_EncodeAndEncryptWholeMessage(p_MCDataMessage, p_KeyIndex);
      }
      case (PCK) {         /* MCData Data message for 1-to-1 communication: protection of the payload */
        v_EncodedMessage := f_MCData_DataMessage_EncryptPayloadsAndEncode(p_MCDataMessage, p_KeyIndex);
      }
    }
    return v_EncodedMessage;
  }

  /*
   * @desc      Decode MCData message (24.282 clause 15.1)
   * @param     p_EncodedMessage
   * @return    MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_Message_Decode(octetstring p_EncodedMessage) return MCData_Message
  {
    var bitstring v_Bitstring := oct2bit(p_EncodedMessage);
    var MCData_Message v_MCDataMessage;
    
    if (decvalue(v_Bitstring, v_MCDataMessage) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode MCDataMessage");
    }
    
    return v_MCDataMessage;
  }

  /*
   * @desc      Match MCData message
   * @param     p_MCDataMessage
   * @param     p_MCDataMessageTemplate
   * @status    APPROVED (MCX)
   */
  function f_MCData_Message_Match(MCData_Message p_MCDataMessage,
                                  template MCData_Message p_MCDataMessageTemplate) runs on IMS_PTC
  {
    if (not match(p_MCDataMessage, p_MCDataMessageTemplate)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "unexpected MCDataMessage");
    }
  }

  /*
   * @desc      Decrypt Protected Payload (33.180 Table 8.5.4.1-1) and return encoded content (in general one of the MCData messages in 24.282 clause 15.1);
   *            used in case of encrypted MCData message as a whole (i.e. an encrypted MCData message is payload of a protected payload message)
   *            and in case of a DATA PAYLOAD message containing encryped payloads in the 'Security parameters and Payload' IE
   * @param     p_ProtectedPayload
   * @param     p_DPPK
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_ProtectedPayload_Decrypt(MCData_ProtectedPayloadMessage p_ProtectedPayload,
                                             MCX_SecurityKey_Type p_DPPK) return octetstring
  {
    var octetstring v_AssociatedData := fl_MCData_ProtectedPayloadMessage_AEAD_AssociatedData(p_ProtectedPayload);
    var AEAD_EncryptionMethod_Type v_Method := f_AEAD_Oct2EncryptionMethod(p_ProtectedPayload.payloadAlgorithm);
    var bitstring v_Key := f_MCX_MCData_GenerateProtectionKey(p_DPPK, v_Method);
    var O16_Type v_IV := p_ProtectedPayload.initialisationVector;
    var octetstring v_DecryptedContent := fx_AEAD_Decrypt(p_ProtectedPayload.payload.content, v_AssociatedData, v_Method, v_Key, v_IV);
    
    return v_DecryptedContent;
  }

  /*
   * @desc      Decode MCData_ProtectedPayloadMessage and match against cr_MCX_ProtectedPayloadMessage
   *            used to decode a (stand-alone) protected paylod message according to 33.180 Table 8.5.4.1-1
   *            carrying an MCData message (24.282 clause 15) or the payload of an MSRP SEND request
   * @param     p_EncodedMessage
   * @param     p_DPPK_Id
   * @return    MCData_ProtectedPayloadMessage
   * @status    APPROVED (MCX)
   */
  function fl_MCData_ProtectedPayloadMessage_DecodeAndCheck(octetstring p_EncodedMessage,
                                                            B32_Type p_DPPK_Id) runs on IMS_PTC return MCData_ProtectedPayloadMessage
  {
    var bitstring v_Bitstring := oct2bit(p_EncodedMessage);
    var MCData_ProtectedPayloadMessage v_ProtectedPayloadMessage;
    
    if (decvalue(v_Bitstring, v_ProtectedPayloadMessage) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode ProtectedPayloadMessage");
    }
    
    if (not match(v_ProtectedPayloadMessage, cr_MCX_ProtectedPayloadMessage(-, p_DPPK_Id))) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid ProtectedPayloadMessage");
    }
    return v_ProtectedPayloadMessage;
  }

  /*
   * @desc      If payload protection is enabled (normal case), decode the given protected payload (33.180 Table 8.5.4.1-1) and decrypt the contained payload
   *            used when MCData message is encrypted as a whole or for encrypted payload of an MSRP SEND request
   * @param     p_Payload
   * @param     p_KeyIndex
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_ProtectedPayloadMessage_DecodeCheckAndDecryptContent(octetstring p_Payload,
                                                                         MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return octetstring
  {
    var template (omit) MCX_SecurityKey_Type v_SecurityKey := f_MCX_IMS_PTC_SecurityParameters_GetKey(p_KeyIndex);
    var octetstring v_Payload := p_Payload;
    var MCData_ProtectedPayloadMessage v_ProtectedPayloadMessage;
    var MCX_SecurityKey_Type v_DPPK;

    if (isvalue(v_SecurityKey) and tsc_MCX_XML_ConfidentialityProtection) {
      v_DPPK := valueof(v_SecurityKey);
      v_ProtectedPayloadMessage := fl_MCData_ProtectedPayloadMessage_DecodeAndCheck(v_Payload, v_DPPK.Id);
      v_Payload := f_MCData_ProtectedPayload_Decrypt(v_ProtectedPayloadMessage, v_DPPK);
    }
    return v_Payload;
  }

  /*
   * @desc      Decode, decrypt and match MCData message being encrypted as a whole
   * @param     p_EncodedMCDataMessage
   * @param     p_KeyIndex
   * @param     p_MCDataMessage
   * @return    MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_DecodeAndMatchEncryptedMCDataMessage(octetstring p_EncodedMCDataMessage,
                                                         MCX_KeyIndex_Type p_KeyIndex,
                                                         template MCData_Message p_MCDataMessage) runs on MCX_IMS_PTC return MCData_Message
  {
    var octetstring v_Payload := f_MCData_ProtectedPayloadMessage_DecodeCheckAndDecryptContent(p_EncodedMCDataMessage, p_KeyIndex);
    var MCData_Message v_MCDataMessage := f_MCData_Message_Decode(v_Payload);

    f_MCData_Message_Match(v_MCDataMessage, p_MCDataMessage);

    return v_MCDataMessage;
  }

  /*
   * @desc      Decode payloads e.g. contained in ProtectedPayload; return list of (decoded) payloads
   * @param     p_EncodedPayloads
   * @return    MCData_PayloadList
   * @status    APPROVED (MCX)
   */
  function fl_MCData_Message_DecodePayloads(octetstring p_EncodedPayloads) return MCData_PayloadList
  {
    var bitstring v_Bitstring := oct2bit(p_EncodedPayloads);
    var MCData_PayloadList v_PayloadList;

    if (decvalue(v_Bitstring, v_PayloadList) != 0) {
      FatalError(__FILE__, __LINE__, "Can not decode PayloadList");
    }
    return v_PayloadList;
  }

  /*
   * @desc      Decode, decrypt and match DATA PAYLOAD containing protected payload
   *            Decode MCData massage (DATA PAYLOAD) and
   *            if security protection is enabled match against DATA PAYLOAD with protectedPayloads, decrypt the protectedPayloads and build-up unprotected DATA PAYLOAD and
   *            match against given template;
   *            return MCdata message containing unprotected DATA PAYLOAD
   * @param     p_EncodedMCDataMessage
   * @param     p_MCDataMessage
   * @return    MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MCData_DecodeAndMatchMCDataMessageWithEncryptedPayload(octetstring p_EncodedMCDataMessage,
                                                                    template MCData_Message p_MCDataMessage) runs on MCX_IMS_PTC return MCData_Message
  {
    var template (omit) MCX_SecurityKey_Type v_SecurityKey := f_MCX_IMS_PTC_SecurityParameters_GetKey(PCK);
    var MCData_Message v_MCDataMessage;
    var MCData_ProtectedPayloadMessage v_ProtectedPayloadMessage;
    var MCX_SecurityKey_Type v_DPPK;
    var octetstring v_EncodedPayloads;

    v_MCDataMessage := f_MCData_Message_Decode(p_EncodedMCDataMessage);
    
    if (isvalue(v_SecurityKey) and tsc_MCX_XML_ConfidentialityProtection) {
      v_DPPK := valueof(v_SecurityKey);
      f_MCData_Message_Match(v_MCDataMessage, cr_MCData_DATA_PAYLOAD_Protected1to1(v_DPPK.Id));
      v_ProtectedPayloadMessage := v_MCDataMessage.DATA_PAYLOAD.protectedPayloads[0];
      v_EncodedPayloads := f_MCData_ProtectedPayload_Decrypt(v_ProtectedPayloadMessage, v_DPPK);
      v_MCDataMessage.DATA_PAYLOAD.payloads := fl_MCData_Message_DecodePayloads(v_EncodedPayloads);
      v_MCDataMessage.DATA_PAYLOAD.protectedPayloads := {};
    }
    f_MCData_Message_Match(v_MCDataMessage, p_MCDataMessage);
    return v_MCDataMessage;
  }

  /*
   * @desc      Encode and encrypt MCData message and add it to MIME Part List
   * @param     p_MIME_Part_List
   * @param     p_MCDataMessage
   * @param     p_KeyIndex
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_PartList_AddMCDataMessageTX(template (value) MIME_Part_List p_MIME_Part_List,
                                                  template (omit) MCData_Message p_MCDataMessage,
                                                  MCX_KeyIndex_Type p_KeyIndex) runs on MCX_IMS_PTC return template (value) MIME_Part_List
  {
    var template (value) MIME_Part_List v_MIME_Part_List := p_MIME_Part_List;
    var MCData_Message v_MCDataMessage;
    var charstring v_MimeType;
    var octetstring v_EncodedMessage;
    
    if (isvalue(p_MCDataMessage)) {
      v_MCDataMessage := valueof(p_MCDataMessage);
      select union (v_MCDataMessage) {
        case (DATA_PAYLOAD) {
          v_MimeType := tsc_MimeType_McdataPayload;
        }
        case else {
          v_MimeType := tsc_MimeType_McdataSignalling;
        }
      }
      v_EncodedMessage := f_MCData_Message_EncodeEncrypt(v_MCDataMessage, p_KeyIndex);
      v_MIME_Part_List := f_MIME_Part_List_AddBinary(v_MIME_Part_List, v_MimeType, v_EncodedMessage);
    }
    return v_MIME_Part_List;
  }

  /*
   * @desc      Get body part for (encrypted) MCData Signalling message or fully encrypted MCData data message, decrypt, decode and match the MCData message
   * @param     p_MIME_Message
   * @param     p_MimeType
   * @param     p_KeyIndex
   * @param     p_MCDataMessage
   * @return    template (omit) MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MIME_DecodeAndMatchEncryptedMCDataMessage(MIME_Message p_MIME_Message,
                                                       charstring p_MimeType,
                                                       MCX_KeyIndex_Type p_KeyIndex,
                                                       template MCData_Message p_MCDataMessage) runs on MCX_IMS_PTC return template (omit) MCData_Message
  {
    var boolean v_IsRequired := ispresent(p_MCDataMessage);
    var template (omit) MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, p_MimeType, v_IsRequired);  // => fail/inconc if MIME part is not there but required
    
    if (isvalue(v_MIME_Part)) {
      return f_MCData_DecodeAndMatchEncryptedMCDataMessage(valueof(v_MIME_Part.body.commonBinary), p_KeyIndex, p_MCDataMessage);
    }
    return omit;
  }

  /*
   * @desc      Get body part for MCData data message, decode it, decrypt the payload(s) contained in the ProtectedPayloadMessage and match the resulting MCData message
   * @param     p_MIME_Message
   * @param     p_MCDataMessage
   * @return    template (omit) MCData_Message
   * @status    APPROVED (MCX)
   */
  function f_MIME_DecodeAndMatchMCDataMessageWithEncryptedPayload(MIME_Message p_MIME_Message,
                                                                  template MCData_Message p_MCDataMessage) runs on MCX_IMS_PTC return template (omit) MCData_Message
  {
    var boolean v_IsRequired := ispresent(p_MCDataMessage);
    var template (omit) MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, tsc_MimeType_McdataPayload, v_IsRequired);  // => fail/inconc if MIME part is not there but required

    if (isvalue(v_MIME_Part)) {
      return f_MCData_DecodeAndMatchMCDataMessageWithEncryptedPayload(valueof(v_MIME_Part.body.commonBinary), p_MCDataMessage);
    }
    return omit;
  }

  type record MCData_SignallingAndDataPayload_Type { /* @status    APPROVED (MCX) */
    MCData_Message Signalling optional,
    MCData_Message Data optional
  };

  template (value) MCData_SignallingAndDataPayload_Type cs_MCData_SignallingAndDataPayload_AllOmit :=
  { /* @status    APPROVED (MCX) */
    Signalling := omit,
    Data := omit
  };

  /*
   * @desc      decrypt, decode and match MCData signalling and data message contained in a MIME message
   *            return MCData_SignallingAndDataPayload_Type containing the messages
   * @param     p_MIME_Message
   * @param     p_DataKeyIndex
   * @param     p_SignallingMessage
   * @param     p_DataMessage       (default value: omit)
   * @return    MCData_SignallingAndDataPayload_Type
   * @status    APPROVED (MCX)
   */
  function f_MIME_DecodeAndMatchMCData(MIME_Message p_MIME_Message,
                                       MCX_KeyIndex_Type p_DataKeyIndex,
                                       template (present) MCData_Message p_SignallingMessage,
                                       template MCData_Message p_DataMessage := omit) runs on MCX_IMS_PTC return MCData_SignallingAndDataPayload_Type
  {
    var template (value) MCData_SignallingAndDataPayload_Type v_SignallingAndDataPayload := cs_MCData_SignallingAndDataPayload_AllOmit;

    v_SignallingAndDataPayload.Signalling := f_MIME_DecodeAndMatchEncryptedMCDataMessage(p_MIME_Message, tsc_MimeType_McdataSignalling, CSK, p_SignallingMessage);

    select (p_DataKeyIndex) {
      case (GMK) {    // Group communication
        v_SignallingAndDataPayload.Data := f_MIME_DecodeAndMatchEncryptedMCDataMessage(p_MIME_Message, tsc_MimeType_McdataPayload, GMK, p_DataMessage);
      }
      case (PCK) {    // 1-to-1 communication
        v_SignallingAndDataPayload.Data := f_MIME_DecodeAndMatchMCDataMessageWithEncryptedPayload(p_MIME_Message, p_DataMessage);
      }
    }
    return valueof(v_SignallingAndDataPayload);
  }

}
