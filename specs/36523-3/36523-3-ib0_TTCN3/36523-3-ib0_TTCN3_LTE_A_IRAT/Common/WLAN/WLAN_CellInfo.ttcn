module WLAN_CellInfo {

  import from CommonDefs all;
  import from WLAN_ASP_TypeDefs all;

  type record WLAN_CellInfo_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    WLAN_CellId_Type                    CellId,
    ReferenceCellBeaconRSSI_Type        ReferencePower,              // Cell power configuration
    WLAN_AP_Parameters_Type             WLAN_AP_Parameters
  };

  type record length (tsc_WLAN_MaxNumberOfCells) of WLAN_CellInfo_Type WLAN_CellInfoArray_Type; /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */

  type record ReferenceCellBeaconRSSI_Type { /* @status    APPROVED (IMS, LTE_A_IRAT, NR5GC_IRAT) */
    WLAN_InitialCellPower_Type          InitialBeaconRSSI,
    WLAN_Attenuation_Type               Attenuation
  };

}
