module SRTP_ASP_TypeDefs {
 
  import from CommonDefs all;
  import from IP_ASP_TypeDefs all;

  //----------------------------------------------------------------------------
  group Type_Definitions {

  type enumerated SRTP_EncryptionAlgorithm_Type {
    Null (0),           // RFC 3830 clause 6.10.1
    AES_CM (1),         // RFC 3830 clause 6.10.1
    AES_F8 (2),         // RFC 3830 clause 6.10.1
    AES_GCM (6)         // RFC 7714 clause 14.3
  };

  type enumerated SRTP_AuthenticationAlgorithm_Type {
    Null (0),           // RFC 3830 clause 6.10.1
    HMAC_SHA_1 (1),     // RFC 3830 clause 6.10.1
    RCCm1 (2),          // RFC 4771 clause 4
    RCCm2 (3),          // RFC 4771 clause 4
    RCCm3 (4)           // RFC 4771 clause 4
  };

  type enumerated SRTP_PRF_Type {
    AES_CM (0)          // RFC 3830 clause 6.10.1
  };

  type record SRTP_SecurityProfile_Type {               /* parameters for SRTP security profiles according to 33.180 annex E:
                                                           - Table E.2.2-1 (RTP group call: GMK)
                                                           - Table E.3.2-1 (RTP private call: PCK)
                                                           - Table E.4.2-1 (RTCP: CSK and MuSiK)):
                                                           The parameters may be contained/negotiated in MIKEY Security Policy Payload (RFC 3830) */
    SRTP_EncryptionAlgorithm_Type       EncryptionAlgorithm,                    /* SRTP type 0; RFC 3830 clause 6.10.1 */
    integer                             SessionEncryptionKeyLength,             /* SRTP type 1; RFC 3830 clause 6.10.1 */
    SRTP_AuthenticationAlgorithm_Type   AuthenticationAlgorithm optional,       /* SRTP type 2; RFC 3830 clause 6.10.1 */
    integer                             SessionSaltKeyLength,                   /* SRTP type 4; RFC 3830 clause 6.10.1 */
    SRTP_PRF_Type                       PRF,                                    /* SRTP type 5; RFC 3830 clause 6.10.1 */
    integer                             KeyDerivationRate,                      /* SRTP type 6; RFC 3830 clause 6.10.1 */
    integer                             ROC_TransmissionRate optional,          /* SRTP type 13; RFC 4771 clause 4 */
    integer                             SRTP_AuthenticationTagLength optional,  /* SRTP type 18; RFC 4771 clause 4 */
    integer                             SRTCP_AuthenticationTagLength optional, /* SRTP type 19; RFC 4771 clause 4 */
    integer                             AEAD_AuthenticationTagLength            /* SRTP type 20; RFC 7714 clause 14.3 */
  };

  type record SRTP_KeyInfo_Type {                       /* SRTP Master Key, SRTP Master Salt and MKI according to 33.180 clauses 7.4.1, 7.4.2 and 9.4.6, RFC 3830 and RFC 3711 */
    octetstring                 MasterKey,              /* SRTP master key according to RFC 3711 (128 bits) */
    octetstring                 MasterSalt,             /* SRTP master salt according to RFC 3711 and RFC 7714 (96 bits):
                                                           33.180 clauses 7.5 and 9.4.8 specify the AEAD_AES_128_GCM algorithm as defined in RFC 7714 to be used for confidentiality and data authentication of the media stream and the media control data.
                                                           RFC 7714 specifies in clause 12 a master salt length of 96 and in clause 11 that the AES_CM PRF KDF according to RFC 3711 shall be used.
                                                           Nevertheless RFC 3711 clause 8.2 requires a master salt length of 112.
                                                           This contradiction is resolved by the RFC Errata for RFC 7714:
                                                           The master salt shall be 96 bit in the first place (as according to RFC 7714) but then multiplied by 2^16 to fit to the requirements of RFC 3711 (112 bit).
                                                           => MasterSalt provides a 96-bit value which needs to be padded by the system adaptor to get the 112-bit master salt as needed according to RFC 3711 */
    octetstring                 MKI optional            /* SRTP Master Key Identifier: if not present => no MKI to be added to the SRTP/SRTCP packet */
  };
  
  type record SRTP_Config_Type {                        /* SRTP configuration parameters */
    SRTP_KeyInfo_Type           KeyInfo,
    SRTP_SecurityProfile_Type   SecurityProfile
  };

  type record SRTP_Connection_Type {                    /* configuration parameters for a single (UDP) connection */
    IP_Connection_Type          Connection,             /* RTP/RTCP configuration shall be applied for packets matching the given Connection:
                                                         * in general a connection is given by
                                                         *   Protocol := udp
                                                         *   Local := { IP address of the SS, port number at the SS }
                                                         *   Remote := omit
                                                         * (but other matching criteria may be used if needed)
                                                         * NOTE: TTCN shall ensure that different connection can be identified without ambiguity (in general even the local port number should be sufficient) */
    O4_Type                     LocalSSRC,              /* SSRC of the SS */
    SRTP_Config_Type            SRTP_Config optional    /* configuration of SRTP/SRTCP for the given connection; if not present => no SRTP/SRTCP */
  };

  type record of SRTP_Connection_Type SRTP_ConnectionTable_Type;
  
  type union SRTP_CTRL_REQ {                            /* configuration ASP at the system interface */
    SRTP_ConnectionTable_Type   Config                  /* table of all connection to be configured for SRTP/SRTCP (or RTP/RTCP);
                                                           the configuration overrides any previous configuration; it is not foreseen to add, modify or remove single connections */
  };

  type union SRTP_CTRL_IND {                            /* ASP at the system interface for system confirmations and indications */
    Null_Type                   Confirm,                /* confirmation for configuration */
    Null_Type                   Error                   /* indication of errors */
  };

  } // group Type_Definitions

  //****************************************************************************
  // System Interface
  //****************************************************************************
  
  group System_Interface {

  type port SRTP_PORT message {
    out SRTP_CTRL_REQ;
    in  SRTP_CTRL_IND;
  };

  } // group System_Interface

}
