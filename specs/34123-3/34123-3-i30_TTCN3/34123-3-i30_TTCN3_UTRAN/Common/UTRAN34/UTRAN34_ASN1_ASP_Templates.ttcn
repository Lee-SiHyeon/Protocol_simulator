  };

  template (value) U_CPHY_CONFIG_REQ cas_RACH_InfoActNow_FDDr99(UTRAN_CellId_Type p_CellId,
                                                                integer p_PhyChId) :=
  { /* @status    APPROVED (IMS, SSNITZ, UTRAN) */
    trchConfig_FDD := {
      cellId := f_UtranCellId2Int(p_CellId),
      routingInfo := {
        physicalChannelIdentity := p_PhyChId
      },
      ratType := fdd,
      trchConfigType := cs_TrChConfigTypeNonDCH,
      configMessage := {
        activationTime := cs_ActivateNow,
        ulconnectedTrCHList := {
          {
            trchid := tsc_RACH1,
            ul_TransportChannelType := rach,
            transportChannelInfo := cs_RACH_TFS_FDDr99
          }
        },
        ulTFCS := cs_TFCS_Cmpl0_1_2_Rx,
        dlconnectedTrCHList := omit,
        dlTFCS := omit,
        hsDSCHMacdFlows := omit,
        e_DCHMacdFlows := omit,
        ehs_DSCH_Flows := omit,
        ehs_DSCH_CommonFlows := omit,
        e_DCHMacd_CommonFlows := omit,
        ehs_DSCH_Flows_r9 := omit,
        relAspTypeExtension := omit
      }
    }
  };

  template (value) RL_Setup_FDD_PhysicalChannelInfo_Type cs_SS_E_DPCH_Info_FDD_r9(UL_ScramblingCode p_UL_ScramblingCode,
                                                                                  integer p_EDCH_Category := pc_EDCH_UE_Category_FDD,
                                                                                  template (omit) integer p_EDCH_CategoryExt := omit,
                                                                                  template (omit) integer p_EDCH_CategoryExt2 := omit,
                                                                                  E_DPDCH_MaxChannelisationCodes p_E_DPDCH_MaxChannelisationCodes := sf4x2 //@sic R5-165884 sic@
                                                                                  ) :=
  { /* @status    APPROVED (UTRAN) */
    e_DPCHInfo := {
      r9 := {
        e_DPCCH_Info := cs_E_DPCCH_Info,
        e_DPDCH_Info := cs_E_DPDCH_Info(p_E_DPDCH_MaxChannelisationCodes), //@sic R5-165884 sic@
        scramblingCodeType := longSC,
        scramblingCode := p_UL_ScramblingCode,
        tti := f_Get_EDCH_TTI_Value(),
        edch_PhysicalLayerCategory := p_EDCH_Category,
        edch_PhysicalLayerCategory_extension := p_EDCH_CategoryExt,
        edch_PhysicalLayerCategory_extension2 := p_EDCH_CategoryExt2,
        ul_16QAM_Settings := omit,
        s_offset := omit
      }
    }
  };

    template (value) U_CMAC_CONFIG_REQ cas_MACi_NodeB_CellMapping_1Cell(UTRAN_CellId_Type p_CellId,
                                                                      integer           p_NodeB_Id) :=
  { /* @status    APPROVED (UTRAN) */
    nodeB_MACi := {
      nodeB_Id := p_NodeB_Id,
      celllist := {
        f_UtranCellId2Int(p_CellId)
      }
    }
  };

  template (present) U_CMAC_CONFIG_CNF car_CMAC_MACi_NodeB_CellMapping_CNF(integer p_NodeB_Id) :=
  { /* @status    APPROVED (UTRAN) */
