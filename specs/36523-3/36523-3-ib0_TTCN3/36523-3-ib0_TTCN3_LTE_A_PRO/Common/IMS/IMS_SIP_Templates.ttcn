  const OptionTag_List tsc_OptionTagList_100rel := {c_tag100rel};                          /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  const OptionTag_List tsc_OptionTagList_precondition := {c_tagPrecond};                   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  const OptionTag_List tsc_OptionTagList_sec_agree := {"sec-agree"};                       /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

  const OptionTag_List tsc_OptionTagList_Empty := {};                                      /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  const OptionTag_List tsc_OptionTagList_timer := {"timer"};                               /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */

  const OptionTag_List tsc_OptionTagList_100rel_precondition := tsc_OptionTagList_100rel & tsc_OptionTagList_precondition;    /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  const OptionTag_List tsc_OptionTagList_Invite_A_2_9 := tsc_OptionTagList_100rel & tsc_OptionTagList_timer;            /* option tags for Support header according to 34.229-1 A.2.9
                                                                                                                           @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
                                                                                                                           @sic R5-192321: 'timer' mandatory sic@ */

  const OptionTag_List tsc_OptionTagList_Invite_C11 := tsc_OptionTagList_Invite_A_2_9 & tsc_OptionTagList_precondition; /* option tags for Support header according to 34.229-1 C.11 and A.2.9
                                                                                                                           @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT) */

  /*
   * @desc      generate receive template expection all given option tags and any further ones
   * @param     p_RequestedTags
   * @return    template (present) OptionTag_List
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SIP_OptionTagListRX(OptionTag_List p_RequestedTags) return template (present) OptionTag_List
  { /* @sic R5s141020 - MCC160 change: workarounds for "superset(all from p_TagList)" removed sic@ */
    var template (present) OptionTag_List v_TagList;

    v_TagList := superset(all from p_RequestedTags);     // this is the solution acc. to V4.5.1 of the core language ...

    return v_TagList;
  }

  template (present) DisplayName cr_DisplayNameToken(charstring p_DisplayName) := {token := f_TokenPattern(p_DisplayName)};   /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (present) DisplayName cr_DisplayNameQuotedString(charstring p_DisplayName) := {quotedString := p_DisplayName};     /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

  template (present) DisplayName cr_DisplayName(charstring p_DisplayName) := (cr_DisplayNameToken(p_DisplayName), cr_DisplayNameQuotedString(p_DisplayName)); /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */

