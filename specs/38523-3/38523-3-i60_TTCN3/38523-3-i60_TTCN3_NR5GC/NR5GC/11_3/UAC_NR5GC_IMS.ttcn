module UAC_NR5GC_IMS {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_NR5GC_Functions all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_RegistrationCommon all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.3.1.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_3_1_NR5GC_IMS1()runs on IMS_PTC
  {
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    //@siclog "Steps 18-31" siclog@
    //Step3 to step13 from test procedure for IMS MO speech call establishment as described in TS 38.508-1 [4] Table 4.9.15.2.2-1 take place,@
    //Make the UE release the MO speech call. (Note 2)
    //Steps 1-5 from test procedure for test procedure for IMS MO speech call release as described in TS 38.508-1 [4] Table 4.9.17.2.2-1 take place,
    f_IMS_NR5GC_MOSpeechCallAndRelease();//@sic R5s220579 sic@
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    
     //@siclog "Steps 42-49" siclog@
     //Steps 9-16 of generic procedure for MO SMS as per 38.508-1 steps 9-16, corresponding to (steps 1-8) 34.229-5 cl. A.13
    f_IMS_NR5GC_MO_SMS_Steps9_16 ();
   
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.3.2.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_11_3_2_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyCallAndRelease();

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.3.5.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_3_5_NR5GC_IMS1()runs on IMS_PTC
  {
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
        // @sic R5s221172 sic@
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    f_IMS_GlobalRelease();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // MO Video Call
    f_IMS_NR5GC_MOVideoCall();
    
    // Call Release MT
    f_IMS_CallReleaseMT(f_SIP_BuildSipUri_TX(px_IMS_CalleeContactUri));
    //Tell NR that call is released
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent")); // @sic R5s230200 sic@
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.3.10.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_3_10_NR5GC_IMS1()runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var IMS_DATA_REQ v_IMS_DATA_REQ_ByRef;
    var REGISTER_Request v_RegisterReq;
    timer t_RegExpireMax:= 80.0; //@sic R5-230582 sic@

    
    
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration(-, -, -, "120"); //@sic R5s230306 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN); //@sic R5s230133 sic@
    
    //@siclog "Step 10" siclog@
    //Check: Does the UE performs SIP re-registration message in a time span between half of the expiration time and the full expiration time?
    t_RegExpireMax.start;
    
    alt {
      [] a_IMS_ReceiveRequest(car_IMS_Register_Request(cr_REGISTER_Request), v_IMS_DATA_REQ_ByRef)
        {
         f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
        }
      [] t_RegExpireMax.timeout
        {
         f_IMS_PreliminaryPass (__FILE__, __LINE__, "Step 10");
         f_IMS_IPCAN_SendCoOrdMsg(IPCAN); //@sic R5s230133 sic@
        }
      
    }
    
    f_IMS_IPCAN_WaitForTrigger(IPCAN); //@sic R5s230306 sic@
    //@siclog "Step 12" siclog@
    //Check: Does the UE performs SIP REGISTER message?
    v_IMS_DATA_REQ := f_IMS_REGISTER_SubsequentRequest(-, -, -, 2);//@sic R5s230133 sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    
    //@siclog "Step 13" siclog@
    //SS responds with 200 OK
    v_RegisterReq := v_IMS_DATA_REQ.Request.Register;
    IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo), cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));
    
    //Tell NR that call is released
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

}
