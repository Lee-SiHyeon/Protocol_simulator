    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    NG_TrackingAreaIdList_LV    lvPart   /* separated definition into TLV and LV parts Sep22 @sic R5s221179 Baseline Moving sic@ */
  };

  type record NG_UpdateType {                     /* 24.501 cl. 9.11.3.9A */
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type4Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
    B2_Type                     spare,
    B2_Type                     eps_PNB_CIoT,                     /* Sep20 @sic R5s201387 Baseline Moving sic@ */
