    highSpeedConfigSCell_r14            := omit,       /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    prach_Config_v1430                  := omit,       /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    ul_Configuration_r14                := omit,       /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
