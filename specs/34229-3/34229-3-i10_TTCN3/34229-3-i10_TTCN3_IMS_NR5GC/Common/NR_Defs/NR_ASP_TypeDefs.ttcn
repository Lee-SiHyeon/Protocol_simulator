module NR_ASP_TypeDefs {
  /* Type definitions for configuration of the system simulator;
   * Common design principles:
   * Semantics of OMIT: unless specified otherwise, for all TTCN-3 type definitions used in ASPs omit means "keep as it is" =>
   * - on initial configuration in general all fields shall be provided
   * - no default values for fields are foreseen
   * - if necessary non-existence of information shall be explicitly configured
   *   (e.g. with a union of "no configuration" and "configuration parameters"
   * - fields within structures imported from the core spec are excepted from this rule
   * - if a sub-structure is explicitly excluded from this rule all fields and sub-fields shall be fully specified for each (re-)configuration */

  import from CommonDefs all;
  import from CommonAspDefs all;
  import from SDAP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_PDCP_TypeDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};

  //****************************************************************************

  group ASN1_Container { /* Definitions containing ASN.1 types for backward compatibility */

  type union NR_ASN1_ARFCN_ValueNR_Type {
    ARFCN_ValueNR R15
  };
  
  type union NR_ASN1_UL_AM_RLC_Type {
    UL_AM_RLC R15
  };

  type union NR_ASN1_DL_AM_RLC_Type {
    DL_AM_RLC R15
  };

  type union NR_ASN1_UL_UM_RLC_Type {
    UL_UM_RLC R15
  };

  type union NR_ASN1_DL_UM_RLC_Type {
    DL_UM_RLC R15
  };

  type union NR_ASN1_PDSCH_Config_Type {
    PDSCH_Config R15
  };

  type union NR_ASN1_PDSCH_ConfigCommon_Type {
    PDSCH_ConfigCommon R15
  };

  type union NR_ASN1_PDCCH_Config_Type {
    PDCCH_Config R15
  };

  type union NR_ASN1_PDCCH_ConfigCommon_Type {
    PDCCH_ConfigCommon R15
  };

  type union NR_ASN1_SPS_Config_Type {
    SPS_Config R15,
    SPS_Config_R16 R16
  };

  type union NR_ASN1_TDD_UL_DL_ConfigCommon_Type {
    TDD_UL_DL_ConfigCommon R15
  };

  type union NR_ASN1_TDD_UL_DL_SlotConfig_Type {
    TDD_UL_DL_SlotConfig R15
  };

  type union NR_ASN1_FrequencyInfoDL_Type {
    FrequencyInfoDL R15
  };

  type union NR_ASN1_FrequencyInfoUL_Type {
    FrequencyInfoUL R15
  };

  type union NR_ASN1_BWP_UplinkCommon_Type {
    BWP_UplinkCommon R15
  };

  type union NR_ASN1_BWP_UplinkDedicated_Type {
    BWP_UplinkDedicated R15
  };

  type union NR_ASN1_RACH_ConfigDedicated_Type {
    RACH_ConfigDedicated R15
  };
  
 type record NR_ASN1_SI_RequestConfig_Type {
    SI_RequestConfig             R15    optional,
    SI_SchedulingInfo_v1800      R18    optional
  };

  type union NR_ASN1_PDSCH_ServingCellConfig_Type {
    PDSCH_ServingCellConfig R15
  };

  type union NR_ASN1_PUSCH_ServingCellConfig_Type {
    PUSCH_ServingCellConfig R15
  };

  type record NR_ASN1_SearchSpace_Type {
    SearchSpace          R15,
    SearchSpaceExt_r16   R16  optional,
    SearchSpaceExt_v1700 R17  optional,
    SearchSpaceExt_v1800 R18  optional
  };

  type union NR_ASN1_ControlResourceSet_Type {
    ControlResourceSet R15
  };

  type union NR_ASN1_BWP_Type {
    BWP R15
  };

  type union NR_ASN1_DRX_Config_Type {
    DRX_Config R15
  };

  type union NR_ASN1_MeasGapConfig_Type {
    MeasGapConfig           R15,              /* measurement gap configuration acc. to TS 38.331, clause 5.5.2.9 */
    MUSIM_GapConfig_r17     MUSIM_R17         /* measurement gap configuration acc. to TS 38.331, clause 5.3.5.9a */

  };

  type union NR_ASN1_MAC_CellGroupConfig_Type {
    MAC_CellGroupConfig R15
  };

  type union NR_ASN1_PhysicalCellGroupConfig_Type {
    PhysicalCellGroupConfig R15
  };

  type union NR_ASN1_RateMatchPattern_Type {
    RateMatchPattern R15
  };

  type union NR_ASN1_RateMatchPatternLTE_CRS_Type {
    RateMatchPatternLTE_CRS R15
  };

  type union NR_ASN1_NonCellDefiningSSB_Type {
    NonCellDefiningSSB_r17 R17
  };
  
  type ControlResourceSet.coresetPoolIndex_r16  NR_ASN1_CoresetPoolIndex_Type;
  
  type union NR_ASN1_MCCH_Message_Type {
    MCCH_Message_r17  R17
  };

  type union NR_ASN1_MCCH_RepetitionPeriodAndOffset_Type {
    MCCH_RepetitionPeriodAndOffset_r17  R17
  };

  type union NR_ASN1_CFR_ConfigMCCH_MTCH_Type {
    CFR_ConfigMCCH_MTCH_r17  R17
  };

  type union NR_ASN1_PDSCH_ConfigBroadcast_Type {
    PDSCH_ConfigBroadcast_r17     R17
  }

  } // End group ASN1_Container

  //****************************************************************************

  group System_Configuration {
  //****************************************************************************
  // Formal ASP Definitions for system configuration
  //****************************************************************************

  type union NR_SystemRequest_Type {
    NR_CellConfigRequest_Type           Cell,                   /* configure/release a cell */
    NR_CellAttenuationList_Type         CellAttenuationList,    /* power attenuation for one or several cells;
                                                                 * all cells included in the list shall be changed at the same time;
                                                                 * all cells in the list shall reach the new cell power within a maximum of 100ms (10 frames) as according to TS 38.523-3 clause 7.1.4.2
                                                                 * CellId: In the common ASP part the CellId shall be set
                                                                 * - to the cell the timing information refers to if activation time shall be applied
                                                                 * - to nr_Cell_NonSpecific when there is no activation time
                                                                 * TimingInfo: 'Now' (in general, but activation time may be used also)                                                                 */
    NR_RadioBearerList_Type             RadioBearerList,        /* configure/release one or several SRBs and/or DRBs at an SpCell
                                                                 * NOTE: RBs are not configured in an SCell */
    Null_Type                           EnquireTiming,          /* get current timing information for the given cell
                                                                 * TimingInfo : 'Now' */
    NR_AS_Security_Type                 AS_Security,            /* StartRestart/Release of AS security */
    NR_System_IndicationControl_Type    SystemIndCtrl,          /* to configure SS to generate system indications */
    NR_PDCP_CountReq_Type               PdcpCount,              /* to set or enquire PDCP COUNT for one or more RBs */
    NR_DCI_Trigger_Type                 DciTrigger,             /* to trigger a specific DCI to be transmitted on PDCCH (e.g. PDCCH order) */
    NR_PagingTrigger_Type               Paging,                 /* to trigger SS to send paging at the given paging occasion (as calculated in TTCN)
                                                                   NOTE: The SS shall use the DCI configuration as provided by NR_PcchConfig_Type; the DCI may or may not carry a short message but it in any case it shall indicate presence */
    NR_MAC_ControlElementDL_Type        MacCommandTrigger,      /* to trigger a specific MAC control element to be transmitted to the UE */
    NR_L1_TestMode_Type                 L1_TestMode,            /* to Set L1/MAC in special Test modes e.g. DL CRC etc.
                                                                 * per default (at initial configuration) no test mode is activated */
    NR_PDCP_HandoverControlReq_Type     PdcpHandoverControl,    /* to inform the target cell about the handover (or PSCell change) procedure. */
    NR_Band_SsbForDelta_Type            DeltaValues,            /* to provide the primary and secondary frequency info for deriving the delta values */
    NR_SPS_CG_ActDeact_Type             SpsCg,                  /* to configure/activate or release/deactivate DL SPS assignment or UL configured grant type 2 scheduling */
    NR_MBS_Config_Type                  Mbs                     /* to configure/release MBS MCCH/MTCH */
  }

  type union NR_SystemConfirm_Type {                            /* confirmations for system configuration;
                                                                   in general to be sent after the configuration has been done */
    Null_Type                           Cell,                   /* (no further parameters from SS) */
    Null_Type                           CellAttenuationList,    /* (no further parameters from SS)
                                                                 * NOTE 1:
                                                                 * the confirmation shall be sent when all cells have changed power levels
                                                                 * NOTE 2:
                                                                 * for the CellId in the common ASP part the same rules are applied as for the SYSTEM REQ */
    Null_Type                           RadioBearerList,        /* (no further parameters from SS) */
    Null_Type                           EnquireTiming,          /* the cell's timing information is contained in the TimingInfo of the ASP's common part */
    Null_Type                           AS_Security,            /* (no further parameters from SS) */
    Null_Type                           SystemIndCtrl,          /* (no further parameters from SS) */
    NR_PDCP_CountCnf_Type               PdcpCount,              /* as response to 'Get' a list is returned containing COUNT information for the requested RBs */
    Null_Type                           DciTrigger,             /* (no further parameters from SS) */
    Null_Type                           MacCommandTrigger,      /* (no further parameters from SS) */
    Null_Type                           L1_TestMode,            /* confirmation for L1 test mode */
    Null_Type                           PdcpHandoverControl,    /* confirmation for PDCP handover control */
    UE_NR_DeltaValues_Type              DeltaValues,            /* Delta values to be used for primary and secondary band */
    Null_Type                           SpsCg                   /* confirmation for DL SPS or UL configured grant type 2 Activation/Deactivation */
  };
  
  type union NR_SystemIndication_Type {
    charstring                          Error,                  /* indicates an error situation in SS;
                                                                 * is not explicitly handled in TTCN but causes an INCONC due to default behaviour;
                                                                 * an additional error code can be signalled in the common part of the ASP;
                                                                 * SS shall raise an error when in TS 38.523-3 or in any other ASP definitions */
    NR_RlcDiscardInd_Type               RlcDiscardInd,          /* indicates discarded PDUs */
    NR_MAC_ControlElementUL_Type        MAC,                    /* indicates MAC control element being received from the UE */
    NR_RachPreamble_Type                RachPreamble,           /* RACH preamble being sent by the UE */
    Null_Type                           SchedReq,               /* indication for scheduling request sent by the UE */
    HARQ_Type                           UL_HARQ,                /* to report the UL HARQ as received on PUCCH or PUSCH for corresponding DL transmission */
    NR_HarqError_Type                   HarqError,              /* indicates detection of HARQ error:
                                                                 * 1. HARQ CRC error for UL data
                                                                 * 2. HARQ NACK from the UE unless SS is configured to report HARQ ACK/NACK */
    NR_LogicalChannelId_Type            UL_SRB0_LCID            /* indicates the Logical Channel Id used in UL SRB0 MAC subPDU */
  };
  
  } // End group System_Configuration

  //****************************************************************************

  group Cell_Configuration { /* Specific Info for Cell Configuration Primitive */
  group Cell_Configuration_Common {

  type union NR_CellConfigRequest_Type {

    NR_CellConfigInfo_Type              AddOrReconfigure,               /* for cell configuration:
                                                                         * TimingInfo : 'Now' for initial configuration; specific TimingInfo may be used for reconfiguration
                                                                         * ControlInfo : FollowOnFlag:=false (unless explicitly specified otherwise in TS 38.523-3 clause 7)*/
    Null_Type                           Release                         /* to remove a cell completely -
                                                                         * CellId : identifier of the cell to be released; nr_Cell_NonSpecific, in case all cells shall be released
                                                                         * TimingInfo : 'Now'
                                                                         * ControlInfo : FollowOnFlag:=false */
  };
  
  type record NR_CellConfigInfo_Type {                                  /* common information for initial cell configuration or reconfiguration;
                                                                           in case of reconfiguration omit means 'keep configuration as it is' */
    NR_SS_StaticCellResourceConfig_Type StaticResourceConfig  optional, /* mandatory for the initial configuration; to be omitted afterwards */
    NR_CellConfigCommon_Type            CellConfigCommon      optional, /* common configuration parameters which are not specific to physical layer (or any other layer) */
    NR_CellConfigPhysicalLayer_Type     PhysicalLayer         optional, /* Physical layer configuration: physical channels, signals and BWPs for UL and DL; DCI */

    //--------------------------------------------------------------------------
    NR_BcchConfig_Type                  BcchConfig            optional, /* configuration of BCCH/BCH; SS is triggered to configure RLC/MAC accordingly;
                                                                         * BCCH data on the PDSCH is distinguished by the SI-RNTI
                                                                         * PBCH: MIB;
                                                                         * PDSCH: scheduling and resource allocation; SIBs */
    NR_PcchConfig_Type                  PcchConfig            optional, /* configuration of PCCH/PCH; SS is triggered to configure RLC/MAC accordingly;
                                                                         * PCCH data on the PDSCH is distinguished by the P-RNTI
                                                                         * (needed even to modify SI => shall be configured for CELL_BROADCASTING) */
    //--------------------------------------------------------------------------
    // MAC: RACH procedure
    NR_RachProcedureConfig_Type         RachProcedureConfig   optional, /* to configure the SS's behaviour for the RACH procedure;
                                                                           may be omitted at initial configuration e.g. in case that the cell shall not have an uplink;
                                                                           NOTE: there is no way to explicitly remove the RACH procedure configuration after it has been configured for a cell */
    // MAC: UE-specific logical channels and related information
    NR_DcchDtchConfig_Type              DcchDtchConfig        optional, /* Parameters related to DCCH/DTCH in UL and DL */
    //--------------------------------------------------------------------------
    // Carrier aggregation and dual connectivity
    NR_ServingCellConfig_Type           ServingCellConfig     optional, /* To be configured at  initial configuration of a cell:
                                                                           for non-CA scenarios it shall be either 'SpCell' or 'None' ('None' applies for pure neighbouring cells) */
    NR_SidelinkScheduled_Type           SidelinkScheduled     optional, /* To configure SS for sidelink resource allocation mode 1 */
    //--------------------------------------------------------------------------
    // NTN-specific configuration
    NR_NTN_Config_Type                  NtnConfig             optional   /* to configure parameters specifically needed for NTN operation*/
  };

  type record NR_SS_StaticCellResourceConfig_Type {                     /* capabilities of a cell according to the initial condition of a test case, to allow resource management at SS implementation (see TS 38.508-1 clause 6.3.3) */
    NR_CellCA_Capability_Type            CA_Capability                   /* capability of a cell in context of carrier aggregation */
  };

  type enumerated NR_CellCA_Capability_Type {                            /* static information about the cell's capability for carrier aggregation, not being changed during a test case;
                                                                           may be used for resource management at the SS; according to TS 38.508-1 clause 6.3.3.2 */
    SpCell,                                                             /* Cell can be used as SpCell during a test case (primary cell of a master or secondary cell group; TS 37.340 clause 3.1);
                                                                           normal case i.e. applicable even when SpCell is the only cell of the cell group */
    Scell_Active,                                                       /* Active SCell: An NR cell that may become an SCell at any point of time during the test case and which, while being an SCell, may be activated */
    Scell_Inactive,                                                     /* Inactive SCell: An NR cell that may become an SCell at any point of time during the test case but is never activated while being an SCell */
    None                                                                /* e.g. when a cell is not used for connected mode during a test case (pure neighbouring cell) */
  };
  
  type record NR_CellConfigCommon_Type {                                /* common configuration parameters which are not specific to physical layer (or any other layer) */
    RNTI_Value_Type                     C_RNTI                optional, /* (pre-)configured C-RNTI used by physical layer and by MAC layer;
                                                                         * affects scrambling of PDSCH/PUSCH and CRC of PDCCH(s);
                                                                         * shall be used implicitly in RACH procedure (i.e. as CE in RAR) */
    CellTimingInfo_Type                 CellTimingInfo        optional,
    NR_InitialCellPower_Type            InitialCellPower      optional  /* reference cell power of each antenna in DL
                                                                         * NOTE 1:
                                                                         * the power of an antenna may be reduced by antenna specific configuration
                                                                         * NOTE 2:
                                                                         * in general the power may be adjusted on a per resource element basis
                                                                         * => all physical channel/signal power settings shall be adjusted relatively to the reference cell power;
                                                                         * if there are more than one TX antennas each one may have its own attenuation;
                                                                         * independently from those relative power settings the cell power can easily be adjusted by just changing the reference power */
  };

  type union NR_Attenuation_Type {                                      /* attenuation of the reference power */
    integer                             Value (0..149),                 /* cell power reference power reduced by the given attenuation (value is in dB);
                                                                           corresponds to AbsoluteCellPower_Type */
    Null_Type                           Off                             /* =< -145dBm according to TS 38.508-1 Table 6.2.2.1-3 */
  };
  
  const NR_Attenuation_Type tsc_NR_CellAttenuation_Off := {Off:=true};
  type NR_Attenuation_Type NR_InitialAttenuation_Type (tsc_NR_CellAttenuation_Off);  /* Attenuation restricted to 'Off' */
  
  type record NR_InitialCellPower_Type {
    NR_AbsoluteCellPower_Type           MaxReferencePower,              /* maximum value of cell reference power (in dBm/SCS as per TS 38.508-1, clause 6.2.2);
                                                                         * a cell is initialised with this reference power;
                                                                         * its value is the upper bound of the cell power during the test case */
    NR_InitialAttenuation_Type          Attenuation                     /* initial attenuation */
  };

  } // End sub-group Cell_Configuration_Common

  //----------------------------------------------------------------------------
  
  group PhysicalLayer {

  type record NR_CellConfigPhysicalLayer_Type {                         /* Common configuration of physical channels, signals and BWPs */
    NR_CellConfigPhysicalLayerCommon_Type       Common        optional, /* Configuration common for UL and DL */
    NR_CellConfigPhysicalLayerDownlink_Type     Downlink      optional, /* DL configuration */
    NR_CellConfigPhysicalLayerUplink_Type       Uplink        optional  /* UL configuration;
                                                                           may be omitted at initial configuration e.g. in case that the cell shall not have an uplink;
                                                                           NOTE: there is no way to explicitly remove the uplink configuration after it has been configured for a cell */
  };

  group PhysicalLayer_Common {

  type record NR_CellConfigPhysicalLayerCommon_Type {                   /* Configuration common for UL and DL */
    PhysCellId                          PhysicalCellId        optional, /* Physical-layer cell identity according to 38.211 clause 7.4.2.1;
                                                                           EN-DC: corresponds to ServingCellConfigCommon.physCellId */
    NR_DuplexMode_Type                  DuplexMode            optional  /* FDD or TDD; FDD/TDD specific parameters */
  };

  type union NR_DuplexMode_Type {                                       /* FDD/TDD and maybe other types of duplex mode; in general FDD/TDD mode is determined from the frequency band */
    NR_FDD_Info_Type                    FDD,
    NR_TDD_Info_Type                    TDD
  };

  type record NR_FDD_Info_Type {                                        /* FDD (paired spectrum) */
    boolean                             HalfDuplexFDD         optional  /* "true" for RedCap half-duplex FDD. When configured, the SS shall operate as per the HD-FDD SS requirements specified in 38.523-3 clause 7.3.2.2.2.
                                                                         * May be omitted at initial configuration when it is not applied.
                                                                         */
  };
  
  type record of NR_ASN1_TDD_UL_DL_SlotConfig_Type NR_TDD_UL_DL_SlotConfigList_Type;    /* corresponds to ServingCellConfig.tdd-UL-DL-ConfigurationDedicated */

  type union NR_ASN1_SharedSpectrumSemiStatic_Type {
    SemiStaticChannelAccessConfig_r16  R16
  };

  type union NR_SharedSpectrum_ChannelAccessMode_Config_Type {
    NR_ASN1_SharedSpectrumSemiStatic_Type   SemiStatic,  /* Configures the parameter period (Tx) for semi-static channel access mode. TS 37.213, clause 4.3 */
    Null_Type                               Dynamic
  };
  
  type record NR_TDD_Config_Type {                                      /* Common and dedicated TDD configuration */
    NR_ASN1_TDD_UL_DL_ConfigCommon_Type Common                optional, /* Common TDD configuration as used in TS 38.213 clause 11 corresponding to ServingCellConfigCommon.tdd-UL-DL-ConfigurationCommon;
                                                                           shall be present for TDD at initial configuration */

    NR_TDD_UL_DL_SlotConfigList_Type    Dedicated             optional, /* Dedicated TDD configuration for single slots over-ruling the flexible slots of the common configuration;
                                                                           corresponds to ServingCellConfig.tdd-UL-DL-ConfigurationDedicated;
                                                                           shall be present for TDD at initial configuration: the list is empty when there is no dedicated slot configuration;
                                                                           (omit means "keep as it is");
                                                                           NOTE: The dedicated configuration can only exist together with common configuration as a single slot configuration is related to the periodicity given by the common configuration (see TDD-UL-DL-SlotConfig field description for slotIndex in TS 38.331) */
    NR_SharedSpectrum_ChannelAccessMode_Config_Type  SharedSpectrum  optional /* To configure shared spectrum channel access mode according to TS 37.213 */
  };

  type union NR_TDD_Info_Type {                                         /* cell specific parameters for TDD (unpaired spectrum) */
    NR_TDD_Config_Type                  Config,                         /* specific TDD configuration with sets of symbols for UL and DL and possibly flexible symbols which are not specified as UL or DL
                                                                           (corresponding to TDD-UL-DL-ConfigurationCommon and TDD-UL-DL-ConfigDedicated according to TS 38.213 clause 11.1) */
    Null_Type                           FullFlexible                    /* No TDD configuration is provided to the UE: all slots and symbols are considered as flexible according to TS 38.213 clause 11.1 */
  };

  } // End sub-sub-group PhysicalLayer_Common

  //----------------------------------------------------------------------------
  
  group PhysicalLayer_Downlink {

  type record NR_CellConfigPhysicalLayerDownlink_Type {                 /* physical layer configuration at the SS for the downlink of a cell */
    NR_ASN1_FrequencyInfoDL_Type        FrequencyInfoDL       optional, /* carries information about location of CD-SSB and reference resource block (point A) in frequency domain
                                                                           and about associated frequency bands (list of FreqBandIndicatorNR) */
    NR_SSB_Config_Type                  SSPbchBlock           optional, /* Configuration of CD-SS/PBCH-block transmission */
    NR_PDSCH_CellLevelConfig_Type       PdschCellLevelConfig  optional, /* Cell-level configuration of PDSCH being applicable independent from the BWP a PDSCH is associated to */
    NR_DownlinkBWPs_Type                BWPs                  optional, /* Configuration of DL BWPs and their associated physical channels and signals */
    NR_CSI_Config_Type                  CsiConfig             optional  /* Configuration of CSI Reference Signals */
  };
  
  type integer NR_EPRE_Ratio_Type;                                      /* Energy per resource element relative to given reference signal or abstract reference cell power (dB) */
  
  //----------------------------------------------------------------------------
  
  group SS_PBCH_Block {                                                 /* SS/PBCH block configuration according to TS 38.213 clause 4.1:
                                                                           SS/PBCH block consists of synchronisation Signals (PSS and SSS) and PBCH (see e.g. TS 38.300 figure 5.2.4-1);
                                                                           a demodulation reference signal (DM-RS) is frequency multiplexed on the PBCH symbols (TS 38.300 clause 5.2.4, TS 38.211 clause 7.4.1.4) and
                                                                           the DM-RS sequence corresponds to the three LSBs of the SS/PBCH index (TS 38.213 clause 4.1 and TS 38.211 clause 7.4.1.4.1);
                                                                           the SS/PBCH index needs to be maintained by the SS (as the system frame number);
                                                                           the physical layer cell id is carried by PSS and SSS according to TS 38.211 clause 7.4.2 */

  type ServingCellConfigCommon.ssb_periodicityServingCell    NR_SSB_Periodicity_Type;
  type ServingCellConfigCommon.ssb_PositionsInBurst          NR_SSB_PositionsInBurst_Type;

  type enumerated NR_SS_BlockPattern_Type {                             /* TS 38.101-1, TS 38.101-2 and TS 38.101-5 clause 5.4.3.3 specify for a given operating band and SS Block subcarrier spacing which case of TS 38.213 clause 4.1 to be applied
                                                                           => first symbol indexes for candidate SS/PBCH blocks and the size of the bitmap are determined accordingly */
    caseA,                                                              /* 15  kHz subcarrier spacing: 4 bits (<= 3GHz) or 8 bits (> 3GHz); first symbol indexes: {2,8} + 14*n */
    caseB,                                                              /* 30  kHz subcarrier spacing: 4 bits (<= 3GHz) or 8 bits (> 3GHz); first symbol indexes: {4,8,16,20} + 28*n */
    caseC,                                                              /* 30  kHz subcarrier spacing: 4 bits (<= 3GHz) or 8 bits (> 3GHz); first symbol indexes: {2,8} + 14*n */
    caseD,                                                              /* 120 kHz subcarrier spacing: 64 bits (> 6GHz); first symbol indexes: {4,8,16,20} + 28*n */
    caseE                                                               /* 240 kHz subcarrier spacing: 64 bits (> 6GHz); first symbol indexes: {8,12,16,20,32,36,40,44} + 56*n */
  };
  
  type record NR_SSB_Beam_Type {
    integer                             SsbIndex              optional, /* SSB index starting at 0 according to TS 38.213 clause 4.1 */
    integer                             Attenuation           optional  /* Beam power: reference power for SSB transmissions relative to the actual reference cell power (MaxReferencePower - Attenuation of cell power);
                                                                           the beam power is reduced by 'Attenuation' relative to the actual reference cell power;
                                                                           the attenuation may be negative in which case the power level of the SSB transmission is higher than the actual cell power */
  };
  type record of NR_SSB_Beam_Type NR_SSB_BeamArray_Type;

  type record NR_SSB_BurstConfig_Type {                                 /* To describe the SSB burst */
    NR_SS_BlockPattern_Type             BlockPattern          optional, /* case A..E according to 38.213 clause 4.1;
                                                                           mandatory for initial configuration, "keep as it is" in case of omit otherwise */
    NR_SSB_PositionsInBurst_Type        PositionsInBurst      optional, /* "SSB-transmitted" parameter as used by the UE to rate-match around SSBs acc. 38.214 cl. 5.1;
                                                                           4, 8 or 64 bits;
                                                                           mandatory for initial configuration, "keep as it is" in case of omit otherwise */
    NR_SSB_BeamArray_Type               BeamArray             optional  /* beam specific configuration:
                                                                           if omit, all SSBs as configured in 'Bitmap' shall be transmitted with no attenuation (i.e. using the actual reference cell power);
                                                                           if present only the SSBs contained in the array shall be transmitted (with beam power as according to their entry in the array);
                                                                           when the array contains beams with an SSB index not included in 'Bitmap', the SS may raise an error */

  };

  type record NR_SSB_EPREs_Type {                                       /* EPRE for PBCH and related signals relative to the reference power (EPRE_SSB#N) of an SSB (beam) given by SSB index N */
    NR_EPRE_Ratio_Type                  PbchToDmrs            optional, /* transmit power for resource elements (REs) being occupied by PBCH;
                                                                           EPRE ratio of PBCH to PBCH DMRS */
    NR_EPRE_Ratio_Type                  PssToSss              optional, /* Primary synchronization signal; 38.211 clause 7.4.2.2;
                                                                           EPRE ratio of PSS to SSS */
    NR_EPRE_Ratio_Type                  SssToSsbBeam          optional, /* Secondary synchronization signal; 38.211 clause 7.4.2.3;
                                                                           EPRE ratio of SSS to EPRE_SSB#N; in general the SSS power is the same as the reference beam power, i.e. SssToSsbBeam = 0dB */
    NR_EPRE_Ratio_Type                  DmrsToSss             optional  /* DM-RS associated to PBCH (Demodulation reference signals for PBCH; 38.211 clause 7.4.1.4);
                                                                           EPRE ratio of PBCH DMRS to SSS */
  };
  
  type record NR_SSB_Config_Type {                                      /* Synchronization signals and PBCH; TS 38.211 clause 7.4.3, TS 38.300 clause 5.2.4;
                                                                         * NOTE:
                                                                         * CD-SSB location in frequency domain is specified by NR_CellConfigPhysicalLayerDownlink_Type.FrequencyInfoDL.absoluteFrequencySSB
                                                                         */
    SubcarrierSpacing                   SubCarrierSpacing     optional, /* sub-carrier spacing for SS/PBCH block (as specified by ServingCellConfigCommon.subcarrierSpacing in case of non-initial access):
                                                                         * According to comments for ServingCellConfigCommon.subcarrierSpacing "Only the values 15 or 30 kHz (<6GHz), 120 or 240 kHz (>6GHz) are applicable";
                                                                         * this corresponds to tables 13-1 .. 13-10 in TS 38.213 where only 15 or 30 kHz and 120 or 240 kHz are considered for SS/PBCH block sub-carrier spacing;
                                                                         * and it corresponds to 38.211 clause 7.4.3.1 defining SS/PBCH block type A as numerology=0,1 and type B as numerology=3,4 (i.e. there is no numerology=2 for SS/PBCH block)
                                                                         * NOTE 1:
                                                                         * in contrast to SS/PBCH block sub-carrier spacing the sub-carrier spacing for SIB1, Msg.2/4 for initial access and broadcast SI-messages is restricted to
                                                                         * 15kHz or 30kHz for carrier frequency <= 6 GHz and 60kHz or 120kHz for carrier frequency > 6 GHz
                                                                         * (see comments for MIB.subCarrierSpacingCommon and TS 38.213 tables 13-1 .. 13-10)
                                                                         * NOTE 2:
                                                                         * As long as there is no sub-carrier spacing of 60kHz (numerology=2) for the SS/PBCH block acc. to TS 38.211 Table 4.2-1 there is no extended cyclic prefix either
                                                                         * (even though Table 4.2-1 is mainly for BWP there is no indication for any extended cyclic prefix for SS/PBCH block)
                                                                         * => there is no need to specify the cyclic prefix for SS/PBCH block configuration (normal cyclic prefix is assumed for all cases) */
    integer                             SubcarrierOffset      optional, /* k_SSB as defined in TS 38.211 clause 7.4.3.1;
                                                                           needs to be consistent with absoluteFrequencySSB and absoluteFrequencyPointA as provided by FrequencyInfoDL to the UE and the SS;
                                                                           for operation with shared spectrum channel access, k_SSB = kbar_SSB */
    NR_SSB_Periodicity_Type             Periodicity           optional, /* in multiples of half frames (5ms) */
    integer                             HalfFrameOffset       optional, /* to specify together the Periodicity the half-frames in which the SSB burst shall be transmitted:
                                                                         * - for Periodicity = 5ms
                                                                         *   SSB burst in every half-frame
                                                                         * - for a Periodicity >= 5ms
                                                                         *   SSB burst in frames with (SFN mod (Periodicity / 10)) = (HalfFrameOffset / 2) and in the
                                                                         *   - lower half-frame for (HalfFrameOffset mod 2) = 0
                                                                         *   - higher half-frame for (HalfFrameOffset mod 2) = 1
                                                                         * Depending on the Periodicity the HalfFrameOffset has a range of 0 .. ((Periodicity / 5) - 1)
                                                                         * Unless explicitly required by a test case the HalfFrameOffset is always 0 */
    NR_SSB_BurstConfig_Type             BurstConfig           optional, /* to specify the burst configuration and a bitmap for the SS/PBCH block candidates which are eventually used for transmission of SS/PBCH blocks in a half frame */
    NR_SSB_EPREs_Type                   RelativeTxPower       optional  /* transmit power for PBCH and SS/PBCH signals
                                                                         * NOTE:
                                                                         * Parameter SS-PBCHBlockPower is provided to the UE in SIB1.ss-PBCH-BlockPower, ServingCellConfigCommon.ss-PBCH-BlockPower) as referenceSignalPower;
                                                                         * The UE uses referenceSignalPower to determine the transmission power of the PRACH (TS 38.213 clause 7.4)
                                                                         * => For signalling tests there seems to be no need to provide this parameter to the SS
                                                                         * (nevertheless the value provided to the UE shall not conflict with the power settings for the SSB at the SS) */
  };

  } // End sub-sub-sub-sub-group SS_PBCH_Block

  group CSI_Configuration {
  
  type union NR_CSI_RS_Periodicity_Type {                               /* NOTE: may be extended with 'Aperiodic' branch if needed */
    CSI_ResourcePeriodicityAndOffset    PeriodicityAndOffset            /* periodicity and slot offset as used by NZP-CSI-RS-Resource for periodic and semi-persistent configuration;
                                                                           the periodicity is given in the number of slots whereas CSI-RS-Resource-Mobility.slotConfig specifies the periodicity in millseconds
                                                                           => to configure the CSI-RS configuration corresponding to CSI-RS-Resource-Mobility the periodicity needs to be converted in TTCN depending on the numerology */
  };
  
  type record NR_NZP_CSI_RS_Config_Type {                               /* Channel-state information reference signal (CSI) according to TS 38.211 clause 7.4.1.5, TS 38.214 clause 5.1.6.1 and clause 5.2.2.3;
                                                                           the UE may be configured with non-zero-power (NZP) CSI-RS by
                                                                           a) NZP-CSI-RS-Resource (contained in CSI-MeasConfig) or
                                                                           b) CSI-RS-Resource-Mobility (contained in MeasConfig)
                                                                           (according to TS 38.211 clause 7.4.1.5.1) */
    ScramblingId                        ScramblingId          optional, /* INTEGER(0..1023); Scrambling ID for CSI-RS as provided to the UE in NZP-CSI-RS-Resource.scramblingID or CSI-RS-Resource-Mobility.sequenceGenerationConfig */
    CSI_RS_ResourceMapping              ResourceMapping       optional, /* resource mapping as used in NZP-CSI-RS-Resource;
                                                                           there is the following mapping with CSI-RS-CellMobility
                                                                           - frequencyDomainAllocation:
                                                                           For CSI-RS-Resource-Mobility there are row1 or row2 only
                                                                           - nrofPorts:
                                                                           One port for CSI-RS-Resource-Mobility (according to TS 38.211 Table 7.4.1.5.3-1 for Row=1 and Row=2)
                                                                           - firstOFDMSymbolInTimeDomain (l0):
                                                                           same for CSI-RS-ResourceMapping and CSI-RS-Resource-Mobility
                                                                           - firstOFDMSymbolInTimeDomain2 (l1):
                                                                           Not present for CSI-RS-Resource-Mobility (there is no l1 for Row=1 and Row=2 in Table 7.4.1.5.3-1 of TS 38.211)
                                                                           - cdm-Type:
                                                                           No CDM for CSI-RS-Resource-Mobility (according to Row=1 and Row=2 in Table 7.4.1.5.3-1 of TS 38.211)
                                                                           - density:
                                                                           ENUMERATED {d1,d3} for CSI-RS-CellMobility to be mapped to CHOICE (one, three) of CSI-RS-ResourceMapping
                                                                           - freqBand:
                                                                           According to TS 38.331
                                                                           a) CSI-FrequencyOccupation specifies the frequency range for CSI-RS relative to a given BWP (CSI-ResourceConfig.bwp-id) whereas
                                                                           b) CSI-RS-CellMobility specifies the position relative to point A (given by MeasObjectNR.refFreqCSI-RS)
                                                                           => As there is no equivalent to CSI-ResourceConfig.bwp-id for variant b), 'OffsetToFreqBand' is used to fully specify the frequency range (see below) */
    integer                             OffsetToFreqBand      optional, /* The frequency band for CSI-RS starts at OffsetToFreqBand + ResourceMapping.freqBand.startingRB from point A.
                                                                           a) When the UE is configured with NZP-CSI-RS-Resource:
                                                                           ResourceMapping.freqBand shall be set to the same value as signalled to the UE and OffsetToFreqBand shall be set offsetToCarrier + BWP.RB_Start.
                                                                           (NOTE: in general RB_Start is 0 in BWP.locationAndBandwidth: i.e. BWP.RB_Start=0 => OffsetToFreqBand = offsetToCarrier)
                                                                           b) When the UE is configured with CSI-RS-CellMobility:
                                                                           OffsetToFreqBand and ResourceMapping.freqBand.startingRB shall be set so that
                                                                           OffsetToFreqBand + ResourceMapping.freqBand.startingRB = CSI-RS-CellMobility.csi-rs-MeasurementBW.startPRB.
                                                                           (NOTE: In general it shall be
                                                                           OffsetToFreqBand = offsetToCarrier and
                                                                           ResourceMapping.freqBand.startingRB = CSI-RS-CellMobility.csi-rs-MeasurementBW.startPRB - offsetToCarrier) */
    NR_CSI_RS_Periodicity_Type          Periodicity           optional,
    integer                             Attenuation           optional  /* Beam power: reference power for CSI-RS transmissions relative to the actual reference cell power (MaxReferencePower - Attenuation of cell power);
                                                                           see NR_SSB_Beam_Type */
  };

  type record of NR_NZP_CSI_RS_Config_Type NR_NZP_CSI_RS_ConfigList_Type;       /* Array with set of CSI reference signals; each CSI-RS may belong to a different beam */

  type union NR_CSI_Config_Type {                                       /* Primitive for configuration CSI at the SS
                                                                           NOTE: further branches may be added e.g. to support CSI-IM */
    NR_NZP_CSI_RS_ConfigList_Type       CSI_RS,                         /* Configuration of CSI reference signals:
                                                                           Configuration of CSI reference signals does not necessarily mean that there is CSI reporting but CSI-RS is also needed for
                                                                           - link monitoring (beam failure scenarios) and
                                                                           - neighbouring cell measurement.
                                                                           For these cases periodic CSI-RS is used and may be started immediately (TimingInfo=Now) or at a specific point in time with periodicity as specified by Periodicity.PeriodicityAndOffset.
                                                                           Semi-persistent CSI-RS could be realised in the same way as periodic CSI-RS (but with specific TimingInfo).
                                                                           Aperiodic CSI-RS is not considered so far
                                                                           (NOTE: For simple cases of aperiodic CSI-RS NR_CSI_RS_Periodicity_Type may be extended with an 'Aperiodic' branch but e.g. combination of periodic and aperiodic CSI-RS would require a more complex approach, e.g. with explicit trigger for the transmission of the CSI-RS) */
    Null_Type                           None
  };

  } // End sub-sub-sub-sub-group CSI_Configuration
    
  //----------------------------------------------------------------------------
  
  group Cell_Level_Configuration_PDSCH {
  
  type record NR_PDSCH_CellLevelConfig_Type {                           /* cell-level parameters for PDSCH:
                                                                           in contrast to BWP specific parameters the cell-level parameters apply to any PDSCH independent from the BWP a PDSCH is associated to */
    NR_PDSCH_DMRS_TypeA_Position_Type   DMRS_TypeA_Position   optional, /* Provided to the UE by MIB.dmrs-TypeA-Position or ServingCellConfigCommon.dmrs-TypeA-Position;
                                                                           dmrs-TypeA-Position defines position of the first DM-RS symbol in the sequence of DM-RS symbols according to TS 38.211 clause 7.4.1.1. */
    NR_CellLevelRateMatchPattern_Type   RateMatchPattern      optional, /* rate match pattern according to TS 38.214 clause 5.1.4 */
    NR_ASN1_PDSCH_ServingCellConfig_Type ServingCellConfig    optional  /* PDSCH related parameters not being BWP-specific;
                                                                           corresponds to ServingCellConfig.pdsch-ServingCellConfig */
  };

  type MIB.dmrs_TypeA_Position NR_PDSCH_DMRS_TypeA_Position_Type;       /* same as ServingCellConfigCommon.dmrs-TypeA-Position */

  type record of NR_ASN1_RateMatchPattern_Type NR_RateMatchPatternList_Type;
  type record of NR_ASN1_RateMatchPatternLTE_CRS_Type NR_RateMatchPatternLteCrsList_Type;

  type record NR_CellLevelRateMatchPattern_Type {                       /* configuration of rate match pattern on cell level (see TS 38.214 clause 5.1.4) */
    NR_RateMatchPatternList_Type        PatternList  optional,          /* up to 4 cell-level RateMatchPattern according to TS 38.214 clause 5.1.4 (L1 RateMatchPattern);
                                                                           corresponds to ServingCellConfigCommon.rateMatchPatternToAddModList/rateMatchPatternToReleaseList;
                                                                           empty list per default (i.e. at initial configuration) */
    NR_RateMatchPatternLteCrsList_Type  PatternListLteCrs optional      /* 0 or 1 LTE CRS pattern to rate match around (see TS 38.214 clause 5.1.4.2)
                                                                           corresponds to ServingCellConfigCommon.lte-CRS-ToMatchAround;
                                                                           empty list per default (i.e. at initial configuration)  */
  };

  } // End sub-sub-sub-sub-group Cell_Level_Configuration_PDSCH

  //----------------------------------------------------------------------------
  
  group Downlink_BWP {

  type record NR_DownlinkBWP_Type {                                     /* Configuration of single BWP at the SS */
    BWP_Id                              Id                    optional, /* Initial BWP and RedCap-specific initial BWP: 0
                                                                         * Dedicated BWP:  1..4 */
    NR_ASN1_BWP_Type                    BWP                   optional, /* Frequency domain location and bandwidth, subcarrier spacing, cyclic prefix */
    NR_BWP_PDCCH_Configuration_Type     Pdcch                 optional,
    NR_BWP_PDSCH_Configuration_Type     Pdsch                 optional,
    NR_ASN1_SPS_Config_Type             Sps                   optional, /* BWP-DownlinkDedicated.SPS-Config */
    NR_BWP_PDCCH_Configuration_Type     SL_Pdcch              optional, /* For sidelink scheduled mode */
    NR_NCD_SSB_Config_Type              NCD_SSPbchBlock       optional  /* Configuration of NCD-SS/PBCH-block transmission.
                                                                           May be omitted at initial configuration e.g. in case no NCD-SSB is broadcast.
                                                                         */
  };

  type record of NR_DownlinkBWP_Type NR_DownlinkBWP_List_Type;          /* configuration of BWPs: each entry shall have a distinct Id, except for the initial DL BWP and the RedCap-specific initial DL BWP, which both use ID=0.
                                                                         * NOTE 1:
                                                                         * Even though in general the BWP-Id corresponds to the index of the element within the array of BWPs, the SS shall not take this as assumption */

  type record NR_DownlinkBWPs_Type {                                    /* configuration of downlink BWPs */
    BWP_Id                              ActiveBWP             optional, /* Id of the currently active BWP (this does not need to be the same as the index)
                                                                           According to TS 38.211 clause 4.4.5:
                                                                           "A UE can be configured with up to four carrier bandwidth parts in the downlink with a single downlink carrier bandwidth part being active at a given time.
                                                                           The UE is not expected to receive PDSCH, PDCCH, CSI-RS, or TRS outside an active bandwidth part." */
    NR_DownlinkBWP_List_Type            BwpArray              optional, /* array of band width parts: initial BWP + up to 4 dedicated BWPs */
    NR_DownlinkBWP_Type                 InitialBWP_RedCap     optional, /* RedCap-specific initial DL BWP. May be omitted at initial configuration when it is not applied (e.g. no RedCap-specific initial DL BWP to be configured), otherwise 'omit' means keep as it is. */
    NR_DownlinkBWP_SwitchIndicator_Type BWP_SwitchIndicator   optional  /* Indicates the DL BWP switch type. Omitted at initial configuration or when no active DL BWP switch applies. Not applicable for RedCap. */
  };

  type enumerated NR_DownlinkBWP_SwitchIndicator_Type {
    /* SS shall not transmit any DCI to the UE using this ASP call, whatever enumerated value is given to the SS. */
    ActiveBWP_SwitchNoDCI,    /* Active DL BWP switch. DL BWP switch not indicated to UE with a DCI */
    ActiveBWP_SwitchWithDCI   /* Active DL BWP switch. DL BWP switch will be indicated to UE with a DCI (format 1_x).
                               * TTCN implementation is responsible to trigger the DCI (format 1_x) transmission afterwards at SS by sending DL data or with a reconfiguration ASP indicating DciTrigger.
                               */
  };

  type record SPS_Config_R16 {
    SPS_ConfigToAddModList_r16          Sps_ConfigToAddModList_r16          optional,
    SPS_ConfigToReleaseList_r16         Sps_ConfigToReleaseList_r16         optional,
    SPS_ConfigDeactivationStateList_r16 Sps_ConfigDeactivationStateList_r16 optional
  };
  
  type record NR_NCD_SSB_Config_Type {                                 /* Synchronization signals and PBCH for NCD-SSB; TS 38.211 clause 7.4.3, TS 38.300 clause 5.2.4.
                                                                          To configure the NCD-SSB the SS shall, in addition, use the same values as those configured for the CD-SBB in
                                                                          - Cell.AddOrReconfigure.PhysicalLayer.Downlink.SSPbchBlock for the fields BurstConfig, Periodicity, HalfFrameOffset, BurstConfig.
                                                                          - Cell.AddOrReconfigure.PhysicalLayer.Common.PhysicalCellId
                                                                       */
    SubcarrierSpacing                   SubcarrierSpacing   optional,  /* sub-carrier spacing for NCD-SS/PBCH blocks */
    integer                             SubcarrierOffset    optional,  /* k_SSB as defined in TS 38.211 clause 7.4.3.1. Includes the most significant bit encoded within PBCH as specified in TS 38.213. */
    NR_SSB_EPREs_Type                   RelativeTxPower     optional,  /* Relative transmit power for NCD-SS/PBCH signals */
    NR_ASN1_NonCellDefiningSSB_Type     NonCellDefiningSSB  optional   /* Additional NCD-SSB parameters */
  };

  //----------------------------------------------------------------------------
  
  group PDSCH_Configuration {                                           /* Configuration of PDSCH and its related reference signals:
                                                                           - DM-RS (Demodulation reference signal); TS 38.211 clause 7.4.1.1
                                                                           - PT-RS (Phase-tracking reference signals for PDSCH); TS 38.211 clause 7.4.1.2 */

  type record NR_BWP_PDSCH_Configuration_Type {                         /* PDSCH configuration at the SS for specific BWP */
    NR_ASN1_PDSCH_ConfigCommon_Type     ConfigCommon          optional,
    NR_ASN1_PDSCH_Config_Type           ConfigDedicated       optional,
    NR_PDSCH_EPREs_Type                 RelativeTxPower       optional
  };

  type record NR_PDSCH_EPREs_Type {                                     /* EPRE for PDSCH and related signals */
    NR_EPRE_Ratio_Type                  PdschToCell           optional, /* transmit power relative to given reference cell power for resource elements (REs) being occupied by PDSCH */
    NR_EPRE_Ratio_Type                  PdschToDmrs           optional, /* EPRE power ratio of PDSCH to DM-RS being associated to the PDSCH according to TS 38.214 clause 4.1 */
    NR_EPRE_Ratio_Type                  PdschToPtrs           optional  /* EPRE power ratio of PDSCH to PT-RS being associated to the PDSCH according to TS 38.214 clause 4.1
                                                                           NOTE:
                                                                           PT-RS need only to be considered when being present (TS 38.211 clause 7.4.1.2.2 according to TS 38.214 clause 4.1),
                                                                           i.e. the SS shall ignore the PT-RS's EPRE if no PT-RS is present */
  };

  } // End sub-sub-sub-sub-group PDSCH_Configuration

  //----------------------------------------------------------------------------
  
  group PDCCH_Configuration {                                           /* Configuration of PDSCH and its related reference signals:
                                                                           - DM-RS (Demodulation reference signal); TS 38.211 clause 7.4.1.3 */

  type record NR_BWP_PDCCH_Configuration_Type {                         /* PDCCH configuration at the SS for specific BWP;
                                                                           NOTE:
                                                                           There are no fields for PDCCH-Config's "downlinkPreemption", "slotFormatIndicator", "tpc-PUSCH" and "tpc-PUCCH":
                                                                           This information is related to triggering DCI formats 2_X an shall be configured there (NR_DCI_Trigger_Type) according to test case requirements */
    NR_BWP_SearchSpaceList_Type         SearchSpaceArray      optional,
    NR_BWP_CoresetList_Type             CoresetArray          optional,
    NR_PDCCH_EPREs_Type                 RelativeTxPower       optional,
    integer                             Coreset0_OffsetRBs    optional   /* Number of Offset RBs as specified in 38.213 clause 13. Applied to CORESET#0 only */
  };

  type record of NR_ASN1_ControlResourceSet_Type NR_BWP_CoresetList_Type;       /* list of CORESETs defined for a single BWP;
                                                                                   according to TS 38.213 clause 10.1 "The control resource set configured for Type0-PDCCH common search space has control resource set index 0"
                                                                                   NOTE: even though in general (array) index and controlResourceSetId are the same it is not clear what is meant by TS 38.213 */
  type record of NR_BWP_SearchSpaceConfig_Type NR_BWP_SearchSpaceList_Type;     /* list of search spaces defined for a single BWP;
                                                                                   according to TS 38.213 clause 10.1 "The Type0-PDCCH common search space has search space index 0"
                                                                                   NOTE: even though in general (array) index and searchSpaceId are the same it is not clear what is meant by TS 38.213  */

  type record NR_PDCCH_EPREs_Type {                                     /* EPRE for PDCCH and related signals */
    NR_EPRE_Ratio_Type                  PdcchToCell           optional, /* transmit power relative to given reference cell power for resource elements (REs) being occupied by PDCCH */
    NR_EPRE_Ratio_Type                  PdcchToDmrs           optional  /* EPRE power ratio of PDCCH to DM-RS being associated to the PDCCH;
                                                                           further DMRS parameters are given by ASN.1 PDCCH-Config as signalled to the UE or by additional parameters of the initial BWP configuration */
  };

  //----------------------------------------------------------------------------
  
  group Search_Space_Configuration {

  type UInt_Type NR_SearchSpaceCandidatePriority_Type;                  /* Priorities to be considered by the SS in order to choose the candidate of a search space not colliding with the candidate of some other search space;
                                                                         * a value of 0 represents the highest priority, a value of 1 the second highest priority and so on.
                                                                         * (see TS 38.523-3 clause 7.1.2.1.4 for further details) */
  
  type enumerated NR_SearchSpaceType_Type {                             /* types of search spaces according to TS 38.213 clause 10.1;
                                                                           NOTE 1: In principle there could be more than one instance for the same kind of search space;
                                                                           if this is ever needed, this enumerated shall be enhanced by introduction of a second entry for a particular type.
                                                                           NOTE 2: For the USS UL and DL are distinguished as they may need different priority in terms of scheduling of DCIs */
    cssType0,                                                           /* Type0-PDCCH common search space for scheduling of SIB1 (SI-RNTI);
                                                                           the SS shall scramble the DCI format's CRC
                                                                           - with SI-RNTI for a DCI format 1_0
                                                                           - with MCCH-RNTI or G-RNTI for a DCI format 4_0 for MBS broadcast;
                                                                           aggregation level and number of candidates correspond to TS 38.213 Table 10.1-1;
                                                                           For stand-alone options parameters of search space and associated CORESET are according MIB.pdcch-ConfigSIB1 (TS 38.213 clause 13)
                                                                           */
    cssType0A,                                                          /* Type0A-PDCCH common search space for scheduling of other system information (SI-RNTI);
                                                                           the SS shall scramble the DCI format's CRC with SI-RNTI */
    cssType0B,                                                          /* Type0B-PDCCH common search space for a DCI format 4_0 with CRC scrambled by MCCH-RNTI or G-RNTI */
    cssType1,                                                           /* Type1-PDCCH common search space for scheduling of Msg2 or Msg4 of RACH procedure;
                                                                           the SS shall scramble the DCI format's CRC with RA-RNTI for Msg2 or with TC-RNTI for Msg4 (temporary C-RNTI) as configured for Msg4 (NR_TempC_RNTI_Type in NR_RAR_Payload_Type) */
    cssType1A,                                                          /* Type1A-PDCCH common search space for scheduling DCCH/DTCH and configured for sdt-SearchSpace for a DCI format with CRC scrambled by a C-RNTI or a CS-RNTI */
    cssType2,                                                           /* Type2-PDCCH common search space for scheduling of Paging messages or short messages (P-RNTI);
                                                                           the SS shall scramble the DCI format's CRC with P-RNTI */
    cssType2A,                                                          /* Type2A-PDCCH common search space for scheduling of Paging Early Indication messages the SS shall scramble the DCI format's CRC with PEI-RNTI */
    cssType3,                                                           /* Type3-PDCCH common search space for other purpose DCIs
                                                                           (INT-RNTI, SFI-RNTI, TPC-PUSCH-RNTI, TPC-PUCCH-RNTI, TPC-SRS-RNTI, C-RNTI, CS-RNTI(s), cellDTRX-RNTI);
                                                                           the SS shall scramble the DCI format's CRC with the RNTI-value as according to the ASP triggering the DCI to be sent */
    ussDL,                                                              /* UE-specific search space (C-RNTI, CS-RNTI(s));
                                                                           the SS shall scramble the DCI format's CRC with the C-RNTI value as stored for the cell (NR_CellConfigCommon_Type) */
    ussUL,                                                              /* UE-specific search space: as USS_DL but in general with lower priority to give DL assignments precedence over periodic UL grants */
    ussSL,                                                              /* UE-specific sidelink search space (SL-RNTI, SL-CS-RNTI);
                                                                           SS configured with NR_CellConfigInfo_Type.AddOrReconfigure.PhysicalLayer.Downlink.BWPs.BwpArray.SL_Pdcch.
                                                                           The SS shall scramble the DCI format's CRC with the SL-RNTI/SL-CS-RNTI value provided in NR_CellConfigInfo_Type.AddOrReconfigure.SidelinkScheduled.SL_DCI_Config.SearchSpaceAndDci.DciInfo.Format
                                                                         */
    ussDL_DCI_MC,                                                       /* UE-specific search space (C-RNTI) with DCI format 1_3;
                                                                           the SS shall scramble the DCI format's CRC with the C-RNTI value as stored for the cell (NR_CellConfigCommon_Type)
                                                                         */
    ussUL_DCI_MC                                                        /* UE-specific search space (C-RNTI) with DCI format 0_3: as USS_DL but in general with lower priority to give DL assignments precedence over periodic UL grants
                                                                         */
  };

  type record NR_SearchSpaceTypeAndPriority_Type {
    NR_SearchSpaceType_Type                     Type,
    NR_SearchSpaceCandidatePriority_Type        CandidatePriority       /* priority to be considered when candidates of a different or the same search space overlap the same CCEs */
  };

  type record of NR_SearchSpaceTypeAndPriority_Type NR_SearchSpaceTypeAndPriorityList_Type;
  
  type enumerated NR_PDCCH_CCE_AggregationLevel_Type {                  /* Aggregation level for a search space */
    AggregationLevel1,
    AggregationLevel2,
    AggregationLevel4,
    AggregationLevel8,
    AggregationLevel16
  };

  type record NR_BWP_SearchSpaceConfig_Type {                           /* configuration of a single search space at the SS:
                                                                         * The position of a particular search space candidate in frequency and time domain depends on configuration of the search space and its associated CORESET
                                                                         * (see TS 38.213 clause 10.1):
                                                                         * - Common or UE-specific search space
                                                                         * - aggregation level L
                                                                         * - number of candidates per aggregation level
                                                                         * - PDCCH monitoring periodicity and offset
                                                                         * - frequency domain resources
                                                                         * - number of symbols (time domain)
                                                                         * in addition in case of UE-specific search space:
                                                                         * - C-RNTI (as configured for the active cell)
                                                                         * - carrier indicator field value (in case of cross carrier scheduling)
                                                                         *
                                                                         * all fields are mandatory as modification of a single field may cause inconsistencies */
    NR_SearchSpaceTypeAndPriorityList_Type      TypeAndPriorityList,    /* list of search space types (according to TS 38.213 clause 10.1) to be mapped to the given search space configuration.
                                                                           NOTE 1:
                                                                           In general the lists of search space types for different search spaces shall be mutual exclusive;
                                                                           NOTE 2:
                                                                           TS 38.213 clause 10.1 could be read as if the different types of search spaces use distinct instances of search spaces;
                                                                           nevertheless RRC type definitions allow use of different types in one and the same search space */
    NR_PDCCH_CCE_AggregationLevel_Type          AggregationLevel,       /* aggregation level to be applied for an actual PDCCH of the given search space */
    NR_ASN1_SearchSpace_Type                    SearchSpaceConfigAtUE   /* search space configuration as sent to the UE; contains searchSpaceId and controlResourceSetId referring to the associated CORESET;
                                                                           furthermore the SS may need e.g. the number of candidates to detect error situations in context of candidate selection */
  };

  } // End sub-sub-sub-sub-sub-group Search_Space_Configuration

  //----------------------------------------------------------------------------
  
  group Search_Space_DCI_Assignment {

  type record of BWP_Id NR_BWP_Id_List_Type;

  type record NR_AssignedBWPs_Type {                                    /* definition of a set of BWPs being assigned e.g. to system information scheduling or RACH procedures
                                                                           NOTE 1: there is no error when e.g. "ActiveBWP" is set and the currently active BWP is contained in DedicatedBWPs too
                                                                           NOTE 2: it is up to use of this type in TTCN to ensure that a specific BWP assignment makes sense, in most cases multiple BWPs may not be applicable
                                                                           NOTE 3: "omit" means "not applied" */
    Null_Type                           ActiveBWP             optional, /* SS shall assign the currently active BWP */
    Null_Type                           InitialBWP            optional, /* SS shall assign the initial BWP */
    NR_BWP_Id_List_Type                 DedicatedBWPs,                  /* SS shall assign all BWPs as listed (on top of active or initial BWP if set); an empty list indicates that no (additional) BWPs are assigned */
    Null_Type                           InitialBWP_RedCap     optional, /* SS shall assign the RedCap-specific initial BWP */
    Null_Type                           CfrBWP                optional  /* SS shall assign the common frequency resource defined for MBS */
  };
  
  type record NR_SearchSpaceDlDciAssignment_Type {                      /* configuration of DCI for a specific search space;
                                                                           in general the configuration belongs to a transport channel configuration (e.g. BCH, PCH, DL-SCH):
                                                                           the DCI is applied for DL transmission on the respective channel and
                                                                           can be explicitly initiated by TTCN (e.g. PCH, DL-SCH) or automatically by the SS (e.g. BCH or Msg2/Msg4 scheduling of RACH procedure);
                                                                           all fields are mandatory for the first configuration of an instance for modifications "omit" means "keep as it is" */
    NR_AssignedBWPs_Type                AssignedBWPs          optional, /* BWP where given DCI shall be scheduled in given search space;
                                                                           NOTE 1:
                                                                           When there is no BWP according to configuration of AssignedBWPs, there is no DL assignment;
                                                                           this can be used e.g. to prevent automatic scheduling of system information;
                                                                           NOTE 2:
                                                                           In principle a DL assignment can happen simultaneously in more than one BWP e.g. if system information shall be scheduled in active and initial BWP;
                                                                           but as long as there is no use case for simultaneous DL assignments, configuration of AssignedBWPs shall be restricted to a maximum of one BWP */
    NR_SearchSpaceType_Type             SearchSpaceType       optional, /* search space to be used for sending of given DCI;
                                                                           when at the scheduled point in time of a DL transmission there is no such search space configured at the given BWP, the SS may raise an error */
    NR_DciDlInfo_Type                   DciInfo               optional  /* DCI to be used */
  };
  
  type record NR_SearchSpaceUlDciAssignment_Type {                      /* configuration of DCI for UL grants in the UL USS;
                                                                           in general the configuration belongs to a transport channel configuration (e.g. UL-SCH);
                                                                           all fields are mandatory for the first configuration of an instance for modifications "omit" means "keep as it is" */
    NR_AssignedBWPs_Type                AssignedBWPs          optional, /* BWP where given DCI shall be scheduled in given search space;
                                                                           AssignedBWPs shall specify exactly one BWP (ActiveBWP in general); the SS may raise an error otherwise */
    NR_SearchSpaceType_Type             SearchSpaceType       optional, /* search space to be used for sending of given DCI;
                                                                           when at the scheduled point in time of a UL grant transmission there is no such search space configured at the given BWP, the SS may raise an error */
    NR_DciUlInfo_Type                   DciInfo               optional  /* DCI to be used */
  };

  } // End sub-sub-sub-sub-sub-group Search_Space_DCI_Assignment
  } // End sub-sub-sub-sub-group PDCCH_Configuration
  } // End sub-sub-sub-group Downlink_BWP
  } // End sub-sub-group PhysicalLayer_Downlink

  //----------------------------------------------------------------------------
  
  group PhysicalLayer_Uplink {                                          /* Uplink physical layer configuration: UL channels and BWPs */
  
  type record NR_CellConfigPhysicalLayerUplink_Type {                   /* physical layer configuration at the SS for the uplink of a cell */
    NR_Uplink_Type                              Uplink                        optional,
    NR_Uplink_Type                              SupplementaryUplink           optional,
    NR_SS_TimingAdvanceConfig_Type              TimingAdvance                 optional,
    NR_ASN1_PUSCH_ServingCellConfig_Type        PUSCH_ServingCellConfig       optional,
    NR_ASN1_PUSCH_ServingCellConfig_Type        PUSCH_ServingCellConfigSUL    optional
  };

  type union NR_Uplink_Type {
    NR_UplinkConfig_Type                Config,
    Null_Type                           None                            /* in case the uplink or supplementary uplink is not used/needed */
  };
  
  type union NR_SS_TimingAdvanceConfig_Type {
    NR_RACH_TimingAdvance_Type          InitialValue,                   /* initial 12 bit value corresponding to Timing Advance Command field of the Random Access Response (TS 38.321 clause 6.2.3):
                                                                         * value of 0..3846 according to TS 38.213 clause 4.2; 0 in normal cases) */
    NR_TimingAdvanceIndex_Type          Relative,                       /* timing advance command to adjust changes of timing advance acc. to TS 38.213 clause 4.2;
                                                                         * (range acc. 6 bit value: -31..32) */
    NR_NTN_TimingAdvanceConfig_Type     NtnTA                           /* timing adjustment/alignment configuration for NTN operation */
  };

  group Uplink_BWP {

  type record NR_UplinkBWP_Type {                                       /* Configuration of single BWP at the SS;
                                                                           NOTE: for rel-15 this is the same as the ASN.1 type "BWP-Uplink" but nevertheless the TTCN type may be useful for future extensions */
    BWP_Id                              Id                    optional, /* Initial BWP and RedCap-specific initial BWP:    0
                                                                         * Dedicated BWP:  1..4 */
    NR_ASN1_BWP_UplinkCommon_Type       Common                optional, /* contains common configuration for RACH, PUSCH, PUCCH
                                                                         * configuration at the UE:
                                                                         * - Initial BWP:
                                                                         *   -> ServingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP
                                                                         *      ServingCellConfigCommon.supplementaryUplinkConfig.initialUplinkBWP
                                                                         *   -> SIB1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP
                                                                         *      SIB1.supplementaryUplink.uplinkConfigCommon.initialUplinkBWP
                                                                         * - RedCap-Specific initial BWP (if configured):
                                                                         *   -> ServingCellConfigCommon.uplinkConfigCommon-v1700.initialUplinkBWP-RedCap-r17
                                                                         *   -> SIB1.uplinkConfigCommon.initialUplinkBWP.initialUplinkBWP-RedCap-r17
                                                                         * - Dedicated BWP:
                                                                         *   -> ServingCellConfig.uplinkConfig.uplinkBWP-ToAddModList[-].bwp-Common
                                                                         *      ServingCellConfig.supplementaryUplink.uplinkBWP-ToAddModList[-].bwp-Common */
    NR_ASN1_BWP_UplinkDedicated_Type    Dedicated             optional  /* contains dedicated configuration for PUCCH, PUCCH, ConfiguredGrant, SRS, BeamFailureRecovery
                                                                         * configuration at the UE:
                                                                         * - Initial BWP:
                                                                         *   -> ServingCellConfig.uplinkConfig.initialUplinkBWP
                                                                         *      ServingCellConfig.supplementaryUplink.initialUplinkBWP
                                                                         * - Dedicated BWP:
                                                                         *   -> ServingCellConfig.uplinkConfig.uplinkBWP-ToAddModList[-].bwp-Dedicated
                                                                         *      ServingCellConfig.supplementaryUplink.uplinkBWP-ToAddModList[-].bwp-Dedicated */
  };
  
  type record of NR_UplinkBWP_Type NR_UplinkBWP_List_Type;              /* configuration of BWPs: each entry shall have a distinct Id, except for the initial UL BWP and the RedCap-specific initial UL BWP, which both use ID=0.
                                                                           NOTE: Even though in general the BWP-Id corresponds to the index of the element within the array of BWPs, the SS shall not take this as assumption */
  type union NR_ActiveUplinkBWP_Id_Type {
    BWP_Id      Explicit,                                               /* in case that BWP-Id of active UL-BWP (and/or active UL-BWP of supplementary UL) is different than BWP-Id of active DL-BWP */
    Null_Type   SameIdAsDL                                              /* same BWP-Id as of the active DL-BWP */
  };
  
  type record NR_UplinkBWPs_Type {                                      /* configuration of uplink BWPs */
    NR_ActiveUplinkBWP_Id_Type          ActiveBWP             optional, /* Id of the currently active BWP (this does not need to be the same as the index) */
    NR_UplinkBWP_List_Type              BwpArray              optional, /* array of band width parts: initial BWP + up to 4 dedicated BWPs */
    NR_UplinkBWP_Type                   InitialBWP_RedCap     optional, /* RedCap-specific initial UL BWP. May be omitted at initial configuration when it is not applied (e.g. no RedCap-specific initial UL BWP to be configured), otherwise 'omit' means keep as it is. */
    NR_UplinkBWP_SwitchIndicator_Type   BWP_SwitchIndicator   optional  /* Indicates the UL BWP switch type. Omitted at initial configuration or when no active UL BWP switch applies. Not applicable for RedCap. */
  };

  type enumerated NR_UplinkBWP_SwitchIndicator_Type {
    /* SS shall not transmit any DCI to the UE using this ASP call, whatever enumerated value is given to the SS. */
    ActiveBWP_SwitchNoDCI,        /* Active UL BWP switch. UL BWP switch not indicated to UE with a DCI */
    ActiveBWP_SwitchWithDCI       /* Active UL BWP switch. UL BWP switch will be indicated to UE with a DCI (format 0_x).
                                   * TTCN implementation is responsible to trigger the DCI (format 0_x) transmission afterwards at SS by sending UL grant.
                                   */
  };

  type record NR_UplinkConfig_Type {                                    /* configuration of a single uplink (uplink or supplementary uplink) */
    NR_ASN1_FrequencyInfoUL_Type        FrequencyInfoUL       optional, /* carries information about location of reference resource block (point A) in frequency domain
                                                                           and about associated frequency bands (list of FreqBandIndicatorNR) */
    NR_UplinkBWPs_Type                  BWPs                  optional,
    NR_ASN1_RACH_ConfigDedicated_Type   RACH_ConfigDedicated  optional, /* configuration at the UE:
                                                                           -> SpCellConfig.reconfigurationWithSync.rach-ConfigDedicated.uplink/supplementaryUplink */
    NR_ASN1_SI_RequestConfig_Type       SI_RequestConfig      optional  /* configuration of PRACH preamble(s) and PRACH resource(s) for si-RequestConfig configuration at the UE: ->    in SIB1.si-SchedulingInfo.si-RequestConfig
                                                                         * configuration of PRACH preamble(s) and PRACH resource(s) for SI request with Msg1 repetition: -> si-SchedulingInfo-v1800 included in the nonCriticalExtensions of SIB1
                                                                         */
  };
  
  } // End sub-sub-sub-group Uplink_BWP
  } // End sub-sub-group PhysicalLayer_Uplink

  //----------------------------------------------------------------------------

  group DCI_Configuration {                                   /* Definitions for resource assignment and DCI according to TS 38.212 clause 7.3 and TS 38.214 clause 5.1.2 and 6.1.2 */

  group Common_Fields {                                       /* Common type definitions for DCI fields being used for UL and DL assignments (format 0_X and 1_X);
                                                                 NOTE: in general fields of DCIs are defined as union in the first place to allow backward compatible enhancements,
                                                                 e.g. when a dynamic SS behaviour needs to replace the static value assignment
                                                               */
  
  type union NR_DciCommon_CarrierIndicator_Type {             /* Carrier indicator field (CIF) of DCI formats 0_1 and 1_1 according to TS 38.212 and TS 38.213 clause 10.1*/
    Null_Type                           None,                 /* no cell index to be indicated in Carrier indicator field */
    B3_Type                             CellIndex             /* 3 bits cell index to be indicated in Carrier indicator field; applicable when the UE is configured with higher layer parameter CrossCarrierSchedulingConfig */
  };

  type union NR_DciCommon_BWPIndicator_Type {                 /* Bandwidth part indicator according to TS 38.212 Table 7.3.1.1.2-1; used to address RRC-configured BandwidthPart-Config;
                                                                 NOTE:
                                                                 in general the BWP configuration at the SS is static i.e. dedicated BWPs may be preconfigured in a test case preamble =>
                                                                 a) BWP configuration at the SS is not always the same as at the UE and SS cannot determine the number of BWPs being configured at the UE from its BWP configuration.
                                                                 b) The number and order of BWPs may differ at SS and UE.
                                                                 c) The index used in the DCI's BWP indicator is not identical with the BWP-Id as the BWP indicator is the index in the UE's BWP array
                                                                 => in general the SS cannot determine the size and value of the DCI's BWP indicator but this need to be done in TTCN
                                                               */
    bitstring                           Index                 /* 0, 1 or 2 bits */
  };

  type union NR_DciCommon_TpcCommand_Type {                   /* TPC Command Field according to TS 38.213 Table 7.1.1-1 and Table 7.2.1-1 */
    B2_Type                             Value,                /* 2 bits; default value: '01'B (0 dB; accumulated TPC) */
    bitstring                           ValueBitstring        /* For DCI format 0_3 : number of bits determined by the number of blocks as per TS 38.212 clause 7.3.1.1.4 */
  };

  type union NR_DciCommon_UL_SUL_Indicator_Type {             /* TS 38.212 clause 7.3.1.1.1/2: UL/SUL indicator */
    Null_Type                           None,                 /* to be used when no SUL is configured */
    B1_Type                             Value                 /* UL/SUL indicator according to TS 38.212 Table 7.3.1.1.1-1 */
  };

  type union NR_DciCommon_VrbPrbMapping_Type {                /* to specify how VRB-to-PRB mapping shall be controlled by DCI if applicable (see TS 38.212 Table 7.3.1.2.2-5 and where it is referred) */
    Null_Type                           None,                 /* 0 bit, applicable for format 1_0 when only resource allocation type 0 is configured */
    B1_Type                             Index                 /* 1 bit, index in TS 38.212 Table 7.3.1.2.2-5 indicating non-interleaved or interleaved VRB-to-PRB mapping according to TS 38.211 clause 6.3.1.7 */
  };

  type union NR_DciCommon_TimeDomainResourceAssignment_Type {   /* Common type definition for UL/DL Resource allocation in time domain according to TS 38.214 clause 5.1.2.1 and 6.1.2.1 */
    bitstring                           Index                   /* index of entry in SEQUENCE OF PUSCH/PDSCH-TimeDomainResourceAllocation provided e.g. by PUSCH/PDSCH-Config;
                                                                   number of bits in a particular DCI depends on the size of the SEQUENCE OF PUSCH/PDSCH-TimeDomainResourceAllocation or PUSCH-TimeDomainResourceAllocationList-r16
                                                                   (e.g. Time domain resource assignment is an empty bitstring (''B) when only one time-domain configuration is provided to the UE)
                                                                   NOTE: PDSCH/PUSCH-Config overrules list in PDSCH/PUSCH-ConfigCommon
                                                                   For DCI format 0_3/1_3: index of entry in the higher layer parameter tdra-FieldIndexListDCI-0-3/tdra-FieldIndexListDCI-1-3
                                                                 */
  };
  
  type union NR_DciFormat_X_1_SrsRequest_Type {                 /* TS 38.212 clause 7.3.1.2: SRS request */
    B2_Type                             SingleUL,               /* 2 bits: Index of the SRS resource set to be used according to TS 38.212 Table 7.3.1.1.2-24 */
    B3_Type                             UL_SUL                  /* 3 bits: Index of the SRS resource set to be used according to TS 38.212 Table 7.3.1.1.2-24 plus first bit to distinguish UL/SUL */
  };

  type union NR_DciCommon_DmrsSequenceInit_Type {               /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.1.3 (format 0_2), clause 7.3.1.1.4 (format 0_3), clause 7.3.1.2.2 (format 1_1) and clause 7.3.1.2.3 (format 1_2): DMRS sequence initialization */
    Null_Type                           None,                   /* 0 bit
                                                                    - for format 0_1 if transform precoder is enabled;
                                                                    - for format 0_2 if dmrs-SequenceInitializationDCI-0-2 is not configured or if transform precoder is enabled;
                                                                    - for format 1_2 if dmrs-SequenceInitializationDCI-1-2 is not configured or if transform precoder is enabled
                                                                 */
    B1_Type                             Value                   /* 1 bit else */
  };

  type union NR_DciCommon_PriorityIndicator_Type {              /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.2.2 (format 1_1), clause 7.3.1.1.3 (format 0_2), clause 7.3.1.2.3 (format 1_2), clause 7.3.1.1.4 (format 0_3) and clause 7.3.1.2.4 (format 1_3): Priority indicator */
    Null_Type                           None,                   /*  0 bit no Priority indicator, if higher layer parameter priorityIndicatorDCI-0-1/priorityIndicatorDCI-1-1/priorityIndicatorDCI-0-2/priorityIndicatorDCI-1-2/priorityIndicatorDCI-0-3/priorityIndicatorDCI-1-3  is not configured */
    B1_Type                             Value                   /*  1 bit as defined in Clause 9 in TS 38.213. */
  };
  
  type union NR_DciCommon_MinimumApplicableSchedulingOffset_Type { /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.2.2 (format 1_1), clause 7.3.1.1.4 (format 0_3) and clause 7.3.1.2.4 (format 1_3): Minimum applicable scheduling offset indicator */
     Null_Type                          None,                    /* 0 bit no Minimum applicable scheduling offset indicator */
     B1_Type                            Value                    /* 1 bit if minimumSchedulingOffsetK2(format 0_1)/minimumSchedulingOffsetK0(format 1_1)/minimumSchedulingOffsetK0DCI-0-3(format 0_3)/minimumSchedulingOffsetK0DCI-1-3(format 1_3) is configured. Set according to TS 38.212 according to TS 38.212 Table 7.3.1.1.2-33. */
  };
  
  type union NR_DciCommon_SCellDormancyIndication_Type {     /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.2.2 (format 1_1) clause 7.3.1.1.4 (format 0_3) clause 7.3.1.2.4 (format 1_3): SCell dormancy indication */
     Null_Type                          None,                /* 0 bit no SCell dormancy indication */
     bitstring                          Value                /* 1, 2, 3, 4 or 5 bits: determined according to dormancyGroupWithinActiveTime parameter */
  };
  
  type union NR_DciFormat_X_0_ChannelAccessCPext_Type {         /* TS 38.212 clause 7.3.1.1.1 and clause 7.3.1.2.1: ChannelAccess-CPext */
    Null_Type                           None,                   /* 0 bit no ChannelAccess-CPext  */
    B2_Type                             Value                   /* 2 bits indicating combinations of channel access type and CP extension as defined in TS 38.212 Table 7.3.1.1.1-4 or Table 7.3.1.1.1-4A if channelAccessMode-r16 = "semiStatic" is provided, for operation in a cell with shared spectrum channel access. */
  };

  type union NR_DciFormat_X_2_CarrierIndicator_Type {        /* Carrier indicator field (CIF) of DCI formats 0_2 and 1_2 according to TS 38.212 and TS 38.213 clause 10.1*/
    Null_Type                           None,                   /* no cell index to be indicated in Carrier indicator field */
    bitstring                           CellIndex               /* 1, 2 or 3 bits cell index to be indicated in carrierIndicatorSize_r16.carrierIndicatorSizeDCI_1_2_r16/carrierIndicatorSize_r16.carrierIndicatorSizeDCI_0_2_r16 */
  };

  type union NR_DciFormat_X_2_SrsRequest_Type {                 /* TS 38.212 clause 7.3.1.2.3 and clause 7.3.1.1.3: SRS Request  */
    Null_Type                           None,                   /* srs-RequestDCI-0-2-r16/srs-RequestDCI-1-2-r16 is not present*/
    bitstring                           Value                   /*  1 or 2 or 3 bits as defined in 7.3.1.2.3/7.3.1.1.3 */
  };
  
  type union NR_DciCommon_SecondTpcCommand_Type {                       /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2) clause 7.3.1.2.2 (Format 1_1) clause 7.3.1.2.3 (Format 1_2): Second TPC command for scheduled PUSCH */
    Null_Type                           None,                           /* no second TPC command */
    NR_DciCommon_TpcCommand_Type        SecondTpc                       /* 2 bits as defined in Clause 7.1.1 of TS 38.213 if higher layer parameter SecondTPCFieldDCI-0-X is configured */
  };

  type union NR_DciCommon_SrsOffsetIndicator_Type {             /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.1.3 (format 0_2), clause 7.3.1.1.4 (format 0_3), clause 7.3.1.2.2 (format 1_1), clause 7.3.1.2.3 (format 1_2) and clause 7.3.1.2.4 (format 1_3): SRS offset indicator depending on AvailableSlotOffset */
    Null_Type                           None,                   /* no  SRS offset indicator */
    bitstring                           Indicator               /* According to Table 7.3.1.1.2-37 and Clause 6.2.1 of TS 38.214.
                                                                   Empty string if higher layer parameter AvailableSlotOffset is not configured for any aperiodic SRS resource set in the scheduled cell, or if higher layer parameter AvailableSlotOffset is configured for at least one aperodic SRS resource set in the scheduled cell and the maximum number of entries of availableSlotOffsetList configured for all aperiodic SRS resource set(s) is 1 */
  };

  type union NR_DciCommon_PdcchMonitoringAdaptationIndication_Type { /* TS 38.212 clause 7.3.1.1.2 (format 0_1), clause 7.3.1.2.2 (format 1_1), clause 7.3.1.1.3 (format 0_2), clause 7.3.1.2.3 (format 1_2), clause 7.3.1.1.4 (format 0_3), and clause 7.3.1.2.4 (format 1_3): PDCCH monitoring adaptation indication */
    Null_Type                           None,                        /* PDCCH monitoring adaptation indication */
    bitstring                           Value                        /* 1 or 2 bits, depending on searchSpaceGroupIdList-r17 and pdcch-SkippingDurationList */
  };
  
  } // End sub-sub-sub-sub-sub-sub-group Common_Fields

  //----------------------------------------------------------------------------
  
  group Resource_Allocation {                                           /* Type definitions for resource allocation which do not correpond directly to DCI fields
                                                                           but are used to configure how the SS maintains resource allocation for a given DCI */

  type enumerated NR_ResourceAllocationType_Type {                      /* to specify the format of the resource allocation type being used for frequency domain resource assignment in DCI;
                                                                           NOTE 1:
                                                                           For DCI Format 0_0 and 1_0 only resourceAllocationType1 is applicable (TS 38.214 clause 5.1.2.2 and 6.1.2.2)
                                                                           NOTE 2:
                                                                           The SS needs to determine based on RRC configuration whether MSB of the frequency domain resource assignment needs to be used as discriminator for type 0/1
                                                                           (see TS 38.212 clause 7.3.1.1.2 and clause 7.3.1.2.2 and PUSCH/PDSCH-Config.resourceAllocation)
                                                                           NOTE 3:
                                                                           The SS shall raise an error if the DCI configuration conflicts with the configuration given by PUSCH/PDSCH-Config.resourceAllocation */
    resourceAllocationType0,                                            /* resource allocation type 0 according to TS 38.214 clause 5.1.2.2.1 and 6.1.2.2.1:
                                                                           bitmap indicating the Resource Block Groups (RBGs) that are allocated;
                                                                           not applicable for DCI Format 0_0 and 1_0 */
    resourceAllocationType1                                             /* resource allocation type 1 according to TS 38.214 clause 5.1.2.2.2 and 6.1.2.2.2:
                                                                           resource indication value (RIV) corresponding to a starting virtual resource block and a length in terms of contiguously allocated resource blocks */
  };
  
  type integer NR_ImcsValue_Type (0..31);                               /* Modulation and coding scheme index coding */
  
  type enumerated NR_ModulationSchemePDSCH_Type {                       /* Supported modulation schemes for PDSCH according to 38.211 Table 7.3.1.2-1 */
    qpsk,
    qam16,
    qam64,
    qam256
  };
  
  type record NR_FreqDomainSchedulExplicit_Type {                       /* type used for explicit DL scheduling; Nprb is the exact number of RBs whereas in NR_FreqDomainSchedulCommon_Type MaxRbCnt is the upper bound  */
    integer                             FirstRbIndex,                   /* index of the first resource block in frequency domain */
    integer                             Nprb                            /* number of resource blocks to be assigned */
  };
  
  type record NR_FreqDomainSchedulCommonDL_Type {                       /* common type to specify restrictions for frequency domain scheduling by a start index and a maximum range of RBs
                                                                           (similar to EUTRA, but for NR in general the frequency domain scheduling is not related to the whole frequency band but to a given band width part (BWP) */
    integer                             FirstRbIndex,                   /* index of the first (virtual) resource block in frequency domain */
    integer                             MaxRbCnt                        /* maximum number of resource-blocks to be used for a transport block;
                                                                           SS shall not assigned more than the given resource blocks;
                                                                           FirstRbIndex + MaxRbCnt shall not exceed the total number of available resoource blocks in frequency domain; the SS shall raise an error otherwise */
  };
  
  type union NR_FreqDomainResourceAssignmentDL_Type {
    NR_FreqDomainSchedulCommonDL_Type   Automatic,                      /* The SS shall automatically do the resource assignment needed for a DL transmission based on TBS evaluation guideline given in Annex B.1 of 38.523-3 */
    NR_FreqDomainSchedulExplicit_Type   Explicit                        /* Frequency domain resource assignment is given explicitly by TTCN;
                                                                           the SS needs to calculate the RIV (resource allocation type 1) or generate the bitmap (resource allocation type 0).
                                                                           In case of resource allocation type 0 the allocation shall also be in consecutive RBGs.
                                                                           NOTE: So far there is no requirement for signalling tests to use non-consecutive RBGs ((neither for LTE nor for NR) */
  };

  type integer NR_RedundancyVersion_Type (0..255);                              /* Redundancy Version (RV):
                                                                                    - 2 bits  if the number of scheduled PUSCH indicated by the Time domain resource assignment field is 1
                                                                                    - 2, 3, 4, 5, 6, 7 or 8 bits determined by the maximum number of schedulable PUSCHs among all entries in pusch-TimeDomainAllocationListForMultiPUSCH (TS 38.212 clause 7.3.1.1.2).
                                                                                 */
  type record of NR_RedundancyVersion_Type NR_RedundancyVersionList_Type;       /* There shall be as many entries in the list as re-transmissions are allowed;
                                                                                 * if there are not enough elements specified SS shall raise an error;
                                                                                 * In 4G at least in UL the array length corresponds to maxHARQ-Tx (i.e. up to 28 re-transmissions according to RRC ASN.1) */

  type record NR_TransportBlockSchedulingDL_Automatic_Type {            /* transport block information for a DL transmission and potential retransmission in automatic mode */
    NR_ModulationSchemePDSCH_Type       TransportBlock1,
    NR_ModulationSchemePDSCH_Type       TransportBlock2       optional, /* MCS for 2nd transport block (if any); 'omit' means that there is no 2nd transport block;
                                                                           presence corresponds to PDSCH-Config.maxNrofCodeWordsScheduledByDCI */
    NR_RedundancyVersionList_Type       RedundancyVersionList optional  /* list of Redundancy versions to be used for DL transmission and possible retransmissions;
                                                                           not present, if the DL transmission does not make use of harq processing (e.g. paging);
                                                                           in automatic mode the same list of redundancy versions is used for both transport blocks;
                                                                           if there are not enough elements to achieve successful DL transmission, SS shall raise an error */
  };
  
  type union RetransmissionTiming_Type {                                /* to specify the timing of potential retransmissions related to the initial transmission.
                                                                         * Rules in case of necessary UL or DL retransmissions:
                                                                         * - When a transmission is scheduled with TimingInfo=Now, then any retransmission of a previous transmission takes precedence over the new transmission
                                                                         * - Retransmissions take precedence over periodic UL grants
                                                                         * - The SS shall raise an error indication when
                                                                         *   - a retransmission collides with another UL or DL transmission which is scheduled by TTCN with specific TimingInfo for the same slot as the retransmission
                                                                         *   - a new DL transmission would take over an ongoing DL transmission
                                                                         *   - the retransmission is not possible at the given time for any other reason (e.g. due to slot format) */
    integer                             SlotOffset,                     /* the kth retransmission shall be k * SlotOffset slots after the initial transmission:
                                                                         * e.g. slots per subframe = N  and initial transmission at subframeX and slotX =>
                                                                         * 1. retransmission at subframeX + (slotX + SlotOffset) / N and (slotX + SlotOffset) mod N
                                                                         * 2. retransmission at subframeX + (slotX + 2*SlotOffset) / N and (slotX + 2*SlotOffset) mod N
                                                                         * and so on */
    integer                             SubframeOffset,                 /* the kth retransmission shall be k * SubframeOffset subframes after the initial transmission in the same slot of subframe as for the initial transmission:
                                                                         * e.g. initial transmission at subframeX and slotX
                                                                         * 1. retransmission at subframeX + SubframeOffset and slotX
                                                                         * 2. retransmission at subframeX + 2*SubframeOffset and slotX
                                                                         * and so on */
    Null_Type                           AnyTime                         /* the SS shall autonomously determine the next possible occasion for the retransmission */
  };

  type union TransmissionTimingOffset_Type {                            /* Timing information for retransmissions */
    Null_Type                           None,                           /* initial transmission: no timing offset but timing info as according to common part of the ASP */
    RetransmissionTiming_Type           Retransmission                  /* retransmission with timing offset relative to initial transmission */
  };
  
  type record NR_TransportBlockSingleTransmission_Type {                /* TS 38.212 clause 7.3.1.2.1 and 7.3.1.2.2: parameters for transmission (or re-transmission) of a single transport block;
                                                                           used for explicit mode of DL transmission and for UL grants */
    TransmissionTimingOffset_Type       TimingOffset,                   /* in general "None" in case of a new transmission (i.e. no timing offset) and "Retransmission" for any retransmission */
    NR_ImcsValue_Type                   ImcsValue,                      /* Imcs value to be mapped to the Modulation and coding scheme field of DCI format 1_0 or 1_1 or 0_0 or 0_1
                                                                           If numberOfMsg3-RepetitionsList is configured in the SS (NR_UplinkBWP_Type.R15.numberOfMsg3_RepetitionsList_r17) and PUSCH is scheduled by DCI format 0_0 with CRC scrambled by TC-RNTI,
                                                                              the 2 MSBs of the MCS information field of the DCI format 0_0 provide a codepoint to determine the number of repetitions K according to TS 38.214 Table 6.1.2.1-1A and the 3 LSBs of MCS determine the Imcs as per TS 38.214 Table 6.1.4.1-4
                                                                         */
    NR_RedundancyVersion_Type           RedundancyVersion,              /* Redundancy version for a single transmission or re-transmission */
    boolean                             ToggleNDI                       /* "true" for transmission of a new transport block, "false" for a re-transmission;
                                                                           the NDI (New data indicator) itself is maintained by the SS and therefore not provided as configuration parameter */
  };
  
  type record of NR_TransportBlockSingleTransmission_Type NR_TransportBlockRetransmissionList_Type; /* list of (initial) transmission and potential retransmissions;
                                                                                                       used for explicit mode of DL transmission and for UL grants;
                                                                                                       in general the Imcs is the same for all (re-)transmissions and the NDI is not toggled for the retransmissions */
  
  type record NR_TransportBlockSchedulingDL_Explicit_Type {
    NR_TransportBlockRetransmissionList_Type  TransportBlock1,          /* list of transmission and retransmissions for transport block 1 */
    NR_TransportBlockRetransmissionList_Type  TransportBlock2 optional  /* 'omit' means that there is no 2nd transport block;
                                                                           Presence corresponds to PDSCH-Config.maxNrofCodeWordsScheduledByDCI */
  };
  
  type union NR_TransportBlockSchedulingDL_Type {
    NR_TransportBlockSchedulingDL_Automatic_Type        Automatic,
    NR_TransportBlockSchedulingDL_Explicit_Type         Explicit
  };
  
  type union NR_HarqProcessConfig_Type {                                /* HARQ processes to be used automatically for UL grants or DL assignments */
    Null_Type                           None,                           /* when there is no HARQ for the given DCI (paging) */
    Null_Type                           Broadcast,                      /* when the broadcast process shall be used */
    Null_Type                           AnyProcess,                     /* The SS may choose any process for scheduling of the UL/DL data transfer */
    NR_HarqProcessList_Type             SpecificSubset                  /* only the HARQ processes of this list shall be used automatically, other processes are excluded from automatic assignments;
                                                                           nevertheless for DL any HARQ processes may be addressed explicitly by NR_DRB_DataPerSlot_DL_Type.HarqProcess */
  };
  
  } // End sub-sub-sub-sub-sub-sub-group Resource_Allocation_Common

  group PDSCH_Scheduling {

  type record NR_DciDlInfo_Type {                                                       /* scheduling for CCCH/DCCH/DTCH mapped to DL-SCH mapped to PDSCH;
                                                                                           for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards;
                                                                                           definition is applicable for DCI format 1_X */
    NR_DciFormat_DL_ResourceAssignment_Type         ResoureAssignment         optional, /* resource assignment; to control setting of the following fields in DCI formats 1_X (TS 38.212 clause 7.3.1.2.X):
                                                                                           Frequency domain resource assignment
                                                                                           Time domain resource assignment
                                                                                           Modulation and coding scheme
                                                                                           New data indicator
                                                                                           Redundancy version
                                                                                           HARQ process number
                                                                                           Not applicable for DCI format 1_3: omitted
                                                                                         */
    
    NR_DciCommon_VrbPrbMapping_Type                 VrbPrbMapping             optional, /* VRB-to-PRB mapping */
    NR_DciFormat_1_X_SpecificInfo_Type              Format                    optional  /* DCI format and DCI format specific parameters */
  };

  type record NR_DciFormat_DL_ResourceAssignment_Type {                                 /* Common definition to be used for resource scheduling in DL */
    NR_ResourceAllocationType_Type                  ResourceAllocationType    optional, /* resource allocation type to be used for the frequency domain resource assignment */
    NR_FreqDomainResourceAssignmentDL_Type          FreqDomain                optional,
    NR_DciCommon_TimeDomainResourceAssignment_Type  TimeDomain                optional,
    NR_TransportBlockSchedulingDL_Type              TransportBlockScheduling  optional, /* information about MCS and RV for one or two transport blocks */
    NR_HarqProcessConfig_Type                       HarqProcessConfig         optional  /* configures which HARQ processes the SS may use;
                                                                                           corresponds to "HARQ process number" in TS 38.212 clause 7.3.1.2.1 and 7.3.1.2.2 */
  };
  
  type union NR_DciFormat_1_X_SpecificInfo_Type {
    NR_DciFormat_1_0_SpecificInfo_Type             Format_1_0,
    NR_DciFormat_1_0_P_RNTI_SpecificInfo_Type      Format_1_0_P_RNTI,
    NR_DciFormat_1_0_SI_RNTI_SpecificInfo_Type     Format_1_0_SI_RNTI,
    NR_DciFormat_1_0_RA_RNTI_SpecificInfo_Type     Format_1_0_RA_RNTI,
    NR_DciFormat_1_1_SpecificInfo_Type             Format_1_1,
    NR_DciFormat_1_2_SpecificInfo_Type             Format_1_2,
    NR_DciFormat_1_3_SpecificInfo_Type             Format_1_3
  };

  type record NR_DciFormat_1_0_SpecificInfo_Type {                                      /* TS 38.212 clause 7.3.1.2.1: scheduling of PDSCH in one DL cell; default parameters according to TS 38.508-1 clause 4.3.6.1.2.1 */
    NR_DciFormat_1_0_DAI_Type                       DAI                       optional, /* downlink assignment index */
    NR_DciCommon_TpcCommand_Type                    TpcCommandPucch           optional, /* TPC command for scheduled PUCCH; to be set to 1 per default (0 dB; accumulated TPC) */
    NR_DciFormat_1_X_PucchResourceIndicator_Type    PucchResourceIndicator    optional, /* PUCCH resource indicator */
    NR_DciFormat_1_X_PdschHarqTimingIndicator_Type  PdschHarqTimingIndicator  optional, /* PDSCH-to-HARQ_feedback timing indicator */
    NR_DciFormat_X_0_ChannelAccessCPext_Type        ChannelAccessCPext        optional  /* ChannelAccess-CPext */
  };

  type record NR_DciFormat_1_0_P_RNTI_SpecificInfo_Type {                               /* TS 38.212 clause 7.3.1.2.1: scheduling of PDSCH with DCI scrambled by P-RNTI; default parameters according to TS 38.508-1 clause 4.3.6.1.2.1 */
    B2_Type                                         ShortMessageIndicator     optional, /* Short Message Indicator according to TS 38.212 Table 7.3.1.2.1-1 */
    B8_Type                                         ShortMessages             optional, /* Short Messages according to TS 38.331 Table 6.5-1 */
    B2_Type                                         TbScaling                 optional, /* Scaling factor according to TS 38.214 Table 5.1.3.2-2 */
    NR_DciFormat_1_0_P_RNTI_TrsAvailabilityIndication_Type TrsAvailabilityIndication optional  /* TRS availability indication */
  };

  type record NR_DciFormat_1_0_SI_RNTI_SpecificInfo_Type {                              /* TS 38.212 clause 7.3.1.2.1: scheduling of PDSCH with DCI scrambled by SI-RNTI; default parameters according to TS 38.508-1 clause 4.3.6.1.2.1 */
    B1_Type                                         SystemInfoIndicator       optional  /* System information indicator according to TS 38.212 Table 7.3.1.2.1-2 */
  };

  type record NR_DciFormat_1_0_RA_RNTI_SpecificInfo_Type {                              /* TS 38.212 clause 7.3.1.2.1: scheduling of PDSCH with DCI scrambled by RA-RNTI/MSGB-RNTI; default parameters according to TS 38.508-1 clause 4.3.6.1.2.1.
                                                                                           FFS whether this is applicable to MsgB-RNTI
                                                                                           */
    B2_Type                                         TbScaling                 optional, /* Scaling factor according to TS 38.214 Table 5.1.3.2-2 */
    NR_DciFormat_1_0_LSBsOfSFN_Type                 LSBsOfSFN                 optional  /* LSBs of SFN */
  };

  type record NR_DciFormat_1_1_SpecificInfo_Type {                                      /* TS 38.212 clause 7.3.1.2.2: scheduling of PDSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.2.2
                                                                                           For all fields: 'omit' means that the information shall not be contained in the DCI on PDCCH */
    NR_DciCommon_CarrierIndicator_Type              CarrierIndicator          optional, /* Carrier indicator - CIF value for Cross Carrier Scheduling; 'None' otherwise */
    NR_DciCommon_BWPIndicator_Type                  BWPIndicator              optional, /* Bandwidth part indicator */
    NR_DciFormat_1_X_PrbBundlingSizeIndicator_Type  PrbBundlingSizeIndicator  optional, /* PRB bundling size indicator */
    NR_DciFormat_1_X_RateMatchingIndicator_Type     RateMatchingIndicator     optional, /* Rate matching indicator */
    NR_DciFormat_1_X_ZP_CSI_RS_Trigger_Type         ZP_CSI_RS_Trigger         optional, /* ZP CSI-RS trigger */
    NR_DciFormat_1_1_DAI_Type                       DAI                       optional, /* downlink assignment index */
    NR_DciCommon_TpcCommand_Type                    TpcCommandPucch           optional, /* TPC command for scheduled PUCCH; to be set to 1 per default (0 dB; accumulated TPC) */
    NR_DciFormat_1_X_SecondTpcCommand_Type          SecondTpcCommand          optional, /* Second TPC command for scheduled PUCCH  */
    NR_DciFormat_1_X_PucchResourceIndicator_Type    PucchResourceIndicator    optional, /* PUCCH resource indicator */
    NR_DciFormat_1_X_PdschHarqTimingIndicator_Type  PdschHarqTimingIndicator  optional, /* PDSCH-to-HARQ_feedback timing indicator */
    NR_DciFormat_1_X_OneShotHarqAckRequest_Type     OneShotHarqAckRequest     optional, /* One-shot HARQ-ACK request  */
    NR_DciFormat_1_X_EnhancedType3CodebookIndicator_Type EnhancedType3CodebookIndicator optional, /* Enhanced Type 3 codebook indicator */
    NR_DciFormat_1_1_PdschGroupIndex_Type           PdschGroupIndex           optional, /* PDSCH group index */
    NR_DciFormat_1_1_NewFeedbackIndicator_Type      NewFeedbackIndicator      optional, /* New feedback indicator */
    NR_DciFormat_1_1_NumberRequestedPdschGroup_Type NumberRequestedPdschGroup optional, /* Number of requested PDSCH group */
    NR_DciFormat_1_X_HarqAckRetransmissionIndicator_Type HarqAckRetransmissionIndicator optional, /* HARQ-ACK retransmission indicator */
    NR_DciFormat_1_1_AntennaPorts_Type              AntennaPorts              optional, /* Antenna port(s) */
    NR_DciFormat_1_1_TCI_Type                       TCI                       optional, /* Transmission configuration indication */
    NR_DciFormat_1_X_TCI_Selection_Type             TCI_Selection             optional, /* TCI selection */
    NR_DciFormat_X_1_SrsRequest_Type                SrsRequest                optional, /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type            SrsOffsetIndicator        optional, /* SRS offset indicator */
    NR_DciFormat_1_1_CBGTI_Type                     CBGTI                     optional, /* CBG transmission information (CBGTI) */
    NR_DciFormat_1_1_CBGFI_Type                     CBGFI                     optional, /* CBG flushing out information (CBGFI) */
    NR_DciCommon_DmrsSequenceInit_Type              DmrsSequenceInit          optional, /* DMRS sequence initialization */
    NR_DciCommon_PriorityIndicator_Type             PriorityIndicator         optional, /* Priority indicator */
    NR_DciFormat_1_X_ChannelAccessCPext_Type        ChannelAccessCPext        optional, /* ChannelAccess-CPext */
    NR_DciCommon_MinimumApplicableSchedulingOffset_Type  MinimumApplicableSchedulingOffset optional, /* Minimum applicable scheduling offset indicator */
    NR_DciCommon_SCellDormancyIndication_Type      SCellDormancyIndication    optional, /* SCell dormancy indication */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type   PdcchMonitoringAdaptationIndication optional, /* PDCCH monitoring adaptation indication */
    NR_DciFormat_1_X_PucchCellIndicator_Type        PucchCellIndicator        optional, /* PUCCH Cell indicator */
    NR_DciFormat_1_1_CoScheduledUE_Info_Type        CoScheduledUE             optional  /* Co-scheduled UE information  */
  };

   type record NR_DciFormat_1_2_SpecificInfo_Type {                                     /* TS 38.212 clause 7.3.1.2.3: scheduling of PDSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.2.3.
                                                                                           For all fields: 'omit' means that the information shall not be contained in the DCI on PDCCH */
    NR_DciFormat_X_2_CarrierIndicator_Type          CarrierIndicator          optional, /* Carrier indicator - CIF value for Cross Carrier Scheduling; 'None' otherwise */
    NR_DciCommon_BWPIndicator_Type                  BWPIndicator              optional, /* Bandwidth part indicator */
    NR_DciFormat_1_X_PrbBundlingSizeIndicator_Type  PrbBundlingSizeIndicator  optional, /* PRB bundling size indicator */
    NR_DciFormat_1_X_RateMatchingIndicator_Type     RateMatchingIndicator     optional, /* Rate matching indicator */
    NR_DciFormat_1_X_ZP_CSI_RS_Trigger_Type         ZP_CSI_RS_Trigger         optional, /* ZP CSI-RS trigger */
    NR_DciFormat_1_2_DAI_Type                       DAI                       optional, /* downlink assignment index */
    NR_DciCommon_TpcCommand_Type                    TpcCommandPucch           optional, /* TPC command for scheduled PUCCH; to be set to 1 per default (0 dB; accumulated TPC) */
    NR_DciFormat_1_X_SecondTpcCommand_Type          SecondTpcCommand          optional, /* Second TPC command for scheduled PUCCH  */
    NR_DciFormat_1_2_PucchResourceIndicator_Type    PucchResourceIndicator    optional, /* PUCCH resource indicator */
    NR_DciFormat_1_X_PdschHarqTimingIndicator_Type  PdschHarqTimingIndicator  optional, /* PDSCH-to-HARQ_feedback timing indicator */
    NR_DciFormat_1_X_OneShotHarqAckRequest_Type     OneShotHarqAckRequest     optional, /* One-shot HARQ-ACK request  */
    NR_DciFormat_1_X_EnhancedType3CodebookIndicator_Type EnhancedType3CodebookIndicator optional, /* Enhanced Type 3 codebook indicator */
    NR_DciFormat_1_X_HarqAckRetransmissionIndicator_Type HarqAckRetransmissionIndicator optional, /* HARQ-ACK retransmission indicator */
    NR_DciFormat_1_2_AntennaPorts_Type              AntennaPorts              optional, /* Antenna port(s) */
    NR_DciFormat_1_2_TCI_Type                       TCI                       optional, /* Transmission configuration indication */
    NR_DciFormat_1_X_TCI_Selection_Type             TCI_Selection             optional, /* TCI selection */
    NR_DciFormat_X_2_SrsRequest_Type                SrsRequest                optional, /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type            SrsOffsetIndicator        optional, /* SRS offset indicator */
    NR_DciCommon_DmrsSequenceInit_Type              DmrsSequenceInit          optional, /* DMRS sequence initialization */
    NR_DciCommon_PriorityIndicator_Type             PriorityIndicator         optional, /* Priority indicator */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type   PdcchMonitoringAdaptationIndication optional, /* PDCCH monitoring adaptation indication */
    NR_DciFormat_1_X_ChannelAccessCPext_Type        ChannelAccessCPext        optional, /* ChannelAccess-CPext */
    NR_DciFormat_1_X_PucchCellIndicator_Type        PucchCellIndicator        optional  /* PUCCH Cell indicator */
  };

  type union NR_DciFormat_1_X_PucchResourceIndicator_Type {             /* TS 38.212 clause 7.3.1.2.1/2/4: PUCCH resource indicator */
    B3_Type                             Value                           /* 3 bits as defined in TS 38.213 clause 9.2.3 or reserved bits;
                                                                           index to "PUCCH-ResourceSet" according to 38.213 clause 9.2.3  as provided by PUCCH-Config */
  };

  type union NR_DciFormat_1_X_PdschHarqTimingIndicator_Type {           /* TS 38.212 clause 7.3.1.2.1/2/4: PDSCH-to-HARQ_feedback timing indicator (TS 38.213 clause 9.2.3) */
    bitstring                           Value                           /* Format 1_0: 3 bits, addresses one of {1, 2, 3, 4, 5, 6, 7, 8} according to TS 38.213 clause 9.2.3;
                                                                           Format 1_1: 0..3 bits, addresses entry in table provided by PUCCH-Config.dl-DataToUL-ACK
                                                                           Format 1_3: 0..3 bits as defined in clause 9.2.3 of TS 38.213
                                                                         */
  };

  type union NR_DciFormat_1_0_DAI_Type {                                /* TS 38.212 clause 7.3.1.2.1: DAI (downlink assignment indicator) */
    DAI_B2_Type                         Index                           /* 2 bits according to TS 38.213 clause 9.1.3 or reserved bits */
  };

  type union NR_DciFormat_1_0_LSBsOfSFN_Type {                          /* TS 38.212 clause 7.3.1.2.1: LSBs of SFN  */
    Null_Type                           None,                           /* no LSBs of SFN */
    Null_Type                           Automatic                       /* LSBs of SFN automatically assigned by SS; 2 bits        */
  };

  type union NR_DciFormat_1_X_PrbBundlingSizeIndicator_Type {           /* TS 38.212 clause 7.3.1.2.X: PRB bundling size indicator */
    Null_Type                           None,                           /* no PRB bundling */
    B1_Type                             Dynamic                         /* when PDSCH-Config.prb-BundlingType is set to 'dynamicBundling';
                                                                           indicates which set of PRG values to be used (see 38.214 clause 5.1.2.3) */
  };

  type union NR_DciFormat_1_X_RateMatchingIndicator_Type {              /* TS 38.212 clause 7.3.1.2.X: Rate matching indicator
                                                                         */
    bitstring                           Bitmap                          /* 0, 1, or 2 bits: bitmap indicating rateMatchPatternGroup1/rateMatchPatternGroup1DCI-1-2/rateMatchListDCI-1-3 and/or rateMatchPatternGroup2/rateMatchPatternGroup2DCI-1-2/rateMatchListDCI-1-3 to be applied
                                                                           size depending on rateMatchPatternGroup1, rateMatchPatternGroup2, rateMatchPatternGroup1DCI-1-2/rateMatchListDCI-1-3 configured by PDSCH-Config at the UE
                                                                         */
  };

  type union NR_DciFormat_1_X_ZP_CSI_RS_Trigger_Type {                  /* TS 38.212 clause 7.3.1.2.X: ZP CSI-RS trigger */
    bitstring                           Index                           /* 0, 1, or 2 bits: Index in list of ZP-CSI-RS-Resource as configured by PDSCH-Config at the UE */
  };

 
  type union NR_DciFormat_1_1_DAI_Type {                                /* TS 38.212 clause 7.3.1.2.2: DAI (downlink assignment indicator)
                                                                           - 6 bits if more than one serving cell are configured in the DL and the higher layer parameter nfi-TotalDAI-Included = enable
                                                                           - 4 bits if only one serving cell are configured in the DL and the higher layer parameter nfi-TotalDAI-Included = enable
                                                                           - 4 bits if more than one serving cell are configured in the DL, the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic or pdsch-HARQ-ACK-Codebook=enhancedDynamic-r16, and nfi-TotalDAI-Included is not configured
                                                                           - 4 bits if only one serving cell is configured in the DL, and the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic, and the UE is not provided CORESETPoolIndex or is provided CORESETPoolIndex with value 0 for one or more first CORESETs and is provided CORESETPoolIndex with value 1 for one or more second CORESETs, and is provided ACKNACKFeedbackMode = JointFeedback
                                                                           - 2 bits if only one serving cell is configured in the DL, the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic or pdsch-HARQ-ACK-Codebook=enhancedDynamic-r16, and nfi-TotalDAI-Included is not configured, when the UE is not configured with CORESETPoolIndex or the value of CORESETPoolIndex is the same for all CORESETs if CORESETPoolIndex is provided or the UE is not configured with ACKNACKFeedbackMode = JointFeedback
                                                                        */
    Null_Type                           None,                           /* no DAI */
    DAI_B2_Type                         TwoBits,
    DAI_B4_Type                         FourBits,
    DAI_B6_Type                         SixBits
  };

  type union NR_DciFormat_1_1_AntennaPorts_Type {                       /* TS 38.212 clause 7.3.1.2.2: Antenna ports as defined by TS 38.212 Tables 7.3.1.2.2-1/2/3/4/7/8/9/10 and Tables 7.3.1.2.2-1A/2A/3A/4A/7A/8A/9A/10A */
    bitstring                           Index                           /* bitstring presentation of index to TS 38.212 Tables 7.3.1.2.2-1/2/3/4/7/8/9/10 and Tables 7.3.1.2.2-1A/2A/3A/4A/7A/8A/9A/10A*/
  };

  type union NR_DciFormat_1_1_TCI_Type {                                /* TS 38.212 clause 7.3.1.2.2: Transmission configuration indication (TCI) */
    Null_Type                           None,                           /* if ControlResourceSet.tci-PresentInDCI does not indicate 'enabled' */
    B3_Type                             Value                           /* if ControlResourceSet.tci-PresentInDCI=='enabled': TCI according to TS 38.213 clause 5.1.5/6 */
  };


  type union NR_DciFormat_1_1_CBGTI_Type {                              /* TS 38.212 clause 7.3.1.2.2: CBG transmission information (CBGTI) */
    bitstring                           Bitmap                          /* 0, 2, 4, 6, or 8 bits according to PDSCH-CodeBlockGroupTransmission.maxCodeBlockGroupsPerTransportBlock and PDSCH-Config.maxNrofCodeWordsScheduledByDCI and TS 38.214 clause 5.1.7.2 */
  };

  type union NR_DciFormat_1_1_CBGFI_Type {                              /* TS 38.212 clause 7.3.1.2.2: CBG flushing out information (CBGFI) */
    Null_Type                           None,                           /* no CBGFI */
    B1_Type                             Flag                            /* CBGFI flag, if codeBlockGroupTransmission is configured in PDSCH-ServingCellConfig with codeBlockGroupFlushIndicator set to true */
  };

  type union NR_DciFormat_1_1_CoScheduledUE_Info_Type {                 /* TS 38.212 clause 7.3.1.2.2: Co-scheduled UE information */
    Null_Type                           None,                           /* no Co-scheduled UE information  */
    B3_Type                             Value                           /* 3 bits as defined in 38.212 Table 7.3.1.2.2-12  */
  };
    
  type union NR_DciFormat_1_X_ChannelAccessCPext_Type {                 /* TS 38.212 clause 7.3.1.2.2/4: ChannelAccess-CPext  */
    Null_Type                           None,                           /* no ChannelAccess-CPext */
    bitstring                           Value                           /* 1, 2, 3 or 4 bits. Determined with ul-AccessConfigListDCI-1-X or in Table 7.3.1.1.1-4A if channelAccessMode-r16 = "semiStatic" is provided, for operation in a cell with shared spectrum channel access; otherwise 0 bit. One or more entries from Table 7.3.1.2.2-6 or Table 7.3.1.2.2-6A are configured by the higher layer parameter ul-AccessConfigListDCI-1-1. */
  };
  
  type union DAI_B1_Type {
    B1_Type                             Index,                          /* 1 bit DAI value */
    Null_Type                           Automatic                       /* DAI automatically assigned by SS according to clause 7.1.2.1.3.3 */
  };

  type union DAI_B2_Type {
    B2_Type                             Index,                          /* 2 bits DAI value */
    Null_Type                           Automatic                       /* DAI automatically assigned by SS according to clause 7.1.2.1.3.3 */
  };

  type union DAI_B4_Type {
    B4_Type                             Index,                          /* 4 bits DAI value */
    Null_Type                           Automatic                       /* DAI automatically assigned by SS according to clause 7.1.2.1.3.3 */
  };

  type union DAI_B6_Type {
    B6_Type                             Index,                          /* 6 bits DAI value */
    Null_Type                           Automatic                       /* DAI automatically assigned by SS according to clause 7.1.2.1.3.3 */
  };
  
  type union NR_DciFormat_1_X_OneShotHarqAckRequest_Type {             /* TS 38.212 clause 7.3.1.2.2/3/4: One-shot HARQ-ACK request  */
    Null_Type                           None,                          /* no One-shot HARQ-ACK request */
    B1_Type                             Value                          /* 1 bit if higher layer parameter pdsch-HARQ-ACK-OneShotFeedback-r16 or pdsch-HARQ-ACK-OneShotFeedback-r16 or pdsch-HARQ-ACK-EnhType3List or pdsch-HARQ-ACK-OneShotFeedbackDCI-1-2 or pdsch-HARQ-ACK-EnhType3DCI-1-2 or pdsch-HARQ-ACK-OneShotFeedbackDCI-1-3 or pdsch-HARQ-ACK-enhType3DCI-1-3 is configured */
  };
   
  type union NR_DciFormat_1_1_PdschGroupIndex_Type {                  /* TS 38.212 clause 7.3.1.2.2: PDSCH group index */
    Null_Type                           None,                         /* no PDSCH group index */
    B1_Type                             Value                         /* 1 bit if the higher layer parameter pdsch-HARQ-ACK-Codebook = enhancedDynamic-r16 */
  };
  
  type union NR_DciFormat_1_1_NewFeedbackIndicator_Type {             /* TS 38.212 clause 7.3.1.2.2: New feedback indicator */
    Null_Type                           None,                         /* no New feedback indicator */
    bitstring                           Value                         /* 1 or 2 bits if pdsch-HARQ-ACK-Codebook = enhancedDynamic-r16 */
  };
  
  type union NR_DciFormat_1_1_NumberRequestedPdschGroup_Type {       /* TS 38.212 clause 7.3.1.2.2: Number of requested PDSCH group(s) */
    Null_Type                           None,                        /* no Number of requested PDSCH group(s) */
    B1_Type                             Value                        /* if the higher layer parameter pdsch-HARQ-ACK-Codebook = enhancedDynamic-r16 */
  };
  
  type union NR_DciFormat_1_2_DAI_Type {                             /* TS 38.212 clause 7.3.1.2.3: DAI (downlink assignment indicator)
      0 bit if the higher layer parameter downlinkAssignmentIndexDCI-1-2 is not configured;
      4 bits if more than one serving cell are configured in the DL and the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic, where the 2 MSB bits are the counter DAI and the 2 LSB bits are the total DAI
      4 bits if one serving cell are configured in the DL and the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic, and the UE is not provided coresetPoolIndex or is provided coresetPoolIndex with value 0 for one or more first CORESETs and is provided coresetPoolIndex with value 1 for one or more second CORESETs, and is provided ackNackFeedbackMode = joint, where the 2 MSB bits are the counter DAI and the 2 LSB bits are the total DAI.
      1 or 2 bits if only one serving cell is configured in the DL and the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic, when the UE is not configured with coresetPoolIndex or the value of coresetPoolIndex is the same for all CORESETs if coresetPoolIndex is provided or the UE is not configured with ackNackFeedbackMode = joint, where the 1 bit or 2 bits are the counter DAI.
                                                                      */
    Null_Type                           None,                        /* no DAI */
    DAI_B1_Type                         OneBit,
    DAI_B2_Type                         TwoBits,
    DAI_B4_Type                         FourBits
  };

  type union NR_DciFormat_1_2_PucchResourceIndicator_Type {         /* TS 38.212 clause 7.3.1.2.3: PUCCH resource indicator */
    Null_Type                           None,                       /* Numberofbits-forPUCCHresourceindicator-DCIFormat1_2 is not present*/
    bitstring                           Value                       /*  1 or 2 or 3 bits determined by parameter Numberofbits-forPUCCHresourceindicator-DCIFormat1_2 */
  };
   type union NR_DciFormat_1_2_AntennaPorts_Type {                  /* TS 38.212 clause 7.3.1.2.3: Antenna ports as defined by TS 38.212 Tables 7.3.1.2.2-6..26 and Tables 7.3.1.2.2-1A/2A/3A/4A */
     Null_Type                           None,                      /* antennaPortsFieldPresenceDCI-1-2 is not configured */
     bitstring                           Index                      /* 2, 3, 4, or 5 bits, bitstring presentation of index to TS 38.212 Tables 7.3.1.2.2-6..26 and Tables 7.3.1.2.2-1A/2A/3A/4A */
  };

  type union NR_DciFormat_1_2_TCI_Type {               /* TS 38.212 clause 7.3.1.2.3: Transmission configuration indication */
    Null_Type                           None,          /* tci-PresentDCI-1-2-r16 is not present */
    bitstring                           Value          /*  1 or 2 or 3 bits determined by parameter tci-PresentDCI-1-2-r16 */
  };

  type union NR_DciFormat_1_0_P_RNTI_TrsAvailabilityIndication_Type {   /* TS 38.212 clause 7.3.1.2.1: TRS availability indication depending on TRS-ResourceSetConfig */
    Null_Type                           None,                           /* no TRS availability indication */
    bitstring                           Value                           /* 1, 2, 3, 4, 5, or 6 bits, where the number of bits is equal to one plus the highest value of all the indBitID(s) provided by the TRS-ResourceSetConfig if configured */
   };


  type union NR_DciFormat_1_X_SecondTpcCommand_Type {           /* TS 38.212 clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2): Second TPC command for scheduled PUCCH  */
    Null_Type                           None,                   /* No second TPC command for scheduled PUCCH */
    B2_Type                             Value                   /* 2 bits; as defined in Clause 7.2.1 of TS 38.213 if higher layer parameter SecondTPCFieldDCI-1-X is configured */
  };
  
  type union NR_DciFormat_1_X_EnhancedType3CodebookIndicator_Type {/* TS 38.212 clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2) 7.3.1.2.4 (Format 1_3): Enhanced Type 3 codebook indicator depending on pdsch-HARQ-ACK-EnhType3DCI-Field or pdsch-HARQ-ACK-EnhType3DCI-Field-1-2 or pdsch-HARQ-ACK-EnhType3DCI-Field */
    Null_Type                           None,                      /* No enhanced Type 3 codebook indicator  */
    bitstring                           Value                      /* According to TS 38.213 clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2) 7.3.1.2.4 (Format 1_3) */
  };
  
  type union NR_DciFormat_1_X_HarqAckRetransmissionIndicator_Type { /* TS 38.212  clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2) 7.3.1.2.4 (Format 1_3): HARQ-ACK retransmission indicator */
    Null_Type                           None,                       /* No HARQ-ACK retransmission indicator   */
    B1_Type                             Value                       /* 1 bit if higher layer parameter pdsch-HARQ-ACK-Retx or pdsch-HARQ-ACK-retxDCI-1-2/pucch-sSCellDynDCI-1-3 is configured. */
  };
  
  type union NR_DciFormat_1_X_PucchCellIndicator_Type { /* TS 38.212 clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2) 7.3.1.2.4 (Format 1_3): PUCCH Cell indicator depending on pucch-sSCellDyn */
    Null_Type                           None,                       /* No PUCCH Cell indicator */
    B1_Type                             Value                       /* 1 bit if higher layer parameter pucch-sSCellDyn/pucch-sSCellDynDCI-1-3 is configured */
  };

  type union NR_DciFormat_1_X_TCI_Selection_Type {                  /* TS 38.212 clause 7.3.1.2.2 (Format 1_1) 7.3.1.2.3 (Format 1_2): TCI selection  */
    Null_Type                           None,                       /* 0 bit if tciSelection-PresentInDCI is not configured */
    B2_Type                             Value                       /* otherwise 2 bits according to Table 7.3.1.2.2-11 */
  };
  
  type record NR_DciFormat_1_3_SpecificInfo_Type {          /* Comment TS 38.212 clause 7.3.1.2.4: scheduling of PDSCH in one cell or multiple PDSCHs in multiple cells with one PDSCH per cell
                                                             * Default parameters according to TS 38.508-1 clause 4.3.6.1.2.4.
                                                             * For all fields: 'omit' means that the information shall not be contained in the DCI on PDCCH
                                                             */
    NR_DciFormat_X_3_ScheduledCellList_Type               ScheduledCellList          optional, /* List of scheduled cells */
    NR_DciFormat_X_3_ScheduledCellSetIndicator_Type       ScheduledCellSetIndicator  optional, /* Scheduled cell set indicator */
    NR_DciFormat_X_3_ScheduledCellsIndicator_Type         ScheduledCellsIndicator    optional, /* Scheduled cells indicator */
    NR_DciCommon_BWPIndicator_Type                        BWPIndicator              optional, /* Bandwidth part indicator */
    NR_DciFormat_1_3_ResourceAssignmentTBList_Type        ResourceAssignmentTB1      optional, /* List of resource assignment for transport block 1 */
    NR_DciFormat_1_3_ResourceAssignmentTBList_Type        ResourceAssignmentTB2      optional, /* List of resource assignment for transport block 2 */
    NR_DciCommon_TimeDomainResourceAssignment_Type        TimeDomain              optional, /* Time domain resource assignment */
    NR_DciFormat_1_X_PrbBundlingSizeIndicator_Type        PrbBundlingSizeIndicator   optional, /* PRB bundling size indicator */
    NR_DciFormat_1_X_RateMatchingIndicator_Type           RateMatchingIndicator      optional, /* Rate matching indicator */
    NR_DciFormat_1_X_ZP_CSI_RS_Trigger_Type               ZP_CSI_RS_Trigger          optional, /* ZP CSI-RS trigger */
    NR_DciFormat_1_3_DAI_Type                             DAI                        optional, /* Downlink assignment index */
    NR_DciCommon_TpcCommand_Type                          TpcCommandPucch            optional, /* TPC command for scheduled PUCCH; to be set to 1 per default (0 dB; accumulated TPC) */
    NR_DciFormat_1_X_PucchResourceIndicator_Type          PucchResourceIndicator     optional, /* PUCCH resource indicator */
    NR_DciFormat_1_X_PdschHarqTimingIndicator_Type        PdschHarqTimingIndicator   optional, /* PDSCH-to-HARQ_feedback timing indicator */
    NR_DciFormat_1_X_OneShotHarqAckRequest_Type           OneShotHarqAckRequest      optional, /* One-shot HARQ-ACK request */
    NR_DciFormat_1_X_EnhancedType3CodebookIndicator_Type  EnhancedType3CodebookIndicator optional, /* Enhanced Type 3 codebook indicator */
    NR_DciFormat_1_X_HarqAckRetransmissionIndicator_Type  HarqAckRetransmissionIndicator optional, /* HARQ-ACK retransmission indicator */
    NR_DciFormat_X_3_AntennaPorts_Type                    AntennaPorts              optional, /* Antenna ports */
    NR_DciFormat_1_3_TCI_Type                             TCI                       optional, /* Transmission configuration indication */
    NR_DciFormat_X_3_SrsRequest_Type                      SrsRequest                 optional, /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type                  SrsOffsetIndicator         optional, /* SRS offset indicator */
    NR_DciCommon_DmrsSequenceInit_Type                    DmrsSequenceInit           optional, /* DMRS sequence initialization */
    NR_DciCommon_PriorityIndicator_Type                   PriorityIndicator          optional, /* Priority indicator */
    NR_DciFormat_1_X_ChannelAccessCPext_Type              ChannelAccessCPext         optional, /* ChannelAccess-CPext */
    NR_DciCommon_MinimumApplicableSchedulingOffset_Type   MinimumApplicableSchedulingOffset optional, /* Minimum applicable scheduling offset indicator */
    NR_DciCommon_SCellDormancyIndication_Type             SCellDormancyIndication    optional, /* SCell dormancy indication */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type PdcchMonitoringAdaptationIndication optional, /* PDCCH monitoring adaptation indication */
    NR_DciFormat_1_X_PucchCellIndicator_Type              PucchCellIndicator         optional  /* PUCCH Cell indicator */
  };

  type record of NR_DciFormat_1_3_ResourceAssignmentTB_Type  NR_DciFormat_1_3_ResourceAssignmentTBList_Type; /* List of resource assignment for block number x in ascending order. Depending on field scheduledCellComboListDCI-1-3 and scheduled cells indicated by scheduled cells indicator field */

  type record NR_DciFormat_1_3_ResourceAssignmentTB_Type {                              /* DL resource assignment for one block; to control setting of the following fields in DCI format 1_3 (TS 38.212 clause 7.3.1.2.4):
                                                                                           Frequency domain resource assignment
                                                                                           Modulation and coding scheme
                                                                                           New data indicator
                                                                                           Redundancy version
                                                                                           HARQ process number
                                                                                         */
    NR_ResourceAllocationType_Type                  ResourceAllocationType    optional, /* resource allocation type to be used for the frequency domain resource assignment */
    NR_FreqDomainResourceAssignmentDL_Type          FreqDomain                optional,
    NR_TransportBlockSchedulingDL_Type              TransportBlockScheduling  optional, /* information about MCS and RV for one or two transport blocks */
    NR_HarqProcessConfig_Type                       HarqProcessConfig         optional  /* configures which HARQ processes the SS may use;
                                                                                           corresponds to "HARQ process number" in TS 38.212 clause 7.3.1.2.4 */
  };

  type union NR_DciFormat_X_3_ScheduledCellSetIndicator_Type { /* TS 38.212 clause 7.3.1.1.4 (Format_0_3) 7.3.1.2.4 (Format_1_3) */
    bitstring                           Value                  /* 0, 1 or 2 bits set as according to MC-DCI-SetofCellsToAddModList */
  };

  type union NR_DciFormat_X_3_ScheduledCellsIndicator_Type { /* TS 38.212 clause 7.3.1.1.4 (Format_0_3) 7.3.1.2.4 (Format_1_3) */
    Null_Type                           None,                /* scheduledCellComboListDCI-0-3/scheduledCellComboListDCI-1-3 not configured */
    Null_Type                           Automatic,           /* For DCI 1_3 only when scheduledCellComboListDCI-1-3 is configured, SS automatically set the field according the MacBearerRouting fields in NR_DRB_COMMON_REQ.U_Plane.SlotDataListCoScheduling */
    bitstring                           Explicit             /* 0, 1 or 2 bits - explicit scheduled cells indicator */
  };

  type union NR_DciFormat_1_3_DAI_Type {        /* TS 38.212 clause 7.3.1.2.4 (Format_1_3) */
    Null_Type                           None,   /* 0 bits */
    DAI_B4_Type                         Index   /* 4 bits if the higher layer parameter pdsch-HARQ-ACK-Codebook=dynamic, where the 2 MSB bits are the counter DAI and the 2 LSB bits are the total DAI */
  };


  type union NR_DciFormat_1_3_TCI_Type {               /* TS 38.212 clause 7.3.1.2.4: Transmission configuration indication */
    Null_Type                           None,          /* tci-PresentInDCI is not present */
    bitstring                           Value          /* bitstring determined with tci-ListDCI-1-3 */
  };

  type union NR_DciFormat_X_3_AntennaPorts_Type {        /* TS 38.212 clause 7.3.1.1.4 (Format 0_3) 7.3.1.2.4 (Format 1_3)*/
    NR_DciFormat_0_X_AntennaPorts_Type           type1a, /* antennaPortsDCI0-3 or antennaPortsDCI-1-3 set to type1a */
    record of NR_DciFormat_0_X_AntennaPorts_Type type2   /* antennaPortsDCI0-3 or antennaPortsDCI-1-3 set to type2 */
  };

  type union NR_DciFormat_X_3_SrsRequest_Type {        /* TS 38.212 clause 7.3.1.1.4 (Format_0_3) 7.3.1.2.4 (Format_1_3): SRS Request  */
    Null_Type                           None,          /*  0 bit: no SRS Request */
    bitstring                           Value          /*  2 - 3 bits: bitstring depending on srs-RequestListDCI-0-3 or srs-RequestListDCI-0-3  */
  };
  
  } // End sub-sub-sub-sub-sub-sub-group PDSCH_Scheduling

  //----------------------------------------------------------------------------
  
  group PUSCH_Scheduling {
  
  type record NR_DciUlInfo_Type {                                                       /* scheduling for CCCH/DCCH/DTCH mapped to UL-SCH mapped to PUSCH;
                                                                                           for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards */
    NR_DciFormat_0_X_ResourceAssignment_Type    ResoureAssignment             optional, /* resource assignment; to control setting of the following fields in DCI formats 0_X (TS 38.212 clause 7.3.1.1.X):
                                                                                           Frequency domain resource assignment
                                                                                           Time domain resource assignment
                                                                                           Modulation and coding scheme
                                                                                           New data indicator
                                                                                           Redundancy version
                                                                                           HARQ process number
                                                                                           Not applicable for DCI format 0_3: omitted
                                                                                         */
    NR_DciFormat_0_X_PuschHoppingCtrl_Type      PuschHoppingCtrl              optional, /* control of frequency hopping in DCI formats (TS 38.212 Table 7.3.1.1.1-3) */
    NR_DciCommon_TpcCommand_Type                TpcCommandPusch               optional, /* TPC command for scheduled PUSCH; to be set to 1 per default (0 dB; accumulated TPC)
                                                                                           Not applicable for DCI format 0_3: omitted
                                                                                         */
    NR_DciCommon_UL_SUL_Indicator_Type          UL_SUL_Indicator              optional, /* to control use of supplementary UL by DCI */
    NR_DciFormat_0_X_SpecificInfo_Type          Format                        optional  /* DCI format and DCI format specific parameters */
  };
  
  type record NR_DciFormat_0_X_ResourceAssignment_Type {                                /* Common definition to be used for resource scheduling in UL */
    NR_ResourceAllocationType_Type                  ResourceAllocationType    optional, /* resource allocation type to be used for the frequency domain resource assignment */
    NR_FreqDomainSchedulExplicit_Type               FreqDomain                optional, /* explicit resource assignment: first RB, number of RBs;
                                                                                           corresponds to "Frequency domain resource assignment" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2 */
    NR_DciCommon_TimeDomainResourceAssignment_Type  TimeDomain                optional, /* corresponds to "Time domain resource assignment" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2 */
    NR_TransportBlockRetransmissionList_Type        TransportBlockScheduling  optional, /* information about MCS and RV for transport block 1 transmission and possible re-transmissions;
                                                                                           corresponds to "Modulation and coding scheme", "New data indicator" and "Redundancy version" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2 */
    NR_HarqProcessConfig_Type                       HarqProcessConfig         optional  /* HARQ process to be used for the scheduled UL data transfer
                                                                                           corresponds to "HARQ process number" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2;
                                                                                           NOTE: for 5G there is no synchronous HARQ anymore but HARQ is asynchronous even for UL
                                                                                           (TS 38.300 clause 5.3.5.4; TS 38.212 clause 7.3.1: 4-bit HARQ process number included in all DCI Formats for UL) */
  };

  type union NR_DciFormat_0_X_SpecificInfo_Type {
    NR_DciFormat_0_0_SpecificInfo_Type  Format_0_0,
    NR_DciFormat_0_1_SpecificInfo_Type  Format_0_1,
    NR_DciFormat_0_2_SpecificInfo_Type  Format_0_2,
    NR_DciFormat_0_3_SpecificInfo_Type  Format_0_3
  };

  type record NR_DciFormat_0_0_SpecificInfo_Type {
   /* TS 38.212 clause 7.3.1.1: scheduling of PUSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.1.1 */
    NR_DciFormat_X_0_ChannelAccessCPext_Type        ChannelAccessCPext        optional  /* ChannelAccess-CPext */
  };

  type record NR_DciFormat_0_1_SpecificInfo_Type {                                       /* TS 38.212 clause 7.3.1.2: scheduling of PUSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.1.2;
                                                                                            for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards */
    NR_DciCommon_CarrierIndicator_Type                      CarrierIndicator        optional,   /* Carrier indicator - CIF value for Cross Carrier Scheduling; 'None' otherwise */
    NR_DciFormat_0_1_DfiFlag_Type                           DfiFlag                 optional,   /* DFI flag */
    NR_DciCommon_BWPIndicator_Type                          BWPIndicator            optional,   /* Bandwidth part indicator */
    NR_DciFormat_0_1_TransportBlock2RetransmissionList_Type TransportBlock2Scheduling           optional,   /* Transport block 2 */
    NR_DciFormat_0_X_TransformPrecoderIndicator_Type        TransformPrecoderIndicator          optional,   /* Transform precoder indicator */
    NR_DciFormat_0_X_FirstDAI_Type                          FirstDAI                optional,   /* 1st downlink assignment index */
    NR_DciFormat_0_X_SecondDAI_Type                         SecondDAI               optional,   /* 2nd downlink assignment index */
    NR_DciFormat_0_X_ThirdDAI_Type                          ThirdDAI                optional,   /* 3rd downlink assignment index */
    NR_DciCommon_SecondTpcCommand_Type                      SecondTpcCommandPusch   optional,   /* Second TPC command for scheduled PUSCH */
    NR_DciFormat_0_X_SrsResourceSetIndicator_Type           SrsResourceSetIndicator optional,   /* SRS resource set indicator */
    NR_DciFormat_0_X_SrsResourceIndicator_Type              SrsResourceIndicator    optional,   /* SRS resource indicator */
    NR_DciFormat_0_X_SecondSrsResourceIndicator_Type        SecondSrsResourceIndicator optional,/* Second SRS resource indicator */
    NR_DciFormat_0_X_PrecodingInfo_Type                     PrecodingInfo           optional,   /* Precoding information and number of layers */
    NR_DciFormat_0_X_SecondPrecodingInfo_Type               SecondPrecodingInfo     optional,   /* Second Precoding information  */
    NR_DciFormat_0_X_AntennaPorts_Type                      AntennaPorts            optional,   /* Antenna ports */
    NR_DciFormat_X_1_SrsRequest_Type                        SrsRequest              optional,   /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type                    SrsOffsetIndicator      optional,   /* SRS offset indicator */
    NR_DciFormat_0_X_CsiRequest_Type                        CsiRequest              optional,   /* CSI request */
    NR_DciFormat_0_1_CBGTI_Type                             CBGTI                   optional,   /* CBG transmission information (CBGTI) */
    NR_DciFormat_0_X_PtrsDmrsAssociation_Type               PtrsDmrsAssociation     optional,   /* PTRS-DMRS association */
    NR_DciFormat_0_X_SecondPtrsDmrsAssociation_Type         SecondPtrsDmrsAssociation optional, /* Second PTRS-DMRS association  */
    NR_DciFormat_0_X_BetaOffsetIndicator_Type               BetaOffsetIndicator     optional,   /* beta_offset indicator */
    NR_DciCommon_DmrsSequenceInit_Type                      DmrsSequenceInit        optional,   /* DMRS sequence initialization */
    NR_DciFormat_0_X_UlschIndicator_Type                    UlschIndicator          optional,   /* UL-SCH indicator */
    NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type            ChannelAccessCPextCAPC  optional,   /* ChannelAccess-CPext-CAPC */
    NR_DciFormat_0_X_OpenLoopPowerControl_Type              OpenLoopPowerControl    optional,   /* Open-loop power control parameter set indication */
    NR_DciCommon_PriorityIndicator_Type                     PriorityIndicator       optional,   /* Priority indicator */
    NR_DciFormat_0_X_InvalidSymbolPatternIndicator_Type     InvalidSymbolPatternIndicator optional,         /* Invalid symbol pattern indicator */
    NR_DciCommon_MinimumApplicableSchedulingOffset_Type     MinimumApplicableSchedulingOffset optional,     /* Minimum applicable scheduling offset indicator */
    NR_DciCommon_SCellDormancyIndication_Type               SCellDormancyIndication optional,   /* SCell dormancy indication */
    NR_DciFormat_0_1_SidelinkAssignmentIndex_Type           SidelinkAssignmentIndex optional,   /* Sidelink assignment index */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type   PdcchMonitoringAdaptationIndication optional    /* PDCCH monitoring adaptation indication */
  };

  type record NR_DciFormat_0_2_SpecificInfo_Type {                                      /* TS 38.212 clause 7.3.1.1.3: scheduling of PUSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.1.3;
                                                                                           for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards */
    NR_DciFormat_X_2_CarrierIndicator_Type                  CarrierIndicator        optional,   /* Carrier indicator - CIF value for Cross Carrier Scheduling; 'None' otherwise */
    NR_DciCommon_BWPIndicator_Type                          BWPIndicator            optional,   /* Bandwidth part indicator */
    NR_DciFormat_0_X_TransformPrecoderIndicator_Type        TransformPrecoderIndicator optional,/* Transform precoder indicator */
    NR_DciFormat_0_X_FirstDAI_Type                          FirstDAI                optional,   /* 1st downlink assignment index */
    NR_DciFormat_0_X_SecondDAI_Type                         SecondDAI               optional,   /* 2nd downlink assignment index */
    NR_DciFormat_0_X_ThirdDAI_Type                          ThirdDAI                optional,   /* 3rd downlink assignment index */
    NR_DciCommon_SecondTpcCommand_Type                      SecondTpcCommandPusch   optional,   /* Second TPC command for scheduled PUSCH */
    NR_DciFormat_0_X_SrsResourceSetIndicator_Type           SrsResourceSetIndicator optional,   /* SRS resource set indicator */
    NR_DciFormat_0_X_SrsResourceIndicator_Type              SrsResourceIndicator    optional,   /* SRS resource indicator */
    NR_DciFormat_0_X_SecondSrsResourceIndicator_Type        SecondSrsResourceIndicator optional,/* Second SRS resource indicator */
    NR_DciFormat_0_X_PrecodingInfo_Type                     PrecodingInfo           optional,   /* Precoding information and number of layers */
    NR_DciFormat_0_X_SecondPrecodingInfo_Type               SecondPrecodingInfo     optional,   /* Second Precoding information  */
    NR_DciFormat_0_X_AntennaPorts_Type                      AntennaPorts            optional,   /* Antenna ports */
    NR_DciFormat_X_2_SrsRequest_Type                        SrsRequest              optional,   /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type                    SrsOffsetIndicator      optional,   /* SRS offset indicator */
    NR_DciFormat_0_X_CsiRequest_Type                        CsiRequest              optional,   /* CSI request */
    NR_DciFormat_0_X_PtrsDmrsAssociation_Type               PtrsDmrsAssociation     optional,   /* PTRS-DMRS association */
    NR_DciFormat_0_X_SecondPtrsDmrsAssociation_Type         SecondPtrsDmrsAssociation optional, /* Second PTRS-DMRS association  */
    NR_DciFormat_0_X_BetaOffsetIndicator_Type               BetaOffsetIndicator     optional,   /* beta_offset indicator */
    NR_DciCommon_DmrsSequenceInit_Type                      DmrsSequenceInit        optional,   /* DMRS sequence initialization */
    NR_DciFormat_0_X_UlschIndicator_Type                    UlschIndicator          optional,   /* UL-SCH indicator */
    NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type            ChannelAccessCPextCAPC  optional,   /* ChannelAccess-CPext-CAPC */
    NR_DciFormat_0_X_OpenLoopPowerControl_Type              OpenLoopPowerControl    optional,   /* Open-loop power control parameter set indication */
    NR_DciCommon_PriorityIndicator_Type                     PriorityIndicator       optional,   /* Priority indicator */
    NR_DciFormat_0_X_InvalidSymbolPatternIndicator_Type     InvalidSymbolPatternIndicator       optional,   /* Invalid symbol pattern indicator */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type   PdcchMonitoringAdaptationIndication optional    /* PDCCH monitoring adaptation indication */
  };

  type union NR_DciFormat_0_X_PuschHoppingCtrl_Type {                   /* TS 38.212 7.3.1.1.1 (format 0_0), 7.3.1.1.2 (format 0_1) and 7.3.1.1.4 (format 0_3) */
    Null_Type                           None,                           /* DCI format 0_1: 0 bit if only resource allocation type 0 is configured or PUSCH-Config.frequencyHopping is not configured
                                                                           DCI format 0_3: 0 bit if frequencyHopping is not configured for any cell configured by higher layer parameter scheduledCellListDCI-0-3 in the scheduled cell set
                                                                         */
    B1_Type                             Flag                            /* 1 bit if resource allocation type 1 is configured (or type 0 and type 1)
                                                                           '1'B to indicate frequency hopping according to TS 38.214 clause 6.3 */
  };

  type union NR_DciFormat_0_X_FirstDAI_Type {                           /* TS 38.212 clause 7.3.1.1.X: First DAI (downlink assignment indicator) depending on PhysicalCellGroupConfig.pdsch-HARQ-ACK-Codebook */
    DAI_B1_Type                             SemiStaticCodebook,         /* 1 bit according to TS 38.213 clause 9.1.2.2 for Type-1 HARQ-ACK (pdsch-HARQ-ACK-codebook=semi-static) */
    DAI_B2_Type                             DynamicCodebook,            /* 2 bits according to TS 38.213 Table 9.1.3-2 for Type-2 HARQ-ACK (pdsch-HARQ-ACK-codebook=dynamic or for enhanced dynamic HARQ-ACK codebook without UL-TotalDAI-Included configured) */
    DAI_B4_Type                             EnhancedDynamicCodebook     /* Not applicable for DCI 0_2 and DCI 0_3 - 4 bits for enhanced dynamic HARQ-ACK codebook and with UL-TotalDAI-Included = true. */
  };

  type union NR_DciFormat_0_X_SecondDAI_Type {                          /* TS 38.212 clause 7.3.1.1.X: Second DAI (downlink assignment indicator) depending on PhysicalCellGroupConfig.pdsch-HARQ-ACK-Codebook  */
    Null_Type                           None,                           /* no 2nd DAI */
    DAI_B2_Type                         DynamicCodebook,                /* 2 bits according to TS 38.213 Table 9.1.3-2 for Type-2 HARQ-ACK (pdsch-HARQ-ACK-codebook=dynamic or for enhanced dynamic HARQ-ACK codebook with two HARQ-ACK sub-codebooks and without UL-TotalDAI-Included configured) */
    DAI_B4_Type                         EnhancedDynamicCodebook         /* Not applicable for DCI 0_2 and DCI 0_3 - 4 bits for enhanced dynamic HARQ-ACK codebook with two HARQ-ACK sub-codebooks and with UL-TotalDAI-Included = true */
  };
    
  type union NR_DciFormat_0_X_SrsResourceIndicator_Type {               /* TS 38.212 clause 7.3.1.1.X: SRS resource indicator depending on PUSCH-Config.txConfig */
    bitstring                           NonCodeBook,                    /* txConfig==NonCodeBook: bitstring of 0..3 bits according to TS 38.212 Tables 7.3.1.1.2-28/29/30/31
                                                                           (according to TS 38.331 clause 6.3.2 "SRS-Config" there are at most 4 entries with usage==nonCodebook) */
    bitstring                           CodeBook                        /* txConfig==CodeBook:
                                                                           - bitstring of 0 or 1 bits according to TS 38.212 Table 7.3.1.1.2-32
                                                                           - bitstring of 4 bits according to TS 38.212 Table 7.3.1.1.2-32A/32B if ul-FullPowerTransmission is configured
                                                                           (according to TS 38.331 clause 6.3.2 "SRS-Config" there are at most 2 entries with usage==codebook) */
  };
  
  type union NR_DciFormat_0_X_PrecodingInfo_Type {                      /* TS 38.212 clause 7.3.1.1.X: Precoding information and number of layers depending on PUSCH-Config.txConfig */
    Null_Type                           NonCodeBook,                    /* txConfig==NonCodeBook: 0 bits */
    bitstring                           CodeBook                        /* txConfig==CodeBook: bitstring according to TS 38.212 Tables 7.3.1.1.2-2..5A; empty string for one antenna port only */
  };
  
  type union NR_DciFormat_0_X_AntennaPorts_Type {                       /* TS 38.212 clause 7.3.1.1.X: Antenna ports depending (mainly) on
                                                                           - PUSCH-Config.transformPrecoder,
                                                                           - DMRS-UplinkConfig.dmrs-Type,
                                                                           - DMRS-UplinkConfig.maxLength,
                                                                           - dmrs-UplinkTransformPrecoding,
                                                                           - tp-pi2BPSK
                                                                         */
    bitstring                           Index,                          /* bitstring presentation of index to Tables 7.3.1.1.2-6..69 */
    Null_Type                           None                            /* antennaPortsFieldPresenceDCI-0-2 is not present
                                                                           Not applicable for DCI format 0_1
                                                                         */
  };

  type union NR_DciFormat_0_X_CsiRequest_Type {                         /* TS 38.212 clause 7.3.1.1.X: CSI request */
    bitstring                           Index                           /* 0, 1, 2, 3, 4, 5, or 6 bits determined by CSI-MeasConfig.reportTriggerSize/CSI-MeasConfig.reportTriggerSizeDCI-0-2; TS 38.214 clause 5.2.1.5.1) */
  };

  type union NR_DciFormat_0_1_CBGTI_Type {                              /* TS 38.212 clause 7.3.1.1.2: CBG transmission information (CBGTI) */
    bitstring                           Index                           /* 0, 2, 4, 6, or 8 bits determined by PUSCH-CodeBlockGroupTransmission.maxCodeBlockGroupsPerTransportBlock configured by PUSCH-ServingCellConfig */
  };

  type union NR_DciFormat_0_X_PtrsDmrsAssociation_Type {                /* TS 38.212 clause 7.3.1.1.X: PTRS-DMRS association */
    Null_Type                           None,                           /* 0 bit PTRS-UplinkConfig is not configured in either dmrs-UplinkForPUSCH-MappingTypeA or dmrs-UplinkForPUSCH-MappingTypeB and transform precoder is disabled, or if transform precoder is enabled, or if maxRank=1 */
    B2_Type                             Value,                          /* 2 bits according to TS 38.212 Table 7.3.1.1.2-25/7.3.1.1.2-25A and 7.3.1.1.2-26 */
    B4_Type                             Value4bits                      /* 4 bits - when two PTRS ports are configured by maxNrofPorts in PTRS-UplinkConfig according to TS 38.212 Table 7.3.1.1.2-26A */
  };

  type union NR_DciFormat_0_X_BetaOffsetIndicator_Type {                /* TS 38.212 clause 7.3.1.1.X: beta_offset indicator */
    Null_Type                           None,                           /* 0 bit if uci-on-PUSCH != dynamic (ConfiguredGrantConfig.uci-OnPUSCH or PUSCH-ConfigDCI-0-3-r18.uci-OnPUSCH-ListDCI-0-3) */
    B2_Type                             Value                           /* 2 bits according to TS 38.213 Table 9.3-3 and Table 9.3-3A*/
  };

  type union NR_DciFormat_0_X_UlschIndicator_Type {                     /* TS 38.212 clause 7.3.1.1.X: UL-SCH indicator */
    Null_Type                           None,                           /* 0 bit if the number of scheduled PUSCH indicated by the Time domain resource assignment field is larger than 1
                                                                             Not applicable for DCI format 0_2
                                                                         */
    B1_Type                             Value                           /* 1 bit: "1" indicates UL-SCH shall be transmitted on the PUSCH, "0" indicates UL-SCH shall not be transmitted on the PUSCH. Except for DCI format 0_1 with CRC scrambled by SP-CSI-RNTI, a UE is not expected to receive a DCI format 0_1 with UL-SCH indicator of "0" and CSI request of all zero(s). The UE is not expected to receive a DCI format 0_1 with UL-SCH indicator of "0", when the indicated number of layers is larger than 4. */
  };
  
  type union NR_DciFormat_0_1_DfiFlag_Type {                            /* TS 38.212 clause 7.3.1.1.2: DFI flag indicator */
    Null_Type                           None,                           /* 0 bit no DFI flag indicator */
    B1_Type                             Flag                            /* 1 bit: if the UE is configured to monitor DCI format 0_X with CRC scrambled by CS-RNTI and for operation in a cell with shared spectrum channel access. */
  };
  
  type union NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type {             /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2) clause 7.3.1.1.4 (Format 0_3): ChannelAccess-CPext-CAPC */
    Null_Type                           None,                           /* 0 bit: no ChannelAccess-CPext-CAPC */
    bitstring                           Value                           /* 1, 2, 3, 4, 5 or 6 bits.
                                                                           One or more entries from Table 7.3.1.1.2-35 or Table 7.3.1.1.2-35A are configured by the higher layer parameter ul-AccessConfigListDCI-0-X. */
  };
  
  type union NR_DciFormat_0_X_OpenLoopPowerControl_Type {             /* TS 38.212 clause 7.3.1.1.X: Open-loop power control parameter set indication   */
    Null_Type                           None,                         /* 0 bit no Open-loop power control parameter set indication */
    bitstring                           Value                         /* 1 or 2 bits
                                                                         -  1 bit if SRS resource indicator is present in the DCI format 0_X;
                                                                         -  1 or 2 bits as determined by higher layer parameter olpc-ParameterSetDCI-0-X if SRS resource indicator is not present in the DCI format 0_X
                                                                       */
  };
  
  type union NR_DciFormat_0_X_InvalidSymbolPatternIndicator_Type { /* TS 38.212 clause 7.3.1.1.X:  Invalid symbol pattern indicator */
    Null_Type                           None,                      /* 0 bit no Invalid symbol pattern indicator  */
    B1_Type                             Value                      /* 1 bit as defined in Clause 6.1.2.1 in TS 38.214   */
  };
  
  type union NR_DciFormat_0_1_SidelinkAssignmentIndex_Type  {      /* TS 38.212 clause 7.3.1.1.2:  Sidelink assignment index */
    Null_Type                           None,                      /* 0 bit no Sidelink assignment index */
    DAI_B1_Type                         SemiStaticCodebook,        /* 1 bit according to TS 38.213 clause 16.5.1 for Type-1 HARQ-ACK (pdsch-HARQ-ACK-codebook=semi-static) and SS configured with NR_CellConfigInfo_Type.SidelinkScheduled */
    DAI_B2_Type                         DynamicCodebook            /* 2 bits according to TS 38.213 clause 16.5.2 for Type-2 HARQ-ACK (pdsch-HARQ-ACK-codebook=dynamic) and SS configured with NR_CellConfigInfo_Type.SidelinkScheduled */
  };
  
  type union NR_DciFormat_0_X_ThirdDAI_Type {                      /* TS 38.212 clause 7.3.1.1.X: Third DAI (downlink assignment indicator) depending on PhysicalCellGroupConfig.pdsch-HARQ-ACK-Codebook */
    Null_Type                           None,                      /* no 3rd DAI */
    DAI_B1_Type                         SemiStaticCodebook,        /* 1 bit for semi-static HARQ-ACK codebook for multicast if the higher layer parameter fdmed-ReceptionMulticast is configured*/
    DAI_B2_Type                         DynamicCodebook            /* 2 bits for the dynamic HARQ-ACK codebook for multicast */
  };

  type union NR_DciFormat_0_X_SrsResourceSetIndicator_Type {      /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2): SRS resource set indicator depending on PUSCH-Config.txConfig and two SRS resource sets */
    Null_Type                           None,                     /* No SRS resource set indicator */
    B2_Type                             TwoSrsResourceSet         /* 2 bits according to Table 7.3.1.1.2-36 if
                                                                     - txConfig==nonCodeBook, and there are two SRS resource sets configured by srs-ResourceSetToAddModList and associated with the usage of value 'nonCodeBook', or
                                                                     - txConfig==codebook, and there are two SRS resource sets configured by srs-ResourceSetToAddModList and associated with usage of value 'codebook';
                                                                   */
  };

  type union NR_DciFormat_0_X_SecondSrsResourceIndicator_Type {         /* TS 38.212 clause 7.3.1.1.X: Second SRS resource indicator depending on PUSCH-Config.txConfig and SRS resource set indicator field is present */
    Null_Type                           None,
    bitstring                           NonCodeBook,                    /* txConfig==nonCodebook and SRS resource set indicator field is present: according to TS 38.212 Tables 7.3.1.1.2-28/29/30/31 */
    bitstring                           CodeBook                        /* txConfig==codebook and SRS resource set indicator field is present: according to Tables 7.3.1.1.2-32, 7.3.1.1.2-32A and 7.3.1.1.2-32B */
  };
  

  type union NR_DciFormat_0_X_SecondPrecodingInfo_Type {                /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2): Second Precoding information: depending on PUSCH-Config.txConfig and SRS resource set indicator is present */
    Null_Type                           None,                           /* No Second Second Precoding information */
    Null_Type                           NonCodeBook,                    /* txConfig==nonCodebook and SRS resource set indicator field is present: 0 bits */
    bitstring                           Codebook                        /* txConfig==CodeBook: bitstring according to TS 38.212 Tables 7.3.1.1.2-2C..5A; empty string for one antenna port only */
  };

  type union NR_DciFormat_0_X_SecondPtrsDmrsAssociation_Type {          /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2): Second PTRS-DMRS association */
    Null_Type                           None,                           /* 0 bit - No Second PTRS-DMRS association */
    B2_Type                             Value                           /* 2 bits if PTRS-DMRS association field and SRS resource set indicator field are present and maxRank>2 and multipanelScheme is not configured. According to TS 38.212 Table 7.3.1.1.2-25 and 7.3.1.1.2-26. */
  };

  type union NR_DciFormat_0_1_TransportBlock2RetransmissionList_Type {  /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) for transport block 2 */
    Null_Type                                               None,       /* No transport block 2 */
    NR_TransportBlockRetransmissionList_Type                Value       /* Information about MCS and RV for transport block 2 transmission and possible re-transmissions;
                                                                           corresponds to "Modulation and coding scheme", "New data indicator" and "Redundancy version" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2
                                                                           present if maxRank or maxMIMO-Layers is larger than 4
                                                                         */
  };
  
  type union NR_DciFormat_0_X_TransformPrecoderIndicator_Type {         /* TS 38.212 clause 7.3.1.1.2 (Format 0_1) clause 7.3.1.1.3 (Format 0_2) Transform precoder indicator - 0 or 1 bit */
    Null_Type                            None,                          /* 0 bit */
    B1_Type                              Value                          /* 1 bit */
  };
  
    type record NR_DciFormat_0_3_SpecificInfo_Type {                      /* TS 38.212 clause 7.3.1.1.4: scheduling of one PUSCH in one cell, or multiple PUSCHs in multiple cells with one PUSCH per cell
                                                                           default parameters according to TS 38.508-1 clause 4.3.6.1.1.4;
                                                                           for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards */
    NR_DciFormat_X_3_ScheduledCellList_Type               ScheduledCellList          optional,  /* List of scheduled cells */
    NR_DciFormat_X_3_ScheduledCellSetIndicator_Type       ScheduledCellSetIndicator  optional,  /* Scheduled cell set indicator */
    NR_DciFormat_X_3_ScheduledCellsIndicator_Type         ScheduledCellsIndicator    optional,  /* Scheduled cells indicator */
    NR_DciCommon_BWPIndicator_Type                        BWPIndicator               optional,  /* Bandwidth part indicator */
    NR_DciFormat_0_3_ResourceAssignmentList_Type          ResourcesAllocationType    optional,  /* Frequency resource allocation for all blocks */
    NR_DciCommon_TimeDomainResourceAssignment_Type        TimeDomain                 optional,  /* Time domain resource assignment */
    NR_DciFormat_0_X_FirstDAI_Type                        FirstDAI                   optional,  /* 1st downlink assignment index */
    NR_DciFormat_0_X_SecondDAI_Type                       SecondDAI                  optional,  /* 2nd downlink assignment index */
    NR_DciCommon_TpcCommandList_Type                      TpcCommandPusch            optional,  /* TPC command for scheduled PUSCH */
    NR_DciFormat_0_3_SrsResourceIndicator_Type            SrsResourceIndicator       optional,  /* SRS resource indicator */
    NR_DciFormat_0_3_PrecodingInfo_Type                   PrecodingInfo              optional,  /* Precoding information and number of layers */
    NR_DciFormat_X_3_AntennaPorts_Type                    AntennaPorts               optional,  /* Antenna ports */
    NR_DciFormat_X_3_SrsRequest_Type                      SrsRequest                 optional,  /* SRS request */
    NR_DciCommon_SrsOffsetIndicator_Type                  SrsOffsetIndicator         optional,  /* SRS offset indicator */
    NR_DciFormat_0_X_CsiRequest_Type                      CsiRequest                 optional,  /* CSI request */
    NR_DciFormat_0_3_PtrsDmrsAssociation_Type             PtrsDmrsAssociation        optional,  /* PTRS-DMRS association */
    NR_DciFormat_0_X_BetaOffsetIndicator_Type             BetaOffsetIndicator        optional,  /* Beta_offset indicator */
    NR_DciCommon_DmrsSequenceInit_Type                    DmrsSequenceInit           optional,  /* DMRS sequence initialization */
    NR_DciFormat_0_X_UlschIndicator_Type                  UlschIndicator             optional,  /* UL-SCH indicator */
    NR_DciFormat_0_X_ChannelAccessCPextCAPC_Type          ChannelAccessCPextCAPC     optional,  /* ChannelAccess-CPext-CAPC */
    NR_DciFormat_0_X_OpenLoopPowerControl_Type            OpenLoopPowerControl       optional,  /* Open-loop power control parameter set indication */
    NR_DciCommon_PriorityIndicator_Type                   PriorityIndicator          optional,  /* Priority indicator */
    NR_DciCommon_MinimumApplicableSchedulingOffset_Type   MinimumApplicableSchedulingOffset   optional, /* Minimum applicable scheduling offset indicator */
    NR_DciCommon_SCellDormancyIndication_Type             SCellDormancyIndication    optional,  /* SCell dormancy indication */
    NR_DciCommon_PdcchMonitoringAdaptationIndication_Type PdcchMonitoringAdaptationIndication optional  /* PDCCH monitoring adaptation indication */
  };

  type union NR_DciFormat_X_3_ScheduledCellList_Type {
     Null_Type                     Automatic,    /* Used only for DL DCI format 1_3: the scheduled cells are indicated by MacBearerRouting fields in NR_DRB_COMMON_REQ.U_Plane.SlotDataListCoScheduling */
     NR_CellIdList_Type            Explicit      /* List of cells scheduled by the DCI format X_3: indicates to SS which block number is scheduled */
  };

  type union NR_DciFormat_0_3_SrsResourceIndicator_Type {          /* TS 38.212 clause 7.3.1.1.4: SRS resource indicator depending on PUSCH-Config.txConfig and sri-DCI0-3 */
    NR_DciFormat_0_X_SrsResourceIndicator_Type            Type1a,  /* sri-DCI0-3 = type1a */
    record of NR_DciFormat_0_X_SrsResourceIndicator_Type  Type2    /* sri-DCI0-3 = type2 */
  };

  type union NR_DciFormat_0_3_PrecodingInfo_Type {             /* TS 38.212 clause 7.3.1.1.4: SRS resource indicator depending on PUSCH-Config.txConfig and tpmi-DCI0-3 */
    NR_DciFormat_0_X_PrecodingInfo_Type              Type1a,   /* tpmi-DCI0-3 = type1a */
    record of NR_DciFormat_0_X_PrecodingInfo_Type    Type2     /* tpmi-DCI0-3 = type2 */
  };

  type record of NR_DciFormat_0_X_PtrsDmrsAssociation_Type NR_DciFormat_0_3_PtrsDmrsAssociation_Type;

  type record of NR_DciFormat_0_3_ResourceAssignment_Type NR_DciFormat_0_3_ResourceAssignmentList_Type; /* List of Resource assignment for block number x in ascending number. Depending on field scheduledCellComboListDCI-0-3 and scheduled cells indicated by Scheduled cells indicator field */

  type record NR_DciFormat_0_3_ResourceAssignment_Type {                                /* resource scheduling in UL for one block */
    NR_ResourceAllocationType_Type                  ResourceAllocationType    optional, /* resource allocation type to be used for the frequency domain resource assignment */
    NR_FreqDomainSchedulExplicit_Type               FreqDomain                optional, /* explicit resource assignment: first RB, number of RBs;
                                                                                           corresponds to "Frequency domain resource assignment" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2 */
    NR_TransportBlockRetransmissionList_Type        TransportBlockScheduling  optional, /* information about MCS and RV for transport block 1 transmission and possible re-transmissions;
                                                                                           corresponds to "Modulation and coding scheme", "New data indicator" and "Redundancy version" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2 */
    NR_HarqProcessConfig_Type                       HarqProcessConfig         optional  /* HARQ process to be used for the scheduled UL data transfer
                                                                                           corresponds to "HARQ process number" in TS 38.212 clause 7.3.1.1.1 and 7.3.1.1.2;
                                                                                           NOTE: for 5G there is no synchronous HARQ anymore but HARQ is asynchronous even for UL
                                                                                           (TS 38.300 clause 5.3.5.4; TS 38.212 clause 7.3.1: 4-bit HARQ process number included in all DCI Formats for UL) */
  };
  
  } // End sub-sub-sub-sub-sub-sub-group PUSCH_Scheduling
  } // End sub-sub-sub-sub-sub-group DCI_Configuration
  } // End sub-group PhysicalLayer
  
  //============================================================================

  group MAC_Layer {
  /* Configuration for MAC procedures according to TS 38.321 clause 5 and related physical layer configuration */
  
  group MAC_Layer_Common {
  type integer NR_TimingAdvanceIndex_Type (0..63);                      /* acc. to TS 38.321, clause 6.1.3.4 "Timing Advance Command MAC CE" and TS 38.213 clause 4.2 "Transmission timing adjustments" */
  type integer NR_TimingAdvance_Period_Type (400, 600, 1020, 1530, 2040, 4090, 8190);           /* the values correspond to 80 % of TimeAlignmentTimer (acc. to TS 38.523-3, clause 6.3.2):
                                                                                                   ms500, ms750, ms1280, ms1920, ms2560, ms5120, ms10240 rounded to nearest multiple of 10 */
  
  type record NR_UplinkTimeAlignment_AutoSynch_Type {                   /* Parameters for automatic synchronisation of UL time alignment;
                                                                           The SS shall periodically transmit TA MAC control elements on the configured cell according to TS 38.321 clause 6.1.3.4 using
                                                                           - the same DL SearchSpaceAndDci as configured for DL DcchDtch
                                                                           - TAG-Id=0 for the SpCell
                                                                           - TAG-Id as configured for an SCell
                                                                          the transmission shall be continuously until being stopped.
                                                                         */
    NR_TimingAdvanceIndex_Type          TimingAdvance,                  /* amount of timing adjustment that MAC entity has to apply */
    NR_TimingAdvance_Period_Type        TA_Period                       /* time period after which TA MAC control elements need to be automatically transmitted */
  };

  type union NR_UplinkTimeAlignment_Synch_Type {                        /* Configuration of Time Alignment of the UL */
    Null_Type                                   None,                   /* no PUCCH Synchronisation applied */
    NR_UplinkTimeAlignment_AutoSynch_Type       Auto                    /* SS automatically maintains PUCCH synchronization at UE */
  };

  } // End sub-sub-group MAC_Layer_Common
  
  //----------------------------------------------------------------------------
  
  group Random_Access_Procedure {

  type record NR_RachProcedureConfig_Type {                             /* parameters to control the random access procedure; TS 38.321, clause 5.1. When SUL is configured, SS shall monitor UE RACH transmissions on both uplink and supplementary uplink carriers.
                                                                           NOTE:     RACH-ConfigCommon and RACH-ConfigDedicated are contained in NR_UplinkBWP_Type already (RACH-ConfigCommon as part of BWP-UplinkCommon).
                                                                                     When supplementary uplink is configured, RACH-ConfigCommon and RACH-ConfigDedicated are contained in the fields Uplink and SupplementaryUplink.
                                                                         */
    NR_RachProcedureList_Type           RachProcedureList     optional  /* in normal cases there is one element which is used for any RA procedure */
  };


  type record of NR_RachProcedure_Type NR_RachProcedureList_Type;       /* to simulate RACH procedure with one or more than one attempt by the UE:
                                                                         * There is one element in the list per PRACH Preamble attempt */
  
  type record NR_RachProcedure_Type {                                   /* for a 2Step Rach only MsgB is present.
                                                                           MsgB + ContentionResolution  are present for 2step->4Step Rach fallback with Msg3 transmission by UE after MsgB.
                                                                           RandomAccessResponse  + ContentionResolution  are present for 4 Step RACH procedure.
                                                                           RandomAccessResponse + Msg3Retansmission + ContentionResolution are present for 4 Step RACH procedure with Msg3 retransmission.
                                                                        */
    NR_2StepMsgB_Config_Type            MsgB optional,                  /* configures how the SS shall react on a PRACH Preamble and MsgA attempt, in general:
                                                                            - a MAC subheader and fallbackRAR;
                                                                            - a MAC subheader and successRAR;
                                                                            - a MAC subheader and MAC SDU for CCCH or DCCH;
                                                                            - an Absolute Timing advance MCE;
                                                                            - BackoffIndicator
                                                                            - no response at all
                                                                         */
    NR_RandomAccessResponseConfig_Type  RandomAccessResponse  optional, /* configures how the SS shall react on a PRACH Preamble attempt, in general:
                                                                         * - RAR with RAPID matching the RAPID of the UE's PRACH Preamble
                                                                         * - RAR with RAPID not matching the RAPID of the UE's PRACH Preamble
                                                                         * - BackoffIndicator
                                                                         * - no response at all */
    
    NR_Msg3Retansmission_Type           Msg3Retansmission optional,     /* configures if SS transmits an UL TC-RNTI Grant for Msg3 retransmission */
    NR_ContentionResolutionCtrl_Type    ContentionResolution  optional  /* Random Access Procedure may be
                                                                         * 1. Contention free (Non-contention based) => no contention resolution
                                                                         * 2. Contention based (see TS 38.321 clause 5.1.5):
                                                                         * 2a) C-RNTI based:
                                                                         * Msg3 contains MAC C-RNTI control element and in general contention resolution is done by assignment of an UL grant for this C-RNTI
                                                                         * 2b) UE Contention Resolution Identity based:
                                                                         * Msg3 contains RRC message to setup or restore RRC connection
                                                                         * => contention resolution is done by sending of Msg4 with UE Contention Resolution Identity MAC CE */
  };

  //----------------------------------------------------------------------------
  
  group Random_Access_Response {

  type integer NR_RACH_TimingAdvance_Type (0..3846);                    /* 12 bit value corresponding to Timing Advance Command field of the Random Access Response (TS 38.321 clause 6.2.3): 0..3846 according to TS 38.213 clause 4.2) */

  type integer NR_RAR_BackoffIndicator_Type (0..15);                    /* MAC subPDU for Backoff Indicator only according to TS 38.321 clause 6.1.5 */

  type record NR_RAR_UplinkGrant_Type {                                 /* 27 bits according to TS 38.213 Table 8.2-1 and TS 38.321 Figure 6.2.3-1 */
    B1_Type     HoppingFlag,                                            /* Hopping flag */
    NR_RAR_Msg3FrequencyResourceAllocation_Type    Msg3FrequencyResourceAllocation,                        /* Msg3 PUSCH frequency resource allocation:
                                                                           RIV value as defined in TS 38.213 clause 8.2 and TS 38.214 clause 6.1.2.2.2 */
    B4_Type     Msg3TimeResourceAllocation,                             /* Msg3 PUSCH time resource allocation similar to the Time-domain resource assignment field of DCI format 0_0:
                                                                           index addressing an entry of the applicable PUSCH time domain resource allocation table as specified in TS 38.214 clause 6.1.2.1.1;
                                                                           the timing between the RAR and Msg3 is given by K2 (as in the time domain resource allocation table) and a delta value as according to Table 6.1.2.1.1-5 in TS 38.214.
                                                                           It is the responsibility of SS implementation to send the RAR in an appropriate DL slot so that the corresponding Msg3 transmission is scheduled for a valid UL slot; it is responsibility of test specification to provide a correct K2 value for the given numerology. */
    B4_Type     MCS,                                                    /* Modulation and Coding Scheme:
                                                                           If numberOfMsg3-RepetitionsList is not configured in the SS (NR_UplinkBWP_Type.R15.numberOfMsg3_RepetitionsList_r17) first sixteen indices of the applicable MCS index table for PUSCH (TS 38.214 Table 6.1.4.1-1),
                                                                           else the 2 LSBs of MCS determine the Imcs as per TS 38.214 Table 6.1.4.1-3; The 2 MSBs provide a codepoint to determine the number of repetitions K according to TS 38.214 Table 6.1.2.1-1A
                                                                          */
    B3_Type     TPC_Command,                                            /* TPC command for Msg3 PUSCH */
    B1_Type     CQI_Req,                                                /* CQI request */
    B2_Type     ChAccess_CPext                           optional       /* For operation without shared spectrum channel access: omit;
                                                                           for operation with shared spectrum channel access, set as defined in TS 38.212 Table 7.3.1.1.1-4 (dynamic mode) or Table 7.3.1.1.1-4A (semi-static mode) */
  };

  type union NR_RAR_Msg3FrequencyResourceAllocation_Type {              /* TS 38.213 Table 8.2-1 */
    B14_Type    Length14,                                               /* For operation without shared spectrum channel access */
    B12_Type    Length12                                                /* For operation with shared spectrum channel access */
  };

  type union NR_TempC_RNTI_Type {
    Null_Type                           SameAsC_RNTI,                   /* in the RA response SS shall use the same C-RNTI as configured in NR_CellConfigCommon_Type;
                                                                         * this is useful for initial random access */
    RNTI_Value_Type                     Explicit                        /* in the RA response SS shall use different value as configured in NR_CellConfigCommon_Type;
                                                                         * this can be used when the UE already is in RRC_CONNECTED to have a temporary C-RNTI different from the one used by the UE;
                                                                         * NOTE: when the UE is not in RRC_CONNECTED there shall be no explicit temp. C-RNTI since then the UE would assume this value as C-RNTI */
  };

  type record NR_RAR_Payload_Type {                                     /* MAC payload for Random Access Response according to TS 38.321 clause 6.2.3 */
    NR_RACH_TimingAdvance_Type          TimingAdvance,                  /* timing advance: TS 38.321 clause 6.2.3 and TS 38.213 clause 4.2
                                                                         * NOTE:
                                                                         * timing advance has impact not only on the RA procedure;
                                                                         * SS in general needs to adjust its timing accordingly */
    NR_RAR_UplinkGrant_Type             UplinkGrant,                    /* initial UL grant */
    NR_TempC_RNTI_Type                  TempC_RNTI                      /* NOTE:
                                                                         * In general for initial Random Access Procedure TempC_RNTI shall be 'SameAsC_RNTI'
                                                                         * For Random Access Procedure in RRC_CONNECTED state the NW assigns a temporary C-RNTI which is replaced by the one stored at the UE;
                                                                         * => TempC_RNTI may be 'SameAsC_RNTI' (in this case temp. C-RNTI and C-RNTI are equal what is not likely in a real network),
                                                                         * or there is an explicit temp. C-RNTI what is used during RA procedure only (as in a real network) */
  };

  type record NR_RAR_RapIdOnly_Type {                                   /* MAC subPDU for RAPID only (acknowledgment for SI request) according to TS 38.321 clause 6.1.5 */
    RAR_RapIdCtrl_Type                  RapId
  };

  type record NR_RAR_RapIdAndPayload_Type {                             /* MAC subPDU for RAPID and RAR payload according to TS 38.321 clause 6.1.5 */
    RAR_RapIdCtrl_Type                  RapId,
    NR_RAR_Payload_Type                 Payload
  };

  type union NR_RAR_SubPdu_Type {                                       /* Random Access Response sub-PDU according to TS 38.321 clause 6.1.5 */
    NR_RAR_BackoffIndicator_Type        BackoffIndicator,
    NR_RAR_RapIdOnly_Type               RapIdOnly,
    NR_RAR_RapIdAndPayload_Type         RapIdAndPayload
  };
  
  type record of NR_RAR_SubPdu_Type NR_RAR_SubPduList_Type;             /* list of MAC subPDUs; if a Backoff Indicator is included it has to be the first element (TS 38.321 clause 6.1.5) */

  type record NR_RAR_MacPdu_Type {
    NR_RAR_SubPduList_Type              SubPduList            optional, /* list of Backoff Indicator (optional) and random access responses;
                                                                         * empty list if no RAR shall be sent at all (omit means "keep as it is" as usual) */
    boolean                             CrcError              optional  /* if set, MAC PDU shall be transmitted with CRC bits (0-3) being toggled */
  };

  type record NR_RandomAccessResponseConfig_Type {                      /* configuration for Random Access Response mapped to DL-SCH mapped to PDSCH */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci     optional, /* in general a RACH procedure is expected at the BWP currently being configured as active BWP at the SS;
                                                                         * Type1-PDCCH common search space is used for scheduling of the Random Access Response (Msg2) */
    NR_RAR_MacPdu_Type                  MacPdu                optional  /* MAC PDU to be sent automatically by the SS when there has been a RACH preamble */
  };
  
  type record NR_Msg3Retansmission_Type {
    integer                             SlotOffset (1..4095),           /* The time offset in slots for scheduling the UL TC-RNTI grant for Msg3 retransmission, from the slot in which Msg2 (RAR) is transmitted.
                                                                           The upper limit is for max allowed value of contention resolution window (ra-ContentionResolutionTimer) 64 subframes and max 64 slots in subframe for numerology 6.
                                                                         */
    NR_SearchSpaceUlDciAssignment_Type  TCRNTI_Grant                    /* The SS assigns UL grant on PDCCH;
                                                                         * the UL grant is scrambled by TC-RNTI and in general expected at the BWP currently being configured as active BWP at the SS;
                                                                         * Type1-PDCCH common search space is used for scheduling. */
  };

  } // End sub-sub-sub-group Random_Access_Response

  //----------------------------------------------------------------------------
  
  group Contention_Resolution {

  type union NR_ContentionResolutionCtrl_Type {
    Null_Type                           None,                           /* no contention resolution: e.g. in case of contention free random access procedure or for special cases of contention based random access procedure */
    NR_SearchSpaceUlDciAssignment_Type  CRNTI_Based,                    /* contention resolution based on C-RNTI on PDCCH: The SS assigns UL grant on PDCCH;
                                                                         * the UL grant is scrambled by C-RNTI and associated with the UE-specific search space */
    NR_RachProcedureMsg4_Type           Msg4_Based                      /* contention resolution based on UE Contention Resolution Identity on DL-SCH */
  };

  type record NR_RachProcedureMsg4_Type {                                       /* Msg4 of the RACH procedure in case of contention resolution based on UE Contention Resolution Identity */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci             optional, /* DCI to be used for Msg4; the DCI is scrambled by the temporary C-RNTI and associated with the Type1-PDCCH common search space */
    NR_ContentionResolutionId_Type      ContentionResolutionId        optional, /* Contention Resolution Id contained in MAC PDU of Msg4 */
    NR_RachProcedureMsg4RrcMsg_Type     RrcPdu                        optional, /* RRC message to be contained in Msg4 of the RACH procedure */
    boolean                             CrcError                      optional  /* if set, MAC PDU shall be transmitted with CRC bits (0-3) being toggled */
  };

  type union NR_ContentionResolutionId_Type {
    B48_Type                            XorMask,                        /* When SS receives Contention Resolution ID from the UE,
                                                                         * SS shall XOR it with the given mask and use this as Contention Resolution ID;
                                                                         * this allows to get an unmatching Contention Resolution ID;
                                                                         * in normal cases mask shall be set to tsc_ContentionResolutionId_Unchanged
                                                                         * (i.e. the Contention Resolution ID remains unchanged)
                                                                         * NOTE: In case of UL_CCCH1_Message the contention resolution id shall be cut down to the first 48 bits according to TS 38.321 clause 6.1.3.3 */
    Null_Type                           None                            /* MAC Contention Resolution Control Element is not contained in the MAC PDU sent out as response for Msg3 */
  };

  type union NR_RachProcedureMsg4RrcMsg_Type {
    octetstring                         RrcCcchMsg,                     /* encoded RRC message for CCCH; LCID=000000 for CCCH */
    octetstring                         RrcDcchMsg,                     /* encoded RRC message for DCCH; the SS shall
                                                                         * - apply integrity protection,
                                                                         * - add a PDCP header accordingly,
                                                                         * - add an AM RLC header,
                                                                         * - use LCID=000001 corresponding to SRB1 as logical channel id */
    Null_Type                           None                            /* Msg4 does not contain any RRC message, e.g. when RRC message is sent stand-alone in separate DL transmission */
  };

  } // End sub-sub-sub-group Contention_Resolution
  
  group TwoStepRACH {
  
  type union NR_2StepMsgB_Config_Type {
    Null_Type                           None,                            /* No Msg transmitted */
    NR_MsgB_Config_Type                 MsgbRNTI,                        /* The DCI is scrambled by MSGB-RNTI, C-RNTI MCE not included in MSGA */
    NR_MsgB_CRNTI_Config_Type           CRNTI                            /* The DCI is scrambled by C-RNTI, C-RNTI MCE included in MSGA */
  };
  
  type record NR_MsgB_CRNTI_Config_Type {                                /* configuration for MsgB C-RNTI scrambled mapped to DL-SCH mapped to PDSCH */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci optional,      /* in general a RACH procedure is expected at the BWP currently being configured as active BWP at the SS;
                                                                         * Type1-PDCCH common search space is used for scheduling of the MsgB
                                                                         */
    NR_MsgB_CRNTI_MacPdu_Type           MacPdu optional                  /* MAC PDU to be sent automatically by the SS when there has been a RACH preamble */
  };
  
  type record NR_MsgB_CRNTI_MacPdu_Type {
    NR_MsgB_CRNTI_SubPduList_Type       SubPduList optional,            /* list of MsgB sub PDU's;
                                                                         * empty list if no MsgB SubPDU shall be sent at all (omit means "keep as it is" as usual), MAC PDU with Padding only is sent.
                                                                         */
    boolean                             CrcError optional               /* if set, MAC PDU shall be transmitted with CRC bits (0-3) being toggled */
  };

  type union NR_MsgB_CRNTI_SubPdu_Type {                                /* MsgB C-RNTI scrambled sub-PDU */
    NR_RACH_TimingAdvance_Type          AbsTA                           /* Figure 6.1.3.4a-1 Absolute Timing Advance Command MAC CE.
                                                                         * NOTE:
                                                                         * timing advance has impact not only on the RA procedure;
                                                                         * SS in general needs to adjust its timing accordingly
                                                                         */
  };
  
  type record of NR_MsgB_CRNTI_SubPdu_Type NR_MsgB_CRNTI_SubPduList_Type;   /* list of MAC subPDUs */

  type record NR_MsgB_Config_Type {                                     /* configuration for MsgB mapped to DL-SCH mapped to PDSCH */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci optional,     /* in general a RACH procedure is expected at the BWP currently being configured as active BWP at the SS;
                                                                         * Type1-PDCCH common search space is used for scheduling of the MsgB
                                                                         */
    NR_MsgB_MacPdu_Type                 MacPdu optional                 /* MAC PDU to be sent automatically by the SS when there has been a RACH preamble */
  };
  
  type record NR_MsgB_MacPdu_Type {
    NR_MsgB_SubPduList_Type             SubPduList optional,            /* list of Backoff Indicator (optional) and MsgB sub PDU's;
                                                                         * empty list if no MsgB SubPDU shall be sent at all (omit means "keep as it is" as usual), MAC PDU with Padding only is sent.
                                                                         */
    boolean                             CrcError optional               /* if set, MAC PDU shall be transmitted with CRC bits (0-3) being toggled */
  };
  
  type union NR_MsgB_SubPdu_Type {                                      /* MsgB sub-PDU according to TS 38.321 clause 6.1.5a */
    NR_RAR_BackoffIndicator_Type        BackoffIndicator,
    NR_RAR_RapIdAndPayload_Type         FallbackRAR,                    /* Figure 6.1.5a-2: FallbackRAR MAC subheader is same as RAPId & Figure 6.2.3a-1: fallbackRAR Payload is same as RAR */
    NR_RAR_SuccessPayload_Type          SuccessRAR,
    NR_RachProcedureMsg4RrcMsg_Type     RrcPdu                          /* RRC message to be contained in MsgB of the 2 Step RACH procedure */
  };

  type record NR_RAR_SuccessPayload_Type {                              /* MAC subPDU Success RAR according to TS 38.321 Figure 6.2.3a-2 */
    NR_ContentionResolutionId_Type      ContentionResolutionId,         /* Contention Resolution Id contained in MAC PDU of MsgB This field contains the UL CCCH SDU.
                                                                         * If the UL CCCH SDU is longer than 48 bits, this field contains the first 48 bits of the UL CCCH SDU
                                                                         */
    B2_Type                             ChAccess_CPext,                 /* The field is only present when the MSGB HARQ feedback is to be transmitted with shared spectrum channel access as specified in TS 37.213 [18].
                                                                         * Otherwise, the field is not present and R bits (set to 0) are present instead
                                                                         */
    B3_Type                             TPC_Command,                    /* TPC command for Msg3 PUSCH */
    B3_Type                             MsgB_HARQ_TimInd,               /* The PDSCH-to-HARQ feedback timing indicator field for MSGB HARQ feedback as specified in TS 38.213 */
    B4_Type                             PUCCH_ResInd,                   /* The PUCCH resource indicator for HARQ feedback for MSGB, as specified in TS 38.213 */
    NR_RACH_TimingAdvance_Type          TimingAdvance,                  /* timing advance: TS 38.321 clause 6.2.3 and TS 38.213 clause 4.2
                                                                         * NOTE:
                                                                         * timing advance has impact not only on the RA procedure;
                                                                         * SS in general needs to adjust its timing accordingly
                                                                         */
    NR_TempC_RNTI_Type                  C_RNTI                          /* NOTE:
                                                                         * In general for C_RNTI shall be 'SameAsC_RNTI' stored in SS.
                                                                         * explicit C-RNTI can be used for error cases
                                                                         */
  };
  
  type record  of NR_MsgB_SubPdu_Type NR_MsgB_SubPduList_Type;          /* list of MAC subPDUs; if a Backoff Indicator is included it has to be the first element (TS 38.321 clause 6.1.5a) */

  }// End sub-sub-group TwoStepRACH
  } // End sub-sub-group Random_Access_Procedure
  
  } // End sub-group MAC_Layer

  //----------------------------------------------------------------------------
  
  group System_Information_Control {                                    /* Primitive to configuration scheduling of system information on BCCH/BCH */

  // ***** PBCH (MIB)
  type Null_Type NR_BcchToPbchConfig_Type;                              /* place holder for BCCH mapped to BCH mapped to PBCH:
                                                                         * MIB using fixed periodicity (80ms) and repetitions (80ms) according to TS 38.331 clause 5.2.1;
                                                                         * the position of SS/PBCH blocks in frequency and time domain is specified in TS 38.211 clause 7.4.3 and TS 38.213 clause 4.1
                                                                         * the SS configuration for SS/PBCH blocks is defined by NR_SSB_Config_Type as part of physical layer configuration of a cell
                                                                         */
  // ***** PDSCH (SIB1)
  type record NR_Sib1Schedul_Type {                                     /* Scheduling of SIB1 (RMSI - Remaining Minimum SI, according to TS 38.300 clause 7.3):
                                                                         * fixed scheduling in time domain according to TS 38.331 clause 5.2.1
                                                                         * (periodicity: 160ms according to TS 38.331 clause 5.2.1)
                                                                         */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci     optional, /* in general SIB scheduling is assigned to the initial BWP's Type0-PDCCH common search space (searchSpaceZero);
                                                                         * in principle SIB scheduling can be configured to happen simultaneously in more than one BWP (e.g. initial BWP and active BWP);
                                                                         * SIB1 scheduling may be stopped by not assigning any BWP (AssignedBWPs being empty)
                                                                         */
    integer                             Periodicity           optional, /* SIB1 repetition transmission period in milliseconds.
                                                                         * According to TS 38.331 clause 5.2.1 the SIB1 repetition transmission period is 20 ms in case of SSB and CORESET multiplexing pattern 1;
                                                                         * for SSB and CORESET multiplexing pattern 2/3 it is the same as the SSB period
                                                                         */
    IntegerList_Type                    SlotOffsetList        optional  /* List of slot offsets for SIB1:
                                                                         * For single beam configuration there is exactly one offset corresponding to the SSB index of the beam.
                                                                         * For multiple beam configuration with N beams, SIB1 may be scheduled per beam so that there can be up-to N SIB1-transmission per repetition period.
                                                                         * The offsets correspond to the SSB index of the respective beam as according to TS 38.213 clause 13:
                                                                         * For a repetition period of 20ms the offset is relative to start of frames with even SFN (i.e. SFN mod 2 = 0)
                                                                         * => in terms of TS 38.213 clause 13 for a given SSB index the slot offset is
                                                                         *    n0                                        when nO refers to a frame with even SFN
                                                                         *    n0 + (number of slots per frame)          when nO refers to a frame with odd SFN
                                                                         * A repetition period other than 20ms is not considered as long as there is no test requirement.
                                                                         * NOTE: the SIB1 scheduling for a given offset shall match the Type0-PDCCH common search space configuration as configured in the SearchSpaceArray of the BWP
                                                                         */
  };
  
  // ***** PDSCH (all other SIs)
  type record NR_SingleSiSchedul_Type {                                 /* Scheduling for a single SI in its SI-window within a BWP (or even within several BWPs) */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci     optional, /* in general SIB scheduling is assigned to the initial BWP's Type0A-PDCCH common search space;
                                                                         * nevertheless in principle scheduling can be configured to happen simultaneously in more than one BWP (e.g. initial BWP and active BWP)
                                                                         */
    integer                             SlotOffset            optional  /* slot-offset within the SI-window */
  };

  type record NR_OtherSiSchedul_Type {                                  /* Scheduling of other SI ("other SI" according to TS 38.300 clause 7.3):
                                                                         * specifies for a specific SI the scheduling and repetitions within its SI window
                                                                         */
    NR_SiPeriodicity_Type               Periodicity           optional,
    record of NR_SingleSiSchedul_Type   Window                optional  /* one or more repetitions within the si-window */
  };
  
  type record of NR_OtherSiSchedul_Type NR_OtherSiSchedulList_Type;

  type record NR_PosSiSchedul_Type {                                     /* Scheduling of other SI ("other SI" according to TS 38.300 clause 7.3) including posSIBs: specifies for a specific SI the scheduling and repetitions within its SI window
                                                                          */
    NR_PosSI_Periodicity_Type           PosSI_Periodicity     optional,
    record of NR_SingleSiSchedul_Type   Window                optional   /* one or more repetitions within the si-window
                                                                          */
  };
  
  type record of NR_PosSiSchedul_Type   NR_PosSiSchedulList_Type;
  
  type record PosSiSchedulInfo_Type {
    boolean                             OffsetToSI_Used       optional, /* If true: indicates that all the SI messages containing posSIBs are scheduled with an offset of 8 radio frames compared to SI messages provided in NR_AllOtherSiSchedul_Type. SiList and NR_AllOtherSiSchedul_Type.SegmentedSiList.
                                                                         * If false: the SI messages containing posSIBs are scheduled after the other SI messages provided in NR_AllOtherSiSchedul_Type.SiList and NR_AllOtherSiSchedul_Type.SegmentedSiList.
                                                                         * Corresponding to ASN.1 PosSchedulingInfo-r16.offsetToSI-Used-r16.
                                                                         */
    NR_PosSiSchedulList_Type            PosSiList             optional  /* list of scheduling info for the posSIs containing one or more posSIBs
                                                                         */
  };

  type record NR_AllOtherSiSchedul_Type {                               /* Scheduling of (all) other SI (i.e. SIB2 and above according to TS 38.300 clause 7.3) */
    NR_SiWindowLength_Type              WindowLength          optional, /* to calculate start of each SI window according to TS 38.331 clause 5.2.2.3.2 */
    NR_OtherSiSchedulList_Type          SiList                optional, /* list of scheduling info for the SIs containing one or more SIBs */
    NR_OtherSiSchedulList_Type          SegmentedSiList       optional, /* list of scheduling info for segmented SIs (e.g. SI containing SIB7 or SIB8 or SIB12);
                                                                         * corresponds to SegmentedSIs in NR_BcchInfo_Type: SS shall subsequently schedule the elements of the corresponding SegmentedSIs (NR_BcchInfo_Type);
                                                                         * SegmentedSiList[i] provides scheduling info for BcchInfo_Type's SegmentedSIs[i]
                                                                         * The kth element of SegmentedSIs[i] is sent at the following slot number from T0:
                                                                         *     SlotOffset + ((N+i)* WindowLength) + k*Periodicity
                                                                         *     with
                                                                         *        k : kth element in SegmentedSIs[i], i.e. SegmentedSIs[i][k]
                                                                         *        N : number of SI provided in SIs in NR_BcchInfo_Type
                                                                         *        T0: start of the modification period
                                                                         *        SlotOffset, Periodicity: scheduling info as given by SegmentedSiList[i] - in slots
                                                                         *        WindowLength: provided in NR_AllOtherSiSchedul_Type - in slots
                                                                         */
    PosSiSchedulInfo_Type               PosSiSchedulInfo       optional  /* list of scheduling info for SIs containing one or more posSIBs */
  };
  
  // ***** PDSCH (SIB1 + SIs)
  type record NR_BcchToPdschConfig_Type {                               /* configuration for BCCH mapped to DL-SCH mapped to PDSCH */
    NR_Sib1Schedul_Type                 Sib1Schedul           optional, /* SIB1 scheduling */
    NR_AllOtherSiSchedul_Type           SiSchedul             optional  /* scheduling of other SI */
  };

  type record of BCCH_DL_SCH_Message NR_SI_List_Type;                   /* list of system information messages */
  type record of NR_SI_List_Type NR_SegmentedSI_List_Type;              /* Each element is a list of segments; used for segmented SIBs
                                                                           Used for SIB7/SIB8/SIB12 segmentation
                                                                         */

  type union NR_PosSI_Type {
        BCCH_DL_SCH_Message     PosSI,                                  /* None of the AssistanceDataElement in the posSIBs in the SI are segmented.  */
        NR_SI_List_Type         SegmentedPosSIs                         /* List of SI containing posSIBs containing segments of AssistanceDataElement, according to TS 37.355 clause 7.3.
                                                                         * SS shall schedule one element of the list (SegmentedPosSIs) in the si-window;
                                                                         * PosSiSchedulInfo[i] provides scheduling info for PosSIs[i].SegmentedPosSIs
                                                                         */
  };
  
 type record of NR_PosSI_Type NR_PosSI_List_Type;                       /* Each element is an SI including posSIBs or a list of SI containing posSIBs containing segments of AssistanceDataElement. */

  // ***** content of system information
  type record NR_BcchInfo_Type {                                        /* Configuration of system information message contents to be scheduled at the SS */
    BCCH_BCH_Message                    MIB                   optional, /* MIB broadcast in the CD-SSB as defined in TS 38.331, clause 6.2.1 BCCH-BCH-Message and clause 6.2.2 MIB;
                                                                         * NOTE:
                                                                         * the system frame number included in MIB needs to be handled and maintained by the system simulator;
                                                                         * that means that the system frame number being setup by TTCN shall be ignored and overwritten by the SS
                                                                         */
    BCCH_DL_SCH_Message                 SIB1                  optional, /* TS 38.331, clause 6.2.1 BCCH-DL-SCH-Message and clause 6.2.2 SIB1 */
    NR_SI_List_Type                     SIs                   optional, /* list of SIs corresponding to SiList of NR_AllOtherSiSchedul_Type
                                                                         * (i.e. element i of NR_AllOtherSiSchedul_Type's SiList specifies the scheduling for SIs[i])
                                                                         */
    NR_SegmentedSI_List_Type            SegmentedSIs          optional, /* list of SIs containing segmented SIBs;
                                                                         * corresponds to SegmentedSiList in NR_AllOtherSiSchedul_Type
                                                                         */
    NR_PosSI_List_Type                  PosSIs                optional, /* list of SIs containing posSIBs corresponding to PosSiSchedulInfo of NR_AllOtherSiSchedul_Type
                                                                         * (i.e. element i of NR_AllOtherSiSchedul_Type's PosSiSchedulInfo specifies the scheduling for posSIs[i])
                                                                         */
    NCD_BCCH_BCH_Message_List           NCD_MIBs              optional  /* List of MIBs broadcast in the NCD-SSBs. For reconfiguration, the whole list of MIB broadcast in NCD-SSBs is provided to SS.
                                                                         * May be omitted at initial configuration e.g. in case no NCD-SSBs are broadcast.
                                                                         * NOTE:
                                                                         *  the system frame number included in NCD-MIB needs to be handled and maintained by the system simulator;
                                                                         *  that means that the system frame number being setup by TTCN shall be ignored and overwritten by the SS
                                                                         */
  };
  
  // ***** configuration for BCCH
  type record NR_BcchConfig_Type {                                      /* Configuration of system information scheduling and content at the SS */
    NR_BcchToPbchConfig_Type            Pbch                  optional,
    NR_BcchToPdschConfig_Type           Pdsch                 optional,
    NR_BcchInfo_Type                    BcchInfo              optional
  };

  type record of NCD_BCCH_BCH_Message NCD_BCCH_BCH_Message_List;
 
  type record NCD_BCCH_BCH_Message {
    NR_AssignedBWPs_Type                AssignedBWPs, /* BWP on which NCD-SS/PBCH-block the given MIB is broadcast;
                                                       * AssignedBWPs shall specify exactly one BWP (ActiveBWP is not applied); the SS may raise an error otherwise
                                                       */
    BCCH_BCH_Message                    MIB
  };

  } // End sub-group System_Information_Control
  
  //----------------------------------------------------------------------------
  
  group Paging_Control {                                                /* Primitive to configuration PCCH/PCH */

  type record NR_PcchConfig_Type {                                      /* configuration for PCCH mapped to PCH mapped to PDSCH */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci     optional  /* in general Paging happens at the BWP currently being configured as active BWP at the SS and Type2-PDCCH common search space is used for scheduling;
                                                                           NOTE 1: there is no use case to schedule Paging simultaneously in multiple BWPs
                                                                           NOTE 2: the DCI may or may not carry a short message but it in any case it shall indicate presence of the paging
                                                                           (to send only a short message the "DciTrigger" primitive shall be used) */
  }

  } // End sub-group Paging_Control
  
  //----------------------------------------------------------------------------
  
  group CCCH_DCCH_DTCH_Configuration {

  type record NR_DcchDtchConfigDL_Type {                                /* configuration for DCCH/DTCH mapped to DL-SCH mapped to PDSCH;
                                                                           NOTE: in contrast to EUTRA the configuration of HARQ processes to be used is done as part of DCI configuration */
    NR_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci     optional, /* in general DCCH/DTCH transmissions happen at the BWP currently being the active BWP at the SS and the UE specific search space is used for scheduling;
                                                                           DCI configuration for Msg2 of the RACH procedure is done as part of the RACH procedure configuration (NR_RandomAccessResponseConfig_Type) */
    NR_ASN1_CoresetPoolIndex_Type       CoresetPoolIndex      optional  /* Present if multiple CORESETPoolIndex are configured. If the field is absent, the value 0 applies. */
  };

  type record NR_DcchDtchConfigUL_Type {                                /* scheduling for DCCH/DTCH mapped to UL-SCH mapped to PUSCH */
    NR_SearchSpaceUlDciAssignment_Type  SearchSpaceAndDci     optional, /* in general DCCH/DTCH transmissions happen at the BWP currently being the active BWP at the SS and the UE specific search space is used for scheduling */
    NR_UplinkTimeAlignment_Synch_Type   PUCCH_Synch           optional, /* parameters for automatic control of timing advance */
    UL_GrantConfig_Type                 GrantConfig           optional, /* configuration how UL grant allocation is done (as response to scheduling request, periodically, etc. */
    NR_ASN1_CoresetPoolIndex_Type       CoresetPoolIndex      optional  /* Present if multiple CORESETPoolIndex are configured. If the field is absent, the value 0 applies. */
  };

  type union NR_DrxCtrl_Type {                                          /* DRX configuration for connected mode (TS 38.321, clause 5.7) */
    Null_Type                           None,                           /* DRX not configured */
    NR_ASN1_DRX_Config_Type             Config                          /* DRX is configured as signalled to the UE */
  };

  type union NR_MeasGapCtrl_Type {                                      /* support of measurement gap configuration */
    Null_Type                           None,                           /* no measurement gap configuration  */
    NR_ASN1_MeasGapConfig_Type          Config
  };

  type record NR_DcchDtchConfig_Type {
    NR_DcchDtchConfigDL_Type            DL                    optional, /* Scheduling, parameters related to DCCH and DTCH in DL */
    NR_DcchDtchConfigUL_Type            UL                    optional, /* Scheduling, parameters related to DCCH and DTCH in UL */
    NR_DrxCtrl_Type                     DrxCtrl               optional, /* DRX configuration as sent to the UE (or 'None' when the UE does not support connected mode DRX) */
    NR_MeasGapCtrl_Type                 MeasGapCtrl           optional, /* to tell the SS when no assignments/grants shall be assigned to the UE */
    NR_DcchDtchConfigDL_Type            DL2                   optional, /* Present if multiple CORESETPoolIndex are configured. Scheduling, parameters related to DCCH and DTCH in DL. If present, then both DL2 and DL the explicit mode is used in Downlink Scheduling */
    NR_DcchDtchConfigUL_Type            UL2                   optional  /* Present if multiple CORESETPoolIndex are configured. Scheduling, parameters related to DCCH and DTCH in UL */
  };
  
  } // End sub-group CCCH_DCCH_DTCH_Configuration

  //----------------------------------------------------------------------------

  group Cell_Group_Configuration {                                      /* Configuration of cell group(s) in terms of dual connectivity and carrier aggregation */

  type union NR_ServingCellConfig_Type {                                /* serving cell capabilities of a cell */
    NR_SpCellConfig_Type                SpCell,                         /* parameters specific for an SpCell and cell group configuration */
    NR_SCellConfig_Type                 SCell,                          /* parameters specific for an SCell */
    Null_Type                           None                            /* the is no serving cell at all (e.g. neighbouring cell only) */
  };

  type integer NR_ServingCellIndex_Type;                                /* corresponds to ASN.1 (v15.1.0) definitions SCellIndex (1..31) and ServCellIndex (0..maxNrofServingCells-1):
                                                                           According to ASN.1 "The value range is shared across the Cell Groups" and "the PCell of the Master Cell Group uses ID = 0" */


  type record NR_SCellConfig_Type {                                     /* cell parameters specific for an SCell;
                                                                           NOTE: the corresponding SpCell can be derived from the SpCell's SCellList;
                                                                           further parameters may be added according to test requirements for CA test cases */
    NR_ServingCellIndex_Type            ServingCellIndex      optional,
    TAG_Id                              TAG_Id                optional, /* Id of the Timing Advance Group the SCell belongs to (according to TS 38.321 clause 6.1.3.4 the SpCell has the TAG Identity 0);
                                                                           the SS shall use the given TAG_Id e.g. for automatic time alignment in UL (see NR_UplinkTimeAlignment_AutoSynch_Type) */
    NR_MC_DCI_SetOfCells_Type           MC_DCI_SetOfCell      optional  /* Applicable for DCI X-3
                                                                           To configure one set of cells for multi-cell PDSCH/PUSCH scheduling from the serving SCell, applied when the SCell is the scheduling cell
                                                                         */
  };

  type record NR_SpCellConfig_Type {                                    /* cell parameters specific for an SpCell (PCell of the MCG or the PSCell of the SCG) and additional parameters of the cell group;
                                                                           further parameters may be added according to test requirements for CA test cases  */
    NR_ServingCellIndex_Type            ServingCellIndex      optional,
    NR_SpCell_CellGroupConfig_Type      CellGroupConfig       optional, /* parameters of the cell group of which the cell is SpCell (PCell or PSCell):
                                                                           assigned to SpCell as in many test cases the cell group consists of the SpCell only and on the other hand every cell group has to have at least an SpCell */
    NR_MC_DCI_SetOfCells_Type           MC_DCI_SetOfCells     optional  /* Applicable for DCI X-3
                                                                           To configure one set of cells for multi-cell PDSCH/PUSCH scheduling from the serving SpCell
                                                                         */

  };

  type record NR_SpCell_CellGroupConfig_Type {                          /* Configuration of an NR cell group;
                                                                         * NOTE 1:
                                                                         * The type of cell group (MCG, SCG) may be derived from the CellGroupId (CellGroupId==0 => MCG, CellGroupId>0 => SCG)
                                                                         * NOTE 2:
                                                                         * Further cell group specific MAC and PHY parameters may be added corresponding to ASN.1 MAC-CellGroupConfig or may need to be added
                                                                         * (but e.g. the DRX configuration is assigned to NR_CcchDcchDtchConfig_Type already i.e. there is no need to configure it here) */
    CellGroupId                                 CellGroupId                   optional, /* 0 for MCG (i.e. EUTRA in EN-DC), 1 for SCG (NR in EN-DC); see comments to ASN.1 definition of CellGroupId (v15.1.0) */
    NR_CellIdList_Type                          SCellList                     optional, /* list of SCells belonging to the SpCell's cell group; shall be initialised as empty list */
    NR_ASN1_MAC_CellGroupConfig_Type            MAC_CellGroupConfig           optional, /* Cell group specific MAC parameters as sent to the UE in CellGroupConfig.MAC-CellGroupConfig */
    NR_ASN1_PhysicalCellGroupConfig_Type        PhysicalCellGroupConfig       optional, /* Cell group specific physical layer parameters as sent to the UE in CellGroupConfig.PhysicalCellGroupConfig */
    NR_CellId_Type                              ReferenceCell                 optional  /* Applicable for DCI X-3
                                                                                         * Indicates the serving cell for counting the size of one or both DCI format 0_3 and DCI format 1_3 as according to TS 38.213 clause 10.1 and TS 38.212 clause 7.3.1.0
                                                                                         */
  };

  type union NR_MC_DCI_SetOfCells_Type {
    NR_ASN1_MC_DCI_SetOfCellsConfig_Type        AddOrReconfigure,       /* To (re)configure one set of cells for multi-cell PDSCH/PUSCH scheduling */
    Null_Type                                   Release                 /* To remove MC_DCI_SetOfCells completely  */
  };

  type union NR_ASN1_MC_DCI_SetOfCellsConfig_Type {
    MC_DCI_SetOfCells_r18 R18
  };

  } // End sub-group Cell_Group_Configuration
  
  group Sidelink_ResourceAllocationMode1 { /* Configuration of sidelink resource allocation mode 1 */
  
  type record NR_SidelinkScheduled_Type { /* Configuration of sidelink esource allocation mode 1 for a cell;
                                             all fields are mandatory for the first configuration of an instance for modifications "omit" means "keep as it is" */
    SL_MAC_CellGroupConfig_Type  SL_MAC_CellGroupConfig optional,
    SL_DCI_Config_Type           SL_DCI_Config          optional
  };
  
  type record SL_MAC_CellGroupConfig_Type {
    BSR_Config                   SL_BSR_Config           optional,
    SL_LogicalChannelConfig_r16  SL_LogicalChannelConfig optional
  };
  
  type record SL_DCI_Config_Type {
    NR_SearchSpaceSlDciAssignment_Type  SearchSpaceAndDci       optional,
    SL_GrantConfig_Type                 GrantConfig             optional
  };
    
  type record NR_SearchSpaceSlDciAssignment_Type {
    NR_AssignedBWPs_Type      AssignedBWPs     optional, /* BWP where given DCI shall be scheduled in given search space;
                                                            AssignedBWPs shall specify exactly one BWP (ActiveBWP in general); the SS may raise an error otherwise */
    NR_SearchSpaceType_Type   SearchSpaceType  optional, /* search space to be used for sending of given DCI;
                                                            when at the scheduled point in time of a UL grant transmission there is no such search space configured at the given BWP, the SS may raise an error */
    NR_DciSlInfo_Type         DciInfo          optional  /* DCI to be used */
  };
  
  type record NR_DciSlInfo_Type {  /* TS 38.212 clause 7.3.1.4.1: scheduling of NR PSCCH and NR PSSCH in one cell; default parameters according to TS 38.508-1 clause 4.3.6.1.4.1;
                                      for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards */
    NR_DciFormat_3_0_ResourceAssignment_Type   ResourceAssignment   optional,
    NR_DciFormat_3_0_SlHarqViaUu_Type          SlHarqViaUu          optional,
    NR_DciFormat_3_0_SpecificInfo_Type         Format               optional
  };
  
  type record NR_DciFormat_3_0_ResourceAssignment_Type {             /* TS 38.212 clause 7.3.1.4.1: common fields for resource scheduling of SL */
    NR_DciFormat_3_0_ResourcePoolIndex ResourcePoolIndex optional,   /* Resource Pool Index */
    NR_DciFormat_3_0_TimeGap           TimeGap           optional,   /* Time gap */
    NR_DciFormat_3_0_HarqProcess       HarqProcess       optional,   /* HARQ process number */
    NR_DciFormat_3_0_NDI               NDI               optional,   /* New data indicator */
    NR_DciFormat_3_0_LowestSubchTx     LowestSubchTx     optional,   /* Lowest index of the subchannel allocation to the initial transmission */
    NR_DciFormat_3_0_Sci1_A            Sci1_A            optional,   /* SCI format 1-A fields according to TS 38.212 clause 8.3.1.1 */
    NR_DciFormat_3_0_CounterSAI        CounterSAI        optional    /* Counter sidelink assignment index */
  };

  type union NR_DciFormat_3_0_ResourcePoolIndex { /* TS 38.212 clause 7.3.1.4.1: index to one of the resourece pools in sl-TxPoolScheduling, if configured, and sl-DiscTxPoolScheduling, if configured */
    Null_Type    None,
    bitstring    Index
  };
  
  type record NR_DciFormat_3_0_TimeGap { /* entry of sl-DCI-ToSL-Trans to be used */
    B3_Type      Index
  };
  
  type union NR_DciFormat_3_0_HarqProcess {
    NR_DciFormat_3_0_HarqProcess_CGtype2 HarqProcessCGtype2,
    NR_HarqProcessConfig_Type            Value
  };
  
  type union NR_DciFormat_3_0_HarqProcess_CGtype2 {
    B3_Type   Activate,    /* set to '000'B for activation of configured grant type 2; */
    B3_Type   Deactivate   /* set to '111'B for deactivation of configured grant type 2 */
  };
  
  type union NR_DciFormat_3_0_NDI {
    boolean     ToggleNDI,    /* "true" for transmission of a new transport block, "false" for a re-transmission;
                                 the NDI (New data indicator) itself is maintained by the SS and therefore not provided as configuration parameter */
    B1_Type     CG_Type2      /* to be set to '0'B when activating/releasing SL configured grant Type 2. */
  };
  
  type record NR_DciFormat_3_0_LowestSubchTx {
    bitstring   Index
  };
  
  type record NR_DciFormat_3_0_SlHarqViaUu_Type {
    NR_DciFormat_3_0_PfschToHarqTiming       PfschToHarqTiming      optional,
    NR_DciFormat_3_0_PucchResourceIndicator  PucchResourceIndicator optional
  };

  type union NR_DciFormat_3_0_PfschToHarqTiming {
    Null_Type    None,
    B3_Type      Index
  };

  type record NR_DciFormat_3_0_PucchResourceIndicator {
    B3_Type      Index
  };
  
  type union NR_DciFormat_3_0_SpecificInfo_Type {
    NR_DciFormat_3_0_DG    Format3_0_DG,
    NR_DciFormat_3_0_CG    Format3_0_CG
  };
  
  type record NR_DciFormat_3_0_DG { /* Configuration of dynamic grant */
    RNTI_Value   SL_RNTI
  };
  
  type record NR_DciFormat_3_0_CG {  /* Configuration of configured grant */
    RNTI_Value                      SL_CS_RNTI,
    NR_DciFormat_3_0_ConfigIndex    ConfigIndex     optional   /* Configuration index */
  };
  
  type record NR_DciFormat_3_0_ConfigIndex {
    B3_Type      Index   /* as defined in TS 38.214 clause 8.1.2; index to entry of sl-ConfiguredGrantConfigList to be used */
  };
 
  type record NR_DciFormat_3_0_CounterSAI {
    B2_Type     Index
  };
  
  type record NR_DciFormat_3_0_Sci1_A {
    NR_SL_FreqRessourceAssignment_Type  FreqResourceAssignment  optional,
    integer                             TimeResourceAssignment  optional
  };
  
  type union SL_GrantConfig_Type  {
    Null_Type               OnSL_BSR_Reception,     /* SS transmits SL Grant as configured by NR_DciSlInfo_Type at every reception of SL_BSR or sl-SchedulingRequestId-r16 when different than SchedulingRequestId;
                                                     */
    SL_PeriodicGrant_Type   Periodic,               /* SS transmits SL Grant as configured by NR_DciSlInfo_Type periodically;
                                                     * to be used in L2 tests;
                                                     * MAC tests testing Grants might set the period as infinite and num grant as 1 */
    SL_PeriodicGrant_Type   PeriodicOnSR_Reception, /* SS transmits SL Grant as configured by NR_DciSlInfo_Type periodically; the periodic grant transmission
                                                     * is started/restarted on reception of a SL_BSR from UE */
    Null_Type               Retransmission,         /* Acc to 38.321, for retransmission of configured grant type 1 and type 2 - SL-CS-RNTI */
    Null_Type               None                    /* disable any grant transmission */
  };

  type record SL_PeriodicGrant_Type {
    SLGrant_Period_Type                 Period,           /* time period after which SL Grant need to be automatically transmitted or 'OnlyOnce' */
    TransmissionRepetition_Type         NoOfRepetitions   /* number of SL Grant repetitions to be automatically transmitted or continuous repetition */
  };
  
  type union SLGrant_Period_Type {
    Null_Type            OnlyOnce,                        /* grant is sent out only once; no period */
    integer              Duration (1..infinity)           /* duration of the grant period in number of slots */
  };
  
  type record NR_SL_FreqRessourceAssignment_Type {
    /* TS 38.214 clause 8.1.5 */
    /* The NR-SS-UE shall automatically do the resource assignment needed for a transmission */
    integer  FirstSubchannel,               /* The starting sub-channel index of the first resource */
    integer  MaxSubchannels                 /* maximum number of sub-channels to be used */
  };
  
  } // End sub-group Sidelink_ResourceAllocationMode1
  
  group NTN_Configuration {
    type TA_Info_r17.ta_Common_r17  NR_NTN_T_TA_Type;  /* acc. to TS 38.331 clause 6.3.2, the granularity is 4.072 10pow(-3) microsec */

    type record NR_NTN_SemistaticTA_Type {
      NR_RACH_TimingAdvance_Type  InitialValue,   /* initial value corresponding to what is sent to the UE in RACH response; (range acc. 12 bit value; 0 in normal cases) */
      NR_NTN_T_TA_Type            NtnCommonTA,    /* round trip time (RTT) between the UL time synchronisation reference point (RP) and the serving satellite */
      NR_NTN_T_TA_Type            NtnUeSpecificTA /* round trip time (RTT) between the UE and the serving satellite */
    }
    
    type union NR_NTN_TimingAdvanceConfig_Type {
      NR_NTN_SemistaticTA_Type    Semistatic      /* semi-static configuration of the NTN cell's Timing Advance (TA);
                                                   * SS shall not autonomously change the value of TA over time;
                                                   * TTCN may re-configure the TA value */
    }
      
    type integer                  NR_NTN_K_Offset_Type (0..1023);
    type integer                  NR_NTN_K_Mac_Type (0..512);
    type NTN_Config_r17.ntn_PolarizationDL_r17 NR_ASN1_NTN_Config_PolarizationDL_Type;
    type NTN_Config_r17.ntn_PolarizationUL_r17 NR_ASN1_NTN_Config_PolarizationUL_Type;
  
    type record NR_NTN_TimingOffset_Type {
      NR_NTN_K_Offset_Type        Koffset            optional,    /* Koffset in ms as defined in TS 38.213 clause 4.2. If omit, keep as it is. */
      NR_NTN_K_Mac_Type           Kmac               optional     /* Scheduling offset in ms provided by network if DL and UL frame timings are not aligned at gNB. If omit, keep as it is. */
    }

    type union NR_ASN1_NTN_PolarizationDL_Type {
      NR_ASN1_NTN_Config_PolarizationDL_Type      R17
    };
      
    type union NR_ASN1_NTN_PolarizationUL_Type {
      NR_ASN1_NTN_Config_PolarizationUL_Type      R17
    };

    type record NR_NTN_PolarizationConfig_Type {
      NR_ASN1_NTN_PolarizationDL_Type     DL        optional, /* This parameter indicates polarization that the SS shall apply for DL transmissions on service link, set as according to NTN_Config_r17.ntn_PolarizationDL_r17. */
      NR_ASN1_NTN_PolarizationUL_Type     UL        optional  /* This parameter indicates polarization that the SS shall apply for UL receptions on service link, set as according to NTN_Config_r17.ntn_PolarizationUL_r17. */
    };

    type record NR_NTN_Config_Type {
      NR_NTN_TimingOffset_Type         NtnTimingOffset    optional,   /* to configure PHY/MAC layers with NTN parameters Koffset and Kmac needed for NTN operation.*/
      NR_NTN_PolarizationConfig_Type   NtnPolarization            optional,   /* to configure polarization for transmission/reception on the service link. */
      integer                          NtnFrequencyDopplerShift   optional    /* to configure service link with a constant frequency Doppler shift. The unit is ppm (parts per million), actual value = field value*10^-5. See clause 7.5.3 for further information*/
    };

  } // End sub-group NTN_Configuration
 
 //========================================================================================================================================================================
  group MBS {

  type record NR_MBS_Config_Type {
    /* Configuration of MCCH and MTCH */
    NR_MBS_BWP_Type                               CfrBwp    optional,                             /* Common frequency resource used for MCCH and MTCH
                                                                                                   * Set as according to TS 38.331
                                                                                                   */
    NR_MCCH_Config_Type                           Mcch      optional,                             /* MCCH configuration and MCCH information
                                                                                                   * May be omitted at initial configuration e.g. when no MCCH shall be broadcasted
                                                                                                   */
    NR_MTCH_ConfigList_Type                       Mtch      optional                              /* MTCH configuration */
  };

  type union NR_MBS_BWP_Type {
    NR_ASN1_CFR_ConfigMCCH_MTCH_Type              cfr,
    Null_Type                                     common   /* The frequency resource for broadcast has the same location and size as CORESET#0
                                                            * and PDSCH configuration of MCCH is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1 */
  };

  type union NR_MCCH_Config_Type {
    NR_MCCH_ConfigInfo_Type                       AddOrReconfigure,                 /* To configure or reconfigure MCCH */
    Null_Type                                     Release                           /* To remove MCCH completely  */
  };

  type record NR_MCCH_ConfigInfo_Type {
    /* MCCH RLC UM entity shall be configured by SS as according to TS 38.331 clause 9.1.1.6
     * omit means keep as it is */
    NR_MCCH_Schedule_Type                         McchScheduleConfig   optional,
    NR_McchInfo_Type                              McchInfo             optional              /* RRC message or segments sent on the MCCH logical channel sent per MCCH repetition period */
  };

  type record NR_MCCH_Schedule_Type {   /* Scheduling of MCCH */
    NR_ASN1_MCCH_RepetitionPeriodAndOffset_Type   Periodicity   optional, /* Length and the offset of the MCCH repetition period */
    NR_McchSchedulList_Type                       DciOffsetList optional  /* Scheduling info for MCCH or MCCH segments */
  };

  type record of NR_McchSchedul_Type NR_McchSchedulList_Type;

  type record NR_McchSchedul_Type {
    /* Scheduling for a single MCCH message or a single MCCH segment */
    NR_MBS_SearchSpaceDlDciAssignment_Type        SearchSpaceAndDci     optional, /* MCCH scheduling is assigned to CfrBwp BWP;
                                                                                   * DCI format 4_0 is used for the scheduling of MCCH in DL with CRC scrambled by MCCH-RNTI
                                                                                   */
    integer                                       SlotOffset            optional  /* Slot offset within the MCCH Repetition period. TTCN shall ensure that the offset matches the MCCH transmission window.
                                                                                   */
  };

  type record NR_MBS_SearchSpaceDlDciAssignment_Type {
    /* Configuration of DCI for a specific search space for MBS;
       the DCI is applied for DL transmission on DL-SCH channel;
       all fields are mandatory for the first configuration of an instance for modifications "omit" means "keep as it is"
     */
    NR_AssignedBWPs_Type                          AssignedBWPs          optional,   /* BWP where given DCI shall be scheduled in given search space */
    NR_SearchSpaceType_Type                       SearchSpaceType       optional,   /* Searchspace to be used for sending of given DCI;
                                                                                     * For MCCH broadcast it can be either css_Type0 or css_Type0B
                                                                                     * When at the scheduled point in time of a DL transmission there is no such search space configured at the given BWP, the SS may raise an error
                                                                                     */
    NR_MBS_DciDlInfo_Type                         DciInfo               optional    /* DCI Info */
  };

 type union NR_McchInfo_Type {
    NR_ASN1_MCCH_Message_Type                     McchMessage,                       /* Single MCCH message - no segmentation expected */
    record of octetstring                         McchMessageSegmentList             /* List of octetstring of RLC data SDUs containing segments of encoded MCCH message content
                                                                                      * SS shall subsequently schedule the elements of the corresponding McchMessageSegmentList in the same MCCH period at the offset DciOffsetList[i].SlotOffset;
                                                                                      * DciOffsetList[i] provides scheduling info for McchMessageSegmentList[i]
                                                                                      */
 };

 type record NR_MBS_DciDlInfo_Type {
    /* scheduling for MCCH/MTCH mapped to DL-SCH mapped to PDSCH;
       for all parameters: mandatory for initial configuration of an instance, omit means "keep as it is" afterwards;
       definition is applicable for DCI format 4_X
     */
    NR_DciFormat_DL_ResourceAssignment_Type        ResoureAssignment         optional, /* Resource assignment; to control setting of the following fields in DCI formats 4_X (TS 38.212 clause 7.3.1.5.X):
                                                                                         * Frequency domain resource assignment
                                                                                         * Time domain resource assignment
                                                                                         * Modulation and coding scheme
                                                                                         * Redundancy version
                                                                                         * HARQ process config: Broadcast
                                                                                         */
    NR_DciCommon_VrbPrbMapping_Type                 VrbPrbMapping             optional, /* VRB-to-PRB mapping */
    NR_DciFormat_4_X_SpecificInfo_Type              Format                    optional  /* DCI format and DCI format specific parameters */
  };

  type union NR_DciFormat_4_X_SpecificInfo_Type {
    NR_DciFormat_4_0_SpecificInfo_Type             Format_4_0
  };

  type record NR_DciFormat_4_0_SpecificInfo_Type {
    /* TS 38.212 clause 7.3.1.5.1: scheduling of PDSCH in one DL cell; default parameters according to TS 38.508-1 clause 4.3.6.1.5.1
       DCI format 4_0 is used for the scheduling in DL cell with CRC scrambled by MCCH-RNTI for MCCH or G-RNTI for MTCH broadcast configured by MBS-SessionInfo.
     */
    NR_McchChangeNotification_Type    McchChangeNotification optional   /* MCCH change notification - Set to None for MTCH */
  };

  type union NR_McchChangeNotification_Type {
    /* TS 38.212 clause 7.3.1.5.1:
       - 2 bits as defined in clause 5.9.1.3 of TS38.331 if the CRC of the DCI format 4_0 is scrambled by MCCH-RNTI.
       - Otherwise, this bit field is reserved.
     */
    Null_Type                           None,                   /* 0 bit */
    B2_Type                             Value                   /* 2 bits */
  };

  //MTCH
  type record of NR_MTCH_Config_Type NR_MTCH_ConfigList_Type;

  type union NR_MTCH_Config_Type {
    NR_MRB_Type                         AddOrReconfigure,                 /* To configure or reconfigure MTCH */
    Null_Type                           Release                           /* To remove MTCH completely  */
  };
 
  type record NR_MRB_Type {
    SDAP_Configuration_Type                 Sdap                optional, /* Local MRB Pdu_SessionId
                                                                           * No SDAP header DL/UL for MRB
                                                                           * Local MRB MappedQoS_Flows
                                                                           */
    NR_MRB_PDCP_ConfigBroadcast_Type        Pdcp                optional, /* DL only */
    NR_MRB_RLC_ConfigBroadcast_Type         Rlc                 optional, /* UM DL only */
    RNTI_Value_Type                         G_RNTI_r17          optional,
    NR_ASN1_PDSCH_ConfigBroadcast_Type      Pdsch_ConfigMTCH    optional, /* Set as according to TS 38.331 */
    NR_MBS_SearchSpaceDlDciAssignment_Type  SearchSpaceAndDci   optional  /* MTCH scheduling is assigned to CfrBwp BWP;
                                                                           * DCI format 4_0 is used for the scheduling of MTCH in DL cell with CRC scrambled by G-RNTI
                                                                           */
  };

 type record NR_MRB_PDCP_ConfigBroadcast_Type {
    NR_PDCP_SN_Size_Type                    SN_SizeDL           optional,
    NR_PDCP_DRB_HeaderCompression_Type      HeaderCompression   optional
 };

 type record NR_MRB_RLC_ConfigBroadcast_Type {
    NR_LogicalChannelId_Type                LogicalChannelId    optional,
    SN_FieldLengthUM                        Sn_FieldLength      optional
 };

 }  // End group MBS

  } // End group Cell_Configuration
  
  //****************************************************************************
  
  group Cell_Power_Attenuation {
  
  type record NR_CellAttenuationConfig_Type {
    NR_CellId_Type              CellId,
    NR_Attenuation_Type         Attenuation,
    TimingInfo_Type             TimingInfo            optional
  };
  
  type record of NR_CellAttenuationConfig_Type NR_CellAttenuationList_Type;
  
  } // End group Cell_Power_Attenuation
  
  //****************************************************************************
  
  group Radio_Bearer_Configuration {                            /* Radio Bearer Configuration: SRBs/DRBs
                                                                   NOTE: Type definitions for PDCP configuration are in NR_PDCP_TypeDefs */
  
  group RLC_Configuration {                                     /* RLC configuration: radio bearer specific */

  type enumerated NR_RLC_ACK_Prohibit_Type {                    /* As per 38.523-3 cl. 7.1.6.1 */
    Prohibit,                                                   /* cause SS RLC layer to stop any ACK transmission for UL PDUs received from UE */
    Continue                                                    /* bring back the SS RLC in normal mode, where ACK/NACK are transmitted at polling */
  };

  type enumerated NR_RLC_NotACK_NextRLC_PDU_Type {              /* As per 38.523-3 cl. 7.1.6.1 */
    Start                                                       /* cause SS RLC layer not to ACK the next received RLC PDU;
                                                                 * this is done regardless of whether the poll bit is set or not;
                                                                 * Example [from UMTS]:
                                                                 * when the UE gets new security information in a SECURITY MODE COMMAND
                                                                 * the response (SECURITY MODE COMPLETE) sent by the UE is not acknowledged at the RLC level;
                                                                 * this causes the UE to continue using the "old" security information */
  };

  type union NR_RLC_TransparentMode {
    SN_FieldLengthUM            Umd,                            /* SN-FieldLengthUM ::= ENUMERATED {size6, size12} TS 38.331 */
    SN_FieldLengthAM            Amd                             /* SN-FieldLengthAM ::= ENUMERATED {size12, size18} TS 38.331 */
  };

  type union NR_RLC_TestModeInfo_Type {
    NR_RLC_ACK_Prohibit_Type            AckProhibit,            /* valid only when the RLC is configured in AM */
    NR_RLC_NotACK_NextRLC_PDU_Type      NotACK_NextRLC_PDU,     /* valid only when the RLC is configured in AM */
    NR_RLC_TransparentMode              TransparentMode
  };

  type union NR_RLC_TestModeConfig_Type {
    Null_Type                   None,
    NR_RLC_TestModeInfo_Type    Info
  };

  type record NR_SS_RLC_AM_Type {
    NR_ASN1_UL_AM_RLC_Type      Tx                    optional, /* the UE's UL setting to be used in SS's tx direction */
    NR_ASN1_DL_AM_RLC_Type      Rx                    optional  /* the UE's DL setting to be used in SS's rx direction */
  };
  type record NR_SS_RLC_UM_Type {
    NR_ASN1_UL_UM_RLC_Type      Tx                    optional, /* the UE's UL setting to be used in SS's tx direction */
    NR_ASN1_DL_UM_RLC_Type      Rx                    optional  /* the UE's DL setting to be used in SS's rx direction */
  };

  type Null_Type NR_SS_RLC_TM_Type;                             /* TM to configure SRB0; no parameters to be defined */

  type union NR_RLC_RbConfig_Type {
    NR_SS_RLC_AM_Type           AM,
    NR_SS_RLC_UM_Type           UM,
    NR_SS_RLC_TM_Type           TM                              /* normally SRB0 only; may be used for test purposes also */
  };

  type record NR_RLC_Configuration_Type {
    NR_RLC_RbConfig_Type        Rb                    optional, /* mandatory for initial configuration; omit means "keep as it is" */
    NR_RLC_TestModeConfig_Type  TestMode              optional  /* mandatory for initial configuration; omit means "keep as it is" */
  };

  } // End sub-group RLC_Configuration

  //----------------------------------------------------------------------------

  group MAC_Configuration {                                     /* MAC configuration: radio bearer specific configuration */

  type UInt_Type NR_LogicalChannelId_Type;

  // Types for test mode configuration:
  type union NR_MAC_Test_DLLogChID_Type {
    NR_LogicalChannelId_Type    LogChId,        /* Specifies to overwrite the logical channel ID in MAC header in all the DL messages sent on the configured logical channel */
    Null_Type                   ConfigLchId     /* Specifies that the normal mode of correct logical channel ID to be used in DL MAC header.
                                                 * This will be the default mode, when SS is initially configured. */
  };

  type enumerated NR_MAC_Test_SCH_NoHeaderManipulation_Type {
    NormalMode,                 /* MAC header is fully controlled by the SS */
    DL_SCH_Only,                /* TTCN can submit a final MAC PDU including header and payloads;
                                 * SS does not do anything with this MAC PDU i.e. no header is added for the DL SCH transport channel.
                                 * It is possible that data belonging to multiple DRBs is sent in one MAC PDU and from one special RB configured.
                                 * NOTE: SRBs shall work as in normal mode and data can be sent/received on SRBs but sending on SRBs shall be in different TTIs than sending data PDUs. */
    DL_UL_SCH                   /* In UL and DL the SS' MAC layer is transparent i.e. SS does not add or remove any MAC header */
  };

  type record NR_MAC_TestModeInfo_Type {
    /* Parameters/Configuration for MAC tests */
    NR_MAC_Test_DLLogChID_Type                  DiffLogChId,            /* to be used in test cases 7.1.1.1 and 7.1.1.2 for using a different logical channel ID in MAC-header on DL-SCH channel */
    NR_MAC_Test_SCH_NoHeaderManipulation_Type   No_HeaderManipulation   /* to configure mode for no header manipulation in SS MAC layer for DL/UL SCH */
  };

  type union NR_MAC_TestModeConfig_Type {
    Null_Type                   None,
    NR_MAC_TestModeInfo_Type    Info
  };

  type record NR_MAC_LogicalChannelConfig_Type {
    integer                     Priority,                               /* logical channel priority for the DL as described in TS 38.321, clause 5.4.3.1 for the UL */
    NR_PrioritizedBitRate_Type  PrioritizedBitRate                      /* PBR as described for the UL; probably not needed at SS */
  };

  type record NR_MAC_Configuration_Type {
    NR_MAC_LogicalChannelConfig_Type    LogicalChannel    optional,     /* mandatory for initial configuration; omit means "keep as it is" */
    NR_MAC_TestModeConfig_Type          TestMode          optional      /* mandatory for initial configuration; omit means "keep as it is";
                                                                         * for none MAC tests "TestMode.None:=true" */
  };

  } // End sub-group MAC_Configuration

  //----------------------------------------------------------------------------

  type record NR_RlcBearerConfigInfo_Type {                     /* RLC bearer as defined in TS 37.340: RLC and MAC logical channel configuration of a radio bearer in one cell group */
    NR_RLC_Configuration_Type   Rlc                   optional, /* mandatory for initial configuration; omit means "keep as it is" */
    NR_LogicalChannelId_Type    LogicalChannelId      optional, /* DRBs: DTCH-LogicalChannelIdentity as for rb-MappingInfo in DRB-ToAddModifyList;
                                                                 * SRBs: for SRBs specified configurations according to TS 38.331 clause 9.2.1 shall be applied:
                                                                 * SRB1: ul-LogicalChannelIdentity = dl-LogicalChannelIdentity = 1
                                                                 * SRB2: ul-LogicalChannelIdentity = dl-LogicalChannelIdentity = 2
                                                                 * SRB3: ul-LogicalChannelIdentity = dl-LogicalChannelIdentity = 3
                                                                 * SRB4: ul-LogicalChannelIdentity = dl-LogicalChannelIdentity = 4, according to TS 38.508-1
                                                                 * for SRB0 being mapped to CCCH the SS shall apply
                                                                 * - LCID=0 for DL according to TS 38.321 Table 6.2.1-1
                                                                 * - LCID=0, 52, 35 or 36 for UL according to TS 38.321 Table 6.2.1-2 depending on whether it is a CCCH1 or a CCCH message;
                                                                 * For DRBs and SRBs - except SRB0: mandatory for initial configuration; omit means "keep as it is"
                                                                 * For SRB0 LogicalChannelId is always omit and the SS shall apply the LCIDs according to TS 38.321 */
    NR_MAC_Configuration_Type   Mac                   optional,
    boolean                     DiscardULData         optional  /* if omitted:
                                                                 *   initial configuration: data is handed over to TTCN as usual
                                                                 *   re-configuration:      "keep as it is"
                                                                 * if set:
                                                                 *   true  - SS shall discard any data in UL for this radio bearer
                                                                 *   false - (re)configuration back to normal mode
                                                                 * NOTE: typically applicable for UM DRBs only */
  };

  type union NR_RlcBearerConfig_Type {                          /* configuration of RLC bearer below NR-PDCP */
    NR_RlcBearerConfigInfo_Type Config,                         /* "normal" configuration: there is an RLC bearer configured for the cell which is linked to the PDCP being configured at the cell (the PDCP can be either 'RBTerminating' or 'Proxy') */
    Null_Type                   None                            /* No RLC bearer is configured at NR below the NR-PDCP:
                                                                 * NR_PDCP_Configuration_Type shall be 'RBTerminating' with LinkToOtherCellGroup indicating cell with RLC bearer to be used */
  };

  type record NR_RadioBearerConfigInfo_Type {
    SDAP_Configuration_Type     Sdap                  optional, /* omitted for EN-DC, otherwise mandatory for initial configuration;
                                                                 * omit means "keep as it is"
                                                                 * for SRBs: Sdap.None:=true */
    NR_PDCP_Configuration_Type  Pdcp                  optional, /* for SRB0: "Pdcp.None:=true"
                                                                 * mandatory for initial configuration; omit means "keep as it is" */
    NR_RlcBearerConfig_Type     RlcBearer             optional  /* mandatory for initial configuration; omit means "keep as it is" */
  };

  type union NR_RadioBearerConfig_Type {
    NR_RadioBearerConfigInfo_Type       AddOrReconfigure,       /* add / re-configure RB
                                                                 */
    Null_Type                           Release                 /* release RB
                                                                 */
  };

  type record NR_RadioBearer_Type {
    NR_RadioBearerId_Type       Id,                             /* either for SRB or DRB */
    NR_RadioBearerConfig_Type   Config
  };

  type record of NR_RadioBearer_Type NR_RadioBearerList_Type;    /* array of SRBs and/or DRBs.
                                                                  * TimingInfo: 'Now' in general;
                                                                  *   activation time may be used in special case for release and/or reconfiguration of one or several RBs;
                                                                  *   the following rules shall be considered:
                                                                  *     - release/Reconfiguration of an RB shall not be scheduled earlier than 5ms after a previous data transmission on this RB
                                                                  *     - subsequent release and reconfiguration(s) shall be scheduled with an interval of at least 5ms
                                                                  *     - a subsequent data transmission on an RB shall not be scheduled earlier than 5ms after the last reconfiguration of the RB
                                                                  * the configuration shall be performed exactly at the given time
                                                                  * ControlInfo : FollowOnFlag:=false (unless explicitly specified otherwise in TS 38.523-3 clause 7)
                                                                  */

  } // End group Radio_Bearer_Configuration

  //****************************************************************************

  group AS_Security {                                           /* Primitive for control of AS security */

  type record NR_PdcpSQN_Type {
    NR_PdcpCountFormat_Type   Format,                           /* 12 bit or 18 bit SQN */
    integer                   Value                             /* SQN value (12 bit or 18 bit SQN)
                                                                 * NOTE:
                                                                 * in TTCN the test case writer is responsible to deal with potential overflows
                                                                 * (e.g. there shall be a "mod 32", "mod 128" or "mod 4096" according to the format) */
  };

  type union NR_PDCP_ActTime_Type {
    /* The sequence number (SQN) in UL and DL for SRB1 should be one more than the present SQN, as Ciphering starts in UL and DL soon after SMC and SMComp;
     * For other SRB/DRB it should be the present SQN.
     * UL: (TS 38.323 cl.7.1) RX_NEXT = [RX_NEXT_HFN, RX_NEXT_SN]. The receiving PDCP entity in the SS shall start/restart the AS security protection when RX_NEXT_SN becomes equal to or higher than SQN;
     * DL: (TS 38.323 cl.7.1) TX_NEXT = [TX_NEXT_HFN, TX_NEXT_SN]. The transmitting PDCP entity in the SS shall start/restart the AS security protection when TX_NEXT_SN becomes equal to or higher than SQN. */
    Null_Type                   None,                           /* No Activation time; to be used if Ciphering is not applied */
    NR_PdcpSQN_Type             SQN                             /* PDCP sequence number */
  };

  type record NR_SecurityActTime_Type {
    NR_RadioBearerId_Type       RadioBearerId,
    NR_PDCP_ActTime_Type        UL,
    NR_PDCP_ActTime_Type        DL
  };

  type record of NR_SecurityActTime_Type NR_SecurityActTimeList_Type;

  type record NR_AS_IntegrityInfo_Type {
    /* for initial configuration activation time is not needed for integrity protection as all messages in DL after security activation are integrity protected;
     * this means this ASP is invoked before transmission of Security mode command;
     * if there is a integrity violation in UL SS shall set the IndicationStatus in the common ASP part to flag the integrity error
     * (IndicationStatus.Error.Integrity.Pdcp := true);
     * integrity to be provided for each SRB as per core spec */
    IntegrityProtAlgorithm      Algorithm,                      /* IntegrityProtAlgorithm being defined in RRC ASN.1 */
    B128_Key_Type               KRRCint,
    B128_Key_Type               KUPint      optional,           /* Not used when UE connected to EPS (i.e. set to omit for EPS, unless UPIP) */
    NR_SecurityActTimeList_Type ActTimeList optional            /* omit for initial configuration (i.e. all SRBs to be integrity protected immediately);
                                                                 * in HO scenarios activation time may be needed e.g. for SRB1 */
  };

  type record NR_AS_CipheringInfo_Type {
    CipheringAlgorithm          Algorithm,                      /* CipheringAlgorithm_Type being defined in RRC ASN.1 */
    B128_Key_Type               KRRCenc,
    B128_Key_Type               KUPenc,                         /* KUPenc is mandatory; and SS uses it when DRB are configured */
    NR_SecurityActTimeList_Type ActTimeList
  };
  
  type record NR_AS_SecStartRestart_Type {
    NR_AS_IntegrityInfo_Type    Integrity optional,             /* optional to allow separated activation of integrity and ciphering; omit: keep as it is */
    NR_AS_CipheringInfo_Type    Ciphering optional              /* optional to allow separated activation of integrity and ciphering; omit: keep as it is */
  };
  
  type union NR_AS_Security_Type {                              /* Security mode command procedure (TS 38.331, clause 5.3.4) */
    NR_AS_SecStartRestart_Type  StartRestart,                   /* information to start/restart AS security protection in the PDCP
                                                                 * TimingInfo : 'Now' (in general)
                                                                 *   NOTE: "activation time" may be specified in the primitive based on PDCP SQN
                                                                 */
    Null_Type                   Release                         /* to release AS security protection in the PDCP
                                                                 * (if any; if there is no AS security the SS does not need to do anything)
                                                                 * TimingInfo : 'Now' (in general)
                                                                 *   NOTE: "activation time" may be specified in the primitive based on PDCP SQN
                                                                 */
  };
  
  } // End group AS_Security
  
  //****************************************************************************
  
  group Semi_Persistent_Scheduling {

  } // End group Semi_Persistent_Scheduling
  
  //****************************************************************************
  
  group Paging_Trigger {
  

  type record length (1..infinity) of integer NR_SlotOffsetList_Type;
  
  type record NR_PagingTrigger_Type {                           /* to trigger transmission of a paging message on the PCCH at a calculated paging occasion (TS 38.304, clause 7);
                                                                 * the paging occasion is calculated by TTCN and activation time is applied
                                                                 * TimingInfo : Calculated paging occasion
                                                                 */
    PCCH_Message                Paging,                         /* paging to be send out at paging occasion and being announced on PDCCH using P-RNTI
                                                                 * SS shall add the necessary padding bits as specified in TS 38.331, clause 8.5 */
    NR_SlotOffsetList_Type      SlotOffsetList optional         /* list of slot offsets relative to the absolute timing information given in the common part of the ASP;
                                                                 * if present, multiple pagings are sent out at all occasions given by the list;
                                                                 * if omitted only a single paging is sent at the occasion given by the timing information in the common part of the ASP
                                                                 */
  };
  
  } // End group  Paging_Trigger
  
  //****************************************************************************
  
  group Delta_Value_Trigger {
  
  type record NR_Band_SsbForDelta_Type {                        /* Primary and secondary bands for requesting Delta values
                                                                 * CellId: nr_Cell_NonSpecific
                                                                 * TimingInfo : 'Now'
                                                                 */
    Band_SsbInfo_Type   DeltaPrimary,
    Band_SsbInfo_Type   DeltaSecondary
  };
  
  type record Band_SsbInfo_Type {                               /* Band and CD-SSB Frequency value for which Delta values are requested */
    FreqBandIndicatorNR         DeltaBand,
    NR_ASN1_ARFCN_ValueNR_Type  Ssb_NRf1 optional,
    NR_ASN1_ARFCN_ValueNR_Type  Ssb_NRf2 optional,
    NR_ASN1_ARFCN_ValueNR_Type  Ssb_NRf3 optional,
    NR_ASN1_ARFCN_ValueNR_Type  Ssb_NRf4 optional
  };
  
  } // End group Delta_Value_Trigger

  //****************************************************************************

  group System_Indication_Control {                             /* Primitive for control of system indications for special purposes */
  
  type record NR_System_IndicationControl_Type {                /* Initially all indications apart from "Error" are disabled in SS
                                                                   (i.e. it shall not be necessary in 'normal' test cases to use this primitive but only if a specific indication is needed);
                                                                   omit means indication mode is not changed.
                                                                   TimingInfo : 'Now' (in general)
                                                                 */
    IndicationAndControlMode_Type       RLC_Discard           optional, /* To enable/disable reporting of discarded RLC PDUs */
    IndicationAndControlMode_Type       MAC_BSR               optional, /* To enable/disable reporting of short/long BSR */
    IndicationAndControlMode_Type       MAC_PHR               optional, /* To enable/disable reporting of short/long PHR */
    IndicationAndControlMode_Type       RachPreamble          optional, /* To enable/disable reporting of PRACH preamble */
    IndicationAndControlMode_Type       SchedReq              optional, /* To enable/disable reporting of Scheduling Request */
    IndicationAndControlMode_Type       UL_HARQ               optional, /* To enable/disable reporting of reception of HARQ ACK/NACK */
    IndicationAndControlMode_Type       HarqError             optional, /* To enable/disable reporting of HARQ errors */
    IndicationAndControlMode_Type       RecommendedBitRate    optional, /* To enable/disable reporting of Recommended bit rate MAC CE received in UL MAC PDU */
    IndicationAndControlMode_Type       UL_SRB0_LCID          optional, /* To enable/disable reporting of Logical Channel Id used in UL SRB0 MAC subPDU */
    IndicationAndControlMode_Type       MAC_SL_BSR            optional, /* To enable/disable reporting of sidelink BSR */
    IndicationAndControlMode_Type       MAC_SL_CG_Confirmation  optional,  /* To enable/disable reporting of sidelink Configured Grand Confirmation */
    IndicationAndControlMode_Type       MAC_PosMeasGap        optional, /* To enable/disable reporting of Positioning Measurement Gap Activation/Deactivation request */
    IndicationAndControlMode_Type       LBT_Failure           optional, /* To enable/disable reporting of LBT Failure */
    IndicationAndControlMode_Type       MAC_UL_TA_Report      optional  /* To enable/disable reporting of Timing Advance */
  };

  } // End group System_Indication_Control

  //****************************************************************************
  
  group PDCP_Count {                                            /* Primitives to enquire PDCP COUNT */

  type enumerated NR_PdcpCountFormat_Type {
    PdcpCount_Srb,                      /* 20 bit HFN; 12 bit SQN */
    PdcpCount_DrbSQN12,                 /* 20 bit HFN; 12 bit SQN */
    PdcpCount_DrbSQN18                  /* 14 bit HFN; 18 bit SQN */
  };
  type record NR_PdcpCount_Type {
    NR_PdcpCountFormat_Type   Format,
    PdcpCountValue_Type       Value
  };
  type record NR_PdcpCountInfo_Type {
    NR_RadioBearerId_Type     RadioBearerId,
    NR_PdcpCount_Type         UL  optional,     /* omit: keep as it is */
    NR_PdcpCount_Type         DL  optional      /* omit: keep as it is */
  };
  
  type record of NR_PdcpCountInfo_Type NR_PdcpCountInfoList_Type;
  
  type union NR_PdcpCountGetReq_Type {
    Null_Type                 AllRBs,   /* return COUNT values for all RBs being configured with Pdcp.RBTerminating in the NR Cell. */
    NR_RadioBearerId_Type     SingleRB
  };
  
  type union NR_PDCP_CountReq_Type {
    NR_PdcpCountGetReq_Type   Get,      /* Request PDCP count for one or all RBs being configured at the PDCP
                                           TimingInfo: 'Now'
                                         */
    NR_PdcpCountInfoList_Type Set       /* Set PDCP count for one or all RBs being configured at the PDCP;
                                         * list for RBs which's COUNT shall be manipulated
                                         * TimingInfo: 'Now' (in general)
                                         *   activation time may be used in case of CA inter cell handover to set the PdcpCount
                                         */
  };
  
  type union NR_PDCP_CountCnf_Type {
    NR_PdcpCountInfoList_Type Get,      /* RBs in ascending order; SRBs first */
    Null_Type                 Set
  };
  
  } // End group PDCP_Count
  
  //****************************************************************************
  
  group PDCP_Handover {                                         /* Primitives to control PDCP regarding handover */
  
  type record NR_PDCP_HandoverInit_Type {
    NR_CellId_Type                         SourceCellId
  };

  type union NR_PDCP_HandoverControlReq_Type {
    NR_PDCP_HandoverInit_Type              HandoverInit,        /* to inform SS that a handover (or PSCell change) will follow, for SS handling of PDCP context from the source cell to the target cell.
                                                                 * CellId : In the common ASP part the CellId shall be set to the id of the target cell
                                                                 * TimingInfo : 'Now'
                                                                 */
    Null_Type                              HandoverComplete     /* to inform SS that the handover (or PSCell change) has successfully been performed by the UE;
                                                                 * this shall trigger the SS to send a PDCP Status Report on AM DRB(s) to the UE;
                                                                 * CellId : the CellId shall be set to the id of the target cell
                                                                 * TimingInfo : 'Now'
                                                                 */
  };
  
  } // End group PDCP_Handover

  //****************************************************************************
  
  group L1_Test_Mode {          /* Primitive for control of L1 Test Modes */
  
  type record NR_L1_TestMode_Type {  /* TimingInfo : depends on the test mode; activation time is used e.g. for manipulation of the CRC */
    NR_DL_SCH_CRC_Type                  DL_SCH_CRC                      /* Manipulation of CRC bit generation for DL-SCH */
  };
  
  type enumerated NR_MAC_Test_DL_SCH_CRC_Mode_Type {
    Normal,                     /* default mode, the CRC generation is correct */
    Erroneous,                  /* SS shall generate CRC error by toggling CRC bits;
                                 * the CRC error shall be applied for all PDUs of the given RNTI and their retransmission until SS is configured back to 'normal' operation */
    Error1AndNormal             /* the SS generates wrong CRC for first transmission and correct CRC on first retransmission.
                                 * Later SS operates in normal mode. The retransmission is automatically triggered by reception of HARQ NACK */
  };

  type union NR_DL_SCH_CRC_Type {                                       /* NOTE:
                                                                         * CRC error mode for RA_RNTI is not addressed as it will be configured in RACHProcedureConfig */
    NR_MAC_Test_DL_SCH_CRC_Mode_Type    C_RNTI,                         /* to configure mode for CRC bit for all MAC PDUs for which C-RNTI is used in PDCCH transmission */
    NR_MAC_Test_DL_SCH_CRC_Mode_Type    SI_RNTI,                        /* to configure mode for CRC bit for all MAC PDUs for which SI-RNTI is used in PDCCH transmission */
    NR_MAC_Test_DL_SCH_CRC_Mode_Type    CS_RNTI,                        /* to configure mode for CRC bit for all MAC PDUs for which CS-RNTI is used in PDCCH transmission */
    NR_MAC_Test_DL_SCH_CRC_Mode_Type    G_RNTI,                         /* to configure mode for CRC bit for all MAC PDUs for which G-RNTI is used in PDCCH transmission */
    NR_MAC_Test_DL_SCH_CRC_Mode_Type    MCCH_RNTI                       /* to configure mode for CRC bit for all MAC PDUs for which MCCH-RNTI is used in PDCCH transmission */
  };

  } // End group L1_Test_Mode
  
  //****************************************************************************
  
  group DCI_Trigger {                                           /* Primitive to trigger SS to send specific DCI (e.g. PDCCH order) which is not associated with any PDSCH or PUSCH transmission */
  
  type record NR_DCI_Trigger_Type {                             /* TimingInfo : 'Now' or specific activation time */
    NR_AssignedBWPs_Type                AssignedBWPs,           /* BWP which shall be used to schedule the DCI */
    NR_SearchSpaceType_Type             SearchSpaceType,        /* search space to be used for sending of given DCI;
                                                                   the SS may raise an error when there is no such search space at the scheduled point in time */
    NR_DCI_TriggerFormat_Type           DciFormat
  };

  //----------------------------------------------------------------------------

  type union NR_DCI_TriggerFormat_Type {
    NR_PDCCH_Order_Type                    PdcchOrder,
    NR_DciWithShortMessageOnly_Type        ShortMessage,
    NR_DciFormat_2_0_Type                  DciFormat_2_0,
    NR_DciFormat_2_1_Type                  DciFormat_2_1,
    NR_DciFormat_2_2_Type                  DciFormat_2_2,
    NR_DciFormat_2_3_Type                  DciFormat_2_3,
    NR_DciFormat_2_6_Type                  DciFormat_2_6,
    NR_DciFormat_2_7_Type                  DciFormat_2_7,
    NR_DciFormat_2_9_Type                  DciFormat_2_9,
    NR_DciFormat_1_1_NoDLAssignment_Type   DciFormat_1_1_NoDLAssignment  /* to trigger a DCI without DL assignment as per 38.214 clause 5.1.5 */
  };

  //----------------------------------------------------------------------------

  type record NR_DciWithShortMessageOnly_Type {                 /* "stand-alone" DCI with CRC scrambled by P-RNTI with no PCCH-Message being associated;
                                                                   => all fields apart from the ones listed in this record are reserved
                                                                   (see TS 38.212 clause 7.3.1.2.1) */
    B2_Type                             ShortMessageIndicator,  /* Short Message Indicator according to TS 38.212 Table 7.3.1.2.1-1;
                                                                   to be set to '10'B indicating that only short message is present in the DCI */
    B8_Type                             ShortMessages,          /* Short Messages according to TS 38.331 Table 6.5-1 */
    NR_SlotOffsetList_Type              SlotOffsetList optional /* list of slot offsets relative to the absolute timing information given in the common part of the ASP;
                                                                   if present, multiple short messages are sent out at all occasions given by the list;
                                                                   if omitted only a single short message is sent at the occasion given by the timing information in the common part of the ASP */
  };
  
  //----------------------------------------------------------------------------

  type record NR_PDCCH_Order_Type {                   /* PDCCH order according to TS 38.212 clause 7.3.1.2.1 to initiate RA procedure (TS 38.321, clause 5.1.1):
                                                         DCI format 1_0 with CRC scrambled by C-RNTI and the "Frequency domain resource assignment" field are of all ones */
    B6_Type                                           RA_PreambleIndex,       /* ra-PreambleIndex according to TS 38.321 clause 5.1.2 */
    NR_DciCommon_UL_SUL_Indicator_Type                UL_SUL_Indicator,       /* indicates which UL carrier in the cell to transmit the PRACH if the UE is configured with SUL in the cell and RA_PreambleIndex != '000000'B;
                                                                                 "None" otherwise */
    B6_Type                                           SSB_Index,              /* indicates the SS/PBCH that shall be used to determine the RACH occasion for the PRACH transmission if RA_PreambleIndex != '000000'B;
                                                                                 '000000'B (reserved) otherwise */
    B4_Type                                           PrachMaskIndex,         /* indicates the RACH occasion associated with the SS/PBCH indicated by "SS/PBCH index" for the PRACH transmission, according to TS 38.321 clause 5.1.1;
                                                                                 '0000'B (reserved) otherwise */
    NR_PDCCH_Order_CellIndicator_Type                 CellIndicator,                /* Cell indicator */
    NR_PDCCH_Order_PRACH_AssociationIndicator_Type    PRACH_AssociationIndicator,   /* PRACH association indicator  */
    NR_PDCCH_Order_PRACH_RetransmissionIndicator_Type PRACH_RetransmissionIndicator /* PRACH retransmission indicator */
  };

  type union NR_PDCCH_Order_CellIndicator_Type {  /* 38.212 clause 7.3.1.2.1 - Cell indicator */
    Null_Type                 None,               /* 0 bits */
    bitstring                 Value               /* Cell indicator - When UE is configured with EarlyUlSyncConfig */
  };
  
  type union NR_PDCCH_Order_PRACH_AssociationIndicator_Type { /* 38.212 clause 7.3.1.2.1 - PRACH association indicator */
    Null_Type                 None,      /* 0 bits */
    B1_Type                   Value      /* 1 bit - When UE is configured with tag2-Id */
  };
  
  type union NR_PDCCH_Order_PRACH_RetransmissionIndicator_Type {/* 38.212 clause 7.3.1.2.1 - PRACH retransmission indicator */
    Null_Type                 None,      /* 0 bits */
    B1_Type                   Value      /* 1 bit - When UE is configured with EarlyUlSyncConfig */
  };
  
  //----------------------------------------------------------------------------

  type record of bitstring NR_DciFormat_2_0_SfiList_Type;       /* list of SFI-indexes as used as slotFormatCombinationId in SlotFormatCombination (see TS 38.331):
                                                                   Each index addresses the SlotFormatCombination for a serving cell in SlotFormatCombinationsPerCell (the position is given by 'positionInDCI');
                                                                   the size of each SFI-index depends on the maximum value of slotFormatCombinationIds (maxSFIindex) in the sequence of SlotFormatCombinations:
                                                                   SFI-index-length = MAX(CEIL(log2(maxSFIindex+1)), 1); see TS 38.213 clause 11.1.1;
                                                                   !!!! NR OPEN ISSUE: it is not fully clear whether the maximum slotFormatCombinationId is determined per Cell or over all cells !!!!
                                                                   !!!! ASSUMPTION: it is per cell and therefore different SFI-indexes may use bitstrings of different length !!!! */

  type record NR_DciFormat_2_0_Type {                           /* TS 38.212 clause 7.3.1.3.1: for notifying the slot format;
                                                                   default parameters according to TS 38.508-1 clause 4.3.6.1.3.1 */
    NR_DciFormat_2_0_SfiList_Type       SfiList
  };

  //----------------------------------------------------------------------------

  type record length (1..9) of B14_Type NR_DciFormat_2_1_IntValueList_Type;             /* list of 14 bit INT values per serving cell (see DownlinkPreemption, INT-ConfigurationPerServingCell in TS 38.331 and TS 38.213 clause 11.2) */

  type record NR_DciFormat_2_1_Type {                           /* TS 38.212 clause 7.3.1.3.2: notifying the PRB(s) and OFDM symbol(s) where UE may assume no transmission is intended for the UE;
                                                                   default parameters according to TS 38.508-1 clause 4.3.6.1.3.2 */
    NR_DciFormat_2_1_IntValueList_Type  IntValueList
  };

  //----------------------------------------------------------------------------

  type record NR_DciFormat_2_2_ClosedLoopIndicator_Type {       /* TS 38.212 clause 7.3.1.3.3: Closed loop indicator */
    Null_Type                           None,                   /* 0 bit if the UE is not configured with higher layer parameter twoPUSCH-PC-AdjustmentStates */
    B1_Type                             Index                   /* 1 bit otherwise */
  };

  type union NR_DciFormat_2_2_TpcBlock_Type {                   /* TS 38.212 clause 7.3.1.3.3: single TPC block */
    NR_DciFormat_2_2_ClosedLoopIndicator_Type           ClosedLoopIndicator,
    NR_DciCommon_TpcCommand_Type                        TpcCommand
  };

  type record of NR_DciFormat_2_2_TpcBlock_Type NR_DciFormat_2_2_TpcBlockList_Type;     /* list of TPC blocks according to TS 38.212 clause 7.3.1.3.3;
                                                                                           beginning of each block is configured at the UE by tpc-IndexPCell or tpc-IndexPUCCH-SCell for PUCCH and by tpc-Index or tpc-IndexSUL for PUCCH
                                                                                           (see PUCCH-TPC-CommandConfig and PUSCH-TPC-CommandConfig in TS 38.331 and TS 38.213 clause 11.3) */

  type record NR_DciFormat_2_2_Type {                           /* TS 38.212 clause 7.3.1.3.3: for the transmission of TPC commands for PUCCH and PUSCH;
                                                                   default parameters according to TS 38.508-1 clause 4.3.6.1.3.3 */
    NR_DciFormat_2_2_TpcBlockList_Type  TpcBlockList
  };

  //----------------------------------------------------------------------------

  type record NR_DciFormat_2_3_SrsRequest_Type {                /* TS 38.212 clause 7.3.1.3.4: according to TS 38.213 clause 11.4 the presence of SRS request(s) depends on fieldTypeFormat2-3 (see SRS-TPC-CommandConfig in TS 38.331) */
    Null_Type                           None,                   /* 0 bit: no SRS request */
    B2_Type                             SrsRequestValue         /* 2 bits: Index of the SRS resource set to be used according to TS 38.212 Table 7.3.1.1.2-24 */
  };
  
  type record of NR_DciCommon_TpcCommand_Type NR_DciCommon_TpcCommandList_Type;


  type record NR_DciFormat_2_3_TypeA_Type {                     /* TS 38.212 clause 7.3.1.3.4: srs-TPC-PDCCH-Group = typeA (see SRS-CarrierSwitching in TS 38.331) */
    NR_DciFormat_2_3_SrsRequest_Type    SrsRequest,
    NR_DciCommon_TpcCommandList_Type    TpcCommandList
  };

  type record NR_DciFormat_2_3_SingleBlockTypeB_Type {          /* TS 38.212 clause 7.3.1.3.4: srs-TPC-PDCCH-Group = typeB (see SRS-CarrierSwitching in TS 38.331) */
    NR_DciFormat_2_3_SrsRequest_Type    SrsRequest,
    NR_DciCommon_TpcCommand_Type        TpcCommand
  };

  type record of NR_DciFormat_2_3_SingleBlockTypeB_Type NR_DciFormat_2_3_TypeB_Type;

  type union NR_DciFormat_2_3_TypeA_B_Type {
    NR_DciFormat_2_3_TypeA_Type         TypeA,                  /* Type-A as indicated in srs-TPC-PDCCH-Group (see SRS-CarrierSwitching in TS 38.331) */
    NR_DciFormat_2_3_TypeB_Type         TypeB                   /* Type-B as indicated in srs-TPC-PDCCH-Group (see SRS-CarrierSwitching in TS 38.331) */
  };

  type record NR_DciFormat_2_3_Type {                           /* TS 38.212 clause 7.3.1.3.4: for the transmission of a group of TPC commands for SRS transmissions by one or more UEs;
                                                                   default parameters according to TS 38.508-1 clause 4.3.6.1.3.4 */
    NR_DciFormat_2_3_TypeA_B_Type       TypeA_B
  };
      
  //----------------------------------------------------------------------------
        
   type record NR_DciFormat_2_6_Block_Type {
      B1_Type                                        WakeupIndication,
      NR_DciCommon_SCellDormancyIndication_Type      SCellDormancyIndication
      
  }
      
   type record of NR_DciFormat_2_6_Block_Type NR_DciFormat_2_6_Block_List_Type;
    
   type record NR_DciFormat_2_6_Type {          /* TS 38.212 clause 7.3.1.3.7: DCI format 2_6 is used for notifying
                                                 * the power saving information outside DRX Active Time for one or more UEs*/
      NR_DciFormat_2_6_Block_List_Type     BlockList
  }
     
  //----------------------------------------------------------------------------
  type union NR_DciFormat_2_7_TRS_Indication_Type {
    Null_Type   None,                           /* 0 bit no TRS availability indication */
    bitstring   Value                           /* 1, 2, 3, 4, 5, or 6 bits, being the number of bits equal to one plus the highest value of all the indBitID(s) provided by the trs-ResourceSetConfig if configured */
  }

  type record NR_DciFormat_2_7_Type {           /*  TS 38.212 clause 7.3.1.3.8: DCI format 2_7 is used for notifying the paging early indication and TRS availability indication for one or more UEs */
    bitstring                               PagingIndication,
    NR_DciFormat_2_7_TRS_Indication_Type    TRSAvailabilityIndication,
    integer                                 PayloadSizeDCI_2_7              /* If the number of information bits obtained from PagingIndication + TRSAvailabilityIndication is less than the size of format 2_7, the SS shall set the remaining bits as reserved bits (set to 0).*/
  }
 
  type union NR_DciFormat_2_9_CellDTXDRX_Indication_Type {
    Null_Type     None,              /* 0 bit - higher layer parameter cellDTXDRX-L1activation is not configured */
    B1_Type       DtxOrDrx,          /* 1 bit as defined in clause 11.5 of TS 38.213 if cellDTXDRXconfigType is configured */
    B2_Type       DtxAndDrx          /* 2 bits with the MBS corresponding to cell DTX configuration and the LSB corresponding to cell DRX configuration */
  };

  type union NR_DciFormat_NesEvent_Indication_Type {
    Null_Type          None,         /* 0 bit - higher layer parameter nesEvent-r18 is not configured */
    B1_Type            NesEvent      /* 1 bit - higher layer parameter nesEvent-r18 configured */
  };

  type record NR_DciFormat_2_9_Block_Type {
    NR_DciFormat_2_9_CellDTXDRX_Indication_Type    CellDTXDRX_Indication    optional,
    NR_DciFormat_NesEvent_Indication_Type          NesEvent_Indication      optional
  };

  type record of NR_DciFormat_2_9_Block_Type NR_DciFormat_2_9_Block_List_Type;

  type record NR_DciFormat_2_9_Type {   /* TS 38.212 clause 7.3.1.3.9: DCI format 2_9 is used for activating or de-activating
                                         * the cell DTX and/or DRX configuration of one or multiple serving cells
                                         * for one or more UEs, and/or for providing NES-mode indication
                                         * of the primary cell for one or more UEs
                                         */
    NR_DciFormat_2_9_Block_List_Type     BlockList
  };

  type record NR_DciFormat_1_1_NoDLAssignment_Type     {
  /* The SS shall further set the DCI_1_1 fields as per 38.214 cluse 5.1.5
   * - CS-RNTI is used to scramble the CRC for the DCI
   * - The values of the following DCI fields are set as follows:
   *    - RV = all '1's
   *    - MCS = all '1's
   *    - NDI = 0
   *    - Set to all '0's for FDRA Type 0, or all '1's for FDRA Type 1, or all '0's for dynamicSwitch (same as in Table 10.2-4 of [6, TS 38.213]).
   */
   NR_DciFormat_1_1_TCI_Type            TCI    /* the TCI value desired */
  };

  } // End group DCI_Trigger
  
  //****************************************************************************
  
  group Configured_Scheduling {                                 /* Primitive for control of DL SPS assignment and UL Configured Grant Type 2 configuration  */

  type union NR_SPS_CG_ActDeact_Type {
    NR_SpsCgActivateInfo_Type           Activate,               /* CellId : identifier of the cell where the UE is active
                                                                 * RoutingInfo : None
                                                                 * RlcBearerRouting : 'None'
                                                                 * TimingInfo : activation time for DL SPS assignment or UL configured grant type 2 transmission;
                                                                 * ControlInfo : CnfFlag:=false; FollowOnFlag:=false
                                                                 */
    NR_SpsCgDeactivateInfo_Type         Deactivate              /* CellId : identifier of the cell where the UE is active
                                                                 * RoutingInfo : None
                                                                 * RlcBearerRouting : 'None'
                                                                 * TimingInfo : activation time for DL SPS assignment or UL configured grant type 2 release indicated by PDCCH transmission or SS local deactivation
                                                                 * ControlInfo : CnfFlag:=false; FollowOnFlag:=false
                                                                 */
  };

  type record NR_SpsCgActivateInfo_Type {                       /* Even though DL SPS assignment or UL configured grant type 2 is pre-configured at the UE, it needs to be activated by L1 signalling
                                                                 * => SS shall 'activate' DL SPS assignment or UL configured grant type 2  by sending appropriate assignments/grants to the UE; this shall be done with an activation time.
                                                                 * If DL SPS assignment or UL configured grant type 2 is already configured and new Activate command is received, with ConfigIndex not included (i.e. Rel-15 operation),
                                                                 * at the activation time SS locally deactivates old configuration, sends UE a PDCCH assignment for new DL SPS assignment or UL configured grant type 2 and locally activates new SPS configuration.
                                                                 * In DL, in addition to SS SPS assignment configuration with activation time 'T', TTCN writer shall also schedule a DL MAC PDU with same activation time 'T' and at every DL assignment periodicity
                                                                 * (NOTE: in general it is an error when TTCN does not provide data for a periodicity; SS shall send no data in this case). The SS sends the MAC PDU in 'T+ PDSCH slot offset (K0)' */
    NR_UL_ConfiguredGrant_Type          UplinkConfiguredGrant optional,
    NR_DL_SpsAssignment_Type            DownlinkSpsAssignment optional
  };
  
  type record NR_UL_ConfiguredGrant_Type {                                  /* information to assign UL configured grant type schedules in UL */
    NR_DciUlInfo_Type                   DciInfo optional,                   /* to apply an UL grant */
    Null_Type                           SetNDI_1 optional,                  /* if present then NDI is set as 1 indicating a retransmission; If absent then NDI is set as 0 indicating a new transmission */
    ConfiguredGrantConfigIndex_r16    ConfiguredGrantConfigIndex  optional  /* if not present SS shall follow Rel-15 operation. If present indicates Rel-16 or later operation and as per TS 38.213 clause 10.2 SS shall use this value in HARQ process ID field in DCI */
  };
  
  type record NR_DL_SpsAssignment_Type {                          /* information to assign semi-persistent scheduling in DL */
    NR_DciDlInfo_Type                   DciInfo optional,         /* to apply a DL assignment */
    Null_Type                           SetNDI_1 optional,        /* if present then NDI is set as 1 indicating a retransmission; If absent then NDI is set as 0 indicating a new transmission */
    SPS_ConfigIndex_r16                 SPS_ConfigIndex optional  /* if not present SS shall follow Rel-15 operation. If present indicates Rel-16 or later operation and as per TS 38.213 clause 10.2 SS shall use this value in HARQ process ID field in DCI */
  };

  type enumerated NR_SPS_CG_ReleasePdcchDciFormat_Type {        /* DCI format to be used for DL SPS assignment and UL configured grant type 2 acc. to TS 38.213, Table 10.2-X*/
    dci_0_0,
    dci_0_1,
    dci_0_2,
    dci_1_0,
    dci_1_1,
    dci_1_2
  };

  type union NR_SpsCgDeactivateInfo_Type {
    Null_Type                           LocalRelease,           /* DL SPS assignment and UL configured grant type 2 configuration shall be released at the SS, that means as well that the SS shall not address CS-RNTI anymore from the given TimingInfo onward;
                                                                 * NOTE: there is no DL SPS or UL configured grant type 2 release to be signalled on PDCCH (this is done with PdcchExplicitRelease - see below) */
    NR_SPS_CG_ReleasePdcchDciFormat_Type PdcchExplicitRelease,  /* SS transmits PDCCH content indicating DL SPS assignment or UL configured grant type 2 release but holds the local configuration until it is locally released */
    NR_PdcchExplicitRelease_Extn_Type PdcchExplicitRelease_Extn /* Indicates Rel-16 or later operation. SS transmits PDCCH content indicating DL SPS assignment or UL configured grant type 2 release but holds the local configuration until it is locally released */
  };

  type record NR_PdcchExplicitRelease_Extn_Type {
    NR_SPS_CG_ReleasePdcchDciFormat_Type    DciFormat,
    SPS_ConfigIndex_r16                     SPS_ConfigIndex optional,               /* Explicit release of DL SPS grant with config index; SS shall use this config index as HARQ process ID in DCI, ref TS 38.213 clause 10.2 */
    ConfiguredGrantConfigIndex_r16          ConfiguredGrantConfigIndex  optional    /* Explicit release of UL configured grant type 2 with config index; SS shall use this config index as HARQ process ID in DCI, ref TS 38.213 clause 10.2 */
  };

  } // End group Configured_Scheduling

  //****************************************************************************
  
  group System_Indications {                                    /* Primitives for System indications */

  type record NR_HarqProcessInfo_Type {
    NR_HarqProcessId_Type               Id
  };
  
  type union NR_HarqError_Type {
    NR_HarqProcessInfo_Type             UL,                     /* indicates HARQ error detected at the SS side (error at UL transmission) */
    NR_HarqProcessInfo_Type             DL                      /* indicates HARQ NACK sent by the UE (error at DL transmission) */
  };
  
  type record NR_RachPreamble_Type {
    integer                             RAPID                   /* indicates the RAPID of the preamble (integer (0..63)) */
  };

  type record NR_RlcDiscardInd_Type {                           /* SS shall send this indication if it discards a received RLC AMD PDU as specified in TS 38.322 cl. 5.2.3.2.2 */
    integer                             SequenceNumber          /* sequence number of the PDU being discarded */
  };

  } // End group System_Indications
  
  //****************************************************************************
  
  group System_Interface {
  
  type record NR_SYSTEM_CTRL_REQ {
    NR_ReqAspCommonPart_Type    Common,         /* Unless specified otherwise for a particular primitive, the following applies:
                                                 * CellId: identifier of the cell
                                                 * RoutingInfo : 'None'
                                                 * RlcBearerRouting : 'None'
                                                 * MacBearerRouting : 'omit'
                                                 * TimingInfo : 'Now' or specific activation time, depends on respective primitive
                                                 * ControlInfo :
                                                 *   CnfFlag:        depends on TimingInfo; in general 'false' when specific activation time is used, 'true' for 'Now'
                                                 *   FollowOnFlag   'false'
                                                 */
    NR_SystemRequest_Type       Request
  };

  type record NR_SYSTEM_CTRL_CNF {
    NR_CnfAspCommonPart_Type    Common,         /* TimingInfo is ignored by TTCN (apart from EnquireTiming)
                                                 * => SS may set TimingInfo to "None" */
    NR_SystemConfirm_Type       Confirm
  };

  type record NR_SYSTEM_IND {
    NR_IndAspCommonPart_Type    Common,         /* CellId : identifier of the cell
                                                 * RoutingInfo : 'none'
                                                 * RoutingInfoSUL: 'omit'
                                                 * RlcBearerRouting : 'none'
                                                 * MacBearerRouting : 'omit'
                                                 * TimingInfo : The SS shall provide TimingInfo depending on the respective indication (see below) */
    NR_SystemIndication_Type    Indication      /* - Error
                                                 *   TimingInfo: related to the error (if available)
                                                 * - RlcDiscardInd
                                                 *   TimingInfo: slot in which the RLC PDU has been received
                                                 * - MAC
                                                 *   TimingInfo: slot in which the MAC PDU has been received containing the MAC CE being indicated
                                                 * - RachPreamble
                                                 *   TimingInfo: start of the RACH preamble
                                                 * - SchedReq
                                                 *   TimingInfo: slot containing the SR
                                                 * - UL_HARQ
                                                 *   TimingInfo: slot containing the UL HARQ
                                                 * - HarqError
                                                 *   TimingInfo: slot containing the UL HARQ
                                                 * - UL_SRB0_LCID
                                                 *   TimingInfo: slot in which the MAC PDU has been received containing the UL SRB0 MAC subPDU
                                                 */
  };

  type port NR_SYSTEM_PORT message {            /* NR PTC: Port for system configuration */
    out NR_SYSTEM_CTRL_REQ;
    in  NR_SYSTEM_CTRL_CNF;
  };

  type port NR_SYSIND_PORT message {            /* NR PTC: Port for system indications */
    in  NR_SYSTEM_IND;
  };

  // Used in default behaviour
  template (present) NR_SYSTEM_CTRL_CNF cr_NR_SYSTEM_CTRL_CNF_Any := ?;        /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  template (present) NR_SYSTEM_IND      cr_NR_SYSTEM_IND_Any := ?;             /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  } // End group System_Interface
}
