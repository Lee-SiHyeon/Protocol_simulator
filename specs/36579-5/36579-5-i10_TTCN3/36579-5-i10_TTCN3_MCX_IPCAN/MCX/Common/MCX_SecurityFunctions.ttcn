module MCX_SecurityFunctions {

  import from CommonDefs all;
  import from MCX_CommonDefs all;

  type record ECCSI_SskPvtPair_Type {                           /* return type for fx_ECCSI_GenerateSskPvtPair
                                                                   @status    APPROVED (MCX) */
    octetstring SSK,
    octetstring PVT
  };

  type enumerated HASH_Function_Type {                          /* @status    APPROVED (MCX) */
    SHA_256
  };

  type enumerated XML_EncryptionMethod_Type {                   /* @status    APPROVED (MCX) */
    AES_128_GCM,        // AES-GCM according to clause 5.2.4 of https://www.w3.org/TR/xmlenc-core1/ with 96 bit Initialization Vector (IV) and 128 bit Authentication Tag (T)
    AES_256_KEY_WRAP    // according to RFC 3394
  };

  type enumerated AEAD_EncryptionMethod_Type {                  /* @status    APPROVED (MCX) */
    AEAD_AES_128_GCM,   // RFC 5116 clause 5.1
    AEAD_AES_256_GCM    // RFC 5116 clause 5.2
  };

  const integer tsc_SAKKE_ParameterSet1 := 1;           /* "parameter set 1" according to appendix A of RFC 6509
                                                           @status    APPROVED (MCX) */

  const integer tsc_SAKKE_ECCSI_SignatureLength := 129; /* RFC 6507 clause 3.3: total signature length of 4N+1 octets with N = Ceiling(lg(p)/8) and p as according to clause 4.1
                                                           @status    APPROVED (MCX) */

  /*
   * @desc      Convert integer of any size into octet string
   *            => the length of the octetstring depends on the size of the integer
   * @param     p_Val
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_KDF_IntegerEncoding(integer p_Val) return octetstring
  {
    var integer v_Val := p_Val;
    var integer n := 0;
    
    do {
      v_Val := v_Val / 256;
      n := n + 1;
    } while (v_Val > 0);

    return int2oct(p_Val, n);
  }

  /*
   * @desc      generic function for generate the concatenated octetstring for key derivation functions (33.220):
   *            FC & P1 & L1 & .. & Pn & Ln
   * @param     p_FC
   * @param     p_P
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_KDF_ConcatenateParameters(octetstring p_FC,
                                       OctetStringList_Type p_P) return octetstring
  {
    var octetstring v_S;
    var integer i;

    v_S := p_FC;
    for (i := 0; i < lengthof(p_P); i := i + 1) {
      v_S := v_S & p_P[i] & int2oct(lengthof(p_P[i]), 2);
    }
    return v_S;
  }

  external function fx_SAKKE_GeneratePublicKey(octetstring p_MasterSecret,
                                               integer p_ParameterSet := tsc_SAKKE_ParameterSet1)
    return octetstring;

  external function fx_SAKKE_GenerateRSK(octetstring p_MasterSecret,
                                         octetstring p_Identifier,
                                         integer p_ParameterSet := tsc_SAKKE_ParameterSet1)
    return octetstring;

  external function fx_SAKKE_EncapsulateKey(O16_Type p_SSV,
                                            octetstring p_SakkePublicKey,
                                            octetstring p_UID,
                                            integer p_ParameterSet := tsc_SAKKE_ParameterSet1) return octetstring;

  external function fx_SAKKE_ExtractKey(octetstring p_EncapsulatedData,
                                        octetstring p_SakkeRSK,
                                        octetstring p_SakkePublicKey,
                                        octetstring p_UID,
                                        integer p_ParameterSet := tsc_SAKKE_ParameterSet1) return template (omit) O16_Type;

  external function fx_ECCSI_GenerateKPAK(octetstring p_KSAK) return octetstring;

  external function fx_ECCSI_GenerateSskPvtPair(octetstring p_UID,
                                                octetstring p_KSAK,
                                                octetstring p_KPAK,
                                                integer p_EphemeralValue) return template (omit) ECCSI_SskPvtPair_Type;

  /*
   * @desc      Wrapper function for fx_ECCSI_GenerateSskPvtPair
   * @param     p_UID
   * @param     p_KSAK
   * @param     p_KPAK
   * @param     p_EphemeralValue
   * @return    ECCSI_SskPvtPair_Type
   * @status    APPROVED (MCX)
   */
  function f_ECCSI_GenerateSskPvtPair(octetstring p_UID,
                                      octetstring p_KSAK,
                                      octetstring p_KPAK,
                                      integer p_EphemeralValue) return ECCSI_SskPvtPair_Type
  {
    var template (omit) ECCSI_SskPvtPair_Type v_SskPvtPair := fx_ECCSI_GenerateSskPvtPair(p_UID, p_KSAK, p_KPAK, p_EphemeralValue);
    
    if (not isvalue(v_SskPvtPair)) {
      FatalError(__FILE__, __LINE__, "generation of (SSK,PVT) requires other value for v");
    }
    return valueof(v_SskPvtPair);
  }

  external function fx_ECCSI_SignMessage(octetstring p_Message,
                                         octetstring p_KPAK,
                                         octetstring p_UID,
                                         octetstring p_SSK,
                                         octetstring p_PVT,
                                         integer p_EphemeralValue) return template (omit) octetstring;

  /*
   * @desc      Wrapper function
   * @param     p_Message
   * @param     p_KPAK
   * @param     p_UID
   * @param     p_SSK
   * @param     p_PVT
   * @param     p_EphemeralValue
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_ECCSI_SignMessage(octetstring p_Message,
                               octetstring p_KPAK,
                               octetstring p_UID,
                               octetstring p_SSK,
                               octetstring p_PVT,
                               integer p_EphemeralValue) return octetstring
  {
    var template (omit) octetstring v_Signature := fx_ECCSI_SignMessage(p_Message, p_KPAK, p_UID, p_SSK, p_PVT, p_EphemeralValue);

    if (not isvalue(v_Signature)) {
      FatalError(__FILE__, __LINE__, "generation of signature requires other value for j");
    }
    return valueof(v_Signature);
  }

  external function fx_ECCSI_VerifySignature(octetstring p_Message,
                                             octetstring p_Signature,
                                             octetstring p_KPAK,
                                             octetstring p_UID) return boolean;

  external function fx_XML_Encrypt(octetstring p_Data,
                                   XML_EncryptionMethod_Type p_Method,
                                   bitstring p_Key,
                                   octetstring p_IV)
    return octetstring;

  /*
   * @desc      Wrapper function for XML key encryption according to 33.180 clause 9.3.4.2:
   *            According to 33.180 AES Key Wrap shall be used (-> RFC 3394 AES Key Wrap Algorithm)
   * @param     p_Data          .. Key to be encrypted; any length
   * @param     p_Key           .. XML Protection Key (XPK) according to 33.180 clause 9.3.3;
   *                               depending on which connection the encryption is applied, the XPK is either CSK (128 bits), SPK (128 bits) or TrK (256 bits, clause 7.2.3)
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_XML_EncryptKey(octetstring p_Data,
                                bitstring p_Key) return octetstring
  {
    var octetstring v_IV := 'A6A6A6A6A6A6A6A6'O;    // initial vector for AES Key Wrap according to section 2.2.3.1 of RFC 3394 and section 5.7.2 in https://www.w3.org/TR/xmlenc-core1/
    var integer v_DataLength := lengthof(p_Data);
    var integer v_BlockSize := 8;                   // block size according to RFC 3394: 64 bits
    var integer v_PaddingSize := v_BlockSize - (v_DataLength mod v_BlockSize);
    var octetstring v_Padding := substr('0000000000000000'O, 0, v_PaddingSize - 1);   // arbitrary padding octets
    var octetstring v_Data := p_Data & v_Padding & int2oct(v_PaddingSize, 1);         // padding according to https://www.w3.org/TR/xmlenc-core1/ clause 5.2.1

    return fx_XML_Encrypt(v_Data, AES_256_KEY_WRAP, p_Key, v_IV);
  }

  external function fx_XML_Decrypt(octetstring p_Data,
                                   XML_EncryptionMethod_Type p_Method,
                                   bitstring p_Key,
                                   octetstring p_IV)
    return octetstring;

  external function fx_AEAD_Encrypt(octetstring p_Data,
                                    octetstring p_AssociatedData,
                                    AEAD_EncryptionMethod_Type p_Method,
                                    bitstring p_Key,
                                    octetstring p_IV)
    return octetstring;

  external function fx_AEAD_Decrypt(octetstring p_Data,
                                    octetstring p_AssociatedData,
                                    AEAD_EncryptionMethod_Type p_Method,
                                    bitstring p_Key,
                                    octetstring p_IV)
    return octetstring;

  external function fx_MCX_XML_AddEnvelopedSignature(universal charstring p_XmlDocument,
                                                     bitstring p_Key) return universal charstring;

  external function fx_MCX_XML_CreateDetachedSignature(universal charstring p_XmlDocument,
                                                       universal charstring p_SignatureInfo,
                                                       bitstring p_Key) return universal charstring;

  external function fx_XML_GetElementContent(universal charstring p_XmlBranch,
                                             charstring p_XpathExpression) return universal charstring;

  external function fx_XML_SetElementContent(universal charstring p_XmlBranch,
                                             charstring p_XpathExpression,
                                             universal charstring p_NewContent) return universal charstring;

  external function fx_SHA_2(HASH_Function_Type p_Function,
                             octetstring p_Data)
    return octetstring;

  type enumerated JWK_HashAlgorithm_Type {                      /* RFC 7515
                                                                   @status    APPROVED (MCX) */
    HS256,      // HMAC SHA-256
    RS256       // RSASSA-PKCS1-v1_5 SHA-256
  };

  external function fx_JWK_Signature(charstring p_String,
                                     JWK_HashAlgorithm_Type p_Algorithm,
                                     octetstring p_Key) return charstring;

  /*
   * @desc      Generate 256 bit UID according to 33.180 F.2.1
   * @param     p_Identifier                    .. e.g. MCPTT ID as contained in id token
   * @param     p_KSM_Id                        .. KMS Identifier (URI of the KMS)
   * @param     p_KeyPeriodLength               .. Key Period length in seconds as specified in the KMS certificate
   * @param     p_KeyPeriodOffset               .. Key Period offset in seconds as specified in the KMS certificate
   * @param     p_KeyPeriodNo                   .. Current Key Period No. as specified in KMS Key Set:
   *                                               Floor ( ( TIME - P4 ) / P3 ) with TIME being NTP timestamp (see 33.180 F.2.1)
   * @return    octetstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIKEY_SAKKE_GenerateUID(charstring p_Identifier,
                                         charstring p_KSM_Id,
                                         integer p_KeyPeriodLength,
                                         integer p_KeyPeriodOffset,
                                         integer p_KeyPeriodNo)
    return octetstring
  {
    var octetstring v_FC := '00'O;   // Dummy
    var OctetStringList_Type v_P;
    var octetstring v_S;

    v_P[0] := char2oct("MIKEY-SAKKE-UID");
    v_P[1] := char2oct(p_Identifier);
    v_P[2] := char2oct(p_KSM_Id);
    v_P[3] := f_KDF_IntegerEncoding(p_KeyPeriodLength);
    v_P[4] := f_KDF_IntegerEncoding(p_KeyPeriodOffset);
    v_P[5] := f_KDF_IntegerEncoding(p_KeyPeriodNo);

    v_S := f_KDF_ConcatenateParameters(v_FC, v_P);

    return fx_SHA_2(SHA_256, v_S);
  }

  /*
   * @desc      Calculation of the User Salt for GUK-ID generation (33.180 annex F.1.3 and clause 5.2.3)
   * @param     p_MCServiceId
   * @param     p_K
   * @return    B28_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CalculateUserSaltForGUKID(charstring p_MCServiceId,
                                           octetstring p_K) return B28_Type
  {
    var octetstring v_FC := '50'O;
    var OctetStringList_Type v_P;
    var bitstring v_Key := oct2bit(p_K);
    var octetstring v_S;
    var bitstring v_DerivedKey;

    v_P[0] := char2oct(p_MCServiceId);
    v_S := f_KDF_ConcatenateParameters(v_FC, v_P);
    v_DerivedKey := fx_KeyDerivationFunction(tsc_KDF_HMAC_SHA_256, v_Key, v_S);

    return f_Bitstring_LeastSignificantBits(v_DerivedKey, 28); // The 28 least significant bits of the 256 bits of the KDF output shall be used as the User Salt
  }

  /*
   * @desc      Calculation of the GUK-ID generation (33.180 clause 5.2.3)
   * @param     p_MCServiceId
   * @param     p_GMK
   * @return    B32_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_CalculateGUKID(charstring p_MCServiceId,
                                MCX_SecurityKey_Type p_GMK) return B32_Type
  {
    var B28_Type v_Salt := f_MCX_CalculateUserSaltForGUKID(p_MCServiceId, p_GMK.Value);   /* 33.180 F.1.3: Calculate salt */
    var B32_Type v_GUK_ID := substr(p_GMK.Id, 0, 4) & (f_Bitstring_LeastSignificantBits(p_GMK.Id, 28) xor4b v_Salt);
    
    return v_GUK_ID;
  }

  const octetstring tsc_MCX_FC_Confidentiality := '51'O;        /* @status    APPROVED (MCX) */

  const octetstring tsc_MCX_FC_Integrity       := '52'O;        /* @status    APPROVED (MCX) */

  /*
   * @desc      Generate key used for signalling protection derived from the XPK (33.180 annex F.1.4)
   * @param     p_XPK                           .. key used by the KDF
   * @param     p_FC                            .. 0x51 (for signalling plane confidentiality) or 0x52 (for signalling plane integrity)
   * @param     p_MCServiceID
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_XML_GenerateProtectionKey(MCX_SecurityKey_Type p_XPK,
                                           octetstring p_FC,
                                           charstring  p_MCServiceID)
    return bitstring
  {
    var octetstring v_S;
    var OctetStringList_Type v_P;
    var bitstring v_Key := oct2bit(p_XPK.Value);
    var bitstring v_DerivedKey;
    var integer v_KeyLength;

    v_P[0] := char2oct(p_MCServiceID);
    v_P[1] := bit2oct(p_XPK.Id);

    v_S := f_KDF_ConcatenateParameters(p_FC, v_P);
    v_DerivedKey := fx_KeyDerivationFunction(tsc_KDF_HMAC_SHA_256, v_Key, v_S);
    v_KeyLength := lengthof(v_Key);

    return substr(v_DerivedKey, 256 - v_KeyLength, v_KeyLength);    // p_XPK is either 128 or 256 bit => protection key has the same length
  }

  /*
   * @desc      Generate key used for payload protection derived from the DPPK (33.180 annex F.1.5)
   * @param     p_DPPK
   * @param     p_EncryptionMethod
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCData_GenerateProtectionKey(MCX_SecurityKey_Type p_DPPK,
                                              AEAD_EncryptionMethod_Type p_EncryptionMethod)
    return bitstring
  {
    var octetstring v_FC := '53'O;
    var octetstring v_S;
    var OctetStringList_Type v_P;
    var bitstring v_Key := oct2bit(p_DPPK.Value);
    var bitstring v_DerivedKey;
    var integer v_KeyLength;

    v_P[0] := bit2oct(p_DPPK.Id);

    v_S := f_KDF_ConcatenateParameters(v_FC, v_P);
    v_DerivedKey := fx_KeyDerivationFunction(tsc_KDF_HMAC_SHA_256, v_Key, v_S);

    select (p_EncryptionMethod) {
      case (AEAD_AES_128_GCM) { v_KeyLength := 128; }
      case (AEAD_AES_256_GCM) { v_KeyLength := 256; }
    }

    return substr(v_DerivedKey, 256 - v_KeyLength, v_KeyLength);
  }

}
