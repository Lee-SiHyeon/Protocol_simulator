  template (value) MCData_UEConfiguration_Type cs_MCData_UEConfiguration :=
  { /* 36.579-1 Table 5.5.8.10-1: MCData UE Configuration Defaults */
    /* @status    APPROVED (MCX) */
    instance_ID_URN := omit,
    xUI_URI := omit,
    domain := px_MCX_DomainName_Organization_A,
    attr := omit,
    choice_list := {},
    common := {
      index := omit,
      attr := omit,
      short_data_service := {
        max_Simul_SDS_Txns_Nc4 := 2,
        sDS_Presentation_Priority := {
          mCData_Group_Priority_list := {
            cs_MCData_SDS_Priority(px_MCData_Group_A_ID, 7)
          }
        }
      },
      file_distribution := {
        max_Simul_FD_Txns_Nc4 := 4,
        fD_Presentation_Priority := {
          mCData_Group_Priority_list := {
            cs_MCData_FD_Priority(px_MCData_Group_A_ID, 7)
          }
        }
      },
      conversation_management := {
        conversation_Presentation_Priority := {
          mCData_Group_Priority_list := {
            cs_MCData_Conversation_Priority(px_MCData_Group_A_ID, 7)
          }
        }
      },
      transmission_control := {
        max_Simul_Data_Transmissions_Nc4 := 3,
        max_Data_Transmissions_In_Group_Nc5 := 3,
        data_Presentation_Priority := {
          mCData_Group_Priority_list := {
            cs_MCData_TransmissionControl_Priority(px_MCData_Group_A_ID, 7)
          }
        }
      },
      reception_control := {
        max_Simul_Data_Reception_Nc4 := 3,
        max_Data_Receptions_In_Group_Nc5 := 5
      }
    },
    on_network := {
      index := omit,
      attr := omit,
      iPv6Preferred := false,
      relay_Service := true,
      relayed_MCData_Group := cs_Relayed_MCData_Group(px_MCData_Group_A_ID, "123456"),
      anyExt := omit,
      elem_list := {}
    },
    anyExt := {
      elem_list := {}
    },
    elem_list := {}
  };

  /*
   * @desc      Encode MCData UE configuration document
   * @param     p_MCData_UEConfiguration
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_MCData_UEConfiguration_Encode(template (value) urn_3gpp_mcdata_mcdataUEConfig_1_0.Mcdata_UE_configuration p_MCData_UEConfiguration) return bitstring
  {
    return encvalue(p_MCData_UEConfiguration);
