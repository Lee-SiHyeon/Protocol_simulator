  };

  template (value) UplinkPowerControlCommonSCell_r10 cs_UplinkPowerControlCommonSCell :=
  { /* acc. to 36.508 Table 4.6.3-25A */
    /* @status    APPROVED (LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
