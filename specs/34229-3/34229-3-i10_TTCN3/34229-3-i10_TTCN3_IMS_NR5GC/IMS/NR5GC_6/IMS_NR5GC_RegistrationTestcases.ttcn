module IMS_NR5GC_RegistrationTestcases {

  import from CommonDefs all;
  import from EUTRA_NR_Parameters all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CC_Authentication all;
  import from IMS_CC_CommonFunctions all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_IP_Config all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_RegistrationCommon all;
  import from IMS_SIP_Templates all;
  import from IMS_XML_Templates all;
  import from LibSip_SIPTypesAndValues all;
  import from NR_Parameters all;
  import from UpperTesterFunctions all;

  const boolean tsc_IMS_PublishDuringSubscribeForRegEvent := true;      /* @status    APPROVED (IMS) */

  /*
   * @desc      Creates complete XmlMessage for NotifyTerminated
   * @param     p_RegisterRequest
   * @param     p_Version           (default value: 1)
   * @return    template (value) Reginfo_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_XmlMessageForNotify_Terminated(REGISTER_Request p_RegisterRequest,
                                                integer p_Version := 1) runs on IMS_PTC return template (value) Reginfo_Type
  {
    var CharStringList_Type v_PublicUserIdList := f_IMS_PTC_ImsInfo_GetAllIMPUs();
    var template (value) RegInfo_RegistrationList_Type v_RegistrationList;

    v_RegistrationList[0] := f_XML_RegistrationInfo(p_RegisterRequest, v_PublicUserIdList[0],   "a100", "980", terminated, deactivated);
    v_RegistrationList[1] := f_XML_RegistrationInfo(p_RegisterRequest, px_IMS_AssociatedTelUri, "a101", "981", terminated, deactivated, -, -, v_PublicUserIdList[0]);
    v_RegistrationList[2] := f_XML_RegistrationInfo(p_RegisterRequest, v_PublicUserIdList[1],   "a102", "982", terminated, deactivated);
    v_RegistrationList[3] := f_XML_RegistrationInfo(p_RegisterRequest, v_PublicUserIdList[2],   "a103", "983", terminated, deactivated);
    return f_XML_RegInfo(full, p_Version, v_RegistrationList);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.1.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_1_NR5GC_IMS1() runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var integer v_RetryAfterForPublish := 60;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2 - 5" siclog@
    v_IMS_REGISTER_REQ := f_IMS_Register_NonGIBA();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2, 4");

    // @siclog "Step 6 - 9" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ, tsc_IMS_PublishDuringSubscribeForRegEvent, v_RetryAfterForPublish);   /* tsc_IMS_PublishDuringSubscribeForRegEvent: optional parallel behaviour (Table 6.1.3.2-2)
                                                                                                                                v_RetryAfterForPublish=60 according to Table 6.1.3.3-10 (referring to 34.229-1 clause A.4.2);
                                                                                                                                in contrast to 34.229-1 Annex C.5 where Retry-after is set to 7200 */
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6, 9");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      Check that Cseq has been incremented for subsequent initial REGISTER requests (condition A1)
   * @param     p_RegisterReq
   * @param     p_PrevCseq          (default value: omit)
   * @return    integer
   * @status    APPROVED (IMS)
   */
  function fl_TC_6_2_CheckGetCseq(REGISTER_Request p_RegisterReq,
                                  template (omit) integer p_PrevCseq := omit) runs on IMS_PTC return integer
  { /* to check that Cseq has been incremented for subsequent initial REGISTER requests (condition A1)
       NOTE: for 'normal' subsequent REGISTER requests (condition A2) this is checked automatically */
    var integer v_Cseq := p_RegisterReq.msgHeader.cSeq.seqNumber;
    if (isvalue(p_PrevCseq)) {
      if (v_Cseq != valueof(p_PrevCseq) + 1) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Cseq has not been incremented by 1");
      }
    }
    return v_Cseq;
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.2.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_2_NR5GC_IMS1() runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var REGISTER_Request v_RegisterReq;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var template (omit) RetryAfter v_RetryAfterForREGISTER;
    var integer v_RetryAfterForPublish := 60;    // as per "503 Service Unavailable" default message contents (34.229-1 A.4.2),
    var integer v_NumOfIPAddressesToAllocate := 2;   // @sic R5s210720 sic@
    var charstring v_RegisterExpiration;
    var integer v_Cseq;

    timer t_Timer;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security, -, -, v_NumOfIPAddressesToAllocate);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);

    // @siclog "Step 3" siclog@
    v_RetryAfterForREGISTER := omit;
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine503, f_IMS_CommonResponse_503_MessageHeaderTX(v_RegisterReq.msgHeader, v_RetryAfterForREGISTER))));

    f_IMS_CC_ReleaseConnection(IPCAN_InitialRegistration);
    f_IMS_RestartPCSCF(PDN_1, px_IPv4_Address_Other, px_IPv6_Address_Other);  /* @sic R5-213534: support of 2nd P-CSCF, R5-217830 sic@
                                                                             NOTE: IP addresses need to be consistent with what is used as 2nd P-CSCF at NAS signalling */
    f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);
    
    // @siclog "Step 4" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);                // @sic R5s221319 sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    // @siclog "Step 5" siclog@
    v_RetryAfterForREGISTER := cs_RetryAfter(10);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine503, f_IMS_CommonResponse_503_MessageHeaderTX(v_RegisterReq.msgHeader, v_RetryAfterForREGISTER))));
    t_Timer.start(f_IMS_SetTimerToleranceMin(10.0));                      /* @sic R5s210720: timer to be started before RRC connection release sic@ */
    f_IMS_CC_ReleaseConnection(IPCAN_MO_IMS_Signalling);

    f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);

    // @siclog "Step 6" siclog@
    t_Timer.timeout;                                                      /* @sic R5s210720: t_Timer.start/stop instead of f_Delay sic@ */
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);                // @sic R5s221319 sic@
    v_Cseq := fl_TC_6_2_CheckGetCseq(v_RegisterReq);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    // @siclog "Step 7" siclog@
    v_RegisterExpiration := "800000";
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine423, f_IMS_RegisterResponse_423_MessageHeaderTX(v_RegisterReq, v_RegisterExpiration))));
    
    // @siclog "Step 8" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest(-, -, -, v_RegisterExpiration);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);                // @sic R5s221319 sic@
    fl_TC_6_2_CheckGetCseq(v_RegisterReq, v_Cseq);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9" siclog@
    f_IMS_Register_SecurityInit(v_RegisterReq);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq))));
    
    // @siclog "Step 10" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest(-, -, -, -, v_RegisterExpiration);
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;

    // @siclog "Step 11" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq, -, v_RegisterExpiration))));

    // @siclog "Step 12 - 15" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ, tsc_IMS_PublishDuringSubscribeForRegEvent, v_RetryAfterForPublish);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      Initial Registration process for TS 34.229-1 clause 6.3.NR5GC
   * @param     p_TestProcedure
   * @param     p_TRegExpireMin
   * @param     p_TRegExpireMax
   * @param     p_Expires
   * @param     p_TimerVal
   * @status    APPROVED (IMS)
   */
  function fl_TC_6_3_InitialRegistration(IMS_TestProcedure_Type p_TestProcedure,
                                         timer p_TRegExpireMin,
                                         timer p_TRegExpireMax,
                                         charstring p_Expires,
                                         float p_TimerVal) runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;

    f_IMS_CC_StartSignalling(p_TestProcedure);

    // @siclog "A.2 Step 1 - 4" siclog@
    v_IMS_REGISTER_REQ := f_IMS_Register_NonGIBA(-, -, p_Expires);
    p_TRegExpireMin.start(f_IMS_SetTimerToleranceMin(p_TimerVal));
    p_TRegExpireMax.start(f_IMS_SetTimerToleranceMax(p_TimerVal));
    
    // @siclog "A.2 Step 5 - 8" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ, tsc_IMS_PublishDuringSubscribeForRegEvent);
    f_IMS_CC_ReleaseConnection(p_TestProcedure);
  }

  /*
   * @desc      Re-Registration, steps for for TS 34.229-1 clause 6.3.NR5GC
   * @param     p_TRegExpireMin
   * @param     p_TRegExpireMax
   * @param     p_NonceCount
   * @param     p_StatusCode
   * @param     p_PrevSecurityClientParams (default value: omit)
   * @param     p_RegisterExpire    (default value: omit)
   * @status    APPROVED (IMS)
   */
   function fl_TC_6_3_ReRegistration(timer p_TRegExpireMin,
                                    timer p_TRegExpireMax,
                                    integer p_NonceCount,
                                    integer p_StatusCode,
                                    template (omit) SecurityClientParams_Type p_PrevSecurityClientParams := omit,
                                    template (omit) charstring p_RegisterExpire := omit) runs on IMS_PTC
  { /* @sic R5s201611 Change 3: p_RegisterExpire sic@ */
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var REGISTER_Request v_RegisterReq;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var charstring v_Expires;
    var float v_TimerVal;
    var SipUrl v_ContactUrl;
    var template (value) RegInfo_RegistrationList_Type v_RegistrationList;
    var charstring v_PublicUserId;

    f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);
    
    v_IMS_REGISTER_REQ := f_IMS_PTC_ReRegistration_WaitForRegistration(p_TRegExpireMin, p_TRegExpireMax, p_NonceCount, p_RegisterExpire);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);

    if (isvalue(p_PrevSecurityClientParams)) {
      f_IMS_PTC_ReRegistration_SecurityClientParamsCheck(v_RegisterReq, valueof(p_PrevSecurityClientParams));
    }

    select (p_StatusCode) {
      case (500) {
        // @siclog "Step 11" siclog@
        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine500, f_IMS_CommonResponse_500_MessageHeaderTX(v_RegisterReq.msgHeader))));
      }
      case (200) {
        // @siclog "Step 21" siclog@
        v_Expires := "1600";
        v_TimerVal := 1000.0;
        p_TRegExpireMin.start(f_IMS_SetTimerToleranceMin(v_TimerVal));
        p_TRegExpireMax.start(f_IMS_SetTimerToleranceMax(v_TimerVal));

        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq, -, v_Expires))));
      }
      case (423) {
        // @siclog "Step 23" siclog@
        v_Expires := "800000";
        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine423, f_IMS_RegisterResponse_423_MessageHeaderTX(v_RegisterReq, v_Expires))));

        // @siclog "Step 24" siclog@
        v_IMS_REGISTER_REQ :=  f_IMS_REGISTER_SubsequentRequest(-, -, -, p_NonceCount+1, v_Expires);
        v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
        v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;

        // @siclog "Step 25" siclog@
        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq, -, v_Expires))));

        // @siclog "Step 26 - 27" siclog@
        v_Expires := "60";
        v_TimerVal := 30.0;
        p_TRegExpireMin.start(f_IMS_SetTimerToleranceMin(v_TimerVal));
        p_TRegExpireMax.start(f_IMS_SetTimerToleranceMax(v_TimerVal));

        v_ContactUrl := f_MessageHeader_GetContactSipUrl(v_RegisterReq.msgHeader);
        v_PublicUserId := f_IMS_PTC_ImsInfo_GetUriString(firstId);
        v_RegistrationList := { f_XML_RegistrationInfo(v_RegisterReq, v_PublicUserId, "a100", "980", -, shortened, str2int(v_Expires)) };
        f_IMS_Register_Notify(v_ContactUrl, f_XML_RegInfo(partial, 1, v_RegistrationList));
      }
      case (401) {
        // @siclog "Step 29" siclog@
        f_IMS_Register_SecurityInit(v_RegisterReq, not4b tsc_IMS_AuthRAND);                     // => 2nd security context
        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq))));
        // @siclog "Step 30" siclog@
        v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest(-, -, -, -, p_RegisterExpire);   // nonce-count starts from 1 again
        v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
        v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;

        // @siclog "Step 31" siclog@
        IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));
      }
    }
    f_IMS_CC_ReleaseConnection(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.3.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_3_NR5GC_IMS1() runs on IMS_PTC
  {
    var SecurityClientParams_Type v_SecurityClientParams;
    var charstring v_Expires;
    var float v_TimerVal;
    var integer v_NonceCount;
    var integer v_StatusCode;
    var integer v_NumOfIPAddressesToAllocate := 2;    /* @sic R5-244794/R5s240470: NG session establishment with 2nd P-CSCF sic@ */

    timer t_TRegExpireMin;
    timer t_TRegExpireMax;
    
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security, -, -, v_NumOfIPAddressesToAllocate);    /* @sic R5-244794/R5s240470: NG session establishment with 2nd P-CSCF sic@ */

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1 - 9" siclog@
    v_Expires := "120";
    v_TimerVal := 60.0;
    fl_TC_6_3_InitialRegistration(IPCAN_InitialRegistration, t_TRegExpireMin, t_TRegExpireMax, v_Expires, v_TimerVal);
    
    // @siclog "Step 10 - 11" siclog@
    v_NonceCount := 2;
    v_StatusCode := 500;
    v_SecurityClientParams := f_IMS_PTC_ReRegistration_SecurityClientParamsGet();
    fl_TC_6_3_ReRegistration(t_TRegExpireMin, t_TRegExpireMax, v_NonceCount, v_StatusCode, v_SecurityClientParams);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    f_IMS_GlobalRelease();
    f_IMS_RestartPCSCF(PDN_1, px_IPv4_Address_Other, px_IPv6_Address_Other);    /* @sic R5-244794/R5s240470: 2nd P-CSCF - px_IPv4_Address_Other, px_IPv6_Address_Other as used in f_NR5GC_PDUSessionEstablishment_InnerLoop sic@ */

    // @siclog "Step 12 - 19" siclog@
    v_Expires := "360";
    v_TimerVal := 180.0;
    fl_TC_6_3_InitialRegistration(IPCAN_MO_IMS_Signalling, t_TRegExpireMin, t_TRegExpireMax, v_Expires, v_TimerVal);   // @sic R5s201611 Change 2: IPCAN_MO_IMS_Signalling sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    
    // @siclog "Step 20 - 21" siclog@
    v_NonceCount := 2;
    v_StatusCode := 200;
    v_SecurityClientParams := f_IMS_PTC_ReRegistration_SecurityClientParamsGet();
    fl_TC_6_3_ReRegistration(t_TRegExpireMin, t_TRegExpireMax, v_NonceCount, v_StatusCode, v_SecurityClientParams);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    // @siclog "Step 22 - 27" siclog@
    v_NonceCount := 3;
    v_StatusCode := 423;
    v_SecurityClientParams := f_IMS_PTC_ReRegistration_SecurityClientParamsGet();
    fl_TC_6_3_ReRegistration(t_TRegExpireMin, t_TRegExpireMax, v_NonceCount, v_StatusCode, v_SecurityClientParams);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 22");

    // @siclog "Step 28 - 31" siclog@
    v_NonceCount := 5;
    v_StatusCode := 401;
    v_Expires := "800000";
    fl_TC_6_3_ReRegistration(t_TRegExpireMin, t_TRegExpireMax, v_NonceCount, v_StatusCode, -, v_Expires);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 28");

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble();    // @sic R5s201611: no test procedure as connection is already released in fl_TC_6_3_ReRegistration sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.4.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_4_NR5GC_IMS1() runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var SipUrl v_ContactUrl;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2 - 9" siclog@
    v_IMS_REGISTER_REQ := f_IMS_Registration();
    f_IMS_CC_ReleaseConnection(IPCAN_InitialRegistration);

    // @siclog "Step 10 - 12" Void siclog@

    // @siclog "Step 13 - 14"
    f_IMS_CC_StartSignalling(IPCAN_MT_IMS_Signalling);
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE();
    f_IMS_Register_Notify(v_ContactUrl, f_IMS_XmlMessageForNotify_Terminated(v_IMS_REGISTER_REQ.Request.Register), cs_SubscriptionState_Terminated);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 14");

    f_IMS_GlobalRelease();   /* @sic R5s210666: no change of public user ids according to R5-212127 sic@ */

    // @siclog "Step 15 - 22" siclog@
    f_IMS_Registration();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 15 - 22");
    f_IMS_CC_ReleaseConnection(IPCAN_MT_IMS_Signalling);


    if (pc_data_centric) {                // @sic R5-222046 sic@
      // @siclog "Step 23a1" siclog@
      f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);
      f_UT_IMS_Deregister(MMI);

      // @siclog "Step 23a2 - 23a8" siclog@
      f_IMS_Deregistration();
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23a2 - 23a8");
    }

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_Deregistration); // @sic R5s211495 sic@
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.6.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_6_NR5GC_IMS1() runs on IMS_PTC
  { /* @sic R5-205217: steps 3 and 4 removed sic@ */
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var REGISTER_Request v_RegisterReq;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var SecurityClientParams_Type v_SecurityClientParams;
    var integer v_NonceCount;
    var boolean v_IMS_SMSoverIMS := false;
    var ContactAddress v_ContactAddress;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_REGISTERED, IMS_Security);

    f_IMS_TestBody_Set(true);

    v_SecurityClientParams := f_IMS_PTC_ReRegistration_SecurityClientParamsGet();

    f_IMS_CC_StartSignalling(IPCAN_MO_IMS_Signalling);

    // @siclog "Step 1" siclog@
    f_UT_IMS_SMSusingIMS(MMI, 0);        // Turn off SMSoverIMS by using AT command +CASIMS (27.007 clause 8.72)

    // @siclog "Step 2" siclog@
    v_NonceCount := 2;
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest(-, -, -, v_NonceCount, -, v_IMS_SMSoverIMS);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_ContactAddress := v_RegisterReq.msgHeader.contact.contactBody.contactAddresses[0];

    if (isvalue(v_ContactAddress.contactParams)) {
      if (match(v_ContactAddress.contactParams, cr_SMSParamInContactParams)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2: Contact header still contains '+g.3gpp.smsip'");
      }
    }
    f_IMS_PTC_ReRegistration_SecurityClientParamsCheck(v_RegisterReq, v_SecurityClientParams);

    // @siclog "Step 3 - 4" Void siclog@

    // @siclog "Step 5" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));
    
    // @sic R5-247613: steps 6 - 8 sic@

    // @siclog "Step 6" siclog@
    f_UT_IMS_SMSusingIMS(MMI, 1);        // Turn on SMSoverIMS by using AT command +CASIMS (27.007 clause 8.72)

    // @siclog "Step 7" siclog@
    v_IMS_SMSoverIMS := true;
    v_NonceCount := 3;
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest(-, -, -, v_NonceCount, -, v_IMS_SMSoverIMS);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);

    // @siclog "Step 8" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_MO_IMS_Signalling);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.7.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_7_NR5GC_IMS1() runs on IMS_PTC
  {
    var charstring v_InvalidNonce := f_IMS_Authentication_GenerateInvalidNonce(macError);    // Nonce with invalid MAC
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var REGISTER_Request v_RegisterReq;
    var charstring v_CallId;
    var integer i;
    var SecurityClientParamsList_Type v_SecurityClientParamsList;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_CallId := v_RegisterReq.msgHeader.callId.callid;

    v_SecurityClientParamsList[0] := f_IMS_Register_GetSecurityClientParams(v_RegisterReq);

    for (i:=0; i<2; i:=i+1) {

      f_IMS_Register_SecurityInit(v_RegisterReq, -, false);

      // @siclog "Step 3/5" siclog@
      IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq, v_InvalidNonce))));
      
      // @siclog "Step 4/6" siclog@
      v_IMS_REGISTER_REQ := f_IMS_REGISTER_RequestWithSpecificAuth(v_CallId, cr_Authorization_InvalidMAC);
      v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
      v_SecurityClientParamsList := f_IMS_Authentication_CheckSecurityClientParams(v_SecurityClientParamsList, v_RegisterReq);
      f_IMS_Register_CheckAutsNotPresent(v_RegisterReq);
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step " & int2str(4 + 2*i));
    }

    // @siclog "Step 8" Void siclog@

    // @sic R5-206386: Step 9 - 16 sic@

    // @siclog "Step 9" siclog@
    f_IMS_Register_SecurityInit(v_RegisterReq);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq))));
    
    // @siclog "Step 10" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;

    // @siclog "Step 11" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));

    // @siclog "Step 12 - 16" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ, tsc_IMS_PublishDuringSubscribeForRegEvent);

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.8.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_8_NR5GC_IMS1() runs on IMS_PTC
  {
    var charstring v_InvalidNonce := f_IMS_Authentication_GenerateInvalidNonce(sqnFailure);
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var SecurityClientParamsList_Type v_SecurityClientParamsList;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var REGISTER_Request v_RegisterReq;
    var charstring v_CallId_Step2;
    var charstring v_CallId_Step4;
    var template (value) MessageHeader v_MessageHeader_RegisterResponse_401;

    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_CallId_Step2 := v_RegisterReq.msgHeader.callId.callid;

    // @siclog "Step 3" siclog@
    f_IMS_Register_SecurityInit(v_RegisterReq, -, false);
    v_MessageHeader_RegisterResponse_401 := f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq);
    v_MessageHeader_RegisterResponse_401.securityServer := omit;
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, v_MessageHeader_RegisterResponse_401)));

    // @siclog "Step 4" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_InitialRequest();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);                // @sic R5s221319 sic@
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_CallId_Step4 := v_RegisterReq.msgHeader.callId.callid;
    if (v_CallId_Step4 == v_CallId_Step2) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "same Call-ID as at step 2");
    }
    v_SecurityClientParamsList[0] := f_IMS_Register_GetSecurityClientParams(v_RegisterReq);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // @siclog "Step 5" siclog@
    f_IMS_Register_SecurityInit(v_RegisterReq, -, false);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq, v_InvalidNonce))));
    
    // @siclog "Step 6" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_RequestWithSpecificAuth(v_CallId_Step4, cr_Authorization_SqnOutOfRange(v_InvalidNonce));
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    v_SecurityClientParamsList := f_IMS_Authentication_CheckSecurityClientParams(v_SecurityClientParamsList, v_RegisterReq);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    // @siclog "Step 7" siclog@
    f_IMS_Register_SecurityInit(v_RegisterReq);
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine401, f_IMS_RegisterResponse_401_MessageHeaderTX(v_RegisterReq))));
    
    // @siclog "Step 8" siclog@
    v_IMS_REGISTER_REQ := f_IMS_REGISTER_SubsequentRequest();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ.RoutingInfo);
    v_RegisterReq := v_IMS_REGISTER_REQ.Request.Register;
    
    // @siclog "Step 9" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));
    
    // @siclog "Step 10 - 13" siclog@
    f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ, tsc_IMS_PublishDuringSubscribeForRegEvent);
    
    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

  /*
   * @desc      REFERENCE TS 34.229-5 clause 6.9.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_6_9_NR5GC_IMS1() runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ;
    var IMS_DATA_REQ v_IMS_SUBSCRIBE_REQ;
    var SUBSCRIBE_Request v_SubscribeReq;
    var template (value) IMS_RoutingInfo_Type v_RoutingInfoDL;
    var charstring v_CallId;
    var integer v_RetryT := 128;
    
    f_IMS_CC_Preamble(IPCAN_SignallingOnly, IMS_NULL, IMS_Security);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_IMS_CC_StartSignalling(IPCAN_InitialRegistration);

    // @siclog "Step 2 - 5" siclog@
    v_IMS_REGISTER_REQ := f_IMS_Register_NonGIBA();

    // @siclog "Step 6" siclog@
    v_IMS_SUBSCRIBE_REQ := f_IMS_SUBSCRIBE_Request();
    v_RoutingInfoDL := f_IMS_RoutingInfo_ULtoDL(v_IMS_SUBSCRIBE_REQ.RoutingInfo);
    v_SubscribeReq := v_IMS_SUBSCRIBE_REQ.Request.Subscribe;
    v_CallId := v_SubscribeReq.msgHeader.callId.callid;

    // @siclog "Step 7" siclog@
    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfoDL, cs_Response(c_statusLine503, f_IMS_CommonResponse_503_MessageHeaderTX(v_SubscribeReq.msgHeader, cs_RetryAfter(v_RetryT)))));

    // @siclog "Step 8" siclog@
    f_Delay(f_IMS_SetTimerToleranceMin(int2float(v_RetryT)));

    // @siclog "Step 9 - 12" siclog@
    v_SubscribeReq := f_IMS_Register_SubscribeNotify(v_IMS_REGISTER_REQ);    // NOTE: optional PUBLISH not considered by the prose
    if (v_SubscribeReq.msgHeader.callId.callid == v_CallId) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "CallId shall be different");
    }

    f_IMS_TestBody_Set(false);

    f_IMS_CC_Postamble(IPCAN_InitialRegistration);
  }

}
