module RLC_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from L2_Common4G5G all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_Handover all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_HandoverCommonFunctions all;
  import from NR_L2_Common all;
  import from NR_Parameters all;
  import from NR_RLC_Common all;
  import from NR_RRC_Templates all;
  import from RLC_TC_Common_NR all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_1_NR5GC() runs on NR5GC_PTC
  { // UM RLC / Segmentation and reassembly / 6-bit SN / Segmentation Info (SI) field
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var DRB_Identity v_DRBId;
        
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    //Re-establish DRB and modify RLC parameters
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_UM (v_DRBId, size6, size6, f_NR_DL_UM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1)));
    f_NR5GC_RRC_ConnectedState3N_RLC_UM (v_DRBId, v_RLC_BearerConfigList[0], size6);

    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.UM_SN_Size := 6;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};
    
    f_NR_TestBody_Set(true);
    
    f_TC_7_1_2_2_1_NR_TestBody (v_RLC_Rec, v_DRBId);

    f_NR_TestBody_Set(false);

    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_2_NR5GC() runs on NR5GC_PTC
  { // UM RLC / Segmentation and reassembly / 6-bit SN / Segmentation Info (SI) field
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var DRB_Identity v_DRBId;
        
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);

    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); // @sic R5s190312 ch. 4.3 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    //Re-establish DRB and modify RLC parameters
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_UM (v_DRBId, -, -, f_NR_DL_UM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1)));
    f_NR5GC_RRC_ConnectedState3N_RLC_UM (v_DRBId, v_RLC_BearerConfigList[0], -);

    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.UM_SN_Size := 12;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};
    
    f_NR_TestBody_Set(true);
    
    f_TC_7_1_2_2_2_NR_TestBody (v_RLC_Rec, v_DRBId);

    f_NR_TestBody_Set(false);
        
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // @sic R5s190312 ch. 4.3 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.2.2.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_2_2_3_NR5GC() runs on NR5GC_PTC
  { // UM RLC / 6-bit SN / Correct use of sequence numbering
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var DRB_Identity v_DRBId;
    
    f_NR5GC_Init(NR_1);
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A, TESTModeA_ON); //@sic R5s190321 sic@
    //Set null cipher Algorithm
    f_NR_AS_CipheringAlgorithm_Set(nea0);
    
    //Retrieve DRB Id of the first PDU session
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();
    v_RLC_BearerConfigList := f_NR_ReconfigureRLC_UM (v_DRBId, size6, size6, f_NR_DL_UM_T_Reassembly(f_NR_CellInfo_GetIsFR1(nr_Cell1)));
    // Get NR capabilities sent during EUTRA preamble
    f_NR5GC_RRC_ConnectedState3N_RLC_UM (v_DRBId, v_RLC_BearerConfigList[0], size6);
    
    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record(); // @sic R5s190906 ch. 1 sic@
    v_RLC_Rec.UM_SN_Size := 6;
    if (not f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_RLC_Rec.t_Reassembly := 0.03;};
    
    f_NR_TestBody_Set(true);
    f_TC_7_1_2_2_3_NR_TestBody (v_RLC_Rec, v_DRBId);
    f_NR_TestBody_Set(false);
    
    f_NR_ULGrantConfiguration_Start(nr_Cell1); //@sic R5s190321 sic@
    // f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell1); @sic R5s230130 sic@
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

