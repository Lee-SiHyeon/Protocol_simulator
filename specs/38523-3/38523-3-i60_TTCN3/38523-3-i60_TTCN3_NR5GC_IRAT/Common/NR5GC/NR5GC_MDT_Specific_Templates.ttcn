  template RLF_Report_r16 cr_NR_Rlf_Report_Common (RNTI_Value p_C_RNTI_r16,
                                            B64_Type p_SsbRLMConfigBitmap_r16 := tsc_SsbRLMConfigBitmap_r16,
                                            template integer p_Rsrp,
                                            template integer p_Rsrq,
                                            template NR_RLF_Report_measResultNeighCells p_MeasResultNeighCells_r16 := *,
                                            template NR_RLF_Report_previousPCellId p_PreviousPCellId_r16 := *,
                                            template (present) NR_RLF_Report_failedPCellId p_FailedPCellId_r16 := ?,
                                            template NR_RLF_Report_reconnectCellId p_ReconnectCellId_r16 := *,
                                            template TimeUntilReconnection_r16 p_TimeUntilReconnection_r16 := *,
                                            template CGI_Info_Logging_r16 p_ReestablishmentCellId_r16 := *,
                                            template integer p_TimeConnFailure_r16 := *,
                                            template (present) TimeSinceFailure_r16 p_TimeSinceFailure_r16 := ?,
                                            NR_RLF_Report_connectionFailureType_r16 p_ConnectionFailureType_r16,
                                            template (present) NR_RLF_Report_rlf_Cause p_Rlf_Cause_r16 :=?,//@sic R5s220421 sic@
                                            template LocationInfo_r16 p_LocationInfo_r16 := *,
                                            template RA_InformationCommon_r16 p_RA_InformationCommon_r16 := *,
                                            template (present) SSB_Index p_SSB_Index := tsc_NR_SSB_Index1,
                                            template NR_RLF_Report_lastHO_Type_r17 p_LastHO_Type_r17 := *,
                                            template TimeConnSourceDAPS_Failure_r17 p_TimeConnSourceDAPS_Failure_r17 := *,
                                            template TimeSinceCHO_Reconfig_r17 p_TimeSinceCHO_Reconfig_r17 := *,
                                            template NR_RLF_Report_choCellId_r17 p_ChoCellId_r17 := *,
                                            template ChoCandidateCellList_r17 p_ChoCandidateCellList_r17 := *,
                                            template RLF_Report_r16.nr_RLF_Report_r16.noSuitableCellFound_r16 p_NoSuitableCellFound_r16 := *,
                                            template RLF_Report_r16.nr_RLF_Report_r16.csi_rsRLMConfigBitmap_v1650 p_CSI_rsRLMConfigBitmap_v1650 := *
                                            ) :=
  { /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
      nr_RLF_Report_r16 := {
         measResultLastServCell_r16 := {
           measResult_r16  := {
             cellResults_r16  := {
               resultsSSB_Cell_r16  := {
                 rsrp := p_Rsrp,
                 rsrq := p_Rsrq,
                 sinr := *
               },
               resultsCSI_RS_Cell_r16 := *
             },
             rsIndexResults_r16 := {
               resultsSSB_Indexes_r16     := {cr_ResultsPerSSB_Index(p_SSB_Index)}, // @sic R5-221579 sic@
               ssbRLMConfigBitmap_r16     := p_SsbRLMConfigBitmap_r16,
               resultsCSI_RS_Indexes_r16  := omit,
               csi_rsRLMConfigBitmap_r16  := omit
             }
           }
         },
         measResultNeighCells_r16    := p_MeasResultNeighCells_r16,
         c_RNTI_r16                  := p_C_RNTI_r16,
         previousPCellId_r16         := p_PreviousPCellId_r16,
         failedPCellId_r16           := p_FailedPCellId_r16,
         reconnectCellId_r16         := p_ReconnectCellId_r16,
         timeUntilReconnection_r16    := p_TimeUntilReconnection_r16,  //@sic R5s211526 BASELINE MOVING 2021 sic@
         reestablishmentCellId_r16   := p_ReestablishmentCellId_r16,
         timeConnFailure_r16         := p_TimeConnFailure_r16,
         timeSinceFailure_r16        := p_TimeSinceFailure_r16,
         connectionFailureType_r16   := p_ConnectionFailureType_r16,
         rlf_Cause_r16               := p_Rlf_Cause_r16,
         locationInfo_r16            := p_LocationInfo_r16,
         noSuitableCellFound_r16     := p_NoSuitableCellFound_r16,
         ra_InformationCommon_r16    := p_RA_InformationCommon_r16,
         csi_rsRLMConfigBitmap_v1650 := p_CSI_rsRLMConfigBitmap_v1650,      //@sic R5s211526 BASELINE MOVING 2021 sic@
         lastHO_Type_r17             := p_LastHO_Type_r17,      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
         timeConnSourceDAPS_Failure_r17 := p_TimeConnSourceDAPS_Failure_r17,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
         timeSinceCHO_Reconfig_r17      := p_TimeSinceCHO_Reconfig_r17,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
         choCellId_r17                  := p_ChoCellId_r17,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
         choCandidateCellList_r17       := p_ChoCandidateCellList_r17, /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
         pSCellId_r18                   := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         mcg_RecoveryFailureCause_r18   := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         scg_FailureCause_r18           := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         elapsedTimeSCG_Failure_r18     := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         voiceFallbackHO_r18            := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         measResultLastServCellRSSI_r18 := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         measResultNeighFreqListRSSI_r18:= *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         bwp_Info_r18                   := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         elapsedTimeT316_r18            := *,                          /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
         scg_FailedAfterMCG_r18         := *                           /* @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@ */
      }
  };

  template (value) DL_DCCH_Message cs_38508_LoggedMeasurementConfiguration (PLMN_Identity p_PLMN_Identity,
                                                                            AbsoluteTimeInfo_r16 p_AbsoluteTimeInfo_r16,
                                                                            template (value) LoggedMeasurementConfiguration_r16_IEs.reportType p_LoggedMeasurementConfiguration_r16,
                                                                            template (omit) AreaConfiguration_r16  p_AreaConfiguration_r16 := omit,
                                                                            LoggingDuration_r16 p_LoggingDuration_r16 := min120,
                                                                            template (omit) LoggedMeasurementConfiguration_v1700_IEs p_LoggedMeasurementConfiguration_v1700_IEs := omit ) := /*@sic R5-230377 sic@*/
  { /* 38.508-1 clause 4.6.1 table 4.6.1-5AA LoggedMeasurementConfiguration */
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    message_ := {
      c1 := {
        loggedMeasurementConfiguration_r16 := {
          criticalExtensions := {
              loggedMeasurementConfiguration_r16 := {
                traceReference_r16   :=  {
                   plmn_Identity_r16 := p_PLMN_Identity,
                   traceId_r16       := '0000EF'O
                },
                traceRecordingSessionRef_r16 := '001A'O,
                tce_Id_r16                   := '05'O,
                absoluteTimeInfo_r16         := p_AbsoluteTimeInfo_r16,
                areaConfiguration_r16        := p_AreaConfiguration_r16,
                plmn_IdentityList_r16        := omit,
                bt_NameList_r16              := omit,
                wlan_NameList_r16            := omit,
                sensor_NameList_r16          := omit,
                loggingDuration_r16          := p_LoggingDuration_r16,
                reportType                   := p_LoggedMeasurementConfiguration_r16,
                lateNonCriticalExtension     := omit,
                nonCriticalExtension         := p_LoggedMeasurementConfiguration_v1700_IEs //@sic R5-230377 sic@
              }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_38508_UEInformationRequest(RRC_TransactionIdentifier p_RRC_TI := tsc_NR_RRC_TI_Def, //@sic R5-224094 sic@
                                                                 template (omit) UEInformationRequest_r16_IEs_idleModeMeasurementReq_Type p_IdleModeMeasurementReq_r16 := omit,
                                                                 template (omit) UEInformationRequest_r16_IEs_logMeasReportReq_Type p_LogMeasReportReq_r16 := omit,
                                                                 template (omit) UEInformationRequest_r16_IEs_connEstFailReportReq_Type p_ConnEstFailReportReq_r16 := true_, //@sic R5-224094 sic@
                                                                 template (omit) UEInformationRequest_r16_IEs_ra_ReportReq_Type p_Ra_ReportReq_r16 := omit,
                                                                 template (omit) UEInformationRequest_r16_IEs_rlf_ReportReq_Type p_Rlf_ReportReq_r16 := omit,
                                                                 template (omit) UEInformationRequest_r16_IEs_mobilityHistoryReportReq_Type p_MobilityHistoryReportReq_r16 := omit,
                                                                 template (omit) UEInformationRequest_v1700_IEs p_UEInformationRequest_v1700_IEs := omit
                                                                 ) :=
  { /* Ref TS 38.508-1 Table 4.6.1-32A UEInformationRequest*/
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    message_ := {
      c1 := {
        ueInformationRequest_r16 := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
              ueInformationRequest_r16 := {
                idleModeMeasurementReq_r16   := p_IdleModeMeasurementReq_r16,
                logMeasReportReq_r16         := p_LogMeasReportReq_r16,
                connEstFailReportReq_r16     := p_ConnEstFailReportReq_r16,
                ra_ReportReq_r16             := p_Ra_ReportReq_r16,
                rlf_ReportReq_r16            := p_Rlf_ReportReq_r16,
                mobilityHistoryReportReq_r16 := p_MobilityHistoryReportReq_r16,
                lateNonCriticalExtension     := omit,
                nonCriticalExtension         := p_UEInformationRequest_v1700_IEs  //@sic R5-235350 sic@
              }
          }
        }
      }
    }
  };

  template (value) DL_DCCH_Message cs_NR_UEInformationRequest_LOG(RRC_TransactionIdentifier p_RRC_TI:= tsc_NR_RRC_TI_Def) := // condition LOG
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    cs_38508_UEInformationRequest(p_RRC_TI, -, true_);

  template (present) UL_DCCH_Message cr_UEInformationResponse_r16_Common(RRC_TransactionIdentifier p_RRC_TI,
                                                                        template MeasResultIdleEUTRA_r16 p_MeasResultIdleEUTRA_r16 := *,
                                                                        template MeasResultIdleNR_r16 p_MeasResultIdleNR_r16 := *,
                                                                        template LogMeasReport_r16 p_LogMeasReport_r16 := *,
                                                                        template ConnEstFailReport_r16 p_ConnEstFailReport_r16 := *,
                                                                        template RA_ReportList_r16 p_Ra_ReportList_r16 := *,
                                                                        template RLF_Report_r16 p_Rlf_Report_r16 := *,
                                                                        template MobilityHistoryReport_r16 p_MobilityHistoryReport_r16 := *,
                                                                        template UEInformationResponse_v1700_IEs p_UEInformationResponse_v1700_IEs := *) := //@sic R5-232682 sic@
  {
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    message_ := {
      messageClassExtension := {
       c2 := {
        ueInformationResponse_r16 := {
          rrc_TransactionIdentifier := p_RRC_TI,
          criticalExtensions := {
              ueInformationResponse_r16 := {
                measResultIdleEUTRA_r16      := p_MeasResultIdleEUTRA_r16,
                measResultIdleNR_r16         := p_MeasResultIdleNR_r16,
                logMeasReport_r16            := p_LogMeasReport_r16,
                connEstFailReport_r16        := p_ConnEstFailReport_r16,
                ra_ReportList_r16            := p_Ra_ReportList_r16,
                rlf_Report_r16               := p_Rlf_Report_r16,
                mobilityHistoryReport_r16    := p_MobilityHistoryReport_r16,
                lateNonCriticalExtension     := *,
                nonCriticalExtension         := p_UEInformationResponse_v1700_IEs
              }
          }
        }
       }
      }
    }
  };

  template (present) UL_DCCH_Message cr_38508_UEInformationResponse(RRC_TransactionIdentifier p_RRC_TI,
                                                                   template MeasResultIdleEUTRA_r16 p_MeasResultIdleEUTRA_r16 := *,
                                                                   template MeasResultIdleNR_r16 p_MeasResultIdleNR_r16 := *,
                                                                   template LogMeasReport_r16 p_LogMeasReport_r16 := *,
                                                                   template ConnEstFailReport_r16 p_ConnEstFailReport_r16 := *,
                                                                   template RA_ReportList_r16 p_Ra_ReportReq_r16 := *,
                                                                   template RLF_Report_r16 p_Rlf_Report_r16 := *,
                                                                   template MobilityHistoryReport_r16 p_MobilityHistoryReport_r16 := *,
                                                                   template UEInformationResponse_v1700_IEs p_UEInformationResponse_v1700_IEs := *) := //@sic R5-232682 sic@
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    /* Ref TS 38.508-1 Table 4.6.1-32B UEInformationResponse*/
    cr_UEInformationResponse_r16_Common(p_RRC_TI,
                                        p_MeasResultIdleEUTRA_r16,
                                        p_MeasResultIdleNR_r16,
                                        p_LogMeasReport_r16,
                                        p_ConnEstFailReport_r16, p_Ra_ReportReq_r16,
                                        p_Rlf_Report_r16, p_MobilityHistoryReport_r16,
                                        p_UEInformationResponse_v1700_IEs);

    template (present) UE_MeasurementsAvailable_r16 cr_UE_MeasurementsAvailable_r16_LOG := cr_UE_MeasurementsAvailable_r16(true_);    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */

    template UE_MeasurementsAvailable_r16 cr_UE_MeasurementsAvailable_r16_RLF := cr_UE_MeasurementsAvailable_r16(-,-,-,-, true_); /* @status    APPROVED (NR5GC, NR5GC_IRAT) */

    template (present) RRCReconfigurationComplete_v1610_IEs cr_RRCReconfigurationComplete_v1610_RLF :=
    { /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
      ue_MeasurementsAvailable_r16 := cr_UE_MeasurementsAvailable_r16_RLF,
      needForGapsInfoNR_r16 := omit,
      nonCriticalExtension := *
    };

}
