module NR_NTN_Configuration {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;

  type record of NR_NTN_TimingAdvanceConfig_Type NR_NTN_TimingAdvanceConfigList_Type; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  type record of NR_NTN_Config_Type NR_NTN_ConfigList_Type; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_Config_Type cs_38508_NTN_Config (template (omit) NR_NTN_TimingOffset_Type  p_TimingOffset := omit,
                                                          template (omit) NR_NTN_PolarizationConfig_Type p_PolarisationConfig := omit,
                                                          integer p_DopplerShift := 0) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      NtnTimingOffset          := p_TimingOffset,
      NtnPolarization          := p_PolarisationConfig,
      NtnFrequencyDopplerShift := p_DopplerShift        //@sic R5w240203 sic@
  };

  template (value) NR_NTN_TimingOffset_Type cs_NTN_TimingOffset_Def (NR_NTN_K_Offset_Type p_Koffset,
                                                                     NR_NTN_K_Mac_Type p_Kmac) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      Koffset  := p_Koffset,
      Kmac     := p_Kmac
  };

  template (value) NR_NTN_TimingOffset_Type cs_NTN_TimingOffset_GSO := cs_NTN_TimingOffset_Def(550, 0); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_TimingOffset_Type cs_NTN_TimingOffset_NGSO_NTNCell1 := cs_NTN_TimingOffset_Def(5,3); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_TimingOffset_Type cs_NTN_TimingOffset_NGSO_NTNCell2_NTNCell3 := cs_NTN_TimingOffset_Def(8,4); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_Config_Type cs_NTN_Config_GSO := cs_38508_NTN_Config(cs_NTN_TimingOffset_GSO); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_Config_Type cs_NTN_Config_NGSO_Cell1 := cs_38508_NTN_Config(cs_NTN_TimingOffset_NGSO_NTNCell1,-,1300); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_Config_Type cs_NTN_Config_NGSO_Cell2 := cs_38508_NTN_Config(cs_NTN_TimingOffset_NGSO_NTNCell2_NTNCell3,-,1983000); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_Config_Type cs_NTN_Config_NGSO_Cell3 := cs_38508_NTN_Config(cs_NTN_TimingOffset_NGSO_NTNCell2_NTNCell3,-,-195000); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_ConfigList_Type cs_NR_NTN_ConfigList_NGSO :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      cs_NTN_Config_NGSO_Cell1,
      cs_NTN_Config_NGSO_Cell2,
      cs_NTN_Config_NGSO_Cell3
  };

  template (value) NR_NTN_TimingAdvanceConfig_Type cs_NTN_TimingAdvanceConfig (template (value) NR_NTN_SemistaticTA_Type p_NTN_SemistaticTA) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      Semistatic := p_NTN_SemistaticTA
  };

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_Def ( NR_NTN_T_TA_Type p_NtnCommonTA,
                                                                       NR_NTN_T_TA_Type p_NtnUeSpecificTA) :=
  {  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      InitialValue       := 0,
      NtnCommonTA        := p_NtnCommonTA,
      NtnUeSpecificTA    := p_NtnUeSpecificTA
      
  };

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_GSO_Cell1 := cs_NTN_SemistaticTA_Def(65896378,7476932); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_GSO_Cell2 := cs_NTN_SemistaticTA_Def(66485757,7523436);  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_GSO_Cell3 := cs_NTN_SemistaticTA_Def(66485757,7482140);  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_NGSO_Cell1 := cs_NTN_SemistaticTA_Def(0,7987519); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_NGSO_Cell2 := cs_NTN_SemistaticTA_Def(0,14155442); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_SemistaticTA_Type cs_NTN_SemistaticTA_NGSO_Cell3 := cs_NTN_SemistaticTA_Def(0,14390696); /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_NTN_TimingAdvanceConfigList_Type cs_NR_NTN_TimingAdvanceConfig_GSO_Array :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_GSO_Cell1),
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_GSO_Cell2),
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_GSO_Cell3)
  };

  template (value) NR_NTN_TimingAdvanceConfigList_Type cs_NR_NTN_TimingAdvanceConfig_NGSO_Array :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_NGSO_Cell1),
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_NGSO_Cell2),
      cs_NTN_TimingAdvanceConfig(cs_NTN_SemistaticTA_NGSO_Cell3)
  };

   /*
   * @desc      get Kmac of a cell with a given index (p_CellId)
   *            If the cell is not NTN return 0
   * @param     p_CellId
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetKmac(NR_CellId_Type p_CellId) runs on NR_BASE_PTC return integer
  {
    var SIB19_r17 v_SIB19;
    if (f_NR_MobileInfo_IsNTN()) {
        v_SIB19 := f_NR5GC_CellInfo_GetSIB19(p_CellId);
        if (ispresent(v_SIB19.ntn_Config_r17.kmac_r17))  {
            return v_SIB19.ntn_Config_r17.kmac_r17;
        } else {
          return 0;
        }
    } else { //non NTN TC
        return 0;
    }
  }

  /*
   * @desc      calculate and return an NTN TA of a cell with a given index (p_CellId)
   * @param     p_CellId
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetNTN_TA(NR_CellId_Type p_CellId) runs on NR_BASE_PTC return integer
  {
    var integer v_LegacyTA;
    var integer v_CommonTA;
    var integer v_UeSpecificTA;
    var float   v_Tc;
    var float   v_NTN_TA;
    var float v_Fmax_KHz := 480.0; // TS 38.211 cl 4.1
    var float v_Nf := 4096.0;      // TS 38.211 cl 4.1
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_CellId);
      
    if(ispresent(v_NR_CellInfo.NtnTA))
    {
        v_LegacyTA := v_NR_CellInfo.NtnTA.Semistatic.InitialValue;
        v_CommonTA := v_NR_CellInfo.NtnTA.Semistatic.NtnCommonTA * 8;         // TS 38.523-3 Table 7.5.2.2-1
        v_UeSpecificTA := v_NR_CellInfo.NtnTA.Semistatic.NtnUeSpecificTA * 8; // TS 38.523-3 Table 7.5.2.2-1
        v_NTN_TA := int2float(v_LegacyTA + v_CommonTA + v_UeSpecificTA);
        v_Tc := 1.0/(v_Fmax_KHz*v_Nf);
        return float2int(v_NTN_TA*v_Tc)  //ms TS 38.523-3 cl 7.5.2.2
    }
    else
    {
        return 0;
    }
  }

  /*
   * @desc      calculates and returns UE-gNB RTT in ms of an NTN cell with a given index (p_CellId)
   *            For non NTN return 0
   * @param     p_CellId
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetNTN_UE_gNB_RTT(NR_CellId_Type p_CellId) runs on NR_BASE_PTC return integer
  {
    var integer v_Kmac := 0;
    var integer v_Ntn_TA := 0;
    if (f_NR_MobileInfo_IsNTN()) {
        v_Kmac := f_NR_CellInfo_GetKmac(p_CellId);
        v_Ntn_TA := f_NR_CellInfo_GetNTN_TA(p_CellId);
    }
    return v_Ntn_TA + v_Kmac; // UE-gNB RTT as per TS 38.523-3 Table 7.5.2.3-1
  }

}
