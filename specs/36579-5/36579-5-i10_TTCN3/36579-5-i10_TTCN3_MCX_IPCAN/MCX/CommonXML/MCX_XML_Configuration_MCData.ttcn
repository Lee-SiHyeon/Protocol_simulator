  function fl_MCData_UserProfile_Extension() return MCData_UserProfile_Extension_Type
  {
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_create_delete_user_alias                v_Allow_create_delete_user_alias := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_create_group_broadcast_group            v_Allow_create_group_broadcast_group := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_create_user_broadcast_group             v_Allow_create_user_broadcast_group := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_transmit_data                           v_Allow_transmit_data := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_request_affiliated_groups               v_Allow_request_affiliated_groups := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_request_to_affiliate_other_users        v_Allow_request_to_affiliate_other_users := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_recommend_to_affiliate_other_users      v_Allow_recommend_to_affiliate_other_users := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_regroup                                 v_Allow_regroup := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_presence_status                         v_Allow_presence_status := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_request_presence                        v_Allow_request_presence := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_activate_emergency_alert                v_Allow_activate_emergency_alert := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_cancel_emergency_alert                  v_Allow_cancel_emergency_alert := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_cancel_emergency_alert_any_user         v_Allow_cancel_emergency_alert_any_user := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_enable_disable_user                     v_Allow_enable_disable_user := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_enable_disable_UE                       v_Allow_enable_disable_UE := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_off_network_manual_switch               v_Allow_off_network_manual_switch := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_off_network                             v_Allow_off_network := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_query_functional_alias_other_user       v_Allow_query_functional_alias_other_user := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_takeover_functional_alias_other_user    v_Allow_takeover_functional_alias_other_user := true;
    var urn_3gpp_ns_mcdata_user_profile_1_0.Allow_one_to_one_communication_from_any_user  v_Allow_one_to_one_communication_from_any_user := true;


    var template (value) ExtensibleType v_Actions;
    var template (value) urn_ietf_params_xml_ns_common_policy.RuleType v_Rule;
    var template (value) urn_ietf_params_xml_ns_common_policy.Ruleset v_Ruleset;
    var MCData_UserProfile_Extension_Type v_Extension;

    v_Actions := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_Allow_create_delete_user_alias)),
        f_Bit2XsdString(encvalue(v_Allow_create_group_broadcast_group)),
        f_Bit2XsdString(encvalue(v_Allow_create_user_broadcast_group)),
        f_Bit2XsdString(encvalue(v_Allow_transmit_data)),
        f_Bit2XsdString(encvalue(v_Allow_request_affiliated_groups)),
        f_Bit2XsdString(encvalue(v_Allow_request_to_affiliate_other_users)),
        f_Bit2XsdString(encvalue(v_Allow_recommend_to_affiliate_other_users)),
        f_Bit2XsdString(encvalue(v_Allow_regroup)),
        f_Bit2XsdString(encvalue(v_Allow_presence_status)),
        f_Bit2XsdString(encvalue(v_Allow_request_presence)),
        f_Bit2XsdString(encvalue(v_Allow_activate_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_emergency_alert)),
        f_Bit2XsdString(encvalue(v_Allow_cancel_emergency_alert_any_user)),
        f_Bit2XsdString(encvalue(v_Allow_enable_disable_user)),
        f_Bit2XsdString(encvalue(v_Allow_enable_disable_UE)),
        f_Bit2XsdString(encvalue(v_Allow_off_network_manual_switch)),
        f_Bit2XsdString(encvalue(v_Allow_off_network)),
        f_Bit2XsdString(encvalue(v_Allow_query_functional_alias_other_user)),       // @sic R5-233488 sic@
        f_Bit2XsdString(encvalue(v_Allow_takeover_functional_alias_other_user)),    // @sic R5-233488 sic@
        f_Bit2XsdString(encvalue(v_Allow_one_to_one_communication_from_any_user))   // @sic R5-233488 sic@
      }
    };

    v_Rule := cs_MCX_CP_Rule("rule1", v_Actions);
    v_Ruleset := cs_MCX_CP_Ruleset(v_Rule);
    
    v_Extension := {
      f_Bit2XsdString(encvalue(v_Ruleset))
    };
    return v_Extension;
  }

  template (value) MCData_UserProfile_Type cs_MCData_UserProfile(template (value) MCData_UserProfile_OnNetwork_Type p_OnNetwork) :=
  { /* 36.579-1 Table 5.5.8.11-1: MCData User Profile Defaults */
    /* @status    APPROVED (MCX) */
    xUI_URI := "sip:" & px_MCData_ID_User_A,
    user_profile_index := tsc_MCX_ProfileId_MCData,
    attr := omit,
    choice_list := {
      { status := true },
      { profileName := cs_MCData_UserProfile_Name("mcdata-user-profile-" & int2str(tsc_MCX_ProfileId_MCData) & ".xml") },
      { common := cs_MCData_UserProfile_Common },
      { onNetwork := p_OnNetwork },
      { offNetwork := cs_MCData_UserProfile_OffNetwork },
      { elem_list := fl_MCData_UserProfile_Extension() }
    }
  };

  /*
   * @desc      MCData User Profile according to 36.579-1 Table 5.5.8.11-1
   * @return    template (value) MCData_UserProfile_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_UserProfile() return template (value) MCData_UserProfile_Type
  {
    var MCDataContentServerURI v_MCDataContentServerURI := tsc_MCData_MSF_URI;
    var MessageStoreHostname v_MessageStoreHostname := tsc_MCData_MSF_Hostname;
    var template (value) IncomingOne_to_OneCommunicationList v_IncomingOne_to_OneCommunicationList := fl_MCData_UserProfile_CommonOnNetwork_IncomingOne_to_OneCommunicationList();
    var template (value) MCData_UserProfile_OnNetwork_Type v_OnNetwork;
    var urn_3gpp_ns_mcdata_user_profile_1_0.AnyExt v_OnNetworkAnyExt;

    v_OnNetworkAnyExt := {  // @sic R5-220478 sic@
      elem_list := {
        f_Bit2XsdString(encvalue(v_MCDataContentServerURI)),
        f_Bit2XsdString(encvalue(cs_MCData_UserProfile_FunctionalAliasList)),     // @sic R5-233488: FunctionalAliasList sic@
        f_Bit2XsdString(encvalue(v_MessageStoreHostname)),
        f_Bit2XsdString(encvalue(v_IncomingOne_to_OneCommunicationList))          /* @sic R5-244960, R5-246644: <One-to-One-Communication> sic@ */
      }
    };

    v_OnNetwork := cs_MCData_UserProfile_OnNetwork(v_OnNetworkAnyExt);

    return cs_MCData_UserProfile(v_OnNetwork);
  }

