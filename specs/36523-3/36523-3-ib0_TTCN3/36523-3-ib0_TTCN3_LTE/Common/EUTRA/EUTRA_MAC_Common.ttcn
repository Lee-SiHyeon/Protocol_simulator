  template (present) RLC_PDU_Type cr_RLC_AMD_1PDU(template (present) B1_Type p_Poll,
                                                  template (present) B10_Type p_SN,
                                                  template (present) RLC_DataField_Type p_RLC_SDU) :=
  { /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    AMD := {
      Header  := cr_RLC_AMD_Header_1SDU(p_Poll, p_SN),
      Data    := {p_RLC_SDU}
    }
  };

  template (present) RLC_AMD_Header_Type cr_RLC_AMD_Header_1SDU(template (present) B1_Type p_Poll,
                                                                template (present) B10_Type p_SN) :=
  { /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    FixPart     := cr_RLC_AMD_Header_FixPart(p_Poll,p_SN),
    SegmentPart := omit,
    FlexPart    := omit
  };

  template (present) RLC_AMD_Header_FixPart_Type cr_RLC_AMD_Header_FixPart(template (present) B1_Type p_Poll,
                                                                           template (present) B10_Type p_SN) :=
  { /* @status    APPROVED (LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12) */
    D_C                    := tsc_DC_DataPDU,                 /* 1 ... Data PDU */
    ReSeg                  := '0'B,                           /* 0 ... AMD PDU */
    Poll                   := p_Poll,
    FramingInfo            := tsc_FI_FullSDU,                 /* 2 bit FI */
    Extension              := tsc_ExtensionNoMoreHeaders,     /* 1 bit  E  */
    SN                     := p_SN                            /* Sequence numbers */
  };

