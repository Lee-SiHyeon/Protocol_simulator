module Idle_CellReselection_PRO {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_BandDependentParam all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_IdleMode all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASCommonFunctions all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_Parameters all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RSRQ_Functions all;
  import from EUTRA_SysInfo_Templates all;

  /*
   * @desc      Assign the parameterised Qrxlevmin-CE value in SIB1-BR of the cell
   * @param     p_CellId
   * @param     p_Q_Rxlevmin
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_EUTRA_CellInfo_SetSysInfoBR_Q_RxlevminCE(EUTRA_CellId_Type p_CellId,
                                                    Q_Rxlevmin_Type p_Q_Rxlevmin) runs on EUTRA_PTC
  { //@sic R5s170090 rename function f_EUTRA_CellInfo_SetSysInfo_Q_RxlevminCE -> f_EUTRA_CellInfo_SetSysInfoBR_Q_RxlevminCE sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    
    v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellSelectionInfoCE_r13.q_RxLevMinCE_r13 := p_Q_Rxlevmin;
    f_EUTRA_CellInfo_Set (p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised Qrxlevmin value in SIB1-BR of the cell
   * @param     p_CellId
   * @param     p_Q_Rxlevmin
   * @status    APPROVED (LTE_A_PRO)
   */
   function f_EUTRA_CellInfo_SetSysInfoBR_Q_Rxlevmin(EUTRA_CellId_Type p_CellId,
                                                    Q_Rxlevmin_Type p_Q_Rxlevmin) runs on EUTRA_PTC
  { //@sic R5s170090 change 2.1 sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
           
    v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.cellSelectionInfo.q_RxLevMin := p_Q_Rxlevmin;
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised Qqualmin-CE value in SIB1-BR of the cell
   * @param     p_CellId
   * @param     p_Q_QualMinRSRQ
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_EUTRA_CellInfo_SetSysInfoBR_Q_QualMinCE ( EUTRA_CellId_Type p_CellId,
                                                       Q_QualMin_r9 p_Q_QualMinRSRQ) runs on EUTRA_PTC
  { //@sic R5s170194 sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    
    v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.cellSelectionInfoCE_r13.q_QualMinRSRQ_CE_r13 := p_Q_QualMinRSRQ;
    f_EUTRA_CellInfo_Set (p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised Qqualmin value in SIB1-BR of the cell
   * @param     p_CellId
   * @param     p_Q_QualMin
   * @status    APPROVED (LTE_A_PRO)
   */
   function f_EUTRA_CellInfo_SetSysInfoBR_Q_QualMin(EUTRA_CellId_Type p_CellId,
                                                    Q_QualMin_r9 p_Q_QualMin) runs on EUTRA_PTC
  { //@sic R5s170194 sic@
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    
    v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.nonCriticalExtension.nonCriticalExtension.cellSelectionInfo_v920.q_QualMin_r9 := p_Q_QualMin;
    f_EUTRA_CellInfo_Set (p_CellId, v_CellInfo);
  }

  /*
   * @desc      Assign the parameterised T_ReselectionEUTRA_CE value in SIB3 of the cell
   *            Should be moved to module EUTRA_Component
   * @param     p_CellId
   * @param     p_T_ReselectionEUTRA_CE
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_EUTRA_CellInfo_SetSIB3_T_ReselectionEUTRA_CE(EUTRA_CellId_Type p_CellId,
                                                          T_ReselectionEUTRA_CE_r13  p_T_ReselectionEUTRA_CE) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    
    v_CellInfo.Sysinfo.BCCH_Info.SIs[1].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib3.t_ReselectionEUTRA_CE_r13 := p_T_ReselectionEUTRA_CE;
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
    f_EUTRA_SetSIs_ValueTag(p_CellId);
  }

  /*
   * @desc      Function that sets a value for P_Max in SIB1 of the cell
   * @param     p_CellId
   * @param     p_P_Max
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_EUTRA_CellInfo_SetSIB1_P_Max(EUTRA_CellId_Type p_CellId,
                                          P_Max p_P_Max) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var SysinfoType_Type v_SysinfoType := f_EUTRA_CellInfo_GetSysinfoType(p_CellId);
    
    v_CellInfo.Sysinfo.BCCH_Info.SIB1.message_.c1.systemInformationBlockType1.p_Max := p_P_Max;
    if (v_SysinfoType == sysinfoAndBR) { //@sic R5-204528 sic@
        //UE supports category M1 or enhanced coverage TC
        v_CellInfo.Sysinfo.BCCH_BR_Info.SIB1.message_.c1.systemInformationBlockType1_BR_r13.p_Max := p_P_Max;
    }
    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.1.2.2c
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_6_1_2_2c_EUTRA() runs on EUTRA_PTC
  {
    var Q_RxLevMin v_Q_Rxlevmin_CE := -41; //@sic R5s170090 change 2.1  sic@
    var float v_TimerValue := 60.0;
    timer t_IdleMode_GenericTimer := tsc_IdleMode_GenericTimer;
    
    //Initialise all cells, security and mobile parameters
    f_EUTRA_Init(c1);
    
    //Set maximum cell power level for Cell 1 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell1, -69);
    
    //Create and configure Cell 1
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Perform Idle updated procedure to make sure UE is in a known state before test case starts
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    
    //Bring UE to initial state
    f_EUTRA_UE_Detach_SwitchOffUe(eutra_Cell1, RRC_IDLE);

    f_EUTRA_TestBody_Set(true);

    //@siclog "Step 1" siclog@
    //SS adjusts the cell levels according to row T1 of table 6.1.2.2c.3.2-1.
    f_EUTRA_SetCellPower (eutra_Cell1, -95);

    //@siclog "Step 2" siclog@
    //@sic R5s170090 change 2.1 R5-171994 sic@
    f_EUTRA_CellInfo_SetSysInfoBR_Q_RxlevminCE(eutra_Cell1, v_Q_Rxlevmin_CE);
    
    f_EUTRA_ModifySysinfoUE_Off(eutra_Cell1, -, true);  //@sic R5s170090 change 2.1 sic@
    
    //@siclog "Step 3" siclog@
    //UE is switched on
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1);
    
    //@siclog "Step 4" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 1 within the next 60 s?
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerValue)) {
      //* @verdict fail UE sent RRCConnectionRequest message on Cell 1 within v_TimerValue
      f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.1.2.2c Step 4");
    }
    
    //@siclog "Step 5" siclog@
    //SS re-adjusts the cell-specific reference signal level of Cell 1 level according to row "T2" in table 6.1.2.2c.3.2-1.
    f_EUTRA_SetCellPower(eutra_Cell1, -69);
    t_IdleMode_GenericTimer.start;

    //@siclog "Step 6" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 1?
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1);
    //Stop Idle Mode Geberic Timer
    t_IdleMode_GenericTimer.stop;
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Test Case 6.1.2.2c Step 6");

    //@siclog "Step 7 - 21" siclog@
    f_EUTRA_IdleUpdated_WithoutRRCConnReq(eutra_Cell1, STATE2_IDLEUPDATE);

    f_EUTRA_TestBody_Set(false);

    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell1, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.1.2.2d
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_6_1_2_2d_EUTRA() runs on EUTRA_PTC
  {
    var float v_TimerValue := 60.0;
    timer t_IdleMode_GenericTimer := tsc_IdleMode_GenericTimer;
    
    //Initialise all cells, security and mobile parameters
    f_EUTRA_Init(c1);

    //Set maximum cell power level for Cell 1 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, -60); //@sic R5-170194 R5-172881 sic@

    //Create and configure Cell 1
    f_EUTRA_CellConfig_Def (eutra_Cell1);
    f_EUTRA_ConfigureVNG (eutra_Cell1, -75); //@sic R5-170194 sic@
    
    //Preamble to ensure UE is in known state OFF
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_UE_Detach_SwitchOffUe(eutra_Cell1, RRC_IDLE);
    
    f_EUTRA_TestBody_Set (true);
    
    //@siclog "Step 1" siclog@
    //SS adjusts the cell levels according to row T1 of table 6.1.2.2d.3.2-1.
    f_EUTRA_SetCellPower (eutra_Cell1, -73);  //@sic R5-170194 R5-172881 sic@
    // Activate White Noise
    f_EUTRA_ActivateVNG(eutra_Cell1);

    //@siclog "Step 2" siclog@
    //Set SIB1 according to Table 6.1.2.2d.3.3-1  @sic R5-170194 R5-172881 sic@
    f_EUTRA_CellInfo_SetSysInfoBR_Q_QualMin(eutra_Cell1, -3);
    f_EUTRA_CellInfo_SetSysInfoBR_Q_QualMinCE(eutra_Cell1, -8);
    f_EUTRA_CellInfo_SetSysInfoBR_Q_Rxlevmin(eutra_Cell1, -53); //-106dB
    
    f_EUTRA_ModifySysinfoUE_Off(eutra_Cell1);
    
    //@siclog "Step 3" siclog@
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1);

    //@siclog "Step 4" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 1 within the next 60 s?
    if (f_EUTRA_RRC_RRCConnectionRequest_Check(eutra_Cell1, v_TimerValue)) {
      f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.1.2.2d Step 4");
    }

    //@siclog "Step 5" siclog@
    //SS re-adjusts the cell-specific reference signal level of Cell 1 level according to row "T2" in table 6.1.2.2d.3.2-1.
    f_EUTRA_SetCellPower (eutra_Cell1, -60); // @sic R5-170194 R5-172881 sic@
    t_IdleMode_GenericTimer.start;
    
    //@siclog "Step 6" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 1?
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1);
    t_IdleMode_GenericTimer.stop;
    f_EUTRA_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.1.2.2d Step 6");
    
    //@siclog "Step 7 - 21" siclog@
    f_EUTRA_IdleUpdated_WithoutRRCConnReq (eutra_Cell1, STATE2_IDLEUPDATE);
    
    f_EUTRA_TestBody_Set (false);
    
    //Switch/power off UE
    f_EUTRA_Postamble (eutra_Cell1, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.1.2.5a
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_6_1_2_5a_EUTRA() runs on EUTRA_PTC
  { // Cell reselection for interband operation/ Power Class 2 UE operation/ Between FDD and TDD
    var template (value) CellPowerList_Type v_CellPowerList_AtT1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10;
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierList;
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency_Cell1;
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency_Cell10;
    var template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type v_InterFreqCarrierFreqInfo_v9e0_List_Cell1 := omit;
    var template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type v_InterFreqCarrierFreqInfo_v9e0_List_Cell10 := omit;
    var integer v_Band;
    
    v_CellPowerList_AtT1 := {
      cs_CellPower (eutra_Cell10, -71)
    };
    
    f_EUTRA_Init(c3);
    
    //Check if Cells configured correctly under FDD and TDD mode
    if (f_EUTRA_CellInfo_GetFDD_TDD(eutra_Cell1)!= FDD) {
      f_SetVerdictInconc(__FILE__, __LINE__, "Cell1 shall be configured as a FDD cell");
    }
    if (f_EUTRA_CellInfo_GetFDD_TDD(eutra_Cell10)!= TDD) {
      f_SetVerdictInconc(__FILE__, __LINE__, "Cell10 shall be configured as a TDD cell");
    }
    
    //-----------------------------------------------
    
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell10, -71);
    //Set sysinfo and cell info for Cell 1 and Cell 10 to be used in creation
    //TAC for Cell 1 is set to 1 in f_EUTRA_Init ();
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell10);
    
    //Initialise SIB1 of cells 1 and 10 acc. to Table 6.1.2.5a.3.3-1
    f_EUTRA_CellInfo_SetSIB1_P_Max(eutra_Cell1, 23);
    f_EUTRA_CellInfo_SetSIB1_P_Max(eutra_Cell10, 26);
    //Initialise SIB3 of cells 1 and 10 acc. to Table 6.1.2.5a.3.3-2
    f_EUTRA_CellInfo_SetSysInfo_CellRes_Prio (eutra_Cell1, 1);
    f_EUTRA_CellInfo_SetSysInfo_CellRes_Prio (eutra_Cell10, 5);
    //Initialise SIB5 with inter mode content specifed in 36.508 Table 6.3.1.2-2
    f_EUTRA_SetSIB5_InterMode( eutra_Cell1);
    f_EUTRA_SetSIB5_InterMode (eutra_Cell10);
    
    //Set SIB5 of cell 1 according to Table 6.1.2.5a.3.3-3
    v_ChannelBandwidthDependency_Cell10 := f_EUTRA_BandDependentParam( px_ePrimaryBandChannelBandwidth,
                                                                       f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth));
    
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell10);
    v_InterFreqCarrierList := {
      cs_InterFreqCarrierFreq_Common(v_CarrierFreq_Cell10.dl_CarrierFreq,
                                     -53,
                                     26,
                                     7, // T_Reselection
                                     omit,
                                     16, // ThreshX_High @sic R5-182512 sic@
                                     1,
                                     v_ChannelBandwidthDependency_Cell10.AllowedMeasBandwidth,
                                     false,
                                     5) // CellReselectionPriority
    };
    //Band extension
    v_Band := f_EUTRA_CellInfo_GetBand(eutra_Cell10);
    if (v_Band > 64) {
      v_InterFreqCarrierFreqInfo_v9e0_List_Cell10 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5(eutra_Cell1, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierFreqInfo_v9e0_List_Cell10));
    
    
    //Set SIB5 of cell 10 according to Table 6.1.2.5a.3.3-4
    v_ChannelBandwidthDependency_Cell1 := f_EUTRA_BandDependentParam( px_ePrimaryBandChannelBandwidth,
                                                                      f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth));
    
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell1);
    v_InterFreqCarrierList := {
      cs_InterFreqCarrierFreq_Common(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                     -53,
                                     omit,
                                     7, // T_Reselection
                                     omit,
                                     16, // ThreshX_High @sic R5-182512 sic@
                                     1,
                                     v_ChannelBandwidthDependency_Cell1.AllowedMeasBandwidth,
                                     false,
                                     1) // CellReselectionPriority
    };
    //Band extension
    v_Band := f_EUTRA_CellInfo_GetBand(eutra_Cell1);
    if (v_Band > 64) {
        v_InterFreqCarrierFreqInfo_v9e0_List_Cell1 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5(eutra_Cell10, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierFreqInfo_v9e0_List_Cell1));
    
    //-----------------------------------------------
    
    //Create and configure all Cells
    f_EUTRA_CellConfig_Def (eutra_Cell1);
    f_EUTRA_CellConfig_Def (eutra_Cell10);
    
    //The UE is in state Registered, Idle mode (state 2) on Cell 1 (serving cell)
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    
    f_EUTRA_TestBody_Set (true);
    
    //@siclog "Step 1" siclog@
    //The SS changes Cell 10 power level according to the row "T1" in table 6.1.2.5a.3.2-1
    f_EUTRA_SetCellPowerList (v_CellPowerList_AtT1);   //Cell 10 becomes stronger than Threshx, high.
    
    //@siclog "Step 2" siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 10?
    f_EUTRA_IdleMode_TAU (eutra_Cell10);
    
    f_EUTRA_TestBody_Set (false);
    
    //Switch/power off UE
    f_EUTRA_Postamble (eutra_Cell10, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.1.2.5b
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_6_1_2_5b_EUTRA() runs on EUTRA_PTC
  { // Cell reselection for interband operation using Pcompensation / Between FDD and TDD
    var template (value) CellPowerList_Type v_CellPowerList_AtT1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10;
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierList;
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency_Cell1;
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency_Cell10;
    var template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type v_InterFreqCarrierFreqInfo_v9e0_List_Cell1 := omit;
    var template (omit) InterFreqCarrierFreqInfo_v9e0_List_Type v_InterFreqCarrierFreqInfo_v9e0_List_Cell10 := omit;
    var integer v_Band;
    
    v_CellPowerList_AtT1 := {
      cs_CellPower (eutra_Cell10, tsc_ServingCellRS_EPRE),
      cs_CellPower (eutra_Cell1, tsc_Suitable_NeighbourIntraFreq_CellRS_EPRE)
    };
    
    f_EUTRA_Init(c3);
    
    //Check if Cells configured correctly under FDD and TDD mode
    if (f_EUTRA_CellInfo_GetFDD_TDD(eutra_Cell1)!= FDD) {
      f_SetVerdictInconc(__FILE__, __LINE__, "Cell1 shall be configured as a FDD cell");
    }
    if (f_EUTRA_CellInfo_GetFDD_TDD(eutra_Cell10)!= TDD) {
      f_SetVerdictInconc(__FILE__, __LINE__, "Cell10 shall be configured as a TDD cell");
    }
    
    //-----------------------------------------------
    
    //Set sysinfo and cell info for Cell 1 and Cell 10 to be used in creation
    //TAC for Cell 1 is set to 1 in f_EUTRA_Init ();
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell10);
    
    //Initialise SIB1 of cells 1 and 10 acc. to Table 6.1.2.5b.3.3-1
    f_EUTRA_CellInfo_SetSIB1_P_Max(eutra_Cell1, 33);
    f_EUTRA_CellInfo_SetSIB1_P_Max(eutra_Cell10, 33);
    //Initialise SIB3 of cells 1 and 10 acc. to Table 6.1.2.5b.3.3-2
    f_EUTRA_CellInfo_SetSysInfo_CellRes_Prio (eutra_Cell1, 5);
    f_EUTRA_CellInfo_SetSysInfo_CellRes_Prio (eutra_Cell10, 1);
    f_EUTRA_CellInfo_SetSysInfo_ThreshServingLow (eutra_Cell1, 6);
    f_EUTRA_CellInfo_SetSysInfo_ThreshServingLow (eutra_Cell10, 6);
    //Initialise SIB5 with inter mode content specifed in 36.508 Table 6.3.1.2-2
    f_EUTRA_SetSIB5_InterMode( eutra_Cell1);
    f_EUTRA_SetSIB5_InterMode (eutra_Cell10);
    
    //Set SIB5 of cell 1 according to Table 6.1.2.5b.3.3-3
    v_ChannelBandwidthDependency_Cell10 := f_EUTRA_BandDependentParam( px_ePrimaryBandChannelBandwidth,
                                                                      f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth));
    
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell10);
    v_InterFreqCarrierList := { //contents of SystemInformationBlockType5 for Cell 1
      cs_InterFreqCarrierFreq_Common(v_CarrierFreq_Cell10.dl_CarrierFreq,
                                     -53,
                                     33,
                                     7, // T_Reselection
                                     omit,
                                     10, // ThreshX_High
                                     1,
                                     v_ChannelBandwidthDependency_Cell10.AllowedMeasBandwidth,
                                     false,
                                     1) // CellReselectionPriority
    };
    //Band extension
    v_Band := f_EUTRA_CellInfo_GetBand(eutra_Cell10);
    if (v_Band > 64) {
      v_InterFreqCarrierFreqInfo_v9e0_List_Cell10 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5(eutra_Cell1, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierFreqInfo_v9e0_List_Cell10));
    
    
    //Set SIB5 of cell 10 according to Table 6.1.2.5b.3.3-4
    v_ChannelBandwidthDependency_Cell1 := f_EUTRA_BandDependentParam( px_ePrimaryBandChannelBandwidth,
                                                                      f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth));
    
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell1);
    v_InterFreqCarrierList := { //contents of SystemInformationBlockType5 for Cell 10
      cs_InterFreqCarrierFreq_Common(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                     -53,
                                     omit,
                                     7, // T_Reselection
                                     omit,
                                     10, // ThreshX_High
                                     1,
                                     v_ChannelBandwidthDependency_Cell1.AllowedMeasBandwidth,
                                     false,
                                     5) // CellReselectionPriority
    };
    //Band extension
    v_Band := f_EUTRA_CellInfo_GetBand(eutra_Cell1);
    if (v_Band > 64) {
      v_InterFreqCarrierFreqInfo_v9e0_List_Cell1 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5(eutra_Cell10, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierFreqInfo_v9e0_List_Cell1));
    
    //-----------------------------------------------
    
    //Create and configure all Cells
    f_EUTRA_CellConfig_Def (eutra_Cell1);
    f_EUTRA_CellConfig_Def (eutra_Cell10);
    
    //The UE is in state Registered, Idle mode (state 2) on Cell 1 (serving cell)
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    
    f_EUTRA_TestBody_Set (true);
    
    //@siclog "Step 1" siclog@
    //The SS changes the cell power levels according to the row "T1" in table 6.1.2.5b.3.2-1
    f_EUTRA_SetCellPowerList (v_CellPowerList_AtT1);   //Cell 1 becomes lower than Threshserving,low

    //@siclog "Step 2" siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 10?
    f_EUTRA_IdleMode_TAU (eutra_Cell10);
    
    f_EUTRA_TestBody_Set (false);
    
    //Switch/power off UE
    f_EUTRA_Postamble (eutra_Cell10, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 6.1.2.6a
   * @status    APPROVED (LTE_A_PRO)
   */
  function f_TC_6_1_2_6a_EUTRA() runs on EUTRA_PTC
  {
    var template (value) CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) CellPowerList_Type v_CellPowerList_AtT2;
    var PhysCellId v_PhysicalCellIdentity_Cell2;
    timer t_ResponseTimer := 30.0;

    f_EUTRA_Init(c2);
    
    v_CellPowerList_AtT1 := {
      cs_CellPower (eutra_Cell1, -85),
      cs_CellPower (eutra_Cell2, -91)
    };
    v_CellPowerList_AtT2 := {
      cs_CellPower (eutra_Cell1, -85),
      cs_CellPower (eutra_Cell2, -79)
    };
    
    //Set maximum cell power level for Cell 2 @sic R5s170102 sic@
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell2, -79);
    
    //Set sysinfo and cell info for Cell 1 and Cell 2 to be used in creation
    //TAC for Cell 1 is set to 1 in f_EUTRA_Init ();
    f_EUTRA_CellInfo_SetTAC (eutra_Cell2, tsc_IdleMode_TAC_Cell2);
    
    //Set SIB3 according to specific message contents (36.523-1 Table 6.1.2.6a.3.3-1: SystemInformationBlockType3)
    f_EUTRA_CellInfo_SetSIB3_T_ReselectionEUTRA_CE(eutra_Cell1, 15);
    f_EUTRA_CellInfo_SetSIB3_T_ReselectionEUTRA_CE(eutra_Cell2, 15);
    f_EUTRA_CellInfo_SetSysInfo_Intra_QRxlevmin(eutra_Cell1,-27); //@sic R5s170334 R5-172882 sic@
    //Set SIB4 in cell1 according to specific message content in Table 6.1.2.6a.3.3-2 @sic R5-170578 sic@
    v_PhysicalCellIdentity_Cell2 := f_EUTRA_CellInfo_GetPhyCellId(eutra_Cell2);
    f_EUTRA_CellInfo_SetSIB4(eutra_Cell1, cs_SIB4_OneNeighCellEntry(v_PhysicalCellIdentity_Cell2, dB0));
 
    f_EUTRA_CellInfo_SetSysInfoBR_Q_Rxlevmin(eutra_Cell1,-27); //@sic R5s170102 sic@

    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell2);
    
    //Bring UE to initial state
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //Wait for 1 sec after preamble to allow UE to come to idle mode
    f_Delay(tsc_EUTRA_DelayForCellSelection);
    
    //@siclog "Step 2" siclog@
    //Change cell settings according to T1
    f_EUTRA_SetCellPowerList(v_CellPowerList_AtT1);
    
    //@siclog "Step 3" siclog@
    //Wait for 60s to ensure UE detects Cell 2
    f_Delay(60.0);
    
    //@siclog "Step 4" siclog@
    //SS re-adjusts cell-specific reference signal levels according to rows "T2" in table 6.1.2.6a.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_AtT2);

    //@siclog "Step 5" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 2 within the next 15s?
    f_EUTRA_CheckNoAttachOn1Cell(eutra_Cell2,
                                 15.0,
                                 "Test Case 6.1.2.6a Step 5 : RRCConnectionRequest message received on Cell 2 within wait time");
    
    //@siclog "Step 6" siclog@
    //Check: Does the UE send an RRCConnectionRequest on Cell 2 within the next 30s?
    t_ResponseTimer.start;
    if (f_EUTRA_RRC_ConnectionRequest_Common(eutra_Cell2, t_ResponseTimer)) {
      //* @verdict pass RRCConnectionRequest message received within t_ResponseTimer
      f_EUTRA_PreliminaryPass (__FILE__, __LINE__, "Test Case 6.1.2.6a Step 6");
      //@siclog "Step 7-10" siclog@
      //Step 7-10: Steps 2 to 5 of the generic test procedure in TS 36.508 subclause 6.4.2.7 are performed on Cell 2.
      f_EUTRA_TrackingAreaUpdate_WithoutRrcConnReq (eutra_Cell2);
    }
    else {
      //* @verdict fail No RRCConnectionRequest message received on Cell 2 within t_ResponseTimer time
      f_EUTRA_SetVerdictFailOrInconc (__FILE__, __LINE__, "Test Case 6.1.2.6a Step 6");
    }
    
    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell2, E1_IDLE);
  }

}
