          initialUE_Identity := p_InitUEId,
          rrc_TransactionIdentifier := p_RRC_Ti,
          criticalExtensions := {
            criticalExtensions := {
              criticalExtensions := {
                criticalExtensions := {
                  criticalExtensions := {
                    criticalExtensions := {
                      r9 := {
