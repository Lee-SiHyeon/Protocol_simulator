                                                                                            template (value) InterRATEventList                p_InterRATEventList := {cs_InterRATEvent3a_Def}) := // @sic R5s140120 sic@
  // Default values according to 36.508 Table 4.7B.1-3: MEASUREMENT CONTROL for Inter-RAT and special settings @sic R5s120686 sic@
  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cs_MeasurementControl_TDD_r9_ext(p_Integrityinfo,
                                     3,
