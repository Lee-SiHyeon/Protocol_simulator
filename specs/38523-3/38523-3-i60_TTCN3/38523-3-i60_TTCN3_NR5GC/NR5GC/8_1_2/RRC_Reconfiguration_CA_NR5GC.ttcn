module RRC_Reconfiguration_CA_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_CommonFunctions_CA all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_CA all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_FrequencyCommon all;
  import from NR_HandoverCommonFunctions all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_1_NR5GC() runs on NR5GC_PTC
  {
    //NR CA / RRC reconfiguration / SCell addition / modification / release / Success / Intra-band Contiguous CA
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_2_NR5GC() runs on NR5GC_PTC
  {
    //NR CA / RRC reconfiguration / SCell addition / modification / release / Success / Inter-band CA
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell10, CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_3_NR5GC() runs on NR5GC_PTC
  {
    //
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandNonContiguous);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_4_NR5GC() runs on NR5GC_PTC
  {
    //NR CA / RRC reconfiguration / SCell addition / modification / release / Success / Active MCG SCell addition / Intra-band Contiguous CA
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandContiguous, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_5_NR5GC() runs on NR5GC_PTC
  {
    //NR CA / RRC reconfiguration / SCell addition / modification / release / Success / Active MCG SCell addition / Intra-band non-contiguous CA
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell3, CA_IntraBandNonContiguous, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_6_NR5GC() runs on NR5GC_PTC
  {
    //NR CA / RRC reconfiguration / SCell addition / modification / release / Success / Active MCG SCell addition / Inter-band CA
    f_TC_8_1_2_1_5_x_NR_Common(nr_Cell1, nr_Cell10, CA_InterBand, activated);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.x
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_NR_CA_Tested
   * @param     p_SCellState        (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_2_1_5_x_NR_Common (NR_CellId_Type  p_PCell,
                                       NR_CellId_Type  p_SCell,
                                       NR_CA_Tested_Type p_NR_CA_Tested,
                                       template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                       ) runs on NR5GC_PTC
  { //@sic R5-227562: added p_SCellState sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0 :={ cs_NR_CellPower(p_SCell, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2 )};
    f_NR5GC_Init_CA(NR_1, {p_PCell, p_SCell}, p_NR_CA_Tested);

    // Create and configure cell
    f_NR_CellConfig_PCell_Def(p_PCell);
    f_NR_CellConfig_SCell(p_SCell, Scell_Active);

    // Preamble: according to TS 38.508-1, clause 4.4A.2 Table 4.4A.2-1
    f_NR5GC_Preamble (p_PCell, STATE_CONNECTED_3A, PING_Or_TEST_LOOPModeB_ON);  //@sic R5s201146 R5-204372 sic@
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    f_NR_TestBody_Set(true);
    f_TC_8_1_2_1_5_x_NR5GC_TestBody(p_PCell, p_SCell, p_SCellState);
    f_NR_TestBody_Set(false);

   //@sic R5s201146 R5-204372 R5s230130 sic@

    // Switch/Power off UE
    f_NR_Postamble(p_PCell, STATE_CONNECTED_3A);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.2.1.5.x
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_SCellState        (default value: omit)
   * @status    APPROVED (NR5GC)
   */
 function f_TC_8_1_2_1_5_x_NR5GC_TestBody(NR_CellId_Type  p_PCell,
                                          NR_CellId_Type  p_SCell,
                                          template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                          ) runs on NR5GC_PTC
 {  //@sic R5-227562: added p_SCellState sic@
    var template (value) CellGroupConfig v_SCGConfig;
    var SubFrameTiming_Type v_Timing;
    var template (value) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var boolean v_ActivateSCell := true;  //@sic R5-227562 sic@
    var template (value) ServingCellConfigCommon v_ServingCellConfigCommon := f_NR_GetServingCellConfigCommon(p_PCell);
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_PCell);
    var template (value) ServingCellConfig v_ServingCellConfig:= f_NR_GetServingCellConfig(p_PCell); //@sic R5s240616 R5-246226 sic@

    //@siclog Steps 1-2 siclog@
    //The SS transmits an RRCReconfigurationmessage containing an sCellToAddModList with SCell NR Cell 3 addition
    //Check: Does the UE transmits an RRCReconfigurationComplete message?
    f_NR5GC_AddMod_1SCell( p_PCell, p_SCell,-,-,-,-, p_SCellState);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");

    //@siclog "Step 3" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB1 and Cell 3?
    if (isvalue(p_SCellState)) {  //@sic R5-227562 sic@
        if (valueof(p_SCellState) == activated) {
            v_ActivateSCell := false; //SCell shall be activated without MAC CE indication
        }
    }
    f_NR5GC_CheckDataPath_CA(p_PCell, p_SCell, "Step 3", v_ActivateSCell );

    //@siclog "Steps 4-5" siclog@
    //The SS transmits an RRCReconfigurationmessage containing an sCellToAddModList with SCell NR Cell 3 modification.
    //Check: Does the UE transmit an RRCReconfigurationComplete message?
    v_SCGConfig := f_NR_GetSCGConfig_SCellAdd(p_SCell, tsc_NR_SCellIndex_1, -, -, -, -, p_SCellState);
    v_SCGConfig.sCellToAddModList[0].sCellConfigCommon := omit;
    v_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.pdsch_ServingCellConfig.setup.nrofHARQ_ProcessesForPDSCH := n16;        //@sic R5-212046 sic@
    //Set firstActiveDownlinkBWP_Id as per Table 8.1.2.1.5.1.1.3.3-4: ServingCellConfig
    //@sic R5-212046 sic@
    v_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.firstActiveDownlinkBWP_Id := omit;
    v_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.uplinkConfig  := omit;

    if (ispresent(p_SCellState)) {
    //Add reconfigurationWithSync for Tc 8.1.2.1.5.4/5/6
    //@sic R5-237353 sic@
        v_SCGConfig.spCellConfig := cs_NR_SpCellConfigDef(omit,cs_NR_ReconfigurationWithSyncDef(v_ServingCellConfigCommon, tsc_C_RNTI_Value3, -, omit), omit, v_ServingCellConfig);  //@sic R5s240616 sic@
        v_V1530Ext := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_SCGConfig)));
        //Partial HO Intra-Cell procedure with no RLC/PDCO re-establishment
        v_Timing := f_NR_GetNextSendOccasion_DL(p_PCell, tsc_NR_DelayBeforeIntraCellHO);

        SRB.send(cas_NR_SRB1_RrcPdu_REQ(p_PCell, cs_TimingInfo_NR(v_Timing), cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, -, -, -, v_V1530Ext), crs_MacBearerRouting(p_PCell))); // @sic R5s240616 sic@

        // At T + 5ms: Configure RACH procedure C-RNTI based
        v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, 5);
        f_NR_SS_C_RNTI_Config(p_PCell, tsc_C_RNTI_Value3, cs_TimingInfo_NR(v_Timing), tsc_NoCnfReq, tsc_FollowOnFlag);
        f_NR_SS_RachProcedureConfigHO(p_PCell, cs_NR_RachProcedureConfig_CRNTI_HO(v_NR_PhysicalParameters, tsc_C_RNTI_Value3), cs_TimingInfo_NR(v_Timing));
        f_NR_CellInfo_SetRNTI(p_PCell, tsc_C_RNTI_Value3);
        //Reconfigure SCell in SS
        f_NR_SS_CommonCellConfig(p_SCell, cads_NR_PDSCH_Config_REQ(p_SCell, cs_TimingInfo_NR(v_Timing), cs_NR_PDSCH_CellLevelConfigDef(v_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.pdsch_ServingCellConfig.setup)));

        // 38.523-3 cl 7.3.5.2 steps 9 & 10
        // @sic R5s240616 R5-246226 sic@
         SRB.receive(car_NR_SRB1_RrcPdu_IND(p_PCell, cr_38508_RRCReconfigurationComplete,-,crs_MacBearerRouting(p_PCell)));
        //Step 9 (after step 8) Re-configure RACH procedure as for initial access, enable TA transmissions.
        //NOTE 4: The FollowOnFlag is set to true in the ASP reconfiguring RACH.
        f_NR_SS_RachProcedureConfig_Def(p_PCell, -, tsc_NoCnfReq, tsc_FollowOnFlag); //@sic R5-206369 sic@
        // enable TA transmissions
        f_NR_ULGrantConfiguration_Common(p_PCell, -, -, cs_NR_UplinkTimeAlignment_Start, cs_UL_GrantConfig_OnSR);
    } else {
        v_V1530Ext := cs_NR_RRCReconfiguration_v1530_IEs(bit2oct(encvalue(v_SCGConfig)));
        v_Timing := f_NR_GetNextSendOccasion_DL(p_PCell);
        //Reconfigure SCell in SS
        f_NR_SS_CommonCellConfig(p_SCell, cads_NR_PDSCH_Config_REQ(p_SCell, cs_TimingInfo_NR(v_Timing), cs_NR_PDSCH_CellLevelConfigDef(v_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.pdsch_ServingCellConfig.setup)));
        //Send RRCReconfiguration to UE and wait for the complete
        f_NR_SendRRCReconfiguration(p_PCell, tsc_NR_RbId_SRB1, -, v_V1530Ext, -, -,cs_TimingInfo_NR(v_Timing), -, -, crs_MacBearerRouting(p_PCell));
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    //@siclog "Step 6" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB1 and Cell 3?
    f_NR5GC_CheckDataPath_CA(p_PCell, p_SCell, "Step 6", false);

    //@siclog "Steps 7-8" siclog@
    //The SS transmits an RRCReconfigurationmessage containing an sCellToReleaseList with SCell NR Cell 3.
    //Check: Does the UE transmit an RRCReconfigurationComplete message?
    f_NR5GC_Rel_1SCell(p_PCell, p_SCell);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 8");
  }

}
