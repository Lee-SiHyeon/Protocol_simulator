      }
      case (POS_C58es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_EPC_MO_LR_RequestPositionEstimate and pc_WLAN;
      }
      case (POS_C59es) {
        v_ApplCond := (pc_eFDD or pc_eTDD) and pc_WLAN;
      }
      case (POS_C60es) {
