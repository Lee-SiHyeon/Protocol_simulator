module RRC_IntraNR_Handover_NR5GC_IMS {

  import from IMS_Component all;
  import from IMS_NR5GC_Functions all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Registration all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.4.1.10.NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_1_4_1_10_NR5GC_IMS1() runs on IMS_PTC
  { // @sic R5s250299 sic@
    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration();
    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.4.1.10.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_4_1_10_NR5GC_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyRegistration();
    f_IMS_NR5GC_ECall(AUTOMATIC);
    f_IMS_IPCAN_WaitForTrigger(IPCAN); //Wait for the NR5GC component
    //@siclog "Step 7" siclog@
    //Release eCall over IMS using the generic procedure described in TS 34.229-5 [41] subclause A.8.
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrlUE); //@sic R5-251357 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
  }

}
