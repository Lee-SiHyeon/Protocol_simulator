  /*
   * @desc      Common Test body function for TCs 8.2.3.4.1 and 8.2.3.5.1
   * @param     p_TriggerEvent
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_Common_TestBody(NR_RRCMeasurement_TriggerEvent_Type p_TriggerEvent) runs on ENDC_NR_PTC
  {//@sic R5-206301, R5-206305 sic@ modified v_MeasConfig to be generated by f_NR_GenerateMeasurementConfigNR
    var integer v_ReceivedMeasurementReports := 0;
    var UL_DCCH_MessageType v_MeasurementReport;
      
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var integer v_NrofSS_BlocksToAverage;
    
    var template (value) MeasConfig v_MeasConfig;
    var PhysCellId v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    var template (present) MeasResults v_Expected_MeasResults :=  cr_38508_MeasResults(-, v_PhysCellId);
    var MeasResults v_ReceivedMeasResults;
    var RSRP_Range v_RsrpThres;
    var RSRP_Range v_AbsThreshSS_Rsrp;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0_T2;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T2_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T2_FR2;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR2;
    var DeltaValues_Type v_Deltas; //@sic R5-197223 sic@
    
    //TC-specific power-levels initialisation
    select (p_TriggerEvent) {
      case(triggerEvent_A1) {
        //@sic R5-187705, R5-187704, R5-195369 sic@
        //Cell Power levels according Table 8.2.3.4.1.3.2-1
        //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
        //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -               Power level is such that Ms  < Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -91
        //T1    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that entry condition for event A1 is satisfied Ms - Hys > Thresh
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79
        
        //Cell Power levels according Table 8.2.3.4.1.3.2-1A
        //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
        //T0    Cell-specific RS EPRE       dBm/15kHz       -96             -               Power level is such that Ms  < Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -100
        //T1    Cell-specific RS EPRE       dBm/15kHz       -96 -                           Power level is such that entry condition for event A1 is satisfied Ms - Hys > Thresh
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -82
        
        v_CellPower_T0_T2_FR1 := -91;
        v_CellPower_T0_T2_FR2 := -100;
        v_CellPowerList_AtT0_T2 := {
          cs_NR_CellPower(nr_Cell1, v_CellPower_T0_T2_FR1, v_CellPower_T0_T2_FR2) //@sic R5-186095, R5-195369 sic@
        };
        
        v_CellPower_T1_FR1 := -79;
        v_CellPower_T1_FR2 := -82;
        v_CellPowerList_AtT1 := {
          cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, v_CellPower_T1_FR2) //@sic R5-186095, R5-195369 sic@
        };
      }
      case(triggerEvent_A2) {
        //@sic R5-187705, R5-195369 sic@
        //Cell Power levels according Table 8.2.3.5.1.3.2-1
        //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
        //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -               Power level is such that Ms  > Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79
        //T1    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that entry condition for event A2 is satisfied Ms + Hys < Thresh
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -95
        //T2    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that exit condition for event A2 is satisfied Ms  > Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79
        
        //Cell Power levels according Table 8.2.3.5.1.3.2-1A
        //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
        //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -               Power level is such that Ms  > Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -82
        //T1    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that entry condition for event A2 is satisfied Ms + Hys < Thresh
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -100
        //T2    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that exit condition for event A2 is satisfied Ms  > Thresh + Hys
        //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -82
        
        
        v_CellPower_T0_T2_FR1 := -79;
        v_CellPower_T0_T2_FR2 := -82;
        v_CellPowerList_AtT0_T2 := {
          cs_NR_CellPower(nr_Cell1, v_CellPower_T0_T2_FR1, v_CellPower_T0_T2_FR2) //@sic R5-186095, R5-195369 sic@
        };
        
        v_CellPower_T1_FR1 := -95;
        v_CellPower_T1_FR2 := -100;
        v_CellPowerList_AtT1 := {
          cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, v_CellPower_T1_FR2) //@sic R5-186095, R5-195369 sic@
        };
        
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid Test Case Number");
      }
    }
    
    //Configure initial NR cell power
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT0_T2);
    
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including nr Config to setup intra NR measurement for NR Cell 1 and reporting for event A1
    v_Deltas :=   f_NR_MobileInfo_GetPrimaryDeltaValue(); //@sic R5-197223 sic@
    v_NrofSS_BlocksToAverage := 2; //@sic R5-206301, R5-206305 sic@
    
    //TC-specific Measurement Config initialisation
    select (p_TriggerEvent) {
      case(triggerEvent_A1) {
        //Table 8.2.3.4.1.3.3-3
        if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
        {
            v_RsrpThres := 72;           //@sic R5-190692, R5s190062, R5-191877 sic@
        }
        else
        {
            v_RsrpThres := 69 + v_Deltas.DeltaNRf1;            //@sic R5-195369, R5s190616, R5-197016, R5s190508, R5-197223 sic@
        }
        
        v_AbsThreshSS_Rsrp := 72;    //@sic R5-187704 sic@
       
        v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, v_AbsThreshSS_Rsrp, v_NrofSS_BlocksToAverage)};
        v_ReportConfigList := {cs_NR_ReportConfigEventA1(tsc_NR_IdReportConfigId1, v_RsrpThres, infinity_, 6)};    //@sic R5-185154, R5-190692, R5s190576 sic@
        v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
        v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-206301, R5-206305 sic@
      }
      case(triggerEvent_A2) {
        //Table 8.2.3.5.1.3.3-3
        if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
        {
            v_RsrpThres := 68;           //@sic R5-190683, R5s190060, R5-194853, R5s190116 sic@
        }
        else
        {
            v_RsrpThres := 66 + v_Deltas.DeltaNRf1;           //@sic R5-195369, R5-197223 sic@
        }
        v_AbsThreshSS_Rsrp := 68;    //@sic R5-187698, R5s190060, R5-192222 sic@
          
        v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, v_AbsThreshSS_Rsrp, v_NrofSS_BlocksToAverage)};
        v_ReportConfigList := {cs_NR_ReportConfigEventA2(tsc_NR_IdReportConfigId1, v_RsrpThres, infinity_)};    // @sic R5-186099 sic@
        v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
        v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-206301, R5-206305 sic@
       }
    }
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
    // @sic R5-192222 sic@ Removed verdict assignement for step 2
    
    //@siclog "Step 3" siclog@
    //The SS changes NR Cell y parameters according to the row "T1" in Table 8.2.3.x.1.3.2-1/A
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    //@siclog "Steps 4-5" siclog@
    //Receive Measurement Report
    while (v_ReceivedMeasurementReports < 4) {
      v_MeasurementReport := f_NR_ReceiveUlDcchMessageFromEUTRA(); //@sic R5-203405 sic@
      v_ReceivedMeasResults := v_MeasurementReport.c1.measurementReport.criticalExtensions.measurementReport.measResults;
      if (match(v_ReceivedMeasResults,v_Expected_MeasResults)) {  //@sic R5s190060 sic@
        f_NR_PreliminaryPass (__FILE__, __LINE__, "Steps 4-5");
      }
      else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Steps 4-5  wrong meas results");
      }
      v_ReceivedMeasurementReports := v_ReceivedMeasurementReports +1;    //@sic R5s190060 sic@
    }
    
    //@siclog "Step 6" siclog@
    //The SS changes NR Cell y parameters according to the row "T2" in Table 8.2.3.x.1.3.2-1/A
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT0_T2);
    
    //@siclog "Steps 7-8" siclog@
    //Running on EUTRA side
    
  } // End of fl_TC_8_2_3_Common_TestBody

  /*
   * @desc      Additional test body function for 8.2.3.4.1 to test onLeave setting
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_4_1_Additional_TestBody() runs on ENDC_NR_PTC
  {//@sic R5-206301, R5-206305 sic@ modified v_MeasConfig to be generated by f_NR_GenerateMeasurementConfigNR
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var UL_DCCH_MessageType v_MeasurementReport;
    
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var integer v_NrofSS_BlocksToAverage;
   
    var template (value) MeasConfig v_MeasConfig;
    var PhysCellId v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    var template (present) MeasResults v_Expected_MeasResults :=  cr_38508_MeasResults(-, v_PhysCellId);
    var MeasResults v_ReceivedMeasResults;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR2;
    var NR_AbsoluteCellPower_Type v_CellPower_T1_FR2;
    
    var RSRP_Range v_RsrpThres;
    var RSRP_Range v_AbsThreshSS_Rsrp;
    var Hysteresis v_Hysteresis;
    var DeltaValues_Type v_Deltas; //@sic R5-197223 sic@
    
    //Cell Power levels according Table 8.2.3.4.1.3.2-1
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -               Power level is such that Ms  < Thresh + Hys
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -91
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85 -                           Power level is such that entry condition for event A1 is satisfied Ms - Hys > Thresh
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79
    
    //Cell Power levels according Table 8.2.3.4.1.3.2-1A
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -96             -               Power level is such that Ms  < Thresh + Hys
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -100
    //T1    Cell-specific RS EPRE       dBm/15kHz       -96 -                           Power level is such that entry condition for event A1 is satisfied Ms - Hys > Thresh
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -82
        
    v_CellPower_T0_FR1 := -91;
    v_CellPower_T0_FR2 := -100;
    v_CellPowerList_AtT0 := {
      cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, v_CellPower_T0_FR2) //@sic R5-186095, R5-195369 sic@
    };
        
    v_CellPower_T1_FR1 := -79;
    v_CellPower_T1_FR2 := -82;
    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, v_CellPower_T1_FR1, v_CellPower_T1_FR2) //@sic R5-186095, R5-195369 sic@
    };
        
    //@siclog "Steps 9-10" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration message to setup NR measurement  and reporting of event A4.
    v_NrofSS_BlocksToAverage := 2;
    v_Hysteresis := 6;
    v_AbsThreshSS_Rsrp := 72;
    v_Deltas :=   f_NR_MobileInfo_GetPrimaryDeltaValue(); //@sic R5-197223 sic@
      
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        v_RsrpThres := 72;           //@sic R5-190692, R5s190062, R5-191877 sic@
    }
    else
    {
        v_RsrpThres := 69 + v_Deltas.DeltaNRf1;           //@sic R5-195369, R5s190616, R5-197016, R5s190508, R5-197223 sic@
    }
        
    //Table 8.2.3.4.1.3.3-9
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, v_AbsThreshSS_Rsrp, v_NrofSS_BlocksToAverage)};
    v_ReportConfigList := {cs_NR_ReportConfigEventA1(tsc_NR_IdReportConfigId1, v_RsrpThres, r1, v_Hysteresis, true)};    //@sic R5-187704, R5s190586 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-206301, R5-206305 sic@
    
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Step 11" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1"
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);
    
    //@siclog "Step 12" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message to report event A1 with the measured [Results] value for NR Cell 1?
    v_MeasurementReport := f_NR_ReceiveUlDcchMessageFromEUTRA(); //@sic R5-203405 sic@
    v_ReceivedMeasResults := v_MeasurementReport.c1.measurementReport.criticalExtensions.measurementReport.measResults;
    if (not(match(v_ReceivedMeasResults, v_Expected_MeasResults))) {    //@sic R5s190062 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12 -  wrong meas results");
    }
    
    //@siclog "Step 13" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T2"
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);
      
    //@siclog "Step 14" siclog@
    //Check: Does the UE transmit a MeasurementReport encapsulated in ULInformationTransferMRDC message to report event A1 with the measured [Results] value for NR Cell 1?
    v_MeasurementReport := f_NR_ReceiveUlDcchMessageFromEUTRA(); //@sic R5-203405 sic@
    v_ReceivedMeasResults := v_MeasurementReport.c1.measurementReport.criticalExtensions.measurementReport.measResults;
    if (match(v_ReceivedMeasResults, v_Expected_MeasResults)) {    //@sic R5s190062 sic@
      f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 14");
    }
    else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14 -  wrong meas results");
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A3 /Measurement of Neighbour NR cells / Intra-frequency measurements / EN-DC
    f_TC_8_2_3_6_1_Common(nr_Cell2);    //@sic R5-195365, R5-195366 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1a.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1a_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A3 / Measurement of Neighbour NR cell / Inter-frequency measurements / EN-DC
    f_TC_8_2_3_6_1_Common(nr_Cell3);    //@sic R5-195365, R5-195366 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.6.1b.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_6_1b_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A3 / Measurement of Neighbour NR cell / Inter-band measurements / EN-DC
    f_TC_8_2_3_6_1_Common(nr_Cell10);    //@sic R5-195365, R5-195366 sic@
  }

  /*
   * @desc     Common/identical code for  8.2.3.6.1, 8.2.3.6.1a, 8.2.3.6.1b
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */

  function f_TC_8_2_3_6_1_Common(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A3 /Measurement of Neighbour NR cells / Intra-frequency measurements / EN-DC
    f_ENDC_NR_Init();
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5s190155, R5-195929, R5-195369 sic@
    f_NR_CellInfo_InitMaxReferencePower(p_NR_CellId, -79, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5-195929 sic@
    
    //Create and configure NR cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(p_NR_CellId);
    
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5-195369, R5s210089, R5s210379 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_6_1x_TestBody(p_NR_CellId);    //@sic R5-195365, R5-195366 sic@
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_3_6_1x
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_6_1x_TestBody(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var NR_AbsoluteCellPower_Type v_CellPower_Serving_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_EntryCondition_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_LeavingCondition_FR1;
    var NR_AbsoluteCellPower_Type v_CellPower_Serving_FR2;
    var NR_AbsoluteCellPower_Type v_CellPower_EntryCondition_FR2;
    var NR_AbsoluteCellPower_Type v_CellPower_LeavingCondition_FR2;

    var RSRP_Range v_AbsThreshSS_Rsrp;
    var RSRP_Range v_RsrpThres;
    var DeltaValues_Type v_Deltas := f_NR_MobileInfo_GetPrimaryDeltaValue();

    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (value) MeasGapConfig v_MeasGapUE;
    
    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var template (present) MeasResults v_Expected_MeasResults;
     
    //TC-specific power-levels initialisation
    //Cell Power levels according Table 8.2.3.6.1.3.2-1
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2  Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -           -          Power levels are such that entry condition for event A3 is not satisfied for any of the neighbour NR cells:
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -              -85         -91
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85             -           -          Power levels are such that entry condition for event A3 is satisfied for intra-frequency neighbour NR cell (measId 1):
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -              -85         -79
    
    //Cell Power levels according Table 8.2.3.6.1.3.2-1A
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2  Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -           -          Power levels are such that entry condition for event A3 is not satisfied for any of the neighbour NR cells:
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -              --91         -100
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85             -           -          Power levels are such that entry condition for event A3 is satisfied for intra-frequency neighbour NR cell (measId 1):
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -              -91         -82
    
    
    v_CellPower_Serving_FR1 := -85;
    v_CellPower_LeavingCondition_FR1 := -91;
    v_CellPower_EntryCondition_FR1 := -79;
    
    v_CellPower_Serving_FR2 := -91;
    v_CellPower_LeavingCondition_FR2 := -100;
    v_CellPower_EntryCondition_FR2 := -82;
     
    v_CellPowerList_AtT0 := {cs_NR_CellPower(nr_Cell1, v_CellPower_Serving_FR1, v_CellPower_Serving_FR2),
                             cs_NR_CellPower(p_NR_CellId, v_CellPower_LeavingCondition_FR1, v_CellPower_LeavingCondition_FR2)};    //@sic R5s200527 sic@
    v_CellPowerList_AtT1 := {cs_NR_CellPower(p_NR_CellId, v_CellPower_EntryCondition_FR1, v_CellPower_EntryCondition_FR2)};    //@sic R5s190155, R5s200527 sic@
    
    //SS re-adjusts the cell-specific reference signal level according to row "T0"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT0);
      
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration to setup measurements for neighbour NR Cells and reporting for event A3
    //The UE transmits an RRCReconfigrationComplete message
    v_RsrpThres := 2;   //@sic R5-194848, R5s190155 sic@
    if(not(f_NR_CellInfo_GetIsFR1(nr_Cell1)))
    {
        v_RsrpThres := v_RsrpThres + v_Deltas.DeltaNRf2 - v_Deltas.DeltaNRf1 ;    //@sic R5-199096 sic@
    }
    v_AbsThreshSS_Rsrp := 59;
    
    select(p_NR_CellId)
    {
        case (nr_Cell2)
        {
            v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell2, v_AbsThreshSS_Rsrp)};
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
        }
        
        case(nr_Cell3, nr_Cell10)
        {
            v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, omit, omit),
                                     cs_MeasObjectId2(p_NR_CellId, omit, omit)};
            
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
            v_MeasGapUE := cds_MeasGapConfig_UE(f_NR_GetGapConfig_InterFreqOdd(nr_Cell1, p_NR_CellId));    //@sic R5-199097 sic@
            f_NR_SS_MeasGapCtrlConfig(nr_Cell1, cs_NR_MeasGapCtrl_Config(v_MeasGapUE));    //@sic R5-199097 sic@
        }
    }
    

    v_ReportConfigList := {cs_NR_ReportConfigEventA3(tsc_NR_IdReportConfigId1, v_RsrpThres, r1)};
      
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-192854, R5-199097 sic@
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message within the next 10s to report event A3?
    //Done on the EUTRA side
      
    //@siclog "Step 4-5" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T1"
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A3 (measId 1) with the measured value for NR Cell 2?
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellIdNeighbour:= f_NR_CellInfo_GetPhysicalCellId(p_NR_CellId);
    v_Expected_MeasResults := cr_38508_MeasResults_NeighCellsNR(tsc_NR_MeasId1, v_PhysCellIdServing, {cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour)});
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT1, v_Expected_MeasResults, "Step 5");
      
  } // End of fl_TC_8_2_3_6_1x_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.7.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_7_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A4 / Measurement of Neighbour NR cell / Intra-frequency measurements / EN-DC
    f_TC_8_2_3_7_1_Common(nr_Cell2);    //@sic R5-196118, R5-196119 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.7.1a.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_7_1a_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A4 / Measurement of Neighbour NR cell / Inter-frequency measurements / EN-DC
    f_TC_8_2_3_7_1_Common(nr_Cell3); //@sic R5-196118 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.7.1b.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_7_1b_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A4 / Measurement of Neighbour NR cell / Inter-band measurements / EN-DC
    f_TC_8_2_3_7_1_Common(nr_Cell10); //@sic R5-196119 sic@
  }

  /*
   * @desc     Common/identical code for  8.2.3.7.1, 8.2.3.7.1a, 8.2.3.7.1b
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */

  function f_TC_8_2_3_7_1_Common(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  { //@sic R5-196118, R5-196119 sic@
    f_ENDC_NR_Init();
    f_NR_CellInfo_InitMaxReferencePower(p_NR_CellId, -79, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5-195929, R5-195369 sic@
        
    //Create and configure NR cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(p_NR_CellId);
    
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1 [4], clause 4.5.4.
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5-195369, R5s210089, R5s210379 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_7_1x_TestBody(p_NR_CellId);    //@sic R5-195365, R5-195366 sic@
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_3_7_1x
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_7_1x_TestBody(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  { //@sic R5-196118, R5-196119 sic@
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var NR_AbsoluteCellPower_Type v_CellPower_EntryConditionFR1;
    var NR_AbsoluteCellPower_Type v_CellPower_LeavingConditionFR1;
    var NR_AbsoluteCellPower_Type v_CellPower_EntryConditionFR2;
    var NR_AbsoluteCellPower_Type v_CellPower_LeavingConditionFR2;
    
    var RSRP_Range v_RsrpThres;

    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (value) MeasGapConfig v_MeasGapUE;

    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var template (present) MeasResults v_Expected_MeasResults;
    var DeltaValues_Type v_Deltas;  //@sic R5s190508, R5-197223 sic@

    
    //TC-specific power-levels initialisation
    //Cell Power levels according Table 8.2.3.7.1.3.2-1
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2   Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           The power level values are such that entry condition for event A4 is not satisfied
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -88         OFF
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           The power level values are such that entry condition for event A4 is satisfied for intra-frequency neighbour NR Cell 2
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -88         -79
    //T2    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           The power level values are such that entry conditions for event A4 is not satisfied for intra-frequency neighbour NR Cell 2
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -88         -91
    
    //Cell Power levels according Table 8.2.3.7.1.3.2-1A
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2   Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           The power level values are such that entry condition for event A4 is not satisfied
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -91         OFF
    //T1    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           The power level values are such that entry condition for event A4 is satisfied for intra-frequency neighbour NR Cell 2
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -91         -82
    //T2    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           The power level values are such that entry conditions for event A4 is not satisfied for intra-frequency neighbour NR Cell 2
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -91         -100
    
    
    v_CellPower_EntryConditionFR1 := -79;
    v_CellPower_LeavingConditionFR1 := -91;
      
    v_CellPower_EntryConditionFR2 := -82;
    v_CellPower_LeavingConditionFR2 := -100;

    v_CellPowerList_AtT0 := {
      cs_NR_CellPower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2), //@sic R5-195369 sic@
      cs_NR_CellPower(p_NR_CellId, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };

    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(p_NR_CellId, v_CellPower_EntryConditionFR1, v_CellPower_EntryConditionFR2)    //@sic R5-195369 sic@
    };

    v_CellPowerList_AtT2 := {
      cs_NR_CellPower(p_NR_CellId, v_CellPower_LeavingConditionFR1, v_CellPower_LeavingConditionFR2) //@sic R5-195369 sic@
    };
    
   
    //The SS re-adjusts the cell-specific reference signal level according to row "T0"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT0);
    
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration message to setup NR measurement  and reporting of event A4.
    v_Deltas :=   f_NR_MobileInfo_GetPrimaryDeltaValue(); //@sic R5s190508, R5-197223 sic@
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
    {
        v_RsrpThres := 71;
    }
    else
    {
        v_RsrpThres := 66 + v_Deltas.DeltaNRf1;           //@sic R5-195369, R5s190618, R5-197016, R5-197223, R5-195369, R5s200485 sic@
    }
    
    select(p_NR_CellId)
    {
        case(nr_Cell2)
        {
            v_MeasuredObjectList := {cs_MeasObjectId1(p_NR_CellId)};
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
        }
        
        case(nr_Cell3, nr_Cell10)
        {
             v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, omit, omit),
                                     cs_MeasObjectId2(p_NR_CellId, omit, omit)};
            
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
            v_MeasGapUE := cds_MeasGapConfig_UE(f_NR_GetGapConfig_InterFreqOdd(nr_Cell1, p_NR_CellId));        //@sic R5-199097 sic@
            f_NR_SS_MeasGapCtrlConfig(nr_Cell1, cs_NR_MeasGapCtrl_Config(v_MeasGapUE));    //@sic R5-199097 sic@
        }
    }
    v_ReportConfigList := {cs_NR_ReportConfigEventA4(tsc_NR_IdReportConfigId1, v_RsrpThres, infinity_, ms1024)};
      
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-192798, @sic R5-199097 sic@ sic@
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
    
    //@siclog "Step 3-5" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T1"
    //Check: Does the UE transmit ULInformationTransferMRDC message containing NR MeasurementReport message to report event A4 with the measured Results for NR Cell 2?
    //EXCEPTION: Step 5 below is repeated until 3 MeasurementReport messages are received from the UE
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellIdNeighbour := f_NR_CellInfo_GetPhysicalCellId(p_NR_CellId);
    v_Expected_MeasResults := cr_38508_MeasResults_NeighCellsNR(tsc_NR_MeasId1, v_PhysCellIdServing, {cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour)});
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT1, v_Expected_MeasResults, "Steps 4-5", 4);
    
    
    //@siclog "Step 6" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T2"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT2);
    
    //@siclog "Step 7-8" siclog@
    //Running on EUTRA side
  } // End of fl_TC_8_2_3_7_1_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.8.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_8_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A5 / Measurement of Neighbour NR cell / Intra-frequency measurements / EN-DC
    f_TC_8_2_3_8_1_Common(nr_Cell2);    //@sic R5-195367, R5-195368 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.8.1a.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_8_1a_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A5 / Measurement of Neighbour NR cell / Inter-frequency measurements / EN-DC
    f_TC_8_2_3_8_1_Common(nr_Cell3);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.8.1b.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_8_1b_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A5 / Measurement of Neighbour NR cell / Inter-band measurements / EN-DC
    f_TC_8_2_3_8_1_Common(nr_Cell10);
  }

  /*
   * @desc     Common/identical code for 8.2.3.8.1, 8.2.3.8.1a, 8.2.3.8.1b
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_8_1_Common(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Event A5 / Measurement of Neighbour NR cell / Intra-frequency measurements / EN-DC
    
    f_ENDC_NR_Init();
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -78, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5-194851, R5s190416, R5-195929, R5-204455 sic@
    f_NR_CellInfo_InitMaxReferencePower(p_NR_CellId, -84, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5s190416, R5-195712, R5-195929, R5s200426, R5-204455 sic@
    
    //Create and configure NR cells
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(p_NR_CellId);
      
    //The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (EN-DC) and DC Bearers (MCG and SCG) on E-UTRA Cell 1 according to TS 38.508-1 [4], clause 4.5.4.
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5s210089, R5s210379 sic@
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_8_1x_TestBody(p_NR_CellId);    //@sic R5-195367, R5-195368 sic@
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_3_8_1x
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_8_1x_TestBody(NR_CellId_Type p_NR_CellId) runs on ENDC_NR_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT3;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT4;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT5;

    var NR_AbsoluteCellPower_Type v_ServingCellPower_noEntry_A5_FR1;
    var NR_AbsoluteCellPower_Type v_ServingCellPower_Entry_A5_FR1;
    var NR_AbsoluteCellPower_Type v_ServingCellPower_Leave_A5_FR1;
    var NR_AbsoluteCellPower_Type v_NeighbourCellPower_noEntry_A5_FR1;
    var NR_AbsoluteCellPower_Type v_NeighbourCellPower_Entry_A5_FR1;
    
    //FR2 power-relevant variables @sic R5-195712 sic@
    var NR_AbsoluteCellPower_Type v_A5_1_Fullfilled_FR2;
    var NR_AbsoluteCellPower_Type v_A5_1_NotFullfilled_FR2;
    var NR_AbsoluteCellPower_Type v_A5_2_Fullfilled_FR2_T1;
    var NR_AbsoluteCellPower_Type v_A5_2_Fullfilled_FR2_T2;
    var NR_AbsoluteCellPower_Type v_A5_2_NotFullfilled_FR2;
    var NR_AbsoluteCellPower_Type v_A5_3_Fullfilled_FR2;
    var NR_AbsoluteCellPower_Type v_A5_4_Fullfilled_FR2;
    //var NR_AbsoluteCellPower_Type v_A5_4_NotFullfilled_FR2;
    
    var RSRP_Range v_RsrpThres1;
    var RSRP_Range v_RsrpThres2;
    var DeltaValues_Type v_Deltas;  //@sic R5s195712 sic@
    var RSRP_Range v_AbsThreshSS_Rsrp;

    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasGapConfig v_MeasGapUE;
    var template (value) MeasConfig v_MeasConfig;

    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var template (present) MeasResults v_Expected_MeasResults;

    var Hysteresis v_Hysteresis := 0; //@sic R5-194851, R5s190169 sic@
    
    //TC-specific power-levels initialisation  @sic R5-187705, R5-194851 sic@
    //Cell Power levels according Table 8.2.3.8.1.3.2-1,  Table 8.2.3.8.1.3.2-1A
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2   Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that entry condition for event A5 is not satisfied, i.e. condition A5-1 ( ) is fulfilled but condition A5-2 ( ) is not fulfilled for intra-frequency neighbour NR Cell 2.
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -91
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that entry condition for event A5 is not satisfied, i.e. condition A5-1 ( ) is not fulfilled but condition A5-2 ( ) is fulfilled for intra-frequency neighbour NR Cell 2.
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -73         -85
    //T2    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that entry condition for event A5 is satisfied, i.e. condition A5-1 ( ) and condition A5-2 ( ) are fulfilled for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 starts).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -85
    //T3    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that leaving condition for event A5 is satisfied, i.e. condition A5-3 ( ) is satisfied but condition A5-4 ( ) is not satisfied for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 stops).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -73         -85
    //T4    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that entry condition for event A5 is satisfied, i.e. condition A5-1 ( ) and condition A5-2 ( ) are fulfilled for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 starts).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -85
    //T5    Cell-specific RS EPRE       dBm/15kHz       -85             -           -           Power levels are such that leaving condition for event A5 is satisfied, i.e. condition A5-3 ( ) is not satisfied but condition A5-4 ( ) is satisfied for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 stops).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -91
    
    v_ServingCellPower_noEntry_A5_FR1 := -78;      //@sic R5-194851, R5s190169, R5-204455 sic@
    v_ServingCellPower_Entry_A5_FR1 := -90;        //@sic R5-201018, R5-204455 sic@
    v_ServingCellPower_Leave_A5_FR1 := -78;        //@sic R5-204455 sic@
    v_NeighbourCellPower_noEntry_A5_FR1 := -96;    //@sic R5-204455 sic@
    v_NeighbourCellPower_Entry_A5_FR1 := -84;      //@sic R5-201018, 5-204455 sic@
      
   //TC-specific power-levels initialisation  @sic R5-195712 sic@
   //Cell Power levels according Table 8.2.3.8.1.3.2-1A
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1   NR Cell 2   Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that entry condition for event A5 is not satisfied, i.e. condition A5-1 ( ) is fulfilled but condition A5-2 ( ) is not fulfilled for intra-frequency neighbour NR Cell 2.
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -100        -100
    //T1    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that entry condition for event A5 is not satisfied, i.e. condition A5-1 ( ) is not fulfilled but condition A5-2 ( ) is fulfilled for intra-frequency neighbour NR Cell 2.
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -82         -91
    //T2    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that entry condition for event A5 is satisfied, i.e. condition A5-1 ( ) and condition A5-2 ( ) are fulfilled for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 starts).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -85
    //T3    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that leaving condition for event A5 is satisfied, i.e. condition A5-3 ( ) is satisfied but condition A5-4 ( ) is not satisfied for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 stops).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -73         -85
    //T4    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that entry condition for event A5 is satisfied, i.e. condition A5-1 ( ) and condition A5-2 ( ) are fulfilled for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 starts).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -85
    //T5    Cell-specific RS EPRE       dBm/15kHz       -96             -           -           Power levels are such that leaving condition for event A5 is satisfied, i.e. condition A5-3 ( ) is not satisfied but condition A5-4 ( ) is satisfied for intra-frequency neighbour NR Cell 2 (i.e. periodical reporting for event A5 stops).
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -79         -91
    
    //@sic R5-195712 sic@
    v_A5_1_Fullfilled_FR2 := -100;
    v_A5_2_NotFullfilled_FR2 := -109;  //@sic R5-204455 sic@
    v_A5_1_NotFullfilled_FR2 := -82;
    v_A5_2_Fullfilled_FR2_T1 := -91;
    v_A5_2_Fullfilled_FR2_T2 := -82;
    v_A5_3_Fullfilled_FR2 := -82;
    //v_A5_4_NotFullfilled_FR2 := -100;
    v_A5_4_Fullfilled_FR2 := -100;
       
      
   v_CellPowerList_AtT0 := {
      cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Entry_A5_FR1, v_A5_1_Fullfilled_FR2),
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_noEntry_A5_FR1, v_A5_2_NotFullfilled_FR2)
    };
    
    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, v_ServingCellPower_noEntry_A5_FR1, v_A5_1_NotFullfilled_FR2),
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_Entry_A5_FR1, v_A5_2_Fullfilled_FR2_T1)
    };

    v_CellPowerList_AtT2 := {
      cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Entry_A5_FR1, v_A5_1_Fullfilled_FR2),         //Neigbour cell remains "Entry"
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_Entry_A5_FR1, v_A5_2_Fullfilled_FR2_T2)
    };

    v_CellPowerList_AtT3 := {
      cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Leave_A5_FR1, v_A5_3_Fullfilled_FR2),        //Neigbour cell remains "Entry"
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_Entry_A5_FR1, v_A5_2_Fullfilled_FR2_T2)    //@sic R5-204455 sic@
    };

    v_CellPowerList_AtT4 := {
      cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Entry_A5_FR1, v_A5_1_Fullfilled_FR2),        //Neigbour cell remains "Entry"
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_Entry_A5_FR1, v_A5_2_Fullfilled_FR2_T2)
    };
    
    v_CellPowerList_AtT5 := {
      cs_NR_CellPower(p_NR_CellId, v_NeighbourCellPower_noEntry_A5_FR1, v_A5_4_Fullfilled_FR2)     //Serving cell remains "Entry" @sic R5a191163 sic@
    };
     
    
    //The SS re-adjusts the cell-specific reference signal level according to row "T0"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT0);
    
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration message to setup measurements for neighbour NR Cells and reporting for event A5.
    if(f_NR_CellInfo_GetIsFR1(nr_Cell1))
        {
            v_RsrpThres1 := 72; //@sic R5-194851, R5-201018, R5-204455 sic@
            v_RsrpThres2 := 66; //@sic R5-194851, R5-201018, R5-204455 sic@
        }
        else
        {//@sic R5-195712, R5-202651 sic@
            v_Deltas :=   f_NR_MobileInfo_GetPrimaryDeltaValue();
            select(p_NR_CellId)
            {
                case (nr_Cell2)
                {
                    v_RsrpThres1 := 65 + v_Deltas.DeltaNRf1;    //@sic R5-204455 sic@
                    v_RsrpThres2 := 56 + v_Deltas.DeltaNRf1;    //@sic R5-204455 sic@
                }
                case(nr_Cell3, nr_Cell10)
                {
                    v_RsrpThres1 := 66 + v_Deltas.DeltaNRf2;
                    v_RsrpThres2 := 57 + v_Deltas.DeltaNRf2;
                }
            }
        }
    
    v_AbsThreshSS_Rsrp := 60;
    
    select(p_NR_CellId)
    {
        case (nr_Cell2)
        {
            v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell2, v_AbsThreshSS_Rsrp)};
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};
        }
        
        case(nr_Cell3, nr_Cell10)
        {
            v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, omit, omit),
                                     cs_MeasObjectId2(p_NR_CellId, omit, omit)};
            
            v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
            v_MeasGapUE := cds_MeasGapConfig_UE(f_NR_GetGapConfig_InterFreqOdd(nr_Cell1, p_NR_CellId));        //@sic R5-199097 sic@
            f_NR_SS_MeasGapCtrlConfig(nr_Cell1, cs_NR_MeasGapCtrl_Config(v_MeasGapUE));    //@sic R5-199097 sic@
            
        }
    }
    v_ReportConfigList := {cs_NR_ReportConfigEventA5(tsc_NR_IdReportConfigId1, v_RsrpThres1, v_RsrpThres2, infinity_, ms1024, - ,v_Hysteresis )};  //@sic R5-194851, R5s190169 sic@
    
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);  //@sic R5-192854, R5-199097 sic@
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
      
    
    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message within the next 10s?
    //Runs on EUTRA side
    
    //@siclog "Step 4" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T1"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT1);
    
    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A5 with the measured value for NR Cell 2?
    //Runs on EUTRA side
    
    //EXCEPTION: Steps 5a1-5a2 are executed in case of FR2  @sic R5-195712 sic@
    //@siclog "Steps 5a1-5a2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration message to setup measurements for neighbour NR Cells and reporting for event A5.
    //Check: Does the UE transmit an RRCConnectionReconfigurationComplete message containing NR RRCReconfigurationComplete message?
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1});
    if(not(f_NR_CellInfo_GetIsFR1(nr_Cell1)))
    {
         select(p_NR_CellId)
        {//@sic R5-202651 sic@
            case (nr_Cell2)
            {
            v_RsrpThres1 := 65 + v_Deltas.DeltaNRf1;    //@sic R5-204455 sic@
            v_RsrpThres2 := 65 + v_Deltas.DeltaNRf1;    //@sic R5-204455 sic@
            }
            case(nr_Cell3, nr_Cell10)
            {
                v_RsrpThres1 := 66 + v_Deltas.DeltaNRf2;
                v_RsrpThres2 := 66 + v_Deltas.DeltaNRf2;
            }
        }
        v_ReportConfigList := {cs_NR_ReportConfigEventA5(tsc_NR_IdReportConfigId1, v_RsrpThres1, v_RsrpThres2, infinity_, ms1024, - ,v_Hysteresis )};
    
        v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList); ///@sic R5s240046 sic@
        f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
    }
    
    //@siclog "Steps 6-8" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T2"
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A5 with the measured value for NR Cell 2?
    //EXCEPTION: Step 8 below is repeated until 3 MeasurementReport messages are received from the UE.
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellIdNeighbour := f_NR_CellInfo_GetPhysicalCellId(p_NR_CellId);
    v_Expected_MeasResults := cr_38508_MeasResults_NeighCellsNR(tsc_NR_MeasId1, v_PhysCellIdServing, {cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour)});
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT2, v_Expected_MeasResults, "Steps 7-8", 4);

    //@siclog "Step 9" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T3"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT3);
    
    //@siclog "Step 10-11" siclog@
    //Running on EUTRA side
        
    //@siclog "Steps 12-13" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T4"
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A5 with the measured value for NR Cell 2?
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT4, v_Expected_MeasResults, "Step 13");
    
    
    //@siclog "Step 14" siclog@
    //SS re-adjusts the cell-specific reference signal level according to row "T5"
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT5);
    
    //@siclog "Step 15-16" siclog@
    //Running on EUTRA side
    
  } // End of fl_TC_8_2_3_8_1x_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.11.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_11_1_ENDC_NR() runs on ENDC_NR_PTC
  {//Measurement configuration control and reporting / Measurement Gaps / NR FR1 / EN-DC
  
    f_ENDC_NR_Init();
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE); //FR2 not applicable
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell3, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE); //FR2 not applicable

    //Create and configure NR cell1 and cell3
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);

    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5s230787 sic@
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_11_1_ENDC_NR_TestBody ();
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }// end f_TC_8_2_3_11_1_ENDC_NR

  /*
   * @desc      test body of TC_8_2_3_11_1_ENDC_NR
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_11_1_ENDC_NR_TestBody() runs on ENDC_NR_PTC
  {//@sic R5-206301, R5-206305 sic@ modified v_MeasConfig to be generated by f_NR_GenerateMeasurementConfigNR
    var template (value) MeasConfig v_MeasConfig;
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) ReportConfigNR v_ReportConfig; //@sic R5-206632 sic@
      
    var RSRP_Range v_AbsThreshSS_Rsrp_Cell1and3;
    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var NR_AbsoluteCellPower_Type v_CellPower_T0_FR1 := -88;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (present) MeasResults v_Expected_MeasResults;
    var MeasResults v_ReceivedMeasResults; //@sic R5s240058 sic@
    var EUTRA_NR_Coordination_MSG v_ReceivedMsg;
    var bitstring v_ULInfoMRDC;
    var UL_DCCH_Message v_MeasurementReport;
    var integer v_Counter;
    var template (omit) MeasGapConfig v_MeasGapFR1;
    var B9_Type v_SupportedGaps := substr(f_ENDC_DeriveSupportedGapsFromPics(), 0, 9); //@sic T6s240506, R5s240058 sic@
    var B9_Type v_GapMask := int2bit(1, 9);  //@sic R5s240506, R5s240058, R5s230787 sic@

    timer t_Watchdog;

    v_CellPowerList_AtT0 :=
        {cs_NR_CellPower(nr_Cell1, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE), //FR2 is not applicable
         cs_NR_CellPower(nr_Cell3, v_CellPower_T0_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE) //FR2 is not applicable
        };
    
    ///The SS re-adjusts the cell-specific reference signal level according to row "T0"
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"ChangePower" );
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    //@siclog "Steps 11-12" siclog@
    //The SS transmits an RRCConnectionReconfiguration including measConfig to setup fr1-Gap and
    //nr-Config IE containing measConfig to report periodical measurements for NR serving Cell 1 and
    //NR neighbor cell 3 on FR1 frequency
    //The UE transmits an RRCConnectionReconfigurationComplete message to confirm the setup of fr1-Gap
    //and report periodical measurements for NR serving Cell 1 and NR neighbor cell 3 on FR1 frequency
    v_AbsThreshSS_Rsrp_Cell1and3 := 51;

    //Table 8.2.3.11.1.3.3-9
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, v_AbsThreshSS_Rsrp_Cell1and3),
                             cs_MeasObjectId2(nr_Cell3, v_AbsThreshSS_Rsrp_Cell1and3)};
            
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj2_conf1};
    v_MeasGapFR1 := cds_MeasGapConfig_FR1(cs_NR_GapConfig(9, ms6, ms40, ms0dot5));  //@sic R5-203403 sic@
    
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5s230787 sic@
    
    v_ReportConfig := cs_38508_ReportConfigNR_Periodical; //@sic R5-206632 sic@
    v_ReportConfig.reportType.periodical.reportQuantityCell := cs_NR_MeasReportQuantity_RsrpRsrq; //@sic R5-206632 sic@
    v_ReportConfig.reportType.periodical.maxReportCells := 1; //@sic R5-206632 sic@
    v_ReportConfigList := {cs_NR_ReportConfigToAddMod_NR(tsc_NR_IdReportConfigId1, v_ReportConfig)}; //@sic R5-206632 sic@
    
    
    v_MeasConfig := f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList, v_MeasGapFR1); //@sic R5-203403, R5-206301, R5-206305 sic@
       
    f_NR_SendRRCReconfigurationContentsToEUTRA (omit, omit, v_MeasConfig, omit, false); //@sic R5s230787 sic@
    // Get Security info from EUTRA, calculate latest keys and configure SS
    f_ENDC_GetKeysActivateSecurity(nr_Cell1, EUTRA); //@sic R5s230787 sic@
    f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "Complete"); //@sic R5s230787 sic@


    //@siclog "Step 14" siclog@
    //Wait for 30 s to ensure that the UE performs a periodical inter frequency reporting.
    //EXCEPTION: In parallel to events described in step 4 the steps specified in table 8.2.3.11.2.3.2-3 shall take place
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_PhysCellIdNeighbour := f_NR_CellInfo_GetPhysicalCellId(nr_Cell3);
    
    v_Expected_MeasResults := cr_38508_MeasResults_NeighCellsNR(tsc_NR_MeasId1, v_PhysCellIdServing, {cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour)}); //@sic R5s230787 sic@
    
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA,"StartTimer" );
    t_Watchdog.start(30.0);
    alt
    {
        []EUTRA.receive(cmr_EUTRA_NR_OctetData ("ULInfoTransferMRDC")) -> value v_ReceivedMsg
        {
            v_ULInfoMRDC := oct2bit(v_ReceivedMsg.OctetData.Data);
            v_Counter := decvalue(v_ULInfoMRDC, v_MeasurementReport);
            if (v_Counter != 0)
            {
                FatalError(__FILE__, __LINE__, "Decoding error");
            }
            v_ReceivedMeasResults := v_MeasurementReport.message_.c1.measurementReport.criticalExtensions.measurementReport.measResults;
            if(match(v_ReceivedMeasResults,v_Expected_MeasResults)) //@sic R5s240058 sic@
            {
               f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 14");
            }
            else
            {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14 -  wrong meas results"); //@sic R5s230787 sic@
            }
            repeat;
        }
        [] t_Watchdog.timeout
        {
            //do nothing
        }

    }

    //@siclog "Step 15-17" siclog@
    //EXCEPTION:    Steps 15 to 17 shall be repeated for k=1 to 13 (increment=1)
    v_Counter := 1;
    while (v_Counter <= 11) //@sic R5s240506, R5s230787 sic@
    {
        if(v_Counter != 1)
        {
          if (bit2int(v_SupportedGaps and4b v_GapMask) == 1)
          {
            fl_NR_ReconfigGapAndGetMeasResultssteps_15_17(v_Expected_MeasResults);
          }
          v_SupportedGaps := v_SupportedGaps  @> 1;
        } //@sic R5s230787 sic@
        if(v_Counter == 2)
        {v_Counter := v_Counter + 1;
        } //@sic R5s240506 sic@

        v_Counter := v_Counter + 1;
    }

    //@siclog "Step 18-19" siclog@
    //SS transmits an RRCConnectionReconfiguration message including measConfig to release fr1-Gap and measid of periodical measurements.
    //The UE transmits an RCConnectionReconfigrationComplete message
    v_MeasConfig := cs_NR_MeasConfigCommon(omit, omit,omit, omit, {tsc_NR_MeasId1},omit, omit, omit, cds_MeasGapRelease_FR1);
    f_NR_SendRRCReconfigurationContentsToEUTRA (omit, omit, v_MeasConfig, omit, false); //@sic R5s230787 sic@
    f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "Complete"); //@sic R5s230787 sic@

  } // fl_TC_8_2_3_11_1_ENDC_NR_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.12.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_12_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Inter-RAT measurements / Event B1 / Measurement of NR cells / EN-DC
  
    f_ENDC_NR_Init();
    
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -79, -79); //@sic R5-200625, R5s190067, R5-195929 sic@ //FR2 not applicable

    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_12_1_ENDC_NR_TestBody ();
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_3_12_1_ENDC_NR
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_12_1_ENDC_NR_TestBody() runs on ENDC_NR_PTC
  {
    var NR_AbsoluteCellPower_Type v_CellPower_T1_T2_T3_T4_FR1 := -79; //@sic R5-200625, R5-187705 sic@
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T5_FR1 := -91; //@sic R5-200625, R5-187705 sic@
    var NR_AbsoluteCellPower_Type v_CellPower_T1_T2_T3_T4_FR2 := -88; //@sic R5-200625, R5-187705 sic@
    var NR_AbsoluteCellPower_Type v_CellPower_T0_T5_FR2 := -100; //@sic R5-200625, R5-187705 sic@
    
    // Set SS/PBCH SSS EPRE for T0
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPower(nr_Cell1, v_CellPower_T0_T5_FR1, v_CellPower_T0_T5_FR2); //@sic R5-200625, R5-187705 sic@ //FR2 not applicable
    
    // Send SysInfo from NR Cell1 to EUTRA
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1});
    
    // @siclog "Step 4" siclog@
    // Set SS/PBCH SSS EPRE for T1
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPower(nr_Cell1, v_CellPower_T1_T2_T3_T4_FR1, v_CellPower_T1_T2_T3_T4_FR2); //@sic R5-200625, R5-187705 sic@ //FR2 not applicable
    
    // @siclog "Step 14" siclog@
    // Set SS/PBCH SSS EPRE for T5
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);
    f_NR_SetCellPower(nr_Cell1, v_CellPower_T0_T5_FR1, v_CellPower_T0_T5_FR2); //@sic R5-200625, R5-187705 sic@ //FR2 not applicable
    
    // Test body now finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.15.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_15_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / Two simultaneous events A2
    f_ENDC_NR_Init();
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5-195929, R5-201477 sic@
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell2, -78, tsc_NR_ServingCellSSS_EPRE_FR2); //@sic R5-195929, R5-201477 sic@

    //Create and configure NR cell1 and NR cell 2
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell2);
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_15_1_TestBody();
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  } // End of f_TC_8_2_3_15_1_ENDC_NR()

  /*
   * @desc      test body of TC_8_2_3_15_1
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_15_1_TestBody () runs on ENDC_NR_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    
    var NR_AbsoluteCellPower_Type v_ServingCellPower_NoEntry_A2andA3_FR1;
    var NR_AbsoluteCellPower_Type v_ServingCellPower_Entry_A2_NoEntry_A3_FR1;
    var NR_AbsoluteCellPower_Type v_ServingCellPower_Entry_A3_NoEntry_A2_FR1;
   
    var NR_AbsoluteCellPower_Type v_NeighbourCellPower_NoEntry_A2andA3_FR1;
    var NR_AbsoluteCellPower_Type v_NeighbourCellPower_Entry_A2_NoEntry_A3_FR1;
    var NR_AbsoluteCellPower_Type v_NeighbourCellPower_Entry_A3_NoEntry_A2_FR1;

    var RSRP_Range v_AbsThreshSS_ServingCell;
    //@sic R5-197072 sic@ var RSRP_Range v_AbsThreshSS_NeighbourCell;
    var RSRP_Range v_RsrpThres_A2;
    var RSRP_Range v_RsrpThres_A3;

    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    

    var PhysCellId v_PhysCellIdServing;
    var PhysCellId v_PhysCellIdNeighbour;
    var template (present) MeasResults v_Expected_MeasResults;


    
    //TC-specific power-levels initialisation
    //Cell Power levels according Table 8.2.3.15.1.3.2-1
    //          Parameter                   Unit        E-UTRA Cell 1   NR Cell 1       NR Cell 2       Remark
    //T0    Cell-specific RS EPRE       dBm/15kHz       -85             -               -               Power levels are such that entry condition for event A2 and event A3 is not satisfied
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -85             -103
    //T1    Cell-specific RS EPRE       dBm/15kHz       -85 -                                           Power level of Cell 1 is such that entry condition for event A2 is satisfied for the serving cell
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -103            -113            AND Power levels of Cell 1 and Cell 2 are such that entry condition for event A3 is not satisfied for any of the neighbour NR cells
    //T2    Cell-specific RS EPRE       dBm/15kHz       -85 -                                           Power levels are such that entry condition for event A2 is not satisfied for the serving cell
    //      SS/PBCH SSS EPRE            dBm/SCS15kHz    -               -85             -78             AND Power levels of Cell 1 and Cell 2 are such that entry condition for event A3 is satisfied for intra-frequency neighbour NR cell
        
      
    v_ServingCellPower_NoEntry_A2andA3_FR1 := -85;           //@sic R5-201477 sic@
    v_ServingCellPower_Entry_A2_NoEntry_A3_FR1 := -103;
    v_ServingCellPower_Entry_A3_NoEntry_A2_FR1 := -85;
    v_NeighbourCellPower_NoEntry_A2andA3_FR1 := -103;        //@sic R5s190419, R5-197072 sic@
    v_NeighbourCellPower_Entry_A2_NoEntry_A3_FR1 := -113;    //@sic R5-201477 sic@
    v_NeighbourCellPower_Entry_A3_NoEntry_A2_FR1 := -78;     //@sic R5-201477 sic@
   
        
    v_CellPowerList_AtT0 :=
    {
        cs_NR_CellPower(nr_Cell1, v_ServingCellPower_NoEntry_A2andA3_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
        cs_NR_CellPower(nr_Cell2, v_NeighbourCellPower_NoEntry_A2andA3_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
    v_CellPowerList_AtT1 :=
    {
        cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Entry_A2_NoEntry_A3_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
        cs_NR_CellPower(nr_Cell2, v_NeighbourCellPower_Entry_A2_NoEntry_A3_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
    v_CellPowerList_AtT2 :=
    {
        cs_NR_CellPower(nr_Cell1, v_ServingCellPower_Entry_A3_NoEntry_A2_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE),
        cs_NR_CellPower(nr_Cell2, v_NeighbourCellPower_Entry_A3_NoEntry_A2_FR1, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };
     
    
    //Configure initial NR cell power
    f_NR_WaitForEUTRATrigger_And_ChangePower(v_CellPowerList_AtT0);
    
    //@siclog "Steps 1-2" siclog@
    //The SS transmits an RRCConnectionReconfiguration message containing NR RRCReconfiguration to setup measurement for PSCell and reporting for event A2, and measurement for neighbour NR Cell and reporting for event A3 (intra-frequency measurement)
    v_AbsThreshSS_ServingCell := 54;
    //@sic R5-197072 sic@ v_AbsThreshSS_NeighbourCell := 88;
    v_RsrpThres_A2 := 63;    //@sic R5-201477 sic@
    v_RsrpThres_A3 := 0;

    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1, v_AbsThreshSS_ServingCell)};
                             //@sic R5-197072 sic@ cs_MeasObjectId2(nr_Cell2, v_AbsThreshSS_NeighbourCell)};
    v_ReportConfigList := {cs_NR_ReportConfigEventA2(tsc_NR_IdReportConfigId1, v_RsrpThres_A2, r1),     //@sic R5-194854 sic@
                           cs_NR_ReportConfigEventA3(tsc_NR_IdReportConfigId2, v_RsrpThres_A3, r1)};    //@sic R5-194854 sic@
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1,
                           cs_NR_MeasId_Config_id2_obj1_conf2};  //@sic R5-197072 sic@
      
    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);
    f_NR_SendRRCReconfigurationContentsToEUTRA_Meas(v_MeasConfig); //@sic R5-198871 sic@
     
    //@siclog "Step 3" siclog@
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message within the next 10s to report event A2 or A3
    //Done on EUTRA side
      
    //@siclog "Steps 4-5" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T1".
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A2 (measId 1) with the measured value for NR Cell 1?
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_Expected_MeasResults := cr_38508_MeasResults(tsc_NR_MeasId1, v_PhysCellIdServing);
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT1, v_Expected_MeasResults, "Step 5");
    
    
    //@siclog "Steps 6-7" siclog@
    //The SS re-adjusts the cell-specific reference signal level according to row "T2".
    //Check: Does the UE transmit an ULInformationTransferMRDC message containing NR MeasurementReport message to report event A3 (measId 2) with the measured value for NR Cell 2?
    v_PhysCellIdNeighbour:= f_NR_CellInfo_GetPhysicalCellId(nr_Cell2);
    v_Expected_MeasResults := cr_38508_MeasResults_NeighCellsNR(tsc_NR_MeasId2, v_PhysCellIdServing, {cr_NR_MeasResultNR_CellResults(v_PhysCellIdNeighbour)});
    f_NR_ChangePower_And_ReceiveMeasReportsFromEUTRA(v_CellPowerList_AtT2, v_Expected_MeasResults, "Step 7");
 
  } // End of fl_TC_8_2_3_15_1_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.16.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_16_1_ENDC_NR() runs on ENDC_NR_PTC
  { // Measurement configuration control and reporting / SRB3 / Intra NR measurements / EN-DC
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_SCG);
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_16_1_ENDC_NR_TestBody ();
    f_NR_TestBody_Set(false);
    
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_2_3_16_1_ENDC_NR
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_16_1_ENDC_NR_TestBody() runs on ENDC_NR_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RadioBearerConfig v_RadioBearerConfig1;
    var template (omit) octetstring v_EncodedSCG_Config := omit;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerToAddModList;
    var template (value) NR_RadioBearerList_Type v_RadioBearerList;
    var PhysCellId v_PhysCellIdServing;
    var template (value) MeasObjectParamsList_Type v_MeasuredObjectList;
    var template (value) ReportConfigToAddModList v_ReportConfigList;
    var template (value) MeasIdToAddModList v_MeasIdConfigList;
    var template (value) MeasConfig v_MeasConfig;
    var template (present) MeasResults v_MeasResults; //@sic R5s201080 sic@
    
    // @siclog "Step 1" siclog@
    v_RadioBearerConfig1 := cs_38508_RadioBearerConfigDef({cs_NR_SRB_ToAddMod(tsc_SRB3)}, -, -, cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig(f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), secondary));
    v_RLC_BearerToAddModList := {cs_38508_RLC_BearerConfig_SRB(tsc_SRB3)};
    v_SCGConfig := cs_38508_CellGroupConfig(tsc_NR_CellGroupId_SCG, v_RLC_BearerToAddModList);
    
    //SS : configure SRB1 with RLCAckProhibit
    v_RadioBearerList := {cs_NR_SS_RadioBearer_Config(tsc_NR_RbId_SRB3,cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsSRB),
                                                     cs_NR_RlcBearerConfig_SRB1SRB2SRB3(f_NR_LogicalChannelId_SRB(tsc_SRB3), tsc_NR_SRB3_LogicalChannelPriority),omit)}; //@sic R5s201218 sic@

    f_NR_SS_CommonRadioBearerConfig(nr_Cell1, v_RadioBearerList, cs_TimingInfo_Now); //Configure SRB3 on NR
    f_NR_SendRRCReconfigurationContentsToEUTRA (v_RadioBearerConfig1, v_SCGConfig);  // Now send octetstrings to EUTRA //@sic R5s201080 sic@
    f_ENDC_GetKeysActivateSecurity(nr_Cell1, EUTRA); //@sic R5s201080 sic@

    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA);

    // @siclog "Step 3" siclog@
    // The SS transmits an RRCReconfiguration to setup periodical intra-NR measurements and reporting on NR Cell 1 via SRB3
    v_SCGConfig := cs_NR_CellGroupConfigMeas(tsc_NR_CellGroupId_SCG,  //@sic R5s200612 sic@
                                                   cs_NR_SpCellConfigDef(tsc_NR_CellGroupId_SCG,
                                                                       -,
                                                                       -,
                                                                       cs_NR_ServingCellConfigMeas(tsc_NR_MeasObjectId1))); //@sic R5s201080 sic@

    v_EncodedSCG_Config := bit2oct(encvalue(v_SCGConfig));
    v_MeasuredObjectList := {cs_MeasObjectId1(nr_Cell1)};
    v_ReportConfigList := cs_NR_ReportConfigToAddModList_1Entry(tsc_NR_IdReportConfigId1, cs_38508_ReportConfigNR_Periodical);
    v_MeasIdConfigList := {cs_NR_MeasId_Config_id1_obj1_conf1};

    v_MeasConfig :=f_NR_GenerateMeasurementConfigNR(v_MeasuredObjectList, v_ReportConfigList, v_MeasIdConfigList);
    SRB.send(cas_NR_SRB3_RrcPdu_REQ(nr_Cell1, -, cs_38508_RRCReconfiguration(tsc_NR_RRC_TI_Def, -, v_EncodedSCG_Config, v_MeasConfig)));
    
    // @siclog "Step 4" siclog@
    // Check: Does the UE transmits an RRCReconfigurationComplete message via SRB3?
    SRB.receive(car_NR_SRB3_RrcPdu_IND(nr_Cell1, cr_38508_RRCReconfigurationComplete));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");

    // @siclog "Step 5" siclog@
    // Check: Does the UE transmits at least 10 MeasurementReport messges to periodically report the measured RSRP value for NR Cell 1
    // via SRB3 within the next 30 seconds?
    v_PhysCellIdServing := f_NR_CellInfo_GetPhysicalCellId(nr_Cell1);
    v_MeasResults := cr_38508_MeasResults(tsc_NR_MeasId1, v_PhysCellIdServing); //@sic R5s201080 sic@
    f_NR_ReceivePeriodicalMeasurementReports(nr_Cell1, 30.0, 10, cr_NR_MeasurementReport(v_MeasResults), false); //@sic R5s201080 sic@

    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    activate(a_NR_AddDefault_IgnorePeriodicalMeasurmentReport_SRB3(nr_Cell1, cr_NR_MeasurementReport(v_MeasResults))); //@sic R5s201080 sic@
    
    // Test body now finished
    f_EUTRA_NR_SendCoOrd (EUTRA, cms_EUTRA_NR_Trigger);

  } // End of fl_TC_8_2_3_16_1_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.3.17.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_8_2_3_17_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Measurement configuration control and reporting / SFTD / EN-DC
  
    f_ENDC_NR_Init();
    
    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(nr_Cell1, MCG_Only);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5s230611 sic@
    f_NR_TestBody_Set(true);
    fl_TC_8_2_3_17_1_ENDC_NR_TestBody ();
    f_NR_TestBody_Set(false);
    
    // Send Trigger to EUTRA indicating Finish of Test Body
    f_EUTRA_NR_SendCoOrd(EUTRA, cms_EUTRA_NR_Trigger);

    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    //Postamble
    f_NR_ReleaseAllCells();
  } //End of f_TC_8_2_3_17_1_ENDC_NR()

  /*
   * @desc      test body of TC_8_2_3_17_1_ENDC_NR
   * @status    APPROVED (ENDC)
   */
  function fl_TC_8_2_3_17_1_ENDC_NR_TestBody() runs on ENDC_NR_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    
    //@siclog "Steps 1-3" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup inter-RAT SFTD measurement on NR neighbour cell (NR Cell 1)
    //The UE transmits an RRCConnectionReconfigurationComplete message.
    //Check: Does the UE transmit a MeasurementReport message including measResultCellListSFTD within the next 5s? NOTE 1
    //Run on EUTRA side
    
    //@siclog "Step 4-5" siclog@
    //The SS transmits an RRCConnectionReconfiguration including nr-SecondaryCellGroupConfig messages to add NR Cell 1 as PSCell.
    f_NR_SS_CommonRadioBearerConfig(nr_Cell1, {f_NR_GetRadioBearerConfig_FullAM_DRB2(nr_Cell1)});
    v_RadioBearerConfig := cs_NR_RadioBearer(2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get());
    v_SCGConfig := f_NR_GetSCGConfigDef(nr_Cell1);
    f_NR_SendCoOrdSysInfoToEUTRA({nr_Cell1}); //@sic R5s230611 sic@
    f_NR_SendRRCReconfigurationContentsToEUTRA(v_RadioBearerConfig, v_SCGConfig, omit, omit, false, reconfigurationWithSync_CheckRACH);
    // Get Security info from EUTRA, calculate latest keys and configure SS
    f_EUTRA_NR_WaitForCoOrd_Data(EUTRA, "Complete"); //@sic R5s230611 sic@
    f_ENDC_GetKeysActivateSecurity(nr_Cell1, EUTRA);
       
    //@siclog "Step 6-8" siclog@
    //The SS transmits an RRCConnectionReconfiguration message including MeasConfig to setup intra-frequency SFTD measurement on NR PSCell (NR Cell 1)
    //The UE transmits an RRCConnectionReconfigurationComplete message.
    //Check: Does the UE transmit a MeasurementReport message including measResultCellListSFTD within the next 3s? NOTE 2
    //Run on EUTRA side
    
  }//End of l_TC_8_2_3_17_1_ENDC_NR_TestBody()

}
