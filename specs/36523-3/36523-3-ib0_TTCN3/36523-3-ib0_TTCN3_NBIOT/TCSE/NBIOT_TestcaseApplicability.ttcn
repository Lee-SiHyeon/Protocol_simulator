module NBIOT_TestcaseApplicability {

  import from EUTRA_Parameters all;
  import from NBIOT_36523_SelectionExpressions all;
  import from NBIOT_Parameters all;
  import from TestcaseProperties all;

  /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause 11.5 EUTRA MFBI for NB-IOT
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_ExecutionGuideline(charstring p_TestCase) return boolean
  { //@sic R5-193738 sic@
    var boolean v_ExecutionGuideline := true;
    
    v_ExecutionGuideline := (f_ExecutionGuideline_NBIOT_MFBI(p_TestCase)  // execution guideline from cl 11.5
                             );
    return v_ExecutionGuideline;
  }

    /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause 11.5 for NB-IOT
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (NBIOT)
   */
  function f_ExecutionGuideline_NBIOT_MFBI(charstring p_TestCase) return boolean
  {
    var boolean v_ExecutionGuideline := true;
    
    //List of MFBI bands according to 36.523-3 Table 11.5-4
    if (not(( px_OverlappingNotSupportedFrequencyBand_MFBI == 2 and px_MFBI_FrequencyBand == 25) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 5 and (px_MFBI_FrequencyBand == 18 or px_MFBI_FrequencyBand == 19 or px_MFBI_FrequencyBand == 26)) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 12 and px_MFBI_FrequencyBand == 17) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 17 and (px_MFBI_FrequencyBand == 12 or px_MFBI_FrequencyBand == 85)) or //@sic R5-193738 sic@
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 19 and (px_MFBI_FrequencyBand == 5 or px_MFBI_FrequencyBand == 26)) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 25 and px_MFBI_FrequencyBand == 2) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 26 and (px_MFBI_FrequencyBand == 5 or px_MFBI_FrequencyBand == 18 or px_MFBI_FrequencyBand == 19)) or
            ( px_OverlappingNotSupportedFrequencyBand_MFBI == 85 and px_MFBI_FrequencyBand == 17)       //@sic R5-193738 sic@
            )) {
      select (p_TestCase) {
        case ("TC_22_2_10") {
          v_ExecutionGuideline := false;
        }
       }
      }

    return v_ExecutionGuideline;
  }

  /*
   * @desc      Applicability for NBIOT test cases
   * @param     p_Condition
   * @param     p_TestcaseName
   * @return    boolean
   * @status    APPROVED (NBIOT)
   */
  function f_NBIOT_TestcaseApplicability(NBIOT_36523_Condition_Type p_Condition,
                                         charstring p_TestcaseName) return boolean
  {
    var boolean v_Applicability := true;
    var boolean v_NTN_GSO := f_GetTestcaseAttrib_NTN_Only_GSO(p_TestcaseName);
    var boolean v_NTN_NGSO := f_GetTestcaseAttrib_NTN_Only_NGSO(p_TestcaseName);

    if (pc_NB_ntn_only_Connectivity_EPC) {
      if (not ((pc_NB_ntn_GSO_ScenarioSupport and v_NTN_GSO) or (pc_NB_ntn_NGSO_ScenarioSupport and v_NTN_NGSO))) {
        v_Applicability := false;
      }
    }
    v_Applicability := v_Applicability and f_NBIOT_ExecutionGuideline(p_TestcaseName);
    v_Applicability := v_Applicability and f_NBIOT_SelectionExpr(p_Condition);

    return v_Applicability;
  }

}
