  template (value) UL_LogicalChannelMappings_r8 cs_UL_LogicalChannelMappings_E_DCH_fixedSize_r8(LogicalChannelIdentity  p_LogicalChannelIdUL := tsc_UL_DTCH1,
                                                                                                E_DCH_MAC_d_FlowIdentity p_E_DCH_MAC_d_FlowIdentity := tsc_E_DCH_MAC_d_FlowId_DTCH1,
