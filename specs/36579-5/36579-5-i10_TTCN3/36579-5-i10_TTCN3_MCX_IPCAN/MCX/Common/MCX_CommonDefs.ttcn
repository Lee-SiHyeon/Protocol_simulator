  type enumerated MCX_InitialConfiguration_UriUsage_Type { resource_lists, xcap_diff, http_get };                               /* @status    APPROVED (MCX) */

  type enumerated MCX_InitialConfiguration_Condition_Type { UECONFIG, UEUSERPROF, UESERVCONFIG, GROUPCONFIG, GROUPKEY };        /* @status    APPROVED (MCX) */

  /*
   * @desc      Build up URI used during initial configuration
   * @param     p_ServiceType
   * @param     p_Usage
   * @param     p_Condition
   * @param     p_GroupId           (default value: omit)
   * @param     p_MCSUEID           (default value: omit)
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_InitialConfiguration_BuildURI(MCX_ServiceType_Type p_ServiceType,
                                               MCX_InitialConfiguration_UriUsage_Type p_Usage,
                                               MCX_InitialConfiguration_Condition_Type p_Condition,
                                               template (omit) charstring p_GroupId := omit,
                                               template (omit) charstring p_MCSUEID := omit) return charstring
  { /* @sic R5-212294: p_GroupId sic@ */
    var integer v_ProfileIndex := f_MCX_MCService_ProfileId(p_ServiceType);
    var charstring v_XUID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var charstring v_RootUriCMS := "";
    var charstring v_RootUriGMS := "";
    var charstring v_DocumentName_ue_config := "";
    var charstring v_DocumentName_user_profile := "";
    var charstring v_DocumentName_service_config := "service-config.xml";
    var charstring v_ServicePrefix := f_StringToLower(f_MCX_ServiceName(p_ServiceType));
    var charstring v_GroupId;
    var charstring v_AUID;
    var charstring v_URI;

    if (isvalue(p_GroupId)) {
      v_GroupId := valueof(p_GroupId);
    } else {
      v_GroupId := f_MCX_MCService_GroupID_Group_A(p_ServiceType);
    }

    if (p_Usage == http_get) {
      v_RootUriCMS := tsc_MCX_CMSXCAPRootURI & "/";    // @sic R5w210209: absolute URI sic@
      v_RootUriGMS := tsc_MCX_GMSXCAPRootURI & "/";    // @sic R5w210209: absolute URI sic@
    }
    if (p_Usage != resource_lists) {
      v_DocumentName_ue_config := v_ServicePrefix & "ue-configuration.xml";
      v_DocumentName_user_profile := v_ServicePrefix & "user-profile-" & int2str(v_ProfileIndex) & ".xml";
    }

    select (p_Condition) {
      case (UECONFIG) {
        v_AUID := "org.3gpp." & v_ServicePrefix & ".ue-config";
        if (isvalue(p_MCSUEID)) {
          v_URI := v_RootUriCMS & v_AUID & "/users/"  & v_XUID & "/" & valueof(p_MCSUEID) & "/" & v_DocumentName_ue_config;
        } else {
          v_URI := v_RootUriCMS & v_AUID & "/users/"  & v_XUID & "/" & v_DocumentName_ue_config;
        }
      }
      case (UEUSERPROF) {
        v_AUID := "org.3gpp." & v_ServicePrefix & ".user-profile";
        v_URI := v_RootUriCMS & v_AUID   & "/users/"  & v_XUID & "/" & v_DocumentName_user_profile;
      }
      case (UESERVCONFIG) {
        v_AUID := "org.3gpp." & v_ServicePrefix & ".service-config";
        v_URI := v_RootUriCMS & v_AUID & "/global/" & v_DocumentName_service_config;
      }
      case (GROUPCONFIG) {
        v_URI := v_RootUriGMS & "org.openmobilealliance.groups/global/byGroupID/" & v_GroupId;
      }
      case (GROUPKEY) {
        v_URI := v_RootUriGMS & "org.3gpp.MCPTT-GKTP/global/byGroupID/" & v_GroupId & "/~~/group/list-service/mgktp:GKTPs?xmlns(mgktp=urn:3gpp:ns:mcpttGKTP:1.0)";
      }
    }
    return v_URI;
  }

  /*
   * @desc      return MCPTT/MCVideo session type for given CallType
   * @param     p_CallType
   * @return    template (omit) charstring
   * @status    APPROVED (MCX)
   */
  function f_MCX_MCServiceInfo_SessionType(MCX_CallType_Type p_CallType) return template (omit) charstring
  {
    var template (omit) charstring v_SessionType := omit;
    
    select (p_CallType) {
      case (GROUP_CALL, GROUP_REJOIN) { v_SessionType := "prearranged"; }
      case (PRIVATE_CALL)             { v_SessionType := "private"; }
      case (CHAT_GROUP_CALL)          { v_SessionType := "chat"; }
      case (FIRST_TO_ANSWER)          { v_SessionType := "first-to-answer"; }
    }
    return v_SessionType;
  }

  /*
   * @desc      dummy function as work-around for Titan not handling charstring and universal charstring as compatible
   * @param     charstring
   * @return    charstring
   * @status    APPROVED (MCX)
   */
  function f_UniCharstring2Charstring(universal charstring p_UniCharstring) return charstring
  { // !!!! 2023/03/08: function to be removed, when there are no complains, i.e. when is clear that no old versions of Titan are used anymore and Titan is used with compiler option -h !!!!
    //var charstring v_Charstring := oct2char(unichar2oct(p_UniCharstring));
    var charstring v_Charstring := p_UniCharstring;

    return v_Charstring;
  }

  type XmlBody XmlBody_Type;            /* @status    APPROVED (MCX) */

  /*
   * @desc      Another dummy function to cope with incompatibilities of charstring and universal charstring
   * @param     charstring
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_UniCharstring2XmlBody(universal charstring p_UniCharstring) return XmlBody_Type
  {
    return f_UniCharstring2Charstring(p_UniCharstring);
  }

  /*
   * @desc      Alias function to convert bitstring to XmlBody_Type
   * @param     p_BitString
   * @return    XmlBody_Type
   * @status    APPROVED (MCX)
   */
  function f_Bit2XmlBody(bitstring p_BitString) return XmlBody_Type
  {
    return f_Bit2Char(p_BitString);
  }

  /*
   * @desc      Alias function to convert XmlBody_Type to bitstring
   * @param     p_XmlBody
   * @return    bitstring
   * @status    APPROVED (MCX)
   */
  function f_XmlBody2Bit(XmlBody_Type p_XmlBody) return bitstring
  {
    return f_Char2Bit(p_XmlBody);
  }

  type enumerated XML_Log_Type {UPLINK, DOWNLINK};                          /* @status    APPROVED (MCX) */

  external function fx_XML_Log(charstring p_FileName,
                               LineNo_Type p_LineNo,
                               XML_Log_Type p_UplinkDownlink,
                               universal charstring p_XmlDocument);

  /*
   * @desc      Convert latitude coordinate into value according to 23.032 clause 6.1
   * @param     p_Degrees
   * @return    integer
   * @status    APPROVED (MCX)
   */
  function f_MCX_LocationInfo_Degrees2Latitude(float p_Degrees) return integer
  {
    var integer v_TwoExp23 := 8388608;
    var float v_Degrees := p_Degrees;
    var integer v_Sign := 0;
    var integer N;

    if ((p_Degrees < -90.0) or (p_Degrees > 90.0)) {
      FatalError(__FILE__, __LINE__, "latitude out of range");
    }

    if (p_Degrees < 0.0) {
      v_Degrees := v_Degrees * -1.0;
      v_Sign := v_TwoExp23;                                     // most significant bit of 24 bit value
    }
    N := float2int((v_Degrees * int2float(v_TwoExp23)) / 90.0); // 23.032 clause 6.1
    return v_Sign + N;
  }

  /*
   * @desc      Convert longitude coordinate into value according to 23.032 clause 6.1
   * @param     p_Degrees
   * @return    integer
   * @status    APPROVED (MCX)
   */
  function f_MCX_LocationInfo_Degrees2Longitude(float p_Degrees) return integer
  {
    var integer v_TwoExp24 := 16777216;

    if ((p_Degrees < -180.0) or (p_Degrees > 180.0)) {
      FatalError(__FILE__, __LINE__, "longitude out of range");
    }
    return float2int(int2float(v_TwoExp24) * (1.0 + (p_Degrees / 360.0))) mod v_TwoExp24;       /* 23.032 clause 6.1:
                                                                                                   N := (2^24 / 360) * X; with X: p_Degrees = -180.0 .. 180.0
                                                                                                   by adding 2^24, N gets 2's complement binary in case of negative X;
                                                                                                   in case of positive X the addition of 2^24 does not change N due to the modulo operation */
  }

}
