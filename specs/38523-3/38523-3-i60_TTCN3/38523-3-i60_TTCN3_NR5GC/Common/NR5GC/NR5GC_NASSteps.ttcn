module NR5GC_NASSteps {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from Common4G5G_LoopBack all;
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from CommonIP all;
  import from EPS_NAS_LoopBack_TypeDefs all;
  import from EUTRA_NR_Parameters all;
  import from EUTRA_NR_SecurityFunctions all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from NAS_5GC_Parameters all;
  import from NAS_AuxiliaryDefsAndFunctions all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_SecurityFunctions all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NG_NasEmu_CtrlFunctions all;
  import from NG_SecurityDefinitionsAndExternalFunctions all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_LoopBack all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_NTN_Configuration all;
  import from NR_PDCP_Templates all;
  import from NR_Parameters all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_Timing all;
  import from NasEmu_Common4G5G all;
  import from Parameters all;
  import from SDAP_TypeDefs all;
  import from TestcaseProperties all;
  import from UpperTesterCommon all;
  import from UpperTesterFunctions all;

  type record NAS_SecurityReturnType {  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    NasCount_Type           NasCount,
    NG_NAS_UL_Message_Type  NasMsg  optional
  };

  type record of SDAP_Configuration_Type SDAP_ConfigurationList_Type ;  /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */

  type enumerated PreamblePreconfigureData {NoNTN, UAS, ATG};           /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */

  type record of PreamblePreconfigureData PreamblePreconfigureDataList; /* @status    APPROVED (NR5GC, NR5GC_IRAT, POS) */

  type record of IMS_MediaToBeAdded_Type ListOfMedia_Type; /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT) */

  template (value) NAS_SecurityReturnType cs_NAS_SecurityReturnValue(NasCount_Type p_Count,
                                                                     template (omit) NG_NAS_UL_Message_Type p_NasMsg) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
    NasCount := p_Count,
    NasMsg   := p_NasMsg
  };

  template (value) IntraN1TransparentContainer cs_IntraN1TransparentContainer (template (omit) O4_Type p_Mac,
                                                                                B4_Type  p_CiphAlg,
                                                                                B4_Type  p_IntAlg,
                                                                                B1_Type  p_Kacf,
                                                                                B1_Type  p_Tsc,
                                                                                B3_Type  p_Ksi5G,
                                                                                O1_Type  p_SequenceNum) :=
  { /* @status    APPROVED (NR5GC) */
    /* 24.501 cl. 9.11.2.6 */
    mac             := p_Mac,
    ciphAlg         := p_CiphAlg,
    intAlg          := p_IntAlg,
    spareBits       := tsc_Spare3,
    kacf            := p_Kacf,
    tsc             := p_Tsc,
    ksi5G           := p_Ksi5G,
    sequenceNum     := p_SequenceNum
  };

  template (value) NR_UE_TestLoopModeC_LB_Setup_Type cs_UE_TestLoopModeC_LB_Setup_Def (B5_Type p_LogicalChannelIdMtch := '00000'B):= /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS) */
  { /* @status    APPROVED (IMS, NR5GC_IRAT) */
    //Bits shall be set as according to 38.509 clause 6.3 - 3 octets
    reserved := '0000000'B,
    countMBSBroadcast := '1'B,
    mRBId := '0000'B,
    logicalChannelIdMtch := p_LogicalChannelIdMtch,
    reserved2 := '0000000'B
  };

  /*
   * @desc      Receive and handle Registration Complete message
   * @param     p_NR_CellId
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_Registration_Complete(NR_CellId_Type p_NR_CellId,
                                         NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1
                                        ) runs on NR_BASE_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
        
    // Registration Complete
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not match (v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_NG_REGISTRATION_COMPLETE)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Complete Message Failed");
    }
  }

  /*
   * @desc      TS 38.508-1 table 4.5.2.2-3 RRC_IDLE procedure
   * @param     p_NR_CellId
   * @param     p_State
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_InactiveStateFollowedByRRCResume (default value: FollowedByResume)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @param     p_ServiceType       (default value: '0000'B)
   * @param     p_PreconfigureUe    (default value: omit)
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_Preamble(NR_CellId_Type p_NR_CellId,
                            NG_STATE_Type p_State,
                            NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                            INACTIVE_FollowOnState p_InactiveStateFollowedByRRCResume := FollowedByResume,
                            RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                            UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O,
                            template (present) B4_Type p_ServiceType := '0000'B,
                            template (omit) PreamblePreconfigureDataList p_PreconfigureUe := omit)  runs on NR5GC_PTC
  { //@sic R5s190505: added p_ActivateSecurityInactiveState R5s250008: renamed to p_InactiveStateFollowedByRRCResume sic@
    //@sic R5-199036: added p_IpPduDelayTime sic@
    
    var RRCConnectionReleaseRequired_Type v_ReleaseConnection := p_ReleaseConnection; // @sic R5-197077 sic@
    
    if (p_State == STATE_INACTIVE_2A) {
      v_ReleaseConnection := noRrcConnectionRelease;
    }
    // send UT functions to UE before cell switched on
    fl_NR5GC_PreconfigUE(p_PreconfigureUe); // @sic R5-225300, R5-237389 sic@
    
    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    if (p_State != STATE_OFF_0A ) { // Turn on, Register and establish 1 PDU session
      // Switch on UE
      f_NR5GC_SwitchOnAndResetIMS();
      // Go to RRC_IDLE
      f_NR5GC_RRC_IdleState1N_Def (p_NR_CellId, p_TestMode, v_ReleaseConnection, Initial_NoSecurity, p_IpPduDelayTime, p_ServiceType); // @sic R5s210189 sic@
    }

    select (p_State) {
      case (STATE_OFF_0B) {
        // Now turn off again
        f_NR_UE_DeRegisterOnSwitchOff (p_NR_CellId, STATE_IDLE_1A);
      }
      case (STATE_INACTIVE_2A) {
        f_NR_RRC_InactiveDef(p_NR_CellId, p_InactiveStateFollowedByRRCResume);
      }
      case (STATE_CONNECTED_3A) {
        // Go to RRC_CONNECTED
        f_NR5GC_RRC_ConnectedState3N_Def (p_NR_CellId, p_TestMode);
      }
    }
  }

  /*
   * @desc      step 3 .. 20 of UE Registration acc. to TS 38.508-1 table 4.5.2.2-3 RRC_IDLE procedure
   * @param     p_NR_CellId
   * @param     p_TestMode
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_RegType           (default value: Initial_Secure)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_RRC_Idle_Steps3_20(NR_CellId_Type p_NR_CellId,
                                      NR_TESTMODE_STATE_Type p_TestMode,
                                      RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                      TypeOfRegistration_Type p_RegType := Initial_Secure) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_NasInd;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    
    // send RRC Connection Setup on SRB0 (CCCH) and switch on UL grant assignments:
    f_NR_RRCSetup_Def (p_NR_CellId);
    
    // UE shall establish SRB1 acc. to 38.331 cl. 5.3.3.1
    // UE enters RRC_CONNECTED state
    
    // receive RRC Connection Setup Complete with piggy-backed NAS message on SRB1 (DCCH):
    v_NasInd := f_NR_RRCSetupComplete_Def(p_NR_CellId,
                                          cr_38508_RRCSetupComplete( tsc_NR_RRC_TI_Def),
                                          (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));

    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_NasInd.Pdu, p_RegType)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
  
    f_NR5GC_RRC_Idle_Steps5_20(v_GMM_MobilityInfo, p_NR_CellId, v_NasInd, p_TestMode, p_ReleaseConnection, p_RegType);
  }

  /*
   * @desc      38.508-1 table 4.5.2.2-2 RRC_IDLE procedure
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @param     p_ServiceType       (default value: '0000'B)
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRC_IdleState1N_Def(NR_CellId_Type p_NR_CellId,
                                       NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                       RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                       TypeOfRegistration_Type p_RegType := Initial_Secure,
                                       UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O,
                                       template (present) B4_Type p_ServiceType := '0000'B)  runs on NR5GC_PTC
  { //@sic R5-199036: added p_IpPduDelayTime sic@
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    
    // Steps 2 - 4
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, p_RegType)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    
    // Steps 5 - 20
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, p_TestMode, p_ReleaseConnection, p_RegType, -, p_IpPduDelayTime, -, p_ServiceType); // @sic R5s210189 sic@
  }

  /*
   * @desc      Steps 1 to 13 of RRC_IDLE procedure
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_IwkN26           (default value: NOT_SUPPORTED)
   * @param     p_PreconfigureUe    (default value: omit)
   * @return    GMM_MobilityInfo_Type
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_Preamble_Steps1_13(NR_CellId_Type p_NR_CellId,
                                      NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                      InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                      template (omit) PreamblePreconfigureDataList p_PreconfigureUe := omit)  runs on NR5GC_PTC return GMM_MobilityInfo_Type
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);

    // send UT functions to UE before cell switched on
    fl_NR5GC_PreconfigUE(p_PreconfigureUe); // @sic R5-225300, R5-237389 sic@

    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();

    // Steps 2 - 4
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
       
    // Steps 5 - 13
    f_NR5GC_RRC_Idle_Steps5_13(v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, v_PLMN, p_TestMode, Initial_NoSecurity, p_IwkN26); // @sic R5-202564 sic@
    
    return v_GMM_MobilityInfo;  //@sic R5-198509 sic@
  }

  /*
   * @desc      Steps 1 to 4 of RRC_IDLE procedure
   *            This returns the Registration Request so that it can be checked, f_Check_NG_RegistrationReqMsg, in the test case
   * @param     p_NR_CellId
   * @return    NG_NAS_MSG_Indication_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_Preamble_Steps1_4(NR_CellId_Type p_NR_CellId)  runs on NR5GC_PTC return NG_NAS_MSG_Indication_Type
  {
    // send UT functions to UE before cell switched on
    fl_NR5GC_PreconfigUE(omit); // @sic R5-225300, R5-237389 sic@

    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();

    // Steps 2 - 4
    // RRC Connection Setup
    return f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
  }

  /*
   * @desc      Just the Registration procedure (this must be followed by PDU Session Establishment)
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_EPLMNs            (default value: omit)
   * @param     p_NwkFeatureSupport (default value: cs_NG_NetworkFeatureSupport_Def)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_NR5GC_Registration(NR_CellId_Type p_NR_CellId,
                                NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                TypeOfRegistration_Type p_RegType := Initial_Secure,
                                template (omit) PLMN_List p_EPLMNs := omit,
                                template (omit) NG_NetworkFeatureSupport p_NwkFeatureSupport := cs_NG_NetworkFeatureSupport_Def,
                                InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED)  runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);

    // Steps 2 - 4
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, p_RegType)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
       
    // Steps 5 - 15
    f_NR5GC_RRC_Idle_Steps5_15(v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, v_PLMN, p_TestMode, p_RegType, p_EPLMNs, p_NwkFeatureSupport, p_IwkN26); // @sic R5-202564 sic@
  }

  /*
   * @desc      Steps 5 to 20 of the Registration procedure
   * @param     p_GMM_MobilityInfo_Type
   * @param     p_NR_CellId
   * @param     p_ReceivedMsg
   * @param     p_TestMode
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @param     p_ServiceType       (default value: '0000'B)
   * @param     p_AssignmentMode    (default value: 1)
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRC_Idle_Steps5_20(GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                      NR_CellId_Type p_NR_CellId,
                                      NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                      NR_TESTMODE_STATE_Type p_TestMode,
                                      RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                      TypeOfRegistration_Type p_RegType := Initial_Secure,
                                      template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                      UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O,
                                      InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                      template (present) B4_Type p_ServiceType := '0000'B,
                                      integer p_AssignmentMode := 1)  runs on NR5GC_PTC
  {
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);

    // Steps 5-15
    f_NR5GC_RRC_Idle_Steps5_15(p_GMM_MobilityInfo_Type, p_NR_CellId, p_ReceivedMsg, v_PLMN, p_TestMode, p_RegType, -, -, p_IwkN26, p_AssignmentMode); // @sic R5-202564, R5s230092 sic@
    
    //Steps 16 - 20
    f_NR5GC_RRC_Idle_Steps16_20 (p_NR_CellId,
                                 -,
                                 p_TestMode,
                                 p_ReleaseConnection,
                                 p_UE_TestLoopModeA_NR_LB_Setup,
                                 p_IpPduDelayTime,  // @sic R5s200751 sic@
                                 -, -, -, -, -, -, -, -, -,
                                 p_ServiceType);    // @sic R5s210189 sic@
  }

  /*
   * @desc      Table 4.5.2.2-4 of the Registration procedure
   * @param     p_NR_CellId
   * @param     p_ServiceType       (default value: '0000'B)
   * @param     p_CalledFromTAU     (default value: false)
   * @param     p_PDN_Type          (default value: omit)
   * @return    integer
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR5GC_RRC_Idle_Extension_Steps1_7(NR_CellId_Type p_NR_CellId,
                                      template (present) B4_Type p_ServiceType := '0000'B,
                                      boolean p_CalledFromTAU := false,
                                      template (omit) PDU_PDN_DNN_Type p_PDN_Type := omit)  runs on NR5GC_PTC return integer
   {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var template (present) NG_MobileIdentity v_S_TMSI := f_NG_S_TMSI2MobileIdentity(omit, v_GutiParams);
    var PDU_PDN_DNN_Type v_PDN_Type;
    var charstring v_DNN := "";
    var integer v_NumOfSessions := pc_noOf_PDUsNewConnection;
    timer t_Wait := 10.0;
    
    // Only do something if PICS set correctly
    if (pc_noOf_PDUsNewConnection > 0 or pc_noOf_PDUsSameConnection == 0){ // @sic R5s200026, R5-236305 sic@
      // Step 0Aa1
      if (pc_noOf_PDUsNewConnection ==  0 and pc_noOf_PDUsSameConnection == 0){ // @sic R5s200026, R5-236305 sic@
        /* trigger if there's no sessions established automatically
            to ensure there's (at least) one session established for the test body */
        v_NumOfSessions := 1;
        if (isvalue(p_PDN_Type)) { // @sic R5-245654 sic@
          v_PDN_Type := valueof(p_PDN_Type);
        } else {
          v_PDN_Type := f_GetDefaultAPN_DNNType_FromPICS(); // @sic R5-211372 sic@
          if (v_PDN_Type == None) { // @sic R5s220670 sic@
            // Step 1a1: if pc_APN_Default_Configuration is set to 'None' then use pc_APN_ID_Internet
            v_PDN_Type := Internet_DNN;
          }
        }
        v_DNN := f_GetDNNStringFromPICS(v_PDN_Type); // @sic R5-221467 sic@
        f_UT_RequestPDUSession(UT, 1, v_DNN); // @sic R5s210084, R5-211372 sic@
      }

      // Step 0B @sic R5-204399 sic@
      t_Wait.start;
      alt {
        [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(p_NR_CellId, cr_38508_RRCSetupRequest(?, ?)))) {
           t_Wait.stop;
        }
           // Step 0Ca1
        [] t_Wait.timeout {
          if (p_CalledFromTAU) {  // @sic R5-237315 sic@
            return 0;
          } else {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "pc_noOf_PDUsSameConnection and/or pc_noOf_PDUsNewConnection set wrong");
          }
        }
      }
    
      // Steps 2 - 4
      v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?); // @sic R5s200489 sic@
      if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu,  cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (),
                                        tsc_NasKsi_NativeSecurityContext),
                                        v_S_TMSI, p_ServiceType)) {   // @sic R5s210189 sic@
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
      }
    
      // Steps 5-6
      // RRC Security Mode procedure
      f_NR_RRC_ActivateSecurity (p_NR_CellId, v_ReceivedMsg.SecurityProtection.NasCount); // Use NasCount returned from Service Req

      if (pc_noOf_PDUsSameConnection == 0) { // @sic R5-236305 sic@
        // Step 7a1
        SRB.send (cas_NR_SRB_NasPdu_REQ(p_NR_CellId, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, f_Get_NG_ServiceAcceptMsg(v_ReceivedMsg.Pdu.Msg.service_Request.pduSessionStatus)))); // @sic R5s201387 Baseline Moving sic@
      } else {
        // Step 7b1
        f_NR_RRCReconfigExistingDRBs(p_NR_CellId,
                                 {cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, f_Get_NG_ServiceAcceptMsg(v_ReceivedMsg.Pdu.Msg.service_Request.pduSessionStatus))}); // @sic R5-19710, R5s201387 Baseline Moving sic@
      }
    }
    return v_NumOfSessions; // @sic R5-236305 sic@
  }

  /*
   * @desc      Table 4.5.2.2-4 of the Registration procedure
   * @param     p_NR_CellId
   * @param     p_SDAP_Config       (default value: omit)
   * @param     p_ExpectedS_NSSAI   (default value: *)
   * @param     p_ExpectedDNN       (default value: *)
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_DNN               (default value: omit)
   * @param     p_QoS_Rules         (default value: omit)
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_QoSFlowDescr      (default value: omit)
   * @param     p_ServiceType       (default value: '0000'B)
   * @param     p_CalledFromTAU     (default value: false)
   * @param     p_PDN_Type          (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR5GC_RRC_Idle_Extension(NR_CellId_Type p_NR_CellId,
                                      template (omit) SDAP_Config p_SDAP_Config := omit,
                                      template S_NSSAI_Type p_ExpectedS_NSSAI := *,
                                      template DNN p_ExpectedDNN := *,
                                      template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                      template (omit) DNN p_DNN := omit,
                                      template (omit) QoS_Rules p_QoS_Rules := omit,
                                      template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                      template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                      template (omit) QoSFlowDescr p_QoSFlowDescr := omit,
                                      template (present) B4_Type p_ServiceType := '0000'B,
                                      boolean p_CalledFromTAU := false,
                                      template (omit) PDU_PDN_DNN_Type p_PDN_Type := omit)  runs on NR5GC_PTC
   { // Split into steps1_7 @sic R5s220107 sic@
   
    var integer v_NumOfSessions := f_NR5GC_RRC_Idle_Extension_Steps1_7(p_NR_CellId,
                                        p_ServiceType, p_CalledFromTAU, p_PDN_Type);  // @sic R5-237315 sic@

    if (v_NumOfSessions > 0) {  // @sic R5s220455 sic@
      // Step 8
      f_NR5GC_PDUSessionEstablishment (p_NR_CellId,
                                     v_NumOfSessions,  // @sic R5-236305 sic@
                                     tsc_NR_RbId_SRB1, // @sic R5-206291 sic@
                                     p_SDAP_Config, // @sic R5s210134 sic@
                                     p_ExpectedS_NSSAI,
                                     p_ExpectedDNN,
                                     p_SSC_Mode,
                                     p_DNN,
                                     p_QoS_Rules,
                                     p_Session_AMBR,
                                     p_S_NSSAI,
                                     p_QoSFlowDescr);

    // @sic R5-236305 sic@
    }
  }

  /*
   * @desc      Steps 16 to 20 of the Registration procedure
   *            To be called to establish the PDU Sessions after once the Registration Complete has been received
   *            To be called from testcases that have customised the registration procedure
   *            includes Table 4.5.2.2-4 of the Registration procedure
   * @param     p_NR_CellId
   * @param     p_ExpectedNumberOfNewPDUSessions (default value: pc_noOf_PDUsSameConnection)
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_ReleaseConnection (default value: noRrcConnectionRelease)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @param     p_SDAP_Config       (default value: omit)
   * @param     p_ExpectedS_NSSAI   (default value: *)
   * @param     p_ExpectedDNN       (default value: *)
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_DNN               (default value: omit)
   * @param     p_QoS_Rules         (default value: omit)
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_QoSFlowDescr      (default value: omit)
   * @param     p_ServiceType       (default value: '0000'B)
   * @param     p_NormalIMSOperation (default value: true)
                 ..Need to delay for IP/IMS signalling if RRCRelease is about to be sent in the calling function
                   if set to false, assume the connection will be up long enough to complete 'extra-ordinary' IMS signalling without waiting here
   * @param     p_PDN_Type          (default value: omit)
   * @param     p_EstReqAlreadyInDefault (default value: 0)
                 ..Set to 1 if a_NR5GC_AdditionalPDUSessionEstablishmentReq has just been activated and received one unprocessed Establishment Req
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR5GC_RRC_Idle_Steps16_20(NR_CellId_Type p_NR_CellId,
                                      integer p_ExpectedNumberOfNewPDUSessions := pc_noOf_PDUsSameConnection,  // @sic R5s201358 sic@,
                                      NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                      RRCConnectionReleaseRequired_Type p_ReleaseConnection := noRrcConnectionRelease,
                                      template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                      UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O,
                                      template (omit) SDAP_Config p_SDAP_Config := omit,
                                      template S_NSSAI_Type p_ExpectedS_NSSAI := *,
                                      template DNN p_ExpectedDNN := *,
                                      template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                      template (omit) DNN p_DNN := omit,
                                      template (omit) QoS_Rules p_QoS_Rules := omit,
                                      template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                      template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                      template (omit) QoSFlowDescr p_QoSFlowDescr := omit,
                                      template (present) B4_Type p_ServiceType := '0000'B,
                                      boolean  p_NormalIMSOperation := true, // @sic R5s220807 sic@
                                      template (omit) PDU_PDN_DNN_Type p_PDN_Type := omit,
                                      integer p_EstReqAlreadyInDefault := 0)  runs on NR5GC_PTC
  {
    var boolean v_WaitIfIMS := p_NormalIMSOperation;
    //Steps 16 - 19a1
    // No SRB2 so must be on SRB1
    if (p_ExpectedNumberOfNewPDUSessions < 0 ) { // @sic R5-194797, R5-199075, R5-204329 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "3GPP RAN5 5GS test specifications do not support UEs configured with pc_noOf_PDUsSameConnection  // @sic R5s201358 sic@ < 0");
    }
    if (not p_NormalIMSOperation and pc_noOf_PDUsNewConnection >0) { // @sic R5s221213 sic@
      v_WaitIfIMS := true;
    }
    if (pc_noOf_PDUsSameConnection > 0) { // @sic R5-236305 sic@
      f_NR5GC_PDUSessionEstablishment (p_NR_CellId,
                                       p_ExpectedNumberOfNewPDUSessions,
                                       tsc_NR_RbId_SRB1,
                                       p_SDAP_Config, // @sic R5s210134 sic@
                                       p_ExpectedS_NSSAI,
                                       p_ExpectedDNN,
                                       p_SSC_Mode,
                                       p_DNN,
                                       p_QoS_Rules,
                                       p_Session_AMBR,
                                       p_S_NSSAI,
                                       p_QoSFlowDescr,
                                       -, -, -, -, -, -, -, -, -, -, -, -, -, -, -,
                                       -, -, -, -, -, -, -,
                                       v_WaitIfIMS, p_EstReqAlreadyInDefault);  // @sic R5s220807, R5s221213, R5-246403 sic@
    }
   
      // Step 19Ba1
    if (pc_noOf_PDUsNewConnection > 0 or pc_noOf_PDUsSameConnection == 0){ // @sic R5s200026, R5-236305 sic@
      f_NR_RRCRelease(p_NR_CellId);
      
      // Step 19Ba2
      // @sic R5-199075, R5-236305 sic@
      f_NR5GC_RRC_Idle_Extension(p_NR_CellId,
                                 -,
                                 p_ExpectedS_NSSAI,
                                 p_ExpectedDNN,
                                 p_SSC_Mode,
                                 p_DNN,
                                 p_QoS_Rules,
                                 p_Session_AMBR,
                                 p_S_NSSAI,
                                 p_QoSFlowDescr,
                                 p_ServiceType, // @sic R5s210189, R5s210608 sic@
                                 -,
                                 p_PDN_Type);   //  @sic R5-245495 sic@
    }

    //Step 20a1
    if (p_ReleaseConnection == rrcConnectionRelease) {// @sic R5-199075, R5s200489, R5-236305 sic@
      // Release RRC to enter RRC_IDLE
      f_NR_RRCRelease(p_NR_CellId);
    } else {        // @sic R5-240236 sic@
      // @sic  R5-236305 sic@
      // Step 19Ca1 - 19Ca2
      select (p_TestMode) {
        case (TEST_LOOPModeA_ON) {
          f_NR5GC_CloseUE_TestLoopModeA (p_NR_CellId, p_UE_TestLoopModeA_NR_LB_Setup);
        }
        case (TEST_LOOPModeB_ON) {
          f_NR5GC_CloseUE_TestLoopModeB (p_NR_CellId, p_IpPduDelayTime);
        }
        case (PING_Or_TEST_LOOPModeB_ON) {
          if (not pc_IP_Ping) {
           f_NR5GC_CloseUE_TestLoopModeB (p_NR_CellId, p_IpPduDelayTime);
          }
        }
      }
    }
    
  }

  /*
   * @desc      Steps 5 to 15 of the Registration procedure
   * @param     p_GMM_MobilityInfo_Type
   * @param     p_NR_CellId
   * @param     p_ReceivedMsg
   * @param     p_PLMN
   * @param     p_TestMode
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_EPLMNs            (default value: omit)
   * @param     p_NwkFeatureSupport (default value: cs_NG_NetworkFeatureSupport_Def)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @param     p_AssignmentMode    (default value: 1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRC_Idle_Steps5_15 (GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                       NR_CellId_Type p_NR_CellId,
                                       NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                       NAS_PlmnId p_PLMN,
                                       NR_TESTMODE_STATE_Type p_TestMode,
                                       TypeOfRegistration_Type p_RegType := Initial_Secure,
                                       template (omit) PLMN_List p_EPLMNs := omit,
                                       template (omit) NG_NetworkFeatureSupport p_NwkFeatureSupport := cs_NG_NetworkFeatureSupport_Def,
                                       InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                       integer p_AssignmentMode := 1)  runs on NR5GC_PTC
  {
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (p_NR_CellId);
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (p_PLMN, v_GutiParams);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(p_PLMN, {bit2oct(v_TAC)});
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1; // No SRB2 so must be on SRB1

    // Steps 5 - 13
    f_NR5GC_RRC_Idle_Steps5_13 (p_GMM_MobilityInfo_Type, p_NR_CellId, p_ReceivedMsg, p_PLMN, p_TestMode, p_RegType, p_IwkN26, p_AssignmentMode); // @sic R5-202564, R5s230092 sic@
    
    // Step 14
    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   p_GMM_MobilityInfo_Type,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   p_EPLMNs,
                                                   -, -, -,
                                                   p_NwkFeatureSupport);
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    // Step 15
    f_NR5GC_Registration_Complete(p_NR_CellId); // No SRB2 so must be on SRB1
  }

  /*
   * @desc      Steps 15 to 20 of the Registration procedure
   * @param     p_NR_CellId
   * @param     p_TestMode
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
   function f_NR5GC_RRC_Idle_Steps15_20 (NR_CellId_Type p_NR_CellId,
                                        NR_TESTMODE_STATE_Type p_TestMode,
                                        RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                        template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                        UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O)  runs on NR5GC_PTC
  {
    // Step 15
    f_NR5GC_Registration_Complete(p_NR_CellId); // No SRB2 so must be on SRB1
    
    f_NR5GC_RRC_Idle_Steps16_20 (p_NR_CellId, -, p_TestMode, p_ReleaseConnection, p_UE_TestLoopModeA_NR_LB_Setup, p_IpPduDelayTime);
  }

  /*
   * @desc      Registration procedure Step 5 to 13 on a sceneario with Steering of Roaming
   * @param     p_NR_CellId
   * @param     p_GMM_MobilityInfo_Type
   * @param     p_ReceivedMsg
   * @param     p_Data
   * @param     p_Header
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_MacError          (default value: false)
   * @return    O16_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_SorRegistration_Step5_13(NR_CellId_Type p_NR_CellId,
                                            GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                            NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                            octetstring p_Data,
                                            template (value) SOR_Header p_Header,
                                            TypeOfRegistration_Type p_RegType := Initial_Secure,
                                            boolean p_MacError:= false) runs on NR5GC_PTC return O16_Type
  { //@sic R5s201056 sic@
    var O16_Type v_Mac_AMF;
    var O16_Type v_Mac_UE;
    var B128_Type v_Mac_A17;
    var B128_Type v_Mac_A18;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams;
    var O2_Type v_Counter :='0001'O;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    //Steps 5 to 13 of the registration procedure described in TS 38.508-1 subclause 4.5.2.2-2 are performed on NR Cell 13
    f_NR5GC_RRC_Idle_Steps5_13 (p_GMM_MobilityInfo_Type,
                                p_NR_CellId, p_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (p_NR_CellId)),
                                TESTMode_OFF,
                                p_RegType);
    //calculate v_Mac_AMF, which is used in REGISTRATION ACCEPT message
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(p_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_Counter,
                                  p_Data,
                                  v_NAS_SecurityParams.KDF);
    
    v_Mac_AMF := bit2oct(v_Mac_A17);
    if(p_MacError)
    {
    v_Mac_AMF := not4b(v_Mac_AMF);//unmatched SOR-MAC-IAUSF
    };
    //calculate v_Mac_UE, which is used in REGISTRATION COMPLETE message after successful check
    v_Mac_A18 :=f_NG_Authentication_A18(v_NAS_SecurityParams.KAUSF,
                                  v_Counter,
                                  v_NAS_SecurityParams.KDF);
    v_Mac_UE :=bit2oct(v_Mac_A18);
    //The SS transmits an DLInformationTransfer message and an REGISTRATION ACCEPT message containing expected steering of roaming information
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   p_GMM_MobilityInfo_Type,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (p_NR_CellId),
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (p_NR_CellId)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(p_NR_CellId))}),
                                                    -,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,
                                                    cs_NG_SORTransparentContainer(p_Header, v_Mac_AMF, v_Counter, p_Data, '73'O, int2oct(lengthof(p_Data) +19, 2))); // Jun24 @sic R5s240531 Baseline Moving sic@
    // Registration Accept
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   tsc_NR_RbId_SRB1, // must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    return v_Mac_UE;
  }

  /*
   * @desc      Steps 5 to 13 of the Registration procedure
   * @param     p_GMM_MobilityInfo_Type (by reference)
   * @param     p_NR_CellId
   * @param     p_ReceivedMsg
   * @param     p_PLMN
   * @param     p_TestMode
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_IwkN26           (default value: NOT_SUPPORTED)
   * @param     p_AssignmentMode    (default value: 1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRC_Idle_Steps5_13 (inout GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,  // @sic R5s211357 sic@
                                       NR_CellId_Type p_NR_CellId,
                                       NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                       NAS_PlmnId p_PLMN,
                                       NR_TESTMODE_STATE_Type p_TestMode,
                                       TypeOfRegistration_Type p_RegType := Initial_Secure,
                                       InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                       integer p_AssignmentMode := 1)  runs on NR5GC_PTC
  {
    var NasCount_Type v_NasCount;
    
    // Steps 5 - 6
    // Do Authentication
    v_NasCount := f_NR5GC_RRC_Idle_Steps5_9_AKA (p_GMM_MobilityInfo_Type, p_NR_CellId, p_ReceivedMsg, p_PLMN, p_RegType, p_IwkN26, p_AssignmentMode); // @sic R5-202564, R5s230092 sic@

    // Store GMM Mobility Info now
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(p_GMM_MobilityInfo_Type); // @sic R5-195328, R5s190388 sic@

    // Step 9a1 - 9a2
    select (p_TestMode) {
      case (TESTModeA_ON, TEST_LOOPModeA_ON) {
        f_NR5GC_Activate_TestMode (p_NR_CellId, tsc_UE_TestLoopMode_TypeA);
      }
      case (TESTModeB_ON, TEST_LOOPModeB_ON) {
        f_NR5GC_Activate_TestMode (p_NR_CellId, tsc_UE_TestLoopMode_TypeB);
      }
      case (PING_Or_TESTModeB_ON, PING_Or_TEST_LOOPModeB_ON) {
       if (not pc_IP_Ping) {
         f_NR5GC_Activate_TestMode (p_NR_CellId, tsc_UE_TestLoopMode_TypeB);
       }
      }
      case (TESTModeC_ON, TEST_LOOPModeC_ON) { //@sic R5-244716 sic@
        f_NR5GC_Activate_TestMode (p_NR_CellId, tsc_UE_TestLoopMode_TypeC);
      }
      case (TESTModeE_ON, TEST_LOOPModeE_ON) {  // @sic R5-225291 sic@
        f_NR5GC_Activate_TestMode (p_NR_CellId, tsc_UE_TestLoopMode_TypeE);
      }
      case else { // do nothing
      }
    }

    //Steps 10 - 11
    // RRC Security Mode procedure
    f_NR_RRC_ActivateSecurity (p_NR_CellId, v_NasCount); // Use NasCount returned from NAS S.M. Complete
    
    // Steps 12 - 13
    // UE Capability
    f_NR_Capability(p_NR_CellId);
  }

  /*
   * @desc      step 5 .. 9 of UE Registration acc. to TS 38.508-1 table 4.5.2.2-2 RRC_IDLE procedure
   * @param     p_GMM_MobilityInfo_Type (by reference)
   * @param     p_NR_CellId
   * @param     p_ReceivedMsg
   * @param     p_PLMN
   * @param     p_RegType           (default value: Initial_Secure)
   * @param     p_IwkN26            (default value: NOT_SUPPORTED)
   * @param     p_AssignmentMode    (default value: 1)
   * @return    NasCount_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR5GC_RRC_Idle_Steps5_9_AKA (inout GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                           NR_CellId_Type p_NR_CellId,
                                           NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                           NAS_PlmnId p_PLMN,
                                           TypeOfRegistration_Type p_RegType := Initial_Secure,
                                           InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                           integer p_AssignmentMode := 1
)  runs on NR5GC_PTC return NasCount_Type
  {
    var template NAS_SecurityReturnType v_NAS_SecurityReturnValue;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg := p_ReceivedMsg;
    var NG_NAS_SecurityParams_Type v_SecurityParams := f_NR5GC_Security_Get();
    var SecurityHeaderType v_SentSecurityHeader;
    var template (present) SecurityHeaderType v_SecurityHeaderResponse;

    if (not isvalue(p_GMM_MobilityInfo_Type)) { // @sic R5s250203 sic@
        // if this function hasn't already been called, call it now to fill p_GMM_MobilityInfo_Type
        f_Check_NG_RegistrationReqMsg (p_GMM_MobilityInfo_Type, v_ReceivedMsg.Pdu, Initial_NoSecurity);
    }
    
    if(p_RegType == Initial_NoSecurity) { // @sic R5s190109 sic@
      v_SentSecurityHeader := tsc_SHT_NoSecurityProtection;
      v_SecurityHeaderResponse := tsc_SHT_NoSecurityProtection;
    } else {
      v_SentSecurityHeader := tsc_SHT_IntegrityProtected_Ciphered;
      v_SecurityHeaderResponse := tsc_SHT_IntegrityProtected_Ciphered; // @sic R5s190109 sic@
    }
    
    if (v_ReceivedMsg.Pdu.Msg.registration_Request.ngNasKSI.nasKeySetId != '111'B) { // @sic R5s190929 sic@
      v_SecurityParams.KSIamf := v_ReceivedMsg.Pdu.Msg.registration_Request.ngNasKSI.nasKeySetId;
      if(p_RegType == Initial_NoSecurity) { // @sic R5s200465 sic@
        v_SecurityHeaderResponse := tsc_SHT_IntegrityProtected; // @sic R5s190109, R5-200477 sic@
      }
      f_NR5GC_Security_Set(v_SecurityParams);
    }
    if (px_NAS_5GC_AuthenticationType == AKA_5G) {
      f_NR_Authentication5G_AKA(p_NR_CellId, v_SentSecurityHeader, v_SecurityHeaderResponse, p_PLMN, -, p_AssignmentMode); // @sic R5s230092 sic@
    } else {
      f_NR_AuthenticationEAP_AKA(p_NR_CellId, v_SentSecurityHeader, v_SecurityHeaderResponse, p_PLMN, -, p_AssignmentMode); // @sic R5s230092 sic@
    }
    
    // Step 8 - 9
    v_SecurityParams := f_NR5GC_Security_Get();
    // Do NAS Security Mode procedure
    v_NAS_SecurityReturnValue := f_NR_NASSecurityModeProcedure(p_NR_CellId, v_SecurityParams, p_RegType, p_GMM_MobilityInfo_Type);
    if (p_RegType == Initial_NoSecurity) {
      if (isvalue (v_NAS_SecurityReturnValue.NasMsg)) { // As first time Registration, Registration Req should be replayed
        // overwrite 2nd message received with the replayed msg as this will be the complete message, so it can be checked again
        v_ReceivedMsg.Pdu.PiggybackedPduList[0].Msg := valueof(v_NAS_SecurityReturnValue.NasMsg);
        v_ReceivedMsg.Pdu.PiggybackedPduList[0].PiggybackedPduList := omit; // @sic R5s210164 sic@
        if (not f_Check_NG_RegistrationReqMsg (p_GMM_MobilityInfo_Type, v_ReceivedMsg.Pdu, Initial_Secure)) {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Replayed Registration Request Message Failed");
        }
      } else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Not Replayed");
      }
    }
    // Step 9Aa1 - 9Aa2
    if (p_RegType == Initial_NoSecurity or p_RegType == Initial_Secure) { // @sic R5-202564 sic@
      if (isvalue(p_GMM_MobilityInfo_Type.GMMCap)) {
        if (match('1'B, p_GMM_MobilityInfo_Type.GMMCap.s1Cap)  and p_IwkN26 == NOT_SUPPORTED) {
          v_NAS_SecurityReturnValue := f_NR_NASSecurityModeProcedure(p_NR_CellId, v_SecurityParams, Initial_Secure, p_GMM_MobilityInfo_Type, omit); // @sic R5s200979 sic@
       }
      }
    }
    return valueof(v_NAS_SecurityReturnValue.NasCount);
  }

  /*
   * @desc      38.508-1 table 4.5.2.2-2 RRC_IDLE procedure adding eDRX related parameter for REGISTRATION REQUEST and REGISTRATION ACCEPT
   * @param     p_NR_CellId
   * @param     p_NegotiatedExtdDRXParams (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_RRC_Idle_Steps2_15_eDRX(NR_CellId_Type p_NR_CellId,
                                           template (omit) ExtdDRXParams p_NegotiatedExtdDRXParams := omit) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (omit) ExtdDRXParams v_NegotiatedExtdDRXParams := omit;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var TypeOfRegistration_Type v_RegType := Initial_Secure;
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (p_NR_CellId);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1;
    
    if (isvalue(p_NegotiatedExtdDRXParams)){
       v_NegotiatedExtdDRXParams := valueof(p_NegotiatedExtdDRXParams);
    }
    // Go to RRC_IDLE as per preamble. Steps 2 - 4
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, v_RegType, -,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,cr_ExtdDRXParamsAny)) //REGISTRATION REQUEST eDRX parameters are Present but contents not checked
    {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    // Steps 5 - 13
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, v_PLMN, TESTMode_OFF, v_RegType);
    // Step 14
    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   -,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,
                                                   v_NegotiatedExtdDRXParams);
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    // Step 15
    f_NR5GC_Registration_Complete(p_NR_CellId);
    
    //Steps 16 - 20
    //f_NR5GC_RRC_Idle_Steps16_20 (p_NR_CellId);
  }

  /*
   * @desc      Registration procedure on a sceneario with Steering of Roaming
   * @param     p_NR_CellId
   * @param     p_Data
   * @param     p_Header
   * @param     p_MacError          (default value: false)
   * @param     p_RegType           (default value: Initial_NoSecurity)
   * @param     p_ExpectedSecurityStatus (default value: tsc_SHT_NoSecurityProtection)
   * @return    O16_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_SorRegistration(NR_CellId_Type p_NR_CellId,
                                            octetstring p_Data,
                                            template (value) SOR_Header p_Header,
                                            boolean p_MacError:= false,
                                            template (present) TypeOfRegistration_Type p_RegType := Initial_NoSecurity,
                                            template (present) SecurityHeaderType p_ExpectedSecurityStatus := tsc_SHT_NoSecurityProtection) runs on NR5GC_PTC return O16_Type//@sic R5s201455 sic@
  {
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var O16_Type v_Mac_UE;
    var TypeOfRegistration_Type v_TypeOfRegistration; //@sic R5s210049 sic@
    //Steps 2 to 13 of the registration procedure described in TS 38.508-1 subclause 4.5.2.2-2 are performed on NR Cell 13
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, p_ExpectedSecurityStatus);//@sic R5s201455 sic@
    select (v_ReceivedMsg.Pdu.Msg.registration_Request.registrationType.registrationType) {
        case (tsc_NG_RegistrationEmergency) {
          v_TypeOfRegistration := Emergency;
        }
        case (tsc_NG_RegistrationInitial) {
          v_TypeOfRegistration := valueof(p_RegType);
        }
        case else {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration type incorrect");
        }
    }//@sic R5s210236 R5s210049 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, v_TypeOfRegistration)) {//@sic R5s210236 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    //Call f_NR5GC_SorRegistration_Step5_13 for the following code.
    v_Mac_UE:=f_NR5GC_SorRegistration_Step5_13 (p_NR_CellId,
                                     v_GMM_MobilityInfo,
                                     v_ReceivedMsg,
                                     p_Data,
                                     p_Header,
                                     v_TypeOfRegistration,
                                     p_MacError); //@sic R5s210236 sic@
    return v_Mac_UE
  }

  /*
   * @desc      38.508-1 table 4.9.8 procedure
   *            Turn Cell and UE on before calling f_NR5GC_RegistrationReject
   * @param     p_NR_CellId
   * @param     p_Cause             (default value: tsc_EmmCause_IllegalMe)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_PreambleReject(NR_CellId_Type p_NR_CellId,
                                NAS_CauseValue_Type p_Cause := tsc_EmmCause_IllegalMe)  runs on NR5GC_PTC
  {
    // send UT functions to UE before cell switched on
    fl_NR5GC_PreconfigUE(omit); // @sic R5-225300, R5-237389 sic@

    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();
    // Now Reject Registration Request
    f_NR5GC_RegistrationReject(p_NR_CellId, p_Cause);
  }

  /*
   * @desc      The Registration Reject procedure as per 38.508-1 cl. 4.9.8
   * @param     p_NR_CellId
   * @param     p_Cause             (default value: tsc_EmmCause_IllegalMe)
   * @param     p_RegType           (default value: Initial_NoSecurity)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_RegistrationReject(NR_CellId_Type p_NR_CellId,
                                NAS_CauseValue_Type p_Cause := tsc_EmmCause_IllegalMe,
                                TypeOfRegistration_Type p_RegType := Initial_NoSecurity)  runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    
    // Steps 1 - 3
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, p_RegType)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
          
    // Steps 4 - 7
    // Do Authentication and SMC
    f_NR5GC_RRC_Idle_Steps5_9_AKA (v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, v_PLMN, p_RegType);

    // Step 8
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, p_Cause))))); // @sic R5s190435 sic@
    // Step 9
    f_NR_RRCRelease (p_NR_CellId);

    // Step 10
    f_NR_UE_DeRegisterOnSwitchOff(p_NR_CellId, STATE_DEREGISTERED);
    // (re-)store GMM Mobility Info now
    f_NR5GC_MobileInfo_SetGMM_MobilityInfo(v_GMM_MobilityInfo); // @sic R5s211358 sic@
  }

  /*
   * @desc      TS 38.508-1 table 4.5.4.2-3 RRC_CONNECTED procedure
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @param     p_IpPduDelayTime    (default value: '00'O)
   * @param     p_RLCConfigList     (default value: omit)
   * @param     p_MACConfig         (default value: omit)
   * @param     p_DRBToAddMod       (default value: omit)
   * @param     p_SS_Drb_Config     (default value: omit)
   * @param     p_NrofHARQ_ProcessesForPDSCH (default value: omit)
   * @param     p_ServiceType       (default value: '0010'B)
   * @param     p_EstablishmentCause (default value: ?)
   * @param     p_RRCSetupComplete_v1610_IEs (default value: *)
   * @param     p_UE_TestLoopModeC_LB_Setup (default value: cs_UE_TestLoopModeC_LB_Setup_Def)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRC_ConnectedState3N_Def(NR_CellId_Type p_NR_CellId,
                                            NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                            template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                            UE_TestLoopModeB_LB_Setup_Type p_IpPduDelayTime := '00'O,
                                            template (omit) NR_RLC_BearerToAddModList_Type p_RLCConfigList := omit,
                                            template (omit) MAC_CellGroupConfig p_MACConfig := omit,
                                            template (omit) DRB_ToAddModList p_DRBToAddMod := omit,
                                            template (omit) NR_RadioBearerList_Type p_SS_Drb_Config := omit,
                                            template (omit) PDSCH_ServingCellConfig.nrofHARQ_ProcessesForPDSCH  p_NrofHARQ_ProcessesForPDSCH := omit,
                                            template (present) B4_Type p_ServiceType := '0010'B,
                                            template (present) EstablishmentCause p_EstablishmentCause := ?,
                                            template RRCSetupComplete_v1610_IEs p_RRCSetupComplete_v1610_IEs := *,
                                            template (omit) NR_UE_TestLoopModeC_LB_Setup_Type p_UE_TestLoopModeC_LB_Setup := cs_UE_TestLoopModeC_LB_Setup_Def
                                            ) runs on NR5GC_PTC
  { // @sic R5-190710 re-organised procedures 4.5.4 and 4.9.4 sic@
    // @sic R5-203533: added p_NrofHARQ_ProcessesForPDSCH sic@
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (omit) MAC_CellGroupConfig v_MAC_CellGroupConfig := omit;
    
    // Step 1 Page UE
    f_NR_Paging_Def(p_NR_CellId, RRC_IDLE);
    
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(p_NR_CellId,
                                                         p_ServiceType,
                                                         p_EstablishmentCause,
                                                         p_RRCSetupComplete_v1610_IEs);

    if (isvalue (p_MACConfig)) {
        v_MAC_CellGroupConfig := p_MACConfig;
    } else {
      if (f_NR_TestcaseIsL2Testcase()) { //@sic R5s210315 sic@
        f_NR_CellInfo_SetMAC_CellGroupConfigL2(p_NR_CellId);
        v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_NR_CellId);
      }
    }
    
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(p_NR_CellId, v_ReceivedMsg, p_RLCConfigList, v_MAC_CellGroupConfig, p_DRBToAddMod, p_SS_Drb_Config, -, p_NrofHARQ_ProcessesForPDSCH);

    // Step 9a1 - 9a2
    select (p_TestMode) {
      case (TEST_LOOPModeA_ON) {
        f_NR5GC_CloseUE_TestLoopModeA (p_NR_CellId, p_UE_TestLoopModeA_NR_LB_Setup);
      }
      case (TEST_LOOPModeB_ON) {
        f_NR5GC_CloseUE_TestLoopModeB (p_NR_CellId, p_IpPduDelayTime);
      }
      case (TEST_LOOPModeC_ON) {
        f_NR5GC_CloseUE_TestLoopModeC (p_NR_CellId, p_UE_TestLoopModeC_LB_Setup);
      }
      case (PING_Or_TEST_LOOPModeB_ON) {
       if (not pc_IP_Ping) {
        f_NR5GC_CloseUE_TestLoopModeB (p_NR_CellId, p_IpPduDelayTime);
       }
      }
      case else { // do nothing
      }
    }
  }

  /*
   * @desc      Function to reestablish the existing bearer p_DRBId in AM using specific RLC parameters and SS configure in transparent mode
   * @param     p_DRBId
   * @param     p_RLC_BearerConfig
   * @param     p_FieldLengthAM     (default value: size18)
   * @param     p_StatusReportRequired (default value: true_)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @status    APPROVED (NR5GC)
   */
   function f_NR5GC_RRC_ConnectedState3N_RLC_AM (DRB_Identity p_DRBId,
                                                 template (value) RLC_BearerConfig p_RLC_BearerConfig,
                                                 SN_FieldLengthAM p_FieldLengthAM := size18,
                                                 template (omit) PDCP_Config.drb.statusReportRequired p_StatusReportRequired := true_,
                                                 template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling
                                                 ) runs on NR5GC_PTC
   { //@sic R5-194296 added p_StatusReportRequired sic@
      var template (value) NR_RadioBearer_Type v_SS_Drb_Config;
      var template (value) DRB_ToAddMod  v_DRB_ToAddMod;
      var SDAP_Config v_SDAP_Config := f_NR_GetSDAP_InDRBList(p_DRBId);
         
      //SS configured in RLC transparent mode - PDCP none - SDAP none
      v_SS_Drb_Config := cs_NR_SS_RadioBearer_AM_Test(p_DRBId, p_FieldLengthAM);
      v_DRB_ToAddMod := cs_38508_NRDRB_ToAddMod(v_SDAP_Config, p_DRBId, cs_38508_PDCP_Config(-, -, p_StatusReportRequired)); // @sic R5-227518 sic@
      f_NR5GC_RRC_ConnectedState3N_Def(nr_Cell1,
                                       TEST_LOOPModeA_ON,
                                       p_UE_TestLoopModeA_NR_LB_Setup,
                                       -,  //p_IpPduDelayTime
                                       {p_RLC_BearerConfig},
                                       -,  //MAC_CellGroupConfig
                                       {v_DRB_ToAddMod},
                                       {v_SS_Drb_Config});
  }

    /*
   * @desc      Function to reestablish the existing bearer p_DRBId in UM using specific RLC parameters and SS configure in transparent mode
   * @param     p_DRBId
   * @param     p_RLC_BearerConfig
   * @param     p_FieldLengthUM     (default value: size12)
   * @param     p_T_Reordering      (default value: omit)
   * @status    APPROVED (NR5GC)
   */
   function f_NR5GC_RRC_ConnectedState3N_RLC_UM (DRB_Identity p_DRBId,
                                                 template (value) RLC_BearerConfig p_RLC_BearerConfig,
                                                 SN_FieldLengthUM p_FieldLengthUM := size12,
                                                 template (omit) NR_PDCP_T_Reordering_Type p_T_Reordering := omit ) runs on NR5GC_PTC
   {
      var template (value) NR_RadioBearer_Type v_SS_Drb_Config;
      var template (value) DRB_ToAddMod  v_DRB_ToAddMod;
      var SDAP_Config v_SDAP_Config := f_NR_GetSDAP_InDRBList(p_DRBId);
      
      //SS configured in RLC transparent mode - PDCP none - SDAP none
      v_SS_Drb_Config := cs_NR_SS_RadioBearer_UM_Test(p_DRBId, p_FieldLengthUM);
      v_DRB_ToAddMod := cs_38508_NRDRB_ToAddMod(v_SDAP_Config, p_DRBId, cs_38508_PDCP_Config(-, p_T_Reordering, omit)); //  @sic R5-195696, R5-227518 sic@
      f_NR5GC_RRC_ConnectedState3N_Def(nr_Cell1,
                                       TEST_LOOPModeA_ON,
                                       cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                       -,  //p_IpPduDelayTime
                                       {p_RLC_BearerConfig},
                                       -,  //MAC_CellGroupConfig
                                       {v_DRB_ToAddMod},
                                       {v_SS_Drb_Config});
  }

  /*
   * @desc      TS 38.508-1 table 4.9.4.2-3 RRC_CONNECTED procedure
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_RRCIdleToConnected(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps1_4 (p_NR_CellId);
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(p_NR_CellId, v_ReceivedMsg);
  }

  /*
   * @desc      TS 38.508-1 table 4.9.4.2-3 RRC_CONNECTED procedure - Steps 1 to 4
   * @param     p_NR_CellId
   * @return    NG_NAS_MSG_Indication_Type
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_RRCIdleToConnected_Steps1_4(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC return NG_NAS_MSG_Indication_Type
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;

    // Step 1 Page UE
    f_NR_Paging_Def(p_NR_CellId, RRC_IDLE);
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(p_NR_CellId);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Check RRC Idle");
    
    return v_ReceivedMsg;
  }

  /*
   * @desc      TS 38.508-1 table 4.9.4.2-3 RRC_CONNECTED procedure - Steps 2 to 4
   * @param     p_NR_CellId
   * @param     p_ServiceType       (default value: '0010'B)
   * @param     p_EstablishmentCause (default value: ?)
   * @param     p_RRCSetupComplete_v1610_IEs (default value: *)
   * @return    NG_NAS_MSG_Indication_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_RRCIdleToConnected_Steps2_4(NR_CellId_Type p_NR_CellId,
                                               template (present) B4_Type p_ServiceType := '0010'B,
                                               template (present) EstablishmentCause p_EstablishmentCause := ?,
                                               template RRCSetupComplete_v1610_IEs p_RRCSetupComplete_v1610_IEs := *) runs on NR5GC_PTC return NG_NAS_MSG_Indication_Type
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var template (present) NG_MobileIdentity v_S_TMSI := f_NG_S_TMSI2MobileIdentity(omit, v_GutiParams);
    
    // Steps 2-4 RRC connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId,
                                                  tsc_NR_RRC_TI_Def,
                                                  p_EstablishmentCause,
                                                  -, -, -, -,
                                                  p_RRCSetupComplete_v1610_IEs); // @sic R5=204387 sic@
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), v_S_TMSI, p_ServiceType)) {  // @sic R5s200654 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }
    
    return v_ReceivedMsg;
   }

  /*
   * @desc      TS 38.508-1 table 4.5.4.2-3 RRC_CONNECTED procedure - Steps 5 to 8
   * @param     p_NR_CellId
   * @param     p_NG_NAS_MSG_Indication
   * @param     p_RLCConfigList     (default value: omit)
   * @param     p_MACConfig         (default value: omit)
   * @param     p_DRBToAddMod       (default value: omit)
   * @param     p_SS_Drb_Config     (default value: omit)
   * @param     p_NR_RoutingInfoSUL (default value: omit)
   * @param     p_NrofHARQ_ProcessesForPDSCH (default value: omit)
   * @param     p_ReceiveForRRCreconfigurationComplete (default value: true)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function f_NR5GC_RRC_ConnectedState3N_Steps5_8( NR_CellId_Type p_NR_CellId,
                                                   NG_NAS_MSG_Indication_Type p_NG_NAS_MSG_Indication,
                                                   template (omit) NR_RLC_BearerToAddModList_Type p_RLCConfigList := omit,
                                                   template (omit) MAC_CellGroupConfig p_MACConfig := omit,
                                                   template (omit) DRB_ToAddModList p_DRBToAddMod := omit,
                                                   template (omit) NR_RadioBearerList_Type p_SS_Drb_Config := omit,
                                                   template (omit) NR_RoutingInfoSUL_Type p_NR_RoutingInfoSUL := omit,
                                                   template (omit) PDSCH_ServingCellConfig.nrofHARQ_ProcessesForPDSCH  p_NrofHARQ_ProcessesForPDSCH := omit,
                                                    boolean p_ReceiveForRRCreconfigurationComplete := true) runs on NR5GC_PTC
    {
    // @sic R5-203533: added p_NrofHARQ_ProcessesForPDSCH sic@
    // Steps 5-6
    // RRC Security Mode procedure
    f_NR_RRC_ActivateSecurity (p_NR_CellId, p_NG_NAS_MSG_Indication.SecurityProtection.NasCount, p_NR_RoutingInfoSUL); // Use NasCount returned from Service Req

    // Steps 7-8
    f_NR_RRCReconfigExistingDRBs(p_NR_CellId,
                                 {cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, f_Get_NG_ServiceAcceptMsg(p_NG_NAS_MSG_Indication.Pdu.Msg.service_Request.pduSessionStatus))}, // @sic R5-19710, R5s201387 Baseline Moving sic@
                                 p_RLCConfigList,
                                 p_MACConfig,
                                 p_DRBToAddMod,
                                 -,
                                 p_SS_Drb_Config,
                                 p_ReceiveForRRCreconfigurationComplete,  // @sic R5-216194 sic@
                                 -,
                                 p_NR_RoutingInfoSUL,
                                 p_NrofHARQ_ProcessesForPDSCH
                                );
    }

  /*
   * @desc      Based on TS 38.508-1 table 4.5.4.2-3 RRC_CONNECTED procedure
   *            This function to be used by MAC test cases which require
   *            extra DRBs to be configured in the preamble without the NAS message
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TESTMode_OFF)
   * @param     p_UE_TestLoopModeA_NR_LB_Setup (default value: cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling)
   * @param     p_RLCConfigList
   * @param     p_MACConfig         (default value: omit)
   * @param     p_DRBToAddMod
   * @param     p_SS_Drb_Config
   * @status    APPROVED (NR5GC)
   */
  function f_NRL2_RRC_ConnectedState3N_ExtraDRBsNoNAS(NR_CellId_Type p_NR_CellId,
                                                      NR_TESTMODE_STATE_Type p_TestMode := TESTMode_OFF,
                                                      template (value) UE_TestLoopModeA_NR_LB_Setup_Type p_UE_TestLoopModeA_NR_LB_Setup := cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                                      template (omit) NR_RLC_BearerToAddModList_Type p_RLCConfigList,
                                                      template (omit) MAC_CellGroupConfig p_MACConfig := omit,
                                                      template (omit) DRB_ToAddModList p_DRBToAddMod,
                                                      template (value) NR_RadioBearerList_Type p_SS_Drb_Config) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    
    // Step 1 Page UE
    f_NR_Paging_Def(p_NR_CellId, RRC_IDLE);
    
    v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(p_NR_CellId);
    
    // Steps 5-6
    // RRC Security Mode procedure
    f_NR_RRC_ActivateSecurity (p_NR_CellId, v_ReceivedMsg.SecurityProtection.NasCount); // Use NasCount returned from Service Req

    // Steps 7-8
    f_NRL2_ReconfigExistingAndAddNewDRBs (p_NR_CellId,
                                 {cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, f_Get_NG_ServiceAcceptMsg(v_ReceivedMsg.Pdu.Msg.service_Request.pduSessionStatus))},  // @sic R5s201387 Baseline Moving sic@
                                 p_RLCConfigList,
                                 p_DRBToAddMod,
                                 p_SS_Drb_Config,
                                 p_MACConfig);

    // Step 9a1 - 9a2
    select (p_TestMode) {
      case (TEST_LOOPModeA_ON) {
        f_NR5GC_CloseUE_TestLoopModeA (p_NR_CellId, p_UE_TestLoopModeA_NR_LB_Setup);
      }
      case else { // do nothing
      }
    }
  }

  /*
   * @desc      To receive the Registration Req and check if for initial or mobility registration
   *
   * @param     p_GMM_MobilityInfo  (by reference)
   * @param     p_ReceivedMsg       (by reference)
   * @param     p_NR_CellId
   * @param     p_RxdGUTI           (default value: ?)
   * @param     p_TAI               (default value: *)
   * @return    TypeOfRegistration_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_InitialOrMobilityRegistrationRequest (out GMM_MobilityInfo_Type p_GMM_MobilityInfo,
                                                         out NG_NAS_MSG_Indication_Type p_ReceivedMsg,
                                                         NR_CellId_Type p_NR_CellId,
                                                         template (present) NG_MobileIdentity p_RxdGUTI := ?,
                                                         template NG_TrackingAreaId p_TAI := *) runs on NR_BASE_PTC return TypeOfRegistration_Type
  {
    var TypeOfRegistration_Type v_TypeOfRegistration;

    // Steps 1 - 3
    // RRC Connection Setup
    p_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));  // @sic R5-237454 sic@
    if (not f_Check_NG_RegistrationReqMsg (p_GMM_MobilityInfo, p_ReceivedMsg.Pdu, ?, p_RxdGUTI, -,-,-,-,-,-, p_TAI)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    
    select (p_ReceivedMsg.Pdu.Msg.registration_Request.registrationType.registrationType) {
      case (tsc_NG_RegistrationMobility) {
        v_TypeOfRegistration := Mobility;
      }
      case (tsc_NG_RegistrationInitial) {
        if (isvalue(p_ReceivedMsg.Pdu.PiggybackedPduList)) {  // @sic R5-237454 sic@
          v_TypeOfRegistration := Initial_Secure;
        } else {
          v_TypeOfRegistration := Initial_NoSecurity;
        }
      }
      case else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration type incorrect");
      }
    }
    return v_TypeOfRegistration;
  }

  /*
   * @desc      To receive the Registration Req, check if for initial or mobility registration then complete the procedure
   * @param     p_NR_CellId
   * @param     p_RxdGUTI           (default value: ?)
   * @param     p_TAI               (default value: *)
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_InitialOrMobilityRegistration (NR_CellId_Type p_NR_CellId,
                                                 template (present) NG_MobileIdentity p_RxdGUTI := ?,
                                                 template NG_TrackingAreaId p_TAI := *,
                                                 template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                                 template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                                 RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease) runs on NR5GC_PTC
  {
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var TypeOfRegistration_Type v_TypeOfRegistration := f_NR5GC_InitialOrMobilityRegistrationRequest (v_GMM_MobilityInfo, v_ReceivedMsg, p_NR_CellId, p_RxdGUTI, p_TAI);
    
    if (match(Mobility, v_TypeOfRegistration)) {
      f_NR5GC_MobilityRegistration_Steps4_6(p_NR_CellId, v_GMM_MobilityInfo, p_GUTIToSend, p_TAIList, p_ReleaseConnection);
    } else {
      // Steps 5 - 20
      f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, p_NR_CellId, v_ReceivedMsg, TESTMode_OFF, p_ReleaseConnection, v_TypeOfRegistration);
    }
  }

  /*
   * @desc      TS 38.508-1 table 4.9.5 Mobility Registration procedure
   *
   * @param     p_NR_CellId
   * @param     p_RxdGUTI           (default value: ?)
   * @param     p_TAI               (default value: *)
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_EPLMNs            (default value: omit)
   * @param     p_ServiceAreaList   (default value: omit)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_MobilityRegistration (NR_CellId_Type p_NR_CellId,
                                         template (present) NG_MobileIdentity p_RxdGUTI := ?,
                                         template NG_TrackingAreaId p_TAI := *,
                                         template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                         template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                         RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                         template (omit) PLMN_List p_EPLMNs := omit,
                                         template (omit) ServiceAreaIdList p_ServiceAreaList := omit) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;

    // Steps 1 - 3
    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, p_RxdGUTI, -,-,-,-,-,-, p_TAI)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
       
    f_NR5GC_MobilityRegistration_Steps4_6(p_NR_CellId, v_GMM_MobilityInfo, p_GUTIToSend, p_TAIList, p_ReleaseConnection, -, -, p_EPLMNs, p_ServiceAreaList); // @sic R5s210770 sic@
  }

  /*
   * @desc      TS 38.508-1 table 4.9.5 Mobility Registration procedure steps 4 to 6
   * @param     p_NR_CellId
   * @param     p_GMM_MobilityInfo_Type
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @param     p_NwkFeatureSupport (default value: cs_NG_NetworkFeatureSupport_Def)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @param     p_EPLMNs            (default value: omit)
   * @param     p_ServiceAreaList   (default value: omit)
   * @param     p_UERadioCapId   (default value: omit)
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_MobilityRegistration_Steps4_6(NR_CellId_Type p_NR_CellId,
                                                 GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                                 template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                                 template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                                 RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease,
                                                 template (value) NG_NetworkFeatureSupport p_NwkFeatureSupport := cs_NG_NetworkFeatureSupport_Def,
                                                 NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1,
                                                 template (omit) PLMN_List p_EPLMNs := omit,
                                                 template (omit) ServiceAreaIdList p_ServiceAreaList := omit,
                                                 template (omit) UERadioCapId p_UERadioCapId := omit) runs on NR5GC_PTC  // @sic R5-200692 sic@
  {
    //@sic R5-199036: added p_NwkFeatureSupport sic@
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (p_NR_CellId);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    
    if (isvalue(p_GUTIToSend)) {
      v_GUTIToSend := valueof(p_GUTIToSend);
    }
    if (isvalue(p_TAIList)) {
      v_TAIList := valueof(p_TAIList);
    }

    // Step 4
    // Registration Accept
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   p_GMM_MobilityInfo_Type,  // @sic R5-206426 sic@
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   p_EPLMNs, -, -, -,
                                                   p_NwkFeatureSupport,
                                                   -, -, -, -, -, -, p_ServiceAreaList, // @sic R5s210770 sic@
                                                   -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, p_UERadioCapId);
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, p_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
    // Step 5
    f_NR5GC_Registration_Complete(p_NR_CellId, p_SRB); // No SRB2 so must be on SRB1
    
    //Step 6
    if (p_ReleaseConnection == rrcConnectionRelease) {
      // Release RRC to enter RRC_IDLE
      f_NR_RRCRelease(p_NR_CellId);
    }
  }

  /*
   * @desc      TS 38.508-1 table 4.9.5 Check UE is camped on a new cell
   * @param     p_NR_CellId
   * @param     p_RxdGUTI           (default value: ?)
   * @param     p_TAI               (default value: *)
   * @param     p_GUTIToSend        (default value: omit)
   * @param     p_TAIList           (default value: omit)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_CheckCampedOnNewCell(NR_CellId_Type p_NR_CellId,
                                        template (present) NG_MobileIdentity p_RxdGUTI := ?,
                                        template NG_TrackingAreaId p_TAI := *,
                                        template (omit) NG_MobileIdentity p_GUTIToSend := omit,
                                        template (omit) NG_TrackingAreaIdList p_TAIList := omit,
                                        RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease)  runs on NR5GC_PTC
  {
    f_NR5GC_MobilityRegistration (p_NR_CellId, p_RxdGUTI, p_TAI, p_GUTIToSend, p_TAIList, p_ReleaseConnection);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Check UE camped on a new cell");
  }

  /*
   * @desc      TS 38.508-1 table 4.9.4 Check UE is in state 5GC RRC_IDLE
   * @param     p_NR_CellId
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_NR5GC_CheckRRCIdle(NR_CellId_Type p_NR_CellId,
                                RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease)  runs on NR5GC_PTC
  {
    f_NR5GC_RRC_ConnectedState3N_Def (p_NR_CellId);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Check 5GC RRC_IDLE");
    if (p_ReleaseConnection == rrcConnectionRelease) {
      f_NR_RRCRelease(p_NR_CellId);
    }
  }

  /*
   * @desc      Switches ON UE and Resets IMS
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_SwitchOnAndResetIMS() runs on NR5GC_PTC
  {
    f_NR5GC_ResetIPandIMS();                /* @sic R5s250275 sic@ */
    f_UT_SwitchOnUE(UT);                  // @sic R5s221193 sic@
  }

  /*
   * @desc      reset IMS on given PDN (mainly used in case of f_IMS_DefaultHandler running on the IMS PTC)
   * @param     p_PdnIndex
   * @param     p_ResetType         (default value: WithCNF)
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_ResetIMS(PDN_Index_Type p_PdnIndex,
                            IPCAN_IMS_Reset_Type p_ResetType := WithCNF) runs on NR5GC_PTC
  {
    var integer v_Index := f_PDN_PdnIndex2ImsIndex(p_PdnIndex);   // @sic R5s201177: f_PDN_PdnIndex2ImsIndex instead of f_PDN_PdnIndex2Integer sic@

    f_IMS_IPCAN_SendCoOrdMsg(IMS[v_Index], cms_IPCAN_IMS_Reset(p_ResetType));
    if (p_ResetType == WithCNF) {
      f_IMS_IPCAN_WaitForTrigger(IMS[v_Index]);
    }
  }

  /*
   * @desc      Resets IMS and IP
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_ResetIPandIMS() runs on NR5GC_PTC
  {
    f_NR5GC_ResetIMS(PDN_1);              // @sic R5s221193 sic@
    f_IP_Routing_RestoreRoutingTable(IP); /* @sic R5s201235 sic@ */
  }

  /*
   * @desc      additional default behaviour to be activated on top of the standard default behaviour
   *            to receive additional PDU Session Establishment Reqs, or other NAS messages in parallel
   * @param     p_NR_CellId
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  altstep a_NR5GC_AdditionalPDUSessionEstablishmentReq(NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, ?, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp
      {
        f_NR5GC_MsgInDefault_StoreNASMessageReq (v_ReceivedAsp); // @sic R5s220174 sic@
        repeat;
      }
  }

  /*
   * @desc      Establishes a PDU Session, sends the Accept message on an RRC Reconfiguration message to configure the new DRB
   *            and waits for IP signaling
   * @param     p_NR_CellId
   * @param     p_ExpectedNumberOfNewPDUSessions (default value: pc_noOf_PDUsSameConnection)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @param     p_SDAP_Config       (default value: omit)
   * @param     p_ExpectedS_NSSAI   (default value: *)
   * @param     p_ExpectedDNN       (default value: *)
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_DNN               (default value: omit)
   * @param     p_QoS_Rules         (default value: omit)
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_QoSFlowDescr      (default value: omit)
   * @param     p_PDU_SessionId     (default value: ?)
   * @param     p_PTI               (default value: omit)
   * @param     p_PDU_SessionType   (default value: omit)
   * @param     p_ExpectedSSC_Mode  (default value: *)
   * @param     p_UECap             (default value: *)
   * @param     p_MaxNumPacketFilters (default value: *)
   * @param     p_IntegrityProtMaxDataRate (default value: ?)
   * @param     p_AlwaysOnPDUSessionReq (default value: *)
   * @param     p_PDUReq            (default value: *)
   * @param     p_ExtdPCO           (default value: *)
   * @param     p_OldPDU_SessionId  (default value: *)
   * @param     p_RequestType       (default value: cr_NG_Request_Type('001'B))
   * @param     p_AdditionalInfo    (default value: *)
   * @param     p_Cause             (default value: omit)
   * @param     p_RQTimer           (default value: omit)
   * @param     p_EAP               (default value: omit)
   * @param     p_BackOff           (default value: omit)
   * @param     p_PDUSessionAuthenticationRequired (default value: false)
   * @param     p_TriggerWithThisAPN (default value: omit)
   * @param     p_FailWhenK_LessN   (default value: true)
   * @param     p_BuildQosFlow      (default value: omit)
   * @param     p_PduInfoFromLTE    (default value: omit)
   * @param     p_WaitIfIMS         (default value: true)
                 ..Need to delay for IP/IMS signalling if RRCRelease is about to be sent in the calling function
                                     if set to false, assume the connection will be up long enough to complete 'extra-ordinary' IMS signalling without waiting here
   * @param     p_EstReqAlreadyInDefault (default value: 0)
                 ..Set to 1 if a_NR5GC_AdditionalPDUSessionEstablishmentReq has just been activated and received one unprocessed Establishment Req
   * @param     p_OmitDNN           (default value: false)
                 ..Only set to true if the DNN is to be omitted from Accept message
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_PDUSessionEstablishment(NR_CellId_Type p_NR_CellId,
                                           integer p_ExpectedNumberOfNewPDUSessions := pc_noOf_PDUsSameConnection,  // @sic R5s201358 sic@,
                                           NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2,
                                           template (omit) SDAP_Config p_SDAP_Config := omit,
                                           template S_NSSAI_Type p_ExpectedS_NSSAI := *,
                                           template DNN p_ExpectedDNN := *,
                                           template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                           template (omit) DNN p_DNN := omit,
                                           template (omit) QoS_Rules p_QoS_Rules := omit,
                                           template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                           template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                           template (omit) QoSFlowDescr p_QoSFlowDescr := omit,
                                           template (present) O1_Type p_PDU_SessionId := ?,
                                           template ProcedureTransactionIdentifier p_PTI := omit,
                                           template (omit) PDU_SessionType p_PDU_SessionType := omit,
                                           template SSC_Mode p_ExpectedSSC_Mode := *, // @sic R5s190290 sic@
                                           template NG_UE_SM_Cap p_UECap := *,
                                           template MaxNumPacketFilters p_MaxNumPacketFilters := *,
                                           template IntegrityProtMaxDataRate p_IntegrityProtMaxDataRate := ?,
                                           template AlwaysOnPDUSessionReq p_AlwaysOnPDUSessionReq := *,
                                           template SM_PDU_DN_RequestContainer p_PDUReq := *,
                                           template ExtdProtocolConfigOptions p_ExtdPCO := *,
                                           template NG_PDU_SessionId p_OldPDU_SessionId := *,
                                           template NG_Request_Type p_RequestType := cr_NG_Request_Type('001'B),  // @sic R5-206290 sic@
                                           template AdditionalInformation p_AdditionalInfo := *,
                                           template (omit) GMM_GSM_Cause p_Cause := omit,
                                           template (omit) GPRS_Timer p_RQTimer := omit,
                                           template (omit) EAP_Message p_EAP := omit,
                                           template (omit) GPRS_Timer3 p_BackOff := omit,
                                           boolean p_PDUSessionAuthenticationRequired := false,
                                           template (omit) charstring p_TriggerWithThisAPN := omit,
                                           boolean p_FailWhenK_LessN := true,
                                           template (omit) charstring p_BuildQosFlow := omit,
                                           template (omit) EUTRA_NR_PduSessionInfoList_Type p_PduInfoFromLTE := omit, // @sic R5-198184, R5-199075 sic@
                                           boolean  p_WaitIfIMS := true, // @sic R5s210515 sic@
                                           integer p_EstReqAlreadyInDefault := 0,
                                           boolean p_OmitDNN := false) runs on NR5GC_PTC // @sic R5-223987 sic@
  {
    var SRBs_AlreadyConfigured v_SRBs := SRB1_2;
    var NR_RadioBearerId_Type v_SRB := p_SRB;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var integer v_K_NumOfReqsProcessed := 0;
    var integer v_L_NumOfReqsReceivedInParallel := 0;
    var boolean v_EndLoop := false;
    var boolean v_RxdMsg;
    var PDU_PDN_DNN_Type v_PDUType;
    var DelayForUserPlaneSignalling_Type v_WaitForUserplaneSignalling := noDelay; // Default: no IP signalling possible
    var default v_MyDefaultVar := null;
    
    timer t_Wait := 8.0; // @sic R5-206288 sic@ 8s is less than T3540

    if (p_EstReqAlreadyInDefault == 0){ // @sic R5s210520 sic@
      // Clear store of msgs received in parallel
      f_NR5GC_MsgInDefault_ResetStoreOfNASMessageReq(); // @sic R5s220174 sic@
    }
    // Then activate store for any new msgs received
    v_MyDefaultVar := activate(a_NR5GC_AdditionalPDUSessionEstablishmentReq(p_NR_CellId));
    
    while ((v_K_NumOfReqsProcessed < p_ExpectedNumberOfNewPDUSessions) and not v_EndLoop) { // @sic R5-199075, R5-204329 sic@
      v_RxdMsg := false;
      t_Wait.start; // @sic R5-204329 sic@
      if (f_NR5GC_MsgInDefault_GetNumOfNASMessageReq() > v_L_NumOfReqsReceivedInParallel) { // @sic R5s220174 sic@
        // If another msg has been recieved in parallel since the last time we looked
        v_L_NumOfReqsReceivedInParallel := v_L_NumOfReqsReceivedInParallel + 1;
          if (v_L_NumOfReqsReceivedInParallel > p_ExpectedNumberOfNewPDUSessions){ // @sic R5-204329 sic@
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "More PDU Session Establishment Messages Received Than Expected");
          }
        v_ReceivedAsp := f_NR5GC_MsgInDefault_GetOneNASMessageReq(v_L_NumOfReqsReceivedInParallel); // @sic R5s220174 sic@
        v_RxdMsg := true;
        t_Wait.stop;      // @sic R5s210520 sic@
      } else { // no outstanding msgs, so must wait for next PDU Establishment
        alt {
          [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp
             { // Stop timer and continue with while loop
               t_Wait.stop;
               v_RxdMsg := true;
             }
          [] t_Wait.timeout
             {
               if (p_FailWhenK_LessN) { // @sic R5-204329 sic@
                 f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Not enough PDU Session Establishment Messages Received");
               } else {
                 v_EndLoop := true;
               }
             }
        }
      }
      
      if (v_K_NumOfReqsProcessed > 0) { // @sic R5s200751 sic@
        if (isvalue(p_TriggerWithThisAPN)) { // @sic R5-199075  sic@
          f_UT_RequestPDUSession(UT, f_NR5GC_MobileInfo_GetNoOfSessions()+1, valueof(p_TriggerWithThisAPN)); // @sic R5-204439 sic@
        }
      }
      
      if (v_RxdMsg) { // @sic R5-204329 sic@ this will be false if either just triggered a new PDN, or about to end the loop
        // Update K now as latest msg is about to be processed
        v_K_NumOfReqsProcessed := v_K_NumOfReqsProcessed + 1;
        if (v_SRB == tsc_NR_RbId_SRB1) { // @sic R5-198923 sic@
          v_SRBs := SRB1;
        }
        v_PDUType := f_NR5GC_PDUSessionEstablishment_InnerLoop(p_NR_CellId,
                                                               v_ReceivedAsp,
                                                               v_SRBs,
                                                               p_SDAP_Config,
                                                               p_ExpectedS_NSSAI,
                                                               p_ExpectedDNN,
                                                               p_SSC_Mode,
                                                               p_DNN,
                                                               p_QoS_Rules,
                                                               p_Session_AMBR,
                                                               p_S_NSSAI,
                                                               p_QoSFlowDescr,
                                                               p_PDU_SessionId,
                                                               p_PTI,
                                                               p_PDU_SessionType,
                                                               p_ExpectedSSC_Mode,
                                                               p_UECap,
                                                               p_MaxNumPacketFilters,
                                                               p_IntegrityProtMaxDataRate,
                                                               p_AlwaysOnPDUSessionReq,
                                                               p_PDUReq,
                                                               p_ExtdPCO,
                                                               p_OldPDU_SessionId,
                                                               p_RequestType,
                                                               p_AdditionalInfo,
                                                               p_Cause,
                                                               p_RQTimer,
                                                               p_EAP,
                                                               p_BackOff,
                                                               p_PDUSessionAuthenticationRequired,
                                                               p_BuildQosFlow,
                                                               p_PduInfoFromLTE, // @sic R5-198184 sic@
                                                               p_OmitDNN);  // @sic R5-223987 sic@
                                                               
        if (v_SRB == tsc_NR_RbId_SRB1) { // SRB2 will be configured in the 1st instance (if it hasn't already)
          v_SRB := tsc_NR_RbId_SRB2;
          v_SRBs := SRB1_2;  // @sic R5-198923 sic@
        }
        if (p_WaitIfIMS) { // @sic R5s210515, R5s220807, R5s240641 sic@
        /* Need to delay for IP/IMS signalling if RRCRelease is about to be sent
         if set to noRrcConnectionRelease, assume the connection will be up long enough
         to complete IMS signalling without waiting here */
        // Wait for IP signalling @sic R5-204329, R5-206296 sic@
        if (match (IMS_DNN, v_PDUType)) {   // @sic R5-206296, R5s240641 sic@
          v_WaitForUserplaneSignalling := waitForIMS;
        }  else { // currently all PDUs require IP signalling
        v_WaitForUserplaneSignalling := dontWaitForIMS;
        }
        f_NR_DelayForUserPlaneSignalling(v_WaitForUserplaneSignalling);  // @sic R5-206296 sic@
       }
     }
    }
    
    
    // all expected msgs have been processed, so deactivate the extra default
    deactivate(v_MyDefaultVar);
  }

  /*
   * @desc      Establishes a PDU Session, sends the Accept message on an RRC Reconfiguration message to configure the new DRB
   *            and waits for IP signaling
   * @param     p_NR_CellId
   * @param     p_ReceivedAsp
   * @param     p_SRB               (default value: SRB1_2)
   * @param     p_SDAP_Config
   * @param     p_ExpectedS_NSSAI   (default value: *)
   * @param     p_ExpectedDNN       (default value: *)
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_DNN               (default value: omit)
   * @param     p_QoS_Rules         (default value: omit)
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_QoSFlowDescr      (default value: omit)
   * @param     p_PDU_SessionId     (default value: ?)
   * @param     p_PTI               (default value: omit)
   * @param     p_PDU_SessionType   (default value: omit)
   * @param     p_ExpectedSSC_Mode  (default value: *)
   * @param     p_UECap             (default value: *)
   * @param     p_MaxNumPacketFilters (default value: *)
   * @param     p_IntegrityProtMaxDataRate (default value: ?)
   * @param     p_AlwaysOnPDUSessionReq (default value: *)
   * @param     p_PDUReq            (default value: *)
   * @param     p_ExtdPCO           (default value: *)
   * @param     p_OldPDU_SessionId  (default value: *)
   * @param     p_RequestType       (default value: ?)
   * @param     p_AdditionalInfo    (default value: *)
   * @param     p_Cause             (default value: omit)
   * @param     p_RQTimer           (default value: omit)
   * @param     p_EAP               (default value: omit)
   * @param     p_BackOff           (default value: omit)
   * @param     p_PDUSessionAuthenticationRequired (default value: false)
   * @param     p_BuildQosFlow      (default value: omit)
   * @param     p_PduInfoFromLTE    (default value: omit)
   * @param     p_OmitDNN           (default value: false)
   * @return    PDU_PDN_DNN_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_PDUSessionEstablishment_InnerLoop(NR_CellId_Type p_NR_CellId,
                                                     NR_SRB_COMMON_IND p_ReceivedAsp,
                                                     SRBs_AlreadyConfigured p_SRB := SRB1_2,
                                                     template (omit) SDAP_Config p_SDAP_Config,
                                                     template S_NSSAI_Type p_ExpectedS_NSSAI := *,
                                                     template DNN p_ExpectedDNN := *,
                                                     template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                                     template (omit) DNN p_DNN := omit,
                                                     template (omit) QoS_Rules p_QoS_Rules := omit,
                                                     template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                                     template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                                     template (omit) QoSFlowDescr p_QoSFlowDescr := omit,
                                                     template (present) O1_Type p_PDU_SessionId := ?,
                                                     template ProcedureTransactionIdentifier p_PTI := omit,
                                                     template (omit) PDU_SessionType p_PDU_SessionType := omit,
                                                     template SSC_Mode p_ExpectedSSC_Mode := *, // @sic R5s190290 sic@
                                                     template NG_UE_SM_Cap p_UECap := *,
                                                     template MaxNumPacketFilters p_MaxNumPacketFilters := *,
                                                     template IntegrityProtMaxDataRate p_IntegrityProtMaxDataRate := ?,
                                                     template AlwaysOnPDUSessionReq p_AlwaysOnPDUSessionReq := *,
                                                     template SM_PDU_DN_RequestContainer p_PDUReq := *,
                                                     template ExtdProtocolConfigOptions p_ExtdPCO := *,
                                                     template NG_PDU_SessionId p_OldPDU_SessionId := *,
                                                     template NG_Request_Type p_RequestType := ?,
                                                     template AdditionalInformation p_AdditionalInfo := *,
                                                     template (omit) GMM_GSM_Cause p_Cause := omit,
                                                     template (omit) GPRS_Timer p_RQTimer := omit,
                                                     template (omit) EAP_Message p_EAP := omit,
                                                     template (omit) GPRS_Timer3 p_BackOff := omit,
                                                     boolean p_PDUSessionAuthenticationRequired := false,
                                                     template (omit) charstring p_BuildQosFlow := omit, // set to required value if a specific QoSFlow must be built (with interworkingWithEPS parameters)
                                                     template (omit) EUTRA_NR_PduSessionInfoList_Type p_PduInfoFromLTE := omit, // Only included when called from S1ToN1 TAU
                                                     boolean p_OmitDNN := false  // @sic R5-223987 sic@ - Only set to true if the DNN is to be omitted from Accept message
                                                     ) runs on NR5GC_PTC return PDU_PDN_DNN_Type // @sic R5-198184, R5-206296 sic@
  { // Split function so list of DRBs can be built elsewhere @sic R5-199103 sic@
    // Moved UT trigger up to f_NR5GC_PDUSessionEstablishment @sic R5s200751 sic@
    // Moved building of some parameters into new function f_BuildDefPDUSessionAcceptandSendOverReconfig @sic R5-255822 sic@
    var GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1;
    var NG_NAS_SecurityParams_Type v_SecurityParams; // @sic R5-198184 sic@
    var PDU_PDN_DNN_Type v_PDUType := None;  // @sic R5s210148 sic@
    var template (omit) PDN_AddressInfo_Type v_ExtraPDN_Address := omit;
    var template (omit) EthernetHeaderCompressConfig v_EthernetHeaderCompressConfig := omit;

    if (not f_Check_NG_PDUSessionEstablishmentReq(v_GSM_MobilityInfo,
                                                  p_ReceivedAsp.Signalling.Nas[0].Pdu,
                                                  p_PDU_SessionId,
                                                  p_PTI,
                                                  p_IntegrityProtMaxDataRate,
                                                  p_PDU_SessionType,
                                                  p_ExpectedSSC_Mode,
                                                  p_UECap,
                                                  p_MaxNumPacketFilters,
                                                  p_AlwaysOnPDUSessionReq,
                                                  p_PDUReq,
                                                  p_ExtdPCO,
                                                  p_OldPDU_SessionId,
                                                  p_RequestType,
                                                  p_ExpectedS_NSSAI,
                                                  p_ExpectedDNN,
                                                  p_AdditionalInfo)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Establishment Message Failed");
    }
    
    // @sic moved building of some parameters into new function f_BuildDefPDUSessionAcceptandSendOverReconfig R5-255822 sic@

    if (match(p_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Establishment_Request.pduSessionType.typeValue, '101'B)) { // @sic R5-227473 sic@
      // Ethernet PDU session
      if (not ispresent(p_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Establishment_Request.ds_TT_EthernetPortMACAddr)) {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Ethernet PDU Request doesn't contain MAC Address");
      }
      if (ispresent(p_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Establishment_Request.ethernetHeaderCompressConfig)) {
        v_EthernetHeaderCompressConfig := p_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg.pdu_Session_Establishment_Request.ethernetHeaderCompressConfig;
      } else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Ethernet PDU Request doesn't contain compression header");
      }
    }
    
    // @sic moved building of some parameters into new function f_BuildDefPDUSessionAcceptandSendOverReconfig R5-255822 sic@

    if(p_PDUSessionAuthenticationRequired){ // @sic R5-198184 sic@
      //Perform PDU Session Authentication if required
      v_SecurityParams := f_NR5GC_Security_Get();
      if (p_SRB == SRB1_2) { // @sic R5s201412 sic@
        v_SRB := tsc_NR_RbId_SRB2;
      }
      f_PDUSessionAuthentication( p_NR_CellId, v_SecurityParams, v_GSM_MobilityInfo, v_PLMN, v_SRB); // @sic R5s201412 sic@
    }
    
    if (f_NR5GC_MobileInfo_GetNumOfIPAddressesToAllocate() != 1) { // @sic R5-217830 sic@
      // According to NOTE 4 in PIXIT definition, this is currently only used for the 2nd PCSCF address of PDN_1
      v_ExtraPDN_Address := f_PDN_AddressInfo_Get(PDN_1);
      v_ExtraPDN_Address.PCSCF_IPAddressIPv4 := px_IPv4_Address_Other;
      v_ExtraPDN_Address.PCSCF_IPAddressIPv6 := px_IPv6_Address_Other;
    }
    
    // Send Accept
    // Created common function for sending Accept message @sic R5-241606 sic@
    v_PDUType := f_BuildDefPDUSessionAcceptandSendOverReconfig (p_NR_CellId,
                                                                v_GSM_MobilityInfo,
                                                                p_SRB,
                                                                p_SDAP_Config,
                                                                p_SSC_Mode,
                                                                p_DNN,              // @sic R5-205939 sic@
                                                                p_Session_AMBR,
                                                                p_PDU_SessionType,
                                                                p_Cause,
                                                                p_RQTimer,
                                                                p_S_NSSAI,
                                                                -,
                                                                p_EAP,
                                                                p_QoS_Rules,
                                                                p_QoSFlowDescr,
                                                                omit,
                                                                p_BackOff,
                                                                p_BuildQosFlow,
                                                                p_OmitDNN,
                                                                p_PduInfoFromLTE,
                                                                -, -, -, -, -,
                                                                v_EthernetHeaderCompressConfig, // @sic R5-227473 sic@
                                                                v_ExtraPDN_Address); //@sic R5-213400 sic@
    
    return v_PDUType;  // @sic R5-206296 sic@
  }

  /*
   * @desc      To change the DRB mapping for a PDN that's previously been configured in EUTRA
   *            If the QFI isn't included in p_PduSessionInfo, then the p_AlternativeQFI is used
   *            If both are set to omit, then return false
   * @param     p_NR_CellId
   * @param     p_PduSessionInfo
   * @param     p_AlternativeQFI    (default value: omit)
   * @return    boolean
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_ChangeDrbMappingForExistingPDNs (NR_CellId_Type p_NR_CellId,
                                                 EUTRA_NR_PduSessionInfo_Type p_PduSessionInfo,
                                                 template (omit) integer p_AlternativeQFI := omit) runs on NR_BASE_PTC return boolean
  {
    var integer v_QFI := 0;
    var boolean v_ChangeRouting := true;
    
    if (isvalue(p_PduSessionInfo.QFI)) {
      v_QFI := p_PduSessionInfo.QFI;
    } else if (isvalue(p_AlternativeQFI)){
      v_QFI := valueof(p_AlternativeQFI);
    } else {
      v_ChangeRouting := false;
    }
    if (v_ChangeRouting) {
      f_IP_ChangeDrbMappingNR(IP, p_NR_CellId, cs_IP_QosFlowId(p_PduSessionInfo.PDU_SessionId, v_QFI), p_PduSessionInfo.PdnIndex);
    }
    return v_ChangeRouting;
  }

  /*
   * @desc      If the UE supports EUTRA, get the next EPS Bearer Id, if not return omit
   * @param     p_GSM_MobilityInfo
   * @param     p_GMM_MobilityInfo
   * @param     p_MediaType         (default value: omit)
   * @return    template
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_GetNextEPSBearerId (GSM_MobilityInfo_Type p_GSM_MobilityInfo,
                                 GMM_MobilityInfo_Type p_GMM_MobilityInfo,
                                 template (omit) IMS_MediaToBeAdded_Type p_MediaType := omit) runs on NR5GC_PTC return template (omit) integer
  {
    var template (omit) integer v_BearerId := omit;
    var IntegerList_Type v_ExistingIds := f_NR5GC_MobileInfo_GetEPS_BearerIdList();
    var integer v_NoOfIds := lengthof(v_ExistingIds);
    var integer i;
    // Re-written to hardcode values to allow for possible repeated media calls
    // - this assumes not more than 1 type of media call at any one time, and not more than 6 'other' PDN types @sic R5s211486 sic@
    
    if (isvalue(p_GMM_MobilityInfo.GMMCap)) {
      if (p_GMM_MobilityInfo.GMMCap.s1Cap == '1'B) {
        if (isvalue(p_MediaType)) {    // @sic R5s211486 sic@
          // check to see if we can hardcode the dedicated bearer first
          select (valueof(p_MediaType)) {
            case (Speech) {
              v_BearerId := 7;
            }
            case (Emergency) {
              v_BearerId := 9;
            }
            case else {  // @sic R5-252291 sic@
              v_BearerId := 8;
            }
          }
         // now allocate id according to default bearer type
        } else if (p_GSM_MobilityInfo.PDUType == IMS_DNN) {    // @sic R5-205939 sic@
          v_BearerId := 5;
          for (i:= 0; i < v_NoOfIds; i :=i+1) {
            if (match (v_ExistingIds[i], 5)) { // IMS Bearer id = 5
              v_BearerId := v_NoOfIds + (10-1); // allocate the next one, from 10 onwards @sic R5s211486 sic@
              break;
            }
          }
        } else if (p_GSM_MobilityInfo.PDUType == Emergency_PDN) {    // @sic R5s211486 sic@
            v_BearerId := 6;
        } else { // Not IMS or emergency
          v_BearerId := v_NoOfIds + 10; // @sic R5s211486 sic@
        }
        // Add the new id to the end of the list and store it
        v_ExistingIds[v_NoOfIds] := valueof(v_BearerId);
        f_NR5GC_MobileInfo_SetEPS_BearerIdList(v_ExistingIds);
      }
    }
    return v_BearerId;
  }

  /*
   * @desc      Auxiliary function that builds a RRC Reconfiguration message with a given list of DRBs
   * @param     p_RadioBearerConfig (by reference)
   * @param     p_CellGroupConfig   (by reference)
   * @param     p_SSConfig          (by reference)
   * @param     p_SDAP_Configuration (by reference)
   * @param     p_NR_CellId
   * @param     p_GSM_MobilityInfoList
   * @param     p_SRBs              (default value: SRB1)
   * @param     p_SDAP_Config       (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_BuildRRCReconfigParamsNewDRBs (out template (value) RadioBearerConfig p_RadioBearerConfig,
                                      out template (value) CellGroupConfig p_CellGroupConfig,
                                      out template (value) NR_RadioBearerList_Type p_SSConfig,
                                      out template (value) SDAP_ConfigurationList_Type p_SDAP_Configuration,
                                      NR_CellId_Type p_NR_CellId,
                                      PDUSessionInfoList_Type p_GSM_MobilityInfoList,
                                      SRBs_AlreadyConfigured p_SRBs := SRB1,
                                      template (omit) SDAP_Config p_SDAP_Config := omit)  // @sic R6s260049 sic@
                                            runs on NR5GC_PTC
  { // Split function so list of DRBs can be built elsewhere @sic R5-199103 sic@
    var template (omit) SRB_ToAddModList v_SRBToAddModList := omit;
    var template (value) DRB_ToAddModList v_DRBToAddModList;
    var integer v_NewDRBId;
    var NR_DRB_IdentityList_Type v_DrbList;
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(p_NR_CellId);
    var template (value) SDAP_Config v_SDAP_Config;
    var integer i := 0;
    var integer j := 0; // for CellGroupConfig
    var template (omit) integer v_ChAccPriority := f_NR_SharedAccessChAccPriority(p_NR_CellId); //SharedAccess @sic R5-243536 sic@
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
    
    for (i := 0; i < lengthof(p_GSM_MobilityInfoList); i := i + 1) {
      if (isvalue(p_SDAP_Config)) {  // @sic R5s260049 sic@
        v_SDAP_Config := valueof(p_SDAP_Config); //@sic R5-190720 sic@
      } else {
        select(p_GSM_MobilityInfoList[i].PDUType) { // @sic R5-221467, R5s260049 sic@
          case(IMS_DNN) {   // @sic R5-206296, R5s210518 sic@
            v_SDAP_Config := cs_SDAP_Config(-, -, {2});
          }
          case(Emergency_PDN) {   // @sic R5-206296, R5s210518, R5s50092 sic@
            v_SDAP_Config := cs_SDAP_Config(-, -, {2});
          }
          case (URLLC_DNN) {
            v_SDAP_Config := cs_SDAP_Config(-, -, {9}); // @sic R5-221467 sic@
          }
          case else {
            v_SDAP_Config := cs_SDAP_Config;
          }
        }
      }

      // Set SDAP PDU session Id to the value received in SessionEstablishmentReq @sic R5-190720 sic@
      v_SDAP_Config.pdu_Session  := oct2int(p_GSM_MobilityInfoList[i].SessionId);  // @sic R5s200564 sic@
      
      p_SDAP_Configuration[i] := f_ReturnNR_SDAP_Configuration_FromSDAP_Config(valueof(v_SDAP_Config));
    
      // Get the DRB Id to use
      v_NewDRBId := f_NR_GetNextDRBId(p_GSM_MobilityInfoList[i], valueof(v_SDAP_Config.defaultDRB));
      v_DrbList[i] := v_NewDRBId;
    
       //SRB2 already configured in SS at cell creation/RRC release procedure => not needed here
      p_SSConfig[i] := cs_NR_SS_DRB_Config(v_NewDRBId,
                                           cs_NR_PDCP_Configuration_RBTerminating(cs_NR_PDCP_RbConfig_ParamsDRB),
                                           cs_NR_RlcBearerConfig_AM(v_IsFR1, -, f_NR_LogicalChannelId_DRB(v_NewDRBId)),
                                           p_SDAP_Configuration[i]);
      v_DRBToAddModList[i] := cs_38508_NRDRB_ToAddMod(v_SDAP_Config, v_NewDRBId, cs_38508_PDCP_Config);
    }
    
    p_CellGroupConfig := f_NR_GetCellgroupConfig_DRB (p_NR_CellId, v_DrbList, false); // @sic R5s200417 sic@
    j := i;  // j is now the length of the DRB list @sic R5s200417 sic@
    i := 0;
    if (p_SRBs == NONE) { // @sic R5-198923 sic@
      v_SRBToAddModList[i] := cs_NR_SRB_ToAddMod(tsc_SRB1);
      p_CellGroupConfig.rlc_BearerToAddModList[j] := valueof(cs_38508_RLC_BearerConfig_SRB(tsc_SRB1, -, -, -, v_RLC_Config_v1700)); //@sic R5-256933 sic@
      p_CellGroupConfig.mac_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_NR_CellId);  // @sic R5-202639 sic@
      p_CellGroupConfig.physicalCellGroupConfig := f_NR_CellInfo_GetPhysicalCellGroupConfig(p_NR_CellId);            // @sic R5-202639 sic@
      p_CellGroupConfig.spCellConfig := f_NR_GetSpCellConfigDef(p_NR_CellId, f_NR_GetServingCellConfig(p_NR_CellId));  // @sic R5s201078 sic@
      p_CellGroupConfig.spCellConfig.reconfigurationWithSync := cs_NR_ReconfigurationWithSyncDef(f_NR_GetServingCellConfigCommon(p_NR_CellId),
                                                                                               tsc_C_RNTI_Value3,
                                                                                               -, //  p_T304 := ms1000,
                                                                                               omit);
      i := i + 1;
      j := j + 1;
    }
    if (p_SRBs != SRB1_2) { // @sic R5-198923 sic@
      v_SRBToAddModList[i] := cs_NR_SRB_ToAddMod(tsc_SRB2);
      p_CellGroupConfig.rlc_BearerToAddModList[j] := valueof(cs_38508_RLC_BearerConfig_SRB(tsc_SRB2, -, v_ChAccPriority, -,  v_RLC_Config_v1700)); //@sic R5-190360, R5-243536, R5-256933 sic@
    }

    p_RadioBearerConfig := cs_38508_RadioBearerConfigDef(v_SRBToAddModList,
                                                         v_DRBToAddModList,
                                                         -,
                                                         cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig(f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), master));
  }

  /*
   * @desc      Returna SDAP Configuration From SDAP config
   * @param     p_SDAP_Config
   * @return    template (value) SDAP_Configuration_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_ReturnNR_SDAP_Configuration_FromSDAP_Config(SDAP_Config p_SDAP_Config) return template (value) SDAP_Configuration_Type
  {
    var template (value) SDAP_Configuration_Type v_SDAP_Configuration;
    var SDAP_Header_Type v_Sdap_HeaderDL;
    var SDAP_Header_Type v_Sdap_HeaderUL;
    
    select (p_SDAP_Config.sdap_HeaderDL){
      case (present_) { v_Sdap_HeaderDL := Present; }
      case (absent)   { v_Sdap_HeaderDL := Absent; }
    }
    select (p_SDAP_Config.sdap_HeaderUL){
      case (present_) { v_Sdap_HeaderUL := Present; }
      case (absent)   { v_Sdap_HeaderUL := Absent; }
    }

    v_SDAP_Configuration := cs_SDAP_Configuration(p_SDAP_Config.pdu_Session,
                                                  v_Sdap_HeaderDL,
                                                  v_Sdap_HeaderUL,
                                                  p_SDAP_Config.mappedQoS_FlowsToAdd);
    return v_SDAP_Configuration;
  }

  /*
   * @desc      1.2s delay acc. to 36.508 cl. 4.5A.1 to allow user-plane signalling
   * @param     p_DelayForUserPlaneSignalling (default value: waitForIMS)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_DelayForUserPlaneSignalling(DelayForUserPlaneSignalling_Type p_DelayForUserPlaneSignalling := waitForIMS) runs on NR5GC_PTC
  {
    var boolean v_LoopbackIsActivated;
    var DelayForUserPlaneSignalling_Type v_DelayForUserPlaneSignalling := p_DelayForUserPlaneSignalling;

    if (p_DelayForUserPlaneSignalling == waitForIMS) {
      v_LoopbackIsActivated := f_NR5GC_GetLoopbackIsActivated();
      if (not pc_IMS_5GS or v_LoopbackIsActivated) {
        v_DelayForUserPlaneSignalling := dontWaitForIMS;
        f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IPCAN_IMS_NoRegistration);
      }
    }

    f_IPCAN_DelayForUserPlaneSignalling(IMS[tsc_Index_IMS1], v_DelayForUserPlaneSignalling);
  }

  /*
   * @desc      This function should be used at the end of every test case to ensure the UE
   *            detaches and release the RRC connection as it is turned off and only then will it
   *            take down the cell the UE is currently camped on
   *            Using procedures defined in 38.508-1 cl. 4.9.6
   * @param     p_NR_CellId
   * @param     p_UE_State
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Postamble(NR_CellId_Type p_NR_CellId,
                          NG_ALL_STATE_Type p_UE_State,
                          NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2) runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_DetachReq;
    var boolean v_RxdMsg := false;
    var boolean v_RxdCnf := false;
    timer t_Wait := 5.0;
    
    if (p_UE_State == STATE_EMERGENCY_RELEASE_CONNECTED) { // @sic R5-214620 sic@
      //The SS transmits a DEREGISTRATION REQUEST with indicates "re-registration not required".
      SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, p_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                                           f_Get_NG_DeregistrationReqMTMsg(crs_DeregisterType('0'B, '0'B), omit))));
      t_Wait.start;
      alt {
        // Does the UE transmit a DEREGISTRATION ACCEPT message?
        [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId,
                                          p_SRB,
                                          cr_NG_NAS_Ind((tsc_SHT_IntegrityProtected,tsc_SHT_IntegrityProtected_Ciphered),
                                                        cr_NG_DEREGISTRATION_ACCEPT))){
           t_Wait.stop;
           f_NR_RRCRelease(p_NR_CellId);
        }
        // Does the UE transmit a GMM STATUS message? @sic R5s211528 sic@
        [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId,
                                          p_SRB,
                                          cr_NG_NAS_Ind((tsc_SHT_IntegrityProtected,tsc_SHT_IntegrityProtected_Ciphered),
                                                        cr_NG_GMM_STATUS(?)))){
           t_Wait.stop;
           f_NR_RRCRelease(p_NR_CellId);
        }
        [] t_Wait.timeout{}
      }
      f_NR_UE_DeRegisterOnSwitchOff (p_NR_CellId, STATE_DEREGISTERED);
    }
    else if (p_UE_State == STATE_EMERGENCY_RELEASE_IDLE) { // @sic R5-214620 sic@
      if (pc_SwitchOnOff) { // The UE can actually be switched off
        f_UT_SwitchOffUE(UT, false, CNF_REQUIRED, true); // @sic R5s220417 sic@
        alt { // The Setup Req may arrive before the CNF @sic R5s220417 sic@
          [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(p_NR_CellId, cr_38508_RRCSetupRequest))){}
          [] UT.receive(car_UT_COMMON_CNF){
              v_RxdCnf := true;
            }
        }
        t_Wait.start;  // Still need to start timer incase Setup Req arrives after CNF
        // @sic R5s211344 sic@
        // Steps 1a3a1 - 1a3a4 (Steps 1a3a2, 1a3b1 done inside f_NR_RRC_SetupRequest_Common)
        v_RxdMsg := f_NR_RRC_SetupRequest_Common(p_NR_CellId, t_Wait);
        if (v_RxdMsg) {
          f_NR_RRCSetup_Def (p_NR_CellId);
          v_DetachReq := f_NR_RRCSetupComplete_Def(p_NR_CellId, cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def));
          if (not f_Check_NG_DeregistrationReqMOMsg (v_DetachReq.Pdu, crs_DeregisterType('1'B, '0'B, '01'B))) { // Jun24 @sic R5s240531 Baseline Moving sic@
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Deregistration Request Message Failed");
          }
          // Step 1a3a5
          f_NR_RRCRelease(p_NR_CellId);
        }
        if (not v_RxdCnf) { // If Setup is already there, still need to wait for CNF @sic R5s220417 sic@
          UT.receive(car_UT_COMMON_CNF);
        }
        
      } else {
        f_UT_PowerOffUE(UT);
      }
    } else {
      // All other options already handled in Deregister function
      f_NR_UE_DeRegisterOnSwitchOff (p_NR_CellId, p_UE_State, p_SRB); // @sic R5-195241, R5s21163 sic@
    }
    
    //And now remove the cell(s)
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      This function turns the UE off, waits for a Deregister message and releases the RRC connection
   *            Defined in 38.508-1 cl. 4.9.6.1 and 4.9.6.3
   * @param     p_NR_CellId
   * @param     p_UE_State
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @param     p_USIM_Rmvd         (default value: false)
   * @param     p_AccessType        (default value: '01'B)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_UE_DeRegisterOnSwitchOff(NR_CellId_Type p_NR_CellId,
                                         NG_ALL_STATE_Type p_UE_State,
                                         NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2,
                                         boolean p_USIM_Rmvd := false,
                                         B2_Type p_AccessType := '01'B) runs on NR5GC_PTC
  {
    var template (omit) NG_NAS_MSG_Indication_Type v_ReceivedMsgTemplate;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var NG_NAS_MSG_Indication_Type v_DetachReq;
    var boolean v_RxdMsg := false;
    var SubFrameTiming_Type v_TimingOfLocalRelease;

    timer t_T3540 := f_NR_SetTimerToleranceMax (p_NR_CellId, nasTimer, 10.0);

    if (p_UE_State == STATE_CONNECTED_3A_T3540){ // @sic R5-201202, R5-201333 sic@
      t_T3540.start;
      // release local configuration
      f_NR_RRCRelease_Local(p_NR_CellId, f_NR_GetNextSendOccasion_DL(p_NR_CellId));
      t_T3540.timeout;
      // Now continue with RRC_IDLE procedure
     }
    if (pc_SwitchOnOff) { // The UE can actually be switched off
      f_IP_ChangeNrCell(IP, p_NR_CellId);  // @sic R5s210603 sic@
      select (p_UE_State) { // @sic R5-195325 sic@
        case (STATE_IDLE_1A, STATE_CONNECTED_3A_T3540) {
          f_UT_SwitchOffUE(UT, p_USIM_Rmvd); // @sic R5s190930 sic@
          v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?);
          v_DetachReq := f_NR5GC_OptionalIMSDeregisterOnSwitchOff(p_NR_CellId, v_ReceivedMsg); // @sic R5-204389 sic@
          v_RxdMsg := true; // @sic R5s190930 sic@
          f_NR_RRCRelease(p_NR_CellId);
        }
        // @sic R5s211344 sic@
        case (STATE_INACTIVE_2A){ // @sic R5-195325 sic@
          f_UT_SwitchOffUE(UT, p_USIM_Rmvd); // @sic R5s190930 sic@
          v_ReceivedMsgTemplate := f_NR_RRC_Resume_DefWithNas(p_NR_CellId, tsc_NR_RRC_TI_Def, ?, ?);
          if (not isvalue(v_ReceivedMsgTemplate)) {   // @sic R5-233474 sic@
            // UE will deregister from IMS, then send a NAS message
            SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp; // @sic R5-233474 sic@
            v_DetachReq := v_ReceivedAsp.Signalling.Nas[0];  // @sic R5-233474, R5-247663 sic@
          } else {
            v_DetachReq := valueof(v_ReceivedMsgTemplate); // @sic R5-204389, R5-233474 sic@
          }
          v_RxdMsg := true; // @sic R5-233474 sic@
          f_NR_RRCRelease(p_NR_CellId);
        }
        case (STATE_CONNECTED_3A){ // @sic R5-201202, R5-202562 sic@
          f_UT_SwitchOffUE(UT, p_USIM_Rmvd); // @sic R5s201132 sic@
          // DRB already configured, so the UE won't send any NAS msg until it's completed IMS Deregistration
          SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_IndWithPiggybacking((tsc_SHT_IntegrityProtected_Ciphered)))) -> value v_ReceivedAsp;  // @sic R5s21163 sic@

          v_DetachReq := v_ReceivedAsp.Signalling.Nas[0];  // @sic R5-230675, R5-247663 sic@
          v_RxdMsg := true;
          f_NR_RRCRelease(p_NR_CellId);
        }
        case(STATE_DEREGISTERED) { // @sic R5-201202 sic@
          f_UT_SwitchOffUE(UT, p_USIM_Rmvd); // @sic R5s190930 sic@
          // don't need to release the local configuration as RRC Release is always done before this function is called @sic R5s201228 sic@
          v_TimingOfLocalRelease := f_NR_RRCRelease_Local(p_NR_CellId, f_NR_GetNextSendOccasion_DL(p_NR_CellId));  //@sic R5s190984 sic@
          f_Delay(f_SubFrameTimingDuration_CheckShortestDelay(f_NR_GetCurrentTiming(p_NR_CellId), v_TimingOfLocalRelease)); //@sic R5s210839 R5s211262 R5s220024 sic@
        }
      }
      if (v_RxdMsg) { // @sic R5s190930 sic@
        if (not f_Check_NG_DeregistrationReqMOMsg (v_DetachReq.Pdu, crs_DeregisterType('1'B, '0'B, p_AccessType))) {  // Jun24 @sic R5s240531 Baseline Moving sic@
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Deregistration Request Message Failed");
        }
      }
    } else {
      f_UT_PowerOffUE(UT);
    }
    // Need to 'reset' all stored lists as all DRBs and PDU sessions no longer exist in UE
    f_NR5GC_MobileInfo_Init();
    // and empty the routing table
    f_IP_Handling_StopPDN(IP); // @sic R5s220041 sic@
  }

  /*
   * @desc      This function turns the UE off, waits for a Deregister message and releases the RRC connection
   *            Defined in 38.508-1 cl. 4.9.6.1 and 4.9.6.3
   * @param     p_NR_CellId
   * @param     p_InitialMsg
   * @return    NG_NAS_MSG_Indication_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_OptionalIMSDeregisterOnSwitchOff(NR_CellId_Type p_NR_CellId,
                                         NG_NAS_MSG_Indication_Type p_InitialMsg) runs on NR5GC_PTC return NG_NAS_MSG_Indication_Type
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_MSG_Indication_Type v_DetachReq;
    
    if (ischosen(p_InitialMsg.Pdu.Msg.service_Request)) {
      f_NR5GC_RRC_ConnectedState3N_Steps5_8(p_NR_CellId, p_InitialMsg);
      
      // Once in the connected mode, the UE won't send any NAS msg until it's completed IMS Deregistration
      SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking((tsc_SHT_IntegrityProtected_Ciphered)))) -> value v_ReceivedAsp;
      v_DetachReq := v_ReceivedAsp.Signalling.Nas[0];  // @sic R5-230675, R5-247663 sic@
    } else {
      //  The initial message not a Service Req so must have been a Detach Req
      v_DetachReq := p_InitialMsg;
    }
    
    return v_DetachReq;
  }

  /*
   * @desc      receive optional Deregistration Request or PDU session release whilst releasing the emergency call
   * @param     p_NR_CellId
   * @param     p_WaitTimer         (default value: 5.0)
   * @status    APPROVED (NR5GC)
   */
 function f_ReleaseEmergencyCallWithOptDeregisterOrPDURelease (NR_CellId_Type p_NR_CellId, float p_WaitTimer := 5.0)  runs on NR5GC_PTC {
    var PDUSessionInfoList_Type v_PDUSessionInfoList := f_NR5GC_MobileInfo_GetSessionInfoList();
    var O1_Type v_PDUSessionId := int2oct(f_Get_PDUSessionIdForDNNType(v_PDUSessionInfoList, Emergency_PDN), 1);
    var GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_UL_Pdu_Type v_RxdMsg;
    var template (value) NG_NAS_DL_Pdu_Type v_MsgToSend;
    var boolean v_WaitForReleaseComplete := false;
    timer t_Wait := p_WaitTimer;   // @sic R5-223439, R5-235301 sic@

    //@siclog "Step 5" siclog@
    //Make the UE release the emergency call.
    // @sic R5-223439 sic@
    //@siclog "Step 6A-6C" siclog@
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS2], cms_IMS_IPCAN_Trigger("Trigger MO Call Release")); // @sic R5-225362 sic@

    //@siclog "Step 7" siclog@
    
    //EXCEPTION: In parallel to step 8 below the steps specified in the parallel behaviours may take place
    alt {
      [] IMS[tsc_Index_IMS2].receive(cmr_IMS_IPCAN_Trigger ("IMS Call Release Msgs Sent"))  // @sic R5-225362 sic@ sic@
       { t_Wait.start;  // @sic R5s220560, R5s250335 sic@
         repeat;
       }  // @sic R5s221113 sic@

      [] SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp
       {
         v_RxdMsg := v_ReceivedAsp.Signalling.Nas[0].Pdu;
         // The UE transmits a DEREGISTRATION REQUEST message with De-registration type IE set to "Normal de-registration".
         if (ischosen(v_RxdMsg.Msg.deregistration_RequestMO)) {
           if (not f_Check_NG_DeregistrationReqMOMsg (v_RxdMsg, crs_DeregisterType('0'B, '0'B,'01'B))) { // Jun24 @sic R5s240531 Baseline Moving sic@
             f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Deregistration Request failed");
           }
           //The SS replies with a DEREGISTRATION ACCEPT message.
           SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, tsc_NR_RbId_SRB2, -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_DEREGISTRATION_ACCEPT)));
         }

         // @sic R5-223439 sic@
         // The UE transmits a PDU SESSION RELEASE REQUEST message
         else if (ischosen(v_RxdMsg.PiggybackedPduList[0].Msg.pdu_Session_Release_Request)) {
           if (not f_Check_NG_PDUSessionReleaseReq (v_GSM_MobilityInfo, v_PDUSessionInfoList, v_RxdMsg, v_PDUSessionId)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Release Request failed");
          }
           // set flag to expect complete
           v_WaitForReleaseComplete := true;
           // Complete the release procedure
           v_MsgToSend := f_Get_NG_PDUSessionReleaseCommand(v_PDUSessionId, cs_GMM_GSM_Cause (omit, '00011010'B));
           SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, tsc_NR_RbId_SRB2, -, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
         }
       
         // The UE transmits a PDU SESSION RELEASE COMPLETE message?
         else if (v_WaitForReleaseComplete and ischosen(v_RxdMsg.PiggybackedPduList[0].Msg.pdu_Session_Release_Complete)) {
          if (not f_Check_NG_PDUSessionReleaseComplete (v_PDUSessionInfoList, v_RxdMsg, v_PDUSessionId)) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Release Complete failed");
          }
          v_WaitForReleaseComplete := false;
         }
         else {
           f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Wrong NAS Message Received");
         }
         
         // Keep going round until timer expires @sic R5-223439 sic@
         repeat;
       }
    
      //@siclog "Step 8" siclog@
      [] t_Wait.timeout  //@sic R5-216198 sic@
       { // if Release Complete hasn't arrived before timeout, then need to wait for it so it doesn't cause an error when it does arrive
         if (v_WaitForReleaseComplete) {
           SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB2, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
           if (not f_Check_NG_PDUSessionReleaseComplete (v_PDUSessionInfoList, v_ReceivedAsp.Signalling.Nas[0].Pdu, v_PDUSessionId)) {
             f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Release Complete failed");
           }
         }
       }
    }
 }

  /*
   * @desc      Function to send a Delete NSSAI Request and receive Response
   * @param     p_NR_CellId
   * @param     p_DeleteType
   * @param     p_PLMN              (default value: omit)
   * @param     p_AccessType        (default value: omit)
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_DeleteNSSAI(NR_CellId_Type p_NR_CellId,
                               DeleteNSSAI_Type p_DeleteType,
                               template (omit) NAS_PlmnId p_PLMN := omit,
                               template (omit) B2_Type p_AccessType := omit,
                               NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2) runs on NR_BASE_PTC // @sic R5-205383 sic@
  {
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, p_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                                                         f_Get_NSSAI_DELETE_REQUEST(p_DeleteType, p_PLMN, p_AccessType))));

    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_Ind((tsc_SHT_IntegrityProtected, tsc_SHT_IntegrityProtected_Ciphered), cr_NSSAI_DELETE_RESPONSE)));
  }

  /*
   * @desc      38.508-1 cl. 4.9.35: Test procedure for deleting
   *            configured S-NSSAI, default configured S-NSSAI and allowed S_NSSAI
   * @param     p_NR_CellId
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB2)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_DeleteAllStoredNSSAI(NR_CellId_Type p_NR_CellId,
                               NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB2) runs on NR_BASE_PTC // @sic R5-205383 sic@
  {
    // Steps 1-2
    f_NR5GC_DeleteNSSAI (p_NR_CellId, Delete_Default_Configured, -, -, p_SRB);
    // Steps 3-4
    f_NR5GC_DeleteNSSAI (p_NR_CellId, Delete_Configured, '000000'O, -, p_SRB);
    // Steps 5-6
    f_NR5GC_DeleteNSSAI (p_NR_CellId, Delete_Allowed, '000000'O, '00'B, p_SRB);
  }

  /*
   * @desc      25.401 cl. 5.4.1.3 5G AKA Authentication procedure
   *            The parameter p_UL_NAS_Count shall be the NAS count of UL NAS message if security protected [i.e. Registration message]
   *            or the reset NAS count.
   *            The structure for NG_NAS_SecurityParams_Type passed as parameter shall have at least valid parameters for:
   *            IMSI, PLMN, NAS_IntegrityInfo_Type.NAS_IntAlgo, AS_IntegrityInfo_Type.IntProtAlgo
   *            NAS_CipheringInfo_Type.NAS_CipherAlgo, AS_CipheringInfo_Type.CiphAlgo.
   *            parameter shall be passed as TRUE if AUTHENTICATION_REQUEST & AUTHENTICATION_RESPONSE are to be NAS security protected
   *            else it shall be false.
   * @param     p_NR_CellId
   * @param     p_SecurityStatusAuthRequest
   * @param     p_SecurityStatusAuthResponse
   * @param     p_PLMN
   * @param     p_SRBId             (default value: tsc_NR_RbId_SRB1)
   * @param     p_AssignmentMode    (default value: 1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_Authentication5G_AKA(NR_CellId_Type p_NR_CellId,
                                       SecurityHeaderType p_SecurityStatusAuthRequest,
                                       template (present) SecurityHeaderType p_SecurityStatusAuthResponse,
                                       NAS_PlmnId     p_PLMN,
                                       NR_RadioBearerId_Type p_SRBId := tsc_NR_RbId_SRB1,
                                       integer p_AssignmentMode := 1)
    runs on NR5GC_PTC
  {
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams := f_NR5GC_Security_Get();
    var NR_SecurityParams_Type v_RRC_SecurityParams := f_NR_Security_Get();
    var NID_r16 v_NID_ASN;
    var template (omit) hexstring v_NID := omit;
    
    // build AUTHENTICATION REQUEST msg, input PLMN+NID if SNPN test case
    if(f_GetTestcaseAttrib_NR_SNPN(testcasename()) or pc_SNPN_only){  // @sic R5s220753, R5s221231 sic@
      v_NID_ASN := f_NR_InitNDI(p_NR_CellId, p_AssignmentMode); // returns a bitstring @sic R5s230092 sic@
      v_NID := bit2hex(v_NID_ASN);
    }

    // send AUTHENTICATION REQUEST
    v_MsgToSend := f_Get_5GAKA_AuthenticationReqMsg(v_NAS_SecurityParams, p_PLMN, -, v_NID, f_NR5GC_MobileInfo_GetDefaultIMSI()); // @sic R5s220753, R5s230215 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   p_SRBId,
                                   -,
                                   cs_NG_NAS_Request(p_SecurityStatusAuthRequest, v_MsgToSend)));

    // receive AUTHENTICATION RESPONSE / FAILURE
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRBId, cr_NG_NAS_Ind(p_SecurityStatusAuthResponse))) -> value v_ReceivedAsp;
    if (not f_Check_5GAKA_AuthenticationResponseFailure(v_NAS_SecurityParams, v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Authentication Failed");
    }
    // Now NAS parameters updated for Authentication, store updated common values in RRC global variable
    v_RRC_SecurityParams.KAMF := v_NAS_SecurityParams.KAMF;
    v_RRC_SecurityParams.KSIamf := v_NAS_SecurityParams.KSIamf;
    // Now store both
    f_NR_Security_Set(v_RRC_SecurityParams);
    f_NR5GC_Security_Set(v_NAS_SecurityParams);
  }

  /*
   * @desc      TS 38.508-1 table 4.9.21 PDU Session Release procedure
   * @param     p_NR_CellId
   * @param     p_PDU_SessionId
   * @param     p_Cause             (default value: cs_GMM_GSM_Cause (omit, '00011010'B))
   * @param     p_BackOff           (default value: omit)
   * @param     p_NGSM_CongestionReattemptInd (default value: omit)
   * @param     p_ExtdPCO           (default value: omit)
   * @param     p_EAP               (default value: omit)
   * @param     p_PTI               (default value: '00'O)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR5GC_PDUSessionRelease (NR_CellId_Type p_NR_CellId,
                                      O1_Type p_PDU_SessionId,
                                      template (value) GMM_GSM_Cause p_Cause := cs_GMM_GSM_Cause (omit, '00011010'B),
                                      template (omit) GPRS_Timer3 p_BackOff := omit,
                                      template (omit) NGSM_CongestionReattemptInd p_NGSM_CongestionReattemptInd := omit, // @sic R5s190543 sic@,
                                      template (omit) ExtdProtocolConfigOptions p_ExtdPCO := omit,
                                      template (omit) EAP_Message p_EAP := omit,
                                      ProcedureTransactionIdentifier p_PTI := '00'O)  runs on NR5GC_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var IntegerList_Type v_DRBIdList := f_NR_GetDRBList_ForGivenPDUSession(oct2int(p_PDU_SessionId));
    var template (value) NG_NAS_DL_Pdu_Type v_PiggyBackedMsgToSend;
    var PDUSessionInfoList_Type v_PDUSessionInfoList := f_NR5GC_MobileInfo_GetSessionInfoList();
    var template (omit) PDN_Index_Type v_PDN_Index := omit;

    // Build NAS command
    v_PiggyBackedMsgToSend := f_Get_NG_PDUSessionReleaseCommand(p_PDU_SessionId,
                                                                p_Cause,
                                                                p_BackOff,
                                                                p_NGSM_CongestionReattemptInd,
                                                                p_ExtdPCO,
                                                                p_EAP,
                                                                p_PTI);
    

    // The SS transmits an RRCReconfiguration message with a DRB ToReleaseList and PDU SESSION RELEASE COMMAND
    v_ReceivedAsp := f_NR_RRCReconfigReleaseDRBs(p_NR_CellId, v_DRBIdList, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_PiggyBackedMsgToSend)); // @sic R5s220595 sic@

    v_PDN_Index := f_Get_PDN_IndexForPDUSessionId (v_PDUSessionInfoList, p_PDU_SessionId); // @sic R5s211524 sic@
    if (isvalue(v_PDN_Index)) {  // @sic R5s211524 sic@
      f_IP_Handling_StopPDN(IP, cs_IP_StopPDN(valueof(v_PDN_Index)));
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Cannot find PDN Index of PDU Session being released");
    }
      
    if (not f_Check_NG_PDUSessionReleaseComplete (v_PDUSessionInfoList, v_ReceivedAsp.Signalling.Nas[0].Pdu, p_PDU_SessionId)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Release Complete failed");
    }
    f_NR5GC_MobileInfo_SetSessionInfoList (v_PDUSessionInfoList); // @sic R5-206266 sic@
  }

  /*
   * @desc      25.401 cl. 5.4.1.2 EAP AKA Authentication procedure
   *            The parameter p_UL_NAS_Count shall be the NAS count of UL NAS message if security protected [i.e. Registration message]
   *            or the reset NAS count.
   *            The structure for NG_NAS_SecurityParams_Type passed as parameter shall have at least valid parameters for:
   *            IMSI, PLMN, NAS_IntegrityInfo_Type.NAS_IntAlgo, AS_IntegrityInfo_Type.IntProtAlgo
   *            NAS_CipheringInfo_Type.NAS_CipherAlgo, AS_CipheringInfo_Type.CiphAlgo.
   *            parameter shall be passed as TRUE if AUTHENTICATION_REQUEST & AUTHENTICATION_RESPONSE are to be NAS security protected
   *            else it shall be false.
   * @param     p_NR_CellId
   * @param     p_SecurityStatusAuthRequest
   * @param     p_SecurityStatusAuthResponse
   * @param     p_PLMN
   * @param     p_SRBId             (default value: tsc_NR_RbId_SRB1)
   * @param     p_AssignmentMode    (default value: 1)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_AuthenticationEAP_AKA(NR_CellId_Type p_NR_CellId,
                                      SecurityHeaderType p_SecurityStatusAuthRequest,
                                      template (present) SecurityHeaderType p_SecurityStatusAuthResponse,
                                      NAS_PlmnId p_PLMN,
                                      NR_RadioBearerId_Type p_SRBId := tsc_NR_RbId_SRB1,
                                      integer p_AssignmentMode := 1)
    runs on NR5GC_PTC
  {
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams := f_NR5GC_Security_Get();
    var NR_SecurityParams_Type v_RRC_SecurityParams := f_NR_Security_Get();
    var NID_r16 v_NID_ASN;
    var template (omit) hexstring v_NID := omit;
    
    // build AUTHENTICATION REQUEST msg, input PLMN+NID if SNPN test case
    if(f_GetTestcaseAttrib_NR_SNPN(testcasename()) or pc_SNPN_only){  // @sic R5s220753, R5s221231 sic@
      v_NID_ASN := f_NR_InitNDI(p_NR_CellId, p_AssignmentMode); // returns a bitstring @sic R5s230092 sic@
      v_NID := bit2hex(v_NID_ASN);
    }

    // send AUTHENTICATION REQUEST
    v_MsgToSend := f_Get_EAP_AuthenticationReqMsg(v_NAS_SecurityParams, p_PLMN, v_NID, f_NR5GC_MobileInfo_GetDefaultIMSI()); // @sic R5s220753, R5s230215 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   p_SRBId,
                                   -,
                                   cs_NG_NAS_Request(p_SecurityStatusAuthRequest, v_MsgToSend)));
    
    // receive AUTHENTICATION RESPONSE
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRBId, cr_NG_NAS_Ind(p_SecurityStatusAuthResponse))) -> value v_ReceivedAsp;
    if (not f_Check_EAPAKA_AuthenticationResponse(v_NAS_SecurityParams, v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Authentication Failed");
    }
    // Now NAS parameters updated for Authentication, store updated common values in RRC global variable
    v_RRC_SecurityParams.KAMF := v_NAS_SecurityParams.KAMF;
    v_RRC_SecurityParams.KSIamf := v_NAS_SecurityParams.KSIamf;
    // Now store both
    f_NR_Security_Set(v_RRC_SecurityParams);
    f_NR5GC_Security_Set(v_NAS_SecurityParams);
  }

  /*
   * @desc      25.301 cl. 5.4.2 Security Mode Command procedure
   *
   * @param     p_NR_CellId
   * @param     p_SecurityParams
   * @param     p_ConnectionType
   * @param     p_GMM_MobilityInfo_Type
   * @param     p_NasCountReset     (default value: true)
   * @param     p_IMEISVReq         (default value: false)
   * @param     p_AddInfo           (default value: omit)
   * @param     p_EAP               (default value: cs_EAP_Message(bit2oct(encvalue(cs_EAP_Success))))
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @return    template (value) NAS_SecurityReturnType
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_NASSecurityModeProcedure(NR_CellId_Type p_NR_CellId,
                                         NG_NAS_SecurityParams_Type p_SecurityParams,
                                         TypeOfRegistration_Type p_ConnectionType,
                                         GMM_MobilityInfo_Type p_GMM_MobilityInfo_Type,
                                         template (omit) Null_Type p_NasCountReset := true,
                                         boolean p_IMEISVReq := false,
                                         template (omit) AdditionalSecurityInfo p_AddInfo := omit,
                                         template (omit) EAP_Message p_EAP := cs_EAP_Message(bit2oct(encvalue(cs_EAP_Success))),
                                         NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1)
    runs on NR5GC_PTC return template (value) NAS_SecurityReturnType
  {
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var boolean v_Result;
    var NasCount_Type v_NasCountUL;
    var NG_NAS_SecurityParams_Type v_SecurityParams := p_SecurityParams;
    var template (omit) EAP_Message v_EAP := p_EAP;
    var template (omit) ABBA v_ABBA := cs_ABBA(v_SecurityParams.ABBA);
    
    if (px_NAS_5GC_AuthenticationType == AKA_5G) {// only send EAP message and ABBA for for EAP authentication
      v_EAP := omit;
      v_ABBA := omit;
    }

    f_SS_NG_NAS_ConfigureSecurity(NASCTRL, v_SecurityParams.NAS_Integrity, v_SecurityParams.NAS_Ciphering, p_NasCountReset); /* download security keys and reset NAS COUNT */

    v_MsgToSend := f_Get_NG_SecurityModeCmdMsg(p_SecurityParams,
                                               p_ConnectionType,
                                               p_GMM_MobilityInfo_Type,
                                               p_IMEISVReq,
                                               p_AddInfo,
                                               v_EAP,
                                               v_ABBA);
    // send SECURITY MODE COMMAND
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, p_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_NewSecurityContext, v_MsgToSend))); // @sic R5s200509 sic@

    // receive SECURITY MODE COMPLETE
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, p_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered_NewSecurityContext))) -> value v_ReceivedAsp;
    v_Result := f_Check_NG_SecurityModeCompleteMsg(v_ReceivedAsp.Signalling.Nas[0].Pdu, p_ConnectionType, p_IMEISVReq);
    v_NasCountUL := v_ReceivedAsp.Signalling.Nas[0].SecurityProtection.NasCount;
    if (not v_Result) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "NAS Security Mode Procedure Failed");
    }
    if (ispresent(v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg)) { // @sic R5s190109 sic@
      return cs_NAS_SecurityReturnValue(v_NasCountUL, v_ReceivedAsp.Signalling.Nas[0].Pdu.PiggybackedPduList[0].Msg);
    } else {
      return cs_NAS_SecurityReturnValue(v_NasCountUL, omit);
    }
  }

  /*
   * @desc      GSM Authentication Procedure
   * @param     p_NR_CellId
   * @param     p_SecurityParams
   * @param     p_GSM_MobilityInfo
   * @param     p_PLMN
   * @param     p_SRB               (default value: tsc_NR_RbId_SRB1)
   * @return    NG_NAS_SecurityParams_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_PDUSessionAuthentication(NR_CellId_Type p_NR_CellId,
                                      NG_NAS_SecurityParams_Type p_SecurityParams,
                                      GSM_MobilityInfo_Type p_GSM_MobilityInfo,
                                      NAS_PlmnId     p_PLMN,
                                      NR_RadioBearerId_Type p_SRB := tsc_NR_RbId_SRB1)
    runs on NR5GC_PTC return NG_NAS_SecurityParams_Type
  {
    var template (value) NG_NAS_DL_Pdu_Type v_MsgToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_SecurityParams_Type v_SecurityParams := p_SecurityParams;
    var NR_RadioBearerId_Type v_SRB := p_SRB; // @sic R5s200956 sic@
    
    // send AUTHENTICATION COMMAND
    v_MsgToSend := f_Get_PDUSessionAuthenticationCmd(v_SecurityParams, p_GSM_MobilityInfo, p_PLMN, -, f_NR5GC_MobileInfo_GetDefaultIMSI());  // @sic R5s230215 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId, v_SRB, -, cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    // receive AUTHENTICATION COMPLETE
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, v_SRB, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    // To be completed
    if (not f_Check_NG_PDUSessionAuthenticationComplete(p_GSM_MobilityInfo, v_SecurityParams, v_ReceivedAsp.Signalling.Nas[0].Pdu, *, *)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "GSM Authentication Failed");
    }
    return v_SecurityParams;
  }

  /*
   * @desc      Returns last Visited TAI from NR Cell
   * @param     p_NR_CellId
   * @return    template (value) NG_TrackingAreaId
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
   function f_LastVisited_TAI (NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (value) NG_TrackingAreaId
  {
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (p_NR_CellId);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (p_NR_CellId);
    var template (value) NG_TrackingAreaId v_Tai := cr_NG_TAI(v_PLMN, bit2oct(v_TAC));
    return v_Tai;
  }

  /*
   * @desc      TS 38.508-1 clause 4.9.13 Test procedure for no response to paging
   * @param     p_NR_CellId
   * @param     p_TimerValue        (default value: 3.0)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_PageNoResponse(NR_CellId_Type p_NR_CellId, float p_TimerValue := 3.0) runs on NR5GC_PTC
  {
    // Step 1 Page UE
    f_NR_Paging_Def(p_NR_CellId, RRC_IDLE);
    
    // Step 2 Check no response
    if (not f_NR_CheckNoRRCSetupReq(p_NR_CellId, p_TimerValue)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "No Response to Paging Failed");
    }
  }

  /*
   * @desc      Common function to release NAS security
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_SS_NAS_SecurityRelease() runs on NR5GC_PTC
  {
    f_SS_NG_NAS_SecurityConfig(NASCTRL, cas_NG_NasSecurityRelease_REQ);
  }

  /*
   * @desc      Performs Registration and gets PDU Establishment Request message
   * @param     p_NR_CellId
   * @param     p_TestMode          (default value: TEST_LOOPModeB_ON)
   * @return    GSM_MobilityInfo_Type
   * @status    APPROVED (NR5GC)
   */
  function f_MultipleQoSPreamble_Part1 (NR_CellId_Type p_NR_CellId, NR_TESTMODE_STATE_Type p_TestMode := TEST_LOOPModeB_ON) runs on NR5GC_PTC return GSM_MobilityInfo_Type
   {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var GSM_MobilityInfo_Type v_GSM_MobilityInfo_Type;
          
    fl_NR5GC_PreconfigUE(omit); // @sic R5-225300, R5-237389 sic@

    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    // Switch on UE
    f_UT_SwitchOnUE(UT);

    f_NR5GC_Registration(p_NR_CellId, p_TestMode, Initial_NoSecurity);  // @sic R5s230321 sic@

    if (pc_noOf_PDUsSameConnection == 0) { // @sic R5s200751, R5s201358 sic@
      // UE will release signalling connection after T3540
      // so release connection and allow it to move back to connected @sic R5s220107 sic@
      f_NR_RRCRelease(p_NR_CellId);
      f_NR5GC_RRC_Idle_Extension_Steps1_7 (p_NR_CellId);
    }
    // Receive PDU Establishment
    SRB.receive(car_NR_SRB_NasPdu_IND(p_NR_CellId, tsc_NR_RbId_SRB1, cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not f_Check_NG_PDUSessionEstablishmentReq(v_GSM_MobilityInfo_Type,
                                                  v_ReceivedAsp.Signalling.Nas[0].Pdu))
    {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU Session Establishment Message Failed");
    }

    return v_GSM_MobilityInfo_Type;
  }

  /*
   * @desc      Configures SRB2 and DRBs and completes the PDU Session Establishment procedure
   * @param     p_NR_CellId
   * @param     p_GSM_MobilityInfo_Type
   * @param     p_DRBList
   * @param     p_DRB_ToAddModList
   * @param     p_SS_Config
   * @param     p_QoS_Rules
   * @param     p_QoSFlowDescr
   * @param     p_PDN_Index
   * @param     p_InterworkWithEPS  (default value: false)
   * @param     p_ReleaseConnection (default value: rrcConnectionRelease)
   * @status    APPROVED (NR5GC)
   */
  function f_MultipleQoSPreamble_Part2 (NR_CellId_Type p_NR_CellId,
                                        GSM_MobilityInfo_Type p_GSM_MobilityInfo_Type,
                                        IntegerList_Type p_DRBList,
                                        template (value) DRB_ToAddModList p_DRB_ToAddModList,
                                        template (value) NR_RadioBearerList_Type p_SS_Config,
                                        template (value) QoS_Rules p_QoS_Rules,
                                        template (value) QoSFlowDescr p_QoSFlowDescr,
                                        PDN_Index_Type p_PDN_Index,
                                        boolean p_InterworkWithEPS := false,
                                        RRCConnectionReleaseRequired_Type p_ReleaseConnection := rrcConnectionRelease) runs on NR5GC_PTC
   {
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (omit) SRB_ToAddModList v_SRBToAddModList := omit;
    var DelayForUserPlaneSignalling_Type v_WaitForUserplaneSignalling := noDelay; // Default: no IP signalling possible
    var template (value) DNN v_DNN;
    var PDU_PDN_DNN_Type v_PDUType;

    // SRB2 not yet configured, so need to configure it now
    v_SRBToAddModList := {cs_NR_SRB_ToAddMod(tsc_SRB2)};
    // Build RLC-BearerConfig for SRB2 and DRBs
    v_CellGroupConfig := f_NR_GetCellgroupConfig_DRB (p_NR_CellId, p_DRBList, true);

    v_RadioBearerConfig := cs_38508_RadioBearerConfigDef(v_SRBToAddModList,
                                                         p_DRB_ToAddModList,
                                                         omit,
                                                         cs_38508_SecurityConfig(cs_38508_SecurityAlgorithmConfig(f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get()), master));
    

    p_GSM_MobilityInfo_Type.PdnIndex := p_PDN_Index; // @sic R5s201361 sic@
    
    v_PDUType := f_GetPDNTypeFromDNN(p_GSM_MobilityInfo_Type.DNN);   // @sic R5-205939 sic@
    if (v_PDUType == None) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "DNN PICS do not match received DNN");
    } else {
      v_DNN := cs_DNN(-, f_DomainName_Encode(f_GetDNNStringFromPICS(v_PDUType)));  // @sic R5s240641 sic@
    }
    
    // Created common function for sending Accept message @sic R5-241606 sic@
    f_SendPDUSessionAcceptOverReconfig(p_NR_CellId,
                                       p_GSM_MobilityInfo_Type,
                                       v_DNN,     // @sic R5-205939 sic@
                                       v_RadioBearerConfig,
                                       v_CellGroupConfig,
                                       p_SS_Config,
                                       -,
                                       -,
                                       -,
                                       -,
                                       -,
                                       -,
                                       -,
                                       -,
                                       p_QoS_Rules,
                                       p_QoSFlowDescr,
                                       -, -, -,
                                       p_InterworkWithEPS); // @sic R5s201367 sic@
    

    if (v_PDUType== IMS_DNN) {
      v_WaitForUserplaneSignalling := waitForIMS;
    }  else { // currently all PDUs require IP signalling
      v_WaitForUserplaneSignalling := dontWaitForIMS;
    }
    f_NR_DelayForUserPlaneSignalling(v_WaitForUserplaneSignalling);  // @sic R5-206296 sic@

    if (p_ReleaseConnection == rrcConnectionRelease) { // @sic R5-241606 sic@
      f_NR_RRCRelease(p_NR_CellId);
    }
  }

  /*
   * @desc      Sends the PDU Session Establishment Accept and configures the DRBs
   * @param     p_NR_CellId
   * @param     p_GSM_MobilityInfo
   * @param     p_SRB               (default value: SRB1_2)
   * @param     p_SDAP_Config
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_DNN
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_PDU_SessionType   (default value: omit)
   * @param     p_Cause             (default value: omit)
   * @param     p_RQTimer           (default value: omit)
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_AlwaysOnPDUSessionInd (default value: omit)
   * @param     p_EAP               (default value: omit)
   * @param     p_QoS_Rules         (default value: omit)
   * @param     p_QoSFlowDescr      (default value: omit)
   * @param     p_ExtdPCO           (default value: omit)
   * @param     p_BackOff           (default value: omit)
   * @param     p_BuildQosFlow      (default value: omit)
   * @param     p_OmitDNN           (default value: false)
   * @param     p_PduInfoFromLTE    (default value: omit)
   * @param     p_NGSM_NtwkFeatSupport (default value: omit)
   * @param     p_ServingPLMNRateCtrl (default value: omit)
   * @param     p_ATSSSContainer    (default value: omit)
   * @param     p_ControlPlaneInd   (default value: omit)
   * @param     p_IPHeaderCompConfig (default value: omit)
   * @param     p_EthernetHeaderCompConfig (default value: omit)
   * @param     p_ExtraPDN_Address  (default value: omit)
   * @param     p_ServiceLvlAA      (default value: omit)
   * @param     p_ReceivedMBS       (default value: omit)
   * @return    PDU_PDN_DNN_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_BuildDefPDUSessionAcceptandSendOverReconfig (NR_CellId_Type p_NR_CellId,
                                        GSM_MobilityInfo_Type p_GSM_MobilityInfo,
                                        SRBs_AlreadyConfigured p_SRB := SRB1_2,
                                        template (omit) SDAP_Config p_SDAP_Config,
                                        template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                        template (omit) DNN p_DNN,
                                        template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                        template (omit) PDU_SessionType p_PDU_SessionType := omit,
                                        template (omit) GMM_GSM_Cause p_Cause := omit,
                                        template (omit) GPRS_Timer p_RQTimer := omit,
                                        template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                        template (omit) AlwaysOnPDUSessionInd p_AlwaysOnPDUSessionInd := omit,
                                        template (omit) EAP_Message p_EAP := omit,
                                        template (omit) QoS_Rules p_QoS_Rules := omit,
                                        template (omit) QoSFlowDescr p_QoSFlowDescr := omit,
                                        template (omit) ExtdProtocolConfigOptions p_ExtdPCO := omit,
                                        template (omit) GPRS_Timer3 p_BackOff := omit,
                                        template (omit) charstring p_BuildQosFlow := omit, // set to required value if a specific QoSFlow must be built (with interworkingWithEPS parameters)
                                        boolean p_OmitDNN := false,
                                        template (omit) EUTRA_NR_PduSessionInfoList_Type p_PduInfoFromLTE := omit, // Only included when called from S1ToN1 TAU
                                        template (omit) NGSM_NetworkFeatureSupport p_NGSM_NtwkFeatSupport := omit, // @sic R5s201387 Baseline Moving sic@
                                        template (omit) ServingPLMNRateControl p_ServingPLMNRateCtrl := omit,
                                        template (omit) ATSSSContainer p_ATSSSContainer := omit,
                                        template (omit) ControlPlaneInd p_ControlPlaneInd := omit,
                                        template (omit) IPHeaderCompressionConfig p_IPHeaderCompConfig := omit,
                                        template (omit) EthernetHeaderCompressConfig p_EthernetHeaderCompConfig := omit,
                                        template (omit) PDN_AddressInfo_Type p_ExtraPDN_Address := omit,
                                        template (omit) ServiceLvlAAContainer p_ServiceLvlAA := omit,
                                        template (omit) ReceivedMBSContainer p_ReceivedMBS := omit) runs on NR5GC_PTC return PDU_PDN_DNN_Type
   {
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo := f_NR5GC_MobileInfo_GetGMM_MobilityInfo(); // @sic R5-195328 sic@
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    var template (value) CellGroupConfig v_CellGroupConfig;
    var template (value) NR_RadioBearerList_Type v_SSConfig;
    var PDN_Index_Type v_PDN_Index;
    var template (value) QosFlow_Identification_Type v_QosFlowId;
    var template (value) SDAP_ConfigurationList_Type v_SDAP_ConfigurationList;
    var SdapConfig_Type v_SdapConfig;
    var template (omit) DNN v_DNN;
    var PDU_PDN_DNN_Type v_PDUType := None;  // @sic R5s210148 sic@
    var boolean v_ExistingPDN := false; // @sic R5s210149, R5s221126 sic@
    var template (omit) IMS_MediaToBeAdded_Type v_MediaType := omit; // @sic R5s211486, R5-253107 sic@
    var boolean v_InterworkWithEPS := true;
    var boolean v_DefaultDRB := true; // @sic R5s260049 sic@
    var integer i;
   
    // @sic R5s250237 sic@
    v_PDUType := p_GSM_MobilityInfo.PDUType;   // @sic R5-205939, R5s240708 sic@
    if (v_PDUType == None) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "DNN PICS do not match received DNN");
    }
    if (not isvalue(p_DNN)) { // @sic R5s210148, R5s221229, R5s250237 sic@
      // Use the details received in the Request msg
      v_DNN := cs_DNN(-, f_DomainName_Encode(f_GetDNNStringFromPICS(v_PDUType)));  // @sic R5s240641 sic@
    } else {
      // need to overwrite DNN received in Request msg @sic R5s221229 sic@
      v_DNN := p_DNN;
      p_GSM_MobilityInfo.DNN := valueof(p_DNN);
      // If using a different DNN, need to update stored PDU Type too @sic R5s250237 sic@
      v_PDUType := f_GetPDNTypeFromDNN(p_GSM_MobilityInfo.DNN);
      if (v_PDUType == None) { // if this DNN isn't known, just use default
        v_PDUType := Internet_DNN;
      }
      p_GSM_MobilityInfo.PDUType := v_PDUType; // @sic R5s250237 sic@
    }
    
    if (p_OmitDNN) { // @sic R5-223987 sic@
      v_DNN := omit;
      p_GSM_MobilityInfo.DNN := omit;
    }
    
    if (v_PDUType == Emergency_PDN) {   // @sic R5s260049 sic@
          v_MediaType := Emergency; // @sic R5s211486, R5s240641 sic@
    }
   if (isvalue (p_SDAP_Config)) { // @sic R5s201327 sic@ - compiler warning may be ignored due to check
        v_DefaultDRB := valueof(p_SDAP_Config.defaultDRB);  // @sic R5s260049 sic@
    }
      
    f_BuildRRCReconfigParamsNewDRBs (v_RadioBearerConfig,
                               v_CellGroupConfig,
                               v_SSConfig,
                               v_SDAP_ConfigurationList,
                               p_NR_CellId,
                               {p_GSM_MobilityInfo},
                               p_SRB); // @sic R5s201532 sic@
                                      
    // Only one PDU session input, so only 1st element relevant in output
    v_SdapConfig := valueof(v_SDAP_ConfigurationList[0].Config.SdapConfig);
    
    //It is assumed that by default only 1 QoS Flow is specified
    v_QosFlowId := cs_IP_QosFlowId(v_SdapConfig.Pdu_SessionId, v_SdapConfig.MappedQoS_Flows[0]);
    v_PDN_Index := f_NR5GC_GetPdnIndex(p_GSM_MobilityInfo);
    p_GSM_MobilityInfo.PdnIndex := v_PDN_Index;  // @sic R5s210480 sic@

    // @sic R5-204400 sic@
    if (isvalue(v_GMM_MobilityInfo.GMMCap)) { // @sic R5s201358 sic@
      if (v_GMM_MobilityInfo.GMMCap.s1Cap == '1'B) {
        p_GSM_MobilityInfo.EPS_Bearer := valueof(f_GetNextEPSBearerId (p_GSM_MobilityInfo, v_GMM_MobilityInfo, v_MediaType));
      }
    }
    
    if (isvalue(p_PDU_SessionType)) { // @sic R5-227473 sic@
      if (match ('101'B, p_PDU_SessionType.typeValue)) {
        v_ExistingPDN := true; // just set the flag to avoid updating the routing table
      }
    }
    
    // If this is a default DRB, enable IP handling for this DRB
    if (v_DefaultDRB) { // @sic R5s260049 sic@
      if (isvalue(p_PduInfoFromLTE)) { // @sic R5s210149 sic@
      // The UE has just moved from EUTRA. If so, data from EUTRA should be used, rather than created anew
        for (i := 0; i < lengthof (p_PduInfoFromLTE); i := i + 1) {
          if (p_GSM_MobilityInfo.PdnIndex == valueof(p_PduInfoFromLTE[i].PdnIndex)) {
            // Data from EUTRA should be used, rather than created anew
            v_ExistingPDN := f_NR_ChangeDrbMappingForExistingPDNs(p_NR_CellId, valueof(p_PduInfoFromLTE[i]), v_QosFlowId.QFI);  // @sic R5s221126 sic@
            p_GSM_MobilityInfo.EPS_Bearer := valueof(p_PduInfoFromLTE[i].EPS_Bearer); // Overwrite with stored value
            break;
          }
        }
      }
      if (not v_ExistingPDN) { // completely new PDU session @sic R5s210149, R5s221126 sic@
        f_IP_Handling_StartPDN(IP, p_GSM_MobilityInfo.PdnIndex, cs_DrbInfo_NR(p_NR_CellId, v_QosFlowId)); // @sic R5s201094 sic@
        /* @sic R5-217449, R5s220617 sic@ */
      }
    }
    
    if (f_NR5GC_GetNetworkSupport() == SUPPORTED) { // @sic R5-255943 sic@
      v_InterworkWithEPS := false;
    }
   
     f_SendPDUSessionAcceptOverReconfig (p_NR_CellId,
                                         p_GSM_MobilityInfo,
                                         v_DNN,
                                         v_RadioBearerConfig,
                                         v_CellGroupConfig,
                                         v_SSConfig,
                                         p_SSC_Mode,
                                         p_Session_AMBR,
                                         p_PDU_SessionType,
                                         p_Cause,
                                         p_RQTimer,
                                         p_S_NSSAI,
                                         p_AlwaysOnPDUSessionInd,
                                         p_EAP,
                                         p_QoS_Rules,
                                         p_QoSFlowDescr,
                                         p_ExtdPCO,
                                         p_BackOff,
                                         p_BuildQosFlow,
                                         v_InterworkWithEPS,
                                         p_NGSM_NtwkFeatSupport,
                                         p_ServingPLMNRateCtrl,
                                         p_ATSSSContainer,
                                         p_ControlPlaneInd,
                                         p_IPHeaderCompConfig,
                                         p_EthernetHeaderCompConfig,
                                         p_ExtraPDN_Address,
                                         p_ServiceLvlAA,
                                         p_ReceivedMBS);
    return p_GSM_MobilityInfo.PDUType;
   }

  /*
   * @desc      Sends the PDU Session Establishment Accept and configures the DRBs
   * @param     p_NR_CellId
   * @param     p_GSM_MobilityInfo_Type
   * @param     p_DNN
   * @param     p_RadioBearerConfig
   * @param     p_CellGroupConfig
   * @param     p_SS_Config
   * @param     p_SSC_Mode          (default value: crs_SSC_Mode(-, '001'B))
   * @param     p_Session_AMBR      (default value: cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O))
   * @param     p_PDU_SessionType   (default value: omit)
   * @param     p_Cause             (default value: omit)
   * @param     p_RQTimer           (default value: omit)
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @param     p_AlwaysOnPDUSessionInd (default value: omit)
   * @param     p_EAP               (default value: omit)
   * @param     p_QoS_Rules
   * @param     p_QoSFlowDescr
   * @param     p_ExtdPCO           (default value: omit)
   * @param     p_BackOff           (default value: omit)
   * @param     p_BuildQosFlow      (default value: omit)
   * @param     p_InterworkWithEPS  (default value: true)
   * @param     p_NGSM_NtwkFeatSupport (default value: omit)
   * @param     p_ServingPLMNRateCtrl (default value: omit)
   * @param     p_ATSSSContainer    (default value: omit)
   * @param     p_ControlPlaneInd   (default value: omit)
   * @param     p_IPHeaderCompConfig (default value: omit)
   * @param     p_EthernetHeaderCompConfig (default value: omit)
   * @param     p_ExtraPDN_Address  (default value: omit)
   * @param     p_ServiceLvlAA      (default value: omit)
   * @param     p_ReceivedMBS       (default value: omit)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SendPDUSessionAcceptOverReconfig (NR_CellId_Type p_NR_CellId,
                                        GSM_MobilityInfo_Type p_GSM_MobilityInfo_Type,
                                        template (omit) DNN p_DNN,
                                        template (value) RadioBearerConfig p_RadioBearerConfig,
                                        template (value) CellGroupConfig p_CellGroupConfig,
                                        template (value) NR_RadioBearerList_Type p_SS_Config,
                                        template (value) SSC_Mode p_SSC_Mode := crs_SSC_Mode(-, '001'B),
                                        template (value) Session_AMBR p_Session_AMBR := cs_Session_AMBR ('06'O, '05'O, '0004'O, '05'O, '0004'O),
                                        template (omit) PDU_SessionType p_PDU_SessionType := omit,
                                        template (omit) GMM_GSM_Cause p_Cause := omit,
                                        template (omit) GPRS_Timer p_RQTimer := omit,
                                        template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI, // @sic R5s190919 sic@
                                        template (omit) AlwaysOnPDUSessionInd p_AlwaysOnPDUSessionInd := omit,
                                        template (omit) EAP_Message p_EAP := omit,
                                        template (omit) QoS_Rules p_QoS_Rules,
                                        template (omit) QoSFlowDescr p_QoSFlowDescr,
                                        template (omit) ExtdProtocolConfigOptions p_ExtdPCO := omit,
                                        template (omit) GPRS_Timer3 p_BackOff := omit,
                                        template (omit) charstring p_BuildQosFlow := omit, // set to required value if a specific QoSFlow must be built (with interworkingWithEPS parameters)
                                        boolean p_InterworkWithEPS := true,
                                        template (omit) NGSM_NetworkFeatureSupport p_NGSM_NtwkFeatSupport := omit, // @sic R5s201387 Baseline Moving sic@
                                        template (omit) ServingPLMNRateControl p_ServingPLMNRateCtrl := omit,
                                        template (omit) ATSSSContainer p_ATSSSContainer := omit,
                                        template (omit) ControlPlaneInd p_ControlPlaneInd := omit,
                                        template (omit) IPHeaderCompressionConfig p_IPHeaderCompConfig := omit,
                                        template (omit) EthernetHeaderCompressConfig p_EthernetHeaderCompConfig := omit,
                                        template (omit) PDN_AddressInfo_Type p_ExtraPDN_Address := omit,
                                        template (omit) ServiceLvlAAContainer p_ServiceLvlAA := omit,
                                        template (omit) ReceivedMBSContainer p_ReceivedMBS := omit) runs on NR5GC_PTC
   {
    var template (value) NG_NAS_DL_Pdu_Type v_PiggyBackedMsgToSend;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo := f_NR5GC_MobileInfo_GetGMM_MobilityInfo(); // @sic R5-195328 sic@

    // Send Accept
    v_PiggyBackedMsgToSend := f_Get_NG_PDUSessionEstablishmentAccept (p_GSM_MobilityInfo_Type,
                                                                      v_GMM_MobilityInfo,
                                                                      p_DNN,              // @sic R5-205939 sic@
                                                                      p_SSC_Mode,
                                                                      p_Session_AMBR,
                                                                      p_PDU_SessionType,
                                                                      p_Cause,
                                                                      p_RQTimer,
                                                                      p_S_NSSAI,
                                                                      p_AlwaysOnPDUSessionInd,
                                                                      p_EAP,
                                                                      p_QoS_Rules,
                                                                      p_QoSFlowDescr,
                                                                      p_ExtdPCO,
                                                                      p_BackOff,
                                                                      p_BuildQosFlow,
                                                                      p_InterworkWithEPS,
                                                                      p_NGSM_NtwkFeatSupport,
                                                                      p_ServingPLMNRateCtrl,
                                                                      p_ATSSSContainer,
                                                                      p_ControlPlaneInd,
                                                                      p_IPHeaderCompConfig,
                                                                      p_EthernetHeaderCompConfig, // @sic R5-227473 sic@
                                                                      p_ExtraPDN_Address,
                                                                      p_ServiceLvlAA,
                                                                      p_ReceivedMBS); //@sic R5-213400 sic@
    
    // Add this PDU Session to stored list
    f_NR5GC_MobileInfo_AddPDUSession (p_GSM_MobilityInfo_Type);
    
    // Send RRC Reconfiguration message
    f_NR_RRCReconfigNewDRBWithSSConfig(p_NR_CellId,
                                       p_RadioBearerConfig,
                                       p_SS_Config,
                                       p_CellGroupConfig,
                                       { cs_NG_NAS_RequestWithPiggybacking(tsc_SHT_IntegrityProtected_Ciphered, v_PiggyBackedMsgToSend) },
                                       tsc_NR_RbId_SRB1);
  }

  /*
   * @desc      Function for triggering & establishment of a single PDU session of PDU Type
   *            This populates the DNN and QoS according to the values in 38.508-1 Table 4.8.4-1
   *            DNN Value to be set as follows:
   *            if p_DNN := "" => The DNN set according to Table 4.8.4-1 (pc_APN_ID_Internet, pc_APN_ID_IMS)
   *            if p_DNN := omit => The trigger command will not include a DNN, but the DL DNN & QoS according to p_DNNType
   *            else the DNN set to the provided value (to be used both UL & DL)
   * @param     p_NR_CellId
   * @param     p_PDUSessionId
   * @param     p_DNNType           (default value: Internet_DNN)
   * @param     p_DNN               (default value: "")
   * @param     p_S_NSSAI_InATCmd   (default value: omit)
   * @param     p_ExpectedS_NSSAI   (default value: *)
   * @param     p_S_NSSAI           (default value: cs_S_NSSAI_SST1eMBB_WithIEI)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_NR5GC_TriggerSinglePDUSession(NR_CellId_Type p_NR_CellId,
                                           integer p_PDUSessionId,
                                           PDU_PDN_DNN_Type p_DNNType := Internet_DNN,
                                           template (omit) charstring p_DNN := "",
                                           template (omit) S_NSSAI_LV p_S_NSSAI_InATCmd := omit,
                                           template S_NSSAI_Type p_ExpectedS_NSSAI := *,
                                           template (omit) S_NSSAI_Type p_S_NSSAI := cs_S_NSSAI_SST1eMBB_WithIEI)
    runs on NR5GC_PTC
  {
    var charstring v_S_NSSAI_ForATCmd := "";
    var charstring v_DNN_ForATCmd := "";
    var template (omit) DNN v_DNNRx := omit;
    var template (value) DNN v_DNNTx;
    var template (omit) QoS_Rules v_QoS_Rules;
    var charstring v_QoSFlowToBuild;
    var charstring v_SpecialType := "";
    var template (omit) PDU_SessionType v_PDU_SessionType := omit;
                                                      
    // QoS Rules, QoS Flow and DNN in Accept message determined by p_DNNType
    select (p_DNNType) {
      case (Internet_DNN) {
        v_DNN_ForATCmd := pc_APN_ID_Internet;
        v_QoS_Rules := f_BuildDefaultQoSRules ("1");
        v_QoSFlowToBuild := "1";
      }
      case (IMS_DNN) {
        v_DNN_ForATCmd := pc_APN_ID_IMS;
        v_QoS_Rules := f_BuildDefaultQoSRules ("2");
        v_QoSFlowToBuild := "2";
     }
      case (URLLC_DNN) { // @sic R5-221467 sic@
        v_DNN_ForATCmd := pc_APN_ID_URLLC;
        v_QoS_Rules := f_BuildDefaultQoSRules ("8");
        v_QoSFlowToBuild := "7";
     }
      case (Ethernet_DNN) { // @sic R5-227473 sic@
        v_DNN_ForATCmd := pc_APN_ID_Ethernet;
        v_QoS_Rules := f_BuildDefaultQoSRules ("1");
        v_QoSFlowToBuild := "1";
        v_SpecialType := "Ethernet";
        v_PDU_SessionType := cs_PDU_SessionType ('101'B);
      }
      case else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "PDU_PDN_DNN_Type not specified");
      }
    }
    v_DNNTx := cs_DNN(-, f_DomainName_Encode(v_DNN_ForATCmd));
    
    // Determine if a different value should be used in the AT command and UL
    if (isvalue(p_DNN)) { // omit => DNN NOT included in AT cmd
      if (valueof(p_DNN) != "") {  // specific value of DNN
        v_DNN_ForATCmd := valueof(p_DNN);
        v_DNNTx := cs_DNN(-, f_DomainName_Encode(v_DNN_ForATCmd));
      }
      // DNN will be present and equal to value in AT command
      v_DNNRx := cs_DNN(-, f_DomainName_Encode(v_DNN_ForATCmd));
    } else {  // omit => DNN NOT included in AT cmd or in UL Req
      v_DNN_ForATCmd := "";
      v_DNNRx := omit;
    }
    
    if (isvalue(p_S_NSSAI_InATCmd)){
      v_S_NSSAI_ForATCmd := f_ConvertS_NSSAI_ForATCommand(p_S_NSSAI_InATCmd); //compiler warning may be ignored due to check
    }
    
    f_UT_RequestPDUSession(UT, p_PDUSessionId, v_DNN_ForATCmd, -, -, v_S_NSSAI_ForATCmd, -, -, -, -, -, v_SpecialType); //AT command to trigger a PDU session @sic R5-227473 sic@

    f_NR5GC_PDUSessionEstablishment (p_NR_CellId,
                                     1,                 // Only triggering this one session
                                     -, -,
                                     p_ExpectedS_NSSAI, // Value in UL Req message
                                     v_DNNRx,           // Value in UL Req message
                                     -,
                                     v_DNNTx,           // Value in DL Accept message
                                     v_QoS_Rules,       // Value determined by PICS
                                     -,
                                     p_S_NSSAI,         // Value in DL Accept message
                                     -, -, -,
                                     v_PDU_SessionType,
                                     -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -,
                                     v_QoSFlowToBuild);       // Value determined by PICS
  }

  /*
   * @desc      Send the subscriber data list to the UE before starting the test
   *            This is called from some test cases
   *            The information will only be sent if the UE is an SNPN Only UE
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_ProvideSNPNData() runs on NR_BASE_PTC
  {
    if (pc_SNPN_only and not(f_GetTestcaseAttrib_NR_SNPN(testcasename()))) {
      fl_NR5GC_PreconfigUE(omit);
    }
  }

  /*
   * @desc      Send the subscriber data list to the UE before starting the test
   *            This shall be called in the preamble function
   *            The information will only be sent if the UE is an SNPN Only UE
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR5GC_SendSNPNData() runs on NR_BASE_PTC
  {
    var SNPN_SubscriberDataList v_DataList;
    var integer i;
    
    v_DataList := f_NR_CellInfo_GetNIDsForAllCells();
    for (i := 0; i < lengthof(v_DataList); i := i+1){
        f_UT_ProvideSubscriberDataList(UT, f_NR_Asn2Nas_PlmnId(v_DataList[i].Plmn), v_DataList[i].Nid);
    }
  }

  /*
   * @desc      Send AT commands to the UE before starting the test
   *            This shall be called in the preamble function
   * @param     p_List
   * @status    APPROVED (NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR5GC_PreconfigUE(template (omit) PreamblePreconfigureDataList p_List) runs on NR_BASE_PTC
  {
    var integer i;
    var PreamblePreconfigureDataList v_PreamblePreconfigureDataList := {};
    var boolean v_ConfigNTN := f_NR_MobileInfo_IsNTN();
    var boolean v_ConfigSNPN := (pc_SNPN_only and not(f_GetTestcaseAttrib_NR_SNPN(testcasename())));
    var boolean v_ConfigUAS := false;
    var boolean v_ConfigATG := false;
    
    if (isvalue(p_List)) {
      v_PreamblePreconfigureDataList := valueof(p_List);
    }
    // check what needs to be configured
    for (i := 0; i < lengthof(v_PreamblePreconfigureDataList); i := i+1) {
      select (v_PreamblePreconfigureDataList[i]){
        case (NoNTN) {
          v_ConfigNTN := false;
        }
        case (UAS) {
          v_ConfigUAS := true;
        }
        case (ATG) {
            v_ConfigATG := true;
        }
      }
    }

    // if anything needs to be configured
    if (v_ConfigSNPN or v_ConfigNTN or v_ConfigUAS or v_ConfigATG) {
      // then turn UE on
      f_UT_SwitchOnUE(UT);

      if (v_ConfigSNPN) {
        fl_NR5GC_SendSNPNData();
      }
      if (v_ConfigNTN or v_ConfigATG) {/*@sic R5-253982 sic@*/
          if (v_ConfigNTN){
            f_NR_PreconfigureNTN_UE("38.508-1 clause 4.5C.1");
          }
          else{
            f_NR_PreconfigureNTN_UE("38.508-1 clause 4.5D.1");
          }
      }
      if (v_ConfigUAS) {
        f_UT_UAS_UUAA_Params(UT, tsc_CAA_Level_UAVid, tsc_ServiceLevelAA_USSAddr, tsc_ServiceLevelAAPayload);
      }

      f_UT_SwitchOffUE(UT, false);
    }
  }

  /*
   * @desc      Function to be used to update parameters used in IntraN1TransparentContainer
   * @param     p_NASCountDL
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_MappedContext_IntraN1TransparentContainer(O4_Type p_NASCountDL)  runs on NR5GC_PTC
  {
    var NG_NAS_SecurityParams_Type v_SecurityParams := f_NR5GC_Security_Get();
    var NR_SecurityParams_Type v_RRC_SecurityParams := f_NR_Security_Get();

    v_SecurityParams.KAMF := f_NG_Authentication_A13(true,
                                                       p_NASCountDL,
                                                       v_SecurityParams.KAMF,
                                                       v_SecurityParams.KDF);
    
    // Derives KNASenc key
    v_SecurityParams.NAS_Ciphering.K_NAS := f_NG_Authentication_A8 (tsc_NAS_Enc_Alg, v_SecurityParams.NAS_Ciphering.Algorithm,
                                                                           v_SecurityParams.KAMF,
                                                                           v_SecurityParams.KDF);
    // Derives KNASint key
    v_SecurityParams.NAS_Integrity.K_NAS := f_NG_Authentication_A8 (tsc_NAS_Int_Alg, v_SecurityParams.NAS_Integrity.Algorithm,
                                                                           v_SecurityParams.KAMF,
                                                                           v_SecurityParams.KDF);
                                                                                                                                                      
    // Now NAS parameters updated, store updated common values in RRC global variable
    v_RRC_SecurityParams.KAMF := v_SecurityParams.KAMF;
    v_RRC_SecurityParams.KSIamf := v_SecurityParams.KSIamf;
    
    // Derive KgNB
    v_RRC_SecurityParams.KGNB := f_NR_Authentication_A9(v_RRC_SecurityParams.KDF, v_RRC_SecurityParams.KAMF, 'FFFFFFFF'O);
    
    // set NH and NCC as per 33.501 cl.6.9.2.3.3
    v_RRC_SecurityParams.NH:= v_RRC_SecurityParams.KGNB;
    v_RRC_SecurityParams.NCC := 0;
    
    // Now update the SS
    f_SS_NG_NAS_ConfigureSecurity(NASCTRL, v_SecurityParams.NAS_Integrity, v_SecurityParams.NAS_Ciphering);
    f_SS_NG_NAS_CountSet(NASCTRL, '00000000'O, '00000000'O); // @sic R5s201303 sic@
                                          
    f_NR_Security_Set(v_RRC_SecurityParams);
    f_NR5GC_Security_Set (v_SecurityParams);
  }

  /*
   * @desc      Set the content of Intra N1 Transparent Container to be included in MasterKeyUpdate IE according to 38.523-1, Table 8.1.4.1.2.3.3-6A
   * @return    octetstring
   * @status    APPROVED (NR5GC)
   */
  function f_BuildIntraN1TransparentContainer ()  runs on NR5GC_PTC return octetstring
  { //@sic R5-202641 sic@
    var NG_NAS_SecurityParams_Type v_SecurityParams; //@sic R5s210058 sic@
    var NasCountInfo_Type v_NASCountInfo := f_SS_NG_NAS_CountGet(NASCTRL);
    var O4_Type v_NASCountDL := f_NasSecurity_IncrementCOUNT(v_NASCountInfo.DL); // @sic R5s201076 sic@
    var template (value) IntraN1TransparentContainer v_NASContainer;
    var MessageAuthenticationCode v_CalculatedMac;
    var bitstring v_NASContainerString;
    
    // Update Security parameters @sic R5s201076 sic@
    f_NR5GC_MappedContext_IntraN1TransparentContainer(v_NASCountDL);
    
    v_SecurityParams := f_NR5GC_Security_Get(); //@sic R5s210058 sic@

    v_NASContainer := cs_IntraN1TransparentContainer (omit,         // set to omit in order to calculate its own value
                                                      v_SecurityParams.NAS_Ciphering.Algorithm,
                                                      v_SecurityParams.NAS_Integrity.Algorithm,
                                                      '1'B,
                                                      '0'B,
                                                      v_SecurityParams.KSIamf,
                                                      substr(v_NASCountDL, 3, 1));
                                                      
    v_NASContainerString := encvalue(valueof(v_NASContainer));
    v_CalculatedMac := fx_NG_NasIntegrityAlgorithm(bit2oct(v_NASContainerString),
                                                   v_SecurityParams.NAS_Integrity.Algorithm,
                                                   v_SecurityParams.NAS_Integrity.K_NAS,
                                                   'FFFFFFFF'O,  // according to 33.501 cl. 6.9.2.3.3
                                                   '00001'B,
                                                   tsc_DirectionDL);
                                                    
    v_NASContainer.mac := v_CalculatedMac;
    v_NASContainerString := encvalue(v_NASContainer);
    
    return bit2oct(v_NASContainerString);
    
  }

  /*
   * @desc      Configure the SMS as per PIXIT using the appropriate AT commands
   * @status    APPROVED (NR5GC)
   */
  function f_NG_SMS_AT_Config() runs on NR_BASE_PTC
  {
    var charstring v_InternationalNumber := """" & px_SMS_SMSC_InternationalNumber & """"; // @sic R5s210432 sic@
    // Set message service as indicated in the PIXIT.
    f_NG_SMS_AT_CSMS(px_SMS_Service);
    // Set Preferrred memory to preferred memories as indicated in the PIXIT.
    f_NG_SMS_AT_CPMS(px_SMS_PrefMem1, px_SMS_PrefMem2, px_SMS_PrefMem3);
    // Set message format to value given as PIXIT parameter
    f_NG_SMS_AT_CMGF(px_SMS_MsgFrmt);  // @sic R5s110751 sic@
    // Set Character Set "GSM"
    f_NG_SMS_AT_CSCS("""GSM""");
    // Set the UE to delete all messages from Preferred message store
    f_NG_SMS_AT_CMGD_ALL();
    // Set service center address
    f_NG_SMS_AT_CSCA(v_InternationalNumber, 129); // @sic R5s210281, R5s210432 sic@
  }

  /*
   * @desc      Configure the SMS as per PIXIT using the appropriate AT commands - with powering on and off
   * @status    APPROVED (NR5GC)
   */
  function f_NG_SMS_AT_Config_WithPowering () runs on NR5GC_PTC
  { // @sic R5s250288 sic@
    var boolean v_ConfigSNPN := (pc_SNPN_only and not(f_GetTestcaseAttrib_NR_SNPN(testcasename())));

    f_NR5GC_SwitchOnAndResetIMS(); // @sic R5s211299 sic@
    if (v_ConfigSNPN) {
      fl_NR5GC_SendSNPNData();
    }
    f_NG_SMS_AT_Config ();
    f_UT_SwitchOffUE(UT, false);
  }

  /*
   * @desc      Configure the SMS as per PIXIT using the appropriate AT commands - with powering on and off
                and then enter state 0-B
   * @param     p_NR_CellId
   * @status    APPROVED (NR5GC)
   */
  function f_NG_SMS_AT_Config_WithPowering_EnterState_0B (NR_CellId_Type p_NR_CellId) runs on NR5GC_PTC
  {
    //Configure the SMS as per PIXIT using the appropriate AT commands - with powering on and off
    f_NG_SMS_AT_Config_WithPowering (); //@sic R5s201384 sic@

    //Provide the UE with a valid 5G NAS security context to make it send a REGISTRATION REQUEST message including also non-cleartext IEs.
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();
    // turn on NR cell
    f_NR_SetCellPower (p_NR_CellId, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    // Go to RRC_IDLE
    f_NR5GC_RRC_IdleState1N_Def (p_NR_CellId, TESTMode_OFF, rrcConnectionRelease, Initial_NoSecurity, '00'O);
    // Now turn off again
    f_NR_UE_DeRegisterOnSwitchOff (p_NR_CellId, STATE_IDLE_1A);

  }

  /*
   * @desc      Bring the UE into state 3N-A, registered with "SMS over NAS supported".
   * @param     p_NR_CellId
   * @param     p_NR_TESTMODE_STATE (default value: TESTMode_OFF)
   * @status    APPROVED (NR5GC)
   */
  function f_NR5GC_Preamble_SMSoverNAS (NR_CellId_Type p_NR_CellId,
                                        NR_TESTMODE_STATE_Type p_NR_TESTMODE_STATE := TESTMode_OFF) runs on NR5GC_PTC
  { // @sic R5s250288 sic@
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    
    // Switch on UE
    f_NR5GC_SwitchOnAndResetIMS();

    // RRC Connection Setup
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (p_NR_CellId, tsc_NR_RRC_TI_Def, ?, (tsc_SHT_NoSecurityProtection, tsc_SHT_IntegrityProtected));
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity,
                                           -, -, -, -, -, -, -, -, -, -,
                                           -, -, -, -, -, -, -, -, -, -,
                                           -, -,
                                           cr_NG_Update (-, '1'B) //SMS over NAS supported
                                           )) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Preamble");
    }

    //Steps 5 to 13 of the generic procedure for NR RRC IDLE specified in TS 38.508-1 subclause 4.5.2, Table 4.5.2.2-2: NR RRC_IDLE are performed.
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                p_NR_CellId,
                                v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (p_NR_CellId)),
                                p_NR_TESTMODE_STATE,
                                Initial_Secure);

    //Step 14 of the generic procedure for NR RRC IDLE specified in TS 38.508-1 subclause 4.5.2, Table 4.5.2.2-2: NR RRC_IDLE are performed.
    // SS transmits REGISTRATION ACCEPT message including 5GS registration result with SMS allowed bit set to "SMS over NAS allowed".
    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,  // @sic R5-206426 sic@
                                                   f_NR5GC_GetMobileIdGUTI (p_NR_CellId),
                                                   cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (p_NR_CellId)),
                                                                                {bit2oct(f_NR_CellInfo_GetTAC(p_NR_CellId))}),
                                                   -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -,
                                                   '1'B); // SMS over NAS allowed
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_NR_CellId,
                                   tsc_NR_RbId_SRB1,
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));


    f_NR5GC_RRC_Idle_Steps15_20(p_NR_CellId, p_NR_TESTMODE_STATE);

    // Go to RRC_CONNECTED
    f_NR5GC_RRC_ConnectedState3N_Def (p_NR_CellId, p_NR_TESTMODE_STATE);
  }

}
