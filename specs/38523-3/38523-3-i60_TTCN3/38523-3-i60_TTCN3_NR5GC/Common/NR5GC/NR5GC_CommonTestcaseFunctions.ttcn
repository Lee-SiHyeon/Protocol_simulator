module NR5GC_CommonTestcaseFunctions {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from MAC_TC_Common_NR all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_BWP all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_DCI_Configuration all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;

  const SI_RequestResources.ra_PreambleStartIndex tsc_RA_PreambleStartIndexRedCap := 53;  /* @status    APPROVED (NR5GC) */

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_NoResponde3_RapidOnly(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  { /* @status    APPROVED (NR5GC) */
    /* contention free random access procedure:
       - the UE gets triggered for SI-request on demand
       - SS does not respond to the 3 first PRACH preambles,
       - Msg2 (Random access response with RAPID only)
       - PRACH for eventually reception of RRCSetupRequest
     */
    RachProcedureList := {
        cs_NR_RachProcedure_NoResponse,
        cs_NR_RachProcedure_NoResponse,
        cs_NR_RachProcedure_NoResponse,
        cs_NR_RachProcedureRapidOnly(p_PhysicalParameters),
        cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_Msg4Based(cs_NR_RachProcedureMsg4(p_PhysicalParameters, -, cs_NR_RachProcedureMsg4WithNoRrcMsg))) //for step 10
    }
  };

  template (value) SearchSpace.monitoringSlotPeriodicityAndOffset cs_MonitoringSlotPeriodicityAndOffset_71183 :=
  { /* @status    APPROVED (NR5GC) */
    //Table 7.1.1.8.3.3.3-6: SearchSpace (Table 7.1.1.8.3.3.3-5)
    sl10 := 2
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero_SIB1(SubcarrierSpacing p_SubcarrierSpacing) :=
  { /* @status    APPROVED (NR5GC) */
    TypeAndPriorityList := { tsc_NR_SearchSpaceTypeAndPriority_CssType0 },  //@sic R5s240142 sic@
    AggregationLevel := AggregationLevel4,                      // according to 38.523-3 clause 7.1.2.1.2
    SearchSpaceConfigAtUE := {
      R15 := cs_NR_SearchSpaceZeroAtSS(p_SubcarrierSpacing),
      R16 := omit,
      R17 := omit,    //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) NR_BWP_SearchSpaceConfig_Type cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero_Paging(template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates) :=
  { /* @status    APPROVED (NR5GC) */
    TypeAndPriorityList := { tsc_NR_SearchSpaceTypeAndPriority_CssType2 },  //@sic R5s240142 sic@
    AggregationLevel := AggregationLevel4,                      // according to 38.523-3 clause 7.1.2.1.2
    SearchSpaceConfigAtUE := {
      R15 := cs_SearchSpace4_71183(p_NrofCandidates),
      R16 := omit,
      R17 := omit,     //@sic R5w230207 sic@
      R18 := omit     //@sic R5w240308 sic@
    }
  };

  template (value) PDCCH_ConfigCommon cs_PDCCH_ConfigCommon_71183(template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates) :=
  /* @status    APPROVED (NR5GC) */
  //Table 7.1.1.8.3.3.3-5: PDCCH-ConfigCommon (Table 7.1.1.8.3.3.3-4)
  cs_38508_PDCCH_ConfigCommon(omit,
                              omit,
                              { cs_38508_SearchSpace(tsc_NR_SearchSpaceId_CSS, tsc_NR_ControlResourceSetId_Zero, cs_NR_SearchSpace_SearchSpaceType_CSS, p_NrofCandidates, cs_MonitoringSlotPeriodicityAndOffset_CSS_USS ),
                                cs_SearchSpace4_71183(p_NrofCandidates)
                              },
                              -,
                              -,
                              0,
                              4);

  template (value) SearchSpace cs_SearchSpace4_71183 (template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates) :=
    /* @status    APPROVED (NR5GC) */
    cs_38508_SearchSpace(4, tsc_NR_ControlResourceSetId_Zero, cs_NR_SearchSpace_SearchSpaceType_CSS, p_NrofCandidates, cs_MonitoringSlotPeriodicityAndOffset_71183);

  template (value) NR_SYSTEM_CTRL_REQ cads_NR_BWP_CONFIG_DL_RedCap_REQ(NR_CellId_Type  p_NR_CellId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_DownlinkBWP_Type p_Initial_DLRedCapBWP,
                                                                       template (omit) NR_BcchToPdschConfig_Type p_NR_BcchToPdschConfig,
                                                                       template (omit) NR_PcchConfig_Type p_PcchConfig,
                                                                       template (omit) NR_RachProcedureConfig_Type p_RachProcedureConfig
                                                                       ) modifies cas_NR_CellConfigAllOmit_REQ :=
  { /* @status    APPROVED (NR5GC) */
    Request := {
      Cell := {
        AddOrReconfigure := {
          PhysicalLayer := {
            Common := omit,
            Downlink := {
              FrequencyInfoDL := omit,
              SSPbchBlock := omit,
              PdschCellLevelConfig := omit,
              BWPs := {
                ActiveBWP := omit,
                BwpArray := omit,
                InitialBWP_RedCap := p_Initial_DLRedCapBWP,
                BWP_SwitchIndicator := omit  //@sic R5w240304r1 sic@
              },
              CsiConfig := omit
            },
            Uplink := omit
          },
          BcchConfig := {
            Pbch := omit,   //keep as it is
            Pdsch := p_NR_BcchToPdschConfig,
            BcchInfo := omit //keep as it is
          },
          PcchConfig := p_PcchConfig,
          RachProcedureConfig := p_RachProcedureConfig,
          DcchDtchConfig := omit
        }
      }
    }
  };

  /*
   * @desc  Check that the time difference in slots is greater or equal to the parameterised value
   * @param     p_NRCellId
   * @param     p_SubFrameTiming1
   * @param     p_SubFrameTiming2
   * @param     p_AllowedMinimuNumberOfSlots
   * @param     p_Msg
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CheckRaResponseWindow ( NR_CellId_Type p_NRCellId,
                                        SubFrameTiming_Type p_SubFrameTiming1,
                                        SubFrameTiming_Type p_SubFrameTiming2,
                                        integer p_AllowedMinimuNumberOfSlots,
                                        charstring p_Msg) runs on NR_BASE_PTC
  {
    var integer v_DurationSlot := f_NR_SubFrameTiming_DurationSlot(p_NRCellId, p_SubFrameTiming1, p_SubFrameTiming2);

    if (v_DurationSlot >= p_AllowedMinimuNumberOfSlots) {
        f_NR_PreliminaryPass(__FILE__, __LINE__, p_Msg);
    } else  {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, p_Msg);
    }
  }

  /*
   * @desc     Initialise Initial Downlink BWP for SIB1 with RedCap specific parameters
   * @param     p_NR_CellId
   * @param     p_PDCCH_ConfigCommon
   * @return    BWP_DownlinkCommon
   * @status    APPROVED (NR5GC)
   */
  function f_Get_InitialDownlinkBWP_RedCap(NR_CellId_Type p_NR_CellId,
                                           template (value) PDCCH_ConfigCommon p_PDCCH_ConfigCommon
                                           ) runs on NR_BASE_PTC return BWP_DownlinkCommon
  {
    var BWP_DownlinkCommon v_BWP_DownlinkCommon := f_NR_GetSIB1_InitialDownlinkBWP(p_NR_CellId);
    v_BWP_DownlinkCommon.pdcch_ConfigCommon.setup := valueof(p_PDCCH_ConfigCommon);
    return v_BWP_DownlinkCommon;
  }

  /*
   * @desc     Initialise Initial Downlink BWP for SS ASP with RedCap specific parameters
   * @param     p_NR_CellId
   * @param     p_NrofCandidates
   * @return    template
   * @status    APPROVED (NR5GC)
   */
  function fl_GetInitialNR_DownlinkBWP_RedCap(NR_CellId_Type p_NR_CellId,
                                              template (value) NR_SearchSpace_NrofCandidates_Type p_NrofCandidates
                                              ) runs on NR_BASE_PTC return template (value) NR_DownlinkBWP_Type
  {
    var template (value) NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, tsc_NR_BWP_Id);  //Get default initial BWP
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var template (value) SearchSpace.monitoringSlotPeriodicityAndOffset v_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS;    //@sic R5-233406 sic@
    var template (omit)  SearchSpace.duration v_Duration := omit;     //@sic R5-233406 sic@

    if (f_NR_CellInfo_GetHalfDuplexFDD(p_NR_CellId)) {
        v_SlotPeriodicityAndOffset := cs_MonitoringSlotPeriodicityAndOffset_CSS_USS_HDUE;
        v_Duration := 4;
    }
    // The RedCap-Specific initial downlink BWP information is provided in the cell reconfiguration ASP with:
    //   BWP Id 0
    //   DL SearchSpace Array for: cssType0 (SIB1), cssType1 (Msg2/Msg4), cssType2 (paging), uss
    v_NR_DownlinkBWP.Pdcch.SearchSpaceArray := {
        cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero_SIB1(v_SubcarrierSpacing),
        cs_NR_BWP_SearchSpaceConfig_SearchSpaceZero_Paging(p_NrofCandidates),
        cs_NR_BWP_SearchSpaceConfig_CSS(p_NrofCandidates, -, -, v_SlotPeriodicityAndOffset, v_Duration),
        cs_NR_BWP_SearchSpaceConfig_USS(p_NrofCandidates, -, -, v_SlotPeriodicityAndOffset, v_Duration)};
    return v_NR_DownlinkBWP;
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.1.15 and 7.1.1.1.27
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_1_1_15and27_NR5GC () runs on NR5GC_PTC
  {
    //Random access procedure / RedCap UE / SI request
    var PhysCellId v_PhysCellId_nr_Cell11;

    //Init Cell parameters
    f_NR5GC_Init(NR_3);

    //Change sysinfo combination to NR-3 in NR_Cell1 and set SIB3 acc to Table 7.1.1.1.3.3.3-2: SIB3 on NR Cell 1(Preamble)
    v_PhysCellId_nr_Cell11 := f_NR_CellInfo_GetPhysicalCellId(nr_Cell11);
    f_NR5GC_CellInfo_SetSIB3(nr_Cell1, cs_38508_SIB3_Def({cs_IntraFreqNeighCellInfoDef(v_PhysCellId_nr_Cell11, dB16)}));
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell11, -84, -82);

    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell11);

    //The UE is in NR RRC Idle mode
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_7_1_1_1_3and15and27_TestBody(true);  //Same test body as 7.1.1.3

    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell11, STATE_IDLE_1A);
  };

  /*
   * @desc      test body of TC_7_1_1_1_3and15and27
   * @param     p_TC711115_27          (default value: false)
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_7_1_1_1_3and15and27_TestBody( boolean p_TC711115_27 := false) runs on NR5GC_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1 := { //@sic R5-198883 sic@
        cs_NR_CellPower(nr_Cell1, -90, -91),
        cs_NR_CellPower(nr_Cell11, -84, -82)
    }
    var template SI_SchedulingInfo v_SI_SchedulingInfo;
    var template (value) RACH_ConfigGeneric v_RACH_ConfigGeneric := f_NR_CellInfo_GetRACH_ConfigGeneric(nr_Cell1, tsc_NR_BWP_Id); //@sic R5-199423 sic@
    var template (value) SI_RequestConfig v_SI_RequestConfig := cs_SI_RequestConfig(v_RACH_ConfigGeneric);
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
    var NR_SYSTEM_IND v_NR_SYSTEM_IND;
    var SubFrameTiming_Type v_TimingInfo1;
    var SubFrameTiming_Type v_TimingInfo2;
    var integer i;
    var NG_NAS_MSG_Indication_Type v_NasInd;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (omit) NR_BcchToPdschConfig_Type v_NR_BcchToPdschConfig;
    var integer v_NR_PrachPreambleIndex := 52;  //value for TC 7.1.1.1.3 @sic R5s240451 sic@
    timer t_Watchdog := 11.0; // General wait timer - at most 2 modification periods

    //@siclog "Step 1" siclog@
    //The SS changes SS/PBCH EPRE level of NR Cell 11 according to the row "T1" in Table 7.1.1.1.3.3.2-1.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);     //@sic R5-198883 sic@

    //@siclog "Step 2" siclog@
    //Wait 60s to ensure UE detects NR Cell 11 @sic R5-194822 sic@
    f_Delay(60.0);

    //Initialise SI_RequestConfig as per Table 7.1.1.1.3.3.3-1
    //Reconfigure SS with SI_RequestConfig
    if (p_TC711115_27) { //@sic R5-232940 sic@
        //For RedCap TC: ra-PreambleStartIndex = 53
        //@sic R5s260055 sic@
        f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_CellConfigPhysicalLayerUplink(nr_Cell1, -, cs_NR_CellConfigPhysicalLayerUplink_Def(-, cs_NR_SI_RequestConfig(cs_SI_RequestConfig(v_RACH_ConfigGeneric, tsc_RA_PreambleStartIndexRedCap )))));
    } else {
        f_NR_SS_CommonCellConfig(nr_Cell1, cads_NR_CellConfigPhysicalLayerUplink(nr_Cell1, -, cs_NR_CellConfigPhysicalLayerUplink_Def(-, cs_NR_SI_RequestConfig(v_SI_RequestConfig))));
    }
    //Pre-configure SS not to respond to 3 RACH preambles and then to transmit RAPID only in MSG2
    f_NR_SS_RachProcedureConfig(nr_Cell1, cs_NR_RachProcedureConfig_NoResponde3_RapidOnly(v_NR_PhysicalParameters));
    //Reconfigure SS to report PRACH preambles to TTCN
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(enable));

    //@sic Steps 3-4 sic@
    //SS transmits Short Message on PDCCH addressed to P-RNTI using Short Message field in DCI format 1_0. Bit 1of Short Message field is set to 1 to indicate the SI modification.
    //The SS changes the parameter 'Qoffset' in SIB3 of NR Cell 1 according to the row "T2" in Table 7.1.1.1.3.3.2-1/2. The valueTag for SIB3 in the SIB1 message is increased and si-BroadcastStatus for SIB3 is set to 'notBroadcasted'.
    //Set SIB1 as per Table 7.1.1.1.3.3.3-1
    f_NR_CellInfo_SetSIB1_SiRequestConfig(nr_Cell1, v_SI_RequestConfig );
    v_SI_SchedulingInfo := f_NR_GetSIB1_SiSchedulingInfo(nr_Cell1);
    v_SI_SchedulingInfo.schedulingInfoList[1]  := cs_NR_SchedulingInfoDef(tsc_SIB3_Periodicity, {cs_NR_SIB_TypeInfoDef(sibType3, 1)}, notBroadcasting);
    f_NR_CellInfo_SetSIB1_SiSchedulingInfo(nr_Cell1, valueof(v_SI_SchedulingInfo));
    if (p_TC711115_27) { //@sic R5-232940 sic@
        v_NR_PrachPreambleIndex := 53;     //@sic R5s240451 sic@
        //Initialise and reconfigure RedCap specific Initial UL BWP
        f_NR_ConfigRedCapUL_BWP(nr_Cell1, cs_PUCCH_ConfigCommon_ResourceCommonRedCap, omit);
        //Set si-RequestConfigRedCap-r17 in SIB1 as per 38.523-1 Table 7.1.1.1.15.3.3-1
        v_SI_RequestConfig := cs_SI_RequestConfig(v_RACH_ConfigGeneric, tsc_RA_PreambleStartIndexRedCap);
        f_NR_CellInfo_SetSIB1_SI_RequestConfigRedCap(nr_Cell1, v_SI_RequestConfig );
    }
    //Modify Sysinfo in SS - SS stops broadcasting SIB3
    f_NR_ModifySysinfo(nr_Cell1, - ,- , false);         //@sic R5-201006 R5-210575 sic@

    //@siclog "Step 5" siclog@
    //Check: Does the UE transmit a preamble on PRACH using the preamble indicated by ra-PreambleStartIndex defined in SI-RequestConfig in SIB1 in Table 7.1.1.1.3.3.3-1?
    t_Watchdog.start;
    alt {
        [] SYSIND.receive(car_NR_PRACH_Preamble_IND(nr_Cell1, -, v_NR_PrachPreambleIndex)) ->value v_NR_SYSTEM_IND {
          v_TimingInfo1 := v_NR_SYSTEM_IND.Common.TimingInfo.SubFrame;
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
          t_Watchdog.stop;
        }
        [] t_Watchdog.timeout {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 5");
        }
    }
    //@siclog "Steps 6-7-8" siclog@
    //Check: Does the UE re-transmit a preamble on PRACH after ra-ResponseWindow using the preamble indicated by ra-PreambleStartIndex defined in SI-RequestConfig in SIB1 in Table 7.1.1.1.3.3.3-1?
    //ra-ResponseWindow = sl20 = 20 slots
    for (i:=0; i<3; i:=i+1) {
        t_Watchdog.start(2.0);
        alt{
            []SYSIND.receive(car_NR_PRACH_Preamble_IND(nr_Cell1, -, v_NR_PrachPreambleIndex)) ->value v_NR_SYSTEM_IND
            {
                v_TimingInfo2 := v_NR_SYSTEM_IND.Common.TimingInfo.SubFrame;
                f_NR_CheckRaResponseWindow(nr_Cell1, v_TimingInfo1, v_TimingInfo2, 20, "Step 6");
                v_TimingInfo1 := v_TimingInfo2;
                t_Watchdog.stop;
            }
            [] t_Watchdog.timeout {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 5");
            }
        }
    }

    //@siclog "Step 9A" siclog@
    //The SS changes the parameter 'offset' in SIB3 of NR Cell 1 according to the row "T2" in Table 7.1.1.1.3.3.2-1/2 and starts broadcasting SIB3
    //@sic R5-210575 sic@
    f_NR5GC_CellInfo_SetSIB3_QOffsetCell(nr_Cell1, 0, dB_10);
    v_NR_BcchToPdschConfig := f_NR_InitialiseBcchToPdschConfig(nr_Cell1,true); //@sic Include SIB3 sic@
    f_NR_SS_ConfigureSysinfo (nr_Cell1, cs_TimingInfo_Now, v_NR_BcchToPdschConfig, true);  //@sic R5s220880 sic@

    //@siclog "Step 9" siclog@
    //The SS transmits a RAR message addressed to UE RA-RNTI including a MAC subPDU with a matching RAPID only. (Note 1)
    //Nothing to do SS already pre-configure
    //Reconfigure SS to stop reporting PRACH preamble
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_RachPreamble(disable));

    alt {
        //@siclog "Step 10" siclog@
        //Check: Does UE send Msg3 containing an RRCSetupRequest message in the grant associated to the Random Access Response received in step 9?
        [] SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCSetupRequest(?, ?))) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
        }
       //@siclog "Step 11" siclog@
       //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.3-1 indicate that the UE is camped on NR Cell 11 belonging to a new TA?
        [] SRB.receive(car_NR_SRB0_RrcPdu_IND(nr_Cell11, cr_38508_RRCSetupRequest(?, ?))) {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");
        }
    }
    f_NR_ULGrantConfiguration_Start(nr_Cell11);  //@sic R5s240451 sic@
    
    //generic test procedure in TS 38.508-1 [4] Table 4.9.3-1 in NR Cell11
    f_NR_RRCSetup_Def(nr_Cell11);
    // receive RRC Connection Setup Complete with piggy-backed NAS message on SRB1 (DCCH):
    v_NasInd := f_NR_RRCSetupComplete_Def(nr_Cell11,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def, ?),
                                          tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_NasInd.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell11, v_GMM_MobilityInfo);
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.8.3
   * @param     p_NR_CellId         (default value: nr_Cell2)
   * @param     p_SlotOffsetPaging  (default value: 2)
   * @param     p_NR_LogicalChannelId (default value: 35)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_TC_7_1_1_8_3and5_NR_TestBody(NR_CellId_Type p_NR_CellId := nr_Cell2,
                                             integer p_SlotOffsetPaging := 2,
                                             NR_LogicalChannelId_Type p_NR_LogicalChannelId := 35
                                            ) runs on NR5GC_PTC
  { //@sic R5s240142 sic@
    //@sic R5-250459: added p_NR_CellId, p_SlotOffsetPaging, p_NR_LogicalChannelId sic@
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var template (value) NR_DownlinkBWP_Type v_NR_DownlinkBWP;
    var template (value) NR_UplinkBWP_Type v_NR_UplinkBWP;     //@sic R5s240142 sic@
    var template (value) NR_SearchSpace_NrofCandidates_Type v_NrofCandidates;
    var template (omit) NR_PcchConfig_Type v_PcchConfig:= f_NR_InitialisePcchConfig(p_NR_CellId);
    var NG_NAS_GutiParameters_Type v_GutiParameters := f_NR5GC_CellInfo_GetGutiParameters(p_NR_CellId);
    var NG_5G_S_TMSI v_NG_5G_S_TMSI := f_NR_Get5G_S_TMSI_FromGuti(v_GutiParameters);
    var NG_NAS_MSG_Indication_Type v_NasInd;
    var boolean v_RRCSetupRequest_Received := false;
    var boolean v_RRCSetupRequestComplete_Received := false;
    var boolean v_LCID_Received := false;
    var boolean v_UL_HARQ_Received := false;
    var NR_SRB_COMMON_IND v_SRB_COMMON_IND;
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var SubFrameTiming_Type v_TimingRRCSetupRequest;
    var SubFrameTiming_Type v_Timing_UL_HARQ;
    var boolean v_UL_HarqReportingDisabled := false;

    //Initialise RedCap specific Initial UL BWP in SIB1
    //@sic R5s240142 sic@
    v_NR_UplinkBWP := f_GetInitialUplinkBWP_RedCap(p_NR_CellId, cs_PUCCH_Config_Def(omit, enable, omit, -90, omit, fromLowerEdge, 1, n2), omit);
    f_NR_CellInfo_SetSIB1_InitialUplinkBWP_RedCap(p_NR_CellId, v_NR_UplinkBWP.Common.R15);

    //Initialise RedCap specific Initial DL BWP
    //Initialise RedCap initial DL BWP in SIB1
    if (f_NR_CellInfo_GetIsFR1(p_NR_CellId)) {         //FR1
      v_NrofCandidates := cs_38508_NrofCandidates_Def;
    } else {                                           //FR2
      v_NrofCandidates := cds_38508_NrofCandidates_FR2
    }
    v_BWP_DownlinkCommon := f_Get_InitialDownlinkBWP_RedCap(p_NR_CellId,cs_PDCCH_ConfigCommon_71183(v_NrofCandidates));
    // Add RedCap-specific initial DL BWP in SIB1 in the Cell Array
    f_NR_CellInfo_SetSIB1_InitialDownlinkBWP_RedCap(p_NR_CellId, v_BWP_DownlinkCommon);

    //Initialise RedCap initialBWP for SS
    // The RedCap-Specific initial downlink BWP information is provided in the cell reconfiguration ASP with:
    //   BWP Id 0
    //   DL SearchSpace Array for: cssType0 (SIB1), cssType1 (Msg2/Msg4) after initial access, cssType2 (paging), uss
    v_NR_DownlinkBWP := fl_GetInitialNR_DownlinkBWP_RedCap(p_NR_CellId, v_NrofCandidates);
    // The AssignedBWPs are reconfigured from InitialBWP to InitialBWP_RedCap cell reconfiguration ASP with: SIB1, RandomAccessResponse, ContentionResolution(Msg4_Based), PcchConfig
    v_PcchConfig.SearchSpaceAndDci.AssignedBWPs := cs_NR_AssignedBWPs_RedCapInitialBWP;

    // @siclog "Steps 1-2" siclog@
    // The SS changes the SIB1 of NR Cell 1 2 to configure initialDownlinkBWP-RedCap and initialUplinkBWP-RedCap.
    // The SS transmits a Short message on PDCCH using P-RNTI indicating a systemInfoModification.
    f_NR_ModifySysinfo(p_NR_CellId);

    // @siclog "Step 3" siclog@
    // Wait for 2.1* modification period second for the UE to receive new system information.
    f_NR_WaitModificationPeriods(p_NR_CellId);

    //Configure SS to report UL_SRB0_LCID and UL HARQ feedback
    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_UL_SRB0_LCID(enable));
    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_UL_HARQ(enable));

    // Reconfigure SS - RedCap initial DL BWP
    //Acc to 38.331 cl initialDownlinkBWP-RedCap: If the locationAndBandwidth of this BWP contains the entire CORESET#0, the UE applies the locationAndBandwidth upon reception of this field (e.g. to determine the frequency position of signals described in relation to this locationAndBandwidth) but it keeps CORESET#0 until after reception of RRCSetup/RRCResume/RRCReestablishment.
    // RACH Msg2/Msg4 to be reconfigured after initial access - not needed in this TC
    //@sic R5s240142 sic@
    f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_BWP_CONFIG_DL_RedCap_REQ(p_NR_CellId,
                                                                        -,              // cs_TimingInfo_Now
                                                                        v_NR_DownlinkBWP,
                                                                        omit, //v_BcchToPdschConfig,
                                                                        v_PcchConfig,
                                                                        omit));

   // Reconfigure SS - RedCap initial UL BWP
   f_NR_SS_CommonCellConfig(p_NR_CellId, cads_NR_BWP_CONFIG_UL_RedCap_REQ(p_NR_CellId,
                                                                           -, // cs_TimingInfo_Now,
                                                                           v_NR_UplinkBWP
                                                                           ));

    // @siclog "Step 4" siclog@
    //The SS transmits a PagingPaging message within the BWP configured by initialDownlinkBWP-RedCap.
    f_NR_Paging(p_NR_CellId,
                cs_PagingRecordList_OneRecord(cs_PagingUE_Identity_5G_S_TMSI(v_NG_5G_S_TMSI)),
                rf128,
                p_SlotOffsetPaging);

    //@sic R5s240142 sic@
    f_NR_ULGrantConfiguration_Start(p_NR_CellId, -, -, -, cs_NR_UplinkTimeAlignment_Stop, -, -, tsc_NoCnfReq );

    // @siclog "Step 5" siclog@
    // Check: Does the UE transmit an RRCSetupRequest message by setting LCID to 35
    // @siclog "Step 6" siclog@
    // The SS transmits an RRCSetup message.
    // SS configured to do it
    // @siclog "Step 7" siclog@
    // Check: Does the UE transmit HARQ ACK for step 6 on PUCCH configured by initialUplinkBWP-RedCap?
    alt {
        // RRCSetupRequest
        [not v_RRCSetupRequest_Received] SRB.receive (car_NR_SRB0_RrcPdu_IND(p_NR_CellId, cr_38508_RRCSetupRequest)) -> value v_SRB_COMMON_IND
        {
            v_RRCSetupRequest_Received := true;
            v_TimingRRCSetupRequest := v_SRB_COMMON_IND.Common.TimingInfo.SubFrame;
            if (not (v_RRCSetupRequestComplete_Received and v_LCID_Received and v_UL_HARQ_Received)) { //Other events not all received
                repeat;        // => wait for other events
            }
        }
        //RRCSetupComplete
        [not v_RRCSetupRequestComplete_Received] SRB.receive (car_NR_SRB1_RrcNasPdu_IND(p_NR_CellId, cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def), cr_NG_NAS_IndWithPiggybacking(tsc_SHT_IntegrityProtected), omit)) -> value v_SRB_COMMON_IND
        {
            v_RRCSetupRequestComplete_Received := true;
            if(v_UL_HARQ_Received) { //@sic R5s240286 sic@
                f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_UL_HARQ(disable));
                v_UL_HarqReportingDisabled := true;
            }
            v_NasInd  := v_SRB_COMMON_IND.Signalling.Nas[0];
            if (not (v_RRCSetupRequest_Received and v_LCID_Received and v_UL_HARQ_Received)) { //Other events not all received
                repeat;        // => wait for other events
            }
        }
        // SysInd LCID
        [not v_LCID_Received] SYSIND.receive (cr_NR_SystemIndicationUL_SRB0_LCID_IND(p_NR_CellId, cr_TimingInfo_Any, p_NR_LogicalChannelId)) -> value v_SYSTEM_IND
        {
            v_LCID_Received := true;
            if (not (v_RRCSetupRequest_Received and v_RRCSetupRequestComplete_Received and v_UL_HARQ_Received)) { //Other events not all received
                repeat;        // => wait for other events
            }
        }
        // SysInd UL HARQ
        [not v_UL_HARQ_Received] SYSIND.receive (car_NR_SYSTEM_UL_HARQ_IND(p_NR_CellId, ack)) -> value v_SYSTEM_IND
        {
            v_UL_HARQ_Received := true;
            v_Timing_UL_HARQ := v_SYSTEM_IND.Common.TimingInfo.SubFrame;
            //Check: Does the UE transmit HARQ ACK for step 6 on PUCCH configured by initialUplinkBWP-RedCap?
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
            if (not (v_RRCSetupRequest_Received and v_RRCSetupRequestComplete_Received and v_LCID_Received)) { //Other events not all received
                repeat;        // => wait for other events
            }
        }
    }
    //Check timing of events
    f_NR_RacingCond_CheckTwoEvents(p_NR_CellId, v_TimingRRCSetupRequest, v_Timing_UL_HARQ);
    //Check: Does the UE transmit an RRCSetupRequest message by setting LCID to 35?
    if (v_RRCSetupRequest_Received and v_LCID_Received) {
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    } else {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 5");
    }

    //Disable UL HARQ ind reporting (in case it wasn't done in the alt due to v_UL_HARQ_Received=false)
    if (not(v_UL_HarqReportingDisabled)) {
        f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_UL_HARQ(disable));  //@sic R5s240436 sic@
    }
    // Disable SRB0 LCID indication
    // @sic R5s240286 sic@
    f_NR_SS_SystemIndCtrlConfig(p_NR_CellId, cds_NR_SystemIndCtrl_UL_SRB0_LCID(disable));

    // @siclog "Steps 8-13a1" siclog@
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(p_NR_CellId, v_NasInd);
  }

}
