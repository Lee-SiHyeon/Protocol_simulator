module NR_ATG_Configuration {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from NR_ASP_TypeDefs all;

  const  NR_ATG_Config_Type  tsc_NR_ATG_Config_Koffset1 := {Koffset := 1}; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_ATG_TimingAdvanceConfig_Type cs_NR_ATG_TimingAdvanceConfig (integer p_AtgUeSpecificTA := 128):=
  {/* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    //Default value as per TS 38.523-3 cl. 7.6.2.3
      InitialValue := 0,
      AtgUeSpecificTA := p_AtgUeSpecificTA
  }

}
