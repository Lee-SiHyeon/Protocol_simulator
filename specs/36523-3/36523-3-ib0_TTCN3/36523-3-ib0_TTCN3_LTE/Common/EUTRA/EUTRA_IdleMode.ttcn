                                  11, dB0);//q-OffsetCell = 0 dB for cell 11)

  template (value) SystemInformationBlockType4 cs_SIB4_Neigh_ExcludedCellList_1Entry(template (omit) IntraFreqNeighCellList p_IntraFreqNeighCellList,   //@sic R5-141101 sic@
                                                                                  template (value) IntraFreqExcludedCellList p_IntraFreqExcludedCellList) :=
  /* @status    APPROVED (LTE) */
