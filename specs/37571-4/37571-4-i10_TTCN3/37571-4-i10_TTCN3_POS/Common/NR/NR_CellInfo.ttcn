  /*
   * @desc      Assign the parameterized Attenuation in the NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_ReferenceCellPower
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_SetCellPower(NR_CellId_Type p_NR_CellId,
                                      NR_ReferenceCellPower_Type p_ReferenceCellPower)
    runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.ReferencePower := p_ReferenceCellPower;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Return the Cell power parameters stored in the NR_CellInfo
   * @param     p_NR_CellId
   * @return    NR_ReferenceCellPower_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetCellPower(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return  NR_ReferenceCellPower_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.ReferencePower;
  }

