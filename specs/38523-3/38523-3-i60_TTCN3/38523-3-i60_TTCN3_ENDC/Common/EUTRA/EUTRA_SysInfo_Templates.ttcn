  template (value) PUSCH_ConfigCommon cs_508_PUSCH_ConfigCommon_Default(integer p_PuschHoppingOffset,
                                                                        PUSCH_N_SB_Type  p_N_SB := 1,
                                                                        PUSCH_HoppingMode_Type  p_HoppingMode := interSubFrame,
                                                                        boolean p_Enable64QAM := false) :=
  { /* 36.508 Table 4.6.3-10: PUSCH-ConfigCommon-DEFAULT as signalled in RadioResourceConfiguration and SIB2 */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s110236 Additional change sic@ */
    /* @sic R5-160734: p_Enable64QAM for PUSCH-ConfigCommon-DEFAULT as signalled in SIB2 with 64QAM enabled (36.508 Table 4.6.3-10) sic@ */
    pusch_ConfigBasic := {
      n_SB                := p_N_SB,                       /* INTEGER (1..4) */
      hoppingMode         := p_HoppingMode,                /* interSubFrame, intraSubFrame */
      pusch_HoppingOffset := p_PuschHoppingOffset,
      enable64QAM         := p_Enable64QAM
    },
    ul_ReferenceSignalsPUSCH  := cs_UL_ReferenceSignalsPUSCH
  };

  template (value) DeltaFList_PUCCH cs_DeltaTFList_PUCCH :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    deltaF_PUCCH_Format1    := deltaF0,  // deltaF-2, deltaF0, deltaF2, spare1
    deltaF_PUCCH_Format1b   := deltaF3,  // deltaF1, deltaF3, deltaF5, spare1
    deltaF_PUCCH_Format2    := deltaF0,  // deltaF-2, deltaF0, deltaF1, deltaF2
    deltaF_PUCCH_Format2a   := deltaF0,  // deltaF-2, deltaF0, deltaF2, spare1
    deltaF_PUCCH_Format2b   := deltaF0   // deltaF-2, deltaF0, deltaF2, spare1
  };

  template (value) PCCH_Config cs_508_PCCH_Config_Default :=
  { /* 36.508 Table 4.6.3-3: PCCH-Config-DEFAULT
       @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    defaultPagingCycle := rf128,   /* rf32, rf64, rf128, rf256 */
    nB                 := oneT
  };

  template (value) BCCH_DL_SCH_Message cs_SystemInformation_Common(template (value) SystemInformation_r8_IEs p_SystemInformation) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    message_ := {
      c1 := {
        systemInformation := {
          criticalExtensions := {
            systemInformation_r8 := p_SystemInformation
          }
        }
      }
    }
  };

  template (value) SchedulingInfoList cs_SchedulingInfo_2SI(SI_Periodicity_r12   p_Sib3_Periodicity) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s201386 BASELINE MOVING 2020: replaced SiPeriodicity_Type with SI_Periodicity_r12 sic@ */
    {
      si_Periodicity := rf16,
      sib_MappingInfo := {}    // only sibType2 present (see field description for SystemInformationBlockType1 in 36.331 cl. 6.2.2)
    },
    {
      si_Periodicity := p_Sib3_Periodicity,
      sib_MappingInfo := {sibType3}
    }
  };

  template (value) SchedulingInfoList cs_SchedulingInfo_3SI(template (value) SI_Periodicity_r12  p_Si2_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si2_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si3_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si3_SIBMapping) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s201386 BASELINE MOVING 2020: replaced SiPeriodicity_Type with SI_Periodicity_r12 sic@ */
    {
      si_Periodicity := rf16,
      sib_MappingInfo := {}  // only sibType2 present (see field description for SystemInformationBlockType1 in 36.331 cl. 6.2.2)
    },
    {
      si_Periodicity  := p_Si2_Periodicity,
      sib_MappingInfo := p_Si2_SIBMapping
    },
    {
      si_Periodicity  := p_Si3_Periodicity,
      sib_MappingInfo := p_Si3_SIBMapping
    }
  };

  template (value) SchedulingInfoList cs_SchedulingInfo_4SI(template (value) SI_Periodicity_r12  p_Si2_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si2_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si3_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si3_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si4_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si4_SIBMapping) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s201386 BASELINE MOVING 2020: replaced SiPeriodicity_Type with SI_Periodicity_r12 sic@ */
    {
      si_Periodicity := rf16,
      sib_MappingInfo := {}  // only sibType2 present (see field description for SystemInformationBlockType1 in 36.331 cl. 6.2.2)
    },
    {
      si_Periodicity  := p_Si2_Periodicity,
      sib_MappingInfo := p_Si2_SIBMapping
    },
    {
      si_Periodicity  := p_Si3_Periodicity,
      sib_MappingInfo := p_Si3_SIBMapping
    },
    {
      si_Periodicity  := p_Si4_Periodicity,
      sib_MappingInfo := p_Si4_SIBMapping
    }
  };

    template (value) SchedulingInfoList cs_SchedulingInfo_5SI(template (value) SI_Periodicity_r12  p_Si2_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si2_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si3_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si3_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si4_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si4_SIBMapping,
                                                            template (value) SI_Periodicity_r12  p_Si5_Periodicity,
                                                            template (value) SIB_MappingInfo p_Si5_SIBMapping) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s201386 BASELINE MOVING 2020: replaced SiPeriodicity_Type with SI_Periodicity_r12 sic@ */
    {
      si_Periodicity := rf16,
      sib_MappingInfo := {}  // only sibType2 present (see field description for SystemInformationBlockType1 in 36.331 cl. 6.2.2)
    },
    {
      si_Periodicity  := p_Si2_Periodicity,
      sib_MappingInfo := p_Si2_SIBMapping
    },
    {
      si_Periodicity  := p_Si3_Periodicity,
      sib_MappingInfo := p_Si3_SIBMapping
    },
    {
      si_Periodicity  := p_Si4_Periodicity,
      sib_MappingInfo := p_Si4_SIBMapping
    },
    {
      si_Periodicity  := p_Si5_Periodicity,
      sib_MappingInfo := p_Si5_SIBMapping
    }
  };

  template (value) PHICH_Config cs_508_PHICH_Config_Default :=
  { /* 36.508 Table 4.6.3-4: PHICH-Config-DEFAULT;
       signalled in MIB;
       @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    phich_Duration := normal,
    phich_Resource := one                //As per 34.108 cl 4.4.3.2
  };

  template (value) BCCH_BCH_Message cs_508_MasterInformationBlock_Init(EUTRA_SysinfoDL_Bandwidth_Type p_DL_ChBandwidth) :=
  { /* 36.508 Table 4.4.3.2-1: MasterInformationBlock;
       @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    message_ := {
      dl_Bandwidth  :=  p_DL_ChBandwidth,
      phich_Config := cs_508_PHICH_Config_Default,
      systemFrameNumber := int2bit(0, 8),             /* Defines the 8 most significant bits of the SFN
                                                         This value shall be fullfilled by SS*/
      schedulingInfoSIB1_BR_r13 := 0,                 /* @sic R5s160711 BASELINE MOVING 2016: acc. to 36.331 clause 6.2.2 "Value 0 means that SystemInformationBlockType1-BR is not scheduled" sic@ */
      systemInfoUnchanged_BR_r15 := false,            /* @sic R5s180552 BASELINE MOVING 2018: acc. to 36.331 clause 6.2.2 "Value TRUE indicates that no change has occurred in the SIB1-BR and SI messages ..." sic@ */
      partEARFCN_r17 := {                              /* @sic R5s221178 BASELINE MOVING 2022: new field added R5-226053 R5s240444 BASELINE MOVE 2024 sic@ */
        spare := '00'B
      },
      spare   :=  '0'B                                /* @sic R5s160711 BASELINE MOVING 2016: BIT STRING (SIZE (5)) sic@
                                                         @sic R5s180552 BASELINE MOVING 2018: BIT STRING (SIZE (4)) sic@
                                                         @sic R5s221178 BASELINE MOVING 2022: BIT STRING (SIZE (1)) sic@ */
    }
  };

  template (value) TDD_Config cs_TDD_ConfigDef(TDD_SubframeAssignment_Type p_TDD_SubframeAssignment):=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    subframeAssignment := p_TDD_SubframeAssignment,
    specialSubframePatterns  := ssp6
  };

  type SystemInformationBlockType1_v1250_IEs.cellAccessRelatedInfo_v1250.category0Allowed_r12 SIB1_Category0Allowed_Type;  /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  type SystemInformationBlockType1_v1250_IEs.freqBandIndicatorPriority_r12 SIB1_FreqBandIndicatorPriority_Type;            /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) SystemInformationBlockType1_v1130_IEs cs_SystemInformationBlockType1_v1130_Cat0Allowed(template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    tdd_Config_v1130 := omit,
    cellSelectionInfo_v1130 := omit,
    nonCriticalExtension := cs_SystemInformationBlockType1_v1250(p_Category0Allowed)
  };

  template (value) SystemInformationBlockType1_v1250_IEs cs_SystemInformationBlockType1_v1250(template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_,
                                                                                              template (omit) SIB1_FreqBandIndicatorPriority_Type p_FreqBandIndicatorPriority := omit) :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cellAccessRelatedInfo_v1250 := {
      category0Allowed_r12 := p_Category0Allowed
    },
    cellSelectionInfo_v1250 := omit,
    freqBandIndicatorPriority_r12 := p_FreqBandIndicatorPriority,
    nonCriticalExtension := omit
  }

  template (value) SystemInformationBlockType1_v1310_IEs cs_SystemInformationBlockType1_v1310(template (omit) EDRX_Allowed_r13_Type p_EDRX_Allowed := omit,
                                                                                              template (omit) SystemInformationBlockType1_v1320_IEs p_SystemInformationBlockType1_v1320 := omit) :=
  {  //@sic R5s170280 R5-176132: added p_SystemInformationBlockType1_v1320 and renamed template sic@
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    hyperSFN_r13 := omit,
    eDRX_Allowed_r13 := p_EDRX_Allowed,
    cellSelectionInfoCE_r13 := omit,
    bandwidthReducedAccessRelatedInfo_r13 := omit,
    nonCriticalExtension := p_SystemInformationBlockType1_v1320
  };

  template (value) SystemInformationBlockType1_v1320_IEs cs_SystemInformationBlockType1_v1320_EcallOverIMS :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    freqHoppingParametersDL_r13 := omit,
    nonCriticalExtension := cs_SystemInformationBlockType1_v1350_ECallOverIMS
  };

  template (value) SystemInformationBlockType1_v1350_IEs cs_SystemInformationBlockType1_v1350_ECallOverIMS :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cellSelectionInfoCE1_r13 := omit,
    nonCriticalExtension := cs_SystemInformationBlockType1_v1360_ECallOverIMS
  };

  template (value) SystemInformationBlockType1_v1360_IEs cs_SystemInformationBlockType1_v1360_ECallOverIMS :=
  { /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    cellSelectionInfoCE1_v1360 := omit,
