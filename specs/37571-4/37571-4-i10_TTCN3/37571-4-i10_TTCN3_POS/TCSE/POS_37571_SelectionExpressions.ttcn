      }
      case (POS_C08ns) {
        v_ApplCond := (pc_NG_RAN_NR and (pc_UEA_AGNSS or (pc_OTDOA and pc_OTDOA_interRAT_RSTDmeasurement) or pc_UEA_MBS or pc_WLAN or pc_Bluetooth or pc_Sens or pc_Multi_RTT or pc_UEA_DL_AoD or pc_UEA_DL_TDOA or pc_NR_ECID) and not (pc_UEA_AGNSS and (pc_OTDOA and pc_OTDOA_interRAT_RSTDmeasurement) and pc_UEA_MBS and pc_WLAN and pc_Bluetooth and pc_Sens and pc_Multi_RTT and pc_UEA_DL_AoD and pc_UEA_DL_TDOA and pc_NR_ECID)) or (pc_NG_RAN_EUTRA and (pc_UEA_AGNSS or pc_OTDOA or pc_ECID or pc_UEA_MBS or pc_WLAN or pc_Bluetooth or pc_Sens) and not (pc_UEA_AGNSS and pc_OTDOA and pc_ECID and pc_UEA_MBS and pc_WLAN and pc_Bluetooth and pc_Sens));
      }
      case (POS_C09ns) {
        v_ApplCond := (pc_NG_RAN_NR or pc_NG_RAN_EUTRA) and pc_Sens;
      }
