module NR_Timing {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_SrbDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_Templates_SysInd all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_Component_Base all;

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_EnquireTiming(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId),
    Request := {
      EnquireTiming := true
    }
  };

  template (present) NR_SYSTEM_CTRL_CNF car_NR_EnquireTiming(NR_CellId_Type p_NR_CellId) :=
  { /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Common := cr_NR_CnfAspCommonPart(p_NR_CellId),
    Confirm := {
      EnquireTiming := true
    }
  };

  /*
   * @desc      Set slot number in SubFrameTiming
   * @param     p_SubFrameTiming
   * @param     p_SlotNumber
   * @param     p_SCS
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SubFrameTiming_SetSlot(SubFrameTiming_Type p_SubFrameTiming,
                                       UInt_Type p_SlotNumber,
                                       SubcarrierSpacing p_SCS) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_SubFrameTiming := p_SubFrameTiming;
    var SlotOffset_Type v_SlotOffset;
    var UInt_Type v_MaxValue;

    select (p_SCS) { //Acc to 38.211 Table 4.3.2-1
      case(kHz15) {
        v_SlotOffset.Numerology0 := true;
        v_MaxValue := 0;
      }
      case(kHz30) {
        v_SlotOffset.Numerology1 := p_SlotNumber;
        v_MaxValue := 1;
      }
      case(kHz60) {
        v_SlotOffset.Numerology2 := p_SlotNumber;
        v_MaxValue := 3;
      }
      case(kHz120) {
        v_SlotOffset.Numerology3 := p_SlotNumber;
        v_MaxValue := 7;
      }
      case(kHz240) {
        v_SlotOffset.Numerology4 := p_SlotNumber;
        v_MaxValue := 15;
      }
      case else {
        FatalError (__FILE__, __LINE__, "Invalid SubcarrierSpacing");
      }
    }
    if (p_SlotNumber > v_MaxValue) {
      FatalError (__FILE__, __LINE__, "invalid slot number for given SubcarrierSpacing");
    }
    v_SubFrameTiming.Slot.SlotOffset := v_SlotOffset;
    return v_SubFrameTiming;
  }

  /*
   * @desc      Get slot number from SubFrameTiming
   * @param     p_SubFrameTiming
   * @return    UInt_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SubFrameTiming_GetSlotNumber(SubFrameTiming_Type p_SubFrameTiming) return UInt_Type
  {
    var UInt_Type v_SlotNumber;
    select union (p_SubFrameTiming.Slot.SlotOffset) {
      case (Numerology1) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology1; }
      case (Numerology2) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology2; }
      case (Numerology3) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology3; }
      case (Numerology4) { v_SlotNumber := p_SubFrameTiming.Slot.SlotOffset.Numerology4; }
      case else          { v_SlotNumber := 0; }
    }
    return v_SlotNumber;
  }

  /*
   * @desc      calculate timer tolerance acc. to TS 38.508-1 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_TimerTolerance(NR_CellId_Type p_NR_CellId,
                                ProtocolTimer_Type p_ProtocolTimer,
                                float p_Timer) return float
  { /* NOTE: even though currently not being used, p_NR_CellId and p_ProtocolTimer are kept for future use */
    var float v_Tolerance := p_Timer * 0.1;

    return v_Tolerance;
  }

  /*
   * @desc      to calculate lower bound of timer tolerance acc. to TS 38.508-1 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_SetTimerToleranceMin(NR_CellId_Type p_NR_CellId,
                                     ProtocolTimer_Type p_ProtocolTimer,
                                     float p_Timer) return float
  {
    var float v_Tolerance := fl_NR_TimerTolerance(p_NR_CellId, p_ProtocolTimer, p_Timer);
    if (p_Timer < v_Tolerance) {
      return 0.0;
    }
    return p_Timer - v_Tolerance;
  }

  /*
   * @desc      calculate upper bound of timer tolerance acc. to 36.508 cl. 6.1.4
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Timer
   * @return    float
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SetTimerToleranceMax(NR_CellId_Type p_NR_CellId,
                                     ProtocolTimer_Type p_ProtocolTimer,
                                     float p_Timer) return float
  {
    var float v_Tolerance := fl_NR_TimerTolerance(p_NR_CellId, p_ProtocolTimer, p_Timer);
    return p_Timer + v_Tolerance;
  }

  /*
   * @desc      check whether given duration is valid considering expected duration and given tolerance
   * @param     p_NR_CellId
   * @param     p_ProtocolTimer
   * @param     p_Duration
   * @param     p_ExpectedDuration
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SubFrameTimingCheckDuration(NR_CellId_Type p_NR_CellId,
                                            ProtocolTimer_Type p_ProtocolTimer,
                                            integer p_Duration,
                                            integer p_ExpectedDuration) return boolean
  {
    var float v_ToleranceFloat := fl_NR_TimerTolerance(p_NR_CellId, p_ProtocolTimer, int2float(p_ExpectedDuration)/1000.0);
    var integer v_ToleranceInt := float2int(v_ToleranceFloat * 1000.0);
    var integer v_Min := p_ExpectedDuration - v_ToleranceInt;
    var integer v_Max := p_ExpectedDuration + v_ToleranceInt;

    return ((v_Min <= p_Duration) and (p_Duration <= v_Max));
  };

  /*
   * @desc      Return the current SFN and subframe
   * @param     p_NR_CellId
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetCurrentTiming(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var NR_SYSTEM_CTRL_CNF v_ReceivedCnf;
    var SubFrameTiming_Type v_Timing;

    SYS.send(cas_NR_EnquireTiming(p_NR_CellId));
    SYS.receive(car_NR_EnquireTiming(p_NR_CellId)) -> value v_ReceivedCnf;
    v_Timing := v_ReceivedCnf.Common.TimingInfo.SubFrame;

    return v_Timing;
  }

  type record NR_SchedulingParameters_Type {    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    UInt_Type ValidSubframeIndex,
    UInt_Type SubframePeriodicity,
    UInt_Type ValidSlotNumber,
    UInt_Type SlotOffsetPdcchPxsch
  };

  /*
   * @desc      Initialise parameters for scheduling of DL assignments
   * @return    NR_SchedulingParameters_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SchedulingParameters_DL() return NR_SchedulingParameters_Type
  {
    var NR_SchedulingParameters_Type v_SchedulingParameters := {
      ValidSubframeIndex := 2,                    /* => with half-frame periodicity subframes 2 and 7 are valid for DL transmissions */
      SubframePeriodicity := 5,                   /* half-frame */
      ValidSlotNumber := 0,                       /* first slot in a subframe */
      SlotOffsetPdcchPxsch := 0                   /* slot offset K0 according to 38.214 clause 5.1.2.1 */
    }
    return v_SchedulingParameters;
  }

  /*
   * @desc      Initialise parameters for scheduling of UL grant
   * @param     p_NR_CellId
   * @return    NR_SchedulingParameters_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_SchedulingParameters_UL(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_SchedulingParameters_Type
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var NR_SchedulingParameters_Type v_SchedulingParameters;
    
    v_SchedulingParameters := {
      ValidSubframeIndex := 4,                    /* => with half-frame periodicity subframes 4 and 9 are valid for UL transmissions */
      SubframePeriodicity := 5,                   /* half-frame */
      ValidSlotNumber := v_SlotsPerSubframe - 1,  /* last slot in a subframe */
      //@sic R5s230634 R5-235286 sic@
      SlotOffsetPdcchPxsch := f_NR_CellInfo_GetK2(p_NR_CellId) /* slot offset K2 according to 38.214 clause 6.1.2.1 */
    }
    return v_SchedulingParameters;
  }

  /*
   * @desc      Returns Gap Configuration of the NR Cell
   * @param     p_NR_CellId
   * @return    template (omit) GapConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
   function fl_NR_GetGapConfig(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return template (omit) GapConfig
  {
    var NR_MeasGapCtrl_Type v_MeasGapCtrl := f_NR_CellInfo_GetMeasGapCtrl(p_NR_CellId);
    var MeasGapConfig v_MeasGapConfig;
    var template (omit) GapConfig v_GapConfigUE := omit;
    var template (omit) GapConfig v_GapConfigFR1 := omit;
    var template (omit) GapConfig v_GapConfigFR2 := omit;


    if (ischosen(v_MeasGapCtrl.Config.R15)) {
      v_MeasGapConfig := v_MeasGapCtrl.Config.R15;
      if (ischosen(v_MeasGapConfig.gapUE.setup)) {
        v_GapConfigUE := v_MeasGapConfig.gapUE.setup;
      }
      if (ischosen(v_MeasGapConfig.gapFR1.setup)) {
        v_GapConfigFR1 := v_MeasGapConfig.gapFR1.setup;
      }
      if (ischosen(v_MeasGapConfig.gapFR2.setup)) {
        v_GapConfigFR2 := v_MeasGapConfig.gapFR2.setup;
      }
      if (isvalue(v_GapConfigUE)) {
        if (isvalue(v_GapConfigFR1) or isvalue(v_GapConfigFR2)) {
          FatalError(__FILE__, __LINE__, "not supported");
        }
        return v_GapConfigUE;
      } else if (isvalue(v_GapConfigFR1)) {
        if (isvalue(v_GapConfigFR2)) {
          FatalError(__FILE__, __LINE__, "not supported");
        }
        return v_GapConfigFR1;
      } else {
        return v_GapConfigFR2;
      }
    }
    return omit;
  }

  /*
   * @desc      skip measurement gaps to avoid sending of messages during measurement gaps
   * @param     p_SubFrameTiming
   * @param     p_GapConfig
   * @param     p_SchedulingParameters
   * @param     p_SlotsPerSubframe
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_SkipMeasGap(SubFrameTiming_Type p_SubFrameTiming,
                               GapConfig p_GapConfig,
                               NR_SchedulingParameters_Type p_SchedulingParameters,
                               UInt_Type p_SlotsPerSubframe) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_SubFrameTiming := p_SubFrameTiming;
    var integer v_GapOffsetInSlots := p_GapConfig.gapOffset * p_SlotsPerSubframe;
    var integer v_GapLengthInSlots;
    var UInt_Type v_GapSfnPeriod;
    var integer v_SfnBase;
    var integer v_GapStart;
    var integer v_GapEnd;
    var integer v_SFN;
    var integer v_Subframes;
    var integer v_TimingInSlots;
    var integer v_GapTimingAdvanceInSlots;
    var integer i := 0;
    
    select (p_GapConfig.mgrp) {
      case (ms20)  { v_GapSfnPeriod := 2; }
      case (ms40)  { v_GapSfnPeriod := 4; }
      case (ms80)  { v_GapSfnPeriod := 8; }
      case (ms160) { v_GapSfnPeriod := 16; }
      case else { FatalError(__FILE__, __LINE__, ""); }
    }
    
    select (p_GapConfig.mgl) {
      case (ms1dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 3) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms3)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 3); }
      case (ms3dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 7) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms4)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 4); }
      case (ms5dot5) { v_GapLengthInSlots := ((p_SlotsPerSubframe * 11) + 1) / 2; }   /* "+1" to cope with SCS=15kHz */
      case (ms6)     { v_GapLengthInSlots := (p_SlotsPerSubframe * 6); }
      case else { FatalError(__FILE__, __LINE__, ""); }
    }
    
    select (p_GapConfig.mgta) {
      case (ms0)      { v_GapTimingAdvanceInSlots := 0; }
      case (ms0dot25) { v_GapTimingAdvanceInSlots := (p_SlotsPerSubframe + 3) / 4; }   /* => e.g. for SCS=15kHz a whole slot is affected by the measurement gap timing advance */
      case (ms0dot5)  { v_GapTimingAdvanceInSlots := (p_SlotsPerSubframe + 1) / 2; }   /* (see above) */
      case else { FatalError(__FILE__, __LINE__, ""); }
    }

    v_SFN := v_SubFrameTiming.SFN.Number;
    v_TimingInSlots := (((v_SFN * 10) + v_SubFrameTiming.Subframe.Number) * p_SlotsPerSubframe) + f_NR_SubFrameTiming_GetSlotNumber(v_SubFrameTiming);
    v_SfnBase := (v_SFN / v_GapSfnPeriod) * v_GapSfnPeriod;   // SFN rounded down to the next multiple of v_GapSfnPeriod

    if (v_GapOffsetInSlots + v_GapLengthInSlots > v_GapSfnPeriod * 10 * p_SlotsPerSubframe) { /* i.e. gap starts at the end of a period and ends at the beginning of the period */
      v_SfnBase := v_SfnBase - 1;
    }
    v_GapStart := (v_SfnBase * 10 * p_SlotsPerSubframe) + v_GapOffsetInSlots;
    v_GapEnd := v_GapStart + v_GapLengthInSlots;
    v_GapStart := v_GapStart - v_GapTimingAdvanceInSlots;

    while ((v_GapStart <= v_TimingInSlots) and (v_TimingInSlots < v_GapEnd)) {
      if (i > 10) {    /* to avoid endless loop */
        FatalError(__FILE__, __LINE__, "No scheduling possible");
      }
      v_TimingInSlots := v_TimingInSlots + (p_SchedulingParameters.SubframePeriodicity * p_SlotsPerSubframe);
      i := i + 1;
    }
    if (i > 0) { /* => v_TimingInSlots has been changed */
      v_Subframes := v_TimingInSlots / p_SlotsPerSubframe;
      v_SFN := v_Subframes / 10;
      v_SubFrameTiming.Subframe.Number := v_Subframes mod 10;  /* @sic R5s200276 "mod" instead of "/" sic@ */
      v_SubFrameTiming.SFN.Number := v_SFN mod 1024;
      v_SubFrameTiming.HSFN.Number := (v_SubFrameTiming.HSFN.Number + (v_SFN / 1024)) mod 1024;
    }
    return v_SubFrameTiming;
  }

  /*
   * @desc      Get timing for the next PDCCH assignment of a PDSCH/PDUSCH transmission scheduled at the next valid occasion p_SubframOffsetMin subframes after start of the frame given by p_HSFN and p_SFN
   * @param     p_NR_CellId
   * @param     p_HSFN
   * @param     p_SFN
   * @param     p_SubframOffsetMin
   * @param     p_SchedulingParameters
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_NextPdcchOcassion(NR_CellId_Type p_NR_CellId,
                                   HyperSystemFrameNumberInfo_Type p_HSFN,
                                   SystemFrameNumberInfo_Type p_SFN,
                                   UInt_Type p_SubframOffsetMin,
                                   NR_SchedulingParameters_Type p_SchedulingParameters) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var template (omit) GapConfig v_GapConfig := fl_NR_GetGapConfig(p_NR_CellId);
    var UInt_Type v_Period := p_SchedulingParameters.SubframePeriodicity;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var UInt_Type v_AdditionalOffset := (v_Period + p_SchedulingParameters.ValidSubframeIndex - (p_SubframOffsetMin mod v_Period)) mod v_Period;   /* additional subframe offset to next valid subframe */
    var UInt_Type v_SubframOffset := p_SubframOffsetMin + v_AdditionalOffset;
    var UInt_Type v_SlotOffset := (v_SubframOffset * v_SlotsPerSubframe) + p_SchedulingParameters.ValidSlotNumber - p_SchedulingParameters.SlotOffsetPdcchPxsch;
    var SubFrameTiming_Type v_Timing := valueof(cs_SubFrameTiming(p_SFN.Number, 0, p_HSFN.Number));
    
    v_Timing := f_SubFrameTiming_AddMilliSeconds(v_Timing, v_SlotOffset / v_SlotsPerSubframe);
    v_Timing := f_NR_SubFrameTiming_SetSlot(v_Timing, v_SlotOffset mod v_SlotsPerSubframe, v_SCS);
    
    if (isvalue(v_GapConfig)) {
      f_NR_SkipMeasGap(v_Timing, valueof(v_GapConfig), p_SchedulingParameters, v_SlotsPerSubframe);
    }

    return v_Timing;
  }

  /*
   * @desc      get the next send occasion for UL grant or DCI of DL transmission
   * @param     p_NR_CellId
   * @param     p_TimingInfo
   * @param     p_MilliSeconds
   * @param     p_SchedulingParameters
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_NR_GetNextSendOccasion(NR_CellId_Type p_NR_CellId,
                                     template (value) TimingInfo_Type p_TimingInfo,
                                     UInt_Type p_MilliSeconds,
                                     NR_SchedulingParameters_Type p_SchedulingParameters) runs on NR_BASE_PTC return SubFrameTiming_Type
  { /* @sic R5s200022: new parameter p_TimingInfo sic@ */
    var SubFrameTiming_Type v_Timing;

    if (p_MilliSeconds < 100) {
      FatalError(__FILE__, __LINE__, "next send occasion shall be at least 100ms in advance");
    }
    if (f_TimingInfo_IsNow(p_TimingInfo)) { /* @sic R5s200022 sic@ */
      v_Timing := f_NR_GetCurrentTiming(p_NR_CellId);
    } else {
      v_Timing := valueof(p_TimingInfo.SubFrame);
    }
    return f_NR_NextPdcchOcassion(p_NR_CellId, v_Timing.HSFN, v_Timing.SFN, v_Timing.Subframe.Number + p_MilliSeconds, p_SchedulingParameters);
  }

  /*
   * @desc      get the next send occasion for DCI of DL transmission: the corresponding DL transmission will be K0 slots later (but in the same slot for K0=0)
   * @param     p_NR_CellId
   * @param     p_MilliSeconds      (default value: 100)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_GetNextSendOccasion_DL(NR_CellId_Type p_NR_CellId,
                                       UInt_Type p_MilliSeconds := 100,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC return SubFrameTiming_Type
  { /* @sic R5s200022: new parameter p_TimingInfo sic@ */
    var NR_SchedulingParameters_Type v_SchedulingParameters := f_NR_SchedulingParameters_DL();
    return fl_NR_GetNextSendOccasion(p_NR_CellId, p_TimingInfo, p_MilliSeconds, v_SchedulingParameters);
  }

  /*
   * @desc      get the next send occasion for UL grant: the corresponding UL transmission will be K2 slots later
   * @param     p_NR_CellId
   * @param     p_MilliSeconds      (default value: 100)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetNextSendOccasion_UL(NR_CellId_Type p_NR_CellId,
                                       UInt_Type p_MilliSeconds := 100,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on NR_BASE_PTC return SubFrameTiming_Type
  { /* @sic R5s200022: new parameter p_TimingInfo sic@ */
    var NR_SchedulingParameters_Type v_SchedulingParameters := fl_NR_SchedulingParameters_UL(p_NR_CellId);
    return fl_NR_GetNextSendOccasion(p_NR_CellId, p_TimingInfo, p_MilliSeconds, v_SchedulingParameters);
  }

  /*
   * @desc      calculate Timing for UL grant so that the corresponding UL transmission is p_MilliSeconds after the DL transmission corresponding to the given DL assignment:
   *            the given timestamp (p_T_DlAssignment) is the point in time of the DL assignment which is scheduled K0 slots before the corresponding DL transmission
   *            returns timing for the UL grant corresponding to the UL transmission
   *            Example:   v_TimingDL := f_NR_GetNextSendOccasion_DL(p_NR_CellId)                                            ->  timing for DL assignment with DL transmission at T1
   *                       v_TimingUL := f_NR_f_NR_GetNextSendOccasion_ULafterDL(p_NR_CellId, v_TimingDL, p_MilliSeconds)    ->  timing for UL grant with UL tranmission at T2 = T1 + p_MilliSeconds
   * @param     p_NR_CellId
   * @param     p_T_DlAssignment
   * @param     p_MilliSeconds
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetNextSendOccasion_ULafterDL(NR_CellId_Type p_NR_CellId,
                                              SubFrameTiming_Type p_T_DlAssignment,
                                              UInt_Type p_MilliSeconds) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var NR_SchedulingParameters_Type v_SchedulingParametersDL := f_NR_SchedulingParameters_DL();
    var NR_SchedulingParameters_Type v_SchedulingParametersUL := fl_NR_SchedulingParameters_UL(p_NR_CellId);
    var UInt_Type v_SlotOffsetK0 := v_SchedulingParametersDL.SlotOffsetPdcchPxsch;
    var UInt_Type v_SlotNumber := f_NR_SubFrameTiming_GetSlotNumber(p_T_DlAssignment);
    var UInt_Type v_SubframeOffsetForPdschTransmission := ((p_T_DlAssignment.Subframe.Number * v_SlotsPerSubframe) + v_SlotNumber + v_SlotOffsetK0) / v_SlotsPerSubframe;
    return f_NR_NextPdcchOcassion(p_NR_CellId, p_T_DlAssignment.HSFN, p_T_DlAssignment.SFN, v_SubframeOffsetForPdschTransmission + p_MilliSeconds, v_SchedulingParametersUL);
  }

  /*
   * @desc      to deal with racing conditions:
   *            NR_SYSTEM_IND and NR_SRB_COMMON_IND are just stored and returned to the caller;
   *            there may be one or no NR_SYSTEM_IND before the RRC message is received;
   *            if there is a NR_SYSTEM_IND before the NR_SRB_COMMON_IND the timing info is checked
   *            (i.e. it is checked that the RRC message has been received before the SYSTEM_IND)
   *            NOTE: p_SrbIndByRef and p_SysIndByRef shall be initialised as omit by the caller
   *                  (that cannot be done within the altstep)
   * @param     p_NR_CellId
   * @param     p_ExpectedSequence
   * @param     p_SrbIndByRef       (by reference)
   * @param     p_SysIndByRef       (by reference)
   * @param     p_ExpectedSrbInd    (default value: car_NR_SRB_IND_Any)
   * @param     p_ExpectedSysInd    (default value: car_NR_SYSTEM_IND_Any)
   * @status    APPROVED (NR5GC)
   */
  altstep a_NR_RacingCond_AwaitRrcMessageAndSysInd(NR_CellId_Type p_NR_CellId,
                                                   RacingCond_ExpectedSequence_Type p_ExpectedSequence,
                                                   inout template (omit) NR_SRB_COMMON_IND p_SrbIndByRef,
                                                   inout template (omit) NR_SYSTEM_IND p_SysIndByRef,
                                                   template (present) NR_SRB_COMMON_IND p_ExpectedSrbInd := car_NR_SRB_IND_Any,
                                                   template (present) NR_SYSTEM_IND p_ExpectedSysInd := car_NR_SYSTEM_IND_Any)
                                                   runs on NR_BASE_PTC
  { /* note: since this is an altstep 'interleave' cannot be used */
    /* note: since the altstep uses repeat to receive the second message the altstep is left and re-entered again
     *       => local variables are uninitialised; the only way to store information of subsequent messages is by the inout parameters
     *          (which for that reason have to be "inout"; "out" would not work */
    var NR_SRB_COMMON_IND v_SRB_COMMON_IND;
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var SubFrameTiming_Type v_Timing_SysInd;
    var SubFrameTiming_Type v_Timing_SrbInd;

    [not isvalue(p_SrbIndByRef)] SRB.receive (p_ExpectedSrbInd) -> value v_SRB_COMMON_IND
      {
        p_SrbIndByRef := v_SRB_COMMON_IND;
        if (not isvalue(p_SysIndByRef)) {                               // SYSTEM_IND has not been received yet
          repeat;                                                       // => wait for SYSTEM_IND
        } else {
          v_Timing_SrbInd := valueof(p_SrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SrbInd, v_Timing_SysInd);
        }
      }
    [not isvalue(p_SysIndByRef)] SYSIND.receive (p_ExpectedSysInd) -> value v_SYSTEM_IND
      {
        p_SysIndByRef := v_SYSTEM_IND;
        if (not isvalue(p_SrbIndByRef)) {                               // RRC message has not been received yet
          repeat;                                                       // => wait for RRC PDU
        } else {
          v_Timing_SrbInd := valueof(p_SrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SrbInd, v_Timing_SysInd);
        }
      }
  }

  /*
   * @desc      to deal with racing conditions:
   *            Two NR_SYSTEM_IND and NR_SRB_COMMON_IND are just stored and returned to the caller;
   *            there may be one or two or no NR_SYSTEM_IND before the RRC message is received;
   *            if there is a NR_SYSTEM_IND before the NR_SRB_COMMON_IND the timing info is checked
   *            (i.e. it is checked that the RRC message has been received before the SYSTEM_IND)
   *            NOTE: p_SrbIndByRef and p_SysIndByRef1/2 shall be initialised as omit by the caller
   *                  (that cannot be done within the altstep)
   * @param     p_NR_CellId
   * @param     p_ExpectedSequence
   * @param     p_SrbIndByRef       (by reference)
   * @param     p_SysIndByRef1      (by reference)
   * @param     p_SysIndByRef2      (by reference)
   * @param     p_ExpectedSrbInd    (default value: car_NR_SRB_IND_Any)
   * @param     p_ExpectedSysInd1   (default value: car_NR_SYSTEM_IND_Any)
   * @param     p_ExpectedSysInd2   (default value: car_NR_SYSTEM_IND_Any)
   * @status    APPROVED (NR5GC)
   */
  altstep a_NR_RacingCond_AwaitRrcMessageAndTwoSysInd(NR_CellId_Type p_NR_CellId,
                                                      RacingCond_ExpectedSequence_Type p_ExpectedSequence,
                                                      inout template (omit) NR_SRB_COMMON_IND p_SrbIndByRef,
                                                      inout template (omit) NR_SYSTEM_IND p_SysIndByRef1,
                                                      inout template (omit) NR_SYSTEM_IND p_SysIndByRef2,
                                                      template (present) NR_SRB_COMMON_IND p_ExpectedSrbInd := car_NR_SRB_IND_Any,
                                                      template (present) NR_SYSTEM_IND p_ExpectedSysInd1 := car_NR_SYSTEM_IND_Any,
                                                      template (present) NR_SYSTEM_IND p_ExpectedSysInd2 := car_NR_SYSTEM_IND_Any)
                                                   runs on NR_BASE_PTC
  { /* note: since this is an altstep 'interleave' cannot be used */
    /* note: since the altstep uses repeat to receive the second message the altstep is left and re-entered again
     *       => local variables are uninitialised; the only way to store information of subsequent messages is by the inout parameters
     *          (which for that reason have to be "inout"; "out" would not work */
    var NR_SRB_COMMON_IND v_SRB_COMMON_IND;
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var SubFrameTiming_Type v_Timing_SysInd1;
    var SubFrameTiming_Type v_Timing_SysInd2;
    var SubFrameTiming_Type v_Timing_SrbInd;

    [not isvalue(p_SrbIndByRef)] SRB.receive (p_ExpectedSrbInd) -> value v_SRB_COMMON_IND
      {
        p_SrbIndByRef := v_SRB_COMMON_IND;
        if (not (isvalue(p_SysIndByRef1) and isvalue(p_SysIndByRef2))) {// both SYSTEM_INDs not been received yet
          repeat;                                                       // => wait for SYSTEM_IND1 and/or 2
        } else {
          v_Timing_SrbInd := valueof(p_SrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd1 := valueof(p_SysIndByRef1.Common.TimingInfo.SubFrame);
          v_Timing_SysInd2 := valueof(p_SysIndByRef2.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SrbInd, v_Timing_SysInd1, v_Timing_SysInd2);
        }
      }
    [not isvalue(p_SysIndByRef1)] SYSIND.receive (p_ExpectedSysInd1) -> value v_SYSTEM_IND
      {
        p_SysIndByRef1 := v_SYSTEM_IND;
        if (not (isvalue(p_SrbIndByRef) and isvalue(p_SysIndByRef2))) { // RRC message and/or SYSTEM_IND2 has not been received yet
          repeat;                                                       // => wait for RRC PDU and/or SYSTEM_IND2
        } else {
          v_Timing_SrbInd := valueof(p_SrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd1 := valueof(p_SysIndByRef1.Common.TimingInfo.SubFrame);
          v_Timing_SysInd2 := valueof(p_SysIndByRef2.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SrbInd, v_Timing_SysInd1, v_Timing_SysInd2);
        }
      }
    [not isvalue(p_SysIndByRef2)] SYSIND.receive (p_ExpectedSysInd2) -> value v_SYSTEM_IND
      {
        p_SysIndByRef2 := v_SYSTEM_IND;
        if (not (isvalue(p_SrbIndByRef) and isvalue(p_SysIndByRef1))) { // RRC message and/or SYSTEM_IND1 has not been received yet @sic R5s230735 sic@
          repeat;                                                       // => wait for RRC PDU
        } else {
          v_Timing_SrbInd := valueof(p_SrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd1 := valueof(p_SysIndByRef1.Common.TimingInfo.SubFrame);
          v_Timing_SysInd2 := valueof(p_SysIndByRef2.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SrbInd, v_Timing_SysInd1, v_Timing_SysInd2);
        }
      }
  }

  /*
   * @desc      to deal with racing conditions:
   *            NR_SYSTEM_IND and NR_DRB_COMMON_IND are just stored and returned to the caller;
   *            there may be one or no NR_SYSTEM_IND before the DRB Data is received;
   *            if there is a NR_SYSTEM_IND before the NR_DRB_COMMON_IND the timing info is checked
   *            (i.e. it is checked that the DRB Data has been received before the SYSTEM_IND)
   *            NOTE: p_SrbIndByRef and p_SysIndByRef shall be initialised as omit by the caller
   *                  (that cannot be done within the altstep)
   * @param     p_NR_CellId
   * @param     p_ExpectedSequence
   * @param     p_DrbIndByRef       (by reference)
   * @param     p_SysIndByRef       (by reference)
   * @param     p_ExpectedDrbInd    (default value: car_NR_DRB_COMMON_IND_Any)
   * @param     p_ExpectedSysInd    (default value: car_NR_SYSTEM_IND_Any)
   * @status    APPROVED (NR5GC)
   */
  altstep a_NR_RacingCond_AwaitDrbDataAndSysInd(NR_CellId_Type p_NR_CellId,
                                                   RacingCond_ExpectedSequence_Type p_ExpectedSequence,
                                                   inout template (omit) NR_DRB_COMMON_IND p_DrbIndByRef,
                                                   inout template (omit) NR_SYSTEM_IND p_SysIndByRef,
                                                   template (present) NR_DRB_COMMON_IND p_ExpectedDrbInd := car_NR_DRB_COMMON_IND_Any,
                                                   template (present) NR_SYSTEM_IND p_ExpectedSysInd := car_NR_SYSTEM_IND_Any)
                                                   runs on NR_BASE_PTC
  { /* note: since this is an altstep 'interleave' cannot be used */
    /* note: since the altstep uses repeat to receive the second message the altstep is left and re-entered again
     *       => local variables are uninitialised; the only way to store information of subsequent messages is by the inout parameters
     *          (which for that reason have to be "inout"; "out" would not work */
    var NR_DRB_COMMON_IND v_DRB_COMMON_IND;
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var SubFrameTiming_Type v_Timing_SysInd;
    var SubFrameTiming_Type v_Timing_DrbInd;

    [not isvalue(p_DrbIndByRef)] DRB.receive (p_ExpectedDrbInd) -> value v_DRB_COMMON_IND
      {
        p_DrbIndByRef := v_DRB_COMMON_IND;
        if (not isvalue(p_SysIndByRef)) {                               // SYSTEM_IND has not been received yet
          repeat;                                                       // => wait for SYSTEM_IND
        } else {
          v_Timing_DrbInd := valueof(p_DrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_DrbInd, v_Timing_SysInd);
        }
      }
    [not isvalue(p_SysIndByRef)] SYSIND.receive (p_ExpectedSysInd) -> value v_SYSTEM_IND
      {
        p_SysIndByRef := v_SYSTEM_IND;
        if (not isvalue(p_DrbIndByRef)) {                               // RRC message has not been received yet
          repeat;                                                       // => wait for RRC PDU
        } else {
          v_Timing_DrbInd := valueof(p_DrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_DrbInd, v_Timing_SysInd);
        }
      }
  }

  /*
   * @desc      to deal with racing conditions:
   *            NR_SYSTEM_IND and NR_DRB_COMMON_IND are just stored and returned to the caller;
   *            there may be one or no NR_SYSTEM_IND before the DRB Data is received;
   *            if there is a NR_SYSTEM_IND before the NR_DRB_COMMON_IND the timing info is checked
   *            (i.e. it is checked that the DRB Data has been received before the SYSTEM_IND)
   *            NOTE: p_SrbIndByRef and p_SysIndByRef shall be initialised as omit by the caller
   *                  (that cannot be done within the altstep)
   * @param     p_NR_CellId
   * @param     p_ExpectedSequence
   * @param     p_DrbIndByRef       (by reference)
   * @param     p_SysIndByRef       (by reference)
   * @param     p_ExpectedSysInd    (default value: car_NR_SYSTEM_IND_Any)
   * @param     p_ExpectedDrbInd    (default value: car_NR_DRB_COMMON_IND_Any)
   * @status    APPROVED (ENDC, NR5GC)
   */
  altstep a_NR_RacingCond_AwaitSysIndAndDrbData(NR_CellId_Type p_NR_CellId,
                                                   RacingCond_ExpectedSequence_Type p_ExpectedSequence,
                                                   inout template (omit) NR_DRB_COMMON_IND p_DrbIndByRef,
                                                   inout template (omit) NR_SYSTEM_IND p_SysIndByRef,
                                                   template (present) NR_SYSTEM_IND p_ExpectedSysInd := car_NR_SYSTEM_IND_Any,
                                                   template (present) NR_DRB_COMMON_IND p_ExpectedDrbInd := car_NR_DRB_COMMON_IND_Any
                                                   )
                                                   runs on NR_BASE_PTC
  { /* note: since this is an altstep 'interleave' cannot be used */
    /* note: since the altstep uses repeat to receive the second message the altstep is left and re-entered again
     *       => local variables are uninitialised; the only way to store information of subsequent messages is by the inout parameters
     *          (which for that reason have to be "inout"; "out" would not work */
    var NR_DRB_COMMON_IND v_DRB_COMMON_IND;
    var NR_SYSTEM_IND v_SYSTEM_IND;
    var SubFrameTiming_Type v_Timing_SysInd;
    var SubFrameTiming_Type v_Timing_DrbInd;

    [not isvalue(p_DrbIndByRef)] DRB.receive (p_ExpectedDrbInd) -> value v_DRB_COMMON_IND
      {
        p_DrbIndByRef := v_DRB_COMMON_IND;
        if (not isvalue(p_SysIndByRef)) {                               // SYSTEM_IND has not been received yet
          repeat;                                                       // => wait for SYSTEM_IND
        } else {
          v_Timing_DrbInd := valueof(p_DrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SysInd, v_Timing_DrbInd );
        }
      }
    [not isvalue(p_SysIndByRef)] SYSIND.receive (p_ExpectedSysInd) -> value v_SYSTEM_IND
      {
        p_SysIndByRef := v_SYSTEM_IND;
        if (not isvalue(p_DrbIndByRef)) {                               // RRC message has not been received yet
          repeat;                                                       // => wait for RRC PDU
        } else {
          v_Timing_DrbInd := valueof(p_DrbIndByRef.Common.TimingInfo.SubFrame);
          v_Timing_SysInd := valueof(p_SysIndByRef.Common.TimingInfo.SubFrame);
          fl_NR_RacingCond_CheckSequence(p_NR_CellId, p_ExpectedSequence, v_Timing_SysInd, v_Timing_DrbInd);
        }
      }
  }

  /*
   * @desc      check whether NR_SYSTEM_IND and NR_SRB_COMMON_IND have been in the correct sequence
   * @param     p_NR_CellId
   * @param     p_ExpectedSequence
   * @param     p_Timing_SrbInd
   * @param     p_Timing_SysInd
   * @param     p_Timing_SysInd2    (default value: omit)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_RacingCond_CheckSequence(NR_CellId_Type p_NR_CellId,
                                          RacingCond_ExpectedSequence_Type p_ExpectedSequence,
                                          SubFrameTiming_Type p_Timing_SrbInd,
                                          SubFrameTiming_Type p_Timing_SysInd,
                                          template (omit) SubFrameTiming_Type p_Timing_SysInd2 := omit
                                          ) runs on NR_BASE_PTC
  {
    var SubFrameTiming_Type v_FirstEvent;
    var SubFrameTiming_Type v_SecondEvent;
    var SubFrameTiming_Type v_ThirdEvent;
    
    select (p_ExpectedSequence) {
      case (MsgBeforeSysInd) {
        v_FirstEvent := p_Timing_SrbInd;
        v_SecondEvent := p_Timing_SysInd;
        if (not f_NR_RacingCond_CheckTwoEvents(p_NR_CellId, v_FirstEvent, v_SecondEvent)) {
            f_SetVerdictInconc(__FILE__, __LINE__, "SYSTEM_IND and RRC message are in the wrong order");
        }
      }
      case (SysIndBeforeRrcMsg) {
        v_FirstEvent := p_Timing_SysInd;
        v_SecondEvent := p_Timing_SrbInd;
        if (not f_NR_RacingCond_CheckTwoEvents(p_NR_CellId, v_FirstEvent, v_SecondEvent)) {
            f_SetVerdictInconc(__FILE__, __LINE__, "SYSTEM_IND and RRC message are in the wrong order");
        }
      }
      case (AnyOrder) {
        return;
      }
      case(SysInd1BeforeMsgBeforeSysInd2) {
        v_FirstEvent := p_Timing_SysInd;
        v_SecondEvent := p_Timing_SrbInd;
        if (isvalue(p_Timing_SysInd2)) {
            v_ThirdEvent := valueof(p_Timing_SysInd2);  //parameter ispresent when the third value is used
        } else {FatalError(__FILE__, __LINE__, "The third value shall be provided");}
        if (not f_NR_RacingCond_CheckTwoEvents(p_NR_CellId, v_FirstEvent, v_SecondEvent) or not f_NR_RacingCond_CheckTwoEvents(p_NR_CellId, v_SecondEvent, v_ThirdEvent) ) {
            f_SetVerdictInconc(__FILE__, __LINE__, "SYSTEM_IND1, SYSTEM_IND2 and RRC message are in the wrong order");
        }
      }
      case(MsgSameTimeSysInd){  //Added for new test case
        v_FirstEvent := p_Timing_SysInd;
        v_SecondEvent := p_Timing_SrbInd;
        if (not (p_Timing_SysInd == p_Timing_SrbInd )) {
            f_SetVerdictInconc(__FILE__, __LINE__, "SYSTEM_IND and RRC message are not in the smae slot");
        }
      }
    }

  }

  /*
   * @desc      check whether p_Event1 has been before p_Event2
   * @param     p_NR_CellId
   * @param     p_Event1
   * @param     p_Event2
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RacingCond_CheckTwoEvents(NR_CellId_Type p_NR_CellId,
                                          SubFrameTiming_Type p_Event1,
                                          SubFrameTiming_Type p_Event2) runs on NR_BASE_PTC return boolean
  {
    var integer v_SlotsDifferences;
    var boolean v_Result := true;

    v_SlotsDifferences := f_NR_SubFrameTiming_DurationSlot(p_NR_CellId, p_Event1, p_Event2);  // p_Event2 - p_Event1
    if (v_SlotsDifferences < 0) {
       /* if v_SlotsDifferences < 0 => Event2 has been occurred before Event1 */
      v_Result := false;
    }
    return v_Result;
  }

  /*
   * @desc      wrapper function to be used when there is no further parallel behaviour
   *            SYSTEM_IND is expected to be before the RRC message
   *            RRC message is just received, stored in p_SysIndByRef but needs to be matched in a second step
   * @param     p_NR_CellId
   * @param     p_ExpectedSysInd
   * @param     p_SrbIndByRef       (by reference)
   * @param     p_SysIndByRef       (by reference)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_RacingCond_AwaitSysIndBeforeSrbMsg(NR_CellId_Type p_NR_CellId,
                                                   template (present) NR_SYSTEM_IND p_ExpectedSysInd,
                                                   out template (omit) NR_SRB_COMMON_IND p_SrbIndByRef,
                                                   out template (omit) NR_SYSTEM_IND p_SysIndByRef) runs on NR_BASE_PTC
  {
    p_SrbIndByRef := omit;
    p_SysIndByRef := omit;

    alt {
      [] a_NR_RacingCond_AwaitRrcMessageAndSysInd(p_NR_CellId,
                                                  SysIndBeforeRrcMsg,
                                                  p_SrbIndByRef,
                                                  p_SysIndByRef,
                                                  -,
                                                  p_ExpectedSysInd);
    }
  }

  /*
   * @desc  Return the slot difference between 2 received timing
   *        Return the number of slots between p_T2 - p_T1
   *        Note: timings p_T1 & p_T2 are received in IND ASP => fully provided (subframe/slot etc/...)
   * @param     p_NR_CellId
   * @param     p_T1
   * @param     p_T2
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */

  function f_NR_SubFrameTiming_DurationSlot(NR_CellId_Type p_NR_CellId,
                                            SubFrameTiming_Type p_T1,
                                            SubFrameTiming_Type p_T2) runs on NR_BASE_PTC return integer
  {
     var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var integer v_SlotsT1:= 0;
    var integer v_SlotsT2:= 0;
    var integer v_MaxValue := 10240 * v_SlotsPerSubframe;   // SFN is 0..1023 in steps of 10ms;
    var integer v_DurationSlot;
    var SlotOffset_Type v_SlotOffset;
    
    if (ischosen(p_T1.Slot.SlotOffset)) {
      v_SlotOffset := p_T1.Slot.SlotOffset;
      select union (v_SlotOffset) {
        case (Numerology1) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology1;
            v_SlotsT2 := p_T1.Slot.SlotOffset.Numerology1;
        }
        case (Numerology2) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology2;
            v_SlotsT2 := p_T1.Slot.SlotOffset.Numerology2;
        }
        case (Numerology3) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology3;
            v_SlotsT2 := p_T1.Slot.SlotOffset.Numerology3;
        }
        case (Numerology4) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology4;
            v_SlotsT2 := p_T1.Slot.SlotOffset.Numerology4;
        }
      }
    } //else v_SlotsT1=0 and v_SlotsT2=0
    v_SlotsT1 := (p_T1.SFN.Number * 10 * v_SlotsPerSubframe) + p_T1.Subframe.Number * v_SlotsPerSubframe + v_SlotsT1;
    v_SlotsT2 := (p_T2.SFN.Number * 10 * v_SlotsPerSubframe) + p_T2.Subframe.Number * v_SlotsPerSubframe + v_SlotsT2;

    v_DurationSlot := (v_MaxValue + v_SlotsT2 - v_SlotsT1) mod v_MaxValue;  // calculation considers wrap-around

    return v_DurationSlot;
  }

  /*
   * @desc      match RRC message
   * @param     p_ReceivedRrcInd
   * @param     p_ExpectedRrcInd
   * @status    APPROVED (NR5GC)
   */
  function f_NR_RacingCond_MatchRrcMsg(template (omit) NR_SRB_COMMON_IND p_ReceivedRrcInd,
                                          template NR_SRB_COMMON_IND p_ExpectedRrcInd) runs on NR_BASE_PTC
  {
    var boolean v_Match;
    
    if (not isvalue(p_ReceivedRrcInd)) {
      v_Match := false;
    } else {
      if (not match(valueof(p_ReceivedRrcInd), p_ExpectedRrcInd)) {
        v_Match := false;
      } else {
        v_Match := true;
      }
    }
    if (not v_Match) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "received RRC message does not match");
    }
  }

  /*
   * @desc      Calculate timing info based on timing info of the given cell and the SFN offset, Tcell and TcOffset of the given cells
   * @param     p_NR_CellId1
   * @param     p_TimingInfo1
   * @param     p_NR_CellId2
   * @return    template (value) TimingInfo_Type
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_TimingOtherCell(NR_CellId_Type p_NR_CellId1,
                                template (value) TimingInfo_Type p_TimingInfo1,
                                NR_CellId_Type p_NR_CellId2) runs on NR_BASE_PTC return template (value) TimingInfo_Type
  {
    var CellTimingInfo_Type v_CellTimingInfo1 := f_NR_CellInfo_GetCellTimingInfo(p_NR_CellId1);
    var CellTimingInfo_Type v_CellTimingInfo2 := f_NR_CellInfo_GetCellTimingInfo(p_NR_CellId2);
    var SubcarrierSpacing v_SCS_Cell1 := f_NR_CellInfo_GetSCS(p_NR_CellId1);
    var SubcarrierSpacing v_SCS_Cell2 := f_NR_CellInfo_GetSCS(p_NR_CellId2);
    var template (omit) SlotTimingInfo_Type v_SlotTimingInfo := omit;//@sic R5s210079 sic@
    
    if (v_SCS_Cell1 != v_SCS_Cell2) { //@sic R5s210079 sic@
        select (v_SCS_Cell2){
            case (kHz15) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology0;}
            case (kHz30) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology1(0);}
            case (kHz60) {v_SlotTimingInfo := cs_SlotTimingInfo_Numerology2(0);}
            case (kHz120){v_SlotTimingInfo := cs_SlotTimingInfo_Numerology3(0);}
            case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSpacing");}
        }
    }
    return f_CellTimingInfo_TimingOtherCell(v_CellTimingInfo1, p_TimingInfo1, v_CellTimingInfo2, v_SlotTimingInfo);
  }

  /*
   * @desc      Convert a Timing (SFN/subframe/slots) in number of slots
   * @param     p_Timing
   * @param     p_SlotsPerSubframe
   * @return    integer
   * @status    APPROVED (NR5GC)
   */
   function f_NR_ConvertTiming_To_TimingInSlots( SubFrameTiming_Type  p_Timing,
                                                 integer              p_SlotsPerSubframe
                                               ) return integer
  {
    var integer v_TimingSlots;
    v_TimingSlots := (((p_Timing.HSFN.Number * 10240) + (p_Timing.SFN.Number * 10) + p_Timing.Subframe.Number) * p_SlotsPerSubframe) + f_NR_SubFrameTiming_GetSlotNumber(p_Timing);

    return v_TimingSlots;
  }

  /*
   * @desc      Convert a number of slots to Timing (SFN/subframe/slots)
   * @param     p_TimingInSlots
   * @param     p_SubcarrierSpacing
   * @param     p_SlotsPerSubframe
   * @return    SubFrameTiming_Type
   * @status    APPROVED (NR5GC)
   */
   function f_NR_ConvertTimingInSlots_To_Timing( integer              p_TimingInSlots,
                                                 SubcarrierSpacing    p_SubcarrierSpacing,
                                                 integer              p_SlotsPerSubframe
                                               ) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_Timing;
    var integer v_Subframes;
    var integer v_SFN;
    
    v_Subframes := p_TimingInSlots / p_SlotsPerSubframe;
    v_SFN := v_Subframes / 10;
    
    v_Timing.HSFN.Number := v_SFN / 1024;
    v_Timing.SFN.Number := v_SFN mod 1024;
    v_Timing.Subframe.Number := v_Subframes mod 10;
    v_Timing.Symbol := valueof(cs_SymbolTimingInfo_FirstSlot); //@sic R5s221246 sic@
    v_Timing := f_NR_SubFrameTiming_SetSlot(v_Timing, p_TimingInSlots mod p_SlotsPerSubframe, p_SubcarrierSpacing);
    return v_Timing;
  }

  /*
   * @desc      Offsets timing on NR Cell acc. to input given
   * @param     p_TimingInfo
   * @param     p_SlotsToAdd
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SubFrameTiming_AddSlots(SubFrameTiming_Type p_TimingInfo,
                                            UInt_Type p_SlotsToAdd) return SubFrameTiming_Type
  {
    var SubFrameTiming_Type v_TimingInfo := p_TimingInfo;  //@sic R5w220211 sic@
    var UInt_Type v_Subframes;
    var UInt_Type v_Slot :=0;
    var UInt_Type v_SFN :=0;
    var UInt_Type v_SlotsInSubframe  ;
    var template (value) SlotTimingInfo_Type v_SlotTimingInfo;

    if (not (ischosen(p_TimingInfo.Slot.SlotOffset) and ischosen(p_TimingInfo.Subframe.Number) and ischosen(p_TimingInfo.SFN.Number) and ischosen(p_TimingInfo.HSFN.Number) )) {
      FatalError(__FILE__, __LINE__, "Invalid SubFrameTiming");
    }
    if (ischosen(p_TimingInfo.Slot.SlotOffset.Numerology0))
    {
        v_SlotsInSubframe := 1;
        v_Slot:=p_SlotsToAdd;
        v_SlotTimingInfo :=cs_SlotTimingInfo_Numerology0;
        }
    else if(ischosen(p_TimingInfo.Slot.SlotOffset.Numerology1))
    {
        v_SlotsInSubframe := 2;
        v_Slot :=p_TimingInfo.Slot.SlotOffset.Numerology1+p_SlotsToAdd;
        v_SlotTimingInfo :=cs_SlotTimingInfo_Numerology1(v_Slot mod v_SlotsInSubframe);
        }
    else if(ischosen(p_TimingInfo.Slot.SlotOffset.Numerology2))
    {
        v_SlotsInSubframe := 4;
        v_Slot :=p_TimingInfo.Slot.SlotOffset.Numerology2+p_SlotsToAdd;
        v_SlotTimingInfo :=cs_SlotTimingInfo_Numerology2(v_Slot mod v_SlotsInSubframe);
        }
    else if(ischosen(p_TimingInfo.Slot.SlotOffset.Numerology3))
    {
        v_SlotsInSubframe := 8;
        v_Slot :=p_TimingInfo.Slot.SlotOffset.Numerology3+p_SlotsToAdd;
        v_SlotTimingInfo :=cs_SlotTimingInfo_Numerology3(v_Slot mod v_SlotsInSubframe);
        }
    else if(ischosen(p_TimingInfo.Slot.SlotOffset.Numerology4))
    {
        v_SlotsInSubframe := 16;
        v_Slot :=p_TimingInfo.Slot.SlotOffset.Numerology4+p_SlotsToAdd;
        v_SlotTimingInfo :=cs_SlotTimingInfo_Numerology4(v_Slot mod v_SlotsInSubframe);
        }

    v_TimingInfo.Slot := valueof (v_SlotTimingInfo);
    v_Subframes := p_TimingInfo.Subframe.Number + (v_Slot / v_SlotsInSubframe);
    v_TimingInfo.Subframe.Number := v_Subframes mod 10;
    v_SFN := p_TimingInfo.SFN.Number + (v_Subframes / 10);
    v_TimingInfo.SFN.Number := v_SFN mod 1024;
    v_TimingInfo.HSFN.Number := (p_TimingInfo.HSFN.Number + (v_SFN / 1024)) mod 1024;
    
    return v_TimingInfo;
  };

  /*
   * @desc      To calculate the timestamp which is p_MilliSeconds before the given timestamp
   * @param     p_TimingInfo
   * @param     p_MilliSeconds
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_SubFrameTiming_SubstractMilliSeconds(SubFrameTiming_Type p_TimingInfo,
                                                  float p_MilliSeconds) return SubFrameTiming_Type
  {//@sic R5s230001 sic@
   var SubFrameTiming_Type v_TimingInfo := p_TimingInfo; //@sic R5w220211 sic@
   var integer v_Diff;
   var SlotOffset_Type v_SlotOffset;
   var integer v_PS_Offset_Slots;
   var integer v_SlotsInSubframe;
   var integer v_Slots_To_Substract;
   var integer v_Subframes_To_Substract;
   var integer v_Frames_To_Substract;
   var integer v_Reminding := 0;
    
    if (not (ischosen(p_TimingInfo.Subframe.Number) and ischosen(p_TimingInfo.SFN.Number) and ischosen(p_TimingInfo.HSFN.Number) and ischosen(p_TimingInfo.Slot.SlotOffset))) {
      FatalError(__FILE__, __LINE__, "Invalid SubFrameTiming");
    }
       v_SlotOffset := p_TimingInfo.Slot.SlotOffset;
        select union (v_SlotOffset) {
            case (Numerology0) {
                v_PS_Offset_Slots := float2int (p_MilliSeconds);
                v_SlotsInSubframe := 1;
                v_Slots_To_Substract := 0;
            }
            case (Numerology1) {
                 v_PS_Offset_Slots := float2int (p_MilliSeconds/0.5);
                 v_SlotsInSubframe := 2;
                 v_Slots_To_Substract := v_PS_Offset_Slots mod v_SlotsInSubframe;
                 if ((v_SlotOffset.Numerology1  - v_Slots_To_Substract) <0){ v_Reminding := 1;}
                 v_TimingInfo.Slot.SlotOffset.Numerology1:= (v_SlotOffset.Numerology1 - (v_Slots_To_Substract - v_SlotOffset.Numerology1))mod v_SlotsInSubframe; //@sic R5s 230309 Ch6 sic@
            }
            case (Numerology2) {
                 v_PS_Offset_Slots := float2int (p_MilliSeconds/0.25);
                 v_SlotsInSubframe := 4;
                 v_Slots_To_Substract := v_PS_Offset_Slots mod v_SlotsInSubframe;
                 if ((v_SlotOffset.Numerology2  - v_Slots_To_Substract) <0){ v_Reminding := 1;}
                 v_TimingInfo.Slot.SlotOffset.Numerology2:= (v_SlotOffset.Numerology2 - (v_Slots_To_Substract - v_SlotOffset.Numerology2))mod v_SlotsInSubframe; //@sic R5s 230309 Ch6 sic@
            }
            case (Numerology3) {
                 v_PS_Offset_Slots := float2int (p_MilliSeconds/0.125);
                 v_SlotsInSubframe := 8;
                 v_Slots_To_Substract := v_PS_Offset_Slots mod v_SlotsInSubframe;
                 if ((v_SlotOffset.Numerology3  - v_Slots_To_Substract) <0){ v_Reminding := 1;}
                 v_TimingInfo.Slot.SlotOffset.Numerology3:= (v_SlotOffset.Numerology3 - (v_Slots_To_Substract - v_SlotOffset.Numerology3))mod v_SlotsInSubframe; //@sic R5s 230309 Ch6 sic@
            }
            case (Numerology4) {
                 v_PS_Offset_Slots := float2int (p_MilliSeconds/0.0625);
                 v_SlotsInSubframe := 16;
                 v_Slots_To_Substract := v_PS_Offset_Slots mod v_SlotsInSubframe;
                 if ((v_SlotOffset.Numerology4  - v_Slots_To_Substract) <0){ v_Reminding := 1;}
                 v_TimingInfo.Slot.SlotOffset.Numerology4:= (v_SlotOffset.Numerology4 - (v_Slots_To_Substract - v_SlotOffset.Numerology4))mod v_SlotsInSubframe; //@sic R5s 230309 Ch6 sic@
            }
            case else { FatalError(__FILE__, __LINE__, "Invalid numerology");}
        }
    
    v_Subframes_To_Substract := ((v_PS_Offset_Slots - (v_Slots_To_Substract) ) / v_SlotsInSubframe) + v_Reminding;
    
    v_Diff := v_Subframes_To_Substract - p_TimingInfo.Subframe.Number;
    v_TimingInfo.Subframe.Number := (10 - (v_Subframes_To_Substract - p_TimingInfo.Subframe.Number))mod 10;
    if (v_Diff <= 0 or v_Subframes_To_Substract mod 10== 0) //@sic R5s260043 sic@
    {
      v_Reminding := 0;
    }
    else
    {
      v_Reminding := 1;
    }
      
    v_Frames_To_Substract := (v_Subframes_To_Substract - (v_Subframes_To_Substract mod 10)) / 10 + v_Reminding;
    v_Diff := v_Frames_To_Substract -  p_TimingInfo.SFN.Number;
    v_TimingInfo.SFN.Number := (1024 - (v_Frames_To_Substract -  p_TimingInfo.SFN.Number))mod 1024;
    if (v_Diff>0)
    {
      v_TimingInfo.HSFN.Number := (1024 - (1 - p_TimingInfo.HSFN.Number)) mod 1024;
    }
    
    return v_TimingInfo;
  };

/*
   * @desc    This function returns SubFrameTiming of the last valid DL slot up to the input SubFrameTiming
   * @param     p_NR_CellId
   * @param     p_TimingInfo
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_LastDL_Slot( NR_CellId_Type p_NR_CellId,
                                SubFrameTiming_Type p_TimingInfo) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    // as per 38.508-1 Table 4.6.3-103: PDSCH-TimeDomainResourceAllocationList K0 =0 (Slot offset between DCI and its scheduled PDSCH)is assumed
    // K1 = 7,5,8 for TDD SCS15, SCS30, SCS120
    var integer v_LastSlot:= 0;
    var NR_DuplexMode_Type v_NR_DuplexMode := f_NR_CellInfo_GetDuplexMode(p_NR_CellId);
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var integer v_SlotsInSubframe := f_NR_CellInfo_GetSlotsNumberPerSubframe(nr_Cell1) ;
    var integer v_SlotsInframe := v_SlotsInSubframe * 10;
    var integer v_Dl_UL_TransPeriodicity :=5;
    var integer v_MinSlot := 0;
    var integer v_MaxSlot := 5;
    var integer v_Slot := 0;
    var SubFrameTiming_Type v_TimingInfo := p_TimingInfo;
    
    if (ischosen(v_NR_DuplexMode.TDD)){
      select (v_SCS) {
          case (kHz15) {
            // K1 = 7, DDDFU-DDDFU, valid DL slot 1,2,6,7
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number;
            v_TimingInfo.Subframe.Number := 0;
            v_MinSlot := 1;
            v_MaxSlot := 2;
          }
          case (kHz30) {
            // K1 = 5, DD, DD,DD,DF,UU-DD,DD,IDD,DF,UU, valid DL slot 2,3,4,12,13,14
            v_Dl_UL_TransPeriodicity := 10;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology1;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology1 := 0;
            v_MinSlot := 2;
            v_MaxSlot := 4;
          }
          case (kHz120) {
            //@sic R5s220774 sic@
            // K1 = 8, DDDFU DDDFU, ...., valid DL slot 0,1,5,6,10,11...,75,76
            v_Dl_UL_TransPeriodicity := 5;
            v_Slot := v_TimingInfo.Subframe.Number * v_SlotsInSubframe + v_TimingInfo.Slot.SlotOffset.Numerology3;
            v_TimingInfo.Subframe.Number := 0;
            v_TimingInfo.Slot.SlotOffset.Numerology3 := 0;
            v_MinSlot := 0;
            v_MaxSlot := 1;
          }
          case else {FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing");}
      }
      
      v_LastSlot := v_Slot mod v_Dl_UL_TransPeriodicity;
      if (v_LastSlot > v_MaxSlot) {
        v_LastSlot := v_Slot - (v_LastSlot - v_MaxSlot);
      } else {
        if (v_LastSlot < v_MinSlot)
        {
          v_LastSlot := v_Slot - (v_LastSlot + v_Dl_UL_TransPeriodicity - v_MaxSlot);
        }
        else{
          v_LastSlot := v_Slot;
        }
      }
      
      if (v_LastSlot < 0 )
      { // LastSlot is in previous Frame
        v_LastSlot := v_LastSlot + v_SlotsInframe;
        v_TimingInfo.SFN.Number := (v_TimingInfo.SFN.Number + 1023) mod 1024;
        if (v_TimingInfo.SFN.Number > 1022)
        {
          v_TimingInfo.HSFN.Number := (v_TimingInfo.HSFN.Number + 1023) mod 1024;
        }
      }
      
      v_TimingInfo := f_NR_SubFrameTiming_AddSlots( v_TimingInfo, v_LastSlot);
    }
    // for FDD, any slot is valid
    return v_TimingInfo;
  }

}
