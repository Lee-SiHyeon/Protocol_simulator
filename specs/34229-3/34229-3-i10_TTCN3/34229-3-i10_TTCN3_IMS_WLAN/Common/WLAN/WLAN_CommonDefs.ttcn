module WLAN_CommonDefs {

  import from CommonIP all;
  import from WLAN_Parameters all;

  const WLAN_AddressInfo_Type tsc_WLAN_AddressInfo := {  /* @status    APPROVED (IMS) */
    UE_IPAddressIPv4 := px_WLAN_UE_AddrIPv4,
    UE_IPAddressIPv6 := px_WLAN_UE_AddrIPv6,
    DNS_ServerAddressIPv4 := px_WLAN_NetworkAddrIPv4,
    DNS_ServerAddressIPv6 := px_WLAN_NetworkAddrIPv6,
    EPDG_ServerAddressIPv4 := px_WLAN_NetworkAddrIPv4,
    EPDG_ServerAddressIPv6 := px_WLAN_NetworkAddrIPv6,
    EmergencyEPDG_ServerAddressIPv4 := px_WLAN_NetworkAddrIPv4,
    EmergencyEPDG_ServerAddressIPv6 := px_WLAN_NetworkAddrIPv6,
    Non3GPP_XCAP_ServerAddressIPv4 := px_WLAN_NetworkAddrIPv4,
    Non3GPP_XCAP_ServerAddressIPv6 := px_WLAN_NetworkAddrIPv6
  };

  /*
   * @desc      return PDN_AddressInfo
   * @return    WLAN_AddressInfo_Type
   * @status    APPROVED (IMS)
   */
  function f_WLAN_AddressInfo_Get() return WLAN_AddressInfo_Type
  {
    return tsc_WLAN_AddressInfo;
  }

}
