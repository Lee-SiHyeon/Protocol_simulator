  }

  /*
   * @desc      return the location area id stored in EUTRA_CellInfo
   * @param     p_CellId
   * @return    NAS_Lac
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_GetLocationAreaCode(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return NAS_Lac
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.NAS_Parameters.LocationAreaCode;
  }

  /*
   * @desc      return the C-RNTI stored in EUTRA_CellInfo
   * @param     p_CellId
   * @return    C_RNTI
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_GetC_RNTI(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return C_RNTI
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
