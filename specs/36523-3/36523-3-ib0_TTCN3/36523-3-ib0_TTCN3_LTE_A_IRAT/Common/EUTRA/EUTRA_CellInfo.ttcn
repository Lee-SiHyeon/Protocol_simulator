  /*
   * @desc      get Cell Identity for given cell
   * @param     p_CellId
   * @return    CellIdentity
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_GetCellIdentity(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return CellIdentity
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.CellIds.CellIdentity;
  }

  /*
   * @desc      Return the EARFCN parameters (DL and UL) stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    CellCarrierFreqEUTRA_Type
   * @status    APPROVED (ENDC, IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_GetEARFCN(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return CellCarrierFreqEUTRA_Type
  { // @sic R5-165892 band extension sic@
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.Frequency.UL_DL_Earfcn;
  }

  /*
   * @desc      Return the DL EARFCN r9 parameters DL stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    ARFCN_ValueEUTRA_r9
   * @status    APPROVED (ENDC, IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_GetEARFCN_DL_r9(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return ARFCN_ValueEUTRA_r9
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.Frequency.UL_DL_Earfcn.dl_CarrierFreq_r9;
  }

  /*
   * @desc      Return the ul-CarrierFreq to omit except if the Tx-Rx spacing is not as per default
   * @param     p_CellId
   * @return    template (omit) ARFCN_ValueEUTRA
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_EUTRA_CellInfo_GetUL_CarrierNotDefaultTxRx(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return template (omit) ARFCN_ValueEUTRA
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    var template (omit) ARFCN_ValueEUTRA v_UL_CarrierFreq := omit;
    if ( not(v_CellInfo.Frequency.UL_DL_Earfcn.defaultTxRx )) { //field set to true only for band 24 frequency f2
        v_UL_CarrierFreq := v_CellInfo.Frequency.UL_DL_Earfcn.ul_CarrierFreq;
    }
    return v_UL_CarrierFreq;
  }

  /*
   * @desc      Return the EARFCN parameters (DL and UL) stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    Frequency_IE_Type
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT, NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_GetFrequencyIEs(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return Frequency_IE_Type
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.Frequency;
  }

  /*
   * @desc      Return the combination stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    Dl_Bandwidth_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function f_EUTRA_CellInfo_GetDL_ChBandwidth(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return Dl_Bandwidth_Type
  {
    var EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    return v_CellInfo.Frequency.DL_ChBandwidth;
  }

  /*
   * @desc      Return the combination stored in the EUTRA_CellInfo
   * @param     p_CellId
   * @return    Ul_Bandwidth_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
