module ESM_ENDC_NR {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from NR_CellInfoInit_ENDC all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions_ENDC all;
  import from NR_Component_Base all;
  import from NR_Component_ENDC all;
  import from NR_ConfigurationSteps all;

  /*
   * @desc      Generic procedure for NAS preamble on ENDC NR
   * @param     p_NR_CellId
   * @param     p_AdditionalPDN     (default value: omit)
   * @status    APPROVED (ENDC)
   */
  function fl_NAS_ENDC_NR(NR_CellId_Type p_NR_CellId, template (omit) IP_DrbId_Type p_AdditionalPDN := omit) runs on ENDC_NR_PTC
  {
    f_ENDC_NR_Init();
    //Create and configure NR cell1
    f_NR_CellConfig_Def(p_NR_CellId);
    if (isvalue(p_AdditionalPDN)) { // @sic R5w190118, R5s191074 sic@ - set to DRB ID if test case is configuring an additional PDN on NR (for 10.2.1.1)
      f_IP_Handling_StartPDN(IP, PDN_3, cs_DrbInfo_NREPC(p_NR_CellId, valueof(p_AdditionalPDN)));
    }
    // Get NR capabilities sent during EUTRA preamble
    f_NR_ENDC_PreambleOnEUTRA(p_NR_CellId, MCG_SCG);
    f_NR_TestBody_Set(true);
    //Wait from coordination AFTER the connection is released in E-UTRA
    f_EUTRA_NR_WaitForCoOrd_Trigger(EUTRA, "Postamble");
    f_NR_TestBody_Set(false);
    //Postamble
    f_NR_ReleaseAllCells();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 10.2.1.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_10_2_1_1_ENDC_NR() runs on ENDC_NR_PTC
  { //Default EPS bearer context activation
    //The rrc connection reconfiguration parameters are sent in this function
    fl_NAS_ENDC_NR(nr_Cell1, tsc_NR_DRB2); // @sic R5w190118 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 10.2.1.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_10_2_1_2_ENDC_NR() runs on ENDC_NR_PTC
  { //Dedicated EPS bearer context activation
    fl_NAS_ENDC_NR(nr_Cell1);//The rrc connection reconfiguration parameters are sent in this function
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 10.2.2.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_10_2_2_1_ENDC_NR() runs on ENDC_NR_PTC
  { //EPS bearer resource allocation / modification
    fl_NAS_ENDC_NR(nr_Cell1);//The rrc connection reconfiguration parameters are sent in this function
  }

}
