  type record AccessType {                              /* 24.501 cl. 9.11.2.1A */
    IEI4_Type                   iei                   optional, /* present in case of TV; omit in case of V */
    B2_Type                     spare,
    B2_Type                     accessType
  };
  
  type record AdditionalSecurityInfo {                           /* 24.501 cl 9.11.3.12 */
    IEI8_Type                   iei                   optional, /* present in case of TV; omit in case of V */
    Type4Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
    B6_Type                     spareBits,                      /* Dec18 */
    B1_Type                     rinmr,                          /* Dec18 */
    B1_Type                     hdp
  };

  type record AddInfoRequest {                         /* 24.501 cl 9.11.3.12A */
    IEI8_Type                   iei                   optional, /* present in case of TV; omit in case of V */
    Type4Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
    B7_Type                     spareBits,
    B1_Type                     cipherKey
  };

  type record ConfigUpdateInd {                          /* 24.501 cl. 9.11.3.18 */
    IEI4_Type                   iei,                      // currently only used as TV
    B2_Type                     spare,
    B1_Type                     red,                      //registration requested
    B1_Type                     ack                       //acknowledgement requested
  };

  type record CAGInfoList {                            /* 24.501 cl. 9.11.3.18A */
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type6Length_Type            iel,
    record of CAG_Info  listOfCAGInfos optional
  };

  type record CAG_Info {                              /* 24.501 cl. 9.11.3.18A */
    Type4Length_Type            iel,
    CAG_Info_V                  cagValue               // Sep22 @sic R5s221179 Baseline Moving sic@
  };

  type record CAG_Info_V {                              /* 24.501 cl. 9.11.3.18A, 9.11.3.86 */
    NAS_PlmnId                  plmn,
    B7_Type                     spareBits,
    B1_Type                     cagOnly,
    record of O4_Type  listOfCAGIds optional
  };

  type record ExtdCAGInfoList {                       /* 24.501 cl. 9.11.3.86 Jun24 @sic R5s240531 Baseline Moving sic@*/
    IEI8_Type                   iei,
    Type6Length_Type            iel,
    record of ExtdCAG_Info  listOfCAGInfos optional
  };

  type record ExtdCAG_Info {                           /* 24.501 cl. 9.11.3.86 Jun24 @sic R5s240531 Baseline Moving sic@*/
    Type6Length_Type            iel,
    NAS_PlmnId                  plmn,
    B4_Type                     spareBits,
    B1_Type                     caili,
    B1_Type                     lci,
    B1_Type                     spare,
    B1_Type                     cagOnly,
    Type6Length_Type            lengthWithoutAddInfoList    optional,
    record of O4_Type           listOfCAGIds                optional,
    CAGIdsWithAddInfo           listOfCAGIdsWithAddInfo     optional
  };
  
  type record CAGIdsWithAddInfo {
    Type6Length_Type                iel,
    record of CAGIdsWithAddInfo_V   listOfCAGIds
  };

  type record CAGIdsWithAddInfo_V {
    Type6Length_Type            iel,
    O4_Type                     cagId,
    B1_Type                     spare,
    B6_Type                     svii,
    B1_Type                     tvii,
    TimeValidityInfoList        timeValidityInfo     optional
  };
  
  type record TimeValidityInfoList {
    O2_Type                numOfTimePeriods,
    record of O16_Type     timePeriod
  };

  type record CIoTSmallDataContainer {                 /* 24.501 cl. 9.11.3.18B */
    /* The IEI will not be included in the encoded string */
    Type4Length_Type            iel,
    B3_Type                     dataType,
    B2_Type                     ddx,                 /* set to 00 for dataType = 001 */
    B3_Type                     pduSessionId,        /* set to 00 for dataType = 010 or 001 */
    Type4Length_Type            lengthOfAddInfo       optional,  /* only present for dataType = 010 */
    octetstring                 addInfo               optional,  /* not present for dataType = 000 or 001 */
    octetstring                 dataContents
  };

  type record CIoTSmallDataRxdString {                 /* 24.501 cl. 9.11.3.18B
                                                   This is used in the received NAS and will then be
                                                   decoded later into the structured type defined above*/
    IEI8_Type                   iei,
    octetstring                 encodedstring
  };
  
  type record NG_CipheringKeyData {                            /* 24.501 cl. 9.11.3.18C Must differentiate between the 5G and the EPC versions */
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type6Length_Type            iel,
    record length (1..16) of NG_CipherDataSet  listOfCipherKeyData optional
  };

  type record NG_CipherDataSet {                              /* 24.501 cl. 9.11.3.18C */
    O2_Type                     id,
    O16_Type                    key,
    B3_Type                     spareBits,
    B5_Type                     c0Length,
    octetstring                 c0  length (1..16),
    B4_Type                     eSpareBits,
    B4_Type                     eSIBLength,
    O1_Type                     eposSIB1            optional,
    O1_Type                     eposSIB2_O1         optional,
    O1_Type                     eposSIB2_O2         optional,
    O1_Type                     eposSIB2_O3         optional,
    O1_Type                     eposSIB2_SIB5       optional,
    B4_Type                     nSpareBits,
    B4_Type                     nSIBLength,
    O1_Type                     nposSIB1            optional,
    O1_Type                     nposSIB2_O1         optional,
    O1_Type                     nposSIB2_O2         optional,
    O1_Type                     nposSIB2_SIB3       optional,
    O1_Type                     nposSIB4_SIB6       optional,
    O1_Type                     nposSIB_extd        optional,  // Jun24 @sic R5s240531 Baseline Moving sic@
    O5_Type                     validityStartTime,
    O2_Type                     validityDuration,
    Type4Length_Type            taiLength,
    record length (1..16) of NG_ListOfPartialTaiList  listOfPartialTais  optional
  };

  type record CP_ServiceType {                            /* 24.301 cl. 9.9.3.18D */
    IEI4_Type                   iei                   optional, /* present in case of TV; omit in case of V */
    B1_Type                     tsc,                            // Type of security context: 0 = cached, 1 = mapped
    NAS_KsiValue                nasKeySetId
  };

  type record DeregisterType {                          // 24.501 cl. 9.11.3.20
    // IEI is always skipped
    B1_Type                     switchOff,
    B1_Type                     reRegistration,
    B2_Type                     accessType
  };

  type record EPS_MessageContainer {                          /* 24.501 cl. 9.11.3.24 */
    IEI8_Type                   iei                   optional, /* present in case of TV; omit in case of V */
    Type6Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
    octetstring                 epsMsg
  };

  type record LADN_Ind {                                      /* 24.501 cl. 9.11.3.29 */
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type6Length_Type            iel,
    octetstring  listOfLADN_DNNValues length (1..808)  optional  // @sic R5w190307 sic@
  };

  type record ListOfLADN {
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type4Length_Type            dnnLength,
    octetstring                 dnnValue,
    record length (1..16) of NG_ListOfPartialTaiList  listOfPartialTais  // same as TAIList IE from 3rd octet
};
  
  type record LADN_Info {                              /* 24.501 cl. 9.11.3.30 */
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type6Length_Type            iel,
    record of ListOfLADN  listOfLADN
  };

  type record MICO_Ind {                          // 24.501 cl. 9.11.3.31
    IEI4_Type                   iei,
    B2_Type                     spare,
    B1_Type                     sprti,         /* Sep20 @sic R5s201387 Baseline Moving sic@ */
    B1_Type                     raai
  };
  
  type record MA_PDUSessionInfo {                  // 24.501 cl. 9.11.3.31A
    IEI4_Type                   iei,
    B4_Type                     maPDUSession
  };

  type record MappedNSSAI {                       // 24.501 cl. 9.11.3.31B
    IEI8_Type                   iei                   optional, /* present in case of TLV; omit in case of LV */
    Type4Length_Type            iel                   optional, /* present in case of LV or TLV; omit in case of V */
