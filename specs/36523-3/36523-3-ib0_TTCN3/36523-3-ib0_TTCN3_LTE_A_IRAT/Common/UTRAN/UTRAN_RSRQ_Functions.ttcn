module UTRAN_RSRQ_Functions {

  import from CommonDefs all;
  import from UTRAN_ASP_VirtualNoiseDefs all;
  import from UTRAN_Component all;

  template (value) UTRAN_VNG_CTRL_REQ cas_UTRAN_VNG_Configure_REQ(UTRAN_CellId_Type p_CellId,
                                                                  integer  p_IocLevel ):=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    CellId := f_UtranCellId2Int(p_CellId),
    Request := {
     Configure := {
       IocLevel := p_IocLevel
     }
    }
  };

  template (value) UTRAN_VNG_CTRL_REQ cas_UTRAN_VNG_Activate_REQ (UTRAN_CellId_Type p_CellId) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    CellId := f_UtranCellId2Int(p_CellId),
    Request := {
      Activate := true
    }
  };

  /*
   * @desc      configuration of the virtual noise generator, regardless of the power level the noise generator is off before it gets activated for this cell
   * @param     p_CellId
   * @param     p_IocLevel
   * @status    APPROVED (LTE_A_IRAT, LTE_IRAT)
   */
  function f_UTRAN_ConfigureVNG(UTRAN_CellId_Type p_CellId,
                                integer  p_IocLevel) runs on UTRAN_PTC
  {
    U_VNG.send (cas_UTRAN_VNG_Configure_REQ ( p_CellId, p_IocLevel)) ;
  }

  /*
   * @desc      Activate the noise (switched on) for the given cell
   * @param     p_CellId
   * @status    APPROVED (LTE_A_IRAT, LTE_IRAT)
   */
  function f_UTRAN_ActivateVNG ( UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC
  {
    U_VNG.send (cas_UTRAN_VNG_Activate_REQ ( p_CellId)) ;
  }

}
