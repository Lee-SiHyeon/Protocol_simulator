module IMS_Procedures_CallControlCommon {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_IP_Config all;
  import from IMS_Procedures_Common all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;

  type record IMS_InviteRequestWithSdp_Type {       /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
                                                       @sic R5w140112: new type sic@ */
    IMS_RoutingInfo_Type        RoutingInfo,
    INVITE_Request              Invite,
    SDP_Message                 SdpOffer  optional
  };

  /*
   * @desc      build-up IMS_InviteRequestWithSdp_Type
   * @param     p_IMS_DATA_REQ
   * @param     p_SdpOffer
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_InviteRequestWithSdpMO(IMS_DATA_REQ p_IMS_DATA_REQ,
                                        SDP_Message p_SdpOffer) return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    
    v_InviteRequestWithSdp.RoutingInfo := p_IMS_DATA_REQ.RoutingInfo;
    v_InviteRequestWithSdp.Invite := p_IMS_DATA_REQ.Request.Invite;
    v_InviteRequestWithSdp.SdpOffer := p_SdpOffer;
    return v_InviteRequestWithSdp;
  }

  type record IMS_SDP_AudioCodecInfo_Type
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    IMS_SDP_AudioCodec_Type Codec,
    charstring Fmt
  };

  /*
   * @desc      Function to get the AudioCodec information on a Emergency Call
   *            p_AudioCodecList specifies the set of codecs of which at least one codec shall be contained in the SDP offer
   * @param     p_InitialSdpOffer
   * @param     p_AudioCodecList
   * @return    IMS_SDP_AudioCodecInfo_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_GetAudioCodecInfo(SDP_Message p_InitialSdpOffer,
                                       IMS_SDP_AudioCodecList_Type p_AudioCodecList) runs on IMS_PTC return IMS_SDP_AudioCodecInfo_Type
  {
    var template SDP_attribute_fmtp_format_specific_params v_FmtpParametersForAMR := omit;  // => fmtp is not checked
    var SDP_media_desc v_SDP_Media_Audio := p_InitialSdpOffer.media_list[0];
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var charstring v_FmtAudio;
    var integer i;

    for (i := 0; i < lengthof(p_AudioCodecList); i := i + 1) {
      v_AudioCodec := p_AudioCodecList[i];
      select (v_AudioCodec) {
        case (EVS_16000) { v_FmtAudio := f_SDP_MediaDescr_GetAudioCodec(v_SDP_Media_Audio, v_AudioCodec); }                // @sic R5-223392 sic@
        case (AMR_16000) { v_FmtAudio := f_SDP_MediaDescr_GetAMR_WB_16000_1(v_SDP_Media_Audio, v_FmtpParametersForAMR); }  /* @sic R5-134795 sic@ @sic R5-171511: AMR/8000 and/or AMR-WB/16000 sic@ */
        case (AMR_8000)  { v_FmtAudio := f_SDP_MediaDescr_GetAMR_8000_1(v_SDP_Media_Audio, v_FmtpParametersForAMR); }      /* @sic R5-171511: AMR/8000 and/or AMR-WB/16000 sic@ */
      }
      if (v_FmtAudio != "") {
        return {v_AudioCodec, v_FmtAudio};
      }
    }
    f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "no appropriate AMR codec found in given media description");
    return {v_AudioCodec, v_FmtAudio};  // dummy statement
  }

  /*
   * @desc      Check max-red parameter in fmtp line
   * @param     p_AttributeList
   * @param     p_Fmt
   * @param     p_FormatSpecificParameters (default value: cr_AMR_Fmtp_DefaultParameters)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_SDP_Fmtp_CheckMaxRed(template (omit) SDP_attribute_list p_AttributeList,
                                       charstring p_Fmt,
                                       template (present) SDP_attribute_fmtp_format_specific_params p_FormatSpecificParameters := cr_AMR_Fmtp_DefaultParameters) runs on IMS_PTC
  {
    var template (omit) SDP_attribute v_Attribute;
    var charstring v_RedMaxValStr;
    var integer v_RedMaxVal;

    v_Attribute := f_SDP_AttributeList_GetAttribute(p_AttributeList, cr_SDP_Attribute_fmtp(p_Fmt, p_FormatSpecificParameters));
    if (isvalue(v_Attribute)) {
      v_RedMaxValStr := f_SIP_SemicolonParamList_GetParamValue(v_Attribute.fmtp.params.paramList, "max-red"); // @sic R5w140113, R5w140009 sic@
      if (v_RedMaxValStr != "") {
        v_RedMaxVal := str2int(v_RedMaxValStr);
        if (not match(v_RedMaxVal, (0..220))) { /* @sic R5-141114sic@ */
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid value for red-max parameter");
        }
      }
    }
  }

  /*
   * @desc      return true, if none of the forbidden parameters is contained in the parameter list of the codec given by fmt
   * @param     p_AttributeList
   * @param     p_Fmt
   * @param     p_ForbiddenParameterList
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_SDP_Fmtp_CheckForbiddenParameters(template (omit) SDP_attribute_list p_AttributeList,
                                                    charstring p_Fmt,
                                                    CharStringList_Type p_ForbiddenParameterList) runs on IMS_PTC
  {
    var SemicolonParam_List v_FmtpParameterList := f_SDP_MediaDescr_GetCodecParameters(p_AttributeList, p_Fmt);
    var integer i;

    for (i := 0; i < lengthof(p_ForbiddenParameterList); i := i + 1) {
      if (match(v_FmtpParameterList, cr_SemicolonParam_List_OneSpecificParam(p_ForbiddenParameterList[i]))) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Forbidden fmtp paramter for CatM1: " & p_ForbiddenParameterList[i]);
      }
    }
  }

  /*
   * @desc      Check whether codecs (rtpmap attribute) are in the order as in given codec list
   * @param     p_AttributeList
   * @param     p_AudioCodecList
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_SDP_CheckCodecPreferenceOrder(template (omit) SDP_attribute_list p_AttributeList,
                                                IMS_SDP_AudioCodecList_Type p_AudioCodecList) runs on IMS_PTC
  {
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapAttributePattern;
    var SDP_attribute_list v_AttributeList;
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var boolean v_CodecFound;
    var integer k;
    var integer i;

    if (not isvalue(p_AttributeList)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "no attributes");
    } else {
      v_AttributeList := valueof(p_AttributeList);
      k := 0;

      for (i:=0; i < lengthof(p_AudioCodecList); i:=i+1) {
        v_AudioCodec := p_AudioCodecList[i];
        select (v_AudioCodec) {
          case (DTMF_8000, DTMF_16000) {
            // do nothing
          }
          case else {
            v_RtpmapAttributePattern := f_SDP_AttributeRtpmapAudioRX(v_AudioCodec);
            v_CodecFound := false;
            while (not v_CodecFound) {
              if (k >= lengthof(v_AttributeList)) {
                f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "codec not found in expected order");
                return;
              }
              v_CodecFound := match(v_AttributeList[k], cr_SDP_Attribute_rtpmap(-, v_RtpmapAttributePattern));
              k := k+1;
            }
          }
        }
      }
    }
  }

  /*
   * @desc      Check whether media description contains given list of voice codecs
   * @param     p_SDP_Media_Desc
   * @param     p_AudioCodecList
   * @param     p_CheckForbiddenParameters   (default value: false)
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_CheckMediaDescr_AudioCodecs(SDP_media_desc p_SDP_Media_Desc,
                                                 IMS_SDP_AudioCodecList_Type p_AudioCodecList,
                                                 boolean p_CheckForbiddenParameters := false) runs on IMS_PTC
  { /* @sic R5-151968: new function replacing f_IMS_SDP_CheckMediaDescr_AMR_8000_1, f_IMS_SDP_CheckMediaDescr_AMR_16000_1, f_IMS_SDP_CheckMediaDescr_EVS_16000_1 sic@ */
    /* @sic R5-172931: checking list of voice codecs rather than single one sic@ */
    /* @sic R5-180231: p_CheckForbiddenParameters sic@ */
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters;
    var template (omit) SDP_attribute_list v_AttributeList := p_SDP_Media_Desc.attributes;
    var CharStringList_Type v_ForbiddenParameterList;
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var charstring v_Fmt;
    var integer i;
    
    for (i:=0; i < lengthof(p_AudioCodecList); i:=i+1) {
      v_AudioCodec := p_AudioCodecList[i];
      v_FmtpParameters := f_SDP_FmtpDefaultParametersAudioCodecRX(v_AudioCodec);   /* @sic R5s160379 change 1 sic@ */
      v_Fmt := f_SDP_MediaDescr_GetAudioCodec(p_SDP_Media_Desc, v_AudioCodec, v_FmtpParameters);   /* @sic R5s160379 change 1 sic@ */
      
      if (v_Fmt == "") {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "expected voice codec not found in given media description");
      }

      /* check of the red-max parameter: */
      fl_IMS_SDP_Fmtp_CheckMaxRed(v_AttributeList, v_Fmt);       /* NOTE: this check is only about checking the value range to be correct if max-red is present;
                                                                  *       the presence of max-red itself needs to be checked in the receive template of the SDP message */
      /* check for parameters not to be included: */
      if (p_CheckForbiddenParameters) {
        select (v_AudioCodec) {
          case (AMR_8000, AMR_16000) {
            v_ForbiddenParameterList := {"mode-set", "mode-change-period", "mode-change-neighbor", "crc", "robust-sorting", "interleaving"};
          }
          case (EVS_16000) {
            v_ForbiddenParameterList := {"dtx", "dtx-recv", "evs-mode-switch" };
          }
          case (DTMF_8000, DTMF_16000) {
            v_ForbiddenParameterList := {};  /* all parameters are allowed */
          }
          case else {
            FatalError(__FILE__, __LINE__, "unknown voice codec");
          }
        }
        fl_IMS_SDP_Fmtp_CheckForbiddenParameters(v_AttributeList, v_Fmt, v_ForbiddenParameterList);
      }
    }
    if (p_AudioCodecList[0] == EVS_16000) {      // @sic R5-197035: check codec preference order for C.44 sic@
      fl_IMS_SDP_CheckCodecPreferenceOrder(v_AttributeList, p_AudioCodecList);
      // @sic R5-225925..37: f_IMS_SDP_CheckMediaDescr_NG114PayloadTypes removed; to be used case by case sic@
    }
  }

  /*
   * @desc      return true when the given INVITE is MO in which case it does not contain a record route (yet)
   * @param     p_InviteRequest
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_InviteRequestIsMO(template (value) INVITE_Request p_InviteRequest) return boolean
  {
    return not ispresent(p_InviteRequest.msgHeader.recordRoute.routeBody);
  }

  /*
   * @desc      returns expected route-set depending on whether the dialog is MO or MT
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (present) RouteBody_List
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_Request_RouteSet_RouteBodyList_RX(IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                   template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (present) RouteBody_List
  { /* @sic R5s150692 change 6: parameter p_CallType sic@ */
    var template (present) RouteBody_List v_RouteBodyList := {};

    if (f_IMS_PTC_ImsInfo_DialogIsMO(p_DialogIndex)) {
      v_RouteBodyList := f_IMS_RouteSet_ReverseOrder(f_IMS_RouteSet_MO_Call_TX(p_CallType)); /* @sic R5s150692 change 6 sic@ */
    } else {
      v_RouteBodyList := f_IMS_RouteSet_MT_Call_TX();
    }
    return v_RouteBodyList;
  }

  /*
   * @desc      return Via as received in previous INVITE
   * @param     p_InviteVia
   * @return    template (present) Via
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_Via_AsInPrevInvite(template (omit) Via p_InviteVia) return template (present) Via
  { /* @sic R5w210206: via optional in MessageHeader => p_ViaRequest: template (omit) sic@ */
    var template (present) charstring v_Protocol := ("UDP", "TCP");  // @sic R5s130586 change 7 sic@
    var HostPort v_SentBy := valueof(p_InviteVia.viaBody[0].sentBy); // @sic R5w210206: via optional in MessageHeader => valueof to avaoid compiler warnings sic@
    return cr_ViaDef(v_Protocol, v_SentBy);
  }

  /*
   * @desc      100 Trying for INVITE (see TS 34.229, A.2.2)
   *            NOTE: acc. to A.2.2 there is no Session-ID in this message
   * @param     p_InviteRequest
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_InviteResponse_100_MessageHeaderTX(INVITE_Request p_InviteRequest) return template (value) MessageHeader
  {
    var MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (value) MessageHeader v_MessageHeader_Response := cs_MessageHeader_Dummy;

    v_MessageHeader_Response.via             := v_MessageHeader_Invite.via;
    v_MessageHeader_Response.fromField       := v_MessageHeader_Invite.fromField;
    v_MessageHeader_Response.toField         := cs_ToDef(f_Addr_Union_GetSipUrl(v_MessageHeader_Invite.toField.addressField));
    v_MessageHeader_Response.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Response.cSeq            := v_MessageHeader_Invite.cSeq;

    return v_MessageHeader_Response;
  }

  /*
   * @desc      ACK (see TS 34.229, A.2.7)
   * @param     p_InviteRequest
   * @param     p_StatusLine_PrevResponse
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_IsReInvite        (default value: false)
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_AckRequest_MessageHeaderRX(template (value) INVITE_Request p_InviteRequest,
                                            template (value) StatusLine p_StatusLine_PrevResponse,
                                            IMS_CallType_Type p_CallType := NORMAL_CALL,
                                            boolean p_IsReInvite := false)
    runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130684: p_StatusLine_PrevResponse made mandatory, p_MessageHeader_PrevResponse removed, new parameter p_IsGiba sic@ */
    /* @sic R5s130756 additional changes: p_IsGIBA removed sic@ */
    /* @sic R5-141115: new parameter p_IsReInvite sic@ */
    /* @sic R5s150692 change 18: parameter p_CallType sic@ */
    /* @sic R5-155994: pAccessNetworkInfo is optional, i.e. may be included sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (present) MessageHeader v_MessageHeader_Ack := cr_MessageHeader_Dummy;
    var integer v_CSeqValue := f_MessageHeader_GetCseqValue(v_MessageHeader_Invite);
    var integer v_StatusCode := valueof(p_StatusLine_PrevResponse.statusCode);
    var boolean v_Is2xxResponse := not ((v_StatusCode < 200) or (v_StatusCode > 299));   // @sic R5s140264: missing braces sic@
    var template RouteBody_List v_RouteBodyList;

    if (p_IsReInvite or not v_Is2xxResponse) { /* @sic R5-141115 sic@ */
      v_RouteBodyList  := p_InviteRequest.msgHeader.route.routeBody;            /* @sic R5-134958, R5s130885: use the Route header of the INVITE in case of e.g. 5XX responses (see RFC 3261 cl. 17.1.1.3) sic@ */
    } else {
      v_RouteBodyList  := f_IMS_Request_RouteSet_RouteBodyList_RX(p_CallType);  /* @sic R5s130684: same as for 180 or 183 response in reverse order sic@
                                                                                   @sic R5s130897 change 3 sic@
                                                                                   @sic R5s140017 MCC160 implementation: re-INVITE - Route is different for MO and MT calls sic@
                                                                                   @sic R5s150692 change 18 sic@ */
    }

    if (v_Is2xxResponse) {  /* @sic R5-130682: ACK for 2xx response sic@ */
      v_MessageHeader_Ack.via := f_IMS_Via_AsInPrevInvite(v_MessageHeader_Invite.via);
    } else {                /* @sic R5-130682: ACK for non-2xx response sic@ */
      v_MessageHeader_Ack.via := v_MessageHeader_Invite.via;
    }

    v_MessageHeader_Ack.route           := cr_Route(v_RouteBodyList);
    v_MessageHeader_Ack.toField         := f_IMS_RequestInDialog_ToHeaderRX();    /* @sic R5s130497 change 1 - MCC160 implementation; R5-133303; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Ack.fromField       := f_IMS_RequestInDialog_FromHeaderRX();  /* @sic R5s130497 change 1 - MCC160 implementation; R5-133303; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Ack.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Ack.cSeq            := cr_CseqDef(v_CSeqValue, "ACK");
    v_MessageHeader_Ack.maxForwards     := cr_MaxForwardsDef;
   
    return v_MessageHeader_Ack;
  }

  /*
   * @desc      BYE (see TS 34.229, A.2.8)
   * @param     p_InviteRequest
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_DialogIndex       (default value: omit)
   * @param     p_IsEmergencyCall   (default value: false)
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_ByeRequest_MessageHeaderRX(template (value) INVITE_Request p_InviteRequest,
                                            IMS_CallType_Type p_CallType := NORMAL_CALL,
                                            template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit,
                                            boolean p_IsEmergencyCall := false) runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130756 additional changes: p_IsGIBA removed sic@ */
    /* @sic R5s150692 change 19: parameter p_CallType sic@ */
    /* @sic R5-160505: p_A5 := false per default sic@ */
    /* @sic R5-172934: p_A6, p_A5 removed; new parameter p_IsEmergencyCall sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    var boolean v_A1 := f_IMS_PTC_SecurityScheme_IsImsSecurity();
    var boolean v_A2 := f_IMS_PTC_SecurityScheme_IsGiba();
    var boolean v_A6 := p_IsEmergencyCall and not f_IMS_PTC_ImsInfo_IsRegistered();       /* @sic R5-172934 sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (present) MessageHeader v_MessageHeader_Bye := cr_MessageHeader_Dummy;
    var template (present) integer v_CSeqValue := f_IMS_RequestInDialog_CSeqValueRX(dialogRemote, p_DialogIndex);  /* @sic R5s200320: f_IMS_RequestInDialog_CSeqValueRX instead of f_IMS_PTC_ImsInfo_CseqIncr sic@ */
    var template (present) RouteBody_List v_RouteBodyList;
    var template (present) Via v_Via;
    var template (present) PAccessNetworkInfo  v_PAccessNetworkInfo := cr_PAccessNetworkInfo(f_IMS_PTC_GetRanType());

    if (not fl_IMS_InviteRequestIsMO(p_InviteRequest)) {                  /* @sic R5-134116: sic@
                                                                             in case of MT call establishment the INVITE sent to the UE contains a Record-Route header with a valid route set */
      v_Via := f_IMS_SipRequest_ViaRX();                                  /* as defined in A.2.1 */
    } else {                                                              /* in case of MO call establishment the route set as for the 183 response shall be used (in reverse order) */
      v_Via := f_IMS_Via_AsInPrevInvite(v_MessageHeader_Invite.via)
    }
    v_RouteBodyList := f_IMS_Request_RouteSet_RouteBodyList_RX(p_CallType, p_DialogIndex);      /* @sic R5s140017 MCC160 implementation: re-INVITE - Route is different for MO and MT calls sic@
                                                                                                   @sic R5s150692 change 19 sic@ */

    v_MessageHeader_Bye.via             := v_Via;
    v_MessageHeader_Bye.route           := cr_Route(v_RouteBodyList);
    v_MessageHeader_Bye.toField         := f_IMS_RequestInDialog_ToHeaderRX(p_DialogIndex);     /* @sic R5s130497 change 1 - MCC160 implementation; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Bye.fromField       := f_IMS_RequestInDialog_FromHeaderRX(p_DialogIndex);   /* @sic R5s130497 change 1 - MCC160 implementation; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Bye.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Bye.cSeq            := cr_CseqDef(v_CSeqValue, "BYE");
    v_MessageHeader_Bye.maxForwards     := cr_MaxForwardsDef;

    if (v_A6) {       /* @sic R5-172934 sic@ */
      v_MessageHeader_Bye.require            := omit;
      v_MessageHeader_Bye.proxyRequire       := omit;
      v_MessageHeader_Bye.securityVerify     := omit;
    }
    else {
      if (v_A1) {
        v_MessageHeader_Bye.require          := cr_RequireSecAgree;
        v_MessageHeader_Bye.proxyRequire     := cr_ProxyRequireSecAgree;
        v_MessageHeader_Bye.securityVerify   := f_IMS_PTC_BuildSecurityVerifyHeader();          /* @sic R5-196983 sic@ */
      }
      else if (v_A2) {
        v_MessageHeader_Bye.securityVerify   := omit;
      }
    }
    if (v_A1) {
      v_MessageHeader_Bye.pAccessNetworkInfo := v_PAccessNetworkInfo;
    }
    else if (v_A2) {
      v_MessageHeader_Bye.pAccessNetworkInfo := v_PAccessNetworkInfo ifpresent;
    }
    return v_MessageHeader_Bye;
  }

  /*
   * @desc      Common function to receive and check INVITE against 34.229-1 A.2.1
   *            when the INVITE is optional a wait duration shall be given
   * @param     p_ExpectedCalleeUri
   * @param     p_MessageHeader_Invite
   * @param     p_MessageBody
   * @param     p_WaitDuration      (default value: omit)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_IsEmergencyCallWithoutRegistration    (default value: false)
   * @return    template (omit) IMS_DATA_REQ
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_INVITE_ReceiveRequest_Optional(template (present) SipUrl p_ExpectedCalleeUri,
                                                template (present) MessageHeader p_MessageHeader_Invite,
                                                template (present) MessageBody p_MessageBody,
                                                template (omit) float p_WaitDuration := omit,
                                                boolean p_IsReInvite := false,
                                                boolean p_IsEmergencyCallWithoutRegistration := false)
    runs on IMS_PTC return template (omit) IMS_DATA_REQ
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ_ByRef;
    var INVITE_Request v_InviteRequest;
    var SipUrl v_ContactUrl;
    var IP_AddrInfo_Type v_UE_Address;
    var IP_AddrInfo_Type v_NW_Address;
    var boolean v_TimerControl := ispresent(p_WaitDuration);

    timer t_Timer;

    if (v_TimerControl) {
      t_Timer.start(valueof(p_WaitDuration));
    }
    alt {
      [] a_IMS_ReceiveRequest(car_IMS_Invite_Request(cr_INVITE_Request(p_ExpectedCalleeUri, p_MessageHeader_Invite, p_MessageBody)), v_IMS_DATA_REQ_ByRef)
        {
          t_Timer.stop;
          v_InviteRequest := v_IMS_DATA_REQ_ByRef.Request.Invite;
          if (p_IsEmergencyCallWithoutRegistration) {      // emergency call without registration   @sic R5s130756 change 14 sic@
            v_ContactUrl := f_MessageHeader_GetContactSipUrl(v_InviteRequest.msgHeader);   /* @sic R5s150268 change 1 sic@ */
            v_UE_Address := v_IMS_DATA_REQ_ByRef.RoutingInfo.UE_Address;
            v_NW_Address := v_IMS_DATA_REQ_ByRef.RoutingInfo.NW_Address;
            f_IMS_PTC_ImsInfo_Init(v_UE_Address, v_NW_Address);
            f_IMS_PortsAndSecurityConfig(f_SIP_ContactUrl_GetPort(v_ContactUrl), cs_IMS_RegistrationInfo(v_NW_Address, v_UE_Address));          /* @sic R5s150268 change 1 sic@
                                                                                                                                                   @sic R5s180112 - MCC160 Implementation sic@ */
          }
          if (not p_IsReInvite) {      /* @sic R5s140020 change 8.2 sic@ */
            f_IMS_PTC_ImsInfo_DialogInit(dialogRemote, v_InviteRequest.msgHeader);
          } else {
            if (not isvalue(f_IMS_PTC_ImsInfo_CseqGet(dialogRemote))) {  /* @sic R5s140235 sic@ */
              f_IMS_PTC_ImsInfo_CseqSet(dialogRemote, v_InviteRequest.msgHeader.cSeq.seqNumber);
            }
          }
          return v_IMS_DATA_REQ_ByRef;
        }
      [v_TimerControl] t_Timer.timeout {}
    }
    return omit;
  }

  /*
   * @desc      MO Call release scc. to 34.229-1 C.32
   * @param     p_IMS_DATA_REQ_ByRef (by reference)
   * @param     p_DialogIndex       (default value: omit)
   * @param     p_ContactSipUrl
   * @param     p_MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT)
   */
  altstep a_IMS_ReceiveBye(out IMS_DATA_REQ p_IMS_DATA_REQ_ByRef,
                           template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit,
                           template (present) SipUrl p_ContactSipUrl,
                           template (present) MessageHeader p_MessageHeader) runs on IMS_PTC
  {
    // --- Receive BYE
    [] a_IMS_ReceiveRequest(car_IMS_Bye_Request(cr_BYE_Request(p_ContactSipUrl, p_MessageHeader)), p_IMS_DATA_REQ_ByRef)
      {
        if (f_IMS_PTC_ImsInfo_DialogIsReleased(p_DialogIndex)) {
          f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Dialog has already been released");
        }
        f_IMS_MessageHeader_Request_CheckVia(p_IMS_DATA_REQ_ByRef.Request.Bye.msgHeader, p_IMS_DATA_REQ_ByRef.RoutingInfo.Protocol);    /* @sic R5-134116: additional check of Via header sic@ */
        f_IMS_PTC_ImsInfo_DialogRelease(p_DialogIndex);    /* there is no dialog anymore; @sic R5s140017 MCC160 implementation sic@ */
      }
  }

}
