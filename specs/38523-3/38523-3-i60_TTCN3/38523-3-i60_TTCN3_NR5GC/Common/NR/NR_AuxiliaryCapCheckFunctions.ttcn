  /*
   * @desc      Returns fdd/tdd_Add_UE_NR_Capabilities depending on UE mode and conditions described on Note1, Note2, Note 15 of UE-NR-Capability Table
   * @return    template UE_NR_CapabilityAddXDD_Mode
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Derive_AddXDD_UE_NR_Capabilities() return template UE_NR_CapabilityAddXDD_Mode
  { // @sic R5s190471 R5s201302 R5s221088 R5s221186 sic@
    var template (present) UE_NR_CapabilityAddXDD_Mode v_UE_NR_CapabilityAddXDD_Mode;

    if ((f_NR_DualModeCheck() and (not pc_intraAndInterF_MeasAndReport) and (not pc_eventA_MeasAndReport) and (not pc_handoverInterF) and (not (pc_SFTD_MeasNR_Neigh_FDD or pc_SFTD_MeasNR_Neigh_TDD)))
        or (not f_NR_DualModeCheck()))
    {
        v_UE_NR_CapabilityAddXDD_Mode := cr_UE_NR_CapabilityAddXDD_Mode_Omit;
    }
    else if (f_NR_DualModeCheck() and (pc_intraAndInterF_MeasAndReport or pc_eventA_MeasAndReport or pc_handoverInterF or (pc_SFTD_MeasNR_Neigh_FDD or pc_SFTD_MeasNR_Neigh_TDD)))
    {
        v_UE_NR_CapabilityAddXDD_Mode := cr_UE_NR_CapabilityAddXDD_Mode;
    }
    else
    {
        f_SetVerdict(inconc,__FILE__, __LINE__, "PICS do not match condition for UE-NR-CapabilityAddXDD-Mode")
    }
    return v_UE_NR_CapabilityAddXDD_Mode ifpresent;
  };

