   * @param     p_DciFormatAndParams
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_DLGrantConfiguration(NR_CellId_Type p_NR_CellId,
                                      template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                      NR_ResourceAllocationType_Type p_ResourceAllocationType,
                                      template (value) NR_FreqDomainResourceAssignmentDL_Type p_FreqDomainResourceAssignmentDL,
                                      bitstring p_Index := '0000'B,
                                      template (value) NR_TransportBlockRetransmissionList_Type p_TransportBlockRetransmissionList,
                                      template (omit)  NR_TransportBlockRetransmissionList_Type p_TransportBlockRetransmissionList2 := omit,
                                      template (value) NR_HarqProcessConfig_Type p_HarqProcessConfig := cs_NR_HarqProcessConfig_AnyProcess,
                                      template (value) NR_DciFormat_1_X_SpecificInfo_Type p_DciFormatAndParams) runs on NR_BASE_PTC
  {
    var template (value) NR_DciDlInfo_Type v_DciDlInfo := cs_NR_DciDlInfo_Init(p_ResourceAllocationType,
                                                                               p_FreqDomainResourceAssignmentDL,
                                                                               cs_NR_DciCommon_TimeDomainResourceAssignment(p_Index),
                                                                               cs_NR_TransportBlockSchedulingDL_Explicit(p_TransportBlockRetransmissionList, p_TransportBlockRetransmissionList2),
                                                                               p_HarqProcessConfig,
                                                                               p_DciFormatAndParams);
    f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_DciDlInfo_REQ(p_NR_CellId, p_TimingInfo, v_DciDlInfo, true)); //@sic R5s210885 sic@
  }

  /*
   * @desc      Transmission of a STATUS PDU with ACK_SN only for default 18 bit SQN
   * @param     p_ACK_SN
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RxRLCSTATUS_PDU_ACK_SN_Only(integer p_ACK_SN,
                                            DRB_Identity p_NR_DRB_Id)
    runs on NR_BASE_PTC
  {
    var template (present) NR_RLC_StatusPduSN18Bit_Type v_StatusPduSN18Bit := cr_NR_RLC_StatusPduSN18Bit(p_ACK_SN);
    var template (present) NR_RLC_StatusPduSN12Bit_Type v_StatusPduSN12Bit := cr_NR_RLC_StatusPduSN12Bit(p_ACK_SN);
    var template (present) NR_RLC_PDUList_Type v_NR_RLC_PDUList;
    if (f_NR_SupportOfRedCap()) {//@sic R5s230189 R5-256177 sic@
        v_NR_RLC_PDUList := { cr_NR_RLC_PDU_Status(cr_NR_RLC_StatusPDU_SN12Bit(v_StatusPduSN12Bit)) };
    } else{
      v_NR_RLC_PDUList :={ cr_NR_RLC_PDU_Status(cr_NR_RLC_StatusPDU_SN18Bit(v_StatusPduSN18Bit))   };    //  receive STATUS PDU
      }

    DRB.receive(car_NR_DRB_COMMON_IND_RLC_PDUList(nr_Cell1, p_NR_DRB_Id, -, v_NR_RLC_PDUList));
  }

  /*
   * @desc      Builds PDCP SDUs To Be Sent In Consecutive Frames for TC7_1_1_3_2
   * @param     p_PDCP_SDU
   * @param     p_NumSDUs
   * @return    template (value) NR_DRB_DataPerSlotList_DL_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_BuildPDCPSDUsToBeSentInConsecutiveFrames(template (value) NR_PDCP_SDU_Type p_PDCP_SDU,
                                                         integer p_NumSDUs) runs on NR_BASE_PTC
    return template (value) NR_DRB_DataPerSlotList_DL_Type
  {
    const integer tsc_NumPDUPerSlot := 2; //@sic R5s220188 sic@
    var template (value) NR_DRB_DataPerSlotList_DL_Type v_DataList;
    var template (value) NR_PDCP_SDUList_Type v_PdcpSduList;
    var integer i;
    var integer j := p_NumSDUs/tsc_NumPDUPerSlot;
    var integer k := p_NumSDUs - (j * tsc_NumPDUPerSlot);
    var integer v_SlotOffset := (f_NR_CellInfo_GetSlotsNumberPerSubframe(nr_Cell1)) * 5; // half sub frame scheduling periodicity
    //@sic R5s220188 sic@
    v_PdcpSduList := {
      p_PDCP_SDU,
      p_PDCP_SDU
    };

    for (i:=0; i<j; i:=i+1) {
      v_DataList[i] := cs_NR_DRB_DataPerSlot_DL(v_SlotOffset * i, -, cs_NR_L2DataList_PdcpSdu(v_PdcpSduList));
    }
    if (k > 0) { // the number of SDU's to send is not a multiple of tsc_NumPDUPerSlot
      v_PdcpSduList := {};
      for (i:=0; i<k; i:=i+1) {
        v_PdcpSduList[i] := p_PDCP_SDU;
      }
      v_DataList[j] := cs_NR_DRB_DataPerSlot_DL(v_SlotOffset * j, -, cs_NR_L2DataList_PdcpSdu(v_PdcpSduList));
    }
    return v_DataList;
  }

  /*
   * @desc      receive list of PDCP SDUs spread over one or several Slots
   * @param     p_NR_PDCP_SDUList
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Rx_N_PDCP_SDUs(NR_PDCP_SDUList_Type p_NR_PDCP_SDUList,
                               DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC
  {
    var NR_PDCP_SDUList_Type v_PDCP_SDU_List;
    var NR_PDCP_SDUList_Type v_SDUs; // To store the number of PDCP SDUs sent by UE in one TTI
    var NR_DRB_COMMON_IND v_DRB_COMMON_IND;
    var integer v_NoOfPDCPSDUs := lengthof(p_NR_PDCP_SDUList);
    var integer v_SDUIndex;
    var integer v_NoOfPDCPSDUsCurrentSlot := 1;
    var integer v_SDUIndexCurrSlot;

    timer t_Watchdog := 5.0;

    t_Watchdog.start;
    v_SDUIndex := 0;
    while (v_SDUIndex < v_NoOfPDCPSDUs) {
      DRB.receive (car_NR_DRB_COMMON_IND_PDCP_SDUList(nr_Cell1, p_NR_DRB_Id)) -> value v_DRB_COMMON_IND;
      v_PDCP_SDU_List := v_DRB_COMMON_IND.U_Plane.SlotData.PduSduList.PdcpSdu;
      v_NoOfPDCPSDUsCurrentSlot := lengthof(v_PDCP_SDU_List);

      for (v_SDUIndexCurrSlot := 0; v_SDUIndexCurrSlot < v_NoOfPDCPSDUsCurrentSlot; v_SDUIndexCurrSlot := v_SDUIndexCurrSlot + 1) {
        v_SDUs[v_SDUIndex+v_SDUIndexCurrSlot] := v_PDCP_SDU_List[v_SDUIndexCurrSlot];
      }
      v_SDUIndex := v_SDUIndex + v_NoOfPDCPSDUsCurrentSlot;
    }
    if (match(v_SDUs, p_NR_PDCP_SDUList)) {
      f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    } else {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 5: invalid data received");
    }
    t_Watchdog.stop;
  }

  /*
   * @desc     Receive a list of PDCP SDU's in a single TTI
   * @param     p_NR_PDCP_SDUList
   * @param     p_NR_DRB_Id
   * @param     p_NR_CellId         (default value: nr_Cell1)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Rx_N_PDCP_SDUs_InOneTTI(NR_PDCP_SDUList_Type p_NR_PDCP_SDUList,
                                        DRB_Identity p_NR_DRB_Id,
                                        NR_CellId_Type p_NR_CellId := nr_Cell1) runs on NR_BASE_PTC
  {
    timer t_Watchdog := 5.0;

    t_Watchdog.start;
    DRB.receive (car_NR_DRB_COMMON_IND_PDCP_SDUList(p_NR_CellId, p_NR_DRB_Id, -, p_NR_PDCP_SDUList));
    t_Watchdog.stop;
  }

/*
   * @desc      sets 'Number of PDCP SDU' and 'PDCP SDU Size' for a TBsize and returns PDCP SDU list
   * @param     p_TBSize                           .. TB Size in Bits
   * @return    NR_PDCP_SDUList_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function fl_NR_GetPdcpSduList_1TB(integer p_TBSize) return NR_PDCP_SDUList_Type
  {//@sic R5-227169  sic@
    var integer v_N;
    var integer v_PdcpSduSize;
    if (not pc_supportOfRedCap_r17) //Normal UE
    {
        if (p_TBSize <= 12128) {
           v_N := 1;
           v_PdcpSduSize := (p_TBSize - 128)/8;
        }
        else if (p_TBSize <= 24200) {
          v_N := 2;
          v_PdcpSduSize := (p_TBSize - 200)/16;
        }
        else if (p_TBSize <= 36272) {
          v_N := 3;
          v_PdcpSduSize := (p_TBSize - 272)/24;
        }
        else if (p_TBSize <= 48344) {
          v_N := 4;
          v_PdcpSduSize := (p_TBSize - 344)/32; //@sic R5s190927 sic@
        }
        else if (p_TBSize <= 60416) {
          v_N := 5;
          v_PdcpSduSize := (p_TBSize - 416)/40;
        }
        else if (p_TBSize <= 72488) {
          v_N := 6;
          v_PdcpSduSize := (p_TBSize - 488)/48;
        }
        else if (p_TBSize <= 84560) {
          v_N := 7;
          v_PdcpSduSize := (p_TBSize - 560)/56;
        }
        else if (p_TBSize <= 96632) {
          v_N := 8;
          v_PdcpSduSize := (p_TBSize - 632)/64;
        }
        else if (p_TBSize <= 108704) {
          v_N := 9;
          v_PdcpSduSize := (p_TBSize - 704)/72;
        }
        else if (p_TBSize <= 120776) {
          v_N := 10;
          v_PdcpSduSize := (p_TBSize - 776)/80;
        }
        else if (p_TBSize <= 132848) {
          v_N := 11;
          v_PdcpSduSize := (p_TBSize - 848)/88;
        }
        else if (p_TBSize <= 144920) {
          v_N := 12;
          v_PdcpSduSize := (p_TBSize - 920)/96;
        }
        else if (p_TBSize <= 156992) {
          v_N := 13;
          v_PdcpSduSize := (p_TBSize - 992)/104; //@sic R5-190676 R5s210884 sic@
        }
        else if (p_TBSize <= 169064) {
          v_N := 14;
          v_PdcpSduSize := (p_TBSize - 1064)/112;
        }
        else if (p_TBSize <= 181136) {
          v_N := 15;
          v_PdcpSduSize := (p_TBSize - 1136)/120;
        }
        else if (p_TBSize <= 193208) {
          v_N := 16;
          v_PdcpSduSize := (p_TBSize - 1208)/128;
        }
        else if (p_TBSize <= 205280) {
          v_N := 17;
          v_PdcpSduSize := (p_TBSize - 1280)/136;
        }
        else if (p_TBSize <= 217352) {
          v_N := 18;
          v_PdcpSduSize := (p_TBSize - 1352)/144;
        }
        else if (p_TBSize <= 229424) {
          v_N := 19;
          v_PdcpSduSize := (p_TBSize - 1424)/152;
        }
        else if (p_TBSize <= 241496) { //@sic R5-244415 sic@
          v_N := 20;
          v_PdcpSduSize := (p_TBSize - 1496)/160;
        }
    else if (p_TBSize <= 253568) { //@sic R5-244415 R5s25089 sic@
          v_N := 21;
          v_PdcpSduSize := (p_TBSize - 1568)/168;
        }
    else if (p_TBSize <= 265640) { //@sic R5-244415 R5s25089 sic@
          v_N := 22;
          v_PdcpSduSize := (p_TBSize - 1640)/176;
        }
    else if (p_TBSize <= 277712)  { //@sic R5-244415 R5s25089 sic@
          v_N := 23;
          v_PdcpSduSize := (p_TBSize - 1712)/184;
        }
    else if (p_TBSize <= 289784){ //@sic R5-244415 R5s25089 sic@
          v_N := 24;
          v_PdcpSduSize := (p_TBSize - 1784)/192;
        }
    else if (p_TBSize <= 301856) { //@sic R5-244415 R5s25089 sic@
          v_N := 25;
          v_PdcpSduSize := (p_TBSize - 1856)/200;

    }
    else if (p_TBSize <= 313928){ //@sic R5-244415 R5s25089 sic@
          v_N := 26;
          v_PdcpSduSize := (p_TBSize - 1928)/208;
        }
    else { //@sic R5-244415 R5s25089 sic@
          v_N := 27;
          v_PdcpSduSize := (p_TBSize - 2000)/216;
        }
    }
    else //RedCap UE
    {
          if (p_TBSize <= 12112) {
           v_N := 1;
           v_PdcpSduSize := (p_TBSize - 112)/8; //@sic R5s230222 sic@
        }
        else if (p_TBSize <= 24168) {
          v_N := 2;
          v_PdcpSduSize := (p_TBSize - 168)/16;
        }
        else if (p_TBSize <= 36224) {
          v_N := 3;
          v_PdcpSduSize := (p_TBSize - 224)/24;
        }
        else if (p_TBSize <= 48280) {
          v_N := 4;
          v_PdcpSduSize := (p_TBSize - 280)/32;
        }
        else if (p_TBSize <= 60336) {
          v_N := 5;
          v_PdcpSduSize := (p_TBSize - 336)/40;
        }
        else if (p_TBSize <= 72392) {
          v_N := 6;
          v_PdcpSduSize := (p_TBSize - 392)/48;
        }
        else if (p_TBSize <= 84448) {
          v_N := 7;
          v_PdcpSduSize := (p_TBSize - 448)/56;
        }
        else if (p_TBSize <= 96504) {
          v_N := 8;
          v_PdcpSduSize := (p_TBSize - 504)/64;
        }
        else if (p_TBSize <= 108560) {
          v_N := 9;
          v_PdcpSduSize := (p_TBSize - 560)/72;
        }
        else if (p_TBSize <= 120616) {
          v_N := 10;
          v_PdcpSduSize := (p_TBSize - 616)/80;
        }
        else if (p_TBSize <= 132672) {
          v_N := 11;
          v_PdcpSduSize := (p_TBSize - 672)/88;
        }
        else if (p_TBSize <= 144728) {
          v_N := 12;
          v_PdcpSduSize := (p_TBSize - 728)/96;
        }
        else if (p_TBSize <= 156784) {
          v_N := 13;
          v_PdcpSduSize := (p_TBSize - 784)/104;
        }
        else if (p_TBSize <= 168840) {
          v_N := 14;
          v_PdcpSduSize := (p_TBSize - 840)/112;
        }
        else if (p_TBSize <= 180896) {
          v_N := 15;
          v_PdcpSduSize := (p_TBSize - 896)/120;
        }
        else if (p_TBSize <= 192952) {
          v_N := 16;
          v_PdcpSduSize := (p_TBSize - 952)/128;
        }
        else if (p_TBSize <= 205008) {
          v_N := 17;
          v_PdcpSduSize := (p_TBSize - 1008)/136;
        }
        else if (p_TBSize <= 217064) {
          v_N := 18;
          v_PdcpSduSize := (p_TBSize - 1064)/144;
        }
        else if (p_TBSize <= 229120) {
          v_N := 19;
          v_PdcpSduSize := (p_TBSize - 1120)/152;
        }
        else {
          v_N := 20;
          v_PdcpSduSize := (p_TBSize - 1176)/160;
        }
    }

    return f_NR_Build_N_PDCP_SDUList(v_N, v_PdcpSduSize);
  }

  /*
   * @desc      setup list of N PDCP SDUs
   *            (Table 7.1.7.1.1.3.2-1: Maximum TBsize  for different UE categories)
   * @param     p_N
   * @param     p_PdcpSduSize
   * @return    NR_PDCP_SDUList_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Build_N_PDCP_SDUList(integer p_N,
                                     integer p_PdcpSduSize) return NR_PDCP_SDUList_Type
  {
    var NR_PDCP_SDUList_Type v_PDCP_SDUList;
    var integer i;

    if (p_N < 1)  {
      FatalError(__FILE__, __LINE__, "invalid no of PDCP SDU's");
    }

    for (i:=0; i< p_N; i:=i+1) {
      v_PDCP_SDUList[i] := f_GetN_OctetsFromPRBS(5 * i, p_PdcpSduSize);
    }

    return v_PDCP_SDUList;
  }

  /*
   * @desc      Cell info initialisation for tc7.1.1.4.1.X series
   * @param     p_NR_CellId
   * @param     p_DciFormats
   * @param     p_Mcs_Table
   * @param     p_MaxNrofCodeWordsScheduledByDCI
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_Init_7_1_1_4_1_x(NR_CellId_Type p_NR_CellId,
                                 NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats p_DciFormats,
                                 template (omit) PDSCH_Config.mcs_Table p_Mcs_Table,
                                 template (omit) PDSCH_Config.maxNrofCodeWordsScheduledByDCI p_MaxNrofCodeWordsScheduledByDCI) runs on NR_BASE_PTC
  {
    var BWP_Id v_BWP_Id := tsc_NR_BWP_Id;
    var template (value) NR_DownlinkBWP_Type v_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, v_BWP_Id);
    var integer v_SearchSpaceIndex := f_NR_DownlinkBWP_GetSearchSpace_Index(v_DownlinkBWP, tsc_NR_SearchSpaceId_USS);
    v_DownlinkBWP.Pdsch.ConfigCommon.R15.pdsch_TimeDomainAllocationList := cs_NR_PDSCH_TimeDomainResourceAllocationList_71141x;
    v_DownlinkBWP.Pdsch.ConfigDedicated.R15.mcs_Table := p_Mcs_Table; //qam64 if omit
    v_DownlinkBWP.Pdsch.ConfigDedicated.R15.maxNrofCodeWordsScheduledByDCI := p_MaxNrofCodeWordsScheduledByDCI;
    v_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex].SearchSpaceConfigAtUE.R15.searchSpaceType.ue_Specific.dci_Formats := p_DciFormats;
    f_NR_CellInfo_SetDownlinkBWP(p_NR_CellId, v_DownlinkBWP, v_BWP_Id);

    f_NR_CellInfo_SetPdsch_ConfigCommon(p_NR_CellId, cs_NR_PDSCH_TimeDomainResourceAllocationList_71141x);
  };

  /*
   * @desc      Initialise Scheduling resources as per Table 7.1.1.4.2.0-4
   * @param     p_SubcarrierSpacing
   * @return    template (value) SchedulingRequestResourceConfig.periodicityAndOffset
   * @status    APPROVED (ENDC, NR5GC)
   */
   function fl_NR_ReturnPeriodicityAndOffset_71142x(SubcarrierSpacing p_SubcarrierSpacing) return template (value) SchedulingRequestResourceConfig.periodicityAndOffset
  {
    var template (value) SchedulingRequestResourceConfig.periodicityAndOffset v_PeriodicityAndOffset;

    //As per 38.508-1 Table 4.6.3-157: SchedulingRequestResourceConfig
    select (p_SubcarrierSpacing) { //40msec
      case(kHz15)  { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl40; }
      case(kHz30)  { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl80; }
      case(kHz120) { v_PeriodicityAndOffset := cs_NR_PeriodicityAndOffsetSl320; }
      case else    { FatalError(__FILE__, __LINE__, "SCS value not handled in TTCN"); }
    }
    return v_PeriodicityAndOffset;
  };

  /*
   * @desc      Cell initialisation for test case series 7.1.1.4.2.X
   * @param     p_NR_CellId
   * @param     p_DciFormats
   * @param     p_Mcs_Table
   * @param     p_TransformPrecoder
   * @param     p_Msg_TransformPrecoder (default value: omit)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_Init_7_1_1_4_2_x(NR_CellId_Type p_NR_CellId,
                                 NR_SearchSpace_SearchSpaceType_Type.ue_Specific.dci_Formats p_DciFormats,
                                 template (omit) PUSCH_Config.mcs_Table p_Mcs_Table,
                                 template (omit) PUSCH_Config.transformPrecoder p_TransformPrecoder,//@sic R5s201144 sic@
                                 template (omit) RACH_ConfigCommon.msg3_transformPrecoder p_Msg_TransformPrecoder := omit) runs on NR_BASE_PTC
  {
    var BWP_Id v_BWP_Id := tsc_NR_BWP_Id;
    var template (value) NR_UplinkBWP_Type v_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_NR_CellId, v_BWP_Id);
    var template (value) NR_DownlinkBWP_Type v_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_NR_CellId, v_BWP_Id);
    var integer v_SearchSpaceIndex := f_NR_DownlinkBWP_GetSearchSpace_Index(v_DownlinkBWP, tsc_NR_SearchSpaceId_USS);
    //@sic R5s190927 R5s230108 sic@
    var integer v_K2 := 4; // FR2
    var PUSCH_TimeDomainResourceAllocation.startSymbolAndLength v_StartSymbolAndLength := 42;
    var NR_CellInfo_Type v_NR_CellInfo :=f_NR_CellInfo_Get(p_NR_CellId);   //@sic R5s201144 sic@
    var SubcarrierSpacing  v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(nr_Cell1);
    if ( f_NR_CellInfo_GetIsFR1(nr_Cell1)) {
        v_K2 := 2;
        v_StartSymbolAndLength := 52;
        }
    //@sic R5-227416 R5s230108 sic@
    v_UplinkBWP.Dedicated.R15.pusch_Config.setup.pusch_TimeDomainAllocationList.setup := cs_NR_PUSCH_TimeDomainResourceAllocationList_71142x(v_K2, v_StartSymbolAndLength);
    v_UplinkBWP.Dedicated.R15.pusch_Config.setup.mcs_Table  := p_Mcs_Table; //qam64 if omit
    v_UplinkBWP.Dedicated.R15.pusch_Config.setup.transformPrecoder :=p_TransformPrecoder;
    v_UplinkBWP.Dedicated.R15.pucch_Config.setup.schedulingRequestResourceToAddModList[0] := valueof(cs_SchedulingRequestResourceConfig_71142x(v_SubcarrierSpacing));

    //@sic R5-210321 sic@
    v_UplinkBWP.Dedicated.R15.pusch_Config.setup.dmrs_UplinkForPUSCH_MappingTypeB := v_UplinkBWP.Dedicated.R15.pusch_Config.setup.dmrs_UplinkForPUSCH_MappingTypeA;
    if (match(enabled, p_TransformPrecoder)) {
      v_UplinkBWP.Dedicated.R15.pusch_Config.setup.mcs_TableTransformPrecoder := omit;
    }
    if (ispresent (p_Msg_TransformPrecoder)){//@sic R5s201144 sic@
        v_UplinkBWP.Common.R15.rach_ConfigCommon.setup.msg3_transformPrecoder := p_Msg_TransformPrecoder;
        if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){
           v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
           v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.msg3_transformPrecoder := enabled;
           f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
       }
    }


    v_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex].SearchSpaceConfigAtUE.R15.searchSpaceType.ue_Specific.dci_Formats := p_DciFormats;
    if(p_DciFormats == formats0_1_And_1_1)
    {
      if (pc_dynamicSwitchRA_Type0_1_PUSCH) //@sic R5s202610 sic@
      {
        v_UplinkBWP.Dedicated.R15.pusch_Config.setup.resourceAllocation := dynamicSwitch;
      } else
      {
          v_UplinkBWP.Dedicated.R15.pusch_Config.setup.resourceAllocation :=resourceAllocationType1
      }
    }
  //@sic R5-216170 R5s230108 sic@
    //v_DownlinkBWP.Pdsch.ConfigCommon.R15.pdsch_TimeDomainAllocationList := cs_NR_PDSCH_TimeDomainResourceAllocationList_71142x;

    f_NR_CellInfo_SetUplinkBWP(p_NR_CellId, v_UplinkBWP, v_BWP_Id);
    f_NR_CellInfo_SetDownlinkBWP(p_NR_CellId, v_DownlinkBWP, v_BWP_Id);
    //f_NR_CellInfo_SetPdsch_ConfigCommon(p_NR_CellId, cs_NR_PDSCH_TimeDomainResourceAllocationList_71142x); //@sic R5s220098 sic@
    };

   /*
   * @desc      Set PUSCH Resource Allocation
   * @param     p_NR_CellId
   * @param     p_ResourceAllocation (default value: resourceAllocationType1)
   * @status    APPROVED (ENDC, NR5GC)
   */
    function f_NR_Set_PUSCH_ResourceAllocation(NR_CellId_Type p_NR_CellId,
                                               template (value) PUSCH_Config.resourceAllocation p_ResourceAllocation := resourceAllocationType1) runs on NR_BASE_PTC
  {
    var BWP_Id v_BWP_Id := tsc_NR_BWP_Id;
    var template (value) NR_UplinkBWP_List_Type v_NR_UplinkBWP_List := f_NR_CellInfo_GetUplinkBWP_List(p_NR_CellId);
    v_NR_UplinkBWP_List[v_BWP_Id].Dedicated.R15.pusch_Config.setup.resourceAllocation := p_ResourceAllocation;
    f_NR_CellInfo_SetUplinkBWP(p_NR_CellId, v_NR_UplinkBWP_List[v_BWP_Id], v_BWP_Id);
    };

  /*
   * @desc      Function to check is a PRB is allowed for Resource Allocation Type 0
   * @param     p_MaxNPRB_BWP
   * @param     p_N_PRB
   * @param     p_StartIndex        (by reference)
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Resourceallocation0_AllowedNPRB(integer p_MaxNPRB_BWP,
                                                integer p_N_PRB, //@sic R5s240522 sic@
                                                out integer p_StartIndex) return boolean
  { // as per table 7.1.1.4.1.3.3.2-2A/7.1.1.4.1.4.3.2-2A/7.1.1.4.2.3.3.2-2A/7.1.1.4.2.4.3.2-2A
  //@sic R5-247548 sic@
    var boolean v_Result := false;
    p_StartIndex:=0;

    select (p_MaxNPRB_BWP) {
      case (11, 25, 31) {
        v_Result := true;
        if(p_N_PRB mod 2 != 0){p_StartIndex := p_MaxNPRB_BWP-p_N_PRB;} //@sic R5s250026 sic@
      }
      case (18) {
        select (p_N_PRB) {
          case (2,4,6,8,10,12,16,18) {
            v_Result := true;
            //p_StartIndex := 18-p_N_PRB;//@sic R5s250026 sic@
          }
        }
      }
      case (24) {
        select (p_N_PRB) {
          case (2,4,6,8,10,12,16,18,20,22,24) {
            v_Result := true;
            //p_StartIndex := 24-p_N_PRB;//@sic R5s250026 sic@
          }
        }
      }
      case (32) {
        select (p_N_PRB) {
          case (2,4,6,8,10,12,16,18,20,22,24,26,28,30,32) {
            v_Result := true;
            //p_StartIndex := 32-p_N_PRB;//@sic R5s250026 sic@
          }
        }
      }
      case (38) {
        select (p_N_PRB) {
          case (2,4,6,8,10,12,16,18,20,22,24,26,28,30,32,34,36,38) {
            v_Result := true;
            if(p_N_PRB mod 4 != 0){p_StartIndex := 38-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (51) {
        select (p_N_PRB) {
          case (3,4,7,8,11,12,15,16,19,20,23,24,27,28,31,32,35,36,39,40,43,44,47,48,51) {
            v_Result := true;
            if(p_N_PRB mod 4 != 0){p_StartIndex := 51-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (52) {
        select (p_N_PRB) {
          case (4,8,12,16,20,24,28,32,36,40,44,48,52) {
            v_Result := true;
            //p_StartIndex := 52-p_N_PRB;//@sic R5s250026 sic@
          }
        }
      }
      case (65) {
        select (p_N_PRB) {
          case (1,4,5,8,9,12,13,16,17,20,21,24,25,28,29,32,33,36,37,40,41,44,45,48,49, 52,53,56,57,60,61,64,65) {
            v_Result := true;
            if(p_N_PRB mod 4 != 0){p_StartIndex := 65-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (66) {
        select (p_N_PRB) {
          case (2,4,6,8,10,12,16,18,20,22,24,26,28,30,32,34,36,38,40,42,44,46,48,50,52,54,56,58,60,62,64,66) {
            v_Result := true;
            if(p_N_PRB mod 4 != 0){p_StartIndex := 66-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (79) {
        select (p_N_PRB) {
          case (7,8,15,16,23,24,31,32,39,40,47,48,55,56,63,64,71,72,79) {
            v_Result := true;
            if(p_N_PRB mod 8 != 0){p_StartIndex := 79-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (106) {
        select (p_N_PRB) {
          case (2,8,10,16,18,24,26,32,34,40,42,48,50,56,58,64,66,72,74,80,82,88,90,96, 98,104,106) {
            v_Result := true;
             if(p_N_PRB mod 8 != 0){p_StartIndex := 106-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (107) {
        select (p_N_PRB) {
          case (3,8,11,16,19,24,27,32,35,40,43,48,51,56,59,64,67,72,75,80,83,88,91,96, 99,104,107) {
            v_Result := true;
            if(p_N_PRB mod 8 != 0){p_StartIndex := 107-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (132) {
        select (p_N_PRB) {
          case (4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64,68,72,76,80,84,88,92,96, 100,104, 108,112,116,120,124,128,132) {
            v_Result := true;
            if(p_N_PRB mod 8 != 0){p_StartIndex := 132-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (133) {
        select (p_N_PRB) {
          case (5,8,13,16,21,24,29,32,37,40,45,48,53,56,61,64,69,72,77,80,85,88,93,96, 101,104, 109,112,117,120,125,128,133) {
            v_Result := true;
            if(p_N_PRB mod 8 != 0){p_StartIndex := 133-p_N_PRB;} //@sic R5s250026 sic@

          }
        }
      }

      case (135) {
        select (p_N_PRB) {
          case (7,8,15,16,23,24,31,32,39,40,47,48,55,56,63,64,71,72,79,80,87,88,95,96, 103,104, 111,112,119,120,127,128,135) {
            v_Result := true;
            if(p_N_PRB mod 8 != 0){p_StartIndex := 135-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }

     case (160) { //@sic R5s200544 sic@
        select (p_N_PRB) {
          case (16,32,48,64,80,96,112,128,144,160) {
            v_Result := true;
          }
        }
      }

      case (216) {
        select (p_N_PRB) {
          case (8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,136,144,152,160, 168, 176,184,192,200,208,216) {
            v_Result := true;
            if(p_N_PRB mod 16 != 0){p_StartIndex := 216-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (217) {
        select (p_N_PRB) {
          case (9,16,25,32,41,48,57,64,73,80,89,96,105,112,121,128,137,144,153,160, 169,176,185,192,201,208,217) {
            v_Result := true;
            if(p_N_PRB mod 16 != 0){p_StartIndex := 217-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (264) {
        select (p_N_PRB) {
          case (8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,136,144,152, 160,168, 176,184,192,200,208,216,224,232,240,248,256,264) {
            v_Result := true;
            if(p_N_PRB mod 16 != 0){p_StartIndex := 264-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (270) {
        select (p_N_PRB) {
          case (14,16,30,32,46,48,62,64,78,80,94,96,110,112, 126,128,142,144,158, 160,174, 176,190,192, 206,208,222,224,238,240, 254,256,270) {
            v_Result := true;
            if(p_N_PRB mod 16 != 0){p_StartIndex := 270-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case (273) {
        select (p_N_PRB) {
          case (1,16,17,32,33,48,49,64,65,80,81,96,97,112,113,128,129,144,145,160, 161,176,177, 192,193, 208,209, 224,225,240,241,256,257,272,273) {
            v_Result := true;
            if(p_N_PRB mod 16 != 0){p_StartIndex := 273-p_N_PRB;} //@sic R5s250026 sic@
          }
        }
      }
      case else {FatalError(__FILE__, __LINE__, "unknown MaxNPRB per BWP")}
    } // end of select

    return v_Result;
  }

 /*
   * @desc      To check if the Nprb to be allocated is allowed as per 38.211 clause 6.3.1.4
   * @param     p_N_PRB
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Check_This_N_PRB(integer p_N_PRB) return boolean
  {
    var integer i;
    var integer j;
    var integer k;                // indexes for powers of 2, 3, 5, MAX Nprb=264
    for(i:=0; i<=8; i:=i+1){            // for powers of 2, 2
      for(j:=0; j<=5; j:=j+1){          // for powers of 3
        for (k:=0; k<=3; k:=k+1){       // for powers of 5
          if (p_N_PRB == f_Power(2, i) * f_Power(3, j) * f_Power(5, k)) {
            return true;
          }
        }
      }
    }
    return false;
  }

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_71111a(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    RachProcedureList := {
      cs_NR_RachProcedure_NoResponse,
      cs_NR_RachProcedure_NoResponse,
      cs_NR_RachProcedure_NoResponse,
      cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_None)
    }
  };

  template (value) NR_RachProcedureConfig_Type cs_NR_RachProcedureConfig_71111(NR_PhysicalParameters_Type p_PhysicalParameters) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    RachProcedureList := {
      cs_NR_RachProcedure_NoResponse,
      cs_NR_RachProcedure(p_PhysicalParameters, cs_NR_ContentionResolutionCtrl_None)
    }
