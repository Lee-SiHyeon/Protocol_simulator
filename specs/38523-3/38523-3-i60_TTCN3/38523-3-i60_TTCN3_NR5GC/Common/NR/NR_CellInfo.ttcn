  /*
   * @desc      Set SIB4 in the cell
   * @param     p_NR_CellId
   * @param     p_InterFreqCarrierFreqList
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(NR_CellId_Type p_NR_CellId,
                                                             template (value) InterFreqCarrierFreqList p_InterFreqCarrierFreqList) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SIB4_SI_Index := f_NR_GetSIB4_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);
    var integer i;

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList := valueof(p_InterFreqCarrierFreqList);  /* @sic R5s190543 BASELINE MOVING 2019: systemInformation_r15 -> systemInformation sic@ */
    if (pc_supportOfRedCap_r17) {  //@sic R5-235781 sic@
        for (i:=0; i<lengthof(p_InterFreqCarrierFreqList); i:=i+1) {
            v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList_v1700[i] := valueof(cs_InterFreqCarrierFreqInfo_v1700_Def(true_));
        }
    }
    if (pc_supportOfERedCap_r18) {  //@sic R5-246599 sic@
        for (i:=0; i<lengthof(p_InterFreqCarrierFreqList); i:=i+1) {
            v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList_v1800[i] := valueof(cs_InterFreqCarrierFreqInfo_v1800_Def(true_));
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set InterFreqCarrierFreqList-v1800 in SIB4 in the cell
   * @param     p_NR_CellId
   * @param     p_InterFreqCarrierFreqList
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList_v1800(NR_CellId_Type p_NR_CellId,
                                                                   template (value) InterFreqCarrierFreqList_v1800 p_InterFreqCarrierFreqList) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer v_SIB4_SI_Index := f_NR_GetSIB4_SI_Index(v_NR_CellInfo.Sysinfo.NR_SysinfoCombination);
    var integer i;

    v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList_v1800 := valueof(p_InterFreqCarrierFreqList);
    if (pc_supportOfERedCap_r18) {
        for (i:=0; i<lengthof(p_InterFreqCarrierFreqList); i:=i+1) {
            v_NR_CellInfo.Sysinfo.BcchInfo.SIs[v_SIB4_SI_Index].message_.c1.systemInformation.criticalExtensions.systemInformation.sib_TypeAndInfo[0].sib4.interFreqCarrierFreqList_v1800[i].eRedCapAccessAllowed_r18 := true_;
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

