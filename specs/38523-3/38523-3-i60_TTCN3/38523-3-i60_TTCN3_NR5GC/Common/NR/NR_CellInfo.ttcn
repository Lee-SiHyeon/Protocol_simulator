  /*
   * @desc      Retrieve ASN.1 type BWP_DownlinkCommon from ASP type NR_DownlinkBWP_Type
   * @param     p_DL_BWP
   * @param     p_Coreset0_Index
   * @param     p_InitiaBWP         (default value: false)
   * @return    template (value) BWP_DownlinkCommon
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_RetrieveBWP_DownlinkCommon(NR_DownlinkBWP_Type p_DL_BWP,
                                           template (omit) ControlResourceSetZero p_Coreset0_Index,
                                           boolean p_InitiaBWP := false)
    return template (value) BWP_DownlinkCommon
  { //@sic R5-206302: added p_InitiaBWP sic@
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := p_DL_BWP;
    var template (omit) SearchSpaceId v_SearchSpaceSIB1 := tsc_NR_SearchSpaceId_Zero;
    var template (omit) SearchSpaceId v_PagingSearchSpace := tsc_NR_SearchSpaceId_Zero;
    var template (omit) SearchSpaceId v_SearchSpaceOtherSystemInformation := tsc_NR_SearchSpaceId_SISS; //@sic R5-191187 sic@
    var template (omit) PDCCH_ConfigCommon.commonSearchSpaceList v_CommonSearchSpaceList; //@sic R5-191187 sic@
    var integer v_SearchSpaceIndex_CSS := f_NR_DownlinkBWP_GetSearchSpace_Index(p_DL_BWP, tsc_NR_SearchSpaceId_CSS);  //@sic R5-191187 sic@
    var integer v_SearchSpaceIndex_SISS;  //@sic R5-191187 sic@
    var template (omit) ControlResourceSet v_ControlResourceSetNonZero; //@sic R5-202561 sic@
    var template (omit) SearchSpaceZero v_SearchSpaceZero := 0;

    if (f_GetTestcaseAttrib_ENDC(testcasename())) { // Acc to 38.508-1 Table 4.6.3-96: PDCCH-ConfigCommon con EN-DC @sic R5-190718 sic@
      v_SearchSpaceSIB1 := omit;
      v_PagingSearchSpace := omit;
      v_SearchSpaceOtherSystemInformation := omit;
      v_CommonSearchSpaceList := {
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_CSS].SearchSpaceConfigAtUE.R15
      };
      v_ControlResourceSetNonZero := v_NR_DownlinkBWP.Pdcch.CoresetArray[1].R15;
    } else {
      v_SearchSpaceIndex_SISS := f_NR_DownlinkBWP_GetSearchSpace_Index(p_DL_BWP, tsc_NR_SearchSpaceId_SISS);
      v_CommonSearchSpaceList := {
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_CSS].SearchSpaceConfigAtUE.R15,
        v_NR_DownlinkBWP.Pdcch.SearchSpaceArray[v_SearchSpaceIndex_SISS].SearchSpaceConfigAtUE.R15
      };
      v_ControlResourceSetNonZero := omit;
    }
    if (p_InitiaBWP) {
        //As per TS 38.508-1 Table 4.6.3-96: PDCCH-ConfigCommon condition InitialBWP_SIB = Configured via DownlinkConfigCommonSIB or in other BWPs
        // @sic R5-206302 sic@
        v_ControlResourceSetNonZero := omit;
        v_SearchSpaceZero := omit;
    }
    v_BWP_DownlinkCommon := cs_38508_BWP_DownlinkCommon(v_NR_DownlinkBWP.BWP.R15,
                                                        cs_38508_PDCCH_ConfigCommon(p_Coreset0_Index,
                                                                                    v_ControlResourceSetNonZero, //commonControlResourceSet
                                                                                    v_CommonSearchSpaceList,
                                                                                    v_SearchSpaceZero,
                                                                                    -,
                                                                                    v_SearchSpaceSIB1,
                                                                                    v_PagingSearchSpace,
                                                                                    v_SearchSpaceOtherSystemInformation),
                                                        v_NR_DownlinkBWP.Pdsch.ConfigCommon.R15);
    return v_BWP_DownlinkCommon;
  }

  /*
   * @desc      Retrieve ASN.1 type BWP_UplinkCommon from ASP type NR_DownlinkBWP_Type
   * @param     p_UL_BWP
   * @return    BWP_UplinkCommon
