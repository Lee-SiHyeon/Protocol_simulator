          v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.featurePriorities_r17 := valueof(p_FeaturePriorities);
          f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
       } else {
          f_NR_CellInfo_SetSIB1_v1700_IEs(p_NR_CellId, cs_SIB1_v1700_IEs_Def(-, -, -, -, -, -, p_FeaturePriorities));
       }
    }
  };

