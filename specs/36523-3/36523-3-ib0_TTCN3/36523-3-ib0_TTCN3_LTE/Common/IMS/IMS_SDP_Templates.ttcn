  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cs_SDP_Media_Desc_Common(p_SDP_Media_Field, -, p_SDP_Connection_List, p_SDP_Bandwidth_List, p_SDP_Attribute_List);

  template (present) SDP_media_desc cr_SDP_Media_Desc_Common(template (present) SDP_media_field p_SDP_Media_Field,
                                                             template charstring p_MediaTitle := omit,
                                                             template SDP_connection_list p_ConnectionList := omit,
                                                             template SDP_bandwidth_list p_SDP_Bandwidth_List := omit,
                                                             template SDP_attribute_list p_SDP_Attribute_List := omit) :=
  {  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    media_field := p_SDP_Media_Field,
    information := p_MediaTitle,
    connections := p_ConnectionList,
    bandwidth := p_SDP_Bandwidth_List,
    key := omit,
    attributes := p_SDP_Attribute_List
  };

  template (present) SDP_media_desc cr_SDP_Media_Desc(template (present) SDP_media_field p_SDP_Media_Field,
                                                      template (present) SDP_connection  p_SDP_Connection,
                                                      template SDP_bandwidth_list p_SDP_Bandwidth_List,
                                                      template SDP_attribute_list p_SDP_Attribute_List) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cr_SDP_Media_Desc_Common(p_SDP_Media_Field, -, { p_SDP_Connection, * } ifpresent, p_SDP_Bandwidth_List, p_SDP_Attribute_List);

  template (value) SDP_Message cs_SDP_Message_Common(template (value) SDP_Origin p_SDP_Origin,
                                                     charstring p_Sessionname := tsc_SDP_NoSessionname,
                                                     template (omit) SDP_connection p_SDP_Connection := omit,
                                                     template (omit) SDP_bandwidth_list p_Bandwidth,
                                                     template (value) SDP_time p_Time := cs_SDP_Time_0_0,
                                                     template (omit) SDP_media_desc_list p_SDP_Media_Desc_List := omit) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5s130510 change 4 - additional change sic@ */
    /* @sic R5-144700: default value removed for p_Bandwidth sic@ */
    /* @sic R5-150386: there is no reason anymore to provide a parameter for session_name anymore sic@ */
    protocol_version := 0,                                              // v-line
    origin := p_SDP_Origin,                                             // o-line
    session_name := p_Sessionname,                                      // s-line
    information := omit,
    uri := omit,
    emails := omit,
    phone_numbers := omit,
    connection := p_SDP_Connection,                                     // c-line
    bandwidth :=  p_Bandwidth,                                          // b-line
    times := { p_Time },                                                // t-line
    timezone_adjustments := omit,
    key := omit,
    attributes := omit,
    media_list := p_SDP_Media_Desc_List
  };

  template (present) SDP_Message cr_SDP_Message_Common(template (present) charstring p_Username := ?,
                                                       template (present) charstring p_AddrType := ?,
                                                       template (present) charstring p_IPAddrOrigin := ?,
                                                       template (present) charstring p_IPAddrConnection := ?,
                                                       template           SDP_bandwidth_list p_Bandwidth := cr_SDP_Bandwidth_List_AS,
                                                       template (present) SDP_time p_Time := cr_SDP_Time_0_0,
                                                       template SDP_media_desc_list p_SDP_Media_Desc_List := *) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    /* @sic R5-150386: there is no reason anymore to provide a parameter for session_name anymore sic@ */
    protocol_version := 0,                                                       // v-line
    origin := cr_SDP_Origin(p_Username, p_AddrType, p_IPAddrOrigin),             // o-line
    session_name := ?,                                                           // s-line
    information := omit,
    uri := omit,
    emails := omit,
    phone_numbers := omit,
    connection := cr_SDP_Connection(p_AddrType, p_IPAddrConnection) ifpresent,   // c-line
    bandwidth :=  p_Bandwidth,                                                   // b-line
    times := { p_Time },                                                         // t-line
    timezone_adjustments := omit,
    key := omit,
    attributes := omit,
    media_list := p_SDP_Media_Desc_List
  };

}
