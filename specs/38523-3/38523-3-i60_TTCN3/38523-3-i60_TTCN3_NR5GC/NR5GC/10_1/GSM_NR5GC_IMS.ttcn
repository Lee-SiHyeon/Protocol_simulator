module GSM_NR5GC_IMS {

  import from IMS_ASP_TypeDefs all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_Registration all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 10.1.2.3.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_10_1_2_3_NR5GC_IMS1()runs on IMS_PTC
  { //Network-requested PDU session modification / new P-CSCF address / Initial IMS registration
  
    var IMS_DATA_REQ v_IMS_DATA_REQ;
  
    f_IMS_PTC_Init(); // @sic R5s250098 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @sic R5s250098 sic@
    f_IMS_NewPCSCFaddr(IPCAN);
    
    v_IMS_DATA_REQ := f_IMS_Register_NonGIBA(); // @sic R5s250256 sic@
    f_IMS_Register_SubscribeNotify(v_IMS_DATA_REQ, true);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 10");

    // Inform NR: IMS registration done
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS registered on new address"));
    f_IMS_IpcanReleaseWithOptionalDeregistration();  // @sic R5s250256 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 10.1.3.3.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_10_1_3_3_NR5GC_IMS1()runs on IMS_PTC
  { //Network-requested PDU session release / reactivation requested / new P-CSCF address / Initial IMS registration
  
    var IMS_DATA_REQ v_IMS_DATA_REQ;
  
    f_IMS_PTC_Init(PDN_1);   // @sic R5s250189 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    
    // @sic R5s250189 sic@
    f_IMS_NewPCSCFaddr(IPCAN);
    
    v_IMS_DATA_REQ := f_IMS_Register_NonGIBA(); // @sic R5s250241 sic@
    f_IMS_Register_SubscribeNotify(v_IMS_DATA_REQ, true);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Steps 4-11");

    // Inform NR: IMS registration done
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS registered on new address"));
    f_IMS_IpcanReleaseWithOptionalDeregistration();  // @sic R5s250241 sic@
  }

}
