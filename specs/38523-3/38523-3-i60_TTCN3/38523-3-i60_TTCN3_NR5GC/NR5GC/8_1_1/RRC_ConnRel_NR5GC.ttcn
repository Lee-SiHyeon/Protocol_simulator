module RRC_ConnRel_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from IMS_CommonParameters all;
  import from IMS_PTC_CoordMsg all;
  import from IP_PTC_CtrlMsgs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_IMSProcedures all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRC_Templates all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_3_1_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Redirection to another NR frequency
  
    var SubcarrierSpacing v_SubCarrierSpacing_Cell23;
    var ARFCN_ValueNR v_SSB_Freq_Cell23;

    f_NR5GC_Init(NR_4);

    //Create and configure cell
    //Set SIB4 for cell 1  and Cell 23 according to Table 8.1.1.3.1.3.3-1
    v_SSB_Freq_Cell23 := f_NR_CellInfo_GetFrequencySSB(nr_Cell23);
    v_SubCarrierSpacing_Cell23 := f_NR_CellInfo_GetSSB_SCS(nr_Cell23);

    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell1, 0, omit);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell23, 0, omit);

    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell23);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A, PING_Or_TEST_LOOPModeB_ON);//@sic R5-201135 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_1_TestBody(v_SSB_Freq_Cell23, v_SubCarrierSpacing_Cell23);

    f_NR_TestBody_Set(false);

    //if (not pc_IP_Ping) {
      //f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell23);
    //} //@sic R5s200571 sic@,@sic R5s230130 sic@

    f_NR_Postamble(nr_Cell23, STATE_CONNECTED_3A);//@sic R5-201135 sic@
  }

  /*
   * @desc      test body of TC_8_1_1_3_1
   * @param     p_SSB_Freq_Cell23
   * @param     p_SubCarrierSpacing_Cell23
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_1_TestBody(ARFCN_ValueNR p_SSB_Freq_Cell23,
                                    SubcarrierSpacing p_SubCarrierSpacing_Cell23) runs on NR5GC_PTC
  {
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var integer v_DRBId;
    var PDUSessionInfoList_Type v_PDUSessionInfo;
    var NG_NAS_MSG_Indication_Type v_NasInd;

    f_NR_SetCellPower (nr_Cell23, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCRelease message (IE redirectedCarrierInfo including NR Cell 23).
    v_RedirectedCarrierInfo := cs_NR_redirectedCarrierInfo(p_SSB_Freq_Cell23, p_SubCarrierSpacing_Cell23, f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1,nr_Cell23)); // @sic R5s200547 sic@

    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def,-,v_RedirectedCarrierInfo));// @sic R5s200496 sic@

    //@siclog "Step 2A" siclog@
    //@sic R5-202621 sic@
    //Check: Does the UE transmits an RRCConnectionRequest message?
    f_NR_RRC_SetupRequest_Def(nr_Cell23);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2A");

    //@siclog "Step 2B" siclog@
    //@sic R5-202621 sic@
    //SS transmit an RRCConnectionSetup message on on the NGC Cell 23.
    f_NR_RRCSetup_Def (nr_Cell23);

    //@siclog "Step 2C" siclog@
    //@sic R5-202621 sic@
    //Check: Does the UE transmits an RRCConnectionSetupComplete message to confirm the successful completion of the connection establishment and a REGISTRATION REQUEST message indicating "mobility registration updating" is sent to update the registration of the actual tracking area?
    v_NasInd := f_NR_RRCSetupComplete_Def(nr_Cell23,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_NasInd.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2C");

    //@siclog "Step 3-4" siclog@
    //@sic R5-201135 sic@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell23, v_NasInd.SecurityProtection.NasCount);

    //@siclog "Step 5-6" siclog@
    //@sic R5-201135 sic@
    //Steps 4-5 of TS 38.508-1 Table 4.9.5.2.2-1 of the generic procedure are performed.
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell23,
                                          v_GMM_MobilityInfo,
                                          -, -,
                                          noRrcConnectionRelease);

    //@siclog "Step 7-8" siclog@
    //@sic R5-201135 sic@
    //The SS transmits an RRCReconfiguration message to establish SRB2 and DRB.
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR_RRCReconfigExistingDRBs (nr_Cell23,omit);

    //@siclog "Step 9" siclog@
    //@sic R5-201135 sic@
    //Check: Does the test result of generic test procedure in TS 38.508-1[4] subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB#n associated with the first PDU session?
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession();

    v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList();

    f_NR5GC_CheckDataPath(nr_Cell23, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DRBId, "Step 9"); // @sic R5s200571 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_3_3_NR5GC() runs on NR5GC_PTC
  { // RRC connection release / Success / With priority information
  
    //@sic R5-197055 sic@
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierFreqList_Cell1;
    var template (value) InterFreqCarrierFreqList v_InterFreqCarrierFreqList_Cell6;

    f_NR5GC_Init(NR_4);

    //Update SIB1 according to specific message contents
    f_NR_CellInfo_SetTAC (nr_Cell3, int2bit(2,24));
    f_NR_CellInfo_SetTAC (nr_Cell6, int2bit(2,24));

    v_InterFreqCarrierFreqList_Cell1 := f_NR5GC_CellInfo_GetSIB4_InterFreqCarrierFreqList(nr_Cell1);
    v_InterFreqCarrierFreqList_Cell6 := f_NR5GC_CellInfo_GetSIB4_InterFreqCarrierFreqList(nr_Cell6);

    v_InterFreqCarrierFreqList_Cell1[0].cellReselectionPriority := 1;
    v_InterFreqCarrierFreqList_Cell1[1].cellReselectionPriority := 5;

    v_InterFreqCarrierFreqList_Cell6[0].cellReselectionPriority := 4;
    v_InterFreqCarrierFreqList_Cell6[1].cellReselectionPriority := 1;

    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell1, v_InterFreqCarrierFreqList_Cell1);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell6, v_InterFreqCarrierFreqList_Cell6);

    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_T_ReselectionNR(nr_Cell3, 0, 1); // @sic R5-210361 sic@

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);
    f_NR_CellConfig_Def(nr_Cell6);
    
    f_NR5GC_Preamble(nr_Cell1, STATE_CONNECTED_3A, PING_Or_TEST_LOOPModeB_ON); // @sic R5-201136 sic@

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_3_TestBody();

    f_NR_TestBody_Set(false);

    //if (not pc_IP_Ping) { // @sic R5s200492 sic@
      //f_NR5GC_OpenUE_TestLoopMode_Deactivate_TestMode(nr_Cell6);
    //}@sic R5s230130 sic@

    f_NR_Postamble(nr_Cell6, STATE_CONNECTED_3A); // @sic R5s200492 sic@
  }

  /*
   * @desc      test body of TC_8_1_1_3_3
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_3_TestBody() runs on NR5GC_PTC
  {
    //@sic R5-197055 sic@
    var ARFCN_ValueNR v_NRf1_SSB_Cell1;
    var ARFCN_ValueNR v_NRf2_SSB_Cell3;
    var ARFCN_ValueNR v_NRf3_SSB_Cell6;
    var FreqPriorityListNR v_FreqPriorityListNR_Step2;
    var FreqPriorityListNR v_FreqPriorityListNR_Step6;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var PDUSessionInfoList_Type v_PDUSessionInfo; // @sic R5s220423 sic@
    var integer v_DRBId;
    var integer v_WaitTime := 300;
    var float v_WaitForConnectionMin := f_NR_SetTimerToleranceMin(nr_Cell1, rrcTimer, int2float(v_WaitTime));

    v_NRf1_SSB_Cell1 := f_NR_CellInfo_GetFrequencySSB(nr_Cell1);
    v_NRf2_SSB_Cell3 := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
    v_NRf3_SSB_Cell6 := f_NR_CellInfo_GetFrequencySSB(nr_Cell6);

    v_FreqPriorityListNR_Step2 := {
      {
        carrierFreq := v_NRf1_SSB_Cell1,
        cellReselectionPriority := 4,
        cellReselectionSubPriority := omit
      },
      {
        carrierFreq := v_NRf2_SSB_Cell3,
        cellReselectionPriority := 5, // @sic R5-201136 sic@
        cellReselectionSubPriority := omit
      },
      {
        carrierFreq := v_NRf3_SSB_Cell6,
        cellReselectionPriority := 1, // @sic R5-201136 sic@
        cellReselectionSubPriority := omit
      }
    };

    v_FreqPriorityListNR_Step6 := {
      {
        carrierFreq := v_NRf1_SSB_Cell1,
        cellReselectionPriority := 4,
        cellReselectionSubPriority := omit
      }, // @sic R5-201136 sic@
      {
        carrierFreq := v_NRf3_SSB_Cell6,
        cellReselectionPriority := 3,
        cellReselectionSubPriority := omit
      }
    };

    v_CellPowerList_AtT0 := {
      cs_NR_CellPower(nr_Cell3, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
      cs_NR_CellPower(nr_Cell6, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE)
    };

    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell3, -94, -91), // @sic R5-201136, R5-204432 sic@
      cs_NR_CellPower(nr_Cell6, -88, -82)  // @sic R5-201136, R5-204432 sic@
    };

    v_CellPowerList_AtT2 := {
      cs_NR_CellPower(nr_Cell3, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE), // @sic R5s200492, R5-204432 sic@
      cs_NR_CellPower(nr_Cell6, -88, -82)  // @sic R5s200492, R5-204432, R5s201475 sic@
    };

    //@siclog "Step 1" siclog@
    //The SS changes NR Cell 1,NR Cell 3 and NR Cell 6 power level according to the row "T1" in table 8.1.1.3.3.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message including the freqPriorityListNR on NR Cell 1.
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def, -, -, cs_CellReselectionPriorities(-, v_FreqPriorityListNR_Step2)));

    //@siclog "Step 2A" siclog@
    //@sic R5-202622 sic@
    //Check: Does the UE transmits an RRCSetupRequest message on NR Cell3?
    f_NR_RRC_SetupRequest_Def(nr_Cell3);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2A");

    //@siclog "Step 2B" siclog@
    //@sic R5-202622 sic@
    //SS transmit an RRCSetup message on NR Cell3.
    f_NR_RRCSetup_Def(nr_Cell3);

    //@siclog "Step 2C" siclog@
    //@sic R5-202622 sic@
    //Check: Does the UE transmits an RRCSetupComplete message to confirm the successful completion of the connection establishment and a REGISTRATION REQUEST message indicating "mobility registration updating" is sent to update the registration of the actual tracking area?
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(nr_Cell3,
                                               cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                               tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2C");

    //@siclog "Step 3" siclog@
    //@sic R5-201136, R5-202622 sic@
    //Void

    //@siclog "Step 3A - 3B" siclog@
    //@sic R5-201136 sic@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell3, v_ReceivedMsg.SecurityProtection.NasCount); //@sic R5s250465 Ch. 1 sic@

    //@siclog "Step 3C - 3D" siclog@
    //@sic R5-201136 sic@
    //Steps 4-5 of TS 38.508-1 [4] Table 4.9.5.2.2-1 of the generic procedure are performed.
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell3, v_GMM_MobilityInfo, -, -, noRrcConnectionRelease);

    //@siclog "Step 3E - 3F" siclog@
    //@sic R5-201136 sic@
    //The SS transmits an RRCReconfiguration message to establish SRB2 and DRB.
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR_RRCReconfigExistingDRBs (nr_Cell3, omit);

    //@siclog "Step 3G" siclog@
    //@sic R5-201136 sic@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 3?
    v_DRBId := f_NR_GetDefaultDRB_ForFirstPDUSession(); // @sic R5s220423 sic@
    v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList(); // @sic R5s220423 sic@
    f_NR5GC_CheckDataPath(nr_Cell3, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DRBId, "Step 3G"); //@sic R5s250465 Ch. 1 sic@

    //@siclog "Step 3H" siclog@
    //@sic R5-201136 sic@
    //The SS releases RRC connection.
    f_NR_RRCRelease(nr_Cell3);

    //@siclog "Step 4" siclog@
    //The SS changes NR Cell 1,NR Cell 3 and NR Cell 6 power level according to the row "T0" in table 8.1.1.3.3.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    //@siclog "Step 5 - 5B" siclog@
    //@sic R5-201136 sic@
    //Steps 1-3 in TS 38.508-1 [4] Table 4.9.5.2.2-1 are peformed on NR Cell 1.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (nr_Cell1, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Step 5C - 5D" siclog@
    //@sic R5-201136 sic@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell1, v_ReceivedMsg.SecurityProtection.NasCount);

    //@siclog "Step 5E - 5F" siclog@
    //@sic R5-201136 sic@
    //Steps 4-5 of TS 38.508-1 [4] Table 4.9.5.2.2-1 of the generic procedure are performed.
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell1, v_GMM_MobilityInfo, -, -, noRrcConnectionRelease);

    //@siclog "Step 6" siclog@
    //The SS transmits an RRCRelease message containing IE freqPriorityListNR to update the cell reselection priority of NR Cell 6 and the timer T320.
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def, -, -, cs_CellReselectionPriorities(-, v_FreqPriorityListNR_Step6, min5)));

    //@siclog "Step 7" siclog@
    //The SS changes NR Cell 1,NR Cell 3 and NR Cell 6 power level according to the row "T2" in table 8.1.1.3.3.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);

    //@siclog "Step 8" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message within T320 running?
    f_NR_CheckNoRRCSetupReq(nr_Cell6, v_WaitForConnectionMin, -, "Step 8");  //@sic R5s201387 sic@

    //@siclog "Step 9" siclog@
    //@sic R5-201136 sic@
    //Check: After timer T320 expiry, does the UE perform the Registration procedure for mobility registration update as described in steps 1-3 of Table 4.9.5.2.2-1 on NR Cell 6?
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (nr_Cell6, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Step 10 - 11" siclog@
    //@sic R5-201136 sic@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell6, v_ReceivedMsg.SecurityProtection.NasCount);

    //@siclog "Step 12 - 13" siclog@
    //@sic R5-201136 sic@
    //Steps 4-5 of TS 38.508-1 [4] Table 4.9.5.2.2-1 of the generic procedure are performed.
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell6, v_GMM_MobilityInfo, -, -, noRrcConnectionRelease);

    //@siclog "Step 14 - 15" siclog@
    //@sic R5-201136 sic@
    //The SS transmits an RRCReconfiguration message to establish SRB2 and DRB.
    //The UE transmits an RRCReconfigurationComplete message.
    f_NR_RRCReconfigExistingDRBs (nr_Cell6, omit);

    //@siclog "Step 16" siclog@
    //@sic R5-201136 sic@
    //Check: Does the test result of generic test procedure in TS 38.508-1 subclause 4.9.1 indicate that the UE is capable of exchanging IP data on DRB #n associated with the first PDU session on NR Cell 6?
    f_NR5GC_CheckDataPath(nr_Cell6, f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]), dedicatedBearer, v_DRBId, "Step 16"); // @sic R5s200517, R5s220423 sic@

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.7
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_3_7_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Success / Deprioritisation / Frequency / T325 expiry
  
    f_NR5GC_Init(NR_4);

    //Update SIB1 according to specific message contents
    f_NR_CellInfo_SetTAC (nr_Cell3, int2bit(3,24)); // @sic R5-214767 sic@

    //Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -82);  // @sic R5-234558 sic@

    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_7_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A); // @sic R5-214767 sic@
  }

  /*
   * @desc      test body of TC_8_1_1_3_7
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_7_TestBody() runs on NR5GC_PTC
  {
    var template (value) RRCRelease_IEs.deprioritisationReq v_DeprioritisationReq;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var float v_T325 := f_NR_SetTimerToleranceMin(nr_Cell1, rrcTimer, 300.0); // @sic R5s210951 sic@
    var boolean v_FlagCell3 := false;
    timer t_WaitTime;

    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, -85, -82),  // @sic R5-234558 sic@
      cs_NR_CellPower(nr_Cell3, -91, -91)   // @sic R5-234558 sic@
    };

    //@siclog "Step 1" siclog@
    //The SS transmits an RRCRelease message on NR Cell 1 including IE deprioritisationReq.
    v_DeprioritisationReq := cs_NR_DeprioritisationReq(frequency, min5);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, -, -, v_DeprioritisationReq));

    //@siclog "Step 2" siclog@
    //SS starts timer T325.
    t_WaitTime.start(v_T325);

    //@siclog "Step 2A" siclog@
    //The SS adjusts the SS/PBCH EPRE levels according to row "T1" in table 8.1.1.3.7.2-1/2
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    alt {
      //@siclog "Step 3" siclog@
      //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 indicate that the UE is camped on NR Cell 3?
      [not v_FlagCell3] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell3, cr_38508_RRCSetupRequest())))
      {
        f_NR5GC_MobilityRegistration (nr_Cell3);
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");
        v_FlagCell3 := true;
        repeat;
      }
      //@siclog "Step 4" siclog@
      //SS waits for T325 expiry.
      [] t_WaitTime.timeout
      {
        if(v_FlagCell3 == true){
          //@siclog "Step 5" siclog@
          //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 indicate that the UE is camped on NR Cell 1?
          f_NR5GC_MobilityRegistration (nr_Cell1); // @sic R5-214767 sic@
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
        }
        else{
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3: UE did not transmit a RRCSetupRequest message on NR Cell 3 before T325 expiry");
        }
      }
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.7b
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_3_7b_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Success / Deprioritisation / Deletion of Stored deprioritisation request
  
    f_NR5GC_Init(NR_4);

    //Update SIB1 according to specific message contents
    f_NR_CellInfo_SetPLMN(nr_Cell3, tsc_NR_HPLMN_002_11);//PLMN2

    //Set maximum cell power level for the Cells to be used
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell1, -85, -82);  // @sic R5-234558 sic@

    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_7b_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell1, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_8_1_1_3_7b
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_7b_TestBody() runs on NR5GC_PTC
  {
    var template (value) RRCRelease_IEs.deprioritisationReq v_DeprioritisationReq;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var float v_T325 := f_NR_SetTimerToleranceMin(nr_Cell1, rrcTimer, 300.0);
    timer t_WaitTime;

    v_CellPowerList_AtT1 := {
      cs_NR_CellPower(nr_Cell1, -85, -82),  // @sic R5-234558 sic@
      cs_NR_CellPower(nr_Cell3, -91, -91)   // @sic R5-234558 sic@
    };

    //@siclog "Step 1" siclog@
    //The SS adjusts the SS/PBCH EPRE levels according to row "T1" in table 8.1.1.3.7b.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 2" siclog@
    //The SS transmits an RRCRelease message on NR Cell 1 including IE deprioritisationReq.
    v_DeprioritisationReq := cs_NR_DeprioritisationReq(frequency, min5);
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease (tsc_NR_RRC_TI_Def, -, -, -, v_DeprioritisationReq));

    //@siclog "Step 3" siclog@
    //SS starts timer T325.
    t_WaitTime.start(v_T325);

    //@siclog "Step 4" siclog@
    //PLMN2 is manually selected.
    f_UT_ManualPLMN_Select(UT,
                           f_NR_Asn2Nas_PlmnId (f_NR_CellInfo_GetPLMN (nr_Cell3)),
                           -,
                           CNF_REQUIRED);

    //@siclog "Step 5" siclog@
    //The test result of generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 indicate that the UE is camped on NR Cell 3.
    f_NR5GC_MobilityRegistration (nr_Cell3);
    if(not t_WaitTime.running){
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 5: UE did not finish the generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 on NR Cell 3 before T325 expiry");
    }

    //@siclog "Step 6" siclog@
    //PLMN1 is manually selected before T325 expiry.
    f_UT_ManualPLMN_Select(UT,
                           f_NR_Asn2Nas_PlmnId (f_NR_CellInfo_GetPLMN (nr_Cell1)),
                           -,
                           CNF_REQUIRED);

    //@siclog "Step 7" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.5.2.2-1 indicate that the UE is camped on NR Cell 1 before T325 expiry.
    alt {
      [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell1, cr_38508_RRCSetupRequest())))
      {
        t_WaitTime.stop;
        f_NR5GC_MobilityRegistration (nr_Cell1);
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
      }
      [] t_WaitTime.timeout
      {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7: UE did not transmit a RRCSetupRequest message on NR Cell 1 before T325 expiry");
      }
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.8
   * @status    APPROVED (NR5GC)
   */
 function f_TC_8_1_1_3_8_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Redirection to another NR frequency / MPS Priority Indication
    var InterFreqCarrierFreqList v_InterFreqCarrierFreqList_Cell1;
    var InterFreqCarrierFreqList v_InterFreqCarrierFreqList_Cell23;

    f_NR5GC_Init(NR_4);

    v_InterFreqCarrierFreqList_Cell1 := f_NR5GC_CellInfo_GetSIB4_InterFreqCarrierFreqList(nr_Cell1);// @sic R5s240292 sic@
    v_InterFreqCarrierFreqList_Cell23 := f_NR5GC_CellInfo_GetSIB4_InterFreqCarrierFreqList(nr_Cell23);// @sic R5s240292 sic@
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell1, {v_InterFreqCarrierFreqList_Cell1[0]});
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreqList(nr_Cell23, {v_InterFreqCarrierFreqList_Cell23[0]});
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell1, 0, omit);
    f_NR5GC_CellInfo_SetSIB4_InterFreqCarrierFreq_CellReselectionPriority(nr_Cell23, 0, omit);

    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell23);
    
    //The UE is in test state 1N-A with IMS registered as defined in TS 38.508-1 [4], subclause 4.4A.2 on NR Cell 1.
    f_NR5GC_Preamble (nr_Cell1, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_8_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell23, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_8_1_1_3_8
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_8_TestBody() runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var template (omit) GSM_MobilityInfo_Type v_GSM_MobilityInfo;
    var template (value) RedirectedCarrierInfo v_RedirectedCarrierInfo;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;

    // turn on NR cell23
    f_NR_SetCellPower (nr_Cell23, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR1, tsc_NR_SuitableInterFreqCellSSS_EPRE_FR2);

    //@siclog "Step 1" siclog@
    //Make the UE attempt a MMTel voice call.
    f_UT_RequestIMSCall(UT);

    //@siclog "Steps 2-9b4" siclog@
    //Steps2 to 9b4 from test procedure for IMS MO speech call establishment as described in TS 38.508-1 [4] Table 4.9.15.2.2-1 take place.
    v_GSM_MobilityInfo := f_NR5GC_SpeechCall_Steps2_8(nr_Cell1, mo_VoiceCall, '0001'B);

    // Wait until need to add voice QoS
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1], "Add Voice Bearer");//@sic R5s230666 sic@

    //@siclog "Step 10" siclog@
    //The SS transmits an RRCRelease message (IE redirectedCarrierInfo including NR Cell 23 and IE mpsPriorityIndication).
    v_RedirectedCarrierInfo := cs_NR_redirectedCarrierInfo(f_NR_CellInfo_GetFrequencySSB(nr_Cell23), f_NR_CellInfo_GetSSB_SCS(nr_Cell23), f_NR_GetSSB_MTC_InterFreqOdd(nr_Cell1,nr_Cell23));
    SRB.send(cas_NR_SRB1_RrcPdu_REQ(nr_Cell1, cs_TimingInfo_Now, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def,-,v_RedirectedCarrierInfo,-,-,cs_RRCConnectionRelease_All_IEs_v1540(-, cs_RRCRelease_v1610_IEs(cs_RRCRelease_v1650_IEs(true_))))));//@sic R5s230812 sic@

    //@siclog "Step 11" siclog@
    //Check: Does the UE transmit RRCSetupRequest message including the establishmentCause as mps-PriorityAccess on NR cell 23?
    SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell23, cr_38508_RRCSetupRequest(mps_PriorityAccess))));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 8.1.1.3.8 Step 11");

    //@siclog "Step 12-13" siclog@
    //Steps 2 to 3 of generic test procedure in TS 38.508-1[4] Table 4.9.5.2.2-1 are performed on NR Cell 23.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (nr_Cell23, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    //@siclog "Step 14-15" siclog@
    //The SS transmits a SecurityModeCommand message.
    //The UE transmits a SecurityModeComplete message.
    f_NR_RRC_ActivateSecurity (nr_Cell23, v_ReceivedMsg.SecurityProtection.NasCount);

    //@siclog "Step 16-17" siclog@
    //Steps 4 to 5 of generic test procedure in TS 38.508-1[4] Table 4.9.5.2.2-1 are performed on NR Cell 23.
    f_NR5GC_MobilityRegistration_Steps4_6(nr_Cell23, v_GMM_MobilityInfo,-,-,noRrcConnectionRelease);
    f_IP_ChangeNrCell(IP, nr_Cell23);//@sic R5s230666 sic@

    //@siclog "Step 18-19" siclog@
    //The SS transmits an RRCReconfiguration message to establish SRB2 and DRB.
    //The UE transmits anRRCReconfigurationComplete message.
    f_NR_RRCReconfigExistingDRBs (nr_Cell23, omit);

    //@siclog "Step 20-24b3" siclog@
    //Step 9 to 13b3 of IMS MO speech call establishment in 5GC as defined in TS 38.508-1 [4] Table 4.9.15.2.2-1 are performed.
    // done on IMS PTC
    f_NR5GC_ModifyPDUSession_AddVoice(nr_Cell23, valueof(v_GSM_MobilityInfo));//@sic R5s230666 sic@
     if (not pc_Preconditions) {
      f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1], cms_IMS_IPCAN_Trigger("Voice Bearer Added"));
    }
    // Call now established
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1], "Voice Call Established");

    //@siclog "Step 25" siclog@
    //The generic test procedure for IMS MT call release in 5GC as specified in TS 38.508-1 [4]Table 4.9.18.2.2-1 takes place.
    f_NR5GC_CallRelease(nr_Cell23, IPCAN_SpeechCall, false);

    //@siclog "Step 26" siclog@
    //The SS transmits an RRCRelease message.
    f_NR_RRCRelease(nr_Cell23);

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.9
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_1_3_9_NR5GC() runs on NR5GC_PTC
  { //RRC connection release / Success / With slice specific cell reselection information
    f_NR5GC_Init(NR_30);

    //Preconfigure SIB16 for NR Cell 3: Table 8.1.1.3.9.3.3-2
    f_NR_CellInfo_SetSIB16_FreqPriorityListSlicing_r17(nr_Cell3, {cs_FreqPrioritySlicing_r17_Def(0,
                                                                                                 {cs_SliceInfo_r17_1Entry('00000010'B,5)}),
                                                                  cs_FreqPrioritySlicing_r17_Def(2,
                                                                                                 {cs_SliceInfo_r17_1Entry('00000010'B,4)})});
    //Preconfigure SIB16 for NR Cell 6: Table 8.1.1.3.9.3.3-2A
    f_NR_CellInfo_SetSIB16_FreqPriorityListSlicing_r17(nr_Cell6, {cs_FreqPrioritySlicing_r17_Def(0, {cs_SliceInfo_r17_1Entry('00000010'B,5)})});//@sic R5s240132 sic@

    f_NR_CellInfo_InitMaxReferencePower(nr_Cell3, -78, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_CellInfo_InitMaxReferencePower(nr_Cell6, -78, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell3);
    f_NR_CellConfig_Def(nr_Cell6);
    
    //The UE is in state Switched OFF (state 0N-B) according to TS 38.508-1 [4].
    f_NR5GC_Preamble (nr_Cell1, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_8_1_1_3_9_TestBody();

    f_NR_TestBody_Set(false);

    f_NR_Postamble(nr_Cell6, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_8_1_1_3_9
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_1_1_3_9_TestBody() runs on NR5GC_PTC
  {
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT0;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT1;
    var template (value) NR_CellPowerList_Type v_CellPowerList_AtT2;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var boolean v_IsFR1 := f_NR_CellInfo_GetIsFR1(nr_Cell1);
    var PLMN_Identity v_ASN_PLMN;
    var NAS_PlmnId v_PLMN;
    var NG_NAS_GutiParameters_Type v_GutiParams;
    var template (value) NG_MobileIdentity v_GUTIToSend;
    var TrackingAreaCode v_TAC;
    var template (value) NG_TrackingAreaIdList v_TAIList;
    var ARFCN_ValueNR v_SSB_Freq_Cell1 := f_NR_CellInfo_GetFrequencySSB(nr_Cell1);
    var ARFCN_ValueNR v_SSB_Freq_Cell3 := f_NR_CellInfo_GetFrequencySSB(nr_Cell3);
    var ARFCN_ValueNR v_SSB_Freq_Cell6 := f_NR_CellInfo_GetFrequencySSB(nr_Cell6);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NSAG_Info v_NsagInfo;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var template (value) CellReselectionPriorities.freqPriorityListDedicatedSlicing_r17 v_FreqPriorityListDedicatedSlicing_Step20;
    var template (value) CellReselectionPriorities.freqPriorityListDedicatedSlicing_r17 v_FreqPriorityListDedicatedSlicing_Step30;
    var template (value) NSSAI_LV v_NSSAI_1 := cs_NSSAI_LV('04'O, {cs_S_NSSAI_SST1eMBB, cs_S_NSSAI_SST2_URLLC});
    var template (value) NSSAI_LV v_NSSAI_2 := cs_NSSAI_LV('04'O, {cs_S_NSSAI_SST3_MIoT, cs_S_NSSAI_SST4_V2X});


    v_CellPowerList_AtT0 := {
        cs_NR_CellPower(nr_Cell1, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2)
    };

    v_CellPowerList_AtT1 := {
        cs_NR_CellPower(nr_Cell3, -78, tsc_NR_ServingCellSSS_EPRE_FR2)
    };

    v_CellPowerList_AtT2 := {
        cs_NR_CellPower(nr_Cell1, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE),
        cs_NR_CellPower(nr_Cell3, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_SuitableIntraFreqCellSSS_EPRE_FR2),
        cs_NR_CellPower(nr_Cell6, -78, tsc_NR_ServingCellSSS_EPRE_FR2)
    };

    //Set NR Cell 1 SS levels according to the row "T0"
    f_NR_SetCellPowerList(v_CellPowerList_AtT0);

    //@siclog "Step 1" siclog@
    //The UE is switched on.
    f_UT_SwitchOnUE(UT);

    //@siclog "Steps 2-13" siclog@
    //Steps 2 to 13 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (nr_Cell1, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo,
                                nr_Cell1, v_ReceivedMsg,
                                f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell1)),
                                TESTMode_OFF,
                                Initial_Secure);

    //@siclog "Step 14" siclog@
    //The SS transmits a REGISTRATION ACCEPT message.
    v_ASN_PLMN := f_NR_CellInfo_GetPLMN (nr_Cell1);
    v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (nr_Cell1);
    v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (v_PLMN, v_GutiParams);
    v_TAC := f_NR_CellInfo_GetTAC (nr_Cell1);
    v_TAIList := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC)});
      
    v_NsagInfo := cs_NSAG_2Elements(valueof(cs_NSAG_InfoElement('01'O,v_NSSAI_1,'03'O,valueof(v_TAIList.lvPart))),
                                    valueof(cs_NSAG_InfoElement('02'O,v_NSSAI_2,'02'O,valueof(v_TAIList.lvPart))));

    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Initial_Secure,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   omit,
                                                   -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, v_NsagInfo);
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell1, tsc_NR_RbId_SRB1, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));
   
    //@siclog "Step 15-19Aa2" siclog@
    //Steps 15 to 19Aa2 of the generic procedure for NR RRC_IDLE specified in TS 38.508-1 subclause 4.5.2 are performed.
    f_NR5GC_RRC_Idle_Steps15_20(nr_Cell1, TESTMode_OFF, noRrcConnectionRelease);

    //@siclog "Step 20" siclog@
    //The SS transmits an RRCRelease message including the nsag-CellReselectionPriority on NR Cell 1.
    v_FreqPriorityListDedicatedSlicing_Step20 := {
      {
        dl_ExplicitCarrierFreq_r17 := v_SSB_Freq_Cell1,
        sliceInfoListDedicated_r17 := {
          {
            nsag_IdentityInfo_r17 :=  {
              nsag_ID_r17 := '00000001'B,
              trackingAreaCode_r17 := omit
            },
            nsag_CellReselectionPriority_r17 := 6,
            nsag_CellReselectionSubPriority_r17 := omit
          }
        }
      },
      {
        dl_ExplicitCarrierFreq_r17 := v_SSB_Freq_Cell3,
        sliceInfoListDedicated_r17 := {
          {
            nsag_IdentityInfo_r17 :=  {
               nsag_ID_r17 := '00000010'B,
              trackingAreaCode_r17 := omit
            },
            nsag_CellReselectionPriority_r17 := 5,
            nsag_CellReselectionSubPriority_r17 := omit
          }
        }
      }
    }
    f_NR_RRCRelease_Common(nr_Cell1, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def, -, -, cs_CellReselectionPriorities(-, -, -, v_FreqPriorityListDedicatedSlicing_Step20)));
    
    //@siclog "Step 21" siclog@
    //The SS changes NR Cell 3 and NR Cell 6 SSS levels according to the row "T1" in table 8.1.1.3.9.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT1);

    //@siclog "Step 22" siclog@
    //Wait for 66[FR1]/258[FR2] seconds to allow UE to recognise the change.
    if (v_IsFR1) {
       f_Delay(66.0);
    }
    else{
       f_Delay(258.0);
    }

    //@siclog "Step 23" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.4.2.2-1 indicate that the UE is camped on NR Cell 3?
    //@siclog "Step 24-29" siclog@
    //Steps 3 to 8 ofthe generic procedureinTS 38.508-1 [4] Table 4.9.4.2.2-1 are performed.
    f_NR5GC_CheckRRCIdle(nr_Cell3,noRrcConnectionRelease);

    //@siclog "Step 30" siclog@
    //The SS transmits an RRCRelease message including the nsag-CellReselectionPriority on NR Cell 3.
    v_FreqPriorityListDedicatedSlicing_Step30 := {
      {
        dl_ExplicitCarrierFreq_r17 := v_SSB_Freq_Cell3,
        sliceInfoListDedicated_r17 := {
          {
            nsag_IdentityInfo_r17 :=  {
              nsag_ID_r17 := '00000010'B,
              trackingAreaCode_r17 := omit
            },
            nsag_CellReselectionPriority_r17 := 4,
            nsag_CellReselectionSubPriority_r17 := omit
          }
        }
      },
      {
        dl_ExplicitCarrierFreq_r17 := v_SSB_Freq_Cell6,
        sliceInfoListDedicated_r17 := {
          {
            nsag_IdentityInfo_r17 :=  {
              nsag_ID_r17 := '00000010'B,
              trackingAreaCode_r17 := omit
            },
            nsag_CellReselectionPriority_r17 := 5,
            nsag_CellReselectionSubPriority_r17 := omit
          }
        }
      }
    }
    f_NR_RRCRelease_Common(nr_Cell3, cs_38508_RRCRelease(tsc_NR_RRC_TI_Def, -, -, cs_CellReselectionPriorities(-, -, -, v_FreqPriorityListDedicatedSlicing_Step30)));
    
    //@siclog "Step 31" siclog@
    //The SS changes NR Cell 1 and NR Cell 6 SSS levels according to the row "T2" in table 8.1.1.3.9.3.2-1/2.
    f_NR_SetCellPowerList(v_CellPowerList_AtT2);

    //@siclog "Step32" siclog@
    //Wait for 34[FR1]/130[FR2] seconds to allow UE to recognise the change.
    if (v_IsFR1) {
       f_Delay(34.0);
    }
    else{
       f_Delay(130.0);
    }

    //@siclog "Step33" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.4.2.2-1 indicate that the UE is camped on NR Cell 6?
    f_NR5GC_CheckRRCIdle(nr_Cell6);

  }

}
