  /*
   * @desc      REFERENCE TS 34.229-1 clause 8.1.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_8_1_NR5GC_IMS1() runs on IMS_XCAP_PTC
  { // Originating Identification Presentation / Configuration / 5GS

    f_IMS_CC_Preamble(IPCAN_XCAP, IMS_REGISTERED);

    // @siclog "Step 1 - 4" siclog@
    f_IMS_XCAP_OIP(gbaPreferred);

    f_IMS_CC_Postamble(IPCAN_XCAP_Signalling);
  }

