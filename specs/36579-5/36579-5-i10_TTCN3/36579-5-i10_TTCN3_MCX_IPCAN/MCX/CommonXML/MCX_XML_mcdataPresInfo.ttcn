module MCX_XML_mcdataPresInfo {

  import from CommonDefs all;
  import from MCX_CommonDefs all;
  import from MCX_Parameters all;
  import from MCX_XML_Encryption all;
  import from XSD all;
  import from urn_3gpp_ns_mcdataPresInfo_1_0 language "XSD" all;

  type urn_3gpp_ns_mcdataPresInfo_1_0.Affiliation MCData_Affiliation_Type;                      /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcdataPresInfo_1_0.StatusType MCData_Affiliation_Status_Type;                /* @status    APPROVED (MCX) */

  type urn_3gpp_ns_mcdataPresInfo_1_0.P_id MCData_P_id_Type;                                    /* @status    APPROVED (MCX) */

  template (present) MCData_Affiliation_Type cr_MCData_Affiliation(XSD.AnyURI p_Group := px_MCData_Group_A_ID,
                                                                   template MCData_Affiliation_Status_Type p_Status := omit) :=
  { // Affilation according to 36.579-1 Table 5.5.3.5.1-1
    /* @status    APPROVED (MCX) */
    client := omit,
    expires := omit,
    group_ :=  p_Group,
    status := p_Status,
    attr := omit,
    elem_list := {}
  };

  template (value) MCData_Affiliation_Type cs_MCData_Affiliation(template (omit) XSD.AnyURI p_Client := omit,
                                                                 template (omit) XSD.DateTime p_Expires := omit,
                                                                 template (omit) XSD.AnyURI p_Group := omit,
                                                                 template (omit) MCData_Affiliation_Status_Type p_Status := omit) :=
  { // Affilation according to 36.579-1 Table 5.5.3.5.2-1
    /* @status    APPROVED (MCX) */
    client := p_Client,
    expires := p_Expires,
    group_ :=  p_Group,
    status := p_Status,
    attr := omit,
    elem_list := {}
  };

  /*
   * @desc      encode MCData Affiliation
   * @param     p_Affiliation
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function fl_MCData_Affiliation_Encode(template (value) urn_3gpp_ns_mcdataPresInfo_1_0.Affiliation p_Affiliation) return XSD.String
  {
    var bitstring v_EncodedAffiliation := encvalue(p_Affiliation);
    return f_Bit2XmlBody(v_EncodedAffiliation);
  }

  /*
   * @desc      Encrypt and encode MCData Affiliation
   * @param     p_Affiliation
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCData_Affiliation_EncryptEncode(template (value) MCData_Affiliation_Type p_Affiliation,
                                              charstring p_MCServiceID,
                                              template (omit) MCX_SecurityKey_Type p_CSK) return XSD.String
  {
    var template (value) MCData_Affiliation_Type v_Affiliation := p_Affiliation;

    v_Affiliation.client := f_MCX_XML_EncryptOptionalAttributeUri(v_Affiliation.client, p_MCServiceID, p_CSK);
    v_Affiliation.group_ := f_MCX_XML_EncryptOptionalAttributeUri(v_Affiliation.group_, p_MCServiceID, p_CSK);

    return fl_MCData_Affiliation_Encode(v_Affiliation);
  }

  /*
   * @desc      Encode MCData P-Id
   * @param     p_P_id
   * @return    XSD.String
   * @status    APPROVED (MCX)
   */
  function f_MCData_Affiliation_P_id_Encode(template (value) urn_3gpp_ns_mcdataPresInfo_1_0.P_id p_P_id) return XSD.String
  {
    var bitstring v_EncodedP_id := encvalue(p_P_id);
    return f_Bit2XsdString(v_EncodedP_id);
  }

  /*
   * @desc      Decrypt MCData Affiliation
   * @param     p_Affiliation
   * @param     p_MCServiceID
   * @param     p_CSK
   * @return    template (value) MCData_Affiliation_Type
   * @status    APPROVED (MCX)
   */
  function f_MCData_Affiliation_Decrypt(MCData_Affiliation_Type p_Affiliation,
                                        charstring p_MCServiceID,
                                        template (omit) MCX_SecurityKey_Type p_CSK) return template (value) MCData_Affiliation_Type
  {
    var template (value) MCData_Affiliation_Type v_Affiliation := p_Affiliation;

    v_Affiliation.client := f_MCX_XML_DecryptOptionalAttributeUri(v_Affiliation.client, p_MCServiceID, p_CSK);
    v_Affiliation.group_ := f_MCX_XML_DecryptOptionalAttributeUri(v_Affiliation.group_, p_MCServiceID, p_CSK);

    return v_Affiliation;
  }

}
