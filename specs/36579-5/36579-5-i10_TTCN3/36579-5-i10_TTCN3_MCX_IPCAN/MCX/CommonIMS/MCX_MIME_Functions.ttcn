  /*
   * @desc      Get body part for PIDF, decode and match the PIDF
   * @param     p_MIME_Message
   * @param     p_PIDF
   * @param     p_ServiceType
   * @param     p_MCServiceID
   * @param     p_CSK               (default value: omit)
   * @return    template (omit) MCX_PIDF_Type
   * @status    APPROVED (MCX)
   */
  function fl_MIME_DecodeAndMatchPIDF(MIME_Message p_MIME_Message,
                                      template MCX_PIDF_Type p_PIDF,
                                      MCX_ServiceType_Type p_ServiceType,
                                      charstring p_MCServiceID,
                                      template (omit) MCX_SecurityKey_Type p_CSK := omit) runs on IMS_PTC return template (omit) MCX_PIDF_Type
  {
    var boolean v_IsRequired := ispresent(p_PIDF);
    var template (omit) MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, tsc_MimeType_Pidf, v_IsRequired);  // => fail/inconc if MIME part is not there but required
    var XmlBody v_XmlBody;
    var MCX_PIDF_Type v_PIDF;

    if (isvalue(v_MIME_Part)) {
      v_XmlBody := valueof(v_MIME_Part.body.xmlBody);

      select (p_ServiceType) {
        case (MCPTT) {
          v_PIDF := f_MCPTT_PIDF_DecodeDecrypt(v_XmlBody, p_MCServiceID, p_CSK);
        }
        case (MCVideo) {
          v_PIDF := f_MCVideo_PIDF_DecodeDecrypt(v_XmlBody, p_MCServiceID, p_CSK);
        }
        case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
          v_PIDF := f_MCData_PIDF_DecodeDecrypt(v_XmlBody, p_MCServiceID, p_CSK);
        }
        case else {
          FatalError(__FILE__, __LINE__, "Invalid service type");
        }
      }

      if (not match(v_PIDF, p_PIDF)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid PIDF affiliation in MIME body");
      }
      return v_PIDF;
    }
    return omit;
  }

  /*
   * @desc      Get body part for affiliation command, decode and match the affiliation command
   * @param     p_ServiceType
   * @param     p_MIME_Message
   * @param     p_AffiliationCmd
   * @return    template (omit) MCX_Affiliation_CommandList_Type
   * @status    APPROVED (MCX)
   */
  function fl_MIME_DecodeAndMatchAffiliationCmd(MCX_ServiceType_Type p_ServiceType,
                                                MIME_Message p_MIME_Message,
                                                template MCX_Affiliation_CommandList_Type p_AffiliationCmd) runs on IMS_PTC return template (omit) MCX_Affiliation_CommandList_Type
  {
    var boolean v_IsRequired := ispresent(p_AffiliationCmd);
    var template (omit) MIME_Part v_MIME_Part;
    var charstring v_TypeAndSubtype;
    var XmlBody v_XmlBody;
    var MCX_Affiliation_CommandList_Type v_AffiliationCmd;

    select (p_ServiceType) {
      case (MCPTT) {
        v_TypeAndSubtype := tsc_MimeType_McpttAffiliationCommand;
      }
      case (MCVideo) {
        v_TypeAndSubtype := tsc_MimeType_McvideoAffiliationCommand;
      }
      case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
        v_TypeAndSubtype := tsc_MimeType_McdataAffiliationCommand;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid service type");
      }
    }

    v_MIME_Part := f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, v_TypeAndSubtype, v_IsRequired);  // => fail/inconc if MIME part is not there but required

    if (isvalue(v_MIME_Part)) {
      v_XmlBody := valueof(v_MIME_Part.body.xmlBody);
      v_AffiliationCmd := f_MCX_AffiliationCommand_Decode(v_XmlBody);
      if (not match(v_AffiliationCmd, p_AffiliationCmd)) {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid affiliation command in MIME body");
      }
      return v_AffiliationCmd;
    }
    return omit;
  }

