  };

  template (present) AcceptContact cr_AcceptContact_Common(template (present) AcRcValue_List p_AcValues) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
