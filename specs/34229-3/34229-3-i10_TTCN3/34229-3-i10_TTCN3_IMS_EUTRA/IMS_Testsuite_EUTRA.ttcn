  control {
    if (f_IMS_SelectionExpr(IMS34_C151))                { execute(TC_10_1()); }
    if (f_IMS_SelectionExpr(IMS34_C151))                { execute(TC_11_1()); }
    if (f_IMS_SelectionExpr(IMS34_C17))                 { execute(TC_11_2()); }
    if (f_IMS_SelectionExpr(IMS34_C160))                { execute(TC_12_12()); }
    if (f_IMS_SelectionExpr(IMS34_C27))                 { execute(TC_12_13()); }
    if (f_IMS_SelectionExpr(IMS34_C27))                 { execute(TC_12_13a()); }
    if (f_IMS_SelectionExpr(IMS34_C160))                { execute(TC_12_2()); }
    if (f_IMS_SelectionExpr(IMS34_C71))                 { execute(TC_12_21()); }
    if (f_IMS_SelectionExpr(IMS34_C70))                 { execute(TC_12_22()); }
    if (f_IMS_SelectionExpr(IMS34_C83))                 { execute(TC_12_23()); }
    if (f_IMS_SelectionExpr(IMS34_C83))                 { execute(TC_12_24()); }
    if (f_IMS_SelectionExpr(IMS34_C83))                 { execute(TC_12_25()); }
    if (f_IMS_SelectionExpr(IMS34_C83))                 { execute(TC_12_26()); }
    if (f_IMS_SelectionExpr(IMS34_C160))                { execute(TC_12_2a()); }
