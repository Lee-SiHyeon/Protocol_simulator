module IMS_Procedures_CallControlCommon {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_IP_Config all;
  import from IMS_Procedures_Common all;
  import from IMS_SDP_Templates all;
  import from IMS_SIP_Templates all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;

  type record IMS_InviteRequestWithSdp_Type {       /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
                                                       @sic R5w140112: new type sic@ */
    IMS_RoutingInfo_Type        RoutingInfo,
    INVITE_Request              Invite,
    SDP_Message                 SdpOffer  optional
  };

  /*
   * @desc      build-up IMS_InviteRequestWithSdp_Type
   * @param     p_IMS_DATA_REQ
   * @param     p_SdpOffer
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_InviteRequestWithSdpMO(IMS_DATA_REQ p_IMS_DATA_REQ,
                                        SDP_Message p_SdpOffer) return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    
    v_InviteRequestWithSdp.RoutingInfo := p_IMS_DATA_REQ.RoutingInfo;
    v_InviteRequestWithSdp.Invite := p_IMS_DATA_REQ.Request.Invite;
    v_InviteRequestWithSdp.SdpOffer := p_SdpOffer;
    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      build-up IMS_InviteRequestWithSdp_Type
   * @param     p_InviteRequest
   * @param     p_SdpOffer          (default value: omit)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_InviteRequestWithSdpMT(template (value) INVITE_Request p_InviteRequest,
                                        template (omit) SDP_Message p_SdpOffer := omit) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var template (value) IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    
    v_InviteRequestWithSdp.RoutingInfo := cs_IMS_RoutingInfo(v_Protocol);
    v_InviteRequestWithSdp.Invite := p_InviteRequest;
    v_InviteRequestWithSdp.SdpOffer := p_SdpOffer;

    return valueof(v_InviteRequestWithSdp);
  }

  type record IMS_ResponseWithSdp_Type {            /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
                                                       @sic R5w140112: new type sic@ */
    IMS_Response_Type           Response,
    SDP_Message                 SdpMessage  optional
  };

  template (value) IMS_ResponseWithSdp_Type cs_IMS_ResponseWithSdp(template (value) IMS_Response_Type p_Response,
                                                                   template (omit) SDP_Message p_SDP_Message) :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    Response := p_Response,
    SdpMessage := p_SDP_Message
  };

  type record IMS_SDP_AudioCodecInfo_Type
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    IMS_SDP_AudioCodec_Type Codec,
    charstring Fmt
  };

  /*
   * @desc      Function to get the AudioCodec information on a Emergency Call
   *            p_AudioCodecList specifies the set of codecs of which at least one codec shall be contained in the SDP offer
   * @param     p_InitialSdpOffer
   * @param     p_AudioCodecList
   * @return    IMS_SDP_AudioCodecInfo_Type
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_SDP_GetAudioCodecInfo(SDP_Message p_InitialSdpOffer,
                                       IMS_SDP_AudioCodecList_Type p_AudioCodecList) runs on IMS_PTC return IMS_SDP_AudioCodecInfo_Type
  {
    var template SDP_attribute_fmtp_format_specific_params v_FmtpParametersForAMR := omit;  // => fmtp is not checked
    var SDP_media_desc v_SDP_Media_Audio := p_InitialSdpOffer.media_list[0];
    var IMS_SDP_AudioCodec_Type v_AudioCodec;
    var charstring v_FmtAudio;
    var integer i;

    for (i := 0; i < lengthof(p_AudioCodecList); i := i + 1) {
      v_AudioCodec := p_AudioCodecList[i];
      select (v_AudioCodec) {
        case (EVS_16000) { v_FmtAudio := f_SDP_MediaDescr_GetAudioCodec(v_SDP_Media_Audio, v_AudioCodec); }                // @sic R5-223392 sic@
        case (AMR_16000) { v_FmtAudio := f_SDP_MediaDescr_GetAMR_WB_16000_1(v_SDP_Media_Audio, v_FmtpParametersForAMR); }  /* @sic R5-134795 sic@ @sic R5-171511: AMR/8000 and/or AMR-WB/16000 sic@ */
        case (AMR_8000)  { v_FmtAudio := f_SDP_MediaDescr_GetAMR_8000_1(v_SDP_Media_Audio, v_FmtpParametersForAMR); }      /* @sic R5-171511: AMR/8000 and/or AMR-WB/16000 sic@ */
      }
      if (v_FmtAudio != "") {
        return {v_AudioCodec, v_FmtAudio};
      }
    }
    f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "no appropriate AMR codec found in given media description");
    return {v_AudioCodec, v_FmtAudio};  // dummy statement
  }

  /*
   * @desc      return true when the given INVITE is MO in which case it does not contain a record route (yet)
   * @param     p_InviteRequest
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function fl_IMS_InviteRequestIsMO(template (value) INVITE_Request p_InviteRequest) return boolean
  {
    return not ispresent(p_InviteRequest.msgHeader.recordRoute.routeBody);
  }

  /*
   * @desc      returns expected route-set depending on whether the dialog is MO or MT
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_DialogIndex       (default value: omit)
   * @return    template (present) RouteBody_List
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_Request_RouteSet_RouteBodyList_RX(IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                   template (omit) IMS_PTC_DialogIndex_Type p_DialogIndex := omit) runs on IMS_PTC return template (present) RouteBody_List
  { /* @sic R5s150692 change 6: parameter p_CallType sic@ */
    var template (present) RouteBody_List v_RouteBodyList := {};

    if (f_IMS_PTC_ImsInfo_DialogIsMO(p_DialogIndex)) {          /* MO call: route set as for the 183 response (in reverse order) */
      v_RouteBodyList := f_IMS_RouteSet_ReverseOrder(f_IMS_RouteSet_MO_Call_TX(p_CallType)); /* @sic R5s150692 change 6 sic@ */
    } else {                                                    /* MT call: route set as in Record-Route header field of the INVITE (A.2.9) */
      v_RouteBodyList := f_IMS_RouteSet_MT_Call_TX(p_CallType); /* @sic R5-251276: use of p_CallType for MT call too (PSAP callback) sic@ */
    }
    return v_RouteBodyList;
  }

  /*
   * @desc      returns given RecordRoute but with address information of the first entry being set to ?
   *            this is needed as the first entry may be the IP address of the P-CSCF which may be represented differently
   * @param     p_Invite_RecordRoute
   * @return    template RecordRoute
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_RecordRoute_AsInInvite_RX(template (omit) RecordRoute p_Invite_RecordRoute) return template RecordRoute
  {
    var template RecordRoute v_RecordRoute := omit;
    
    if (ispresent(p_Invite_RecordRoute)) {
      v_RecordRoute := p_Invite_RecordRoute;
      v_RecordRoute.routeBody[0].nameAddr.addrSpec.components := ?;       /* as the PCSCF address may be an IPv6 address in may be represented differently by the UE than sent to the UE
                                                                             the address needs to be checked explicitly after receiving (@sic R5s150039 sic@) */
    }
    return v_RecordRoute;
  }

  /*
   * @desc      add sigcomp parameter if required
   * @param     p_Via
   * @return    template (value) Via
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_Via_AddSigCompParam(template (omit) Via p_Via) runs on IMS_PTC return template (value) Via
  { /* @sic R5w210206: via optional in MessageHeader => p_ViaRequest: template (omit) sic@ */
    var template (value) Via v_Via := valueof(p_Via);   // @sic R5w210206: valueof to avaoid compiler warnings sic@
    var template (value) ViaBody v_ViaBody := v_Via.viaBody[0];
    var template (omit) SemicolonParam_List v_ViaParams;
    var integer v_ParamsCnt;

    if (not f_IMS_PTC_ImsInfo_SigCompStarted()) {
      return v_Via;
    }
    v_ViaParams := v_ViaBody.viaParams;
    if (not isvalue(v_ViaParams)) {
      v_ParamsCnt := 0;
    } else {
      if (match(valueof(v_ViaParams), cr_SigCompParam)) {   // SigComp param is already included
        return v_Via;
      }
      v_ParamsCnt := lengthof(v_ViaParams);
    }
    v_ViaParams[v_ParamsCnt] := cs_SigCompParam;
    v_Via.viaBody[0].viaParams := v_ViaParams;
    return v_Via;
  }

  /*
   * @desc      return Via as received in previous INVITE
   * @param     p_InviteVia
   * @return    template (present) Via
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_Via_AsInPrevInvite(template (omit) Via p_InviteVia) return template (present) Via
  { /* @sic R5w210206: via optional in MessageHeader => p_ViaRequest: template (omit) sic@ */
    var template (present) charstring v_Protocol := ("UDP", "TCP");  // @sic R5s130586 change 7 sic@
    var HostPort v_SentBy := valueof(p_InviteVia.viaBody[0].sentBy); // @sic R5w210206: via optional in MessageHeader => valueof to avaoid compiler warnings sic@
    return cr_ViaDef(v_Protocol, v_SentBy);
  }

  /*
   * @desc      function to exchange the via-branch for all via-bodies in the given Via header;
   *            the via-branch is assumed to be the first parameter in the via-body's parameter list
   * @param     p_Via
   * @return    template (value) Via
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_ViaRefreshBranches(template (value) Via p_Via) runs on IMS_PTC return template (value) Via
  {
    var template (value) Via v_Via := p_Via;
    var integer v_BodyCount := lengthof(v_Via.viaBody);
    var template (value) ViaBody v_ViaBody;
    var template (omit) SemicolonParam_List v_ViaParams;
    var integer i;

    for (i:=0; i < v_BodyCount; i:=i+1) {
      v_ViaBody := v_Via.viaBody[i];
      v_ViaParams := v_ViaBody.viaParams;
      if (not ispresent(v_ViaParams[0]) or not match(valueof(v_ViaParams[0]), cr_GenericParam_Common(c_branchId, *))) {
        FatalError(__FILE__, __LINE__, "given Via has no branch parameter");
      }
      v_ViaParams[0] := cs_GenericParam(c_branchId, f_IMS_PTC_ImsInfo_GetNextBranch());
      v_ViaBody.viaParams := v_ViaParams;
      v_Via.viaBody[i] := v_ViaBody;
    }
    return v_Via;
  }

  /*
   * @desc      100 Trying for INVITE (see TS 34.229, A.2.2)
   *            NOTE: acc. to A.2.2 there is no Session-ID in this message
   * @param     p_InviteRequest
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_InviteResponse_100_MessageHeaderTX(INVITE_Request p_InviteRequest) return template (value) MessageHeader
  {
    var MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (value) MessageHeader v_MessageHeader_Response := cs_MessageHeader_Dummy;

    v_MessageHeader_Response.via             := v_MessageHeader_Invite.via;
    v_MessageHeader_Response.fromField       := v_MessageHeader_Invite.fromField;
    v_MessageHeader_Response.toField         := cs_ToDef(f_Addr_Union_GetSipUrl(v_MessageHeader_Invite.toField.addressField));
    v_MessageHeader_Response.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Response.cSeq            := v_MessageHeader_Invite.cSeq;

    return v_MessageHeader_Response;
  }

  /*
   * @desc      100 Trying for INVITE (see TS 34.229, A.2.2)
   * @param     p_MessageHeader_Invite
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_InviteResponse_100_MessageHeaderRX(template (value) MessageHeader p_MessageHeader_Invite) return template (present) MessageHeader
  { /* NOTE: acc. to A.2.2 there is no Session-ID in this message */
    const boolean tsc_Is100Response := true;
    var template (present) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderRX(p_MessageHeader_Invite, tsc_Is100Response);     /* @sic R5s200000: f_IMS_BaseResponse_MessageHeaderRX sic@ */

    return v_MessageHeader_Response;
  }

  /*
   * @desc      common 4XX response to INVITE (e.g. 487 Request Terminated (see TS 34.229, A.2.16)
   * @param     p_MessageHeader_Request
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_IRAT, MCX)
   */
  function f_IMS_InviteResponse_4XX_MessageHeaderRX(template (value) MessageHeader p_MessageHeader_Request) return template (present) MessageHeader
  { /* @sic R5-174544: SessionId removed sic@ */
    var template (present) MessageHeader v_MessageHeader_Response := f_IMS_BaseResponse_MessageHeaderRX(p_MessageHeader_Request);     /* @sic R5s200000: f_IMS_BaseResponse_MessageHeaderRX sic@ */
    return v_MessageHeader_Response;
  }

  /*
   * @desc      common INVITE acc. to condition A4 - INVITE creating a dialog, or A5 - re-INVITE within a dialog (see TS 34.229, A.2.9)
   *            function can also be used for MCX
   * @param     p_OptionTagsForSupported (default value: tsc_OptionTagList_Invite_C11)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_NonDefaultFromUrl (default value: omit)
   * @param     p_NonDefaultToUrl   (default value: omit)
   * @param     p_CallerHostPort    (default value: cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort))
   * @param     p_CSeqValue         (default value: 4711)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_InviteRequest_MessageHeaderTX_Common(OptionTag_List p_OptionTagsForSupported := tsc_OptionTagList_Invite_C11,
                                                      boolean p_IsReInvite := false,
                                                      IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                      template (omit) SipUrl p_NonDefaultFromUrl := omit,
                                                      template (omit) SipUrl p_NonDefaultToUrl := omit,
                                                      template (value) HostPort p_CallerHostPort := cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort),
                                                      integer p_CSeqValue := 4711) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5s200210: p_CallerDomain sic@ */
    /* @sic R5s240228: p_CallerHostPort instead of p_CallerDomain sic@ */
    /* @sic R5-251424: p_CallType sic@ */
    /* @sic R5-251424: p_NonDefaultToUrl - PSAP callback: To header field shall be set to the SIP URI as provided by the UE in the Contact of the INVITE at eCall establishment sic@ */
    /* @sic R5-251424: p_FromAddrStr replaced by p_NonDefaultFromUrl => common handling for From and To header fields sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := cs_MessageHeader_Dummy;
    var template (value) SipUrl v_PublicUserId_SipUrl := f_IMS_PTC_ImsInfo_GetSipUriTX(defaultId);              /* @sic R5-133304: use default public user id sic@ */
    var template (value) SipUrl v_FromUrl;
    var template (value) SipUrl v_ToUrl;
    var charstring v_CallIdString := f_IMS_PTC_GenerateCallId("INVITE");
    var charstring v_FromTag := f_IMS_GenerateTag("INVITE", "From");
    var template (value) RouteBody_List v_RouteBodyList;
    var integer v_CSeqValue;
    var template (value) From v_From;
    var template (value) To v_To;
    var template (value) CallId v_CallId;
    var boolean v_IsEmergency := f_IMS_CallIsEmergency(p_CallType);

    if (not p_IsReInvite) {
      if (not isvalue(p_NonDefaultFromUrl)) {
        v_FromUrl := f_SIP_BuildSipUri_TX(tsc_IMS_CallerSipAddrStr);
      } else {                                                                          /* @sic R5-251424: PSAP callback sic@ */
        v_FromUrl := valueof(p_NonDefaultFromUrl);
      }
      if (not isvalue(p_NonDefaultToUrl)) {
        v_ToUrl := v_PublicUserId_SipUrl;
      } else {                                                                          /* @sic R5-251424: PSAP callback sic@ */
        v_ToUrl := valueof(p_NonDefaultToUrl);
      }
      v_CSeqValue := p_CSeqValue;
      v_From   := cs_From(v_FromUrl, v_FromTag);
      v_To     := cs_ToDef(v_ToUrl);
      v_CallId := cs_CallId(v_CallIdString);
      v_RouteBodyList := f_IMS_RouteSet_MT_Call_TX(p_CallType);                         /* @sic R5s140324 - MCC160 Implementation sic@ */
    }
    else {  /* re-INVITE */
      v_CSeqValue := f_IMS_PTC_ImsInfo_CseqIncr(dialogLocal);
      v_From   := f_IMS_RequestInDialog_FromHeaderTX();
      v_To     := f_IMS_RequestInDialog_ToHeaderTX();
      v_CallId := f_IMS_PTC_ImsInfo_DialogGetCallId();
      if (f_IMS_PTC_ImsInfo_DialogIsMO()) {                                             /* @sic R5s140324 - MCC160 Implementation sic@ */
        v_RouteBodyList := f_IMS_RouteSet_ReverseOrder(f_IMS_RouteSet_MO_Call_TX());    /* @sic R5-142320, R5-144601 sic@ */
      } else {
        v_RouteBodyList := f_IMS_RouteSet_MT_Call_TX();
      }
    }
    v_MessageHeader_Invite.via             := f_IMS_SipRequest_ViaTX(p_CallerHostPort, v_IsEmergency);       /* @sic R5-134116: New function fl_IMS_InviteRequest_ViaTX sic@ */
    v_MessageHeader_Invite.recordRoute     := cs_RecordRoute(v_RouteBodyList);
    v_MessageHeader_Invite.fromField       := v_From;
    v_MessageHeader_Invite.toField         := v_To;
    v_MessageHeader_Invite.callId          := v_CallId;
    v_MessageHeader_Invite.cSeq            := cs_CseqDef(v_CSeqValue, "INVITE");
    v_MessageHeader_Invite.supported       := cs_Supported(p_OptionTagsForSupported);
    v_MessageHeader_Invite.pCalledPartyID  := cs_PCalledPartyId(v_PublicUserId_SipUrl);
    v_MessageHeader_Invite.maxForwards     := f_IMS_SipRequest_MaxForwardsTX();         /* @sic R5-203073: Max-Forwards for MCX sic@ */

    if (p_CallType == REGULAR_EMERGENCY) {
      v_MessageHeader_Invite.priority      := cs_Priority("psap-callback");
    }

    if (not p_IsReInvite) {
      f_IMS_PTC_ImsInfo_DialogInit(dialogLocal, valueof(v_MessageHeader_Invite));
    }
    f_IMS_PTC_ImsInfo_DialogSetRemoteRSeq(omit);                                        /* reset RSeq for every (re-)INVITE   @sic R5-181190 sic@ */

    return v_MessageHeader_Invite;
  }

  /*
   * @desc      PRACK (see TS 34.229, A.2.4)
   * @param     p_InviteRequest
   * @param     p_MessageHeader_PrevReliableResponse
   * @param     p_ContentType       (default value: omit)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_PrackRequest_MessageHeaderTX(template (value) INVITE_Request p_InviteRequest,
                                              MessageHeader p_MessageHeader_PrevReliableResponse,
                                              template (omit) ContentType p_ContentType := omit) runs on IMS_PTC return template (value) MessageHeader
  { /* p_MessageHeader_PrevReliableResponse   ..   MessageHeader of "the reliable response" (e.g. previous 183 response) */
    /* @sic R5-174544: SessionId removed sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (value) MessageHeader v_MessageHeader_Prack := cs_MessageHeader_Dummy;
    var template (value) Via v_Via := f_IMS_Via_AddSigCompParam(v_MessageHeader_Invite.via);
    var CSeq v_CSeq := p_MessageHeader_PrevReliableResponse.cSeq;        /* sequence number of the reliable response which is to be acknowledged (-> rAck); see RFC 3262 cl. 7.2 */
    var integer v_CSeqValue := f_IMS_PTC_ImsInfo_CseqIncr(dialogLocal);  /* incremented sequence number of the network side @sic R5-133188 sic@ */
    var integer v_ResponseNumber := p_MessageHeader_PrevReliableResponse.rSeq.responseNum;  /* @sic R5s130510 additional change 2.1 sic@ */
    
    v_MessageHeader_Prack.via             := f_IMS_ViaRefreshBranches(v_Via);    /* @sic R5s130561 change 1: refresh branches sic@ */
    v_MessageHeader_Prack.toField         := f_IMS_RequestInDialog_ToHeaderTX();
    v_MessageHeader_Prack.fromField       := f_IMS_RequestInDialog_FromHeaderTX();
    v_MessageHeader_Prack.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Prack.cSeq            := cs_CseqDef(v_CSeqValue, "PRACK");
    v_MessageHeader_Prack.maxForwards     := f_IMS_SipRequest_MaxForwardsTX();               /* @sic R5-203073: Max-Forwards for MCX sic@ */
    v_MessageHeader_Prack.rAck            := cs_RAckDef(v_ResponseNumber, v_CSeq.seqNumber, v_CSeq.method);
    v_MessageHeader_Prack.contentType     := p_ContentType;

    return v_MessageHeader_Prack;
  }

  /*
   * @desc      UPDATE (see TS 34.229, A.2.5)
   * @param     p_InviteRequest
   * @param     p_PreconditionIndication   (default value: NoPreconditionIndication)
   * @param     p_Contact           (default value: omit)
   * @param     p_CallerHostPort    (default value: cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort))
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_UpdateRequest_MessageHeaderTX(template (value) INVITE_Request p_InviteRequest,
                                               IMS_PreconditionIndication_Type p_PreconditionIndication := NoPreconditionIndication,
                                               template (omit) Contact p_Contact := omit,
                                               template (value) HostPort p_CallerHostPort := cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort)) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-160790, R5-160795: p_PreconditionIndication sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    /* @sic R5s200206 change 2.1: p_Contact and p_CallerDomain; p_Contact shall be present for MO Call sic@ */
    /* @sic R5s240228: p_CallerHostPort instead of p_CallerDomain sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (value) MessageHeader v_MessageHeader_Update := cs_MessageHeader_Dummy;
    var template (value) Via v_Via;
    var integer v_CSeqValue := f_IMS_PTC_ImsInfo_CseqIncr(dialogLocal);
    var template (omit) Contact v_Contact;
    var template (omit) Require v_Require := omit;
    var template (omit) Supported v_Supported := omit;

    select (p_PreconditionIndication) {
      case (PreconditionRequired)  { v_Require := cs_Require(tsc_OptionTagList_precondition); }        /* @sic R5-160790 sic@ */
      case (PreconditionSupported) { v_Supported := cs_Supported(tsc_OptionTagList_precondition); }    /* @sic R5-160795 sic@ */
    }
    if (fl_IMS_InviteRequestIsMO(p_InviteRequest)) {                            /* @sic R5s200206 change 2.1 sic@ */
      v_Contact := p_Contact;
      v_Via := f_IMS_SipRequest_ViaTX(p_CallerHostPort);                        /* @sic R5-200457 sic@ @sic R5s210144 sic@ */
    } else {
      v_Contact := v_MessageHeader_Invite.contact;
      v_Via := f_IMS_Via_AddSigCompParam(v_MessageHeader_Invite.via);           /* basically not needed as SigComp is not started */
      v_Via := f_IMS_ViaRefreshBranches(v_Via);                                 /* @sic R5-251424, R5-251274: PSAP callback sic@
                                                                                   In case of PSAP callback the INVITE is MT and therefore Via can be taken over */
    }

    v_MessageHeader_Update.via             := v_Via;
    v_MessageHeader_Update.toField         := f_IMS_RequestInDialog_ToHeaderTX();
    v_MessageHeader_Update.fromField       := f_IMS_RequestInDialog_FromHeaderTX();
    v_MessageHeader_Update.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Update.cSeq            := cs_CseqDef(v_CSeqValue, "UPDATE");
    v_MessageHeader_Update.maxForwards     := f_IMS_SipRequest_MaxForwardsTX();   /* @sic R5-203073: Max-Forwards for MCX sic@ */
    v_MessageHeader_Update.contentType     := cs_ContentTypeSDP;
    v_MessageHeader_Update.contact         := v_Contact;                          /* @sic R5-150692 sic@ */
    v_MessageHeader_Update.require         := v_Require;                          /* @sic R5-160790 sic@ */
    v_MessageHeader_Update.supported       := v_Supported;                        /* @sic R5-160795 sic@ */

    return v_MessageHeader_Update;
  }

  /*
   * @desc      ACK (see TS 34.229, A.2.7)
   * @param     p_InviteRequest
   * @param     p_StatusLine_PrevResponse  (default value: c_statusLine200)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_AckRequest_MessageHeaderTX(template (value) INVITE_Request p_InviteRequest,
                                            template (value) StatusLine p_StatusLine_PrevResponse := c_statusLine200) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5-141115: new parameter p_StatusLine_PrevResponse sic@ */
    /* @sic R5s140194, R5-142319: no Route header in DL sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (value) MessageHeader v_MessageHeader_Ack := cs_MessageHeader_Dummy;
    var template (value) Via v_Via := f_IMS_Via_AddSigCompParam(v_MessageHeader_Invite.via);
    var integer v_CSeqValue := f_MessageHeader_GetCseqValue(v_MessageHeader_Invite);    // for ACK the CSeq value of the corresponding INVITE has to be used
    var integer v_StatusCode := valueof(p_StatusLine_PrevResponse.statusCode);
    var boolean v_Is2xxResponse := not ((v_StatusCode < 200) or (v_StatusCode > 299));   // @sic R5s140264: missing braces sic@

    if (v_Is2xxResponse) {                                              /* @sic R5-141115, R5s140092 sic@ */
      v_MessageHeader_Ack.via := f_IMS_ViaRefreshBranches(v_Via);       /* @sic R5s130510 sic@ */
    } else {
      v_MessageHeader_Ack.via := v_MessageHeader_Invite.via;            /* @sic R5s140092 change 6 sic@ */
    }

    v_MessageHeader_Ack.toField         := f_IMS_RequestInDialog_ToHeaderTX();
    v_MessageHeader_Ack.fromField       := f_IMS_RequestInDialog_FromHeaderTX();
    v_MessageHeader_Ack.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Ack.cSeq            := cs_CseqDef(v_CSeqValue, "ACK");
    v_MessageHeader_Ack.maxForwards     := f_IMS_SipRequest_MaxForwardsTX();   /* @sic R5-203073: Max-Forwards for MCX sic@ */

    return v_MessageHeader_Ack;
  }

  /*
   * @desc      BYE (see TS 34.229, A.2.8)
   * @param     p_ContentType       (default value: omit)
   * @param     p_CallerHostPort    (default value: cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort))
   * @param     p_A9                (default value: false)
   * @return    template (value) MessageHeader
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_ByeRequest_MessageHeaderTX(template (omit) ContentType p_ContentType := omit,
                                            template (value) HostPort p_CallerHostPort := cs_HostPort(tsc_IMS_CallerDomain, tsc_IMS_CallerPort),
                                            boolean p_A9 := false) runs on IMS_PTC return template (value) MessageHeader
  { /* @sic R5s130756 additional changes: p_IsGIBA removed sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    /* @sic R5s201620: p_InviteRequest removed sic@ */
    /* @sic R5s240228: p_CallerHostPort instead of p_CallerDomain sic@ */
    /* @sic @sic R5-251377, R5-251424: p_A9 (BYE sent by the SS for emergency call or eCall) sic@ */
    var template (value) MessageHeader v_MessageHeader_Bye := cs_MessageHeader_Dummy;
    var template (value) Via v_Via := f_IMS_SipRequest_ViaTX(p_CallerHostPort, p_A9);      /* @sic R5s190882, R5s200210: p_CallerDomain sic@ @sic R5-200457 sic@ */
    var template (value) To v_To := f_IMS_RequestInDialog_ToHeaderTX();
    var template (value) From v_From := f_IMS_RequestInDialog_FromHeaderTX();
    var template (value) CallId v_CallId := f_IMS_PTC_ImsInfo_DialogGetCallId();
    var integer v_CSeqValue := f_IMS_PTC_ImsInfo_CseqIncr(dialogLocal);

    v_MessageHeader_Bye.via             := v_Via;
    v_MessageHeader_Bye.callId          := v_CallId;     /* @sic R5s201620 sic@ */
    v_MessageHeader_Bye.cSeq            := cs_CseqDef(v_CSeqValue, "BYE");
    v_MessageHeader_Bye.maxForwards     := f_IMS_SipRequest_MaxForwardsTX();   /* @sic R5-203073: Max-Forwards for MCX sic@ */
    v_MessageHeader_Bye.toField         := v_To;
    v_MessageHeader_Bye.fromField       := v_From;
    v_MessageHeader_Bye.contentType     := p_ContentType;

    return v_MessageHeader_Bye;
  }

  /*
   * @desc      ACK (see TS 34.229, A.2.7)
   * @param     p_InviteRequest
   * @param     p_StatusLine_PrevResponse
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_IsReInvite        (default value: false)
   * @return    template (present) MessageHeader
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_AckRequest_MessageHeaderRX(template (value) INVITE_Request p_InviteRequest,
                                            template (value) StatusLine p_StatusLine_PrevResponse,
                                            IMS_CallType_Type p_CallType := NORMAL_CALL,
                                            boolean p_IsReInvite := false)
    runs on IMS_PTC return template (present) MessageHeader
  { /* @sic R5s130684: p_StatusLine_PrevResponse made mandatory, p_MessageHeader_PrevResponse removed, new parameter p_IsGiba sic@ */
    /* @sic R5s130756 additional changes: p_IsGIBA removed sic@ */
    /* @sic R5-141115: new parameter p_IsReInvite sic@ */
    /* @sic R5s150692 change 18: parameter p_CallType sic@ */
    /* @sic R5-155994: pAccessNetworkInfo is optional, i.e. may be included sic@ */
    /* @sic R5-174544: SessionId removed sic@ */
    var template (value) MessageHeader v_MessageHeader_Invite := p_InviteRequest.msgHeader;
    var template (present) MessageHeader v_MessageHeader_Ack := cr_MessageHeader_Dummy;
    var integer v_CSeqValue := f_MessageHeader_GetCseqValue(v_MessageHeader_Invite);
    var integer v_StatusCode := valueof(p_StatusLine_PrevResponse.statusCode);
    var boolean v_Is2xxResponse := not ((v_StatusCode < 200) or (v_StatusCode > 299));   // @sic R5s140264: missing braces sic@
    var template RouteBody_List v_RouteBodyList;

    if (p_IsReInvite or not v_Is2xxResponse) { /* @sic R5-141115 sic@ */
      v_RouteBodyList  := p_InviteRequest.msgHeader.route.routeBody;            /* @sic R5-134958, R5s130885: use the Route header of the INVITE in case of e.g. 5XX responses (see RFC 3261 cl. 17.1.1.3) sic@ */
    } else {
      v_RouteBodyList  := f_IMS_Request_RouteSet_RouteBodyList_RX(p_CallType);  /* @sic R5s130684: same as for 180 or 183 response in reverse order sic@
                                                                                   @sic R5s130897 change 3 sic@
                                                                                   @sic R5s140017 MCC160 implementation: re-INVITE - Route is different for MO and MT calls sic@
                                                                                   @sic R5s150692 change 18 sic@ */
    }

    if (v_Is2xxResponse) {  /* @sic R5-130682: ACK for 2xx response sic@ */
      v_MessageHeader_Ack.via := f_IMS_Via_AsInPrevInvite(v_MessageHeader_Invite.via);
    } else {                /* @sic R5-130682: ACK for non-2xx response sic@ */
      v_MessageHeader_Ack.via := v_MessageHeader_Invite.via;
    }

    v_MessageHeader_Ack.route           := cr_Route(v_RouteBodyList);
    v_MessageHeader_Ack.toField         := f_IMS_RequestInDialog_ToHeaderRX();    /* @sic R5s130497 change 1 - MCC160 implementation; R5-133303; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Ack.fromField       := f_IMS_RequestInDialog_FromHeaderRX();  /* @sic R5s130497 change 1 - MCC160 implementation; R5-133303; R5s140017 MCC160 implementation sic@ */
    v_MessageHeader_Ack.callId          := v_MessageHeader_Invite.callId;
    v_MessageHeader_Ack.cSeq            := cr_CseqDef(v_CSeqValue, "ACK");
    v_MessageHeader_Ack.maxForwards     := cr_MaxForwardsDef;
   
    return v_MessageHeader_Ack;
  }

  /*
   * @desc      Common function to receive and check INVITE against 34.229-1 A.2.1
   *            when the INVITE is optional a wait duration shall be given
   * @param     p_ExpectedCalleeUri
   * @param     p_MessageHeader_Invite
   * @param     p_MessageBody
   * @param     p_WaitDuration      (default value: omit)
   * @param     p_IsReInvite        (default value: false)
   * @param     p_IsEmergencyCallWithoutRegistration    (default value: false)
   * @return    template (omit) IMS_DATA_REQ
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_INVITE_ReceiveRequest_Optional(template (present) SipUrl p_ExpectedCalleeUri,
                                                template (present) MessageHeader p_MessageHeader_Invite,
                                                template (present) MessageBody p_MessageBody,
                                                template (omit) float p_WaitDuration := omit,
                                                boolean p_IsReInvite := false,
                                                boolean p_IsEmergencyCallWithoutRegistration := false)
    runs on IMS_PTC return template (omit) IMS_DATA_REQ
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ_ByRef;
    var INVITE_Request v_InviteRequest;
    var SipUrl v_ContactUrl;
    var IP_AddrInfo_Type v_UE_Address;
    var IP_AddrInfo_Type v_NW_Address;
    var boolean v_TimerControl := ispresent(p_WaitDuration);

    timer t_Timer;

    if (v_TimerControl) {
      t_Timer.start(valueof(p_WaitDuration));
    }
    alt {
      [] a_IMS_ReceiveRequest(car_IMS_Invite_Request(cr_INVITE_Request(p_ExpectedCalleeUri, p_MessageHeader_Invite, p_MessageBody)), v_IMS_DATA_REQ_ByRef)
        {
          t_Timer.stop;
          v_InviteRequest := v_IMS_DATA_REQ_ByRef.Request.Invite;
          if (p_IsEmergencyCallWithoutRegistration) {      // emergency call without registration   @sic R5s130756 change 14 sic@
            v_ContactUrl := f_MessageHeader_GetContactSipUrl(v_InviteRequest.msgHeader);   /* @sic R5s150268 change 1 sic@ */
            v_UE_Address := v_IMS_DATA_REQ_ByRef.RoutingInfo.UE_Address;
            v_NW_Address := v_IMS_DATA_REQ_ByRef.RoutingInfo.NW_Address;
            f_IMS_PTC_ImsInfo_Init(v_UE_Address, v_NW_Address);
            f_IMS_PortsAndSecurityConfig(f_SIP_ContactUrl_GetPort(v_ContactUrl), cs_IMS_RegistrationInfo(v_NW_Address, v_UE_Address));          /* @sic R5s150268 change 1 sic@
                                                                                                                                                   @sic R5s180112 - MCC160 Implementation sic@ */
          }
          if (not p_IsReInvite) {      /* @sic R5s140020 change 8.2 sic@ */
            f_IMS_PTC_ImsInfo_DialogInit(dialogRemote, v_InviteRequest.msgHeader);
          } else {
            if (not isvalue(f_IMS_PTC_ImsInfo_CseqGet(dialogRemote))) {  /* @sic R5s140235 sic@ */
              f_IMS_PTC_ImsInfo_CseqSet(dialogRemote, v_InviteRequest.msgHeader.cSeq.seqNumber);
            }
          }
          return v_IMS_DATA_REQ_ByRef;
        }
      [v_TimerControl] t_Timer.timeout {}
    }
    return omit;
  }

  /*
   * @desc      MT Call release acc. to 34.229-1 C.33
   * @param     p_ContactSipUrl
   * @param     p_MessageHeader_Bye
   * @param     p_MessageHeader_200OK
   * @param     p_MessageBody       (default value: omit)
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_CallReleaseMT_Common(template (value) SipUrl p_ContactSipUrl,
                                      template (value) MessageHeader p_MessageHeader_Bye,
                                      template (present) MessageHeader p_MessageHeader_200OK,
                                      template (omit) MessageBody p_MessageBody := omit) runs on IMS_PTC
  {
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();

    // The SS sends BYE to release the call
    IMS_Client.send(cas_IMS_BYE_Request(cs_IMS_RoutingInfo(v_Protocol), cs_BYE_Request(p_ContactSipUrl, p_MessageHeader_Bye, p_MessageBody)));

    //  The UE sends 200 OK for the BYE request and ends the call.
    f_IMS_ReceiveResponse(p_MessageHeader_Bye, v_Protocol, cr_Response(c_statusLine200, p_MessageHeader_200OK));  /* @sic R5s140350 sic@ */

    f_IMS_PTC_ImsInfo_DialogRelease();    /* there is no dialog anymore; @sic R5s140017 MCC160 implementation sic@ */
  }

  /*
   * @desc      receive response for INVITE from the UE with optional 100 Trying being sent before
   *            or timer times out
   * @param     p_Timer
   * @param     p_MessageHeaderRequest
   * @param     p_Protocol
   * @param     p_Response
   * @param     p_AllowTrying       (default value: true)
   * @return    template (omit) IMS_DATA_RSP
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_ReceiveResponse_OptionalTrying_Timeout(timer p_Timer,
                                                        template (value) MessageHeader p_MessageHeaderRequest,
                                                        template (present) InternetProtocol_Type p_Protocol,
                                                        template (present) IMS_Response_Type p_Response,
                                                        boolean p_AllowTrying := true) runs on IMS_PTC return template (omit) IMS_DATA_RSP
  {
    var IMS_DATA_RSP v_IMS_DATA_RSP_Ref;
    var template (omit) IMS_DATA_RSP v_IMS_DATA_RSP := omit;
    var boolean v_TimerIsRunning := p_Timer.running;
    var boolean v_AllowTrying := p_AllowTrying;
    
    alt {
      [v_AllowTrying] a_IMS_ReceiveResponse(p_MessageHeaderRequest,
                                            p_Protocol,
                                            cr_Response(c_statusLine100, f_IMS_InviteResponse_100_MessageHeaderRX(p_MessageHeaderRequest)),
                                            v_IMS_DATA_RSP_Ref)       /* @sic R5s140350: v_IMS_DATA_RSP is 'out' parameter sic@ */
        {
          v_AllowTrying := false;
          repeat;
        }

      [] a_IMS_ReceiveResponse(p_MessageHeaderRequest,
                               p_Protocol,
                               p_Response,
                               v_IMS_DATA_RSP_Ref)                    /* @sic R5s140350: v_IMS_DATA_RSP is 'out' parameter sic@ */
        {
          /* NOTE: p_Timer has to be stopped by the caller of this function - if started; (necessary due to implementation for 16.X test cases) */
          v_IMS_DATA_RSP := v_IMS_DATA_RSP_Ref;
        }
      [v_TimerIsRunning] p_Timer.timeout
        {
        }
    }
    return v_IMS_DATA_RSP;
  }

  /*
   * @desc      receive response for INVITE from the UE with optional 100 Trying being sent before
   * @param     p_MessageHeaderRequest
   * @param     p_Protocol
   * @param     p_Response
   * @param     p_AllowTrying       (default value: true)
   * @return    IMS_DATA_RSP
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_ReceiveResponse_OptionalTrying(template (value) MessageHeader p_MessageHeaderRequest,
                                                template (present) InternetProtocol_Type p_Protocol,
                                                template (present) IMS_Response_Type p_Response,
                                                boolean p_AllowTrying := true) runs on IMS_PTC return IMS_DATA_RSP
  {
    var template (omit) IMS_DATA_RSP v_IMS_DATA_RSP;
    timer t_Dummy; // timer which is not started

    v_IMS_DATA_RSP := f_IMS_ReceiveResponse_OptionalTrying_Timeout(t_Dummy, p_MessageHeaderRequest, p_Protocol, p_Response, p_AllowTrying);
    return valueof(v_IMS_DATA_RSP);   // f_IMS_ReceiveResponse_OptionalTrying_Timeout always returns a value when there is no timeout
  }

  /*
   * @desc      Common function to send PRACK and receive the corresponding 200 OK (mainly to be used for MT call setup)
   * @param     p_InviteRequest
   * @param     p_MessageHeader_Prack
   * @param     p_MessageHeader_200OK
   * @param     p_OtherResponseForInvite     (default value: omit)
   * @return    template (omit) IMS_Response_Type
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_MTCallSetup_SendPRACK_ReceiveOK_Common(template (value) INVITE_Request p_InviteRequest,
                                                        template (value) MessageHeader p_MessageHeader_Prack,
                                                        template (present) MessageHeader p_MessageHeader_200OK,
                                                        template IMS_Response_Type p_OtherResponseForInvite := omit) runs on IMS_PTC return template (omit) IMS_Response_Type
  { /* @sic R5-142994: allow optionally e.g. a 180 Ringing in parallel to the 200 OK sic@ */
    var IMS_DATA_RSP v_IMS_DATA_RSP_ByRef;
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    var SipUrl v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);       /* @sic R5s150908 change 4: dialog sic@ */
    var boolean v_AllowOtherResponse := ispresent(p_OtherResponseForInvite);
    var template (omit) IMS_Response_Type v_OtherResponse := omit;

    // Send PRACK
    IMS_Client.send(cas_IMS_Prack_Request(cs_IMS_RoutingInfo(v_Protocol), cs_PRACK_Request(v_ContactUrl, p_MessageHeader_Prack)));

    // Receive 200 OK
    alt {  /* @sic R5s140551 sic@ */
      [] a_IMS_ReceiveResponse(p_MessageHeader_Prack,
                               v_Protocol,
                               cr_Response(c_statusLine200, p_MessageHeader_200OK),
                               v_IMS_DATA_RSP_ByRef)
        {}  /* @sic R5s140350 sic@ */
      [v_AllowOtherResponse] a_IMS_ReceiveResponse(p_InviteRequest.msgHeader,
                                                   v_Protocol,
                                                   p_OtherResponseForInvite,           // NOTE: compiler warning cannot be avoided here
                                                   v_IMS_DATA_RSP_ByRef)
        {
          v_AllowOtherResponse := false;
          v_OtherResponse := v_IMS_DATA_RSP_ByRef.Response;
          repeat;
        }
    }
    return v_OtherResponse;
  }

  /*
   * @desc      Send ACK
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_InviteMT_SendACK(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on IMS_PTC
  {
    var InternetProtocol_Type v_InternetProtocol := p_InviteRequestWithSdp.RoutingInfo.Protocol;
    var SipUrl v_RequestUrl  := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    var template (value) MessageHeader v_MessageHeader_Ack := f_IMS_AckRequest_MessageHeaderTX(p_InviteRequestWithSdp.Invite);

    IMS_Client.send(cas_IMS_Ack_Request(cs_IMS_RoutingInfo(v_InternetProtocol), cs_ACK_Request(v_RequestUrl, v_MessageHeader_Ack)));
  }

}
