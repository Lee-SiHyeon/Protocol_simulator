  template (present) ServCategory cr_ServCategory (template (present) EmergServCat p_EmergServCat := ?) :=
  { /* 3GPP 24.008 / 10.5.4.33 */
    /* @status    APPROVED (IMS_IRAT, LTE_IRAT, POS, UTRAN) */
    iei             := '2E'O,                  // '00101110'B (2E hex)
    iel             := '01'O,                        // '01'O
    emergServCat    := p_EmergServCat            // Emergency Service Category @sic R5-176953 sic@
  };

  template (value) SM_Cause cs_SM_Cause(CauseValue p_Cause) :=
  { /* @status    APPROVED (LTE_IRAT, UTRAN) */
    causeValue := p_Cause
  };

  template (present) SM_Cause cr_SM_Cause(template (present) CauseValue p_CauseValue := ?) :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS) */
    causeValue := p_CauseValue
  };

  template (present) StreamId cr_StreamIdAny :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    iei             := '2D'O,
    iel             := ?,
    streamIndValue  := ?
  };

  template (present) Subadrs cr_SubadrsAny :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    extBit          := ?,                            // extension bit
    typrOfSubadrs   := ?,                            // Type of subaddress
    oddEven         := ?,                            // odd/even indicator
    spare3          := ?,                            // 3 spare bits
    subadrsInfo     := *                             // subaddress information
  };

  template (present) TypeOfNumPlan cr_TypeOfNumPlanAny :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, SSNITZ) */
    extBit          := ?,                            // extension bit
    typeOfNum       := ?,                            // Type of number
    numbPlanId      := ?                             // Numbering plan id.
  };

  template (present) UserUser cr_UserUserAny :=
  { /* In SETUP, ALERTING, CONNECT, DISCONNECT, RELEASE and RELEASE COMPLETE messages the userUserInfo length is of 0 - 32 bytes.
     * In USER INFORMATION messages the userUserInfo length is of 1 - 128. */
    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    iei             := '7E'O,                  // information element identifier
    iel             := ?,                            // length
    userUserProtocolDiscr := ?,                      // user-user protocol discriminator
    userUserInfo    := *                             // user user information
  };

  const B2_Type tsc_CodingStd_GSM  := '11'B;                    /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */

  const B4_Type tsc_Location_User  := '0000'B;                  /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */

  template (value) Cau cs_Cau_Common(template (omit) IEI8_Type p_IEI := '08'O,
                                     B2_Type p_CodingStd,
                                     B4_Type p_Location,
                                     B7_Type p_CauValue) :=
  { /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    iei             := p_IEI,
    iel             := '02'O,
    extBit3         := '1'B,                         // no extension
    codingStd       := p_CodingStd,                  // coding standard: GSM or ITU-T
    spare1          := '0'B,                         // bit
    location        := p_Location,                   // location: user or public network serving the local user
    extBit3a        := omit,
    recommend       := omit,
    extBit4         := '1'B,                         // no extension
    cauValue        := p_CauValue,
    diagnostic      := omit
  };

  template (value) Cau cs_CauNormCallClear := cs_Cau_Common(omit, tsc_CodingStd_GSM, tsc_Location_User, int2bit(16, 7)); /* @status    APPROVED (IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */

  template (present) UplinkDataStatus cr_UplinkDataStatusAny :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, UTRAN) */
    iei  := '36'O,
    iel  := ?,
    nsapiUplinkStatus  := ?
  };

  template (present) AUTHENTICATIONFAILURE cr_AuthFailAny_Common :=
  { /* @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN) */
    skipIndicator   := '0000'B,
    mMProtocolDiscriminator := '0101'B,
    msgType         := '??011100'B,
    rejCau          := ?,
    authFailParam   := cdr_AuthFailParamGSM_Any ifpresent
  };

