module MobilityManagement_NTN_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.4.1.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_4_1_1_NR5GC() runs on NR5GC_PTC
  {
    //NR NTN / GNSS position reporting / reject cause #78 "PLMN not allowed to operate at the present UE location"
    //@sic R5-243556 sic@
    //@sic R5-244411 sic@
    //@sic R5-244665 sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);

    f_NR5GC_Init_NAS(NR_29, NG_CellsOnDifferentPLMN, -, {v_NGC_NASCellG});

    // The pre-configured UE location is defined in TS 38.508-1 Clause 4.5C
    //f_NR_PreconfigureNTN_UE(); //@sic R5s250168 sic@

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellG);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    fl_TC_9_4_1_1_Body();

    // Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_9_4_1_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_4_1_1_Body() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellG := f_NR5GC_MapNASCell(ngc_CellG, NG_CellsOnDifferentPLMN);

    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellG);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    timer t_Timer := f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 30.0);

    //@siclog "Step 1" siclog@
    //Set NGC Cell G to serving cell power and NGC Cell A to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellG, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 2" siclog@
    f_NR5GC_SwitchOnAndResetIMS();

    //@siclog "Steps 3-14" siclog@
    //Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellG, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    f_NR5GC_RRC_Idle_Steps5_13 (v_GMM_MobilityInfo, v_NGC_NASCellG, v_ReceivedMsg, v_PLMN, TESTMode_OFF, Initial_Secure, NOT_SUPPORTED, 1);

    //@siclog "Step 15" siclog@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellG,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, //@sic R5s250168 sic@
                                                     cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_PLMN_NotAllowedToOperateAtPresentUELocation),
                                                                               -, -, -, -, -, -, -, -, cs_GprsTimer3('3A'O, tsc_Gprs3TimerUnit_30sec, '00001'B)))));
    //@siclog "Step 16" siclog@
    f_NR_RRCRelease(v_NGC_NASCellG);

    //@siclog "Step 17" siclog@
    t_Timer.start;
      alt {
          [] SRB.receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellG, cr_38508_RRCSetupRequest(?, ?))) // assuming this is the RRC Connection to transmit the REGISTRATION REQUEST
            {
              t_Timer.stop;
              f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 17");
            }
          [] t_Timer.timeout
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 17");
            }
        }
    //@siclog "Step 18" siclog@
    //Set NGC Cell A to serving cell power and NGC Cell G to Non-suitable cell power
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellG, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    //@siclog "Step 19 - 35a1" siclog@
    // @sic R5-245564 sic@
    t_Timer.start(30.0);
    alt{
    [] t_Timer.timeout
      {
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 19");
      }
    [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellA, cr_38508_RRCSetupRequest))) { // assuming this is the RRC Connection to transmit the REGISTRATION REQUEST
        t_Timer.stop;
        f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");
      }
    }
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection); //@sic R5s250168 sic@
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_NoSecurity)) { //@sic R5s250168 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo, v_NGC_NASCellA, v_ReceivedMsg, TESTMode_OFF, rrcConnectionRelease, Initial_NoSecurity, -, '00'O, -, '0000'B); //@sic R5s250168 sic@
    //@siclog "Step 36" siclog@
    f_UT_DeleteNTN_PLMNsNotAllowed(UT);
    } //End of fl_TC_9_4_1_1_Body

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.4.1.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_4_1_2_NR5GC() runs on NR5GC_PTC
  { //NR NTN / Mobility registration update / supported TACs not part of UE registration area
    //@sic R5-243557 R5-244665 sic@
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellD := f_NR5GC_MapNASCell(ngc_CellD, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_29, -, -, {v_NGC_NASCellB, v_NGC_NASCellD});

    //Configure trackingAreaList in SIB1 as per Table 9.4.1.2.3.3-1 and Table 9.4.1.2.3.3-2
    f_NR_CellInfo_SetPLMNIdentityInfo_List (v_NGC_NASCellA,
                                            {cs_NR_PLMN_IdentityInfo( f_NR_CellInfo_GetPLMN (v_NGC_NASCellA),
                                                                      f_NR_CellInfo_GetTAC(v_NGC_NASCellA),
                                                                      1, //RAN_AreaCode set to 1 as per TS 38.508-1 Table 4.6.3-135
                                                                      f_NR_CellInfo_GetCellIdentity(v_NGC_NASCellA),
                                                                      {f_NR_CellInfo_GetTAC(v_NGC_NASCellA), f_NR_CellInfo_GetTAC(v_NGC_NASCellB)}
                                                                    )});
    f_NR_CellInfo_SetPLMNIdentityInfo_List (v_NGC_NASCellB,
                                            {cs_NR_PLMN_IdentityInfo( f_NR_CellInfo_GetPLMN (v_NGC_NASCellB),
                                                                      f_NR_CellInfo_GetTAC(v_NGC_NASCellB),
                                                                      1, //RAN_AreaCode set to 1 as per TS 38.508-1 Table 4.6.3-135
                                                                      f_NR_CellInfo_GetCellIdentity(v_NGC_NASCellB),
                                                                      {f_NR_CellInfo_GetTAC(v_NGC_NASCellB),  int2bit(3, 24)}
                                                                    )});

    // The pre-configured UE location is defined in TS 38.508-1 Clause 4.5C
    //f_NR_PreconfigureNTN_UE();

    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);
    f_NR_CellConfig_Def(v_NGC_NASCellD);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_IDLE_1A);

    f_NR_TestBody_Set(true);
    fl_TC_9_4_1_2_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Postamble
    f_NR_Postamble(v_NGC_NASCellD, STATE_IDLE_1A);

  } // end of f_TC_9_4_1_2_NR5GC

  /*
   * @desc      test body of TC_9_4_1_2_NR5GC
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_4_1_2_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellD := f_NR5GC_MapNASCell(ngc_CellD, NG_AllCellsOnSamePLMN);
    var PLMN_Identity v_ASN_PLMN := f_NR_CellInfo_GetPLMN (v_NGC_NASCellA);
    var NAS_PlmnId v_PLMN := f_NR_Asn2Nas_PlmnId(v_ASN_PLMN);
    var TrackingAreaCode v_TAC_B := f_NR_CellInfo_GetTAC (v_NGC_NASCellB);
    var TrackingAreaCode v_TAC_D := f_NR_CellInfo_GetTAC (v_NGC_NASCellD);
    var template (value) NG_TrackingAreaIdList v_TAIList_CellB := cs_NG_TAIListNonConsecutive(v_PLMN, {bit2oct(v_TAC_B), bit2oct(v_TAC_D)});


    // main behaviour
    // @siclog "Step 1" siclog@
    // The SS configures- NGC Cell B as "Serving Cell"- NGC Cell A and Cell D as Non-suitable "Off" cell.
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellD, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 2" siclog@
    // Check: Does the UE perform on NGC Cell B the Registration procedure for mobility registration update by executing the Test procedure to check that UE is camped on a new cell belonging to a new TA as specified in TS 38.508-1 [4] subclause 4.9.5?
    // NOTE: During the procedure the SS assigns a TAI list containing the TAI of NGC Cell B and NGC Cell D.
    f_NR5GC_MobilityRegistration(v_NGC_NASCellB, -, f_LastVisited_TAI(v_NGC_NASCellA), -, v_TAIList_CellB);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2: UE perform mobility registration update and camp on NGC Cell B.");

    // @siclog "Step 3" siclog@
    // The SS configures- NGC Cell D as "Serving Cell"- NGC Cell A and Cell B as Non-suitable "Off" cell.
    f_NR_SetCellPower (v_NGC_NASCellD, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 4" siclog@
    // Check: Does the UE send in the next 30 sec a request for RRC connection establishment?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellD, 30.0);

    // @siclog "Step 5" siclog@
    // Check: Does the result of generic test procedure in TS 38.508-1 [4] subclause 4.9.4 indicate that the UE is in 5GC RRC_IDLE state on the NGC Cell D?
    f_NR5GC_CheckRRCIdle(v_NGC_NASCellD); //@sic R5s250234 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5: UE is in 5GC RRC_IDLE state on the NGC Cell D");

  } // end of fl_TC_9_4_1_2_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.4.1.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_4_1_3_NR5GC() runs on NR5GC_PTC
  { //NR NTN / TAI(s) not allowed / forbidden TAI(s) in the Registration Accept message
    //@sic R5-243558; R5-244665 sic@

    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);

    f_NR5GC_Init_NAS(NR_29, -, -, {v_NGC_NASCellB});

    // The pre-configured UE location is defined in TS 38.508-1 Clause 4.5C
    //f_NR_PreconfigureNTN_UE(); //@sic R5s250170 sic@
    //Create and configure cells
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellB);

    f_NR5GC_Preamble (v_NGC_NASCellA, STATE_OFF_0B);

    f_NR_TestBody_Set(true);

    fl_TC_9_4_1_3_NR5GC_TestBody();

    f_NR_TestBody_Set(false);

    // Postamble
    f_NR_Postamble(v_NGC_NASCellB, STATE_IDLE_1A);

  } // end of f_TC_9_4_1_3_NR5GC

  /*
   * @desc      test body of TC_9_4_1_3_NR5GC
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_4_1_3_NR5GC_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellB := f_NR5GC_MapNASCell(ngc_CellB, NG_AllCellsOnSamePLMN);
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;

    // main behaviour
    // @siclog "Step 1" siclog@
    // The SS configures:- NGC Cell A as the "Serving cell ".- NGC Cell B as "Non-suitable "Off" cell".
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 2" siclog@
    // The UE is switched on.
    f_UT_SwitchOnUE(UT);

    // @siclog "Step 3-14" siclog@
    // Steps 2-13 of Table 4.5.2.2-2 of the generic procedure in TS 38.508-1 are performed.
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?, tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Initial_Secure)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    f_NR5GC_RRC_Idle_Steps5_13(v_GMM_MobilityInfo,
                               v_NGC_NASCellA,
                               v_ReceivedMsg,
                               f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)),
                               TESTMode_OFF, Initial_Secure);

    // @siclog "Step 15" siclog@
    // The SS transmits a REGISTRATION REJECT message, 5GMM cause value = #12 "Tracking area not allowed".
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA,
                                   tsc_NR_RbId_SRB1, // No SRB2 so must be on SRB1
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, //@sic R5s250170 sic@
                                                     cs_NG_REGISTRATION_REJECT(cs_GMM_GSM_Cause(omit, tsc_Cause_TA_NotAllowed)))));

    // @siclog "Step 16" siclog@
    // The SS releases the RRC connection.
    f_NR_RRCRelease(v_NGC_NASCellA);

    // @siclog "Step 17" siclog@
    // Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell A in the next 30 seconds?
    f_NR_CheckNoRRCSetupReq(v_NGC_NASCellA, 30.0);

    // @siclog "Step 18" siclog@
    // The SS reconfigures:- NGC cell B as the "Serving cell".- NGC cell A as a "Non-suitable "Off" cell".
    f_NR_SetCellPower (v_NGC_NASCellB, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 19" siclog@
    // Check: Does the UE transmit the REGISTRATION REQUEST message on NGC Cell B?
    SRB.check(receive(car_NR_SRB0_RrcPdu_IND(v_NGC_NASCellB, cr_38508_RRCSetupRequest)));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19: UE triggers RRC Connection establishment to transmit the REGISTRATION REQUEST");

    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellB, tsc_NR_RRC_TI_Def, ?, tsc_SHT_NoSecurityProtection); //@sic R5s250170 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19: REGISTRATION RREQUEST Message is received");

    // @siclog "Steps 20-35a1" siclog@
    //  Steps 5 to 20a1 from procedure in TS 38.508-1 [4] Table 4.5.2.2-2 are performed.
    f_NR5GC_RRC_Idle_Steps5_20 (v_GMM_MobilityInfo,
                                v_NGC_NASCellB,
                                v_ReceivedMsg,
                                TESTMode_OFF,
                                -,
                                Initial_NoSecurity);
  } // end of fl_TC_9_4_1_3_NR5GC_TestBody

}
