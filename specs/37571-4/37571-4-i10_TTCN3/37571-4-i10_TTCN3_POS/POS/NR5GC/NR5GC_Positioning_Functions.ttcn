  /*
   * @desc      Function to check NR Multi RTT measurements provided by the UE
   *            Reference 37.571-2 Table 9.3.1.1.3.3-8
   * @param     p_NrMultiRttMeasurementCapability
   * @status    APPROVED (POS)
   */
  function f_POS_NR_CheckCapabilities_NR_Multi_RTT_Measurements (NR_Multi_RTT_MeasurementCapability_r16 p_NrMultiRttMeasurementCapability) runs on NR_BASE_PTC
  { //@sic POS Rel-16 R5-213638 sic@
    if (not(isvalue(p_NrMultiRttMeasurementCapability.maxNrOfRx_TX_MeasFR1_r16) and (p_NrMultiRttMeasurementCapability.maxNrOfRx_TX_MeasFR1_r16 == pc_maxNrOfRx_TX_MeasFR1))){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT maxNrOfRx-TX-MeasFR1-r16");
    }
    if (not(isvalue(p_NrMultiRttMeasurementCapability.maxNrOfRx_TX_MeasFR2_r16) and (p_NrMultiRttMeasurementCapability.maxNrOfRx_TX_MeasFR2_r16 == pc_maxNrOfRx_TX_MeasFR2))){
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT maxNrOfRx-TX-MeasFR2-r16");
    }
    if (pc_RSRP_MeasFR1 != ispresent(p_NrMultiRttMeasurementCapability.supportOfRSRP_MeasFR1_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT supportOfRSRP-MeasFR1-r16");
    }
    if (pc_RSRP_MeasFR2 != ispresent(p_NrMultiRttMeasurementCapability.supportOfRSRP_MeasFR2_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT supportOfRSRP-MeasFR2-r16");
    }
    if (pc_srs_AssocPRS_MultiLayersFR1 != ispresent(p_NrMultiRttMeasurementCapability.srs_AssocPRS_MultiLayersFR1_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT srs-AssocPRS-MultiLayersFR1-r16");
    }
    if (pc_srs_AssocPRS_MultiLayersFR2 != ispresent(p_NrMultiRttMeasurementCapability.srs_AssocPRS_MultiLayersFR2_r16)) {
      f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "PICS does not match reported capability for NR DL Multi-RTT srs-AssocPRS-MultiLayersFR2-r16");
    }
    if (isvalue(p_NrMultiRttMeasurementCapability.nr_UE_TEG_Capability_r17)) { //@sic R5-235341 sic@
      f_POS_NR_CheckCapabilities_NR_UL_TEG(p_NrMultiRttMeasurementCapability.nr_UE_TEG_Capability_r17);
    }
    else if (isvalue(p_NrMultiRttMeasurementCapability.nr_UE_TEG_Capability_r17) or pc_nr_UE_TxTEG_ID) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Error in NR UE TEG capabilities PICS");
    }
  }

