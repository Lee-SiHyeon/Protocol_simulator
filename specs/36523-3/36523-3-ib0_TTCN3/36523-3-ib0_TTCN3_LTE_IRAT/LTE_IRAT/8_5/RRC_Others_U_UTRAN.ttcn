module RRC_Others_U_UTRAN {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from CommonIratDefs all;
  import from EUTRA_CapabilityFunctions all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from UTRAN_ASN1_ASP_Templates all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_IRAT_CommonProcedures all;
  import from UTRAN_IRAT_Component all;
  import from UTRAN_RAB_Functions all;
  import from UTRAN_RRC_SysInfo_Templates all;
  import from UTRAN_RRC_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  type RRCConnectionReject.r3.laterNonCriticalExtensions.v690NonCriticalExtensions.v6f0NonCriticalExtensions.v860NonCriticalExtensions.va40NonCriticalExtensions Va40NonCriticalExtensions_ConnRej; /* @status    APPROVED (LTE_IRAT) */

  /*
   * @desc      Get function for nonCriticalExtensions renamed to va40NonCriticalExtensions
   * @param     p_EUTRA_TargetFreqInfoList_vb50ext
   * @return    template Va40NonCriticalExtensions_ConnRej
   * @status    APPROVED (LTE_IRAT)
   */
  function f_UTRAN_Calc_Va40NonCriticalExtensions_ConnRej (template (omit) EUTRA_TargetFreqInfoList_vb50ext p_EUTRA_TargetFreqInfoList_vb50ext) return template Va40NonCriticalExtensions_ConnRej
  { // @sic R5-181145 sic@
    var template Va40NonCriticalExtensions_ConnRej v_Va40NonCriticalExtensions_ConnRej := omit;
    
    if (isvalue (p_EUTRA_TargetFreqInfoList_vb50ext)) {
      v_Va40NonCriticalExtensions_ConnRej := {
        rrcConnectionReject_va40ext := {
          extendedWaitTime := omit
        },
        vb50NonCriticalExtensions := {
          rrcConnectionReject_vb50ext := {
            eutra_TargetFreqInfoList := p_EUTRA_TargetFreqInfoList_vb50ext
          },
          nonCriticalExtensions := omit
        }
      }
    }
    return v_Va40NonCriticalExtensions_ConnRej
  }

  template (value) RRCConnectionReject_r3_laterNonCriticalExtensions_Type cs_RRCConnectionReject_NonCriticalExtensions_EARFCN(EARFCN p_Earfcn,
                                                                                                                              template (omit) EUTRA_TargetFreqInfoList_vb50ext p_EUTRA_TargetFreqInfoList_vb50ext) :=  // @sic R5-181145 sic@
  { /* @status    APPROVED (LTE_IRAT) */
    rrcConnectionReject_r3_add_ext := omit,
    v690NonCriticalExtensions := {
      rrcConnectionReject_v690ext := {
        redirectionInfo_v690ext := omit
      },
      v6f0NonCriticalExtensions := {
        rrcConnectionReject_v6f0ext := {
          countingCompletion := omit
        },
        v860NonCriticalExtensions := {
          rrcConnectionReject_v860ext := {
            redirectionInfo := {
              interRATInfo := {
                eutra := {
                  eutra_TargetFreqInfoList := {
                    {
                      dlEUTRACarrierFreq              := p_Earfcn,
                      eutraExclude_listedCellPerFreqList := omit   //@sic R5s221182 Baseline moving to rel-17 sic@
                    }
                  }
                }
              }
            }
          },
          va40NonCriticalExtensions := f_UTRAN_Calc_Va40NonCriticalExtensions_ConnRej (p_EUTRA_TargetFreqInfoList_vb50ext) /* @sic R5s120178 BASELINE MOVING 2012 (nonCriticalExtensions renamed to va40NonCriticalExtensions) sic@ */
        }
      }
    }
  };

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.5.2.1
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_8_5_2_1_UTRAN ( ) runs on UTRAN_IRAT_PTC
  {

    var InitialUE_Identity v_InitialUE_Id;
    var template (value) QualityOfService v_QualityOfService;
    var IRAT_CoOrd_SysInfo_Type v_EUTRASysInfo;
    var U_RLC_TM_IND v_RLC_TR_DATA_IND; // @sic R5-150124 sic@
    var EutraFrequencyAndPriorityInfoPriorityValue_Type v_EutraPriorityValue_T0 := 3;
    var UtraServingCellPriorityValue_Type v_UtraPriorityValue_T0 := 4;
    var integer v_DedicatedId := 1;
    var EUTRA_MeasurementBandwidth v_EUTRA_MeasurementBandwidth := f_UTRAN_ConvertIntegerToEUTRA_MeasurementBandwidth(f_ConvertDL_BandwidthPIXITToInteger());
    var EARFCN v_EARFCN;
    var template (omit) EUTRA_TargetFreqInfoList_vb50ext v_EUTRA_TargetFreqInfoList_vb50ext := omit;

    //Initialise all cells
    f_UTRAN_Init (EUTRA_UTRAN);

    //Get Cell Parameters for EUTRA cell from EUTRA PTC
    v_EUTRASysInfo := f_IRAT_WaitForCoOrd_SysInfo (EUTRA);

    //Set the Frequency Info accounting for eventual band extension
    v_EARFCN := v_EUTRASysInfo.Eutra[0].Arfcn;
    if (v_EUTRASysInfo.Eutra[0].Arfcn > tsc_EUTRA_MaxEARFCN) { // @sic R5-181145 sic@
      v_EARFCN := tsc_EUTRA_MaxEARFCN;
      v_EUTRA_TargetFreqInfoList_vb50ext := {cs_EUTRA_TargetFreqInfo_vb50ext(v_EUTRASysInfo.Eutra[0].Arfcn)};
    }
 
    //Update SIB19 of cell 5 according to Table 8.5.2.1.3.3-1
    if (v_EUTRASysInfo.Eutra[0].Arfcn < tsc_EUTRA_MaxEARFCN ) {  // EUTRA Band < 64  @sic R5-173010 sic@
        f_UTRAN_SysInfo_SetSIB19(utran_Cell5,
                                 cs_SIB19_UtraAndOneEutraEntry(cs_Utra_PriorityInfoList_Def(v_UtraPriorityValue_T0),
                                                               cs_Eutra_FreqAndPriList_OneEntry_Def(v_EUTRASysInfo.Eutra[0].Arfcn,
                                                                                                    v_EUTRA_MeasurementBandwidth,
                                                                                                    v_EutraPriorityValue_T0)));
    } else { // EUTRA Band > 64   @sic R5-173010 sic@
        f_UTRAN_SysInfo_SetSIB19(utran_Cell5,
                                 cs_SIB19_UtraAndOneEutraEntryExtension(cs_Utra_PriorityInfoList_Def(v_UtraPriorityValue_T0),
                                                                        omit, // @sic R5-174505 sic@
                                                                        {cs_EUTRA_FrequencyAndPriorityInfoExtension_Common(
                                                                                        v_EUTRASysInfo.Eutra[0].Arfcn,
                                                                                        v_EUTRA_MeasurementBandwidth,
                                                                                        v_EutraPriorityValue_T0,
                                                                                        -53,
                                                                                        2,
                                                                                        1,
                                                                                        omit,
                                                                                        true)}));
    }

    //Create and configure Cell 5
    //Cell started switched on with default power level, -60 and max attenuation
    f_UTRAN_SS_CreateCellFACH (utran_Cell5);

    //Start sending System Information
    f_UTRAN_SendDefSysInfo (utran_Cell5);

    //Bring UE to initial state
    f_UTRAN_Preamble (utran_Cell5, true); // @sic R5s160690 sic@
    f_IRAT_SendCoOrd(EUTRA, cms_IRAT_OctetData(valueof(f_UTRAN_MobileInfo_EUTRACapability_Get()))); // @sic R5-123734 sic@

    f_UTRAN_TestBody_Set (true);

    //Derive Quality of service for AT command
    v_QualityOfService := f_UTRAN_InitialiseQoS (utran_Cell5);

    //@siclog "Step 1" siclog@
    //Make the UE initiate an outgoing PS call.
    f_UT_ActivatePDPContextUG (UT,
                               v_DedicatedId,
                               f_ConvertQoS_ForATCommand(v_QualityOfService), // @sic R5-192186 sic@
                               tsc_RandomAPN); // @sic R5s160680 sic@
    
    //@siclog "Step 2" siclog@
    //Receive RRC CONNECTION REQUEST
    if (f_EUTRA_ConvertEutraFDDTDD_FromPIXIT () == FDD) { // @sic R5s160001 sic@
      U_TM.receive(car_RRC_ConnReq(utran_Cell5,
                                   tsc_RB0,
                                   cdr_RRC_ConnReqWith_v860ext(?, cr_RRCConnReq_v860ext(true, ?), cr_RRCConnReq_v690ext_PSDomain))) -> value v_RLC_TR_DATA_IND;
    }
    else {
      U_TM.receive(car_RRC_ConnReq (utran_Cell5,
                                    tsc_RB0,
                                    cdr_RRC_ConnReqWith_v860ext(?, cr_RRCConnReq_v860ext(?, true), cr_RRCConnReq_v690ext_PSDomain))) -> value v_RLC_TR_DATA_IND;
    }

    v_InitialUE_Id := v_RLC_TR_DATA_IND.data.tM_message.uL_CCCH_Message.message_.rrcConnectionRequest.initialUE_Identity;  // @sic R5-150124 sic@
    f_UTRAN_PreliminaryPass (__FILE__, __LINE__, "Test Case 8.5.2.1 Step 2");

    //@siclog "Step 3" siclog@
    //Transmit RRC CONNECTION REJECT
    U_UM.send (cas_DL_CCCH_Data_Req (utran_Cell5,
                                     tsc_RB0,
                                     cs_RRCConnReject(v_InitialUE_Id,  // @sic R5s210654 sic@
                                                      15,
                                                      -,
                                                      cs_RRCConnectionReject_NonCriticalExtensions_EARFCN(v_EARFCN, v_EUTRA_TargetFreqInfoList_vb50ext)))); // @sic R5-181145 sic@

    //Hand over test case to EUTRA PTC, i.e. perform TAU in EUTRA cell
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);

    //Wait till end of test case
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);

    f_UTRAN_TestBody_Set (false);

    //Release the non camping cell
    f_UTRAN_ReleaseCell (utran_Cell5, f_UTRAN_CellInfo_GetConfigType (utran_Cell5) ); // @sic R5s110176 sic@
  }

}
