module IMS_Procedures_5G {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_Component all;
  import from IMS_MessageBody_Templates all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Common all;
  import from IMS_SDP_Messages all;
  import from IMS_SDP_MessagesVideo all;
  import from IMS_SIP_Templates all;
  import from IMS_SMS_Messages all;
  import from IP_ASP_TypeDefs all;
  import from LibSip_Common all;
  import from LibSip_SDPTypes all;
  import from LibSip_SIPTypesAndValues all;
  import from SMS_Templates all;
  import from SMS_TypeDefs all;
  import from UpperTesterFunctions all;

  /*
   * @desc      34.229-5 A.4.1a/2a Step 1: Receive INVITE
   * @param     p_WithPreconditions
   * @param     p_OtherCalleeUri    (default value: omit)
   * @param     p_OriginatingIdentificationRestriction (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_X_Step1(boolean p_WithPreconditions,
                                               template SipUrl p_OtherCalleeUri := omit,
                                               boolean p_OriginatingIdentificationRestriction := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-225925..37: p_EvsConfiguration sic@ */
    /* @sic R5-246482, R5-246478, R5-246479: p_EvsConfiguration removed sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_IMS_MOCallSetup_ReceiveINVITE_Common(p_OtherCalleeUri, -, tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR, p_WithPreconditions, p_OriginatingIdentificationRestriction);
    f_IMS_SDP_CheckMediaDescr_EVS_Configuration(v_InviteRequestWithSdp.SdpOffer.media_list[0], EVS_A2);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.4.1a Step 1: Receive INVITE with preconditions; wrapper function
   * @param     p_OtherCalleeUri    (default value: omit)
   * @param     p_OriginatingIdentificationRestriction (default value: false)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1(template SipUrl p_OtherCalleeUri := omit,
                                                boolean p_OriginatingIdentificationRestriction := false) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    return f_IMS_MOCallSetup_NR5GC_A_4_X_Step1(tsc_SDP_WithPreconditions, p_OtherCalleeUri, p_OriginatingIdentificationRestriction);
  }

  /*
   * @desc      34.229-5 A.4.2a Step 1: Receive INVITE without preconditions
   * @param     p_OtherCalleeUri    (default value: omit)
   * @param     p_PreconditionsForbidden (default value: true)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_2a_Step1(template SipUrl p_OtherCalleeUri := omit,
                                                boolean p_PreconditionsForbidden := true) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_X_Step1(tsc_SDP_WithoutPreconditions, p_OtherCalleeUri);

    f_IMS_CheckNoPreconditions(p_PreconditionsForbidden, v_InviteRequestWithSdp.Invite.msgHeader, v_InviteRequestWithSdp.SdpOffer);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.4.1a/2a Step 3 - 5: Send 183 Session Progress, receive PRACK, send 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUriSS      (default value: px_IMS_CalleeContactUri)
   * @param     p_AditionalContactParams (default value: omit)
   * @param     p_Allow             (default value: omit)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @param     p_BandwidthAS       (default value: 65)
   * @param     p_WithPreconditions
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 charstring p_ContactUriSS := px_IMS_CalleeContactUri,
                                                 template (omit) SemicolonParam_List p_AditionalContactParams := omit,
                                                 template (omit) Allow p_Allow := omit,
                                                 IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000,
                                                 integer p_BandwidthAS := 65,
                                                 boolean p_WithPreconditions) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-246478, R5-246479: p_EvsConfiguration removed sic@ */
    var template (value) SDP_Message v_SDP_Message183 := f_IMS_BuildSDP_InitialAnswerAudio_TX(p_InviteRequestWithSdp.SdpOffer, p_WithPreconditions, p_AudioCodec, EVS_A2, p_BandwidthAS);
    var OptionTag_List v_OptionTagsForRequire := tsc_OptionTagList_100rel;
    var template (value) MessageHeader v_MessageHeader_Response183;

    if (p_WithPreconditions) {
      v_OptionTagsForRequire := v_OptionTagsForRequire & tsc_OptionTagList_precondition;
    }
    
    v_MessageHeader_Response183 := f_IMS_InviteResponse_183_MessageHeaderTX(p_InviteRequestWithSdp.Invite, p_ContactUriSS, p_AditionalContactParams, v_OptionTagsForRequire, p_CallType);
    v_MessageHeader_Response183.allow := p_Allow;
    return f_IMS_MOCallSetup_Send18X_Reliable(p_InviteRequestWithSdp, c_statusLine183, v_MessageHeader_Response183, v_SDP_Message183, p_CallType); /* @sic R5-213531, R5-214884: p_CallType sic@ */
  }

  /*
   * @desc      34.229-5 A.4.1a Step 2 - 5: Send 100 Trying, send 183 Session Progress, receive PRACK, send 200 OK
   *            returns MessageHeader of 183 response
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUriSS      (default value: px_IMS_CalleeContactUri)
   * @param     p_Allow             (default value: omit)
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  charstring p_ContactUriSS := px_IMS_CalleeContactUri,
                                                  template (omit) Allow p_Allow := omit) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  {
    f_IMS_MOCallSetup_Send100Trying(p_InviteRequestWithSdp);
    return f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(p_InviteRequestWithSdp, p_ContactUriSS, -, p_Allow, -, EVS_16000, -, tsc_SDP_WithPreconditions);
  }

  /*
   * @desc      34.229-5 A.4.2a Step 2 - 5: Send 100 Trying, send 183 Session Progress, receive PRACK, send 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUriSS      (default value: px_IMS_CalleeContactUri)
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_2a_Step2_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  charstring p_ContactUriSS := px_IMS_CalleeContactUri) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  {
    f_IMS_MOCallSetup_Send100Trying(p_InviteRequestWithSdp);
    return f_IMS_MOCallSetup_NR5GC_A_4_X_Step3_5(p_InviteRequestWithSdp, p_ContactUriSS, -, -, -, EVS_16000, -, tsc_SDP_WithoutPreconditions);
  }

  /*
   * @desc      34.229-5 A.4.1a Step 6 - 7: Receive UPDATE, send 200 OK
   *            returns the SDP offer which has been contained in the UPDATE
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUri        (default value: px_IMS_CalleeContactUri)
   * @param     p_GeolocationInfoAvailable (default value: false)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @param     p_PreconditionIndication (default value: PreconditionRequired)
   * @return    SDP_Message
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  charstring p_ContactUri := px_IMS_CalleeContactUri,
                                                  boolean p_GeolocationInfoAvailable := false,
                                                  IMS_CallType_Type p_CallType := NORMAL_CALL,
                                                  IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000,
                                                  IMS_PreconditionIndication_Type p_PreconditionIndication := PreconditionRequired) runs on IMS_PTC return SDP_Message
  { /* @sic R5-246478: p_EvsConfiguration removed sic@ */
    var template (present) SDP_Message v_ExpectedSdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_RX(p_InviteRequestWithSdp.SdpOffer, -, p_AudioCodec, EVS_A2);  /* @sic R5s210392, R5s210397, R5-213523: no a=sendrecv sic@ */
    var SDP_Message v_ReceivedSdpOffer := f_IMS_MOCallSetup_ReceiveUpdateSend200OK(p_InviteRequestWithSdp.Invite, p_ContactUri, v_ExpectedSdpOffer, p_GeolocationInfoAvailable, p_CallType, p_PreconditionIndication);

    return v_ReceivedSdpOffer;
  }

  /*
   * @desc      34.229-5 A.4.2a Step 6: Send 180 Ringing (without 100rel)
   * @param     p_InviteRequestWithSdp
   * @param     p_OptionTagsForRequired  (default value: tsc_OptionTagList_Empty)
   * @param     p_ContactUri        (default value: px_IMS_CalleeContactUri)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                OptionTag_List p_OptionTagsForRequired := tsc_OptionTagList_Empty,
                                                charstring p_ContactUri := px_IMS_CalleeContactUri,
                                                IMS_CallType_Type p_CallType := NORMAL_CALL) runs on IMS_PTC
  { // @sic R5-236894: p_OptionTagsForRequired sic@
    var template (value) IMS_RoutingInfo_Type v_RoutingInfo_DL := f_IMS_RoutingInfo_ULtoDL(p_InviteRequestWithSdp.RoutingInfo);
    var template (value) MessageHeader v_MessageHeader180 := f_IMS_InviteResponse_180_MessageHeaderTX(p_InviteRequestWithSdp.Invite, p_ContactUri, -, p_OptionTagsForRequired, p_CallType);

    IMS_Server.send(cas_IMS_DATA_RSP(v_RoutingInfo_DL, cs_Response(c_statusLine180, v_MessageHeader180)));
    if (match(p_OptionTagsForRequired, superset(c_tag100rel))) {                // @sic R5-241190 sic@
      f_IMS_MOCallSetup_ReceivePRACK_Send200OK(p_InviteRequestWithSdp, v_MessageHeader180);
    }
  }

  /*
   * @desc      34.229-5 A.4.1a Step 8 - 12 of MO Call establishment with preconditions
   * @param     p_InviteRequestWithSdp
   * @param     p_ContactUri        (default value: px_IMS_CalleeContactUri)
   * @param     p_CallType          (default value: NORMAL_CALL)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_1a_Step8_12(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                   charstring p_ContactUri := px_IMS_CalleeContactUri,
                                                   IMS_CallType_Type p_CallType := NORMAL_CALL) runs on IMS_PTC
  {
    f_IMS_MOCallSetup_Send180_Reliable(p_InviteRequestWithSdp, p_ContactUri, p_CallType);       //   @sic R5s230324 sic@
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(p_InviteRequestWithSdp, p_ContactUri, p_CallType);   //   @sic R5s230324 sic@
  }

  /*
   * @desc      34.229-5 A.4.2a Step 6 - 8 of MO Call establishment without preconditions
   * @param     p_InviteRequestWithSdp
   * @param     p_OptionTagsForRequired  (default value: tsc_OptionTagList_Empty)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6_8(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  OptionTag_List p_OptionTagsForRequired := tsc_OptionTagList_Empty) runs on IMS_PTC
  { // @sic R5-236894, R5-241190: p_OptionTagsForRequired sic@
    f_IMS_MOCallSetup_NR5GC_A_4_2a_Step6(p_InviteRequestWithSdp, p_OptionTagsForRequired);
    f_IMS_MOCallSetup_Send200OK_ReceiveACK(p_InviteRequestWithSdp);
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 1: Send INVITE
   * @param     p_WithPreconditions (default value: false)
   * @param     p_AudioCodecList    (default value: tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step1(boolean p_WithPreconditions := false,
                                               IMS_SDP_AudioCodecList_Type p_AudioCodecList := tsc_IMS_SDP_AudioCodecList_EVS_WBAMR_AMR) runs on IMS_PTC return IMS_InviteRequestWithSdp_Type
  { /* @sic R5-231489: p_EvsConfiguration (A2 is the default configuration) sic@ */
    /* @sic R5-246480, R5-246481: p_EvsConfiguration removed sic@ */
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_IMS_MTCallSetup_BuildInviteRequestWithSdp(p_AudioCodecList, EVS_A2, p_WithPreconditions);

    IMS_Client.send(cas_IMS_Invite_Request(v_InviteRequestWithSdp.RoutingInfo, v_InviteRequestWithSdp.Invite));

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 1: Receive 100 Trying and 183 Session Progress
   * @param     p_InviteRequestWithSdp
   * @param     p_WithPreconditions
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @return    IMS_ResponseWithSdp_Type
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 boolean p_WithPreconditions,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-230323: p_EvsConfiguration sic@ */
    /* @sic R5-246480, R5-246481: p_EvsConfiguration removed, f_IMS_CheckNoPreconditions removed as in A.5.2a precondition attributes and precondition option tag are not checked to be not present sic@ */
    var INVITE_Request v_InviteRequest := p_InviteRequestWithSdp.Invite;
    var InternetProtocol_Type v_Protocol := p_InviteRequestWithSdp.RoutingInfo.Protocol;
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_InitialAnswerAudio_RX(p_AudioCodec, EVS_A2, p_WithPreconditions);

    return f_IMS_MTCallSetup_Receive100Trying_Receive183SessionProgress(v_InviteRequest, v_SdpAnswer, v_Protocol, p_WithPreconditions);   /* @sic R5s210334: p_WithPreconditions sic@ */
  }

  /*
   * @desc      34.229-5 A.5.1a/2a Step 2 - 5
   * @param     p_InviteRequestWithSdp
   * @param     p_WithPreconditions
   * @return    IMS_ResponseWithSdp_Type
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_5(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 boolean p_WithPreconditions,
                                                 IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC return IMS_ResponseWithSdp_Type
  { /* @sic R5-246480, R5-246481: p_EvsConfiguration removed sic@ */
    var IMS_ResponseWithSdp_Type v_ResponseWithSdp;

    v_ResponseWithSdp := f_IMS_MTCallSetup_NR5GC_A_5_X_Step2_3(p_InviteRequestWithSdp, p_WithPreconditions, p_AudioCodec);
    f_IMS_MTCallSetup_SendPRACK_ReceiveOK(p_InviteRequestWithSdp.Invite, v_ResponseWithSdp.Response.msgHeader);
    return v_ResponseWithSdp;
  }

  /*
   * @desc      Send UPDATE with preconditions, receive 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_SdpOffer
   * @param     p_SdpAnswer
   * @param     p_PreconditionIndication (default value: PreconditionRequired)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_SendUPDATE_Receive200OK(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                           template (value) SDP_Message p_SdpOffer,
                                                           template (present) SDP_Message p_SdpAnswer,
                                                           IMS_PreconditionIndication_Type p_PreconditionIndication := PreconditionRequired) runs on IMS_PTC
  {
    var InternetProtocol_Type v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();
    var SipUrl v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    var template (value) MessageHeader v_MessageHeader_Update := f_IMS_UpdateRequest_MessageHeaderTX(p_InviteRequestWithSdp.Invite, p_PreconditionIndication);
    var template (present) MessageHeader v_MessageHeader_200OK := f_IMS_OtherResponse_200_MessageHeaderRX(v_MessageHeader_Update, cr_ContentTypeSDP);
    var IMS_DATA_RSP v_IMS_DATA_RSP;

    IMS_Client.send(cas_IMS_Update_Request(cs_IMS_RoutingInfo(v_Protocol), cs_UPDATE_Request(v_ContactUrl, v_MessageHeader_Update, cs_MessageBody_SDP(p_SdpOffer))));

    v_IMS_DATA_RSP := f_IMS_ReceiveResponse(v_MessageHeader_Update, v_Protocol, cr_Response(c_statusLine200, v_MessageHeader_200OK, cr_MessageBody_SDP));
    f_IMS_SIP_SdpMessageBody_DecodeMatchAndCheckSDP(v_IMS_DATA_RSP.Response.messageBody, p_SdpAnswer);
  }

  /*
   * @desc      34.229-5 A.5.1a Step 6 - 7: Send UPDATE with preconditions, receive 200 OK
   * @param     p_InviteRequestWithSdp
   * @param     p_SessionProgress183
   * @param     p_AudioCodec        (default value: EVS_16000)
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_A_5_1a_Step6_7(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                  IMS_ResponseWithSdp_Type p_SessionProgress183,
                                                  IMS_SDP_AudioCodec_Type p_AudioCodec := EVS_16000) runs on IMS_PTC
  {
    var SDP_Message v_SDP_Message183 := p_SessionProgress183.SdpMessage;
    var template (value) SDP_Message v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudio_TX(v_SDP_Message183, p_AudioCodec);
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_FinalAnswerAudio_RX(p_AudioCodec);
    
    f_IMS_MTCallSetup_NR5GC_SendUPDATE_Receive200OK(p_InviteRequestWithSdp, v_SdpOffer, v_SdpAnswer);
  }

  /*
   * @desc      34.229-5 A.5.2 Step 8A - 10: Accept call, receive 200 OK and send ACK
   * @param     p_InviteRequestWithSdp
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_AcceptAndAcknowledge(IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp) runs on IMS_PTC
  {
    f_UT_AnswerCall(MMI);                       // @sic R5-210056 sic@
    f_IMS_MTCallSetup_Receive200OK_SendACK(p_InviteRequestWithSdp);
  }

    /*
   * @desc      To receive and check MESSAGE request
   * @param     p_VerdictFiltering  (default value: false)
   * @return    IMS_DATA_REQ
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_NR5GC_MO_SMS_Step1(boolean p_VerdictFiltering := false) runs on IMS_PTC return IMS_DATA_REQ
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MessageHeader v_MessageHeader;
    var MESSAGE_Request v_MESSAGE_RequestRX;
    var octetstring v_EncodedSMS;
    var template (present) SipUrl v_SipUrl_PsiSmsc := ?; /* @sic R5s140304, R5-142157 sic@
                                                            @sic R5-152094: Request URI not to be checked sic@ */
    var SipUrl v_RequestURI_MO;

    // @siclog "Step 1 resp 2" siclog@
    // Step 1. UE sends a short message
    // Contents in 34.229-1 Annex A.7.3
    // Check: Does UE send a SIP MESSAGE request including a vnd.3gpp.sms payload that contains a short message?
    v_IMS_DATA_REQ := f_IMS_MessageRequest_Receive(v_SipUrl_PsiSmsc, f_IMS_MessageRequest_MessageHeaderRX_MO_SMS(v_SipUrl_PsiSmsc));           /* @sic R5s130370 change 4 sic@ */
    v_MESSAGE_RequestRX := v_IMS_DATA_REQ.Request.Message;
    v_MessageHeader := v_MESSAGE_RequestRX.msgHeader;
    v_RequestURI_MO := v_MESSAGE_RequestRX.requestLine.requestUri;

    if (not f_SIP_SipUrl_Compare(v_RequestURI_MO, f_Addr_Union_GetSipUrl(v_MessageHeader.toField.addressField))) {  /* @sic R5-152094: Request URI and To URI shall be the same sic@ */
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "addr-spec of To header shall be the same as Request URI")
    }
    v_EncodedSMS := v_MESSAGE_RequestRX.messageBody.smsMessage;
    f_SMS_PDU_DecodeAndMatchRPDATA(v_EncodedSMS, cr_SMS_RP_DATA_ul_SUBMIT_IMS);
    if (not p_VerdictFiltering) {
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "UE sends SIP Message containing a short message");
    }
    return v_IMS_DATA_REQ;
  }

  /*
   * @desc      To continue expected sequence of 34.229-1 cl. 18.1 resp. 34.229-5 9.1 after initial MESSAGE request
   * @param     p_IMS_DATA_REQ
   * @param     p_VerdictFiltering  (default value: false)
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_NR5GC_MO_SMS_Step2to8(IMS_DATA_REQ p_IMS_DATA_REQ,
                                       boolean p_VerdictFiltering := false) runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ;
    var MESSAGE_Request v_MESSAGE_RequestRX := p_IMS_DATA_REQ.Request.Message;
    var template (value) MessageHeader v_MessageHeader_MessageMT;
    var MessageHeader v_MessageHeader := v_MESSAGE_RequestRX.msgHeader;
    var RP_DATA_ul_Type v_MoSMS;
    var template (value) RP_ACK_Type v_RPAck_TX;
    var octetstring v_EncodedSMS;
    var template (value) RP_DATA_dl_Type v_SMSdl_StatusReport;
    var SipUrl v_ContactUrl;
    var InternetProtocol_Type v_Protocol;
    var SipUrl v_PAssertedIDUrl;
    var bitstring v_Bitstring;
    var integer v_CSeqValue := tsc_MESSAGE_CSeqValue;
    var SipUrl v_RequestURI_MO := v_MESSAGE_RequestRX.requestLine.requestUri;
    var CallidString v_PrevCallId := v_MessageHeader.callId.callid;
    var CharStringList_Type v_PrevCallIdList := {};

    v_PrevCallIdList := f_CharStringList_Add(v_PrevCallIdList, v_PrevCallId);
    
    v_ContactUrl := f_IMS_PTC_ImsInfo_GetContactUrlUE();
    
    v_EncodedSMS := v_MESSAGE_RequestRX.messageBody.smsMessage;
    v_Bitstring := oct2bit(v_EncodedSMS);
    if (decvalue(v_Bitstring, v_MoSMS) != 0) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "cannot decode v_MoSMS");
    }

    // @siclog "Step 2 resp 3" siclog@
    // SS responds with 202 Accepted
    IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(p_IMS_DATA_REQ.RoutingInfo), cs_Response(c_statusLine202, f_IMS_Accepted_202_MessageHeaderTX(v_MessageHeader))));
    
    // @siclog "Step 3 resp 4" siclog@
    // SS sends a SIP MESSAGE request including a vnd.3gpp.sms payload that contains the short message submission report indicating a positive acknowledgement of the short message sent by the UE at Step 2
    v_RPAck_TX := cs_RP_ACK_SUBMIT_REPORT(v_MoSMS.rP_MessageReference);
    v_EncodedSMS := f_SMS_PDU_EncodeRPACK(v_RPAck_TX);
    v_Protocol := f_IMS_PTC_ImsInfo_GetTransportProtocol();             // @sic R5s130514 change 2 sic@
    v_MessageHeader_MessageMT := f_IMS_MessageRequest_MessageHeaderTX_SubmissionReport(v_Protocol, v_RequestURI_MO, v_PrevCallId, v_CSeqValue);   /* @sic R5s130235 change 4a  R5-131269 sic@ */
    IMS_Client.send(cas_IMS_Message_Request(cs_IMS_RoutingInfo(v_Protocol), cs_MESSAGE_Request(v_ContactUrl, v_MessageHeader_MessageMT, cs_MessageBody_SMS(v_EncodedSMS))));
    v_PrevCallId := valueof(v_MessageHeader_MessageMT.callId.callid);
    v_PrevCallIdList := f_CharStringList_Add(v_PrevCallIdList, v_PrevCallId);
    
    // @siclog "Step 4 resp 5" siclog@
    // Check: Does UE respond with 200 OK?
    f_IMS_ReceiveResponse(v_MessageHeader_MessageMT, v_Protocol, cr_Response(c_statusLine200, f_IMS_OtherResponse_200_MessageHeaderRX(v_MessageHeader_MessageMT)));  /* @sic R5s140350 sic@ */
    if (not p_VerdictFiltering) {
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "UE sends 200 OK");
    }
   
    // @siclog "Step 5 resp 6" siclog@
    // SS sends a SIP MESSAGE request including a vnd.3gpp.sms payload that contains a status report
    v_SMSdl_StatusReport := cs_RP_DATA_dl_STATUS_REPORT(v_MoSMS.rP_UserData.tP_PDU.SMS_SUBMIT.tP_MessageReference, // Use reference of SMS received in step 1
                                                        v_MoSMS.rP_UserData.tP_PDU.SMS_SUBMIT.tP_DestinationAddress,
                                                        v_RPAck_TX.rP_UserData.tP_PDU.SMS_SUBMIT_REPORT.tP_ServiceCentreTimeStamp);
    v_EncodedSMS := f_SMS_PDU_EncodeRPDATA(v_SMSdl_StatusReport);
    v_MessageHeader_MessageMT := f_IMS_MessageRequest_MessageHeaderTX_StatusReport(v_Protocol, v_RequestURI_MO, v_CSeqValue + 1);   /* @sic R5s130235 change 4   R5-131269 sic@ */
    IMS_Client.send(cas_IMS_Message_Request(cs_IMS_RoutingInfo(v_Protocol), cs_MESSAGE_Request(v_ContactUrl, v_MessageHeader_MessageMT, cs_MessageBody_SMS(v_EncodedSMS))));
    v_PrevCallId := valueof(v_MessageHeader_MessageMT.callId.callid);
    v_PrevCallIdList := f_CharStringList_Add(v_PrevCallIdList, v_PrevCallId);
    
    // @siclog "Step 6 resp 7" siclog@
    // Check: Does UE respond with 200 OK?
    f_IMS_ReceiveResponse(v_MessageHeader_MessageMT, v_Protocol, cr_Response(c_statusLine200, f_IMS_OtherResponse_200_MessageHeaderRX(v_MessageHeader_MessageMT)));  /* @sic R5s140350 sic@ */
    if (not p_VerdictFiltering) {
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "UE sends 200 OK");
    }
    
    // @siclog "Step 7 resp 8" siclog@
    // Check: Does UE send a SIP MESSAGE request including a vnd.3gpp.sms payload that contains an acknowledgement for the status report received at Step 6?
    v_PAssertedIDUrl := f_Addr_Union_GetSipUrl(v_MessageHeader_MessageMT.pAssertedID.pAssertedIDValueList[0]); // @sic R5-130685 R5s130235 sic@
    v_IMS_DATA_REQ := f_IMS_MessageRequest_Receive(v_PAssertedIDUrl,
                                                   f_IMS_MessageRequest_MessageHeaderRX_DeliveryReport(v_PAssertedIDUrl, v_PrevCallId),
                                                   v_PrevCallIdList);    /* @sic R5s130235 change 4d  R5-131269 sic@ */
    v_MESSAGE_RequestRX := v_IMS_DATA_REQ.Request.Message;
    v_MessageHeader := v_MESSAGE_RequestRX.msgHeader;
    v_EncodedSMS := v_MESSAGE_RequestRX.messageBody.smsMessage;
    f_SMS_PDU_DecodeAndMatchRPACK(v_EncodedSMS, cr_RP_ACK_ul);  // @sic R5-130685 sic@
    if (not p_VerdictFiltering) {
      f_IMS_PreliminaryPass(__FILE__, __LINE__, "UE sends SIP message containing a Delivery Report");
    }
    
    // @siclog "Step 8 resp 9" siclog@
    // SS responds with 202 Accepted
    IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo), cs_Response(c_statusLine202, f_IMS_Accepted_202_MessageHeaderTX(v_MessageHeader))));
  }

  /*
   * @desc      Steps 6 and 7 of Annex A.16.1a
   * @param     p_VideoCallType
   * @param     p_InviteRequestWithSdp
   * @param     p_SessionProgress183
   * @status    APPROVED (IMS)
   */
  function f_IMS_MTCallSetup_NR5GC_Video_Step6_7(VideoCallTypeMT_Type p_VideoCallType,
                                                 IMS_InviteRequestWithSdp_Type p_InviteRequestWithSdp,
                                                 IMS_ResponseWithSdp_Type p_SessionProgress183) runs on IMS_PTC
  {
    var IMS_PreconditionIndication_Type v_PreconditionIndication;
    var SDP_Message v_PrevSdpFromUE := p_SessionProgress183.SdpMessage;
    var template (value) SDP_Message v_SdpOffer := f_IMS_BuildSDP_UpdatedOfferAudioVideo_TX(p_VideoCallType, EVS_16000, H265_90000, v_PrevSdpFromUE);
    var template (present) SDP_Message v_SdpAnswer := f_IMS_BuildSDP_MTCallAudioVideo_RX(p_VideoCallType, FinalAnswer, EVS_16000, -, -, H265_90000);

    if (p_VideoCallType == AddVideo) {
      v_PreconditionIndication := PreconditionSupported;
    } else {
      v_PreconditionIndication := PreconditionRequired;
    }
    f_IMS_MTCallSetup_NR5GC_SendUPDATE_Receive200OK(p_InviteRequestWithSdp, v_SdpOffer, v_SdpAnswer, v_PreconditionIndication);
  }

  /*
   * @desc      34.229-5 A.6
   * @param     p_Context           (default value: A_2_1_A7)
   * @param     p_GeolocationInfoAvailable (default value: false)
   * @param     p_OtherCalleeUri    (default value: omit)
   * @return    INVITE_Request
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_EmergencyCallSetup_NR5GC_A_6(INVITE_A_2_1_Context_Type p_Context := A_2_1_A7,
                                              boolean p_GeolocationInfoAvailable := false, // @sic R5-220214 sic@
                                              template SipUrl p_OtherCalleeUri := omit) runs on IMS_PTC return INVITE_Request
  {
    var IMS_DATA_REQ v_IMS_DATA_REQ;

    v_IMS_DATA_REQ := f_IMS_EmergencyCallSetup_NR5GC_A_6_Step1(p_Context, p_GeolocationInfoAvailable, p_OtherCalleeUri);
    return f_IMS_EmergencyCallSetup_NR5GC_A_6_Step2ToEnd(v_IMS_DATA_REQ); // @sic R5s210875 sic@
  }

  /*
   * @desc      34.229-5 A.6 Step 1
   * @param     p_Context           (default value: A_2_1_A7)
   * @param     p_GeolocationInfoAvailable (default value: false)
   * @param     p_OtherCalleeUri    (default value: omit)
   * @return    IMS_DATA_REQ
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_EmergencyCallSetup_NR5GC_A_6_Step1(INVITE_A_2_1_Context_Type p_Context := A_2_1_A7,
                                                    boolean p_GeolocationInfoAvailable := false, // @sic R5-220214 sic@
                                                    template SipUrl p_OtherCalleeUri := omit) runs on IMS_PTC return IMS_DATA_REQ
  { // This is the same as step 1 of 34.229-1 C.22
    return f_IMS_EmergencyCallSetup_Step1(p_Context,
                                          p_GeolocationInfoAvailable,
                                          p_OtherCalleeUri);
  }

  /*
   * @desc      Emergency speech call setup according to 34.229-5 Annex A.6 (apart from Invite)
   * @param     p_IMS_DATA_REQ
   * @return    INVITE_Request
   * @status    APPROVED (IMS, NR5GC)
   */
  function f_IMS_EmergencyCallSetup_NR5GC_A_6_Step2ToEnd(IMS_DATA_REQ p_IMS_DATA_REQ) runs on IMS_PTC return INVITE_Request  // @sic R5-220214 sic@
  { /* @sic R5-231989: p_GeolocationInfoAvailable removed sic@ */
    var INVITE_Request v_INVITE_Request;
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("Add Voice Bearer")); // @sic R5-225362 sic@
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Voice Bearer Added");  // @sic R5s220531, R5-225362, R5s230615 sic@
    v_INVITE_Request := f_IMS_EmergencyCallSetup_Step2ToEnd (p_IMS_DATA_REQ);
    return v_INVITE_Request;
  }

}
