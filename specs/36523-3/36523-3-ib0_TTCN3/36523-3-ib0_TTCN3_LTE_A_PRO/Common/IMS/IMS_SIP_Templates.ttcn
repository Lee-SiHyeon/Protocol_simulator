  /*
   * @desc      return superset of mandatory parameters
   * @param     p_MandatoryParamList
   * @return    template SemicolonParam_List
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function f_SIP_SemicolonParamsRX(template (present) SemicolonParam_List p_MandatoryParamList) return template SemicolonParam_List
  {
    var template SemicolonParam_List v_SemicolonParamsRX := *;
    if (lengthof(p_MandatoryParamList) > 0) {
      v_SemicolonParamsRX := superset(all from p_MandatoryParamList);
    }
    return v_SemicolonParamsRX;
  }

  template (value) GenericParam cs_SigCompParam := cs_GenericParam("comp", "sigcomp");     /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS) */

