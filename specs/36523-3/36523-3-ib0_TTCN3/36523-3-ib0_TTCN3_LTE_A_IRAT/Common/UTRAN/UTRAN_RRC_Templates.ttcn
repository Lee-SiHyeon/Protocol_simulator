  template (present) UL_DCCH_Message cr_108_RB_SetUpCmpl(RRC_TransactionIdentifier p_RRC_Ti,
                                                         template START_Value p_StartValue:= ?) :=
  { /* ASN.1 PDU Constraint defined in TS 34.108 clause 9 */
