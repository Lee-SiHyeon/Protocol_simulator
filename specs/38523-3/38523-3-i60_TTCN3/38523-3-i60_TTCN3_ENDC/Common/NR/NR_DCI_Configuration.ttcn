  template (value) NR_DciFormat_1_0_P_RNTI_TrsAvailabilityIndication_Type cs_NR_DciFormat_1_0_P_RNTI_TrsAvailabilityIndication_None := { None := true }; /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cs_NR_DciFormat_1_0_Params(SubcarrierSpacing p_SCS,
                                                                                 template (omit) NR_DciFormat_X_0_ChannelAccessCPext_Type p_NR_DciFormat_X_0_ChannelAccessCPext := cs_NR_DciFormat_X_0_ChannelAccessCPext_None) := //SharedSpectrum
  { /* 38.508-1 Table 4.3.6.1.2.1-1 */
    /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
    Format_1_0 := {
      DAI := {
        Index := cs_DAI_B2_Automatic //@sic R5-202677, R5-201572 sic@
      },
      TpcCommandPucch := cs_NR_DciCommon_TpcCommand,                                    /* default TPC command: 0 dB ('01'B) */
      PucchResourceIndicator := cs_NR_DciFormat_1_X_PucchResourceIndicator('110'B),     /* @sic R5-201195: '110'B instead of '000'B sic@ */
      PdschHarqTimingIndicator := fl_NR_DciFormat_1_0_PdschHarqTimingIndicator(p_SCS),  /* @sic R5s190442, R5-196995 sic@ */
      ChannelAccessCPext := p_NR_DciFormat_X_0_ChannelAccessCPext                       /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    }
  };

  template (value) NR_DciFormat_1_X_SpecificInfo_Type cds_NR_DciFormat_1_0_Params_SetPDSCHarqIndicator(SubcarrierSpacing p_SCS,
                                                                                                       template (omit) NR_DciFormat_X_0_ChannelAccessCPext_Type p_NR_DciFormat_X_0_ChannelAccessCPext := cs_NR_DciFormat_X_0_ChannelAccessCPext_None, //SharedSpectrum: added here because it was added in root template
                                                                                                       template (value) NR_DciFormat_1_X_PdschHarqTimingIndicator_Type p_HarqTiming)
  modifies cs_NR_DciFormat_1_0_Params:=
  { /* @status    APPROVED (ENDC, NR5GC) */
