  /*
   * @desc      Check the profile index of the given POC Settings
   * @param     p_PocSettings
   * @param     p_SelectedUserProfileIndex
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_PocSettings_CheckProfileIndex(PocSettings_Type p_PocSettings,
                                                    template (present) PocSettings_SelectedProfileIndex_Type p_SelectedUserProfileIndex) runs on IMS_PTC
  { /* NOTE : function may need to be extended as a Rel-18 may provide a <multiplex-support> element in the any-extension of the entity and <multiplex-support> and <selected-user-profile-index> may occur in any order */
    var PocSettings_SelectedProfileIndex_Type v_SelectedProfileIndex := f_MCX_PocSettings_SelectedUserProfileIndex_Decode(p_PocSettings.entity_list[0].elem_list[0]);
    if (not match(v_SelectedProfileIndex, p_SelectedUserProfileIndex)) {
      f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid user-profile-index in PoC-Settings in MIME body");
    }
  }

  /*
   * @desc      Decode and match all XML bodies contained in the given MIME message
   * @param     p_MIME_Message
   * @param     p_ServiceType
   * @param     p_KeyIndex          (default value: CSK)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McpttInfoExt      (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McvideoInfoExt    (default value: omit)
   * @param     p_McdataInfo        (default value: omit)
   * @param     p_McdataInfoExt     (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @param     p_McvideoLocationInfo (default value: omit)
   * @param     p_McdataLocationInfo (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_PocSettings       (default value: omit)
   * @param     p_PIDF              (default value: omit)
   * @param     p_AffiliationCmd    (default value: omit)
   * @param     p_SimpleFilter      (default value: omit)
   * @return    MCX_MIME_XmlBodies_Type
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_DecodeAndMatchXML(MIME_Message p_MIME_Message,
                                        MCX_ServiceType_Type p_ServiceType,
                                        MCX_KeyIndex_Type p_KeyIndex := CSK,
                                        template MCPTT_Info_Type p_McpttInfo := omit,
                                        template McpttInfoExt_ElementList_Type p_McpttInfoExt := omit,
                                        template MCVideo_Info_Type p_McvideoInfo := omit,
                                        template McvideoInfoExt_ElementList_Type p_McvideoInfoExt := omit,
                                        template MCData_Info_Type p_McdataInfo := omit,
                                        template McdataInfoExt_ElementList_Type p_McdataInfoExt := omit,
                                        template MCPTT_LocationInfo_Type p_McpttLocationInfo := omit,
                                        template MCVideo_LocationInfo_Type p_McvideoLocationInfo := omit,
                                        template MCData_LocationInfo_Type p_McdataLocationInfo := omit,
                                        template ResourceLists_Type p_ResourceLists := omit,
                                        template PocSettings_Type p_PocSettings := omit,
                                        template MCX_PIDF_Type p_PIDF := omit,
                                        template MCX_Affiliation_CommandList_Type p_AffiliationCmd := omit,
                                        template MCX_SimpleFilter_Type p_SimpleFilter := omit) runs on MCX_IMS_PTC return MCX_MIME_XmlBodies_Type
  {
    var charstring v_MCServiceID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var template (omit) MCX_SecurityKey_Type v_CSK := f_MCX_IMS_PTC_SecurityParameters_GetKey(p_KeyIndex);
    var template (value) MCX_MIME_XmlBodies_Type v_XmlBodies := cs_MCX_MIME_XmlBodies_AllOmit;
    
    v_XmlBodies.McpttInfo           := fl_MIME_DecodeAndMatchMcpttInfo(p_MIME_Message, p_McpttInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.McvideoInfo         := fl_MIME_DecodeAndMatchMcvideoInfo(p_MIME_Message, p_McvideoInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.McdataInfo          := fl_MIME_DecodeAndMatchMcdataInfo(p_MIME_Message, p_McdataInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.McpttLocationInfo   := fl_MIME_DecodeAndMatchMcpttLocation(p_MIME_Message, p_McpttLocationInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.McvideoLocationInfo := fl_MIME_DecodeAndMatchMcvideoLocation(p_MIME_Message, p_McvideoLocationInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.McdataLocationInfo  := fl_MIME_DecodeAndMatchMcdataLocation(p_MIME_Message, p_McdataLocationInfo, v_MCServiceID, v_CSK);
    v_XmlBodies.ResourceLists       := fl_MIME_DecodeAndMatchResourceLists(p_MIME_Message, p_ResourceLists, v_MCServiceID, v_CSK);
    v_XmlBodies.SimpleFilter        := fl_MIME_DecodeAndMatchSimpleFilter(p_MIME_Message, p_SimpleFilter);
    v_XmlBodies.PIDF                := fl_MIME_DecodeAndMatchPIDF(p_MIME_Message, p_PIDF, p_ServiceType, v_MCServiceID, v_CSK);
    v_XmlBodies.AffiliationCmd      := fl_MIME_DecodeAndMatchAffiliationCmd(p_ServiceType, p_MIME_Message, p_AffiliationCmd);
    v_XmlBodies.PocSettings         := fl_MIME_DecodeAndMatchPocSettings(p_MIME_Message, p_PocSettings);

    if (isvalue (v_XmlBodies.McpttInfo)) {
      v_XmlBodies.McpttInfoExt := f_MCX_McpttInfoExt_DecodeAndMatch(valueof(v_XmlBodies.McpttInfo), p_McpttInfoExt);
    }
    if (isvalue (v_XmlBodies.McvideoInfo)) {
      v_XmlBodies.McvideoInfoExt := f_MCX_McvideoInfoExt_DecodeAndMatch(valueof(v_XmlBodies.McvideoInfo), p_McvideoInfoExt);
    }
    if (isvalue (v_XmlBodies.McdataInfo)) {
      v_XmlBodies.McdataInfoExt := f_MCX_McdataInfoExt_DecodeAndMatch(valueof(v_XmlBodies.McdataInfo), p_McdataInfoExt);
    }

    // Check Signature
    f_MCX_MIME_CheckSignatures(p_MIME_Message, p_ServiceType, v_CSK);

    return valueof(v_XmlBodies);
  }

  /*
   * @desc      Get body part for MIKEY, decode and match the MIKEY
   * @param     p_MIME_Message
   * @param     p_MIKEY_Message
   * @param     p_KeyParametersPayload (default value: *)
   * @return    MIKEY_Message
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_DecodeMatchAndCheckMikeyMessage(MIME_Message p_MIME_Message,
                                                      template (present) MIKEY_Message p_MIKEY_Message,
                                                      template MCX_KeyParametersPayload_Type p_KeyParametersPayload := *) runs on MCX_IMS_PTC return MIKEY_Message
  { // NOTE: MIKEY_Message is assumed to be mandatory present in the MIME message
    var MIME_Part v_MIME_Part := f_IMS_MIME_MessageBody_GetBody(p_MIME_Message, tsc_MimeType_Mikey);
    var MikeyMsg v_MikeyMsg := v_MIME_Part.body.commonText;

    return f_MCX_MIKEY_DecodeMatchAndCheckMikeyMessage(v_MikeyMsg, p_MIKEY_Message, p_KeyParametersPayload);
  }

  /*
   * @desc      Check all signatures of XML bodies contained in the given MIME message
   * @param     p_MIME_Message
   * @param     p_ServiceType
   * @param     p_CSK               (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_CheckSignatures(MIME_Message p_MIME_Message,
                                      MCX_ServiceType_Type p_ServiceType,
                                      template (omit) MCX_SecurityKey_Type p_CSK := omit) runs on IMS_PTC
  {
    var template (present) charstring v_BodyPartsWithNoSignature := (tsc_MimeType_McpttSigned, tsc_MimeType_Mikey, c_sdpApplication, tsc_MimeType_McdataPayload, tsc_MimeType_McdataSignalling,   // MIKEY body and SDP body are no XML bodies
                                                                     tsc_MimeType_Mcpttregroup); // !!!! CORE SPEC ISSUE: It is not clear in 24.379 (clause 6.6.3.1) whether or not the MCPTT-Regroup body shall have a signature !!!!
    var MIME_Part_List v_MIME_Part_List := p_MIME_Message.mimePartList;
    var MIME_Part v_MimePartSignature;
    var XmlBody v_XmlBodySignature;
    var universal charstring v_EncodedSignature;
    var MCX_SecurityKey_Type v_CSK;
    var MIME_Part_Header v_MimePartHeader;
    var charstring v_ContentType;
    var charstring v_AddrSpec;
    var charstring v_ReferenceURI;
    var integer i;

    if (isvalue(p_CSK) and tsc_MCX_XML_IntegrityProtection) {
      v_CSK := valueof(p_CSK);
      v_MimePartSignature := valueof(f_IMS_MIME_MessageBody_FindBody(p_MIME_Message, tsc_MimeType_McpttSigned));  // f_IMS_MIME_MessageBody_FindBody raises fail/inconc if MIME part is not there
      v_XmlBodySignature := v_MimePartSignature.body.xmlBody;
      
      for (i := 0; i < lengthof(v_MIME_Part_List); i := i + 1) {
        v_MimePartHeader := v_MIME_Part_List[i].header;
        v_ContentType := v_MimePartHeader.contentType.typeAndSubtype;
        if (not match(v_ContentType, v_BodyPartsWithNoSignature)) {
          if (not isvalue(v_MimePartHeader.contentId) or not match(v_MimePartHeader.contentId, cr_MimeContentId)) {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "missing or invalid content id for " & v_ContentType);
          }
          v_AddrSpec := f_MIME_ContentId_GetAddrSpec(v_MimePartHeader.contentId);       // @sic R5s230480: f_MIME_ContentId_GetAddrSpec sic@
          v_ReferenceURI := "cid:" & v_AddrSpec;                                        // RFC 2392: cid-url = "cid" ":" content-id
          
          v_EncodedSignature := f_MCX_Signatures_FindSignature(v_XmlBodySignature, v_ReferenceURI);
          if (v_EncodedSignature == "") {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "missing signature for " & v_ContentType);
          }
          if (not f_MCX_XML_CheckDetachedSignature(p_ServiceType, v_MIME_Part_List[i].body.xmlBody, v_ReferenceURI, v_EncodedSignature, v_CSK)) {
            f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "invalid signature for " & v_ContentType);
          }
        }
      }
    }
  }

  /*
   * @desc      Add signatures XML body containing the signatures of the XML bodies of the given list
   * @param     p_ServiceType
   * @param     p_MIME_Part_List
   * @param     p_CSK               (default value: omit)
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_Part_List_AddSignatures(MCX_ServiceType_Type p_ServiceType,
                                              template (value) MIME_Part_List p_MIME_Part_List,
                                              template (omit) MCX_SecurityKey_Type p_CSK := omit) return template (value) MIME_Part_List
  {
    var template (value) MIME_Part_List v_MIME_Part_List := {};
    var template (value) MIME_Part v_MIME_Part;
    var SignatureList_Type v_SignatureList := {};
    var MCX_SecurityKey_Type v_XPK;
    var XSD.String v_EmptySignature;
    var charstring v_Number;
    var charstring v_SignatureId;
    var charstring v_ContentId;
    var charstring v_ReferenceURI;
    var charstring v_MsgId;
    var charstring v_KeyName;
    var integer i;
    var integer k := 0;

    if (isvalue(p_CSK) and tsc_MCX_XML_IntegrityProtection) {
      v_XPK := valueof(p_CSK);
      v_KeyName := f_Base64Encode(v_XPK.Id);    // 33.180 clause 9.3.5
      for (i := 0; i < lengthof(valueof(p_MIME_Part_List)); i := i + 1) {
        v_MIME_Part := p_MIME_Part_List[i];
        if (ischosen(v_MIME_Part.body.xmlBody)) {
          v_Number := int2str(k + 1);
          v_SignatureId := "signature" & v_Number;
          v_ContentId := "content" & v_Number & "@mcx.3gpp.org";
          v_ReferenceURI := "cid:" & v_ContentId;
          v_MsgId := "<" & v_ContentId & ">";
          v_EmptySignature := f_MCX_Signature_Encode(cs_MCX_XML_Signature(v_SignatureId, v_ReferenceURI, v_KeyName));
          v_SignatureList[k] := f_MCX_XML_CreateSignature(p_ServiceType, valueof(v_MIME_Part.body.xmlBody), v_EmptySignature, v_XPK);
          v_MIME_Part.header.contentId := cs_MimeContentId(v_MsgId);
          k := k + 1;
        }
        v_MIME_Part_List[i] := v_MIME_Part;
      }
    } else {
      v_MIME_Part_List := p_MIME_Part_List;
    }
    if (lengthof(v_SignatureList) > 0) {
      v_MIME_Part_List[i] := cs_MIME_Part_XML(tsc_MimeType_McpttSigned, -, -, f_MCX_Signatures_Encode(v_SignatureList));
    }
    return v_MIME_Part_List;
  }

  /*
   * @desc      Build up MIME body list to be sent to the client
   * @param     p_ServiceType
   * @param     p_KeyIndex          (default value: CSK)
   * @param     p_MIME_Part_List
   * @param     p_SDP_Message       (default value: omit)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McdataInfo        (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @param     p_McvideoLocationInfo (default value: omit)
   * @param     p_McdataLocationInfo (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_AffiliationCommand (default value: omit)
   * @param     p_XcapDiff          (default value: omit)
   * @param     p_PIDF              (default value: omit)
   * @param     p_PocSettings       (default value: omit)
   * @param     p_ConferenceInfo    (default value: omit)
   * @param     p_McpttRegroup      (default value: omit)
   * @return    template (value) MIME_Part_List
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_PartList_AddTX(MCX_ServiceType_Type p_ServiceType,
                                     MCX_KeyIndex_Type p_KeyIndex := CSK,
                                     template (value) MIME_Part_List p_MIME_Part_List,
                                     template (omit) SDP_Message p_SDP_Message := omit,
                                     template (omit) MCPTT_Info_Type p_McpttInfo := omit,
                                     template (omit) MCVideo_Info_Type p_McvideoInfo := omit,
                                     template (omit) MCData_Info_Type p_McdataInfo := omit,
                                     template (omit) MCPTT_LocationInfo_Type p_McpttLocationInfo := omit,
                                     template (omit) MCVideo_LocationInfo_Type p_McvideoLocationInfo := omit,
                                     template (omit) MCData_LocationInfo_Type p_McdataLocationInfo := omit,
                                     template (omit) ResourceLists_Type p_ResourceLists := omit,
                                     template (omit) MCX_Affiliation_CommandList_Type p_AffiliationCommand := omit,
                                     template (omit) MCX_XcapDiff_Type p_XcapDiff := omit,
                                     template (omit) MCX_PIDF_Type p_PIDF := omit,
                                     template (omit) PocSettings_Type p_PocSettings := omit,
                                     template (omit) ConferenceInfo_Type p_ConferenceInfo := omit,
                                     template (omit) McpttRegroup_Type p_McpttRegroup := omit)
    runs on MCX_IMS_PTC return template (value) MIME_Part_List
  { /* @sic R5s240690: p_KeyIndex sic@ */
    var template (value) MIME_Part_List v_MIME_Part_List := p_MIME_Part_List;
    var charstring v_MCServiceID := f_MCX_MCService_ID_User_A(p_ServiceType);
    var template (omit) MCX_SecurityKey_Type v_CSK := f_MCX_IMS_PTC_SecurityParameters_GetKey(p_KeyIndex);
    var charstring v_TypeAndSubtype;
    var XmlBody_Type v_XmlBody;

    if (isvalue(p_SDP_Message)) {
      v_MIME_Part_List := f_MIME_Part_List_AddSDP(v_MIME_Part_List, valueof(p_SDP_Message));
    }
    if (isvalue(p_McpttInfo)) {
      v_XmlBody := f_MCX_MCPTTInfo_EncodeEncrypt(valueof(p_McpttInfo), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McpttInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McvideoInfo)) {
      v_XmlBody := f_MCX_MCVideoInfo_EncodeEncrypt(valueof(p_McvideoInfo), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McvideoInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McdataInfo)) {
      v_XmlBody := f_MCX_MCDataInfo_EncodeEncrypt(valueof(p_McdataInfo), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McdataInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McpttLocationInfo)) {
      if (ischosen(p_McpttLocationInfo.choice.report)) {                                        /* according to 24.379 F.3.3 "the contents of the subelements in the <CurrentLocation> subelement of the <Report> element can be encrypted" */
        v_XmlBody := f_MCPTT_LocationInfoReport_EncodeEncrypt(valueof(p_McpttLocationInfo), v_MCServiceID, v_CSK);
      } else {
        v_XmlBody := f_MCPTT_LocationInfo_Encode(valueof(p_McpttLocationInfo));
      }
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McpttLocationInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McvideoLocationInfo)) {
      if (ischosen(p_McvideoLocationInfo.choice.report)) {                                      /* according to 24.281 F.3.3 "the contents of the subelements in the <CurrentLocation> subelement of the <Report> element can be encrypted" */
        v_XmlBody := f_MCVideo_LocationInfoReport_EncodeEncrypt(valueof(p_McvideoLocationInfo), v_MCServiceID, v_CSK);
      } else {
        v_XmlBody := f_MCVideo_LocationInfo_Encode(valueof(p_McvideoLocationInfo));
      }
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McvideoLocationInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McdataLocationInfo)) {
      if (ischosen(p_McdataLocationInfo.choice.report)) {                                       /* according to 24.281 F.3.3 "the contents of the subelements in the <CurrentLocation> subelement of the <Report> element can be encrypted" */
        v_XmlBody := f_MCData_LocationInfoReport_EncodeEncrypt(valueof(p_McdataLocationInfo), v_MCServiceID, v_CSK);
      } else {
        v_XmlBody := f_MCData_LocationInfo_Encode(valueof(p_McdataLocationInfo));
      }
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_McdataLocationInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_ResourceLists)) {
      v_XmlBody := f_MCX_ResourceLists_EncodeEncrypt(valueof(p_ResourceLists), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, c_xmlresourcelistApplication, -, -, v_XmlBody);
    }
    if (isvalue(p_AffiliationCommand)) {
      select (p_ServiceType) {
        case (MCPTT) {
          v_TypeAndSubtype := tsc_MimeType_McpttAffiliationCommand;
        }
        case (MCVideo) {
          v_TypeAndSubtype := tsc_MimeType_McvideoAffiliationCommand;
        }
        case (MCData, MCDataSDS, MCDataFD, MCDataIPCONN) {
          v_TypeAndSubtype := tsc_MimeType_McdataAffiliationCommand;
        }
        case else {
          FatalError(__FILE__, __LINE__, "Invalid service type");
        }
      }
      v_XmlBody := f_MCX_AffiliationCommand_Encode(valueof(p_AffiliationCommand));              /* according to 24.379 F.4 there is no encryption for a affiliate-command and the group URIs are no attribute URIs */
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, v_TypeAndSubtype, -, -, v_XmlBody);
    }
    if (isvalue(p_XcapDiff)) {
      v_XmlBody := f_MCX_XcapDiff_EncodeEncrypt(valueof(p_XcapDiff), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_XcapDiff, -, -, v_XmlBody);
    }
    if (isvalue(p_PIDF)) {
      v_XmlBody := f_MCX_PIDF_EncryptEncode(valueof(p_PIDF), v_MCServiceID, v_CSK);             /* attribute URI encryption */
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_Pidf, -, -, v_XmlBody);
    }
    if (isvalue(p_PocSettings)) {
      v_XmlBody := f_MCX_PocSettings_Encode(valueof(p_PocSettings));                            /* PoC Settings are not encrypted */
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_pocSettings, -, -, v_XmlBody);
    }
    if (isvalue(p_ConferenceInfo)) {
      v_XmlBody := f_MCX_ConferenceInfo_EncodeEncrypt(valueof(p_ConferenceInfo), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_ConferenceInfo, -, -, v_XmlBody);
    }
    if (isvalue(p_McpttRegroup)) {
      v_XmlBody := f_MCX_Mcpttregroup_EncodeEncrypt(valueof(p_McpttRegroup), v_MCServiceID, v_CSK);
      v_MIME_Part_List := f_MIME_Part_List_AddXML(v_MIME_Part_List, tsc_MimeType_Mcpttregroup, -, -, v_XmlBody);
    }

    v_MIME_Part_List := f_MCX_MIME_Part_List_AddSignatures(p_ServiceType, v_MIME_Part_List, v_CSK);

    return v_MIME_Part_List;
  }

  /*
   * @desc      Build up MIME MessageBody to be sent to the client
   * @param     p_ServiceType
   * @param     p_KeyIndex          (default value: CSK)
   * @param     p_SDP_Message       (default value: omit)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McvideoInfo       (default value: omit)
   * @param     p_McdataInfo        (default value: omit)
   * @param     p_McpttLocationInfo (default value: omit)
   * @param     p_McvideoLocationInfo (default value: omit)
   * @param     p_McdataLocationInfo (default value: omit)
   * @param     p_ResourceLists     (default value: omit)
   * @param     p_AffiliationCommand (default value: omit)
   * @param     p_XcapDiff          (default value: omit)
   * @param     p_PIDF              (default value: omit)
   * @param     p_PocSettings       (default value: omit)
   * @param     p_ConferenceInfo    (default value: omit)
   * @param     p_McpttRegroup      (default value: omit)
   * @return    template (value) MessageBody
   * @status    APPROVED (MCX)
   */
  function f_MCX_MIME_MessageBodyTX(MCX_ServiceType_Type p_ServiceType,
                                    MCX_KeyIndex_Type p_KeyIndex := CSK,
                                    template (omit) SDP_Message p_SDP_Message := omit,
                                    template (omit) MCPTT_Info_Type p_McpttInfo := omit,
                                    template (omit) MCVideo_Info_Type p_McvideoInfo := omit,
                                    template (omit) MCData_Info_Type p_McdataInfo := omit,
                                    template (omit) MCPTT_LocationInfo_Type p_McpttLocationInfo := omit,
                                    template (omit) MCVideo_LocationInfo_Type p_McvideoLocationInfo := omit,
                                    template (omit) MCData_LocationInfo_Type p_McdataLocationInfo := omit,
                                    template (omit) ResourceLists_Type p_ResourceLists := omit,
                                    template (omit) MCX_Affiliation_CommandList_Type p_AffiliationCommand := omit,
                                    template (omit) MCX_XcapDiff_Type p_XcapDiff := omit,
                                    template (omit) MCX_PIDF_Type p_PIDF := omit,
                                    template (omit) PocSettings_Type p_PocSettings := omit,
                                    template (omit) ConferenceInfo_Type p_ConferenceInfo := omit,
                                    template (omit) McpttRegroup_Type p_McpttRegroup := omit)
    runs on MCX_IMS_PTC return template (value) MessageBody
  { /* @sic R5s240690: p_KeyIndex sic@ */
    var template (value) MIME_Part_List v_MIME_Part_List := {};
    v_MIME_Part_List := f_MCX_MIME_PartList_AddTX(p_ServiceType,
                                                  p_KeyIndex,
                                                  v_MIME_Part_List,
                                                  p_SDP_Message,
                                                  p_McpttInfo,
                                                  p_McvideoInfo,
                                                  p_McdataInfo,
                                                  p_McpttLocationInfo,
                                                  p_McvideoLocationInfo,
                                                  p_McdataLocationInfo,
                                                  p_ResourceLists,
                                                  p_AffiliationCommand,
                                                  p_XcapDiff,
                                                  p_PIDF,
                                                  p_PocSettings,
                                                  p_ConferenceInfo,
                                                  p_McpttRegroup);
    if (lengthof(v_MIME_Part_List) < 2) {
      FatalError(__FILE__, __LINE__, "Less than 2 MIME body parts for MIME message");
    }
    return cs_MessageBody_MIME(cs_MIME_Message(tsc_MCX_MIME_Boundary, v_MIME_Part_List));
  }

}
