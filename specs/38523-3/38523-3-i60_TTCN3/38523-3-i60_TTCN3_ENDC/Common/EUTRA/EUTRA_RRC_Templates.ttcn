  /*
   * @desc      Convert the SIB_Mpdcch_startSF_CSS_RA_Type to Mpdcch_startSF_CSS_RA_Type
   *            PRACH-ConfigSIB-v1310.mpdcch-startSF-CSS-RA-r13   -->   PRACH-Config-v1310.mpdcch-startSF-CSS-RA-r13
   * @param     p_SIB_MPDCCH
   * @return    template (value) Mpdcch_startSF_CSS_RA_Type
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_ConvertToPRACH_ConfigMpdcchStartSF(template (omit) SIB_Mpdcch_startSF_CSS_RA_Type p_SIB_MPDCCH)
    return template (value) Mpdcch_startSF_CSS_RA_Type
  {
    var template (value) Mpdcch_startSF_CSS_RA_Type v_PRACH_MPDCCH;
    
    if (ischosen(p_SIB_MPDCCH.fdd_r13)){
      select (valueof(p_SIB_MPDCCH.fdd_r13)){
        case(v1)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v1); }
        case(v1dot5){ v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v1dot5); }
        case(v2)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v2); }
        case(v2dot5){ v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v2dot5); }
        case(v4)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v4); }
        case(v5)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v5); }
        case(v8)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v8); }
        case(v10)   { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_FDD(v10); }
        case else {FatalError(__FILE__, __LINE__, "Invalid MpdcchStartSF");}
      }
    } else {
      select (valueof(p_SIB_MPDCCH.tdd_r13)){
        case(v1)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v1); }
        case(v2)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v2); }
        case(v4)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v4); }
        case(v5)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v5); }
        case(v8)    { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v8); }
        case(v10)   { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v10); }
        case(v20)   { v_PRACH_MPDCCH := cs_PRACH_Mpdcch_startSF_CSS_RA_TDD(v20); }
        case else {FatalError(__FILE__, __LINE__, "Invalid MpdcchStartSF");}
       }
    }
    return v_PRACH_MPDCCH;
  }

  /*
   * @desc      Return CQI_ReportModeAperiodic as per 36.508 Table 4.6.3-1A: CQI-ReportAperiodic-r10-DEFAULT
   * @param     p_IsEmtc            (default value: false)
   * @return    template (omit) CQI_ReportModeAperiodic
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_EUTRA_CQI_ReportModeAperiodic(boolean p_IsEmtc := false) return template (omit) CQI_ReportModeAperiodic
  { //@sic R5s170090 change 1.6 R5-171994 R5-171994 sic@
    var template (omit) CQI_ReportModeAperiodic v_CQI_ReportModeAperiodic := rm30; //Default value
    if (p_IsEmtc and f_GetTestcaseAttrib_CEModeB(testcasename())) { //CEModeB
      // Not specified in TS 36.508
    } else if (p_IsEmtc) { //CEModeA
      v_CQI_ReportModeAperiodic := rm20;
    }
    return v_CQI_ReportModeAperiodic;
  }

  /*
   * @desc      Return CIOT parameters as per 36.508 Table 4.6.1-18: RRCConnectionSetupComplete
   * @return    template RRCConnectionSetupComplete_v8a0_IEs
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS)
   */
  function fl_ReturnCIOT_RRCConnectionSetupComplete_v8a0() return template RRCConnectionSetupComplete_v8a0_IEs
  { //@sic R5-172999 sic@
    var template RRCConnectionSetupComplete_v8a0_IEs  v_RRCConnectionSetupComplete_v8a0 := *;
    var template (omit) RRCConnectionSetupComplete_UP_CIoT_Type v_UP_CIoT_Type := omit;
    var template (omit) RRCConnectionSetupComplete_CP_CIoT_Type v_CP_CIoT_Type := omit;
    
    if (f_GetTestcaseAttrib_CIOT_UP(testcasename()) or f_GetTestcaseAttrib_CIOT_CP(testcasename())) {
      if (pc_WB_User_Plane_CIoT_Optimisation) {
        v_UP_CIoT_Type := true_;
      }
      if (pc_WB_Control_Plane_CIoT_Optimisation) {
        v_CP_CIoT_Type := true_;
      }
      //@sic R5-177082 sic@
      v_RRCConnectionSetupComplete_v8a0 := cr_RRCConnectionSetupComplete_v8a0_IEs(cr_RRCConnectionSetupComplete_v1020_IEs(cr_RRCConnectionSetupComplete_v1130_IEs(cr_RRCConnectionSetupComplete_v1250_IEs(cr_RRCConnectionSetupComplete_v1320_IEs(v_UP_CIoT_Type, v_CP_CIoT_Type, *)))));  //@sic R5-177082 R5s180379 sic@
    }
    return v_RRCConnectionSetupComplete_v8a0
  }

  /*
   * @desc      return  CarrierFreqEUTRA if frequencies < maxEARFCN (band < 64) otherwise return omit (band > 64)
   * @param     p_CarrierFreqEutra_v9e0
   * @param     p_UL_EARFCN_Band24
   * @return    template (omit)CarrierFreqEUTRA
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_Return_CarrierFreqEUTRA(template (omit) CarrierFreqEUTRA_v9e0 p_CarrierFreqEutra_v9e0,
                                     template (omit) ARFCN_ValueEUTRA p_UL_EARFCN_Band24
                                     ) return template (omit)CarrierFreqEUTRA
  { // @sic R5s170267 rename fl_Return_CarrierFreqEUTRA -> f_Return_CarrierFreqEUTRA sic@
    // @sic R5-217954 R5-217955: added p_UL_EARFCN_Band24 sic@
    var template (omit) CarrierFreqEUTRA v_CarrierFreqEUTRA := omit;
    
    if (isvalue(p_CarrierFreqEutra_v9e0)) {
      if (valueof(p_CarrierFreqEutra_v9e0.dl_CarrierFreq_v9e0) <= maxEARFCN) { //Band < 64
        v_CarrierFreqEUTRA := cs_CarrierFreqEUTRA(valueof(p_CarrierFreqEutra_v9e0.dl_CarrierFreq_v9e0), omit);
        if (isvalue(p_UL_EARFCN_Band24)) { //@sic R5-217954 R5-217955 sic@
          v_CarrierFreqEUTRA.ul_CarrierFreq := valueof(p_UL_EARFCN_Band24);
        }
      }
    }
    return v_CarrierFreqEUTRA;
  }

  /*
   * @desc      return  CarrierFreqEUTRA_v9e0 if frequencies > maxEARFCN (band > 64) otherwise return omit (band < 64)
   * @param     p_CarrierFreqEutra_v9e0
   * @return    template (omit) CarrierFreqEUTRA_v9e0
   * @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT)
   */
  function f_Return_CarrierFreqEUTRA_v9e0(template (omit) CarrierFreqEUTRA_v9e0 p_CarrierFreqEutra_v9e0) return template (omit) CarrierFreqEUTRA_v9e0
  { // @sic R5s170267 rename fl_Return_CarrierFreqEUTRA_v9e0 -> f_Return_CarrierFreqEUTRA_v9e0 sic@
    var template (omit) CarrierFreqEUTRA_v9e0 v_CarrierFreqEUTRA_v9e0 := omit;
    
    if (isvalue(p_CarrierFreqEutra_v9e0)) {
      if (valueof(p_CarrierFreqEutra_v9e0.dl_CarrierFreq_v9e0) >= maxEARFCN) { //Band > 64
        v_CarrierFreqEUTRA_v9e0 := p_CarrierFreqEutra_v9e0;
      }
    }
    return v_CarrierFreqEUTRA_v9e0;
  }

}
