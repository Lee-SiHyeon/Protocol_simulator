module NR_CellInfo {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_BWP all;
  import from NR_ASP_TypeDefs all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_FrequencyInit_SA all;
  import from NR_Parameters all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_SysInfo_Templates all;
  import from Parameters all;
  import from TestcaseProperties all;

  type enumerated DuplexBand_Type {fdd, tdd_FR1, tdd_FR2};  /* @status    APPROVED (ENDC, NR5GC) */

  type RedCap_ConfigCommonSIB_r17.cellBarredRedCap_r17.cellBarredRedCap1Rx_r17 CellBarredRedCap1Rx_r17_Type;  /* @status    APPROVED (NR5GC) */

  type RedCap_ConfigCommonSIB_r17.cellBarredRedCap_r17.cellBarredRedCap2Rx_r17 CellBarredRedCap2Rx_r17_Type;  /* @status    APPROVED (NR5GC) */

  template (value) EpochTime_r17 cs_EpochTime_r17_set0 :=
  { /* @status    APPROVED (NR5GC) */
   //Acc to Table 4.6.3-56C: EphemerisInfo
   //@sic R5-255092 R5s250232 sic@
   sfn_r17         := 0,
   subFrameNR_r17  := 0
  };

  /*
   * @desc      Set cell info for given NR cell
   * @param     p_NR_CellId
   * @param     p_NR_CellInfo
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_Set(NR_CellId_Type p_NR_CellId,
                             template (value) NR_CellInfo_Type p_NR_CellInfo) runs on NR_BASE_PTC
  {
    var integer v_Index := f_NR_CellInfo_GetIndex(p_NR_CellId);
    vc_NR_Global.CellArray[v_Index] := valueof(p_NR_CellInfo);
  };

  /*
   * @desc      Assign the parameterized RNTI in the NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_RNTI
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetRNTI(NR_CellId_Type p_NR_CellId,
                                 RNTI_Value_Type p_RNTI)
    runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.RNTI.RNTI := p_RNTI;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set MAC_CellGroupConfig stored in the cell array
   * @param     p_NR_CellId
   * @param     p_MAC_CellGroupConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_SetMAC_CellGroupConfig(NR_CellId_Type p_NR_CellId,
                                                template (value) MAC_CellGroupConfig p_MAC_CellGroupConfig) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.MAC_CellGroupConfig.R15 := valueof(p_MAC_CellGroupConfig);
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Return PhysicalCellGroupConfig stored in the cell array
   * @param     p_NR_CellId
   * @param     p_PhysicalCellGroupConfig
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_SetPhysicalCellGroupConfig(NR_CellId_Type p_NR_CellId,
                                                    template (value) PhysicalCellGroupConfig p_PhysicalCellGroupConfig) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.PhysicalCellGroupConfig.R15 := valueof(p_PhysicalCellGroupConfig) ;
    }
    else {
      FatalError(__FILE__, __LINE__, "No PhysicalCellGroupConfig not found");
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);  //@sic R5s230001 sic@
  };

  /*
   * @desc      Set MAC_CellGroupConfig stored in the cell array as per layer  as per Common test specific parameters for L2 as per 38.523-1 Table 7.1.0-1
   * @param     p_NR_CellId
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_SetMAC_CellGroupConfigL2(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC
  { //@sic R5s210315 sic@
    var MAC_CellGroupConfig v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(p_NR_CellId);

    v_MAC_CellGroupConfig.bsr_Config := valueof(cs_NR_BSR_Config_L2);
    v_MAC_CellGroupConfig.phr_Config := { release := NULL };
    f_NR_CellInfo_SetMAC_CellGroupConfig(p_NR_CellId, v_MAC_CellGroupConfig);
  }

  /*
   * @desc      Set  CellGroupId in ServingCellConfig stored in the cell array
   * @param     p_NR_CellId
   * @param     p_CellGroupId
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_Set_CellGroupId(NR_CellId_Type p_NR_CellId,
                                         CellGroupId    p_CellGroupId ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.CellGroupId := p_CellGroupId;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Get  CellGroupId in ServingCellConfig stored in the cell array
   * @param     p_NR_CellId
   * @return    CellGroupId
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_Get_CellGroupId(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return CellGroupId
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.CellGroupId;
  }

  /*
   * @desc      Set  ServingCellIndex in ServingCellConfig stored in the cell array
   * @param     p_NR_CellId
   * @param     p_NR_ServingCellIndex
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_Set_ServingCellIndex(NR_CellId_Type p_NR_CellId,
                                              NR_ServingCellIndex_Type  p_NR_ServingCellIndex ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      v_NR_CellInfo.ServingCellConfig.SpCell.ServingCellIndex := p_NR_ServingCellIndex;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Get ServingCellIndex in ServingCellConfig stored in the cell array
   * @param     p_NR_CellId
   * @return    NR_ServingCellIndex_Type
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_Get_ServingCellIndex(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_ServingCellIndex_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.ServingCellConfig.SpCell.ServingCellIndex;
  }

  /*
   * @desc      Set   in the cell array
   * @param     p_NR_CellId
   * @param     p_MultiplePHR
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_Set_MultiplePHR(NR_CellId_Type p_NR_CellId,
                                         boolean p_MultiplePHR ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      if (f_GetTestcaseAttrib_ENDC(testcasename())) { //@sic R5s240650 sic@
        v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.MAC_CellGroupConfig.R15.phr_Config := valueof(cs_38508_PHR_Config_Setup(cs_38508_PHR_Config));
      }
      v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.MAC_CellGroupConfig.R15.phr_Config.setup.multiplePHR := p_MultiplePHR;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set UL_BWP with given BWP_Id as stored in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_UplinkBWP
   * @param     p_BWP_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_SetUplinkBWP(NR_CellId_Type p_NR_CellId,
                                      template (value) NR_UplinkBWP_Type p_UplinkBWP,
                                      BWP_Id p_BWP_Id) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var integer i := fl_NR_RetrieveUplinkBWP_Index(v_NR_CellInfo.PhysicalParameters.UL_BWPs, p_BWP_Id);

    v_NR_CellInfo.PhysicalParameters.UL_BWPs[i] := p_UplinkBWP;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set UL_BWP List in NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_UplinkBWP
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetUplinkBWP_List(NR_CellId_Type p_NR_CellId,
                                           template (value) NR_UplinkBWP_List_Type p_UplinkBWP
                                           ) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.PhysicalParameters.UL_BWPs := p_UplinkBWP;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      set MeasGapCtrl
   * @param     p_NR_CellId
   * @param     p_MeasGapCtrl
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_SetMeasGapCtrl(NR_CellId_Type p_NR_CellId,
                                        NR_MeasGapCtrl_Type p_MeasGapCtrl) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.MeasGapCtrl := p_MeasGapCtrl;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Get DRX Control info
   * @param     p_NR_CellId
   * @return    NR_DrxCtrl_Type
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetDrxCtrl(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return NR_DrxCtrl_Type
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    return v_NR_CellInfo.DrxCtrl;
  }

  /*
   * @desc      Set DRX Ctontrol info
   * @param     p_NR_CellId
   * @param     p_DrxCtrl
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetDrxCtrl(NR_CellId_Type p_NR_CellId,
                                    NR_DrxCtrl_Type p_DrxCtrl) runs on NR_BASE_PTC
  {
    var template (value) NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.DrxCtrl := p_DrxCtrl;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Sets the given value for IE RLF_TimersAndConstants.t311 within CellConfiguration
   * @param     p_NR_CellId
   * @param     p_T311              (default value: ms10000)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_Set_RLF_TimersAndConstants_t311(NR_CellId_Type p_NR_CellId,
                                                 RLF_TimersAndConstants.t311 p_T311 := ms10000
                                                 ) runs on NR_BASE_PTC
  {   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    var NR_CellInfo_Type v_NR_CellInfo;

    v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.RLF_TimersAndConstants.t311 := p_T311; //@sic R5s191061 R5s201387 BASELINE MOVING 2020 sic@
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Sets K2 in cellInfo
   * @param     p_NR_CellId
   * @param     p_K2
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellInfo_SetK2(NR_CellId_Type p_NR_CellId,
                               UInt_Type p_K2
                               ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo;

    v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.TimingScheduling.K2 := p_K2;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set the sysinfo combination of the cell in the cell array
   * @param     p_NR_CellId
   * @param     p_SysinfoCombination
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetSysinfoCombination(NR_CellId_Type p_NR_CellId,
                                               NR_SysinfoCombination_Type p_SysinfoCombination) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.Sysinfo.NR_SysinfoCombination:= p_SysinfoCombination;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set SIs in the cell array
   * @param     p_NR_CellId
   * @param     p_SIs
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetSIs (NR_CellId_Type   p_NR_CellId,
                                 template (omit) NR_SI_List_Type  p_SIs) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (isvalue(p_SIs)){
        v_NR_CellInfo.Sysinfo.BcchInfo.SIs := valueof(p_SIs);
    } else {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIs := omit;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set Segmented SIs in the cell array
   * @param     p_NR_CellId
   * @param     p_SegmentedSIs
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSegmentedSIs (NR_CellId_Type               p_NR_CellId,
                                          template (omit) NR_SegmentedSI_List_Type     p_SegmentedSIs) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (isvalue(p_SegmentedSIs)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SegmentedSIs := valueof(p_SegmentedSIs);
    } else {
        v_NR_CellInfo.Sysinfo.BcchInfo.SegmentedSIs := omit;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set CellBarred status in the MIB if the parameterized cell
   * @param     p_NR_CellId
   * @param     p_NR_CellBarred     (default value: notBarred)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetMIB_CellBarred ( NR_CellId_Type   p_NR_CellId,
                                             MIB.cellBarred   p_NR_CellBarred := notBarred
                                           )  runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.Sysinfo.BcchInfo.MIB.message_.mib.cellBarred := p_NR_CellBarred;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Assign MFBI band indicator in the NR_CellInfo
   * @param     p_NR_CellId
   * @param     p_MFBI_Band
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetMFBI_Band(NR_CellId_Type p_NR_CellId,
                                      FreqBandIndicatorNR p_MFBI_Band
                                      ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    v_NR_CellInfo.FrequencyBand.MFBI_Band := p_MFBI_Band;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set status for CellBarred and intraFreqReselection in the MIB if the parameterized cell
   * @param     p_NR_CellId
   * @param     p_NR_CellBarred     (default value: notBarred)
   * @param     p_NR_IntraFreqReselection (default value: allowed)
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetMIB_CellBarred_intraFreqReselection ( NR_CellId_Type   p_NR_CellId,
                                                                  MIB.cellBarred   p_NR_CellBarred := notBarred,
                                                                  MIB.intraFreqReselection   p_NR_IntraFreqReselection := allowed
                                                                  )  runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    v_NR_CellInfo.Sysinfo.BcchInfo.MIB.message_.mib.cellBarred := p_NR_CellBarred;
    v_NR_CellInfo.Sysinfo.BcchInfo.MIB.message_.mib.intraFreqReselection := p_NR_IntraFreqReselection;
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set si-SchedulingInfo value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @param     p_SI_SchedulingInfo
   * @status    APPROVED (NR5GC, NR5GC_IRAT)
   */
  function f_NR_CellInfo_SetSIB1_SiSchedulingInfo(NR_CellId_Type p_NR_CellId,
                                                  template (omit) SI_SchedulingInfo p_SI_SchedulingInfo) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    //@sic R5s201011 sic@
    if (isvalue(p_SI_SchedulingInfo)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.si_SchedulingInfo:= valueof(p_SI_SchedulingInfo);
    } else {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.si_SchedulingInfo:= omit;
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set si-SchedulingInfo-v1700 value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @param     p_SI_SchedulingInfo_V1700
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_SiSchedulingInfo_v1700(NR_CellId_Type p_NR_CellId,
                                                        template (omit) SI_SchedulingInfo_v1700 p_SI_SchedulingInfo_V1700) runs on NR_BASE_PTC
  { //@sic R5s260013 sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {
      if (isvalue(p_SI_SchedulingInfo_V1700)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1700:= valueof(p_SI_SchedulingInfo_V1700);
      } else {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1700:= omit;
      }
      f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
    } else {
      f_NR_CellInfo_SetSIB1_v1700_IEs(p_NR_CellId, cs_SIB1_v1700_IEs_Def(-, -, p_SI_SchedulingInfo_V1700));
    }
  }

  /*
   * @desc      Assign the parameterised SIB1-v1700-IEs
   * @param     p_NR_CellId
   * @param     p_SIB1_v1700_IEs
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_v1700_IEs(NR_CellId_Type p_NR_CellId,
                                           template (omit) SIB1_v1700_IEs p_SIB1_v1700_IEs  ) runs on NR_BASE_PTC
  {//@sic R5-237351 sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    //@sic R5s240001 sic@
    if (not(isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension))) {v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension := valueof(cs_SIB1_v1610_IEs_Def())};
    if (not(isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension))) {v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension := valueof(cs_SIB1_v1630_IEs_Def(omit))};
    if (isvalue(p_SIB1_v1700_IEs)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := valueof(p_SIB1_v1700_IEs);
    } else {
        if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension)) {
             v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := omit;
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
   };

  /*
   * @desc      Assign the parameterised SIB1-v1800-IEs
   * @param     p_NR_CellId
   * @param     p_SIB1_v1800_IEs
   * @status    APPROVED (NR5GC)
   */
  function f_NR_CellInfo_SetSIB1_v1800_IEs(NR_CellId_Type p_NR_CellId,
                                           template (omit) SIB1_v1800_IEs p_SIB1_v1800_IEs  ) runs on NR_BASE_PTC
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (not(isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension))) {v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension := valueof(cs_SIB1_v1610_IEs_Def())}; // SIB1-v1610-IEs
    if (not(isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension))) {v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension := valueof(cs_SIB1_v1630_IEs_Def(omit))}; // SIB1-v1630-IEs
    if (not(isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension))) {v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := valueof(cs_SIB1_v1700_IEs_Def(omit))}; // SIB1-v1700-IEs

    if (isvalue(p_SIB1_v1800_IEs)) {
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := valueof(p_SIB1_v1800_IEs);
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1740 := omit;
    } else {
        if (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension)) {
             v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension := omit;
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
   };

  /*
   * @desc      Set si-RequestConfig value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @param     p_SI_RequestConfig
   * @param     p_SI_RequestConfig_r18 (default value: omit)
   * @status    APPROVED (NR5GC)
   */
   function f_NR_CellInfo_SetSIB1_SiRequestConfig(NR_CellId_Type p_NR_CellId,
                                                  template (value) SI_RequestConfig p_SI_RequestConfig,
                                                  template (omit) SI_SchedulingInfo_v1800 p_SI_RequestConfig_r18 := omit) runs on NR_BASE_PTC
  { //@sic R5s260013 sic@
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);

    if (v_NR_CellInfo.Sysinfo.NR_SysinfoCombination != MibOnly){
        if (not (isvalue(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension))) { // SIB1-v1800-IEs
              f_NR_CellInfo_SetSIB1_v1800_IEs(p_NR_CellId,cs_SIB1_v1800_IEs_Def);
        }// First check to fill up missing contents up to v1800

        v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
        v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.si_SchedulingInfo.si_RequestConfig:= valueof(p_SI_RequestConfig);
        if (isvalue(p_SI_RequestConfig_r18)) {
          v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1800 := valueof(p_SI_RequestConfig_r18);

        } else {
          v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.si_SchedulingInfo_v1800 := omit;
        }
    }
    f_NR_CellInfo_Set(p_NR_CellId, v_NR_CellInfo);
  }

  /*
   * @desc      Set cellSelectionInfo value stored in SIB1 in the cell array
   * @param     p_NR_CellId
   * @param     p_CellSelectionInfo
