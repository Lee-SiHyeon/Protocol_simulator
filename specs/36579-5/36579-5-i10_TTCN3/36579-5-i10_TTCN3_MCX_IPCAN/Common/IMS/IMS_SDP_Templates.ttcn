    media := p_Media,
    ports := {
      port_number := p_LocalPort,
      num_of_ports := omit
    },
    transport := p_Transport,
    fmts := p_Fmts
  };

  template (value) SDP_media_field cs_SDP_Media_MultiAudio(template (value) SDP_fmt_list p_Fmts,
                                                           integer p_LocalPort := tsc_IMS_MediaPort_M1,
                                                           charstring p_Transport := c_rtpAvp) :=
  /* @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT) */
    cs_SDP_Media(c_audio, p_LocalPort, p_Transport, p_Fmts);

