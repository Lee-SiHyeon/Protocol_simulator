  /*
   * @desc      Set the applicability conditions according to 38.523-2 Table 4.2-1
   * @param     p_Condition
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT)
   */
  function f_NR_SelectionExpr(NR_38523_Condition_Type p_Condition) return boolean
  {
    var boolean v_ApplCond;

    select (p_Condition) {
      case (R) {
        v_ApplCond := true;
      }
      case (NR_C01) {
        v_ApplCond := pc_EN_DC;
      }
      case (NR_C02) {
        v_ApplCond := pc_um_WithLongSN or pc_um_WithShortSN;
      }
      case (NR_C03) {
        v_ApplCond := pc_longDRX_Cycle;
      }
      case (NR_C04) {
        v_ApplCond := pc_shortDRX_Cycle;
      }
      case (NR_C05) {
        v_ApplCond := pc_um_WithShortSN;
      }
      case (NR_C06) {
        v_ApplCond := pc_um_WithLongSN;
      }
      case (NR_C07) {
        v_ApplCond := pc_am_WithShortSN;
      }
      case (NR_C07A) {
        v_ApplCond := pc_am_WithLongSN;
      }
      case (NR_C08) {
        v_ApplCond := pc_shortSN;
      }
      case (NR_C08A) {
        v_ApplCond := pc_longSN;
      }
      case (NR_C09) {
        v_ApplCond := pc_ZUC;
      }
      case (NR_C10) {
        v_ApplCond := pc_EN_DC and pc_splitDRB_withUL_Both_MCG_SCG;
      }
      case (NR_C11) {
        v_ApplCond := pc_pusch_256QAM_FR1 or pc_pusch_256QAM_FR2;
      }
      case (NR_C13) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport;
      }
      case (NR_C14) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport and pc_intraAndInterF_MeasAndReport;
      }
      case (NR_C15) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport and pc_intraAndInterF_MeasAndReport and (pc_csi_RSRP_AndRSRQ_MeasWithSSB or pc_csi_RSRP_AndRSRQ_MeasWithoutSSB);
      }
      case (NR_C16) {
        v_ApplCond := pc_EN_DC and pc_ESM_MO_Bearer_Allocation and pc_ESM_MO_Bearer_Modification;
      }
      case (NR_C17) {
        v_ApplCond := pc_downlinkSPS;
      }
      case (NR_C18) {
        v_ApplCond := pc_configuredUL_GrantType1;
      }
      case (NR_C19) {
        v_ApplCond := pc_configuredUL_GrantType2;
      }
      case (NR_C20) {
        v_ApplCond := pc_pdsch_RepetitionMultiSlots;
      }
      case (NR_C21) {
        v_ApplCond := pc_5GCN;
      }
      case (NR_C21A) {
        v_ApplCond := pc_5GCN and pc_as_ReflectiveQoS;
      }
      case (NR_C21B) {
        v_ApplCond := pc_5GCN and pc_SORCMCI and pc_SORCMCI_DNN_r17;
      }
      case (NR_C21C) {
        v_ApplCond := pc_5GCN and pc_SORCMCI and pc_SORCMCI_match_all_r17;
      }
      case (NR_C22) {
        v_ApplCond := pc_EN_DC and pc_srb3;
      }
      case (NR_C23) {
        v_ApplCond := pc_EN_DC and pc_srb3 and pc_splitSRB_WithOneUL_Path;
      }
      case (NR_C24) {
        v_ApplCond := pc_EN_DC and pc_intraAndInterF_MeasAndReport and pc_independentGapConfig_ENDC and pc_InterBand_ENDC_WithinFR1;
      }
      case (NR_C25) {
        v_ApplCond := pc_EN_DC and pc_intraAndInterF_MeasAndReport and pc_independentGapConfig_ENDC and pc_InterBand_ENDC_IncludingFR2;
      }
      case (NR_C26) {
        v_ApplCond := pc_eFDD or pc_eTDD;
      }
      case (NR_C28) {
        v_ApplCond := pc_5GCN and pc_nrSUL and pc_dynamicSwitch_SUL;
      }
      case (NR_C31) {
        v_ApplCond := pc_5GCN and pc_eventB_MeasAndReport;
      }
      case (NR_C32) {
        v_ApplCond := pc_5GCN and (pc_eFDD or pc_eTDD);
      }
      case (NR_C32a) {
        v_ApplCond := pc_5GCN and (pc_eFDD or pc_eTDD) and pc_loggedMeasurements_r16;
      }
      case (NR_C33) {
        v_ApplCond := pc_5GCN and pc_sms_over_NAS and not pc_Use_SMS_over_IP;
      }
      case (NR_C34) {
        v_ApplCond := pc_5GCN and pc_eMinimumPeriodicSearchTimer;
      }
      case (NR_C35) {
        v_ApplCond := pc_5GCN and (pc_ETWS_NR or pc_CMAS_NR);
      }
      case (NR_C36) {
        v_ApplCond := pc_5GCN and pc_UserInitiatedPLMN_Reselection;
      }
      case (NR_C37) {
        v_ApplCond := pc_5GCN and (pc_nrFDD_MultiBand or pc_nrTDD_MultiBand);
      }
      case (NR_C38) {
        v_ApplCond := pc_5GCN and pc_nrFDD and pc_nrTDD;
      }
      case (NR_C39) {
        v_ApplCond := pc_5GCN and pc_Additional_PDU_establishment;
      }
      case (NR_C39A) {
        v_ApplCond := pc_5GCN and pc_Additional_PDU_establishment and pc_5GC_PDU_EAP_AKA_Prime;
      }
      case (NR_C40) {
        v_ApplCond := pc_5GCN and pc_ss_SINR_Meas;
      }
      case (NR_C41) {
        v_ApplCond := pc_5GCN and (pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2);
      }
      case (NR_C42) {
        v_ApplCond := pc_5GCN and (pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell);
      }
      case (NR_C43) {
        v_ApplCond := pc_5GCN and (pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2);
      }
      case (NR_C44) {
        v_ApplCond := pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2;
      }
      case (NR_C45) {
        v_ApplCond := pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell;
      }
      case (NR_C46) {
        v_ApplCond := pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2;
      }
      case (NR_C49) {
        v_ApplCond := pc_5GCN and pc_independentGapConfig;
      }
      case (NR_C50) {
        v_ApplCond := pc_5GCN and pc_eventB_MeasAndReport and pc_RS_SINR_MeasEUTRA;
      }
      case (NR_C51) {
        v_ApplCond := pc_pusch_RepetitionMultiSlots;
      }
      case (NR_C52) {
        v_ApplCond := pc_5GCN and pc_eventA_MeasAndReport and pc_intraAndInterF_MeasAndReport and (pc_csi_RSRP_AndRSRQ_MeasWithSSB or pc_csi_RSRP_AndRSRQ_MeasWithoutSSB);
      }
      case (NR_C53) {
        v_ApplCond := pc_logicalChannelSR_DelayTimer;
      }
      case (NR_C54) {
        v_ApplCond := pc_5GCN and (pc_eFDD or pc_eTDD) and pc_VoLTE and pc_EPS_fallback;
      }
      case (NR_C55) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport and (pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2) and pc_EN_DC_NR_DL_2CC and pc_srb3;
      }
      case (NR_C56) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport and (pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell) and pc_EN_DC_NR_DL_2CC and pc_srb3;
      }
      case (NR_C57) {
        v_ApplCond := pc_EN_DC and pc_eventA_MeasAndReport and (pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2) and pc_EN_DC_NR_DL_2CC and pc_srb3;
      }
      case (NR_C59) {
        v_ApplCond := pc_5GCN and pc_nr_CGI_Reporting;
      }
      case (NR_C60) {
        v_ApplCond := pc_5GCN and pc_eutra_CGI_Reporting;
      }
      case (NR_C61) {
        v_ApplCond := pc_EN_DC and pc_pdcp_DuplicationSplitSRB;
      }
      case (NR_C62) {
        v_ApplCond := pc_EN_DC and pc_pdcp_DuplicationSplitDRB;
      }
      case (NR_C63) {
        v_ApplCond := pc_5GCN and pc_MO_PDU_Session_Modification;
      }
      case (NR_C64) {
        v_ApplCond := pc_maxNumberMIMO_LayersPDSCH_eightLayers;
      }
      case (NR_C65) {
        v_ApplCond := pc_maxNumberMIMO_LayersPDSCH_eightLayers and pc_pusch_256QAM_FR1;
      }
      case (NR_C66) {
        v_ApplCond := (pc_bwp_SwitchingDelay_Type1 or pc_bwp_SwitchingDelay_Type2) and (pc_bwp_SameNumerology_upto2_FR1_FDD or pc_bwp_SameNumerology_upto2_FR1_TDD or pc_bwp_SameNumerology_upto2_FR2 or pc_bwp_SameNumerology_upto4_FR1_FDD or pc_bwp_SameNumerology_upto4_FR1_TDD or pc_bwp_SameNumerology_upto4_FR2);
      }
      case (NR_C67) {
        v_ApplCond := pc_EN_DC and (pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2) and pc_EN_DC_NR_DL_2CC;
      }
      case (NR_C68) {
        v_ApplCond := pc_EN_DC and (pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2) and pc_EN_DC_NR_DL_2CC;
      }
      case (NR_C69) {
        v_ApplCond := pc_EN_DC and (pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell) and pc_EN_DC_NR_DL_2CC;
      }
      case (NR_C70) {
        v_ApplCond := pc_longDRX_Cycle and pc_shortDRX_Cycle;
      }
      case (NR_C71) {
        v_ApplCond := pc_EN_DC and pc_srb3 and pc_intraAndInterF_MeasAndReport;
      }
      case (NR_C72) {
        v_ApplCond := pc_5GCN and (pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_UL_NR_CA_2CC;
      }
      case (NR_C73) {
        v_ApplCond := pc_5GCN and (pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_UL_NR_CA_2CC;
      }
      case (NR_C74) {
        v_ApplCond := pc_5GCN and (pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_UL_NR_CA_2CC;
      }
      case (NR_C75) {
        v_ApplCond := pc_EN_DC and pc_srb3 and (pc_IntraBand_Contiguous_CA_WithinFR1 or pc_IntraBand_Contiguous_CA_WithinFR2) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_EN_DC_NR_UL_2CC;
      }
      case (NR_C76) {
        v_ApplCond := pc_EN_DC and pc_srb3 and (pc_InterBand_CA_WithinFR1 or pc_InterBand_CA_WithinFR2 or pc_InterBand_CA_BetweenFR1PCell_FR2SCell) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_EN_DC_NR_UL_2CC;
      }
      case (NR_C77) {
        v_ApplCond := pc_EN_DC and pc_srb3 and (pc_IntraBand_NonContiguous_CA_WithinFR1 or pc_IntraBand_NonContiguous_CA_WithinFR2) and pc_pdcp_DuplicationMCG_OrSCG_DRB and pc_EN_DC_NR_UL_2CC;
      }
      case (NR_C78) {
        v_ApplCond := pc_5GCN and pc_voiceOverNR and pc_MultimediaTelephonyService and pc_InitiateSession and pc_MTSI_Speech and pc_SMS_IP_MO;
      }
      case (NR_C79) {
        v_ApplCond := pc_5GCN and pc_MTSI_Video and pc_NG114;
