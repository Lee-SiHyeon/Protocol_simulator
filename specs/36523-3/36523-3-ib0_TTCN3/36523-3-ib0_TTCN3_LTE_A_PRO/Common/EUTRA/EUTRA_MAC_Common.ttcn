  };

template (value) MAC_MainConfig_Type cds_MAC_MainConfig_Explicit_RetxBSR_Timer(RetxBSR_Timer_r12 p_RetxBSR_Timer)
    modifies cs_508_MAC_MainConfig_Explicit_RBC_DrxL_DisableBSR_PHR :=
