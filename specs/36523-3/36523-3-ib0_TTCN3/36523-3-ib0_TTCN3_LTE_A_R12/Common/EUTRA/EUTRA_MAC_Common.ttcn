  template (present) MAC_PDU_Type cr_MAC_PDU_NoPadding_RLCPDU_LCID(template (present) B5_Type p_LchId,/* @sic R5-113848 sic@ */
                                                                   template (present) MAC_SDU_Type p_MAC_SDU) :=
