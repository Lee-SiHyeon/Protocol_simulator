  /*
   * @desc      return IPInformationListEntryType with IPv4 address or IPv6 address depending on the given
   * @param     p_IpAddress
   * @return    template (value) urn_3gpp_ns_mcdata_user_profile_1_0.IPInformationListEntryType
   * @status    APPROVED (MCX)
   */
  function fl_MCData_UserProfile_IPInformationEntry(charstring p_IpAddress) return template (value) urn_3gpp_ns_mcdata_user_profile_1_0.IPInformationListEntryType
  {
    var urn_3gpp_ns_mcdata_user_profile_1_0.IPInformationListEntryType.choice v_Choice;

    if (f_IpAddressIsIPv4(p_IpAddress)) {
      v_Choice.iPv4Address := p_IpAddress;
    } else if (f_IpAddressIsIPv6(p_IpAddress)) {
      v_Choice.iPv6Address := p_IpAddress;
    } else {
      FatalError(__FILE__, __LINE__, "Invalid IP address");
    }
    return cs_MCData_UserProfile_IPInformationListEntry(v_Choice);
  }

  template (value) urn_3gpp_ns_mcdata_user_profile_1_0.IPInformationListEntryType cs_MCData_UserProfile_IPInformationListEntry(urn_3gpp_ns_mcdata_user_profile_1_0.IPInformationListEntryType.choice p_Choice) :=
