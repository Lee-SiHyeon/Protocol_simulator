                                                       template (omit) NR_DL_AoD_ProvideAssistanceData_r16 p_DlAoDProvideAssistData := omit, // Rel-16
                                                       template (omit) NR_DL_TDOA_ProvideAssistanceData_r16 p_DlTdoaProvideAssistData := omit) := // Rel-16
  { /* @status    APPROVED (POS) */
    transactionID := cs_TransId(p_Initiator, p_TransactionNumber),
    endTransaction := true,
    sequenceNumber := omit,  //@sic R5s130288 sic@
    acknowledgement := p_Acknowledgement,  //@sic R5s130288 sic@
    lpp_MessageBody := {
      c1 := {
        provideAssistanceData := {
          criticalExtensions := {
            c1 := {
              provideAssistanceData_r9 := {
                commonIEsProvideAssistanceData := omit,
                a_gnss_ProvideAssistanceData := p_AgnssProvideAssistData,
                otdoa_ProvideAssistanceData := p_OtdoaProvideAssistData,
                epdu_Provide_Assistance_Data := omit,
                sensor_ProvideAssistanceData_r14 := p_SensorProvideAssistData, /* @sic R5s170599 BASELINE MOVING 2017 sic@ */
                tbs_ProvideAssistanceData_r14 := p_TbsProvideAssistData, /* @sic R5s170599 BASELINE MOVING 2017 sic@ */
                wlan_ProvideAssistanceData_r14 := p_WlanProvideAssistData, /* @sic R5s170599 BASELINE MOVING 2017 sic@ */
                nr_Multi_RTT_ProvideAssistanceData_r16 := p_MultiRTTProvideAssistData, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_DL_AoD_ProvideAssistanceData_r16 := p_DlAoDProvideAssistData, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                nr_DL_TDOA_ProvideAssistanceData_r16 := p_DlTdoaProvideAssistData, /* @sic R5s201388 BASELINE MOVING 2020 Rel-16 sic@ */
                bt_ProvideAssistanceData_r18 := omit /* @sic R5s240532 BASELINE MOVING 2024 Rel-18 sic@ */
              }
            }
          }
        }
      }
    }
  };

