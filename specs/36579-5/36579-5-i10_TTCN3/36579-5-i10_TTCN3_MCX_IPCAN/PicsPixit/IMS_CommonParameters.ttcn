  modulepar charstring                  px_IMS_PublicUserIdentity2  := "sip:PublicId2@3gpp.org";

  modulepar charstring                  px_IMS_PublicUserIdentity3  := "sip:PublicId3@3gpp.org";

  modulepar charstring                  px_IMS_SPI_ValidValueList_PDN1 := "";           // @desc  list of comma separated integer values that can be used as SPI values for IMS security on PDN1; each value shall be greater than or equal to 256

  modulepar charstring                  px_IMS_SPI_ValidValueList_PDN2 := "";           // @desc  list of comma separated integer values that can be used as SPI values for IMS security on PDN2; each value shall be greater than or equal to 256

