  function fl_MCData_UserProfile_Common_One_to_One_Communication() return template (value) urn_3gpp_ns_mcdata_user_profile_1_0.One_to_One_CommunicationType
  {
    var template (value) urn_3gpp_ns_mcdata_user_profile_1_0.One_to_One_CommunicationListEntryType.choice_list v_One_to_One_CommunicationListEntry_ChoiceList := {
      { mCData_ID := cs_MCData_UserProfile_Entry("0", px_MCData_ID_User_B, cs_MCData_UserProfile_MCDataID_AnyExt(px_MCData_IPConnectivityEndpointAddress_B)) },
      { proSeUserID_entry := cs_MCData_UserProfile_ProSeUserEntry("0", char2oct("123456"), char2oct("555555555555")) },
      { mCData_ID_KMSURI := cs_MCData_UserProfile_Entry(-, tsc_MCX_KMS_Hostname) }
    };
    return cs_MCData_UserProfile_One_to_One_Communication_SingleEntry(v_One_to_One_CommunicationListEntry_ChoiceList);
  }

