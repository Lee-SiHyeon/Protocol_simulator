module NR_CommonFunctions_ENDC_CA {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_CommonFunctions_CA all;
  import from NR_CommonFunctions_ENDC all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_Timing all;

  /*
   * @desc     Function to add 1 SCell
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_SCellIndex        (default value: tsc_NR_SCellIndex_2)
   * @param     p_SS_RadioBearerList (default value: omit)
   * @param     p_NR_RLC_BearerToAddModList (default value: omit)
   * @param     p_RadioBearerConfig (default value: omit)
   * @param     p_UL_CA             (default value: false)
   * @param     p_SCellDeactivationTimer (default value: omit)
   * @param     p_UL_CA_ConfigPUCCH (default value: true)
   * @param     p_SCellState        (default value: omit)
   * @status    APPROVED (ENDC)
   */
  function f_NR_AddMod_1SCell_ENDC(NR_CellId_Type  p_PSCell,
                                   NR_CellId_Type  p_SCell,
                                   SCellIndex p_SCellIndex := tsc_NR_SCellIndex_2,
                                   template (omit) NR_RadioBearerList_Type p_SS_RadioBearerList := omit,
                                   template (omit) NR_RLC_BearerToAddModList_Type p_NR_RLC_BearerToAddModList := omit,
                                   template (omit) RadioBearerConfig p_RadioBearerConfig := omit,
                                   boolean p_UL_CA := false,
                                   template (omit) ServingCellConfig.sCellDeactivationTimer p_SCellDeactivationTimer := omit,
                                   boolean p_UL_CA_ConfigPUCCH := true,
                                   template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                   ) runs on NR_BASE_PTC
  { //@sic R5-214764 : added p_UL_CA_ConfigPUCCH R5-224929: added p_SCellState sic@
    var template (value) CellGroupConfig v_SCGConfig := f_NR_GetSCGConfig_SCellAdd(p_SCell, p_SCellIndex, p_UL_CA, p_SCellDeactivationTimer, -, p_UL_CA_ConfigPUCCH, p_SCellState);
    var ServCellIndex v_PUCCH_Cell := tsc_NR_PCellIndex;
    
    //By default SCell is not PUCCH-Cell @sic R5-237429 sic@
    if (p_UL_CA and p_UL_CA_ConfigPUCCH) {  // SCell is PUCCH-Cell
        v_PUCCH_Cell := p_SCellIndex;
    }
    if (isvalue(p_NR_RLC_BearerToAddModList)) {
        v_SCGConfig.rlc_BearerToAddModList:= p_NR_RLC_BearerToAddModList;
    }
    f_NR_ConfigPCell_AddRelSCells(p_PSCell, {p_SCell}, tsc_NR_SCellIndex_1, cs_TimingInfo_Now, f_NR_CellInfo_GetRNTI(p_PSCell), p_SS_RadioBearerList);
    f_NR_ConfigSCell(p_SCell,v_SCGConfig, cs_TimingInfo_Now, v_PUCCH_Cell);
    //Send RRC Reconfiguration on E-UTRA side
    f_NR_SendRRCReconfigurationContentsToEUTRA(p_RadioBearerConfig, v_SCGConfig);
    
    if (p_UL_CA and p_UL_CA_ConfigPUCCH) {  //@sic R5s220957 sic@
         f_NR_ULGrantConfiguration_Start(p_SCell);
    }
  }

  /*
   * @desc     Function to release 1 SCell
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_SCellIndexToRelease
   * @status    APPROVED (ENDC)
   */
  function f_NR_Release_1SCell_ENDC(NR_CellId_Type             p_PSCell,
                                    NR_CellId_Type             p_SCell,
                                    NR_ServingCellIndex_Type   p_SCellIndexToRelease
                                    ) runs on NR_BASE_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig;
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_PSCell); //@sic R5s201387 sic@
    v_SCGConfig := cs_38508_CellGroupConfig(v_CellGroupId,
                                            omit,  //p_RLC_Bearer_Config
                                            omit,  //RLC_BearerToRelease
                                            omit,  //MAC_CellGroupConfig
                                            omit,  //PhysicalCellGroupConfig
                                            omit,  //SpCellConfig
                                            omit,
                                            {p_SCellIndexToRelease} );
    //Send RRC Reconfiguration on E-UTRA side
    f_NR_SendRRCReconfigurationContentsToEUTRA(omit, v_SCGConfig);
    f_NR_Rel_SCell_Common(p_PSCell, p_SCell, p_SCellIndexToRelease, cs_TimingInfo_Now);
  }

  /*
   * @desc     Function to configure PSCell together with SCell
   * @param     p_PSCell
   * @param     p_SCell
   * @param     p_SCellIndex        (default value: tsc_NR_SCellIndex_2)
   * @param     p_UL_CA             (default value: false)
   * @status    APPROVED (ENDC)
   */
  function f_NR_AddMod_PSCell_SCell_ENDC( NR_CellId_Type  p_PSCell,
                                          NR_CellId_Type  p_SCell,
                                          SCellIndex p_SCellIndex := tsc_NR_SCellIndex_2,
                                          boolean p_UL_CA := false
                                        ) runs on NR_BASE_PTC
  {
    var template (value) CellGroupConfig v_SCGConfig := f_NR_GetSCGConfigDef(p_PSCell);
    var template (value) CellGroupConfig v_SCGConfig_SCell := f_NR_GetSCGConfig_SCellAdd(p_SCell, p_SCellIndex, p_UL_CA);
    var template (value) RadioBearerConfig v_RadioBearerConfig;
    
    v_SCGConfig.sCellToAddModList := v_SCGConfig_SCell.sCellToAddModList;
    v_RadioBearerConfig := cs_NR_RadioBearer(tsc_NR_DRB2, secondary, f_NR_AS_CipheringAlgorithm_Get(), f_NR_AS_IntegrityAlgorithm_Get());

    f_NR_ConfigPCell_AddRelSCells (p_PSCell, {p_SCell}, tsc_NR_SCellIndex_1, cs_TimingInfo_Now, f_NR_CellInfo_GetRNTI(p_PSCell), {f_NR_GetRadioBearerConfig_FullAM_DRB2(p_PSCell)});
    f_NR_ConfigSCell(p_SCell,v_SCGConfig, cs_TimingInfo_Now);
    
    // Get Security info from EUTRA, calculate latest keys and configure SS
    f_ENDC_GetKeysActivateSecurity(p_PSCell, EUTRA);
    
    //Send RRC Reconfiguration on E-UTRA side
    f_NR_SendRRCReconfigurationContentsToEUTRA (v_RadioBearerConfig, v_SCGConfig, -, -, -, reconfigurationWithSync_CheckRACH);
  }

  /*
   * @desc      Loop back one IP packet to verify the data path in CA - specific to ENDC CA test cases
   *            As per 38.508-1 Table 4.9.1-1A: Test procedure sequence for Data path check for CA tests
   * NOTE       The function is currently using default DRB/PDU session
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_StepNo            (default value: "")
   * @param     p_ActivateSCell     (default value: true)
   * @param     p_SCellIndex        (default value: tsc_NR_SCellIndex_2)
   * @param     p_UL_CA             (default value: false)
   * @status    APPROVED (ENDC)
   */
   function f_NR_CheckDataPath_CA(NR_CellId_Type p_PCell,
                                  NR_CellId_Type p_SCell,
                                  charstring p_StepNo := "",
                                  boolean p_ActivateSCell := true,
                                  SCellIndex p_SCellIndex := tsc_NR_SCellIndex_2,
                                  boolean p_UL_CA := false
                                ) runs on NR_BASE_PTC
  { //@sic R5-213516 sic@
    var template (value) MacBearerRouting_Type v_MacBearerRoutingDL := crs_MacBearerRouting(p_SCell);     //Send DL data on SCell
    var template (value) MacBearerRouting_Type v_MacBearerRoutingUL := crs_MacBearerRouting(p_PCell);
    var SubFrameTiming_Type v_TimingInfo := f_NR_GetNextSendOccasion_DL(p_PCell);  //@sic R5s250087 sic@
    
    // Step 1 : The SS transmits an Activation MAC control element to activate SCell.
    if (p_ActivateSCell) {
        f_SS_CellConfig_ActivateSCell_CA(p_PCell, p_SCellIndex, cs_TimingInfo_NR(v_TimingInfo));
    }
    if (p_UL_CA)  { v_MacBearerRoutingUL := crs_MacBearerRouting(p_SCell); }
    //Add 20ms before sending data (longest k1=7slots=7ms in SCS15kHz allowing a retransmission )
    v_TimingInfo := f_SubFrameTiming_AddMilliSeconds(v_TimingInfo, 20);       //@sic R5s250087 sic@
    // Steps 2
    f_NR_CheckDataPath(p_PCell,  // for DL @sic R5s210681 sic@
                       PDN_2,
                       dedicatedBearer,
                       tsc_NR_DRB2,
                       cs_RlcBearerRouting_NR(p_PCell),
                       cs_RlcBearerRouting_NR(p_PCell),
                       p_StepNo,
                       -,
                       v_MacBearerRoutingDL,
                       v_MacBearerRoutingUL,
                       cs_TimingInfo_NR(v_TimingInfo)   //@sic R5s250087 sic@
                       );
   }

}
