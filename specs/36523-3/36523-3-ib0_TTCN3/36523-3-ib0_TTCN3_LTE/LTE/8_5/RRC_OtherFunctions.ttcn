                                  (pc_ue_CategoryUL_13 and  pc_ue_CategoryUL_15 and pc_ue_CategoryUL_20))) or // @sic R5-172923 sic@
          (pc_ue_CategoryDL_13 and pc_ue_Category_6 and pc_ue_Category_4 and
