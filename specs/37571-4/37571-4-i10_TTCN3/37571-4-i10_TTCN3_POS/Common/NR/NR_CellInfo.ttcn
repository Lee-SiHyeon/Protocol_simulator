      v_PhysicalCellGroupConfig := v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.PhysicalCellGroupConfig.R15;
    }
    if (not isbound(v_PhysicalCellGroupConfig)) {
      FatalError(__FILE__, __LINE__, "No PhysicalCellGroupConfig not found");
    }
    return v_PhysicalCellGroupConfig;
  }

