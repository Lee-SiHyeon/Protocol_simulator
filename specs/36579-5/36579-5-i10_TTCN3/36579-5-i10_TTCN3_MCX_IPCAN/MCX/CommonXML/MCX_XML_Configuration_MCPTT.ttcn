  template (value) MCPTT_UserProfile_PrivateCallListEntry_Type cs_MCPTT_UserProfile_PrivateCallListEntry :=
  { /* @status    APPROVED (MCX) */
    index := omit,
    attr := omit,
    choice_list := {
      { privateCallURI := cs_MCPTT_UserProfile_Entry(-, "0", px_MCPTT_ID_User_B, "User B Name") },
      { privateCallURI := cs_MCPTT_UserProfile_Entry(-, "1", px_MCPTT_ID_User_C, "User C Name") },
      { privateCallProSeUser := cs_MCPTT_UserProfile_ProSeUserEntry("0", char2oct("123456"), char2oct("555555555555")) },     // @sic R5-217985: According to 24.484 clauses 8.3.2.6, 9.3.2.6 and 10.3.2.6 <DiscoveryGroupID> is 3 octets, <User-Info-ID> is 6 octets sic@
      { privateCallProSeUser := cs_MCPTT_UserProfile_ProSeUserEntry("1", char2oct("123456"), char2oct("666666666666")) }      // @sic R5-217985: According to 24.484 clauses 8.3.2.6, 9.3.2.6 and 10.3.2.6 <DiscoveryGroupID> is 3 octets, <User-Info-ID> is 6 octets sic@
    }
  };

  template (value) MCPTT_UserProfile_EmergencyCall_Type cs_MCPTT_UserProfile_EmergencyCall_Private :=
  { /* @status    APPROVED (MCX) */
    attr := omit,
    choice := {
      mCPTTPrivateRecipient := {
        attr := omit,
        entry := cs_MCPTT_UserProfile_Entry(usePreConfigured, "0", px_MCPTT_ID_User_B, "User B Name"),
        proSeUserID_entry := cs_MCPTT_UserProfile_ProSeUserEntry("0", char2oct("123456"), char2oct("555555555555")),         // @sic R5-217985: According to 24.484 clauses 8.3.2.6, 9.3.2.6 and 10.3.2.6 <DiscoveryGroupID> is 3 octets, <User-Info-ID> is 6 octets sic@
        anyExt := omit,
        elem_list := {}
      }
    }
  };

