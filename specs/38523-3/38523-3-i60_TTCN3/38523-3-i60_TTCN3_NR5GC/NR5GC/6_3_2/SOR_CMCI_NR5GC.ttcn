   */
  function f_TC_6_3_2_4_NR5GC() runs on NR5GC_PTC
  { //Steering of UE in roaming after registration / SOR-CMCI rule / DNN of the PDU session / update Tsor-cm Timer / DL NAS transport
  
    f_NR5GC_Init(NR_4);

