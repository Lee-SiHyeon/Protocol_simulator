module NR5GC_Positioning_Testcases_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from LPP_PDU_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_CellInfo all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_OTDOA_NR_CoordMsg all;
  import from EUTRA_OTDOA_POS_Component all;
  import from EUTRA_POS_Component all;
  import from EUTRA_Positioning_Functions all;
  import from NAS_CommonTypeDefs all;

  /*
   * @desc      Initializes and sends a co-ordination message to NR with complete OTDOA info
   * @status    APPROVED (POS)
   */
  function f_OTDOA_GetOtdoaInfoAndSendCoordMsg() runs on EUTRA_OTDOA_POS_PTC
  {
    var PRS_Info v_PrsInfo;
    var CellIdentity v_CellIdentity1;
    var CellIdentity v_CellIdentity2;
    var CellIdentity v_CellIdentity4;
    var ECGI v_Ecgi1;
    var ECGI v_Ecgi2;
    var ECGI v_Ecgi4;
    var NAS_PlmnId v_PLMN1_Oct;
    var NAS_PlmnId v_PLMN2_Oct;
    var NAS_PlmnId v_PLMN4_Oct;
    //Get OTDOA info to be sent to NR
    v_PrsInfo := f_POS_PrsInfo_Init(eutra_Cell1);

    v_PLMN1_Oct := f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (eutra_Cell1));
    v_PLMN2_Oct := f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (eutra_Cell2));
    v_PLMN4_Oct := f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (eutra_Cell4));
    v_Ecgi1 := f_POS_NAS_PlmnId2EcgiMccMnc (v_PLMN1_Oct);
    v_Ecgi2 := f_POS_NAS_PlmnId2EcgiMccMnc (v_PLMN2_Oct);
    v_Ecgi4 := f_POS_NAS_PlmnId2EcgiMccMnc (v_PLMN4_Oct);
    v_CellIdentity1 := f_EUTRA_CellInfo_GetCellIdentity (eutra_Cell1);
    v_CellIdentity2 := f_EUTRA_CellInfo_GetCellIdentity (eutra_Cell2);
    v_CellIdentity4 := f_EUTRA_CellInfo_GetCellIdentity (eutra_Cell4);
    v_Ecgi1.cellidentity := v_CellIdentity1;
    v_Ecgi2.cellidentity := v_CellIdentity2;
    v_Ecgi4.cellidentity := v_CellIdentity4;

    // Send co-ordination message to NR with the OTDOA info
    f_E_OTDOA_NR_SendCoOrd(NR, cms_E_OTDOA_NR_OtdoaInfo(v_Ecgi1, v_Ecgi2, v_Ecgi4, v_PrsInfo));
  }

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.1.2.5s.EUTRA.OTDOA
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_1_2_5s_EUTRA_OTDOA_POS() runs on EUTRA_OTDOA_POS_PTC
  {//LPP Abort - OTDOA (LTE)
   
    f_EUTRA_POS_Init(c1);
    
    // create cell for OTDOA and send out system information
    f_POS_EUTRA_CellConfig_OTDOA (eutra_Cell1);
    f_EUTRA_SetCellPower(eutra_Cell1, tsc_SuitableCellRS_EPRE);   //@sic R5s210651 sic@
    
    // Wait until NR component has finised the preamble
    f_E_OTDOA_NR_WaitForCoOrd_Trigger(NR);//@sic R5s210651 sic@

    f_OTDOA_GetOtdoaInfoAndSendCoordMsg();
    
    // Wait for co-ordination message from NR to finish the test case
    f_E_OTDOA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_ReleaseAllCells();
  }

}
