  /*
   * @desc      test body of TC_6_3_2_4
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_3_2_4_TestBody() runs on NR5GC_PTC
  {
    var octetstring v_Data;
    var NAS_PlmnId v_PlmnID := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell11));
    var O2_Type v_AccessTechId :='0800'O;
//    var O1_Type v_SORInfo :='01'O;//SI/SSCMI/SSSI//@sic R5-233459 sic@
    var octetstring  v_NAS_TxMsgContainer_SOR_CMCI;
    var O16_Type v_Mac;
    var B128_Type v_Mac_A17;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams;
    var octetstring v_CriterionType:= '01'O;
    var octetstring v_CriterionValue:= fl_EncodeCriterionValue_DNN(pc_APN_ID_Internet); // @sic R5s250062 sic@
    var octetstring v_TsorcmTimer:= '21'O;
    var O2_Type v_CounterSOR :='0001'O;
    var octetstring v_Length;//@sic R5s240595 sic@
    var template (value) SOR_Header v_Header := cs_NG_SOR_HeaderType0('1'B,'1'B,'1'B,'0'B,'1'B);//@sic R5-233459, R5s240531 sic@
    var template (value) NG_NAS_DL_Pdu_Type v_PduToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var O1_Type v_Length_PlmnID_AccessTechId := int2oct(lengthof(v_PlmnID & v_AccessTechId),1);//@sic R5s230605 sic@
    var template (value) SOR_DataType0WithAddInfo v_SOR_Data;
    var template (value) SOR_CMCIRule v_SOR_CMCIRule;
    timer t_Sorcm:=60.0;
    timer t_Wait:=49.0;
    //@siclog "Step 1-21a1" siclog@
    //Void //@sic R5-242146 sic@
    //@siclog "Steps 22" siclog@
    //The SS transmits an DLInformationTransfer message containing steering of roaming information indicating list of preferred PLMN/access technology combination provided with acknowledgment requested from the UE for successful reception.
    v_Length:=int2oct((lengthof(v_CriterionType)+lengthof(v_TsorcmTimer)+lengthof(v_CriterionValue)),2);//@sic R5s240595 sic@
    v_SOR_CMCIRule := cs_SOR_CMCIRule (v_TsorcmTimer, v_CriterionType, v_CriterionValue,v_Length);//@sic R5s240595 sic@
    v_SOR_Data := cs_SOR_DataWithAddInfo(v_Length_PlmnID_AccessTechId,
                                         {cs_SOR_PLMN_AccessTech(v_PlmnID, v_AccessTechId)},
                                         '0'B,
                                         '0'B,
                                         '0'B,
                                         '1'B,  // octet O = '01'
                                          cs_SOR_CMCI({v_SOR_CMCIRule},int2oct((oct2int(v_Length)+2),2)));//@sic R5s240595 sic@
    v_Data := bit2oct(encvalue(v_SOR_Data));  // @sic R5s240531 sic@
//    v_Data := v_Length_PlmnID_AccessTechId & v_PlmnID & v_AccessTechId & v_SORInfo & v_Length_SOR_CMCI_contents & v_Length_SOR_CMCI_rule_contents & v_TsorcmTimer & v_CriterionType & v_CriterionValue;//@sic R5s230605 sic@
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(v_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_CounterSOR,
                                  v_Data,
                                  v_NAS_SecurityParams.KDF);
    v_Mac := bit2oct(v_Mac_A17);
    v_NAS_TxMsgContainer_SOR_CMCI := bit2oct(encvalue(cs_NG_SORTransparentContainer(v_Header, v_Mac, v_CounterSOR, v_Data, omit, omit)));//@sic R5s240027 R5s240306 sic@
    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerSORMsg),
                                            omit,
                                            cs_PayloadContainer(omit, v_NAS_TxMsgContainer_SOR_CMCI));
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell12,
                                   tsc_NR_RbId_SRB2,
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,v_PduToSend.Msg)));
    //@siclog "Step 23" siclog@
    //The SS starts timer of Tsor-cm timer.
    t_Wait.start;
    t_Sorcm.start;
    //@siclog "Step 24" siclog@
    //The UE transmits an ULInformationTransfer message carrying acknowledgement of successful reception of the steering of roaming information
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell12, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp; // @sic R5s201387 Baseline Moving sic@  @sic R5s210026 sic@
    if (not f_Check_NG_ULNASTransport(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_PayloadContainerType(tsc_PayloadContainerSORMsg), omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UL NAS Transport Message Failed");
    }
    // MSSI should be 1 @sic R5s240531 sic@
    f_NG_DecodeAndMatchSORTransportContainer (v_ReceivedAsp, cr_NG_SOR_Header (?, ?, '1'B, ?));
    t_Wait.timeout;
    //@siclog "Step 25-34b3a1" siclog@
    //@siclog "Step 34" siclog@
    //Void//@sic R5-242146 sic@
    //@siclog "Step 35-50a1" siclog@
    v_CounterSOR :='0002'O;//@sic R5s230605 sic@
    v_TsorcmTimer:='05'O;//@sic R5-242146 R5s240316 sic@
    v_Length:=int2oct((lengthof(v_CriterionType)+lengthof(v_TsorcmTimer)+lengthof(v_CriterionValue)),2);//@sic R5s240595 sic@
    v_SOR_CMCIRule := cs_SOR_CMCIRule (v_TsorcmTimer, v_CriterionType, v_CriterionValue,v_Length);//@sic R5s240595 sic@
    v_SOR_Data := cs_SOR_DataWithAddInfo(v_Length_PlmnID_AccessTechId,
                                         {cs_SOR_PLMN_AccessTech(v_PlmnID, v_AccessTechId)},
                                         '0'B,
                                         '0'B,
                                         '0'B,
                                         '1'B,  // octet O = '01'
                                         cs_SOR_CMCI({v_SOR_CMCIRule},int2oct((oct2int(v_Length)+2),2)));//@sic R5s240595 sic@
    v_Data := bit2oct(encvalue(v_SOR_Data));  // @sic R5s240531 sic@
//    v_Data := v_Length_PlmnID_AccessTechId & v_PlmnID & v_AccessTechId & v_SORInfo & v_Length_SOR_CMCI_contents & v_Length_SOR_CMCI_rule_contents & v_TsorcmTimer & v_CriterionType & v_CriterionValue;//@sic R5s230605 sic@
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(v_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_CounterSOR,
                                  v_Data,
                                  v_NAS_SecurityParams.KDF);
    v_Mac := bit2oct(v_Mac_A17);
    v_NAS_TxMsgContainer_SOR_CMCI := bit2oct(encvalue(cs_NG_SORTransparentContainer(v_Header, v_Mac, v_CounterSOR, v_Data, omit, omit)));//@sic R5s240027 sic@
    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerSORMsg),
                                            omit,
                                            cs_PayloadContainer(omit, v_NAS_TxMsgContainer_SOR_CMCI));
    t_Sorcm.stop;
    f_NR5GC_TransportSorCmCheckfunction(nr_Cell12,nr_Cell11,v_PduToSend,-,"Step 29 PASS","Step 31 PASS",-,10.0);
  }//End of fl_TC_6_3_2_4_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.3.2.5
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_3_2_5_NR5GC() runs on NR5GC_PTC
  { //Steering of UE in roaming after registration / SOR-CMCI rule / DNN of the PDU session / store SOR-CMCI in ME / DL NAS transport
  
    f_NR5GC_Init(NR_4);

    // Set Sys info and cell info for cell 11& 12 to be used
    f_NR_CellInfo_SetPLMN(nr_Cell11, tsc_NR_HPLMN_002_11);//PLMN2
    f_NR_CellInfo_SetPLMN(nr_Cell12, tsc_NR_HPLMN_002_81);//PLMN13

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell11);
    f_NR_CellConfig_Def(nr_Cell12);

    // USIM configuration as defined in Table 6.4.1-21 of TS 38.508-1 [4] will be used.
    f_UT_USIM_Insert(UT, "USIM configuration 21 specified in table 6.4.1-21 TS 38.508-1");
    f_UT_SwitchOnUE(UT, false, CNF_REQUIRED);
    //The UE is in Automatic PLMN selection mode.
    f_UT_AutomaticPLMN_Select (UT);
    f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);

    f_NR5GC_Preamble (nr_Cell12, STATE_CONNECTED_3A);//@sic R5-233460 sic@

    f_NR_SetCellPower (nr_Cell11, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR_SetCellPower (nr_Cell12, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    f_NR_TestBody_Set(true);
    //@sic R5-235284 sic@
    //@sic R5-246396 sic@
    fl_TC_6_3_2_5_TestBody();
    f_NR_TestBody_Set(false);
    
    // Finish
    f_NR_Postamble(nr_Cell11, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_6_3_2_5
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_3_2_5_TestBody() runs on NR5GC_PTC
  {
    var octetstring v_Data;
    var NAS_PlmnId v_PlmnID := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell11));
    var O2_Type v_AccessTechId :='0800'O;
//    var O1_Type v_SORInfo :='03'O;//SSCMI
    var octetstring  v_NAS_TxMsgContainer_SOR_CMCI;
    var O16_Type v_Mac;
    var B128_Type v_Mac_A17;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams;
    var octetstring v_CriterionType:= '01'O;
    var octetstring v_CriterionValue; // @sic R5s250113 sic@
    var octetstring v_TsorcmTimer:= '21'O;
    var O2_Type v_CounterSOR :='0001'O;
    var octetstring v_Length;//@sic R5s240598 sic@
    var template (value) SOR_Header v_Header := cs_NG_SOR_HeaderType0('1'B,'1'B,'1'B,'0'B,'1'B);//@sic R5-233460, R5s240531 sic@
    var template (value) NG_NAS_DL_Pdu_Type v_PduToSend;
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var O1_Type v_Length_PlmnID_AccessTechId := int2oct(lengthof(v_PlmnID & v_AccessTechId),1);//@sic R5s240309 sic@
    var template (value) SOR_DataType0WithAddInfo v_SOR_Data;
    var template (value) SOR_CMCIRule v_SOR_CMCIRule;
    var PDU_PDN_DNN_Type v_PDUType; //@sic R5-246396 sic@
    timer t_Sorcm:=60.0;
    timer t_Tmax:=f_NR_SetTimerToleranceMax(nr_Cell12, nonProtocolTimer, 660.0);
    //@siclog "Step 1-2-21a1" siclog@
    //Void //@sic R5-233460 sic@
    //@siclog "Step 22" siclog@//@sic R5s240309 sic@
    //The SS transmits an DLInformationTransfer message containing steering of roaming information indicating list of preferred PLMN/access technology combination provided with acknowledgment requested from the UE for successful reception
    v_PDUType := f_GetDefaultAPN_DNNType_FromPICS();//@sic R5-246396 sic@
    v_CriterionValue:= fl_EncodeCriterionValue_DNN(f_GetDNNStringFromPICS(v_PDUType)); //@sic R5-246396, R5s250062, R5s250113 sic@
    v_Length:=int2oct((lengthof(v_CriterionType)+lengthof(v_TsorcmTimer)+lengthof(v_CriterionValue)),2);//@sic R5s240598 sic@
    v_SOR_CMCIRule := cs_SOR_CMCIRule (v_TsorcmTimer, v_CriterionType, v_CriterionValue,v_Length);//@sic R5s240594 sic@
    v_SOR_Data := cs_SOR_DataWithAddInfo(v_Length_PlmnID_AccessTechId,
                                         {cs_SOR_PLMN_AccessTech(v_PlmnID, v_AccessTechId)},
                                         '0'B,
                                         '0'B,
                                         '1'B,
                                         '1'B,  // octet O = '03'
                                         cs_SOR_CMCI({v_SOR_CMCIRule},int2oct((oct2int(v_Length)+2),2)));//@sic R5s240598 sic@
    v_Data := bit2oct(encvalue(v_SOR_Data));  // @sic R5s240531 sic@
//    v_Data := v_Length_PlmnID_AccessTechId & v_PlmnID & v_AccessTechId & v_SORInfo & v_Length_SOR_CMCI_contents & v_Length_SOR_CMCI_rule_contents & v_TsorcmTimer & v_CriterionType & v_CriterionValue;
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(v_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_CounterSOR,
                                  v_Data,
                                  v_NAS_SecurityParams.KDF);
    v_Mac := bit2oct(v_Mac_A17);
    v_NAS_TxMsgContainer_SOR_CMCI := bit2oct(encvalue(cs_NG_SORTransparentContainer(v_Header, v_Mac, v_CounterSOR, v_Data, omit, omit)));//@sic R5s240309 sic@
    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerSORMsg),
                                            omit,
                                            cs_PayloadContainer(omit, v_NAS_TxMsgContainer_SOR_CMCI));
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell12,
                                   tsc_NR_RbId_SRB2,
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,v_PduToSend.Msg)));
    //@siclog "Step 23" siclog@
    //The SS starts timer of Tsor-cm timer.
    t_Sorcm.start;
    //@siclog "Step 24" siclog@
    //The UE transmits an ULInformationTransfer message carrying acknowledgement of successful reception of the steering of roaming information.
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell12, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp; // @sic R5s201387 Baseline Moving sic@  @sic R5s210026 sic@
    if (not f_Check_NG_ULNASTransport(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_PayloadContainerType(tsc_PayloadContainerSORMsg), omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UL NAS Transport Message Failed");
    }
    // MSSI should be 1 @sic R5s240531 sic@
    f_NG_DecodeAndMatchSORTransportContainer (v_ReceivedAsp, cr_NG_SOR_Header (?, ?, '1'B, ?));
    //@siclog "Step 25a1-25b1" siclog@
    //Steps 5a1 to 5b1 of Switch off procedure described in TS 38.508-1 [4] Table 4.9.6.3-1 are performed on NR Cell 12 before Tsor-cm timer expires.
    f_NR_UE_DeRegisterOnSwitchOff (nr_Cell12, STATE_CONNECTED_3A);
    t_Sorcm.stop;
    //@siclog "Step 26" siclog@
    //Power on the UE or intert USIM (Note 1)
     f_UT_SwitchOnUE(UT);//@sic R5s240309 sic@
    //@siclog "Step 27-39" siclog@
    //Steps 1 to 13 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2.2-2 are performed on NR Cell 12.
     //@siclog "Step 40" siclog@
     //The SS transmits an DLInformationTransfer message and an REGISTRATION ACCEPT message//@sic R5-237423 sic@
    //@siclog "Step 41-42" siclog@
    //Void  //@sic R5-235284 sic@
    //@siclog "Step 43" siclog@//@sic R5-237423 sic@
    //The UE transmits an ULInformationTransfer message and REGISTRATION COMPLETE message.
    f_NR5GC_Registration(nr_Cell12);
    //@siclog "Step 44a1" siclog@
    //Void  //@sic R5-235284 sic@
    //@siclog "Step 44A" siclog@
    //Steps 19a1 to 19Ba2 of the registration procedure described in TS 38.508-1 [4] subclause 4.5.2.2-2 are performed on NR Cell 12.//@sic R5-242147 sic@
    if (pc_noOf_PDUsSameConnection > 0 ){//@sic R5-235284 sic@
      f_NR5GC_PDUSessionEstablishment (nr_Cell12,-,tsc_NR_RbId_SRB1);//@sic R5s210576 sic@
    }
    else if (pc_noOf_PDUsNewConnection >0 or pc_noOf_PDUsSameConnection == 0){ //@sic R5s250050 sic@
      f_NR_RRCRelease(nr_Cell12);
      f_NR5GC_RRC_Idle_Extension(nr_Cell12); // @sic R5-236305 sic@
    }
    //@siclog "Step 44AA" siclog@// @sic R5-242147 R5s240309 sic@
    //The SS transmits an DLInformationTransfer message containing steering of roaming information indicating list of preferred PLMN/access technology combination provided with acknowledgment requested from the UE for successful reception, but no SOR-CMCI field included.
    v_Data := v_PlmnID & v_AccessTechId ;
    v_Header:= cs_NG_SOR_HeaderType0('1'B,'1'B,'1'B,'0'B); // @sic R5s240531 sic@
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(v_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_CounterSOR,
                                  v_Data,
                                  v_NAS_SecurityParams.KDF);
    
    v_Mac := bit2oct(v_Mac_A17);
    v_NAS_TxMsgContainer_SOR_CMCI := bit2oct(encvalue(cs_NG_SORTransparentContainer(v_Header, v_Mac, v_CounterSOR, v_Data, omit, omit)));
    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerSORMsg),
                                            omit,
                                            cs_PayloadContainer(omit, v_NAS_TxMsgContainer_SOR_CMCI));
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell12,
                                   tsc_NR_RbId_SRB2,
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,v_PduToSend.Msg)));

    //@siclog "Step 44B" siclog@
    //The SS starts timer of Tsor-cm timer.
    t_Sorcm.start;
    //@siclog "Step 44C" siclog@
    t_Tmax.start(f_NR_SetTimerToleranceMax(nr_Cell12, nonProtocolTimer, 660.0));
    //@siclog "Step 44D" siclog@// @sic R5-242147 R5s240309 sic@
    //The UE transmits an ULInformationTransfer message carrying acknowledgement of successful reception of the steering of roaming information.
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell12, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp; // @sic R5s201387 Baseline Moving sic@  @sic R5s210026 sic@
    if (not f_Check_NG_ULNASTransport(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_PayloadContainerType(tsc_PayloadContainerSORMsg), omit)) {
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UL NAS Transport Message Failed");
   }

    //@siclog "Step 45" siclog@
    //Check: Does the UE transmit a DEREGISTRATION REQUEST after Tsor-cm timer expires?
    t_Sorcm.timeout;
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell12, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    v_ReceivedMsg := v_ReceivedAsp.Signalling.Nas[0];
    if(not f_Check_NG_DeregistrationReqMOMsg(v_ReceivedMsg.Pdu, crs_DeregisterType('0'B, '0'B, '01'B))) {  // Jun24 @sic R5s240531 Baseline Moving sic@
        f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "De-registration Request Message Failed");
      }
      else {
        f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 45 pass");
      }
    //@siclog "Step 46" siclog@
    //The SS transmits a DEREGISTRATION ACCEPT message.
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell12,-, -,cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, cs_NG_DEREGISTRATION_ACCEPT)));
    // Need to 'reset' all stored lists as all DRBs and PDU sessions no longer exist in UE
    f_NR5GC_MobileInfo_Init();
    f_IMS_IPCAN_SendCoOrdMsg(IMS[f_PDN_PdnIndex2Integer(PDN_1)], cms_IPCAN_IMS_Reset);
    //@siclog "Step 47" siclog@
    //Check: Does the UE transmits an RRCSetupRequest on NR Cell 11 before tmax expires?
    alt {
      [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell11, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any))))
        {
          t_Tmax.stop;
          f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 47 pass");
        }
      [] t_Tmax.timeout
        {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Step 47 Fail");
        }
    }
    //@siclog "Step 48-49" siclog@
    //Steps 3 to 4 of the registration procedure described in TS 38.508-1 subclause 4.5.2.2-2 are performed on NR Cell 11.
    //@siclog "Steps 51-66a1" siclog@
    f_NR5GC_RRC_IdleState1N_Def(nr_Cell11, TESTMode_OFF);
    // @siclog "Steps 50" siclog@// @sic R5-242147 sic@
    //Void
  }//End of fl_TC_6_3_2_5_TestBody

  /*
   * @desc      REFERENCE TS 38.523-1 clause 6.3.2.6
   * @status    APPROVED (NR5GC)
   */
  function f_TC_6_3_2_6_NR5GC() runs on NR5GC_PTC
  { //Steering of UE in roaming after registration / SOR-CMCI rule / match all / Emergency call / DL NAS transport
  
    f_NR5GC_Init(NR_4);

    //Set Sys info and cell info for cell 11& 12 to be used
    f_NR_CellInfo_SetPLMN(nr_Cell11, tsc_NR_HPLMN_002_11);//PLMN2
    f_NR_CellInfo_SetPLMN(nr_Cell12, tsc_NR_HPLMN_002_81);//PLMN13
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell11);
    f_NR_CellConfig_Def(nr_Cell12);


    // Equip UE with the USIM configuration 21 specified in table 6.4.1-21 TS 38.508-1
    f_UT_USIM_Insert(UT, "USIM configuration 21 specified in table 6.4.1-21 TS 38.508-1");
    f_UT_SwitchOnUE(UT, false, CNF_REQUIRED);
    f_UT_AutomaticPLMN_Select (UT);
    f_UT_SwitchOffUE(UT, false, CNF_REQUIRED);
    
    f_NR5GC_Preamble (nr_Cell12, STATE_CONNECTED_3A); //@sic R5-233461 sic@
    
    f_NR_SetCellPower (nr_Cell11, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2); // @sic R5s230768 sic@
    f_NR_SetCellPower (nr_Cell12, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2); // @sic R5s230768 sic@

    f_NR_TestBody_Set(true);
    
    fl_TC_6_3_2_6_TestBody();
    
    f_NR_TestBody_Set(false);
   
    f_NR_Postamble(nr_Cell11, STATE_IDLE_1A);
  }

  /*
   * @desc      test body of TC_6_3_2_6
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_6_3_2_6_TestBody() runs on NR5GC_PTC
  {
    var NR_SRB_COMMON_IND v_ReceivedAsp;
    var octetstring  v_NAS_TxMsgContainer_SOR;
    var template (value) NG_NAS_DL_Pdu_Type v_PduToSend;
    var O16_Type v_Mac;
    var B128_Type v_Mac_A17;
    var NG_NAS_SecurityParams_Type v_NAS_SecurityParams;
    var octetstring v_Data;
    var NAS_PlmnId v_PlmnID := f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (nr_Cell11));
    var O2_Type v_AccessTechId :='0800'O;
    var O2_Type v_Counter :='0001'O;
    var template (value) SOR_Header v_Header := cs_NG_SOR_HeaderType0('1'B,'1'B,'1'B,'0'B, '1'B); //@sic R5-233461 R5s230768, R5s240531 sic@
    var octetstring v_Criterion_type:= 'FF'O;
    var octetstring v_Tsor_cm_timer:= '21'O;
    var octetstring v_Length;
    // @sic R5s230768 sic@
    var O1_Type v_Length_PlmnID_AccessTechId := int2oct(lengthof(v_PlmnID & v_AccessTechId),1);
    var template (value) SOR_DataType0WithAddInfo v_SOR_Data;
    var template (value) SOR_CMCIRule v_SOR_CMCIRule;
    timer t_Tsor:= 60.0;
    timer t_Tmax;
    
    //@siclog "Steps 1-21a1" siclog@
    //Void @sic R5-233461 R5-244240 sic@
  
    //@siclog "Step 22" siclog@
    //The SS transmits an DLInformationTransfer message containing steering of roaming information indicating list of preferred PLMN/access technology combination provided with acknowledgment requested from the UE for successful reception.
    v_Length := int2oct((lengthof(v_Criterion_type) + lengthof(v_Tsor_cm_timer)),2); // @sic R5s240592 sic@
    v_SOR_CMCIRule := cs_SOR_CMCIRule (v_Tsor_cm_timer, v_Criterion_type, omit, v_Length); // @sic R5s240592 sic@
    v_SOR_Data := cs_SOR_DataWithAddInfo(v_Length_PlmnID_AccessTechId,
                                         {cs_SOR_PLMN_AccessTech(v_PlmnID, v_AccessTechId)},
                                         '0'B,
                                         '0'B,
                                         '1'B,
                                         '1'B,  // octet O = '03'
                                         cs_SOR_CMCI({v_SOR_CMCIRule}, int2oct( (lengthof(v_Criterion_type) + lengthof(v_Tsor_cm_timer) + 2),2)));// @sic R5s240592 sic@

    v_Data := bit2oct(encvalue(v_SOR_Data));  // @sic R5s240531 sic@
    v_NAS_SecurityParams := f_NR5GC_Security_Get();
    v_Mac_A17 :=f_NG_Authentication_A17(bit2oct(encvalue(v_Header)),
                                  v_NAS_SecurityParams.KAUSF,
                                  v_Counter,
                                  v_Data,
                                  v_NAS_SecurityParams.KDF);
    v_Mac := bit2oct(v_Mac_A17);
    v_NAS_TxMsgContainer_SOR := bit2oct(encvalue(cs_NG_SORTransparentContainer(v_Header, v_Mac, v_Counter, v_Data, omit, omit))); // @sic R5s200639 sic@
    v_PduToSend := f_Get_NG_DLNASTransport (cs_PayloadContainerType(tsc_PayloadContainerSORMsg),
                                            omit,
                                            cs_PayloadContainer(omit, v_NAS_TxMsgContainer_SOR));
    SRB.send(cas_NR_SRB_NasPdu_REQ(nr_Cell12,
                                   tsc_NR_RbId_SRB2,
                                   cs_TimingInfo_Now,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,v_PduToSend.Msg)));
    //@siclog "Step 23" siclog@
    //The SS starts timer of Tsor-cm timer value
    t_Tsor.start;
    
    //@siclog "Step 24" siclog@
    //The SS starts timer of tmax =(6 minutes + cell selection time) (Note 1, 2 and 3)
    t_Tmax.start(f_NR_SetTimerToleranceMax(nr_Cell12, nonProtocolTimer, 480.0)); //@sic R5-233461 sic@
    
    //@siclog "Step 25" siclog@
    //The UE transmits an ULInformationTransfer message carrying acknowledgement of successful reception of the steering of roaming information
    SRB.receive(car_NR_SRB_NasPdu_IND(nr_Cell12, tsc_NR_RbId_SRB2, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered))) -> value v_ReceivedAsp;
    if (not f_Check_NG_ULNASTransport(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg, cr_PayloadContainerType(tsc_PayloadContainerSORMsg), omit)) {
     f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "UL NAS Transport Message Failed");
    }
    //@siclog "Step 26" siclog@
    //Make the UE attempt an IMS emergency call dialling an emergency number e.g. 112 or 911. (Note 4)
    f_UT_RequestIMSEmergencyCall (UT, "112");
    //@siclog "Step 27" siclog@
    //Generic procedure fo IMS Emergency call establishment in 5GC with IMS emergency registration as described in TS 38.508-1 [4] Table 4.9.11.2.2-1 is performed
    f_NR5GC_EmergencyCallPDUSession(nr_Cell12); //@sic R5-233461 sic@
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2], "Emergency Call Established"); // @sic R5s230768 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "step 27 IMS eCall Established");

    //@siclog "Step 28" siclog@
    //The SS waits for timer of Tsor-cm timer expiry.
    t_Tsor.timeout;
    //@siclog "Step 29" siclog@
    //Make the UE release the emergency call.
    //@siclog "Step 30" siclog@
    //The Generic test procedure for IMS MO Emergency call release as specified in TS 38.508-1 [4], subclause 4.9.12A takes place.
    f_NR5GC_EmergencyCallRelease(nr_Cell12);
    
    //@siclog "Step 30A" siclog@
    //The SS releases the RRC connection on NR cell 12.
    f_NR_RRCRelease(nr_Cell12); //@sic R5-233461 sic@
  
    //@siclog "Step 31" siclog@
    //Check: Does the UE transmit an RRCSetupRequest on NR Cell 11 before tmax expires?(Note 1, 2 and 3)

    alt { //@sic R5s201466 sic@
      [] SRB.check(receive(car_NR_SRB0_RrcPdu_IND(nr_Cell11, cr_38508_RRCSetupRequest(cr_NR_EstablishmentCause_Any))))
        {
          t_Tmax.stop;
          f_NR_PreliminaryPass (__FILE__, __LINE__, "Step 31 PASS");
        }
      [] t_Tmax.timeout
        {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Step 31 Failed");
        }
    }
    //@siclog "Steps 32 - 37a1" siclog@
    //Steps 2-3 of Table 4.9.5.2.2-1of the generic procedure in TS 38.508-1 [4] are performed
    //Steps 4 to 6a1 of Table 4.9.5.2.2-15.2.2-2 of the generic procedure in TS 38.508-1 [4] are performed on NR Cell 11.
    f_NR5GC_MobilityRegistration(nr_Cell11); // @sic R5s230768 R5-236181 sic@
  
 
 }//End of fl_TC_6_2_3_6_TestBody

}
