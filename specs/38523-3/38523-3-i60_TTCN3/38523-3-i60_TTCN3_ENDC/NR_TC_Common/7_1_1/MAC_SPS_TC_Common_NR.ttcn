  const B6_Type tsc_LCID_ConfigGrantCnf := '110111'B;    /* @status    APPROVED (ENDC, NR5GC) */

  const integer tsc_DL_SPS_HarqProcess := 1;             /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_HarqProcessConfig_Type cs_NR_HarqProcessConfig_DL_SPS := { SpecificSubset := {tsc_DL_SPS_HarqProcess }}; /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_MAC_PDU_SubHeader_Type cr_NR_MAC_ConfigGrantCnf_SubHeader := cr_NR_MAC_SubHeader(tsc_LCID_ConfigGrantCnf);      /* @status    APPROVED (ENDC, NR5GC) */

  template (value) SPS_Config cs_SPS_Config_Common (SPS_Config.periodicity p_Periodicity := ms160,
                                                    template (omit) SPS_Config.mcs_Table p_MCS_Table := omit,
                                                    template (omit) SPS_Config.sps_ConfigIndex_r16 p_SPS_ConfigIndex_r16 := omit,
                                                    template (omit) SPS_Config.harq_ProcID_Offset_r16 p_Harq_ProcID_Offset_r16 := omit,//@sic R5s230689 R5-236505 sic@
                                                    PUCCH_ResourceId p_PUCCH_ResourceId := 0) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
      periodicity             := p_Periodicity,
      nrofHARQ_Processes      := 8,
      n1PUCCH_AN              := p_PUCCH_ResourceId,
      mcs_Table               := p_MCS_Table,
      sps_ConfigIndex_r16     := p_SPS_ConfigIndex_r16,
      harq_ProcID_Offset_r16  := p_Harq_ProcID_Offset_r16,
      periodicityExt_r16      := omit,
      harq_CodebookID_r16     := omit,
      pdsch_AggregationFactor_r16 := omit,
      sps_HARQ_Deferral_r17       := omit,     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      n1PUCCH_AN_PUCCHsSCell_r17  := omit,     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      periodicityExt_r17          := omit,     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      nrofHARQ_Processes_v1710    := omit,     /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
      harq_ProcID_Offset_v1700    := omit      /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
  };

  template (value) SPS_Config cs_SPS_Config_711161 :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cs_SPS_Config_Common(ms80, -, -, -, 6); //@sic R5s230088 R5s230689 R5-236505 sic@

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_SpsCgActivateInfo_Type(NR_CellId_Type p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                             template (value) NR_SpsCgActivateInfo_Type p_NR_SpsCgActivateInfo) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo),
    Request := {
      SpsCg := { Activate := p_NR_SpsCgActivateInfo }
    }
  };

  template (value) NR_SpsCgActivateInfo_Type cs_NR_SpsCgActivateInfo_ULGrant (template (value) NR_UL_ConfiguredGrant_Type p_UplinkConfiguredGrant):=
  { /* @status    APPROVED (ENDC, NR5GC) */
      UplinkConfiguredGrant := p_UplinkConfiguredGrant,
      DownlinkSpsAssignment := omit
  };

  template (value) NR_SpsCgActivateInfo_Type cs_NR_SpsCgActivateInfo_DLAssignment (template (value) NR_DL_SpsAssignment_Type p_DownlinkSpsAssignment):=
  { /* @status    APPROVED (ENDC, NR5GC) */
      UplinkConfiguredGrant := omit,
      DownlinkSpsAssignment := p_DownlinkSpsAssignment
  };

  template (value) NR_DL_SpsAssignment_Type cs_NR_DL_SpsAssignment(template (value)  NR_DciDlInfo_Type p_DciDlInfo ,
                                             template (omit)  Null_Type p_SetNDI_1 := omit,
                                             template (omit) SPS_ConfigIndex_r16      p_SPS_ConfigIndex := omit):=
  { /* @status    APPROVED (ENDC, NR5GC) */
      DciInfo    := p_DciDlInfo,
      SetNDI_1   := p_SetNDI_1,
      SPS_ConfigIndex := p_SPS_ConfigIndex
  };

  template (value) NR_UL_ConfiguredGrant_Type cs_NR_UL_ConfiguredGrant(template (value)  NR_DciUlInfo_Type p_DciUlInfo ,
                                             template (omit)  Null_Type p_SetNDI_1 := omit):=
  {/* @status    APPROVED (ENDC, NR5GC) */
      DciInfo    := p_DciUlInfo,
      SetNDI_1   := p_SetNDI_1,
      ConfiguredGrantConfigIndex := omit
  };

  template (value) NR_SYSTEM_CTRL_REQ cas_NR_SpsCgDeactivateInfo_Type(NR_CellId_Type p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                             template (value) NR_SpsCgDeactivateInfo_Type p_NR_SpsCgDeactivateInfo) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo),
    Request := {
      SpsCg := { Deactivate := p_NR_SpsCgDeactivateInfo }
    }
  };

  template (value) NR_SpsCgDeactivateInfo_Type cs_NR_SpsCgDeactivate_LclRel :=
  { /* @status    APPROVED (ENDC, NR5GC) */
      LocalRelease := true
  };

  template (value) NR_SpsCgDeactivateInfo_Type cs_NR_SpsCgDeactivate_Pdcch_UL :=
  { /* @status    APPROVED (ENDC, NR5GC) */
      PdcchExplicitRelease := dci_0_0
  };

  template (value) NR_SpsCgDeactivateInfo_Type cs_NR_SpsCgDeactivate_Pdcch_DL :=
  { /* @status    APPROVED (ENDC, NR5GC) */
      PdcchExplicitRelease := dci_1_0
  };

  template (value) NR_DRB_COMMON_REQ cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(NR_CellId_Type p_NR_CellId,
                                                                       DRB_Identity p_DrbId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_MAC_PDUList_Type p_MAC_PDUList,
                                                                       template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                       integer p_SlotOffset := 0,
                                                                       template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit)
    modifies cas_NR_DRB_COMMON_REQ_MAC_PDUList :=
    /* @status    APPROVED (ENDC, NR5GC) */
    {
        SuppressPdcchForC_RNTI  := true
    }

    template (present) NR_SYSTEM_IND car_NR_SYSTEM_UL_HARQ_IND_Timing(NR_CellId_Type p_NR_CellId,
                                                             template (present) HARQ_Type p_HARQ_Type,
                                                             template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any
                                                             ) :=
      /* @status    APPROVED (ENDC, NR5GC) */
      car_NR_SYSTEM_IND(p_NR_CellId, cr_NR_SystemIndication_UL_HARQ(p_HARQ_Type),p_TimingInfo);

 template (value) NR_DL_SCH_CRC_Type cs_NR_DL_SCH_CRC_CSRNTI(template (value) NR_MAC_Test_DL_SCH_CRC_Mode_Type p_NR_MAC_Test_DL_SCH_CRC_Mode) := { CS_RNTI := p_NR_MAC_Test_DL_SCH_CRC_Mode }; /* @status    APPROVED (ENDC, NR5GC) */

 template (value) NR_SYSTEM_CTRL_REQ cas_NR_L1_TestModeCRC_CSRNTI_REQ(NR_CellId_Type p_NR_CellId,
                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                             template (value) NR_MAC_Test_DL_SCH_CRC_Mode_Type p_NR_MAC_Test_DL_SCH_CRC_Mode := Normal) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, -, -, p_TimingInfo),
    Request := {
      L1_TestMode := {
        DL_SCH_CRC := cs_NR_DL_SCH_CRC_CSRNTI(p_NR_MAC_Test_DL_SCH_CRC_Mode)
      }
    }
  };

  template (value) NR_DciUlInfo_Type cs_NR_DciUlInfo_ModifyGrant_71163(template (value) NR_FreqDomainSchedulExplicit_Type p_FreqDomainSchedul,
                                                                  template (omit) NR_DciCommon_TimeDomainResourceAssignment_Type p_TimeDomainResourceAssignment := omit,
                                                                  template (value) NR_ImcsValue_Type p_ImcsValue,
                                                                  template (omit) NR_HarqProcessConfig_Type p_HarqProcessConfig := omit,
                                                                  template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := omit, //@sic R5-221589 sic@
                                                                  template (omit)  NR_DciFormat_0_X_SpecificInfo_Type p_NR_DciFormat_0_X_SpecificInfo := omit
                                                                  ) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    ResoureAssignment := cs_NR_DciFormat_0_X_ResourceAssignment(p_ResourceAllocationType,
                                                                p_FreqDomainSchedul,
                                                                p_TimeDomainResourceAssignment,                 /* @sic R5s190827 change 9 sic@ */
                                                                cs_NR_TransportBlockRetransmissionList_Def(p_ImcsValue),
                                                                p_HarqProcessConfig),
   PuschHoppingCtrl := cs_NR_DciFormat_0_X_PuschHoppingCtrl_Flag('0'B),
   TpcCommandPusch := cs_NR_DciCommon_TpcCommand,
   UL_SUL_Indicator := cs_NR_DciFormat_0_X_UL_SUL_Indicator_None,
   Format         := p_NR_DciFormat_0_X_SpecificInfo
  };

  template (value) SymbolTimingInfo_Type cs_SymbolTimingInfo_Any :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5s230067 sic@
    Any := true
  };

  /*
   * @desc      To configure DL SPS Assignment
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_N_PRB
   * @param     p_I_MCS
   * @param     p_SetNDI_1          (default value: omit)
   * @param     p_HarqProcessConfig (default value: cs_NR_HarqProcessConfig_DL_SPS)
   * @param     p_SPS_ConfigIndex   (default value: omit)
   * @param     p_RedundancyVersion (default value: 0)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_DL_SpsAssignmentConfiguration(NR_CellId_Type   p_NR_CellId,
                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                            integer p_N_PRB,
                                            integer p_I_MCS,
                                             template (omit)  Null_Type p_SetNDI_1 := omit,
                                             template (value) NR_HarqProcessConfig_Type p_HarqProcessConfig := cs_NR_HarqProcessConfig_DL_SPS,
                                             template (omit) SPS_ConfigIndex_r16  p_SPS_ConfigIndex := omit,//@sic R5s240563 sic@
                                             NR_RedundancyVersion_Type p_RedundancyVersion := 0
                                            ) runs on NR_BASE_PTC
  { //@sic R5s221197 sic@
   //var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
   //var integer v_Max_nPRB := f_NR_CellInfo_GetCarrierBandwidth_DL(nr_Cell1);
   var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);
   var template (value) NR_DciDlInfo_Type v_DciDlInfo := cs_NR_DciDlInfo_Init(resourceAllocationType1,
                                                                               cs_NR_FreqDomainResourceAssignmentDL_Explicit(0, p_N_PRB),
                                                                               cs_NR_DciCommon_TimeDomainResourceAssignment('0000'B),
                                                                               cs_NR_TransportBlockSchedulingDL_Explicit(cs_NR_TransportBlockRetransmissionList_Def(p_I_MCS,p_RedundancyVersion)),
                                                                               p_HarqProcessConfig,
                                                                               cds_NR_DciFormat_1_0_Params_SetPDSCHarqIndicator(v_SCS,-, cs_NR_DciFormat_1_X_PdschHarqTimingIndicator('111'B)));
                                                                              
    f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_SpsCgActivateInfo_Type(p_NR_CellId, p_TimingInfo, cs_NR_SpsCgActivateInfo_DLAssignment( cs_NR_DL_SpsAssignment(v_DciDlInfo,p_SetNDI_1,p_SPS_ConfigIndex))));
  };

    /*
   * @desc     Configure UL configured grant
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_ResourceAllocation
   * @param     p_SetNDI_1          (default value: omit)
   * @param     p_HarqProcessConfig (default value: cs_NR_HarqProcessConfig_AnyProcess)
   * @param     p_ResourceAllocationType (default value: resourceAllocationType1)
   * @param     p_ConfiguredGrantType1 (default value: false)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_UL_CgGrantConfiguration(NR_CellId_Type   p_NR_CellId,
                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                            template (value) NR_ResourceAllocation_Type p_ResourceAllocation,
                                             template (omit)  Null_Type p_SetNDI_1 := omit,
                                            template (value) NR_HarqProcessConfig_Type p_HarqProcessConfig := cs_NR_HarqProcessConfig_AnyProcess,
                                            template (omit) NR_ResourceAllocationType_Type p_ResourceAllocationType := resourceAllocationType1, //@sic R5s230287 sic@
                                            boolean p_ConfiguredGrantType1 := false
                                            ) runs on NR_BASE_PTC
  { //The HARQ process as per 38.321 clause 5.4.1 in UL configured grant is devised by timing and remains same in
  // one config grant period/cycle. and the HARQ process changes per period modulo configured HARQ process. i.e.
  //Starting from T0 the HARQ proces 0 is used for one Grant period, then in next period process 1, and so on.
  // Hence cs_NR_HarqProcessConfig_AnyProcess is used so SS and UE devises the HARQ process.
  // Similarly any retransmission scheduled within the configured grant period of initial transmission should use same UL HARQ process

   //@sic R5s221062 sic@
   var template (value) NR_DciUlInfo_Type v_DciUlInfo;
   
   if(p_ConfiguredGrantType1) {
     v_DciUlInfo :=cs_NR_DciUlInfo_ModifyGrant_71163(cs_NR_FreqDomainSchedulExplicit(-, valueof(p_ResourceAllocation.Lrbs)),
                                                                                          cs_NR_DciCommon_TimeDomainResourceAssignment('0000'B),
                                                                                          p_ResourceAllocation.Imcs,
                                                                                          p_HarqProcessConfig,
                                                                                          p_ResourceAllocationType,
                                                                                          cs_NR_DciFormat_0_1_Params);
    } else {
      v_DciUlInfo :=cs_NR_DciUlInfo_ModifyGrant_71163(cs_NR_FreqDomainSchedulExplicit(-, valueof(p_ResourceAllocation.Lrbs)),
                                                                                          cs_NR_DciCommon_TimeDomainResourceAssignment('0000'B),
                                                                                          p_ResourceAllocation.Imcs,
                                                                                          p_HarqProcessConfig,
                                                                                          p_ResourceAllocationType,
                                                                                          cs_NR_DciFormat_0_0_Params);
      }

   f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_SpsCgActivateInfo_Type(p_NR_CellId, p_TimingInfo, cs_NR_SpsCgActivateInfo_ULGrant( cs_NR_UL_ConfiguredGrant(v_DciUlInfo,p_SetNDI_1))));
  };

  /*
   * @desc      To deactivate SPS/Configured grant
   * @param     p_NR_CellId
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_NR_SpsCgDeactivateInfo
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_SpsCgDeactivate(NR_CellId_Type   p_NR_CellId,
                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                        template (value) NR_SpsCgDeactivateInfo_Type p_NR_SpsCgDeactivateInfo) runs on NR_BASE_PTC
  {
      f_NR_SS_CommonCellConfig(p_NR_CellId, cas_NR_SpsCgDeactivateInfo_Type(p_NR_CellId, p_TimingInfo,p_NR_SpsCgDeactivateInfo ));
  }

  /*
   * @desc      encode NR RLC data PDU with one RLC SDU
   * @param     p_RLC_SDU
   * @return    octetstring
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RLC_UMD_FullPDU_Encvalue(octetstring p_RLC_SDU) return octetstring
  {
     var template (value) NR_RLC_UMD_PduNoSN_Type v_NR_RLC_UMD_PduNoSN := cs_NR_RLC_UMD_PduNoSN(p_RLC_SDU);
    var template (value) NR_RLC_PDU_Type v_NR_RLC_PDU := cs_NR_RLC_PDU_UMD(cs_NR_RLC_UMD_PDU_NoSN(v_NR_RLC_UMD_PduNoSN)); //Carries full SDU hence no SEquence number
    return f_NR_RLC_PDU_Encvalue(v_NR_RLC_PDU );
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.1
   * @param     p_NR_DRB_Id
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_1_NR_TestBody1(DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    const integer const_SPS_Period :=80; // period in milli seconds
    const integer const_HARQ_Id := 1; //arbitrarily selected in steps 17 and 20
    var NR_MAC_SDU_Type v_EncodedRlcPdu1;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var SubFrameTiming_Type v_TimingDL;
    var SubFrameTiming_Type v_TimingDL_2;
    var SubFrameTiming_Type v_TimingDL_CRNTI;
    var SubFrameTiming_Type v_TimingUL_1;
    var SubFrameTiming_Type v_TimingUL_2;
    var SubFrameTiming_Type v_TimingUL_3;
    var SubFrameTiming_Type v_TimingUL_4;
    var SubFrameTiming_Type v_TimingUL_5_CRNTI;
    var SubFrameTiming_Type v_TimingUL_6;
    //var SubFrameTiming_Type v_TimingUL_7; //@sic R5s240660 R5s240565r1 sic@
    var SubFrameTiming_Type v_TimingUL_9;
    var SubFrameTiming_Type v_TimingUL_10;
    var SubFrameTiming_Type v_TimingUL_11;
    var SubFrameTiming_Type v_TimingDL_Step11b;  //@sic R5s240268 sic@
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);
    var integer v_I_MCS;      // Modulation and Coding Scehme Index
    var integer v_N_PRB;      // Number of physical resource Blocks
    var NR_PhysicalParameters_Type v_NR_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(nr_Cell1);
    var template (value) NR_DciDlInfo_Type v_DciDlInfo := f_NR_DciDlInfo_Init(v_NR_PhysicalParameters, cds_NR_DciFormat_1_0_Params_SetPDSCHarqIndicator(v_NR_PhysicalParameters.SubcarrierSpacing, -, cs_NR_DciFormat_1_X_PdschHarqTimingIndicator('111'B)), cs_NR_RedundancyVersionList_SingleRV(0));  //@sic R5s237339 sic@
    //@sic R5s240155 sic@
    //@sic R5s240563 sic@
    var integer v_RetransSchInt := 20; //@sic R5s250065 sic@
    var integer i;
    var NR_RedundancyVersionList_Type v_RVList := {0, 2, 3, 1, 0};
    var integer v_Nack_Count := 0;
    var integer v_Ack_Count := 0;


    timer t_Watchdog := 10.0;
    //@sic R5s240565 sic@
    f_NR_ULGrantConfiguration_Stop(nr_Cell1);
        
    // Configure for indication of UL HARQ ACK/NACK
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable));
    // Initialise Nprb and Imcs for TBsize=352
    //@sic R5s230300 sic@
     if ( f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_N_PRB := 7; v_I_MCS:= 3;} //TS 38.508-1 Table 4.6.3-51 Table 4.6.3-51 =1, so 38.523-3 Table B.1.1.2-3
     else {v_N_PRB :=11 ; v_I_MCS:= 0}//TS 38.508-1 Table 4.6.3-51 Table 4.6.3-51 =0, so 38.523-3 Table B.1.1.1-3

    v_TimingDL := f_NR_GetNextSendOccasion_DL(nr_Cell1, 480);
    v_TimingUL_1:=  v_TimingDL;
    v_TimingUL_1.Symbol := valueof(cs_SymbolTimingInfo_Any); //@sic R5s230088 sic@
    select(v_SCS) {
        case(kHz15) {
            v_TimingDL.Subframe.Number := 1;
            v_TimingUL_1.Subframe.Number := 9;
        }
        case(kHz30) {
            v_TimingDL.Subframe.Number := 0;
            v_TimingDL.Slot.SlotOffset.Numerology1 := 0;
            v_TimingUL_1.Subframe.Number := 4;
            v_TimingUL_1.Slot.SlotOffset.Numerology1 := 0;
        }
        case(kHz120) {
            v_TimingDL.Subframe.Number := 0;
            v_TimingDL.Slot.SlotOffset.Numerology3 := 1;
            v_TimingUL_1.Subframe.Number := 1;
            v_TimingUL_1.Slot.SlotOffset.Numerology3 := 1;
        }
        case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
    }
   f_NR_SS_CellConfig_DciDlInfo_NoRetransmission(nr_Cell1);
    // @siclog "Steps 1 - 2" siclog@
    f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS);
    t_Watchdog.start;
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (0, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    
    //@siclog "Step 4" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period);
    v_TimingUL_2 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_1,const_SPS_Period);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (1, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));

    //@siclog "Step 6-7" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_TimingUL_3 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_2,const_SPS_Period/2);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (2, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS);
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));

    //@siclog "Step 9" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_TimingUL_4 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_3,const_SPS_Period/2);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (3, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));

    //@siclog "Step 11a1, 11a2 11b1" siclog@
    //C-RNTI grant auto transferred by SS
    //@sic R5s221197  R5s230088 R5-237339 R5-240268 sic@
    if (pc_dl_SchedulingOffset_PDSCH_TypeA)
      {
    //@siclog "Step 11a1-11a2" siclog@
    select(v_SCS) {
        case(kHz15) {
            v_TimingDL_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2 - 4); // C-RNTI ActTime with k0=4 -- k1 needs to be adjusted to 8
            v_TimingUL_5_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period/2); // Receive C-RNTI HARQ with same timing as SPS HARQ
            }
        case(kHz30) {
            v_TimingDL_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2 - 2); // C-RNTI ActTime with k0=4 -- k1 needs to be adjusted to 8
            v_TimingUL_5_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period/2); // Receive C-RNTI HARQ with same timing as SPS HARQ
            }
        case(kHz120) {
            v_TimingDL_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2 - 1); // C-RNTI ActTime with k0=4 -- k1 needs to be adjusted to 8
            v_TimingDL_CRNTI.Slot.SlotOffset.Numerology3 := 5;
            v_TimingUL_5_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period/2); // Receive C-RNTI HARQ with same timing as SPS HARQ
            }
        case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
    }

    
    //Set K1=8
    v_DciDlInfo.ResoureAssignment.TimeDomain.Index := int2bit(1, 4);
    f_NR_SS_CommonCellConfig(nr_Cell1, cas_NR_DciDlInfo_REQ(nr_Cell1, cs_TimingInfo_NR( v_TimingDL_CRNTI), v_DciDlInfo));
    
    // PDCP SDU =36B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =42B=336 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (3, crs_NR_PDCP_SDU_36B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL_CRNTI), v_MAC_PDUListDL));
    }
      else
    {
      //@siclog "Step 11b1" siclog@
      v_TimingDL_Step11b := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2); // Normal SPS transmission
      v_TimingUL_5_CRNTI := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period/2); // Receive HARQ with same timing as SPS HARQ
      // PDCP SDU =36B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =42B=336 bits (an allowed TB size as per 38.523-3 Annex B)
      v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (3, crs_NR_PDCP_SDU_36B, 1)));//@sic R5-227518 sic@
      v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
      v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
      DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL_Step11b), v_MAC_PDUListDL));

    }

    //@siclog "Step 12-13 void " siclog@
    //@siclog "Step 14 " siclog@
    //@sic R5-237339 sic@

    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period+const_SPS_Period/2);
    v_TimingUL_6 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period+const_SPS_Period/2);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (4, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    
    // @siclog "Step 16-17" siclog@
    //@sic R5s240660 sic@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    f_NR_SS_L1_TestModeConfig(nr_Cell1, cas_NR_L1_TestModeCRC_CSRNTI_REQ(nr_Cell1, cs_TimingInfo_NR( v_TimingDL), Error1AndNormal));
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    //v_TimingUL_7 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_6,const_SPS_Period);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (5, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    //@siclog Step 16 is void sic@
    //f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS);
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL,cs_NR_HarqProcessAssignment_Explicit(const_HARQ_Id)));

    /*
    //@siclog "Step 19-20" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_TimingUL_8 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_7,const_SPS_Period/2);
    f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS,true);//NDI=1
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL,cs_NR_HarqProcessAssignment_Explicit(const_HARQ_Id)));
    */
    //@siclog "Step 19-20" siclog@
    //@sic R5s240563 sic@
    for (i:=1; i< 4; i:=i+1) //Scheduled 3 retransmissions assuming worst case.
      {
        v_TimingDL_2 := f_SubFrameTiming_AddMilliSeconds(v_TimingDL, i * v_RetransSchInt);
        f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL_2),v_N_PRB,v_I_MCS,true,-,-,v_RVList[i]);
        DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL_2), v_MAC_PDUListDL,cs_NR_HarqProcessAssignment_Explicit(const_HARQ_Id)));
      }


    //@siclog "Step 22 " siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period-10); // 10 ms earlier
    v_TimingUL_9 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_6,2*const_SPS_Period-10);
    f_NR_SpsCgDeactivate(nr_Cell1, cs_TimingInfo_NR( v_TimingDL),cs_NR_SpsCgDeactivate_Pdcch_DL);
    //@siclog "Step 24 " siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,10+const_SPS_Period);
    v_TimingUL_10 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_9,10+const_SPS_Period);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (6, crs_NR_PDCP_SDU_38B,1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    //@siclog "Step 26-27 " siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period);
    v_TimingUL_11 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_10,const_SPS_Period);
    f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS);
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    //@sic R5-237339 R5s240155 R5s240268 sic@
    if (pc_dl_SchedulingOffset_PDSCH_TypeA) //Default DCI configuraton.
    {
         //undo Set K1=8
       f_NR_SS_CellConfig_DciDlInfo_NoRetransmission(nr_Cell1,cs_TimingInfo_NR(f_SubFrameTiming_AddMilliSeconds(v_TimingDL,50)));
         
    }

    // @siclog "Step 3" siclog@
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_1) ));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    // @siclog "Step 5" siclog@
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_2) ));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    // @siclog "Step 8" siclog@
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_3) ));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 10 11a3 or 11b2" siclog@
    //@sic R5s230088 sic@
    alt {
        [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_4) ))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
            repeat;
        }
        [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_5_CRNTI) ))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11a3 or 11b2");
        }
    }

   // @siclog "Step 15" siclog@
   SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_6) ));
   f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15");
   /*
   // @siclog "Step 18" siclog@
   SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, nack, cr_TimingInfo_NR( v_TimingUL_7) ));
   //f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 18");
   // @siclog "Step 21" siclog@
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_8) ));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21");
    */
    //@sic R5s240563  R5s240660  R5s240565 sic@
    // @siclog "Step 18 & 21" siclog@
    alt {
      []SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_Any ))
        {
          v_Ack_Count := v_Ack_Count +1;
          if ((v_Ack_Count + v_Nack_Count) < 4) {
            repeat;
          }
          else {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21: UE sent HARQ ACK ");
          }
        }
      [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, nack, cr_TimingInfo_Any ))
        {
          v_Nack_Count := v_Nack_Count + 1;
          if ((v_Ack_Count + v_Nack_Count) < 4) {
            repeat;
          }
          else if (v_Ack_Count == 0) {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 21: UE did not send HARQ ACK");
          }
          else {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21: UE sent HARQ ACK ");
          }
        }
    }
    





    // @siclog "Step 23" siclog@
    SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_9) ));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 23");
    // @siclog "Step 25 and 28" siclog@
    alt {
        [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_10) ))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 25");
            repeat;
        }
        [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ack, cr_TimingInfo_NR( v_TimingUL_11) ))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 28");
        }
    }
   f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable));
   t_Watchdog.stop;
   //@sic R5s240565 sic@
   f_NR_ULGrantConfiguration_Start(nr_Cell1);
   return (v_TimingDL);
   
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.1
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_1_NR_TestBody2(DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC
  {//@sic R5-245514 sic@
    var NR_MAC_SDU_Type v_EncodedRlcPdu1;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var SubFrameTiming_Type v_TimingDL ;
    var SubFrameTiming_Type v_TimingUL_1;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);
    var integer v_I_MCS;      // Modulation and Coding Scehme Index
    var integer v_N_PRB;      // Number of physical resource Blocks
    timer t_Watchdog := 1.0;

    // Re-nitialise Nprb and Imcs for TBsize=352
    if ( f_NR_CellInfo_GetIsFR1(nr_Cell1)) {v_N_PRB := 7; v_I_MCS:= 3;} //TS 38.508-1 Table 4.6.3-51 Table 4.6.3-51 =1, so 38.523-3 Table B.1.1.2-3
    else {v_N_PRB :=11 ; v_I_MCS:= 0}//TS 38.508-1 Table 4.6.3-51 Table 4.6.3-51 =0, so 38.523-3 Table B.1.1.1-3
    v_TimingDL := f_NR_GetNextSendOccasion_DL(nr_Cell1, 200);//@sic R5-245514 sic@
    v_TimingUL_1:=  v_TimingDL;
    select(v_SCS) {
        case(kHz15) {
            v_TimingDL.Subframe.Number := 1;
            v_TimingUL_1.Subframe.Number := 9;
        }
        case(kHz30) {
            v_TimingDL.Subframe.Number := 0;
            v_TimingDL.Slot.SlotOffset.Numerology1 := 0; //@sic R5s221197 sic@
            v_TimingUL_1.Subframe.Number := 4;
            v_TimingUL_1.Slot.SlotOffset.Numerology1 := 0;
        }
        case(kHz120) {
            v_TimingDL.Subframe.Number := 0;
            v_TimingDL.Slot.SlotOffset.Numerology3 := 1;
            v_TimingUL_1.Subframe.Number := 1;
            v_TimingUL_1.Slot.SlotOffset.Numerology3 := 1;
        }
        case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
    }
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(enable));
    // @siclog "Step 31" siclog@
    //@sic R5s240268 R5-245514 sic@
    f_NR_DL_SpsAssignmentConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL),v_N_PRB,v_I_MCS);
    // PDCP SDU =38B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =44B=352 bits (an allowed TB size as per 38.523-3 Annex B)
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (7, crs_NR_PDCP_SDU_38B, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := { cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu1) };
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    DRB.send(cads_NR_DRB_COMMON_REQ_MAC_PDUList_NoCRNTI_Grant(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,10); //10ms later
    f_NR_SpsCgDeactivate(nr_Cell1, cs_TimingInfo_NR( v_TimingDL),cs_NR_SpsCgDeactivate_LclRel);
    // @siclog "Step 32" siclog@
    t_Watchdog.start;
    alt {
        [] SYSIND.receive(car_NR_SYSTEM_UL_HARQ_IND_Timing(nr_Cell1, ? , cr_TimingInfo_NR( v_TimingUL_1) ))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 32");
            t_Watchdog.stop;
        }
       []t_Watchdog.timeout
       {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 32");
       }
    }
    f_NR_SS_SystemIndCtrlConfig(nr_Cell1, cds_NR_SystemIndCtrl_UL_HARQ(disable));
   
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.3
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_3_NR_TestBody1(DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC
  {
    const integer const_SPS_Period :=40; // period in milli seconds

    const integer const_UL_TBS_CRNTI := 144; //
    const integer const_UL_TBS_CSRNTI := 160; //160 bits
    
    var NR_MAC_SDU_Type v_EncodedRlcPdu1;
    var NR_MAC_SDU_Type v_EncodedRlcPdu2;
    var NR_MAC_SDU_Type v_EncodedRlcPdu3;
    var NR_MAC_SDU_Type v_EncodedRlcPdu4;
    var NR_MAC_SDU_Type v_EncodedRlcPdu5;
    var NR_MAC_SDU_Type v_EncodedRlcPdu6;
    var NR_MAC_SDU_Type v_EncodedRlcPdu7;
    var NR_MAC_SDU_Type v_EncodedRlcPdu8;
    var NR_MAC_SDU_Type v_EncodedRlcPdu9; //@sic R5-225377 sic@
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL1;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL1;
    var SubFrameTiming_Type v_TimingDL;
    var SubFrameTiming_Type v_TimingUL_1;
    var SubFrameTiming_Type v_TimingUL_2;
    var SubFrameTiming_Type v_TimingUL_3;
    var SubFrameTiming_Type v_TimingUL_4;
    var SubFrameTiming_Type v_TimingUL_5;
    var SubFrameTiming_Type v_TimingUL_6;
    var SubFrameTiming_Type v_TimingUL_7;
    var SubFrameTiming_Type v_TimingUL_8;
    var SubFrameTiming_Type v_TimingUL_9;
    var SubFrameTiming_Type v_TimingUL_10;
    var SubFrameTiming_Type v_TimingUL_11;
    var SubFrameTiming_Type v_TimingUL_11A;//@sic R5-225377 sic@
    var SubFrameTiming_Type v_TimingUL_12;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);

    var NR_ResourceAllocation_Type v_NR_ResourceAllocation_CRNTI ;
    var NR_ResourceAllocation_Type v_NR_ResourceAllocation_CSRNTI;
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(nr_Cell1, tsc_NR_BWP_Id);
    var template (present) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListUL;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL1;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL2;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL3;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL4;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL5;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL6;
    
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL7;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL8;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL9;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL10;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL11;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL11A;//@sic R5-225377 sic@
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL12;
    //@sic R5s250264 sic@
    var B6_Type v_LCID := int2bit(p_NR_DRB_Id+3, 6);
    var template (present) NR_MAC_CE_SubPDU_UL_List_Type v_CE_SubPDUListUL;
    timer t_Watchdog := 10.0;

    v_NR_ResourceAllocation_CRNTI  := f_NR_ResourceAllocation_UplinkGrant(const_UL_TBS_CRNTI, v_NR_UplinkBWP,-, formats0_0_And_1_0);
    v_NR_ResourceAllocation_CSRNTI:= f_NR_ResourceAllocation_UplinkGrant(const_UL_TBS_CSRNTI, v_NR_UplinkBWP,-, formats0_0_And_1_0);
    
    
    
    // Stop UL Grant configuration
    f_NR_ULGrantConfiguration_Stop(nr_Cell1, cs_TimingInfo_Now, cs_NR_UplinkTimeAlignment_Stop);

    // Configure for indication of UL Data and UL grant on PDCCH
    // As per TS 38.508-1 Table 4.6.3-122 the default K2 is 4 slots
    v_TimingDL := f_NR_GetNextSendOccasion_DL(nr_Cell1, 480);
    v_TimingUL_1:=  v_TimingDL;
    v_TimingUL_1.Symbol := valueof(cs_SymbolTimingInfo_Any); //@sic R5s230067 sic@
    select(v_SCS) {
        case(kHz15) {
            v_TimingDL.Subframe.Number := 5;
            v_TimingUL_1.Subframe.Number := 9;
        }
        case(kHz30) {
            v_TimingDL.Subframe.Number := 2;
            v_TimingDL.Slot.SlotOffset.Numerology1 := 0;
            v_TimingUL_1.Subframe.Number := 4;
            v_TimingUL_1.Slot.SlotOffset.Numerology1 := 0;
        }
        case(kHz120) {
            v_TimingDL.Subframe.Number := 0;
            v_TimingDL.Slot.SlotOffset.Numerology3 := 5;
            v_TimingUL_1.Subframe.Number := 1;
            v_TimingUL_1.Slot.SlotOffset.Numerology3 := 1;
        }
        case else { FatalError(__FILE__, __LINE__, "Invalid SubCarrierSapcing"); }
    }

    // @siclog "Steps 3" siclog@

    // PDCP SDU =12B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =18 byte =144 bits
    // 6 MAC Sub PDU's 6*144 = 864. 888 is next allowed downlink TBS in all tables, 24 bit =3 byte padding in DL.
    //@sic R5-227518 sic@
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (0, crs_NR_PDCP_SDU_12B, 1)));
    v_EncodedRlcPdu2 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (1, crs_NR_PDCP_SDU_12B1, 1)));
    v_EncodedRlcPdu3 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (2, crs_NR_PDCP_SDU_12B2, 1)));
    v_EncodedRlcPdu4 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (3, crs_NR_PDCP_SDU_12B3, 1)));
    v_EncodedRlcPdu5 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (4, crs_NR_PDCP_SDU_12B4, 1)));
    v_EncodedRlcPdu6 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (5, crs_NR_PDCP_SDU_12B5, 1)));
    v_EncodedRlcPdu7 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (6, crs_NR_PDCP_SDU_12B6, 1)));
    v_EncodedRlcPdu8 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (7, crs_NR_PDCP_SDU_12B7, 1)));
    v_EncodedRlcPdu9 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (8, crs_NR_PDCP_SDU_12B8, 1)));
    v_SDU_SubPDUListDL := {
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu1),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu2),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu3),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu4),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu5),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu6)};
    v_SDU_SubPDUListDL1 := {
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu7),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu8),//@sic R5-225377 sic@
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu9)};

    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL,cs_NR_MAC_Padding_SubPDU(tsc_NR_MAC_Padding_2B)) };
    // PDCP SDU =12B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header +1 byte padding =19 byte =152 bits
    v_MAC_PDUListDL1 := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL1) };
    // prepare UL PDU's
    v_CE_SubPDUListUL := { cr_NR_MAC_CE_SubPDU_UL(cr_NR_MAC_ConfigGrantCnf_SubHeader),* };
    //@sic R5s230507 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));
    

    //@siclog "Step 5" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,60); //60 ms after
    f_NR_UL_CgGrantConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL), v_NR_ResourceAllocation_CSRNTI);
    // Prepare step 6
    v_TimingUL_1 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_1,60); //Step 6 timing
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu1)};
    v_MAC_PDUListUL1 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, v_CE_SubPDUListUL, *) };
    //Prepare step 7
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu2)};
    v_MAC_PDUListUL2 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period);
    v_TimingUL_2 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_1,const_SPS_Period); //Step 7 Timing


    //@siclog "Step 8" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    f_NR_UL_CgGrantConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL), v_NR_ResourceAllocation_CSRNTI);
    //Prepare step 9
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu3)};
    v_MAC_PDUListUL3 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, v_CE_SubPDUListUL, *) };
    v_TimingUL_3 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_2,const_SPS_Period/2);//Step 9 Timing

    //Prepare step 10
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_MAC_PDUListUL4 := { cr_NR_UL_MAC_PDU(*, *, *) };
    v_TimingUL_4 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_3,const_SPS_Period/2);//Step 10 Timing

    //Prepare step 11
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu4)};
    v_MAC_PDUListUL5 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    v_TimingUL_5 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_SPS_Period/2);//Step 11 Timing

    //@siclog "Step 12" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    f_NR_UL_CgGrantConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL), v_NR_ResourceAllocation_CSRNTI, true); // NDI =1

    //Prepare step 13
    //v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_MAC_PDUListUL6 := v_MAC_PDUListUL5;
    v_TimingUL_6 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_5,const_SPS_Period/2);//Step 13 Timing

    //Prepare step 14
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu5)};
    v_MAC_PDUListUL7 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period/2);
    v_TimingUL_7 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_6,const_SPS_Period/2);//Step 14 Timing

    //@siclog "Step 15" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period);
    f_NR_OneULGrantTransmission(nr_Cell1, cs_TimingInfo_NR(v_TimingDL), v_NR_ResourceAllocation_CRNTI);
    //prepare step 16
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu6)};
    v_MAC_PDUListUL8 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    v_TimingUL_8 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_7,const_SPS_Period);//Step 16 Timing

    //prepare step 17
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period);
    v_MAC_PDUListUL9 := { cr_NR_UL_MAC_PDU(omit, *, *) };
    v_TimingUL_9 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_8,const_SPS_Period);//Step 17 Timing

    //@siclog "Step 18" siclog@
    //@sic R5s230507 sic@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,10);
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL1));

    //prepare step 19
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period-10);
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu7)};
    v_MAC_PDUListUL10 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    v_TimingUL_10 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_9,const_SPS_Period);//Step 19 Timing
    //@siclog "Step 20" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,10);
    f_NR_SpsCgDeactivate(nr_Cell1, cs_TimingInfo_NR( v_TimingDL),cs_NR_SpsCgDeactivate_Pdcch_UL);

    //prepare step 21
    //@sic R5-225377 sic@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period-10);
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu8)};
    v_MAC_PDUListUL11 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, v_CE_SubPDUListUL, *) };
    v_TimingUL_11 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_10,const_SPS_Period);//Step 21 Timing

    //prepare step 21A
    //v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,const_SPS_Period-10);
    v_MAC_PDUListUL11A := { cr_NR_UL_MAC_PDU(*, *, *) };
    v_TimingUL_11A := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_11,const_SPS_Period);//Step 21 Timing
   
    //@siclog "Step 22" siclog@
    v_TimingDL := f_SubFrameTiming_AddMilliSeconds(v_TimingDL,2*const_SPS_Period);
    f_NR_UL_CgGrantConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL), v_NR_ResourceAllocation_CSRNTI);
    //prepare step 23
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(16, 8)),  v_EncodedRlcPdu9)};
    v_MAC_PDUListUL12 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, v_CE_SubPDUListUL, *) }; //@sic R5s230067 sic@
    v_TimingUL_12 := f_SubFrameTiming_AddMilliSeconds(v_TimingUL_11,2*const_SPS_Period);//Step 23 Timing


    t_Watchdog.start;
    // @siclog "Step 6" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_1), v_MAC_PDUListUL1));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    // @siclog "Step 7" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_2), v_MAC_PDUListUL2));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    // @siclog "Step 9" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_3), v_MAC_PDUListUL3));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    // @siclog "Step 10 and 11" siclog@
    alt {
        []  DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_4), v_MAC_PDUListUL4))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
            repeat;
        }
        []  DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_5), v_MAC_PDUListUL5))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");
        }
    };
    // @siclog "Step 13" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_6), v_MAC_PDUListUL6));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    // @siclog "Step 14" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_7), v_MAC_PDUListUL7));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 14");
   // @siclog "Step 16" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_8), v_MAC_PDUListUL8));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    // @siclog "Step 17, 19" siclog@
    alt {
       [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_10), v_MAC_PDUListUL10))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 19");
        }
       [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_9), v_MAC_PDUListUL9))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 17");
        }
    }

    // @siclog "Step 21" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_11), v_MAC_PDUListUL11));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 21");
    // @siclog "Step 21A and 23" siclog@
    alt {
        []  DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_11A), v_MAC_PDUListUL11A))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 21A");
            repeat;
        }
        []  DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_12), v_MAC_PDUListUL12))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 23");
        }
    };

   t_Watchdog.stop;
    
  };

  /*
   * @desc      Altstep to ignore any Padding MAC PDU's
   * @param     p_NR_CellId
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  altstep a_NR_MAC_IgnorePaddingPDU(NR_CellId_Type p_NR_CellId,
                                  DRB_Identity p_NR_DRB_Id ) runs on NR_BASE_PTC
  {
    [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(p_NR_CellId, p_NR_DRB_Id, cr_TimingInfo_Any, { cr_NR_UL_MAC_PDU(omit, *, *) }))
      {
        repeat;
      }
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.3
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_3_NR_TestBody2(DRB_Identity p_NR_DRB_Id
                                       //SubFrameTiming_Type p_TimingUL
                                       )runs on NR_BASE_PTC
  {
    //const integer const_SPS_Period :=40; // period in milli seconds
    var NR_MAC_SDU_Type v_EncodedRlcPdu;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var SubFrameTiming_Type v_TimingDL;
    //var SubFrameTiming_Type v_TimingUL;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL := { cr_NR_UL_MAC_PDU(*, *, *) };
    timer t_Watchdog := 0.1;
    //@sic R5s230067 R5s230507 sic@
    // Stop UL Grant configuration
    f_NR_ULGrantConfiguration_Stop(nr_Cell1, cs_TimingInfo_Now, cs_NR_UplinkTimeAlignment_Stop);
    //v_TimingUL := f_SubFrameTiming_AddMilliSeconds(p_TimingUL,const_SPS_Period *p_X);
    v_EncodedRlcPdu := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (9, crs_NR_PDCP_SDU_12B7, 1)));//@sic R5-227518 sic@
    v_SDU_SubPDUListDL := {cs_NR_MAC_SDU_SubPDU_LI8(tsc_LCID_SCG_Bearer, v_EncodedRlcPdu)};
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
    v_TimingDL := f_NR_GetNextSendOccasion_DL(nr_Cell1);
    //@sic R5s230507 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR( v_TimingDL), v_MAC_PDUListDL));

    t_Watchdog.start;
    alt {
        [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_Any, v_MAC_PDUListUL))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 27");
            t_Watchdog.stop;
        }
       [] t_Watchdog.timeout
       {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 27");
       }
    }
    // Get back PDU from UE
    f_NR_ULGrantConfiguration_Start(nr_Cell1);
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_Any, v_MAC_PDUListUL))


  };

  /*
   * @desc      Returns next subframe to be available according to DRX parameters on 7.1.1.5.x tests
   *            needed when a test case sends an invalid MAC PDU
   * @param     p_NR_CellId
   * @param     p_T1
   * @return    integer
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_SubFrameTiming_NumSlots(NR_CellId_Type p_NR_CellId,
                                            SubFrameTiming_Type p_T1) runs on NR_BASE_PTC return integer
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var integer v_SlotsT1:= 0;
    //var integer v_MaxValue := 10240 * v_SlotsPerSubframe;   // SFN is 0..1023 in steps of 10ms;
    var SlotOffset_Type v_SlotOffset;
    
    if (ischosen(p_T1.Slot.SlotOffset)) {
      v_SlotOffset := p_T1.Slot.SlotOffset;
      select union (v_SlotOffset) {
        case (Numerology1) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology1;
        }
        case (Numerology2) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology2;
        }
        case (Numerology3) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology3;
        }
        case (Numerology4) {
            v_SlotsT1 := p_T1.Slot.SlotOffset.Numerology4;
        }
      }
    } //else v_SlotsT1=0 and v_SlotsT2=0
    v_SlotsT1 := (p_T1.SFN.Number * 10 * v_SlotsPerSubframe) + p_T1.Subframe.Number * v_SlotsPerSubframe + v_SlotsT1;
   

    return v_SlotsT1;
  }

  /*
   * @desc      The function calculates the DL slot for PDCCH transmission (4 slots ahead) for planned UL Data. The function assumes that both UL Grant and UL PDSCH are in same SFN/HSFN.
   * @param     p_NR_CellId
   * @param     p_T1
   * @return    SubFrameTiming_Type
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_PDCCHSendOccasion_UL(NR_CellId_Type p_NR_CellId,
                                            SubFrameTiming_Type p_T1) runs on NR_BASE_PTC return SubFrameTiming_Type
  {
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(p_NR_CellId);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var integer v_SlotsT1:= f_NR_SubFrameTiming_NumSlots(p_NR_CellId,p_T1);
    var integer v_SlotsT1_DL :=v_SlotsT1 -4 ;//K2=4
    var SlotOffset_Type v_SlotOffset;
    var SubFrameTiming_Type v_T1_DL :=p_T1 ;
    var integer v_Subframes := v_SlotsT1_DL / v_SlotsPerSubframe;
    //var
    v_T1_DL.Subframe.Number := v_Subframes mod 10;

    if (ischosen(p_T1.Slot.SlotOffset)) {
      v_SlotOffset := p_T1.Slot.SlotOffset;
      select union (v_SlotOffset) {
        case (Numerology1) {
            v_T1_DL.Slot.SlotOffset.Numerology1 := v_SlotsT1_DL mod 2;
           }
        case (Numerology2) {
            v_T1_DL.Slot.SlotOffset.Numerology1 := v_SlotsT1_DL mod 4;
        }
        case (Numerology3) {
            v_T1_DL.Slot.SlotOffset.Numerology1 := v_SlotsT1_DL mod 8;
        }
        case (Numerology4) {
            v_T1_DL.Slot.SlotOffset.Numerology1 := v_SlotsT1_DL mod 16;
        }
      }
    }
    return v_T1_DL;
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.2
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_2_NR_TestBody1(DRB_Identity p_NR_DRB_Id
                                       ) runs on NR_BASE_PTC
  {
    //@sic R5s230287 sic@
    const integer const_Cfg_Period :=40; // period in milli seconds
    const integer const_Cfg_TOffset := 9; // In slots
    var SubFrameTiming_Type v_TimingDL; //@sic R5s230287 sic@
    var NR_MAC_SDU_Type v_EncodedRlcPdu1;
    var NR_MAC_SDU_Type v_EncodedRlcPdu2;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL ;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var template (present) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListUL;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL1;
    
    var SubFrameTiming_Type v_TimingUL_1;
    var SubFrameTiming_Type v_TimingUL_2;
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);
    var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);
    var UInt_Type v_SlotsPerCfg_Period := const_Cfg_Period *v_SlotsPerSubframe;
    var integer v_SlotsT1;
    //@sic R5s250158 sic@
    var B6_Type v_LCID := int2bit(p_NR_DRB_Id+3, 6);
    timer t_Watchdog := 11.0;
    
    // @siclog "Step 3" siclog@
    //@sic R5s240269 sic@
    v_EncodedRlcPdu1 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU(0, crs_NR_PDCP_SDU_96B,1))); //@sic R5s240432 sic@
    v_EncodedRlcPdu2 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU(1, crs_NR_PDCP_SDU_96B1,1)));
    
    v_SDU_SubPDUListDL := {
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu1),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu2)};
    
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL,cs_NR_MAC_Padding_SubPDU(tsc_NR_MAC_Padding_2B)) };
      
    v_TimingDL:= f_NR_GetCurrentTiming(nr_Cell1);
    v_TimingDL.SFN.Number := 1022;
    v_TimingDL.Subframe.Number := 2;
    v_TimingDL.Slot.SlotOffset.Numerology1 := 0;
    v_TimingDL.Symbol := valueof (cs_SymbolTimingInfo_FirstSlot);
    //@sic R5s230287 r5s240432 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR(v_TimingDL), v_MAC_PDUListDL));

    
    t_Watchdog.start;
    // @siclog "Step 4" siclog@
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu1)};
    v_MAC_PDUListUL1 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    DRB.receive (car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, -, v_MAC_PDUListUL1))-> value v_NR_DRB_COMMON_IND;
    v_TimingUL_1 := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame;
    v_SlotsT1 := f_NR_SubFrameTiming_NumSlots(nr_Cell1, v_TimingUL_1);
    if (v_SlotsT1 mod v_SlotsPerCfg_Period == const_Cfg_TOffset)
    {f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");    }
    else {f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4"); }
    v_TimingUL_2 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_1,const_Cfg_Period); //Step 5 Timing
    // @siclog "Step 5" siclog@
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu2)};
    v_MAC_PDUListUL1 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    DRB.receive (car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_2), v_MAC_PDUListUL1));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    t_Watchdog.stop;
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.2
   * @param     p_NR_DRB_Id
   * @param     p_NR_ResourceAllocation_CSRNTI
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_2_NR_TestBody2(DRB_Identity p_NR_DRB_Id,
                                       NR_ResourceAllocation_Type p_NR_ResourceAllocation_CSRNTI
                                       ) runs on NR_BASE_PTC
  {//@sic R5s230287 sic@
    const integer const_Cfg_Period :=40; // period in milli seconds
    //@sic R5-236417 sic@
/*    const integer const_Cfg_TOffset := 19; // In slots*/
    const integer const_UL_TBS_CRNTI := 848;// to allow 2 PDCP SDU's
    var SubFrameTiming_Type v_TimingDL;
    var SubFrameTiming_Type v_TimingDL_Step11;
    var SubFrameTiming_Type v_TimingDL1;
    var SubFrameTiming_Type v_TimingUL_1;
    var SubFrameTiming_Type v_TimingUL_2;
    var SubFrameTiming_Type v_TimingUL_3;
    var SubFrameTiming_Type v_TimingUL_4;
    var SubFrameTiming_Type v_TimingUL_5;
    var SubFrameTiming_Type v_TimingUL_6;
    
    var NR_DRB_COMMON_IND v_NR_DRB_COMMON_IND;
    var SubcarrierSpacing v_SCS := f_NR_CellInfo_GetSCS(nr_Cell1);
    var NR_UplinkBWP_Type v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(nr_Cell1, tsc_NR_BWP_Id);
    /*var UInt_Type v_SlotsPerSubframe := f_NR_CellInfo_GetSCS_SlotsNumberPerSubframe(v_SCS);*/
    //var UInt_Type v_SlotsPerCfg_Period := const_Cfg_Period *v_SlotsPerSubframe;
    //var integer v_SlotsT1;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL ;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var template (present) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListUL;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL1;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL2;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL3;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL4;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL5;
    
    //var NR_MAC_SDU_Type v_EncodedRlcPdu1;
    //var NR_MAC_SDU_Type v_EncodedRlcPdu2;
    var NR_MAC_SDU_Type v_EncodedRlcPdu3;
    var NR_MAC_SDU_Type v_EncodedRlcPdu4;
    var NR_MAC_SDU_Type v_EncodedRlcPdu5;
    var NR_MAC_SDU_Type v_EncodedRlcPdu6;
    var NR_MAC_SDU_Type v_EncodedRlcPdu7;
    var NR_ResourceAllocation_Type v_NR_ResourceAllocation_CRNTI := f_NR_ResourceAllocation_UplinkGrant(const_UL_TBS_CRNTI, v_NR_UplinkBWP);
    var NR_ResourceAllocation_Type v_NR_ResourceAllocation_CSRNTI := p_NR_ResourceAllocation_CSRNTI;
    //@sic R5s250158 sic@
    var B6_Type v_LCID := int2bit(p_NR_DRB_Id+3, 6);
    timer t_Watchdog := 11.0;
  // Initialise v_SubFrameInfo, v_SlotTimingInfo for UL grant on PDCCH K2 =4 slots ahead;

    
    // @siclog "Step 7A" siclog@
    // PDCP SDU =12B +3B PDCP Header+ 1B RLC UM Header + 2B MAC Header =18 byte =144 bits
    // 6 MAC Sub PDU's 6*144 = 864. 888 is next allowed downlink TBS in all tables, 24 bit =3 byte padding in DL.
    //@sic R5-227518 sic@
    v_EncodedRlcPdu3 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (2, crs_NR_PDCP_SDU_96B2,1)));
    v_EncodedRlcPdu4 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (3, crs_NR_PDCP_SDU_96B3,1)));
    v_EncodedRlcPdu5 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (4, crs_NR_PDCP_SDU_96B4,1)));
    v_EncodedRlcPdu6 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (5, crs_NR_PDCP_SDU_96B5,1)));
    v_EncodedRlcPdu7 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (6, crs_NR_PDCP_SDU_96B6,1)));
    
    v_SDU_SubPDUListDL := {
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu3),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu4),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu5),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu6),
        cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu7)};
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL,cs_NR_MAC_Padding_SubPDU(tsc_NR_MAC_Padding_2B)) };
    //Prepare expected UL MAC PDU's
    //Step 9
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu3)};
    v_MAC_PDUListUL1 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    //Step 10 & 12
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu4)};
    v_MAC_PDUListUL2 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    //Step 13
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu5)};
    v_MAC_PDUListUL3 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    //Step 15
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu6)};
    v_MAC_PDUListUL4 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };
    //Step 16
    v_SDU_SubPDUListUL := {cr_NR_MAC_SDU_SubPDU(cr_NR_MAC_SubHeaderWithLI(v_LCID, int2bit(100, 8)),  v_EncodedRlcPdu7)};
    v_MAC_PDUListUL5 := { cr_NR_UL_MAC_PDU(v_SDU_SubPDUListUL, *, *) };


    v_TimingDL:= f_NR_GetCurrentTiming(nr_Cell1);
    v_TimingDL.SFN.Number := 1022;
    v_TimingDL.Subframe.Number := 2;
    v_TimingDL.Slot.SlotOffset.Numerology1 := 0;
    v_TimingDL.Symbol := valueof (cs_SymbolTimingInfo_FirstSlot);

    v_TimingUL_1.HSFN.Number := v_TimingDL.HSFN.Number + 1;
    if (v_SCS == kHz15) {
    v_TimingUL_1.SFN.Number := 1; } // timedomainoffset set to 19 for FDD
    else {v_TimingUL_1.SFN.Number := 0;}
    v_TimingUL_1.Subframe.Number := 9;
    if (v_SCS == kHz15) {
    v_TimingUL_1.Slot.SlotOffset.Numerology0 := true; }
    else {v_TimingUL_1.Slot.SlotOffset.Numerology1 := 1;}
    v_TimingUL_1.Symbol := valueof(cs_SymbolTimingInfo_Any);
    v_TimingUL_2 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_1,const_Cfg_Period); //Step 10 Timing
    v_TimingUL_3 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_2,const_Cfg_Period-10); //Step 12 Timing
    v_TimingDL_Step11 := f_NR_PDCCHSendOccasion_UL(nr_Cell1, v_TimingUL_3 );//Step 11 Timing
    v_TimingDL_Step11.Symbol := valueof(cs_SymbolTimingInfo_FirstSlot);
    v_TimingUL_4 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_2,const_Cfg_Period); //Step 13 Timing
    v_TimingUL_5 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_4,const_Cfg_Period); //Step 15 Timing
    v_TimingDL1 := f_NR_PDCCHSendOccasion_UL(nr_Cell1, v_TimingUL_5 );//Step 14 Timing
    v_TimingDL1.Symbol := valueof (cs_SymbolTimingInfo_FirstSlot);
    v_TimingUL_6 :=f_SubFrameTiming_AddMilliSeconds(v_TimingUL_5,const_Cfg_Period); //Step 16 Timing

    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR(v_TimingDL), v_MAC_PDUListDL));
    // @siclog "Step 11" siclog@
    f_NR_UL_CgGrantConfiguration(nr_Cell1,cs_TimingInfo_NR( v_TimingDL_Step11), v_NR_ResourceAllocation_CSRNTI, true, -, -, true); //NDI= 1
    

    // @siclog "Step 8 and 9" siclog@
    //@sic R5s240432 sic@
    t_Watchdog.start;
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_NR( v_TimingUL_1), v_MAC_PDUListUL1))-> value v_NR_DRB_COMMON_IND;
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    /* v_TimingUL_1 := v_NR_DRB_COMMON_IND.Common.TimingInfo.SubFrame;
    v_SlotsT1 := f_NR_SubFrameTiming_NumSlots(nr_Cell1, v_TimingUL_1);
    if (v_SlotsT1 mod v_SlotsPerCfg_Period == const_Cfg_TOffset)
    {f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");    }
    else {f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8"); }
    */

    // @siclog "Step 10" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id,cr_TimingInfo_NR( v_TimingUL_2), v_MAC_PDUListUL2));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    
    //@siclog "Step 12" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id,cr_TimingInfo_NR( v_TimingUL_3), v_MAC_PDUListUL2));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 12");


    // @siclog "Step 13" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id,cr_TimingInfo_NR( v_TimingUL_4), v_MAC_PDUListUL3));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    // @siclog "Step 14" siclog@
    f_NR_OneULGrantTransmission(nr_Cell1, cs_TimingInfo_NR(v_TimingDL1), v_NR_ResourceAllocation_CRNTI);

    // @siclog "Step 15" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id,cr_TimingInfo_NR( v_TimingUL_5), v_MAC_PDUListUL4));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 15");

    // @siclog "Step 16" siclog@
    DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id,cr_TimingInfo_NR( v_TimingUL_6), v_MAC_PDUListUL5));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    t_Watchdog.stop
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.2 steps 19-20
   * @param     p_NR_DRB_Id
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_TC_7_1_1_6_2_NR_TestBody3(DRB_Identity p_NR_DRB_Id) runs on NR_BASE_PTC
  {
   var NR_MAC_SDU_Type v_EncodedRlcPdu8;
    var template (value) NR_MAC_SDU_SubPDU_List_Type v_SDU_SubPDUListDL;
    var template (value) NR_MAC_PDUList_Type v_MAC_PDUListDL;
    var SubFrameTiming_Type v_TimingDL;
    var template (present) NR_MAC_PDUList_Type v_MAC_PDUListUL := { cr_NR_UL_MAC_PDU(*, *, *) };
    //@sic R5s250158 sic@
    var B6_Type v_LCID := int2bit(p_NR_DRB_Id+3, 6);
    timer t_Watchdog := 0.2;
    v_EncodedRlcPdu8 := f_NR_RLC_UMD_FullPDU_Encvalue(f_NR_PDCP_PDU_Encvalue(f_NR_ReturnDefaultPDCP_PDU (7, crs_NR_PDCP_SDU_96B7,1)));
    v_SDU_SubPDUListDL := {cs_NR_MAC_SDU_SubPDU_LI8(v_LCID, v_EncodedRlcPdu8)};
    v_MAC_PDUListDL := { cs_NR_DL_MAC_PDU_SDU_SubPDU_Padding(v_SDU_SubPDUListDL) };
      
    v_TimingDL := f_NR_GetNextSendOccasion_DL(nr_Cell1);
    //@sic R5s250158 sic@
    DRB.send(cas_NR_DRB_COMMON_REQ_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cs_TimingInfo_NR(v_TimingDL), v_MAC_PDUListDL));

    t_Watchdog.start;
    alt {
        [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_Any, v_MAC_PDUListUL))
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 20");
            t_Watchdog.stop;
        }
       []t_Watchdog.timeout
       {
           f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 20");
       }
    }
    f_NR_ULGrantConfiguration_Start(nr_Cell1); // Def UL Grant Config
    t_Watchdog.start;
    alt {
        [] DRB.receive(car_NR_DRB_COMMON_IND_MAC_PDUList(nr_Cell1, p_NR_DRB_Id, cr_TimingInfo_Any, v_MAC_PDUListUL))
        {
            t_Watchdog.stop;
        }
       []t_Watchdog.timeout {}
    }


  };

}
