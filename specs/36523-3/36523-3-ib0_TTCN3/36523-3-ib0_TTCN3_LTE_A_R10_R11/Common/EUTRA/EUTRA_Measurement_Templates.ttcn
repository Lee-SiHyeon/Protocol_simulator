  template (value) ReportConfigEUTRA_Trigger_Type cs_ReportConfigEUTRA_Trigger_Event(template (value) ReportConfigEUTRA_Trigger_EventId_Type p_EventId,
                                                                                     integer p_Hysteresis,
                                                                                     TimeToTrigger p_TimeToTrigger) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
