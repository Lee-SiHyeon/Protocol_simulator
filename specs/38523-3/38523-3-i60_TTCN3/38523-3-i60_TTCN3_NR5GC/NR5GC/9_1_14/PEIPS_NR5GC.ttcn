module PEIPS_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from NAS_CommonTemplates all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NG_NAS_TypeDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from NR_Timing all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 9.1.14.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_9_1_14_1_NR5GC() runs on NR5GC_PTC
  { //Paging Early Indication with Paging Subgrouping Assistance / Registration / provision and deletion of PEIPS assistance information
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_AllCellsOnSamePLMN);
    var NR_CellId_Type v_NGC_NASCellD := f_NR5GC_MapNASCell(ngc_CellD, NG_AllCellsOnSamePLMN);
    f_NR5GC_Init_NAS(NR_2);

    f_NR_CellInfo_SetSIB1_PEI(v_NGC_NASCellA, cs_SubgroupConfig_r17(2,omit));
    f_NR_CellInfo_SetSIB1_PEI(v_NGC_NASCellD);

    //Create and configure cell
    f_NR_CellConfig_Def(v_NGC_NASCellA);
    f_NR_CellConfig_Def(v_NGC_NASCellD);
    f_NR5GC_Preamble(v_NGC_NASCellA, STATE_IDLE_1A, PING_Or_TEST_LOOPModeB_ON);
    f_NR_TestBody_Set(true);

    fl_TC_9_1_14_1_TestBody();

    f_NR_TestBody_Set(false);

    //Finish
    f_NR_Postamble(v_NGC_NASCellA, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_9_1_14_1
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_9_1_14_1_TestBody() runs on NR5GC_PTC
  {
    var NR_CellId_Type v_NGC_NASCellA := f_NR5GC_MapNASCell(ngc_CellA, NG_CellsOnDifferentPLMN);
    var NR_CellId_Type v_NGC_NASCellD := f_NR5GC_MapNASCell(ngc_CellD, NG_AllCellsOnSamePLMN);
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var GMM_MobilityInfo_Type v_GMM_MobilityInfo;
    var template (value) NG_NAS_DL_Message_Type v_MsgToSend;
    var NG_NAS_GutiParameters_Type v_GutiParams := f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellD);
    var template (value) NG_MobileIdentity v_GUTIToSend := f_NG_GutiParameters2MobileIdentity (f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellD)), v_GutiParams);
    var TrackingAreaCode v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellD);
    var template (value) NG_TrackingAreaIdList v_TAIList := cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellD)), {bit2oct(v_TAC)});
    var NR_RadioBearerId_Type v_SRB := tsc_NR_RbId_SRB1;

    //@siclog "Step 1" siclog@
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellD, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 2-7a1" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellD, tsc_NR_RRC_TI_Def, ?);

    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_NRPSSI)) {  //@sic R5-240155 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_PEIPS_AssistInfo('33'O, '01'O,{{'000'B,'00000'B}}));
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellD, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_Registration_Complete(v_NGC_NASCellD);
    f_NR_RRCRelease(v_NGC_NASCellD);

    //@siclog "Step 8" siclog@
    //The SS transmits a PEI with the bit corresponding for the subgroup the UE belongs to is indicated as 1 and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(v_NGC_NASCellD, -,'11'B, 22 );

    //@siclog "Step 9" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(v_NGC_NASCellD, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");

    //@siclog "Step 10" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (v_NGC_NASCellD);

    //@siclog "Step 11" siclog@
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(v_NGC_NASCellD,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellD)),'0010'B)) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }

    //@siclog "Step 12-15" siclog@
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(v_NGC_NASCellD, v_ReceivedMsg);

    //@siclog "Step 16" siclog@
    f_NR_RRCRelease(v_NGC_NASCellD);

    //@siclog "Step 17" siclog@
    f_NR_SetCellPower (v_NGC_NASCellD, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);
    f_NR_SetCellPower (v_NGC_NASCellA, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);

    //@siclog "Step 18-23a1" siclog@
    v_TAC := f_NR_CellInfo_GetTAC (v_NGC_NASCellA);  //@sic R5s250296 sic@
    v_TAIList := cs_NG_TAIListNonConsecutive(f_NR_Asn2Nas_PlmnId(f_NR_CellInfo_GetPLMN (v_NGC_NASCellA)), {bit2oct(v_TAC)});  //@sic R5s250296 sic@

    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Mobility, -, -, -, -, cdr_NG_GMM_Cap_NRPSSI)) {    //@sic R5-240155 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }

    v_MsgToSend := f_Get_NG_RegistrationAcceptMsg (Mobility,
                                                   v_GMM_MobilityInfo,
                                                   v_GUTIToSend,
                                                   v_TAIList,
                                                   -, -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_GPRS_Timer2_3_IEI('5E'O, '101'B, '00001'B), -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, -, -, -, -,
                                                   -, -, -, -, -, -, cs_PEIPS_AssistInfo('33'O, '01'O,{{'000'B,'00001'B}}));
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, v_SRB, -, cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered, v_MsgToSend)));

    f_NR5GC_Registration_Complete(v_NGC_NASCellA);
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 24" siclog@
    //The SS transmits a PEI with the bit corresponding for the subgroup the UE belongs to is indicated as 1 and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(v_NGC_NASCellA, -,'11'B, 22 );

    //@siclog "Step 25" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(v_NGC_NASCellA, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 25");

    //@siclog "Step 26" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (v_NGC_NASCellA);

    //@siclog "Step 27" siclog@
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(v_NGC_NASCellA,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA)),'0010'B)) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }

    //@siclog "Step 28-28C" siclog@
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(v_NGC_NASCellA, v_ReceivedMsg);

    //@siclog "Step 29" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 29A" siclog@
    f_Delay(f_NR_SetTimerToleranceMin(v_NGC_NASCellA, nasTimer, 60.0));  //@sic R5s250296 sic@

    //@siclog "Step 30-35a1" siclog@
    v_ReceivedMsg := f_NR_RRC_ConnEst_DefWithNas (v_NGC_NASCellA, tsc_NR_RRC_TI_Def, ?);
    if (not f_Check_NG_RegistrationReqMsg (v_GMM_MobilityInfo, v_ReceivedMsg.Pdu, Periodic)) {    //@sic R5-240155 R5-254151 sic@
      f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Registration Request Message Failed");
    }
    f_NR5GC_MobilityRegistration_Steps4_6(v_NGC_NASCellA, v_GMM_MobilityInfo);

    //@siclog "Step 36" siclog@
    //The SS transmits a PEI with the bit corresponding for the subgroup the UE belongs to is indicated as 1 and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(v_NGC_NASCellA, -,'11'B, 22 );

    //@siclog "Step 37" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(v_NGC_NASCellA, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 37");

    //@siclog "Step 38" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (v_NGC_NASCellA);

    //@siclog "Step 39" siclog@
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(v_NGC_NASCellA,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA)),'0010'B)) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }

    //@siclog "Step 40-40C" siclog@
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(v_NGC_NASCellA, v_ReceivedMsg);

    //@siclog "Step 41" siclog@
    //The SS transmits a CONFIGURATION UPDATE COMMAND containing PEIPS assistance information
    v_SRB := tsc_NR_RbId_SRB2;  //@sic R5s250296 sic@
    SRB.send(cas_NR_SRB_NasPdu_REQ(v_NGC_NASCellA, v_SRB, -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_NG_CONFIGURATION_UPDATE_COMMAND(cs_ConfigUpdateInd('0'B, '1'B), -, -, -, -, -, -, -, -, -,
                                                                       -, -, -, -, -, -, -, -, -, -,
                                                                       -, -, -, -, -, -, -, -, -, -, -, cs_PEIPS_AssistInfo('1F'O, '01'O,{{'000'B,'00000'B}})))));

    //@siclog "Step 42" siclog@
    SRB.receive (car_NR_SRB_NasPdu_IND(v_NGC_NASCellA, v_SRB, cr_NG_NAS_Ind(tsc_SHT_IntegrityProtected_Ciphered,
                                                                      cr_NG_CONFIGURATION_UPDATE_COMPLETE)));

    //@siclog "Step 43" siclog@
    f_NR_RRCRelease(v_NGC_NASCellA);

    //@siclog "Step 44" siclog@
    //The SS transmits a PEI with the bit corresponding for the subgroup the UE belongs to is indicated as 1 and the Paging message including a matched identity on the associated PO only.
    f_NR_Paging_Trigger_DCI_2_7(v_NGC_NASCellA, -,'11'B, 22 );

    //@siclog "Step 45" siclog@
    //Check: Does the UE transmit an RRCSetupRequest message?
    f_NR_RRC_SetupRequest_Def(v_NGC_NASCellA, mt_Access);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 45");

    //@siclog "Step 46" siclog@
    //The SS transmits an RRCSetup message.
    f_NR_RRCSetup_Def (v_NGC_NASCellA);

    //@siclog "Step 47" siclog@
    v_ReceivedMsg := f_NR_RRCSetupComplete_Def(v_NGC_NASCellA,
                                          cr_38508_RRCSetupComplete(tsc_NR_RRC_TI_Def),
                                          tsc_SHT_IntegrityProtected);
    if (not f_Check_NG_ServiceReqMsg (v_ReceivedMsg.Pdu, cs_NAS_KeySetIdentifier_lv(f_NR_SecurityKSIamf_Get (), tsc_NasKsi_NativeSecurityContext), f_NG_S_TMSI2MobileIdentity(omit, f_NR5GC_CellInfo_GetGutiParameters (v_NGC_NASCellA)),'0010'B)) {
         f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Service Request Message Failed");
    }

    //@siclog "Step 48-51" siclog@
    f_NR5GC_RRC_ConnectedState3N_Steps5_8(v_NGC_NASCellA, v_ReceivedMsg);
    }//End of fl_TC_9_1_14_1_Body

}
