module NR_CommonFunctions_CA {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_ConfigurationSteps all;
  import from NR_DCI_Configuration all;
  import from NR_Parameters all;
  import from NR_RRC_BWP_Templates all;
  import from NR_RRC_Templates all;
  import from TestcaseProperties all;

 template (value) SCellConfig cs_SCellConfig_Def(template (omit) ServingCellConfigCommon p_ServingCellConfigCommon,
                                                template (value) ServingCellConfig p_ServingCellConfig,
                                                SCellIndex p_SCellIndex,
                                                template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                                ) :=
 {  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-224929: added p_SCellActivate sic@
    sCellIndex              := p_SCellIndex,
    sCellConfigCommon       := p_ServingCellConfigCommon,
    sCellConfigDedicated    := p_ServingCellConfig,
    smtc                    := omit,
    sCellState_r16          := p_SCellState,   /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    secondaryDRX_GroupConfig_r16     := omit,  /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
    preConfGapStatus_r17             := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    goodServingCellEvaluationBFD_r17 := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    sCellSIB20_r17                   := omit,  /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    plmn_IdentityInfoList_r17        := omit,  /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
    npn_IdentityInfoList_r17         := omit   /* @sic R5s230533 BASELINE UPGRADE 2023 sic@ */
 };

  template (value) NR_SpCellConfig_Type cs_NR_SS_SpCellConfigCA (template (omit) CellGroupId          p_CellGroupId,
                                                                 template (omit) NR_CellIdList_Type   p_SCellList,
                                                                 NR_ServingCellIndex_Type             p_ServingCellIndex,
                                                                 template (omit) NR_ASN1_PhysicalCellGroupConfig_Type p_NR_PhysicalCellGroupConfig := omit,
                                                                 template (omit) NR_CellId_Type       p_ReferenceCell := omit,
                                                                 template (omit) NR_MC_DCI_SetOfCells_Type  p_NR_MC_DCI_SetOfCells := omit
                                                                 ) :=
  { //@sic R5s200575: added p_ServingCellIndex sic@
     /* @status    APPROVED (ENDC, NR5GC) */
    ServingCellIndex := p_ServingCellIndex,
    CellGroupConfig := {
      CellGroupId := p_CellGroupId,
      SCellList   := p_SCellList,
      MAC_CellGroupConfig := omit,
      PhysicalCellGroupConfig := p_NR_PhysicalCellGroupConfig,
      ReferenceCell := p_ReferenceCell  //@sic R5w240308 sic@
    },
    MC_DCI_SetOfCells := p_NR_MC_DCI_SetOfCells //@sic R5w240308 sic@
  };

  template (value) NR_ServingCellConfig_Type cs_NR_ServingCellConfig_SCell( template (value) NR_ServingCellIndex_Type p_NR_ServingCellIndex,
                                                                            template (omit) TAG_Id p_TAG_Id,
                                                                            template (omit) NR_MC_DCI_SetOfCells_Type p_NR_MC_DCI_SetOfCells := omit
                                                                          ) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SCell := {
        ServingCellIndex := p_NR_ServingCellIndex,
        TAG_Id   := p_TAG_Id,
        MC_DCI_SetOfCell := p_NR_MC_DCI_SetOfCells // @sic R5w240308 sic@
    }
  };

  template (value) NR_MAC_ControlElementDL_Type cs_NR_MAC_SCellActDeact_CE( B8_Type    p_SCellIndex7_1) :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    SCellActDeact :={
        SCellIndex7_1 := p_SCellIndex7_1,
        SCellIndex15_8 := omit,
        SCellIndex23_16 := omit,
        SCellIndex31_24 := omit
    }
  };

  /*
   * @desc      Function to configure a cell suitable to be upgraded as PCell
   * @param     p_PCellId
   * @param     p_NRDC_SCG_Cell     (default value: false)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_CellConfig_PCell_Def(NR_CellId_Type p_PCellId,
                                     boolean p_NRDC_SCG_Cell := false) runs on NR_BASE_PTC
  { //@sic R5s210841: added p_NRDC_SCG_Cell sic@
    f_NR_CellConfig_Def(p_PCellId, SpCell, p_NRDC_SCG_Cell);
  }

  /*
   * @desc      Function to configure a cell suitable to be upgraded as SCell
   * @param     p_SCellId
   * @param     p_CA_CellCapability (default value: Scell_Active)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_CellConfig_SCell(NR_CellId_Type p_SCellId,
                                 template (value) NR_CellCA_Capability_Type p_CA_CellCapability := Scell_Active) runs on NR_BASE_PTC
  {
    var template (value) NR_RadioBearerList_Type v_SrbList := {cs_NR_SS_SRB0_Config};

    f_NR_CellConfig_Def(p_SCellId, p_CA_CellCapability);
    if (not f_GetTestcaseAttrib_ENDC(testcasename()) and f_NR_IsUL_FrequencyAvailable(p_SCellId)) {  //@sic R5-226041 sic@
        f_NR_SS_CommonRadioBearerConfig(p_SCellId, v_SrbList);
    }
  }

  /*
   * @desc      Get Default SCGConfig to send in RRC Reconfiguration message
   *            Acc to 38.508-1 Table 4.6.3-19: CellGroupConfig with with condition SCell_add
   * @param     p_SCellId
   * @param     p_SCellIndex
   * @param     p_UL_CA             (default value: false)
   * @param     p_SCellDeactivationTimer (default value: omit)
   * @param     p_RLC_Bearer_Config (default value: omit)
   * @param     p_UL_CA_ConfigPUCCH (default value: true)
   * @param     p_SCellState        (default value: omit)
   * @return    template (value) CellGroupConfig
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_GetSCGConfig_SCellAdd(NR_CellId_Type p_SCellId,
                                      SCellIndex p_SCellIndex,
                                      boolean p_UL_CA := false,
                                      template (omit) ServingCellConfig.sCellDeactivationTimer p_SCellDeactivationTimer := omit,
                                      template (omit) NR_RLC_BearerToAddModList_Type p_RLC_Bearer_Config := omit,
                                      boolean p_UL_CA_ConfigPUCCH := true,
                                      template (omit) SCellConfig.sCellState_r16 p_SCellState := omit
                                     ) runs on NR_BASE_PTC return template (value) CellGroupConfig
  { //@sic R5-214764 : added p_UL_CA_ConfigPUCCH R5-224929: added p_SCellState sic@
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) NR_SCellToAddModList_Type v_SCellConfig;
    var template (value) ServingCellConfigCommon v_ServingCellConfigCommon := f_NR_GetServingCellConfigCommon_CA(p_SCellId, p_UL_CA);
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_SCellId); //@sic R5s201387 sic@
    var template (value) BWP_DownlinkDedicated v_BWP_DownlinkDedicated;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_SCellId, tsc_NR_BWP_Id);
    var SearchSpace v_SearchSpaceUSS := f_NR_CellInfo_GetSearchSpaceConfigAtUE(p_SCellId, tsc_NR_SearchSpaceId_USS, tsc_NR_BWP_Id);
    var template (value) ServingCellConfig v_ServingCellConfig;
    var NR_UplinkBWP_Type v_NR_UplinkBWP;
    var template (omit) UplinkConfig v_UplinkConfig := omit;
    var template (omit) PDCCH_Config.controlResourceSetToAddModList v_ControlResourceSetToAddModList := f_NR_GetPDCCH_ConfigControlResourceSet(p_SCellId); //@sic R5-202561 sic@

    if (p_UL_CA) {
        v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_SCellId, tsc_NR_BWP_Id);
        if (pc_UL_NR_CA_2CC and not(p_UL_CA_ConfigPUCCH)) { //@sic R5-214764 sic@
            v_NR_UplinkBWP.Dedicated.R15.pucch_Config := omit;
            v_ServingCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.pucch_ConfigCommon := omit; //@sic R5-220287 R5s220818 sic@
        }
        v_UplinkConfig := cs_38508_UplinkConfig(v_NR_UplinkBWP.Dedicated.R15, cs_38508_PUSCH_ServingCellConfig);
    }
    //ServingCellConfig initialisation
    v_BWP_DownlinkDedicated := cs_38508_BWP_DownlinkDedicated(cs_38508_PDCCH_Config (v_SearchSpaceUSS, -, v_ControlResourceSetToAddModList),
                                                              v_NR_DownlinkBWP.Pdsch.ConfigDedicated.R15,
                                                              -,
                                                              omit);  //@sic R5-221421 R5s220213 sic@
    v_ServingCellConfig :=  cs_NR_ServingCellConfigDef(v_BWP_DownlinkDedicated,
                                                       tsc_NR_BWP_Id,
                                                       tsc_NR_BWP_Id,
                                                       v_UplinkConfig,                 //UplinkConfig
                                                       cs_NR_Pdcch_ServingCellConfigSetup(cs_38508_PDCCH_ServingCellConfig),
                                                       cs_NR_Pdsch_ServingCellConfigSetup(cs_38508_PDSCH_ServingCellConfig),
                                                       -,-,
                                                       p_SCellDeactivationTimer
                                                       );

    v_SCellConfig := {cs_SCellConfig_Def(v_ServingCellConfigCommon, v_ServingCellConfig, p_SCellIndex, p_SCellState)};  //@sic R5-224929 sic@
    v_SCGConfig := cs_38508_CellGroupConfig(v_CellGroupId,
                                            p_RLC_Bearer_Config,  //@sic R5-206348 sic@
                                            omit,  //RLC_BearerToRelease
                                            omit,  //MAC_CellGroupConfig
                                            omit,  //PhysicalCellGroupConfig
                                            omit,  //SpCellConfig
                                            v_SCellConfig);
    return v_SCGConfig;
  }

  /*
   * @desc      Retrieve ASN.1 type BWP_DownlinkCommon from ASP type NR_DownlinkBWP_Type with the condition SCell_add
   * @param     p_DL_BWP
   * @return    template (value) BWP_DownlinkCommon
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_RetrieveBWP_DownlinkCommonSCell_Add(NR_DownlinkBWP_Type p_DL_BWP)
    return template (value) BWP_DownlinkCommon
  { //@sic R5-201093 R5-202554 sic@
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon;
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := p_DL_BWP;

    v_BWP_DownlinkCommon := cs_38508_BWP_DownlinkCommon(v_NR_DownlinkBWP.BWP.R15,
                                                        cs_38508_PDCCH_ConfigCommon(omit,  //ControlResourceSetZero
                                                                                    v_NR_DownlinkBWP.Pdcch.CoresetArray[1].R15, //commonControlResourceSet
                                                                                    omit,
                                                                                    omit,   // SCell_add   searchSpaceZero
                                                                                    omit),
                                                        v_NR_DownlinkBWP.Pdsch.ConfigCommon.R15);
    return v_BWP_DownlinkCommon;
  }

  /*
   * @desc      Get Default ServingCellConfigCommon according to 38.508-1 Table 4.6.3-168 with the condition SCell_add
   * @param     p_SCellId
   * @param     p_UL_CA             (default value: false)
   * @return    template (value) ServingCellConfigCommon
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_GetServingCellConfigCommon_CA(NR_CellId_Type p_SCellId,
                                               boolean p_UL_CA := false
                                               ) runs on NR_BASE_PTC return template (value) ServingCellConfigCommon
  {
    var template (value) ServingCellConfigCommon v_ServingCellConfigCommon;
    var PhysCellId v_PhysCellId := f_NR_CellInfo_GetPhysicalCellId(p_SCellId);
    var FrequencyInfoDL v_FrequencyInfoDL := f_NR_CellInfo_GetFrequencyInfoDL(p_SCellId);
    var NR_DownlinkBWP_Type v_NR_DownlinkBWP := f_NR_CellInfo_GetDownlinkBWP(p_SCellId, tsc_NR_BWP_Id);
    var template (value) BWP_DownlinkCommon v_BWP_DownlinkCommon:= f_NR_RetrieveBWP_DownlinkCommonSCell_Add(v_NR_DownlinkBWP);
    var ServingCellConfigCommon.ssb_PositionsInBurst v_Ssb_PositionsInBurst := f_NR_CellInfo_GetSSB_BurstConfig(p_SCellId);
    var SubcarrierSpacing v_SubcarrierSpacing := f_NR_CellInfo_GetSCS(p_SCellId);
    var template (omit) TDD_UL_DL_ConfigCommon v_TDD_UL_DL_ConfigCommon := f_NR_CellInfo_GetTDD_UL_DL_ConfigCommon(p_SCellId);
    var NR_UplinkBWP_Type v_NR_UplinkBWP;
    var template (omit) UplinkConfigCommon v_UplinkConfigCommon := omit;
    var FrequencyInfoUL v_FrequencyInfoUL;
    var template (omit) ServingCellConfigCommon.channelAccessMode_r16 v_ChannelAccessMode_r16 := omit;
    var template (omit) SSB_PositionQCL_Relation_r16 v_SSB_PositionQCL_Relation := omit;

    //@sic R5-240531, R5w240005 sic@ - SharedSpectrum condition
    if (f_NR_CellInfo_GetIsSharedSpectrum(p_SCellId)) {
      if (pc_ul_Semi_StaticChAccess_r16) {
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_SemiStatic; // @sic R5-242772 sic@
      }
      else if (pc_ul_DynamicChAccess_r16){
        v_ChannelAccessMode_r16 := cs_38508_ChannelAccessMode_Dynamic;  // @sic R5-242772 sic@
      }
      else {
        FatalError(__FILE__, __LINE__, "neither semiStatic nor dynamic shared spectrum channel access are supported");
      }
      v_SSB_PositionQCL_Relation := n1;  //Table 4.6.3-186A: SSB-PositionQCL-Relation
    }
    if (p_UL_CA){
        v_NR_UplinkBWP := f_NR_CellInfo_GetUplinkBWP(p_SCellId, tsc_NR_BWP_Id);
        v_FrequencyInfoUL := f_NR_CellInfo_GetFrequencyInfoUL(p_SCellId);
        v_UplinkConfigCommon := cs_38508_UplinkConfigCommon(v_FrequencyInfoUL, v_NR_UplinkBWP.Common.R15);
    }
    v_ServingCellConfigCommon := cs_NR_ServingCellConfigCommonDef(v_PhysCellId,
                                                                  cs_38508_DownlinkConfigCommon(v_FrequencyInfoDL,v_BWP_DownlinkCommon),
                                                                  v_UplinkConfigCommon,
                                                                  v_Ssb_PositionsInBurst,
                                                                  ms20,
                                                                  pos2,
                                                                  v_SubcarrierSpacing,
                                                                  v_TDD_UL_DL_ConfigCommon,
                                                                  tsc_NR_PBCH_BlockPower,
                                                                  -,
                                                                  v_ChannelAccessMode_r16,
                                                                  v_SSB_PositionQCL_Relation );
    return v_ServingCellConfigCommon;
  }

   /*
   * @desc      To configue PCell when SCells are to be added - Configure SCell with C-RNTI
   * @param     p_PCellId
   * @param     p_SCellList
   * @param     p_PServingCellIndex
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_RNTI_Value        (default value: tsc_C_RNTI_Value1)
   * @param     p_SS_RadioBearerList (default value: omit)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ConfigPCell_AddRelSCells(NR_CellId_Type                    p_PCellId,
                                         NR_CellIdList_Type                p_SCellList,
                                         NR_ServingCellIndex_Type          p_PServingCellIndex,
                                         template (value) TimingInfo_Type  p_TimingInfo := cs_TimingInfo_Now,
                                         template (omit) RNTI_Value        p_RNTI_Value :=  tsc_C_RNTI_Value1,
                                         template (omit) NR_RadioBearerList_Type p_SS_RadioBearerList := omit,
                                         template (omit) boolean p_CnfFlag := omit,
                                         boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                        ) runs on NR_BASE_PTC
  { //@sic R5-206369: added p_CnfFlag and p_FollowOnFlag sic@
    var CellGroupId v_CellGroupId := f_NR_CellInfo_Get_CellGroupId(p_PCellId); //@sic R5s201387 sic@
    var integer i;
    var template (value) NR_DciFormat_1_X_SpecificInfo_Type v_DciFormatAndParams; //@sic R5-202677, R5-201572 sic@

    var NR_PhysicalParameters_Type v_PhysicalParameters := f_NR_CellInfo_GetPhysicalParameters(p_PCellId);

    if (lengthof(p_SCellList) == 0) { // No SCell - reconfigure DAI as single serving cell
      v_DciFormatAndParams := cs_NR_DciFormat_1_1_Params(v_PhysicalParameters.SubcarrierSpacing);
    } else {
      // SCell added - reconfigure DAI as multiple serving cell - B4 type
      v_DciFormatAndParams := cds_NR_DciFormat_1_1_Params_DAI_MultipleServingCells(v_PhysicalParameters.SubcarrierSpacing)
    }

    // Configure PCell as Pcell
    f_NR_SS_CommonCellConfig(p_PCellId, cads_NR_ServingCellConfig_REQ(p_PCellId, p_TimingInfo,
                                                                      cs_NR_ServingCellConfig_SpCell(cs_NR_SS_SpCellConfigCA( v_CellGroupId, p_SCellList, p_PServingCellIndex)),
                                                                      -, p_CnfFlag, p_FollowOnFlag));
    //Reconfigure DCI to multiple or single serving cell @sic R5-202677, R5-201572 sic@
    f_NR_SS_CommonCellConfig(p_PCellId, cas_NR_DciDlInfo_REQ(p_PCellId, p_TimingInfo, cs_NR_DciDlInfo(-, -, v_DciFormatAndParams)));

    if (isvalue(p_SS_RadioBearerList)){ //compiler warning may be ignored due to check
        f_NR_SS_CommonRadioBearerConfig(p_PCellId, p_SS_RadioBearerList, p_TimingInfo);
    }
    // Save new C-RNTI in cell configuration for p_SCellId
    if (isvalue(p_RNTI_Value) and (lengthof(p_SCellList) >0)) {
        for (i:=0;  i< lengthof(p_SCellList); i:=i+1) {
            f_NR_CellInfo_SetRNTI(p_SCellList[i], valueof(p_RNTI_Value));
            f_NR_SS_C_RNTI_Config(p_SCellList[i], valueof(p_RNTI_Value), p_TimingInfo);
        }
    }
  }

  /*
   * @desc      Further configuration of PCell and SCell
   * @param     p_SCellId
   * @param     p_SCGConfig
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_PUCCH_Cell        (default value: tsc_NR_PCellIndex)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_ConfigSCell(NR_CellId_Type p_SCellId,
                            template (value) CellGroupConfig p_SCGConfig,
                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                            ServCellIndex p_PUCCH_Cell := tsc_NR_PCellIndex
                            ) runs on NR_BASE_PTC
  { //@sic R5-237429: added p_PUCCH_Cell parameter sic@
    var template (omit) TAG_Id v_TAG_Id :=  p_SCGConfig.sCellToAddModList[0].sCellConfigDedicated.tag_Id;

    //other PCell reconfiguration depending on the TC
    // CQI report
    //@sic R5s200462 change 2 sic@

    // Configure SCell as Scell
    f_NR_SS_CommonCellConfig(p_SCellId, cads_NR_ServingCellConfigPUCCH_Cell_REQ(p_SCellId, p_TimingInfo,  //@sic R5s200462 change 2 sic@
                                                                                cs_NR_ServingCellConfig_SCell(valueof(p_SCGConfig.sCellToAddModList[0].sCellIndex), v_TAG_Id),
                                                                                -,
                                                                                p_PUCCH_Cell   //Inform SS about the PUCCH-Cell @sic R5-237429 sic@
                                                                                ));

  }

  /*
   * @desc      Common function to release an SCell
   * @param     p_PCell
   * @param     p_SCell
   * @param     p_PServingCellIndex
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_NR_ServingCellConfig (default value: cs_NR_ServingCellConfig_None)
   * @param     p_CnfFlag           (default value: omit)
   * @param     p_FollowOnFlag      (default value: tsc_NoFollowOnFlag)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_NR_Rel_SCell_Common(NR_CellId_Type p_PCell,
                                 NR_CellId_Type p_SCell,
                                 NR_ServingCellIndex_Type         p_PServingCellIndex,
                                 template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                 template (value) NR_ServingCellConfig_Type p_NR_ServingCellConfig := cs_NR_ServingCellConfig_None,
                                 template (omit) boolean p_CnfFlag := omit,
                                 boolean p_FollowOnFlag := tsc_NoFollowOnFlag
                                 ) runs on NR_BASE_PTC
  { //@sic R5s200575: added p_PServingCellIndex sic@
    //@sic R5-206369: added p_CnfFlag and p_FollowOnFlag sic@
    //Reconfigure PCell as a normal Cell
    f_NR_ConfigPCell_AddRelSCells(p_PCell, {}, p_PServingCellIndex, p_TimingInfo, omit, -, p_CnfFlag, p_FollowOnFlag);

    // Configure SCell as normal cell
    f_NR_SS_CommonCellConfig(p_SCell, cads_NR_ServingCellConfig_REQ(p_SCell, p_TimingInfo, p_NR_ServingCellConfig)); //@sic R5s200462 change 3 sic@

  }

  /*
   * @desc      Common function to reconfigure a SCell to a normal cell
   * @param     p_PCell
   * @param     p_DrbConfigList
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, NR5GC)
   */
   function f_NR_ReconfigSCellToNormalCell(NR_CellId_Type p_PCell,
                                          template (value) NR_RadioBearerList_Type p_DrbConfigList,
                                          template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now
                                          ) runs on NR_BASE_PTC
  {
    var template (value) NR_ServingCellConfig_Type v_ServingCellConfig :=  f_NR_CellInfo_GetServingCellConfig(p_PCell);

    // Reconfigure StaticInfo to CarrierAggregaion == spCell
    // Reconfigure ServingCellInfo to normal cell
    //@sic R5s210389 sic@
    f_NR_SS_CommonCellConfig(p_PCell, cads_NR_ServingCellConfig_REQ(p_PCell, p_TimingInfo,v_ServingCellConfig, cs_NR_StaticCellResourceConfig (SpCell)));

    if (not f_GetTestcaseAttrib_ENDC(testcasename())) {
        //Configure SRBs + DRBs
        f_NR_SS_SRBs_DRBs_Config(p_PCell, p_TimingInfo, p_DrbConfigList); //@sic R5s201249 sic@
    } else {
        //Configure DRBs
        f_NR_SS_CommonRadioBearerConfig(p_PCell, p_DrbConfigList, p_TimingInfo);
    }
  }

  /*
   * @desc      Common function to reconfigure a PSCell to a normal cell
   * @param     p_PCell
   * @param     p_PServingCellIndex
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @param     p_DrbToReleaseList
   * @param     p_ScellBecomingPcell (default value: false)
   * @status    APPROVED (NR5GC)
   */
   function f_NR_ReconfigurePCellToNormalCell( NR_CellId_Type                          p_PCell,
                                               NR_ServingCellIndex_Type                p_PServingCellIndex,
                                               template (value) TimingInfo_Type        p_TimingInfo := cs_TimingInfo_Now,
                                               IntegerList_Type                        p_DrbToReleaseList,
                                               boolean                                 p_ScellBecomingPcell := false
                                             ) runs on NR_BASE_PTC
  {
    var integer k;      //@sic R5s220809 sic@
    var template (value) NR_RadioBearerList_Type v_DrbList := {};       //@sic R5s220809 sic@

    //@sic R5s220816: added p_ScellBecomingPcell sic@
    f_NR_ConfigPCell_AddRelSCells( p_PCell,
                                   {}, //p_SCellList
                                   p_PServingCellIndex,
                                   p_TimingInfo,
                                   omit, // p_RNTI_Value > no need to reconfigure C-RNTI
                                   omit  // p_SS_RadioBearerList > DRB + SRBs to be released just after
                                  );
    //Release DRBs
    if (not p_ScellBecomingPcell) { //@sic R5s220816 sic@
        //Release and re-establish SRBs - if not ENDC
        if (not f_GetTestcaseAttrib_ENDC(testcasename())) {
            f_NR_SS_SRBs_DRBs_Release(p_PCell, p_TimingInfo, p_DrbToReleaseList);  //@sic R5s201249 sic@
            f_NR_SS_SRBs_DRBs_Config(p_PCell, p_TimingInfo, omit);   //@sic R5s201249 sic@
        } else { //@sic R5s220809 sic@
            for (k:=0; k < lengthof(p_DrbToReleaseList); k:= k+1) {
                v_DrbList[k] := cs_NR_SS_DRB_Release(p_DrbToReleaseList[k]);
            }
            f_NR_SS_CommonRadioBearerConfig(p_PCell, v_DrbList, p_TimingInfo);
        }
    }
  }

  /*
   * @desc     SS transmits an Activation MAC control element to activate SCell.
   * @param     p_PCell
   * @param     p_SCellIndex        (default value: tsc_NR_SCellIndex_1)
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, NR5GC)
   */
  function f_SS_CellConfig_ActivateSCell_CA(NR_CellId_Type p_PCell,
                                            SCellIndex p_SCellIndex := tsc_NR_SCellIndex_1,
                                            template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now
                                            ) runs on NR_BASE_PTC
  { //@sic R5-203666 sic@
    var B8_Type v_SCellIndex7_1;

    //The SS transmits an Activation MAC control element to activate SCell.
    select (p_SCellIndex) {
        case (tsc_NR_SCellIndex_1) { v_SCellIndex7_1 := '00000010'B; }
        case (tsc_NR_SCellIndex_2) { v_SCellIndex7_1 := '00000100'B; }
        case else {FatalError (__FILE__, __LINE__, "SCellIndex not handled");}
    }
    f_NR_SS_CommonCellConfig(p_PCell, cas_NR_MacCommandTrigger_REQ(p_PCell, p_TimingInfo, cs_NR_MAC_SCellActDeact_CE(v_SCellIndex7_1)));
  }

}
