        cs_CCE_StartIndex_DL_UL( 4, 20),        // subframe 2
        cs_CCE_StartIndex_DL_UL(26, 10),        // subframe 3
        cs_CCE_StartIndex_DL_UL(14, 30),        // subframe 4
        cs_CCE_StartIndex_DL_UL( 0, 16),        // subframe 5
        cs_CCE_StartIndex_DL_UL( 4, 20),        // subframe 6
