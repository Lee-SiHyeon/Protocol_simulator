  };

  /*
   * @desc      Builds IE GNSS_Almanac for all satellites in the list
   * @param     p_GNSS_AlmanacList
   * @param     p_NoOfElem
   * @return    GNSS_AlmanacList
   * @status    APPROVED (POS)
   */
  function fl_Build_cs_GNSS_AlmanacList(GNSS_AlmanacList p_GNSS_AlmanacList,
                                        integer p_NoOfElem) return GNSS_AlmanacList // @sic R5s140435 sic@
  {
    var GNSS_AlmanacList v_GNSS_AlmanacList;
    var integer v_NoOfAlmanacs := lengthof(p_GNSS_AlmanacList);
    var integer i;

    if (v_NoOfAlmanacs < p_NoOfElem){
      FatalError(__FILE__, __LINE__, "p_GNSS_AlmanacList has less elements than needed!");
    }

    for (i := 0; i < p_NoOfElem; i := i + 1) {
      v_GNSS_AlmanacList[i] := p_GNSS_AlmanacList[i];
    }
    return v_GNSS_AlmanacList;
  }

