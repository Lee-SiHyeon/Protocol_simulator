  /*
   * @desc      get UTRAN cell being 'fdd' or 'tdd' in RatType (to be used in UTRAN ASPs)
   * @param     p_CellId
   * @return    RatType
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UTRAN_CellInfo_GetRatType(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC return RatType
  {
    var RatType v_RatType  := fdd;
    
    if (f_UTRAN_CellInfo_GetFDD_TDD(p_CellId) == UTRAN_TDD){
      v_RatType:=tdd128;
    }
    return v_RatType;
  }

