  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.3.2b.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_3_2b_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    // Logical channel prioritization handling
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
