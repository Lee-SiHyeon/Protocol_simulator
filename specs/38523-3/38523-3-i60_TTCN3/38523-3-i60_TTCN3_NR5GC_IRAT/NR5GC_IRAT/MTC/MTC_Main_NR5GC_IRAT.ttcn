module MTC_Main_NR5GC_IRAT {

  import from CommonDefs all;
  import from EUTRA_Component all;
  import from EUTRA_Component_Multi5GS all;
  import from GERAN_Component all;
  import from GERAN_NR5GC_Component all;
  import from IMS_Component all;
  import from IMS_DefaultHandler all;
  import from IP_PTC_Component all;
  import from IP_PTC_Main all;
  import from MTC_Base all;
  import from MTC_Component_NR5GC_IRAT all;
  import from MTC_UpperTester all;
  import from NR_CommonDefs all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NasEmu5G_Component_NRNG all;
  import from NasEmu5G_Main_NRNG all;
  import from NasEmu_Component_EUTRA38_IRAT all;
  import from NasEmu_Main_EUTRA38_IRAT all;
  import from UTRAN_Component all;
  import from UTRAN_NR5GC_Component all;
  import from UpperTesterSystemCmds all;
  import from WLAN_Component all;

  /*
   * @desc      Connect all PTCs (NR test cases)
   * @param     p_System
   * @param     p_Nr
   * @param     p_Eutra
   * @param     p_Utran
   * @param     p_Geran
   * @param     p_ImsPdn1
   * @param     p_ImsPdn2
   * @param     p_Wlan
   * @param     p_RatCombination    (default value: omit)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_MTC_ConnectPTCs_NR5GC_IRAT(SYSTEM_NR5GC_IRAT p_System,
                                  NR5GC_PTC p_Nr,
                                  EUTRA_Multi5GS_PTC p_Eutra,
                                  UTRAN_NR5GC_PTC p_Utran,
                                  GERAN_NR5GC_PTC p_Geran,
                                  IMS_PTC p_ImsPdn1,
                                  IMS_PTC p_ImsPdn2,
                                  WLAN_PTC p_Wlan,
                                  template (omit) NR_RATComb_Tested_Type p_RatCombination := omit) runs on MTC_NR5GC_IRAT
  { // Added optional UTRAN/GERAN PTC for eCall tests
    var NASEMU_EUTRA38_IRAT_PTC   v_NASEMU_EUTRA_PTC;
    var NASEMU_NRNG_PTC v_NASEMU_NR_PTC;
    var IP_PTC v_IP_PTC;
    var IMS_PTC v_ImsPdn1;

    vc_Components.Nr    := p_Nr;
    vc_Components.Eutra := p_Eutra;
    vc_Components.Utran := p_Utran;
    vc_Components.Geran := p_Geran;
    vc_Components.Wlan := p_Wlan;

    if ((p_Nr == null)) {
      FatalError (__FILE__, __LINE__, "invalid configuration");
      mtc.stop;
    }

    // ***** MTC *****
    f_MTC_BASE_Map(p_System);

    // ***** NR PTC *****
    f_NR_BASE_PTC_Map(p_System, p_Nr);
    v_NASEMU_NR_PTC := f_NasEmu5G_CreateConnectAndMap_NRNG(p_System, p_Nr);  // create NasEmu, map system ports and connect with NR PTC
    v_NASEMU_NR_PTC.start(f_NASEMU_MainLoop_NRNG());                            // start NASEMU

    // ***** EUTRA PTC *****
    f_EUTRA_PTC_Map(p_System, p_Eutra);                // map EUTRA system ports
    v_NASEMU_EUTRA_PTC := f_NasEmu_CreateConnectAndMap_EUTRA38(p_System, p_Eutra);  // create NasEmu, map system ports and connect with EUTRA PTC
    v_NASEMU_EUTRA_PTC.start(f_NASEMU_MainLoop_EUTRA38());                          // start NASEMU

    // ***** UTRAN PTC *****
    if ((p_Utran != null) and ((not isvalue(p_RatCombination) or (valueof(p_RatCombination) == NR_UTRA)))) { // if p_RatCombination == NR_GERAN the UTRAN PTC is used as dummy only to get sys info
      f_UTRAN_PTC_Map(p_System, p_Utran);
    }

    // ***** GERAN PTC *****
    if ((p_Geran != null) and ((not isvalue(p_RatCombination) or (valueof(p_RatCombination) == NR_GERAN)))) { // if p_RatCombination == NR_GERAN the UTRAN PTC is used as dummy only to get sys info
      f_GERAN_PTC_Map(p_System, p_Geran);
    }

    // ***** WLAN PTC *****
    if ((p_Wlan != null)) {
      f_WLAN_PTC_Map(p_System, p_Wlan);
    }

    // ***** Create, map, connect and start IP PTC *****
    v_IP_PTC := f_IP_PTC_CreateAndMap(p_System);
    if (p_Eutra != null)     {connect(p_Eutra:IP, v_IP_PTC:EUTRA_CTRL);}
    if (p_Utran != null)     {connect(p_Utran:IP, v_IP_PTC:UTRAN_CTRL);}
    if (p_Geran != null)     {connect(p_Geran:IP, v_IP_PTC:GERAN_CTRL);}
    //if (p_Wlan != null)    {connect(p_Wlan:IP,  vc_IP_PTC:WLAN_CTRL);}
      
    connect(p_Nr:IP, v_IP_PTC:NR_CTRL);
    v_IP_PTC.start(f_IP_PTC_MainLoop());

    // ***** Create, connect and start IMS PTC *****
    // IMS for PDN1: if PTC is not created yet the default IMS PTC will be used
    if (p_ImsPdn1 == null) { v_ImsPdn1 := f_IMS_PTC_Create(); }         // => default IMS handling for PDN1
    else                   { v_ImsPdn1 := p_ImsPdn1; }

    connect(v_ImsPdn1:IMS_CTRL,      v_IP_PTC:IMS_CTRL[tsc_Index_IMS1]);
    connect(v_ImsPdn1:IMS_Server,    v_IP_PTC:IMS_Server[tsc_Index_IMS1]);
    connect(v_ImsPdn1:IMS_Client,    v_IP_PTC:IMS_Client[tsc_Index_IMS1]);
    
    connect(v_ImsPdn1:IPCAN,         p_Nr:IMS[tsc_Index_IMS1]);       /* @sic R5s191107 change 1 sic@ */
    if (p_Eutra != null)    {
      connect(v_ImsPdn1:OtherIPCAN,    p_Eutra:IMS[tsc_Index_IMS1]);    /* @sic R5s191107 change 1 sic@ */
    }
    if (p_Utran != null) { /* @sic R5-142919: sic@
                              when we have test case specific IMS behaviour and there is a UTRAN PTC => we need coordination of IMS and UTRAN
                              @sic R5s150057 change 1: sic@
                              to allow IMS de-registration on UTRAN at the end of test cases UTRAN shall always be connected to the IMS PTC */
      connect(v_ImsPdn1:OtherIPCAN,  p_Utran:IMS[tsc_Index_IMS1]);
    }

    connect(v_ImsPdn1:MMI, mtc:PTC_Ut[tsc_MTC_PortIndex_IMS1]);

    if (p_ImsPdn1 == null) {         /* => we have no test case specific IMS implementation */
      v_ImsPdn1.start(f_IMS_DefaultHandler());
    }

    // IMS for PDN (emergency call)
    if (p_ImsPdn2 != null) {                             // test case specific IMS handling for PDN2
      connect(p_ImsPdn2:IMS_CTRL,    v_IP_PTC:IMS_CTRL[tsc_Index_IMS2]);
      connect(p_ImsPdn2:IMS_Server,  v_IP_PTC:IMS_Server[tsc_Index_IMS2]);
      connect(p_ImsPdn2:IMS_Client,  v_IP_PTC:IMS_Client[tsc_Index_IMS2]);
      
      connect(p_ImsPdn2:IPCAN,       p_Nr:IMS[tsc_Index_IMS2]);       /* @sic R5s191107 change 1 sic@ */
      if (p_Eutra != null) {
        connect(p_ImsPdn2:OtherIPCAN,  p_Eutra:IMS[tsc_Index_IMS2]);    /* @sic R5s191107 change 1 sic@ */
      }
      connect(p_ImsPdn2:MMI,         mtc:PTC_Ut[tsc_MTC_PortIndex_IMS2]);
    }

    // ***** Connect PTCs to MTC *****
    connect(mtc:PTC_Ut[tsc_MTC_PortIndex_NR],       p_Nr:UT);
    if (p_Eutra != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_EUTRA],    p_Eutra:UT);}
    if (p_Utran != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_UTRAN],    p_Utran:UT);}
    if (p_Geran != null)     {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_GERAN],    p_Geran:UT);}
    if (p_Wlan != null)      {connect(mtc:PTC_Ut[tsc_MTC_PortIndex_WLAN],     p_Wlan:UT);}

    // ***** Connect NR PTC to other PTCs *****
    if (p_Eutra != null)    {connect(p_Nr:EUTRA,    p_Eutra:NR)};
    if (p_Utran != null)    {connect(p_Nr:UTRAN,    p_Utran:NR)};
    if (p_Geran != null)    {connect(p_Nr:GERAN,    p_Geran:NR);}
    if (p_Wlan != null)     {connect(p_Nr:WLAN,     p_Wlan:NR)};

    // ***** Connect UTRAN PTC to GERAN PTC for sys info transfer *****
    if ((p_Geran != null) and (p_Utran != null))     {connect(p_Utran:GERAN, p_Geran:UTRAN);}

    // connect NAS EMU co-ord port:  @sic 5G Integrity in 4G sic@
    connect(v_NASEMU_EUTRA_PTC:NG,  v_NASEMU_NR_PTC:EPS);
    
    f_UT_InitialPowerOffUE(Ut);
  }

  /*
   * @desc      stop mtc, NAS emulator, IP PTC etc. when all test case components have finished
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_MTC_StopIfFinished_NR5GC_IRAT() runs on MTC_NR5GC_IRAT
  {
    if (vc_Components.Nr == null and
        (vc_Components.Eutra == null) and
        (vc_Components.Wlan == null)) {
      f_MTC_Stop(pass);                      // 'pass' will overrule 'none' only
    }
  }

  /*
   * @desc      Interface to control the other components
   * @status    APPROVED (NR5GC_IRAT)
   */
  altstep a_PTC_Control_NR5GC_IRAT() runs on MTC_NR5GC_IRAT
  { /* NOTEs:
       - acc. to ES 201 873-1 Annex F.1.1 an error verdict shall be assignd when "running" is applied on any uninitialised component
       - it seems that "running" cannot be used in the "[]" */
    
    [] any component.killed
      { // at a component something's gone wrong and it killed itself, so have to stop everything else
        all component.kill;
        mtc.stop;
      }
    
    [vc_Components.Nr != null] vc_Components.Nr.done
      {
        vc_Components.Nr := null;
        fl_MTC_StopIfFinished_NR5GC_IRAT();
      }
    [vc_Components.Eutra != null] vc_Components.Eutra.done
      {
        vc_Components.Eutra := null;
        fl_MTC_StopIfFinished_NR5GC_IRAT();
      }
    [vc_Components.Wlan != null] vc_Components.Wlan.done
      {
        vc_Components.Wlan := null;
        fl_MTC_StopIfFinished_NR5GC_IRAT();
      }
  }

  /*
   * @desc      Main loop of the MTC
   * @param     p_GuardTimer
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_MTC_MainLoop_NR5GC_IRAT(timer p_GuardTimer) runs on MTC_NR5GC_IRAT
  {
    f_MTC_BASE_Init();

    while (true) {      /* mtc will be stopped by a_PTC_Control_NBIOT or due to timeout of the guard timer;
                           => neither a_PTC_Control_NBIOT nor a_UpperTester needs to use 'repeat' */
      alt {
        [] a_PTC_Control_NR5GC_IRAT();             // handle 'done' and 'killed' of PTCs: MTC will be stopped, when all PTCs are terminated or a fatal error occurs
        
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_NR);    // handle upper tester for PTC 0 (NR)
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_EUTRA);    // handle upper tester for PTC 1 (EUTRA)
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_IMS1);    // handle upper tester for PTC 2 (IMS1)
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_IMS2);    // handle upper tester for PTC 3 (IMS2)
        [] a_MTC_ReceiveFromPTC_SendToUT(tsc_MTC_PortIndex_WLAN);    // handle upper tester for PTC 6 (WLAN)
        [] a_MTC_ReceiveFromUT_SendToPTC();
 
        [] p_GuardTimer.timeout {f_MTC_Stop(fail);}    /* acc. to the assumption that preamble and postamble are short compared to the testbody
                                                          a FAIL verdict is assigned (rather than an INCONC) */
      }
    }
  }

}
