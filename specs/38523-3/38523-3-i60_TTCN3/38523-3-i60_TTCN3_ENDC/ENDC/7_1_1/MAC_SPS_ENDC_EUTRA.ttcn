module MAC_SPS_ENDC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_LoopBack all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.1.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_6_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig;
    // Logical channel prioritization handling
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    //@sic R5s221195 sic@
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 0, 1, TEST_LOOPModeA_ON, -, cs_UE_TestLoopModeA_NR_LB_Setup_1DRB(0, tsc_DRB2));
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
      
     //@siclog steps 0A-0B siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

    //@siclog steps 29-30 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.2.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_6_2_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    // Logical channel prioritization handling
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 1, 0, TEST_LOOPModeA_ON );
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
      
     //@siclog steps 1-2 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

   //@siclog steps 6-7 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

    //@siclog steps 17-18 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.6.3.ENDC
   * @status    APPROVED (ENDC)
   */
  function f_TC_7_1_1_6_3_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
    var template (omit) octetstring v_NR_SCGConfig := omit;
    // Logical channel prioritization handling
    f_EUTRA38_Init(EN_DC, c1);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    //Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_Preamble (eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);
    
    f_EUTRA38_ENDC_ConfigAM_UM (eutra_Cell1, 0, 1, TEST_LOOPModeA_ON); //@sic R5s221064 sic@
    
    f_EUTRA_TestBody_Set(true);
    // Send trigger to NR to test on SCG bearer
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);
      
     //@siclog steps 1-2 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);

    //@siclog steps 24-35 siclog@
    
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1,
                                           -, -,
                                           v_NR_SCGConfig);
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);
    
    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  };

}
