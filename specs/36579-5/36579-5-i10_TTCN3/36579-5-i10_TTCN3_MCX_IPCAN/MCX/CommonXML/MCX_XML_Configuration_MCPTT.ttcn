    attr := omit,
    choice_list := {
      { mCPTTGroupInfo := cs_MCPTT_UserProfile_ListEntries(cs_MCPTT_UserProfile_OffNetwork_MCPTTGroupInfoList) },
      { user_Info_ID := char2oct("555555555555") }          // @sic R5-217985: According to 24.484 clauses 8.3.2.6, 9.3.2.6 and 10.3.2.6 <DiscoveryGroupID> is 3 octets, <User-Info-ID> is 6 octets sic@
    }
  };

  template (value) RulesForAffiliationManagementType cs_MCPTT_UserProfile_RulesForAffiliationManagement(float p_LatitudeDegreesEnter,
                                                                                                        float p_LongitudeDegreesEnter,
                                                                                                        float p_LatitudeDegreesExit,
                                                                                                        float p_LongitudeDegreesExit) :=
  { /* @status    APPROVED (MCX) */
    index := omit,
    attr := omit,
    choice_list := {
      { listOfLocationCriteria := cs_MCPTT_UserProfile_GeographicalAreaChange(cs_MCPTT_UserProfile_GeographicalArea(p_LatitudeDegreesEnter,  p_LongitudeDegreesEnter),
                                                                              cs_MCPTT_UserProfile_GeographicalArea(p_LatitudeDegreesExit, p_LongitudeDegreesExit)) }
    }
  };

  /*
   * @desc      encoding anyExt for MCPTTGroupInfo
   * @return    urn_3gpp_mcptt_user_profile_1_0.AnyExtType
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_MCPTTGroupInfoEntry_AnyExt() return urn_3gpp_mcptt_user_profile_1_0.AnyExtType
  {
    var Manual_deaffiliation_not_allowed_if_affiliation_rules_are_met v_Manual_deaffiliation_not_allowed_if_affiliation_rules_are_met := true;
    var float v_LatitudeDegreesEnterAffiliation := 35.74428;
    var float v_LongitudeDegreesEnterAffiliation := 139.69695;
    var float v_LatitudeDegreesExitAffiliation := 35.74428;
    var float v_LongitudeDegreesExitAffiliation := 139.69806;
    var template (value) RulesForAffiliation v_RulesForAffiliation := cs_MCPTT_UserProfile_RulesForAffiliationManagement(v_LatitudeDegreesEnterAffiliation, v_LongitudeDegreesEnterAffiliation,
                                                                                                                         v_LatitudeDegreesExitAffiliation,  v_LongitudeDegreesExitAffiliation);
    var float v_LatitudeDegreesEnterDeaffiliation := 35.74428;
    var float v_LongitudeDegreesEnterDeaffiliation := 139.69806;
    var float v_LatitudeDegreesExitDeaffiliation := 35.74428;
    var float v_LongitudeDegreesExitDeaffiliation := 139.69695;
    var template (value) RulesForDeaffiliation v_RulesForDeaffiliation := cs_MCPTT_UserProfile_RulesForAffiliationManagement(v_LatitudeDegreesEnterDeaffiliation, v_LongitudeDegreesEnterDeaffiliation,
                                                                                                                             v_LatitudeDegreesExitDeaffiliation,  v_LongitudeDegreesExitDeaffiliation);
    var urn_3gpp_mcptt_user_profile_1_0.AnyExtType v_AnyExt := {
      elem_list := {
        f_Bit2XsdString(encvalue(v_RulesForAffiliation)),
        f_Bit2XsdString(encvalue(v_RulesForDeaffiliation)),
        f_Bit2XsdString(encvalue(v_Manual_deaffiliation_not_allowed_if_affiliation_rules_are_met))
      }
    };
    return v_AnyExt;
  }

  template (value) MCPTT_UserProfile_ListEntry_Type.choice_list cs_MCPTT_UserProfile_OnNetwork_MCPTTGroupInfo :=
  { /* @status    APPROVED (MCX) */
    { entry := cs_MCPTT_UserProfile_Entry(-, "0", px_MCPTT_Group_A_ID, px_MCPTT_Group_A_Name, fl_MCPTT_MCPTTGroupInfoEntry_AnyExt()) }  /* @sic R5-206051: only one entry anymore sic@
                                                                                                                                           @sic R5-236601: anyExt with Rules for Affiliation sic@ */
  };

  template (value) MCPTT_UserProfile_ListEntry_Type.choice_list cs_MCPTT_UserProfile_OnNetwork_ImplicitAffiliations :=
