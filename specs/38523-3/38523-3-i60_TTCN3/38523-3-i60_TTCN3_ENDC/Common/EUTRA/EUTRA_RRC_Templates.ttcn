  template (value) DRX_Config cs_508_DRX_Config_DrxS(DRX_Config_OnDuration_Type p_OnDuration := psf2) :=
  { /* Default values according to 36.508 cl. 4.8.2.1.5 Table 4.8.2.1.5-1 (using condition DRX_S) */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    /* @sic R5s170937: p_OnDuration sic@ */
    setup := {
      onDurationTimer := p_OnDuration,
      drx_InactivityTimer := psf100,
      drx_RetransmissionTimer := psf16,
      longDRX_CycleStartOffset := {
        sf40 := 4     /* @sic R5-104796 DRX support; further CR for 508 at TS GR 49 sic@ */
      },
      shortDRX := omit
    }
  };

  template (value) LongDrxCycleAndOffset_Type cs_LongDrxCycleAndOffset_sf1280(integer p_CycleStartOffset) := { sf1280 := p_CycleStartOffset };   /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */

  template (value) DRX_Config cs_508_DRX_Config_DrxL :=
  { /* Default values according to 36.508 cl. 4.8.2.1.5 Table 4.8.2.1.5-1 (using condition DRX_L) */
    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC_IRAT, POS) */
    setup := {
      onDurationTimer := psf6,
      drx_InactivityTimer := psf1920,
      drx_RetransmissionTimer := psf16,
      longDRX_CycleStartOffset := cs_LongDrxCycleAndOffset_sf1280(4),    //@sic R5-106616 & R5s100692 change 5.1 sic@
      shortDRX := omit
    }
  };

