  type enumerated MCX_InitState_Type {                                                                                  /* @status    APPROVED (MCX) */
    REGISTERED_ONLY,                    /* UE has performed RRC/NAS signalling according to 36.579-1 clause 5.4.2 for initial registration but not the HTTP/SIP signalling of 36.579-1 clause 5.3.2 */
    REGISTERED_AUTHORIZED,              /* UE has performed RRC/NAS signalling according to 36.579-1 clause 5.4.2 for initial registration together with initial HTTP/SIP signalling of 36.579-1 clause 5.3.2 */
    REGISTERED_AUTHORIZED_FA_ACTIVATED  /* UE has performed RRC/NAS signalling according to 36.579-1 clause 5.4.2 for initial registration together with initial HTTP/SIP signalling of 36.579-1 clause 5.3.2
                                           and followed by UE intitated MCX functional alias status determination and subscription (36.579-1 clause 5.3.36)
                                           and             UE initiated MCX functional alias status change (36.579-1 clause 5.3.37) */
    
  };

  type enumerated MCX_ServiceType_Type { MCPTT, MCVideo, MCData, MCDataSDS, MCDataFD, MCDataIPCONN };                   /* @status    APPROVED (MCX) */

  type enumerated MCX_SessionType_Type { ON_DEMAND, PRE_ESTABLISHED };                                                  /* @status    APPROVED (MCX) */

