   */
  function f_NR_GetSIB1_PagingCycle(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return PagingCycle
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    if (not isbound(v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pcch_Config)) {
      FatalError(__FILE__, __LINE__, "SIB1 not found");
    }
    return v_NR_CellInfo.Sysinfo.BcchInfo.SIB1.message_.c1.systemInformationBlockType1.servingCellConfigCommon.downlinkConfigCommon.pcch_Config.defaultPagingCycle;
  }

