  /*
   * @desc      helper function to cope with ambiguity of the attribite list in SDP_media_desc:
   *            in case of not attributes the codec may set SDP_media_desc.attributes to omit or to {}
   * @param     p_Attributes
   * @return    template SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_Attributes_Superset(template (present) SDP_attribute_list p_Attributes) return template SDP_attribute_list
  {
    var template SDP_attribute_list v_Attributes;

    if (lengthof(p_Attributes) > 0) {
      v_Attributes := superset(all from p_Attributes);
    } else {
      v_Attributes := *;
    }
    return v_Attributes;
  }

  /*
   * @desc      add further attribute to given list
   * @param     p_SDP_Attribute_List
   * @param     p_SDP_Attribute
   * @param     p_Condition         (default value: true)
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_Attributes_Add_TX(template (omit) SDP_attribute_list p_SDP_Attribute_List,
                                   template (omit) SDP_attribute p_SDP_Attribute,
                                   boolean p_Condition := true) return template (omit) SDP_attribute_list
  { /* @sic R5s130510: additional parameter p_Condition sic@ */
    var template (omit) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List;
    var integer i := 0;

    if (p_Condition) {
      if (isvalue(p_SDP_Attribute)) {
        if (isvalue(v_SDP_Attribute_List)) {
          i := lengthof(v_SDP_Attribute_List);
        }
        v_SDP_Attribute_List[i] := p_SDP_Attribute;
      }
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      concatinate list of SDP attributes
   * @param     p_SDP_Attribute_List1
   * @param     p_SDP_Attribute_List2
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_Attributes_Concat_TX(template (omit) SDP_attribute_list p_SDP_Attribute_List1,
                                      template (omit) SDP_attribute_list p_SDP_Attribute_List2) return template (omit) SDP_attribute_list
  {
    var template (omit) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List1;
    var SDP_attribute_list v_SDP_Attribute_List2;
    var integer n;
    var integer k;
    
    if (isvalue(p_SDP_Attribute_List2)) {
      v_SDP_Attribute_List2 := valueof(p_SDP_Attribute_List2);
      n := lengthof(v_SDP_Attribute_List2);
      for (k:=0; k < n; k:=k+1) {
        v_SDP_Attribute_List := f_SDP_Attributes_Add_TX(v_SDP_Attribute_List, v_SDP_Attribute_List2[k]);
      }
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      add attribute to list of attributes
   * @param     p_SDP_Attribute_List
   * @param     p_SDP_Attribute
   * @param     p_Condition         (default value: true)
   * @return    template (present) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_Attributes_Add_RX(template (present) SDP_attribute_list p_SDP_Attribute_List,
                                   template (present) SDP_attribute p_SDP_Attribute,
                                   boolean p_Condition := true) return template (present) SDP_attribute_list
  {
    var template (present) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List;
    var integer i := 0;

    if (p_Condition) {
      i := lengthof(v_SDP_Attribute_List);
      v_SDP_Attribute_List[i] := p_SDP_Attribute;
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      concatinate list of SDP attributes
   * @param     p_SDP_Attribute_List1
   * @param     p_SDP_Attribute_List2
   * @return    template (present) SDP_attribute_list
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_Attributes_Concat_RX(template (present) SDP_attribute_list p_SDP_Attribute_List1,
                                      template (present) SDP_attribute_list p_SDP_Attribute_List2) return template (present) SDP_attribute_list
  {
    var template (present) SDP_attribute_list v_SDP_Attribute_List := p_SDP_Attribute_List1;
    var integer i := lengthof(p_SDP_Attribute_List1);
    var integer k;

    for (k:=0; k < lengthof(p_SDP_Attribute_List2); k:=k+1) {
      v_SDP_Attribute_List[i+k] := p_SDP_Attribute_List2[k];
    }
    return v_SDP_Attribute_List;
  }

  /*
   * @desc      exchange attribute in given attribute list
   * @param     p_AttributeList
   * @param     p_AttributeToBeChanged
   * @param     p_NewAttribute
   * @return    template (omit) SDP_attribute_list
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_ExchangeAttribute(template (omit) SDP_attribute_list p_AttributeList,
                                   template (present) SDP_attribute p_AttributeToBeChanged,
                                   template (value) SDP_attribute p_NewAttribute) return template (omit) SDP_attribute_list
  { // @sic R5s120530 change 3.17 sic@
    var template (omit) SDP_attribute_list v_AttributeList := p_AttributeList;
    var integer i := 0;
    if (isvalue(v_AttributeList)) {
      for (i:=0; i<lengthof(v_AttributeList); i:=i+1) {
        if (match(valueof(v_AttributeList[i]), p_AttributeToBeChanged)) {
          v_AttributeList[i] := p_NewAttribute;
        }
      }
    }
    return v_AttributeList;
  }

  /*
   * @desc      Get attribute from a list of SDP attributes:
   *            if an attribute is found in the list which matches the given template this attribute is returned;
   *            otherwise omit is returned
   * @param     p_AttributeList
   * @param     p_Attribute
   * @return    template (omit) SDP_attribute
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_AttributeList_GetAttribute(template (omit) SDP_attribute_list p_AttributeList,
                                            template (present) SDP_attribute p_Attribute) return template (omit) SDP_attribute
  {
    var SDP_attribute v_Attribute;
    var integer i;
    
    if (f_SDP_AttributeList_CheckAttribute(p_AttributeList, p_Attribute)) {
      for (i := 0; i < lengthof(p_AttributeList); i := i + 1) {
        v_Attribute := valueof(p_AttributeList[i]);
        if (match(v_Attribute, p_Attribute)) {
          return v_Attribute;
        }
      }
    }
    return omit;
  }

  /*
   * @desc      check Attribute to be contained in given list
   * @param     p_AttributeList
   * @param     p_Attribute
   * @return    boolean
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_AttributeList_CheckAttribute(template (omit) SDP_attribute_list p_AttributeList,
                                              template (present) SDP_attribute p_Attribute) return boolean
  {
    var boolean v_Result := false;
    var template (present) SDP_attribute_list v_Template;
    
    if (isvalue(p_AttributeList)) {
      v_Template := { p_Attribute, * };
      v_Result := match(valueof(p_AttributeList), v_Template);
    }
    return v_Result;
  }

  /*
   * @desc      check all media streams to have the given attribute
   * @param     p_Media_Desc_List
   * @param     p_Attribute
   * @return    boolean
   * @status    APPROVED (IMS)
   */
  function f_SDP_CheckMediaListAttributes(template (value) SDP_media_desc_list p_Media_Desc_List,
                                          template (present) SDP_attribute p_Attribute) return boolean
  {
    var integer i;

    for (i := 0; i < lengthof(p_Media_Desc_List); i:=i+1) {
      if (not f_SDP_AttributeList_CheckAttribute(p_Media_Desc_List[i].attributes, p_Attribute)) {
        return false;
      }
    }
    return true;
  }

  /*
   * @desc      get index of media stream as indicated by p_MediaType;
   *            return -1 if there is no such stream
   * @param     p_MediaList
   * @param     p_MediaType
   * @return    integer
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaList_GetMediaStreamIndex(template (value) SDP_media_desc_list p_MediaList,
                                                   charstring p_MediaType) return integer
  {
    var integer i;
    
    for (i:=0; i < lengthof(p_MediaList); i:=i+1) {
      if (valueof(p_MediaList[i].media_field.media) == p_MediaType) {
        return i;
      }
    }
    return -1;
  }

  /*
   * @desc      return the media stream as indicated by p_MediaType
   * @param     p_MediaList
   * @param     p_MediaType
   * @return    template (omit) SDP_media_desc
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, MCX, NR5GC_IRAT)
   */
  function f_IMS_SDP_MediaList_GetMediaStream(template (value) SDP_media_desc_list p_MediaList,
                                              charstring p_MediaType) return template (omit) SDP_media_desc
  {
    var integer i := f_IMS_SDP_MediaList_GetMediaStreamIndex(p_MediaList, p_MediaType);
    
    if (i >= 0) {
      return p_MediaList[i];
    }
    return omit;
  }

  /*
   * @desc      get a specific fmt out of the fmts list in a media description of the initial request (in general INVITE) of the dialog;
   *            when p_RtpmapCodecInfo == omit => rtpmap attributes are not checked
   *            when p_FmtpParameters  == omit => fmtp attributes are not checked
   *            when both are omit the first element of fmts is return (if any);
   *            returns the first fmt in the fmts list of the media description (RFC 4566 cl. 5.14) matching the given rtpmap and the given fmtp attributes;
   *            returns "" if no fmt is found
   * @param     p_SDP_Media_Desc
   * @param     p_RtpmapCodecInfo
   * @param     p_FmtpParameters    (default value: omit)
   * @return    charstring
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaDescr_GetMediaFormat(SDP_media_desc p_SDP_Media_Desc,
                                           template SDP_attribute_rtpmap_codec p_RtpmapCodecInfo,
                                           template SDP_attribute_fmtp_format_specific_params p_FmtpParameters := omit) return charstring
  {
    var charstring v_Fmt;
    var integer i;
    var boolean v_RtpmapMatch;
    var boolean v_FmtpMatch;

    for (i := 0; i < lengthof(p_SDP_Media_Desc.media_field.fmts); i := i + 1) {
      v_Fmt := p_SDP_Media_Desc.media_field.fmts[i];

      v_RtpmapMatch := not ispresent(p_RtpmapCodecInfo);  // -> p_RtpmapCodecInfo is omit
      v_FmtpMatch := not ispresent(p_FmtpParameters);     // -> p_FmtpParameters is omit
      
      if (not v_RtpmapMatch) {                            // -> p_RtpmapCodecInfo is value
        v_RtpmapMatch := f_SDP_AttributeList_CheckAttribute(p_SDP_Media_Desc.attributes, cr_SDP_Attribute_rtpmap(v_Fmt, p_RtpmapCodecInfo));   // compiler warning cannot be avoided
      }

      if (not v_FmtpMatch) {                              // -> p_FmtpParameters is value
        v_FmtpMatch := f_SDP_AttributeList_CheckAttribute(p_SDP_Media_Desc.attributes, cr_SDP_Attribute_fmtp(v_Fmt, p_FmtpParameters));        // compiler warning cannot be avoided
      }

      if (v_RtpmapMatch and v_FmtpMatch) {
        return v_Fmt;
      }
    }
    return "";
  }

  /*
   * @desc      return parameter list of fmtp attribute
   * @param     p_AttributeList
   * @param     p_Fmt
   * @return    SemicolonParam_List
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, MCX, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaDescr_GetCodecParameters(template (omit) SDP_attribute_list p_AttributeList,
                                               template (present) charstring p_Fmt) return SemicolonParam_List
  {
    var template (omit) SDP_attribute v_FmtpAttribute := f_SDP_AttributeList_GetAttribute(p_AttributeList, cr_SDP_Attribute_fmtp(p_Fmt));
    var SemicolonParam_List v_ParameterList := {};

    if (isvalue(v_FmtpAttribute.fmtp.params.paramList)) {
      v_ParameterList := valueof(v_FmtpAttribute.fmtp.params.paramList);
    }
    return v_ParameterList;
  }

  /*
   * @desc      return true, when media description contains precondition attributes
   * @param     p_SDP_Media_Desc
   * @return    boolean
   * @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC)
   */
  function f_SDP_MediaDescr_CheckWithPreconditions(template (value) SDP_media_desc p_SDP_Media_Desc) return boolean
  {
    var SDP_media_desc v_SDP_Media_Desc := valueof(p_SDP_Media_Desc);
    return (f_SDP_AttributeList_CheckAttribute(v_SDP_Media_Desc.attributes, cr_SDP_Attribute_curr_qos(c_local, ?)) and
            f_SDP_AttributeList_CheckAttribute(v_SDP_Media_Desc.attributes, cr_SDP_Attribute_curr_qos(c_remote, ?)) and
            f_SDP_AttributeList_CheckAttribute(v_SDP_Media_Desc.attributes, cr_SDP_Attribute_des_qos(?, c_local, ?)) and
            f_SDP_AttributeList_CheckAttribute(v_SDP_Media_Desc.attributes, cr_SDP_Attribute_des_qos(?, c_remote, ?)));
  }

  type enumerated EVS_ConfigurationName_Type { A1, A2, B0, B1, B2, Further };  /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  type record EVS_Configuration_Type {  /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */
    EVS_ConfigurationName_Type Name,
    SemicolonParam_List        FmtpParameters
  };

  type record of EVS_Configuration_Type EVS_ConfigurationList_Type;  /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */

  template (present) EVS_Configuration_Type cr_EVS_Configuration(template (present) EVS_ConfigurationName_Type p_Name,
                                                                 template (present) SemicolonParam_List p_FmtpParameters := ?) :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */
    Name := p_Name,
    FmtpParameters := p_FmtpParameters
  };

  /*
   * @desc      if given a=fmtp matches one of the EVS Configurations A1, A2, B0, B1, B2 or the wideband configuration without br and mode-set parameters,
   *            then a list with the matching configuration is returned (list with one element only)
   *            else an empty list is returned
   * @param     p_FmtpParameters
   * @return    EVS_ConfigurationList_Type
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_SDP_Fmtp_MatchNG114PayloadType(SemicolonParam_List p_FmtpParameters) return EVS_ConfigurationList_Type
  {
    var template (present) EVS_ConfigurationList_Type v_NG114_Configurations := {
      cr_EVS_Configuration(A1,      cr_EVS_Fmtp_AudioParamsBrBwMaxRed("5.9-13.2", "nb-swb")),
      cr_EVS_Configuration(A2,      cr_EVS_Fmtp_AudioParamsBrBwMaxRed("5.9-24.4", "nb-swb")),
      cr_EVS_Configuration(B0,      cr_EVS_Fmtp_AudioParamsBrBwMaxRed("13.2",     "swb")),
      cr_EVS_Configuration(B1,      cr_EVS_Fmtp_AudioParamsBrBwMaxRed("9.6-13.2", "swb")),
      cr_EVS_Configuration(B2,      cr_EVS_Fmtp_AudioParamsBrBwMaxRed("9.6-24.4", "swb")),
      cr_EVS_Configuration(Further, superset(cr_EVS_Bw("nb-swb"), cr_AMR_MaxRed))       /* needs to be the last entry as it would match the other configurations too
                                                                                           !!!! PROSE ISSUE: the a=fmtp line specifies bw=nb-swb but the corresponding note says "up to super-wideband" !!!! */
    };
    var EVS_ConfigurationList_Type v_EVS_ConfigurationList := {};
    var EVS_ConfigurationName_Type v_ConfigurationName;
    var integer i;

    for (i := 0; i < lengthof(v_NG114_Configurations); i := i + 1) {
      if (match(p_FmtpParameters, v_NG114_Configurations[i].FmtpParameters)) {
        v_ConfigurationName := valueof(v_NG114_Configurations[i].Name);                 // A1, A2, B0, B1, B2, Further
        if ((v_ConfigurationName != Further) or                                         // one of A1, A2, B0, B1, B2 or further payload type and ...
            (not match(p_FmtpParameters, superset(cr_EVS_Br(?))) and                    // ... no br parameter and ...
             not match(p_FmtpParameters, superset(cr_Fmtp_ModesetParam(?))))) {         // ... no mode-set parameter
          v_EVS_ConfigurationList := {
            { v_ConfigurationName, p_FmtpParameters }
          };
        }
      }
    }
    return v_EVS_ConfigurationList;
  }

  /*
   * @desc      return list of EVS Configurations contained in the given media description
   *            34.229-5 A.4.1/2 (INVITE), NG.114 clause 3.2.2.3
   * @param     p_SDP_Media_Desc
   * @return    EVS_ConfigurationList_Type
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_MediaDescr_GetNG114PayloadTypes(SDP_media_desc p_SDP_Media_Desc) return EVS_ConfigurationList_Type
  {
    var EVS_ConfigurationList_Type v_EVS_ConfigurationList := {};
    var SemicolonParam_List v_FmtpParameters;
    var charstring v_Fmt;
    var integer i;

    for (i := 0; i < lengthof(p_SDP_Media_Desc.media_field.fmts); i := i + 1) {
      v_Fmt := p_SDP_Media_Desc.media_field.fmts[i];
      if (f_SDP_AttributeList_CheckAttribute(p_SDP_Media_Desc.attributes, cr_SDP_Attribute_rtpmap(v_Fmt, cr_RTPMAP_EVS_16000))) {
        v_FmtpParameters := f_SDP_MediaDescr_GetCodecParameters(p_SDP_Media_Desc.attributes, v_Fmt);
        v_EVS_ConfigurationList := v_EVS_ConfigurationList & fl_SDP_Fmtp_MatchNG114PayloadType(v_FmtpParameters);
      }
    }
    return v_EVS_ConfigurationList;
  }

  /*
   * @desc      return fmtp parameters common for TX/RX depending on the first EVS codec in the initial offer
   * @param     p_MediaDescription_InitialOffer
   * @return    SemicolonParam_List
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function fl_SDP_SelectedEVSCodecParameters_Common(SDP_media_desc p_MediaDescription_InitialOffer) return SemicolonParam_List
  {
    var EVS_ConfigurationList_Type v_EVS_ConfigurationList := f_SDP_MediaDescr_GetNG114PayloadTypes(p_MediaDescription_InitialOffer);
    var template (value) SemicolonParam_List v_FmtpParameterList;
    var charstring v_BrVal;
    var charstring v_BwVal;

    if (match(v_EVS_ConfigurationList[0].FmtpParameters, cr_EVS_Fmtp_AudioParamsBrBw("13.2", "swb"))) {    // first EVS configuration is B0 i.e. with "br=13.2;bw=swb"
      v_BrVal := "13.2";                  // 34.229-5 A.4.1/2 183 Session Progress, NOTE 8; configuration B0
      v_BwVal := "swb";
    } else {
      v_BrVal := "5.9-13.2";              // 34.229-5 A.4.1/2 183 Session Progress, NOTE 9; configuration A1
      v_BwVal := "nb-swb";
    }
    v_FmtpParameterList := { cs_EVS_Br(v_BrVal), cs_EVS_Bw(v_BwVal) }; // @sic R5-221471: no mode-set parameter anymore sic@
    return valueof(v_FmtpParameterList);
  }

  /*
   * @desc      return fmtp parameters for SDP answer
   * @param     p_MediaDescription_InitialOffer
   * @return    template (value) SemicolonParam_List
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_SelectedEVSCodecParameters_AnswerTX(SDP_media_desc p_MediaDescription_InitialOffer) return template (value) SemicolonParam_List
  {
    var template (value) SemicolonParam_List v_FmtpParameterList;

    v_FmtpParameterList := fl_SDP_SelectedEVSCodecParameters_Common(p_MediaDescription_InitialOffer);
    v_FmtpParameterList := f_SemicolonParam_List_Add_TX(v_FmtpParameterList, cs_Fmtp_ModesetParam("0,1,2"));  // @sic R5-221471: mode-set parameter added as removed from fl_SDP_SelectedEVSCodecParameters_Common sic@
    v_FmtpParameterList := f_SemicolonParam_List_Add_TX(v_FmtpParameterList, cs_AMR_MaxRed);
    
    return v_FmtpParameterList;
  }

  /*
   * @desc      return fmtp parameters for SDP offer modifying a session
   * @param     p_MediaDescription_InitialOffer
   * @return    template (present) SemicolonParam_List
   * @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_SelectedEVSCodecParameters_UpdatedOfferRX(SDP_media_desc p_MediaDescription_InitialOffer) return template (present) SemicolonParam_List
  {
    var template (present) SemicolonParam_List v_FmtpParameterList;
    
    v_FmtpParameterList := fl_SDP_SelectedEVSCodecParameters_Common(p_MediaDescription_InitialOffer);
    v_FmtpParameterList := f_SemicolonParam_List_Add_RX(v_FmtpParameterList, cr_AMR_MaxRed);
    
    return superset(all from v_FmtpParameterList);     // @sic R5s210734: superset sic@
  }

  /*
   * @desc      get receive template for rtpmap attribute for given voice codec
   * @param     p_AudioCodec
   * @return    template (present) SDP_attribute_rtpmap_codec
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_AttributeRtpmapAudioRX(IMS_SDP_AudioCodec_Type p_AudioCodec) return template (present) SDP_attribute_rtpmap_codec
  {
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodecInfo;

    select (p_AudioCodec) {
      case (AMR_8000) {
        v_RtpmapCodecInfo := cr_RTPMAP_AMR_8000;
      }
      case (AMR_16000) {
        v_RtpmapCodecInfo := cr_RTPMAP_AMR_16000;
      }
      case (EVS_16000) {
        v_RtpmapCodecInfo := cr_RTPMAP_EVS_16000;
      }
      case (DTMF_8000) {      // @sic R5-172931 sic@
        v_RtpmapCodecInfo := cr_RTPMAP_TelephoneEvent_8000;
      }
      case (DTMF_16000) {     // @sic R5-172931 sic@
        v_RtpmapCodecInfo := cr_RTPMAP_TelephoneEvent_16000;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown codec");
      }
    }
    return v_RtpmapCodecInfo;
  }

  /*
   * @desc      get receive template for rtpmap attribute for given video codec
   * @param     p_VideoCodec
   * @return    template (present) SDP_attribute_rtpmap_codec
   * @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC)
   */
  function f_SDP_AttributeRtpmapVideoRX(IMS_SDP_VideoCodec_Type p_VideoCodec) return template (present) SDP_attribute_rtpmap_codec
  {
    var template (present) SDP_attribute_rtpmap_codec v_RtpmapCodecInfo;

    select (p_VideoCodec) {
      case (H264_90000) {
        v_RtpmapCodecInfo := cr_RTPMAP_H264_90000;
      }
      case (H265_90000) {
        v_RtpmapCodecInfo := cr_RTPMAP_H265_90000;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown codec");
      }
    }
    return v_RtpmapCodecInfo;
  }

  /*
   * @desc      get send template for rtpmap attribute for given video codec
   * @param     p_VideoCodec
   * @return    template (value) SDP_attribute_rtpmap_codec
   * @status    APPROVED (IMS, LTE, LTE_A_R12, NR5GC)
   */
  function f_SDP_AttributeRtpmapVideoTX(IMS_SDP_VideoCodec_Type p_VideoCodec) return template (value) SDP_attribute_rtpmap_codec
  {
    var template (value) SDP_attribute_rtpmap_codec v_RtpmapCodecInfo;

    select (p_VideoCodec) {
      case (H264_90000) {
        v_RtpmapCodecInfo := cs_RTPMAP_H264_90000;
      }
      case (H265_90000) {
        v_RtpmapCodecInfo := cs_RTPMAP_H265_90000;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown codec");
      }
    }
    return v_RtpmapCodecInfo;
  }

  /*
   * @desc      return default fmtp parameters for a given voice codec
   * @param     p_AudioCodec
   * @return    template (present) SDP_attribute_fmtp_format_specific_params
   * @status    APPROVED (IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT)
   */
  function f_SDP_FmtpDefaultParametersAudioCodecRX(IMS_SDP_AudioCodec_Type p_AudioCodec) return template (present) SDP_attribute_fmtp_format_specific_params
  {
    var template (present) SDP_attribute_fmtp_format_specific_params v_FmtpParameters;

    select (p_AudioCodec) {
      case (EVS_16000) {
        v_FmtpParameters := cr_EVS_Fmtp_DefaultParameters;        // => any EVS codec will match
      }
      case (AMR_8000, AMR_16000) {
        v_FmtpParameters := cr_AMR_Fmtp_DefaultParameters;
      }
      case (DTMF_8000, DTMF_16000) {                   /* @sic R5-172931 sic@ */
        v_FmtpParameters := cr_Fmtp_ParamList(?);      /* @sic R5-172931: any fmtp attribute for DTMF sic@ */
      }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown codec");
      }
    }
    return v_FmtpParameters;
  }

  /*
   * @desc      return payload type number for given codec
   *            @sic R5-197050: fix mapping of fmt values sic@
   * @param     p_AudioCodec
   * @return    charstring
   * @status    APPROVED (IMS, LTE_A_IRAT, LTE_A_PRO, LTE_IRAT, NR5GC_IRAT)
   */
  function f_SDP_AudioCodec_GetFmt(IMS_SDP_AudioCodec_Type p_AudioCodec) return charstring
  {
    var charstring v_Fmt;

    select (p_AudioCodec) {
      case (EVS_16000)  { v_Fmt := "96"; }
      case (AMR_16000)  { v_Fmt := "97"; }
      case (DTMF_16000) { v_Fmt := "98"; }
      case (AMR_8000)   { v_Fmt := "99"; }
      case (DTMF_8000)  { v_Fmt := "100"; }
      case else {
        FatalError(__FILE__, __LINE__, "Unknown codec");
      }
    }
    return v_Fmt;
  }

  /*
   * @desc      get default audio codec
   * @param     p_SDP_Media_Desc
   * @param     p_AudioCodec
   * @param     p_FmtpParameters    (default value: *)
