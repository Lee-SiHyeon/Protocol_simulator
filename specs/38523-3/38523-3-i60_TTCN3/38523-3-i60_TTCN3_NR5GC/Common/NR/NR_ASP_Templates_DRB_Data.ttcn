/******************************************************************************/
module NR_ASP_Templates_DRB_Data {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonAspDefs all;
  import from CommonDefs all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_CommonPart all;
  import from NR_CommonDefs all;
  import from NR_PDCP_TypeDefs all;
  import from SDAP_TypeDefs all;

  template (value) NR_HarqProcessAssignment_Type cs_NR_HarqProcessAssignment_Automatic := { Automatic := true };                              /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) NR_L2DataList_Type cs_NR_L2DataList_MacPdu(template (value) NR_MAC_PDUList_Type p_PDUList) := { MacPdu := p_PDUList };     /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_L2DataList_Type cs_NR_L2DataList_RlcPdu(template (value) NR_RLC_PDUList_Type p_PDUList) := { RlcPdu := p_PDUList };     /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_L2DataList_Type cs_NR_L2DataList_PdcpPdu(template (value) NR_PDCP_PDUList_Type p_PDUList) := { PdcpPdu := p_PDUList };  /* @status    APPROVED (ENDC, NR5GC) */

  template (value) NR_L2DataList_Type cs_NR_L2DataList_PdcpSdu(template (value) NR_PDCP_SDUList_Type p_SDUList) := { PdcpSdu := p_SDUList };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (value) NR_L2DataList_Type cs_NR_L2DataList_SdapSdu(template (value) SDAP_SDUList_Type p_SDUList) := { SdapSdu := p_SDUList };     /* @status    APPROVED (NR5GC, NR5GC_IRAT) */

  template (value) NR_DRB_DataPerSlot_DL_Type cs_NR_DRB_DataPerSlot_DL(integer p_SlotOffset := 0,
                                                                       template (value) NR_HarqProcessAssignment_Type p_HarqProcessAssignment := cs_NR_HarqProcessAssignment_Automatic,
                                                                       template (value) NR_L2DataList_Type p_PduSduList) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    SlotOffset := p_SlotOffset,
    HarqProcess := p_HarqProcessAssignment,
    PduSduList := p_PduSduList
  };

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_DataPerSlotCommon(NR_CellId_Type p_NR_CellId,
                                                                             template (value) NR_RoutingInfo_Type p_RoutingInfo,
                                                                             template (value) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                             template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                             template (value) NR_DRB_DataPerSlotList_DL_Type p_DataPerSlot,
                                                                             template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit) :=
  {  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-213516 sic@
    Common := cs_NR_ReqAspCommonPart(p_NR_CellId, p_RoutingInfo, p_RlcBearerRouting, p_TimingInfo, tsc_NoCnfReq, -, p_MacBearerRoutingCA), // @sic R5s190219 sic@
    U_Plane := {
      SlotDataList := p_DataPerSlot
    },
    SuppressPdcchForC_RNTI := omit
  };

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_DataPerSlot(NR_CellId_Type p_NR_CellId,
                                                                       DRB_Identity p_DrbId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_DRB_DataPerSlotList_DL_Type p_DataPerSlot,
                                                                       template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                                                       ) :=
  /* @status    APPROVED (ENDC, NR5GC) */
  /* Template for DRB Data REQ with RLC PDUs */
  /* @sic R5w190114: p_RlcBearerRouting removed sic@ */
  // @sic R5-213516 sic@
    cas_NR_DRB_COMMON_REQ_DataPerSlotCommon(p_NR_CellId, cs_NR_RoutingInfo_RbId(cs_NR_RadioBearerId_DRB(p_DrbId)), cs_RlcBearerRouting_NR(p_NR_CellId), p_TimingInfo, p_DataPerSlot, p_MacBearerRoutingCA);

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_PDCP_SDUList(NR_CellId_Type p_NR_CellId,
                                                                        DRB_Identity p_DrbId,
                                                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                        template (value) NR_PDCP_SDUList_Type p_PDCP_SDUList,
                                                                        template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                        integer p_SlotOffset := 0) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cas_NR_DRB_COMMON_REQ_DataPerSlot(p_NR_CellId, p_DrbId, p_TimingInfo, {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, p_HarqProcess, cs_NR_L2DataList_PdcpSdu(p_PDCP_SDUList))} );

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_PDCP_PDUList(NR_CellId_Type p_NR_CellId,
                                                                        DRB_Identity p_DrbId,
                                                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                        template (value) NR_PDCP_PDUList_Type p_PDCP_PDUList,
                                                                        template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                        integer p_SlotOffset := 0,
                                                                        template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit
                                                                        ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    // @sic R5-213516 sic@
    cas_NR_DRB_COMMON_REQ_DataPerSlot(p_NR_CellId, p_DrbId, p_TimingInfo, {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, p_HarqProcess, cs_NR_L2DataList_PdcpPdu(p_PDCP_PDUList))}, p_MacBearerRoutingCA );

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_PDCP_PDUList_DC(NR_CellId_Type p_NR_CellId,
                                                                             DRB_Identity p_DrbId,
                                                                             template (value) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                             template (value) TimingInfo_Type p_TimingInfo:= cs_TimingInfo_Now,
                                                                             template (value) NR_PDCP_PDUList_Type p_PDCP_PDUList ,
                                                                             template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                             ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cas_NR_DRB_COMMON_REQ_DataPerSlot_DC(p_NR_CellId, p_DrbId, p_TimingInfo, p_PDCP_PDUList, p_MacBearerRoutingCA, p_RlcBearerRouting);

 template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_DataPerSlot_DC(NR_CellId_Type p_NR_CellId,
                                                                       DRB_Identity p_DrbId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_PDCP_PDUList_Type p_PDCP_PDUList,
                                                                       template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit,
                                                                       template (value) RlcBearerRouting_Type p_RlcBearerRouting
                                                                       ) :=
    /* Template for DRB Data REQ with PDCP PDUs */
    /* @status    APPROVED (ENDC, NR5GC) */
  cas_NR_DRB_COMMON_REQ_DataPerSlotCommon(p_NR_CellId,
                                            cs_NR_RoutingInfo_RbId(cs_NR_RadioBearerId_DRB(p_DrbId)),
                                            p_RlcBearerRouting,
                                            p_TimingInfo,
                                            {cs_NR_DRB_DataPerSlot_DL(-, -, cs_NR_L2DataList_PdcpPdu(p_PDCP_PDUList))},
                                            p_MacBearerRoutingCA);

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_RLC_PDUList(NR_CellId_Type p_NR_CellId,
                                                                       DRB_Identity p_DrbId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_RLC_PDUList_Type p_RLC_PDUList,
                                                                       template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                       integer p_SlotOffset := 0) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cas_NR_DRB_COMMON_REQ_DataPerSlot(p_NR_CellId, p_DrbId, p_TimingInfo, {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, p_HarqProcess, cs_NR_L2DataList_RlcPdu(p_RLC_PDUList))} );

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_MAC_PDUList(NR_CellId_Type p_NR_CellId,
                                                                       DRB_Identity p_DrbId,
                                                                       template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                       template (value) NR_MAC_PDUList_Type p_MAC_PDUList,
                                                                       template (value) NR_HarqProcessAssignment_Type p_HarqProcess := cs_NR_HarqProcessAssignment_Automatic,
                                                                       integer p_SlotOffset := 0,
                                                                       template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    cas_NR_DRB_COMMON_REQ_DataPerSlot(p_NR_CellId, p_DrbId, p_TimingInfo, {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, p_HarqProcess, cs_NR_L2DataList_MacPdu(p_MAC_PDUList))}, p_MacBearerRoutingCA );

  template (value) NR_DRB_COMMON_REQ cas_NR_DRB_COMMON_REQ_SDAP_SDUList(NR_CellId_Type p_NR_CellId,
                                                                        template (value) QosFlow_Identification_Type p_QoS_Id,
                                                                        template (value) SDAP_SDUList_Type p_SDAP_SDUList,
                                                                        template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now,
                                                                        integer p_SlotOffset := 0,
                                                                        template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit ) :=
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    cas_NR_DRB_COMMON_REQ_DataPerSlotCommon(p_NR_CellId,
                                            cs_NR_RoutingInfo_QosFlow(p_QoS_Id),
                                            cs_RlcBearerRouting_NR(p_NR_CellId),
                                            p_TimingInfo,
                                            {cs_NR_DRB_DataPerSlot_DL(p_SlotOffset, -, cs_NR_L2DataList_SdapSdu(p_SDAP_SDUList))},
                                            p_MacBearerRoutingCA
                                            );

  template (present) NR_L2DataList_Type cr_NR_L2DataList_MacPdu(template (present) NR_MAC_PDUList_Type p_PDUList) := { MacPdu := p_PDUList };     /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_L2DataList_Type cr_NR_L2DataList_RlcPdu(template (present) NR_RLC_PDUList_Type p_PDUList) := { RlcPdu := p_PDUList };     /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_L2DataList_Type cr_NR_L2DataList_PdcpPdu(template (present) NR_PDCP_PDUList_Type p_PDUList) := { PdcpPdu := p_PDUList };  /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_L2DataList_Type cr_NR_L2DataList_PdcpSdu(template (present) NR_PDCP_SDUList_Type p_SDUList) := { PdcpSdu := p_SDUList };  /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */

  template (present) NR_L2DataList_Type cr_NR_L2DataList_SdapSdu(template (present) SDAP_SDUList_Type p_SDUList) := { SdapSdu := p_SDUList };     /* @status    APPROVED (NR5GC, NR5GC_IRAT) */

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_Common(NR_CellId_Type p_NR_CellId,
                                                                    template (present) NR_RoutingInfo_Type p_RoutingInfo,
                                                                    template (present) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                    template (present) TimingInfo_Type p_TimingInfo,
                                                                    template (present) NR_L2DataList_Type p_L2DataList,
                                                                    template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                    ) :=
  { /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-213516 sic@
    Common := cr_NR_IndAspCommonPart(p_NR_CellId, p_RoutingInfo, p_RlcBearerRouting, p_TimingInfo, -, p_MacBearerRoutingCA),
    U_Plane := {
      SlotData   := {
        PduSduList := p_L2DataList,
        NoOfTTIs := ?
      }
    }
  };

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND(NR_CellId_Type p_NR_CellId,
                                                             template (present) DRB_Identity p_DrbId,
                                                             template (present) TimingInfo_Type p_TimingInfo,
                                                             template (present) NR_L2DataList_Type p_L2DataList, //@sic R5s211654 sic@
                                                             template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_DRB_COMMON_IND_Common(p_NR_CellId, cr_NR_RoutingInfo_RbId(cr_NR_RadioBearerId_DRB(p_DrbId)), cr_RlcBearerRouting_NR(p_NR_CellId), p_TimingInfo, p_L2DataList, p_MacBearerRoutingCA);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_Any := car_NR_DRB_COMMON_IND(nr_Cell1,?,?,?); /* @status    APPROVED (ENDC, NR5GC) */

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_PDCP_SDUList_DC(NR_CellId_Type p_NR_CellId,
                                                                             template (present) DRB_Identity p_DrbId,
                                                                             template (present) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                             template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                             template (present) NR_PDCP_SDUList_Type p_PDCP_SDUList := ?,
                                                                             template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                             ) :=
    /* @status    APPROVED (ENDC, NR5GC, NR5GC_IRAT) */
    // @sic R5-213516 sic@
    car_NR_DRB_COMMON_IND_Common(p_NR_CellId, cr_NR_RoutingInfo_RbId(cr_NR_RadioBearerId_DRB(p_DrbId)), p_RlcBearerRouting, p_TimingInfo, cr_NR_L2DataList_PdcpSdu(p_PDCP_SDUList), p_MacBearerRoutingCA);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_PDCP_PDUList_DC(NR_CellId_Type p_NR_CellId,
                                                                             DRB_Identity p_DrbId,
                                                                             template (present) RlcBearerRouting_Type p_RlcBearerRouting,
                                                                             template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                             template (present) NR_PDCP_PDUList_Type p_PDCP_PDUList := ?,
                                                                             template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                             ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    // @sic R5-213516 sic@
    car_NR_DRB_COMMON_IND_Common(p_NR_CellId, cr_NR_RoutingInfo_RbId(cr_NR_RadioBearerId_DRB(p_DrbId)), p_RlcBearerRouting, p_TimingInfo, cr_NR_L2DataList_PdcpPdu(p_PDCP_PDUList), p_MacBearerRoutingCA);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_MAC_PDUList(NR_CellId_Type p_NR_CellId,
                                                                         DRB_Identity p_DrbId,
                                                                         template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                         template (present) NR_MAC_PDUList_Type p_MAC_PDUList := ?,
                                                                         template (omit)    MacBearerRouting_Type  p_MacBearerRoutingCA := omit) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    //@sic R5-221467 - R5w220022 sic@
    car_NR_DRB_COMMON_IND(p_NR_CellId, p_DrbId, p_TimingInfo, cr_NR_L2DataList_MacPdu(p_MAC_PDUList),p_MacBearerRoutingCA);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_RLC_PDUList(NR_CellId_Type p_NR_CellId,
                                                                         DRB_Identity p_DrbId,
                                                                         template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                         template (present) NR_RLC_PDUList_Type p_RLC_PDUList := ?) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_DRB_COMMON_IND(p_NR_CellId, p_DrbId, p_TimingInfo, cr_NR_L2DataList_RlcPdu(p_RLC_PDUList));

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_PDCP_SDUList(NR_CellId_Type p_NR_CellId,
                                                                          template (present) DRB_Identity p_DrbId,
                                                                          template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                          template (present) NR_PDCP_SDUList_Type p_PDCP_SDUList := ?) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_DRB_COMMON_IND(p_NR_CellId, p_DrbId, p_TimingInfo, cr_NR_L2DataList_PdcpSdu(p_PDCP_SDUList));

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_PDCP_PDUList(NR_CellId_Type p_NR_CellId,
                                                                          DRB_Identity p_DrbId,
                                                                          template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                          template (present) NR_PDCP_PDUList_Type p_PDCP_PDUList := ?,
                                                                          template (omit)  MacBearerRouting_Type  p_MacBearerRoutingCA := omit
                                                                          ) :=
    /* @status    APPROVED (ENDC, NR5GC) */
    car_NR_DRB_COMMON_IND(p_NR_CellId, p_DrbId, p_TimingInfo, cr_NR_L2DataList_PdcpPdu(p_PDCP_PDUList), p_MacBearerRoutingCA);

  template (present) NR_DRB_COMMON_IND car_NR_DRB_COMMON_IND_SDAP_SDUList(NR_CellId_Type p_NR_CellId,
                                                                          template (present) QosFlow_Identification_Type p_QoS_Id,
                                                                          template (present) SDAP_SDUList_Type p_SDAP_SDUList,
                                                                          template (present) TimingInfo_Type p_TimingInfo := cr_TimingInfo_Any,
                                                                          template (omit) MacBearerRouting_Type p_MacBearerRoutingCA := omit ) :=
    /* @status    APPROVED (NR5GC, NR5GC_IRAT) */
    car_NR_DRB_COMMON_IND_Common(p_NR_CellId, cr_NR_RoutingInfo_QosFlow(p_QoS_Id), cr_RlcBearerRouting_NR(p_NR_CellId), p_TimingInfo, cr_NR_L2DataList_SdapSdu(p_SDAP_SDUList), p_MacBearerRoutingCA);

}
