module RRC_ConnRel_NR5GC_EUTRA {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EPS_NAS_MsgContainers all;
  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_IRAT_CommonFunctions all;
  import from EUTRA38_NR5GCProcedures all;
  import from EUTRA38_NR5GC_InitialRegistration all;
  import from EUTRA_CellInfo all;
  import from EUTRA_Component all;
  import from EUTRA_Component_Multi5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NR_CoordMsg all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from NasEmu_CtrlFunctions all;

  template (value) MTC_SSB_NR_r15 cs_MTC_SSB_NR_FR1_8_1_1_3_7a :=
  {/* @status    APPROVED (NR5GC_IRAT) */

    periodicityAndOffset_r15 := { sf20_r15 := 10 },
    ssb_Duration_r15 := sf2

  };

  template (value) MTC_SSB_NR_r15 cs_MTC_SSB_NR_FR2_8_1_1_3_7a :=
  {/* @status    APPROVED (NR5GC_IRAT) */

    periodicityAndOffset_r15 := { sf20_r15 := 10 },
    ssb_Duration_r15 := sf3

  };

  /*
   * @desc      Assign measTimingConfig_r15 in SIB24 of the cell
   * @param     p_CellId
   * @param     p_MTC_SSB_NR_r15
   * @param     p_Index             (default value: 0)
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA_CellInfo_SetSIB24_SetmeasTimingConfig_r15_periodicityAndOffset_r15(EUTRA_CellId_Type p_CellId,
                                                                                      template (value) MTC_SSB_NR_r15 p_MTC_SSB_NR_r15,
                                                                                      integer p_Index := 0) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);

    // SIB24 is only present in combination c31
    select (valueof(v_CellInfo.Sysinfo.Combination)) {
    case (c31) {
        v_CellInfo.Sysinfo.BCCH_Info.SIs[2].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib24_v1530.carrierFreqListNR_r15[p_Index].measTimingConfig_r15 := p_MTC_SSB_NR_r15;
        f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
        f_EUTRA_SetSIs_ValueTag(p_CellId);
      }
    case else {
        FatalError(__FILE__, __LINE__, "Invalid System Combination");
    }
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_2_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //RRC connection release / Redirection from NR to EUTRA
    
    f_EUTRA38_IRAT_Init(c31); // @sic R5-198910 sic@

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
    f_EUTRA38_SetCellPower(eutra_Cell1, -91, -96);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_1_3_2_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_T3440); // @sic R5-204435, R5-211388 sic@
    // take down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_1_3_2_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_2_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    // Send EUTRA frequency to NR
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
    
    // @siclog "Step 2" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_Cell1, tsc_RRC_TI_Def, -, -, noRrcConnectionRelease); // @sic R5-204435 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Power Level"));  // @sic R5s210406 sic@

  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_4_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //RRC connection release / Success / With priority information / T320 expiry / E-UTRA
    
    f_EUTRA38_IRAT_Init(c1);

    // Send EUTRA frequency to NR
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1, eutra_Cell3}));
       
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell3, -73);
    
    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell3);
    
    f_EUTRA38_NR5GC_PreambleAndSwitchOff (eutra_Cell1);
       
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_1_3_4_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E2_CONNECTED); // @sic R5-202623 sic@
    // take down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_1_3_4_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_4_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {

    // @siclog "Step 1" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, -73, -73);
    f_EUTRA38_SetCellPower(eutra_Cell3, -73, -73);
    
    // @siclog "Step 2 - 3G" siclog@
    f_TAU_N1ToS1_CheckDataPath(eutra_Cell3,
                               tsc_RRC_TI_Def,
                               "Step 2C",
                               "Step 3GB",
                               eutra_Cell1);
    
    // @siclog "Step 3H" siclog@
    f_EUTRA_RRC_ConnectionRelease(eutra_Cell3); // @sic R5-202623 sic@

    // @siclog "Step 4" siclog@
    f_EUTRA38_SetCellPower(eutra_Cell1, tsc_NonSuitableOffCellRS_EPRE,tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA38_SetCellPower(eutra_Cell3, tsc_NonSuitableOffCellRS_EPRE, tsc_NonSuitableOffCellRS_EPRE);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Step 4"));
    
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell3, true); // This will reset the NAS Count on NR @sic R5-204434 sic@
    // So need to reset NAS count here too
    f_EUTRA_NB_SS_NAS_CountSet(NASCTRL, '00000000'O, '00000000'O); // @sic R5s201062 sic@
    
    // @siclog "Step 7" siclog@
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Step 7");
    f_EUTRA38_SetCellPower(eutra_Cell1, -73, -73);
    
    // @siclog "Step 9 - 16" siclog@
    f_TAU_N1ToS1_CheckDataPath(eutra_Cell1,
                               tsc_RRC_TI_Def,
                               "Step 9C",
                               "Step 16B",
                               eutra_Cell3,
                               false);  // @sic R5s201062 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.7a.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_7a_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //RRC connection release / Success / Deprioritisation / NR / T325 expiry
    var EUTRA_NR_CoOrd_SysInfo_Type v_EUTRA_NR_SysInfo;

    f_EUTRA38_IRAT_Init(c31);

    //@sic R5-233358,R5s230292 sic@
    v_EUTRA_NR_SysInfo := f_EUTRA_NR_WaitForCoOrd_SysInfo(NR);
    if(v_EUTRA_NR_SysInfo.NR[0].IsFR1){
        f_EUTRA_CellInfo_SetSIB24_SetmeasTimingConfig_r15_periodicityAndOffset_r15(eutra_Cell1,cs_MTC_SSB_NR_FR1_8_1_1_3_7a,1);
    } else {
        f_EUTRA_CellInfo_SetSIB24_SetmeasTimingConfig_r15_periodicityAndOffset_r15(eutra_Cell1,cs_MTC_SSB_NR_FR2_8_1_1_3_7a,1);
    }

    // Send EUTRA frequency to NR
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));

    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, -75);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);

    fl_TC_8_1_1_3_7a_NR5GC_EUTRA_TestBody();

    f_EUTRA_TestBody_Set(false);

    //Take down the cell now, UE finished postamble on NR side
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Postamble");

    f_EUTRA_ReleaseAllCells();
  }

  /*
   * @desc      test body of TC_8_1_1_3_7a_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_7a_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var integer v_EUTRA_CellPower_T1_Conducted := -75;// @sic R5s240696 sic@
    var integer v_EUTRA_CellPower_T1 := -96;// @sic R5-234558 sic@
    var octetstring v_T325_InMillisec;
    var boolean v_FlagEutra := false;
    var float v_T325;
    var float v_ReleaseMilliSecondsDelay := 300.0; // @sic R5s211680 sic@
    timer t_WaitTime;

    //@siclog "Step 1" siclog@
    //The SS adjusts the SS/PBCH EPRE levels according to row "T1" in table 8.1.1.3.7a.3.2-1/2
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA38_SetCellPower(eutra_Cell1, v_EUTRA_CellPower_T1_Conducted, v_EUTRA_CellPower_T1);// @sic R5s240696 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger);

    //@siclog "Step 3" siclog@
    //SS starts timer T325.
    v_T325_InMillisec := f_EUTRA_NR_WaitForCoOrd_Data(NR, "T325");
    v_T325 := int2float(oct2int(v_T325_InMillisec)/1000);
    f_Delay(v_ReleaseMilliSecondsDelay/1000.0); // Wait for sending NR RRCRelease @sic R5s211680 sic@
    t_WaitTime.start(v_T325);

    //@siclog "Step 4" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.7.2.2-1 is performed and the UE is camped on E-UTRAN Cell 1?
    while(t_WaitTime.running){
      f_EUTRA38_TrackingAreaUpdateFromN1 (eutra_Cell1, tsc_RRC_TI_Def, *); // @sic R5s220225 sic@
      f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 4");
      v_FlagEutra := true;
      break; // @sic R5s211680 sic@
    }

    if(v_FlagEutra == false){
      f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4: UE did not perform generic test procedure in TS 38.508-1 [4] Table 4.9.7.2.2-1 on E-UTRAN Cell 1 before T325 expiry");
    }

    //@siclog "Step 5" siclog@
    //SS waits for T325 expiry.
    t_WaitTime.timeout; // @sic R5s211680 sic@
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Timeout"));

    //@siclog "Step 6" siclog@
    //Check: Does the test result of generic test procedure in TS 38.508-1 [4] Table 4.9.9.2.2-1 indicate that the UE is camped on NR Cell 3?
    f_EUTRA38_NR5GC_S1ToN1_IdleMode(eutra_Cell1, true); // @sic R5s211680 sic@
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.1.3.10.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_8_1_1_3_10_NR5GC_EUTRA() runs on EUTRA_Multi5GS_PTC
  { //RRC connection release / Redirection from NR to EUTRA / MPS Priority Indication
    
    f_EUTRA38_IRAT_Init(c31);

    //Create and configure cell
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    
    f_EUTRA_NR_WaitForCoOrd_Trigger (NR, "Preamble");
    f_EUTRA38_SetCellPower(eutra_Cell1, -91, -96);
    
    f_EUTRA_TestBody_Set(true);
    fl_TC_8_1_1_3_10_NR5GC_EUTRA_TestBody ();
    f_EUTRA_TestBody_Set(false);
    
    f_EUTRA38_MultiPDN_Postamble(eutra_Cell1, E1_IDLE);
    // take down the NR cell
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

  /*
   * @desc      test body of TC_8_1_1_3_10_NR5GC_EUTRA
   * @status    APPROVED (NR5GC_IRAT)
   */
  function fl_TC_8_1_1_3_10_NR5GC_EUTRA_TestBody() runs on EUTRA_Multi5GS_PTC
  {
    var NAS_MSG_Indication_Type v_NasInd;

    // Send EUTRA frequency to NR
    f_EUTRA_NR_SendSysinfoCoOrd(NR, f_EUTRA38_IRAT_ListOfFrequencies({eutra_Cell1}));
    
    // @siclog "Step 3" siclog@
    v_NasInd := f_EUTRA38_TAUReqFromN1 (eutra_Cell1, tsc_RRC_TI_Def, -, -, omit, cr_EstablishmentCause_HighPriorityAccess); // @sic R5s240646 sic@
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 3");
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Power Level"));

    // @siclog "Step 5" siclog@
    f_EUTRA38_TrackingAreaUpdateFromN1_WithoutReq (eutra_Cell1, v_NasInd); // @sic R5s240517, R5s240646 sic@

  }

}
