module RRC_Others_PWS_Notification_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Functions all;
  import from CommonDefs all;
  import from NG_NAS_Common all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellInfoInit all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_Parameters all;
  import from NR_RRC_Templates all;
  import from NR_SysInfo_Templates all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  const bitstring tsc_NR_ETWS_MessageIdentifier := '0001000100000010'B;   /* @status    APPROVED (NR5GC) */

  const bitstring tsc_NR_CMSA_MessageIdentifier := '0001000100010010'B;   /* @status    APPROVED (NR5GC) */

  const bitstring tsc_NR_PWS_SerialNumber := '0011000000000000'B;         /* @status    APPROVED (NR5GC)
                                                                            @sic R5s201077 sic@ */

  const O1_Type tsc_NR_PWS_DataCodingScheme := '00'O;                     /* @status    APPROVED (NR5GC)
                                                                            @sic R5s201077 sic@ */

  type SIB7.warningMessageSegmentType  SIB7_WarningMessageSegmentType_Type;   /* @status    APPROVED (NR5GC) */

  type SIB8.warningMessageSegmentType  SIB8_WarningMessageSegmentType_Type;   /* @status    APPROVED (NR5GC) */

  template (value) SIB6 cs_38508_SIB6_Def :=
  {  // As per 38.508-1 TTable 4.6.2-5: SIB6
      /* @status    APPROVED (NR5GC) */
      messageIdentifier := tsc_NR_ETWS_MessageIdentifier,
      serialNumber := tsc_NR_PWS_SerialNumber,
      warningType := '0580'O, //@sic R5s210143, R5s211303 sic@
      lateNonCriticalExtension := omit
  };

  template (value) SIB7 cs_38508_SIB7_Def (integer p_MessageSegment,
                                            octetstring p_WarningMessageSegment,
                                            SIB7_WarningMessageSegmentType_Type p_WarningMessageSegmentType := lastSegment,
                                            template (omit) O1_Type p_DataCodingScheme := omit) :=
  {   // As per 38.508-1 Table 4.6.2-7: SIB7 common for all segments
      /* @status    APPROVED (NR5GC) */
      messageIdentifier := tsc_NR_ETWS_MessageIdentifier,
      serialNumber := tsc_NR_PWS_SerialNumber,
      warningMessageSegmentType := p_WarningMessageSegmentType,
      warningMessageSegmentNumber := p_MessageSegment,
      warningMessageSegment := p_WarningMessageSegment,
      dataCodingScheme := p_DataCodingScheme,
      lateNonCriticalExtension := omit
  };

  template (value) SIB8 cs_38508_SIB8_Def (integer p_MessageSegment,
                                            octetstring p_WarningMessageSegment,
                                            SIB8_WarningMessageSegmentType_Type p_WarningMessageSegmentType := lastSegment,
                                            template (omit) O1_Type p_DataCodingScheme := omit) :=
  {  // As per 38.508-1 Table 4.6.2-10: SIB8 common for all segments
      /* @status    APPROVED (NR5GC) */
      messageIdentifier := tsc_NR_CMSA_MessageIdentifier,   //@sic R5s201077 sic@
      serialNumber := tsc_NR_PWS_SerialNumber,
      warningMessageSegmentType := p_WarningMessageSegmentType,
      warningMessageSegmentNumber := p_MessageSegment,
      warningMessageSegment := p_WarningMessageSegment,
      dataCodingScheme := p_DataCodingScheme,
      warningAreaCoordinatesSegment := omit,
      lateNonCriticalExtension := omit
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.3.1
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_1_NR5GC() runs on NR5GC_PTC
  { // PWS notification / PWS reception in NR RRC_IDLE state
  
    f_TC_8_1_5_3_Init_NR5GC(STATE_IDLE_1A);
       
  }// End of f_TC_8_1_5_3_1_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.3.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_2_NR5GC() runs on NR5GC_PTC
  { // PWS notification / PWS reception in NR RRC_INACTIVE state
  
    f_TC_8_1_5_3_Init_NR5GC(STATE_INACTIVE_2A);
      
  }// End of f_TC_8_1_5_3_2_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.3.3
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_3_NR5GC() runs on NR5GC_PTC
  { // PWS notification / PWS reception in NR RRC_CONNECTED state
  
    f_TC_8_1_5_3_Init_NR5GC(STATE_CONNECTED_3A);
      
  }// End of f_TC_8_1_5_3_3_NR5GC()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.3.Init
   * @param     p_State
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_Init_NR5GC(NG_STATE_Type p_State) runs on NR5GC_PTC
  {
    
    var NR_RRC_STATE_Type v_UE_State;
  
    f_NR5GC_Init(NR_1);
    
    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, p_State);
      
    select(p_State)
    {//@sic R5s230129 sic@
        case(STATE_IDLE_1A)        {v_UE_State := RRC_IDLE }
        case(STATE_INACTIVE_2A)    {v_UE_State := RRC_INACTIVE}
        case(STATE_CONNECTED_3A)   {v_UE_State := RRC_CONNECTED}
        case else { FatalError (__FILE__, __LINE__, "Invalid configuration")}
    }

    f_NR_TestBody_Set(true);
    f_TC_8_1_5_3_CommonTestBody(v_UE_State); //@sic R5s230129 sic@
    f_NR_TestBody_Set(false);
      
    f_NR_Postamble(nr_Cell1, p_State);
      
  }// End of f_TC_8_1_5_3_Init_NR5GC()

  /*
   * @desc      Test body function for TC 8.1.5.3.1, 8.1.5.3.2 and 8.1.5.3.3
   * @param     p_UE_State
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_CommonTestBody(NR_RRC_STATE_Type p_UE_State) runs on NR5GC_PTC
  {
    var template (value) SIB7 v_Sib7_Seg1;
    var template (value) SIB7 v_Sib7_Seg2;
    var template (value) SIB7 v_Sib7_Seg3;
    
    var template (value) SIB8 v_Sib8_Seg1;
    var template (value) SIB8 v_Sib8_Seg2;
    var template (value) SIB8 v_Sib8_Seg3;
    
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI1 := omit;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI2 := omit;
    var template (omit)  BCCH_DL_SCH_Message v_BCCH_SI3 := omit;
    
    var template (value) NR_SI_List_Type v_NR_SI_List;
    
    var WarningMessageSegment_List v_WarningMsgSegList ;
    
    v_WarningMsgSegList := f_SegmentWarningCB_Data(px_PWS_CB_DataPage1, px_PWS_CB_DataPage2);
        
      
    //Table 8.1.5.3.1.3.2-1: Main behaviour
    //If pc_ETWS_NR is true, steps 1-8 will be excuted
      
    if(pc_ETWS_NR)
    {
        //@siclog "Steps 1-2" siclog@
        //The SS indicates an etwsAndCmasIndication by Short Message field in DCI format 1_0 and transmitted on PDCCH using P-RNTI.
        //The SS starts transmitting SIB1 with the si-SchedulingInfo including scheduling information for SIB6 on NR Cell 1
        //The SS includes an ETWS message with new messageIdentifier and serialNumber in SIB6
        f_NR_SetSysinfoCombinationToNR_10(nr_Cell1, cs_38508_SIB6_Def);
        f_NR_ModifySysinfo_PWS(nr_Cell1, p_UE_State); //@sic R5s230129 sic@
        
        //@siclog "Step 3" siclog@
        //Check: Does the UE indicate the contents of the "warning message" to the user and alert or DCI 1_0activate alerting the user (NOTE 1)?
        if(f_UT_CheckETWS_CMAS_Alert(UT))
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");
        }
        else
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
        }
        
        //@siclog "Step 4" siclog@
        //The SS waits for 10s.
        f_Delay(10.0);
        
        //@siclog "Steps 5-6" siclog@
        //The SS indicates an etwsAndCmasIndication by Short Message field in DCI format 1_0 and transmitted on PDCCH using P-RNTI.
        //The SS starts transmitting SIB1 with the si-SchedulingInfo including scheduling information for SIB6 and SIB7 on NR Cell 1
        //The SS includes an ETWS message with new messageIdentifier and serialNumber in SIB7. (NOTE 2).
        v_Sib7_Seg1 := cs_38508_SIB7_Def(0, v_WarningMsgSegList[0], notLastSegment, tsc_NR_PWS_DataCodingScheme);
        v_Sib7_Seg2 := cs_38508_SIB7_Def(1, v_WarningMsgSegList[1], notLastSegment);
        v_Sib7_Seg3 := cs_38508_SIB7_Def(2, v_WarningMsgSegList[2]);
        
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB7(v_Sib7_Seg1)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB7(v_Sib7_Seg2)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB7(v_Sib7_Seg3)));
        
        v_NR_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
        
        f_NR_SetSysinfoCombination_ToNR_9Or_11(nr_Cell1, NR_11, {v_NR_SI_List});
        f_NR_ModifySysinfo_PWS(nr_Cell1, p_UE_State); //@sic R5s230129 sic@
        
        //@siclog "Step 7" siclog@
        //Check: Does the UE indicate the completely reassembled contents of the "warning message" to the user, and alert or activate alerting the user (NOTE 2)?
        if(f_UT_CheckETWS_CMAS_Alert(UT) and (f_UT_CheckETWS_CMAS(UT,px_PWS_CB_DataPage1, px_PWS_CB_DataPage2))) //@sicR5-195676, R5-197860 sic@
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
        }
        else
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7");
        }
        
        //@siclog "Step 8" siclog@
        //The SS waits for 10s
        f_Delay(10.0);    //@sic R5s230601 sic@
    }
    
    //If pc_CMAS_NR is true, steps 9-11 will be excuted
    if(pc_CMAS_NR)
    {
        //@siclog "Steps 9-10" siclog@
        //The SS indicates an etwsAndCmasIndication by Short Message field in DCI format 1_0 and transmitted on PDCCH using P-RNTI. The SS starts transmitting SIB1 with the si-SchedulingInfo including scheduling information for SIB8 on NR Cell 1.
        //The SS includes a CMAS message with new messageIdentifier and serialNumber in SIB8. (NOTE 4).
        v_Sib8_Seg1 := cs_38508_SIB8_Def(0, v_WarningMsgSegList[0], notLastSegment, tsc_NR_PWS_DataCodingScheme);
        v_Sib8_Seg2 := cs_38508_SIB8_Def(1, v_WarningMsgSegList[1], notLastSegment);
        v_Sib8_Seg3 := cs_38508_SIB8_Def(2, v_WarningMsgSegList[2]);
        
        v_BCCH_SI1 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB8(v_Sib8_Seg1)));
        v_BCCH_SI2 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB8(v_Sib8_Seg2)));
        v_BCCH_SI3 := cs_NR_BCCH_DL_SCH_SIB(cs_NR_SI(cs_NR_SystemInformation_SIB8(v_Sib8_Seg3)));
        
        v_NR_SI_List := {v_BCCH_SI1, v_BCCH_SI2, v_BCCH_SI3};
        
        f_NR_SetSysinfoCombination_ToNR_9Or_11(nr_Cell1, NR_9, {v_NR_SI_List});
        f_NR_ModifySysinfo_PWS(nr_Cell1, p_UE_State); //@sic R5s230129 sic@
        
        //@siclog "Steps 11" siclog@
        //Check: Does the UE indicate the completely reassembled contents of the "warning message" to the user, and alert or activate alerting the user (NOTE 2)?
        if(f_UT_CheckETWS_CMAS_Alert(UT) and f_UT_CheckETWS_CMAS(UT,px_PWS_CB_DataPage1, px_PWS_CB_DataPage2, true)) //@sic R5-195676, R5-197860 sic@
        {
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 11");
        }
        else
        {
            f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 11");
        }
    }
      
  }//End of f_TC_8_1_5_3_CommonTestBody()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.1.5.3.4
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_1_5_3_4_NR5GC() runs on NR5GC_PTC
  { //PWS notification / PWS reception using dedicatedSystemInformationDelivery
  
    f_NR5GC_Init(NR_1);
    
    //Create and configure cells
    f_NR_CellConfig_Def(nr_Cell1);
    
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_8_1_5_3_4_TestBody();
    f_NR_TestBody_Set(false);
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
      
  } // End of function f_TC_8_1_5_3_4_NR5GC

  /*
   * @desc      Test body function for TC 8.1.5.3.4
   * @status    APPROVED (NR5GC)
   */
    function f_TC_8_1_5_3_4_TestBody() runs on NR_BASE_PTC
    {
        var template (value) RRCReconfiguration_v1530_IEs v_RRCReconfiguration_v1530_IEs;
        var octetstring v_WarningMsg;
    
    // Prepare the CB-Data message according to 23.041
    v_WarningMsg := '02'O ; // Number of Pages
    // Concatenate first page information
    v_WarningMsg := v_WarningMsg & f_GetCB_DataInformation(px_PWS_CB_DataPage1) & f_GetCB_DataInformation(px_PWS_CB_DataPage2);
    if(lengthof(v_WarningMsg) > 1246)
    {
        v_WarningMsg := substr(v_WarningMsg, 0, 1245);
    }
    

        if(pc_ETWS_NR)
        {//If pc_ETWS_NR is true, steps 1-6 will be excuted.
            //@siclog "Steps 1-2" siclog@
            //The SS transmits an RRCReconfiguration message containing dedicatedSystemInformationDelivery containing SIB6.
            //Check: Does the UE transmit an RRCReconfigurationComplete message?
            v_RRCReconfiguration_v1530_IEs :=cs_NR_RRCReconfiguration_v1530_IEs(omit, omit, omit, bit2oct(encvalue(cs_NR_SI(cs_NR_SystemInformation_SIB6(cs_38508_SIB6_Def)))));
            f_NR_SendRRCReconfiguration(nr_Cell1,-,-, v_RRCReconfiguration_v1530_IEs);

            //@siclog "Step 3" siclog@
            //Check: Does the UE indicate the contents of the "warning message" to the user and alert or DCI 1_0activate alerting the user (NOTE 1)?
            if(f_UT_CheckETWS_CMAS_Alert(UT))
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");
            }
            else
            {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
            }

            //@siclog "Steps 4-5" siclog@
            //The SS transmits an RRCReconfiguration message containing dedicatedSystemInformationDelivery containing SIB7.
            //Check: Does the UE transmit an RRCReconfigurationComplete message?
            v_RRCReconfiguration_v1530_IEs :=cs_NR_RRCReconfiguration_v1530_IEs(omit, omit, omit, bit2oct(encvalue(cs_NR_SI(cs_NR_SystemInformation_SIB7(cs_38508_SIB7_Def(0, v_WarningMsg, lastSegment, tsc_NR_PWS_DataCodingScheme))))));
            f_NR_SendRRCReconfiguration(nr_Cell1,-,-, v_RRCReconfiguration_v1530_IEs);

            //@siclog "Step 6" siclog@
            //Check: Does the UE indicate the contents of the "warning message" to the user and alert or DCI 1_0activate alerting the user (NOTE 1)?
            if(f_UT_CheckETWS_CMAS_Alert(UT) and(f_UT_CheckETWS_CMAS(UT,px_PWS_CB_DataPage1, px_PWS_CB_DataPage2))) //@sic R5-197097, R5-198925 sic@
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 7");
            }
            else
            {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 7");
            }
        }
        if(pc_CMAS_NR)
        {//If pc_CMAS_NR is true, steps 7-9 will be excuted
            //@siclog "Steps 7-8" siclog@
            //The SS transmits an RRCReconfiguration message containing dedicatedSystemInformationDelivery containing SIB8.
            //Check: Does the UE transmit an RRCReconfigurationComplete message?
            v_RRCReconfiguration_v1530_IEs :=cs_NR_RRCReconfiguration_v1530_IEs(omit, omit, omit, bit2oct(encvalue(cs_NR_SI(cs_NR_SystemInformation_SIB8(cs_38508_SIB8_Def(0, v_WarningMsg, lastSegment, tsc_NR_PWS_DataCodingScheme))))));
            f_NR_SendRRCReconfiguration(nr_Cell1,-,-, v_RRCReconfiguration_v1530_IEs);

            //@siclog "Step 9" siclog@
            //Check: Does the UE indicate the contents of the "warning message" to the user and alert or DCI 1_0activate alerting the user (NOTE 1)?
            if(f_UT_CheckETWS_CMAS_Alert(UT) and (f_UT_CheckETWS_CMAS(UT,px_PWS_CB_DataPage1, px_PWS_CB_DataPage2))) //@sic R5-197097, R5-198925 sic@
            {
                f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 9");
            }
            else
            {
                f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 9");
            }
        }
    }

}
