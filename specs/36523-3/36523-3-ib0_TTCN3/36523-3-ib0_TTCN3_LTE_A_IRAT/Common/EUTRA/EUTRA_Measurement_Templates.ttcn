module EUTRA_Measurement_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_AuxiliaryFunctions all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_RRC_Templates all;

  type integer UTRA_RSCP_Type (-5..91);                         /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer UTRA_EcN0_Type (0..49);                          /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer RSSI_Range_Type (0..63);                         /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer EUTRA_RS_EPRE_Type (-141..-44);                  /* Changed from formerly (-140..-43);   @sic R5-090153 sic@
                                                                   @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11, LTE_IRAT) */

  type integer UTRA_RSCP_dBm_Type (-116..-25);                  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer GERAN_RSSI_dBm_Type (-110..-47);                 /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer A3_Offset_Type (-30..30);                        /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */

  type integer GapOffset_Gp1_Type (0..79);                      /* @status    APPROVED (ENDC, LTE_A_IRAT, LTE_IRAT) */

  type integer CDMA2000_PilotPnPhase (0..32767);                /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type integer CDMA2000_PilotStrength (0..63);                  /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  type ReportConfigToAddMod.reportConfig ReportConfigToAddMod_ReportConfig_Type;                    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  type ReportConfigEUTRA.triggerType ReportConfigEUTRA_Trigger_Type;                                /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  type ReportConfigEUTRA.triggerType.event.eventId ReportConfigEUTRA_Trigger_EventId_Type;          /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  type ReportConfigInterRAT.triggerType ReportConfigInterRAT_Trigger_Type;                          /* @status    APPROVED (ENDC, LTE_A_IRAT, LTE_IRAT) */

  const integer tsc_IdMeasObject_f1 := 1;                       /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) @sic R5-190673 sic@*/

  const integer tsc_IdMeasObject_f2 := 2;                       /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11) */

  const integer tsc_IdMeasObject_f8 := 8;                       /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const integer tsc_IdMeasObject_f10 := 10;                     /* @status    APPROVED (LTE_A_IRAT) */

  const integer tsc_IdMeasObject_f11 := 11;                     /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const integer tsc_IdReportConfig_A3 := 3;                     /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11) */

  const integer tsc_IdReportConfig_B2_GERAN := 11;              /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const integer tsc_IdReportConfig_B2_UTRA := 12;               /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const MeasObjectId    tsc_IdMeasObject_f14 := 14;             /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  const MeasId          tsc_IdReportConfig_B2_CDMA2000 := 13;   /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */

  template (value) DL_DCCH_Message cs_508_RRCConnectionReconfiguration_ConditionMEAS(RRC_TransactionIdentifier p_RRC_TI,
                                                                                     template (omit) MeasConfig p_MeasConfig ) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    cs_RRCConnectionReconfiguration_Common( p_RRC_TI, p_MeasConfig, omit, omit, omit );

  template (value) MeasConfig cs_MeasConfig(template (omit) MeasObjectToRemoveList p_MeasObjectToRemoveList,
                                            template (omit) MeasObjectToAddModList p_MeasObjectToAddModList,
                                            template (omit) ReportConfigToRemoveList p_ReportConfigToRemoveList,
                                            template (omit) ReportConfigToAddModList p_ReportConfigToAddModList,
                                            template (omit) MeasIdToRemoveList p_MeasIdToRemoveList,
                                            template (omit) MeasIdToAddModList p_MeasIdToAddModList,
                                            template (omit) QuantityConfig p_QuantityConfig := cs_QuantityConfig_Def, //@sic R5-134645, R5s130965 (R5-140743) sic@
                                            template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                            template (omit) RSRP_Range p_RSRP_Range := omit,
                                            template (omit) PreRegistrationInfoHRPD p_HRPD_PreRegistrationInfo := omit,
                                            template (omit) MeasConfig.speedStatePars p_SpeedStatePars := omit,
                                            template (omit) MeasObjectToAddModList_v9e0 p_MeasObjectToAddModList_v9e0 := omit,
                                            template (omit) boolean p_Fr1_Gap_r15 := omit,
                                            template (omit) boolean p_Mgta_r15 := omit) :=
  { /* @sic R5s100477 Additional Changes: merge of cs_MeasConfig and cs_MeasConfig_Common sic@ */
    /* @sic R5-169116: added p_MeasObjectToAddModList_v9e0 sic@ */
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    measObjectToRemoveList   := p_MeasObjectToRemoveList,
    measObjectToAddModList   := p_MeasObjectToAddModList,
    reportConfigToRemoveList := p_ReportConfigToRemoveList,
    reportConfigToAddModList := p_ReportConfigToAddModList,
    measIdToRemoveList       := p_MeasIdToRemoveList,
    measIdToAddModList       := p_MeasIdToAddModList,
    quantityConfig           := p_QuantityConfig,
    measGapConfig            := p_MeasGapConfig,
    s_Measure                := p_RSRP_Range,
    preRegistrationInfoHRPD  := p_HRPD_PreRegistrationInfo,
    speedStatePars           := p_SpeedStatePars,
    measObjectToAddModList_v9e0 := p_MeasObjectToAddModList_v9e0,       /* @sic R5s130195 BASELINE MOVING 2013 R5-169116 sic@ */
    allowInterruptions_r11      := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measScaleFactor_r12         := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measIdToRemoveListExt_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measIdToAddModListExt_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measRSRQ_OnAllSymbols_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measObjectToRemoveListExt_r13 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measObjectToAddModListExt_r13 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measIdToAddModList_v1310      := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measIdToAddModListExt_v1310   := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measGapConfigPerCC_List_r14   := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    measGapSharingConfig_r14      := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    fr1_Gap_r15  := p_Fr1_Gap_r15,                      /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 R5s180412 BASELINE MOVING 2018-2 sic@ */
    mgta_r15  := p_Mgta_r15,                         /* @sic R5s180412 BASELINE MOVING 2018-2 sic@ */
    measGapConfigDensePRS_r15  := omit,        /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    heightThreshRef_r15  := omit,              /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    timeMeasConfig_r18     := omit,            /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
    locationMeasConfig_r18 := omit             /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
  };

  template (value) MeasObjectToAddModList cs_MeasObjectToAddModList_2Entries(MeasObjectId p_MeasObjectId_1,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_1,
                                                                             MeasObjectId p_MeasObjectId_2,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_2 ) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    {
      measObjectId := p_MeasObjectId_1,
      measObject   := p_MeasObject_1
    },
    {
      measObjectId := p_MeasObjectId_2,
      measObject   := p_MeasObject_2
    }
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectEUTRA_Common(ARFCN_ValueEUTRA p_EUTRA_DL_CarrierFreq,
                                                                                      AllowedMeasBandwidth p_MeasurementBandwidth,
                                                                                      template (omit) CellIndexList p_ExcludedCellsToRemoveList := omit,
                                                                                      template (omit) ExcludedCellsToAddModList p_ExcludedCellsToAddModList := omit,
                                                                                      template (omit) PhysCellId p_PhysCellId := omit,
                                                                                      template (omit) MeasSubframePatternConfigNeigh_r10 p_MeasSubframePatternConfigNeigh_r10 := omit,
                                                                                      template (omit) MeasCycleSCell_r10  p_MeasCycleSCell_r10 := omit,
                                                                                      template (value) NeighCellConfig p_NeighCellConfig := '01'B, //@sic R5-153740 sic@
                                                                                      template (omit) MeasDS_Config_r12 p_MeasDS_Config_r12 := omit) := //@sic R5s140009 sic@
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    /* @sic R5s120925 - additional change: p_ExcludedCellsToRemoveList, p_ExcludedCellsToAddModList, p_PhysCellId made optional sic@ */
    /* @sic R5s130764: TC_8_3_1_21 - additional parameter p_MeasSubframePatternConfigNeigh_r10 sic@ */
    measObjectEUTRA := {
      carrierFreq             := p_EUTRA_DL_CarrierFreq,
      allowedMeasBandwidth    := p_MeasurementBandwidth,
      presenceAntennaPort1    := false,
      neighCellConfig         := p_NeighCellConfig,
      offsetFreq              := dB0,
      cellsToRemoveList       := omit,
      cellsToAddModList       := omit,
      excludedCellsToRemoveList  := p_ExcludedCellsToRemoveList,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      excludedCellsToAddModList  := p_ExcludedCellsToAddModList,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      cellForWhichToReportCGI := p_PhysCellId,
      measCycleSCell_r10      := p_MeasCycleSCell_r10, //@sic R5s140009 sic@
      measSubframePatternConfigNeigh_r10 := p_MeasSubframePatternConfigNeigh_r10,
      widebandRSRQ_Meas_r11   := omit,
      altTTT_CellsToRemoveList_r12 := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      altTTT_CellsToAddModList_r12 := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      t312_r12                     := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      reducedMeasPerformance_r12   := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      measDS_Config_r12            := p_MeasDS_Config_r12,      /* @sic BASELINE MOVING 2015 sic@ */
      allowedCellsToRemoveList_r13   := omit,                   /* @sic R5s160711 BASELINE MOVING 2016 R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      allowedCellsToAddModList_r13   := omit,                   /* @sic R5s160711 BASELINE MOVING 2016 R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      rmtc_Config_r13              := omit,                     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      carrierFreq_r13              := omit,                     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      tx_ResourcePoolToRemoveList_r14 := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      tx_ResourcePoolToAddList_r14    := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      fembms_MixedCarrier_r14         := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      measSensing_Config_r15          := omit,                  /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
      measRSS_DedicatedConfig_r16     := omit,                  /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      cellsToAddModList_v1810         := omit                   /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
    }
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectGERAN(ARFCN_ValueGERAN p_StartingARFCN,
                                                                               BandIndicatorGERAN p_BandIndicator,
                                                                               template (value) CarrierFreqsGERAN.followingARFCNs p_FollowingARFCNs,
                                                                               template (omit) Q_OffsetRangeInterRAT p_OffsetFreq,
                                                                               template (omit) B8_Type p_NCC_Permitted,
                                                                               template (omit) PhysCellIdGERAN p_CellForWhichToReportCGI) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    measObjectGERAN := {
      carrierFreqs := {
        startingARFCN   := p_StartingARFCN,
        bandIndicator   := p_BandIndicator,
        followingARFCNs := p_FollowingARFCNs
      },
      offsetFreq := p_OffsetFreq,
      ncc_Permitted := p_NCC_Permitted,
      cellForWhichToReportCGI := p_CellForWhichToReportCGI
    }
  };

  template (value) CarrierFreqsGERAN.followingARFCNs cs_FollowingARFCNs_explicitListOfARFCNs(template (value) ExplicitListOfARFCNs p_ExplicitListOfARFCNs) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    explicitListOfARFCNs := p_ExplicitListOfARFCNs
  };

  template (value) CellsToAddModUTRA_FDD cs_CellsToAddModUTRA_FDD(template (value) CellsToAddModUTRA_FDD.cellIndex p_CellIndex,
                                                                  template (value) PhysCellIdUTRA_FDD p_PhysCellId ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cellIndex := p_CellIndex,
    physCellId := p_PhysCellId
  };

  template (value) CellsToAddModListUTRA_FDD cs_CellsToAddModListUTRA_FDD_1Entry(template (value) CellsToAddModUTRA_FDD.cellIndex p_CellIndex,
                                                                                 template (value) PhysCellIdUTRA_FDD p_PhysCellId ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cs_CellsToAddModUTRA_FDD(p_CellIndex, p_PhysCellId)
  };

  template (value) MeasObjectUTRA.cellsToAddModList cs_MeasObjectUTRA_cellsToAddModList_FDD( template (value) CellsToAddModListUTRA_FDD p_CellsToAddModListUTRA_FDD ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cellsToAddModListUTRA_FDD := p_CellsToAddModListUTRA_FDD
  };

  template (value) MeasObjectUTRA.cellsToAddModList cs_MeasObjectUTRA_cellsToAddModList_TDD( template (value) CellsToAddModListUTRA_TDD p_CellsToAddModListUTRA_TDD ) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    cellsToAddModListUTRA_TDD := p_CellsToAddModListUTRA_TDD
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectUTRA(ARFCN_ValueUTRA p_CarrierFreq,
                                                                              template (omit) Q_OffsetRangeInterRAT p_OffsetFreq,
                                                                              template (omit) CellIndexList p_CellsToRemoveList,
                                                                              template (omit) MeasObjectUTRA.cellsToAddModList p_CellsToAddModList,
                                                                              template (omit) MeasObjectUTRA.cellForWhichToReportCGI p_CellForWhichToReportCGI) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    measObjectUTRA := {
      carrierFreq := p_CarrierFreq,
      offsetFreq := p_OffsetFreq,
      cellsToRemoveList := p_CellsToRemoveList,
      cellsToAddModList := p_CellsToAddModList,
      cellForWhichToReportCGI := p_CellForWhichToReportCGI,
      csg_allowedReportingCells_v930 := omit,   /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reducedMeasPerformance_r12 := omit        /* @sic BASELINE MOVING 2015 sic@ */
    }
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectUTRA_FDD(ARFCN_ValueUTRA p_CarrierFreq,
                                                                                  PhysCellIdUTRA_FDD p_PhysCellIdUTRA_FDD) :=
  { /* @status    APPROVED (LTE_IRAT, LTE_A_IRAT) */
    measObjectUTRA := {
      carrierFreq := p_CarrierFreq,
      offsetFreq := 0,
      cellsToRemoveList := omit,
      cellsToAddModList := cs_MeasObjectUTRA_cellsToAddModList_FDD(cs_CellsToAddModListUTRA_FDD_1Entry(1, p_PhysCellIdUTRA_FDD)),
      cellForWhichToReportCGI := omit,
      csg_allowedReportingCells_v930 := omit,   /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reducedMeasPerformance_r12 := omit        /* @sic BASELINE MOVING 2015 sic@ */
    }
  }; //@sic R5s170597 sic@

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectUTRA_TDD(ARFCN_ValueUTRA p_CarrierFreq,
                                                                                  PhysCellIdUTRA_TDD p_PhysCellIdUTRA_TDD) :=
  { /* @status    APPROVED (LTE_A_IRAT, LTE_IRAT) */
    measObjectUTRA := {
      carrierFreq := p_CarrierFreq,
      offsetFreq := 0,
      cellsToRemoveList := omit,
      cellsToAddModList := cs_MeasObjectUTRA_cellsToAddModList_TDD(cs_CellsToAddModListUTRA_TDD_1Entry(1, p_PhysCellIdUTRA_TDD)),
      cellForWhichToReportCGI := omit,
      csg_allowedReportingCells_v930 := omit,   /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      reducedMeasPerformance_r12 := omit        /* @sic BASELINE MOVING 2015 sic@ */
    }
  }; //@sic R5s170597 sic@

  template (value) ReportConfigToAddModList cs_ReportConfigToAddModList_1Entry(ReportConfigId p_ReportConfigId,
                                                                               template (value) ReportConfigToAddMod_ReportConfig_Type p_ReportConfig) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    {
      reportConfigId := p_ReportConfigId,
      reportConfig   := p_ReportConfig
    }
  };

  template (value) ReportConfigToAddModList cs_ReportConfigToAddModList_2Entries(ReportConfigId p_ReportConfigId_1,
                                                                                 template (value) ReportConfigToAddMod_ReportConfig_Type p_ReportConfig_1,
                                                                                 ReportConfigId p_ReportConfigId_2,
                                                                                 template (value) ReportConfigToAddMod_ReportConfig_Type p_ReportConfig_2) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT) */
    {
      reportConfigId := p_ReportConfigId_1,
      reportConfig   := p_ReportConfig_1
    },
    {
      reportConfigId := p_ReportConfigId_2,
      reportConfig   := p_ReportConfig_2
    }
  };

  template (value) ReportConfigEUTRA_Trigger_Type cs_ReportConfigEUTRA_Trigger_Event(template (value) ReportConfigEUTRA_Trigger_EventId_Type p_EventId,
                                                                                     integer p_Hysteresis,
                                                                                     TimeToTrigger p_TimeToTrigger) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    event := {
      eventId := p_EventId,
      hysteresis := p_Hysteresis,
      timeToTrigger := p_TimeToTrigger
    }
  };

  template (value) ReportConfigToAddMod_ReportConfig_Type cs_ReportConfig_reportConfigEUTRA(template (value) ReportConfigEUTRA_Trigger_Type p_Trigger,
                                                                                            ReportConfigEUTRA.triggerQuantity p_TriggerQuantity,
                                                                                            ReportConfigEUTRA.reportQuantity p_ReportQuantity,
                                                                                            integer p_MaxReportCells,
                                                                                            ReportInterval p_ReportInterval,
                                                                                            ReportConfigEUTRA.reportAmount p_ReportAmount,
                                                                                            template (omit) ReportConfigEUTRA.si_RequestForHO_r9 p_Si_RequestForHO_r9 := omit,
                                                                                            template (omit) ReportConfigEUTRA.ue_RxTxTimeDiffPeriodical_r9 p_Ue_RxTxTimeDiffPeriodical_r9 := omit,
                                                                                            template (omit) ReportConfigEUTRA.includeLocationInfo_r10 p_IncludeLocationInfo_r10 := omit,
                                                                                            template (omit) ReportConfigEUTRA.reportAddNeighMeas_r10 p_ReportAddNeighMeas_r10 := omit,
                                                                                            template (omit) ReportConfigEUTRA.alternativeTimeToTrigger_r12 p_AlternativeTimeToTrigger_r12 := omit,
                                                                                            template (omit) boolean p_UseT312_r12 := omit,
                                                                                            template (omit) boolean p_UsePSCell_r12 := omit,
                                                                                            template (omit) RSRQ_RangeConfig_r12 p_AN_Threshold1_v1250 := omit,
                                                                                            template (omit) RSRQ_RangeConfig_r12 p_A5_Threshold2_v1250 := omit,
                                                                                            template (omit) boolean p_ReportStrongestCSI_RSs_r12 := omit,
                                                                                            template (omit) boolean p_ReportCRS_Meas_r12 := omit,
                                                                                            template (omit) boolean p_TriggerQuantityCSI_RS_r12 := omit,
                                                                                            template (omit) UL_DelayConfig_r13 p_UL_DelayConfig_r13 := omit) := // @sic R5-171505 sic@
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    /* @sic R5s160711 BASELINE MOVING 2016: cs_ReportConfig_reportConfigEUTRA replacing cs_ReportConfig_reportConfigEUTRA_event with parameter p_Trigger sic@ */
    /* @sic R5s160711 BASELINE MOVING 2016: additional parameters for R12 sic@ */
    reportConfigEUTRA := {
      triggerType := p_Trigger,
      triggerQuantity := p_TriggerQuantity,
      reportQuantity := p_ReportQuantity,
      maxReportCells := p_MaxReportCells,
      reportInterval := p_ReportInterval,
      reportAmount := p_ReportAmount,
      si_RequestForHO_r9 := p_Si_RequestForHO_r9,                           /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      ue_RxTxTimeDiffPeriodical_r9 := p_Ue_RxTxTimeDiffPeriodical_r9,       /* @sic R5s110176 BASELINE MOVING 2011 sic@ */
      includeLocationInfo_r10 := p_IncludeLocationInfo_r10,
      reportAddNeighMeas_r10 := p_ReportAddNeighMeas_r10,
      alternativeTimeToTrigger_r12 := p_AlternativeTimeToTrigger_r12,       /* @sic BASELINE MOVING 2015 sic@ */
      useT312_r12 := p_UseT312_r12,                                         /* @sic BASELINE MOVING 2015 sic@ */
      usePSCell_r12 := p_UsePSCell_r12,                                     /* @sic BASELINE MOVING 2015 sic@ */
      aN_Threshold1_v1250 := p_AN_Threshold1_v1250,                         /* @sic BASELINE MOVING 2015 sic@ */
      a5_Threshold2_v1250 := p_A5_Threshold2_v1250,                         /* @sic BASELINE MOVING 2015 sic@ */
      reportStrongestCSI_RSs_r12 := p_ReportStrongestCSI_RSs_r12,           /* @sic BASELINE MOVING 2015 sic@ */
      reportCRS_Meas_r12 := p_ReportCRS_Meas_r12,                           /* @sic BASELINE MOVING 2015 sic@ */
      triggerQuantityCSI_RS_r12 := p_TriggerQuantityCSI_RS_r12,             /* @sic BASELINE MOVING 2015 sic@ */
      reportSSTD_Meas_r13 := omit,                                          /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      rs_sinr_Config_r13 := omit,                                           /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      useAllowedCellList_r13 := omit,                                       /* @sic R5s160711 BASELINE MOVING 2016 R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
