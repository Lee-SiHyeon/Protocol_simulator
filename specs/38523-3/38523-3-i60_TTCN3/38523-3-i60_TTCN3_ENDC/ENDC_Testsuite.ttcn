  //----------------------------------------------------------------------------
  testcase TC_10_2_1_1_ENDC() runs on MTC_ENDC system SYSTEM_ENDC {
    // @purpose
    //   Default EPS bearer context activation
    var ENDC_NR_PTC      v_ENDC_NR    := null;
    var EUTRA_5GS_PTC    v_EUTRA_5GS  := null;
    var IMS_PTC          v_IMS1       := null;
    var IMS_PTC          v_IMS2       := null;
  
    timer t_GuardTimer := int2float(300);
  
    v_ENDC_NR := ENDC_NR_PTC.create("ENDC_NR") alive;
    v_EUTRA_5GS := EUTRA_5GS_PTC.create("EUTRA_5GS") alive;
  
    f_MTC_ConnectPTCs_ENDC(system, v_ENDC_NR, v_EUTRA_5GS, v_IMS1, v_IMS2);
  
    v_ENDC_NR.start(f_TC_10_2_1_1_ENDC_NR());
    v_EUTRA_5GS.start(f_TC_10_2_1_1_ENDC_EUTRA());
  
    t_GuardTimer.start;
  
    f_MTC_MainLoop_ENDC(t_GuardTimer);
  }
