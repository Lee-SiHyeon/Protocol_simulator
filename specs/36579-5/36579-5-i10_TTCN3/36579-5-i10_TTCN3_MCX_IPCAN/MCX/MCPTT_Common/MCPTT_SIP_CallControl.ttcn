module MCPTT_SIP_CallControl {

  import from CommonDefs all;
  import from IMS_Component all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_SIP_Templates all;
  import from LibSip_MessageBodyTypes all;
  import from LibSip_SDPTypes all;
  import from MCPTT_MediaControl_Procedures all;
  import from MCPTT_MediaControl_Templates all;
  import from MCX_CommonDefs all;
  import from MCX_IMS_CommonProcedures all;
  import from MCX_IMS_Component all;
  import from MCX_MIME_Functions all;
  import from MCX_MediaControl_Common all;
  import from MCX_SDP_MCPTT_MCVideo all;
  import from MCX_SIP_CallControl_Common all;
  import from MCX_SIP_CallControl_MCPTT_MCVideo all;
  import from MCX_XML_mcptt_info all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Initiate MO Call (wrapper function for MCPTT)
   * @param     p_MMI_String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_CallSetupMO_InitiateCall(charstring p_MMI_String) runs on IMS_PTC
  {
    f_MCPTT_MCVideo_CallSetupMO_InitiateCall(MCPTT, p_MMI_String);
  }

  /*
   * @desc      If requested in the SDP offer and noted but not implicitly granted,
   *            an explicit grant is given to the UE
   * @param     p_MediaControlConditionSdpOffer
   * @param     p_MediaControlConditionSdpAnswer
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_AckRequest        (default value: ACK_NOT_REQUIRED)
   * @status    APPROVED (MCX)
   */
  function fl_MCPTT_CallSetupMO_InitialGrant(MCX_MediaControlCondition_Type p_MediaControlConditionSdpOffer,
                                             MCX_MediaControlConditionSdpAnswer_Type p_MediaControlConditionSdpAnswer,
                                             MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                             MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_NOT_REQUIRED) runs on MCX_IMS_PTC
  {
    if (p_MediaControlConditionSdpOffer == withImplictGrantRequest) {                   // implicit floor request ...
      select (p_MediaControlConditionSdpAnswer) {
        case (implicitRequestGranted, implicitRequestRejected) {                        // ... with implicit floor granted or not accepted by the server
          // do nothing
        }
        case (implicitRequestNoted) {                                                   // ... without implicit floor granted (-> Table 5.3A.6.3-1)
          f_MCPTT_FloorControl_SendFloorGranted(p_PriorityCallType, p_AckRequest);
        }
      }
    }
  }

  /*
   * @desc      36.579-1 Table 5.3A.1.3-1: MCPTT CO session establishment/modification without provisional responses other than 100 Trying
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_CommencementMode  (default value: AUTOMATIC)
   * @param     p_MediaControlConditionSdpOffer (default value: withoutImplictGrantRequest)
   * @param     p_MediaControlConditionSdpAnswer (default value: implicitRequestNoted)
   * @return    IMS_InviteRequestWithSdp_Type
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_CallSetupMO_100TryingOnly(MCX_CallType_Type p_CallType,
                                             MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                             MCX_CommencementMode_Type p_CommencementMode := AUTOMATIC,
                                             MCX_MediaControlCondition_Type p_MediaControlConditionSdpOffer := withoutImplictGrantRequest,
                                             MCX_MediaControlConditionSdpAnswer_Type p_MediaControlConditionSdpAnswer := implicitRequestNoted) runs on MCX_IMS_PTC return IMS_InviteRequestWithSdp_Type
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    v_InviteRequestWithSdp := f_MCPTT_MCVideo_CallSetupMO_100TryingOnly(MCPTT, p_CallType, p_PriorityCallType, p_CommencementMode, p_MediaControlConditionSdpOffer, p_MediaControlConditionSdpAnswer);

    fl_MCPTT_CallSetupMO_InitialGrant(p_MediaControlConditionSdpOffer, p_MediaControlConditionSdpAnswer, p_PriorityCallType);

    return v_InviteRequestWithSdp;
  }

  /*
   * @desc      36.579-1 clause 5.3A.6 Generic Test Procedure for MCPTT CO session modification with implicit Floor Control
   * @param     p_CallType
   * @param     p_PriorityCallType
   * @param     p_MediaControlConditionSdpOffer (default value: withImplictGrantRequest)
   * @param     p_MediaControlConditionSdpAnswer (default value: implicitRequestNoted)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_SessionModificationCO_Upgrade(MCX_CallType_Type p_CallType,
                                                 MCX_PriorityCallType_Type p_PriorityCallType,
                                                 MCX_MediaControlCondition_Type p_MediaControlConditionSdpOffer := withImplictGrantRequest,
                                                 MCX_MediaControlConditionSdpAnswer_Type p_MediaControlConditionSdpAnswer := implicitRequestNoted) runs on MCX_IMS_PTC
  {
    var template (present) MCX_MIME_XmlBodies_Type v_XmlBodies := f_MCPTT_MCVideo_InviteMO_XmlBodies_Init(MCPTT, p_CallType, p_PriorityCallType);

    f_MCPTT_MCVideo_ReInviteMO(MCPTT, p_CallType, p_PriorityCallType, p_MediaControlConditionSdpOffer, p_MediaControlConditionSdpAnswer, v_XmlBodies);
    fl_MCPTT_CallSetupMO_InitialGrant(p_MediaControlConditionSdpOffer, p_MediaControlConditionSdpAnswer, p_PriorityCallType, ACK_REQUIRED);
  }

  /*
   * @desc      Client terminated session modification
   * @param     p_SessionModificationType
   * @param     p_SessionType       (default value: ON_DEMAND)
   * @param     p_CallType
   * @param     p_PriorityCallType
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_SessionModificationCT(MCX_SessionModificationType_Type p_SessionModificationType,
                                         MCX_SessionType_Type p_SessionType := ON_DEMAND,
                                         MCX_CallType_Type p_CallType,
                                         MCX_PriorityCallType_Type p_PriorityCallType) runs on MCX_IMS_PTC
  { /* NOTE: C1-238283 has added for Rel-18 in 24.379 the requirement that
     *       "if the MCPTT client is requesting an upgrade (resp. downgrade) of an already established session to (resp. from) emergency or imminent peril and if multiplexing of media streams was used,
     *        the MCPTT client should select a different port number not to impact the resource priority used for the other multiplexed media streams"
     *       => as there is no statement that otherwise the client shall not change the port number, it may need to be considered that a client changes the port number for every upgrade/downgrade (to be monitored) */
    var template (value) SDP_Message v_SDP_Message := f_MCX_SdpOffer_TX(MCPTT, p_SessionType, p_CallType);
    var template (value) MCX_MIME_XmlBodies_Type v_XmlBodies;
    var MCX_PriorityCallType_Type v_PriorityCallType;

    select (p_SessionModificationType) {
      case (UPGRADE) {
        v_PriorityCallType := p_PriorityCallType;
        v_XmlBodies := f_MCPTT_MCVideo_InviteMT_XmlBodies_Init(MCPTT, p_CallType, p_PriorityCallType);
      }
      case (DOWNGRADE) {
        v_PriorityCallType := NORMAL_CALL;
        v_XmlBodies := f_MCPTT_MCVideo_InviteMT_XmlBodies_Init(MCPTT, p_CallType, NORMAL_CALL);
        select (p_PriorityCallType) {
          case (EMERGENCY_CALL) {
            v_XmlBodies.McpttInfo.mcptt_Params.emergency_ind := cs_MCPTT_Content_Boolean(false);
            v_XmlBodies.McpttInfo.mcptt_Params.alert_ind := cs_MCPTT_Content_Boolean(false);
          }
          case (IMMPERIL_CALL) {
            v_XmlBodies.McpttInfo.mcptt_Params.imminentperil_ind := cs_MCPTT_Content_Boolean(false);
          }
          case else {
            FatalError(__FILE__, __LINE__, "");
          }
        }
      }
    }

    f_MCPTT_MCVideo_ReInviteMT(MCPTT, p_SessionType, p_CallType, v_PriorityCallType, v_SDP_Message, v_XmlBodies);
  }

  /*
   * @desc      MT call release with BYE containing mcptt-info with release-reason>
   * @param     p_ReleaseReason
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_CallReleaseMT_WithReleaseReason(MCPTT_Info_ReleaseReason_Type p_ReleaseReason) runs on MCX_IMS_PTC
  {
    var template (value) MCPTT_Info_Type v_McpttInfo;
    var template (value) McpttInfoExt_ElementList_Type v_McpttInfoExt := { crs_McpttInfoExt_ReleaseReason(p_ReleaseReason) };
    var template (value) MessageBody v_MessageBody;

    v_McpttInfo := f_MCX_CallControl_MCPTTInfo_TX();
    v_McpttInfo.mcptt_Params.anyExt := f_MCX_McpttInfoExt_Encode(v_McpttInfoExt);
    v_MessageBody := f_MCX_MIME_MessageBodyTX(MCPTT, -, -, v_McpttInfo);
    f_MCX_CallReleaseMT(-, cs_ContentTypeMIME(tsc_MCX_MIME_Boundary), v_MessageBody);
  }

  /*
   * @desc      Start IPCAN, MMI
   * @param     p_MMI_String
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_PreestablishedSession_InitiateCallUsingPreestablishedSession(charstring p_MMI_String) runs on IMS_PTC
  {
    f_MCX_IPCAN_StartSignalling(IPCAN_MO_SpeechCall);  // IPCAN_MO_SpeechCall is as good as IPCAN_MO_IMS_Signalling
    f_UT_MCX_UserAction(MMI, p_MMI_String);
  }

  /*
   * @desc      36.579-1 clause 5.3A.3: Generic Test Procedure for MCPTT CO call establishment using a pre-established session
   * @param     p_ServiceType
   * @param     p_CallType
   * @param     p_PriorityCallType  (default value: NORMAL_CALL)
   * @param     p_SessionId         (default value: tsc_MCX_SessionID_B)
   * @param     p_CommencementMode  (default value: NONE)
   * @param     p_McpttInfo         (default value: omit)
   * @param     p_McpttInfoExtElementList   (default value: omit)
   * @param     p_SdpInfoRX         (default value: omit)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_PreestablishedSession_CallSetupMO(MCX_ServiceType_Type p_ServiceType,
                                                     MCX_CallType_Type p_CallType,
                                                     MCX_PriorityCallType_Type p_PriorityCallType := NORMAL_CALL,
                                                     charstring p_SessionId := tsc_MCX_SessionID_B,
                                                     MCX_CommencementMode_Type p_CommencementMode := NONE,
                                                     template MCPTT_Info_Type p_McpttInfo := omit,
                                                     template McpttInfoExt_ElementList_Type p_McpttInfoExtElementList := omit,
                                                     template MCPTT_MCVideo_SdpInfoRX_Type p_SdpInfoRX := omit) runs on MCX_IMS_PTC
  {
    // Step 2 - 3
    f_MCPTT_MCVideo_PreestablishedSession_CallSetupMO_ReceiveREFER_Send200OK(p_ServiceType,
                                                                             p_CallType,
                                                                             p_PriorityCallType,
                                                                             p_SessionId,
                                                                             p_CommencementMode,
                                                                             p_McpttInfo,
                                                                             p_McpttInfoExtElementList,
                                                                             -,
                                                                             -,
                                                                             p_SdpInfoRX);
    // Step 4 - 5
    f_MCPTT_PreestablishedSession_Connect(p_CallType);
  }

  /*
   * @desc      36.579-1 clause 5.3A.8: Generic Test Procedure for MCX CT Call establishment automatic commencement using a pre-established session
   * @param     p_CallType
   * @param     p_AnswerStateValue  (default value: tsc_MCPTT_PreestablishedSessionControl_AnswerState_Confirmed)
   * @param     p_AckRequest        (default value: ACK_REQUIRED)
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_PreestablishedSession_CallSetupMT(MCX_CallType_Type p_CallType,
                                                     O2_Type p_AnswerStateValue := tsc_MCPTT_PreestablishedSessionControl_AnswerState_Confirmed,
                                                     MCX_MediaControl_AckRequest_Type p_AckRequest := ACK_REQUIRED) runs on MCX_IMS_PTC
  {
    f_MCX_IPCAN_StartSignalling(IPCAN_MT_SpeechCall);
    f_MCPTT_MCVideo_CallSetup_ConfigSRTP(MCPTT, p_CallType, IPCAN_MT_SpeechCall);
    f_MCPTT_PreestablishedSession_Connect(p_CallType, p_AnswerStateValue, -, -, p_AckRequest);
  }

  /*
   * @desc      36.579-1 clause 5.3A.5: Generic Test Procedure for MCX CT call release keeping the pre-established session
   * @param     p_CallType
   * @status    APPROVED (MCX)
   */
  function f_MCPTT_PreestablishedSession_CallReleaseMT(MCX_CallType_Type p_CallType) runs on MCX_IMS_PTC
  {
    f_MCPTT_PreestablishedSession_Disconnect(p_CallType);
    f_MCX_IPCAN_ReleaseConnection(IPCAN_MT_IMS_Signalling);   // IPCAN_MT_IMS_Signalling: only the RRC connection gets released but the EPS bearers are kept
  }

}
