module Emergency_IRAT_NR5GC_IMS {

  import from CommonDefs all;
  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Common all;
  import from IMS_Procedures_Registration all;
  import from IMS_SIP_Templates all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.11.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_4_11_NR5GC_IMS1()runs on IMS_PTC
  {
    var IMS_DATA_REQ v_IMS_REGISTER_REQ_ByRef;
    var IMS_IPCAN_Coordination_MSG v_IMS_IPCAN_CoordMsg;
    var template (present) SipUrl v_SipUrl;
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    f_IMS_GlobalRelease();
    
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN);
    f_IMS_Registration(OtherIPCAN_E);
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN);
    
    // Wait for indication RAT has changed to NR
    IPCAN.receive(cmr_IPCAN_IMS_Response) -> value v_IMS_IPCAN_CoordMsg;
    f_IMS_PTC_SetRanType(v_IMS_IPCAN_CoordMsg.IPCAN_IMS_Response.IpcanInfo.RanType);

    v_SipUrl := cr_SipUri_HostPort(f_IMS_PTC_ImsInfo_GetHomeDomainName());

    alt {
      // @siclog "Step 5a1 Parallel Behaviour" siclog@
      [] a_IMS_ReceiveRequest(car_IMS_Register_Request(cr_REGISTER_Request(v_SipUrl)), v_IMS_REGISTER_REQ_ByRef) {

         IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ_ByRef.RoutingInfo),
                                     cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_IMS_REGISTER_REQ_ByRef.Request.Register))));
         repeat;
        
        }
      [] IPCAN.receive(cmr_IMS_IPCAN_Trigger("Stop Waiting For Reregister")) {}
    }

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.11.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_4_11_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session
    var INVITE_Request v_InviteRequest;
    var IMS_DATA_REQ v_IMS_REGISTER_REQ_ByRef;
    var IMS_IPCAN_Coordination_MSG v_IMS_IPCAN_CoordMsg;
    var template (present) SipUrl v_SipUrl;

    f_IMS_PTC_Init(PDN_2);

    //@siclog "Step 2-15B" siclog@
    f_IMS_EmergencyRegistration(-, -, OtherIPCAN_E);

    // @sic R5s220883 sic@
    // Emergency call setup: 34.229-1 Annex C.22
    v_InviteRequest := f_IMS_EmergencyCallSetup();
      
    // Inform EUTRA: IMS Call established
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN, cms_IMS_IPCAN_Trigger("Emergency Call Established"));
      
    //IMS call to be released.
    f_IMS_IPCAN_WaitForTrigger(OtherIPCAN, "Release Call");
      
    //Release Emergency Call MO
    f_IMS_EmergencyCallReleaseMO(v_InviteRequest);
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN, cms_IMS_IPCAN_Trigger("Call Released"));

            
    // Wait for indication RAT has changed to NR
    IPCAN.receive(cmr_IPCAN_IMS_Response) -> value v_IMS_IPCAN_CoordMsg;
    f_IMS_PTC_SetRanType(v_IMS_IPCAN_CoordMsg.IPCAN_IMS_Response.IpcanInfo.RanType);

    v_SipUrl := cr_SipUri_HostPort(f_IMS_PTC_ImsInfo_GetHomeDomainName());
    // Exception: Optional A.12
    alt {
      // @siclog "Step 3a1 Parallel Behaviour" siclog@
      [] a_IMS_ReceiveRequest(car_IMS_Register_Request(cr_REGISTER_Request(v_SipUrl)), v_IMS_REGISTER_REQ_ByRef) {

         IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_REGISTER_REQ_ByRef.RoutingInfo),
                                     cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_IMS_REGISTER_REQ_ByRef.Request.Register))));
         repeat;
        
        }
      [] IPCAN.receive(cmr_IMS_IPCAN_Trigger("Stop Waiting For Reregister")) {}
    }
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.4.12.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
   function f_TC_11_4_12_NR5GC_IMS2()runs on IMS_PTC
  { // Emergency PDU session

    var INVITE_Request v_InviteRequestEmergencyCall;

    f_IMS_PTC_Init(PDN_2);

    // Steps 1 to 4 of the generic procedure for IMS emergency registration (TS 34.229-1 C.20).
    f_IMS_EmergencyRegistration(-, -, OtherIPCAN_E);
    // Steps 1 to 5 of the generic procedure for IMS emergency speech call establishment (TS 34.229-1 C.22).
    v_InviteRequestEmergencyCall := f_IMS_EmergencyCallSetup();

    f_Delay( 1.0 );

    f_IMS_IPCAN_WaitForTrigger(OtherIPCAN); // @sic R5s221058 sic@
    //@siclog "Step 19" siclog@
    //Release IMS Call as specified in the generic procedure in TS 34.229-1 [35] subclause C.32.
    f_IMS_EmergencyCallReleaseMO(v_InviteRequestEmergencyCall, false);// @sic R5s221058 sic@

    // Inform NR: Emergency Call released.
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN, cms_IMS_IPCAN_Trigger("Call Released"));

  }

}
