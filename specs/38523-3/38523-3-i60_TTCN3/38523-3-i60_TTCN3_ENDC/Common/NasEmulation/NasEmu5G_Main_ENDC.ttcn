module NasEmu5G_Main_ENDC {

  import from CommonDefs all;
  import from NG_NAS_MsgContainers all;
  import from NR_ASP_SrbDefs all;
  import from NR_CommonDefs all;
  import from NasEmu5G_AspTypes_NR all;
  import from NasEmu5G_Component_NR_BASE all;

  template (present) NR_SRB_COMMON_REQ car_NR_SignallingAspFromTC :=
  { /* @status    APPROVED (ENDC) */
    Common := ?,
    Signalling := {
      Rrc := *,
      Nas := *
    }
  };

  template (value) NR_SRB_COMMON_IND cas_NR_SignallingAspToTC(template (value) NR_IndAspCommonPart_Type p_Common,
                                                              template (omit) NR_RRC_MSG_Indication_Type p_RrcMsg := omit,
                                                              template (omit) NG_NAS_MSG_IndicationList_Type p_NasMsg := omit) :=
  { /* @status    APPROVED (ENDC) */
    Common := p_Common,
    Signalling := {
      Rrc := p_RrcMsg,
      Nas := p_NasMsg
    }
  };

  template (present) NR_RRC_PDU_IND car_NR_PduFromSYS  :=
  { /* @status    APPROVED (ENDC) */
    Common := ?,
    RrcPdu := ?
  };

  template (value) NR_RRC_PDU_REQ cas_NR_PduToSYS(template (value) NR_ReqAspCommonPart_Type p_Common,
                                                  template (value) NR_RRC_MSG_Request_Type  p_RRC_MSG_Request) :=
  { /* @status    APPROVED (ENDC) */
    Common := p_Common,
    RrcPdu := p_RRC_MSG_Request
  };

  /*
   * @desc      Handling of ASPs coming from the test cases
   * @status    APPROVED (ENDC)
   */
  altstep a_AspFromTestcaseHandler_ENDC() runs on NASEMU_NR_BASE_PTC
  {
    var NR_SRB_COMMON_REQ v_AspFromTC;
    var NR_ReqAspCommonPart_Type v_ReqAspCommonPart;
    var NR_RRC_MSG_Request_Type v_RrcPduToSYS;

    [] TC_SRB.receive(car_NR_SignallingAspFromTC) -> value v_AspFromTC {

      v_ReqAspCommonPart := v_AspFromTC.Common;
      v_RrcPduToSYS := v_AspFromTC.Signalling.Rrc;

      SYS_SRB.send(cas_NR_PduToSYS(v_ReqAspCommonPart, v_RrcPduToSYS));
    }
  }

  /*
   * @desc      handling of ASPs containing an RRC PDU from the system adaptor
   * @status    APPROVED (ENDC)
   */
  altstep a_AspFromSystemAdaptorHandler_ENDC() runs on NASEMU_NR_BASE_PTC
  {
    var NR_RRC_PDU_IND v_AspFromSYS;
    var template (value) NR_SRB_COMMON_IND v_SRB_COMMON_IND;

    [] SYS_SRB.receive(car_NR_PduFromSYS) -> value v_AspFromSYS {
      v_SRB_COMMON_IND := cas_NR_SignallingAspToTC(v_AspFromSYS.Common, v_AspFromSYS.RrcPdu);
      TC_SRB.send(v_SRB_COMMON_IND);
    }
  }

  /*
   * @desc      NAS emulation main loop (started by the MTC)
   * @status    APPROVED (ENDC)
   */
  function f_NASEMU_MainLoop_ENDC() runs on NASEMU_NR_BASE_PTC
  {
    while (true) {
      alt {
        [] a_AspFromTestcaseHandler_ENDC();
        [] a_AspFromSystemAdaptorHandler_ENDC();
        [] any port.receive {
          f_SetVerdictInconc(__FILE__, __LINE__, "unexpected message (skipped)");
        }
      }
    }
  }

}
