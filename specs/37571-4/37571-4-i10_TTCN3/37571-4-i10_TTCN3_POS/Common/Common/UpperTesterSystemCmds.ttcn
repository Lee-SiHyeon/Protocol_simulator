  template (value) Ut_System_Cmd_Type cs_AT_TIMEZONE_SUBSCRIBE (Ut_ParameterList_Type p_ParamList) :=                 /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_AT_Cmd("AT+CTZR=" & p_ParamList[0].Value & "<CR>");

  template (value) Ut_System_Cmd_Type cs_AT_TIMEZONE_UPDATE (Ut_ParameterList_Type p_ParamList) :=                    /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */
    cs_AT_Cmd("AT+CTZU=" & p_ParamList[0].Value & "<CR>");

  template (value) Ut_System_Cmd_Type cs_AT_DIAL_CALL (charstring p_Dial) :=                                          /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN)  @sic R5s110489, R5s150980 sic@ */
    cs_AT_Cmd("ATD"&p_Dial&"<CR>");

  template (value) Ut_System_Cmd_Type cs_AT_IMS_VOICE_CALL (charstring p_URI)  :=
    cs_AT_Cmd("AT+CDU=1,"& p_URI & "<CR>");                                                                           /* @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NBIOT, NR5GC, NR5GC_IRAT, POS, SSNITZ, UTRAN) */

