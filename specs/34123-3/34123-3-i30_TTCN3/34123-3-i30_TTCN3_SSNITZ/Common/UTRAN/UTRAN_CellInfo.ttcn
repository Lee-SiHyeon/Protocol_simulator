  }

  /*
   * @desc      Function that returns the U_RNTI
   * @param     p_CellId
   * @return    U_RNTI
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
  function f_UTRAN_CellInfo_GetU_RNTI(UTRAN_CellId_Type p_CellId) runs on UTRAN_PTC return U_RNTI
  {
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_CellId);
    return v_CellInfo.uRNTI;
  }

  /*
   * @desc      Function that returns the PICH Power Offset
   * @param     p_CellId
   * @return    PICH_PowerOffset
   * @status    APPROVED (IMS, IMS_IRAT, LTE_A_IRAT, LTE_IRAT, POS, SSNITZ, UTRAN)
   */
