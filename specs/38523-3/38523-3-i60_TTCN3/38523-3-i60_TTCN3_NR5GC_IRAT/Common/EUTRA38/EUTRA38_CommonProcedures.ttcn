      mobileIAB_Freq_r18               := omit
  };

  /*
   * @desc      Get P_Max value based on PICS
   * @return    template (omit) P_Max
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function fl_NR_GetP_Max () return template (omit) P_Max
  { // @sic R5-190721 R5-211891 sic@
    var template (omit) P_Max v_P_Max := omit;
    
    if (pc_dynamicPowerSharingENDC){ //@sic R5s190064 sic@
      //SIG AND EN-DC AND pc_dynamicPowerSharingENDC
      v_P_Max := 23;
    } else {
      //SIG AND EN-DC AND (NOT pc_dynamicPowerSharingENDC)
      v_P_Max := 20;
    }
    return v_P_Max;
  }

  /*
   * @desc      convert integer to EUTRA ASN.1 from co-ord message to CarrierFreqNR_r15.subcarrierSpacingSSB_r15
   *            3 types are defined separately in the EUTRA ASN.1 definitions, but with the same values
   *            therefore we need 3 different conversion functions!
   * @param     p_IntegerValue
   * @return    CarrierFreqNR_r15.subcarrierSpacingSSB_r15
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR_ConvertIntToSCS_CarrierFreqNR(integer p_IntegerValue) return CarrierFreqNR_r15.subcarrierSpacingSSB_r15
  {
    var CarrierFreqNR_r15.subcarrierSpacingSSB_r15 v_ASN1Value;
    select (p_IntegerValue) {
      case (15) {
        v_ASN1Value := kHz15;
      }
      case (30) {
        v_ASN1Value := kHz30;
      }
      case (120) {
        v_ASN1Value := kHz120;
      }
      case (240) {
        v_ASN1Value := kHz240;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid SCS value");
      }
    }
    return v_ASN1Value;
  }

  /*
   * @desc      convert integer to EUTRA ASN.1 from co-ord message to CarrierFreqNR_r15.subcarrierSpacingSSB_r15
   *            3 types are defined separately in the EUTRA ASN.1 definitions, but with the same values
   *            therefore we need 3 different conversion functions!
   * @param     p_IntegerValue
   * @return    CarrierInfoNR_r15.subcarrierSpacingSSB_r15
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_NR_ConvertIntToSCS_CarrierInfoNR(integer p_IntegerValue) return CarrierInfoNR_r15.subcarrierSpacingSSB_r15
  {
    var CarrierInfoNR_r15.subcarrierSpacingSSB_r15 v_ASN1Value;
    select (p_IntegerValue) {
      case (15) {
        v_ASN1Value := kHz15;
      }
      case (30) {
        v_ASN1Value := kHz30;
      }
      case (120) {
        v_ASN1Value := kHz120;
      }
      case (240) {
        v_ASN1Value := kHz240;
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid SCS value");
      }
    }
    return v_ASN1Value;
  }

  /*
   * @desc      Sets the cell power attenuation and stores the value in the EUTRA_CellInfo
   * @param     p_CellId
   * @param     p_NewPowerLevel_FR1   absolute (negative) value as specified in the test prose for FR1
   * @param     p_NewPowerLevel_FR2   absolute (negative) value as specified in the test prose for FR2
   * @param     p_TimingInfo        (default value: cs_TimingInfo_Now)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_SetCellPower(EUTRA_CellId_Type p_CellId,
                                  AbsoluteCellPower_Type p_NewPowerLevel_FR1,
                                  AbsoluteCellPower_Type p_NewPowerLevel_FR2,
                                  template (value) TimingInfo_Type p_TimingInfo := cs_TimingInfo_Now) runs on EUTRA_5GS_PTC
  {
    var template (value) CellPowerList_Type v_CellPowerList;
    var EUTRA_CellId_Type v_ReferenceCellId;

    if (f_EUTRA38_NR_TestEnvironment_Get() == Conducted) {  // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
      v_CellPowerList := { cs_CellPower(p_CellId, p_NewPowerLevel_FR1) };
    } else {
      v_CellPowerList := { cs_CellPower(p_CellId, p_NewPowerLevel_FR2) };
    }
    if (f_TimingInfo_IsNow(p_TimingInfo)) {
      v_ReferenceCellId := eutra_Cell_NonSpecific;
    } else {
      v_ReferenceCellId := p_CellId;
    }
    f_EUTRA_SetCellPowerList(v_CellPowerList, p_TimingInfo, v_ReferenceCellId);
  }

  /*
   * @desc      protocol configuration options for condition Interworking_with_5GS in 36.508 Table 4.7.3-6
   *            NOTE: this function uses NG_NAS_Templates/TypeDefs and therefore it shall not be used by legacy LTE test cases
   * @param     p_CellId
   * @param     p_IMS_PDN_ConnEstab
   * @param     p_EpsBearerId      (default value: 'C'H)
   *             .. - values hardcoded for ENDC
   * @param     p_InterworkWithEPS (default value: true)
   *             ..  - as this is only called after ueNetworkCapability has been checked for N1 support, this should always be true
   * @param     p_IwkN26           (default value: NOT_SUPPORTED)
   * @param     p_PDN_Type         (default value: None)
   * @return    template (value) NAS_ProtocolConfigOptions_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_AdditionalProtocolConfigOptions(EUTRA_CellId_Type p_CellId,
                                                        boolean p_IMS_PDN_ConnEstab,
                                                        EPS_BearerIdentity p_EpsBearerId := 'C'H,
                                                        boolean p_InterworkWithEPS := true,
                                                        InterworkWithoutN26 p_IwkN26 := NOT_SUPPORTED,
                                                        PDU_PDN_DNN_Type p_PDN_Type := None) runs on EUTRA_PTC return template (value) NAS_ProtocolConfigOptions_Type
  {
    var template (value) NAS_ProtocolConfigOptions_Type v_AdditionalProtocolConfigOptions := {};
    var template (value) QoS_RuleList v_QoS_RuleList;
    var template (value) QoS_FlowList v_QoS_Flows;
    var template (value) NAS_ProtocolConfigOptions_Type v_ProtocolConfigOptions := {};
    
    if (not (p_IwkN26 == SUPPORTED and p_PDN_Type == Emergency_PDN)) { // @sic R5s220883 sic@
      // Don't add anything if w/o N26 supported and emergency PDN
      v_ProtocolConfigOptions := {
      cs_ProtocolContainer('001B'O, '01'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))),  // @sic R5s201102, R5-204488 sic@
      cs_ProtocolContainer('001B'O, '02'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))), // @sic R5-221467 default now contains 4 SSTs sic@
      cs_ProtocolContainer('001B'O, '03'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId))),
      cs_ProtocolContainer('001B'O, '04'O & f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (p_CellId)))
      };
      
      if (p_IwkN26 == NOT_SUPPORTED) { // @sic R5-221406 sic@
        if (p_IMS_PDN_ConnEstab) {
          v_QoS_RuleList := { f_BuildDefaultQoSRule ("2") };    // QoS rules according to TS 38.508-1 [67] Table 4.8.2.1-2  // @sic R5-202585 sic@
          v_QoS_Flows := { cs_QoS_Flow2 (p_InterworkWithEPS, '50'O)};  // @sic R5-204488 sic@ Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-2.  BearerId hardcoded to 5 for IMS
          if (p_PDN_Type == Emergency_PDN) { // @sic R5s230883 sic@
            v_QoS_Flows := { cs_QoS_Flow2 (p_InterworkWithEPS, hex2oct(p_EpsBearerId & '0'H))};  // Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-2.  BearerId different to 5 for emergency PDN
          }
        } else {
          v_QoS_RuleList := { f_BuildDefaultQoSRule ("1") };    // QoS rules according to TS 38.508-1 [67] Table 4.8.2.1-1  // @sic R5-202585 sic@
          v_QoS_Flows := { cs_QoS_Flow1 (p_InterworkWithEPS, hex2oct(p_EpsBearerId & '0'H))};  // @sic R5-204488 sic@ Qos flow descriptions refer to TS 38.508-1 [67] 4.8.2.3-1
        }
        v_AdditionalProtocolConfigOptions := {
        cs_ProtocolContainer('001D'O, bit2oct(encvalue(cs_Session_AMBR(omit, '05'O, '0004'O, '05'O, '0004'O)))),
        cs_ProtocolContainer('001C'O, bit2oct(encvalue(v_QoS_RuleList))),
        cs_ProtocolContainer('001F'O, bit2oct(encvalue(v_QoS_Flows)))};
      }
    }
    
    v_ProtocolConfigOptions := v_ProtocolConfigOptions & v_AdditionalProtocolConfigOptions; // restructured to avoid tool error
    return v_ProtocolConfigOptions;
  }

  /*
   * @desc      Send UECapabilityEnquiry message and receives UECapabilityInformation message.
   *            The received UE Capabilities are decoded and stored in the structure for the Mobile Info.
   * @param     p_CellId
   * @param     p_RRC_TI
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_Capability(EUTRA_CellId_Type p_CellId,
                                        RRC_TransactionIdentifier p_RRC_TI) runs on EUTRA_5GS_PTC
  {
    var SRB_COMMON_IND v_ReceivedAspForUeCapabilityInfo;
    var octetstring v_NRCapability;
    var octetstring v_ENDCCapability;
    var octetstring v_NR_MRDC_Freqs;
    
    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (int2oct(f_EUTRA_CellInfo_GetBand (p_CellId), 1), "EUTRA Band"));
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "MRDC_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15(p_RRC_TI, cs_UE_CapabilityRequest_EUTRA_ENDC, v_NR_MRDC_Freqs)));
        SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_UeCapabilityInformation_Any(p_RRC_TI)))
          -> value v_ReceivedAspForUeCapabilityInfo;
      }
      case (NR_SA) { // @sic R5s200369 sic@
        v_NR_MRDC_Freqs := f_EUTRA_NR_WaitForCoOrd_Data(NR, "NR_Freq");
        
        SRB.send(cas_SRB1_RrcPdu_REQ(p_CellId, cs_TimingInfo_Now, cs_508_UeCapabilityEnquiry_MRDC_r15(p_RRC_TI, cs_UE_CapabilityRequest_NR, v_NR_MRDC_Freqs)));
        SRB.receive(car_SRB1_RrcPdu_IND(p_CellId, cr_UeCapabilityInformation_Any(p_RRC_TI)))
          -> value v_ReceivedAspForUeCapabilityInfo;
      }
      // To be extended for other options
    }
    
    // Decode and store the ueCapabilitiesRAT-Container
    v_NRCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[0].ueCapabilityRAT_Container;
    select (f_EUTRA38_NR_Config_Get()) {
      case (EN_DC) {
        v_ENDCCapability := v_ReceivedAspForUeCapabilityInfo.Signalling.Rrc.Dcch.message_.c1.ueCapabilityInformation.criticalExtensions.c1.ueCapabilityInformation_r8.ue_CapabilityRAT_ContainerList[1].ueCapabilityRAT_Container;
        // Send NR capabilities to NR PTC
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_ENDCCapability, "ENDCCap"));
      }
      case (NR_SA) { // @sic R5s200369 sic@
        // Send NR capabilities to NR PTC
        f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_OctetData (v_NRCapability, "NRCap"));
      }
      // To be extended for other options
    }
  }

  /*
   * @desc      To disconnect a PDN and deactivate the associated bearer
                Can be called as an alternative to Detach Request message at switch off
                UE must already be in connected mode
   * @param     p_CellId
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  altstep a_EUTRA38_DisconnectPDN(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC
  {
    var SRB_COMMON_IND v_ReceivedAsp;
    var ProcedureTransactionIdentifier v_EpsTi;
    var EPS_BearerIdentity v_EpsBearerId;
    
    []  SRB.receive(car_SRB2_NasPdu_IND(p_CellId, cr_NAS_Indication(tsc_SHT_IntegrityProtected_Ciphered, cr_PDNDisconnectReq(?)))) -> value v_ReceivedAsp
      {
        v_EpsTi := v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_DISCONNECT_REQUEST.procedureTransactionIdentifier;
        v_EpsBearerId := bit2hex(v_ReceivedAsp.Signalling.Nas[0].Pdu.Msg.pDN_DISCONNECT_REQUEST.linkedEpsBearerId.idValue); // @sic R5s201546 sic@
        f_EUTRA_DeactivateEPS_BearerContext(p_CellId, v_EpsBearerId, v_EpsTi, tsc_ESM_Cause36_RegularDeactivation);
      }
  }

  /*
   * @desc      Get PDU Session List from NR and update DRB Routing Info
   * @param     p_CellId
   * @return    EUTRA_NR_PduSessionInfoList_Type
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_EUTRA38_WaitForPDUSessionInfoList(EUTRA_CellId_Type p_CellId)  runs on EUTRA_5GS_PTC return EUTRA_NR_PduSessionInfoList_Type
  {
    var EUTRA_NR_PduSessionInfoList_Type v_PduSessionInfoList := f_EUTRA_NR_WaitForCoOrd_PduSessionInfoList(NR);
    var integer i;
    
    for (i := 0; i < lengthof (v_PduSessionInfoList); i := i + 1) {
      // DRB id = BearerId - 4
      f_IP_ChangeDrbMappingEUTRA(IP, p_CellId, (v_PduSessionInfoList[i].EPS_Bearer - 4), v_PduSessionInfoList[i].PdnIndex);
    }
    return v_PduSessionInfoList;
  }

  type enumerated DataPath_Protocol_Type { PDCP, NR_PDCP, SDAP }; /* @sic R5w220012 sic@ @status    APPROVED (ENDC, NR5GC_IRAT) */

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_CellId
   * @param     p_PDCP_Protocol
   * @param     p_BearerType
   * @param     p_StepNo
   * @param     p_DRB
   * @param     p_SequenceNumber    (default value: 1)
   * @param     p_UsePING           (default value: true)
   * @param     p_PdnIndex          (default value: PDN_2)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_CheckDataPath(EUTRA_CellId_Type p_CellId,
                                 DataPath_Protocol_Type p_PDCP_Protocol,
                                 DataPathCheck_BearerType_Type p_BearerType,
                                 charstring p_StepNo,
                                 template (value) RadioBearerId_Type p_DRB,
                                 integer p_SequenceNumber := 1,
                                 boolean p_UsePING := true,
                                 PDN_Index_Type p_PdnIndex := PDN_2) runs on EUTRA_PTC // @sic R5s201390 sic@
  { // split to call a common function @ sic R5w220012 sic@
   var boolean v_UsePING := p_UsePING and pc_IP_Ping; // @sic  only use PING if required by test case sic@
   var octetstring v_PdcpSduTX := f_LoopbackModeBorPing_GetDataTX(p_PdnIndex, p_BearerType, p_SequenceNumber, v_UsePING);
   var PDCP_SDUList_Type v_PDCP_SDUList := { v_PdcpSduTX };
   var template (value) L2DataList_Type v_PDCP_DataTX;
   var template (present) L2DataList_Type v_PDCP_DataRX;
   var template (value) DRB_COMMON_REQ v_DRB_DL;
   var template (present) DRB_COMMON_IND v_DRB_UL;

   select (p_PDCP_Protocol) {
     case (PDCP) {
       v_PDCP_DataTX := cs_L2DataList_PdcpSdu(v_PDCP_SDUList);
       v_PDCP_DataRX := cr_L2DataList_PdcpSdu;
     }
     case (NR_PDCP) {
       v_PDCP_DataTX := cs_L2DataList_NrPdcpSdu(v_PDCP_SDUList);
       v_PDCP_DataRX := cr_L2DataList_NrPdcpSdu;
     }
   }

   v_DRB_DL := cas_DRB_COMMON_REQ(p_CellId, p_DRB, cs_TimingInfo_Now, v_PDCP_DataTX);
   v_DRB_UL := car_DRB_COMMON_IND(p_CellId, p_DRB, cr_TimingInfo_Any, v_PDCP_DataRX);

   f_EUTRA_CheckDataPathCommon (v_PdcpSduTX, v_DRB_DL, v_DRB_UL, p_PDCP_Protocol, p_StepNo, v_UsePING);
  }

  /*
   * @desc      Loop back one IP packet to verify the data path
   * @param     p_SduTX
   * @param     p_DRB_DL
   * @param     p_DRB_UL
   * @param     p_Protocol
   * @param     p_StepNo            (default value: "")
   * @param     p_UsePING           (default value: true)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA_CheckDataPathCommon(octetstring p_SduTX,
                                       template (value) DRB_COMMON_REQ p_DRB_DL,
                                       template (present) DRB_COMMON_IND p_DRB_UL,
                                       DataPath_Protocol_Type p_Protocol,
                                       charstring p_StepNo := "",
                                       boolean p_UsePING := true) runs on EUTRA_PTC
  {
   var DRB_COMMON_IND v_DRB_COMMON_IND;
   var octetstring v_SduRX;

   if (p_UsePING) { f_IP_Routing_ChangeToRawmode(IP); }   /* @sic R5s200044 change 4, R5-206332 sic@ */

   DRB.send(p_DRB_DL);
   DRB.receive(p_DRB_UL) -> value v_DRB_COMMON_IND;

   if (p_UsePING) { f_IP_Routing_RestoreRoutingTable(IP); }   /* @sic R5s200044 change 4, R5-206332 sic@ */

   select (p_Protocol) {
     case (PDCP)    { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.PdcpSdu[0]; }
     case (NR_PDCP) { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.NrPdcpSdu[0]; }
     case (SDAP)    { v_SduRX := v_DRB_COMMON_IND.U_Plane.SubframeData.PduSduList.SdapSdu[0]; }
   }

   if (not f_LoopbackModeBorPing_CheckDataRX(p_SduTX, v_SduRX)) {
     f_EUTRA_SetVerdictFailOrInconc(__FILE__, __LINE__, "Invalid Echo Reply");
   } else {
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, p_StepNo);
   }
  }

  /*
   * @desc      To be called during initialization of the EUTRA38 PTC
   * @param     p_Port
   * @param     p_SK_Counter        (default value: tsc_SK_Counter)
   * @return    EUTRA38_SecurityParamsExtd_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_ENDC_InitiateAndSendS_gNBKeys(EUTRA_NR_CO_ORD_PORT p_Port,
                                                   integer p_SK_Counter := tsc_SK_Counter)
    runs on EUTRA_5GS_PTC return EUTRA38_SecurityParamsExtd_Type
  {
    var EUTRA38_SecurityParamsExtd_Type v_Extd_Security_Params := f_EUTRA38_Security_Get();
    var EUTRA_SecurityParams_Type v_Security_Params := f_EUTRA_Security_Get();
    var template (omit) CoOrd_E_NEACap_Type v_EEACap := omit;
    var template (omit) CoOrd_E_NIACap_Type v_EIACap := omit;
    
    v_Extd_Security_Params.SK_Counter := p_SK_Counter; // @sic R5s190491 sic@
    v_Extd_Security_Params.S_KGNB := f_EUTRA_NR_InitAS_KeyChaining_SgNB(v_Security_Params.KDF,
                                                                        v_Security_Params.KENB,
                                                                        p_SK_Counter);
    if (isvalue(v_Security_Params.NAS_SecurityCap5G)) { // @sic R5s220853 sic@
      v_EEACap.E_Nea0 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 0, 1);
      v_EEACap.E_Nea1 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 1, 1);
      v_EEACap.E_Nea2 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.eaCap5G_0_7), 2, 1);
      v_EIACap.E_Nia0 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 0, 1);
      v_EIACap.E_Nia1 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 1, 1);
      v_EIACap.E_Nia2 := substr(oct2bit(v_Security_Params.NAS_SecurityCap5G.iaCap5G_0_7), 2, 1);
    }
    
    f_EUTRA_NR_SendCoOrd (p_Port, cms_EUTRA_NR_Security(v_Extd_Security_Params.SK_Counter,
                                                        S_KGNB,
                                                        v_Extd_Security_Params.S_KGNB,
                                                        omit, // @sic R5-194814 sic@
                                                        omit, // @sic R5-194814 sic@
                                                        omit, // @sic R5w190307 sic@
                                                        v_EEACap,
                                                        v_EIACap,
                                                        omit, omit));
    return v_Extd_Security_Params;
  }

  /*
   * @desc      common initialisation of the EUTRA38_PTC
   *            - store the NR configuration, then call the base function
   *            Function to be used in ENDC test cases and in NR5GC tc with HO to ENDC configuration
   * @param     p_NR_Config
   * @param     p_SysinfoCombination
   * @param     p_HandleULDataUM    (default value: omit)
   * @param     p_UseBigGrants      (default value: omit)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_Init(NR_Configuration_Type p_NR_Config,
                          Combination_Type p_SysinfoCombination,
                          template (omit) EUTRA_HandleUlDataUM_Type p_HandleULDataUM := omit,
                          template (omit) EUTRA_UseBigGrants_Type p_UseBigGrants := omit) runs on EUTRA_5GS_PTC
  {
    var integer v_EUTRA_PrimaryBand := f_ENDC_GetEUTRA_Band(px_ENDC_BandCombination);
    var integer v_EUTRA_SecondaryBand := f_ENDC_GetEUTRA_Band(px_ENDC_SecondaryBandCombination); //@sic R5-190669 sic@

    f_EUTRA38_NR_Config_Set (p_NR_Config);
    if (f_EUTRA38_NR_IsFR1(f_ENDC_GetNR_Band(px_ENDC_BandCombination))){ //@sic R5s201351 sic@
        f_EUTRA38_NR_IsFR1_Set(true);
    } else {
        f_EUTRA38_NR_IsFR1_Set(false);
    }
    // Set test environment depending on NR bands under test
    // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    if (f_GetTestcaseAttrib_InterBandTC(testcasename())) {
    // test case using 2 NR bands
       f_EUTRA38_NR_InitTestEnvironmnent(f_ENDC_GetNR_Band(px_ENDC_BandCombination), f_ENDC_GetNR_Band(px_ENDC_SecondaryBandCombination));
    } else {
    // test case using 1 NR bands
       f_EUTRA38_NR_InitTestEnvironmnent(f_ENDC_GetNR_Band(px_ENDC_BandCombination), omit);
    }
    f_EUTRA38_Security_Init();
    f_EUTRA_Init(p_SysinfoCombination, p_HandleULDataUM, p_UseBigGrants, v_EUTRA_PrimaryBand, v_EUTRA_SecondaryBand);
    f_EUTRA38_InitFrequencies(px_ENDC_BandCombination);
  }

  /*
   * @desc     return true if the parameterized NR band is an FR1 band
   * @param     p_NR_Band
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_IsFR1 ( integer p_NR_Band ) return boolean
  {
    if (p_NR_Band < 257){ //@sic R5s201351 sic@
        return true;
    } else {
        return false;
    }
  }

  /*
   * @desc      Set test environment depending on the NR bands under test
   * @param     p_PrimaryFreqBandIndicatorNR
   * @param     p_SecondaryFreqBandIndicatorNR (default value: omit)
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_InitTestEnvironmnent( integer  p_PrimaryFreqBandIndicatorNR,
                                              template (omit) integer  p_SecondaryFreqBandIndicatorNR := omit
                                            ) runs on EUTRA_5GS_PTC
  { // @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
    if (isvalue(p_SecondaryFreqBandIndicatorNR)) {
        // test case using 2 NR bands
        if ( f_EUTRA38_NR_IsFR1(p_PrimaryFreqBandIndicatorNR) and f_EUTRA38_NR_IsFR1(valueof(p_SecondaryFreqBandIndicatorNR))) {
            vc_EUTRA38_Global.NR_TestEnvironment := Conducted;
        } else {
            vc_EUTRA38_Global.NR_TestEnvironment := OTA;
        }
    } else { // test using 1 NR band
        if ( f_EUTRA38_NR_IsFR1(p_PrimaryFreqBandIndicatorNR)) {
            vc_EUTRA38_Global.NR_TestEnvironment := Conducted;
        } else {
            vc_EUTRA38_Global.NR_TestEnvironment := OTA;
        }
    }
  }

}
