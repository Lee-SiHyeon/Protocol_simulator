  const RRC_TransactionIdentifier tsc_RRC_TI_1 := 1;  /* Alternative transaction identifier
                                                         @status    APPROVED (UTRAN) */

  type enumerated CellUdateConfigurationType {        /* @status    APPROVED (UTRAN) */
    defaultCellUpdate,     //default message contents
    phyChanIEs,            //default message contents + IEs to reconfigure Physical Channel
    trChanIEs,             //default message contents + IEs to reconfigure Transport Channel
    recfgRBsIEs,           //default message contents + IEs to reconfigure RBs
    releaseRBsIEs          //default message contents + IEs to release RBs
  };

  template (value) U_RNTI cs_U_RNTI1 :=  //Different value for U-RNTI to be assigned
  { /* @status    APPROVED (UTRAN) */
