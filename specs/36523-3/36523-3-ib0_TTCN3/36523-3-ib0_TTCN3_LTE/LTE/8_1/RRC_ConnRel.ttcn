module RRC_ConnRel {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EUTRA_BandDependentParam all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_IdleMode all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_AuxiliaryFunctions all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_NB_Parameters all;
  import from EUTRA_Parameters all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SysInfo_Templates all;
  import from NAS_CommonTemplates all;
  import from Parameters all;

  template (value) IdleModeMobilityControlInfo cs_IdleModeMobCntrlInfo_3Entries(ARFCN_ValueEUTRA p_Dl_CarrierFreq_Cell1,
                                                                                  integer          p_Prio1,
                                                                                  ARFCN_ValueEUTRA p_Dl_CarrierFreq_Cell2,
                                                                                  integer          p_Prio2,
                                                                                  ARFCN_ValueEUTRA p_Dl_CarrierFreq_Cell3,
                                                                                  integer          p_Prio3) :=
  { /* @status    APPROVED (LTE) */
    freqPriorityListEUTRA := {
      {
        carrierFreq := p_Dl_CarrierFreq_Cell1,
        cellReselectionPriority := p_Prio1
      },
      {
        carrierFreq := p_Dl_CarrierFreq_Cell2,
        cellReselectionPriority := p_Prio2
      },
      {
        carrierFreq := p_Dl_CarrierFreq_Cell3,
        cellReselectionPriority := p_Prio3
      }
    },
    freqPriorityListGERAN := omit,
    freqPriorityListUTRA_FDD := omit,
    freqPriorityListUTRA_TDD := omit,
    bandClassPriorityListHRPD := omit,
    bandClassPriorityList1XRTT := omit,
    t320 := omit,
    freqPriorityListExtEUTRA_r12 := omit,    /* @sic BASELINE MOVING 2015 sic@ */
    freqPriorityListEUTRA_v1310 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    freqPriorityListExtEUTRA_v1310 := omit,  /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    freqPriorityListNR_r15 := omit           /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
  };

  template (value) IdleModeMobilityControlInfo_v9e0 cs_IdleModeMobCntrlInfo_v9e0_2Entries(ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell1,
                                                                                          ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell2) :=
  { /* @status    APPROVED (LTE) */
    // @sic R5-171439 sic@
    freqPriorityListEUTRA_v9e0 := {
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell1
      },
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell2
      }
    }
  };

  template (value) IdleModeMobilityControlInfo_v9e0 cs_IdleModeMobCntrlInfo_v9e0_3Entries(template (omit) ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell1,
                                                                                          template (omit) ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell2,
                                                                                          template (omit) ARFCN_ValueEUTRA_v9e0 p_Dl_CarrierFreq_v9e0_Cell3) :=
  { /* @status    APPROVED (LTE) */
    // @sic R5-171439, R5-227405 sic@
    // CarrierFreq_v9e0 are initialized to a value or omit
    freqPriorityListEUTRA_v9e0 := {
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell1
      },
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell2
      },
      {
        carrierFreq_v9e0 := p_Dl_CarrierFreq_v9e0_Cell3
      }
    }
  };

  template (value) InterFreqCarrierFreqInfo cs_InterFreqCarrierFreq_ThreshXHigh__ThreshXLow(ARFCN_ValueEUTRA p_DL_CarrierFreq, // @sic R5-165892 sic@
                                                                                            AllowedMeasBandwidth p_AllowedMeasBandwidth,
                                                                                            ReselectionThreshold p_ThreshX_High,
                                                                                            ReselectionThreshold p_ThreshX_Low) :=
    
    /* @status    APPROVED (LTE) */
    cs_InterFreqCarrierFreq_Common(p_DL_CarrierFreq, // @sic R5-165892 sic@
                                   -53,//@sic R5s100725 : as per 36.508 Table 4.4.3.3-4, the default value is -53 sic@
                                   omit,
                                   0,
                                   omit,
                                   p_ThreshX_High,
                                   p_ThreshX_Low,
                                   p_AllowedMeasBandwidth,
                                   false,
                                   4); //p_CellReselectionPriority,as per 36.508 Table 4.4.3.3-4, the default value is 4

  template (value) IdleModeMobilityControlInfo cs_IdleModeMobCntrlInfo_2Entries(ARFCN_ValueEUTRA p_Dl_CarrierFreq_Cell1,
                                                                                integer          p_Prio1,
                                                                                ARFCN_ValueEUTRA p_Dl_CarrierFreq_Cell2,
                                                                                integer          p_Prio2) :=
  { /* @status    APPROVED (LTE) */
    freqPriorityListEUTRA := {
      {
        carrierFreq := p_Dl_CarrierFreq_Cell1,
        cellReselectionPriority := p_Prio1
      },
      {
        carrierFreq := p_Dl_CarrierFreq_Cell2,
        cellReselectionPriority := p_Prio2
      }
    },
    freqPriorityListGERAN := omit,
    freqPriorityListUTRA_FDD := omit,
    freqPriorityListUTRA_TDD := omit,
    bandClassPriorityListHRPD := omit,
    bandClassPriorityList1XRTT := omit,
    t320 := omit,
    freqPriorityListExtEUTRA_r12 := omit,    /* @sic BASELINE MOVING 2015 sic@ */
    freqPriorityListEUTRA_v1310 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    freqPriorityListExtEUTRA_v1310 := omit,  /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    freqPriorityListNR_r15 := omit           /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
  };

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.4
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_4_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell23; // @sic R5-165892 sic@
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency;
    var Ul_Bandwidth_Type v_UL_Bandwidth := f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth);
    var Dl_Bandwidth_Type v_DL_Bandwidth := px_ePrimaryBandChannelBandwidth;
    var integer v_BandCell1;
    var integer v_BandCell23;
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;

    //Initialise all cell, security and mobile parameters
    //* SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);
    
    //Get band dependent parameters
    v_ChannelBandwidthDependency := f_EUTRA_BandDependentParam(v_DL_Bandwidth, v_UL_Bandwidth);
    
    //Get cell specific parameter
    v_CarrierFreq_Cell23 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell23);
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell1);
    
    //Set System Information for Cell 1 & 23 according to Tables 8.1.3.4.3.3-3 and 3A.
    //This will overwrite the default SIB5 init. by function f_EUTRA_Init.

    v_BandCell1 := f_EUTRA_CellInfo_GetBand (eutra_Cell1);
    if (v_BandCell1 > 64) { // @sic R5-171439 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell23.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_SetSIB5_InterFreqCarrierFreqList_F2(eutra_Cell1,
                                                cs_InterFreqCarrierFreq_CRPri (v_CarrierFreq_Cell23.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                               v_ChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                               omit),
                                                -,
                                                v_InterFreqCarrierList_v9e0); //@sic R5-106628 R5-171439 sic@
    
    v_BandCell23 := f_EUTRA_CellInfo_GetBand (eutra_Cell23);
    if (v_BandCell23 > 64) { // @sic R5-171439 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_SetSIB5_InterFreqCarrierFreqList_F1(eutra_Cell23,
                                                cs_InterFreqCarrierFreq_CRPri (v_CarrierFreq_Cell1.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                               v_ChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                               omit),
                                                -,
                                                v_InterFreqCarrierList_v9e0); //@sic R5-106628 R5-171439 sic@
    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell23);
    
    //Bring UE to initial state
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def(eutra_Cell1);
    
    //Set initial cell power level for Cell 1 and Cell 23
    //* Cell power levels are selected according to [18] so that
    //* camping on Cell 1 is guaranteed according to 36.523-1 cl. 8.1.3.4.3.1
    f_EUTRA_SetCellPower(eutra_Cell23, tsc_SuitableCellRS_EPRE);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //Transmit RRCConnectionRelease
    v_BandCell1 := f_EUTRA_CellInfo_GetBand (eutra_Cell1);
    if (v_BandCell1 > 64) { // @sic R5-171439 sic@
      v_RedirectionInformation := omit;
      v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(cs_RedirectionInfo_Eutra_v9e0(v_CarrierFreq_Cell23.dl_CarrierFreq_v9e0));
    } else {
      v_RedirectionInformation := cs_RedirectionInfo_Eutra(v_CarrierFreq_Cell23.dl_CarrierFreq);
      v_RRCConnectionRelease_v890_IEs := omit;
    }
    
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell1,
                                         cs_RRCConnectionRelease(v_RRC_TI,
                                                                 v_ReleaseCause,
                                                                 v_RedirectionInformation,
                                                                 -,
                                                                 v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@
                                                                     
    //@siclog "Step 2" siclog@
    //Check if UE camps on Cell 23
    f_EUTRA_508CheckCampOnNewEutraCell(eutra_Cell23);
    
    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell23, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.5
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_5_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var float v_WaitTime := 5.0;//Time to allow UE to move to RRC_IDLE
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell3;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell6; // @sic R5-165892 sic@
    var ReselectionThreshold v_ThreshXHigh_Cell6 := 11;
    var ReselectionThreshold v_ThreshXLow_Cell3 := 11; //@sic R5s100541 Change 1.1 sic@
    var ChannelBandwidthDependency_Type v_ChannelBandwidthDependency;
    var Ul_Bandwidth_Type v_UL_Bandwidth := f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth);
    var Dl_Bandwidth_Type v_DL_Bandwidth := px_ePrimaryBandChannelBandwidth;
    var template (value) CellPowerList_Type v_CellPowerList_AtT1 := {
      cs_CellPower(eutra_Cell3, -73),
      cs_CellPower(eutra_Cell6, -73)
    };
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var integer v_BandCell1;
    var integer v_BandCell6;
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
    
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init (c3);
    
    //Set TAC according to 8.1.3.5.3.1
    f_EUTRA_CellInfo_SetTAC (eutra_Cell3, tsc_IdleMode_TAC_Cell2); //@sic R5-106570 sic@
    f_EUTRA_CellInfo_SetTAC (eutra_Cell6, tsc_IdleMode_TAC_Cell2); //@sic R5-106570 sic@
    
    //Get band dependent parameters
    v_ChannelBandwidthDependency := f_EUTRA_BandDependentParam (v_DL_Bandwidth, v_UL_Bandwidth);
    
    //Get cell specific parameters
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell1);
    v_CarrierFreq_Cell3 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell3);
    v_CarrierFreq_Cell6 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell6);
    
    //Set SIB5 information accordig to Table 8.1.3.5.3.3-2 and 36.508 cl. 6.3.1.2
    //v_CarrierFreq_Cell3 is f2
    //v_CarrierFreq_Cell6 is f3
    //f5 is not included since this is not a interband test case
    v_BandCell1 := f_EUTRA_CellInfo_GetBand (eutra_Cell1);
    if (v_BandCell1 > 64) { // @sic R5-171439 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell6.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell1, cs_508_SystemInformationBlockType5_Def({cs_InterFreqCarrierFreq_ThreshXLow_CRPri(v_CarrierFreq_Cell3.dl_CarrierFreq,//@sic R5s100541, R5-165892 sic@
                                                                                                                            v_ChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                            v_ThreshXLow_Cell3,
                                                                                                                            omit),
                                                                                   cs_InterFreqCarrierFreq_ThreshXHigh_CRPri (v_CarrierFreq_Cell6.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                                                                              v_ChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                              v_ThreshXHigh_Cell6,
                                                                                                                              omit)},
                                                                                   v_InterFreqCarrierList_v9e0)); //@sic R5-106277, R5s180570 sic@

    v_BandCell6 := f_EUTRA_CellInfo_GetBand (eutra_Cell6);
    if (v_BandCell6 > 64) { // @sic R5-171439 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0)};
    }
    //Set SIB5 information accordig to Table 8.1.3.5.3.3-3 and 36.508 cl. 6.3.1.2
    f_EUTRA_SetSIB5_InterFreqCarrierFreqList_F2(eutra_Cell6,
                                                cs_InterFreqCarrierFreq_CRPri (v_CarrierFreq_Cell3.dl_CarrierFreq,//f2  @sic R5-165892 sic@
                                                                               v_ChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                               omit), // @sic R5-171439 sic@
                                                -,
                                                v_InterFreqCarrierList_v9e0); //@sic R5-106277 R5-171439 sic@
    

    //Set maximum cell power level for Cell 1, 3 & 6 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell3, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell6, -73);
    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def (eutra_Cell1);
    f_EUTRA_CellConfig_Def (eutra_Cell6);
    f_EUTRA_CellConfig_Def (eutra_Cell3);
    
    //Bring UE to initial state
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_RbEst_Def (eutra_Cell1);
    
    //Set initial cell power level according to T0
    //Power levels are already according to T0
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //Transmit RRCConnectionRelease
    v_BandCell1 := f_EUTRA_CellInfo_GetBand (eutra_Cell1);
    if (v_BandCell1 > 64) { // @sic R5-171439 sic@
        v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(omit,
                                                                                cs_IdleModeMobCntrlInfo_v9e0_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell6.dl_CarrierFreq_v9e0));
    }
    f_EUTRA_RRC_ConnectionRelease_Common (eutra_Cell1,
                                          cs_RRCConnectionRelease(v_RRC_TI,
                                                                  v_ReleaseCause,
                                                                  v_RedirectionInformation,
                                                                  cs_IdleModeMobCntrlInfo_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                                                                                   4,
                                                                                                   v_CarrierFreq_Cell3.dl_CarrierFreq,
                                                                                                   1,
                                                                                                   v_CarrierFreq_Cell6.dl_CarrierFreq,
                                                                                                   5),
                                                                  v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@
    //@siclog "Step 2" siclog@
    //Wait 5 s. for UE to enter RRC_IDLE
    f_Delay (v_WaitTime);
    
    //@siclog "Step 3" siclog@
    //Set RS EPRE of Cell 3 & Cell 6 according to T1
    f_EUTRA_SetCellPowerList (v_CellPowerList_AtT1);

    //@siclog "Step 4" siclog@
    //Void
    
    //@siclog "Step 5" siclog@
    //Check if UE is in E-UTRA RRC_IDLE state
    f_EUTRA_508CheckCampOnNewEutraCell (eutra_Cell6); //@sic R5-106570 sic@

    f_EUTRA_TestBody_Set (false);
    
    //Switch/power off UE
    f_EUTRA_Postamble (eutra_Cell6, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.11
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_11_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_PrimCell;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10; // @sic R5-165892 sic@
    var ChannelBandwidthDependency_Type v_PrimaryChannelBandwidthDependency;
    var ChannelBandwidthDependency_Type v_SecondaryChannelBandwidthDependency;
    var EUTRA_CellId_Type v_PrimaryCell; //@sic R5s140787 sic@
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
        
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);

    v_PrimaryCell := eutra_Cell1;

    //Set TAC according to 8.1.3.11.3.1
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell2); //different TAC for TAU procedure
    //Get band dependent parameters
    v_PrimaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_ePrimaryBandChannelBandwidth,
                                                                        f_ConvertDL_BandwidthToUL( px_ePrimaryBandChannelBandwidth));
    v_SecondaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_eSecondaryBandChannelBandwidth,
                                                                         f_ConvertDL_BandwidthToUL( px_eSecondaryBandChannelBandwidth));
    //Get cell specific parameter
    v_CarrierFreq_PrimCell := f_EUTRA_CellInfo_GetEARFCN(v_PrimaryCell); //@sic R5s140787 sic@
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell10);

    //Set SIB5 information accordig to Table 8.1.3.11.3.3-2
    //v_CarrierFreq_Cell10 is f5
    //@sic R5s140787 sic@
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5s170222, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5 (v_PrimaryCell, cs_508_SystemInformationBlockType5_Def({cs_InterFreqCarrierFreq_CRPri
                                                                                                   (v_CarrierFreq_Cell10.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                                                    v_SecondaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                    3)
                                                                                    },
                                                                                    v_InterFreqCarrierList_v9e0));//@sic R5s120433 R5-171439 sic@
    //Set SIB5 information accordig to Table 8.1.3.11.3.3-2A
    if (px_ePrimaryFrequencyBand > 64) { // @sic R5-171439, R5s170222, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_PrimCell.dl_CarrierFreq_v9e0)};
    } else {
      v_InterFreqCarrierList_v9e0 := omit;
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell10, cs_508_SystemInformationBlockType5_Def({cs_InterFreqCarrierFreq_CRPri
                                                                                                   (v_CarrierFreq_PrimCell.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                                                    v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                    3)
                                                                                   },
                                                                                   v_InterFreqCarrierList_v9e0));//@sic R5s120433 R5-171439 sic@


    //Create and configure all cells
    f_EUTRA_CellConfig_Def(v_PrimaryCell);  //@sic R5s140787 sic@
    f_EUTRA_CellConfig_Def(eutra_Cell10);

    // First switch cell back on
    f_EUTRA_SetCellPower(v_PrimaryCell, tsc_SuitableCellRS_EPRE);  //@sic R5s140787 sic@

    // Switch on UE

    f_EUTRA_Preamble (v_PrimaryCell, STATE2_IDLEUPDATE);  //@sic R5s140787 sic@

    f_EUTRA_RbEst_Def(v_PrimaryCell);  //@sic R5s140787 sic@

    //Set initial cell power level for Cell 10
    f_EUTRA_SetCellPower(eutra_Cell10, tsc_SuitableCellRS_EPRE);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //SS transmits an RRCConnectionRelease message (IE redirectedCarrierInfo including eutra CarrierFreq of Cell 10.
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5s170222, R5-230121 sic@
      v_RedirectionInformation := omit;
      v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(cs_RedirectionInfo_Eutra_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0));
    } else {
      v_RedirectionInformation := cs_RedirectionInfo_Eutra(v_CarrierFreq_Cell10.dl_CarrierFreq);
      v_RRCConnectionRelease_v890_IEs := omit;
    }
    
    f_EUTRA_RRC_ConnectionRelease_Common(v_PrimaryCell,    //@sic R5s140787 sic@
                                         cs_RRCConnectionRelease(v_RRC_TI,
                                                                 v_ReleaseCause,
                                                                 v_RedirectionInformation,
                                                                 -,
                                                                 v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@

    //@siclog "Step2" siclog@
    //Check if UE camps on Cell 10
    f_EUTRA_508CheckCampOnNewEutraCell(eutra_Cell10);

    f_EUTRA_TestBody_Set(false);

    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell10, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.11a
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_11a_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell28; // @sic R5-165892 sic@
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
    
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);

    //Set TAC according to 8.1.3.11a.3.1
    f_EUTRA_CellInfo_SetTAC (eutra_Cell28, tsc_IdleMode_TAC_Cell2); //different TAC for TAU procedure

    //Get cell specific parameter
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell1);
    v_CarrierFreq_Cell28 := f_EUTRA_CellInfo_GetEARFCN(eutra_Cell28);

    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell28);
    
    // First switch cell back on
    f_EUTRA_SetCellPower(eutra_Cell1, tsc_SuitableCellRS_EPRE);

    // Switch on UE
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1);

    //Bring UE to initial state with Equivalent PLMN2 (Cell28)
    f_EUTRA_InitialRegistration(eutra_Cell1,
                                PREAMBLE,
                                STATE2_IDLEUPDATE, NORMAL, -, // @sic R5-160947 sic@
                                cs_PLMN_List_1PLMN(f_Asn2Nas_PlmnId(f_EUTRA_CellInfo_GetGutiPLMN(eutra_Cell28))));


    f_EUTRA_RbEst_Def(eutra_Cell1);
    
    //Set initial cell power level for Cell 28
    f_EUTRA_SetCellPower(eutra_Cell28, tsc_SuitableCellRS_EPRE);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //SS transmits an RRCConnectionRelease message (IE redirectedCarrierInfo including eutra CarrierFreq of Cell 28.
    if (px_ePrimaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_RedirectionInformation := omit;
      v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(cs_RedirectionInfo_Eutra_v9e0(v_CarrierFreq_Cell28.dl_CarrierFreq_v9e0));
    } else {
      v_RedirectionInformation := cs_RedirectionInfo_Eutra(v_CarrierFreq_Cell28.dl_CarrierFreq);
      v_RRCConnectionRelease_v890_IEs := omit;
    }
    
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell1,    //@sic R5s140787 sic@
                                         cs_RRCConnectionRelease(v_RRC_TI,
                                                                 v_ReleaseCause,
                                                                 v_RedirectionInformation,
                                                                 -,
                                                                 v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@

    //@siclog "Step2" siclog@
    //Check if UE camps on Cell 28
    //Send TAU accept with PLMN1 and PLMN2 listed as Equivalent PLMN
    f_EUTRA_TrackingAreaUpdate_WithEplmn (eutra_Cell28,
                                          v_RRC_TI,
                                          cs_PLMN_List_1PLMN(f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (eutra_Cell1))));
    
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "508Check CampOnNewEutraCell");

    //@siclog "Step 3" siclog@
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed to make the UE enter state Generic RB Established (state 3) on Cell 28.
    f_EUTRA_RbEst_Def(eutra_Cell28);

    //@siclog "Step 4" siclog@
    //SS transmits an RRCConnectionRelease message (IE redirectedCarrierInfo including eutra CarrierFreq of Cell 1).
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_RedirectionInformation := omit;
      v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(cs_RedirectionInfo_Eutra_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0));
    } else {
      v_RedirectionInformation := cs_RedirectionInfo_Eutra(v_CarrierFreq_Cell1.dl_CarrierFreq);
      v_RRCConnectionRelease_v890_IEs := omit;
    }
    
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell28,    //@sic R5s140787 sic@
                                         cs_RRCConnectionRelease(v_RRC_TI,
                                                                 v_ReleaseCause,
                                                                 v_RedirectionInformation,
                                                                 -,
                                                                 v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@
    
    //@siclog "Step5" siclog@
    //Check if UE camps on Cell 1
    //Send TAU accept with PLMN1 and PLMN2 listed as Equivalent PLMN
    f_EUTRA_TrackingAreaUpdate_WithEplmn (eutra_Cell1,
                                          v_RRC_TI,
                                          cs_PLMN_List_1PLMN(f_Asn2Nas_PlmnId (f_EUTRA_CellInfo_GetGutiPLMN (eutra_Cell28))));
    
    
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "508Check CampOnNewEutraCell");

    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell1, E1_IDLE);
  } // end f_TC_8_1_3_11a_EUTRA

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.12
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_12_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell3;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10; // @sic R5-165892 sic@
    var ReselectionThreshold v_ThreshXHigh := 11;
    var ReselectionThreshold v_ThreshXLow := 11;
    var ChannelBandwidthDependency_Type v_PrimaryChannelBandwidthDependency;
    var ChannelBandwidthDependency_Type v_SecondaryChannelBandwidthDependency;
    var template (value) CellPowerList_Type v_CellPowerList_T0toT1 := {
      cs_CellPower(eutra_Cell3, -73),
      cs_CellPower(eutra_Cell10, -73)
    };
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
        
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);

    //Set TAC according to 8.1.3.12.3.1
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell2); ////different TAC for TAU procedure
    
    //Get band dependent parameters
    v_PrimaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_ePrimaryBandChannelBandwidth,
                                                                        f_ConvertDL_BandwidthToUL( px_ePrimaryBandChannelBandwidth));
    v_SecondaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_eSecondaryBandChannelBandwidth,
                                                                          f_ConvertDL_BandwidthToUL( px_eSecondaryBandChannelBandwidth));
    
    //Get cell specific parameters
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell1);
    v_CarrierFreq_Cell3 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell3);
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell10);
    
    //Set SIB5 information accordig to Table 8.1.3.12.3.3-2 and Table 8.1.3.12.3.3-3
    //@sic R5s120450 sic@
    //v_CarrierFreq_Cell3 is f2
    //v_CarrierFreq_Cell10 is f5
    if (px_ePrimaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell1, cs_508_SystemInformationBlockType5_Def({ cs_InterFreqCarrierFreq_ThreshXLow (v_CarrierFreq_Cell3.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                                                                          v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                          v_ThreshXLow),
                                                                                      cs_InterFreqCarrierFreq_ThreshXHigh (v_CarrierFreq_Cell10.dl_CarrierFreq, // @sic R5-165892 sic@
                                                                                                                           v_SecondaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                           v_ThreshXHigh)},
                                                                                  v_InterFreqCarrierList_v9e0)); // @sic R5-171439 sic@
    

    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0)};
    } else {
      v_InterFreqCarrierList_v9e0 := omit;
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell10, cs_508_SystemInformationBlockType5_Def({ cs_InterFreqCarrierFreq_CRPri (v_CarrierFreq_Cell1.dl_CarrierFreq,//f1 @sic R5-165892 sic@
                                                                                                                       v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                      omit),
                                                                                      cs_InterFreqCarrierFreq_CRPri (v_CarrierFreq_Cell3.dl_CarrierFreq,//f2 @sic R5-165892 sic@
                                                                                                                     v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                   1)},
                                                                                      v_InterFreqCarrierList_v9e0)); // @sic R5-171439 sic@
    
    //Set maximum cell power level for Cell 1, 3 & 10 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell3, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell10, -73);
    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def (eutra_Cell1);
    f_EUTRA_CellConfig_Def (eutra_Cell3);
    f_EUTRA_CellConfig_Def (eutra_Cell10);
    
    //Bring UE to initial state
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed to make the UE enter state Generic RB Established (state 3) on cell 1.
    f_EUTRA_RbEst_Def(eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS transmits an RRCConnectionRelease message including the freqPriorityListEUTRA on Cell 1.
    if ((px_ePrimaryFrequencyBand > 64) or (px_eSecondaryFrequencyBand > 64)) { // @sic R5-171439, R5-227405, R5-230121 sic@
        v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(omit,
                                                                                cs_IdleModeMobCntrlInfo_v9e0_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell3.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0));
    }
    f_EUTRA_RRC_ConnectionRelease_Common (eutra_Cell1,
                                          cs_RRCConnectionRelease(v_RRC_TI,
                                                                  v_ReleaseCause,
                                                                  v_RedirectionInformation,
                                                                  cs_IdleModeMobCntrlInfo_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                                                                                   4,
                                                                                                   v_CarrierFreq_Cell3.dl_CarrierFreq,
                                                                                                   1,
                                                                                                   v_CarrierFreq_Cell10.dl_CarrierFreq,
                                                                                                   5),
                                                                  v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@
    
    //@siclog "Step 2" siclog@
    //Wait for5 s for the UE to enter E-UTRA RRC_IDLE state on Cell 1.
    f_Delay (5.0);
    
    //@siclog "Step 3" siclog@
    //The SS changes Cell 3 and Cell 10 levels according to the row "T1" in table 8.1.3.13.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_T0toT1);
    
    //@siclog "Step 4 " siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 steps 1 to 5 of subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 10?
    f_EUTRA_508CheckCampOnNewEutraCell(eutra_Cell10);
    
    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell10, E1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.12a
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_12a_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10; // @sic R5-165892 sic@
    var ReselectionThreshold v_ThreshXHigh := 11;
    var ReselectionThreshold v_ThreshXLow := 11; //@sic R5s100541 Change 1.1 sic@
    var ChannelBandwidthDependency_Type v_PrimaryChannelBandwidthDependency;
    var ReselectionThreshold v_ThreshServingLow_cell10 := 14;
    var ReselectionThreshold v_S_IntraSearch := 0;  // @sic R5s130314 sic@

    var template (value) CellPowerList_Type v_CellPowerList_T0 := {
      cs_CellPower(eutra_Cell1, -79)  // @sic R5-132033 sic@
    };
    var template (value) CellPowerList_Type v_CellPowerList_T0toT1 := {
      cs_CellPower(eutra_Cell2, -73),  // @sic R5-121896 sic@
      cs_CellPower(eutra_Cell10, -73)
    };
    var template (value) CellPowerList_Type v_CellPowerList_T1toT2 := {
      cs_CellPower(eutra_Cell10, tsc_ServingCellRS_EPRE)
    };
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var template (omit) RedirectedCarrierInfo v_RedirectionInformation:= omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
    
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);
    
    //Set TAC according to 8.1.3.12a.3.1
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell2); ////different TAC for TAU procedure
    
    //Get band dependent parameters
    v_PrimaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_ePrimaryBandChannelBandwidth,
                                                                        f_ConvertDL_BandwidthToUL( px_ePrimaryBandChannelBandwidth));
    
    //Get cell specific parameters
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell1);
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell10);
    
    //Set SIB5 information accordig to Table 8.1.3.12a.3.3-2 and Table 8.1.3.12a.3.3-4
    
    //v_CarrierFreq_Cell10 is f5
     if (px_ePrimaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell1, cs_508_SystemInformationBlockType5_Def({ cs_InterFreqCarrierFreq_ThreshXHigh__ThreshXLow (v_CarrierFreq_Cell10.dl_CarrierFreq,//@sic R5s100541, R5-165892 sic@
                                                                                                                                       v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                                       v_ThreshXHigh,
                                                                                                                                       v_ThreshXLow)
                                                                                  },
                                                                                  v_InterFreqCarrierList_v9e0)); // @sic R5-171439 sic@
    
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0)};
    } else {
      v_InterFreqCarrierList_v9e0 := omit;
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell10, cs_508_SystemInformationBlockType5_Def({ cs_InterFreqCarrierFreq_ThreshXHigh__ThreshXLow (v_CarrierFreq_Cell1.dl_CarrierFreq,//@sic R5s100541, R5-165892 sic@
                                                                                                                                      v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth,
                                                                                                                                      v_ThreshXHigh,
                                                                                                                                      v_ThreshXLow)
                                                                                   },
                                                                                   v_InterFreqCarrierList_v9e0)); // @sic R5-171439 sic@
    // set SIB3 information according to Table 8.1.3.12a.3.3-3 and SIntraSearchP to zero
    f_EUTRA_CellInfo_SetSIB3(eutra_Cell10,
                             cs_508_SystemInformationBlockType3_Common (-, -, -, v_ThreshServingLow_cell10, -, -, -, v_S_IntraSearch)); // @sic R5s130314 sic@
    
    // set SIB3 information according to Table 8.1.3.12a.3.3-5 and SIntraSearchP to zero
    f_EUTRA_CellInfo_SetSIB3(eutra_Cell1,
                             cs_508_SystemInformationBlockType3_Common (-, -, -, -, -, -, -, v_S_IntraSearch)); // @sic R5s130314 sic@
                             
    // set SIB3 information according to Table 8.1.3.12a.3.3-5 and SIntraSearchP to zero
    f_EUTRA_CellInfo_SetSIB3(eutra_Cell2,
                             cs_508_SystemInformationBlockType3_Common (-, -, -, -, -, -, -, v_S_IntraSearch)); // @sic R5s130314 sic@
    
    //Set maximum cell power level for Cell 1, 2 & 10 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell1, -73); // @sic R5-132033 sic@
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell2, -73); // @sic R5s130314r2 sic@
    f_EUTRA_CellInfo_InitMaxReferencePower(eutra_Cell10, -73); // @sic R5s130314r2 sic@
    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell2);
    f_EUTRA_CellConfig_Def(eutra_Cell10);
    
    //Bring UE to initial state
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed to make the UE enter state Generic RB Established (state 3) on cell 1.
    f_EUTRA_RbEst_Def(eutra_Cell1);
    //The SS changes Cell power levels to the initial conditions after preamble
    f_EUTRA_SetCellPowerList(v_CellPowerList_T0);
   
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS transmits an RRCConnectionRelease message including the freqPriorityListEUTRA on Cell 1.
    if (px_ePrimaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
        v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(omit,
                                                                                cs_IdleModeMobCntrlInfo_v9e0_2Entries(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0));
    }
    f_EUTRA_RRC_ConnectionRelease_Common (eutra_Cell1,
                                          cs_RRCConnectionRelease(v_RRC_TI,
                                                                  v_ReleaseCause,
                                                                  v_RedirectionInformation,
                                                                  cs_IdleModeMobCntrlInfo_2Entries(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                                                                                   4,
                                                                                                   v_CarrierFreq_Cell10.dl_CarrierFreq,
                                                                                                   5),
                                                                  v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@

    //@siclog "Step 2" siclog@
    //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state on Cell 1.
    f_Delay(5.0);

    //@siclog "Step 3" siclog@
    //The SS changes Cell 2 and Cell 10 levels according to the row "T1" in table 8.1.3.12a.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_T0toT1);
    
    //@siclog "Step 4 - 8" siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 steps 1 to 5 of subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 10?
    f_EUTRA_TrackingAreaUpdate_Step1_5(eutra_Cell10);

    //@siclog "Step 9" siclog@
    //The SS transmits an RRCConnectionRelease message including the freqPriorityListEUTRA on Cell 10.
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-171439, R5-230121 sic@
        v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(omit,
                                                                                cs_IdleModeMobCntrlInfo_v9e0_2Entries(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0));
    }
    f_EUTRA_RRC_ConnectionRelease_Common (eutra_Cell10, // @sic R5s170362 sic@
                                          cs_RRCConnectionRelease(v_RRC_TI,
                                                                  v_ReleaseCause,
                                                                  v_RedirectionInformation,
                                                                  cs_IdleModeMobCntrlInfo_2Entries(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                                                                                   4,
                                                                                                   v_CarrierFreq_Cell10.dl_CarrierFreq,
                                                                                                   5),
                                                                  v_RRCConnectionRelease_v890_IEs)); // @sic R5-171439 sic@
    
    //@siclog "Step 10" siclog@
    //Wait for 5 s for the UE to enter E-UTRA RRC_IDLE state on Cell 10.
    f_Delay(5.0);
    
    //@siclog "Step 11" siclog@
    //The SS changes Cell 1 and Cell 10 level according to the row "T2" in table 8.1.3.12a.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_T1toT2);
    
    //@siclog "Step 12 - 17" siclog@
    // @sic R5-123432  R5s140774 sic@
    //Check: Does the test result of generic test procedure in TS 36.508 subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 2?
    f_EUTRA_508CheckCampOnNewEutraCell(eutra_Cell2);

    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell2, E1_IDLE);
  } // end f_TC_8_1_3_12a_EUTRA

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.1.3.12b
   * @status    APPROVED (LTE)
   */
  function f_TC_8_1_3_12b_EUTRA() runs on EUTRA_PTC
  {
    var ReleaseCause v_ReleaseCause := other;
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell1;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell28;
    var CellCarrierFreqEUTRA_Type v_CarrierFreq_Cell10; // @sic R5-165892 sic@
    var ReselectionThreshold v_ThreshXHigh := 11;
    var ReselectionThreshold v_ThreshXLow := 11;
    var ChannelBandwidthDependency_Type v_PrimaryChannelBandwidthDependency;
    var ChannelBandwidthDependency_Type v_SecondaryChannelBandwidthDependency;
    var template (value) InterFreqCarrierFreqList  v_InterFreqCarrierList;
    var template (value) CellPowerList_Type v_CellPowerList_T0toT1 := {
      cs_CellPower(eutra_Cell28, -73),
      cs_CellPower(eutra_Cell10, -73)
    };
    var template (omit)  InterFreqCarrierFreqInfo_v9e0_List_Type  v_InterFreqCarrierList_v9e0 := omit;
    var template (omit) RRCConnectionRelease_v890_IEs v_RRCConnectionRelease_v890_IEs := omit;
    
    //Initialise all cell, security and mobile parameters
    //SIB5 is init. in f_EUTRA_InitSystemInformation5 with default values according to 36.508 cl. 6.3.1.2
    f_EUTRA_Init(c3);
    
    //Set TAC
    f_EUTRA_CellInfo_SetTAC (eutra_Cell10, tsc_IdleMode_TAC_Cell2); ////different TAC for TAU procedure
    
    //Get band dependent parameters
    v_PrimaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_ePrimaryBandChannelBandwidth,
                                                                      f_ConvertDL_BandwidthToUL(px_ePrimaryBandChannelBandwidth));
    v_SecondaryChannelBandwidthDependency := f_EUTRA_BandDependentParam(px_eSecondaryBandChannelBandwidth,
                                                                        f_ConvertDL_BandwidthToUL(px_eSecondaryBandChannelBandwidth));
    
    //Get cell specific parameters
    v_CarrierFreq_Cell1 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell1);
    v_CarrierFreq_Cell28 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell28);
    v_CarrierFreq_Cell10 := f_EUTRA_CellInfo_GetEARFCN (eutra_Cell10);
    
    //Set SIB5 information
    //v_CarrierFreq_Cell28 is f6
    //v_CarrierFreq_Cell10 is f5
    v_InterFreqCarrierList := {
      cs_InterFreqCarrierFreq_ThreshXLow(v_CarrierFreq_Cell28.dl_CarrierFreq, v_SecondaryChannelBandwidthDependency.AllowedMeasBandwidth, v_ThreshXLow), // @sic R5-165892, R5-230121 sic@
      cs_InterFreqCarrierFreq_ThreshXHigh(v_CarrierFreq_Cell10.dl_CarrierFreq, v_SecondaryChannelBandwidthDependency.AllowedMeasBandwidth, v_ThreshXHigh) // @sic R5-165892 sic@
    };
    if (px_ePrimaryFrequencyBand > 64) { // @sic R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell28.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0)};
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell1, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));// @sic R5-230121 sic@

    v_InterFreqCarrierList := {
      cs_InterFreqCarrierFreq_CRPri(v_CarrierFreq_Cell1.dl_CarrierFreq,  v_PrimaryChannelBandwidthDependency.AllowedMeasBandwidth, omit), // @sic R5-165892 sic@
      cs_InterFreqCarrierFreq_CRPri(v_CarrierFreq_Cell28.dl_CarrierFreq, v_SecondaryChannelBandwidthDependency.AllowedMeasBandwidth, 1) // @sic R5-165892, R5-230121 sic@
    };
    if (px_eSecondaryFrequencyBand > 64) { // @sic R5-230121 sic@
      v_InterFreqCarrierList_v9e0 := { cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0), cs_InterFreqCarrierFreq_v9e0(v_CarrierFreq_Cell28.dl_CarrierFreq_v9e0)};
    }
    else {
      v_InterFreqCarrierList_v9e0 := omit;
    }
    f_EUTRA_CellInfo_SetSIB5 (eutra_Cell10, cs_508_SystemInformationBlockType5_Def(v_InterFreqCarrierList, v_InterFreqCarrierList_v9e0));// @sic R5-230121 sic@
    
    //Set maximum cell power level for Cell 1, 28 & 10 to be used in creation
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell1, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell28, -73);
    f_EUTRA_CellInfo_InitMaxReferencePower (eutra_Cell10, -73);
    
    //Create and configure all cells
    f_EUTRA_CellConfig_Def(eutra_Cell1);
    f_EUTRA_CellConfig_Def(eutra_Cell28);
    f_EUTRA_CellConfig_Def(eutra_Cell10);
    
    //Bring UE to initial state
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    //Generic test procedure in TS 36.508 subclause 4.5.3.3 is performed to make the UE enter state Generic RB Established (state 3) on cell 1.
    f_EUTRA_RbEst_Def(eutra_Cell1);
    
    f_EUTRA_TestBody_Set(true);
    
    //@siclog "Step 1" siclog@
    //The SS transmits an RRCConnectionRelease message including the freqPriorityListEUTRA on Cell 1.
    if ((px_ePrimaryFrequencyBand > 64) or (px_eSecondaryFrequencyBand > 64)) { // @sic R5-230121 sic@
        v_RRCConnectionRelease_v890_IEs := cs_RRCConnectionRelease_All_IEs_v9e0(omit,
                                                                                cs_IdleModeMobCntrlInfo_v9e0_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell28.dl_CarrierFreq_v9e0,
                                                                                                                      v_CarrierFreq_Cell10.dl_CarrierFreq_v9e0));
    }
    f_EUTRA_RRC_ConnectionRelease_Common(eutra_Cell1,
                                         cs_RRCConnectionRelease(v_RRC_TI,
                                                                 v_ReleaseCause,
                                                                 omit,
                                                                 cs_IdleModeMobCntrlInfo_3Entries(v_CarrierFreq_Cell1.dl_CarrierFreq,
                                                                                                  4,
                                                                                                  v_CarrierFreq_Cell28.dl_CarrierFreq,
                                                                                                  1,
                                                                                                  v_CarrierFreq_Cell10.dl_CarrierFreq,
                                                                                                  5),
                                                                 v_RRCConnectionRelease_v890_IEs)); // @sic R5-230121 sic@
    //@siclog "Step 2" siclog@
    //Wait for5 s for the UE to enter E-UTRA RRC_IDLE state on Cell 1.
    f_Delay (5.0);
    
    //@siclog "Step 3" siclog@
    //The SS changes Cell 28 and Cell 10 levels according to the row "T1" refer to table 8.1.3.12.3.2-1.
    f_EUTRA_SetCellPowerList(v_CellPowerList_T0toT1);
    
    //@siclog "Step 4 " siclog@
    //Check: Does the test result of generic test procedure in TS 36.508 steps 1 to 5 of subclause 6.4.2.7 indicate that the UE is camped on E-UTRAN Cell 10?
    f_EUTRA_508CheckCampOnNewEutraCell(eutra_Cell10);
    
    f_EUTRA_TestBody_Set(false);
    
    //Switch/power off UE
    f_EUTRA_Postamble(eutra_Cell10, E1_IDLE);
  }

}
