module EUTRA_Component_5GS {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G all;
  import from EUTRA38_SecurityFunctions all;
  import from EUTRA_Component all;
  import from EUTRA_NR_CoordMsg all;

  type record EUTRA38_Global_Type {                             /* @status    APPROVED (ENDC, NR5GC_IRAT) */
    EUTRA38_SecurityParamsExtd_Type   Security,
    NR_Configuration_Type             NR_Config,
    boolean                           NR_IsFR1,      // Set to true if the neighbour NR cells are configured on FR1 band
    NR_TestEnvironment_Type           NR_TestEnvironment // Test environment conducted or OTA @sic R5-220392 R5-220397 R5-220398 R5-221433 R5-221436 R5-221439 R5-221441 R5-221447 sic@
  };

  type component EUTRA_5GS_PTC extends EUTRA_PTC {             /* @status    APPROVED (ENDC, NR5GC_IRAT) */

    var  EUTRA38_Global_Type vc_EUTRA38_Global;
    
    port EUTRA_NR_CO_ORD_PORT    NR;
  };

  /*
   * @desc      Return NR_Configuration_Type
   * @return    NR_Configuration_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_Config_Get() runs on EUTRA_5GS_PTC return NR_Configuration_Type
  {
    return vc_EUTRA38_Global.NR_Config;
  }

  /*
   * @desc      Set NR_Configuration_Type
   * @param     p_Config
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_Config_Set(NR_Configuration_Type p_Config) runs on EUTRA_5GS_PTC
  {
    vc_EUTRA38_Global.NR_Config := p_Config;
  }

  /*
   * @desc      set NR_Configuration_Type
   * @param     p_NR_IsFR1
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_IsFR1_Set(boolean p_NR_IsFR1) runs on EUTRA_5GS_PTC
  {
    vc_EUTRA38_Global.NR_IsFR1 := p_NR_IsFR1;
  }

  /*
   * @desc      Return NR_Configuration_Type
   * @return    boolean
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_IsFR1_Get() runs on EUTRA_5GS_PTC return boolean
  {
    return vc_EUTRA38_Global.NR_IsFR1;
  }

  /*
   * @desc      Return NR_TestEnvironment_Type
   * @return    NR_TestEnvironment_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_NR_TestEnvironment_Get() runs on EUTRA_5GS_PTC return NR_TestEnvironment_Type
  {
    return vc_EUTRA38_Global.NR_TestEnvironment;
  }

  /*
   * @desc      Return extended security parameters
   * @return    EUTRA38_SecurityParamsExtd_Type
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_Security_Get() runs on EUTRA_5GS_PTC return EUTRA38_SecurityParamsExtd_Type
  {
    return vc_EUTRA38_Global.Security;
  }

  /*
   * @desc      set extended security parameters
   * @param     p_Auth_Params
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_Security_Set(EUTRA38_SecurityParamsExtd_Type p_Auth_Params) runs on EUTRA_5GS_PTC
  {
    vc_EUTRA38_Global.Security := p_Auth_Params;
  }

  /*
   * @desc      to be called during initialization of the EUTRA38 PTC
   * @status    APPROVED (ENDC, NR5GC_IRAT)
   */
  function f_EUTRA38_Security_Init()  runs on EUTRA_5GS_PTC
  {
    vc_EUTRA38_Global.Security := valueof(cs_AuthParamsExtd_Init);
  }

}
