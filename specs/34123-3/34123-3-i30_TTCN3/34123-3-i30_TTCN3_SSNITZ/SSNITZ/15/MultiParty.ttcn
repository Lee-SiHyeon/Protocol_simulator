module MultiParty {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_CommonTypeDefs all;
  import from SS_CommonFunctions all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRANGERAN_CommonFunctions all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  template (present) Invoke cr_InvokeSplitMPTY(template (present) InvokeIdType p_InvokeId := ?) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := omit,
    operationCode :=  {
      local := tsc_OperationCode_SplitMPTY
    },
    parameter := {
      splitMPTY := NULL
    }
  };

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_1_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Beginning the MultiParty service, successful case */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.4 of TS 34.108.
    // The UE shall have Call A-B in state U10 "Active" with Auxiliary state "Call held" and Call A-C in state U10 "Active".
    // Both calls shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_Held_A_C_Active(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to join Call A-B and Call A-C
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "MPTY request, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "MPTY request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Result component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); // @sic R5s150542 sic@
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 12" siclog@
    // The DTCH is through connected in both directions.
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12");
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_2_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Beginning the MultiParty service, unsuccessful case */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.4 of TS 34.108.
    // The UE shall have Call A-B in state U10 "Active" with Auxiliary state "Call held" and Call A-C in state U10 "Active".
    // Both calls shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_Held_A_C_Active(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to join Call A-B and Call A-C
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "MPTY request, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "MPTY request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Error component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_UnknownSubscriber))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, no auxiliary state
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10);
    
    // @siclog "Step 12" siclog@
    // Make the UE to join Call A-B and Call A-C
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 13" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 13");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@

    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "MPTY request, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Steps 16&17" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "MPTY request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 17", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Step 18" siclog@
    // FACILITY Reject component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

                             
   
    // @siclog "Steps 19&20" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 20", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
    
    // @siclog "Steps 21&22" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, no auxiliary state
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 22", -, tsc_CallState_U10);
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.3
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_3_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Beginning the MultiParty service, expiry of timer T(BuildMPTY) */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    timer t_Watchdog_30 := f_UG_SetTimerToleranceMax(30.0);
    timer t_Watchdog_5  := f_UG_SetTimerToleranceMin(5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.4 of TS 34.108.
    // The UE shall have Call A-B in state U10 "Active" with Auxiliary state "Call held" and Call A-C in state U10 "Active".
    // Both calls shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_Held_A_C_Active(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to join Call A-B and Call A-C
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    t_Watchdog_5.start;
    t_Watchdog_30.start;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "MPTY request, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "MPTY request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Step 7" siclog@
    //The SS checks that there isn't any further FACILITY to re-attempt the BuildMPTY operation from the UE during 5 seconds after step 2
    t_Watchdog_5.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    alt {
      //Branch A
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd
        {
          t_Watchdog_30.stop;
          // @siclog "Step A9" siclog@
          // FACILITY: TI for Call A-B, BuildMPTY Invoke component
          v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
          if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step A9");
          } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step A9");
          }
          
          // @siclog "Steps A10&A11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "MPTY request, call held"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step A11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
          
          // @siclog "Steps A12&A13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "MPTY request"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step A13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_MptyReq));
        }
      // Branch B
      [] t_Watchdog_30.timeout
        {
          // @siclog "Step B9" siclog@
          // It is checked that the UE has provided an appropriate user indication of the failure
          f_UT_ChkSuppServiceUserIndication(UT, "Multi-party", "MultiParty call failure");
          
          // @siclog "Steps B10&B11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call held"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step B11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
          
          // @siclog "Steps B12&B13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, no auxiliary state
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step B13", -, tsc_CallState_U10);
        }
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.4
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_4_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Put the MultiParty call on hold, successful case */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.5 of TS 34.108.
    // The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY". The call shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to put the MultiParty call on hold
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@

    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Result component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); // @sic R5s150548 sic@
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.5
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_5_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Put the MultiParty call on hold, unsuccessful case */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.5 of TS 34.108.
    // The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY". The call shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to put the MultiParty call on hold
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@

    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Error component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_UnknownSubscriber))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 12" siclog@
    // Make the UE to put the MultiParty call on hold
    f_UT_CallHold(UT);
    
    // @siclog "Step 13" siclog@
    // FACILITY: HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 13");
    }
    
    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@

    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 16&17" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 17", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 18" siclog@
    // FACILITY Reject component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Steps 19&20" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 20", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 21&22" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 22", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.6
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_6_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Put the MultiParty call on hold, expiry of timer T(HoldMPTY) */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    timer t_Watchdog_30 := f_UG_SetTimerToleranceMax(30.0);
    timer t_Watchdog_5  := f_UG_SetTimerToleranceMin(5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.5 of TS 34.108.
    // The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY". The call shall be of telecommunication service TS11
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to put the MultiParty call on hold
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    t_Watchdog_5.start;
    t_Watchdog_30.start;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, hold request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // The SS checks that there isn't any further FACILITY to re-attempt the HoldMPTY operation from the UE during 5 seconds after step 2
    t_Watchdog_5.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    alt {
      //Branch A
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd
        {
          t_Watchdog_30.stop;
          // @siclog "Step A9" siclog@
          // FACILITY: HoldMPTY Invoke component
          v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
          if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step A9");
          } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step A9");
          }
          
          // @siclog "Steps A10&A11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, hold request"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step A11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
          
          // @siclog "Steps A12&A13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, hold request"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step A13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
        }
      // Branch B
      [] t_Watchdog_30.timeout
        { // @siclog "Step B9" siclog@
          // It is checked that the UE has provided an appropriate user indication of the failure
          f_UT_ChkSuppServiceUserIndication(UT, "Multi-party", "MultiParty call on hold failure");
          
          // @siclog "Steps B10&B11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step B11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
          
          // @siclog "Steps B12&B13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY "
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step B13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
        }
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.7
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_7_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Create a private communication with one of the remote parties, successful case */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY". The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, request a private communication with Call A-B
    // Refer to 22.030 cl 6.5.5.1 - HOLD 2X
    f_UT_CallHold(UT, 1);
    
    // @siclog "Step 2" siclog@
    // FACILITY: TI for Call A-B, SplitMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not(match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeSplitMPTY))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Split request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_SplitReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Result component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); // @sic R5s150554 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S_B, cs_FacilityIE_lv(v_FacilityReturn))));
    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, no auxiliary state
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10);
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 12" siclog@
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 12");
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.8
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_8_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Create a private communication with one of the remote parties, unsuccessful case */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: the UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    //   NOTE: The MultiParty call may be setup using the procedure specified in clause 7.2.3.3.1.5 of TS 34.108
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, request a private communication with Call A-B
    // Refer to 22.030 cl 6.5.5.1 - HOLD + 1
    f_UT_CallHold(UT, 1);
    
    // @siclog "Step 2" siclog@
    // FACILITY: TI for Call A-B, SplitMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeSplitMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Split request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_SplitReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Error component //Use the same message content found in clause 9.1.5.2.2 of TS 34.108 with Return Error component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_UnknownSubscriber))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S_B, cs_FacilityIE_lv(v_FacilityReturn))));
    
    // @siclog "Steps 8 & 9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 10 & 11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 12" siclog@
    // Using MMI or AT commands, create a private communication for Call A-B
    f_UT_CallHold(UT, 1);
    
    // @siclog "Step 13" siclog@
    // FACILITY: TI for Call A-B, SplitMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeSplitMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 13");
    }
    
    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Split request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_SplitReq));
    
    // @siclog "Steps 16&17" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 17", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 18" siclog@
    // FACILITY Reject component //Use the same message content found in clause 9.1.5.2.2 of TS 34.108 with Reject component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S_B, cs_FacilityIE_lv(v_FacilityReturn))));
    
    // @siclog "Steps 19&20" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 20", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 21&22" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 22", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.9
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_9_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing an active MultiParty call, Create a private communication with one of the remote parties, expiry of timer T(SplitMPTY) */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    timer t_Watchdog_30 := f_UG_SetTimerToleranceMax(30.0);
    timer t_Watchdog_5  := f_UG_SetTimerToleranceMin(5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: the UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    //   NOTE: The MultiParty call may be setup using the procedure specified in clause 7.2.3.3.1.5 of TS 34.108
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, request a private communication with Call A-B
    // Refer to 22.030 cl 6.5.5.1 - HOLD + 1
    f_UT_CallHold(UT, 1);
    
    // @siclog "Step 2" siclog@
    // FACILITY: TI for Call A-B, SplitMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    t_Watchdog_5.start;
    t_Watchdog_30.start;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeSplitMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Split request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_SplitReq));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 7" siclog@
    // The SS checks that there isn't any further FACILITY to re-attempt the SplitMPTY operation from the UE during 5 seconds after step 2
    t_Watchdog_5.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    alt {
      //Branch A: Take this branch if no message is received within 30s
      [] t_Watchdog_30.timeout
        {
          // @siclog "Steps A8&A9" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step A9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
          
          // @siclog "Steps A10&A11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step A11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
        }
      // Branch B: Take this branch if a message is received within 30s. Message shall not be received less than 5 s after the first FACILITY message
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd
        {
          t_Watchdog_30.stop;
          // @siclog "Step B8" siclog@
          // FACILITY: TI for Call A-B, SplitMPTY Invoke component
          v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
          if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeSplitMPTY)))) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step B8");
          } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step B8");
          }
          
          // @siclog "Steps B9&B10" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Split request"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step B10", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_SplitReq));
          
          // @siclog "Steps B11&B12" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step B12", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
        }
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.10
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_10_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Terminate the entire MultiParty call */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: the UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    //   NOTE: The MultiParty call may be setup using the procedure specified in clause 7.2.3.3.1.5 of TS 34.108
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, terminate the entire MultiParty call
    f_UT_HangupCall(UT);
    
    //Steps 2 and 3 may occur in any order
    interleave {  // @sic R5s150560 sic@
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_B)))
        {   // @siclog "Step 2" siclog@
        }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_C)))
        {   // @siclog "Step 3" siclog@
        }
    }
    
    // @siclog "Steps 4-5" siclog@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_B)));
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_B)));
    
    // @siclog "Steps 6-7" siclog@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_C)));
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_C)));
    
    
    // @siclog "Step 8" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Step 9" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    // @siclog "Step 10" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-C
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_C)));
    
    // @siclog "Step 11" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_C, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 11");
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.11
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_11_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Explicitly disconnect a remote party */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: the UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    //   NOTE: The MultiParty call may be setup using the procedure specified in clause 7.2.3.3.1.5 of TS 34.108
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, clear call A-B
    f_UT_CallResume(UT, 1);
    
    // @siclog "Step 2-4" siclog@
    //DISCONNECT, RELEASE and RELEASE COMPLETE with Transaction identifier of call A-B
    f_UTRAN_CC_DisconnectMO(v_MultiTI_R.A_B);
    
    // @siclog "Step 5" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Step 6" siclog@
    // Transaction identifier of Call A-B, with cause #81 "invalid transaction identifier value"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    
    // @siclog "Step 7-8" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, with auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus( v_TI_S_C, v_MultiTI_R.A_C , "Step 8", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150562 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.12
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_12_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Release from the MultiParty call */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: the UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    //   NOTE: The MultiParty call may be setup using the procedure specified in clause 7.2.3.3.1.5 of TS 34.108
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1-3" siclog@
    //DISCONNECT, RELEASE and RELEASE COMPLETE with Transaction identifier of call A-B
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    
    // @siclog "Step 4" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Step 5" siclog@
    // Transaction identifier of Call A-B, with cause #81 "invalid transaction identifier value"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // @siclog "Step 6-7" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, with auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 7", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150564 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.13
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_13_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Retrieve the held MultiParty call, successful case */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a held MultiParty call to two destinations (Call A-B and Call A-C).
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY, call held". The call shall be of telecommunication service TS11.
    // This state is achieved by the procedure in section 7.2.3.3.1.6 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to retrieve the held MultiParty call
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // Receive Facility RetrieveMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@
    
    // @siclog "Step 3-4" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150566 sic@
    
    // @siclog "Step 5-6" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150566 sic@
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Result component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); //@sic R5s150566 sic@
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Step 8-9" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150566 sic@
    
    // @siclog "Step 10-11" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150566 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.14
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_14_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Retrieve the held MultiParty call, unsuccessful case */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    var TI v_TI;  // @sic R5s170431 sic@
    var boolean v_FacilityTI_A_B_Rcvd; // @sic R5s170431 sic@

    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a held MultiParty call to two destinations (Call A-B and Call A-C).
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY, call held". The call shall be of telecommunication service TS11.
    // This state is achieved by the procedure in section 7.2.3.3.1.6 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to retrieve the held MultiParty call
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // Receive Facility RetrieveMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@
    
    // @siclog "Step 3-4" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150568 sic@
    
    // @siclog "Step 5-6" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty)); //@sic R5s150568 sic@
    
    // @siclog "Step 7" siclog@
    // FACILITY Return Error component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_UnknownSubscriber))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));
                             
    // @siclog "Step 8-9" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // @siclog "Step 10-11" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // @siclog "Step 12" siclog@
    // Make the UE to retrieve the held MultiParty call
    f_UT_CallHold(UT);
    
    // @siclog "Step 13" siclog@
    // Receive Facility RetrieveMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 13");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 13");
    }

    v_FacilityTI_A_B_Rcvd := (v_RRC_DataInd.msg.facilityul.ti == v_MultiTI_R.A_B); // @sic R5s170431 sic@
    
    // @siclog "Step 14-15" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // @siclog "Step 16-17" siclog@
    //STATUS ENQUIRY.Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 17", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // @siclog "Step 18" siclog@
    // FACILITY Reject component
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
    if (v_FacilityTI_A_B_Rcvd){ // @sic R5s170431 sic@
        v_TI := v_TI_S_B;
        v_FacilityTI_A_B_Rcvd := false;
    } else{
        v_TI := v_TI_S_C;
    }
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI, cs_FacilityIE_lv(v_FacilityReturn))));

    
    // @siclog "Step 19-20" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 20", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // @siclog "Step 21-22" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 22", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150568 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.15
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_15_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Retrieve the held MultiParty call, expiry of timer T(RetrieveMPTY) */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    timer t_Watchdog_30 := f_UG_SetTimerToleranceMax(30.0);
    timer t_Watchdog_5  := f_UG_SetTimerToleranceMin(5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a held MultiParty call to two destinations (Call A-B and Call A-C).
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY, call held". The call shall be of telecommunication service TS11.
    // This state is achieved by the procedure in section 7.2.3.3.1.6 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE to retrieve the held MultiParty call
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // Receive Facility RetrieveMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    t_Watchdog_5.start;
    t_Watchdog_30.start;
    
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Step 3-4" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150570 sic@
    
    // @siclog "Step 5-6" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150570 sic@
    
    // @siclog "Step 7" siclog@
    // The SS checks that there isn't any further FACILITY to re-attempt the RetrieveMPTY operation from the UE during 5 seconds after step 2.
    t_Watchdog_5.timeout;
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 7");
    
    // @siclog "Step 8" siclog@
    // The SS waits for 25 seconds to check if the UE re-attempts the RetrieveMPTY operation.
    // If the UE re-attempts the RetrieveMPTY operation then branch A, i.e. steps A9 to A13 are executed, else branch B, i.e. steps B9 to B13 are executed.
    alt {
      //Branch A
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Facility_CallControl((v_MultiTI_R.A_B,v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd
        {
          t_Watchdog_30.stop;
          // @siclog "Step A9" siclog@
          // FACILITY: TI for Call A-B, RetrieveMPTY Invoke component
          v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
          if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step A9");
          } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step A9");
          }
          
          // @siclog "Steps A10&A11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, retrieve request"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step A11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));
          
          // @siclog "Steps A12&A13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, retrieve request"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step A13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));
        }
      // Branch B
      [] t_Watchdog_30.timeout
        { // @siclog "Step B9" siclog@
          // It is checked that the UE has provided an appropriate user indication of the failure
          f_UT_ChkSuppServiceUserIndication(UT, "Multi-party", "MultiParty call Retrieve failure");
          
          // @siclog "Steps B10&B11" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
          f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step B11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
          
          // @siclog "Steps B12&B13" siclog@
          // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
          f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step B13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
        }
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.16
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_16_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Initiate a new call */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var RRC_DATA_IND v_RRC_DataInd;
    var charstring v_NumberToDial := "1234335533"; // Make sure the number is different to previous numbers
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a held MultiParty call to two destinations (Call A-B and Call A-C).
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY, call held".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.6 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, make a new call
    f_UT_RequestCSCall(UT, v_NumberToDial);
    
    // @siclog "Step 2" siclog@
    // CM SERVICE REQUEST
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CMServReq_SS_MO(?))); // @sic R5s150599 sic@
    
    // @siclog "Step 3" siclog@
    // CM SERVICE ACCEPT
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_CM_ServAcc)); //@sic R5s150572 sic@
    
    
    // @siclog "Step 4" siclog@
    // SET UP. TI different from Call A-B or Call A-C (new Call A-D)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_SetupMOCall(cr_BcapSpeechMO))) -> value v_RRC_DataInd;
    v_MultiTI_R.A_D := v_RRC_DataInd.msg.setupul.ti;
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    // @siclog "Step 5" siclog@
    // Transmit Alerting message. Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Alert(v_TI_S_D)));
    
    // @siclog "Step 6" siclog@
    // Transmit Connect message. Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Connect(v_TI_S_D)));
    
    // @siclog "Step 7" siclog@
    // Receive Connect Acknowledge message. Transaction identifier of Call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ConnAck(v_MultiTI_R.A_D)));
    
    // @siclog "Step 8-9" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150572 sic@
    
    // @siclog "Step 10-11" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150572 sic@
    
    // @siclog "Step 12-13" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-D, state U10, no auxiliary state.
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 13", -, tsc_CallState_U10);  //@sic R5s150572 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.17
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_17_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Process a call waiting request */
   
    var Components v_FacilityInvoke;
    var octetstring v_FacilityReturn;
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var TI v_TI_S; //@sic R5s150574 sic@
    var TI v_TI_R;
    var RRC_DATA_IND v_RRC_DataInd;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both calls states shall be U10 "Active" with auxiliary state "Call in MPTY". The UE shall also have a Call A-D in state U7 "Call received".
    // The Multiparty call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1
    // This state is achieved by the procedure in section 7.2.3.3.1.10 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Received(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '0'B);  //@sic R5s150574 sic@
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, place the multiparty call on hold and answer the waiting call
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // Receive HoldMPTY invoke component. Transaction identifier of Call A-B or A-C
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Step 3" siclog@
    // Same TI as step 2, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108 with Return Result component.
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID))));  //@sic R5s150574 sic@
    
    v_TI_R := v_RRC_DataInd.msg.facilityul.ti; //@sic R5s150574 sic@
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));  //@sic R5s150574 sic@
    
    // @siclog "Step 4" siclog@
    //Receive Connect Acknowledge message. Transaction identifier of Call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Connect(v_MultiTI_R.A_D))); //@sic R5s150574 sic@
    
    // @siclog "Step 5" siclog@
    //Transmit Connect message. Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ConnectAck(v_TI_S_D))); //@sic R5s150574 sic@
    
    // @siclog "Step 6-7" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 7", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150574 sic@
    
    // @siclog "Step 8-9" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150574 sic@
    
    // @siclog "Step 10-11" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-D, state U10, no auxiliary state.
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 11", -, tsc_CallState_U10);  //@sic R5s150574 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.18
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_18_UTRAN() runs on UTRAN_PTC
  { /* Using MMI or AT commands, terminate the entire MultiParty call */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var boolean v_DisconnRcvd_A_B := false; //@sic R5s160837 Ch.13 sic@
    var boolean v_DisconnRcvd_A_C := false;
    var boolean v_FailCondition_A_B := false;
    var boolean v_FailCondition_A_C := false;
    
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a held MultiParty call to two destinations (Call A-B and Call A-C).
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY, call held".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.6 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, terminate the entire MultiParty call
    f_UT_CallHoldRelease(UT);
    
    // @siclog "Step 2" siclog@
    //Steps 2 and 3 may occur in any order
    interleave { //@sic R5s160837 Ch.13 sic@
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_B)))
         {
           v_DisconnRcvd_A_B:= true;
           U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_B)));
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_C)))
         {
           v_DisconnRcvd_A_C:= true;
           U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_C)));
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_B)))
         {
            if (v_DisconnRcvd_A_B == false)
            {
               v_FailCondition_A_B := true;
            }
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_C)))
         {
            if (v_DisconnRcvd_A_C == false)
            {
               v_FailCondition_A_C := true;
            }
         }
    }

    if (v_FailCondition_A_B == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-B not received");
    }
    if (v_FailCondition_A_C == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-C not received");
    }
    
    // @siclog "Step 8" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_MultiTI_R.A_B))); //@sic R5s150597 sic@
    
    // @siclog "Step 9" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_TI_S_B, tsc_SS_CauValue_Invalid_TI_Value))); // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    // @siclog "Step 10" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-C
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_MultiTI_R.A_C))); //@sic R5s150597 sic@
    
    // @siclog "Step 11" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_TI_S_C, tsc_SS_CauValue_Invalid_TI_Value))); // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 11");
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.19
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_19_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing a single call and a MultiParty call, Disconnect the single call, single call active */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var octetstring v_FacilityReturn;
    
    timer t_Watchdog_5 := f_UG_SetTimerToleranceMax(5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in
    // MPTY, call held". The UE shall have in addition a single call (A-D) in state U10 "Active" with no auxiliary state.
    // Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.7 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld_A_D_Active(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, clear call A-D
    f_UT_CallResume(UT, 3);
    
    // @siclog "Step 2-4" siclog@
    //DISCONNECT, RELEASE and RELEASE COMPLETE with Transaction identifier of call A-D
    f_UTRAN_CC_DisconnectMO(v_MultiTI_R.A_D);
    
    // @siclog "Step 5" siclog@
    //Wait 5 s from receiving a RELEASE COMPLETE
    t_Watchdog_5.start;
    alt {
      // Branch A: Take this branch if no message is received within 5s
      [] t_Watchdog_5.timeout
        { //Do steps A1-A6
        }
      //Branch B
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Facility_CallControl(v_MultiTI_R.A_B, cr_FacilityIE_lv))) -> value v_RRC_DataInd // @sic R5s160837 Ch. 14 sic@
        {
          t_Watchdog_5.stop;
          // @siclog "Step B1" siclog@
          // FACILITY: TI for Call A-B, RetrieveMPTY Invoke component
          v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
          if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step B1");
          } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step B1");
          }
          
          // @siclog "Step B2" siclog@
          // FACILITY Reject component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108 with Reject component.
          v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_FacilityInvoke[0].invoke.invokeID))));
          U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                                   tsc_RB3,
                                   cs_U_Facility_CallControl(v_TI_S_B, cs_FacilityIE_lv(v_FacilityReturn))));
        }
    }
    
    // @siclog "Step A1-A2/B3-B4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step A2/B4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps A3-A4/B5-B6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step A4/B6", -, tsc_CallState_U10,cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps A5/B7" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_D)));
    
    // @siclog "Steps A6/B8" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_D, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step A6/B8");
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.20
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_20_UTRAN() runs on UTRAN_PTC
  { /* Multi-party, Managing a single call and a MultiParty call, Disconnect the single call, single call held */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in MPTY".
    // The UE shall have in addition a single call (A-D) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.8 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, clear call A-D
    f_UT_CallHoldRelease(UT); // @sic R5s250292 sic@
    
    // @siclog "Step 2-3-4" siclog@
    //DISCONNECT, RELEASE and RELEASE COMPLETE with Transaction identifier of call A-D
    f_UTRAN_CC_DisconnectMO(v_MultiTI_R.A_D); //@sic R5s150601 sic@
    
    // @siclog "Step 5-6" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150601 sic@
    
    // @siclog "Step 7-8" siclog@
    //STATUS ENQUIRY. Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 8", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));  //@sic R5s150601 sic@
    
    // @siclog "Step 9" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_D)));
    
    // @siclog "Step 10" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_D, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.21
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_21_UTRAN() runs on UTRAN_PTC
  { /* Clear all parties of held MultiParty call */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var boolean v_DisconnRcvd_A_B :=false; // @sic R5s160837 Ch. 15 sic@
    var boolean v_DisconnRcvd_A_C :=false;
    var boolean v_FailCondition_A_B := false;
    var boolean v_FailCondition_A_C := false;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in
    // MPTY, call held". The UE shall have in addition a single call (A-D) in state U10 "Active" with no auxiliary state.
    // Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.7 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTYHeld_A_D_Active(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, terminate the held MultiParty call
    f_UT_CallHoldRelease(UT);
    
    //Steps 2 and 3 may occur in any order
    interleave { //@sic R5s150576, R5s160837 Ch. 15 sic@
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_B)))
         {
           v_DisconnRcvd_A_B:=true;
           U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_B)));
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_C)))
         {
           v_DisconnRcvd_A_C:=true;
           U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_C)));
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_B)))
         {
            if (v_DisconnRcvd_A_B == false)
            {
               v_FailCondition_A_B := true;
            }
         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_C)))
         {
            if (v_DisconnRcvd_A_C == false)
            {
               v_FailCondition_A_C := true;
            }
         }
    }
    if (v_FailCondition_A_B == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-B not received");
    }
    if (v_FailCondition_A_C == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-C not received");
    }
    
    // @siclog "Step 8" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Step 9" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    // @siclog "Step 10" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-C
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_C)));
    
    // @siclog "Step 11" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_C, tsc_SS_CauValue_Invalid_TI_Value)));// TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 11");
    
    // @siclog "Step 12-13" siclog@
    // STATUS ENQUIRY - STATUS. Transaction identifier of Call A-D, state U10
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 13", -, tsc_CallState_U10); //@sic R5s150576 sic@
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.22
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_22_UTRAN() runs on UTRAN_PTC
  { /* Clear all parties of active MultiParty call */
   
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var boolean v_DisconnRcvd_A_B:=false; //@sic R5s160837 Ch. 16 sic@
    var boolean v_DisconnRcvd_A_C:=false;
    var boolean v_TimerStarted := false;
    var boolean v_FailCondition_A_B := false;
    var boolean v_FailCondition_A_C := false;
    timer t_Watchdog_5 := f_UG_SetTimerToleranceMax (5.0);
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in MPTY".
    // The UE shall have in addition a single call (A-D) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.8 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, terminate the entire MultiParty call
    f_UT_CallResume(UT);
    
    //Steps 2 and 3 may occur in any order
    interleave {
       [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_B)))
        {   // @siclog "Step 2" siclog@
           v_DisconnRcvd_A_B:=true;
           U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_B)));
        }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_C)))
        {   // @siclog "Step 3" siclog@
          v_DisconnRcvd_A_C:= true;
          U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_C)));
        }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_B)))
         {
            if (v_DisconnRcvd_A_B == false)
            {
               v_FailCondition_A_B := true;
            }
            //Start timer only after receiving first RELEASE COMPLETE
            if ((v_TimerStarted == false) and (v_FailCondition_A_B == false))
            {
               t_Watchdog_5.start;
               v_TimerStarted := true;
            }

         }
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_C)))
         {
            if (v_DisconnRcvd_A_C == false)
            {
               v_FailCondition_A_C := true;
            }
            //Start timer only after receiving first RELEASE COMPLETE
            if ((v_TimerStarted == false) and (v_FailCondition_A_C == false))
            {
               t_Watchdog_5.start;
               v_TimerStarted := true;
            }
         }
    }
    if (v_FailCondition_A_B == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-B not received");
    }
    if (v_FailCondition_A_C == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-C not received");
    }
    
    // @siclog "Step 8" siclog@
    //Wait 5 s from receiving a RELEASE COMPLETE
    alt {
      // Branch A: Take this branch if no message is received within 5s
      [] t_Watchdog_5.timeout
        { //Do steps A9-A14
        }
      //Branch B
      // @siclog "Step B9" siclog@
      // Receive RETRIEVE: TI for Call A-D
      [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                               tsc_RB3,
                                               cr_U_Retrieve(v_MultiTI_R.A_D)))
        {
          t_Watchdog_5.stop;
          
          // @siclog "Step B10" siclog@
          // Send RETRIEVE REJECT
          U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                                   tsc_RB3,
                                   cs_U_RetrieveReject(v_TI_S_D, cs_SS_CauLV(tsc_SS_CauValue_TemporaryFailure))));
        }
    }
    
    // @siclog "Step A9/B11" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Steps A10/B12" siclog@
    // Transaction identifier of Call A-B, with cause #81 "invalid transaction identifier value"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));
    // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Steps A10/B12");
    
    // @siclog "Step A11/B13" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-C
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_C)));
    
    // @siclog "Steps A12/B14" siclog@
    // Transaction identifier of Call A-C, with cause #81 "invalid transaction identifier value"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_C, tsc_SS_CauValue_Invalid_TI_Value)));
    // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Steps A12/B14");
    
    
    // @siclog "Steps A13&A14/B15&B16" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call held"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step A13&A14/B15&B16", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.23
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_23_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Disconnect all calls */
    
    var MultiTI_Type v_MultiTI_R;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var boolean  v_DisconnRcvd_A_B := false; // @sic R5s160837 Ch. 12 sic@
    var boolean  v_DisconnRcvd_A_C := false;
    var boolean  v_DisconnRcvd_A_D := false;
    var boolean v_FailCondition_A_B := false;
    var boolean v_FailCondition_A_C := false;
    var boolean v_FailCondition_A_D := false;
    
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in MPTY".
    // The UE shall have in addition a single call (A-D) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.8 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, terminate all calls
    f_UT_HangupCall(UT);
    
    // @siclog "Step 2-3-4" siclog@
    // The DISCONNECT messages (steps 2, 3, and 4) may occur in parallel. SS shall respond to each DISCONNECT independently as soon as it is received.
    interleave { //@sic R5s150580, R5s160837 Ch.12 sic@
           [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_B)))
            {
               U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_B)));
               v_DisconnRcvd_A_B:=true;
            }
          [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_C)))
            {
              U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_C)));
              v_DisconnRcvd_A_C:=true;
            }
          [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3, cr_U_DisconnectUL(v_MultiTI_R.A_D)))
            {
              U_Dc.send(cas_DataReq_CS(utran_CellDedicated, tsc_RB3, cs_U_ReleaseDL(v_TI_S_D)));
              v_DisconnRcvd_A_D:=true;
            }
          
          [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_B)))
             {
                if (v_DisconnRcvd_A_B == false)
                {
                   v_FailCondition_A_B := true;
                }
             }
          [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_C)))
             {
                if (v_DisconnRcvd_A_C == false)
                {
                   v_FailCondition_A_C := true;
                }
             }
          [] U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, tsc_RB3,  cr_U_ReleaseComplete_CallSS(v_MultiTI_R.A_D)))
             {
                if (v_DisconnRcvd_A_D == false)
                {
                   v_FailCondition_A_D := true;
                }
             }
    }
    if (v_FailCondition_A_B == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-B not received");
    }
    if (v_FailCondition_A_C == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-C not received");
    }
    if (v_FailCondition_A_D == true)
    {
       f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Disconnect for Call A-D not received");
    }
    
    // @siclog "Step 11" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-B
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_B)));
    
    // @siclog "Step 12" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value. Transaction identifier of call A-B
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_B, tsc_SS_CauValue_Invalid_TI_Value)));  // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 12");
    
    // @siclog "Step 13" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-C
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_C)));
    
    // @siclog "Step 14" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value. Transaction identifier of call A-C
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_C, tsc_SS_CauValue_Invalid_TI_Value)));  // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    
    // @siclog "Step 15" siclog@
    //STATUS ENQUIRY. Transaction identifier of call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_StatusEnquiry(v_TI_S_D)));
    
    // @siclog "Step 16" siclog@
    // UE sends the Release Complete message with Cause = Invalid transaction identifier value. Transaction identifier of call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ReleaseComplete_Cau(v_MultiTI_R.A_D, tsc_SS_CauValue_Invalid_TI_Value)));  // TS24008 Annex H.5.1: Cause No. 81
    f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 16");
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
  
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.24
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_24_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Add the single call to the MPTY, successful case */
   
    var MultiTI_Type v_MultiTI_R;
    var octetstring v_FacilityReturn;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_S;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in MPTY".
    // The UE shall have in addition a single call (A-D) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.8 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, join the single call to the MultiParty call
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C, v_MultiTI_R.A_D),
                                                                    cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 7&8" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "MPTY request, Call held"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 8", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);   //@sic R5s150582 sic@
    // @siclog "Step 9" siclog@
    // FACILITY: Same TI as step 2, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));
    
    // @siclog "Steps 10&11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 12&13" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 16" siclog@
    // Check that the DTCH is through-connected
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 16");
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.25
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_25_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Add the single call to the MPTY, maximum number of participants exceeded */
    
    var MultiTI_Type v_MultiTI_R;
    var octetstring v_FacilityReturn;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_S;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    var TI v_TI_S_E;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to three destinations (A-B, A-C and A-D) all in state U10 "Active" with auxiliary state "Call in MPTY". The UE shall have in addition a single call (A-E) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in clause 7.2.3.3.1.9 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_A_D_Active_CallMPTY_A_E_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    v_TI_S_E := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_E, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, join the single call to the MultiParty call
    f_UT_CallMPTY(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C, v_MultiTI_R.A_D, v_MultiTI_R.A_E),
                                                                        cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Steps 3&4" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 4", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 5&6" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 6", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));

    // @siclog "Steps 7&8" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 8", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 9&10" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-E, state U10, auxiliary state "MPTY request, Call held"
    f_UTRAN34_CheckStatus(v_TI_S_E, v_MultiTI_R.A_E, "Step 10", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_MptyReq));
    
    // @siclog "Step 11" siclog@
    // FACILITY: Same TI as step 2, Return error component "MaxNumberOfMPTY-ParticipantsExceeded"
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvoke[0].invoke.invokeID, tsc_ErrorCode_MaxNumberOfMPTY_ParticipantsExceeded))));
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);   //@sic R5s150584 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));
                             
    // @siclog "Steps 12&13" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 16&17" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 17", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 18&19" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-E, state U10, auxiliary state "Call Held"
    f_UTRAN34_CheckStatus(v_TI_S_E, v_MultiTI_R.A_E, "Step 19", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN_CC_Disconnect(v_TI_S_E);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.26
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_26_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Alternate between the MPTY call and the single call */
   
    var MultiTI_Type v_MultiTI_R;
    var octetstring v_FacilityReturn;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_S;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: The UE shall have a MultiParty call to two destinations (A-B and A-C) both in state U10 "Active" with auxiliary state "Call in MPTY".
    // The UE shall have in addition a single call (A-D) in state U10 "Active" with auxiliary state "Call held". Both calls shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    // This state is achieved by the procedure in section 7.2.3.3.1.8 of TS 34.108.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY_A_D_Held(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, alternate between the active and held calls
    f_UT_CallHold(UT);
    
    // @siclog "Step 2" siclog@
    // FACILITY: TI for Call A-B or call A-C, HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Step 3" siclog@
    // Receive RETRIEVE: Transaction identifier of Call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Retrieve(v_MultiTI_R.A_D)));
    
    // @siclog "Steps 4&5" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, Hold request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 5", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 6&7" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, Hold request
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 7", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 8&9" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 9", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_Idle));
    
    // @siclog "Step 10" siclog@
    // FACILITY: Same TI as step 2, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID))));   //@sic R5s150542 sic@
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);   //@sic R5s150586 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));
    
    // @siclog "Steps 11" siclog@
    // Send RETRIEVE ACKNOWLEDGE: Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_RetrieveAck(v_TI_S_D)));
    
    // @siclog "Steps 12&13" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, Call held"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, Call held"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 16&17" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, no auxiliary state
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 17", -, tsc_CallState_U10, omit);
    
    // @siclog "Step 18" siclog@
    // Check that the DTCH is through-connected
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 18");
    }
    
    // @siclog "Step 19" siclog@
    // Using MMI or AT commands, alternate between the active and held calls
    f_UT_CallHold(UT);
    
    // @siclog "Step 20" siclog@
    // HOLD: Transaction identifier of Call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Hold(v_MultiTI_R.A_D)));
    
    // @siclog "Step 21" siclog@
    // FACILITY: TI for Call A-B or call A-C, RetrieveMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeRetrieveMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 21");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 21");
    }
    
    // @siclog "Steps 22&23" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY, Retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 23", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 24&25" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY, Retrieve request"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 25", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_RetrieveReq, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 26&27" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Hold request"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 27", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_HoldReq, tsc_AuxiliaryState_Idle));
    
    // @siclog "Steps 28" siclog@
    // Send Hold ACK: Transaction identifier of Call A-D
    U_Dc.send (cas_DataReq_CS (utran_CellDedicated,
                               tsc_RB3,
                               cs_U_HoldAck (v_TI_S_D)));
    
    // @siclog "Steps 29" siclog@
    // FACILITY: Same TI as step 21, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID))));   //@sic R5s150542 sic@
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);   //@sic R5s150586 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));
    
    
    // @siclog "Steps 30&31" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 31", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 32&33" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 33", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 34&35" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call held"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 35", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_CallHeld, tsc_AuxiliaryState_Idle));
    
    // @siclog "Step 36" siclog@
    // Check that the DTCH is through-connected
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 36");
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.7.27
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_7_27_UTRAN() runs on UTRAN_PTC
  { /* Multi-party supplementary services, Adding extra remote parties */
  // @sic R5-153967 sic@
   
    var MultiTI_Type v_MultiTI_R;
    var octetstring v_FacilityReturn;
    var Components v_FacilityInvoke;
    var RRC_DATA_IND v_RRC_DataInd;
    var charstring v_NumberToDial := "4812162024"; // Make sure the number is different to previous numbers
    var TI v_TI_S;
    var TI v_TI_S_B;
    var TI v_TI_S_C;
    var TI v_TI_S_D;
    
    // Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    // Initial conditions: procedure in section 7.2.3.3.1.5 of TS 34.108.
    // The UE shall have a MultiParty call to two destinations (Call A-B and Call A-C) active.
    // Both call states shall be U10 "Active" with auxiliary state "Call in MPTY".
    // The call shall be of a basic service supported by the UE and relevant to the MultiParty supplementary service as stated in 3GPP TS 22.004 table A.1.
    v_MultiTI_R := f_UTRAN34_CallA_B_A_C_Active_CallMPTY(utran34_Cell1);
    v_TI_S_B := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_B, '1'B);
    v_TI_S_C := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_C, '1'B);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Using MMI or AT commands, put the MultiParty call on Hold and to establish a new call
    f_UT_CallHold(UT);
    f_UT_RequestCSCall (UT, v_NumberToDial);
    
    // @siclog "Step 2" siclog@
    // FACILITY: TI for Call A-B or call A-C, HoldMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C), cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeHoldMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
    }
    
    // @siclog "Step 3" siclog@
    // FACILITY: Same TI as step 2, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); // @sic R5s150542 sic@
    
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn))));
                             
    // @siclog "Step 3B - 3C" siclog@
    // CM SERVICE REQUEST
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SS_MO(?))); // @sic R5s150621 sic@
    // CM SERVICE ACCEPT
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_CM_ServAcc)); // @sic R5s150621 sic@

    // @siclog "Step 4" siclog@
    // SET UP. TI different from Call A-B or Call A-C (new Call A-D)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_SetupMOCall(cr_BcapSpeechMO))) -> value v_RRC_DataInd;
    v_MultiTI_R.A_D := v_RRC_DataInd.msg.setupul.ti;
    v_TI_S_D := f_NAS_TI_InitAndSetFlag(v_MultiTI_R.A_D, '1'B);
    
    // @siclog "Step 5" siclog@
    // Transmit Alerting message. Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Alert(v_TI_S_D)));
    
    // @siclog "Step 6" siclog@
    // Transmit Connect message. Transaction identifier of Call A-D
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Connect(v_TI_S_D)));
    
    // @siclog "Step 7" siclog@
    // Receive Connect Acknowledge message. Transaction identifier of Call A-D
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_ConnAck(v_MultiTI_R.A_D)));
    
    // @siclog "Step 7A" siclog@
    f_UT_CallMPTY (UT); // @sic R5s150621 sic@
    
    // @siclog "Step 8" siclog@
    // FACILITY: TI for Call A-B, Call A-C or call A-D, BuildMPTY Invoke component
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility_CallControl((v_MultiTI_R.A_B, v_MultiTI_R.A_C, v_MultiTI_R.A_D),
                                                                                      cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityInvoke := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (match(v_FacilityInvoke, cr_Components(cr_InvokeComponent(cr_InvokeBuildMPTY)))) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
    }
    
    // @siclog "Step 9" siclog@
    // FACILITY: Same TI as step 8, Return Result component. Use the same message content found in clause 9.1.5.2.2 of TS 34.108
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResult_Empty_Result(v_FacilityInvoke[0].invoke.invokeID)))); // @sic R5s150542 sic@
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.facilityul.ti, '1'B);  // @sic R5s150621 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_FacilityReturn)))); // @sic R5s150621 sic@
    
    // @siclog "Steps 10&11" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-B, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_B, v_MultiTI_R.A_B, "Step 11", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 12&13" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-C, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_C, v_MultiTI_R.A_C, "Step 13", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Steps 14&15" siclog@
    // STATUS ENQUIRY- STATUS: Transaction identifier of Call A-D, state U10, auxiliary state "Call in MPTY"
    f_UTRAN34_CheckStatus(v_TI_S_D, v_MultiTI_R.A_D, "Step 15", -, tsc_CallState_U10, cr_AuxiliaryStates(tsc_AuxiliaryState_Idle, tsc_AuxiliaryState_CallInMpty));
    
    // @siclog "Step 16" siclog@
    // Check that the DTCH is through-connected
    if (not f_UT_CheckDTCH_ThroughConn(UT)) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 16");
    }
    
    // Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_B);
    f_UTRAN_CC_Disconnect(v_TI_S_C);
    f_UTRAN_CC_Disconnect(v_TI_S_D);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

}
