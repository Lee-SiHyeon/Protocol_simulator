  template (value) SDP_attribute_list cs_SDP_PreconditionAttributes(charstring p_DirectionLocal,
                                                                    charstring p_DirectionRemote,
                                                                    charstring p_StrengthLocal := c_mandatory,
                                                                    charstring p_StrengthRemote := c_mandatory) :=
  { /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, LTE_IRAT, NR5GC, NR5GC_IRAT) */
    cs_SDP_Attribute_curr_qos(c_local, p_DirectionLocal),
    cs_SDP_Attribute_curr_qos(c_remote, p_DirectionRemote),
    cs_SDP_Attribute_des_qos(p_StrengthLocal, c_local),
    cs_SDP_Attribute_des_qos(p_StrengthRemote, c_remote)
  };

  template (omit) SDP_attribute_list cs_SDP_PreconditionAttributesWithConf(charstring p_DirectionLocal,
                                                                           charstring p_DirectionRemote,
                                                                           charstring p_StrengthLocal := c_mandatory,
                                                                           charstring p_StrengthRemote := c_mandatory) :=
    /* @status    APPROVED (IMS, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R12, NR5GC, NR5GC_IRAT) */
    f_SDP_Attributes_Add_TX(cs_SDP_PreconditionAttributes(p_DirectionLocal, p_DirectionRemote, p_StrengthLocal, p_StrengthRemote), cs_SDP_Attribute_conf_qos);

  template (present) SDP_attribute_list cr_SDP_PreconditionAttributes(template (present) charstring p_DirectionLocal,
