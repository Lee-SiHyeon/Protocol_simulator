module CLIP_CLIR_CNAP {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from SS_CommonFunctions all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_RRC_CommonFunctions all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  template (value) NameIndicator cs_NameIndicator(charstring p_NameString) :=
  { /* @status    APPROVED (SSNITZ) */
    callingName := {
      namePresentationAllowed := {
        dataCodingScheme      := '0F'O,
        lengthInCharacters    := lengthof (p_NameString),
        nameString            := f_CharPacking_IA5toGsm7Bit(p_NameString, USSD_Packing) // @sic R5s140990 sic@
      }
    }
  };

  template (value) TypeOfNumPlan cs_TypeOfNum_International :=
  { /* @status    APPROVED (SSNITZ) */
    extBit        := '0'B,                // extension bit @sic R5s150437 sic@
    typeOfNum     := '001'B,             // Type of number
    numbPlanId    := '0001'B             // Numbering plan id.
  };

  template (value) PresentIndScreeningInd cs_PresentIndScreeningInd :=
  { /* @status    APPROVED (SSNITZ) */
    extBit        :=  '1'B,                // extension bit
    presentInd    := '00'B,            // presentation indicator
    spare3        := '000'B,                // 3 spare bits
    screeningInd  := '11'B         // screening indicator
  };

  template (value) CGPN cs_CallingPartyNumber(octetstring p_Number) :=
  { /* @status    APPROVED (SSNITZ) */
    iei           := '5C'O,
    iel           := int2oct(2 + lengthof(p_Number), 1),                   // length
    typeOfNumPlan := cs_TypeOfNum_International,         // type of number and numbering plan identification
    presentIndScreeningInd    := cs_PresentIndScreeningInd, // Presentation indicator & screening indicator
    digits        := p_Number // numbers
  };

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.1.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_1_1_UTRAN() runs on UTRAN_PTC
  { /* CLIP / Normal Operation */
    var charstring v_CallingNumber := "12345667890";
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_UTRAN_PageCS(utran34_Cell1, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, ?);
    
    // @siclog "Step 2" siclog@
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, ?)));
    
    // @siclog "Step 3 - 4" siclog@
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 5 - 6" siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    
    // @siclog "Step 7" siclog@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_SetupMTCall_SS(cs_BcapSpeechMT, -, -, -, cs_CallingPartyNumber(f_CharPacking_IA5toBCD(v_CallingNumber)))));
    
    // @siclog "Step 8" siclog@
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CallConfirmed(?)));
    
    // @siclog "Step 9" siclog@
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Alerting(?)));
    
    // @siclog "Step 10" siclog@
    if (f_UT_ChkCallDisplayed(UT, "+" & v_CallingNumber)) { // @sic R5s150084, R5s160864 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
    }
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(cs_TI_MT); // @sic R5s140611 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.2.X
   * @param     p_TestCaseNumber
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_2_X_UTRAN(integer p_TestCaseNumber) runs on UTRAN_PTC
  {
    var charstring v_CallingNumber := "12345567890";
    var template (present) EstablishmentCause v_EstCause := originatingConversationalCall;
    var START_Value v_START_Value := '00000000000000000000'B;
    var RRC_DATA_IND v_RRC_DataInd;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    
    select (p_TestCaseNumber) {
      case (1) {
        f_UT_SupplementaryService_CLIR(UT, DEACTIVATE_MODE);  // @sic R5s104613 R5s104615 sic@
      }
      case (2) {
        f_UT_SupplementaryService_CLIR(UT, ACTIVATE_MODE);   // @sic R5s104613 R5s104615 sic@
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid Test Case Number");
      }
    }
    
    // Establishment cause: Originating Conversational Call
    f_UT_RequestCSCall(UT, v_CallingNumber);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Steps 1-3" siclog@
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, v_EstCause);
    
    // @siclog "Step 4" siclog@
    // Receive CM Service Request
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SS_MO(?))) -> value v_RRC_DataInd; // @sic R5s140613, R5-153983 sic@
    
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    // @siclog "Step 5-6" siclog@
    // Authentication Request/Response
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 7-8" siclog@
    // SECURITY MODE COMMAND - SECURITY MODE COMPLETE
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    // Step 9 SET UP
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_SetupMOCall(cr_BcapSpeechMO))) -> value v_RRC_DataInd;
    
    select (p_TestCaseNumber) {
      case (1) {
        if (not ispresent(v_RRC_DataInd.msg.setupul.cLIR_Suppression)) {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "CLIR Suppression IE not present");
        }
        if (v_RRC_DataInd.msg.setupul.cLIR_Suppression != '10100001'B){
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "CLIR Suppression IE was not correctly set");
        }else{
          f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
        }
      }
      case (2) {
        if (not ispresent(v_RRC_DataInd.msg.setupul.cLIR_Invocation)) {
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "CLIR Invocation IE not present");
        }
        if (v_RRC_DataInd.msg.setupul.cLIR_Invocation != '10100010'B){
          f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "CLIR Invocation IE was not correctly set");
        }
        else {
          f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 9");
        }
      }
    }
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(); // @sic R5s140611 sic@ @sic R5s141152 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.2.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_2_1_UTRAN() runs on UTRAN_PTC
  { /* CLIR / Normal operation - requesting presentation of CLI */
    f_TC_15_2_X_UTRAN(1);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.2.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_2_2_UTRAN() runs on UTRAN_PTC
  { /* CLIR / Normal operation - requesting restriction of CLI presentation */
    f_TC_15_2_X_UTRAN(2);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.3.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_3_1_UTRAN() runs on UTRAN_PTC
  { /* CNAP / Normal Operation */
    var charstring v_Name := "TESTNAME";
    var octetstring v_EncodedComponents;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UT_SupplementaryService_CNAP(UT, ACTIVATE_MODE); // @sic R5s140990 sic@
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_UTRAN_PageCS(utran34_Cell1, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, ?);
    
    // @siclog "Step 2" siclog@
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, ?)));
    // @siclog "Step 3 - 4" siclog@
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 5 - 6" siclog@
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    // Set up the upper tester to receive an unsolicited response
    f_UT_TriggerCNAPResponse (UT, v_Name); //  @sic R5-153746 sic@

    // @siclog "Step 7" siclog@
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeNotify(tsc_InvokeId, '19'O, -, -, -, -, -, cs_NameIndicator(v_Name))))); // @sic R5s140990 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_SetupMTCall_SS(cs_BcapSpeechMT, -, cs_FacilityIE_tlv(v_EncodedComponents))));
    
    // @siclog "Step 8" siclog@
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CallConfirmed(?)));
    
    // @siclog "Step 9" siclog@
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Alerting(?)));
    
    // @siclog "Step 10" siclog@
    if (f_UT_ChkNameDisplayed(UT, """" & v_Name & """")) { // @sic R5s140990, R5s150084, R5s150228 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
    }
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(cs_TI_MT); // @sic R5s140611 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.3.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_3_2_UTRAN() runs on UTRAN_PTC
  { /* CNAP/Normal Operation: Name indication contained in Facility message */
    var charstring v_Name := "TESTNAME";
    var octetstring v_EncodedComponents;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    f_UT_SupplementaryService_CNAP(UT, ACTIVATE_MODE); // @sic R5s140992 sic@
    
    // @siclog "Step 1" siclog@
    // Mobile terminated establishment of Radio Resource Connection
    f_UTRAN_PageCS(utran34_Cell1, terminatingConversationalCall, oct2bit(px_TMSI_Def));
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, ?);
    
    // @siclog "Step 2" siclog@
    // PAGING RESPONSE
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_PagRsp(?, ?)));
    // @siclog "Step 3 - 4" siclog@
    // AUTHENTICATION REQUEST/RESPONSE
    f_UTRAN_MM_Authentication();
    
    // @siclog "Step 5 - 6" siclog@
    // SECURITY MODE COMMAND/COMPLETE
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    // @siclog "Step 7" siclog@
    // Send SETUP
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_SetupMTCall_SS(cs_BcapSpeechMT, -, -))); // @sic R5s140992 sic@
    
    // @siclog "Step 8" siclog@
    // Receive CALL CONFIRMED
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_CallConfirmed(?)));
    // @siclog "Step 9" siclog@
    // Receive ALERTING message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Alerting(?)));
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '0'B); // @sic R5s140992 sic@
    
    // Set up the upper tester to receive an unsolicited response
    f_UT_TriggerCNAPResponse (UT, v_Name); //  @sic R5-153746 sic@

    // @siclog "Step 10" siclog@
    // Send FACILITY
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeNotify(tsc_InvokeId, '19'O, -, -, -, -, -, cs_NameIndicator(v_Name))))); // @sic R5s140990 sic@
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility_CallControl(v_TI_S, cs_FacilityIE_lv(v_EncodedComponents)))); // @sic R5s140992 sic@
    
    // @siclog "Step 11" siclog@
    // The UE shall display the calling nameIndicator.
    if (f_UT_ChkNameDisplayed(UT, """" & v_Name & """")) { // @sic R5s140990, R5s150084, R5s150228 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 11");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 11");
    }
    
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(cs_TI_MT); // @sic R5s140611 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.3.3
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_3_3_UTRAN() runs on UTRAN_PTC
  { /* CNAP/Interrogation accepted */
    var octetstring v_EncodedComponents;
    var octetstring v_Octetstring;
    var InvokeIdType v_InvokeId := 0;
    var START_Value v_START_Value := '00000000000000000000'B;
    var Components v_Components;
    var TI v_TI_S;
    var RRC_DATA_IND v_RRC_DataInd;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate an interrogation of CNAP (all basic service groups)
    f_UT_SupplementaryService_CNAP(UT, QUERY_MODE);
    
    f_UTRAN34_RRC_ConnEst(utran34_Cell1, ?);
    
    // @siclog "Step 2" siclog@
    // The UE sends CM SERVICE REQUEST with the IE "CM service type" set to "supplementary service activation"
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        cr_U_CMServReq_SSDef(?))) -> value v_RRC_DataInd;
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value);
    
    // @siclog "Step 2A-2B" siclog@
    //@sic R5-144250 sic@
    f_UTRAN_MM_Authentication();
    
    // Security  procedure
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);
    
    // @siclog "Step 3" siclog@
    //The SS starts integrity protection
    
    // @siclog "Step 4" siclog@
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_InvokeInterrogate(?, cr_SS_ForBS_Code('19'O))))))  {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_RRC_DataInd.msg.register.ti, '1'B);
    
    // Set up the upper tester to receive an unsolicited response
    f_UT_TriggerCNAPResponse (UT, int2str(1)); //  @sic R5-153746 sic@
       
    // @siclog "Step 5" siclog@
    // Send RELEASE COMPLETE message Return Result = InterrogateSS (ss-status)
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultInterrogate_SSStatus(v_InvokeId, '04'O))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv (v_EncodedComponents))));
    
    // @siclog "Step 5A" siclog@
    //Release RRC Connection
    f_UTRAN34_RRC_ConnRel(utran34_Cell1, cell_Dch); // @sic R5s160868 R5-168383 sic@

    // @siclog "Step 6" siclog@
    // The UE shall display the return result of the Interrogate operation
    if (f_UT_ChkCNAPQueryResponse(UT, 1)) { // @sic R5s160868 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
        
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_Postamble(utran34_Cell1, U1_IDLE);
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.3.4
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_3_4_UTRAN() runs on UTRAN_PTC
  { /* CNAP/Interrogation rejected */
    var octetstring v_EncodedComponents;
    var octetstring v_Octetstring;
    var InvokeIdType v_InvokeId := 0;
    var Components v_Components;
    var TI v_TI_S;
    var TI v_TI_R;
    var TI v_TI_Call_R;
    var TI v_TI_Call_S;
    var RRC_DATA_IND v_RRC_DataInd;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    // Cell1 started switched on with default power level
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    // Setup MO CS call  34.108 cl. 7.2.3.2
    f_UTRAN34_Preamble(utran34_Cell1);
    v_TI_Call_R := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); // @sic R5-145740 R5s160861 sic@
    v_TI_Call_S := f_NAS_TI_InitAndSetFlag(v_TI_Call_R, '1'B);  //@sic R5s160861 sic@
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate an interrogation for CNAP (all).
    f_UT_SupplementaryService_CNAP(UT, QUERY_MODE);
    
    // @siclog "Step 2" siclog@
    // The UE sends CM SERVICE REQUEST cause: "supplementary service activation"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,  //@sic R5s160018 sic@
                                          tsc_RB3,
                                          cr_U_CMServReq_SSDef(?)))-> value v_RRC_DataInd;
    
    // Security  procedure
    //f_UTRAN34_RRC_Security(utran34_Cell1, false, cs_domain); @sic R5s160143 sic@
    
    // @siclog "Step 3" siclog@
    // CM SERVICE ACCEPT
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_CM_ServAcc));
    // @siclog "Step 4" siclog@
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_InvokeInterrogate(?, cr_SS_ForBS_Code('19'O))))))  {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_R := v_RRC_DataInd.msg.register.ti;
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
    // @siclog "Step 5" siclog@
    // Send RELEASE COMPLETE message Return_error = SS not available
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode (v_InvokeId, tsc_ErrorCode_SSNotAvailable))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents), cs_SS_Cau(tsc_SS_CauValue_RequestedFacilityNotSubscribed)))); // @sic R5s160018 sic@
    
    // @siclog "Step 6" siclog@
    // The UE shall display the response from SS
    if (f_UT_ChkSuppServiceUserIndication(UT, "CNAP", "SS Not Available")) { // @sic R5s160018, R5a160869 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
    
    // @siclog "Step 7-8" siclog@
    // STATUS ENQUIRY - STATUS: CC state U10
    f_UTRAN34_CheckStatus(v_TI_Call_S,  v_TI_Call_R,  "Step 8", -, tsc_CallState_U10); //@sic R5s160861 sic@
    
    // @siclog "Step 9" siclog@
    // The UE is made to initiate an interrogation for CNAP (all).
    f_UT_SupplementaryService_CNAP(UT, QUERY_MODE);
    
    // @siclog "Step 10" siclog@
    // The UE sends CM SERVICE REQUEST cause: "supplementary service activation"
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated, // @sic R5s160018 sic@
                                          tsc_RB3,
                                          cr_U_CMServReq_SSDef(?)))-> value v_RRC_DataInd;
    
    // @siclog "Step 11" siclog@
    // CM SERVICE ACCEPT
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_CM_ServAcc));
    
    // @siclog "Step 12" siclog@
    // Receive REGISTER message
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_RegisterMO(cr_FacilityIE_tlv,
                                                          cr_SS_VersionIndAny))) -> value v_RRC_DataInd;
    
    v_Octetstring := v_RRC_DataInd.msg.register.facility_Str.components;
    v_Components := f_SS_ComponentsDecode(v_Octetstring);
    if (not match(v_Components, cr_Components(cr_InvokeComponent(cr_InvokeInterrogate(?, cr_SS_ForBS_Code('19'O))))))  {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Components do not match to template");
    }
    
    // Get invokeID sent by the UE, to be used in SS response
    v_InvokeId := v_Components[0].invoke.invokeID;
    
    // Set TI value for response to be sent from the SS
    v_TI_R := v_RRC_DataInd.msg.register.ti;
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
        
    // @siclog "Step 13" siclog@
    // Send RELEASE COMPLETE message Invoke_problem = Resource Limitation
    v_EncodedComponents := f_SS_EncodeComponents(cs_Components(cs_ReturnReject(cs_Reject_ResourceLimitation(v_InvokeId)))); //Problem resourceLimitation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_EncodedComponents), cs_SS_Cau(tsc_SS_CauValue_ResourcesUnavailableUnspecified))));  // @sic R5s160018 sic@
    // @siclog "Step 14" siclog@
    // The UE shall display the response from SS
    if (f_UT_ChkSuppServiceUserIndication(UT, "CNAP", "Resource Limitation")) { // @sic R5s160018, R5s160869 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
    }
    
    // @siclog "Step 15-16" siclog@
    // STATUS ENQUIRY - STATUS: CC state U10
    f_UTRAN34_CheckStatus(v_TI_Call_S,  v_TI_Call_R,  "Step 16", -, tsc_CallState_U10); //@sic R5s160861 sic@
     
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_Call_S); // @sic R5s140611 R5s160018 R5s160861 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

}
