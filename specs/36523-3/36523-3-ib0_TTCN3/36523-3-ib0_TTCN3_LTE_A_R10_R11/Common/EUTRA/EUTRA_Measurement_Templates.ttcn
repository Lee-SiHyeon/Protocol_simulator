module EUTRA_Measurement_Templates {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from EUTRA_AuxiliaryFunctions all;
  import from EUTRA_CommonDefs all;
  import from EUTRA_RRC_Templates all;

  type integer EUTRA_RS_EPRE_Type (-141..-44);                  /* Changed from formerly (-140..-43);   @sic R5-090153 sic@
                                                                   @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11, LTE_IRAT) */

  type integer A3_Offset_Type (-30..30);                        /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11) */

  type ReportConfigToAddMod.reportConfig ReportConfigToAddMod_ReportConfig_Type;                    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  type ReportConfigEUTRA.triggerType ReportConfigEUTRA_Trigger_Type;                                /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  type ReportConfigEUTRA.triggerType.event.eventId ReportConfigEUTRA_Trigger_EventId_Type;          /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */

  const integer tsc_IdMeasObject_f1 := 1;                       /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) @sic R5-190673 sic@*/

  const integer tsc_IdMeasObject_f2 := 2;                       /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11) */

  const integer tsc_IdMeasObject_f3 := 3;                       /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  const integer tsc_IdMeasObject_f5 := 5;                       /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  const integer tsc_IdMeasObject_f6 := 6;                       /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  const integer tsc_IdReportConfig_A1 := 1;                     /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  const integer tsc_IdReportConfig_A2 := 2;                     /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT) */

  const integer tsc_IdReportConfig_A3 := 3;                     /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R10_R11) */

  const integer tsc_IdReportConfig_A4 := 6;                     /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  const integer tsc_IdReportConfig_A5 := 7;                     /* @status    APPROVED (LTE, LTE_A_R10_R11) */

  template (value) DL_DCCH_Message cs_508_RRCConnectionReconfiguration_ConditionMEAS(RRC_TransactionIdentifier p_RRC_TI,
                                                                                     template (omit) MeasConfig p_MeasConfig ) :=
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    cs_RRCConnectionReconfiguration_Common( p_RRC_TI, p_MeasConfig, omit, omit, omit );

  template (value) MeasConfig cs_MeasConfig(template (omit) MeasObjectToRemoveList p_MeasObjectToRemoveList,
                                            template (omit) MeasObjectToAddModList p_MeasObjectToAddModList,
                                            template (omit) ReportConfigToRemoveList p_ReportConfigToRemoveList,
                                            template (omit) ReportConfigToAddModList p_ReportConfigToAddModList,
                                            template (omit) MeasIdToRemoveList p_MeasIdToRemoveList,
                                            template (omit) MeasIdToAddModList p_MeasIdToAddModList,
                                            template (omit) QuantityConfig p_QuantityConfig := cs_QuantityConfig_Def, //@sic R5-134645, R5s130965 (R5-140743) sic@
                                            template (omit) MeasGapConfig p_MeasGapConfig := omit,
                                            template (omit) RSRP_Range p_RSRP_Range := omit,
                                            template (omit) PreRegistrationInfoHRPD p_HRPD_PreRegistrationInfo := omit,
                                            template (omit) MeasConfig.speedStatePars p_SpeedStatePars := omit,
                                            template (omit) MeasObjectToAddModList_v9e0 p_MeasObjectToAddModList_v9e0 := omit,
                                            template (omit) boolean p_Fr1_Gap_r15 := omit,
                                            template (omit) boolean p_Mgta_r15 := omit) :=
  { /* @sic R5s100477 Additional Changes: merge of cs_MeasConfig and cs_MeasConfig_Common sic@ */
    /* @sic R5-169116: added p_MeasObjectToAddModList_v9e0 sic@ */
    /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    measObjectToRemoveList   := p_MeasObjectToRemoveList,
    measObjectToAddModList   := p_MeasObjectToAddModList,
    reportConfigToRemoveList := p_ReportConfigToRemoveList,
    reportConfigToAddModList := p_ReportConfigToAddModList,
    measIdToRemoveList       := p_MeasIdToRemoveList,
    measIdToAddModList       := p_MeasIdToAddModList,
    quantityConfig           := p_QuantityConfig,
    measGapConfig            := p_MeasGapConfig,
    s_Measure                := p_RSRP_Range,
    preRegistrationInfoHRPD  := p_HRPD_PreRegistrationInfo,
    speedStatePars           := p_SpeedStatePars,
    measObjectToAddModList_v9e0 := p_MeasObjectToAddModList_v9e0,       /* @sic R5s130195 BASELINE MOVING 2013 R5-169116 sic@ */
    allowInterruptions_r11      := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measScaleFactor_r12         := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measIdToRemoveListExt_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measIdToAddModListExt_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measRSRQ_OnAllSymbols_r12   := omit,       /* @sic BASELINE MOVING 2015 sic@ */
    measObjectToRemoveListExt_r13 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measObjectToAddModListExt_r13 := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measIdToAddModList_v1310      := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measIdToAddModListExt_v1310   := omit,     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
    measGapConfigPerCC_List_r14   := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    measGapSharingConfig_r14      := omit,     /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
    fr1_Gap_r15  := p_Fr1_Gap_r15,                      /* @sic R5s180271 BASELINE MOVING 2018 Phase 1 R5s180412 BASELINE MOVING 2018-2 sic@ */
    mgta_r15  := p_Mgta_r15,                         /* @sic R5s180412 BASELINE MOVING 2018-2 sic@ */
    measGapConfigDensePRS_r15  := omit,        /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    heightThreshRef_r15  := omit,              /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
    timeMeasConfig_r18     := omit,            /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
    locationMeasConfig_r18 := omit             /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
  };

  template (value) MeasObjectToRemoveList cs_MeasObjectToRemoveList_1Entry( MeasObjectId p_MeasObjectId ) :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11) */
    p_MeasObjectId
  };

  template (value) MeasObjectToAddModList cs_MeasObjectToAddModList_1Entry(MeasObjectId p_MeasObjectId,
                                                                           template (value) MeasObjectToAddMod.measObject p_MeasObject ) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    {
      measObjectId := p_MeasObjectId,
      measObject   := p_MeasObject
    }
  };

  template (value) MeasObjectToAddModList cs_MeasObjectToAddModList_2Entries(MeasObjectId p_MeasObjectId_1,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_1,
                                                                             MeasObjectId p_MeasObjectId_2,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_2 ) :=
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    {
      measObjectId := p_MeasObjectId_1,
      measObject   := p_MeasObject_1
    },
    {
      measObjectId := p_MeasObjectId_2,
      measObject   := p_MeasObject_2
    }
  };

  template (value) MeasObjectToAddModList cs_MeasObjectToAddModList_3Entries(MeasObjectId p_MeasObjectId_1,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_1,
                                                                             MeasObjectId p_MeasObjectId_2,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_2,
                                                                             MeasObjectId p_MeasObjectId_3,
                                                                             template (value) MeasObjectToAddMod.measObject p_MeasObject_3 ) :=
  { /* @status    APPROVED (LTE, LTE_A_R10_R11, LTE_IRAT) */
    {
      measObjectId := p_MeasObjectId_1,
      measObject   := p_MeasObject_1
    },
    {
      measObjectId := p_MeasObjectId_2,
      measObject   := p_MeasObject_2
    },
    {
      measObjectId := p_MeasObjectId_3,
      measObject   := p_MeasObject_3
    }
  };

  template (value) MeasObjectToAddMod.measObject cs_MeasObject_measObjectEUTRA_Common(ARFCN_ValueEUTRA p_EUTRA_DL_CarrierFreq,
                                                                                      AllowedMeasBandwidth p_MeasurementBandwidth,
                                                                                      template (omit) CellIndexList p_ExcludedCellsToRemoveList := omit,
                                                                                      template (omit) ExcludedCellsToAddModList p_ExcludedCellsToAddModList := omit,
                                                                                      template (omit) PhysCellId p_PhysCellId := omit,
                                                                                      template (omit) MeasSubframePatternConfigNeigh_r10 p_MeasSubframePatternConfigNeigh_r10 := omit,
                                                                                      template (omit) MeasCycleSCell_r10  p_MeasCycleSCell_r10 := omit,
                                                                                      template (value) NeighCellConfig p_NeighCellConfig := '01'B, //@sic R5-153740 sic@
                                                                                      template (omit) MeasDS_Config_r12 p_MeasDS_Config_r12 := omit) := //@sic R5s140009 sic@
  { /* @status    APPROVED (ENDC, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_IRAT) */
    /* @sic R5s120925 - additional change: p_ExcludedCellsToRemoveList, p_ExcludedCellsToAddModList, p_PhysCellId made optional sic@ */
    /* @sic R5s130764: TC_8_3_1_21 - additional parameter p_MeasSubframePatternConfigNeigh_r10 sic@ */
    measObjectEUTRA := {
      carrierFreq             := p_EUTRA_DL_CarrierFreq,
      allowedMeasBandwidth    := p_MeasurementBandwidth,
      presenceAntennaPort1    := false,
      neighCellConfig         := p_NeighCellConfig,
      offsetFreq              := dB0,
      cellsToRemoveList       := omit,
      cellsToAddModList       := omit,
      excludedCellsToRemoveList  := p_ExcludedCellsToRemoveList,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      excludedCellsToAddModList  := p_ExcludedCellsToAddModList,  /* @sic R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      cellForWhichToReportCGI := p_PhysCellId,
      measCycleSCell_r10      := p_MeasCycleSCell_r10, //@sic R5s140009 sic@
      measSubframePatternConfigNeigh_r10 := p_MeasSubframePatternConfigNeigh_r10,
      widebandRSRQ_Meas_r11   := omit,
      altTTT_CellsToRemoveList_r12 := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      altTTT_CellsToAddModList_r12 := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      t312_r12                     := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      reducedMeasPerformance_r12   := omit,                     /* @sic BASELINE MOVING 2015 sic@ */
      measDS_Config_r12            := p_MeasDS_Config_r12,      /* @sic BASELINE MOVING 2015 sic@ */
      allowedCellsToRemoveList_r13   := omit,                   /* @sic R5s160711 BASELINE MOVING 2016 R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      allowedCellsToAddModList_r13   := omit,                   /* @sic R5s160711 BASELINE MOVING 2016 R5s221178 BASELINE MOVING 2022 rel-17 sic@ */
      rmtc_Config_r13              := omit,                     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      carrierFreq_r13              := omit,                     /* @sic R5s160711 BASELINE MOVING 2016 sic@ */
      tx_ResourcePoolToRemoveList_r14 := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      tx_ResourcePoolToAddList_r14    := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      fembms_MixedCarrier_r14         := omit,                  /* @sic R5s170597 BASELINE MOVING 2017 sic@ */
      measSensing_Config_r15          := omit,                  /* @sic R5s180552 BASELINE MOVING 2018 sic@ */
      measRSS_DedicatedConfig_r16     := omit,                  /* @sic R5s201386 BASELINE MOVING 2020 sic@ */
      cellsToAddModList_v1810         := omit                   /* @sic R5s240444 BASELINE MOVING 2024 sic@ */
    }
  };

