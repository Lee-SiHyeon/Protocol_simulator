module NR5GC_UE_Location {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_Templates all;
  import from CommonDefs all;
  import from EPS_NAS_TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NG_NAS_MsgContainers all;
  import from NG_NAS_Templates all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_SysinfoPaging all;
  import from NR_ASP_Templates_SRB all;
  import from NR_CommonDefs all;
  import from NR_Component_NR5GC all;
  import from Parameters all;
  import from TestcaseProperties all;
  import from UpperTesterFunctions all;

  template (value) NG_NAS_DL_Message_Type cs_Update_UE_LocationInformation_NR (EllipsoidPointWithAltitude_Type p_EllipsoidPointWithAltitude,
                                                                               HorizontalVelocity_Type p_HorizontalVelocity,
                                                                               Gnss_TOD_msec_Type p_Gnss_TOD_msec) :=
  { /* @status    APPROVED (IMS, NR5GC, NR5GC_IRAT) */
    update_Ue_Location_Information := cs_Update_UE_Location_Information(p_EllipsoidPointWithAltitude, p_HorizontalVelocity, p_Gnss_TOD_msec)
  };

  /*
   * @desc      Function to send LOCATION INFORMATION to UE using the Update_UE_LocationInformation message defined in 38.509 (cross-ref 36.509)
   *            To be used when UE is either in CONNECTED state or in IDLE state
   * @param     p_CellId
   * @param     p_State
   * @param     p_EllipsoidPointWithAltitude (default value: px_EllipsoidPointWithAltitude)
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_SendUE_LocationInformation(NR_CellId_Type p_CellId,
                                           NR_RRC_STATE_Type  p_State,
                                           O8_Type p_EllipsoidPointWithAltitude := px_EllipsoidPointWithAltitude
                                           )
    runs on NR5GC_PTC
  {
    var NG_NAS_MSG_Indication_Type v_ReceivedMsg;
    var Gnss_TOD_msec_Type v_Gnss_TOD_msec;
    var O3_Type v_HorizontalVelocity := px_HorizontalVelocity;
    var H12_Type v_CurrentTime;
    
    if (p_State == RRC_IDLE) {
      //Bring UE to the connected state
      f_NR_Paging_Def(p_CellId, RRC_IDLE);
      v_ReceivedMsg := f_NR5GC_RRCIdleToConnected_Steps2_4(p_CellId);
      f_NR5GC_RRC_ConnectedState3N_Steps5_8(p_CellId, v_ReceivedMsg);  //Reconfigure SRB2 + DRBs as per default

    }

    // Acc. to 36.355 cl 6.5.2.6:
    // This field specifies the GNSS TOD for which the measurements and/or location estimate are valid.
    // Scale factor 1 millisecond.
    v_Gnss_TOD_msec := bit2oct(int2bit(tsc_Gnss_TOD_msec, 22)); // set to the  value: 0h30min00s000ms

    if (f_GetTestcaseAttrib_D2D_Communication(testcasename())) { //Specific to D2D test cases
        v_HorizontalVelocity := '000000'O; //horizontalVelocity: 0 m/s
        v_CurrentTime := f_BCD_TimestampWithoutTimezone();
        v_Gnss_TOD_msec := bit2oct(int2bit( hex2int(v_CurrentTime),22));  //Equal to system time
    }
    
    SRB.send(cas_NR_SRB_NasPdu_REQ(p_CellId,
                                   tsc_NR_RbId_SRB2,
                                   -,
                                   cs_NG_NAS_Request(tsc_SHT_IntegrityProtected_Ciphered,
                                   cs_Update_UE_LocationInformation_NR(p_EllipsoidPointWithAltitude,
                                                                                        v_HorizontalVelocity,
                                                                                        v_Gnss_TOD_msec))));

    
    if (p_State == RRC_IDLE) {
      // The SS releases the RRC connection.
      f_NR_RRCRelease(p_CellId);
    }
  }

  /*
   * @desc      Function to provide LOCATION INFRMATION to UE
   *            To be used when UE is either in CONNECTED state or in IDLE state
   * @param     p_CellId
   * @param     p_State
   * @status    APPROVED (IMS, NR5GC, NR5GC_IRAT)
   */
  function f_NR_ProvideUE_LocationInformation(NR_CellId_Type p_CellId,
                                                 NR_RRC_STATE_Type p_State) runs on NR5GC_PTC
  {
    if (pc_UpdateUE_LocationInformation) {
      f_NR_SendUE_LocationInformation(p_CellId, p_State);
    } else {
      f_UT_MMI_ProvideLocationInfoToUE(UT);
    }
  }

}
