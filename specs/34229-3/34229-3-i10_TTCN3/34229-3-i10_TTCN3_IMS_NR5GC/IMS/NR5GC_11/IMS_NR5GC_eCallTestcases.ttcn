module IMS_NR5GC_eCallTestcases {

  import from IMS_CC_TestcaseImplementation_eCall all;
  import from IMS_Component all;
  import from IMS_XML_eCall_Templates all;

  /*
   * @desc      Call the common function
   * @status    APPROVED (IMS)
   */
  function fl_IMS_ECall_NR5GC_IMS1 () runs on IMS_PTC
{
   f_IMS_ECallOverIMS_IMS1("TS 38.508-1 Table 6.4.1-23: USIM Configuration 23"); // @sic R5s230677 sic@
}

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.1.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_1_NR5GC_IMS1() runs on IMS_PTC
  { //eCall over IMS / Manual initiation / Normal Registration / Emergency Registration / Success / 200 OK with ACK / 5GS
     fl_IMS_ECall_NR5GC_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.1.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_11_1_NR5GC_IMS2() runs on IMS_PTC
  { //eCall over IMS / Manual initiation / Normal Registration / Emergency Registration / Success / 200 OK with ACK / 5GS
      f_IMS_ECallOverIMS_IMS2(MANUAL, msdUpdateNotRequired);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.2.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_2_NR5GC_IMS1() runs on IMS_PTC
  { //eCall over IMS / Automatic initiation / Normal Registration / Emergency Registration / Success / 200 OK with ACK / 5GS
     fl_IMS_ECall_NR5GC_IMS1();
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.2.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_11_2_NR5GC_IMS2() runs on IMS_PTC
  { //eCall over IMS / Automatic initiation / Normal Registration / Emergency Registration / Success / 200 OK with ACK / 5GS
      f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateNotRequired);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.4.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_4_NR5GC_IMS1() runs on IMS_PTC
  { //eCall over IMS / Manual initiation / MSD transfer and 200 OK with ACK / SIP INFO for MSD Update / Success / 5GS
     fl_IMS_ECall_NR5GC_IMS1();

  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.4.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_4_NR5GC_IMS2() runs on IMS_PTC
  {
      f_IMS_ECallOverIMS_IMS2(MANUAL, msdUpdateRequired);
    
  } // End of f_TC_11_4_NR5GC_IMS2()

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.5.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_5_NR5GC_IMS1() runs on IMS_PTC
  { // eCall over IMS / Automatic initiation / MSD transfer and 200 OK with ACK / SIP INFO request for MSD update / Success / 5GS
      fl_IMS_ECall_NR5GC_IMS1();

  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.5.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_5_NR5GC_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateRequired);
    
  } // End of f_TC_11_5_NR5GC_IMS2()

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.6.NR5GC
   * @status    APPROVED (IMS)
   */
   function f_TC_11_6_NR5GC_IMS1() runs on IMS_PTC
   { // eCall over IMS / Automatic initiation / MSD transfer and 200 OK with ACK / SIP INFO request for unsupported MSD / UE indicates unsuccessful in SIP INFO / 5GS
    fl_IMS_ECall_NR5GC_IMS1();
   }

  /*
   * @desc      REFERENCE TS 34.229-1 clause 11.6.NR5GC
   * @status    APPROVED (IMS)
   */
  function f_TC_11_6_NR5GC_IMS2() runs on IMS_PTC
  {
    f_IMS_ECallOverIMS_IMS2(AUTOMATIC, msdUpdateRequired, cs_EmergencyCallData_Control_Request(-, tsc_EmergencyCallData_DataType_invalidMSD));
    
  } // End of f_TC_11_6_NR5GC_IMS2()

}
