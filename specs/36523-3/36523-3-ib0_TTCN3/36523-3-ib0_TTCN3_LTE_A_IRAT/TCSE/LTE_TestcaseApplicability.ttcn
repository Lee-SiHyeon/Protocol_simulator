module LTE_TestcaseApplicability {

  import from EUTRA_NB_Parameters all;
  import from EUTRA_Parameters all;
  import from LTE_36523_SelectionExpressions all;
  import from Parameters all;

  /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause 11
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_EUTRA_ExecutionGuideline(charstring p_TestCase) return boolean
  { // @sic R5-101050 R5-106675 R5-110803 R5-122121 sic@
    var boolean v_ExecutionGuideline := true;
    
    v_ExecutionGuideline := (f_ExecutionGuidelineEUTRA(p_TestCase) and     // execution guideline from cl 11.1
                             f_ExecutionGuidelineEUTRA_UTRA_GERAN(p_TestCase) and   // execution guideline from cl 11.2
                             f_ExecutionGuideline_InterBand(p_TestCase) and      // execution guideline from cl 11.3
                             f_ExecutionGuideline_EUTRA_CA(p_TestCase) and  // execution guideline from cl 11.4 @sic R5-133612 sic@
                             f_ExecutionGuideline_EUTRA_MFBI(p_TestCase) and  // execution guideline from cl 11.5
                             f_ExecutionGuideline_EUTRA_DC(p_TestCase));  // execution guideline from cl 11.6 @sic R5-163035 sic@
    return v_ExecutionGuideline;
  }

  /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause 11.1
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_ExecutionGuidelineEUTRA(charstring p_TestCase) return boolean
  { // @sic R5-110803  R5s120227 R5-122121 R5-130670 R5-142985 R5-150123 R5-172046 R5-176154 R5-233414 sic@
    var boolean v_ExecutionGuideline := true;
     
    if ((px_ePrimaryFrequencyBand == 13) or
        (px_ePrimaryFrequencyBand == 18) or
        (px_ePrimaryFrequencyBand == 31) or
        (px_ePrimaryFrequencyBand == 54) or
        (px_ePrimaryFrequencyBand == 72) or
        (px_ePrimaryFrequencyBand == 73) or
        (px_ePrimaryFrequencyBand == 87) or
        (px_ePrimaryFrequencyBand == 88) or
        (px_ePrimaryFrequencyBand == 106)
        ) //@sic R5-135000 R5-151150 R5-181308 R5-198138 R5-205089 R5-246415 R5-253974 sic@
      { // Test cases using more than one radio frequency (acc to 36.523-3 cl 11.1)
        select (p_TestCase) {
          case ("TC_6_1_1_1",
                "TC_6_1_1_2",
                "TC_6_1_1_3",
                "TC_6_1_1_6",
                "TC_6_1_1_7",
                "TC_6_1_1_8",
                "TC_6_1_1_12", 
                "TC_6_1_1_13", 
                "TC_6_1_1_14",
                "TC_6_1_2_6b",
                "TC_6_1_2_7",
                "TC_6_1_2_8",
                "TC_6_1_2_9",
                "TC_6_1_2_11",
                "TC_6_1_2_11a",
                "TC_6_1_2_13",
                "TC_6_1_2_15",
                "TC_6_1_2_17",
                "TC_6_1_2_18",
                "TC_6_3_1",
                "TC_6_3_5",
                "TC_6_3_6",
                "TC_6_3_9",
                "TC_6_4_1", //@sic R5-153746 sic@
                "TC_6_4_2", //@sic R5-153746 sic@
                "TC_8_1_3_4",
                "TC_8_1_3_5",
                "TC_8_1_3_5a",
                "TC_8_2_4_6",
                "TC_8_2_4_26", //@sic R5-169120 sic@
                "TC_8_2_4_28", //@sic R5-182302 sic@
                "TC_8_3_1_3",
                "TC_8_3_1_3a",
                "TC_8_3_1_4",
                "TC_8_3_1_6",
                "TC_8_3_1_9",
                "TC_8_3_1_10",
                "TC_8_3_1_11",
                "TC_8_3_1_26",
                "TC_8_3_1_27", //@sic R5s170582 sic@
                "TC_8_3_1_31", //@sic R5-163085 sic@
                "TC_8_3_4_2",
                "TC_8_3_4_3",
                "TC_8_3_4_5",
                "TC_8_6_2_2",
                "TC_8_6_2_3a",
                "TC_8_6_2_8",
                "TC_8_6_2_10",
                "TC_8_6_2_11",
                "TC_8_6_2_12",
                "TC_8_6_4_2",
                "TC_8_6_4_3",
                "TC_8_6_4_4",  //@sic  R5-144219 sic@
                "TC_8_6_4_8",
                "TC_8_6_4_9",
                "TC_8_6_4_10",
                "TC_8_6_6_2",
                "TC_8_6_6_5",
                "TC_8_6_6_6",
                "TC_8_6_6_7",
                "TC_8_6_8_2",
                "TC_8_6_8_6",
                "TC_8_9_4a",  //@sic R5-203546 sic@
                "TC_8_9_5a",  //@sic R5-203546 sic@
                "TC_9_2_1_1_1a",
                "TC_9_2_1_1_7",
                "TC_9_2_1_1_13",
                "TC_9_2_1_1_15",
                "TC_9_2_1_1_16",
                "TC_9_2_1_2_1",
                "TC_9_2_1_2_10",
                "TC_9_2_1_2_12",
                "TC_9_2_1_2_14",
                "TC_9_2_3_2_1",
                "TC_9_2_3_2_12",
                "TC_9_2_3_2_15",
                "TC_9_2_3_2_16",
                "TC_9_2_5_1",  //@sic R5-225420 sic@
                "TC_11_2_6",
                "TC_11_2_7",
                "TC_13_4_1_2",
                "TC_17_4_1",
                "TC_17_4_2",
                "TC_17_4_3",
                "TC_21_3_1",  //@sic R5-169120 sic@
                "TC_21_3_2",
                "TC_21_3_3",
                "TC_21_3_7", //@sic R5-182302 sic@
                "TC_24_1_3"     //@sic R5-181308 sic@
                ) {
            v_ExecutionGuideline := false;
          }
        }
      }
    if ((px_ePrimaryFrequencyBand == 6) or
        (px_ePrimaryFrequencyBand == 11) or
        (px_ePrimaryFrequencyBand == 14) or
        (px_ePrimaryFrequencyBand == 17) or
        (px_ePrimaryFrequencyBand == 23 and px_ePrimaryBandChannelBandwidth == n50 ) or
        (px_ePrimaryFrequencyBand == 24) or //@sic R5-216336 sic@
        (px_ePrimaryFrequencyBand == 30) or //@sic R5-145714 sic@
        (px_ePrimaryFrequencyBand == 38) or // @sic R5-103813 R5-104796 sic@
        (px_ePrimaryFrequencyBand == 39) or
        (px_ePrimaryFrequencyBand == 53)
        ) // @sic R5-120721 R5-192338 sic@
       {  // Test cases using more than two radio frequencies (acc to 36.523-3 cl 11.1)
        select (p_TestCase) {
          case ("TC_6_1_1_1",
                "TC_6_1_1_2",
                "TC_6_1_1_3",
                "TC_6_1_1_6",
                "TC_6_1_1_7",
                "TC_6_1_1_8",
                "TC_6.1.1.12", 
                "TC_6.1.1.13", 
                "TC_6.1.1.14", 
                "TC_6_1_2_7",
                "TC_6_1_2_8",
                "TC_6_1_2_9",
                "TC_6_1_2_11a",
                "TC_6_1_2_15",
                "TC_6_3_5",  //@sic R5-144219 R5-151792 sic@
                "TC_8_1_3_5",
                "TC_8_1_3_5a",
                "TC_8_3_1_4",
                "TC_8_6_4_3",
                "TC_8_9_4a",  //@sic R5-203546 sic@
                "TC_8_9_5a",  //@sic R5-203546 sic@
                "TC_9_2_1_1_1a",
                "TC_9_2_1_1_7",
                "TC_9_2_1_1_15",
                "TC_11_2_7" //@sic R5s170581 sic@
                ) {
            v_ExecutionGuideline := false;
          }
        }
      }  // @sic R5s120334 sic@
    if ((px_ePrimaryFrequencyBand == 12) or
        (px_ePrimaryFrequencyBand == 19) or
        (px_ePrimaryFrequencyBand == 20) or
        (px_ePrimaryFrequencyBand == 21) or
        (px_ePrimaryFrequencyBand == 27) or
        (px_ePrimaryFrequencyBand == 34) or  // @sic R5-104796 sic@
        (px_ePrimaryFrequencyBand == 70) or  //@sic R5-170552 sic@
        (px_ePrimaryFrequencyBand == 85)     //@sic R5-193738 sic@
        )
      { // Test cases using more than three radio frequencies (acc to 36.523-3 cl 11.1)
        select (p_TestCase) {
          case ("TC_6_1_1_1",
                "TC_6_1_1_2",
                "TC_6_1_1_6",
                "TC_6_1_1_8",
                "TC_8_1_3_5a",
                "TC_9_2_1_1_7") { v_ExecutionGuideline := false; }
        }
      } // @sic R5s120334 sic@

    // ----------------------------------------------------------------------
    // REPLACEMENT OF TC EXECUTION cl 11.1.1
    // ----------------------------------------------------------------------
    if (not((px_ePrimaryFrequencyBand == 13) or
            (px_ePrimaryFrequencyBand == 18) or
            (px_ePrimaryFrequencyBand == 31) or
            (px_ePrimaryFrequencyBand == 54) or
            (px_ePrimaryFrequencyBand == 72) or
            (px_ePrimaryFrequencyBand == 73)
            )
        ) // @sic R5s120334 R5-198154 R5-233414 sic@
      {   // Acc to 36.523-3 Table 11.1.1-1
        select (p_TestCase) {
          case ("TC_8_3_1_9a",
                "TC_8_3_1_11a",
                "TC_9_2_1_1_13a",
                "TC_9_2_1_1_16a") {
            v_ExecutionGuideline := false;
          }
        }
      }
    if (not((px_ePrimaryFrequencyBand == 13) or
            (px_ePrimaryFrequencyBand == 18) or
            (px_ePrimaryFrequencyBand == 31) or
            (px_ePrimaryFrequencyBand == 54) or
            (px_ePrimaryFrequencyBand == 72) or
            (px_ePrimaryFrequencyBand == 73) or
            (px_ePrimaryFrequencyBand == 6) or
            (px_ePrimaryFrequencyBand == 11) or
            (px_ePrimaryFrequencyBand == 14) or
            (px_ePrimaryFrequencyBand == 17) or
            (px_ePrimaryFrequencyBand == 23 and px_ePrimaryBandChannelBandwidth == n50 ) or
            (px_ePrimaryFrequencyBand == 30) or
            (px_ePrimaryFrequencyBand == 38) or
            (px_ePrimaryFrequencyBand == 39) or
            (px_ePrimaryFrequencyBand == 53)
            )) // @sic R5-198154 R5-233414 sic@
      { // Test cases using more than three radio frequencies (acc to 36.523-3 cl 11.1)
        select (p_TestCase) {
          case ("TC_6_1_1_3b",
                "TC_6_1_2_7a",
                "TC_6_1_2_8a",
                "TC_6_1_2_9a",
                "TC_9_2_1_1_1b",
                "TC_9_2_1_1_15a") {
            v_ExecutionGuideline := false;
          }
        }
      }
    if (not((px_ePrimaryFrequencyBand == 13) or
            (px_ePrimaryFrequencyBand == 18) or
            (px_ePrimaryFrequencyBand == 31) or
            (px_ePrimaryFrequencyBand == 54) or
            (px_ePrimaryFrequencyBand == 72) or
            (px_ePrimaryFrequencyBand == 73) or
            (px_ePrimaryFrequencyBand == 6) or
            (px_ePrimaryFrequencyBand == 11) or
            (px_ePrimaryFrequencyBand == 14) or
            (px_ePrimaryFrequencyBand == 17) or
            (px_ePrimaryFrequencyBand == 23 and px_ePrimaryBandChannelBandwidth == n50 ) or
            (px_ePrimaryFrequencyBand == 30) or
            (px_ePrimaryFrequencyBand == 38) or
            (px_ePrimaryFrequencyBand == 39) or
            (px_ePrimaryFrequencyBand == 53) or
            (px_ePrimaryFrequencyBand == 12) or
            (px_ePrimaryFrequencyBand == 19) or
            (px_ePrimaryFrequencyBand == 20) or
            (px_ePrimaryFrequencyBand == 21) or
            (px_ePrimaryFrequencyBand == 27) or
            (px_ePrimaryFrequencyBand == 34) or
            (px_ePrimaryFrequencyBand == 70) or
            (px_ePrimaryFrequencyBand == 85))
        )  // @sic R5s120334 R5-198154 R5-233414 sic@
      { // Test cases using more than three radio frequencies (acc to 36.523-3 cl 11.1)
        select (p_TestCase) {
          case ("TC_6_1_1_1b",
                "TC_6_1_1_2a",
                "TC_6_1_1_6a",
                "TC_6_1_1_7a",
                "TC_9_2_1_1_7a") {
            v_ExecutionGuideline := false;
          }
        }
      }
    return v_ExecutionGuideline;
  }

  /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause cl 11.2
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_ExecutionGuidelineEUTRA_UTRA_GERAN (charstring p_TestCase ) return boolean
  { // @sic R5-130670 sic@
    var boolean v_ExecutionGuideline := true;

    select (p_TestCase) {
      // Test cases using px_RATComb_Tested: execution depends on px_RATComb_Tested value used
      case("TC_9_2_1_1_11",
           "TC_9_2_1_1_12",
           "TC_9_2_1_2_1b",
           "TC_9_2_1_2_5",
           "TC_9_2_1_2_8",
           "TC_9_2_1_2_9",
           "TC_9_2_1_2_11",
           "TC_9_2_1_2_13",
           "TC_9_2_1_2_15",
           "TC_9_2_3_1_6",
           "TC_9_2_3_1_10",
           "TC_9_2_3_1_11",
           "TC_9_2_3_1_12",
           "TC_9_2_3_1_15",
           "TC_9_2_3_1_15a",
           "TC_9_2_3_1_17",
           "TC_9_2_3_1_18",
           "TC_9_2_3_1_18a",
           "TC_9_2_3_2_1b",
           "TC_9_2_3_2_3",
           "TC_9_2_3_2_5",
           "TC_9_2_3_2_6",
           "TC_9_2_3_2_7",
           "TC_9_2_3_2_8",
           "TC_9_2_3_2_9",
           "TC_9_2_3_2_11",
           "TC_9_2_3_2_13",
           "TC_9_2_3_2_14",
           "TC_9_2_3_3_5",
           "TC_9_2_3_3_5a",
           "TC_9_3_1_4",
           "TC_9_3_1_5",
           "TC_9_3_1_6") {
        if (px_RATComb_Tested==EUTRA_UTRA) {v_ExecutionGuideline := f_ExecutionGuidelineUTRA(p_TestCase);}
        if (px_RATComb_Tested==EUTRA_GERAN) {v_ExecutionGuideline := f_ExecutionGuidelineGERAN(p_TestCase);}
        if (px_RATComb_Tested==EUTRA_Only) {v_ExecutionGuideline := f_ExecutionGuidelineNoUTRA_NoGERAN(p_TestCase);}
        // ----------------------------------------------------------------------
        // REPLACEMENT OF TC EXECUTION cl 11.2.5
        // ----------------------------------------------------------------------
        if (px_ePrimaryFrequencyBand == px_FDD_OperationBand) {  // Execution with overlapped bands E-UTRA/UTRA
          if (not(  (px_ePrimaryFrequencyBand == 13) or
                    (px_ePrimaryFrequencyBand == 18) or
                    (px_ePrimaryFrequencyBand == 31) or
                    (px_ePrimaryFrequencyBand == 54) or
                    (px_ePrimaryFrequencyBand == 72) or
                    (px_ePrimaryFrequencyBand == 73) or
                    (px_ePrimaryFrequencyBand == 6) or
                    (px_ePrimaryFrequencyBand == 11) or
                    (px_ePrimaryFrequencyBand == 14) or
                    (px_ePrimaryFrequencyBand == 17) or
                    (px_ePrimaryFrequencyBand == 23 and px_ePrimaryBandChannelBandwidth == n50 ) or
                    (px_ePrimaryFrequencyBand == 30) or
                    (px_ePrimaryFrequencyBand == 38) or
                    (px_ePrimaryFrequencyBand == 39) or
                    (px_ePrimaryFrequencyBand == 53)
                    )) //@sic R5-198154 R5-233414 sic@
            {  // Acc to 36.523-3 Table 11.2.5
              select (p_TestCase) {
                case ("TC_9_2_3_1_15a", "TC_9_2_3_1_18a") { v_ExecutionGuideline := false; }
              }
            }
        } else {  // Execution with no overlapped bands E-UTRA/UTRA
          if (not((px_ePrimaryFrequencyBand == 13) or
                  (px_ePrimaryFrequencyBand == 18) or
                  (px_ePrimaryFrequencyBand == 31) or
                  (px_ePrimaryFrequencyBand == 54) or
                  (px_ePrimaryFrequencyBand == 72) or
                  (px_ePrimaryFrequencyBand == 73) )) { //@sic R5-198154 R5-233414 sic@
            select (p_TestCase) {
              case ("TC_9_2_3_1_15a",
                    "TC_9_2_3_1_18a") {
                v_ExecutionGuideline := false;
              }
            }
          }
        }
      }
      case else {
        v_ExecutionGuideline := ( f_ExecutionGuidelineUTRA ( p_TestCase ) and    // execution guideline from cl 11.2.1
                                  f_ExecutionGuidelineGERAN ( p_TestCase ) and   // execution guideline from cl 11.2.2
                                  f_ExecutionGuidelineUTRA_GERAN (p_TestCase)    // execution guideline from cl 11.2.4
                                  );
       
        if (not(    (px_ePrimaryFrequencyBand == 13) or
                    (px_ePrimaryFrequencyBand == 18) or
                    (px_ePrimaryFrequencyBand == 31) or
                    (px_ePrimaryFrequencyBand == 54) or
                    (px_ePrimaryFrequencyBand == 72) or
                    (px_ePrimaryFrequencyBand == 73) or
                    (px_ePrimaryFrequencyBand == 6) or
                    (px_ePrimaryFrequencyBand == 11) or
                    (px_ePrimaryFrequencyBand == 14) or
                    (px_ePrimaryFrequencyBand == 17) or
                    (px_ePrimaryFrequencyBand == 23 and px_ePrimaryBandChannelBandwidth == n50 ) or
                    (px_ePrimaryFrequencyBand == 30) or
                    (px_ePrimaryFrequencyBand == 38) or
                    (px_ePrimaryFrequencyBand == 39) or
                    (px_ePrimaryFrequencyBand == 53)
                )) //@sic R5-198154 sic@
          { // Test cases using more than three radio frequencies (acc to 36.523-3 cl 11.1)
            select (p_TestCase) {
              case ("TC_6_1_1_3b",
                    "TC_6_1_2_7a",
                    "TC_6_1_2_8a",
                    "TC_6_1_2_9a",
                    "TC_9_2_1_1_1b",
                    "TC_9_2_1_1_15a") {
                v_ExecutionGuideline := false;
              }
            }
          }
      }
    }
    return v_ExecutionGuideline;
  }

  /*
   * @desc      Set the execution to TRUE or FALSE according to 36.523-3 clause 11.2.1
   * @param     p_TestCase
   * @return    boolean
   * @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT)
   */
  function f_ExecutionGuidelineUTRA ( charstring p_TestCase ) return boolean
  { // @sic R5-110803 R5-113734 R5-130670 R50150123 sic@
    var boolean v_ExecutionGuideline := true;
    
    if (px_ePrimaryFrequencyBand == px_FDD_OperationBand) {
      // OVERLAPPED BANDS cl 11.2.1.1
      if ( (px_ePrimaryFrequencyBand == 13 ) or
           (px_ePrimaryFrequencyBand == 18 ) or
           (px_ePrimaryFrequencyBand == 31 )
           ) { //@sic R5-135000 R5-181308 sic@
        // UTRA I-RAT test cases using more than 1 frequency (acc to 36.523-3 cl 11.2.1.1)
        select (p_TestCase) {
          case ("TC_6_2_1_2",
                "TC_6_2_1_3",
                "TC_6_2_2_1",
                "TC_6_2_2_5",
                "TC_6_2_2_8",
                "TC_6_2_3_3",
                "TC_6_2_3_3a",
                "TC_6_2_3_4",
                "TC_6_2_3_4a",
                "TC_6_2_3_5",
