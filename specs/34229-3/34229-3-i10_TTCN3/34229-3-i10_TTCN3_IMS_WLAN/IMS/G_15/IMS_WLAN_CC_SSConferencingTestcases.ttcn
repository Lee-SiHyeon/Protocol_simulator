module IMS_WLAN_CC_SSConferencingTestcases {

  import from IMS_CC_CommonFunctions all;
  import from IMS_CC_TestcaseImplementation_15_Conferencing all;
  import from IMS_Component all;
  import from IMS_ConferenceEventPackage all;

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.18
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_18_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_InvitingUser_ByReferToFocus(IPCAN_MO_SpeechCall, tsc_MediaTypeList_Audio);
    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.20
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_20_IMS1() runs on IMS_PTC
  { // Three way session creation

    f_IMS_CC_Preamble(IPCAN_SpeechCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_ThreeWaySession_Creation(IPCAN_MO_SpeechCall);

    f_IMS_CC_Postamble(IPCAN_MO_SpeechCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.21
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_21_IMS1() runs on IMS_PTC
  {
    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED, IMS_Security, WLAN);
    f_IMS_InvitingUser_ByReferToFocus(IPCAN_MO_VideoCall, tsc_MediaTypeList_AudioVideo);
    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

  /*
   * @desc      REFERENCE TS 34.229-1 clause G.15.23
   * @status    APPROVED (IMS)
   */
  function f_TC_G_15_23_IMS1() runs on IMS_PTC
  { // Three way session creation / video

    f_IMS_CC_Preamble(IPCAN_VideoCall, IMS_REGISTERED, IMS_Security, WLAN);

    f_IMS_ThreeWaySession_Creation(IPCAN_MO_VideoCall);

    f_IMS_CC_Postamble(IPCAN_MO_VideoCall);
  }

}
