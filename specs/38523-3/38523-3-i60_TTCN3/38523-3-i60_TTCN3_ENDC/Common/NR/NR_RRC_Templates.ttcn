                                                                                   @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

  const RRC_TransactionIdentifier tsc_NR_RRC_TI_Def := 0;                       /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */

