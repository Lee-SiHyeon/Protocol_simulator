module AccessControl {

  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EPS_NAS_TypeDefs all;
  import from EUTRA_CellInfo all;
  import from EUTRA_CellInfoInit all;
  import from EUTRA_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_InitialRegistration all;
  import from EUTRA_NASCommonFunctions all;
  import from EUTRA_NASSteps all;
  import from EUTRA_NB_CommonDefs all;
  import from EUTRA_RRCSteps all;
  import from EUTRA_RRC_Templates all;
  import from EUTRA_SysInfo_Templates all;
  import from IMS_CommonParameters all;
  import from IMS_PTC_CoordMsg all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.1
   * @status    APPROVED (LTE)
   */
  function f_TC_13_5_1_EUTRA() runs on EUTRA_PTC
  { // MTSI MO speech Call / SSAC / 0% access probability for MTSI MO speech call
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;

    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Voice (eutra_Cell1,cs_AC_BarringConfig(p00, s64, '11111'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell1);

    f_EUTRA_SetCellPower(eutra_Cell1, tsc_ServingCellRS_EPRE);  // @sic R5s250470 sic@
    
    // @sic R5-255062 sic@
    f_EUTRA_SwitchOnUEandStartIP(eutra_Cell1);   // @sic R5s250470 sic@
    
    // Store the value of NetworkFeatureSupport to be used throughout the test
    f_EUTRA_MobileInfo_SetNetworkFeatureSupport (f_GetDefaultValueNetworkFeatureSupport());
    
    // Now move to Idle Updated
    f_RegistrationCSnotAvailable(eutra_Cell1, PREAMBLE);  // @sic R5-255062 sic@
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED); // @sic R5s230790 sic@
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit a RRCConnectionRequest message  within 10 s?.
    f_Delay(10.0);
    
    // @siclog "Step 3" siclog@
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Voice (eutra_Cell1, omit);
    f_EUTRA_ModifySysinfo (eutra_Cell1);
    
    // @siclog "Step 4" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect
    f_Delay(15.0);
    
    // @siclog "Step 5" siclog@
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri, LOCAL_CNF_REQUIRED); // @sic R5s230790 sic@
    
    // @siclog "Step 6 - 7" siclog@
    // 34.229-1 TC 12.18: To verify that the UE does not send INVITE message within 10s because the timer Ty is running.
    f_Delay(59.0);
    
    // @siclog "Step 8 - 21" siclog@
    // Steps 1 to 14 of the generic test procedure for MTSI MO Speech call establishment in EUTRA: Normal Service (TS 36.508 4.5A.6.3-1).
    f_UT_RequestIMSCall(UT, px_IMS_CalleeUri); // @sic R5s0928 sic@
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    // Steps 6 to 18 - MTSI MO call for EPS
    // @siclog "Step 6 - 18" siclog@
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq (eutra_Cell1, v_RRC_TI);
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_Speech(eutra_Cell1);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.2
   * @status    APPROVED (LTE)
   */
  function f_TC_13_5_2_EUTRA() runs on EUTRA_PTC
  { // MTSI MO Video Call / SCM / 0% access probability for MTSI MO video call
    
    var RRC_TransactionIdentifier v_RRC_TI := tsc_RRC_TI_Def;
    var NAS_MSG_Indication_Type v_NasInd;
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Video (eutra_Cell1,cs_AC_BarringConfig(p00, s64, '11111'B));
    f_EUTRA_SS_ConfigureSysinfo(eutra_Cell1);
    
    f_EUTRA_Preamble(eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);
    
    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit a RRCConnectionRequest message  within 10 s?.
    f_Delay(10.0);
    
    // @siclog "Step 3 " siclog@
    // SS changes SIB2 according to TS 36.508, table 4.4.3.3-1 and transmits a Paging message including systemInfoModification.
    // The systemInfoValueTag in the SystemInformationBlockType1 is increased.
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Video (eutra_Cell1, omit);
    f_EUTRA_ModifySysinfo(eutra_Cell1);
    
    // @siclog "Step 4" siclog@
    // Wait for 15 s (Note 1) to allow the new system information to take effect.
    f_Delay(15.0);
    
    // @siclog "Step 5" siclog@
    // Make the UE attempt a MTSI MO Video call
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri);

    // @siclog "Step 6 - 7" siclog@
    // Check: Does the UE transmit an RRCConnectionRequest message with in 10s?
    // Wait for 49 s (Note 2) to make the timer Ty expire.
    f_Delay(59.0);
    
    // @siclog "Step 8 - 22" siclog@
    // Steps 1 to 15 of the generic test procedure for MTSI MO Video call establishment in EUTRA: Normal Service (TS 36.508 4.5A.8.3-1).
    f_UT_RequestIMSVideoCall(UT, px_IMS_CalleeUri); // @sic R5s150930 sic@
    f_EUTRA_RRC_ConnectionRequest_Def(eutra_Cell1, cr_EstablishmentCause_MoData);
    f_EUTRA_PreliminaryPass(__FILE__, __LINE__, "Step 5");
    
    v_NasInd := f_EUTRA_ServiceReq_WithoutRrcConnReq (eutra_Cell1, v_RRC_TI); // @sic R5s150930 sic@
    
    f_EUTRA_Activate_SRB2_DRB_SendRrcMsg(eutra_Cell1,
                                         v_RRC_TI,
                                         v_NasInd.SecurityProtection.NasCount);
    
    f_EUTRA_Activate_SRB2_DRB_ReceiveRrcAndNasMsg(eutra_Cell1,
                                                  v_RRC_TI);
    
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_ActivateDedicatedEpsBearer_SpeechVideo(eutra_Cell1);
    
    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS1]);

    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS1]);
    f_EUTRA_TestBody_Set(false);
    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 13.5.3
   * @status    APPROVED (LTE)
   */
  function f_TC_13_5_3_EUTRA() runs on EUTRA_PTC
  { // Emergency Call / Success / SSAC/ 0% access probability for MTSI MO video call
  
    var EPS_BearerIdentity v_EpsDefBearerId2 := '6'H; // @sic R5s160612 sic@
    
    f_EUTRA_Init(c1, HANDLE_UM_DATA, USE_BIG_GRANTS);  /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS sic@ */
    f_EUTRA_CellConfig_Def(eutra_Cell1);               /* @sic R5s170597 - Cleanup of UL grant Configuration: HANDLE_UM_DATA, USE_BIG_GRANTS moved to f_EUTRA_NAS_Init sic@ */
    
    f_EUTRA_CellInfo_SetSysInfo_AccessBarring (eutra_Cell1, cs_AccessBarringInformation_NoSigOrData); // @sic R5-174513 sic@
    f_EUTRA_CellInfo_SetSIB2_SSAC_BarringForMMTEL_Voice (eutra_Cell1, cs_AC_BarringConfig(p00, s4, '11111'B));
    f_EUTRA_SS_ConfigureSysinfo (eutra_Cell1);
    
    f_EUTRA_Preamble (eutra_Cell1, STATE2_IDLEUPDATE);
    f_EUTRA_TestBody_Set(true);

    f_IMS_IPCAN_SendCoOrdMsg(IMS[tsc_Index_IMS2]);  //@sic R5s160286 sic@

    // @sic R5s160756 sic@
    // @siclog "Step 18A" siclog@
    f_EUTRA_508_EstablishIMSEmergencyCall(eutra_Cell1, px_EmergencyCallNumber);
  
    f_IMS_IPCAN_WaitForTrigger(IMS[tsc_Index_IMS2]);
    
    f_EUTRA_DeactivateEPS_BearerContext (eutra_Cell1, v_EpsDefBearerId2); // @sic R5s160612 sic@
    
    f_EUTRA_TestBody_Set(false);

    f_EUTRA_Postamble(eutra_Cell1, E2_CONNECTED);
  }

}
