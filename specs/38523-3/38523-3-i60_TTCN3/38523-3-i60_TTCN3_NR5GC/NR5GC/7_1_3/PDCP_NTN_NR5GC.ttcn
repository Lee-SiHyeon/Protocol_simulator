module PDCP_NTN_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from Common4G5G_LoopBack all;
  import from Common4G5G_Templates all;
  import from Common4G5G_Timing all;
  import from CommonAspDefs all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_NTN_Configuration all;
  import from NR_PDCP_Common all;
  import from NR_PDCP_Templates all;
  import from NR_PDCP_TypeDefs all;
  import from NR_RRC_Templates all;
  import from NR_SecurityFunctions all;
  import from NR_Timing all;
  import from PDCP_TC_Common_NR all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.3.5.1a
   * @status    APPROVED (NR5GC)
   */
  function f_TC_7_1_3_5_1a_NR5GC() runs on NR5GC_PTC
  {
    //NR NTN / PDCP Discard / discardTimerExt2 configured
    var NR_PDCP_SS_State_Type v_NR_PDCP_State;
    var template (value) DRB_ToAddMod v_DRB_ToAddMod;
    var template (value) NR_RadioBearer_Type v_SS_Drb_Config;
    var template (value) MAC_CellGroupConfig v_MAC_CellGroupConfig;
    var template (value) NR_RLC_BearerToAddModList_Type v_RLC_BearerConfigList;
    var DRB_Identity v_DRBId;
    var template (omit) RLC_Config_v1700 v_RLC_Config_v1700;

    f_NR5GC_Init(NR_29); //@sic R5-252350 sic@

    v_MAC_CellGroupConfig := f_NR_CellInfo_GetMAC_CellGroupConfig(nr_Cell1);
    v_MAC_CellGroupConfig.schedulingRequestConfig.schedulingRequestToAddModList[0].sr_ProhibitTimer := ms64;
    v_MAC_CellGroupConfig.schedulingRequestConfig.schedulingRequestToAddModList[0].sr_TransMax := n64;
    f_NR_CellInfo_SetMAC_CellGroupConfig(nr_Cell1, v_MAC_CellGroupConfig);

    //sr-ProhibitTimer ms64

    //Create and configure NR cell1
    f_NR_CellConfig_Def(nr_Cell1);
      
    //Preamble
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A, TESTModeA_ON);
    f_NR_AS_CipheringAlgorithm_Set(nea0);

   
    v_DRBId:= f_NR_GetDefaultDRB_ForFirstPDUSession();
    v_SS_Drb_Config := f_NR_GetRadioBearerConfig_FullUM(nr_Cell1,
                                                        v_DRBId,
                                                        -,
                                                        cs_NR_PDCP_RbConfig_TransparentMode(f_NR_38508_SetPDCP_SN_Size()),
                                                        cs_SDAP_Configuration_None);
                                                         
    v_DRB_ToAddMod := cs_38508_NRDRB_ToAddMod((f_NR_GetSDAP_InDRBList(v_DRBId)),
                                              v_DRBId,
                                              cs_38508_PDCP_Config(ms500, ms80, omit));
    v_DRB_ToAddMod.pdcp_Config.discardTimerExt2_r17.setup:= ms2000;
                                              
    v_RLC_Config_v1700 := f_NR_RLC_Config_v1700(); //@sic R5-256933 sic@
    v_RLC_BearerConfigList[0] := cs_38508_RLC_BearerConfig_DRB(v_DRBId,
                                                               cs_38508_RLC_Config_UM_DRB(f_NR_UL_UM_RLC(), f_NR_DL_UM_RLC(f_NR_CellInfo_GetIsFR1(nr_Cell1))),
                                                               cs_38508_LogicalChannelConfig_DRB,
                                                               -,
                                                               v_RLC_Config_v1700) ;

    f_NR5GC_RRC_ConnectedState3N_Def(nr_Cell1,
                                     TEST_LOOPModeA_ON,
                                     cs_UE_TestLoopModeA_NR_LB_Setup_NoScaling,
                                     -,
                                     v_RLC_BearerConfigList,
                                     -,
                                     {v_DRB_ToAddMod},
                                     {v_SS_Drb_Config});
    //Initialize PDCP Parameters
    f_NR_PDCP_Init(v_NR_PDCP_State, f_NR_38508_SetPDCP_SN_Size(), v_DRBId);
    f_NR_TestBody_Set(true);
    f_TC_7_1_3_5_1a_NR_TestBody(v_NR_PDCP_State);
    f_NR_TestBody_Set(false);
        
    
    //Postamble
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
   
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.3.5.1a
   * @param     p_NR_PDCP_State
   * @status    APPROVED (NR5GC)
   */
   function f_TC_7_1_3_5_1a_NR_TestBody(NR_PDCP_SS_State_Type p_NR_PDCP_State) runs on NR_BASE_PTC
  {
    var NR_SecurityParams_Type v_NR_Security:= f_NR_Security_Get();
    var SubFrameTiming_Type v_TimingInfo1;
    var SubFrameTiming_Type v_TimingInfo2;
    var NR_PDCP_SDUList_Type v_SduList;
    var float v_T_discardTimer := 500.0;
    var float v_T_discardTimerExt := 2000.0;
    p_NR_PDCP_State.KUPenc := v_NR_Security.AS_Ciphering.KUPenc;
    //Initilize SDU to be sent
    v_SduList := f_GenerateSDU (p_NR_PDCP_State, {46, 62, 94}); //@sic R5s250191 sic@
    
     //The SS does not allocate UL grants unless when explicitly stated so in the procedure
     f_NR_ULGrantConfiguration_Stop(nr_Cell1, -, cs_NR_UplinkTimeAlignment_Keep);
     v_TimingInfo1 := f_NR_GetNextSendOccasion_DL(nr_Cell1);
     v_T_discardTimer := f_NR_SetTimerToleranceMax(nr_Cell1,l2Timer,v_T_discardTimer); //DiscardTimer 500 ms
     v_TimingInfo2 := f_NR_GetNextSendOccasion_ULafterDL(nr_Cell1, v_TimingInfo1, float2int(v_T_discardTimer));
  
    //@siclog "Step 1" siclog@ The SS sends a PDCP Data PDU via RLC-UM RB. Data PDU = 46 bytes.
    f_NR_PDCP_Send(p_NR_PDCP_State,nr_Cell1,v_SduList[0], v_TimingInfo1);
    //@siclog "Step 2" siclog@ Wait Discard timer to expire.
    //@siclog "Step 3" siclog@ The SS resumes normal UL grant allocation.
    f_NR_ULGrantConfiguration_Start(nr_Cell1, cs_TimingInfo_NR(v_TimingInfo2));
    //@siclog "Step 4" Does UE transmit a PDCP Data PDU of size 46 bytes?
    f_NR_PDCP_Recv(p_NR_PDCP_State, nr_Cell1, v_SduList[0], cr_RlcBearerRouting_NR(nr_Cell1));
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
    
    //@siclog "Step 5" siclog@ Configure SS not to allocate UL grant to the UE
    f_NR_ULGrantConfiguration_Stop(nr_Cell1, -, cs_NR_UplinkTimeAlignment_Keep);
  
    //@siclog "Step 6" siclog@ The SS sends a PDCP Data PDU via RLC-UM RB. Data PDU = 62 bytes
    v_TimingInfo1 := f_NR_GetNextSendOccasion_DL(nr_Cell1);
    f_NR_PDCP_Send(p_NR_PDCP_State,nr_Cell1, v_SduList[1], v_TimingInfo1);

    //@siclog "Step 7" siclog@ Wait for discardTimerExt2-r17 to expire
    v_T_discardTimerExt := f_NR_SetTimerToleranceMax(nr_Cell1,l2Timer, v_T_discardTimerExt); //DiscardTimer 2000 ms
    v_TimingInfo2 := f_SubFrameTiming_AddMilliSeconds(v_TimingInfo1, float2int(v_T_discardTimerExt));
    //@siclog "Step 8" siclog@ The SS sends a PDCP Data PDU via RLC-UM RB. Data PDU = 94 bytes.
    f_NR_PDCP_Send(p_NR_PDCP_State,nr_Cell1, v_SduList[2], v_TimingInfo2);
    //@siclog "Step 9" siclog@ The SS resumes normal UL grant allocation.
    v_TimingInfo2 := f_NR_GetNextSendOccasion_ULafterDL(nr_Cell1, v_TimingInfo1, float2int(v_T_discardTimerExt));
    f_NR_ULGrantConfiguration_Start(nr_Cell1, cs_TimingInfo_NR(v_TimingInfo2));
  
    //@siclog "Step 10" siclog@ The SS resumes normal UL grant allocation.
    f_NR_PDCP_Recv(p_NR_PDCP_State, nr_Cell1, v_SduList[2], cr_RlcBearerRouting_NR(nr_Cell1), false); //@sic R5s250191 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 10");
   
  }

}
