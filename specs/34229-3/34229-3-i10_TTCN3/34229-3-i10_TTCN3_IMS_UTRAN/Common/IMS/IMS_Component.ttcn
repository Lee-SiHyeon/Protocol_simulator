  {
    return vc_IMS_Global.ImsInfo.RanType;
  }

  /*
   * @desc      return true if IPCAN matches the given RanType
   * @param     p_RanType
   * @return    boolean
   * @status    APPROVED (ENDC, IMS, IMS_IRAT, LTE, LTE_A_IRAT, LTE_A_PRO, LTE_A_R10_R11, LTE_A_R12, LTE_IRAT, MCX, NR5GC, NR5GC_IRAT, POS)
   */
  function fl_IMS_PTC_CheckRanType(IPCAN_RAN_Type p_RanType) runs on IMS_PTC return boolean
  {
    var template (omit) IPCAN_RAN_Type v_RanType := f_IMS_PTC_GetRanType();
    if (isvalue(v_RanType)) {
      return (p_RanType == valueof(v_RanType));
    }
    return false;
  }

