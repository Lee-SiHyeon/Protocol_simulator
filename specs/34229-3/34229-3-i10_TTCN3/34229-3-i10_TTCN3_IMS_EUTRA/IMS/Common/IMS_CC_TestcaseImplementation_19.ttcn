module IMS_CC_TestcaseImplementation_19 {

  import from IMS_CC_CommonFunctions all;
  import from IMS_Component all;
  import from IMS_IPCAN_Coordination all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Registration all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      Common test body for test cases 19.1.1, 19.1.2, J.19.1, J.19.2
   * @param     p_GeolocationUsage  (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_IMS_EmergencyCallWithEmergencyRegistration_IMS1(boolean p_GeolocationUsage := false) runs on IMS_PTC
  {
    // Trigger SS to execute location related functions to allow UE to get its position
    if  (p_GeolocationUsage) {
      f_IMS_IPCAN_UpdateUELocationInformation(IPCAN);
    }
      
    f_IMS_IMS_SendCoOrdMsg(OtherPDN);
    
    f_IMS_IMS_WaitForTrigger(OtherPDN); // wait for trigger after IMS call release
  }

  /*
   * @desc      Common test body for test cases 19.1.1, 19.1.2, J.19.1, J.19.2
   * @param     p_GeolocationUsage  (default value: false)
   * @param     p_CheckGeolocationAbsent  (default value: false)
   * @status    APPROVED (IMS)
   */
  function f_IMS_EmergencyCallWithEmergencyRegistration_IMS2(boolean p_GeolocationUsage := false,
                                                             boolean p_CheckGeolocationAbsent := false) runs on IMS_PTC
  {
    var INVITE_Request v_InviteRequest;

    f_IMS_PTC_Init(PDN_2);

    f_IMS_IMS_WaitForTrigger(OtherPDN);

    f_IMS_TestBody_Set(true);

    //@siclog "Steps 1-15" siclog@
    f_IMS_CC_StartCall(IPCAN_EmergencyCall_NormalService);  // steps 1-15 of 4.5A.4

    // 1. Emergency registration
    // Note: Emergency call tests apply only to UEs supporting full IMS security
    f_IMS_EmergencyRegistration();
    
    // 2.  IMS emergency call setup with PSAP (Public Safetly Answering Point)
    v_InviteRequest := f_IMS_EmergencyCallSetup(-, p_GeolocationUsage); // geolocation information to be used
    // absence of geolocation is to be checked
    if (p_CheckGeolocationAbsent) {f_IMS_CheckGeolocationAbsent(v_InviteRequest);} // @sic R5-222427 sic@

    //@siclog "Steps 16-17" siclog@
    f_IMS_EmergencyCallRelease(v_InviteRequest);
    
    f_IMS_TestBody_Set(false);

    f_IMS_IMS_SendCoOrdMsg(OtherPDN);
  }

}
