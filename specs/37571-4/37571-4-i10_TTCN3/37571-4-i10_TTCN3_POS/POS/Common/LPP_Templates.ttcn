  template (value) LPP_Message cs_LppProvideAssistData(TransactionNumber p_TransactionNumber,
                                                       Initiator p_Initiator,
                                                       template (omit) A_GNSS_ProvideAssistanceData p_AgnssProvideAssistData,
                                                       template (omit) OTDOA_ProvideAssistanceData p_OtdoaProvideAssistData,
                                                       template (omit) Acknowledgement p_Acknowledgement := omit, //@sic R5s130288 sic@
                                                       template (omit) TBS_ProvideAssistanceData_r14 p_TbsProvideAssistData := omit, //@sic R5-173922 sic@
                                                       template (omit) WLAN_ProvideAssistanceData_r14 p_WlanProvideAssistData := omit, //iPOS inclusion
                                                       template (omit) Sensor_ProvideAssistanceData_r14 p_SensorProvideAssistData := omit,
