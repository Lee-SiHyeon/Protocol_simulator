             if (v_FDD_Add_UE_NR_Cap_logicalChannelSR_DelayTimer and v_TDD_Add_UE_NR_Cap_logicalChannelSR_DelayTimer) // fail case: both FDD and TDD capabilities are reported and IE in mac_Parameters.mac_ParametersXDD_Diff is not
