  template (present) RLC_Parameters cr_NR_RLC_Parameters :=
  { /* @status    APPROVED (ENDC, NR5GC) */
    am_WithShortSN   := f_NR_Derive_RLC_Parameter_am_WithShortSN() ifpresent,
    um_WithShortSN   := f_NR_Derive_RLC_Parameter_um_WithShortSN() ifpresent,
    um_WithLongSN    := f_NR_Derive_RLC_Parameter_um_WithLongSN() ifpresent,
    extendedT_PollRetransmit_r16 := *,         /* @sic R5s201387 BASELINE MOVING 2020 sic@ */
