  /*
   * @desc      Function to check the notes on MRDC calling a nested function per IE
   * @param     p_Received_MRDCCapabilityMsg
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function fl_Check_MRDC_Notes(UE_MRDC_Capability p_Received_MRDCCapabilityMsg, NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-197070 R5-225391 R5-232204 sic@
    fl_Check_splitSRB_WithOneUL_Path(p_Received_MRDCCapabilityMsg);                  //Note 1
    fl_Check_splitDRB_withUL_Both_MCG_SCG(p_Received_MRDCCapabilityMsg);             //Note 2
    fl_Check_srb3(p_Received_MRDCCapabilityMsg);                                     //Note 3
    fl_Check_RF_ParamsMRDC_r15(p_Received_MRDCCapabilityMsg, p_Configuration_Type);  //Note 4
    fl_Check_sftd_MeasPSCell(p_Received_MRDCCapabilityMsg);                          //Note 5
    fl_Check_sftd_MeasNR_Cell(p_Received_MRDCCapabilityMsg);                         //Note 6
    if (p_Configuration_Type == NE_DC){
      fl_Check_sftd_MeasPSCell_NEDC(p_Received_MRDCCapabilityMsg);                   //Note 7
    }
  }

   /*
   * @desc      Function to check signaling of features in measAndMobParametersMRDC-Common-v1700.condPSCellChangeParameters_r17
   * @param     p_Received_MRDCCapabilityMsg
   * @status    APPROVED (ENDC)
   */
   function fl_Check_MRDCCommon_InitiatedCondPSCellChange_ENDC_r17(UE_MRDC_Capability p_Received_MRDCCapabilityMsg)
   {// @sic R5-242328 R5-246408 R5-255780 sic@
     var boolean v_InitiatedCondPSCellChange_ENDC_r17 := false;

     // mn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 := isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.mn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17);
     f_CompareCapability_vs_PICS(pc_mn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17,"mn-InitiatedCondPSCellChange-FR1FDD-ENDC-r17");
     
     // mn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 := isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.mn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17);
     f_CompareCapability_vs_PICS(pc_mn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17,"mn-InitiatedCondPSCellChange-FR1TDD-ENDC-r17");

     // mn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 :=  isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.mn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17);
     f_CompareCapability_vs_PICS(pc_mn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17,"mn-InitiatedCondPSCellChange-FR2TDD-ENDC-r17");
     
     // sn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 := isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.sn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17);
     f_CompareCapability_vs_PICS(pc_sn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17,"sn-InitiatedCondPSCellChange-FR1FDD-ENDC-r17");
     
     // sn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 := isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.sn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17);
     f_CompareCapability_vs_PICS(pc_sn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17, "sn-InitiatedCondPSCellChange-FR1TDD-ENDC-r17");
     
     // sn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17
     v_InitiatedCondPSCellChange_ENDC_r17 := isvalue(p_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700.condPSCellChangeParameters_r17.sn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17);
      f_CompareCapability_vs_PICS(pc_sn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17, v_InitiatedCondPSCellChange_ENDC_r17,"sn-InitiatedCondPSCellChange-FR2TDD-ENDC-r17");
   }

  /*
   * @desc      Function to check PICS within optional groups of fields matching with ifpresent in Rel-17.
   *            PICS shall not be set if it is in a group not siganlled by the UE. If there is a mismatch, an inconclusive verdict is raised.
   * @param     p_MRDC_Capability
   * @status    APPROVED (ENDC)
   */
  function fl_Check_MRDC_PICSinOptionalGroups_NR_r17 (UE_MRDC_Capability p_MRDC_Capability)
  { //@sic R5s240548 sic@
      var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;

      if (not isvalue(v_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1700.measAndMobParametersMRDC_Common_v1700)) {  // UE_MRDC_Capability_v1700.MeasAndMobParametersMRDC_Common_v1700
          if (pc_mn_InitiatedCondPSCellChange_FR1FDD_ENDC_r17 or pc_mn_InitiatedCondPSCellChange_FR1TDD_ENDC_r17 or pc_mn_InitiatedCondPSCellChange_FR2TDD_ENDC_r17) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling MeasAndMobParametersMRDC_Common_v1700, no PICS shall be set in a branch when parent is not present");
          }
      }
   }; //end of fl_Check_MRDC_PICSinOptionalGroups_NR_r17

  /*
   * @desc      Function to check PICS within optional groups of fields matching with ifpresent in Rel-18.
   *            PICS shall not be set if it is in a group not siganlled by the UE. If there is a mismatch, an inconclusive verdict is raised.
   * @param     p_MRDC_Capability
   * @status    APPROVED (ENDC)
   */
  function fl_Check_MRDC_PICSinOptionalGroups_NR_r18 (UE_MRDC_Capability p_MRDC_Capability)
  {
    var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;

      if (not isvalue(v_Received_MRDCCapabilityMsg.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.measAndMobParametersMRDC_v1810.measAndMobParametersMRDC_Common_v1810)) {  // UE_MRDC_Capability_v1800.MeasAndMobParametersMRDC_v1810.MeasAndMobParametersMRDC_Common_v1810
          if (pc_mn_ConfiguredMN_TriggerSCPAC_r18 or pc_mn_ConfiguredSN_TriggerSCPAC_r18 or pc_sn_ConfiguredSCPAC_r18 or pc_mn_ConfiguredMN_TriggerSCPAC_afterSCG_release_r18 or pc_mn_ConfiguredReferenceConfigSCPAC_r18 or pc_sn_ConfiguredReferenceConfigSCPAC_r18 or pc_condHandoverWithCandSCG_Addition_r18 or pc_condHandoverWithCandSCG_FR1_FR2_change_r18 or pc_condHandoverWithCandSCG_FDD_TDD_change_r18) {
            f_SetVerdict(inconc,__FILE__, __LINE__, "UE is not signalling UE_MRDC_Capability_v1800.MeasAndMobParametersMRDC_v1810.MeasAndMobParametersMRDC_Common_v1810, no PICS shall be set in a branch when parent is not present");
          }
      }
   }; //end of fl_Check_MRDC_PICSinOptionalGroups_NR_r18

 /*
   * @desc      Function to check some Rel 15 UE MRDC capabilities
   *            Reference 38.523-1 Table 8.2.1.1.1.3.3-7 / Table 8.2.1.1.2.3.3-5
   * @param     p_MRDC_Capability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function fl_MRDCCap_CommonChecks_r15(UE_MRDC_Capability p_MRDC_Capability, NR_Configuration_Type p_Configuration_Type)
  { //@sic R5-194844 R5s190471 R5-197070 sic@
    var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;
    
    fl_Check_MRDC_Notes(v_Received_MRDCCapabilityMsg, p_Configuration_Type);
  } // fl_MRDCCap_CommonChecks_r15

 /*
   * @desc      Function to check some Rel 16 UE MRDC capabilities
   * @param     p_MRDC_Capability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function fl_MRDCCap_CommonChecks_r16(UE_MRDC_Capability p_MRDC_Capability, NR_Configuration_Type p_Configuration_Type)
  {
    var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;
    
    fl_MRDCCap_CommonChecks_r15(v_Received_MRDCCapabilityMsg, p_Configuration_Type);
 
  } // fl_MRDCCap_CommonChecks_r16

 /*
   * @desc      Function to check some Rel 17 UE MRDC capabilities
   * @param     p_MRDC_Capability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function fl_MRDCCap_CommonChecks_r17(UE_MRDC_Capability p_MRDC_Capability, NR_Configuration_Type p_Configuration_Type)
  {// @sic R5-242328 R5s240548 R5-246408 sic@
    var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;
    
    fl_MRDCCap_CommonChecks_r16(v_Received_MRDCCapabilityMsg, p_Configuration_Type);
    if (p_Configuration_Type == EN_DC){
      fl_Check_MRDCCommon_InitiatedCondPSCellChange_ENDC_r17(v_Received_MRDCCapabilityMsg);
    }
    fl_Check_MRDC_PICSinOptionalGroups_NR_r17(v_Received_MRDCCapabilityMsg); // PICS set in optional group of IEs checked in Rel-17
  } // fl_MRDCCap_CommonChecks_r17

 /*
   * @desc      Function to check some Rel 18 UE MRDC capabilities
   * @param     p_MRDC_Capability
   * @param     p_Configuration_Type
   * @status    APPROVED (ENDC)
   */
  function fl_MRDCCap_CommonChecks_r18(UE_MRDC_Capability p_MRDC_Capability, NR_Configuration_Type p_Configuration_Type)
  {
    var UE_MRDC_Capability v_Received_MRDCCapabilityMsg := p_MRDC_Capability;
    
    fl_MRDCCap_CommonChecks_r17(v_Received_MRDCCapabilityMsg, p_Configuration_Type);
    fl_Check_MRDC_PICSinOptionalGroups_NR_r18(v_Received_MRDCCapabilityMsg); // PICS set in optional group of IEs checked in Rel-18
  } // fl_MRDCCap_CommonChecks_r18

  /*
   * @desc      Function to match the received UECapabilityInformation with the expected UECapabilityInformation.
   *            Reference 38.523-1 8.2.1.1.1.3.3-7 / Table 8.2.1.1.2.3.3-5
   * @param     p_MRDC_Capability
   * @param     p_UE_AccessStratumRelease
   * @param     p_Configuration_Type (default value: EN_DC)
   * @status    APPROVED (ENDC)
   */
  function f_NR_MRDCFullCapabilityCheck (UE_MRDC_Capability p_MRDC_Capability, UE_NR_Capability.accessStratumRelease p_UE_AccessStratumRelease, NR_Configuration_Type p_Configuration_Type := EN_DC)
  {
    var UE_MRDC_Capability v_Received_MRDCCapability;
    var template UE_MRDC_Capability v_MRDCCapability;

    if (p_Configuration_Type == EN_DC) // Option 3
    {
         if ((not (pc_EN_DC))){
            FatalError(__FILE__, __LINE__, "Table 8.2.1.1.1.3.3-7: PICS for condition on pc_EN_DC not set");
         }
    }
    else if (p_Configuration_Type == NE_DC) // Option 4
    {
         if ((not (pc_NE_DC))){
            FatalError(__FILE__, __LINE__, "Table 8.2.1.1.2.3.3-5: PICS for condition on pc_NE_DC not set");
         }
    }
    else {
       f_SetVerdictInconc (__FILE__, __LINE__, "Selected NR Configuration Type is not applicable");
    }

      
    v_Received_MRDCCapability := p_MRDC_Capability;
 
    select (p_UE_AccessStratumRelease) {
      case (rel15) {
         v_MRDCCapability := cr_UeCapabilitiesRAT_Container_MRDC_r15;

         fl_MRDCCap_CommonChecks_r15(v_Received_MRDCCapability, p_Configuration_Type); // to check some Rel 15 MRDC_Cap contents
      }
      case (rel16) {
         v_MRDCCapability := cr_UeCapabilitiesRAT_Container_MRDC_r16;
         fl_MRDCCap_CommonChecks_r16(v_Received_MRDCCapability, p_Configuration_Type);
      }
      case (rel17) {
         v_MRDCCapability := cr_UeCapabilitiesRAT_Container_MRDC_r17;
         fl_MRDCCap_CommonChecks_r17(v_Received_MRDCCapability, p_Configuration_Type);
      }
      case (rel18) { // @sic R5s240531 BASELINE MOVING 2024 rel-18 sic@
         v_MRDCCapability := cr_UeCapabilitiesRAT_Container_MRDC_r18;
         fl_MRDCCap_CommonChecks_r18(v_Received_MRDCCapability, p_Configuration_Type);
      }
      case else  {
        f_SetVerdictInconc (__FILE__, __LINE__, "AccessStratumRelease not applicable");
        // UE with unsupported release is not failed. Anyway it will never reach this point if it is not an expected UE Release
      }
    }
 
    // Match the received UE-NR-CapabilityInformation with the expected UE_NR_Capability template
    fl_EUTRANR_UE_Capability_MatchTemplates(v_Received_MRDCCapability, v_MRDCCapability);
  }

}
