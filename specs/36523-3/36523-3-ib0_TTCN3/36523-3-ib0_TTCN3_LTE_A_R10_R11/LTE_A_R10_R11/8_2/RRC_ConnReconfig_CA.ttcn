   */
  function f_TC_8_2_2_7_2_EUTRA() runs on EUTRA_PTC
  { /* CA /  RRC connection reconfiguration / sTAG addition/modification/release / Success / Inter-Band CA */
    f_TC_8_2_2_7_Common(eutra_Cell1, eutra_Cell10, CA_InterBand);
  }

  /*
   * @desc      REFERENCE TS 36.523-1 clause 8.2.2.7.3
   * @status    APPROVED (LTE_A_R10_R11)
   */
   function f_TC_8_2_2_7_3_EUTRA() runs on EUTRA_PTC
  { /* CA / RRC connection reconfiguration / sTAG addition/modification/release / Success / Intra-band non-contiguous CA */
    f_TC_8_2_2_7_Common(eutra_Cell1, eutra_Cell3, CA_IntraBandNonContiguous); //@sic R5s150329 sic@
  }

}
