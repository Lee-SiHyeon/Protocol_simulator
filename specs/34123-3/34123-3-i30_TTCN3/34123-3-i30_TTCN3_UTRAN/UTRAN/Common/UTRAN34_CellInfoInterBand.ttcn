module UTRAN34_CellInfoInterBand {

  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from CommonDefs all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CellInfoFrequency all;
  import from UTRAN34_Parameters all;
  import from UTRAN_CellInfo all;
  import from UTRAN_Component all;
  import from UTRAN_RRC_Templates all;

  /*
   * @desc      To set the band of the cell
   * @param     p_CellId
   * @param     p_Band
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_CellInfo_ChangeBand(UTRAN_CellId_Type p_CellId,
                                         integer p_Band) runs on UTRAN_PTC
  {
    var UTRAN_CellInfo_Type v_CellInfo := f_UTRAN_CellInfo_Get(p_CellId);
    
    v_CellInfo.cellInfo_Specific_FDD.operationBand := f_UTRAN_FrequencyBandFDD(p_Band);
    v_CellInfo.sysInfo.SIB5 := f_UTRAN_InitializeSIB5_SIB5Bis(p_Band,
                                                              v_CellInfo.powerPICH,
                                                              v_CellInfo.cellInfo_Specific_FDD.powerAICH);
    f_UTRAN_CellInfo_Set(p_CellId, v_CellInfo);
  }

  /*
   * @desc      Returnn the frequencies Mid/High/Low of the given band
   *            Frequencies acc to 34.108 cl 5
   * @param     p_Band
   * @return    UTRAN34_Frequency_List_Type
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_GetFrequenciesFDD(integer p_Band) return UTRAN34_Frequency_List_Type
  {
    var template (value) UTRAN34_Frequency_List_Type v_Frequency_List;
    
    //Initialise with dummy frequencies
    v_Frequency_List.f1 := cs_FreqInfo_FDD(0); //Mid
    v_Frequency_List.f2 := cs_FreqInfo_FDD(0); //High
    v_Frequency_List.f3 := cs_FreqInfo_FDD(0); //Low
    v_Frequency_List.f4 := cs_FreqInfo_FDD(0); //@sic R5s160943 sic@
    
    select (p_Band) {
      case (1){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(10700); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(10837); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(10563); //Low
      }
      case (2){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(9800); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(9937); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(9663); //Low @sic R5s160943 sic@
      }
      case (3){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(1337); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(1512); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(1163); //Low
      }
      case (4){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(1675); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(1737); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(1538); //Low
      }
      case (5){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4400); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4457); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4358); //Low
      }
      case (6){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4400); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(1062); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(1037); //Low
      }
      case (7){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(2400); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(2562); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(2238); //Low
      }
      case (8){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3013); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3087); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(2938); //Low
      }
      case (9){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(9312); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(9387); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(9237); //Low
      }
      case (10){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3250); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3387); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(3113); //Low
      }
      case (11){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3750); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3787); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(3712); //Low
      }
      case (12){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(3870); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(3902); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(3843); //Low
      }
      case (13){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4030); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4042); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4018); //Low
      }
      case (14){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4130); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4142); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4118); //Low
      }
      case (19){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(812); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(837); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(787); //Low
      }
      case (20){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4575); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(4637); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4513); //Low
      }
      case (21){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(887); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(912); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(862); //Low
      }
      case (22){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(4850); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(5037); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(4663); //Low
      }
      case (25){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(5262); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(5412); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(5113); //Low
      }
      case (26){
        v_Frequency_List.f1 := cs_FreqInfo_FDD(5837); //Mid
        v_Frequency_List.f2 := cs_FreqInfo_FDD(5912); //High
        v_Frequency_List.f3 := cs_FreqInfo_FDD(5763); //Low
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid UTRAN Band, not defined in 34.123-1 table 6.3");
      }
    }
    return valueof(v_Frequency_List);
  }

  /* @desc      Function used to  change the band and associated frequency of a cell
   * @param     p_CellId
   * @param     p_Band              (default value: px_SecondaryBand)
   * @param     p_FeFACH_TC         (default value: false)
   * @status    APPROVED (UTRAN)
   */
  function f_UTRAN34_AssignBandAndFrequency(UTRAN_CellId_Type p_CellId,
                                            integer p_Band := px_SecondaryBand,
                                            boolean p_FeFACH_TC := false ) runs on UTRAN_PTC
  {
    var UTRAN34_Frequency_List_Type v_Frequency_List := f_UTRAN34_GetFrequenciesFDD ( p_Band );
    
    //Change the band of the cell
    f_UTRAN34_CellInfo_ChangeBand( p_CellId, p_Band);
    //Change the frequency of the cell
    select (p_CellId){
      case (utran34_CellA, utran34_CellB, utran34_CellC, utran34_CellG, utran34_CellH,
            utran34_Cell1, utran34_Cell2, utran34_Cell3, utran34_Cell8 ) {
        //@sic R5-163154: added utran34_Cell1..8 R5s160943 sic@
        //According to 34.108 clause 6.1.5, cells A, B, C,G,H are assigned to the Mid frequency
        f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f1);
      }
      case (utran34_CellD, utran34_CellE, utran34_CellF,
            utran34_Cell4, utran34_Cell5, utran34_Cell6) {
        //@sic R5-163154: added utran34_Cell1..8 R5s160943 sic@
        //According to 34.108 clause 6.1.5, cells D, E, F are assigned to the High frequency
        f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f2);
      }
      case(utran34_Cell7){
        if(p_FeFACH_TC){ //In feFACH tc assign f3 (low frequency) to cell7 @sic R5-163154 sic@
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f3);
        } else {
          f_UTRAN34_CellInfo_SetFrequencyInfo(p_CellId, v_Frequency_List.f2);
        }
      }
      case else {
        FatalError(__FILE__, __LINE__, "Invalid UTRAN cell");
      }
    }
  }

}
