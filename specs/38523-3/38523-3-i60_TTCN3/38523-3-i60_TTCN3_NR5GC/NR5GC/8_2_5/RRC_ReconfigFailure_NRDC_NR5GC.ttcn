module RRC_ReconfigFailure_NRDC_NR5GC {

  import from NR_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "UNALIGNED_PER_OctetAligned"};
  import from CommonDefs all;
  import from L2_Common4G5G all;
  import from LoopbackIP all;
  import from NG_NASTemplateFunctions all;
  import from NG_NAS_Common all;
  import from NR5GC_CommonFunctions all;
  import from NR5GC_NASSteps all;
  import from NR5GC_RRCSteps all;
  import from NR5GC_RRCSteps_NRDC all;
  import from NR_ASP_DrbDefs all;
  import from NR_ASP_Templates_DRB_Data all;
  import from NR_ASP_Templates_RB_Config all;
  import from NR_ASP_Templates_SRB all;
  import from NR_ASP_TypeDefs all;
  import from NR_CellCfg_Templates all;
  import from NR_CellInfo all;
  import from NR_CommonDefs all;
  import from NR_CommonFunctions all;
  import from NR_Component_Base all;
  import from NR_Component_NR5GC all;
  import from NR_ConfigurationSteps all;
  import from NR_L2_Common all;
  import from NR_RLC_Common all;
  import from NR_RRC_BWP_Templates all;
  import from NR_Timing all;
  import from SDAP_TypeDefs all;

  template (present) UL_DCCH_Message cr_38508_SCGFailureInformation(template (present) FailureReportSCG p_FailureReportSCG := ?) :=
  { /* @status    APPROVED (NR5GC) */
    // As per 38.508-1 Table Table 4.6.1-24A: SCGFailureInformation
    message_ := {
        c1 :={
          scgFailureInformation  := {
            criticalExtensions := {
              scgFailureInformation := {
                failureReportSCG       := p_FailureReportSCG,
                nonCriticalExtension   := *
              }
            }
          }
        }
    }
  };

  template (present) FailureReportSCG cr_FailureReportSCG(template (present) FailureReportSCG.failureType p_FailureType,
                                                          template FailureReportSCG.failureType_v1610 p_FailureType_v1610 := *):=
  { /* @status    APPROVED (NR5GC) */
    failureType                 := p_FailureType,
    measResultFreqList          := *,
    measResultSCG_Failure       := *,
    locationInfo_r16            := *,
    failureType_v1610           := p_FailureType_v1610,
    previousPSCellId_r17        := *,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    failedPSCellId_r17          := *,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    timeSCGFailure_r17          := *,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    perRAInfoList_r17           := *,   /* @sic R5s221179 BASELINE MOVING 2022 rel-17 sic@ */
    perRAInfoList_v17b0         := *,   /* @sic R5s250030 BASELINE UPGRADE 2025 sic@ */
    perRAInfoList_v1840         := *    /* @sic R5s250030 BASELINE UPGRADE 2025 sic@ */
  };

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.5.1.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_5_1_2_NR5GC() runs on NR5GC_PTC
   { //Radio link failure / Random access problem / NR-DC
    f_NR5GC_Init_NRDC(NR_1, {nr_Cell1, nr_Cell10}); //@sic R5s210774, R5-214752 sic@
    
    //Create and configure NR cell1 and NR cell 10.
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell); //@sic R5s210891 sic@

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A, TEST_LOOPModeB_ON);
    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_SCG, TEST_LOOPModeB_ON);

    f_NR_TestBody_Set(true);

    fl_TC_8_2_5_1_2_TestBody();

    f_NR_TestBody_Set(false);
    
    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
   }

  /*
   * @desc      test body of TC_8_2_5_1_2
   * @status    APPROVED (NR5GC)
   */
   function fl_TC_8_2_5_1_2_TestBody() runs on NR5GC_PTC
   {
    var PDUSessionInfoList_Type v_PDUSessionInfo := f_NR5GC_MobileInfo_GetSessionInfoList();
    var PDN_Index_Type v_PdnIndex := f_NR5GC_GetPdnIndex(v_PDUSessionInfo[0]);
    var SDAP_SDUList_Type v_SDAP_Data := { f_IPv4IPv6_IcmpEchoReply(f_LoopbackModeB_IP_Address_NW(-, v_PdnIndex)) }; //@sic R5s210774 sic@
    var DRB_Identity v_DrbId := f_NR_GetDefaultDRB_SCG();
    var template (value) QosFlow_Identification_Type v_QosFlowId := f_NR_GetQosFlowIdentification_ForDRBId(v_DrbId);
    timer t_Timer := 5.0;
    
    // @siclog "Step 1" siclog@
    // The SS shall not respond to the Scheduling Requests for the IP Packet transmitted at next step
    f_NR_ULGrantConfiguration_Stop(nr_Cell10, -, cs_NR_UplinkTimeAlignment_Keep);
    f_NR_SS_RachProcedureConfig(nr_Cell10, cs_NR_RachProcedureConfig_NoResponse);

    // @siclog "Step 2" siclog@
    // The SS transmits one IP Packet on SCG DRB
    DRB.send(cas_NR_DRB_COMMON_REQ_SDAP_SDUList(nr_Cell10, v_QosFlowId, v_SDAP_Data));
    
    // @siclog "Step 3" siclog@
    // The SS shall not respond to the PRACH Preambles thereby simulating a random access problem
    // @siclog "Step 4" siclog@
    // Check: Does the UE transmit in the next 5 sec (arbitrary value) a SCGFailureInformation message with failureType set to randomAccessProblem?
    t_Timer.start;
    alt{
      // @siclog "Step 4" siclog@
      // Check: Does the UE transmit in the next 5 sec (arbitrary value) a SCGFailureInformation message with failureType set to 'randomAccessProblem'?
      [] SRB.receive (car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_SCGFailureInformation(cr_FailureReportSCG(randomAccessProblem))))
        {// verdict pass the UE transmit SCGFailureInformation message in the next 5 sec
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 4");
          t_Timer.stop;
        }
      [] t_Timer.timeout
        {// verdict fail the UE doesn't transmit SCGFailureInformation message in the next 5 sec
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 4");
        }
    }
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.5.2.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_5_2_2_NR5GC() runs on NR5GC_PTC
  { //Radio link failure / PSCell out of sync indication / NR-DC
    var template (omit) NR_BWP_DownlinkDedicated_RadioLinkMonitoringConfig_Type v_RadioLinkMonitoringConfig;

    f_NR5GC_Init_NRDC(NR_4, {nr_Cell1, nr_Cell10}); //@sic R5s210776, R5-215715 sic@

    v_RadioLinkMonitoringConfig := cs_38508_RadioLinkMonitoringConfigDef(f_NR_CellInfo_GetSSB_Index(nr_Cell10));
    
    f_NR_CellInfo_SetRadioLinkMonitoringConfig(nr_Cell1, v_RadioLinkMonitoringConfig);
    f_NR_CellInfo_SetRadioLinkMonitoringConfig(nr_Cell10, v_RadioLinkMonitoringConfig);
    f_NR_Set_RLF_TimersAndConstants_t311(nr_Cell1);

    //Create and configure NR cell1 and NR cell 10
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell); //@sic R5s210891 sic@

    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);
    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_SCG);

    f_NR_TestBody_Set(true);

    f_TC_8_2_5_2_2_TestBody();

    f_NR_TestBody_Set(false);
    
    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  }

  /*
   * @desc      test body of TC_8_2_5_2_2_NR5GC
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_5_2_2_TestBody() runs on NR_BASE_PTC
  {
    timer t_Timer := 5.0;
    
    // @siclog "Step 1" siclog@
    // The SS changes NR Cell 10 power level to non-suitable "Off"in order to simulate radio link failure
    f_NR_SetCellPower(nr_Cell10, tsc_NR_NonSuitableOffCellSSS_EPRE, tsc_NR_NonSuitableOffCellSSS_EPRE);

    // @siclog "Step 2" siclog@
    // Check: Does the UE transmit in the next 5 sec a SCGFailureInformation message with failureType set to "t310-Expiry"?
    t_Timer.start;
    alt{
      [] SRB.receive (car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_SCGFailureInformation(cr_FailureReportSCG(t310_Expiry))))
        {// verdict pass the UE transmit SCGFailureInformation message in the next 5 sec
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 2");
          t_Timer.stop;
        }
      [] t_Timer.timeout
        {// verdict fail the UE doesn't transmit SCGFailureInformation message in the next 5 sec
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 2");
        }
    }
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.5.3.2
   * @status    APPROVED (NR5GC)
   */
   function f_TC_8_2_5_3_2_NR5GC() runs on NR5GC_PTC
   { //Radio link failure / rlc-MaxNumRetx failure / NR-DC
     //@sic R5s210791 R5s210891 R5-2147543 sic@
    var NR_RLC_SS_State_Type v_RLC_Rec;
    var template (value) NR_RadioBearerList_Type v_SS_Drb_ConfigList;
    
    f_NR5GC_Init_NRDC(NR_1, {nr_Cell1, nr_Cell10}); // System information combination NR-4 as defined in TS 38.508-1 clause 4.4.3.1.3 is used in NR cells.
    
    //Create and configure NR cell1 and NR cell 10.
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell);
    
    // The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (NR-DC) with DC bearer(MCG and SCG), and Test Loop Function (On) with UE test loop mode A according to TS 38.508-1, Table 4.5.1-1.
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A, TEST_LOOPModeA_ON);
    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    
    f_NR_AS_CipheringAlgorithm_Set_SCG(nea0);
    
    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_SCG, TEST_LOOPModeA_ON);

    v_SS_Drb_ConfigList[0] := cs_NR_SS_RadioBearer_AM_Test(tsc_NR_DRB3); //specifies AM mode with size 18 but Test mode
    f_NR_SS_CommonRadioBearerConfig(nr_Cell10, v_SS_Drb_ConfigList);

    // Initialization of RLC variables
    v_RLC_Rec := f_NR_InitRLC_Record();
    
    f_NR_TestBody_Set(true);

    fl_TC_8_2_5_3_2_TestBody (v_RLC_Rec);

    f_NR_TestBody_Set(false);
    
    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
   }

  /*
   * @desc      test body of TC_8_2_5_3_2
   * @param     p_NR_RLC_Rec        (by reference)
   * @status    APPROVED (NR5GC)
   */
   function fl_TC_8_2_5_3_2_TestBody(inout NR_RLC_SS_State_Type p_NR_RLC_Rec) runs on NR5GC_PTC
   {//@sic R5s210791 sic@
    var integer i;
    var integer v_RLC_SDUsize := 10;
    var DRB_Identity v_DrbId := f_NR_GetDefaultDRB_SCG();
    var template (value) NR_RLC_Status_NackListSN18Bit_Type v_NR_NackSN18Bit_List;
    var NR_RLC_DataField_Type v_NR_RLC_Data;
    
    var NR_RLC_DataFieldList_Type v_NR_RLC_DataList;
     
    timer t_Timer := 5.0;
    
    p_NR_RLC_Rec.TxDataSize := v_RLC_SDUsize;
    v_NR_RLC_Data := f_NR_GetTx_PRBS(p_NR_RLC_Rec);
    v_NR_RLC_DataList[tsc_RLC_SDU1] := f_NR_PDCP_PDU_Encvalue (cs_NR_PDCP_PDU_18B(0, v_NR_RLC_Data));
    
    // @siclog "Step 1" siclog@
    // The SS transmits AMD PDU#1 on the DRB associated with SCG
    f_NR_TxAMD_SDU(p_NR_RLC_Rec, v_DrbId, v_NR_RLC_DataList[tsc_RLC_SDU1],-,-,nr_Cell10);

    // @siclog "Step 2" siclog@
    // The UE transmits one AMD PDU#1
    f_NR_RxAMD_SDU(p_NR_RLC_Rec, v_DrbId, v_NR_RLC_DataList[tsc_RLC_SDU1], tsc_NR_P_Poll, nr_Cell10);
    
    // EXCEPTION: Steps 3-4 are repeated maxRetxThreshold times
    v_NR_NackSN18Bit_List := {crs_NR_RLC_NACK_SN18_Simple (0)};
    for (i := 0; i < p_NR_RLC_Rec.maxRetxThreshold; i:= i + 1) { // acc. to TS38508-1. Table 4.6.3-111: RLC-Config, maxRetxThreshold = t8
      // @siclog "Step 3" siclog@
      // The SS transmits an RLC STATUS PDU. ACK_SN =1 and NACK_SN =0.
      p_NR_RLC_Rec.AM_RX_Next := 1;
      f_NR_TxSTATUS_PDU(p_NR_RLC_Rec, v_DrbId, v_NR_NackSN18Bit_List, -, -, nr_Cell10);

      // @siclog "Step 4" siclog@
      // The UE transmits one AMD PDU#1
      p_NR_RLC_Rec.AM_RX_Next := 0;
      f_NR_RxAMD_SDU(p_NR_RLC_Rec, v_DrbId, v_NR_RLC_DataList[tsc_RLC_SDU1], tsc_NR_P_Poll, nr_Cell10);
    }

    // @siclog "Step 5" siclog@
    // The SS transmits an RLC STATUS PDU. ACK_SN =1 and NACK_SN =0.
    p_NR_RLC_Rec.AM_RX_Next := 1;
    f_NR_TxSTATUS_PDU(p_NR_RLC_Rec, v_DrbId, v_NR_NackSN18Bit_List, -, -, nr_Cell10);
    
    // @siclog "Step 6" siclog@
    t_Timer.start;
    alt{
      // Check: Does the UE transmit in the next 5 sec (arbitrary value) a SCGFailureInformation message with failureType set to 'rlc-MaxNumRetx'?
      [] SRB.receive (car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_SCGFailureInformation(cr_FailureReportSCG(rlc_MaxNumRetx))))
        {// verdict pass the UE transmit SCGFailureInformation message in the next 5 sec
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 6");
          t_Timer.stop;
        }
      [] t_Timer.timeout
        {// verdict fail the UE doesn't transmit SCGFailureInformation message in the next 5 sec
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
        }
    }
   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 8.2.5.4.2
   * @status    APPROVED (NR5GC)
   */
  function f_TC_8_2_5_4_2_NR5GC() runs on NR5GC_PTC
  { // Reconfiguration failure / SCG change failure / NR-DC
    
    f_NR5GC_Init_NRDC(NR_4, {nr_Cell1, nr_Cell10}); // System information combination NR-4 as defined in TS 38.508-1 clause 4.4.3.1.3 is used in NR cells.
    
    //Create and configure NR cell1 and NR cell 10.
    f_NR_CellConfig_Def(nr_Cell1);
    f_NR_CellConfig_Def(nr_Cell10, -, tsc_NRDC_SCG_Cell); // @sic R5s210891 sic@
    
    // The UE is in state RRC_CONNECTED using generic procedure parameter Connectivity (NR-DC) with DC bearer(MCG and SCG) according to TS 38.508-1 [4], Table 4.5.1-1.
    f_NR5GC_Preamble(nr_Cell1, STATE_IDLE_1A);
    f_NR_SetCellPower(nr_Cell10, tsc_NR_ServingCellSSS_EPRE_FR1, tsc_NR_ServingCellSSS_EPRE_FR2);
    f_NR5GC_RRC_ConnectedState3N_NRDC(nr_Cell1, nr_Cell10, MCG_SCG);
    
    f_NR_TestBody_Set(true);

    fl_TC_8_2_5_4_2_NR5GC_TestBody ();

    f_NR_TestBody_Set(false);
    
    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
   }

  /*
   * @desc      test body of TC_8_2_5_4_2_NR5GC
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_8_2_5_4_2_NR5GC_TestBody() runs on NR5GC_PTC
  { // @sic R5s210794 sic@
    var template (value) CellGroupConfig v_SCGConfig;
    var template (value) RRCReconfiguration_v1530_IEs v_V1530Ext;
    var DRB_Identity v_DrbId := f_NR_GetDefaultDRB_SCG();
    var float v_T304Min_1sec := f_NR_SetTimerToleranceMin (nr_Cell1, rrcTimer, 1.0);
    timer t_T304Expiry;
    timer t_WatchDog;

    f_NR_SS_RachProcedureConfig(nr_Cell10, cs_NR_RachProcedureConfig_NoResponse);
    
    // @siclog "Step 1" siclog@
    // The SS transmits an RRCReconfiguration message to perform SCG change with reconfigurationWithSync with the same PSCell.
    // Table 8.2.5.4.2.3.3-3
    v_SCGConfig := f_NR_GetSCGConfigNRDC_SCG(nr_Cell10, v_DrbId, -);
    v_SCGConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach_ConfigCommon.setup.rach_ConfigGeneric.preambleTransMax := n200; // Table 8.2.5.4.2.3.3-7

    v_V1530Ext := f_NRDC_BuildRRCReconfiguration_v1530(v_SCGConfig);
    
    t_T304Expiry.start(v_T304Min_1sec);                                           // t_T304Expiry will expire v_T304Min_1sec after RRCConnectionReconfiguration has been sent
    t_WatchDog.start(v_T304Min_1sec + 5.0);                                       // 5.0s for the UE to send FailureReportSCG only after expiry of T304
    f_NR_SendRRCReconfiguration_NRDC (nr_Cell1, nr_Cell10,-, v_V1530Ext,-,-,-,noRACH_Check);
                                            
    // @siclog "Step 2" siclog@
    // Wait for t304 ms to ensure that T304 expires (the value is defined in CellGroupConfig).
    // NOTE: SS does not respond to the UE transmitted RACH preambles on NR Cell 10
    // EXCEPTION: In parallel to the event described in step 2 the event described in Table 8.2.5.4.2.3.2-2 takes place - The UE transmits an RRCReconfigurationComplete message on NR Cell 1.
    t_T304Expiry.timeout;

    // @siclog "Step 3" siclog@
    // Check: Does the UE transmit on PCell (NR Cell 1) in the next 5 sec (arbitrary value) a SCGFailureInformation message with failureType set to 'synchReconfigFailure-SCG'?
    alt {
      [] t_WatchDog.timeout
        {
          f_NR_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 3");
        }
      [] SRB.receive (car_NR_SRB1_RrcPdu_IND(nr_Cell1, cr_38508_SCGFailureInformation(cr_FailureReportSCG(synchReconfigFailureSCG))))
        {
          t_WatchDog.stop;
          f_NR_PreliminaryPass(__FILE__, __LINE__, "Step 3");
        }
    }
  }

}
