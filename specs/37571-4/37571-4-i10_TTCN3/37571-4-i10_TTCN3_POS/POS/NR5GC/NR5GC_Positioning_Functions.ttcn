      }
    }
    if (not ((v_Found_SupportedBandwidthPRS_FR1 or v_Found_SupportedBandwidthPRS_FR2) and v_Found_Dl_PRS_BufferType and v_Found_DurationOfPRS_ProcessingSymbols and
             v_Found_DurationOfPRS_ProcessingSymbolsInEveryTms and (v_Found_MaxNumOfDL_PRS_ResProcessedPerSlot_SCS15 or v_Found_MaxNumOfDL_PRS_ResProcessedPerSlot_SCS30 or
