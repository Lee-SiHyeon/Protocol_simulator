module ECall_IRAT_NR5GC_IMS {

  import from IMS_Component all;
  import from IMS_NR5GC_Functions all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_Registration all;
  import from IMS_eCall_Functions all;
  import from LibSip_SIPTypesAndValues all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_1_NR5GC_IMS1() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration();

    // @siclog "Steps 31-43" siclog@
    // Steps 1 to 13 of the generic test procedure for IMS MT speech call establishment in 5GC specified in TS 38.508-1 [4] subclause 4.9.16 are performed.
    f_IMS_NR5GC_MTSpeechCall();

    // @siclog "Steps 44-45" siclog@
    // Generic test procedure for IMS MT call release in 5GS described in TS 38.508-1 [4] subclause 4.9.18 takes place.
    // Void
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.1.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_1_NR5GC_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_2);
    f_IMS_EmergencyRegistration();

    // @siclog "Steps 22-26" siclog@
    // Steps 22-26 of Table 4.9.29.2.2-1 of the test procedure in TS 38.508-1 [4] are performed.
    f_IMS_NR5GC_ECall(MANUAL);

    // @siclog "Steps 27-28" siclog@
    // Release eCall over IMS using the generic procedure described in  TS 38.508-1 [4] subclause 4.9.12B.
    // Void
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_EmergencyCallReleaseMT(v_ContactUrlUE); // @sic R5-250313 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));

  } // End of f_TC_11_5_1_IRAT_IMS2()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.2.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_2_NR5GC_IMS1() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_1);
    //EXCEPTION: In parallel to the events described in steps 32 to 34 below steps 2 - 3 of eCall Setup and MSD Update / 5GS as defined in TS 34.229-5 [41] annex A.23 take place
    // @siclog "Steps 32-34" siclog@
    // Steps 11 to 13b3 of Table 4.9.15.2.2-1 of the test procedure in TS 38.508-1 [4] are performed.
    f_IMS_ECallOnly_TestCall(msdUpdateNotRequired);  // @sic R5-251275 sic@
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));// @sic R5s250392 sic@

    // @siclog "Steps 39-51" siclog@
    // Steps 1 to 13 of the generic test procedure for IMS MT speech call establishment in 5GC specified in TS 38.508-1 [4] subclause 4.9.16 are performed.
    f_IMS_NR5GC_MTSpeechCall();

    // @siclog "Steps 52-53" siclog@
    // Generic test procedure for MT release of Voice call in 5GS described in TS 34.229-5 [41] subclause A.8 TS 38.508-1 [4] subclause 4.9.18 takes place.
    // Void
    f_IMS_IPCAN_WaitForTrigger(IPCAN);
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));

    f_IMS_IpcanReleaseWithOptionalDeregistration();
  } // End of f_TC_11_5_2_IRAT_IMS1()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_3_NR5GC_IMS1() runs on IMS_PTC // @sic R5s240629 sic@
  {
    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration(OtherIPCAN_E);

    //Coord message when call is hanged
    f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN();
  } // End of f_TC_11_5_3_NR5GC_IMS1()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.3.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_3_NR5GC_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_2);
    
    // @siclog "Steps 6-24" siclog@
    //Steps 7 to 25 of Generic Test Procedure for eCall over IMS establishment in EUTRA: eCall Only Support specified in TS 36.508 subclause 4.5A.27 take place.
    f_IMS_EmergencyRegistration(-,-,OtherIPCAN_E); // @sic R5s240629 sic@
    f_ECall_CallSetup_AnnexC47(AUTOMATIC);         // @sic R5s240629 sic@
    
    // @siclog "Step 25" siclog@
    // Release eCall over IMS using the generic procedure described in TS 34.229-1 [35] subclause C.33.
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent")); // @sic R5s240629 sic@
  } // End of f_TC_11_5_3_NR5GC_IMS2()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_4_NR5GC_IMS1() runs on IMS_PTC
  {// @sic R5s250225 sic@
    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration(OtherIPCAN_E);

    f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN();
  } // End of f_TC_11_5_4_IRAT_IMS1()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.4.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_4_NR5GC_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;

    f_IMS_PTC_Init(PDN_2);
    
    // @siclog "Steps 8-26" siclog@
    //Steps 7 to 25 of Generic Test Procedure for eCall over IMS establishment in EUTRA: eCall Only Support specified in TS 36.508 subclause 4.5A.27 take place.
    f_IMS_EmergencyRegistration(-, -, OtherIPCAN_E);  // @sic R5s250225 sic@
    f_ECall_CallSetup_AnnexC47(AUTOMATIC);            // @sic R5s250225 sic@
    
    // @siclog "Step 27" siclog@
    // Release eCall over IMS using the generic procedure described in TS 34.229-1 [35] subclause C.33.
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));  // @sic R5s250225 sic@
  } // End of f_TC_11_5_4_IRAT_IMS2()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.12.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_12_NR5GC_IMS1() runs on IMS_PTC
  {// @sic R5s240599 sic@
    f_IMS_PTC_Init(PDN_1);
    f_IMS_Registration(OtherIPCAN_E);

    //Coord message when call is hanged
    f_IMS_IpcanReleaseWithOptionalDeregistrationOtherIPCAN();
  } // End of f_TC_11_5_12_IRAT_IMS1()

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.5.12.NR5GC
   * @status    APPROVED (NR5GC_IRAT)
   */
  function f_TC_11_5_12_NR5GC_IMS2() runs on IMS_PTC
  {
    var SipUrl v_ContactUrlUE;
    f_IMS_PTC_Init(PDN_2);

    f_IMS_EmergencyRegistration(-, -, OtherIPCAN_E); // @sic R5s240599 sic@
    f_ECall_CallSetup_AnnexC47(AUTOMATIC);

    // @siclog "Step 24" siclog@
    // Release eCall over IMS using the generic procedure described in TS 34.229-1 subclause C.33
    v_ContactUrlUE := f_IMS_PTC_ImsInfo_GetContactUrlUE(dialog);
    f_IMS_CallReleaseMT(v_ContactUrlUE);
    f_IMS_IPCAN_SendCoOrdMsg(OtherIPCAN,cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent")); // @sic R5s240599 sic@
  }

}
