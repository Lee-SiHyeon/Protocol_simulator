module MAC_BWP_ENDC_EUTRA {

  import from EUTRA38_CommonProcedures all;
  import from EUTRA38_ENDC_CommonProcedures all;
  import from EUTRA_Component all;
  import from EUTRA_Component_5GS all;
  import from EUTRA_ConfigurationSteps all;
  import from EUTRA_NR_CoordMsg all;

  /*
   * @desc      REFERENCE TS 38.523-1 clause 7.1.1.8.1.ENDC
   * @status    APPROVED (ENDC)
   */
   function f_TC_7_1_1_8_1_ENDC_EUTRA() runs on EUTRA_5GS_PTC
  {
   /* Bandwidth Part (BWP) operation UL/DL */
    var template (omit) octetstring v_NR_SCGConfig := omit;

    f_EUTRA38_Init(EN_DC, c1);
    f_EUTRA_CellConfig_Def(eutra_Cell1);                                        // Create and configure cell
    f_EUTRA38_ENDC_Preamble(eutra_Cell1, TESTModeA_ON, MCG_Only, RRC_IDLE);     // Preamble to enter UE in state 2A
    f_EUTRA38_ENDC_ConfigAM_UM(eutra_Cell1, 1, 0, TEST_LOOPModeA_ON);           // one AM bearer
    f_EUTRA_NR_SendCoOrd(NR, cms_EUTRA_NR_Trigger("Start TestBody"));

    f_EUTRA_TestBody_Set(true);
    //@sic R5-227417 sic@
    v_NR_SCGConfig := f_EUTRA_NR_WaitForCoOrd_Data(NR, "Reconfig");

    f_EUTRA38_508_ENDC_SendReconfiguration(eutra_Cell1, -, -,v_NR_SCGConfig);
    // Test body now finished
    f_EUTRA_NR_WaitForCoOrd_Trigger(NR);
    f_EUTRA_TestBody_Set(false);

    //@sic R5s230130 sic@
    //f_EUTRA_OpenUE_TestLoopMode_Deactivate_TestMode (eutra_Cell1);
    f_EUTRA38_ENDC_Postamble(eutra_Cell1, E2_CONNECTED);
    f_EUTRA_NR_SendCoOrd (NR, cms_EUTRA_NR_Trigger("Postamble"));
  }

}
