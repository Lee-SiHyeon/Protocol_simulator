        cs_CCE_StartIndex_DL_UL( 0, 0),        // subframe 8
        cs_CCE_StartIndex_DL_UL( 8, 0)         // subframe 9
      }
    },
    {
      RNTI := tsc_C_RNTI_Def3,    // 4369 ('1111'H)
      CCE_StartIndexList := {
        cs_CCE_StartIndex_DL_UL(24, 0),       // subframe 0
        cs_CCE_StartIndex_DL_UL( 0,8),       // subframe 1
        cs_CCE_StartIndex_DL_UL( 0, 0),       // subframe 2
        cs_CCE_StartIndex_DL_UL( 0, 0),       // subframe 3
        cs_CCE_StartIndex_DL_UL(24, 0),       // subframe 4
