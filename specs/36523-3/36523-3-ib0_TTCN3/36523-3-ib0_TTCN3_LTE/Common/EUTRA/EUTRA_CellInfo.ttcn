  /*
   * @desc      Assign the parameterised ac_BarringPerPLMN_List_r12
   * @param     p_CellId
   * @param     p_PlnmId
   * @param     p_BarringForMMTEL_Voice (default value: omit)
   * @param     p_BarringForMMTEL_Video (default value: omit)
   * @param     p_BarringForMO_Signalling (default value: omit)
   * @param     p_BarringForMO_Data (default value: omit)
   * @param     p_BarringForCSFB    (default value: omit)
   * @param     p_SkipForVoice      (default value: omit)
   * @param     p_SkipForVideo      (default value: omit)
   * @param     p_SkipForSMS        (default value: omit)
   * @param     p_SkipForBarring    (default value: false)
   * @status    APPROVED (LTE, LTE_A_R12)
   */
  function f_EUTRA_CellInfo_SetSIB2_AC_BarringPerPlmnList_r12(EUTRA_CellId_Type p_CellId,
                                                              integer p_PlnmId,
                                                              template (omit) AC_BarringConfig p_BarringForMMTEL_Voice:= omit,
                                                              template (omit) AC_BarringConfig p_BarringForMMTEL_Video:= omit,
                                                              template (omit) AC_BarringConfig p_BarringForMO_Signalling:= omit,
                                                              template (omit) AC_BarringConfig p_BarringForMO_Data:= omit,
                                                              template (omit) AC_BarringConfig p_BarringForCSFB := omit,
                                                              template (omit) AC_BarringPerPLMN_r12.ac_BarringSkipForMMTELVoice_r12 p_SkipForVoice := omit,
                                                              template (omit) AC_BarringPerPLMN_r12.ac_BarringSkipForMMTELVideo_r12 p_SkipForVideo := omit,
                                                              template (omit) AC_BarringPerPLMN_r12.ac_BarringSkipForSMS_r12 p_SkipForSMS := omit,
                                                              boolean p_SkipForBarring := false
                                                            ) runs on EUTRA_PTC
  {
    var template (value) EUTRA_CellInfo_Type v_CellInfo := f_EUTRA_CellInfo_Get(p_CellId);
    
    if (not p_SkipForBarring) {
     v_CellInfo.Sysinfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.ac_BarringPerPLMN_List_r12 :=
     {  cs_AC_BarringPerPLMN_r12(p_PlnmId,
                                 cs_AC_BarringPerPLMN_r12_AC_BarringInfo_r12(p_SkipForBarring,
                                                                             p_BarringForMO_Signalling,
                                                                             p_BarringForMO_Data),
                                 p_BarringForMMTEL_Voice,
                                 p_BarringForMMTEL_Video,
                                 p_BarringForCSFB
                                 )};
    } else {
      v_CellInfo.Sysinfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.ac_BarringPerPLMN_List_r12  :=
      { cs_AC_BarringPerPLMN_r12_Def (p_PlnmId)}; // @sic R5s250052 sic@
    }
    // @sic R5s250102 sic@
    v_CellInfo.Sysinfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.ac_BarringPerPLMN_List_r12[0].ac_BarringSkipForMMTELVoice_r12:= p_SkipForVoice;
    v_CellInfo.Sysinfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.ac_BarringPerPLMN_List_r12[0].ac_BarringSkipForMMTELVideo_r12:= p_SkipForVideo;
    v_CellInfo.Sysinfo.BCCH_Info.SIs[0].message_.c1.systemInformation.criticalExtensions.systemInformation_r8.sib_TypeAndInfo[0].sib2.ac_BarringPerPLMN_List_r12[0].ac_BarringSkipForSMS_r12:= p_SkipForSMS;

    f_EUTRA_CellInfo_Set(p_CellId, v_CellInfo);
    f_EUTRA_SetSIs_ValueTag(p_CellId);
  }

