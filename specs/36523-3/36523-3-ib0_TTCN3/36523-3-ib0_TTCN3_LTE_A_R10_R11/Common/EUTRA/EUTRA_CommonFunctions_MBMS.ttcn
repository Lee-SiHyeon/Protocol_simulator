  function f_EUTRA_CellInfo_GetMCCH_NotificationIndicator(EUTRA_CellId_Type p_CellId) runs on EUTRA_PTC return NotificationIndicator_r9_Type
  {
    var SystemInformationBlockType13_r9 v_Sib13 := f_EUTRA_CellInfo_GetSib13(p_CellId);
