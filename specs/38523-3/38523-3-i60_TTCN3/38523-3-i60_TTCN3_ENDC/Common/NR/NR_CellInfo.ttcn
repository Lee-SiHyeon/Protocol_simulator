  /*
   * @desc      Return MAC_CellGroupConfig stored in the cell array
   * @param     p_NR_CellId
   * @return    MAC_CellGroupConfig
   * @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS)
   */
  function f_NR_CellInfo_GetMAC_CellGroupConfig(NR_CellId_Type p_NR_CellId) runs on NR_BASE_PTC return MAC_CellGroupConfig
  {
    var NR_CellInfo_Type v_NR_CellInfo := f_NR_CellInfo_Get(p_NR_CellId);
    var MAC_CellGroupConfig v_MAC_CellGroupConfig;

    if (ischosen(v_NR_CellInfo.ServingCellConfig.SpCell)) {
      v_MAC_CellGroupConfig := v_NR_CellInfo.ServingCellConfig.SpCell.CellGroupConfig.MAC_CellGroupConfig.R15;
    }
    if (not isbound(v_MAC_CellGroupConfig)) {
      FatalError(__FILE__, __LINE__, "No MAC_CellGroupConfig not found");
    }
    return v_MAC_CellGroupConfig;
  }

