  template (value) SystemInformationBlockType1_v890_IEs cs_SystemInformationBlockType1_v890_IEs(template (omit) CellSelectionInfo_v920 p_CellSelectionInfo := omit,
                                                                                                template (omit) SIB1_Category0Allowed_Type p_Category0Allowed := true_) :=
  { /* @status    APPROVED (LTE, LTE_A_IRAT, LTE_A_R12, LTE_IRAT) */
