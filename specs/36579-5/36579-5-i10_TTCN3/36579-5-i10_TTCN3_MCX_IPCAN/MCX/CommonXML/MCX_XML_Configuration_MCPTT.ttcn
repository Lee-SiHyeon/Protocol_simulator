    choice := {
      ellipsoidArcArea_list := {
        cs_MCPTT_UserProfile_EllipsoidArc(p_LatitudeDegrees, p_LongitudeDegrees)
      }
    }
  };

  template (value) urn_3gpp_mcptt_user_profile_1_0.GeographicalAreaChangeType cs_MCPTT_UserProfile_GeographicalAreaChange(template (value) GeographicalAreaType p_EnterSpecificArea,
