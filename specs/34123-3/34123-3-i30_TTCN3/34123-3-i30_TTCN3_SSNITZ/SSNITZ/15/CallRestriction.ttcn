module CallRestriction {

  import from LCS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from TCAP_Definitions_Para language "ASN.1:2002" all with {encode "DIRECT_EncRule"};
  import from SS_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from Common_Definitions_Arguments language "ASN.1:2002" all with {encode "BER_EncRule"};
  import from UTRAN_RRC_ASN1_Definitions language "ASN.1:2002" all with {encode "PER_Unaligned"};
  import from UTRAN_ASP_Definitions language "ASN.1:2002" all;
  import from ComponentsType all;
  import from NAS_24008Templates_IRAT all;
  import from NAS_CommonTypeDefs all;
  import from SS_CommonFunctions all;
  import from SS_CommonTemplates all;
  import from SS_EncDecComponents all;
  import from UTRAN34_CellInfo all;
  import from UTRAN34_CommonFunctions all;
  import from UTRAN34_ConfigurationSteps all;
  import from UTRAN34_Parameters all;
  import from UTRAN34_RRC_CommonFunctions all;
  import from UTRAN_CellInfo all;
  import from UTRAN_CommonDefs all;
  import from UTRAN_CommonFunctions all;
  import from UTRAN_Component all;
  import from UTRAN_ConfigurationSteps all;
  import from UTRAN_NAS_PDU_Templates all;
  import from UTRAN_SS_CommonTemplates all;
  import from UTRAN_TTCN_ASP_Templates all;
  import from UTRAN_TypeDefs all;
  import from UpperTesterFunctions all;

  template (value) Invoke cs_InvokeGetPassword(InvokeIdType p_InvokeId := tsc_InvokeId,
                                               InvokeIdType p_LinkedId,
                                               GuidanceInfo p_GuidanceInfo) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeId,
    linkedID := p_LinkedId,
    operationCode :=  { local := tsc_OperationCode_GetPassword  },
    parameter := {
      getPassword := p_GuidanceInfo
    }
  };

  template (present) ReturnResult cr_ResultGetPassword(InvokeIdType p_InvokeID,
                                                               template (present) Password p_Password := ?) :=
  { /* @status    APPROVED (SSNITZ) */
    invokeID := p_InvokeID,
    result := {
      operationCode := {
        local := tsc_OperationCode_GetPassword
      },
      parameter := {
        getPassword := p_Password
      }
    }
  };

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.1
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_1_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Registration accepted */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var Components v_FacilityResult_Password;
    var Components v_FacilityResult_NewPassword;
    var Components v_FacilityResult_NewPasswordAgain;
    var octetstring v_FacilityReturn;
    var octetstring v_FacilityPassword;
    var octetstring v_FacilityNewPassword;
    var octetstring v_FacilityNewPasswordAgain;
    var InvokeIdType v_InvokeID_Password;
    var InvokeIdType v_InvokeID_NewPassword;
    var InvokeIdType v_InvokeID_NewPasswordAgain;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    // The UE is in registered idle state on cell 1
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate the registration of new password for all barring supplementary services.
    // The old password, new password, and new password again, are requested.
    f_UT_SS_ChangePassword(UT,
                           SS_ALL_BARRING_AB,
                           tsc_SS_Password, //Old PWD
                           tsc_SS_NewPassword);
    
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER
    v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                    cr_RegisterPassword(?, tsc_SS_Code_AllBarringSS),
                                                    "Step 2",
                                                    "Step 4",
                                                    true);
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
    // @siclog "Step 5" siclog@
    // FACILITY - Invoke = GetPassword (password)
    v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID +1;
    
    v_FacilityPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                      v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                      enterPW))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityPassword))));
    
    // @siclog "Step 6" siclog@
    // FACILITY - Return result = GetPassword (<password>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6: Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    }
    
    // @siclog "Step 7" siclog@
    // FACILITY - Invoke = GetPassword (new password)
    v_InvokeID_NewPassword := v_InvokeID_Password + 1;
    
    v_FacilityNewPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_NewPassword,
                                                                                                         v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         enterNewPW))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityNewPassword))));
    
    // @siclog "Step 8" siclog@
    // FACILITY - Return result = GetPassword (<new password>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityResult_NewPassword := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityResult_NewPassword, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_NewPassword))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8: Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    }
    
    // @siclog "Step 9" siclog@
    // FACILITY - Invoke = GetPassword (new password again)
    v_InvokeID_NewPasswordAgain := v_InvokeID_NewPassword +1;
    
    v_FacilityNewPasswordAgain := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_NewPasswordAgain,
                                                                                                              v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                              enterNewPW_Again))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityNewPasswordAgain))));
    // @siclog "Step 10" siclog@
    // FACILITY - Return result = GetPassword (<new password again>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityResult_NewPasswordAgain := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityResult_NewPasswordAgain, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_NewPasswordAgain))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10: Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    }
    
    // Assign invokeID in the ReturnResult with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultRegisterPassword(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                            tsc_SS_Password))));
    // @siclog "Step 11" siclog@
    // SS sends RELEASE COMPLETE with RegisterPassword operation Return_result
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));

    // @siclog "Step 12 - Void" siclog@
    // @sic R5-153700 sic@
    
    // @siclog "Step 13" siclog@
    // The RRC connection is released by the SS
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);

    // @siclog "Step 14" siclog@
    // @sic R5-153700 sic@
    // Provide an indication for successful password registration for all barring services
    if (f_UT_ChkSuppServiceUserIndication(UT,"SS_ALL_BARRING_AB", "Successful password registration for all barring services.")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 14");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 14");
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  } // end of f_TC_15_8_1_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.2
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_2_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Rejection after invoke of the operation "register password" with subscription violation */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var octetstring v_FacilityReturn;
    var TI v_TI_R_CC; // @sic R5s160838 sic@
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;

    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); //Establishment of an outgoing call TS34.123, Table 10.1.2/3
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate a registration of a new password for all call barring services.
    // The old, new password, and new password again, are provided.
    f_UT_SS_ChangePassword(UT,
                           SS_ALL_BARRING_AB,
                           tsc_SS_Password, //Old PWD
                           tsc_SS_NewPassword);
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER
    v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_RegisterPassword(?, tsc_SS_Code_AllBarringSS),
                                                              "Step 2",
                                                              "Step 4");
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R_SS := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B); // @sic R5s160838 sic@
    v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);
    
    // Assign invokeID in the ReturnError with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvokeBarring[0].invoke.invokeID, tsc_ErrorCode_SS_SubscriptionViolation))));
    
    // @siclog "Step 5" siclog@
    // SS sends RELEASE COMPLETE with Return error component with SS_SubscriptionViolation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn)))); // @sic R5s160838 sic@
    
    // @siclog "Step 6" siclog@
    // Provide user indication
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_ALL_BARRING_AB", "Password registration failure due to subscription violation ")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
    
    // @siclog "Step 7-8" siclog@
    f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", -, tsc_CallState_U10); // @sic R5s160838 sic@
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC); // @sic R5s160838 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  } // end of f_TC_15_8_2_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.3
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_3_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Rejection after password check with negative result */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var Components v_FacilityResult_Password;
    var octetstring v_FacilityReturn;
    var octetstring v_FacilityPassword;
    var RRC_DATA_IND v_RRC_DataInd;
    var InvokeIdType v_InvokeID_Password;
    var TI v_TI_R_CC; // @sic R5s160838 sic@
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;

    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is brought into the CC state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); // @sic R5s160838 sic@
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate a registration of a new password for all call barring services
    // The old, new password, and new password again, are provided
    f_UT_SS_ChangePassword(UT,
                           SS_ALL_BARRING_AB,
                           tsc_SS_Password, //Old PWD
                           tsc_SS_NewPassword);
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER
    v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_RegisterPassword(?, tsc_SS_Code_AllBarringSS),
                                                              "Step 2",
                                                              "Step 4");
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R_SS := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B);  // @sic R5s160838 sic@
    v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);

    
    // @siclog "Step 5" siclog@
    // FACILITY - Invoke = GetPassword (password)
    v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID + 1;
    
    v_FacilityPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                      v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                      enterPW))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S_SS, cs_FacilityIE_lv(v_FacilityPassword)))); // @sic R5s160838 sic@
    
    // @siclog "Step 6" siclog@
    // FACILITY - Return result = GetPassword (<password>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R_SS, cr_FacilityIE_lv))) -> value v_RRC_DataInd; // @sic R5s160838 sic@
    v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password,tsc_SS_Password))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6: Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    }
    
    // Assign invokeID in the ReturnError with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvokeBarring[0].invoke.invokeID, tsc_ErrorCode_NegativePW_Check))));
    
    // @siclog "Step 7" siclog@
    // SS sends RELEASE COMPLETE with Return error component with NegativePasswordCheck
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn)))); // @sic R5s160838 sic@
    
    // @siclog "Step 8" siclog@
    // Provide user indication
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_ALL_BARRING_AB", "Password registration failure due to wrong password")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
    }
    
    // @siclog "Step 9-10" siclog@
    f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 10", -, tsc_CallState_U10); // @sic R5s160838 sic@
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC); // @sic R5s160838 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  } // end of f_TC_15_8_3_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.4
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_4_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Activation accepted */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var Components v_FacilityResult_Password;
    var octetstring v_FacilityReturn;
    var octetstring v_FacilityPassword;
    var InvokeIdType v_InvokeID_Password;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    // The UE is in registered idle state on cell 1
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    //==========================================================================================================
    // BAOC
    //==========================================================================================================
    if (pc_SS_BAOC) {  //@sic R5-145641 sic@
        // UE supports BAOC supplementary service
        // @siclog "Step 1" siclog@
        // The UE is made to initiate the activation of the BAOC (barring of outgoing calls) supplementary service
        f_UT_SupplementaryService_CallBarring(UT,
                                          ACTIVATE_MODE,
                                          SS_BAOC,
                                          tsc_SS_Password);
        // @siclog "Steps 2-4" siclog@
        // CM SERVICE REQUEST- CM SERVICE ACCEPT - REGISTER
        v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                    cr_InvokeActivate(?, cr_SS_ForBS_Code(tsc_SS_Code_BAOC, *)),
                                                    "Step 2",
                                                    "Step 4",
                                                    true);
        v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
        v_TI_R := v_ReceiveRegisterResult.ti;
    
        // Set TI value for response to be sent from the SS
        v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
        // @siclog "Step 5" siclog@
        // FACILITY - Invoke = GetPassword (GuidanceInfo = enterPW). The password for the relevant supplementary service (BAOC or BICRoam) is requested.
        v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID + 1;
    
        v_FacilityPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                      v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                      enterPW))));
        U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityPassword))));
        // @siclog "Step 6" siclog@
        // FACILITY - Return result = GetPassword (<password>)
        U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
        v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
        if (not match(v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password))))) {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Facility message does not match to template");
        } else {
        f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
        }
    
        // Assign invokeID in the ReturnResult with the value received in the Invoke
        // If present in the Invoke component, BasicService is set to the same value in the return result
        if (ispresent(v_FacilityInvokeBarring[0].invoke.parameter.activateSS.basicService)) {
        v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         cs_SS_InfoBarring(tsc_SS_Code_BAOC,
                                                                                                                           v_FacilityInvokeBarring[0].invoke.parameter.activateSS.basicService,
                                                                                                                           tsc_SS_StatusPRA)))));
        } else {
        // If omitted in the Invoke component, BasicService is omitted in the return result
        v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         cs_SS_InfoBarring(tsc_SS_Code_BAOC,
                                                                                                                           -,
                                                                                                                           tsc_SS_StatusPRA)))));
        }
    
        // @siclog "Step 7" siclog@
        // SS sends RELEASE COMPLETE with ActivateSS operation Return_result
        U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
    
        // @siclog "Step 8" siclog@
        // void @sic R5-153701 sic@
    
        // @siclog "Step 9" siclog@
        // The RRC connection is released by the SS
        f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);

        // @siclog "Step 9a" siclog@
        // The UE provides an indication of successful activation of the relevant supplementary service BAOC @sic R5-153701 sic@
        if (f_UT_ChkSuppServiceUserIndication(UT, "BAOC", "Successful activation of the supplementary service BAOC")) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
        } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
        }
    }
    
    if (pc_SS_BIC_Roam) {  //@sic R5-145641 sic@
        //UE supports BICRoam supplementary service
        //==========================================================================================================
        // BIC ROAM
        //==========================================================================================================
        // Repeat steps 2 - 8
        // @siclog "Step 10" siclog@
        // The UE is made to initiate the activation of the BICRoam (barring of incoming calls when roaming outside home PLMN Country) supplementary service
        f_UT_SupplementaryService_CallBarring(UT,
                                          ACTIVATE_MODE,
                                          SS_BIC_ROAM,
                                          tsc_SS_Password);
        // @siclog "Steps 11-13" siclog@
        // CM SERVICE REQUEST- CM SERVICE ACCEPT - REGISTER
        v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                        cr_InvokeActivate(?, cr_SS_ForBS_Code(tsc_SS_Code_BIC_ROAM, *)),
                                                        "Step 11",
                                                        "Step 13",
                                                        true);
        v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
        v_TI_R := v_ReceiveRegisterResult.ti;
        
        // Set TI value for response to be sent from the SS
        v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
        // @siclog "Step 14" siclog@
        // FACILITY - Invoke = GetPassword (GuidanceInfo = enterPW). The password for the relevant supplementary service (BAOC or BICRoam) is requested.
        v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID + 1;
    
        v_FacilityPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                      v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                      enterPW))));
        U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityPassword))));
        // @siclog "Step 15" siclog@
        // FACILITY - Return result = GetPassword (<password>)
        U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
        v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
        if (not match(v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password))))) {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Facility message does not match to template");
        } else {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
        }
    
        // Assign invokeID in the ReturnResult with the value received in the Invoke
        // If present in the Invoke component, BasicService is set to the same value in the return result
        if (ispresent(v_FacilityInvokeBarring[0].invoke.parameter.activateSS.basicService)) {
            v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         cs_SS_InfoBarring(tsc_SS_Code_BIC_ROAM,
                                                                                                                           v_FacilityInvokeBarring[0].invoke.parameter.activateSS.basicService,
                                                                                                                           tsc_SS_StatusPRA)))));
        } else {
            // If omitted in the Invoke component, BasicService is omitted in the return result
            v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultActivate(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         cs_SS_InfoBarring(tsc_SS_Code_BIC_ROAM,
                                                                                                                           -,
                                                                                                                           tsc_SS_StatusPRA)))));
        }
    
        // @siclog "Step 16" siclog@
        // SS sends RELEASE COMPLETE with ActivateSS operation Return_result
        U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
    
        // @siclog "Step 17" siclog@
        //void @sic R5-153701 sic@

        // @siclog "Step 18" siclog@
        f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);

        // @siclog "Step 18a" siclog@
        // The UE provides an indication of successful activation of the relevant supplementary service BIC ROAM @sic R5-153701 sic@
        if (f_UT_ChkSuppServiceUserIndication(UT, "BIC ROAM", "Successful activation of the supplementary service BIC ROAM")) {
            f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 17");
        } else {
            f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 17");
        }
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  }

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.5
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_5_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Rejection after invoke of ActivateSS operation */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var octetstring v_FacilityReturn;
    // @sic R5s160149 sic@ Introduced additional variables to consider the possibility that the UE may use different TI values for call related and non call related supplementary services
    var TI v_TI_R_CC;
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;

    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);

    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); // @sic R5s160149 sic@
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate an activation of BOIC (Barring of outgoing international calls) supplementary service
    f_UT_SupplementaryService_CallBarring(UT, //@sic R5s150893 sic@
                                          ACTIVATE_MODE,
                                          SS_BOIC);
    
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER //@sic R5s141087 R5-153702 sic@
    v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeActivate(?, cr_SS_ForBS_Code(tsc_SS_Code_BOIC, *)),
                                                              "Step 2",
                                                              "Step 4");
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R_SS := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B); // @sic R5s160149 sic@
    v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B); // @sic R5s160149 sic@

    
    // Assign invokeID in the ReturnError with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvokeBarring[0].invoke.invokeID, tsc_ErrorCode_SS_SubscriptionViolation))));
    
    // @siclog "Step 5" siclog@
    // SS sends RELEASE COMPLETE with Return error component with SS_SubscriptionViolation
    U_Dc.send (cas_DataReq_CS (utran_CellDedicated,
                               tsc_RB3,
                               cs_U_ReleaseCompleteFacility (v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn)))); // @sic R5s160149 sic@
    // @siclog "Step 6" siclog@
    // The UE provides an appropriate user indication about failure of the supplementary service activation
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_BOIC", "Password registration failure due to subscription violation")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
    
    // @siclog "Step 7-8" siclog@
    f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", -, tsc_CallState_U10); // @sic R5s160149 sic@
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC); // @sic R5s160149 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType (utran34_Cell1));
  } // end of f_TC_15_8_5_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.6
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_6_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Deactivation accepted */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var Components v_FacilityResult_Password;
    var octetstring v_FacilityReturn;
    var octetstring v_FacilityPassword;
    var InvokeIdType v_InvokeID_Password;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R := f_NAS_TI_Init(cs_TI_MT);
    var TI v_TI_S;
    var template (omit) BasicServiceGroupList v_BasicServiceGroupList := omit; // @sic R5s210264 sic@
    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    // The UE is in registered idle state on cell 1
    f_UTRAN34_Preamble(utran34_Cell1);
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate the deactivation of all supplementary services restriction, for speech
    f_UT_SupplementaryService_CallBarring(UT,
                                          DEACTIVATE_MODE,
                                          SS_ALL_BARRING_AB,
                                          tsc_SS_Password,
                                          SS_SPEECH);
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER
    v_ReceiveRegisterResult := f_SS_ReceiveRegister(utran34_Cell1,
                                                    cr_InvokeDeactivate(?, cr_SS_ForBS_Code(tsc_SS_Code_AllBarringSS, (cr_Teleservice_AllSpeech, cr_Teleservice_TS11))), // @sic R5-145077 sic@
                                                    "Step 2",
                                                    "Step 4",
                                                    true);
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
    
    // @siclog "Step 5" siclog@
    // FACILITY - Invoke = GetPassword (GuidanceInfo = enterPW).
    // The password for the relevant supplementary service (all supplementary services, or outgoing calls, respectively) is requested
    v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID + 1;
    
    v_FacilityPassword := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                      v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                      enterPW))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility(v_TI_S, cs_FacilityIE_lv(v_FacilityPassword))));
    
    // @siclog "Step 6" siclog@
    // FACILITY - Return result = GetPassword (<password>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility(v_TI_R, cr_FacilityIE_lv))) -> value v_RRC_DataInd;
    v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match(v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    }
    
    if ( ispresent(v_FacilityInvokeBarring[0].invoke.parameter.deactivateSS.basicService)) // @sic R5s210264 sic@
    {
        v_BasicServiceGroupList := { v_FacilityInvokeBarring[0].invoke.parameter.deactivateSS.basicService};
    }
    
    // Assign invokeID in the ReturnResult with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnResult(cs_ReturnResultDeactivate(v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                         cs_SS_Data(tsc_SS_Code_AllBarringSS, v_BasicServiceGroupList))))); // @sic R5s210264 R5-145077 sic@
    
    // @siclog "Step 7" siclog@
    // SS sends RELEASE COMPLETE with ActivateSS operation Return_result
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S, cs_FacilityIE_tlv(v_FacilityReturn))));
    
    // @siclog "Step 8 - Void" siclog@
    //@sic R5-153703 sic@
    
    // @siclog "Step 9" siclog@
    // The RRC connection is released by the SS
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    // @siclog "Step 10" siclog@
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_ALL_BARRING_AB", "Successful deactivation of all supplementary services restriction for speech")) { //@sic R5-153703 sic@
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 10");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 10");
    }
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  } // end of f_TC_15_8_6_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.7
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_7_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Rejection after invoke of DeactivateSS operation */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var octetstring v_FacilityReturn;
    var TI v_TI_R_CC;  // @sic R5s160838 sic@
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;

    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH (utran34_Cell1);
    f_UTRAN34_SendDefSysInfo (utran34_Cell1);

    f_UTRAN34_Preamble (utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO( utran34_Cell1, true); //Establishment of an outgoing call TS34.123, Table 10.1.2/3
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate a deactivation for BAIC (barring of all  incoming calls)
    f_UT_SupplementaryService_CallBarring(UT,
                                          DEACTIVATE_MODE,
                                          SS_BAIC,
                                          tsc_SS_Password);
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER  //@sic R5s141091 sic@
    v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeDeactivate(?, cr_SS_ForBS_Code(tsc_SS_Code_BAIC, *)),
                                                              "Step 2",
                                                              "Step 4");
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R_SS := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B); // @sic R5s160838 sic@
    v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);

    
    // Assign invokeID in the ReturnError with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvokeBarring[0].invoke.invokeID, tsc_ErrorCode_SS_SubscriptionViolation))));
                                  
    // @siclog "Step 5" siclog@
    // SS sends RELEASE COMPLETE with Return error component with SS_SubscriptionViolation
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility (v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn)))); // @sic R5s160838 sic@
    // @siclog "Step 6" siclog@
    // The UE provides an appropriate user indication about failure of the supplementary service activation
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_BAIC", "Password registration failure due to subscription violation")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 6");
    }
    
    // @siclog "Step 7-8" siclog@
    f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 8", -, tsc_CallState_U10); // @sic R5s160838 sic@
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC); // @sic R5s160838 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType (utran34_Cell1));
  } // end of f_TC_15_8_7_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.8
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_8_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Rejection after use of password procedure */
    var SS_ReceiveRegisterResult_Type v_ReceiveRegisterResult;
    var Components v_FacilityInvokeBarring;
    var Components v_FacilityResult_Password;
    var octetstring v_FacilityReturn;
    var octetstring v_FacilityPassword;
    var InvokeIdType v_InvokeID_Password;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R_CC;  // @sic R5s160838 sic@
    var TI v_TI_S_CC;
    var TI v_TI_R_SS;
    var TI v_TI_S_SS;

    
    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    f_UTRAN34_Preamble(utran34_Cell1);
    // The UE is in call state U10 by using table 10.1.2/3
    v_TI_R_CC := f_UTRAN34_GoToState6_9_MO(utran34_Cell1, true); //Establishment of an outgoing call TS34.123, Table 10.1.2/3
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate a deactivation of BoicExHC
    f_UT_SupplementaryService_CallBarring(UT,
                                          DEACTIVATE_MODE,
                                          SS_BOIC_EXHC,
                                          tsc_SS_Password);
    // @siclog "Steps 2-4" siclog@
    // CM SERVICE REQUEST - REGISTER  //@sic R5s141093 sic@
    v_ReceiveRegisterResult := f_SS_ReceiveRegister_UE_Active(cr_InvokeDeactivate(?, cr_SS_ForBS_Code(tsc_SS_Code_BOICExHC, *)),
                                                              "Step 2",
                                                              "Step 4");
    v_FacilityInvokeBarring := v_ReceiveRegisterResult.components;
    v_TI_R_SS := v_ReceiveRegisterResult.ti;
    
    // Set TI value for response to be sent from the SS
    v_TI_S_CC := f_NAS_TI_InitAndSetFlag(v_TI_R_CC, '1'B);   // @sic R5s160838 sic@
    v_TI_S_SS := f_NAS_TI_InitAndSetFlag(v_TI_R_SS, '1'B);

    
    // @siclog "Step 5" siclog@
    // FACILITY - Invoke = GetPassword (GuidanceInfo = enterPW).
    // The password for the relevant supplementary service (all supplementary services, or outgoing calls, respectively) is requested
    v_InvokeID_Password := v_FacilityInvokeBarring[0].invoke.invokeID +1;
    
    v_FacilityPassword := f_SS_EncodeComponents (cs_Components (cs_InvokeComponent(cs_InvokeGetPassword(v_InvokeID_Password,
                                                                                                        v_FacilityInvokeBarring[0].invoke.invokeID,
                                                                                                        enterPW))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_Facility (v_TI_S_SS, cs_FacilityIE_lv(v_FacilityPassword)))); // @sic R5s160838 sic@
    
    // @siclog "Step 6" siclog@
    // FACILITY - Return result = GetPassword (<password>)
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_Facility (v_TI_R_SS, cr_FacilityIE_lv))) -> value v_RRC_DataInd; // @sic R5s160838 sic@
    v_FacilityResult_Password := f_SS_ComponentsDecode(v_RRC_DataInd.msg.facilityul.facility_Str.components); // @sic R5s140989 sic@
    if (not match (v_FacilityResult_Password, cr_Components(cr_ReturnResult(cr_ResultGetPassword(v_InvokeID_Password))))) {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Facility message does not match to template");
    } else {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 6");
    }
    
    // Assign invokeID in the ReturnError with the value received in the Invoke
    v_FacilityReturn := f_SS_EncodeComponents(cs_Components(cs_ReturnError(cs_ReturnErrorCode(v_FacilityInvokeBarring[0].invoke.invokeID, tsc_ErrorCode_NegativePW_Check))));
    
    // @siclog "Step 7" siclog@
    // SS sends RELEASE COMPLETE with ActivateSS operation Return_result
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseCompleteFacility(v_TI_S_SS, cs_FacilityIE_tlv(v_FacilityReturn))));
    // @siclog "Step 8" siclog@
    // The UE provides an appropriate indication about failure of the supplementary service deactivation
    if (f_UT_ChkSuppServiceUserIndication(UT, "SS_BOIC_EXHC", "Password registration failure due to subscription violation")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
    }
    
    // @siclog "Step 9-10" siclog@
    f_UTRAN34_CheckStatus(v_TI_S_CC, v_TI_R_CC, "Step 10", -, tsc_CallState_U10); // @sic R5s160838 sic@
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN_CC_Disconnect(v_TI_S_CC); // @sic R5s160838 sic@
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U2_CONNECTED, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType (utran34_Cell1));
  }    // end of f_TC_15_8_8_UTRAN

  /*
   * @desc      REFERENCE TS 34.123-1 clause 15.8.9
   * @status    APPROVED (SSNITZ)
   */
  function f_TC_15_8_9_UTRAN() runs on UTRAN_PTC
  { /* Call restriction - Normal operation */
    var charstring v_NumberToDial := "4989364072";
    var START_Value v_START_Value := '00000000000000000000'B;
    var octetstring v_NotifySS;
    var RRC_DATA_IND v_RRC_DataInd;
    var TI v_TI_R;
    var TI v_TI_S;
    var template (present) EstablishmentCause v_EstCause := originatingConversationalCall;  // @sic R5s141095 sic@

    //Initialise all UTRAN cells according to 34.108
    f_UTRAN34_Init();
    
    f_UTRAN34_SS_CreateCellDCH(utran34_Cell1);
    f_UTRAN34_SendDefSysInfo(utran34_Cell1);
    
    // The UE is in registered idle state on cell 1
    f_UTRAN34_Preamble(utran34_Cell1);
    
    f_UTRAN_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    // The UE is made to initiate a call.
    f_UT_RequestCSCall(UT, v_NumberToDial);
    
    f_UTRAN34_RRC_ConnEst (utran34_Cell1, v_EstCause);   //  @sic R5s141095 sic@
    
    // @siclog "Step 2" siclog@
    U_Dc.receive(car_InitDirectTransfer(utran_CellDedicated,
                                        tsc_RB3,
                                        // @sic R5-145648 CM Service Type 'Mobile originating call establishment or packet mode connection establishment' sic@
                                        cr_U_CMServReq_SS_MO(?))) -> value v_RRC_DataInd;  // @sic R5s141095, R5-153983 sic@
    
    // @siclog "Step 3" siclog@
    v_START_Value := v_RRC_DataInd.ttcn_start;
    f_UTRAN_SS_SecurityDownloadStart(cs_domain, v_START_Value); // CR 142717
    
    // @siclog "Step 2A-2B" siclog@
    //@sic R5-144250 sic@
    f_UTRAN_MM_Authentication();
    
    // Security  procedure
    f_UTRAN34_RRC_Security(utran34_Cell1, true, cs_domain);  // @sic R5s141095 sic@
    //The SS starts integrity protection
    
    // @siclog "Step 4" siclog@
    U_Dc.receive(car_UplinkDirectTransfer(utran_CellDedicated,
                                          tsc_RB3,
                                          cr_U_SetupMOCall(cr_BcapSpeechMO))) -> value v_RRC_DataInd;
    v_TI_R := v_RRC_DataInd.msg.setupul.ti;
    v_TI_S := f_NAS_TI_InitAndSetFlag(v_TI_R, '1'B);
                             

    // @siclog "Step 5" siclog@
    v_NotifySS := f_SS_EncodeComponents(cs_Components(cs_InvokeComponent(cs_InvokeNotify(tsc_InvokeId,
                                                                                         '99'O, // 10011001 (barring of incoming calls)
                                                                                         tsc_SS_StatusPRA))));
    U_Dc.send(cas_DataReq_CS(utran_CellDedicated,
                             tsc_RB3,
                             cs_U_ReleaseComplete(v_TI_S, -, cs_SS_Cau(tsc_SS_CauValue_OperatorDetermindBarring), cs_FacilityIE_tlv(v_NotifySS)))); // @sic R5s150084 R5s150240 sic@
                             
    // @siclog "Step 6" siclog@
    // The UE provides indication of call not allowed due to incoming call barring active for the called party.
    if (f_UT_ChkSuppServiceUserIndication(UT, "BAOC", "Call not allowed due to incoming call barring active for the called party")) {
      f_UTRAN_PreliminaryPass(__FILE__, __LINE__, "Test case 15.8.9, Step 6");
    } else {
      f_UTRAN_SetVerdictFailOrInconc(__FILE__, __LINE__, "Test case 15.8.9, Step 6");
    }
    
    // The RRC connection is released by the SS
    f_UTRAN34_RRC_ConnRelStatus(utran34_Cell1);
    
    //Postamble
    f_UTRAN_TestBody_Set(false);
    
    f_UTRAN34_SwitchPower_Off(utran34_Cell1, U1_IDLE, NotSpecified);
    f_UTRAN_ReleaseCell(utran34_Cell1, f_UTRAN_CellInfo_GetConfigType(utran34_Cell1));
  } // f_TC_15_8_9_UTRAN

}
