    //@siclog "Step 4" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, (cr_LppProvideLocationInformation_NoError_NrEcidOnly(tsc_POS_TransactionNumber), cr_LppProvideLocationInformation_UEA_NrEcidOnly (tsc_POS_TransactionNumber)));//@sic R5-243569 sic@
    if (isvalue (v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.nr_ECID_ProvideLocationInformation_r16)) {
      if (match (v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.nr_ECID_ProvideLocationInformation_r16, cr_NR_ECID_ProvideLocationInformation(omit))) { // nr-ECID-Error-r16 := omit
            f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.2 Step 4");
          }
          else {
            f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "Wrong NR ECID Location Information");
          }
        }
        else {
          f_NR_SetVerdictFailOrInconc (__FILE__, __LINE__, "NR ECID Location Information not present");
        }

    //@siclog "Step 4a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 4
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_2_NrEcid_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.3.15s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_3_15s_NR5GC() runs on NR5GC_POS_PTC
  {//E-SMLC Initiated Position Measurement without assistance data: UE Based
    var PositioningSystemList_Type v_GNSSList := f_POS_GetListOfSupportedGNSS();

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_POS_StartPositioningSimulatorNR (v_GNSSList, 15); // Scenario for Subtest 15 according to 37.571-5, 6.1.2

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_4_3_GNSS_NR5GC_TestBody(v_GNSSList);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    f_POS_StopPositioningSimulatorNR (v_GNSSList);
  } //end of f_TC_9_3_4_3_15s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.3.GNSS
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_3_GNSS_NR5GC_TestBody (PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;
    var template (value) A_GNSS_ProvideAssistanceData v_GNSS_ProvideAssistanceData;
    var RequestAssistanceData_r9_IEs v_RequestAssistData;
    var TransactionNumber v_TransactionNumber := 0; // To store Transaction number sent by the UE in LPP Request Assistance Data

    //@siclog "Step 1" siclog@
    //Clear stored GNSS assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_AgnssUEPosTech);

    //@siclog "Steps 1a, 1b, 1c" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 2" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationEstimateRequired,
                                                                            tsc_ResponseTimeDef,
                                                                            cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId),
                                                                                                        true),
                                                                            omit,
                                                                            omit));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //Receive LPP Request Assistance Data
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppReqAssistanceDataAgnss_Ack);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.3 Step 3");

    // Get Transaction number sent by the UE
    v_TransactionNumber := v_LppMessage.transactionID.transactionNumber;

    v_RequestAssistData := v_LppMessage.lpp_MessageBody.c1.requestAssistanceData.criticalExtensions.c1.requestAssistanceData_r9;

    // Retrieve requested data from Satellite simulator and store it in v_ProvideAssistData
    v_ProvideAssistData := f_POS_RetrieveNR_DataGNSS (p_PosSystemListId);

    //@siclog "Step 4" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    v_GNSS_ProvideAssistanceData := f_POS_AgnssProvideAssistanceData_UEReq(true, // UE-Based case
                                                                           v_RequestAssistData,
                                                                           v_ProvideAssistData);
    if (isvalue(v_LppMessage.acknowledgement)) {// UE requested ack
      v_EncodedLppMessage := f_POS_EncodeLppMessage (cs_LppProvideAssistData (v_TransactionNumber,
                                                                              targetDevice,
                                                                              v_GNSS_ProvideAssistanceData,
                                                                              omit,
                                                                              cs_Acknowledgement (false, v_LppMessage.sequenceNumber)));
    }
    else {// UE did not request ack
      v_EncodedLppMessage := f_POS_EncodeLppMessage (cs_LppProvideAssistData (v_TransactionNumber,
                                                                              targetDevice,
                                                                              v_GNSS_ProvideAssistanceData,
                                                                              omit));
    }

    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 5" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideLocationInformation_Agnss_UEB(tsc_POS_TransactionNumber));

    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.3 Step 5");

    //@siclog "Step 5a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 5
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_3_GNSS_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.15s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_4_15s_NR5GC() runs on NR5GC_POS_PTC
  {//E-SMLC Initiated Position Measurement without assistance data: UE Assisted
    var PositioningSystemList_Type v_GNSSList := f_POS_GetListOfSupportedGNSS();

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_NR_CellConfig_Def(nr_Cell1);

    f_POS_StartPositioningSimulatorNR (v_GNSSList, 15); // Scenario for Subtest 15 according to 37.571-5, 6.1.2

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    f_NR_TestBody_Set(true);
    f_TC_9_3_4_4_GNSS_NR5GC_TestBody(v_GNSSList);
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
    f_POS_StopPositioningSimulatorNR (v_GNSSList);
  } //end of f_TC_9_3_4_4_15s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.GNSS
   * @param     p_PosSystemListId
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_4_GNSS_NR5GC_TestBody (PositioningSystemList_Type p_PosSystemListId) runs on NR5GC_POS_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var ProvideAssistanceData_r9_IEs v_ProvideAssistData;
    var template (value) A_GNSS_ProvideAssistanceData v_GNSS_ProvideAssistanceData;
    var RequestAssistanceData_r9_IEs v_RequestAssistData;
    var GNSS_MeasurementList v_GNSS_MeasurementList;
    var TransactionNumber v_TransactionNumber := 0; // To store Transaction number sent by the UE in LPP Request Assistance Data

    //@siclog "Step 1" siclog@
    //Clear stored GNSS assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, tsc_AgnssUEPosTech);

    //@siclog "Steps 1b, 1c, 1d" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 2" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationMeasurementsRequired, //@sic R5s201407 sic@
                                                                            tsc_ResponseTimeDef,
                                                                            cs_AgnssRequestLocationInfo(f_POS_SetGNSS_ID_Bitmap_FromGNSSlist(p_PosSystemListId),
                                                                                                        true,
                                                                                                        f_MultiFreqAGNSS()),
                                                                            omit,
                                                                            omit));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //Receive LPP Request Assistance Data
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppReqAssistanceDataAgnss_Ack);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.4 Step 3");

    // Get Transaction number sent by the UE
    v_TransactionNumber := v_LppMessage.transactionID.transactionNumber;

    v_RequestAssistData := v_LppMessage.lpp_MessageBody.c1.requestAssistanceData.criticalExtensions.c1.requestAssistanceData_r9;

    // Retrieve requested data from Satellite simulator and store it in v_ProvideAssistData
    v_ProvideAssistData := f_POS_RetrieveNR_DataGNSS (p_PosSystemListId);

    //@siclog "Step 4" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    v_GNSS_ProvideAssistanceData := f_POS_AgnssProvideAssistanceData_UEReq(false, // UE-Assisted case
                                                                           v_RequestAssistData,
                                                                           v_ProvideAssistData);
    if (isvalue(v_LppMessage.acknowledgement)) {// UE requested ack
      v_EncodedLppMessage := f_POS_EncodeLppMessage (cs_LppProvideAssistData (v_TransactionNumber,
                                                                              targetDevice,
                                                                              v_GNSS_ProvideAssistanceData,
                                                                              omit,
                                                                              cs_Acknowledgement (false, v_LppMessage.sequenceNumber)));
    }
    else {// UE did not request ack
      v_EncodedLppMessage := f_POS_EncodeLppMessage (cs_LppProvideAssistData (v_TransactionNumber,
                                                                              targetDevice,
                                                                              v_GNSS_ProvideAssistanceData,
                                                                              omit));
    }

    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 5" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, (cr_LppProvideLocationInformation_NoError_Agnss_UEA(tsc_POS_TransactionNumber), cr_LppProvideLocationInformation_Agnss_UEA (tsc_POS_TransactionNumber)));
    v_GNSS_MeasurementList := v_LppMessage.lpp_MessageBody.c1.provideLocationInformation.criticalExtensions.c1.provideLocationInformation_r9.a_gnss_ProvideLocationInformation.gnss_SignalMeasurementInformation.gnss_MeasurementList;
    f_POS_NR_CheckGnssMeasurementList(v_GNSS_MeasurementList); //@sic R5s210633 sic@
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.4 Step 5");

    //@siclog "Step 5a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 5
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_4_GNSS_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.19s
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_4_19s_NR5GC() runs on NR5GC_POS_PTC
  {//E-SMLC Initiated Position Measurement without assistance data: UE Assisted - Multi-RTT, Rel-16 onwards

    f_NR5GC_POS_Init(NR_1);

    //Create and configure cell
    f_POS_NR_CellConfig_DlPrs(nr_Cell1);

    //Preamble: The UE is in 5GS state 3N-A
    f_NR5GC_Preamble (nr_Cell1, STATE_CONNECTED_3A);

    // Table 9.3.4.4.3.1-1: Configuration of measurement gaps for DL-AoD
    f_NR_ConfigMeasGap_OTDOA();

    // Table 9.3.4.4.3.1-2: Configuration of UL-SRS for Multi-RTT
    f_NR_ConfigUlSrsMultiRTT(nr_Cell1);

    f_NR_TestBody_Set(true);
    f_TC_9_3_4_4_MultiRTT_NR5GC_TestBody();
    f_NR_TestBody_Set(false);

    // Switch/Power off UE
    f_NR_Postamble(nr_Cell1, STATE_CONNECTED_3A);
  } //end of f_TC_9_3_4_4_19s_NR5GC

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.MultiRTT
   * @status    APPROVED (POS)
   */
  function f_TC_9_3_4_4_MultiRTT_NR5GC_TestBody () runs on NR_BASE_PTC
  {
    var LPP_Message v_LppMessage;
    var octetstring v_Octetstring;
    var octetstring v_EncodedLppMessage;
    var template (value) NR_Multi_RTT_ProvideAssistanceData_r16  v_MultiRTTProvideAssistanceData;
    var template (omit) Acknowledgement v_Acknowledgement := omit;

    //@siclog "Step 1" siclog@
    //Clear stored assistance data
    f_POS_NR_ClearStoredData(nr_Cell1, f_SetClearTech(19));

    //@siclog "Steps 1b, 1c, 1d" siclog@
    f_POS_NR_CapabilityTransferProcedure();

    //@siclog "Step 2" siclog@
    //SS sends LPP REQUEST LOCATION INFORMATION
    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppRequestLocationInfo(tsc_POS_TransactionNumber,
                                                                            locationMeasurementsRequired,
                                                                            tsc_ResponseTimeDef,
                                                                            omit,
                                                                            omit,
                                                                            -,-,-,-,-,-,-,
                                                                            cs_MultiRTTRequestLocationInfoDef(true))); // nr-AssistanceAvailability-r16 := true
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 3" siclog@
    //Receive LPP Request Assistance Data
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppReqAssistanceDataMultiRtt_Ack);
    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.4 Step 3");

    //@siclog "Step 4" siclog@
    //SS sends LPP PROVIDE ASSISTANCE DATA
    if (isvalue(v_LppMessage.acknowledgement)) {//UE requested ack
      v_Acknowledgement := cs_Acknowledgement (false, v_LppMessage.sequenceNumber)
    }
    // Get default assistance data
      v_MultiRTTProvideAssistanceData := cs_MultiRTTProvideAssistanceData(f_POS_Set_DlPrsAssistanceData(1),
                                                                          {cs_NrSelectedDlPrsPerFreq(0)});
    //Now remove elements not requested by the UE
    if (v_LppMessage.lpp_MessageBody.c1.requestAssistanceData.criticalExtensions.c1.requestAssistanceData_r9.nr_Multi_RTT_RequestAssistanceData_r16.nr_AdType_r16[0] == '0'B){ //nr-DL-PRS-AssistanceData not requested
      v_MultiRTTProvideAssistanceData.nr_DL_PRS_AssistanceData_r16 := omit;
    }

    v_EncodedLppMessage := f_POS_EncodeLppMessage(cs_LppProvideAssistData(tsc_POS_TransactionNumber,
                                                                          targetDevice,
                                                                          omit,
                                                                          omit,
                                                                          v_Acknowledgement,
                                                                          -,-,-,
                                                                          v_MultiRTTProvideAssistanceData));
    f_POS_NR_SendEncodedLppMessage(v_EncodedLppMessage);

    //@siclog "Step 5" siclog@
    //Receive LPP PROVIDE LOCATION INFORMATION
    v_Octetstring := f_POS_NR_ReceiveEncodedLppMessage();
    v_LppMessage := f_POS_NR_LppMessage_DecodeAndMatch(v_Octetstring, cr_LppProvideLocationInformation_MultiRTT(tsc_POS_TransactionNumber));

    f_NR_PreliminaryPass(__FILE__, __LINE__, "Test Case 9.3.4.3 Step 5");

    //@siclog "Step 5a" siclog@
    //SS sends LPP ACKNOWLEDGEMENT if requested by the UE at step 5
    f_POS_NR_SendLppAck(nr_Cell1, tsc_POS_RoutingId, v_LppMessage);
  }// end of f_TC_9_3_4_4_MultiRTT_NR5GC_TestBody

  /*
   * @desc      REFERENCE TS 37.571-2 clause 9.3.4.4.20s
   * @status    APPROVED (POS)
