  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.2.11.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_2_11_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Chat Group Call / Join Chat Group Session / Upgrade to Emergency / Cancel Emergency / Upgrade to Imminent Peril / Cancel Imminent Peril / Client Originated (CO)
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
    
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);

    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a chat group call with automatic commencement mode and implicit floor request");
    
    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdp := f_MCPTT_CallSetupMO_100TryingOnly(CHAT_GROUP_CALL, -, -, withImplictGrantRequest);    // Table 5.3A.1.3-1 option b.ii

    // @siclog "Step 3 - 6" Void siclog@

    // @siclog "Step 7" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 7");

    // @siclog "Step 7A" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 7B" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);

    // @siclog "Step 8" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request upgrade of the call to an emergency chat group call with implicit floor request");
    
    // @siclog "Step 9" siclog@
    f_MCPTT_SessionModificationCO_Upgrade(CHAT_GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 9");
    
    // @siclog "Step 10 - 13" Void siclog@

    // @siclog "Step 14" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 14");

    // @siclog "Step 15" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 16" siclog@
    f_MCPTT_FloorReleaseIdle(EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");
     
    // @siclog "Step 17 - 18" Void siclog@

    // @siclog "Step 19" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request downgrade of the call to a normal chat group call");

    // @siclog "Step 20" siclog@
    f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCPTT, CHAT_GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 20");

    // @siclog "Step 20A" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);      // @sic R5-216728 sic@

    // @siclog "Step 21 - 24" Void siclog@

    // @siclog "Step 24A" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 24B" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 24B");

    // @siclog "Step 25" Void siclog@

    // @siclog "Step 26" siclog@
    f_UT_MCX_PTTOff(MMI);
    
    // @siclog "Step 27" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);

    // @siclog "Step 28 - 29" Void siclog@

    // @siclog "Step 30" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request upgrade of the call to an imminent peril chat group call with implicit floor request");

    // @siclog "Step 31" siclog@
    f_MCPTT_SessionModificationCO_Upgrade(CHAT_GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 31");
    
    // @siclog "Step 32 - 35" Void siclog@

    // @siclog "Step 36" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 36");

    // @siclog "Step 37" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 38" siclog@
    f_MCPTT_FloorReleaseIdle(IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 16");
     
    // @siclog "Step 39 - 40" Void siclog@

    // @siclog "Step 41" siclog@
    f_UT_MCX_UserAction(MMI, "Make the UE (MCPTT client) request downgrade of the call to a normal chat group call");

    // @siclog "Step 42" siclog@
    f_MCPTT_MCVideo_SessionModificationCO_Downgrade(MCPTT, CHAT_GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 42");

    // @siclog "Step 42A" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);      // @sic R5-216728 sic@

    // @siclog "Step 43 - 46" Void siclog@

    // @siclog "Step 46A" siclog@
    f_UT_MCX_PTTOn(MMI);

    // @siclog "Step 46B" siclog@
    f_MCPTT_FloorRequestGranted(NORMAL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 46B");

    // @siclog "Step 47" Void siclog@

    // @siclog "Step 48" siclog@
    f_UT_MCX_PTTOff(MMI);
    
    // @siclog "Step 49" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);

    // @siclog "Step 50 - 51" Void siclog@
    
    // @siclog "Step 52 - 53" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 53");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.2.12.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_2_12_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Chat Group Call / Join Chat Group Session / Upgrade to Emergency / Cancel Emergency / Upgrade to Imminent Peril / Cancel Imminent Peril / Client Originated (CT)
    f_MCX_Preamble_IMS(MCPTT, IPCAN_SpeechCall);
    
    f_IMS_TestBody_Set(true);
    
    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a chat group call with automatic commencement mode and implicit floor request");
    
    // @siclog "Step 2" siclog@
    f_MCPTT_CallSetupMO_100TryingOnly(CHAT_GROUP_CALL, -, -, withImplictGrantRequest);    // Table 5.3A.1.3-1 NOTE1.b.ii

    // @siclog "Step 3 - 6" Void siclog@

    // @siclog "Step 7" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 7");

    // @siclog "Step 7A" siclog@
    f_UT_MCX_PTTOff(MMI);

    // @siclog "Step 7B" siclog@
    f_MCPTT_FloorReleaseIdle(NORMAL_CALL);

    // @siclog "Step 8" siclog@
    f_MCPTT_SessionModificationCT(UPGRADE, -, CHAT_GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");

    // @siclog "Step 9 - 9A" Void siclog@

    // @siclog "Step 10 - 11" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(EMERGENCY_CALL, -, ACK_REQUIRED);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 11");

    // @siclog "Step 12" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(EMERGENCY_CALL);

    // @siclog "Step 13" siclog@
    f_MCPTT_SessionModificationCT(DOWNGRADE, -, CHAT_GROUP_CALL, EMERGENCY_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 13");

    // @siclog "Step 14" Void siclog@

    // @siclog "Step 15" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, -, ACK_REQUIRED);
    
    // @siclog "Step 16" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 18" siclog@
    f_MCPTT_SessionModificationCT(UPGRADE, -, CHAT_GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 18");

    // @siclog "Step 20 - 21" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(IMMPERIL_CALL, -, ACK_REQUIRED);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 21");

    // @siclog "Step 22" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(IMMPERIL_CALL);

    // @siclog "Step 23" siclog@
    f_MCPTT_SessionModificationCT(DOWNGRADE, -, CHAT_GROUP_CALL, IMMPERIL_CALL);
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 23");

    // @siclog "Step 24" Void siclog@

    // @siclog "Step 25" siclog@
    f_MCPTT_FloorControl_SendFloorTaken(NORMAL_CALL, -, ACK_REQUIRED);
    
    // @siclog "Step 26" siclog@
    f_MCPTT_FloorControl_SendFloorIdle(NORMAL_CALL);

    // @siclog "Step 28" siclog@
    f_MCX_CallReleaseMT();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 28");
 
    // @siclog "Step 29" Void siclog@

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

  /*
   * @desc      REFERENCE TS 36.579-2 clause 6.1.2.13.MCPTT
   * @status    APPROVED (MCX)
   */
  function f_TC_6_1_2_13_MCPTT_MCX_IMS() runs on MCX_IMS_PTC
  { // On-network / Chat Group Call / Join Chat Group Session / Active functional alias / Client Originated (CO)
    var MCX_InviteRequestWithSdpAndXml_Type v_InviteRequestWithSdpAndXml;
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;

    f_MCX_Preamble_IMS(MCPTT, IPCAN_SignallingOnly, REGISTERED_AUTHORIZED_FA_ACTIVATED);
    
    f_IMS_TestBody_Set(true);

    // @siclog "Step 1" siclog@
    f_MCPTT_CallSetupMO_InitiateCall("Make the UE (MCPTT client) request the establishment of a chat group call using the active functional alias with automatic commencement mode and implicit floor request");

    // @siclog "Step 2" siclog@
    v_InviteRequestWithSdpAndXml := f_MCPTT_MCVideo_CallSetupMO_ReceiveINVITE_Send100Trying(MCPTT, CHAT_GROUP_CALL, -, -, withImplictGrantRequest, px_MCPTT_ID_FA_A);   /* @sic R5s230486 MCC160 comments sic@ */
    v_InviteRequestWithSdp := v_InviteRequestWithSdpAndXml.InviteRequestWithSdp;
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 2");
    
    f_MCPTT_MCVideo_CallSetupMO_Send200OK_ReceiveACK(MCPTT, -, v_InviteRequestWithSdp, implicitRequestGranted);

    // @siclog "Step 3" siclog@
    f_MCX_UserCheckPassFail(__FILE__, __LINE__, "Does the UE (MCPTT client) provide floor granted notification to the user?", "Step 3");
    
    // @siclog "Step 4 - 5" siclog@
    f_MCX_CallReleaseMO(v_InviteRequestWithSdp.Invite);  // @sic R5s240111: MMI of step 4 is done in f_MCX_CallReleaseMO already sic@
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");

    f_IMS_TestBody_Set(false);
    
    f_MCX_Postamble_IMS();
  }

}
