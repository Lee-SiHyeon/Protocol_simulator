  template (value) CellGroupConfig cs_38508_CellGroupConfig(CellGroupId p_CellGroupId,
                                                            template (omit) NR_RLC_BearerToAddModList_Type p_RLC_Bearer_Config := omit,
                                                            template (omit) NR_RLC_BearerToReleaseList_Type p_RLC_BearerToRelease := omit,
                                                            template (omit) MAC_CellGroupConfig p_MAC_CellGroupConfig := omit,
                                                            template (omit) PhysicalCellGroupConfig p_PhysicalCellGroupConfig := omit,
                                                            template (omit) SpCellConfig p_SpCellConfig := omit,
                                                            template (omit) NR_SCellToAddModList_Type p_SCellConfig := omit,
                                                            template (omit) NR_SCellToReleaseList_Type p_SCellIndex := omit) :=
  //As per 38.508-1 Table 4.6.3-19: CellGroupConfig
  /* @status    APPROVED (ENDC, IMS, NR5GC, NR5GC_IRAT, POS) */
  cs_NR_CellGroupConfigDef(p_CellGroupId,
                           p_RLC_Bearer_Config,
                           p_RLC_BearerToRelease,
                           p_MAC_CellGroupConfig,
                           p_PhysicalCellGroupConfig,
                           p_SpCellConfig,
                           p_SCellConfig,
                           p_SCellIndex);

