  modulepar charstring                  px_MCPTT_ID_User_B          := "mcptt-userB-id@mcptt-op.gov";

  modulepar charstring                  px_MCPTT_ID_User_C          := "mcptt-userC-id@mcptt-op.gov";

  modulepar charstring                  px_MCPTT_User_A_Alias       := "mcptt-user-A-alias";

  modulepar charstring                  px_MCVideo_Group_A_ID       := "mcvideo-group-A@mcptt-op.gov";

  modulepar charstring                  px_MCVideo_Group_A_Name     := "mcvideo-group-A-name";

  modulepar charstring                  px_MCVideo_ID_User_A        := "mcvideo-user-A-id@ mcptt-op.gov";

  modulepar charstring                  px_MCVideo_ID_User_B        := "mcvideo-user-B-id@ mcptt-op.gov";

  modulepar charstring                  px_MCVideo_ID_User_C        := "mcvideo-user-C-id@ mcptt-op.gov";

  modulepar charstring                  px_MCVideo_User_A_Alias     := "mcvideo-user-A-alias";

  modulepar charstring                  px_MCX_APN                  := "mcx-apn";       // @desc  A single APN which the UE shall use to access each and all MCX relevant services.

  modulepar IPsec_CipheringAlgorithm_Type px_MCX_CiphAlgo_Def         := des_ede3_cbc;  // @desc  Ciphering Algorithm for IPsec.

  modulepar charstring                  px_MCX_Client_B_ID          := "urn:uuid:cdcd34fb-c2f1-4488-a03a-6b5a5d360c47";

  modulepar float                       px_MCX_CoordinateLatitude_Client_B;             // @desc  Simulated latitude value sent to the UE to inform about Client_B location

  modulepar float                       px_MCX_CoordinateLongitude_Client_B;            // @desc  Simulated longitude value sent to the UE to inform about Client_B location

  modulepar charstring                  px_MCX_DomainName_Organization_A := "mcptt-op.gov";

  modulepar charstring                  px_MCX_GroupCreationXUI     := "mcx-gms@mcptt-op.gov";

  modulepar charstring                  px_MCX_Group_A_Owner_Organization := "mcptt-op.gov";

  modulepar charstring                  px_MCX_HTTP_Proxy_Certificate;                  // @desc  Identifier or file name of the certificate to be used during establishment of the TLS tunnel to the HTTP proxy

  modulepar charstring                  px_MCX_HTTP_Proxy_IPAddress;                    // @desc  IPv4/IPv6 address of the HTTP proxy

  modulepar integer                     px_MCX_HTTP_Proxy_Port;                         // @desc  Port number of the HTTP proxy

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_DedicatedEpsBearerId_MCData := 10; // @desc  Dedicated EPS bearer for MCData

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_DedicatedEpsBearerId_MCPTT := 8;   // @desc  Dedicated EPS bearer for MCPTT

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_DedicatedEpsBearerId_MCVideo := 9; // @desc  Dedicated EPS bearer for MCVideo

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_EpsBearerId_IMS := 5;              // @desc  Default EPS bearer for IMS PDN (if any)

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_EpsBearerId_INTERNET := 6;         // @desc  Default EPS bearer for Internet PDN (if any)

  modulepar MCX_IPCAN_EpsBearerId_Type  px_MCX_IPCAN_EpsBearerId_MCX := 7;              // @desc  Default EPS bearer for MCX PDN

  modulepar IPsec_IntegrityAlgorithm_Type px_MCX_IPSecAlgorithm       := hmac_sha_1_96; // @desc  Integrity Algorithm for IPsec

  modulepar charstring                  px_MCX_IdMS_auth_Certificate;                   // @desc  Identifier or file name of the certificate to be used during establishment of the TLS tunnel to the IdMS authorization endpoint

  modulepar charstring                  px_MCX_IdMS_auth_IPAddress;                     // @desc  IPv4/IPv6 address of the IdMS authorization endpoint

  modulepar integer                     px_MCX_IdMS_auth_Port;                          // @desc  Port number of the IdMS authorization endpoint

  modulepar charstring                  px_MCX_IdMS_token_Certificate;                  // @desc  Identifier or file name of the certificate to be used during establishment of the TLS tunnel to the IdMS token endpoint

  modulepar charstring                  px_MCX_IdMS_token_IPAddress;                    // @desc  IPv4/IPv6 address of the IdMS token endpoint

  modulepar integer                     px_MCX_IdMS_token_Port;                         // @desc  Port number of the IdMS token endpoint

  modulepar bitstring                   px_MCX_InK;                                     // @desc  Integrity protection key for XML confidentiality and between the KMS and the MC KM client according to TS 33.180 [43] clause 9.3.3.

  modulepar B32_Type                    px_MCX_InK_ID;                                  // @desc  Integrity protection key ID for XML confidentiality and between the KMS and the MC KM client according to TS 33.180 [43] clause 9.3.3.

  modulepar charstring                  px_MCX_InitialConfigServer_IPAddress;           // @desc  IPv4/IPv6 address of the server optionally being used to download the Initial UE Configuration document

  modulepar integer                     px_MCX_InitialConfigServer_Port;                // @desc  Port number of the server optionally being used to download the Initial UE Configuration document

  modulepar charstring                  px_MCX_InitialConfigServer_UriPath := "/cms/initial-ue-config";

  modulepar MCX_Registration_PDN_Type   px_MCX_InitialRegistration_TypeOfPDN1 := imsPDN;

  modulepar MCX_Registration_PDN_Type   px_MCX_InitialRegistration_TypeOfPDN2 := noPDN; // @desc  Second PDN registered during initial registration; in addition to 'ims' or 'internet' or 'mcx' it may be 'none' to indicate that there is no second PDN connectivity requested by the UE during initial registration

  modulepar MCX_Registration_PDN_Type   px_MCX_InitialRegistration_TypeOfPDN3 := noPDN; // @desc  Third PDN registered during initial registration; in addition to 'ims' or 'internet' or 'mcx' it may be 'none' to indicate that there is no third PDN connectivity requested by the UE during initial registration

  modulepar charstring                  px_MCX_OAuth_ClientId_A;                        // @desc  Client ID of the UE's MCX application as used in OAuth signalling with the IdMS

  modulepar charstring                  px_MCX_OAuth_RedirectURI_A;                     // @desc  Redirect URI used by the UE implementation (user agent, MCX client and OS) to redirect the OAuth authentication response to the MCX client application

  modulepar charstring                  px_MCX_SIP_HomeDomain_A;                        // @desc  Home domain name of the SIP subscriber (user A) for MCX as stored in the HSS and on the ISIM, if the UE has an ISIM

  modulepar charstring                  px_MCX_SIP_PrivateUserId_A;                     // @desc  Private user id of the SIP subscriber (user A) for MCX as stored in the HSS and on the ISIM, if the UE has an ISIM

  modulepar charstring                  px_MCX_SIP_PublicUserId_A_1;                    // @desc  (First) public user id of the SIP subscriber (user A) for MCX; as stored in the HSS and on the ISIM, if the UE has an ISIM;

  modulepar charstring                  px_MCX_SIP_PublicUserId_B;                      // @desc  Public user id of user B

  modulepar boolean                     px_MCX_SIP_RegistrationWithTemporaryIdentities; // @desc  If true the UE shall derive the public user id, private user id and home domain name from the IMSI for SIP registration

  modulepar TLS_CIPHER_Type             px_MCX_TLS_CipherSuite      := TLS_RSA_WITH_NULL_SHA;

  modulepar octetstring                 px_MCX_TokenRsaPrivateKey;                      // @desc  Private key being used to create signature for ID and Access Token

  modulepar bitstring                   px_MCX_TrK;                                     // @desc  Transport key for XML confidentiality and between the KMS and the MC KM client according to TS 33.180 [43] clause 9.3.3.

  modulepar B32_Type                    px_MCX_TrK_ID;                                  // @desc  Transport key ID for XML confidentiality and between the KMS and the MC KM client according to TS 33.180 [43] clause 9.3.3.

  modulepar charstring                  px_MCX_User_A_ParticipantType := "first responder";

  modulepar charstring                  px_MCX_User_A_password      := "psw@MCPTT&7";   // @desc  UE's User password used for user authentication

  modulepar charstring                  px_MCX_User_A_username      := "MCPTT#U01";     // @desc  UE's User username used for user authentication

  modulepar charstring                  px_MCX_User_B_ParticipantType := "first responder";

  modulepar charstring                  px_MCX_User_C_ParticipantType := "first responder";

  modulepar boolean                     pc_MCDataClient             := true;            // @desc  IUT containing MCData Client

  modulepar boolean                     pc_MCData_FD                := false;           // @desc  Support of MCData File Distribution (FD)

  modulepar boolean                     pc_MCData_IPCONN            := true;            // @desc  Support of MCData IP connectivity (IPCONN)

  modulepar boolean                     pc_MCData_MSFDiscoverySignalling := false;      // @desc  The UE uses the procedure for Discovery of the Absolute URI of the media storage function:

  modulepar boolean                     pc_MCData_SDS               := false;           // @desc  Support of MCData Short Data Service (SDS)

  modulepar boolean                     pc_MCPTTClient              := true;            // @desc  IUT containing MCPTT Client

  modulepar boolean                     pc_MCPTT_FloorRequestQueueing := false;         // @desc  The UE supports floor request queueing

  modulepar boolean                     pc_MCPTT_OnDemanSeFirstToAnswerCall := false;   // @desc  The UE will use on-demand session for initiating a first-to-answer call

  modulepar boolean                     pc_MCPTT_OnDemanSeRemotePrivCall := false;      // @desc  The UE will use on-demand sessions when it is requested to remotely initiate a private call

  modulepar boolean                     pc_MCPTT_PreEstablishedSeFirstToAnswerCall := false;

  modulepar boolean                     pc_MCPTT_PreEstablishedSeRemotePrivCall := false;

  modulepar boolean                     pc_MCVideoClient            := true;            // @desc  IUT containing MCVideo Client

  modulepar boolean                     pc_MCVideo_TransmissionRequestQueueing := false;

  modulepar boolean                     pc_MCX_AmbientListeningCall := true;            // @desc  Support of Ambient listening call

  modulepar boolean                     pc_MCX_DisplayInfoEmergencyAlert := true;       // @desc  In case of an incoming emergency alert or emergency alert cancellation the UE provides an indication and associated information.

  modulepar boolean                     pc_MCX_DisplayInfoEmergencyCall := false;       // @desc  The UE is capable of displaying emergency call information to the user

  modulepar boolean                     pc_MCX_EmergencyIndWithAlertInd := false;       // @desc  The UE automatically initiates emergency alert for emergency calls

  modulepar boolean                     pc_MCX_KMS_RequestSecurity  := true;            // @desc  Support of KMS request security; true if the UE applies KMS request security

  modulepar boolean                     pc_MCX_Rejoin               := true;            // @desc  To be set to true if the UE supports the ability to rejoin an ongoing session after leaving the session and provides a method to rejoin an ongoing session

  modulepar boolean                     pc_MCX_UserInitiatedPreestablishedSessionModification := false;

}
