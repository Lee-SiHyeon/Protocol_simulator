module NAS_Detach_UG_GERAN {

  import from CommonDefs all;
  import from CommonIratDefs all;
  import from GERAN_CellInfo all;
  import from GERAN_CommonFunctions all;
  import from GERAN_Component all;
  import from GERAN_Parameters all;
  import from GERAN_Templates all;
  import from GERAN_TypeDefs all;
  import from NAS_24008TypeDefs all;
  import from NAS_CommonTemplates all;
  import from NAS_CommonTypeDefs all;
  import from Parameters all;
  import from UpperTesterFunctions all;

  template (present) L2DataIndType cdr_G_ClassmarkChange_EutraNotSupported (template (present) MS_Clsmk3 p_MS_Clsmk3) modifies cr_G_ClassmarkChangeAny :=
  { /* @status    APPROVED (LTE_IRAT) */
    classmarkChange := {
      msclsmk           := cdr_MS_Clsmk2_WithClsmk3(omit),
      additionalMsclsmk := p_MS_Clsmk3           // @sic R5-153733 sic@
    }
  };

  template (present) MS_Clsmk2 cdr_MS_Clsmk2_WithClsmk3 (template (omit) IEI8_Type p_IEI) modifies cr_MS_Clsmk2_Any_tlv  :=
  { /* @status    APPROVED (LTE_IRAT) */
    cM3 := '1'B
  };

  template (present) MS_Clsmk3 cdr_MSCLSMK3_EutraNotSupported modifies cr_MSCLSMK3_Any :=
  { /* @status    APPROVED (LTE_IRAT) */
    eutraFDDSupport := '0'B, // @sic R5-153733 sic@
    eutraTDDSupport := '0'B // @sic R5-153733 sic@
  };

  template (present) MS_Clsmk3 cdr_MSCLSMK3_EutraNotPresent modifies cr_MSCLSMK3_Any :=
  { /* @status    APPROVED (LTE_IRAT) */
    /* @sic R5-153733 sic@ */
    eutraFDDSupport := omit,
    eutraTDDSupport := omit
  };

  /*
   * @desc      REFERENCE TS 36.523-1 clause 9.2.2.1.3
   * @status    APPROVED (LTE_IRAT)
   */
  function f_TC_9_2_2_1_3_GERAN () runs on GERAN_PTC
  { /* Test Purpose (see f_TC_9_2_2_1_3_EUTRA) */

    var G_L2_DATAMESSAGE_IND v_LocUpd;
    var template (present) L2DataIndType v_ClassmarkChange;
    var G_LogicChType v_ChannelType;
    var SubChannelNumber v_SubChannel;
    var octetstring v_PLMN;
    var O2_Type v_LAC;
    
    f_GERAN_Init(EUTRA_GERAN); // This is still only a 2 PTC test @sic R5s110318 sic@

    v_PLMN := f_GERAN_PLMN_Get(geran_Cell24);
    v_LAC := f_GERAN_LAC_Get(geran_Cell24);
    
    f_GERAN_CreateCell(geran_Cell24);
    f_IRAT_WaitForCoOrd_Trigger (EUTRA); // @sic R5s130343 sic@
    f_GERAN_Pre_Preamble (geran_Cell24, Combined); // @sic R5s130343 sic@
   
    f_GERAN_InterRAT_InitialiseAuthParams();  // The UE starts in EUTRA, so wait for it to send the Auth Params
    f_GERAN_TestBody_Set( true );
    
    f_IRAT_WaitForCoOrd_Trigger (EUTRA);
    f_GERAN_SetCellPowerLevel (geran_Cell24, tsc_GERAN_SuitableNeighbourCell);
    
    f_IRAT_WaitForCoOrd_Trigger(EUTRA); // @sic R5s120721 sic@
    //@siclog "Step 5b2" siclog@
    f_GERAN_RRConnEst (geran_Cell24);
    G_L2.receive (car_G_L2_Estab_IND (geran_Cell24, ?, ?, ?, cr_G_LocationUpdatingRequest))
        -> value v_LocUpd;
    f_GERAN_PreliminaryPass (__FILE__, __LINE__, "Step 5b2");

    v_ChannelType := v_LocUpd.sabm.g_LogicChType;
    v_SubChannel := v_LocUpd.sabm.subChannel;
    
    v_ClassmarkChange := cdr_G_ClassmarkChange_EutraNotSupported (cdr_MSCLSMK3_EutraNotSupported);
    if (pc_Dynamic_GERAN_Rel_downgrade) { // @sic R5-153733 sic@
      v_ClassmarkChange := cdr_G_ClassmarkChange_EutraNotSupported (cdr_MSCLSMK3_EutraNotPresent);
    }
    // @sic R5s120721 sic@
    G_L2.receive (car_G_L2_DATA_IND (geran_Cell24, ?, tsc_PhyCh0, ?, ?, ?, v_ClassmarkChange)); //@sic R5-134743, R5-153733 sic@
    if (pc_UTRA) {
      G_L2.receive (car_G_L2_DATA_IND (geran_Cell24, ?, tsc_PhyCh0, ?, ?, ?, cr_G_UtranClassmarkChange));
    }

    //@siclog "Step 5b3 - 5b4" siclog@
    f_GERAN_MM_Authentication (geran_Cell24, v_ChannelType, v_SubChannel);
    
    //@siclog "Step 5b5" siclog@
    G_L2.send (cas_G_L2_DATA_REQ (geran_Cell24, 0, tsc_PhyCh0, v_ChannelType, v_SubChannel, cs_G_RFN_Omit, cs_G_LocationUpdatingAccept ( v_PLMN, v_LAC, cs_MobileIdTMSIorPTMSI('17'O, px_TMSI_Def)))); // @sic R5s130343 sic@
    
    //@siclog "Step 5b5A" siclog@
    // Receive TMSI Reallocation Complete
    G_L2.receive (car_G_L2_DATA_IND ( geran_Cell24, ?, ? ,?, ?, ?,  cr_G_TMSI_ReallocCmpl)); // @sic R5s130428 sic@

    // release channel
    f_G_ChannelRelease (geran_Cell24, tsc_PhyCh0, v_ChannelType, v_SubChannel);
    
    f_GERAN_TestBody_Set( false );
    
    // Test case now finished on GERAN side
    f_IRAT_SendCoOrd (EUTRA, cms_IRAT_Trigger);
    
    f_UT_SwitchOffUE (UT,  false); // @sic R5s130273 sic@
    f_GERAN_RRConnEst(geran_Cell24); // @sic R5s120721 sic@
    G_L2.receive (car_G_L2_Estab_IND (geran_Cell24, ?, ?, ?, cr_G_Imsi_DetachInd));
    f_GERAN_SS_CellRelease ( geran_Cell24 ); // @sic R5s130273 sic@
 
  } // f_TC_9_2_2_1_3_GERAN

}
