module PS_Data_OFF_NR5GC_IMS {

  import from IMS_ASP_Templates all;
  import from IMS_ASP_TypeDefs all;
  import from IMS_CommonFunctions all;
  import from IMS_CommonParameters all;
  import from IMS_CommonTemplates all;
  import from IMS_Component all;
  import from IMS_PTC_CoordMsg all;
  import from IMS_Procedures_5G all;
  import from IMS_Procedures_CallControl4G5G all;
  import from IMS_Procedures_CallControlCommon all;
  import from IMS_Procedures_Registration all;
  import from IMS_Procedures_RegistrationCommon all;
  import from IMS_SIP_Templates all;
  import from LibSip_Common all;
  import from LibSip_SIPTypesAndValues all;
  import from UpperTesterFunctions all;

  /*
   * @desc      Force UE to re-register with "+g.3gpp.ps-data-off" header field parameter acc. to Steps 5 and 6 of TC_11_6_x
   * @param     p_NonceCount        (default value: 2)
   * @status    APPROVED (NR5GC)
   */
   function fl_IMS_ReRegistration_DataOff(integer p_NonceCount := 2) runs on IMS_PTC
   {
     var REGISTER_Request v_RegisterReq;
     var IMS_DATA_REQ v_IMS_DATA_REQ;
     var template (present) SemicolonParam_List v_MandatoryContactParams := { cr_GenericParam("+g.3gpp.ps-data-off", "active") };

     v_IMS_DATA_REQ := f_IMS_REGISTER_SubsequentRequest(-, v_MandatoryContactParams, -, p_NonceCount);
     v_RegisterReq := v_IMS_DATA_REQ.Request.Register;
     IMS_Server.send(cas_IMS_DATA_RSP(f_IMS_RoutingInfo_ULtoDL(v_IMS_DATA_REQ.RoutingInfo), cs_Response(c_statusLine200, f_IMS_RegisterResponse_200_MessageHeaderTX(v_RegisterReq))));

   }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.1.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_1_NR5GC_IMS1()runs on IMS_PTC
  {
    var IMS_InviteRequestWithSdp_Type v_InviteRequestWithSdp;
 
    fl_TC_11_6_x_Steps5and6_NR5GC_IMS1();

    //@siclog "Steps 7" siclog@
    f_UT_RequestIMSCall(MMI);
    //@siclog "Steps 8-12" siclog@
    // @sic R5-223441 sic@ // @sic R5s220718 sic@
    v_InviteRequestWithSdp := f_IMS_MOCallSetup_NR5GC_A_4_1a_Step1();
    //100 Trying, 183 Session Progress, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step2_5(v_InviteRequestWithSdp);
    //Tell NR to add voice
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    //@siclog "Steps 16-22" siclog@
    //UPDATE, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step6_7(v_InviteRequestWithSdp);
    //180 Ringing, PRACK, 200 OK
    f_IMS_MOCallSetup_NR5GC_A_4_1a_Step8_12(v_InviteRequestWithSdp);
    //Tell NR that call is setup
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    //Ready to release the call
    f_IMS_IPCAN_WaitForTrigger(IPCAN, "Trigger MO Call Release");  // @sic R5-225362 sic@
    
    //@siclog "Steps 23-27" siclog@
    //Steps 1-2 from test procedure for test procedure for IMS MO speech call release as described in TS 38.508-1 [4] Table 4.9.17.2.2-1 take place,
    f_IMS_CallReleaseMO(v_InviteRequestWithSdp.Invite);
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN, cms_IMS_IPCAN_Trigger("IMS Call Release Msgs Sent"));  // @sic R5-225362 sic@
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.2.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_2_NR5GC_IMS1()runs on IMS_PTC
  {
    timer t_Wait := 30.0;
 
    fl_TC_11_6_x_Steps5and6_NR5GC_IMS1();

    //Now trigger the Video call
    //f_IMS_IPCAN_SendCoOrdMsg(IPCAN); @sic R5s220424 sic@
    
    //Now trigger the Video call
    f_UT_RequestIMSVideoCall(MMI, px_IMS_CalleeUri); //@sic R5s220424 sic@

    //@siclog "Step 8" siclog@
    t_Wait.start;
    alt {
      [] IMS_Server.receive(car_IMS_Invite_Request(cr_INVITE_Request(?, ?)))
      {
        f_IMS_SetVerdictFailOrInconc(__FILE__, __LINE__, "Step 8");
      }
      []t_Wait.timeout{}
    }
    //Ready for postamble
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.3.NR5GC
   * @status    APPROVED (NR5GC)
   */
  function f_TC_11_6_3_NR5GC_IMS1()runs on IMS_PTC
  {
    fl_TC_11_6_x_Steps5and6_NR5GC_IMS1();

    //Trigger SMSoIP message
    f_UT_IMS_TriggerSMS(MMI);

    //@siclog "Step 8" siclog@
    //Check: Is the IMS MO SMS / 5GS procedure performed according to steps 1-8 of annex A.13 in TS 34.229-5?
    f_IMS_NR5GC_MO_SMS_Steps9_16 ();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 8");
    
    //Postamble
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_IpcanReleaseWithOptionalDeregistration();
    
  }

  /*
   * @desc      REFERENCE TS 38.523-1 clause 11.6.x Steps 5 and 6
   * @status    APPROVED (NR5GC)
   */
  function fl_TC_11_6_x_Steps5and6_NR5GC_IMS1()runs on IMS_PTC
  {
    f_IMS_PTC_Init(PDN_1);

    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);
    f_IMS_Registration();
    f_IMS_IPCAN_SendCoOrdMsg(IPCAN);

    //@siclog "Steps 5-6" siclog@
    //Check: does the UE re-register with "+g.3gpp.ps-data-off" header field parameter set to "active"?
    //SS responds with 200 OK
    fl_IMS_ReRegistration_DataOff();
    f_IMS_PreliminaryPass(__FILE__, __LINE__, "Step 5");
  }

}
